// Cost facts read off the checker's tree (Sema/Tree.jet).
use jet_foundation.[
    OrFallback,
    TIntegerBounds,
    TUnaryOp,
    Type,
    integer_bounds_exact,
    checked_cost_bounded,
    checked_cost_combine_bounds,
    checked_cost_max,
    checked_cost_min,
    checked_cost_type_bounds,
]

// The exact value an integer literal node spells. A literal beyond i64 is a
// BigInt constant.
tree_expr_literal_integer: fn(expression: TExpr) -> Int? Never! {
    if expression.kind == {
        .IntLit(value, _) -> return Val(value)
        .CtLit(value) -> {
            if value == .BigInt(decimal) -> return Val(Int.parse(decimal) ?? return None)
        }
        .StrLit(_) | .Local(_) | .InlineBlock(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {}
    }
    None
}

// The bounds a node states by itself: an integer literal, a negated literal
// (a fixed-width operand crosses the checked Int-to-fixed conversion), or a
// local, which carries its binding's bounds. No other node states bounds.
tree_expr_known_bounds: fn(expression: TExpr) -> TIntegerBounds? Never! {
    if expression.kind == {
        .Local(local) -> return local.integer_bounds
        .Unary(op, operand) -> {
            if op != TUnaryOp.Neg -> return None
            literal := tree_expr_literal_integer(operand)
            if operand.kind == .NumericMethod(receiver, operation) {
                if operation == .CheckedIntToFixed(_, _) -> literal = tree_expr_literal_integer(receiver)
            }
            number: literal ?? return None
            return Val(integer_bounds_exact(-number))
        }
        .IntLit(_, _) | .StrLit(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {}
    }
    value: tree_expr_literal_integer(expression) ?? return None
    Val(integer_bounds_exact(value))
}

checked_cost_integer_bounds: fn(expression: TExpr) -> TIntegerBounds? Never! {
    known: tree_expr_known_bounds(expression)
    if known != None -> return known
    bounds := TIntegerBounds?{None}
    if expression.kind == {
        .CtLit(value) -> {
            if value == .Int(number) -> bounds = Val(integer_bounds_exact(number))
        }
        .NumericMethod(receiver, operation) -> {
            if operation == {
                .InlineRange(lo, hi, _) -> bounds = Val(TIntegerBounds{lo: lo, hi: hi})
                .CastAs(destination) -> {
                    if destination == "i64" && checked_cost_integer_bounds(receiver) == .Val(original) && original.lo >= -9223372036854775808 && original.hi <= 9223372036854775807 -> bounds = Val(original)
                }
                .Predicate(_) | .BitCount(_, _) | .CheckedIntToFloat(_, _, _) | .CheckedIntToFixed(_, _) | .FixedNarrow(_, _) | .TryFrom(_) | .FloatToInt(_) | .FloatExact(_, _) | .FloatNarrow | .ToShow | .EuclideanDiv | .EuclideanRem | .CharFromScalar -> {}
            }
        }
        .Unary(op, value) -> {
            if op == TUnaryOp.Neg && checked_cost_integer_bounds(value) == .Val(operand) {
                bounds = checked_cost_bounded(-operand.hi, -operand.lo)
            }
        }
        .Binary(op, _, _, left, right) -> {
            if checked_cost_integer_bounds(left) == .Val(lhs) && checked_cost_integer_bounds(right) == .Val(rhs) -> bounds = checked_cost_combine_bounds(op, lhs, rhs)
        }
        .OrFallback(value, fallback, _) -> {
            success := TIntegerBounds?{None}
            if value.ty == {
                .Option(inner) -> success = checked_cost_type_bounds(inner)
                .Result(ok, _) -> success = checked_cost_type_bounds(ok)
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
            }
            if fallback == .Value(alternative) {
                if success == .Val(normal) && checked_cost_integer_bounds(alternative) == .Val(other) -> bounds = Val(TIntegerBounds{lo: checked_cost_min(normal.lo, other.lo), hi: checked_cost_max(normal.hi, other.hi)})
            } else { bounds = success }
        }
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .CompareChain(_, _, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {}
    }
    if bounds != None -> bounds else -> checked_cost_type_bounds(expression.ty)
}

TREE_FOLD_INT_MIN: -9223372036854775808
TREE_FOLD_INT_MAX: 9223372036854775807
// Each factor of a folded product stays within 2^31, so the product fits.
TREE_FOLD_FACTOR_LIMIT: 2147483648

// The value an immutable block-local `name: value` folds to while building
// (#6125): Int `+`, `-`, `*` and negation over literals and immutable locals
// whose bounds name one value. A result that would leave Int, and every other
// node, has no fold and computes at run time as written.
tree_expr_fold_int: fn(expression: TExpr) -> Int? Never! {
    if expression.ty != Type.Int -> return None
    if expression.kind == {
        .Unary(op, operand) -> {
            if op != TUnaryOp.Neg -> return None
            number: tree_expr_fold_int(operand) ?? return None
            if number == TREE_FOLD_INT_MIN -> return None
            return Val(-number)
        }
        .Binary(op, _, _, lhs, rhs) -> {
            left: tree_expr_fold_int(lhs) ?? return None
            right: tree_expr_fold_int(rhs) ?? return None
            if op == {
                .Add -> {
                    if (right > 0 && left > TREE_FOLD_INT_MAX - right) || (right < 0 && left < TREE_FOLD_INT_MIN - right) -> return None
                    return Val(left + right)
                }
                .Sub -> {
                    if (right < 0 && left > TREE_FOLD_INT_MAX + right) || (right > 0 && left < TREE_FOLD_INT_MIN + right) -> return None
                    return Val(left - right)
                }
                .Mul -> {
                    if left > TREE_FOLD_FACTOR_LIMIT || left < -TREE_FOLD_FACTOR_LIMIT || right > TREE_FOLD_FACTOR_LIMIT || right < -TREE_FOLD_FACTOR_LIMIT -> return None
                    return Val(left * right)
                }
                .Div | .FloorDiv | .Mod | .Rem | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Gt | .Le | .Ge | .Compare | .And | .Or -> return None
            }
        }
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .CompareChain(_, _, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {}
    }
    bounds: tree_expr_known_bounds(expression) ?? return None
    if bounds.lo != bounds.hi || bounds.lo < TREE_FOLD_INT_MIN || bounds.lo > TREE_FOLD_INT_MAX -> return None
    Val(bounds.lo)
}
