//RS /// D-MARK-VOCAB1 (card #518) + D-META-ONE1=A: validate every marker name on
//RS /// `items` against the one vocabulary (E0927). `vocabulary` is the registry
//RS /// read from `Prelude/Markers.jet` plus the `derive T.Name { … }` providers
//RS /// visible to this build (bundle-wide in `Bundle.rs`, so a cross-module user
//RS /// derive is never a false unknown).
//RS pub(crate) fn check_marker_vocabulary(
//RS     items: &[Item],
//RS     rule_facts: &[crate::AST::AppliedRuleApplication],
//RS     vocabulary: &crate::Policy::MarkerVocabulary,
//RS ) -> Vec<Diagnostic> {
//RS     let mut diagnostics = Vec::new();
//RS     let mut seen = HashSet::new();
//RS     for marker in markers_in(items).chain(
//RS         rule_facts
//RS             .iter()
//RS             .filter(|fact| fact.target.is_some())
//RS             .map(|fact| &fact.marker),
//RS     ) {
//RS         if !seen.insert(marker.name_span.start) {
//RS             continue;
//RS         }
//RS         // A retired row already received its teaching diagnostic in the
//RS         // parser's shared marker reader. The sema vocabulary walk must not
//RS         // echo it when the retained AST/fact is still present for recovery.
//RS         if crate::Policy::applied_rule(&marker.name)
//RS             .is_some_and(|row| matches!(row.status, crate::Policy::RuleStatus::Retired { .. }))
//RS         {
//RS             continue;
//RS         }
//RS         let marker_site = rule_facts
//RS             .iter()
//RS             .find(|fact| fact.marker.name_span == marker.name_span)
//RS             .and_then(|fact| fact.site);
//RS         // D-ADOPT-GUEST1=A: these existing decision-ID spellings are sema's
//RS         // guest boundary, not Prelude marker rules. Only the exact C form at
//RS         // its callable/module site bypasses the closed-rule lookup; malformed
//RS         // arguments and other attachment sites stay unknown diagnostics.
//RS         if super::Guest::is_guest_marker_at(marker, marker_site) {
//RS             continue;
//RS         }
