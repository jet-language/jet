    pub fn validate_rule_signature(self: &Self, marker: &Marker, catalog: TAppliedRuleCatalog) -> ValidatedRuleArguments? {
        if applied_rule(catalog, marker.name) == None -> return None
        result := validate_rule_arguments(&marker, catalog, fn(ty, argument) {
            inferred :: self.infer(&argument)
            constant := None as CtValue?
            if ty == TAppliedRuleArgKind.String || ty == TAppliedRuleArgKind.Bool || ty == TAppliedRuleArgKind.Int -> constant = self.evaluate_constant(argument)
            RuleArgumentObservation{ty: inferred, constant: ^constant}
        })
        if result == {
            .Ok(arguments) -> Val(arguments)
            .Err(diagnostic) -> { &self.diags.push(diagnostic); None }
        }
    }

