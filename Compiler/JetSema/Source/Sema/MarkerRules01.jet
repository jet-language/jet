// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:25
pub fn resolved_app_target(bundle: ProgramBundle, module_idx: Int, no_os: Bool) -> String Never! {
    if no_os -> return "NoOs"
    module :: bundle.modules[module_idx]
    if bucket :: module.web_target_ceiling -> return bucket.name()
    if bundle.web_partition_enforced || module.default_target == Val(Syntax.BUILD_TARGET_WEB) -> return "Web"
    "Native"
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:45
pub struct ValidatedRuleArguments {
    pub bindings: [RuleArgumentBinding]
    pub types: [Type?]
    pub constants: [CtValue?]
}
impl ValidatedRuleArguments {
    // Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:52
    pub fn type_for_source(self, source_index: Int) -> Type? Never! {
        loop (index, binding) in self.bindings {
            if binding.source_index == source_index -> return self.types.get(index).flatten()
        }
        None
    }
    // Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:61
    pub fn constant_for_source(self, source_index: Int) -> CtValue? Never! {
        loop (index, binding) in self.bindings {
            if binding.source_index == source_index -> return self.constants.get(index).flatten()
        }
        None
    }
    // Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:72
    pub fn constant_for_parameter(self, parameter_index: Int) -> CtValue? Never! {
        loop (index, binding) in self.bindings {
            if binding.parameter_index == Val(parameter_index) -> return self.constants.get(index).flatten()
        }
        None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:84
fn rule_signature_bindings(marker: Marker, catalog: TAppliedRuleCatalog) -> [RuleArgumentBinding] Diagnostic! {
    rule :: applied_rule(catalog, marker.name) ?? return []
    if marker.name == Syntax.KW_UNSAFE && marker.args.is_empty() -> return []
    rule.signature.marker_argument_bindings(marker) ?? fail marker_argument_shape_error(catalog, marker.name, marker.span)
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:98
struct RuleArgumentObservation { ty: Type?, constant: CtValue? }

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:103
// Static products use the same catalog binding and menu projection as the canonical
// ordinary-sema validator, with a comptime observer instead of local scope inference.
fn validate_rule_arguments(marker: &Marker, catalog: TAppliedRuleCatalog, observe: fn(TAppliedRuleArgKind, &Expr) -> RuleArgumentObservation) -> ValidatedRuleArguments Diagnostic! {
    bindings :: rule_signature_bindings(marker, catalog)!
    marker_name :: marker.name
    marker_span :: marker.span
    rule :: applied_rule(catalog, marker_name)
    types := [Type?]{}
    constants := [CtValue?]{}
    mismatch := false
    loop binding in bindings {
        if marker.args[binding.source_index].as_expr() == None {
            if !(marker.name == Syntax.MARKER_INTERRUPT && binding.source_index == 1) -> mismatch = true
            &types.push(None)
            &constants.push(None)
            next
        }
        argument :: &marker.args[binding.source_index].as_expr_mut().expect("marker expression checked above")
        source_type := None as String?
        if row :: rule {
            if index :: binding.parameter_index {
                if parameter :: row.signature.params.get(index) -> source_type = Val(parameter.source_type)
            }
            if source_type == None -> source_type = row.signature.variadic_source_type
        }
        if source :: source_type {
            if declaration :: rule_arg_declaration(source, catalog.argument_menus) {
                // Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:141
                // Canonical path recursion: MarkerRules.jet::sema_marker_rules_argument_path.
                path := sema_marker_rules_argument_path(argument)
                if argument == .EnumLit(_, variant, _, _, _, _) -> path = Val(variant)
                if written_path :: path {
                    candidate :: sema_marker_rules_menu_candidate(written_path, declaration)
                    owns_its_menu :: if row :: rule -> row.owns_menu else -> false
                    if !owns_its_menu && !declaration.variants.is_empty() && !declaration.variants.contains(candidate) {
                        fail marker_argument_unknown_variant(marker_name, declaration, candidate, marker_span)
                    }
                }
            }
        }
        observation := RuleArgumentObservation{ty: None, constant: None}
        if binding.ty == TAppliedRuleArgKind.Ident || (binding.ty == TAppliedRuleArgKind.Any && marker_name != Syntax.MARKER_DEFAULT) || (binding.ty == TAppliedRuleArgKind.DurationOrString && argument == .UnitLit(_, _, _, _, _, _)) || binding.ty == TAppliedRuleArgKind.EffectRoots {
            observation = RuleArgumentObservation{ty: None, constant: None}
        } else if binding.ty == TAppliedRuleArgKind.Bool && marker_name == Syntax.MARKER_META && argument == .Ident(name, _) && name == Syntax.META_FIELD_TUNABLE {
            observation.ty = Val(Type.Bool)
        } else {
            observation = observe(binding.ty, &argument)
        }
        matches :: if binding.ty == {
            .Any -> true
            .String -> observation.ty == Val(Type.String)
            .Path -> observation.ty == Val(Type.Named{name: Syntax.TYPE_PATH})
            .Ident -> argument == .Ident(_, _) || argument == .Field(_, _, _) || argument == .EnumLit(_, _, _, _, _, _)
            .Bool -> observation.ty == Val(Type.Bool)
            .Int -> observation.ty == Val(Type.Int)
            .DurationOrString -> argument == .UnitLit(_, _, _, _, _, _) || observation.ty == Val(Type.String) || observation.ty == Val(Type.Named{name: Syntax.DURATION_TYPE})
            .EffectRoots -> argument == .ListLit(_, _)
        }
        mismatch = mismatch || !matches
        &types.push(observation.ty)
        &constants.push(observation.constant)
    }
    if mismatch -> fail marker_argument_shape_error(catalog, marker_name, marker_span)
    ValidatedRuleArguments{bindings: ^bindings, types: ^types, constants: ^constants}
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:271
// static_product_site -> MarkerRules.jet::sema_marker_rules_static_product_site.

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:285
fn rule_allows_fact(application: AppliedRuleApplication, facts: [AppliedRuleApplication], catalog: TAppliedRuleCatalog) -> Bool Never! {
    site :: application.site ?? return true
    companions := [String]{}
    if target :: application.target {
        loop other in facts {
            if other.target == Val(target) -> &companions.push(other.marker.name)
        }
    }
    rule_allows_with_companions(catalog, application.marker.name, site, companions)
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:301
fn materialize_static_marker_values(items: &[Item], validated: [Int:ValidatedRuleArguments], invalid: [Int:Bool]) Never! {
    // Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:306
    fn apply(marker: &Marker, validated: [Int:ValidatedRuleArguments]) Never! {
        arguments :: validated.get(marker.name_span.start) ?? return
        // Keep parser-seeded facts when this pass has no replacement.
        marker.ct = arguments.constant_for_source(0)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:314
    fn apply_all(markers: &[Marker], validated: [Int:ValidatedRuleArguments], invalid: [Int:Bool]) Never! {
        &markers.retain(fn(marker) -> invalid.get(marker.name_span.start) == None)
        loop marker in &markers -> apply(&marker, validated)
    }
    loop item in &items {
        if item == {
            .Struct(definition) -> {
                apply_all(&definition.type_markers, validated, invalid)
                apply_all(&definition.serde_markers, validated, invalid)
                loop field in &definition.fields -> apply_all(&field.serde_markers, validated, invalid)
                loop function in &definition.methods -> apply_all(&function.markers, validated, invalid)
                loop implementation in &definition.trait_impls {
                    loop function in &implementation.methods -> apply_all(&function.markers, validated, invalid)
                }
            }
            .Enum(definition) -> {
                apply_all(&definition.type_markers, validated, invalid)
                apply_all(&definition.serde_markers, validated, invalid)
                loop variant in &definition.variants -> apply_all(&variant.serde_markers, validated, invalid)
                loop function in &definition.methods -> apply_all(&function.markers, validated, invalid)
                loop implementation in &definition.trait_impls {
                    loop function in &implementation.methods -> apply_all(&function.markers, validated, invalid)
                }
            }
            .Distinct(definition) -> apply_all(&definition.type_markers, validated, invalid)
            .Func(function) -> apply_all(&function.markers, validated, invalid)
            .Impl(implementation) -> {
                loop function in &implementation.methods -> apply_all(&function.markers, validated, invalid)
            }
            else -> {}
        }
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:371
fn materialize_test_faults(items: &[Item], diags: &[Diagnostic], catalog: TAppliedRuleCatalog) Never! {
    // Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:372
    fn path(expression: Expr) -> (String, Span)? Never! {
        if expression == {
            .Ident(name, span) -> Val((name, span))
            .Field(base, member, _) -> {
                (base_name, root_span) :: path(base) ?? return None
                Val(("{base_name}.{member}", root_span))
            }
            else -> None
        }
    }
    loop item in &items {
        if item != .Test(_) -> next
        test :: &item.Test
        expression :: test.faults_expr ?? next
        if expression != .ListLit(_, _) -> next
        values :: expression.ListLit.values
        faults := [String]{}
        loop value in values {
            resolved := path(value)
            if resolved == None {
                &diags.push(marker_argument_shape_error(catalog, Syntax.KW_TEST, value.span()))
                next
            }
            (written, root_span) :: resolved ?? unreachable()
            root := written
            tail := None as String?
            if parts :: written.split_once(".") {
                root = parts.0
                tail = Val(parts.1)
            }
            canonical_root :: Syntax.respell_acronym_name(root)
            canonical :: if suffix :: tail -> "{canonical_root}.{suffix}" else -> canonical_root
            if parse_effect_name(canonical) == None {
                &diags.push(unknown_effect(root, root_span))
                next
            }
            if !faults.contains(canonical) -> &faults.push(canonical)
        }
        test.faults = ^faults
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:416
fn push_diagnostic_once(diags: &[Diagnostic], diagnostic: Diagnostic) Never! {
    loop existing in diags {
        if existing.code == diagnostic.code && existing.span == diagnostic.span && existing.what == diagnostic.what -> return
    }
    &diags.push(diagnostic)
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:427
pub fn resolve_static_rule_products(module: &LoadedModule, base_dir: OSPath, core_imports: [String:String], diags: &[Diagnostic], catalog: TAppliedRuleCatalog) Never! {
    (funcs_owned, externs, globals) :: comptime_context_from_items(module.items)
    funcs := [:]
    loop (name, function) in funcs_owned -> funcs[name] = &function
    structs_owned := [:]
    loop item in module.items {
        if item == .Struct(definition) -> structs_owned[definition.name] = definition
    }
    structs := [:]
    loop (name, definition) in structs_owned -> structs[name] = &definition
    facts := [AppliedRuleApplication]{}
    loop application in module.rule_facts {
        if application.marker.name != Syntax.KW_TEST -> &facts.push(application)
    }
    loop item in module.items {
        if item != .Test(_) -> next
        test :: item.Test
        args := [MarkerCallArg]{}
        arg_labels := [CallLabel?]{}
        if expression :: test.name_expr {
            &args.push(MarkerCallArg.Expr(expression))
            &arg_labels.push(None)
        }
        if expression :: test.faults_expr {
            &args.push(MarkerCallArg.Expr(expression))
            &arg_labels.push(Val(CallLabel{name: Syntax.TEST_FAULTS_PARAM, span: expression.span()}))
        }
        if expression :: test.expected_fail_expr {
            &args.push(MarkerCallArg.Expr(expression))
            &arg_labels.push(Val(CallLabel{name: Syntax.TEST_EXPECTED_FAIL_PARAM, span: expression.span()}))
        }
        if args.is_empty() -> next
        &facts.push(AppliedRuleApplication{marker: Marker{name: Syntax.KW_TEST, negated: false, name_span: test.span, args: ^args, arg_labels: ^arg_labels, span: test.span, ct: None}, target: Val(test.span), site: Val(RuleSite.Test)})
    }
    validated := [Int:ValidatedRuleArguments]{}
    invalid := [Int:Bool]{}
    static_strings := [(String, Span, String)]{}
    loop application in facts {
        marker :: application.marker
        if applied_rule(catalog, marker.name) == None -> next
        site :: application.site ?? next
        if !rule_allows_fact(application, facts, catalog) {
            &diags.push(marker_wrong_site_error(catalog, marker.name, site, marker.span))
            next
        }
        if !sema_marker_rules_static_product_site(site) {
            loop expression in marker.expr_args() {
                evaluated_expression := expression
                _ :: evaluate_with_imports_opts_collecting_structs(&evaluated_expression, funcs, externs, base_dir, globals, core_imports, gate_set_new(), 0, structs, None)
            }
            next
        }
        evaluated_marker := marker
        result := validate_rule_arguments(&evaluated_marker, catalog, fn(_, expression) {
            value_result := evaluate_with_imports_opts_collecting_structs(&expression, funcs, externs, base_dir, globals, core_imports, gate_set_new(), 0, structs, None)
            if value_result == .Err(_) -> return RuleArgumentObservation{ty: None, constant: None}
            (value, _) :: value_result.Ok
            ty := None as Type?
            if value == {
                .Str(_) -> ty = Val(Type.String)
                .Bool(_) -> ty = Val(Type.Bool)
                .Int(_) -> ty = Val(Type.Int)
                .Struct(type_name, _) -> {
                    if type_name == Syntax.TYPE_PATH -> ty = Val(Type.Named{name: Syntax.TYPE_PATH})
                }
                else -> {}
            }
            RuleArgumentObservation{ty: ^ty, constant: Val(value)}
        })
        if result == .Err(diagnostic) {
            push_diagnostic_once(&diags, diagnostic)
            invalid[marker.name_span.start] = true
            next
        }
        arguments :: result.Ok
        static_text := None as String?
        if value :: arguments.constant_for_source(0) {
            if value == {
                .Str(text) -> static_text = Val(text)
                .Struct(type_name, fields) -> {
                    if marker.name == Syntax.MARKER_HTML && type_name == Syntax.TYPE_PATH {
                        loop field in fields {
                            if field.name == "inner" && field.value == .Str(text) {
                                static_text = Val(text)
                                break
                            }
                        }
                    }
                }
                else -> {}
            }
        }
        if text :: static_text -> &static_strings.push((marker.name, marker.span, text))
        validated[marker.name_span.start] = ^arguments
    }
    materialize_static_marker_values(&module.items, validated, invalid)
    materialize_test_faults(&module.items, &diags, catalog)
    materialize_test_expected_fail(&module.items, validated)
    // D-DEFAULT-SHAPE1=B: retire Default into the field's ordinary default slot.
    loop item in &module.items {
        if item != .Struct(_) -> next
        definition :: &item.Struct
        loop field in &definition.fields {
            index := None as Int?
            loop (slot, marker) in field.serde_markers {
                if marker.name == Syntax.MARKER_DEFAULT { index = Val(slot); break }
            }
            if slot :: index {
                marker :: &field.serde_markers.remove(slot)
                if field.default == None -> field.default = marker.expr_arg(0)
                if field.default_ct == None -> field.default_ct = marker.ct
                &diags.push(diagnostic_from_registry("E0375", Val(marker.span), "", "", ""))
            }
            &field.serde_markers.retain(fn(marker) {
                rule := applied_rule(catalog, marker.name)
                if row :: rule {
                    if row.status == .Retired(_) {
                        &diags.push(marker_unknown_error(catalog, marker.name, active_rule_names(catalog), marker.name_span))
                        return false
                    }
                }
                true
            })
        }
    }
    loop item in &module.items {
        if item != .Struct(_) -> next
        definition :: &item.Struct
        needs_baked_default := false
        loop derive in definition.derives {
            if derive.0 == Syntax.MARKER_CODABLE || derive.0 == Syntax.MARKER_DECODE || derive.0 == Syntax.MARKER_ENCODE || derive.0 == Syntax.MARKER_CLI -> needs_baked_default = true
        }
        loop field in &definition.fields {
            expr := field.default ?? next
            if field.default_ct != None -> next
            result := evaluate_with_imports_opts_collecting_structs(&expr, funcs, externs, base_dir, globals, core_imports, gate_set_new(), 0, structs, None)
            if result == {
                .Ok((value, _)) -> field.default_ct = Val(value)
                .Err(_) -> {
                    if needs_baked_default -> push_diagnostic_once(&diags, e2414(field.name, expr.span()))
                }
            }
        }
    }
    test_names := [String]{}
    loop (name, _, text) in static_strings {
        if name == Syntax.MARKER_HTML -> module.html_path = Val(text)
        if name == Syntax.KW_TEST -> &test_names.push(text)
    }
    next_name := 0
    loop item in &module.items {
        if item != .Test(_) -> next
        test :: &item.Test
        if test.name_expr == None -> next
        if next_name >= test_names.len() -> next
        text :: test_names[next_name]
        next_name += 1
        if prefix :: test.name_prefix {
            left := prefix.trim_end_matches("_") // #4303
            right := text.trim_start_matches("_") // #4303
            test.name = Val("{left}_{right}")
        } else {
            test.name = Val(text)
        }
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:730
fn materialize_test_expected_fail(items: &[Item], validated: [Int:ValidatedRuleArguments]) Never! {
    loop item in &items {
        if item != .Test(_) -> next
        test :: &item.Test
        test.expected_fail = false
        if arguments :: validated.get(test.marker_name_span.start) {
            if value :: arguments.constant_for_parameter(2) {
                if value == .Bool(flag) -> test.expected_fail = flag
            }
        }
    }
}

impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:752
    pub fn validate_callable_policy_values(self: &Self, expressions: [Expr], span: Span) -> Bool {
        valid := true
        loop expression in expressions {
            if expression != .Call(_) -> next
            call :: expression.Call
            if CallablePolicyChain.is_builtin(call.name) -> next
            key :: (self.package_scope, call.name) // GATE #4499 composite-key equality/hash.
            lookup := self.callable_policy_declarations.get(key)
            if lookup == None {
                declaring_package := None as String?
                loop ((package, name), _) in self.callable_policy_declarations {
                    if name == call.name { declaring_package = Val(package); break }
                }
                package_detail :: if package :: declaring_package -> "policy `{call.name}` is declared in package `{package}`, not `{self.package_scope}`" else -> "policy lookup package: {self.package_scope}"
                diagnostic := Diagnostic.error("E0355", "unknown callable policy setting `{call.name}`", "a callable policy name must be a compiler-owned setting or a public policy declared in this package", "declare `pub policy {call.name}(...) {{ wrap(call) {{ … }} }}", Val(call.name_span))
                &self.diags.push(diagnostic.with_detail("{package_detail}\nmodule: {self.module_path}"))
                valid = false
                next
            }
            (_, declaration) :: lookup ?? unreachable()
            required := 0
            fixed := 0
            has_variadic := false
            loop param in declaration.params {
                if param.default == None && !param.variadic -> required += 1
                if !param.variadic -> fixed += 1
                if param.variadic -> has_variadic = true
            }
            if call.args.len() < required || (!has_variadic && call.args.len() > fixed) {
                expected :: if has_variadic -> required else -> fixed
                plural :: if has_variadic || fixed != 1 -> "s" else -> ""
                &self.diags.push(Diagnostic.error("E0104", "policy `{call.name}` expects {expected} argument{plural}, got {call.args.len()}", "policy arguments use the declaration's typed/defaulted parameter contract", "check the declaration of `{call.name}`", Val(call.name_span)))
                valid = false
            }
            loop (index, argument) in call.args {
                parameter := declaration.params.get(index)
                if parameter == None {
                    if last :: declaration.params.last() {
                        if last.variadic -> parameter = Val(last)
                    }
                }
                param :: parameter ?? next
                expected :: self.resolve_type(param.ty)
                self.check_declared_type(expected, param.ty_span)
                value := argument.expr
                actual := self.infer(&value)
                if actual == None { valid = false; next }
                actual_type :: actual ?? unreachable()
                reported :: self.check_type_assignable(expected, actual_type, argument.expr.span())
                if !reported && actual_type != expected {
                    &self.diags.push(Diagnostic.error("E0112", "policy argument {index + 1} needs {expected.show()}, but this is {actual_type.show()}", "a policy argument must satisfy its declared parameter type", "pass a value of type {expected.show()}", Val(argument.expr.span())))
                    valid = false
                }
            }
        }
        _ :: span
        valid
    }

    // Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:867
    pub fn check_memoized_function(self: &Self, f: Func) Never! {
        found := None as Marker?
        loop marker in f.markers {
            if marker.name == Syntax.MARKER_MEMO { found = Val(marker); break }
        }
        marker :: found ?? return
        loop parameter in f.params {
            source_type :: if parameter.variadic -> Type.List(parameter.ty) else -> parameter.ty
            ty :: self.resolve_type(source_type)
            if is_lazy_memo_iter(ty) {
                &self.diags.push(Diagnostic.error("E0940", "`#Memo` cannot cache lazy `{Syntax.TYPE_ITER}` values", "a lazy iterator carries live computation state instead of one completed result", "materialize the iterator before the memoized boundary", Val(marker.span)))
                return
            }
            if ty == .List(_) || !self.hashable_type_eligible(ty) {
                &self.diags.push(Diagnostic.error("E0939", "`#Memo` parameter `{parameter.name}` is not hashable", "memoization keys are the function's argument tuple, so every argument must pass the existing hashability rule", "use an Int, Bool, Char, String, or named hashable value as the argument", Val(marker.span)))
                return
            }
        }
        if return_type :: f.return_type {
            if is_lazy_memo_iter(self.resolve_type(return_type)) {
                &self.diags.push(Diagnostic.error("E0940", "`#Memo` cannot cache a lazy `{Syntax.TYPE_ITER}` result", "a lazy iterator carries live computation state instead of one completed result", "materialize the iterator before returning from the memoized function", Val(marker.span)))
            }
        }
    }

