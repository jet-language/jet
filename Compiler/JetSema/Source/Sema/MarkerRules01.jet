// PORT-PENDING 0418 crates-jet-sema-src-sema-checkermarkers: crates/jet-sema/src/Sema/CheckerMarkers.rs:1-1498
// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! E0927 (card #518): the closed marker vocabulary.
//RS //!
//RS //! `#Name` rules are structurally accepted by the parser for any PascalCase
//RS //! identifier (including the `#[…]` bracket-list path) — the parser
//RS //! only knows "this looks like a marker," not "this is a marker Jet knows
//RS //! about." An unregistered name used to silently do nothing (I3: codegen
//RS //! never saw it, so nothing rejected it either). This module is the one
//RS //! place that closes the vocabulary: every marker name is checked against
//RS //! the registered applied-rule vocabulary plus any `derive T.Name { … }` provider
//RS //! visible in this build (D-METADERIVE1=A user derives are a legal, dynamic
//RS //! addition to the contract vocabulary, not typos).
//RS //!
//RS //! D-AUTODERIVE-SYNTAX1=D restored `Debug` as an active signed type-site
//RS //! auto-derive control. It follows the same closed-vocabulary checks as
//RS //! `Printable` and `Equatable`.
//RS 
//RS use crate::Diagnostics::Diagnostic;
//RS use crate::Syntax;
//RS use crate::AST::{Item, Marker, ProgramBundle};
//RS use std::collections::{HashMap, HashSet, VecDeque};
