    }
    // Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:963
    pub fn take_targeted_rule_facts(self: &Self, target: Span) -> [Marker] Never! {
        out := [Marker]{}
        retained := [AppliedRuleApplication]{}
        loop application in ^self.rule_facts {
            if application.target == Val(target) -> &out.push(application.marker) else -> &retained.push(application)
        }
        self.rule_facts = ^retained
        out
    }
    // Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:979
    pub fn take_statement_rule_fact(self: &Self, target: Span) -> Marker? Never! {
        loop (index, application) in self.rule_facts {
            block_site :: application.site == Val(RuleSite.Block) || application.site == Val(RuleSite.Statement)
            target_matches :: application.target == Val(target) || (application.target == None && application.marker.span.start <= target.start.saturating_add(1) && target.start <= application.marker.span.start)
            if block_site && target_matches && application.marker.name != Syntax.MARKER_META && application.marker.name != Syntax.CTX_BLOCK -> return Val(&self.rule_facts.remove(index).marker)
        }
        None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:1000
fn is_lazy_memo_iter(ty: Type) -> Bool Never! {
    if ty == .Apply(name, args) -> return (name == Syntax.TYPE_ITER || name == Syntax.TYPE_VIEW_ITER) && args.len() == 1
    false
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:1018
// markers_in -> MarkerRules.jet::sema_marker_rules_collect_item (struct/enum
// type, field/variant, method/trait-impl markers; distinct, function and impl).

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:1071
fn check_deprecated_marker_visibility(markers: [Marker], is_public: Bool, diagnostics: &[Diagnostic]) Never! {
    if is_public -> return
    loop marker in markers {
        if marker.name == Syntax.MARKER_DEPRECATED -> &diagnostics.push(diagnostic_from_registry("E0932", Val(marker.span), "", "", ""))
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:1089
pub fn check_deprecated_visibility(items: [Item]) -> [Diagnostic] Never! {
    diagnostics := [Diagnostic]{}
    loop item in items {
        if item == {
            .Func(function) -> check_deprecated_marker_visibility(function.markers, function.is_pub && !function.is_package_pub, &diagnostics)
            .Struct(definition) -> {
                check_deprecated_marker_visibility(definition.type_markers, definition.is_pub && !definition.is_package_pub, &diagnostics)
                loop method in definition.methods -> check_deprecated_marker_visibility(method.markers, method.is_pub && !method.is_package_pub, &diagnostics)
                loop implementation in definition.trait_impls {
                    loop method in implementation.methods -> check_deprecated_marker_visibility(method.markers, method.is_pub && !method.is_package_pub, &diagnostics)
                }
            }
            .Enum(definition) -> {
                check_deprecated_marker_visibility(definition.type_markers, definition.is_pub && !definition.is_package_pub, &diagnostics)
                loop method in definition.methods -> check_deprecated_marker_visibility(method.markers, method.is_pub && !method.is_package_pub, &diagnostics)
                loop implementation in definition.trait_impls {
                    loop method in implementation.methods -> check_deprecated_marker_visibility(method.markers, method.is_pub && !method.is_package_pub, &diagnostics)
                }
            }
            .Distinct(definition) -> check_deprecated_marker_visibility(definition.type_markers, definition.is_pub && !definition.is_package_pub, &diagnostics)
            .Impl(implementation) -> {
                loop method in implementation.methods -> check_deprecated_marker_visibility(method.markers, method.is_pub && !method.is_package_pub, &diagnostics)
            }
            .CodeModule(module) -> {
                if body :: module.body {
                    loop diagnostic in check_deprecated_visibility(body) -> &diagnostics.push(diagnostic)
                }
            }
            else -> {}
        }
    }
    diagnostics
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:1174
pub fn check_marker_vocabulary(items: [Item], rule_facts: [AppliedRuleApplication], vocabulary: MarkerVocabulary, catalog: TAppliedRuleCatalog) -> [Diagnostic] Never! {
    diagnostics := [Diagnostic]{}
    seen := [Int:Bool]{}
    markers := [Marker]{}
    loop item in items -> sema_marker_rules_collect_item(item, &markers)
    loop fact in rule_facts {
        if fact.target != None -> &markers.push(fact.marker)
    }
    loop marker in markers {
        if seen.get(marker.name_span.start) != None -> next
        seen[marker.name_span.start] = true
        rule := applied_rule(catalog, marker.name)
        if row :: rule { if row.status == .Retired(_) -> next }
        application := None as AppliedRuleApplication?
        loop fact in rule_facts {
            if fact.marker.name_span == marker.name_span { application = Val(fact); break }
        }
        marker_site :: if fact :: application -> fact.site else -> None
        if sema_marker_rules_is_guest_marker(marker, marker_site) -> next
        if marker.name == Syntax.MARKER_ALIGN_LEGACY {
            &diagnostics.push(diagnostic_from_registry("E1118", Val(marker.span), "", "", ""))
            next
        }
        if !vocabulary.knows(catalog, marker.name) {
            &diagnostics.push(vocabulary.unknown(catalog, marker.name, marker.name_span))
            next
        }
        if rule == None -> next
        if fact :: application {
            if site :: fact.site {
                if !rule_allows_fact(fact, rule_facts, catalog) -> &diagnostics.push(marker_wrong_site_error(catalog, marker.name, site, marker.span))
            }
        }
    }
    diagnostics
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:1260
pub fn check_declared_rule_facts(facts: [AppliedRuleApplication], vocabulary: MarkerVocabulary, catalog: TAppliedRuleCatalog) -> [Diagnostic] Never! {
    diagnostics := [Diagnostic]{}
    // GATE #4499: exact optional-span/name composite keys, not encoded strings.
    seen := [(Span?, String):Span]{}
    loop application in facts {
        declaration := vocabulary.declaration(application.marker.name)
        if declaration == None {
            if sema_marker_rules_is_guest_marker(application.marker, application.site) -> next
            recognized_site :: application.site == Val(RuleSite.Type) || application.site == Val(RuleSite.Field) || application.site == Val(RuleSite.Variant) || application.site == Val(RuleSite.Function) || application.site == Val(RuleSite.Method)
            if applied_rule(catalog, application.marker.name) == None && !recognized_site -> &diagnostics.push(vocabulary.unknown(catalog, application.marker.name, application.marker.name_span))
            next
        }
        decl :: declaration ?? unreachable()
        if !declared_rule_arguments_match(application.marker, decl) -> &diagnostics.push(declared_rule_argument_shape_error(application.marker.name, decl, application.marker.span))
        sites :: declared_rule_sites(decl)
        if site :: application.site {
            if !sites.contains(site) {
                names := [String]{}
                loop allowed in sites -> &names.push(".{rule_site_name(allowed)}")
                &diagnostics.push(Diagnostic.error("E0355", "`#{application.marker.name}` cannot attach at this site", "the declared rule allows only these sites: {names.join(", ")}", "remove the marker or move it to one of its declared sites", Val(application.marker.span)))
            }
        }
        if !declared_rule_repeatable(decl) {
            key :: (application.target, application.marker.name)
            previous := seen.get(key)
            seen[key] = application.marker.span
            if first :: previous {
                diagnostic := marker_repeated_error(application.marker.name, "target", application.marker.span)
                &diagnostics.push(diagnostic.with_detail("first application span: {first.start}..{first.end}\nsecond application span: {application.marker.span.start}..{application.marker.span.end}"))
            }
        }
    }
    diagnostics
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:1343
fn declared_rule_arguments_match(marker: Marker, declaration: MarkerDecl) -> Bool Never! {
    params := [MarkerDeclParam]{}
    loop param in declaration.params { if !Syntax.is_comptime_name(param.name) -> &params.push(param) }
    supplied := [Bool]{}
    loop _ in params -> &supplied.push(false)
    next_positional := 0
    saw_named := false
    loop (index, _) in marker.args {
        parameter := None as Int?
        label := marker.arg_labels.get(index).flatten()
        if named :: label {
            saw_named = true
            loop (slot, param) in params { if param.name == named.name { parameter = Val(slot); break } }
        } else if saw_named {
            return false
        } else if next_positional < params.len() {
            parameter = Val(next_positional)
            next_positional += 1
        } else {
            loop param in params {
                if param.variadic { parameter = Val(params.len().saturating_sub(1)); break }
            }
        }
        slot :: parameter ?? return false
        if supplied[slot] && !params[slot].variadic -> return false
        argument :: marker.expr_arg(index) ?? return false
        if declared_argument_type_mismatch(argument, params[slot]) -> return false
        supplied[slot] = true
    }
    loop (index, param) in params {
        if !supplied[index] && param.value == None && !param.variadic -> return false
    }
    true
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:1387
fn declared_rule_argument_shape_error(name: String, declaration: MarkerDecl, span: Span) -> Diagnostic Never! {
    parts := [String]{}
    loop parameter in declaration.params {
        if Syntax.is_comptime_name(parameter.name) -> next
        ty :: if value :: parameter.ty -> type_name(value) else -> "Value"
        variadic :: if parameter.variadic -> "..." else -> ""
        default :: if parameter.value != None -> "{…}" else -> ""
        &parts.push("{parameter.name}: {variadic}{ty}{default}")
    }
    expected :: parts.join(", ")
    Diagnostic.error("E0930", "`#{name}` arguments do not match `{name}({expected})`", "marker arguments use the same call grammar and typed signature as function arguments", "match the declared signature `{name}({expected})`", Val(span))
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:1425
fn declared_argument_type_mismatch(expression: Expr, parameter: MarkerDeclParam) -> Bool Never! {
    expected_type :: parameter.ty ?? return false
    // Canonical literal/type shape classifiers preserve the intentionally open
    // names/calls path, rather than introducing a second expression checker.
    expected :: sema_marker_rules_declared_type_shape(expected_type) ?? return false
    actual :: sema_marker_rules_declared_literal_shape(expression) ?? return false
    expected != actual
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:1457
fn declared_rule_sites(declaration: MarkerDecl) -> [RuleSite] Never! {
    result := [RuleSite]{}
    loop parameter in declaration.params {
        if parameter.name != "$sites" -> next
        value :: parameter.value ?? return []
        if value != .ListLit(_, _) -> return []
        loop entry in value.ListLit.values {
            name :: declared_site(entry) ?? next
            loop site in RuleSite.ALL {
                if rule_site_name(site) == name { &result.push(site); break }
            }
        }
        return result
    }
    result
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:1482
// declared_site -> MarkerRules.jet::sema_marker_rules_site_value; this helper
// retains unknown strings so filtering belongs to declared_rule_sites, as Rust.
fn declared_site(value: Expr) -> String? Never! {
    if value == {
        .Ident(name, _) -> { text := name.trim_start_matches("."); Val(text) } // #4303
        .Field(_, member, _) -> Val(member)
        .EnumLit(_, variant, _, _, _, _) -> Val(variant)
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerMarkers.rs:1491
fn declared_rule_repeatable(declaration: MarkerDecl) -> Bool Never! {
    loop parameter in declaration.params {
        if parameter.name != "$repeatable" -> next
        value :: parameter.value ?? return false
        return value == .Bool(true, _)
    }
    false
}
