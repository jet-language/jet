use jet_foundation.AST.[Expr, Stmt, ForKind, LValue, LambdaBody, OrFallback, Pattern, PatSlot, StrPart, StructPatField, EnumLitArg, StrMatchPart, BinMatchPart, BinOp, AccessConvention, PlaceAccess, switched_off]
use jet_foundation.Syntax
use Sema.expr_root_ident

// Rust: crates/jet-sema/src/Sema/Captures.rs:9
pub fn walk_stmts_for_const_refs(stmts: [Stmt], const_names: [String], taken: &[String:Bool]) -> Unit {
    for stmt in stmts {
        if stmt == {
            .Expr(e) | .Yield(e, _) | .DeferClose{close: e, ..} -> walk_expr_for_const_refs(e, const_names, &taken)
            .Val(binding) -> walk_expr_for_const_refs(binding.init, const_names, &taken)
            .Assign{value: value, ..} -> walk_expr_for_const_refs(value, const_names, &taken)
            .Return(.Val(e), _) | .BreakValue(e, _) | .BreakLabelValue(_, _, e, _) -> walk_expr_for_const_refs(e, const_names, &taken)
            .Return(.None, _) -> {}
            .While{cond: cond, body: body, ..} -> {
                walk_expr_for_const_refs(cond, const_names, &taken)
                walk_stmts_for_const_refs(body, const_names, &taken)
            }
            .For{kind: kind, body: body, ..} -> {
                if kind == {
                    .Range{start: start, end: end, step: step, ..} -> {
                        walk_expr_for_const_refs(start, const_names, &taken)
                        walk_expr_for_const_refs(end, const_names, &taken)
                        if step == .Val(e) { walk_expr_for_const_refs(e, const_names, &taken) }
                    }
                    .In{collection: collection, step: step} -> {
                        walk_expr_for_const_refs(collection, const_names, &taken)
                        if step == .Val(e) { walk_expr_for_const_refs(e, const_names, &taken) }
                    }
                }
                walk_stmts_for_const_refs(body, const_names, &taken)
            }
            .Switch{subject: subject, arms: arms, else_body: else_body, ..} | .ComptimeSwitch{subject: subject, arms: arms, else_body: else_body, ..} -> {
                walk_expr_for_const_refs(subject, const_names, &taken)
                for arm in arms {
                    walk_expr_for_const_refs(arm.cond, const_names, &taken)
                    walk_stmts_for_const_refs(arm.body, const_names, &taken)
                }
                if else_body == .Val(body) { walk_stmts_for_const_refs(body, const_names, &taken) }
            }
            .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
            .CountedLoop{init: init, cond: cond, step: step, body: body, ..} -> {
                walk_expr_for_const_refs(init.init, const_names, &taken)
                walk_expr_for_const_refs(cond, const_names, &taken)
                walk_stmts_for_const_refs(body, const_names, &taken)
                // GATE #4499: borrowed singleton slice, no temporary list allocation.
                if step == .Val(stmt) { walk_stmts_for_const_refs(std.slice.from_ref(stmt), const_names, &taken) }
            }
            .Loop{body: body, ..} | .Unsafe{body: body, ..} | .Impure{body: body, ..} | .Reactive{body: body, ..} | .Shield{body: body, ..} | .Switched{body: body, ..} | .Region{body: body, ..} | .Policy{body: body, ..} | .TaskGroup{body: body, ..} | .Layout{body: body, ..} | .AuthorityScope{body: body, ..} | .Transact{body: body, ..} | .AssumeDet{body: body, ..} | .ComptimeBlock{body: body, ..} | .Live{body: body, ..} | .ScopeMember{body: body, ..} -> walk_stmts_for_const_refs(body, const_names, &taken)
            .ComptimeIf{cond: cond, then_body: then_body, else_body: else_body, ..} -> {
                walk_expr_for_const_refs(cond, const_names, &taken)
                walk_stmts_for_const_refs(then_body, const_names, &taken)
                if else_body == .Val(body) { walk_stmts_for_const_refs(body, const_names, &taken) }
            }
            .ContextBlock{fields: fields, body: body, ..} -> {
                for (_, e, _) in fields { walk_expr_for_const_refs(e, const_names, &taken) }
                walk_stmts_for_const_refs(body, const_names, &taken)
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Captures.rs:139
pub fn walk_expr_for_const_refs(expr: Expr, const_names: [String], taken: &[String:Bool]) -> Unit {
    if expr == {
        .PtrFromAddr{addr: addr, ..} -> walk_expr_for_const_refs(addr, const_names, &taken)
        .Ident(name, _) -> { if const_names.iter().any(fn(c) { c == name }) { taken[name] = true } }
        .Unit(_) -> {}
        .Str(parts, _) -> { for part in parts { if part == .Interp(e, _) { walk_expr_for_const_refs(e, const_names, &taken) } } }
        .Call(call) -> { for arg in call.args { walk_expr_for_const_refs(arg.expr, const_names, &taken) } }
        .Unary(_, inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _) | .Place(inner, _, _) | .Field(inner, _, _) | .Tainted(inner, _, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Paren(inner, _) | .Spread(inner, _) -> walk_expr_for_const_refs(inner, const_names, &taken)
        .MemberSpread{base: base, ..} | .OptField{base: base, ..} -> walk_expr_for_const_refs(base, const_names, &taken)
        .Range{start: start, end: end, ..} | .Binary(_, start, end, _) -> {
            walk_expr_for_const_refs(start, const_names, &taken)
            walk_expr_for_const_refs(end, const_names, &taken)
        }
        .MethodCall{receiver: receiver, args: args, ..} -> {
            walk_expr_for_const_refs(receiver, const_names, &taken)
            for arg in args { walk_expr_for_const_refs(arg.expr, const_names, &taken) }
        }
        .StructLit{fields: fields, ..} -> { for (_, _, e) in fields { walk_expr_for_const_refs(e, const_names, &taken) } }
        .TypedLit{body: body, ..} -> body.for_each_expr(fn(e) { walk_expr_for_const_refs(e, const_names, &taken) })
        .EnumLit{args: args, ..} -> {
            for arg in args { if arg == { .Positional(e) | .Named{expr: e, ..} -> walk_expr_for_const_refs(e, const_names, &taken) } }
        }
        .Absent(_) | .ReduceMarker(_, _) | .Todo{..} | .NoElse(_) | .ComptimeName{..} | .StrMatchLit(_, _) | .BinMatchLit(_, _) | .Char(_, _) | .Int(_, _, _, _) | .Float(_, _, _, _) | .Bool(_, _) | .UnitLit{..} -> {}
        .Try(inner, _, _, note) -> {
            walk_expr_for_const_refs(inner, const_names, &taken)
            if note == .Val(e) { walk_expr_for_const_refs(e, const_names, &taken) }
        }
        .OrFallback{value: value, fallback: fallback, ..} -> {
            walk_expr_for_const_refs(value, const_names, &taken)
            if fallback == {
                .Value(e) | .Return(.Val(e), _) -> walk_expr_for_const_refs(e, const_names, &taken)
                .Block{body: body, value: value, ..} -> {
                    walk_stmts_for_const_refs(body, const_names, &taken)
                    if value == .Val(e) { walk_expr_for_const_refs(e, const_names, &taken) }
                }
                .Return(.None, _) | .Panic{..} | .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
            }
        }
        .PatternTest{subject: subject, pattern: pattern, ..} -> {
            walk_expr_for_const_refs(subject, const_names, &taken)
            if pattern == .Struct{fields: fields, ..} {
                for field in fields { if field == .Value{value: value, ..} { walk_expr_for_const_refs(value, const_names, &taken) } }
            }
        }
        .CompareChain{operands: operands, ..} | .ListLit(operands, _) -> { for e in operands { walk_expr_for_const_refs(e, const_names, &taken) } }
        .TupleLit(fields, _, _) -> { for (_, e) in fields { walk_expr_for_const_refs(e, const_names, &taken) } }
        .MapLit(entries, _) -> {
            for (key, value) in entries {
                walk_expr_for_const_refs(key, const_names, &taken)
                walk_expr_for_const_refs(value, const_names, &taken)
            }
        }
        .Index{base: base, index: index, ..} -> {
            walk_expr_for_const_refs(base, const_names, &taken)
            walk_expr_for_const_refs(index, const_names, &taken)
        }
        .Slice{base: base, start: start, end: end, range: range, ..} -> {
            walk_expr_for_const_refs(base, const_names, &taken)
            if range == .Val(e) { walk_expr_for_const_refs(e, const_names, &taken) } else {
                walk_expr_for_const_refs(start, const_names, &taken)
                walk_expr_for_const_refs(end, const_names, &taken)
            }
        }
        .CallValue{callee: callee, args: args, ..} -> {
            walk_expr_for_const_refs(callee, const_names, &taken)
            for arg in args { walk_expr_for_const_refs(arg.expr, const_names, &taken) }
        }
        .Lambda(lambda) -> {
            if lambda.body == {
                .Expr(e) -> walk_expr_for_const_refs(e, const_names, &taken)
                .Block(body) -> walk_stmts_for_const_refs(body, const_names, &taken)
            }
        }
        .If{cond: cond, then_body: then_body, then_value: then_value, else_body: else_body, else_value: else_value, ..} -> {
            walk_expr_for_const_refs(cond, const_names, &taken)
            walk_stmts_for_const_refs(then_body, const_names, &taken)
            walk_expr_for_const_refs(then_value, const_names, &taken)
            walk_stmts_for_const_refs(else_body, const_names, &taken)
            walk_expr_for_const_refs(else_value, const_names, &taken)
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Captures.rs:328
pub fn lambda_body_refs_name(body: LambdaBody, name: String) -> Bool {
    body == {
        .Expr(e) -> expr_refs_name(e, name)
        .Block(stmts) -> stmts.iter().any(fn(stmt) { stmt_refs_name(stmt, name) })
    }
}
// Rust: crates/jet-sema/src/Sema/Captures.rs:337
pub fn fallback_refs_name(fallback: OrFallback, name: String) -> Bool {
    fallback == {
        .Value(e) | .Return(.Val(e), _) -> expr_refs_name(e, name)
        .Block{body: body, value: value, ..} -> body.iter().any(fn(stmt) { stmt_refs_name(stmt, name) }) || value.is_some_and(fn(e) { expr_refs_name(e, name) })
        .Return(.None, _) | .Panic{..} | .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> false
    }
}
// Rust: crates/jet-sema/src/Sema/Captures.rs:356
pub fn expr_refs_name(e: Expr, name: String) -> Bool {
    e == {
        .PtrFromAddr{addr: addr, ..} -> expr_refs_name(addr, name)
        .Ident(n, _) -> n == name
        .Unit(_) -> false
        .Unary(_, inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _) | .Place(inner, _, _) | .Field(inner, _, _) | .Tainted(inner, _, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Paren(inner, _) | .Spread(inner, _) -> expr_refs_name(inner, name)
        .Binary(_, left, right, _) -> expr_refs_name(left, name) || expr_refs_name(right, name)
        .CompareChain{operands: operands, ..} -> operands.iter().any(fn(e) { expr_refs_name(e, name) })
        .Call(call) -> call.name == name || call.args.iter().any(fn(arg) { expr_refs_name(arg.expr, name) })
        .CallValue{callee: callee, args: args, ..} -> expr_refs_name(callee, name) || args.iter().any(fn(arg) { expr_refs_name(arg.expr, name) })
        .Try(inner, _, _, note) -> expr_refs_name(inner, name) || note.is_some_and(fn(e) { expr_refs_name(e, name) })
        .MemberSpread{base: base, ..} | .OptField{base: base, ..} -> expr_refs_name(base, name)
        .MethodCall{receiver: receiver, args: args, ..} -> expr_refs_name(receiver, name) || args.iter().any(fn(arg) { expr_refs_name(arg.expr, name) })
        .Index{base: base, index: index, ..} -> expr_refs_name(base, name) || expr_refs_name(index, name)
        .Slice{base: base, start: start, end: end, range: range, ..} -> expr_refs_name(base, name) || (if range == .Val(e) -> expr_refs_name(e, name) else -> expr_refs_name(start, name) || expr_refs_name(end, name))
        .Range{start: start, end: end, ..} -> expr_refs_name(start, name) || expr_refs_name(end, name)
        .ListLit(elems, _) -> elems.iter().any(fn(e) { expr_refs_name(e, name) })
        .TupleLit(fields, _, _) -> fields.iter().any(fn((_, e)) { expr_refs_name(e, name) })
        .MapLit(entries, _) -> entries.iter().any(fn((key, value)) { expr_refs_name(key, name) || expr_refs_name(value, name) })
        .StructLit{fields: fields, ..} -> fields.iter().any(fn((_, _, e)) { expr_refs_name(e, name) })
        .TypedLit{body: body, ..} -> {
            hit := false
            body.for_each_expr(fn(e) { if expr_refs_name(e, name) { hit = true } })
            hit
        }
        .EnumLit{args: args, ..} -> args.iter().any(fn(arg) { arg == { .Positional(e) | .Named{expr: e, ..} -> expr_refs_name(e, name) } })
        .OrFallback{value: value, fallback: fallback, ..} -> expr_refs_name(value, name) || fallback_refs_name(fallback, name)
        .PatternTest{subject: subject, pattern: pattern, ..} -> {
            expr_refs_name(subject, name) || (pattern == {
                .Struct{fields: fields, ..} -> fields.iter().any(fn(field) { field == { .Value{value: value, ..} -> expr_refs_name(value, name); .Bind{..} -> false } })
                else -> false
            })
        }
        .Lambda(lambda) -> !lambda.params.iter().any(fn(param) { param.name == name }) && (lambda.take_names.iter().any(fn((capture, _)) { capture == name }) || lambda_body_refs_name(lambda.body, name))
        .Str(parts, _) -> parts.iter().any(fn(part) { part == { .Interp(e, _) -> expr_refs_name(e, name); else -> false } })
        .If{cond: cond, then_body: then_body, then_value: then_value, else_body: else_body, else_value: else_value, ..} -> expr_refs_name(cond, name) || expr_refs_name(then_value, name) || expr_refs_name(else_value, name) || then_body.iter().any(fn(stmt) { stmt_refs_name(stmt, name) }) || else_body.iter().any(fn(stmt) { stmt_refs_name(stmt, name) })
        .Int(_, _, _, _) | .Float(_, _, _, _) | .Bool(_, _) | .Char(_, _) | .Absent(_) | .ReduceMarker(_, _) | .Todo{..} | .NoElse(_) | .UnitLit{..} | .ComptimeName{..} | .StrMatchLit(_, _) | .BinMatchLit(_, _) -> false
    }
}
// Rust: crates/jet-sema/src/Sema/Captures.rs:479
pub fn stmt_refs_name(stmt: Stmt, name: String) -> Bool {
    stmt == {
        .Expr(e) | .Yield(e, _) | .DeferClose{close: e, ..} -> expr_refs_name(e, name)
        .Val(binding) -> expr_refs_name(binding.init, name)
        .Assign{target: target, value: value, ..} -> lvalue_refs_name(target, name) || expr_refs_name(value, name)
        .Return(.Val(e), _) | .BreakValue(e, _) | .BreakLabelValue(_, _, e, _) -> expr_refs_name(e, name)
        .While{cond: cond, body: body, ..} -> expr_refs_name(cond, name) || body.iter().any(fn(stmt) { stmt_refs_name(stmt, name) })
        .For{kind: kind, body: body, ..} -> {
            collection := kind == {
                .Range{start: start, end: end, step: step, ..} -> expr_refs_name(start, name) || expr_refs_name(end, name) || step.is_some_and(fn(e) { expr_refs_name(e, name) })
                .In{collection: collection, step: step} -> expr_refs_name(collection, name) || step.is_some_and(fn(e) { expr_refs_name(e, name) })
            }
            collection || body.iter().any(fn(stmt) { stmt_refs_name(stmt, name) })
        }
        .Switch{subject: subject, arms: arms, else_body: else_body, ..} | .ComptimeSwitch{subject: subject, arms: arms, else_body: else_body, ..} -> expr_refs_name(subject, name) || arms.iter().any(fn(arm) { expr_refs_name(arm.cond, name) || arm.body.iter().any(fn(stmt) { stmt_refs_name(stmt, name) }) }) || else_body.is_some_and(fn(body) { body.iter().any(fn(stmt) { stmt_refs_name(stmt, name) }) })
        .CountedLoop{init: init, cond: cond, step: step, body: body, ..} -> expr_refs_name(init.init, name) || expr_refs_name(cond, name) || body.iter().any(fn(stmt) { stmt_refs_name(stmt, name) }) || step.is_some_and(fn(stmt) { stmt_refs_name(stmt, name) })
        .Switched{marker: marker, body: body, ..} -> {
            if switched_off(marker) || marker.name == Syntax.MARKER_DEBUG_ONLY -> false else -> body.iter().any(fn(stmt) { stmt_refs_name(stmt, name) })
        }
        .Loop{body: body, ..} | .Unsafe{body: body, ..} | .Impure{body: body, ..} | .Reactive{body: body, ..} | .Shield{body: body, ..} | .Region{body: body, ..} | .Policy{body: body, ..} | .TaskGroup{body: body, ..} | .Layout{body: body, ..} | .AuthorityScope{body: body, ..} | .Transact{body: body, ..} | .AssumeDet{body: body, ..} | .ComptimeBlock{body: body, ..} | .Live{body: body, ..} | .ScopeMember{body: body, ..} -> body.iter().any(fn(stmt) { stmt_refs_name(stmt, name) })
        .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) | .Return(.None, _) -> false
        .ComptimeIf{cond: cond, then_body: then_body, else_body: else_body, ..} -> expr_refs_name(cond, name) || then_body.iter().any(fn(stmt) { stmt_refs_name(stmt, name) }) || else_body.is_some_and(fn(body) { body.iter().any(fn(stmt) { stmt_refs_name(stmt, name) }) })
        .ContextBlock{fields: fields, body: body, ..} -> fields.iter().any(fn((_, e, _)) { expr_refs_name(e, name) }) || body.iter().any(fn(stmt) { stmt_refs_name(stmt, name) })
    }
}
// Rust: crates/jet-sema/src/Sema/Captures.rs:589
pub fn lvalue_refs_name(lv: LValue, name: String) -> Bool {
    lv == {
        .Local{name: n, ..} -> n == name
        .Index{base: base, index: index, ..} -> expr_refs_name(base, name) || expr_refs_name(index, name)
        .Field{base: base, ..} -> expr_refs_name(base, name)
    }
}
// Rust: crates/jet-sema/src/Sema/Captures.rs:606
pub fn stmt_uses_name_through_lambdas(stmt: Stmt, name: String) -> Bool {
    if stmt_refs_name(stmt, name) { return true }
    bound := [String:Bool]{}
    read := [String:Bool]{}
    written := [String:Bool]{}
    called := [String:Bool]{}
    stmt_collect_captures(stmt, &bound, &read, &written, &called)
    read.contains_key(name) || written.contains_key(name)
}

// Rust: crates/jet-sema/src/Sema/Captures.rs:629
// Direct-call names are returned separately by lambda_collect_free_names for the owning scope to classify.
pub fn lambda_collect_captures(body: LambdaBody, params: [String:Bool], read: &[String:Bool], mut_cap: &[String:Bool]) -> Unit {
    called := [String:Bool]{}
    lambda_collect_free_names(body, params, &read, &mut_cap, &called)
}
// Rust: crates/jet-sema/src/Sema/Captures.rs:643
pub fn lambda_collect_free_names(body: LambdaBody, params: [String:Bool], read: &[String:Bool], mut_cap: &[String:Bool], called: &[String:Bool]) -> Unit {
    bound := ~params
    if body == {
        .Expr(e) -> expr_collect_captures(e, bound, &read, &mut_cap, &called)
        .Block(stmts) -> block_collect_captures(stmts, &bound, &read, &mut_cap, &called)
    }
}
// Rust: crates/jet-sema/src/Sema/Captures.rs:659
pub fn block_collect_captures(stmts: [Stmt], bound: &[String:Bool], read: &[String:Bool], mut_cap: &[String:Bool], called: &[String:Bool]) -> Unit {
    for stmt in stmts { stmt_collect_captures(stmt, &bound, &read, &mut_cap, &called) }
}
// Rust: crates/jet-sema/src/Sema/Captures.rs:671
fn collect_pattern_bindings(pattern: Pattern, bound: &[String:Bool]) -> Unit {
    if pattern == {
        .Variant{bindings: bindings, ..} -> { for slot in bindings { collect_slot_bindings(slot, &bound) } }
        .Present{binding: binding, inner: inner, ..} | .Ok{binding: binding, inner: inner, ..} | .Err{binding: binding, inner: inner, ..} -> {
            if inner == .Val(nested) { collect_pattern_bindings(nested, &bound) } else { bound[binding] = true }
        }
        .Struct{fields: fields, ..} -> { for field in fields { if field == .Bind{local: local, ..} { bound[local] = true } } }
        .Or(alts, ..) -> { for alt in alts { collect_pattern_bindings(alt, &bound) } }
        .StrMatch{parts: parts, ..} -> { for part in parts { if part == .Hole{name: name, ..} { bound[name] = true } } }
        .BinMatch{parts: parts, ..} -> { for part in parts { if part == .Hole{name: name, ..} { bound[name] = true } } }
        .Absent(_) | .Range{..} -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Captures.rs:722
fn collect_slot_bindings(slot: PatSlot, bound: &[String:Bool]) -> Unit {
    if slot == {
        .Bind{name: name, ..} -> bound[name] = true
        .Nested(inner) -> collect_pattern_bindings(inner, &bound)
        .Named{slot: inner, ..} -> collect_slot_bindings(inner, &bound)
        .Wildcard | .Range{..} | .Rest(_) -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Captures.rs:736
fn collect_condition_bindings(expr: Expr, bound: &[String:Bool]) -> Unit {
    if expr == {
        .PatternTest{pattern: pattern, ..} -> collect_pattern_bindings(pattern, &bound)
        .Binary(BinOp.And, left, right, _) -> {
            collect_condition_bindings(left, &bound)
            collect_condition_bindings(right, &bound)
        }
        .Paren(inner, _) -> collect_condition_bindings(inner, &bound)
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Captures.rs:748
fn collect_condition_captures(expr: Expr, bound: [String:Bool], read: &[String:Bool], mut_cap: &[String:Bool], called: &[String:Bool]) -> Unit {
    if expr == {
        .Binary(BinOp.And, left, right, _) -> {
            collect_condition_captures(left, bound, &read, &mut_cap, &called)
            right_bound := ~bound
            collect_condition_bindings(left, &right_bound)
            collect_condition_captures(right, right_bound, &read, &mut_cap, &called)
        }
        .Paren(inner, _) -> collect_condition_captures(inner, bound, &read, &mut_cap, &called)
        else -> expr_collect_captures(expr, bound, &read, &mut_cap, &called)
    }
}
// Rust: crates/jet-sema/src/Sema/Captures.rs:769
pub fn expr_collect_captures(e: Expr, bound: [String:Bool], read: &[String:Bool], mut_cap: &[String:Bool], called: &[String:Bool]) -> Unit {
    if e == {
        .Ident(name, _) -> { if !name.is_empty() && !bound.contains_key(name) { read[name] = true } }
        .Unary(_, inner, _) -> expr_collect_captures(inner, bound, &read, &mut_cap, &called)
        .Binary(_, left, right, _) -> {
            expr_collect_captures(left, bound, &read, &mut_cap, &called)
            expr_collect_captures(right, bound, &read, &mut_cap, &called)
        }
        .CompareChain{operands: operands, ..} -> { for inner in operands { expr_collect_captures(inner, bound, &read, &mut_cap, &called) } }
        .Call(call) -> {
            if !bound.contains_key(call.name) { called[call.name] = true }
            for arg in call.args {
                expr_collect_captures(arg.expr, bound, &read, &mut_cap, &called)
                if arg.convention == AccessConvention.Write {
                    if expr_root_ident(arg.expr) == .Val(root) { if !bound.contains_key(root) { mut_cap[root] = true } }
                }
            }
        }
        .CallValue{callee: callee, args: args, ..} -> {
            expr_collect_captures(callee, bound, &read, &mut_cap, &called)
            for arg in args {
                expr_collect_captures(arg.expr, bound, &read, &mut_cap, &called)
                if arg.convention == AccessConvention.Write {
                    if expr_root_ident(arg.expr) == .Val(root) { if !bound.contains_key(root) { mut_cap[root] = true } }
                }
            }
        }
        .Field(inner, _, _) | .Tainted(inner, _, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _) -> expr_collect_captures(inner, bound, &read, &mut_cap, &called)
        .Place(inner, access, _) -> {
            expr_collect_captures(inner, bound, &read, &mut_cap, &called)
            if access == PlaceAccess.Write {
                if expr_root_ident(inner) == .Val(root) { if !bound.contains_key(root) { mut_cap[root] = true } }
            }
        }
        .Try(inner, _, _, note) -> {
            expr_collect_captures(inner, bound, &read, &mut_cap, &called)
            if note == .Val(e) { expr_collect_captures(e, bound, &read, &mut_cap, &called) }
        }
        .MethodCall{receiver: receiver, args: args, ..} -> {
            static_type := receiver == {
                .Ident(name, _) -> name.chars().next().is_some_and(fn(c) { c.is_ascii_uppercase() })
                else -> false
            }
            task_surface := receiver == { .Ident(name, _) -> name == Syntax.INTERNAL_TASK_RECEIVER; else -> false }
            if !static_type && !task_surface { expr_collect_captures(receiver, bound, &read, &mut_cap, &called) }
            for arg in args {
                expr_collect_captures(arg.expr, bound, &read, &mut_cap, &called)
                if arg.convention == AccessConvention.Write {
                    if expr_root_ident(arg.expr) == .Val(root) { if !bound.contains_key(root) { mut_cap[root] = true } }
                }
            }
        }
        .Index{base: base, index: index, ..} -> {
            expr_collect_captures(base, bound, &read, &mut_cap, &called)
            expr_collect_captures(index, bound, &read, &mut_cap, &called)
        }
        .Slice{base: base, start: start, end: end, range: range, ..} -> {
            expr_collect_captures(base, bound, &read, &mut_cap, &called)
            if range == .Val(e) { expr_collect_captures(e, bound, &read, &mut_cap, &called) } else {
                expr_collect_captures(start, bound, &read, &mut_cap, &called)
                expr_collect_captures(end, bound, &read, &mut_cap, &called)
            }
        }
        .ListLit(elems, _) -> { for e in elems { expr_collect_captures(e, bound, &read, &mut_cap, &called) } }
        .TupleLit(fields, _, _) -> { for (_, e) in fields { expr_collect_captures(e, bound, &read, &mut_cap, &called) } }
        .MapLit(entries, _) -> {
            for (key, value) in entries {
                expr_collect_captures(key, bound, &read, &mut_cap, &called)
                expr_collect_captures(value, bound, &read, &mut_cap, &called)
            }
        }
        .StructLit{fields: fields, ..} -> { for (_, _, e) in fields { expr_collect_captures(e, bound, &read, &mut_cap, &called) } }
        .TypedLit{body: body, ..} -> body.for_each_expr(fn(e) { expr_collect_captures(e, bound, &read, &mut_cap, &called) })
        .EnumLit{args: args, ..} -> {
            for arg in args { if arg == { .Positional(e) | .Named{expr: e, ..} -> expr_collect_captures(e, bound, &read, &mut_cap, &called) } }
        }
        .OrFallback{value: value, fallback: fallback, ..} -> {
            expr_collect_captures(value, bound, &read, &mut_cap, &called)
            if fallback == {
                .Value(e) | .Return(.Val(e), _) -> expr_collect_captures(e, bound, &read, &mut_cap, &called)
                .Block{body: body, value: value, ..} -> {
                    block_bound := ~bound
                    for stmt in body { stmt_collect_captures(stmt, &block_bound, &read, &mut_cap, &called) }
                    if value == .Val(e) { expr_collect_captures(e, block_bound, &read, &mut_cap, &called) }
                }
                else -> {}
            }
        }
        .PatternTest{subject: subject, pattern: pattern, ..} -> {
            expr_collect_captures(subject, bound, &read, &mut_cap, &called)
            if pattern == .Struct{fields: fields, ..} {
                for field in fields { if field == .Value{value: value, ..} { expr_collect_captures(value, bound, &read, &mut_cap, &called) } }
            }
        }
        .Str(parts, _) -> { for part in parts { if part == .Interp(e, _) { expr_collect_captures(e, bound, &read, &mut_cap, &called) } } }
        .Lambda(lambda) -> {
            params := [String:Bool]{}
            for param in lambda.params { params[param.name] = true }
            nested_read := [String:Bool]{}
            nested_write := [String:Bool]{}
            nested_called := [String:Bool]{}
            lambda_collect_free_names(lambda.body, params, &nested_read, &nested_write, &nested_called)
            for (name, _) in lambda.take_names { nested_read[name] = true }
            for (name, _) in nested_read { if !bound.contains_key(name) { read[name] = true } }
            for (name, _) in nested_write { if !bound.contains_key(name) { mut_cap[name] = true; read[name] = true } }
            for (name, _) in nested_called { if !bound.contains_key(name) { called[name] = true } }
        }
        .If{cond: cond, then_body: then_body, then_value: then_value, else_body: else_body, else_value: else_value, ..} -> {
            collect_condition_captures(cond, bound, &read, &mut_cap, &called)
            then_bound := ~bound
            collect_condition_bindings(cond, &then_bound)
            block_collect_captures(then_body, &then_bound, &read, &mut_cap, &called)
            expr_collect_captures(then_value, then_bound, &read, &mut_cap, &called)
            else_bound := ~bound
            block_collect_captures(else_body, &else_bound, &read, &mut_cap, &called)
            expr_collect_captures(else_value, else_bound, &read, &mut_cap, &called)
        }
        .Paren(inner, _) -> expr_collect_captures(inner, bound, &read, &mut_cap, &called)
        // Retain the Rust wildcard: unlike const/ref walkers, this does not descend every expression kind.
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Captures.rs:1032
pub fn stmt_collect_captures(stmt: Stmt, bound: &[String:Bool], read: &[String:Bool], mut_cap: &[String:Bool], called: &[String:Bool]) -> Unit {
    if stmt == {
        .Expr(e) | .Yield(e, _) | .DeferClose{close: e, ..} -> expr_collect_captures(e, bound, &read, &mut_cap, &called)
        .Val(binding) -> {
            expr_collect_captures(binding.init, bound, &read, &mut_cap, &called)
            bound[binding.name] = true
        }
        .Assign{target: target, value: value, ..} -> {
            if target == {
                .Local{name: name, ..} -> { if !bound.contains_key(name) { mut_cap[name] = true } }
                .Index{base: base, index: index, ..} -> {
                    expr_collect_captures(base, bound, &read, &mut_cap, &called)
                    expr_collect_captures(index, bound, &read, &mut_cap, &called)
                    if expr_root_ident(base) == .Val(root) { if !bound.contains_key(root) { mut_cap[root] = true } }
                }
                .Field{base: base, ..} -> {
                    expr_collect_captures(base, bound, &read, &mut_cap, &called)
                    if expr_root_ident(base) == .Val(root) { if !bound.contains_key(root) { mut_cap[root] = true } }
                }
            }
            expr_collect_captures(value, bound, &read, &mut_cap, &called)
        }
        .Return(.Val(e), _) | .BreakValue(e, _) | .BreakLabelValue(_, _, e, _) -> expr_collect_captures(e, bound, &read, &mut_cap, &called)
        .While{cond: cond, body: body, ..} -> {
            expr_collect_captures(cond, bound, &read, &mut_cap, &called)
            body_bound := ~bound
            block_collect_captures(body, &body_bound, &read, &mut_cap, &called)
        }
        .Reactive{body: body, ..} -> {
            body_bound := ~bound
            reactive_read := [String:Bool]{}
            reactive_mut := [String:Bool]{}
            block_collect_captures(body, &body_bound, &reactive_read, &reactive_mut, &called)
            // Registration clones roots now; later mutations affect that clone, not the enclosing capture.
            for (name, _) in reactive_mut { reactive_read[name] = true }
            for (name, _) in reactive_read { read[name] = true }
        }
        .For{var: var, var2: var2, kind: kind, body: body, ..} -> {
            if kind == {
                .Range{start: start, end: end, step: step, ..} -> {
                    expr_collect_captures(start, bound, &read, &mut_cap, &called)
                    expr_collect_captures(end, bound, &read, &mut_cap, &called)
                    if step == .Val(e) { expr_collect_captures(e, bound, &read, &mut_cap, &called) }
                }
                .In{collection: collection, step: step} -> {
                    expr_collect_captures(collection, bound, &read, &mut_cap, &called)
                    if step == .Val(e) { expr_collect_captures(e, bound, &read, &mut_cap, &called) }
                }
            }
            body_bound := ~bound
            body_bound[var] = true
            if var2 == .Val((name, _)) { body_bound[name] = true }
            block_collect_captures(body, &body_bound, &read, &mut_cap, &called)
        }
        .Switch{subject: subject, arms: arms, else_body: else_body, ..} | .ComptimeSwitch{subject: subject, arms: arms, else_body: else_body, ..} -> {
            expr_collect_captures(subject, bound, &read, &mut_cap, &called)
            when_bound := ~bound
            when_bound[Syntax.KW_IT] = true
            for arm in arms {
                expr_collect_captures(arm.cond, when_bound, &read, &mut_cap, &called)
                arm_bound := ~when_bound
                if arm.cond == .PatternTest{pattern: pattern, ..} { collect_pattern_bindings(pattern, &arm_bound) }
                block_collect_captures(arm.body, &arm_bound, &read, &mut_cap, &called)
            }
            if else_body == .Val(body) {
                else_bound := ~bound
                block_collect_captures(body, &else_bound, &read, &mut_cap, &called)
            }
        }
        .CountedLoop{init: init, cond: cond, step: step, body: body, ..} -> {
            expr_collect_captures(init.init, bound, &read, &mut_cap, &called)
            bound[init.name] = true
            expr_collect_captures(cond, bound, &read, &mut_cap, &called)
            body_bound := ~bound
            block_collect_captures(body, &body_bound, &read, &mut_cap, &called)
            if step == .Val(stmt) { stmt_collect_captures(stmt, &bound, &read, &mut_cap, &called) }
        }
        .Switched{marker: marker, body: body, ..} -> {
            if !switched_off(marker) && marker.name != Syntax.MARKER_DEBUG_ONLY {
                body_bound := ~bound
                block_collect_captures(body, &body_bound, &read, &mut_cap, &called)
            }
        }
        .Loop{body: body, ..} | .Unsafe{body: body, ..} | .Impure{body: body, ..} | .Shield{body: body, ..} | .Region{body: body, ..} | .Policy{body: body, ..} | .TaskGroup{body: body, ..} | .Layout{body: body, ..} | .AuthorityScope{body: body, ..} | .Transact{body: body, ..} | .AssumeDet{body: body, ..} | .ComptimeBlock{body: body, ..} | .Live{body: body, ..} | .ScopeMember{body: body, ..} -> {
            body_bound := ~bound
            block_collect_captures(body, &body_bound, &read, &mut_cap, &called)
        }
        .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) | .Return(.None, _) -> {}
        .ComptimeIf{then_body: then_body, else_body: else_body, ..} -> {
            then_bound := ~bound
            block_collect_captures(then_body, &then_bound, &read, &mut_cap, &called)
            if else_body == .Val(body) {
                else_bound := ~bound
                block_collect_captures(body, &else_bound, &read, &mut_cap, &called)
            }
        }
        .ContextBlock{fields: fields, body: body, ..} -> {
            for (_, e, _) in fields { expr_collect_captures(e, bound, &read, &mut_cap, &called) }
            body_bound := ~bound
            block_collect_captures(body, &body_bound, &read, &mut_cap, &called)
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Captures.rs:1246
// S62 + D-LIB2: synthesised Func injection precedes register_impl_methods so method lookup sees synthesised methods.
