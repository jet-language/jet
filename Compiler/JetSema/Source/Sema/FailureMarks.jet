// Unconditional failure marks. Every expression that can pass a typed `E!`
// failure up to its caller writes `?` (or `?(text)` to add a context frame):
// `parse(text)?`, `files.read(path)?.count_bytes()`, `loop? x in source`, and
// `{x:Sel?}` for a fallible format selector. When a call yields an optional
// value AND can fail (`T? E!`), chaining wraps `(call()?)?.member` so `?.`
// remains unambiguous optional chaining. An unmarked propagating call, loop
// header, or selector reports E0434 with a Safe edit; a bare `?` on an
// infallible call, loop, or selector reports L0537 with a Safe removal edit.
use jet_foundation.[
    AST_NODE_GENERATED,
    Diagnostic,
    DiagnosticFixApplicability,
    DiagnosticFixSafety,
    Expr,
    Span,
    StrSelector,
    TTryConvert,
    TextEdit,
    TryConvert,
    Type,
    ast_generated_fragment_function_key,
    diagnostic_with_edit_grade,
    expr_node_id,
    expr_source_span,
    expr_source_start,
    expr_span,
]

// Prefix carried on a deferred L0537 stale-mark lint when the callee's failure
// set is still inferred; `sema_failure_settle_obligations` keeps the lint only
// when the bundle failure solve proves that callee infallible.
sema_failure_marks_stale_mark: fn() -> String Never! { "failure-stale-obligation:" }

// Whether `expr` is a call form that can carry a bare `?` failure mark.
sema_failure_marks_is_call: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Call(_, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .CallValue(_, _, _, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// The node of the receiver `expr` reads a member of or calls a method on.
// Non-optional receivers chain cleanly as `call()?.member`; an optional
// receiver (`T? E!`) wraps `(call()?)` so `?.` stays optional chaining.
sema_failure_marks_receiver: fn(expr: Expr) -> Int Never! {
    if expr == .MethodCall(receiver, _, _, _, _, _, _) -> return expr_node_id(receiver)
    if expr == .OptMethodCall(receiver, _, _, _, _, _, _) -> return expr_node_id(receiver)
    if expr == .Field(base, _, _, _) -> return expr_node_id(base)
    if expr == .OptField(base, _, _, _, _, _) -> return expr_node_id(base)
    AST_NODE_GENERATED
}

// The node of a `CallValue` callee: a mark on that callee must wrap
// `(callee()?)(args)`, because `callee()?(args)` parses as a context frame.
sema_failure_marks_callee: fn(expr: Expr) -> Int Never! {
    if expr == .CallValue(callee, _, _, _) -> return expr_node_id(callee)
    AST_NODE_GENERATED
}

// Whether a parsed `value?` is a call's bare failure mark. Generated trees
// spell out their own `?` and stay ordinary.
sema_failure_marks_written: fn(value: Expr, conversion: TryConvert, note: Expr?, try_id: Int) -> Bool Never! {
    if try_id == AST_NODE_GENERATED || note != None -> return false
    conversion == .NoConversion && sema_failure_marks_is_call(value)
}

// Emits L0537 (stale `?` on an infallible expression) with a Safe deletion
// edit for the `?` span.
sema_failure_marks_warn_unused: fn(mark: Span, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: ^[Diagnostic]) Never! {
    if mark.end <= mark.start || context.compiler_generated || ast_generated_fragment_function_key(sema_scope_function_owner_key(scopes), context.compiler_generated) {
        return
    }
    reported: sema_lint("L0537", mark, "this `?` is unnecessary because this expression cannot fail", "a bare `?` marks a failure propagation; leaving it on an infallible call, loop, or selector misleads readers", "remove the unnecessary `?`")
    edit: TextEdit{span: mark, new_text: ""}
    diagnostics.push(diagnostic_with_edit_grade(reported, edit, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving))
}

// Emits a deferred L0537 for a marked call whose callee's failure set is still
// inferred: `sema_failure_settle_obligations` keeps the lint only if the solve
// proves the callee infallible.
sema_failure_marks_defer_unused: fn(mark: Span, callee: SemaFailureCallee?, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: ^[Diagnostic]) Never! {
    found: callee ?? return
    if !found.inferable || found.key == "" || mark.end <= mark.start || context.compiler_generated || ast_generated_fragment_function_key(sema_scope_function_owner_key(scopes), context.compiler_generated) {
        return
    }
    reported: sema_lint("L0537", mark, "this `?` is unnecessary because this expression cannot fail", "a bare `?` marks a failure propagation; leaving it on an infallible call, loop, or selector misleads readers", "remove the unnecessary `?`")
    edit: TextEdit{span: mark, new_text: ""}
    ^diagnostic: diagnostic_with_edit_grade(reported, edit, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving)
    diagnostic.detail = Val("{sema_failure_marks_stale_mark()}{found.key}")
    diagnostics.push(diagnostic)
}

// A call written `call()?`: checks as the unmarked call does (with the `?`
// satisfied), and warns L0537 if the call did not actually propagate a failure.
sema_failure_marks_check_written: fn(value: Expr, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    mark: Span{start: span.end - 1, end: span.end}
    previous_written: check.context.failure_mark_written
    previous_written_span: check.context.failure_mark_written_span
    previous_consumed: check.context.failure_mark_consumed
    target_id: expr_node_id(value)
    check.context.failure_mark_written = target_id
    check.context.failure_mark_written_span = Val(mark)
    check.context.failure_mark_consumed = -1
    checked: sema_check_expression(value, expected, check)
    consumed: check.context.failure_mark_consumed == target_id
    check.context.failure_mark_written = previous_written
    check.context.failure_mark_written_span = previous_written_span
    check.context.failure_mark_consumed = previous_consumed
    if checked != None && !consumed && span.end > span.start {
        sema_failure_marks_warn_unused(mark, check.scopes, check.context, check.diagnostics)
    }
    checked
}

// E0434 for a call that passes a failure up without `?`. The report is an
// obligation of the bundle failure solve while the callee's failure set is
// still inferred: a callee the solve finds infallible owes no mark.
sema_failure_marks_require: fn(expr: Expr, payload: Type, conversion: TTryConvert, callee: SemaFailureCallee?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: ^[Diagnostic]) {
    if conversion == .Never {
        return
    }
    id: expr_node_id(expr)
    if id == AST_NODE_GENERATED || context.compiler_generated || ast_generated_fragment_function_key(sema_scope_function_owner_key(scopes), context.compiler_generated) {
        return
    }
    if id == context.failure_mark_written {
        if context.failure_mark_written_span == .Val(mark_span) {
            sema_failure_marks_defer_unused(mark_span, callee, scopes, context, diagnostics)
        }
        return
    }
    ^name: "this call"
    if expr == .Call(written, _) -> name = "`{written.name}`"
    if expr == .MethodCall(_, method, _, _, _, _, _) -> name = "`.{method}`"
    if expr == .OptMethodCall(_, method, _, _, _, _, _) -> name = "`.{method}`"
    unwrapped: sema_expr_unwrap_tag(payload)
    resolved: sema_expr_unwrap_tag(sema_expr_expected_type(payload, environment, program))
    is_option: unwrapped == .Option(_) || resolved == .Option(_)
    callee_wrap: id == context.failure_mark_callee
    opt_receiver_wrap: id == context.failure_mark_receiver && is_option
    needs_parens: callee_wrap || opt_receiver_wrap
    fix: if {
        callee_wrap -> "write the call as `(…?)`; a `?` before `(` would read as a context frame"
        opt_receiver_wrap -> "write the call as `(…?)`; this call yields an optional value, so `?.` would chain into the optional"
        id == context.failure_mark_receiver -> "write `?` after the call (`call()?.member`), or `?(text)` to add a context frame"
        else -> "write `?` after the call, or `?(text)` to add a context frame"
    }
    reported: sema_error("E0434", expr_span(expr), "{name} can fail, so the call is written with `?`", "every call that can pass a failure up writes `?` so each early exit shows in the text", fix)
    close: sema_failure_marks_call_end(expr, environment, program)
    if close == .Val(end) {
        start: expr_source_start(expr)
        first: if needs_parens -> TextEdit{span: Span{start: start, end: start}, new_text: "("} else -> TextEdit{span: Span{start: end, end: end}, new_text: "?"}
        ^diagnostic: diagnostic_with_edit_grade(reported, first, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving)
        if needs_parens {
            diagnostic.fix_edits.push(TextEdit{span: Span{start: end, end: end}, new_text: "?)"})
        }
        diagnostics.push(diagnostic)
    }
    if close == None -> diagnostics.push(reported)
    sema_failure_defer_obligation(callee, diagnostics).drop("the report is the obligation; the call's conversion is already settled")
}

// E0434 / L0537 for a loop header (`loop? x in source`) whose `Iterator.next`
// step can propagate a failure. Attaches a Safe edit inserting `?` right after
// the `loop` keyword when missing, or L0537 deleting `?` when infallible.
sema_failure_marks_require_loop_step: fn(loop_span: Span, failure_mark: Span?, conversion: TTryConvert, callee: SemaFailureCallee?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: ^[Diagnostic]) {
    if context.compiler_generated || ast_generated_fragment_function_key(sema_scope_function_owner_key(scopes), context.compiler_generated) {
        return
    }
    if conversion == .Never {
        if failure_mark == .Val(mark) {
            sema_failure_marks_warn_unused(mark, scopes, context, diagnostics)
        }
        return
    }
    if failure_mark == .Val(mark) {
        sema_failure_marks_defer_unused(mark, callee, scopes, context, diagnostics)
        return
    }
    reported: sema_error("E0434", loop_span, "`.next` can fail, so this loop is written with `loop?`", "every loop whose iterator step can pass a failure up writes `loop?` so each early exit shows in the text", "write `loop?` at the loop header, or handle the failure locally")
    keyword_end: sema_failure_marks_loop_keyword_end(loop_span, environment, program)
    if keyword_end == .Val(end) {
        edit: TextEdit{span: Span{start: end, end: end}, new_text: "?"}
        diagnostics.push(diagnostic_with_edit_grade(reported, edit, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving))
    } else {
        diagnostics.push(reported)
    }
    sema_failure_defer_obligation(callee, diagnostics).drop("the report is the obligation; the loop step's conversion is already settled")
}

// E0434 / L0537 for a format selector (`{x:Sel?}`) whose formatting method can
// propagate a failure.
sema_failure_marks_check_selector: fn(selector: StrSelector, conversion: TTryConvert, callee: SemaFailureCallee?, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: ^[Diagnostic]) {
    if context.compiler_generated || ast_generated_fragment_function_key(sema_scope_function_owner_key(scopes), context.compiler_generated) {
        return
    }
    if conversion == .Never {
        if selector.failure_mark == .Val(mark) {
            sema_failure_marks_warn_unused(mark, scopes, context, diagnostics)
        }
        return
    }
    if selector.failure_mark == .Val(mark) {
        sema_failure_marks_defer_unused(mark, callee, scopes, context, diagnostics)
        return
    }
    reported: sema_error("E0434", selector.span, "format selector `:{selector.name}` can fail, so it is written with `?`", "every format selector whose method can pass a failure up writes `?` so each early exit shows in the text", "write `?` at the end of the format selector (`:{selector.name}?`)")
    edit: TextEdit{span: Span{start: selector.span.end, end: selector.span.end}, new_text: "?"}
    diagnostics.push(diagnostic_with_edit_grade(reported, edit, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving))
    sema_failure_defer_obligation(callee, diagnostics).drop("the report is the obligation; the selector's conversion is already settled")
}

// Exact span of the `?` in `base?.member`, starting past `base_end` before
// `member_start`, used for L0537 when `base` is an infallible call.
sema_failure_marks_opt_dot_question_span: fn(base_end: Int, member_start: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Span? {
    graph: program.registration_graph
    caller: sema_scope_caller_index(environment, graph) ?? return None
    raw: graph.modules[caller].source.bytes()
    if base_end < 0 || member_start > raw.len() || base_end >= member_start -> return None
    at: sema_failure_marks_skip_space(raw, base_end)
    if at < member_start && raw[at] == (U8{63}) -> return Val(Span{start: at, end: at + 1})
    None
}

// Byte immediately past the `loop` keyword of a `Stmt.For` span (handling both
// plain `loop x in xs` and labeled `label: loop x in xs`).
sema_failure_marks_loop_keyword_end: fn(loop_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Int? {
    graph: program.registration_graph
    caller: sema_scope_caller_index(environment, graph) ?? return None
    raw: graph.modules[caller].source.bytes()
    if loop_span.start < 0 || loop_span.start >= raw.len() -> return None
    ^at: sema_failure_marks_skip_space(raw, loop_span.start)
    if sema_failure_marks_at_loop_keyword(raw, at) -> return Val(at + 4)
    limit: if loop_span.end < raw.len() -> loop_span.end else -> raw.len()
    loop at < limit && raw[at] != (U8{58}) -> at += 1
    if at >= limit || raw[at] != (U8{58}) -> return None
    at = sema_failure_marks_skip_space(raw, at + 1)
    if sema_failure_marks_at_loop_keyword(raw, at) -> return Val(at + 4)
    None
}

sema_failure_marks_at_loop_keyword: fn(raw: [U8], at: Int) -> Bool Never! {
    if at < 0 || at + 4 > raw.len() -> return false
    if raw[at] != (U8{108}) || raw[at + 1] != (U8{111}) || raw[at + 2] != (U8{111}) || raw[at + 3] != (U8{112}) -> return false
    if at + 4 == raw.len() -> return true
    next_byte: raw[at + 4]
    is_lower: next_byte >= (U8{97}) && next_byte <= (U8{122})
    is_upper: next_byte >= (U8{65}) && next_byte <= (U8{90})
    is_digit: next_byte >= (U8{48}) && next_byte <= (U8{57})
    !(is_lower || is_upper || is_digit || next_byte == (U8{95}))
}

// The byte just past a call's closing `)`. Starting from the end of the call's
// head (callee name, method name, or nested call value), skips spaces,
// comments, and optional `<…>` type arguments, then matches the call's own
// `(` to its balanced `)` across nested delimiters, strings (with `{…}`
// interpolations), raw backtick strings, char literals, and `//` comments.
// Returns None when the source has no parenthesized call list at that site.
sema_failure_marks_call_end: fn(expr: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Int? {
    graph: program.registration_graph
    caller: sema_scope_caller_index(environment, graph) ?? return None
    raw: graph.modules[caller].source.bytes()
    from: if expr == {
        .Call(call, _) -> call.name_span.end
        .MethodCall(_, _, method_span, _, _, _, _) -> method_span.end
        .OptMethodCall(_, _, method_span, _, _, _, _) -> method_span.end
        .CallValue(callee, _, _, _) -> sema_failure_marks_call_end(callee, environment, program) ?? expr_source_span(callee).end
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
    if from < 0 || from > raw.len() -> return None
    ^at: sema_failure_marks_skip_space(raw, from)
    at = sema_failure_marks_skip_type_args(raw, at)
    if at >= raw.len() || raw[at] != (U8{40}) -> return None
    sema_failure_marks_skip_parens(raw, at)
}

// The first byte at or past `at` that is not ASCII whitespace or part of a
// `//` line comment.
sema_failure_marks_skip_space: fn(raw: [U8], at: Int) -> Int Never! {
    ^position: at
    loop position < raw.len() {
        byte: raw[position]
        if sema_stmt_ascii_space(byte) {
            position += 1
            next
        }
        if byte != (U8{47}) || position + 1 >= raw.len() || raw[position + 1] != (U8{47}) -> break
        loop position < raw.len() && raw[position] != (U8{10}) -> position += 1
    }
    position
}

// Past a written `<…>` type-argument list at `at`, to the byte after it and
// any space; `at` itself when none is written there.
sema_failure_marks_skip_type_args: fn(raw: [U8], at: Int) -> Int Never! {
    if at >= raw.len() || raw[at] != (U8{60}) -> return at
    ^depth: 0
    ^position: at
    loop position < raw.len() {
        byte: raw[position]
        position += 1
        if byte == (U8{60}) -> depth += 1
        if byte == (U8{62}) {
            depth -= 1
            if depth == 0 -> return sema_failure_marks_skip_space(raw, position)
        }
    }
    at
}

// Past a `"` string literal starting at `start`, handling backslash escapes,
// `{{` escaped braces, and nested `{…}` interpolation expressions.
sema_failure_marks_skip_string: fn(raw: [U8], start: Int) -> Int Never! {
    ^position: start + 1
    loop position < raw.len() {
        byte: raw[position]
        if byte == (U8{92}) {
            position += 2
            next
        }
        if byte == (U8{34}) -> return position + 1
        if byte == (U8{123}) {
            if position + 1 < raw.len() && raw[position + 1] == (U8{123}) {
                position += 2
                next
            }
            position = sema_failure_marks_skip_braces(raw, position)
            next
        }
        position += 1
    }
    raw.len()
}

// Past a raw backtick string starting at `start` (matching its opening fence
// length of one or more `` ` `` bytes).
sema_failure_marks_skip_raw_string: fn(raw: [U8], start: Int) -> Int Never! {
    ^fence: 0
    loop start + fence < raw.len() && raw[start + fence] == (U8{96}) -> fence += 1
    ^position: start + fence
    loop position < raw.len() {
        if raw[position] != (U8{96}) {
            position += 1
            next
        }
        ^run: 0
        loop position + run < raw.len() && raw[position + run] == (U8{96}) -> run += 1
        position += run
        if run >= fence -> return position
    }
    raw.len()
}

// Past a `'` character literal starting at `start`.
sema_failure_marks_skip_char: fn(raw: [U8], start: Int) -> Int Never! {
    ^position: start + 1
    loop position < raw.len() {
        byte: raw[position]
        if byte == (U8{92}) {
            position += 2
            next
        }
        if byte == (U8{39}) -> return position + 1
        if byte == (U8{10}) -> return position
        position += 1
    }
    raw.len()
}

// Past a `{…}` interpolation block inside a string literal, starting at `{`.
sema_failure_marks_skip_braces: fn(raw: [U8], open: Int) -> Int Never! {
    ^depth: 1
    ^position: open + 1
    loop position < raw.len() {
        byte: raw[position]
        if byte == (U8{47}) && position + 1 < raw.len() && raw[position + 1] == (U8{47}) {
            loop position < raw.len() && raw[position] != (U8{10}) -> position += 1
            next
        }
        if byte == (U8{34}) {
            position = sema_failure_marks_skip_string(raw, position)
            next
        }
        if byte == (U8{96}) {
            position = sema_failure_marks_skip_raw_string(raw, position)
            next
        }
        if byte == (U8{39}) {
            position = sema_failure_marks_skip_char(raw, position)
            next
        }
        position += 1
        if byte == (U8{123}) -> depth += 1
        if byte == (U8{125}) {
            depth -= 1
            if depth == 0 -> return position
        }
    }
    raw.len()
}

// Past a parenthesized argument list starting at `(` (`open`), returning the
// byte offset immediately after its matching `)`, or None if unclosed.
sema_failure_marks_skip_parens: fn(raw: [U8], open: Int) -> Int? Never! {
    ^depth: 1
    ^position: open + 1
    loop position < raw.len() {
        byte: raw[position]
        if byte == (U8{47}) && position + 1 < raw.len() && raw[position + 1] == (U8{47}) {
            loop position < raw.len() && raw[position] != (U8{10}) -> position += 1
            next
        }
        if byte == (U8{34}) {
            position = sema_failure_marks_skip_string(raw, position)
            next
        }
        if byte == (U8{96}) {
            position = sema_failure_marks_skip_raw_string(raw, position)
            next
        }
        if byte == (U8{39}) {
            position = sema_failure_marks_skip_char(raw, position)
            next
        }
        position += 1
        if byte == (U8{40}) -> depth += 1
        if byte == (U8{41}) {
            depth -= 1
            if depth == 0 -> return Val(position)
        }
    }
    None
}
