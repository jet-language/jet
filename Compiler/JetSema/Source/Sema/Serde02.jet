// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:14
// Anonymous unions are ordinary sema enum items; codecs follow the checked AST path.
pub fn inject_anonymous_union_items(items: &[Item]) {
    unions :: collect_anonymous_unions(items)
    (encodes, decodes) :: union_codec_needs(items)
    existing := [String:Bool]{}
    loop item in items {
        if item == .Enum(e) && e.name.starts_with("__JetUnion_") -> &existing.insert(e.name, true)
    }
    span :: Span.new(0, 0)
    names := unions.keys().to_list()
    &names.sort()
    loop name in names {
        if existing.contains_key(name) -> next
        &existing.insert(name, true)
        derives := [(String, Span)]{}
        if encodes.contains_key(name) -> &derives.push((ENCODE, span))
        if decodes.contains_key(name) -> &derives.push((DECODE, span))
        variants := [Variant]{}
        loop member in unions[name] {
            &variants.push(Variant{name: union_member_tag(member), name_span: span,
                payload: VariantPayload.Single(~member, span), discriminant: None,
                discriminant_expr: None, serde_markers: []})
        }
        &items.push(Item.Enum(EnumDef{span: span, is_pub: false, is_package_pub: false,
            name: name, name_span: span, type_params: [], variants: ^variants,
            methods: [], trait_impls: [], derives: ^derives, auto_derive_default: true,
            is_single_use: false, single_use_span: None, is_must_use: false,
            must_use_span: None, serde_markers: [], type_markers: [], groups: []}))
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:70
fn collect_anonymous_unions(items: [Item]) -> [String:[Type]] {
    // Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:71
    fn walk_type(ty: Type, unions: &[String:[Type]]) {
        if ty == {
            .Union(members) -> {
                name :: union_enum_name(members)
                if !unions.contains_key(name) -> &unions.insert(name, ~members)
                loop member in members -> walk_type(member, unions)
            }
            .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) |
            .FixedList(inner, _) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> walk_type(inner, unions)
            .Map(key, _, value) | .Result(key, value) -> { walk_type(key, unions); walk_type(value, unions) }
            .Fn(params, ret, _) -> {
                loop param in params -> walk_type(param, unions)
                if ret == .Val(value) -> walk_type(value, unions)
            }
            .Apply(_, args) -> { loop arg in args -> walk_type(arg, unions) }
            .Tuple(fields) -> { loop field in fields -> walk_type(field.ty, unions) }
            else -> {}
        }
    }
    // Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:117
    fn walk_item(item: Item, unions: &[String:[Type]]) {
        if item == {
            .Struct(s) -> { loop field in s.fields -> walk_type(field.ty, unions) }
            .Enum(e) -> {
                loop variant in e.variants {
                    if variant.payload == {
                        .Single(ty, _) -> walk_type(ty, unions)
                        .Named(fields) -> { loop field in fields -> walk_type(field.ty, unions) }
                        .Unit -> {}
                    }
                }
            }
            .Func(f) -> {
                loop param in f.params -> walk_type(param.ty, unions)
                if f.return_type == .Val(ret) -> walk_type(ret, unions)
            }
            .Impl(i) -> {
                loop method in i.methods {
                    loop param in method.params -> walk_type(param.ty, unions)
                    if method.return_type == .Val(ret) -> walk_type(ret, unions)
                }
            }
            .CodeModule(module) -> {
                if module.body == .Val(body) { loop child in body -> walk_item(child, unions) }
            }
            else -> {}
        }
    }
    unions := [String:[Type]]{}
    loop item in items -> walk_item(item, &unions)
    ^unions
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:173
fn union_codec_needs(items: [Item]) -> ([String:Bool], [String:Bool]) {
    // Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:179
    fn collect_type(ty: Type, encode: Bool, decode: Bool, encodes: &[String:Bool], decodes: &[String:Bool]) {
        if ty == .Union(members) {
            name :: union_enum_name(members)
            if encode -> &encodes.insert(name, true)
            if decode -> &decodes.insert(name, true)
        }
        if ty == {
            .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) |
            .FixedList(inner, _) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> collect_type(inner, encode, decode, encodes, decodes)
            .Map(key, _, value) | .Result(key, value) -> {
                collect_type(key, encode, decode, encodes, decodes)
                collect_type(value, encode, decode, encodes, decodes)
            }
            .Apply(_, args) | .Union(args) -> { loop arg in args -> collect_type(arg, encode, decode, encodes, decodes) }
            .Tuple(fields) -> { loop field in fields -> collect_type(field.ty, encode, decode, encodes, decodes) }
            .Fn(params, ret, _) -> {
                loop param in params -> collect_type(param, encode, decode, encodes, decodes)
                if ret == .Val(value) -> collect_type(value, encode, decode, encodes, decodes)
            }
            else -> {}
        }
    }
    // Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:235
    fn walk_items(items: [Item], auto: TraitRegistry, encodes: &[String:Bool], decodes: &[String:Bool]) {
        loop item in items {
            if item == {
                .Struct(s) -> {
                    encode :: has_derive(s.derives, ENCODE) || has_derive(s.derives, "Codable") || auto.auto_encode.contains(s.name)
                    decode :: has_derive(s.derives, DECODE) || has_derive(s.derives, "Codable") || auto.auto_decode.contains(s.name)
                    loop field in s.fields {
                        if !has_marker(field.serde_markers, MARKER_SKIP) -> collect_type(field.ty, encode, decode, encodes, decodes)
                    }
                }
                .Enum(e) -> {
                    encode :: has_derive(e.derives, ENCODE) || has_derive(e.derives, "Codable") || auto.auto_encode.contains(e.name)
                    decode :: has_derive(e.derives, DECODE) || has_derive(e.derives, "Codable") || auto.auto_decode.contains(e.name)
                    loop variant in e.variants {
                        if variant.payload == {
                            .Single(ty, _) -> collect_type(ty, encode, decode, encodes, decodes)
                            .Named(fields) -> { loop field in fields -> collect_type(field.ty, encode, decode, encodes, decodes) }
                            .Unit -> {}
                        }
                    }
                }
                .CodeModule(module) -> { if module.body == .Val(body) -> walk_items(body, auto, encodes, decodes) }
                else -> {}
            }
        }
    }
    encodes := [String:Bool]{}
    decodes := [String:Bool]{}
    auto :: TraitRegistry.auto_derives_for_items(items)
    walk_items(items, auto, &encodes, &decodes)
    (^encodes, ^decodes)
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:302
pub fn expand_builtin_serde_items(items: &[Item], diags: &[Diagnostic]) {
    loop item in &items {
        if item == .CodeModule(module) {
            if module.body == .Val(body) -> expand_builtin_serde_items(&body, diags)
        }
    }
    inject_anonymous_union_items(items)
    auto :: TraitRegistry.auto_derives_for_items(items)
    expand_builtin_serde_items_with_auto_here(items, auto, diags)
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:318
pub fn expand_builtin_serde_items_with_auto(items: &[Item], auto: TraitRegistry, diags: &[Diagnostic]) {
    loop item in &items {
        if item == .CodeModule(module) {
            if module.body == .Val(body) -> expand_builtin_serde_items_with_auto(&body, auto, diags)
        }
    }
    inject_anonymous_union_items(items)
    expand_builtin_serde_items_with_auto_here(items, auto, diags)
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:334
fn expand_builtin_serde_items_with_auto_here(items: &[Item], auto: TraitRegistry, diags: &[Diagnostic]) {
    // GATE #4499: tuple keys preserve composite equality; no encoded string keys.
    existing_generated := [(String, String?):Bool]{}
    loop item in items {
        if item == .Impl(implementation) && implementation.is_generated_serde -> &existing_generated.insert((implementation.type_name, implementation.trait_name), true)
    }
    fully_generated :: |type_name: String, derives: [(String, Span)]| -> Bool {
        loop trait_name in [ENCODE, DECODE] {
            if has_derive(derives, trait_name) && !existing_generated.contains_key((type_name, Val(trait_name))) -> return false
        }
        true
    }
    generated_items := [Item]{}
    loop item in items {
        if item == {
            .Enum(e) if e.name.starts_with("__JetUnion_") -> {
                if !fully_generated(e.name, e.derives) -> &generated_items.extend(union_codec_items(e, items))
            }
            .Struct(s) if !is_reserved_type(s.name) -> {
                explicit_encode :: has_explicit_codec(items, s.name, ENCODE)
                explicit_decode :: has_explicit_codec(items, s.name, DECODE)
                encode :: has_derive(s.derives, ENCODE) || (!explicit_encode && auto.auto_encode.contains(s.name))
                decode :: has_derive(s.derives, DECODE) || (!explicit_decode && auto.auto_decode.contains(s.name))
                if encode || decode {
                    derived := ~s
                    if explicit_encode && !has_derive(s.derives, ENCODE) -> &derived.derives.retain(|row| row.0 != ENCODE)
                    if explicit_decode && !has_derive(s.derives, DECODE) -> &derived.derives.retain(|row| row.0 != DECODE)
                    if !explicit_encode -> add_auto_codec_marker(&derived.derives, ENCODE, auto.auto_encode, derived.name, derived.name_span)
                    if !explicit_decode -> add_auto_codec_marker(&derived.derives, DECODE, auto.auto_decode, derived.name, derived.name_span)
                    if !fully_generated(derived.name, derived.derives) -> &generated_items.extend(struct_codec_items(derived))
                }
            }
            .Enum(e) if !is_reserved_type(e.name) -> {
                explicit_encode :: has_explicit_codec(items, e.name, ENCODE)
                explicit_decode :: has_explicit_codec(items, e.name, DECODE)
                encode :: has_derive(e.derives, ENCODE) || (!explicit_encode && auto.auto_encode.contains(e.name))
                decode :: has_derive(e.derives, DECODE) || (!explicit_decode && auto.auto_decode.contains(e.name))
                if encode || decode {
                    derived := ~e
                    if explicit_encode && !has_derive(e.derives, ENCODE) -> &derived.derives.retain(|row| row.0 != ENCODE)
                    if explicit_decode && !has_derive(e.derives, DECODE) -> &derived.derives.retain(|row| row.0 != DECODE)
                    if !explicit_encode -> add_auto_codec_marker(&derived.derives, ENCODE, auto.auto_encode, derived.name, derived.name_span)
                    if !explicit_decode -> add_auto_codec_marker(&derived.derives, DECODE, auto.auto_decode, derived.name, derived.name_span)
                    if !fully_generated(derived.name, derived.derives) -> &generated_items.extend(enum_codec_items(derived))
                }
            }
            else -> {}
        }
    }
    &generated_items.retain(|item| {
        if item == .Impl(implementation) -> !implementation.is_generated_serde || !existing_generated.contains_key((implementation.type_name, implementation.trait_name))
        else -> true
    })
    expanded :: expand_generated_items(^generated_items) catch diagnostic -> {
        &diags.push(^diagnostic)
        return
    }
    &items.extend(^expanded)
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:484
fn add_auto_codec_marker(derives: &[(String, Span)], trait_name: String, automatic: HashSet<String>, type_name: String, span: Span) {
    if automatic.contains(type_name) && !has_derive(derives, trait_name) -> &derives.push((trait_name, span))
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:495
fn has_explicit_codec(items: [Item], type_name: String, trait_name: String) -> Bool {
    loop item in items {
        if item == {
            .Impl(implementation) -> {
                if implementation.type_name == type_name && implementation.trait_name == Val(trait_name) && !implementation.is_generated_serde -> return true
            }
            .Struct(definition) if definition.name == type_name -> {
                loop block in definition.trait_impls { if block.trait_name == trait_name && !block.compiler_generated -> return true }
            }
            .Enum(definition) if definition.name == type_name -> {
                loop block in definition.trait_impls { if block.trait_name == trait_name && !block.compiler_generated -> return true }
            }
            else -> {}
        }
    }
    false
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:514
fn has_derive(derives: [(String, Span)], name: String) -> Bool {
    loop (derive, _) in derives { if derive == name -> return true }
    false
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:518
fn codec_params(params: [TypeParam], wire_types: [Type], encode: Bool, decode: Bool) -> [TypeParam] {
    out := ~params
    loop param in &out {
        reaches_wire := false
        loop ty in wire_types {
            if free_type_params(ty).contains(param.name) { reaches_wire = true; break }
        }
        if reaches_wire && encode && !param.bounds.contains(ENCODE) -> &param.bounds.push(ENCODE)
        if reaches_wire && decode && !param.bounds.contains(DECODE) -> &param.bounds.push(DECODE)
    }
    ^out
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:552
fn struct_codec_items(s: StructDef) -> [Item] {
    encode :: has_derive(s.derives, ENCODE)
    decode :: has_derive(s.derives, DECODE)
    span := s.name_span
    loop (name, location) in s.derives { if name == ENCODE || name == DECODE { span = location; break } }
    out := [Item]{}
    if encode {
        wire := [Type]{}
        loop field in s.fields {
            if field.computed == None && !has_marker(field.serde_markers, MARKER_SKIP) -> &wire.push(~field.ty)
        }
        params :: codec_params(s.type_params, ^wire, true, false)
        &out.push(Item.Impl(serde_impl(s.name, ENCODE, serde_method("encode", ^params, [self_param(span)], Val(data_tree_type()), struct_encode_body(s, span), span), span)))
    }
    if decode {
        wire := [Type]{}
        loop field in s.reflection_fields() { if !has_marker(field.serde_markers, MARKER_SKIP) -> &wire.push(~field.ty) }
        params :: codec_params(s.type_params, ^wire, false, true)
        &out.push(Item.Impl(serde_impl(s.name, DECODE, serde_method("decode", ^params, [named_param("tree", data_tree_type(), span)], Val(result_type(target_type(s.name, s.type_params), span)), struct_decode_body(s, span), span), span)))
    }
    ^out
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:620
fn enum_codec_items(e: EnumDef) -> [Item] {
    encode :: has_derive(e.derives, ENCODE)
    decode :: has_derive(e.derives, DECODE)
    wire := [Type]{}
    loop variant in e.variants {
        if variant.payload == {
            .Unit -> {}
            .Single(ty, _) -> &wire.push(~ty)
            .Named(fields) -> { loop field in fields -> &wire.push(~field.ty) }
        }
    }
    params :: codec_params(e.type_params, ^wire, encode, decode)
    span := e.name_span
    loop (name, location) in e.derives { if name == ENCODE || name == DECODE { span = location; break } }
    out := [Item]{}
    if encode -> &out.push(Item.Impl(serde_impl(e.name, ENCODE, serde_method("encode", ~params, [self_param(span)], Val(data_tree_type()), enum_encode_body(e, span), span), span)))
    if decode -> &out.push(Item.Impl(serde_impl(e.name, DECODE, serde_method("decode", ^params, [named_param("tree", data_tree_type(), span)], Val(result_type(target_type(e.name, e.type_params), span)), enum_decode_body(e, span), span), span)))
    ^out
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:677
fn union_codec_items(e: EnumDef, items: [Item]) -> [Item] {
    encode :: has_derive(e.derives, ENCODE)
    decode :: has_derive(e.derives, DECODE)
    span := e.name_span
    loop (name, location) in e.derives { if name == ENCODE || name == DECODE { span = location; break } }
    out := [Item]{}
    if encode -> &out.push(Item.Impl(serde_impl(e.name, ENCODE, serde_method("encode", [], [self_param(span)], Val(data_tree_type()), union_encode_body(e, span), span), span)))
    if decode -> &out.push(Item.Impl(serde_impl(e.name, DECODE, serde_method("decode", [], [named_param("tree", data_tree_type(), span)], Val(result_type(target_type(e.name, e.type_params), span)), union_decode_body(e, items, span), span), span)))
    ^out
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:725
fn union_encode_body(e: EnumDef, span: Span) -> [Stmt] {
    arms := [SwitchArm]{}
    loop variant in e.variants {
        binding :: "jet_serde_union_{variant.name.replace(".", "_")}"
        &arms.push(SwitchArm{cond: pattern_test("self", variant, [binding], span), body: [ret(method(ident(binding, span), "encode", [], span), span)], span: span})
    }
    [Stmt.Switch{subject: ident("self", span), arms: ^arms, else_body: None, span: span}]
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:749
fn union_decode_body(e: EnumDef, items: [Item], span: Span) -> [Stmt] {
    body := [Stmt]{}
    loop (index, variant) in e.variants {
        if variant.payload != .Single(member, _) -> next
        shapes :: resolved_decode_wire_shapes(items, member) ?? next
        wire_variants := [String]{}
        loop shape in shapes {
            if shape == {
                .Int -> {
                    if !wire_variants.contains("Int") -> &wire_variants.push("Int")
                    if !wire_variants.contains("Number") -> &wire_variants.push("Number")
                }
                .Float -> {
                    if !wire_variants.contains("Float") -> &wire_variants.push("Float")
                    if !wire_variants.contains("Number") -> &wire_variants.push("Number")
                }
                else -> { name :: shape.name(); if !wire_variants.contains(name) -> &wire_variants.push(name) }
            }
        }
        loop wire_variant in wire_variants {
            value_name :: "jet_serde_union_value_{index}"
            decode :: try_expr(method_with_type_args(copy(ident("tree", span), span), "decode", [~member], span), span)
            branch :: [binding(value_name, None, ^decode, false, span), ret(ok(enum_constructor_from_binding(variant, value_name, e.name, span), span), span)]
            bindings :: if wire_variant == "Null" -> [String]{} else -> ["jet_serde_union_wire_{index}"]
            &body.push(pattern_switch(copy(ident("tree", span), span), wire_variant, ^bindings, ^branch, Val([]), span))
        }
    }
    &body.push(no_matching_union(span))
    ^body
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:829
fn serde_impl(type_name: String, trait_name: String, method: Func, span: Span) -> ImplDef {
    ImplDef{span: span, type_name: type_name, type_span: span, trait_name: Val(trait_name),
        operator_rhs: None, operator_marker: None, trait_span: Val(span), methods: [^method],
        delegation_field: None, assoc_type_impls: [], is_generated_serde: true, os_target: None}
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:846
fn serde_method(name: String, type_params: [TypeParam], params: [Param], return_type: Type?, body: [Stmt], span: Span) -> Func {
    function := Func.implicit_run(^body, span)
    function.name = name
    function.name_span = span
    function.type_params = ^type_params
    function.params = ^params
    function.return_type = ^return_type
    function.return_type_span = if function.return_type == None -> None else -> Val(span)
    function.compiler_generated = true
    ^function
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:865
fn struct_encode_body(s: StructDef, span: Span) -> [Stmt] {
    fields := [Field]{}
    has_flatten := false
    loop field in s.fields {
        if field.computed == None && !has_marker(field.serde_markers, MARKER_SKIP) {
            &fields.push(field)
            if has_marker(field.serde_markers, MARKER_FLATTEN) -> has_flatten = true
        }
    }
    if !has_flatten -> return ordered_encode_fields(s, fields, span)
    body := [binding("out", Val(map_type(data_tree_type(), span)), map_literal([], span), true, span)]
    loop field in fields {
        key :: serde_field_key(s, field)
        if has_marker(field.serde_markers, MARKER_FLATTEN) {
            nested :: "jet_serde_nested_{field.name}"
            &body.push(binding(nested, None, method(field_value(field, span), "encode", [], span), false, span))
            &body.push(pattern_switch(copy(ident(nested, span), span), "Object", ["entries"],
                [for_each_map("key", "value", ident("entries", span), [assign_index("out", ident("key", span), ident("value", span), span)], span)], Val([]), span))
        } else if field.ty == .Option(_) {
            &body.push(option_encode(copy(field_value(field, span), span), key, [field.name], span))
        } else -> &body.push(assign_index("out", string_expr(key, span), method(field_value(field, span), "encode", [], span), span))
    }
    &body.push(ret(data_tree_object_expr(ident("out", span), span), span))
    ^body
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:944
// Each emitted field appends one ordered row; absent options emit no row.
fn ordered_encode_fields(structure: StructDef, fields: [Field], span: Span) -> [Stmt] {
    // Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:949
    const PAIRS: String = "jet_serde_pairs"
    pairs_ty :: data_tree_object_pairs_ty()
    if pairs_ty != .List(pair_ty) -> panic("the ordered Object payload is a list")
    push_pair :: |key: String, value: Expr| -> Stmt {
        expr_stmt(method(ident(PAIRS, span), "push", [Expr.TupleLit([("key", string_expr(key, span)), ("value", ^value)], span, Val(~pair_ty))], span))
    }
    body := [binding(PAIRS, Val(~pairs_ty), list_literal([], span), true, span)]
    loop field in fields {
        key :: serde_field_key(structure, field)
        if field.ty == .Option(_) {
            binding_name :: "jet_serde_option_value_{field.name.replace(".", "_")}"
            present :: push_pair(key, method(ident(binding_name, span), "encode", [], span))
            &body.push(option_switch(copy(field_value(field, span), span), binding_name, [^present], [], span))
        } else -> &body.push(push_pair(key, method(field_value(field, span), "encode", [], span)))
    }
    &body.push(ret(data_tree_object_expr(ident(PAIRS, span), span), span))
    ^body
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:1002
fn serde_decode_error_body(error_name: String, missing: String?, key: String?, span: Span) -> [Stmt] {
    body := [Stmt]{}
    if missing == .Val(missing_name) && key == .Val(key_name) {
        &body.push(if_stmt(ident(missing_name, span), [expr_stmt(method(ident("jet_serde_errors", span), "push", [field_error(key_name, "E2410: missing required field `{key_name}`", span)], span))], span))
        &body.push(if_stmt(unary_not(ident(missing_name, span), span), [for_each("jet_serde_field_error", ident(error_name, span), [expr_stmt(method(ident("jet_serde_errors", span), "push", [ident("jet_serde_field_error", span)], span))], span)], span))
    } else {
        &body.push(for_each("jet_serde_field_error", ident(error_name, span), [expr_stmt(method(ident("jet_serde_errors", span), "push", [ident("jet_serde_field_error", span)], span))], span))
    }
    ^body
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:1055
fn struct_decode_body(s: StructDef, span: Span) -> [Stmt] {
    body := [binding("jet_serde_errors", Val(field_error_list_type(span)), list_literal([], span), true, span)]
    &body.push(binding("jet_serde_is_object", Val(Type.Bool), Expr.Bool(false, span), true, span))
    &body.push(pattern_switch(copy(ident("tree", span), span), "Object", ["jet_serde_root_entries"], [assign_local("jet_serde_is_object", Expr.Bool(true, span), span)], Val([]), span))
    &body.push(if_stmt(unary_not(ident("jet_serde_is_object", span), span), [ret(err(list_literal([field_error("", "expected an object", span)], span), span), span)], span))
    deny_unknown :: has_marker(s.serde_markers, MARKER_DENY_UNKNOWN_FIELDS)
    has_flatten := false
    loop field in s.reflection_fields() { if has_marker(field.serde_markers, MARKER_FLATTEN) -> has_flatten = true }
    if deny_unknown && !has_flatten {
        keys := [Expr]{}
        loop field in s.reflection_fields() {
            if !has_marker(field.serde_markers, MARKER_SKIP) -> &keys.push(string_expr(serde_field_key(s, field), span))
        }
        allowed :: list_literal(^keys, span)
        &body.push(pattern_switch(copy(ident("tree", span), span), "Object", ["entries"],
            [for_each_map("key", "value", ident("entries", span), [if_stmt(unary_not(method(~allowed, "contains", [ident("key", span)], span), span),
                [expr_stmt(method(ident("jet_serde_errors", span), "push", [field_error_expr_value(copy(ident("key", span), span), interpolated_string("E2412: unknown field `", ident("key", span), "`", span), span)], span))], span)], span)], Val([]), span))
    }
    field_values := [(String, Expr)]{}
    decoded := [(String, String, String?, String?)]{}
    required := [(String, String)]{}
    loop field in s.reflection_fields() {
        value := Expr.Absent(span)
        if has_marker(field.serde_markers, MARKER_SKIP) {
            value = serde_default_expr(field) ?? serde_zero_expr(field.ty, span)
        } else if has_marker(field.serde_markers, MARKER_FLATTEN) {
            result :: "jet_serde_decode_{field.name}"
            index :: field_values.len()
            slot :: "jet_serde_field_value_{index}"
            value_name :: "jet_serde_decoded_value_{index}"
            ok_value :: "jet_serde_ok_value_{index}"
            &body.push(binding(slot, Val(Type.Option(~field.ty)), Expr.Absent(span), true, span))
            &body.push(binding(result, None, method_with_type_args(ident("tree", span), "decode", [~field.ty], span), false, span))
            error_name :: "jet_serde_field_errors_{index}"
            &body.push(result_switch(ident(result, span), ok_value, [assign_local(slot, Expr.Present(ident(ok_value, span), span), span)], error_name, serde_decode_error_body(error_name, None, None, span), span))
            &decoded.push((slot, value_name, None, None))
            value = ident(value_name, span)
        } else {
            key :: serde_field_key(s, field)
            optional :: if field.ty == .Option(_) -> true else -> false
            is_required :: !optional && serde_default_expr(field) == None
            missing := None as String?
            if is_required {
                name :: "jet_serde_missing_required_{decoded.len()}"
                &body.push(binding(name, Val(Type.Bool), Expr.Bool(false, span), true, span))
                &required.push((name, key))
                missing = Val(name)
            }
            fallback := data_tree_null(span)
            if !optional {
                if serde_default_expr(field) == .Val(default) -> fallback = method(^default, "encode", [], span)
            }
            subtree :: or_fallback(method(ident("tree", span), "field", [string_expr(key, span)], span), ^fallback, span)
            index :: field_values.len()
            result :: "jet_serde_decode_{field.name}"
            slot :: "jet_serde_field_value_{index}"
            value_name :: "jet_serde_decoded_value_{index}"
            ok_value :: "jet_serde_ok_value_{index}"
            slot_ty :: if optional -> ~field.ty else -> Type.Option(~field.ty)
            &body.push(binding(slot, Val(^slot_ty), Expr.Absent(span), true, span))
            &body.push(binding(result, None, field_error_under(key, method_with_type_args(^subtree, "decode", [~field.ty], span), span), false, span))
            error_name :: "jet_serde_field_errors_{index}"
            ok_body :: if optional -> [assign_local(slot, ident(ok_value, span), span)] else -> [assign_local(slot, Expr.Present(ident(ok_value, span), span), span)]
            &body.push(result_switch(ident(result, span), ok_value, ^ok_body, error_name, serde_decode_error_body(error_name, missing, Val(key), span), span))
            if optional -> value = ident(slot, span)
            else {
                &decoded.push((slot, value_name, missing, Val(key)))
                value = ident(value_name, span)
            }
        }
        &field_values.push((field.name, ^value))
    }
    if !required.is_empty() {
        presence_body := [Stmt]{}
        checks := [Stmt]{}
        loop (missing, key) in required {
            &presence_body.push(assign_local(missing, Expr.Bool(true, span), span))
            &checks.push(if_stmt(binary(BinOp.Eq, ident("jet_serde_presence_key", span), string_expr(key, span), span), [assign_local(missing, Expr.Bool(false, span), span)], span))
        }
        &presence_body.push(for_each_map("jet_serde_presence_key", "jet_serde_presence_value", ident("jet_serde_presence_entries", span), ^checks, span))
        &body.push(pattern_switch(copy(ident("tree", span), span), "Object", ["jet_serde_presence_entries"], ^presence_body, Val([]), span))
    }
    decoded_lit :: struct_literal(target_type_name(s.name), type_args_from_params(s.type_params, span), ^field_values, span)
    success := [binding("decoded", None, ^decoded_lit, false, span)]
    if s.validate_block.is_empty() -> &success.push(ret(ok(ident("decoded", span), span), span))
    else -> &success.push(ret(method_with_owner_args(ident(s.name, span), "validate", type_args_from_params(s.type_params, span), [ident("decoded", span)], span), span))
    loop (slot, value, _, _) in decoded.iter().rev() -> success = [pattern_switch(ident(slot, span), "Val", [value], ^success, Val([]), span)]
    &body.push(if_stmt(method(ident("jet_serde_errors", span), "is_empty", [], span), ^success, span))
    &body.push(ret(err(ident("jet_serde_errors", span), span), span))
    ^body
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:1375
fn enum_encode_body(e: EnumDef, span: Span) -> [Stmt] {
    tag := None as String?
    loop marker in e.serde_markers { if marker.name == MARKER_TAG { tag = marker_static_string(marker); break } }
    untagged :: has_marker(e.serde_markers, MARKER_UNTAGGED)
    style :: serde_rename_all_style(e.serde_markers)
    arms := [SwitchArm]{}
    loop variant in e.variants {
        bindings :: payload_bindings(variant.payload, "v")
        value :: enum_wire_value(variant, tag, untagged, style, span)
        &arms.push(SwitchArm{cond: pattern_test("self", variant, ^bindings, span), body: [ret(^value, span)], span: span})
    }
    [Stmt.Switch{subject: ident("self", span), arms: ^arms, else_body: None, span: span}]
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:1404
fn enum_wire_value(variant: Variant, tag: String?, untagged: Bool, style: String?, span: Span) -> Expr {
    wire :: serde_enum_variant_key(variant, style)
    if !untagged && tag == .Val(tag_name) && variant.payload == .Named(fields) {
        entries := [(string_expr(tag_name, span), data_tree_text(wire, span))]
        loop (index, field) in fields -> &entries.push((string_expr(field.name, span), method(ident("v{index}", span), "encode", [], span)))
        return data_tree_object(^entries, span)
    }
    payload :: if variant.payload == {
        .Unit -> data_tree_null(span)
        .Single(_, _) -> method(ident("v0", span), "encode", [], span)
        .Named(fields) -> {
            entries := [(Expr, Expr)]{}
            loop (index, field) in fields -> &entries.push((string_expr(field.name, span), method(ident("v{index}", span), "encode", [], span)))
            data_tree_object(^entries, span)
        }
    }
    if untagged -> return ^payload
    if tag == .Val(tag_name) {
        entries := [(string_expr(tag_name, span), data_tree_text(wire, span))]
        if variant.payload != .Unit {
            if variant.payload == .Single(_, _) -> &entries.push((string_expr("value", span), ^payload))
            else if payload == .MethodCall(_, _, _, args, _, _) {
                if !args.is_empty() && args[0].expr == .MapLit(pairs, _) -> &entries.extend(^pairs)
            }
        }
        return data_tree_object(^entries, span)
    }
    if variant.payload == .Unit -> data_tree_text(wire, span)
    else -> data_tree_object([(string_expr(wire, span), ^payload)], span)
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:1481
fn enum_decode_body(e: EnumDef, span: Span) -> [Stmt] {
    tag := None as String?
    loop marker in e.serde_markers { if marker.name == MARKER_TAG { tag = marker_static_string(marker); break } }
    untagged :: has_marker(e.serde_markers, MARKER_UNTAGGED)
    style :: serde_rename_all_style(e.serde_markers)
    if untagged {
        body := [Stmt]{}
        loop variant in e.variants {
            decoded :: method_with_type_args(ident("tree", span), "decode", [enum_payload_type(variant)], span)
            binding_name :: "jet_serde_enum_value_{variant.name.replace(".", "_")}"
            value :: enum_constructor_from_binding(variant, binding_name, e.name, span)
            &body.push(pattern_switch(^decoded, "Ok", [binding_name], [ret(ok(^value, span), span)], Val([]), span))
        }
        &body.push(no_matching_enum(span))
        return ^body
    }
    if tag == .Val(tag_name) {
        tag_decode :: field_error_under(tag_name, method_with_type_args(or_fallback(method(ident("tree", span), "field", [string_expr(tag_name, span)], span), data_tree_null(span), span), "decode", [Type.String], span), span)
        body := [binding("tag_value", None, try_expr(^tag_decode, span), false, span)]
        loop variant in e.variants {
            wire :: serde_enum_variant_key(variant, style)
            payload_source :: if variant.payload == .Single(_, _) -> try_expr(method(ident("tree", span), "field", [string_expr("value", span)], span), span) else -> ident("tree", span)
            value :: enum_decode_value(variant, payload_source, e.name, span)
            &body.push(if_stmt(binary(BinOp.Eq, ident("tag_value", span), string_expr(wire, span), span), enum_decode_variant_body(variant, ^value, payload_source, e.name, span), span))
        }
        &body.push(no_matching_enum(span))
        return ^body
    }
    body := [Stmt]{}
    loop variant in e.variants {
        wire :: serde_enum_variant_key(variant, style)
        if variant.payload == .Unit {
            binding_name :: "jet_serde_enum_variant_name_{variant.name.replace(".", "_")}"
            decoded :: method_with_type_args(copy(ident("tree", span), span), "decode", [Type.String], span)
            &body.push(pattern_switch(^decoded, "Ok", [binding_name], [if_stmt(binary(BinOp.Eq, ident(binding_name, span), string_expr(wire, span), span), [ret(ok(enum_constructor_unit(e.name, variant, span), span), span)], span)], Val([]), span))
        } else {
            // Each candidate owns a scope so later returns do not retain earlier locals (#3871).
            candidate :: "candidate_{variant.name.replace(".", "_")}"
            candidate_expr :: or_fallback(method(copy(ident("tree", span), span), "field", [string_expr(wire, span)], span), data_tree_null(span), span)
            attempt := [binding(candidate, None, ^candidate_expr, false, span)]
            source :: ident(candidate, span)
            value :: enum_decode_value(variant, source, e.name, span)
            if variant.payload == .Single(_, _) {
                decoded :: method_with_type_args(source, "decode", [enum_payload_type(variant)], span)
                binding_name :: "jet_serde_enum_decoded_{variant.name.replace(".", "_")}"
                &attempt.push(pattern_switch(^decoded, "Ok", [binding_name], [ret(ok(enum_constructor_from_binding(variant, binding_name, e.name, span), span), span)], Val([]), span))
            } else -> &attempt.extend(^value)
            &body.push(scope_stmt(^attempt, span))
        }
    }
    &body.push(no_matching_enum(span))
    ^body
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:1651
fn enum_decode_variant_body(variant: Variant, value: [Stmt], source: Expr, type_name: String, span: Span) -> [Stmt] {
    if variant.payload == {
        .Unit -> [ret(ok(enum_constructor_unit(type_name, variant, span), span), span)]
        .Single(ty, _) -> {
            decoded :: method_with_type_args(~source, "decode", [~ty], span)
            binding_name :: "jet_serde_enum_decoded_{variant.name.replace(".", "_")}"
            [pattern_switch(^decoded, "Ok", [binding_name], [ret(ok(enum_constructor_from_binding(variant, binding_name, type_name, span), span), span)], Val([]), span)]
        }
        .Named(_) -> ^value
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:1685
fn enum_decode_value(variant: Variant, source: Expr, type_name: String, span: Span) -> [Stmt] {
    if variant.payload != .Named(fields) -> return []
    stem :: variant.name.replace(".", "_")
    errors_name :: "jet_serde_enum_{stem}_errors"
    body := [binding(errors_name, Val(field_error_list_type(span)), list_literal([], span), true, span)]
    results := [String]{}
    loop field in fields {
        result :: "jet_serde_enum_{stem}_decode_{field.name}"
        subtree :: or_fallback(method(copy(~source, span), "field", [string_expr(field.name, span)], span), data_tree_null(span), span)
        &body.push(binding(result, None, field_error_under(field.name, method_with_type_args(^subtree, "decode", [~field.ty], span), span), false, span))
        &results.push(result)
    }
    loop (index, result) in results {
        error_name :: "jet_serde_enum_{stem}_errors_{index}"
        &body.push(pattern_switch(copy(ident(result, span), span), "Err", [error_name], [for_each("jet_serde_enum_error", ident(error_name, span), [expr_stmt(method(ident(errors_name, span), "push", [ident("jet_serde_enum_error", span)], span))], span)], Val([]), span))
    }
    value_fields := [(String, Expr)]{}
    loop field in fields -> &value_fields.push((field.name, ident("jet_serde_enum_{stem}_value_{field.name}", span)))
    success := [ret(ok(enum_constructor_named(type_name, variant, ^value_fields, span), span), span)]
    loop (index, result) in results.iter().enumerate().rev() {
        value_name :: "jet_serde_enum_{stem}_value_{fields[index].name}"
        success = [pattern_switch(copy(ident(result, span), span), "Ok", [value_name], ^success, Val([]), span)]
    }
    &body.push(if_stmt(method(ident(errors_name, span), "is_empty", [], span), ^success, span))
    ^body
}

// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:1804
fn enum_constructor_unit(type_name: String, variant: Variant, span: Span) -> Expr {
    Expr.EnumLit{type_name: type_name, variant: variant.name, variant_span: None, args: [], leading_dot: false, span: span}
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:1815
fn enum_constructor_from_binding(variant: Variant, binding: String, type_name: String, span: Span) -> Expr {
    if variant.payload == {
        .Unit -> enum_constructor_unit(type_name, variant, span)
        .Single(_, _) -> Expr.EnumLit{type_name: type_name, variant: variant.name, variant_span: None, args: [EnumLitArg.Positional(ident(binding, span))], leading_dot: false, span: span}
        .Named(_) -> enum_constructor_unit(type_name, variant, span)
    }
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde.rs:1835
fn enum_constructor_named(type_name: String, variant: Variant, fields: [(String, Expr)], span: Span) -> Expr {
    args := [EnumLitArg]{}
    loop (label, expr) in fields -> &args.push(EnumLitArg.Named{label: label, expr: ^expr})
    Expr.EnumLit{type_name: type_name, variant: variant.name, variant_span: None, args: ^args, leading_dot: false, span: span}
}
