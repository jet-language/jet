//RS /// Append one `(key, value)` row per emitted field to the ordered Object
//RS /// payload, in declaration order, and hand the list to `DataTree.Object`.
//RS /// Absent optional fields append nothing, so they stay off the wire. Each field
//RS /// contributes one statement: the body is linear in the field count (a
//RS /// literal per present/absent combination would be exponential in the number
//RS /// of optional fields).
//RS fn ordered_encode_fields(
//RS     structure: &crate::AST::StructDef,
//RS     fields: &[&crate::AST::Field],
//RS     span: Span,
//RS ) -> Vec<Stmt> {
//RS     const PAIRS: &str = "jet_serde_pairs";
//RS     let pairs_ty = crate::Sema::data_tree_object_pairs_ty();
//RS     let Type::List(pair_ty) = &pairs_ty else {
//RS         unreachable!("the ordered Object payload is a list");
//RS     };
//RS     let push_pair = |key: &str, value: Expr| {
//RS         expr_stmt(method(
//RS             ident(PAIRS, span),
//RS             "push",
//RS             vec![Expr::TupleLit(
//RS                 vec![
//RS                     ("key".to_string(), string_expr(key, span)),
//RS                     ("value".to_string(), value),
//RS                 ],
//RS                 span,
//RS                 Some((**pair_ty).clone()),
//RS             )],
//RS             span,
//RS         ))
//RS     };
//RS     let mut body = vec![binding(
//RS         PAIRS,
//RS         Some(pairs_ty.clone()),
//RS         list_literal(Vec::new(), span),
//RS         true,
//RS         span,
//RS     )];
//RS     for field in fields {
//RS         let key = serde_field_key(structure, field);
//RS         if matches!(field.ty, Type::Option(_)) {
//RS             let binding_name = format!("jet_serde_option_value_{}", field.name.replace('.', "_"));
//RS             let present = push_pair(
//RS                 &key,
//RS                 method(ident(&binding_name, span), "encode", Vec::new(), span),
//RS             );
//RS             body.push(option_switch(
//RS                 copy(field_value(field, span), span),
//RS                 &binding_name,
//RS                 vec![present],
//RS                 Vec::new(),
//RS                 span,
//RS             ));
//RS         } else {
//RS             body.push(push_pair(
//RS                 &key,
//RS                 method(field_value(field, span), "encode", Vec::new(), span),
//RS             ));
//RS         }
//RS     }
//RS     body.push(ret(data_tree_object_expr(ident(PAIRS, span), span), span));
//RS     body
