// This rule identifier casing law (E0357), owner-amended so module-global
// constants are ALL_CAPS. Type-like names are PascalCase and value-like names
// are snake_case. The category chosen at each declaration site fixes the case;
// foreign declarations are exempt zones. Whose UI snapshots are the spec.
use jet_foundation.[
    ASTTables,
    BinMatchPart,
    BindName,
    BindPattern,
    Binding,
    CallArg,
    Diagnostic,
    Expr,
    Func,
    Item,
    NamedSpan,
    Param,
    PatSlot,
    Pattern,
    Program,
    Span,
    Stmt,
    StrMatchPart,
    SwitchArm,
    TextEdit,
    TraitImplBlock,
    TraitMethodSig,
    Type,
    TypeAliasDef,
    TypeParam,
    TypedLitBody,
    SemaNameCase,
    sema_casing_acronym_name,
    sema_casing_canonical,
    sema_casing_has_case,
    type_name,
    diagnostic_with_edit,
    expr_binary_operands,
]

sema_casing_check: fn(name: String, span: Span, category: String, case: SemaNameCase, diagnostics: ^[Diagnostic]) {
    // Compiler-reserved names have their own diagnostic.
    if name == "" || name.starts_with("__") || sema_casing_has_case(name, case) {
        return
    }
    expected: if case == {
        .Pascal -> "PascalCase"
        .Snake -> "snake_case"
        .Screaming -> "ALL_CAPS"
    }
    fixed: sema_casing_canonical(name, case)
    // The respelling can equal the name (`type_`, `_0`): never suggest
    // identical text, and name the rule the name breaks.
    fix: if fixed == name -> "rename it: {sema_casing_unfixable_rule(name)}, so pick another word" else -> "rename it to `{fixed}`"
    diagnostics.push(
        sema_error(
            "E0357",
            span,
            "{category} `{name}` must be {expected}",
            "Jet enforces PascalCase for type-like names, snake_case for value-like names, and ALL_CAPS (SCREAMING_SNAKE_CASE) for module-global constants",
            fix,
        ),
    )
}

// The rule a name breaks when no respelling of its case fixes it.
sema_casing_unfixable_rule: fn(name: String) -> String Never! {
    body: if name.starts_with("_") -> name.slice(1, name.len()) else -> name
    if body.len() > 0 && "0123456789".contains(body.slice(0, 1)) {
        return if name.starts_with("_") -> "a leading `_` followed by a digit isn't a valid name" else -> "a name can't start with a digit"
    }
    if name.ends_with("_") -> return "a name can't end with `_`"
    if name.contains("__") -> return "a name can't hold `__`"
    "a name needs a letter after its leading `_`"
}

// E0358: a type-like declaration keeps every lexicon acronym
// in caps. The edit replaces the whole written name when the span covers it.
sema_casing_acronyms: fn(name: String, span: Span, diagnostics: ^[Diagnostic]) {
    if sema_casing_acronym_diagnostic(name, span) == .Val(diagnostic) {
        diagnostics.push(diagnostic)
    }
}

// The E0358 for a type-like name that writes a lexicon acronym word-cased,
// in a declaration or in a type position (`Id<Node>`, `HttpRequest`).
sema_casing_acronym_diagnostic: fn(name: String, span: Span) -> Diagnostic? {
    if span.start == span.end -> return None
    parts := [String]{}
    loop segment in name.split(".") {
        if !sema_casing_has_case(segment, SemaNameCase.Pascal) -> return None
        parts.push(sema_casing_acronym_name(segment))
    }
    canonical: parts.join(".")
    if canonical == name -> return None
    diagnostic: sema_error(
        "E0358",
        span,
        "`{name}` is spelled `{canonical}`",
        "Jet keeps acronyms fully capitalized inside PascalCase names",
        "write `{canonical}` instead of `{name}`",
    )
    if span.end - span.start != name.bytes().len() -> return Val(diagnostic)
    Val(diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: canonical}))
}

sema_casing_pascal: fn(name: String, span: Span, category: String, diagnostics: ^[Diagnostic]) {
    loop segment in name.split(".") {
        sema_casing_check(segment, span, category, SemaNameCase.Pascal, diagnostics)
    }
    sema_casing_acronyms(name, span, diagnostics)
}

sema_casing_snake: fn(name: String, span: Span, category: String, diagnostics: ^[Diagnostic]) {
    // Most names have no `.` or `-` to split on.
    if !name.contains(".") && !name.contains("-") {
        sema_casing_check(name, span, category, SemaNameCase.Snake, diagnostics)
        return
    }
    loop part in name.split(".") {
        loop segment in part.split("-") {
            sema_casing_check(segment, span, category, SemaNameCase.Snake, diagnostics)
        }
    }
}

sema_casing_screaming: fn(name: String, span: Span, category: String, diagnostics: ^[Diagnostic]) {
    loop part in name.split(".") {
        loop segment in part.split("-") {
            sema_casing_check(segment, span, category, SemaNameCase.Screaming, diagnostics)
        }
    }
}

// Whether `value` has a declared point's shape: a call of a function named
// `point`, `hook_point` or `decision_point`. Its immutable binding may be
// snake_case or ALL_CAPS here (sema_casing_point_name); whether the call is
// a point is the check's, which finds the constructor by its role and holds
// a binding that is not a point to ALL_CAPS (SemaComptimeItemSource.point_name).
sema_casing_point_shaped: fn(value: Expr) -[]> Bool {
    if value == .Call(call, _) {
        if call.name.cut_last(".") == .Val(parts) {
            return sema_casing_point_constructor_name(parts.after)
        }
        return sema_casing_point_constructor_name(call.name)
    }
    if value == .MethodCall(_, method, _, _, _, _, _) {
        return sema_casing_point_constructor_name(method)
    }
    false
}

sema_casing_point_constructor_name: fn(name: String) -[]> Bool {
    name == "point" || name == "hook_point" || name == "decision_point"
}

// A declared point's name: snake_case or ALL_CAPS; E0357 names the
// snake_case spelling of one that is neither.
sema_casing_point_name: fn(name: String, span: Span, diagnostics: ^[Diagnostic]) -[]> {
    if sema_casing_has_case(name, SemaNameCase.Screaming) {
        return
    }
    sema_casing_snake(name, span, "point", diagnostics)
}

// The zero literal of a number type a file-level `name: Type` names, when the
// declaration reads as a number written without its value (`limit: Int`): a
// value-cased name over a number type and no type parameters.
sema_casing_alias_number_zero: fn(definition: TypeAliasDef) -> String? {
    if definition.type_params.len() != 0 || !sema_casing_has_case(definition.name, SemaNameCase.Snake) {
        return None
    }
    if definition.target == {
        .Int | .IntN(_, _) | .InlineRange(_, _, _) -> Val("0")
        .Float | .Float32 -> Val("0.0")
        .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// E0324 for a file-level alias that reads as a number: `limit: Int` names a
// type, so using `limit` as a number can never check; the fix gives it a value
// as an ALL_CAPS module constant.
sema_casing_alias_number_diagnostic: fn(definition: TypeAliasDef, zero: String) -> Diagnostic {
    target: type_name(definition.target)
    constant: sema_casing_canonical(definition.name, SemaNameCase.Screaming)
    sema_error(
        "E0324",
        definition.name_span,
        "`{definition.name}: {target}` declares a type alias, so `{definition.name}` isn't a number",
        "at file level `name: Type` with no value names a type; a number constant writes its value after the type",
        "give it a value: `{constant}: {target}{{{zero}}}`",
    )
}

// Every generic declaration site (functions and methods, structs, enums,
// aliases) reaches its parameters through this one walk. A `<N: Int>` number
// parameter parses into `TypeParam.prep` and registers as a generic parameter
// whose arguments are numbers, so its name follows no type casing.
sema_casing_type_parameter: fn(parameter: TypeParam, diagnostics: ^[Diagnostic]) {
    if parameter.prep != None {
        return
    }
    sema_casing_pascal(parameter.name, parameter.name_span, "type parameter", diagnostics)
}

sema_casing_parameters: fn(tables: ASTTables, parameters: [Param], diagnostics: ^[Diagnostic]) {
    loop parameter in parameters {
        if parameter.name != "self" {
            sema_casing_snake(parameter.name, parameter.name_span, "parameter", diagnostics)
        }
        if parameter.default == .Val(value) -> sema_casing_expr(tables, value, diagnostics)
    }
}

sema_casing_function: fn(tables: ASTTables, function: Func, category: String, diagnostics: ^[Diagnostic]) {
    // Result constructors are contextual spellings, not reserved words. A
    // user function may own either name; the call/variant checker decides
    // which meaning applies at each use site.
    if function.name != "Ok" && function.name != "Err" {
        sema_casing_snake(function.name, function.name_span, category, diagnostics)
    }
    loop parameter in function.type_params -> sema_casing_type_parameter(parameter, diagnostics)
    sema_casing_parameters(tables, function.params, diagnostics)
    sema_casing_stmts(tables, function.body, diagnostics)
}

sema_casing_trait_method: fn(tables: ASTTables, method: TraitMethodSig, diagnostics: ^[Diagnostic]) {
    sema_casing_snake(method.name, method.name_span, "method", diagnostics)
    sema_casing_parameters(tables, method.params, diagnostics)
    if method.default_body == .Val(body) -> sema_casing_stmts(tables, body, diagnostics)
}

sema_casing_trait_impl_methods: fn(tables: ASTTables, blocks: [TraitImplBlock], diagnostics: ^[Diagnostic]) {
    loop block in blocks {
        loop method in block.methods -> sema_casing_function(tables, method, "method", diagnostics)
    }
}

sema_casing_item: fn(tables: ASTTables, item: Item, diagnostics: ^[Diagnostic]) {
    if item == {
        .Func(function) -> { sema_casing_function(tables, function, "function", diagnostics) }
        .Struct(definition) -> {
            sema_casing_pascal(definition.name, definition.name_span, "struct", diagnostics)
            loop parameter in definition.type_params {
                sema_casing_type_parameter(parameter, diagnostics)
            }
            loop field in definition.fields {
                sema_casing_snake(field.name, field.name_span, "field", diagnostics)
            }
            if definition.state == .Val(state) {
                loop entry in state.states {
                    sema_casing_pascal(entry.name, entry.span, "state", diagnostics)
                }
            }
            loop method in definition.methods {
                sema_casing_function(tables, method, "method", diagnostics)
            }
            sema_casing_trait_impl_methods(tables, definition.trait_impls, diagnostics)
            sema_casing_stmts(tables, definition.validate_block, diagnostics)
        }
        .Enum(definition) -> {
            sema_casing_pascal(definition.name, definition.name_span, "enum", diagnostics)
            loop parameter in definition.type_params {
                sema_casing_type_parameter(parameter, diagnostics)
            }
            loop group in definition.groups {
                sema_casing_pascal(group.path, group.name_span, "variant group", diagnostics)
            }
            loop variant in definition.variants {
                sema_casing_pascal(variant.name, variant.name_span, "enum variant", diagnostics)
                if variant.payload == .Named(fields) {
                    loop field in fields {
                        sema_casing_snake(field.name, field.name_span, "variant field", diagnostics)
                    }
                }
            }
            loop method in definition.methods {
                sema_casing_function(tables, method, "method", diagnostics)
            }
            sema_casing_trait_impl_methods(tables, definition.trait_impls, diagnostics)
        }
        .Distinct(definition) -> {
            sema_casing_pascal(definition.name, definition.name_span, "distinct type", diagnostics)
        }
        .TypeAlias(definition) -> {
            // A number written without its value gets the one E0324 at registration.
            if sema_casing_alias_number_zero(definition) == None {
                sema_casing_pascal(definition.name, definition.name_span, "type alias", diagnostics)
            }
            loop parameter in definition.type_params {
                sema_casing_type_parameter(parameter, diagnostics)
            }
        }
        .UnitFamily(definition) -> {
            if definition.resolved_owner == Val("core.units") {
                return
            }
            sema_casing_pascal(definition.family, definition.family_span, "unit family", diagnostics)
            loop member in definition.members {
                // SI-accepted `mmHg` keeps its
                // published symbol; all other user members follow snake_case.
                if member.name != "mmHg" {
                    sema_casing_snake(member.name, member.name_span, "unit member", diagnostics)
                }
            }
        }
        .Trait(definition) -> {
            // A trait made from a parameterized one is named by its use,
            // `Store<Int>`; the declared name is the part before `<`.
            sema_casing_pascal(definition.name.partition("<").head, definition.name_span, "trait", diagnostics)
            loop associated in definition.assoc_types {
                sema_casing_pascal(associated.name, associated.span, "associated type", diagnostics)
            }
            loop constant in definition.constants {
                sema_casing_snake(constant.name, constant.name_span, "trait constant", diagnostics)
            }
            loop method in definition.methods {
                sema_casing_trait_method(tables, method, diagnostics)
            }
        }
        .Tag(definition) -> {
            sema_casing_pascal(definition.name, definition.name_span, "tag", diagnostics)
        }
        .Impl(definition) -> {
            loop method in definition.methods {
                sema_casing_function(tables, method, "method", diagnostics)
            }
        }
        .Const(definition) -> {
            // `defaults: { run: … }` is the Output defaults record
            // (syntax-decisions.md:7425), not a user binding: its fixed
            // lowercase name has no casing to check.
            output_defaults: definition.ty == (Val(Type.Named{name: "__OutputDefaults"}))
            // Owner ruling (2026-09-30): an immutable module binding is
            // ALL_CAPS; a mutable one is never ALL_CAPS. A `#ContextKey` is
            // read as `context.get(name)` beside `context.deadline`, so it is
            // snake_case like a field (ContextKeys.jet). A declared point's
            // binding may be snake_case too (sema_casing_point_shaped).
            if {
                output_defaults -> {}
                definition.mutable -> {
                    sema_casing_snake(definition.name, definition.name_span, "module variable", diagnostics)
                }
                sema_context_key_declared(definition) -> {
                    sema_casing_snake(definition.name, definition.name_span, "context key", diagnostics)
                }
                sema_casing_point_shaped(definition.value) -> {
                    sema_casing_point_name(definition.name, definition.name_span, diagnostics)
                }
                else -> {
                    sema_casing_screaming(definition.name, definition.name_span, "constant", diagnostics)
                }
            }
            sema_casing_expr(tables, definition.value, diagnostics)
        }
        .Test(definition) -> {
            loop parameter in definition.params {
                sema_casing_snake(parameter.name, parameter.name_span, "parameter", diagnostics)
            }
            sema_casing_stmts(tables, definition.body, diagnostics)
        }
        .Module(definition) -> {
            sema_casing_snake(definition.name, definition.name_span, "module", diagnostics)
            loop source in definition.sources {
                sema_casing_snake(source.name, source.name_span, "config name", diagnostics)
            }
            loop value in definition.imports -> sema_casing_expr(tables, value, diagnostics)
            loop value in definition.members -> sema_casing_expr(tables, value, diagnostics)
        }
        .CodeModule(definition) -> {
            sema_casing_snake(definition.name, definition.name_span, "module", diagnostics)
            if definition.body == .Val(body) {
                loop nested in body -> sema_casing_item(tables, nested, diagnostics)
            }
        }
        .GenericModule(definition) -> {
            sema_casing_snake(definition.name, definition.name_span, "generic module", diagnostics)
            loop parameter in definition.params {
                if parameter == {
                    .Type(name, name_span, _) -> {
                        sema_casing_pascal(name, name_span, "type parameter", diagnostics)
                    }
                    .Value(name, name_span, _) -> {
                        sema_casing_snake(name, name_span, "value parameter", diagnostics)
                    }
                }
            }
            loop nested in definition.body -> sema_casing_item(tables, nested, diagnostics)
        }
        .ModuleAlias(definition) -> {
            sema_casing_snake(definition.name, definition.name_span, "module alias", diagnostics)
        }
        .ProtocolDecl(definition) -> {
            sema_casing_pascal(definition.name, definition.name_span, "protocol", diagnostics)
            loop message in definition.messages {
                sema_casing_pascal(message.name, message.name_span, "protocol message", diagnostics)
                loop field in message.fields {
                    sema_casing_snake(field.name, message.span, "message field", diagnostics)
                }
            }
        }
        // Foreign declarations are exempt zones. Other
        // declaration families carry no user-defined identifier category.
        .EffectDecl(_) | .ExternRust(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .TemplateLoop(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

sema_casing_bind_names: fn(pattern: BindPattern) -> [BindName] Never! {
    if pattern == {
        .Struct(_, _, fields, _, _) -> fields
        .List(elems, _) | .Tuple(elems, _) -> elems
        .Refutable(_, _, names, _) -> names
    }
}

sema_casing_bind_name: fn(entry: BindName, diagnostics: ^[Diagnostic]) {
    if entry.rename == .Val(rename) {
        return sema_casing_snake(rename.name, rename.span, "local", diagnostics)
    }
    sema_casing_snake(entry.name, entry.span, "local", diagnostics)
}

sema_casing_binding: fn(binding: Binding, diagnostics: ^[Diagnostic]) {
    if binding.pattern == .Val(pattern) {
        loop entry in sema_casing_bind_names(pattern) -> sema_casing_bind_name(entry, diagnostics)
        return
    }
    if binding.is_comptime {
        return sema_casing_snake(binding.name, binding.name_span, "local constant", diagnostics)
    }
    sema_casing_snake(binding.name, binding.name_span, "local", diagnostics)
}

sema_casing_loop_label: fn(label: NamedSpan?, diagnostics: ^[Diagnostic]) {
    if label == .Val(value) -> sema_casing_snake(value.name, value.span, "loop label", diagnostics)
}

// Each arm is read in place.
sema_casing_switch_arms: fn(tables: ASTTables, arms: [SwitchArm], diagnostics: ^[Diagnostic]) {
    loop arm in arms {
        sema_casing_expr(tables, arm.cond, diagnostics)
        sema_casing_stmts(tables, arm.body, diagnostics)
    }
}

sema_casing_stmts: fn(tables: ASTTables, statements: [Stmt], diagnostics: ^[Diagnostic]) {
    loop statement in statements {
        if statement == {
            .Expr(value) | .Yield(value, _) | .DeferClose(value, _) -> {
                sema_casing_expr(tables, value, diagnostics)
            }
            .Val(binding) -> {
                sema_casing_binding(binding, diagnostics)
                sema_casing_expr(tables, binding.init, diagnostics)
            }
            .Assign(target, _, _, value) -> {
                if target == {
                    .Index(base, index, _, _) -> {
                        sema_casing_expr(tables, base, diagnostics)
                        sema_casing_expr(tables, index, diagnostics)
                    }
                    .Field(base, _, _) -> { sema_casing_expr(tables, base, diagnostics) }
                    .Local(_, _) -> {}
                }
                sema_casing_expr(tables, value, diagnostics)
            }
            .Return(value, _) -> {
                if value == .Val(returned) -> sema_casing_expr(tables, returned, diagnostics)
            }
            .While(cond, body, _, _, label) -> {
                sema_casing_expr(tables, cond, diagnostics)
                sema_casing_loop_label(label, diagnostics)
                sema_casing_stmts(tables, body, diagnostics)
            }
            .Loop(body, _, _, label) -> {
                sema_casing_loop_label(label, diagnostics)
                sema_casing_stmts(tables, body, diagnostics)
            }
            .For(variable, variable_span, var2, kind, body, _, _, label, _) -> {
                sema_casing_snake(variable, variable_span, "local", diagnostics)
                if var2 == .Val(second) {
                    sema_casing_snake(second.name, second.span, "local", diagnostics)
                }
                if kind == {
                    .Range(start, end, step, _) -> {
                        sema_casing_expr(tables, start, diagnostics)
                        sema_casing_expr(tables, end, diagnostics)
                        if step == .Val(stride) -> sema_casing_expr(tables, stride, diagnostics)
                    }
                    .In(collection, step) -> {
                        sema_casing_expr(tables, collection, diagnostics)
                        if step == .Val(stride) -> sema_casing_expr(tables, stride, diagnostics)
                    }
                }
                sema_casing_loop_label(label, diagnostics)
                sema_casing_stmts(tables, body, diagnostics)
            }
            .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
                sema_casing_expr(tables, subject, diagnostics)
                sema_casing_switch_arms(tables, arms, diagnostics)
                if else_body == .Val(body) -> sema_casing_stmts(tables, body, diagnostics)
            }
            .CountedLoop(init, cond, step, body, _, _, label) -> {
                sema_casing_binding(init, diagnostics)
                sema_casing_expr(tables, init.init, diagnostics)
                sema_casing_expr(tables, cond, diagnostics)
                if step == .Val(advance) -> sema_casing_stmts(tables, [Stmt]{advance}, diagnostics)
                sema_casing_loop_label(label, diagnostics)
                sema_casing_stmts(tables, body, diagnostics)
            }
            .Region(name, name_span, body, _) | .Layout(name, name_span, body, _) -> {
                sema_casing_snake(name, name_span, "local", diagnostics)
                sema_casing_stmts(tables, body, diagnostics)
            }
            .TaskGroup(name, name_span, _, body, _) -> {
                sema_casing_snake(name, name_span, "local", diagnostics)
                sema_casing_stmts(tables, body, diagnostics)
            }
            .Transact(name, name_span, body, _, _) -> {
                if name == .Val(text) {
                    if name_span == .Val(site) {
                        sema_casing_snake(text, site, "local", diagnostics)
                    }
                }
                sema_casing_stmts(tables, body, diagnostics)
            }
            .ComptimeIf(cond, _, then_body, else_body, _, _) -> {
                sema_casing_expr(tables, cond, diagnostics)
                sema_casing_stmts(tables, then_body, diagnostics)
                if else_body == .Val(body) -> sema_casing_stmts(tables, body, diagnostics)
            }
            .ContextBlock(fields, body, _) -> {
                loop field in fields -> sema_casing_expr(tables, field.value, diagnostics)
                sema_casing_stmts(tables, body, diagnostics)
            }
            .ScopeMember(_, _, args, _, body, _, _, _) -> {
                loop arg in args -> sema_casing_expr(tables, arg, diagnostics)
                sema_casing_stmts(tables, body, diagnostics)
            }
            // The optional name-before-list head binds
            // the scoped Authority handle.
            .AuthorityScope(_, _, handle, body, _) -> {
                if handle == .Val(value) {
                    sema_casing_snake(value.name, value.span, "local", diagnostics)
                }
                sema_casing_stmts(tables, body, diagnostics)
            }
            .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .AssumeDet(_, _, body, _) -> {
                sema_casing_stmts(tables, body, diagnostics)
            }
            .Reactive(body, _) | .Shield(body, _) | .Defer(body, _) | .Live(body, _) -> {
                sema_casing_stmts(tables, body, diagnostics)
            }
            .Switched(_, body, _) | .Policy(_, body, _) | .ComptimeBlock(body, _, _) -> {
                sema_casing_stmts(tables, body, diagnostics)
            }
            .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> {
                sema_casing_expr(tables, value, diagnostics)
            }
            .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
        }
    }
}

sema_casing_str_match_holes: fn(parts: [StrMatchPart], diagnostics: ^[Diagnostic]) {
    loop part in parts {
        if part == .Hole(name, _, span) {
            sema_casing_snake(name, span, "pattern binding", diagnostics)
        }
    }
}

sema_casing_bin_match_holes: fn(parts: [BinMatchPart], diagnostics: ^[Diagnostic]) {
    loop part in parts {
        if part == .Hole(name, _, span) {
            sema_casing_snake(name, span, "pattern binding", diagnostics)
        }
    }
}

sema_casing_pattern: fn(tables: ASTTables, pattern: Pattern, diagnostics: ^[Diagnostic]) {
    if pattern == {
        .Variant(_, bindings, _, _) -> {
            loop slot in bindings -> sema_casing_pattern_slot(tables, slot, diagnostics)
        }
        .Present(binding, binding_span, inner, _) | .Ok(binding, binding_span, inner, _) | .Err(binding, binding_span, inner, _) -> {
            if inner == .Val(nested) -> sema_casing_pattern(tables, nested, diagnostics) else {
                sema_casing_snake(binding, binding_span, "pattern binding", diagnostics)
            }
        }
        .Or(alternatives, _) -> {
            loop alternative in alternatives {
                sema_casing_pattern(tables, alternative, diagnostics)
            }
        }
        .Struct(fields, _, _, _) -> {
            loop field in fields {
                if field == {
                    .Bind(_, _, local, local_span) -> {
                        sema_casing_snake(local, local_span, "pattern binding", diagnostics)
                    }
                    .Value(_, _, value) -> { sema_casing_expr(tables, value, diagnostics) }
                    .Nested(_, _, nested) -> sema_casing_pattern(tables, nested, diagnostics)
                }
            }
        }
        .List(items, rest, _) -> {
            loop item in items -> sema_casing_pattern_slot(tables, item, diagnostics)
            if rest == .Val(tail) && tail.name == .Val(binding) {
                sema_casing_snake(binding.name, binding.span, "pattern binding", diagnostics)
            }
        }
        .Map(entries, _, _) -> {
            loop entry in entries {
                sema_casing_expr(tables, entry.key, diagnostics)
                sema_casing_pattern_slot(tables, entry.slot, diagnostics)
            }
        }
        .StrMatch(parts, _) -> { sema_casing_str_match_holes(parts, diagnostics) }
        .BinMatch(parts, _) -> sema_casing_bin_match_holes(parts, diagnostics)
        .Absent(_) | .Range(_, _, _) -> {}
    }
}

sema_casing_pattern_slot: fn(tables: ASTTables, slot: PatSlot, diagnostics: ^[Diagnostic]) {
    if slot == {
        .Bind(name, span) -> { sema_casing_snake(name, span, "pattern binding", diagnostics) }
        .Nested(nested) -> { sema_casing_pattern(tables, nested, diagnostics) }
        // `field: slot` binds what its slot binds.
        .Named(_, _, inner) -> { sema_casing_pattern_slot(tables, inner, diagnostics) }
        .Value(value) -> sema_casing_expr(tables, value, diagnostics)
        .Wildcard | .Range(_, _) | .Rest(_) -> {}
    }
}

sema_casing_call_args: fn(tables: ASTTables, args: [CallArg], diagnostics: ^[Diagnostic]) {
    loop arg in args -> sema_casing_expr(tables, arg.expr, diagnostics)
}

sema_casing_typed_literal: fn(tables: ASTTables, body: TypedLitBody, diagnostics: ^[Diagnostic]) {
    if body == {
        .Fields(fields) -> {
            loop field in fields -> sema_casing_expr(tables, field.value, diagnostics)
        }
        .Elements(elements) -> {
            loop value in elements -> sema_casing_expr(tables, value, diagnostics)
        }
        .Entries(entries) -> {
            loop entry in entries {
                sema_casing_expr(tables, entry.key, diagnostics)
                sema_casing_expr(tables, entry.value, diagnostics)
            }
        }
        .Value(value) -> sema_casing_expr(tables, value, diagnostics)
        .ByteText(_) | .Empty -> {}
    }
}

sema_casing_expr: fn(tables: ASTTables, expr: Expr, diagnostics: ^[Diagnostic]) {
    if expr == {
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(value, _) -> sema_casing_expr(tables, value, diagnostics)
            }
        }
        .StrMatchLit(parts, _, _) -> { sema_casing_str_match_holes(parts, diagnostics) }
        .BinMatchLit(parts, _, _) -> { sema_casing_bin_match_holes(parts, diagnostics) }
        .Call(call, _) -> sema_casing_call_args(tables, call.args, diagnostics)
        .Unary(_, inner, _, _) | .Deref(inner, _, _) | .RawOf(inner, _, _) | .Copy(inner, _, _) | .Place(inner, _, _, _) | .Field(inner, _, _, _) | .Tainted(inner, _, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .Paren(inner, _, _) | .Spread(inner, _, _) -> {
            sema_casing_expr(tables, inner, diagnostics)
        }
        .Try(inner, _, _, context, _) -> {
            sema_casing_expr(tables, inner, diagnostics)
            if context == .Val(note) -> sema_casing_expr(tables, note, diagnostics)
        }
        .MemberSpread(base, _, _, _) | .OptField(base, _, _, _, _, _) -> {
            sema_casing_expr(tables, base, diagnostics)
        }
        .MethodCall(receiver, _, _, _, _, args, _) | .OptMethodCall(receiver, _, _, _, args, _, _) -> {
            sema_casing_expr(tables, receiver, diagnostics)
            sema_casing_call_args(tables, args, diagnostics)
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            loop field in fields -> sema_casing_expr(tables, field.value, diagnostics)
        }
        .TypedLit(_, body, _, _) -> { sema_casing_typed_literal(tables, body, diagnostics) }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop arg in args {
                if arg == {
                    .Positional(value) -> { sema_casing_expr(tables, value, diagnostics) }
                    .Named(_, value) -> sema_casing_expr(tables, value, diagnostics)
                }
            }
        }
        .OrFallback(value, fallback, _, _, _) -> {
            sema_casing_expr(tables, value, diagnostics)
            if fallback == {
                .Value(other) -> { sema_casing_expr(tables, other, diagnostics) }
                .Return(result, _) -> {
                    if result == .Val(other) -> sema_casing_expr(tables, other, diagnostics)
                }
                .Block(body, result, _) -> {
                    sema_casing_stmts(tables, body, diagnostics)
                    if result == .Val(other) -> sema_casing_expr(tables, other, diagnostics)
                }
                .Panic(_, args) -> sema_casing_call_args(tables, args, diagnostics)
                .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
            }
        }
        .PatternTest(subject, tested, _, _) -> {
            sema_casing_expr(tables, subject, diagnostics)
            sema_casing_pattern(tables, tested, diagnostics)
        }
        .Binary(_, left, right, _, _) -> {
            loop operand in expr_binary_operands(tables, left, right) {
                sema_casing_expr(tables, operand, diagnostics)
            }
        }
        .CompareChain(operands, _, _, _, _) | .ListLit(operands, _, _) -> {
            loop value in operands -> sema_casing_expr(tables, value, diagnostics)
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields -> sema_casing_expr(tables, field.value, diagnostics)
        }
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                sema_casing_expr(tables, entry.key, diagnostics)
                sema_casing_expr(tables, entry.value, diagnostics)
            }
        }
        .Index(base, index, _, _, _) -> {
            sema_casing_expr(tables, base, diagnostics)
            sema_casing_expr(tables, index, diagnostics)
        }
        .Slice(base, start, end, range, _, _) -> {
            sema_casing_expr(tables, base, diagnostics)
            if range == {
                .Val(value) -> { sema_casing_expr(tables, value, diagnostics) }
                .None -> {
                    sema_casing_expr(tables, start, diagnostics)
                    sema_casing_expr(tables, end, diagnostics)
                }
            }
        }
        .Range(start, end, _, _, _) -> {
            sema_casing_expr(tables, start, diagnostics)
            sema_casing_expr(tables, end, diagnostics)
        }
        .CallValue(callee, args, _, _) -> {
            sema_casing_expr(tables, callee, diagnostics)
            sema_casing_call_args(tables, args, diagnostics)
        }
        .Lambda(lambda, _) -> {
            loop parameter in lambda.params {
                sema_casing_snake(parameter.name, parameter.name_span, "lambda parameter", diagnostics)
            }
            if lambda.body == {
                .Expr(value) -> { sema_casing_expr(tables, value, diagnostics) }
                .Block(body) -> sema_casing_stmts(tables, body, diagnostics)
            }
        }
        .If(cond, then_body, then_value, else_body, else_value, _, _) -> {
            sema_casing_expr(tables, cond, diagnostics)
            sema_casing_stmts(tables, then_body, diagnostics)
            sema_casing_expr(tables, then_value, diagnostics)
            sema_casing_stmts(tables, else_body, diagnostics)
            sema_casing_expr(tables, else_value, diagnostics)
        }
        .PtrFromAddr(_, _, _, addr, _, _) -> { sema_casing_expr(tables, addr, diagnostics) }
        .Pipe(head, steps, _, _) -> {
            sema_casing_expr(tables, head, diagnostics)
            loop step in steps -> sema_casing_expr(tables, step.value, diagnostics)
        }
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Ident(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

// Every E0357 for one parsed source file: import aliases, declarations and
// every binding site reachable from their bodies.
sema_casing_program: fn(program: Program, diagnostics: ^[Diagnostic]) {
    loop declaration in program.imports {
        if declaration.alias != "" {
            sema_casing_snake(declaration.alias, declaration.alias_span, "module alias", diagnostics)
        }
        if declaration.kind == {
            .Module(name, span) -> { sema_casing_snake(name, span, "module", diagnostics) }
            .Unqualified(module_alias, module_alias_span, _, _, _) -> {
                sema_casing_snake(module_alias, module_alias_span, "module alias", diagnostics)
            }
            .File(_, _) -> {}
        }
    }
    loop item in program.items -> sema_casing_item(program.tables, item, diagnostics)
}
