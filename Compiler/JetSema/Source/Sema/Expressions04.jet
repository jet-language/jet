    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:1152
    pub fn infer_binary(self: &Self, op: BinOp, lhs: &Expr, rhs: &Expr, span: Span, replacement: &Expr?) -> Type? {
