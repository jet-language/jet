    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:2797
    fn unit_arithmetic_mismatch(self: &Self, op: BinOp, lt: Type, rt: Type, span: Span) {
        &self.diags.push(Diagnostic.error("E0127", "{operator_label(op)} is not available between `{lt.name()}` and `{rt.name()}`", "unit-family arithmetic only defines scalar scaling and physical dimension algebra; nominal units and affine points do not multiply or divide", "scale a linear unit or delta by a plain numeric scalar, or use a dimensioned linear/delta family for physical products", Val(span)))
