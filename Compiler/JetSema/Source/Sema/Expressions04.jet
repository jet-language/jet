    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:2814
    fn quantity_dimension(self, ty: Type) -> Dimension? {
        if ty.quantity_parts() == .Val((_, dimension)) -> return Val(dimension)
        if ty != .Named(name) -> return None
        if self.registry.unit_dimension(name) == .Val(dimension) -> return Val(dimension)
        if name.split_once('.') == .Val((module, leaf)) {
            modules :: self.modules ?? return None
            loop candidate in modules {
                if candidate.module_alias == module -> return candidate.registry.unit_dimension(leaf)
            }
            return None
        }
        // A local nominal shadows imported names; never borrow an unrelated dimension.
        if self.registry.contains(name) -> return None
        None
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:2840
    fn quantity_base_is_compatible(self, left: Type, right: Type) -> Bool {
        base :: fn(ty: Type) {
            if ty.quantity_parts() == .Val((carrier, _)) -> carrier
            else if self.quantity_dimension(ty) != None -> Type.Float
            else -> ty
        }
        base(left) == Type.Float && base(right) == Type.Float && left != Type.Named(TYPE_INSTANT) && right != Type.Named(TYPE_INSTANT)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:2862
    fn dimension_mismatch(self: &Self, op: BinOp, left: Dimension, right: Dimension, span: Span) {
