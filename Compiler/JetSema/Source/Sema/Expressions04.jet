                            .Lt | .Le | .Gt | .Ge -> {
                                (cmp, variant) :: if op == { .Lt -> (BinOp.Eq, "Less") .Le -> (BinOp.Ne, "Greater") .Gt -> (BinOp.Eq, "Greater") .Ge -> (BinOp.Ne, "Less") else -> panic("unreachable relational hook") }
                                Expr.Binary(cmp, ^call, Expr.EnumLit{type_name: TYPE_ORDERING, variant: variant, variant_span: None, args: [], leading_dot: false, span: span}, span)
