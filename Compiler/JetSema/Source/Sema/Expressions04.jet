        arithmetic :: if op == { .Add | .Sub | .Mul | .Div | .FloorDiv | .Mod | .Rem | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Pow -> true else -> false }
        if arithmetic {
            left_erased :: lt.erased_inline_ranges()
            if left_erased != lt {
                &self.widen_numeric_expr(&lhs, lt, left_erased)
                lt = left_erased
            }
            right_erased :: rt.erased_inline_ranges()
            if right_erased != rt {
                &self.widen_numeric_expr(&rhs, rt, right_erased)
                rt = right_erased
            }
        }
        if &self.infer_mixed_operator(op, &lhs, &rhs, lt, rt, span, &replacement) == .Val(mixed) -> return Val(mixed)
        // D-OPDEF1=A: derive dimensions before a same-type hook can erase them.
        dimensional_multiplicative :: (op == .Mul || op == .Div) && (self.quantity_dimension(lt) != None || self.quantity_dimension(rt) != None)
        unit_operator :: self.unit_fact_for_type(lt) != None || self.unit_fact_for_type(rt) != None
        if lt == rt && !dimensional_multiplicative && !unit_operator {
            if lt == .Named(type_name) {
                comparable_hook :: Self.comparable_equality_hook(type_name) && (self.type_implements_trait_for_name(type_name, TRAIT_COMPARABLE) || self.type_param_has_bound(lt, TRAIT_COMPARABLE)) && (self.type_implements_trait_for_name(type_name, TRAIT_EQUATABLE) || self.type_param_has_bound(lt, TRAIT_EQUATABLE))
                hook :: if op == {
                    .Add -> Val((TRAIT_ADD, "add", lt))
                    .Sub -> Val((TRAIT_SUB, "sub", lt))
                    .Mul -> Val((TRAIT_MUL, "mul", lt))
                    .Div -> Val((TRAIT_DIV, "div", lt))
                    .Eq | .Ne -> if comparable_hook -> Val((TRAIT_COMPARABLE, "compare", Type.Named(TYPE_ORDERING))) else -> Val((TRAIT_EQUATABLE, "equal", Type.Bool))
                    .Compare | .Lt | .Le | .Gt | .Ge -> Val((TRAIT_COMPARABLE, "compare", Type.Named(TYPE_ORDERING)))
                    else -> None
                }
                if hook == .Val((trait_name, method, initial_ret)) {
                    ret := initial_ret
                    (owner_type, _, owner_traits) :: self.capability_type_context(lt)
                    operator_rhs := Type?{None}
                    if owner_traits.operator_impl_for(owner_type, trait_name, owner_type) == .Val(implementation) {
                        ret = if implementation.result == owner_type -> lt else -> implementation.result
                        operator_rhs = Val(implementation.rhs)
                    } else if self.type_param_has_bound(lt, trait_name) -> operator_rhs = Val(rt)
                    if self.type_implements_trait_for_name(type_name, trait_name) || self.type_param_has_bound(lt, trait_name) {
                        if self.fn_name == method && self.lookup(KW_SELF).map(fn(info) { info.ty == lt }) == Val(true) {
                            &self.diags.push(Diagnostic.error("E0361", "`{method}` calls itself through {operator_label(op)}", "the operator symbol dispatches back to this same hook, so evaluation would recurse forever", "combine the value's fields or call a different named helper inside the hook", Val(span)))
                            return None
                        }
                        &self.record_method_reference(type_name, method, span)
                        &self.record_edge(effect_key(Val(Self.split_type_name(type_name).1), method), span)
                        left :: ^lhs
                        lhs = Expr.Absent(span)
                        right :: ^rhs
                        rhs = Expr.Absent(span)
                        receiver_type := Self.split_type_name(type_name).1
                        loop param in self.type_param_scope {
                            if param.name == type_name { receiver_type = trait_name; break }
                        }
                        call :: Expr.MethodCall{receiver: ^left, method: method, method_span: span, owner_type_args: [], type_args: [], args: [CallArg{convention: AccessConvention.Read, expr: ^right, span: span, flags: CallArgFlags.default(), label: None, spread: false}], recv_type: Val(receiver_type), resolved_ret: Val(ret), operator_rhs: operator_rhs, checked_widen: false}
                        replacement = Val(if op == {
