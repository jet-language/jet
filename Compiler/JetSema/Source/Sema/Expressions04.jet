        joins_numeric :: (if op == { .Add | .Sub | .Mul | .Div | .FloorDiv | .Pow | .Eq | .Ne | .Compare | .Lt | .Le | .Gt | .Ge -> true else -> false }) || ((if op == { .Mod | .Rem | .BitAnd | .BitOr | .BitXor -> true else -> false }) && lt.is_integer() && rt.is_integer())
        if joins_numeric && lt != rt {
