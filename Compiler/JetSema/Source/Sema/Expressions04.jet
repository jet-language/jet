        left_duration :: lt == Type.Named(DURATION_TYPE)
        right_duration :: rt == Type.Named(DURATION_TYPE)
        if ((left_duration && rt == .Int) || (right_duration && lt == .Int && op == .Mul)) && (op == .Mul || op == .Div) -> return Val(Type.Named(DURATION_TYPE))
        lunit :: self.unit_fact_for_type(lt)
        runit :: self.unit_fact_for_type(rt)
        ldim :: self.quantity_dimension(lt)
        rdim :: self.quantity_dimension(rt)
        any_dimensional :: ldim != None || rdim != None
