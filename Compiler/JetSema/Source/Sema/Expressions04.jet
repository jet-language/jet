    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:2645
    // D-CHAINCMP1: adjacent pairs use exactly the standalone relational rule.
    pub fn check_relational(self: &Self, op: BinOp, lt: Type, rt: Type, span: Span) -> Type? {
        if lt == rt && (lt == .Int || lt == .Float) -> Val(Type.Bool)
        else if lt == rt {
            (normalized, registry, trait_reg) :: self.capability_type_context(lt)
            if normalized == .Named(name) && registry.is_distinct(name) {
                if trait_reg.implements_trait(name, TRAIT_COMPARABLE) -> return Val(Type.Bool)
                &self.diags.push(e0905(name, TRAIT_COMPARABLE, span, false))
                return None
            }
            if self.types_comparable_type(lt) || self.type_param_has_bound(lt, TRAIT_COMPARABLE) -> Val(Type.Bool)
            else if lt == .String {
                &self.diags.push(Diagnostic.error("E0109", "text isn't ordered with {operator_label(op)}", "comparing text for order isn't supported yet", "compare with `==` or `!=`, or compare lengths/numbers instead", Val(span)))
                None
            } else { &self.op_mismatch(op, lt, rt, span); None }
        } else { &self.op_mismatch(op, lt, rt, span); None }
    }

