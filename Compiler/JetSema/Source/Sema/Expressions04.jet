// Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:2896
// RHS forms that need a surrounding expected type.
pub fn expr_wants_expected_type(expr: Expr) -> Bool {
    if expr == {
        .Paren(inner, _) | .Unary(UnOp.Neg, inner, _) -> expr_wants_expected_type(inner)
        .Float(_, _, _, _) -> true
        .StructLit(_, _, _, _, _, inferred, _) -> inferred
        .TypedLit(head, _, _) -> head == None
        .EnumLit(type_name, _, _, _, _, _) -> type_name.is_empty()
        .Absent(_) -> true
        else -> false
    }
}
