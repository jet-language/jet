                replacement = Val(self.unit_scalar_wrapped_binary(op, ^unit, lname, ^scalar, true, span))
                return Val(Type.Named(lname))
            }
            if (lunit, runit) == (.None, .Val((rname, rfact))) && Self.is_unit_scalar_type(lt) {
                if op != .Mul || !Self.is_scalable_unit_fact(rfact) { &self.op_mismatch(op, lt, rt, span); return None }
                scalar := ^lhs
                lhs = Expr.Absent(span)
