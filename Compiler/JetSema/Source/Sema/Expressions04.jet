                &self.diags.push(Diagnostic.error("E0110", "the right side of `{op.spell()}` must be {Type.Bool.show()}, but this is {right.show()}", "each side of a logic operator must be a yes/no comparison", "write the full comparison, e.g. `x == 2`", Val(rhs.span())))
