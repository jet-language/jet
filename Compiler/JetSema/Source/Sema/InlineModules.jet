// Inline code modules (`bank: module { ... }`). The Rust bootstrap gives every
// member one compiler-owned identity before any declaration is registered
// (`hoist_inline_module_member_types`, `mangle_inline_sibling_calls`, the
// `Item::CodeModule` registration arm, and the inline-module body jobs). This
// pass is that same step on one module program:
//
// 1. member types (struct, enum, trait, tag, impl) lift beside the module
//    under `module_type_name` (`bank.Account` -> `M4BankAccount`); the bare and
//    qualified spellings resolve inside the module, and the qualified spelling
//    resolves in its enclosing file, including members of `priv module`s;
// 2. a module's member functions, top-level or nested, lift under
//    `member_name` (`bank.open` -> `__jet_bank_dopen`, `bank.audit.log` ->
//    `__jet_bank_daudit_dlog`) with their sibling calls renamed, so
//    registration, body checking and lowering see ordinary functions;
// 3. `bank.f(...)` and `bank.audit.f(...)` calls and `use bank.[f]` imports
//    resolve to the member identity: an unknown member is E0608/E0611, a
//    private one E0609; a nested `priv module` is usable only inside the
//    module enclosing it, which names its children relatively (`audit.f()`);
// 4. a module's own `use` declarations
//    bind inside that module only, and its `pub use` re-exports a member as
//    `module.name`; a module named as a value is E0107, like Rust.
//
// A generic-module instance arrives here as an ordinary module expanded by
// `sema_generic_modules_expand`. Module constants are never registered by
// Rust, so they are dropped. A module that imports a foreign namespace, or a
// Core module under its own binding, keeps its functions in its body; one that
// binds Core members reads them through a file-level Core alias.
use {
    unicode: core.text
    jet_foundation.[
        AST_NODE_GENERATED,
        BindPattern,
        Binding,
        Call,
        CallArg,
        CodeModule,
        ContextField,
        ContractClause,
        Diagnostic,
        EnumDef,
        EnumLitArg,
        ErrorConvDef,
        Expr,
        ExprField,
        ExprPair,
        Field,
        ForKind,
        Func,
        ImplConstValue,
        ImplDef,
        ImportDecl,
        ImportKind,
        Item,
        LValue,
        Lambda,
        LambdaBody,
        LambdaParam,
        Marker,
        MarkerCallArg,
        Measure,
        MeasureRule,
        sema_casing_pascal_words,
        NamedSpan,
        NamedType,
        OrFallback,
        Param,
        Program,
        Span,
        Stmt,
        StrPart,
        StructDef,
        SwitchArm,
        SymbolKind,
        TraitConstDecl,
        TraitDef,
        TraitImplBlock,
        TraitMethodSig,
        TupleField,
        Type,
        TypeTupleField,
        TypedLitBody,
        Variant,
        VariantField,
        VariantPayload,
        measure_kind,
        measure_literal_value,
        ast_func,
        core_module_export,
        ast_program,
        ast_struct,
        type_name,
    ]
}

// A member reached through a `use` inside a module: an inline module member
// function, or (qualified) a member of a file module imported by this file.
SemaInlineTarget: struct {
    module_alias: String
    member: String
    qualified: Bool
}

SemaInlineModuleSurface: struct {
    // How the rewritten body spells the module: its full dotted path, or,
    // inside an enclosing module, its path relative to that module.
    name: String
    // The full dotted path its member identities are named under.
    path: String
    // A nested `priv module`: the path of the module it is private to.
    private_to: String?
    // Member function names reachable by this enclosing file.
    functions: [String:Bool]
    // `pub use` inside the module: re-exported local name -> its owner.
    reexports: [String:SemaInlineTarget]
}

SemaInlineFunctionBinding: struct {
    semantic_name: String
    module_alias: String
    source_name: String
    span: Span
    visibility: Int
}

// The existing binder's products, retained after body rewriting for checked
// metadata references. These contain names/spans only, never function ASTs.
SemaInlinePreparedBindings: struct {
    imports: [String:SemaInlineFunctionBinding]
    modules: [SemaInlineModuleSurface]
}

SemaInlineRewrite: struct {
    types: [String:Type]
    // Generic-module value parameters and constants -> their literal value.
    values: [String:Expr]
    // Sibling functions of the module whose body is being rewritten.
    sibling_module: String
    siblings: [String:Bool]
    // File-level inline modules reachable as `alias.f(...)`.
    modules: [SemaInlineModuleSurface]
    // `use g: bank.f`: local name -> member identity.
    imported: [String:SemaInlineFunctionBinding]
    // A module's own `use limits.[MAX]` over a file module alias.
    qualified: [String:SemaInlineTarget]
    locals: [String]
    // Trait-bounded variadic functions -> their fixed parameter count; each
    // call renames to its arity's function, whose arities are noted in order.
    variadic: [String:Int]
    variadic_arities: [String:[Int]]
    diagnostics: [Diagnostic]
}

SemaInlineHoist: struct {
    declarations: [Item]
    exported: [String:Type]
    has_exported: Bool
}

SemaInlineHoisted: struct {
    code_module: CodeModule
    // Every lifted type's full source path, in declaration order.
    paths: [String]
    types: [String:Type]
}

// ---------------------------------------------------------------------------
// Member naming (Rust `Syntax::generated_path`, `Names::member_name`,
// `GenericModules::module_type_name`).

sema_inline_is_alphanumeric: fn(code: Int) -> Bool Never! {
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
}

sema_inline_generated_path: fn(path: String) -> String Never! {
    hex: "0123456789abcdef"
    out := [U8]{}
    loop byte in path.bytes() {
        code: Int.from_u8(byte)
        if sema_inline_is_alphanumeric(code) {
            out.push(byte)
            next
        }
        out.push(U8{95})
        if {
            code == 95 -> out.push(U8{117})
            code == 46 -> out.push(U8{100})
            code == 58 -> out.push(U8{99})
            code == 47 -> out.push(U8{115})
            code == 92 -> out.push(U8{98})
            code == 45 -> out.push(U8{104})
            else -> {
                out.push(U8{120})
                out.push(hex.bytes()[code /% 16])
                out.push(hex.bytes()[code % 16])
            }
        }
    }
    "__jet_{String.from_bytes(out) ?? ""}"
}

sema_inline_hex_value: fn(code: Int) -> Int Never! {
    if {
        code >= 48 && code <= 57 -> code - 48
        code >= 97 && code <= 102 -> code - 87
        code >= 65 && code <= 70 -> code - 55
        else -> -1
    }
}

// Rust `decode_generated_path_suffix`.
sema_inline_decode_generated_suffix: fn(suffix: String) -> String? Never! {
    bytes: suffix.bytes()
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        code: Int.from_u8(bytes[index])
        if sema_inline_is_alphanumeric(code) {
            out.push(bytes[index])
            index += 1
            next
        }
        if code != 95 || index + 1 >= bytes.len() -> return None
        escape: Int.from_u8(bytes[index + 1])
        if {
            escape == 117 -> out.push(U8{95})
            escape == 100 -> out.push(U8{46})
            escape == 99 -> out.push(U8{58})
            escape == 115 -> out.push(U8{47})
            escape == 98 -> out.push(U8{92})
            escape == 104 -> out.push(U8{45})
            escape == 120 && index + 3 < bytes.len() -> {
                high: sema_inline_hex_value(Int.from_u8(bytes[index + 2]))
                low: sema_inline_hex_value(Int.from_u8(bytes[index + 3]))
                if high < 0 || low < 0 -> return None
                out.push(U8{high * 16 + low})
                index += 2
            }
            else -> return None
        }
        index += 2
    }
    Val(String.from_bytes(out) ?? return None)
}

sema_inline_member_name: fn(module_path: String, name: String) -> String Never! {
    stripped: if module_path.starts_with("__jet_") -> String.from_bytes(module_path.bytes()[6..<module_path.bytes().len()]) ?? module_path.copy() else -> module_path.copy()
    decoded: sema_inline_decode_generated_suffix(stripped) ?? stripped
    sema_inline_generated_path("{decoded}.{name}")
}

// The source name of a lifted member function (`__jet_bank_dopen` -> `open`),
// so its own body diagnostics name it as written. Only the member segment must
// be an identifier: a module path whose `_s` reads back as `/` (Rust
// `member_name` decodes an unprefixed module path too) still names its member.
// Any other name is returned unchanged.
sema_inline_member_source_name: fn(name: String) -> String Never! {
    if !name.starts_with("__jet_") -> return name.copy()
    decoded: sema_inline_decode_generated_suffix(String.from_bytes(name.bytes()[6..<name.bytes().len()]) ?? "") ?? return name.copy()
    if !decoded.contains(".") || sema_inline_generated_path(decoded) != name -> return name.copy()
    segments: decoded.split(".").to_list()
    member: segments[segments.len() - 1]
    if member == "" -> return name.copy()
    loop byte in member.bytes() {
        code: Int.from_u8(byte)
        if !sema_inline_is_alphanumeric(code) && code != 95 -> return name.copy()
    }
    member
}

sema_inline_trim_leading_underscores: fn(name: String) -> String Never! {
    bytes: name.bytes()
    start := 0
    loop start < bytes.len() && Int.from_u8(bytes[start]) == 95 {
        start += 1
    }
    String.from_bytes(bytes[start..<bytes.len()]) ?? name.copy()
}

sema_inline_type_prefix: fn(alias: String) -> String {
    visibility: if alias.starts_with("_") -> "_" else -> ""
    body: if alias.starts_with("_") -> String.from_bytes(alias.bytes()[1..<alias.bytes().len()]) ?? alias.copy() else -> alias.copy()
    encoded := ""
    loop segment in body.split("_") {
        cased: sema_casing_pascal_words(segment)
        encoded = "{encoded}{unicode.scalars(cased).len()}{cased}"
    }
    "{visibility}M{encoded}"
}

sema_inline_type_name: fn(alias: String, name: String) -> String {
    "{sema_inline_type_prefix(alias)}{sema_inline_trim_leading_underscores(name)}"
}

// Rust `inline_type_alias`.
sema_inline_type_alias: fn(source_path: String) -> String Never! {
    source_path.split(".").to_list().join("_")
}

sema_inline_mapped_name: fn(rewrite: SemaInlineRewrite, name: String) -> String Never! {
    if rewrite.types.get(name) == .Val(.Named(mapped)) -> return mapped
    name.copy()
}

sema_inline_mapped_names: fn(rewrite: SemaInlineRewrite, names: [NamedSpan]) -> [NamedSpan] Never! {
    mapped := [NamedSpan]{}
    loop entry in names -> mapped.push(NamedSpan{name: sema_inline_mapped_name(rewrite, entry.name), span: entry.span})
    mapped
}

// A program a `module` lowering leaves complete: nothing but nested modules
// that are themselves lowered, and marker declarations, which stay in the
// body as their home (MarkerModules resolves `#Alias.Module.Marker` there).
sema_inline_module_lowered: fn(definition: CodeModule) -> Bool Never! {
    body: definition.body ?? return false
    loop item in body {
        if item == .CodeModule(child) {
            if !sema_inline_module_lowered(child) -> return false
            next
        }
        if item == .MarkerDecl(_) -> next
        return false
    }
    true
}

// A module lowers unless it imports a foreign namespace, or a Core module under
// a binding the enclosing file does not make the same way: those bindings stay
// with the module body (Rust `inline_core_imports`). An inline body sees the
// file's imports overlaid with its own, so an inline Core import that repeats a
// file import's alias and module binds nothing new and the lifted members
// resolve it through the file's binding. A Core member the module binds itself
// (`use core.[math.abs]`, `pub use exported: core.math.abs`) lowers too: its
// members read it through the file-level Core alias sema_inline_core_imports adds.
sema_inline_module_lowerable: fn(definition: CodeModule, file_imports: [ImportDecl]) -> Bool Never! {
    if definition.body == None -> return false
    loop declaration in definition.imports {
        if declaration.kind == {
            .Unqualified(module_alias, _, items, _, _) -> {
                if module_alias == "core" || module_alias.starts_with("core.") {
                    loop item in items {
                        if sema_inline_core_member("{module_alias}.{item.original}") == None -> return false
                    }
                }
            }
            .Module(name, _) -> {
                if name != "core" && !name.starts_with("core.") -> return false
                if !sema_inline_file_binds_module(file_imports, declaration.alias, name) && sema_inline_core_member(name) == None -> return false
            }
            else -> return false
        }
    }
    true
}

// A Core member path (`core.math.abs`) as the qualified target lifted members
// read: the member on its Core module's file-level alias. A Core module itself
// (`core.math`) is no member.
sema_inline_core_member: fn(path: String) -> SemaInlineTarget? Never! {
    if !path.starts_with("core.") || core_module_export(path) != None -> return None
    segments: path.split(".").to_list()
    module_path := segments[0].copy()
    loop index in 1..<segments.len() - 1 -> module_path = "{module_path}.{segments[index]}"
    if core_module_export(module_path) == None -> return None
    Val(SemaInlineTarget{module_alias: sema_inline_core_alias(module_path), member: segments[segments.len() - 1].copy(), qualified: true})
}

// The file-level alias of a Core module that lowered members read.
sema_inline_core_alias: fn(module_path: String) -> String Never! {
    sema_inline_generated_path("use.{module_path}")
}

// Whether `declaration` is the file-level Core alias sema_inline_core_imports
// added for a lowered member import; registration binds it to its Core module.
sema_inline_core_alias_import: fn(declaration: ImportDecl) -> Bool Never! {
    if declaration.kind == .Module(name, _) -> return declaration.alias == sema_inline_core_alias(name)
    false
}

// The file-level Core imports the Core members bound inside the lowerable
// modules of `items` (nested ones included) read, one per Core module.
sema_inline_core_imports: fn(items: [Item], file_imports: [ImportDecl], imports: &[ImportDecl]) Never! {
    loop item in items {
        if item == .CodeModule(definition) {
            body: definition.body ?? next
            if !sema_inline_module_lowerable(definition, file_imports) -> next
            loop declaration in definition.imports {
                paths := [String]{}
                if declaration.kind == {
                    .Unqualified(module_alias, _, members, _, _) -> {
                        if module_alias == "core" || module_alias.starts_with("core.") {
                            loop member in members -> paths.push("{module_alias}.{member.original}")
                        }
                    }
                    .Module(name, _) -> {
                        if !sema_inline_file_binds_module(file_imports, declaration.alias, name) -> paths.push(name.copy())
                    }
                    else -> {}
                }
                loop path in paths {
                    target: sema_inline_core_member(path) ?? next
                    bound := false
                    loop existing in imports {
                        if existing.alias == target.module_alias -> bound = true
                    }
                    if bound -> next
                    module_path: String.from_bytes(path.bytes()[0..<path.bytes().len() - target.member.bytes().len() - 1]) ?? next
                    imports.push(ImportDecl{kind: ImportKind.Module{name: module_path, span: declaration.span}, alias: target.module_alias, alias_span: declaration.alias_span, span: declaration.span, item_spans: [Span]{}, local_spans: [Span]{}, is_pub: false, is_package_pub: false, inline_version: None})
                }
            }
            sema_inline_core_imports(body, file_imports, imports)
        }
    }
}

sema_inline_file_binds_module: fn(file_imports: [ImportDecl], alias: String, name: String) -> Bool Never! {
    loop declaration in file_imports {
        if declaration.alias != alias -> next
        if declaration.kind == .Module(bound, _) -> return bound == name
        return false
    }
    false
}

// ---------------------------------------------------------------------------
// Rewriting (Rust `substitute_expr` / `substitute_stmts`,
// `rewrite_inline_calls_expr` and the checker's inline-module call routes).

sema_inline_rewrite_empty: fn() -> SemaInlineRewrite Never! {
    SemaInlineRewrite{types: [String:Type]{}, values: [String:Expr]{}, sibling_module: "", siblings: [String:Bool]{}, modules: [SemaInlineModuleSurface]{}, imported: [String:SemaInlineFunctionBinding]{}, qualified: [String:SemaInlineTarget]{}, locals: [String]{}, variadic: [String:Int]{}, variadic_arities: [String:[Int]]{}, diagnostics: [Diagnostic]{}}
}

sema_inline_is_local: fn(rewrite: SemaInlineRewrite, name: String) -> Bool Never! {
    loop local in rewrite.locals {
        if local == name -> return true
    }
    false
}

// `alias.Type` as a value's base (`internal.Failure.Missing`) names the
// hoisted member type, as a type position spelling `alias.Type` does.
sema_inline_type_path: fn(rewrite: SemaInlineRewrite, base: Expr) -> Expr? Never! {
    if base == .Field(inner, member, span, node) && inner == .Ident(alias, _, _) {
        if sema_inline_is_local(rewrite, alias) -> return None
        if rewrite.types.get("{alias}.{member}") == .Val(.Named(name)) -> return Val(Expr.Ident{name: name, span: span, id: node})
    }
    None
}

sema_inline_surface: fn(rewrite: SemaInlineRewrite, name: String) -> SemaInlineModuleSurface? Never! {
    if sema_inline_is_local(rewrite, name) -> return None
    loop surface in rewrite.modules {
        if surface.name == name -> return Val(surface)
    }
    None
}

sema_inline_restore_locals: fn(rewrite: &SemaInlineRewrite, saved: Int) Never! {
    loop rewrite.locals.len() > saved {
        _ := rewrite.locals.pop()
    }
}

sema_inline_rewrite_type: fn(rewrite: SemaInlineRewrite, ty: Type) -> Type Never! {
    if ty == {
        .Named(name) -> {
            if rewrite.types.get(name) == .Val(mapped) -> return mapped
            if rewrite.qualified.get(name) == .Val(target) -> return Type.Named{name: "{target.module_alias}.{target.member}"}
            // copy: the rewrite walks the module program by borrowed payload views (Jet has no
            // consuming match), so an unchanged type is copied into the rebuilt program, while the
            // caller's program keeps the original until it is replaced.
            ty.copy()
        }
        .List(inner) -> Type.List{element: sema_inline_rewrite_type(rewrite, inner)}
        .Shared(inner) -> Type.Shared{inner: sema_inline_rewrite_type(rewrite, inner)}
        .Option(inner) -> Type.Option{inner: sema_inline_rewrite_type(rewrite, inner)}
        .FixedList(inner, len) -> Type.FixedList{elem: sema_inline_rewrite_type(rewrite, inner), len: sema_inline_rewrite_measure(rewrite, len)}
        // copy: `marker` is a payload of read parameter `ty`, which keeps the original; field `marker` of the new Type.Tagged owns this one
        .Tagged(marker, inner) -> Type.Tagged{marker: marker.copy(), inner: sema_inline_rewrite_type(rewrite, inner)}
        // copy: `key_span` is a payload of read parameter `ty`, which keeps the original; field `key_span` of the new Type.Map owns this one
        .Map(key, key_span, value) -> Type.Map{key: sema_inline_rewrite_type(rewrite, key), key_span: key_span.copy(), value: sema_inline_rewrite_type(rewrite, value)}
        .Result(ok, err) -> Type.Result{ok: sema_inline_rewrite_type(rewrite, ok), err: sema_inline_rewrite_type(rewrite, err)}
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            mapped := [Type]{}
            loop param in params -> mapped.push(sema_inline_rewrite_type(rewrite, param))
            Type.Fn{params: mapped, ret: ret.map((value) -> sema_inline_rewrite_type(rewrite, value)), effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
        }
        // A generic member's head renames like a plain member
        // (`Holder<Int>` -> `M5PlainHolder<Int>`).
        .Apply(name, args) -> {
            head := name
            if rewrite.types.get(name) == .Val(.Named(mapped)) {
                head = mapped
            } else if rewrite.qualified.get(name) == .Val(target) {
                head = "{target.module_alias}.{target.member}"
            }
            Type.Apply{name: head, args: sema_inline_rewrite_types(rewrite, args)}
        }
        .Tuple(fields) -> {
            mapped := [TypeTupleField]{}
            loop field in fields -> mapped.push(TypeTupleField{name: field.name, ty: sema_inline_rewrite_type(rewrite, field.ty)})
            Type.Tuple{fields: mapped}
        }
        .Union(members) -> Type.Union{members: sema_inline_rewrite_types(rewrite, members)}
        // copy: `dimension` is a payload of read parameter `ty`, which keeps the original; field `dimension` of the new Type.Quantity owns this one
        .Quantity(base, dimension) -> Type.Quantity{base: sema_inline_rewrite_type(rewrite, base), dimension: dimension.copy()}
        .InlineRange(base, lo, hi) -> Type.InlineRange{base: sema_inline_rewrite_type(rewrite, base), lo: lo, hi: hi}
        // copy: the rewrite walks the module program by borrowed payload views (Jet has no
        // consuming match), so an unchanged type kind is copied into the rebuilt program, while the
        // caller's program keeps the original.
        else -> ty.copy()
    }
}

// Rust `Measure::resolve_symbols`: a fixed length named by an `Int` module
// value parameter becomes that length.
sema_inline_rewrite_measure: fn(rewrite: SemaInlineRewrite, measure: Measure) -> Measure Never! {
    if measure == {
        .Symbol(kind, name) -> {
            if rewrite.values.get(name) == .Val(.Int(value, _, _, _, _)) {
                if value >= 0 -> return Measure.Literal{kind: kind, value: value}
            }
            // copy: the rewrite walks the module program by borrowed payload views (Jet has no
            // consuming match), so an unchanged measure is copied into the rebuilt program, while
            // the caller's program keeps the original.
            measure.copy()
        }
        .Combined(kind, rule, left, right) -> {
            resolved_left: sema_inline_rewrite_measure(rewrite, left)
            resolved_right: sema_inline_rewrite_measure(rewrite, right)
            if rule != MeasureRule.Match {
                if measure_literal_value(resolved_left) == .Val(left_value) {
                    if measure_literal_value(resolved_right) == .Val(right_value) {
                        folded: if rule == MeasureRule.Add -> left_value + right_value else -> left_value * right_value
                        return Measure.Literal{kind: measure_kind(resolved_left), value: folded}
                    }
                }
            }
            Measure.Combined{kind: kind, rule: rule, left: resolved_left, right: resolved_right}
        }
        // copy: the rewrite walks the module program by borrowed payload views (Jet has no
        // consuming match), so an unchanged measure kind is copied into the rebuilt program, while
        // the caller's program keeps the original.
        else -> measure.copy()
    }
}

// A substituted compile-time value takes the span of the name it replaces
// (Rust `ct_value_expr`).
sema_inline_value_at: fn(value: Expr, span: Span) -> Expr Never! {
    if value == {
        .Int(number, _, _, _, node) -> Expr.Int{value: number, span: span, width: None, raw: None, id: node}
        .Bool(flag, _, node) -> Expr.Bool{value: flag, span: span, id: node}
        .Char(text, _, node) -> Expr.Char{value: text, span: span, id: node}
        .Str(parts, _, node) -> Expr.Str{parts: parts, span: span, id: node}
        .Ident(name, _, node) -> Expr.Ident{name: name, span: span, id: node}
        .Field(base, member, _, node) -> Expr.Field{base: sema_inline_value_at(base, span), member: member, span: span, id: node}
        .EnumLit(type_name, variant, _, args, leading_dot, _, node) -> Expr.EnumLit{type_name: type_name, variant: variant, variant_span: None, args: args, leading_dot: leading_dot, span: span, id: node}
        // copy: the re-spanned value is a new owned Expr. Other kinds keep `value`, a module
        // constant's expression that the constant table keeps for every other use site.
        else -> value.copy()
    }
}

// `limits.f(...)`: a call through a module's own `use limits.[f]`.
sema_inline_qualified_call: fn(rewrite: &SemaInlineRewrite, target: SemaInlineTarget, span: Span, type_args: [Type], args: [CallArg]) -> Expr Never! {
    Expr.MethodCall{receiver: Expr.Ident{name: target.module_alias, span: span, id: AST_NODE_GENERATED}, method: target.member, method_span: span, owner_type_args: [Type]{}, type_args: sema_inline_rewrite_types(rewrite, type_args), args: sema_inline_rewrite_call_args(rewrite, args), id: AST_NODE_GENERATED}
}

sema_inline_rewrite_types: fn(rewrite: SemaInlineRewrite, types: [Type]) -> [Type] Never! {
    mapped := [Type]{}
    loop ty in types -> mapped.push(sema_inline_rewrite_type(rewrite, ty))
    mapped
}

sema_inline_rewrite_optional_type: fn(rewrite: SemaInlineRewrite, ty: Type?) -> Type? Never! {
    if ty == {
        .Val(value) -> Val(sema_inline_rewrite_type(rewrite, value))
        .None -> None
    }
}

sema_inline_rewrite_exprs: fn(rewrite: &SemaInlineRewrite, expressions: [Expr]) -> [Expr] Never! {
    mapped := [Expr]{}
    loop expression in expressions -> mapped.push(sema_inline_rewrite_expr(rewrite, expression))
    mapped
}

sema_inline_rewrite_optional_expr: fn(rewrite: &SemaInlineRewrite, expression: Expr?) -> Expr? Never! {
    if expression == {
        .Val(value) -> Val(sema_inline_rewrite_expr(rewrite, value))
        .None -> None
    }
}

sema_inline_rewrite_call_args: fn(rewrite: &SemaInlineRewrite, args: [CallArg]) -> [CallArg] Never! {
    mapped := [CallArg]{}
    loop arg in args {
        updated := arg
        updated.expr = sema_inline_rewrite_expr(rewrite, arg.expr)
        mapped.push(updated)
    }
    mapped
}

sema_inline_rewrite_fields: fn(rewrite: &SemaInlineRewrite, fields: [ExprField]) -> [ExprField] Never! {
    mapped := [ExprField]{}
    loop field in fields -> mapped.push(ExprField{name: field.name, name_span: field.name_span, value: sema_inline_rewrite_expr(rewrite, field.value)})
    mapped
}

sema_inline_rewrite_pairs: fn(rewrite: &SemaInlineRewrite, entries: [ExprPair]) -> [ExprPair] Never! {
    mapped := [ExprPair]{}
    loop entry in entries -> mapped.push(ExprPair{key: sema_inline_rewrite_expr(rewrite, entry.key), value: sema_inline_rewrite_expr(rewrite, entry.value)})
    mapped
}

sema_inline_rewrite_str_parts: fn(rewrite: &SemaInlineRewrite, parts: [StrPart]) -> [StrPart] Never! {
    mapped := [StrPart]{}
    loop part in parts {
        if part == {
            .Interp(expression, format) -> mapped.push(StrPart.Interp{expr: sema_inline_rewrite_expr(rewrite, expression), format: format})
            else -> mapped.push(part.copy())
        }
    }
    mapped
}

sema_inline_rewrite_or_fallback: fn(rewrite: &SemaInlineRewrite, fallback: OrFallback) -> OrFallback Never! {
    if fallback == {
        .Value(value) -> OrFallback.Value{value: sema_inline_rewrite_expr(rewrite, value)}
        .Block(body, value, span) -> {
            saved: rewrite.locals.len()
            mapped_body: sema_inline_rewrite_stmts(rewrite, body)
            mapped_value: sema_inline_rewrite_optional_expr(rewrite, value)
            sema_inline_restore_locals(rewrite, saved)
            OrFallback.Block{body: mapped_body, value: mapped_value, span: span}
        }
        .Return(value, span) -> OrFallback.Return{value: sema_inline_rewrite_optional_expr(rewrite, value), span: span}
        .Panic(name_span, args) -> OrFallback.Panic{name_span: name_span, args: sema_inline_rewrite_call_args(rewrite, args)}
        // copy: the rewrite walks the module program by borrowed payload views (Jet has no
        // consuming match), so an unchanged fallback is copied into the rebuilt program, while the
        // caller's program keeps the original.
        else -> fallback.copy()
    }
}

sema_inline_rewrite_lambda: fn(rewrite: &SemaInlineRewrite, lambda: Lambda) -> Lambda Never! {
    updated := lambda
    saved: rewrite.locals.len()
    params := [LambdaParam]{}
    loop param in lambda.params {
        mapped := param
        mapped.ty = sema_inline_rewrite_optional_type(rewrite, param.ty)
        params.push(mapped)
        rewrite.locals.push(param.name)
    }
    updated.params = params
    updated.body = if lambda.body == {
        .Expr(value) -> LambdaBody.Expr{value: sema_inline_rewrite_expr(rewrite, value)}
        .Block(body) -> LambdaBody.Block{body: sema_inline_rewrite_stmts(rewrite, body)}
    }
    sema_inline_restore_locals(rewrite, saved)
    updated
}

sema_inline_rewrite_typed_body: fn(rewrite: &SemaInlineRewrite, body: TypedLitBody) -> TypedLitBody Never! {
    if body == {
        .Fields(fields) -> return TypedLitBody.Fields{fields: sema_inline_rewrite_fields(rewrite, fields)}
        .Elements(elements) -> return TypedLitBody.Elements{elements: sema_inline_rewrite_exprs(rewrite, elements)}
        .Entries(entries) -> return TypedLitBody.Entries{entries: sema_inline_rewrite_pairs(rewrite, entries)}
        .Value(value) -> return TypedLitBody.Value{value: sema_inline_rewrite_expr(rewrite, value)}
        else -> {}
    }
    // copy: the rewrite walks the module program by borrowed payload views (Jet has no consuming
    // match), so an unchanged typed body is copied into the rebuilt program, while the caller's
    // program keeps the original.
    body.copy()
}

sema_inline_rewrite_enum_args: fn(rewrite: &SemaInlineRewrite, args: [EnumLitArg]) -> [EnumLitArg] Never! {
    mapped := [EnumLitArg]{}
    loop arg in args {
        if arg == {
            .Positional(value) -> mapped.push(EnumLitArg.Positional{value: sema_inline_rewrite_expr(rewrite, value)})
            .Named(label, value) -> mapped.push(EnumLitArg.Named{label: label, expr: sema_inline_rewrite_expr(rewrite, value)})
        }
    }
    mapped
}

// `bank.f(...)` from anywhere in the file (Rust `infer_code_module_call`):
// a `pub use` re-export calls its owner, a member function its member
// identity; any other name is E0608. The file is the enclosing module, so it
// reaches the members of its `priv module`s too.
sema_inline_rewrite_module_call: fn(rewrite: &SemaInlineRewrite, surface: SemaInlineModuleSurface, alias_span: Span, method: String, method_span: Span, type_args: [Type], args: [CallArg]) -> Expr? Never! {
    if surface.reexports.get(method) == .Val(target) {
        if target.qualified -> return Val(sema_inline_qualified_call(rewrite, target, method_span, type_args, args))
        forwarded: Call{name: sema_inline_member_name(target.module_alias, target.member), name_span: method_span, type_args: sema_inline_rewrite_types(rewrite, type_args), args: sema_inline_rewrite_call_args(rewrite, args)}
        return Val(Expr.Call{call: forwarded, id: AST_NODE_GENERATED})
    }
    if surface.functions.get(method) == None {
        rewrite.diagnostics.push(sema_error("E0608", alias_span, "`{method}` is not defined in module `{surface.path}`", "check the module body for the function you're calling", "make sure the function name is spelled correctly"))
        return None
    }
    call: Call{name: sema_inline_member_name(surface.path, method), name_span: method_span, type_args: sema_inline_rewrite_types(rewrite, type_args), args: sema_inline_rewrite_call_args(rewrite, args)}
    Val(Expr.Call{call: call, id: AST_NODE_GENERATED})
}

// `a.b.c` as a call receiver: each identifier segment with its span, false
// for any other receiver.
sema_inline_receiver_path: fn(receiver: Expr, segments: &[NamedSpan]) -> Bool Never! {
    if receiver == {
        .Ident(name, span, _) -> {
            segments.push(NamedSpan{name: name, span: span})
            return true
        }
        .Field(base, member, span, _) -> {
            if !sema_inline_receiver_path(base, segments) -> return false
            segments.push(NamedSpan{name: member, span: span})
            return true
        }
        else -> return false
    }
}

// A nested `priv module` on the path `segments` names is usable only inside
// the module that encloses it: the body being rewritten (`sibling_module`,
// "" for the file) must be that module or one nested in it (E0609).
sema_inline_private_step: fn(rewrite: SemaInlineRewrite, segments: [NamedSpan]) -> Diagnostic? Never! {
    prefix := segments[0].name.copy()
    loop index in 1..<segments.len() {
        prefix = "{prefix}.{segments[index].name}"
        surface: sema_inline_surface(rewrite, prefix) ?? return None
        owner: surface.private_to ?? next
        if rewrite.sibling_module == owner || rewrite.sibling_module.starts_with("{owner}.") -> next
        return Val(sema_error("E0609", segments[index].span, "`{segments[index].name}` is private in module `{owner}`", "a `priv module` is usable only by its enclosing module", "call it from inside `{owner}`, or remove `priv` from `{segments[index].name}: module`"))
    }
    None
}

sema_inline_rewrite_expr: fn(rewrite: &SemaInlineRewrite, expression: Expr) -> Expr Never! {
    if expression == {
        .Str(parts, span, node) -> return Expr.Str{parts: sema_inline_rewrite_str_parts(rewrite, parts), span: span, id: node}
        .ListLit(elements, span, node) -> return Expr.ListLit{elements: sema_inline_rewrite_exprs(rewrite, elements), span: span, id: node}
        .MemberSpread(base, members, span, node) -> return Expr.MemberSpread{base: sema_inline_rewrite_expr(rewrite, base), members: members, span: span, id: node}
        .Spread(value, span, node) -> return Expr.Spread{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        .MapLit(entries, span, node) -> return Expr.MapLit{entries: sema_inline_rewrite_pairs(rewrite, entries), span: span, id: node}
        // copy: `kind` is a payload of read parameter `expression`, which keeps the original; field `kind` of the new Expr.Index owns this one
        .Index(base, index, span, kind, node) -> return Expr.Index{base: sema_inline_rewrite_expr(rewrite, base), index: sema_inline_rewrite_expr(rewrite, index), span: span, kind: kind.copy(), id: node}
        .Slice(base, start, end, range, span, node) -> return Expr.Slice{base: sema_inline_rewrite_expr(rewrite, base), start: sema_inline_rewrite_expr(rewrite, start), end: sema_inline_rewrite_expr(rewrite, end), range: sema_inline_rewrite_optional_expr(rewrite, range), span: span, id: node}
        .Range(start, end, exclusive, span, node) -> return Expr.Range{start: sema_inline_rewrite_expr(rewrite, start), end: sema_inline_rewrite_expr(rewrite, end), exclusive: exclusive, span: span, id: node}
        .Ident(name, span, node) -> {
            if !sema_inline_is_local(rewrite, name) && rewrite.values.get(name) == .Val(value) -> return sema_inline_value_at(value, span)
            // Rust `rewrite_inline_calls_expr`: a sibling named as a value
            // becomes the module name, which name lookup then rejects. A
            // local or parameter of the same name shadows the sibling.
            if !sema_inline_is_local(rewrite, name) && rewrite.siblings.get(name) != None -> return Expr.Ident{name: rewrite.sibling_module, span: span, id: node}
            if !sema_inline_is_local(rewrite, name) {
                if rewrite.qualified.get(name) == .Val(target) -> return Expr.Field{base: Expr.Ident{name: target.module_alias, span: span, id: node}, member: target.member, span: span, id: AST_NODE_GENERATED}
                // A module is no value: Rust's name lookup has no `bank`.
                if sema_inline_surface(rewrite, name) != None -> rewrite.diagnostics.push(sema_unknown_name(name, span))
            }
            // copy: the rewrite walks the module program by borrowed payload views (Jet has no
            // consuming match), so an expression the rewrite leaves alone is copied into the
            // rebuilt program, while the caller's program keeps the original.
            return expression.copy()
        }
        .ComptimeName(name, span, _, _) -> {
            if rewrite.values.get(name) == .Val(value) -> return sema_inline_value_at(value, span)
            // copy: the rewrite walks the module program by borrowed payload views (Jet has no
            // consuming match), so an expression the rewrite leaves alone is copied into the
            // rebuilt program, while the caller's program keeps the original.
            return expression.copy()
        }
        .Call(call, node) -> {
            if !sema_inline_is_local(rewrite, call.name) && rewrite.siblings.get(call.name) == None {
                if rewrite.qualified.get(call.name) == .Val(target) -> return sema_inline_qualified_call(rewrite, target, call.name_span, call.type_args, call.args)
            }
            updated := call
            if {
                rewrite.siblings.get(call.name) != None -> updated.name = sema_inline_member_name(rewrite.sibling_module, call.name)
                !sema_inline_is_local(rewrite, call.name) && rewrite.imported.get(call.name) != None -> updated.name = (rewrite.imported.get(call.name) ?? panic("a bound inline import lost its row")).semantic_name
                else -> {}
            }
            if !sema_inline_is_local(rewrite, call.name) {
                if rewrite.variadic.get(call.name) == .Val(fixed) {
                    if call.args.len() >= fixed -> updated.name = sema_inline_note_variadic_arity(rewrite, call.name, call.args.len() - fixed)
                }
            }
            updated.type_args = sema_inline_rewrite_types(rewrite, call.type_args)
            updated.args = sema_inline_rewrite_call_args(rewrite, call.args)
            return Expr.Call{call: updated, id: node}
        }
        .Unary(op, operand, span, node) -> return Expr.Unary{op: op, operand: sema_inline_rewrite_expr(rewrite, operand), span: span, id: node}
        .Binary(op, left, right, span, node) -> return Expr.Binary{op: op, left: sema_inline_rewrite_expr(rewrite, left), right: sema_inline_rewrite_expr(rewrite, right), span: span, id: node}
        .CompareChain(operands, ops, hooks, span, node) -> return Expr.CompareChain{operands: sema_inline_rewrite_exprs(rewrite, operands), ops: ops, hooks: hooks, span: span, id: node}
        .Deref(value, span, node) -> return Expr.Deref{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        .RawOf(value, span, node) -> return Expr.RawOf{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        .Copy(value, span, node) -> return Expr.Copy{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        .Place(value, access, span, node) -> return Expr.Place{value: sema_inline_rewrite_expr(rewrite, value), access: access, span: span, id: node}
        .Field(base, member, span, node) -> {
            if sema_inline_type_path(rewrite, base) == .Val(type_name) -> return Expr.Field{base: type_name, member: member, span: span, id: node}
            return Expr.Field{base: sema_inline_rewrite_expr(rewrite, base), member: member, span: span, id: node}
        }
        .OptField(base, member, member_span, flatten, span, node) -> return Expr.OptField{base: sema_inline_rewrite_expr(rewrite, base), member: member, member_span: member_span, flatten: flatten, span: span, id: node}
        .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, node) -> {
            if receiver == .Ident(alias, alias_span, _) {
                if sema_inline_surface(rewrite, alias) == .Val(surface) {
                    rewritten: sema_inline_rewrite_module_call(rewrite, surface, alias_span, method, method_span, type_args, args)
                    if rewritten == .Val(value) -> return value
                    return Expr.MethodCall{receiver: receiver, method: method, method_span: method_span, owner_type_args: owner_type_args, type_args: type_args, args: sema_inline_rewrite_call_args(rewrite, args), id: node}
                }
            }
            // `math.inner.f(...)`: a member of a nested inline module. A
            // private step is reported here and the call still resolves, so
            // the file pass that rewrites the lifted body again stays quiet.
            if receiver == .Field(_, _, _, _) {
                segments := [NamedSpan]{}
                if sema_inline_receiver_path(receiver, segments) && !sema_inline_is_local(rewrite, segments[0].name) {
                    path: (loop segment in segments -> segment.name).join(".")
                    if sema_inline_surface(rewrite, path) == .Val(surface) {
                        if sema_inline_private_step(rewrite, segments) == .Val(diagnostic) -> rewrite.diagnostics.push(diagnostic)
                        rewritten: sema_inline_rewrite_module_call(rewrite, surface, segments[segments.len() - 1].span, method, method_span, type_args, args)
                        if rewritten == .Val(value) -> return value
                        return Expr.MethodCall{receiver: receiver, method: method, method_span: method_span, owner_type_args: owner_type_args, type_args: type_args, args: sema_inline_rewrite_call_args(rewrite, args), id: node}
                    }
                }
            }
            mapped_receiver := receiver
            if receiver == {
                .Ident(name, span, _) -> {
                    if rewrite.types.get(name) == .Val(.Named(resolved)) -> mapped_receiver = Expr.Ident{name: resolved, span: span, id: AST_NODE_GENERATED}
                }
                // `tokens.Token.from_int(7)`: a member type named through its module.
                .Field(base, member, span, _) -> {
                    if base == .Ident(alias, _, _) {
                        if !sema_inline_is_local(rewrite, alias) && rewrite.types.get("{alias}.{member}") == .Val(.Named(resolved)) -> mapped_receiver = Expr.Ident{name: resolved, span: span, id: AST_NODE_GENERATED}
                    }
                }
                else -> {}
            }
            return Expr.MethodCall{receiver: sema_inline_rewrite_expr(rewrite, mapped_receiver), method: method, method_span: method_span, owner_type_args: sema_inline_rewrite_types(rewrite, owner_type_args), type_args: sema_inline_rewrite_types(rewrite, type_args), args: sema_inline_rewrite_call_args(rewrite, args), id: node}
        }
        .OptMethodCall(receiver, method, method_span, type_args, args, span, node) -> return Expr.OptMethodCall{receiver: sema_inline_rewrite_expr(rewrite, receiver), method: method, method_span: method_span, type_args: sema_inline_rewrite_types(rewrite, type_args), args: sema_inline_rewrite_call_args(rewrite, args), span: span, id: node}
        .StructLit(type_name, type_args, import_ns, as_trait, fields, inferred, span, node) -> {
            mapped_name := type_name
            mapped_ns := import_ns
            resolved := Type?{None}
            if import_ns == .Val(namespace) -> resolved = rewrite.types.get("{namespace}.{type_name}")
            if resolved == None -> resolved = rewrite.types.get(type_name)
            if resolved == .Val(.Named(name)) {
                mapped_name = name
                mapped_ns = String?{None}
            } else if import_ns == None && !sema_inline_is_local(rewrite, type_name) {
                if rewrite.qualified.get(type_name) == .Val(target) {
                    mapped_name = target.member
                    mapped_ns = Val(target.module_alias)
                }
            }
            return Expr.StructLit{type_name: mapped_name, type_args: sema_inline_rewrite_types(rewrite, type_args), import_ns: mapped_ns, as_trait: as_trait, fields: sema_inline_rewrite_fields(rewrite, fields), inferred: inferred, span: span, id: node}
        }
        .TypedLit(head, body, span, node) -> return Expr.TypedLit{head: sema_inline_rewrite_optional_type(rewrite, head), body: sema_inline_rewrite_typed_body(rewrite, body), span: span, id: node}
        // copy: `variant_span` is a payload of read parameter `expression`, which keeps the original; field `variant_span` of the new Expr.EnumLit owns this one
        .EnumLit(type_name, variant, variant_span, args, leading_dot, span, node) -> return Expr.EnumLit{type_name: sema_inline_mapped_name(rewrite, type_name), variant: variant, variant_span: variant_span.copy(), args: sema_inline_rewrite_enum_args(rewrite, args), leading_dot: leading_dot, span: span, id: node}
        // copy: `tainted_tag` is a payload of read parameter `expression`, which keeps the original; field `tag` of the new Expr.Tainted owns this one
        .Tainted(value, tainted_tag, span, node) -> return Expr.Tainted{value: sema_inline_rewrite_expr(rewrite, value), tag: tainted_tag.copy(), span: span, id: node}
        .Present(value, span, node) -> return Expr.Present{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        // copy: `pattern` is a payload of read parameter `expression`, which keeps the original; field `pattern` of the new Expr.PatternTest owns this one
        .PatternTest(subject, pattern, span, node) -> return Expr.PatternTest{subject: sema_inline_rewrite_expr(rewrite, subject), pattern: pattern.copy(), span: span, id: node}
        .Ok(value, span, node) -> return Expr.Ok{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        .Err(value, span, node) -> return Expr.Err{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        // copy: `conversion` is a payload of read parameter `expression`, which keeps the original; field `conversion` of the new Expr.Try owns this one
        .Try(value, span, conversion, context, node) -> return Expr.Try{value: sema_inline_rewrite_expr(rewrite, value), span: span, conversion: conversion.copy(), context: sema_inline_rewrite_optional_expr(rewrite, context), id: node}
        .OrFallback(value, fallback, is_option, span, node) -> return Expr.OrFallback{value: sema_inline_rewrite_expr(rewrite, value), fallback: sema_inline_rewrite_or_fallback(rewrite, fallback), is_option: is_option, span: span, id: node}
        .If(cond, then_body, then_value, else_body, else_value, span, node) -> {
            mapped_cond: sema_inline_rewrite_expr(rewrite, cond)
            saved: rewrite.locals.len()
            mapped_then_body: sema_inline_rewrite_stmts(rewrite, then_body)
            mapped_then_value: sema_inline_rewrite_expr(rewrite, then_value)
            sema_inline_restore_locals(rewrite, saved)
            mapped_else_body: sema_inline_rewrite_stmts(rewrite, else_body)
            mapped_else_value: sema_inline_rewrite_expr(rewrite, else_value)
            sema_inline_restore_locals(rewrite, saved)
            return Expr.If{cond: mapped_cond, then_body: mapped_then_body, then_value: mapped_then_value, else_body: mapped_else_body, else_value: mapped_else_value, span: span, id: node}
        }
        .TupleLit(fields, span, ty, node) -> {
            mapped := [TupleField]{}
            loop field in fields -> mapped.push(TupleField{name: field.name, value: sema_inline_rewrite_expr(rewrite, field.value)})
            return Expr.TupleLit{fields: mapped, span: span, ty: sema_inline_rewrite_optional_type(rewrite, ty), id: node}
        }
        .Lambda(lambda, node) -> return Expr.Lambda{lambda: sema_inline_rewrite_lambda(rewrite, lambda), id: node}
        .CallValue(callee, args, span, node) -> return Expr.CallValue{callee: sema_inline_rewrite_expr(rewrite, callee), args: sema_inline_rewrite_call_args(rewrite, args), span: span, id: node}
        .PtrFromAddr(alias, alias_span, elem, addr, span, node) -> return Expr.PtrFromAddr{alias: alias, alias_span: alias_span, elem: sema_inline_rewrite_type(rewrite, elem), addr: sema_inline_rewrite_expr(rewrite, addr), span: span, id: node}
        .Paren(value, span, node) -> return Expr.Paren{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        else -> {}
    }
    // copy: the rewrite walks the module program by borrowed payload views (Jet has no consuming
    // match), so an unchanged expression kind is copied into the rebuilt program, while the
    // caller's program keeps the original.
    expression.copy()
}

sema_inline_declare_binding: fn(rewrite: &SemaInlineRewrite, binding: Binding) Never! {
    rewrite.locals.push(binding.name)
    if binding.pattern == .Val(pattern) {
        names: if pattern == {
            .Struct(_, _, fields, _, _) -> fields
            .List(elements, _) -> elements
            .Tuple(elements, _) -> elements
            .Refutable(_, _, bound, _) -> bound
        }
        loop field in names {
            if field.rename == {
                .Val(rename) -> rewrite.locals.push(rename.name)
                else -> rewrite.locals.push(field.name)
            }
        }
    }
}

sema_inline_rewrite_binding: fn(rewrite: &SemaInlineRewrite, binding: Binding) -> Binding Never! {
    updated := binding
    updated.ty = sema_inline_rewrite_optional_type(rewrite, binding.ty)
    updated.init = sema_inline_rewrite_expr(rewrite, binding.init)
    if binding.pattern == .Val(pattern) {
        updated.pattern = Val(if pattern == {
            .Struct(type_name, type_span, fields, rest, span) -> BindPattern.Struct{type_name: sema_inline_mapped_name(rewrite, type_name), type_span: type_span, fields: fields, rest: rest, span: span}
            .Refutable(inner, fallback, names, span) -> BindPattern.Refutable{pattern: inner, fallback: sema_inline_rewrite_or_fallback(rewrite, fallback), names: names, span: span}
            // copy: the binding pattern is a payload view of the borrowed binding (Jet has no
            // consuming match), so it is copied into the rebuilt program, while the caller's
            // program keeps the original.
            else -> pattern.copy()
        })
    }
    updated
}

sema_inline_rewrite_arms: fn(rewrite: &SemaInlineRewrite, arms: [SwitchArm]) -> [SwitchArm] Never! {
    mapped := [SwitchArm]{}
    loop arm in arms {
        saved: rewrite.locals.len()
        cond: sema_inline_rewrite_expr(rewrite, arm.cond)
        body: sema_inline_rewrite_stmts(rewrite, arm.body)
        sema_inline_restore_locals(rewrite, saved)
        mapped.push(SwitchArm{cond: cond, body: body, span: arm.span})
    }
    mapped
}

sema_inline_rewrite_optional_body: fn(rewrite: &SemaInlineRewrite, body: [Stmt]?) -> [Stmt]? Never! {
    if body == {
        .Val(value) -> Val(sema_inline_rewrite_stmts(rewrite, value))
        .None -> None
    }
}

sema_inline_rewrite_lvalue: fn(rewrite: &SemaInlineRewrite, target: LValue) -> LValue Never! {
    if target == {
        // copy: `kind` is a payload of read parameter `target`, which keeps the original; field `kind` of the new LValue.Index owns this one
        .Index(base, index, span, kind) -> LValue.Index{base: sema_inline_rewrite_expr(rewrite, base), index: sema_inline_rewrite_expr(rewrite, index), span: span, kind: kind.copy()}
        .Field(base, field, span) -> LValue.Field{base: sema_inline_rewrite_expr(rewrite, base), field: field, span: span}
        // copy: the rewrite walks the module program by borrowed payload views (Jet has no
        // consuming match), so an unchanged assignment target is copied into the rebuilt program,
        // while the caller's program keeps the original.
        else -> target.copy()
    }
}

// A block's bindings shadow module names for the rest of that block only.
sema_inline_rewrite_stmts: fn(rewrite: &SemaInlineRewrite, stmts: [Stmt]) -> [Stmt] Never! {
    saved: rewrite.locals.len()
    mapped := [Stmt]{}
    loop stmt in stmts -> mapped.push(sema_inline_rewrite_stmt(rewrite, stmt))
    sema_inline_restore_locals(rewrite, saved)
    mapped
}

sema_inline_rewrite_stmt: fn(rewrite: &SemaInlineRewrite, stmt: Stmt) -> Stmt Never! {
    if stmt == {
        .Expr(value) -> Stmt.Expr{expr: sema_inline_rewrite_expr(rewrite, value)}
        .Val(binding) -> {
            mapped: sema_inline_rewrite_binding(rewrite, binding)
            sema_inline_declare_binding(rewrite, binding)
            Stmt.Val{binding: mapped}
        }
        // copy: `op` is a payload of read parameter `stmt`, which keeps the original; field `op` of the new Stmt.Assign owns this one
        .Assign(target, op, op_span, value) -> Stmt.Assign{target: sema_inline_rewrite_lvalue(rewrite, target), op: op.copy(), op_span: op_span, value: sema_inline_rewrite_expr(rewrite, value)}
        .Return(value, span) -> Stmt.Return{value: sema_inline_rewrite_optional_expr(rewrite, value), span: span}
        // copy: `label` is a payload of read parameter `stmt`, which keeps the original; field `label` of the new Stmt.While owns this one
        .While(cond, body, span, arrow_body, label) -> Stmt.While{cond: sema_inline_rewrite_expr(rewrite, cond), body: sema_inline_rewrite_stmts(rewrite, body), span: span, arrow_body: arrow_body, label: label.copy()}
        .For(var, var_span, var2, kind, body, span, arrow_body, label, auto_vectorization) -> {
            mapped_kind: if kind == {
                .Range(start, end, step, exclusive) -> ForKind.Range{start: sema_inline_rewrite_expr(rewrite, start), end: sema_inline_rewrite_expr(rewrite, end), step: sema_inline_rewrite_optional_expr(rewrite, step), exclusive: exclusive}
                .In(collection, step) -> ForKind.In{collection: sema_inline_rewrite_expr(rewrite, collection), step: sema_inline_rewrite_optional_expr(rewrite, step)}
            }
            saved: rewrite.locals.len()
            rewrite.locals.push(var.copy())
            if var2 == .Val(second) -> rewrite.locals.push(second.name)
            mapped_body: sema_inline_rewrite_stmts(rewrite, body)
            sema_inline_restore_locals(rewrite, saved)
            Stmt.For{var: var, var_span: var_span, var2: var2, kind: mapped_kind, body: mapped_body, span: span, arrow_body: arrow_body, label: label, auto_vectorization: auto_vectorization}
        }
        .Switch(subject, arms, else_body, span) -> Stmt.Switch{subject: sema_inline_rewrite_expr(rewrite, subject), arms: sema_inline_rewrite_arms(rewrite, arms), else_body: sema_inline_rewrite_optional_body(rewrite, else_body), span: span}
        .ComptimeSwitch(subject, arms, else_body, span) -> Stmt.ComptimeSwitch{subject: sema_inline_rewrite_expr(rewrite, subject), arms: sema_inline_rewrite_arms(rewrite, arms), else_body: sema_inline_rewrite_optional_body(rewrite, else_body), span: span}
        .BreakValue(value, span) -> Stmt.BreakValue{value: sema_inline_rewrite_expr(rewrite, value), span: span}
        .BreakLabelValue(name, name_span, value, span) -> Stmt.BreakLabelValue{name: name, name_span: name_span, value: sema_inline_rewrite_expr(rewrite, value), span: span}
        // copy: `label` is a payload of read parameter `stmt`, which keeps the original; field `label` of the new Stmt.Loop owns this one
        .Loop(body, span, arrow_body, label) -> Stmt.Loop{body: sema_inline_rewrite_stmts(rewrite, body), span: span, arrow_body: arrow_body, label: label.copy()}
        .CountedLoop(init, cond, step, body, span, arrow_body, label) -> {
            saved: rewrite.locals.len()
            mapped_init: sema_inline_rewrite_binding(rewrite, init)
            sema_inline_declare_binding(rewrite, init)
            mapped_cond: sema_inline_rewrite_expr(rewrite, cond)
            mapped_step := Stmt?{None}
            if step == .Val(value) -> mapped_step = Val(sema_inline_rewrite_stmt(rewrite, value))
            mapped_body: sema_inline_rewrite_stmts(rewrite, body)
            sema_inline_restore_locals(rewrite, saved)
            Stmt.CountedLoop{init: mapped_init, cond: mapped_cond, step: mapped_step, body: mapped_body, span: span, arrow_body: arrow_body, label: label}
        }
        // copy: `audit` is a payload of read parameter `stmt`, which keeps the original; field `audit` of the new Stmt.Unsafe owns this one
        .Unsafe(audit, audit_expr, body, span) -> Stmt.Unsafe{audit: audit.copy(), audit_expr: sema_inline_rewrite_optional_expr(rewrite, audit_expr), body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        // copy: `reason` is a payload of read parameter `stmt`, which keeps the original; field `reason` of the new Stmt.Impure owns this one
        .Impure(reason, reason_expr, body, span) -> Stmt.Impure{reason: reason.copy(), reason_expr: sema_inline_rewrite_optional_expr(rewrite, reason_expr), body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .Reactive(body, span) -> Stmt.Reactive{body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .Shield(body, span) -> Stmt.Shield{body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        // copy: `marker` is a payload of read parameter `stmt`, which keeps the original; field `marker` of the new Stmt.Switched owns this one
        .Switched(marker, body, span) -> Stmt.Switched{marker: marker.copy(), body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .Region(name, name_span, body, span) -> Stmt.Region{name: name, name_span: name_span, body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .Policy(declarations, body, span) -> Stmt.Policy{declarations: declarations, body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .TaskGroup(name, name_span, limit, body, span) -> Stmt.TaskGroup{name: name, name_span: name_span, limit: sema_inline_rewrite_optional_expr(rewrite, limit), body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .Layout(name, name_span, body, span) -> Stmt.Layout{name: name, name_span: name_span, body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        // copy: `binding` is a payload of read parameter `stmt`, which keeps the original; field `binding` of the new Stmt.AuthorityScope owns this one
        .AuthorityScope(caps, caps_span, binding, body, span) -> Stmt.AuthorityScope{caps: caps, caps_span: caps_span, binding: binding.copy(), body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        // copy: `selected_then` is a payload of read parameter `stmt`, which keeps the original; field `selected_then` of the new Stmt.ComptimeIf owns this one
        .ComptimeIf(cond, cond_span, then_body, else_body, span, selected_then) -> Stmt.ComptimeIf{cond: sema_inline_rewrite_expr(rewrite, cond), cond_span: cond_span, then_body: sema_inline_rewrite_stmts(rewrite, then_body), else_body: sema_inline_rewrite_optional_body(rewrite, else_body), span: span, selected_then: selected_then.copy()}
        .ComptimeBlock(body, is_template_loop, span) -> Stmt.ComptimeBlock{body: sema_inline_rewrite_stmts(rewrite, body), is_template_loop: is_template_loop, span: span}
        .ContextBlock(fields, body, span) -> {
            mapped := [ContextField]{}
            loop field in fields -> mapped.push(ContextField{name: field.name, value: sema_inline_rewrite_expr(rewrite, field.value), span: field.span})
            Stmt.ContextBlock{fields: mapped, body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        }
        .Live(body, span) -> Stmt.Live{body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .AssumeDet(reason, reason_expr, body, span) -> Stmt.AssumeDet{reason: reason, reason_expr: sema_inline_rewrite_expr(rewrite, reason_expr), body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        // copy: `name` and `name_span` are payloads of read parameter `stmt`, which keeps the originals; the new Stmt.Transact's fields own `name` and `name_span`
        .Transact(name, name_span, body, implicit, span) -> Stmt.Transact{name: name.copy(), name_span: name_span.copy(), body: sema_inline_rewrite_stmts(rewrite, body), implicit: implicit, span: span}
        .Yield(value, span) -> Stmt.Yield{value: sema_inline_rewrite_expr(rewrite, value), span: span}
        // copy: `args_span` is a payload of read parameter `stmt`, which keeps the original; field `args_span` of the new Stmt.ScopeMember owns this one
        .ScopeMember(name, name_span, args, args_span, body, dsl, dot_span, span) -> Stmt.ScopeMember{name: name, name_span: name_span, args: sema_inline_rewrite_exprs(rewrite, args), args_span: args_span.copy(), body: sema_inline_rewrite_stmts(rewrite, body), dsl: dsl, dot_span: dot_span, span: span}
        .DeferClose(close, span) -> Stmt.DeferClose{close: sema_inline_rewrite_expr(rewrite, close), span: span}
        // copy: the rewrite walks the module program by borrowed payload views (Jet has no
        // consuming match), so an unchanged statement kind is copied into the rebuilt program,
        // while the caller's program keeps the original.
        else -> stmt.copy()
    }
}

sema_inline_rewrite_markers: fn(rewrite: &SemaInlineRewrite, markers: [Marker]) -> [Marker] Never! {
    mapped := [Marker]{}
    loop marker in markers {
        updated := marker
        args := [MarkerCallArg]{}
        loop arg in marker.args {
            if arg == {
                .Expr(value) -> args.push(MarkerCallArg.Expr{value: sema_inline_rewrite_expr(rewrite, value)})
                else -> args.push(arg.copy())
            }
        }
        updated.args = args
        mapped.push(updated)
    }
    mapped
}

sema_inline_rewrite_clauses: fn(rewrite: &SemaInlineRewrite, clauses: [ContractClause]) -> [ContractClause] Never! {
    mapped := [ContractClause]{}
    loop clause in clauses {
        updated := clause
        updated.cond = sema_inline_rewrite_expr(rewrite, clause.cond)
        updated.message_expr = sema_inline_rewrite_expr(rewrite, clause.message_expr)
        mapped.push(updated)
    }
    mapped
}

sema_inline_rewrite_params: fn(rewrite: &SemaInlineRewrite, params: [Param]) -> [Param] Never! {
    mapped := [Param]{}
    loop param in params {
        updated := param
        updated.ty = sema_inline_rewrite_type(rewrite, param.ty)
        updated.default = sema_inline_rewrite_optional_expr(rewrite, param.default)
        mapped.push(updated)
        rewrite.locals.push(param.name)
    }
    mapped
}

// A bound names a trait the rewrite may rename (`<M: Native>` inside an
// instance whose `Native` became the generated nominal).
sema_inline_rewrite_type_params: fn(rewrite: SemaInlineRewrite, params: [TypeParam]) -> [TypeParam] Never! {
    mapped := [TypeParam]{}
    loop param in params {
        updated := param
        updated.bounds = loop bound in param.bounds -> sema_inline_mapped_name(rewrite, bound)
        mapped.push(updated)
    }
    mapped
}

// Rust `specialize_func` / `specialize_function_types` plus the call routes.
sema_inline_rewrite_func: fn(rewrite: &SemaInlineRewrite, function: Func) -> Func Never! {
    updated := function
    saved: rewrite.locals.len()
    updated.type_params = sema_inline_rewrite_type_params(rewrite, function.type_params)
    updated.params = sema_inline_rewrite_params(rewrite, function.params)
    updated.return_type = sema_inline_rewrite_optional_type(rewrite, function.return_type)
    updated.markers = sema_inline_rewrite_markers(rewrite, function.markers)
    updated.pre = sema_inline_rewrite_clauses(rewrite, function.pre)
    updated.post = sema_inline_rewrite_clauses(rewrite, function.post)
    updated.body = sema_inline_rewrite_stmts(rewrite, function.body)
    sema_inline_restore_locals(rewrite, saved)
    updated
}

sema_inline_rewrite_funcs: fn(rewrite: &SemaInlineRewrite, functions: [Func]) -> [Func] Never! {
    mapped := [Func]{}
    loop function in functions -> mapped.push(sema_inline_rewrite_func(rewrite, function))
    mapped
}

sema_inline_rewrite_named_types: fn(rewrite: SemaInlineRewrite, types: [NamedType]) -> [NamedType] Never! {
    mapped := [NamedType]{}
    loop entry in types {
        updated := entry
        updated.ty = sema_inline_rewrite_type(rewrite, entry.ty)
        mapped.push(updated)
    }
    mapped
}

sema_inline_rewrite_trait_blocks: fn(rewrite: &SemaInlineRewrite, blocks: [TraitImplBlock]) -> [TraitImplBlock] Never! {
    mapped := [TraitImplBlock]{}
    loop block in blocks {
        updated := block
        updated.trait_name = sema_inline_mapped_name(rewrite, block.trait_name)
        updated.methods = sema_inline_rewrite_funcs(rewrite, block.methods)
        updated.operator_rhs = sema_inline_rewrite_optional_type(rewrite, block.operator_rhs)
        updated.assoc_type_impls = sema_inline_rewrite_named_types(rewrite, block.assoc_type_impls)
        updated.constants = sema_inline_rewrite_impl_constants(rewrite, block.constants)
        mapped.push(updated)
    }
    mapped
}

sema_inline_rewrite_impl_constants: fn(rewrite: &SemaInlineRewrite, constants: [ImplConstValue]) -> [ImplConstValue] Never! {
    loop constant in constants -> ImplConstValue{name: constant.name, name_span: constant.name_span, value: sema_inline_rewrite_expr(rewrite, constant.value), span: constant.span}
}

// Rust `specialize_struct` with the module alias.
sema_inline_rewrite_struct: fn(rewrite: &SemaInlineRewrite, definition: StructDef, alias: String) -> StructDef Never! {
    updated := definition
    if alias != "" -> updated.name = sema_inline_type_name(alias, definition.name)
    updated.type_params = sema_inline_rewrite_type_params(rewrite, definition.type_params)
    fields := [Field]{}
    loop field_index in 0..<definition.fields.len() {
        mapped := definition.fields[field_index]
        mapped.ty = sema_inline_rewrite_type(rewrite, definition.fields[field_index].ty)
        mapped.computed = sema_inline_rewrite_optional_expr(rewrite, definition.fields[field_index].computed)
        mapped.serde_markers = sema_inline_rewrite_markers(rewrite, definition.fields[field_index].serde_markers)
        fields.push(mapped)
    }
    updated.fields = fields
    updated.methods = sema_inline_rewrite_funcs(rewrite, definition.methods)
    updated.trait_impls = sema_inline_rewrite_trait_blocks(rewrite, definition.trait_impls)
    updated.serde_markers = sema_inline_rewrite_markers(rewrite, definition.serde_markers)
    updated.type_markers = sema_inline_rewrite_markers(rewrite, definition.type_markers)
    updated.derives = sema_inline_mapped_names(rewrite, definition.derives)
    updated
}

// Rust `specialize_enum` with the module alias.
sema_inline_rewrite_enum: fn(rewrite: &SemaInlineRewrite, definition: EnumDef, alias: String) -> EnumDef Never! {
    updated := definition
    if alias != "" -> updated.name = sema_inline_type_name(alias, definition.name)
    updated.type_params = sema_inline_rewrite_type_params(rewrite, definition.type_params)
    variants := [Variant]{}
    loop variant_index in 0..<definition.variants.len() {
        mapped := definition.variants[variant_index]
        mapped.payload = if definition.variants[variant_index].payload == {
            .Unit -> VariantPayload.Unit
            .Single(ty, span) -> VariantPayload.Single{ty: sema_inline_rewrite_type(rewrite, ty), span: span}
            .Named(fields) -> {
                mapped_fields := [VariantField]{}
                loop field in fields -> mapped_fields.push(VariantField{name: field.name, name_span: field.name_span, ty: sema_inline_rewrite_type(rewrite, field.ty), ty_span: field.ty_span})
                VariantPayload.Named{fields: mapped_fields}
            }
        }
        mapped.discriminant_expr = sema_inline_rewrite_optional_expr(rewrite, definition.variants[variant_index].discriminant_expr)
        mapped.serde_markers = sema_inline_rewrite_markers(rewrite, definition.variants[variant_index].serde_markers)
        variants.push(mapped)
    }
    updated.variants = variants
    updated.methods = sema_inline_rewrite_funcs(rewrite, definition.methods)
    updated.trait_impls = sema_inline_rewrite_trait_blocks(rewrite, definition.trait_impls)
    updated.serde_markers = sema_inline_rewrite_markers(rewrite, definition.serde_markers)
    updated.type_markers = sema_inline_rewrite_markers(rewrite, definition.type_markers)
    updated.derives = sema_inline_mapped_names(rewrite, definition.derives)
    updated
}

// Rust `specialize_trait`.
sema_inline_rewrite_trait: fn(rewrite: &SemaInlineRewrite, definition: TraitDef) -> TraitDef Never! {
    updated := definition
    updated.name = sema_inline_mapped_name(rewrite, definition.name)
    methods := [TraitMethodSig]{}
    loop method_index in 0..<definition.methods.len() {
        mapped := definition.methods[method_index]
        saved: rewrite.locals.len()
        mapped.params = sema_inline_rewrite_params(rewrite, definition.methods[method_index].params)
        mapped.return_type = sema_inline_rewrite_optional_type(rewrite, definition.methods[method_index].return_type)
        mapped.default_body = sema_inline_rewrite_optional_body(rewrite, definition.methods[method_index].default_body)
        mapped.markers = sema_inline_rewrite_markers(rewrite, definition.methods[method_index].markers)
        sema_inline_restore_locals(rewrite, saved)
        methods.push(mapped)
    }
    updated.methods = methods
    updated.constants = loop constant in definition.constants -> TraitConstDecl{name: constant.name, name_span: constant.name_span, ty: sema_inline_rewrite_type(rewrite, constant.ty), ty_span: constant.ty_span, default: sema_inline_rewrite_optional_expr(rewrite, constant.default), span: constant.span}
    updated
}

// Rust `specialize_error_conv`.
sema_inline_rewrite_error_conv: fn(rewrite: &SemaInlineRewrite, definition: ErrorConvDef) -> ErrorConvDef Never! {
    updated := definition
    updated.from_ty = sema_inline_mapped_name(rewrite, definition.from_ty)
    updated.to_ty = sema_inline_mapped_name(rewrite, definition.to_ty)
    updated.body = sema_inline_rewrite_stmts(rewrite, definition.body)
    updated
}

// Rust `specialize_impl`.
sema_inline_rewrite_impl: fn(rewrite: &SemaInlineRewrite, definition: ImplDef) -> ImplDef Never! {
    updated := definition
    updated.type_name = sema_inline_mapped_name(rewrite, definition.type_name)
    if definition.trait_name == .Val(trait_name) -> updated.trait_name = Val(sema_inline_mapped_name(rewrite, trait_name))
    updated.methods = sema_inline_rewrite_funcs(rewrite, definition.methods)
    updated.assoc_type_impls = sema_inline_rewrite_named_types(rewrite, definition.assoc_type_impls)
    updated.constants = sema_inline_rewrite_impl_constants(rewrite, definition.constants)
    updated
}

// ---------------------------------------------------------------------------
// Rust `hoist_inline_module_types`.

sema_inline_hoist_module: fn(code_module: CodeModule, source_path: String, hoist: &SemaInlineHoist) -> SemaInlineHoisted {
    updated := code_module
    if code_module.instance_identity != None -> return SemaInlineHoisted{code_module: updated, paths: [String]{}, types: [String:Type]{}}
    body: code_module.body ?? return SemaInlineHoisted{code_module: updated, paths: [String]{}, types: [String:Type]{}}
    module_alias: sema_inline_type_alias(source_path)
    module_name: code_module.name
    display_alias: sema_inline_type_alias(module_name)
    direct_types := [String:Type]{}
    direct_names := [String]{}
    loop inner in body {
        name := ""
        if inner == {
            .Struct(definition) -> name = definition.name
            .Enum(definition) -> name = definition.name
            .Trait(definition) -> name = definition.name
            .Tag(definition) -> name = definition.name
            .Distinct(definition) -> name = definition.name
            .TypeAlias(definition) -> name = definition.name
            else -> next
        }
        resolved: Type.Named{name: sema_inline_type_name(module_alias, name)}
        direct_types[name] = resolved
        direct_types["{module_name}.{name}"] = resolved
        direct_types["{source_path}.{name}"] = resolved
        // A file imported under an alias can still carry the defining
        // module's compiler-owned spelling; normalize it to this identity.
        direct_types[sema_inline_type_name(display_alias, name)] = resolved
        direct_names.push(name.copy())
        // The enclosing file reaches private member types by
        // their full module path too. Do not export a nested relative name.
        hoist.exported["{source_path}.{name}"] = resolved
        hoist.has_exported = true
    }
    kept := [Item]{}
    lifted := [Item]{}
    descendant_types := [String:Type]{}
    descendant_paths := [String]{}
    loop inner in body {
        if inner == {
            .CodeModule(child) -> {
                child_path: "{source_path}.{child.name}"
                hoisted: sema_inline_hoist_module(child, child_path, hoist)
                loop full_path in hoisted.paths {
                    descendant_types[full_path] = hoisted.types.get(full_path) ?? next
                    descendant_paths.push(full_path)
                }
                kept.push(Item.CodeModule{value: hoisted.code_module})
            }
            .Struct(_) | .Enum(_) | .Trait(_) | .Tag(_) | .Impl(_) | .Distinct(_) | .TypeAlias(_) -> lifted.push(inner.copy())
            else -> kept.push(inner.copy())
        }
    }
    visible := sema_inline_rewrite_empty()
    visible.types = direct_types
    prefix: "{source_path}."
    loop full_path in descendant_paths {
        ty: descendant_types.get(full_path) ?? next
        visible.types[full_path] = ty
        if full_path.starts_with(prefix) {
            relative: String.from_bytes(full_path.bytes()[prefix.bytes().len()..<full_path.bytes().len()]) ?? full_path
            visible.types[relative] = ty
        }
    }
    kept_rewritten := [Item]{}
    loop inner in kept {
        if inner == {
            .Func(definition) -> kept_rewritten.push(Item.Func{value: sema_inline_rewrite_func(visible, definition)})
            .Const(definition) -> {
                mapped := definition
                mapped.value = sema_inline_rewrite_expr(visible, definition.value)
                mapped.ty = sema_inline_rewrite_optional_type(visible, definition.ty)
                kept_rewritten.push(Item.Const{value: mapped})
            }
            else -> kept_rewritten.push(inner)
        }
    }
    loop inner in lifted {
        if inner == {
            .Struct(definition) -> hoist.declarations.push(Item.Struct{value: sema_inline_rewrite_struct(visible, definition, module_alias)})
            .Enum(definition) -> hoist.declarations.push(Item.Enum{value: sema_inline_rewrite_enum(visible, definition, module_alias)})
            .Trait(definition) -> hoist.declarations.push(Item.Trait{value: sema_inline_rewrite_trait(visible, definition)})
            .Tag(definition) -> {
                mapped := definition
                mapped.name = sema_inline_mapped_name(visible, definition.name)
                hoist.declarations.push(Item.Tag{value: mapped})
            }
            .Impl(definition) -> hoist.declarations.push(Item.Impl{value: sema_inline_rewrite_impl(visible, definition)})
            .Distinct(definition) -> {
                mapped := definition
                mapped.name = sema_inline_mapped_name(visible, definition.name)
                mapped.base = sema_inline_rewrite_type(visible, definition.base)
                hoist.declarations.push(Item.Distinct{value: mapped})
            }
            .TypeAlias(definition) -> {
                mapped := definition
                mapped.name = sema_inline_mapped_name(visible, definition.name)
                mapped.target = sema_inline_rewrite_type(visible, definition.target)
                hoist.declarations.push(Item.TypeAlias{value: mapped})
            }
            else -> {}
        }
    }
    updated.body = Val(kept_rewritten)
    all_paths := [String]{}
    all_types := [String:Type]{}
    loop name in direct_names {
        ty: direct_types.get(name) ?? next
        all_paths.push("{source_path}.{name}")
        all_types["{source_path}.{name}"] = ty
    }
    loop full_path in descendant_paths {
        all_paths.push(full_path.copy())
        all_types[full_path] = descendant_types.get(full_path) ?? next
    }
    SemaInlineHoisted{code_module: updated, paths: all_paths, types: all_types}
}

// Rust `rewrite_exported_inline_types`: member types reach every function of
// the enclosing file (and its inline modules) by their qualified name. The
// file's own structs, enums and tests name them the same way, so a field
// `stream: transport.BodyStream` holds the hoisted member type.
sema_inline_rewrite_exported: fn(items: [Item], rewrite: &SemaInlineRewrite) -> [Item] Never! {
    mapped := [Item]{}
    loop item in items {
        if item == {
            .Func(function) -> mapped.push(Item.Func{value: sema_inline_rewrite_func(rewrite, function)})
            .Struct(definition) -> mapped.push(Item.Struct{value: sema_inline_rewrite_struct(rewrite, definition, "")})
            .Enum(definition) -> mapped.push(Item.Enum{value: sema_inline_rewrite_enum(rewrite, definition, "")})
            .Test(_) -> mapped.push(sema_inline_rewrite_item(rewrite, item))
            // An impl head names member types and traits by their
            // module path (`impl inner.Loud.inner.Shout`), so it binds to the
            // hoisted declarations the module's own impls bind to.
            .Impl(definition) -> {
                updated := definition
                updated.type_name = sema_inline_mapped_name(rewrite, definition.type_name)
                if definition.trait_name == .Val(trait_name) -> updated.trait_name = Val(sema_inline_mapped_name(rewrite, trait_name))
                updated.methods = sema_inline_rewrite_funcs(rewrite, definition.methods)
                mapped.push(Item.Impl{value: updated})
            }
            .CodeModule(definition) -> {
                updated := definition
                if definition.body == .Val(body) -> updated.body = Val(sema_inline_rewrite_exported(body, rewrite))
                mapped.push(Item.CodeModule{value: updated})
            }
            else -> mapped.push(item.copy())
        }
    }
    mapped
}

// ---------------------------------------------------------------------------
// `use g: bank.f` over an inline module (Rust CheckInner 4).

sema_inline_import_target: fn(declaration: ImportDecl, inline_names: [String:Bool]) -> String? Never! {
    if declaration.kind == .Unqualified(module_alias, _, _, _, _) {
        if inline_names.get(module_alias) != None -> return Val(module_alias)
    }
    None
}

sema_inline_bind_imports: fn(program: Program, surfaces: [SemaInlineModuleSurface], inline_names: [String:Bool], rewrite: &SemaInlineRewrite) -> [ImportDecl] {
    kept := [ImportDecl]{}
    seen := [String:Bool]{}
    loop declaration in program.imports {
        target: sema_inline_import_target(declaration, inline_names) ?? {
            if declaration.kind == .Unqualified(_, _, items, _, _) {
                loop item in items -> seen[sema_registration_import_local(item)] = true
            }
            kept.push(declaration.copy())
            next
        }
        if declaration.kind == .Unqualified(module_alias, module_alias_span, items, _, _) {
            surface := SemaInlineModuleSurface?{None}
            loop candidate in surfaces {
                if candidate.name == target -> surface = Val(candidate)
            }
            // A module whose functions stay in its body binds nothing here.
            members: surface ?? next
            loop (item_index, item) in items {
                local: sema_registration_import_local(item)
                if {
                    seen.get(local) != None -> rewrite.diagnostics.push(sema_error("E0105", declaration.alias_span, "the import name `{local}` is used twice", "each import needs a unique namespace name in this file", "rename one with an `alias: path` row"))
                    members.functions.get(item.original) == None -> rewrite.diagnostics.push(sema_error("E0611", module_alias_span, "`{item.original}` is not defined in module `{module_alias}`", "check the module body for the item you're importing", "make sure the name is spelled correctly"))
                    else -> {
                        seen[local] = true
                        span: if item_index < declaration.local_spans.len() -> declaration.local_spans[item_index] else -> declaration.span
                        rewrite.imported[local] = SemaInlineFunctionBinding{semantic_name: sema_inline_member_name(target, item.original), module_alias: target.copy(), source_name: item.original.copy(), span: span, visibility: if declaration.is_pub -> 2 else -> if declaration.is_package_pub -> 1 else -> 0}
                    }
                }
            }
        }
    }
    kept
}

// Rust `resolve_inline_module_imports`: a module's own `use alias.[f]` binds
// `f` inside that module only. `alias` is a sibling inline module (its member
// must exist, E0611, and be `pub`, E0609) or a file module this file imports
// (the member is read qualified). A group with any problem binds nothing.
// `pub use` also re-exports each bound name as `module.name`.
sema_inline_bind_module_imports: fn(definition: CodeModule, surfaces: [SemaInlineModuleSurface], file_aliases: [String:Bool], rewrite: &SemaInlineRewrite) -> [String:SemaInlineTarget] {
    reexports := [String:SemaInlineTarget]{}
    names := [String:Bool]{}
    loop declaration in definition.imports {
        // `pub use exported: core.math.abs`: a Core member under the module's
        // own alias.
        if declaration.kind == .Module(name, _) {
            target: sema_inline_core_member(name) ?? next
            local: declaration.alias
            if names.get(local) != None {
                rewrite.diagnostics.push(sema_error("E0105", declaration.alias_span, "the import name `{local}` is used twice", "each import needs a unique namespace name in this file", "rename one with an `alias: path` row"))
                next
            }
            names[local] = true
            rewrite.qualified[local] = target
            if declaration.is_pub -> reexports[local] = target
            next
        }
        if declaration.kind == .Unqualified(module_alias, module_alias_span, items, _, _) {
            core: module_alias == "core" || module_alias.starts_with("core.")
            group_start: rewrite.diagnostics.len()
            bound_locals := [String]{}
            bound_targets := [SemaInlineTarget]{}
            members := SemaInlineModuleSurface?{None}
            loop candidate in surfaces {
                if candidate.name == module_alias -> members = Val(candidate)
            }
            loop item in items {
                local: sema_registration_import_local(item)
                if names.get(local) != None {
                    rewrite.diagnostics.push(sema_error("E0105", declaration.alias_span, "the import name `{local}` is used twice", "each import needs a unique namespace name in this file", "rename one with an `alias: path` row"))
                    next
                }
                names[local] = true
                if core {
                    bound_locals.push(local)
                    bound_targets.push(sema_inline_core_member("{module_alias}.{item.original}") ?? panic("a lowerable module binds only Core members"))
                    next
                }
                if members == .Val(surface) {
                    if surface.functions.get(item.original) == None {
                        rewrite.diagnostics.push(sema_error("E0611", module_alias_span, "`{item.original}` is not defined in module `{module_alias}`", "check the module body for the item you are importing", "make sure the name is spelled correctly"))
                    } else {
                        bound_locals.push(local)
                        bound_targets.push(SemaInlineTarget{module_alias: module_alias, member: item.original, qualified: false})
                    }
                    next
                }
                if file_aliases.get(module_alias) != None {
                    bound_locals.push(local)
                    bound_targets.push(SemaInlineTarget{module_alias: module_alias, member: item.original, qualified: true})
                    next
                }
                rewrite.diagnostics.push(sema_unknown_module_alias(module_alias, module_alias_span))
            }
            if rewrite.diagnostics.len() != group_start -> next
            loop (index, local) in bound_locals {
                if bound_targets[index].qualified {
                    rewrite.qualified[local] = bound_targets[index]
                } else {
                    span: if index < declaration.local_spans.len() -> declaration.local_spans[index] else -> declaration.span
                    rewrite.imported[local] = SemaInlineFunctionBinding{semantic_name: sema_inline_member_name(bound_targets[index].module_alias, bound_targets[index].member), module_alias: bound_targets[index].module_alias.copy(), source_name: bound_targets[index].member.copy(), span: span, visibility: if declaration.is_pub -> 2 else -> if declaration.is_package_pub -> 1 else -> 0}
                }
                if declaration.is_pub -> reexports[local] = bound_targets[index]
            }
        }
    }
    reexports
}

// Rust `resolve_inline_module_imports` for a file-module member, once every
// import is bound: `use limits.[MAX]` inside a module names a declaration of
// `limits` (E0611) that this file may see (E0609).
sema_inline_modules_collect_import_diagnostics: fn(graph: SemaRegistrationGraph, module_index: Int, diagnostics: &[Diagnostic]) {
    module_row: graph.modules[module_index]
    loop item in module_row.program.items {
        if item == .CodeModule(definition) {
            loop declaration in definition.imports {
                if declaration.kind == .Unqualified(module_alias, module_alias_span, items, _, _) {
                    target_index := -1
                    loop import in module_row.imports {
                        if import.declaration.alias == module_alias && !sema_registration_import_is_unqualified(import.declaration) {
                            target_index = sema_registration_module_index(graph, import.target_module_identity) ?? -1
                        }
                    }
                    if target_index < 0 -> next
                    loop imported in items {
                        original: imported.original
                        if sema_registration_resolve_export(graph, target_index, original, module_row.module_identity, module_row.package_identity, [String]{}) != None -> next
                        declared: sema_registration_direct_symbol(graph.modules[target_index], original)
                        if declared == {
                            .Val(export) -> {
                                fix: if export.symbol.kind == SymbolKind.Function -> "import it from inside its enclosing module, or remove `priv` from its module" else -> "import it from inside its enclosing module, or remove `priv` from its module"
                                diagnostics.push(sema_error("E0609", module_alias_span, "`{original}` is private in module `{module_alias}`", "an item of a `priv module` is usable only by its enclosing module", fix))
                            }
                            .None -> diagnostics.push(sema_error("E0611", module_alias_span, "`{original}` is not defined in module `{module_alias}`", "check the module for the item you are importing", "make sure the name is spelled correctly"))
                        }
                    }
                }
            }
        }
    }
}

sema_inline_modules_check_imports: fn(graph: &SemaRegistrationGraph, module_index: Int) {
    diagnostics := [Diagnostic]{}
    sema_inline_modules_collect_import_diagnostics(graph, module_index, diagnostics)
    loop diagnostic in diagnostics -> sema_registration_push_graph_diagnostic(graph, module_index, diagnostic)
}

// Every lowerable module nested in `body` (module `parent`), depth first, with
// the import bindings its members see. Each module binds its imports here,
// once, so its `pub use` re-exports are on its surface before any body is
// rewritten.
sema_inline_collect_nested: fn(body: [Item], parent: String, file_imports: [ImportDecl], surfaces: [SemaInlineModuleSurface], file_aliases: [String:Bool], nested: &[SemaInlineModuleSurface], bindings: &[SemaInlineRewrite]) Never! {
    loop item in body {
        if item == .CodeModule(child) {
            child_body: child.body ?? next
            if !sema_inline_module_lowerable(child, file_imports) -> next
            path: "{parent}.{child.name}"
            private_to := String?{None}
            if !child.is_pub && !child.is_package_pub -> private_to = Val(parent.copy())
            surface := SemaInlineModuleSurface{name: path.copy(), path: path.copy(), private_to: private_to, functions: [String:Bool]{}, reexports: [String:SemaInlineTarget]{}}
            loop inner in child_body {
                if inner == .Func(function) -> surface.functions[function.name] = true
            }
            binding := sema_inline_rewrite_empty()
            binding.sibling_module = path.copy()
            binding.siblings = surface.functions
            surface.reexports = sema_inline_bind_module_imports(child, surfaces, file_aliases, binding)
            nested.push(surface)
            bindings.push(binding)
            sema_inline_collect_nested(child_body, path, file_imports, surfaces, file_aliases, nested, bindings)
        }
    }
}

// The inline modules a body inside module `context` calls through: every
// nested module by its full path, and those nested in `context` also by their
// path relative to it (`inner.f()` inside `math` is `math.inner.f()`).
sema_inline_scope_surfaces: fn(nested: [SemaInlineModuleSurface], context: String) -> [SemaInlineModuleSurface] Never! {
    scope := [SemaInlineModuleSurface]{}
    prefix: "{context}."
    loop surface in nested {
        scope.push(surface.copy())
        if !surface.path.starts_with(prefix) -> next
        relative := surface
        relative.name = String.from_bytes(surface.path.bytes()[prefix.bytes().len()..<surface.path.bytes().len()]) ?? next
        scope.push(relative)
    }
    scope
}

// Lifts the member functions of every module nested in `body` (module
// `parent`) under their member identities, each body rewritten with the
// bindings sema_inline_collect_nested made for its module.
sema_inline_lift_nested: fn(body: [Item], parent: String, file_imports: [ImportDecl], nested: [SemaInlineModuleSurface], bindings: [SemaInlineRewrite], lifted: &[Item], diagnostics: &[Diagnostic]) Never! {
    loop item in body {
        if item == .CodeModule(child) {
            child_body: child.body ?? next
            if !sema_inline_module_lowerable(child, file_imports) -> next
            path: "{parent}.{child.name}"
            row: loop (index, surface) in nested {
                if surface.path == path -> break index
            } ?? -1
            if row < 0 -> next
            rewrite := bindings[row]
            rewrite.modules = sema_inline_scope_surfaces(nested, path)
            loop inner in child_body {
                if inner == .Func(function) {
                    member := sema_inline_rewrite_func(rewrite, function)
                    member.name = sema_inline_member_name(path, function.name)
                    lifted.push(Item.Func{value: member})
                }
            }
            loop diagnostic in rewrite.diagnostics -> diagnostics.push(diagnostic)
            sema_inline_lift_nested(child_body, path, file_imports, nested, bindings, lifted, diagnostics)
        }
    }
}

// Every module's functions are lifted (top-level ones in
// sema_inline_modules_lower, nested ones by sema_inline_lift_nested), and a
// module constant or test is never registered (registers an inline body's
// `Item::Func` members only): functions, constants and tests leave the lowered
// program.
sema_inline_strip_members: fn(body: [Item]) -> [Item] Never! {
    kept := [Item]{}
    loop item in body {
        if item == {
            .Func(_) | .Const(_) | .Test(_) -> next
            .CodeModule(child) -> {
                updated := child
                if child.body == .Val(child_body) -> updated.body = Val(sema_inline_strip_members(child_body))
                kept.push(Item.CodeModule{value: updated})
            }
            else -> kept.push(item.copy())
        }
    }
    kept
}

// ---------------------------------------------------------------------------
// The pass.

sema_inline_rewrite_item: fn(rewrite: &SemaInlineRewrite, item: Item) -> Item Never! {
    if item == {
        .Func(function) -> Item.Func{value: sema_inline_rewrite_func(rewrite, function)}
        .Struct(definition) -> Item.Struct{value: sema_inline_rewrite_struct(rewrite, definition, "")}
        .Enum(definition) -> Item.Enum{value: sema_inline_rewrite_enum(rewrite, definition, "")}
        .Impl(definition) -> {
            updated := definition
            updated.methods = sema_inline_rewrite_funcs(rewrite, definition.methods)
            Item.Impl{value: updated}
        }
        .Test(definition) -> {
            updated := definition
            saved: rewrite.locals.len()
            updated.params = sema_inline_rewrite_params(rewrite, definition.params)
            updated.pre = sema_inline_rewrite_clauses(rewrite, definition.pre)
            updated.body = sema_inline_rewrite_stmts(rewrite, definition.body)
            sema_inline_restore_locals(rewrite, saved)
            Item.Test{value: updated}
        }
        // copy: the rewrite walks the module program by borrowed payload views (Jet has no
        // consuming match), so an unchanged item kind is copied into the rebuilt program, while the
        // caller's program keeps the original.
        else -> item.copy()
    }
}

// Rebuilding items must not first copy the old item list only to discard it.
// Keep the remaining source metadata, and transfer the replacement list.
sema_program_with_items: fn(program: Program, items: &&[Item]) -> Program Never! {
    Program{
        imports: program.imports,
        items: items.move(),
        script_body: program.script_body,
        block_spans: program.block_spans,
        fenced_statements: program.fenced_statements,
        web_target_ceiling: program.web_target_ceiling,
        no_prelude: program.no_prelude,
        default_target: program.default_target,
        html_path: program.html_path,
        policy_declarations: program.policy_declarations,
        user_policy_declarations: program.user_policy_declarations,
        applied_rules: program.applied_rules,
        rule_facts: program.rule_facts,
        else_arms: program.else_arms,
        used_import_names: program.used_import_names,
        debug_sites: program.debug_sites,
        app_route_roots: program.app_route_roots,
    }
}

// Lowers `program`'s inline modules in place; a program without one is left
// untouched (not copied).
sema_inline_modules_lower: fn(program: &Program, diagnostics: &[Diagnostic]) -> SemaInlinePreparedBindings {
    if !sema_inline_modules_any_body(program.items) -> return SemaInlinePreparedBindings{imports: [String:SemaInlineFunctionBinding]{}, modules: [SemaInlineModuleSurface]{}}

    // 1. Member types, in item order, then the enclosing file's qualified names.
    hoist := SemaInlineHoist{declarations: [Item]{}, exported: [String:Type]{}, has_exported: false}
    hoisted_items := [Item]{}
    loop item in program.items {
        if item == .CodeModule(definition) {
            hoisted: sema_inline_hoist_module(definition, definition.name, hoist)
            hoisted_items.push(Item.CodeModule{value: hoisted.code_module})
            next
        }
        hoisted_items.push(item.copy())
    }
    if hoist.has_exported {
        exported := sema_inline_rewrite_empty()
        exported.types = hoist.exported
        hoisted_items = sema_inline_rewrite_exported(hoisted_items, exported)
    }

    // 2. Module functions, top-level and nested, become their member
    //    identities, with each module's own `use` bindings applied to its
    //    member bodies.
    file_aliases := [String:Bool]{}
    loop declaration in program.imports {
        if declaration.kind == {
            .Unqualified(_, _, _, _, _) -> {}
            else -> file_aliases[declaration.alias] = true
        }
    }
    surfaces := [SemaInlineModuleSurface]{}
    inline_names := [String:Bool]{}
    loop item_index in 0..<hoisted_items.len() {
        item: hoisted_items[item_index]
        if item == .CodeModule(definition) {
            if definition.body == .Val(body) {
                inline_names[definition.name] = true
                if sema_inline_module_lowerable(definition, program.imports) {
                    surface := SemaInlineModuleSurface{name: definition.name, path: definition.name, private_to: None, functions: [String:Bool]{}, reexports: [String:SemaInlineTarget]{}}
                    loop inner in body {
                        if inner == .Func(function) -> surface.functions[function.name] = true
                    }
                    surfaces.push(surface)
                }
            }
        }
    }
    nested := [SemaInlineModuleSurface]{}
    nested_bindings := [SemaInlineRewrite]{}
    loop item in hoisted_items {
        if item == .CodeModule(definition) {
            if definition.body == .Val(body) {
                if sema_inline_module_lowerable(definition, program.imports) -> sema_inline_collect_nested(body, definition.name, program.imports, surfaces, file_aliases, nested, nested_bindings)
            }
        }
    }
    lowered_items := [Item]{}
    loop item_index in 0..<hoisted_items.len() {
        item: hoisted_items[item_index]
        if item == .CodeModule(definition) {
            if definition.body == .Val(body) {
                if sema_inline_module_lowerable(definition, program.imports) {
                    siblings := sema_inline_rewrite_empty()
                    siblings.sibling_module = definition.name
                    siblings.modules = sema_inline_scope_surfaces(nested, definition.name)
                    surface_index := -1
                    loop (index, surface) in surfaces {
                        if surface.name == definition.name -> surface_index = index
                    }
                    if surface_index >= 0 {
                        siblings.siblings = surfaces[surface_index].functions
                        updated_surface := surfaces[surface_index]
                        updated_surface.reexports = sema_inline_bind_module_imports(definition, surfaces, file_aliases, siblings)
                        surfaces[surface_index] = updated_surface
                    }
                    lifted := [Item]{}
                    loop inner in body {
                        if inner == .Func(function) {
                            member := sema_inline_rewrite_func(siblings, function)
                            member.name = sema_inline_member_name(definition.name, function.name)
                            lifted.push(Item.Func{value: member})
                        }
                    }
                    loop diagnostic in siblings.diagnostics -> diagnostics.push(diagnostic)
                    sema_inline_lift_nested(body, definition.name, program.imports, nested, nested_bindings, lifted, diagnostics)
                    module_item := definition
                    module_item.body = Val(sema_inline_strip_members(body))
                    lowered_items.push(Item.CodeModule{value: module_item})
                    loop member in lifted -> lowered_items.push(member)
                    next
                }
            }
        }
        lowered_items.push(item.copy())
    }
    loop declaration in hoist.declarations -> lowered_items.push(declaration)

    // 3. Qualified calls and `use` bindings, in every body of the file.
    calls := sema_inline_rewrite_empty()
    imports := sema_inline_bind_imports(program, surfaces, inline_names, calls)
    sema_inline_core_imports(hoisted_items, program.imports, imports)
    loop surface in nested -> surfaces.push(surface)
    calls.modules = surfaces.move()
    rewritten := [Item]{}
    loop item in lowered_items -> rewritten.push(sema_inline_rewrite_item(calls, item))
    program.items = rewritten.move()
    program.imports = imports
    loop diagnostic in calls.diagnostics -> diagnostics.push(diagnostic)
    SemaInlinePreparedBindings{imports: calls.imported.move(), modules: calls.modules.move()}
}

// Whether `items` declares an inline module with a body; each item is read
// in place.
sema_inline_modules_any_body: fn(items: [Item]) -> Bool Never! {
    loop item in items {
        if item == .CodeModule(definition) {
            if definition.body != None -> return true
        }
    }
    false
}

#Test("private inline member types resolve in the enclosing file without becoming public") {
    span: Span{start: 0, end: 1}
    carrier: ast_struct("OrderedRow", span, span)
    helper: ast_func("compare", span, span)
    internal: CodeModule{name: "internal", name_span: span, is_pub: false, is_package_pub: false, body: Val([Item]{Item.Struct{value: carrier}, Item.Func{value: helper}}), imports: [ImportDecl]{}, web_target: None, instance_identity: None, span: span}
    consumer := ast_func("execute", span, span)
    consumer.is_pub = true
    consumer.return_type = Val(Type.List{element: Type.Named{name: "internal.OrderedRow"}})
    program := ast_program()
    program.items = [Item]{Item.CodeModule{value: internal}, Item.Func{value: consumer}}
    diagnostics := [Diagnostic]{}
    _: sema_inline_modules_lower(program, diagnostics)
    assert(diagnostics.is_empty())
    resolved := false
    private_type := false
    private_function := false
    loop item in program.items {
        if item == {
            .Func(function) -> {
                if function.name == "execute" -> resolved = function.return_type == Val(Type.List{element: Type.Named{name: sema_inline_type_name("internal", "OrderedRow")}})
                if function.name == sema_inline_member_name("internal", "compare") -> private_function = !function.is_pub && !function.is_package_pub
            }
            .Struct(definition) -> {
                if definition.name == sema_inline_type_name("internal", "OrderedRow") -> private_type = !definition.is_pub && !definition.is_package_pub
            }
            else -> {}
        }
    }
    assert(resolved && private_type && private_function)
}
