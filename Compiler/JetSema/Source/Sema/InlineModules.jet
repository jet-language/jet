// Inline code modules (`bank: module { ... }`). The Rust bootstrap gives every
// member one compiler-owned identity before any declaration is registered
// (`hoist_inline_module_member_types`, `mangle_inline_sibling_calls`, the
// `Item.CodeModule` registration arm, and the inline-module body jobs). This
// pass is that same step on one module program:
//
// 1. member types (struct, enum, trait, tag, impl) lift beside the module
//    under `module_type_name` (`bank.Account` -> `M4BankAccount`); the bare and
//    qualified spellings resolve inside the module, and the qualified spelling
//    resolves in its enclosing file, including members of `priv module`s;
// 2. a module's member functions, top-level or nested, lift under
//    `member_name` (`bank.open` -> `__jet_bank_dopen`, `bank.audit.log` ->
//    `__jet_bank_daudit_dlog`) with their sibling calls renamed, so
//    registration, body checking and lowering see ordinary functions;
// 3. `bank.f(...)` and `bank.audit.f(...)` calls and `use bank.[f]` imports
//    resolve to the member identity: an unknown member is E0608/E0611, a
//    private one E0609; a nested `priv module` is usable only inside the
//    module enclosing it, which names its children relatively (`audit.f()`);
//    a member function or constant read as a value (`bank.open`, `open` in
//    its own module) names its member identity, so it passes like any
//    function and keeps its inferred effect row;
// 4. a module's own `use` declarations
//    bind inside that module only, and its re-exports declare a member as
//    `module.name`; a module named as a value is E0107.
//
// A generic-module instance arrives here as an ordinary module expanded by
// `sema_generic_modules_expand`. A module's constants lift beside its
// functions under their member identities (`geo.START` -> `__jet_geo_dSTART`),
// and a bare read of one inside its module names the lifted constant. A module
// that binds Core modules or members in a member list (`use core.[math]`) reads
// them through a file-level Core alias, and its own module or file imports
// (`use rules: second`) through generated file-level aliases.
use {
    unicode: core.text
    jet_foundation.[
        AST_NODE_GENERATED,
        BindPattern,
        Binding,
        Call,
        CallArg,
        CodeModule,
        ConstDef,
        ContextField,
        ContractClause,
        Diagnostic,
        EnumDef,
        EnumLitArg,
        ErrorConvDef,
        Expr,
        ExprField,
        ExprPair,
        Field,
        ForKind,
        Func,
        ImplConstValue,
        ImplDef,
        ImportDecl,
        ImportKind,
        ImportedItem,
        Item,
        LValue,
        Lambda,
        LambdaBody,
        LambdaParam,
        Marker,
        MarkerCallArg,
        Measure,
        MeasureRule,
        MetaAttr,
        MetaField,
        sema_casing_pascal_words,
        NamedSpan,
        NamedType,
        OrFallback,
        Param,
        PatSlot,
        Pattern,
        PatternTypeHead,
        PipeStep,
        Program,
        Span,
        Stmt,
        StrPart,
        StructDef,
        StructPatField,
        SwitchArm,
        SymbolKind,
        TaskGroupArgs,
        TraitConstDecl,
        TraitDef,
        TraitImplBlock,
        TraitMethodSig,
        TupleField,
        Type,
        TypeTupleField,
        TypedLitBody,
        Variant,
        VariantField,
        VariantPayload,
        measure_kind,
        measure_literal_value,
        ast_func,
        ast_const,
        core_module_export,
        diagnostic_with_label,
        ast_program,
        ast_struct,
        type_name,
    ]
    jet_parser.[
        parse_source,
    ]
}

// A member reached through a `use` inside a module: an inline module member
// function, or (qualified) a member of a file module imported by this file.
SemaInlineTarget: struct {
    module_alias: String,
    member: String,
    qualified: Bool,
}

SemaInlineModuleSurface: struct {
    // How the rewritten body spells the module: its full dotted path, or,
    // inside an enclosing module, its path relative to that module.
    name: String,
    // The full dotted path its member identities are named under.
    path: String,
    // A nested `priv module`: the path of the module it is private to.
    private_to: String?,
    // Member function names reachable by this enclosing file.
    functions: [String:Bool],
    // Member constant names, read as `module.NAME`.
    constants: [String:Bool],
    // The members written `priv`, each with its name's span;
    // only this module and its children reach them.
    private_members: [String:Span],
    // A re-export inside the module: re-exported local name -> its owner.
    reexports: [String:SemaInlineTarget],
    // The re-exports whose chain reaches no function: each is reported once,
    // where it breaks (sema_inline_resolve_reexports), so a read is not.
    broken: [String:Bool],
}

// A re-export between the file's top-level inline modules: `local` in the
// module at surface `owner` names `member` of the module at surface `alias`.
SemaInlineReexportRow: struct {
    owner: Int,
    local: String,
    alias: Int,
    member: String,
    span: Span,
}

SemaInlineFunctionBinding: struct {
    semantic_name: String,
    module_alias: String,
    source_name: String,
    span: Span,
    visibility: Int,
}

// The existing binder's products, retained after body rewriting for checked
// metadata references. These contain names/spans only, never function ASTs.
SemaInlinePreparedBindings: struct {
    imports: [String:SemaInlineFunctionBinding],
    modules: [SemaInlineModuleSurface],
}

SemaInlineRewrite: struct {
    types: [String:Type],
    // Generic-module value parameters and constants -> their literal value.
    values: [String:Expr],
    // Sibling functions of the module whose body is being rewritten.
    sibling_module: String,
    siblings: [String:Bool],
    // File-level inline modules reachable as `alias.f(...)`.
    modules: [SemaInlineModuleSurface],
    // `use g: bank.f`: local name -> member identity.
    imported: [String:SemaInlineFunctionBinding],
    // A module's own `use limits.[MAX]` over a file module alias.
    qualified: [String:SemaInlineTarget],
    // A module's own module or file import alias -> the generated file-level
    // alias its lifted bodies read it through (sema_inline_alias_imports).
    aliases: [String:String],
    locals: [String],
    // Trait-bounded variadic functions -> their fixed parameter count; each
    // call renames to its arity's function, whose arities are noted in order.
    variadic: [String:Int],
    variadic_arities: [String:[Int]],
    diagnostics: [Diagnostic],
    // Member types written `priv`, by full dotted path (`lib.Secret`) -> the
    // span of the name their declaration gives; only their module and its
    // children name them (sema_inline_private_type).
    private_types: [String:Span],
}

SemaInlineHoist: struct {
    declarations: [Item],
    exported: [String:Type],
    has_exported: Bool,
    private_types: [String:Span],
}

SemaInlineHoisted: struct {
    code_module: CodeModule,
    // Every lifted type's full source path, in declaration order.
    paths: [String],
    types: [String:Type],
}

// ---------------------------------------------------------------------------
// Member naming (Rust `Syntax.generated_path`, `Names.member_name`,
// `GenericModules.module_type_name`).

sema_inline_is_alphanumeric: fn(code: Int) -> Bool Never! {
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
}

sema_inline_generated_path: fn(path: String) -> String Never! {
    hex: "0123456789abcdef"
    out := [U8]{}
    loop byte in path.bytes() {
        code: Int{byte}
        if sema_inline_is_alphanumeric(code) {
            out.push(byte)
            next
        }
        out.push(U8{95})
        if {
            code == 95 -> out.push(U8{117})
            code == 46 -> out.push(U8{100})
            code == 58 -> out.push(U8{99})
            code == 47 -> out.push(U8{115})
            code == 92 -> out.push(U8{98})
            code == 45 -> out.push(U8{104})
            else -> {
                out.push(U8{120})
                out.push(hex.bytes()[code /% 16])
                out.push(hex.bytes()[code % 16])
            }
        }
    }
    "__jet_{String.from_bytes(out) ?? ""}"
}

sema_inline_hex_value: fn(code: Int) -> Int Never! {
    if {
        code >= 48 && code <= 57 -> code - 48
        code >= 97 && code <= 102 -> code - 87
        code >= 65 && code <= 70 -> code - 55
        else -> -1
    }
}

// Rust `decode_generated_path_suffix`.
sema_inline_decode_generated_suffix: fn(suffix: String) -> String? Never! {
    bytes: suffix.bytes()
    out := [U8]{}
    index := 0
    loop index < bytes.len() {
        code: Int{bytes[index]}
        if sema_inline_is_alphanumeric(code) {
            out.push(bytes[index])
            index += 1
            next
        }
        if code != 95 || index + 1 >= bytes.len() -> return None
        escape: Int{bytes[index + 1]}
        if {
            escape == 117 -> out.push(U8{95})
            escape == 100 -> out.push(U8{46})
            escape == 99 -> out.push(U8{58})
            escape == 115 -> out.push(U8{47})
            escape == 98 -> out.push(U8{92})
            escape == 104 -> out.push(U8{45})
            escape == 120 && index + 3 < bytes.len() -> {
                high: sema_inline_hex_value(Int{bytes[index + 2]})
                low: sema_inline_hex_value(Int{bytes[index + 3]})
                if high < 0 || low < 0 -> return None
                out.push(U8{high * 16 + low})
                index += 2
            }
            else -> return None
        }
        index += 2
    }
    Val(String.from_bytes(out) ?? return None)
}

sema_inline_member_name: fn(module_path: String, name: String) -> String Never! {
    stripped: if module_path.starts_with("__jet_") -> String.from_bytes(module_path.bytes()[6..<module_path.bytes().len()]) ?? module_path.copy() else -> module_path.copy()
    decoded: sema_inline_decode_generated_suffix(stripped) ?? stripped
    sema_inline_generated_path("{decoded}.{name}")
}

// The source name of a lifted member function (`__jet_bank_dopen` -> `open`),
// so its own body diagnostics name it as written. Only the member segment must
// be an identifier: a module path whose `_s` reads back as `/` (Rust
// `member_name` decodes an unprefixed module path too) still names its member.
// Any other name is returned unchanged.
sema_inline_member_source_name: fn(name: String) -> String Never! {
    if !name.starts_with("__jet_") -> return name.copy()
    decoded: sema_inline_decode_generated_suffix(String.from_bytes(name.bytes()[6..<name.bytes().len()]) ?? "") ?? return name.copy()
    if !decoded.contains(".") || sema_inline_generated_path(decoded) != name -> return name.copy()
    segments: decoded.split(".").to_list()
    member: segments[segments.len() - 1]
    if member == "" -> return name.copy()
    loop byte in member.bytes() {
        code: Int{byte}
        if !sema_inline_is_alphanumeric(code) && code != 95 -> return name.copy()
    }
    member
}

// The inline module path of a lifted member function (`__jet_db_dinner_ddeep`
// -> `db.inner`); "" for any other name.
sema_inline_member_module: fn(name: String) -> String Never! {
    if sema_inline_member_source_name(name) == name -> return ""
    decoded: sema_inline_decode_generated_suffix(String.from_bytes(name.bytes()[6..<name.bytes().len()]) ?? "") ?? return ""
    segments := decoded.split(".").to_list()
    _ := segments.pop()
    segments.join(".")
}

sema_inline_trim_leading_underscores: fn(name: String) -> String Never! {
    bytes: name.bytes()
    start := 0
    loop start < bytes.len() && (Int{bytes[start]}) == 95 -> start += 1
    String.from_bytes(bytes[start..<bytes.len()]) ?? name.copy()
}

sema_inline_type_prefix: fn(alias: String) -> String {
    visibility: if alias.starts_with("_") -> "_" else -> ""
    body: if alias.starts_with("_") -> String.from_bytes(alias.bytes()[1..<alias.bytes().len()]) ?? alias.copy() else -> alias.copy()
    encoded := ""
    loop segment in body.split("_") {
        cased: sema_casing_pascal_words(segment)
        encoded = "{encoded}{unicode.scalars(cased).len()}{cased}"
    }
    "{visibility}M{encoded}"
}

sema_inline_type_name: fn(alias: String, name: String) -> String {
    "{sema_inline_type_prefix(alias)}{sema_inline_trim_leading_underscores(name)}"
}

// Rust `inline_type_alias`.
sema_inline_type_alias: fn(source_path: String) -> String Never! {
    source_path.split(".").to_list().join("_")
}

sema_inline_mapped_name: fn(rewrite: SemaInlineRewrite, name: String) -> String Never! {
    if rewrite.types.get(name) == .Val(.Named(mapped)) -> return mapped
    name.copy()
}

sema_inline_mapped_names: fn(rewrite: SemaInlineRewrite, names: [NamedSpan]) -> [NamedSpan] Never! {
    mapped := [NamedSpan]{}
    loop entry in names {
        mapped.push(NamedSpan{name: sema_inline_mapped_name(rewrite, entry.name), span: entry.span})
    }
    mapped
}

// A program a `module` lowering leaves complete: nothing but nested modules
// that are themselves lowered, and marker declarations, which stay in the
// body as their home (MarkerModules resolves `#Alias.Module.Marker` there).
sema_inline_module_lowered: fn(definition: CodeModule) -> Bool Never! {
    body: definition.body ?? return false
    loop item in body {
        if item == .CodeModule(child) {
            if !sema_inline_module_lowered(child) -> return false
            next
        }
        if item == .MarkerDecl(_) -> next
        return false
    }
    true
}

// Every inline module with a body lowers. A Core member it binds (`use
// core.[math.abs]`, `exported: core.math.abs`) and a Core module it
// binds in a member list (`use core.[math]`) read through the file-level Core
// alias sema_inline_core_imports adds; its own module or file import (`use
// rules: second`) reads through the generated file-level alias
// sema_inline_alias_imports adds, which registration binds to the module the
// import's scoped edge names. An inline body sees the file's imports overlaid
// with its own.

// The Core module path a member-list item of `declaration` names (`math` in
// `use core.[math]`, `data.json` in `use core.[data.json]`), or None when the
// declaration is no Core member list or the item is no Core module.
sema_inline_core_module_item: fn(declaration: ImportDecl, item: ImportedItem) -> String? Never! {
    if declaration.kind == .Unqualified(module_alias, _, _, _, _) {
        if module_alias != "core" && !module_alias.starts_with("core.") -> return None
        path: "{module_alias}.{item.original}"
        if core_module_export(path) != None -> return Val(path)
    }
    None
}

// Whether a lowered module's own `declaration` is read through a generated
// file-level alias: a module or file import, except a Core member (read
// through its Core alias) and a Core module the file binds the same way.
sema_inline_module_aliased: fn(declaration: ImportDecl, file_imports: [ImportDecl]) -> Bool Never! {
    if declaration.kind == .File(_, _) -> return true
    if declaration.kind == .Module(name, _) {
        if sema_inline_core_member(name) != None -> return false
        if name == "core" || name.starts_with("core.") {
            return !sema_inline_file_binds_module(file_imports, declaration.alias, name)
        }
        return true
    }
    false
}

// The generated file-level alias a lifted body of module `path` reads that
// module's own import `alias` through.
sema_inline_module_alias: fn(path: String, alias: String) -> String Never! {
    sema_inline_generated_path("import.{path}.{alias}")
}

// Whether `declaration` is a generated alias sema_inline_alias_imports added;
// registration binds it through the import edge of the declaration it copies.
sema_inline_module_alias_import: fn(declaration: ImportDecl) -> Bool Never! {
    declaration.alias.starts_with(sema_inline_generated_path("import."))
}

// The aliases the lifted bodies of `definition` (module `path`) read: its own
// aliased imports, and the Core alias of each Core module its member lists
// bind, over the `inherited` ones of its enclosing modules.
sema_inline_module_aliases: fn(definition: CodeModule, path: String, file_imports: [ImportDecl], inherited: [String:String]) -> [String:String] Never! {
    aliases := inherited.copy()
    loop declaration in definition.imports {
        if sema_inline_module_aliased(declaration, file_imports) {
            aliases[declaration.alias] = sema_inline_module_alias(path, declaration.alias)
        }
        if declaration.kind == .Unqualified(_, _, items, _, _) {
            loop item in items {
                module_path: sema_inline_core_module_item(declaration, item) ?? next
                aliases[sema_registration_import_local(item)] = sema_inline_core_alias(module_path)
            }
        }
    }
    aliases
}

// `alias.Name` over a module's own import alias, as its generated alias reads it.
sema_inline_alias_name: fn(rewrite: SemaInlineRewrite, name: String) -> String? Never! {
    segments: name.split(".").to_list()
    if segments.len() < 2 || sema_inline_is_local(rewrite, segments[0]) -> return None
    generated: rewrite.aliases.get(segments[0]) ?? return None
    rest: segments.slice(1, segments.len()).join(".")
    Val("{generated}.{rest}")
}

// A Core member path (`core.math.abs`) as the qualified target lifted members
// read: the member on its Core module's file-level alias. A Core module itself
// (`core.math`) is no member.
sema_inline_core_member: fn(path: String) -> SemaInlineTarget? Never! {
    if !path.starts_with("core.") || core_module_export(path) != None -> return None
    segments: path.split(".").to_list()
    module_path := segments[0].copy()
    loop index in 1..<segments.len() - 1 -> module_path = "{module_path}.{segments[index]}"
    if core_module_export(module_path) == None -> return None
    Val(SemaInlineTarget{module_alias: sema_inline_core_alias(module_path), member: segments[segments.len() - 1].copy(), qualified: true})
}

// The file-level alias of a Core module that lowered members read.
sema_inline_core_alias: fn(module_path: String) -> String Never! {
    sema_inline_generated_path("use.{module_path}")
}

// Whether `declaration` is the file-level Core alias sema_inline_core_imports
// added for a lowered member import; registration binds it to its Core module.
sema_inline_core_alias_import: fn(declaration: ImportDecl) -> Bool Never! {
    if declaration.kind == .Module(name, _) {
        return declaration.alias == sema_inline_core_alias(name)
    }
    false
}

// The file-level Core imports the inline modules of `items` (nested ones
// included) read, one per Core module: the module of each Core member they
// bind, and each Core module their member lists bind.
sema_inline_core_imports: fn(items: [Item], file_imports: [ImportDecl], imports: &[ImportDecl]) Never! {
    loop item in items {
        if item == .CodeModule(definition) {
            body: definition.body ?? next
            loop declaration in definition.imports {
                module_paths := [String]{}
                if declaration.kind == {
                    .Unqualified(module_alias, _, members, _, _) -> {
                        if module_alias == "core" || module_alias.starts_with("core.") {
                            loop member in members {
                                if sema_inline_core_module_item(declaration, member) == .Val(module_path) {
                                    module_paths.push(module_path)
                                    next
                                }
                                path: "{module_alias}.{member.original}"
                                target: sema_inline_core_member(path) ?? next
                                module_paths.push(String.from_bytes(path.bytes()[0..<path.bytes().len() - target.member.bytes().len() - 1]) ?? next)
                            }
                        }
                    }
                    .Module(name, _) -> {
                        if !sema_inline_file_binds_module(file_imports, declaration.alias, name) {
                            if sema_inline_core_member(name) == .Val(target) {
                                module_paths.push(String.from_bytes(name.bytes()[0..<name.bytes().len() - target.member.bytes().len() - 1]) ?? next)
                            }
                        }
                    }
                    .File(_, _) -> {}
                }
                loop module_path in module_paths {
                    alias: sema_inline_core_alias(module_path)
                    bound := false
                    loop existing in imports {
                        if existing.alias == alias -> bound = true
                    }
                    if bound -> next
                    imports.push(ImportDecl{kind: ImportKind.Module{name: module_path, span: declaration.span}, alias: alias, alias_span: declaration.alias_span, span: declaration.span, item_spans: [Span]{}, local_spans: [Span]{}, is_pub: false, is_package_pub: false, inline_version: None})
                }
            }
            sema_inline_core_imports(body, file_imports, imports)
        }
    }
}

sema_inline_file_binds_module: fn(file_imports: [ImportDecl], alias: String, name: String) -> Bool Never! {
    loop declaration in file_imports {
        if declaration.alias != alias -> next
        if declaration.kind == .Module(bound, _) -> return bound == name
        return false
    }
    false
}

// The file-level aliases the lowered modules of `items` (nested ones
// included; `parent` is the enclosing module's path, "" at file level) read
// their own module and file imports through: each a copy of the import under
// its generated alias, sharing the scoped declaration's span, so registration
// binds it to the module that import's edge names.
sema_inline_alias_imports: fn(items: [Item], parent: String, file_imports: [ImportDecl], imports: &[ImportDecl]) Never! {
    loop item in items {
        if item == .CodeModule(definition) {
            body: definition.body ?? next
            path: if parent == "" -> definition.name.copy() else -> "{parent}.{definition.name}"
            loop declaration in definition.imports {
                if !sema_inline_module_aliased(declaration, file_imports) -> next
                lifted := declaration.copy()
                lifted.alias = sema_inline_module_alias(path, declaration.alias)
                lifted.is_pub = false
                lifted.is_package_pub = false
                imports.push(lifted)
            }
            sema_inline_alias_imports(body, path, file_imports, imports)
        }
    }
}

// ---------------------------------------------------------------------------
// Rewriting (Rust `substitute_expr` / `substitute_stmts`,
// `rewrite_inline_calls_expr` and the checker's inline-module call routes).

sema_inline_rewrite_empty: fn() -> SemaInlineRewrite Never! {
    SemaInlineRewrite{types: [String:Type]{}, values: [String:Expr]{}, sibling_module: "", siblings: [String:Bool]{}, modules: [SemaInlineModuleSurface]{}, imported: [String:SemaInlineFunctionBinding]{}, qualified: [String:SemaInlineTarget]{}, aliases: [String:String]{}, locals: [String]{}, variadic: [String:Int]{}, variadic_arities: [String:[Int]]{}, diagnostics: [Diagnostic]{}, private_types: [String:Span]{}}
}

sema_inline_is_local: fn(rewrite: SemaInlineRewrite, name: String) -> Bool Never! {
    loop local in rewrite.locals {
        if local == name -> return true
    }
    false
}

// `alias.Type` as a value's base (`internal.Failure.Missing`) names the
// hoisted member type, as a type position spelling `alias.Type` does, and
// is refused as it is outside the module when the type is `priv`.
sema_inline_type_path: fn(rewrite: &SemaInlineRewrite, base: Expr) -> Expr? Never! {
    if base == .Field(inner, member, span, node) && inner == .Ident(alias, _, _) {
        if sema_inline_is_local(rewrite, alias) -> return None
        if rewrite.types.get("{alias}.{member}") == .Val(.Named(name)) {
            sema_inline_private_type(rewrite, "{alias}.{member}", span)
            return Val(Expr.Ident{name: name, span: span, id: node})
        }
    }
    None
}

sema_inline_surface: fn(rewrite: SemaInlineRewrite, name: String) -> SemaInlineModuleSurface? Never! {
    if sema_inline_is_local(rewrite, name) -> return None
    loop surface in rewrite.modules {
        if surface.name == name -> return Val(surface)
    }
    None
}

sema_inline_restore_locals: fn(rewrite: &SemaInlineRewrite, saved: Int) Never! {
    loop rewrite.locals.len() > saved -> _ := rewrite.locals.pop()
}

sema_inline_rewrite_type: fn(rewrite: SemaInlineRewrite, ty: Type) -> Type Never! {
    if ty == {
        .Named(name) -> {
            if rewrite.types.get(name) == .Val(mapped) -> return mapped
            if rewrite.qualified.get(name) == .Val(target) {
                return Type.Named{name: "{target.module_alias}.{target.member}"}
            }
            if sema_inline_alias_name(rewrite, name) == .Val(renamed) {
                return Type.Named{name: renamed}
            }
            // copy: the rewrite walks the module program by borrowed payload views (Jet has no
            // consuming match), so an unchanged type is copied into the rebuilt program, while the
            // caller's program keeps the original until it is replaced.
            ty.copy()
        }
        .List(inner) -> Type.List{element: sema_inline_rewrite_type(rewrite, inner)}
        .Shared(inner) -> Type.Shared{inner: sema_inline_rewrite_type(rewrite, inner)}
        .Option(inner) -> Type.Option{inner: sema_inline_rewrite_type(rewrite, inner)}
        .FixedList(inner, len) -> Type.FixedList{elem: sema_inline_rewrite_type(rewrite, inner), len: sema_inline_rewrite_measure(rewrite, len)}
        // A user tag declared in the module body renames with the module's
        // other nominals (`#Marked T` -> `#complete_use_Marked T`).
        .Tagged(marker, inner) -> Type.Tagged{marker: sema_inline_rewrite_tag_marker(rewrite, marker), inner: sema_inline_rewrite_type(rewrite, inner)}
        // copy: `key_span` is a payload of read parameter `ty`, which keeps the original; field `key_span` of the new Type.Map owns this one
        .Map(key, key_span, value) -> Type.Map{key: sema_inline_rewrite_type(rewrite, key), key_span: key_span.copy(), value: sema_inline_rewrite_type(rewrite, value)}
        .Result(ok, err) -> Type.Result{ok: sema_inline_rewrite_type(rewrite, ok), err: sema_inline_rewrite_type(rewrite, err)}
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            mapped := [Type]{}
            loop param in params -> mapped.push(sema_inline_rewrite_type(rewrite, param))
            Type.Fn{params: mapped, ret: ret.map(fn(value) { sema_inline_rewrite_type(rewrite, value) }), effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
        }
        // A generic member's head renames like a plain member
        // (`Holder<Int>` -> `M5PlainHolder<Int>`).
        .Apply(name, args) -> {
            head := name
            if rewrite.types.get(name) == .Val(.Named(mapped)) -> head = mapped else if rewrite.qualified.get(name) == .Val(target) {
                head = "{target.module_alias}.{target.member}"
            } else if sema_inline_alias_name(rewrite, name) == .Val(renamed) { head = renamed }
            Type.Apply{name: head, args: sema_inline_rewrite_types(rewrite, args)}
        }
        .Tuple(fields) -> {
            mapped := [TypeTupleField]{}
            loop field in fields {
                mapped.push(TypeTupleField{name: field.name, ty: sema_inline_rewrite_type(rewrite, field.ty)})
            }
            Type.Tuple{fields: mapped}
        }
        .Union(members) -> Type.Union{members: sema_inline_rewrite_types(rewrite, members)}
        .Case(name, payload) -> Type.Case{name: name, payload: sema_inline_rewrite_type(rewrite, payload)}
        // copy: `dimension` is a payload of read parameter `ty`, which keeps the original; field `dimension` of the new Type.Quantity owns this one
        .Quantity(base, dimension) -> Type.Quantity{base: sema_inline_rewrite_type(rewrite, base), dimension: dimension.copy()}
        .InlineRange(base, lo, hi) -> Type.InlineRange{base: sema_inline_rewrite_type(rewrite, base), lo: lo, hi: hi}
        // copy: the rewrite walks the module program by borrowed payload views (Jet has no
        // consuming match), so an unchanged type kind is copied into the rebuilt program, while the
        // caller's program keeps the original.
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> ty.copy()
    }
}

sema_inline_rewrite_tag_marker: fn(rewrite: SemaInlineRewrite, marker: TagMarker) -> TagMarker Never! {
    if marker == {
        .User(name) -> {
            if rewrite.types.get(name) == .Val(.Named(mapped)) {
                return TagMarker.User{name: mapped}
            }
            // copy: `name` is a payload of read parameter `marker`, which keeps the original
            TagMarker.User{name: name.copy()}
        }
        // copy: an internal tag never renames; read parameter `marker` keeps the original
        .Internal(_) -> marker.copy()
    }
}

// Rust `Measure.resolve_symbols`: a fixed length named by an `Int` module
// value parameter becomes that length.
sema_inline_rewrite_measure: fn(rewrite: SemaInlineRewrite, measure: Measure) -> Measure Never! {
    if measure == {
        .Symbol(kind, name) -> {
            if rewrite.values.get(name) == .Val(.Int(value, _, _, _, _)) {
                if value >= 0 -> return Measure.Literal{kind: kind, value: value}
            }
            // copy: the rewrite walks the module program by borrowed payload views (Jet has no
            // consuming match), so an unchanged measure is copied into the rebuilt program, while
            // the caller's program keeps the original.
            measure.copy()
        }
        .Combined(kind, rule, left, right) -> {
            resolved_left: sema_inline_rewrite_measure(rewrite, left)
            resolved_right: sema_inline_rewrite_measure(rewrite, right)
            if rule != MeasureRule.Match {
                if measure_literal_value(resolved_left) == .Val(left_value) {
                    if measure_literal_value(resolved_right) == .Val(right_value) {
                        folded: if rule == MeasureRule.Add -> left_value + right_value else -> left_value * right_value
                        return Measure.Literal{kind: measure_kind(resolved_left), value: folded}
                    }
                }
            }
            Measure.Combined{kind: kind, rule: rule, left: resolved_left, right: resolved_right}
        }
        // copy: the rewrite walks the module program by borrowed payload views (Jet has no
        // consuming match), so an unchanged measure kind is copied into the rebuilt program, while
        // the caller's program keeps the original.
        .Literal(_, _) | .SignedLiteral(_, _) -> measure.copy()
    }
}

// A substituted compile-time value takes the span of the name it replaces
// (Rust `ct_value_expr`).
sema_inline_value_at: fn(value: Expr, span: Span) -> Expr Never! {
    if value == {
        .Int(number, _, _, _, node) -> Expr.Int{value: number, span: span, width: None, raw: None, id: node}
        .Bool(flag, _, node) -> Expr.Bool{value: flag, span: span, id: node}
        .Char(text, _, node) -> Expr.Char{value: text, span: span, id: node}
        .Str(parts, _, node) -> Expr.Str{parts: parts, span: span, id: node}
        .Ident(name, _, node) -> Expr.Ident{name: name, span: span, id: node}
        .Field(base, member, _, node) -> Expr.Field{base: sema_inline_value_at(base, span), member: member, span: span, id: node}
        .EnumLit(type_name, variant, _, args, leading_dot, _, node) -> Expr.EnumLit{type_name: type_name, variant: variant, variant_span: None, args: args, leading_dot: leading_dot, span: span, id: node}
        // copy: the re-spanned value is a new owned Expr. Other kinds keep `value`, a module
        // constant's expression that the constant table keeps for every other use site.
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> value.copy()
    }
}

// `limits.f(...)`: a call through a module's own `use limits.[f]`.
sema_inline_qualified_call: fn(rewrite: &SemaInlineRewrite, target: SemaInlineTarget, span: Span, type_args: [Type], args: [CallArg]) -> Expr Never! {
    Expr.MethodCall{receiver: Expr.Ident{name: target.module_alias, span: span, id: AST_NODE_GENERATED}, method: target.member, method_span: span, owner_type_args: [Type]{}, type_args: sema_inline_rewrite_types(rewrite, type_args), args: sema_inline_rewrite_call_args(rewrite, args), id: AST_NODE_GENERATED}
}

sema_inline_rewrite_types: fn(rewrite: SemaInlineRewrite, types: [Type]) -> [Type] Never! {
    mapped := [Type]{}
    loop ty in types -> mapped.push(sema_inline_rewrite_type(rewrite, ty))
    mapped
}

sema_inline_rewrite_optional_type: fn(rewrite: SemaInlineRewrite, ty: Type?) -> Type? Never! {
    if ty == {
        .Val(value) -> Val(sema_inline_rewrite_type(rewrite, value))
        .None -> None
    }
}

sema_inline_rewrite_exprs: fn(rewrite: &SemaInlineRewrite, expressions: [Expr]) -> [Expr] Never! {
    mapped := [Expr]{}
    loop expression in expressions -> mapped.push(sema_inline_rewrite_expr(rewrite, expression))
    mapped
}

sema_inline_rewrite_optional_expr: fn(rewrite: &SemaInlineRewrite, expression: Expr?) -> Expr? Never! {
    if expression == {
        .Val(value) -> Val(sema_inline_rewrite_expr(rewrite, value))
        .None -> None
    }
}

sema_inline_rewrite_call_args: fn(rewrite: &SemaInlineRewrite, args: [CallArg]) -> [CallArg] Never! {
    mapped := [CallArg]{}
    loop arg in args {
        updated := arg.copy()
        updated.expr = sema_inline_rewrite_expr(rewrite, arg.expr)
        mapped.push(updated)
    }
    mapped
}

sema_inline_rewrite_fields: fn(rewrite: &SemaInlineRewrite, fields: [ExprField]) -> [ExprField] Never! {
    mapped := [ExprField]{}
    loop field in fields {
        mapped.push(ExprField{name: field.name, name_span: field.name_span, value: sema_inline_rewrite_expr(rewrite, field.value)})
    }
    mapped
}

sema_inline_rewrite_pairs: fn(rewrite: &SemaInlineRewrite, entries: [ExprPair]) -> [ExprPair] Never! {
    mapped := [ExprPair]{}
    loop entry in entries {
        mapped.push(ExprPair{key: sema_inline_rewrite_expr(rewrite, entry.key), value: sema_inline_rewrite_expr(rewrite, entry.value)})
    }
    mapped
}

sema_inline_rewrite_str_parts: fn(rewrite: &SemaInlineRewrite, parts: [StrPart]) -> [StrPart] Never! {
    mapped := [StrPart]{}
    loop part in parts {
        if part == {
            .Interp(expression, format) -> {
                mapped.push(StrPart.Interp{expr: sema_inline_rewrite_expr(rewrite, expression), format: format})
            }
            .Lit(_) | .Byte(_) -> mapped.push(part.copy())
        }
    }
    mapped
}

sema_inline_rewrite_or_fallback: fn(rewrite: &SemaInlineRewrite, fallback: OrFallback) -> OrFallback Never! {
    if fallback == {
        .Value(value) -> OrFallback.Value{value: sema_inline_rewrite_expr(rewrite, value)}
        .Block(body, value, span) -> {
            saved: rewrite.locals.len()
            mapped_body: sema_inline_rewrite_stmts(rewrite, body)
            mapped_value: sema_inline_rewrite_optional_expr(rewrite, value)
            sema_inline_restore_locals(rewrite, saved)
            OrFallback.Block{body: mapped_body, value: mapped_value, span: span}
        }
        .Return(value, span) -> OrFallback.Return{value: sema_inline_rewrite_optional_expr(rewrite, value), span: span}
        .Panic(name_span, args) -> OrFallback.Panic{name_span: name_span, args: sema_inline_rewrite_call_args(rewrite, args)}
        // copy: the rewrite walks the module program by borrowed payload views (Jet has no
        // consuming match), so an unchanged fallback is copied into the rebuilt program, while the
        // caller's program keeps the original.
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> fallback.copy()
    }
}

sema_inline_rewrite_lambda: fn(rewrite: &SemaInlineRewrite, lambda: Lambda) -> Lambda Never! {
    updated := lambda
    saved: rewrite.locals.len()
    params := [LambdaParam]{}
    loop param in lambda.params {
        mapped := param.copy()
        mapped.ty = sema_inline_rewrite_optional_type(rewrite, param.ty)
        params.push(mapped)
        rewrite.locals.push(param.name)
    }
    updated.params = params
    updated.result = sema_inline_rewrite_optional_type(rewrite, lambda.result)
    updated.body = if lambda.body == {
        .Expr(value) -> LambdaBody.Expr{value: sema_inline_rewrite_expr(rewrite, value)}
        .Block(body) -> LambdaBody.Block{body: sema_inline_rewrite_stmts(rewrite, body)}
    }
    sema_inline_restore_locals(rewrite, saved)
    updated
}

sema_inline_rewrite_typed_body: fn(rewrite: &SemaInlineRewrite, body: TypedLitBody) -> TypedLitBody Never! {
    if body == {
        .Fields(fields) -> return TypedLitBody.Fields{fields: sema_inline_rewrite_fields(rewrite, fields)}
        .Elements(elements) -> return TypedLitBody.Elements{elements: sema_inline_rewrite_exprs(rewrite, elements)}
        .Entries(entries) -> return TypedLitBody.Entries{entries: sema_inline_rewrite_pairs(rewrite, entries)}
        .Value(value) -> return TypedLitBody.Value{value: sema_inline_rewrite_expr(rewrite, value)}
        .ByteText(_) | .Empty -> {}
    }
    // copy: the rewrite walks the module program by borrowed payload views (Jet has no consuming
    // match), so an unchanged typed body is copied into the rebuilt program, while the caller's
    // program keeps the original.
    body.copy()
}

sema_inline_rewrite_enum_args: fn(rewrite: &SemaInlineRewrite, args: [EnumLitArg]) -> [EnumLitArg] Never! {
    mapped := [EnumLitArg]{}
    loop arg in args {
        if arg == {
            .Positional(value) -> {
                mapped.push(EnumLitArg.Positional{value: sema_inline_rewrite_expr(rewrite, value)})
            }
            .Named(label, value) -> {
                mapped.push(EnumLitArg.Named{label: label, expr: sema_inline_rewrite_expr(rewrite, value)})
            }
        }
    }
    mapped
}

// `bank.f(...)` from anywhere in the file (Rust `infer_code_module_call`):
// a re-export calls its owner, a member function its member
// identity; any other name is E0608. The file is the enclosing module, so it
// reaches the members of its `priv module`s too.
sema_inline_rewrite_module_call: fn(rewrite: &SemaInlineRewrite, surface: SemaInlineModuleSurface, alias_span: Span, method: String, method_span: Span, type_args: [Type], args: [CallArg]) -> Expr? Never! {
    if surface.reexports.get(method) == .Val(target) {
        if target.qualified {
            return Val(sema_inline_qualified_call(rewrite, target, method_span, type_args, args))
        }
        forwarded: Call{name: sema_inline_member_name(target.module_alias, target.member), name_span: method_span, type_args: sema_inline_rewrite_types(rewrite, type_args), args: sema_inline_rewrite_call_args(rewrite, args)}
        return Val(Expr.Call{call: forwarded, id: AST_NODE_GENERATED})
    }
    if sema_inline_private_member(rewrite, surface, method, method_span) == .Val(diagnostic) {
        rewrite.diagnostics.push(diagnostic)
    }
    if surface.functions.get(method) == None {
        if surface.broken.get(method) == None {
            rewrite.diagnostics.push(sema_error("E0608", alias_span, "`{method}` is not defined in module `{surface.path}`", "check the module body for the function you're calling", "make sure the function name is spelled correctly"))
        }
        return None
    }
    call: Call{name: sema_inline_member_name(surface.path, method), name_span: method_span, type_args: sema_inline_rewrite_types(rewrite, type_args), args: sema_inline_rewrite_call_args(rewrite, args)}
    Val(Expr.Call{call: call, id: AST_NODE_GENERATED})
}

// `bank.open` or `math.inner.RATE` read as a value, not called: a member
// function or constant names its member identity, a re-export
// names its owner, and a field of the module's Module record (`bank.category`)
// reads its record. Any other member is E0608, and the read is left as
// written. A member that is itself a module reads as its record. None when
// `base` names no inline module, or the member module has no record.
sema_inline_rewrite_member_value: fn(rewrite: &SemaInlineRewrite, base: Expr, member: String, span: Span, node: Int) -> Expr? Never! {
    segments := [NamedSpan]{}
    if !sema_inline_receiver_path(base, segments) || sema_inline_is_local(rewrite, segments[0].name) {
        return None
    }
    path: (loop segment in segments -> segment.name).join(".")
    surface: sema_inline_surface(rewrite, path) ?? return None
    if sema_inline_surface(rewrite, "{path}.{member}") == .Val(nested) {
        if nested.constants.get(SEMA_MODULE_META) == None -> return None
        return Val(Expr.Ident{name: sema_inline_member_name(nested.path, SEMA_MODULE_META), span: span, id: node})
    }
    if sema_inline_private_step(rewrite, segments) == .Val(diagnostic) {
        rewrite.diagnostics.push(diagnostic)
    }
    if surface.reexports.get(member) == .Val(target) {
        if target.qualified {
            return Val(Expr.Field{base: Expr.Ident{name: target.module_alias, span: span, id: AST_NODE_GENERATED}, member: target.member, span: span, id: node})
        }
        return Val(Expr.Ident{name: sema_inline_member_name(target.module_alias, target.member), span: span, id: node})
    }
    if sema_inline_private_member(rewrite, surface, member, span) == .Val(diagnostic) {
        rewrite.diagnostics.push(diagnostic)
    }
    if surface.functions.get(member) == None && surface.constants.get(member) == None && surface.constants.get(SEMA_MODULE_META) != None {
        return Val(Expr.Field{base: Expr.Ident{name: sema_inline_member_name(surface.path, SEMA_MODULE_META), span: span, id: AST_NODE_GENERATED}, member: member, span: span, id: node})
    }
    if surface.functions.get(member) == None && surface.constants.get(member) == None {
        if surface.broken.get(member) == None {
            rewrite.diagnostics.push(sema_error("E0608", segments[segments.len() - 1].span, "`{member}` is not defined in module `{surface.path}`", "check the module body for the function or constant you're reading", "make sure the member name is spelled correctly"))
        }
        // copy: the rewrite walks the module program by borrowed payload views (Jet has no
        // consuming match), so the unresolved read is copied into the rebuilt program as written.
        return Val(Expr.Field{base: base.copy(), member: member, span: span, id: node})
    }
    Val(Expr.Ident{name: sema_inline_member_name(surface.path, member), span: span, id: node})
}

// A `priv` member of an inline module is usable only inside that
// module and its children (E0605, naming the member's `priv` declaration).
sema_inline_private_member: fn(rewrite: SemaInlineRewrite, surface: SemaInlineModuleSurface, member: String, span: Span) -> Diagnostic? Never! {
    declared: surface.private_members.get(member) ?? return None
    if sema_inline_inside(rewrite, surface.path) -> return None
    diagnostic: sema_registration_private_member_error(member, surface.path, span)
    Val(diagnostic_with_label(diagnostic, declared, "`{member}` is declared `priv` here"))
}

// Whether the body being rewritten is module `path` or one nested in it.
sema_inline_inside: fn(rewrite: SemaInlineRewrite, path: String) -> Bool Never! {
    rewrite.sibling_module == path || rewrite.sibling_module.starts_with("{path}.")
}

// E0605 for each `priv` member type of an inline module that `ty`, written
// at `span`, names outside that module and its children: naming it is using
// it, as calling a `priv` member function is.
sema_inline_private_types: fn(rewrite: &SemaInlineRewrite, ty: Type, span: Span) Never! {
    if rewrite.private_types.len() == 0 {
        return
    }
    if ty == {
        .Named(name) -> { sema_inline_private_type(rewrite, name, span) }
        .Apply(name, args) -> {
            sema_inline_private_type(rewrite, name, span)
            loop arg in args -> sema_inline_private_types(rewrite, arg, span)
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .FixedList(inner, _) | .Case(_, inner) | .Quantity(inner, _) | .InlineRange(inner, _, _) -> {
            sema_inline_private_types(rewrite, inner, span)
        }
        .Map(key, _, value) -> {
            sema_inline_private_types(rewrite, key, span)
            sema_inline_private_types(rewrite, value, span)
        }
        .Result(ok, err) -> {
            sema_inline_private_types(rewrite, ok, span)
            sema_inline_private_types(rewrite, err, span)
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params -> sema_inline_private_types(rewrite, param, span)
            if ret == .Val(value) -> sema_inline_private_types(rewrite, value, span)
        }
        .Tuple(fields) -> {
            loop field in fields -> sema_inline_private_types(rewrite, field.ty, span)
        }
        .Union(members) -> {
            loop member in members -> sema_inline_private_types(rewrite, member, span)
        }
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> {}
    }
}

// E0605 when `name`, written at `span`, is a `priv` member type
// (`lib.Secret`) named outside its module and that module's children.
sema_inline_private_type: fn(rewrite: &SemaInlineRewrite, name: String, span: Span) Never! {
    declared: rewrite.private_types.get(name) ?? return
    owner: name.cut_last(".") ?? return
    if sema_inline_inside(rewrite, owner.before) {
        return
    }
    diagnostic: sema_registration_private_member_error(owner.after, owner.before, span)
    rewrite.diagnostics.push(diagnostic_with_label(diagnostic, declared, "`{owner.after}` is declared `priv` here"))
}

// The functions and constants `body` declares onto `surface`. A member
// written `priv` is private to the module unless the whole module is plain
// `priv` (`hides_members`), whose narrowing already made every member so.
sema_inline_surface_members: fn(surface: &SemaInlineModuleSurface, body: [Item], hides_members: Bool) Never! {
    loop inner in body {
        if inner == {
            .Func(function) -> {
                surface.functions[function.name] = true
                if !hides_members && !function.is_pub && !function.is_package_pub {
                    surface.private_members[function.name] = function.name_span
                }
            }
            .Const(constant) -> {
                surface.constants[constant.name] = true
                if !hides_members && !constant.is_pub && !constant.is_package_pub {
                    surface.private_members[constant.name] = constant.name_span
                }
            }
            .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

// `a.b.c` as a call receiver: each identifier segment with its span, false
// for any other receiver.
sema_inline_receiver_path: fn(receiver: Expr, segments: &[NamedSpan]) -> Bool Never! {
    if receiver == {
        .Ident(name, span, _) -> {
            segments.push(NamedSpan{name: name, span: span})
            return true
        }
        .Field(base, member, span, _) -> {
            if !sema_inline_receiver_path(base, segments) -> return false
            segments.push(NamedSpan{name: member, span: span})
            return true
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}

// A nested `priv module` on the path `segments` names is usable only inside
// the module that encloses it: the body being rewritten (`sibling_module`,
// "" for the file) must be that module or one nested in it (E0609).
sema_inline_private_step: fn(rewrite: SemaInlineRewrite, segments: [NamedSpan]) -> Diagnostic? Never! {
    prefix := segments[0].name.copy()
    loop index in 1..<segments.len() {
        prefix = "{prefix}.{segments[index].name}"
        surface: sema_inline_surface(rewrite, prefix) ?? return None
        owner: surface.private_to ?? next
        if sema_inline_inside(rewrite, owner) -> next
        return Val(sema_error("E0609", segments[index].span, "`{segments[index].name}` is private in module `{owner}`", "a `priv module` is usable only by its enclosing module", "call it from inside `{owner}`, or remove `priv` from `{segments[index].name}: module`"))
    }
    None
}

sema_inline_rewrite_expr: fn(rewrite: &SemaInlineRewrite, expression: Expr) -> Expr Never! {
    if expression == {
        .Str(parts, span, node) -> return Expr.Str{parts: sema_inline_rewrite_str_parts(rewrite, parts), span: span, id: node}
        .ListLit(elements, span, node) -> return Expr.ListLit{elements: sema_inline_rewrite_exprs(rewrite, elements), span: span, id: node}
        .MemberSpread(base, members, span, node) -> return Expr.MemberSpread{base: sema_inline_rewrite_expr(rewrite, base), members: members, span: span, id: node}
        .Spread(value, span, node) -> return Expr.Spread{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        .MapLit(entries, span, node) -> return Expr.MapLit{entries: sema_inline_rewrite_pairs(rewrite, entries), span: span, id: node}
        // copy: `kind` is a payload of read parameter `expression`, which keeps the original; field `kind` of the new Expr.Index owns this one
        .Index(base, index, span, kind, node) -> return Expr.Index{base: sema_inline_rewrite_expr(rewrite, base), index: sema_inline_rewrite_expr(rewrite, index), span: span, kind: kind.copy(), id: node}
        .Slice(base, start, end, range, span, node) -> return Expr.Slice{base: sema_inline_rewrite_expr(rewrite, base), start: sema_inline_rewrite_expr(rewrite, start), end: sema_inline_rewrite_expr(rewrite, end), range: sema_inline_rewrite_optional_expr(rewrite, range), span: span, id: node}
        .Range(start, end, exclusive, span, node) -> return Expr.Range{start: sema_inline_rewrite_expr(rewrite, start), end: sema_inline_rewrite_expr(rewrite, end), exclusive: exclusive, span: span, id: node}
        .Ident(name, span, node) -> {
            if !sema_inline_is_local(rewrite, name) && rewrite.values.get(name) == .Val(value) {
                return sema_inline_value_at(value, span)
            }
            // A sibling function read as a value names its member identity.
            // A local or parameter of the same name shadows the sibling.
            if !sema_inline_is_local(rewrite, name) && rewrite.siblings.get(name) != None {
                return Expr.Ident{name: sema_inline_member_name(rewrite.sibling_module, name), span: span, id: node}
            }
            if !sema_inline_is_local(rewrite, name) {
                if rewrite.qualified.get(name) == .Val(target) {
                    return Expr.Field{base: Expr.Ident{name: target.module_alias, span: span, id: node}, member: target.member, span: span, id: AST_NODE_GENERATED}
                }
                if rewrite.aliases.get(name) == .Val(generated) {
                    return Expr.Ident{name: generated, span: span, id: node}
                }
                // A module named as a value is its Module record.
                if sema_inline_surface(rewrite, name) == .Val(surface) {
                    if surface.constants.get(SEMA_MODULE_META) != None {
                        return Expr.Ident{name: sema_inline_member_name(surface.path, SEMA_MODULE_META), span: span, id: node}
                    }
                    rewrite.diagnostics.push(sema_unknown_name(name, span))
                }
            }
            // copy: the rewrite walks the module program by borrowed payload views (Jet has no
            // consuming match), so an expression the rewrite leaves alone is copied into the
            // rebuilt program, while the caller's program keeps the original.
            return expression.copy()
        }
        .ComptimeName(name, span, _, _) -> {
            if rewrite.values.get(name) == .Val(value) -> return sema_inline_value_at(value, span)
            // copy: the rewrite walks the module program by borrowed payload views (Jet has no
            // consuming match), so an expression the rewrite leaves alone is copied into the
            // rebuilt program, while the caller's program keeps the original.
            return expression.copy()
        }
        .Call(call, node) -> {
            if !sema_inline_is_local(rewrite, call.name) && rewrite.siblings.get(call.name) == None {
                if rewrite.qualified.get(call.name) == .Val(target) {
                    return sema_inline_qualified_call(rewrite, target, call.name_span, call.type_args, call.args)
                }
            }
            updated := call
            if {
                rewrite.siblings.get(call.name) != None -> {
                    updated.name = sema_inline_member_name(rewrite.sibling_module, call.name)
                }
                !sema_inline_is_local(rewrite, call.name) && rewrite.imported.get(call.name) != None -> {
                    updated.name = (rewrite.imported.get(call.name) ?? panic("a bound inline import lost its row")).semantic_name
                }
                else -> {}
            }
            if !sema_inline_is_local(rewrite, call.name) {
                if rewrite.variadic.get(call.name) == .Val(fixed) {
                    if call.args.len() >= fixed {
                        updated.name = sema_inline_note_variadic_arity(rewrite, call.name, call.args.len() - fixed)
                    }
                }
            }
            updated.type_args = sema_inline_rewrite_types(rewrite, call.type_args)
            updated.args = sema_inline_rewrite_call_args(rewrite, call.args)
            return Expr.Call{call: updated, id: node}
        }
        .Unary(op, operand, span, node) -> return Expr.Unary{op: op, operand: sema_inline_rewrite_expr(rewrite, operand), span: span, id: node}
        .Binary(op, left, right, span, node) -> return Expr.Binary{op: op, left: sema_inline_rewrite_expr(rewrite, left), right: sema_inline_rewrite_expr(rewrite, right), span: span, id: node}
        .CompareChain(operands, ops, hooks, span, node) -> return Expr.CompareChain{operands: sema_inline_rewrite_exprs(rewrite, operands), ops: ops, hooks: hooks, span: span, id: node}
        .Deref(value, span, node) -> return Expr.Deref{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        .RawOf(value, span, node) -> return Expr.RawOf{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        .Copy(value, span, node) -> return Expr.Copy{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        .Place(value, access, span, node) -> return Expr.Place{value: sema_inline_rewrite_expr(rewrite, value), access: access, span: span, id: node}
        .Field(base, member, span, node) -> {
            if sema_inline_type_path(rewrite, base) == .Val(type_name) {
                return Expr.Field{base: type_name, member: member, span: span, id: node}
            }
            if sema_inline_rewrite_member_value(rewrite, base, member, span, node) == .Val(value) {
                return value
            }
            return Expr.Field{base: sema_inline_rewrite_expr(rewrite, base), member: member, span: span, id: node}
        }
        .OptField(base, member, member_span, flatten, span, node) -> return Expr.OptField{base: sema_inline_rewrite_expr(rewrite, base), member: member, member_span: member_span, flatten: flatten, span: span, id: node}
        .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, node) -> {
            if receiver == .Ident(alias, alias_span, _) {
                if sema_inline_surface(rewrite, alias) == .Val(surface) {
                    rewritten: sema_inline_rewrite_module_call(rewrite, surface, alias_span, method, method_span, type_args, args)
                    if rewritten == .Val(value) -> return value
                    return Expr.MethodCall{receiver: receiver, method: method, method_span: method_span, owner_type_args: owner_type_args, type_args: type_args, args: sema_inline_rewrite_call_args(rewrite, args), id: node}
                }
            }
            // `math.inner.f(...)`: a member of a nested inline module. A
            // private step is reported here and the call still resolves, so
            // the file pass that rewrites the lifted body again stays quiet.
            if receiver == .Field(_, _, _, _) {
                segments := [NamedSpan]{}
                if sema_inline_receiver_path(receiver, segments) && !sema_inline_is_local(rewrite, segments[0].name) {
                    path: (loop segment in segments -> segment.name).join(".")
                    if sema_inline_surface(rewrite, path) == .Val(surface) {
                        if sema_inline_private_step(rewrite, segments) == .Val(diagnostic) {
                            rewrite.diagnostics.push(diagnostic)
                        }
                        rewritten: sema_inline_rewrite_module_call(rewrite, surface, segments[segments.len() - 1].span, method, method_span, type_args, args)
                        if rewritten == .Val(value) -> return value
                        return Expr.MethodCall{receiver: receiver, method: method, method_span: method_span, owner_type_args: owner_type_args, type_args: type_args, args: sema_inline_rewrite_call_args(rewrite, args), id: node}
                    }
                }
            }
            mapped_receiver := receiver
            if receiver == {
                .Ident(name, span, _) -> {
                    if rewrite.types.get(name) == .Val(.Named(resolved)) {
                        mapped_receiver = Expr.Ident{name: resolved, span: span, id: AST_NODE_GENERATED}
                    } else if rewrite.types.get(name) == .Val(actual) {
                        // A type parameter bound to a built-in scalar (`R` = `Int`)
                        // names that scalar as the static-call owner.
                        scalar: sema_genmod_type_text(actual)
                        if SEMA_CALL_SCALAR_OWNERS.contains(scalar) {
                            mapped_receiver = Expr.Ident{name: scalar, span: span, id: AST_NODE_GENERATED}
                        }
                    }
                }
                // `tokens.Token.from_int(7)`: a member type named through its module.
                .Field(base, member, span, _) -> {
                    if base == .Ident(alias, _, _) {
                        if !sema_inline_is_local(rewrite, alias) && rewrite.types.get("{alias}.{member}") == .Val(.Named(resolved)) {
                            sema_inline_private_type(rewrite, "{alias}.{member}", span)
                            mapped_receiver = Expr.Ident{name: resolved, span: span, id: AST_NODE_GENERATED}
                        }
                    }
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
            }
            return Expr.MethodCall{receiver: sema_inline_rewrite_expr(rewrite, mapped_receiver), method: method, method_span: method_span, owner_type_args: sema_inline_rewrite_types(rewrite, owner_type_args), type_args: sema_inline_rewrite_types(rewrite, type_args), args: sema_inline_rewrite_call_args(rewrite, args), id: node}
        }
        .OptMethodCall(receiver, method, method_span, type_args, args, span, node) -> return Expr.OptMethodCall{receiver: sema_inline_rewrite_expr(rewrite, receiver), method: method, method_span: method_span, type_args: sema_inline_rewrite_types(rewrite, type_args), args: sema_inline_rewrite_call_args(rewrite, args), span: span, id: node}
        .StructLit(type_name, type_args, import_ns, as_trait, fields, inferred, span, node) -> {
            mapped_name := type_name
            mapped_ns := import_ns
            resolved := Type?{None}
            if import_ns == .Val(namespace) {
                resolved = rewrite.types.get("{namespace}.{type_name}")
            }
            if resolved == None -> resolved = rewrite.types.get(type_name)
            if resolved == .Val(.Named(name)) {
                if import_ns == .Val(namespace) {
                    sema_inline_private_type(rewrite, "{namespace}.{type_name}", span)
                } else { sema_inline_private_type(rewrite, type_name, span) }
                mapped_name = name
                mapped_ns = String?{None}
            } else if import_ns == .Val(namespace) {
                if !sema_inline_is_local(rewrite, namespace) && rewrite.aliases.get(namespace) == .Val(generated) {
                    mapped_ns = Val(generated)
                }
            } else if !sema_inline_is_local(rewrite, type_name) {
                if rewrite.qualified.get(type_name) == .Val(target) {
                    mapped_name = target.member
                    mapped_ns = Val(target.module_alias)
                }
            }
            return Expr.StructLit{type_name: mapped_name, type_args: sema_inline_rewrite_types(rewrite, type_args), import_ns: mapped_ns, as_trait: as_trait, fields: sema_inline_rewrite_fields(rewrite, fields), inferred: inferred, span: span, id: node}
        }
        .TypedLit(head, body, span, node) -> {
            if head == .Val(ty) -> sema_inline_private_types(rewrite, ty, span)
            return Expr.TypedLit{head: sema_inline_rewrite_optional_type(rewrite, head), body: sema_inline_rewrite_typed_body(rewrite, body), span: span, id: node}
        }
        // copy: `variant_span` is a payload of read parameter `expression`, which keeps the original; field `variant_span` of the new Expr.EnumLit owns this one
        .EnumLit(type_name, variant, variant_span, args, leading_dot, span, node) -> {
            sema_inline_private_type(rewrite, type_name, span)
            return Expr.EnumLit{type_name: sema_inline_mapped_name(rewrite, type_name), variant: variant, variant_span: variant_span.copy(), args: sema_inline_rewrite_enum_args(rewrite, args), leading_dot: leading_dot, span: span, id: node}
        }
        // copy: `tainted_tag` is a payload of read parameter `expression`, which keeps the original; field `tag` of the new Expr.Tainted owns this one
        .Tainted(value, tainted_tag, span, node) -> return Expr.Tainted{value: sema_inline_rewrite_expr(rewrite, value), tag: tainted_tag.copy(), span: span, id: node}
        .Present(value, span, node) -> return Expr.Present{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        // The arm's type names are renamed as type position renames them.
        .PatternTest(subject, pattern, span, node) -> return Expr.PatternTest{subject: sema_inline_rewrite_expr(rewrite, subject), pattern: sema_inline_rewrite_pattern(rewrite, pattern), span: span, id: node}
        .Ok(value, span, node) -> return Expr.Ok{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        .Err(value, span, node) -> return Expr.Err{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        // copy: `conversion` is a payload of read parameter `expression`, which keeps the original; field `conversion` of the new Expr.Try owns this one
        .Try(value, span, conversion, context, node) -> return Expr.Try{value: sema_inline_rewrite_expr(rewrite, value), span: span, conversion: conversion.copy(), context: sema_inline_rewrite_optional_expr(rewrite, context), id: node}
        .OrFallback(value, fallback, is_option, span, node) -> return Expr.OrFallback{value: sema_inline_rewrite_expr(rewrite, value), fallback: sema_inline_rewrite_or_fallback(rewrite, fallback), is_option: is_option, span: span, id: node}
        .If(cond, then_body, then_value, else_body, else_value, span, node) -> {
            mapped_cond: sema_inline_rewrite_expr(rewrite, cond)
            saved: rewrite.locals.len()
            mapped_then_body: sema_inline_rewrite_stmts(rewrite, then_body)
            mapped_then_value: sema_inline_rewrite_expr(rewrite, then_value)
            sema_inline_restore_locals(rewrite, saved)
            mapped_else_body: sema_inline_rewrite_stmts(rewrite, else_body)
            mapped_else_value: sema_inline_rewrite_expr(rewrite, else_value)
            sema_inline_restore_locals(rewrite, saved)
            return Expr.If{cond: mapped_cond, then_body: mapped_then_body, then_value: mapped_then_value, else_body: mapped_else_body, else_value: mapped_else_value, span: span, id: node}
        }
        .TupleLit(fields, span, ty, node) -> {
            mapped := [TupleField]{}
            loop field in fields {
                mapped.push(TupleField{name: field.name, value: sema_inline_rewrite_expr(rewrite, field.value)})
            }
            return Expr.TupleLit{fields: mapped, span: span, ty: sema_inline_rewrite_optional_type(rewrite, ty), id: node}
        }
        .Lambda(lambda, node) -> return Expr.Lambda{lambda: sema_inline_rewrite_lambda(rewrite, lambda), id: node}
        .CallValue(callee, args, span, node) -> return Expr.CallValue{callee: sema_inline_rewrite_expr(rewrite, callee), args: sema_inline_rewrite_call_args(rewrite, args), span: span, id: node}
        .PtrFromAddr(alias, alias_span, elem, addr, span, node) -> return Expr.PtrFromAddr{alias: alias, alias_span: alias_span, elem: sema_inline_rewrite_type(rewrite, elem), addr: sema_inline_rewrite_expr(rewrite, addr), span: span, id: node}
        .Paren(value, span, node) -> return Expr.Paren{value: sema_inline_rewrite_expr(rewrite, value), span: span, id: node}
        .Pipe(head, steps, span, node) -> {
            mapped_head: sema_inline_rewrite_expr(rewrite, head)
            mapped := [PipeStep]{}
            loop step in steps {
                mapped.push(PipeStep{name: step.name, value: sema_inline_rewrite_expr(rewrite, step.value), reads: step.reads, span: step.span})
            }
            return Expr.Pipe{head: mapped_head, steps: mapped, span: span, id: node}
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .TypeValue(_, _, _) -> {}
    }
    // copy: the rewrite walks the module program by borrowed payload views (Jet has no consuming
    // match), so an unchanged expression kind is copied into the rebuilt program, while the
    // caller's program keeps the original.
    expression.copy()
}

sema_inline_declare_binding: fn(rewrite: &SemaInlineRewrite, binding: Binding) Never! {
    rewrite.locals.push(binding.name)
    if binding.pattern == .Val(pattern) {
        names: if pattern == {
            .Struct(_, _, fields, _, _) -> fields
            .List(elements, _) -> elements
            .Tuple(elements, _) -> elements
            .Refutable(_, _, bound, _) -> bound
        }
        loop field in names {
            if field.rename == {
                .Val(rename) -> { rewrite.locals.push(rename.name) }
                .None -> rewrite.locals.push(field.name)
            }
        }
    }
}

sema_inline_rewrite_binding: fn(rewrite: &SemaInlineRewrite, binding: Binding) -> Binding Never! {
    updated := binding
    if binding.ty == .Val(ty) {
        if binding.ty_span == .Val(span) -> sema_inline_private_types(rewrite, ty, span) else {
            sema_inline_private_types(rewrite, ty, binding.name_span)
        }
    }
    updated.ty = sema_inline_rewrite_optional_type(rewrite, binding.ty)
    updated.init = sema_inline_rewrite_expr(rewrite, binding.init)
    updated.markers = sema_inline_rewrite_markers(rewrite, binding.markers)
    updated.meta = sema_inline_rewrite_meta(rewrite, binding.meta)
    if binding.pattern == .Val(pattern) {
        updated.pattern = Val(if pattern == {
            .Struct(type_name, type_span, fields, rest, span) -> BindPattern.Struct{type_name: sema_inline_mapped_name(rewrite, type_name), type_span: type_span, fields: fields, rest: rest, span: span}
            .Refutable(inner, fallback, names, span) -> BindPattern.Refutable{pattern: sema_inline_rewrite_pattern(rewrite, inner), fallback: sema_inline_rewrite_or_fallback(rewrite, fallback), names: names, span: span}
            // copy: the binding pattern is a payload view of the borrowed binding (Jet has no
            // consuming match), so it is copied into the rebuilt program, while the caller's
            // program keeps the original.
            .List(_, _) | .Tuple(_, _) -> pattern.copy()
        })
    }
    updated
}

// `pattern` with each type name it spells renamed as type position renames
// it: a dotted arm (`.geo.Point(p)`, the member of a union holding
// `geo.Point`) and a struct pattern's head (`geo.Point{x, y}`). A bare arm
// (`.Point`) stays as written, since it may name an enum case.
sema_inline_rewrite_pattern: fn(rewrite: SemaInlineRewrite, pattern: Pattern) -[]> Pattern {
    if pattern == {
        .Variant(variant, bindings, leading_dot, span) -> {
            name: if variant.contains(".") -> sema_inline_mapped_name(rewrite, variant) else -> variant
            Pattern.Variant{variant: name, bindings: sema_inline_rewrite_pattern_slots(rewrite, bindings), leading_dot: leading_dot, span: span}
        }
        .Present(binding, binding_span, inner, span) -> Pattern.Present{binding: binding, binding_span: binding_span, inner: sema_inline_rewrite_optional_pattern(rewrite, inner), span: span}
        .Ok(binding, binding_span, inner, span) -> Pattern.Ok{binding: binding, binding_span: binding_span, inner: sema_inline_rewrite_optional_pattern(rewrite, inner), span: span}
        .Err(binding, binding_span, inner, span) -> Pattern.Err{binding: binding, binding_span: binding_span, inner: sema_inline_rewrite_optional_pattern(rewrite, inner), span: span}
        .Or(alternatives, span) -> Pattern.Or{alternatives: loop alternative in alternatives -> sema_inline_rewrite_pattern(rewrite, alternative), span: span}
        .Struct(fields, rest, span, type_name) -> {
            head := PatternTypeHead?{None}
            if type_name == .Val(written) {
                head = Val(PatternTypeHead{name: sema_inline_mapped_name(rewrite, written.name), span: written.span})
            }
            Pattern.Struct{fields: loop field in fields -> sema_inline_rewrite_struct_pattern_field(rewrite, field), rest: rest, span: span, type_name: head}
        }
        .List(items, rest, span) -> Pattern.List{items: sema_inline_rewrite_pattern_slots(rewrite, items), rest: rest, span: span}
        .Map(entries, rest, span) -> Pattern.Map{entries: entries, rest: rest, span: span}
        .StrMatch(parts, span) -> Pattern.StrMatch{parts: parts, span: span}
        .BinMatch(parts, span) -> Pattern.BinMatch{parts: parts, span: span}
        .Range(lo, hi, span) -> Pattern.Range{lo: lo, hi: hi, span: span}
        .Absent(span) -> Pattern.Absent{span: span}
    }
}

sema_inline_rewrite_optional_pattern: fn(rewrite: SemaInlineRewrite, pattern: Pattern?) -[]> Pattern? {
    if pattern == .Val(inner) -> return Val(sema_inline_rewrite_pattern(rewrite, inner))
    None
}

sema_inline_rewrite_pattern_slots: fn(rewrite: SemaInlineRewrite, slots: [PatSlot]) -[]> [PatSlot] {
    loop slot in slots -> sema_inline_rewrite_pattern_slot(rewrite, slot)
}

sema_inline_rewrite_pattern_slot: fn(rewrite: SemaInlineRewrite, slot: PatSlot) -[]> PatSlot {
    if slot == {
        .Nested(pattern) -> PatSlot.Nested{pattern: sema_inline_rewrite_pattern(rewrite, pattern)}
        .Named(field, field_span, inner) -> PatSlot.Named{field: field, field_span: field_span, slot: sema_inline_rewrite_pattern_slot(rewrite, inner)}
        .Bind(name, span) -> PatSlot.Bind{name: name, span: span}
        .Range(lo, hi) -> PatSlot.Range{lo: lo, hi: hi}
        .Rest(span) -> PatSlot.Rest{span: span}
        .Value(value) -> PatSlot.Value{value: value}
        .Wildcard -> PatSlot.Wildcard
    }
}

sema_inline_rewrite_struct_pattern_field: fn(rewrite: SemaInlineRewrite, field: StructPatField) -[]> StructPatField {
    if field == {
        .Nested(name, name_span, pattern) -> StructPatField.Nested{field: name, field_span: name_span, pattern: sema_inline_rewrite_pattern(rewrite, pattern)}
        .Bind(name, name_span, local, local_span) -> StructPatField.Bind{field: name, field_span: name_span, local: local, local_span: local_span}
        .Value(name, name_span, value) -> StructPatField.Value{field: name, field_span: name_span, value: value}
    }
}

sema_inline_rewrite_arms: fn(rewrite: &SemaInlineRewrite, arms: [SwitchArm]) -> [SwitchArm] Never! {
    mapped := [SwitchArm]{}
    loop arm in arms {
        saved: rewrite.locals.len()
        cond: sema_inline_rewrite_expr(rewrite, arm.cond)
        body: sema_inline_rewrite_stmts(rewrite, arm.body)
        sema_inline_restore_locals(rewrite, saved)
        mapped.push(SwitchArm{cond: cond, body: body, span: arm.span, through: arm.through})
    }
    mapped
}

sema_inline_rewrite_optional_body: fn(rewrite: &SemaInlineRewrite, body: [Stmt]?) -> [Stmt]? Never! {
    if body == {
        .Val(value) -> Val(sema_inline_rewrite_stmts(rewrite, value))
        .None -> None
    }
}

sema_inline_rewrite_lvalue: fn(rewrite: &SemaInlineRewrite, target: LValue) -> LValue Never! {
    if target == {
        // copy: `kind` is a payload of read parameter `target`, which keeps the original; field `kind` of the new LValue.Index owns this one
        .Index(base, index, span, kind) -> LValue.Index{base: sema_inline_rewrite_expr(rewrite, base), index: sema_inline_rewrite_expr(rewrite, index), span: span, kind: kind.copy()}
        .Field(base, field, span) -> LValue.Field{base: sema_inline_rewrite_expr(rewrite, base), field: field, span: span}
        // copy: the rewrite walks the module program by borrowed payload views (Jet has no
        // consuming match), so an unchanged assignment target is copied into the rebuilt program,
        // while the caller's program keeps the original.
        .Local(_, _) -> target.copy()
    }
}

// A block's bindings shadow module names for the rest of that block only.
sema_inline_rewrite_stmts: fn(rewrite: &SemaInlineRewrite, stmts: [Stmt]) -> [Stmt] Never! {
    saved: rewrite.locals.len()
    mapped := [Stmt]{}
    loop stmt in stmts -> mapped.push(sema_inline_rewrite_stmt(rewrite, stmt))
    sema_inline_restore_locals(rewrite, saved)
    mapped
}

sema_inline_rewrite_stmt: fn(rewrite: &SemaInlineRewrite, stmt: Stmt) -> Stmt Never! {
    if stmt == {
        .Expr(value) -> Stmt.Expr{expr: sema_inline_rewrite_expr(rewrite, value)}
        .Val(binding) -> {
            mapped: sema_inline_rewrite_binding(rewrite, binding)
            sema_inline_declare_binding(rewrite, binding)
            Stmt.Val{binding: mapped}
        }
        // copy: `op` is a payload of read parameter `stmt`, which keeps the original; field `op` of the new Stmt.Assign owns this one
        .Assign(target, op, op_span, value) -> Stmt.Assign{target: sema_inline_rewrite_lvalue(rewrite, target), op: op.copy(), op_span: op_span, value: sema_inline_rewrite_expr(rewrite, value)}
        .Return(value, span) -> Stmt.Return{value: sema_inline_rewrite_optional_expr(rewrite, value), span: span}
        // copy: `label` is a payload of read parameter `stmt`, which keeps the original; field `label` of the new Stmt.While owns this one
        .While(cond, body, span, arrow_body, label) -> Stmt.While{cond: sema_inline_rewrite_expr(rewrite, cond), body: sema_inline_rewrite_stmts(rewrite, body), span: span, arrow_body: arrow_body, label: label.copy()}
        .For(var, var_span, var2, kind, body, span, arrow_body, label, auto_vectorization) -> {
            mapped_kind: if kind == {
                .Range(start, end, step, exclusive) -> ForKind.Range{start: sema_inline_rewrite_expr(rewrite, start), end: sema_inline_rewrite_expr(rewrite, end), step: sema_inline_rewrite_optional_expr(rewrite, step), exclusive: exclusive}
                .In(collection, step) -> ForKind.In{collection: sema_inline_rewrite_expr(rewrite, collection), step: sema_inline_rewrite_optional_expr(rewrite, step)}
            }
            saved: rewrite.locals.len()
            rewrite.locals.push(var.copy())
            if var2 == .Val(second) -> rewrite.locals.push(second.name)
            mapped_body: sema_inline_rewrite_stmts(rewrite, body)
            sema_inline_restore_locals(rewrite, saved)
            Stmt.For{var: var, var_span: var_span, var2: var2, kind: mapped_kind, body: mapped_body, span: span, arrow_body: arrow_body, label: label, auto_vectorization: auto_vectorization}
        }
        .Switch(subject, arms, else_body, span) -> Stmt.Switch{subject: sema_inline_rewrite_expr(rewrite, subject), arms: sema_inline_rewrite_arms(rewrite, arms), else_body: sema_inline_rewrite_optional_body(rewrite, else_body), span: span}
        .ComptimeSwitch(subject, arms, else_body, span) -> Stmt.ComptimeSwitch{subject: sema_inline_rewrite_expr(rewrite, subject), arms: sema_inline_rewrite_arms(rewrite, arms), else_body: sema_inline_rewrite_optional_body(rewrite, else_body), span: span}
        .BreakValue(value, span) -> Stmt.BreakValue{value: sema_inline_rewrite_expr(rewrite, value), span: span}
        .BreakLabelValue(name, name_span, value, span) -> Stmt.BreakLabelValue{name: name, name_span: name_span, value: sema_inline_rewrite_expr(rewrite, value), span: span}
        // copy: `label` is a payload of read parameter `stmt`, which keeps the original; field `label` of the new Stmt.Loop owns this one
        .Loop(body, span, arrow_body, label) -> Stmt.Loop{body: sema_inline_rewrite_stmts(rewrite, body), span: span, arrow_body: arrow_body, label: label.copy()}
        .CountedLoop(init, cond, step, body, span, arrow_body, label) -> {
            saved: rewrite.locals.len()
            mapped_init: sema_inline_rewrite_binding(rewrite, init)
            sema_inline_declare_binding(rewrite, init)
            mapped_cond: sema_inline_rewrite_expr(rewrite, cond)
            mapped_step := Stmt?{None}
            if step == .Val(value) -> mapped_step = Val(sema_inline_rewrite_stmt(rewrite, value))
            mapped_body: sema_inline_rewrite_stmts(rewrite, body)
            sema_inline_restore_locals(rewrite, saved)
            Stmt.CountedLoop{init: mapped_init, cond: mapped_cond, step: mapped_step, body: mapped_body, span: span, arrow_body: arrow_body, label: label}
        }
        // copy: `audit` is a payload of read parameter `stmt`, which keeps the original; field `audit` of the new Stmt.Unsafe owns this one
        .Unsafe(audit, audit_expr, body, span) -> Stmt.Unsafe{audit: audit.copy(), audit_expr: sema_inline_rewrite_optional_expr(rewrite, audit_expr), body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        // copy: `reason` is a payload of read parameter `stmt`, which keeps the original; field `reason` of the new Stmt.Impure owns this one
        .Impure(reason, reason_expr, body, span) -> Stmt.Impure{reason: reason.copy(), reason_expr: sema_inline_rewrite_optional_expr(rewrite, reason_expr), body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .Reactive(body, span) -> Stmt.Reactive{body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .Shield(body, span) -> Stmt.Shield{body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        // copy: `marker` is a payload of read parameter `stmt`, which keeps the original; field `marker` of the new Stmt.Switched owns this one
        .Switched(marker, body, span) -> Stmt.Switched{marker: marker.copy(), body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .Region(name, name_span, body, span) -> Stmt.Region{name: name, name_span: name_span, body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .Policy(declarations, body, span) -> Stmt.Policy{declarations: declarations, body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .TaskGroup(name, name_span, args, body, span) -> Stmt.TaskGroup{name: name, name_span: name_span, args: TaskGroupArgs{limit: sema_inline_rewrite_optional_expr(rewrite, args.limit), stack: sema_inline_rewrite_optional_expr(rewrite, args.stack)}, body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .Layout(name, name_span, body, span) -> Stmt.Layout{name: name, name_span: name_span, body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        // copy: `binding` is a payload of read parameter `stmt`, which keeps the original; field `binding` of the new Stmt.AuthorityScope owns this one
        .AuthorityScope(caps, caps_span, binding, body, span) -> Stmt.AuthorityScope{caps: caps, caps_span: caps_span, binding: binding.copy(), body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        // copy: `selected_then` is a payload of read parameter `stmt`, which keeps the original; field `selected_then` of the new Stmt.ComptimeIf owns this one
        .ComptimeIf(cond, cond_span, then_body, else_body, span, selected_then) -> Stmt.ComptimeIf{cond: sema_inline_rewrite_expr(rewrite, cond), cond_span: cond_span, then_body: sema_inline_rewrite_stmts(rewrite, then_body), else_body: sema_inline_rewrite_optional_body(rewrite, else_body), span: span, selected_then: selected_then.copy()}
        .ComptimeBlock(body, is_template_loop, span) -> Stmt.ComptimeBlock{body: sema_inline_rewrite_stmts(rewrite, body), is_template_loop: is_template_loop, span: span}
        .ContextBlock(fields, body, span) -> {
            mapped := [ContextField]{}
            loop field in fields {
                mapped.push(ContextField{name: field.name, value: sema_inline_rewrite_expr(rewrite, field.value), span: field.span})
            }
            Stmt.ContextBlock{fields: mapped, body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        }
        .Live(body, span) -> Stmt.Live{body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        .AssumeDet(reason, reason_expr, body, span) -> Stmt.AssumeDet{reason: reason, reason_expr: sema_inline_rewrite_expr(rewrite, reason_expr), body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        // copy: `name` and `name_span` are payloads of read parameter `stmt`, which keeps the originals; the new Stmt.Transact's fields own `name` and `name_span`
        .Transact(name, name_span, body, implicit, span) -> Stmt.Transact{name: name.copy(), name_span: name_span.copy(), body: sema_inline_rewrite_stmts(rewrite, body), implicit: implicit, span: span}
        .Yield(value, span) -> Stmt.Yield{value: sema_inline_rewrite_expr(rewrite, value), span: span}
        // copy: `args_span` is a payload of read parameter `stmt`, which keeps the original; field `args_span` of the new Stmt.ScopeMember owns this one
        .ScopeMember(name, name_span, args, args_span, body, dsl, dot_span, span) -> Stmt.ScopeMember{name: name, name_span: name_span, args: sema_inline_rewrite_exprs(rewrite, args), args_span: args_span.copy(), body: sema_inline_rewrite_stmts(rewrite, body), dsl: dsl, dot_span: dot_span, span: span}
        .DeferClose(close, span) -> Stmt.DeferClose{close: sema_inline_rewrite_expr(rewrite, close), span: span}
        .Defer(body, span) -> Stmt.Defer{body: sema_inline_rewrite_stmts(rewrite, body), span: span}
        // copy: the rewrite walks the module program by borrowed payload views (Jet has no
        // consuming match), so an unchanged statement kind is copied into the rebuilt program,
        // while the caller's program keeps the original.
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> stmt.copy()
    }
}

sema_inline_rewrite_markers: fn(rewrite: &SemaInlineRewrite, markers: [Marker]) -> [Marker] Never! {
    mapped := [Marker]{}
    loop marker in markers {
        updated := marker.copy()
        args := [MarkerCallArg]{}
        loop arg in marker.args {
            if arg == {
                .Expr(value) -> {
                    args.push(MarkerCallArg.Expr{value: sema_inline_rewrite_expr(rewrite, value)})
                }
                .EffectRow(_, _) -> args.push(arg.copy())
            }
        }
        updated.args = args
        mapped.push(updated)
    }
    mapped
}

// `#Meta(category: label)` inside a template reads the instance's value
// arguments like any other expression of the module.
sema_inline_rewrite_meta: fn(rewrite: &SemaInlineRewrite, meta: MetaAttr?) -> MetaAttr? Never! {
    present: meta ?? return None
    updated := present
    fields := [MetaField]{}
    loop field in present.fields {
        if field == {
            .Category(value, span) -> {
                fields.push(MetaField.Category{value: sema_inline_rewrite_expr(rewrite, value), span: span})
            }
            .Maturity(value, span) -> {
                fields.push(MetaField.Maturity{value: sema_inline_rewrite_expr(rewrite, value), span: span})
            }
            .Unknown(name, value, span) -> {
                fields.push(MetaField.Unknown{name: name, value: sema_inline_rewrite_optional_expr(rewrite, value), span: span})
            }
            .Tunable(span) -> fields.push(MetaField.Tunable{span: span})
        }
    }
    updated.fields = fields
    Val(updated)
}

sema_inline_rewrite_clauses: fn(rewrite: &SemaInlineRewrite, clauses: [ContractClause]) -> [ContractClause] Never! {
    mapped := [ContractClause]{}
    loop clause in clauses {
        updated := clause.copy()
        updated.cond = sema_inline_rewrite_expr(rewrite, clause.cond)
        updated.message_expr = sema_inline_rewrite_expr(rewrite, clause.message_expr)
        mapped.push(updated)
    }
    mapped
}

sema_inline_rewrite_params: fn(rewrite: &SemaInlineRewrite, params: [Param]) -> [Param] Never! {
    mapped := [Param]{}
    loop param in params {
        updated := param.copy()
        sema_inline_private_types(rewrite, param.ty, param.ty_span)
        updated.ty = sema_inline_rewrite_type(rewrite, param.ty)
        updated.default = sema_inline_rewrite_optional_expr(rewrite, param.default)
        mapped.push(updated)
        rewrite.locals.push(param.name)
    }
    mapped
}

// A bound names a trait the rewrite may rename (`<M: Native>` inside an
// instance whose `Native` became the generated nominal).
sema_inline_rewrite_type_params: fn(rewrite: SemaInlineRewrite, params: [TypeParam]) -> [TypeParam] Never! {
    mapped := [TypeParam]{}
    loop param in params {
        updated := param.copy()
        updated.bounds = loop bound in param.bounds -> sema_inline_mapped_name(rewrite, bound)
        mapped.push(updated)
    }
    mapped
}

// Rust `specialize_func` / `specialize_function_types` plus the call routes.
sema_inline_rewrite_func: fn(rewrite: &SemaInlineRewrite, function: Func) -> Func Never! {
    updated := function
    saved: rewrite.locals.len()
    updated.type_params = sema_inline_rewrite_type_params(rewrite, function.type_params)
    updated.params = sema_inline_rewrite_params(rewrite, function.params)
    if function.return_type == .Val(return_type) {
        if function.return_type_span == .Val(span) {
            sema_inline_private_types(rewrite, return_type, span)
        } else { sema_inline_private_types(rewrite, return_type, function.name_span) }
    }
    updated.return_type = sema_inline_rewrite_optional_type(rewrite, function.return_type)
    updated.markers = sema_inline_rewrite_markers(rewrite, function.markers)
    updated.meta = sema_inline_rewrite_meta(rewrite, function.meta)
    updated.pre = sema_inline_rewrite_clauses(rewrite, function.pre)
    updated.post = sema_inline_rewrite_clauses(rewrite, function.post)
    updated.body = sema_inline_rewrite_stmts(rewrite, function.body)
    sema_inline_restore_locals(rewrite, saved)
    updated
}

sema_inline_rewrite_funcs: fn(rewrite: &SemaInlineRewrite, functions: [Func]) -> [Func] Never! {
    mapped := [Func]{}
    loop function in functions -> mapped.push(sema_inline_rewrite_func(rewrite, function))
    mapped
}

sema_inline_rewrite_named_types: fn(rewrite: SemaInlineRewrite, types: [NamedType]) -> [NamedType] Never! {
    mapped := [NamedType]{}
    loop entry in types {
        updated := entry.copy()
        updated.ty = sema_inline_rewrite_type(rewrite, entry.ty)
        mapped.push(updated)
    }
    mapped
}

sema_inline_rewrite_trait_blocks: fn(rewrite: &SemaInlineRewrite, blocks: [TraitImplBlock]) -> [TraitImplBlock] Never! {
    mapped := [TraitImplBlock]{}
    loop block in blocks {
        updated := block.copy()
        updated.trait_name = sema_inline_mapped_name(rewrite, block.trait_name)
        updated.methods = sema_inline_rewrite_funcs(rewrite, block.methods)
        updated.operator_rhs = sema_inline_rewrite_optional_type(rewrite, block.operator_rhs)
        updated.assoc_type_impls = sema_inline_rewrite_named_types(rewrite, block.assoc_type_impls)
        updated.constants = sema_inline_rewrite_impl_constants(rewrite, block.constants)
        mapped.push(updated)
    }
    mapped
}

sema_inline_rewrite_impl_constants: fn(rewrite: &SemaInlineRewrite, constants: [ImplConstValue]) -> [ImplConstValue] Never! {
    loop constant in constants -> ImplConstValue{name: constant.name, name_span: constant.name_span, value: sema_inline_rewrite_expr(rewrite, constant.value), span: constant.span}
}

// Rust `specialize_struct` with the module alias.
sema_inline_rewrite_struct: fn(rewrite: &SemaInlineRewrite, definition: StructDef, alias: String) -> StructDef Never! {
    updated := definition
    if alias != "" -> updated.name = sema_inline_type_name(alias, definition.name)
    updated.type_params = sema_inline_rewrite_type_params(rewrite, definition.type_params)
    fields := [Field]{}
    loop field_index in 0..<definition.fields.len() {
        mapped := definition.fields[field_index]
        mapped.ty = sema_inline_rewrite_type(rewrite, definition.fields[field_index].ty)
        mapped.computed = sema_inline_rewrite_optional_expr(rewrite, definition.fields[field_index].computed)
        mapped.serde_markers = sema_inline_rewrite_markers(rewrite, definition.fields[field_index].serde_markers)
        fields.push(mapped)
    }
    updated.fields = fields
    updated.methods = sema_inline_rewrite_funcs(rewrite, definition.methods)
    updated.trait_impls = sema_inline_rewrite_trait_blocks(rewrite, definition.trait_impls)
    updated.serde_markers = sema_inline_rewrite_markers(rewrite, definition.serde_markers)
    updated.type_markers = sema_inline_rewrite_markers(rewrite, definition.type_markers)
    updated.derives = sema_inline_mapped_names(rewrite, definition.derives)
    updated
}

// Rust `specialize_enum` with the module alias.
sema_inline_rewrite_enum: fn(rewrite: &SemaInlineRewrite, definition: EnumDef, alias: String) -> EnumDef Never! {
    updated := definition
    if alias != "" -> updated.name = sema_inline_type_name(alias, definition.name)
    updated.type_params = sema_inline_rewrite_type_params(rewrite, definition.type_params)
    variants := [Variant]{}
    loop variant_index in 0..<definition.variants.len() {
        mapped := definition.variants[variant_index]
        mapped.payload = if definition.variants[variant_index].payload == {
            .Unit -> VariantPayload.Unit
            .Single(ty, span) -> VariantPayload.Single{ty: sema_inline_rewrite_type(rewrite, ty), span: span}
            .Named(fields) -> {
                mapped_fields := [VariantField]{}
                loop field in fields {
                    mapped_fields.push(VariantField{name: field.name, name_span: field.name_span, ty: sema_inline_rewrite_type(rewrite, field.ty), ty_span: field.ty_span})
                }
                VariantPayload.Named{fields: mapped_fields}
            }
        }
        mapped.discriminant_expr = sema_inline_rewrite_optional_expr(rewrite, definition.variants[variant_index].discriminant_expr)
        mapped.serde_markers = sema_inline_rewrite_markers(rewrite, definition.variants[variant_index].serde_markers)
        variants.push(mapped)
    }
    updated.variants = variants
    updated.methods = sema_inline_rewrite_funcs(rewrite, definition.methods)
    updated.trait_impls = sema_inline_rewrite_trait_blocks(rewrite, definition.trait_impls)
    updated.serde_markers = sema_inline_rewrite_markers(rewrite, definition.serde_markers)
    updated.type_markers = sema_inline_rewrite_markers(rewrite, definition.type_markers)
    updated.derives = sema_inline_mapped_names(rewrite, definition.derives)
    updated
}

// Rust `specialize_trait`.
sema_inline_rewrite_trait: fn(rewrite: &SemaInlineRewrite, definition: TraitDef) -> TraitDef Never! {
    updated := definition
    updated.name = sema_inline_mapped_name(rewrite, definition.name)
    methods := [TraitMethodSig]{}
    loop method_index in 0..<definition.methods.len() {
        mapped := definition.methods[method_index]
        saved: rewrite.locals.len()
        mapped.params = sema_inline_rewrite_params(rewrite, definition.methods[method_index].params)
        mapped.return_type = sema_inline_rewrite_optional_type(rewrite, definition.methods[method_index].return_type)
        mapped.default_body = sema_inline_rewrite_optional_body(rewrite, definition.methods[method_index].default_body)
        mapped.markers = sema_inline_rewrite_markers(rewrite, definition.methods[method_index].markers)
        sema_inline_restore_locals(rewrite, saved)
        methods.push(mapped)
    }
    updated.methods = methods
    updated.constants = loop constant in definition.constants -> TraitConstDecl{name: constant.name, name_span: constant.name_span, ty: sema_inline_rewrite_type(rewrite, constant.ty), ty_span: constant.ty_span, default: sema_inline_rewrite_optional_expr(rewrite, constant.default), span: constant.span}
    updated
}

// Rust `specialize_error_conv`.
sema_inline_rewrite_error_conv: fn(rewrite: &SemaInlineRewrite, definition: ErrorConvDef) -> ErrorConvDef Never! {
    updated := definition
    updated.from_ty = sema_inline_mapped_name(rewrite, definition.from_ty)
    updated.to_ty = sema_inline_mapped_name(rewrite, definition.to_ty)
    updated.body = sema_inline_rewrite_stmts(rewrite, definition.body)
    updated
}

// Rust `specialize_impl`. An operator's right-hand type and a conversion's
// source rename with the methods that name them, as an in-body block's do
// (sema_inline_rewrite_trait_blocks).
sema_inline_rewrite_impl: fn(rewrite: &SemaInlineRewrite, definition: ImplDef) -> ImplDef Never! {
    updated := definition
    updated.type_name = sema_inline_mapped_name(rewrite, definition.type_name)
    if definition.trait_name == .Val(trait_name) {
        updated.trait_name = Val(sema_inline_mapped_name(rewrite, trait_name))
    }
    updated.operator_rhs = sema_inline_rewrite_optional_type(rewrite, definition.operator_rhs)
    updated.methods = sema_inline_rewrite_funcs(rewrite, definition.methods)
    updated.assoc_type_impls = sema_inline_rewrite_named_types(rewrite, definition.assoc_type_impls)
    updated.constants = sema_inline_rewrite_impl_constants(rewrite, definition.constants)
    updated
}

// ---------------------------------------------------------------------------
// Rust `hoist_inline_module_types`.

sema_inline_hoist_module: fn(code_module: CodeModule, source_path: String, hoist: &SemaInlineHoist) -> SemaInlineHoisted {
    updated := code_module
    if code_module.instance_identity != None {
        return SemaInlineHoisted{code_module: updated, paths: [String]{}, types: [String:Type]{}}
    }
    body: code_module.body ?? return SemaInlineHoisted{code_module: updated, paths: [String]{}, types: [String:Type]{}}
    module_alias: sema_inline_type_alias(source_path)
    module_name: code_module.name
    display_alias: sema_inline_type_alias(module_name)
    direct_types := [String:Type]{}
    direct_names := [String]{}
    // As for member functions, a plain `priv` module already hides every
    // member, so its member types record no `priv` of their own.
    hides_members: !code_module.is_pub && !code_module.is_package_pub
    loop inner in body {
        name := ""
        if inner == {
            .Struct(definition) -> { name = definition.name }
            .Enum(definition) -> { name = definition.name }
            .Trait(definition) -> { name = definition.name }
            .Tag(definition) -> { name = definition.name }
            .Distinct(definition) -> { name = definition.name }
            .TypeAlias(definition) -> name = definition.name
            .Func(_) | .UnitFamily(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {
                next
            }
        }
        resolved: Type.Named{name: sema_inline_type_name(module_alias, name)}
        direct_types[name] = resolved.copy()
        direct_types["{module_name}.{name}"] = resolved.copy()
        direct_types["{source_path}.{name}"] = resolved.copy()
        // A file imported under an alias can still carry the defining
        // module's compiler-owned spelling; normalize it to this identity.
        direct_types[sema_inline_type_name(display_alias, name)] = resolved.copy()
        direct_names.push(name.copy())
        if !hides_members && sema_inline_private_type_span(inner) == .Val(declared) {
            hoist.private_types["{source_path}.{name}"] = declared
        }
        // The enclosing file reaches private member types by
        // their full module path too. Do not export a nested relative name.
        hoist.exported["{source_path}.{name}"] = resolved
        hoist.has_exported = true
    }
    kept := [Item]{}
    lifted := [Item]{}
    descendant_types := [String:Type]{}
    descendant_paths := [String]{}
    loop inner in body {
        if inner == {
            .CodeModule(child) -> {
                child_path: "{source_path}.{child.name}"
                hoisted: sema_inline_hoist_module(child, child_path, hoist)
                loop full_path in hoisted.paths {
                    descendant_types[full_path] = hoisted.types.get(full_path) ?? next
                    descendant_paths.push(full_path)
                }
                kept.push(Item.CodeModule{value: hoisted.code_module})
            }
            .Struct(_) | .Enum(_) | .Trait(_) | .Tag(_) | .Impl(_) | .Distinct(_) | .TypeAlias(_) -> {
                lifted.push(inner.copy())
            }
            .Func(_) | .UnitFamily(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {
                kept.push(inner.copy())
            }
        }
    }
    visible := sema_inline_rewrite_empty()
    visible.types = direct_types
    prefix: "{source_path}."
    loop full_path in descendant_paths {
        ty: descendant_types.get(full_path) ?? next
        visible.types[full_path] = ty.copy()
        if full_path.starts_with(prefix) {
            relative: String.from_bytes(full_path.bytes()[prefix.bytes().len()..<full_path.bytes().len()]) ?? full_path
            visible.types[relative] = ty
        }
    }
    kept_rewritten := [Item]{}
    loop inner in kept {
        if inner == {
            .Func(definition) -> {
                kept_rewritten.push(Item.Func{value: sema_inline_rewrite_func(visible, definition)})
            }
            .Const(definition) -> {
                mapped := definition.copy()
                mapped.value = sema_inline_rewrite_expr(visible, definition.value)
                mapped.ty = sema_inline_rewrite_optional_type(visible, definition.ty)
                mapped.markers = sema_inline_rewrite_markers(visible, definition.markers)
                mapped.meta = sema_inline_rewrite_meta(visible, definition.meta)
                kept_rewritten.push(Item.Const{value: mapped})
            }
            .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {
                kept_rewritten.push(inner)
            }
        }
    }
    loop inner in lifted {
        if inner == {
            .Struct(definition) -> {
                hoisted := sema_inline_rewrite_struct(visible, definition, module_alias)
                hoisted.inline_module = Val(code_module.span)
                hoist.declarations.push(Item.Struct{value: hoisted})
            }
            .Enum(definition) -> {
                hoist.declarations.push(Item.Enum{value: sema_inline_rewrite_enum(visible, definition, module_alias)})
            }
            .Trait(definition) -> {
                hoist.declarations.push(Item.Trait{value: sema_inline_rewrite_trait(visible, definition)})
            }
            .Tag(definition) -> {
                mapped := definition.copy()
                mapped.name = sema_inline_mapped_name(visible, definition.name)
                hoist.declarations.push(Item.Tag{value: mapped})
            }
            .Impl(definition) -> {
                hoist.declarations.push(Item.Impl{value: sema_inline_rewrite_impl(visible, definition)})
            }
            .Distinct(definition) -> {
                mapped := definition.copy()
                mapped.name = sema_inline_mapped_name(visible, definition.name)
                mapped.base = sema_inline_rewrite_type(visible, definition.base)
                hoist.declarations.push(Item.Distinct{value: mapped})
            }
            .TypeAlias(definition) -> {
                mapped := definition.copy()
                mapped.name = sema_inline_mapped_name(visible, definition.name)
                mapped.target = sema_inline_rewrite_type(visible, definition.target)
                loop index in 0..<definition.choices.len() {
                    mapped.choices[index].target = sema_inline_rewrite_type(visible, definition.choices[index].target)
                }
                hoist.declarations.push(Item.TypeAlias{value: mapped})
            }
            .Func(_) | .UnitFamily(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    updated.body = Val(kept_rewritten)
    all_paths := [String]{}
    all_types := [String:Type]{}
    loop name in direct_names {
        ty: direct_types.get(name) ?? next
        all_paths.push("{source_path}.{name}")
        all_types["{source_path}.{name}"] = ty
    }
    loop full_path in descendant_paths {
        all_paths.push(full_path.copy())
        all_types[full_path] = descendant_types.get(full_path) ?? next
    }
    SemaInlineHoisted{code_module: updated, paths: all_paths, types: all_types}
}

// The span of the name `item` declares when it is a member type written
// `priv` (`priv(package)` reaches the whole package, this file included).
sema_inline_private_type_span: fn(item: Item) -> Span? Never! {
    if item == {
        .Struct(definition) -> {
            if !definition.is_pub && !definition.is_package_pub -> return Val(definition.name_span)
        }
        .Enum(definition) -> {
            if !definition.is_pub && !definition.is_package_pub -> return Val(definition.name_span)
        }
        .Trait(definition) -> {
            if !definition.is_pub && !definition.is_package_pub -> return Val(definition.name_span)
        }
        .Tag(definition) -> {
            if !definition.is_pub && !definition.is_package_pub -> return Val(definition.name_span)
        }
        .Distinct(definition) -> {
            if !definition.is_pub && !definition.is_package_pub -> return Val(definition.name_span)
        }
        .TypeAlias(definition) -> {
            if !definition.is_pub && !definition.is_package_pub -> return Val(definition.name_span)
        }
        .Func(_) | .UnitFamily(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    None
}

// Rust `rewrite_exported_inline_types`: member types reach every function of
// the enclosing file (and its inline modules) by their qualified name. The
// file's own structs, enums and tests name them the same way, so a field
// `stream: transport.BodyStream` holds the hoisted member type.
sema_inline_rewrite_exported: fn(items: &&[Item], rewrite: &SemaInlineRewrite) -> [Item] Never! {
    mapped := [Item]{}
    loop item in items.move() {
        if item == {
            .Func(function) -> {
                mapped.push(Item.Func{value: sema_inline_rewrite_func(rewrite, function)})
            }
            .Struct(definition) -> {
                mapped.push(Item.Struct{value: sema_inline_rewrite_struct(rewrite, definition, "")})
            }
            .Enum(definition) -> {
                mapped.push(Item.Enum{value: sema_inline_rewrite_enum(rewrite, definition, "")})
            }
            .Test(_) -> { mapped.push(sema_inline_rewrite_item(rewrite, item)) }
            // An impl head names member types and traits by their
            // module path (`impl inner.Loud.inner.Shout`), so it binds to the
            // hoisted declarations the module's own impls bind to.
            .Impl(definition) -> {
                updated := definition.move()
                updated.type_name = sema_inline_mapped_name(rewrite, updated.type_name)
                if updated.trait_name == .Val(trait_name) {
                    updated.trait_name = Val(sema_inline_mapped_name(rewrite, trait_name))
                }
                updated.methods = sema_inline_rewrite_funcs(rewrite, updated.methods)
                mapped.push(Item.Impl{value: updated})
            }
            // A module's own bodies may name its `priv` member types.
            .CodeModule(definition) -> {
                updated := definition.move()
                taken: updated.body.move()
                updated.body = None
                if taken == .Val(body) {
                    // The body reads as its module's own; after it, the path
                    // drops that module's segment again.
                    rewrite.sibling_module = if rewrite.sibling_module == "" -> "{updated.name}" else -> "{rewrite.sibling_module}.{updated.name}"
                    updated.body = Val(sema_inline_rewrite_exported(body.move(), rewrite))
                    enclosing: rewrite.sibling_module.cut_last(".")
                    rewrite.sibling_module = if enclosing == .Val(parts) -> parts.before else -> ""
                }
                mapped.push(Item.CodeModule{value: updated})
            }
            // An alias stands for its target, and a distinct type is built on
            // its base: a member type there is the hoisted type itself, under
            // the same privacy as where any other type names it.
            .TypeAlias(definition) -> {
                updated := definition.move()
                sema_inline_private_types(rewrite, updated.target, updated.target_span)
                updated.target = sema_inline_rewrite_type(rewrite, updated.target)
                loop index in 0..<updated.choices.len() {
                    sema_inline_private_types(rewrite, updated.choices[index].target, updated.choices[index].target_span)
                    updated.choices[index].target = sema_inline_rewrite_type(rewrite, updated.choices[index].target)
                }
                mapped.push(Item.TypeAlias{value: updated})
            }
            .Distinct(definition) -> {
                updated := definition.move()
                sema_inline_private_types(rewrite, updated.base, updated.base_span)
                updated.base = sema_inline_rewrite_type(rewrite, updated.base)
                mapped.push(Item.Distinct{value: updated})
            }
            .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {
                mapped.push(item)
            }
        }
    }
    mapped
}

// ---------------------------------------------------------------------------
// `use g: bank.f` over an inline module (Rust CheckInner 4).

sema_inline_import_target: fn(declaration: ImportDecl, inline_names: [String:Bool]) -> String? Never! {
    if declaration.kind == .Unqualified(module_alias, _, _, _, _) {
        if inline_names.get(module_alias) != None -> return Val(module_alias)
    }
    None
}

// `use geo.[Point]` over inline module `geo`: the file names member type
// `Point` by its local name exactly as it names `geo.Point`, under the same
// privacy (sema_inline_private_type). `imported` records each local name a
// type binds, so the function binding (sema_inline_bind_imports) takes it as
// bound.
sema_inline_bind_type_imports: fn(imports: [ImportDecl], rewrite: &SemaInlineRewrite, imported: &[String:Bool]) -[]> {
    loop declaration in imports {
        if declaration.kind == .Unqualified(module_alias, module_alias_span, items, _, _) {
            loop item in items {
                path: "{module_alias}.{item.original}"
                ty: rewrite.types.get(path) ?? next
                sema_inline_private_type(rewrite, path, module_alias_span)
                local: sema_registration_import_local(item)
                rewrite.types[local] = ty
                imported[local] = true
            }
        }
    }
}

sema_inline_bind_imports: fn(program: Program, surfaces: [SemaInlineModuleSurface], inline_names: [String:Bool], type_imports: [String:Bool], rewrite: &SemaInlineRewrite) -> [ImportDecl] {
    kept := [ImportDecl]{}
    seen := [String:Bool]{}
    loop declaration in program.imports {
        target: sema_inline_import_target(declaration, inline_names) ?? {
            if declaration.kind == .Unqualified(_, _, items, _, _) {
                loop item in items -> seen[sema_registration_import_local(item)] = true
            }
            kept.push(declaration.copy())
            next
        }
        if declaration.kind == .Unqualified(module_alias, module_alias_span, items, _, _) {
            surface := SemaInlineModuleSurface?{None}
            loop candidate in surfaces {
                if candidate.name == target -> surface = Val(candidate)
            }
            // A module whose functions stay in its body binds nothing here.
            members: surface ?? next
            loop (item_index, item) in items {
                local: sema_registration_import_local(item)
                if {
                    seen.get(local) != None -> {
                        rewrite.diagnostics.push(sema_error("E0105", declaration.alias_span, "the import name `{local}` is used twice", "each import needs a unique namespace name in this file", "rename one with an `alias: path` row"))
                    }
                    // A member type binds in step 1 (sema_inline_bind_type_imports).
                    type_imports.get(local) != None -> seen[local] = true
                    members.functions.get(item.original) == None -> {
                        rewrite.diagnostics.push(sema_error("E0611", module_alias_span, "`{item.original}` is not defined in module `{module_alias}`", "check the module body for the item you're importing", "make sure the name is spelled correctly"))
                    }
                    else -> {
                        seen[local] = true
                        span: if item_index < declaration.local_spans.len() -> declaration.local_spans[item_index] else -> declaration.span
                        rewrite.imported[local] = SemaInlineFunctionBinding{semantic_name: sema_inline_member_name(target, item.original), module_alias: target.copy(), source_name: item.original.copy(), span: span, visibility: if declaration.is_pub -> 2 else if declaration.is_package_pub -> 1 else -> 0}
                    }
                }
            }
        }
    }
    kept
}

// Rust `resolve_inline_module_imports`: a module's own `use alias.[f]` binds
// `f` inside that module only. `alias` is a sibling inline module (its member
// must exist, E0611, and be public, E0609) or a file module this file imports
// (the member is read qualified). A group with any problem binds nothing.
// A re-export also declares each bound name as `module.name`. A sibling's
// member may itself be a re-export, already resolved to its function
// (sema_inline_resolve_reexports); one whose chain breaks was reported there.
sema_inline_bind_module_imports: fn(definition: CodeModule, surfaces: [SemaInlineModuleSurface], file_aliases: [String:Bool], rewrite: &SemaInlineRewrite) -> [String:SemaInlineTarget] {
    reexports := [String:SemaInlineTarget]{}
    names := [String:Bool]{}
    loop declaration in definition.imports {
        // `exported: core.math.abs`: a Core member under the module's
        // own alias; `yell: right.shout`: a sibling's member under it.
        if declaration.kind == .Module(name, name_span) {
            target := sema_inline_core_member(name)
            parts: name.split(".").to_list()
            if parts.len() == 2 {
                loop candidate in surfaces {
                    if candidate.name != parts[0] -> next
                    target = sema_inline_sibling_target(candidate, parts[1])
                    if target == None && candidate.broken.get(parts[1]) == None {
                        rewrite.diagnostics.push(sema_error("E0611", name_span, "`{parts[1]}` is not defined in module `{parts[0]}`", "check the module body for the item you are re-exporting", "make sure the name is spelled correctly"))
                    }
                }
            }
            bound: target ?? next
            local: declaration.alias
            if names.get(local) != None {
                rewrite.diagnostics.push(sema_error("E0105", declaration.alias_span, "the import name `{local}` is used twice", "each import needs a unique namespace name in this file", "rename one with an `alias: path` row"))
                next
            }
            names[local] = true
            if bound.qualified -> rewrite.qualified[local] = bound.copy() else {
                rewrite.imported[local] = SemaInlineFunctionBinding{semantic_name: sema_inline_member_name(bound.module_alias, bound.member), module_alias: bound.module_alias, source_name: bound.member, span: declaration.alias_span, visibility: if declaration.is_pub -> 2 else if declaration.is_package_pub -> 1 else -> 0}
            }
            if declaration.is_pub -> reexports[local] = bound
            next
        }
        if declaration.kind == .Unqualified(module_alias, module_alias_span, items, _, _) {
            core: module_alias == "core" || module_alias.starts_with("core.")
            group_start: rewrite.diagnostics.len()
            bound_locals := [String]{}
            bound_targets := [SemaInlineTarget]{}
            members := SemaInlineModuleSurface?{None}
            loop candidate in surfaces {
                if candidate.name == module_alias -> members = Val(candidate)
            }
            loop item in items {
                local: sema_registration_import_local(item)
                if names.get(local) != None {
                    rewrite.diagnostics.push(sema_error("E0105", declaration.alias_span, "the import name `{local}` is used twice", "each import needs a unique namespace name in this file", "rename one with an `alias: path` row"))
                    next
                }
                names[local] = true
                if core {
                    // A Core module (`use core.[math]`) binds through its Core
                    // alias (sema_inline_module_aliases).
                    if sema_inline_core_module_item(declaration, item) != None -> next
                    target: sema_inline_core_member("{module_alias}.{item.original}") ?? {
                        rewrite.diagnostics.push(sema_error("E0611", module_alias_span, "`{item.original}` is not defined in module `{module_alias}`", "an import member must name one registered declaration", "declare or import the member before selecting it"))
                        next
                    }
                    bound_locals.push(local)
                    bound_targets.push(target)
                    next
                }
                if members == .Val(surface) {
                    if sema_inline_sibling_target(surface, item.original) == .Val(target) {
                        bound_locals.push(local)
                        bound_targets.push(target)
                    } else if surface.broken.get(item.original) == None {
                        rewrite.diagnostics.push(sema_error("E0611", module_alias_span, "`{item.original}` is not defined in module `{module_alias}`", "check the module body for the item you are importing", "make sure the name is spelled correctly"))
                    }
                    next
                }
                if rewrite.aliases.get(module_alias) == .Val(generated) {
                    bound_locals.push(local)
                    bound_targets.push(SemaInlineTarget{module_alias: generated, member: item.original, qualified: true})
                    next
                }
                if file_aliases.get(module_alias) != None {
                    bound_locals.push(local)
                    bound_targets.push(SemaInlineTarget{module_alias: module_alias, member: item.original, qualified: true})
                    next
                }
                rewrite.diagnostics.push(sema_unknown_module_alias(module_alias, module_alias_span))
            }
            if rewrite.diagnostics.len() != group_start -> next
            loop (index, local) in bound_locals {
                if bound_targets[index].qualified -> rewrite.qualified[local] = bound_targets[index] else {
                    span: if index < declaration.local_spans.len() -> declaration.local_spans[index] else -> declaration.span
                    rewrite.imported[local] = SemaInlineFunctionBinding{semantic_name: sema_inline_member_name(bound_targets[index].module_alias, bound_targets[index].member), module_alias: bound_targets[index].module_alias.copy(), source_name: bound_targets[index].member.copy(), span: span, visibility: if declaration.is_pub -> 2 else if declaration.is_package_pub -> 1 else -> 0}
                }
                if declaration.is_pub -> reexports[local] = bound_targets[index]
            }
        }
    }
    reexports
}

// The function member `member` of sibling module `surface` names: its own
// function, or the one its re-export resolves to.
sema_inline_sibling_target: fn(surface: SemaInlineModuleSurface, member: String) -[]> SemaInlineTarget? {
    if surface.functions.get(member) != None {
        return Val(SemaInlineTarget{module_alias: surface.name, member: member, qualified: false})
    }
    if surface.reexports.get(member) == .Val(target) {
        return Val(SemaInlineTarget{module_alias: target.module_alias, member: target.member, qualified: target.qualified})
    }
    None
}

// The re-exports between the file's top-level inline modules: each row whose
// target is a member of a sibling inline module (`shout: right.shout`,
// `yell: right.shout`).
sema_inline_reexport_rows: fn(program_items: [Item], surfaces: [SemaInlineModuleSurface]) -[]> [SemaInlineReexportRow] {
    rows := [SemaInlineReexportRow]{}
    loop item in program_items {
        if item == .CodeModule(definition) {
            owner: sema_inline_surface_index(surfaces, definition.name)
            if definition.body == None || owner < 0 -> next
            loop declaration in definition.imports {
                if !declaration.is_pub -> next
                if declaration.kind == {
                    .Unqualified(module_alias, _, items, _, _) -> {
                        alias: sema_inline_surface_index(surfaces, module_alias)
                        if alias < 0 -> next
                        loop imported in items {
                            rows.push(SemaInlineReexportRow{owner: owner, local: sema_registration_import_local(imported), alias: alias, member: imported.original, span: declaration.span})
                        }
                    }
                    .Module(name, _) -> {
                        parts: name.split(".").to_list()
                        if parts.len() != 2 -> next
                        alias: sema_inline_surface_index(surfaces, parts[0])
                        if alias < 0 -> next
                        rows.push(SemaInlineReexportRow{owner: owner, local: declaration.alias, alias: alias, member: parts[1], span: declaration.span})
                    }
                    .File(_, _) -> {}
                }
            }
        }
    }
    rows
}

sema_inline_surface_index: fn(surfaces: [SemaInlineModuleSurface], name: String) -[]> Int {
    loop (index, surface) in surfaces {
        if surface.name == name -> return index
    }
    -1
}

// The row re-exporting `local` from the module at surface `owner`, or -1.
sema_inline_reexport_row_of: fn(rows: [SemaInlineReexportRow], owner: Int, local: String) -[]> Int {
    loop (index, row) in rows {
        if row.owner == owner && row.local == local -> return index
    }
    -1
}

// Every re-export between the file's top-level inline modules, resolved
// through any chain of re-exports, in any order, to the function it names,
// before any module binds its imports. A row whose chain reaches no function
// is marked broken: its first missing link is reported when that row's
// module binds (E0611), and a chain that leads back to itself names nothing
// at all, so the loop is reported here, once, at its first row (E0604).
sema_inline_resolve_reexports: fn(program_items: [Item], surfaces: &[SemaInlineModuleSurface], diagnostics: &[Diagnostic]) -[]> {
    rows: sema_inline_reexport_rows(program_items, surfaces)
    loop (start, row) in rows {
        trail := [Int]{start}
        alias := row.alias
        member := row.member
        resolved := SemaInlineTarget?{None}
        looped := false
        loop {
            if surfaces[alias].functions.get(member) != None {
                resolved = Val(SemaInlineTarget{module_alias: surfaces[alias].name, member: member, qualified: false})
                break
            }
            link: sema_inline_reexport_row_of(rows, alias, member)
            if link < 0 -> break
            if trail.contains(link) {
                looped = link == start
                break
            }
            trail.push(link)
            alias = rows[link].alias
            member = rows[link].member
        }
        updated := surfaces[row.owner]
        if resolved == .Val(target) -> updated.reexports[row.local] = target else {
            updated.broken[row.local] = true
        }
        surfaces[row.owner] = updated
        if !looped -> next
        first := start
        loop index in trail {
            if index < first -> first = index
        }
        if first != start -> next
        written: "{surfaces[row.owner].name}.{row.local}"
        chain := ""
        loop index in trail {
            chain = "{chain}`{surfaces[rows[index].owner].name}.{rows[index].local}` → "
        }
        diagnostics.push(sema_error("E0604", row.span, "the re-export `{written}` leads back to itself", "each re-export names the one its target names, so the chain {chain}`{written}` never reaches a function", "point one re-export in the loop at the module that declares the function"))
    }
}

// `tools: helpers` in a module body, naming a `priv module` of this file,
// would re-export the module `priv` keeps in, since a re-export is public
// (E0609). The fix lists the members to re-export one by one instead, and a
// read of the name is not reported again.
sema_inline_check_private_module_aliases: fn(program_items: [Item], surfaces: &[SemaInlineModuleSurface], diagnostics: &[Diagnostic]) -[]> {
    private := [String:Bool]{}
    loop item in program_items {
        if item == .CodeModule(definition) {
            if definition.body != None && !definition.is_pub && !definition.is_package_pub {
                private[definition.name] = true
            }
        }
    }
    if private.is_empty() {
        return
    }
    loop item in program_items {
        if item == .CodeModule(definition) {
            owner: sema_inline_surface_index(surfaces, definition.name)
            if owner < 0 -> next
            loop inner in definition.body ?? next {
                if inner == .ModuleAlias(alias) && alias.args.is_empty() && private.get(alias.target) != None {
                    index: sema_inline_surface_index(surfaces, alias.target)
                    if index < 0 -> next
                    diagnostics.push(sema_inline_private_module_alias(alias.name, surfaces[index], alias.target_span))
                    updated := surfaces[owner]
                    updated.broken[alias.name] = true
                    surfaces[owner] = updated
                }
            }
        }
    }
}

// `local: module` re-exporting the `priv module` `surface`: E0609, whose fix
// lists its members.
sema_inline_private_module_alias: fn(local: String, surface: SemaInlineModuleSurface, span: Span) -[]> Diagnostic {
    name: surface.name
    members := [String]{}
    loop member in surface.functions.keys() {
        if surface.private_members.get(member) == None -> members.push(member)
    }
    loop member in surface.constants.keys() {
        if member != SEMA_MODULE_META && surface.private_members.get(member) == None {
            members.push(member)
        }
    }
    members.sort()
    rows: (loop member in members -> "`{member}: {name}.{member}`").join(", ")
    fix: if members.is_empty() -> "make `{name}` public, or declare the members to re-export first" else -> "re-export its members one by one: {rows}"
    sema_error("E0609", span, "`{local}: {name}` re-exports `{name}`, a `priv module`", "a re-export is public, and `priv` keeps `{name}` inside this file", fix)
}

// Rust `resolve_inline_module_imports` for a file-module member, once every
// import is bound: `use limits.[MAX]` inside a module names a declaration of
// `limits` (E0611) that this file may see (E0609).
sema_inline_modules_collect_import_diagnostics: fn(graph: SemaRegistrationGraph, module_index: Int, diagnostics: &[Diagnostic]) {
    module_row: graph.modules[module_index]
    loop item in module_row.program.items {
        if item == .CodeModule(definition) {
            loop declaration in definition.imports {
                if declaration.kind == .Unqualified(module_alias, module_alias_span, items, _, _) {
                    target_index := -1
                    loop import in module_row.imports {
                        if import.declaration.alias == module_alias && !sema_registration_import_is_unqualified(import.declaration) {
                            target_index = sema_registration_module_index(graph, import.target_module_identity) ?? -1
                        }
                    }
                    if target_index < 0 -> next
                    loop imported in items {
                        original: imported.original
                        if sema_registration_resolve_export(graph, target_index, original, module_row.module_identity, module_row.package_identity, [String]{}) != None {
                            next
                        }
                        declared: sema_registration_direct_symbol(graph.modules[target_index], original)
                        if declared == {
                            .Val(export) -> {
                                fix: if export.symbol.kind == SymbolKind.Function -> "import it from inside its enclosing module, or remove `priv` from its module" else -> "import it from inside its enclosing module, or remove `priv` from its module"
                                diagnostics.push(sema_error("E0609", module_alias_span, "`{original}` is private in module `{module_alias}`", "an item of a `priv module` is usable only by its enclosing module", fix))
                            }
                            .None -> {
                                diagnostics.push(sema_error("E0611", module_alias_span, "`{original}` is not defined in module `{module_alias}`", "check the module for the item you are importing", "make sure the name is spelled correctly"))
                            }
                        }
                    }
                }
            }
        }
    }
}

sema_inline_modules_check_imports: fn(graph: &SemaRegistrationGraph, module_index: Int) {
    diagnostics := [Diagnostic]{}
    sema_inline_modules_collect_import_diagnostics(graph, module_index, diagnostics)
    loop diagnostic in diagnostics {
        sema_registration_push_graph_diagnostic(graph, module_index, diagnostic)
    }
}

// Every inline module nested in `body` (module `parent`), depth first, with
// the import bindings its members see. Each module binds its imports here,
// once, so its re-exports are on its surface before any body is
// rewritten.
sema_inline_collect_nested: fn(body: [Item], parent: String, file_imports: [ImportDecl], surfaces: [SemaInlineModuleSurface], file_aliases: [String:Bool], inherited: [String:String], nested: &[SemaInlineModuleSurface], bindings: &[SemaInlineRewrite]) Never! {
    loop item in body {
        if item == .CodeModule(child) {
            child_body: child.body ?? next
            path: "{parent}.{child.name}"
            private_to := String?{None}
            if !child.is_pub && !child.is_package_pub -> private_to = Val(parent.copy())
            surface := SemaInlineModuleSurface{name: path.copy(), path: path.copy(), private_to: private_to, functions: [String:Bool]{}, constants: [String:Bool]{}, private_members: [String:Span]{}, reexports: [String:SemaInlineTarget]{}, broken: [String:Bool]{}}
            sema_inline_surface_members(surface, child_body, !child.is_pub && !child.is_package_pub)
            aliases: sema_inline_module_aliases(child, path, file_imports, inherited)
            binding := sema_inline_rewrite_empty()
            binding.sibling_module = path.copy()
            binding.siblings = surface.functions
            binding.aliases = aliases.copy()
            surface.reexports = sema_inline_bind_module_imports(child, surfaces, file_aliases, binding)
            nested.push(surface)
            bindings.push(binding)
            sema_inline_collect_nested(child_body, path, file_imports, surfaces, file_aliases, aliases, nested, bindings)
        }
    }
}

// The inline modules a body inside module `context` calls through: every
// nested module by its full path, and those nested in `context` also by their
// path relative to it (`inner.f()` inside `math` is `math.inner.f()`).
sema_inline_scope_surfaces: fn(nested: [SemaInlineModuleSurface], context: String) -> [SemaInlineModuleSurface] Never! {
    scope := [SemaInlineModuleSurface]{}
    prefix: "{context}."
    loop surface in nested {
        scope.push(surface.copy())
        if !surface.path.starts_with(prefix) -> next
        relative := surface.copy()
        relative.name = String.from_bytes(surface.path.bytes()[prefix.bytes().len()..<surface.path.bytes().len()]) ?? next
        scope.push(relative)
    }
    scope
}

// A module's own constants, read bare inside it, name their lifted member
// identities; a local or parameter of the same name shadows one.
sema_inline_bind_constants: fn(body: [Item], path: String, rewrite: &SemaInlineRewrite) Never! {
    loop item in body {
        if item == .Const(constant) {
            rewrite.values[constant.name] = Expr.Ident{name: sema_inline_member_name(path, constant.name), span: constant.name_span, id: AST_NODE_GENERATED}
        }
    }
}

sema_inline_lift_constant: fn(rewrite: &SemaInlineRewrite, constant: ConstDef, path: String) -> Item Never! {
    member := constant
    member.name = sema_inline_member_name(path, constant.name)
    member.value = sema_inline_rewrite_expr(rewrite, constant.value)
    member.ty = sema_inline_rewrite_optional_type(rewrite, constant.ty)
    Item.Const{value: member}
}

// Lifts the member functions of every module nested in `body` (module
// `parent`) under their member identities, each body rewritten with the
// bindings sema_inline_collect_nested made for its module; `owners` maps each
// lifted function to its module's path.
sema_inline_lift_nested: fn(body: [Item], parent: String, nested: [SemaInlineModuleSurface], bindings: [SemaInlineRewrite], lifted: &[Item], owners: &[String:String], diagnostics: &[Diagnostic]) Never! {
    loop item in body {
        if item == .CodeModule(child) {
            child_body: child.body ?? next
            path: "{parent}.{child.name}"
            row: loop (index, surface) in nested {
                if surface.path == path {
                    break index
                }
            } ?? -1
            if row < 0 -> next
            rewrite := bindings[row]
            rewrite.modules = sema_inline_scope_surfaces(nested, path)
            sema_inline_bind_constants(child_body, path, rewrite)
            loop inner in child_body {
                if inner == {
                    .Func(function) -> {
                        member := sema_inline_rewrite_func(rewrite, function)
                        member.name = sema_inline_member_name(path, function.name)
                        owners[member.name] = path.copy()
                        lifted.push(Item.Func{value: member})
                    }
                    .Const(constant) -> {
                        lifted.push(sema_inline_lift_constant(rewrite, constant, path))
                    }
                    .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
                }
            }
            loop diagnostic in rewrite.diagnostics -> diagnostics.push(diagnostic)
            sema_inline_lift_nested(child_body, path, nested, bindings, lifted, owners, diagnostics)
        }
    }
}

// Every module's functions and constants are lifted (top-level ones in
// sema_inline_modules_lower, nested ones by sema_inline_lift_nested), and a
// module test is never registered: functions, constants and tests leave the
// lowered program.
sema_inline_strip_members: fn(body: [Item]) -> [Item] Never! {
    kept := [Item]{}
    loop item in body {
        if item == {
            .Func(_) | .Const(_) | .Test(_) -> { next }
            .CodeModule(child) -> {
                updated := child.copy()
                if child.body == .Val(child_body) {
                    updated.body = Val(sema_inline_strip_members(child_body))
                }
                kept.push(Item.CodeModule{value: updated})
            }
            .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {
                kept.push(item.copy())
            }
        }
    }
    kept
}

// Whether a module body, or a module nested in it, declares one name twice.
sema_inline_repeats_name: fn(body: [Item]) -[]> Bool {
    seen := [String:Bool]{}
    loop item in body {
        name: sema_registration_root_name(item)
        if name != "" {
            if seen.get(name) != None -> return true
            seen[name] = true
        }
        if item == .CodeModule(child) && child.body == .Val(child_body) && sema_inline_repeats_name(child_body) {
            return true
        }
    }
    false
}

// An inline module body is one namespace, as a file's top level is
// (sema_registration_add_root), whatever kind each declaration is: a second
// declaration of a name is E0105 and leaves the body, so it lowers no member
// and is reported once.
sema_inline_refuse_repeated_names: fn(body: &[Item], diagnostics: &[Diagnostic]) -[]> {
    seen := [String:Bool]{}
    index := 0
    loop index < body.len() {
        name: sema_registration_root_name(body[index])
        if name != "" && seen.get(name) != None {
            why: if body[index] == .Func(_) -> "every function needs a unique name so calls aren't ambiguous" else -> "module declarations share one namespace"
            diagnostics.push(sema_defined_twice(name, why, sema_registration_root_span(body[index])))
            loop later in index..<body.len() - 1 -> body[later] = body[later + 1]
            _: body.pop()
            next
        }
        if name != "" -> seen[name] = true
        if body[index] == .CodeModule(child) && child.body == .Val(child_body) && sema_inline_repeats_name(child_body) {
            members := child_body
            sema_inline_refuse_repeated_names(members, diagnostics)
            updated := child
            updated.body = Val(members)
            body[index] = Item.CodeModule{value: updated}
        }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// The pass.

sema_inline_rewrite_item: fn(rewrite: &SemaInlineRewrite, item: Item) -> Item Never! {
    if item == {
        .Func(function) -> Item.Func{value: sema_inline_rewrite_func(rewrite, function)}
        .Struct(definition) -> Item.Struct{value: sema_inline_rewrite_struct(rewrite, definition, "")}
        .Enum(definition) -> Item.Enum{value: sema_inline_rewrite_enum(rewrite, definition, "")}
        .Impl(definition) -> {
            updated := definition
            updated.methods = sema_inline_rewrite_funcs(rewrite, definition.methods)
            Item.Impl{value: updated}
        }
        .Test(definition) -> {
            updated := definition
            saved: rewrite.locals.len()
            updated.params = sema_inline_rewrite_params(rewrite, definition.params)
            updated.pre = sema_inline_rewrite_clauses(rewrite, definition.pre)
            updated.body = sema_inline_rewrite_stmts(rewrite, definition.body)
            sema_inline_restore_locals(rewrite, saved)
            Item.Test{value: updated}
        }
        // copy: the rewrite walks the module program by borrowed payload views (Jet has no
        // consuming match), so an unchanged item kind is copied into the rebuilt program, while the
        // caller's program keeps the original.
        .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> item.copy()
    }
}

// Lowers `program`'s inline modules in place; a program without one is left
// untouched (not copied).
sema_inline_modules_lower: fn(program: &Program, diagnostics: &[Diagnostic]) -> SemaInlinePreparedBindings {
    if !sema_inline_modules_any_body(program.items) {
        return SemaInlinePreparedBindings{imports: [String:SemaInlineFunctionBinding]{}, modules: [SemaInlineModuleSurface]{}}
    }

    // 0. A module body declares each name once, at every depth.
    loop index in 0..<program.items.len() {
        refused := Item?{None}
        if program.items[index] == .CodeModule(definition) && definition.body == .Val(body) && sema_inline_repeats_name(body) {
            members := body
            sema_inline_refuse_repeated_names(members, diagnostics)
            updated := definition
            updated.body = Val(members)
            refused = Val(Item.CodeModule{value: updated})
        }
        program.items[index] = refused.move() ?? next
    }

    // 1. Member types, in item order, then the enclosing file's qualified
    //    names. Each inline module is hoisted in place; every other item
    //    stays where it is.
    hoist := SemaInlineHoist{declarations: [Item]{}, exported: [String:Type]{}, has_exported: false, private_types: [String:Span]{}}
    loop index in 0..<program.items.len() {
        hoisted := Item?{None}
        if program.items[index] == .CodeModule(definition) {
            lowered: sema_inline_hoist_module(definition, definition.name, hoist)
            hoisted = Val(Item.CodeModule{value: lowered.code_module})
        }
        // The module item's view ends above, so its slot takes the hoisted item.
        program.items[index] = hoisted.move() ?? next
    }
    type_imports := [String:Bool]{}
    if hoist.has_exported {
        exported := sema_inline_rewrite_empty()
        exported.types = hoist.exported
        exported.private_types = hoist.private_types
        sema_inline_bind_type_imports(program.imports, exported, type_imports)
        program.items = sema_inline_rewrite_exported(program.items.move(), exported)
        loop diagnostic in exported.diagnostics -> diagnostics.push(diagnostic)
    }

    // 2. Module functions, top-level and nested, become their member
    //    identities, with each module's own `use` bindings applied to its
    //    member bodies.
    file_aliases := [String:Bool]{}
    loop declaration in program.imports {
        if declaration.kind == {
            .Unqualified(_, _, _, _, _) -> {}
            .File(_, _) | .Module(_, _) -> file_aliases[declaration.alias] = true
        }
    }
    surfaces := [SemaInlineModuleSurface]{}
    inline_names := [String:Bool]{}
    loop item_index in 0..<program.items.len() {
        item: program.items[item_index]
        if item == .CodeModule(definition) {
            if definition.body == .Val(body) {
                inline_names[definition.name] = true
                surface := SemaInlineModuleSurface{name: definition.name, path: definition.name, private_to: None, functions: [String:Bool]{}, constants: [String:Bool]{}, private_members: [String:Span]{}, reexports: [String:SemaInlineTarget]{}, broken: [String:Bool]{}}
                sema_inline_surface_members(surface, body, !definition.is_pub && !definition.is_package_pub)
                surfaces.push(surface)
            }
        }
    }
    sema_inline_resolve_reexports(program.items, surfaces, diagnostics)
    sema_inline_check_private_module_aliases(program.items, surfaces, diagnostics)
    nested := [SemaInlineModuleSurface]{}
    nested_bindings := [SemaInlineRewrite]{}
    loop item in program.items {
        if item == .CodeModule(definition) {
            if definition.body == .Val(body) {
                sema_inline_collect_nested(body, definition.name, program.imports, surfaces, file_aliases, sema_inline_module_aliases(definition, definition.name, program.imports, [String:String]{}), nested, nested_bindings)
            }
        }
    }
    lowered_items := [Item]{}
    // Each lifted member function's module path: the file pass rewrites its
    // body as that module's, so its `priv` reads stay inside.
    owners := [String:String]{}
    loop item_index in 0..<program.items.len() {
        item: program.items[item_index]
        if item == .CodeModule(definition) {
            if definition.body == .Val(body) {
                siblings := sema_inline_rewrite_empty()
                siblings.sibling_module = definition.name
                siblings.modules = sema_inline_scope_surfaces(nested, definition.name)
                siblings.aliases = sema_inline_module_aliases(definition, definition.name, program.imports, [String:String]{})
                surface_index := -1
                loop (index, surface) in surfaces {
                    if surface.name == definition.name -> surface_index = index
                }
                if surface_index >= 0 {
                    siblings.siblings = surfaces[surface_index].functions
                    updated_surface := surfaces[surface_index]
                    updated_surface.reexports = sema_inline_bind_module_imports(definition, surfaces, file_aliases, siblings)
                    surfaces[surface_index] = updated_surface
                }
                lifted := [Item]{}
                sema_inline_bind_constants(body, definition.name, siblings)
                loop inner in body {
                    if inner == {
                        .Func(function) -> {
                            member := sema_inline_rewrite_func(siblings, function)
                            member.name = sema_inline_member_name(definition.name, function.name)
                            owners[member.name] = definition.name.copy()
                            lifted.push(Item.Func{value: member})
                        }
                        .Const(constant) -> {
                            lifted.push(sema_inline_lift_constant(siblings, constant, definition.name))
                        }
                        .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
                    }
                }
                loop diagnostic in siblings.diagnostics -> diagnostics.push(diagnostic)
                sema_inline_lift_nested(body, definition.name, nested, nested_bindings, lifted, owners, diagnostics)
                module_item := definition
                stripped := [Item]{}
                loop kept in sema_inline_strip_members(body) {
                    // A refused `tools: helpers` leaves the body with its E0609.
                    if kept == .ModuleAlias(alias) && surface_index >= 0 && surfaces[surface_index].broken.get(alias.name) != None {
                        next
                    }
                    stripped.push(kept)
                }
                module_item.body = Val(stripped)
                lowered_items.push(Item.CodeModule{value: module_item})
                loop member in lifted -> lowered_items.push(member)
                next
            }
        }
        lowered_items.push(item.copy())
    }
    loop declaration in hoist.declarations -> lowered_items.push(declaration)

    // 3. Qualified calls and `use` bindings, in every body of the file.
    calls := sema_inline_rewrite_empty()
    imports := sema_inline_bind_imports(program, surfaces, inline_names, type_imports, calls)
    sema_inline_core_imports(program.items, program.imports, imports)
    sema_inline_alias_imports(program.items, "", program.imports, imports)
    loop surface in nested -> surfaces.push(surface)
    calls.modules = surfaces.move()
    rewritten := [Item]{}
    loop item in lowered_items {
        calls.sibling_module = ""
        if item == .Func(function) {
            if owners.get(function.name) == .Val(owner) -> calls.sibling_module = owner.copy()
        }
        rewritten.push(sema_inline_rewrite_item(calls, item))
    }
    program.items = rewritten.move()
    program.imports = imports
    loop diagnostic in calls.diagnostics -> diagnostics.push(diagnostic)
    SemaInlinePreparedBindings{imports: calls.imported.move(), modules: calls.modules.move()}
}

// Whether `items` declares an inline module with a body; each item is read
// in place.
sema_inline_modules_any_body: fn(items: [Item]) -> Bool Never! {
    loop item in items {
        if item == .CodeModule(definition) {
            if definition.body != None -> return true
        }
    }
    false
}

#Test("private inline member types resolve in the enclosing file without becoming public") {
    span: Span{start: 0, end: 1}
    carrier: ast_struct("OrderedRow", span, span)
    helper: ast_func("compare", span, span)
    internal: CodeModule{name: "internal", name_span: span, is_pub: false, is_package_pub: false, body: Val([Item]{Item.Struct{value: carrier}, Item.Func{value: helper}}), imports: [ImportDecl]{}, web_target: None, instance_identity: None, span: span}
    consumer := ast_func("execute", span, span)
    consumer.is_pub = true
    consumer.return_type = Val(Type.List{element: Type.Named{name: "internal.OrderedRow"}})
    program := ast_program()
    program.items = [Item]{Item.CodeModule{value: internal}, Item.Func{value: consumer}}
    diagnostics := [Diagnostic]{}
    _: sema_inline_modules_lower(program, diagnostics)
    assert(diagnostics.is_empty())
    resolved := false
    private_type := false
    private_function := false
    loop item in program.items {
        if item == {
            .Func(function) -> {
                if function.name == "execute" {
                    resolved = function.return_type == Val(Type.List{element: Type.Named{name: sema_inline_type_name("internal", "OrderedRow")}})
                }
                if function.name == sema_inline_member_name("internal", "compare") {
                    private_function = !function.is_pub && !function.is_package_pub
                }
            }
            .Struct(definition) -> {
                if definition.name == sema_inline_type_name("internal", "OrderedRow") {
                    private_type = !definition.is_pub && !definition.is_package_pub
                }
            }
            .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    assert(resolved && private_type && private_function)
}

#Test("inline module members read as values name their member identities") {
    span: Span{start: 0, end: 1}
    total: ast_func("total", span, span)
    wrap := ast_func("wrap", span, span)
    wrap.body = [Stmt]{Stmt.Expr{expr: Expr.Ident{name: "total", span: span, id: AST_NODE_GENERATED}}}
    rate: ast_const("RATE", span, span, Expr.Int{value: 3, span: span, width: None, raw: None, id: AST_NODE_GENERATED})
    pricing: CodeModule{name: "pricing", name_span: span, is_pub: false, is_package_pub: false, body: Val([Item]{Item.Func{value: total}, Item.Func{value: wrap}, Item.Const{value: rate}}), imports: [ImportDecl]{}, web_target: None, instance_identity: None, span: span}
    consumer := ast_func("execute", span, span)
    consumer.body = [Stmt]{
        Stmt.Expr{expr: Expr.Field{base: Expr.Ident{name: "pricing", span: span, id: AST_NODE_GENERATED}, member: "total", span: span, id: AST_NODE_GENERATED}},
        Stmt.Expr{expr: Expr.Field{base: Expr.Ident{name: "pricing", span: span, id: AST_NODE_GENERATED}, member: "RATE", span: span, id: AST_NODE_GENERATED}},
    }
    program := ast_program()
    program.items = [Item]{Item.CodeModule{value: pricing}, Item.Func{value: consumer}}
    diagnostics := [Diagnostic]{}
    _: sema_inline_modules_lower(program, diagnostics)
    assert(diagnostics.is_empty())
    names := [String]{}
    loop item in program.items {
        if item == .Func(function) {
            if function.name != "execute" && function.name != sema_inline_member_name("pricing", "wrap") {
                next
            }
            loop statement in function.body {
                if statement == .Expr(value) {
                    if value == .Ident(name, _, _) -> names.push(name)
                }
            }
        }
    }
    total_name: sema_inline_member_name("pricing", "total")
    assert(names.len() == 3)
    assert(names.contains(total_name) && names.contains(sema_inline_member_name("pricing", "RATE")))
}

#Test("an unknown inline module member read as a value is E0608") {
    span: Span{start: 0, end: 1}
    pricing: CodeModule{name: "pricing", name_span: span, is_pub: false, is_package_pub: false, body: Val([Item]{Item.Func{value: ast_func("total", span, span)}}), imports: [ImportDecl]{}, web_target: None, instance_identity: None, span: span}
    consumer := ast_func("execute", span, span)
    consumer.body = [Stmt]{Stmt.Expr{expr: Expr.Field{base: Expr.Ident{name: "pricing", span: span, id: AST_NODE_GENERATED}, member: "missing", span: span, id: AST_NODE_GENERATED}}}
    program := ast_program()
    program.items = [Item]{Item.CodeModule{value: pricing}, Item.Func{value: consumer}}
    diagnostics := [Diagnostic]{}
    _: sema_inline_modules_lower(program, diagnostics)
    assert(diagnostics.len() == 1 && diagnostics[0].code == "E0608")
}

// `use geo.[Point, double]` over an inline module `geo`: one file import
// row; the module's `Point` is public unless `public_point` is false.
priv sema_inline_test_type_import: fn(public_point: Bool) -[]> {program: Program, consumer: String} {
    span: Span{start: 0, end: 1}
    point := ast_struct("Point", span, span)
    point.is_pub = public_point
    double := ast_func("double", span, span)
    double.is_pub = true
    geo: CodeModule{name: "geo", name_span: span, is_pub: true, is_package_pub: false, body: Val([Item]{Item.Struct{value: point}, Item.Func{value: double}}), imports: [ImportDecl]{}, web_target: None, instance_identity: None, span: span}
    consumer := ast_func("origin", span, span)
    consumer.return_type = Val(Type.Named{name: "Point"})
    program := ast_program()
    program.items = [Item]{Item.CodeModule{value: geo}, Item.Func{value: consumer}}
    items: [ImportedItem]{ImportedItem{original: "Point", alias: None}, ImportedItem{original: "double", alias: None}}
    program.imports = [ImportDecl]{ImportDecl{kind: ImportKind.Unqualified{module_alias: "geo", module_alias_span: span, items: items, items_span: span, span: span}, alias: "geo", alias_span: span, span: span, item_spans: [Span]{span, span}, local_spans: [Span]{span, span}, is_pub: false, is_package_pub: false, inline_version: None}}
    {program: program, consumer: "origin"}
}

#Test("a type and a function import from one inline module by their own names") {
    made := sema_inline_test_type_import(true)
    diagnostics := [Diagnostic]{}
    bindings: sema_inline_modules_lower(made.program, diagnostics)
    assert(diagnostics.is_empty())
    assert(bindings.imports.get("double") != None)
    resolved := false
    loop item in made.program.items {
        if item == .Func(function) {
            if function.name == made.consumer {
                resolved = function.return_type == Val(Type.Named{name: sema_inline_type_name("geo", "Point")})
            }
        }
    }
    assert(resolved)
}

#Test("importing a priv type of an inline module by its name is E0605") {
    made := sema_inline_test_type_import(false)
    diagnostics := [Diagnostic]{}
    _: sema_inline_modules_lower(made.program, diagnostics)
    assert(diagnostics.len() == 1 && diagnostics[0].code == "E0605")
}

// The member identity `run`'s first statement calls once `source` lowers,
// with the lowering's diagnostic codes.
sema_inline_test_run_call: fn(source: String) -[]> {callee: String, codes: [String]} {
    parsed := parse_source(source.bytes())
    assert(parsed.diagnostics.is_empty())
    diagnostics := [Diagnostic]{}
    _: sema_inline_modules_lower(parsed.program, diagnostics)
    callee := ""
    loop item in parsed.program.items {
        if item == .Func(function) && function.name == "run" && function.body.len() > 0 {
            if function.body[0] == .Expr(value) && value == .Call(call, _) -> callee = call.name
        }
    }
    {callee: callee, codes: (loop diagnostic in diagnostics -> diagnostic.code)}
}

#Test("re-exports between inline modules resolve through a chain written in any order") {
    source: "left: module {{\n    shout: right.loud\n}}\n\nright: module {{\n    loud: deep.shout\n}}\n\ndeep: module {{\n    shout: fn(s: String) -> String {{ s }}\n}}\n\nrun: fn() {{\n    left.shout(\"hi\")\n}}\n"
    lowered: sema_inline_test_run_call(source)
    assert(lowered.codes.is_empty())
    assert(lowered.callee == sema_inline_member_name("deep", "shout"))
}

#Test("a re-export chain that leads back to itself is one E0604") {
    source: "left: module {{\n    shout: right.shout\n}}\n\nright: module {{\n    shout: left.shout\n}}\n\nrun: fn() {{\n    left.shout(\"hi\")\n}}\n"
    lowered: sema_inline_test_run_call(source)
    assert(lowered.codes.len() == 1 && lowered.codes[0] == "E0604")
}

#Test("a module body naming a priv module is E0609, whose fix lists its members") {
    source: "priv helpers: module {{\n    double: fn(n: Int) -> Int {{ n * 2 }}\n\n    half: fn(n: Int) -> Int {{ n / 2 }}\n}}\n\nshapes: module {{\n    tools: helpers\n}}\n\nrun: fn() {{\n    shapes.tools.double(4)\n}}\n"
    lowered: sema_inline_test_run_call(source)
    assert(lowered.codes.len() == 1 && lowered.codes[0] == "E0609")
    parsed := parse_source(source.bytes())
    diagnostics := [Diagnostic]{}
    _: sema_inline_modules_lower(parsed.program, diagnostics)
    assert(diagnostics[0].fix.contains("`double: helpers.double`, `half: helpers.half`"), diagnostics[0].fix)
    // The refused binding leaves the body, so `shapes` still lowers.
    loop item in parsed.program.items {
        if item == .CodeModule(definition) {
            assert(sema_inline_module_lowered(definition), definition.name)
        }
    }
}

#Test("a dotted arm and a struct pattern head name an inline module type as type position does") {
    rewrite := sema_inline_rewrite_empty()
    rewrite.types["geo.Point"] = Type.Named{name: "M3GeoPoint"}
    rewrite.types["Point"] = Type.Named{name: "M3GeoPoint"}
    span: Span{start: 0, end: 1}
    dotted: sema_inline_rewrite_pattern(rewrite, Pattern.Variant{variant: "geo.Point", bindings: [PatSlot]{PatSlot.Bind{name: "p", span: span}}, leading_dot: true, span: span})
    assert(dotted == .Variant("M3GeoPoint", _, true, _))
    // A bare arm may name an enum case, so it stays as written.
    bare: sema_inline_rewrite_pattern(rewrite, Pattern.Variant{variant: "Point", bindings: [PatSlot]{}, leading_dot: true, span: span})
    assert(bare == .Variant("Point", _, _, _))
    nested: sema_inline_rewrite_pattern(rewrite, Pattern.Present{binding: "_", binding_span: span, inner: Val(Pattern.Struct{fields: [StructPatField]{}, rest: Val(span), span: span, type_name: Val(PatternTypeHead{name: "Point", span: span})}), span: span})
    if nested == .Present(_, _, inner, _) && inner == .Val(.Struct(_, _, _, head)) {
        assert((head?.name ?? "") == "M3GeoPoint")
    } else { panic("the struct pattern lost its head") }
}

#Test("an inline module body that declares a name twice is one E0105, whatever kinds share it") {
    source: "m: module {{\n    t: module {{\n        f: fn() {{}}\n    }}\n\n    t: fn() {{}}\n}}\n\nrun: fn() {{\n    m.t.f()\n}}\n"
    lowered: sema_inline_test_run_call(source)
    assert(lowered.codes.len() == 1 && lowered.codes[0] == "E0105", lowered.codes.join(", "))
    // The first declaration keeps the name.
    assert(lowered.callee == sema_inline_member_name("m.t", "f"), lowered.callee)
    parsed := parse_source(source.bytes())
    diagnostics := [Diagnostic]{}
    _: sema_inline_modules_lower(parsed.program, diagnostics)
    assert(diagnostics[0].what == "`t` is defined twice", diagnostics[0].what)
    assert(diagnostics[0].span == Val(Span{start: source.find("t: fn"), end: source.find("t: fn") + 1}))
}

#Test("a module nested in an inline module shares its parent body's names") {
    source: "outer: module {{\n    inner: module {{\n        Shape: struct {{ side: Int }}\n\n        Shape: module {{\n            f: fn() {{}}\n        }}\n\n        g: fn() {{}}\n\n        g: fn() {{}}\n    }}\n}}\n\nrun: fn() {{\n    outer.inner.g()\n}}\n"
    lowered: sema_inline_test_run_call(source)
    assert(lowered.codes.len() == 2 && lowered.codes[0] == "E0105" && lowered.codes[1] == "E0105", lowered.codes.join(", "))
    assert(lowered.callee == sema_inline_member_name("outer.inner", "g"), lowered.callee)
}
