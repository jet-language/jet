// Private continuation of canonical Sema.Expressions / CheckerCoreLib.math_layout.
use jet_foundation.[Type, BinOp, Syntax, Registry, KnowledgeFact, Measure]
use jet_numeric.[is_decimal_type_name, type_is_decimal]

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:4
pub fn is_math_type(name: String) -> Bool { return is_simd_lane_type(name) || is_linalg_type(name) }
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:9
pub fn is_simd_lane_type(name: String) -> Bool { return Syntax.is_simd_lane_type(name) }
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:14
pub fn is_linalg_type(name: String) -> Bool { return ["Vec2", "Vec3", "Vec4", "Mat3", "Mat4"].contains(name) }

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:21
pub fn math_scalar_ty(name: String) -> Type {
    return if Syntax.simd_lane_layout(name).map(pair -> pair.0) == {
        .Val(.F32) -> Type.Float32
        .Val(.I8) -> Type.IntN{signed: true, bits: 8}
        .Val(.I16) -> Type.IntN{signed: true, bits: 16}
        .Val(.I32) -> Type.IntN{signed: true, bits: 32}
        .Val(.I64) -> Type.IntN{signed: true, bits: 64}
        .Val(.U8) -> Type.IntN{signed: false, bits: 8}
        .Val(.U16) -> Type.IntN{signed: false, bits: 16}
        .Val(.U32) -> Type.IntN{signed: false, bits: 32}
        .Val(.U64) -> Type.IntN{signed: false, bits: 64}
        .Val(.F64) | .None -> Type.Float
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:63
pub fn registered_lane_arity(name: String) -> USize? {
    return Type.Named(~name).knowledge_vector().facts(Registry.type_plane("Measure")).find_map(fact -> if fact == {
        .Measure(measure) if measure.kind() == "lane" -> measure.literal_value().and_then(value -> USize.try_from(value).ok())
        _ -> None
    })
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:77
pub fn math_arity(name: String) -> USize {
    if Syntax.simd_lane_arity(name) == .Val(arity) -> return arity
    if registered_lane_arity(name) == .Val(arity) -> return arity
    return if name == { "Vec2" -> 2; "Vec3" -> 3; "Vec4" -> 4; "Mat3" -> 9; "Mat4" -> 16; _ -> 0 }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:96
pub fn is_swizzleable_math_type(name: String) -> Bool { return ["F32x4", "F64x2", "Vec2", "Vec3", "Vec4"].contains(name) }

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:102
pub enum SwizzleParse {
    Ok([USize])
    InvalidLane{lane: Char}
    NotSwizzle
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:113
pub fn parse_swizzle_member(member: String, type_name: String) -> SwizzleParse {
    if !is_swizzleable_math_type(type_name) || member.is_empty() || member.len() > 4 -> return SwizzleParse.NotSwizzle
    max :: math_arity(type_name)
    lanes: [USize] := []
    &lanes.reserve(member.len())
    for c in member.chars() {
        idx: USize :: if c == { 'x' -> 0; 'y' -> 1; 'z' -> 2; 'w' -> 3; _ -> return SwizzleParse.NotSwizzle }
        if idx >= max -> return SwizzleParse.InvalidLane{lane: c}
        &lanes.push(idx)
    }
    return SwizzleParse.Ok(^lanes)
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:137
pub fn swizzle_read_type(type_name: String, lane_count: USize) -> Type {
    if lane_count == 1 -> return math_scalar_ty(type_name)
    if is_simd_lane_type(type_name) && lane_count == math_arity(type_name) -> return Type.Named(~type_name)
    name :: if lane_count == { 2 -> "Vec2"; 3 -> "Vec3"; 4 -> "Vec4"; _ -> panic("swizzle lane count 2..=4") }
    return Type.Named(name)
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:153
pub fn swizzle_write_overlaps(lanes: [USize]) -> Bool {
    seen := [false; 4]
    for lane in lanes {
        if seen[lane] -> return true
        seen[lane] = true
    }
    return false
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:168
pub fn math_constructor_arg_types(name: String) -> [Type]? {
    if !is_math_type(name) -> return None
    return Val([math_scalar_ty(name); math_arity(name)])
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:180
pub fn math_array_bridge_ty(name: String) -> Type? {
    if !is_math_type(name) -> return None
    return Val(Type.FixedList{elem: math_scalar_ty(name), len: Measure.literal("length", math_arity(name) as U64)})
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:193
pub fn math_method_return(name: String, method: String, n_args: USize) -> Type? {
    scalar :: math_scalar_ty(name)
    self_ty :: Type.Named(~name)
    if is_simd_lane_type(name) {
        return if (method, n_args) == {
            ("sum" | "product" | "min" | "max", 0) | ("reduce", 1) -> Val(^scalar)
            ("to_array", 0) -> math_array_bridge_ty(name)
            _ -> None
        }
    }
    return if name == {
        "Vec2" | "Vec3" | "Vec4" -> if (method, n_args) == {
            ("dot", 1) | ("length", 0) -> Val(Type.Float)
            ("cross", 1) if name == "Vec3" -> Val(^self_ty)
            ("normalize", 0) -> Val(^self_ty)
            ("to_array", 0) -> math_array_bridge_ty(name)
            _ -> None
        }
        "Mat3" | "Mat4" -> if (method, n_args) == {
            ("matmul", 1) | ("transpose", 0) -> Val(^self_ty)
            ("transform", 1) -> Val(Type.Named(if name == "Mat3" -> "Vec3" else -> "Vec4"))
            ("to_array", 0) -> math_array_bridge_ty(name)
            _ -> None
        }
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:234
pub fn math_static_return(name: String, method: String, n_args: USize) -> Type? {
    if !is_math_type(name) -> return None
    return if (method, n_args) == { ("splat" | "from_array", 1) -> Val(Type.Named(~name)); _ -> None }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:247
pub fn math_static_arg_ty(name: String, method: String) -> Type? {
    return if method == { "splat" -> Val(math_scalar_ty(name)); "from_array" -> math_array_bridge_ty(name); _ -> None }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:257
pub fn math_method_arg_ty(name: String, method: String) -> Type? {
    return if (name, method) == {
        (_, "dot" | "cross" | "matmul") -> Val(Type.Named(~name))
        ("Mat3", "transform") -> Val(Type.Named("Vec3"))
        ("Mat4", "transform") -> Val(Type.Named("Vec4"))
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:270
pub fn simd_reduce_markers() -> [String] { return Syntax.REDUCE_OP_VALUES }

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:277
pub fn math_binop_result(op: BinOp, lt: String, rt: String) -> Type? {
    same :: lt == rt
    return if op == {
        .Add | .Sub if same && is_math_type(lt) -> Val(Type.Named(~lt))
        .Mul -> if (lt, rt) == {
            (a, b) if a == b && is_math_type(a) -> Val(Type.Named(~a))
            ("Mat3", "Vec3") -> Val(Type.Named("Vec3"))
            ("Mat4", "Vec4") -> Val(Type.Named("Vec4"))
            _ -> None
        }
        .Div if same && is_simd_lane_type(lt) -> Val(Type.Named(~lt))
        .Eq | .Ne if same && is_math_type(lt) -> Val(Type.Bool)
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:297
pub fn math_scalar_operand(ty: Type) -> Bool {
    return if ty == { .Int | .Float | .Float32 | .InlineRange{..} -> true; .Named(name) -> name == "Decimal" || name == "F64"; _ -> false }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:305
pub fn math_scalar_binop_result(op: BinOp, math_name: String, scalar: Type) -> Type? {
    if !is_math_type(math_name) || (op != BinOp.Mul && op != BinOp.Div) || !math_scalar_operand(scalar) -> return None
    return Val(Type.Named(~math_name))
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:323
pub fn is_layout_axis_type(name: String) -> Bool { return name == "HVar" || name == "VVar" || name == "LengthVar" }
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:329
pub fn is_layout_type(name: String) -> Bool { return is_layout_axis_type(name) || name == "Constraint" || name == "Layout" }

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:338
pub enum LayoutAxis { H; V; Neutral }

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:344
pub fn layout_axis_of(ty: Type) -> LayoutAxis? {
    return if ty == {
        .Named(n) if n == "HVar" -> Val(LayoutAxis.H)
        .Named(n) if n == "VVar" -> Val(LayoutAxis.V)
        .Named(n) if n == "LengthVar" -> Val(LayoutAxis.Neutral)
        .Int | .InlineRange{..} | .Float -> Val(LayoutAxis.Neutral)
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:357
pub fn layout_axis_combine(a: LayoutAxis, b: LayoutAxis) -> LayoutAxis? {
    return if (a, b) == {
        (.H, .V) | (.V, .H) -> None
        (.H, _) | (_, .H) -> Val(LayoutAxis.H)
        (.V, _) | (_, .V) -> Val(LayoutAxis.V)
        (.Neutral, .Neutral) -> Val(LayoutAxis.Neutral)
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:367
pub fn layout_axis_type_name(axis: LayoutAxis) -> String { return if axis == { .H -> "HVar"; .V -> "VVar"; .Neutral -> "LengthVar" } }

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:382
pub fn layout_binop_result(op: BinOp, lt: Type, rt: Type) -> Result<Type, Unit>? {
    l_is_layout :: if lt == { .Named(n) -> is_layout_axis_type(n); _ -> false }
    r_is_layout :: if rt == { .Named(n) -> is_layout_axis_type(n); _ -> false }
    if !l_is_layout && !r_is_layout -> return None
    la :: layout_axis_of(lt)?
    ra :: layout_axis_of(rt)?
    return if op == {
        .Add | .Sub -> Val(if layout_axis_combine(la, ra) == { .Val(axis) -> Ok(Type.Named(layout_axis_type_name(axis))); .None -> Err(()) })
        .Ge | .Le | .Eq -> Val(if layout_axis_combine(la, ra) == { .Val(_) -> Ok(Type.Named("Constraint")); .None -> Err(()) })
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:414
pub fn layout_method_return(name: String, method: String, n_args: USize) -> Type? {
    return if (name, method, n_args) == {
        ("Layout", "h", 2) -> Val(Type.Named("HVar"))
        ("Layout", "v", 2) -> Val(Type.Named("VVar"))
        ("Layout", "value", 1) -> Val(Type.Float)
        ("Layout", "suggest", 2) -> Val(Type.Named("Unit"))
        ("Layout", "is_feasible", 0) -> Val(Type.Bool)
        ("Layout", "conflict", 0) -> Val(Type.List(Type.String))
        ("Constraint", "required" | "strong" | "medium" | "weak", 0) -> Val(Type.Named("Constraint"))
        _ -> None
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:439
pub fn layout_method_arg_ty(method: String, arg_index: USize) -> Type? {
    return if (method, arg_index) == { ("h" | "v", 0 | 1) -> Val(Type.String); ("suggest", 1) -> Val(Type.Float); _ -> None }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:448
pub fn precise_binop_result(op: BinOp, lt: String, rt: String) -> Type? {
    same :: lt == rt
    return if op == {
        .Add | .Sub | .Mul if same && is_decimal_type_name(lt) -> Val(Type.Named(Syntax.TYPE_DECIMAL))
        .Add | .Sub | .Mul | .Div if same && lt == Syntax.TYPE_FRACTION -> Val(Type.Named(Syntax.TYPE_FRACTION))
        .Add | .Sub | .Mul | .Div if same && lt == Syntax.TYPE_COMPLEX -> Val(Type.Named(Syntax.TYPE_COMPLEX))
        .Eq | .Ne if same && is_decimal_type_name(lt) -> Val(Type.Bool)
        .Eq | .Ne if same && lt == Syntax.TYPE_FRACTION -> Val(Type.Bool)
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:473
pub fn precise_mix_error(lt: Type, rt: Type) -> (String, String, String)? {
    if (type_is_decimal(lt) && rt.is_float()) || (type_is_decimal(rt) && lt.is_float()) {
        return Val(("E0131", "`Float` and `Decimal` can't be mixed — got `{lt.show()}` and `{rt.show()}`", "use `Decimal(\"…\")` for exact money arithmetic; `Float` is for approximate science"))
    }
    return None
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:492
pub fn is_geometry_type(name: String) -> Bool {
    return ["Point2", "Delta2", "Transform", "Transform2", "Ray2", "ScreenPoint", "WorldPoint", "ViewPoint", "CameraPoint", "DevicePoint", "ScreenDelta", "WorldDelta", "ViewDelta", "CameraDelta", "DeviceDelta"].contains(name)
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:513
pub fn geometry_point_space(name: String) -> String? {
    return if name == {
        "ScreenPoint" | "ScreenDelta" -> Val("Screen")
        "WorldPoint" | "WorldDelta" -> Val("World")
        "ViewPoint" | "ViewDelta" -> Val("View")
        "CameraPoint" | "CameraDelta" -> Val("Camera")
        "DevicePoint" | "DeviceDelta" -> Val("Device")
        _ -> None
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:524
pub fn geometry_is_point(ty: Type) -> Bool {
    return if ty == {
        .Named(name) -> ["ScreenPoint", "WorldPoint", "ViewPoint", "CameraPoint", "DevicePoint"].contains(name)
        .Apply{name, args} -> name == "Point2" && args.len() == 2
        _ -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:535
pub fn geometry_is_delta(ty: Type) -> Bool {
    return if ty == {
        .Named(name) -> ["ScreenDelta", "WorldDelta", "ViewDelta", "CameraDelta", "DeviceDelta"].contains(name)
        .Apply{name, args} -> name == "Delta2" && args.len() == 2
        _ -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:546
pub fn geometry_space(ty: Type) -> Type? {
    return if ty == {
        .Named(name) -> geometry_point_space(name).map(space -> Type.Named(space.strip_suffix("Point").or_else(() -> space.strip_suffix("Delta")).unwrap_or(space).to_string()))
        .Apply{name, args} if name == "Point2" || name == "Delta2" -> args.get(1).map(value -> ~value)
        _ -> None
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:564
pub fn geometry_scalar(ty: Type) -> Type { return if ty == { .Apply{args, ..} -> args.first().map(t -> ~t).unwrap_or(Type.Float); _ -> Type.Float } }
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:571
pub fn geometry_same_space(left: Type, right: Type) -> Bool { return geometry_space(left).is_some_and(space -> geometry_space(right) == Val(space)) }
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:575
pub fn geometry_generic(name: String, scalar: Type, space: Type) -> Type { return Type.Apply{name: ~name, args: [^scalar, ^space]} }
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:581
pub fn geometry_point_type(ty: Type, dynamic: Bool) -> Type {
    if dynamic -> return geometry_generic("Point2", geometry_scalar(ty), geometry_space(ty).expect("point has a space"))
    return ~ty
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:588
pub fn geometry_delta_type(ty: Type, dynamic: Bool) -> Type {
    if dynamic -> return geometry_generic("Delta2", geometry_scalar(ty), geometry_space(ty).expect("delta has a space"))
    return if ty == {
        .Named(name) -> {
            stock :: if name == {
                "ScreenPoint" -> Val("ScreenDelta")
                "WorldPoint" -> Val("WorldDelta")
                "ViewPoint" -> Val("ViewDelta")
                "CameraPoint" -> Val("CameraDelta")
                "DevicePoint" -> Val("DeviceDelta")
                _ -> None
            }
            stock.map_or_else(() -> ~ty, name -> Type.Named(name))
        }
        _ -> geometry_generic("Delta2", geometry_scalar(ty), geometry_space(ty).expect("delta has a space"))
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:613
pub fn geometry_dynamic(ty: Type) -> Bool { return if ty == { .Apply{name, ..} -> name == "Point2" || name == "Delta2"; _ -> false } }
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:620
pub fn geometry_result(ok: Type) -> Type { return Type.Result{ok: ^ok, err: Type.Named("TransformError")} }

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:627
pub fn geometry_binop_result(op: BinOp, left: Type, right: Type) -> Result<Type, Unit>? {
    if !(geometry_is_point(left) || geometry_is_point(right) || geometry_is_delta(left) || geometry_is_delta(right)) -> return None
    same :: geometry_same_space(left, right)
    dynamic :: geometry_dynamic(left) || geometry_dynamic(right)
    result :: if op == {
        .Add if same && geometry_is_point(left) && geometry_is_delta(right) -> Val(Ok(if dynamic -> geometry_result(geometry_point_type(left, true)) else -> ~left))
        .Add if same && geometry_is_delta(left) && geometry_is_point(right) -> Val(Ok(if dynamic -> geometry_result(geometry_point_type(right, true)) else -> ~right))
        .Add if same && geometry_is_delta(left) && geometry_is_delta(right) -> Val(Ok(if dynamic -> geometry_result(geometry_delta_type(left, true)) else -> ~left))
        .Sub if same && geometry_is_point(left) && geometry_is_delta(right) -> Val(Ok(if dynamic -> geometry_result(geometry_point_type(left, true)) else -> ~left))
        .Sub if same && geometry_is_point(left) && geometry_is_point(right) -> Val(Ok(if dynamic -> geometry_result(geometry_delta_type(left, true)) else -> geometry_delta_type(left, false)))
        .Sub if same && geometry_is_delta(left) && geometry_is_delta(right) -> Val(Ok(if dynamic -> geometry_result(geometry_delta_type(left, true)) else -> ~left))
        .Eq | .Ne if same && ((geometry_is_point(left) && geometry_is_point(right)) || (geometry_is_delta(left) && geometry_is_delta(right))) -> Val(Ok(Type.Bool))
        _ -> None
    }
    return result.or_else(() -> Val(Err(())))
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:697
pub fn geometry_transform_parts(ty: Type) -> (Type, Type, Type)? {
    if ty != .Apply{name, args} -> return None
    return if (name, args) == {
        ("Transform", [from, to]) -> Val((Type.Float, ~from, ~to))
        ("Transform2", [scalar, from, to]) -> Val((~scalar, ~from, ~to))
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:708
pub fn geometry_method_return(recv: Type, method: String, args: [Type]) -> Result<Type, Unit>? {
    if geometry_transform_parts(recv) == .Val((scalar, from, to)) {
        return Val(if method == {
            "then" if args.len() == 1 -> if args.first().and_then(geometry_transform_parts) == {
                .Val((next_scalar, next_from, next_to)) if next_scalar == scalar && next_from == to -> {
                    composed :: Type.Apply{name: if scalar == Type.Float -> "Transform" else -> "Transform2", args: if scalar == Type.Float -> [^from, ^next_to] else -> [^scalar, ^from, ^next_to]}
                    Ok(geometry_result(^composed))
                }
                _ -> Err(())
            }
            "inverse" if args.is_empty() -> Ok(geometry_result(Type.Apply{name: if scalar == Type.Float -> "Transform" else -> "Transform2", args: if scalar == Type.Float -> [^to, ^from] else -> [^scalar, ^to, ^from]}))
            "point" if args.len() == 1 && args.first().is_some_and(geometry_is_point) && args.first().and_then(geometry_space) == Val(from) -> Ok(geometry_result(geometry_generic("Point2", ^scalar, ^to)))
            "point_at_depth" if args.len() == 2 && args.first().is_some_and(geometry_is_point) && args.first().and_then(geometry_space) == Val(from) -> Ok(geometry_result(geometry_generic("Point2", ^scalar, ^to)))
            "ray" if args.len() == 1 && args.first().is_some_and(geometry_is_point) && args.first().and_then(geometry_space) == Val(from) -> Ok(geometry_result(Type.Apply{name: "Ray2", args: [^scalar, ^from, ^to]}))
            _ -> Err(())
        })
    }
    if geometry_is_point(recv) {
        if args.len() != 1 -> return Val(Err(()))
        arg :: args[0]
        dynamic :: geometry_dynamic(recv) || geometry_dynamic(arg)
        output :: if method == {
            "add" if geometry_is_delta(arg) -> Val(geometry_point_type(recv, dynamic))
            "sub" if geometry_is_point(arg) -> Val(geometry_delta_type(recv, dynamic))
            _ -> None
        }
        valid :: output.is_some() && geometry_space(recv) == geometry_space(arg)
        if !valid -> return Val(Err(()))
        value :: output.expect("validated geometry method result")
        return Val(Ok(if dynamic -> geometry_result(^value) else -> ^value))
    }
    if geometry_is_delta(recv) {
        if args.len() != 1 -> return Val(Err(()))
        arg :: args[0]
        dynamic :: geometry_dynamic(recv) || geometry_dynamic(arg)
        valid :: (method == "add" || method == "sub") && geometry_is_delta(arg) && geometry_space(recv) == geometry_space(arg)
        if !valid -> return Val(Err(()))
        output :: geometry_delta_type(recv, dynamic)
        return Val(Ok(if dynamic -> geometry_result(^output) else -> ^output))
    }
    return None
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:840
pub fn geometry_binop_diagnostic(op: BinOp, left: Type, right: Type) -> (String, String, String)? {
    if !(geometry_is_point(left) || geometry_is_delta(left) || geometry_is_point(right) || geometry_is_delta(right)) -> return None
    operation :: op.spell().to_string()
    expected := geometry_space(left).map(space -> space.show()).unwrap_or_else(() -> left.show())
    actual := geometry_space(right).map(space -> space.show()).unwrap_or_else(() -> right.show())
    if geometry_is_point(left) && geometry_is_point(right) {
        expected = "a displacement in {expected}"
        actual = "a point in {actual}"
    }
    return Val((^operation, ^expected, ^actual))
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:868
pub fn geometry_transform_diagnostic(recv: Type, method: String, args: [Type]) -> (String, String, String, String)? {
    if method != "then" || args.len() != 1 -> return None
    if (recv, args[0]) != (.Apply{name, args: recv_args}, .Apply{name: next_name, args: next_args}) -> return None
    middle_a :: if (name, recv_args) == { ("Transform", [_, to]) -> to; ("Transform2", [_, _, to]) -> to; _ -> return None }
    middle_b :: if (next_name, next_args) == { ("Transform", [next_from, _]) -> next_from; ("Transform2", [_, next_from, _]) -> next_from; _ -> return None }
    if middle_a == middle_b -> return None
    return Val((recv.show(), args[0].show(), middle_a.show(), middle_b.show()))
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:913
pub fn geometry_static_arg_types(name: String, method: String, owner_args: [Type]) -> [Type]? {
    return if (name, method) == {
        ("ScreenPoint" | "WorldPoint" | "ViewPoint" | "CameraPoint" | "DevicePoint" | "ScreenDelta" | "WorldDelta" | "ViewDelta" | "CameraDelta" | "DeviceDelta", "new") -> Val([Type.Float, Type.Float])
        ("Point2" | "Delta2", "new") if owner_args.len() == 2 -> Val([Type.Float, Type.Float, Type.Int])
        ("Transform", "affine") if owner_args.len() == 2 -> Val([Type.Float, Type.Float, Type.Float, Type.Float, Type.Float, Type.Float, Type.Int, Type.Int])
        ("Transform2", "affine") if owner_args.len() == 3 -> {
            scalar :: owner_args[0]
            Val([~scalar, ~scalar, ~scalar, ~scalar, ~scalar, ~scalar, Type.Int, Type.Int])
        }
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:965
pub fn geometry_static_return(name: String, method: String, n_args: USize) -> Type? {
    if !is_geometry_type(name) -> return None
    return if (name, method, n_args) == { (name, "new", 2) if geometry_point_space(name).is_some() -> Val(Type.Named(~name)); _ -> None }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/math_layout.rs:980
pub fn geometry_static_return_with_owner(name: String, method: String, n_args: USize, owner_args: [Type]) -> Type? {
    if (name == "Point2" || name == "Delta2") && method == "new" && n_args == 3 && owner_args.len() == 2 -> return Val(Type.Apply{name: ~name, args: ~owner_args})
    if (name == "Transform" || name == "Transform2") && method == "affine" && n_args == 8 && ((name == "Transform" && owner_args.len() == 2) || (name == "Transform2" && owner_args.len() == 3)) -> return Val(Type.Apply{name: ~name, args: ~owner_args})
    return geometry_static_return(name, method, n_args)
}
