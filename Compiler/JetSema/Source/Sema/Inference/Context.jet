// Shared generic inference context and proof rows.
//
// Inference is deliberately the only owner of substitutions for callable and
// nominal generic checking. Callers retain the resulting evidence rather than
// guessing whether a bound was checked.
use jet_foundation.[
    Span,
    TGenericParam,
    Type,
    TypeParam,
    type_identity_equal,
]

SemaInferenceTypeParam: struct {
    name: String
    bounds: [String]
    span: Span
    identity_key: String
    // The declaring module, where `bounds` name their traits ("": the
    // caller's own declaration or a Core signature's unbounded parameter).
    bound_module: String
}

SemaInferenceBinding: struct {
    name: String
    ty: Type
    source: String
}

SemaInferenceConflict: struct {
    param: String
    first: Type
    first_source: String
    second: Type
    second_source: String
}

SemaInferenceBoundEvidence: struct {
    param: String
    actual: Type
    bound: String
    satisfied: Bool
    source: Span
}

// The registration graph is not part of the context: solver entry points take
// it as a read parameter, so building a context never copies the graph.
SemaInferenceContext: struct {
    caller_module_identity: String
    caller_package_identity: String
    type_params: [SemaInferenceTypeParam]
    lexical_generic_params: [TGenericParam]
    expected: Type?
}

SemaInferenceResult: struct {
    substitutions: [SemaInferenceBinding]
    type_args: [Type]
    parameters: [Type]
    return_type: Type?
    evidence: [SemaInferenceBoundEvidence]
    complete: Bool
    compatible: Bool
}

sema_inference_type_params: fn(parameters: [TypeParam]) -> [SemaInferenceTypeParam] Never! {
    result: loop parameter in parameters -> SemaInferenceTypeParam{name: parameter.name, bounds: parameter.bounds, span: parameter.name_span, identity_key: "", bound_module: ""}
    result
}

sema_inference_registration_params: fn(parameters: [SemaRegistrationGenericParam]) -> [SemaInferenceTypeParam] Never! {
    result: loop parameter in parameters -> SemaInferenceTypeParam{name: parameter.name, bounds: parameter.bounds, span: parameter.span, identity_key: parameter.identity_key, bound_module: parameter.module_identity}
    result
}

sema_inference_bindings_for_type_args: fn(parameters: [SemaInferenceTypeParam], type_args: [Type]) -> [SemaInferenceBinding] Never! {
    if parameters.len() != type_args.len() -> return [SemaInferenceBinding]{}
    result: loop (index, parameter) in parameters -> SemaInferenceBinding{name: parameter.name, ty: type_args[index], source: "explicit type argument"}
    result
}

sema_inference_context: fn(caller_module_identity: String, caller_package_identity: String, type_params: [SemaInferenceTypeParam], lexical_generic_params: [TGenericParam], expected: Type?) -> SemaInferenceContext Never! {
    SemaInferenceContext{caller_module_identity: caller_module_identity, caller_package_identity: caller_package_identity, type_params: type_params, lexical_generic_params: lexical_generic_params, expected: expected}
}

sema_inference_binding_at: fn(bindings: [SemaInferenceBinding], name: String) -> SemaInferenceBinding? {
    loop binding in bindings {
        if binding.name == name -> return Val(binding)
    }
    None
}

sema_inference_bounds_checked: fn(parameters: [SemaInferenceTypeParam], evidence: [SemaInferenceBoundEvidence], substitutions: [SemaInferenceBinding]) -> Bool Never! {
    required_count := 0
    loop parameter in parameters {
        loop bound in parameter.bounds {
            required_count += 1
            found := false
            loop row in evidence {
                if row.param == parameter.name && row.bound == bound {
                    found = row.satisfied
                    expected: sema_inference_binding_at(substitutions, parameter.name)
                    if expected == {
                        .Val(binding) -> {
                            // A result binding is already resolved (sema_inference_declared_bindings).
                            if !type_identity_equal(row.actual, binding.ty) -> found = false
                        }
                        else -> {
                            found = false
                        }
                    }
                }
            }
            if !found -> return false
        }
    }
    if evidence.len() != required_count -> return false
    loop row in evidence {
        parameter_found := false
        loop parameter in parameters {
            if parameter.name == row.param {
                loop bound in parameter.bounds {
                    if bound == row.bound -> parameter_found = true
                }
            }
        }
        if !parameter_found -> return false
    }
    true
}
