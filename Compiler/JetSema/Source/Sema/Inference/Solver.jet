// One transactional generic solver for callable and nominal inference.
//
// Structural unification discovers substitutions; graph-aware TypeRelations
// validates the resulting signature and every declared bound. A concrete type
// mismatch is returned as `compatible: false` for the ordinary checker, while
// generic conflicts and unresolved parameters receive the canonical E0904.
use jet_foundation.[
    Diagnostic,
    TGenericParam,
    Span,
    Type,
    diagnostic_registry_row,
    dimension_identity,
    owned_trait_requires_listed,
    type_identity_equal,
    type_name,
]

sema_inference_parameter_index: fn(context: SemaInferenceContext, name: String) -> Int? {
    loop index in 0..<context.type_params.len() {
        if context.type_params[index].name == name -> return Val(index)
    }
    None
}

sema_inference_binding_index: fn(bindings: [SemaInferenceBinding], name: String) -> Int? {
    loop index in 0..<bindings.len() {
        if bindings[index].name == name -> return Val(index)
    }
    None
}

sema_inference_conflict: fn(conflict: &SemaInferenceConflict?, name: String, first: Type, first_source: String, second: Type, second_source: String) Never! {
    if conflict == None {
        conflict = Val(SemaInferenceConflict{param: name, first: first, first_source: first_source, second: second, second_source: second_source})
    }
}

// A callee type parameter spelled like one of the caller's in-scope
// parameters is a different variable: `wrap<T>` passing `[T]{value}` to
// `size<T>` binds the callee's `T` to the caller's `[T]`. The solver spells
// each such callee parameter with this suffix, so a caller `T` inside an
// argument never reads as the callee's own `T`. Substitutions, bound evidence
// and diagnostics carry the declared spelling.
SEMA_INFERENCE_CALLEE_SUFFIX: "#callee"

sema_inference_is_lexical_param: fn(context: SemaInferenceContext, name: String) -> Bool Never! {
    loop param in context.lexical_generic_params {
        if param.name == name -> return true
    }
    false
}

sema_inference_declared_name: fn(name: String) -> String Never! {
    name.removesuffix(SEMA_INFERENCE_CALLEE_SUFFIX)
}

// Declared spelling -> solver spelling, for each callee parameter a caller's
// in-scope parameter shadows.
sema_inference_callee_renames: fn(context: SemaInferenceContext) -> [SemaInferenceBinding] Never! {
    renames := [SemaInferenceBinding]{}
    loop parameter in context.type_params {
        if sema_inference_is_lexical_param(context, parameter.name) -> renames.push(SemaInferenceBinding{name: parameter.name, ty: Type.Named{name: "{parameter.name}{SEMA_INFERENCE_CALLEE_SUFFIX}"}, source: "the callee's own parameter"})
    }
    renames
}

sema_inference_solver_context: fn(context: SemaInferenceContext, renames: [SemaInferenceBinding]) -> SemaInferenceContext Never! {
    params: loop parameter in context.type_params -> {
        name := parameter.name
        if sema_inference_binding_at(renames, parameter.name) == .Val(rename) {
            if rename.ty == .Named(solver_name) -> name = solver_name
        }
        SemaInferenceTypeParam{name: name, bounds: parameter.bounds, span: parameter.span, identity_key: parameter.identity_key, bound_module: parameter.bound_module}
    }
    sema_inference_context(context.caller_module_identity, context.caller_package_identity, params, context.lexical_generic_params, context.expected)
}

sema_inference_declared_bindings: fn(bindings: [SemaInferenceBinding]) -> [SemaInferenceBinding] Never! {
    // Each value is resolved against the solver's bindings, so it names only
    // the caller's types and instantiation reads it as written.
    declared: loop binding in bindings -> SemaInferenceBinding{name: sema_inference_declared_name(binding.name), ty: sema_inference_resolve_type_bindings(binding.ty, bindings), source: binding.source}
    declared
}

sema_inference_declared_evidence: fn(evidence: [SemaInferenceBoundEvidence]) -> [SemaInferenceBoundEvidence] Never! {
    declared: loop row in evidence -> SemaInferenceBoundEvidence{param: sema_inference_declared_name(row.param), actual: row.actual, bound: row.bound, satisfied: row.satisfied, source: row.source}
    declared
}

sema_inference_bind: fn(context: SemaInferenceContext, bindings: &[SemaInferenceBinding], name: String, found: Type, source: String, conflict: &SemaInferenceConflict?) -> Bool Never! {
    normalized: sema_inference_resolve_type_bindings(found, bindings)
    if normalized == (Type.Named{name: name}) -> return true
    if sema_inference_type_contains_param(normalized, name, bindings) {
        sema_inference_conflict(conflict, name, Type.Named{name: name}, "the generic declaration", normalized, source)
        return false
    }
    existing_index: sema_inference_binding_index(bindings, name)
    if existing_index == .Val(existing_at) {
        existing: bindings[existing_at]
        prior: sema_inference_resolve_type_bindings(existing.ty, bindings)
        if type_identity_equal(prior, normalized) -> return true
        sema_inference_conflict(conflict, name, prior, existing.source, normalized, source)
        return false
    }
    if sema_inference_parameter_index(context, name) == None -> return false
    bindings.push(SemaInferenceBinding{name: name, ty: normalized, source: source})
    true
}

sema_inference_unify_optional: fn(context: SemaInferenceContext, left: Type?, right: Type?, bindings: &[SemaInferenceBinding], source: String, conflict: &SemaInferenceConflict?) -> Bool Never! {
    left_ty: left ?? return (right == None)
    right_ty: right ?? return false
    sema_inference_unify_inner(context, left_ty, right_ty, bindings, source, conflict)
}

sema_inference_unify_inner: fn(context: SemaInferenceContext, expected: Type, found: Type, bindings: &[SemaInferenceBinding], source: String, conflict: &SemaInferenceConflict?) -> Bool Never! {
    left: sema_inference_resolve_type_bindings(expected, bindings)
    right: sema_inference_resolve_type_bindings(found, bindings)
    // Identical composite types still need their nested parameters bound.
    if left == .Named(name) {
        if sema_inference_parameter_index(context, name) != None -> return sema_inference_bind(context, bindings, name, right, source, conflict)
    }
    if right == .Named(name) {
        if sema_inference_parameter_index(context, name) != None -> return sema_inference_bind(context, bindings, name, left, source, conflict)
    }
    if left == {
        .List(inner) -> if right == {
            .List(other) -> sema_inference_unify_inner(context, inner, other, bindings, source, conflict)
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Map(key, _, value) -> if right == {
            .Map(other_key, _, other_value) -> {
                if !sema_inference_unify_inner(context, key, other_key, bindings, source, conflict) -> return false
                sema_inference_unify_inner(context, value, other_value, bindings, source, conflict)
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Shared(inner) -> if right == {
            .Shared(other) -> sema_inference_unify_inner(context, inner, other, bindings, source, conflict)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Option(inner) -> if right == {
            .Option(other) -> sema_inference_unify_inner(context, inner, other, bindings, source, conflict)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Result(ok, err) -> if right == {
            .Result(other_ok, other_err) -> {
                ok_result: sema_inference_unify_inner(context, ok, other_ok, bindings, source, conflict)
                err_result: sema_inference_unify_inner(context, err, other_err, bindings, source, conflict)
                ok_result && err_result
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Fn(params, ret, _, _, _, _) -> if right == {
            .Fn(other_params, other_ret, _, _, _, _) -> {
                if params.len() != other_params.len() -> return false
                loop index in 0..<params.len() {
                    if !sema_inference_unify_inner(context, params[index], other_params[index], bindings, source, conflict) -> return false
                }
                sema_inference_unify_optional(context, ret, other_ret, bindings, source, conflict)
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Apply(name, args) -> if right == {
            .Apply(other_name, other_args) -> {
                if name != other_name || args.len() != other_args.len() -> return false
                loop index in 0..<args.len() {
                    if !sema_inference_unify_inner(context, args[index], other_args[index], bindings, source, conflict) -> return false
                }
                true
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Tuple(fields) -> if right == {
            .Tuple(other_fields) -> {
                if fields.len() != other_fields.len() -> return false
                loop index in 0..<fields.len() {
                    if fields[index].name != other_fields[index].name -> return false
                    if !sema_inference_unify_inner(context, fields[index].ty, other_fields[index].ty, bindings, source, conflict) -> return false
                }
                true
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        .FixedList(element, length) -> if right == {
            .FixedList(other, other_length) -> length == other_length && sema_inference_unify_inner(context, element, other, bindings, source, conflict)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        .InlineRange(base, lo, hi) -> if right == {
            .InlineRange(other, other_lo, other_hi) -> lo == other_lo && hi == other_hi && sema_inference_unify_inner(context, base, other, bindings, source, conflict)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Tagged(_, inner) -> if right == {
            .Tagged(_, other) -> sema_inference_unify_inner(context, inner, other, bindings, source, conflict)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Union(members) -> if right == {
            .Union(other) -> {
                if members.len() != other.len() -> return false
                loop index in 0..<members.len() {
                    if !sema_inference_unify_inner(context, members[index], other[index], bindings, source, conflict) -> return false
                }
                true
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Quantity(base, dimension) -> if right == {
            .Quantity(other, other_dimension) -> dimension_identity(dimension) == dimension_identity(other_dimension) && sema_inference_unify_inner(context, base, other, bindings, source, conflict)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Measure(_) -> false
        }
        .Int | .Float | .Bool | .String | .Char | .Named(_) | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> type_identity_equal(left, right)
    }
}

// A bound names a trait of the callee's declaring module (`bound_module`),
// which the caller need not see (`Transform.point<P: GeometryPoint>` called
// from user code); the actual type resolves where the caller wrote it.
sema_inference_bound_value: fn(graph: SemaRegistrationGraph?, context: &SemaInferenceContext, actual: Type, bound: String, bound_module: String) -> Bool? {
    graph_value: graph ?? return None
    if bound_module == "" || bound_module == context.caller_module_identity -> return sema_type_bound_satisfied_with_generics(graph_value, actual, bound, context.caller_module_identity, context.lexical_generic_params)
    resolved: sema_type_resolve_declared_recursive(graph_value, actual, sema_type_module_row(graph_value, context.caller_module_identity), context.lexical_generic_params)
    sema_type_bound_satisfied_with_generics(graph_value, resolved, bound, bound_module, context.lexical_generic_params)
}

sema_inference_assignable: fn(graph: SemaRegistrationGraph?, context: SemaInferenceContext, required: Type, offered: Type) -> Bool Never! {
    if graph == .Val(graph_value) {
        verdict: sema_type_assignable_in_graph_with_generics(graph_value, required, offered, context.caller_module_identity, context.lexical_generic_params)
        return verdict ?? false
    }
    sema_type_assignable(required, offered)
}

sema_inference_conflict_diagnostic: fn(conflict: SemaInferenceConflict, span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_error("E0904", span, "can't figure out what `{sema_inference_declared_name(conflict.param)}` should be here", "one generic type parameter received incompatible concrete types", "make the argument types agree or provide an explicit type argument"))
}

sema_inference_unresolved_diagnostic: fn(parameter: SemaInferenceTypeParam, span: Span, diagnostics: &[Diagnostic]) {
    name: sema_inference_declared_name(parameter.name)
    diagnostics.push(sema_error("E0904", span, "can't figure out what `{name}` should be here", "generic calls need enough context to pick a concrete type", "pass the type argument explicitly, like `make<Int>()`, or give the value a typed head, like `p: Pair<Int>{{ … }}`"))
}

// A bound that resolves to no trait: name the written bound as the cause.
// A built-in type such as `Int` is a type, not a trait (a union such as
// `<T: Int | Float>` is no bound either), and an unknown name is not in
// scope; only a missing graph is an internal ordering fault.
sema_inference_unresolved_bound_diagnostic: fn(has_graph: Bool, bound: String, bounds: [String], param: String, span: Span) -> Diagnostic {
    if !has_graph -> return sema_error("E0904", span, "cannot resolve bound `{bound}` for `{param}`", "generic checking needs the registered trait or nominal implementation", "make the declaration's Registration graph available before this call")
    if sema_marker_rules_builtin_type(bound) == None -> return sema_error("E0904", span, "no trait named `{bound}` is in scope for the bound on `{param}`", "a generic bound names a declared or imported trait", "declare or import the trait `{bound}`, or correct the bound's spelling")
    all_types := bounds.len() > 1
    loop written_bound in bounds {
        if sema_marker_rules_builtin_type(written_bound) == None -> all_types = false
    }
    if all_types {
        written: bounds.join(" | ")
        return sema_error("E0904", span, "`{written}` is a set of types, not a trait, so it cannot bound `{param}`", "a generic bound names traits that every type argument must implement; a union of types is a value type, not a bound", "use the union `{written}` as the parameter type and match on it, or bound `{param}` by a trait such as `Comparable`")
    }
    sema_error("E0904", span, "the bound `{bound}` on `{param}` is a type, not a trait", "a generic bound names a trait that every type argument must implement, and `{bound}` is a concrete type", "bound `{param}` by a trait such as `Comparable`, or drop the type parameter and write `{bound}` directly")
}

sema_inference_validate_bounds: fn(graph: SemaRegistrationGraph?, context: &SemaInferenceContext, bindings: [SemaInferenceBinding], span: Span, diagnostics: &[Diagnostic]) -> [SemaInferenceBoundEvidence]? {
    evidence := [SemaInferenceBoundEvidence]{}
    loop parameter in context.type_params {
        actual: sema_inference_binding_at(bindings, parameter.name) ?? return None
        concrete: sema_inference_resolve_type_bindings(actual.ty, bindings)
        loop bound in parameter.bounds {
            satisfied: sema_inference_bound_value(graph, context, concrete, bound, parameter.bound_module) ?? {
                has_graph: if graph == .Val(_) -> true else -> false
                diagnostics.push(sema_inference_unresolved_bound_diagnostic(has_graph, bound, parameter.bounds, sema_inference_declared_name(parameter.name), span))
                return None
            }
            evidence.push(SemaInferenceBoundEvidence{param: parameter.name, actual: concrete, bound: bound, satisfied: satisfied, source: span})
            if !satisfied {
                name: type_name(concrete)
                row: diagnostic_registry_row("E0905") ?? panic("E0905 must have a registry row")
                what: row.what.replace("{{type}}", name).replace("{{bound}}", bound)
                why := "`{name}` would need to implement `{bound}` before it can be used here"
                fix := "write `impl {name}.{bound} {{ … }}` with every required method"
                if bound == "Comparable" -> fix = "write `#Comparable` before `{name}`, or use `sort_by` with a key"
                if bound == "Numeric" -> fix = "write `#Numeric` on a distinct number type, or `impl {name}.Numeric {{ … }}` with `zero` and `one` on a struct that implements {owned_trait_requires_listed(bound)}"
                loop caller_parameter in context.lexical_generic_params {
                    if caller_parameter.name == name {
                        why = "type parameter `{name}` doesn't declare the `{bound}` bound, so a caller may choose a type without it"
                        fix = "declare the bound where `{name}` is introduced: `<{name}: {bound}>`"
                    }
                }
                diagnostics.push(sema_error("E0905", span, what, row.why.replace("{{why_text}}", why), row.fix.replace("{{fix_text}}", fix)))
                return None
            }
        }
    }
    Val(evidence)
}

sema_inference_type_args: fn(context: &SemaInferenceContext, bindings: [SemaInferenceBinding]) -> [Type]? {
    result := [Type]{}
    loop parameter in context.type_params {
        actual: sema_inference_binding_at(bindings, parameter.name) ?? return None
        result.push(sema_inference_resolve_type_bindings(actual.ty, bindings))
    }
    Val(result)
}

sema_inference_specialized_parameters: fn(parameters: [Type], bindings: [SemaInferenceBinding]) -> [Type] Never! {
    specialized: loop parameter in parameters -> sema_inference_resolve_type_bindings(parameter, bindings)
    specialized
}

sema_inference_specialized_return: fn(return_type: Type?, bindings: [SemaInferenceBinding]) -> Type? {
    declared: return_type ?? return None
    Val(sema_inference_resolve_type_bindings(declared, bindings))
}

sema_inference_count_diagnostic: fn(expected: Int, actual: Int, span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_error("E0119", span, "expected {expected} type argument{if expected == 1 -> "" else -> "s"}, got {actual}", "generic parameters and call-site arguments must have the same arity", "provide one type argument for each declared generic parameter"))
}

sema_inference_prepare_explicit: fn(context: &SemaInferenceContext, explicit_type_args: [Type], bindings: &[SemaInferenceBinding], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if explicit_type_args.len() == 0 -> return true
    if context.type_params.len() == 0 {
        sema_inference_count_diagnostic(0, explicit_type_args.len(), span, diagnostics)
        return false
    }
    if explicit_type_args.len() != context.type_params.len() {
        sema_inference_count_diagnostic(context.type_params.len(), explicit_type_args.len(), span, diagnostics)
        return false
    }
    conflict := SemaInferenceConflict?{None}
    loop index in 0..<context.type_params.len() {
        name: context.type_params[index].name.copy()
        if !sema_inference_bind(context, bindings, name, explicit_type_args[index], "the explicit type argument", conflict) {
            if conflict == .Val(row) -> sema_inference_conflict_diagnostic(row, span, diagnostics)
            return false
        }
    }
    true
}

sema_infer_validate_explicit: fn(graph: SemaRegistrationGraph?, context: &SemaInferenceContext, type_args: [Type], span: Span, diagnostics: &[Diagnostic]) -> SemaInferenceResult? {
    renames: sema_inference_callee_renames(context)
    if renames.len() > 0 {
        solver := sema_inference_solver_context(context, renames)
        return sema_infer_validate_explicit(graph, solver, type_args, span, diagnostics)
    }
    if context.type_params.len() > 0 && type_args.len() == 0 {
        sema_inference_unresolved_diagnostic(context.type_params[0], span, diagnostics)
        return None
    }
    // A written type argument names a type as the caller's module sees it:
    // the instance carries its declaration identity, so a bare `ReadFrame`
    // instantiated in another module is still the caller's ReadFrame.
    written := type_args
    if graph == .Val(registered) {
        caller: sema_type_module_row(registered, context.caller_module_identity)
        written = loop ty in type_args -> sema_type_resolve_declared_recursive(registered, ty, caller, context.lexical_generic_params)
    }
    bindings := [SemaInferenceBinding]{}
    if !sema_inference_prepare_explicit(context, written, bindings, span, diagnostics) -> return None
    evidence: sema_inference_validate_bounds(graph, context, bindings, span, diagnostics) ?? return None
    resolved_args: sema_inference_type_args(context, bindings) ?? return None
    Val(SemaInferenceResult{substitutions: sema_inference_declared_bindings(bindings), type_args: resolved_args, parameters: [Type]{}, return_type: None, evidence: sema_inference_declared_evidence(evidence), complete: true, compatible: true})
}

// In a value position the expectation describes a
// fallible callee's success value; only a Result expectation is the carrier.
sema_inference_expected_return_view: fn(declared_return: Type, expected: Type) -> Type Never! {
    if expected == {
        // copy: the expected return is a new owned Type. For a Result it equals `declared_return`,
        // the signature's return type (a read parameter), which stays in the signature.
        .Result(_, _) -> return declared_return.copy()
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {}
    }
    if declared_return == {
        // copy: `success` is a payload of read parameter `declared_return`, which keeps the original; the returned value owns this one
        .Result(success, _) -> success.copy()
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> declared_return
    }
}

sema_infer_callable: fn(graph: SemaRegistrationGraph?, context: &SemaInferenceContext, parameters: [Type], return_type: Type?, args: [Type], explicit_type_args: [Type], span: Span, diagnostics: &[Diagnostic]) -> SemaInferenceResult? {
    renames: sema_inference_callee_renames(context)
    if renames.len() > 0 {
        solver := sema_inference_solver_context(context, renames)
        solver_parameters: loop parameter in parameters -> sema_inference_substitute_type_bindings(parameter, renames)
        solver_return: sema_inference_specialized_return(return_type, renames)
        return sema_infer_callable(graph, solver, solver_parameters, solver_return, args, explicit_type_args, span, diagnostics)
    }
    // Apply heads and their nested arguments must use the same declaration
    // identity before structural unification. Source signatures retain leaves
    // while values crossing a file boundary already carry canonical names.
    generic_scope := context.lexical_generic_params
    loop parameter in context.type_params -> generic_scope.push(TGenericParam{name: parameter.name, bounds: []})
    resolved_parameters: if graph == .Val(registered) -> {
        loop parameter in parameters -> sema_type_resolve_declared_with_generics(registered, parameter, context.caller_module_identity, generic_scope)
    } else -> parameters
    resolved_args: if graph == .Val(registered) -> {
        loop arg in args -> sema_type_resolve_declared_with_generics(registered, arg, context.caller_module_identity, generic_scope)
    } else -> args
    bindings := [SemaInferenceBinding]{}
    if !sema_inference_prepare_explicit(context, explicit_type_args, bindings, span, diagnostics) -> return None
    compatible := true
    conflict := SemaInferenceConflict?{None}
    if args.len() != parameters.len() -> compatible = false
    loop index in 0..<args.len() {
        if index < parameters.len() {
            if !sema_inference_unify_inner(context, resolved_parameters[index], resolved_args[index], bindings, "argument {index + 1}", conflict) {
                if conflict == .Val(row) {
                    sema_inference_conflict_diagnostic(row, span, diagnostics)
                    return None
                }
                compatible = false
            }
        }
    }
    if context.expected == .Val(expected_ty) && return_type == .Val(declared_return) {
        if !sema_inference_unify_inner(context, sema_inference_expected_return_view(declared_return, expected_ty), expected_ty, bindings, "the expected result type", conflict) {
            if conflict == .Val(row) {
                sema_inference_conflict_diagnostic(row, span, diagnostics)
                return None
            }
            compatible = false
        }
    }
    loop parameter in context.type_params {
        if sema_inference_binding_index(bindings, parameter.name) == None {
            sema_inference_unresolved_diagnostic(parameter, span, diagnostics)
            return None
        }
    }
    evidence: sema_inference_validate_bounds(graph, context, bindings, span, diagnostics) ?? return None
    specialized_parameters: sema_inference_specialized_parameters(resolved_parameters, bindings)
    specialized_return := sema_inference_specialized_return(return_type, bindings)
    loop index in 0..<args.len() {
        if index < specialized_parameters.len() && !sema_inference_assignable(graph, context, specialized_parameters[index], resolved_args[index]) -> compatible = false
    }
    if context.expected == .Val(expected_ty) && specialized_return != None {
        if !sema_inference_assignable(graph, context, expected_ty, sema_inference_expected_return_view(specialized_return ?? Type.Named{name: "Unit"}, expected_ty)) -> compatible = false
    }
    type_args: sema_inference_type_args(context, bindings) ?? return None
    Val(SemaInferenceResult{substitutions: sema_inference_declared_bindings(bindings), type_args: type_args, parameters: specialized_parameters, return_type: specialized_return, evidence: sema_inference_declared_evidence(evidence), complete: true, compatible: compatible})
}

sema_infer_nominal: fn(graph: SemaRegistrationGraph?, context: &SemaInferenceContext, declared: Type, actual: Type, explicit_type_args: [Type], span: Span, diagnostics: &[Diagnostic]) -> SemaInferenceResult? {
    sema_infer_callable(graph, context, [Type]{declared}, None, [Type]{actual}, explicit_type_args, span, diagnostics)
}
