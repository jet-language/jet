// Registration adapters for the shared inference solver.
// Registration owns declaration identity and graph visibility; this layer only
// projects its canonical rows into solver context and keeps the proof result.
use jet_foundation.[
    Diagnostic,
    Span,
    TGenericParam,
    Type,
]

sema_infer_context_for_registration: fn(caller_module_identity: String, caller_package_identity: String, parameters: [SemaRegistrationGenericParam], lexical_generic_params: [TGenericParam], expected: Type?) -> SemaInferenceContext Never! {
    type_params: sema_inference_registration_params(parameters)
    sema_inference_context(caller_module_identity, caller_package_identity, type_params, lexical_generic_params, expected)
}

// `nominal_ty` is the nominal's type as the caller spells it (its declared
// type, or that type resolved in the owner's module), so a caller never copies
// the whole row (methods and their bodies) to swap one field.
sema_infer_registered_nominal: fn(nominal: SemaRegistrationNominal, nominal_ty: Type, graph: SemaRegistrationGraph?, caller_module_identity: String, caller_package_identity: String, lexical_generic_params: [TGenericParam], actual: Type, explicit_type_args: [Type], expected: Type?, span: Span, diagnostics: &[Diagnostic]) -> SemaInferenceResult? {
    context := sema_infer_context_for_registration(caller_module_identity, caller_package_identity, nominal.generic_params, lexical_generic_params, expected)
    sema_infer_nominal(graph, context, nominal_ty, actual, explicit_type_args, span, diagnostics)
}
