// Structural type substitution shared by inference, calls, and nominal checks.
// Function effects, labels, defaults, and view provenance are identity metadata;
// they survive specialization unchanged while every nested Type is rewritten.
//
// Two readings of a binding list share one walker. Instantiation
// (`sema_inference_substitute_type_bindings`) replaces every bound name at
// once with its value as written: the values name the caller's types, and a
// caller parameter that shares a callee parameter's name (`swapped<U, T>`
// calling `pair<T, U>`) is not that callee parameter. Solving
// (`sema_inference_resolve_type_bindings`) follows chains, because a solver
// binding may name a solver parameter bound later.
use jet_foundation.[
    Measure,
    Type,
    TypeTupleField,
    type_identity_equal,
]

sema_inference_binding_type: fn(name: String, bindings: [SemaInferenceBinding], seen: [String]) -> Type? {
    loop binding in bindings {
        if binding.name == name {
            next_seen := seen
            next_seen.push(name.copy())
            value: binding.ty
            if value == .Named(next) {
                already: loop seen_name in next_seen {
                    if seen_name == next -> break true
                } ?? false
                if !already && next != name {
                    nested: sema_inference_binding_type(next, bindings, next_seen)
                    if nested != None -> return nested
                }
            }
            return Val(value)
        }
    }
    None
}

// `seen` holds the parameter names being expanded on this path. A binding
// whose value mentions its own name (a callee `T` bound to the caller's
// `[T]`) keeps that inner name as written, as Rust's single-pass
// `substitute_type` does, instead of expanding it again without end. Without
// `chain` a bound name is replaced by its value as written.
sema_inference_substitute_type_inner: fn(ty: Type, bindings: [SemaInferenceBinding], seen: [String], chain: Bool) -> Type Never! {
    if ty == {
        .Named(name) -> {
            if !chain {
                // copy: the substituted type is a new owned Type; the binding and `ty` keep theirs.
                if sema_inference_binding_at(bindings, name) == .Val(binding) -> return binding.ty.copy()
                // copy: an unbound name is `ty` itself, a read parameter that stays in the signature.
                return ty.copy()
            }
            expanding: loop seen_name in seen {
                if seen_name == name -> break true
            } ?? false
            // copy: the substituted type is a new owned Type. During recursive expansion it equals
            // `ty`, the caller's type (a read parameter), which stays in the signature.
            if expanding -> return ty.copy()
            // copy: the substituted type is a new owned Type. For an unbound name it equals `ty`,
            // the caller's type (a read parameter), which stays in the signature.
            value: sema_inference_binding_type(name, bindings, seen) ?? return ty.copy()
            // copy: the substituted type is a new owned Type. For a self-binding it equals `ty`,
            // the caller's type (a read parameter), which stays in the signature.
            if type_identity_equal(value, ty) -> return ty.copy()
            next_seen := seen
            next_seen.push(name.copy())
            sema_inference_substitute_type_inner(value, bindings, next_seen, chain)
        }
        .List(inner) -> Type.List{element: sema_inference_substitute_type_inner(inner, bindings, seen, chain)}
        // copy: `key_span` is a payload of read parameter `ty`, which keeps the original; field `key_span` of the new Type.Map owns this one
        .Map(key, key_span, value) -> Type.Map{key: sema_inference_substitute_type_inner(key, bindings, seen, chain), key_span: key_span.copy(), value: sema_inference_substitute_type_inner(value, bindings, seen, chain)}
        .Shared(inner) -> Type.Shared{inner: sema_inference_substitute_type_inner(inner, bindings, seen, chain)}
        .Option(inner) -> Type.Option{inner: sema_inference_substitute_type_inner(inner, bindings, seen, chain)}
        .Result(ok, err) -> Type.Result{ok: sema_inference_substitute_type_inner(ok, bindings, seen, chain), err: sema_inference_substitute_type_inner(err, bindings, seen, chain)}
        .Fn(params, ret, effects, contract, metadata, provenance) -> {
            normalized: loop param in params -> sema_inference_substitute_type_inner(param, bindings, seen, chain)
            normalized_ret: if ret == .Val(declared) -> Val(sema_inference_substitute_type_inner(declared, bindings, seen, chain)) else -> None
            Type.Fn{params: normalized, ret: normalized_ret, effect_bound: effects, param_contract: contract, call_metadata: metadata, return_view_provenance: provenance}
        }
        .Apply(name, args) -> {
            normalized: loop arg in args -> sema_inference_substitute_type_inner(arg, bindings, seen, chain)
            Type.Apply{name: name, args: normalized}
        }
        .Tuple(fields) -> {
            normalized: loop field in fields -> TypeTupleField{name: field.name, ty: sema_inference_substitute_type_inner(field.ty, bindings, seen, chain)}
            Type.Tuple{fields: normalized}
        }
        .FixedList(element, length) -> Type.FixedList{elem: sema_inference_substitute_type_inner(element, bindings, seen, chain), len: sema_inference_substitute_length(length, bindings, seen, chain)}
        .InlineRange(base, lo, hi) -> Type.InlineRange{base: sema_inference_substitute_type_inner(base, bindings, seen, chain), lo: lo, hi: hi}
        // copy: `marker` is a payload of read parameter `ty`, which keeps the original; field `marker` of the new Type.Tagged owns this one
        .Tagged(marker, inner) -> Type.Tagged{marker: marker.copy(), inner: sema_inference_substitute_type_inner(inner, bindings, seen, chain)}
        .Union(members) -> {
            normalized: loop member in members -> sema_inference_substitute_type_inner(member, bindings, seen, chain)
            Type.Union{members: normalized}
        }
        // copy: `dimension` is a payload of read parameter `ty`, which keeps the original; field `dimension` of the new Type.Quantity owns this one
        .Quantity(base, dimension) -> Type.Quantity{base: sema_inference_substitute_type_inner(base, bindings, seen, chain), dimension: dimension.copy()}
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> ty
    }
}

// The length of `[T#N]` under the bindings: a `<comptime N: Int>` number
// parameter bound to a number (`Packet<4>` binds `N` to the length measure
// 4) becomes that number in the slot's own measure kind.
sema_inference_substitute_length: fn(length: Measure, bindings: [SemaInferenceBinding], seen: [String], chain: Bool) -> Measure Never! {
    if length == .Symbol(kind, name) {
        bound: sema_inference_substitute_type_inner(Type.Named{name: name.copy()}, bindings, seen, chain)
        if bound == .Measure(number) && number == .Literal(_, value) -> return Measure.Literal{kind: kind.copy(), value: value}
    }
    // copy: `length` is a payload of the caller's read type, which keeps the original.
    length.copy()
}

sema_inference_substitute_type_bindings: fn(ty: Type, bindings: [SemaInferenceBinding]) -> Type Never! {
    // copy: a type no binding changes is the input itself; one copy replaces
    // the rebuild that copied every part of it.
    if bindings.len() == 0 || !sema_inference_type_changes(ty, bindings, false) -> return ty.copy()
    sema_inference_substitute_type_inner(ty, bindings, [String]{}, false)
}

sema_inference_resolve_type_bindings: fn(ty: Type, bindings: [SemaInferenceBinding]) -> Type Never! {
    // copy: as in sema_inference_substitute_type_bindings.
    if bindings.len() == 0 || !sema_inference_type_changes(ty, bindings, true) -> return ty.copy()
    sema_inference_substitute_type_inner(ty, bindings, [String]{}, true)
}

// Whether substituting `bindings` into `ty` changes it: some named part has a
// binding that is not that name itself (the cases where
// sema_inference_substitute_type_inner rewrites instead of keeping the part).
sema_inference_type_changes: fn(ty: Type, bindings: [SemaInferenceBinding], chain: Bool) -> Bool Never! {
    if ty == {
        .Named(name) -> {
            if !chain {
                binding: sema_inference_binding_at(bindings, name) ?? return false
                return !type_identity_equal(binding.ty, ty)
            }
            value: sema_inference_binding_type(name, bindings, [String]{}) ?? return false
            return !type_identity_equal(value, ty)
        }
        .List(inner) -> return sema_inference_type_changes(inner, bindings, chain)
        .Shared(inner) -> return sema_inference_type_changes(inner, bindings, chain)
        .Option(inner) -> return sema_inference_type_changes(inner, bindings, chain)
        .Tagged(_, inner) -> return sema_inference_type_changes(inner, bindings, chain)
        .Map(key, _, value) -> return sema_inference_type_changes(key, bindings, chain) || sema_inference_type_changes(value, bindings, chain)
        .Result(ok, err) -> return sema_inference_type_changes(ok, bindings, chain) || sema_inference_type_changes(err, bindings, chain)
        .Fn(params, ret, _, _, _, _) -> {
            loop index in 0..<params.len() {
                if sema_inference_type_changes(params[index], bindings, chain) -> return true
            }
            if ret == .Val(declared) -> return sema_inference_type_changes(declared, bindings, chain)
            return false
        }
        .Apply(_, args) -> {
            loop index in 0..<args.len() {
                if sema_inference_type_changes(args[index], bindings, chain) -> return true
            }
            return false
        }
        .Tuple(fields) -> {
            loop index in 0..<fields.len() {
                if sema_inference_type_changes(fields[index].ty, bindings, chain) -> return true
            }
            return false
        }
        .FixedList(element, length) -> {
            if length == .Symbol(_, name) && sema_inference_type_changes(Type.Named{name: name.copy()}, bindings, chain) -> return true
            return sema_inference_type_changes(element, bindings, chain)
        }
        .InlineRange(base, _, _) -> return sema_inference_type_changes(base, bindings, chain)
        .Quantity(base, _) -> return sema_inference_type_changes(base, bindings, chain)
        .Union(members) -> {
            loop index in 0..<members.len() {
                if sema_inference_type_changes(members[index], bindings, chain) -> return true
            }
            return false
        }
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> return false
    }
}

sema_inference_substitute_type: fn(ty: Type, names: [String], actuals: [Type]) -> Type Never! {
    bindings: loop index in 0..<names.len() if index < actuals.len() -> SemaInferenceBinding{name: names[index], ty: actuals[index], source: "specialization"}
    sema_inference_substitute_type_bindings(ty, bindings)
}

// Whether `ty`, with the solver's bindings applied, still mentions the
// parameter `name`. Resolution already follows binding chains, so the
// resolved type is walked as written: resolving its parts again would
// re-expand a name a binding keeps as written (`shared(T?{…})` inside
// `f: fn<T>` binds the builtin's `T` to the caller's `T?`) and never stop,
// which Rust's single-pass `substitute_type` never does.
sema_inference_type_contains_param: fn(ty: Type, name: String, bindings: [SemaInferenceBinding]) -> Bool Never! {
    sema_inference_type_mentions_param(sema_inference_resolve_type_bindings(ty, bindings), name)
}

sema_inference_type_mentions_param: fn(ty: Type, name: String) -> Bool Never! {
    if ty == {
        .Named(found) -> found == name
        .List(inner) -> sema_inference_type_mentions_param(inner, name)
        .Map(key, _, value) -> sema_inference_type_mentions_param(key, name) || sema_inference_type_mentions_param(value, name)
        .Shared(inner) -> sema_inference_type_mentions_param(inner, name)
        .Option(inner) -> sema_inference_type_mentions_param(inner, name)
        .Result(ok, err) -> sema_inference_type_mentions_param(ok, name) || sema_inference_type_mentions_param(err, name)
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params {
                if sema_inference_type_mentions_param(param, name) -> return true
            }
            if ret == .Val(declared) -> sema_inference_type_mentions_param(declared, name) else -> false
        }
        .Apply(_, args) -> {
            loop arg in args {
                if sema_inference_type_mentions_param(arg, name) -> return true
            }
            false
        }
        .Tuple(fields) -> {
            loop field in fields {
                if sema_inference_type_mentions_param(field.ty, name) -> return true
            }
            false
        }
        .FixedList(element, length) -> {
            if length == .Symbol(_, length_name) && length_name == name -> return true
            sema_inference_type_mentions_param(element, name)
        }
        .InlineRange(base, _, _) -> sema_inference_type_mentions_param(base, name)
        .Tagged(_, inner) -> sema_inference_type_mentions_param(inner, name)
        .Union(members) -> {
            loop member in members {
                if sema_inference_type_mentions_param(member, name) -> return true
            }
            false
        }
        .Quantity(base, _) -> sema_inference_type_mentions_param(base, name)
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> false
    }
}
