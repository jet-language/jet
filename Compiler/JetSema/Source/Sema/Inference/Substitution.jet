// Structural type substitution shared by inference, calls, and nominal checks.
// Function effects, labels, defaults, and view provenance are identity metadata;
// they survive specialization unchanged while every nested Type is rewritten.

fn sema_inference_binding_type(name: String, bindings: [SemaInferenceBinding], seen: [String]) -> ?Type {
    loop binding in bindings {
        if binding.name == name {
            next_seen := seen
            next_seen.push(name)
            value :: binding.ty
            if value == .Named(next) {
                already :: loop seen_name in next_seen {
                    if seen_name == next -> break true
                } ?? false
                if !already && next != name {
                    nested :: sema_inference_binding_type(next, bindings, next_seen)
                    if nested != None -> return nested
                }
            }
            return Val(value)
        }
    }
    None
}

fn sema_inference_substitute_type_inner(ty: Type, bindings: [SemaInferenceBinding], seen: [String]) -> Type {
    if ty == {
        .Named(name) -> {
            value :: sema_inference_binding_type(name, bindings, seen) ?? return ty
            if type_identity_equal(value, ty) -> return ty
            sema_inference_substitute_type_inner(value, bindings, seen)
        }
        .List(inner) -> Type.List(sema_inference_substitute_type_inner(inner, bindings, [String]{}))
        .Map(key, key_span, value) -> Type.Map(sema_inference_substitute_type_inner(key, bindings, [String]{}), key_span, sema_inference_substitute_type_inner(value, bindings, [String]{}))
        .Shared(inner) -> Type.Shared(sema_inference_substitute_type_inner(inner, bindings, [String]{}))
        .Option(inner) -> Type.Option(sema_inference_substitute_type_inner(inner, bindings, [String]{}))
        .Result(ok, err) -> Type.Result(sema_inference_substitute_type_inner(ok, bindings, [String]{}), sema_inference_substitute_type_inner(err, bindings, [String]{}))
        .Fn(params, ret, effects, contract, metadata, provenance) -> {
            normalized :: loop param in params -> sema_inference_substitute_type_inner(param, bindings, [String]{})
            normalized_ret :: if ret == .Val(declared) -> Val(sema_inference_substitute_type_inner(declared, bindings, [String]{})) else -> None
            Type.Fn(normalized, normalized_ret, effects, contract, metadata, provenance)
        }
        .Apply(name, args) -> {
            normalized :: loop arg in args -> sema_inference_substitute_type_inner(arg, bindings, [String]{})
            Type.Apply(name, normalized)
        }
        .Tuple(fields) -> {
            normalized :: loop field in fields -> TypeTupleField{name: field.name, ty: sema_inference_substitute_type_inner(field.ty, bindings, [String]{})}
            Type.Tuple(normalized)
        }
        .FixedList(element, length) -> Type.FixedList(sema_inference_substitute_type_inner(element, bindings, [String]{}), length)
        .InlineRange(base, lo, hi) -> Type.InlineRange(sema_inference_substitute_type_inner(base, bindings, [String]{}), lo, hi)
        .Tagged(marker, inner) -> Type.Tagged(marker, sema_inference_substitute_type_inner(inner, bindings, [String]{}))
        .Union(members) -> {
            normalized :: loop member in members -> sema_inference_substitute_type_inner(member, bindings, [String]{})
            Type.Union(normalized)
        }
        .Quantity(base, dimension) -> Type.Quantity(sema_inference_substitute_type_inner(base, bindings, [String]{}), dimension)
        else -> ty
    }
}

pub fn sema_inference_substitute_type_bindings(ty: Type, bindings: [SemaInferenceBinding]) -> Type {
    sema_inference_substitute_type_inner(ty, bindings, [String]{})
}

pub fn sema_inference_substitute_type(ty: Type, names: [String], actuals: [Type]) -> Type {
    bindings :: loop index in 0..<names.len() if index < actuals.len() -> SemaInferenceBinding{name: names[index], ty: actuals[index], source: "specialization"}
    sema_inference_substitute_type_bindings(ty, bindings)
}

pub fn sema_inference_type_contains_param(ty: Type, name: String, bindings: [SemaInferenceBinding]) -> Bool {
    normalized :: sema_inference_substitute_type_bindings(ty, bindings)
    if normalized == {
        .Named(found) -> found == name
        .List(inner) -> sema_inference_type_contains_param(inner, name, bindings)
        .Map(key, _, value) -> sema_inference_type_contains_param(key, name, bindings) || sema_inference_type_contains_param(value, name, bindings)
        .Shared(inner) -> sema_inference_type_contains_param(inner, name, bindings)
        .Option(inner) -> sema_inference_type_contains_param(inner, name, bindings)
        .Result(ok, err) -> sema_inference_type_contains_param(ok, name, bindings) || sema_inference_type_contains_param(err, name, bindings)
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params {
                if sema_inference_type_contains_param(param, name, bindings) -> return true
            }
            if ret == .Val(declared) -> sema_inference_type_contains_param(declared, name, bindings) else -> false
        }
        .Apply(_, args) -> {
            loop arg in args {
                if sema_inference_type_contains_param(arg, name, bindings) -> return true
            }
            false
        }
        .Tuple(fields) -> {
            loop field in fields {
                if sema_inference_type_contains_param(field.ty, name, bindings) -> return true
            }
            false
        }
        .FixedList(element, _) -> sema_inference_type_contains_param(element, name, bindings)
        .InlineRange(base, _, _) -> sema_inference_type_contains_param(base, name, bindings)
        .Tagged(_, inner) -> sema_inference_type_contains_param(inner, name, bindings)
        .Union(members) -> {
            loop member in members {
                if sema_inference_type_contains_param(member, name, bindings) -> return true
            }
            false
        }
        .Quantity(base, _) -> sema_inference_type_contains_param(base, name, bindings)
        else -> false
    }
}
