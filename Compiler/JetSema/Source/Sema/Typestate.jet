// The typestate flow check. A value moves through the states its owner's
// state list declares, and a function's types say which: a parameter typed
// `Order.Draft` (or a set or group of states) needs its argument in one of
// those states, and a call whose result is typed `Order.Shipped` yields a
// value in that state. A value never changes state in place. Each body is
// walked once, statement by statement, with the state of every tracked
// local. Calling an operation in the wrong state is E0150; an untracked
// local stays silent. Where paths meet (the one path rule set, Flow.jet), a
// local keeps its state only when both paths agree; otherwise L0152 says
// so, and the local may be in any of their states, so an operation that
// needs one of them is E0150.
//
// The receiver's type comes from the function's checked body: the type of the
// receiver's node in its expression-type column.
use jet_foundation.[ASTTables, BodyTree, Diagnostic, Expr, Func, Item, Name, NameTable, OrFallback, Pattern, Interner, Span, Stmt, SwitchArm, Type, body_tree_new, checked_expr_type_id, type_syntax, expr_binary_operands, expr_span, foundation_byte_text, name_count, name_find, name_index, name_intern, name_table_sized, name_text]

// Program-wide typestate rows, collected once from every user module.
// Methods key as `Type.method`, free functions by name; `keys` interns
// those keys and the names of enums with a state list, and the columns below
// hold each key id's rows (id 0, the empty spelling, holds none). `needs` and
// `results` come from state types (`self: Order.Draft`, `-> Order.Shipped`);
// a state set is its names joined by `|`.
SemaStateTable: struct {
    keys: NameTable,
    // Per key id: its state-typed parameters' needs, its result's states (""
    // for none), and, for an enum with a state list, its states, which are
    // cases.
    needs: [[SemaStateNeed]],
    results: [String],
    cases: [[String]],
    // The keys of `needs` in declaration order, so a fix lists moves as the
    // type declares them.
    typed_keys: [String],
    // The types that own a typed method or a state list, by the name they
    // are declared under (`Payment.Client`).
    owners: NameTable,
}

// A table with no rows yet.
sema_state_table_new: fn() -> SemaStateTable Never! {
    SemaStateTable{keys: name_table_sized(64), needs: [[SemaStateNeed]]{[SemaStateNeed]{}}, results: [String]{""}, cases: [[String]]{[String]{}}, typed_keys: [String]{}, owners: name_table_sized(16)}
}

// The id of `key` in `table`, with its columns grown to cover it.
sema_state_table_id: fn(table: ^SemaStateTable, key: String) -> Int Never! {
    id: name_index(name_intern(table.keys, key))
    if id == table.results.len() {
        table.needs.push([SemaStateNeed]{})
        table.results.push("")
        table.cases.push([String]{})
    }
    id
}

// The id of `key` in `table`; 0 (no rows) when no declaration adds it.
sema_state_table_find: fn(table: SemaStateTable, key: String) -> Int Never! {
    name_index(name_find(table.keys, key) ?? return 0)
}

// Whether no module declares a state type or a state list, so no call or
// enum value has typestate rows.
sema_state_table_empty: fn(table: SemaStateTable) -> Bool Never! { name_count(table.keys) <= 1 }

// The states key `id`'s result names, if it names any.
sema_state_table_result: fn(table: SemaStateTable, id: Int) -> String? Never! {
    if table.results[id] == "" -> return None
    Val(table.results[id])
}

// A state type on one argument of a call: `arg` is the argument's position
// in the call, or -1 for the receiver.
SemaStateNeed: struct {
    arg: Int,
    owner: String,
    states: String,
}

// One function's walk: the flow walk of the typestate plane (the store at
// the current point, whether the current path has left its block, and the
// store of each path that left the innermost loop), the spans of the
// pattern tables sema could not prove exhaustive (E0307), and the findings.
// `locals` interns the module's local names; the store keys its facts by
// their ids.
SemaStateWalk: struct {
    // The AST tables of the walked module.
    tables: ASTTables,
    table: SemaStateTable,
    locals: NameTable,
    flow: SemaFlowWalk<SemaStatePlane>,
    open_switches: [Span],
    typed: Bool,
    diagnostics: [Diagnostic],
}

// The typestate plane (SemaFlowPlane). A local's fact in the store is its
// one known state (`one`, "" for none) and its states where its paths met
// in different states (`many`, in order, empty for none).
SemaStatePlane: struct {
    impl SemaFlowPlane {
        flow_join: fn(self, binding: Int, one: ^^SemaFlowFact, other: ^^SemaFlowFact, splits: ^[SemaFlowSplit]) -> SemaFlowFact Never! {
            sema_state_join(binding, one, other, splits)
        }
    }
}

// A body's walk from facts that track no local.
sema_state_flow_start: fn() -> SemaFlowWalk<SemaStatePlane> Never! {
    sema_flow_start(SemaStatePlane{}, sema_flow_facts(SEMA_FLOW_PLANE_STATE))
}

// The id of local `name`, interned.
sema_state_local_id: fn(walk: ^SemaStateWalk, name: String) -> Int Never! {
    name_index(name_intern(walk.locals, name))
}

// The id of local `name`; 0 (tracked by no facts) when the module never
// tracked it.
sema_state_local_find: fn(walk: SemaStateWalk, name: String) -> Int Never! {
    name_index(name_find(walk.locals, name) ?? return 0)
}

// Local `id`'s one known state in `facts`, "" for none.
sema_state_known: fn(facts: SemaFlowFacts, id: Int) -> String Never! {
    sema_flow_fact(facts, id).one
}

// Local `id`'s met states in `facts`, empty for none.
sema_state_met: fn(facts: SemaFlowFacts, id: Int) -> [String] Never! {
    sema_flow_fact(facts, id).many
}

// Local `id`'s fact with `known` and `met`; unheld when both are empty.
sema_state_put: fn(facts: ^SemaFlowFacts, id: Int, known: String, met: [String]) Never! {
    if known == "" && met.len() == 0 {
        sema_flow_drop(facts, id)
        return
    }
    sema_flow_put(facts, id, SemaFlowFact{held: true, one: known, many: met})
}

sema_state_put_known: fn(facts: ^SemaFlowFacts, id: Int, state: String) Never! {
    met: sema_state_met(facts, id)
    sema_state_put(facts, id, state, met)
}

sema_state_put_met: fn(facts: ^SemaFlowFacts, id: Int, states: [String]) Never! {
    known: sema_state_known(facts, id)
    sema_state_put(facts, id, known, states)
}

sema_state_drop_known: fn(facts: ^SemaFlowFacts, id: Int) Never! {
    met: sema_state_met(facts, id)
    sema_state_put(facts, id, "", met)
}

sema_state_drop_met: fn(facts: ^SemaFlowFacts, id: Int) Never! {
    known: sema_state_known(facts, id)
    sema_state_put(facts, id, known, [String]{})
}

// The program's state table: every registered module's state-typed
// declarations. Each module's walk (sema_typestate_check_module) reads it,
// the graph and its own checked module and writes only its own findings, so
// the walks run on compiler threads beside the side checks
// (Finalize.jet sema_finalize_side_checks) and join in module order.
sema_state_table_of: fn(graph: SemaRegistrationGraph) -> SemaStateTable Never! {
    ^table: sema_state_table_new()
    loop registered in graph.modules -> sema_state_table_add_items(table, registered.program.items)
    table
}

// One checked module's walk: every function, method and test body of its
// registered program, with the source locations attached to its findings.
sema_typestate_check_module: fn(graph: SemaRegistrationGraph, table: SemaStateTable, module_row: SemaGraphModuleResult) -> [Diagnostic] Never! {
    if sema_state_table_empty(table) -> return [Diagnostic]{}
    registration: sema_registration_module_index(graph, module_row.module_identity) ?? return [Diagnostic]{}
    ^open_switches: [Span]{}
    loop diagnostic in module_row.diagnostics {
        if diagnostic.code == "E0307" && diagnostic.span == .Val(span) {
            open_switches.push(span.copy())
        }
    }
    ^body_by_start: [Int:Int]{}
    loop (idx, fn_body) in module_row.functions {
        if body_by_start.get(fn_body.source_span.start) == None {
            body_by_start[fn_body.source_span.start] = idx
        }
    }
    empty_tree: body_tree_new()
    ^walk: SemaStateWalk{tables: graph.modules[registration].program.tables, table: table.copy(), locals: name_table_sized(64), flow: sema_state_flow_start(), open_switches: open_switches, typed: false, diagnostics: [Diagnostic]{}}
    loop item in graph.modules[registration].program.items {
        if item == {
            .Func(function) -> {
                sema_state_check_function(walk, graph.interner, function, module_row.functions, body_by_start, empty_tree)
            }
            .Impl(implementation) -> {
                loop method in implementation.methods {
                    sema_state_check_function(walk, graph.interner, method, module_row.functions, body_by_start, empty_tree)
                }
            }
            .Struct(definition) -> {
                loop method in definition.methods {
                    sema_state_check_function(walk, graph.interner, method, module_row.functions, body_by_start, empty_tree)
                }
                loop block in definition.trait_impls {
                    loop method in block.methods {
                        sema_state_check_function(walk, graph.interner, method, module_row.functions, body_by_start, empty_tree)
                    }
                }
            }
            .Enum(definition) -> {
                loop method in definition.methods {
                    sema_state_check_function(walk, graph.interner, method, module_row.functions, body_by_start, empty_tree)
                }
            }
            .Test(test) -> {
                sema_state_start(walk)
                ^body_idx: sema_state_body_index(module_row.functions, body_by_start, test.span)
                walk.typed = body_idx >= 0
                if body_idx >= 0 {
                    sema_state_block(walk, graph.interner, module_row.functions[body_idx].tree, test.body)
                } else { sema_state_block(walk, graph.interner, empty_tree, test.body) }
            }
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    ^found: walk.diagnostics.move()
    if found.len() > 0 {
        sema_attach_diagnostic_source_locations(found, 0, graph.modules[registration].source_segments)
    }
    found
}

sema_state_body_index: fn(bodies: [FnBody], body_by_start: [Int:Int], span: Span) -> Int Never! {
    if body_by_start.get(span.start) == .Val(idx) && bodies[idx].source_span == span -> return idx
    loop (idx, body) in bodies {
        if body.source_span == span -> return idx
    }
    -1
}

// A body starts with no facts, on a path that has not left it.
sema_state_start: fn(walk: ^SemaStateWalk) Never! { walk.flow = sema_state_flow_start() }

// `self` and every other parameter typed by states start in them, so a chain
// of moves on `self` checks.
sema_state_check_function: fn(walk: ^SemaStateWalk, interner: Interner, function: Func, bodies: [FnBody], body_by_start: [Int:Int], empty_tree: BodyTree) Never! {
    sema_state_start(walk)
    body_idx: sema_state_body_index(bodies, body_by_start, function.span)
    walk.typed = body_idx >= 0
    loop typed in function.state_types {
        if typed.position < 0 || typed.position >= function.params.len() -> next
        id: sema_state_local_id(walk, function.params[typed.position].name)
        sema_state_put_known(walk.flow.current, id, sema_state_set_value(typed.states))
    }
    if body_idx >= 0 -> sema_state_block(walk, interner, bodies[body_idx].tree, function.body) else {
        sema_state_block(walk, interner, empty_tree, function.body)
    }
}

// A state set as one tracked value: its names joined by `|`.
sema_state_set_value: fn(states: [String]) -> String Never! { states.join("|") }

// A state set as the reader sees it: `Order.Draft` or
// `Order.Draft | Order.Confirmed`.
sema_state_set_text: fn(owner: String, states: String) -> String Never! {
    parts: loop state in states.split("|").to_list() -> "{owner}.{state}"
    parts.join(" | ")
}

// Whether every state `current` may be in is one of `required`.
sema_state_set_within: fn(current: String, required: String) -> Bool Never! {
    allowed: required.split("|").to_list()
    loop state in current.split("|").to_list() {
        if !allowed.contains(state) -> return false
    }
    true
}

// The rows a function's state types add: one need per typed parameter, by
// its argument position in a call (the receiver is -1), and the result's
// states.
sema_state_table_add_typed: fn(table: ^SemaStateTable, key: String, function: Func) Never! {
    if function.state_types.len() == 0 {
        return
    }
    receiver: function.params.len() > 0 && function.params[0].name == "self"
    ^needs: [SemaStateNeed]{}
    id: sema_state_table_id(table, key)
    loop typed in function.state_types {
        if typed.position == -1 {
            table.results[id] = sema_state_set_value(typed.states)
            next
        }
        arg: if receiver -> typed.position - 1 else -> typed.position
        needs.push(SemaStateNeed{arg: arg, owner: typed.owner, states: sema_state_set_value(typed.states)})
    }
    if needs.len() > 0 {
        table.needs[id] = needs.move()
        table.typed_keys.push(key.copy())
    }
}

sema_state_table_add_items: fn(table: ^SemaStateTable, items: [Item]) Never! {
    loop item in items {
        if item == {
            .Func(function) -> { sema_state_table_add_typed(table, function.name, function) }
            .Impl(implementation) -> {
                loop method in implementation.methods {
                    sema_state_table_add_method(table, implementation.type_name, method)
                }
            }
            .Struct(definition) -> {
                loop method in definition.methods {
                    sema_state_table_add_method(table, definition.name, method)
                }
                loop block in definition.trait_impls {
                    loop method in block.methods {
                        sema_state_table_add_method(table, definition.name, method)
                    }
                }
            }
            .Enum(definition) -> {
                if definition.state == .Val(state) {
                    _: name_intern(table.owners, definition.name)
                    id: sema_state_table_id(table, definition.name)
                    table.cases[id] = loop entry in state.states -> entry.name
                }
                loop method in definition.methods {
                    sema_state_table_add_method(table, definition.name, method)
                }
            }
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

sema_state_table_add_method: fn(table: ^SemaStateTable, type_name: String, method: Func) Never! {
    if method.state_types.len() == 0 {
        return
    }
    _: name_intern(table.owners, type_name)
    sema_state_table_add_typed(table, "{type_name}.{method.name}", method)
}

sema_state_nominal: fn(ty: Type) -> String? Never! {
    if ty == {
        .Named(name) -> Val(name)
        .Apply(name, _) -> Val(name)
        .Tagged(_, inner) -> sema_state_nominal(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// The nominal type of a checked node, without its module qualification. The
// module and the type may both hold `.` (`app.Payment.Client`), so the type
// is the longest tail the table knows as an owner, else the last segment.
sema_state_node_type: fn(walk: SemaStateWalk, interner: Interner, tree: BodyTree, id: Int) -> String? Never! {
    if !walk.typed -> return None
    tid: checked_expr_type_id(tree.expr_types, id) ?? return None
    name: sema_state_nominal(type_syntax(interner, tid)) ?? return None
    bytes: name.bytes()
    ^last: 0
    loop at in 0..<bytes.len() {
        if (Int{bytes[at]}) != 46 -> next
        tail: foundation_byte_text(bytes, at + 1, bytes.len())
        if name_find(walk.table.owners, tail) == .Val(_) -> return Val(tail)
        last = at + 1
    }
    Val(foundation_byte_text(bytes, last, bytes.len()))
}

// The type a static method call `Type.ctor()` / `Ns.Type.ctor()` names.
sema_state_static_type: fn(receiver: Expr) -> String? Never! {
    if receiver == {
        .Ident(name, _, _) -> Val(name)
        .Field(base, leaf, _, _) -> {
            if base == .Ident(prefix, _, _) {
                if prefix.len() > 0 && prefix.bytes()[0] >= 65 && prefix.bytes()[0] <= 90 {
                    return Val("{prefix}.{leaf}")
                }
            }
            None
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_state_block: fn(walk: ^SemaStateWalk, interner: Interner, tree: BodyTree, statements: [Stmt]) Never! {
    loop statement in statements {
        if walk.flow.ended -> break
        sema_state_statement(walk, interner, tree, statement)
    }
}

// The states a local whose fact is `fact` may be in: one, several where
// paths met in different states, or none when it is untracked.
sema_state_possible: fn(fact: SemaFlowFact) -> [String] Never! {
    if fact.one != "" -> return [String]{fact.one}
    fact.many
}

sema_state_set: fn(walk: ^SemaStateWalk, name: String, state: String) Never! {
    id: sema_state_local_id(walk, name)
    sema_state_put(walk.flow.current, id, state, [String]{})
}

sema_state_forget: fn(walk: ^SemaStateWalk, name: String) Never! {
    id: sema_state_local_find(walk, name)
    sema_flow_drop(walk.flow.current, id)
}

// Walk one path from `before`; when it falls through to the end of `body`,
// its facts join `paths`.
sema_state_path: fn(walk: ^SemaStateWalk, interner: Interner, tree: BodyTree, before: SemaFlowFacts, body: [Stmt], paths: ^[SemaFlowFacts]) Never! {
    sema_flow_restore(walk.flow, before)
    sema_state_block(walk, interner, tree, body)
    sema_flow_reach(walk.flow, paths)
}

// The typestate plane's join (SemaFlowPlane): a state survives only when
// both paths carry it and agree. Where both track a local and disagree, it
// may be in any of their states; a split of two known states is L0152.
sema_state_join: fn(binding: Int, left: SemaFlowFact, right: SemaFlowFact, splits: ^[SemaFlowSplit]) -> SemaFlowFact Never! {
    one: sema_state_possible(left)
    if one.len() == 0 -> return SemaFlowFact{}
    other: sema_state_possible(right)
    if other.len() == 0 -> return SemaFlowFact{}
    if one.len() == 1 && other.len() == 1 {
        if one[0] == other[0] -> return SemaFlowFact{held: true, one: one[0]}
        splits.push(SemaFlowSplit{binding: binding, one: one[0], other: other[0]})
    }
    ^possible: one.copy()
    loop state in other {
        if !possible.contains(state) -> possible.push(state)
    }
    possible.sort()
    SemaFlowFact{held: true, many: possible}
}

// The paths that fall through meet (sema_flow_meet), and every split is
// L0152.
sema_state_merge: fn(walk: ^SemaStateWalk, paths: ^^[SemaFlowFacts], span: Span) Never! {
    ^splits: [SemaFlowSplit]{}
    sema_flow_meet(walk.flow, paths, splits)
    sema_state_report(walk, splits, span)
}

// A loop's body, met by the one loop rule (sema_flow_loop_leave).
sema_state_loop: fn(walk: ^SemaStateWalk, interner: Interner, tree: BodyTree, body: [Stmt], span: Span) Never! {
    entered: sema_flow_loop_enter(walk.flow)
    sema_state_block(walk, interner, tree, body)
    sema_state_after_loop(walk, entered, span)
}

sema_state_after_loop: fn(walk: ^SemaStateWalk, entered: ^^SemaFlowLoop, span: Span) Never! {
    ^splits: [SemaFlowSplit]{}
    sema_flow_loop_leave(walk.flow, entered, splits)
    sema_state_report(walk, splits, span)
}

// One L0152 per diverging local, in name order; the first split by state
// order names the two states.
sema_state_report: fn(walk: ^SemaStateWalk, splits: [SemaFlowSplit], span: Span) Never! {
    if splits.len() == 0 {
        return
    }
    ^names: [String]{}
    loop split in splits {
        name: name_text(walk.locals, Name{id: U32{split.binding}})
        if !names.contains(name) -> names.push(name)
    }
    names.sort()
    loop name in names {
        ^pairs: [String]{}
        loop split in splits {
            if name_text(walk.locals, Name{id: U32{split.binding}}) == name {
                pairs.push("{split.one} {split.other}")
            }
        }
        pairs.sort()
        states: pairs[0].split(" ").to_list()
        walk.diagnostics.push(sema_lint("L0152", span, "`{name}` ends in state `{states[0]}` on one path and `{states[1]}` on another.", "typestate: after two paths meet, a state holds only when both paths agree — here they do not, so from this point an operation that needs one of these states is rejected.", "bring both paths to the same state before they meet, or do the work that needs the state inside the path that reaches it."))
    }
}

sema_state_switch: fn(walk: ^SemaStateWalk, interner: Interner, tree: BodyTree, subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span) Never! {
    sema_state_expr(walk, interner, tree, subject)
    before: walk.flow.current.copy()
    // A local of an enum with a state list is in the arm's case inside that
    // arm; the narrowing ends with the arm.
    local: sema_state_local(subject) ?? ""
    cases: sema_state_subject_cases(walk, interner, tree, subject)
    ^paths: [SemaFlowFacts]{}
    loop arm in arms {
        sema_flow_restore(walk.flow, before)
        ^narrowed: String?{None}
        if cases.len() > 0 -> narrowed = sema_state_arm_case(arm.cond, cases)
        if narrowed == .Val(arm_state) {
            id: sema_state_local_id(walk, local)
            sema_state_put_known(walk.flow.current, id, arm_state)
        }
        sema_state_expr(walk, interner, tree, arm.cond)
        sema_state_block(walk, interner, tree, arm.body)
        if narrowed != None -> sema_state_end_narrowing(walk, before, local)
        sema_flow_reach(walk.flow, paths)
    }
    if else_body == .Val(body) -> sema_state_path(walk, interner, tree, before, body, paths)
    exhaustive: sema_flow_arms_exhaustive(arms, walk.open_switches, span)
    sema_state_arms_merge(walk, before, paths, else_body != None, exhaustive, span)
}

// The arm paths meet by the one arm-table rule (sema_flow_arms_meet), and
// every split is L0152.
sema_state_arms_merge: fn(walk: ^SemaStateWalk, before: ^^SemaFlowFacts, paths: ^^[SemaFlowFacts], has_else: Bool, exhaustive: Bool, span: Span) Never! {
    ^splits: [SemaFlowSplit]{}
    sema_flow_arms_meet(walk.flow, before, paths, has_else, exhaustive, splits)
    sema_state_report(walk, splits, span)
}

// The cases of the state list of the enum a local subject has; empty for any
// other subject.
sema_state_subject_cases: fn(walk: SemaStateWalk, interner: Interner, tree: BodyTree, subject: Expr) -> [String] Never! {
    if sema_state_table_empty(walk.table) || sema_state_local(subject) == None -> return [String]{}
    owner: sema_state_node_type(walk, interner, tree, sema_state_expr_id(subject)) ?? return [String]{}
    walk.table.cases[sema_state_table_find(walk.table, owner)]
}

// A narrowed local leaves its branch in the states it had before it.
sema_state_end_narrowing: fn(walk: ^SemaStateWalk, before: SemaFlowFacts, local: String) Never! {
    id: sema_state_local_find(walk, local)
    state: sema_state_known(before, id)
    if state == "" {
        sema_state_drop_known(walk.flow.current, id)
        return
    }
    sema_state_put_known(walk.flow.current, id, state)
}

// The case (or `|`-joined cases) an arm's pattern names, when each is one of
// `cases`: `.Shut`, `.Locked(code)`, `.Shut | .Open`.
sema_state_arm_case: fn(cond: Expr, cases: [String]) -> String? Never! {
    if cond == .PatternTest(_, pattern, _, _) -> return sema_state_pattern_case(pattern, cases)
    None
}

sema_state_pattern_case: fn(pattern: Pattern, cases: [String]) -> String? Never! {
    if pattern == .Variant(variant, _, _, _) {
        if cases.contains(variant) -> return Val(variant)
        return None
    }
    if pattern == .Or(alternatives, _) {
        ^names: [String]{}
        loop alternative in alternatives {
            name: sema_state_pattern_case(alternative, cases) ?? return None
            if !names.contains(name) -> names.push(name)
        }
        if names.len() == 0 -> return None
        return Val(names.join("|"))
    }
    None
}

// The case an enum value names, when its enum has a state list:
// `Door.Shut`, `.Shut`, `.Locked(code: 7)`.
sema_state_case: fn(walk: SemaStateWalk, interner: Interner, tree: BodyTree, value: Expr) -> String? Never! {
    ^owner: String?{None}
    ^variant: ""
    if value == .EnumLit(type_name, name, _, _, _, _, id) {
        variant = name
        if type_name != "" {
            parts: type_name.split(".").to_list()
            owner = Val(parts[parts.len() - 1])
        } else { owner = sema_state_node_type(walk, interner, tree, id) }
    } else if value == .Field(base, member, _, _) {
        if base == .Ident(type_name, _, _) {
            owner = Val(type_name)
            variant = member
        }
    }
    name: owner ?? return None
    if walk.table.cases[sema_state_table_find(walk.table, name)].contains(variant) {
        return Val(variant)
    }
    None
}

// A binding or plain assignment takes the states its value's type names, or
// (a binding only) the states of the local it aliases; otherwise it is
// untracked.
sema_state_rebind: fn(walk: ^SemaStateWalk, interner: Interner, tree: BodyTree, name: String, value: Expr, aliases: Bool) Never! {
    if sema_state_result(walk, interner, tree, value) == .Val(to) {
        sema_state_set(walk, name, to)
        return
    }
    if aliases {
        if value == .Ident(source, _, _) {
            id: sema_state_local_find(walk, source)
            state: sema_state_known(walk.flow.current, id)
            if state != "" {
                sema_state_set(walk, name, state)
                return
            }
            possible: sema_state_met(walk.flow.current, id)
            if possible.len() > 0 {
                target: sema_state_local_id(walk, name)
                sema_state_drop_known(walk.flow.current, target)
                sema_state_put_met(walk.flow.current, target, possible)
                return
            }
        }
    }
    sema_state_forget(walk, name)
}

sema_state_statement: fn(walk: ^SemaStateWalk, interner: Interner, tree: BodyTree, statement: Stmt) Never! {
    if statement == {
        .Expr(value) -> { sema_state_expr(walk, interner, tree, value) }
        .Yield(value, _) -> { sema_state_expr(walk, interner, tree, value) }
        .DeferClose(value, _) -> { sema_state_expr(walk, interner, tree, value) }
        .BreakValue(value, _) -> {
            sema_state_expr(walk, interner, tree, value)
            sema_flow_leave_loop(walk.flow)
        }
        .BreakLabelValue(_, _, value, _) -> {
            sema_state_expr(walk, interner, tree, value)
            sema_flow_leave_loop(walk.flow)
        }
        .Val(binding) -> {
            sema_state_expr(walk, interner, tree, binding.init)
            if binding.name.len() > 0 {
                sema_state_rebind(walk, interner, tree, binding.name, binding.init, true)
            }
        }
        .Assign(target, op, _, value) -> {
            sema_state_expr(walk, interner, tree, value)
            if op == None {
                if target == .Local(name, _) {
                    sema_state_rebind(walk, interner, tree, name, value, false)
                }
            }
        }
        .Return(value, _) -> {
            if value == .Val(returned) -> sema_state_expr(walk, interner, tree, returned)
            sema_flow_end(walk.flow)
        }
        .While(cond, body, span, _, _) -> {
            sema_state_expr(walk, interner, tree, cond)
            sema_state_loop(walk, interner, tree, body, span)
        }
        .For(_, _, _, kind, body, span, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    sema_state_expr(walk, interner, tree, start)
                    sema_state_expr(walk, interner, tree, end)
                    if step == .Val(value) -> sema_state_expr(walk, interner, tree, value)
                }
                .In(collection, step, _) -> {
                    sema_state_expr(walk, interner, tree, collection)
                    if step == .Val(value) -> sema_state_expr(walk, interner, tree, value)
                }
            }
            sema_state_loop(walk, interner, tree, body, span)
        }
        .Switch(subject, arms, else_body, span) -> {
            sema_state_switch(walk, interner, tree, subject, arms, else_body, span)
        }
        .ComptimeSwitch(subject, arms, else_body, span) -> {
            sema_state_switch(walk, interner, tree, subject, arms, else_body, span)
        }
        .CountedLoop(init, cond, step, body, span, _, _) -> {
            sema_state_expr(walk, interner, tree, init.init)
            sema_state_expr(walk, interner, tree, cond)
            entered: sema_flow_loop_enter(walk.flow)
            sema_state_block(walk, interner, tree, body)
            if step == .Val(advance) -> sema_state_statement(walk, interner, tree, advance)
            sema_state_after_loop(walk, entered, span)
        }
        .Loop(body, span, _, _) -> { sema_state_loop(walk, interner, tree, body, span) }
        .Unsafe(_, _, body, _) -> { sema_state_block(walk, interner, tree, body) }
        .Impure(_, _, body, _) -> { sema_state_block(walk, interner, tree, body) }
        .Reactive(body, _) -> sema_state_block(walk, interner, tree, body)
        .Shield(body, _) | .Defer(body, _) -> { sema_state_block(walk, interner, tree, body) }
        .Switched(_, body, _) -> { sema_state_block(walk, interner, tree, body) }
        .Region(_, _, body, _) -> { sema_state_block(walk, interner, tree, body) }
        .Policy(_, body, _) -> { sema_state_block(walk, interner, tree, body) }
        .TaskGroup(_, _, _, body, _) -> { sema_state_block(walk, interner, tree, body) }
        .Layout(_, _, body, _) -> { sema_state_block(walk, interner, tree, body) }
        .AuthorityScope(_, _, _, body, _) -> { sema_state_block(walk, interner, tree, body) }
        .Transact(_, _, body, _, _) -> { sema_state_block(walk, interner, tree, body) }
        .AssumeDet(_, _, body, _) -> { sema_state_block(walk, interner, tree, body) }
        .ScopeMember(_, _, _, _, body, _, _, _) -> { sema_state_block(walk, interner, tree, body) }
        .Live(body, _) -> { sema_state_block(walk, interner, tree, body) }
        .ComptimeBlock(body, _, _) -> { sema_state_block(walk, interner, tree, body) }
        .ComptimeIf(cond, _, then_body, else_body, span, _) -> {
            sema_state_expr(walk, interner, tree, cond)
            before: walk.flow.current.copy()
            ^paths: [SemaFlowFacts]{}
            sema_state_path(walk, interner, tree, before, then_body, paths)
            if else_body == .Val(body) -> sema_state_path(walk, interner, tree, before, body, paths)
            sema_state_arms_merge(walk, before, paths, else_body != None, false, span)
        }
        .ContextBlock(fields, body, _) -> {
            loop field in fields -> sema_state_expr(walk, interner, tree, field.value)
            sema_state_block(walk, interner, tree, body)
        }
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {
            sema_flow_leave_loop(walk.flow)
        }
    }
}

// The states a call's result type names.
sema_state_result: fn(walk: SemaStateWalk, interner: Interner, tree: BodyTree, value: Expr) -> String? Never! {
    if sema_state_table_empty(walk.table) -> return None
    if sema_state_case(walk, interner, tree, value) == .Val(named) -> return Val(named)
    if value == {
        .OrFallback(inner, _, _, _, _) -> sema_state_result(walk, interner, tree, inner)
        .Copy(inner, _, _) -> sema_state_result(walk, interner, tree, inner)
        .Place(inner, _, _, _) -> sema_state_result(walk, interner, tree, inner)
        .Paren(inner, _, _) -> sema_state_result(walk, interner, tree, inner)
        .Ok(inner, _, _) -> sema_state_result(walk, interner, tree, inner)
        .Try(inner, _, _, _, _) -> sema_state_result(walk, interner, tree, inner)
        .MethodCall(receiver, method, _, _, _, _, _) -> {
            ^type_name: sema_state_node_type(walk, interner, tree, sema_state_expr_id(receiver))
            if type_name == None -> type_name = sema_state_static_type(receiver)
            owner: type_name ?? return None
            sema_state_table_result(walk.table, sema_state_table_find(walk.table, "{owner}.{method}"))
        }
        .Call(call, _) -> sema_state_table_result(walk.table, sema_state_table_find(walk.table, call.name))
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Err(_, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_state_expr_id: fn(value: Expr) -> Int Never! {
    if value == {
        .Ident(_, _, id) -> id
        .Field(_, _, _, id) -> id
        .Call(_, id) -> id
        .MethodCall(_, _, _, _, _, _, id) -> id
        .Paren(_, _, id) -> id
        .Copy(_, _, id) -> id
        // A marked receiver (`order.confirm()`) types as the place it marks.
        .Place(inner, _, _, _) -> sema_state_expr_id(inner)
        .Index(_, _, _, _, id) -> id
        .Deref(_, _, id) -> id
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .RawOf(_, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> -1
    }
}

// The state an argument is in: a tracked local's (where paths met in
// different states, the set of them all), or the result states of the call
// it is.
sema_state_arg_state: fn(walk: SemaStateWalk, interner: Interner, tree: BodyTree, value: Expr) -> String? Never! {
    if sema_state_local(value) == .Val(local) {
        id: sema_state_local_find(walk, local)
        known: sema_state_known(walk.flow.current, id)
        if known != "" -> return Val(known)
        possible: sema_state_met(walk.flow.current, id)
        if possible.len() == 0 -> return None
        ^states: [String]{}
        loop entry in possible {
            loop state in entry.split("|").to_list() {
                if !states.contains(state) -> states.push(state)
            }
        }
        return Val(sema_state_set_value(states))
    }
    sema_state_result(walk, interner, tree, value)
}

// E0150 for each argument whose state is known and is not among the states
// its parameter's type names. `receiver` is a method call's receiver.
sema_state_check_needs: fn(walk: ^SemaStateWalk, interner: Interner, tree: BodyTree, key: String, operation: String, receiver: Expr?, args: [Expr], method_span: Span) Never! {
    id: sema_state_table_find(walk.table, key)
    if walk.table.needs[id].len() == 0 {
        return
    }
    needs: walk.table.needs[id]
    loop need in needs {
        ^subject: receiver
        if need.arg >= 0 -> subject = if need.arg < args.len() -> Val(args[need.arg]) else -> None
        value: subject ?? next
        current: sema_state_arg_state(walk, interner, tree, value) ?? next
        if sema_state_set_within(current, need.states) -> next
        span: if need.arg < 0 -> method_span else -> expr_span(value)
        required: sema_state_set_text(need.owner, need.states)
        found: sema_state_set_text(need.owner, current)
        label: if sema_state_local(value) == .Val(local) -> "`{local}`" else -> "the value"
        moves: sema_state_moves_from(walk, need.owner, current)
        fix: if moves.len() == 0 -> "bring {label} to `{required}` before calling `{operation}`" else -> "moves from `{found}`: {moves.join(", ")}"
        walk.diagnostics.push(sema_error("E0150", span, "`{operation}` needs `{required}`, but {label} is `{found}`", "typestate: `{operation}` takes only `{required}`; calling it with `{need.owner}` in another state is the out-of-order bug the state list rules out", fix))
    }
}

// The methods of `owner` that move a receiver in `state` to another state,
// by name, each in backticks.
sema_state_moves_from: fn(walk: SemaStateWalk, owner: String, state: String) -> [String] Never! {
    keys: loop key in walk.table.typed_keys if key.starts_with("{owner}.") -> key
    ^moves: [String]{}
    loop key in keys {
        id: sema_state_table_find(walk.table, key)
        result: sema_state_table_result(walk.table, id) ?? next
        if result == state -> next
        needs: walk.table.needs[id]
        loop need in needs {
            if need.arg == -1 && sema_state_set_within(state, need.states) {
                moves.push("`{key.slice(owner.len() + 1, key.len())}`")
                break
            }
        }
    }
    moves
}

// State types: the receiver and each argument against the states its
// parameter names. The receiver is a value, so it keeps its state; the
// result carries the new one.
sema_state_method: fn(walk: ^SemaStateWalk, interner: Interner, tree: BodyTree, receiver: Expr, method: String, method_span: Span, args: [Expr]) Never! {
    ^typed_owner: sema_state_node_type(walk, interner, tree, sema_state_expr_id(receiver))
    if typed_owner == None -> typed_owner = sema_state_static_type(receiver)
    if typed_owner == .Val(typed_name) {
        sema_state_check_needs(walk, interner, tree, "{typed_name}.{method}", method, Val(receiver), args, method_span)
    }
}

sema_state_call: fn(walk: ^SemaStateWalk, interner: Interner, tree: BodyTree, name: String, args: [Expr]) Never! {
    sema_state_check_needs(walk, interner, tree, name, name, None, args, expr_span(args[0]))
}

// The local a receiver or first argument names, if it is a bare local or a
// marked one (`order.move()`, `^order`).
sema_state_local: fn(value: Expr) -> String? Never! {
    if value == {
        .Ident(name, _, _) -> Val(name)
        .Place(inner, _, _, _) -> sema_state_local(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_state_exprs: fn(walk: ^SemaStateWalk, interner: Interner, tree: BodyTree, values: [Expr]) Never! {
    loop value in values -> sema_state_expr(walk, interner, tree, value)
}

// Walk an expression for typestate violations.
sema_state_expr: fn(walk: ^SemaStateWalk, interner: Interner, tree: BodyTree, value: Expr) Never! {
    if value == {
        .MethodCall(receiver, method, method_span, _, _, args, _) -> {
            sema_state_expr(walk, interner, tree, receiver)
            loop arg in args -> sema_state_expr(walk, interner, tree, arg.expr)
            if !sema_state_table_empty(walk.table) {
                sema_state_method(walk, interner, tree, receiver, method, method_span, loop arg in args -> arg.expr)
            }
        }
        .OptMethodCall(receiver, _, _, _, args, _, _) -> {
            sema_state_expr(walk, interner, tree, receiver)
            loop arg in args -> sema_state_expr(walk, interner, tree, arg.expr)
        }
        .Call(call, _) -> {
            loop arg in call.args -> sema_state_expr(walk, interner, tree, arg.expr)
            if call.args.len() > 0 && !sema_state_table_empty(walk.table) {
                sema_state_call(walk, interner, tree, call.name, loop arg in call.args -> arg.expr)
            }
        }
        .Tainted(inner, _, _, _) -> { sema_state_expr(walk, interner, tree, inner) }
        .Unary(_, inner, _, _) -> { sema_state_expr(walk, interner, tree, inner) }
        .Deref(inner, _, _) -> { sema_state_expr(walk, interner, tree, inner) }
        .RawOf(inner, _, _) -> { sema_state_expr(walk, interner, tree, inner) }
        .Copy(inner, _, _) -> { sema_state_expr(walk, interner, tree, inner) }
        .Place(inner, _, _, _) -> { sema_state_expr(walk, interner, tree, inner) }
        .Field(inner, _, _, _) -> { sema_state_expr(walk, interner, tree, inner) }
        .Present(inner, _, _) -> { sema_state_expr(walk, interner, tree, inner) }
        .Ok(inner, _, _) -> { sema_state_expr(walk, interner, tree, inner) }
        .Err(inner, _, _) -> { sema_state_expr(walk, interner, tree, inner) }
        .Paren(inner, _, _) -> { sema_state_expr(walk, interner, tree, inner) }
        .Spread(inner, _, _) -> { sema_state_expr(walk, interner, tree, inner) }
        .MemberSpread(base, _, _, _) -> { sema_state_expr(walk, interner, tree, base) }
        .OptField(base, _, _, _, _, _) -> { sema_state_expr(walk, interner, tree, base) }
        .Try(inner, _, _, context, _) -> {
            sema_state_expr(walk, interner, tree, inner)
            if context == .Val(note) -> sema_state_expr(walk, interner, tree, note)
        }
        .Binary(_, left, right, _, _) -> {
            loop operand in expr_binary_operands(walk.tables, left, right) {
                sema_state_expr(walk, interner, tree, operand)
            }
        }
        .CompareChain(operands, _, _, _, _) -> { sema_state_exprs(walk, interner, tree, operands) }
        .CallValue(callee, args, _, _) -> {
            sema_state_expr(walk, interner, tree, callee)
            loop arg in args -> sema_state_expr(walk, interner, tree, arg.expr)
        }
        .Index(base, position, _, _, _) -> {
            sema_state_expr(walk, interner, tree, base)
            sema_state_expr(walk, interner, tree, position)
        }
        .Slice(base, start, end, range, _, _) -> {
            sema_state_expr(walk, interner, tree, base)
            if range == .Val(whole) -> sema_state_expr(walk, interner, tree, whole) else {
                sema_state_expr(walk, interner, tree, start)
                sema_state_expr(walk, interner, tree, end)
            }
        }
        .Range(start, end, _, _, _) -> {
            sema_state_expr(walk, interner, tree, start)
            sema_state_expr(walk, interner, tree, end)
        }
        .ListLit(elements, _, _) -> { sema_state_exprs(walk, interner, tree, elements) }
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                sema_state_expr(walk, interner, tree, entry.key)
                sema_state_expr(walk, interner, tree, entry.value)
            }
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields -> sema_state_expr(walk, interner, tree, field.value)
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            loop field in fields -> sema_state_expr(walk, interner, tree, field.value)
        }
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> {
                    loop field in fields -> sema_state_expr(walk, interner, tree, field.value)
                }
                .Elements(elements) -> { sema_state_exprs(walk, interner, tree, elements) }
                .Entries(entries) -> {
                    loop entry in entries {
                        sema_state_expr(walk, interner, tree, entry.key)
                        sema_state_expr(walk, interner, tree, entry.value)
                    }
                }
                .Value(inner) -> sema_state_expr(walk, interner, tree, inner)
                .ByteText(_) | .Empty -> {}
            }
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop arg in args {
                if arg == {
                    .Positional(inner) -> { sema_state_expr(walk, interner, tree, inner) }
                    .Named(_, inner) -> sema_state_expr(walk, interner, tree, inner)
                }
            }
        }
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(inner, _) -> sema_state_expr(walk, interner, tree, inner)
            }
        }
        .If(cond, then_body, then_value, else_body, else_value, span, _) -> {
            sema_state_expr(walk, interner, tree, cond)
            before: walk.flow.current
            ^paths: [SemaFlowFacts]{}
            // A value `if door == { .Locked(_) -> … }` nests its arms as `if`s
            // on pattern tests: the branch sees the local in the tested case.
            ^local: ""
            ^narrowed: String?{None}
            if cond == .PatternTest(subject, pattern, _, _) {
                local = sema_state_local(subject) ?? ""
                narrowed = sema_state_pattern_case(pattern, sema_state_subject_cases(walk, interner, tree, subject))
            }
            if narrowed == .Val(arm_state) {
                id: sema_state_local_id(walk, local)
                sema_state_put_known(walk.flow.current, id, arm_state)
            }
            sema_state_block(walk, interner, tree, then_body)
            if !walk.flow.ended -> sema_state_expr(walk, interner, tree, then_value)
            if narrowed != None -> sema_state_end_narrowing(walk, before, local)
            sema_flow_reach(walk.flow, paths)
            sema_flow_restore(walk.flow, before)
            sema_state_block(walk, interner, tree, else_body)
            if !walk.flow.ended -> sema_state_expr(walk, interner, tree, else_value)
            sema_flow_reach(walk.flow, paths)
            sema_state_merge(walk, paths, span)
        }
        .PatternTest(subject, _, _, _) -> { sema_state_expr(walk, interner, tree, subject) }
        .PtrFromAddr(_, _, _, addr, _, _) -> { sema_state_expr(walk, interner, tree, addr) }
        .Pipe(head, steps, _, _) -> {
            sema_state_expr(walk, interner, tree, head)
            loop step in steps -> sema_state_expr(walk, interner, tree, step.value)
        }
        .OrFallback(inner, fallback, _, _, _) -> {
            sema_state_expr(walk, interner, tree, inner)
            ^paths: [SemaFlowFacts]{walk.flow.current.copy()}
            if fallback == {
                .Value(other) -> { sema_state_expr(walk, interner, tree, other) }
                .Block(body, result, _) -> {
                    sema_state_block(walk, interner, tree, body)
                    if !walk.flow.ended {
                        if result == .Val(other) -> sema_state_expr(walk, interner, tree, other)
                    }
                }
                .Return(result, _) -> {
                    if result == .Val(other) -> sema_state_expr(walk, interner, tree, other)
                    sema_flow_end(walk.flow)
                }
                .Panic(_, _) -> sema_flow_end(walk.flow)
                .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {
                    sema_flow_leave_loop(walk.flow)
                }
            }
            sema_flow_reach(walk.flow, paths)
            sema_state_merge(walk, paths, expr_span(value))
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Ident(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .Lambda(_, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}
