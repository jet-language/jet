// A rollback point for a probe check run on the live context (instead of a
// sema_check_context_snapshot copy, which costs every row the function has
// accumulated so far). The rows a check only appends to keep their lengths and
// are truncated on rollback; every other field is copied into `saved` (whose
// appended-row lists stay empty). As with a snapshot, the probe starts with no
// `iter_borrowed` rows and no binding initializer open. A new
// SemaCheckContext field must be added here and in the rollback.
pub struct SemaCheckContextMark {
    pub call_facts: Int
    pub call_return_views: Int
    pub local_view_provenance: Int
    pub name_references: Int
    pub comptime_requests: Int
    pub comptime_body_sources: Int
    pub comptime_body_values: Int
    pub compute_calls: Int
    pub autodiff_obligations: Int
    pub copy_events: Int
    pub noelse_chain_starts: Int
    pub failure_edges: Int
    pub failure_union_members: Int
    pub failure_union_cases: Int
    pub failure_union_edges: Int
    pub incomplete_reasons: Int
    pub saved: SemaCheckContext
}

pub fn sema_check_context_mark(context: &SemaCheckContext) -> SemaCheckContextMark Never! {
    mark :: sema_check_context_save(context)
    context.iter_borrowed = [String]{}
    context.binding_initializer = false
    mark
}

// A rollback point that leaves the context as it is: the check that follows
// is the real one, rolled back only if its result is discarded.
pub fn sema_check_context_save(context: SemaCheckContext) -> SemaCheckContextMark Never! {
    SemaCheckContextMark{
        call_facts: context.call_facts.len(),
        call_return_views: context.call_return_views.len(),
        local_view_provenance: context.local_view_provenance.len(),
        name_references: context.name_references.len(),
        comptime_requests: context.comptime_requests.len(),
        comptime_body_sources: context.comptime_body_sources.len(),
        comptime_body_values: context.comptime_body_values.len(),
        compute_calls: context.compute_calls.len(),
        autodiff_obligations: context.autodiff_obligations.len(),
        copy_events: context.copy_events.len(),
        noelse_chain_starts: context.noelse_chain_starts.len(),
        failure_edges: context.failure_edges.len(),
        failure_union_members: context.failure_union_members.len(),
        failure_union_cases: context.failure_union_cases.len(),
        failure_union_edges: context.failure_union_edges.len(),
        incomplete_reasons: context.incomplete_reasons.len(),
        saved: SemaCheckContext{
            exact_int_reachable: context.exact_int_reachable,
            unsafe_depth: context.unsafe_depth,
            borrow_ctx: context.borrow_ctx,
            allow_string_view_read: context.allow_string_view_read,
            suppress_partial_move_root_read: context.suppress_partial_move_root_read,
            allow_fixed_constructor: context.allow_fixed_constructor,
            generic_params: ~context.generic_params,
            lambda_escapes: context.lambda_escapes,
            lambda_statement_tails: ~context.lambda_statement_tails,
            call_facts: [SemaCallSiteFact]{},
            hardware_use: sema_hardware_use_snapshot(context.hardware_use),
            call_return_views: [SemaCallReturnView]{},
            local_view_provenance: [SemaLocalViewProvenance]{},
            return_view_receiver_key: context.return_view_receiver_key,
            return_view_parameter_keys: ~context.return_view_parameter_keys,
            return_view_provenance: context.return_view_provenance,
            name_references: [SemaNameReferenceFact]{},
            comptime_requests: [SemaComptimeRequest]{},
            comptime_body_sources: [SemaComptimeBodySource]{},
            comptime_body_values: [SemaComptimeBodyValue]{},
            compute_calls: [SemaComputeCallFact]{},
            autodiff_obligations: [SemaAutodiffObligation]{},
            autodiff_safe_panic: context.autodiff_safe_panic,
            autodiff_unsafe_panic: context.autodiff_unsafe_panic,
            autodiff_safe_panic_context: context.autodiff_safe_panic_context,
            copy_events: [SemaCopyEvent]{},
            loop_value_frames: ~context.loop_value_frames,
            loop_break_flows: sema_loop_break_flows_snapshot(context.loop_break_flows),
            pending_loop_value: context.pending_loop_value,
            collect_item_types: ~context.collect_item_types,
            last_loop_result_type: context.last_loop_result_type,
            arrow_loop_body: context.arrow_loop_body,
            reactive_upgrades: ~context.reactive_upgrades,
            reactive_upgrade_names: ~context.reactive_upgrade_names,
            reactive_local_keys: ~context.reactive_local_keys,
            reactive_shared_keys: ~context.reactive_shared_keys,
            taskgroups: sema_taskgroup_state_snapshot(context.taskgroups),
            failure_carrier_root: context.failure_carrier_root,
            failure_success_view: context.failure_success_view,
            failure_inference: context.failure_inference,
            inferred_failure_carrier: context.inferred_failure_carrier,
            failure_contract_source: context.failure_contract_source,
            function_name: context.function_name,
            fallback_err_denial: context.fallback_err_denial,
            noelse_chain_starts: [Int]{},
            lost_tail_span: context.lost_tail_span,
            value_tail_span: context.value_tail_span,
            failure_edges: [String]{},
            failure_direct_source: context.failure_direct_source,
            failure_union_members: [Type]{},
            failure_union_cases: [SemaFailureCase]{},
            failure_union_edges: [String]{},
            failure_union_general: context.failure_union_general,
            iter_borrowed: ~context.iter_borrowed,
            binding_initializer: context.binding_initializer,
            source_nesting: context.source_nesting,
            implicit_loop_subject_depth: context.implicit_loop_subject_depth,
            subject_shorthand_depth: context.subject_shorthand_depth,
        },
    }
}

// Closes `mark` without rolling back: the checks since it are kept. In-place
// edit rows stay for any enclosing mark.
pub fn sema_scope_commit(table: &SemaScopeTable, mark: SemaScopeMark) Never! {
    table.open_marks = mark.saved.open_marks
}

// Restores `context` to `mark`: appended rows are dropped (a check only appends
// to these lists; the one in-place row edit, a discarded call fact, stays
// inside the rows its statement appended) and every other field is restored.
pub fn sema_check_context_rollback(context: &SemaCheckContext, mark: SemaCheckContextMark) Never! {
    loop context.call_facts.len() > mark.call_facts -> _ := &context.call_facts.pop()
    loop context.call_return_views.len() > mark.call_return_views -> _ := &context.call_return_views.pop()
    loop context.local_view_provenance.len() > mark.local_view_provenance -> _ := &context.local_view_provenance.pop()
    loop context.name_references.len() > mark.name_references -> _ := &context.name_references.pop()
    loop context.comptime_requests.len() > mark.comptime_requests -> _ := &context.comptime_requests.pop()
    loop context.comptime_body_sources.len() > mark.comptime_body_sources -> _ := &context.comptime_body_sources.pop()
    loop context.comptime_body_values.len() > mark.comptime_body_values -> _ := &context.comptime_body_values.pop()
    loop context.compute_calls.len() > mark.compute_calls -> _ := &context.compute_calls.pop()
    loop context.autodiff_obligations.len() > mark.autodiff_obligations -> _ := &context.autodiff_obligations.pop()
    loop context.copy_events.len() > mark.copy_events -> _ := &context.copy_events.pop()
    loop context.noelse_chain_starts.len() > mark.noelse_chain_starts -> _ := &context.noelse_chain_starts.pop()
    loop context.failure_edges.len() > mark.failure_edges -> _ := &context.failure_edges.pop()
    loop context.failure_union_members.len() > mark.failure_union_members -> _ := &context.failure_union_members.pop()
    loop context.failure_union_cases.len() > mark.failure_union_cases -> _ := &context.failure_union_cases.pop()
    loop context.failure_union_edges.len() > mark.failure_union_edges -> _ := &context.failure_union_edges.pop()
    loop context.incomplete_reasons.len() > mark.incomplete_reasons -> _ := &context.incomplete_reasons.pop()
    saved :: mark.saved
    context.exact_int_reachable = saved.exact_int_reachable
    context.unsafe_depth = saved.unsafe_depth
    context.borrow_ctx = saved.borrow_ctx
    context.allow_string_view_read = saved.allow_string_view_read
    context.suppress_partial_move_root_read = saved.suppress_partial_move_root_read
    context.allow_fixed_constructor = saved.allow_fixed_constructor
    context.generic_params = ~saved.generic_params
    context.lambda_escapes = saved.lambda_escapes
    context.lambda_statement_tails = ~saved.lambda_statement_tails
    context.hardware_use = sema_hardware_use_snapshot(saved.hardware_use)
    context.return_view_receiver_key = saved.return_view_receiver_key
    context.return_view_parameter_keys = ~saved.return_view_parameter_keys
    context.return_view_provenance = saved.return_view_provenance
    context.autodiff_safe_panic = saved.autodiff_safe_panic
    context.autodiff_unsafe_panic = saved.autodiff_unsafe_panic
    context.autodiff_safe_panic_context = saved.autodiff_safe_panic_context
    context.loop_value_frames = ~saved.loop_value_frames
    context.loop_break_flows = sema_loop_break_flows_snapshot(saved.loop_break_flows)
    context.pending_loop_value = saved.pending_loop_value
    context.collect_item_types = ~saved.collect_item_types
    context.last_loop_result_type = saved.last_loop_result_type
    context.arrow_loop_body = saved.arrow_loop_body
    context.reactive_upgrades = ~saved.reactive_upgrades
    context.reactive_upgrade_names = ~saved.reactive_upgrade_names
    context.reactive_local_keys = ~saved.reactive_local_keys
    context.reactive_shared_keys = ~saved.reactive_shared_keys
    context.taskgroups = sema_taskgroup_state_snapshot(saved.taskgroups)
    context.failure_carrier_root = saved.failure_carrier_root
    context.failure_success_view = saved.failure_success_view
    context.failure_inference = saved.failure_inference
    context.inferred_failure_carrier = saved.inferred_failure_carrier
    context.failure_contract_source = saved.failure_contract_source
    context.function_name = saved.function_name
    context.fallback_err_denial = saved.fallback_err_denial
    context.lost_tail_span = saved.lost_tail_span
    context.value_tail_span = saved.value_tail_span
    context.failure_direct_source = saved.failure_direct_source
    context.failure_union_general = saved.failure_union_general
    context.iter_borrowed = ~saved.iter_borrowed
    context.binding_initializer = saved.binding_initializer
    context.source_nesting = saved.source_nesting
    context.implicit_loop_subject_depth = saved.implicit_loop_subject_depth
    context.subject_shorthand_depth = saved.subject_shorthand_depth
}

// Records why the body being checked is incomplete when no diagnostic says so.
// Every path that marks a body incomplete without a diagnostic calls this.
pub fn sema_check_unsupported(context: &SemaCheckContext, reason: String) Never! {
    &context.incomplete_reasons.push(reason)
}

fn sema_scope_hardware_transfers_snapshot(source: [SemaHardwareDMATransferFact]) -> [SemaHardwareDMATransferFact] Never! {
    result := [SemaHardwareDMATransferFact]{}
    loop fact in source -> &result.push(fact)
    result
}

pub fn sema_scope_snapshot(source: SemaScopeTable) -> SemaScopeTable Never! {
    SemaScopeTable{
        frames: ~source.frames,
        bindings: ~source.bindings,
        name_slots: ~source.name_slots,
        name_positions: ~source.name_positions,
        loop_labels: ~source.loop_labels,
        hardware_transfers: sema_scope_hardware_transfers_snapshot(source.hardware_transfers),
        hardware_definite_transfers: sema_scope_hardware_transfers_snapshot(source.hardware_definite_transfers),
        hardware_pending_transfers: sema_scope_hardware_transfers_snapshot(source.hardware_pending_transfers),
        current: source.current,
        knowledge_gate: source.knowledge_gate,
        return_type: source.return_type,
        failure_carrier: source.failure_carrier,
        loop_depth: source.loop_depth,
        ownership_call_depth: source.ownership_call_depth,
        comptime_execution_depth: source.comptime_execution_depth,
        transaction_depth: source.transaction_depth,
        transaction_wall_depth: source.transaction_wall_depth,
        unit_explicit_units: source.unit_explicit_units,
        copies_explicit: source.copies_explicit,
        binding_undo: ~source.binding_undo,
        open_marks: source.open_marks,
    }
}

// Opens a rollback point. Control-flow paths and function bodies are checked
// in place and rolled back, instead of copying the whole table (which holds
// every module declaration) per path.
pub fn sema_scope_mark(table: &SemaScopeTable) -> SemaScopeMark Never! {
    mark :: SemaScopeMark{
        frames: table.frames.len(),
        bindings: table.bindings.len(),
        undo: table.binding_undo.len(),
        saved: SemaScopeTable{
            frames: [SemaScopeFrame]{},
            bindings: [SemaScopeBinding]{},
            name_slots: [String:Int]{},
            name_positions: [[Int]]{},
            loop_labels: ~table.loop_labels,
            hardware_transfers: sema_scope_hardware_transfers_snapshot(table.hardware_transfers),
            hardware_definite_transfers: sema_scope_hardware_transfers_snapshot(table.hardware_definite_transfers),
            hardware_pending_transfers: sema_scope_hardware_transfers_snapshot(table.hardware_pending_transfers),
            current: table.current,
            knowledge_gate: table.knowledge_gate,
            return_type: table.return_type,
            failure_carrier: table.failure_carrier,
            loop_depth: table.loop_depth,
            ownership_call_depth: table.ownership_call_depth,
            comptime_execution_depth: table.comptime_execution_depth,
            transaction_depth: table.transaction_depth,
            transaction_wall_depth: table.transaction_wall_depth,
            unit_explicit_units: table.unit_explicit_units,
            copies_explicit: table.copies_explicit,
            open_marks: table.open_marks,
        },
    }
    table.open_marks += 1
    mark
}

// Restores the table to `mark`: in-place binding edits are undone newest
// first, rows pushed since the mark are dropped (with their name positions,
// which are ascending per name), and the small fields are restored.
pub fn sema_scope_rollback(table: &SemaScopeTable, mark: SemaScopeMark) Never! {
    undo_index := table.binding_undo.len()
    loop undo_index > mark.undo {
        undo_index -= 1
        restored_index :: table.binding_undo[undo_index].index
        if restored_index < mark.bindings -> table.bindings[restored_index] = ~table.binding_undo[undo_index].binding
    }
    loop table.binding_undo.len() > mark.undo -> _ := &table.binding_undo.pop()
    loop table.bindings.len() > mark.bindings {
        last :: table.bindings.len() - 1
        if table.name_slots.get(table.bindings[last].symbol.name) == .Val(slot) -> _ := &table.name_positions[slot].pop()
        _ := &table.bindings.pop()
    }
    loop table.frames.len() > mark.frames -> _ := &table.frames.pop()
    saved :: mark.saved
    table.loop_labels = ~saved.loop_labels
    table.hardware_transfers = sema_scope_hardware_transfers_snapshot(saved.hardware_transfers)
    table.hardware_definite_transfers = sema_scope_hardware_transfers_snapshot(saved.hardware_definite_transfers)
    table.hardware_pending_transfers = sema_scope_hardware_transfers_snapshot(saved.hardware_pending_transfers)
    table.current = saved.current
    table.knowledge_gate = saved.knowledge_gate
    table.return_type = saved.return_type
    table.failure_carrier = saved.failure_carrier
    table.loop_depth = saved.loop_depth
    table.ownership_call_depth = saved.ownership_call_depth
    table.comptime_execution_depth = saved.comptime_execution_depth
    table.transaction_depth = saved.transaction_depth
    table.transaction_wall_depth = saved.transaction_wall_depth
    table.unit_explicit_units = saved.unit_explicit_units
    table.copies_explicit = saved.copies_explicit
    // Exact even when a nested mark was abandoned by an early return.
    table.open_marks = saved.open_marks
}

// Call before editing `table.bindings[index]` in place, so an open rollback
// point can restore the old row.
pub fn sema_scope_note_binding_edit(table: &SemaScopeTable, index: Int) Never! {
    if table.open_marks == 0 -> return
    previous :: ~table.bindings[index]
    &table.binding_undo.push(SemaScopeBindingUndo{index: index, binding: previous})
}

pub fn sema_scope_hardware_facts(table: SemaScopeTable) -> SemaScopeHardwareFacts Never! {
    SemaScopeHardwareFacts{
        transfers: sema_scope_hardware_transfers_snapshot(table.hardware_transfers),
        definite: sema_scope_hardware_transfers_snapshot(table.hardware_definite_transfers),
        pending: sema_scope_hardware_transfers_snapshot(table.hardware_pending_transfers),
    }
}

pub fn sema_scope_init(module_name: String) -> SemaScopeTable Never! {
    SemaScopeTable{
        frames: [SemaScopeFrame]{SemaScopeFrame{parent: -1, owner: module_name}},
        bindings: [SemaScopeBinding]{},
        name_slots: [String:Int]{},
        name_positions: [[Int]]{},
        loop_labels: [SemaScopeLoopLabel]{},
        hardware_transfers: [SemaHardwareDMATransferFact]{},
        hardware_definite_transfers: [SemaHardwareDMATransferFact]{},
        hardware_pending_transfers: [SemaHardwareDMATransferFact]{},
        current: 0,
        return_type: None,
        failure_carrier: None,
        knowledge_gate: None,
        loop_depth: 0,
        ownership_call_depth: 0,
        comptime_execution_depth: 0,
        transaction_depth: 0,
        transaction_wall_depth: 0,
        unit_explicit_units: false,
    }
}

pub fn sema_scope_function_owner_key(table: SemaScopeTable) -> String Never! {
    if table.current <= 0 -> return ""
    frame := table.current
    loop table.frames[frame].parent > 0 -> frame = table.frames[frame].parent
    table.frames[frame].owner
}

// A local identity is rooted at its enclosing function/lambda and includes
// every lexical frame owner; frame indices are traversal-order artifacts.
pub fn sema_scope_local_owner_key(table: SemaScopeTable) -> String Never! {
    owner := ""
    frame := table.current
    loop frame > 0 {
        frame_owner :: table.frames[frame].owner
        owner = if owner == "" -> frame_owner else -> "{frame_owner}/{owner}"
        frame = table.frames[frame].parent
    }
    owner
}

pub fn sema_scope_enter(table: &SemaScopeTable, state: &SemaOwnershipState, owner: String) -> Int Never! {
    parent :: table.current
    id :: table.frames.len()
    &table.frames.push(SemaScopeFrame{parent: parent, owner: owner})
    table.current = id
    sema_ownership_enter_scope(&state)
    id
}

pub fn sema_scope_leave(table: &SemaScopeTable, state: &SemaOwnershipState) Never! {
    if table.current <= 0 -> return
    leaving := table.current
    remaining_transfers := [SemaHardwareDMATransferFact]{}
    loop fact in table.hardware_transfers {
        if fact.buffer_frame != leaving -> &remaining_transfers.push(fact)
    }
    remaining_definite := [SemaHardwareDMATransferFact]{}
    loop fact in table.hardware_definite_transfers {
        if fact.scope_frame != leaving && fact.buffer_frame != leaving -> &remaining_definite.push(fact)
    }
    remaining_pending := [SemaHardwareDMATransferFact]{}
    loop fact in table.hardware_pending_transfers {
        if fact.buffer_frame != leaving -> &remaining_pending.push(fact)
    }
    table.hardware_transfers = remaining_transfers
    table.hardware_definite_transfers = remaining_definite
    table.hardware_pending_transfers = remaining_pending
    sema_ownership_leave_scope(&state)
    table.current = table.frames[leaving].parent
}
fn sema_scope_hardware_fact_equal(left: SemaHardwareDMATransferFact, right: SemaHardwareDMATransferFact) -> Bool Never! {
    left.transfer_key == right.transfer_key && left.buffer_key == right.buffer_key && left.profile_id == right.profile_id && left.channel == right.channel && left.buffer_name == right.buffer_name && type_identity_equal(left.buffer_type, right.buffer_type)
}
fn sema_scope_hardware_intersection(left: [SemaHardwareDMATransferFact], right: [SemaHardwareDMATransferFact]) -> [SemaHardwareDMATransferFact] Never! {
    result := [SemaHardwareDMATransferFact]{}
    loop candidate in left {
        loop other in right {
            if sema_scope_hardware_fact_equal(candidate, other) {
                &result.push(candidate)
                break
            }
        }
    }
    result
}
fn sema_scope_hardware_union(left: [SemaHardwareDMATransferFact], right: [SemaHardwareDMATransferFact]) -> [SemaHardwareDMATransferFact] Never! {
    result := sema_scope_hardware_transfers_snapshot(left)
    loop candidate in right {
        found := false
        loop existing in result {
            if sema_scope_hardware_fact_equal(candidate, existing) -> found = true
        }
        if !found -> &result.push(candidate)
    }
    result
}
pub fn sema_scope_hardware_join(before: SemaScopeHardwareFacts, then_path: SemaScopeHardwareFacts, else_path: SemaScopeHardwareFacts, has_else: Bool) -> SemaScopeHardwareFacts Never! {
    transfers := sema_scope_hardware_union(before.transfers, then_path.transfers)
    definite := sema_scope_hardware_intersection(before.definite, then_path.definite)
    pending := sema_scope_hardware_union(before.pending, then_path.pending)
    if has_else {
        transfers = sema_scope_hardware_union(transfers, else_path.transfers)
        definite = sema_scope_hardware_intersection(definite, else_path.definite)
        pending = sema_scope_hardware_union(pending, else_path.pending)
    }
    SemaScopeHardwareFacts{transfers: transfers, definite: definite, pending: pending}
}

pub fn sema_scope_join_hardware_paths(table: &SemaScopeTable, before: SemaScopeHardwareFacts, then_path: SemaScopeHardwareFacts, else_path: SemaScopeHardwareFacts, has_else: Bool) Never! {
    joined :: sema_scope_hardware_join(before, then_path, else_path, has_else)
    table.hardware_transfers = sema_scope_hardware_transfers_snapshot(joined.transfers)
    table.hardware_definite_transfers = sema_scope_hardware_transfers_snapshot(joined.definite)
    table.hardware_pending_transfers = sema_scope_hardware_transfers_snapshot(joined.pending)
}

pub fn sema_scope_enter_existing(table: &SemaScopeTable, owner: String) -> Bool Never! {
    if table.frames[table.current].owner == owner -> return true
    parent :: table.current
    loop (index, frame) in table.frames {
        if frame.parent == parent && frame.owner == owner {
            table.current = index
            return true
        }
    }
    false
}

// Module declarations share one root namespace. The declaration pass reports
// E0105 at the source declaration when this returns false.
pub fn sema_scope_add_module_symbol(table: &SemaScopeTable, symbol: Symbol) -> Bool Never! {
    if table.name_slots.get(symbol.name) == .Val(slot) {
        loop index in table.name_positions[slot] {
            binding :: table.bindings[index]
            if binding.frame == 0 && !binding.compiler_builtin -> return false
        }
    }
    sema_scope_push_binding(&table, SemaScopeBinding{frame: 0, symbol: symbol, mutable: false, access: AccessConvention.Read, integer_bounds: None, string_view: false, compiler_builtin: false})
    true
}

pub fn sema_scope_add_compiler_builtin(table: &SemaScopeTable, graph: SemaRegistrationGraph) -> Bool Never! {
    builtin :: sema_registration_compiler_builtin_row(graph, "Err") ?? return true
    nominal :: graph.modules[builtin.module_index].nominals[builtin.row]
    loop binding in table.bindings {
        if binding.frame == 0 && binding.compiler_builtin && binding.symbol.id.key == nominal.symbol.id.key -> return true
    }
    sema_scope_push_binding(&table, SemaScopeBinding{frame: 0, symbol: nominal.symbol, mutable: false, access: AccessConvention.Read, integer_bounds: None, string_view: false, compiler_builtin: true})
    true
}

fn sema_knowledge_plane_name(plane: SemaKnowledgePlane) -> String Never! {
    if plane == {
        .Range -> "range"
        .Exactness -> "exactness"
        .Unit -> "unit"
        .State -> "state"
        else -> "classification"
    }
}

fn sema_knowledge_gate_spelling(gate: SemaKnowledgeGate) -> String Never! {
    if gate == {
        .BoundedArithmetic -> "wrapping"
        .Approximation -> "approx"
        .RoundedConversion -> "rounded"
        .RawProjection -> "raw"
        .StateTransition -> "transition"
        else -> "scrub"
    }
}

fn sema_knowledge_gate_allows(plane: SemaKnowledgePlane, gate: SemaKnowledgeGate) -> Bool Never! {
    if plane == {
        .Range -> if gate == {
            .BoundedArithmetic | .RawProjection -> true
            else -> false
        }
        .Exactness -> if gate == {
            .Approximation | .RoundedConversion | .RawProjection -> true
            else -> false
        }
        .Unit -> if gate == {
            .RoundedConversion | .RawProjection -> true
            else -> false
        }
        .State -> if gate == {
            .StateTransition | .RawProjection -> true
            else -> false
        }
        .Classification -> if gate == {
            .ClassificationScrub | .RawProjection -> true
            else -> false
        }
        else -> false
    }
}

pub fn sema_scope_push_knowledge_gate(table: &SemaScopeTable, gate: SemaKnowledgeGate) -> SemaKnowledgeGate? {
    previous :: ~table.knowledge_gate
    table.knowledge_gate = Val(gate)
    previous
}

pub fn sema_scope_pop_knowledge_gate(table: &SemaScopeTable, previous: SemaKnowledgeGate?) Never! {
    table.knowledge_gate = previous
}

pub fn sema_scope_knowledge_gate_allows(table: SemaScopeTable, plane: SemaKnowledgePlane, gate: SemaKnowledgeGate) -> Bool Never! {
    active :: table.knowledge_gate ?? return false
    sema_knowledge_gate_allows(plane, active)
}

pub fn sema_scope_require_knowledge_gate(table: &SemaScopeTable, plane: SemaKnowledgePlane, gate: SemaKnowledgeGate, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if sema_scope_knowledge_gate_allows(table, plane, gate) -> return true
    plane_name :: sema_knowledge_plane_name(plane)
    gate_name :: sema_knowledge_gate_spelling(gate)
    &diagnostics.push(sema_error("E0156", span, "This operation would loosen {plane_name}", "Knowledge only tightens silently; loosening {plane_name} must be named with a written gate", "Write `{gate_name}(value)` at this boundary"))
    false
}

// Rust: crates/jet-sema/src/Sema/mod.rs::Checker::explicit_units_enabled
pub fn sema_scope_module_policy(table: &SemaScopeTable, graph: SemaRegistrationGraph, module_identity: String) -> Int Never! {
    if table.policy_modules.get(module_identity) == .Val(position) -> return position
    policy := SemaScopeModulePolicy{
        unit_explicit_units: false,
        copies_explicit: false,
        function_unit_starts: [Int:Int]{},
        function_unit_ends: [[Int:Bool]]{},
    }
    if sema_registration_module_index(graph, module_identity) == .Val(module_index) {
        package_identity :: graph.modules[module_index].package_identity
        loop declaration in graph.modules[module_index].program.policy_declarations {
            if declaration.key != PolicyKey.ExplicitUnits || declaration.scope != PolicyScope.Function -> next
            target :: declaration.target ?? next
            slot := policy.function_unit_starts.get(target.start) ?? -1
            if slot < 0 {
                slot = policy.function_unit_ends.len()
                &policy.function_unit_starts.add(target.start, slot).drop("a new function span start has no slot")
                &policy.function_unit_ends.push([Int:Bool]{})
            }
            &policy.function_unit_ends[slot].add(target.end, true).drop("function unit policy membership")
        }
        loop declaration_index in 0..<graph.modules.len() {
            if graph.modules[declaration_index].package_identity != package_identity -> next
            loop declaration in graph.modules[declaration_index].program.policy_declarations {
                if declaration.scope != PolicyScope.Package && !(declaration.scope == PolicyScope.Module && graph.modules[declaration_index].module_identity == module_identity) -> next
                if declaration.key == PolicyKey.ExplicitUnits -> policy.unit_explicit_units = true
                if sema_string_view_copies_declaration(declaration) -> policy.copies_explicit = true
            }
        }
    }
    position :: table.policy_rows.len()
    &table.policy_modules.add(module_identity, position).drop("a new policy module has no row")
    &table.policy_rows.push(policy)
    position
}

// Rust: crates/jet-sema/src/Sema/mod.rs::Checker::explicit_units_enabled
pub fn sema_scope_seed_unit_policy(table: &SemaScopeTable, graph: SemaRegistrationGraph, module_identity: String) Never! {
    // Module installation is the graph-lifetime boundary, not a function check.
    table.policy_modules = [String:Int]{}
    table.policy_rows = [SemaScopeModulePolicy]{}
    position :: sema_scope_module_policy(&table, graph, module_identity)
    table.unit_explicit_units = table.policy_rows[position].unit_explicit_units
}

// Rust: crates/jet-sema/src/Sema/mod.rs::Checker::explicit_units_enabled
pub fn sema_scope_apply_unit_policy_for_function(table: &SemaScopeTable, graph: SemaRegistrationGraph, module_identity: String, function_span: Span) Never! {
    position :: sema_scope_module_policy(&table, graph, module_identity)
    table.unit_explicit_units = table.policy_rows[position].unit_explicit_units
    if table.policy_rows[position].function_unit_starts.get(function_span.start) == .Val(slot) {
        if table.policy_rows[position].function_unit_ends[slot].get(function_span.end) ?? false -> table.unit_explicit_units = true
    }
}

pub fn sema_scope_push_unit_policy(table: &SemaScopeTable, declarations: [PolicyDeclaration]) -> Bool Never! {
    previous :: table.unit_explicit_units
    loop declaration in declarations {
        if declaration.key == PolicyKey.ExplicitUnits -> table.unit_explicit_units = true
    }
    previous
}

pub fn sema_scope_pop_unit_policy(table: &SemaScopeTable, previous: Bool) Never! {
    table.unit_explicit_units = previous
}

pub fn sema_scope_unit_explicit_units(table: SemaScopeTable) -> Bool Never! {
    table.unit_explicit_units
}

pub fn sema_scope_binding_is_compiler_builtin(binding: SemaScopeBinding, name: String) -> Bool Never! {
    binding.compiler_builtin && binding.symbol.name == name
}

// Locals, parameters, and constants share the function-local namespace.
// Module functions remain resolvable and loop labels use a separate stack.
fn sema_scope_name_blocks_binding(kind: SymbolKind) -> Bool Never! {
    if kind == {
        .Local | .Parameter | .Constant -> true
        else -> false
    }
}

pub fn sema_scope_has_loop_label(table: SemaScopeTable, name: String) -> Bool Never! {
    index := table.loop_labels.len() - 1
    loop index >= 0 {
        if table.loop_labels[index].name == name -> return true
        index -= 1
    }
    false
}

pub fn sema_scope_push_loop_label(table: &SemaScopeTable, name: String) -> Bool Never! {
    duplicate := sema_scope_has_loop_label(table, name)
    if sema_scope_resolve_index(table, name) == .Val(binding_index) {
        binding :: table.bindings[binding_index]
        if sema_scope_name_blocks_binding(binding.symbol.kind) -> duplicate = true
    }
    &table.loop_labels.push(SemaScopeLoopLabel{name: name})
    !duplicate
}

pub fn sema_scope_pop_loop_label(table: &SemaScopeTable) Never! {
    if table.loop_labels.len() > 0 -> _ := &table.loop_labels.pop()
}

// Appends one binding and records its position under its name.
pub fn sema_scope_push_binding(table: &SemaScopeTable, binding: SemaScopeBinding) Never! {
    position :: table.bindings.len()
    if table.name_slots.get(binding.symbol.name) == .Val(slot) {
        &table.name_positions[slot].push(position)
    } else {
        &table.name_slots.add(binding.symbol.name, table.name_positions.len()).drop("the lookup above proved this name has no slot")
        &table.name_positions.push([Int]{position})
    }
    &table.bindings.push(binding)
}

pub fn sema_scope_resolve_index(table: SemaScopeTable, name: String) -> Int? {
    slot :: table.name_slots.get(name) ?? return None
    frame := table.current
    loop frame >= 0 {
        cursor := table.name_positions[slot].len() - 1
        loop cursor >= 0 {
            index :: table.name_positions[slot][cursor]
            if table.bindings[index].frame == frame -> return Val(index)
            cursor -= 1
        }
        frame = table.frames[frame].parent
    }
    None
}

pub fn sema_scope_resolve_index_at(table: SemaScopeTable, name: String, use_span: Span) -> Int? {
    slot :: table.name_slots.get(name) ?? return None
    frame := table.current
    loop frame >= 0 {
        cursor := table.name_positions[slot].len() - 1
        loop cursor >= 0 {
            index :: table.name_positions[slot][cursor]
            binding :: table.bindings[index]
            if binding.frame == frame && binding.symbol.span.start <= use_span.start -> return Val(index)
            cursor -= 1
        }
        frame = table.frames[frame].parent
    }
    None
}

pub fn sema_scope_resolve(table: SemaScopeTable, name: String) -> Symbol? {
    index :: sema_scope_resolve_index(table, name) ?? return None
    Val(table.bindings[index].symbol)
}

// A false return leaves the old binding visible; this prevents a duplicate
// declaration from silently changing the meaning of later references.
pub fn sema_scope_declare_local(table: &SemaScopeTable, symbol: Symbol, mutable: Bool, access: AccessConvention, integer_bounds: TIntegerBounds?, string_view: Bool) -> Bool Never! {
    if symbol.name == "_" -> return true
    if sema_scope_has_loop_label(table, symbol.name) -> return false
    if sema_scope_resolve_index(table, symbol.name) == .Val(index) {
        previous :: table.bindings[index].symbol
        if sema_scope_name_blocks_binding(previous.kind) -> return false
    }
    frame :: table.current
    sema_scope_push_binding(&table, SemaScopeBinding{frame: frame, symbol: symbol, mutable: mutable, access: access, integer_bounds: integer_bounds, string_view: string_view, compiler_builtin: false})
    true
}

// D-FLOWTYPE1=A: a proven payload refines a stable Optional name for the rest
// of its scope. The refinement shadows the carrier binding on purpose, so it
// skips the duplicate-name rule that ordinary declarations obey.
pub fn sema_scope_refine_local(table: &SemaScopeTable, symbol: Symbol) Never! {
    frame :: table.current
    sema_scope_push_binding(&table, SemaScopeBinding{frame: frame, symbol: symbol, mutable: false, access: AccessConvention.Read, integer_bounds: None, string_view: false, compiler_builtin: false})
}

pub fn sema_scope_symbol_by_id(table: SemaScopeTable, id: SymbolID) -> Symbol? {
    loop binding in table.bindings {
        if binding.symbol.id.key == id.key -> return Val(binding.symbol)
    }
    None
}

// Where sema_scope_resolve_declaration finds the declaration `id` names. A
// checker that needs one fact of a declaration reads it at its site through
// the readers below: copying the item copies a nominal's method bodies and
// trait implementations on every expression that names it.
pub enum SemaScopeDeclarationSite {
    Function(module_index: Int, row: Int)
    Nominal(module_index: Int, row: Int)
    Local(index: Int)
}

pub fn sema_scope_declaration_site(environment: SemaScopeEnvironment, id: SymbolID) -> SemaScopeDeclarationSite? {
    if environment.registration_graph == .Val(graph) {
        // The first function and nominal rows by key replace the module scan
        // (earlier modules first, functions before nominals in one module).
        function_module := -1
        function_row := -1
        if graph.callable_rows.get(id.key) == .Val(callable) {
            if callable == .Function(module_index, row) {
                function_module = module_index
                function_row = row
            }
        }
        if graph.nominal_symbol_rows.get(id.key) == .Val(nominal) {
            if function_module < 0 || nominal.module_index < function_module -> return Val(SemaScopeDeclarationSite.Nominal{module_index: nominal.module_index, row: nominal.row})
        }
        if function_module >= 0 -> return Val(SemaScopeDeclarationSite.Function{module_index: function_module, row: function_row})
    }
    loop index in 0..<environment.declarations.len() {
        if environment.declarations[index].symbol_id.key == id.key -> return Val(SemaScopeDeclarationSite.Local{index: index})
    }
    None
}

pub fn sema_scope_resolve_declaration(environment: SemaScopeEnvironment, id: SymbolID) -> Item? {
    site :: sema_scope_declaration_site(environment, id) ?? return None
    if site == .Local(index) -> return Val(environment.declarations[index].item)
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return None
    if site == .Function(module_index, row) -> return Val(Item.Func{value: graph.modules[module_index].functions[row].declaration})
    if site == .Nominal(module_index, row) -> return sema_registration_nominal_source_item(graph.modules[module_index].nominals[row].source)
    None
}

// The item variant of sema_scope_resolve_declaration(environment, id).
pub enum SemaScopeDeclarationKind {
    Func
    Struct
    Enum
    Distinct
    Other
}

fn sema_scope_item_kind(item: Item) -> SemaScopeDeclarationKind Never! {
    if item == {
        .Func(_) -> SemaScopeDeclarationKind.Func
        .Struct(_) -> SemaScopeDeclarationKind.Struct
        .Enum(_) -> SemaScopeDeclarationKind.Enum
        .Distinct(_) -> SemaScopeDeclarationKind.Distinct
        else -> SemaScopeDeclarationKind.Other
    }
}

pub fn sema_scope_declaration_kind(environment: SemaScopeEnvironment, id: SymbolID) -> SemaScopeDeclarationKind? {
    site :: sema_scope_declaration_site(environment, id) ?? return None
    if site == .Local(index) -> return Val(sema_scope_item_kind(environment.declarations[index].item))
    if site == .Function(_, _) -> return Val(SemaScopeDeclarationKind.Func)
    if site == .Nominal(module_index, row) {
        graph_option :: environment.registration_graph
        graph :: graph_option ?? return None
        nominal :: graph.modules[module_index].nominals[row]
        if nominal.source == .SourceAST(item) -> return Val(sema_scope_item_kind(item))
    }
    None
}

pub fn sema_scope_declaration_is(environment: SemaScopeEnvironment, id: SymbolID, kind: SemaScopeDeclarationKind) -> Bool {
    found :: sema_scope_declaration_kind(environment, id) ?? return false
    found == kind
}

// A struct declaration's type parameters and fields, without its methods.
pub struct SemaScopeStructShape {
    pub type_params: [TypeParam]
    pub fields: [Field]
}

fn sema_scope_item_struct(item: Item) -> SemaScopeStructShape? {
    if item == .Struct(definition) -> return Val(SemaScopeStructShape{type_params: definition.type_params, fields: definition.fields})
    None
}

// The struct shape when sema_scope_resolve_declaration(environment, id) is a struct.
pub fn sema_scope_declaration_struct(environment: SemaScopeEnvironment, id: SymbolID) -> SemaScopeStructShape? {
    site :: sema_scope_declaration_site(environment, id) ?? return None
    if site == .Local(index) -> return sema_scope_item_struct(environment.declarations[index].item)
    if site == .Nominal(module_index, row) {
        graph_option :: environment.registration_graph
        graph :: graph_option ?? return None
        nominal :: graph.modules[module_index].nominals[row]
        if nominal.source == .SourceAST(item) -> return sema_scope_item_struct(item)
    }
    None
}

// An enum declaration's type parameters, variants and variant groups, without
// its methods.
pub struct SemaScopeEnumShape {
    pub type_params: [TypeParam]
    pub variants: [Variant]
    pub groups: [EnumGroup]
}

fn sema_scope_item_enum(item: Item) -> SemaScopeEnumShape? {
    if item == .Enum(definition) -> return Val(SemaScopeEnumShape{type_params: definition.type_params, variants: definition.variants, groups: definition.groups})
    None
}

// The enum shape when sema_scope_resolve_declaration(environment, id) is an enum.
pub fn sema_scope_declaration_enum(environment: SemaScopeEnvironment, id: SymbolID) -> SemaScopeEnumShape? {
    site :: sema_scope_declaration_site(environment, id) ?? return None
    if site == .Local(index) -> return sema_scope_item_enum(environment.declarations[index].item)
    if site == .Nominal(module_index, row) {
        graph_option :: environment.registration_graph
        graph :: graph_option ?? return None
        nominal :: graph.modules[module_index].nominals[row]
        if nominal.source == .SourceAST(item) -> return sema_scope_item_enum(item)
    }
    None
}

fn sema_scope_item_enum_declares(item: Item, variant: String) -> Bool Never! {
    if item == .Enum(definition) {
        loop candidate in definition.variants {
            if candidate.name == variant -> return true
        }
    }
    false
}

// sema_scope_resolve_declaration(environment, id) is an enum declaring `variant`.
pub fn sema_scope_declaration_enum_declares(environment: SemaScopeEnvironment, id: SymbolID, variant: String) -> Bool {
    site :: sema_scope_declaration_site(environment, id) ?? return false
    if site == .Local(index) -> return sema_scope_item_enum_declares(environment.declarations[index].item, variant)
    if site == .Nominal(module_index, row) {
        graph_option :: environment.registration_graph
        graph :: graph_option ?? return false
        nominal :: graph.modules[module_index].nominals[row]
        if nominal.source == .SourceAST(item) -> return sema_scope_item_enum_declares(item, variant)
    }
    false
}

fn sema_scope_item_distinct(item: Item) -> DistinctDef? {
    if item == .Distinct(definition) -> return Val(definition)
    None
}

// The declaration when sema_scope_resolve_declaration(environment, id) is a
// distinct type; a distinct declaration has no methods to leave behind.
pub fn sema_scope_declaration_distinct(environment: SemaScopeEnvironment, id: SymbolID) -> DistinctDef? {
    site :: sema_scope_declaration_site(environment, id) ?? return None
    if site == .Local(index) -> return sema_scope_item_distinct(environment.declarations[index].item)
    if site == .Nominal(module_index, row) {
        graph_option :: environment.registration_graph
        graph :: graph_option ?? return None
        nominal :: graph.modules[module_index].nominals[row]
        if nominal.source == .SourceAST(item) -> return sema_scope_item_distinct(item)
    }
    None
}

fn sema_scope_item_function_type_params(item: Item) -> [TypeParam] Never! {
    if item == .Func(func) -> return func.type_params
    [TypeParam]{}
}

// The type parameters when sema_scope_resolve_declaration(environment, id) is
// a function, else none; the function's body is never copied.
pub fn sema_scope_declaration_function_type_params(environment: SemaScopeEnvironment, id: SymbolID) -> [TypeParam] {
    site :: sema_scope_declaration_site(environment, id) ?? return [TypeParam]{}
    if site == .Local(index) -> return sema_scope_item_function_type_params(environment.declarations[index].item)
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return [TypeParam]{}
    if site == .Function(module_index, row) -> return graph.modules[module_index].functions[row].declaration.type_params
    if site == .Nominal(module_index, row) {
        nominal :: graph.modules[module_index].nominals[row]
        if nominal.source == .SourceAST(item) -> return sema_scope_item_function_type_params(item)
    }
    [TypeParam]{}
}
