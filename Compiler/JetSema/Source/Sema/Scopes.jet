// Lexical resolution stores the foundation Symbol unchanged and associates it
// with one active scope. SymbolId remains the stable declaration identity;
// vector positions are only local lookup accelerators.
use jet_foundation.[
    effect_vocabulary_view_count,
    symbol_local_keys_find,
    AccessConvention,
    AST_NODE_GENERATED,
    ASTTables,
    ArithmeticPolicyFact,
    BodyExpr,
    BodyNode,
    BodyTree,
    StmtKind,
    TExprType,
    CoreMarkerApplication,
    DeclID,
    decl_table_key,
    Diagnostic,
    DebugTraceSite,
    DistinctDef,
    ElseArmSpan,
    EnumGroup,
    Expr,
    Field,
    Item,
    SharedLifetime,
    PolicyDeclaration,
    PolicyKey,
    PolicyScope,
    Span,
    Stmt,
    Symbol,
    SymbolID,
    SymbolKind,
    TextEdit,
    symbol_find,
    symbol_is_local,
    symbol_key_text,
    symbol_local_keys_intern,
    symbol_local_keys_text,
    symbol_table_key,
    TComptimeValue,
    TEXPR_FIRST_LOCAL_ID,
    TOriginProjection,
    TTypedGoal,
    TEffectFacts,
    TEffectSpan,
    TIndexProof,
    TFailureCarrier,
    TGenericParam,
    TIntegerBounds,
    Param,
    TTypeDef,
    Type,
    TypeParam,
    Variant,
    ViewProvenanceMap,
    ViewSourcePath,
    type_name,
    expr_node_id,
    Effect,
    Exactness,
    Func,
    Namespace,
    NameTable,
    name_find,
    name_find_hashed,
    name_index,
    name_intern,
    name_table_sized,
    name_text_hash,
    InternerDelta,
    TypeID,
    TypeKind,
    interner,
    interner_fork_delta,
    type_none,
    type_id_well_known,
    type_find_syntax,
    type_kind,
    type_syntax,
    type_id_identity_equal,
    delta_type_intern_syntax,
    delta_type_kind,
    delta_type_syntax,
    delta_type_id_identity_equal,
    ModuleID,
    module_find,
    module_none,
    module_text,
]

SemaKnowledgePlane: enum {
    Range,
    Exactness,
    Unit,
    State,
    Classification,
}

SemaKnowledgeGate: enum {
    BoundedArithmetic,
    Approximation,
    RoundedConversion,
    RawProjection,
    StateTransition,
    ClassificationScrub,
}

SemaScopeFrame: struct {
    parent: Int,
    owner: String,
}

SemaScopeBinding: struct {
    frame: Int,
    symbol: Symbol,
    // The symbol's key text (the run's or the checking body's), by which the
    // ownership facts name the binding.
    key: String,
    mutable: Bool,
    access: AccessConvention,
    integer_bounds: TIntegerBounds?,
    string_view: Bool,
    compiler_builtin: Bool,
    // A `name: #run { … }` local reads as this value.
    prepared: TComptimeValue?{None},
    // A `name: #run value` local whose value has not landed yet: compile-time
    // code that reads it waits for it (sema_comptime_reads_pending_local).
    pending_prepared: Bool{false},
    // The `#Track` origin row for this binding; `None`
    // is the untracked row.
    origin: SemaOriginFact?{None},
    // This `:` name reads a field or element of a place
    // through a view, is a loop name over a collection a read or write
    // parameter owns, or is a match payload bound from storage this scope
    // does not own. It owns nothing to give away: an exact `.move()` of it is
    // E0201 (sema_ownership_mark_move_as), as on a borrowed parameter.
    place_alias: Bool{false},
    // A loop name over a collection a read or write parameter owns keeps the
    // places of the element it reads: a payload matched from the name borrows
    // that element (sema_ownership_record_pattern_views), as one matched from
    // `items[i]` does.
    element_places: [SemaOwnershipPlace]{[SemaOwnershipPlace]{}},
    // A `:` name bound to a new `Shared` cell or a lambda keeps its
    // initializer, so a write into another cell can see the stored value is
    // built in place (SharedCycles.jet).
    fresh_cell: Expr?{None},
    // A `:` name bound to a cell this body builds (`Shared{…}` or
    // `Cell.new(…)`): writes through it stay the body's own
    // (sema_scope_record_module_write).
    own_cell: Bool{false},
    // L0517: a `:` name bound to `path.normalize().to_string()` holds the
    // text of a typed normalized Path (sema_stmt_note_normalized_path_text).
    normalized_path_text: Bool{false},
    // The empty span before a `name: value` binding's name: the E0111
    // machine edit inserts `^` there, so `x: 1` becomes `^x: 1`.
    changeable_mark_at: Span?{None},
    // A `loop name in source` item name: each pass binds it afresh, so an
    // assignment to it is the E0111 that teaches a copy in the loop body.
    loop_item: Bool{false},
    // A name bound to a number literal, or to arithmetic on such literals and
    // names, keeps that literal (with each name replaced by its own): where a
    // use refuses the name's type, it reads as the literal written there
    // (Expressions/NumberNames.jet).
    number_literal: Expr?{None},
    // A `:` name bound to a unit value whose magnitude is a literal (`3meter`,
    // `Double.from_float(-2.0)`) keeps that magnitude: an implicit conversion
    // of the name proves its exactness from it (sema_expr_unit_concrete_value).
    unit_magnitude: Float?{None},
    // A `:` name bound to a lambda this body writes keeps that lambda's effect
    // facts: a call through the name from inside another lambda's body adds
    // them to that lambda's row (sema_expression_lambda_add_effect_facts).
    lambda_effects: TEffectFacts?{None},
    // A `name: (…) -> …` local bound to a lambda keeps the lambda's
    // ClosureInfo record, which `name.reflect()` reads.
    closure: TComptimeValue?{None},
    // A `:` name bound to `^map[key]` is a write window over that one map
    // value: it reads and writes as the value, and where a `ViewMut` of the
    // value's type is expected it is a one-value window, used as `w[0]`
    // (sema_expr_check_ident).
    map_slot: Bool{false},
    // A `:` name bound to an `Authority` whose rights sema can see keeps
    // them, and where they came from: `with` on the name refuses a right
    // none of them covers (sema_call_authority_narrowing).
    authority_rights: SemaAuthorityRights?{None},
}

SemaOriginFact: struct {
    source: String,
    line: Int?,
    column: Int?,
}

// The rights an `Authority` value holds, as the runtime keeps them (sorted
// and unique), and the words that say where they came from: "from
// `Authority.workspace()` on line 3".
SemaAuthorityRights: struct {
    rights: [String],
    origin: String,
}

SemaScopeDeclaration: struct {
    symbol_id: SymbolID,
    item: Item,
}

// One checked call. A row holds what every call carries; the facts only a
// foreign, audited, deprecated, lifecycle, shared, intrinsic or operator
// call carries sit behind one optional `detail` word, so the run's many
// plain calls hold none of them.
// The call facts retained per call site: only `effect_bound` and `local_lambda`
// are ever read after the call expression checks.
SemaCallSiteFacts: struct {
    effect_bound: [EffectRowEntry]?,
    local_lambda: TEffectFacts?{None},
}

SemaCallSiteFact: struct {
    span: Span,
    caller_key: String,
    callee: SymbolID?,
    facts: SemaCallSiteFacts,
    // The statement drops this call's result. The solved effect phase reports
    // it when the callee's row is empty (L0508).
    discarded: Bool,
    // The statement drops this call's result, but the callee's checked
    // carrier can still fail. The bundle failure solve sets `discarded` when
    // it projects the callee onto `T Never!` (#3708).
    discarded_if_infallible: Bool{false},
    // The call runs while compiling (a comptime item, a `#run { }` site or
    // a module value), not in the running program. A function only such calls
    // name is prep code, not a runtime entry (sema_effect_runtime_input_paths).
    compile_time: Bool{false},
    // None for a call that carries no SemaCallSiteDetail fact
    // (sema_call_site_detail_of).
    detail: SemaCallSiteDetail?{None},
}

// What few calls carry (SemaCallSiteFact.detail).
SemaCallSiteDetail: struct {
    // The callee is an extern body (an `#FFI(<lang>)` function or a foreign
    // row) whose effect is this one root.
    foreign_effect_root: String?{None},
    // The foreign callee's row is not descriptor-owned (a written
    // `#Import c.<lib>: module` binding): the call is open-world and reaches
    // the maximal set as well as its `FFI` leaf.
    foreign_opaque: Bool{false},
    // The callee is the `#Unsafe` inline foreign function of this name: the
    // call needs an audited region (E3103).
    unsafe_foreign_name: String?{None},
    // The call is a `mem.<operation>(…)` of an audited `core.mem` operation:
    // sema reports it outside `#Unsafe` as E3101, so the effect pass's E3103
    // for its `#Unsafe` callee would report the call twice.
    audited_operation: Bool{false},
    // The callee is a raw `extern rust` function whose parameter takes a
    // capability: the call needs an audited region (E0702).
    foreign_capability: SemaForeignCapability?{None},
    // A resolved Core lifecycle marker, retained with the checked call site.
    lifecycle: CoreMarkerApplication?{None},
    // The declared callee's `#Deprecated(use:)` replacement name resolves at
    // this call to a local, a parameter or nothing, so a `jet fix` rename
    // wouldn't call the replacement.
    replacement_hidden: Bool{false},
    // The declared callee is `#Deprecated(inline: true)`: the edit that puts
    // its body in place of this call (sema_lifecycle_inline_edit), None when
    // that could change what the call does.
    lifecycle_inline: TextEdit?{None},
    // The call is in a hole table's header, which runs once per arm tried:
    // the effect phase reports it when the callee has an effect (E0442),
    // with this fix, unless the call was already reported for a change.
    hole_header: SemaHoleHeaderFix?{None},
    shared_lifetime: SharedLifetime?{None},
    shared_member: String{""},
    shared_source: String{""},
    // An intrinsic operation's own name (`Clock.system`), recorded with its
    // effect row when the site has no declared callee.
    intrinsic_api: String?{None},
    // The runtime export that answers this intrinsic, when it is a Core call
    // the runtime answers: it reads the process it runs in, so its row grants
    // authority and doesn't prove the call pure, and a local never computes it
    // while compiling. A run-time-only export (runtime_only_read) is never
    // computed while compiling at all.
    runtime_export: String?{None},
    // The call is an `==` or `!=` the operator resolved to its callee
    // (sema_expr_check_operator), with where its operands were written.
    operator: SemaOperatorSite?{None},
}

// `detail`, or None when it holds no fact, so a plain call keeps no box.
sema_call_site_detail_of: fn(detail: SemaCallSiteDetail) -> SemaCallSiteDetail? Never! {
    if detail.foreign_effect_root != None || detail.foreign_opaque || detail.unsafe_foreign_name != None || detail.audited_operation || detail.foreign_capability != None || detail.lifecycle != None {
        return Val(detail)
    }
    if detail.replacement_hidden || detail.lifecycle_inline != None || detail.shared_lifetime != None || detail.shared_member != "" || detail.shared_source != "" || detail.intrinsic_api != None || detail.runtime_export != None || detail.operator != None || detail.hole_header != None {
        return Val(detail)
    }
    None
}

// A copy of `fact`'s detail, an empty one when it has none: what a cold
// reader reads, or what a writer edits and stores back (`fact.detail =
// sema_call_site_detail_of(edited)`). A hot reader matches `fact.detail`.
sema_call_site_detail: fn(fact: SemaCallSiteFact) -> SemaCallSiteDetail Never! {
    fact.detail ?? SemaCallSiteDetail{}
}

// An `==` or `!=` call site: `receiver` is the operand the method is called
// on, `argument` the other; `bare` when the receiver's text can take
// `.method(...)` with no parentheses around it.
SemaOperatorSite: struct {
    negated: Bool,
    receiver: Span,
    argument: Span,
    bare: Bool,
}

// The fix of an E0442 report on a call in a hole table's header
// (sema_expr_hole_header_fix): `edits` name the call's value on the line
// above the table and read the name in the header, and are empty when the
// fix is only shown. `reported` when the call was refused for a change it
// makes, so its effect is not refused again.
SemaHoleHeaderFix: struct {
    fix: String,
    edits: [TextEdit],
    reported: Bool,
}

// A raw `extern rust` callee's name and the capability sigil (`^` or `^^`)
// of its first parameter that takes one.
SemaForeignCapability: struct {
    name: String,
    sigil: String,
}

SemaCallReturnViewFact: struct {
    slot: [String],
    access: AccessConvention,
    places: [SemaOwnershipPlace],
    sources: [ViewSourcePath],
    // Argument or receiver spans of sources that name no place (a temporary
    // owner the call drops when it returns).
    temporaries: [Span]{[Span]{}},
    // The literal field value that holds this view inside a returned
    // aggregate; a report names it rather than the whole returned value.
    span: Span?{None},
}

SemaCallReturnView: struct {
    span: Span,
    facts: [SemaCallReturnViewFact],
}

SemaLocalViewProvenance: struct {
    carrier_key: String,
    output_path: [String],
    access: AccessConvention,
    sources: [ViewSourcePath],
}

// A checked body's read of a declaration's name. A body check records one
// for every name it resolves, so a run holds millions: each row keeps only
// what its readers key and place a reference by, never the Symbol's
// checked type.
SemaNameReferenceFact: struct {
    span: Span,
    symbol: SemaNameReferent,
    // How the reference reads its declaration: as the kind of declaration
    // it names (`.Import` for an import alias), or None for a read resolved
    // by meaning alone; `sema_name_reference_kind_text` spells it for the
    // name ledger and the semantic index.
    kind: SymbolKind?,
    // The key of the checked body whose check recorded the reference
    // (sema_function_check_pass): a local `symbol` is a row of that body's
    // own keys. "" for a reference no body check recorded.
    body: String{""},
}

// The declaration a name reference resolves to: its Symbol's identity and
// definition span, without the checked type or visibility.
SemaNameReferent: struct {
    id: SymbolID,
    kind: SymbolKind,
    name: String,
    module_identity: ModuleID,
    // The owning declaration's key, "" for a declaration nothing owns.
    owner: String,
    span: Span,
}

sema_name_reference_kind_text: fn(kind: SymbolKind?) -> String Never! {
    declared: kind ?? return "semantic"
    if declared == {
        .Function -> "function"
        .Constant -> "const"
        .Parameter -> "param"
        .Local -> "local"
        .Type -> "type"
        .Trait -> "trait"
        .Module -> "module"
        .Field -> "field"
        .Variant -> "variant"
        .Import -> "import_alias"
        .Impl | .Foreign | .Label -> "semantic"
    }
}

// The reference at `span` to `symbol`, read as `kind`.
sema_name_reference: fn(span: Span, symbol: Symbol, kind: SymbolKind?) -> SemaNameReferenceFact Never! {
    SemaNameReferenceFact{span: span, symbol: sema_name_referent(symbol), kind: kind}
}

sema_name_referent: fn(symbol: Symbol) -> SemaNameReferent Never! {
    SemaNameReferent{id: symbol.id, kind: symbol.kind, name: symbol.name, module_identity: symbol.module_identity, owner: symbol.owner ?? "", span: symbol.span}
}

SemaLoopValueKind: enum {
    Effect,
    Collecting,
    Result,
}

// `moved_before` and `scope_depth` are the ownership state where the loop
// opened its mark (`entry`, sema_ownership_mark): a move the body makes of a
// binding declared at or above `scope_depth`, still standing where the body
// reaches its back edge, repeats on the next iteration
// (sema_ownership_check_loop_move_backedge).
SemaLoopValueFrame: struct {
    label: String?,
    kind: SemaLoopValueKind,
    ty: Type?,
    moved_before: [SemaOwnershipMovedPlace],
    scope_depth: Int,
}

SemaPendingLoopValue: struct {
    label: String?,
    kind: SemaLoopValueKind,
    ty: Type?,
}

SemaLoopBreakFlows: struct {
    paths: [SemaOwnershipState],
}

sema_loop_value_set_pending_type: fn(context: ^SemaCheckContext, kind: SemaLoopValueKind, label: String?, ty: Type?) Never! {
    context.pending_loop_value = Val(SemaPendingLoopValue{kind: kind, label: label, ty: ty})
}

sema_loop_value_push_frame: fn(context: ^SemaCheckContext, label: String?, entry: SemaOwnershipFork) Never! {
    ^pending: context.pending_loop_value
    context.pending_loop_value = None
    ^kind: SemaLoopValueKind.Effect
    ^resolved_label: label
    ^result_type: Type?{None}
    if pending == .Val(value) {
        kind = value.kind
        if value.label != None -> resolved_label = value.label
        result_type = value.ty
    }
    context.loop_value_frames.push(SemaLoopValueFrame{kind: kind, label: resolved_label, ty: result_type, moved_before: entry.moved.copy(), scope_depth: entry.scope_depth})
    context.loop_break_flows.push(SemaLoopBreakFlows{paths: [SemaOwnershipState]{}})
}

sema_loop_value_pop_frame: fn(context: ^SemaCheckContext) Never! {
    if context.loop_value_frames.len() == 0 {
        return
    }
    frame: context.loop_value_frames.pop() ?? return
    if context.loop_break_flows.len() > 0 -> ^_: context.loop_break_flows.pop()
    if frame.kind == SemaLoopValueKind.Result -> context.last_loop_result_type = frame.ty
}

sema_loop_value_resolve_frame: fn(context: SemaCheckContext, label: String?) -> Int? {
    ^index: context.loop_value_frames.len() - 1
    if label != None {
        loop index >= 0 {
            if context.loop_value_frames[index].label == label -> return Val(index)
            index -= 1
        }
        return None
    }
    if index >= 0 -> return Val(index)
    None
}

sema_loop_value_record_break: fn(check: ^SemaBodyCheck, frame_index: Int) Never! {
    if frame_index < 0 || frame_index >= check.context.loop_break_flows.len() {
        return
    }
    check.context.loop_break_flows[frame_index].paths.push(sema_ownership_state_snapshot(check.state))
}

sema_loop_value_set_result_type: fn(context: ^SemaCheckContext, frame_index: Int, ty: Type) Never! {
    if frame_index < 0 || frame_index >= context.loop_value_frames.len() {
        return
    }
    context.loop_value_frames[frame_index].ty = Val(ty)
}

sema_loop_value_break_flows: fn(context: SemaCheckContext, frame_index: Int) -> [SemaOwnershipState] Never! {
    if frame_index < 0 || frame_index >= context.loop_break_flows.len() {
        return [SemaOwnershipState]{}
    }
    context.loop_break_flows[frame_index].paths
}

sema_loop_value_push_collecting_type: fn(context: ^SemaCheckContext) Never! {
    context.collect_item_types.push(None)
}

sema_loop_value_pop_collecting_type: fn(context: ^SemaCheckContext) -> Type? {
    if context.collect_item_types.len() == 0 -> return None
    context.collect_item_types.pop() ?? None
}

sema_loop_value_collecting_type: fn(context: SemaCheckContext) -> Type? {
    if context.collect_item_types.len() == 0 -> return None
    context.collect_item_types[context.collect_item_types.len() - 1]
}

sema_loop_value_set_collecting_type: fn(context: ^SemaCheckContext, ty: Type) Never! {
    if context.collect_item_types.len() == 0 {
        return
    }
    context.collect_item_types[context.collect_item_types.len() - 1] = Val(ty)
}

SemaScopeLoopLabel: struct {
    name: String,
}

// `last_reads` holds, at each queried name's id in `read_names`, the index of
// the last statement that reads it (-1: none), filled on the first query so
// later live-after queries are O(1) instead of rewalking the remaining
// statements.
SemaStatementTailBody: struct {
    statements: [Stmt],
    read_names: NameTable,
    last_reads: [Int],
}

SemaStatementTailStore: struct {
    bodies: [SemaStatementTailBody],
}

SemaStatementTailFrame: struct {
    body_id: Int,
    start_index: Int,
}

sema_statement_tail_store_init: fn() -> SemaStatementTailStore Never! {
    SemaStatementTailStore{bodies: [SemaStatementTailBody]{}}
}

sema_statement_tail_store_add_body: fn(store: ^SemaStatementTailStore, statements: [Stmt]) -> Int Never! {
    ^body_id: store.bodies.len()
    // copy: the checker's statement lists are read parameters (the program
    // keeps them), and live-after queries outlive this frame's borrow of them.
    // Row 0 is the empty spelling, which no statement reads.
    store.bodies.push(SemaStatementTailBody{statements: statements.copy(), read_names: name_table_sized(SEMA_STATEMENT_TAIL_NAME_SLOTS), last_reads: [Int]{-1}})
    body_id
}

// A body's live-after queries name few locals: its name table starts small.
SEMA_STATEMENT_TAIL_NAME_SLOTS: 16

// A pure check staged at a call site: a checked text literal's
// `CheckedText.check`, or a static HTTP route method token's core.http
// check. A Result error refuses the site as `code` with `what` and `fix`;
// the error's reason is the Why.
SemaCheckedTextEvaluation: struct {
    module_identity: ModuleID,
    key: String,
    type_name: String,
    source_file: String,
    source_expression: Expr,
    // The checked literal's flat form (sema_publish_expression) and its type.
    expression: BodyExpr,
    ty: Type,
    reachable_function_keys: [String],
    dependencies: [String],
    span: Span,
    code: String,
    what: String,
    fix: String,
}

SemaComptimeRequest: struct {
    callee_key: String,
    module_identity: ModuleID,
    args: [TComptimeValue],
    span: Span,
    checked_text: SemaCheckedTextEvaluation?,
}

// A prepared local (`name: #run value`) visible at a body comptime
// site. The staged check declares it again, so the site's code reads its
// finished value as it does in the owner body.
SemaComptimePreparedLocal: struct {
    name: String,
    ty: Type,
    value: TComptimeValue,
    span: Span,
}

SemaComptimeBodySource: struct {
    module_identity: ModuleID,
    function_key: String,
    // The key the site is staged under (SemaComptimeBodyPlace owner) when it
    // is not `function_key`: a call rule's stand-in for it
    // (sema_call_rule_stage).
    site_owner: String?{None},
    source_file: String,
    key: String,
    destination_key: String,
    name: String,
    expression: Expr,
    expected_type: Type,
    span: Span,
    site_span: Span,
    prepared: [SemaComptimePreparedLocal],
    // The site is lexically inside an `#Impure` block.
    impure: Bool{false},
    // The run-time locals and parameters visible at the site: the staged
    // check names a read of one as a run-time value (E0640), not an unknown
    // name.
    runtime_locals: [String]{[String]{}},
    // An immutable local computed while compiling when it can be, quietly
    // left to run time otherwise (SemaComptimeItemSource.local_value).
    local_value: Bool{false},
    // An explicit `name: #run value` local: it reports what fails, and lands
    // like a local value (SemaComptimeItemSource.local_binding).
    local_binding: Bool{false},
    // A marker's `check` rule heard at a call (Calls/CheckRules.jet): the
    // driver runs every such site of one rule in one batch, from the
    // site's call row, never this source's own expression or prepared
    // locals (a rule site has none).
    rule: SemaComptimeRuleSite?{None},
    // The call's checks held their errors until the rule answers: a
    // rejection replaces them.
    rule_held: Bool{false},
}

// Which rule a heard call waits on, the `check` of `marker` declared in the
// module `module_identity` on the marker's `value`, and the call it hears.
SemaComptimeRuleSite: struct {
    module_identity: ModuleID,
    marker: String,
    value: TComptimeValue,
    call: SemaCallRuleHeard,
}

// One heard call as its batch row (Calls/CheckRules.jet
// SemaCallRuleColumns): `words` name the call's texts, argument types,
// known argument values, named functions and written parts by index into
// its own `texts`, `types`, `values`, `functions` and `written`, which its
// batch renumbers into the batch's. The call's caller, callee, module, file
// and name are its first five texts. `function_sources` says, for each
// FunctionInfo of `functions` at its position, where its batch finds the
// function's recorded calls.
SemaCallRuleHeard: struct {
    words: [Int],
    texts: [String],
    types: [TComptimeValue],
    values: [TComptimeValue],
    functions: [TComptimeValue],
    function_sources: [SemaRuleFunctionSource],
    written: [TComptimeValue],
}

// Where the recorded calls of a heard argument's function are: those the
// check of the body keyed `key` recorded. A lambda's are the ones written
// inside it (`within`, the lambda's span) in its enclosing function's body,
// and its returns are those that start at an offset of `returned`, the
// calls a return path of the lambda's own body returns.
SemaRuleFunctionSource: struct {
    key: String,
    within: Span?,
    returned: [Int],
}

// One call of a `#Recorded` callee in the checked body keyed
// `function_key` (Calls/Recorded.jet): the CompilerCall a rule hears at it,
// the offset its name starts at, and whether a return path of the body
// returns its value.
SemaRecordedCall: struct {
    function_key: String,
    call: TComptimeValue,
    at: Int,
    returned: Bool,
}

SemaComptimeBodyValue: struct {
    module_identity: ModuleID,
    key: String,
    destination_key: String,
    value: TComptimeValue,
    ty: Type,
    // Where a body-level site's value lands; None for one no body check
    // reads (a value computed ahead, a rule batch).
    place: SemaComptimeBodyPlace?{None},
}

// Where a body-level staged value sits in its module: the key its site is
// staged under (SemaComptimeBodySource.site_owner) and its source and site
// spans. A lookup matches the parts; none joins them into one text.
SemaComptimeBodyPlace: struct {
    owner: String,
    source: Span,
    site: Span,
}

// A place within one module's index (SemaComptimePlaceRows): its owner's
// id in the index's `owners` and its spans.
SemaComptimePlaceKey: struct {
    owner: Int,
    source: Span,
    site: Span,
}

// One module's index of staged places: each owner key's id in `owners`,
// and the row each place names.
SemaComptimePlaceRows: struct {
    owners: NameTable,
    rows: [SemaComptimePlaceKey:Int],
}

// One module's index of staged keys: each key's id in `keys` and, at that
// id, the row it names (-1: none). Row 0 is the empty spelling, never a key.
SemaComptimeKeyRows: struct {
    keys: NameTable,
    rows: [Int],
}

// Published ordered prefixes are immutable. The staging owner may append
// future rows under its guard; contexts retain only the owner and captured
// visible length, never a copied table or a rebuilt index.
SemaComptimeBodyFacts: struct {
    values: [SemaComptimeBodyValue],
    // Each module's slot at its ModuleID row (sema_comptime_index_module_slot).
    modules: [Int],
    // Each slot's first row of a place, and its second.
    first_rows: [SemaComptimePlaceRows],
    second_rows: [[SemaComptimePlaceKey:Int]],
    indexed_rows: Int,
}

SemaComptimeBodyValues: struct {
    facts: Shared<SemaComptimeBodyFacts>?{None},
    length: Int{0},
    // Only the staging producer advances this authenticated item frontier.
    // Context views retain it as metadata, never use it to publish.
    item_frontier: Int{0},
    // Numeric diagnosis is a separate phase-owned slot, never a fact mutation
    // or a retained CompilerTraceSink. None on every ordinary/cold trace path.
    work: Shared<SemaComptimeBodyWork>?{None},
}

SemaComptimeBodyWork: struct {
    publications: Int{0},
    publication_rows: Int{0},
    index_builds: Int{0},
    indexed_rows: Int{0},
    index_key_utf8_bytes: Int{0},
    functions_started: Int{0},
    check_passes_started: Int{0},
    context_value_carriers_attached: Int{0},
    context_value_snapshots: Int{0},
    queries: Int{0},
    module_probes: Int{0},
    first_row_probes: Int{0},
    second_row_probes: Int{0},
    owned_rows_returned: Int{0},
}

SemaComptimeBodyWorkOperation: enum {
    FunctionsStarted,
    CheckPassStarted,
    ContextAttached,
    ContextSnapshot,
    Query,
    ModuleProbe,
    FirstRowProbe,
    SecondRowProbe,
    OwnedRowReturned,
}

// Scope-local facts serve the program-table callers; the registration graph
// lives in the program tables, never here.
SemaScopeEnvironment: struct {
    module_identity: ModuleID,
    // The registration row of `module_identity` when module entry set it
    // (sema_scope_caller_row checks it still is), -1 otherwise.
    module_row: Int{-1},
    package_identity: String,
    module_name: String,
    // The dotted `name: module` path that declared the module's file ("" at
    // the package root; SemaRegistrationModule.declared_module).
    declared_module: String{""},
    source_file: String,
    source_origin: SemaSourceOrigin,
    source_segments: [SemaSourceSegment],
    checked_types: [TTypeDef]{[TTypeDef]{}},
    checked_type_names: NameTable{NameTable{bytes: [U8]{}, ends: [Int]{0}, texts: [String]{""}, hashes: [Int]{0}, slots: [Int]{0, 0}, mask: 1}},
    checked_type_name_rows: [[Int]]{[[Int]]{}},
    boxed_edges: [U32:[String]]{[U32:[String]]{}},
    copy_facts: SemaCopyFactsTable{SemaCopyFactsTable{rows: [[SemaCopyTypeFacts?]]{}, close: [[{known: Bool, value: Bool}]]{}}},
    declarations: [SemaScopeDeclaration],
    generic_params: [TGenericParam],
    // One publication survives comptime retargets. The selected view may be empty
    // for an item check; the next function restores the publication, not a
    // reconstructed/copy-indexed list. Both carriers name the same fact cell.
    comptime_body_publication: SemaComptimeBodyValues{SemaComptimeBodyValues{}},
    comptime_body_values: SemaComptimeBodyValues,
    // E0641: the module's dispatch-table `else` arms, from the parser.
    else_arms: [ElseArmSpan]{[ElseArmSpan]{}},
    // The module's proven length-preserving list write
    // parameters, copied into each function's ownership state.
    fixed_length_write_params: [SemaWindowParam]{[SemaWindowParam]{}},
    // The module's `debug(…)` call texts, from the parser.
    debug_sites: [DebugTraceSite]{[DebugTraceSite]{}},
    // The module's AST tables, from the parser: its nodes' handles index them.
    tables: ASTTables{ASTTables{}},
    // The enclosing named callable being checked; panic and propagation
    // locations name it.
    function_name: String{""},
    // The post-summary module scope of a parallel body pass, moved in for
    // the pass. Each body thread checks against its own light copy of it
    // (sema_scope_light_copy) and reads the function types that copy leaves
    // out from here (sema_scope_binding_type). None outside such a pass.
    module_scope: SemaScopeTable?{None},
}

// E3301 and `#Live` refuse what the program's own code (its package's
// modules) names on a machine with no OS. A body outside it, in Core or a
// package alike, is judged by what the program reaches from its entries
// (sema_target_no_os_reach_check): a reached OS module is E3301 at the
// program's call that leads to it, and a body the program never reaches is
// never refused. User bodies consume the selected machine fact, never a host
// OS guess. A function body is checked with the graph in the program tables.
sema_scope_environment_no_os: fn(check: SemaBodyCheck) -> Bool Never! {
    graph: check.program.registration_graph
    graph.target_machine.no_os && check.environment.package_identity == graph.package_identity
}

// The declaration scopes of the modules compile-time checks (item checks,
// function checks) check in:
// sema_registration_apply_graph_module runs once into a module's table instead
// of once per check, and each check runs inside a mark and rolls back
// (sema_comptime_scopes_prepare). The run environment's graph changes only
// by staged values (sema_comptime_graph_apply_values), which type waiting
// constants and nothing else, so a slot's `constants` names the only bindings
// a rebuilt table could differ in, and where their graph rows live.
// The run keeps the scopes of the last SEMA_COMPTIME_SCOPE_SLOTS modules it
// entered, so a closure walk that moves back and forth between modules builds
// each one's table once; `slots[current]` is the current module's.
SemaComptimeScopes: struct {
    slots: [SemaComptimeModuleScope],
    current: Int{0},
    // The host callbacks the checks reach (SemaHostHookAccess).
    host_hooks: SemaHostHookAccess?{None},
    // How many times a check entered a slot; a slot's `used` is the count
    // at its last entry, so a new module replaces the least recent.
    entries: Int{0},
}

// One module's comptime scope.
SemaComptimeModuleScope: struct {
    module_identity: ModuleID,
    table: SemaScopeTable,
    // sema_registration_apply_graph_module's result and its diagnostics.
    applied: Bool,
    diagnostics: [Diagnostic],
    constants: [SemaComptimeWaitingConstant],
    // The graph state `constants` were last compared with: the number of
    // staged values applied to the run's graph (-1: none yet).
    version: Int,
    used: Int{0},
}

// A module-scope binding whose symbol is a constant still waiting for its
// known-time type (sema_comptime_symbol_waits), and its graph row.
SemaComptimeWaitingConstant: struct {
    binding: Int,
    source: SemaComptimeWaitingSource,
}

// `Namespace`: a package name bound from its declaring member's symbol row
// (SemaRegistrationModule.namespace_bindings).
SemaComptimeWaitingSource: enum {
    Symbol(position: Int),
    Import(import_index: Int, binding: Int),
    Namespace(module_index: Int, position: Int),
}

// The caller's written `T E!` return (its span and success type `T`) and the
// end of its declaration, where E2404 offers a conversion `impl`.
SemaFailureRepair: struct {
    return_span: Span,
    success: Type,
    declaration_end: Int,
}

// A `defer` body's frame: the loop depth and loop label count outside it, so
// a `break` or `next` that steers one of those loops leaves the body.
SemaDeferFrame: struct {
    loop_depth: Int,
    labels: Int,
}

// An `#On(.Deep)` body's frame. A deep check reads the state around it but
// may not change it or leave it: `bindings` is the binding count when the
// body began, so a binding below it is captured state, and `loop_depth` and
// `labels` are the loop depth and loop label count outside the body. A lambda
// made in the body runs on its own exits, so `exits` is false there.
SemaDeepFrame: struct {
    loop_depth: Int,
    labels: Int,
    bindings: Int,
    exits: Bool,
}

SemaCheckContext: struct {
    exact_int_reachable: Bool,
    unsafe_depth: Int,
    // The scope depth of the frame a `return` here leaves: 0 for a named
    // function, the lambda's own frame inside a lambda body. A `return` must
    // have done the `#SingleUse` duties bound in that frame or deeper.
    duty_scope_depth: Int{0},
    borrow_ctx: Bool,
    allow_string_view_read: Bool,
    // The expression being checked is the base of a deeper place (`state` in
    // `state.x`, `^s`, `s.x = v`) whose complete place the caller checks, so a
    // bare name read here answers only for a move of the whole name.
    suppress_partial_move_root_read: Bool,
    allow_fixed_constructor: Bool,
    generic_params: [TGenericParam],
    lambda_escapes: Bool?,
    lambda_lending_views: Bool,
    lending_view_parameter_keys: [String],
    lambda_statement_tails: [SemaStatementTailFrame],
    call_facts: [SemaCallSiteFact],
    // In a marker's `check` rule (Func.marker_check), the name of its heard
    // call parameter, where `reject(finding, at: part)` ends the rule
    // (sema_call_check_marker_reject).
    marker_check_call: String?{None},
    // The identities this body's heard calls name (sema_rule_identity), by
    // declaration key, so its calls of one callee find that identity once.
    rule_identities: SemaRuleIdentities{SemaRuleIdentities{keys: [String]{}, identities: [String]{}}},
    // In a rule batch's check (sema_call_rule_batch_item), the literals of
    // the compiler records it builds each heard call from
    // (SEMA_CALL_RULE_RECORDS), which no program writes.
    compiler_records: Bool{false},
    // The tables the body's heard calls add rows to (sema_rule_table).
    rule_tables: SemaRuleTables{SemaRuleTables{}},
    call_return_views: [SemaCallReturnView],
    local_view_provenance: [SemaLocalViewProvenance],
    return_view_receiver_key: String,
    return_view_parameter_keys: [String],
    return_view_provenance: ViewProvenanceMap?,
    name_references: [SemaNameReferenceFact],
    comptime_requests: [SemaComptimeRequest],
    comptime_body_sources: [SemaComptimeBodySource],
    // The calls of `#Recorded` callees this body makes (Calls/Recorded.jet).
    recorded_calls: [SemaRecordedCall],
    comptime_body_values: SemaComptimeBodyValues,
    // Derived module/place indexes into the canonical ordered source rows.
    comptime_body_source_modules: [Int],
    comptime_body_source_rows: [SemaComptimePlaceRows],
    // The type parameter each `T.reflect()` read checked in this body
    // reflects, in order: a compile-time site that reads one is answered
    // per instance (sema_comptime_generic_site_params).
    generic_reflections: [Type]{[Type]{}},
    // A generic body's compile-time site is being checked: a fact read of a
    // type parameter's record types its code (sema_fact_type_param_read).
    generic_site: Bool{false},
    compute_calls: [SemaComputeCallFact],
    autodiff_obligations: [SemaAutodiffObligation],
    // Ownership/GenericCrossings.jet: what this body's type parameters cross,
    // and the generic calls whose arguments decide it.
    generic_crossings: [SemaGenericCrossing],
    generic_calls: [SemaGenericCall],
    // The clean crossing walks of this body's generic calls, one per crossing.
    crossing_walks: [SemaCrossingBodyWalk]{[SemaCrossingBodyWalk]{}},
    autodiff_safe_panic: Bool,
    autodiff_unsafe_panic: Bool,
    autodiff_safe_panic_context: Bool,
    copy_events: [SemaCopyEvent],
    loop_value_frames: [SemaLoopValueFrame],
    loop_break_flows: [SemaLoopBreakFlows],
    pending_loop_value: SemaPendingLoopValue?,
    collect_item_types: [Type?],
    // The value-if a collecting loop yields as its item, while it is checked:
    // its arms are the loop's item paths, so their mismatch is E0074.
    collect_item_if: Span?,
    last_loop_result_type: Type?,
    arrow_loop_body: Bool,
    reactive_upgrades: [String],
    reactive_upgrade_names: [String],
    reactive_local_ids: [SymbolID],
    reactive_shared_ids: [SymbolID],
    taskgroups: SemaTaskGroupState,
    // `failure_carrier_root` is the one-shot token a
    // carrier consumer (`??`, `?`, an `.Ok`/`.Err` pattern) sets so its call
    // subject keeps the Result carrier; `failure_success_view` tells the call
    // being checked that its expectation describes the success value.
    failure_carrier_root: Bool,
    failure_success_view: Bool,
    // Under `failures: .Explicit` (FailureMarks.jet): the node of the call a
    // written `?` marks, and the node of the call the expression being
    // checked reads a member of, which its mark must wrap in parentheses.
    failure_mark_written: Int{-1},
    failure_mark_receiver: Int{-1},
    // An open callback (no written or expected return) adopts the carrier of
    // its first propagated call.
    failure_inference: Bool,
    inferred_failure_carrier: TFailureCarrier?,
    // An expected callback with no return row (`fn(T)`, nothing after it):
    // its `return value` has no slot until a propagated fallible call gives it
    // that call's carrier as its row (`callback_return_row`).
    callback_return_open: Bool{false},
    callback_return_row: Type?{None},
    // An expected callback whose return row is a plain value (`fn(T, T) ->
    // Ordering`): it has no failure route, so a call of an unannotated
    // function in it is a failure obligation the bundle solve settles, as in
    // a named `T Never!` function, rather than the callback's carrier.
    callback_return_closed: Bool{false},
    // A collection slot that projects a fallible callback's failure onto its
    // own result (`filter`'s `[T] E!`): its plain return row (`Bool`) names
    // only the success, so the callback still infers its carrier from its
    // first propagated call. Set by Calls/Collections.jet for one argument;
    // the lambda it is set for reads and clears it on entry.
    callback_failure_open: Bool{false},
    // The `defer` body being checked: an exit or a propagated failure in it
    // would leave a block that is already ending.
    defer_frame: SemaDeferFrame?{None},
    // The enclosing callable's written failure contract, for E2404 provenance.
    failure_contract_source: String,
    // Where E2404's repair edits go: the caller's written `T E!` return and
    // the end of its declaration. None when no fallible return was written.
    failure_repair: SemaFailureRepair?,
    // The enclosing named callable, for the return verdicts.
    function_name: String,
    // How E0113 names that callable's return type when it is written as a
    // generic alias (sema_call_alias_shown), or None.
    return_alias: String?,
    // The module state this body writes (sema_scope_record_module_write),
    // which a pure function may not reach (E3401).
    module_writes: [TEffectSpan]{[TEffectSpan]{}},
    // The changeable module state this body reads (sema_scope_record_module_constant_read),
    // which a pure (`-[]>`) or `#Memo` function may not reach (E3401/E0938).
    module_reads: [TEffectSpan]{[TEffectSpan]{}},
    // E0408/E0409: a fallback with no failure report to name (`??` on an
    // optional, or a pure pattern miss) denies `err` with this code.
    fallback_err_denial: String?,
    // Source starts of else-less value dispatch chains already proved (E0307);
    // every level of one chain shares its span, and the outermost level wins.
    noelse_chain_starts: [Int],
    // Source starts of the function's fallback-free arm tables followed by a
    // default return (L0513): their miss falls through to that return, so
    // they need no `else` arm (E0003).
    fallback_tables: [Int],
    // The last statement of a named function with no written
    // return type; a non-Unit value there is thrown away (L0508).
    lost_tail_span: Span?,
    // #3886: the last statement of a named function with a
    // written value return; it is checked as the value the function hands back.
    value_tail_span: Span?,
    // The function keys whose failures this body propagates; "" marks a
    // failure source of its own (`Err`, a propagated non-call, a propagating
    // callback). Callback bodies add their rows too.
    failure_edges: [String],
    // #3708: a direct failure source outside callbacks (a fallible value
    // returned as-is, or a statement that owns its own failure route).
    failure_direct_source: Bool,
    // What reaches this body's default
    // `Err` route outside callbacks: typed failures (made here or passed up
    // from a callee with a written contract), function-owned cases
    // (`Err(.NotFound(n))`), the unannotated callees whose failures pass up,
    // and whether the general `Err` reaches it. The bundle failure-union
    // solve joins these rows (FailureUnion.jet).
    failure_union_members: [Type]{[Type]{}},
    failure_union_cases: [SemaFailureCase]{[SemaFailureCase]{}},
    failure_union_edges: [String]{[String]{}},
    failure_union_general: Bool{false},
    // #6281 c176: a top-level body whose default `Err` route the union solve
    // infers (sema_failure_inference_candidate, not the entry `run`). A typed
    // failure it records projects it onto a typed contract and checks it
    // again, so this pass's reports are replaced (sema_failure_recheck_modules).
    failure_union_inferable: Bool{false},
    // A failure in this lambda body leaves through the enclosing callable's
    // carrier. Every lambda body starts it false (a checking snapshot does not
    // copy it) and harvests it.
    task_body_propagates: Bool{false},
    // E0507: the collections an active `loop x in xs` reads across its body, so
    // a change to one of them there is rejected.
    iter_borrowed: [String]{[String]{}},
    // E0136: a binding's initializer is being checked, so a
    // propagating runtime range conversion inside it is reported there.
    binding_initializer: Bool{false},
    // E1403: source forms being checked right now, one per
    // statement and per expression level, against the limit the parser
    // also enforces.
    source_nesting: Int{0},
    // Active bindingless collecting-loop subjects, where a
    // bare `.member` chain reads the implicit `it`.
    implicit_loop_subject_depth: Int{0},
    // Active subject-shorthand lambda scopes (L0512).
    subject_shorthand_depth: Int{0},
    // Why this body stopped without a diagnostic: a construct the checker
    // does not handle yet or a lost compiler invariant. These reach the
    // driver's internal-problem report (I2), never the user's diagnostics.
    incomplete_reasons: [String]{[String]{}},
    origin_facts: [TOriginProjection]{[TOriginProjection]{}},
    // The body's `todo` goals, with the card naming each one's expected type.
    typed_goals: [TTypedGoal]{[TTypedGoal]{}},
    // The fixed-list indexes the body proved in range (TIndexProof).
    index_proofs: [TIndexProof]{[TIndexProof]{}},
    // The source node ids this check gave its nodes (sema_check_record_expr_id),
    // in filing order and as a set, and the next function-local id for a node
    // whose source id is generated or already filed (a desugared copy). A
    // snapshot starts with no ids and continues the id count; its merge hands
    // both back.
    filed_expr_ids: [Int]{[Int]{}},
    filed_expr_id_set: [Int:Bool]{[Int:Bool]{}},
    next_expr_id: Int{TEXPR_FIRST_LOCAL_ID},
    // True while this check reads a copy of another declaration's source (a
    // callee's `#Pre` clause at one of its call sites): that source's ids are
    // filed by every copy, so each copy's nodes take fresh function-local ids.
    fresh_expr_ids: Bool{false},
    // The host callbacks this check may call (SemaHostHookAccess); every
    // context derived from it reaches the same ones.
    host_hooks: SemaHostHookAccess?{None},
    // The debugger's position probes inside the function being checked
    // (EvalProbe.jet). A context copied for a nested check walks on a fork
    // of it, whose answers come back with the copy's facts
    // (sema_eval_walk_take_back). A probe's mark and rollback leave it as
    // it is.
    eval_walk: SemaEvalWalk{SemaEvalWalk{}},
    // The active lexical fixed-width arithmetic mode of the function being
    // checked, from its `#Overflow(mode)` marker. Closures checked inside the
    // body keep it.
    arithmetic_policy: ArithmeticPolicyFact?{None},
    // The active run-time policy (`#Runtime(.NoEager)` or `#Runtime(.Only)`)
    // of the function and block being checked: `PolicyValue.NoEager` or
    // `PolicyValue.Only`. Closures checked inside the body keep it.
    runtime_policy: PolicyValue?{None},
    // The overflow word (`wrapping`, `saturating` or `checked`) written
    // directly around the typed-literal conversion being checked. The
    // conversion takes it on entry, so it never reaches a nested expression.
    overflow_word: String?{None},
    // The body being checked is compiler-generated scaffolding (a derived
    // codec or protocol method, a field policy wrapper) that spells every
    // carrier out: a call root keeps its Result and an unmarked writing
    // receiver is not reported. A `#Test` body is user code and is not.
    compiler_generated: Bool{false},
    // The types whose semantic copy is being rebuilt from its parts' copies
    // (sema_expr_copy_fork), outermost first: a type that reaches itself
    // without a generated fork function is refused, the rebuild reads and
    // writes the private fields the copied value already owns, and a part's
    // copy inside it records no second `Clock copy` effect.
    fork_copy_rebuilding: [String]{[String]{}},
    // The function being checked declares its result's owners (`-> T from
    // self | param`): a returned place read is a view of them, not a copy.
    return_view_declared: Bool{false},
    // The function being checked writes a user generic type bare in its
    // signature, which reported E0104 there: its body's reads through that
    // type are the same error (sema_type_bare_generic_names).
    bare_generic_signature: Bool{false},
    // The rows of the nodes this check built flat (sema_node): a node's
    // children are row indices of this arena (the flattener's into-arena
    // mode). A mark never truncates it, so a kept speculative result never
    // names a row past its end; the rows no published node reaches are
    // dropped when the function is flattened.
    arena: BodyFlat{BodyFlat{tree: BodyTree{nodes: [BodyNode]{}, stmts: [StmtKind]{}, expr_types: [TExprType]{}}, arena: BodyTree{nodes: [BodyNode]{}, stmts: [StmtKind]{}, expr_types: [TExprType]{}}, into_arena: true}},
    // The field facts of the non-generic structs this check built literals
    // of (sema_expression_struct_field_facts): owner symbol id -> index of
    // its first field's fact.
    struct_field_fact_rows: [U32:Int]{[U32:Int]{}},
    struct_field_facts: [SemaStructFieldFact]{[SemaStructFieldFact]{}},
    // Spans of the named-literal field values whose declared field type holds
    // a view (`View<T>`, `View<str>` or a struct that stores one): only these
    // keep a view into their source inside the literal; any other field owns
    // its value (sema_stmt_local_view_facts_fields).
    view_field_values: [Span]{[Span]{}},
    // The changeable number names whose type a use decided on an earlier check pass
    // of this function, and the refusals this pass found. A probe's rollback
    // keeps the refusals it found: each is a use the source writes, and the
    // earliest one decides (Expressions/NumberNames.jet).
    number_retypes_known: [SemaNumberRetype]{[SemaNumberRetype]{}},
    number_retypes_found: [SemaNumberRetype]{[SemaNumberRetype]{}},
    // Worker-local zero-copy type interner delta forked from the program's
    // shared Interner on first non-well-known type intern.
    type_delta: [InternerDelta]{[InternerDelta]{}},
    // True on a nested snapshot context (sema_check_context_snapshot): its
    // delta-local ids are not merged back, so only shared/well-known TypeIDs
    // escape onto TExprs.
    is_snapshot: Bool{false},
}

// The parts one body check owns: its entry makes them and they end with it.
// Checker functions borrow the record whole, or lend single parts
// (`check.state`) to a helper that takes only those. An entry lent its
// caller's findings list or scope table swaps it into `diagnostics` or
// `scopes` for the check and back after (sema_body_check_swap_diagnostics,
// sema_body_check_swap_scopes). `program` and `environment` link the
// entry's read parameters: a checker reads `check.program.x`, and hands the
// target on as `check.program.*`. A check in another environment (a default
// in its owner module's) runs on a record of its own, made where that
// environment lives (sema_body_check_swap_tail_store).
SemaBodyCheck: struct {
    program: @SemaProgramTables,
    environment: @SemaScopeEnvironment,
    state: SemaOwnershipState,
    tail_store: SemaStatementTailStore,
    context: SemaCheckContext,
    diagnostics: [Diagnostic],
    scopes: SemaScopeTable,
}

// A changeable number name (`binding`, its name's span) takes `ty`, the type its use
// at `use_span` needs where its default type is refused.
SemaNumberRetype: struct {
    binding: Span,
    ty: Type,
    use_span: Span,
}

SemaScopeModulePolicy: struct {
    unit_explicit_units: Bool,
    copies_explicit: Bool,
    writes_explicit: Bool,
    failures_explicit: Bool,
    // Split the exact span key into scalar indexes, without formatting it.
    function_unit_starts: [Int:Int],
    function_unit_ends: [[Int:Bool]],
}

SemaScopeTable: struct {
    // The module whose scope the table is (none for a detached table); its
    // root frame has no owner.
    module_identity: ModuleID,
    frames: [SemaScopeFrame],
    bindings: [SemaScopeBinding],
    // Binding positions per name, ascending: `name_slots` interns each name
    // to its row id in `name_positions`. Every push goes through
    // sema_scope_push_binding, so name resolution never rescans `bindings`.
    name_slots: NameTable,
    name_positions: [[Int]],
    base_table: [SemaScopeTable]{[SemaScopeTable]{}},
    base_binding_count: Int{0},
    loop_labels: [SemaScopeLoopLabel],
    current: Int,
    return_type: Type?,
    failure_carrier: TFailureCarrier?,
    knowledge_gate: SemaKnowledgeGate?,
    loop_depth: Int,
    ownership_call_depth: Int,
    comptime_execution_depth: Int,
    transaction_depth: Int,
    transaction_wall_depth: Int,
    unit_explicit_units: Bool,
    // `copies: .Explicit` is active for the function being
    // checked (package, module, or function scope).
    copies_explicit: Bool{false},
    // `writes: .Explicit` is active: every call writes the `^`/`^^` mark its
    // signature implies (Ownership/CallMarks.jet).
    writes_explicit: Bool{false},
    // `failures: .Explicit` is active: every call that can fail is written
    // with `?` (FailureMarks.jet).
    failures_explicit: Bool{false},
    // The innermost `#Context` block: 0 outside one, 1 inside one without an
    // `allocator:` field, 2 when an enclosing block names an allocator.
    context_allocation: Int{0},
    // The written header of the hole table being checked: the parser
    // checks it once per arm, so a call there that has an effect runs once
    // per arm (E0442).
    hole_header: Span?{None},
    // Derived from the immutable graph installed by seed_unit_policy.
    // Function rollback leaves this memo intact; snapshots may rebuild it.
    // A new graph/module setup reseeds it, including each staging version.
    policy_modules: [U32:Int]{[U32:Int]{}},
    policy_rows: [SemaScopeModulePolicy]{[SemaScopeModulePolicy]{}},
    // Rollback support (sema_scope_mark / sema_scope_rollback): while a mark
    // is open, an in-place edit of an existing binding first records the old
    // row here, so a rollback restores the table without a whole-table copy.
    binding_undo: [SemaScopeBindingUndo]{[SemaScopeBindingUndo]{}},
    open_marks: Int{0},
    // The function a compiler thread is checking (sema_function_check_shared),
    // which names its panic locations; None names the environment's
    // `function_name`.
    location_function: String?{None},
    // `light_types[index]`: row `index` is a body thread's copy whose
    // function type stayed in the environment's `module_scope`
    // (sema_scope_light_copy). Empty for every other table.
    light_types: [Bool]{[Bool]{}},
    // A contract condition is written above the parameters it reads and is
    // checked again at each call site, whose spans name another place, so
    // its names resolve without the declared-before-use position rule.
    position_free: Bool{false},
    // The registration graph's counters (SemaLookupCounters) while it
    // counts: each resolution adds one lookup and the binding rows it
    // examined. None for an uncounted table.
    lookup_counters: SemaScopeLookupCounters?{None},
    // The inferred return-view provenance of this module's view-returning
    // methods (sema_check_view_summaries), by registered method symbol id.
    // A method call candidate carries the registered signature, which holds
    // only a declared `from` contract.
    method_return_views: [U32:ViewProvenanceMap]{[U32:ViewProvenanceMap]{}},
    // A body comptime site's staged check: the run-time locals and
    // parameters of the function around the site, which its compile-time
    // code can't read (SemaComptimeBodySource.runtime_locals).
    comptime_runtime_locals: [String]{[String]{}},
    // The innermost `#On(.Deep)` body being checked (SemaDeepFrame).
    deep_check: SemaDeepFrame?{None},
    // Worker-local zero-copy InternerDelta moved into SemaCheckContext for
    // each function body pass and returned afterward (never copied by marks or
    // snapshots).
    type_delta: [InternerDelta]{[InternerDelta]{}},
}

// A scope table's handle on the graph's counters. It shows as its name:
// the counts are not part of the table's facts.
SemaScopeLookupCounters: struct {
    counters: Shared<SemaLookupCounters>,

    impl Debug {
        debug: fn(self) -> String { "SemaScopeLookupCounters" }
    }
}

SemaScopeBindingUndo: struct {
    index: Int,
    binding: SemaScopeBinding,
}

// A rollback point: the table's row counts plus its small scalar/flag fields.
// Avoids constructing a throwaway SemaScopeTable (and NameTable) on every mark.
SemaScopeMark: struct {
    frames: Int,
    bindings: Int,
    undo: Int,
    loop_labels: [SemaScopeLoopLabel],
    current: Int,
    knowledge_gate: SemaKnowledgeGate?,
    return_type: Type?,
    failure_carrier: TFailureCarrier?,
    loop_depth: Int,
    ownership_call_depth: Int,
    comptime_execution_depth: Int,
    transaction_depth: Int,
    transaction_wall_depth: Int,
    unit_explicit_units: Bool,
    copies_explicit: Bool,
    writes_explicit: Bool,
    failures_explicit: Bool,
    context_allocation: Int,
    open_marks: Int,
    deep_check: SemaDeepFrame?,
}

// The program half of a check's environment (FRONTEND-300X §3.1 J): the
// registration graph and the checked-type tables every check reads. One
// pass driver owns it and every checker borrows it; only comptime value
// landing writes it. The tables own the graph they are given: callers hand
// over one graph rather than a read value the constructor would copy again.
SemaProgramTables: struct {
    registration_graph: SemaRegistrationGraph,
    checked_types: [TTypeDef],
    // Every `checked_types` row of a bare name in order, by the name's id in
    // `checked_type_names`. The first row of a module among them is that
    // module's declaration.
    checked_type_names: NameTable,
    checked_type_name_rows: [[Int]],
    // `sema_checked_program_boxed_edges(registration_graph)`: nominal SymbolId
    // -> its boxed recursive-layout keys, computed once per tables. Staged
    // comptime values type only waiting constants, never a nominal's fields,
    // so landing values leaves these edges unchanged.
    boxed_edges: [U32:[String]],
    // `sema_copy_facts_table(registration_graph)`: each non-generic nominal's
    // copy facts, walked once per tables. Landing comptime values never
    // changes a nominal's members, so these stay true.
    copy_facts: SemaCopyFactsTable,
    // True if any struct declaration may have a computed field (always for a
    // snapshot check, whose graph registers none); lets field reads skip
    // computed-field symbol lookups in O(1) when false.
    has_computed_fields: Bool{true},
}

sema_program_fork_delta: fn(program: SemaProgramTables) -> InternerDelta Never! {
    interner_fork_delta(program.registration_graph.interner)
}

// Looks up `ty` in the program's immutable shared `Interner` with zero heap
// allocation, lazily forking a worker-local `InternerDelta` only on the first
// miss. On a nested snapshot context, only shared/well-known IDs escape.
sema_intern_type: fn(program: SemaProgramTables, context: ^SemaCheckContext, ty: Type) -> TypeID Never! {
    wk: type_id_well_known(ty)
    if wk.id != 0 -> return wk
    graph: program.registration_graph
    shared: type_find_syntax(graph.interner, ty)
    if shared.id != 0 -> return shared
    if context.is_snapshot -> return type_none()
    if context.type_delta.len() == 0 -> context.type_delta.push(sema_program_fork_delta(program))
    delta_type_intern_syntax(graph.interner, context.type_delta[0], ty)
}

// Always interns `ty` into a non-zero TypeID in `(program, context.type_delta)`,
// even on a snapshot context (used when flattening checked bodies/expressions).
sema_intern_type_force: fn(program: SemaProgramTables, context: ^SemaCheckContext, ty: Type) -> TypeID Never! {
    wk: type_id_well_known(ty)
    if wk.id != 0 -> return wk
    graph: program.registration_graph
    shared: type_find_syntax(graph.interner, ty)
    if shared.id != 0 -> return shared
    if context.type_delta.len() == 0 -> context.type_delta.push(sema_program_fork_delta(program))
    delta_type_intern_syntax(graph.interner, context.type_delta[0], ty)
}

// Written form of `id` in `(program, context.type_delta)`.
sema_type_syntax_in: fn(program: SemaProgramTables, context: SemaCheckContext, id: TypeID) -> Type Never! {
    graph: program.registration_graph
    if context.type_delta.len() > 0 {
        return delta_type_syntax(graph.interner, context.type_delta[0], id)
    }
    type_syntax(graph.interner, id)
}

// Kind byte of `id` in `(program, context.type_delta)` without allocating a Type.
sema_type_kind_in: fn(program: SemaProgramTables, context: SemaCheckContext, id: TypeID) -> TypeKind Never! {
    graph: program.registration_graph
    if context.type_delta.len() > 0 {
        return delta_type_kind(graph.interner, context.type_delta[0], id)
    }
    type_kind(graph.interner, id)
}

// O(1) identity equality on interned TypeIDs (using canonical columns).
sema_type_id_equal: fn(program: SemaProgramTables, context: SemaCheckContext, left: TypeID, right: TypeID) -> Bool Never! {
    if left.id == right.id -> return true
    graph: program.registration_graph
    if context.type_delta.len() > 0 {
        return delta_type_id_identity_equal(graph.interner, context.type_delta[0], left, right)
    }
    type_id_identity_equal(graph.interner, left, right)
}

// The run-wide id of `key`, if a registration holds it.
sema_symbol_find: fn(program: SemaProgramTables, key: String) -> SymbolID? Never! {
    symbol_find(program.registration_graph.symbols, key)
}

// The id of the declaration with this kind, module, owner and name: the
// run-wide one when a registration holds its key, else one of the checking
// body's own keys (`context.arena.tree.symbols`).
sema_symbol_id: fn(program: SemaProgramTables, context: ^SemaCheckContext, kind: SymbolKind, module_name: String, owner: String, name: String) -> SymbolID Never! {
    sema_symbol_id_of(program, context, symbol_key_text(kind, module_name, owner, name))
}

// The id of the declaration keyed `key` (symbol_key_text), as sema_symbol_id.
sema_symbol_id_of: fn(program: SemaProgramTables, context: ^SemaCheckContext, key: String) -> SymbolID Never! {
    if sema_symbol_find(program, key) == .Val(found) -> return found
    symbol_local_keys_intern(context.arena.tree.symbols, key)
}

// The id keyed `key`, a run-wide one or one of the checking body's own; None
// for a key no declaration holds.
sema_symbol_lookup: fn(check: SemaBodyCheck, key: String) -> SymbolID? Never! {
    if sema_symbol_find(check.program.*, key) == .Val(found) -> return Val(found)
    symbol_local_keys_find(check.context.arena.tree.symbols, key)
}

// The key text of `id`, a run-wide id or one of the checking body's own. A
// body's own key is built from its bytes, for a reader that names it by text
// (an ownership binding key).
sema_symbol_key: fn(program: SemaProgramTables, context: SemaCheckContext, id: SymbolID) -> String Never! {
    if symbol_is_local(id) -> return symbol_local_keys_text(context.arena.tree.symbols, id)
    sema_program_symbol_key(program, id)
}

// The key text of the run-wide `id`.
sema_program_symbol_key: fn(program: SemaProgramTables, id: SymbolID) -> String Never! {
    if symbol_is_local(id) -> panic("a body's own symbol has no run-wide key")
    symbol_table_key(program.registration_graph.symbols, id)
}

// The DeclID a direct call to the registered callable `symbol` names (Cutover
// B L2b). Every direct call target is a registered callable, so a target with
// no row (a body's own symbol has none) is a compiler bug, reported rather
// than lowered to a guessed callee.
sema_call_callee_decl: fn(program: SemaProgramTables, symbol: SymbolID, span: Span, diagnostics: ^[Diagnostic]) -> DeclID? Never! {
    graph: program.registration_graph
    if !symbol_is_local(symbol) && sema_registration_callable_id(graph, symbol) == .Val(id) {
        return Val(id)
    }
    key: if symbol_is_local(symbol) -> "" else -> sema_program_symbol_key(program, symbol)
    diagnostics.push(sema_error("E0003", span, "the call target `{key}` is not a registered callable", "every direct call names the DeclID its callable registered", "report this compiler bug with the source that triggers it"))
    None
}

// The key text of the registered declaration `id` (diagnostics, call facts,
// effect node keys). A DeclID is only minted from a graph's table.
sema_program_decl_key: fn(program: SemaProgramTables, id: DeclID) -> String Never! {
    graph: program.registration_graph
    decl_table_key(graph.decls, graph.symbols, id)
}

sema_program_tables_init: fn(graph: ^^SemaRegistrationGraph, checked_types: [TTypeDef]) -> SemaProgramTables Never! {
    ^boxed_edges: sema_checked_program_boxed_edges(graph)
    ^copy_facts: sema_copy_facts_table(graph)
    sema_program_tables_with(graph, checked_types, boxed_edges, copy_facts)
}

// The tables of a snapshot check: its empty graph
// (sema_registration_graph_snapshot) and no checked types. With no
// registered struct to rule one out, any struct may have a computed field.
sema_program_tables_snapshot: fn() -> SemaProgramTables Never! {
    ^tables: sema_program_tables_init(sema_registration_graph_snapshot(), [TTypeDef]{})
    tables.has_computed_fields = true
    tables
}

// The tables over `graph` whose boxed edges and copy facts were already
// computed from it (sema_checked_program_boxed_edges, sema_copy_facts_table).
sema_program_tables_with: fn(graph: ^^SemaRegistrationGraph, checked_types: [TTypeDef], boxed_edges: ^^[U32:[String]], copy_facts: ^^SemaCopyFactsTable) -> SemaProgramTables Never! {
    ^names: name_table_sized(checked_types.len() * 2 + 2)
    ^name_rows: [[Int]]{[Int]{}}
    ^has_computed: false
    loop (index, definition) in checked_types {
        id: name_index(name_intern(names, definition.name))
        if id == name_rows.len() -> name_rows.push([Int]{})
        name_rows[id].push(index)
        if !has_computed && definition.kind == .Struct(fields, _) {
            loop field in fields {
                if field.computed {
                    has_computed = true
                    break
                }
            }
        }
    }
    SemaProgramTables{
        registration_graph: graph,
        checked_types: checked_types,
        checked_type_names: names,
        checked_type_name_rows: name_rows,
        boxed_edges: boxed_edges,
        copy_facts: copy_facts,
        has_computed_fields: has_computed,
    }
}

sema_scope_environment_init: fn(module_identity: ModuleID, package_identity: String, module_name: String, source_file: String, source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment], declarations: [SemaScopeDeclaration]) -> SemaScopeEnvironment Never! {
    SemaScopeEnvironment{
        module_identity: module_identity,
        package_identity: package_identity,
        module_name: module_name,
        source_file: source_file,
        source_origin: source_origin,
        source_segments: source_segments,
        checked_types: [TTypeDef]{},
        checked_type_names: name_table_sized(2),
        checked_type_name_rows: [[Int]]{},
        boxed_edges: [U32:[String]]{},
        declarations: declarations,
        generic_params: [TGenericParam]{},
        comptime_body_values: SemaComptimeBodyValues{},
    }
}

// The identity text of the environment's module: its graph's spelling, or the
// module name a snapshot check names its module by.
sema_scope_environment_module_text: fn(environment: SemaScopeEnvironment, program: SemaProgramTables) -> String Never! {
    graph: program.registration_graph
    // Snapshot: the empty graph holds no module; a lone program is named by
    // the name its check was given.
    if graph.mode == .Snapshot -> return environment.module_name
    module_text(graph.module_table, environment.module_identity)
}

// The identity text of module `module_identity` as the environment's checks
// spell it (sema_scope_environment_module_text); "" for another module of a
// snapshot check, which has none.
sema_scope_module_text: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID) -> String Never! {
    graph: program.registration_graph
    // Snapshot: the empty graph holds no module; only the lone program's own
    // has a name, the one its check was given.
    if graph.mode == .Snapshot {
        if module_identity == environment.module_identity -> return environment.module_name
        return ""
    }
    module_text(graph.module_table, module_identity)
}

// The first checked declaration of `name` owned by `module_identity`.
sema_scope_checked_type_row: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, name: String) -> Int? {
    sema_scope_checked_type_row_in(program, module_identity, name)
}

// The checked declaration a qualified `module.Name` spelling names.
sema_scope_checked_type_row_qualified: fn(program: SemaProgramTables, qualified: String) -> Int? {
    parts: qualified.split(".").to_list()
    if parts.len() < 2 -> return None
    graph: program.registration_graph
    owner: module_find(graph.module_table, parts.slice(0, parts.len() - 1).join(".")) ?? return None
    sema_scope_checked_type_row_in(program, owner, parts[parts.len() - 1])
}

// The first row named `name` among `checked_types` that `module_identity` owns.
sema_scope_checked_type_row_in: fn(program: SemaProgramTables, module_identity: ModuleID, name: String) -> Int? Never! {
    id: sema_scope_checked_type_name_id(program, name)
    if id < 0 -> return None
    loop row in program.checked_type_name_rows[id] {
        if program.checked_types[row].module_identity.id == module_identity.id -> return Val(row)
    }
    None
}

// The id of `name` in `checked_type_names`, -1 when no checked declaration has it.
sema_scope_checked_type_name_id: fn(program: SemaProgramTables, name: String) -> Int Never! {
    found: name_find(program.checked_type_names, name) ?? return -1
    id: name_index(found)
    if id >= program.checked_type_name_rows.len() -> return -1
    id
}

// Every checked declaration row named `name`, in declaration order.
sema_scope_checked_type_name_rows: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, name: String) -> [Int] {
    id: sema_scope_checked_type_name_id(program, name)
    if id < 0 -> return [Int]{}
    program.checked_type_name_rows[id]
}

// Retarget scope facts while the program tables retain their one graph owner.
// No field is taken from a borrowed environment or program parameter.
sema_scope_environment_enter_module: fn(environment: ^SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, comptime_body_values: ^^SemaComptimeBodyValues) Never! {
    graph: program.registration_graph
    environment.module_identity = graph.modules[module_index].module_identity
    environment.module_row = module_index
    environment.package_identity = graph.modules[module_index].package_identity
    environment.module_name = graph.modules[module_index].module_name
    environment.declared_module = graph.modules[module_index].declared_module
    environment.source_file = graph.modules[module_index].source_file
    environment.source_origin = graph.modules[module_index].source_origin
    environment.source_segments = graph.modules[module_index].source_segments
    environment.declarations = [SemaScopeDeclaration]{}
    environment.generic_params = [TGenericParam]{}
    environment.comptime_body_values = comptime_body_values.move()
    environment.else_arms = graph.modules[module_index].program.else_arms
    environment.debug_sites = graph.modules[module_index].program.debug_sites
    environment.tables = graph.modules[module_index].program.tables
    environment.function_name = ""
}

// A comptime check borrows the program graph and replaces only scope facts.
// Its else-arm reset differs from real declaration/body entry; it keeps the
// module's debug sites, so a compile-time `debug(…)` writes its expression
// text and carries its E3405 unwrap edit as a run-time one does.
// False when the graph has no such module.
sema_scope_environment_enter_comptime_module: fn(environment: ^SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, comptime_body_values: ^^SemaComptimeBodyValues) -> Bool Never! {
    graph: program.registration_graph
    module_index: sema_registration_module_index(graph, module_identity) ?? return false
    environment.module_identity = graph.modules[module_index].module_identity
    environment.module_row = module_index
    environment.package_identity = graph.modules[module_index].package_identity
    environment.module_name = graph.modules[module_index].module_name
    environment.declared_module = graph.modules[module_index].declared_module
    environment.source_file = graph.modules[module_index].source_file
    environment.source_origin = graph.modules[module_index].source_origin
    environment.source_segments = graph.modules[module_index].source_segments
    environment.declarations = [SemaScopeDeclaration]{}
    environment.generic_params = [TGenericParam]{}
    environment.comptime_body_values = comptime_body_values.move()
    environment.else_arms = [ElseArmSpan]{}
    environment.debug_sites = graph.modules[module_index].program.debug_sites
    environment.tables = graph.modules[module_index].program.tables
    environment.function_name = ""
    true
}

// The registration row of the environment's module: the row module entry
// recorded when `graph` still registers `module_identity` there (one shared
// buffer compare), else the identity lookup. Callers pass it as the `caller`
// row of named-type resolution instead of looking the identity up each time.
sema_scope_caller_row: fn(environment: SemaScopeEnvironment, graph: SemaRegistrationGraph) -> Int Never! {
    sema_scope_caller_index(environment, graph) ?? -1
}

// sema_scope_caller_row as an option: None when no row registers the module.
sema_scope_caller_index: fn(environment: SemaScopeEnvironment, graph: SemaRegistrationGraph) -> Int? Never! {
    row: environment.module_row
    if row >= 0 && row < graph.modules.len() && graph.modules[row].module_identity == environment.module_identity {
        return Val(row)
    }
    sema_registration_module_index(graph, environment.module_identity)
}

// The AST tables of the module that declares a node: the environment's own
// for its module, else that module's from the graph. None when no graph
// registers the module.
sema_scope_module_tables: fn(check: SemaBodyCheck, module_identity: ModuleID) -> ASTTables? Never! {
    if module_identity == check.environment.module_identity -> return Val(check.environment.tables)
    graph: check.program.registration_graph
    module_index: sema_registration_module_index(graph, module_identity) ?? return None
    Val(graph.modules[module_index].program.tables)
}

sema_scope_environment_boxed_edge: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, owner: SymbolID, edge: String) -> Bool Never! {
    graph: program.registration_graph
    row: sema_type_graph_nominal_row(graph, owner) ?? return false
    module_identity: graph.modules[row.module_index].module_identity
    if sema_scope_checked_type_row(environment, program, module_identity, graph.modules[row.module_index].nominals[row.row].symbol.name) == .Val(checked_row) {
        return sema_checked_type_has_boxed_edge(program.checked_types[checked_row], edge)
    }
    // Matched in place: a pattern on the indexed path copies the whole item.
    nominal: graph.modules[row.module_index].nominals[row.row]
    if nominal.source == .SourceAST(definition) {
        // The declaration's own name resolves to this nominal in its own
        // module, so its edges are the ones keyed by the owner (what
        // sema_checked_boxed_edges looks up after resolving that name).
        if sema_registration_root_name(definition) == nominal.symbol.name {
            edges: program.boxed_edges.get(owner.id) ?? return false
            return edges.contains(edge)
        }
        return sema_checked_boxed_edges(graph, program.boxed_edges, module_identity, definition).contains(edge)
    }
    false
}

sema_loop_break_flows_snapshot: fn(source: [SemaLoopBreakFlows]) -> [SemaLoopBreakFlows] Never! {
    result: loop frame in source -> {
        paths: loop path in frame.paths -> sema_ownership_state_snapshot(path)
        SemaLoopBreakFlows{paths: paths}
    }
    result
}

sema_check_context_init: fn() -> SemaCheckContext Never! {
    SemaCheckContext{
        exact_int_reachable: false,
        unsafe_depth: 0,
        borrow_ctx: false,
        allow_string_view_read: false,
        suppress_partial_move_root_read: false,
        allow_fixed_constructor: false,
        generic_params: [TGenericParam]{},
        lambda_escapes: Val(true),
        lambda_lending_views: false,
        lending_view_parameter_keys: [String]{},
        lambda_statement_tails: [SemaStatementTailFrame]{},
        call_facts: [SemaCallSiteFact]{},
        call_return_views: [SemaCallReturnView]{},
        local_view_provenance: [SemaLocalViewProvenance]{},
        return_view_receiver_key: "",
        return_view_parameter_keys: [String]{},
        return_view_provenance: None,
        name_references: [SemaNameReferenceFact]{},
        comptime_requests: [SemaComptimeRequest]{},
        comptime_body_sources: [SemaComptimeBodySource]{},
        recorded_calls: [SemaRecordedCall]{},
        comptime_body_values: SemaComptimeBodyValues{},
        comptime_body_source_modules: [Int]{},
        comptime_body_source_rows: [SemaComptimePlaceRows]{},
        compute_calls: [SemaComputeCallFact]{},
        autodiff_obligations: [SemaAutodiffObligation]{},
        generic_crossings: [SemaGenericCrossing]{},
        generic_calls: [SemaGenericCall]{},
        autodiff_safe_panic: false,
        autodiff_unsafe_panic: false,
        autodiff_safe_panic_context: false,
        copy_events: [SemaCopyEvent]{},
        loop_value_frames: [SemaLoopValueFrame]{},
        loop_break_flows: [SemaLoopBreakFlows]{},
        pending_loop_value: None,
        collect_item_types: [Type?]{},
        collect_item_if: None,
        last_loop_result_type: None,
        reactive_upgrades: [String]{},
        reactive_upgrade_names: [String]{},
        reactive_local_ids: [SymbolID]{},
        reactive_shared_ids: [SymbolID]{},
        taskgroups: sema_taskgroup_state_init(),
        failure_carrier_root: false,
        failure_success_view: false,
        failure_inference: false,
        inferred_failure_carrier: None,
        failure_contract_source: "no declared failure contract",
        failure_repair: None,
        function_name: "",
        return_alias: None,
        fallback_err_denial: None,
        noelse_chain_starts: [Int]{},
        fallback_tables: [Int]{},
        lost_tail_span: None,
        value_tail_span: None,
        failure_edges: [String]{},
        failure_direct_source: false,
        arrow_loop_body: false,
    }
}

sema_body_check_init: fn(program: @SemaProgramTables, environment: @SemaScopeEnvironment) -> SemaBodyCheck Never! {
    SemaBodyCheck{program: program, environment: environment, state: sema_ownership_state_init(), tail_store: sema_statement_tail_store_init(), context: sema_check_context_init(), diagnostics: [Diagnostic]{}, scopes: sema_scope_init(module_none())}
}

// A check on another ownership state (a snapshot, a lambda's, a default's
// owner scope) swaps it into the record and back after: the first call puts
// `state` in the record's place and the record's own state in `state`, and a
// second call undoes it. Nothing is copied.
sema_body_check_swap_state: fn(check: ^SemaBodyCheck, state: ^SemaOwnershipState) Never! {
    held: check.state
    check.state = state
    state = held
}

// sema_body_check_swap_state for the check context.
sema_body_check_swap_context: fn(check: ^SemaBodyCheck, context: ^SemaCheckContext) Never! {
    held: check.context
    check.context = context
    context = held
}

// Both swaps: a check on another state and context.
sema_body_check_swap: fn(check: ^SemaBodyCheck, state: ^SemaOwnershipState, context: ^SemaCheckContext) Never! {
    sema_body_check_swap_state(check, state)
    sema_body_check_swap_context(check, context)
}

// sema_body_check_swap_state for the findings list: a check whose findings
// go to a list of its own (a probe's, a scratch list it drops) swaps that list
// in and back after.
sema_body_check_swap_diagnostics: fn(check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) Never! {
    held: check.diagnostics
    check.diagnostics = diagnostics
    diagnostics = held
}

// sema_body_check_swap_state for the scope table: an entry swaps its caller's
// table in, and a check on another table (a lambda's, a comptime item's)
// swaps that one in and back after.
sema_body_check_swap_scopes: fn(check: ^SemaBodyCheck, scopes: ^SemaScopeTable) Never! {
    held: check.scopes
    check.scopes = scopes
    scopes = held
}

// sema_body_check_swap_state for the tail store. A default checks in its
// owner module's environment on a record made at the default's site, lent
// the caller's context and tail store for the check and given them back
// after.
sema_body_check_swap_tail_store: fn(check: ^SemaBodyCheck, tail_store: ^SemaStatementTailStore) Never! {
    held: check.tail_store
    check.tail_store = tail_store
    tail_store = held
}

sema_check_context_snapshot: fn(source: SemaCheckContext) -> SemaCheckContext Never! {
    ^snapshot: SemaCheckContext{
        exact_int_reachable: source.exact_int_reachable,
        unsafe_depth: source.unsafe_depth,
        duty_scope_depth: source.duty_scope_depth,
        borrow_ctx: source.borrow_ctx,
        allow_string_view_read: source.allow_string_view_read,
        suppress_partial_move_root_read: source.suppress_partial_move_root_read,
        allow_fixed_constructor: source.allow_fixed_constructor,
        generic_params: source.generic_params.copy(),
        lambda_escapes: source.lambda_escapes,
        lambda_lending_views: source.lambda_lending_views,
        lending_view_parameter_keys: source.lending_view_parameter_keys.copy(),
        lambda_statement_tails: source.lambda_statement_tails.copy(),
        call_facts: source.call_facts.copy(),
        module_writes: source.module_writes.copy(),
        module_reads: (loop item in source.module_reads -> TEffectSpan{name: item.name, span: item.span, held: item.held}),
        rule_tables: if source.rule_tables.calls_at.len() == 0 -> SemaRuleTables{} else -> source.rule_tables.copy(),
        call_return_views: source.call_return_views.copy(),
        local_view_provenance: source.local_view_provenance.copy(),
        return_view_receiver_key: source.return_view_receiver_key,
        return_view_parameter_keys: source.return_view_parameter_keys.copy(),
        // copy: sema_check_context_snapshot builds an independent context: the snapshot is restored
        // after a speculative check, while `source` (the live context) keeps mutating.
        return_view_provenance: source.return_view_provenance.copy(),
        name_references: source.name_references.copy(),
        comptime_requests: source.comptime_requests.copy(),
        comptime_body_sources: source.comptime_body_sources.copy(),
        // A lambda body's recorded calls move back to its function's context
        // (sema_expression_lambda_with_host_in_frame); no other snapshot's
        // are the body's.
        recorded_calls: [SemaRecordedCall]{},
        // Sharing the publication does not visit, copy, or reindex its rows.
        // copy: sema_check_context_snapshot builds an independent context: the snapshot's body
        // values (a handle: Shared facts plus length) outlive the live context's later publication
        // edits.
        comptime_body_values: source.comptime_body_values.copy(),
        comptime_body_source_modules: [Int]{},
        comptime_body_source_rows: [SemaComptimePlaceRows]{},
        compute_calls: source.compute_calls.copy(),
        autodiff_obligations: source.autodiff_obligations.copy(),
        generic_crossings: source.generic_crossings.copy(),
        generic_calls: source.generic_calls.copy(),
        // A lambda in a generic body's compile-time site is part of that
        // site: its `T.reflect()` reads type the site's code, and the caller
        // takes the reads it adds back (sema_expression_lambda_merge_context_facts).
        generic_site: source.generic_site,
        autodiff_safe_panic: source.autodiff_safe_panic,
        autodiff_unsafe_panic: source.autodiff_unsafe_panic,
        autodiff_safe_panic_context: source.autodiff_safe_panic_context,
        copy_events: source.copy_events.copy(),
        loop_value_frames: source.loop_value_frames.copy(),
        loop_break_flows: sema_loop_break_flows_snapshot(source.loop_break_flows),
        pending_loop_value: source.pending_loop_value,
        collect_item_types: source.collect_item_types.copy(),
        collect_item_if: source.collect_item_if,
        last_loop_result_type: source.last_loop_result_type,
        arrow_loop_body: source.arrow_loop_body,
        reactive_upgrades: source.reactive_upgrades.copy(),
        reactive_upgrade_names: source.reactive_upgrade_names.copy(),
        reactive_local_ids: source.reactive_local_ids.copy(),
        reactive_shared_ids: source.reactive_shared_ids.copy(),
        taskgroups: sema_taskgroup_state_snapshot(source.taskgroups),
        failure_carrier_root: source.failure_carrier_root,
        failure_success_view: source.failure_success_view,
        failure_inference: source.failure_inference,
        inferred_failure_carrier: source.inferred_failure_carrier,
        callback_return_open: source.callback_return_open,
        callback_return_closed: source.callback_return_closed,
        callback_return_row: source.callback_return_row,
        failure_contract_source: source.failure_contract_source,
        failure_repair: source.failure_repair,
        function_name: source.function_name,
        return_alias: source.return_alias,
        fallback_err_denial: source.fallback_err_denial,
        noelse_chain_starts: source.noelse_chain_starts.copy(),
        fallback_tables: source.fallback_tables.copy(),
        lost_tail_span: source.lost_tail_span,
        value_tail_span: source.value_tail_span,
        failure_edges: source.failure_edges.copy(),
        failure_direct_source: source.failure_direct_source,
        failure_union_members: source.failure_union_members.copy(),
        failure_union_cases: source.failure_union_cases.copy(),
        failure_union_edges: source.failure_union_edges.copy(),
        failure_union_general: source.failure_union_general,
        failure_union_inferable: source.failure_union_inferable,
        source_nesting: source.source_nesting,
        implicit_loop_subject_depth: source.implicit_loop_subject_depth,
        subject_shorthand_depth: source.subject_shorthand_depth,
        host_hooks: source.host_hooks,
        eval_walk: sema_eval_walk_fork(source.eval_walk),
        arithmetic_policy: source.arithmetic_policy,
        runtime_policy: source.runtime_policy,
        compiler_generated: source.compiler_generated,
        compiler_records: source.compiler_records,
        fork_copy_rebuilding: source.fork_copy_rebuilding.copy(),
        return_view_declared: source.return_view_declared,
        bare_generic_signature: source.bare_generic_signature,
        // A snapshot's check continues the arena of the check it starts
        // from: its rows follow that arena's rows, its symbol keys extend a
        // copy of that arena's, and its caller appends the rows and adopts
        // the keys after the check (sema_arena_take_back). A snapshot
        // dropped instead drops the ids it minted with it.
        arena: BodyFlat{tree: BodyTree{nodes: [BodyNode]{}, stmts: [StmtKind]{}, expr_types: [TExprType]{}, node_base: source.arena.tree.node_base + source.arena.tree.nodes.len(), stmt_base: source.arena.tree.stmt_base + source.arena.tree.stmts.len(), symbols: source.arena.tree.symbols.copy()}, arena: BodyTree{nodes: [BodyNode]{}, stmts: [StmtKind]{}, expr_types: [TExprType]{}}, into_arena: true},
        next_expr_id: source.next_expr_id,
        fresh_expr_ids: source.fresh_expr_ids,
        is_snapshot: true,
    }
    sema_comptime_body_sources_index(snapshot)
    sema_comptime_body_work_count(source.comptime_body_values, SemaComptimeBodyWorkOperation.ContextSnapshot)
    snapshot
}

// A nested check on a snapshot interns into the type delta of the check it
// nests in: the enclosing check lends its delta (`from`) to the snapshot's
// (`to`) before the nested check, and the snapshot hands it back the same
// way after, so a TypeID the nested check publishes (a comptime request's
// tree, sema_publish_expression) names the same row in the enclosing check.
// A snapshot that forked a delta of its own hands that one back.
sema_check_delta_pass: fn(from: ^[InternerDelta], to: ^[InternerDelta]) Never! {
    ^delta: from.pop() ?? return
    to.push(delta)
}

// A rollback point for a probe check run on the live context (instead of a
// sema_check_context_snapshot copy, which costs every row the function has
// accumulated so far). The rows a check only appends to keep their lengths and
// are truncated on rollback; every other field is copied into `saved` (whose
// appended-row lists stay empty). As with a snapshot, the probe starts with no
// `iter_borrowed` rows and no binding initializer open. A new
// SemaCheckContext field must be added here and in the rollback.
SemaCheckContextMark: struct {
    call_facts: Int,
    module_writes: Int,
    module_reads: Int,
    call_return_views: Int,
    local_view_provenance: Int,
    name_references: Int,
    comptime_requests: Int,
    comptime_body_sources: Int,
    recorded_calls: Int,
    compute_calls: Int,
    autodiff_obligations: Int,
    generic_crossings: Int,
    generic_calls: Int,
    copy_events: Int,
    noelse_chain_starts: Int,
    failure_edges: Int,
    failure_union_members: Int,
    failure_union_cases: Int,
    failure_union_edges: Int,
    incomplete_reasons: Int,
    origin_facts: Int,
    typed_goals: Int,
    index_proofs: Int,
    filed_expr_ids: Int,
    next_expr_id: Int,
    saved: SemaCheckContextSaved,
}

// Only the non-append-only fields of SemaCheckContext that a mark saves and
// rollback restores: avoids constructing a full SemaCheckContext (arena,
// BodyTrees, maps, and 20 empty lists) on every control-flow arm or probe.
SemaCheckContextSaved: struct {
    exact_int_reachable: Bool,
    unsafe_depth: Int,
    borrow_ctx: Bool,
    allow_string_view_read: Bool,
    suppress_partial_move_root_read: Bool,
    allow_fixed_constructor: Bool,
    generic_params: [TGenericParam],
    lambda_escapes: Bool?,
    lambda_lending_views: Bool,
    lending_view_parameter_keys: [String],
    lambda_statement_tails: [SemaStatementTailFrame],
    rule_tables: SemaRuleTables,
    return_view_receiver_key: String,
    return_view_parameter_keys: [String],
    return_view_provenance: ViewProvenanceMap?,
    comptime_body_values: SemaComptimeBodyValues,
    autodiff_safe_panic: Bool,
    autodiff_unsafe_panic: Bool,
    autodiff_safe_panic_context: Bool,
    loop_value_frames: [SemaLoopValueFrame],
    loop_break_flows: [SemaLoopBreakFlows],
    pending_loop_value: SemaPendingLoopValue?,
    collect_item_types: [Type?],
    collect_item_if: Span?,
    last_loop_result_type: Type?,
    arrow_loop_body: Bool,
    reactive_upgrades: [String],
    reactive_upgrade_names: [String],
    reactive_local_ids: [SymbolID],
    reactive_shared_ids: [SymbolID],
    taskgroups: SemaTaskGroupState,
    failure_carrier_root: Bool,
    failure_success_view: Bool,
    failure_inference: Bool,
    inferred_failure_carrier: TFailureCarrier?,
    callback_return_open: Bool,
    callback_return_closed: Bool,
    callback_return_row: Type?,
    failure_contract_source: String,
    failure_repair: SemaFailureRepair?,
    function_name: String,
    return_alias: String?,
    fallback_err_denial: String?,
    lost_tail_span: Span?,
    value_tail_span: Span?,
    failure_direct_source: Bool,
    failure_union_general: Bool,
    task_body_propagates: Bool,
    iter_borrowed: [String],
    binding_initializer: Bool,
    source_nesting: Int,
    implicit_loop_subject_depth: Int,
    subject_shorthand_depth: Int,
    arithmetic_policy: ArithmeticPolicyFact?,
    runtime_policy: PolicyValue?,
    compiler_generated: Bool,
    return_view_declared: Bool,
}

sema_check_context_mark: fn(context: ^SemaCheckContext) -> SemaCheckContextMark Never! {
    mark: sema_check_context_save(context)
    context.iter_borrowed = [String]{}
    context.binding_initializer = false
    mark
}

// A rollback point that leaves the context as it is: the check that follows
// is the real one, rolled back only if its result is discarded.
sema_check_context_save: fn(context: SemaCheckContext) -> SemaCheckContextMark Never! {
    SemaCheckContextMark{
        call_facts: context.call_facts.len(),
        module_writes: context.module_writes.len(),
        module_reads: context.module_reads.len(),
        call_return_views: context.call_return_views.len(),
        local_view_provenance: context.local_view_provenance.len(),
        name_references: context.name_references.len(),
        comptime_requests: context.comptime_requests.len(),
        comptime_body_sources: context.comptime_body_sources.len(),
        recorded_calls: context.recorded_calls.len(),
        compute_calls: context.compute_calls.len(),
        autodiff_obligations: context.autodiff_obligations.len(),
        generic_crossings: context.generic_crossings.len(),
        generic_calls: context.generic_calls.len(),
        copy_events: context.copy_events.len(),
        noelse_chain_starts: context.noelse_chain_starts.len(),
        failure_edges: context.failure_edges.len(),
        failure_union_members: context.failure_union_members.len(),
        failure_union_cases: context.failure_union_cases.len(),
        failure_union_edges: context.failure_union_edges.len(),
        incomplete_reasons: context.incomplete_reasons.len(),
        origin_facts: context.origin_facts.len(),
        typed_goals: context.typed_goals.len(),
        index_proofs: context.index_proofs.len(),
        filed_expr_ids: context.filed_expr_ids.len(),
        next_expr_id: context.next_expr_id,
        saved: SemaCheckContextSaved{
            exact_int_reachable: context.exact_int_reachable,
            unsafe_depth: context.unsafe_depth,
            borrow_ctx: context.borrow_ctx,
            allow_string_view_read: context.allow_string_view_read,
            suppress_partial_move_root_read: context.suppress_partial_move_root_read,
            allow_fixed_constructor: context.allow_fixed_constructor,
            generic_params: if context.generic_params.len() == 0 -> [TGenericParam]{} else -> context.generic_params.copy(),
            lambda_escapes: context.lambda_escapes,
            lambda_lending_views: context.lambda_lending_views,
            lending_view_parameter_keys: if context.lending_view_parameter_keys.len() == 0 -> [String]{} else -> context.lending_view_parameter_keys.copy(),
            lambda_statement_tails: if context.lambda_statement_tails.len() == 0 -> [SemaStatementTailFrame]{} else -> context.lambda_statement_tails.copy(),
            rule_tables: if context.rule_tables.calls_at.len() == 0 -> SemaRuleTables{} else -> context.rule_tables.copy(),
            return_view_receiver_key: context.return_view_receiver_key,
            return_view_parameter_keys: if context.return_view_parameter_keys.len() == 0 -> [String]{} else -> context.return_view_parameter_keys.copy(),
            return_view_provenance: context.return_view_provenance,
            // copy: the publication view (shared facts owner and visible
            // length); rollback restores it, including a replaced generation.
            comptime_body_values: context.comptime_body_values.copy(),
            autodiff_safe_panic: context.autodiff_safe_panic,
            autodiff_unsafe_panic: context.autodiff_unsafe_panic,
            autodiff_safe_panic_context: context.autodiff_safe_panic_context,
            loop_value_frames: if context.loop_value_frames.len() == 0 -> [SemaLoopValueFrame]{} else -> context.loop_value_frames.copy(),
            loop_break_flows: if context.loop_break_flows.len() == 0 -> [SemaLoopBreakFlows]{} else -> sema_loop_break_flows_snapshot(context.loop_break_flows),
            pending_loop_value: context.pending_loop_value,
            collect_item_types: if context.collect_item_types.len() == 0 -> [Type?]{} else -> context.collect_item_types.copy(),
            collect_item_if: context.collect_item_if,
            last_loop_result_type: context.last_loop_result_type,
            arrow_loop_body: context.arrow_loop_body,
            reactive_upgrades: if context.reactive_upgrades.len() == 0 -> [String]{} else -> context.reactive_upgrades.copy(),
            reactive_upgrade_names: if context.reactive_upgrade_names.len() == 0 -> [String]{} else -> context.reactive_upgrade_names.copy(),
            reactive_local_ids: if context.reactive_local_ids.len() == 0 -> [SymbolID]{} else -> context.reactive_local_ids.copy(),
            reactive_shared_ids: if context.reactive_shared_ids.len() == 0 -> [SymbolID]{} else -> context.reactive_shared_ids.copy(),
            taskgroups: sema_taskgroup_state_snapshot(context.taskgroups),
            failure_carrier_root: context.failure_carrier_root,
            failure_success_view: context.failure_success_view,
            failure_inference: context.failure_inference,
            inferred_failure_carrier: context.inferred_failure_carrier,
            callback_return_open: context.callback_return_open,
            callback_return_closed: context.callback_return_closed,
            callback_return_row: context.callback_return_row,
            failure_contract_source: context.failure_contract_source,
            failure_repair: context.failure_repair,
            function_name: context.function_name,
            return_alias: context.return_alias,
            fallback_err_denial: context.fallback_err_denial,
            lost_tail_span: context.lost_tail_span,
            value_tail_span: context.value_tail_span,
            failure_direct_source: context.failure_direct_source,
            failure_union_general: context.failure_union_general,
            task_body_propagates: context.task_body_propagates,
            iter_borrowed: if context.iter_borrowed.len() == 0 -> [String]{} else -> context.iter_borrowed.copy(),
            binding_initializer: context.binding_initializer,
            source_nesting: context.source_nesting,
            implicit_loop_subject_depth: context.implicit_loop_subject_depth,
            subject_shorthand_depth: context.subject_shorthand_depth,
            arithmetic_policy: context.arithmetic_policy,
            runtime_policy: context.runtime_policy,
            compiler_generated: context.compiler_generated,
            return_view_declared: context.return_view_declared,
        },
    }
}

// Closes `mark` without rolling back: the checks since it are kept. In-place
// edit rows stay for any enclosing mark.
sema_scope_commit: fn(table: ^SemaScopeTable, mark: SemaScopeMark) Never! {
    table.open_marks = mark.open_marks
}

// Restores `context` to `mark`: appended rows are dropped (a check only appends
// to these lists; the one in-place row edit, a discarded call fact, stays
// inside the rows its statement appended) and every other field is restored,
// except the number-name refusals, which stay (number_retypes_found). The mark
// is spent, so its saved fields move back.
sema_check_context_rollback: fn(context: ^SemaCheckContext, mark: ^^SemaCheckContextMark) Never! {
    loop context.call_facts.len() > mark.call_facts -> ^_: context.call_facts.pop()
    loop context.module_writes.len() > mark.module_writes -> ^_: context.module_writes.pop()
    loop context.module_reads.len() > mark.module_reads -> ^_: context.module_reads.pop()
    loop context.call_return_views.len() > mark.call_return_views {
        ^_: context.call_return_views.pop()
    }
    loop context.local_view_provenance.len() > mark.local_view_provenance {
        ^_: context.local_view_provenance.pop()
    }
    loop context.name_references.len() > mark.name_references -> ^_: context.name_references.pop()
    loop context.comptime_requests.len() > mark.comptime_requests {
        ^_: context.comptime_requests.pop()
    }
    sema_comptime_body_sources_truncate(context, mark.comptime_body_sources)
    loop context.recorded_calls.len() > mark.recorded_calls -> ^_: context.recorded_calls.pop()
    loop context.compute_calls.len() > mark.compute_calls -> ^_: context.compute_calls.pop()
    loop context.autodiff_obligations.len() > mark.autodiff_obligations {
        ^_: context.autodiff_obligations.pop()
    }
    loop context.generic_crossings.len() > mark.generic_crossings {
        ^_: context.generic_crossings.pop()
    }
    loop context.generic_calls.len() > mark.generic_calls -> ^_: context.generic_calls.pop()
    loop context.copy_events.len() > mark.copy_events -> ^_: context.copy_events.pop()
    loop context.origin_facts.len() > mark.origin_facts -> ^_: context.origin_facts.pop()
    loop context.typed_goals.len() > mark.typed_goals -> ^_: context.typed_goals.pop()
    loop context.index_proofs.len() > mark.index_proofs -> ^_: context.index_proofs.pop()
    loop context.filed_expr_ids.len() > mark.filed_expr_ids {
        ^dropped: context.filed_expr_ids.pop()
        if dropped == .Val(id) -> ^_: context.filed_expr_id_set.remove(id)
    }
    context.next_expr_id = mark.next_expr_id
    loop context.noelse_chain_starts.len() > mark.noelse_chain_starts {
        ^_: context.noelse_chain_starts.pop()
    }
    loop context.failure_edges.len() > mark.failure_edges -> ^_: context.failure_edges.pop()
    loop context.failure_union_members.len() > mark.failure_union_members {
        ^_: context.failure_union_members.pop()
    }
    loop context.failure_union_cases.len() > mark.failure_union_cases {
        ^_: context.failure_union_cases.pop()
    }
    loop context.failure_union_edges.len() > mark.failure_union_edges {
        ^_: context.failure_union_edges.pop()
    }
    loop context.incomplete_reasons.len() > mark.incomplete_reasons {
        ^_: context.incomplete_reasons.pop()
    }
    ^saved: mark.saved.move()
    context.comptime_body_values = saved.comptime_body_values.move()
    context.exact_int_reachable = saved.exact_int_reachable
    context.unsafe_depth = saved.unsafe_depth
    context.borrow_ctx = saved.borrow_ctx
    context.allow_string_view_read = saved.allow_string_view_read
    context.suppress_partial_move_root_read = saved.suppress_partial_move_root_read
    context.allow_fixed_constructor = saved.allow_fixed_constructor
    context.generic_params = saved.generic_params.move()
    context.lambda_escapes = saved.lambda_escapes
    context.lambda_lending_views = saved.lambda_lending_views
    context.lending_view_parameter_keys = saved.lending_view_parameter_keys.move()
    context.lambda_statement_tails = saved.lambda_statement_tails.move()
    context.rule_tables = saved.rule_tables.move()
    context.return_view_receiver_key = saved.return_view_receiver_key.move()
    context.return_view_parameter_keys = saved.return_view_parameter_keys.move()
    context.return_view_provenance = saved.return_view_provenance.move()
    context.autodiff_safe_panic = saved.autodiff_safe_panic
    context.autodiff_unsafe_panic = saved.autodiff_unsafe_panic
    context.autodiff_safe_panic_context = saved.autodiff_safe_panic_context
    context.loop_value_frames = saved.loop_value_frames.move()
    context.loop_break_flows = saved.loop_break_flows.move()
    context.pending_loop_value = saved.pending_loop_value.move()
    context.collect_item_types = saved.collect_item_types.move()
    context.collect_item_if = saved.collect_item_if
    context.last_loop_result_type = saved.last_loop_result_type.move()
    context.arrow_loop_body = saved.arrow_loop_body
    context.reactive_upgrades = saved.reactive_upgrades.move()
    context.reactive_upgrade_names = saved.reactive_upgrade_names.move()
    context.reactive_local_ids = saved.reactive_local_ids.move()
    context.reactive_shared_ids = saved.reactive_shared_ids.move()
    context.taskgroups = saved.taskgroups.move()
    context.failure_carrier_root = saved.failure_carrier_root
    context.failure_success_view = saved.failure_success_view
    context.failure_inference = saved.failure_inference
    context.inferred_failure_carrier = saved.inferred_failure_carrier.move()
    context.callback_return_open = saved.callback_return_open
    context.callback_return_closed = saved.callback_return_closed
    context.callback_return_row = saved.callback_return_row.move()
    context.failure_contract_source = saved.failure_contract_source.move()
    context.failure_repair = saved.failure_repair.move()
    context.function_name = saved.function_name.move()
    context.return_alias = saved.return_alias.move()
    context.fallback_err_denial = saved.fallback_err_denial.move()
    context.lost_tail_span = saved.lost_tail_span
    context.value_tail_span = saved.value_tail_span
    context.failure_direct_source = saved.failure_direct_source
    context.failure_union_general = saved.failure_union_general
    context.task_body_propagates = saved.task_body_propagates
    context.iter_borrowed = saved.iter_borrowed.move()
    context.binding_initializer = saved.binding_initializer
    context.source_nesting = saved.source_nesting
    context.implicit_loop_subject_depth = saved.implicit_loop_subject_depth
    context.subject_shorthand_depth = saved.subject_shorthand_depth
    context.arithmetic_policy = saved.arithmetic_policy.move()
    context.runtime_policy = saved.runtime_policy
    context.compiler_generated = saved.compiler_generated
    context.return_view_declared = saved.return_view_declared
}

// Records why the body being checked is incomplete when no diagnostic says so.
// Every path that marks a body incomplete without a diagnostic calls this.
sema_check_unsupported: fn(context: ^SemaCheckContext, reason: String) Never! {
    context.incomplete_reasons.push(reason.copy())
}

// Gives `value`, the checked form of `expr`, the expression's node id, or a
// fresh function-local id when that id is generated or already filed (a
// desugared copy checked again), so no two nodes of the flat body share an
// id. A value a nested check filed (a grouping, a delegated form) keeps its id.
sema_check_record_expr_id: fn(expr: Expr, value: ^TExpr, context: ^SemaCheckContext) Never! {
    if value.id != AST_NODE_GENERATED {
        return
    }
    ^id: expr_node_id(expr)
    if id == AST_NODE_GENERATED || context.fresh_expr_ids || context.filed_expr_id_set.get(id) != None {
        id = context.next_expr_id
        context.next_expr_id -= 1
    } else {
        context.filed_expr_id_set[id] = true
        context.filed_expr_ids.push(id)
    }
    value.id = id
}

// Hands the source ids a snapshot (sema_check_context_snapshot) filed back to
// the context it was taken from, with its id count.
sema_check_context_merge_expr_ids: fn(source: SemaCheckContext, target: ^SemaCheckContext) Never! {
    loop id in source.filed_expr_ids {
        target.filed_expr_id_set[id] = true
        target.filed_expr_ids.push(id)
    }
    target.next_expr_id = source.next_expr_id
}

// Hands back the source ids a full copy of `target` filed past target's own,
// with its id count: a check run on a copied context keeps its ids.
sema_check_context_return_expr_ids: fn(copied: SemaCheckContext, target: ^SemaCheckContext) Never! {
    loop index in target.filed_expr_ids.len()..<copied.filed_expr_ids.len() {
        id: copied.filed_expr_ids[index]
        target.filed_expr_id_set[id] = true
        target.filed_expr_ids.push(id)
    }
    target.next_expr_id = copied.next_expr_id
}

// Rolls `context` back to `mark` but keeps the source ids filed since it,
// with the id count: the facts of an erased `#Off(.Release)` body stay inside it,
// while its checked statements stay in the tree and keep their ids.
sema_check_context_rollback_keep_expr_ids: fn(context: ^SemaCheckContext, mark: ^^SemaCheckContextMark) Never! {
    kept: loop index in mark.filed_expr_ids..<context.filed_expr_ids.len() -> context.filed_expr_ids[index]
    next_expr_id: context.next_expr_id
    sema_check_context_rollback(context, mark.move())
    loop id in kept {
        context.filed_expr_id_set[id] = true
        context.filed_expr_ids.push(id)
    }
    context.next_expr_id = next_expr_id
}

// Rolls a kept `#On(.Deep)` body's facts back as
// sema_check_context_rollback_keep_expr_ids does, but keeps its call sites:
// the deep check runs where `--deep-checks` selects it, and the effect pass
// reads what each of its calls reaches (E0713) from them.
sema_check_context_rollback_keep_calls: fn(context: ^SemaCheckContext, mark: ^^SemaCheckContextMark) Never! {
    ^calls: [SemaCallSiteFact]{}
    loop context.call_facts.len() > mark.call_facts {
        fact: context.call_facts.pop() ?? break
        calls.push(fact)
    }
    calls.reverse()
    sema_check_context_rollback_keep_expr_ids(context, mark.move())
    context.call_facts.extend(calls.move())
}

// copy: a deferred arm is checked later against the scope table as it is now,
// while the live table goes on to the sibling arm; the snapshot is that table.
sema_scope_snapshot: fn(source: SemaScopeTable) -> SemaScopeTable Never! {
    SemaScopeTable{
        module_identity: source.module_identity,
        frames: source.frames.copy(),
        bindings: source.bindings.copy(),
        name_slots: source.name_slots.copy(),
        name_positions: source.name_positions.copy(),
        base_table: source.base_table,
        base_binding_count: source.base_binding_count,
        loop_labels: source.loop_labels.copy(),
        current: source.current,
        knowledge_gate: source.knowledge_gate,
        return_type: source.return_type,
        failure_carrier: source.failure_carrier,
        loop_depth: source.loop_depth,
        ownership_call_depth: source.ownership_call_depth,
        comptime_execution_depth: source.comptime_execution_depth,
        transaction_depth: source.transaction_depth,
        transaction_wall_depth: source.transaction_wall_depth,
        unit_explicit_units: source.unit_explicit_units,
        copies_explicit: source.copies_explicit,
        writes_explicit: source.writes_explicit,
        failures_explicit: source.failures_explicit,
        context_allocation: source.context_allocation,
        binding_undo: source.binding_undo.copy(),
        open_marks: source.open_marks,
        location_function: source.location_function,
        light_types: source.light_types.copy(),
        position_free: source.position_free,
        lookup_counters: source.lookup_counters,
        method_return_views: source.method_return_views.copy(),
    }
}

// Opens a rollback point. Control-flow paths and function bodies are checked
// in place and rolled back, instead of copying the whole table (which holds
// every module declaration) per path.
sema_scope_mark: fn(table: ^SemaScopeTable) -> SemaScopeMark Never! {
    mark: SemaScopeMark{
        frames: table.frames.len(),
        bindings: table.bindings.len(),
        undo: table.binding_undo.len(),
        loop_labels: if table.loop_labels.len() == 0 -> [SemaScopeLoopLabel]{} else -> table.loop_labels.copy(),
        current: table.current,
        knowledge_gate: table.knowledge_gate,
        return_type: table.return_type,
        failure_carrier: table.failure_carrier,
        loop_depth: table.loop_depth,
        ownership_call_depth: table.ownership_call_depth,
        comptime_execution_depth: table.comptime_execution_depth,
        transaction_depth: table.transaction_depth,
        transaction_wall_depth: table.transaction_wall_depth,
        unit_explicit_units: table.unit_explicit_units,
        copies_explicit: table.copies_explicit,
        writes_explicit: table.writes_explicit,
        failures_explicit: table.failures_explicit,
        context_allocation: table.context_allocation,
        open_marks: table.open_marks,
        deep_check: table.deep_check,
    }
    table.open_marks += 1
    mark
}

// Restores the table to `mark`: in-place binding edits are undone newest
// first, rows pushed since the mark are dropped (with their name positions,
// which are ascending per name), and the small fields are restored.
sema_scope_rollback: fn(table: ^SemaScopeTable, mark: SemaScopeMark) Never! {
    // Newest edit first: each undo row is popped and its saved binding moves
    // back into place.
    loop table.binding_undo.len() > mark.undo {
        ^undo: table.binding_undo.pop() ?? break
        if undo.index < mark.bindings -> table.bindings[undo.index] = undo.binding.move()
    }
    loop table.bindings.len() > mark.bindings {
        last: table.bindings.len() - 1
        if last >= table.base_binding_count {
            if sema_scope_name_slot(table, table.bindings[last].symbol.name) == .Val(slot) {
                ^_: table.name_positions[slot].pop()
            }
        }
        ^_: table.bindings.pop()
    }
    loop table.frames.len() > mark.frames -> ^_: table.frames.pop()
    if mark.loop_labels.len() == 0 {
        if table.loop_labels.len() > 0 -> table.loop_labels = [SemaScopeLoopLabel]{}
    } else { table.loop_labels = mark.loop_labels.copy() }
    table.current = mark.current
    table.knowledge_gate = mark.knowledge_gate
    table.return_type = mark.return_type
    table.failure_carrier = mark.failure_carrier
    table.loop_depth = mark.loop_depth
    table.ownership_call_depth = mark.ownership_call_depth
    table.comptime_execution_depth = mark.comptime_execution_depth
    table.transaction_depth = mark.transaction_depth
    table.transaction_wall_depth = mark.transaction_wall_depth
    table.unit_explicit_units = mark.unit_explicit_units
    table.copies_explicit = mark.copies_explicit
    table.writes_explicit = mark.writes_explicit
    table.failures_explicit = mark.failures_explicit
    table.context_allocation = mark.context_allocation
    table.deep_check = mark.deep_check
    // Exact even when a nested mark was abandoned by an early return.
    table.open_marks = mark.open_marks
}

// Call before editing `table.bindings[index]` in place, so an open rollback
// point can restore the old row.
sema_scope_note_binding_edit: fn(table: ^SemaScopeTable, index: Int) Never! {
    if table.open_marks == 0 {
        return
    }
    // copy: the undo log keeps the binding's old row, and the caller edits the live row in
    // table.bindings right after. A rollback needs both rows.
    previous: table.bindings[index].copy()
    table.binding_undo.push(SemaScopeBindingUndo{index: index, binding: previous})
}

sema_scope_init: fn(module_identity: ModuleID) -> SemaScopeTable Never! {
    SemaScopeTable{
        module_identity: module_identity,
        frames: [SemaScopeFrame]{SemaScopeFrame{parent: -1, owner: ""}},
        bindings: [SemaScopeBinding]{},
        name_slots: name_table_sized(16),
        name_positions: [[Int]]{},
        loop_labels: [SemaScopeLoopLabel]{},
        current: 0,
        return_type: None,
        failure_carrier: None,
        knowledge_gate: None,
        loop_depth: 0,
        ownership_call_depth: 0,
        comptime_execution_depth: 0,
        transaction_depth: 0,
        transaction_wall_depth: 0,
        unit_explicit_units: false,
    }
}

sema_scope_function_owner_key: fn(table: SemaScopeTable) -> String Never! {
    if table.current <= 0 -> return ""
    ^frame: table.current
    loop table.frames[frame].parent > 0 -> frame = table.frames[frame].parent
    table.frames[frame].owner
}

// Whether the current scope is lexically inside an `#Impure` block.
sema_scope_inside_impure: fn(table: SemaScopeTable) -> Bool Never! {
    ^frame: table.current
    loop frame > 0 {
        if table.frames[frame].owner.starts_with("impure@") -> return true
        frame = table.frames[frame].parent
    }
    false
}

// A local identity is rooted at its enclosing function/lambda and includes
// every lexical frame owner; frame indices are traversal-order artifacts.
sema_scope_local_owner_key: fn(table: SemaScopeTable) -> String Never! {
    ^owner: ""
    ^frame: table.current
    loop frame > 0 {
        frame_owner: table.frames[frame].owner
        owner = if owner == "" -> frame_owner else -> "{frame_owner}/{owner}"
        frame = table.frames[frame].parent
    }
    owner
}

sema_scope_enter: fn(table: ^SemaScopeTable, state: ^SemaOwnershipState, owner: String) -> Int Never! {
    parent: table.current
    id: table.frames.len()
    table.frames.push(SemaScopeFrame{parent: parent, owner: owner})
    table.current = id
    sema_ownership_enter_scope(state)
    id
}

sema_scope_leave: fn(table: ^SemaScopeTable, state: ^SemaOwnershipState) Never! {
    if table.current <= 0 {
        return
    }
    leaving: table.current
    sema_ownership_leave_scope(state)
    table.current = table.frames[leaving].parent
}

// Module declarations share one root namespace. The declaration pass reports
// E0105 at the source declaration when this returns false.
sema_scope_add_module_symbol: fn(table: ^SemaScopeTable, symbol: Symbol, key: String) -> Bool Never! {
    hash: name_text_hash(symbol.name)
    if sema_scope_name_slot_hashed(table, symbol.name, hash) == .Val(slot) {
        loop index in table.name_positions[slot] {
            binding: table.bindings[index]
            if binding.frame == 0 && !binding.compiler_builtin -> return false
        }
    }
    if table.base_binding_count > 0 {
        if sema_scope_name_slot_in(table.base_table[0].name_slots, table.base_table[0].name_positions, symbol.name, hash) == .Val(slot) {
            loop index in table.base_table[0].name_positions[slot] {
                binding: table.bindings[index]
                if binding.frame == 0 && !binding.compiler_builtin -> return false
            }
        }
    }
    sema_scope_push_binding(table, SemaScopeBinding{frame: 0, symbol: symbol, key: key, mutable: false, access: AccessConvention.Read, integer_bounds: None, string_view: false, compiler_builtin: false})
    true
}

// The module-level names a template wrote, bound for one generated function
// (Func.definition_module): the template module's own declarations and its
// `use` names, private ones included, pushed after the marker module's so
// they hide its same-named rows. A name a paste produced (Func.site_names)
// keeps resolving at the marker's site. The caller's mark drops the rows.
sema_scope_bind_definition_site: fn(table: ^SemaScopeTable, graph: SemaRegistrationGraph, func: Func) Never! {
    module_index: sema_registration_module_index_text(graph, func.definition_module) ?? return
    loop symbol in graph.modules[module_index].symbols {
        if !func.site_names.contains(symbol.name) {
            sema_scope_push_binding(table, SemaScopeBinding{frame: 0, symbol: symbol.copy(), key: symbol_table_key(graph.symbols, symbol.id), mutable: false, access: AccessConvention.Read, integer_bounds: None, string_view: false, compiler_builtin: false})
        }
    }
    loop import in graph.modules[module_index].imports {
        loop binding in import.bindings {
            if !func.site_names.contains(binding.symbol.name) {
                sema_scope_push_binding(table, SemaScopeBinding{frame: 0, symbol: sema_registration_binding_symbol(graph, binding), key: symbol_table_key(graph.symbols, binding.symbol.id), mutable: false, access: AccessConvention.Read, integer_bounds: None, string_view: false, compiler_builtin: false})
            }
        }
    }
}

sema_scope_add_compiler_builtin: fn(table: ^SemaScopeTable, graph: SemaRegistrationGraph) -> Bool Never! {
    builtin: sema_registration_compiler_builtin_row(graph, "Err") ?? return true
    nominal: graph.modules[builtin.module_index].nominals[builtin.row]
    loop binding in table.bindings {
        if binding.frame == 0 && binding.compiler_builtin && binding.symbol.id == nominal.symbol.id {
            return true
        }
    }
    sema_scope_push_binding(table, SemaScopeBinding{frame: 0, symbol: nominal.symbol, key: symbol_table_key(graph.symbols, nominal.symbol.id), mutable: false, access: AccessConvention.Read, integer_bounds: None, string_view: false, compiler_builtin: true})
    true
}

sema_knowledge_plane_name: fn(plane: SemaKnowledgePlane) -> String Never! {
    if plane == {
        .Range -> "range"
        .Exactness -> "exactness"
        .Unit -> "unit"
        .State -> "state"
        .Classification -> "classification"
    }
}

sema_knowledge_gate_spelling: fn(gate: SemaKnowledgeGate) -> String Never! {
    if gate == {
        .BoundedArithmetic -> "wrapping"
        .Approximation -> "approx"
        .RoundedConversion -> "rounded"
        .RawProjection -> "raw"
        .StateTransition -> "transition"
        .ClassificationScrub -> "scrub"
    }
}

sema_knowledge_gate_allows: fn(plane: SemaKnowledgePlane, gate: SemaKnowledgeGate) -> Bool Never! {
    if plane == {
        .Range -> if gate == {
            .BoundedArithmetic | .RawProjection -> true
            .Approximation | .RoundedConversion | .StateTransition | .ClassificationScrub -> false
        }
        .Exactness -> if gate == {
            .Approximation | .RoundedConversion | .RawProjection -> true
            .BoundedArithmetic | .StateTransition | .ClassificationScrub -> false
        }
        .Unit -> if gate == {
            .RoundedConversion | .RawProjection -> true
            .BoundedArithmetic | .Approximation | .StateTransition | .ClassificationScrub -> false
        }
        .State -> if gate == {
            .StateTransition | .RawProjection -> true
            .BoundedArithmetic | .Approximation | .RoundedConversion | .ClassificationScrub -> false
        }
        .Classification -> if gate == {
            .ClassificationScrub | .RawProjection -> true
            .BoundedArithmetic | .Approximation | .RoundedConversion | .StateTransition -> false
        }
    }
}

sema_scope_push_knowledge_gate: fn(table: ^SemaScopeTable, gate: SemaKnowledgeGate) -> SemaKnowledgeGate? {
    // copy: the caller gets the previous gate back to reinstall it, while the table's field is
    // overwritten with `gate`. Jet has no exchange on a field of the write-borrowed `table`.
    previous: table.knowledge_gate.copy()
    table.knowledge_gate = Val(gate)
    previous
}

sema_scope_pop_knowledge_gate: fn(table: ^SemaScopeTable, previous: SemaKnowledgeGate?) Never! {
    table.knowledge_gate = previous
}

sema_scope_knowledge_gate_allows: fn(table: SemaScopeTable, plane: SemaKnowledgePlane, gate: SemaKnowledgeGate) -> Bool Never! {
    active: table.knowledge_gate ?? return false
    sema_knowledge_gate_allows(plane, active)
}

sema_scope_require_knowledge_gate: fn(check: ^SemaBodyCheck, plane: SemaKnowledgePlane, gate: SemaKnowledgeGate, span: Span) -> Bool {
    if sema_scope_knowledge_gate_allows(check.scopes, plane, gate) -> return true
    plane_name: sema_knowledge_plane_name(plane)
    gate_name: sema_knowledge_gate_spelling(gate)
    check.diagnostics.push(sema_error("E0156", span, "This operation would loosen {plane_name}", "Knowledge only tightens silently; loosening {plane_name} must be named with a written gate", "Write `{gate_name}(value)` at this boundary"))
    false
}

sema_scope_module_policy: fn(table: ^SemaScopeTable, graph: SemaRegistrationGraph, module_identity: ModuleID) -> Int Never! {
    if table.policy_modules.get(module_identity.id) == .Val(position) -> return position
    ^policy: SemaScopeModulePolicy{
        unit_explicit_units: false,
        copies_explicit: false,
        writes_explicit: false,
        failures_explicit: false,
        function_unit_starts: [Int:Int]{},
        function_unit_ends: [[Int:Bool]]{},
    }
    if sema_registration_module_index(graph, module_identity) == .Val(module_index) {
        package_identity: graph.modules[module_index].package_identity
        loop declaration_index in 0..<graph.modules[module_index].program.policy_declarations.len() {
            if graph.modules[module_index].program.policy_declarations[declaration_index].key != PolicyKey.ExplicitUnits || graph.modules[module_index].program.policy_declarations[declaration_index].scope != PolicyScope.Function {
                next
            }
            target: graph.modules[module_index].program.policy_declarations[declaration_index].target ?? next
            ^slot: policy.function_unit_starts.get(target.start) ?? -1
            if slot < 0 {
                slot = policy.function_unit_ends.len()
                policy.function_unit_starts.add(target.start, slot).drop("a new function span start has no slot")
                policy.function_unit_ends.push([Int:Bool]{})
            }
            policy.function_unit_ends[slot].add(target.end, true).drop("function unit policy membership")
        }
        loop declaration_index in 0..<graph.modules.len() {
            if graph.modules[declaration_index].package_identity != package_identity -> next
            loop declaration in graph.modules[declaration_index].program.policy_declarations {
                if declaration.scope != PolicyScope.Package && !(declaration.scope == PolicyScope.Module && graph.modules[declaration_index].module_identity == module_identity) {
                    next
                }
                if declaration.key == PolicyKey.ExplicitUnits -> policy.unit_explicit_units = true
                if sema_string_view_copies_declaration(declaration) -> policy.copies_explicit = true
                if sema_call_marks_writes_declaration(declaration) -> policy.writes_explicit = true
                if sema_failure_marks_declaration(declaration) -> policy.failures_explicit = true
            }
        }
    }
    position: table.policy_rows.len()
    table.policy_modules.add(module_identity.id, position).drop("a new policy module has no row")
    table.policy_rows.push(policy)
    position
}

sema_scope_seed_unit_policy: fn(table: ^SemaScopeTable, graph: SemaRegistrationGraph, module_identity: ModuleID) Never! {
    // Module installation is the graph-lifetime boundary, not a function check.
    table.policy_modules = [U32:Int]{}
    table.policy_rows = [SemaScopeModulePolicy]{}
    position: sema_scope_module_policy(table, graph, module_identity)
    table.unit_explicit_units = table.policy_rows[position].unit_explicit_units
}

sema_scope_apply_unit_policy_for_function: fn(table: ^SemaScopeTable, graph: SemaRegistrationGraph, module_identity: ModuleID, function_span: Span) Never! {
    position: sema_scope_module_policy(table, graph, module_identity)
    table.unit_explicit_units = table.policy_rows[position].unit_explicit_units
    if table.policy_rows[position].function_unit_starts.get(function_span.start) == .Val(slot) {
        if table.policy_rows[position].function_unit_ends[slot].get(function_span.end) ?? false {
            table.unit_explicit_units = true
        }
    }
}

sema_scope_push_unit_policy: fn(table: ^SemaScopeTable, declarations: [PolicyDeclaration]) -> Bool Never! {
    previous: table.unit_explicit_units
    loop declaration in declarations {
        if declaration.key == PolicyKey.ExplicitUnits -> table.unit_explicit_units = true
    }
    previous
}

sema_scope_pop_unit_policy: fn(table: ^SemaScopeTable, previous: Bool) Never! {
    table.unit_explicit_units = previous
}

sema_scope_unit_explicit_units: fn(table: SemaScopeTable) -> Bool Never! {
    table.unit_explicit_units
}

sema_scope_binding_is_compiler_builtin: fn(binding: SemaScopeBinding, name: String) -> Bool Never! {
    binding.compiler_builtin && binding.symbol.name == name
}

// Locals, parameters, and constants share the function-local namespace.
// Module functions remain resolvable and loop labels use a separate stack.
sema_scope_name_blocks_binding: fn(kind: SymbolKind) -> Bool Never! {
    if kind == {
        .Local | .Parameter | .Constant -> true
        .Module | .Function | .Type | .Trait | .Impl | .Field | .Variant | .Import | .Foreign | .Label -> false
    }
}

sema_scope_has_loop_label: fn(table: SemaScopeTable, name: String) -> Bool Never! {
    ^index: table.loop_labels.len() - 1
    loop index >= 0 {
        if table.loop_labels[index].name == name -> return true
        index -= 1
    }
    false
}

sema_scope_push_loop_label: fn(table: ^SemaScopeTable, name: String) -> Bool Never! {
    ^duplicate: sema_scope_has_loop_label(table, name)
    if sema_scope_resolve_index(table, name) == .Val(binding_index) {
        binding: table.bindings[binding_index]
        if sema_scope_name_blocks_binding(binding.symbol.kind) -> duplicate = true
    }
    table.loop_labels.push(SemaScopeLoopLabel{name: name})
    !duplicate
}

sema_scope_pop_loop_label: fn(table: ^SemaScopeTable) Never! {
    if table.loop_labels.len() > 0 -> ^_: table.loop_labels.pop()
}

// Appends one binding and records its position under its name.
sema_scope_push_binding: fn(table: ^SemaScopeTable, binding: ^^SemaScopeBinding) Never! {
    position: table.bindings.len()
    id: name_index(name_intern(table.name_slots, binding.symbol.name))
    loop table.name_positions.len() <= id -> table.name_positions.push([Int]{})
    table.name_positions[id].push(position)
    table.bindings.push(binding.move())
}

// The `name_positions` row of `name`, if any binding in `slots` has that name.
sema_scope_name_slot_in: fn(slots: NameTable, positions: [[Int]], name: String, hash: Int) -> Int? Never! {
    if positions.len() == 0 -> return None
    found: name_find_hashed(slots, name, hash) ?? return None
    id: name_index(found)
    if id < positions.len() && positions[id].len() > 0 -> return Val(id)
    None
}

sema_scope_name_slot_hashed: fn(table: SemaScopeTable, name: String, hash: Int) -> Int? Never! {
    sema_scope_name_slot_in(table.name_slots, table.name_positions, name, hash)
}

// The `name_positions` row of `name`, if any binding ever had that name.
sema_scope_name_slot: fn(table: SemaScopeTable, name: String) -> Int? Never! {
    if table.name_positions.len() == 0 -> return None
    found: name_find(table.name_slots, name) ?? return None
    id: name_index(found)
    if id < table.name_positions.len() && table.name_positions[id].len() > 0 -> return Val(id)
    None
}

// Counts one resolution that examined `compares` binding rows when the table
// counts, and returns `found`.
sema_scope_counted: fn(table: SemaScopeTable, compares: Int, found: ^^Int?) -> Int? {
    if table.lookup_counters == .Val(handle) {
        ^counters: handle.counters
        permit: counters.guard_read()
        _: permit.value.scope_lookups.add(1)
        _: permit.value.scope_compares.add(compares)
    }
    found
}

// Whether the body being checked runs only while the program builds: a
// compile-time execution (a `#run` operand, a prepared value, a comptime
// function) or the body of the build entry `build: fn(b: Build)`. Any other
// function named `build` is ordinary code that runs with the program. The
// body's function is `location_function` on a compiler thread, else the
// environment's `function_name`.
sema_scope_build_time: fn(table: SemaScopeTable, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if table.comptime_execution_depth > 0 -> return true
    if (table.location_function ?? environment.function_name) != "build" -> return false
    graph: program.registration_graph
    module_index: sema_scope_caller_index(environment, graph) ?? return false
    loop item in graph.modules[module_index].program.items {
        if item == .Func(function) && function.name == "build" {
            return sema_function_is_build_entry(function)
        }
    }
    false
}

// Whether `function` is the build entry `build: fn(b: Build)`, read as
// written, as the Driver's build query selects it.
sema_function_is_build_entry: fn(function: Func) -> Bool Never! {
    if function.name != "build" || function.params.len() != 1 -> return false
    if function.params[0].ty == .Named(name) -> return name == "Build"
    false
}

sema_scope_resolve_in_positions: fn(table: SemaScopeTable, positions: [Int]) -> Int? Never! {
    pos_len: positions.len()
    if pos_len == 0 -> return None
    if pos_len == 1 {
        index: positions[0]
        b_frame: table.bindings[index].frame
        if b_frame == table.current -> return Val(index)
        if b_frame == 0 && table.current >= 0 && table.frames[0].parent < 0 -> return Val(index)
        ^frame: table.frames[table.current].parent
        loop frame >= 0 {
            if frame == b_frame -> return Val(index)
            frame = table.frames[frame].parent
        }
        return None
    }
    last_index: positions[pos_len - 1]
    if table.bindings[last_index].frame == table.current -> return Val(last_index)
    ^frame: table.current
    loop frame >= 0 {
        ^cursor: pos_len - 1
        loop cursor >= 0 {
            index: positions[cursor]
            if table.bindings[index].frame == frame -> return Val(index)
            cursor -= 1
        }
        frame = table.frames[frame].parent
    }
    None
}

sema_scope_resolve_index: fn(table: SemaScopeTable, name: String) -> Int? {
    if table.base_binding_count > 0 {
        hash: name_text_hash(name)
        local_slot: sema_scope_name_slot_hashed(table, name, hash)
        if table.lookup_counters == None {
            if local_slot == .Val(ls) {
                found: sema_scope_resolve_in_positions(table, table.name_positions[ls])
                if found != None -> return found
            }
            bs: sema_scope_name_slot_in(table.base_table[0].name_slots, table.base_table[0].name_positions, name, hash) ?? return None
            return sema_scope_resolve_in_positions(table, table.base_table[0].name_positions[bs])
        }
        base_slot: sema_scope_name_slot_in(table.base_table[0].name_slots, table.base_table[0].name_positions, name, hash)
        if local_slot == None {
            bs: base_slot ?? return sema_scope_counted(table, 0, None)
            if table.lookup_counters == None {
                return sema_scope_resolve_in_positions(table, table.base_table[0].name_positions[bs])
            }
            ^compares: 0
            pos_len: table.base_table[0].name_positions[bs].len()
            ^frame: table.current
            loop frame >= 0 {
                ^cursor: pos_len - 1
                loop cursor >= 0 {
                    compares += 1
                    index: table.base_table[0].name_positions[bs][cursor]
                    if table.bindings[index].frame == frame {
                        return sema_scope_counted(table, compares, Val(index))
                    }
                    cursor -= 1
                }
                frame = table.frames[frame].parent
            }
            return sema_scope_counted(table, compares, None)
        }
        if base_slot == None {
            if table.lookup_counters == None {
                return sema_scope_resolve_in_positions(table, table.name_positions[local_slot])
            }
            ^compares: 0
            pos_len: table.name_positions[local_slot].len()
            ^frame: table.current
            loop frame >= 0 {
                ^cursor: pos_len - 1
                loop cursor >= 0 {
                    compares += 1
                    index: table.name_positions[local_slot][cursor]
                    if table.bindings[index].frame == frame {
                        return sema_scope_counted(table, compares, Val(index))
                    }
                    cursor -= 1
                }
                frame = table.frames[frame].parent
            }
            return sema_scope_counted(table, compares, None)
        }
        local_len: table.name_positions[local_slot].len()
        base_len: table.base_table[0].name_positions[base_slot].len()
        if table.lookup_counters == None {
            ^frame: table.current
            loop frame >= 0 {
                ^cursor: local_len - 1
                loop cursor >= 0 {
                    index: table.name_positions[local_slot][cursor]
                    if table.bindings[index].frame == frame -> return Val(index)
                    cursor -= 1
                }
                ^b_cursor: base_len - 1
                loop b_cursor >= 0 {
                    index: table.base_table[0].name_positions[base_slot][b_cursor]
                    if table.bindings[index].frame == frame -> return Val(index)
                    b_cursor -= 1
                }
                frame = table.frames[frame].parent
            }
            return None
        }
        ^compares: 0
        ^frame: table.current
        loop frame >= 0 {
            ^cursor: local_len - 1
            loop cursor >= 0 {
                compares += 1
                index: table.name_positions[local_slot][cursor]
                if table.bindings[index].frame == frame {
                    return sema_scope_counted(table, compares, Val(index))
                }
                cursor -= 1
            }
            ^b_cursor: base_len - 1
            loop b_cursor >= 0 {
                compares += 1
                index: table.base_table[0].name_positions[base_slot][b_cursor]
                if table.bindings[index].frame == frame {
                    return sema_scope_counted(table, compares, Val(index))
                }
                b_cursor -= 1
            }
            frame = table.frames[frame].parent
        }
        return sema_scope_counted(table, compares, None)
    }
    slot: sema_scope_name_slot(table, name) ?? return sema_scope_counted(table, 0, None)
    if table.lookup_counters == None {
        return sema_scope_resolve_in_positions(table, table.name_positions[slot])
    }
    pos_len: table.name_positions[slot].len()
    ^compares: 0
    ^frame: table.current
    loop frame >= 0 {
        ^cursor: pos_len - 1
        loop cursor >= 0 {
            compares += 1
            index: table.name_positions[slot][cursor]
            if table.bindings[index].frame == frame {
                return sema_scope_counted(table, compares, Val(index))
            }
            cursor -= 1
        }
        frame = table.frames[frame].parent
    }
    sema_scope_counted(table, compares, None)
}

// The visible binding names nearest `name`, for an unknown name's fix: up to
// three within two edits (one edit for a name of one or two bytes), the
// nearest first and, among equals, nearer frames first.
sema_scope_near_visible_names: fn(table: SemaScopeTable, name: String) -> [String] {
    name_len: name.count_bytes()
    limit: if name_len <= 2 -> 1 else -> 2
    ^found: [String]{}
    ^distances: [Int]{}
    ^frame: table.current
    loop frame >= 0 {
        loop index in 0..<table.bindings.len() {
            if table.bindings[index].frame != frame || table.bindings[index].compiler_builtin {
                next
            }
            max_dist: if found.len() == 3 -> distances[2] - 1 else -> limit
            if max_dist < 1 -> return found
            candidate: table.bindings[index].symbol.name
            diff: candidate.count_bytes() - name_len
            if diff > max_dist || diff < -max_dist -> next
            if candidate == name || candidate.starts_with("__") || candidate.starts_with("@") || found.contains(candidate) {
                next
            }
            distance: sema_taint_edit_distance(name, candidate)
            if distance > max_dist -> next
            ^at: found.len()
            loop at > 0 && distances[at - 1] > distance -> at -= 1
            if at == 3 -> next
            // copy: the name outlives the scope table it is read from.
            found.insert(at, candidate.copy())
            distances.insert(at, distance)
            if found.len() > 3 {
                ^_: found.pop()
                ^_: distances.pop()
            }
        }
        frame = table.frames[frame].parent
    }
    found
}

sema_scope_resolve_at_in_positions: fn(table: SemaScopeTable, positions: [Int], use_span: Span) -> Int? Never! {
    pos_len: positions.len()
    if pos_len == 0 -> return None
    if pos_len == 1 {
        index: positions[0]
        b_frame: table.bindings[index].frame
        if b_frame == 0 && table.current >= 0 && table.frames[0].parent < 0 -> return Val(index)
        if !table.position_free && table.bindings[index].symbol.span.start > use_span.start {
            if table.frames[b_frame].parent >= 0 -> return None
        }
        if b_frame == table.current -> return Val(index)
        ^frame: table.frames[table.current].parent
        loop frame >= 0 {
            if frame == b_frame -> return Val(index)
            frame = table.frames[frame].parent
        }
        return None
    }
    last_index: positions[pos_len - 1]
    if table.bindings[last_index].frame == table.current && (table.frames[table.current].parent < 0 || table.position_free || table.bindings[last_index].symbol.span.start <= use_span.start) {
        return Val(last_index)
    }
    ^frame: table.current
    loop frame >= 0 {
        module_frame: table.frames[frame].parent < 0
        ^cursor: pos_len - 1
        loop cursor >= 0 {
            index: positions[cursor]
            if table.bindings[index].frame == frame && (module_frame || table.position_free || table.bindings[index].symbol.span.start <= use_span.start) {
                return Val(index)
            }
            cursor -= 1
        }
        frame = table.frames[frame].parent
    }
    None
}

// The binding of `name` visible at `use_span`. Inside a body a binding is
// visible only after its declaration, except in a position-free table (a
// contract condition). Module-level bindings (the root frame:
// items and imports) are visible everywhere in the module, and an imported
// or staged symbol's span may come from another file, so position never
// hides them.
sema_scope_resolve_index_at: fn(table: SemaScopeTable, name: String, use_span: Span) -> Int? {
    if table.base_binding_count > 0 {
        hash: name_text_hash(name)
        local_slot: sema_scope_name_slot_hashed(table, name, hash)
        if table.lookup_counters == None {
            if local_slot == .Val(ls) {
                found: sema_scope_resolve_at_in_positions(table, table.name_positions[ls], use_span)
                if found != None -> return found
            }
            bs: sema_scope_name_slot_in(table.base_table[0].name_slots, table.base_table[0].name_positions, name, hash) ?? return None
            return sema_scope_resolve_at_in_positions(table, table.base_table[0].name_positions[bs], use_span)
        }
        base_slot: sema_scope_name_slot_in(table.base_table[0].name_slots, table.base_table[0].name_positions, name, hash)
        if local_slot == None {
            bs: base_slot ?? return sema_scope_counted(table, 0, None)
            if table.lookup_counters == None {
                return sema_scope_resolve_at_in_positions(table, table.base_table[0].name_positions[bs], use_span)
            }
            ^compares: 0
            pos_len: table.base_table[0].name_positions[bs].len()
            ^frame: table.current
            loop frame >= 0 {
                module_frame: table.frames[frame].parent < 0
                ^cursor: pos_len - 1
                loop cursor >= 0 {
                    compares += 1
                    index: table.base_table[0].name_positions[bs][cursor]
                    if table.bindings[index].frame == frame && (module_frame || table.position_free || table.bindings[index].symbol.span.start <= use_span.start) {
                        return sema_scope_counted(table, compares, Val(index))
                    }
                    cursor -= 1
                }
                frame = table.frames[frame].parent
            }
            return sema_scope_counted(table, compares, None)
        }
        if base_slot == None {
            if table.lookup_counters == None {
                return sema_scope_resolve_at_in_positions(table, table.name_positions[local_slot], use_span)
            }
            ^compares: 0
            pos_len: table.name_positions[local_slot].len()
            ^frame: table.current
            loop frame >= 0 {
                module_frame: table.frames[frame].parent < 0
                ^cursor: pos_len - 1
                loop cursor >= 0 {
                    compares += 1
                    index: table.name_positions[local_slot][cursor]
                    if table.bindings[index].frame == frame && (module_frame || table.position_free || table.bindings[index].symbol.span.start <= use_span.start) {
                        return sema_scope_counted(table, compares, Val(index))
                    }
                    cursor -= 1
                }
                frame = table.frames[frame].parent
            }
            return sema_scope_counted(table, compares, None)
        }
        local_len: table.name_positions[local_slot].len()
        base_len: table.base_table[0].name_positions[base_slot].len()
        if table.lookup_counters == None {
            ^frame: table.current
            loop frame >= 0 {
                module_frame: table.frames[frame].parent < 0
                ^cursor: local_len - 1
                loop cursor >= 0 {
                    index: table.name_positions[local_slot][cursor]
                    if table.bindings[index].frame == frame && (module_frame || table.position_free || table.bindings[index].symbol.span.start <= use_span.start) {
                        return Val(index)
                    }
                    cursor -= 1
                }
                ^b_cursor: base_len - 1
                loop b_cursor >= 0 {
                    index: table.base_table[0].name_positions[base_slot][b_cursor]
                    if table.bindings[index].frame == frame && (module_frame || table.position_free || table.bindings[index].symbol.span.start <= use_span.start) {
                        return Val(index)
                    }
                    b_cursor -= 1
                }
                frame = table.frames[frame].parent
            }
            return None
        }
        ^compares: 0
        ^frame: table.current
        loop frame >= 0 {
            module_frame: table.frames[frame].parent < 0
            ^cursor: local_len - 1
            loop cursor >= 0 {
                compares += 1
                index: table.name_positions[local_slot][cursor]
                if table.bindings[index].frame == frame && (module_frame || table.position_free || table.bindings[index].symbol.span.start <= use_span.start) {
                    return sema_scope_counted(table, compares, Val(index))
                }
                cursor -= 1
            }
            ^b_cursor: base_len - 1
            loop b_cursor >= 0 {
                compares += 1
                index: table.base_table[0].name_positions[base_slot][b_cursor]
                if table.bindings[index].frame == frame && (module_frame || table.position_free || table.bindings[index].symbol.span.start <= use_span.start) {
                    return sema_scope_counted(table, compares, Val(index))
                }
                b_cursor -= 1
            }
            frame = table.frames[frame].parent
        }
        return sema_scope_counted(table, compares, None)
    }
    slot: sema_scope_name_slot(table, name) ?? return sema_scope_counted(table, 0, None)
    if table.lookup_counters == None {
        return sema_scope_resolve_at_in_positions(table, table.name_positions[slot], use_span)
    }
    pos_len: table.name_positions[slot].len()
    ^compares: 0
    ^frame: table.current
    loop frame >= 0 {
        module_frame: table.frames[frame].parent < 0
        ^cursor: pos_len - 1
        loop cursor >= 0 {
            compares += 1
            index: table.name_positions[slot][cursor]
            // Read the row through its place: binding it copied the whole row
            // (its Symbol's Strings) for every candidate.
            if table.bindings[index].frame == frame && (module_frame || table.position_free || table.bindings[index].symbol.span.start <= use_span.start) {
                return sema_scope_counted(table, compares, Val(index))
            }
            cursor -= 1
        }
        frame = table.frames[frame].parent
    }
    sema_scope_counted(table, compares, None)
}

// The visible symbol of `name`, for its name, kind, identity and span. On a
// body thread a module function's symbol holds the empty function type
// (sema_scope_light_copy): read the signature with sema_scope_binding_type.
sema_scope_resolve: fn(table: SemaScopeTable, name: String) -> Symbol? {
    index: sema_scope_resolve_index(table, name) ?? return None
    Val(table.bindings[index].symbol)
}

// The key text of the binding `name` resolves to (SemaScopeBinding.key).
sema_scope_resolve_key: fn(table: SemaScopeTable, name: String) -> String? {
    index: sema_scope_resolve_index(table, name) ?? return None
    Val(table.bindings[index].key.copy())
}

// A body thread's own copy of the post-summary module scope `source` (the
// shared read-only module scope of a parallel body pass). The module's name
// index stays shared in `base_name_slots` / `base_name_positions` with zero
// copy, and each row's function type stays in `source` (read through
// `environment.module_scope` via sema_scope_binding_type).
sema_scope_light_copy: fn(source: SemaScopeTable) -> SemaScopeTable Never! {
    if source.base_binding_count > 0 && source.light_types.len() == source.bindings.len() {
        return SemaScopeTable{
            module_identity: source.module_identity,
            frames: source.frames,
            bindings: source.bindings,
            name_slots: source.name_slots,
            name_positions: source.name_positions,
            base_table: source.base_table,
            base_binding_count: source.base_binding_count,
            loop_labels: source.loop_labels,
            current: source.current,
            knowledge_gate: source.knowledge_gate,
            return_type: source.return_type,
            failure_carrier: source.failure_carrier,
            loop_depth: source.loop_depth,
            ownership_call_depth: source.ownership_call_depth,
            comptime_execution_depth: source.comptime_execution_depth,
            transaction_depth: source.transaction_depth,
            transaction_wall_depth: source.transaction_wall_depth,
            unit_explicit_units: source.unit_explicit_units,
            copies_explicit: source.copies_explicit,
            writes_explicit: source.writes_explicit,
            failures_explicit: source.failures_explicit,
            context_allocation: source.context_allocation,
            policy_modules: source.policy_modules,
            policy_rows: source.policy_rows,
            binding_undo: source.binding_undo,
            open_marks: source.open_marks,
            location_function: source.location_function,
            light_types: source.light_types,
            lookup_counters: source.lookup_counters,
            method_return_views: source.method_return_views,
        }
    }
    count: source.bindings.len()
    ^bindings: [SemaScopeBinding]{}
    ^light: [Bool]{}
    if count > 0 {
        bindings.try_reserve(count) ?? ()
        light.try_reserve(count) ?? ()
    }
    loop i in 0..<count {
        function_type: source.bindings[i].symbol.ty == .Val(.Fn(_, _, _, _, _, _))
        if function_type {
            bindings.push(
                SemaScopeBinding{
                    frame: source.bindings[i].frame,
                    // Every light row gets the empty function type without copying the real signature.
                    symbol: Symbol{id: source.bindings[i].symbol.id, kind: source.bindings[i].symbol.kind, name: source.bindings[i].symbol.name, module_identity: source.bindings[i].symbol.module_identity, owner: source.bindings[i].symbol.owner, span: source.bindings[i].symbol.span, ty: Val(sema_scope_light_function_type()), visibility: source.bindings[i].symbol.visibility},
                    key: source.bindings[i].key,
                    mutable: source.bindings[i].mutable,
                    access: source.bindings[i].access,
                    integer_bounds: source.bindings[i].integer_bounds,
                    string_view: source.bindings[i].string_view,
                    compiler_builtin: source.bindings[i].compiler_builtin,
                    prepared: source.bindings[i].prepared,
                    pending_prepared: source.bindings[i].pending_prepared,
                    origin: source.bindings[i].origin,
                    place_alias: source.bindings[i].place_alias,
                },
            )
        } else { bindings.push(source.bindings[i]) }
        light.push(function_type)
    }
    SemaScopeTable{
        module_identity: source.module_identity,
        frames: source.frames.copy(),
        bindings: bindings.move(),
        name_slots: if source.base_binding_count > 0 -> source.name_slots.copy() else -> name_table_sized(2),
        name_positions: if source.base_binding_count > 0 -> source.name_positions.copy() else -> [[Int]]{},
        base_table: if source.base_binding_count > 0 -> source.base_table else -> [SemaScopeTable]{source},
        base_binding_count: if source.base_binding_count > 0 -> source.base_binding_count else -> count,
        loop_labels: source.loop_labels.copy(),
        current: source.current,
        knowledge_gate: source.knowledge_gate,
        return_type: source.return_type,
        failure_carrier: source.failure_carrier,
        loop_depth: source.loop_depth,
        ownership_call_depth: source.ownership_call_depth,
        comptime_execution_depth: source.comptime_execution_depth,
        transaction_depth: source.transaction_depth,
        transaction_wall_depth: source.transaction_wall_depth,
        unit_explicit_units: source.unit_explicit_units,
        copies_explicit: source.copies_explicit,
        writes_explicit: source.writes_explicit,
        failures_explicit: source.failures_explicit,
        context_allocation: source.context_allocation,
        policy_modules: source.policy_modules,
        policy_rows: source.policy_rows,
        binding_undo: source.binding_undo.copy(),
        open_marks: source.open_marks,
        location_function: source.location_function,
        light_types: light.move(),
        lookup_counters: source.lookup_counters,
        method_return_views: source.method_return_views,
    }
}

// The function type a light row holds in place of its own
// (sema_scope_light_copy): no parameters, result, effects or metadata.
sema_scope_light_function_type: fn() -> Type Never! {
    Type.Fn{params: [Type]{}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
}

// True when row `index` of `table` left its type in the environment's
// module scope (sema_scope_light_copy).
sema_scope_binding_is_light: fn(table: SemaScopeTable, index: Int) -> Bool Never! {
    index < table.light_types.len() && table.light_types[index]
}

// The checked type of row `index`, wherever the row keeps it.
sema_scope_binding_type: fn(environment: SemaScopeEnvironment, table: SemaScopeTable, index: Int) -> Type? {
    if sema_scope_binding_is_light(table, index) {
        // The module scope is read in place; only the row's type leaves it.
        if environment.module_scope == .Val(source) -> return source.bindings[index].symbol.ty
        panic("a body thread read a module function type outside its parallel pass")
    }
    table.bindings[index].symbol.ty
}

// Row `index`'s symbol with its checked type.
sema_scope_binding_symbol: fn(environment: SemaScopeEnvironment, table: SemaScopeTable, index: Int) -> Symbol {
    if sema_scope_binding_is_light(table, index) {
        // The module scope is read in place; only the row's symbol leaves it.
        if environment.module_scope == .Val(source) -> return source.bindings[index].symbol
        panic("a body thread read a module function symbol outside its parallel pass")
    }
    table.bindings[index].symbol
}

// Row `index` with its checked type.
sema_scope_binding_row: fn(environment: SemaScopeEnvironment, table: SemaScopeTable, index: Int) -> SemaScopeBinding {
    // copy: the returned row may get its checked type filled in, while `table` is the caller's
    // scope table (a read parameter) and keeps its light row.
    ^row: table.bindings[index].copy()
    if sema_scope_binding_is_light(table, index) {
        row.symbol.ty = sema_scope_binding_type(environment, table, index)
    }
    row
}

// A write through `place` writes state that outlives the call unless its
// root is a cell the body built itself: it is recorded in
// `check.context.module_writes`. A module-level root (`STATE` in
// `STATE.rows[0].count`, or a module name before it) is module state by
// name. A parameter or local root (`self`, an alias, a loop name or a
// capture) may hold a module cell, so its write is recorded as `held`. Two
// roots are the body's to write: a `:` local bound to a new cell
// (SemaScopeBinding.own_cell), and a `^` parameter, whose caller lends the
// place for writing and sees the write in the signature.
sema_scope_record_module_write: fn(place: Expr, span: Span, check: ^SemaBodyCheck) {
    name: sema_scope_place_root(place) ?? return
    index: sema_scope_resolve_index(check.scopes, name) ?? return
    kind: check.scopes.bindings[index].symbol.kind
    if kind != SymbolKind.Parameter && kind != SymbolKind.Local {
        check.context.module_writes.push(TEffectSpan{name: name, span: span})
        return
    }
    if check.scopes.bindings[index].own_cell {
        return
    }
    if kind == SymbolKind.Parameter && check.scopes.bindings[index].access == AccessConvention.Write {
        // The `^` mark is what lends this write, so the write uses it (E0518).
        sema_ownership_note_binding_write(check.state, check.scopes.bindings[index])
        return
    }
    check.context.module_writes.push(TEffectSpan{name: name, span: span, held: true})
}

// A place lent to a `^` parameter: the callee's writes through it are not
// recorded (sema_scope_record_module_write), so the caller records a module
// root as its own write. A local or parameter it lends is its own to lend.
sema_scope_record_lent_write: fn(place: Expr, span: Span, check: ^SemaBodyCheck) {
    name: sema_scope_place_root(place) ?? return
    index: sema_scope_resolve_index(check.scopes, name) ?? return
    kind: check.scopes.bindings[index].symbol.kind
    if kind == SymbolKind.Parameter || kind == SymbolKind.Local {
        return
    }
    check.context.module_writes.push(TEffectSpan{name: name, span: span})
}

// Whether `symbol` is a module-level `^name: ...` binding (not `#run`),
// across either the current module's declarations or its registered module in
// the graph. Returns whether it is `#Persist`, or None for any other binding.
sema_scope_module_storage_binding: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, symbol: Symbol) -> Bool? Never! {
    if symbol.module_identity == environment.module_identity {
        loop declaration_index in 0..<environment.declarations.len() {
            if environment.declarations[declaration_index].symbol_id != symbol.id -> next
            if environment.declarations[declaration_index].item == .Const(definition) {
                if definition.mutable && !definition.is_comptime -> return Val(definition.is_persist)
            }
            return None
        }
    }
    graph: program.registration_graph
    module_index: sema_registration_module_index(graph, symbol.module_identity) ?? return None
    loop constant_index in 0..<graph.modules[module_index].constants.len() {
        if graph.modules[module_index].constants[constant_index].symbol.id != symbol.id -> next
        if graph.modules[module_index].constants[constant_index].declaration.mutable && !graph.modules[module_index].constants[constant_index].declaration.is_comptime {
            return Val(graph.modules[module_index].constants[constant_index].declaration.is_persist)
        }
        return None
    }
    None
}

// Whether `ty` is a module-level interior-mutable holder (`Shared`, `Cell`,
// `Atom`, or `Mutex`), unwrapping tags.
sema_scope_type_is_changeable_holder: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(_, inner) -> sema_scope_type_is_changeable_holder(inner)
        .Shared(_) -> true
        .Apply(name, _) -> name == "Cell" || name == "Atom" || name == "Mutex"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// A read of a module-level constant in a function body records in
// `context.module_reads` when the constant is changeable module state: a
// `^name: ...` / `#Persist ^name: ...` storage binding or a module-level
// `Shared` / `Cell` / `Atom` / `Mutex` holder.
sema_scope_record_module_constant_read: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, context: ^SemaCheckContext, symbol: Symbol, name: String, ty: Type, span: Span) Never! {
    if environment.function_name == "" -> return
    if sema_scope_module_storage_binding(environment, program, symbol) != None || sema_scope_type_is_changeable_holder(ty) {
        context.module_reads.push(TEffectSpan{name: name, span: span})
    }
}

// An initializer that builds a new cell: `Shared{…}` (optionally in `Val`)
// or `Cell.new(…)`.
sema_scope_own_cell_init: fn(init: Expr) -> Bool Never! {
    if sema_shared_cycle_cell_init(init) -> return true
    if init == .MethodCall(receiver, method, _, _, _, args, _) {
        if receiver == .Ident(name, _, _) {
            return name == "Cell" && method == "new" && args.len() == 1
        }
    }
    false
}

sema_scope_place_root: fn(place: Expr) -> String? Never! {
    if place == {
        .Ident(name, _, _) -> return Val(name)
        .Field(base, _, _, _) | .Index(base, _, _, _, _) | .Slice(base, _, _, _, _, _) -> return sema_scope_place_root(base)
        .Paren(inner, _, _) | .Place(inner, _, _, _) -> return sema_scope_place_root(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

// A false return leaves the old binding visible; this prevents a duplicate
// declaration from silently changing the meaning of later references.
sema_scope_declare_local: fn(table: ^SemaScopeTable, symbol: Symbol, key: String, mutable: Bool, access: AccessConvention, integer_bounds: TIntegerBounds?, string_view: Bool) -> Bool Never! {
    if symbol.name == "_" -> return true
    if sema_scope_has_loop_label(table, symbol.name) -> return false
    if sema_scope_resolve_index(table, symbol.name) == .Val(index) {
        previous: table.bindings[index].symbol
        if sema_scope_name_blocks_binding(previous.kind) -> return false
    }
    frame: table.current
    sema_scope_push_binding(table, SemaScopeBinding{frame: frame, symbol: symbol, key: key, mutable: mutable, access: access, integer_bounds: integer_bounds, string_view: string_view, compiler_builtin: false})
    true
}

// Marks the binding `name` as a place alias (see SemaScopeBinding.place_alias)
// after it is declared. A name that did not declare (`_`, a duplicate) has no
// row to mark.
sema_scope_mark_place_alias: fn(table: ^SemaScopeTable, name: String) Never! {
    index: sema_scope_resolve_index(table, name) ?? return
    table.bindings[index].place_alias = true
}

// Marks the binding `name` just declared as a loop item (see
// SemaScopeBinding.loop_item).
sema_scope_mark_loop_item: fn(table: ^SemaScopeTable, name: String) Never! {
    index: sema_scope_resolve_index(table, name) ?? return
    sema_scope_note_binding_edit(table, index)
    table.bindings[index].loop_item = true
}

// Keeps the element places a loop name over a parameter-owned collection
// reads (see SemaScopeBinding.element_places).
sema_scope_mark_element_places: fn(table: ^SemaScopeTable, name: String, places: ^^[SemaOwnershipPlace]) Never! {
    index: sema_scope_resolve_index(table, name) ?? return
    sema_scope_note_binding_edit(table, index)
    table.bindings[index].element_places = places.move()
}

// Marks the `:` binding `name` just declared as a window over one map value
// (see SemaScopeBinding.map_slot).
sema_scope_mark_map_slot: fn(table: ^SemaScopeTable, name: String) Never! {
    index: sema_scope_resolve_index(table, name) ?? return
    sema_scope_note_binding_edit(table, index)
    table.bindings[index].map_slot = true
}

// Keeps `init` on the `:` binding `name` just declared (see
// SemaScopeBinding.fresh_cell).
sema_scope_mark_fresh_cell: fn(table: ^SemaScopeTable, name: String, init: Expr) Never! {
    index: sema_scope_resolve_index(table, name) ?? return
    sema_scope_note_binding_edit(table, index)
    table.bindings[index].fresh_cell = Val(init)
}

// Keeps the rights of the `Authority` the binding `name` just declared holds
// (see SemaScopeBinding.authority_rights).
sema_scope_mark_authority_rights: fn(table: ^SemaScopeTable, name: String, rights: ^^SemaAuthorityRights) Never! {
    index: sema_scope_resolve_index(table, name) ?? return
    sema_scope_note_binding_edit(table, index)
    table.bindings[index].authority_rights = Val(rights)
}

// Marks the `:` binding `name` just declared as a cell the body built (see
// SemaScopeBinding.own_cell).
sema_scope_mark_own_cell: fn(table: ^SemaScopeTable, name: String) Never! {
    index: sema_scope_resolve_index(table, name) ?? return
    sema_scope_note_binding_edit(table, index)
    table.bindings[index].own_cell = true
}

// Keeps the effect facts of the lambda that `statement`, the `:` binding
// `name` just declared, binds (see SemaScopeBinding.lambda_effects).
sema_scope_mark_lambda_binding: fn(table: ^SemaScopeTable, name: String, statement: TStmt) Never! {
    if statement == .Let(_, _, init, _, _, _) {
        if init.kind == .Lambda(lambda) {
            index: sema_scope_resolve_index(table, name) ?? return
            sema_scope_note_binding_edit(table, index)
            // copy: the statement keeps its lambda; the binding keeps its own facts.
            table.bindings[index].lambda_effects = Val(lambda.effects.copy())
        }
    }
}

// The effect facts of the lambda that `callee`, the name a call goes
// through, runs, when it names a `:` local bound to a lambda written in this
// body.
sema_scope_local_lambda_effects: fn(table: SemaScopeTable, callee: Expr) -> TEffectFacts? Never! {
    if callee == .Ident(name, _, _) {
        index: sema_scope_resolve_index(table, name) ?? return None
        binding: table.bindings[index]
        if binding.mutable -> return None
        // copy: the binding keeps its facts for every later call.
        return binding.lambda_effects.copy()
    }
    None
}

// Keeps `literal` on the binding `name` just declared (see
// SemaScopeBinding.number_literal).
sema_scope_mark_number_literal: fn(table: ^SemaScopeTable, name: String, literal: ^^Expr?) Never! {
    index: sema_scope_resolve_index(table, name) ?? return
    sema_scope_note_binding_edit(table, index)
    table.bindings[index].number_literal = literal
}

// Keeps the literal magnitude of the unit value bound to `name` (see
// SemaScopeBinding.unit_magnitude).
sema_scope_mark_unit_magnitude: fn(table: ^SemaScopeTable, name: String, magnitude: Float) Never! {
    index: sema_scope_resolve_index(table, name) ?? return
    sema_scope_note_binding_edit(table, index)
    table.bindings[index].unit_magnitude = Val(magnitude)
}

// Keeps the ClosureInfo `info` on the binding `name` just declared (see
// SemaScopeBinding.closure).
sema_scope_mark_closure: fn(table: ^SemaScopeTable, name: String, info: ^^TComptimeValue) Never! {
    index: sema_scope_resolve_index(table, name) ?? return
    sema_scope_note_binding_edit(table, index)
    table.bindings[index].closure = Val(info)
}

// Keeps where the binding `name` just declared takes the changeable mark
// (see SemaScopeBinding.changeable_mark_at).
sema_scope_mark_changeable_mark_at: fn(table: ^SemaScopeTable, name: String, at: Span) Never! {
    index: sema_scope_resolve_index(table, name) ?? return
    sema_scope_note_binding_edit(table, index)
    table.bindings[index].changeable_mark_at = Val(at)
}

// A proven payload refines a stable Optional name for the rest
// of its scope. The refinement shadows the carrier binding on purpose, so it
// skips the duplicate-name rule that ordinary declarations obey.
sema_scope_refine_local: fn(table: ^SemaScopeTable, symbol: Symbol, key: String) Never! {
    frame: table.current
    sema_scope_push_binding(table, SemaScopeBinding{frame: frame, symbol: symbol, key: key, mutable: false, access: AccessConvention.Read, integer_bounds: None, string_view: false, compiler_builtin: false})
}

// Where sema_scope_resolve_declaration finds the declaration `id` names. A
// checker that needs one fact of a declaration reads it at its site through
// the readers below: copying the item copies a nominal's method bodies and
// trait implementations on every expression that names it.
SemaScopeDeclarationSite: enum {
    Function(module_index: Int, row: Int),
    Nominal(module_index: Int, row: Int),
    Local(index: Int),
}

sema_scope_declaration_site: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, id: SymbolID) -> SemaScopeDeclarationSite? {
    graph: program.registration_graph
    // The first function and nominal rows by key replace the module scan
    // (earlier modules first, functions before nominals in one module).
    ^function_module: -1
    ^function_row: -1
    if sema_registration_callable_row_of(graph, id) == .Val(callable) {
        if callable == .Function(module_index, row) {
            function_module = module_index
            function_row = row
        }
    }
    if graph.nominal_symbol_rows.get(id.id) == .Val(nominal) {
        if function_module < 0 || nominal.module_index < function_module {
            return Val(SemaScopeDeclarationSite.Nominal{module_index: nominal.module_index, row: nominal.row})
        }
    }
    if function_module >= 0 {
        return Val(SemaScopeDeclarationSite.Function{module_index: function_module, row: function_row})
    }
    loop index in 0..<environment.declarations.len() {
        if environment.declarations[index].symbol_id == id {
            return Val(SemaScopeDeclarationSite.Local{index: index})
        }
    }
    None
}

sema_scope_resolve_declaration: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, id: SymbolID) -> Item? {
    site: sema_scope_declaration_site(environment, program, id) ?? return None
    if site == .Local(index) -> return Val(environment.declarations[index].item)
    graph: program.registration_graph
    if site == .Function(module_index, row) {
        return Val(Item.Func{value: graph.modules[module_index].functions[row].declaration})
    }
    if site == .Nominal(module_index, row) {
        return sema_registration_nominal_source_item(graph.modules[module_index].nominals[row].source)
    }
    None
}

// The item variant of sema_scope_resolve_declaration(environment, program, id):
// an Item case, or `Other` for every item the scope does not tell apart. While
// the compiler builds, SEMA_SCOPE_DECLARATION_KIND_COUNT stops the build
// naming any other case Item lacks.
SemaScopeDeclarationKind: enum {
    Func,
    Struct,
    Enum,
    Distinct,
    Other,
}

SEMA_SCOPE_DECLARATION_KIND_COUNT: #run effect_vocabulary_view_count("Sema/Scopes.jet", embed_file("Scopes.jet"), "SemaScopeDeclarationKind", "AST/Items.jet", embed_file("toolchain:Compiler/JetFoundation/Source/AST/Items.jet"), "Item", [String]{"Other"})

sema_scope_item_kind: fn(item: Item) -> SemaScopeDeclarationKind Never! {
    if item == {
        .Func(_) -> SemaScopeDeclarationKind.Func
        .Struct(_) -> SemaScopeDeclarationKind.Struct
        .Enum(_) -> SemaScopeDeclarationKind.Enum
        .Distinct(_) -> SemaScopeDeclarationKind.Distinct
        .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> SemaScopeDeclarationKind.Other
    }
}

sema_scope_declaration_kind: fn(check: SemaBodyCheck, id: SymbolID) -> SemaScopeDeclarationKind? {
    site: sema_scope_declaration_site(check.environment.*, check.program.*, id) ?? return None
    if site == .Local(index) {
        return Val(sema_scope_item_kind(check.environment.declarations[index].item))
    }
    if site == .Function(_, _) -> return Val(SemaScopeDeclarationKind.Func)
    if site == .Nominal(module_index, row) {
        graph: check.program.registration_graph
        return sema_scope_nominal_kind(graph, module_index, row)
    }
    None
}

// The nominal rows below are read through the graph as a read parameter:
// binding a row copied the whole declaration, methods included.
sema_scope_nominal_kind: fn(graph: SemaRegistrationGraph, module_index: Int, row: Int) -> SemaScopeDeclarationKind? {
    if graph.modules[module_index].nominals[row].source == .SourceAST(item) {
        return Val(sema_scope_item_kind(item))
    }
    None
}

sema_scope_declaration_is: fn(check: SemaBodyCheck, id: SymbolID, kind: SemaScopeDeclarationKind) -> Bool {
    found: sema_scope_declaration_kind(check, id) ?? return false
    found == kind
}

// A struct declaration's type parameters and fields, without its methods, and
// the inline module that declared it (StructDef.inline_module).
SemaScopeStructShape: struct {
    type_params: [TypeParam],
    fields: [Field],
    inline_module: Span?,
}

sema_scope_item_struct: fn(item: Item) -> SemaScopeStructShape? {
    // copy: the shape is the caller's own; the declaration stays in the program.
    if item == .Struct(definition) {
        return Val(SemaScopeStructShape{type_params: definition.type_params.copy(), fields: definition.fields.copy(), inline_module: definition.inline_module})
    }
    None
}

// The struct shape when sema_scope_resolve_declaration(environment, id) is a struct.
sema_scope_declaration_struct: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, id: SymbolID) -> SemaScopeStructShape? {
    site: sema_scope_declaration_site(environment, program, id) ?? return None
    if site == .Local(index) -> return sema_scope_item_struct(environment.declarations[index].item)
    if site == .Nominal(module_index, row) {
        graph: program.registration_graph
        return sema_scope_nominal_struct(graph, module_index, row)
    }
    None
}

// The nominal row is read through the graph as a read parameter: binding the
// row copied the whole declaration, methods included, on every field read.
sema_scope_nominal_struct: fn(graph: SemaRegistrationGraph, module_index: Int, row: Int) -> SemaScopeStructShape? {
    if graph.modules[module_index].nominals[row].source == .SourceAST(item) {
        return sema_scope_item_struct(item)
    }
    None
}

// The labels of a struct declaration's `state { … }` section (empty when it
// has none); none when sema_scope_resolve_declaration(environment, id) is not
// a struct.
sema_scope_declaration_struct_states: fn(check: SemaBodyCheck, id: SymbolID) -> [String]? {
    site: sema_scope_declaration_site(check.environment.*, check.program.*, id) ?? return None
    if site == .Local(index) {
        return sema_scope_item_struct_states(check.environment.declarations[index].item)
    }
    if site == .Nominal(module_index, row) {
        graph: check.program.registration_graph
        if graph.modules[module_index].nominals[row].source == .SourceAST(item) {
            return sema_scope_item_struct_states(item)
        }
    }
    None
}

sema_scope_item_struct_states: fn(item: Item) -> [String]? {
    if item == .Struct(definition) {
        declared: definition.state ?? return Val([String]{})
        labels: loop member in declared.states -> member.name
        return Val(labels)
    }
    None
}

// An enum declaration's type parameters, variants and variant groups, without
// its methods.
SemaScopeEnumShape: struct {
    type_params: [TypeParam],
    variants: [Variant],
    groups: [EnumGroup],
}

sema_scope_item_enum: fn(item: Item) -> SemaScopeEnumShape? {
    if item == .Enum(definition) {
        return Val(SemaScopeEnumShape{type_params: definition.type_params, variants: definition.variants, groups: definition.groups})
    }
    None
}

// The enum shape when sema_scope_resolve_declaration(environment, id) is an enum.
sema_scope_declaration_enum: fn(check: SemaBodyCheck, id: SymbolID) -> SemaScopeEnumShape? {
    site: sema_scope_declaration_site(check.environment.*, check.program.*, id) ?? return None
    if site == .Local(index) {
        return sema_scope_item_enum(check.environment.declarations[index].item)
    }
    if site == .Nominal(module_index, row) {
        graph: check.program.registration_graph
        return sema_scope_nominal_enum(graph, module_index, row)
    }
    None
}

sema_scope_nominal_enum: fn(graph: SemaRegistrationGraph, module_index: Int, row: Int) -> SemaScopeEnumShape? {
    if graph.modules[module_index].nominals[row].source == .SourceAST(item) {
        return sema_scope_item_enum(item)
    }
    None
}

sema_scope_item_enum_declares: fn(item: Item, variant: String) -> Bool Never! {
    if item == .Enum(definition) {
        loop candidate in definition.variants {
            if candidate.name == variant -> return true
        }
    }
    false
}

// sema_scope_resolve_declaration(environment, id) is an enum declaring `variant`.
sema_scope_declaration_enum_declares: fn(check: SemaBodyCheck, id: SymbolID, variant: String) -> Bool {
    site: sema_scope_declaration_site(check.environment.*, check.program.*, id) ?? return false
    if site == .Local(index) {
        return sema_scope_item_enum_declares(check.environment.declarations[index].item, variant)
    }
    if site == .Nominal(module_index, row) {
        graph: check.program.registration_graph
        return sema_scope_nominal_enum_declares(graph, module_index, row, variant)
    }
    false
}

sema_scope_nominal_enum_declares: fn(graph: SemaRegistrationGraph, module_index: Int, row: Int, variant: String) -> Bool Never! {
    if graph.modules[module_index].nominals[row].source == .SourceAST(item) {
        return sema_scope_item_enum_declares(item, variant)
    }
    false
}

sema_scope_item_distinct: fn(item: Item) -> DistinctDef? {
    // copy: `definition` is a payload of read parameter `item`, which keeps the original; the Val carrier owns this one
    if item == .Distinct(definition) -> return Val(definition.copy())
    None
}

// The declaration when sema_scope_resolve_declaration(environment, id) is a
// distinct type; a distinct declaration has no methods to leave behind.
sema_scope_declaration_distinct: fn(check: SemaBodyCheck, id: SymbolID) -> DistinctDef? {
    site: sema_scope_declaration_site(check.environment.*, check.program.*, id) ?? return None
    if site == .Local(index) {
        return sema_scope_item_distinct(check.environment.declarations[index].item)
    }
    if site == .Nominal(module_index, row) {
        graph: check.program.registration_graph
        return sema_scope_nominal_distinct(graph, module_index, row)
    }
    None
}

sema_scope_nominal_distinct: fn(graph: SemaRegistrationGraph, module_index: Int, row: Int) -> DistinctDef? {
    if graph.modules[module_index].nominals[row].source == .SourceAST(item) {
        return sema_scope_item_distinct(item)
    }
    None
}

sema_scope_item_function_type_params: fn(item: Item) -> [TypeParam] Never! {
    if item == .Func(func) -> return func.type_params
    [TypeParam]{}
}

// The type parameters when sema_scope_resolve_declaration(environment, id) is
// a function, else none; the function's body is never copied.
sema_scope_declaration_function_type_params: fn(check: SemaBodyCheck, id: SymbolID) -> [TypeParam] {
    site: sema_scope_declaration_site(check.environment.*, check.program.*, id) ?? return [TypeParam]{}
    if site == .Local(index) {
        return sema_scope_item_function_type_params(check.environment.declarations[index].item)
    }
    graph: check.program.registration_graph
    if site == .Function(module_index, row) {
        return graph.modules[module_index].functions[row].declaration.type_params
    }
    if site == .Nominal(module_index, row) {
        return sema_scope_nominal_function_type_params(graph, module_index, row)
    }
    [TypeParam]{}
}

sema_scope_nominal_function_type_params: fn(graph: SemaRegistrationGraph, module_index: Int, row: Int) -> [TypeParam] Never! {
    if graph.modules[module_index].nominals[row].source == .SourceAST(item) {
        return sema_scope_item_function_type_params(item)
    }
    [TypeParam]{}
}

// The parameters when sema_scope_declaration_site(environment, program, id)
// is a function, else none. A function with a `^` or `^^` parameter is a
// value only where a function type marks the same parameters.
sema_scope_declaration_function_params: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, id: SymbolID) -> [Param]? {
    site: sema_scope_declaration_site(environment, program, id) ?? return None
    if site == .Local(index) {
        if environment.declarations[index].item == .Func(func) -> return Val(func.params.copy())
        return None
    }
    graph: program.registration_graph
    if site == .Function(module_index, row) {
        return Val(graph.modules[module_index].functions[row].declaration.params.copy())
    }
    None
}

sema_scope_first_marked_param: fn(params: [Param]) -> Param? Never! {
    loop param in params {
        if param.convention != AccessConvention.Read -> return Val(param)
    }
    None
}
