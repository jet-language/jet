}

pub enum SemaLoopValueKind {
    Effect
    Collecting
    Result
}

pub struct SemaLoopValueFrame {
    pub label: String?
    pub kind: SemaLoopValueKind
    pub ty: Type?
}

pub struct SemaPendingLoopValue {
    pub label: String?
    pub kind: SemaLoopValueKind
    pub ty: Type?
}

pub struct SemaLoopBreakFlows {
    pub paths: [SemaOwnershipState]
}

pub fn sema_loop_value_kind_effect() -> SemaLoopValueKind Never! {
    SemaLoopValueKind.Effect
}

pub fn sema_loop_value_kind_collecting() -> SemaLoopValueKind Never! {
    SemaLoopValueKind.Collecting
}

pub fn sema_loop_value_kind_result() -> SemaLoopValueKind Never! {
    SemaLoopValueKind.Result
}

pub fn sema_loop_value_set_pending(context: &SemaCheckContext, kind: SemaLoopValueKind, label: String?) Never! {
    context.pending_loop_value = Val(SemaPendingLoopValue{kind: kind, label: label, ty: None})
}

pub fn sema_loop_value_set_pending_type(context: &SemaCheckContext, kind: SemaLoopValueKind, label: String?, ty: Type?) Never! {
    context.pending_loop_value = Val(SemaPendingLoopValue{kind: kind, label: label, ty: ty})
}

pub fn sema_loop_value_push_frame(context: &SemaCheckContext, label: String?) Never! {
    pending := context.pending_loop_value
    context.pending_loop_value = None
    kind := SemaLoopValueKind.Effect
    resolved_label := label
    result_type := Type?{None}
    if pending == .Val(value) {
        kind = value.kind
        if value.label != None -> resolved_label = value.label
        result_type = value.ty
    }
    &context.loop_value_frames.push(SemaLoopValueFrame{kind: kind, label: resolved_label, ty: result_type})
    &context.loop_break_flows.push(SemaLoopBreakFlows{paths: [SemaOwnershipState]{}})
}

pub fn sema_loop_value_pop_frame(context: &SemaCheckContext) Never! {
    if context.loop_value_frames.len() == 0 -> return
    frame :: &context.loop_value_frames.pop() ?? return
    if context.loop_break_flows.len() > 0 -> _ := &context.loop_break_flows.pop()
    if frame.kind == SemaLoopValueKind.Result -> context.last_loop_result_type = frame.ty
}

pub fn sema_loop_value_resolve_frame(context: SemaCheckContext, label: String?) -> Int? {
    index := context.loop_value_frames.len() - 1
    if label != None {
        loop index >= 0 {
            if context.loop_value_frames[index].label == label -> return Val(index)
            index -= 1
        }
        return None
    }
    if index >= 0 -> return Val(index)
    None
}

pub fn sema_loop_value_record_break(context: &SemaCheckContext, frame_index: Int, state: SemaOwnershipState) Never! {
    if frame_index < 0 || frame_index >= context.loop_break_flows.len() -> return
    &context.loop_break_flows[frame_index].paths.push(sema_ownership_state_snapshot(state))
}

pub fn sema_loop_value_set_result_type(context: &SemaCheckContext, frame_index: Int, ty: Type) Never! {
    if frame_index < 0 || frame_index >= context.loop_value_frames.len() -> return
    context.loop_value_frames[frame_index].ty = Val(ty)
}

pub fn sema_loop_value_result_type(context: SemaCheckContext, frame_index: Int) -> Type? {
    if frame_index < 0 || frame_index >= context.loop_value_frames.len() -> return None
    context.loop_value_frames[frame_index].ty
}

pub fn sema_loop_value_break_flows(context: SemaCheckContext, frame_index: Int) -> [SemaOwnershipState] Never! {
    if frame_index < 0 || frame_index >= context.loop_break_flows.len() -> return [SemaOwnershipState]{}
    context.loop_break_flows[frame_index].paths
}

pub fn sema_loop_value_push_collecting_type(context: &SemaCheckContext) Never! {
    &context.collect_item_types.push(None)
}

pub fn sema_loop_value_pop_collecting_type(context: &SemaCheckContext) -> Type? {
    if context.collect_item_types.len() == 0 -> return None
    &context.collect_item_types.pop() ?? None
}

pub fn sema_loop_value_collecting_type(context: SemaCheckContext) -> Type? {
    if context.collect_item_types.len() == 0 -> return None
    context.collect_item_types[context.collect_item_types.len() - 1]
}

pub fn sema_loop_value_set_collecting_type(context: &SemaCheckContext, ty: Type) Never! {
    if context.collect_item_types.len() == 0 -> return
    context.collect_item_types[context.collect_item_types.len() - 1] = Val(ty)
}

pub fn sema_loop_value_append_collecting_item_type(context: &SemaCheckContext, ty: Type, span: Span, environment: SemaScopeEnvironment, diagnostics: &[Diagnostic]) -> Bool {
    if ty == (Type.Named{name: "Unit"}) {
        &diagnostics.push(sema_error("E0073", span, "this collecting loop path produces no item", "every accepted iteration must contribute one non-unit value unless `next` omits it", "return a value on this path, or remove `->`"))
        return false
    }
    existing :: sema_loop_value_collecting_type(context)
    if existing == None {
        sema_loop_value_set_collecting_type(&context, ty)
        return true
    }
    expected :: existing
    if type_identity_equal(expected, ty) -> return true
    joined :: sema_expr_numeric_join(expected, ty) ?? {
        &diagnostics.push(sema_error("E0074", span, "this collecting loop produces incompatible item types", "one collecting loop builds one List, but this item is {type_name(ty)} instead of {type_name(expected)}", "convert every item to one type, or split the loops"))
        return false
    }
    sema_loop_value_set_collecting_type(&context, joined)
    true
}

pub struct SemaScopeLoopLabel {
    pub name: String
}

pub struct SemaStatementTailBody {
    pub statements: [Stmt]
}

pub struct SemaStatementTailStore {
    pub bodies: [SemaStatementTailBody]
}

pub struct SemaStatementTailFrame {
    pub body_id: Int
    pub start_index: Int
}

pub fn sema_statement_tail_store_init() -> SemaStatementTailStore Never! {
    SemaStatementTailStore{bodies: [SemaStatementTailBody]{}}
}

pub fn sema_statement_tail_store_add_body(store: &SemaStatementTailStore, statements: [Stmt]) -> Int Never! {
    body_id := store.bodies.len()
    &store.bodies.push(SemaStatementTailBody{statements: statements})
    body_id
}

