    pub module_identity: String
    pub key: String
    pub type_name: String
    pub source_file: String
    pub source_expression: Expr
    pub expression: TExpr
    pub hardware_use: MIRTargetHardwareUse
    pub reachable_function_keys: [String]
    pub dependencies: [String]
    pub span: Span
}

