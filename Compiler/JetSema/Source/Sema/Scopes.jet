}

pub struct SemaScopeEnvironment {
    pub registration_graph: SemaRegistrationGraph?
    pub module_identity: String
    pub package_identity: String
    pub module_name: String
    pub source_file: String
    pub source_origin: SemaSourceOrigin
    pub source_segments: [SemaSourceSegment]
    pub checked_types: [TTypeDef]
    // Rust `Checker::types` (keyed registry): `checked_types` rows by
    // "{module_identity}::{name}" (first row), and every row of a bare name
    // in order (`checked_type_name_slots` -> `checked_type_name_rows`).
    pub checked_type_rows: [String:Int]{[String:Int]{}}
    pub checked_type_name_slots: [String:Int]{[String:Int]{}}
    pub checked_type_name_rows: [[Int]]{[[Int]]{}}
    // `sema_checked_program_boxed_edges(registration_graph)`: nominal SymbolId
    // key -> its boxed recursive-layout keys, computed once per environment.
    pub boxed_edges: [String:[String]]{[String:[String]]{}}
    pub declarations: [SemaScopeDeclaration]
    pub generic_params: [TGenericParam]
    pub comptime_body_values: [SemaComptimeBodyValue]
    // L0303 (#3716): the module's dispatch-table `else` arms, from the parser.
    pub else_arms: [ElseArmSpan]{[ElseArmSpan]{}}
    // D-SHAPE-PLACE1=A: the module's proven length-preserving list write
    // parameters, copied into each function's ownership state.
    pub fixed_length_write_params: [String]{[String]{}}
    // D-DBG1=A: the module's `debug(…)` call texts, from the parser.
    pub debug_sites: [DebugTraceSite]{[DebugTraceSite]{}}
    // The enclosing named callable being checked; panic and propagation
    // locations name it (Rust `capture_panic_loc` `fn_name`).
    pub function_name: String{""}
}

// The declaration scope of one module for compile-time probes (dependency
// probes, item checks, function checks): sema_registration_apply_graph_module
// runs once into `table` instead of once per probe, and each probe checks
// inside a mark and rolls back (sema_comptime_probe_prepare). The probing
// environment's graph changes only by staged values
// (sema_comptime_graph_apply_values), which type waiting constants and nothing
// else, so `constants` names the only bindings a rebuilt table could differ
// in, and where their graph rows live.
pub struct SemaScopeProbe {
    pub module_identity: String
    pub table: SemaScopeTable
    // sema_registration_apply_graph_module's result and its diagnostics.
    pub applied: Bool
    pub diagnostics: [Diagnostic]
    pub constants: [SemaScopeProbeConstant]
}

// A module-scope binding whose symbol is a constant still waiting for its
// known-time type (sema_comptime_symbol_waits), and its graph row.
pub struct SemaScopeProbeConstant {
    pub binding: Int
    pub source: SemaScopeProbeSource
}

pub enum SemaScopeProbeSource {
    Symbol(position: Int)
    Import(import_index: Int, binding: Int)
}
 
pub struct SemaCheckContext {
    pub exact_int_reachable: Bool
    pub unsafe_depth: Int
    pub borrow_ctx: Bool
    pub allow_string_view_read: Bool
    // Rust `suppress_partial_move_root_read`: the expression being checked
    // is the base of a deeper place (`state` in `state.x`, `&s`, `s.x = v`)
    // whose complete place the caller checks, so a bare name read here
    // answers only for a move of the whole name.
    pub suppress_partial_move_root_read: Bool
    pub allow_fixed_constructor: Bool
    pub generic_params: [TGenericParam]
    pub lambda_escapes: Bool?
    pub lambda_statement_tails: [SemaStatementTailFrame]
    pub call_facts: [SemaCallSiteFact]
    pub hardware_use: MIRTargetHardwareUse
    pub call_return_views: [SemaCallReturnView]
    pub local_view_provenance: [SemaLocalViewProvenance]
    pub return_view_receiver_key: String
    pub return_view_parameter_keys: [String]
    pub return_view_provenance: ViewProvenanceMap?
    pub name_references: [SemaNameReferenceFact]
    pub comptime_requests: [SemaComptimeRequest]
    pub comptime_body_sources: [SemaComptimeBodySource]
    pub comptime_body_values: [SemaComptimeBodyValue]
    pub compute_calls: [SemaComputeCallFact]
    pub autodiff_obligations: [SemaAutodiffObligation]
    pub autodiff_safe_panic: Bool
    pub autodiff_unsafe_panic: Bool
    pub autodiff_safe_panic_context: Bool
    pub copy_events: [SemaCopyEvent]
    pub loop_value_frames: [SemaLoopValueFrame]
    pub loop_break_flows: [SemaLoopBreakFlows]
    pub pending_loop_value: SemaPendingLoopValue?
    pub collect_item_types: [Type?]
    pub last_loop_result_type: Type?
    pub arrow_loop_body: Bool
    pub reactive_upgrades: [String]
    pub reactive_upgrade_names: [String]
    pub reactive_local_keys: [String]
    pub reactive_shared_keys: [String]
    pub taskgroups: SemaTaskGroupState
    // D-FAILURE-FOUNDATION1=A: `failure_carrier_root` is the one-shot token a
    // carrier consumer (`??`, `?`, an `.Ok`/`.Err` pattern) sets so its call
    // subject keeps the Result carrier; `failure_success_view` tells the call
    // being checked that its expectation describes the success value.
    pub failure_carrier_root: Bool
    pub failure_success_view: Bool
    // An open callback (no written or expected return) adopts the carrier of
    // its first propagated call, as the Rust reference's callback inference.
    pub failure_inference: Bool
    pub inferred_failure_carrier: TFailureCarrier?
    // The enclosing callable's written failure contract, for E2404 provenance.
    pub failure_contract_source: String
    // The enclosing named callable, for the D-NEVER2 return verdicts.
    pub function_name: String
    // E0408/E0409: a fallback with no failure report to name (`??` on an
    // optional, or a pure pattern miss) denies `err` with this code.
    pub fallback_err_denial: String?
    // Source starts of else-less value dispatch chains already proved (E0307);
    // every level of one chain shares its span, and the outermost level wins.
    pub noelse_chain_starts: [Int]
    // D-DISCARD1=A: the last statement of a named function with no written
    // return type; a non-Unit value there is thrown away (E0433).
    pub lost_tail_span: Span?
    // D-DISCARD1=A / #3886: the last statement of a named function with a
    // written value return; it is checked as the value the function hands back.
    pub value_tail_span: Span?
    // #3708: the function keys whose failures this body propagates; "" marks a
    // failure source of its own (`Err`, a propagated non-call, a propagating
    // callback). Callback bodies add their rows too, as the Rust body walk does.
    pub failure_edges: [String]
    // #3708: a direct failure source outside callbacks (a fallible value
    // returned as-is, or a statement that owns its own failure route).
    pub failure_direct_source: Bool
    // D-FAIL-INFER-UNION1=A / D-ERR-CASES1=A: what reaches this body's default
    // `Err` route outside callbacks: typed failures (made here or passed up
    // from a callee with a written contract), function-owned cases
    // (`Err(.NotFound(n))`), the unannotated callees whose failures pass up,
    // and whether the general `Err` reaches it. The bundle failure-union
    // solve joins these rows (FailureUnion.jet).
    pub failure_union_members: [Type]{[Type]{}}
    pub failure_union_cases: [SemaFailureCase]{[SemaFailureCase]{}}
    pub failure_union_edges: [String]{[String]{}}
    pub failure_union_general: Bool{false}
    // Rust `iter_borrowed` (E0507): the collections an active `loop x in xs`
    // reads across its body, so a change to one of them there is rejected.
    pub iter_borrowed: [String]{[String]{}}
    // D-RANGETYPE1 (E0136): a binding's initializer is being checked, so a
    // propagating runtime range conversion inside it is reported there.
    pub binding_initializer: Bool{false}
    // D-COMPILE-STACK1=A (E1403): source forms being checked right now, one per
    // statement and per expression level, against the limit the parser and
    // the TIR evaluator share.
    pub source_nesting: Int{0}
    // D-LOOP-SUBJECT1=A: active bindingless collecting-loop subjects, where a
    // bare `.member` chain reads the implicit `it`.
    pub implicit_loop_subject_depth: Int{0}
    // D-SUBJECT-COHERE1=A: active subject-shorthand lambda scopes (L0512).
    pub subject_shorthand_depth: Int{0}
    // Why this body stopped without a diagnostic: a construct the checker
    // does not handle yet or a lost compiler invariant. These reach the
    // driver's internal-problem report (I2), never the user's diagnostics.
    pub incomplete_reasons: [String]{[String]{}}
}

 

pub struct SemaScopeModulePolicy {
    pub unit_explicit_units: Bool
    pub copies_explicit: Bool
    // Split the exact span key into scalar indexes, without formatting it.
    pub function_unit_starts: [Int:Int]
    pub function_unit_ends: [[Int:Bool]]
}

pub struct SemaScopeTable {
    pub frames: [SemaScopeFrame]
    pub bindings: [SemaScopeBinding]
    // Binding positions per name, ascending: `name_slots` maps a name to its
    // row in `name_positions`. Every push goes through
    // sema_scope_push_binding, so name resolution never rescans `bindings`.
    pub name_slots: [String:Int]
    pub name_positions: [[Int]]
    pub loop_labels: [SemaScopeLoopLabel]
    pub hardware_transfers: [SemaHardwareDMATransferFact]
    pub hardware_definite_transfers: [SemaHardwareDMATransferFact]
    pub hardware_pending_transfers: [SemaHardwareDMATransferFact]
    pub current: Int
    pub return_type: Type?
    pub failure_carrier: TFailureCarrier?
    pub knowledge_gate: SemaKnowledgeGate?
    pub loop_depth: Int
    pub ownership_call_depth: Int
    pub comptime_execution_depth: Int
    pub transaction_depth: Int
    pub transaction_wall_depth: Int
    pub unit_explicit_units: Bool
    // D-MEM-COPYSEM1: `copies: .Explicit` is active for the function being
    // checked (package, module, or function scope).
    pub copies_explicit: Bool{false}
    // Derived from the immutable graph installed by seed_unit_policy.
    // Function rollback leaves this memo intact; snapshots may rebuild it.
    // A new graph/module setup reseeds it, including each staging version.
    pub policy_modules: [String:Int]{[String:Int]{}}
    pub policy_rows: [SemaScopeModulePolicy]{[SemaScopeModulePolicy]{}}
    // Rollback support (sema_scope_mark / sema_scope_rollback): while a mark
    // is open, an in-place edit of an existing binding first records the old
    // row here, so a rollback restores the table without a whole-table copy.
    pub binding_undo: [SemaScopeBindingUndo]{[SemaScopeBindingUndo]{}}
    pub open_marks: Int{0}
}

pub struct SemaScopeBindingUndo {
    pub index: Int
    pub binding: SemaScopeBinding
}

// A rollback point: the table's row counts plus a copy of its small fields.
// `saved` holds no frames, bindings or name rows.
pub struct SemaScopeMark {
    pub frames: Int
    pub bindings: Int
    pub undo: Int
    pub saved: SemaScopeTable
}

// The hardware transfer facts of one path, joined at a control-flow merge.
pub struct SemaScopeHardwareFacts {
    pub transfers: [SemaHardwareDMATransferFact]
    pub definite: [SemaHardwareDMATransferFact]
    pub pending: [SemaHardwareDMATransferFact]
}

// The environment owns the registration graph it is given: callers hand over
// one copy rather than a read value the constructor would copy again.
pub fn sema_scope_environment_init(graph: ^SemaRegistrationGraph?, module_identity: String, package_identity: String, module_name: String, source_file: String, source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment], checked_types: [TTypeDef], declarations: [SemaScopeDeclaration]) -> SemaScopeEnvironment Never! {
    rows := [String:Int]{}
    name_slots := [String:Int]{}
    name_rows := [[Int]]{}
    loop (index, definition) in checked_types {
        key :: "{definition.module_identity}::{definition.name}"
        if rows.get(key) == None -> rows[key] = index
        if name_slots.get(definition.name) == .Val(slot) {
            &name_rows[slot].push(index)
        } else {
            name_slots[definition.name] = name_rows.len()
            &name_rows.push([Int]{index})
        }
    }
    boxed_edges := sema_scope_environment_boxed_edges(graph)
    SemaScopeEnvironment{
        registration_graph: graph,
        module_identity: module_identity,
        package_identity: package_identity,
        module_name: module_name,
        source_file: source_file,
        source_origin: source_origin,
        source_segments: source_segments,
        checked_types: checked_types,
        checked_type_rows: rows,
        checked_type_name_slots: name_slots,
        checked_type_name_rows: name_rows,
        boxed_edges: boxed_edges,
        declarations: declarations,
        generic_params: [TGenericParam]{},
        comptime_body_values: [SemaComptimeBodyValue]{},
    }
}

// The boxed field edges of `graph`, read in place: matching the owned graph
// parameter against `.Val(…)` would copy the whole graph first.
fn sema_scope_environment_boxed_edges(graph: SemaRegistrationGraph?) -> [String:[String]] Never! {
    value :: graph ?? return [String:[String]]{}
    sema_checked_program_boxed_edges(value)
}

// The first checked declaration of `name` owned by `module_identity`.
pub fn sema_scope_checked_type_row(environment: SemaScopeEnvironment, module_identity: String, name: String) -> Int? {
    environment.checked_type_rows.get("{module_identity}::{name}")
}

// Every checked declaration row named `name`, in declaration order.
pub fn sema_scope_checked_type_name_rows(environment: SemaScopeEnvironment, name: String) -> [Int] {
    slot :: environment.checked_type_name_slots.get(name) ?? return [Int]{}
    environment.checked_type_name_rows[slot]
}

// One environment serves every module of a graph pass: the registration
// graph, checked types and write-parameter facts stay, and the module's own
// source facts replace the previous module's.
pub fn sema_scope_environment_enter_module(environment: &SemaScopeEnvironment, module_row: SemaRegistrationModule, comptime_body_values: [SemaComptimeBodyValue]) Never! {
    environment.module_identity = module_row.module_identity
    environment.package_identity = module_row.package_identity
    environment.module_name = module_row.module_name
    environment.source_file = module_row.source_file
    environment.source_origin = module_row.source_origin
    environment.source_segments = module_row.source_segments
    environment.declarations = [SemaScopeDeclaration]{}
    environment.generic_params = [TGenericParam]{}
    environment.comptime_body_values = comptime_body_values
    environment.else_arms = module_row.program.else_arms
    environment.debug_sites = module_row.program.debug_sites
    environment.function_name = ""
}

// A comptime probe checks one expression or function of `module_identity`
// against the environment's own graph, so one environment serves every
// probe of a pass instead of a graph copy per probe. The module's identity
// and source facts replace the previous target's; every other per-module or
// per-function fact starts empty, as in a newly built probe environment.
// False when the graph has no such module.
pub fn sema_scope_environment_enter_probe_module(environment: &SemaScopeEnvironment, module_identity: String, comptime_body_values: [SemaComptimeBodyValue]) -> Bool Never! {
    if environment.registration_graph == .Val(graph) {
        module_index :: sema_registration_module_index(graph, module_identity) ?? return false
        environment.module_identity = graph.modules[module_index].module_identity
        environment.package_identity = graph.modules[module_index].package_identity
        environment.module_name = graph.modules[module_index].module_name
        environment.source_file = graph.modules[module_index].source_file
        environment.source_origin = graph.modules[module_index].source_origin
        environment.source_segments = graph.modules[module_index].source_segments
        environment.declarations = [SemaScopeDeclaration]{}
        environment.generic_params = [TGenericParam]{}
        environment.comptime_body_values = comptime_body_values
        environment.else_arms = [ElseArmSpan]{}
        environment.debug_sites = [DebugTraceSite]{}
        environment.function_name = ""
        return true
    }
    false
}

pub fn sema_scope_environment_boxed_edge(environment: SemaScopeEnvironment, owner: SymbolID, edge: String) -> Bool Never! {
    if environment.registration_graph == .Val(graph) {
        row :: sema_type_graph_nominal_row(graph, owner.key) ?? return false
        module_identity :: graph.modules[row.module_index].module_identity
        if sema_scope_checked_type_row(environment, module_identity, graph.modules[row.module_index].nominals[row.row].symbol.name) == .Val(checked_row) -> return sema_checked_type_has_boxed_edge(environment.checked_types[checked_row], edge)
        // Matched in place: a pattern on the indexed path copies the whole item.
        nominal :: graph.modules[row.module_index].nominals[row.row]
        if nominal.source == .SourceAST(definition) {
            return sema_checked_boxed_edges(graph, environment.boxed_edges, module_identity, definition).contains(edge)
        }
    }
    false
}

pub fn sema_loop_break_flows_snapshot(source: [SemaLoopBreakFlows]) -> [SemaLoopBreakFlows] Never! {
    result := [SemaLoopBreakFlows]{}
    loop frame in source {
        paths := [SemaOwnershipState]{}
        loop path in frame.paths -> &paths.push(sema_ownership_state_snapshot(path))
        &result.push(SemaLoopBreakFlows{paths: paths})
    }
    result
}

