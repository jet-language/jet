// The memory fact projection. These rows are retained by the same Sema solve
// that checks E0921; consumers must never repeat the analysis.
use jet_foundation.[Span, EffectRowEntry]

SemaMemoryProjection: enum {
    Proven,
    Violated(call_path: [String], operation: String),
    OpenWorld(call_path: [String], reason: String),
}

SemaMemoryFactDeclaration: struct {
    fact: String,
    roots: [String],
    span: Span,
    source: String,
    provenance: String,
}

SemaMemoryProjectionRow: struct {
    root: String,
    fact: String,
    projection: SemaMemoryProjection,
}

SemaCheckedMemoryFacts: struct {
    declarations: [SemaMemoryFactDeclaration],
    projections: [SemaMemoryProjectionRow],
}

SemaMemoryProjectionFacts: struct {
    declarations: [SemaMemoryFactDeclaration],
    projections: [SemaMemoryProjectionRow],
}

sema_effect_memory_projection: fn(finding: SemaMemoryFinding) -> SemaMemoryProjection Never! {
    if finding.event == .Val(event) {
        return SemaMemoryProjection.Violated{call_path: finding.path, operation: event.operation}
    }
    // A finding with neither reads as its E0921 does
    // (sema_effect_memory_violation): a memory proof that is incomplete.
    reason: if finding.open == .Val(open) -> open.reason else -> "memory proof is incomplete"
    SemaMemoryProjection.OpenWorld{call_path: finding.path, reason: reason}
}

sema_effect_memory_publish: fn(nodes: [SemaEffectNode], root: Int, denial: EffectRowEntry, projection: SemaMemoryProjection, facts: ^SemaMemoryProjectionFacts) Never! {
    fact: sema_effect_memory_fact(denial.name) ?? return
    source: nodes[root].source_display
    key: nodes[root].display_key
    facts.declarations.push(SemaMemoryFactDeclaration{fact: fact, roots: [String]{key}, span: denial.span, source: source, provenance: "signature denial `-[!{denial.name}]>` in {source}"})
    facts.projections.push(SemaMemoryProjectionRow{root: key, fact: fact, projection: projection})
}
