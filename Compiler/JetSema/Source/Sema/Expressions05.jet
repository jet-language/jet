// Private continuation of CheckerInfer.calls.direct_calls.
use jet_foundation.[Call, CallArg, Expr, Type, Span, StrPart, Diagnostic, TextEdit, AccessConvention, Syntax, CorePrelude, TEXT_NUL]
use jet_sema.Sema.[Checker, MemoryEvent, MemoryEventKind, e3403, foreign_managed_callback_lambda, foreign_thread_safe_lambda]
use jet_sema.Sema.Diagnostics.[builtin_effect, e0905, e3211, e0143_drop_unaudited, e0142_aliased, wrong_core_arity, result_ty, io_error_ty, is_printable, is_displayable, is_secret_bearing_crypto_type, is_one_pass_source, one_pass_materializer, edit_distance, generic_bound_failure, is_clock_type, is_deterministic_clock_type, expr_root_ident, write_place_required, write_range_window_argument, expiring_secret_loan_matches, typed_text_mismatch, type_fix_hint, type_is_copy]
use jet_sema.Sema.CheckerCoreLib.math_layout.[math_constructor_arg_types, is_simd_lane_type]
use jet_sema.Sema.CheckerCore.[is_core_view_generic]
use jet_sema.Sema.FFI.[foreign_call_boundary_error, is_callback_boundary_param, cpp_callback_abi_type, callback_contract_error, e3203]
