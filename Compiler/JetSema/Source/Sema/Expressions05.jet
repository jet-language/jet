use jet_collections.[is_iter_type]

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:1106
pub fn check_call_inner(self: &Checker, call: &Call, _as_value: Bool) -> Type?? {
    if call.name == "measurement" && self.funcs.get(call.name).is_none() && self.lookup(call.name).is_none() -> return Val(self.check_measurement(&call))
    if call.name == Syntax.KW_FREEZE && self.funcs.get(call.name).is_none() && self.lookup(call.name).is_none() -> return Val(self.check_freeze(&call))
    if call.name == "apply" && self.funcs.get(call.name).is_none() && self.lookup(call.name).is_none() -> return self.check_callable_policy_apply(&call).map(t -> Val(^t))
    if call.name == Syntax.RESOURCE_CLOSE {
        if call.args.len() != 1 {
            &self.diags.push(Diagnostic.error("E0104", "`close` takes exactly one resource, got {call.args.len()}", "`close` consumes one value through its nominal `Close` implementation and the move marker `^`", "write `close(^resource)` with the move marker `^`", Val(call.name_span)))
            for arg in &call.args -> _ :: self.infer(&arg.expr)
            return Val(None)
        }
        arg :: &call.args[0]
        ty :: self.infer(&arg.expr)
        if arg.convention != AccessConvention.Move {
            &self.diags.push(Diagnostic.error("E0201", "`close` takes ownership of its resource", "`Close.close(^self)` is consuming through the move marker `^`, so cleanup runs on exactly one owner", "write `close(^resource)` with the move marker `^`", Val(arg.span)))
        } else if ty == .Val(t) {
            nominal :: if t == { .Named(name) | .Apply{name, ..} -> Val(name); .String -> Val(Syntax.TYPE_STRING); _ -> None }
            if !nominal.is_some_and(name -> self.type_implements_trait_for_name(name, Syntax.TRAIT_CLOSE)) -> &self.diags.push(e0905(t.name(), Syntax.TRAIT_CLOSE, arg.expr.span(), false))
            if arg.expr == .Ident(name, span) && !t.is_scalar() -> self.mark_moved_by(~name, span, ~call.name)
        }
        return Val(None)
    }
    if (call.name == Syntax.BUILTIN_WRAPPING || call.name == Syntax.BUILTIN_SATURATING || call.name == Syntax.BUILTIN_CHECKED) && !self.funcs.contains_key(call.name) -> return Val(self.check_overflow_opt_in(&call))
    if call.name == Syntax.BUILTIN_APPROX && !self.funcs.contains_key(call.name) -> return self.check_numeric_approx(&call).map(t -> Val(^t))
    if call.name == Syntax.INTERNAL_DEBUG_TRACE || (call.name == Syntax.BUILTIN_DEBUG && !self.no_prelude && !self.funcs.contains_key(call.name) && !self.core_item_imports.contains_key(call.name) && !self.unqualified.contains_key(call.name) && !self.unqualified_file.contains_key(call.name) && self.lookup(call.name).is_none()) -> return Val(self.check_debug_trace(&call))
    if !self.funcs.contains_key(call.name) && builtin_effect(call.name) == .Val(effect) -> self.record_effect(effect.name(), call.name_span)
    if call.name == Syntax.FOREIGN_PRINTLN || call.name == Syntax.FOREIGN_EPRINTLN {
        target :: if call.name == Syntax.FOREIGN_EPRINTLN -> "io.eprint" else -> Syntax.BUILTIN_PRINT
        diagnostic :: Diagnostic.error("E0037", "{Syntax.LANG_NAME} calls it `{target}`, not `{call.name}`", "`print` writes to stdout; `io.eprint` is the stderr twin in `core.term`", "replace `{call.name}` with `{target}`", Val(call.name_span)).with_edit(TextEdit{span: call.name_span, new_text: ~target})
        &self.diags.push(^diagnostic)
        for arg in &call.args -> _ :: self.infer(&arg.expr)
        return None
    }
    if call.name == Syntax.FOREIGN_OPEN {
        &self.diags.push(Diagnostic.error("E0038", "`open` is not the M10 file API", "M10 uses whole-file helpers in `core.files`, not a bare `open` handle call", "import `core.files as fs` and call `fs.read(path)` or `fs.write(path, text)` (or `fs.open(path)` for a streaming handle)", Val(call.name_span)))
        for arg in &call.args -> _ :: self.infer(&arg.expr)
        return None
    }
    if call.name == Syntax.FOREIGN_GETENV {
        &self.diags.push(Diagnostic.error("E0039", "`getenv` is written `env.get` in Jet", "environment access lives in the `core.sys` module", "import `core.sys as env` and call `env.get(name)`", Val(call.name_span)))
        for arg in &call.args -> _ :: self.infer(&arg.expr)
        return None
    }
    if call.name == Syntax.FOREIGN_ASYNC || call.name == Syntax.FOREIGN_AWAIT {
        &self.diags.push(Diagnostic.error("E0040", "`{call.name}` is not in Jet; use the `task` keyword instead", "Jet uses blocking tasks and channels, not async/await — simpler and race-free", "write `task your_work()` or `task { … }`", Val(call.name_span)))
        for arg in &call.args -> _ :: self.infer(&arg.expr)
        return None
    }
    if call.name == Syntax.FOREIGN_MUTEX || call.name == Syntax.FOREIGN_LOCK || ["RwLock", "mutex", "Semaphore", "semaphore"].contains(call.name) {
        semaphore :: call.name == "Semaphore" || call.name == "semaphore"
        title :: if semaphore -> "`{call.name}` is not in Jet; use a bounded channel as a token pool" else -> "`{call.name}` is not a Jet API; use a channel, or `Shared<T>` with `Condition`"
        why :: if semaphore -> "each received token admits one worker until that worker sends the token back" else -> "tasks pass owned values over channels; when tasks must share memory, `Shared<T>` guards the state under a lock and `Condition` coordinates predicate waits"
        fix :: if semaphore -> "create `channel<Int>(capacity: N)`, seed N tokens, receive one before work, and send it back afterward" else -> "create `channel<T>()` and send owned values, or write `shared value` and edit it through `guard_edit()` (a guard can `wait` on a `Condition`)"
        &self.diags.push(Diagnostic.error("E0041", ^title, ^why, ^fix, Val(call.name_span)))
        for arg in &call.args -> _ :: self.infer(&arg.expr)
        return None
    }
    if self.no_prelude && call.name != Syntax.BUILTIN_PRINT && call.name != Syntax.BUILTIN_INPUT && !self.funcs.contains_key(call.name) && self.lookup(call.name).is_none() && CorePrelude.entry(call.name).is_some() {
        &self.diags.push(Diagnostic.error("E0429", "{call.name} is not ambient here — this file opted out with #{Syntax.MARKER_NO_PRELUDE}", "#{Syntax.MARKER_NO_PRELUDE} closes the readable Core prelude for this file", "write the qualified Core call, or remove #NoPrelude", Val(call.name_span)))
        for arg in &call.args -> _ :: self.infer(&arg.expr)
        return Val(None)
    }
    if call.name == Syntax.BUILTIN_CHANNEL && self.funcs.get(call.name).is_none() && self.lookup(call.name).is_none() -> return Val(self.check_channel(&call))
    if call.name == Syntax.BUILTIN_PRINT && self.funcs.get(Syntax.BUILTIN_PRINT).is_none() && self.lookup(Syntax.BUILTIN_PRINT).is_none() {
        if self.no_prelude {
            &self.diags.push(Diagnostic.error("E0429", "`{Syntax.BUILTIN_PRINT}` is not ambient here — this file opted out with `#{Syntax.MARKER_NO_PRELUDE}`", "`#{Syntax.MARKER_NO_PRELUDE}` disables the curated prelude auto-imports (`{Syntax.BUILTIN_PRINT}` / `{Syntax.BUILTIN_INPUT}`)", "write `use core.term as io` and call `io.{Syntax.BUILTIN_PRINT}(…)`, or remove `#{Syntax.MARKER_NO_PRELUDE}`", Val(call.name_span)))
            for arg in &call.args -> _ :: self.infer(&arg.expr)
            return Val(None)
        }
        if call.args.is_empty() {
            &self.diags.push(Diagnostic.error("E0103", "`{Syntax.BUILTIN_PRINT}` needs at least one thing to print", "printing nothing isn't meaningful", "e.g. {Syntax.BUILTIN_PRINT}(\"hello\")", Val(call.name_span)))
            return None
        }
        for arg in &call.args {
            self.borrow_ctx = true
            if self.infer(&arg.expr) == .Val(t) {
                exempt :: if t == { .Named(name) -> name == Syntax.TYPE_NEVER || (name == "Unknown" && !self.registry.contains(name)); _ -> false }
                if !(is_printable(t, self.registry, self.trait_reg) || is_displayable(t, self.registry, self.trait_reg)) && !self.is_unit_type(t) && !exempt {
                    if is_secret_bearing_crypto_type(t) {
                        &self.diags.push(Diagnostic.error("E0112", "secret-bearing `{t.name()}` cannot be printed", "printing could copy cryptographic secret material into terminal output or logs", "print a public operation label or key identifier instead", Val(arg.expr.span())))
                    } else if is_one_pass_source(t) {
                        fix :: one_pass_materializer(t).map_or_else(() -> "consume it with a `loop` and print each item instead", materializer -> if is_iter_type(t) -> "materialize it first: add `{materializer}` before printing; `.lazy()` or another Iter source enters the one-pass plane" else -> "materialize it first: add `{materializer}` before printing")
                        &self.diags.push(Diagnostic.error("E0112", "`{Syntax.BUILTIN_PRINT}` cannot show the one-pass source {t.show()}", "reading this value consumes it, so showing it would spend the only pass", ^fix, Val(arg.expr.span())))
                    } else {
                        &self.diags.push(Diagnostic.error("E0112", "`{Syntax.BUILTIN_PRINT}` doesn't know how to show {t.show()}", "print shows values that have a display", "print one of its parts instead", Val(arg.expr.span())))
                    }
                }
            }
        }
        return Val(None)
    }
    if call.name == Syntax.BUILTIN_INPUT && self.funcs.get(Syntax.BUILTIN_INPUT).is_none() && self.lookup(Syntax.BUILTIN_INPUT).is_none() {
        if self.no_prelude {
            &self.diags.push(Diagnostic.error("E0429", "`{Syntax.BUILTIN_INPUT}` is not ambient here — this file opted out with `#{Syntax.MARKER_NO_PRELUDE}`", "`#{Syntax.MARKER_NO_PRELUDE}` disables the curated prelude auto-imports (`{Syntax.BUILTIN_PRINT}` / `{Syntax.BUILTIN_INPUT}`)", "write `use core.term as io` and call `io.{Syntax.BUILTIN_INPUT}(…)`, or remove `#{Syntax.MARKER_NO_PRELUDE}`", Val(call.name_span)))
            for arg in &call.args -> _ :: self.infer(&arg.expr)
            return Val(None)
        }
        if call.args.len() > 1 -> &self.diags.push(wrong_core_arity(Syntax.BUILTIN_INPUT, 1, call.args.len(), call.name_span))
        if call.args.get_mut(0) == .Val(arg) -> self.expect_core_arg(Syntax.BUILTIN_INPUT, 0, Type.String, &arg)
        return Val(Val(result_ty(Type.String, io_error_ty())))
    }
    if call.name == Syntax.BUILTIN_PANIC && self.funcs.get(Syntax.BUILTIN_PANIC).is_none() && self.lookup(Syntax.BUILTIN_PANIC).is_none() {
        self.check_panic_call(&call)
        return Val(None)
    }
    if call.name == Syntax.BUILTIN_ASSERT && self.funcs.get(Syntax.BUILTIN_ASSERT).is_none() && self.lookup(Syntax.BUILTIN_ASSERT).is_none() {
        self.check_assert_call(&call)
        return Val(None)
    }
    if call.name == Syntax.BUILTIN_ASSERT_EQ {
        self.check_assert_eq_call(&call)
        return Val(None)
    }
    if call.name == Syntax.BUILTIN_FIND && self.in_comptime && self.funcs.get(Syntax.BUILTIN_FIND).is_none() && self.lookup(Syntax.BUILTIN_FIND).is_none() {
        if call.args.len() != 1 {
            &self.diags.push(Diagnostic.error("E0103", "`find` needs exactly one glob", "`find(glob)` expands one build-time glob inside a `comptime` binding", "write `find(\"content/**/*.md\")`", Val(call.name_span)))
            for arg in &call.args -> _ :: self.infer(&arg.expr)
            return None
        }
        self.expect_core_arg(Syntax.BUILTIN_FIND, 0, Type.String, &call.args[0])
        return Val(Val(Type.List(Type.String)))
    }
    if (call.name == Syntax.BUILTIN_EMBED_FILE || call.name == Syntax.BUILTIN_EMBED_BYTES) && self.in_comptime && self.funcs.get(call.name).is_none() && self.lookup(call.name).is_none() {
        builtin :: ~call.name
        if call.args.len() != 1 {
            &self.diags.push(Diagnostic.error("E0103", "`{builtin}` needs exactly one path", "`{builtin}(path)` bakes one file into the binary at compile time", "write `{builtin}(\"motd.txt\")`", Val(call.name_span)))
            for arg in &call.args -> _ :: self.infer(&arg.expr)
            return None
        }
        self.expect_core_arg(builtin, 0, Type.String, &call.args[0])
        ty :: if builtin == Syntax.BUILTIN_EMBED_BYTES -> Type.List(Type.IntN{signed: false, bits: 8}) else -> Type.String
        return Val(Val(^ty))
    }
    if call.name == Syntax.BUILTIN_CONSUME && self.funcs.get(Syntax.BUILTIN_CONSUME).is_none() && self.lookup(Syntax.BUILTIN_CONSUME).is_none() {
        if call.args.len() != 1 {
            &self.diags.push(Diagnostic.error("E0103", "`{Syntax.BUILTIN_CONSUME}` discards exactly one value", "`drop` throws a single value away, running its cleanup", "e.g. {Syntax.BUILTIN_CONSUME}(x)", Val(call.name_span)))
            for arg in &call.args -> _ :: self.infer(&arg.expr)
            return Val(None)
        }
        _ :: self.infer(&call.args[0].expr)
        if call.args[0].expr == .Ident(name, span) {
            single_use :: self.lookup(name).is_some_and(info -> info.single_use_span.is_some())
            if single_use && !self.in_unsafe -> &self.diags.push(e0143_drop_unaudited(name, span))
            // Consume even on the audit diagnostic path to avoid end-scope cascades.
            self.mark_moved_by(~name, span, ~call.name)
        }
        return Val(None)
    }
    if call.name == Syntax.BUILTIN_EXPECT {
        if call.args.len() != 1 {
            &self.diags.push(Diagnostic.error("E2901", "`{Syntax.BUILTIN_EXPECT}` needs exactly one value to test", "snapshot testing wraps one value at a time", "e.g. {Syntax.BUILTIN_EXPECT}(my_value).snapshot()", Val(call.name_span)))
        } else {
            _ :: self.infer(&call.args[0].expr)
        }
        return Val(Val(Type.Named("__JetExpect__")))
    }
    if self.funcs.get(call.name).is_none() {
        if self.lookup(call.name) == .Val(info) && info.ty == .Fn{..} {
            name_span :: call.name_span
            callee := Expr.Ident(~call.name, name_span)
            args := call.args.take()
            end :: args.last().map(a -> a.expr.span().end).unwrap_or(name_span.end)
            ret :: self.infer_call_value(&callee, &args, Span.new(name_span.start, end))
            call.args = ^args
            return Val(^ret)
        }
        if self.resolve_import_call_path(call.name) == .Val((alias, mod_idx, fn_name)) {
            self.inferred_call_type_args = None
            result :: self.infer_import_call(alias, mod_idx, fn_name, call.name_span, call.name_span, call.type_args, &call.args, &call.resolved_ret)
            self.record_inferred_call_type_args(&call.type_args)
            return Val(^result)
        }
        // GATE #4499: exact inline-module/name tuple keys; local scope wins.
        inline_mangled :: self.inline_module.and_then(module -> self.inline_unqualified.get((module, call.name))).map(name -> ~name)
        if inline_mangled.or_else(() -> self.unqualified.get(call.name).map(name -> ~name)) == .Val(mangled) {
            if self.funcs.contains_key(mangled) && self.name_ledger.exported(self.module_idx, mangled) -> self.record_import_alias_reference(call.name, call.name_span)
            alias :: mangled.split("__").next().unwrap_or(mangled).to_string()
            self.inferred_call_type_args = None
            result :: self.infer_code_module_call(alias, mangled, call.name_span, call.name_span, call.type_args, &call.args, &call.resolved_ret)
            self.record_inferred_call_type_args(&call.type_args)
            return Val(^result)
        }
        inline_file :: self.inline_module.and_then(module -> self.inline_unqualified_file.get((module, call.name))).map(pair -> ~pair)
        if inline_file.or_else(() -> self.unqualified_file.get(call.name).map(pair -> ~pair)) == .Val((fn_name, mod_idx)) {
            self.inferred_call_type_args = None
            result :: self.infer_import_call(call.name, mod_idx, fn_name, call.name_span, call.name_span, call.type_args, &call.args, &call.resolved_ret)
            self.record_inferred_call_type_args(&call.type_args)
            return Val(^result)
        }
    }
    if self.funcs.get(call.name).is_none() && !self.registry.contains(call.name) && math_constructor_arg_types(call.name) == .Val(arg_types) {
        arity :: arg_types.len()
        if call.args.len() != arity {
            plural :: if arity == 1 -> "" else -> "s"
            family :: if is_simd_lane_type(call.name) -> "SIMD lane" else -> "linear-algebra"
            components :: ["…"; arity].join(", ")
            &self.diags.push(Diagnostic.error("E0103", "`{call.name}` takes exactly {arity} component{plural}, got {call.args.len()}", "`{call.name}` is a built-in {family} type — construct it from its {arity} components", "write `{call.name}({components})`", Val(call.name_span)))
            for arg in &call.args -> _ :: self.infer(&arg.expr)
            return Val(Val(Type.Named(~call.name)))
        }
        for (i, want) in arg_types.iter().enumerate() {
            old :: self.expected_type.replace(Val(~want))
            got :: self.infer(&call.args[i].expr)
            self.expected_type = ^old
            if got == .Val(at) && at != want -> &self.diags.push(Diagnostic.error("E0128", "component {i + 1} of `{call.name}` must be `{want.name()}`, got `{at.name()}`", "every component of `{call.name}` is a `{want.name()}`", "write a `{want.name()}` value here", Val(call.args[i].expr.span())))
        }
        return Val(Val(Type.Named(~call.name)))
    }
    if self.funcs.get(call.name).is_none() && self.lookup(call.name).is_none() && (call.name == "zip" || call.name == "zip_short" || call.name == "zip_pad") {
        if self.check_zip_family_free(&call) == .Val(result) -> return Val(^result)
    }
    if self.funcs.get(call.name).is_none() && !self.registry.contains(call.name) && call.name == Syntax.TYPE_DECIMAL {
        if call.args.len() != 1 {
            &self.diags.push(Diagnostic.error("E0103", "`Decimal` takes exactly one argument, got {call.args.len()}", "`Decimal` parses an exact base-10 decimal from a `String`", "write `Decimal(\"12.34\")`", Val(call.name_span)))
            for arg in &call.args -> _ :: self.infer(&arg.expr)
            return Val(Val(Type.Named(~call.name)))
        }
        self.expect_core_arg("Decimal", 0, Type.String, &call.args[0])
        return Val(Val(Type.Named(~call.name)))
    }
    if self.funcs.get(call.name).is_none() && !self.registry.contains(call.name) && call.name == Syntax.TYPE_COMPLEX {
        if call.args.len() != 2 {
            &self.diags.push(Diagnostic.error("E0103", "`Complex` takes exactly two arguments, got {call.args.len()}", "`Complex` takes the real part first and the imaginary part second", "write `Complex(real, imaginary)`", Val(call.name_span)))
            for arg in &call.args -> _ :: self.infer(&arg.expr)
            return Val(Val(Type.Named(~call.name)))
        }
        self.expect_core_arg("Complex", 0, Type.Float, &call.args[0])
        self.expect_core_arg("Complex", 1, Type.Float, &call.args[1])
        return Val(Val(Type.Named(~call.name)))
    }
    if self.funcs.get(call.name).is_none() && self.registry.distinct_base(call.name) == .Val(base_ty) {
        method :: Syntax.conversion_method_for_source(base_ty.name())
        &self.diags.push(Diagnostic.error("E0128", "`{call.name}(value)` is not a distinct conversion", "explicit conversions are owned by the destination type and name their source", "write `{call.name}.{method}(value)`", Val(call.name_span)))
        for arg in &call.args -> _ :: self.infer(&arg.expr)
        return None
    }
    if self.check_zip_family_free(&call) == .Val(result) -> return Val(^result)
    if (call.name == "require" || call.name == "require_eq") && self.funcs.get(call.name).is_none() && self.lookup(call.name).is_none() {
        replacement :: if call.name == "require" -> "assert" else -> "assert_eq"
        &self.diags.push(Diagnostic.error("E0102", "`{call.name}` is a retired assertion spelling", "Jet has one assertion family: `assert` and `assert_eq`", "write `{replacement}` instead", Val(call.name_span)))
        for arg in &call.args -> _ :: self.infer(&arg.expr)
        return Val(None)
    }
    sig_option :: self.funcs.get(call.name).map(sig -> ~sig)
    if sig_option != .Val(sig) {
        fix := "define it first ({Syntax.KW_FN} {call.name}() {{ ... }}), or call one that exists"
        // Keep unique minimum and exclude an exact echo; deduplicate in linear map time.
        candidates: [String:USize] := [:]
        prelude_cands :: if self.no_prelude -> [] else -> CorePrelude.names().collect()
        for cand in self.funcs.keys().chain(prelude_cands.iter()) {
            d :: edit_distance(call.name, cand)
            if d > 0 && d <= 2 && !candidates.contains_key(cand) -> &candidates.insert(~cand, d)
        }
        minimum :: candidates.values().min()
        matches :: minimum.map(distance -> candidates.iter().filter(pair -> pair.1 == distance).map(pair -> pair.0).collect()).unwrap_or([])
        suggestion :: if matches.len() == 1 -> Val(matches[0]) else -> None
        if suggestion == .Val(cand) -> fix = "did you mean `{cand}`?"
        diagnostic := Diagnostic.error("E0102", "nothing named `{call.name}` exists here", "only functions that have been defined (or built in, like `{Syntax.BUILTIN_PRINT}` / `{Syntax.BUILTIN_INPUT}`) can be called", ^fix, Val(call.name_span))
        if suggestion == .Val(cand) -> diagnostic = diagnostic.with_edit(TextEdit{span: call.name_span, new_text: ~cand})
        &self.diags.push(^diagnostic)
        for arg in &call.args -> _ :: self.infer(&arg.expr)
        return None
    }
    self.record_current_function_reference(call.name, call.name_span)
    if sig.deprecation == .Val(dep) -> self.check_deprecation(call.name, dep, call.name_span)
    self.check_foreign_transaction_call(sig, call.name, call.name_span)
    if sig.is_extern {
        if sig.foreign_effect_root == .Val(effect) {
            self.record_open_memory_dispatch(call.name_span, "foreign function body")
            self.record_effect(effect, call.name_span)
        } else {
            self.record_maximal(call.name_span)
        }
    } else {
        self.record_edge(~call.name, call.name_span)
    }
    if foreign_call_boundary_error(sig, call.name, self.in_unsafe, call.name_span) == .Val(diagnostic) -> &self.diags.push(^diagnostic)
    params :: bind_params_from_sig(sig)
    bound :: bind_call_args(call.name, params, &call.args, call.name_span, &self.diags)
    self.register_binder_refs(call.args)
    if bound.is_none() {
        for arg in &call.args -> _ :: self.infer(&arg.expr)
        (_, return_type) :: self.checked_return_types(~sig.return_type, sig.is_extern)
        return Val(Val(^return_type))
    }
    if sig.is_c_abi {
        for (index, arg) in call.args.iter().enumerate() {
            is_string_param :: if sig.params.get(index) == { .Val((_, .String)) -> true; _ -> false }
            if !is_string_param -> continue
            if arg.expr == .Str(parts, span) {
                literal :: parts.iter().map(p -> if p == { .Lit(s) -> Val(~s); .Interp(..) -> None }).collect<String?>()
                if literal == .Val(text) && text.contains(TEXT_NUL) -> &self.diags.push(e3211(span))
            }
        }
    }
    variadic :: sig.param_variadic.last().unwrap_or(false)
    bound_variadic :: (if variadic -> ~sig.variadic_bounds else -> None).or_else(() -> {
        if !variadic -> return None
        return if sig.params.last() == {
            .Val((_, .List(.Named(n)))) if self.trait_reg.is_trait_name(n) -> Val([~n])
            _ -> None
        }
    })
    bound_variadic_tail: [CallArg]? := None
    if bound_variadic == .Val(bounds) {
        fixed :: sig.params.len().saturating_sub(1)
        if call.args.len() < fixed {
            plural :: if fixed == 1 -> "" else -> "s"
            &self.diags.push(Diagnostic.error("E0104", "`{call.name}` expects at least {fixed} argument{plural}, got {call.args.len()}", "every fixed parameter must receive a value before the variadic tail", "check the definition of `{call.name}`", Val(call.name_span)))
        }
        tail := if call.args.len() > fixed -> &call.args.split_off(fixed) else -> []
        self.check_variadic_bound_tail(call, sig, &tail, bounds)
        _ :: &sig.params.pop()
        _ :: &sig.param_info.pop()
        _ :: &sig.defaults.pop()
        _ :: &sig.param_variadic.pop()
        bound_variadic_tail = Val(^tail)
    } else {
        if variadic {
            self.normalize_variadic_call(&call, sig)
        } else if call.args.iter().any(a -> a.spread) {
            &self.diags.push(Diagnostic.error("E1312", "`{call.name}` doesn't accept a spread argument", "call spread `f(...xs)` only works when the callee has a final `...` rest parameter", "pass arguments individually, or call a function whose last parameter is variadic", Val(call.name_span)))
            for arg in &call.args { if arg.spread -> _ :: self.infer(&arg.expr) }
        }
        if call.args.len() != sig.params.len() {
            plural :: if sig.params.len() == 1 -> "" else -> "s"
            &self.diags.push(Diagnostic.error("E0104", "`{call.name}` expects {sig.params.len()} argument{plural}, got {call.args.len()}", "every argument must match a parameter", "check the definition of `{call.name}`", Val(call.name_span)))
        }
    }
    fn_type_params :: self.trait_reg.fn_params.get(call.name).map(params -> ~params).unwrap_or([])
    call_access := self.call_access_frame()
    generic_subst: [String:Type] := [:]
    pre_inferred: [Type?] := []
    if !fn_type_params.is_empty() && !call.type_args.is_empty() {
        if call.type_args.len() != fn_type_params.len() {
            plural :: if fn_type_params.len() == 1 -> "" else -> "s"
            &self.diags.push(Diagnostic.error("E0119", "`{call.name}` expects {fn_type_params.len()} type argument{plural}, got {call.type_args.len()}", "a generic call must provide one type for every declared type parameter", "write {call.name} with {fn_type_params.len()} type argument{plural}", Val(call.name_span)))
        } else {
            for (param, actual_source) in fn_type_params.iter().zip(call.type_args) {
                actual :: self.resolve_type(~actual_source)
                if !actual.is_never() -> self.check_declared_type(actual, call.name_span)
                for bound in param.bounds {
                    if !self.type_satisfies_bound(actual, bound) -> &self.diags.push(generic_bound_failure(self, actual, bound, call.name_span))
                }
                &generic_subst.insert(~param.name, ^actual)
            }
        }
    } else if !fn_type_params.is_empty() {
        inference :: self.infer_generic_call_args(sig, fn_type_params, &call.args, &call_access, call.name_span, !sig.is_extern)
        if inference.complete {
            failed :: fn_type_params.iter().find_map(param -> {
                ty :: inference.subst.get(param.name)?
                return param.bounds.iter().find(bound -> !self.type_satisfies_bound(ty, bound)).map(bound -> (ty, bound))
            })
            if failed == .Val((ty, bound)) -> &self.diags.push(generic_bound_failure(self, ty, bound, call.name_span))
        }
        pre_inferred = ^inference.pre_inferred
        generic_subst = ^inference.subst
    } else if !call.type_args.is_empty() {
        &self.diags.push(Diagnostic.error("E0119", "`{call.name}` is not generic", "only functions declared with type parameters accept call-site type arguments", "call {call.name} without type arguments", Val(call.name_span)))
    }
    if call.type_args.is_empty() && generic_subst.len() == fn_type_params.len() && !generic_subst.is_empty() -> call.type_args = fn_type_params.iter().map(param -> ~generic_subst.get(param.name).expect("complete generic substitution has every type parameter")).collect()
    effective_params :: if generic_subst.is_empty() -> ~sig.params else -> sig.params.iter().map(pair -> (pair.0, self.trait_reg.instantiate_type(pair.1, generic_subst))).collect()
    args_pre_inferred :: !fn_type_params.is_empty() && pre_inferred.len() == call.args.len()
    for (i, arg) in call.args.iter_mut().enumerate() {
        if !sig.is_extern {
            if arg.convention == AccessConvention.Write -> self.borrow_ctx = true
            if effective_params.get(i) == {
                .Val((.Write, _)) -> self.borrow_ctx = true
                .Val((.Read, pty)) if !pty.is_scalar() -> self.borrow_ctx = true
                _ -> {}
            }
        } else if effective_params.get(i) == .Val((_, pty)) && !pty.is_scalar() {
            arg.flags.implicit_clone = true
        }
        bare_arg_name :: if arg.expr == { .Ident(name, span) -> Val((~name, span)); _ -> None }
        saved_exp :: self.expected_type.take()
        saved_esc :: self.lambda_escapes
        callback_boundary :: effective_params.get(i).is_some_and(pair -> is_callback_boundary_param(sig.is_c_abi, pair.1))
        if effective_params.get(i) == .Val((param_conv, param_ty)) {
            self.expected_type = None
            if param_conv == AccessConvention.Move -> self.expected_type = Val(~param_ty)
            if param_ty == .Fn{..} {
                self.expected_type = Val(~param_ty)
                self.lambda_escapes = param_conv == AccessConvention.Move || callback_boundary
            } else {
                contextual :: if param_ty == {
                    .Int | .IntN{..} | .Float | .Float32 | .InlineRange{..} | .Named(_) | .Option(_) | .Result{..} -> true
                    _ -> is_core_view_generic(param_ty)
                }
                if contextual -> self.expected_type = Val(~param_ty)
            }
        }
        cb_bound :: if effective_params.get(i) == { .Val((_, .Fn{effect_bound: .Val(b), ..})) -> Val(~b); _ -> None }
        cb_snapshot :: cb_bound.map(_ -> (~self.fx_direct, ~self.fx_edges, self.fx_maximal))
        memory_multiplier :: self.memory_control_multiplier
        if effective_params.get(i) == .Val((_, .Fn{..})) -> self.memory_control_multiplier = None
        arg_ty :: if args_pre_inferred {
            inferred := pre_inferred.get(i).and_then(t -> ~t)
            if (effective_params.get(i), inferred) == (.Val((.Move, param_ty)), .Val(source_ty)) {
                resolved_param :: self.resolve_type(~param_ty)
                if !self.copies_explicit() && self.implicit_copy_target(arg.expr, source_ty) == .Val(target) {
                    if target == resolved_param && self.is_cloneable_type(target) -> inferred = Val(self.insert_implicit_copy(&arg.expr, source_ty, target))
                }
            }
            ^inferred
        } else {
            self.with_call_access(&call_access, checker -> {
                if effective_params.get(i) == .Val((param_conv, param_ty)) -> checker.check_call_argument_access(arg, param_conv, param_ty, !sig.is_extern)
                suppress :: checker.suppress_partial_move_root_read
                if arg.convention == AccessConvention.Move -> checker.suppress_partial_move_root_read = true
                inferred :: checker.infer(&arg.expr)
                checker.suppress_partial_move_root_read = suppress
                checker.check_call_argument_captures(arg.expr)
                return ^inferred
            })
        }
        if sig.is_pure && effective_params.get(i).is_some_and(pair -> is_clock_type(pair.1)) && arg_ty.is_some_and(ty -> !is_deterministic_clock_type(ty)) -> &self.diags.push(e3403("an unproven Clock passed to pure `{call.name}`", Val(arg.expr.span())))
        self.memory_control_multiplier = memory_multiplier
        if callback_boundary {
            managed :: sig.callback_transport.is_some_and(transport -> transport != "none")
            safe :: if arg.expr == {
                .Ident(callback, _) -> self.callback_function_is_safe(callback) || arg_ty.is_some_and(ty -> cpp_callback_abi_type(ty).is_some())
                .Lambda(lam) if managed -> foreign_managed_callback_lambda(lam)
                .Lambda(lam) -> foreign_thread_safe_lambda(lam)
                _ -> false
            }
            metadata_complete :: !managed || (sig.callback_plan_digest.is_some_and(digest -> !digest.is_empty()) && sig.callback_identity.is_some_and(identity -> !identity.is_empty()) && sig.foreign_effect_root == Val("FFI.C"))
            if safe && metadata_complete {
                arg.flags.c_callback_symbol = true
                arg.flags.c_callback_function_key = if arg.expr == { .Ident(callback, _) -> self.callback_function_key(callback); _ -> None }
                arg.flags.c_callback_managed = managed
                arg.flags.c_callback_plan_digest = ~sig.callback_plan_digest
                arg.flags.c_callback_identity = ~sig.callback_identity
            } else if effective_params.get(i) == .Val((_, param_ty)) {
                &self.diags.push(if managed && !metadata_complete -> callback_contract_error(param_ty, arg.expr.span()) else -> e3203(param_ty, arg.expr.span()))
            }
        }
        self.expected_type = ^saved_exp
        self.lambda_escapes = saved_esc
        if effective_params.get(i) != .Val((param_conv, param_ty)) -> continue
        if param_ty == .Fn{..} -> self.attribute_fn_arg(arg.expr)
        if (cb_bound, cb_snapshot) == (.Val(bound), .Val((bd, be, bm))) -> self.record_callback_obligation(bound, bd, be, bm, arg.expr.span())
        write_needs_a_place :: arg.convention == AccessConvention.Write && expr_root_ident(arg.expr).is_none()
        write_range_window :: arg.convention == AccessConvention.Write && (if arg.expr == { .Slice{..} -> true; _ -> false }) && !self.fixed_length_write_params.contains((call.name, i))
        if write_needs_a_place -> &self.diags.push(write_place_required(arg.span))
        else if write_range_window -> &self.diags.push(write_range_window_argument(arg.span))
        if arg_ty == .Val(inferred) {
            resolved_param :: self.resolve_type(~param_ty)
            resolved_arg := self.resolve_type(~inferred)
            shared_guard :: if resolved_param == { .Apply{name, ..} -> name == Syntax.TYPE_SHARED_GUARD; _ -> false }
            edit_guard :: if resolved_arg == { .Tagged{marker: .Internal(.SharedGuardEdit), ..} -> true; _ -> false }
            write_forward :: if arg.expr == { .Ident(name, _) -> self.lookup(name).is_some_and(info -> info.param_conv == Val(AccessConvention.Write)); _ -> false }
            if param_conv == AccessConvention.Write && shared_guard && !edit_guard && !write_forward -> &self.diags.push(Diagnostic.error("E0205", "a read `SharedGuard` cannot enter a write helper", "the helper can edit through this parameter, so its caller must hold an exclusive Shared guard", "create the guard with `guard_edit()` before passing it with the write-access marker `&`", Val(arg.expr.span())))
            if resolved_param != resolved_arg && self.implicitly_convert_unit(&arg.expr, resolved_param, resolved_arg) -> resolved_arg = ~resolved_param
            if param_conv != AccessConvention.Write && resolved_param != resolved_arg && resolved_arg.numeric_widening_to(resolved_param).is_some() {
                self.widen_numeric_expr(&arg.expr, resolved_arg, resolved_param)
                resolved_arg = ~resolved_param
            }
            resolved_arg = self.lift_optional_argument(&arg.expr, ^resolved_arg, resolved_param, param_conv)
            reads_expiring_secret_loan :: arg.convention == AccessConvention.Read && expiring_secret_loan_matches(resolved_param, resolved_arg)
            reported :: write_needs_a_place || write_range_window || reads_expiring_secret_loan || self.check_type_assignable(resolved_param, resolved_arg, arg.expr.span())
            fixed_widens :: if (resolved_param, resolved_arg) == { (.List(pe), .FixedList{elem: ae, ..}) -> pe == ae && Type.obligations_satisfy(pe, ae); _ -> false }
            union_widens :: if resolved_param == { .Union(members) -> members.iter().any(m -> m == resolved_arg && Type.obligations_satisfy(m, resolved_arg)); _ -> false }
            both_fn :: if (resolved_param, resolved_arg) == { (.Fn{..}, .Fn{..}) -> true; _ -> false }
            exact_or_obligation_compatible :: (if both_fn -> fn_types_compatible(resolved_param, resolved_arg) else -> resolved_arg == resolved_param) && Type.obligations_satisfy(resolved_param, resolved_arg)
            boxes_as_trait :: self.trait_slot_accepts(resolved_param, resolved_arg)
            compatible :: exact_or_obligation_compatible || fixed_widens || union_widens || boxes_as_trait || reads_expiring_secret_loan
            if boxes_as_trait -> self.note_move_if_direct_ident(arg.expr, "`{call.name}`")
            if !reported && !compatible {
                if typed_text_mismatch(resolved_param, resolved_arg, arg.expr.span()) == .Val(diag) {
                    &self.diags.push(^diag)
                } else {
                    &self.diags.push(Diagnostic.error("E0112", "`{call.name}` wants {resolved_param.show()} for argument {i + 1}, but this is {resolved_arg.show()}", "every argument must match its parameter's type", type_fix_hint(resolved_param, resolved_arg), Val(arg.expr.span())))
                }
            }
        }
        if param_conv != AccessConvention.Move && arg.expr == .Ident(name, span) {
            if self.lookup(name).is_some_and(info -> info.single_use_span.is_some()) {
                &self.diags.push(e0142_aliased(name, call.name, span))
                continue
            }
        }
        if (param_conv, arg.convention) == {
            (.Move, .Read) -> {
                if bare_arg_name == .Val((name, span)) {
                    if !type_is_copy(param_ty) {
                        if !self.is_resource_type(param_ty) && self.is_cloneable_type(param_ty) {
                            arg.flags.implicit_clone = true
                            &self.diags.push(self.e0209_implicit_clone("implicit clone of `{name}`", "`{call.name}` expects to take ownership of this value", name, span))
                        } else {
                            &self.diags.push(Diagnostic.error("E0201", "`{call.name}` needs the move marker `^` here — this value can't be copied", "parameter {i + 1} takes ownership through the move marker `^`; passing `{name}` without that marker would have to copy it, but this type can't be copied", "write the move marker `^` (`{Syntax.SIGIL_MOVE}{name}`) to move ownership to `{call.name}`", Val(span)))
                        }
                    }
                }
            }
            (.Move, .Move) -> {
                if self.reject_noncanonical_move_place(arg.expr, arg_ty, call.name, arg.span) -> continue
                if arg.expr == .Ident(name, span) && !type_is_copy(param_ty) -> self.mark_moved_by(~name, span, ~call.name)
            }
            (.Write, .Read) -> {
                if arg.expr == .Ident(name, span) -> &self.diags.push(Diagnostic.error("E0202", "parameter `{name}` requires the write-access marker `&` at the call site", "`{call.name}` needs to edit this value with the write-access marker `&`; passing it without that marker grants only read access", "write the write-access marker `&` (`{Syntax.SIGIL_WRITE}{name}`) when calling `{call.name}`", Val(span)))
            }
            (.Write, .Write) -> {
                root :: expr_root_ident(arg.expr).map(name -> {
                    span :: if arg.expr == { .Ident(_, span) -> span; _ -> arg.span }
                    return (~name, span)
                })
                if root == .Val((name, span)) && self.lookup(name) == .Val(info) && !info.mutable {
                    diagnostic := Diagnostic.error("E0111", "`{name}` was made with `{Syntax.SIGIL_BIND_IMMUT}`, so it can't be changed", "`{call.name}` will change this value, so it must be mutable (`{Syntax.SIGIL_BIND_MUT}`)", "declare it with `{name} {Syntax.SIGIL_BIND_MUT} ...`", Val(span))
                    if info.binding_sigil_span == .Val(sigil_span) -> diagnostic = diagnostic.with_edit(TextEdit{span: sigil_span, new_text: Syntax.SIGIL_BIND_MUT})
                    &self.diags.push(^diagnostic)
                }
            }
            (.Read | .Write, .Move) -> &self.diags.push(Diagnostic.error("E0203", "a value was passed with the move marker `^` to a parameter that does not consume", "only parameters declared with the move marker `^` accept a moved value at the call site", "remove the move marker `^`, or declare the parameter with that marker to take ownership", Val(arg.span)))
            _ -> {}
        }
        self.check_write_arg_change(arg)
        if self.loop_depth > 0 && arg.expr == .Ident(name, span) && self.lookup(name) == .Val(info) && info.ty == .Shared(_) {
            arg.flags.shared_auto_clone = true
            self.record_memory_event(MemoryEvent.new(MemoryEventKind.RetainRelease, span, "loop use of `{name}` auto-retains a shared reference"))
            &self.diags.push(Diagnostic.lint("L0202", "auto-cloned `{name}` inside a loop; consider hoisting or caching", "shared handles are cloned when used across a loop boundary", "hoist `{name}` before the loop, or clone once outside", Val(span)))
        }
    }
    self.check_param_view_from_requirements(sig, call.args)
    if bound_variadic_tail == .Val(tail) -> &call.args.extend(^tail)
    resolved_declared :: sig.return_type.map(return_type -> if generic_subst.is_empty() -> ~return_type else -> self.trait_reg.instantiate_type(return_type, generic_subst))
    (resolved_ret, effective_ret) :: self.checked_return_types(^resolved_declared, sig.is_extern)
    call.resolved_ret = Val(^resolved_ret)
    return Val(Val(^effective_ret))
}
