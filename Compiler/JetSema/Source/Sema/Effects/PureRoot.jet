// Runtime-root purity: check_pure_program_root e3401, adapted to checked flat
// bodies and the canonical effect facts. No source-text name resolution
// participates in this check.
use jet_foundation.[
    DeclTable,
    decl_table_key,
    Diagnostic,
    FnBody,
    Span,
    SymbolTable,
    body_each_expr_child,
    body_each_stmt_child,
    body_node,
    diagnostic_with_rights,
    interner_empty,
    name_column,
    name_column_set,
    name_column_table,
    symbol_key,
]

// Where a function of the walk is: its module and its row there. The walk's
// call index keys each function by its key (`node_by_key`), whose node is
// the function's row in the walk's `places`.
SemaPureRootPosition: struct {
    module_index: Int,
    function_index: Int,
}

sema_pure_root_diagnostic: fn(root: String, call: String, path: [String], span: Span) -> Diagnostic {
    why: if path.len() == 0 -> "`{call}` is impure, but `{root}` declares `-[]>`" else -> "{path.join(" → ")} calls `{call}`, which is impure — the whole call chain must be pure inside `{root}`"
    ^chain: [String]{root}
    loop component in path {
        if chain[chain.len() - 1] != component -> chain.push(component.copy())
    }
    if chain[chain.len() - 1] != call -> chain.push(call.copy())
    fix: if path.len() == 0 -> "remove the call from `{root}`, or drop the `-[]>` bound from `{root}` so its effects are inferred" else -> "remove the call to `{call}`, or drop the `-[]>` bound from `{root}` so its effects are inferred"
    diagnostic_with_rights(sema_error("E3401", span, "`{root}` calls the impure function `{call}`", why, fix), "pure", chain, [String]{}, None)
}

// `module_index` is the module of `owner`, whose call facts the walk reads.
sema_pure_root_expr: fn(root: String, modules: [SemaGraphModuleResult], decls: DeclTable, symbols: SymbolTable, places: [SemaPureRootPosition], calls: SemaEffectCallIndex, owner: FnBody, module_index: Int, expression: Int, shallow: Bool, visited: ^[Bool], path: ^[String]) -> Diagnostic? Never! {
    node: body_node(owner.tree, expression)
    ^pure_builtin: false
    if node.kind == .BuiltinMethod(_, op, _) {
        pure_builtin = !sema_effect_builtin_may_have_effect(op)
    }
    if !pure_builtin && sema_effect_is_call(node.kind) {
        // The call fact is read in place from its module (the call index
        // keeps positions in the same order as `call_facts`).
        fact: sema_effect_find_fact(calls, modules[module_index].call_facts, sema_effect_caller_slot(calls, module_index, owner.key), node.span)
        ^key: ""
        if fact == .Val(at) {
            if modules[module_index].call_facts[at].callee == .Val(callee) {
                key = symbol_key(symbols, owner.tree.symbols, callee)
            }
        }
        if key == "" && node.kind == .Call(callee, _, _) {
            key = decl_table_key(decls, symbols, callee)
        }
        if sema_effect_node_index(calls.node_by_key, key) == .Val(callee_at) {
            position: places[callee_at]
            callee_body: modules[position.module_index].functions[position.function_index]
            if !shallow {
                found: sema_pure_root_function(root, modules, decls, symbols, places, calls, callee_body, callee_at, true, shallow, visited, path)
                if found != None -> return found
            } else {
                // A callee outside the checked modules (a Core body or
                // method) has no stamped row; its call fact carries its
                // declared one.
                ^impure: sema_effect_without_deny_only(callee_body.effects.solved).len() > 0
                if !impure && fact == .Val(at) {
                    if modules[module_index].call_facts[at].facts.effect_bound == .Val(row) {
                        names: loop entry in row -> entry.name
                        impure = sema_effect_without_deny_only(names).len() > 0
                    }
                }
                call: if node.kind == {
                    .Call(_, _, _) -> sema_effect_decl_label(key)
                    .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> sema_effect_node_call_api(decls, symbols, node.kind)
                }
                if impure -> return Val(sema_pure_root_diagnostic(root, call, path, node.span))
            }
        } else {
            ^denied: false
            if fact == .Val(at) {
                if modules[module_index].call_facts[at].facts.effect_bound == .Val(row) {
                    names: loop entry in row -> entry.name
                    denied = sema_effect_without_deny_only(names).len() > 0
                } else {
                    // A written lambda's call is its body, walked where the
                    // lambda is written.
                    denied = !sema_effect_is_compiler_intrinsic(node.kind) && !sema_effect_local_lambda_call(owner.tree, node.kind)
                }
            } else {
                // Use the source witnesses already published by the one effect
                // solver, rather than maintaining another builtin-effect list.
                loop witness in owner.effects.direct_spans {
                    if sema_effect_span_contains(node.span, witness.span) && sema_effect_without_deny_only([String]{witness.name}).len() > 0 {
                        denied = true
                        break
                    }
                }
            }
            if denied {
                call: if node.kind == {
                    .Print(_) -> "print"
                    .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> sema_effect_node_call_api(decls, symbols, node.kind)
                }
                return Val(sema_pure_root_diagnostic(root, call, path, node.span))
            }
        }
    }
    ^found: Diagnostic?{None}
    body_each_expr_child(owner.tree, node, fn(child: Int) { sema_pure_root_visit(root, modules, decls, symbols, places, calls, owner, module_index, child, shallow, visited, path, found) })
    found
}

// One child of a pure-root walk; stops descending once a diagnostic is found.
// The visitor closures stay expression-bodied: they only re-borrow the walk's
// write parameters, the shape every other body child visitor uses.
sema_pure_root_visit: fn(root: String, modules: [SemaGraphModuleResult], decls: DeclTable, symbols: SymbolTable, places: [SemaPureRootPosition], calls: SemaEffectCallIndex, owner: FnBody, module_index: Int, child: Int, shallow: Bool, visited: ^[Bool], path: ^[String], found: ^Diagnostic?) Never! {
    if found == None {
        found = sema_pure_root_expr(root, modules, decls, symbols, places, calls, owner, module_index, child, shallow, visited, path)
    }
}

// The first diagnostic under one statement of a pure root's body. Its own
// function, not a walk inline in sema_pure_root_function's loop, so the
// visitor closure's write captures (`visited`, `path`) end with this call: the
// next iteration's closure and the `path.pop()` after the loop are not
// rejected (E0499), because the walk is the last use of those parameters.
sema_pure_root_statement: fn(root: String, modules: [SemaGraphModuleResult], decls: DeclTable, symbols: SymbolTable, places: [SemaPureRootPosition], calls: SemaEffectCallIndex, function: FnBody, module_index: Int, statement: Int, shallow: Bool, visited: ^[Bool], path: ^[String]) -> Diagnostic? Never! {
    ^found: Diagnostic?{None}
    body_each_stmt_child(function.tree, function.tree.stmts[statement], fn(expression: Int) { sema_pure_root_visit(root, modules, decls, symbols, places, calls, function, module_index, expression, shallow, visited, path, found) })
    found
}

// `at` is the function's row in `places`, which `visited` marks once the
// walk enters it. Only the root is not `nested`: every other function is
// entered from a call in a walked body.
sema_pure_root_function: fn(root: String, modules: [SemaGraphModuleResult], decls: DeclTable, symbols: SymbolTable, places: [SemaPureRootPosition], calls: SemaEffectCallIndex, function: FnBody, at: Int, nested: Bool, shallow: Bool, visited: ^[Bool], path: ^[String]) -> Diagnostic? Never! {
    if visited[at] -> return None
    visited[at] = true
    if nested -> path.push(function.name)
    loop statement in function.body {
        found: sema_pure_root_statement(root, modules, decls, symbols, places, calls, function, places[at].module_index, statement, shallow, visited, path)
        if found != None -> return found
    }
    if nested -> _: path.pop()
    None
}

// `decls` is the run's declaration table, which direct callees name, and
// `symbols` its symbol table, which call facts name. A runtime root follows
// its whole call chain.
check_pure_program_root: fn(entry_key: String, modules: [SemaGraphModuleResult], decls: DeclTable, symbols: SymbolTable) -> [Diagnostic] {
    if sema_pure_root_find(entry_key, modules, decls, symbols, false) == .Val(diagnostic) {
        return [Diagnostic]{diagnostic}
    }
    [Diagnostic]{}
}

// The first impure call a pure function reaches, named with its call chain;
// None when no single call site carries the impurity. A `shallow` walk stays
// in the function's own body and names the first direct call whose callee is
// impure, as a declared `-[]>` bound reports it.
sema_pure_root_find: fn(entry_key: String, modules: [SemaGraphModuleResult], decls: DeclTable, symbols: SymbolTable, shallow: Bool) -> Diagnostic? {
    ^places: [SemaPureRootPosition]{}
    ^node_by_key: SemaEffectNodeKeys{names: name_column_table(), nodes: name_column()}
    loop module_index in 0..<modules.len() {
        loop function_index in 0..<modules[module_index].functions.len() {
            name_column_set(node_by_key.names, node_by_key.nodes, modules[module_index].functions[function_index].key, places.len())
            places.push(SemaPureRootPosition{module_index: module_index, function_index: function_index})
        }
    }
    // One call index serves every module; each lookup names its module.
    calls: SemaEffectCallIndex{modules: loop module_row in modules -> sema_effect_module_calls(module_row.call_facts), node_by_key: node_by_key, interner: interner_empty()}
    at: sema_effect_node_index(calls.node_by_key, entry_key) ?? return None
    root: modules[places[at].module_index].functions[places[at].function_index]
    ^visited: loop _ in places -> false
    ^path: [String]{}
    sema_pure_root_function(root.name, modules, decls, symbols, places, calls, root, at, false, shallow, visited, path)
}
