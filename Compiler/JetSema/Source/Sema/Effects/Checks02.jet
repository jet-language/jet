fn authority_boundary_spans(expr: Expr) -> HashSet[Span] Never! {
    spans := HashSet[Span].new() // GATE #4499: Span equality/hash.
    expr.for_each_expr(fn(nested: Expr) Never! {
        if nested == {
            .Call(call) -> {
                loop arg in call.args {
                    if arg.flags.authority_boundary { arg.expr.for_each_expr(fn(value: Expr) Never! { _ :: spans.insert(value.span()) }) }
                }
            }
            .CallValue{args, ..} | .MethodCall{args, ..} -> {
                loop arg in args {
                    if arg.flags.authority_boundary { arg.expr.for_each_expr(fn(value: Expr) Never! { _ :: spans.insert(value.span()) }) }
                }
            }
            _ -> {}
        }
    })
    spans
}
