fn stmt_handle_escape(stmt: Stmt, handle: String) -> Span? Never! {
    block :: fn(body: [Stmt]) -> Span? Never! {
        loop s in body { if stmt_handle_escape(s, handle) == .Val(span) -> return Val(span) }
