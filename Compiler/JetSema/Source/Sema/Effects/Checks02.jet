            .Impl(i) -> { loop m in i.methods { check_one(m, Val(i.type_name), module_alias, reaches_secret, diags) } }
            .Struct(s) -> {
                loop m in s.methods { check_one(m, Val(s.name), module_alias, reaches_secret, diags) }
                loop block in s.trait_impls { loop m in block.methods { check_one(m, Val(s.name), module_alias, reaches_secret, diags) } }
            }
            .Enum(e) -> { loop m in e.methods { check_one(m, Val(e.name), module_alias, reaches_secret, diags) } }
            _ -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:3565
pub fn e1264(fn_name: String, span: Span) -> Diagnostic {
    diagnostic :: Diagnostic.error("E1264", "`{fn_name}` reads a secret but doesn't declare the `Secret` effect",
        "reading a secret (`core.crypto.vault.get`) always requires an explicit grant — unlike other effects, there is no silently-inferred default here, so a function must opt in even with no other explicit effect row at all.",
        "add `-[Secret]>` to `{fn_name}`'s signature (or widen an existing effect row to cover it)", Val(span))
    row :: RightsRow.invocation([], [], RightsProvenance.new(fn_name, "implicit Secret grant rights row"))
    effects :: Holds.from([String]{Effect.Secret.name().to_string()})
    rights_frame(diagnostic, row, effects, [String]{fn_name.to_string()}, [])
}

// Rust: crates/jet-sema/src/Sema/Purity.rs:5
pub fn e3401(pure_fn_name: String, call_name: String, path: [String], span: Span) -> Diagnostic {
    why :: if path.is_empty() -> "`{call_name}` is impure, but `{pure_fn_name}` declares `-[]>`"
        else -> "{path.join(\" → \")} calls `{call_name}`, which is impure — the whole call chain must be pure inside `{pure_fn_name}`"
    call_chain := [String].with_capacity(path.len() + 2)
    call_chain.push(pure_fn_name.to_string())
    loop component in path { if call_chain.last() != Val(component) { call_chain.push(component.clone()) } }
    if call_chain.last() != Val(call_name) { call_chain.push(call_name.to_string()) }
    fix :: if path.is_empty() -> "remove the call from `{pure_fn_name}`, or drop the `-[]>` bound from `{pure_fn_name}` so its effects are inferred"
        else -> "remove the call to `{call_name}`, or drop the `-[]>` bound from `{pure_fn_name}` so its effects are inferred"
    Diagnostic.error("E3401", "`{pure_fn_name}` calls the impure function `{call_name}`", why, fix, Val(span))
        .with_rights_chain("pure", ^call_chain, [], None)
}
// Rust: crates/jet-sema/src/Sema/Purity.rs:60
pub fn e3402(call_name: String, span: Span?) -> Diagnostic {
    Diagnostic.error("E3402", "`{call_name}` is not allowed during a sandboxed package build",
        "package builds run with ambient I/O and network access disabled (D-PURE2)",
        "compute this value at compile time or pass it in as a parameter", span)
}
