        .Int(..) | .Float(..) | .Bool(..) | .Unit(..) | .Char(..) | .Absent(_)
        | .ReduceMarker(_, _) | .Todo{..} | .NoElse(_) | .UnitLit{..}
        | .ComptimeName{..} | .StrMatchLit(_, _) | .BinMatchLit(_, _) -> return None
    }
    None
}

// Rust: crates/jet-sema/src/Sema/Effects.rs:3309
pub fn e0712(over: EffectSet, caps: EffectSet, span: Span, marker: String) -> Diagnostic {
    over_list :: show_set(over)
    caps_list :: if caps.is_empty() -> "no effects" else -> "`{show_set(caps)}`"
    row :: RightsRow.invocation(caps, [], RightsProvenance.new(marker, "block authority rights row"))
    call_chain :: [String]{"#{marker}"}
    scope_chain :: [ScopeFrame]{ScopeFrame.new(Scope.Block, "#{marker}", caps.clone(), RightsProvenance.new(marker, "lexical block authority scope"))}
    rights_frame(Diagnostic.error("E0712", "this `#{marker}` region uses the effect `{over_list}`, which it has no authority for",
        "`#{marker}(…)` allows only {caps_list}; an effect reached inside — even through a call — must be in that list",
        "add `{over_list}` to the `#{marker}(…)` list, or move that work outside the region", Val(span)),
        row, over, call_chain, scope_chain)
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:3356
pub fn e0711(handle: String, marker: String, span: Span) -> Diagnostic {
    Diagnostic.error("E0711", "the `Authority` handle `{handle}` can't escape its `#{marker}` block",
        "`#{marker}(…)` revokes the `Authority` at the end of its block (RAII); returning, storing, or sharing `{handle}` would let revoked rights outlive the scope",
        "use `{handle}` only inside the `#{marker}` block, or perform the work there", Val(span))
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:3370
pub fn unknown_effect(name: String, span: Span) -> Diagnostic {
    Diagnostic.error("E0119", "`{name}` isn't a known effect",
        "an effect list names compiler-known effects like `Net`, `FS`, `IO`, `DB`, or `Time`",
        "use one of the known effect names, or remove it from the list", Val(span))
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:3383
pub fn e0742(trait_name: String, method: String, over: EffectSet, bound: EffectSet, span: Span) -> Diagnostic {
    e0742_with_chain(trait_name, method, over, bound, span, [])
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:3393
fn e0742_with_chain(trait_name: String, method: String, over: EffectSet, bound: EffectSet, span: Span, call_chain: [String]) -> Diagnostic {
    over_list :: show_set(over)
    bound_desc :: if bound.is_empty() -> "`{trait_name}` bounds `{method}` to `-[]>`, so impls must be pure"
        else -> "`{trait_name}` bounds `{method}` to `-[{show_set(bound)}]>`, so impls may use only those"
    row :: RightsRow.invocation(bound, [], RightsProvenance.new("{trait_name}::{method}", "trait method rights row"))
    rights_frame(Diagnostic.error("E0742", "this `{method}` impl uses the effect `{over_list}`, which the trait doesn't allow",
        "{bound_desc}; `{over_list}` is outside that bound",
        "remove the `{over_list}` work from this impl, or widen the bound on the trait method", Val(span)),
        row, over, call_chain, [])
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:3449
pub fn check_trait_obligations(impls: [(String, String, String, Span)], trait_bounds: [(String, String):EffectSet], solved: [String:EffectSet], diags: &[Diagnostic]) Never! {
    // GATE #4499: composite trait/method map keys retain exact equality/hash.
    loop (trait_name, type_name, method, span) in impls {
        if trait_bounds.get((trait_name.clone(), method.clone())) == .Val(bound) {
            key :: "{type_name}::{method}"
            inferred :: solved.get(key).cloned().unwrap_or_default()
            over :: effects_uncovered(inferred, bound)
            if !over.is_empty() { diags.push(e0742_with_chain(trait_name, method, over, bound, span, [String]{key.clone()})) }
        }
    }
}

