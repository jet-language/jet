fn expr_handle_escape(e: Expr, handle: String) -> Span? Never! {
    if e == {
        .Ident(n, span) -> { if n == handle -> return Val(span) }
        .MethodCall{receiver, args, ..} -> {
            if !is_bare_handle(receiver, handle) {
                if expr_handle_escape(receiver, handle) == .Val(span) -> return Val(span)
            }
            loop a in args {
                // Bare-handle receivers scan every argument; other calls skip
                // checked delegated boundary values, matching the Rust walk.
                if !is_bare_handle(receiver, handle) && a.flags.authority_boundary -> continue
                if expr_handle_escape(a.expr, handle) == .Val(span) -> return Val(span)
            }
        }
        .Field(receiver, _, _) | .Deref(receiver, _) -> {
            if !is_bare_handle(receiver, handle) -> return expr_handle_escape(receiver, handle)
        }
        .OptField{base, ..} -> { if !is_bare_handle(base, handle) -> return expr_handle_escape(base, handle) }
        .Try(inner, _, _, note) -> {
            if !is_bare_handle(inner, handle) {
                if expr_handle_escape(inner, handle) == .Val(span) -> return Val(span)
            }
            if note == .Val(note) -> return expr_handle_escape(note, handle)
        }
        .Index{base, index, ..} -> {
            if !is_bare_handle(base, handle) {
                if expr_handle_escape(base, handle) == .Val(span) -> return Val(span)
            }
            return expr_handle_escape(index, handle)
        }
        .Unary(_, inner, _) | .RawOf(inner, _) | .Copy(inner, _) | .Place(inner, _, _)
        | .Tainted(inner, _, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _)
        | .Paren(inner, _) | .Spread(inner, _) -> return expr_handle_escape(inner, handle)
        .MemberSpread{base, ..} -> return expr_handle_escape(base, handle)
        .Binary(_, l, r, _) -> return expr_handle_escape(l, handle).or_else(fn() Never! { expr_handle_escape(r, handle) })
        .CompareChain{operands, ..} -> { loop value in operands { if expr_handle_escape(value, handle) == .Val(span) -> return Val(span) } }
        .Call(c) -> {
            loop a in c.args { if !a.flags.authority_boundary { if expr_handle_escape(a.expr, handle) == .Val(span) -> return Val(span) } }
        }
        .CallValue{callee, args, ..} -> {
            if expr_handle_escape(callee, handle) == .Val(span) -> return Val(span)
            loop a in args { if !a.flags.authority_boundary { if expr_handle_escape(a.expr, handle) == .Val(span) -> return Val(span) } }
        }
        .Slice{base, start, end, range, ..} -> {
            if expr_handle_escape(base, handle) == .Val(span) -> return Val(span)
            if range == .Val(range) -> return expr_handle_escape(range, handle)
            return expr_handle_escape(start, handle).or_else(fn() Never! { expr_handle_escape(end, handle) })
        }
        .Range{start, end, ..} -> return expr_handle_escape(start, handle).or_else(fn() Never! { expr_handle_escape(end, handle) })
        .ListLit(elems, _) -> { loop el in elems { if expr_handle_escape(el, handle) == .Val(span) -> return Val(span) } }
        .TupleLit(fields, _, _) -> { loop (_, value) in fields { if expr_handle_escape(value, handle) == .Val(span) -> return Val(span) } }
        .MapLit(entries, _) -> {
            loop (k, v) in entries { if expr_handle_escape(k, handle).or_else(fn() Never! { expr_handle_escape(v, handle) }) == .Val(span) -> return Val(span) }
        }
        .StructLit{fields, ..} -> { loop (_, _, f) in fields { if expr_handle_escape(f, handle) == .Val(span) -> return Val(span) } }
        .TypedLit{body, ..} -> {
            found := None
            body.for_each_expr(fn(f: Expr) Never! { if found.is_none() { found = expr_handle_escape(f, handle) } })
            return found
        }
        .EnumLit{args, ..} -> {
            loop a in args {
                if a == {
                    .Positional(value) -> { if expr_handle_escape(value, handle) == .Val(span) -> return Val(span) }
                    .Named{expr, ..} -> { if expr_handle_escape(expr, handle) == .Val(span) -> return Val(span) }
                }
            }
        }
        .OrFallback{value, fallback, ..} -> {
            if expr_handle_escape(value, handle) == .Val(span) -> return Val(span)
            if fallback == {
                .Value(value) -> return expr_handle_escape(value, handle)
                .Block{body, value, ..} -> {
                    loop stmt in body { if stmt_handle_escape(stmt, handle) == .Val(span) -> return Val(span) }
