    expr.for_each_expr(fn(nested: Expr) Never! {
        if found.is_some() -> return
        args := None
        if nested == {
            .Call(call) -> args = Val(call.args)
            .CallValue{args: values, ..} | .MethodCall{args: values, ..} -> args = Val(values)
            _ -> {}
