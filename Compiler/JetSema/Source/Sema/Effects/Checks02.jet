pub fn check_inferred_purity(items: [Item], module_alias: String, summaries: [String:EffectSummary], solved: [String:EffectSet], reachability: ReachabilityResult, diags: &[Diagnostic]) Never! {
    // Rust: crates/jet-sema/src/Sema/Effects.rs:1756
    fn check_one(f: Func, owner: String?, identity: String?, module_alias: String, summaries: [String:EffectSummary], solved: [String:EffectSet], reachability: ReachabilityResult, diags: &[Diagnostic]) Never! {
        if !f.is_pure && !f.is_comptime {
            check_inferred_memo(f, owner, identity, module_alias, solved, diags)
            return
        }
        id :: identity.unwrap_or_else(fn() { effect_key(owner, f.name) })
        key :: "{module_alias}::{id}"
        if solved.get(key).map_or(true, fn(row: EffectSet) { row.is_empty() }) -> return
        row :: if f.is_comptime -> RightsRow.comptime(RightsProvenance.new(key.clone(), "comptime callable rights row"))
            else -> RightsRow.pure(RightsProvenance.new(key.clone(), "declared pure callable rights row"))
        denial := None
        if solved.get(key) == .Val(effects) {
            loop effect in effects {
                if reachability.path("effects", key, effect) == .Val(path) {
                    if path.len() > 1 {
                        effects :: Holds.from([String]{effect.clone()})
                        denials :: row.walk(effects, path, []).denials
                        if denials.first() == .Val(first) { denial = Val(first.clone()); break }
                    }
                }
            }
        }
        // Direct ambient operations are reported at their precise body call span.
        if denial == .Val(denial) {
            chain :: denial.chain.call_chain.get(1..).unwrap_or([])
            if chain.first() == .Val(first) {
                span := f.name_span
                if summaries.get(key) == .Val(summary) {
                    loop call in summary.memory.calls { if call.callee == first { span = call.span; break } }
                }
                call_name :: chain.last().expect("non-empty chain")
                // E0743 already names this explicit ceiling; do not stack E3401.
                if summaries.get(call_name).is_some_and(fn(summary: EffectSummary) { summary.unbounded_trait_dispatch }) -> return
                path := [String]{}
                if chain.len() > 1 {
                    path.push(f.name.clone())
                    loop name in chain[..chain.len() - 1] { path.push(inferred_purity_display_name(module_alias, name).to_string()) }
                }
                diagnostic :: e3401(f.name, inferred_purity_display_name(module_alias, call_name), path, span)
                display_call_chain :: diagnostic.call_chain.clone()
                effects :: Holds.from([String]{denial.right.clone()})
                diags.push(rights_frame(diagnostic, row, effects, display_call_chain, denial.chain.scope_chain))
            }
        }
    }
    // Rust: crates/jet-sema/src/Sema/Effects.rs:1860
    // An omitted effect arrow is judged after solving; Panic/Mem are deny-only.
    fn check_inferred_memo(f: Func, owner: String?, identity: String?, module_alias: String, solved: [String:EffectSet], diags: &[Diagnostic]) Never! {
        loop marker in f.markers {
            if marker.name != Syntax.MARKER_MEMO -> continue
            id :: identity.unwrap_or_else(fn() { effect_key(owner, f.name) })
            key :: "{module_alias}::{id}"
            if solved.get(key) == .Val(row) {
                impure :: effects_uncovered(row, EffectSet.new())
                if impure.is_empty() -> return
                names := [String]{}
                loop name in impure { names.push(name.clone()) }
                shown :: names.join(", ")
                diags.push(Diagnostic.error("E0938", "`#Memo` requires a pure function",
                    "memoization reuses a completed result, but `{f.name}` uses `{shown}`",
                    "remove the `{shown}` operations from `{f.name}`, or drop `#Memo`", Val(marker.span)))
            }
            return
        }
    }
    loop item in items {
        if item == {
            .Func(f) -> check_one(f, None, None, module_alias, summaries, solved, reachability, diags)
            .Impl(i) -> { loop f in i.methods { check_one(f, Val(i.type_name), None, module_alias, summaries, solved, reachability, diags) } }
            .Struct(s) -> {
                loop f in s.methods { check_one(f, Val(s.name), None, module_alias, summaries, solved, reachability, diags) }
                loop block in s.trait_impls { loop f in block.methods { check_one(f, Val(s.name), None, module_alias, summaries, solved, reachability, diags) } }
            }
            .Enum(e) -> { loop f in e.methods { check_one(f, Val(e.name), None, module_alias, summaries, solved, reachability, diags) } }
            .CodeModule(module) -> {
                if module.body == .Val(body) {
                    loop item in body {
                        if item == .Func(f) {
                            identity :: inline_effect_key(module.name, f.name)
                            check_one(f, None, Val(identity), module_alias, summaries, solved, reachability, diags)
                        }
                    }
                }
            }
            _ -> {}
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Effects.rs:1995
pub fn e0743(trait_method: String, span: Span) -> Diagnostic {
    Diagnostic.error("E0743", "dynamic call `{trait_method}` has no effect bound",
        "a trait value can select any implementation at runtime, so an enclosing effect ceiling needs the trait method's declared upper bound",
        "declare an effect row on `{trait_method}`, such as `-[]>` for pure dispatch, or move this dynamic call outside the bounded function", Val(span))
}

// Rust: crates/jet-sema/src/Sema/Effects.rs:2019
// Seed pass-through callback rows before reachability. Unbounded callbacks
// publish the maximal set; generic row variables are substituted by caller edges.
pub fn apply_effect_via(items: [Item], summaries: &[String:EffectSummary], diags: &[Diagnostic]) Never! {
    // Rust: crates/jet-sema/src/Sema/Effects.rs:2025
    fn one(f: Func, owner: String?, summaries: &[String:EffectSummary], diags: &[Diagnostic]) Never! {
        if f.effect_via == .Val((param, via_span)) {
            parameter := None
            loop p in f.params { if p.name == param { parameter = Val(p); break } }
            if parameter == .Val(p) {
                if p.ty == .Fn{effect_bound, ..} {
                    via_set := EffectSet.new()
                    via_spans := [String:Span]{}
                    maximal := false
                    if effect_bound == .Val(names) {
                        loop (n, ns) in names {
                            if effect_row_var(n).is_some() -> continue
                            if parse_effect_name(n) == .Val(e) {
                                if reject_positive_deny_only_effect(e, ns).is_some() -> continue
                                if !via_spans.contains_key(e) { via_spans[e.clone()] = ns }
                                _ :: via_set.insert(^e)
                            } else { diags.push(unknown_effect(n, ns)) }
                        }
                    } else { maximal = true }
                    key :: effect_key(owner, f.name)
                    entry := summaries.entry(key).or_default()
                    entry.direct.extend(^via_set)
                    entry.direct_spans.extend(^via_spans)
                    entry.maximal = entry.maximal || maximal
                    if maximal { _ :: entry.maximal_span.get_or_insert(via_span) }
                } else { diags.push(e0748_not_callback(f.name, param, p.ty.name(), via_span)) }
            } else { diags.push(e0748_unknown_param(f.name, param, via_span)) }
        }
    }
    loop item in items {
        if item == {
            .Func(f) -> one(f, None, summaries, diags)
            .Impl(i) -> { loop m in i.methods { one(m, Val(i.type_name), summaries, diags) } }
            .Struct(s) -> {
                loop m in s.methods { one(m, Val(s.name), summaries, diags) }
                loop block in s.trait_impls { loop m in block.methods { one(m, Val(s.name), summaries, diags) } }
            }
            .Enum(e) -> { loop m in e.methods { one(m, Val(e.name), summaries, diags) } }
            _ -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:2108
pub fn e0748_unknown_param(fn_name: String, param: String, span: Span) -> Diagnostic {
    Diagnostic.error("E0748", "`-[via {param}]>` on `{fn_name}` names no such parameter",
        "`-[via f]>` publishes the effects of a callback parameter `f`; `{fn_name}` has no parameter called `{param}`",
        "name one of `{fn_name}`'s callback parameters after `via`", Val(span))
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:2122
pub fn e0748_not_callback(fn_name: String, param: String, ty: String, span: Span) -> Diagnostic {
    Diagnostic.error("E0748", "`-[via {param}]>` on `{fn_name}` names a parameter that isn't a callback",
        "`-[via f]>` publishes the effects of a *function* parameter; `{param}` is `{ty}`, not a `fn(…)` type",
        "point `via` at a parameter whose type is a function, or drop the `-[via {param}]>` annotation", Val(span))
}

// Rust: crates/jet-sema/src/Sema/Effects.rs:2140
pub fn check_callback_bounds(summaries: [String:EffectSummary], solved: [String:EffectSet], failed_diagnostic_phases: &HashSet[String], diags: &[Diagnostic]) Never! {
    loop (key, summary) in summaries {
        loop ob in summary.callback_obligations {
            cb := ob.direct.clone()
            if ob.maximal { cb.extend(Effect.all()) }
            loop callee in ob.edges { if solved.get(callee) == .Val(cs) { loop effect in cs { _ :: cb.insert(effect.clone()) } } }
            over :: effects_uncovered(cb, ob.bound)
            call_chain :: [String]{key.clone()}
            if !over.is_empty() {
                _ :: failed_diagnostic_phases.insert(key.clone())
                diags.push(e0747_with_chain(over, ob.bound, ob.span, call_chain))
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Effects.rs:2174
pub fn check_discarded_results(summaries: [String:EffectSummary], all_summaries: [String:EffectSummary], solved: [String:EffectSet], infallible: HashSet[String], diags: &[Diagnostic]) Never! {
    facts := [&DiscardedResultFact]{}
    loop summary in summaries.values() {
        loop fact in summary.discarded_results {
            if all_summaries.get(fact.callee) == .Val(callee) {
                if (fact.failure_open && !infallible.contains(fact.callee)) || callee.maximal || callee.unbounded_trait_dispatch -> continue
                if solved.get(fact.callee) == .Val(row) {
                    only_mem := true
                    loop effect in row { if effect_root(effect) != Effect.Mem.name() { only_mem = false; break } }
                    if only_mem { facts.push(&fact) }
                }
            }
        }
    }
    facts.sort_by_key(fn(fact: DiscardedResultFact) { (fact.span.start, fact.span.end) })
    facts.dedup_by_key(fn(fact: DiscardedResultFact) { (fact.span.start, fact.span.end) })
    loop fact in facts { diags.push(e0433(fact)) }
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:2204
pub fn e0433(fact: DiscardedResultFact) -> Diagnostic {
    Diagnostic.error("E0433", "the result of `{fact.call_text}` is thrown away",
        "`{fact.callee_name}` is pure (it has no effects and changes nothing through `&`), so this line does nothing",
        "use the result, bind it with `result :: {fact.call_text}`, or write `.drop(\"reason\")` if dropping it is intended", Val(fact.span))
        .with_source_derived_suggestion(Span.new(fact.span.start, fact.span.start), "result :: ")
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:2225
pub fn e0433_lost_tail(function: String, value_type: String, span: Span) -> Diagnostic {
    Diagnostic.error("E0433", "this {value_type} value is thrown away",
        "`{function}` has no return type, so it returns nothing and the value of its last line is lost",
        "if `{function}` should return it, write `-> {value_type}` after its parameter list; to discard it on purpose, write `.drop(\"reason\")`", Val(span))
}

// Rust: crates/jet-sema/src/Sema/Effects.rs:2242
pub fn e0747(over: EffectSet, bound: EffectSet, span: Span) -> Diagnostic {
    e0747_with_chain(over, bound, span, [])
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:2246
fn e0747_with_chain(over: EffectSet, bound: EffectSet, span: Span, call_chain: [String]) -> Diagnostic {
    over_list :: show_set(over)
    bound_desc :: if bound.is_empty() -> "the parameter is `fn(…) -[]>`, so the callback must be pure"
        else -> "the parameter is `fn(…) -[{show_set(bound)}]>`, so the callback may use only those effects"
    fix :: if bound.is_empty() -> "pass a `fn(…) -[]>` callback (or a lambda that uses no effects), or widen the parameter's bound"
        else -> "pass a callback within `-[{show_set(bound)}]>`, or add `{over_list}` to the parameter's bound"
    row :: RightsRow.invocation(bound, [], RightsProvenance.new("callback", "callback parameter rights row"))
    rights_frame(Diagnostic.error("E0747",
        "this callback uses the effect `{over_list}`, which the parameter doesn't allow",
        "{bound_desc}; `{over_list}` is outside that bound", fix, Val(span)), row, over, call_chain, [])
}

// Rust: crates/jet-sema/src/Sema/Effects.rs:2297
pub fn check_replayable_effects(items: [Item], solved: [String:EffectSet], diags: &[Diagnostic]) Never! {
    // Rust: crates/jet-sema/src/Sema/Effects.rs:2304
    fn check_one(f: Func, owner: String?, solved: [String:EffectSet], diags: &[Diagnostic]) Never! {
        if !f.is_replayable -> return
        key :: effect_key(owner, f.name)
        inferred :: solved.get(key).cloned().unwrap_or_default()
        row :: RightsRow.replayable(RightsProvenance.new(key, "declared replayable callable rights row"))
        forbidden := EffectSet.new()
        loop denial in row.walk(inferred, [], []).denials { _ :: forbidden.insert(denial.right) }
        if !forbidden.is_empty() { diags.push(e0725(f.name, forbidden, f.replayable_span.unwrap_or(f.name_span))) }
    }
    loop item in items {
        if item == {
            .Func(f) -> check_one(f, None, solved, diags)
            .Impl(i) -> { loop m in i.methods { check_one(m, Val(i.type_name), solved, diags) } }
            .Struct(s) -> {
                loop m in s.methods { check_one(m, Val(s.name), solved, diags) }
                loop block in s.trait_impls { loop m in block.methods { check_one(m, Val(s.name), solved, diags) } }
            }
            .Enum(e) -> { loop m in e.methods { check_one(m, Val(e.name), solved, diags) } }
            _ -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:2364
pub fn e0725(fn_name: String, effects: EffectSet, span: Span) -> Diagnostic {
    effect_list :: show_set(effects)
    row :: RightsRow.replayable(RightsProvenance.new(fn_name, "ambient nondeterminism denied by replayable row"))
    rights_frame(Diagnostic.error("E0725", "`{fn_name}` is `#Replayable` but reaches `{effect_list}`",
        "`#Replayable` code must replay from explicit inputs; ambient time, randomness, network, or console IO would make the same replay diverge",
        "inject a deterministic clock/RNG or mockable input, pass recorded data in, or move the ambient effect outside the replayable function", Val(span)),
        row, effects, [String]{fn_name.to_string()}, [])
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:2393
pub fn e0740(fn_name: String, over: EffectSet, declared: EffectSet, span: Span) -> Diagnostic {
    over_list :: show_set(over)
    decl :: if declared.is_empty() -> "no effects" else -> "`-[{show_set(declared)}]>`"
    row :: RightsRow.invocation(declared, [], RightsProvenance.new(fn_name, "declared effect-arrow rights row"))
    rights_frame(Diagnostic.error("E0740", "`{fn_name}` uses the effect `{over_list}`, which its signature doesn't allow",
        "the signature declares {decl}, so the body may only use those; `{over_list}` is outside that set",
        "add `{over_list}` to the effect list, or stop using it in `{fn_name}`", Val(span)),
        row, over, [String]{fn_name.to_string()}, [])
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:2436
pub fn e0749(fn_name: String, reached: EffectSet, prohibited: EffectSet, span: Span) -> Diagnostic {
    reached_list :: show_set(reached)
    decl_list :: show_set(prohibited)
    row :: RightsRow.invocation([], prohibited, RightsProvenance.new(fn_name, "prohibited effect rights row"))
    rights_frame(Diagnostic.error("E0749", "`{fn_name}` reaches the `{reached_list}` effect, which it prohibits with `-[!{decl_list}]>`",
        "a `-[!{decl_list}]>` row means the function and every callee it can reach must not use `{reached_list}`",
        "remove the call that introduces `{reached_list}`, or drop the `-[!{decl_list}]>` prohibition", Val(span)),
        row, reached, [String]{fn_name.to_string()}, [])
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:2471
pub fn e0749_panic(fn_name: String, panic_site: String, prohibited: EffectSet, span: Span) -> Diagnostic {
    prohibition :: show_set(prohibited)
    row :: RightsRow.invocation([], prohibited, RightsProvenance.new(fn_name, "Panic prohibition rights row"))
    effects :: Holds.from([String]{Effect.Panic.name().to_string()})
    rights_frame(Diagnostic.error("E0749", "`{fn_name}` can stop, but Panic is denied here",
        "`{panic_site}` can stop; `{fn_name}` and every reachable callee must not stop when Panic is denied",
        "return a fallible result for expected failure, add facts or a `#Pre`/refinement proof for a programmer-error stop, or drop the `-[!{prohibition}]>` prohibition", Val(span)),
        row, effects, [String]{fn_name.to_string(), panic_site.to_string()}, [])
}

// Rust: crates/jet-sema/src/Sema/Effects.rs:2507
pub fn check_region_caps(summaries: [String:EffectSummary], solved: [String:EffectSet], failed_diagnostic_phases: &HashSet[String], diags: &[Diagnostic]) Never! {
    loop (key, summary) in summaries {
        loop region in summary.regions {
            inferred := region.direct.clone()
            if region.maximal { inferred.extend(Effect.all()) }
            loop callee in region.edges { if solved.get(callee) == .Val(cs) { loop effect in cs { _ :: inferred.insert(effect.clone()) } } }
            over :: effects_uncovered(inferred, region.caps)
            if !over.is_empty() {
                _ :: failed_diagnostic_phases.insert(key.clone())
                diags.push(e0712(over, region.caps, region.caps_span, Syntax.KW_FX))
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Effects.rs:2543
// Erased/debug bodies are checked but must not publish AST-attached authority facts.
fn erased_scope_spans(body: [Stmt], spans: &HashSet[Span]) Never! {
    loop statement in body {
        if statement == .Switched{marker, ..} {
            if switched_off(marker) || marker.name == Syntax.MARKER_DEBUG_ONLY {
                _ :: spans.insert(statement.span())
                continue
            }
        }
        loop nested in statement_bodies(statement) { erased_scope_spans(nested, spans) }
        statement.for_each_expr(fn(expression: Expr) Never! {
            if expression == {
                .If{then_body, else_body, ..} -> {
                    erased_scope_spans(then_body, spans)
                    erased_scope_spans(else_body, spans)
                }
                .Lambda(lambda) -> { if lambda.body == .Block(body) { erased_scope_spans(body, spans) } }
                .OrFallback{fallback, ..} -> { if fallback == .Block{body, ..} { erased_scope_spans(body, spans) } }
                _ -> {}
            }
        })
    }
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:2588
fn expression_is_erased(expression: Expr, spans: HashSet[Span]) -> Bool {
    span :: expression.span()
    loop scope in spans { if scope.start <= span.start && span.end <= scope.end -> return true }
    false
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:2597
fn for_each_active_expression(body: [Stmt], visit: fn(Expr) Never!) Never! {
    erased := HashSet[Span].new() // GATE #4499: Span equality/hash.
    erased_scope_spans(body, &erased)
    loop statement in body {
        statement.for_each_expr(fn(expression: Expr) Never! {
            if !expression_is_erased(expression, erased) { visit(expression) }
        })
    }
}

// Rust: crates/jet-sema/src/Sema/Effects.rs:2622
pub fn grant_handle_escape(body: [Stmt], handle: String) -> Span? Never! {
    loop s in body { if stmt_handle_escape(s, handle) == .Val(span) -> return Val(span) }
    grant_derived_handle_escape(body, handle)
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:2632
pub fn authority_delegations(body: [Stmt], binding: String, scope_span: Span) -> [AuthorityDelegation] Never! {
    // Rust: crates/jet-sema/src/Sema/Effects.rs:2637
    fn operation_parts(name: String) -> (String, String) {
        if name.rsplit_once('.') == .Val((resource, operation)) -> return (resource.to_string(), operation.to_string())
        ("core", name.to_string())
    }
    delegations := [AuthorityDelegation]{}
    for_each_active_expression(body, fn(expression: Expr) Never! {
        if expression == {
            .Call(call) -> {
                (resource, operation) :: operation_parts(call.name)
                loop argument in call.args {
                    if argument.flags.authority_boundary {
                        delegations.push(AuthorityDelegation{scope_span: scope_span, binding: binding.to_string(),
                            resource: resource.clone(), operation: operation.clone(), span: argument.span})
                    }
                }
            }
            .MethodCall{method, args, ..} -> {
                loop argument in args {
                    if argument.flags.authority_boundary {
                        delegations.push(AuthorityDelegation{scope_span: scope_span, binding: binding.to_string(),
                            resource: "method", operation: method.clone(), span: argument.span})
                    }
                }
            }
            _ -> {}
        }
    })
    delegations
}

// Rust: crates/jet-sema/src/Sema/Effects.rs:2677
fn authority_expr_rights(regions: [RegionAccum], expr: Expr) -> EffectSet? Never! {
    if expr == {
        .Ident(name, _) -> {
            loop region in regions.iter().rev() {
                if region.binding == Val(name) -> return Val(region.caps.clone())
                if region.aliases.get(name) == .Val(rights) -> return Val(rights.clone())
            }
        }
        .Paren(inner, _) -> return authority_expr_rights(regions, inner)
        .MethodCall{receiver, method, args, ..} -> {
            if method != "with" && method != "without" -> return None
            if authority_expr_rights(regions, receiver) == .Val(rights_value) {
                rights := ^rights_value
                requested := None
                if args.first() == .Val(arg) {
                    if arg.expr == .Str(parts, _) {
                        text := ""
                        literal := true
                        loop part in parts {
                            if part == .Lit(piece) { text.push_str(piece) } else { literal = false; break }
                        }
                        if literal { requested = parse_right(text) }
                    }
                }
                if requested == .Val(requested) {
                    if method == "with" {
                        covered := false
                        loop bound in rights { if effect_covers(bound, requested) { covered = true; break } }
                        if covered { rights.clear(); _ :: rights.insert(^requested) }
                    } else {
                        rights.retain(fn(held: String) { !effect_covers(requested, held) })
                    }
                }
                return Val(^rights)
            }
        }
        _ -> {}
    }
    None
}
// Rust: crates/jet-sema/src/Sema/Effects.rs:2730
pub fn check_authority_boundary_scope(checker: &Checker, expr: Expr) Never! {
    if authority_expr_rights(checker.region_stack, expr) == .Val(rights) {
