        .Expr(e) | .Yield(e, _) | .DeferClose{close: e, ..} -> return expr_handle_escape(e, handle)
        .Val(b) -> return expr_handle_escape(b.init, handle)
        .Assign{value, ..} -> return expr_handle_escape(value, handle)
        .Return(.Val(e), _) | .BreakValue(e, _) | .BreakLabelValue(_, _, e, _) -> return expr_handle_escape(e, handle)
        .While{cond, body, ..} -> return expr_handle_escape(cond, handle).or_else(fn() Never! { block(body) })
        .For{kind, body, ..} -> {
            coll := None
            if kind == {
                .Range{start, end, step, ..} -> {
                    coll = expr_handle_escape(start, handle).or_else(fn() Never! { expr_handle_escape(end, handle) })
                    if coll.is_none() && step == .Val(s) { coll = expr_handle_escape(s, handle) }
                }
                .In{collection, step} -> {
                    coll = expr_handle_escape(collection, handle)
                    if coll.is_none() && step == .Val(s) { coll = expr_handle_escape(s, handle) }
                }
            }
            return coll.or_else(fn() Never! { block(body) })
        }
        .Switch{subject, arms, else_body, ..} | .ComptimeSwitch{subject, arms, else_body, ..} -> {
            if expr_handle_escape(subject, handle) == .Val(span) -> return Val(span)
            loop a in arms { if expr_handle_escape(a.cond, handle).or_else(fn() Never! { block(a.body) }) == .Val(span) -> return Val(span) }
            if else_body == .Val(body) -> return block(body)
        }
        .CountedLoop{init, cond, step, body, ..} -> {
            found :: expr_handle_escape(init.init, handle).or_else(fn() Never! { expr_handle_escape(cond, handle) }).or_else(fn() Never! { block(body) })
            if found.is_some() -> return found
            if step == .Val(step) -> return stmt_handle_escape(step, handle)
        }
        .Switched{marker, body, ..} -> {
            if switched_off(marker) || marker.name == Syntax.MARKER_DEBUG_ONLY -> return None
            return block(body)
        }
        .Loop{body, ..} | .Unsafe{body, ..} | .Impure{body, ..} | .Reactive{body, ..}
        | .Shield{body, ..} | .Region{body, ..} | .Policy{body, ..} | .TaskGroup{body, ..}
        | .Layout{body, ..} | .AuthorityScope{body, ..} | .Transact{body, ..}
        | .AssumeDet{body, ..} | .ScopeMember{body, ..} | .Live{body, ..} -> return block(body)
        .ComptimeBlock{..} -> return None
