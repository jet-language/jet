                .or_else(fn() Never! { authority_call_argument_escape(cond, handle, aliases) })
            if found.is_none() && step == .Val(step) { found = derived_stmt_escape(step, handle, aliases) }
            if found.is_none() { found = derived_block_escape(body, handle, aliases) }
