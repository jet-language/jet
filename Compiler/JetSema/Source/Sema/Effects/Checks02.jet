//RS /// True when `e` is the bare handle ident (the root of an in-place chain). A bare
//RS /// reference to the handle is a *value-use* (escape) on its own; but as the
//RS /// receiver of a method call / field access / `?` / index it is an in-place use
//RS /// of the capability that does NOT carry it out of scope.
//RS fn is_bare_handle(e: &crate::AST::Expr, handle: &str) -> bool {
//RS     matches!(e, crate::AST::Expr::Ident(n, _) if n == handle)
//RS }
//RS 
//RS /// The span of the first escaping use of `handle` in `e`, or `None`. A bare
//RS /// reference to the handle in value position is an escape; a method-call /
//RS /// field-access / `?` chain rooted at the handle is an in-place use, but the
//RS /// chain's arguments and indices are still scanned (they can carry it out).
//RS fn expr_handle_escape(e: &crate::AST::Expr, handle: &str) -> Option<Span> {
//RS     use crate::AST::{EnumLitArg, Expr, OrFallback, StrPart};
//RS     match e {
//RS         // A bare value-position reference to the handle escapes.
//RS         Expr::Ident(n, span) if n == handle => Some(*span),
//RS         Expr::Ident(_, _) => None,
//RS         // A method call / field / `?` / deref / index whose receiver is the bare
//RS         // handle is an in-place use (performing the authorized effect) — NOT an
//RS         // escape; but the call's args and the index are still scanned.
//RS         Expr::MethodCall { receiver, args, .. } if is_bare_handle(receiver, handle) => {
//RS             args.iter().find_map(|a| expr_handle_escape(&a.expr, handle))
//RS         }
//RS         Expr::Field(receiver, _, _) if is_bare_handle(receiver, handle) => None,
//RS         Expr::OptField { base, .. } if is_bare_handle(base, handle) => None,
//RS         Expr::Try(receiver, _, _, note) if is_bare_handle(receiver, handle) => {
//RS             note.as_deref().and_then(|note| expr_handle_escape(note, handle))
//RS         }
//RS         Expr::Deref(receiver, _) if is_bare_handle(receiver, handle) => None,
//RS         Expr::Index { base, index, .. } if is_bare_handle(base, handle) => {
//RS             expr_handle_escape(index, handle)
//RS         }
//RS         Expr::Unary(_, inner, _)
//RS         | Expr::Deref(inner, _)
//RS         | Expr::RawOf(inner, _)
//RS         | Expr::Copy(inner, _)
//RS         | Expr::Place(inner, _, _)
//RS         | Expr::Tainted(inner, _, _) // D-TAINT1: tag erased; recurse into the value.
//RS         | Expr::Present(inner, _) | Expr::Ok(inner, _) | Expr::Err(inner, _)
//RS         | Expr::Field(inner, _, _) => expr_handle_escape(inner, handle),
//RS         Expr::Try(inner, _, _, note) => expr_handle_escape(inner, handle).or_else(|| {
//RS             note.as_deref().and_then(|note| expr_handle_escape(note, handle))
//RS         }),
//RS         Expr::MemberSpread { base, .. } => expr_handle_escape(base, handle),
//RS         Expr::OptField { base, .. } => expr_handle_escape(base, handle),
//RS         Expr::Binary(_, l, r, _) => {
//RS             expr_handle_escape(l, handle).or_else(|| expr_handle_escape(r, handle))
//RS         }
//RS         Expr::CompareChain { operands, .. } => {
//RS             operands.iter().find_map(|e| expr_handle_escape(e, handle))
//RS         }
//RS         Expr::Call(c) => c
//RS             .args
//RS             .iter()
//RS             .filter(|a| !a.flags.authority_boundary)
//RS             .find_map(|a| expr_handle_escape(&a.expr, handle)),
//RS         Expr::CallValue { callee, args, .. } => expr_handle_escape(callee, handle)
//RS             .or_else(|| {
//RS                 args.iter()
//RS                     .filter(|a| !a.flags.authority_boundary)
//RS                     .find_map(|a| expr_handle_escape(&a.expr, handle))
//RS             }),
//RS         Expr::MethodCall { receiver, args, .. } => expr_handle_escape(receiver, handle)
//RS             .or_else(|| {
//RS                 args.iter()
//RS                     .filter(|a| !a.flags.authority_boundary)
//RS                     .find_map(|a| expr_handle_escape(&a.expr, handle))
//RS             }),
//RS         Expr::Index { base, index, .. } => {
//RS             expr_handle_escape(base, handle).or_else(|| expr_handle_escape(index, handle))
//RS         }
//RS         Expr::Slice { base, start, end, range, .. } => expr_handle_escape(base, handle)
//RS             .or_else(|| {
//RS                 range.as_deref().map_or_else(
//RS                     || {
//RS                         expr_handle_escape(start, handle)
//RS                             .or_else(|| expr_handle_escape(end, handle))
//RS                     },
//RS                     |range| expr_handle_escape(range, handle),
//RS                 )
//RS             }),
//RS         Expr::Range { start, end, .. } => {
//RS             expr_handle_escape(start, handle).or_else(|| expr_handle_escape(end, handle))
//RS         }
//RS         Expr::ListLit(elems, _) => elems.iter().find_map(|el| expr_handle_escape(el, handle)),
//RS         Expr::TupleLit(fields, _, _) => {
//RS             fields.iter().find_map(|(_, e)| expr_handle_escape(e, handle))
//RS         }
//RS         Expr::MapLit(entries, _) => entries
//RS             .iter()
//RS             .find_map(|(k, v)| expr_handle_escape(k, handle).or_else(|| expr_handle_escape(v, handle))),
//RS         Expr::StructLit { fields, .. } => {
//RS             fields.iter().find_map(|(_, _, f)| expr_handle_escape(f, handle))
//RS         }
//RS         Expr::TypedLit { body, .. } => {
//RS             let mut found = None;
//RS             body.for_each_expr(|f| {
//RS                 if found.is_none() {
//RS                     found = expr_handle_escape(f, handle);
//RS                 }
//RS             });
//RS             found
//RS         }
//RS         Expr::EnumLit { args, .. } => args.iter().find_map(|a| match a {
//RS             EnumLitArg::Positional(e) => expr_handle_escape(e, handle),
//RS             EnumLitArg::Named { expr, .. } => expr_handle_escape(expr, handle),
//RS         }),
//RS         Expr::OrFallback { value, fallback, .. } => expr_handle_escape(value, handle).or_else(|| {
//RS             match fallback {
//RS                 OrFallback::Value(e) => expr_handle_escape(e, handle),
//RS                 OrFallback::Block { body, value, .. } => body
//RS                     .iter()
//RS                     .find_map(|stmt| stmt_handle_escape(stmt, handle))
//RS                     .or_else(|| value.as_ref().and_then(|value| expr_handle_escape(value, handle))),
//RS                 OrFallback::Return(Some(e), _) => expr_handle_escape(e, handle),
//RS                 _ => None,
//RS             }
//RS         }),
//RS         Expr::PatternTest { subject, .. } => expr_handle_escape(subject, handle),
//RS         Expr::Str(parts, _) => parts.iter().find_map(|p| match p {
//RS             StrPart::Interp(e, _) => expr_handle_escape(e, handle),
//RS             _ => None,
//RS         }),
//RS         Expr::If { cond, then_body, then_value, else_body, else_value, .. } => {
//RS             expr_handle_escape(cond, handle)
//RS                 .or_else(|| expr_handle_escape(then_value, handle))
//RS                 .or_else(|| expr_handle_escape(else_value, handle))
//RS                 .or_else(|| then_body.iter().find_map(|s| stmt_handle_escape(s, handle)))
//RS                 .or_else(|| else_body.iter().find_map(|s| stmt_handle_escape(s, handle)))
//RS         }
//RS         Expr::PtrFromAddr { addr, .. } => expr_handle_escape(addr, handle),
//RS         // A lambda that captures the handle smuggles it out — the closure can
//RS         // outlive the scope. Count a reference unless a lambda param shadows the
//RS         // handle name (then it's a different binding, not a capture).
//RS         Expr::Lambda(l) => {
//RS             let shadowed = l.params.iter().any(|p| p.name == handle)
//RS                 || l.take_names.iter().any(|(n, _)| n == handle);
//RS             if !shadowed && super::lambda_body_refs_name(&l.body, handle) {
//RS                 Some(l.span)
//RS             } else {
//RS                 None
//RS             }
//RS         }
//RS         Expr::Int(..)
//RS         | Expr::Float(..)
//RS         | Expr::Bool(..)
//RS         | Expr::Unit(..)
//RS         | Expr::Char(..)
//RS         | Expr::Absent(_)
//RS         | Expr::ReduceMarker(_, _)
//RS         | Expr::Todo { .. }
//RS         | Expr::NoElse(_)
//RS         | Expr::UnitLit { .. }
//RS         | Expr::ComptimeName { .. }
//RS         // D-SHIFT1 (c7shift) / D-BINPAT1 (card #506 follow-up): a leaf
//RS         // literal, no nested `Expr` to recurse into.
//RS         | Expr::StrMatchLit(_, _)
//RS         | Expr::BinMatchLit(_, _) => None,
//RS         Expr::Paren(inner, _) => expr_handle_escape(inner, handle),
//RS         Expr::Spread(inner, _) => expr_handle_escape(inner, handle),
//RS     }
//RS }
