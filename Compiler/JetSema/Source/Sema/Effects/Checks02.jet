//RS /// U13 (D-JPK-SECRETCRYPTO1): unlike every other effect, `Secret` is denied
//RS /// even with no declared bound at all — `core.crypto.vault.get` demands an explicit
//RS /// `#(Secret)` (or a wider declared bound covering it) on the calling
//RS /// function; a bare `fn` with no `#(…)` list, or one that omits `Secret`, is
//RS /// E1264. A helper fn two calls deep from the actual `core.crypto.vault.get` still
//RS /// requires the grant on itself — the same call-graph reach E0740 checks —
//RS /// but this deliberately uses the dedicated `secret` row rather than the
//RS /// general `effects` row: unannotated foreign calls seed every grantable root,
//RS /// while language-tagged calls seed their `FFI.*` leaf; neither proves a
//RS /// specific secret read.
//RS pub(crate) fn check_secret_grants(
//RS     items: &[crate::AST::Item],
//RS     module_alias: &str,
//RS     reaches_secret: &BTreeSet<String>,
//RS     diags: &mut Vec<Diagnostic>,
//RS ) {
//RS     fn declared_set(f: &crate::AST::Func) -> EffectSet {
//RS         let mut declared = EffectSet::new();
//RS         let Some(list) = &f.declared_effects else {
//RS             return declared;
