        | .Live{body, ..} | .Transact{body, ..} | .TaskGroup{body, ..} | .Layout{body, ..}
        | .AssumeDet{body, ..} | .ScopeMember{body, ..} -> return derived_block_escape(body, handle, aliases)
        .ComptimeBlock{..} -> return None
        .ComptimeIf{cond, then_body, else_body, ..} -> {
            if authority_call_argument_escape(cond, handle, aliases)
                .or_else(fn() Never! { derived_block_escape(then_body, handle, aliases) }) == .Val(span) -> return Val(span)
            if else_body == .Val(body) -> return derived_block_escape(body, handle, aliases)
