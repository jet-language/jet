            loop (_, e, _) in fields { if expr_handle_escape(e, handle) == .Val(span) -> return Val(span) }
            return block(body)
        }
        .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) | .Return(.None, _) -> return None
