        .PatternTest{subject, ..} -> return expr_handle_escape(subject, handle)
        .Str(parts, _) -> {
            loop p in parts { if p == .Interp(value, _) { if expr_handle_escape(value, handle) == .Val(span) -> return Val(span) } }
        }
        .If{cond, then_body, then_value, else_body, else_value, ..} -> {
            if expr_handle_escape(cond, handle).or_else(fn() Never! { expr_handle_escape(then_value, handle) })
                .or_else(fn() Never! { expr_handle_escape(else_value, handle) }) == .Val(span) -> return Val(span)
            loop s in then_body { if stmt_handle_escape(s, handle) == .Val(span) -> return Val(span) }
            loop s in else_body { if stmt_handle_escape(s, handle) == .Val(span) -> return Val(span) }
        }
        .PtrFromAddr{addr, ..} -> return expr_handle_escape(addr, handle)
