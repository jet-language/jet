// Trait dispatch: a call through a generic bound (`producer: P` with
// `P: Producer`) is statically selected after type inference. When the trait
// method declares a row, the call has that row. Otherwise, when the receiver's
// type is one of this function's type parameters, the call is a param
// dispatch: the caller that binds the parameter runs the selected
// implementation (sema_effect_resolve_type_params). Any other receiver takes
// the union of every implementation's summary (sema_effect_add_dispatch_union).
// Only a trait-object receiver is the open-world dispatch that stays maximal
// for a row-less method.
sema_effect_record_static_dispatch: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, tree: BodyTree, expression: BodyNode, fact: SemaCallSiteFact) -> Bool Never! {
    if fact.facts.effect_bound != None -> return false
    if expression.kind == {
        .MethodCall(receiver, method, _, _) -> {
            trait_owner: method.trait_owner ?? return false
            receiver_type: body_type(facts.interner, tree, receiver)
            if receiver_type == .TraitObject(_) -> return false
            if sema_effect_node_index(facts.node_by_key, symbol_key(facts.symbols, tree.symbols, method.symbol)) != None {
                return false
            }
            sema_effect_record_memory_open(nodes, node_index, fact.span, "generic trait dispatch has no sealed target set")
            // Implementations group under the trait's own module, from
            // whichever module they are written in (sema_effect_add_trait_impls).
            method_row: sema_effect_method_row(facts.impls, symbol_key(facts.symbols, tree.symbols, trait_owner), method.name)
            if receiver_type == .Named(param) && nodes[node_index].type_params.contains(param) {
                sema_effect_node_rare_open(nodes[node_index])
                if nodes[node_index].rare.in_place() == .Val(rare) {
                    rare.param_dispatches.push(SemaEffectParamDispatch{param: param, method_row: method_row})
                }
                return true
            }
            sema_effect_add_dispatch_union(nodes, facts, node_index, method_row, fact.span)
            true
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> false
    }
}

// Every implementation of method row `method_row` as a call edge of
// `node_index`. An implementing type with no summary of its own for the
// method (a trait default body, an unloaded impl) is unresolved, and so is a
// method no type implements: either forces the maximal row.
sema_effect_add_dispatch_union: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, method_row: Int, span: Span) Never! {
    ^unresolved: method_row < 0
    if method_row >= 0 {
        loop owner in facts.impls.implementers[facts.impls.method_traits[method_row]] {
            if sema_effect_trait_impl_of(facts.impls, method_row, owner) == .Val(impl_key) {
                sema_effect_node_add_edge(nodes, node_index, impl_key)
            } else { unresolved = true }
        }
    }
    if unresolved {
        nodes[node_index].maximal = true
        nodes[node_index].maximal_span = Val(span)
    }
}

// A call that binds type parameters: a method of a generic type (`t.run()`
// with `t: Traced<Loud>`, or `Traced<Loud>.new()`) or a generic function
// with its type arguments.
sema_effect_record_instantiation: fn(nodes: ^[SemaEffectNode], node_index: Int, tree: BodyTree, expression: BodyNode, fact: SemaCallSiteFact, symbols: SymbolTable, interner: Interner) Never! {
    callee: fact.callee ?? return
    ^owner_args: [Type]{}
    ^type_args: [Type]{}
    ^owner_label: ""
    if expression.kind == {
        .MethodCall(receiver, _, args, _) -> {
            receiver_type: body_type(interner, tree, receiver)
            if receiver_type == .Apply(_, values) {
                owner_args = values
                owner_label = type_name(receiver_type)
            }
            type_args = args
        }
        .StaticCall(_, owner_type, _, args, _) -> {
            if owner_type == .Val(owner) {
                if owner == .Apply(_, values) {
                    owner_args = values
                    owner_label = type_name(owner)
                }
            }
            type_args = args
        }
        .Call(_, args, _) -> type_args = args
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> return
    }
    if owner_args.len() == 0 && type_args.len() == 0 {
        return
    }
    ^label: owner_label
    if type_args.len() > 0 {
        shown: (loop arg in type_args -> type_name(arg)).join(", ")
        name: symbol_key_leaf(symbol_key(symbols, tree.symbols, callee))
        label = if owner_label == "" -> "{name}<{shown}>" else -> "{owner_label}.{name}<{shown}>"
    }
    nodes[node_index].instantiations.push(SemaEffectInstantiation{callee: symbol_key(symbols, tree.symbols, callee), owner_args: owner_args, type_args: type_args, label: label, span: fact.span, guards: sema_effect_open_guards(nodes[node_index])})
}

// The owner type's parameters of a method, in the order a receiver's type
// arguments bind them; none when the owner isn't written with bare
// parameters (`impl Box<Int>`), so no site binds them by position.
sema_effect_owner_params: fn(kind: TFuncKind) -> [String] Never! {
    owner_type: if kind == {
        .Method(_, owner) -> owner
        .TraitMethod(_, _, owner, _, _) -> owner
        .TopLevel -> {
            return [String]{}
        }
    }
    ^names: [String]{}
    if owner_type == .Apply(_, args) {
        loop arg in args {
            if arg == .Named(name) -> names.push(name) else -> return [String]{}
        }
    }
    names
}

// The type `site` binds to `callee`'s parameter `param`, if it binds one.
sema_effect_param_binding: fn(callee: SemaEffectNode, site: SemaEffectInstantiation, param: String) -> Type? Never! {
    loop (position, name) in callee.owner_params {
        if name == param {
            if callee.owner_params.len() != site.owner_args.len() -> return None
            return Val(site.owner_args[position])
        }
    }
    ^own: 0
    loop name in callee.type_params {
        if callee.owner_params.contains(name) -> next
        if name == param {
            if own < site.type_args.len() -> return Val(site.type_args[own])
            return None
        }
        own += 1
    }
    None
}

sema_effect_has_param_dispatch: fn(rows: [SemaEffectParamDispatch], wanted: SemaEffectParamDispatch) -> Bool Never! {
    loop row in rows {
        if row.param == wanted.param && row.method_row == wanted.method_row -> return true
    }
    false
}

// What a type or function parameter does belongs to the caller that binds
// it: `Traced<Parser>` does Traced's work plus Parser's, charged where
// `Traced<Parser>` is written. A function's own row leaves out its param
// dispatches. A site that binds a parameter to one of its caller's own
// parameters forwards the dispatch to the caller (a fixed point). A site that
// binds it to a concrete type adds that type's implementation as the
// caller's call edge and an instance reach naming the instantiation. A
// binding the walk didn't see (a call recorded without its type arguments,
// or a type with no implementation of its own) takes every implementation,
// as an unbound generic dispatch does.
sema_effect_resolve_type_params: fn(nodes: ^[SemaEffectNode], calls: SemaEffectCallIndex) Never! {
    ^open: loop node in nodes -> if node.rare == .Val(rare) -> rare.param_dispatches.copy() else -> [SemaEffectParamDispatch]{}
    ^changed: true
    loop changed {
        changed = false
        loop index in 0..<nodes.len() {
            loop site in nodes[index].instantiations {
                callee: sema_effect_node_index(calls.node_by_key, site.callee) ?? next
                ^forwarded: [SemaEffectParamDispatch]{}
                loop dispatch in open[callee] {
                    bound: sema_effect_param_binding(nodes[callee], site, dispatch.param) ?? next
                    if bound == .Named(name) && nodes[index].type_params.contains(name) {
                        forwarded.push(SemaEffectParamDispatch{param: name, method_row: dispatch.method_row})
                    }
                }
                loop row in forwarded {
                    if sema_effect_has_param_dispatch(open[index], row) -> next
                    open[index].push(row)
                    changed = true
                }
            }
        }
    }
    loop index in 0..<nodes.len() {
        ^settled: nodes[index].call_edges.len()
        ^bound_callees: [String]{}
        sites: nodes[index].instantiations.copy()
        loop site in sites {
            callee: sema_effect_node_index(calls.node_by_key, site.callee) ?? next
            sema_effect_set_add(bound_callees, site.callee)
            loop dispatch in open[callee] {
                bound: sema_effect_param_binding(nodes[callee], site, dispatch.param)
                if bound == .Val(ty) {
                    if ty == .Named(name) && nodes[index].type_params.contains(name) -> next
                    owner: symbol_key_leaf(type_name(ty))
                    if name_find(calls.impls.names, owner) == .Val(owner_id) {
                        if sema_effect_trait_impl_of(calls.impls, dispatch.method_row, name_index(owner_id)) == .Val(impl_key) {
                            sema_effect_node_add_edge(nodes, index, impl_key)
                            sema_effect_node_rare_open(nodes[index])
                            if nodes[index].rare.in_place() == .Val(rare) {
                                rare.instance_reaches.push(SemaEffectInstanceReach{label: site.label, target: impl_key, span: site.span})
                            }
                            next
                        }
                    }
                }
                sema_effect_add_dispatch_union(nodes, calls, index, dispatch.method_row, site.span)
            }
        }
        // The node's row was settled when it was collected; settle it again
        // only where an implementation was added above, and below. The
        // dispatches below append past the row's first `settled` edges, so
        // those stay in place while they are read.
        if nodes[index].call_edges.len() > settled -> sema_effect_node_settle_edges(nodes[index])
        settled = nodes[index].call_edges.len()
        span: nodes[index].span
        loop at in 0..<settled {
            callee: sema_effect_node_index(calls.node_by_key, nodes[index].call_edges[at]) ?? next
            if open[callee].len() == 0 || bound_callees.contains(nodes[index].call_edges[at]) {
                next
            }
            loop dispatch in open[callee] {
                sema_effect_add_dispatch_union(nodes, calls, index, dispatch.method_row, span)
            }
        }
        if nodes[index].call_edges.len() > settled -> sema_effect_node_settle_edges(nodes[index])
    }
    // A function's row leaves out what its parameters' bindings do, so a
    // discarded call of it is not proven pure (sema_effect_check_discarded).
    ^slot: 0
    loop rows in open.move() {
        if rows.len() > 0 -> sema_effect_node_rare_open(nodes[slot])
        if nodes[slot].rare.in_place() == .Val(rare) -> rare.param_dispatches = rows
        slot += 1
    }
}

// A call that binds a callee's type parameter to a larger type holding one
// of the caller's own parameters (`Grow<[T]>` inside `Grow<T>`), and that
// leads back to that parameter, asks for a deeper instance each time one is
// built, so building it never ends (E0909). Only what a non-generic function
// reaches is built, so a cycle none reaches is not reported.
sema_effect_check_expanding_instances: fn(nodes: [SemaEffectNode], inputs: [SemaEffectModuleInput], diagnostics: ^[Diagnostic]) {
    ^reached: (loop _ in nodes -> false)
    ^queue: [Int]{}
    loop index in 0..<nodes.len() {
        if nodes[index].type_params.len() > 0 -> next
        reached[index] = true
        queue.push(index)
    }
    ^cursor: 0
    loop cursor < queue.len() {
        index: queue[cursor]
        cursor += 1
        loop target in nodes[index].call_targets {
            sema_effect_queue_reached(reached, queue, target)
        }
        if nodes[index].rare == .Val(rare) {
            loop target in rare.value_targets -> sema_effect_queue_reached(reached, queue, target)
        }
        loop site in nodes[index].instantiations {
            sema_effect_queue_reached(reached, queue, site.callee_node)
        }
    }
    // One vertex per type parameter of each node, from `first[node]` on.
    ^first: [Int]{}
    ^vertices: 0
    loop node in nodes {
        first.push(vertices)
        vertices += node.type_params.len()
    }
    ^edges: (loop _ in 0..<vertices -> [Int]{})
    ^expanding: [SemaEffectExpandingSite]{}
    loop index in 0..<nodes.len() {
        if !reached[index] || nodes[index].type_params.len() == 0 -> next
        loop (site_row, site) in nodes[index].instantiations {
            callee: site.callee_node
            if callee < 0 -> next
            loop (position, param) in nodes[callee].type_params {
                bound: sema_effect_param_binding(nodes[callee], site, param) ?? next
                loop (own, name) in nodes[index].type_params {
                    if !sema_inference_type_mentions_param(bound, name) -> next
                    from: first[index] + own
                    to: first[callee] + position
                    edges[from].push(to)
                    ^same: false
                    if bound == .Named(found) && found == name -> same = true
                    if !same {
                        expanding.push(SemaEffectExpandingSite{from: from, to: to, node: index, site: site_row})
                    }
                }
            }
        }
    }
    ^seen: (loop _ in 0..<vertices -> false)
    ^reported: SemaKeyRows{}
    loop row in expanding {
        key: sema_key_pair(reported, row.node, row.site)
        if reported.seen.has_key(key) -> next
        // Whether the expanding edge's target leads back to its source.
        ^touched: [Int]{row.to}
        seen[row.to] = true
        ^walk: 0
        ^cycle: false
        loop walk < touched.len() && !cycle {
            vertex: touched[walk]
            walk += 1
            loop next_vertex in edges[vertex] {
                if next_vertex == row.from {
                    cycle = true
                    break
                }
                if seen[next_vertex] -> next
                seen[next_vertex] = true
                touched.push(next_vertex)
            }
        }
        loop vertex in touched -> seen[vertex] = false
        if !cycle -> next
        reported.seen[key] = true
        site: nodes[row.node].instantiations[row.site]
        function: symbol_key_leaf(site.callee)
        ^batch: [Diagnostic]{sema_error("E0909", site.span, "Calling `{function}` through `{site.label}` here needs a deeper instance every time, so building it never ends", "Each instance of a generic function is built for its own types, and this call leads back to it with its type nested one level deeper", "Simplify the generic nesting or split the instantiation into smaller bounds.")}
        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[row.node].module_index].source_segments, batch)
    }
}

// Queues node `target` the first time a walk reaches it; -1 is no node.
sema_effect_queue_reached: fn(reached: ^[Bool], queue: ^[Int], target: Int) Never! {
    if target < 0 || reached[target] {
        return
    }
    reached[target] = true
    queue.push(target)
}

// How many instances the reflection walk visits at most: a chain that nests
// its types one level deeper on every call never ends (E0909).
SEMA_EFFECT_REFLECTION_INSTANCES: 65536

// How many reads each instance answers (SemaEffectTypeRead) `node`'s body
// makes.
sema_effect_node_type_reads: fn(node: SemaEffectNode) -> Int Never! {
    rare: node.rare ?? return 0
    rare.type_reads.len()
}

// Each instance of a read each instance answers (SemaEffectNodeRare.type_reads),
// once: the type that fills `T` at a `T.reflect()` read, the types that fill
// the type parameters a compile-time site reads at the site. The walk starts
// at each non-generic node that leads to a read and follows every
// instantiation site to a callee that leads to one too, binding the callee's
// type parameters (sema_effect_param_binding)
// to the site's type arguments at the caller's instance, substituted as
// JetIR substitutes an instance's facts (ir_fact_type). Each instance
// carries the site values it is read under (SemaTypeReflection.guards), so
// one read in an arm an instance does not take builds nothing there
// (sema_fact_instance_constants); the same read under other guards is
// another instance. The rows depend on every instance of the program, so
// the program publishes them and no body holds one.
sema_effect_type_reflections: fn(nodes: [SemaEffectNode]) -> [SemaTypeReflection] {
    ^found: [SemaTypeReflection]{}
    ^leads: (loop node in nodes -> sema_effect_node_type_reads(node) > 0)
    ^reads: 0
    loop lead in leads {
        if lead -> reads += 1
    }
    if reads == 0 -> return found
    ^changed: true
    loop changed {
        changed = false
        loop index in 0..<nodes.len() {
            if leads[index] -> next
            loop site in nodes[index].instantiations {
                if site.callee_node >= 0 && leads[site.callee_node] {
                    leads[index] = true
                    changed = true
                    break
                }
            }
        }
    }
    ^queue: [SemaEffectReflectionInstance]{}
    loop index in 0..<nodes.len() {
        if leads[index] && nodes[index].type_params.len() == 0 {
            queue.push(SemaEffectReflectionInstance{node: index, args: [Type]{}, origin: index})
        }
    }
    ^visited: name_table_sized(64)
    ^types: name_table_sized(16)
    ^cursor: 0
    loop cursor < queue.len() && cursor < SEMA_EFFECT_REFLECTION_INSTANCES {
        current: cursor
        at: queue[current].node
        origin: queue[current].origin
        cursor += 1
        if nodes[at].rare == .Val(rare) {
            loop read in rare.type_reads {
                concrete: sema_expr_unwrap_tag(sema_inference_substitute_type(read.owner, nodes[at].type_params, queue[current].args))
                key: if {
                    read.site != "" -> comptime_site_constant_key(read.site, concrete)
                    read.type_id -> type_id_constant_key(concrete)
                    else -> type_reflection_constant_key(concrete)
                }
                guards: sema_effect_instance_guards(queue[current].guards, read.guards, nodes[at].type_params, queue[current].args)
                before: name_count(types)
                ^_: name_intern(types, "{key}{sema_effect_guards_shown(guards)}")
                if name_count(types) == before -> next
                params: if read.owner == .Apply(_, written) -> (loop param in written -> type_name(param)) else -> [String]{type_name(read.owner)}
                found.push(SemaTypeReflection{ty: concrete, module_identity: nodes[origin].module_identity, span: read.span, read_module_identity: nodes[at].module_identity, key: key, site: read.site, type_id: read.type_id, params: params, guards: guards})
            }
        }
        loop site in nodes[at].instantiations {
            callee: site.callee_node
            if callee < 0 || !leads[callee] -> next
            ^bound: [Type]{}
            loop param in nodes[callee].type_params {
                binding: sema_effect_param_binding(nodes[callee], site, param) ?? break
                bound.push(sema_inference_substitute_type(binding, nodes[at].type_params, queue[current].args))
            }
            if bound.len() != nodes[callee].type_params.len() -> next
            guards: sema_effect_instance_guards(queue[current].guards, site.guards, nodes[at].type_params, queue[current].args)
            shown: (loop ty in bound -> type_carrier_identity(ty)).join(",")
            before: name_count(visited)
            ^_: name_intern(visited, "{callee}<{shown}>{sema_effect_guards_shown(guards)}")
            if name_count(visited) == before -> next
            queue.push(SemaEffectReflectionInstance{node: callee, args: bound.move(), origin: origin, guards: guards})
        }
    }
    found
}

// The guards an instance whose type parameters `params` are `args`, reached
// under `outer`, reads or calls under: `outer`, then each of the `written`
// guards of the arms the read or call sits in, as the constant row of the
// site value it names there (comptime_site_constant_key).
sema_effect_instance_guards: fn(outer: [SemaTypeReflectionGuard], written: [SemaEffectGuard], params: [String], args: [Type]) -> [SemaTypeReflectionGuard] {
    ^guards: outer
    loop guard in written {
        concrete: sema_expr_unwrap_tag(sema_inference_substitute_type(guard.owner, params, args))
        guards.push(SemaTypeReflectionGuard{key: comptime_site_constant_key(guard.site, concrete), holds: guard.holds})
    }
    guards
}

// The text that tells apart the instances of one read or call under
// different `guards`.
sema_effect_guards_shown: fn(guards: [SemaTypeReflectionGuard]) -> String Never! {
    (loop guard in guards -> if guard.holds -> "&{guard.key}" else -> "&!{guard.key}").join("")
}

// The instance reaches of `node` with each target's solved row.
sema_effect_instance_notes: fn(nodes: [SemaEffectNode], solved: [[String]], node: SemaEffectNode) -> [SemaEffectInstanceNote] Never! {
    rare: node.rare ?? return [SemaEffectInstanceNote]{}
    notes: loop reach in rare.instance_reaches -> {
        target: reach.target_node
        if target < 0 -> next
        SemaEffectInstanceNote{label: reach.label, callee: nodes[target].chain_name, row: solved[target], span: reach.span}
    }
    notes
}

// A report over `reported` effects labels each instantiation whose
// implementation brings one of them, naming the instantiation.
sema_effect_with_instance_notes: fn(diagnostic: Diagnostic, notes: [SemaEffectInstanceNote], reported: [String]) -> Diagnostic {
    ^labeled: diagnostic
    loop note in notes {
        ^hits: [String]{}
        loop effect_name in note.row {
            if sema_effect_declared_hits(reported, effect_name).len() > 0 {
                sema_effect_set_add(hits, effect_name)
            }
        }
        if hits.len() == 0 -> next
        labeled = diagnostic_with_label(labeled, note.span, "`{note.label}` runs `{note.callee}` here, which uses `{sema_effect_show(hits)}`")
    }
    labeled
}

// A call to a Core scope publisher narrows the effect the callee declares to
// the scope its constant first argument names: `files.read("assets/a.png")`
// needs `FS.Read("assets/a.png")`. A run-time argument names no scope, so
// that call needs the bare effect (EffectScope.jet).
sema_effect_record_scope: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, tree: BodyTree, node: BodyNode, fact: SemaCallSiteFact) Never! {
    callee: fact.callee ?? return
    callee_key: symbol_key(facts.symbols, tree.symbols, callee)
    // A publisher with no body here, such as `core.http.get`, publishes by key.
    published: if name_column_get(facts.node_by_key.names, facts.published_rows, callee_key) == .Val(row) -> facts.published_texts[row] else -> {
        effect_scope_published_effect(callee_key, false, [String]{}) ?? return
    }
    scope: sema_effect_call_scope(tree, node, published)
    sema_effect_node_rare_open(nodes[node_index])
    if nodes[node_index].rare.in_place() == .Val(rare) {
        if scope == .Val(name) {
            scoped: effect_scope_name(published, name)
            loop call in rare.scoped_calls {
                if call.callee == callee_key && call.scoped == scoped {
                    return
                }
            }
            rare.scoped_calls.push(SemaEffectScopedCall{callee: callee_key, published: published, scoped: scoped})
        } else if !rare.bare_scope_callees.contains(callee_key) {
            rare.bare_scope_callees.push(callee_key)
        }
    }
}

// The scope a publisher call's first argument names for `effect`, when that
// argument is a string literal whose constant text names one.
sema_effect_call_scope: fn(tree: BodyTree, node: BodyNode, published: String) -> String? Never! {
    if node.kind == .Call(_, _, args) {
        if args.len() == 0 -> return None
        argument: body_node(tree, args[0].value)
        if argument.kind == .StrLit(parts) {
            ^text: ""
            loop part in parts {
                if part == .Literal(piece) -> text = "{text}{piece}" else {
                    return effect_scope_of_argument(published, text, false)
                }
            }
            return effect_scope_of_argument(published, text, true)
        }
    }
    None
}

// `close(value)`: an edge to the value type's own `close` method, the
// function codegen calls for it. Methods are indexed by their owner type's
// name, so a same-named type in another module adds its method too: the row
// may only grow, never miss one.
sema_effect_record_close: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, value_type: Type) Never! {
    owner: if sema_expr_unwrap_tag(value_type) == {
        .Named(name) | .Apply(name, _) -> symbol_key_leaf(name)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            return
        }
    }
    if name_column_get(facts.close_method_names, facts.close_method_rows, owner) == .Val(row) {
        loop key in facts.close_method_lists[row] {
            sema_effect_node_add_edge(nodes, node_index, key)
        }
    }
}

// A loop over a registered Iterable calls its `iter`, its iterator's `next`
// on every step and that iterator's own `close` when the loop ends (JetIR
// ir_iterable_walk), so their effects are the loop's: edges to all three, the
// close methods found by owner name as for `close(value)`. A lambda's rows
// come from its call facts, which hold no loop, so its loops charge the
// enclosing function (SemaEffectWalk.LambdaBody).
sema_effect_record_iterable_loop: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, iter_type: String, iter_symbol: String, next_symbol: String, span: Span) Never! {
    node_index: if walk == {
        .Collect(index) | .TransactCollect(index) | .LambdaBody(index) -> index
        .Unsafe(_) -> {
            return
        }
        .Region(index, region, _) -> if sema_effect_span_contains(region, span) -> index else -> {
            return
        }
    }
    sema_effect_node_add_edge(nodes, node_index, iter_symbol)
    sema_effect_node_add_edge(nodes, node_index, next_symbol)
    if name_column_get(facts.close_method_names, facts.close_method_rows, symbol_key_leaf(iter_type)) == .Val(row) {
        loop key in facts.close_method_lists[row] {
            sema_effect_node_add_edge(nodes, node_index, key)
        }
    }
}

// The declaring module of a `kind:{module}.{name}` type symbol key
// (`symbol_id` with an empty owner): all the text before its name
// (symbol_key_parts).
sema_effect_symbol_module: fn(key: String) -> String? Never! {
    parts: symbol_key_parts(key, fn(text: String) { text != "" }) ?? return None
    if parts.module_identity == "" -> return None
    Val(parts.module_identity)
}

// The Core module identity of a free Core declaration's key
// (`function:<corelib>/core.net.fetch` is `<corelib>/core.net`); None for any
// other key, a Core method's too: its key has its owner between its module
// and its name (symbol_key_parts).
sema_effect_core_member_module: fn(key: String) -> String? Never! {
    if !(key.split_once(":") ?? return None).after.starts_with("<corelib>/") -> return None
    parts: symbol_key_parts(key, fn(text: String) { core_identity_is_module(text) }) ?? return None
    if parts.owner != "" -> return None
    Val(parts.module_identity)
}

sema_effect_walk_expr: fn(nodes: ^[SemaEffectNode], node_index: Int, tree: BodyTree, expression: Int, facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller) {
    node: body_node(tree, expression)
    if sema_effect_walk_expr_enter(nodes, node_index, tree, expression, node, facts, module_facts, diagnostics, caller) {
        sema_effect_walk_expr_children(SemaEffectWalk.Collect{node_index: node_index}, nodes, facts, module_facts, diagnostics, caller, tree, node)
    }
}

sema_effect_walk_record_call_node: fn(nodes: ^[SemaEffectNode], node_index: Int, tree: BodyTree, node: BodyNode, facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller) -> Bool {
    // The `Clock.{method}` check runs before the declared method's call is
    // recorded: a pure body reports E3403 and records nothing.
    if sema_effect_clock_intrinsic_position(facts, module_facts, caller, node.span) == .Val(clock) && sema_effect_report_nondeterministic_intrinsic(nodes, node_index, module_facts[clock], node.span, diagnostics) {
        return true
    }
    found: sema_effect_find_fact(facts, module_facts, caller, node.span)
    if found == {
        .Val(position) -> {
            value: module_facts[position]
            nondeterministic: sema_effect_nondeterministic_core(nodes[node_index], node, value, sema_effect_callee_module(facts, node), tree, facts.symbols)
            if nondeterministic == .Val(api) {
                // The call's effects are not recorded, so the pure function
                // reports E3403 instead of E3401.
                nodes[node_index].nondeterministic_call = true
                diagnostics.push(sema_error("E3403", node.span, "`{api}` is non-deterministic and cannot appear in a pure evaluation.", "Pure evaluation must produce the same result on every machine.", "remove this call, or remove the enclosing function's explicit empty effect bound."))
            } else if !sema_effect_report_nondeterministic_intrinsic(nodes, node_index, value, node.span, diagnostics) {
                if !sema_effect_record_static_dispatch(nodes, facts, node_index, tree, node, value) {
                    sema_effect_record_fact(nodes, facts, tree, node_index, node, value, diagnostics)
                    sema_effect_record_scope(nodes, facts, node_index, tree, node, value)
                    sema_effect_record_dispatch(nodes, facts, node_index, tree, node, value)
                    sema_effect_record_instantiation(nodes, node_index, tree, node, value, facts.symbols, facts.interner)
                }
            }
        }
        .None -> {
            if !sema_effect_is_compiler_intrinsic(node.kind) {
                sema_effect_record_unresolved_call(nodes, facts, tree, node_index, node)
            }
        }
    }
    false
}

sema_effect_walk_record_exact_fact: fn(nodes: ^[SemaEffectNode], node_index: Int, tree: BodyTree, node: BodyNode, facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller) {
    if caller.slot < 0 {
        return
    }
    if sema_effect_in_assume_det(nodes[node_index], node.span) {
        return
    }
    found: sema_effect_find_exact_fact(facts, module_facts, caller, node.span)
    if found == .Val(position) {
        value: module_facts[position]
        if !sema_effect_report_nondeterministic_intrinsic(nodes, node_index, value, node.span, diagnostics) {
            sema_effect_record_fact(nodes, facts, tree, node_index, node, value, diagnostics)
        }
    }
}

// sema_effect_walk_expr's own work on `node`, the node at `expression`;
// false when its children aren't walked. Fused into one NodeKind dispatch so
// non-call leaf/expression nodes skip comptime-input, context, value-read, and
// stop switches completely.
sema_effect_walk_expr_enter: fn(nodes: ^[SemaEffectNode], node_index: Int, tree: BodyTree, expression: Int, node: BodyNode, facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller) -> Bool {
    if node.kind == {
        .Call(_, _, args) -> {
            if !sema_effect_in_assume_det(nodes[node_index], node.span) && sema_effect_walk_record_call_node(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller) {
                return true
            }
            sema_effect_record_function_arguments(nodes, facts, node_index, tree, args)
        }
        .MethodCall(_, _, _, _) -> {
            if !sema_effect_in_assume_det(nodes[node_index], node.span) && sema_effect_walk_record_call_node(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller) {
                return true
            }
            sema_effect_record_value_reads(nodes, facts, node_index, tree, expression, node)
        }
        .IndirectCall(_, _, args, _) -> {
            local_lambda: sema_effect_local_lambda_call(tree, node.kind)
            if !local_lambda {
                nodes[node_index].context_open = true
                if !sema_effect_in_assume_det(nodes[node_index], node.span) && sema_effect_walk_record_call_node(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller) {
                    return true
                }
            }
            sema_effect_record_function_arguments(nodes, facts, node_index, tree, args)
        }
        .HostCall(_) -> {
            sema_effect_record_comptime_input(nodes, node_index, node)
            sema_effect_record_context(facts.interner, nodes, node_index, tree, node)
            if !sema_effect_in_assume_det(nodes[node_index], node.span) && sema_effect_walk_record_call_node(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller) {
                return true
            }
        }
        .Close(value) -> {
            if !sema_effect_in_assume_det(nodes[node_index], node.span) && sema_effect_walk_record_call_node(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller) {
                return true
            }
            // `close(value)` runs the value type's own `Close.close`, so that
            // method's effects are this function's (codegen calls it directly).
            sema_effect_record_close(nodes, facts, node_index, body_type(facts.interner, tree, value))
        }
        .AllocNew(_, _) -> {
            if !sema_effect_in_assume_det(nodes[node_index], node.span) && sema_effect_walk_record_call_node(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller) {
                return true
            }
        }
        .StaticCall(owner, owner_type, method, _, args) -> {
            if !sema_effect_in_assume_det(nodes[node_index], node.span) && sema_effect_walk_record_call_node(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller) {
                return true
            }
            // `Shared{x}`: new shared storage that every handle copy retains.
            if owner == .Prelude(_, path, _) && path == "jet_std.JetShared" && method.name == "new" {
                sema_effect_push_memory_event(nodes, node_index, node.span, "`Shared{{…}}` allocates shared storage", "alloc", None)
                sema_effect_push_memory_event(nodes, node_index, node.span, "`Shared{{…}}` introduces reference-counted ownership", "rc", None)
            }
            // A static of an Arena or Bump that answers one (`mem.Arena.new`)
            // reserves arena storage; a literal capacity is the proven bound.
            // The owner is the nominal as declared (`Arena`) and the result
            // as its Core identity resolves it, so they meet by family.
            result: body_type(facts.interner, tree, expression)
            allocator: sema_call_memory_allocator_name(result) ?? ""
            if (allocator == "Arena" || allocator == "Bump") && owner_type == .Val(owner_ty) && sema_call_memory_allocator_name(owner_ty) == (Val(allocator)) {
                ^bound: Int?{None}
                if args.len() > 0 && body_node(tree, args[0].value).kind == .IntLit(bytes, _) && bytes >= 0 {
                    bound = Val(bytes)
                }
                sema_effect_push_memory_event(nodes, node_index, node.span, "`{allocator}.{method.name}` reserves bounded arena storage", "arena", bound)
                sema_effect_push_memory_event(nodes, node_index, node.span, "`{allocator}.{method.name}` allocates from arena storage", "alloc", None)
            }
        }
        .GlobalShared(_, _) -> {
            if !sema_effect_in_assume_det(nodes[node_index], node.span) {
                ^_: sema_effect_walk_record_call_node(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            }
            return false
        }
        .BuiltinMethod(_, op, _) -> {
            if sema_effect_builtin_may_have_effect(op) && !sema_effect_in_assume_det(nodes[node_index], node.span) && sema_effect_walk_record_call_node(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller) {
                return true
            }
        }
        .ClosureMethod(_, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .HandleMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .SharedGuardWait(_, _, _) | .CoreClosureCall(_) -> {
            if !sema_effect_in_assume_det(nodes[node_index], node.span) && sema_effect_walk_record_call_node(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller) {
                return true
            }
        }
        .ConstRef(symbol) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            sema_effect_record_value_reads(nodes, facts, node_index, tree, expression, node)
            sema_effect_record_callback_bound(nodes, facts.node_by_key, node_index, symbol_key(facts.symbols, tree.symbols, symbol), body_type(facts.interner, tree, expression), node.span)
            return false
        }
        .FnValue(_) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            sema_effect_record_value_reads(nodes, facts, node_index, tree, expression, node)
        }
        .Never(_, _) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
            return false
        }
        .RequireStop(_, _, _) | .Slice(_, _, _, _, _) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
        }
        .OrFallback(_, fallback, _) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            if fallback == .Panic(_, _) {
                sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
            }
        }
        .Index(_, _, kind, _, _, _) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            if kind == .List || kind == .Range || kind == .Map {
                sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
            }
        }
        .Lambda(value) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            sema_effect_merge_lambda(nodes, node_index, value)
            sema_effect_walk_lambda_children(SemaEffectWalk.LambdaBody{node_index: node_index}, nodes, facts, module_facts, diagnostics, caller, tree, value)
            sema_effect_record_lambda_bound(nodes, node_index, facts, caller, tree, value, body_type(facts.interner, tree, expression), node.span)
            return false
        }
        .StrLit(parts) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            // Formatting a local that holds a Clock records its `Clock
            // formatting` fact on the local's span; a bare local skips fact
            // lookups elsewhere, so the interpolation looks it up here.
            ^interpolated: false
            loop part in parts {
                if part == .Interpolation(value, _) {
                    interpolated = true
                    value_node: body_node(tree, value)
                    if value_node.kind == .Local(_) {
                        sema_effect_walk_record_exact_fact(nodes, node_index, tree, value_node, facts, module_facts, diagnostics, caller)
                    }
                }
            }
            if interpolated {
                sema_effect_push_memory_event(nodes, node_index, node.span, "string interpolation allocates a new `String`", "alloc", None)
            }
        }
        .List(values, _) | .ListLit(values) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            if values.len() > 0 && type_kind(facts.interner, body_type_id(tree, expression)) != TypeKind.FixedList {
                sema_effect_push_memory_event(nodes, node_index, node.span, "list construction allocates backing storage", "alloc", None)
            }
        }
        // A `[U8]{"…"}` byte value (one checked byte constant) builds the same
        // backing storage its per-element list spelling would.
        .CtLit(value) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            if value == .Bytes(bytes) && bytes.len() > 0 && type_kind(facts.interner, body_type_id(tree, expression)) != TypeKind.FixedList {
                sema_effect_push_memory_event(nodes, node_index, node.span, "list construction allocates backing storage", "alloc", None)
            }
            return false
        }
        .Map(entries) | .MapLit(entries) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            if entries.len() > 0 {
                sema_effect_push_memory_event(nodes, node_index, node.span, "map construction allocates backing storage", "alloc", None)
            }
        }
        // A copy of a `Shared<T>` handle retains one more reference.
        .ExplicitCopy(_) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            ty: body_type(facts.interner, tree, expression)
            if ty == .Shared(_) {
                sema_effect_push_memory_event(nodes, node_index, node.span, "`copy` of `{type_name(ty)}` retains a shared reference", "rc", None)
            }
        }
        .Clone(_, _) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            ty: body_type(facts.interner, tree, expression)
            if ty == .Shared(_) {
                sema_effect_push_memory_event(nodes, node_index, node.span, "implicit copy of `{type_name(ty)}` retains a shared reference", "rc", None)
            }
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .Local(_) | .Unit | .Uninit | .Absent | .NumberParam(_) | .TypePath(_) | .CopyPhase(_, _, _, _) -> {
            return false
        }
        .TraitConst(owner, trait_name, name) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            if trait_name == TYPE_REFLECTION_TRAIT || trait_name == TYPE_ID_TRAIT || trait_name == COMPTIME_SITE_TRAIT {
                site: if trait_name == COMPTIME_SITE_TRAIT -> name else -> ""
                sema_effect_node_rare_open(nodes[node_index])
                if nodes[node_index].rare.in_place() == .Val(rare) {
                    rare.type_reads.push(SemaEffectTypeRead{owner: owner, span: node.span, site: site, type_id: trait_name == TYPE_ID_TRAIT, guards: rare.guards})
                }
            }
            return false
        }
        .InvariantViolation(_, _) | .SelectStart | .TypeTest(_, _) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
            return false
        }
        .InlineBlock(_) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .Move(_) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Range(_, _, _) | .Tuple(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .ConditionNotify(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListSpread(_) | .PoolSlot(_, _, _, _, _, _) | .MaterializeView(_) | .DecodeUnder(_, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .OverflowOpt(_, _, _, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) -> {
            sema_effect_walk_record_exact_fact(nodes, node_index, tree, node, facts, module_facts, diagnostics, caller)
        }
    }
    true
}

sema_effect_collect_function: fn(nodes: ^[SemaEffectNode], node_index: Int, function: FnBody, facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], module_index: Int, diagnostics: ^[Diagnostic]) {
    caller: sema_effect_caller_slot(facts, module_index, function.key)
    loop statement in function.body {
        sema_effect_walk_stmt_children(SemaEffectWalk.Collect{node_index: node_index}, nodes, facts, module_facts, diagnostics, caller, function.tree, function.tree.stmts[statement])
    }
    sema_effect_node_settle_edges(nodes[node_index])
}

sema_effect_check_unsafe_expr: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], caller: SemaEffectCaller, tree: BodyTree, expression: Int, audited: Bool, diagnostics: ^[Diagnostic]) {
    node: body_node(tree, expression)
    if sema_effect_check_unsafe_enter(nodes, facts, module_facts, caller, tree, node, audited, diagnostics) {
        sema_effect_walk_expr_children(SemaEffectWalk.Unsafe{audited: audited}, nodes, facts, module_facts, diagnostics, caller, tree, node)
    }
}

sema_effect_check_unsafe_call_site: fn(facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], caller: SemaEffectCaller, span: Span, audited: Bool, diagnostics: ^[Diagnostic]) {
    found: sema_effect_find_fact(facts, module_facts, caller, span)
    if found == .Val(position) {
        // A `mem.<operation>(…)` call sema already reported as E3101
        // (`audited_operation`) is not reported again as E3103.
        site: module_facts[position]
        if site.detail == .Val(detail) {
            if site.callee == .Val(callee) && !detail.audited_operation && !symbol_is_local(callee) {
                if name_column_get(facts.node_by_key.names, facts.unsafe_rows, symbol_table_key(facts.symbols, callee)) == .Val(row) {
                    sema_effect_require_unsafe_call(facts.unsafe_name_texts[row], true, audited, span, diagnostics)
                }
            }
            if detail.unsafe_foreign_name == .Val(foreign) {
                _: sema_effect_require_unsafe_call(foreign, true, audited, span, diagnostics)
            }
            if detail.foreign_capability == .Val(capability) && !audited {
                row: sema_diagnostic_row("E0702")
                diagnostics.push(sema_error("E0702", span, row.what.replace("{{subject}}", "call `{capability.name}` uses capability `{capability.sigil}` outside `#Unsafe`"), "a foreign capability can write to or transfer ownership of Jet storage, so a raw call needs an audited boundary", "call `{capability.name}` inside `#Unsafe(\"…\") {{ … }}`, or expose it through a generated typed binding"))
            }
        } else if site.callee == .Val(callee) && !symbol_is_local(callee) {
            if name_column_get(facts.node_by_key.names, facts.unsafe_rows, symbol_table_key(facts.symbols, callee)) == .Val(row) {
                sema_effect_require_unsafe_call(facts.unsafe_name_texts[row], true, audited, span, diagnostics)
            }
        }
    }
}

// sema_effect_check_unsafe_expr's own work on `node`; false when its
// children aren't walked.
sema_effect_check_unsafe_enter: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], caller: SemaEffectCaller, tree: BodyTree, node: BodyNode, audited: Bool, diagnostics: ^[Diagnostic]) -> Bool {
    if node.kind == {
        .GlobalShared(_, _) -> {
            sema_effect_check_unsafe_call_site(facts, module_facts, caller, node.span, audited, diagnostics)
            return false
        }
        .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .StaticCall(_, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .HandleMethod(_, _, _) | .SharedGuardWait(_, _, _) -> {
            sema_effect_check_unsafe_call_site(facts, module_facts, caller, node.span, audited, diagnostics)
        }
        .Lambda(value) -> {
            if value.executable == {
                .Expr(inner) -> {
                    sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, inner, false, diagnostics)
                }
                .Block(body) -> {
                    sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, false, diagnostics)
                }
            }
            return false
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .Local(_) | .Unit | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) | .InvariantViolation(_, _) | .Absent | .SelectStart | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) -> {
            return false
        }
        .StrLit(_) | .InlineBlock(_) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .ConditionNotify(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) -> {}
    }
    true
}

sema_effect_check_unsafe_condition: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], caller: SemaEffectCaller, tree: BodyTree, condition: BodyIfCond, audited: Bool, diagnostics: ^[Diagnostic]) {
    if condition == {
        .Plain(value) -> {
            sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, value, audited, diagnostics)
        }
        .And(left, right) -> {
            sema_effect_check_unsafe_condition(nodes, facts, module_facts, caller, tree, left, audited, diagnostics)
            sema_effect_check_unsafe_condition(nodes, facts, module_facts, caller, tree, right, audited, diagnostics)
        }
        .IfLet(_, subject) -> {
            sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, subject, audited, diagnostics)
        }
    }
}

sema_effect_check_unsafe_contracts: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], caller: SemaEffectCaller, tree: BodyTree, contracts: [BodyContract], audited: Bool, diagnostics: ^[Diagnostic]) {
    loop contract in contracts {
        sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, contract.condition, audited, diagnostics)
        sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, contract.message, audited, diagnostics)
    }
}

sema_effect_check_unsafe_statements_tree: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], caller: SemaEffectCaller, tree: BodyTree, statements: [Int], audited: Bool, diagnostics: ^[Diagnostic]) {
    loop statement in statements {
        if tree.stmts[statement] == {
            .Contract(contract) -> {
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, contract.condition, audited, diagnostics)
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, contract.message, audited, diagnostics)
            }
            .ContractScope(pre, body, post, _, _) -> {
                sema_effect_check_unsafe_contracts(nodes, facts, module_facts, caller, tree, pre, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
                sema_effect_check_unsafe_contracts(nodes, facts, module_facts, caller, tree, post, audited, diagnostics)
            }
            .Let(_, _, init, _, _, _) | .TupleDestructure(_, init, _, _, _) | .StructDestructure(_, init, _, _, _) | .ListDestructure(_, init, _, _, _, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, init, audited, diagnostics)
            }
            .RefutableBind(_, init, fallback, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, init, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, fallback, audited, diagnostics)
            }
            .Assign(place, _, value, _, _) -> {
                if place == {
                    .Expr(place_value) -> {
                        sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, place_value, audited, diagnostics)
                    }
                    .Local(_) -> {}
                }
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, value, audited, diagnostics)
            }
            .CountedLoop(_, init, condition, step, _, body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, [Int]{init}, audited, diagnostics)
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, condition, audited, diagnostics)
                if step == .Val(step_statement) {
                    sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, [Int]{step_statement}, audited, diagnostics)
                }
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
            }
            .ForRange(_, _, start, end, step, _, body, _, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, start, audited, diagnostics)
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, end, audited, diagnostics)
                if step == .Val(step_value) {
                    sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, step_value, audited, diagnostics)
                }
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
            }
            .Range(_, _, source, start, end, step, _, _, body, _) -> {
                if source == .Val(source_value) {
                    sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, source_value, audited, diagnostics)
                }
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, start, audited, diagnostics)
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, end, audited, diagnostics)
                if step == .Val(step_value) {
                    sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, step_value, audited, diagnostics)
                }
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
            }
            .ExprStmt(value, _) | .DeferClose(value, _, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, value, audited, diagnostics)
            }
            .TaskGroup(_, args, body, _) -> {
                if args.limit == .Val(limit_value) {
                    sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, limit_value, audited, diagnostics)
                }
                if args.stack == .Val(stack_value) {
                    sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, stack_value, audited, diagnostics)
                }
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
            }
            .If(condition, then_body, else_body, _, _) -> {
                sema_effect_check_unsafe_condition(nodes, facts, module_facts, caller, tree, condition, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, then_body, audited, diagnostics)
                if else_body == .Val(else_statements) {
                    sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, else_statements, audited, diagnostics)
                }
            }
            .Loop(_, body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
            }
            .While(_, condition, body, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, condition, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
            }
            .BreakValue(_, value, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, value, audited, diagnostics)
            }
            .Match(subject, arms, _, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, subject, audited, diagnostics)
                loop arm in arms {
                    sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, arm.body, audited, diagnostics)
                }
            }
            .EnumMatch(scrutinee, arms, else_body, _, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, scrutinee, audited, diagnostics)
                loop arm in arms {
                    sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, arm.body, audited, diagnostics)
                }
                if else_body == .Val(else_statements) {
                    sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, else_statements, audited, diagnostics)
                }
            }
            .RangeSwitch(subject, arms, else_body, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, subject, audited, diagnostics)
                loop arm in arms {
                    sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, arm.body, audited, diagnostics)
                }
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, else_body, audited, diagnostics)
            }
            .ForIn(_, _, _, source, collection, step, _, _, _, _, body, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, source, audited, diagnostics)
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, collection, audited, diagnostics)
                if step == .Val(step_value) {
                    sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, step_value, audited, diagnostics)
                }
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
            }
            .Inline(body, _) | .DebugOnly(body, _) | .DeepCheck(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .Defer(body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
            }
            .MixedSwitch(subject, _, arms, else_body, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, subject, audited, diagnostics)
                loop arm in arms {
                    sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, arm.condition, audited, diagnostics)
                    sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, arm.body, audited, diagnostics)
                }
                if else_body == .Val(else_statements) {
                    sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, else_statements, audited, diagnostics)
                }
            }
            .Unsafe(_, body) | .UnsafeBlock(_, body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, true, diagnostics)
            }
            .SentryPolicy(_, body, _) | .Impure(body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
            }
            .Reactive(executable, _) -> {
                if executable.executable == {
                    .Expr(value) -> {
                        sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, value, false, diagnostics)
                    }
                    .Block(body) -> {
                        sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, false, diagnostics)
                    }
                }
            }
            .Layout(_, _, body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
            }
            .ContextBlock(guards, body, _) -> {
                loop guard in guards {
                    sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, guard.value, audited, diagnostics)
                }
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
            }
            .ScopeMember(_, body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
            }
            .Transact(_, _, _, body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, body, audited, diagnostics)
            }
            .GCEdit(_, _, _, _, index_temp, nested, _) -> {
                if index_temp == .Val(index_value) {
                    sema_effect_check_unsafe_expr(nodes, facts, module_facts, caller, tree, index_value, audited, diagnostics)
                }
                sema_effect_check_unsafe_statements_tree(nodes, facts, module_facts, caller, tree, [Int]{nested}, audited, diagnostics)
            }
            .Return(_, _) | .Break(_, _) | .Continue(_, _) -> {
                sema_effect_walk_stmt_children(SemaEffectWalk.Unsafe{audited: audited}, nodes, facts, module_facts, diagnostics, caller, tree, tree.stmts[statement])
            }
        }
    }
}

// `e0712`: the region is both the call and the scope frame; its own caps never
// grant the effects it is missing.
sema_effect_scope_diagnostic: fn(marker: String, over: [String], bounds: [String], span: Span) -> Diagnostic {
    allowed: if bounds.len() == 0 -> "no effects" else -> "`{sema_effect_show(bounds)}`"
    diagnostic: sema_error("E0712", span, "this `#{marker}` region uses the effect `{sema_effect_show(over)}`, which it has no authority for", "`#{marker}(…)` allows only {allowed}; an effect reached inside — even through a call — must be in that list", "add `{sema_effect_show(over)}` to the `#{marker}(…)` list, or move that work outside the region")
    diagnostic_with_rights(diagnostic, "invocation", [String]{"#{marker}"}, [String]{"#{marker}"}, None)
}

// The effects an `#On(.Deep)` body reaches, itself or through a call, that act
// outside the program: every one but `Panic`, `Mem.*` and `Unsafe`, which obey
// the function's own denials. `Time.Wait` needs no grant elsewhere, but a deep
// check may not wait either.
sema_effect_deep_check_over: fn(inferred: [String]) -> [String] Never! {
    ^result: [String]{}
    loop name in inferred {
        root: sema_effect_root(name)
        if root == "Panic" || root == "Mem" || root == "Unsafe" -> next
        sema_effect_set_add(result, name)
    }
    result
}

// `e0713`: the effects sema_effect_deep_check_over finds.
sema_effect_deep_check_diagnostic: fn(over: [String], span: Span) -> Diagnostic {
    sema_error("E0713", span, "this deep check uses the effect `{sema_effect_show(over)}`", "A deep check runs only where `--deep-checks` keeps it, so it may not act on the world outside the program, even through a call.", "Move the work that uses `{sema_effect_show(over)}` out of the `#On(.Deep)` body.")
}

// A scope cap list parsed once: the effect names it allows as a ranked set
// and the names sema_effect_parse_name rejects, in cap order, so a cap list
// checked against many functions (a package policy) is parsed once.
SemaEffectScopeBounds: struct {
    bounds: [String],
    unknown: [String],
}

// `e0747` for a denial: the callback reaches an effect its parameter's row
// denies (`fn(…) -[!Panic]>`), which no grant can lift.
sema_effect_callback_denied_diagnostic: fn(denied: [String], row: SemaEffectCallbackRow, span: Span) -> Diagnostic {
    denied_list: sema_effect_show(denied)
    ^entries: row.bound.copy()
    loop name in row.denied -> entries.push("!{name}")
    diagnostic: sema_error("E0747", span, "this callback uses the effect `{denied_list}`, which the parameter doesn't allow", "the parameter is `fn(…) -[{sema_effect_show(entries)}]>`, which denies `{denied_list}`", "pass a callback that can't reach `{denied_list}`, or remove the denial from the parameter's row")
    diagnostic_with_rights(diagnostic, "invocation", [String]{}, [String]{}, None)
}

// `e0747`: the callback's effects against its parameter's invocation row.
sema_effect_callback_diagnostic: fn(over: [String], bounds: [String], span: Span) -> Diagnostic {
    over_list: sema_effect_show(over)
    allowed: if bounds.len() == 0 -> "the parameter is `fn(…) -[]>`, so the callback must be pure" else -> "the parameter is `fn(…) -[{sema_effect_show(bounds)}]>`, so the callback may use only those effects"
    fix: if bounds.len() == 0 -> "pass a `fn(…) -[]>` callback (or a lambda that uses no effects), or widen the parameter's bound" else -> "pass a callback within `-[{sema_effect_show(bounds)}]>`, or add `{over_list}` to the parameter's bound"
    diagnostic: sema_error("E0747", span, "this callback uses the effect `{over_list}`, which the parameter doesn't allow", "{allowed}; `{over_list}` is outside that bound", fix)
    diagnostic_with_rights(diagnostic, "invocation", [String]{}, [String]{}, None)
}

sema_effect_check_callback_bound: fn(callback_effects: [String], bounds: [String], span: Span, diagnostics: ^[Diagnostic]) -> Bool {
    ^parsed_bounds: [String]{}
    ^valid: true
    loop raw in bounds {
        if raw.starts_with("..") -> next
        if raw.starts_with("!") -> next
        effect_name: sema_effect_parse_name(raw) ?? {
            diagnostics.push(sema_effect_unknown(raw, span))
            valid = false
            next
        }
        if sema_effect_root(effect_name) == "Panic" {
            diagnostics.push(sema_effect_positive_panic(span))
            valid = false
            next
        }
        sema_effect_set_add(parsed_bounds, effect_name)
    }
    over: sema_effect_uncovered(callback_effects, parsed_bounds)
    if over.len() > 0 {
        diagnostics.push(sema_effect_callback_diagnostic(over, parsed_bounds, span))
        valid = false
    }
    valid
}

// ────────────────────────────────────────────────────────────────────────────
// Call-graph fixed point and public graph hook

SemaEffectPending: struct {
    node: Int,
    name: String,
}

// Each node's callers, in caller and call-edge order: the reverse call graph
// the fixed point and the reach walks share. A `core.db` call into the SQL
// engine's parts is no edge: see sema_effect_sealed_edge.
sema_effect_callers: fn(nodes: [SemaEffectNode], table: ModuleTable) -> [[Int]] Never! {
    core_db: module_find(table, "<corelib>/core.db")
    ^callers: (loop _ in nodes -> [Int]{})
    loop (index, node) in nodes {
        loop target in node.call_targets {
            if target < 0 -> next
            if sema_effect_sealed_edge(table, core_db, node, nodes[target]) -> next
            callers[target].push(index)
        }
    }
    callers
}

// The SQL engine's parts (`<corelib>/__core_db_*`) reach `core.db` the way
// the C library they replace did: `core.db`'s declared rows (`DB.Read` on
// queries, `DB.Write` on `execute`, the `DB` root on transaction control)
// are the effects its callers see, so an engine row does not flow into a
// `core.db` body. Calls between engine parts keep their edges.
sema_effect_sealed_edge: fn(table: ModuleTable, core_db: ModuleID?, caller: SemaEffectNode, target: SemaEffectNode) -> Bool Never! {
    db: core_db ?? return false
    db == caller.module_identity && module_is_core(target.module_identity) && module_text(table, target.module_identity).starts_with("<corelib>/__core_db_")
}

// The Core library's effect summary of each Core function (CoreSeal.jet)
// whose reach, along the call edges the solve follows, is plain
// (sema_effect_seal_plain) and solves to its direct effects and a stop
// alone: its solved row is then a fact of Core's code, the same in every
// program, and so are the direct effects the driver's walks sum along it.
// The summaries take the graph's nodes, which are done with: each takes its
// node's key.
sema_effect_core_seal_rows: fn(nodes: ^^[SemaEffectNode], solved: [[String]], table: ModuleTable) -> [SemaCoreSealEffects] Never! {
    core_db: module_find(table, "<corelib>/core.db")
    plain: loop node in nodes -> sema_effect_seal_plain(node)
    ^seen: loop _ in nodes -> false
    ^rows: [SemaCoreSealEffects]{}
    ^roots: [Int]{}
    loop root in 0..<nodes.len() {
        if !module_is_core(nodes[root].module_identity) || !plain[root] -> next
        ^reach: [Int]{root}
        seen[root] = true
        ^sealed: true
        ^direct: [String]{}
        ^panic: false
        ^writes: false
        ^cursor: 0
        loop cursor < reach.len() {
            at: reach[cursor]
            cursor += 1
            if !plain[at] {
                sealed = false
                break
            }
            loop name in nodes[at].direct -> sema_effect_set_add(direct, name)
            if nodes[at].rare == .Val(rare) && rare.module_writes.len() > 0 -> writes = true
            loop (position, edge) in nodes[at].call_edges {
                if edge == "__jet_panic__" {
                    panic = true
                    next
                }
                target: nodes[at].call_targets[position]
                if target < 0 -> next
                if sema_effect_sealed_edge(table, core_db, nodes[at], nodes[target]) {
                    sealed = false
                    break
                }
                if seen[target] -> next
                seen[target] = true
                reach.push(target)
            }
            if !sealed -> break
        }
        loop at in reach -> seen[at] = false
        if !sealed -> next
        // Both rows are sets in the same canonical order (sema_effect_set_add),
        // so a solved row that holds the direct row and the stop alone lists
        // the direct row as it is.
        ^matched: 0
        loop name in solved[root] {
            if direct.contains(name) {
                matched += 1
                next
            }
            if !(panic && name == "Panic") -> sealed = false
        }
        if !sealed || matched != direct.len() || (panic && !solved[root].contains("Panic")) -> next
        rows.push(SemaCoreSealEffects{key: "", effects: direct.move(), panic: panic, writes: writes})
        roots.push(root)
    }
    ^at: 0
    ^index: 0
    loop node in nodes.move() {
        if at < roots.len() && roots[at] == index {
            rows[at].key = node.key.move()
            at += 1
        }
        index += 1
    }
    rows
}

// Whether `node`'s part of the effect graph is the same in every program
// that calls it: no open-world call, no call through a trait value or a
// type parameter, no function taken as a value, no scope publisher's
// renamed row, no context read, comptime input or library effect, and not
// one of the platform port's env reads the driver leaves out
// (JetDriver Pipeline.jet jet_driver_toolchain_env_read).
sema_effect_seal_plain: fn(node: SemaEffectNode) -> Bool Never! {
    if node.maximal || node.dispatches.len() > 0 || node.context_open -> return false
    if node.rare == .Val(rare) {
        if rare.param_dispatches.len() > 0 || rare.value_edges.len() > 0 || rare.scoped_calls.len() > 0 {
            return false
        }
        if rare.context_reads.len() > 0 || rare.context_keys.len() > 0 || rare.comptime_inputs.len() > 0 {
            return false
        }
        if rare.library_rows.len() > 0 || rare.library_denials.len() > 0 || rare.hook_lambdas.len() > 0 {
            return false
        }
    }
    !node.platform_env
}

// Whether a Core function filling `role` is one of the platform port's env
// reads (JetDriver Pipeline.jet jet_driver_toolchain_env_read): core.web's
// JET_APP_PORT read (AppPortEnv) or its JET_DEV read (AppDevEnv).
sema_effect_platform_env_read: fn(role: String) -> Bool Never! {
    role == "AppPortEnv" || role == "AppDevEnv"
}

SemaEffectBitOrder: struct {
    rank: Int,
    name: String,
    mask: Int,
}

sema_effect_intern_bit: fn(names: ^NameTable, name: String) -> Int Never! {
    id: name_index(name_intern(names, name))
    if id >= 62 -> return -1
    id
}

sema_effect_solve_slow: fn(nodes: [SemaEffectNode], callers: [[Int]]) -> [[String]] Never! {
    ^solved: [[String]]{}
    ^pending: [SemaEffectPending]{}
    loop (index, node) in nodes {
        ^row: node.direct
        if node.maximal {
            sema_effect_set_union(row, authority_grantable_roots())
            // An opaque call outside Core fails closed for `!Unsafe`.
            if !module_is_core(node.module_identity) -> sema_effect_set_add(row, "Unsafe")
        }
        loop edge in node.call_edges {
            if edge == "__jet_panic__" {
                sema_effect_set_add(row, "Panic")
                break
            }
        }
        loop name in row -> pending.push(SemaEffectPending{node: index, name: name})
        solved.push(row)
    }
    ^cursor: 0
    loop cursor < pending.len() {
        incoming: pending[cursor]
        cursor += 1
        loop caller in callers[incoming.node] {
            if nodes[caller].rare == .Val(rare) && rare.scoped_calls.len() > 0 {
                sema_effect_solve_scoped(solved, pending, nodes[caller], caller, nodes[incoming.node].key, incoming.name)
            } else if sema_effect_set_add(solved[caller], incoming.name) {
                pending.push(SemaEffectPending{node: caller, name: incoming.name})
            }
        }
    }
    solved
}

// Propagate each newly reached effect to callers once. Set insertion keeps
// the established root-rank/name order, so worklist order cannot change
// published rows or diagnostics. Direct rows and call-site spans are untouched.
sema_effect_solve: fn(nodes: [SemaEffectNode], callers: [[Int]]) -> [[String]] Never! {
    ^names: name_table()
    grantable: authority_grantable_roots()
    ^grantable_mask: 0
    loop root in grantable {
        id: sema_effect_intern_bit(names, root)
        if id < 0 -> return sema_effect_solve_slow(nodes, callers)
        grantable_mask |= 1 << id
    }
    unsafe_id: sema_effect_intern_bit(names, "Unsafe")
    panic_id: sema_effect_intern_bit(names, "Panic")
    if unsafe_id < 0 || panic_id < 0 -> return sema_effect_solve_slow(nodes, callers)
    unsafe_mask: 1 << unsafe_id
    panic_mask: 1 << panic_id
    ^bits: [Int]{}
    ^in_queue: [Bool]{}
    ^queue: [Int]{}
    if nodes.len() > 0 {
        bits.try_reserve(nodes.len()) ?? ()
        in_queue.try_reserve(nodes.len()) ?? ()
    }
    loop (index, node) in nodes {
        ^mask: 0
        loop name in node.direct {
            id: sema_effect_intern_bit(names, name)
            if id < 0 -> return sema_effect_solve_slow(nodes, callers)
            mask |= 1 << id
        }
        if node.maximal {
            mask |= grantable_mask
            // An opaque call outside Core fails closed for `!Unsafe`.
            if !module_is_core(node.module_identity) -> mask |= unsafe_mask
        }
        loop edge in node.call_edges {
            if edge == "__jet_panic__" {
                mask |= panic_mask
                break
            }
        }
        bits.push(mask)
        if mask != 0 {
            in_queue.push(true)
            queue.push(index)
        } else { in_queue.push(false) }
    }
    ^cursor: 0
    loop cursor < queue.len() {
        node_index: queue[cursor]
        cursor += 1
        in_queue[node_index] = false
        cur_bits: bits[node_index]
        if cur_bits == 0 -> next
        loop caller in callers[node_index] {
            if nodes[caller].rare == .Val(rare) && rare.scoped_calls.len() > 0 {
                callee_key: nodes[node_index].key
                ^add_bits: 0
                bare_ok: rare.bare_scope_callees.contains(callee_key)
                loop id in 0..<names.texts.len() {
                    bit: 1 << id
                    if (cur_bits & bit) == 0 -> next
                    effect_name: names.texts[id]
                    ^renamed: false
                    loop call in rare.scoped_calls {
                        if call.callee != callee_key || call.published != effect_name -> next
                        renamed = true
                        scoped_id: sema_effect_intern_bit(names, call.scoped)
                        if scoped_id < 0 -> return sema_effect_solve_slow(nodes, callers)
                        add_bits |= 1 << scoped_id
                    }
                    if !renamed || bare_ok -> add_bits |= bit
                }
                before: bits[caller]
                after: before | add_bits
                if after != before {
                    bits[caller] = after
                    if !in_queue[caller] {
                        in_queue[caller] = true
                        queue.push(caller)
                    }
                }
            } else {
                before: bits[caller]
                after: before | cur_bits
                if after != before {
                    bits[caller] = after
                    if !in_queue[caller] {
                        in_queue[caller] = true
                        queue.push(caller)
                    }
                }
            }
        }
    }
    ^ordered: loop (id, name) in names.texts -> SemaEffectBitOrder{rank: sema_effect_rank(name), name: name, mask: 1 << id}
    ordered.sort_by(fn(left: SemaEffectBitOrder, right: SemaEffectBitOrder) { (left.rank <=> right.rank).then(left.name <=> right.name) })
    ^ordered_masks: loop entry in ordered -> entry.mask
    ^ordered_names: loop entry in ordered -> entry.name
    ^solved: [[String]]{}
    if nodes.len() > 0 -> solved.try_reserve(nodes.len()) ?? ()
    ^by_mask: [Int:Int]{}
    ^unique_rows: [[String]]{}
    loop mask in bits {
        if mask == 0 {
            solved.push([String]{})
            next
        }
        if by_mask.get(mask) == .Val(slot) {
            solved.push(unique_rows[slot])
            next
        }
        row: loop k in 0..<ordered_masks.len() if (mask & ordered_masks[k]) != 0 -> ordered_names[k]
        slot: unique_rows.len()
        by_mask[mask] = slot
        unique_rows.push(row)
        solved.push(unique_rows[slot])
    }
    solved
}

// One effect reaching `caller` from the callee `callee_key` when the caller
// calls scope publishers: a publisher's bare effect arrives as each scope the
// caller's constant arguments name, and bare too only when it also calls that
// publisher with a run-time argument.
sema_effect_solve_scoped: fn(solved: ^[[String]], pending: ^[SemaEffectPending], node: SemaEffectNode, caller: Int, callee_key: String, name: String) Never! {
    rare: node.rare ?? SEMA_EFFECT_NODE_NO_RARE
    ^renamed: false
    loop call in rare.scoped_calls {
        if call.callee != callee_key || call.published != name -> next
        renamed = true
        if sema_effect_set_add(solved[caller], call.scoped) {
            pending.push(SemaEffectPending{node: caller, name: call.scoped})
        }
    }
    if renamed && !rare.bare_scope_callees.contains(callee_key) {
        return
    }
    if sema_effect_set_add(solved[caller], name) {
        pending.push(SemaEffectPending{node: caller, name: name})
    }
}

// The "secret" reachability row: only a direct `Secret` read seeds it, never
// the every-root row of an open-world (maximal) call, and callers inherit it
// along call edges. E1264 consults this row, not `solved`.
sema_effect_secret_reach: fn(nodes: [SemaEffectNode], callers: [[Int]]) -> [Bool] Never! {
    ^reached: (loop _ in nodes -> false)
    ^pending: [Int]{}
    loop (index, node) in nodes {
        loop effect_name in node.direct {
            if sema_effect_root(effect_name) == "Secret" {
                reached[index] = true
                pending.push(index)
                break
            }
        }
    }
    ^cursor: 0
    loop cursor < pending.len() {
        incoming: pending[cursor]
        cursor += 1
        loop caller in callers[incoming] {
            if reached[caller] -> next
            reached[caller] = true
            pending.push(caller)
        }
    }
    reached
}

sema_effect_tfacts: fn(node: SemaEffectNode, solved: [String], solved_module_write: String?) -> TEffectFacts Never! {
    rare: node.rare ?? SEMA_EFFECT_NODE_NO_RARE
    TEffectFacts{direct: node.direct, solved: solved, call_edges: node.call_edges, maximal: node.maximal, direct_spans: node.direct_spans, maximal_span: node.maximal_span, value_edges: rare.value_edges, module_writes: rare.module_writes, module_reads: rare.module_reads, solved_module_write: solved_module_write}
}

// The span is the first entry of the declared effect row, or the function's
// name when it declares none.
sema_effect_secret_diagnostic: fn(node: SemaEffectNode) -> Diagnostic {
    sema_error("E1264", node.row_span ?? node.name_span, "`{node.name}` reads a secret but doesn't declare the `Secret` effect", "reading a secret (`core.crypto.vault.get`) always requires an explicit grant — unlike other effects, there is no silently-inferred default here, so a function must opt in even with no other explicit effect row at all.", "add `-[Secret]>` to `{node.name}`'s signature (or widen an existing effect row to cover it)")
}

// The dispatch key `Trait.method` reads as the source spelling `Trait.method`.
sema_effect_unbounded_dispatch_diagnostic: fn(dispatch: TEffectSpan) -> Diagnostic {
    method: dispatch.name.replace(".", ".")
    sema_error("E0743", dispatch.span, "dynamic call `{method}` has no effect bound", "a trait value can select any implementation at runtime, and the program holds none of this method to bound the call, so an enclosing effect ceiling needs the trait method's declared row or a ceiling in the trait's `#FX(…)` cap", "declare an effect row on `{method}`, such as `-[]>` for pure dispatch, put an `#FX(…)` ceiling above the trait, or move this dynamic call outside the bounded function")
}

sema_effect_locate_dispatch: fn(site: SemaEffectDispatchSite, inputs: [SemaEffectModuleInput]) -> Diagnostic Never! {
    ^located: sema_diagnostic_with_source_location(
        sema_effect_unbounded_dispatch_diagnostic(site.dispatch),
        inputs[site.module_index].source_segments,
    )
    if located.source_path == None -> located.span = None
    located.move()
}

// Nodes from which some unbounded trait dispatch is reachable through the
// call graph (the node itself included): one reverse walk from every node
// that dispatches.
sema_effect_dispatch_reach: fn(nodes: [SemaEffectNode], callers: [[Int]]) -> [Bool] Never! {
    ^reach: (loop _ in nodes -> false)
    ^pending: [Int]{}
    loop (index, node) in nodes {
        if node.dispatches.len() > 0 {
            reach[index] = true
            pending.push(index)
        }
    }
    ^cursor: 0
    loop cursor < pending.len() {
        incoming: pending[cursor]
        cursor += 1
        loop caller in callers[incoming] {
            if reach[caller] -> next
            reach[caller] = true
            pending.push(caller)
        }
    }
    reach
}

// The first unbounded trait dispatch reachable from `index` through the call
// graph, the function's own calls first. `reach` skips dispatch-free callees;
// `visited` records the rows to clear before the next root.
sema_effect_find_dispatch: fn(nodes: [SemaEffectNode], reach: [Bool], index: Int, seen: ^[Bool], visited: ^[Int]) -> SemaEffectDispatchSite? {
    if seen[index] -> return None
    seen[index] = true
    visited.push(index)
    if nodes[index].dispatches.len() > 0 {
        return Val(SemaEffectDispatchSite{dispatch: nodes[index].dispatches[0], module_index: nodes[index].module_index})
    }
    loop target in nodes[index].call_targets {
        if target < 0 || !reach[target] -> next
        found: sema_effect_find_dispatch(nodes, reach, target, seen, visited)
        if found != None -> return found
    }
    None
}

sema_effect_trait_bound_diagnostic: fn(bound: SemaEffectTraitBound, over: [String], span: Span, impl_key: String) -> Diagnostic {
    over_list: sema_effect_show(over)
    bound_text: if bound.bound.len() == 0 -> "`{bound.trait_name}` bounds `{bound.method}` to `-[]>`, so impls must be pure" else -> "`{bound.trait_name}` bounds `{bound.method}` to `-[{sema_effect_show(bound.bound)}]>`, so impls may use only those"
    diagnostic: sema_error("E0742", span, "this `{bound.method}` impl uses the effect `{over_list}`, which the trait doesn't allow", "{bound_text}; `{over_list}` is outside that bound", "remove the `{over_list}` work from this impl, or widen the bound on the trait method")
    diagnostic_with_rights(diagnostic, "invocation", [String]{impl_key}, [String]{}, None)
}

// Every impl of a bounded trait method stays within the trait's row.
sema_effect_check_trait_bounds: fn(module_row: SemaEffectModuleInput, functions: [FnBody], source_index: SemaEffectSourceIndex, nodes: [SemaEffectNode], node_by_key: SemaEffectNodeKeys, symbols: SymbolTable, solved: [[String]], diagnostics: ^[Diagnostic]) {
    if module_row.trait_bounds.len() == 0 {
        return
    }
    loop function in functions {
        // An owned operator or CheckedText trait (`impl Vec2.Add`) has no
        // source row, so its method is checked as a plain one named in
        // `owned_trait_hooks`. A method of an `impl Trait` block in a struct
        // or enum body names its trait through its source.
        owner_type: if function.kind == {
            .Method(_, owner) -> owner
            .TraitMethod(_, _, owner, _, _) -> owner
            .TopLevel -> {
                next
            }
        }
        node_index: sema_effect_node_index(node_by_key, function.key) ?? next
        ^trait_name: if symbol_find(symbols, function.key) == .Val(id) -> module_row.owned_trait_hooks.get(id.id) ?? "" else -> ""
        if nodes[node_index].trait_symbol == .Val(trait_id) {
            trait_name = symbol_key_leaf(symbol_table_key(symbols, trait_id))
        }
        if function.kind == .TraitMethod(_, _, _, trait_symbol, _) {
            trait_name = symbol_key_leaf(symbol_key(symbols, function.tree.symbols, trait_symbol))
        }
        if trait_name == "" -> next
        method: sema_effect_method_name(function, module_row.sources, source_index)
        loop bound in module_row.trait_bounds {
            if bound.trait_name != trait_name || bound.method != method -> next
            over: sema_effect_uncovered(solved[node_index], bound.bound)
            if over.len() > 0 {
                diagnostics.push(sema_effect_trait_bound_diagnostic(bound, over, nodes[node_index].name_span, "{type_name(owner_type)}.{method}"))
            }
            break
        }
    }
}

// A trait method's source name (its own spelling), or the checked name when
// the function has no source row.
sema_effect_method_name: fn(function: FnBody, sources: [SemaEffectFunctionSource], source_index: SemaEffectSourceIndex) -> String Never! {
    at: sema_effect_source_position(function, source_index) ?? return function.name
    sources[at].name
}

// The byte bound of `Mem.Alloc(above: N)`.
sema_effect_memory_bound: fn(name: String) -> Int? { sema_effect_above_bytes(name, "Mem.Alloc(") }

// The byte bound of `Mem.Stack(above: N)`.
sema_effect_stack_bound: fn(name: String) -> Int? { sema_effect_above_bytes(name, "Mem.Stack(") }

// The `N` of a bounded denial `{opening}above: N)`.
sema_effect_above_bytes: fn(name: String, opening: String) -> Int? {
    if !name.starts_with(opening) -> return None
    parts: name.split(":").to_list()
    if parts.len() != 2 -> return None
    amount: parts[1].split(")").to_list()
    if amount.len() == 0 -> return None
    bytes: Int.parse(amount[0].trim()) ?? return None
    Val(bytes)
}

// The display of the denials a memory proof covers.
sema_effect_memory_fact: fn(name: String) -> String? {
    if name == "Mem.Alloc" || name == "Mem.Rc" -> return Val("!{name}")
    bound: sema_effect_memory_bound(name) ?? return None
    Val("!Mem.Alloc(above: {bound})")
}

sema_effect_span_before: fn(left: Span, right: Span) -> Bool Never! {
    left.start < right.start || (left.start == right.start && left.end < right.end)
}

sema_effect_memory_sorted_event_indices: fn(events: [SemaMemoryEvent]) -> [Int] Never! {
    ^sorted: [Int]{}
    loop event_index in 0..<events.len() {
        sorted.push(event_index)
        ^index: sorted.len() - 1
        loop index > 0 && sema_effect_span_before(events[sorted[index]].span, events[sorted[index - 1]].span) {
            swap: sorted[index - 1]
            sorted[index - 1] = sorted[index]
            sorted[index] = swap
            index -= 1
        }
    }
    sorted
}

sema_effect_memory_sorted_call_indices: fn(calls: [SemaMemoryCall]) -> [Int] Never! {
    ^sorted: [Int]{}
    loop call_index in 0..<calls.len() {
        sorted.push(call_index)
        ^index: sorted.len() - 1
        loop index > 0 && sema_effect_span_before(calls[sorted[index]].span, calls[sorted[index - 1]].span) {
            swap: sorted[index - 1]
            sorted[index - 1] = sorted[index]
            sorted[index] = swap
            index -= 1
        }
    }
    sorted
}

// The finding at `owner` along `steps`, its nodes from its root.
sema_effect_memory_finding: fn(nodes: [SemaEffectNode], event: SemaMemoryEvent?, owner: Int, open: SemaMemoryOpen?, steps: [Int], used: Int) -> SemaMemoryFinding Never! {
    path: loop step in steps -> nodes[step].display_key
    SemaMemoryFinding{event: event, owner: owner, open: open, path: path, used: used, steps: steps}
}

sema_effect_memory_open_finding: fn(nodes: [SemaEffectNode], span: Span, source: String, reason: String, owner: Int, steps: [Int], used: Int) -> SemaMemoryFinding Never! {
    sema_effect_memory_finding(nodes, None, owner, Val(SemaMemoryOpen{span: span, source: source, reason: reason}), steps, used)
}

sema_effect_arena_failure: fn(finding: SemaMemoryFinding) -> SemaMemoryArena Never! {
    SemaMemoryArena{bytes: 0, witness: None, failure: Val(finding)}
}

// The shortest violation for the unbounded facts: breadth-first search gives
// the shortest call path to the first event of `kind` ("alloc" for
// `!Mem.Alloc`, "rc" for `!Mem.Rc`) or, with `opens`, to an open dispatch.
sema_effect_memory_search: fn(nodes: [SemaEffectNode], root: Int, kind: String, opens: Bool{true}) -> SemaMemoryFinding? {
    ^queue: [Int]{root}
    // The node each reached node was first reached from; -1 for the root.
    ^parents: (loop _ in nodes -> -1)
    ^seen: (loop _ in nodes -> false)
    seen[root] = true
    ^cursor: 0
    loop cursor < queue.len() {
        index: queue[cursor]
        cursor += 1
        loop event_index in sema_effect_memory_sorted_event_indices(nodes[index].memory_events) {
            event: nodes[index].memory_events[event_index]
            if event.kind == kind {
                return Val(sema_effect_memory_found(nodes, parents, index, Val(event), None))
            }
        }
        // copy: the memory finding owns its open site, while the site stays in nodes[index] (the
        // caller's read-only effect graph), which later searches read.
        if opens && nodes[index].rare == .Val(rare) && rare.memory_opens.len() > 0 {
            return Val(sema_effect_memory_found(nodes, parents, index, None, Val(rare.memory_opens[0].copy())))
        }
        loop target in nodes[index].call_targets {
            if target < 0 || seen[target] -> next
            seen[target] = true
            parents[target] = index
            queue.push(target)
        }
    }
    None
}

// A search's finding at node `owner`, which it reached from its root along
// `parents` (sema_effect_memory_search).
sema_effect_memory_found: fn(nodes: [SemaEffectNode], parents: [Int], owner: Int, event: SemaMemoryEvent?, open: SemaMemoryOpen?) -> SemaMemoryFinding Never! {
    ^back: [Int]{owner}
    loop parents[back[back.len() - 1]] >= 0 { back.push(parents[back[back.len() - 1]]) }
    steps: loop at in 0..<back.len() -> back[back.len() - 1 - at]
    path: loop step in steps -> nodes[step].display_key
    SemaMemoryFinding{event: event, owner: owner, open: open, path: path, used: 0, steps: steps}
}

// On a machine with no heap (named `machine`), the program keeps the promise
// `-[!Mem.Alloc]>` makes from its start: nothing an entry (`entries`, by key)
// reaches allocates, in Core and packages as in the program's own code (the
// graph modules `own_modules` marks). The first allocation each entry
// reaches is E3303 where the program's own code allocates, or at the
// program's call that leads to it, whose report names each step and the line
// that allocates. An open dispatch is no allocation the proof finds: a
// foreign body runs on the machine's own memory, not the program's heap.
sema_effect_check_heap_free: fn(nodes: [SemaEffectNode], inputs: [SemaEffectModuleInput], own_modules: [Bool], calls: SemaEffectCallIndex, entries: [String], machine: String, diagnostics: ^[Diagnostic]) Never! {
    ^reported: SemaKeyRows{}
    loop key in entries {
        root: sema_effect_node_index(calls.node_by_key, key) ?? next
        found: sema_effect_memory_search(nodes, root, "alloc", opens: false) ?? next
        event: found.event ?? next
        // The program's own code runs from the entry to the first step
        // outside it, which the last step inside it calls.
        ^own: 0
        loop own + 1 < found.steps.len() && sema_effect_own_node(nodes[found.steps[own + 1]], inputs, own_modules) {
            own += 1
        }
        caller: found.steps[own]
        // The program's call: the step inside it that leads out of it.
        ^span: event.span
        if own + 1 < found.steps.len() {
            span = nodes[caller].name_span
            loop call in nodes[caller].memory_calls {
                if call.target == found.steps[own + 1] {
                    span = call.span
                    break
                }
            }
        }
        at: sema_key_span(reported, Val(span))
        site_key: sema_key_pair(reported, nodes[caller].module_index, at)
        if !sema_key_first(reported, site_key) -> next
        heap_diagnostics: [Diagnostic]{sema_effect_heap_free_diagnostic(nodes, inputs, found, event, own, span, machine)}
        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[caller].module_index].source_segments, heap_diagnostics)
    }
}

// The E3303 of a heap-free proof's finding (sema_effect_check_heap_free) at
// `span`: the program's own allocation, or its call that leads past step
// `own` of `found.steps` to the allocation, which the report's chain names
// with each step and its line.
sema_effect_heap_free_diagnostic: fn(nodes: [SemaEffectNode], inputs: [SemaEffectModuleInput], found: SemaMemoryFinding, event: SemaMemoryEvent, own: Int, span: Span, machine: String) -> Diagnostic Never! {
    if own + 1 == found.steps.len() {
        return sema_error("E3303", span, "This no-OS program allocates memory but has no allocator fact.", "No-OS targets do not provide an implicit system heap.", "Select a typed allocator provider, or use heap-free Core operations.")
    }
    owner: nodes[found.owner]
    line: sema_source_line_at(inputs[owner.module_index].source_segments, event.span)
    site: if line == .Val(number) -> "{owner.source_display}:{number}" else -> owner.source_display
    chain: loop step in found.steps -> nodes[step].chain_name
    diagnostic: sema_error("E3303", span, "`{nodes[found.steps[own + 1]].display_key}` allocates memory, but target `{machine}` has no heap", "`{owner.display_key}` allocates at {site}: {event.operation}; on a machine with no heap, nothing the program reaches may allocate, in Core and packages as in its own code", "Select a target machine with an allocator, or call a heap-free operation instead.")
    diagnostic_with_rights(diagnostic, "invocation", chain, [String]{}, None)
}

// Whether `node` is the program's own code: a function of a graph module
// `own_modules` marks.
sema_effect_own_node: fn(node: SemaEffectNode, inputs: [SemaEffectModuleInput], own_modules: [Bool]) -> Bool Never! {
    graph_module: inputs[node.module_index].module_index
    graph_module < own_modules.len() && own_modules[graph_module]
}

// Whether an arena may be reached over the known call graph.
sema_effect_may_reach_arena: fn(nodes: [SemaEffectNode], index: Int, visiting: ^[Bool]) -> Bool {
    if visiting[index] -> return true
    visiting[index] = true
    ^found: false
    loop event in nodes[index].memory_events {
        if event.kind == "arena" -> found = true
    }
    if !found {
        loop target in nodes[index].call_targets {
            if target < 0 -> next
            if sema_effect_may_reach_arena(nodes, target, visiting) {
                found = true
                break
            }
        }
    }
    visiting[index] = false
    found
}

// A heap allocation `!Mem.Alloc(above: N)` cannot size: an "alloc" event that
// is not the companion of the arena reservation counted at the same site.
sema_effect_unsized_alloc: fn(node: SemaEffectNode, event: SemaMemoryEvent) -> Bool Never! {
    if event.kind != "alloc" -> return false
    loop other in node.memory_events {
        if other.kind == "arena" && other.span.start == event.span.start && other.span.end == event.span.end {
            return false
        }
    }
    true
}

// The proven arena bytes `index` can reserve, with the event that witnesses the
// total, or the finding that stops the proof. `steps` are the nodes from the
// proof's root to `index`.
sema_effect_arena_bound: fn(nodes: [SemaEffectNode], index: Int, visiting: ^[Bool], steps: ^[Int]) -> SemaMemoryArena {
    if visiting[index] {
        return sema_effect_arena_failure(sema_effect_memory_open_finding(nodes, Span{start: 0, end: 0}, nodes[index].display_key, "recursive call multiplicity is not statically bounded for arena accounting", index, steps, 0))
    }
    visiting[index] = true
    result: sema_effect_arena_bound_inner(nodes, index, visiting, steps)
    visiting[index] = false
    result
}

sema_effect_arena_bound_inner: fn(nodes: [SemaEffectNode], index: Int, visiting: ^[Bool], steps: ^[Int]) -> SemaMemoryArena {
    node: nodes[index]
    // copy: the arena failure owns its open site, while the site stays in `node`, a row of the
    // caller's read-only effect graph, which later searches read.
    if node.rare == .Val(rare) && rare.memory_opens.len() > 0 {
        return sema_effect_arena_failure(sema_effect_memory_finding(nodes, None, index, Val(rare.memory_opens[0].copy()), steps, 0))
    }
    ^total: 0
    ^witness: SemaMemoryFinding?{None}
    loop event_index in sema_effect_memory_sorted_event_indices(node.memory_events) {
        event: node.memory_events[event_index]
        // A heap allocation has no proven size, so a byte bound cannot hold
        // over it; the arena reservation at the same site is counted instead.
        if sema_effect_unsized_alloc(node, event) {
            return sema_effect_arena_failure(sema_effect_memory_finding(nodes, Val(event), index, None, steps, total))
        }
        if event.kind != "arena" -> next
        bytes: event.bytes ?? return sema_effect_arena_failure(sema_effect_memory_finding(nodes, Val(event), index, None, steps, total))
        executions: event.executions ?? return sema_effect_arena_failure(sema_effect_memory_open_finding(nodes, event.span, node.source_display, "loop iteration count is not statically bounded for arena accounting", index, steps, total))
        total += bytes * executions
        witness = Val(sema_effect_memory_finding(nodes, Val(event), index, None, steps, 0))
    }
    loop target in node.call_targets {
        if target < 0 -> next
        ^called: false
        loop call in node.memory_calls {
            if call.target == target -> called = true
        }
        if called -> next
        ^reach_visiting: (loop _ in nodes -> false)
        if sema_effect_may_reach_arena(nodes, target, reach_visiting) {
            return sema_effect_arena_failure(sema_effect_memory_open_finding(nodes, Span{start: 0, end: 0}, nodes[target].display_key, "call-site multiplicity is unavailable for arena accounting", index, steps, total))
        }
        // With no arena below it, the callee's multiplicity does not matter:
        // any heap allocation it reaches breaks the bound.
        if sema_effect_memory_search(nodes, target, "alloc") == .Val(found) {
            ^full: loop step in steps -> step
            loop step in found.steps -> full.push(step)
            return sema_effect_arena_failure(sema_effect_memory_finding(nodes, found.event, found.owner, found.open, full, total))
        }
    }
    loop call_index in sema_effect_memory_sorted_call_indices(node.memory_calls) {
        call: node.memory_calls[call_index]
        target: call.target
        if target < 0 -> next
        steps.push(target)
        proof: sema_effect_arena_bound(nodes, target, visiting, steps)
        if proof.failure != None {
            ^_: steps.pop()
            return proof
        }
        if proof.bytes == 0 {
            ^_: steps.pop()
            next
        }
        executions: call.executions ?? {
            failure: sema_effect_arena_failure(sema_effect_memory_open_finding(nodes, call.span, node.source_display, "loop iteration count is not statically bounded for arena accounting", index, steps, total))
            ^_: steps.pop()
            return failure
        }
        ^_: steps.pop()
        total += proof.bytes * executions
        if proof.witness != None -> witness = proof.witness
    }
    SemaMemoryArena{bytes: total, witness: witness, failure: None}
}

// The worst-case heap of each function nothing calls (FnBody.heap, `jet
// inspect memory`), by the proof sema_effect_arena_bound gives a
// `!Mem.Alloc(above: N)` root: the arena bytes every call path from it
// reserves, or why no bound holds (an unsized heap allocation, an open
// dispatch, recursion, or a count no bound covers). Each node is settled
// once: a node on a cycle is unbounded, so the walk's memo never depends on
// the path into it.
SemaHeapWalk: struct {
    // 0 not seen, 1 on the walk, 2 settled.
    state: [Int],
    // The node's arena bytes; -1 unbounded.
    bytes: [Int],
    // Why the node is unbounded when it is itself the reason; "" when the
    // reason is in `next`.
    why: [String],
    // The callee an unbounded node's path goes through; -1 none.
    next: [Int],
}

sema_effect_heap_open: fn(walk: ^SemaHeapWalk, index: Int, why: ^^String, next: Int) Never! {
    walk.bytes[index] = -1
    walk.why[index] = why
    walk.next[index] = next
    walk.state[index] = 2
}

sema_effect_heap_visit: fn(walk: ^SemaHeapWalk, nodes: [SemaEffectNode], index: Int) Never! {
    walk.state[index] = 1
    node: nodes[index]
    if node.rare == .Val(rare) && rare.memory_opens.len() > 0 {
        open: rare.memory_opens[0]
        sema_effect_heap_open(walk, index, "{open.reason} at {open.source}", -1)
        return
    }
    ^total: 0
    loop event_index in sema_effect_memory_sorted_event_indices(node.memory_events) {
        event: node.memory_events[event_index]
        if sema_effect_unsized_alloc(node, event) {
            sema_effect_heap_open(walk, index, "{event.operation} at {node.source_display}", -1)
            return
        }
        if event.kind != "arena" -> next
        if event.bytes == None {
            sema_effect_heap_open(walk, index, "{event.operation} at {node.source_display} has no proven size", -1)
            return
        }
        if event.executions == None {
            sema_effect_heap_open(walk, index, "{event.operation} at {node.source_display} runs a number of times no bound covers", -1)
            return
        }
        bytes: event.bytes ?? 0
        executions: event.executions ?? 0
        total += bytes * executions
    }
    loop target in node.call_targets {
        if target < 0 -> next
        if walk.state[target] == 1 {
            sema_effect_heap_open(walk, index, "recursion through {nodes[target].display_key}", -1)
            return
        }
        if walk.state[target] == 0 -> sema_effect_heap_visit(walk, nodes, target)
        if walk.bytes[target] < 0 {
            sema_effect_heap_open(walk, index, "", target)
            return
        }
        if walk.bytes[target] == 0 -> next
        ^counted: false
        loop call in node.memory_calls {
            if call.target == target -> counted = true
        }
        if !counted {
            sema_effect_heap_open(walk, index, "a call to {nodes[target].display_key} whose count is unknown", -1)
            return
        }
    }
    loop call in node.memory_calls {
        target: call.target
        if target < 0 -> next
        if walk.state[target] == 0 -> sema_effect_heap_visit(walk, nodes, target)
        if walk.state[target] == 1 {
            sema_effect_heap_open(walk, index, "recursion through {nodes[target].display_key}", -1)
            return
        }
        if walk.bytes[target] < 0 {
            sema_effect_heap_open(walk, index, "", target)
            return
        }
        if walk.bytes[target] == 0 -> next
        executions: call.executions ?? {
            sema_effect_heap_open(walk, index, "a call to {nodes[target].display_key} in a loop no bound covers", -1)
            return
        }
        total += walk.bytes[target] * executions
    }
    walk.bytes[index] = total
    walk.state[index] = 2
}

// Whether a direct call reaches each node: the others are entries, whose
// worst-case heap and stack FnBody keeps.
sema_effect_called: fn(nodes: [SemaEffectNode]) -> [Bool] Never! {
    ^called: (loop _ in nodes -> false)
    loop node in nodes {
        loop target in node.call_targets {
            if target < 0 -> next
            called[target] = true
        }
    }
    called
}

// The heap text of every node nothing calls, by node; "" for the others.
sema_effect_heap_bounds: fn(nodes: [SemaEffectNode], called: [Bool]) -> [String] Never! {
    ^walk: SemaHeapWalk{state: (loop _ in nodes -> 0), bytes: (loop _ in nodes -> 0), why: (loop _ in nodes -> ""), next: (loop _ in nodes -> -1)}
    ^texts: [String]{}
    loop index in 0..<nodes.len() {
        if called[index] {
            texts.push("")
            next
        }
        if walk.state[index] == 0 -> sema_effect_heap_visit(walk, nodes, index)
        if walk.bytes[index] >= 0 {
            texts.push("{walk.bytes[index]} B")
            next
        }
        ^path: [String]{}
        ^seen: [Int:Bool]{}
        ^why_row: -1
        ^row: index
        loop row >= 0 && seen.get(row) == None {
            seen[row] = true
            path.push(nodes[row].display_key.copy())
            if walk.why[row] != "" {
                why_row = row
                break
            }
            row = walk.next[row]
        }
        if why_row >= 0 {
            texts.push("unbounded, {walk.why[why_row]} via {path.join(" -> ")}")
        } else {
            texts.push("unbounded,  via {path.join(" -> ")}")
        }
    }
    texts
}

// Each node's own frame bound by the frame model (jet_foundation
// Target/Frame.jet), stamped as FnBody.frame_bound: the
// frame allowance plus the slots of every parameter and checked value. -1
// with `why` naming the type that has no known size, or with `why` empty
// when the node has no checked body. `depth` is the node's `#MaxDepth(n)`,
// 0 when unmarked. `edges` are the nodes each node's calls may run: its
// direct calls, and in an executable build the sealed targets of its calls
// through function values (sema_effect_stack_seal). `carried` is the largest
// frame of a lambda those calls may run, which sits on the node's own;
// `carrier` is the lambda's writer, -1 for none. `sealed` names the sealed
// targets, "" for none, and `dynamic_calls` holds the spans of the calls
// through function values. In a library build, or when the program takes a
// function with no checked body as a value, a node's calls through function
// values are `open` instead, with the reason; "" when they are not.
SemaStackFrames: struct {
    own: [Int],
    why: [String],
    depth: [Int],
    edges: [[Int]],
    carried: [Int],
    carrier: [Int],
    sealed: [String],
    dynamic_calls: [[Span]],
    open: [String],
}

// What the program's bodies do with function and trait values: the calls
// through them (a trait-value call has arity -1), the lambdas they write,
// the policy wrappers they take as values, the functions with no checked
// body they take as values, and in an executable build the implementations
// each trait-value call may run.
SemaStackValues: struct {
    calls: [SemaStackDynamicCall],
    lambdas: [SemaStackLambda],
    wrappers: [SemaStackTaken],
    bodiless: [SemaStackTaken],
    dispatches: [SemaStackDispatch],
}

// A function value `node` makes: a node, or for one with no checked body,
// -1 and its `name`.
SemaStackTaken: struct {
    node: Int,
    target: Int,
    name: String,
}

// A call through a trait value in `node` and the implementations it may run.
SemaStackDispatch: struct {
    node: Int,
    targets: [Int],
}

// Each function's own frame and what its body does with function and trait
// values (sema_effect_stack_own, sema_effect_stack_dynamic), one row per
// function with a node, in input module and function order: its `node`, its
// `#MaxDepth(n)` `depth`, its parameter count `arity`, and `own`, its frame's
// bytes, or -1 when `why` names a value with no known size ("" otherwise).
// `values` holds the rows' function values in the same order.
SemaStackBodies: struct {
    node: [Int],
    depth: [Int],
    arity: [Int],
    own: [Int],
    why: [String],
    values: SemaStackValues,
}

sema_effect_stack_bodies_empty: fn() -> SemaStackBodies Never! {
    SemaStackBodies{node: [Int]{}, depth: [Int]{}, arity: [Int]{}, own: [Int]{}, why: [String]{}, values: SemaStackValues{calls: [SemaStackDynamicCall]{}, lambdas: [SemaStackLambda]{}, wrappers: [SemaStackTaken]{}, bodiless: [SemaStackTaken]{}, dispatches: [SemaStackDispatch]{}}}
}

// `closed` is an executable build, whose every function value the program
// makes; a library's callers may pass any. `bodies` are the functions' rows
// (sema_effect_stack_bodies); a node's later function overrides an earlier
// one's frame, as a walk of the functions in order writes it.
sema_effect_stack_frames: fn(nodes: [SemaEffectNode], bodies: SemaStackBodies, closed: Bool{false}) -> SemaStackFrames {
    ^frames: SemaStackFrames{
        own: (loop _ in nodes -> -1),
        why: (loop _ in nodes -> ""),
        depth: (loop _ in nodes -> 0),
        edges: (loop node in nodes -> sema_effect_stack_node_targets(node)),
        carried: (loop _ in nodes -> 0),
        carrier: (loop _ in nodes -> -1),
        sealed: (loop _ in nodes -> ""),
        dynamic_calls: (loop _ in nodes -> [Span]{}),
        open: (loop _ in nodes -> ""),
    }
    ^arity: (loop _ in nodes -> -1)
    loop (row, node_index) in bodies.node {
        frames.depth[node_index] = bodies.depth[row]
        arity[node_index] = bodies.arity[row]
        if bodies.why[row] == "" -> frames.own[node_index] = bodies.own[row]
        if bodies.why[row] != "" -> frames.why[node_index] = bodies.why[row]
    }
    loop call in bodies.values.calls -> frames.dynamic_calls[call.node].push(call.span)
    if !closed {
        loop call in bodies.values.calls {
            display: nodes[call.node].display_key
            frames.open[call.node] = if call.arity < 0 -> "a call through a trait value in {display}, whose implementations a library build leaves open" else -> "a call through a function value in {display}, whose targets a library build leaves open"
        }
        return frames
    }
    sema_effect_stack_seal(frames, nodes, arity, bodies.values)
    frames
}

// A compiler thread is admitted for at least this many bytes of function
// source, so a small program sizes its frames on the calling thread.
SEMA_EFFECT_STACK_MIN_BYTES_PER_THREAD: 65536

// Every function's row of `bodies` (SemaStackBodies), on up to `threads`
// compiler threads. A function's row reads only its own body, the frame
// sizes of the program's types, the graph's nodes and the call index, and
// writes nothing shared. Threads claim consecutive parts of the functions
// dynamically, each part into its own rows, reading the modules, the nodes
// and the call index in place; the parts join in part order, so the rows are
// the same for any thread count.
sema_effect_stack_bodies: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], function_nodes: [[Int]], nodes: [SemaEffectNode], calls: SemaEffectCallIndex, threads: CompilerThreads, bodies: ^SemaStackBodies, closed: Bool{false}) {
    ^defs: [TTypeDef]{}
    loop graph in modules {
        loop definition in graph.declarations.type_defs -> defs.push(definition.copy())
    }
    types: jet_frame_types(defs)
    ^job_module: [Int]{}
    ^job_function: [Int]{}
    ^job_node: [Int]{}
    ^weights: [Int]{}
    ^work: 0
    loop (input_position, module_row) in inputs {
        loop (function_index, function) in modules[module_row.module_index].functions {
            node_index: function_nodes[input_position][function_index]
            if node_index < 0 -> next
            job_module.push(module_row.module_index)
            job_function.push(function_index)
            job_node.push(node_index)
            bodies.depth.push(function.max_depth)
            bodies.arity.push(function.params.len())
            weight: function.source_span.end - function.source_span.start
            weights.push(weight)
            work += weight
        }
    }
    workers: compiler_threads_admit(threads, job_node.len(), work, SEMA_EFFECT_STACK_MIN_BYTES_PER_THREAD, 0, 0)
    if workers <= 1 {
        loop (job, node_index) in job_node {
            sema_effect_stack_own(calls.interner, types, modules[job_module[job]].functions[job_function[job]], bodies)
            sema_effect_stack_dynamic(modules[job_module[job]].functions[job_function[job]].tree, node_index, nodes, calls, closed, bodies.values)
        }
        bodies.node = job_node.move()
        return
    }
    ^count: workers * SEMA_EFFECT_COLLECT_PARTS_PER_THREAD
    if count > job_node.len() -> count = job_node.len()
    bounds: compiler_threads_partition(weights, count)
    jobs: SemaStackJobs{module_index: job_module.move(), function: job_function.move(), node: job_node.move(), closed: closed}
    queue: SemaEffectCollectQueue{next: 0}
    ^parts: [SemaStackBodies]{}
    loop _ in 0..<count -> parts.push(sema_effect_stack_bodies_empty())
    sema_effect_stack_bodies_claimers(modules, nodes, calls, types, jobs, bounds, queue, 0, workers, parts)
    loop part in 0..<count -> sema_effect_stack_bodies_join(bodies, parts[part])
    bodies.node = jobs.node.move()
}

// What every frame-sizing thread reads beside the modules, the graph's
// nodes, the call index and the program's frame types: each function's
// module, its row there and its node; and whether the build is closed.
SemaStackJobs: struct {
    module_index: [Int],
    function: [Int],
    node: [Int],
    closed: Bool,
}

// A part one thread sized: its number and its functions' rows.
SemaStackBodiesPart: struct {
    part: Int,
    bodies: SemaStackBodies,
}

// Appends a part's rows (all but its nodes) to `bodies`, leaving the part
// empty.
sema_effect_stack_bodies_join: fn(bodies: ^SemaStackBodies, part: ^SemaStackBodies) {
    compiler_transfer_rows<Int>(bodies.own, part.own)
    compiler_transfer_rows<String>(bodies.why, part.why)
    compiler_transfer_rows<SemaStackDynamicCall>(bodies.values.calls, part.values.calls)
    compiler_transfer_rows<SemaStackLambda>(bodies.values.lambdas, part.values.lambdas)
    compiler_transfer_rows<SemaStackTaken>(bodies.values.wrappers, part.values.wrappers)
    compiler_transfer_rows<SemaStackTaken>(bodies.values.bodiless, part.values.bodiless)
    compiler_transfer_rows<SemaStackDispatch>(bodies.values.dispatches, part.values.dispatches)
}

// Runs frame-sizing threads `from..<workers`, one task each, and moves every
// part a thread returned into `parts`.
sema_effect_stack_bodies_claimers: fn(modules: [SemaGraphModuleResult], nodes: [SemaEffectNode], calls: SemaEffectCallIndex, types: JetFrameTypes, jobs: SemaStackJobs, bounds: [Int], queue: SemaEffectCollectQueue, from: Int, workers: Int, parts: ^[SemaStackBodies]) {
    if from >= workers {
        return
    }
    task.group sema_effect_stack_threads {
        head: task sema_effect_stack_bodies_claimed(modules, nodes, calls, types, jobs, bounds, queue)
        sema_effect_stack_bodies_claimers(modules, nodes, calls, types, jobs, bounds, queue, from + 1, workers, parts)
        ^claimed: compiler_threads_joined(head)
        loop claimed.len() > 0 {
            done: claimed.pop() ?? break
            parts[done.part] = done.bodies.move()
        }
    }
}

// One thread: sizes the parts it claims, each into its own rows.
sema_effect_stack_bodies_claimed: fn(modules: [SemaGraphModuleResult], nodes: [SemaEffectNode], calls: SemaEffectCallIndex, types: JetFrameTypes, jobs: SemaStackJobs, bounds: [Int], queue: SemaEffectCollectQueue) -> [SemaStackBodiesPart] {
    ^claimed: [SemaStackBodiesPart]{}
    loop {
        part: queue.next.add(1)
        if part >= bounds.len() - 1 -> break
        ^bodies: sema_effect_stack_bodies_empty()
        loop job in bounds[part]..<bounds[part + 1] {
            sema_effect_stack_own(calls.interner, types, modules[jobs.module_index[job]].functions[jobs.function[job]], bodies)
            sema_effect_stack_dynamic(modules[jobs.module_index[job]].functions[jobs.function[job]].tree, jobs.node[job], nodes, calls, jobs.closed, bodies.values)
        }
        claimed.push(SemaStackBodiesPart{part: part, bodies: bodies.move()})
    }
    claimed
}

// The nodes of `keys` that have a body, in order.
sema_effect_stack_call_targets: fn(keys: [String], node_by_key: SemaEffectNodeKeys) -> [Int] Never! {
    targets: loop key in keys -> {
        target: sema_effect_node_index(node_by_key, key) ?? next
        target
    }
    targets
}

// The nodes `node` calls, and the named functions it takes as values: code
// it hands one to, such as a Core loop built into its own body, may call it
// on top of its frame.
sema_effect_stack_node_targets: fn(node: SemaEffectNode) -> [Int] Never! {
    ^targets: [Int]{}
    loop target in node.call_targets {
        if target >= 0 -> targets.push(target)
    }
    if node.rare == .Val(rare) {
        loop target in rare.value_targets {
            if target >= 0 -> sema_effect_stack_add_edge(targets, target)
        }
    }
    targets
}

// A call through a function value in `node`, or a read of a function value
// there that code it hands the value to may call: the argument count and
// the span.
SemaStackDynamicCall: struct {
    node: Int,
    arity: Int,
    span: Span,
}

// A lambda written in `node`: its parameter count and the nodes it calls.
SemaStackLambda: struct {
    node: Int,
    arity: Int,
    edges: [Int],
}

sema_effect_stack_lambda: fn(node_index: Int, value: BodyLambda, node_by_key: SemaEffectNodeKeys) -> SemaStackLambda Never! {
    SemaStackLambda{node: node_index, arity: value.param_types.len(), edges: sema_effect_stack_call_targets(value.effects.call_edges, node_by_key)}
}

// The calls through function values in `tree`, the body of `node_index`,
// the reads of function-typed locals and fields, and, in an executable
// build, the function values it makes. A lambda written in the same body
// is a known body (sema_effect_local_lambda_call), not a dynamic call.
sema_effect_stack_dynamic: fn(tree: BodyTree, node_index: Int, nodes: [SemaEffectNode], facts: SemaEffectCallIndex, closed: Bool, values: ^SemaStackValues) Never! {
    // A row's index is not its node id: ids run from the checker's own
    // (TEXPR_FIRST_LOCAL_ID and below), so each row names its node.
    loop node in tree.nodes {
        id: node.id
        if node.kind == .IndirectCall(callee, _, args, _) {
            if !sema_effect_written_lambda(tree, callee) {
                values.calls.push(SemaStackDynamicCall{node: node_index, arity: args.len(), span: node.span})
            }
        } else if node.kind == .Lambda(value) {
            if closed {
                values.lambdas.push(sema_effect_stack_lambda(node_index, value, facts.node_by_key))
            }
        } else if node.kind == .FnValue(kind) {
            if closed -> sema_effect_stack_fn_value(kind, node_index, nodes, facts, values)
        } else if node.kind == .ConstRef(symbol) {
            if closed && type_kind(facts.interner, body_type_id(tree, id)) == TypeKind.Fn {
                key: symbol_key(facts.symbols, tree.symbols, symbol)
                if sema_effect_node_index(facts.node_by_key, key) == None {
                    values.bodiless.push(SemaStackTaken{node: node_index, target: -1, name: "`{symbol_key_leaf(key)}`"})
                }
            }
        } else if node.kind == .MethodCall(receiver, method, _, _) {
            if method.trait_owner != None && type_kind(facts.interner, body_type_id(tree, receiver)) == TypeKind.TraitObject {
                if closed {
                    values.dispatches.push(SemaStackDispatch{node: node_index, targets: sema_effect_stack_impls(method, facts)})
                } else {
                    values.calls.push(SemaStackDynamicCall{node: node_index, arity: -1, span: node.span})
                }
            }
        } else if sema_effect_stack_value_read(node.kind) {
            if body_type(facts.interner, tree, id) == .Fn(params, _, _, _, _, _) {
                if !sema_effect_written_lambda(tree, id) {
                    values.calls.push(SemaStackDynamicCall{node: node_index, arity: params.len(), span: node.span})
                }
            }
        }
    }
}

// The implementations the program holds of `method`, called through a trait
// value (sema_effect_record_value_reads).
sema_effect_stack_impls: fn(method: TMethodRef, facts: SemaEffectCallIndex) -> [Int] Never! {
    ^targets: [Int]{}
    trait_owner: method.trait_owner ?? return targets
    trait_key: sema_effect_run_key(facts.symbols, trait_owner) ?? return targets
    method_row: sema_effect_method_row(facts.impls, trait_key, method.name)
    if method_row < 0 -> return targets
    loop owner in facts.impls.implementers[facts.impls.method_traits[method_row]] {
        impl_key: sema_effect_trait_impl_of(facts.impls, method_row, owner) ?? next
        target: sema_effect_node_index(facts.node_by_key, impl_key) ?? next
        targets.push(target)
    }
    targets
}

// A function value `kind` made in `node_index`: the lambda it wraps is one
// the program writes, a policy wrapper is a function it takes as a value,
// and a named function with no checked body leaves the seal incomplete.
// The other kinds wrap a value made elsewhere in the tree.
sema_effect_stack_fn_value: fn(kind: BodyFnValueKind, node_index: Int, nodes: [SemaEffectNode], facts: SemaEffectCallIndex, values: ^SemaStackValues) Never! {
    if kind == {
        .NamedFn(function, lambda) -> {
            if lambda == .Val(value) {
                values.lambdas.push(sema_effect_stack_lambda(node_index, value, facts.node_by_key))
                return
            }
            decl: function ?? {
                values.bodiless.push(SemaStackTaken{node: node_index, target: -1, name: "a function named in {nodes[node_index].display_key}"})
                return
            }
            if sema_effect_decl_node(facts, decl) < 0 {
                values.bodiless.push(SemaStackTaken{node: node_index, target: -1, name: "a function named in {nodes[node_index].display_key}"})
            }
        }
        .Policy(_, _, _, wrapper, _, _) -> {
            decl: wrapper ?? return
            target: sema_effect_decl_node(facts, decl)
            if target < 0 {
                values.bodiless.push(SemaStackTaken{node: node_index, target: -1, name: "a policy wrapper in {nodes[node_index].display_key}"})
                return
            }
            values.wrappers.push(SemaStackTaken{node: node_index, target: target, name: ""})
        }
        .Call(_, _) | .Send(_) -> return
    }
}

// A read of a local or a field.
sema_effect_stack_value_read: fn(kind: NodeKind) -> Bool Never! {
    if kind == .Local(_) -> return true
    if kind == .Field(_, _) -> return true
    false
}

// Sealed target sets: an executable build makes every function value it
// calls, so a call through one runs a function the program takes as a
// value, or a lambda it writes, that takes the call's arguments. A named
// function counts its receiver, if any, as one, so either count matches.
// Only code the program may run makes values: every node outside Core, and
// every node those reach by calls, by functions taken as values and by the
// sealed calls, found as the sets grow. Each sealed call's node gets the
// named functions as call edges and, for the lambdas, their calls as edges
// and the largest lambda frame on its own. A lambda's frame is at most its
// writer's, whose checked values include the lambda's. A trait-value call
// already has every implementation as an edge (sema_effect_record_dispatch);
// its set is only named here. A function value with no checked body that
// reached code makes leaves every reached call through a function value open.
sema_effect_stack_seal: fn(frames: ^SemaStackFrames, nodes: [SemaEffectNode], arity: [Int], values: SemaStackValues) Never! {
    ^calls_at: (loop _ in nodes -> [Int]{})
    loop (row, call) in values.calls -> calls_at[call.node].push(row)
    ^lambdas_at: (loop _ in nodes -> [Int]{})
    loop (row, lambda) in values.lambdas -> lambdas_at[lambda.node].push(row)
    ^wrappers_at: (loop _ in nodes -> [Int]{})
    loop wrapper in values.wrappers -> wrappers_at[wrapper.node].push(wrapper.target)
    ^seal: SemaStackSeal{reached: (loop _ in nodes -> false), pending: [Int]{}, taken: (loop _ in nodes -> false), takens: [Int]{}, lambdas: [Int]{}, calls: [Int]{}, names: (loop _ in nodes -> [Int]{})}
    loop (index, node) in nodes {
        if !module_is_core(node.module_identity) -> sema_effect_stack_reach(seal, index)
    }
    loop {
        ^index: seal.pending.pop() ?? {
            break
        }
        loop target in frames.edges[index] -> sema_effect_stack_reach(seal, target)
        loop at in 0..<sema_effect_node_value_count(nodes[index]) {
            target: sema_effect_node_value_target(nodes[index], at)
            if target < 0 -> next
            sema_effect_stack_take(seal, frames, arity, values, target)
        }
        loop target in wrappers_at[index] {
            sema_effect_stack_take(seal, frames, arity, values, target)
        }
        loop row in lambdas_at[index] {
            seal.lambdas.push(row)
            loop call_row in seal.calls {
                sema_effect_stack_run_lambda(seal, frames, values.calls[call_row], values.lambdas[row])
            }
        }
        loop row in calls_at[index] {
            seal.calls.push(row)
            loop target in seal.takens {
                sema_effect_stack_run_taken(seal, frames, arity, values.calls[row], target)
            }
            loop lambda_row in seal.lambdas {
                sema_effect_stack_run_lambda(seal, frames, values.calls[row], values.lambdas[lambda_row])
            }
        }
    }
    loop dispatch in values.dispatches {
        loop target in dispatch.targets {
            sema_effect_stack_name_add(seal.names[dispatch.node], sema_effect_stack_named(target))
        }
    }
    loop index in 0..<nodes.len() {
        if !seal.reached[index] -> next
        if seal.names[index].len() == 0 && frames.dynamic_calls[index].len() == 0 -> next
        frames.sealed[index] = if seal.names[index].len() == 0 -> "nothing" else -> sema_effect_stack_names_text(nodes, seal.names[index])
    }
    loop call in values.calls {
        if !seal.reached[call.node] {
            frames.open[call.node] = "a call through a function value in {nodes[call.node].display_key}, which no code outside Core reaches, so its targets are not sealed"
        }
    }
    loop entry in values.bodiless {
        if !seal.reached[entry.node] -> next
        loop row in seal.calls {
            call: values.calls[row]
            frames.open[call.node] = "a call through a function value in {nodes[call.node].display_key} may run {entry.name}, a function value with no checked body"
        }
        break
    }
}

// The walk that seals calls through values: the nodes reached so far and
// those still to read, the functions taken as values, the rows of the
// lambdas and calls through values in reached code, and each node's sealed
// targets as distinct name ids in order (sema_effect_stack_name_add).
SemaStackSeal: struct {
    reached: [Bool],
    pending: [Int],
    taken: [Bool],
    takens: [Int],
    lambdas: [Int],
    calls: [Int],
    names: [[Int]],
}

sema_effect_stack_reach: fn(seal: ^SemaStackSeal, index: Int) Never! {
    if seal.reached[index] {
        return
    }
    seal.reached[index] = true
    seal.pending.push(index)
}

// `target` is taken as a value by reached code: every reached call through
// a function value may run it.
sema_effect_stack_take: fn(seal: ^SemaStackSeal, frames: ^SemaStackFrames, arity: [Int], values: SemaStackValues, target: Int) Never! {
    sema_effect_stack_reach(seal, target)
    if seal.taken[target] {
        return
    }
    seal.taken[target] = true
    seal.takens.push(target)
    loop row in seal.calls {
        sema_effect_stack_run_taken(seal, frames, arity, values.calls[row], target)
    }
}

sema_effect_stack_run_taken: fn(seal: ^SemaStackSeal, frames: ^SemaStackFrames, arity: [Int], call: SemaStackDynamicCall, target: Int) Never! {
    if call.arity < 0 {
        return
    }
    if arity[target] != call.arity && arity[target] + 1 != call.arity {
        return
    }
    sema_effect_stack_add_edge(frames.edges[call.node], target)
    sema_effect_stack_name_add(seal.names[call.node], sema_effect_stack_named(target))
    sema_effect_stack_reach(seal, target)
}

sema_effect_stack_run_lambda: fn(seal: ^SemaStackSeal, frames: ^SemaStackFrames, call: SemaStackDynamicCall, lambda: SemaStackLambda) Never! {
    if lambda.arity != call.arity {
        return
    }
    loop target in lambda.edges {
        sema_effect_stack_add_edge(frames.edges[call.node], target)
        sema_effect_stack_reach(seal, target)
    }
    sema_effect_stack_name_add(seal.names[call.node], sema_effect_stack_named_lambda(lambda.node))
    writer: frames.own[lambda.node]
    if frames.carrier[call.node] >= 0 && frames.carried[call.node] < 0 {
        return
    }
    if writer < 0 || writer > frames.carried[call.node] {
        frames.carried[call.node] = writer
        frames.carrier[call.node] = lambda.node
    }
}

// The name id of the function `node` taken as a value, named "`key`".
sema_effect_stack_named: fn(node: Int) -> Int Never! { 2 * node }

// The name id of a lambda written in `node`, named "a lambda in key".
sema_effect_stack_named_lambda: fn(node: Int) -> Int Never! { 2 * node + 1 }

// Adds the name id `id` once to a node's sealed target ids, kept in order:
// a binary search finds the slot. An id is an integer, so a pair of a call
// and a value spells no name and compares no text; only the distinct ids
// are spelled, once (sema_effect_stack_names_text).
sema_effect_stack_name_add: fn(ids: ^[Int], id: Int) Never! {
    ^low: 0
    ^high: ids.len()
    loop low < high {
        middle: (low + high) /% 2
        if ids[middle] == id {
            return
        }
        if {
            ids[middle] < id -> low = middle + 1
            else -> high = middle
        }
    }
    ids.insert(low, id)
}

// A node's sealed target names, each once in text order, from its distinct
// name ids (two nodes may share a display key). A name is quoted or `a
// lambda in …`, so no name's root is an effect root and the effect-row
// order (sema_effect_set_add) of the names is their text order.
sema_effect_stack_names_text: fn(nodes: [SemaEffectNode], ids: [Int]) -> String Never! {
    ^names: [String]{}
    loop id in ids {
        node: id /% 2
        names.push(if id % 2 == 0 -> "`{nodes[node].display_key}`" else -> "a lambda in {nodes[node].display_key}")
    }
    names.sort()
    ^distinct: [String]{}
    loop name in names {
        if distinct.len() > 0 && distinct[distinct.len() - 1] == name -> next
        distinct.push(name)
    }
    distinct.join(", ")
}

sema_effect_stack_add_edge: fn(edges: ^[Int], target: Int) Never! {
    loop edge in edges {
        if edge == target {
            return
        }
    }
    edges.push(target)
}

// One function's frame bytes, or why one of its values has no known size,
// as the next row of `bodies`.
sema_effect_stack_own: fn(interner: Interner, types: JetFrameTypes, function: FnBody, bodies: ^SemaStackBodies) {
    ^total: JET_FRAME_ALLOWANCE
    loop parameter in function.params {
        bytes: jet_frame_value_bytes(types, parameter.ty) ?? {
            bodies.own.push(-1)
            bodies.why.push("`{type_name(parameter.ty)}` has no known size")
            return
        }
        total += bytes
    }
    // Each checked TypeID is sized once: -1 no known size.
    ^sized: [U32:Int]{}
    loop row in function.tree.expr_types {
        tid: row.ty
        ^bytes: -2
        if sized.get(tid.id) == .Val(cached) -> bytes = cached else {
            bytes = jet_frame_value_bytes(types, type_syntax(interner, tid)) ?? -1
            sized[tid.id] = bytes
        }
        if bytes < 0 {
            bodies.own.push(-1)
            bodies.why.push("`{type_id_name(interner, tid)}` has no known size")
            return
        }
        total += bytes
    }
    bodies.own.push(total)
    bodies.why.push("")
}

// The worst-case stack of every call path from each node: its own frame
// bound plus its deepest callee's path. A node is unbounded when one of its
// values has no known size or it calls through an open dispatch, a trait
// value or a function value. The walk settles each strongly connected part
// of the call graph once, callees first (Tarjan). A part with a cycle is
// bounded only when every cycle in it passes through a function marked
// `#MaxDepth(n)`. Its stack is then a run of segments, each a call path
// inside the part that calls no marked function: one per waiting marked
// call, at most the sum of the depths, plus the entry's own when it is not
// marked; under the last, the deepest callee outside the part.
SemaStackWalk: struct {
    // 0 not seen, 1 visited with its part not settled, 2 settled.
    state: [Int],
    // The node's path bytes; -1 unbounded.
    bytes: [Int],
    // Why the node is unbounded when it is itself the reason; "" when the
    // reason is in `next`.
    why: [String],
    // The callee the node's deepest or unbounded path goes through; -1 none.
    next: [Int],
    // Each node's visit order and the lowest order it reaches back to, and
    // the visited nodes whose part is not settled yet.
    order: [Int],
    low: [Int],
    pending: [Int],
    visited: Int,
    // The settled part each node is in, named by its first visited node;
    // -1 before.
    part: [Int],
    // The deepest segment from each node of a part with a cycle: -2 not
    // measured, -3 being measured.
    segment: [Int],
    // Whether a `!Mem.Stack(above: N)` denial reaches the node: only these
    // nodes' frames are stamped with their bound (FnBody.frame_bound), which
    // the backend then holds each laid-out frame to.
    guarded: [Bool],
}

sema_effect_stack_walk: fn(nodes: [SemaEffectNode]) -> SemaStackWalk Never! {
    SemaStackWalk{
        state: (loop _ in nodes -> 0),
        bytes: (loop _ in nodes -> 0),
        why: (loop _ in nodes -> ""),
        next: (loop _ in nodes -> -1),
        order: (loop _ in nodes -> -1),
        low: (loop _ in nodes -> -1),
        pending: [Int]{},
        visited: 0,
        part: (loop _ in nodes -> -1),
        segment: (loop _ in nodes -> -2),
        guarded: (loop _ in nodes -> false),
    }
}

// Mark every node `root` reaches, itself included, as guarded.
sema_effect_stack_guard: fn(walk: ^SemaStackWalk, frames: SemaStackFrames, root: Int) Never! {
    if walk.guarded[root] {
        return
    }
    walk.guarded[root] = true
    ^pending: [Int]{root}
    loop {
        ^index: pending.pop() ?? {
            break
        }
        loop target in frames.edges[index] {
            if walk.guarded[target] -> next
            walk.guarded[target] = true
            pending.push(target)
        }
    }
}

// Why the node's own body has no stack bound; "" when it has one.
sema_effect_stack_own_why: fn(frames: SemaStackFrames, nodes: [SemaEffectNode], index: Int) -> String Never! {
    node: nodes[index]
    if frames.own[index] < 0 -> return sema_effect_stack_body_why(frames, node, index)
    rare: node.rare ?? SEMA_EFFECT_NODE_NO_RARE
    loop open in rare.memory_opens {
        if sema_effect_stack_dynamic_call(frames.dynamic_calls[index], open.span) -> next
        return "{open.reason} at {open.source}"
    }
    if node.dispatches.len() > 0 -> return "a call through a trait value in {node.display_key}"
    if frames.open[index] != "" -> return frames.open[index].copy()
    if frames.carried[index] < 0 {
        carrier: frames.carrier[index]
        return "a call through a function value in {node.display_key} may run a lambda in {nodes[carrier].display_key}, and {sema_effect_stack_body_why(frames, nodes[carrier], carrier)}"
    }
    ""
}

// Why a node with no own frame bound has none.
sema_effect_stack_body_why: fn(frames: SemaStackFrames, node: SemaEffectNode, index: Int) -> String Never! {
    if frames.why[index] == "" -> return "{node.display_key} has no checked body"
    "{frames.why[index]} in {node.display_key}"
}

// Whether `span` is one of `calls`, a node's calls through function values,
// which `sealed` and `open` answer for.
sema_effect_stack_dynamic_call: fn(calls: [Span], span: Span) -> Bool Never! {
    loop call in calls {
        if call.start == span.start && call.end == span.end -> return true
    }
    false
}

// A node's frame on the stack: its own and the largest lambda frame its
// calls through function values may run on top of it.
sema_effect_stack_frame: fn(frames: SemaStackFrames, index: Int) -> Int Never! {
    sema_effect_stack_saturate(frames.own[index] + frames.carried[index])
}

sema_effect_stack_visit: fn(walk: ^SemaStackWalk, frames: SemaStackFrames, nodes: [SemaEffectNode], index: Int) Never! {
    walk.order[index] = walk.visited
    walk.low[index] = walk.visited
    walk.visited += 1
    walk.state[index] = 1
    walk.pending.push(index)
    walk.why[index] = sema_effect_stack_own_why(frames, nodes, index)
    if walk.why[index] == "" {
        loop target in frames.edges[index] {
            if walk.state[target] == 0 {
                sema_effect_stack_visit(walk, frames, nodes, target)
                if walk.low[target] < walk.low[index] -> walk.low[index] = walk.low[target]
            } else if walk.state[target] == 1 && walk.order[target] < walk.low[index] {
                walk.low[index] = walk.order[target]
            }
        }
    }
    if walk.low[index] == walk.order[index] -> sema_effect_stack_settle(walk, frames, nodes, index)
}

// Settle the part `root` was visited first in: every node visited after it
// that is still pending.
sema_effect_stack_settle: fn(walk: ^SemaStackWalk, frames: SemaStackFrames, nodes: [SemaEffectNode], root: Int) Never! {
    ^members: [Int]{}
    loop {
        ^member: walk.pending.pop() ?? {
            break
        }
        walk.part[member] = root
        walk.state[member] = 2
        members.push(member)
        if member == root -> break
    }
    // A member unbounded by its own body or by a callee outside the part
    // leaves the whole part unbounded: each member reaches it.
    ^open: -1
    loop member in members {
        if walk.why[member] != "" {
            open = member
            break
        }
        loop target in frames.edges[member] {
            if walk.part[target] != root && walk.bytes[target] < 0 {
                open = member
                walk.next[member] = target
                break
            }
        }
        if open >= 0 -> break
    }
    if open >= 0 {
        loop member in members {
            walk.bytes[member] = -1
            if member != open -> walk.next[member] = open
        }
        return
    }
    ^outside: 0
    ^cyclic: false
    loop member in members {
        loop target in frames.edges[member] {
            if walk.part[target] == root {
                cyclic = true
                next
            }
            if walk.next[member] < 0 || walk.bytes[target] > walk.bytes[walk.next[member]] {
                walk.next[member] = target
            }
            if walk.bytes[target] > outside -> outside = walk.bytes[target]
        }
    }
    if !cyclic {
        walk.bytes[root] = sema_effect_stack_saturate(sema_effect_stack_frame(frames, root) + outside)
        return
    }
    ^depths: 0
    ^widest: 0
    loop member in members {
        depths = sema_effect_stack_saturate(depths + frames.depth[member])
        if walk.segment[member] == -2 {
            closed: sema_effect_stack_segment(walk, frames, root, member)
            if closed >= 0 {
                walk.why[closed] = "recursion through {nodes[closed].display_key} with no `#MaxDepth(n)` on its cycle"
                loop other in members {
                    walk.bytes[other] = -1
                    if other != closed -> walk.next[other] = closed
                }
                return
            }
        }
        if walk.segment[member] > widest -> widest = walk.segment[member]
    }
    loop member in members {
        runs: if frames.depth[member] > 0 -> depths else -> depths + 1
        walk.bytes[member] = sema_effect_stack_saturate(sema_effect_stack_times(runs, widest) + outside)
        // The cycle's repeated calls, not the callee after them, make the
        // bound: a member that calls a `#MaxDepth` function of the cycle
        // shows that call as its next step, so the path names the depth.
        loop target in frames.edges[member] {
            if walk.part[target] == root && frames.depth[target] > 0 {
                walk.next[member] = target
                break
            }
        }
    }
}

// The deepest call path from `index` inside the part of `root` that calls
// no `#MaxDepth` function, in walk.segment; returns the node where a cycle
// of unmarked functions closes, or -1. The path's next step replaces the
// node's deepest outside callee in walk.next, and a call into a marked
// function of the part stands in when the node has neither.
sema_effect_stack_segment: fn(walk: ^SemaStackWalk, frames: SemaStackFrames, root: Int, index: Int) -> Int Never! {
    walk.segment[index] = -3
    ^deepest: 0
    ^marked: -1
    loop target in frames.edges[index] {
        if walk.part[target] != root -> next
        if frames.depth[target] > 0 {
            if marked < 0 -> marked = target
            next
        }
        if walk.segment[target] == -3 -> return target
        if walk.segment[target] == -2 {
            closed: sema_effect_stack_segment(walk, frames, root, target)
            if closed >= 0 -> return closed
        }
        if walk.segment[target] > deepest {
            deepest = walk.segment[target]
            walk.next[index] = target
        }
    }
    if walk.next[index] < 0 -> walk.next[index] = marked
    walk.segment[index] = sema_effect_stack_saturate(sema_effect_stack_frame(frames, index) + deepest)
    return -1
}

// Stack byte counts stop at 2^56, far above any bound a target can grant,
// so a large `#MaxDepth(n)` cannot overflow the sum.
SEMA_STACK_BYTES_CEILING: 72057594037927936

sema_effect_stack_saturate: fn(bytes: Int) -> Int Never! {
    if bytes > SEMA_STACK_BYTES_CEILING -> return SEMA_STACK_BYTES_CEILING
    bytes
}

sema_effect_stack_times: fn(count: Int, bytes: Int) -> Int Never! {
    if bytes > 0 && count > SEMA_STACK_BYTES_CEILING /% bytes -> return SEMA_STACK_BYTES_CEILING
    count * bytes
}

// The path a stack walk settled a node by, each step with its own frame
// bound, and why the path is unbounded ("" when it is bounded).
SemaStackTrail: struct {
    path: String,
    why: String,
}

sema_effect_stack_trail: fn(walk: SemaStackWalk, frames: SemaStackFrames, nodes: [SemaEffectNode], index: Int) -> SemaStackTrail Never! {
    ^steps: [String]{}
    ^seen: [Int:Bool]{}
    ^why: ""
    ^row: index
    loop row >= 0 && seen.get(row) == None {
        seen[row] = true
        depth: if frames.depth[row] > 0 -> ", up to {frames.depth[row]} deep" else -> ""
        lambda: if frames.carried[row] > 0 -> " + {frames.carried[row]} B lambda" else -> ""
        sealed: if frames.sealed[row] != "" -> ", calls through values sealed to {frames.sealed[row]}" else -> ""
        step: if frames.own[row] < 0 -> nodes[row].display_key.copy() else -> "{nodes[row].display_key} ({frames.own[row]} B{lambda}{depth}{sealed})"
        steps.push(step)
        if walk.bytes[row] < 0 && walk.why[row] != "" {
            why = walk.why[row].copy()
            break
        }
        row = walk.next[row]
    }
    SemaStackTrail{path: steps.join(" -> "), why: why}
}

// The stack text of every node nothing calls (FnBody.stack), by node; ""
// for the others.
sema_effect_stack_bounds: fn(walk: ^SemaStackWalk, frames: SemaStackFrames, nodes: [SemaEffectNode], called: [Bool]) -> [String] Never! {
    ^texts: [String]{}
    loop index in 0..<nodes.len() {
        if called[index] {
            texts.push("")
            next
        }
        if walk.state[index] == 0 -> sema_effect_stack_visit(walk, frames, nodes, index)
        trail: sema_effect_stack_trail(walk, frames, nodes, index)
        text: if walk.bytes[index] < 0 -> "unbounded, {trail.why} via {trail.path}" else -> "{walk.bytes[index]} B via {trail.path}"
        texts.push(text)
    }
    texts
}

// `!Mem.Stack(above: N)` on `root` (E0921): every call path from it takes at
// most N bytes of stack by the frame model, so none may be unbounded.
sema_effect_check_stack: fn(walk: ^SemaStackWalk, frames: SemaStackFrames, nodes: [SemaEffectNode], root: Int, denial: EffectRowEntry, provenance: String, diagnostics: ^[Diagnostic]) {
    limit: sema_effect_stack_bound(denial.name) ?? return
    sema_effect_stack_guard(walk, frames, root)
    if walk.state[root] == 0 -> sema_effect_stack_visit(walk, frames, nodes, root)
    if walk.bytes[root] >= 0 && walk.bytes[root] <= limit {
        return
    }
    fact: "!{denial.name}"
    display: nodes[root].display_key
    span: if denial.span.start == denial.span.end -> nodes[root].name_span else -> denial.span
    trail: sema_effect_stack_trail(walk, frames, nodes, root)
    if walk.bytes[root] < 0 {
        diagnostics.push(sema_error("E0921", span, "`{fact}` cannot be proved for {display}: {trail.why}", "no bound holds for the call path {trail.path}; a stack bound needs every value's size, every call's target, and a `#MaxDepth(n)` function on every call cycle; declaration provenance: {provenance}", "give every value a known size, every call a direct or sealed target (an executable build seals calls through function values) and every call cycle a `#MaxDepth(n)` function, or move the call outside this denial"))
        return
    }
    diagnostics.push(sema_error("E0921", span, "{display} may take {walk.bytes[root]} bytes of stack, above the effective `{fact}` declared at {nodes[root].source_display}", "the deepest call path is {trail.path}; each frame counts {JET_FRAME_ALLOWANCE} bytes of call linkage and saved registers plus two slots for every parameter and checked value; declaration provenance: {provenance}", "raise the bound, shorten the call path, or keep large values in a heap list"))
}

sema_effect_memory_violation: fn(nodes: [SemaEffectNode], root: Int, denial: EffectRowEntry, fact: String, bounded: Bool, finding: SemaMemoryFinding) -> Diagnostic {
    declared_at: nodes[root].source_display
    provenance: "signature denial `-[!{denial.name}]>` in {declared_at}"
    path_text: finding.path.join(" -> ")
    if finding.event == .Val(event) {
        owner: nodes[finding.owner]
        ^arena: ""
        if bounded {
            arena = if event.kind == "alloc" -> "; sema proves no byte size for this heap allocation, so it cannot be counted against the bound" else -> "; the proven path total is {finding.used} bytes"
        }
        return sema_error("E0921", sema_effect_memory_site(nodes, root, denial, finding, event.span), "{event.operation} at {owner.source_display} violates the effective `{fact}` declared at {declared_at}", "{owner.source_display} is reachable through {path_text} from code governed by `{fact}`{arena}; declaration provenance: {provenance}; operation provenance: {owner.name} in {owner.source_display}", "remove or replace the incompatible operation, seal the target set, or move the call outside this denial")
    }
    open: finding.open ?? SemaMemoryOpen{span: denial.span, source: declared_at, reason: "memory proof is incomplete"}
    sema_error("E0921", sema_effect_memory_site(nodes, root, denial, finding, open.span), "`{fact}` cannot be proved through the open dispatch at {open.source}", "{open.reason} is reachable through {path_text}; a strict transitive fact cannot assume an unknown future target is compatible; declaration provenance: {provenance}", "seal the target set, consume a verified signed dependency summary that proves the denial, or move the dispatch outside it")
}

// Where a finding reports, given its own `site`: the diagnostic reads its
// span in the root's file. A site of a function of the root's module is its
// own (an empty one is the denial); a site in another module, a Core body's
// included, would name an unrelated line of that file, so the report is at
// the root's call that leads toward it (the first of `finding.steps`), or at
// the denial when no counted call does.
sema_effect_memory_site: fn(nodes: [SemaEffectNode], root: Int, denial: EffectRowEntry, finding: SemaMemoryFinding, site: Span) -> Span Never! {
    if nodes[finding.owner].module_index == nodes[root].module_index {
        return if site.start == site.end -> denial.span else -> site
    }
    if finding.steps.len() > 1 {
        loop call in nodes[root].memory_calls {
            if call.target == finding.steps[1] -> return call.span
        }
    }
    denial.span
}

// 2: a `-[!Mem.Alloc]>`, `-[!Mem.Rc]>` or `-[!Mem.Alloc(above: N)]>` denial
// holds for every function the root can reach (E0921). `fact` is the
// denial's memory fact (sema_effect_memory_fact), which each caller reads
// to pick the denials this projects.
sema_effect_memory_project: fn(nodes: [SemaEffectNode], root: Int, denial: EffectRowEntry, fact: String, diagnostics: ^[Diagnostic]) -> SemaMemoryProjection {
    limit: sema_effect_memory_bound(denial.name)
    if limit == .Val(bytes_limit) {
        ^visiting: (loop _ in nodes -> false)
        ^steps: [Int]{root}
        proof: sema_effect_arena_bound(nodes, root, visiting, steps)
        if proof.failure == .Val(failure) {
            diagnostics.push(sema_effect_memory_violation(nodes, root, denial, fact, true, failure))
            return sema_effect_memory_projection(failure)
        }
        if proof.bytes <= bytes_limit -> return SemaMemoryProjection.Proven
        finding: proof.witness ?? sema_effect_memory_open_finding(nodes, Span{start: 0, end: 0}, nodes[root].display_key, "the verified upper bound is {proof.bytes} bytes, above the declared {bytes_limit} bytes", root, [Int]{root}, 0)
        ^finding_total: finding
        finding_total.used = proof.bytes
        diagnostics.push(sema_effect_memory_violation(nodes, root, denial, fact, true, finding_total))
        return sema_effect_memory_projection(finding_total)
    }
    kind: if denial.name == "Mem.Rc" -> "rc" else -> "alloc"
    finding: sema_effect_memory_search(nodes, root, kind) ?? return SemaMemoryProjection.Proven
    diagnostics.push(sema_effect_memory_violation(nodes, root, denial, fact, false, finding))
    sema_effect_memory_projection(finding)
}

// `stack` and `frames` prove each `!Mem.Stack(above: N)`
// (sema_effect_check_stack).
sema_effect_check_memory_denials: fn(nodes: [SemaEffectNode], root: Int, stack: ^SemaStackWalk, frames: SemaStackFrames, diagnostics: ^[Diagnostic], facts: ^SemaMemoryProjectionFacts) {
    rare: nodes[root].rare ?? return
    loop denial in rare.memory_denials {
        if sema_effect_stack_bound(denial.name) != None {
            sema_effect_check_stack(stack, frames, nodes, root, denial, "signature denial `-[!{denial.name}]>` in {nodes[root].source_display}", diagnostics)
            next
        }
        fact: sema_effect_memory_fact(denial.name) ?? next
        projection: sema_effect_memory_project(nodes, root, denial, fact, diagnostics)
        sema_effect_memory_publish(nodes, root, denial, projection, facts)
    }
}

// A pure body's reached effects go to `pure_reached`; E3401 is reported once
// the solved rows are stamped, so it can name the call that reaches them.
sema_effect_check_node: fn(node: SemaEffectNode, solved: [String], secret_reached: Bool, dispatch: ^^Diagnostic?, panic_steps: [String], unsafe_reach: SemaEffectUnsafeReach?, notes: [SemaEffectInstanceNote], pure_reached: ^[String], diagnostics: ^[Diagnostic]) -> Bool {
    ^valid: true
    library_named: if node.rare == .Val(rare) -> rare.library_rows.len() > 0 else -> false
    // E0938: a `#Memo` function that is not declared pure is judged by its
    // solved row; panic and memory are deny-only, as for an explicit empty
    // bound.
    if !node.is_pure && node.memo_span == .Val(memo_span) {
        ^impure: sema_effect_uncovered(solved, [String]{})
        if impure.len() > 0 {
            impure.sort()
            shown: impure.join(", ")
            subject: sema_effect_memo_subject(node.name)
            diagnostics.push(sema_error("E0938", memo_span, "`#Memo` requires a pure function", "memoization reuses a completed result, but {subject} uses `{shown}`", "remove the `{shown}` operations from {subject}, or drop `#Memo`"))
            valid = false
        }
    }
    if node.kernel == .Val(pending) && !sema_kernel_check_effects(pending, node.direct, node.call_edges, node.maximal, diagnostics) {
        valid = false
    }
    secret_granted: loop bound in node.declared {
        if sema_effect_root(bound) == "Secret" {
            break true
        }
    } ?? false
    if secret_reached && !secret_granted {
        diagnostics.push(sema_effect_secret_diagnostic(node))
        valid = false
    }
    if {
        dispatch == .Val(_) -> {
            // The open dispatch makes the row maximal; a written ceiling
            // reports the missing trait bound once instead of the generic
            // ceiling diagnostics, and a bare purity marker reports nothing.
            if !node.has_declared_row -> return valid
            diagnostics.push(dispatch ?? return false)
            return false
        }
        node.is_pure -> {
            reached: sema_effect_without_deny_only(solved)
            // A non-deterministic Core call in this body already reported
            // E3403 for its `Time`/`Rand` row; any other effect still reports.
            over: loop name in reached -> {
                root: sema_effect_root(name)
                if node.nondeterministic_call && (root == "Time" || root == "Rand") -> next
                name
            }
            if node.nondeterministic_call -> valid = false
            if over.len() > 0 {
                loop name in over -> pure_reached.push(name)
                valid = false
            }
        }
        node.has_declared_row && (node.declared.len() > 0 || library_named) -> {
            over: sema_effect_uncovered(solved, node.declared)
            if over.len() > 0 {
                reported: if library_named -> sema_library_effect_reach_diagnostic(node, over) else -> sema_effect_bound_diagnostic(node, over)
                diagnostics.push(sema_effect_with_instance_notes(reported, notes, over))
                valid = false
            }
        }
    }
    prohibited: sema_effect_covered(solved, node.prohibited)
    if prohibited.len() > 0 {
        diagnostics.push(sema_effect_with_instance_notes(sema_effect_prohibited_diagnostic(node, prohibited, panic_steps, unsafe_reach), notes, prohibited))
        valid = false
    }
    if node.is_replayable {
        ^forbidden: [String]{}
        loop effect_name in solved {
            root: sema_effect_root(effect_name)
            if root == "Time" || root == "Rand" || root == "Net" || root == "IO" {
                sema_effect_set_add(forbidden, effect_name)
            }
        }
        if forbidden.len() > 0 {
            diagnostics.push(sema_effect_replayable_diagnostic(node, forbidden))
            valid = false
        }
    }
    valid
}

// P7: memory rights are not an observable outcome of a call; every other
// root (including `Panic`) and an open-world row give the call a purpose.
sema_effect_row_has_no_outcome: fn(node: SemaEffectNode, solved: [String]) -> Bool Never! {
    if node.maximal -> return false
    loop effect_name in solved {
        if sema_effect_root(effect_name) != "Mem" && effect_name != "Unsafe" -> return false
    }
    true
}

// The callee as written stands in for the call text.
sema_effect_discarded_result_diagnostic: fn(node: SemaEffectNode, span: Span) -> Diagnostic {
    diagnostic: sema_lint("L0508", span, "the result of `{node.name}` is thrown away", "`{node.name}` is pure (it has no effects and changes nothing through `^`), so this line does nothing", "use the result, bind it with `result: {node.name}`, or write `.drop(\"reason\")` if dropping it is intended")
    diagnostic_with_source_derived_suggestion(diagnostic, Span{start: span.start, end: span.start}, "result: ")
}

// The part of `expression` inside `region` (a `#FX` block span).
sema_effect_walk_region_expr: fn(nodes: ^[SemaEffectNode], node_index: Int, tree: BodyTree, expression: Int, region: Span, facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller) {
    node: body_node(tree, expression)
    next: sema_effect_walk_region_enter(nodes, node_index, tree, expression, node, region, false, facts, module_facts, diagnostics, caller) ?? return
    sema_effect_walk_expr_children(next, nodes, facts, module_facts, diagnostics, caller, tree, node)
}

// sema_effect_walk_region_expr's own work on `node`: the walk its children
// continue with, the whole walk (Collect) once the region holds the node; None
// when they aren't walked.
sema_effect_walk_region_enter: fn(nodes: ^[SemaEffectNode], node_index: Int, tree: BodyTree, expression: Int, node: BodyNode, region: Span, skip_tx_hooks: Bool, facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller) -> SemaEffectWalk? {
    if sema_effect_span_contains(region, node.span) {
        if sema_effect_walk_expr_enter(nodes, node_index, tree, expression, node, facts, module_facts, diagnostics, caller) {
            return Val(if skip_tx_hooks -> SemaEffectWalk.TransactCollect{node_index: node_index} else -> SemaEffectWalk.Collect{node_index: node_index})
        }
        return None
    }
    if !sema_effect_span_contains(node.span, region) -> return None
    Val(SemaEffectWalk.Region{node_index: node_index, region: region, skip_tx_hooks: skip_tx_hooks})
}

// The node of the part of `function` inside `span`, a `#FX(…)` or `#Transact`
// block keyed `{function.key}#{label}@{start}`: its own sites, its call edges
// and its call sites, walked as its owner's were but from none of them. The
// node is appended to `nodes` for the walk (which writes only that node) and
// Walks a region's body into a temporary single-element node list.
sema_effect_region_walk: fn(nodes: [SemaEffectNode], owner: Int, function: FnBody, span: Span, label: String, facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], module_index: Int) -> SemaEffectNode {
    // copy: the region node starts from its owner's declared row and spans;
    // the owner node stays in the graph.
    ^region_node: nodes[owner].copy()
    region_node.key = "{function.key}#{label}@{span.start}"
    region_node.direct = [String]{}
    region_node.direct_spans = [TEffectSpan]{}
    region_node.call_edges = [String]{}
    region_node.call_targets = [Int]{}
    region_node.maximal = false
    region_node.maximal_span = None
    region_node.dispatches = [TEffectSpan]{}
    region_node.memory_events = [SemaMemoryEvent]{}
    region_node.memory_calls = [SemaMemoryCall]{}
    region_node.memory_call_rows = [Int:Bool]{}
    if region_node.rare.in_place() == .Val(rare) {
        rare.scoped_calls = [SemaEffectScopedCall]{}
        rare.bare_scope_callees = [String]{}
    }
    ^local_nodes: [SemaEffectNode]{region_node}
    ^ignored: [Diagnostic]{}
    caller: sema_effect_caller_slot(facts, module_index, function.key)
    skip_tx_hooks: label == "Transact"
    loop statement in function.body {
        sema_effect_walk_stmt_children(SemaEffectWalk.Region{node_index: 0, region: span, skip_tx_hooks: skip_tx_hooks}, local_nodes, facts, module_facts, ignored, caller, function.tree, function.tree.stmts[statement])
    }
    ^walked: local_nodes.pop() ?? panic("the region node left the local list")
    sema_effect_node_settle_edges(walked)
    walked
}

// The effects a `#FX(…)` region reaches: its own sites, everything its callees
// reach, and every effect when it makes an unknown call. A call to a Core scope
// publisher inside the region reaches it as the scoped effect its constant
// argument names, as a function's own calls do (sema_effect_solve_scoped), so
// `files.read("data/{name}")` needs `FS.Read("data/")`.
sema_effect_region_inferred: fn(nodes: [SemaEffectNode], solved: [[String]], owner: Int, function: FnBody, region: SemaEffectFxRegion, facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], module_index: Int) -> [String] {
    ^walked: sema_effect_region_walk(nodes, owner, function, region.span, "FX", facts, module_facts, module_index)
    ^inferred: walked.direct.move()
    walked_rare: walked.rare ?? SEMA_EFFECT_NODE_NO_RARE
    if walked.maximal -> sema_effect_set_union(inferred, authority_grantable_roots())
    loop edge in walked.call_edges {
        if edge == "__jet_panic__" {
            sema_effect_set_add(inferred, "Panic")
            next
        }
        target: sema_effect_node_index(facts.node_by_key, edge) ?? next
        loop name in solved[target] {
            sema_effect_region_add_scoped(inferred, walked_rare.scoped_calls, walked_rare.bare_scope_callees, edge, name)
        }
    }
    inferred
}

// The calls of a `#Transact` block at `span` whose callee declares no effect
// row: the transaction wall had no row for them while the body was checked
// (sema_effect_check_transaction_wall), so each one whose solved row reaches
// an irreversible effect is E0746 at its call. A callee that declares a row
// met the wall at its call, and its body is held to that row. A lambda's body
// (a `tx.on_commit` hook) and a call through a function value are no call of
// the block.
sema_effect_check_transact_calls: fn(nodes: [SemaEffectNode], solved: [[String]], owner: Int, function: FnBody, span: Span, facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], module_index: Int, diagnostics: ^[Diagnostic]) {
    walked: sema_effect_region_walk(nodes, owner, function, span, "Transact", facts, module_facts, module_index)
    loop call in walked.memory_calls {
        target: sema_effect_node_index(facts.node_by_key, call.callee) ?? next
        if nodes[target].has_declared_row -> next
        // The first effect of the callee's row that can't be rolled back.
        loop effect_name in solved[target] {
            if !sema_effect_vocabulary_irreversible(effect_name) -> next
            diagnostics.push(sema_effect_transaction_wall_diagnostic(sema_effect_decl_label(call.callee), effect_name, call.span))
            break
        }
    }
}

// Whether `effect_name` can't be rolled back, by the `irreversible` fact
// Compiler/Prelude/Effects.jet gives it (EFFECT_VOCABULARY_ROWS): its own
// row's, else its family's. A scoped name is judged by its effect.
sema_effect_vocabulary_irreversible: fn(effect_name: String) -> Bool Never! {
    base: effect_scope_split(effect_name).base
    root: sema_effect_root(base)
    ^family: false
    loop row in EFFECT_VOCABULARY_ROWS {
        if row.name == base -> return row.irreversible
        if row.name == root -> family = row.irreversible
    }
    family
}

// Adds callee `callee_key`'s effect `name` to a region's `inferred` row:
// scoped as each of the region's constant-argument calls to that publisher
// names it, and bare too when the region also calls it with a run-time
// argument or names no scope for it.
sema_effect_region_add_scoped: fn(inferred: ^[String], scoped_calls: [SemaEffectScopedCall], bare_scope_callees: [String], callee_key: String, name: String) Never! {
    ^renamed: false
    loop call in scoped_calls {
        if call.callee != callee_key || call.published != name -> next
        renamed = true
        sema_effect_set_add(inferred, call.scoped)
    }
    if !renamed || bare_scope_callees.contains(callee_key) -> sema_effect_set_add(inferred, name)
}

// `modules` are the checked modules; each input names its module, whose
// functions and call facts are read in place. `prepared` holds each input
// module's graph nodes, source index and call index, built in input order
// (sema_effect_prepare_modules, or on compiler threads one module range at a
// time). The solved effect row of every input module's function is stamped
// onto `modules` at the end. The effect sites of every module's functions are
// collected at once on up to `threads` compiler threads
// (sema_effect_collect_threads); the result is the same for any thread count.
// `package_denials` is the root package's `authority.deny` row and
// `organization_denials` the organization policy's (read from
// `organization_source`), which no package row lifts; `denial_modules`
// marks, by graph module index, the modules both rows bind. `file_caps` holds,
// by graph module index, the `#FX(…)` caps a file module takes from the
// `name: module` declarations above it. `trait_caps` is each capped trait's
// `#FX(…)` cap (sema_effect_trait_caps). `decls` is the run's declaration
// table, which direct callees name. `prep_functions` holds the keys of the
// functions the build checked to run while compiling (a comptime item's
// callees, whose call sites no module records): prep code, never a runtime
// entry (sema_effect_runtime_input_paths). `closed` is an executable build,
// which seals each call through a function value to the program's own
// functions and lambdas (sema_effect_stack_seal). `seal`, the Core
// library's check, also summarizes each Core function for a bound program
// (SemaEffectGraphResult.core_seal). `package_policies` are the loaded
// packages' rows, `expert_modules` each graph module's row among them (-1:
// none, as for Core) and `main_package` the identity of the package being
// built: a function's own use of an expert effect needs its package to hold
// it (sema_effect_expert_not_held_diagnostic). `heap_free` names the
// selected machine when it has no heap ("" when it has one), and `entries`
// are the keys of the functions the program starts at, from which nothing
// may allocate (sema_effect_check_heap_free).
sema_effects_check_modules: fn(modules: ^[SemaGraphModuleResult], inputs: [SemaEffectModuleInput], prepared: ^^SemaEffectPrepared, package_denials: [String], denial_modules: [Bool], file_caps: [[SemaEffectModuleCap]], trait_caps: [U32:SemaEffectTypeCap], decls: DeclTable, symbols: ^^SymbolTable, interner: ^^Interner, table: ModuleTable, prep_functions: NameTable, threads: CompilerThreads, closed: Bool, organization_denials: [String]{[String]{}}, organization_source: String{""}, seal: Bool{false}, package_policies: [SemaRegistrationPackagePolicy]{[SemaRegistrationPackagePolicy]{}}, expert_modules: [Int]{[Int]{}}, main_package: String{""}, heap_free: String{""}, entries: [String]{[String]{}}, trace_sink: CompilerTraceSink?{None}) -> SemaEffectGraphResult {
    sema_effect_trace_step(trace_sink, "", "sema.effects.tables")
    ^owned_prepared: prepared.move()
    ^diagnostics: owned_prepared.diagnostics.move()
    ^nodes: owned_prepared.nodes.move()
    ^memory_facts: SemaMemoryProjectionFacts{declarations: [], projections: []}
    ^source_indices: owned_prepared.source_indices.move()
    ^node_keys: owned_prepared.node_keys.move()
    ^node_by_key: sema_effect_node_key_table(node_keys)
    // The trait implementations: implementing types by trait, and each
    // trait method's own summary per implementing type
    // (sema_effect_add_trait_impls).
    ^impls: SemaEffectTraitImpls{}
    loop module_index in 0..<inputs.len() {
        module_row: inputs[module_index]
        module_identity: module_text(table, modules[module_row.module_index].module_identity)
        loop row in module_row.trait_implementers {
            ^_: sema_effect_add_implementer(impls, module_identity, row.trait_name, row.owner)
        }
        sema_effect_add_trait_impls(modules[module_row.module_index].functions, module_row, source_indices[module_index], symbols, impls)
    }
    ^dyn_lists: [[String]]{}
    if impls.dyn_lists.len() > 0 -> dyn_lists.try_reserve(impls.dyn_lists.len()) ?? ()
    loop list in impls.dyn_lists { dyn_lists.push(sema_effect_set_of(list)) }
    impls.dyn_lists = dyn_lists.move()
    // The `…:close` method keys in key order, grouped by owner type.
    ^close_keys: [String]{}
    loop (id, key) in node_by_key.names.texts {
        if id < node_by_key.nodes.len() && node_by_key.nodes[id] >= 0 && symbol_key_names(key, "close") {
            close_keys.push(key)
        }
    }
    close_keys.sort_by(fn(left: String, right: String) { left <=> right })
    ^close_method_names: name_column_table(close_keys.len())
    ^close_method_rows: name_column(close_keys.len())
    ^close_method_lists: [[String]]{}
    loop key in close_keys {
        owner: symbol_key_leaf(key.removesuffix(".close"))
        if name_column_get(close_method_names, close_method_rows, owner) == .Val(row) {
            close_method_lists[row].push(key)
        } else {
            row: close_method_lists.len()
            name_column_set(close_method_names, close_method_rows, owner, row)
            close_method_lists.push([String]{key})
        }
    }
    // The unsafe and published rows of each node key, at its id in the node
    // keys' table.
    ^unsafe_rows: name_column(node_by_key.nodes.len())
    ^unsafe_name_texts: [String]{}
    ^published_rows: name_column(node_by_key.nodes.len())
    ^published_texts: [String]{}
    loop _ in 1..<node_by_key.nodes.len() {
        unsafe_rows.push(NAME_COLUMN_UNBOUND)
        published_rows.push(NAME_COLUMN_UNBOUND)
    }
    loop id in 0..<node_by_key.nodes.len() {
        node_index: node_by_key.nodes[id]
        if node_index < 0 -> next
        key: node_by_key.names.texts[id]
        if nodes[node_index].is_unsafe {
            unsafe_rows[id] = unsafe_name_texts.len()
            unsafe_name_texts.push(nodes[node_index].name)
        }
        if nodes[node_index].declared.len() > 0 {
            if effect_scope_published_effect(key, nodes[node_index].path_first, nodes[node_index].declared) == .Val(published) {
                published_rows[id] = published_texts.len()
                published_texts.push(published)
            }
        }
    }
    ^node_by_decl: sema_effect_nodes_by_decl(node_by_key, owned_prepared.node_decls, decls.rows.len())
    ^node_modules: loop node in nodes -> node.module_identity
    ^calls: SemaEffectCallIndex{modules: owned_prepared.calls.move(), node_by_key: node_by_key.move(), impls: impls.move(), trait_caps: trait_caps.copy(), close_method_names: close_method_names.move(), close_method_rows: close_method_rows.move(), close_method_lists: close_method_lists.move(), unsafe_rows: unsafe_rows.move(), unsafe_name_texts: unsafe_name_texts.move(), node_by_decl: node_by_decl.move(), node_keys: node_keys.move(), node_modules: node_modules.move(), published_rows: published_rows.move(), published_texts: published_texts.move(), symbols: symbols.move(), interner: interner.move()}
    sema_effect_trace_step(trace_sink, "sema.effects.tables", "sema.effects.collect")
    module_has_unsafe: sema_effect_modules_have_unsafe(modules, inputs, calls)
    function_nodes: sema_effect_function_nodes(modules, inputs, calls, threads)
    sema_effect_collect_threads(modules, inputs, function_nodes, nodes, calls, module_has_unsafe, diagnostics, threads)
    sema_effect_trace_step(trace_sink, "sema.effects.collect", "sema.effects.resolve")
    sema_effect_resolve_type_params(nodes, calls)
    sema_effect_resolve_edges(nodes, calls, threads)
    sema_effect_check_expanding_instances(nodes, inputs, diagnostics)
    ^type_reflections: sema_effect_type_reflections(nodes)
    sema_effect_trace_step(trace_sink, "sema.effects.resolve", "sema.effects.solve")
    callers: sema_effect_callers(nodes, table)
    solved: sema_effect_solve(nodes, callers)
    loop module_index in 0..<inputs.len() {
        ^facts: sema_effect_shared_facts(modules[inputs[module_index].module_index].call_facts)
        if facts.len() == 0 -> next
        ^sites: [U32:SharedLifetime]{}
        ^site_diagnostics: [Diagnostic]{}
        facts = loop fresh_item in facts -> fresh_item
        facts.sort_by(fn(left: SemaCallSiteFact, right: SemaCallSiteFact) { (sema_call_site_detail(left).shared_source <=> sema_call_site_detail(right).shared_source).then(left.span.start <=> right.span.start).then(left.span.end <=> right.span.end).then(sema_call_site_detail(left).shared_member <=> sema_call_site_detail(right).shared_member) })
        loop fact in facts {
            detail: fact.detail ?? next
            lifetime: detail.shared_lifetime ?? next
            // A publication with no initializer, or one whose effects were
            // not solved, has no direct Core initializer to prove pure.
            initializer: fact.callee ?? {
                site_diagnostics.push(sema_call_core_shared_diagnostic(detail.shared_member, fact.span))
                next
            }
            target: sema_effect_node_index(calls.node_by_key, symbol_table_key(calls.symbols, initializer)) ?? {
                site_diagnostics.push(sema_call_core_shared_diagnostic(detail.shared_member, fact.span))
                next
            }
            // `Panic` is the deny-only stop row, not an effect
            // the published value can carry, so it does not make it impure.
            ^impure: false
            loop effect_name in solved[target] {
                if effect_name != "Mem" && sema_effect_root(effect_name) != "Panic" {
                    impure = true
                    break
                }
            }
            ^conflicting: false
            if sites.get(initializer.id) == .Val(previous) -> conflicting = previous != lifetime
            if impure || conflicting {
                site_diagnostics.push(sema_call_core_shared_diagnostic(detail.shared_member, fact.span))
            }
            if sites.get(initializer.id) == None -> sites[initializer.id] = lifetime
        }
        sema_effect_publish_diagnostics(diagnostics, inputs[module_index].source_segments, site_diagnostics)
    }
    reaches: sema_effect_solve_reaches(nodes, callers, threads)
    secret_reach: reaches.secret
    library_reach: reaches.library
    dispatch_reach: reaches.dispatch
    ^pure_nodes: [Int]{}
    ^pure_rows: [[String]]{}
    sema_effect_trace_step(trace_sink, "sema.effects.solve", "sema.effects.nodes")
    sema_effect_check_nodes_parallel(nodes, inputs, solved, secret_reach, library_reach, dispatch_reach, threads, diagnostics, pure_nodes, pure_rows)
    sema_effect_check_repeatable_and_retries(nodes, inputs, calls.node_by_key, solved, diagnostics)
    loop node_index in 0..<nodes.len() {
        rare: nodes[node_index].rare ?? next
        if rare.callback_bounds.len() == 0 && rare.lambda_bounds.len() == 0 -> next
        ^callback_diagnostics: [Diagnostic]{}
        sema_effect_check_callback_bounds(nodes, calls.node_by_key, solved, node_index, callback_diagnostics)
        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, callback_diagnostics)
    }
    ^any_module_writes: false
    ^any_module_reads: false
    ^any_storage_globals: false
    ^any_comptime_inputs: false
    loop node in nodes {
        if node.rare == .Val(rare) {
            if rare.module_writes.len() > 0 -> any_module_writes = true
            if rare.module_reads.len() > 0 -> any_module_reads = true
            if !any_storage_globals && sema_effect_node_storage_touch(node) != None -> any_storage_globals = true
            if rare.comptime_inputs.len() > 0 -> any_comptime_inputs = true
            if any_module_writes && any_module_reads && any_storage_globals && any_comptime_inputs -> break
        }
    }
    solved_writes: sema_effect_solve_module_writes(nodes, callers, any_module_writes)
    // The debugger's probe answers take their verdicts from the solved rows
    // and solved module-write touch facts.
    sema_eval_probe_judge_effects(modules, nodes, calls, solved, solved_writes)
    sema_effect_check_compiler_hooks(table, modules, inputs, nodes, calls.node_by_key, solved, diagnostics)
    // A pure (`-[]>`) or `#Memo` function may not write or read changeable
    // module state, itself or through any function it calls or takes as a
    // value. Reuse one seen bitmap + undo list instead of allocating O(nodes)
    // bools per function.
    if any_module_writes || any_module_reads {
        ^state_seen: (loop _ in nodes -> false)
        ^state_visited: [Int]{}
        loop node_index in 0..<nodes.len() {
            is_pure: nodes[node_index].is_pure
            memo_span: nodes[node_index].memo_span
            if !is_pure && memo_span == None -> next
            if is_pure {
                if any_module_writes {
                    write_path: sema_effect_state_writer_path(nodes, node_index, state_seen, state_visited)
                    loop row in state_visited -> state_seen[row] = false
                    state_visited.clear()
                    if write_path.len() > 0 {
                        ^state_diagnostics: [Diagnostic]{sema_effect_pure_state_diagnostic(nodes, write_path)}
                        // The report points at the write, which may be in another module.
                        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[write_path[write_path.len() - 1]].module_index].source_segments, state_diagnostics)
                        next
                    }
                }
                if any_module_reads {
                    read_path: sema_effect_state_reader_path(nodes, node_index, state_seen, state_visited)
                    loop row in state_visited -> state_seen[row] = false
                    state_visited.clear()
                    if read_path.len() > 0 {
                        ^state_diagnostics: [Diagnostic]{sema_effect_pure_read_diagnostic(nodes, read_path)}
                        // The report points at the read, which may be in another module.
                        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[read_path[read_path.len() - 1]].module_index].source_segments, state_diagnostics)
                    }
                }
                next
            }
            if memo_span == .Val(at_memo) && sema_effect_uncovered(solved[node_index], [String]{}).len() == 0 {
                if any_module_writes {
                    write_path: sema_effect_state_writer_path(nodes, node_index, state_seen, state_visited)
                    loop row in state_visited -> state_seen[row] = false
                    state_visited.clear()
                    if write_path.len() > 0 {
                        ^memo_diagnostics: [Diagnostic]{sema_effect_memo_state_diagnostic(nodes, write_path, at_memo, true)}
                        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, memo_diagnostics)
                        next
                    }
                }
                if any_module_reads {
                    read_path: sema_effect_state_reader_path(nodes, node_index, state_seen, state_visited)
                    loop row in state_visited -> state_seen[row] = false
                    state_visited.clear()
                    if read_path.len() > 0 {
                        ^memo_diagnostics: [Diagnostic]{sema_effect_memo_state_diagnostic(nodes, read_path, at_memo, false)}
                        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, memo_diagnostics)
                    }
                }
            }
        }
        // `#Export(c)`, combinator branches, parallel callbacks, unscoped task
        // spawns, and `task.group` transitive races against tracked (non-raw-word)
        // changeable module storage globals.
        if any_storage_globals {
            raw_words: sema_effect_raw_storage_words(nodes)
            sema_effect_check_storage_concurrency(modules, inputs, nodes, calls, raw_words, state_seen, state_visited, diagnostics)
        }
    }
    // No function a runtime entry reaches may make a comptime input.
    if any_comptime_inputs {
        loop path in sema_effect_runtime_input_paths(nodes, modules, inputs, prep_functions, calls.symbols) {
            maker: path[path.len() - 1]
            made: nodes[maker].rare ?? SEMA_EFFECT_NODE_NO_RARE
            ^input_diagnostics: loop input in made.comptime_inputs -> sema_effect_runtime_input_diagnostic(nodes, path, input)
            sema_effect_publish_diagnostics(diagnostics, inputs[nodes[maker].module_index].source_segments, input_diagnostics)
        }
    }
    sema_effect_check_trait_bounds_parallel(modules, inputs, source_indices, nodes, calls, solved, threads, diagnostics)
    // Every call path's stack, by the frame model; FnBody keeps each frame
    // bound and each entry's path bound.
    sema_effect_trace_step(trace_sink, "sema.effects.nodes", "sema.effects.stack")
    ^bodies: sema_effect_stack_bodies_empty()
    sema_effect_stack_bodies(modules, inputs, function_nodes, nodes, calls, threads, bodies, closed: closed)
    frames: sema_effect_stack_frames(nodes, bodies, closed: closed)
    ^stack: sema_effect_stack_walk(nodes)
    // Whether a check walks the call graph past a body for what its reach
    // does: a memory or stack denial, a kernel's obligations, a cap over a
    // program function. A Core stand-in has no call edges, so such a walk
    // reads less of the program than the run binds (CoreSeal.jet).
    sema_effect_trace_step(trace_sink, "sema.effects.stack", "sema.effects.denials")
    ^walks: false
    loop node_index in 0..<nodes.len() {
        if nodes[node_index].rare == None && nodes[node_index].kernel == None -> next
        if nodes[node_index].rare == .Val(rare) && rare.memory_denials.len() > 0 -> walks = true
        if nodes[node_index].kernel != None -> walks = true
        ^memory_diagnostics: [Diagnostic]{}
        sema_effect_check_memory_denials(nodes, node_index, stack, frames, memory_diagnostics, memory_facts)
        if memory_diagnostics.len() > 0 {
            sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, memory_diagnostics)
        }
    }
    // A manifest guarantee covers every qualified function, including otherwise
    // unreferenced bodies, not just entry. The organization's denials hold
    // beside the package's own: a package row can't lift them, and each report
    // names the row that denies.
    ^denials: loop name in package_denials -> SemaEffectDenial{name: name, organization: ""}
    loop name in organization_denials {
        denials.push(SemaEffectDenial{name: name, organization: organization_source})
    }
    loop denial in denials {
        name: denial.name
        provenance: if denial.organization == "" -> "manifest denial `authority: {{ deny: [{name}] }}`" else -> "organization denial `authority: {{ deny: [{name}] }}`"
        if sema_effect_stack_bound(name) != None {
            walks = true
            loop root in 0..<nodes.len() {
                ^stack_diagnostics: [Diagnostic]{}
                sema_effect_check_stack(stack, frames, nodes, root, EffectRowEntry{name: name, span: Span{start: 0, end: 0}}, provenance, stack_diagnostics)
                sema_effect_publish_diagnostics(diagnostics, inputs[nodes[root].module_index].source_segments, stack_diagnostics)
            }
            next
        }
        fact: sema_effect_memory_fact(name) ?? next
        walks = true
        source: if denial.organization == "" -> "package.jet" else -> denial.organization
        declaration: SemaMemoryFactDeclaration{fact: fact, roots: loop node in nodes -> node.display_key, span: Span{start: 0, end: 0}, source: source, provenance: provenance}
        memory_facts.declarations.push(declaration)
        loop root in 0..<nodes.len() {
            ^memory_diagnostics: [Diagnostic]{}
            projection: sema_effect_memory_project(nodes, root, EffectRowEntry{name: name.copy(), span: Span{start: 0, end: 0}}, fact, memory_diagnostics)
            memory_facts.projections.push(SemaMemoryProjectionRow{root: nodes[root].display_key, fact: fact.copy(), projection: projection})
            sema_effect_publish_diagnostics(diagnostics, inputs[nodes[root].module_index].source_segments, memory_diagnostics)
        }
    }
    // A machine with no heap holds everything the program reaches to the
    // promise `-[!Mem.Alloc]>` makes, Core's bodies included.
    if heap_free != "" {
        walks = true
        sema_effect_check_heap_free(nodes, inputs, denial_modules, calls, entries, heap_free, diagnostics)
    }
    // A package's every other denial is a compile-time prohibition on its
    // own functions, exactly as if each wrote `-[!E]>`;
    // memory denials are the facts above.
    loop denial in denials {
        if sema_effect_memory_fact(denial.name) != None || sema_effect_stack_bound(denial.name) != None {
            next
        }
        denied: sema_effect_parse_name(denial.name) ?? next
        loop node_index in 0..<nodes.len() {
            graph_module: inputs[nodes[node_index].module_index].module_index
            if graph_module >= denial_modules.len() || !denial_modules[graph_module] -> next
            reached: sema_effect_covered_one(solved[node_index], denied)
            if reached.len() == 0 -> next
            ^panic_steps: [String]{}
            if sema_effect_root(denied) == "Panic" {
                panic_steps = sema_effect_panic_steps(nodes, node_index)
            }
            ^unsafe_reach: SemaEffectUnsafeReach?{None}
            if sema_effect_root(denied) == "Unsafe" {
                unsafe_reach = Val(sema_effect_unsafe_reach(nodes, node_index))
            }
            ^denial_diagnostics: [Diagnostic]{}
            denial_diagnostics.push(sema_effect_with_instance_notes(sema_effect_package_denied_diagnostic(nodes[node_index], reached, denied, panic_steps, unsafe_reach, denial.organization), sema_effect_instance_notes(nodes, solved, nodes[node_index]), reached))
            sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, denial_diagnostics)
        }
    }
    // A function's own use of an expert effect needs its package to hold
    // it: the main package by naming it in `authority.allow`, a dependency
    // by the main package's `authority.grants` line for it. A call into
    // another function leaves the callee's use with the callee's package, so
    // a grant to a dependency is not undone at its caller. Deny wins: the
    // package's own `deny` row, the main package's and the organization's
    // each bind it. A denial of the main package's own use, by its `deny` row
    // or the function's own `-[!E]>`, is the report above or E0749 at the
    // row; `direct_spans` names each effect once.
    loop node_index in 0..<nodes.len() {
        graph_module: inputs[nodes[node_index].module_index].module_index
        if graph_module >= expert_modules.len() || expert_modules[graph_module] < 0 -> next
        if nodes[node_index].direct_spans.len() == 0 -> next
        policy: package_policies[expert_modules[graph_module]]
        main: policy.package_identity == main_package
        expert_diagnostics: loop used in nodes[node_index].direct_spans -> {
            if !authority_expert(used.name) -> next
            ^row_denied: false
            loop bound in nodes[node_index].prohibited {
                if sema_effect_covers(bound, used.name) -> row_denied = true
            }
            if row_denied -> next
            denied: authority_covers_any(package_denials, used.name) || authority_covers_any(organization_denials, used.name) || authority_covers_any(policy.authority_deny ?? [String]{}, used.name)
            verdict: authority_expert_answer(policy.expert_held, denied, used.name)
            if verdict == AuthorityVerdict.Allowed || (main && verdict == AuthorityVerdict.Denied) {
                next
            }
            sema_effect_expert_not_held_diagnostic(nodes[node_index], used.name, used.span, policy, main, verdict)
        }
        if expert_diagnostics.len() > 0 {
            sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, expert_diagnostics)
        }
    }
    // A module's `#FX(…)` caps bind every function inside it: a file
    // module's from the module graph, an inline module's from the function.
    // A type's cap binds each of its methods, and a trait's cap every
    // implementation of its methods, in any package. A cap whose entries
    // scope FS or Net also binds at run time: its frame is entered with the
    // function's own (FnBody.effect_scope).
    sema_effect_trace_step(trace_sink, "sema.effects.denials", "sema.effects.caps")
    ^cap_frames: [String]{}
    loop node_index in 0..<nodes.len() {
        graph_module: inputs[nodes[node_index].module_index].module_index
        has_file_caps: graph_module < file_caps.len() && file_caps[graph_module].len() > 0
        if !has_file_caps && nodes[node_index].rare == None && nodes[node_index].type_cap == None && nodes[node_index].trait_symbol == None {
            cap_frames.push("")
            next
        }
        ^caps: [SemaEffectModuleCap]{}
        if has_file_caps {
            loop cap in file_caps[graph_module] -> caps.push(cap.copy())
        }
        if nodes[node_index].rare == .Val(rare) {
            loop cap in rare.module_caps -> caps.push(SemaEffectModuleCap{cap: cap, site: None})
        }
        if nodes[node_index].type_cap == .Val(type_cap) -> caps.push(type_cap.copy())
        if nodes[node_index].trait_symbol == .Val(trait_id) {
            if calls.trait_caps.get(trait_id.id) == .Val(found) {
                site: if found.module_identity == nodes[node_index].module_identity -> None else -> found.cap.site
                caps.push(SemaEffectModuleCap{cap: found.cap.cap, site: site})
            }
        }
        if caps.len() == 0 {
            cap_frames.push("")
            next
        }
        cap_frames.push(sema_effect_cap_frames(caps))
        if !module_is_core(nodes[node_index].module_identity) -> walks = true
        ^cap_diagnostics: [Diagnostic]{}
        notes: sema_effect_instance_notes(nodes, solved, nodes[node_index])
        loop cap in caps {
            sema_effect_check_module_cap(nodes, node_index, solved[node_index], cap, notes, stack, frames, cap_diagnostics)
        }
        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, cap_diagnostics)
    }
    sema_effect_trace_step(trace_sink, "sema.effects.caps", "sema.effects.passes")
    sema_effect_check_module_passes_parallel(modules, inputs, source_indices, solved, calls, nodes, threads, diagnostics)
    // All source reads are finished: stamp the solved rows in place, the
    // frame bound of each function a stack denial reaches, and each uncalled
    // function's heap and stack bounds.
    sema_effect_trace_step(trace_sink, "sema.effects.passes", "sema.effects.stamp")
    called: sema_effect_called(nodes)
    ^heaps: [String]{}
    ^stacks: [String]{}
    if compiler_threads_admit(threads, 2, nodes.len(), SEMA_EFFECT_LOOKUPS_PER_THREAD, 0, 0) > 1 {
        task.group sema_effect_bounds {
            heaps_task: task sema_effect_heap_bounds(nodes, called)
            stacks = sema_effect_stack_bounds(stack, frames, nodes, called)
            heaps = compiler_threads_joined(heaps_task)
        }
    } else {
        heaps = sema_effect_heap_bounds(nodes, called)
        stacks = sema_effect_stack_bounds(stack, frames, nodes, called)
    }
    ^stamps: sema_effect_build_tfacts_parallel(modules, inputs, function_nodes, nodes, solved, solved_writes, threads)
    stamps.reverse()
    loop {
        stamp: stamps.pop() ?? break
        target: stamp.module_index
        function_index: stamp.function_index
        node_index: stamp.node_index
        capped: cap_frames[node_index] != "" && !modules[target].functions[function_index].effect_scope.starts_with(cap_frames[node_index])
        frame_bound: if stack.guarded[node_index] -> frames.own[node_index] else -> -1
        modules[target].functions[function_index].effects = stamp.effects.move()
        if capped {
            modules[target].functions[function_index].effect_scope = sema_effect_capped_scope(cap_frames[node_index], modules[target].functions[function_index].effect_scope)
        }
        if heaps[node_index] != "" {
            modules[target].functions[function_index].heap = heaps[node_index].copy()
        }
        if stacks[node_index] != "" {
            modules[target].functions[function_index].stack = stacks[node_index].copy()
        }
        modules[target].functions[function_index].frame_bound = frame_bound
    }
    // e3401 names the first impure call and its chain; the reached row is the
    // report when no single call carries it.
    sema_effect_trace_step(trace_sink, "sema.effects.stamp", "sema.effects.pure")
    ^exact_errors: 0
    loop (pending, node_index) in pure_nodes {
        ^pure_diagnostics: [Diagnostic]{}
        pure_diagnostics.push(sema_pure_root_find(nodes[node_index].key, modules, decls, calls.symbols, true) ?? sema_effect_pure_diagnostic(nodes[node_index], pure_rows[pending]))
        if !module_is_core(nodes[node_index].module_identity) -> exact_errors += 1
        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, pure_diagnostics)
    }
    core_seal: if seal -> sema_effect_core_seal_rows(nodes.move(), solved, table) else -> [SemaCoreSealEffects]{}
    sema_effect_trace_step(trace_sink, "sema.effects.pure", "")
    complete: !sema_has_error_since(diagnostics, 0)
    SemaEffectGraphResult{diagnostics: diagnostics.move(), complete: complete, memory_declarations: memory_facts.declarations.move(), memory_projections: memory_facts.projections.move(), core_seal: core_seal, walks: walks, exact_errors: exact_errors, type_reflections: type_reflections.move(), symbols: calls.symbols.move(), interner: calls.interner.move()}
}

// Ends the effect pass's step `ended` and begins `begun` (either may be
// empty) on the run's trace, so each step's wall and CPU time shows.
sema_effect_trace_step: fn(trace_sink: CompilerTraceSink?, ended: String, begun: String) {
    sink: trace_sink ?? return
    if ended != "" -> sink.end(ended, -1)
    if begun != "" -> sink.begin(begun, "", -1, -1)
}

SemaEffectNodeCheckPart: struct {
    diagnostics: [Diagnostic],
    pure_nodes: [Int],
    pure_rows: [[String]],
}

sema_effect_check_nodes_range: fn(nodes: [SemaEffectNode], inputs: [SemaEffectModuleInput], solved: [[String]], secret_reach: [Bool], library_reach: SemaLibraryEffectReach, dispatch_reach: [Bool], from: Int, to: Int) -> SemaEffectNodeCheckPart {
    ^diagnostics: [Diagnostic]{}
    ^pure_nodes: [Int]{}
    ^pure_rows: [[String]]{}
    ^dispatch_seen: (loop _ in nodes -> false)
    loop node_index in from..<to {
        ^function_diagnostics: [Diagnostic]{}
        ^pure_reached: [String]{}
        ^dispatch: Diagnostic?{None}
        if (nodes[node_index].has_declared_row || nodes[node_index].is_pure) && dispatch_reach[node_index] {
            ^visited: [Int]{}
            site: sema_effect_find_dispatch(nodes, dispatch_reach, node_index, dispatch_seen, visited)
            loop row in visited -> dispatch_seen[row] = false
            if site == .Val(found) -> dispatch = Val(sema_effect_locate_dispatch(found, inputs))
        }
        ^panic_steps: [String]{}
        ^unsafe_reach: SemaEffectUnsafeReach?{None}
        if nodes[node_index].prohibited.len() > 0 {
            panic_steps = sema_effect_panic_steps(nodes, node_index)
            if sema_effect_reaches_unsafe(sema_effect_covered(solved[node_index], nodes[node_index].prohibited)) {
                unsafe_reach = Val(sema_effect_unsafe_reach(nodes, node_index))
            }
        }
        notes: sema_effect_instance_notes(nodes, solved, nodes[node_index])
        ^_: sema_effect_check_node(nodes[node_index], solved[node_index], secret_reach[node_index], dispatch, panic_steps, unsafe_reach, notes, pure_reached, function_diagnostics)
        sema_library_effect_check_denials(nodes[node_index], library_reach.reached[node_index], solved[node_index], function_diagnostics)
        sema_library_effect_check_kinds(nodes[node_index], library_reach, library_reach.reached[node_index], function_diagnostics)
        sema_library_effect_check_values(nodes[node_index], library_reach.reached[node_index], function_diagnostics)
        if pure_reached.len() > 0 {
            pure_nodes.push(node_index)
            pure_rows.push(pure_reached)
        }
        if function_diagnostics.len() > 0 {
            sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, function_diagnostics)
        }
    }
    SemaEffectNodeCheckPart{diagnostics: diagnostics.move(), pure_nodes: pure_nodes.move(), pure_rows: pure_rows.move()}
}

sema_effect_check_nodes_spawn: fn(nodes: [SemaEffectNode], inputs: [SemaEffectModuleInput], solved: [[String]], secret_reach: [Bool], library_reach: SemaLibraryEffectReach, dispatch_reach: [Bool], part: Int, workers: Int, diagnostics: ^[Diagnostic], pure_nodes: ^[Int], pure_rows: ^[[String]]) {
    from: part * nodes.len() /% workers
    to: (part + 1) * nodes.len() /% workers
    if part + 1 >= workers {
        ^done: sema_effect_check_nodes_range(nodes, inputs, solved, secret_reach, library_reach, dispatch_reach, from, to)
        diagnostics.extend(done.diagnostics.move())
        pure_nodes.extend(done.pure_nodes.move())
        pure_rows.extend(done.pure_rows.move())
        return
    }
    task.group sema_effect_node_checks {
        head: task sema_effect_check_nodes_range(nodes, inputs, solved, secret_reach, library_reach, dispatch_reach, from, to)
        ^rest_diags: [Diagnostic]{}
        ^rest_pure_nodes: [Int]{}
        ^rest_pure_rows: [[String]]{}
        sema_effect_check_nodes_spawn(nodes, inputs, solved, secret_reach, library_reach, dispatch_reach, part + 1, workers, rest_diags, rest_pure_nodes, rest_pure_rows)
        ^done: compiler_threads_joined(head)
        diagnostics.extend(done.diagnostics.move())
        pure_nodes.extend(done.pure_nodes.move())
        pure_rows.extend(done.pure_rows.move())
        diagnostics.extend(rest_diags.move())
        pure_nodes.extend(rest_pure_nodes.move())
        pure_rows.extend(rest_pure_rows.move())
    }
}

SemaEffectReaches: struct {
    secret: [Bool],
    library: SemaLibraryEffectReach,
    dispatch: [Bool],
}

sema_effect_solve_reaches: fn(nodes: [SemaEffectNode], callers: [[Int]], threads: CompilerThreads) -> SemaEffectReaches {
    reach_workers: compiler_threads_admit(threads, 3, nodes.len(), 256, 0, 0)
    if reach_workers <= 1 {
        return SemaEffectReaches{secret: sema_effect_secret_reach(nodes, callers), library: sema_library_effect_reach(nodes, callers), dispatch: sema_effect_dispatch_reach(nodes, callers)}
    }
    ^secret: [Bool]{}
    ^dispatch: [Bool]{}
    ^library_box: [SemaLibraryEffectReach]{}
    task.group sema_effect_reaches {
        secret_task: task sema_effect_secret_reach(nodes, callers)
        dispatch_task: task sema_effect_dispatch_reach(nodes, callers)
        library_box.push(sema_library_effect_reach(nodes, callers))
        secret = compiler_threads_joined(secret_task)
        dispatch = compiler_threads_joined(dispatch_task)
    }
    library: compiler_threads_taken(library_box)
    SemaEffectReaches{secret: secret, library: library, dispatch: dispatch}
}

sema_effect_check_nodes_parallel: fn(nodes: [SemaEffectNode], inputs: [SemaEffectModuleInput], solved: [[String]], secret_reach: [Bool], library_reach: SemaLibraryEffectReach, dispatch_reach: [Bool], threads: CompilerThreads, diagnostics: ^[Diagnostic], pure_nodes: ^[Int], pure_rows: ^[[String]]) {
    workers: compiler_threads_admit(threads, nodes.len(), nodes.len(), 512, 0, 0)
    if workers <= 1 {
        ^done: sema_effect_check_nodes_range(nodes, inputs, solved, secret_reach, library_reach, dispatch_reach, 0, nodes.len())
        diagnostics.extend(done.diagnostics.move())
        pure_nodes.extend(done.pure_nodes.move())
        pure_rows.extend(done.pure_rows.move())
        return
    }
    sema_effect_check_nodes_spawn(nodes, inputs, solved, secret_reach, library_reach, dispatch_reach, 0, workers, diagnostics, pure_nodes, pure_rows)
}

sema_effect_check_trait_bounds_range: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], source_indices: [SemaEffectSourceIndex], nodes: [SemaEffectNode], calls: SemaEffectCallIndex, solved: [[String]], from: Int, to: Int) -> [Diagnostic] {
    ^out: [Diagnostic]{}
    loop module_index in from..<to {
        module_row: inputs[module_index]
        ^bound_diagnostics: [Diagnostic]{}
        sema_effect_check_trait_bounds(module_row, modules[module_row.module_index].functions, source_indices[module_index], nodes, calls.node_by_key, calls.symbols, solved, bound_diagnostics)
        if bound_diagnostics.len() > 0 {
            sema_effect_publish_diagnostics(out, module_row.source_segments, bound_diagnostics)
        }
    }
    out
}

sema_effect_check_trait_bounds_spawn: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], source_indices: [SemaEffectSourceIndex], nodes: [SemaEffectNode], calls: SemaEffectCallIndex, solved: [[String]], part: Int, workers: Int, diagnostics: ^[Diagnostic]) {
    from: part * inputs.len() /% workers
    to: (part + 1) * inputs.len() /% workers
    if part + 1 >= workers {
        diagnostics.extend(sema_effect_check_trait_bounds_range(modules, inputs, source_indices, nodes, calls, solved, from, to))
        return
    }
    task.group sema_effect_trait_bound_checks {
        head: task sema_effect_check_trait_bounds_range(modules, inputs, source_indices, nodes, calls, solved, from, to)
        ^rest: [Diagnostic]{}
        sema_effect_check_trait_bounds_spawn(modules, inputs, source_indices, nodes, calls, solved, part + 1, workers, rest)
        diagnostics.extend(compiler_threads_joined(head))
        diagnostics.extend(rest.move())
    }
}

sema_effect_check_trait_bounds_parallel: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], source_indices: [SemaEffectSourceIndex], nodes: [SemaEffectNode], calls: SemaEffectCallIndex, solved: [[String]], threads: CompilerThreads, diagnostics: ^[Diagnostic]) {
    workers: compiler_threads_admit(threads, inputs.len(), inputs.len(), 32, 0, 0)
    if workers <= 1 {
        diagnostics.extend(sema_effect_check_trait_bounds_range(modules, inputs, source_indices, nodes, calls, solved, 0, inputs.len()))
        return
    }
    sema_effect_check_trait_bounds_spawn(modules, inputs, source_indices, nodes, calls, solved, 0, workers, diagnostics)
}

SemaEffectModulePassPart: struct {
    region_diags: [Diagnostic],
    call_diags: [Diagnostic],
}

sema_effect_check_module_passes_range: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], source_indices: [SemaEffectSourceIndex], solved: [[String]], calls: SemaEffectCallIndex, nodes: [SemaEffectNode], from: Int, to: Int) -> SemaEffectModulePassPart {
    ^region_diags: [Diagnostic]{}
    ^call_diags: [Diagnostic]{}
    loop module_index in from..<to {
        module_row: inputs[module_index]
        sema_effect_check_module_regions(modules[module_row.module_index].functions, modules[module_row.module_index].call_facts, module_row, module_index, source_indices[module_index], solved, calls, nodes, region_diags)
        sema_effect_check_discarded(modules[module_row.module_index].call_facts, module_row, nodes, calls.node_by_key, calls.symbols, solved, call_diags)
        sema_effect_check_hole_headers(modules[module_row.module_index].call_facts, module_row, nodes, calls, solved, call_diags)
    }
    SemaEffectModulePassPart{region_diags: region_diags.move(), call_diags: call_diags.move()}
}

sema_effect_check_module_passes_spawn: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], source_indices: [SemaEffectSourceIndex], solved: [[String]], calls: SemaEffectCallIndex, nodes: [SemaEffectNode], part: Int, workers: Int, region_diags: ^[Diagnostic], call_diags: ^[Diagnostic]) {
    from: part * inputs.len() /% workers
    to: (part + 1) * inputs.len() /% workers
    if part + 1 >= workers {
        ^done: sema_effect_check_module_passes_range(modules, inputs, source_indices, solved, calls, nodes, from, to)
        region_diags.extend(done.region_diags.move())
        call_diags.extend(done.call_diags.move())
        return
    }
    task.group sema_effect_module_pass_checks {
        head: task sema_effect_check_module_passes_range(modules, inputs, source_indices, solved, calls, nodes, from, to)
        ^rest_regions: [Diagnostic]{}
        ^rest_calls: [Diagnostic]{}
        sema_effect_check_module_passes_spawn(modules, inputs, source_indices, solved, calls, nodes, part + 1, workers, rest_regions, rest_calls)
        ^got: compiler_threads_joined(head)
        region_diags.extend(got.region_diags.move())
        region_diags.extend(rest_regions.move())
        call_diags.extend(got.call_diags.move())
        call_diags.extend(rest_calls.move())
    }
}

sema_effect_check_module_passes_parallel: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], source_indices: [SemaEffectSourceIndex], solved: [[String]], calls: SemaEffectCallIndex, nodes: [SemaEffectNode], threads: CompilerThreads, diagnostics: ^[Diagnostic]) {
    workers: compiler_threads_admit(threads, inputs.len(), inputs.len(), 32, 0, 0)
    if workers <= 1 {
        ^done: sema_effect_check_module_passes_range(modules, inputs, source_indices, solved, calls, nodes, 0, inputs.len())
        diagnostics.extend(done.region_diags.move())
        diagnostics.extend(done.call_diags.move())
        return
    }
    ^region_diags: [Diagnostic]{}
    ^call_diags: [Diagnostic]{}
    sema_effect_check_module_passes_spawn(modules, inputs, source_indices, solved, calls, nodes, 0, workers, region_diags, call_diags)
    diagnostics.extend(region_diags.move())
    diagnostics.extend(call_diags.move())
}

// A function's stamped effect facts: the function at `function_index` of
// module `module_index`, whose effect node is `node_index`.
SemaEffectStamp: struct {
    module_index: Int,
    function_index: Int,
    node_index: Int,
    effects: TEffectFacts,
}

sema_effect_build_tfacts_range: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], function_nodes: [[Int]], nodes: [SemaEffectNode], solved: [[String]], solved_writes: [String?], from: Int, to: Int) -> [SemaEffectStamp] {
    ^out: [SemaEffectStamp]{}
    loop input_position in from..<to {
        target: inputs[input_position].module_index
        loop function_index in 0..<modules[target].functions.len() {
            node_index: function_nodes[input_position][function_index]
            if node_index < 0 -> next
            solved_write: if node_index < solved_writes.len() -> solved_writes[node_index] else -> String?{None}
            ^effects: sema_effect_tfacts(nodes[node_index], solved[node_index], solved_write)
            memoized: modules[target].functions[function_index].memo_bound != None || modules[target].functions[function_index].memo_unbounded
            if memoized -> sema_effect_context_reach(nodes, node_index, effects)
            out.push(SemaEffectStamp{module_index: target, function_index: function_index, node_index: node_index, effects: effects.move()})
        }
    }
    out
}

sema_effect_build_tfacts_parts: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], function_nodes: [[Int]], nodes: [SemaEffectNode], solved: [[String]], solved_writes: [String?], bounds: [Int], at: Int) -> [[SemaEffectStamp]] {
    ^done: [[SemaEffectStamp]]{}
    if at + 1 >= bounds.len() -> return done
    from: bounds[at]
    to: bounds[at + 1]
    if at + 2 == bounds.len() {
        done.push(sema_effect_build_tfacts_range(modules, inputs, function_nodes, nodes, solved, solved_writes, from, to))
        return done
    }
    task.group sema_effect_tfacts_group {
        head: task sema_effect_build_tfacts_range(modules, inputs, function_nodes, nodes, solved, solved_writes, from, to)
        ^rest: sema_effect_build_tfacts_parts(modules, inputs, function_nodes, nodes, solved, solved_writes, bounds, at + 1)
        done.push(compiler_threads_joined(head))
        loop part in rest.move() -> done.push(part)
    }
    done
}

sema_effect_build_tfacts_parallel: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], function_nodes: [[Int]], nodes: [SemaEffectNode], solved: [[String]], solved_writes: [String?], threads: CompilerThreads) -> [SemaEffectStamp] {
    ^weights: [Int]{}
    ^work: 0
    loop input_position in 0..<inputs.len() {
        count: modules[inputs[input_position].module_index].functions.len()
        weights.push(count)
        work += count
    }
    workers: compiler_threads_admit(threads, weights.len(), work, 512, 0, 0)
    if workers <= 1 {
        return sema_effect_build_tfacts_range(modules, inputs, function_nodes, nodes, solved, solved_writes, 0, inputs.len())
    }
    ^parts: sema_effect_build_tfacts_parts(modules, inputs, function_nodes, nodes, solved, solved_writes, compiler_threads_partition(weights, workers), 0)
    parts.reverse()
    ^out: [SemaEffectStamp]{}
    loop parts.len() > 0 {
        ^part: parts.pop() ?? break
        out.extend(part.move())
    }
    out
}

// The rows of the effect graph each input module contributes on its own:
// its functions' nodes (with their keys, their declarations' DeclTable rows
// (-1: none) and the diagnostics building them reported), the index of its
// effect sources and the index of its call facts, all in input order.
SemaEffectPrepared: struct {
    nodes: [SemaEffectNode],
    node_keys: [String],
    node_decls: [Int],
    diagnostics: [Diagnostic],
    source_indices: [SemaEffectSourceIndex],
    calls: [SemaEffectModuleCalls],
}

sema_effect_prepared_empty: fn() -> SemaEffectPrepared Never! {
    SemaEffectPrepared{nodes: [SemaEffectNode]{}, node_keys: [String]{}, node_decls: [Int]{}, diagnostics: [Diagnostic]{}, source_indices: [SemaEffectSourceIndex]{}, calls: [SemaEffectModuleCalls]{}}
}

// Every input module's rows, in input order.
sema_effect_prepare_modules: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], decls: DeclTable, symbols: SymbolTable) -> SemaEffectPrepared {
    ^prepared: sema_effect_prepared_empty()
    loop (input_position, module_row) in inputs {
        sema_effect_prepare_module(prepared, modules[module_row.module_index].functions, modules[module_row.module_index].call_facts, module_row, input_position, decls, symbols)
    }
    prepared
}

// Appends the rows of the input module at `input_position`.
sema_effect_prepare_module: fn(prepared: ^SemaEffectPrepared, functions: [FnBody], call_facts: [SemaCallSiteFact], module_row: SemaEffectModuleInput, input_position: Int, decls: DeclTable, symbols: SymbolTable) {
    ^source_index: sema_effect_source_index(module_row.sources)
    sema_effect_add_module_nodes(functions, module_row, input_position, source_index, symbols, prepared.nodes, prepared.node_keys, prepared.diagnostics)
    loop function in functions {
        row: if decl_table_find(decls, symbols, function.key) == .Val(id) -> id.row.index() else -> -1
        prepared.node_decls.push(row)
    }
    prepared.source_indices.push(source_index)
    prepared.calls.push(sema_effect_module_calls(call_facts))
}

// Appends `part`, the rows of the next input modules, built with input
// positions counted from 0; `inputs_before` is the number of input modules
// whose rows `prepared` already holds.
sema_effect_prepared_join: fn(prepared: ^SemaEffectPrepared, part: ^^SemaEffectPrepared, inputs_before: Int) {
    ^owned: part.move()
    loop index in 0..<owned.nodes.len() {
        owned.nodes[index].module_index = owned.nodes[index].module_index + inputs_before
    }
    prepared.nodes.extend(owned.nodes.move())
    prepared.node_keys.extend(owned.node_keys.move())
    prepared.node_decls.extend(owned.node_decls.move())
    prepared.diagnostics.extend(owned.diagnostics.move())
    prepared.source_indices.extend(owned.source_indices.move())
    prepared.calls.extend(owned.calls.move())
}

// One graph node per function of the input module `module_index`, in order,
// and its key in `node_keys` (node order).
sema_effect_add_module_nodes: fn(functions: [FnBody], module_row: SemaEffectModuleInput, module_index: Int, source_index: SemaEffectSourceIndex, symbols: SymbolTable, nodes: ^[SemaEffectNode], node_keys: ^[String], diagnostics: ^[Diagnostic]) {
    loop function in functions {
        ^function_diagnostics: [Diagnostic]{}
        node_keys.push(function.key)
        nodes.push(sema_effect_node_from_source(function, module_row.sources, sema_effect_source_position(function, source_index), module_index, module_row.library_effects, symbols, function_diagnostics))
        sema_effect_publish_diagnostics(diagnostics, module_row.source_segments, function_diagnostics)
    }
}

// Each key's first node, hashed (A1); the table's ids name the keys in
// first-node order.
sema_effect_node_key_table: fn(node_keys: [String]) -> SemaEffectNodeKeys Never! {
    ^table: SemaEffectNodeKeys{names: name_column_table(node_keys.len()), nodes: name_column(node_keys.len())}
    loop (node, key) in node_keys { name_column_set_first(table.names, table.nodes, key, node) }
    table
}

// The trait implementations of one effect check, by typed keys over `names`.
// A trait is its (module, name) pair slot (name_pair_slot): the trait's own
// module, so an implementation and a call through a trait value name it
// alike. `traits` gives its row, and per trait row `implementers` holds the
// implementing types' leaf name ids in first-seen order, each once
// (`implementer_seen`, by (trait row, type) slot). A method is its (trait
// row, method name) slot: `methods` gives its row, `method_traits` the
// method row's trait row, and `dyn_lists` every implementation's node key,
// the targets of a call through a trait value. `impl_keys` holds each
// implementation's own node key by (method row, type) slot, the first one
// kept. Each slot is sema_effect_impl_slot.
SemaEffectTraitImpls: struct {
    names: NameTable{name_table_sized(64)},
    traits: [Int:Int]{[Int:Int]{}},
    implementers: [[Int]]{[[Int]]{}},
    implementer_seen: [Int:Bool]{[Int:Bool]{}},
    methods: [Int:Int]{[Int:Int]{}},
    method_traits: [Int]{[Int]{}},
    dyn_lists: [[String]]{[[String]]{}},
    impl_keys: [Int:String]{[Int:String]{}},
}

// The slot of `id` under row `row`: the row in the high half.
sema_effect_impl_slot: fn(row: Int, id: Name) -> Int Never! { (row << 32) | name_index(id) }

// The row of the method named `method` of the trait whose symbol key is
// `trait_key`; -1 when no type implements it.
sema_effect_method_row: fn(impls: SemaEffectTraitImpls, trait_key: String, method: String) -> Int Never! {
    trait_slot: name_pair_find_slot(impls.names, sema_effect_symbol_module(trait_key) ?? "", symbol_key_leaf(trait_key)) ?? return -1
    trait_row: impls.traits.get(trait_slot) ?? return -1
    method_id: name_find(impls.names, method) ?? return -1
    impls.methods.get(sema_effect_impl_slot(trait_row, method_id)) ?? -1
}

// `owner` as an implementing type of trait `trait_name` of module
// `trait_module`, once; the trait's row.
sema_effect_add_implementer: fn(impls: ^SemaEffectTraitImpls, trait_module: String, trait_name: String, owner: String) -> Int {
    trait_slot: name_pair_slot(impls.names, trait_module, trait_name)
    ^trait_row: impls.traits.get(trait_slot) ?? -1
    if trait_row < 0 {
        trait_row = impls.implementers.len()
        impls.traits[trait_slot] = trait_row
        impls.implementers.push([Int]{})
    }
    owner_id: name_intern(impls.names, owner)
    seen: sema_effect_impl_slot(trait_row, owner_id)
    if impls.implementer_seen.has_key(seen) -> return trait_row
    impls.implementer_seen[seen] = true
    impls.implementers[trait_row].push(name_index(owner_id))
    trait_row
}

// Each implementation's node key per implementing type, first one kept, its
// owner as an implementer, and its place in its method's trait-value group. The
// trait is the one its source resolved where the `impl` block is written, so an
// `impl Trait` block in a struct or enum body and an impl of another module's
// trait count too.
sema_effect_add_trait_impls: fn(functions: [FnBody], module_row: SemaEffectModuleInput, source_index: SemaEffectSourceIndex, symbols: SymbolTable, impls: ^SemaEffectTraitImpls) {
    loop function in functions {
        if function.kind == .TopLevel -> next
        ^trait_key: ""
        if sema_effect_source_position(function, source_index) == .Val(at) {
            if module_row.sources[at].trait_symbol == .Val(trait_id) {
                trait_key = symbol_table_key(symbols, trait_id)
            }
        }
        owner_type: if function.kind == {
            .TraitMethod(_, _, owner_type, trait_symbol, _) -> {
                if trait_key == "" {
                    trait_key = symbol_key(symbols, function.tree.symbols, trait_symbol)
                }
                owner_type
            }
            .Method(_, owner_type) -> owner_type
            .TopLevel -> next
        }
        if trait_key == "" -> next
        owner: symbol_key_leaf(type_name(owner_type))
        trait_row: sema_effect_add_implementer(impls, sema_effect_symbol_module(trait_key) ?? "", symbol_key_leaf(trait_key), owner)
        method_slot: sema_effect_impl_slot(trait_row, name_intern(impls.names, sema_effect_method_name(function, module_row.sources, source_index)))
        ^method_row: impls.methods.get(method_slot) ?? -1
        if method_row < 0 {
            method_row = impls.dyn_lists.len()
            impls.methods[method_slot] = method_row
            impls.method_traits.push(trait_row)
            impls.dyn_lists.push([String]{})
        }
        impl_slot: sema_effect_impl_slot(method_row, name_intern(impls.names, owner))
        if !impls.impl_keys.has_key(impl_slot) -> impls.impl_keys[impl_slot] = function.key
        impls.dyn_lists[method_row].push(function.key)
    }
}

// Collects every function's effect sites of input module `module_index` into
// its node (`function_nodes`, sema_effect_function_nodes), and checks its
// unsafe calls.
sema_effect_collect_module: fn(functions: [FnBody], module_facts: [SemaCallSiteFact], function_nodes: [Int], module_row: SemaEffectModuleInput, module_index: Int, calls: SemaEffectCallIndex, has_unsafe: Bool, nodes: ^[SemaEffectNode], diagnostics: ^[Diagnostic]) {
    loop (function_index, function) in functions {
        node_index: function_nodes[function_index]
        if node_index < 0 -> next
        ^function_diagnostics: [Diagnostic]{}
        sema_effect_collect_one(nodes, node_index, function, calls, module_facts, module_index, has_unsafe, function_diagnostics)
        sema_effect_publish_diagnostics(diagnostics, module_row.source_segments, function_diagnostics)
    }
}

// One function's effect sites into its node `node_index`, and its unsafe
// calls; `module_index` is the function's input module (its call facts' row).
sema_effect_collect_one: fn(nodes: ^[SemaEffectNode], node_index: Int, function: FnBody, calls: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], module_index: Int, has_unsafe: Bool, diagnostics: ^[Diagnostic]) {
    sema_effect_collect_function(nodes, node_index, function, calls, module_facts, module_index, diagnostics)
    // A call needs an audited region only when its callee is an
    // `#Unsafe` function, an inline foreign function or a raw `extern rust`
    // function taking a capability; with none in this module's facts the
    // second BodyTree walk finds nothing (even inside lambdas).
    if has_unsafe {
        caller: sema_effect_caller_slot(calls, module_index, function.key)
        ^audited: function.is_unsafe && (function.unsafe_gate.map(fn(gate) { gate.enabled }) ?? false)
        sema_effect_check_unsafe_statements_tree(nodes, calls, module_facts, caller, function.tree, function.body, audited, diagnostics)
    }
}

// For each input module, whether any of its call facts targets an `#Unsafe`
// function, an inline foreign unsafe callee, or a raw foreign capability.
sema_effect_modules_have_unsafe: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], calls: SemaEffectCallIndex) -> [Bool] Never! {
    has_unsafe_keys: calls.unsafe_name_texts.len() > 0
    ^out: [Bool]{}
    if inputs.len() > 0 -> out.try_reserve(inputs.len()) ?? ()
    loop module_row in inputs {
        ^found: false
        loop site in modules[module_row.module_index].call_facts {
            ^audited_operation: false
            if site.detail == .Val(detail) {
                if detail.unsafe_foreign_name != None || detail.foreign_capability != None {
                    found = true
                    break
                }
                audited_operation = detail.audited_operation
            }
            if has_unsafe_keys && !audited_operation && site.callee == .Val(callee) && !symbol_is_local(callee) {
                if name_column_get(calls.node_by_key.names, calls.unsafe_rows, symbol_table_key(calls.symbols, callee)) != None {
                    found = true
                    break
                }
            }
        }
        out.push(found)
    }
    out
}

// A compiler thread is admitted for at least this many bytes of function
// source, so a small program collects on the calling thread.
SEMA_EFFECT_COLLECT_MIN_BYTES_PER_THREAD: 65536

// Estimated bytes of one collected copy of one graph node.
SEMA_EFFECT_NODE_BYTES: 1024

// Parts per admitted thread, claimed dynamically.
SEMA_EFFECT_COLLECT_PARTS_PER_THREAD: 8

// sema_effect_collect_module for every input module, on up to `threads`
// compiler threads. A function's collection writes only its own node
// (`node_by_key` of its key) and reads the call index under its own module's
// caller, never another node. The functions that name one node form one unit
// (almost always a single function), collected in module and function order
// into a copy of that node's row; units are independent. Threads claim
// consecutive parts of the units dynamically and read the modules, the
// graph's nodes and the call index in place, so nothing moves in or out for
// them; the caller then moves each unit's row back into the graph's nodes
// and publishes every function's reports in module and function order,
// exactly as one thread collecting the modules in order does.
sema_effect_collect_threads: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], function_nodes: [[Int]], nodes: ^[SemaEffectNode], calls: SemaEffectCallIndex, module_has_unsafe: [Bool], diagnostics: ^[Diagnostic], threads: CompilerThreads) {
    // One job per function with a node, in module and function order; a
    // unit's jobs chain through `job_next` from `unit_first`.
    ^job_input: [Int]{}
    ^job_function: [Int]{}
    ^job_next: [Int]{}
    ^unit_first: [Int]{}
    ^unit_last: [Int]{}
    ^unit_nodes: [Int]{}
    ^unit_weights: [Int]{}
    ^unit_of_node: [Int:Int]{}
    ^work: 0
    loop (input_position, module_row) in inputs {
        loop (function_index, function) in modules[module_row.module_index].functions {
            node_index: function_nodes[input_position][function_index]
            if node_index < 0 -> next
            job: job_input.len()
            job_input.push(input_position)
            job_function.push(function_index)
            job_next.push(-1)
            weight: function.source_span.end - function.source_span.start
            work += weight
            unit: unit_of_node.get(node_index) ?? -1
            if unit < 0 {
                unit_of_node[node_index] = unit_first.len()
                unit_first.push(job)
                unit_last.push(job)
                unit_nodes.push(node_index)
                unit_weights.push(weight)
            } else {
                job_next[unit_last[unit]] = job
                unit_last[unit] = job
                unit_weights[unit] = unit_weights[unit] + weight
            }
        }
    }
    workers: compiler_threads_admit(threads, unit_first.len(), work, SEMA_EFFECT_COLLECT_MIN_BYTES_PER_THREAD, 0, unit_first.len() * SEMA_EFFECT_NODE_BYTES)
    if workers <= 1 {
        loop (input_position, module_row) in inputs {
            sema_effect_collect_module(modules[module_row.module_index].functions, modules[module_row.module_index].call_facts, function_nodes[input_position], module_row, input_position, calls, module_has_unsafe[input_position], nodes, diagnostics)
        }
        return
    }
    ^count: workers * SEMA_EFFECT_COLLECT_PARTS_PER_THREAD
    if count > unit_first.len() -> count = unit_first.len()
    bounds: compiler_threads_partition(unit_weights, count)
    ^module_rows: loop module_row in inputs -> module_row.module_index
    jobs: SemaEffectCollectJobs{module_rows: module_rows.move(), job_input: job_input.move(), job_function: job_function.move(), job_next: job_next.move(), unit_first: unit_first.move(), unit_nodes: unit_nodes.move(), module_has_unsafe: module_has_unsafe}
    queue: SemaEffectCollectQueue{next: 0}
    ^parts: [[SemaEffectCollected]]{}
    loop _ in 0..<count -> parts.push([SemaEffectCollected]{})
    sema_effect_collect_claimers(modules, nodes, calls, jobs, bounds, queue, 0, workers, parts)
    sema_effect_collect_place(nodes, jobs, bounds, parts, inputs, diagnostics)
}

// What every collecting thread reads beside the modules, the graph's nodes
// and the call index: each input module's row in `modules`; each job's input
// module, function and next job of its unit; each unit's first job and node;
// and whether each input module has any unsafe call fact.
SemaEffectCollectJobs: struct {
    module_rows: [Int],
    job_input: [Int],
    job_function: [Int],
    job_next: [Int],
    unit_first: [Int],
    unit_nodes: [Int],
    module_has_unsafe: [Bool],
}

// The next unclaimed part of the collection, taken with one atomic add;
// every thread reads the queue in place.
SemaEffectCollectQueue: struct {
    next: Atomic<Int>,
}

// One function's reports, not yet located.
SemaEffectCollectReport: struct {
    job: Int,
    diagnostics: [Diagnostic],
}

// One unit's collected node row and its functions' nonempty reports.
SemaEffectCollected: struct {
    unit: Int,
    node: SemaEffectNode,
    reports: [SemaEffectCollectReport],
}

// A part one thread collected: its number and, last first, its units' rows.
SemaEffectCollectedPart: struct {
    part: Int,
    collected: [SemaEffectCollected],
}

// Moves each unit's collected node row into the graph's nodes, then
// publishes every function's reports in job (module and function) order.
sema_effect_collect_place: fn(nodes: ^[SemaEffectNode], jobs: SemaEffectCollectJobs, bounds: [Int], parts: ^[[SemaEffectCollected]], inputs: [SemaEffectModuleInput], diagnostics: ^[Diagnostic]) {
    ^reports: [SemaEffectCollectReport]{}
    loop part in 0..<bounds.len() - 1 {
        loop {
            ^collected: parts[part].pop() ?? break
            nodes[jobs.unit_nodes[collected.unit]] = collected.node.move()
            loop collected.reports.len() > 0 {
                ^report: collected.reports.pop() ?? break
                reports.push(report)
            }
        }
    }
    reports.sort_by(fn(left: SemaEffectCollectReport, right: SemaEffectCollectReport) { left.job <=> right.job })
    loop report in reports.move() {
        sema_effect_publish_diagnostics(diagnostics, inputs[jobs.job_input[report.job]].source_segments, report.diagnostics.move())
    }
}

// Runs collecting threads `from..<workers`, one task each, and moves every
// part a thread returned into `parts`.
sema_effect_collect_claimers: fn(modules: [SemaGraphModuleResult], nodes: [SemaEffectNode], calls: SemaEffectCallIndex, jobs: SemaEffectCollectJobs, bounds: [Int], queue: SemaEffectCollectQueue, from: Int, workers: Int, parts: ^[[SemaEffectCollected]]) {
    if from >= workers {
        return
    }
    task.group sema_effect_threads {
        head: task sema_effect_collect_claimed(modules, nodes, calls, jobs, bounds, queue)
        sema_effect_collect_claimers(modules, nodes, calls, jobs, bounds, queue, from + 1, workers, parts)
        ^claimed: compiler_threads_joined(head)
        loop claimed.len() > 0 {
            done: claimed.pop() ?? break
            parts[done.part] = done.collected.move()
        }
    }
}

// One thread: collects the parts it claims, in order, each unit into its own
// copy of the unit's node row.
sema_effect_collect_claimed: fn(modules: [SemaGraphModuleResult], nodes: [SemaEffectNode], calls: SemaEffectCallIndex, jobs: SemaEffectCollectJobs, bounds: [Int], queue: SemaEffectCollectQueue) -> [SemaEffectCollectedPart] {
    ^claimed: [SemaEffectCollectedPart]{}
    loop {
        part: queue.next.add(1)
        if part >= bounds.len() - 1 -> break
        ^collected: [SemaEffectCollected]{}
        loop unit in bounds[part]..<bounds[part + 1] {
            // copy: the unit's functions write their own row, while the
            // graph's row stays in place for every thread to read.
            ^own: [SemaEffectNode]{nodes[jobs.unit_nodes[unit]].copy()}
            ^reports: [SemaEffectCollectReport]{}
            ^job: jobs.unit_first[unit]
            loop job >= 0 {
                ^function_diagnostics: [Diagnostic]{}
                input_position: jobs.job_input[job]
                module_row_index: jobs.module_rows[input_position]
                sema_effect_collect_one(own, 0, modules[module_row_index].functions[jobs.job_function[job]], calls, modules[module_row_index].call_facts, input_position, jobs.module_has_unsafe[input_position], function_diagnostics)
                if function_diagnostics.len() > 0 {
                    reports.push(SemaEffectCollectReport{job: job, diagnostics: function_diagnostics.move()})
                }
                job = jobs.job_next[job]
            }
            ^node: own.pop() ?? panic("a collected effect node left its unit")
            collected.push(SemaEffectCollected{unit: unit, node: node.move(), reports: reports.move()})
        }
        collected.reverse()
        claimed.push(SemaEffectCollectedPart{part: part, collected: collected.move()})
    }
    claimed
}

// The module's Core publication obligations (facts with a shared lifetime).
sema_effect_shared_facts: fn(call_facts: [SemaCallSiteFact]) -> [SemaCallSiteFact] {
    ^facts: [SemaCallSiteFact]{}
    loop fact in call_facts {
        // copy: the obligations are sorted on their own; the module keeps its facts.
        if fact.detail == .Val(detail) && detail.shared_lifetime != None -> facts.push(fact.copy())
    }
    facts
}

// Every `#FX(…)` region of the functions of input module `module_index` stays
// within its caps, and every `#Transact` block's calls within the transaction
// wall.
sema_effect_check_module_regions: fn(functions: [FnBody], module_facts: [SemaCallSiteFact], module_row: SemaEffectModuleInput, module_index: Int, source_index: SemaEffectSourceIndex, solved: [[String]], calls: SemaEffectCallIndex, nodes: [SemaEffectNode], diagnostics: ^[Diagnostic]) {
    ^region_diagnostics: [Diagnostic]{}
    loop function in functions {
        at: sema_effect_source_position(function, source_index) ?? next
        source: module_row.sources[at]
        if source.fx_regions.len() == 0 && source.transact_spans.len() == 0 -> next
        node_index: sema_effect_node_index(calls.node_by_key, function.key) ?? next
        loop region in source.fx_regions {
            inferred: sema_effect_region_inferred(nodes, solved, node_index, function, region, calls, module_facts, module_index)
            over: if region.deep -> sema_effect_deep_check_over(inferred) else -> sema_effect_uncovered(inferred, region.caps)
            if over.len() == 0 -> next
            region_diagnostics.push(if region.deep -> sema_effect_deep_check_diagnostic(over, region.caps_span) else -> sema_effect_scope_diagnostic("FX", over, region.caps, region.caps_span))
        }
        loop span in source.transact_spans {
            sema_effect_check_transact_calls(nodes, solved, node_index, function, span, calls, module_facts, module_index, region_diagnostics)
        }
    }
    sema_effect_publish_diagnostics(diagnostics, module_row.source_segments, region_diagnostics)
}

// A discarded call result of a function whose row has no outcome (L0508).
sema_effect_check_discarded: fn(call_facts: [SemaCallSiteFact], module_row: SemaEffectModuleInput, nodes: [SemaEffectNode], node_by_key: SemaEffectNodeKeys, symbols: SymbolTable, solved: [[String]], diagnostics: ^[Diagnostic]) {
    discarded: loop fact in call_facts -> {
        if !fact.discarded -> next
        callee: fact.callee ?? next
        callee_key: sema_effect_run_key(symbols, callee) ?? next
        node_index: sema_effect_node_index(node_by_key, callee_key) ?? next
        // What the call binds the callee's type parameters to does its own
        // work (`measure(Square{…})` runs `Square.area`).
        if nodes[node_index].rare == .Val(rare) && rare.param_dispatches.len() > 0 -> next
        if !sema_effect_row_has_no_outcome(nodes[node_index], solved[node_index]) -> next
        sema_effect_discarded_result_diagnostic(nodes[node_index], fact.span)
    }
    sema_effect_publish_diagnostics(diagnostics, module_row.source_segments, discarded)
}

// A call written in a hole table's header whose callee acts outside the
// program: the header runs once per arm tried, so the action would repeat
// once per arm (E0442). The parser checks the header once per arm, so one
// written call reports once, with the fix its check found
// (sema_expr_hole_header_fix); a call already refused for a change it makes
// is not refused again.
sema_effect_check_hole_headers: fn(call_facts: [SemaCallSiteFact], module_row: SemaEffectModuleInput, nodes: [SemaEffectNode], calls: SemaEffectCallIndex, solved: [[String]], diagnostics: ^[Diagnostic]) {
    ^reported: [Diagnostic]{}
    ^seen: [Span]{}
    loop fact in call_facts {
        detail: fact.detail ?? next
        fix: detail.hole_header ?? next
        if fix.reported || seen.contains(fact.span) -> next
        if fact.callee == .Val(callee) {
            callee_key: sema_effect_run_key(calls.symbols, callee) ?? next
            node_index: sema_effect_node_index(calls.node_by_key, callee_key) ?? next
            if sema_effect_deep_check_over(solved[node_index]).len() == 0 -> next
            seen.push(fact.span)
            reported.push(sema_expr_hole_header_diagnostic(nodes[node_index].name, "has an effect", fix, fact.span))
            next
        }
        bound: fact.facts.effect_bound ?? next
        names: loop entry in bound -> entry.name
        if sema_effect_deep_check_over(names).len() == 0 -> next
        seen.push(fact.span)
        reported.push(sema_expr_hole_header_diagnostic(detail.intrinsic_api ?? "this call", "has an effect", fix, fact.span))
    }
    sema_effect_publish_diagnostics(diagnostics, module_row.source_segments, reported)
}

// The walkers over a checked flat body: the one a child visit continues
// with, and its own arguments (sema_effect_walk_expr,
// sema_effect_check_unsafe_expr, sema_effect_walk_region_expr, and
// lambda body walking).
SemaEffectWalk: enum {
    Collect(node_index: Int),
    TransactCollect(node_index: Int),
    Unsafe(audited: Bool),
    Region(node_index: Int, region: Span, skip_tx_hooks: Bool),
    LambdaBody(node_index: Int),
}

// A lambda body: its Iterable loops, value reads and stops, none of which
// its call facts hold, charged to the enclosing node.

sema_effect_walk_visit: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, expression: Int) {
    sema_effect_walk_visit_in(walk, nodes, facts, module_facts, diagnostics, caller, tree, expression, tree.nodes[body_node_index(tree, expression)])
}

sema_effect_walk_visit_in: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, expression: Int, node: BodyNode) {
    next: sema_effect_walk_enter(walk, nodes, facts, module_facts, diagnostics, caller, tree, expression, node) ?? return
    sema_effect_walk_expr_children(next, nodes, facts, module_facts, diagnostics, caller, tree, node)
}

// A walker's own work on `node`, the node at `expression`, before its
// children: the walk they continue with, or None when they aren't walked.
sema_effect_walk_enter: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, expression: Int, node: BodyNode) -> SemaEffectWalk? {
    if walk == {
        .Collect(node_index) | .TransactCollect(node_index) -> if sema_effect_walk_expr_enter(nodes, node_index, tree, expression, node, facts, module_facts, diagnostics, caller) -> Val(walk) else -> None
        .Unsafe(audited) -> if sema_effect_check_unsafe_enter(nodes, facts, module_facts, caller, tree, node, audited, diagnostics) -> Val(walk) else -> None
        .Region(node_index, region, skip_tx_hooks) -> sema_effect_walk_region_enter(nodes, node_index, tree, expression, node, region, skip_tx_hooks, facts, module_facts, diagnostics, caller)
        .LambdaBody(node_index) -> {
            // A lambda body's value reads and stops are the enclosing node's,
            // as its calls are the enclosing node's edges; so are the bounded
            // callback slots it fills.
            if node.kind == {
                .ConstRef(symbol) -> {
                    sema_effect_record_value_reads(nodes, facts, node_index, tree, expression, node)
                    sema_effect_record_callback_bound(nodes, facts.node_by_key, node_index, symbol_key(facts.symbols, tree.symbols, symbol), body_type(facts.interner, tree, expression), node.span)
                }
                .FnValue(_) | .MethodCall(_, _, _, _) -> {
                    sema_effect_record_value_reads(nodes, facts, node_index, tree, expression, node)
                }
                .RequireStop(_, _, _) | .Never(_, _) | .Slice(_, _, _, _, _) -> {
                    sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
                }
                .OrFallback(_, fallback, _) -> {
                    if fallback == .Panic(_, _) {
                        sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
                    }
                }
                .Index(_, _, kind, _, _, _) -> {
                    if kind == .List || kind == .Range || kind == .Map {
                        sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
                    }
                }
                .HostCall(_) -> {
                    sema_effect_record_comptime_input(nodes, node_index, node)
                    sema_effect_record_context(facts.interner, nodes, node_index, tree, node)
                }
                .IndirectCall(_, _, _, _) -> {
                    if !sema_effect_local_lambda_call(tree, node.kind) {
                        nodes[node_index].context_open = true
                    }
                }
                .Lambda(value) -> {
                    sema_effect_record_lambda_bound(nodes, node_index, facts, caller, tree, value, body_type(facts.interner, tree, expression), node.span)
                }
                .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
            }
            Val(walk)
        }
    }
}

// A stop (`panic`, `assert`, a `Never` value, `value ?? panic(message)`)
// puts `Panic` in the row of the node it is charged to. So does an index the
// checker did not prove: a list or map read, a range index or
// a slice keeps its runtime bounds or key check, which stops on a miss. A
// fixed-list index proved by its interval (FixedListProof) can't stop, and a
// user `Index` impl's own row arrives through its call.
sema_effect_record_stop: fn(nodes: ^[SemaEffectNode], node_index: Int, node: BodyNode) Never! {
    if node.kind == {
        .RequireStop(_, _, _) | .Never(_, _) -> {
            sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
        }
        .OrFallback(_, fallback, _) -> {
            if fallback == .Panic(_, _) {
                sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
            }
        }
        .Index(_, _, kind, _, _, _) -> {
            if kind == .List || kind == .Range || kind == .Map {
                sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
            }
        }
        .Slice(_, _, _, _, _) -> sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
    }
}

// A Binary node's operands. A left-leaning chain (`a + b + c …`) walks its
// left spine in this frame, so its length costs no stack: each inner level's
// own work going down, the innermost left operand, then each level's right
// operand, innermost first, under the walk its level continues with. That is
// the order visiting level by level runs them.
sema_effect_walk_binary: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, lhs: Int, rhs: Int) {
    lhs_idx: body_node_index(tree, lhs)
    if !(tree.nodes[lhs_idx].kind == .Binary(_, _, _, _, _)) {
        sema_effect_walk_visit_in(walk, nodes, facts, module_facts, diagnostics, caller, tree, lhs, tree.nodes[lhs_idx])
        sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, rhs)
        return
    }
    ^rights: [Int]{rhs}
    ^walks: [SemaEffectWalk]{walk}
    ^operand: lhs
    loop {
        idx: body_node_index(tree, operand)
        if tree.nodes[idx].kind == .Binary(_, _, _, inner_lhs, inner_rhs) {
            if sema_effect_walk_enter(walks[walks.len() - 1], nodes, facts, module_facts, diagnostics, caller, tree, operand, tree.nodes[idx]) == .Val(next) {
                rights.push(inner_rhs)
                walks.push(next)
                operand = inner_lhs
            } else {
                operand = -1
                break
            }
        } else { break }
    }
    if operand >= 0 {
        sema_effect_walk_visit(walks[walks.len() - 1], nodes, facts, module_facts, diagnostics, caller, tree, operand)
    }
    ^index: rights.len() - 1
    loop index >= 0 {
        sema_effect_walk_visit(walks[index], nodes, facts, module_facts, diagnostics, caller, tree, rights[index])
        index -= 1
    }
}

// The child nodes of a checked body node: the same nodes in the same order
// as Foundation's body_each_expr_child / body_each_stmt_child visit them.
// Every match below names each variant and has no wildcard arm, so a new
// node variant fails to compile here instead of being silently skipped; add
// it here in the order Body.jet's child visitors give it. A lambda body is
// walked under its own call-fact key (sema_effect_walk_lambda_children),
// which the generic visitors cannot do.
sema_effect_walk_expr_children: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, node: BodyNode) {
    if node.kind == {
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .Local(_) | .Unit | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) | .GlobalShared(_, _) | .InvariantViolation(_, _) | .Absent | .SelectStart | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) -> {}
        .StrLit(parts) -> {
            loop part in parts {
                if part == {
                    .Interpolation(value, _) -> {
                        sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
                    }
                    .Literal(_) -> {}
                }
            }
        }
        .InlineBlock(body) -> {
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .Call(_, _, args) -> {
            loop argument in args {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, argument.value)
            }
        }
        .IndirectCall(callee, _, args, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, callee)
            loop argument in args {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, argument.value)
            }
        }
        .MethodCall(receiver, _, _, args) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, receiver)
            loop argument in args {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, argument.value)
            }
        }
        .DistinctCtor(argument) | .DistinctConvert(_, argument, _, _, _) | .TraitBox(argument, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, argument)
        }
        .UnitConvert(argument, _, _, rounding, _, _, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, argument)
            if rounding == .Val(rounding_value) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, rounding_value.digits)
            }
        }
        .MathBuiltin(_, _, args) | .PreciseBuiltin(_, _, args) -> {
            loop value in args {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
            }
        }
        .Print(value) | .Drop(value) | .Close(value) | .Move(value) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
        }
        .RequireStop(kind, _, _) -> {
            sema_effect_walk_require_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, kind)
        }
        .Binary(_, _, _, lhs, rhs) -> {
            sema_effect_walk_binary(walk, nodes, facts, module_facts, diagnostics, caller, tree, lhs, rhs)
        }
        .CompareChain(operands, _, _) -> {
            loop value in operands {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
            }
        }
        .Unary(_, operand) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, operand)
        }
        .StructLit(fields) -> {
            loop field in fields {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, field.value)
            }
        }
        .Field(receiver, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, receiver)
        }
        .Index(base, index, _, _, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, base)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, index)
        }
        .Slice(base, start, end, range, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, base)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, start)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, end)
            if range == .Val(range_value) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, range_value)
            }
        }
        .Range(start, end, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, start)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, end)
        }
        .Tuple(values) | .List(values, _) -> {
            loop value in values {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
            }
        }
        .Map(entries) | .MapLit(entries) -> {
            loop entry in entries {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, entry.key)
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, entry.value)
            }
        }
        .EnumCtor(_, _, payload) | .EnumLit(_, _, payload) -> {
            if payload == {
                .Positional(args) -> {
                    loop argument in args {
                        sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, argument.value)
                    }
                }
                .Named(fields) -> {
                    loop field in fields {
                        sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, field.value.value)
                    }
                }
                .Unit -> {}
            }
        }
        .Present(value) | .Ok(value) | .Err(value) | .DistinctRaw(value) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
        }
        .Try(value, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
        }
        .TryWithContext(inner, note, _, _, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, inner)
            if note == .Val(note_value) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, note_value)
            }
        }
        .Lambda(value) -> {
            sema_effect_walk_lambda_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
        }
        .Borrow(place, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, place)
        }
        .RawAddressOf(place) -> {
            sema_effect_walk_place_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, place)
        }
        .RawOf(value) | .Deref(value) | .PtrFromAddr(value, _) | .LayoutLiteral(value) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
        }
        .LayoutCompare(_, lhs, rhs) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, lhs)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, rhs)
        }
        .SharedGuardValue(guard) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, guard)
        }
        .SharedGuardMap(guard, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, guard)
        }
        .SharedGuardSplit(guard, _, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, guard)
        }
        .SharedGuardWait(guard, condition, predicate) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, guard)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, condition)
            sema_effect_walk_lambda_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, predicate)
        }
        .ConditionNotify(condition, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, condition)
        }
        .HostCall(call) -> {
            sema_effect_walk_host_call_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, call)
        }
        .JSONLit(_, argument, _) -> {
            if argument == .Val(argument_value) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, argument_value)
            }
        }
        .AllocNew(_, args) -> {
            loop argument in args {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, argument.value)
            }
        }
        .ListLit(values) -> {
            loop value in values {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
            }
        }
        .ListSpread(parts) -> {
            loop part in parts {
                if part == {
                    .Element(value) | .Spread(value) -> {
                        sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
                    }
                }
            }
        }
        .PoolSlot(pool, id, _, _, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, pool)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, id)
        }
        .Clone(value, _) | .ExplicitCopy(value) | .MaterializeView(value) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
        }
        .StaticCall(_, _, _, _, args) -> {
            loop argument in args {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, argument.value)
            }
        }
        .DecodeUnder(segment, inner) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, segment)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, inner)
        }
        .BuiltinMethod(receiver, _, args) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, receiver)
            loop value in args {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
            }
        }
        .IfExpr(cond, then_body, then_value, else_body, else_value) -> {
            sema_effect_walk_if_cond_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, cond)
            guarded: sema_effect_guard_open(walk, nodes, tree, cond)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, then_body)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, then_value)
            if guarded -> sema_effect_guard_else(walk, nodes)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, else_body)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, else_value)
            if guarded -> sema_effect_guard_close(walk, nodes)
        }
        .OrFallback(value, fallback, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
            if fallback == {
                .Value(fallback_value) -> {
                    sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, fallback_value)
                }
                .Return(returned) -> {
                    if returned == .Val(returned_value) {
                        sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, returned_value)
                    }
                }
                .Panic(message, _) -> {
                    sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, message)
                }
                .Break | .Continue | .BreakLabel(_) | .ContinueLabel(_) -> {}
            }
        }
        .OptField(base, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, base)
        }
        .OptMethodCall(base, _, call, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, base)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, call)
        }
        .PatternMatches(subject, pattern) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, subject)
            sema_effect_walk_pattern_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, pattern.shape)
        }
        .OptionLift2(function, left, right) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, function)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, left)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, right)
        }
        .ClosureMethod(receiver, _, args) | .HandleMethod(receiver, _, args) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, receiver)
            loop value in args {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
            }
        }
        .NumericMethod(receiver, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, receiver)
        }
        .NumericBinaryMethod(receiver, _, argument) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, receiver)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, argument)
        }
        .OverflowOpt(_, _, _, lhs, rhs) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, lhs)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, rhs)
        }
        .CoreClosureCall(kind) -> {
            sema_effect_walk_core_closure_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, kind)
        }
        .TaskGroupAll(tasks) | .TaskGroupRace(tasks) | .TaskGroupAny(tasks) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, tasks)
        }
        .SelectRecv(builder, channel) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, builder)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, channel)
        }
        .SelectAfter(builder, duration, value) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, builder)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, duration)
            if value == .Val(selected) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, selected)
            }
        }
        .SelectWait(builder, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, builder)
        }
        .FnValue(kind) -> {
            if kind == {
                .NamedFn(_, lambda) -> {
                    if lambda == .Val(lambda_value) {
                        sema_effect_walk_lambda_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, lambda_value)
                    }
                }
                .Policy(_, policy_args, _, _, _, callee) -> {
                    loop argument in policy_args {
                        sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, argument.value)
                    }
                    sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, callee)
                }
                .Call(callee, args) -> {
                    sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, callee)
                    loop argument in args {
                        sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, argument.value)
                    }
                }
                .Send(value) -> {
                    sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
                }
            }
        }
    }
}

// body_each_stmt_child's children (see sema_effect_walk_expr_children).
sema_effect_walk_stmt_children: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, statement: StmtKind) {
    if statement == {
        .Contract(contract) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, contract.condition)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, contract.message)
        }
        .ContractScope(pre, body, post, _, _) -> {
            loop contract in pre {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, contract.condition)
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, contract.message)
            }
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
            loop contract in post {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, contract.condition)
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, contract.message)
            }
        }
        .Let(_, _, init, _, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, init)
        }
        .RefutableBind(pattern, init, fallback, _) -> {
            sema_effect_walk_pattern_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, pattern.shape)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, init)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, fallback)
        }
        .TupleDestructure(_, init, _, _, _) | .StructDestructure(_, init, _, _, _) | .ListDestructure(_, init, _, _, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, init)
        }
        .Assign(place, _, value, _, _) -> {
            sema_effect_walk_place_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, place)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
        }
        .Return(value, _) -> {
            if value == .Val(returned) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, returned)
            }
        }
        .ExprStmt(value, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
        }
        .TaskGroup(_, args, body, _) -> {
            if args.limit == .Val(limit_value) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, limit_value)
            }
            if args.stack == .Val(stack_value) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, stack_value)
            }
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .DeferClose(close, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, close)
        }
        // An else-if chain is one `If` per `else`, whose children are exactly
        // tree_else_children_into's order.
        .If(condition, then_body, else_body, _, _) -> {
            sema_effect_walk_if_cond_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, condition)
            guarded: sema_effect_guard_open(walk, nodes, tree, condition)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, then_body)
            if guarded -> sema_effect_guard_else(walk, nodes)
            if else_body == .Val(else_statements) {
                sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, else_statements)
            }
            if guarded -> sema_effect_guard_close(walk, nodes)
        }
        .Loop(_, body, _) -> {
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .While(_, condition, body, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, condition)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .CountedLoop(_, init, condition, step, _, body, _) -> {
            sema_effect_walk_stmt_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, tree.stmts[init])
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, condition)
            if step == .Val(step_statement) {
                sema_effect_walk_stmt_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, tree.stmts[step_statement])
            }
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .ForRange(_, _, start, end, step, _, body, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, start)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, end)
            if step == .Val(step_value) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, step_value)
            }
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .Range(_, _, source, start, end, step, _, _, body, _) -> {
            if source == .Val(source_value) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, source_value)
            }
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, start)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, end)
            if step == .Val(step_value) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, step_value)
            }
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .BreakValue(_, value, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
        }
        .Match(subject, arms, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, subject)
            sema_effect_walk_match_arm_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, arms)
        }
        .EnumMatch(scrutinee, arms, else_body, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, scrutinee)
            sema_effect_walk_match_arm_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, arms)
            if else_body == .Val(else_statements) {
                sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, else_statements)
            }
        }
        .RangeSwitch(subject, arms, else_body, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, subject)
            loop arm in arms {
                sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, arm.body)
            }
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, else_body)
        }
        .ForIn(_, _, _, source, collection, step, method_kind, _, _, _, body, span) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, source)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, collection)
            if method_kind == .Val(kind) {
                if kind == .Iterable(_, iter_type, iter_symbol, next_symbol, _, _) {
                    sema_effect_record_iterable_loop(walk, nodes, facts, iter_type, iter_symbol, next_symbol, span)
                }
            }
            if step == .Val(step_value) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, step_value)
            }
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .Inline(body, _) | .DebugOnly(body, _) | .DeepCheck(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .Defer(body, _) -> {
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .MixedSwitch(subject, _, arms, else_body, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, subject)
            loop arm in arms {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, arm.condition)
                sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, arm.body)
            }
            if else_body == .Val(else_statements) {
                sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, else_statements)
            }
        }
        .Unsafe(gate, body) -> {
            sema_effect_walk_unsafe_gate(walk, nodes, gate, None)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .UnsafeBlock(gate, body, span) -> {
            sema_effect_walk_unsafe_gate(walk, nodes, gate, Val(span))
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .SentryPolicy(_, body, _) -> {
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .Reactive(executable, _) -> {
            sema_effect_walk_lambda_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, executable)
        }
        .Layout(_, _, body, _) -> {
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .ContextBlock(guards, body, _) -> {
            loop guard in guards {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, guard.value)
            }
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .ScopeMember(kind, body, _) -> {
            if kind == {
                .Timeout(duration) -> {
                    sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, duration)
                }
                .Setup | .ExpectFail(_, _) | .Measure | .Skip -> {}
            }
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .Transact(_, _, _, body, _) -> {
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, body)
        }
        .GCEdit(_, _, _, _, index_temp, edited, _) -> {
            if index_temp == .Val(index_value) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, index_value)
            }
            sema_effect_walk_stmt_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, tree.stmts[edited])
        }
        .Break(_, _) | .Continue(_, _) -> {}
    }
}

sema_effect_walk_stmt_list_children: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, statements: [Int]) {
    loop statement in statements {
        sema_effect_walk_stmt_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, tree.stmts[statement])
    }
}

// Opens the guard of an `if` whose condition is the value of a compile-time
// site of a generic body (SemaEffectGuard) while the walk collects a node:
// the then arm's reads and instantiations hold where the site's value is
// true. JetIR builds only the arm the instance's value takes
// (ir_folded_type_test), so the other arm's reads need no row there. True
// when it opened one.
sema_effect_walk_collect_node: fn(walk: SemaEffectWalk) -> Int? Never! {
    if walk == {
        .Collect(node_index) | .TransactCollect(node_index) -> Val(node_index)
        .Unsafe(_) | .Region(_, _, _) | .LambdaBody(_) -> None
    }
}

sema_effect_guard_open: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], tree: BodyTree, condition: BodyIfCond) -> Bool {
    if sema_effect_walk_collect_node(walk) == .Val(node_index) && condition == .Plain(value) {
        if tree.nodes[body_node_index(tree, value)].kind == .TraitConst(owner, trait_name, name) && trait_name == COMPTIME_SITE_TRAIT {
            sema_effect_node_rare_open(nodes[node_index])
            if nodes[node_index].rare.in_place() == .Val(rare) {
                rare.guards.push(SemaEffectGuard{owner: owner, site: name, holds: true})
                return true
            }
        }
    }
    false
}

// Turns the innermost guard (sema_effect_guard_open) to its else arm.
sema_effect_guard_else: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode]) {
    if sema_effect_walk_collect_node(walk) == .Val(node_index) && nodes[node_index].rare.in_place() == .Val(rare) {
        rare.guards[rare.guards.len() - 1].holds = false
    }
}

// Closes the innermost guard (sema_effect_guard_open).
sema_effect_guard_close: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode]) {
    if sema_effect_walk_collect_node(walk) == .Val(node_index) && nodes[node_index].rare.in_place() == .Val(rare) {
        ^_: rare.guards.pop()
    }
}

sema_effect_walk_if_cond_children: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, condition: BodyIfCond) {
    if condition == {
        .Plain(value) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
        }
        .And(left, right) -> {
            sema_effect_walk_if_cond_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, left)
            sema_effect_walk_if_cond_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, right)
        }
        .IfLet(pattern, subject) -> {
            sema_effect_walk_pattern_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, pattern.shape)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, subject)
        }
    }
}

// Visit the canonical body_each_pattern_child nodes, including nested
// payloads and map keys, without materializing child lists.
sema_effect_walk_pattern_children: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, shape: BodyPatternShape) {
    if shape == {
        .Or(alternatives, _) -> {
            loop alternative in alternatives {
                sema_effect_walk_pattern_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, alternative)
            }
        }
        .Struct(fields, _) -> {
            loop field in fields {
                if field == {
                    .Value(_, value, _) -> {
                        sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
                    }
                    .Bind(_, _, _) -> {}
                    .Nested(_, inner, _) -> {
                        sema_effect_walk_pattern_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, inner.shape)
                    }
                }
            }
        }
        .Variant(_, slots, _, _) | .List(slots, _, _) -> {
            loop slot in slots {
                if slot == {
                    .Value(value) -> {
                        sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
                    }
                    .Nested(inner) -> {
                        sema_effect_walk_pattern_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, inner.shape)
                    }
                    .Wildcard | .Bind(_, _) | .Range(_, _) -> {}
                }
            }
        }
        .Present(_, _, inner, _) | .Ok(_, _, inner, _) | .Err(_, _, inner, _) -> {
            if inner == .Val(nested) {
                sema_effect_walk_pattern_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, nested.shape)
            }
        }
        .Map(entries, _, _) -> {
            loop entry in entries {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, entry.key)
                if entry.slot == {
                    .Value(value) -> {
                        sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
                    }
                    .Nested(inner) -> {
                        sema_effect_walk_pattern_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, inner.shape)
                    }
                    .Wildcard | .Bind(_, _) | .Range(_, _) -> {}
                }
            }
        }
        .Absent(_) | .Range(_, _, _) | .Text(_, _) | .Binary(_, _) -> {}
    }
}

sema_effect_walk_match_arm_children: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, arms: [BodyMatchArm]) {
    loop arm in arms {
        sema_effect_walk_pattern_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, arm.pattern.shape)
        sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, arm.body)
    }
}

// A checked lambda re-keys the call facts recorded in its body to
// `lambda@<start>` (Lambdas.jet), so a walk that descends into a closure
// executable (`scope.guard`, transaction hooks, spawn, reactive and UI
// callbacks, C callbacks) must look its calls up under that key. Under the
// enclosing function's key every such call has no fact and would read as an
// unknown callee (the maximal row). These bodies' effects belong to the
// enclosing function. A compiler-private loop carrier keeps the enclosing key,
// so the lambda key applies only when it owns facts.
sema_effect_walk_lambda_children: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, lambda: BodyLambda) {
    // A structure-only walk (FailureLaw) builds its index with no modules; its
    // lambda bodies keep the enclosing caller, as for a lambda that owns no facts.
    lambda_caller: sema_effect_caller_slot(facts, caller.module_index, "lambda@{lambda.source_span.start}")
    body_caller: SemaEffectCaller{module_index: caller.module_index, slot: if lambda_caller.slot >= 0 -> lambda_caller.slot else -> caller.slot}
    if lambda.executable == {
        .Expr(value) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, body_caller, tree, value)
        }
        .Block(body) -> {
            sema_effect_walk_stmt_list_children(walk, nodes, facts, module_facts, diagnostics, body_caller, tree, body)
        }
    }
}

sema_effect_walk_place_children: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, place: BodyPlace) {
    if place == {
        .Expr(value) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
        }
        .Local(_) -> {}
    }
}

sema_effect_walk_require_children: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, requirement: BodyRequireKind) {
    if requirement == {
        .Require(condition, message) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, condition)
            if message == .Val(message_value) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, message_value)
            }
        }
        .RequireEq(left, right, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, left)
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, right)
        }
        .Panic(message) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, message)
        }
    }
}

sema_effect_walk_host_call_children: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, call: BodyHostCall) {
    if call == {
        .Method(receiver, _, args) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, receiver)
            loop value in args {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
            }
        }
        .CellGuardProject(receiver, _, _, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, receiver)
        }
        .OptionProbe(inner, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, inner)
        }
        .TupleIndex(base, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, base)
        }
        .YieldSend(value) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, value)
        }
        .ComptimeInput(_, path, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, path)
        }
        .DebugTrace(write) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, write)
        }
        .ContextGet(_, default, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, default)
        }
        .SwitchSubjectValue | .NumericBounds(_, _) | .MemoStats(_, _) | .ContextRead(_) -> {}
    }
}

sema_effect_walk_core_closure_children: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], diagnostics: ^[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, kind: BodyCoreClosureKind) {
    if kind == {
        .Spawn(group, _, _, executable) -> {
            if group == .Val(group_value) {
                sema_effect_walk_visit(walk, nodes, facts, module_facts, diagnostics, caller, tree, group_value)
            }
            sema_effect_walk_lambda_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, executable)
        }
        .Guard(executable) -> {
            sema_effect_walk_lambda_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, executable)
        }
        .ReactiveDerived(executable) | .ReactiveEffect(executable) | .UIReactiveRender(executable) | .UIClickSlot(executable) | .UIDropSlot(executable) -> {
            sema_effect_walk_lambda_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, executable)
        }
        .OnCommit(_, executable) | .OnRollback(_, executable) -> {
            if walk == .TransactCollect(_) {
                // `tx.on_commit` and `tx.on_rollback` hooks run after the
                // transaction commits or rolls back, not as undoable calls
                // inside `#Transact`.
            } else {
                sema_effect_walk_lambda_children(walk, nodes, facts, module_facts, diagnostics, caller, tree, executable)
            }
        }
    }
}

// Whether `key` is a deferred job-enqueue boundary (`app.enqueue` /
// `app.__enqueue`), which hands work to the outbox rather than running it inline.
sema_effect_is_deferred_enqueue: fn(key: String) -> Bool Never! {
    symbol_key_names(key, "__enqueue") || symbol_key_names(key, "enqueue")
}

// Whether node `index` is repeatable: explicitly marked `#Repeatable` (trusted
// leaf, keyed, or checked) or bounded to `EffectAccess.Reads` across both its
// solved and declared effect rows without open dynamic dispatch.
sema_effect_node_is_repeatable: fn(nodes: [SemaEffectNode], inputs: [SemaEffectModuleInput], solved: [[String]], index: Int) -> Bool Never! {
    node: nodes[index]
    if node.rare == .Val(rare) && rare.repeatable != None -> return true
    if node.maximal -> return false
    library: inputs[node.module_index].library_effects
    if sema_effect_row_access(solved[index], library) != EffectAccess.Reads -> return false
    sema_effect_row_access(node.declared, library) == EffectAccess.Reads
}

// First unstable effect (`Rand` or `Time`) reached by a call inside a
// `#Repeatable(key: ...)` expression, or None when the key is stable.
SemaEffectUnstableKey: struct {
    effect_name: String,
    span: Span,
}

sema_effect_solved_unstable_key_effect: fn(effects: [String]) -> String? Never! {
    loop effect_name in effects {
        root: sema_effect_root(effect_scope_split(effect_name).base)
        if root == "Rand" || root == "Time" -> return Val(root)
    }
    None
}

sema_effect_node_unstable_key_effect: fn(nodes: [SemaEffectNode], solved: [[String]], caller_module: ModuleID, callee_name: String) -> String? Never! {
    loop (index, candidate) in nodes {
        if candidate.name != callee_name -> next
        if candidate.module_identity != caller_module && !module_is_core(candidate.module_identity) -> next
        if sema_effect_solved_unstable_key_effect(solved[index]) == .Val(found) -> return Val(found)
        if sema_effect_solved_unstable_key_effect(candidate.declared) == .Val(found) -> return Val(found)
    }
    None
}

sema_effect_key_expr_unstable_in_args: fn(args: [CallArg], nodes: [SemaEffectNode], solved: [[String]], caller_module: ModuleID) -> SemaEffectUnstableKey? Never! {
    loop arg in args {
        if sema_effect_key_expr_unstable(arg.expr, nodes, solved, caller_module) == .Val(found) {
            return Val(found)
        }
    }
    None
}

sema_effect_key_expr_unstable: fn(expr: Expr, nodes: [SemaEffectNode], solved: [[String]], caller_module: ModuleID) -> SemaEffectUnstableKey? Never! {
    if expr == {
        .Call(call, _) -> {
            if call.name == "random" || call.name.starts_with("rand_") || call.name == "uuid" {
                return Val(SemaEffectUnstableKey{effect_name: "Rand", span: call.name_span})
            }
            if call.name == "now" || call.name == "utc_now" || call.name == "monotonic" {
                return Val(SemaEffectUnstableKey{effect_name: "Time", span: call.name_span})
            }
            if sema_effect_node_unstable_key_effect(nodes, solved, caller_module, call.name) == .Val(found) {
                return Val(SemaEffectUnstableKey{effect_name: found, span: call.name_span})
            }
            sema_effect_key_expr_unstable_in_args(call.args, nodes, solved, caller_module)
        }
        .MethodCall(receiver, method, method_span, _, _, args, _) -> {
            if receiver == .Ident(alias, _, _) {
                if alias == "rand" || alias == "random" || method == "random" || method == "uuid" {
                    return Val(SemaEffectUnstableKey{effect_name: "Rand", span: method_span})
                }
                if alias == "time" && (method == "now" || method == "utc_now" || method == "monotonic" || method == "monotonic_ms" || method == "unix_seconds" || method == "unix_millis" || method == "unix_nanos") {
                    return Val(SemaEffectUnstableKey{effect_name: "Time", span: method_span})
                }
            }
            if sema_effect_node_unstable_key_effect(nodes, solved, caller_module, method) == .Val(found) {
                return Val(SemaEffectUnstableKey{effect_name: found, span: method_span})
            }
            if sema_effect_key_expr_unstable(receiver, nodes, solved, caller_module) == .Val(found) {
                return Val(found)
            }
            sema_effect_key_expr_unstable_in_args(args, nodes, solved, caller_module)
        }
        .OptMethodCall(receiver, method, method_span, _, args, _, _) -> {
            if sema_effect_node_unstable_key_effect(nodes, solved, caller_module, method) == .Val(found) {
                return Val(SemaEffectUnstableKey{effect_name: found, span: method_span})
            }
            if sema_effect_key_expr_unstable(receiver, nodes, solved, caller_module) == .Val(found) {
                return Val(found)
            }
            sema_effect_key_expr_unstable_in_args(args, nodes, solved, caller_module)
        }
        .CallValue(callee, args, _, _) -> {
            if sema_effect_key_expr_unstable(callee, nodes, solved, caller_module) == .Val(found) {
                return Val(found)
            }
            sema_effect_key_expr_unstable_in_args(args, nodes, solved, caller_module)
        }
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(inner, _) {
                    if sema_effect_key_expr_unstable(inner, nodes, solved, caller_module) == .Val(found) {
                        return Val(found)
                    }
                }
            }
            None
        }
        .Binary(_, left, right, _, _) -> {
            if sema_effect_key_expr_unstable(left, nodes, solved, caller_module) == .Val(found) {
                return Val(found)
            }
            sema_effect_key_expr_unstable(right, nodes, solved, caller_module)
        }
        .Unary(_, operand, _, _) | .Deref(operand, _, _) | .Copy(operand, _, _) | .Paren(operand, _, _) | .Try(operand, _, _, _, _) | .Present(operand, _, _) | .Ok(operand, _, _) | .Err(operand, _, _) | .Field(operand, _, _, _) | .OptField(operand, _, _, _, _, _) | .Spread(operand, _, _) -> {
            sema_effect_key_expr_unstable(operand, nodes, solved, caller_module)
        }
        .Index(base, idx, _, _, _) -> {
            if sema_effect_key_expr_unstable(base, nodes, solved, caller_module) == .Val(found) {
                return Val(found)
            }
            sema_effect_key_expr_unstable(idx, nodes, solved, caller_module)
        }
        .ListLit(elements, _, _) -> {
            loop element in elements {
                if sema_effect_key_expr_unstable(element, nodes, solved, caller_module) == .Val(found) {
                    return Val(found)
                }
            }
            None
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields {
                if sema_effect_key_expr_unstable(field.value, nodes, solved, caller_module) == .Val(found) {
                    return Val(found)
                }
            }
            None
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            loop field in fields {
                if sema_effect_key_expr_unstable(field.value, nodes, solved, caller_module) == .Val(found) {
                    return Val(found)
                }
            }
            None
        }
        .If(cond, _, then_val, _, else_val, _, _) -> {
            if sema_effect_key_expr_unstable(cond, nodes, solved, caller_module) == .Val(found) {
                return Val(found)
            }
            if sema_effect_key_expr_unstable(then_val, nodes, solved, caller_module) == .Val(found) {
                return Val(found)
            }
            sema_effect_key_expr_unstable(else_val, nodes, solved, caller_module)
        }
        .Pipe(head, steps, _, _) -> {
            if sema_effect_key_expr_unstable(head, nodes, solved, caller_module) == .Val(found) {
                return Val(found)
            }
            loop step in steps {
                if sema_effect_key_expr_unstable(step.value, nodes, solved, caller_module) == .Val(found) {
                    return Val(found)
                }
            }
            None
        }
        .OrFallback(value, _, _, _, _) | .MemberSpread(value, _, _, _) | .Tainted(value, _, _, _) | .RawOf(value, _, _) | .Place(value, _, _, _) -> {
            sema_effect_key_expr_unstable(value, nodes, solved, caller_module)
        }
        .Range(start, end, _, _, _) -> {
            if sema_effect_key_expr_unstable(start, nodes, solved, caller_module) == .Val(found) {
                return Val(found)
            }
            sema_effect_key_expr_unstable(end, nodes, solved, caller_module)
        }
        .Slice(base, start, end, _, _, _) -> {
            if sema_effect_key_expr_unstable(base, nodes, solved, caller_module) == .Val(found) {
                return Val(found)
            }
            if sema_effect_key_expr_unstable(start, nodes, solved, caller_module) == .Val(found) {
                return Val(found)
            }
            sema_effect_key_expr_unstable(end, nodes, solved, caller_module)
        }
        .CompareChain(operands, _, _, _, _) -> {
            loop operand in operands {
                if sema_effect_key_expr_unstable(operand, nodes, solved, caller_module) == .Val(found) {
                    return Val(found)
                }
            }
            None
        }
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                if sema_effect_key_expr_unstable(entry.key, nodes, solved, caller_module) == .Val(found) {
                    return Val(found)
                }
                if sema_effect_key_expr_unstable(entry.value, nodes, solved, caller_module) == .Val(found) {
                    return Val(found)
                }
            }
            None
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop arg in args {
                inner: if arg == {
                    .Positional(value) -> value
                    .Named(_, expr_value) -> expr_value
                }
                if sema_effect_key_expr_unstable(inner, nodes, solved, caller_module) == .Val(found) {
                    return Val(found)
                }
            }
            None
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Ident(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Lambda(_, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// Walks non-repeatable, non-deferred callees starting at `start` to find any
// direct irreversible effect, returning the first offending callee or effect
// name, or None when every reached irreversible effect is guarded.
sema_effect_find_unkeyed_irreversible: fn(nodes: [SemaEffectNode], inputs: [SemaEffectModuleInput], solved: [[String]], start: Int, seen: ^[Bool], visited: ^[Int]) -> String? Never! {
    if seen[start] -> return None
    seen[start] = true
    visited.push(start)
    node: nodes[start]
    loop effect_name in node.direct {
        if sema_effect_vocabulary_irreversible(effect_name) {
            return Val(if node.name != "" -> node.name else -> effect_name)
        }
    }
    ^has_guarded_callee: false
    loop target in node.call_targets {
        if target < 0 -> next
        if sema_effect_is_deferred_enqueue(nodes[target].key) || sema_effect_node_is_repeatable(nodes, inputs, solved, target) {
            has_guarded_callee = true
            next
        }
        if sema_effect_find_unkeyed_irreversible(nodes, inputs, solved, target, seen, visited) == .Val(found) {
            return Val(found)
        }
    }
    if !has_guarded_callee {
        loop effect_name in node.declared {
            if sema_effect_vocabulary_irreversible(effect_name) {
                return Val(if node.name != "" -> node.name else -> effect_name)
            }
        }
    }
    None
}

// Checks `#Repeatable` / `#Repeatable(key: ...)` (E0778, E0779) and retried
// `#App.Job` bodies (E0780) once every function's effect row has been solved.
sema_effect_check_repeatable_and_retries: fn(nodes: [SemaEffectNode], inputs: [SemaEffectModuleInput], node_by_key: SemaEffectNodeKeys, solved: [[String]], diagnostics: ^[Diagnostic]) {
    ^any_marked: false
    loop node in nodes {
        if node.rare == .Val(rare) && (rare.repeatable != None || rare.job_retry != None) {
            any_marked = true
            break
        }
    }
    if !any_marked -> return
    ^seen: (loop _ in nodes -> false)
    ^visited: [Int]{}
    loop node_index in 0..<nodes.len() {
        rare: nodes[node_index].rare ?? next
        node: nodes[node_index]
        ^node_diagnostics: [Diagnostic]{}
        if rare.repeatable == .Val(spec) {
            if spec.key_expr == .Val(key_expr) {
                if sema_effect_key_expr_unstable(key_expr, nodes, solved, node.module_identity) == .Val(unstable) {
                    node_diagnostics.push(
                        sema_error(
                            "E0779",
                            unstable.span,
                            "the `#Repeatable(key: ...)` key on `{node.name}` reaches `{unstable.effect_name}`, so retries would not produce the same key",
                            "an idempotency key deduplicates retries only when every try computes the same key from the call's parameters and constants; randomness or clock time changes on each retry",
                            "build `key:` from parameters and constants without calling `Rand` or `Time`",
                        ),
                    )
                }
            } else if !spec.has_reason {
                ^reported_bad: false
                if node.maximal {
                    node_diagnostics.push(
                        sema_error(
                            "E0778",
                            node.maximal_span ?? spec.span,
                            "`{node.name}` is marked `#Repeatable`, but calls a function value whose repeatability is not known",
                            "calling a `#Repeatable` function twice must leave kept data the same as calling it once, so every non-read call it reaches must be `#Repeatable`, keyed with `#Repeatable(key: ...)`, or deferred with `app.enqueue`",
                            "restrict the callback to read-only effects, supply a stable `#Repeatable(key: ...)` key, or remove `#Repeatable` from `{node.name}`",
                        ),
                    )
                    reported_bad = true
                }
                ^checked_targets: [Int]{}
                loop call in node.memory_calls {
                    if sema_effect_is_deferred_enqueue(call.callee) -> next
                    target: sema_effect_node_index(node_by_key, call.callee) ?? next
                    checked_targets.push(target)
                    if !sema_effect_node_is_repeatable(nodes, inputs, solved, target) {
                        callee_label: nodes[target].name
                        node_diagnostics.push(
                            sema_error(
                                "E0778",
                                call.span,
                                "`{node.name}` is marked `#Repeatable`, but calls `{callee_label}`, which is not repeatable",
                                "calling a `#Repeatable` function twice must leave kept data the same as calling it once, so every non-read call it reaches must be `#Repeatable`, keyed with `#Repeatable(key: ...)`, or deferred with `app.enqueue`",
                                "mark `{callee_label}` as `#Repeatable` when safe, supply a stable `#Repeatable(key: ...)` key, defer the call with `app.enqueue`, or remove `#Repeatable` from `{node.name}`",
                            ),
                        )
                        reported_bad = true
                    }
                }
                loop target in node.call_targets {
                    if target < 0 || checked_targets.contains(target) -> next
                    if sema_effect_is_deferred_enqueue(nodes[target].key) -> next
                    if !sema_effect_node_is_repeatable(nodes, inputs, solved, target) {
                        callee_label: nodes[target].name
                        node_diagnostics.push(
                            sema_error(
                                "E0778",
                                spec.span,
                                "`{node.name}` is marked `#Repeatable`, but calls `{callee_label}`, which is not repeatable",
                                "calling a `#Repeatable` function twice must leave kept data the same as calling it once, so every non-read call it reaches must be `#Repeatable`, keyed with `#Repeatable(key: ...)`, or deferred with `app.enqueue`",
                                "mark `{callee_label}` as `#Repeatable` when safe, supply a stable `#Repeatable(key: ...)` key, defer the call with `app.enqueue`, or remove `#Repeatable` from `{node.name}`",
                            ),
                        )
                        reported_bad = true
                    }
                }
                if !reported_bad {
                    loop site in node.direct_spans {
                        if sema_effect_access(site.name, inputs[node.module_index].library_effects) != EffectAccess.Reads {
                            node_diagnostics.push(
                                sema_error(
                                    "E0778",
                                    site.span,
                                    "`{node.name}` is marked `#Repeatable`, but directly performs `{site.name}`, which is not repeatable",
                                    "calling a `#Repeatable` function twice must leave kept data the same as calling it once, so a leaf primitive must audit its promise with `#Repeatable(\"reason\")` or supply a stable `#Repeatable(key: ...)` key",
                                    "audit this leaf with `#Repeatable(\"reason\")`, supply a stable `#Repeatable(key: ...)` key, or remove `#Repeatable` from `{node.name}`",
                                ),
                            )
                            break
                        }
                    }
                }
            }
        }
        if rare.job_retry == .Val(job) && job.retries > 0 && !job.at_least_once {
            if !sema_effect_node_is_repeatable(nodes, inputs, solved, node_index) {
                ^reported_retry: false
                loop call in node.memory_calls {
                    if sema_effect_is_deferred_enqueue(call.callee) -> next
                    target: sema_effect_node_index(node_by_key, call.callee) ?? next
                    if sema_effect_node_is_repeatable(nodes, inputs, solved, target) -> next
                    found: sema_effect_find_unkeyed_irreversible(nodes, inputs, solved, target, seen, visited)
                    loop row in visited -> seen[row] = false
                    visited = [Int]{}
                    if found == .Val(offender) {
                        node_diagnostics.push(
                            sema_error(
                                "E0780",
                                call.span,
                                "retried job `{node.name}` reaches irreversible `{offender}` without `#Repeatable`, an idempotency key, or `at_least_once: true`",
                                "when a retried job fails and runs again, an irreversible call that is neither repeatable nor keyed will run more than once and leave duplicate external side effects",
                                "wrap the call in a `#Repeatable(key: ...)` operation, defer it with `app.enqueue`, set `retries: 0`, or mark the job `#App.Job(at_least_once: true)` if duplicate delivery is acceptable",
                            ),
                        )
                        reported_retry = true
                        break
                    }
                }
                if !reported_retry {
                    loop target in node.call_targets {
                        if target < 0 || sema_effect_is_deferred_enqueue(nodes[target].key) -> next
                        if sema_effect_node_is_repeatable(nodes, inputs, solved, target) -> next
                        found: sema_effect_find_unkeyed_irreversible(nodes, inputs, solved, target, seen, visited)
                        loop row in visited -> seen[row] = false
                        visited = [Int]{}
                        if found == .Val(offender) {
                            node_diagnostics.push(
                                sema_error(
                                    "E0780",
                                    job.span,
                                    "retried job `{node.name}` reaches irreversible `{offender}` without `#Repeatable`, an idempotency key, or `at_least_once: true`",
                                    "when a retried job fails and runs again, an irreversible call that is neither repeatable nor keyed will run more than once and leave duplicate external side effects",
                                    "wrap the call in a `#Repeatable(key: ...)` operation, defer it with `app.enqueue`, set `retries: 0`, or mark the job `#App.Job(at_least_once: true)` if duplicate delivery is acceptable",
                                ),
                            )
                            reported_retry = true
                            break
                        }
                    }
                }
                if !reported_retry {
                    loop site in node.direct_spans {
                        if sema_effect_vocabulary_irreversible(site.name) {
                            node_diagnostics.push(
                                sema_error(
                                    "E0780",
                                    site.span,
                                    "retried job `{node.name}` reaches irreversible `{site.name}` without `#Repeatable`, an idempotency key, or `at_least_once: true`",
                                    "when a retried job fails and runs again, an irreversible call that is neither repeatable nor keyed will run more than once and leave duplicate external side effects",
                                    "wrap the call in a `#Repeatable(key: ...)` operation, defer it with `app.enqueue`, set `retries: 0`, or mark the job `#App.Job(at_least_once: true)` if duplicate delivery is acceptable",
                                ),
                            )
                            break
                        }
                    }
                }
            }
        }
        if node_diagnostics.len() > 0 {
            sema_effect_publish_diagnostics(diagnostics, inputs[node.module_index].source_segments, node_diagnostics)
        }
    }
}

