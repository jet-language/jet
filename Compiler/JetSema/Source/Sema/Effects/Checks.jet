// The functions `node` takes as values, the value edges of `node_index`: a
// named function read, a named function value, and every implementation the
// program holds of a method called through a trait value (the value may be
// any of them).
sema_effect_record_value_reads: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, tree: BodyTree, expression: Int, node: BodyNode) Never! {
    if node.kind == {
        .ConstRef(symbol) -> {
            if type_kind(facts.interner, body_type_id(tree, expression)) == TypeKind.Fn {
                sema_effect_node_add_value_edge(nodes, facts.node_by_key, node_index, symbol_key(facts.symbols, tree.symbols, symbol))
            }
        }
        .FnValue(kind) -> {
            if kind == .NamedFn(function, _) {
                if function == .Val(decl) {
                    target: sema_effect_decl_node(facts, decl)
                    if target >= 0 {
                        sema_effect_node_rare_open(nodes[node_index])
                        if nodes[node_index].rare.in_place() == .Val(rare) {
                            sema_effect_set_add(rare.value_edges, facts.node_keys[target])
                        }
                    }
                }
            }
        }
        .MethodCall(receiver, method, _, _) -> {
            trait_owner: method.trait_owner ?? return
            if type_kind(facts.interner, body_type_id(tree, receiver)) == TypeKind.TraitObject {
                method_row: sema_effect_method_row(facts.impls, symbol_key(facts.symbols, tree.symbols, trait_owner), method.name)
                if method_row >= 0 {
                    loop owner in facts.impls.implementers[facts.impls.method_traits[method_row]] {
                        if sema_effect_trait_impl_of(facts.impls, method_row, owner) == .Val(impl_key) {
                            sema_effect_node_add_value_edge(nodes, facts.node_by_key, node_index, impl_key)
                        }
                    }
                }
            }
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
    }
