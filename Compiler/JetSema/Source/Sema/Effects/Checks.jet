// Effect rows and checked unsafe-boundary facts.
//
// The effect graph is a semantic projection over checked bodies and the call facts already
// recorded by Sema.  It does not resolve names, own a second scope table, or
// infer a new type relation.  Direct rows are collected from checked calls and
// panic sentinels, then one fixed-point solver projects the same solved row back
// onto every FnBody.
//
// Effect names are canonical dotted paths.  The roots are closed; descendants
// below a known root are open declaration leaves.  Panic and Mem are retained
// for denial/reachability facts but are deny-only and never become positive
// grants.
use jet_foundation.[
    EFFECT_VOCABULARY_ROOTS,
    EFFECT_VOCABULARY_ROWS,
    MARKER_MEMO,
    authority_grantable_roots,
    authority_is_deny_only,
    BodyCallArg,
    BodyContract,
    BodyCoreClosureKind,
    BodyHostCall,
    BodyIfCond,
    BodyLambda,
    BodyMatchArm,
    BodyNode,
    BodyPatternShape,
    BodyPlace,
    BodyRequireKind,
    BodyTree,
    CompilerThreads,
    DeclID,
    DeclTable,
    decl_table_find,
    Diagnostic,
    diagnostic_registry_row,
    Effect,
    EffectRowEntry,
    effect_scope_argument_valid,
    effect_scope_covers,
    effect_scope_descriptor,
    effect_scope_is_scoped,
    effect_scope_name,
    effect_scope_of_argument,
    effect_scope_published_effect,
    effect_scope_split,
    FnBody,
    Func,
    SharedLifetime,
    FunctionDefaultRef,
    Item,
    NamedSpan,
    ModuleCap,
    NameRows,
    name_rows,
    name_rows_get_text,
    name_rows_set,
    NodeKind,
    Span,
    Stmt,
    StmtKind,
    SymbolKind,
    TEffectFacts,
    TEffectSpan,
    TFailureCarrier,
    TFuncKind,
    Type,
    compiler_take_rows,
    compiler_threads_admit,
    compiler_threads_failure_text,
    compiler_threads_partition,
    compiler_transfer_rows,
    CoreCallRecord,
    diagnostic_with_label,
    diagnostic_with_rights,
    body_node,
    body_type,
    diagnostic_with_source_derived_suggestion,
    sema_effect_covers,
    symbol_id,
    type_name,
]

SemaEffectFunctionSource: struct {
    key: String
    name: String
    span: Span
    // The function's name, where trait-bound reports (E0742) point.
    name_span: Span?{None}
    declared_effects: [EffectRowEntry]?
    is_pure: Bool
    is_replayable: Bool
    is_unsafe: Bool
    unsafe_reason: String?
    unsafe_span: Span?
    replayable_span: Span?
    effect_via: NamedSpan?
    // The body's `#FX(…)` regions with valid cap lists (E0712).
    fx_regions: [SemaEffectFxRegion]{[SemaEffectFxRegion]{}}
    // Loop statement spans; memory work inside one has no
    // static execution count.
    loop_spans: [Span]{[Span]{}}
    // `assume_deterministic` blocks suspend E3403.
    assume_det_spans: [Span]{[Span]{}}
    // The first `#Memo` marker of a non-comptime function (E0938).
    memo_span: Span?{None}
    // A top-level `#Kernel(.parallel)` whose declaration obligations hold
    // (sema_kernel_pending): E1102 judges its effect and body obligations.
    kernel: SemaKernelPending?{None}
    // The `#FX(…)` caps of the modules enclosing this function (E0749).
    module_caps: [ModuleCap]{[ModuleCap]{}}
    // The `#FX(…)` cap of the struct or enum this method belongs to (E0749).
    type_cap: SemaEffectModuleCap?{None}
    // The trait this impl method implements, `{module}|{trait}`
    // (sema_effect_trait_cap_key), resolved where its `impl` block is
    // written; "" for any other function (E0754).
    trait_key: String{""}
}

// One `#FX(…)` region: its parsed caps, the head span E0712 points at, and
// the block span its `TStmt.Region` lowering keeps.
SemaEffectFxRegion: struct {
    caps: [String]
    caps_span: Span
    span: Span
}

// One checked module's effect inputs. The module's functions and call facts
// are read in place from `modules[module_index]` (sema_effects_check_modules).
SemaEffectModuleInput: struct {
    module_index: Int
    sources: [SemaEffectFunctionSource]
    source_segments: [SemaSourceSegment]
    // This rule trait-method effect ceilings this module declares (E0742).
    trait_bounds: [SemaEffectTraitBound]{[SemaEffectTraitBound]{}}
    // `{trait}::{owner}` implementations this module declares
    // (sema_effect_trait_implementers), for generic dispatch.
    trait_implementers: [String]{[String]{}}
    // The owned trait each method of an `impl Owner.Add` or `impl
    // Owner.CheckedText` block implements, by function key: the trait has no
    // source row, so the checked body is a plain method (E0742 still bounds it).
    owned_trait_hooks: [String:String]{[String:String]{}}
    // The library effect names this module may write (sema_library_effect_view).
    library_effects: [SemaLibraryEffectName]{[SemaLibraryEffectName]{}}
}

SemaEffectDispatchSite: struct {
    dispatch: TEffectSpan
    module_index: Int
}

// One bounded trait method: an impl of `trait_name.method` may use only the
// effects in `bound` (`-[]>` is the empty bound).
SemaEffectTraitBound: struct {
    trait_name: String
    method: String
    bound: [String]
}

SemaEffectGraphResult: struct {
    diagnostics: [Diagnostic]
    complete: Bool
    memory_declarations: [SemaMemoryFactDeclaration]{[SemaMemoryFactDeclaration]{}}
    memory_projections: [SemaMemoryProjectionRow]{[SemaMemoryProjectionRow]{}}
}

// One memory operation a body performs directly (Rust `MemoryEvent`): `kind`
// is "alloc", "rc" or "arena"; an arena event's `bytes` is its proven upper
// bound (None is unprovable); `executions` is None inside a loop.
SemaMemoryEvent: struct {
    span: Span
    operation: String
    kind: String{"alloc"}
    bytes: Int?{None}
    executions: Int?{Val(1)}
}

// A call site to a user function, for arena multiplicity (Rust `MemoryCall`).
SemaMemoryCall: struct {
    callee: String
    span: Span
    executions: Int?
}

// A place a strict memory fact cannot see through (Rust `OpenMemoryDispatch`).
SemaMemoryOpen: struct {
    span: Span
    source: String
    reason: String
}

// The first violation on a path: an event (in node `owner`) or an open
// dispatch, and the arena bytes used up to it.
SemaMemoryFinding: struct {
    event: SemaMemoryEvent?
    owner: Int
    open: SemaMemoryOpen?
    path: [String]
    used: Int
}

// Rust `ArenaProof`, or the finding that stops the proof.
SemaMemoryArena: struct {
    bytes: Int
    witness: SemaMemoryFinding?
    failure: SemaMemoryFinding?
}

sema_effect_is_fixed_list: fn(ty: Type) -> Bool Never! {
    if ty == {
        .FixedList(_, _) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_effect_source_display: fn(path: String) -> String Never! {
    parts: path.split("/").to_list()
    if parts.len() == 0 -> path else -> parts[parts.len() - 1]
}

// A named function value in a slot with a closed effect row: the value took
// the slot's row (sema_function_value_type), so `callee`'s own row is held
// to `bound` and kept clear of `denied` once every row is solved (E0747 at
// `span`).
SemaEffectCallbackBound: struct {
    callee: String
    row: SemaEffectCallbackRow
    span: Span
}

// A closed callback row: the effects it allows and the ones it denies
// (`fn(Int) -[IO, !Panic]> Int` allows IO and denies Panic).
SemaEffectCallbackRow: struct {
    bound: [String]
    denied: [String]
}

// A lambda in a slot with a closed effect row: the lambda's own row, its call
// facts and what its body walk charges, held to the slot's row once every row
// is solved (E0747 at `span`).
SemaEffectLambdaBound: struct {
    direct: [String]
    call_edges: [String]
    maximal: Bool
    row: SemaEffectCallbackRow
    span: Span
}

// A call through a type parameter's trait bound (`self.inner.work()` with
// `inner: T`, `T: Worker`). Which implementation runs is fixed where the
// instantiation is written, so the call's effects belong to the caller that
// binds `param`, not to this function's own row.
SemaEffectParamDispatch: struct {
    param: String
    // `{trait module}|{trait}::{method}`, the `trait_impls` key prefix.
    impls_key: String
}

// A call into a generic function or a generic type's method, with the type
// arguments it binds: the owner type's, then the function's own.
SemaEffectInstantiation: struct {
    callee: String
    owner_args: [Type]
    type_args: [Type]
    // `Traced<Loud>` or `apply<Loud>`: the instantiation a report names.
    label: String
    span: Span
}

// An implementation a caller runs through an instantiation it writes.
SemaEffectInstanceReach: struct {
    label: String
    target: String
    span: Span
}

// An instance reach with its target's solved row, for reports.
SemaEffectInstanceNote: struct {
    label: String
    callee: String
    row: [String]
    span: Span
}

SemaEffectNode: struct {
    key: String
    name: String
    module_identity: String
    module_index: Int
    span: Span
    name_span: Span
    direct: [String]
    direct_spans: [TEffectSpan]
    call_edges: [String]
    maximal: Bool
    maximal_span: Span?
    declared: [String]
    prohibited: [String]
    has_declared_row: Bool
    is_pure: Bool
    is_replayable: Bool
    replayable_span: Span?
    is_unsafe: Bool
    unsafe_reason: String?
    unsafe_span: Span?
    effect_via: NamedSpan?
    // Calls through a trait value with no bound: the trait method declares
    // no row, the trait has no `#FX(…)` ceiling, and the program's
    // implementations can't be summed. A ceiling above them is E0743.
    dispatches: [TEffectSpan]
    // The functions this body takes as values (TEffectFacts.value_edges).
    value_edges: [String]{[String]{}}
    // The module state this body writes (TEffectFacts.module_writes).
    module_writes: [TEffectSpan]{[TEffectSpan]{}}
    // The comptime inputs this body makes (`embed_file`, `embed_bytes`,
    // `find`, `net.fetch`), by name and call span: the compiler answers them
    // while compiling only (sema_effect_runtime_input_paths).
    comptime_inputs: [TEffectSpan]{[TEffectSpan]{}}
    // The memory operations this body performs directly
    // and the `-[!Mem.*]>` denials its signature declares (E0921).
    memory_events: [SemaMemoryEvent]{[SemaMemoryEvent]{}}
    memory_denials: [EffectRowEntry]{[EffectRowEntry]{}}
    // User-function call sites and loop spans for arena multiplicity.
    memory_calls: [SemaMemoryCall]{[SemaMemoryCall]{}}
    memory_opens: [SemaMemoryOpen]{[SemaMemoryOpen]{}}
    loop_spans: [Span]{[Span]{}}
    assume_det_spans: [Span]{[Span]{}}
    // This pure body made a non-deterministic Core call (E3403 reported).
    nondeterministic_call: Bool{false}
    memo_span: Span?{None}
    kernel: SemaKernelPending?{None}
    // `module::name` in call paths and the source file name in reports.
    display_key: String{""}
    source_display: String{""}
    // The Rust effect key (`name`, or `Owner::name` for a method): the
    // name a denial's call chain shows for this function.
    chain_name: String{""}
    // The first entry of the declared effect row (E0740's span) and its first
    // `!` prohibition (E0749's span).
    row_span: Span?{None}
    prohibition_span: Span?{None}
    // The `#FX(…)` caps of the inline modules enclosing this function.
    module_caps: [ModuleCap]{[ModuleCap]{}}
    // The `#FX(…)` cap of the struct or enum this method belongs to.
    type_cap: SemaEffectModuleCap?{None}
    // `{module}|{trait}` of the trait this method implements
    // (sema_effect_trait_cap_key), "" for any other function.
    trait_key: String{""}
    // The bounded callback slots this body fills with named functions and
    // with lambdas.
    callback_bounds: [SemaEffectCallbackBound]{[SemaEffectCallbackBound]{}}
    lambda_bounds: [SemaEffectLambdaBound]{[SemaEffectLambdaBound]{}}
    // This function's type parameters, its owner type's first, and the
    // owner type's parameters in the order its type arguments bind them.
    type_params: [String]{[String]{}}
    owner_params: [String]{[String]{}}
    // Calls through a type parameter; once sema_effect_resolve_type_params
    // has run, also those a call forwards from a callee's parameters.
    param_dispatches: [SemaEffectParamDispatch]{[SemaEffectParamDispatch]{}}
    // Calls that bind type parameters, and what they reach through them.
    instantiations: [SemaEffectInstantiation]{[SemaEffectInstantiation]{}}
    instance_reaches: [SemaEffectInstanceReach]{[SemaEffectInstanceReach]{}}
    // The library effects its declared row names, each with the kernel
    // effects it lists (E0756), and those its row denies (E0749).
    library_rows: [SemaLibraryEffectName]{[SemaLibraryEffectName]{}}
    library_denials: [SemaLibraryEffectDenial]{[SemaLibraryEffectDenial]{}}
    // Calls to a Core scope publisher with a constant argument
    // (effect_scope_published_effect): the callee's bare effect reaches this
    // body as the scoped one. A publisher it also calls with a run-time
    // argument is in `bare_scope_callees`, and reaches it bare as well.
    scoped_calls: [SemaEffectScopedCall]{[SemaEffectScopedCall]{}}
    bare_scope_callees: [String]{[String]{}}
    // Whether the first parameter is `path`, as a Core scope publisher's is.
    path_first: Bool{false}
}

SemaEffectScopedCall: struct {
    callee: String
    published: String
    scoped: String
}

sema_effect_source_from_function: fn(func: Func, module_identity: String) -> SemaEffectFunctionSource Never! {
    SemaEffectFunctionSource{
        key: symbol_id(SymbolKind.Function, module_identity, "", func.name).key,
        name: func.name,
        span: func.span,
        name_span: Val(func.name_span),
        declared_effects: func.declared_effects,
        is_pure: func.is_pure,
        is_replayable: func.is_replayable,
        is_unsafe: func.is_unsafe,
        unsafe_reason: func.unsafe_reason,
        unsafe_span: func.unsafe_span,
        replayable_span: func.replayable_span,
        effect_via: func.effect_via,
        fx_regions: sema_authority_fx_regions(func.body),
        loop_spans: sema_effect_statement_spans(func.body, false),
        assume_det_spans: sema_effect_statement_spans(func.body, true),
        memo_span: sema_effect_memo_span(func),
        module_caps: func.module_caps,
    }
}

// Rust `check_inferred_purity`: a comptime callable takes the purity path,
// so only an ordinary function's first `#Memo` marker is judged by E0938.
sema_effect_memo_span: fn(func: Func) -> Span? Never! {
    if func.is_comptime -> return None
    loop marker in func.markers {
        if marker.name == MARKER_MEMO -> return Val(marker.span)
    }
    None
}

// The subject an E0938 report names: a function by its name, and a `#Memo`
// computed field's helper (Derives.jet sema_computed_field_memo_helper) by its
// field, as the helper is that field's formula.
sema_effect_memo_subject: fn(name: String) -> String Never! {
    parts: name.split("__computed_").to_list()
    if parts.len() == 2 && parts[1].ends_with("__memo") -> return "the formula of field `{parts[1].slice(0, parts[1].len() - 6)}`"
    "`{name}`"
}

// The spans of the body's loop statements, or of its `assume_deterministic`
// blocks when `assume_det` is set.
sema_effect_statement_spans: fn(statements: [Stmt], assume_det: Bool) -> [Span] {
    spans := [Span]{}
    sema_effect_collect_statement_spans(statements, assume_det, spans)
    spans
}

sema_effect_collect_statement_spans: fn(statements: [Stmt], assume_det: Bool, spans: &[Span]) {
    loop statement in statements {
        if statement == {
            .While(_, body, span, _, _) | .For(_, _, _, _, body, span, _, _, _) | .Loop(body, span, _, _) | .CountedLoop(_, _, _, body, span, _, _) -> {
                if !assume_det -> spans.push(span.copy())
                sema_effect_collect_statement_spans(body, assume_det, spans)
            }
            .AssumeDet(_, _, body, span) -> {
                if assume_det -> spans.push(span.copy())
                sema_effect_collect_statement_spans(body, assume_det, spans)
            }
            .Unsafe(_, _, body, _)
            | .Impure(_, _, body, _)
            | .Reactive(body, _)
            | .Shield(body, _)
            | .Switched(_, body, _)
            | .Region(_, _, body, _)
            | .Policy(_, body, _)
            | .TaskGroup(_, _, _, body, _)
            | .Layout(_, _, body, _)
            | .AuthorityScope(_, _, _, body, _)
            | .ContextBlock(_, body, _)
            | .Live(body, _)
            | .Transact(_, _, body, _, _)
            | .ScopeMember(_, _, _, _, body, _, _, _) -> sema_effect_collect_statement_spans(body, assume_det, spans)
            .Switch(_, arms, else_body, _) -> {
                loop arm in arms -> sema_effect_collect_statement_spans(arm.body, assume_det, spans)
                if else_body == .Val(body) -> sema_effect_collect_statement_spans(body, assume_det, spans)
            }
            .ComptimeIf(_, _, then_body, else_body, _, _) -> {
                sema_effect_collect_statement_spans(then_body, assume_det, spans)
                if else_body == .Val(body) -> sema_effect_collect_statement_spans(body, assume_det, spans)
            }
            .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .Yield(_, _) | .DeferClose(_, _) -> {}
        }
    }
}

// E2-M16 (Rust core-call E3403): a non-deterministic Core call (a `Time` or
// `Rand` row) inside a pure function, outside `assume_deterministic`. The call
// is a fixed Core row or a source-owned Core function.
// The module identity of a direct call's callee body, or "" when the call
// has no body node in this program.
sema_effect_callee_module: fn(nodes: [SemaEffectNode], facts: SemaEffectCallIndex, expression: BodyNode) -> String Never! {
    if expression.kind == .Call(callee, _, _) {
        decl_row: callee.row.index()
        target: if decl_row >= 0 && decl_row < facts.node_by_decl.len() -> facts.node_by_decl[decl_row] else -> -1
        if target >= 0 && target < nodes.len() -> return nodes[target].module_identity
    }
    ""
}

sema_effect_nondeterministic_core: fn(node: SemaEffectNode, expression: BodyNode, fact: SemaCallSiteFact, callee_module: String) -> String? {
    if !node.is_pure -> return None
    api := ""
    if expression.kind == .Call(_, _, _) {
        // A source-owned Core function, or a Core function with no body in
        // this program; any other callee reports through its own effects.
        if callee_module != "" && !callee_module.starts_with("<corelib>/") -> return None
        callee: fact.callee ?? return None
        api = sema_effect_decl_label(callee.key)
    } else if expression.kind == .CoreCall(record, _, _, _, _, _) {
        api = sema_effect_member_label(record.module_name, record.member)
    }
    if api == "" -> return None
    row: fact.facts.effect_bound ?? return None
    if sema_effect_in_assume_det(node, expression.span) -> return None
    loop entry in row {
        if entry.name.starts_with("!") -> next
        root: sema_effect_root(entry.name)
        if root == "Time" || root == "Rand" -> return Val(api)
    }
    None
}

// Rust `assume_deterministic { … }` (Stmt::AssumeDet, det_suppress):
// inside a pure body the block suspends the determinism rejections, E3403 and
// E3401 alike.
sema_effect_in_assume_det: fn(node: SemaEffectNode, span: Span) -> Bool Never! {
    if !node.is_pure -> return false
    loop region in node.assume_det_spans {
        if sema_effect_span_contains(region, span) -> return true
    }
    false
}

// Rust `crate::Sema::e3403` at a Clock intrinsic site
// (record_static_time_effect and the `Clock.{method}` check, `Clock
// comparison`, `Clock formatting` and `Clock copy`) or an `ExpiringSecret.with`
// expiry read: the producer recorded a `Time` row under the operation's own
// name (`Clock.system`), so a pure body reports E3403 with the pure denial and
// records none of the site's effects. False when the site is not one.
sema_effect_report_nondeterministic_intrinsic: fn(nodes: &[SemaEffectNode], node_index: Int, fact: SemaCallSiteFact, span: Span, diagnostics: &[Diagnostic]) -> Bool Never! {
    if !nodes[node_index].is_pure || fact.callee != None -> return false
    api: fact.intrinsic_api ?? return false
    if !api.starts_with("Clock.") && !api.starts_with("Clock ") && api != "ExpiringSecret.with" -> return false
    row: fact.facts.effect_bound ?? return false
    if sema_effect_in_assume_det(nodes[node_index], span) -> return false
    loop entry in row {
        if entry.name.starts_with("!") || sema_effect_root(entry.name) != "Time" -> next
        nodes[node_index].nondeterministic_call = true
        // A wrapper node at the site's own span reports once.
        loop previous in diagnostics {
            if previous.code == "E3403" && previous.span == span -> return true
        }
        diagnostic: sema_error("E3403", span, "`{api}` is non-deterministic and cannot appear in a pure evaluation.", "Pure evaluation must produce the same result on every machine.", "remove this call, or remove the enclosing function's explicit empty effect bound.")
        diagnostics.push(diagnostic_with_rights(diagnostic, "pure", [String]{api.copy()}, [String]{}, None))
        return true
    }
    false
}

// A compile-time value's call site `fact` whose callee reads ambient time or
// randomness is refused by the API it calls (E3403), before evaluation
// reaches the host clock or random source. An intrinsic (`time.now`) has no
// declared callee and is named by its API.
sema_effect_comptime_nondeterministic: fn(fact: SemaCallSiteFact, diagnostics: &[Diagnostic]) {
    api: if fact.callee == .Val(callee) -> sema_effect_decl_label(callee.key) else -> fact.intrinsic_api ?? return
    row: fact.facts.effect_bound ?? return
    loop entry in row {
        if entry.name.starts_with("!") -> next
        root: sema_effect_root(entry.name)
        if root == "Time" || root == "Rand" {
            diagnostic: sema_error("E3403", fact.span, "`{api}` is non-deterministic and cannot appear in a pure evaluation.", "Pure evaluation must produce the same result on every machine.", "remove this call, or keep it at runtime outside the `comptime` value.")
            diagnostics.push(diagnostic_with_rights(diagnostic, "pure", [String]{api}, [String]{}, None))
            return
        }
    }
}

// A compile-time value's call into `core.net` that reaches the network: only
// the pinned `net.fetch(url, sha256:)` is a compile-time network operation,
// so any other callee whose effect row carries `Net` is refused (E3412). A
// pure `core.net` helper (`mime.extension`) has no `Net` and evaluates. True
// when it was refused.
sema_effect_comptime_net_unavailable: fn(fact: SemaCallSiteFact, diagnostics: &[Diagnostic]) -> Bool {
    callee: fact.callee ?? return false
    owner: sema_effect_symbol_module(callee.key) ?? return false
    if owner != "<corelib>/core.net" && !owner.starts_with("<corelib>/core.net.") -> return false
    method: sema_effect_symbol_leaf(callee.key)
    if method == "fetch" -> return false
    row: fact.facts.effect_bound ?? return false
    reaches_net := false
    loop entry in row {
        if !entry.name.starts_with("!") && sema_effect_root(entry.name) == "Net" {
            reaches_net = true
            break
        }
    }
    if !reaches_net -> return false
    diagnostics.push(sema_error("E3412", fact.span, "`core.net.{method}()` is not available at comptime.", "Only `core.net.fetch(url, sha256:)` is supported at compile time as a Tier-1 hermetic effect.", "Use `core.net.fetch(url, sha256: \"…\")` for content-hash-pinned downloads."))
    true
}

// The call a compile-time value's refused host effect is named by (E3410,
// E3411): the first of its call sites `facts` whose callee's effect row
// carries an effect (sema_effect_comptime_callee_name); None when no call
// carries one.
sema_effect_comptime_call_name: fn(facts: [SemaCallSiteFact]) -> String? Never! {
    loop fact in facts {
        callee: fact.callee ?? next
        row: fact.facts.effect_bound ?? next
        loop entry in row {
            if entry.name.starts_with("!") -> next
            return Val(sema_effect_comptime_callee_name(callee.key))
        }
    }
    None
}

// How compile-time reports name the callee `key`: a Core function by its whole
// path (`core.files.read()`), any other callee by its bare name.
sema_effect_comptime_callee_name: fn(key: String) -> String Never! {
    leaf: sema_effect_symbol_leaf(key)
    owner: sema_effect_symbol_module(key) ?? return "{leaf}()"
    if !owner.starts_with("<corelib>/") -> return "{leaf}()"
    "{owner.slice(10..<owner.len())}.{leaf}()"
}

// Rust `memory_control_multiplier`: one execution, or None inside a loop.
sema_effect_memory_executions: fn(node: SemaEffectNode, span: Span) -> Int? {
    loop loop_span in node.loop_spans {
        if sema_effect_span_contains(loop_span, span) -> return None
    }
    Val(1)
}

sema_effect_has_memory_call: fn(node: SemaEffectNode, callee: String, span: Span) -> Bool {
    loop call in node.memory_calls {
        if call.callee == callee && call.span.start == span.start && call.span.end == span.end -> return true
    }
    false
}

sema_effect_push_memory_event: fn(nodes: &[SemaEffectNode], node_index: Int, span: Span, operation: String, kind: String, bytes: Int?) {
    executions: sema_effect_memory_executions(nodes[node_index], span)
    nodes[node_index].memory_events.push(SemaMemoryEvent{span: span, operation: operation, kind: kind, bytes: bytes, executions: executions})
}

sema_effect_source_from_function_key: fn(func: Func, module_identity: String, key: String) -> SemaEffectFunctionSource Never! {
    source := sema_effect_source_from_function(func, module_identity)
    source.key = key
    source
}

// ────────────────────────────────────────────────────────────────────────────
// Canonical effect vocabulary and set operations

// The vocabulary is Prelude/Effects.jet, read through Foundation's
// EFFECT_VOCABULARY_ROOTS and `authority_grantable_roots`.

// The name up to its first `(` or `.`: the family of a member (`FS.Read`)
// or of a bounded effect (`Mem.Alloc(above: 1)`), read from the bytes once
// (an ASCII cut of UTF-8 text is UTF-8).
sema_effect_root: fn(name: String) -> String Never! {
    bytes: name.bytes()
    end := bytes.len()
    loop (index, byte) in bytes {
        if byte == (U8{40}) || byte == (U8{46}) {
            end = index
            break
        }
    }
    if end == bytes.len() -> return name.copy()
    String.from_bytes(bytes.slice(0, end)) ?? name.copy()
}

// A root's place in Prelude/Effects.jet: the canonical order of a row.
sema_effect_rank: fn(name: String) -> Int Never! {
    root: sema_effect_root(name)
    loop (index, known) in EFFECT_VOCABULARY_ROOTS {
        if known == root -> return index
    }
    100
}

sema_effect_set_contains: fn(set: [String], value: String) -> Bool Never! {
    loop item in set {
        if item == value -> return true
    }
    false
}

sema_effect_set_add: fn(set: &[String], value: String) -> Bool Never! {
    if sema_effect_set_contains(set, value) -> return false
    set.push(value.copy())
    index := set.len() - 1
    // The row at `index` is the pushed value at every step of the walk.
    right: sema_effect_rank(value)
    loop index > 0 {
        left: sema_effect_rank(set[index - 1])
        if left < right || (left == right && set[index - 1] <= set[index]) -> break
        swap := set[index - 1]
        set[index - 1] = set[index]
        set[index] = swap
        index -= 1
    }
    true
}

sema_effect_set_union: fn(target: &[String], values: [String]) -> Bool Never! {
    changed := false
    loop value in values {
        if sema_effect_set_add(target, value) -> changed = true
    }
    changed
}

sema_effect_parse_name: fn(name: String) -> String? {
    if name == "" || name.starts_with("..") -> return None
    base := name
    scoped: effect_scope_split(name)
    if scoped.scope == .Val(scope) {
        // A scope argument names a folder, a host or a device; the deny-only
        // `Mem` and `Panic` roots name none.
        if !effect_scope_argument_valid(scope) || authority_is_deny_only(scoped.base) -> return None
        base = scoped.base
    } else if base.contains("(") {
        parts: base.split("(").to_list()
        if parts.len() != 2 -> return None
        closing: parts[1].split(")").to_list()
        if closing.len() != 2 || closing[1] != "" -> return None
        base = parts[0]
        if base != "Mem.Alloc" -> return None
        arguments: closing[0].trim().split(":").to_list()
        if arguments.len() != 2 || arguments[0].trim() != "above" -> return None
        amount: Int.parse(arguments[1].trim()) ?? return None
        if amount <= 0 -> return None
    }
    root: sema_effect_root(base)
    if !EFFECT_VOCABULARY_ROOTS.contains(root) -> return None
    loop segment in base.split(".") {
        if segment == "" -> return None
    }
    Val(name)
}

sema_effect_without_deny_only: fn(values: [String]) -> [String] Never! {
    result := [String]{}
    loop value in values {
        if !authority_is_deny_only(value) -> sema_effect_set_add(result, value)
    }
    result
}

// The effects of `inferred` no bound covers. A bound naming a Core service
// effect (`DB`, `DB.Read`) also covers the machine effects the `#FX(…)` above
// its declaration lists (sema_effect_core_kernel): a row, cap or scope naming
// `DB` may use what a database driver needs. Denials never widen this way.
sema_effect_uncovered: fn(inferred: [String], bounds: [String]) -> [String] Never! {
    result := [String]{}
    loop effect_name in sema_effect_without_deny_only(inferred) {
        covered: loop bound in bounds {
            if sema_effect_covers(bound, effect_name) -> break true
            through: loop listed in sema_effect_core_kernel(bound) {
                if sema_effect_covers(listed, effect_name) -> break true
            } ?? false
            if through -> break true
        } ?? false
        if !covered -> sema_effect_set_add(result, effect_name)
    }
    result
}

// The machine effects a bound naming the Core service effect `name` admits:
// its EFFECT_VOCABULARY_ROWS kernel, empty for a machine effect.
sema_effect_core_kernel: fn(name: String) -> [String] Never! {
    loop row in EFFECT_VOCABULARY_ROWS {
        if row.name == name -> return row.kernel
    }
    [String]{}
}

sema_effect_covered: fn(inferred: [String], prohibited: [String]) -> [String] Never! {
    result := [String]{}
    loop effect_name in inferred {
        loop bound in prohibited {
            if sema_effect_covers(bound, effect_name) {
                sema_effect_set_add(result, effect_name)
                break
            }
        }
    }
    result
}

sema_effect_show: fn(values: [String]) -> String Never! {
    values.join(", ")
}

sema_effect_span_contains: fn(outer: Span, inner: Span) -> Bool Never! {
    outer.start <= inner.start && inner.end <= outer.end
}

// An effect's own declaration says whether it is irreversible (`FS.Read`
// is not, `FS.Write` is, and the family `FS` is because a case is); a
// name the canonical module does not declare follows its root.
sema_effect_declarations_irreversible_fact: fn(declarations: [Item], effect_name: String) -> Bool? {
    root: sema_effect_root(effect_name)
    root_fact := Bool?{None}
    loop item in declarations {
        if item == .EffectDecl(declaration) {
            if declaration.name == effect_name -> return Val(declaration.irreversible)
            if declaration.name == root -> root_fact = Val(declaration.irreversible)
        }
    }
    root_fact
}

// The transaction wall follows the canonical `irreversible: fn` facts loaded
// from the pinned Prelude module. It deliberately does not maintain a second
// allowlist: changing an effect's `irreversible` method in
// Prelude/Effects.jet changes this fact at the source boundary.
sema_effect_canonical_irreversible_fact: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, effect_name: String) -> Bool? {
    if program.registration_graph == .Val(graph) {
        canonical_identity: graph.canonical_effect_module_identity
        if canonical_identity == "" -> return None
        module_index: sema_registration_module_index(graph, canonical_identity) ?? return None
        if graph.modules[module_index].package_identity != JET_CANONICAL_EFFECT_PACKAGE_IDENTITY || graph.modules[module_index].module_path != JET_CANONICAL_EFFECT_MODULE_PATH -> return None
        return sema_effect_declarations_irreversible_fact(graph.modules[module_index].program.items, effect_name)
    }
    None
}

sema_effect_is_irreversible: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, effect_name: String) -> Bool? {
    sema_effect_canonical_irreversible_fact(environment, program, effect_name)
}

sema_effect_transaction_wall_diagnostic: fn(api: String, effect_name: String, span: Span) -> Diagnostic {
    effect_root: sema_effect_root(effect_name)
    diagnostic: if effect_root == "FFI" -> sema_error("E0746", span, "`{api}` has the `FFI` effect, which can't be rolled back inside a `#Transact` block", "a foreign function can change external state that the compiler cannot undo automatically", "move this call after the block, or declare `#Undo(inverse)` on the foreign binding so rollback can call the inverse") else -> sema_error("E0746", span, "`{api}` has the `{effect_root}` effect, which can't be rolled back inside a `#Transact` block", "a `#Transact` block undoes its work on a `?`-failure; a network, file, or subprocess effect (`{effect_root}`) leaves committed external state a rollback can't take back", "move this call after the block, or register it with `<handle>.on_commit(() -> {{ … }})` so it runs only on a clean commit")
    diagnostic_with_rights(diagnostic, "transaction", [String]{api}, [String]{}, None)
}

// Check a call's declared effect row at the authored-transaction wall. The
// caller supplies the canonical API spelling because checked-tree call nodes may no
// longer retain the registration module/member pair.
sema_effect_check_transaction_wall: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, effect_row: [EffectRowEntry]?, api: String, span: Span, diagnostics: &[Diagnostic]) -> Bool? {
    if scopes.transaction_wall_depth <= 0 -> return Val(true)
    row: effect_row ?? return Val(true)
    loop entry in row {
        if entry.name.starts_with("!") || entry.name.starts_with("..") -> next
        parsed: sema_effect_parse_name(entry.name) ?? next
        irreversible: sema_effect_is_irreversible(environment, program, parsed) ?? return None
        if irreversible {
            diagnostics.push(sema_effect_transaction_wall_diagnostic(api, parsed, span))
            return Val(false)
        }
    }
    Val(true)
}

// The name a diagnostic gives a module member: its module's last segment
// and the member (`files.read` for `<corelib>/core.files`).
sema_effect_member_label: fn(module_name: String, member: String) -> String Never! {
    path: module_name.split("/").to_list()
    parts: path[path.len() - 1].split(".").to_list()
    "{parts[parts.len() - 1]}.{member}"
}

// The name a diagnostic gives a declaration key: a Core function is
// `{module}.{name}`, any other declaration its bare name.
sema_effect_decl_label: fn(key: String) -> String Never! {
    leaf: sema_effect_symbol_leaf(key)
    owner_module: sema_effect_symbol_module(key) ?? return leaf
    if !owner_module.starts_with("<corelib>/") -> return leaf
    sema_effect_member_label(owner_module, leaf)
}

sema_effect_call_api: fn(program: SemaProgramTables, value: TExpr) -> String Never! {
    if value.kind == {
        .CoreCall(record, _, _, _, _, _) -> sema_effect_member_label(record.module_name, record.member)
        .Call(callee, _, _) -> sema_effect_decl_label(sema_program_decl_key(program, callee))
        .MethodCall(_, method, _, _) -> method.name
        .IndirectCall(_, _, _, _) -> "indirect call"
        .BuiltinMethod(_, _, _) | .ClosureMethod(_, _, _) | .HandleMethod(_, _, _) -> "intrinsic method"
        .AllocNew(_, _) -> "intrinsic allocation"
        .SharedGuardWait(_, _, _) -> "shared guard wait"
        .CoreClosureCall(_) -> "core closure intrinsic"
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .HostCall(_) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> "call"
    }
}

// sema_effect_call_api of a node of a checked flat body; `decls` names a
// direct callee.
sema_effect_node_call_api: fn(decls: DeclTable, kind: NodeKind) -> String Never! {
    if kind == {
        .CoreCall(record, _, _, _, _, _) -> sema_effect_member_label(record.module_name, record.member)
        .Call(callee, _, _) -> sema_effect_decl_label(decls.rows[callee.row].key)
        .MethodCall(_, method, _, _) -> method.name
        .IndirectCall(_, _, _, _) -> "indirect call"
        .BuiltinMethod(_, _, _) | .ClosureMethod(_, _, _) | .HandleMethod(_, _, _) -> "intrinsic method"
        .AllocNew(_, _) -> "intrinsic allocation"
        .SharedGuardWait(_, _, _) -> "shared guard wait"
        .CoreClosureCall(_) -> "core closure intrinsic"
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .ConditionNotify(_, _) | .HostCall(_) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> "call"
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Diagnostics and explicit audit gates
// ────────────────────────────────────────────────────────────────────────────

// E0119. A name that matches a registered effect but for letter case (`io`,
// `fs.read`) is that effect miswritten, so the fix names its registered
// PascalCase spelling and its suggested edit writes it.
sema_effect_unknown: fn(name: String, span: Span) -> Diagnostic {
    wanted: name.lower()
    loop row in EFFECT_VOCABULARY_ROWS {
        if row.name.lower() == wanted {
            diagnostic: sema_error("E0119", span, "`{name}` isn't a known effect", "an effect list names compiler-known effects like `Net`, `FS`, `IO`, `DB`, or `Time`", "write it `{row.name}`, the effect's registered spelling")
            return diagnostic_with_source_derived_suggestion(diagnostic, span, row.name)
        }
    }
    sema_error("E0119", span, "`{name}` isn't a known effect", "an effect list names compiler-known effects like `Net`, `FS`, `IO`, `DB`, or `Time`", "use one of the known effect names, or remove it from the list")
}

sema_effect_positive_panic: fn(span: Span) -> Diagnostic {
    sema_error("E0751", span, "`Panic` can't be granted, only denied", "`Panic` is a deny-only effect row; no positive effect bound or authority can grant it", "drop `Panic` from the list, or write `-[!Panic]>`")
}

// A checked String argument that is not a literal (`#Unsafe(reason)`) is a
// reason; the rule's signature check owns its type.
sema_effect_check_unsafe_region: fn(reason: String?, has_reason_expr: Bool, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if (reason ?? "").len() > 0 || (reason == None && has_reason_expr) -> return true
    diagnostics.push(sema_error("E3112", span, "an `#Unsafe` block needs a reason", "every unsafe gate records why its unchecked operations preserve memory safety", "write `#Unsafe(\"why this is safe\") {{ … }}`"))
    false
}

sema_effect_check_unsafe_function_reason: fn(reason: String?, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if (reason ?? "").len() > 0 -> return true
    diagnostics.push(sema_error("E3112", span, "an `#Unsafe` function needs a reason", "every unsafe function records why callers can rely on its unchecked contract", "write `#Unsafe(\"why this is safe\") name: fn …`"))
    false
}

sema_effect_check_unsafe_function: fn(source: SemaEffectFunctionSource, diagnostics: &[Diagnostic]) -> Bool {
    if !source.is_unsafe -> return true
    sema_effect_check_unsafe_function_reason(source.unsafe_reason, source.unsafe_span ?? source.span, diagnostics)
}

sema_effect_require_unsafe_call: fn(callee: String, callee_is_unsafe: Bool, audited: Bool, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if !callee_is_unsafe || audited -> return true
    diagnostics.push(sema_error("E3103", span, "`{callee}` is an `#Unsafe` function", "its contract can't be checked by the compiler, so the caller must vouch for it", "call it inside `#Unsafe(\"…\") {{ … }}`"))
    false
}

sema_effect_check_tfunc_unsafe: fn(function: FnBody, diagnostics: &[Diagnostic]) -> Bool {
    if !function.is_unsafe -> return true
    sema_effect_check_unsafe_function_reason(function.unsafe_gate.map((gate) -> gate.reason), function.source_span, diagnostics)
}

sema_effect_via_unknown_parameter: fn(function: FnBody, parameter: String, span: Span) -> Diagnostic {
    sema_error("E0748", span, "`-[via {parameter}]>` on `{function.name}` names no such parameter", "`-[via f]>` publishes the effects of a callback parameter `f`; `{function.name}` has no parameter called `{parameter}`", "name one of `{function.name}`'s callback parameters after `via`")
}

sema_effect_via_not_callback: fn(function: FnBody, parameter: String, ty: Type, span: Span) -> Diagnostic {
    sema_error("E0748", span, "`-[via {parameter}]>` on `{function.name}` names a parameter that isn't a callback", "`{parameter}` has type `{type_name(ty)}`, not a function type with an effect row", "point `via` at a function parameter, or remove the `via` annotation")
}

sema_effect_apply_via: fn(nodes: &[SemaEffectNode], node_index: Int, function: FnBody, diagnostics: &[Diagnostic]) {
    via: nodes[node_index].effect_via ?? return
    parameter_type := Type?{None}
    loop parameter_index in 0..<function.params.len() {
        if function.params[parameter_index].name == via.name {
            parameter_type = Val(function.params[parameter_index].ty)
            break
        }
    }
    callback_type: parameter_type ?? {
        diagnostics.push(sema_effect_via_unknown_parameter(function, via.name, via.span))
        return
    }
    if callback_type == {
        .Fn(_, _, effect_bound, _, _, _) -> if effect_bound == {
            .Val(effect_row) -> loop entry in effect_row {
                if entry.name.starts_with("..") -> next
                raw := entry.name
                if raw.starts_with("!") {
                    pieces: raw.split("!").to_list()
                    if pieces.len() > 1 -> raw = pieces[1]
                }
                effect_name: sema_effect_parse_name(raw) ?? {
                    diagnostics.push(sema_effect_unknown(raw, entry.span))
                    next
                }
                if sema_effect_root(effect_name) == "Panic" {
                    diagnostics.push(sema_effect_positive_panic(entry.span))
                    next
                }
                sema_effect_node_add_direct(nodes, node_index, effect_name, entry.span)
            }
            .None -> {
                nodes[node_index].maximal = true
                nodes[node_index].maximal_span = Val(via.span)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> diagnostics.push(sema_effect_via_not_callback(function, via.name, callback_type, via.span))
    }
}

// `e0740`: the span is the row's first entry. A scoped need that a bare
// need in the same list covers is not named twice.
sema_effect_bound_diagnostic: fn(node: SemaEffectNode, over: [String]) -> Diagnostic {
    sorted := [String]{}
    loop name in over {
        if !sema_effect_bare_covered(over, name) -> sorted.push(name.copy())
    }
    sorted.sort()
    over_list: sema_effect_show(sorted)
    declared: if node.declared.len() == 0 -> "no effects" else -> "`-[{sema_effect_show(node.declared)}]>`"
    span: node.row_span ?? node.name_span
    diagnostic: sema_error("E0740", span, "`{node.name}` uses the effect `{over_list}`, which its signature doesn't allow", "the signature declares {declared}, so the body may only use those; `{over_list}` is outside that set", "add `{over_list}` to the effect list, or stop using it in `{node.name}`")
    diagnostic_with_rights(diagnostic, "invocation", [String]{node.name}, [String]{}, None)
}

// True when `name` is scoped and a bare name in `names` covers it.
sema_effect_bare_covered: fn(names: [String], name: String) -> Bool Never! {
    if !effect_scope_is_scoped(name) -> return false
    loop other in names {
        if !effect_scope_is_scoped(other) && effect_scope_covers(other, name) -> return true
    }
    false
}

// `e0749` / `e0749_panic`: a reached Panic names the reachable function where
// the stop enters the call graph, and the call chain to it
// (sema_effect_panic_steps).
sema_effect_prohibited_diagnostic: fn(node: SemaEffectNode, reached: [String], panic_steps: [String]) -> Diagnostic {
    reached_list: sema_effect_show(reached)
    declared: sema_effect_show(node.prohibited)
    span: node.prohibition_span ?? node.name_span
    reaches_panic: loop effect_name in reached {
        if sema_effect_root(effect_name) == "Panic" -> break true
    } ?? false
    if reaches_panic {
        panic_site: sema_effect_panic_site_name(node, panic_steps)
        diagnostic: sema_error("E0749", span, "`{node.name}` can stop, but Panic is denied here", "`{panic_site}` can stop; `{node.name}` and every reachable callee must not stop when Panic is denied", "return a fallible result for expected failure, add facts or a `#Pre`/refinement proof for a programmer-error stop, or drop the `-[!{declared}]>` prohibition")
        return diagnostic_with_rights(diagnostic, "invocation", sema_effect_panic_chain(node.name, panic_steps), [String]{}, None)
    }
    diagnostic: sema_error("E0749", span, "`{node.name}` reaches the `{reached_list}` effect, which it prohibits with `-[!{declared}]>`", "a `-[!{declared}]>` row means the function and every callee it can reach must not use `{reached_list}`", "remove the call that introduces `{reached_list}`, or drop the `-[!{declared}]>` prohibition")
    diagnostic_with_rights(diagnostic, "invocation", [String]{node.name}, [String]{}, None)
}

// A package `authority.deny` row reached by one of the package's functions.
// A denied Panic names the reachable function where the stop enters the call
// graph and the chain to it (`panic_steps`) and the three exits, the same as
// a `-[!Panic]>` row.
sema_effect_package_denied_diagnostic: fn(node: SemaEffectNode, reached: [String], denied: String, panic_steps: [String]) -> Diagnostic {
    reached_list: sema_effect_show(reached)
    reaches_panic: loop effect_name in reached {
        if sema_effect_root(effect_name) == "Panic" -> break true
    } ?? false
    if reaches_panic {
        panic_site: sema_effect_panic_site_name(node, panic_steps)
        diagnostic: sema_error("E0749", node.name_span, "`{node.name}` can stop, but the package denies Panic with `authority: {{ deny: [{denied}] }}`", "`{panic_site}` can stop; every function in the package and every callee it can reach must not stop when Panic is denied", "return a fallible result for expected failure, add facts or a `#Pre`/refinement proof for a programmer-error stop, or drop `{denied}` from `authority.deny`")
        return diagnostic_with_rights(diagnostic, "invocation", sema_effect_panic_chain(node.name, panic_steps), [String]{}, None)
    }
    diagnostic: sema_error("E0749", node.name_span, "`{node.name}` reaches the `{reached_list}` effect, which the package denies with `authority: {{ deny: [{denied}] }}`", "a package `deny` row means every function in the package and every callee it can reach must not use `{reached_list}`", "remove the call that introduces `{reached_list}`, or drop `{denied}` from `authority.deny`")
    diagnostic_with_rights(diagnostic, "invocation", [String]{node.name}, [String]{}, None)
}

sema_effect_pure_diagnostic: fn(node: SemaEffectNode, reached: [String]) -> Diagnostic {
    sema_error("E3401", node.span, "`{node.name}` calls or reaches impure effects `{sema_effect_show(reached)}`", "a pure function must produce the same result without ambient effects", "remove the call that introduces `{sema_effect_show(reached)}`, or drop the `-[]>` bound from `{node.name}` so its effects are inferred")
}

// A pure function that writes state outliving the call (`path` is the
// function alone) or reaches a function that does (`path` runs from the pure
// function to it). The report points at the write; a write through a held
// cell (a parameter or local) names the holder.
sema_effect_pure_state_diagnostic: fn(nodes: [SemaEffectNode], path: [Int]) -> Diagnostic {
    node: nodes[path[0]]
    writer: nodes[path[path.len() - 1]]
    write: writer.module_writes[0]
    chain: loop step in path -> nodes[step].chain_name
    written: if write.held -> "a cell through `{write.name}`" else -> "module state `{write.name}`"
    if path.len() == 1 {
        why: if write.held -> "`{write.name}` may hold a module cell, and a write to it outlives the call so a later read sees it, but `{node.name}` declares `-[]>`" else -> "module state outlives the call, so a later call sees the write, but `{node.name}` declares `-[]>`"
        instead: if write.held -> "take the cell as a `&` parameter so the caller lends it for writing, return the new value instead" else -> "pass the state in and return the new value"
        diagnostic: sema_error("E3401", write.span, "`{node.name}` writes {written}", why, "{instead}, or drop the `-[]>` bound from `{node.name}` so its effects are inferred")
        return diagnostic_with_rights(diagnostic, "pure", chain, [String]{}, None)
    }
    target: if write.held -> "a cell through `{write.name}`" else -> "`{write.name}`"
    diagnostic: sema_error("E3401", write.span, "`{node.name}` reaches a write of {written}", "{chain.join(" → ")} writes {target}, which outlives the call — the whole call chain must be pure inside `{node.name}`", "move the write out of `{writer.chain_name}`, or drop the `-[]>` bound from `{node.name}` so its effects are inferred")
    diagnostic_with_rights(diagnostic, "pure", chain, [String]{}, None)
}

// The call path from `index` to the first function reached depth-first that
// writes module state, `index` first; empty when none does.
sema_effect_state_writer_path: fn(nodes: [SemaEffectNode], node_by_key: NameRows, index: Int, seen: &[Bool]) -> [Int] Never! {
    if seen[index] -> return [Int]{}
    seen[index] = true
    if nodes[index].module_writes.len() > 0 -> return [Int]{index}
    calls: nodes[index].call_edges.len()
    loop position in 0..<(calls + nodes[index].value_edges.len()) {
        edge: if position < calls -> nodes[index].call_edges[position] else -> nodes[index].value_edges[position - calls]
        target: sema_effect_node_index(node_by_key, edge) ?? next
        tail: sema_effect_state_writer_path(nodes, node_by_key, target, seen)
        if tail.len() == 0 -> next
        path := [Int]{index}
        loop step in tail -> path.push(step)
        return path
    }
    [Int]{}
}

// A comptime input call (`embed_file`, `embed_bytes`, `find`, `net.fetch`)
// at `node`, charged to `node_index` once per call span.
sema_effect_record_comptime_input: fn(nodes: &[SemaEffectNode], node_index: Int, node: BodyNode) Never! {
    if node.kind == .HostCall(call) {
        if call == .ComptimeInput(builtin, _, _) {
            loop seen in nodes[node_index].comptime_inputs {
                if seen.span.start == node.span.start && seen.span.end == node.span.end -> return
            }
            name: if builtin == "fetch" -> "net.fetch" else -> builtin
            nodes[node_index].comptime_inputs.push(TEffectSpan{name: name, span: node.span})
        }
    }
}

// The compiler answers a comptime input while it compiles, so the running
// program must never reach one. The runtime entries are the functions that
// nothing names: no function calls or takes them as a value, no
// compile-time site (a comptime item, a `comptime {}` site or a module value,
// SemaCallSiteFact.comptime) calls them, and the build did not check them to
// run while compiling (`prep_functions`, a comptime item's callees). That is
// `run`, a test, a job and a callback a host names; `build`, which runs while
// building, is not one. A function that only compile-time sites or prep code
// name is prep code. The result holds, for each function the entries reach
// that makes an input, the call path from an entry to it, entry first
// (E0956).
sema_effect_runtime_input_paths: fn(nodes: [SemaEffectNode], node_by_key: NameRows, modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], prep_functions: [String:Bool]) -> [[Int]] Never! {
    paths := [[Int]]{}
    any: loop node in nodes {
        if node.comptime_inputs.len() > 0 -> break true
    } ?? false
    if !any -> return paths
    comptime_callees := prep_functions.copy()
    loop module_row in inputs {
        loop fact in modules[module_row.module_index].call_facts {
            if !fact.comptime -> next
            if fact.callee == .Val(callee) -> comptime_callees[callee.key] = true
        }
    }
    named := (loop _ in nodes -> false)
    loop (index, node) in nodes {
        calls: node.call_edges.len()
        loop position in 0..<(calls + node.value_edges.len()) {
            edge: if position < calls -> node.call_edges[position] else -> node.value_edges[position - calls]
            target: sema_effect_node_index(node_by_key, edge) ?? next
            if target != index -> named[target] = true
        }
    }
    // -2: not reached; -1: an entry; else the caller it was reached from.
    parent := (loop _ in nodes -> -2)
    queue := [Int]{}
    loop (index, node) in nodes {
        if named[index] || comptime_callees.has_key(node.key) || node.chain_name == "build" -> next
        parent[index] = -1
        queue.push(index)
    }
    head := 0
    loop head < queue.len() {
        index: queue[head]
        head += 1
        calls: nodes[index].call_edges.len()
        loop position in 0..<(calls + nodes[index].value_edges.len()) {
            edge: if position < calls -> nodes[index].call_edges[position] else -> nodes[index].value_edges[position - calls]
            target: sema_effect_node_index(node_by_key, edge) ?? next
            if parent[target] != -2 -> next
            parent[target] = index
            queue.push(target)
        }
    }
    loop index in queue {
        if nodes[index].comptime_inputs.len() == 0 -> next
        path := [Int]{index}
        step := parent[index]
        loop step >= 0 {
            path.push(step)
            step = parent[step]
        }
        path.reverse()
        paths.push(path)
    }
    paths
}

// A comptime input a runtime entry reaches: `path` runs from the entry to
// the function that makes the call (sema_effect_runtime_input_paths), and
// the report points at the call.
sema_effect_runtime_input_diagnostic: fn(nodes: [SemaEffectNode], path: [Int], input: TEffectSpan) -> Diagnostic {
    maker: nodes[path[path.len() - 1]].chain_name
    if path.len() == 1 -> return sema_error("E0956", input.span, "`{maker}` runs in the program, so it can't call `{input.name}`", "the compiler answers `{input.name}` while it compiles, and nothing calls `{maker}` at compile time, so the call would run in the program", "call `{input.name}` from a prepared constant (`NAME: comptime {{ … }}`) and read that value at run time")
    chain: loop step in path -> nodes[step].chain_name
    sema_error("E0956", input.span, "`{maker}` calls `{input.name}`, and the running program reaches `{maker}` from `{chain[0]}`", "the call path {chain.join(" → ")} runs in the program, and the compiler answers `{input.name}` only while it compiles", "call `{maker}` only from compile-time code, such as a prepared constant (`NAME: comptime {{ {maker}() }}`), and read that value at run time")
}

// A module or type cap as one checked function meets it. `site` names where
// the cap is written (`run.jet:1`) when it isn't in the function's own file;
// a cap in the function's file is labeled in the report.
SemaEffectModuleCap: struct {
    cap: ModuleCap
    site: String?
}

// A struct's, enum's or trait's cap and the module that declares it.
SemaEffectTypeCap: struct {
    module_identity: String
    cap: SemaEffectModuleCap
}

// A module's or type's `#FX(…)` cap over one function: the function-row rule,
// with plain entries as a ceiling and `!` entries as denials, both E0749 and
// both holding through every callee the function can reach. A bare `#FX` is
// the empty ceiling, so the function is pure. A row the function declares
// may only narrow the cap, so a declared effect outside it is E0749 too, even
// when the body doesn't use it. Names were validated once per cap
// (sema_effect_module_cap_names).
sema_effect_check_module_cap: fn(nodes: [SemaEffectNode], node_by_key: NameRows, node_index: Int, solved: [String], cap: SemaEffectModuleCap, notes: [SemaEffectInstanceNote], diagnostics: &[Diagnostic]) {
    node: nodes[node_index]
    loop entry in cap.cap.entries {
        if !entry.name.starts_with("!") -> next
        effect_name: sema_effect_parse_name(entry.name.slice(1, entry.name.len())) ?? next
        if sema_effect_memory_fact(effect_name) != None {
            span: if cap.site == None -> entry.span else -> node.name_span
            _: sema_effect_memory_project(nodes, node_by_key, node_index, EffectRowEntry{name: effect_name, span: span}, diagnostics)
            next
        }
        reached: sema_effect_covered(solved, [String]{effect_name})
        if reached.len() == 0 {
            declared: sema_effect_declared_hits(node.declared, effect_name)
            if declared.len() > 0 -> diagnostics.push(sema_effect_module_row_denied_diagnostic(node, declared, effect_name, cap))
            next
        }
        panic_steps := [String]{}
        if sema_effect_root(effect_name) == "Panic" -> panic_steps = sema_effect_panic_steps(nodes, node_by_key, node_index)
        diagnostics.push(sema_effect_with_instance_notes(sema_effect_module_denied_diagnostic(node, reached, effect_name, panic_steps, cap), notes, reached))
    }
    ceiling: sema_effect_cap_ceiling(cap.cap) ?? return
    over: sema_effect_uncovered(solved, ceiling)
    if over.len() > 0 {
        diagnostics.push(sema_effect_with_instance_notes(sema_effect_module_ceiling_diagnostic(node, over, ceiling, cap), notes, over))
        return
    }
    wider: sema_effect_uncovered(node.declared, ceiling)
    if wider.len() > 0 -> diagnostics.push(sema_effect_module_row_ceiling_diagnostic(node, wider, ceiling, cap))
}

// The declared effects that overlap `denied`: the denied effect itself, a
// leaf under it, or a root above it (a row granting `FS` grants `FS.Read`).
sema_effect_declared_hits: fn(declared: [String], denied: String) -> [String] Never! {
    hits := [String]{}
    loop effect_name in declared {
        if sema_effect_covers(denied, effect_name) || sema_effect_covers(effect_name, denied) -> sema_effect_set_add(hits, effect_name)
    }
    hits
}

sema_effect_module_row_denied_diagnostic: fn(node: SemaEffectNode, declared: [String], denied: String, cap: SemaEffectModuleCap) -> Diagnostic {
    name: sema_inline_member_source_name(node.name)
    scope: cap.cap.scope
    owner: cap.cap.owner
    declared_list: sema_effect_show(declared)
    diagnostic: sema_error(sema_effect_cap_code(cap), node.row_span ?? node.name_span, "`{name}`'s row declares `{declared_list}`, which {scope} `{owner}` denies", "a row written inside a cap may only narrow it; the {scope}'s `#FX(…)` cap denies `{denied}` to {sema_effect_cap_members(cap)}{sema_effect_module_cap_where(cap)}", "drop `{declared_list}` from `{name}`'s row, {sema_effect_cap_move(name, cap)}or drop `!{denied}` from the {scope}'s `#FX(…)` cap")
    sema_effect_module_cap_report(diagnostic, [String]{name}, cap)
}

sema_effect_module_row_ceiling_diagnostic: fn(node: SemaEffectNode, wider: [String], ceiling: [String], cap: SemaEffectModuleCap) -> Diagnostic {
    name: sema_inline_member_source_name(node.name)
    scope: cap.cap.scope
    owner: cap.cap.owner
    sorted := wider.copy()
    sorted.sort()
    wider_list: sema_effect_show(sorted)
    narrow: if ceiling.len() == 0 -> "write `-[]>` as `{name}`'s row" else -> "narrow `{name}`'s row to `{sema_effect_show(ceiling)}`"
    diagnostic: sema_error(sema_effect_cap_code(cap), node.row_span ?? node.name_span, "`{name}`'s row declares `{wider_list}`, which {scope} `{owner}`'s `#FX(…)` cap doesn't allow", "a row written inside a cap may only narrow it; the {scope}'s cap allows {sema_effect_cap_allows(ceiling)} in {sema_effect_cap_members(cap)}{sema_effect_module_cap_where(cap)}", "{narrow}, or add `{wider_list}` to the {scope}'s `#FX(…)` cap")
    sema_effect_module_cap_report(diagnostic, [String]{name}, cap)
}

// What a cap's ceiling admits, for the reports above: a bare `#FX` admits
// nothing.
sema_effect_cap_allows: fn(ceiling: [String]) -> String Never! {
    if ceiling.len() == 0 -> return "no effects"
    "only `{sema_effect_show(ceiling)}`"
}

sema_effect_module_cap_where: fn(cap: SemaEffectModuleCap) -> String Never! {
    if cap.site == .Val(site) -> return "; the cap is written at `{site}`"
    ""
}

// Who the cap binds: a module's functions, a type's methods or the
// implementations of a trait's methods.
sema_effect_cap_members: fn(cap: SemaEffectModuleCap) -> String Never! {
    if cap.cap.scope == "type" -> return "every method of the type"
    if cap.cap.scope == "trait" -> return "every implementation of the trait's methods"
    "every function inside it"
}

// A trait's cap binds implementations written in any package, so it is its
// own code; a module's or a type's is E0749.
sema_effect_cap_code: fn(cap: SemaEffectModuleCap) -> String Never! {
    if cap.cap.scope == "trait" -> return "E0754"
    "E0749"
}

// The fix that moves the function out from under the cap, with its trailing
// `, `. An implementation of a capped trait's method can't leave the trait.
sema_effect_cap_move: fn(name: String, cap: SemaEffectModuleCap) -> String Never! {
    if cap.cap.scope == "trait" -> return ""
    "move `{name}` out of {cap.cap.scope} `{cap.cap.owner}`, "
}

sema_effect_module_cap_report: fn(diagnostic: Diagnostic, chain: [String], cap: SemaEffectModuleCap) -> Diagnostic {
    labeled := diagnostic
    if cap.site == None -> labeled = diagnostic_with_label(labeled, cap.cap.span, "{cap.cap.scope} `{cap.cap.owner}` is capped here")
    diagnostic_with_rights(labeled, "invocation", chain, [String]{"{cap.cap.scope} {cap.cap.owner}"}, None)
}

sema_effect_module_denied_diagnostic: fn(node: SemaEffectNode, reached: [String], denied: String, panic_steps: [String], cap: SemaEffectModuleCap) -> Diagnostic {
    name: sema_inline_member_source_name(node.name)
    scope: cap.cap.scope
    owner: cap.cap.owner
    members: sema_effect_cap_members(cap)
    where: sema_effect_module_cap_where(cap)
    if sema_effect_root(denied) == "Panic" {
        panic_site: sema_effect_panic_site_name(node, panic_steps)
        diagnostic: sema_error(sema_effect_cap_code(cap), node.name_span, "`{name}` can stop, but {scope} `{owner}` denies Panic", "`{panic_site}` can stop; the {scope}'s `#FX(!Panic)` cap means {members} and every callee it can reach must not stop{where}", "return a fallible result for expected failure, add facts or a `#Pre`/refinement proof for a programmer-error stop, or drop `!Panic` from the {scope}'s `#FX(…)` cap")
        return sema_effect_module_cap_report(diagnostic, sema_effect_panic_chain(name, panic_steps), cap)
    }
    reached_list: sema_effect_show(reached)
    diagnostic: sema_error(sema_effect_cap_code(cap), node.name_span, "`{name}` reaches the `{reached_list}` effect, which {scope} `{owner}` denies", "the {scope}'s `#FX(…)` cap denies `{denied}` to {members} and every callee it can reach{where}", "remove the call that introduces `{reached_list}`, {sema_effect_cap_move(name, cap)}or drop `!{denied}` from the {scope}'s `#FX(…)` cap")
    sema_effect_module_cap_report(diagnostic, [String]{name}, cap)
}

sema_effect_module_ceiling_diagnostic: fn(node: SemaEffectNode, over: [String], ceiling: [String], cap: SemaEffectModuleCap) -> Diagnostic {
    name: sema_inline_member_source_name(node.name)
    scope: cap.cap.scope
    owner: cap.cap.owner
    sorted := over.copy()
    sorted.sort()
    over_list: sema_effect_show(sorted)
    elsewhere: if cap.cap.scope == "trait" -> "remove that work from `{name}`" else -> "move that work out of {scope} `{owner}`"
    diagnostic: sema_error(sema_effect_cap_code(cap), node.name_span, "`{name}` uses the effect `{over_list}`, which {scope} `{owner}`'s `#FX(…)` cap doesn't allow", "the {scope}'s cap allows {sema_effect_cap_allows(ceiling)} in {sema_effect_cap_members(cap)}, even through a call{sema_effect_module_cap_where(cap)}", "add `{over_list}` to the {scope}'s `#FX(…)` cap, or {elsewhere}")
    sema_effect_module_cap_report(diagnostic, [String]{name}, cap)
}

// A function-typed field of a capped type whose fixed row reaches outside
// the cap, reported at the field (E0755). Its row runs wherever a method
// calls the field, so each calling method is E0749 too; this names the
// field path itself, called or not.
sema_effect_check_field_rows: fn(module_row: SemaRegistrationModule, caps: [String:SemaEffectTypeCap], diagnostics: &[Diagnostic]) {
    loop nominal in module_row.nominals {
        found: caps.get(nominal.symbol.id.key) ?? next
        cap: SemaEffectModuleCap{cap: found.cap.cap, site: None}
        ceiling: sema_effect_cap_ceiling(cap.cap)
        loop field in nominal.fields {
            row: if field.ty == .Fn(_, _, bound, _, _, _) -> bound ?? next else -> next
            declared := [String]{}
            loop entry in row {
                if entry.name.starts_with("!") || entry.name.starts_with("..") -> next
                effect_name: sema_effect_parse_name(entry.name) ?? next
                sema_effect_set_add(declared, effect_name)
            }
            outside := [String]{}
            loop entry in cap.cap.entries {
                if !entry.name.starts_with("!") -> next
                denied: sema_effect_parse_name(entry.name.slice(1, entry.name.len())) ?? next
                loop hit in sema_effect_declared_hits(declared, denied) -> sema_effect_set_add(outside, hit)
            }
            if ceiling == .Val(bound) {
                loop wider in sema_effect_uncovered(declared, bound) -> sema_effect_set_add(outside, wider)
            }
            if outside.len() > 0 -> diagnostics.push(sema_effect_field_row_diagnostic(field.symbol.name, field.symbol.span, outside, cap))
        }
    }
}

sema_effect_field_row_diagnostic: fn(name: String, span: Span, outside: [String], cap: SemaEffectModuleCap) -> Diagnostic {
    sorted := outside.copy()
    sorted.sort()
    outside_list: sema_effect_show(sorted)
    owner: cap.cap.owner
    diagnostic: sema_error("E0755", span, "field `{name}`'s row declares `{outside_list}`, which type `{owner}` doesn't allow", "a method that calls `{name}` runs its row, and the type's `#FX(…)` cap bounds every method of the type", "narrow `{name}`'s row to fit the cap, move `{name}` out of type `{owner}`, or widen the type's `#FX(…)` cap")
    sema_effect_module_cap_report(diagnostic, [String]{name}, cap)
}

// Each `#FX(…)` cap on a module, generic module, struct, enum or trait
// declared in `items`, nested modules included, names known effects; a
// positive `Panic` is rejected as in a row (E0749). Reported once per cap,
// where it is written.
sema_effect_module_cap_names: fn(items: [Item], diagnostics: &[Diagnostic]) {
    loop item in items {
        if item == {
            .CodeModule(definition) -> {
                if definition.cap == .Val(cap) -> sema_effect_cap_entry_names(cap, diagnostics)
                if definition.body == .Val(body) -> sema_effect_module_cap_names(body, diagnostics)
            }
            .GenericModule(definition) -> {
                if definition.cap == .Val(cap) -> sema_effect_cap_entry_names(cap, diagnostics)
                sema_effect_module_cap_names(definition.body, diagnostics)
            }
            .Struct(definition) -> {
                if definition.cap == .Val(cap) -> sema_effect_cap_entry_names(cap, diagnostics)
            }
            .Enum(definition) -> {
                if definition.cap == .Val(cap) -> sema_effect_cap_entry_names(cap, diagnostics)
            }
            .Trait(definition) -> {
                if definition.cap == .Val(cap) -> sema_effect_cap_entry_names(cap, diagnostics)
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

sema_effect_cap_entry_names: fn(cap: ModuleCap, diagnostics: &[Diagnostic]) {
    loop entry in cap.entries {
        raw: if entry.name.starts_with("!") -> entry.name.slice(1, entry.name.len()) else -> entry.name
        effect_name: sema_effect_parse_name(raw) ?? {
            diagnostics.push(sema_effect_unknown(raw, entry.span))
            next
        }
        if !entry.name.starts_with("!") && sema_effect_root(effect_name) == "Panic" -> diagnostics.push(sema_effect_positive_panic(entry.span))
    }
}

// The `#FX(…)` cap of every struct and enum in the graph, by the type's
// nominal key, each with the `file:line` it is written at.
sema_effect_type_caps: fn(graph_modules: [SemaRegistrationModule]) -> [String:SemaEffectTypeCap] {
    caps := [String:SemaEffectTypeCap]{}
    loop module_row in graph_modules {
        loop nominal in module_row.nominals {
            cap: sema_effect_nominal_cap(nominal) ?? next
            caps[nominal.symbol.id.key] = SemaEffectTypeCap{module_identity: module_row.module_identity, cap: SemaEffectModuleCap{cap: cap, site: Val(sema_effect_cap_site(module_row, cap.span))}}
        }
    }
    caps
}

// The `#FX(…)` cap of every trait in the graph, by its
// sema_effect_trait_cap_key, each with the `file:line` it is written at.
sema_effect_trait_caps: fn(graph_modules: [SemaRegistrationModule]) -> [String:SemaEffectTypeCap] {
    caps := [String:SemaEffectTypeCap]{}
    loop module_row in graph_modules {
        loop item in module_row.declarations {
            if item == .Trait(definition) {
                cap: definition.cap ?? next
                caps["{module_row.module_identity}|{definition.name}"] = SemaEffectTypeCap{module_identity: module_row.module_identity, cap: SemaEffectModuleCap{cap: cap, site: Val(sema_effect_cap_site(module_row, cap.span))}}
            }
        }
    }
    caps
}

// `{module}|{trait}` for a trait's symbol key: how an implementation and a
// trait-value call both name the trait.
sema_effect_trait_cap_key: fn(trait_key: String) -> String Never! {
    "{sema_effect_symbol_module(trait_key) ?? ""}|{sema_effect_symbol_leaf(trait_key)}"
}

// The ceiling of a cap: its plain entries. A bare `#FX` has none and is the
// empty ceiling, pure. None when the cap only denies, so its ceiling is the
// rungs' above, or when a plain entry names no effect (reported once per cap
// by sema_effect_module_cap_names).
sema_effect_cap_ceiling: fn(cap: ModuleCap) -> [String]? Never! {
    ceiling := [String]{}
    bounded := cap.entries.len() == 0
    loop entry in cap.entries {
        if entry.name.starts_with("!") -> next
        bounded = true
        effect_name: sema_effect_parse_name(entry.name) ?? return None
        if sema_effect_root(effect_name) != "Panic" -> sema_effect_set_add(ceiling, effect_name)
    }
    if !bounded -> return None
    Val(ceiling)
}

// The run-time frames of the caps over one function whose entries scope FS
// or Net (FnBody.effect_scope): each is named after its module, type or
// trait and spelled as a written row's frame (effect_scope_descriptor), and
// frames are separated by a blank line. "" when no cap scopes either, so an
// unscoped cap costs nothing at run time.
sema_effect_cap_frames: fn(caps: [SemaEffectModuleCap]) -> String Never! {
    frames := [String]{}
    loop cap in caps {
        entries := [String]{}
        loop entry in cap.cap.entries -> entries.push(entry.name.copy())
        frame: effect_scope_descriptor("{cap.cap.scope} {cap.cap.owner}", "", false, Val(entries))
        if frame != "" -> frames.push(frame)
    }
    frames.join("\n\n")
}

// A function's effect-scope descriptor `own` under its caps' `frames`: the
// caps' frames are outermost, so a Core publisher's marker stays innermost.
sema_effect_capped_scope: fn(frames: String, own: String) -> String Never! {
    // copy: the frames stay in the per-node table.
    if own == "" -> return frames.copy()
    "{frames}\n\n{own}"
}

sema_effect_nominal_cap: fn(nominal: SemaRegistrationNominal) -> ModuleCap? Never! {
    if nominal.source == .SourceAST(item) {
        if item == {
            .Struct(definition) -> return definition.cap
            .Enum(definition) -> return definition.cap
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    None
}

// Binds the cap of the type `nominal_key` names to a method of it declared
// in `module_identity`. A cap written in the method's own module is labeled
// where it is written; one in another module is named by `file:line`.
sema_effect_bind_type_cap: fn(source: &SemaEffectFunctionSource, caps: [String:SemaEffectTypeCap], nominal_key: String?, module_identity: String) {
    key: nominal_key ?? return
    found: caps.get(key) ?? return
    site: if found.module_identity == module_identity -> None else -> found.cap.site
    source.type_cap = Val(SemaEffectModuleCap{cap: found.cap.cap, site: site})
}

// `#FX(…) name: module` over a file module: every function in the file takes
// the cap, and each file that file declares takes it too. So does an `#FX(…)`
// at the head of a file, named after the file. The result is by graph module
// index, outermost cap first.
sema_effect_file_module_caps: fn(graph_modules: [SemaRegistrationModule], edges: [SemaRegistrationImportEdge]) -> [[SemaEffectModuleCap]] {
    rows := [String:Int]{}
    loop (index, module_row) in graph_modules -> rows[module_row.module_identity] = index
    direct := (loop _ in graph_modules -> [SemaEffectModuleCap]{})
    parents := (loop _ in graph_modules -> [Int]{})
    seen := [String:Bool]{}
    loop edge in edges {
        if edge.declaration.kind == .File(_, _) {
            source: rows.get(edge.source_module_identity) ?? next
            target: rows.get(edge.target_module_identity) ?? next
            key: "{source}:{target}:{edge.declaration.alias}"
            if seen.get(key) != None -> next
            if !sema_effect_declares_file_module(graph_modules[source].program.items, edge.declaration.alias) -> next
            seen[key] = true
            parents[target].push(source)
            cap: sema_effect_file_module_cap(graph_modules[source].program.items, edge.declaration.alias) ?? next
            direct[target].push(SemaEffectModuleCap{cap: cap, site: Val(sema_effect_cap_site(graph_modules[source], cap.span))})
        }
    }
    // A head cap comes last in its own file's row, labeled where it is
    // written; the files it declares name it by `file:line`.
    heads := (loop _ in graph_modules -> false)
    loop (index, module_row) in graph_modules {
        head := module_row.program.file_cap ?? next
        head.owner = sema_effect_source_display(sema_source_file_at(module_row.source_segments, module_row.source_file, module_row.source_origin, head.span))
        direct[index].push(SemaEffectModuleCap{cap: head.copy(), site: Val(sema_effect_cap_site(module_row, head.span))})
        heads[index] = true
    }
    (loop index in 0..<graph_modules.len() -> sema_effect_own_file_caps(sema_effect_file_caps_of(index, direct, parents, 0), heads[index]))
}

sema_effect_cap_site: fn(module_row: SemaRegistrationModule, span: Span) -> String {
    file: sema_effect_source_display(sema_source_file_at(module_row.source_segments, module_row.source_file, module_row.source_origin, span))
    if sema_source_line_at(module_row.source_segments, span) == .Val(line) -> return "{file}:{line}"
    file
}

sema_effect_own_file_caps: fn(caps: [SemaEffectModuleCap], has_head: Bool) -> [SemaEffectModuleCap] Never! {
    own := caps
    if has_head && own.len() > 0 -> own[own.len() - 1].site = None
    own
}

sema_effect_declares_file_module: fn(items: [Item], name: String) -> Bool Never! {
    loop item in items {
        if item == .CodeModule(definition) && definition.name == name && definition.body == None -> return true
    }
    false
}

sema_effect_file_module_cap: fn(items: [Item], name: String) -> ModuleCap? Never! {
    loop item in items {
        if item == .CodeModule(definition) && definition.name == name && definition.body == None -> return definition.cap
    }
    None
}

// The module graph is acyclic (import cycles are load errors); `depth` only
// bounds the walk.
sema_effect_file_caps_of: fn(index: Int, direct: [[SemaEffectModuleCap]], parents: [[Int]], depth: Int) -> [SemaEffectModuleCap] Never! {
    caps := [SemaEffectModuleCap]{}
    if depth > direct.len() -> return caps
    loop parent in parents[index] {
        loop cap in sema_effect_file_caps_of(parent, direct, parents, depth + 1) -> caps.push(cap)
    }
    loop cap in direct[index] -> caps.push(cap.copy())
    caps
}

sema_effect_replayable_diagnostic: fn(node: SemaEffectNode, reached: [String]) -> Diagnostic {
    span: node.replayable_span ?? node.name_span
    diagnostic: sema_error("E0725", span, "`{node.name}` is `#Replayable` but reaches `{sema_effect_show(reached)}`", "`#Replayable` code must replay from explicit inputs; ambient time, randomness, network, or console IO would make the same replay diverge", "inject a deterministic clock/RNG or mockable input, pass recorded data in, or move the ambient effect outside the replayable function")
    diagnostic_with_rights(diagnostic, "replayable", [String]{node.name}, [String]{}, None)
}

// `effect_key`: a method's key is `Owner::name`.
sema_effect_chain_name: fn(function: FnBody) -> String Never! {
    owner: if function.kind == {
        .Method(_, owner_type) -> owner_type
        .TraitMethod(_, _, owner_type, _, _) -> owner_type
        .TopLevel -> {
            return function.name
        }
    }
    if owner == {
        .Named(name) | .Apply(name, _) -> "{sema_effect_symbol_leaf(name)}::{function.name}"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> function.name
    }
}

// Rust `check_effect_boundaries` `panic_site`, with the path to it: the
// functions from `index` to the first one reached depth-first that stops (a
// maximal row, a direct Panic, or a stop sentinel), both ends included, so a
// function that stops itself is its own one-step path. Empty when none stops.
sema_effect_panic_path: fn(nodes: [SemaEffectNode], node_by_key: NameRows, index: Int, seen: &[Bool]) -> [Int] Never! {
    if seen[index] -> return [Int]{}
    seen[index] = true
    if nodes[index].maximal -> return [Int]{index}
    loop effect_name in nodes[index].direct {
        if sema_effect_root(effect_name) == "Panic" -> return [Int]{index}
    }
    loop edge in nodes[index].call_edges {
        if edge == "__jet_panic__" -> return [Int]{index}
    }
    loop edge in nodes[index].call_edges {
        target: sema_effect_node_index(node_by_key, edge) ?? next
        rest: sema_effect_panic_path(nodes, node_by_key, target, seen)
        if rest.len() == 0 -> next
        path := [Int]{index}
        loop step in rest -> path.push(step)
        return path
    }
    [Int]{}
}

// The steps of a reached Panic's call chain after function `node_index`: the
// chain names along sema_effect_panic_path past its first, so a function that
// stops itself has none. "the reachable call graph" when no stop is found.
sema_effect_panic_steps: fn(nodes: [SemaEffectNode], node_by_key: NameRows, node_index: Int) -> [String] Never! {
    seen := (loop _ in nodes -> false)
    path: sema_effect_panic_path(nodes, node_by_key, node_index, seen)
    if path.len() == 0 -> return [String]{"the reachable call graph"}
    steps := [String]{}
    loop at in 1..<path.len() -> steps.push(nodes[path[at]].chain_name)
    steps
}

// The function a denied Panic names as the one that stops: the last step, or
// the denied function itself when it stops directly.
sema_effect_panic_site_name: fn(node: SemaEffectNode, panic_steps: [String]) -> String Never! {
    if panic_steps.len() == 0 -> return node.chain_name
    panic_steps[panic_steps.len() - 1]
}

// A denied Panic's call chain: `first` (the denied function as its report
// names it), then the steps to the function that stops.
sema_effect_panic_chain: fn(first: String, panic_steps: [String]) -> [String] Never! {
    chain := [String]{first}
    loop step in panic_steps -> chain.push(step.copy())
    chain
}

// ────────────────────────────────────────────────────────────────────────────
// Summary construction

SemaEffectSourceIndex: struct {
    by_key: [String:Int]
    by_name: [String:Int]
}

sema_effect_source_index: fn(sources: [SemaEffectFunctionSource]) -> SemaEffectSourceIndex Never! {
    index := SemaEffectSourceIndex{by_key: [String:Int]{}, by_name: [String:Int]{}}
    loop (position, source) in sources {
        if index.by_key.get(source.key) == None -> index.by_key[source.key] = position
        if index.by_name.get(source.name) == None -> index.by_name[source.name] = position
    }
    index
}

// The position of `function`'s source row in its module's sources; the
// caller reads the row in place.
sema_effect_source_position: fn(function: FnBody, index: SemaEffectSourceIndex) -> Int? Never! {
    position: index.by_key.get(function.key) ?? {
        index.by_name.get(function.name) ?? return None
    }
    Val(position)
}

sema_effect_node_add_direct: fn(nodes: &[SemaEffectNode], node_index: Int, name: String, span: Span) Never! {
    if sema_effect_set_add(nodes[node_index].direct, name) {
        nodes[node_index].direct_spans.push(TEffectSpan{name: name, span: span})
    }
}

sema_effect_node_add_edge: fn(nodes: &[SemaEffectNode], node_index: Int, edge: String) Never! {
    sema_effect_set_add(nodes[node_index].call_edges, edge)
}

// `callee` is taken as a value here and may run later through it; only a
// function with a body in this program is an edge.
sema_effect_node_add_value_edge: fn(nodes: &[SemaEffectNode], node_by_key: NameRows, node_index: Int, callee: String) Never! {
    if sema_effect_node_index(node_by_key, callee) == None -> return
    sema_effect_set_add(nodes[node_index].value_edges, callee)
}

sema_effect_node_index: fn(node_by_key: NameRows, key: String) -> Int? Never! {
    name_rows_get_text(node_by_key, key)
}

// Each diagnostic of the batch moves into `all` (the batch is the caller's
// own list), so locating it never copies it.
sema_effect_publish_diagnostics: fn(all: &[Diagnostic], source_segments: [SemaSourceSegment], batch: &&[Diagnostic]) Never! {
    loop diagnostic in batch.move() {
        located: if diagnostic.source_path != None -> diagnostic.move() else -> sema_diagnostic_with_source_location(diagnostic, source_segments)
        all.push(located)
    }
}

sema_effect_node_from_source: fn(function: FnBody, sources: [SemaEffectFunctionSource], source_position: Int?, module_index: Int, library: [SemaLibraryEffectName], diagnostics: &[Diagnostic]) -> SemaEffectNode {
    node := SemaEffectNode{
        key: function.key,
        name: function.name,
        module_identity: function.module_identity,
        module_index: module_index,
        span: function.source_span,
        name_span: function.source_span,
        direct: [String]{},
        direct_spans: [TEffectSpan]{},
        call_edges: [String]{},
        maximal: false,
        maximal_span: None,
        declared: [String]{},
        prohibited: [String]{},
        has_declared_row: false,
        is_pure: function.is_pure,
        is_replayable: false,
        replayable_span: None,
        is_unsafe: function.is_unsafe,
        unsafe_reason: None,
        unsafe_span: None,
        effect_via: None,
        dispatches: [TEffectSpan]{},
    }
    loop effect_name in function.effects.direct {
        if sema_effect_set_add(node.direct, effect_name) -> node.direct_spans.push(TEffectSpan{name: effect_name, span: function.source_span})
    }
    loop edge in function.effects.call_edges -> sema_effect_set_add(node.call_edges, edge)
    loop edge in function.effects.value_edges -> sema_effect_set_add(node.value_edges, edge)
    // copy: the node keeps the writes; the function keeps its effect facts.
    node.module_writes = function.effects.module_writes.copy()
    if function.effects.maximal {
        node.maximal = true
        node.maximal_span = Val(function.source_span)
    }
    node.display_key = "{function.module_name}::{function.name}"
    node.source_display = sema_effect_source_display(function.source_file)
    node.chain_name = sema_effect_chain_name(function)
    node.owner_params = sema_effect_owner_params(function.kind)
    node.type_params = node.owner_params.copy()
    loop param in function.generic_params -> sema_effect_set_add(node.type_params, param.name)
    if function.kind == .TraitMethod(_, _, _, trait_symbol, _) -> node.trait_key = sema_effect_trait_cap_key(trait_symbol.key)
    node.path_first = function.params.len() > 0 && function.params[0].name == "path"
    at: source_position ?? {
        sema_effect_check_tfunc_unsafe(function, diagnostics)
        return node
    }
    actual: sources[at]
    node.span = actual.span
    node.name_span = actual.name_span ?? actual.span
    node.has_declared_row = actual.declared_effects != None
    node.is_pure = actual.is_pure
    node.is_replayable = actual.is_replayable
    node.is_unsafe = actual.is_unsafe
    node.replayable_span = actual.replayable_span
    node.unsafe_reason = actual.unsafe_reason
    node.effect_via = actual.effect_via
    node.unsafe_span = actual.unsafe_span
    // copy: the node keeps the spans; the source row stays with its module input.
    node.loop_spans = actual.loop_spans.copy()
    // copy: as above.
    node.assume_det_spans = actual.assume_det_spans.copy()
    node.memo_span = actual.memo_span
    node.kernel = actual.kernel
    node.module_caps = actual.module_caps.copy()
    if actual.type_cap == .Val(type_cap) -> node.type_cap = Val(type_cap.copy())
    if actual.trait_key != "" -> node.trait_key = actual.trait_key
    if actual.is_unsafe && !sema_effect_check_unsafe_function(actual, diagnostics) {
        // The diagnostic is already source-backed; retain the node so the graph
        // remains inspectable after a failed gate check.
    }
    if actual.declared_effects == .Val(effect_row) {
        if effect_row.len() > 0 -> node.row_span = Val(effect_row[0].span)
        loop entry in effect_row {
            // An open row (`-[..E]>`, `-[IO, ..E]>`) has no closed ceiling:
            // its named effects are a floor, so no bound is checked.
            if entry.name.starts_with("..") {
                node.has_declared_row = false
                next
            }
            prohibited: entry.name.starts_with("!")
            if prohibited && node.prohibition_span == None -> node.prohibition_span = Val(entry.span)
            raw := entry.name
            if prohibited {
                pieces: entry.name.split("!").to_list()
                if pieces.len() > 1 -> raw = pieces[1]
            }
            effect_name: sema_effect_parse_name(raw) ?? {
                // A library effect admits the kernel effects it lists; a
                // denial of it is checked over the library effects reached.
                library_name: sema_library_effect_find(library, raw) ?? {
                    diagnostics.push(sema_effect_unknown(raw, entry.span))
                    next
                }
                if prohibited {
                    node.library_denials.push(SemaLibraryEffectDenial{name: library_name, span: entry.span})
                    next
                }
                loop listed in library_name.kernel -> sema_effect_set_add(node.declared, listed)
                node.library_rows.push(library_name)
                next
            }
            if !prohibited && sema_effect_root(effect_name) == "Panic" {
                diagnostics.push(sema_effect_positive_panic(entry.span))
                next
            }
            if {
                // Memory denials are proved over memory
                // events (E0921), not the ambient prohibition check.
                prohibited && sema_effect_root(effect_name) == "Mem" -> {
                    node.memory_denials.push(EffectRowEntry{name: effect_name, span: entry.span})
                }
                prohibited -> {
                    _ := sema_effect_set_add(node.prohibited, effect_name)
                }
                else -> {
                    _ := sema_effect_set_add(node.declared, effect_name)
                }
            }
        }
    }
    if actual.effect_via != None {
        via_nodes := [SemaEffectNode]{node.move()}
        sema_effect_apply_via(via_nodes, 0, function, diagnostics)
        node = via_nodes.pop() ?? panic("the effect-via node left its list")
    }
    node
}

// Intrinsic producers use the same fact carrier as checked calls. The effect
// row is authoritative producer input: an empty present row means known-pure,
// while an absent row remains unknown and is conservatively maximal downstream.
sema_effect_record_intrinsic_fact: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, api: String, span: Span, facts: SemaCallFacts, diagnostics: &[Diagnostic]) -> Bool Never! {
    wall := sema_effect_check_transaction_wall(environment, program, scopes, facts.effect_bound, api, span, diagnostics)
    allowed: wall ?? return false
    if !allowed -> return false
    caller_key := sema_scope_function_owner_key(scopes)
    // A compile-time value has no owner frame; its sites still feed the
    // ambient time/randomness check (sema_effect_comptime_nondeterministic).
    if caller_key != "" || scopes.comptime_execution_depth > 0 {
        context.call_facts.push(SemaCallSiteFact{
            span: span,
            caller_key: caller_key,
            callee: None,
            facts: facts,
            discarded: false,
            intrinsic_api: Val(api),
        })
    }
    true
}

// Convenience entry point for intrinsic operations whose only call metadata
// is their canonical effect row. Use an empty row to record a known-pure site.
sema_effect_record_intrinsic_effects: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, api: String, span: Span, effect_row: [EffectRowEntry], diagnostics: &[Diagnostic]) -> Bool Never! {
    sema_effect_record_intrinsic_fact(
        environment, program,
        scopes,
        context,
        api,
        span,
        SemaCallFacts{
            return_type: Type.Named{name: "Unit"},
            failure_carrier: TFailureCarrier.Infallible,
            effect_bound: Val(effect_row),
            type_args: [Type]{},
            default_refs: [FunctionDefaultRef]{},
        },
        diagnostics,
    )
}

sema_effect_record_fact: fn(nodes: &[SemaEffectNode], node_by_key: NameRows, node_index: Int, fact: SemaCallSiteFact, diagnostics: &[Diagnostic]) {
    // A foreign body with a known effect root records that root and an open
    // memory dispatch; only an extern with no root, or a C binding whose row no
    // descriptor owns, is an unknown callee that forces the maximal set.
    if fact.foreign_effect_root == .Val(root) {
        effect_name: sema_effect_parse_name(root) ?? {
            diagnostics.push(sema_effect_unknown(root, fact.span))
            return
        }
        sema_effect_node_add_direct(nodes, node_index, effect_name, fact.span)
        sema_effect_record_memory_open(nodes, node_index, fact.span, "foreign function body")
        if fact.foreign_opaque && !nodes[node_index].maximal {
            nodes[node_index].maximal = true
            nodes[node_index].maximal_span = Val(fact.span)
        }
        return
    }
    callee_key: fact.callee.map((callee) -> callee.key) ?? ""
    known_callee: callee_key != "" && sema_effect_node_index(node_by_key, callee_key) != None
    if callee_key != "" -> sema_effect_node_add_edge(nodes, node_index, callee_key)
    // One call site is one call: another body node with the call's span finds
    // the same fact, and a second row would count the callee's arena bytes
    // twice.
    if known_callee && !sema_effect_has_memory_call(nodes[node_index], callee_key, fact.span) {
        executions: sema_effect_memory_executions(nodes[node_index], fact.span)
        nodes[node_index].memory_calls.push(SemaMemoryCall{callee: callee_key, span: fact.span, executions: executions})
    }
    row_known: fact.facts.effect_bound != None
    // The closed `core.db` table carries its declared leaves
    // (`DB.Read` on queries, `DB.Write` on `execute`, the `DB` root on
    // transaction control) even though its body reaches only intrinsics.
    declared_row: !known_callee || sema_effect_core_db_callee(callee_key)
    if fact.facts.effect_bound == .Val(effect_row) {
        loop entry in effect_row {
            raw: entry.name
            if raw.starts_with("!") || raw.starts_with("..") -> next
            effect_name: sema_effect_parse_name(raw) ?? {
                // A callee with a body checks its own row where it is
                // written, library effects included (sema_effect_node_from_source).
                if !known_callee -> diagnostics.push(sema_effect_unknown(raw, entry.span))
                next
            }
            if declared_row -> sema_effect_node_add_direct(nodes, node_index, effect_name, if known_callee -> fact.span else -> entry.span)
        }
    }
    if callee_key == "" && !row_known {
        nodes[node_index].maximal = true
        nodes[node_index].maximal_span = Val(fact.span)
        sema_effect_record_memory_open(nodes, node_index, fact.span, "foreign or dynamically selected function body")
    }
    // A callee with no body in this program has no effects: only its declared
    // row, recorded above, contributes. Its memory behavior stays unproven.
    if callee_key != "" && !known_callee && !row_known {
        sema_effect_record_memory_open(nodes, node_index, fact.span, "callee body is unavailable and has no verified signed memory summary")
    }
}

// A callee declared in `core.db`. The key alone decides it
// (`kind:module:owner:name`): a collecting thread holds only its own node.
sema_effect_core_db_callee: fn(callee_key: String) -> Bool Never! {
    callee_key.contains(":<corelib>/core.db:") || callee_key.contains(":<corelib>/core.db.")
}

sema_effect_record_memory_open: fn(nodes: &[SemaEffectNode], node_index: Int, span: Span, reason: String) Never! {
    source: nodes[node_index].source_display.copy()
    nodes[node_index].memory_opens.push(SemaMemoryOpen{span: span, source: source, reason: reason})
}

// Indices store positions, not copied semantic facts. Caller buckets retain
// source order, including equal-width interval ties; exact duplicates use the
// first row just as the original search did. One index serves every module;
// each walk names its module in its caller (SemaEffectCaller), so walks of
// different modules read the one index at once.
SemaEffectCallIndex: struct {
    modules: [SemaEffectModuleCalls]
    node_by_key: NameRows
    // Rust `seed_trait_dispatch_effects` `<static>` inputs: implementing type
    // names by trait name, and `{trait}::{method}` -> implementing type ->
    // that type's own method node.
    trait_implementers: [String:[String]]{[String:[String]]{}}
    // Owner type name -> the keys of that type's own `close` methods
    // (`…::{Owner}:close`), the targets of `close(value)`.
    close_methods: [String:[String]]{[String:[String]]{}}
    // "{module}|{trait}::{method}#{implementing type leaf}" -> that
    // implementation's own summary key, one flat map (no per-trait map copied
    // on every insert).
    trait_impls: [String:String]{[String:String]{}}
    // "{module}|{trait}::{method}" (sema_effect_trait_cap_key) -> the keys
    // of every implementation of the method in the program, inherited
    // defaults included: the targets of a call through a trait value.
    dyn_impls: [String:[String]]{[String:[String]]{}}
    // The `#FX(…)` cap of each capped trait (sema_effect_trait_caps).
    trait_caps: [String:SemaEffectTypeCap]{[String:SemaEffectTypeCap]{}}
    // The name of the node each `#Unsafe` function's key names
    // (`node_by_key`), so an unsafe-call check reads no node.
    unsafe_names: [String:String]{[String:String]{}}
    // The node of each registered declaration with a body, by DeclID row
    // (-1: none), so a direct call finds its callee's node without its key.
    node_by_decl: [Int]{[Int]{}}
    // Each node's key, in node order, so a walk names its callee's node
    // without reading that node: a collecting thread holds only its own
    // node's row (sema_effect_collect_claimed).
    node_keys: [String]{[String]{}}
    // The effect each Core scope publisher publishes, by key
    // (effect_scope_published_effect), read off its node before the walks:
    // a collecting thread holds only its own node's row.
    published_effects: [String:String]{[String:String]{}}
}

// The effect node of the declaration `callee`, -1 when it has no body here.
sema_effect_decl_node: fn(facts: SemaEffectCallIndex, callee: DeclID) -> Int Never! {
    index: callee.row.index()
    if index >= facts.node_by_decl.len() -> return -1
    facts.node_by_decl[index]
}

// node_by_decl over the DeclTable's `decl_rows` rows: the node of every key
// a declaration registered (`node_decls`: each node's declaration row, -1
// when none). Of two keys that name one declaration the greater keeps it, as
// a walk in key order leaves it.
sema_effect_nodes_by_decl: fn(node_by_key: NameRows, node_decls: [Int], decl_rows: Int) -> [Int] Never! {
    rows := (loop _ in 0..<decl_rows -> -1)
    row_keys := (loop _ in 0..<decl_rows -> -1)
    loop (key_index, key) in node_by_key.texts {
        row: node_decls[node_by_key.rows[key_index]]
        if row < 0 -> next
        if row_keys[row] >= 0 && node_by_key.texts[row_keys[row]] > key -> next
        rows[row] = node_by_key.rows[key_index]
        row_keys[row] = key_index
    }
    rows
}

// The caller a walk reads its call facts under: its module's row in the call
// index and its slot among that module's callers (-1 when it owns no facts).
SemaEffectCaller: struct {
    module_index: Int
    slot: Int
}

SemaEffectModuleCalls: struct {
    facts: [SemaCallSiteFact]
    caller_slots: [String:Int]
    callers: [SemaEffectCallerFacts]
}

// One caller's facts: every position in source order, and the positions of
// each span start (`starts` maps a start to its row in `exact`).
SemaEffectCallerFacts: struct {
    positions: [Int]
    starts: [Int:Int]
    exact: [[Int]]
}

sema_effect_module_calls: fn(facts: [SemaCallSiteFact]) -> SemaEffectModuleCalls Never! {
    // copy: the index outlives the borrowed module row it is built from.
    calls := SemaEffectModuleCalls{facts: facts.copy(), caller_slots: [String:Int]{}, callers: [SemaEffectCallerFacts]{}}
    loop (position, fact) in facts {
        slot := calls.caller_slots.get(fact.caller_key) ?? -1
        if slot < 0 {
            slot = calls.callers.len()
            calls.caller_slots[fact.caller_key] = slot
            calls.callers.push(SemaEffectCallerFacts{positions: [Int]{}, starts: [Int:Int]{}, exact: [[Int]]{}})
        }
        calls.callers[slot].positions.push(position)
        row := calls.callers[slot].starts.get(fact.span.start) ?? -1
        if row < 0 {
            row = calls.callers[slot].exact.len()
            calls.callers[slot].starts[fact.span.start] = row
            calls.callers[slot].exact.push([Int]{})
        }
        calls.callers[slot].exact[row].push(position)
    }
    calls
}

// The caller `key` of module `module`; its slot is -1 when it owns no facts
// there (or the index has no such module: FailureLaw's structure-only walk).
// A walk resolves its caller once, so the per-expression fact lookups below
// never search the caller map.
sema_effect_caller_slot: fn(index: SemaEffectCallIndex, module_index: Int, key: String) -> SemaEffectCaller Never! {
    if module_index < 0 || module_index >= index.modules.len() -> return SemaEffectCaller{module_index: module_index, slot: -1}
    SemaEffectCaller{module_index: module_index, slot: index.modules[module_index].caller_slots.get(key) ?? -1}
}

// The position, in the caller's module facts, of the narrowest fact of the
// caller whose span contains or is contained by `span`; the caller reads the
// fact in place (sema_effect_fact_at).
sema_effect_find_fact: fn(index: SemaEffectCallIndex, caller: SemaEffectCaller, span: Span) -> Int? Never! {
    if caller.slot < 0 -> return None
    calls: index.modules[caller.module_index]
    exact: sema_effect_exact_position(calls.callers[caller.slot], calls.facts, span)
    if exact != None -> return exact
    best := Int?{None}
    best_width := 2147483647
    loop position in calls.callers[caller.slot].positions {
        fact_span: calls.facts[position].span
        if sema_effect_span_contains(fact_span, span) || sema_effect_span_contains(span, fact_span) {
            width: fact_span.end - fact_span.start
            if width < best_width {
                best_width = width
                best = Val(position)
            }
        }
    }
    best
}

sema_effect_find_exact_fact: fn(index: SemaEffectCallIndex, caller: SemaEffectCaller, span: Span) -> Int? Never! {
    if caller.slot < 0 -> return None
    calls: index.modules[caller.module_index]
    sema_effect_exact_position(calls.callers[caller.slot], calls.facts, span)
}

// The first of the caller's facts whose span is exactly `span`.
sema_effect_exact_position: fn(caller: SemaEffectCallerFacts, facts: [SemaCallSiteFact], span: Span) -> Int? Never! {
    row: caller.starts.get(span.start) ?? return None
    loop position in caller.exact[row] {
        if facts[position].span.end == span.end -> return Val(position)
    }
    None
}

// The caller's Clock intrinsic fact whose span is exactly `span`. A Clock
// method is a declared Core method, so its call fact (with a callee) shares
// the site with the intrinsic fact the time route recorded.
sema_effect_clock_intrinsic_position: fn(index: SemaEffectCallIndex, caller: SemaEffectCaller, span: Span) -> Int? Never! {
    if caller.slot < 0 -> return None
    calls: index.modules[caller.module_index]
    row: calls.callers[caller.slot].starts.get(span.start) ?? return None
    loop position in calls.callers[caller.slot].exact[row] {
        fact: calls.facts[position]
        if fact.span.end != span.end || fact.callee != None -> next
        if fact.intrinsic_api == .Val(api) && api.starts_with("Clock.") -> return Val(position)
    }
    None
}

sema_effect_is_call: fn(kind: NodeKind) -> Bool Never! {
    if kind == {
        .Call(_, _, _)
        | .GlobalShared(_, _)
        | .IndirectCall(_, _, _, _)
        | .MethodCall(_, _, _, _)
        | .StaticCall(_, _, _, _, _)
        | .CoreCall(_, _, _, _, _, _)
        | .MathBuiltin(_, _, _)
        | .PreciseBuiltin(_, _, _)
        | .Print(_)
        | .Drop(_)
        | .Close(_)
        | .HostCall(_)
        | .AllocNew(_, _)
        | .BuiltinMethod(_, _, _)
        | .ClosureMethod(_, _, _)
        | .HandleMethod(_, _, _)
        | .NumericMethod(_, _)
        | .NumericBinaryMethod(_, _, _)
        | .SharedGuardWait(_, _, _)
        | .CoreClosureCall(_) -> true
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .ConditionNotify(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .DecodeUnder(_, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .OverflowOpt(_, _, _, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> false
    }
}

// Compiler-owned intrinsic operations have no callee body: host calls
// (Shared access, typed text, `yield`), handle methods (`60s` Duration
// literals and Duration scaling, Dyn accessors, ...), compiler-built
// numeric operations (`1 / 3` as an exact `Fraction`, Decimal and math-type
// arithmetic, numeric casts), the ambient `close(value)` / `drop(value)`
// protocol sugar, and closure intrinsics (`scope.guard`, `on_commit`, task
// spawn), whose lambda bodies the walk visits on their own, and allocator
// constructors (`mem.Arena.new`), whose storage the memory walk accounts.
// Rust records their effects inline (`close`/`drop`/`scope.guard` record
// none) and forces the maximal row only for opaque callees, so one with no
// recorded call fact contributes no effect; it is not an unknown callee.
sema_effect_is_compiler_intrinsic: fn(kind: NodeKind) -> Bool Never! {
    if kind == {
        .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .HostCall(_) | .HandleMethod(_, _, _) -> true
        .Close(_) | .Drop(_) | .CoreClosureCall(_) | .AllocNew(_, _) -> true
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .Print(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> false
    }
}

sema_effect_merge_lambda: fn(nodes: &[SemaEffectNode], node_index: Int, lambda: BodyLambda) Never! {
    loop effect_name in lambda.effects.direct {
        span := lambda.source_span
        loop entry in lambda.effects.direct_spans {
            if entry.name == effect_name -> span = entry.span
        }
        sema_effect_node_add_direct(nodes, node_index, effect_name, span)
    }
    loop edge in lambda.effects.call_edges -> sema_effect_node_add_edge(nodes, node_index, edge)
    if lambda.effects.maximal {
        nodes[node_index].maximal = true
        nodes[node_index].maximal_span = Val(lambda.source_span)
    }
}

// Whether `kind` calls a lambda written in this body, such as a local bound
// to one with `:`. That lambda's effects are already this function's where it
// is written (sema_effect_merge_lambda), so its call is a known body and adds
// nothing, not an unknown callee's maximal row.
sema_effect_local_lambda_call: fn(tree: BodyTree, kind: NodeKind) -> Bool Never! {
    if kind == .IndirectCall(callee, _, _, _) -> return sema_effect_written_lambda(tree, callee)
    false
}

// Whether the node at `value` is a lambda written in this body: the lambda
// itself, a borrow of one, or a `:` local bound to one. A call that pins its
// arguments reads its callee through a generated `:` binder local, which is
// followed the same way.
sema_effect_written_lambda: fn(tree: BodyTree, value: Int) -> Bool Never! {
    node: body_node(tree, value)
    if node.kind == .Lambda(_) -> return true
    if node.kind == .Borrow(place, _) -> return sema_effect_written_lambda(tree, place)
    if node.kind == .Local(local) {
        if local.mutable || local.symbol_id == None -> return false
        loop statement in tree.stmts {
            if statement == .Let(bound, _, init, _, _, _) {
                if bound.symbol_id != local.symbol_id -> next
                return sema_effect_written_lambda(tree, init)
            }
        }
    }
    false
}

sema_effect_record_unresolved_call: fn(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, expression: BodyNode) Never! {
    // A direct call and a shared global's initializer name their callee's
    // node through the callee's DeclID.
    if expression.kind == .Call(callee, _, _) -> return sema_effect_record_decl_call(nodes, facts, node_index, callee, expression.span)
    if expression.kind == .GlobalShared(initializer, _) -> return sema_effect_record_decl_call(nodes, facts, node_index, initializer, expression.span)
    callee_key: if expression.kind == {
        .MethodCall(_, method, _, _) -> method.symbol.key
        .StaticCall(_, _, method, _, _) -> method.symbol.key
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> ""
    }
    if {
        callee_key != "" && sema_effect_node_index(facts.node_by_key, callee_key) != None -> sema_effect_node_add_edge(nodes, node_index, callee_key)
        // A named callee with no body in this program has no effects.
        callee_key != "" -> sema_effect_record_memory_open(nodes, node_index, expression.span, "callee body is unavailable and has no verified signed memory summary")
        else -> {
            nodes[node_index].maximal = true
            nodes[node_index].maximal_span = Val(expression.span)
            sema_effect_record_memory_open(nodes, node_index, expression.span, "foreign or dynamically selected function body")
        }
    }
}

sema_effect_record_decl_call: fn(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, callee: DeclID, span: Span) Never! {
    target: sema_effect_decl_node(facts, callee)
    if target >= 0 {
        sema_effect_node_add_edge(nodes, node_index, facts.node_keys[target])
    } else {
        sema_effect_record_memory_open(nodes, node_index, span, "callee body is unavailable and has no verified signed memory summary")
    }
}

// `attribute_fn_arg`: a named function passed to a function-typed parameter
// flows its effects through to this caller, and the callee may invoke it any
// number of times.
sema_effect_record_function_arguments: fn(nodes: &[SemaEffectNode], node_by_key: NameRows, node_index: Int, tree: BodyTree, args: [BodyCallArg]) Never! {
    loop argument in args {
        if body_type(tree, argument.value) == .Fn(_, _, _, _, _, _) {
            value: body_node(tree, argument.value)
            if value.kind == .ConstRef(symbol) {
                if sema_effect_node_index(node_by_key, symbol.key) == None -> next
                sema_effect_node_add_edge(nodes, node_index, symbol.key)
                nodes[node_index].memory_calls.push(SemaMemoryCall{callee: symbol.key, span: value.span, executions: None})
            }
        }
    }
}

// The closed effect row of a function-typed slot, or None for no row, an
// open row (`-[..E]>`), or a row that is already its own error.
sema_effect_callback_row: fn(ty: Type) -> SemaEffectCallbackRow? {
    if ty == .Fn(_, _, bound, _, _, _) {
        row: bound ?? return None
        parsed := SemaEffectCallbackRow{bound: [String]{}, denied: [String]{}}
        loop entry in row {
            if entry.name.starts_with("..") -> return None
            denial: entry.name.starts_with("!")
            raw: if denial -> entry.name.removeprefix("!") else -> entry.name
            // An unknown or positive `Panic` entry is already its own error;
            // the bound it spoils holds no callback to account.
            effect_name: sema_effect_parse_name(raw) ?? return None
            if denial {
                // A memory denial is proved over memory events (E0921), not
                // over rows, so a callback row does not hold it.
                if sema_effect_root(effect_name) != "Mem" -> sema_effect_set_add(parsed.denied, effect_name)
                next
            }
            if sema_effect_root(effect_name) == "Panic" -> return None
            _ := sema_effect_set_add(parsed.bound, effect_name)
        }
        return Val(parsed)
    }
    None
}

// A named function read whose value type carries a closed effect row records
// that row against the function's node. A function read under its own
// declared row passes trivially; one that took a callback slot's row is
// the obligation sema_effect_check_callback_bounds settles.
sema_effect_record_callback_bound: fn(nodes: &[SemaEffectNode], node_by_key: NameRows, node_index: Int, callee: String, ty: Type, span: Span) {
    row: sema_effect_callback_row(ty) ?? return
    if sema_effect_node_index(node_by_key, callee) == None -> return
    nodes[node_index].callback_bounds.push(SemaEffectCallbackBound{callee: callee, row: row, span: span})
}

// A lambda whose value type carries a closed effect row (the row of the slot
// it fills, or its own written row) records its own row: its call facts, and
// what a walk of its body charges (loops, value reads, stops), on a node
// appended to `nodes` for the walk and removed again.
sema_effect_record_lambda_bound: fn(nodes: &[SemaEffectNode], node_index: Int, facts: SemaEffectCallIndex, caller: SemaEffectCaller, tree: BodyTree, lambda: BodyLambda, ty: Type, span: Span) {
    row: sema_effect_callback_row(ty) ?? return
    // The adapter the compiler writes around an App handler
    // (sema_app_handler_adapter) is no function value the program passes:
    // the function registering the handler already carries the handler's
    // effects, so the App's internal handler slot holds it to no row.
    if lambda.source_params.len() == 1 && lambda.source_params[0] == SEMA_APP_ADAPTER_PARAM -> return
    // copy: the lambda node starts from its owner's facts and spans; the
    // owner node stays in the graph.
    lambda_node := nodes[node_index].copy()
    lambda_node.key = "{nodes[node_index].key}#lambda@{lambda.source_span.start}"
    lambda_node.direct = [String]{}
    lambda_node.direct_spans = [TEffectSpan]{}
    lambda_node.call_edges = [String]{}
    lambda_node.maximal = false
    lambda_node.maximal_span = None
    lambda_node.callback_bounds = [SemaEffectCallbackBound]{}
    lambda_node.lambda_bounds = [SemaEffectLambdaBound]{}
    nodes.push(lambda_node)
    lambda_index: nodes.len() - 1
    sema_effect_merge_lambda(nodes, lambda_index, lambda)
    ignored := [Diagnostic]{}
    sema_effect_walk_lambda_children(SemaEffectWalk.LambdaBody{node_index: lambda_index}, nodes, facts, ignored, caller, tree, lambda)
    walked := nodes.pop() ?? panic("the lambda's row node left the graph")
    nodes[node_index].lambda_bounds.push(SemaEffectLambdaBound{direct: walked.direct.move(), call_edges: walked.call_edges.move(), maximal: walked.maximal, row: row, span: span})
}

// E0747: a named function's contract is its declared row (or `-[]>`); an
// undeclared function is judged by its solved row. A denial is judged by the
// solved row, which holds the deny-only rights (`Panic`, `Mem`); one the
// function's own row already denies is its own E0749.
sema_effect_check_callback_bounds: fn(nodes: [SemaEffectNode], node_by_key: NameRows, solved: [[String]], node_index: Int, diagnostics: &[Diagnostic]) {
    loop obligation in nodes[node_index].callback_bounds {
        target: sema_effect_node_index(node_by_key, obligation.callee) ?? next
        row: if nodes[target].has_declared_row || nodes[target].is_pure -> nodes[target].declared else -> solved[target]
        over: sema_effect_uncovered(row, obligation.row.bound)
        if over.len() > 0 -> diagnostics.push(sema_effect_callback_diagnostic(over, obligation.row.bound, obligation.span))
        denied := [String]{}
        loop name in sema_effect_covered(solved[target], obligation.row.denied) {
            if sema_effect_covered([String]{name}, nodes[target].prohibited).len() == 0 -> sema_effect_set_add(denied, name)
        }
        if denied.len() > 0 -> diagnostics.push(sema_effect_callback_denied_diagnostic(denied, obligation.row, obligation.span))
    }
    loop obligation in nodes[node_index].lambda_bounds {
        inferred := obligation.direct.copy()
        if obligation.maximal -> sema_effect_set_union(inferred, authority_grantable_roots())
        loop edge in obligation.call_edges {
            if edge == "__jet_panic__" {
                sema_effect_set_add(inferred, "Panic")
                next
            }
            target: sema_effect_node_index(node_by_key, edge) ?? next
            sema_effect_set_union(inferred, solved[target])
        }
        over: sema_effect_uncovered(inferred, obligation.row.bound)
        if over.len() > 0 -> diagnostics.push(sema_effect_callback_diagnostic(over, obligation.row.bound, obligation.span))
        denied: sema_effect_covered(inferred, obligation.row.denied)
        if denied.len() > 0 -> diagnostics.push(sema_effect_callback_denied_diagnostic(denied, obligation.row, obligation.span))
    }
}

sema_effect_symbol_leaf: fn(key: String) -> String Never! {
    parts: key.split(":").to_list()
    if parts.len() == 0 -> key else -> parts[parts.len() - 1]
}

// A call through a trait value runs whichever implementation the value
// holds. A trait method's declared row bounds it (recorded with the call).
// Otherwise the trait's `#FX(…)` ceiling is its row, and with no ceiling it
// takes the union of every implementation of the method in the program,
// inherited defaults included. A trait with no implementation is the
// open-world dispatch (E0743 under a ceiling).
sema_effect_record_dispatch: fn(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, tree: BodyTree, expression: BodyNode, fact: SemaCallSiteFact) Never! {
    if fact.facts.effect_bound != None -> return
    if expression.kind == {
        .MethodCall(receiver, method, _, _) -> {
            trait_owner: method.trait_owner ?? return
            if body_type(tree, receiver) == {
                .TraitObject(_) -> {}
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> return
            }
            trait_key: sema_effect_trait_cap_key(trait_owner.key)
            if facts.trait_caps.get(trait_key) == .Val(found) {
                // A bare `#FX` above the trait is the empty ceiling: the
                // dispatch reaches nothing.
                if sema_effect_cap_ceiling(found.cap.cap) == .Val(ceiling) {
                    loop effect_name in ceiling -> sema_effect_node_add_direct(nodes, node_index, effect_name, fact.span)
                    return
                }
            }
            impls: facts.dyn_impls.get("{trait_key}::{method.name}") ?? [String]{}
            if impls.len() == 0 {
                nodes[node_index].dispatches.push(TEffectSpan{name: "{sema_effect_symbol_leaf(trait_owner.key)}::{method.name}", span: fact.span})
                return
            }
            loop impl_key in impls -> sema_effect_node_add_edge(nodes, node_index, impl_key)
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
    }
}

// The functions `node` takes as values, the value edges of `node_index`: a
// named function read, a named function value, and every implementation the
// program holds of a method called through a trait value (the value may be
// any of them).
sema_effect_record_value_reads: fn(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, tree: BodyTree, expression: Int, node: BodyNode) Never! {
    if node.kind == {
        .ConstRef(symbol) -> {
            if body_type(tree, expression) == .Fn(_, _, _, _, _, _) -> sema_effect_node_add_value_edge(nodes, facts.node_by_key, node_index, symbol.key)
        }
        .FnValue(kind) -> {
            if kind == .NamedFn(function, _) {
                if function == .Val(decl) {
                    target: sema_effect_decl_node(facts, decl)
                    if target >= 0 -> sema_effect_set_add(nodes[node_index].value_edges, facts.node_keys[target])
                }
            }
        }
        .MethodCall(receiver, method, _, _) -> {
            trait_owner: method.trait_owner ?? return
            if body_type(tree, receiver) == .TraitObject(_) {
                trait_name: sema_effect_symbol_leaf(trait_owner.key)
                trait_module: sema_effect_symbol_module(trait_owner.key) ?? ""
                owners: facts.trait_implementers.get("{trait_module}|{trait_name}") ?? [String]{}
                loop owner in owners {
                    if facts.trait_impls.get("{trait_module}|{trait_name}::{method.name}#{owner}") == .Val(impl_key) -> sema_effect_node_add_value_edge(nodes, facts.node_by_key, node_index, impl_key)
                }
            }
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
    }
}

// Rust `seed_trait_dispatch_effects` / generic dispatch: a call through a
// generic bound (`producer: P` with `P: Producer`) is statically selected after
// type inference. When the trait method declares a row, the call has that
// row. Otherwise, when the receiver's type is one of this function's type
// parameters, the call is a param dispatch: the caller that binds the
// parameter runs the selected implementation (sema_effect_resolve_type_params).
// Any other receiver takes the union of every implementation's summary
// (sema_effect_add_dispatch_union). Only a trait-object receiver is the
// open-world dispatch that stays maximal for a row-less method.
sema_effect_record_static_dispatch: fn(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, tree: BodyTree, expression: BodyNode, fact: SemaCallSiteFact) -> Bool Never! {
    if fact.facts.effect_bound != None -> return false
    if expression.kind == {
        .MethodCall(receiver, method, _, _) -> {
            trait_owner: method.trait_owner ?? return false
            receiver_type: body_type(tree, receiver)
            if receiver_type == .TraitObject(_) -> return false
            if sema_effect_node_index(facts.node_by_key, method.symbol.key) != None -> return false
            sema_effect_record_memory_open(nodes, node_index, fact.span, "generic trait dispatch has no sealed target set")
            // Implementations group under the trait's own module, from
            // whichever module they are written in (sema_effect_add_trait_impls).
            trait_name: sema_effect_symbol_leaf(trait_owner.key)
            trait_module: sema_effect_symbol_module(trait_owner.key) ?? ""
            impls_key: "{trait_module}|{trait_name}::{method.name}"
            if receiver_type == .Named(param) && nodes[node_index].type_params.contains(param) {
                nodes[node_index].param_dispatches.push(SemaEffectParamDispatch{param: param, impls_key: impls_key})
                return true
            }
            sema_effect_add_dispatch_union(nodes, facts, node_index, impls_key, fact.span)
            true
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> false
    }
}

// Every implementation of `impls_key` (`{module}|{trait}::{method}`) as a call
// edge of `node_index`. An implementing type with no summary of its own for
// the method (a trait default body, an unloaded impl) is unresolved, and so
// is a trait with no implementation: either forces the maximal row, as in
// Rust.
sema_effect_add_dispatch_union: fn(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, impls_key: String, span: Span) Never! {
    trait_key: impls_key.cut_last("::") ?? return
    owners: facts.trait_implementers.get(trait_key.before) ?? [String]{}
    unresolved := owners.len() == 0
    loop owner in owners {
        if facts.trait_impls.get("{impls_key}#{owner}") == .Val(impl_key) {
            sema_effect_node_add_edge(nodes, node_index, impl_key)
        } else {
            unresolved = true
        }
    }
    if unresolved {
        nodes[node_index].maximal = true
        nodes[node_index].maximal_span = Val(span)
    }
}

// A call that binds type parameters: a method of a generic type (`t.run()`
// with `t: Traced<Loud>`, or `Traced<Loud>.new()`) or a generic function
// with its type arguments.
sema_effect_record_instantiation: fn(nodes: &[SemaEffectNode], node_index: Int, tree: BodyTree, expression: BodyNode, fact: SemaCallSiteFact) Never! {
    callee: fact.callee ?? return
    owner_args := [Type]{}
    type_args := [Type]{}
    owner_label := ""
    if expression.kind == {
        .MethodCall(receiver, _, args, _) -> {
            receiver_type: body_type(tree, receiver)
            if receiver_type == .Apply(_, values) {
                owner_args = values
                owner_label = type_name(receiver_type)
            }
            type_args = args
        }
        .StaticCall(_, owner_type, _, args, _) -> {
            if owner_type == .Val(owner) {
                if owner == .Apply(_, values) {
                    owner_args = values
                    owner_label = type_name(owner)
                }
            }
            type_args = args
        }
        .Call(_, args, _) -> type_args = args
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> return
    }
    if owner_args.len() == 0 && type_args.len() == 0 -> return
    label := owner_label
    if type_args.len() > 0 {
        shown: (loop arg in type_args -> type_name(arg)).join(", ")
        name: sema_effect_symbol_leaf(callee.key)
        label = if owner_label == "" -> "{name}<{shown}>" else -> "{owner_label}.{name}<{shown}>"
    }
    nodes[node_index].instantiations.push(SemaEffectInstantiation{callee: callee.key, owner_args: owner_args, type_args: type_args, label: label, span: fact.span})
}

// The owner type's parameters of a method, in the order a receiver's type
// arguments bind them; none when the owner isn't written with bare
// parameters (`impl Box<Int>`), so no site binds them by position.
sema_effect_owner_params: fn(kind: TFuncKind) -> [String] Never! {
    owner_type: if kind == {
        .Method(_, owner) -> owner
        .TraitMethod(_, _, owner, _, _) -> owner
        .TopLevel -> return [String]{}
    }
    names := [String]{}
    if owner_type == .Apply(_, args) {
        loop arg in args {
            if arg == .Named(name) {
                names.push(name)
            } else {
                return [String]{}
            }
        }
    }
    names
}

// The type `site` binds to `callee`'s parameter `param`, if it binds one.
sema_effect_param_binding: fn(callee: SemaEffectNode, site: SemaEffectInstantiation, param: String) -> Type? Never! {
    loop (position, name) in callee.owner_params {
        if name == param {
            if callee.owner_params.len() != site.owner_args.len() -> return None
            return Val(site.owner_args[position])
        }
    }
    own := 0
    loop name in callee.type_params {
        if callee.owner_params.contains(name) -> next
        if name == param {
            if own < site.type_args.len() -> return Val(site.type_args[own])
            return None
        }
        own += 1
    }
    None
}

sema_effect_has_param_dispatch: fn(rows: [SemaEffectParamDispatch], wanted: SemaEffectParamDispatch) -> Bool Never! {
    loop row in rows {
        if row.param == wanted.param && row.impls_key == wanted.impls_key -> return true
    }
    false
}

// What a type or function parameter does belongs to the caller that binds
// it: `Traced<Parser>` does Traced's work plus Parser's, charged where
// `Traced<Parser>` is written. A function's own row leaves out its param
// dispatches. A site that binds a parameter to one of its caller's own
// parameters forwards the dispatch to the caller (a fixed point). A site that
// binds it to a concrete type adds that type's implementation as the
// caller's call edge and an instance reach naming the instantiation. A
// binding the walk didn't see (a call recorded without its type arguments,
// or a type with no implementation of its own) takes every implementation,
// as an unbound generic dispatch does.
sema_effect_resolve_type_params: fn(nodes: &[SemaEffectNode], calls: SemaEffectCallIndex) Never! {
    open := loop node in nodes -> node.param_dispatches.copy()
    changed := true
    loop changed {
        changed = false
        loop index in 0..<nodes.len() {
            loop site in nodes[index].instantiations {
                callee: sema_effect_node_index(calls.node_by_key, site.callee) ?? next
                forwarded := [SemaEffectParamDispatch]{}
                loop dispatch in open[callee] {
                    bound: sema_effect_param_binding(nodes[callee], site, dispatch.param) ?? next
                    if bound == .Named(name) && nodes[index].type_params.contains(name) -> forwarded.push(SemaEffectParamDispatch{param: name, impls_key: dispatch.impls_key})
                }
                loop row in forwarded {
                    if sema_effect_has_param_dispatch(open[index], row) -> next
                    open[index].push(row)
                    changed = true
                }
            }
        }
    }
    loop index in 0..<nodes.len() {
        bound_callees := [String]{}
        sites: nodes[index].instantiations.copy()
        loop site in sites {
            callee: sema_effect_node_index(calls.node_by_key, site.callee) ?? next
            sema_effect_set_add(bound_callees, site.callee)
            loop dispatch in open[callee] {
                bound: sema_effect_param_binding(nodes[callee], site, dispatch.param)
                if bound == .Val(ty) {
                    if ty == .Named(name) && nodes[index].type_params.contains(name) -> next
                    owner: sema_effect_symbol_leaf(type_name(ty))
                    if calls.trait_impls.get("{dispatch.impls_key}#{owner}") == .Val(impl_key) {
                        sema_effect_node_add_edge(nodes, index, impl_key)
                        nodes[index].instance_reaches.push(SemaEffectInstanceReach{label: site.label, target: impl_key, span: site.span})
                        next
                    }
                }
                sema_effect_add_dispatch_union(nodes, calls, index, dispatch.impls_key, site.span)
            }
        }
        edges: nodes[index].call_edges.copy()
        span: nodes[index].span
        loop edge in edges {
            callee: sema_effect_node_index(calls.node_by_key, edge) ?? next
            if open[callee].len() == 0 || bound_callees.contains(edge) -> next
            loop dispatch in open[callee] -> sema_effect_add_dispatch_union(nodes, calls, index, dispatch.impls_key, span)
        }
    }
    // A function's row leaves out what its parameters' bindings do, so a
    // discarded call of it is not proven pure (sema_effect_check_discarded).
    slot := 0
    loop rows in open.move() {
        nodes[slot].param_dispatches = rows
        slot += 1
    }
}

// The instance reaches of `node` with each target's solved row.
sema_effect_instance_notes: fn(nodes: [SemaEffectNode], node_by_key: NameRows, solved: [[String]], node: SemaEffectNode) -> [SemaEffectInstanceNote] Never! {
    notes := [SemaEffectInstanceNote]{}
    loop reach in node.instance_reaches {
        target: sema_effect_node_index(node_by_key, reach.target) ?? next
        notes.push(SemaEffectInstanceNote{label: reach.label, callee: nodes[target].chain_name, row: solved[target], span: reach.span})
    }
    notes
}

// A report over `reported` effects labels each instantiation whose
// implementation brings one of them, naming the instantiation.
sema_effect_with_instance_notes: fn(diagnostic: Diagnostic, notes: [SemaEffectInstanceNote], reported: [String]) -> Diagnostic {
    labeled := diagnostic
    loop note in notes {
        hits := [String]{}
        loop effect_name in note.row {
            if sema_effect_declared_hits(reported, effect_name).len() > 0 -> sema_effect_set_add(hits, effect_name)
        }
        if hits.len() == 0 -> next
        labeled = diagnostic_with_label(labeled, note.span, "`{note.label}` runs `{note.callee}` here, which uses `{sema_effect_show(hits)}`")
    }
    labeled
}

// A Core call's declared effects from its record: the root of its effect
// kind (unless its leaf refines that root) and its leaf, as
// sema_call_core_record_effects records them on a call-site fact.
sema_effect_record_core_row: fn(nodes: &[SemaEffectNode], node_index: Int, record: CoreCallRecord, span: Span) Never! {
    leaf_name: record.effect_leaf ?? ""
    if record.effect_kind == .Val(root_name) {
        if leaf_name == "" || !sema_effect_covers(root_name, leaf_name) {
            if sema_effect_parse_name(root_name) == .Val(root) -> sema_effect_node_add_direct(nodes, node_index, root, span)
        }
    }
    if leaf_name != "" {
        if sema_effect_parse_name(leaf_name) == .Val(leaf) -> sema_effect_node_add_direct(nodes, node_index, leaf, span)
    }
}

// A call to a Core scope publisher narrows the effect the callee declares to
// the scope its constant first argument names: `files.read("assets/a.png")`
// needs `FS.Read("assets/a.png")`. A run-time argument names no scope, so
// that call needs the bare effect (EffectScope.jet).
sema_effect_record_scope: fn(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, tree: BodyTree, node: BodyNode, fact: SemaCallSiteFact) Never! {
    callee_key: fact.callee.map((callee) -> callee.key) ?? return
    // A publisher with no body here, such as `core.http.get`, publishes by key.
    published: facts.published_effects.get(callee_key) ?? {
        effect_scope_published_effect(callee_key, false, [String]{}) ?? return
    }
    if sema_effect_call_scope(tree, node, published) == .Val(scope) {
        scoped: effect_scope_name(published, scope)
        loop call in nodes[node_index].scoped_calls {
            if call.callee == callee_key && call.scoped == scoped -> return
        }
        nodes[node_index].scoped_calls.push(SemaEffectScopedCall{callee: callee_key, published: published, scoped: scoped})
    } else if !nodes[node_index].bare_scope_callees.contains(callee_key) {
        nodes[node_index].bare_scope_callees.push(callee_key)
    }
}

// The scope a publisher call's first argument names for `effect`, when that
// argument is a string literal whose constant text names one.
sema_effect_call_scope: fn(tree: BodyTree, node: BodyNode, published: String) -> String? Never! {
    if node.kind == .Call(_, _, args) {
        if args.len() == 0 -> return None
        argument: body_node(tree, args[0].value)
        if argument.kind == .StrLit(parts) {
            text := ""
            loop part in parts {
                if part == .Literal(piece) {
                    text = "{text}{piece}"
                } else {
                    return effect_scope_of_argument(published, text, false)
                }
            }
            return effect_scope_of_argument(published, text, true)
        }
    }
    None
}

// `close(value)`: an edge to the value type's own `close` method, the
// function codegen calls for it. Methods are indexed by their owner type's
// name, so a same-named type in another module adds its method too: the row
// may only grow, never miss one.
sema_effect_record_close: fn(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, value_type: Type) Never! {
    owner: if sema_expr_unwrap_tag(value_type) == {
        .Named(name) | .Apply(name, _) -> sema_effect_symbol_leaf(name)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {
            return
        }
    }
    keys: facts.close_methods.get(owner) ?? [String]{}
    loop key in keys -> sema_effect_node_add_edge(nodes, node_index, key)
}

// A loop over a registered Iterable calls its `iter`, its iterator's `next`
// on every step and that iterator's own `close` when the loop ends (JetIR
// ir_iterable_walk), so their effects are the loop's: edges to all three, the
// close methods found by owner name as for `close(value)`. A lambda's rows
// come from its call facts, which hold no loop, so its loops charge the
// enclosing function (SemaEffectWalk.LambdaBody).
sema_effect_record_iterable_loop: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, iter_type: String, iter_symbol: String, next_symbol: String, span: Span) Never! {
    node_index: if walk == {
        .Collect(index) | .LambdaBody(index) -> index
        .Unsafe(_) | .PreludeDemands(_) -> return
        .Region(index, region) -> if sema_effect_span_contains(region, span) -> index else -> return
    }
    sema_effect_node_add_edge(nodes, node_index, iter_symbol)
    sema_effect_node_add_edge(nodes, node_index, next_symbol)
    keys: facts.close_methods.get(sema_effect_symbol_leaf(iter_type)) ?? [String]{}
    loop key in keys -> sema_effect_node_add_edge(nodes, node_index, key)
}

// The declaring module of a `kind:{module}::{name}` type symbol key
// (`symbol_id` with an empty owner).
sema_effect_symbol_module: fn(key: String) -> String? Never! {
    head: key.cut_last("::") ?? return None
    kind_and_module: head.before.split_once(":") ?? return None
    Val(kind_and_module.after)
}

sema_effect_walk_expr: fn(nodes: &[SemaEffectNode], node_index: Int, tree: BodyTree, expression: Int, facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller) {
    node: body_node(tree, expression)
    if sema_effect_walk_expr_enter(nodes, node_index, tree, expression, node, facts, diagnostics, caller) -> sema_effect_walk_expr_children(SemaEffectWalk.Collect{node_index: node_index}, nodes, facts, diagnostics, caller, tree, node)
}

// sema_effect_walk_expr's own work on `node`, the node at `expression`;
// false when its children aren't walked.
sema_effect_walk_expr_enter: fn(nodes: &[SemaEffectNode], node_index: Int, tree: BodyTree, expression: Int, node: BodyNode, facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller) -> Bool {
    sema_effect_record_comptime_input(nodes, node_index, node)
    if {
        // The suspended determinism checks record nothing for the call.
        sema_effect_in_assume_det(nodes[node_index], node.span) -> {}
        // A written lambda's effects are already this function's.
        sema_effect_local_lambda_call(tree, node.kind) -> {}
        sema_effect_is_call(node.kind) -> {
            // Rust's `Clock.{method}` check runs before the declared method's
            // call is recorded: a pure body reports E3403 and records nothing.
            if sema_effect_clock_intrinsic_position(facts, caller, node.span) == .Val(clock) && sema_effect_report_nondeterministic_intrinsic(nodes, node_index, facts.modules[caller.module_index].facts[clock], node.span, diagnostics) -> return true
            found: sema_effect_find_fact(facts, caller, node.span)
            if found == {
                .Val(position) -> {
                    value: facts.modules[caller.module_index].facts[position]
                    nondeterministic: sema_effect_nondeterministic_core(nodes[node_index], node, value, sema_effect_callee_module(nodes, facts, node))
                    if nondeterministic == .Val(api) {
                        // Rust returns before recording the call's effects, so
                        // the pure function reports E3403 instead of E3401.
                        nodes[node_index].nondeterministic_call = true
                        diagnostics.push(sema_error("E3403", node.span, "`{api}` is non-deterministic and cannot appear in a pure evaluation.", "Pure evaluation must produce the same result on every machine.", "remove this call, or remove the enclosing function's explicit empty effect bound."))
                    } else if !sema_effect_report_nondeterministic_intrinsic(nodes, node_index, value, node.span, diagnostics) {
                        if !sema_effect_record_static_dispatch(nodes, facts, node_index, tree, node, value) {
                            sema_effect_record_fact(nodes, facts.node_by_key, node_index, value, diagnostics)
                            sema_effect_record_scope(nodes, facts, node_index, tree, node, value)
                            sema_effect_record_dispatch(nodes, facts, node_index, tree, node, value)
                            sema_effect_record_instantiation(nodes, node_index, tree, node, value)
                        }
                    }
                }
                .None -> {
                    // A Core call checked without a call-site fact still
                    // carries its record: its declared root and leaf are its
                    // effects, never an unknown callee's maximal row.
                    if node.kind == .CoreCall(record, _, _, _, _, _) {
                        sema_effect_record_core_row(nodes, node_index, record, node.span)
                    } else if !sema_effect_is_compiler_intrinsic(node.kind) {
                        sema_effect_record_unresolved_call(nodes, facts, node_index, node)
                    }
                }
            }
        }
        else -> {
            found: sema_effect_find_exact_fact(facts, caller, node.span)
            if found == .Val(position) {
                value: facts.modules[caller.module_index].facts[position]
                if !sema_effect_report_nondeterministic_intrinsic(nodes, node_index, value, node.span, diagnostics) -> sema_effect_record_fact(nodes, facts.node_by_key, node_index, value, diagnostics)
            }
        }
    }
    sema_effect_record_value_reads(nodes, facts, node_index, tree, expression, node)
    sema_effect_record_stop(nodes, node_index, node)
    if node.kind == {
        .Call(_, _, args) | .IndirectCall(_, _, args, _) -> sema_effect_record_function_arguments(nodes, facts.node_by_key, node_index, tree, args)
        // `close(value)` runs the value type's own `Close.close`, so that
        // method's effects are this function's (codegen calls it directly).
        .Close(value) -> sema_effect_record_close(nodes, facts, node_index, body_type(tree, value))
        .Lambda(value) -> {
            sema_effect_merge_lambda(nodes, node_index, value)
            sema_effect_walk_lambda_children(SemaEffectWalk.LambdaBody{node_index: node_index}, nodes, facts, diagnostics, caller, tree, value)
            sema_effect_record_lambda_bound(nodes, node_index, facts, caller, tree, value, body_type(tree, expression), node.span)
            return false
        }
        .StrLit(parts) -> {
            interpolated: loop part in parts {
                if part == .Interpolation(_, _) -> break true
            } ?? false
            if interpolated -> sema_effect_push_memory_event(nodes, node_index, node.span, "string interpolation allocates a new `String`", "alloc", None)
        }
        .List(values, _) | .ListLit(values) -> {
            if values.len() > 0 && !sema_effect_is_fixed_list(body_type(tree, expression)) -> sema_effect_push_memory_event(nodes, node_index, node.span, "list construction allocates backing storage", "alloc", None)
        }
        .ConstRef(symbol) -> sema_effect_record_callback_bound(nodes, facts.node_by_key, node_index, symbol.key, body_type(tree, expression), node.span)
        // A `[U8]{"…"}` byte value (one checked byte constant) builds the same
        // backing storage its per-element list spelling would.
        .CtLit(value) -> {
            if value == .Bytes(bytes) && bytes.len() > 0 && !sema_effect_is_fixed_list(body_type(tree, expression)) -> sema_effect_push_memory_event(nodes, node_index, node.span, "list construction allocates backing storage", "alloc", None)
        }
        .Map(entries) | .MapLit(entries) -> {
            if entries.len() > 0 -> sema_effect_push_memory_event(nodes, node_index, node.span, "map construction allocates backing storage", "alloc", None)
        }
        // Rust `Arena.new`/`Bump.new`: a literal capacity is the proven bound.
        .AllocNew(ctor, args) -> {
            allocator: if ctor == {
                .Arena -> "Arena"
                .Bump -> "Bump"
                .Pool | .Fixed(_) | .FixedOver -> ""
            }
            if allocator != "" {
                bound := Int?{None}
                if args.len() > 0 && body_node(tree, args[0].value).kind == .IntLit(bytes, _) && bytes >= 0 -> bound = Val(bytes)
                sema_effect_push_memory_event(nodes, node_index, node.span, "`{allocator}.new` reserves bounded arena storage", "arena", bound)
                sema_effect_push_memory_event(nodes, node_index, node.span, "`{allocator}.new` allocates from arena storage", "alloc", None)
            }
        }
        // A copy of a `Shared<T>` handle retains one more reference.
        .ExplicitCopy(_) -> {
            ty: body_type(tree, expression)
            if ty == .Shared(_) -> sema_effect_push_memory_event(nodes, node_index, node.span, "`copy` of `{type_name(ty)}` retains a shared reference", "rc", None)
        }
        .Clone(_, _) -> {
            ty: body_type(tree, expression)
            if ty == .Shared(_) -> sema_effect_push_memory_event(nodes, node_index, node.span, "implicit copy of `{type_name(ty)}` retains a shared reference", "rc", None)
        }
        // `Shared{x}` (Rust `Shared.new`): new shared storage that every
        // handle copy retains.
        .StaticCall(owner, _, method, _, _) -> {
            if owner == .Prelude(_, path, _) && path == "jet_std::JetShared" && method.name == "new" {
                sema_effect_push_memory_event(nodes, node_index, node.span, "`Shared{{…}}` allocates shared storage", "alloc", None)
                sema_effect_push_memory_event(nodes, node_index, node.span, "`Shared{{…}}` introduces reference-counted ownership", "rc", None)
            }
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .TraitConst(_, _, _) | .GlobalShared(_, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListSpread(_) | .PoolSlot(_, _, _, _, _, _) | .MaterializeView(_) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
    }
    true
}

sema_effect_collect_function: fn(nodes: &[SemaEffectNode], node_index: Int, function: FnBody, facts: SemaEffectCallIndex, module_index: Int, diagnostics: &[Diagnostic]) {
    caller: sema_effect_caller_slot(facts, module_index, function.key)
    loop statement in function.body {
        sema_effect_walk_stmt_children(SemaEffectWalk.Collect{node_index: node_index}, nodes, facts, diagnostics, caller, function.tree, function.tree.stmts[statement])
    }
}

sema_effect_check_unsafe_expr: fn(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, caller: SemaEffectCaller, tree: BodyTree, expression: Int, audited: Bool, diagnostics: &[Diagnostic]) {
    node: body_node(tree, expression)
    if sema_effect_check_unsafe_enter(nodes, facts, caller, tree, node, audited, diagnostics) -> sema_effect_walk_expr_children(SemaEffectWalk.Unsafe{audited: audited}, nodes, facts, diagnostics, caller, tree, node)
}

// sema_effect_check_unsafe_expr's own work on `node`; false when its
// children aren't walked.
sema_effect_check_unsafe_enter: fn(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, caller: SemaEffectCaller, tree: BodyTree, node: BodyNode, audited: Bool, diagnostics: &[Diagnostic]) -> Bool {
    if sema_effect_is_call(node.kind) {
        found: sema_effect_find_fact(facts, caller, node.span)
        if found == .Val(position) {
            if facts.modules[caller.module_index].facts[position].callee == .Val(callee) {
                if facts.unsafe_names.get(callee.key) == .Val(name) -> sema_effect_require_unsafe_call(name, true, audited, node.span, diagnostics)
            }
            if facts.modules[caller.module_index].facts[position].unsafe_foreign_name == .Val(foreign) {
                _: sema_effect_require_unsafe_call(foreign, true, audited, node.span, diagnostics)
            }
            if facts.modules[caller.module_index].facts[position].foreign_capability == .Val(capability) && !audited {
                row: diagnostic_registry_row("E0702") ?? panic("E0702 has no registry row")
                diagnostics.push(sema_error("E0702", node.span, row.what.replace("{{subject}}", "call `{capability.name}` uses capability `{capability.sigil}` outside `#Unsafe`"), "a foreign capability can write to or transfer ownership of Jet storage, so a raw call needs an audited boundary", "call `{capability.name}` inside `#Unsafe(\"…\") {{ … }}`, or expose it through a generated typed binding"))
            }
        }
    }
    if node.kind == {
        .Lambda(value) -> {
            if value.executable == {
                .Expr(inner) -> {
                    sema_effect_check_unsafe_expr(nodes, facts, caller, tree, inner, false, diagnostics)
                }
                .Block(body) -> {
                    sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, false, diagnostics)
                }
            }
            return false
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
    }
    true
}

sema_effect_check_unsafe_condition: fn(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, caller: SemaEffectCaller, tree: BodyTree, condition: BodyIfCond, audited: Bool, diagnostics: &[Diagnostic]) {
    if condition == {
        .Plain(value) -> sema_effect_check_unsafe_expr(nodes, facts, caller, tree, value, audited, diagnostics)
        .And(left, right) -> {
            sema_effect_check_unsafe_condition(nodes, facts, caller, tree, left, audited, diagnostics)
            sema_effect_check_unsafe_condition(nodes, facts, caller, tree, right, audited, diagnostics)
        }
        .IfLet(_, subject) -> sema_effect_check_unsafe_expr(nodes, facts, caller, tree, subject, audited, diagnostics)
    }
}

sema_effect_check_unsafe_contracts: fn(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, caller: SemaEffectCaller, tree: BodyTree, contracts: [BodyContract], audited: Bool, diagnostics: &[Diagnostic]) {
    loop contract in contracts {
        sema_effect_check_unsafe_expr(nodes, facts, caller, tree, contract.condition, audited, diagnostics)
        sema_effect_check_unsafe_expr(nodes, facts, caller, tree, contract.message, audited, diagnostics)
    }
}

sema_effect_check_unsafe_statements_tree: fn(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, caller: SemaEffectCaller, tree: BodyTree, statements: [Int], audited: Bool, diagnostics: &[Diagnostic]) {
    loop statement in statements {
        if tree.stmts[statement] == {
            .Contract(contract) -> {
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, contract.condition, audited, diagnostics)
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, contract.message, audited, diagnostics)
            }
            .ContractScope(pre, body, post, _, _) -> {
                sema_effect_check_unsafe_contracts(nodes, facts, caller, tree, pre, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
                sema_effect_check_unsafe_contracts(nodes, facts, caller, tree, post, audited, diagnostics)
            }
            .Let(_, _, init, _, _, _) | .TupleDestructure(_, init, _, _, _) | .StructDestructure(_, init, _, _, _) | .ListDestructure(_, init, _, _, _, _) -> sema_effect_check_unsafe_expr(nodes, facts, caller, tree, init, audited, diagnostics)
            .RefutableBind(_, init, fallback, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, init, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, fallback, audited, diagnostics)
            }
            .Assign(place, _, value, _, _) -> {
                if place == {
                    .Expr(place_value) -> {
                        sema_effect_check_unsafe_expr(nodes, facts, caller, tree, place_value, audited, diagnostics)
                    }
                    .Local(_) -> {}
                }
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, value, audited, diagnostics)
            }
            .CountedLoop(_, init, condition, step, _, body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, [Int]{init}, audited, diagnostics)
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, condition, audited, diagnostics)
                if step == .Val(step_statement) -> sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, [Int]{step_statement}, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
            }
            .ForRange(_, _, start, end, step, _, body, _, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, start, audited, diagnostics)
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, end, audited, diagnostics)
                if step == .Val(step_value) -> sema_effect_check_unsafe_expr(nodes, facts, caller, tree, step_value, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
            }
            .Range(_, _, source, start, end, step, _, _, body, _) -> {
                if source == .Val(source_value) -> sema_effect_check_unsafe_expr(nodes, facts, caller, tree, source_value, audited, diagnostics)
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, start, audited, diagnostics)
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, end, audited, diagnostics)
                if step == .Val(step_value) -> sema_effect_check_unsafe_expr(nodes, facts, caller, tree, step_value, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
            }
            .ExprStmt(value, _) | .DeferClose(value, _, _) -> sema_effect_check_unsafe_expr(nodes, facts, caller, tree, value, audited, diagnostics)
            .TaskGroup(_, args, body, _) -> {
                if args.limit == .Val(limit_value) -> sema_effect_check_unsafe_expr(nodes, facts, caller, tree, limit_value, audited, diagnostics)
                if args.stack == .Val(stack_value) -> sema_effect_check_unsafe_expr(nodes, facts, caller, tree, stack_value, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
            }
            .If(condition, then_body, else_body, _, _) -> {
                sema_effect_check_unsafe_condition(nodes, facts, caller, tree, condition, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, then_body, audited, diagnostics)
                if else_body == .Val(else_statements) -> sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, else_statements, audited, diagnostics)
            }
            .Loop(_, body, _) -> sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
            .While(_, condition, body, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, condition, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
            }
            .BreakValue(_, value, _) -> sema_effect_check_unsafe_expr(nodes, facts, caller, tree, value, audited, diagnostics)
            .Match(subject, arms, _, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, subject, audited, diagnostics)
                loop arm in arms -> sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, arm.body, audited, diagnostics)
            }
            .EnumMatch(scrutinee, arms, else_body, _, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, scrutinee, audited, diagnostics)
                loop arm in arms -> sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, arm.body, audited, diagnostics)
                if else_body == .Val(else_statements) -> sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, else_statements, audited, diagnostics)
            }
            .RangeSwitch(subject, arms, else_body, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, subject, audited, diagnostics)
                loop arm in arms -> sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, arm.body, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, else_body, audited, diagnostics)
            }
            .ForIn(_, _, _, source, collection, step, _, _, _, _, body, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, source, audited, diagnostics)
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, collection, audited, diagnostics)
                if step == .Val(step_value) -> sema_effect_check_unsafe_expr(nodes, facts, caller, tree, step_value, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
            }
            .Inline(body, _) | .DebugOnly(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
            }
            .MixedSwitch(subject, _, arms, else_body, _) -> {
                sema_effect_check_unsafe_expr(nodes, facts, caller, tree, subject, audited, diagnostics)
                loop arm in arms {
                    sema_effect_check_unsafe_expr(nodes, facts, caller, tree, arm.condition, audited, diagnostics)
                    sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, arm.body, audited, diagnostics)
                }
                if else_body == .Val(else_statements) -> sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, else_statements, audited, diagnostics)
            }
            .Unsafe(_, body) | .UnsafeBlock(_, body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, true, diagnostics)
            }
            .SentryPolicy(_, body, _) | .Impure(body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
            }
            .Reactive(executable, _) -> {
                if executable.executable == {
                    .Expr(value) -> {
                        sema_effect_check_unsafe_expr(nodes, facts, caller, tree, value, false, diagnostics)
                    }
                    .Block(body) -> {
                        sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, false, diagnostics)
                    }
                }
            }
            .Layout(_, _, body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
            }
            .ContextBlock(guards, body, _) -> {
                loop guard in guards -> sema_effect_check_unsafe_expr(nodes, facts, caller, tree, guard.value, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
            }
            .ScopeMember(_, body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
            }
            .Transact(_, _, _, body, _) -> {
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, body, audited, diagnostics)
            }
            .GCEdit(_, _, _, _, index_temp, nested, _) -> {
                if index_temp == .Val(index_value) -> sema_effect_check_unsafe_expr(nodes, facts, caller, tree, index_value, audited, diagnostics)
                sema_effect_check_unsafe_statements_tree(nodes, facts, caller, tree, [Int]{nested}, audited, diagnostics)
            }
            .Return(_, _) | .Break(_, _) | .Continue(_, _) -> {
                sema_effect_walk_stmt_children(SemaEffectWalk.Unsafe{audited: audited}, nodes, facts, diagnostics, caller, tree, tree.stmts[statement])
            }
        }
    }
}

// `e0712`: the region is both the call and the scope frame; its own caps never
// grant the effects it is missing.
sema_effect_scope_diagnostic: fn(marker: String, over: [String], bounds: [String], span: Span) -> Diagnostic {
    allowed: if bounds.len() == 0 -> "no effects" else -> "`{sema_effect_show(bounds)}`"
    diagnostic: sema_error("E0712", span, "this `#{marker}` region uses the effect `{sema_effect_show(over)}`, which it has no authority for", "`#{marker}(…)` allows only {allowed}; an effect reached inside — even through a call — must be in that list", "add `{sema_effect_show(over)}` to the `#{marker}(…)` list, or move that work outside the region")
    diagnostic_with_rights(diagnostic, "invocation", [String]{"#{marker}"}, [String]{"#{marker}"}, None)
}

// A scope cap list parsed once: the effect names it allows as a ranked set
// and the names sema_effect_parse_name rejects, in cap order, so a cap list
// checked against many functions (a package policy) is parsed once.
SemaEffectScopeBounds: struct {
    bounds: [String]
    unknown: [String]
}

// `e0747` for a denial: the callback reaches an effect its parameter's row
// denies (`fn(…) -[!Panic]>`), which no grant can lift.
sema_effect_callback_denied_diagnostic: fn(denied: [String], row: SemaEffectCallbackRow, span: Span) -> Diagnostic {
    denied_list: sema_effect_show(denied)
    entries := row.bound.copy()
    loop name in row.denied -> entries.push("!{name}")
    diagnostic: sema_error("E0747", span, "this callback uses the effect `{denied_list}`, which the parameter doesn't allow", "the parameter is `fn(…) -[{sema_effect_show(entries)}]>`, which denies `{denied_list}`", "pass a callback that can't reach `{denied_list}`, or remove the denial from the parameter's row")
    diagnostic_with_rights(diagnostic, "invocation", [String]{}, [String]{}, None)
}

// `e0747`: the callback's effects against its parameter's invocation row.
sema_effect_callback_diagnostic: fn(over: [String], bounds: [String], span: Span) -> Diagnostic {
    over_list: sema_effect_show(over)
    allowed: if bounds.len() == 0 -> "the parameter is `fn(…) -[]>`, so the callback must be pure" else -> "the parameter is `fn(…) -[{sema_effect_show(bounds)}]>`, so the callback may use only those effects"
    fix: if bounds.len() == 0 -> "pass a `fn(…) -[]>` callback (or a lambda that uses no effects), or widen the parameter's bound" else -> "pass a callback within `-[{sema_effect_show(bounds)}]>`, or add `{over_list}` to the parameter's bound"
    diagnostic: sema_error("E0747", span, "this callback uses the effect `{over_list}`, which the parameter doesn't allow", "{allowed}; `{over_list}` is outside that bound", fix)
    diagnostic_with_rights(diagnostic, "invocation", [String]{}, [String]{}, None)
}

sema_effect_check_callback_bound: fn(callback_effects: [String], bounds: [String], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    parsed_bounds := [String]{}
    valid := true
    loop raw in bounds {
        if raw.starts_with("..") -> next
        if raw.starts_with("!") -> next
        effect_name: sema_effect_parse_name(raw) ?? {
            diagnostics.push(sema_effect_unknown(raw, span))
            valid = false
            next
        }
        if sema_effect_root(effect_name) == "Panic" {
            diagnostics.push(sema_effect_positive_panic(span))
            valid = false
            next
        }
        sema_effect_set_add(parsed_bounds, effect_name)
    }
    over: sema_effect_uncovered(callback_effects, parsed_bounds)
    if over.len() > 0 {
        diagnostics.push(sema_effect_callback_diagnostic(over, parsed_bounds, span))
        valid = false
    }
    valid
}

// ────────────────────────────────────────────────────────────────────────────
// Call-graph fixed point and public graph hook

SemaEffectPending: struct {
    node: Int
    name: String
}

// Each node's callers, in caller and call-edge order: the reverse call graph
// the fixed point and the reach walks share. A `core.db` call into the SQL
// engine's parts is no edge: see sema_effect_sealed_edge.
sema_effect_callers: fn(nodes: [SemaEffectNode], node_by_key: NameRows) -> [[Int]] Never! {
    callers := (loop _ in nodes -> [Int]{})
    loop (index, node) in nodes {
        loop edge in node.call_edges {
            if edge == "__jet_panic__" -> next
            target: sema_effect_node_index(node_by_key, edge) ?? next
            if sema_effect_sealed_edge(node, nodes[target]) -> next
            callers[target].push(index)
        }
    }
    callers
}

// The SQL engine's parts (`<corelib>/__core_db_*`) reach `core.db` the way
// the C library they replace did: `core.db`'s declared rows (`DB.Read` on
// queries, `DB.Write` on `execute`, the `DB` root on transaction control)
// are the effects its callers see, so an engine row does not flow into a
// `core.db` body. Calls between engine parts keep their edges.
sema_effect_sealed_edge: fn(caller: SemaEffectNode, target: SemaEffectNode) -> Bool Never! {
    caller.module_identity == "<corelib>/core.db" && target.module_identity.starts_with("<corelib>/__core_db_")
}

// Propagate each newly reached effect to callers once. Set insertion keeps
// the established root-rank/name order, so worklist order cannot change
// published rows or diagnostics. Direct rows and call-site spans are untouched.
sema_effect_solve: fn(nodes: [SemaEffectNode], callers: [[Int]]) -> [[String]] Never! {
    solved := [[String]]{}
    pending := [SemaEffectPending]{}
    loop (index, node) in nodes {
        row := node.direct
        if node.maximal -> sema_effect_set_union(row, authority_grantable_roots())
        loop edge in node.call_edges {
            if edge == "__jet_panic__" {
                sema_effect_set_add(row, "Panic")
                break
            }
        }
        loop name in row -> pending.push(SemaEffectPending{node: index, name: name})
        solved.push(row)
    }
    cursor := 0
    loop cursor < pending.len() {
        incoming: pending[cursor]
        cursor += 1
        loop caller in callers[incoming.node] {
            if nodes[caller].scoped_calls.len() > 0 {
                sema_effect_solve_scoped(solved, pending, nodes[caller], caller, nodes[incoming.node].key, incoming.name)
            } else if sema_effect_set_add(solved[caller], incoming.name) {
                pending.push(SemaEffectPending{node: caller, name: incoming.name})
            }
        }
    }
    solved
}

// One effect reaching `caller` from the callee `callee_key` when the caller
// calls scope publishers: a publisher's bare effect arrives as each scope the
// caller's constant arguments name, and bare too only when it also calls that
// publisher with a run-time argument.
sema_effect_solve_scoped: fn(solved: &[[String]], pending: &[SemaEffectPending], node: SemaEffectNode, caller: Int, callee_key: String, name: String) Never! {
    renamed := false
    loop call in node.scoped_calls {
        if call.callee != callee_key || call.published != name -> next
        renamed = true
        if sema_effect_set_add(solved[caller], call.scoped) -> pending.push(SemaEffectPending{node: caller, name: call.scoped})
    }
    if renamed && !node.bare_scope_callees.contains(callee_key) -> return
    if sema_effect_set_add(solved[caller], name) -> pending.push(SemaEffectPending{node: caller, name: name})
}

// Rust `solve_reachability` "secret" row: only a direct `Secret` read seeds
// it, never the every-root row of an open-world (maximal) call, and callers
// inherit it along call edges. E1264 consults this row, not `solved`.
sema_effect_secret_reach: fn(nodes: [SemaEffectNode], callers: [[Int]]) -> [Bool] Never! {
    reached := (loop _ in nodes -> false)
    pending := [Int]{}
    loop (index, node) in nodes {
        loop effect_name in node.direct {
            if sema_effect_root(effect_name) == "Secret" {
                reached[index] = true
                pending.push(index)
                break
            }
        }
    }
    cursor := 0
    loop cursor < pending.len() {
        incoming: pending[cursor]
        cursor += 1
        loop caller in callers[incoming] {
            if reached[caller] -> next
            reached[caller] = true
            pending.push(caller)
        }
    }
    reached
}

sema_effect_tfacts: fn(node: SemaEffectNode, solved: [String]) -> TEffectFacts Never! {
    TEffectFacts{direct: node.direct, solved: solved, call_edges: node.call_edges, maximal: node.maximal, direct_spans: node.direct_spans, maximal_span: node.maximal_span, value_edges: node.value_edges, module_writes: node.module_writes}
}

// Rust `e1264`: the span is the first entry of the declared effect row, or
// the function's name when it declares none.
sema_effect_secret_diagnostic: fn(node: SemaEffectNode) -> Diagnostic {
    sema_error("E1264", node.row_span ?? node.name_span, "`{node.name}` reads a secret but doesn't declare the `Secret` effect", "reading a secret (`core.crypto.vault.get`) always requires an explicit grant — unlike other effects, there is no silently-inferred default here, so a function must opt in even with no other explicit effect row at all.", "add `-[Secret]>` to `{node.name}`'s signature (or widen an existing effect row to cover it)")
}

sema_effect_unbounded_dispatch_diagnostic: fn(dispatch: TEffectSpan) -> Diagnostic {
    sema_error("E0743", dispatch.span, "dynamic call `{dispatch.name}` has no effect bound", "a trait value can select any implementation at runtime, and the program holds none of this method to bound the call, so an enclosing effect ceiling needs the trait method's declared row or a ceiling in the trait's `#FX(…)` cap", "declare an effect row on `{dispatch.name}`, such as `-[]>` for pure dispatch, put an `#FX(…)` ceiling above the trait, or move this dynamic call outside the bounded function")
}

sema_effect_locate_dispatch: fn(site: SemaEffectDispatchSite, inputs: [SemaEffectModuleInput]) -> Diagnostic Never! {
    located := sema_diagnostic_with_source_location(
        sema_effect_unbounded_dispatch_diagnostic(site.dispatch),
        inputs[site.module_index].source_segments,
    )
    if located.source_path == None -> located.span = None
    located.move()
}

// Nodes from which some unbounded trait dispatch is reachable through the
// call graph (the node itself included): one reverse walk from every node
// that dispatches.
sema_effect_dispatch_reach: fn(nodes: [SemaEffectNode], callers: [[Int]]) -> [Bool] Never! {
    reach := (loop _ in nodes -> false)
    pending := [Int]{}
    loop (index, node) in nodes {
        if node.dispatches.len() > 0 {
            reach[index] = true
            pending.push(index)
        }
    }
    cursor := 0
    loop cursor < pending.len() {
        incoming: pending[cursor].copy()
        cursor += 1
        loop caller in callers[incoming] {
            if reach[caller] -> next
            reach[caller] = true
            pending.push(caller)
        }
    }
    reach
}

// The first unbounded trait dispatch reachable from `index` through the call
// graph, the function's own calls first. `reach` skips dispatch-free callees;
// `visited` records the rows to clear before the next root.
sema_effect_find_dispatch: fn(nodes: [SemaEffectNode], node_by_key: NameRows, reach: [Bool], index: Int, seen: &[Bool], visited: &[Int]) -> SemaEffectDispatchSite? {
    if seen[index] -> return None
    seen[index] = true
    visited.push(index)
    if nodes[index].dispatches.len() > 0 -> return Val(SemaEffectDispatchSite{dispatch: nodes[index].dispatches[0], module_index: nodes[index].module_index})
    loop edge in nodes[index].call_edges {
        target: sema_effect_node_index(node_by_key, edge) ?? next
        if !reach[target] -> next
        found: sema_effect_find_dispatch(nodes, node_by_key, reach, target, seen, visited)
        if found != None -> return found
    }
    None
}

sema_effect_trait_bound_diagnostic: fn(bound: SemaEffectTraitBound, over: [String], span: Span, impl_key: String) -> Diagnostic {
    over_list: sema_effect_show(over)
    bound_text: if bound.bound.len() == 0 -> "`{bound.trait_name}` bounds `{bound.method}` to `-[]>`, so impls must be pure" else -> "`{bound.trait_name}` bounds `{bound.method}` to `-[{sema_effect_show(bound.bound)}]>`, so impls may use only those"
    diagnostic: sema_error("E0742", span, "this `{bound.method}` impl uses the effect `{over_list}`, which the trait doesn't allow", "{bound_text}; `{over_list}` is outside that bound", "remove the `{over_list}` work from this impl, or widen the bound on the trait method")
    diagnostic_with_rights(diagnostic, "invocation", [String]{impl_key}, [String]{}, None)
}

// Every impl of a bounded trait method stays within the trait's row.
sema_effect_check_trait_bounds: fn(module_row: SemaEffectModuleInput, functions: [FnBody], source_index: SemaEffectSourceIndex, nodes: [SemaEffectNode], node_by_key: NameRows, solved: [[String]], diagnostics: &[Diagnostic]) {
    if module_row.trait_bounds.len() == 0 -> return
    loop function in functions {
        // An owned operator or CheckedText trait (`impl Vec2.Add`) has no
        // source row, so its method is checked as a plain one named in
        // `owned_trait_hooks`. A method of an `impl Trait` block in a struct
        // or enum body names its trait through its source.
        owner_type: if function.kind == {
            .Method(_, owner) -> owner
            .TraitMethod(_, _, owner, _, _) -> owner
            .TopLevel -> {
                next
            }
        }
        node_index: sema_effect_node_index(node_by_key, function.key) ?? next
        trait_name := module_row.owned_trait_hooks.get(function.key) ?? ""
        if nodes[node_index].trait_key.cut_last("|") == .Val(split) -> trait_name = split.after
        if function.kind == .TraitMethod(_, _, _, trait_symbol, _) -> trait_name = sema_effect_symbol_leaf(trait_symbol.key)
        if trait_name == "" -> next
        method: sema_effect_method_name(function, module_row.sources, source_index)
        loop bound in module_row.trait_bounds {
            if bound.trait_name != trait_name || bound.method != method -> next
            over: sema_effect_uncovered(solved[node_index], bound.bound)
            if over.len() > 0 -> diagnostics.push(sema_effect_trait_bound_diagnostic(bound, over, nodes[node_index].name_span, "{type_name(owner_type)}::{method}"))
            break
        }
    }
}

// A trait method's source name (its own spelling), or the checked name when
// the function has no source row.
sema_effect_method_name: fn(function: FnBody, sources: [SemaEffectFunctionSource], source_index: SemaEffectSourceIndex) -> String Never! {
    at: sema_effect_source_position(function, source_index) ?? return function.name
    sources[at].name
}

// The byte bound of `Mem.Alloc(above: N)`.
sema_effect_memory_bound: fn(name: String) -> Int? {
    if !name.starts_with("Mem.Alloc(") -> return None
    parts: name.split(":").to_list()
    if parts.len() != 2 -> return None
    amount: parts[1].split(")").to_list()
    if amount.len() == 0 -> return None
    bytes: Int.parse(amount[0].trim()) ?? return None
    Val(bytes)
}

// Rust `MemoryFact::display` for the denials a memory proof covers.
sema_effect_memory_fact: fn(name: String) -> String? {
    if name == "Mem.Alloc" || name == "Mem.Rc" -> return Val("!{name}")
    bound: sema_effect_memory_bound(name) ?? return None
    Val("!Mem.Alloc(above: {bound})")
}

sema_effect_span_before: fn(left: Span, right: Span) -> Bool Never! {
    left.start < right.start || (left.start == right.start && left.end < right.end)
}

sema_effect_memory_sorted_events: fn(events: [SemaMemoryEvent]) -> [SemaMemoryEvent] {
    sorted := [SemaMemoryEvent]{}
    loop event in events {
        sorted.push(event.copy())
        index := sorted.len() - 1
        loop index > 0 && sema_effect_span_before(sorted[index].span, sorted[index - 1].span) {
            swap := sorted[index - 1]
            sorted[index - 1] = sorted[index]
            sorted[index] = swap
            index -= 1
        }
    }
    sorted
}

sema_effect_memory_sorted_calls: fn(calls: [SemaMemoryCall]) -> [SemaMemoryCall] {
    sorted := [SemaMemoryCall]{}
    loop call in calls {
        sorted.push(call.copy())
        index := sorted.len() - 1
        loop index > 0 && sema_effect_span_before(sorted[index].span, sorted[index - 1].span) {
            swap := sorted[index - 1]
            sorted[index - 1] = sorted[index]
            sorted[index] = swap
            index -= 1
        }
    }
    sorted
}

sema_effect_memory_open_finding: fn(span: Span, source: String, reason: String, owner: Int, path: [String], used: Int) -> SemaMemoryFinding Never! {
    SemaMemoryFinding{event: None, owner: owner, open: Val(SemaMemoryOpen{span: span, source: source, reason: reason}), path: path, used: used}
}

sema_effect_arena_failure: fn(finding: SemaMemoryFinding) -> SemaMemoryArena Never! {
    SemaMemoryArena{bytes: 0, witness: None, failure: Val(finding)}
}

// Rust `shortest_violation` for the unbounded facts: breadth-first search
// gives the shortest call path to the first event of `kind` ("alloc" for
// `!Mem.Alloc`, "rc" for `!Mem.Rc`) or to an open dispatch.
sema_effect_memory_search: fn(nodes: [SemaEffectNode], node_by_key: NameRows, root: Int, kind: String) -> SemaMemoryFinding? {
    queue := [Int]{root}
    paths := [[String]]{[String]{nodes[root].display_key}}
    seen := (loop _ in nodes -> false)
    cursor := 0
    loop cursor < queue.len() {
        index: queue[cursor]
        path: paths[cursor].copy()
        cursor += 1
        if seen[index] -> next
        seen[index] = true
        loop event in sema_effect_memory_sorted_events(nodes[index].memory_events) {
            if event.kind == kind -> return Val(SemaMemoryFinding{event: Val(event), owner: index, open: None, path: path, used: 0})
        }
        // copy: the memory finding owns its open site, while the site stays in nodes[index] (the
        // caller's read-only effect graph), which later searches read.
        if nodes[index].memory_opens.len() > 0 -> return Val(SemaMemoryFinding{event: None, owner: index, open: Val(nodes[index].memory_opens[0].copy()), path: path, used: 0})
        edges := nodes[index].call_edges
        loop edge in edges {
            target: sema_effect_node_index(node_by_key, edge) ?? next
            next_path := path.copy()
            next_path.push(nodes[target].display_key)
            queue.push(target)
            paths.push(next_path)
        }
    }
    None
}

// Rust `may_reach_arena` over the known call graph.
sema_effect_may_reach_arena: fn(nodes: [SemaEffectNode], node_by_key: NameRows, index: Int, visiting: &[Bool]) -> Bool {
    if visiting[index] -> return true
    visiting[index] = true
    found := false
    loop event in nodes[index].memory_events {
        if event.kind == "arena" -> found = true
    }
    if !found {
        loop edge in nodes[index].call_edges {
            target: sema_effect_node_index(node_by_key, edge) ?? next
            if sema_effect_may_reach_arena(nodes, node_by_key, target, visiting) {
                found = true
                break
            }
        }
    }
    visiting[index] = false
    found
}

// A heap allocation `!Mem.Alloc(above: N)` cannot size: an "alloc" event that
// is not the companion of the arena reservation counted at the same site.
sema_effect_unsized_alloc: fn(node: SemaEffectNode, event: SemaMemoryEvent) -> Bool Never! {
    if event.kind != "alloc" -> return false
    loop other in node.memory_events {
        if other.kind == "arena" && other.span.start == event.span.start && other.span.end == event.span.end -> return false
    }
    true
}

// Rust `arena_bound`: the proven arena bytes `index` can reserve, with the
// event that witnesses the total, or the finding that stops the proof.
sema_effect_arena_bound: fn(nodes: [SemaEffectNode], node_by_key: NameRows, index: Int, visiting: &[Bool], path: [String]) -> SemaMemoryArena {
    if visiting[index] -> return sema_effect_arena_failure(sema_effect_memory_open_finding(Span{start: 0, end: 0}, nodes[index].display_key, "recursive call multiplicity is not statically bounded for arena accounting", index, path, 0))
    visiting[index] = true
    result: sema_effect_arena_bound_inner(nodes, node_by_key, index, visiting, path)
    visiting[index] = false
    result
}

sema_effect_arena_bound_inner: fn(nodes: [SemaEffectNode], node_by_key: NameRows, index: Int, visiting: &[Bool], path: [String]) -> SemaMemoryArena {
    node: nodes[index]
    // copy: the arena failure owns its open site, while the site stays in `node`, a row of the
    // caller's read-only effect graph, which later searches read.
    if node.memory_opens.len() > 0 -> return sema_effect_arena_failure(SemaMemoryFinding{event: None, owner: index, open: Val(node.memory_opens[0].copy()), path: path, used: 0})
    total := 0
    witness := SemaMemoryFinding?{None}
    loop event in sema_effect_memory_sorted_events(node.memory_events) {
        // A heap allocation has no proven size, so a byte bound cannot hold
        // over it; the arena reservation at the same site is counted instead.
        if sema_effect_unsized_alloc(node, event) -> return sema_effect_arena_failure(SemaMemoryFinding{event: Val(event), owner: index, open: None, path: path, used: total})
        if event.kind != "arena" -> next
        bytes: event.bytes ?? return sema_effect_arena_failure(SemaMemoryFinding{event: Val(event), owner: index, open: None, path: path, used: total})
        executions: event.executions ?? return sema_effect_arena_failure(sema_effect_memory_open_finding(event.span, node.source_display, "loop iteration count is not statically bounded for arena accounting", index, path, total))
        total += bytes * executions
        witness = Val(SemaMemoryFinding{event: Val(event), owner: index, open: None, path: path, used: 0})
    }
    loop edge in node.call_edges {
        target: sema_effect_node_index(node_by_key, edge) ?? next
        called := false
        loop call in node.memory_calls {
            if call.callee == edge -> called = true
        }
        if called -> next
        reach_visiting := (loop _ in nodes -> false)
        if sema_effect_may_reach_arena(nodes, node_by_key, target, reach_visiting) -> return sema_effect_arena_failure(sema_effect_memory_open_finding(Span{start: 0, end: 0}, nodes[target].display_key, "call-site multiplicity is unavailable for arena accounting", index, path, total))
        // With no arena below it, the callee's multiplicity does not matter:
        // any heap allocation it reaches breaks the bound.
        if sema_effect_memory_search(nodes, node_by_key, target, "alloc") == .Val(found) {
            full := path.copy()
            loop step in found.path -> full.push(step)
            return sema_effect_arena_failure(SemaMemoryFinding{event: found.event, owner: found.owner, open: found.open, path: full, used: total})
        }
    }
    loop call in sema_effect_memory_sorted_calls(node.memory_calls) {
        target: sema_effect_node_index(node_by_key, call.callee) ?? next
        call_path := path.copy()
        call_path.push(nodes[target].display_key)
        proof: sema_effect_arena_bound(nodes, node_by_key, target, visiting, call_path)
        if proof.failure != None -> return proof
        if proof.bytes == 0 -> next
        executions: call.executions ?? return sema_effect_arena_failure(sema_effect_memory_open_finding(call.span, node.source_display, "loop iteration count is not statically bounded for arena accounting", index, call_path, total))
        total += proof.bytes * executions
        if proof.witness != None -> witness = proof.witness
    }
    SemaMemoryArena{bytes: total, witness: witness, failure: None}
}

// Rust `memory_violation`.
sema_effect_memory_violation: fn(nodes: [SemaEffectNode], root: Int, denial: EffectRowEntry, fact: String, bounded: Bool, finding: SemaMemoryFinding) -> Diagnostic {
    declared_at: nodes[root].source_display
    provenance: "signature denial `-[!{denial.name}]>` in {declared_at}"
    path_text: finding.path.join(" -> ")
    if finding.event == .Val(event) {
        owner: nodes[finding.owner]
        arena := ""
        if bounded {
            arena = if event.kind == "alloc" -> "; sema proves no byte size for this heap allocation, so it cannot be counted against the bound" else -> "; the proven path total is {finding.used} bytes"
        }
        return sema_error("E0921", event.span, "{event.operation} at {owner.source_display} violates the effective `{fact}` declared at {declared_at}", "{owner.source_display} is reachable through {path_text} from code governed by `{fact}`{arena}; declaration provenance: {provenance}; operation provenance: {owner.name} in {owner.source_display}", "remove or replace the incompatible operation, seal the target set, or move the call outside this denial")
    }
    open: finding.open ?? SemaMemoryOpen{span: denial.span, source: declared_at, reason: "memory proof is incomplete"}
    span: if open.span.start == open.span.end -> denial.span else -> open.span
    sema_error("E0921", span, "`{fact}` cannot be proved through the open dispatch at {open.source}", "{open.reason} is reachable through {path_text}; a strict transitive fact cannot assume an unknown future target is compatible; declaration provenance: {provenance}", "seal the target set, consume a verified signed dependency summary that proves the denial, or move the dispatch outside it")
}

// 2 (Rust `check_memory_facts`): a `-[!Mem.Alloc]>`,
// `-[!Mem.Rc]>` or `-[!Mem.Alloc(above: N)]>` denial holds for every
// function the root can reach (E0921).
sema_effect_memory_project: fn(nodes: [SemaEffectNode], node_by_key: NameRows, root: Int, denial: EffectRowEntry, diagnostics: &[Diagnostic]) -> SemaMemoryProjection {
    fact: sema_effect_memory_fact(denial.name) ?? panic("invalid checked memory denial")
    limit: sema_effect_memory_bound(denial.name)
    if limit == .Val(bytes_limit) {
        visiting := (loop _ in nodes -> false)
        proof: sema_effect_arena_bound(nodes, node_by_key, root, visiting, [String]{nodes[root].display_key})
        if proof.failure == .Val(failure) {
            diagnostics.push(sema_effect_memory_violation(nodes, root, denial, fact, true, failure))
            return sema_effect_memory_projection(failure)
        }
        if proof.bytes <= bytes_limit -> return SemaMemoryProjection.Proven
        finding: proof.witness ?? sema_effect_memory_open_finding(Span{start: 0, end: 0}, nodes[root].display_key, "the verified upper bound is {proof.bytes} bytes, above the declared {bytes_limit} bytes", root, [String]{nodes[root].display_key}, 0)
        finding_total := finding
        finding_total.used = proof.bytes
        diagnostics.push(sema_effect_memory_violation(nodes, root, denial, fact, true, finding_total))
        return sema_effect_memory_projection(finding_total)
    }
    kind: if denial.name == "Mem.Rc" -> "rc" else -> "alloc"
    finding: sema_effect_memory_search(nodes, node_by_key, root, kind) ?? return SemaMemoryProjection.Proven
    diagnostics.push(sema_effect_memory_violation(nodes, root, denial, fact, false, finding))
    sema_effect_memory_projection(finding)
}
sema_effect_check_memory_denials: fn(nodes: [SemaEffectNode], node_by_key: NameRows, root: Int, diagnostics: &[Diagnostic], facts: &SemaMemoryProjectionFacts) {
    loop denial in nodes[root].memory_denials {
        if sema_effect_memory_fact(denial.name) == None -> next
        projection: sema_effect_memory_project(nodes, node_by_key, root, denial, diagnostics)
        sema_effect_memory_publish(nodes, root, denial, projection, facts)
    }
}

// A pure body's reached effects go to `pure_reached`; E3401 is reported once
// the solved rows are stamped, so it can name the call that reaches them.
sema_effect_check_node: fn(node: SemaEffectNode, solved: [String], secret_reached: Bool, dispatch: Diagnostic?, panic_steps: [String], notes: [SemaEffectInstanceNote], pure_reached: &[String], diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    // This rule with (Rust `check_inferred_memo`, E0938): a
    // `#Memo` function that is not declared pure is judged by its solved row;
    // panic and memory are deny-only, as for an explicit empty bound.
    if !node.is_pure && node.memo_span == .Val(memo_span) {
        impure := sema_effect_uncovered(solved, [String]{})
        if impure.len() > 0 {
            impure.sort()
            shown: impure.join(", ")
            subject: sema_effect_memo_subject(node.name)
            diagnostics.push(sema_error("E0938", memo_span, "`#Memo` requires a pure function", "memoization reuses a completed result, but {subject} uses `{shown}`", "remove the `{shown}` operations from {subject}, or drop `#Memo`"))
            valid = false
        }
    }
    if node.kernel == .Val(pending) && !sema_kernel_check_effects(pending, node.direct, node.call_edges, node.maximal, diagnostics) -> valid = false
    secret_granted: loop bound in node.declared {
        if sema_effect_root(bound) == "Secret" -> break true
    } ?? false
    if secret_reached && !secret_granted {
        diagnostics.push(sema_effect_secret_diagnostic(node))
        valid = false
    }
    if {
        dispatch == .Val(found) -> {
            // The open dispatch makes the row maximal; a written ceiling
            // reports the missing trait bound once instead of the generic
            // ceiling diagnostics, and a bare purity marker reports nothing.
            if !node.has_declared_row -> return valid
            diagnostics.push(found.copy())
            return false
        }
        node.is_pure -> {
            reached: sema_effect_without_deny_only(solved)
            // A non-deterministic Core call in this body already reported
            // E3403 for its `Time`/`Rand` row; any other effect still reports.
            over := [String]{}
            loop name in reached {
                root: sema_effect_root(name)
                if node.nondeterministic_call && (root == "Time" || root == "Rand") -> next
                over.push(name)
            }
            if node.nondeterministic_call -> valid = false
            if over.len() > 0 {
                loop name in over -> pure_reached.push(name)
                valid = false
            }
        }
        node.has_declared_row && (node.declared.len() > 0 || node.library_rows.len() > 0) -> {
            over: sema_effect_uncovered(solved, node.declared)
            if over.len() > 0 {
                reported: if node.library_rows.len() > 0 -> sema_library_effect_reach_diagnostic(node, over) else -> sema_effect_bound_diagnostic(node, over)
                diagnostics.push(sema_effect_with_instance_notes(reported, notes, over))
                valid = false
            }
        }
    }
    prohibited: sema_effect_covered(solved, node.prohibited)
    if prohibited.len() > 0 {
        diagnostics.push(sema_effect_with_instance_notes(sema_effect_prohibited_diagnostic(node, prohibited, panic_steps), notes, prohibited))
        valid = false
    }
    if node.is_replayable {
        forbidden := [String]{}
        loop effect_name in solved {
            root: sema_effect_root(effect_name)
            if root == "Time" || root == "Rand" || root == "Net" || root == "IO" -> sema_effect_set_add(forbidden, effect_name)
        }
        if forbidden.len() > 0 {
            diagnostics.push(sema_effect_replayable_diagnostic(node, forbidden))
            valid = false
        }
    }
    valid
}

// P7: memory rights are not an observable outcome of a call; every other
// root (including `Panic`) and an open-world row give the call a purpose.
sema_effect_row_has_no_outcome: fn(node: SemaEffectNode, solved: [String]) -> Bool Never! {
    if node.maximal -> return false
    loop effect_name in solved {
        if sema_effect_root(effect_name) != "Mem" -> return false
    }
    true
}

// The callee as written stands in for the call text (the Rust reference's
// span covers the callee name, so its call text is that name).
sema_effect_discarded_result_diagnostic: fn(node: SemaEffectNode, span: Span) -> Diagnostic {
    diagnostic: sema_error("E0433", span, "the result of `{node.name}` is thrown away", "`{node.name}` is pure (it has no effects and changes nothing through `&`), so this line does nothing", "use the result, bind it with `result: {node.name}`, or write `.drop(\"reason\")` if dropping it is intended")
    diagnostic_with_source_derived_suggestion(diagnostic, Span{start: span.start, end: span.start}, "result: ")
}

// The part of `expression` inside `region` (a `#FX` block span).
sema_effect_walk_region_expr: fn(nodes: &[SemaEffectNode], node_index: Int, tree: BodyTree, expression: Int, region: Span, facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller) {
    node: body_node(tree, expression)
    next: sema_effect_walk_region_enter(nodes, node_index, tree, expression, node, region, facts, diagnostics, caller) ?? return
    sema_effect_walk_expr_children(next, nodes, facts, diagnostics, caller, tree, node)
}

// sema_effect_walk_region_expr's own work on `node`: the walk its children
// continue with, the whole walk (Collect) once the region holds the node; None
// when they aren't walked.
sema_effect_walk_region_enter: fn(nodes: &[SemaEffectNode], node_index: Int, tree: BodyTree, expression: Int, node: BodyNode, region: Span, facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller) -> SemaEffectWalk? {
    if sema_effect_span_contains(region, node.span) {
        if sema_effect_walk_expr_enter(nodes, node_index, tree, expression, node, facts, diagnostics, caller) -> return Val(SemaEffectWalk.Collect{node_index: node_index})
        return None
    }
    if !sema_effect_span_contains(node.span, region) -> return None
    Val(SemaEffectWalk.Region{node_index: node_index, region: region})
}

// (Rust `check_region_caps`): the effects a `#FX(…)` region reaches:
// its own sites, everything its callees reach, and every effect when it makes
// an unknown call. A call to a Core scope publisher inside the region reaches
// it as the scoped effect its constant argument names, as a function's own
// calls do (sema_effect_solve_scoped), so `files.read("data/{name}")` needs
// `FS.Read("data/")`. The region's node is appended to `nodes` for the walk
// (which writes only that node) and removed again before returning.
sema_effect_region_inferred: fn(nodes: &[SemaEffectNode], solved: [[String]], owner: Int, function: FnBody, region: SemaEffectFxRegion, facts: SemaEffectCallIndex, module_index: Int) -> [String] {
    // copy: the region node starts from its owner's declared row and spans;
    // the owner node stays in the graph.
    region_node := nodes[owner].copy()
    region_node.key = "{function.key}#FX@{region.span.start}"
    region_node.direct = [String]{}
    region_node.direct_spans = [TEffectSpan]{}
    region_node.call_edges = [String]{}
    region_node.maximal = false
    region_node.maximal_span = None
    region_node.dispatches = [TEffectSpan]{}
    region_node.memory_events = [SemaMemoryEvent]{}
    region_node.scoped_calls = [SemaEffectScopedCall]{}
    region_node.bare_scope_callees = [String]{}
    nodes.push(region_node)
    region_index: nodes.len() - 1
    ignored := [Diagnostic]{}
    caller: sema_effect_caller_slot(facts, module_index, function.key)
    loop statement in function.body {
        sema_effect_walk_stmt_children(SemaEffectWalk.Region{node_index: region_index, region: region.span}, nodes, facts, ignored, caller, function.tree, function.tree.stmts[statement])
    }
    walked := nodes.pop() ?? panic("the #FX region node left the graph")
    inferred := walked.direct.move()
    if walked.maximal -> sema_effect_set_union(inferred, authority_grantable_roots())
    loop edge in walked.call_edges {
        if edge == "__jet_panic__" {
            sema_effect_set_add(inferred, "Panic")
            next
        }
        target: sema_effect_node_index(facts.node_by_key, edge) ?? next
        loop name in solved[target] -> sema_effect_region_add_scoped(inferred, walked.scoped_calls, walked.bare_scope_callees, edge, name)
    }
    inferred
}

// Adds callee `callee_key`'s effect `name` to a region's `inferred` row:
// scoped as each of the region's constant-argument calls to that publisher
// names it, and bare too when the region also calls it with a run-time
// argument or names no scope for it.
sema_effect_region_add_scoped: fn(inferred: &[String], scoped_calls: [SemaEffectScopedCall], bare_scope_callees: [String], callee_key: String, name: String) Never! {
    renamed := false
    loop call in scoped_calls {
        if call.callee != callee_key || call.published != name -> next
        renamed = true
        sema_effect_set_add(inferred, call.scoped)
    }
    if !renamed || bare_scope_callees.contains(callee_key) -> sema_effect_set_add(inferred, name)
}

// `modules` are the checked modules; each input names its module, whose
// functions and call facts are read in place. `prepared` holds each input
// module's graph nodes, source index and call index, built in input order
// (sema_effect_prepare_modules, or on compiler threads one module range at a
// time). The solved effect row of every input module's function is stamped
// onto `modules` at the end. The effect sites of every module's functions are
// collected at once on up to `threads` compiler threads
// (sema_effect_collect_threads); the result is the same for any thread count.
// `package_denials` is the root package's `authority.deny` row; `denial_modules`
// marks, by graph module index, the modules that row binds. `file_caps` holds,
// by graph module index, the `#FX(…)` caps a file module takes from the
// `name: module` declarations above it. `trait_caps` is each capped trait's
// `#FX(…)` cap (sema_effect_trait_caps). `decls` is the run's declaration
// table, which direct callees name. `prep_functions` holds the keys of the
// functions the build checked to run while compiling (a comptime item's
// callees, whose call sites no module records): prep code, never a runtime
// entry (sema_effect_runtime_input_paths).
sema_effects_check_modules: fn(modules: &[SemaGraphModuleResult], inputs: [SemaEffectModuleInput], prepared: &&SemaEffectPrepared, package_denials: [String], denial_modules: [Bool], file_caps: [[SemaEffectModuleCap]], trait_caps: [String:SemaEffectTypeCap], decls: DeclTable, prep_functions: [String:Bool], threads: CompilerThreads) -> SemaEffectGraphResult {
    owned_prepared := prepared.move()
    diagnostics := owned_prepared.diagnostics.move()
    nodes := owned_prepared.nodes.move()
    memory_facts := SemaMemoryProjectionFacts{declarations: [], projections: []}
    source_indices := owned_prepared.source_indices.move()
    node_keys := owned_prepared.node_keys.move()
    node_by_key := sema_effect_node_key_table(node_keys)
    // Rust `seed_trait_dispatch_effects`: implementing types by
    // `{module}|{trait}`, and each `{module}|{trait}::{method}`'s own summary
    // per implementing type (sema_effect_add_trait_impls).
    tables := SemaEffectImplTables{}
    loop module_index in 0..<inputs.len() {
        module_row: inputs[module_index]
        module_identity: modules[module_row.module_index].module_identity
        loop row in module_row.trait_implementers {
            pair: row.cut_last("::") ?? next
            sema_effect_add_implementer(tables, "{module_identity}|{pair.before}", pair.after)
        }
        sema_effect_add_trait_impls(modules[module_row.module_index].functions, module_row, source_indices[module_index], tables)
    }
    trait_implementers := [String:[String]]{}
    loop (group_row, trait_key) in tables.implementer_keys -> trait_implementers[trait_key] = tables.implementer_lists[group_row]
    dyn_impls := [String:[String]]{}
    loop (group_row, method_key) in tables.dyn_keys -> dyn_impls[method_key] = tables.dyn_lists[group_row]
    trait_impls := tables.trait_impls.move()
    // The `…:close` method keys in key order, grouped by owner type.
    close_keys := [String]{}
    loop key in node_by_key.texts {
        if key.ends_with(":close") -> close_keys.push(key)
    }
    close_keys.sort_by((left: String, right: String) -> left <=> right)
    close_methods := [String:[String]]{}
    loop key in close_keys {
        owner_path: key.removesuffix(":close")
        split: owner_path.cut_last("::") ?? next
        rows := close_methods.get(split.after) ?? [String]{}
        rows.push(key)
        close_methods[split.after] = rows
    }
    unsafe_names := [String:String]{}
    published_effects := [String:String]{}
    loop (key_index, key) in node_by_key.texts {
        node_index: node_by_key.rows[key_index]
        if nodes[node_index].is_unsafe -> unsafe_names[key] = nodes[node_index].name
        if effect_scope_published_effect(key, nodes[node_index].path_first, nodes[node_index].declared) == .Val(published) -> published_effects[key] = published
    }
    node_by_decl := sema_effect_nodes_by_decl(node_by_key, owned_prepared.node_decls, decls.rows.len())
    calls := SemaEffectCallIndex{modules: owned_prepared.calls.move(), node_by_key: node_by_key.move(), trait_implementers: trait_implementers.move(), trait_impls: trait_impls.move(), dyn_impls: dyn_impls.move(), trait_caps: trait_caps.copy(), close_methods: close_methods.move(), unsafe_names: unsafe_names.move(), node_by_decl: node_by_decl.move(), node_keys: node_keys.move(), published_effects: published_effects.move()}
    unsafe_node: loop node in nodes {
        if node.is_unsafe -> break true
    } ?? false
    any_unsafe: unsafe_node || sema_effect_calls_any_unsafe_foreign(calls.modules)
    calls = sema_effect_collect_threads(modules, inputs, nodes, calls, any_unsafe, diagnostics, threads)
    sema_effect_resolve_type_params(nodes, calls)
    callers: sema_effect_callers(nodes, calls.node_by_key)
    solved: sema_effect_solve(nodes, callers)
    loop module_index in 0..<inputs.len() {
        sites := [String:SharedLifetime]{}
        site_diagnostics := [Diagnostic]{}
        facts := sema_effect_shared_facts(modules[inputs[module_index].module_index].call_facts)
        facts = loop fresh_item in facts -> fresh_item
        facts.sort_by((left: SemaCallSiteFact, right: SemaCallSiteFact) -> (left.shared_source <=> right.shared_source).then(left.span.start <=> right.span.start).then(left.span.end <=> right.span.end).then(left.shared_member <=> right.shared_member))
        loop fact in facts {
            lifetime: fact.shared_lifetime ?? next
            initializer: fact.callee ?? panic("Core publication obligation has no initializer")
            target: sema_effect_node_index(calls.node_by_key, initializer.key) ?? panic("Core publication initializer has no solved effect row")
            // `Panic` is the deny-only stop row, not an effect
            // the published value can carry, so it does not make it impure.
            impure := false
            loop effect_name in solved[target] {
                if effect_name != "Mem" && sema_effect_root(effect_name) != "Panic" {
                    impure = true
                    break
                }
            }
            conflicting := false
            if sites.get(initializer.key) == .Val(previous) -> conflicting = previous != lifetime
            if impure || conflicting -> site_diagnostics.push(sema_call_core_shared_diagnostic(fact.shared_member, fact.span))
            if sites.get(initializer.key) == None -> sites[initializer.key] = lifetime
        }
        sema_effect_publish_diagnostics(diagnostics, inputs[module_index].source_segments, site_diagnostics)
    }
    secret_reach: sema_effect_secret_reach(nodes, callers)
    library_reach: sema_library_effect_reach(nodes, callers)
    dispatch_reach: sema_effect_dispatch_reach(nodes, callers)
    dispatch_seen := (loop _ in nodes -> false)
    pure_nodes := [Int]{}
    pure_rows := [[String]]{}
    loop node_index in 0..<nodes.len() {
        function_diagnostics := [Diagnostic]{}
        pure_reached := [String]{}
        dispatch := Diagnostic?{None}
        if (nodes[node_index].has_declared_row || nodes[node_index].is_pure) && dispatch_reach[node_index] {
            visited := [Int]{}
            site: sema_effect_find_dispatch(nodes, calls.node_by_key, dispatch_reach, node_index, dispatch_seen, visited)
            loop row in visited -> dispatch_seen[row] = false
            if site == .Val(found) {
                dispatch = Val(sema_effect_locate_dispatch(found, inputs))
            }
        }
        panic_steps := [String]{}
        if nodes[node_index].prohibited.len() > 0 -> panic_steps = sema_effect_panic_steps(nodes, calls.node_by_key, node_index)
        notes: sema_effect_instance_notes(nodes, calls.node_by_key, solved, nodes[node_index])
        if !sema_effect_check_node(nodes[node_index], solved[node_index], secret_reach[node_index], dispatch, panic_steps, notes, pure_reached, function_diagnostics) {
            // Keep all diagnostics; the caller receives one complete graph
            // result instead of a partially updated function list.
        }
        sema_library_effect_check_denials(nodes[node_index], library_reach[node_index], function_diagnostics)
        if pure_reached.len() > 0 {
            pure_nodes.push(node_index)
            pure_rows.push(pure_reached)
        }
        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, function_diagnostics)
    }
    loop node_index in 0..<nodes.len() {
        if nodes[node_index].callback_bounds.len() == 0 && nodes[node_index].lambda_bounds.len() == 0 -> next
        callback_diagnostics := [Diagnostic]{}
        sema_effect_check_callback_bounds(nodes, calls.node_by_key, solved, node_index, callback_diagnostics)
        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, callback_diagnostics)
    }
    // A pure function may not write module state, itself or through any
    // function it calls or takes as a value.
    loop node_index in 0..<nodes.len() {
        if !nodes[node_index].is_pure -> next
        seen := (loop _ in nodes -> false)
        path: sema_effect_state_writer_path(nodes, calls.node_by_key, node_index, seen)
        if path.len() == 0 -> next
        state_diagnostics := [Diagnostic]{sema_effect_pure_state_diagnostic(nodes, path)}
        // The report points at the write, which may be in another module.
        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[path[path.len() - 1]].module_index].source_segments, state_diagnostics)
    }
    // No function a runtime entry reaches may make a comptime input.
    loop path in sema_effect_runtime_input_paths(nodes, calls.node_by_key, modules, inputs, prep_functions) {
        maker: path[path.len() - 1]
        input_diagnostics := loop input in nodes[maker].comptime_inputs -> sema_effect_runtime_input_diagnostic(nodes, path, input)
        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[maker].module_index].source_segments, input_diagnostics)
    }
    loop module_index in 0..<inputs.len() {
        module_row: inputs[module_index]
        bound_diagnostics := [Diagnostic]{}
        sema_effect_check_trait_bounds(module_row, modules[module_row.module_index].functions, source_indices[module_index], nodes, calls.node_by_key, solved, bound_diagnostics)
        sema_effect_publish_diagnostics(diagnostics, module_row.source_segments, bound_diagnostics)
    }
    loop node_index in 0..<nodes.len() {
        memory_diagnostics := [Diagnostic]{}
        sema_effect_check_memory_denials(nodes, calls.node_by_key, node_index, memory_diagnostics, memory_facts)
        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, memory_diagnostics)
    }
    // Rust bundle_memory_inputs: a manifest guarantee covers every qualified
    // function, including otherwise unreferenced bodies, not just entry.
    loop name in package_denials {
        fact: sema_effect_memory_fact(name) ?? next
        declaration: SemaMemoryFactDeclaration{fact: fact, roots: loop node in nodes -> node.display_key, span: Span{start: 0, end: 0}, source: "package.jet", provenance: "manifest denial `authority: {{ deny: [{name}] }}`"}
        memory_facts.declarations.push(declaration)
        loop root in 0..<nodes.len() {
            memory_diagnostics := [Diagnostic]{}
            projection: sema_effect_memory_project(nodes, calls.node_by_key, root, EffectRowEntry{name: name, span: Span{start: 0, end: 0}}, memory_diagnostics)
            memory_facts.projections.push(SemaMemoryProjectionRow{root: nodes[root].display_key, fact: fact, projection: projection})
            sema_effect_publish_diagnostics(diagnostics, inputs[nodes[root].module_index].source_segments, memory_diagnostics)
        }
    }
    // A package's every other denial is a compile-time prohibition on its
    // own functions, exactly as if each wrote `-[!E]>`;
    // memory denials are the facts above.
    loop name in package_denials {
        if sema_effect_memory_fact(name) != None -> next
        denied: sema_effect_parse_name(name) ?? next
        loop node_index in 0..<nodes.len() {
            graph_module: inputs[nodes[node_index].module_index].module_index
            if graph_module >= denial_modules.len() || !denial_modules[graph_module] -> next
            reached: sema_effect_covered(solved[node_index], [String]{denied})
            if reached.len() == 0 -> next
            panic_steps := [String]{}
            if sema_effect_root(denied) == "Panic" -> panic_steps = sema_effect_panic_steps(nodes, calls.node_by_key, node_index)
            denial_diagnostics := [Diagnostic]{}
            denial_diagnostics.push(sema_effect_with_instance_notes(sema_effect_package_denied_diagnostic(nodes[node_index], reached, denied, panic_steps), sema_effect_instance_notes(nodes, calls.node_by_key, solved, nodes[node_index]), reached))
            sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, denial_diagnostics)
        }
    }
    // A module's `#FX(…)` caps bind every function inside it: a file
    // module's from the module graph, an inline module's from the function.
    // A type's cap binds each of its methods, and a trait's cap every
    // implementation of its methods, in any package. A cap whose entries
    // scope FS or Net also binds at run time: its frame is entered with the
    // function's own (FnBody.effect_scope).
    cap_frames := [String]{}
    loop node_index in 0..<nodes.len() {
        graph_module: inputs[nodes[node_index].module_index].module_index
        caps := [SemaEffectModuleCap]{}
        if graph_module < file_caps.len() {
            loop cap in file_caps[graph_module] -> caps.push(cap.copy())
        }
        loop cap in nodes[node_index].module_caps -> caps.push(SemaEffectModuleCap{cap: cap, site: None})
        if nodes[node_index].type_cap == .Val(type_cap) -> caps.push(type_cap.copy())
        if nodes[node_index].trait_key != "" {
            if calls.trait_caps.get(nodes[node_index].trait_key) == .Val(found) {
                site: if found.module_identity == nodes[node_index].module_identity -> None else -> found.cap.site
                caps.push(SemaEffectModuleCap{cap: found.cap.cap, site: site})
            }
        }
        cap_frames.push(sema_effect_cap_frames(caps))
        if caps.len() == 0 -> next
        cap_diagnostics := [Diagnostic]{}
        notes: sema_effect_instance_notes(nodes, calls.node_by_key, solved, nodes[node_index])
        loop cap in caps -> sema_effect_check_module_cap(nodes, calls.node_by_key, node_index, solved[node_index], cap, notes, cap_diagnostics)
        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, cap_diagnostics)
    }
    loop module_index in 0..<inputs.len() {
        sema_effect_check_module_regions(modules[inputs[module_index].module_index].functions, inputs[module_index], module_index, source_indices[module_index], solved, calls, nodes, diagnostics)
    }
    loop module_row in inputs {
        sema_effect_check_discarded(modules[module_row.module_index].call_facts, module_row, nodes, calls.node_by_key, solved, diagnostics)
    }
    // All source reads are finished: stamp the solved rows in place.
    loop module_row in inputs {
        target: module_row.module_index
        loop function_index in 0..<modules[target].functions.len() {
            node_index: sema_effect_node_index(calls.node_by_key, modules[target].functions[function_index].key) ?? next
            modules[target].functions[function_index].effects = sema_effect_tfacts(nodes[node_index], solved[node_index])
            if cap_frames[node_index] != "" && !modules[target].functions[function_index].effect_scope.starts_with(cap_frames[node_index]) {
                modules[target].functions[function_index].effect_scope = sema_effect_capped_scope(cap_frames[node_index], modules[target].functions[function_index].effect_scope)
            }
        }
    }
    // e3401 names the first impure call and its chain; the reached row is the
    // report when no single call carries it.
    loop (pending, node_index) in pure_nodes {
        pure_diagnostics := [Diagnostic]{}
        pure_diagnostics.push(sema_pure_root_find(nodes[node_index].key, modules, decls, true) ?? sema_effect_pure_diagnostic(nodes[node_index], pure_rows[pending]))
        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, pure_diagnostics)
    }
    complete: !sema_has_error_since(diagnostics, 0)
    SemaEffectGraphResult{diagnostics: diagnostics.move(), complete: complete, memory_declarations: memory_facts.declarations.move(), memory_projections: memory_facts.projections.move()}
}

// The rows of the effect graph each input module contributes on its own:
// its functions' nodes (with their keys, their declarations' DeclTable rows
// (-1: none) and the diagnostics building them reported), the index of its
// effect sources and the index of its call facts, all in input order.
SemaEffectPrepared: struct {
    nodes: [SemaEffectNode]
    node_keys: [String]
    node_decls: [Int]
    diagnostics: [Diagnostic]
    source_indices: [SemaEffectSourceIndex]
    calls: [SemaEffectModuleCalls]
}

sema_effect_prepared_empty: fn() -> SemaEffectPrepared Never! {
    SemaEffectPrepared{nodes: [SemaEffectNode]{}, node_keys: [String]{}, node_decls: [Int]{}, diagnostics: [Diagnostic]{}, source_indices: [SemaEffectSourceIndex]{}, calls: [SemaEffectModuleCalls]{}}
}

// Every input module's rows, in input order.
sema_effect_prepare_modules: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], decls: DeclTable) -> SemaEffectPrepared {
    prepared := sema_effect_prepared_empty()
    loop (input_position, module_row) in inputs -> sema_effect_prepare_module(prepared, modules[module_row.module_index].functions, modules[module_row.module_index].call_facts, module_row, input_position, decls)
    prepared
}

// Appends the rows of the input module at `input_position`.
sema_effect_prepare_module: fn(prepared: &SemaEffectPrepared, functions: [FnBody], call_facts: [SemaCallSiteFact], module_row: SemaEffectModuleInput, input_position: Int, decls: DeclTable) {
    source_index := sema_effect_source_index(module_row.sources)
    sema_effect_add_module_nodes(functions, module_row, input_position, source_index, prepared.nodes, prepared.node_keys, prepared.diagnostics)
    loop function in functions {
        row: if decl_table_find(decls, function.key) == .Val(id) -> id.row.index() else -> -1
        prepared.node_decls.push(row)
    }
    prepared.source_indices.push(source_index)
    prepared.calls.push(sema_effect_module_calls(call_facts))
}

// Appends `part`, the rows of the next input modules, built with input
// positions counted from 0; `inputs_before` is the number of input modules
// whose rows `prepared` already holds.
sema_effect_prepared_join: fn(prepared: &SemaEffectPrepared, part: &&SemaEffectPrepared, inputs_before: Int) {
    owned := part.move()
    loop index in 0..<owned.nodes.len() -> owned.nodes[index].module_index = owned.nodes[index].module_index + inputs_before
    prepared.nodes.extend(owned.nodes.move())
    prepared.node_keys.extend(owned.node_keys.move())
    prepared.node_decls.extend(owned.node_decls.move())
    prepared.diagnostics.extend(owned.diagnostics.move())
    prepared.source_indices.extend(owned.source_indices.move())
    prepared.calls.extend(owned.calls.move())
}

// One graph node per function of the input module `module_index`, in order,
// and its key in `node_keys` (node order).
sema_effect_add_module_nodes: fn(functions: [FnBody], module_row: SemaEffectModuleInput, module_index: Int, source_index: SemaEffectSourceIndex, nodes: &[SemaEffectNode], node_keys: &[String], diagnostics: &[Diagnostic]) {
    loop function in functions {
        function_diagnostics := [Diagnostic]{}
        node_keys.push(function.key)
        nodes.push(sema_effect_node_from_source(function, module_row.sources, sema_effect_source_position(function, source_index), module_index, module_row.library_effects, function_diagnostics))
        sema_effect_publish_diagnostics(diagnostics, module_row.source_segments, function_diagnostics)
    }
}

// Each key's first node, hashed (A1); the table's `texts` hold the keys in
// first-node order.
sema_effect_node_key_table: fn(node_keys: [String]) -> NameRows Never! {
    table := name_rows()
    loop (node, key) in node_keys {
        if name_rows_get_text(table, key) == None -> name_rows_set(table, key, node)
    }
    table
}

// The trait-implementation tables of one effect check. Owners group per
// `{module}|{trait}` key in first-seen order, each owner once
// (`implementer_seen`), appended in place: O(rows), not a list scan and copy
// per row. `trait_impls` is each `{module}|{trait}::{method}#{owner}`
// implementation's node key. Every implementation of a trait method also
// joins its `{module}|{trait}::{method}` group (`dyn_lists` by
// `dyn_groups`), the targets of a call through a trait value.
SemaEffectImplTables: struct {
    implementer_groups: [String:Int]{[String:Int]{}}
    implementer_keys: [String]{[String]{}}
    implementer_lists: [[String]]{[[String]]{}}
    implementer_seen: [String:Bool]{[String:Bool]{}}
    trait_impls: [String:String]{[String:String]{}}
    dyn_groups: [String:Int]{[String:Int]{}}
    dyn_keys: [String]{[String]{}}
    dyn_lists: [[String]]{[[String]]{}}
}

// `owner` as an implementing type of trait `trait_key`, once.
sema_effect_add_implementer: fn(tables: &SemaEffectImplTables, trait_key: String, owner: String) {
    seen_key: "{trait_key}::{owner}"
    if tables.implementer_seen.get(seen_key) != None -> return
    tables.implementer_seen[seen_key] = true
    group_row := tables.implementer_groups.get(trait_key) ?? -1
    if group_row < 0 {
        group_row = tables.implementer_lists.len()
        tables.implementer_groups[trait_key] = group_row
        tables.implementer_keys.push(trait_key.copy())
        tables.implementer_lists.push([String]{})
    }
    tables.implementer_lists[group_row].push(owner.copy())
}

// Each implementation's node key per implementing type, first one kept
// (Rust `seed_trait_dispatch_effects`), its owner as an implementer, and its
// place in its method's trait-value group. The trait is the one its source
// resolved where the `impl` block is written, so an `impl Trait` block in a
// struct or enum body and an impl of another module's trait count too.
sema_effect_add_trait_impls: fn(functions: [FnBody], module_row: SemaEffectModuleInput, source_index: SemaEffectSourceIndex, tables: &SemaEffectImplTables) {
    loop function in functions {
        trait_key := ""
        if sema_effect_source_position(function, source_index) == .Val(at) -> trait_key = module_row.sources[at].trait_key
        owner_type: if function.kind == {
            .TraitMethod(_, _, owner_type, trait_symbol, _) -> {
                if trait_key == "" -> trait_key = sema_effect_trait_cap_key(trait_symbol.key)
                owner_type
            }
            .Method(_, owner_type) -> owner_type
            .TopLevel -> next
        }
        if trait_key == "" -> next
        owner: sema_effect_symbol_leaf(type_name(owner_type))
        sema_effect_add_implementer(tables, trait_key, owner)
        method_key: "{trait_key}::{sema_effect_method_name(function, module_row.sources, source_index)}"
        impl_key: "{method_key}#{owner}"
        if tables.trait_impls.get(impl_key) == None -> tables.trait_impls[impl_key] = function.key
        group_row := tables.dyn_groups.get(method_key) ?? -1
        if group_row < 0 {
            group_row = tables.dyn_lists.len()
            tables.dyn_groups[method_key] = group_row
            tables.dyn_keys.push(method_key)
            tables.dyn_lists.push([String]{})
        }
        sema_effect_set_add(tables.dyn_lists[group_row], function.key)
    }
}

// Collects every function's effect sites of input module `module_index` into
// its node, and checks its unsafe calls.
sema_effect_collect_module: fn(functions: [FnBody], module_row: SemaEffectModuleInput, module_index: Int, calls: SemaEffectCallIndex, any_unsafe: Bool, nodes: &[SemaEffectNode], diagnostics: &[Diagnostic]) {
    loop function in functions {
        node_index: sema_effect_node_index(calls.node_by_key, function.key) ?? next
        function_diagnostics := [Diagnostic]{}
        sema_effect_collect_one(nodes, node_index, function, calls, module_index, any_unsafe, function_diagnostics)
        sema_effect_publish_diagnostics(diagnostics, module_row.source_segments, function_diagnostics)
    }
}

// One function's effect sites into its node `node_index`, and its unsafe
// calls; `module_index` is the function's input module (its call facts' row).
sema_effect_collect_one: fn(nodes: &[SemaEffectNode], node_index: Int, function: FnBody, calls: SemaEffectCallIndex, module_index: Int, any_unsafe: Bool, diagnostics: &[Diagnostic]) {
    sema_effect_collect_function(nodes, node_index, function, calls, module_index, diagnostics)
    // A call needs an audited region only when its callee is an
    // `#Unsafe` function, an inline foreign function or a raw `extern rust`
    // function taking a capability; with none in the graph the walk finds
    // nothing.
    if any_unsafe {
        audited := function.is_unsafe && (function.unsafe_gate.map((gate) -> gate.enabled) ?? false)
        sema_effect_check_unsafe_statements_tree(nodes, calls, sema_effect_caller_slot(calls, module_index, function.key), function.tree, function.body, audited, diagnostics)
    }
}

// Whether any call site names an `#Unsafe` inline foreign callee or a raw
// `extern rust` callee taking a capability.
sema_effect_calls_any_unsafe_foreign: fn(modules: [SemaEffectModuleCalls]) -> Bool Never! {
    loop module_calls in modules {
        loop fact in module_calls.facts {
            if fact.unsafe_foreign_name != None || fact.foreign_capability != None -> return true
        }
    }
    false
}

// A compiler thread is admitted for at least this many bytes of function
// source, so a small program collects on the calling thread.
SEMA_EFFECT_COLLECT_MIN_BYTES_PER_THREAD: 65536
// Estimated bytes of one collected copy of one graph node.
SEMA_EFFECT_NODE_BYTES: 1024
// Parts per admitted thread, claimed dynamically.
SEMA_EFFECT_COLLECT_PARTS_PER_THREAD: 8

// sema_effect_collect_module for every input module, on up to `threads`
// compiler threads. A function's collection writes only its own node
// (`node_by_key` of its key) and reads the call index under its own module's
// caller, never another node. The functions that name one node form one unit
// (almost always a single function), collected in module and function order
// into a copy of that node's row; units are independent. Threads claim
// consecutive parts of the units dynamically; the caller then moves each
// unit's row back into the graph's nodes and publishes every function's
// reports in module and function order, exactly as one thread collecting
// the modules in order does. The modules, the graph's nodes and the call
// index move into the threads' shared state and back; the index is returned.
sema_effect_collect_threads: fn(modules: &[SemaGraphModuleResult], inputs: [SemaEffectModuleInput], nodes: &[SemaEffectNode], calls: &&SemaEffectCallIndex, any_unsafe: Bool, diagnostics: &[Diagnostic], threads: CompilerThreads) -> SemaEffectCallIndex {
    index := calls.move()
    // One job per function with a node, in module and function order; a
    // unit's jobs chain through `job_next` from `unit_first`.
    job_input := [Int]{}
    job_function := [Int]{}
    job_next := [Int]{}
    unit_first := [Int]{}
    unit_last := [Int]{}
    unit_nodes := [Int]{}
    unit_weights := [Int]{}
    unit_of_node := [Int:Int]{}
    work := 0
    loop (input_position, module_row) in inputs {
        loop (function_index, function) in modules[module_row.module_index].functions {
            node_index: sema_effect_node_index(index.node_by_key, function.key) ?? next
            job: job_input.len()
            job_input.push(input_position)
            job_function.push(function_index)
            job_next.push(-1)
            weight: function.source_span.end - function.source_span.start
            work += weight
            unit: unit_of_node.get(node_index) ?? -1
            if unit < 0 {
                unit_of_node[node_index] = unit_first.len()
                unit_first.push(job)
                unit_last.push(job)
                unit_nodes.push(node_index)
                unit_weights.push(weight)
            } else {
                job_next[unit_last[unit]] = job
                unit_last[unit] = job
                unit_weights[unit] = unit_weights[unit] + weight
            }
        }
    }
    workers: compiler_threads_admit(threads, unit_first.len(), work, SEMA_EFFECT_COLLECT_MIN_BYTES_PER_THREAD, 0, unit_first.len() * SEMA_EFFECT_NODE_BYTES)
    if workers <= 1 {
        loop (input_position, module_row) in inputs {
            sema_effect_collect_module(modules[module_row.module_index].functions, module_row, input_position, index, any_unsafe, nodes, diagnostics)
        }
        return index
    }
    count := workers * SEMA_EFFECT_COLLECT_PARTS_PER_THREAD
    if count > unit_first.len() -> count = unit_first.len()
    bounds: compiler_threads_partition(unit_weights, count)
    module_rows := loop module_row in inputs -> module_row.module_index
    shared_state: Shared{SemaEffectCollectShared{modules: [SemaGraphModuleResult]{}, calls: [SemaEffectCallIndex]{}, nodes: [SemaEffectNode]{}, module_rows: module_rows.move(), job_input: job_input.move(), job_function: job_function.move(), job_next: job_next.move(), unit_first: unit_first.move(), unit_nodes: unit_nodes.move(), any_unsafe: any_unsafe}}
    sema_effect_collect_fill(shared_state, modules, nodes, index)
    queue: Shared{SemaEffectCollectQueue{next: 0}}
    parts := [[SemaEffectCollected]]{}
    loop _ in 0..<count -> parts.push([SemaEffectCollected]{})
    sema_effect_collect_claimers(shared_state, bounds, queue, 0, workers, parts)
    sema_effect_collect_place(shared_state, bounds, parts, inputs, diagnostics)
    sema_effect_collect_take(shared_state, modules, nodes)
}

// What every collecting thread reads: the modules, the graph's nodes and the
// call index (its one row), moved in and back out; each input module's row
// in `modules`; each job's input module, function and next job of its unit;
// each unit's first job and node; and whether the graph has an `#Unsafe`
// function.
SemaEffectCollectShared: struct {
    modules: [SemaGraphModuleResult]
    calls: [SemaEffectCallIndex]
    nodes: [SemaEffectNode]
    module_rows: [Int]
    job_input: [Int]
    job_function: [Int]
    job_next: [Int]
    unit_first: [Int]
    unit_nodes: [Int]
    any_unsafe: Bool
}

// The next unclaimed part of the collection, taken with one atomic add under
// a read guard each thread holds for its run.
SemaEffectCollectQueue: struct {
    next: Atomic<Int>
}

// One function's reports, not yet located.
SemaEffectCollectReport: struct {
    job: Int
    diagnostics: [Diagnostic]
}

// One unit's collected node row and its functions' nonempty reports.
SemaEffectCollected: struct {
    node: SemaEffectNode
    reports: [SemaEffectCollectReport]
}

// A part one thread collected: its number and, last first, its units' rows.
SemaEffectCollectedPart: struct {
    part: Int
    collected: [SemaEffectCollected]
}

sema_effect_collect_fill: fn(shared_state: Shared<SemaEffectCollectShared>, modules: &[SemaGraphModuleResult], nodes: &[SemaEffectNode], calls: &&SemaEffectCallIndex) {
    permit: shared_state.guard_edit()
    compiler_transfer_rows<SemaGraphModuleResult>(permit.value.modules, modules)
    compiler_transfer_rows<SemaEffectNode>(permit.value.nodes, nodes)
    permit.value.calls.push(calls)
}

// Moves the modules and the nodes back and returns the call index.
sema_effect_collect_take: fn(shared_state: Shared<SemaEffectCollectShared>, modules: &[SemaGraphModuleResult], nodes: &[SemaEffectNode]) -> SemaEffectCallIndex {
    permit: shared_state.guard_edit()
    compiler_transfer_rows<SemaGraphModuleResult>(modules, permit.value.modules)
    compiler_transfer_rows<SemaEffectNode>(nodes, permit.value.nodes)
    permit.value.calls.pop() ?? panic("the effect call index left the threads' shared state")
}

// Moves each unit's collected node row into the graph's nodes, then
// publishes every function's reports in job (module and function) order.
sema_effect_collect_place: fn(shared_state: Shared<SemaEffectCollectShared>, bounds: [Int], parts: &[[SemaEffectCollected]], inputs: [SemaEffectModuleInput], diagnostics: &[Diagnostic]) {
    permit: shared_state.guard_edit()
    reports := [SemaEffectCollectReport]{}
    loop part in 0..<bounds.len() - 1 {
        loop unit in bounds[part]..<bounds[part + 1] {
            collected := parts[part].pop() ?? panic("a collected effect node left its part")
            permit.value.nodes[permit.value.unit_nodes[unit]] = collected.node.move()
            loop collected.reports.len() > 0 {
                report := collected.reports.pop() ?? break
                reports.push(report)
            }
        }
    }
    reports.sort_by((left: SemaEffectCollectReport, right: SemaEffectCollectReport) -> left.job <=> right.job)
    loop report in reports.move() -> sema_effect_publish_diagnostics(diagnostics, inputs[permit.value.job_input[report.job]].source_segments, report.diagnostics.move())
}

// Runs collecting threads `from..<workers`, one task each, and moves every
// part a thread returned into `parts`.
sema_effect_collect_claimers: fn(shared_state: Shared<SemaEffectCollectShared>, bounds: [Int], queue: Shared<SemaEffectCollectQueue>, from: Int, workers: Int, parts: &[[SemaEffectCollected]]) {
    if from >= workers -> return
    task.group sema_effect_threads {
        head: task sema_effect_collect_claimed(shared_state, bounds, queue)
        sema_effect_collect_claimers(shared_state, bounds, queue, from + 1, workers, parts)
        claimed := head.join() ?? panic(compiler_threads_failure_text(err))
        loop claimed.len() > 0 {
            done := claimed.pop() ?? break
            parts[done.part] = compiler_take_rows<SemaEffectCollected>(done.collected)
        }
    }
}

// One thread: collects the parts it claims, in order, each unit into its own
// copy of the unit's node row.
sema_effect_collect_claimed: fn(shared_state: Shared<SemaEffectCollectShared>, bounds: [Int], queue: Shared<SemaEffectCollectQueue>) -> [SemaEffectCollectedPart] {
    inputs: shared_state.guard_read()
    claimed := [SemaEffectCollectedPart]{}
    ranks: queue.guard_read()
    loop {
        part: ranks.value.next.add(1)
        if part >= bounds.len() - 1 -> break
        collected := [SemaEffectCollected]{}
        loop unit in bounds[part]..<bounds[part + 1] {
            // copy: the unit's functions write their own row, while the
            // graph's row (owner: the shared state) stays in place.
            own := [SemaEffectNode]{inputs.value.nodes[inputs.value.unit_nodes[unit]].copy()}
            reports := [SemaEffectCollectReport]{}
            job := inputs.value.unit_first[unit]
            loop job >= 0 {
                function_diagnostics := [Diagnostic]{}
                input_position: inputs.value.job_input[job]
                // Passed straight through: a local binding of a guarded row would copy it.
                sema_effect_collect_one(own, 0, inputs.value.modules[inputs.value.module_rows[input_position]].functions[inputs.value.job_function[job]], inputs.value.calls[0], input_position, inputs.value.any_unsafe, function_diagnostics)
                if function_diagnostics.len() > 0 -> reports.push(SemaEffectCollectReport{job: job, diagnostics: function_diagnostics.move()})
                job = inputs.value.job_next[job]
            }
            node := own.pop() ?? panic("a collected effect node left its unit")
            collected.push(SemaEffectCollected{node: node.move(), reports: reports.move()})
        }
        collected.reverse()
        claimed.push(SemaEffectCollectedPart{part: part, collected: collected.move()})
    }
    claimed
}

// The module's Core publication obligations (facts with a shared lifetime).
sema_effect_shared_facts: fn(call_facts: [SemaCallSiteFact]) -> [SemaCallSiteFact] {
    facts := [SemaCallSiteFact]{}
    loop fact in call_facts {
        // copy: the obligations are sorted on their own; the module keeps its facts.
        if fact.shared_lifetime != None -> facts.push(fact.copy())
    }
    facts
}

// Every `#FX(…)` region of the functions of input module `module_index` stays
// within its caps.
sema_effect_check_module_regions: fn(functions: [FnBody], module_row: SemaEffectModuleInput, module_index: Int, source_index: SemaEffectSourceIndex, solved: [[String]], calls: SemaEffectCallIndex, nodes: &[SemaEffectNode], diagnostics: &[Diagnostic]) {
    region_diagnostics := [Diagnostic]{}
    loop function in functions {
        at: sema_effect_source_position(function, source_index) ?? next
        if module_row.sources[at].fx_regions.len() == 0 -> next
        node_index: sema_effect_node_index(calls.node_by_key, function.key) ?? next
        loop region in module_row.sources[at].fx_regions {
            inferred: sema_effect_region_inferred(nodes, solved, node_index, function, region, calls, module_index)
            over: sema_effect_uncovered(inferred, region.caps)
            if over.len() > 0 -> region_diagnostics.push(sema_effect_scope_diagnostic("FX", over, region.caps, region.caps_span))
        }
    }
    sema_effect_publish_diagnostics(diagnostics, module_row.source_segments, region_diagnostics)
}

// A discarded call result of a function whose row has no outcome (E0433).
sema_effect_check_discarded: fn(call_facts: [SemaCallSiteFact], module_row: SemaEffectModuleInput, nodes: [SemaEffectNode], node_by_key: NameRows, solved: [[String]], diagnostics: &[Diagnostic]) {
    discarded := [Diagnostic]{}
    loop fact in call_facts {
        if !fact.discarded -> next
        callee: fact.callee ?? next
        node_index: sema_effect_node_index(node_by_key, callee.key) ?? next
        // What the call binds the callee's type parameters to does its own
        // work (`measure(Square{…})` runs `Square::area`).
        if nodes[node_index].param_dispatches.len() > 0 -> next
        if !sema_effect_row_has_no_outcome(nodes[node_index], solved[node_index]) -> next
        discarded.push(sema_effect_discarded_result_diagnostic(nodes[node_index], fact.span))
    }
    sema_effect_publish_diagnostics(diagnostics, module_row.source_segments, discarded)
}


// The walkers over a checked flat body: the one a child visit continues
// with, and its own arguments (sema_effect_walk_expr,
// sema_effect_check_unsafe_expr, sema_effect_walk_region_expr, and
// FailureLaw's prelude-conversion demand walk
// sema_prelude_conversion_demands_enter, whose state is its one row).
SemaEffectWalk: enum {
    Collect(node_index: Int)
    Unsafe(audited: Bool)
    Region(node_index: Int, region: Span)
    PreludeDemands(state: Shared<SemaPreludeDemandWalk>)
    // A lambda body: its Iterable loops, value reads and stops, none of which
    // its call facts hold, charged to the enclosing node.
    LambdaBody(node_index: Int)
}

sema_effect_walk_visit: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, expression: Int) {
    node: body_node(tree, expression)
    next: sema_effect_walk_enter(walk, nodes, facts, diagnostics, caller, tree, expression, node) ?? return
    sema_effect_walk_expr_children(next, nodes, facts, diagnostics, caller, tree, node)
}

// A walker's own work on `node`, the node at `expression`, before its
// children: the walk they continue with, or None when they aren't walked.
sema_effect_walk_enter: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, expression: Int, node: BodyNode) -> SemaEffectWalk? {
    if walk == {
        .Collect(node_index) -> if sema_effect_walk_expr_enter(nodes, node_index, tree, expression, node, facts, diagnostics, caller) -> Val(walk) else -> None
        .Unsafe(audited) -> if sema_effect_check_unsafe_enter(nodes, facts, caller, tree, node, audited, diagnostics) -> Val(walk) else -> None
        .Region(node_index, region) -> sema_effect_walk_region_enter(nodes, node_index, tree, expression, node, region, facts, diagnostics, caller)
        .PreludeDemands(state) -> {
            sema_prelude_conversion_demands_enter(state, node)
            Val(walk)
        }
        .LambdaBody(node_index) -> {
            // A lambda body's value reads and stops are the enclosing node's,
            // as its calls are the enclosing node's edges; so are the bounded
            // callback slots it fills.
            sema_effect_record_value_reads(nodes, facts, node_index, tree, expression, node)
            sema_effect_record_stop(nodes, node_index, node)
            sema_effect_record_comptime_input(nodes, node_index, node)
            if node.kind == {
                .ConstRef(symbol) -> sema_effect_record_callback_bound(nodes, facts.node_by_key, node_index, symbol.key, body_type(tree, expression), node.span)
                .Lambda(value) -> sema_effect_record_lambda_bound(nodes, node_index, facts, caller, tree, value, body_type(tree, expression), node.span)
                .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
            }
            Val(walk)
        }
    }
}

// A stop (`panic`, `assert`, a `Never` value, `value ?? panic(message)`)
// puts `Panic` in the row of the node it is charged to. So does an index the
// checker did not prove: a list or map read, a range index or
// a slice keeps its runtime bounds or key check, which stops on a miss. A
// fixed-list index proved by its interval (FixedListProof) can't stop, and a
// user `Index` impl's own row arrives through its call.
sema_effect_record_stop: fn(nodes: &[SemaEffectNode], node_index: Int, node: BodyNode) Never! {
    if node.kind == {
        .RequireStop(_, _, _) | .Never(_, _) -> sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
        .OrFallback(_, fallback, _) -> {
            if fallback == .Panic(_, _) -> sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
        }
        .Index(_, _, kind, _, _, _) -> {
            if kind == .List || kind == .Range || kind == .Map -> sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
        }
        .Slice(_, _, _, _, _) -> sema_effect_node_add_edge(nodes, node_index, "__jet_panic__")
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
    }
}

// A Binary node's operands. A left-leaning chain (`a + b + c …`) walks its
// left spine in this frame, so its length costs no stack: each inner level's
// own work going down, the innermost left operand, then each level's right
// operand, innermost first, under the walk its level continues with. That is
// the order visiting level by level runs them.
sema_effect_walk_binary: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, lhs: Int, rhs: Int) {
    rights := [Int]{rhs}
    walks := [SemaEffectWalk]{walk}
    current := walk
    operand := lhs
    loop {
        node: body_node(tree, operand)
        if node.kind == .Binary(_, _, _, inner_lhs, inner_rhs) {
            if sema_effect_walk_enter(current, nodes, facts, diagnostics, caller, tree, operand, node) == .Val(next) {
                rights.push(inner_rhs)
                walks.push(next.copy())
                current = next
                operand = inner_lhs
            } else {
                operand = -1
                break
            }
        } else {
            break
        }
    }
    if operand >= 0 -> sema_effect_walk_visit(current, nodes, facts, diagnostics, caller, tree, operand)
    index := rights.len() - 1
    loop index >= 0 {
        sema_effect_walk_visit(walks[index], nodes, facts, diagnostics, caller, tree, rights[index])
        index -= 1
    }
}

// The child nodes of a checked body node: the same nodes in the same order
// as Foundation's body_each_expr_child / body_each_stmt_child visit them.
// Every match below names each variant and has no wildcard arm, so a new
// node variant fails to compile here instead of being silently skipped; add
// it here in the order Body.jet's child visitors give it. A lambda body is
// walked under its own call-fact key (sema_effect_walk_lambda_children),
// which the generic visitors cannot do.
sema_effect_walk_expr_children: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, node: BodyNode) {
    if node.kind == {
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .Local(_) | .Unit | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) | .GlobalShared(_, _) | .InvariantViolation(_, _) | .Absent | .SelectStart | .Never(_, _) | .TypeTest(_, _) -> {}
        .StrLit(parts) -> loop part in parts {
            if part == {
                .Interpolation(value, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
                .Literal(_) -> {}
            }
        }
        .InlineBlock(body) -> sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        .Call(_, _, args) -> loop argument in args -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, argument.value)
        .IndirectCall(callee, _, args, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, callee)
            loop argument in args -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, argument.value)
        }
        .MethodCall(receiver, _, _, args) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, receiver)
            loop argument in args -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, argument.value)
        }
        .DistinctCtor(argument) | .DistinctConvert(_, argument, _, _, _) | .TraitBox(argument, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, argument)
        .UnitConvert(argument, _, _, rounding, _, _, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, argument)
            if rounding == .Val(rounding_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, rounding_value.digits)
        }
        .MathBuiltin(_, _, args) | .PreciseBuiltin(_, _, args) -> loop value in args -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .Print(value) | .Drop(value) | .Close(value) | .Move(value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .RequireStop(kind, _, _) -> sema_effect_walk_require_children(walk, nodes, facts, diagnostics, caller, tree, kind)
        .Binary(_, _, _, lhs, rhs) -> sema_effect_walk_binary(walk, nodes, facts, diagnostics, caller, tree, lhs, rhs)
        .CompareChain(operands, _, _) -> loop value in operands -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .Unary(_, operand) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, operand)
        .StructLit(fields) -> loop field in fields -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, field.value)
        .Field(receiver, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, receiver)
        .Index(base, index, _, _, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, base)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, index)
        }
        .Slice(base, start, end, range, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, base)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, start)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, end)
            if range == .Val(range_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, range_value)
        }
        .Range(start, end, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, start)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, end)
        }
        .Tuple(values) | .List(values, _) -> loop value in values -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .Map(entries) | .MapLit(entries) -> loop entry in entries {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, entry.key)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, entry.value)
        }
        .EnumCtor(_, _, payload) | .EnumLit(_, _, payload) -> {
            if payload == {
                .Positional(args) -> loop argument in args -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, argument.value)
                .Named(fields) -> loop field in fields -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, field.value.value)
                .Unit -> {}
            }
        }
        .Present(value) | .Ok(value) | .Err(value) | .DistinctRaw(value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .Try(value, _, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .TryWithContext(inner, note, _, _, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, inner)
            if note == .Val(note_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, note_value)
        }
        .Lambda(value) -> sema_effect_walk_lambda_children(walk, nodes, facts, diagnostics, caller, tree, value)
        .Borrow(place, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, place)
        .RawAddressOf(place) -> sema_effect_walk_place_children(walk, nodes, facts, diagnostics, caller, tree, place)
        .RawOf(value) | .Deref(value) | .PtrFromAddr(value, _) | .LayoutLiteral(value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .LayoutCompare(_, lhs, rhs) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, lhs)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, rhs)
        }
        .SharedGuardValue(guard) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, guard)
        .SharedGuardMap(guard, _, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, guard)
        .SharedGuardSplit(guard, _, _, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, guard)
        .SharedGuardWait(guard, condition, predicate) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, guard)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, condition)
            sema_effect_walk_lambda_children(walk, nodes, facts, diagnostics, caller, tree, predicate)
        }
        .ConditionNotify(condition, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, condition)
        .CoreCall(_, args, _, _, _, _) -> loop value in args -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .HostCall(call) -> sema_effect_walk_host_call_children(walk, nodes, facts, diagnostics, caller, tree, call)
        .JSONLit(_, argument, _) -> {
            if argument == .Val(argument_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, argument_value)
        }
        .AllocNew(_, args) -> loop argument in args -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, argument.value)
        .ListLit(values) -> loop value in values -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .ListSpread(parts) -> loop part in parts {
            if part == {
                .Element(value) | .Spread(value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
            }
        }
        .PoolSlot(pool, id, _, _, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, pool)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, id)
        }
        .Clone(value, _) | .ExplicitCopy(value) | .MaterializeView(value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .StaticCall(_, _, _, _, args) -> loop argument in args -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, argument.value)
        .DecodeUnder(segment, inner) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, segment)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, inner)
        }
        .BuiltinMethod(receiver, _, args) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, receiver)
            loop value in args -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        }
        .IfExpr(cond, then_body, then_value, else_body, else_value) -> {
            sema_effect_walk_if_cond_children(walk, nodes, facts, diagnostics, caller, tree, cond)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, then_body)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, then_value)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, else_body)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, else_value)
        }
        .OrFallback(value, fallback, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
            if fallback == {
                .Value(fallback_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, fallback_value)
                .Return(returned) -> {
                    if returned == .Val(returned_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, returned_value)
                }
                .Panic(message, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, message)
                .Break | .Continue | .BreakLabel(_) | .ContinueLabel(_) -> {}
            }
        }
        .OptField(base, _, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, base)
        .OptMethodCall(base, _, call, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, base)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, call)
        }
        .PatternMatches(subject, pattern) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, subject)
            sema_effect_walk_pattern_children(walk, nodes, facts, diagnostics, caller, tree, pattern.shape)
        }
        .OptionLift2(function, left, right) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, function)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, left)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, right)
        }
        .ClosureMethod(receiver, _, args) | .HandleMethod(receiver, _, args) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, receiver)
            loop value in args -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        }
        .NumericMethod(receiver, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, receiver)
        .NumericBinaryMethod(receiver, _, argument) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, receiver)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, argument)
        }
        .OverflowOpt(_, _, _, lhs, rhs) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, lhs)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, rhs)
        }
        .CoreClosureCall(kind) -> sema_effect_walk_core_closure_children(walk, nodes, facts, diagnostics, caller, tree, kind)
        .TaskGroupAll(tasks) | .TaskGroupRace(tasks) | .TaskGroupAny(tasks) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, tasks)
        .SelectRecv(builder, channel) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, builder)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, channel)
        }
        .SelectAfter(builder, duration, value) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, builder)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, duration)
            if value == .Val(selected) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, selected)
        }
        .SelectWait(builder, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, builder)
        .FnValue(kind) -> {
            if kind == {
                .NamedFn(_, lambda) -> {
                    if lambda == .Val(lambda_value) -> sema_effect_walk_lambda_children(walk, nodes, facts, diagnostics, caller, tree, lambda_value)
                }
                .Policy(_, policy_args, _, _, _, callee) -> {
                    loop argument in policy_args -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, argument.value)
                    sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, callee)
                }
                .Call(callee, args) -> {
                    sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, callee)
                    loop argument in args -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, argument.value)
                }
                .Send(value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
            }
        }
    }
}

// body_each_stmt_child's children (see sema_effect_walk_expr_children).
sema_effect_walk_stmt_children: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, statement: StmtKind) {
    if statement == {
        .Contract(contract) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, contract.condition)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, contract.message)
        }
        .ContractScope(pre, body, post, _, _) -> {
            loop contract in pre {
                sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, contract.condition)
                sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, contract.message)
            }
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
            loop contract in post {
                sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, contract.condition)
                sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, contract.message)
            }
        }
        .Let(_, _, init, _, _, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, init)
        .RefutableBind(pattern, init, fallback, _) -> {
            sema_effect_walk_pattern_children(walk, nodes, facts, diagnostics, caller, tree, pattern.shape)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, init)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, fallback)
        }
        .TupleDestructure(_, init, _, _, _) | .StructDestructure(_, init, _, _, _) | .ListDestructure(_, init, _, _, _, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, init)
        .Assign(place, _, value, _, _) -> {
            sema_effect_walk_place_children(walk, nodes, facts, diagnostics, caller, tree, place)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        }
        .Return(value, _) -> {
            if value == .Val(returned) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, returned)
        }
        .ExprStmt(value, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .TaskGroup(_, args, body, _) -> {
            if args.limit == .Val(limit_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, limit_value)
            if args.stack == .Val(stack_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, stack_value)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        }
        .DeferClose(close, _, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, close)
        // An else-if chain is one `If` per `else`, whose children are exactly
        // tree_else_children_into's order.
        .If(condition, then_body, else_body, _, _) -> {
            sema_effect_walk_if_cond_children(walk, nodes, facts, diagnostics, caller, tree, condition)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, then_body)
            if else_body == .Val(else_statements) -> sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, else_statements)
        }
        .Loop(_, body, _) -> sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        .While(_, condition, body, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, condition)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        }
        .CountedLoop(_, init, condition, step, _, body, _) -> {
            sema_effect_walk_stmt_children(walk, nodes, facts, diagnostics, caller, tree, tree.stmts[init])
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, condition)
            if step == .Val(step_statement) -> sema_effect_walk_stmt_children(walk, nodes, facts, diagnostics, caller, tree, tree.stmts[step_statement])
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        }
        .ForRange(_, _, start, end, step, _, body, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, start)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, end)
            if step == .Val(step_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, step_value)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        }
        .Range(_, _, source, start, end, step, _, _, body, _) -> {
            if source == .Val(source_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, source_value)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, start)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, end)
            if step == .Val(step_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, step_value)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        }
        .BreakValue(_, value, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .Match(subject, arms, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, subject)
            sema_effect_walk_match_arm_children(walk, nodes, facts, diagnostics, caller, tree, arms)
        }
        .EnumMatch(scrutinee, arms, else_body, _, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, scrutinee)
            sema_effect_walk_match_arm_children(walk, nodes, facts, diagnostics, caller, tree, arms)
            if else_body == .Val(else_statements) -> sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, else_statements)
        }
        .RangeSwitch(subject, arms, else_body, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, subject)
            loop arm in arms -> sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, arm.body)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, else_body)
        }
        .ForIn(_, _, _, source, collection, step, method_kind, _, _, _, body, span) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, source)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, collection)
            if method_kind == .Val(kind) {
                if kind == .Iterable(_, iter_type, iter_symbol, next_symbol, _) -> sema_effect_record_iterable_loop(walk, nodes, facts, iter_type, iter_symbol, next_symbol, span)
            }
            if step == .Val(step_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, step_value)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        }
        .Inline(body, _) | .DebugOnly(body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) -> sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        .MixedSwitch(subject, _, arms, else_body, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, subject)
            loop arm in arms {
                sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, arm.condition)
                sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, arm.body)
            }
            if else_body == .Val(else_statements) -> sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, else_statements)
        }
        .Unsafe(_, body) -> sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) -> sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        .Reactive(executable, _) -> sema_effect_walk_lambda_children(walk, nodes, facts, diagnostics, caller, tree, executable)
        .Layout(_, _, body, _) -> sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        .ContextBlock(guards, body, _) -> {
            loop guard in guards -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, guard.value)
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        }
        .ScopeMember(kind, body, _) -> {
            if kind == {
                .Timeout(duration) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, duration)
                .Setup | .ExpectFail(_, _) | .Measure | .Skip -> {}
            }
            sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        }
        .Transact(_, _, _, body, _) -> sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, body)
        .GCEdit(_, _, _, _, index_temp, edited, _) -> {
            if index_temp == .Val(index_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, index_value)
            sema_effect_walk_stmt_children(walk, nodes, facts, diagnostics, caller, tree, tree.stmts[edited])
        }
        .Break(_, _) | .Continue(_, _) -> {}
    }
}

sema_effect_walk_stmt_list_children: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, statements: [Int]) {
    loop statement in statements -> sema_effect_walk_stmt_children(walk, nodes, facts, diagnostics, caller, tree, tree.stmts[statement])
}

sema_effect_walk_if_cond_children: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, condition: BodyIfCond) {
    if condition == {
        .Plain(value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .And(left, right) -> {
            sema_effect_walk_if_cond_children(walk, nodes, facts, diagnostics, caller, tree, left)
            sema_effect_walk_if_cond_children(walk, nodes, facts, diagnostics, caller, tree, right)
        }
        .IfLet(pattern, subject) -> {
            sema_effect_walk_pattern_children(walk, nodes, facts, diagnostics, caller, tree, pattern.shape)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, subject)
        }
    }
}

// Visit the canonical body_each_pattern_child nodes, including nested
// payloads and map keys, without materializing child lists.
sema_effect_walk_pattern_children: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, shape: BodyPatternShape) {
    if shape == {
        .Or(alternatives, _) -> loop alternative in alternatives -> sema_effect_walk_pattern_children(walk, nodes, facts, diagnostics, caller, tree, alternative)
        .Struct(fields, _) -> loop field in fields {
            if field == {
                .Value(_, value, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
                .Bind(_, _, _) -> {}
                .Nested(_, inner, _) -> sema_effect_walk_pattern_children(walk, nodes, facts, diagnostics, caller, tree, inner.shape)
            }
        }
        .Variant(_, slots, _, _) | .List(slots, _, _) -> loop slot in slots {
            if slot == {
                .Value(value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
                .Nested(inner) -> sema_effect_walk_pattern_children(walk, nodes, facts, diagnostics, caller, tree, inner.shape)
                .Wildcard | .Bind(_, _) | .Range(_, _) -> {}
            }
        }
        .Present(_, _, inner, _) | .Ok(_, _, inner, _) | .Err(_, _, inner, _) -> {
            if inner == .Val(nested) -> sema_effect_walk_pattern_children(walk, nodes, facts, diagnostics, caller, tree, nested.shape)
        }
        .Map(entries, _, _) -> loop entry in entries {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, entry.key)
            if entry.slot == {
                .Value(value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
                .Nested(inner) -> sema_effect_walk_pattern_children(walk, nodes, facts, diagnostics, caller, tree, inner.shape)
                .Wildcard | .Bind(_, _) | .Range(_, _) -> {}
            }
        }
        .Absent(_) | .Range(_, _, _) | .Text(_, _) | .Binary(_, _) -> {}
    }
}

sema_effect_walk_match_arm_children: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, arms: [BodyMatchArm]) {
    loop arm in arms {
        sema_effect_walk_pattern_children(walk, nodes, facts, diagnostics, caller, tree, arm.pattern.shape)
        sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, caller, tree, arm.body)
    }
}

// A checked lambda re-keys the call facts recorded in its body to
// `lambda@<start>` (Lambdas.jet), so a walk that descends into a closure
// executable (`scope.guard`, transaction hooks, spawn, reactive and UI
// callbacks, C callbacks) must look its calls up under that key. Under the
// enclosing function's key every such call has no fact and would read as an
// unknown callee (the maximal row). Rust records these bodies' effects on the
// enclosing function as it checks them. A compiler-private loop carrier keeps
// the enclosing key, so the lambda key applies only when it owns facts.
sema_effect_walk_lambda_children: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, lambda: BodyLambda) {
    // A structure-only walk (FailureLaw) builds its index with no modules; its
    // lambda bodies keep the enclosing caller, as for a lambda that owns no facts.
    lambda_caller: sema_effect_caller_slot(facts, caller.module_index, "lambda@{lambda.source_span.start}")
    body_caller: SemaEffectCaller{module_index: caller.module_index, slot: if lambda_caller.slot >= 0 -> lambda_caller.slot else -> caller.slot}
    if lambda.executable == {
        .Expr(value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, body_caller, tree, value)
        .Block(body) -> sema_effect_walk_stmt_list_children(walk, nodes, facts, diagnostics, body_caller, tree, body)
    }
}

sema_effect_walk_place_children: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, place: BodyPlace) {
    if place == {
        .Expr(value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .Local(_) -> {}
    }
}

sema_effect_walk_require_children: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, requirement: BodyRequireKind) {
    if requirement == {
        .Require(condition, message) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, condition)
            if message == .Val(message_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, message_value)
        }
        .RequireEq(left, right, _) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, left)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, right)
        }
        .Panic(message) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, message)
    }
}

sema_effect_walk_host_call_children: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, call: BodyHostCall) {
    if call == {
        .Method(receiver, _, args) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, receiver)
            loop value in args -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        }
        .CellGuardProject(receiver, _, _, _, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, receiver)
        .OptionProbe(inner, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, inner)
        .TupleIndex(base, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, base)
        .YieldSend(value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, value)
        .ComptimeInput(_, path, _) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, path)
        .SwitchSubjectValue | .NumericBounds(_, _) | .MemoStats(_, _) | .ContextRead(_) -> {}
    }
}

sema_effect_walk_core_closure_children: fn(walk: SemaEffectWalk, nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller: SemaEffectCaller, tree: BodyTree, kind: BodyCoreClosureKind) {
    if kind == {
        .Spawn(group, _, _, executable) -> {
            if group == .Val(group_value) -> sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, group_value)
            sema_effect_walk_lambda_children(walk, nodes, facts, diagnostics, caller, tree, executable)
        }
        .Realtime(rate, frames, executable) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, rate)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, frames)
            sema_effect_walk_lambda_children(walk, nodes, facts, diagnostics, caller, tree, executable)
        }
        .UITextInputOnDrop(state, ime, executable) -> {
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, state)
            sema_effect_walk_visit(walk, nodes, facts, diagnostics, caller, tree, ime)
            sema_effect_walk_lambda_children(walk, nodes, facts, diagnostics, caller, tree, executable)
        }
        .Guard(executable) -> sema_effect_walk_lambda_children(walk, nodes, facts, diagnostics, caller, tree, executable)
        .ReactiveDerived(executable) | .ReactiveEffect(executable) | .UIReactiveRender(executable) | .UIClickSlot(executable) -> sema_effect_walk_lambda_children(walk, nodes, facts, diagnostics, caller, tree, executable)
        .OnCommit(_, executable) | .OnRollback(_, executable) -> sema_effect_walk_lambda_children(walk, nodes, facts, diagnostics, caller, tree, executable)
    }
}
