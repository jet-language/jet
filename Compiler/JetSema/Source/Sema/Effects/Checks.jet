// Effect rows and checked unsafe-boundary facts.
//
// The effect graph is a semantic projection over checked bodies and the call facts already
// recorded by Sema.  It does not resolve names, own a second scope table, or
// infer a new type relation.  Direct rows are collected from checked calls and
// panic sentinels, then one fixed-point solver projects the same solved row back
// onto every FnBody.
//
// Effect names are canonical dotted paths.  The roots are closed; descendants
// below a known root are open declaration leaves.  Panic and Mem are retained
// for denial/reachability facts but are deny-only and never become positive
// grants.
use jet_foundation.[
    EFFECT_VOCABULARY_ROOTS,
    EFFECT_VOCABULARY_ROWS,
    EffectAccess,
    Expr,
    JET_FRAME_ALLOWANCE,
    MARKER_MEMO,
    MARKER_REPEATABLE,
    Marker,
    authority_covers_any,
    authority_expert,
    authority_expert_answer,
    authority_expert_left_out,
    authority_grantable_roots,
    authority_is_deny_only,
    AuthorityVerdict,
    BodyCallArg,
    BodyContract,
    BodyCoreClosureKind,
    BodyFnValueKind,
    BodyHandleOp,
    BodyHostCall,
    BodyIfCond,
    BodyLambda,
    BodyMatchArm,
    BodyNode,
    BodyPatternShape,
    BodyPlace,
    BodyRequireKind,
    BodyTree,
    CallArg,
    CompilerThreads,
    CompilerTraceSink,
    core_identity_is_module,
    DeclID,
    DeclTable,
    decl_table_find,
    decl_table_key,
    Diagnostic,
    EffectRowEntry,
    effect_access_max,
    effect_scope_argument_valid,
    effect_scope_covers,
    effect_scope_descriptor,
    effect_scope_is_scoped,
    effect_scope_name,
    effect_scope_of_argument,
    effect_scope_published_effect,
    effect_scope_split,
    effect_value_base,
    effect_value_is_valued,
    effect_vocabulary_access,
    Expr,
    FnBody,
    Func,
    FunctionDefaultRef,
    InternalTag,
    SharedLifetime,
    Item,
    TagMarker,
    TFailureCarrier,
    JetFrameTypes,
    Name,
    NamedSpan,
    ModuleCap,
    NAME_COLUMN_UNBOUND,
    name_column,
    name_column_get,
    name_column_get_hashed,
    name_column_set,
    name_column_set_first,
    name_column_set_hashed,
    name_column_table,
    name_table_sized,
    name_text_hash,
    name_find,
    name_index,
    name_intern,
    name_pair_find_slot,
    name_pair_slot,
    name_table,
    NameTable,
    SymbolID,
    NodeKind,
    Span,
    Stmt,
    StmtKind,
    TBuiltinOp,
    TClosureOp,
    TEffectFacts,
    TEffectSpan,
    TFuncKind,
    TMethodRef,
    TTypeDef,
    Type,
    compiler_threads_admit,
    compiler_threads_joined,
    compiler_threads_taken,
    compiler_threads_partition,
    compiler_transfer_rows,
    diagnostic_with_label,
    diagnostic_with_rights,
    body_each_if_cond_child,
    body_each_node_kind_child,
    body_each_stmt_child,
    body_node,
    body_node_index,
    Interner,
    TypeKind,
    body_type,
    body_type_id,
    type_id_name,
    type_kind,
    type_syntax,
    diagnostic_with_source_derived_suggestion,
    jet_frame_types,
    jet_frame_value_bytes,
    sema_effect_covers,
    symbol_find,
    symbol_is_local,
    symbol_is_none,
    symbol_key,
    symbol_key_leaf,
    symbol_key_names,
    symbol_key_parts,
    symbol_none,
    symbol_table,
    symbol_table_key,
    type_name,
    TextEdit,
    diagnostic_with_edit,
    diagnostic_with_migration_edit,
    effect_list_entry_removal,
    effect_root_removed,
    effect_row_entry_source,
    ModuleID,
    ModuleTable,
    module_find,
    module_is_core,
    module_is_none,
    module_none,
    module_text,
    foundation_byte_text,
    COMPTIME_SITE_TRAIT,
    TYPE_ID_TRAIT,
    TYPE_REFLECTION_TRAIT,
    comptime_site_constant_key,
    name_count,
    type_carrier_identity,
    type_id_constant_key,
    type_reflection_constant_key,
]

SemaEffectFunctionSource: struct {
    key: String,
    name: String,
    span: Span,
    // The function's name, where trait-bound reports (E0742) point.
    name_span: Span?{None},
    declared_effects: [EffectRowEntry]?,
    is_pure: Bool,
    is_replayable: Bool,
    is_unsafe: Bool,
    unsafe_reason: String?,
    unsafe_span: Span?,
    replayable_span: Span?,
    effect_via: NamedSpan?,
    // The body's `#FX(…)` regions with valid cap lists (E0712).
    fx_regions: [SemaEffectFxRegion]{[SemaEffectFxRegion]{}},
    // Loop statement spans; memory work inside one has no
    // static execution count.
    loop_spans: [Span]{[Span]{}},
    // `assume_deterministic` blocks suspend E3403.
    assume_det_spans: [Span]{[Span]{}},
    // The authored `#Transact` blocks, outermost only: a call in one whose
    // callee declares no row is held to the transaction wall once rows are
    // solved (E0746).
    transact_spans: [Span]{[Span]{}},
    // The first `#Memo` marker of a non-comptime function (E0938).
    memo_span: Span?{None},
    // A top-level `#Kernel(.parallel)` whose declaration obligations hold
    // (sema_kernel_pending): E1102 judges its effect and body obligations.
    kernel: SemaKernelPending?{None},
    // The `#FX(…)` caps of the modules enclosing this function (E0749).
    module_caps: [ModuleCap]{[ModuleCap]{}},
    // The `#FX(…)` cap of the struct or enum this method belongs to (E0749).
    type_cap: SemaEffectModuleCap?{None},
    // The trait this impl method implements, resolved where its `impl`
    // block is written; None for any other function (E0754).
    trait_symbol: SymbolID?{None},
    // Whether this function carries `#Export(c)` (E3203 if it touches
    // changeable module storage globals that are not raw words).
    is_guest_export: Bool{false},
    // The `#Repeatable` marker contract (E0778, E0779).
    repeatable: SemaEffectRepeatableSpec?{None},
    // The `#App.Job` retry contract (E0780).
    job_retry: SemaEffectJobRetrySpec?{None},
}

// A function's `#Repeatable` marker: trusted leaf with `reason`, keyed with
// `key_expr`, or checked against every non-read callee when neither is written.
SemaEffectRepeatableSpec: struct {
    span: Span,
    has_reason: Bool,
    key_expr: Expr?,
}

// An `#App.Job` method's retry contract: default retries=5, at_least_once=false.
SemaEffectJobRetrySpec: struct {
    span: Span,
    retries: Int,
    at_least_once: Bool,
}

// One `#FX(…)` region: its parsed caps, the head span E0712 points at, and
// the block span its `TStmt.Region` lowering keeps. An `#On(.Deep)` body is a
// `deep` region with no caps: it may reach only the effects that never need a
// grant (E0713).
SemaEffectFxRegion: struct {
    caps: [String],
    caps_span: Span,
    span: Span,
    deep: Bool{false},
}

// One checked module's effect inputs. The module's functions and call facts
// are read in place from `modules[module_index]` (sema_effects_check_modules).
SemaEffectModuleInput: struct {
    module_index: Int,
    sources: [SemaEffectFunctionSource],
    source_segments: [SemaSourceSegment],
    // This rule trait-method effect ceilings this module declares (E0742).
    trait_bounds: [SemaEffectTraitBound]{[SemaEffectTraitBound]{}},
    // The (trait, owner) implementations this module declares
    // (sema_effect_trait_implementers), for generic dispatch.
    trait_implementers: [SemaEffectTraitImplementer]{[SemaEffectTraitImplementer]{}},
    // The owned trait each method of an `impl Owner.Add` or `impl
    // Owner.CheckedText` block implements, by function symbol id: the trait
    // has no source row, so the checked body is a plain method (E0742 still
    // bounds it).
    owned_trait_hooks: [U32:String]{[U32:String]{}},
    // The library effect names this module may write (sema_library_effect_view).
    library_effects: [SemaLibraryEffectName]{[SemaLibraryEffectName]{}},
}

SemaEffectDispatchSite: struct {
    dispatch: TEffectSpan,
    module_index: Int,
}

// One bounded trait method: an impl of `trait_name.method` may use only the
// effects in `bound` (`-[]>` is the empty bound).
SemaEffectTraitBound: struct {
    trait_name: String,
    method: String,
    bound: [String],
}

// One `impl Owner.Trait` or struct/enum trait-impl block: `owner` implements
// `trait_name`.
SemaEffectTraitImplementer: struct {
    trait_name: String,
    owner: String,
}

SemaEffectGraphResult: struct {
    diagnostics: [Diagnostic],
    complete: Bool,
    memory_declarations: [SemaMemoryFactDeclaration]{[SemaMemoryFactDeclaration]{}},
    memory_projections: [SemaMemoryProjectionRow]{[SemaMemoryProjectionRow]{}},
    // With `seal`, the Core library's check: each Core function's effect
    // summary a bound program may take for its reach (sema_effect_core_seal_rows).
    core_seal: [SemaCoreSealEffects]{[SemaCoreSealEffects]{}},
    // Whether a check walked the call graph past a body for what its reach
    // does (a memory or stack denial, a kernel, a program function's cap),
    // which a Core stand-in's missing edges would cut short.
    walks: Bool{false},
    // How many of `diagnostics`' errors read no Core body a stand-in leaves
    // out: each e3401 on a `-[]>` function outside Core, which reads that
    // function's own body and the solved rows of what it calls.
    exact_errors: Int{0},
    // Each type an instance of a `T.reflect()` read fills `T` with, once
    // (sema_effect_type_reflections).
    type_reflections: [SemaTypeReflection]{[SemaTypeReflection]{}},
    // The run's symbol table the check borrowed, handed back to its graph.
    symbols: SymbolTable,
    interner: Interner,
}

// One memory operation a body performs directly: `kind` is "alloc", "rc" or
// "arena"; an arena event's `bytes` is its proven upper bound (None is
// unprovable); `executions` is None inside a loop.
SemaMemoryEvent: struct {
    span: Span,
    operation: String,
    kind: String{"alloc"},
    bytes: Int?{None},
    executions: Int?{Val(1)},
}

// A call site to a user function, for arena multiplicity. `target` is the
// callee's node once the graph's edges are final (sema_effect_resolve_edges).
SemaMemoryCall: struct {
    callee: String,
    span: Span,
    executions: Int?,
    target: Int{-1},
}

// A place a strict memory fact cannot see through.
SemaMemoryOpen: struct {
    span: Span,
    source: String,
    reason: String,
}

// The first violation on a path: an event (in node `owner`) or an open
// dispatch, and the arena bytes used up to it. Its path is the nodes from
// its root to `owner` (`steps`), by display key (`path`).
SemaMemoryFinding: struct {
    event: SemaMemoryEvent?,
    owner: Int,
    open: SemaMemoryOpen?,
    path: [String],
    used: Int,
    steps: [Int],
}

// An arena proof, or the finding that stops the proof.
SemaMemoryArena: struct {
    bytes: Int,
    witness: SemaMemoryFinding?,
    failure: SemaMemoryFinding?,
}

sema_effect_is_fixed_list: fn(ty: Type) -> Bool Never! {
    if ty == {
        .FixedList(_, _) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_effect_source_display: fn(path: String) -> String Never! {
    parts: path.split("/").to_list()
    if parts.len() == 0 -> path else -> parts[parts.len() - 1]
}

// A named function value in a slot with a closed effect row: the value took
// the slot's row (sema_function_value_type), so `callee`'s own row is held
// to `bound` and kept clear of `denied` once every row is solved (E0747 at
// `span`).
SemaEffectCallbackBound: struct {
    callee: String,
    row: SemaEffectCallbackRow,
    span: Span,
}

// A closed callback row: the effects it allows and the ones it denies
// (`fn(Int) -[IO, !Panic]> Int` allows IO and denies Panic).
SemaEffectCallbackRow: struct {
    bound: [String],
    denied: [String],
}

// A lambda in a slot with a closed effect row: the lambda's own row, its call
// facts and what its body walk charges, held to the slot's row once every row
// is solved (E0747 at `span`).
SemaEffectLambdaBound: struct {
    direct: [String],
    call_edges: [String],
    maximal: Bool,
    row: SemaEffectCallbackRow,
    span: Span,
}

// A lambda handed the root's `Compiler` value: one that takes it, or the
// `CompilerEvent` it hears (`taken`, the type's name), as a `meta.events`
// handler does. Its own row is held to launch no process once every row is
// solved (E3410 at `span`, sema_effect_check_compiler_hooks).
SemaEffectHookLambda: struct {
    direct: [String],
    call_edges: [String],
    maximal: Bool,
    taken: String,
    span: Span,
}

// A call through a type parameter's trait bound (`self.inner.work()` with
// `inner: T`, `T: Worker`). Which implementation runs is fixed where the
// instantiation is written, so the call's effects belong to the caller that
// binds `param`, not to this function's own row.
SemaEffectParamDispatch: struct {
    param: String,
    // The called method's row in the trait implementations
    // (sema_effect_method_row), -1 when no type implements it.
    method_row: Int,
}

// A call into a generic function or a generic type's method, with the type
// arguments it binds: the owner type's, then the function's own.
// `callee_node` is the callee's node once the graph's edges are final
// (sema_effect_resolve_edges). `guards` are those of the arms the call is
// written in (SemaEffectGuard).
SemaEffectInstantiation: struct {
    callee: String,
    owner_args: [Type],
    type_args: [Type],
    // `Traced<Loud>` or `apply<Loud>`: the instantiation a report names.
    label: String,
    span: Span,
    callee_node: Int{-1},
    guards: [SemaEffectGuard]{[SemaEffectGuard]{}},
}

// An arm of an `if` whose condition is the value compile-time site `site`
// of a generic body takes (a TraitConst of COMPTIME_SITE_TRAIT over
// `owner`): what the arm reads or calls happens only at the instances where
// that value is `holds`, the then arm's true and the else arm's false.
SemaEffectGuard: struct {
    owner: Type,
    site: String,
    holds: Bool,
}

// A read a generic body makes that each instance answers on its own: a
// `T.reflect()` read, or a `TypeId{T}` read (`type_id`), where `owner` names
// the type parameter it reads, or the value of a compile-time site (`site`,
// its key), where `owner` applies COMPTIME_SITE_TRAIT to the type
// parameters the site reads. `span` is the read, and `guards` are those of
// the arms it is written in (SemaEffectGuard).
SemaEffectTypeRead: struct {
    owner: Type,
    span: Span,
    site: String{""},
    type_id: Bool{false},
    guards: [SemaEffectGuard]{[SemaEffectGuard]{}},
}

// A condition one instance of a read holds under: the site value whose
// constant row is `key` (comptime_site_constant_key) is `holds`.
SemaTypeReflectionGuard: struct {
    key: String,
    holds: Bool,
}

// One instance of a read (SemaEffectTypeRead): `ty` the read's owner there,
// the module of the non-generic function whose calls build that instance,
// which names its types, the read and its module, the constant row `key` it
// reads (sema_effect_type_reflections), the site a site's read names,
// whether it reads a TypeId, the type parameters the read's owner names,
// which `ty` fills in order, and the site values the instance is read under
// (`guards`): every arm it sits in, in its body and in each call that leads
// to it.
SemaTypeReflection: struct {
    ty: Type,
    module_identity: ModuleID,
    span: Span,
    read_module_identity: ModuleID,
    key: String,
    site: String{""},
    type_id: Bool{false},
    params: [String]{[String]{}},
    guards: [SemaTypeReflectionGuard]{[SemaTypeReflectionGuard]{}},
}

// One instance the reflection walk visits: node `node` at type arguments
// `args` (by its `type_params`), reached from non-generic node `origin`
// under the site values `guards`.
SemaEffectReflectionInstance: struct {
    node: Int,
    args: [Type],
    origin: Int,
    guards: [SemaTypeReflectionGuard]{[SemaTypeReflectionGuard]{}},
}

// A call site that binds callee parameter vertex `to` to a larger type
// holding caller parameter vertex `from`: instantiation `site` of `node`.
SemaEffectExpandingSite: struct {
    from: Int,
    to: Int,
    node: Int,
    site: Int,
}

// An implementation a caller runs through an instantiation it writes, and
// its node once the graph's edges are final (sema_effect_resolve_edges).
SemaEffectInstanceReach: struct {
    label: String,
    target: String,
    span: Span,
    target_node: Int{-1},
}

// An instance reach with its target's solved row, for reports.
SemaEffectInstanceNote: struct {
    label: String,
    callee: String,
    row: [String],
    span: Span,
}

SemaEffectNode: struct {
    key: String,
    name: String,
    module_identity: ModuleID,
    module_index: Int,
    span: Span,
    name_span: Span,
    direct: [String],
    direct_spans: [TEffectSpan],
    call_edges: [String],
    maximal: Bool,
    maximal_span: Span?,
    declared: [String],
    prohibited: [String],
    has_declared_row: Bool,
    is_pure: Bool,
    is_replayable: Bool,
    replayable_span: Span?,
    is_unsafe: Bool,
    unsafe_reason: String?,
    unsafe_span: Span?,
    effect_via: NamedSpan?,
    // Calls through a trait value with no bound: the trait method declares
    // no row, the trait has no `#FX(…)` ceiling, and the program's
    // implementations can't be summed. A ceiling above them is E0743.
    dispatches: [TEffectSpan],
    // The node each `call_edges` entry names, by position, or -1 for an edge
    // with no node; `rare.value_targets` does the same for `rare.value_edges`.
    // Filled once the graph's edges are final (sema_effect_resolve_edges); the
    // graph's walks follow these.
    call_targets: [Int]{[Int]{}},
    // Whether this body calls through a function value, whose context reads
    // no edge shows (sema_effect_context_reach).
    context_open: Bool{false},
    // The memory operations this body performs directly.
    memory_events: [SemaMemoryEvent]{[SemaMemoryEvent]{}},
    // User-function call sites and loop spans for arena multiplicity.
    memory_calls: [SemaMemoryCall]{[SemaMemoryCall]{}},
    // The `memory_calls` rows by callee node and span start
    // (sema_effect_memory_call_key), so a call site found again is one
    // lookup, not a scan of the body's calls.
    memory_call_rows: [Int:Bool]{[Int:Bool]{}},
    loop_spans: [Span]{[Span]{}},
    // This pure body made a non-deterministic Core call (E3403 reported).
    nondeterministic_call: Bool{false},
    memo_span: Span?{None},
    kernel: SemaKernelPending?{None},
    // `module.name` in call paths and the source file name in reports.
    display_key: String{""},
    // Whether this is core.web's JET_APP_PORT or JET_DEV read, the platform
    // port's env reads the driver leaves out: the function that fills the
    // AppPortEnv or AppDevEnv role (sema_effect_platform_env_read).
    platform_env: Bool{false},
    source_display: String{""},
    // The name a denial's call chain shows for this function: `name`, or
    // `Owner.name` for a method (its effect key, dotted).
    chain_name: String{""},
    // The first `#Unsafe` gate this body opens itself outside Core, as
    // `file:line` (sema_effect_record_unsafe_gate); "" when it opens none.
    unsafe_site: String{""},
    // The first entry of the declared effect row (E0740's span) and its first
    // `!` prohibition (E0749's span).
    row_span: Span?{None},
    prohibition_span: Span?{None},
    // The `#FX(…)` cap of the struct or enum this method belongs to.
    type_cap: SemaEffectModuleCap?{None},
    // The trait this method implements, None for any other function.
    trait_symbol: SymbolID?{None},
    // This function's type parameters, its owner type's first, and the
    // owner type's parameters in the order its type arguments bind them.
    type_params: [String]{[String]{}},
    owner_params: [String]{[String]{}},
    // Calls that bind type parameters.
    instantiations: [SemaEffectInstantiation]{[SemaEffectInstantiation]{}},
    // Whether the first parameter is `path`, as a Core scope publisher's is.
    path_first: Bool{false},
    // Whether this function carries `#Export(c)`.
    is_guest_export: Bool{false},
    // The rows few bodies fill, boxed apart: None until one of them gains an
    // entry (sema_effect_node_rare_open), so a node that fills none holds
    // one empty word in their place.
    rare: SemaEffectNodeRare?{None},
}

// The rows of a graph node that few bodies fill (SemaEffectNode.rare).
SemaEffectNodeRare: struct {
    // The functions this body takes as values (TEffectFacts.value_edges),
    // and the node each names, by position, or -1 for an edge with no node.
    value_edges: [String]{[String]{}},
    value_targets: [Int]{[Int]{}},
    // The module state this body writes (TEffectFacts.module_writes).
    module_writes: [TEffectSpan]{[TEffectSpan]{}},
    // The changeable module state this body reads (TEffectFacts.module_reads).
    module_reads: [TEffectSpan]{[TEffectSpan]{}},
    // The comptime inputs this body makes (`embed_file`, `embed_bytes`,
    // `find`, `net.fetch`), by name and call span: the compiler answers them
    // while compiling only (sema_effect_runtime_input_paths).
    comptime_inputs: [TEffectSpan]{[TEffectSpan]{}},
    // The task context fields this body reads (`context.<field>`) and the
    // context keys it reads (`context.get(key)`) (sema_effect_context_reach).
    context_reads: [String]{[String]{}},
    context_keys: [TEffectContextKey]{[TEffectContextKey]{}},
    // The `-[!Mem.*]>` denials its signature declares (E0921).
    memory_denials: [EffectRowEntry]{[EffectRowEntry]{}},
    memory_opens: [SemaMemoryOpen]{[SemaMemoryOpen]{}},
    assume_det_spans: [Span]{[Span]{}},
    // The `#FX(…)` caps of the inline modules enclosing this function.
    module_caps: [ModuleCap]{[ModuleCap]{}},
    // The bounded callback slots this body fills with named functions and
    // with lambdas.
    callback_bounds: [SemaEffectCallbackBound]{[SemaEffectCallbackBound]{}},
    lambda_bounds: [SemaEffectLambdaBound]{[SemaEffectLambdaBound]{}},
    // The lambdas this body hands the root's `Compiler` value to (a
    // `meta.events` handler), held to launch no process.
    hook_lambdas: [SemaEffectHookLambda]{[SemaEffectHookLambda]{}},
    // Calls through a type parameter; once sema_effect_resolve_type_params
    // has run, also those a call forwards from a callee's parameters.
    param_dispatches: [SemaEffectParamDispatch]{[SemaEffectParamDispatch]{}},
    // What calls that bind type parameters reach through them.
    instance_reaches: [SemaEffectInstanceReach]{[SemaEffectInstanceReach]{}},
    // The library effects its declared row names, each with the kernel
    // effects it lists (E0756), and those its row denies (E0749).
    library_rows: [SemaLibraryEffectName]{[SemaLibraryEffectName]{}},
    library_denials: [SemaLibraryEffectDenial]{[SemaLibraryEffectDenial]{}},
    // The Prelude effects its declared row names itself, without the kernel
    // effects its library rows add to `declared` (E0759).
    written_declared: [String]{[String]{}},
    // Calls to a Core scope publisher with a constant argument
    // (effect_scope_published_effect): the callee's bare effect reaches this
    // body as the scoped one. A publisher it also calls with a run-time
    // argument is in `bare_scope_callees`, and reaches it bare as well.
    scoped_calls: [SemaEffectScopedCall]{[SemaEffectScopedCall]{}},
    bare_scope_callees: [String]{[String]{}},
    // The reads each instance answers that this body makes over its type
    // parameters (sema_effect_type_reflections).
    type_reads: [SemaEffectTypeRead]{[SemaEffectTypeRead]{}},
    // While the walk collects this body: the guards of the arms of
    // compile-time site conditions it is in, outermost first
    // (sema_effect_guard_open).
    guards: [SemaEffectGuard]{[SemaEffectGuard]{}},
    // The `#Repeatable` marker contract and `#App.Job` retry contract.
    repeatable: SemaEffectRepeatableSpec?{None},
    job_retry: SemaEffectJobRetrySpec?{None},
}

// The rare rows of a node that fills none of them.
SEMA_EFFECT_NODE_NO_RARE: SemaEffectNodeRare{}

// The guards of the arms the walk collecting `node` is in.
sema_effect_open_guards: fn(node: SemaEffectNode) -> [SemaEffectGuard] Never! {
    rare: node.rare ?? return [SemaEffectGuard]{}
    rare.guards
}

// Opens `node`'s rare rows (SemaEffectNode.rare) for a write.
sema_effect_node_rare_open: fn(node: ^SemaEffectNode) Never! {
    if node.rare == None -> node.rare = Val(SemaEffectNodeRare{})
}

// How many value edges `node` has (SemaEffectNodeRare.value_targets).
sema_effect_node_value_count: fn(node: SemaEffectNode) -> Int Never! {
    rare: node.rare ?? return 0
    rare.value_targets.len()
}

// The node value edge `at` of `node` names, or -1 for an edge with no node.
sema_effect_node_value_target: fn(node: SemaEffectNode, at: Int) -> Int Never! {
    rare: node.rare ?? return -1
    rare.value_targets[at]
}

SemaEffectScopedCall: struct {
    callee: String,
    published: String,
    scoped: String,
}

// The effect facts a function's body gives its effect source: its `#FX(…)`
// regions, loop spans, `assume_deterministic` spans and `#Transact` spans, and
// for a top-level function its pending kernel (sema_kernel_pending).
SemaEffectBodyFacts: struct {
    fx_regions: [SemaEffectFxRegion]{[SemaEffectFxRegion]{}},
    loop_spans: [Span]{[Span]{}},
    assume_det_spans: [Span]{[Span]{}},
    transact_spans: [Span]{[Span]{}},
    kernel: SemaKernelPending?{None},
}

// The body facts of a function whose body is `body`, its kernel left out.
// A registration row's declaration may hold no body
// (sema_registration_function_body reads it from its item).
sema_effect_body_facts: fn(body: [Stmt]) -> SemaEffectBodyFacts Never! {
    ^facts: SemaEffectBodyFacts{fx_regions: sema_authority_fx_regions(body)}
    sema_effect_collect_statement_spans(body, facts)
    facts
}

// The effect source of `func`, keyed `key`, its body facts `facts`: what its
// header gives it, with no walk of its body.
sema_effect_source_from_header: fn(func: Func, key: String, facts: ^^SemaEffectBodyFacts) -> SemaEffectFunctionSource Never! {
    ^owned: facts.move()
    SemaEffectFunctionSource{
        key: key,
        name: func.name,
        span: func.span,
        name_span: Val(func.name_span),
        declared_effects: func.declared_effects,
        is_pure: func.is_pure,
        is_replayable: func.is_replayable,
        is_unsafe: func.is_unsafe,
        unsafe_reason: func.unsafe_reason,
        unsafe_span: func.unsafe_span,
        replayable_span: func.replayable_span,
        effect_via: func.effect_via,
        fx_regions: owned.fx_regions.move(),
        loop_spans: owned.loop_spans.move(),
        assume_det_spans: owned.assume_det_spans.move(),
        transact_spans: owned.transact_spans.move(),
        memo_span: sema_effect_memo_span(func),
        kernel: owned.kernel.move(),
        module_caps: func.module_caps,
        is_guest_export: sema_function_is_guest_export(func),
        repeatable: sema_effect_repeatable_spec(func),
    }
}

// Extracts the first `#Repeatable` marker contract from `func.markers`.
sema_effect_repeatable_spec: fn(func: Func) -> SemaEffectRepeatableSpec? Never! {
    loop marker in func.markers {
        if marker.negated || marker.name != MARKER_REPEATABLE -> next
        ^has_reason: false
        ^key_expr: Expr?{None}
        loop (index, argument) in marker.args {
            if argument == .Expr(value) {
                ^label: ""
                if index < marker.arg_labels.len() {
                    if marker.arg_labels[index] == .Val(named) -> label = named.name
                }
                if {
                    label == "key" -> key_expr = Val(value)
                    label == "reason" -> has_reason = true
                    label == "" && index == 0 -> has_reason = true
                    label == "" && index == 1 -> key_expr = Val(value)
                    else -> {}
                }
            }
        }
        return Val(SemaEffectRepeatableSpec{span: marker.span, has_reason: has_reason, key_expr: key_expr})
    }
    None
}

// Extracts `#App.Job(retries: ..., at_least_once: ...)` from `func.markers`
// when resolved against `graph` in `module_identity`.
sema_effect_app_job_retry_spec: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, func: Func) -> SemaEffectJobRetrySpec? Never! {
    loop marker in func.markers {
        if !sema_app_marker_is(marker, SEMA_APP_JOB_MARKER, graph, module_identity) -> next
        ^retries: SEMA_APP_JOB_RETRIES
        ^at_least_once: false
        if sema_app_marker_arg_at(marker, "retries", 0) == .Val(at) {
            if marker.args[at] == .Expr(value) {
                if value == .Int(count, _, _, _, _) -> retries = count
            }
        }
        if sema_app_marker_arg_at(marker, "at_least_once", 1) == .Val(at) {
            if marker.args[at] == .Expr(value) {
                if value == .Bool(flag, _, _) -> at_least_once = flag
            }
        }
        return Val(SemaEffectJobRetrySpec{span: marker.span, retries: retries, at_least_once: at_least_once})
    }
    None
}

// A comptime callable takes the purity path, so only an ordinary function's
// first `#Memo` marker is judged by E0938.
sema_effect_memo_span: fn(func: Func) -> Span? Never! {
    if func.is_comptime -> return None
    loop marker in func.markers {
        if marker.name == MARKER_MEMO -> return Val(marker.span)
    }
    None
}

// The subject an E0938 report names: a function by its name, and a `#Memo`
// computed field's helper (Derives.jet sema_computed_field_memo_helper) by its
// field, as the helper is that field's formula.
sema_effect_memo_subject: fn(name: String) -> String Never! {
    parts: name.split("__computed_").to_list()
    if parts.len() == 2 && parts[1].ends_with("__memo") {
        return "the formula of field `{parts[1].slice(0, parts[1].len() - 6)}`"
    }
    "`{name}`"
}

// Gathers into `facts` the spans of the loops, the `assume_deterministic`
// blocks and the authored `#Transact` blocks of `statements`. A `#Transact`
// block inside another is left out: its calls are the outer block's.
sema_effect_collect_statement_spans: fn(statements: [Stmt], facts: ^SemaEffectBodyFacts) {
    loop statement in statements {
        if statement == {
            .While(_, body, span, _, _) | .For(_, _, _, _, body, span, _, _, _) | .Loop(body, span, _, _) | .CountedLoop(_, _, _, body, span, _, _) -> {
                facts.loop_spans.push(span.copy())
                sema_effect_collect_statement_spans(body, facts)
            }
            .AssumeDet(_, _, body, span) -> {
                facts.assume_det_spans.push(span.copy())
                sema_effect_collect_statement_spans(body, facts)
            }
            .Transact(_, _, body, implicit, span) -> {
                nested: if facts.transact_spans.last() == .Val(outer) -> sema_effect_span_contains(outer, span) else -> false
                if !implicit && !nested -> facts.transact_spans.push(span.copy())
                sema_effect_collect_statement_spans(body, facts)
            }
            .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Defer(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ContextBlock(_, body, _) | .Live(body, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> {
                sema_effect_collect_statement_spans(body, facts)
            }
            .Switch(_, arms, else_body, _) -> {
                loop arm in arms -> sema_effect_collect_statement_spans(arm.body, facts)
                if else_body == .Val(body) -> sema_effect_collect_statement_spans(body, facts)
            }
            .ComptimeIf(_, _, then_body, else_body, _, _) -> {
                sema_effect_collect_statement_spans(then_body, facts)
                if else_body == .Val(body) -> sema_effect_collect_statement_spans(body, facts)
            }
            .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .Yield(_, _) | .DeferClose(_, _) -> {}
        }
    }
}

// E2-M16: a non-deterministic Core call (a `Time` or `Rand` row) inside a pure
// function, outside `assume_deterministic`. The call is a fixed Core row or a
// source-owned Core function. The module identity of a direct call's callee
// body, or the none id when the call has no body node in this program.
sema_effect_callee_module: fn(facts: SemaEffectCallIndex, expression: BodyNode) -> ModuleID Never! {
    if expression.kind == .Call(callee, _, _) {
        decl_row: callee.row.index()
        target: if decl_row >= 0 && decl_row < facts.node_by_decl.len() -> facts.node_by_decl[decl_row] else -> -1
        if target >= 0 && target < facts.node_modules.len() -> return facts.node_modules[target]
    }
    module_none()
}

sema_effect_nondeterministic_core: fn(node: SemaEffectNode, expression: BodyNode, fact: SemaCallSiteFact, callee_module: ModuleID, tree: BodyTree, symbols: SymbolTable) -> String? {
    if !node.is_pure -> return None
    ^api: ""
    if expression.kind == .Call(_, _, _) {
        // A source-owned Core function, or a Core function with no body in
        // this program; any other callee reports through its own effects.
        if !module_is_none(callee_module) && !module_is_core(callee_module) -> return None
        callee: fact.callee ?? return None
        api = sema_effect_decl_label(symbol_key(symbols, tree.symbols, callee))
    }
    if api == "" -> return None
    row: fact.facts.effect_bound ?? return None
    if sema_effect_in_assume_det(node, expression.span) -> return None
    loop entry in row {
        if entry.name.starts_with("!") -> next
        root: sema_effect_root(entry.name)
        if root == "Time" || root == "Rand" -> return Val(api)
    }
    None
}

// Inside a pure body the block suspends the determinism rejections, E3403 and
// E3401 alike.
sema_effect_in_assume_det: fn(node: SemaEffectNode, span: Span) -> Bool Never! {
    if !node.is_pure -> return false
    rare: node.rare ?? return false
    loop region in rare.assume_det_spans {
        if sema_effect_span_contains(region, span) -> return true
    }
    false
}

// E3403 at a Clock intrinsic site (the static time effect and the
// `Clock.{method}` check, `Clock comparison`, `Clock formatting` and
// `Clock copy`) or an `ExpiringSecret.with` expiry read: the producer recorded
// a `Time` row under the operation's own name (`Clock.system`), so a pure body
// reports E3403 with the pure denial and records none of the site's effects.
// False when the site is not one.
sema_effect_report_nondeterministic_intrinsic: fn(nodes: ^[SemaEffectNode], node_index: Int, fact: SemaCallSiteFact, span: Span, diagnostics: ^[Diagnostic]) -> Bool Never! {
    if !nodes[node_index].is_pure || fact.callee != None -> return false
    detail: fact.detail ?? return false
    api: detail.intrinsic_api ?? return false
    if !api.starts_with("Clock.") && !api.starts_with("Clock ") && api != "ExpiringSecret.with" {
        return false
    }
    row: fact.facts.effect_bound ?? return false
    if sema_effect_in_assume_det(nodes[node_index], span) -> return false
    loop entry in row {
        if entry.name.starts_with("!") || sema_effect_root(entry.name) != "Time" -> next
        nodes[node_index].nondeterministic_call = true
        // A wrapper node at the site's own span reports once.
        loop previous in diagnostics {
            if previous.code == "E3403" && previous.span == span -> return true
        }
        diagnostic: sema_error("E3403", span, "`{api}` is non-deterministic and cannot appear in a pure evaluation.", "Pure evaluation must produce the same result on every machine.", "remove this call, or remove the enclosing function's explicit empty effect bound.")
        diagnostics.push(diagnostic_with_rights(diagnostic, "pure", [String]{api.copy()}, [String]{}, None))
        return true
    }
    false
}

sema_clock_handle_receiver_name: fn(ty: Type) -> String Never! {
    if ty == {
        .Named(name) -> if sema_call_is_clock_type(ty) -> "Clock" else -> "{name}"
        .Tagged(_, inner) -> sema_clock_handle_receiver_name(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ""
    }
}

sema_effect_record_clock_intrinsic: fn(result: Type, effect_name: String, api: String, span: Span, check: ^SemaBodyCheck) -> Bool Never! {
    ^effects: [EffectRowEntry]{}
    if effect_name != "" -> effects.push(EffectRowEntry{name: effect_name, span: span})
    ^facts: SemaCallFacts{
        return_type: result,
        failure_carrier: TFailureCarrier.Infallible,
        effect_bound: Val(effects),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(check.environment.*, check.program.*, check.scopes, check.context, api, span, facts, check.diagnostics)
}

sema_clock_is_deterministic: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(marker, inner) -> marker == TagMarker.Internal{internal_tag: InternalTag.DeterministicClock} && sema_clock_handle_receiver_name(inner) == "Clock"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_clock_is_system: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(marker, inner) -> marker == TagMarker.Internal{internal_tag: InternalTag.SystemClock} && sema_clock_handle_receiver_name(inner) == "Clock"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// A pure function's Clock parameter is injected by its caller, so the body reads it
// as a deterministic clock. None when `ty` is not an untagged Clock.
sema_clock_injected: fn(ty: Type) -> Type? Never! {
    if !sema_call_is_clock_type(ty) || sema_clock_is_deterministic(ty) -> return None
    if ty == .Named(name) {
        return Val(Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.DeterministicClock}, inner: Type.Named{name: "{name}"}})
    }
    None
}

// Records a Clock read's `Clock.{method}` site: `Time` unless the receiver is
// the deterministic or system clock. None when `method` reads no time; false
// when the transaction wall refused the site (its diagnostic is the report).
sema_clock_record_read: fn(receiver_value: TExpr, method: String, args: [CallArg], span: Span, check: ^SemaBodyCheck) -> Bool? Never! {
    result: if {
        method == "now" && args.len() == 0 -> Val(Type.Int)
        (method == "tick" || method == "advance") && args.len() == 1 -> Val(Type.Int)
        method == "wait" && args.len() == 1 -> Val(Type.Int)
        else -> None
    }
    if result == None -> return None
    effect_name: if sema_clock_is_deterministic(receiver_value.ty) || sema_clock_is_system(receiver_value.ty) -> "" else -> "Time"
    Val(sema_effect_record_clock_intrinsic(result, effect_name, "Clock.{method}", span, check))
}

sema_clock_retag: fn(value: ^^TExpr, tagged: Type, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    ^retagged: value.move()
    if retagged.ty == .Result(_, err) {
        tree_expr_retype(retagged, Type.Result{ok: tagged, err: err})
        return Val(retagged)
    }
    tree_expr_retype(retagged, tagged)
    sema_expr_expected(retagged, expected, check.environment.*, check.program.*, check.diagnostics)
}

sema_call_try_clock_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if sema_clock_handle_receiver_name(receiver_value.ty) != "Clock" {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    recorded: sema_clock_record_read(receiver_value, method, args, span, check) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if !recorded -> return SemaMethodSpecialCheck{handled: true, value: None}
    ^value: sema_call_check_method(check, receiver, method, span, [Type]{}, [Type]{}, args, span, expected)
    SemaMethodSpecialCheck{handled: true, value: value}
}

// A compile-time value's call site `fact` whose callee reads ambient time or
// randomness is refused by the API it calls (E3403), before evaluation
// reaches the host clock or random source. An intrinsic (`time.now`) has no
// declared callee and is named by its API.
sema_effect_comptime_nondeterministic: fn(fact: SemaCallSiteFact, program: SemaProgramTables, context: SemaCheckContext, diagnostics: ^[Diagnostic]) {
    detail: sema_call_site_detail(fact)
    api: if fact.callee == .Val(callee) -> sema_effect_decl_label(sema_symbol_key(program, context, callee)) else -> detail.intrinsic_api ?? return
    row: fact.facts.effect_bound ?? return
    loop entry in row {
        if entry.name.starts_with("!") -> next
        root: sema_effect_root(entry.name)
        if root == "Time" || root == "Rand" {
            diagnostic: sema_error("E3403", fact.span, "`{api}` is non-deterministic and cannot appear in a pure evaluation.", "Pure evaluation must produce the same result on every machine.", "remove this call, or keep it at runtime outside the `#run` value.")
            diagnostics.push(diagnostic_with_rights(diagnostic, "pure", [String]{api}, [String]{}, None))
            return
        }
    }
}

// A compile-time value's call into `core.net` that reaches the network: only
// the pinned `net.fetch(url, sha256:)` is a compile-time network operation,
// so any other callee whose effect row carries `Net` is refused (E3412). A
// pure `core.net` helper (`mime.extension`) has no `Net` and evaluates. True
// when it was refused.
sema_effect_comptime_net_unavailable: fn(fact: SemaCallSiteFact, program: SemaProgramTables, context: SemaCheckContext, diagnostics: ^[Diagnostic]) -> Bool {
    callee: fact.callee ?? return false
    callee_key: sema_symbol_key(program, context, callee)
    owner: sema_effect_core_member_module(callee_key) ?? return false
    if owner != "<corelib>/core.net" && !owner.starts_with("<corelib>/core.net.") -> return false
    method: symbol_key_leaf(callee_key)
    if method == "fetch" -> return false
    row: fact.facts.effect_bound ?? return false
    ^reaches_net: false
    loop entry in row {
        if !entry.name.starts_with("!") && sema_effect_root(entry.name) == "Net" {
            reaches_net = true
            break
        }
    }
    if !reaches_net -> return false
    diagnostics.push(sema_error("E3412", fact.span, "`core.net.{method}()` is not available at comptime.", "Only `core.net.fetch(url, sha256:)` is supported at compile time as a Tier-1 hermetic effect.", "Use `core.net.fetch(url, sha256: \"…\")` for content-hash-pinned downloads."))
    true
}

// The call a compile-time value's refused host effect is named by (E3410,
// E3411): the first of its call sites `facts` whose callee's effect row
// carries an effect (sema_effect_comptime_callee_name); None when no call
// carries one.
sema_effect_comptime_call_name: fn(facts: [SemaCallSiteFact], program: SemaProgramTables, context: SemaCheckContext) -> String? Never! {
    loop fact in facts {
        callee: fact.callee ?? next
        row: fact.facts.effect_bound ?? next
        loop entry in row {
            if entry.name.starts_with("!") -> next
            return Val(sema_effect_comptime_callee_name(sema_symbol_key(program, context, callee)))
        }
    }
    None
}

// How compile-time reports name the callee `key`: a Core function by its whole
// path (`core.files.read()`), any other callee by its bare name.
sema_effect_comptime_callee_name: fn(key: String) -> String Never! {
    leaf: symbol_key_leaf(key)
    owner: sema_effect_core_member_module(key) ?? return "{leaf}()"
    "{owner.slice(10..<owner.len())}.{leaf}()"
}

// One execution, or None inside a loop.
sema_effect_memory_executions: fn(node: SemaEffectNode, span: Span) -> Int? {
    loop loop_span in node.loop_spans {
        if sema_effect_span_contains(loop_span, span) -> return None
    }
    Val(1)
}

// The key of a `memory_calls` row: one call site, a callee's node `callee`
// called at the span starting at `span.start`, is one row.
sema_effect_memory_call_key: fn(callee: Int, span: Span) -> Int Never! {
    (callee << 32) | span.start
}

sema_effect_push_memory_event: fn(nodes: ^[SemaEffectNode], node_index: Int, span: Span, operation: String, kind: String, bytes: Int?) {
    executions: sema_effect_memory_executions(nodes[node_index], span)
    nodes[node_index].memory_events.push(SemaMemoryEvent{span: span, operation: operation, kind: kind, bytes: bytes, executions: executions})
}

// The effect source of `func`, keyed `key`, with its body walked for its
// body facts, its kernel left out.
sema_effect_source_from_function_key: fn(func: Func, key: String) -> SemaEffectFunctionSource Never! {
    ^facts: sema_effect_body_facts(func.body)
    sema_effect_source_from_header(func, key, facts)
}

// ────────────────────────────────────────────────────────────────────────────
// Canonical effect vocabulary and set operations

// The vocabulary is Prelude/Effects.jet, read through Foundation's
// EFFECT_VOCABULARY_ROOTS and `authority_grantable_roots`.

// The name up to its first `(` or `.`: the family of a member (`FS.Read`)
// or of a bounded effect (`Mem.Alloc(above: 1)`), read from the bytes once
// (an ASCII cut of UTF-8 text is UTF-8).
sema_effect_root: fn(name: String) -> String Never! {
    bytes: name.bytes()
    ^end: bytes.len()
    loop (index, byte) in bytes {
        if byte == (U8{40}) || byte == (U8{46}) {
            end = index
            break
        }
    }
    foundation_byte_text(bytes, 0, end)
}

// A root's place in Prelude/Effects.jet: the canonical order of a row.
sema_effect_rank: fn(name: String) -> Int Never! {
    root: sema_effect_root(name)
    loop (index, known) in EFFECT_VOCABULARY_ROOTS {
        if known == root -> return index
    }
    100
}

sema_effect_set_contains: fn(set: [String], value: String) -> Bool Never! {
    loop item in set {
        if item == value -> return true
    }
    false
}

sema_effect_set_add: fn(set: ^[String], value: String) -> Bool Never! {
    if sema_effect_set_contains(set, value) -> return false
    set.push(value.copy())
    ^index: set.len() - 1
    // The row at `index` is the pushed value at every step of the walk.
    right: sema_effect_rank(value)
    loop index > 0 {
        left: sema_effect_rank(set[index - 1])
        if left < right || (left == right && set[index - 1] <= set[index]) -> break
        ^swap: set[index - 1]
        set[index - 1] = set[index]
        set[index] = swap
        index -= 1
    }
    true
}

// One value of a set being ordered, with its root's rank.
SemaEffectRanked: struct {
    rank: Int,
    name: String,
}

// The set sema_effect_set_add builds from `values` added in any order: each
// value once, by its root's rank, then by name. Ranks each value once and
// sorts once, where adding one at a time scans and re-ranks the set per
// value.
sema_effect_set_of: fn(values: [String]) -> [String] Never! {
    ^ranked: loop value in values -> SemaEffectRanked{rank: sema_effect_rank(value), name: value}
    ranked.sort_by(fn(left: SemaEffectRanked, right: SemaEffectRanked) { (left.rank <=> right.rank).then(left.name <=> right.name) })
    ^set: [String]{}
    loop entry in ranked {
        if set.len() > 0 && set[set.len() - 1] == entry.name -> next
        set.push(entry.name)
    }
    set
}

sema_effect_set_union: fn(target: ^[String], values: [String]) -> Bool Never! {
    ^changed: false
    loop value in values {
        if sema_effect_set_add(target, value) -> changed = true
    }
    changed
}

sema_effect_parse_name: fn(name: String) -> String? {
    // A value (`Bucket{name: "photos"}`) names a package's struct effect
    // (Library.jet), never a Prelude one.
    if name == "" || name.starts_with("..") || effect_value_is_valued(name) -> return None
    ^base: name
    scoped: effect_scope_split(name)
    if scoped.scope == .Val(scope) {
        // A scope argument names a folder, a host or a device; the deny-only
        // `Mem` and `Panic` roots name none.
        if !effect_scope_argument_valid(scope) || authority_is_deny_only(scoped.base) -> return None
        base = scoped.base
    } else if base.contains("(") {
        parts: base.split("(").to_list()
        if parts.len() != 2 -> return None
        closing: parts[1].split(")").to_list()
        if closing.len() != 2 || closing[1] != "" -> return None
        base = parts[0]
        if base != "Mem.Alloc" && base != "Mem.Stack" -> return None
        arguments: closing[0].trim().split(":").to_list()
        if arguments.len() != 2 || arguments[0].trim() != "above" -> return None
        amount: Int.parse(arguments[1].trim()) ?? return None
        if amount <= 0 -> return None
    }
    // A stack denial is only ever bounded.
    if base == "Mem.Stack" && base == name -> return None
    root: sema_effect_root(base)
    if !EFFECT_VOCABULARY_ROOTS.contains(root) -> return None
    loop segment in base.split(".") {
        if segment == "" -> return None
    }
    Val(name)
}

sema_effect_without_deny_only: fn(values: [String]) -> [String] Never! {
    ^result: [String]{}
    loop value in values {
        if !authority_is_deny_only(value) -> sema_effect_set_add(result, value)
    }
    result
}

// The effects of `inferred` no bound covers. A bound naming a Core service
// effect (`DB`, `DB.Read`) also covers the machine effects the `#FX(…)` above
// its declaration lists (sema_effect_core_kernel): a row, cap or scope naming
// `DB` may use what a database driver needs. Denials never widen this way.
sema_effect_uncovered: fn(inferred: [String], bounds: [String]) -> [String] Never! {
    ^result: [String]{}
    loop effect_name in sema_effect_without_deny_only(inferred) {
        covered: loop bound in bounds {
            if sema_effect_covers(bound, effect_name) {
                break true
            }
            through: loop listed in sema_effect_core_kernel(bound) {
                if sema_effect_covers(listed, effect_name) {
                    break true
                }
            } ?? false
            if through {
                break true
            }
        } ?? false
        if !covered -> sema_effect_set_add(result, effect_name)
    }
    result
}

// The machine effects a bound naming the Core service effect `name` admits:
// its EFFECT_VOCABULARY_ROWS kernel, empty for a machine effect.
sema_effect_core_kernel: fn(name: String) -> [String] Never! {
    loop row in EFFECT_VOCABULARY_ROWS {
        if row.name == name -> return row.kernel
    }
    [String]{}
}

sema_effect_covered: fn(inferred: [String], prohibited: [String]) -> [String] Never! {
    ^result: [String]{}
    loop effect_name in inferred {
        loop bound in prohibited {
            if sema_effect_covers(bound, effect_name) {
                sema_effect_set_add(result, effect_name)
                break
            }
        }
    }
    result
}

priv sema_effect_covered_one: fn(inferred: [String], bound: String) -> [String] Never! {
    ^result: [String]{}
    loop effect_name in inferred {
        if sema_effect_covers(bound, effect_name) -> sema_effect_set_add(result, effect_name)
    }
    result
}

priv sema_effect_is_covered_by: fn(effect_name: String, bounds: [String]) -> Bool Never! {
    loop bound in bounds {
        if sema_effect_covers(bound, effect_name) -> return true
    }
    false
}

sema_effect_show: fn(values: [String]) -> String Never! { values.join(", ") }

sema_effect_span_contains: fn(outer: Span, inner: Span) -> Bool Never! {
    outer.start <= inner.start && inner.end <= outer.end
}

// An effect's own declaration says whether it is irreversible (`FS.Read`
// is not, `FS.Write` is, and the family `FS` is because a case is); a
// name the canonical module does not declare follows its root. A scoped
// name is judged by its base effect.
sema_effect_declarations_irreversible_fact: fn(declarations: [Item], effect_name: String) -> Bool? {
    base: effect_scope_split(effect_name).base
    root: sema_effect_root(base)
    ^root_fact: Bool?{None}
    loop item in declarations {
        if item == .EffectDecl(declaration) {
            if declaration.name == base -> return Val(declaration.irreversible)
            if declaration.name == root -> root_fact = Val(declaration.irreversible)
        }
    }
    root_fact
}

// The declared EffectAccess of `effect_name`, reading library effects visible
// to the module first and then the canonical effect vocabulary (exact leaf,
// else family root). Scoped and valued names follow their base effect.
sema_effect_access: fn(effect_name: String, library_effects: [SemaLibraryEffectName]) -> EffectAccess Never! {
    base: effect_value_base(effect_scope_split(effect_name).base)
    loop entry in library_effects {
        if entry.token == base || entry.written == base -> return entry.access
    }
    root: sema_effect_root(base)
    ^family: EffectAccess.Reads
    loop row in EFFECT_VOCABULARY_ROWS {
        if row.name == base -> return row.access
        if row.name == root -> family = row.access
    }
    family
}

// The strongest EffectAccess across every positive effect in `effects`.
sema_effect_row_access: fn(effects: [String], library_effects: [SemaLibraryEffectName]) -> EffectAccess Never! {
    ^highest: EffectAccess.Reads
    loop effect_name in effects {
        if effect_name.starts_with("!") -> next
        highest = effect_access_max(highest, sema_effect_access(effect_name, library_effects))
    }
    highest
}

// The transaction wall follows the canonical `irreversible: fn` facts loaded
// from the pinned Prelude module. It deliberately does not maintain a second
// allowlist: changing an effect's `irreversible` method in
// Prelude/Effects.jet changes this fact at the source boundary.
sema_effect_canonical_irreversible_fact: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, effect_name: String) -> Bool? {
    graph: program.registration_graph
    canonical_identity: graph.canonical_effect_module_identity
    if module_is_none(canonical_identity) -> return None
    module_index: sema_registration_module_index(graph, canonical_identity) ?? return None
    if graph.modules[module_index].package_identity != JET_CANONICAL_EFFECT_PACKAGE_IDENTITY || graph.modules[module_index].module_path != JET_CANONICAL_EFFECT_MODULE_PATH {
        return None
    }
    sema_effect_declarations_irreversible_fact(graph.modules[module_index].program.items, effect_name)
}

sema_effect_is_irreversible: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, effect_name: String) -> Bool? {
    sema_effect_canonical_irreversible_fact(environment, program, effect_name)
}

sema_effect_transaction_wall_diagnostic: fn(api: String, effect_name: String, span: Span) -> Diagnostic {
    effect_root: sema_effect_root(effect_name)
    diagnostic: if effect_root == "FFI" -> sema_error("E0746", span, "`{api}` has the `FFI` effect, which can't be rolled back inside a `#Transact` block", "a foreign function can change external state that the compiler cannot undo automatically", "move this call after the block, or declare `#Undo(inverse)` on the foreign binding so rollback can call the inverse") else -> sema_error("E0746", span, "`{api}` has the `{effect_root}` effect, which can't be rolled back inside a `#Transact` block", "a `#Transact` block undoes its work on a `?`-failure; a network, file, or subprocess effect (`{effect_root}`) leaves committed external state a rollback can't take back", "move this call after the block, or register it with `<handle>.on_commit(fn() {{ … }})` so it runs only on a clean commit")
    diagnostic_with_rights(diagnostic, "transaction", [String]{api}, [String]{}, None)
}

// Check a call's declared effect row at the authored-transaction wall. The
// caller supplies the canonical API spelling because checked-tree call nodes may no
// longer retain the registration module/member pair.
sema_effect_check_transaction_wall: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, effect_row: [EffectRowEntry]?, api: String, span: Span, diagnostics: ^[Diagnostic]) -> Bool? {
    if scopes.transaction_wall_depth <= 0 -> return Val(true)
    row: effect_row ?? return Val(true)
    loop entry in row {
        if entry.name.starts_with("!") || entry.name.starts_with("..") -> next
        parsed: sema_effect_parse_name(entry.name) ?? next
        irreversible: sema_effect_is_irreversible(environment, program, parsed) ?? return None
        if irreversible {
            diagnostics.push(sema_effect_transaction_wall_diagnostic(api, parsed, span))
            return Val(false)
        }
    }
    Val(true)
}

// The name a diagnostic gives a module member: its module's last segment
// and the member (`files.read` for `<corelib>/core.files`).
sema_effect_member_label: fn(module_name: String, member: String) -> String Never! {
    path: module_name.split("/").to_list()
    parts: path[path.len() - 1].split(".").to_list()
    "{parts[parts.len() - 1]}.{member}"
}

// The name a diagnostic gives a declaration key: a Core function is
// `{module}.{name}`, any other declaration its bare name.
sema_effect_decl_label: fn(key: String) -> String Never! {
    leaf: symbol_key_leaf(key)
    owner_module: sema_effect_core_member_module(key) ?? return leaf
    sema_effect_member_label(owner_module, leaf)
}

sema_effect_call_api: fn(program: SemaProgramTables, value: TExpr) -> String Never! {
    if value.kind == {
        .Call(callee, _, _) -> sema_effect_decl_label(sema_program_decl_key(program, callee))
        .MethodCall(_, method, _, _) -> method.name
        .IndirectCall(_, _, _, _) -> "indirect call"
        .BuiltinMethod(_, _, _) | .ClosureMethod(_, _, _) | .HandleMethod(_, _, _) -> "intrinsic method"
        .AllocNew(_, _) -> "intrinsic allocation"
        .SharedGuardWait(_, _, _) -> "shared guard wait"
        .CoreClosureCall(_) -> "core closure intrinsic"
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .HostCall(_) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> "call"
    }
}

// sema_effect_call_api of a node of a checked flat body; `decls` names a
// direct callee, its key a row of `symbols`.
sema_effect_node_call_api: fn(decls: DeclTable, symbols: SymbolTable, kind: NodeKind) -> String Never! {
    if kind == {
        .Call(callee, _, _) -> sema_effect_decl_label(decl_table_key(decls, symbols, callee))
        .MethodCall(_, method, _, _) -> method.name
        .IndirectCall(_, _, _, _) -> "indirect call"
        .BuiltinMethod(_, _, _) | .ClosureMethod(_, _, _) | .HandleMethod(_, _, _) -> "intrinsic method"
        .AllocNew(_, _) -> "intrinsic allocation"
        .SharedGuardWait(_, _, _) -> "shared guard wait"
        .CoreClosureCall(_) -> "core closure intrinsic"
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .ConditionNotify(_, _) | .HostCall(_) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> "call"
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Diagnostics and explicit audit gates
// ────────────────────────────────────────────────────────────────────────────

// E0119. A name that matches a registered effect but for letter case (`io`,
// `fs.read`) is that effect miswritten, so the fix names its registered
// PascalCase spelling and its suggested edit writes it.
sema_effect_unknown: fn(name: String, span: Span) -> Diagnostic {
    wanted: name.lower()
    loop row in EFFECT_VOCABULARY_ROWS {
        if row.name.lower() == wanted {
            diagnostic: sema_error("E0119", span, "`{name}` isn't a known effect", "an effect list names compiler-known effects like `Net`, `FS`, `IO`, `DB`, or `Time`", "write it `{row.name}`, the effect's registered spelling")
            return diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: row.name})
        }
    }
    sema_error("E0119", span, "`{name}` isn't a known effect", "an effect list names compiler-known effects like `Net`, `FS`, `IO`, `DB`, or `Time`", "use one of the known effect names, or remove it from the list")
}

// E0119 at `span` for the entry at `index` of a written effect list whose
// entries were written at `sources`. An entry naming a root a language change
// removed carries the edit that drops it from the list, which `jet fix` applies.
sema_effect_unknown_entry: fn(name: String, span: Span, sources: [Span], index: Int) -> Diagnostic {
    diagnostic: sema_effect_unknown(name, span)
    if !effect_root_removed(name) -> return diagnostic
    diagnostic_with_migration_edit(diagnostic, TextEdit{span: effect_list_entry_removal(sources, index), new_text: ""})
}

// Where each entry of a written effect row was written (effect_row_entry_source).
sema_effect_row_sources: fn(entries: [EffectRowEntry]) -> [Span] Never! {
    loop entry in entries -> effect_row_entry_source(entry)
}

sema_effect_positive_panic: fn(span: Span) -> Diagnostic {
    sema_error("E0751", span, "`Panic` can't be granted, only denied", "`Panic` is a deny-only effect row; no positive effect bound or authority can grant it", "drop `Panic` from the list, or write `-[!Panic]>`")
}

// A checked String argument that is not a literal (`#Unsafe(reason)`) is a
// reason; the rule's signature check owns its type.
sema_effect_check_unsafe_region: fn(reason: String?, has_reason_expr: Bool, span: Span, diagnostics: ^[Diagnostic]) -> Bool {
    if (reason ?? "").len() > 0 || (reason == None && has_reason_expr) -> return true
    diagnostics.push(sema_error("E3112", span, "an `#Unsafe` block needs a reason", "every unsafe gate records why its unchecked operations preserve memory safety", "write `#Unsafe(\"why this is safe\") {{ … }}`"))
    false
}

sema_effect_check_unsafe_function_reason: fn(reason: String?, span: Span, diagnostics: ^[Diagnostic]) -> Bool {
    if (reason ?? "").len() > 0 -> return true
    diagnostics.push(sema_error("E3112", span, "an `#Unsafe` function needs a reason", "every unsafe function records why callers can rely on its unchecked contract", "write `#Unsafe(\"why this is safe\") name: fn …`"))
    false
}

sema_effect_check_unsafe_function: fn(source: SemaEffectFunctionSource, diagnostics: ^[Diagnostic]) -> Bool {
    if !source.is_unsafe -> return true
    sema_effect_check_unsafe_function_reason(source.unsafe_reason, source.unsafe_span ?? source.span, diagnostics)
}

sema_effect_require_unsafe_call: fn(callee: String, callee_is_unsafe: Bool, audited: Bool, span: Span, diagnostics: ^[Diagnostic]) -> Bool {
    if !callee_is_unsafe || audited -> return true
    diagnostics.push(sema_error("E3103", span, "`{callee}` is an `#Unsafe` function", "its contract can't be checked by the compiler, so the caller must vouch for it", "call it inside `#Unsafe(\"…\") {{ … }}`"))
    false
}

sema_effect_check_tfunc_unsafe: fn(function: FnBody, diagnostics: ^[Diagnostic]) -> Bool {
    if !function.is_unsafe -> return true
    sema_effect_check_unsafe_function_reason(function.unsafe_gate.map(fn(gate) { gate.reason }), function.source_span, diagnostics)
}

sema_effect_via_unknown_parameter: fn(function: FnBody, parameter: String, span: Span) -> Diagnostic {
    sema_error("E0748", span, "`-[via {parameter}]>` on `{function.name}` names no such parameter", "`-[via f]>` publishes the effects of a callback parameter `f`; `{function.name}` has no parameter called `{parameter}`", "name one of `{function.name}`'s callback parameters after `via`")
}

sema_effect_via_not_callback: fn(function: FnBody, parameter: String, ty: Type, span: Span) -> Diagnostic {
    sema_error("E0748", span, "`-[via {parameter}]>` on `{function.name}` names a parameter that isn't a callback", "`{parameter}` has type `{type_name(ty)}`, not a function type with an effect row", "point `via` at a function parameter, or remove the `via` annotation")
}

sema_effect_apply_via: fn(node: ^SemaEffectNode, function: FnBody, diagnostics: ^[Diagnostic]) {
    via: node.effect_via ?? return
    ^parameter_type: Type?{None}
    loop parameter_index in 0..<function.params.len() {
        if function.params[parameter_index].name == via.name {
            parameter_type = Val(function.params[parameter_index].ty)
            break
        }
    }
    callback_type: parameter_type ?? {
        diagnostics.push(sema_effect_via_unknown_parameter(function, via.name, via.span))
        return
    }
    if callback_type == {
        .Fn(_, _, effect_bound, _, _, _) -> {
            if effect_bound == {
                .Val(effect_row) -> {
                    loop index in 0..<effect_row.len() {
                        entry: effect_row[index]
                        if entry.name.starts_with("..") -> next
                        ^raw: entry.name
                        if raw.starts_with("!") {
                            pieces: raw.split("!").to_list()
                            if pieces.len() > 1 -> raw = pieces[1]
                        }
                        effect_name: sema_effect_parse_name(raw) ?? {
                            diagnostics.push(sema_effect_unknown_entry(raw, entry.span, sema_effect_row_sources(effect_row), index))
                            next
                        }
                        if sema_effect_root(effect_name) == "Panic" {
                            diagnostics.push(sema_effect_positive_panic(entry.span))
                            next
                        }
                        if sema_effect_set_add(node.direct, effect_name) {
                            node.direct_spans.push(TEffectSpan{name: effect_name, span: entry.span})
                        }
                    }
                }
                .None -> {
                    node.maximal = true
                    node.maximal_span = Val(via.span)
                }
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            diagnostics.push(sema_effect_via_not_callback(function, via.name, callback_type, via.span))
        }
    }
}

// `e0740`: the span is the row's first entry. A scoped need that a bare
// need in the same list covers is not named twice.
sema_effect_bound_diagnostic: fn(node: SemaEffectNode, over: [String]) -> Diagnostic {
    ^sorted: [String]{}
    loop name in over {
        if !sema_effect_bare_covered(over, name) -> sorted.push(name.copy())
    }
    sorted.sort()
    over_list: sema_effect_show(sorted)
    declared: if node.declared.len() == 0 -> "no effects" else -> "`-[{sema_effect_show(node.declared)}]>`"
    span: node.row_span ?? node.name_span
    diagnostic: sema_error("E0740", span, "`{node.name}` uses the effect `{over_list}`, which its signature doesn't allow", "the signature declares {declared}, so the body may only use those; `{over_list}` is outside that set", "add `{over_list}` to the effect list, or stop using it in `{node.name}`")
    diagnostic_with_rights(diagnostic, "invocation", [String]{node.name}, [String]{}, None)
}

// True when `name` is scoped and a bare name in `names` covers it.
sema_effect_bare_covered: fn(names: [String], name: String) -> Bool Never! {
    if !effect_scope_is_scoped(name) -> return false
    loop other in names {
        if !effect_scope_is_scoped(other) && effect_scope_covers(other, name) -> return true
    }
    false
}

// `e0749` / `e0749_panic`: a reached Panic names the reachable function where
// the stop enters the call graph, and the call chain to it
// (sema_effect_panic_steps); a reached Unsafe names the function that opens
// the gate, the gate, and the call chain to it (sema_effect_unsafe_reach).
sema_effect_prohibited_diagnostic: fn(node: SemaEffectNode, reached: [String], panic_steps: [String], unsafe_reach: SemaEffectUnsafeReach?) -> Diagnostic {
    reached_list: sema_effect_show(reached)
    declared: sema_effect_show(node.prohibited)
    span: node.prohibition_span ?? node.name_span
    reaches_panic: loop effect_name in reached {
        if sema_effect_root(effect_name) == "Panic" {
            break true
        }
    } ?? false
    if reaches_panic {
        panic_site: sema_effect_panic_site_name(node, panic_steps)
        diagnostic: sema_error("E0749", span, "`{node.name}` can stop, but Panic is denied here", "`{panic_site}` can stop; `{node.name}` and every reachable callee must not stop when Panic is denied", "return a fallible result for expected failure, add facts or a `#Pre`/refinement proof for a programmer-error stop, or drop the `-[!{declared}]>` prohibition")
        return diagnostic_with_rights(diagnostic, "invocation", sema_effect_panic_chain(node.name, panic_steps), [String]{}, None)
    }
    if unsafe_reach == .Val(reach) {
        opener: sema_effect_panic_site_name(node, reach.steps)
        diagnostic: sema_error("E0749", span, "`{node.name}` reaches `#Unsafe` code, but Unsafe is denied here", "`{opener}` {sema_effect_unsafe_gate_text(reach.gate)}; `{node.name}` and every callee it can reach must stay out of `#Unsafe` code when Unsafe is denied", "remove the `#Unsafe` gate from `{opener}` or stop calling it, or drop the `-[!{declared}]>` prohibition")
        return diagnostic_with_rights(diagnostic, "invocation", sema_effect_panic_chain(node.name, reach.steps), [String]{}, None)
    }
    diagnostic: sema_error("E0749", span, "`{node.name}` reaches the `{reached_list}` effect, which it prohibits with `-[!{declared}]>`", "a `-[!{declared}]>` row means the function and every callee it can reach must not use `{reached_list}`", "remove the call that introduces `{reached_list}`, or drop the `-[!{declared}]>` prohibition")
    diagnostic_with_rights(diagnostic, "invocation", [String]{node.name}, [String]{}, None)
}

// One effect an `authority: { deny: [...] }` row denies the root package's
// modules: the package's own row (`organization` is ""), or the organization
// policy file's at `organization`, which no package row lifts.
SemaEffectDenial: struct {
    name: String,
    organization: String,
}

// A package `authority.deny` row, or the organization policy's, reached by
// one of the package's functions. A denied Panic names the reachable
// function where the stop enters the call graph and the chain to it
// (`panic_steps`) and the three exits, the same as a `-[!Panic]>` row; a
// denied Unsafe names the gate and the chain to it, as `-[!Unsafe]>` does.
sema_effect_package_denied_diagnostic: fn(node: SemaEffectNode, reached: [String], denied: String, panic_steps: [String], unsafe_reach: SemaEffectUnsafeReach?, organization: String) -> Diagnostic {
    reached_list: sema_effect_show(reached)
    reaches_panic: loop effect_name in reached {
        if sema_effect_root(effect_name) == "Panic" {
            break true
        }
    } ?? false
    denier: if organization == "" -> "the package" else -> "the organization policy `{organization}`"
    undo: if organization == "" -> "drop `{denied}` from `authority.deny`" else -> "ask the organization to drop `{denied}` from its policy's `authority.deny`; no package row lifts it"
    if reaches_panic {
        panic_site: sema_effect_panic_site_name(node, panic_steps)
        diagnostic: sema_error("E0749", node.name_span, "`{node.name}` can stop, but {denier} denies Panic with `authority: {{ deny: [{denied}] }}`", "`{panic_site}` can stop; every function in the package and every callee it can reach must not stop when Panic is denied", "return a fallible result for expected failure, add facts or a `#Pre`/refinement proof for a programmer-error stop, or {undo}")
        return diagnostic_with_rights(diagnostic, "invocation", sema_effect_panic_chain(node.name, panic_steps), [String]{}, None)
    }
    if unsafe_reach == .Val(reach) {
        opener: sema_effect_panic_site_name(node, reach.steps)
        diagnostic: sema_error("E0749", node.name_span, "`{node.name}` reaches `#Unsafe` code, but {denier} denies Unsafe with `authority: {{ deny: [{denied}] }}`", "`{opener}` {sema_effect_unsafe_gate_text(reach.gate)}; every function in the package and every callee it can reach must stay out of `#Unsafe` code when Unsafe is denied", "remove the `#Unsafe` gate from `{opener}` or stop calling it, or {undo}")
        return diagnostic_with_rights(diagnostic, "invocation", sema_effect_panic_chain(node.name, reach.steps), [String]{}, None)
    }
    row: if organization == "" -> "a package `deny` row" else -> "an organization `deny` row"
    diagnostic: sema_error("E0749", node.name_span, "`{node.name}` reaches the `{reached_list}` effect, which {denier} denies with `authority: {{ deny: [{denied}] }}`", "{row} means every function in the package and every callee it can reach must not use `{reached_list}`", "remove the call that introduces `{reached_list}`, or {undo}")
    diagnostic_with_rights(diagnostic, "invocation", [String]{node.name}, [String]{}, None)
}

// A function that uses the expert effect `right` at `span` where its package
// doesn't hold it (authority_expert_answer). The main package holds one by
// naming it, or an expert effect above it, in its `authority.allow` row; a
// dependency holds one only through the main package's `authority.grants`
// line for it. An `allow` entry that is not itself expert (`Meta`) holds
// none of the expert effects under it, and the report names those it left
// out.
sema_effect_expert_not_held_diagnostic: fn(node: SemaEffectNode, right: String, span: Span, policy: SemaRegistrationPackagePolicy, main: Bool, verdict: AuthorityVerdict) -> Diagnostic {
    if verdict == AuthorityVerdict.Denied {
        diagnostic: sema_error("E0777", span, "`{node.name}` uses the expert effect `{right}`, which a `deny` row refuses its package", "deny always wins over a grant, and denying an effect denies every effect under it", "stop using `{right}` in `{node.name}`, or drop it from the `authority.deny` row that names it")
        return diagnostic_with_rights(diagnostic, "expert", [String]{node.name}, [String]{}, None)
    }
    if !main {
        package: if policy.grant_name == "" -> policy.package_identity else -> policy.grant_name
        diagnostic: sema_error("E0777", span, "`{package}` needs `{right}`: `{node.name}` uses it, and the main package doesn't grant it", "only the main package holds an expert effect; a dependency uses one only where the main package lends it with `authority.grants`", "add `authority: {{ grants: {{ \"{package}\": [{right}] }} }}` to the main package's manifest, or stop using `{right}` in `{node.name}`")
        return diagnostic_with_rights(diagnostic, "expert", [String]{node.name}, [String]{}, None)
    }
    ^why: "no package holds an expert effect by default: the main package holds one only where its `authority.allow` row names it or an expert effect above it"
    allowed: policy.authority_allow ?? [String]{}
    loop entry in allowed {
        if !effect_scope_covers(entry, right) -> next
        left_out: authority_expert_left_out(entry)
        if left_out.len() > 0 {
            why = "`allow: [{entry}]` holds only the effects under `{entry}` that are not expert; it leaves out the expert effects `{left_out.join("`, `")}`, which must be named"
        }
    }
    diagnostic: sema_error("E0777", span, "`{node.name}` uses the expert effect `{right}`, which the main package doesn't hold", why, "add `{right}` to the main package's `authority: {{ allow: [...] }}` row, or stop using it in `{node.name}`")
    diagnostic_with_rights(diagnostic, "expert", [String]{node.name}, [String]{}, None)
}

sema_effect_pure_diagnostic: fn(node: SemaEffectNode, reached: [String]) -> Diagnostic {
    sema_error("E3401", node.span, "`{node.name}` calls or reaches impure effects `{sema_effect_show(reached)}`", "a pure function must produce the same result without ambient effects", "remove the call that introduces `{sema_effect_show(reached)}`, or drop the `-[]>` bound from `{node.name}` so its effects are inferred")
}

// A pure function that writes state outliving the call (`path` is the
// function alone) or reaches a function that does (`path` runs from the pure
// function to it). The report points at the write; a write through a held
// cell (a parameter or local) names the holder.
sema_effect_pure_state_diagnostic: fn(nodes: [SemaEffectNode], path: [Int]) -> Diagnostic {
    node: nodes[path[0]]
    writer: nodes[path[path.len() - 1]]
    writes: writer.rare ?? SEMA_EFFECT_NODE_NO_RARE
    write: writes.module_writes[0]
    chain: loop step in path -> nodes[step].chain_name
    written: if write.held -> "a cell through `{write.name}`" else -> "module state `{write.name}`"
    if path.len() == 1 {
        why: if write.held -> "`{write.name}` may hold a module cell, and a write to it outlives the call so a later read sees it, but `{node.name}` declares `-[]>`" else -> "module state outlives the call, so a later call sees the write, but `{node.name}` declares `-[]>`"
        instead: if write.held -> "take the cell as a `^` parameter so the caller lends it for writing, return the new value instead" else -> "pass the state in and return the new value"
        diagnostic: sema_error("E3401", write.span, "`{node.name}` writes {written}", why, "{instead}, or drop the `-[]>` bound from `{node.name}` so its effects are inferred")
        return diagnostic_with_rights(diagnostic, "pure", chain, [String]{}, None)
    }
    target: if write.held -> "a cell through `{write.name}`" else -> "`{write.name}`"
    diagnostic: sema_error("E3401", write.span, "`{node.name}` reaches a write of {written}", "{chain.join(" → ")} writes {target}, which outlives the call — the whole call chain must be pure inside `{node.name}`", "move the write out of `{writer.chain_name}`, or drop the `-[]>` bound from `{node.name}` so its effects are inferred")
    diagnostic_with_rights(diagnostic, "pure", chain, [String]{}, None)
}

// The call path from `index` to the first function reached depth-first that
// writes module state, `index` first; empty when none does.
sema_effect_state_writer_path: fn(nodes: [SemaEffectNode], index: Int, seen: ^[Bool], visited: ^[Int]) -> [Int] Never! {
    if seen[index] -> return [Int]{}
    seen[index] = true
    visited.push(index)
    if nodes[index].rare == .Val(rare) && rare.module_writes.len() > 0 -> return [Int]{index}
    calls: nodes[index].call_targets.len()
    loop position in 0..<(calls + sema_effect_node_value_count(nodes[index])) {
        target: if position < calls -> nodes[index].call_targets[position] else -> sema_effect_node_value_target(nodes[index], position - calls)
        if target < 0 -> next
        tail: sema_effect_state_writer_path(nodes, target, seen, visited)
        if tail.len() == 0 -> next
        ^path: [Int]{index}
        loop step in tail -> path.push(step)
        return path
    }
    [Int]{}
}

// A pure function that reads changeable module state (`path` is the function
// alone) or reaches a function that does (`path` runs from the pure function
// to it). The report points at the read.
sema_effect_pure_read_diagnostic: fn(nodes: [SemaEffectNode], path: [Int]) -> Diagnostic {
    node: nodes[path[0]]
    reader: nodes[path[path.len() - 1]]
    reads: reader.rare ?? SEMA_EFFECT_NODE_NO_RARE
    read: reads.module_reads[0]
    chain: loop step in path -> nodes[step].chain_name
    if path.len() == 1 {
        diagnostic: sema_error("E3401", read.span, "`{node.name}` reads module state `{read.name}`", "changeable module state can vary between calls with the same arguments, so `{node.name}` cannot stay pure under `-[]>`", "pass `{read.name}` in as a parameter, or drop the `-[]>` bound from `{node.name}` so its effects are inferred")
        return diagnostic_with_rights(diagnostic, "pure", chain, [String]{}, None)
    }
    diagnostic: sema_error("E3401", read.span, "`{node.name}` reaches a read of module state `{read.name}`", "{chain.join(" → ")} reads changeable module state `{read.name}`, which can vary between calls — the whole call chain must be pure inside `{node.name}`", "pass `{read.name}` in as a parameter, move the read out of `{reader.chain_name}`, or drop the `-[]>` bound from `{node.name}` so its effects are inferred")
    diagnostic_with_rights(diagnostic, "pure", chain, [String]{}, None)
}

// E0938: a `#Memo` function that writes or reads changeable module state (directly
// or through a call) cannot safely reuse cached results across calls.
sema_effect_memo_state_diagnostic: fn(nodes: [SemaEffectNode], path: [Int], memo_span: Span, is_write: Bool) -> Diagnostic {
    node: nodes[path[0]]
    leaf: nodes[path[path.len() - 1]]
    rare: leaf.rare ?? SEMA_EFFECT_NODE_NO_RARE
    entry: if is_write -> rare.module_writes[0] else -> rare.module_reads[0]
    chain: loop step in path -> nodes[step].chain_name
    subject: sema_effect_memo_subject(node.name)
    verb: if is_write -> "writes" else -> "reads"
    target: if entry.held -> "a cell through `{entry.name}`" else -> "module state `{entry.name}`"
    why: if path.len() == 1 -> "memoization reuses a completed result, but {subject} {verb} {target}, which can change between calls" else -> "memoization reuses a completed result, but {chain.join(" → ")} {verb} {target}, which can change between calls"
    fix: if is_write -> "move the write of {target} out of {subject}, or drop `#Memo`" else -> "pass `{entry.name}` in as a parameter so the cache keys on it, or drop `#Memo`"
    diagnostic: sema_error("E0938", memo_span, "`#Memo` requires a pure function", why, fix)
    diagnostic_with_rights(diagnostic, "pure", chain, [String]{}, None)
}

// The call path from `index` to the first function reached depth-first that
// reads changeable module state, `index` first; empty when none does.
sema_effect_state_reader_path: fn(nodes: [SemaEffectNode], index: Int, seen: ^[Bool], visited: ^[Int]) -> [Int] Never! {
    if seen[index] -> return [Int]{}
    seen[index] = true
    visited.push(index)
    if nodes[index].rare == .Val(rare) && rare.module_reads.len() > 0 -> return [Int]{index}
    calls: nodes[index].call_targets.len()
    loop position in 0..<(calls + sema_effect_node_value_count(nodes[index])) {
        target: if position < calls -> nodes[index].call_targets[position] else -> sema_effect_node_value_target(nodes[index], position - calls)
        if target < 0 -> next
        tail: sema_effect_state_reader_path(nodes, target, seen, visited)
        if tail.len() == 0 -> next
        ^path: [Int]{index}
        loop step in tail -> path.push(step)
        return path
    }
    [Int]{}
}

// Solves the first module state name written directly or transitively (through
// `call_targets` or `value_targets`) for every node in `nodes`. Returns an
// empty list when no node writes module state so programs without module writes
// pay zero cost.
sema_effect_solve_module_writes: fn(nodes: [SemaEffectNode], callers: [[Int]], any_module_writes: Bool) -> [String?] Never! {
    if !any_module_writes -> return [String?]{}
    count: nodes.len()
    ^value_callers: (loop _ in 0..<count -> [Int]{})
    loop index in 0..<count {
        if nodes[index].rare == .Val(rare) {
            loop target in rare.value_targets {
                if target >= 0 && target < count -> value_callers[target].push(index)
            }
        }
    }
    ^can_write: (loop _ in 0..<count -> false)
    ^pending: [Int]{}
    loop index in 0..<count {
        if nodes[index].rare == .Val(rare) && rare.module_writes.len() > 0 {
            can_write[index] = true
            pending.push(index)
        }
    }
    ^cursor: 0
    loop cursor < pending.len() {
        incoming: pending[cursor]
        cursor += 1
        loop caller in callers[incoming] {
            if !can_write[caller] {
                can_write[caller] = true
                pending.push(caller)
            }
        }
        loop caller in value_callers[incoming] {
            if !can_write[caller] {
                can_write[caller] = true
                pending.push(caller)
            }
        }
    }
    ^out: (loop _ in 0..<count -> String?{None})
    ^seen: (loop _ in 0..<count -> false)
    ^visited: [Int]{}
    loop index in 0..<count {
        if !can_write[index] -> next
        if nodes[index].rare == .Val(rare) && rare.module_writes.len() > 0 {
            out[index] = Val(rare.module_writes[0].name)
            next
        }
        path: sema_effect_state_writer_path(nodes, index, seen, visited)
        loop row in visited -> seen[row] = false
        visited.clear()
        if path.len() > 0 {
            writer: nodes[path[path.len() - 1]]
            writes: writer.rare ?? SEMA_EFFECT_NODE_NO_RARE
            if writes.module_writes.len() > 0 {
                out[index] = Val(writes.module_writes[0].name)
            }
        }
    }
    out
}

// A changeable module storage global whose every write sits inside `#Unsafe`
// (and that has at least one such write) is a raw word: it skips the task and
// `#Export(c)` concurrency checks while purity (`-[]>`) and `#Memo` still see
// it. A single plain write outside `#Unsafe` makes the global tracked.
sema_effect_raw_storage_words: fn(nodes: [SemaEffectNode]) -> NameTable Never! {
    ^unsafe_written: name_table_sized(8)
    ^unsafe_names: [String]{}
    ^plain_written: name_table_sized(8)
    loop node in nodes {
        rare: node.rare ?? next
        loop write in rare.module_writes {
            if !write.storage -> next
            if write.in_unsafe {
                if name_find(unsafe_written, write.name) == None {
                    ^_: name_intern(unsafe_written, write.name)
                    unsafe_names.push(write.name)
                }
            } else {
                ^_: name_intern(plain_written, write.name)
            }
        }
    }
    ^raw: name_table_sized(unsafe_names.len() + 2)
    loop name in unsafe_names {
        if name_find(plain_written, name) == None {
            ^_: name_intern(raw, name)
        }
    }
    raw
}

// First changeable module storage binding (`^name: ...` / `#Persist`) this
// node reads or writes directly; None for nodes that touch only thread-safe
// `Shared` holders or no module state.
sema_effect_node_storage_touch: fn(node: SemaEffectNode) -> TEffectSpan? Never! {
    rare: node.rare ?? return None
    loop write in rare.module_writes {
        if write.storage -> return Val(write)
    }
    loop read in rare.module_reads {
        if read.storage -> return Val(read)
    }
    None
}

// First tracked (non-raw-word) changeable module storage binding this node
// reads or writes directly.
sema_effect_node_tracked_storage_touch: fn(node: SemaEffectNode, raw_words: NameTable) -> TEffectSpan? Never! {
    rare: node.rare ?? return None
    loop write in rare.module_writes {
        if write.storage && name_find(raw_words, write.name) == None -> return Val(write)
    }
    loop read in rare.module_reads {
        if read.storage && name_find(raw_words, read.name) == None -> return Val(read)
    }
    None
}

// First tracked (non-raw-word) changeable module storage binding this node
// writes directly.
sema_effect_node_tracked_storage_write: fn(node: SemaEffectNode, raw_words: NameTable) -> TEffectSpan? Never! {
    rare: node.rare ?? return None
    loop write in rare.module_writes {
        if write.storage && name_find(raw_words, write.name) == None -> return Val(write)
    }
    None
}

// The call path from `index` to the first function reached depth-first that
// reads or writes a tracked (non-raw-word) changeable module storage binding.
sema_effect_tracked_storage_touch_path: fn(nodes: [SemaEffectNode], index: Int, raw_words: NameTable, seen: ^[Bool], visited: ^[Int]) -> [Int] Never! {
    if seen[index] -> return [Int]{}
    seen[index] = true
    visited.push(index)
    if sema_effect_node_tracked_storage_touch(nodes[index], raw_words) != None -> return [Int]{index}
    calls: nodes[index].call_targets.len()
    loop position in 0..<(calls + sema_effect_node_value_count(nodes[index])) {
        target: if position < calls -> nodes[index].call_targets[position] else -> sema_effect_node_value_target(nodes[index], position - calls)
        if target < 0 -> next
        tail: sema_effect_tracked_storage_touch_path(nodes, target, raw_words, seen, visited)
        if tail.len() == 0 -> next
        ^path: [Int]{index}
        loop step in tail -> path.push(step)
        return path
    }
    [Int]{}
}

// The call path from `index` to the first function reached depth-first that
// writes a tracked (non-raw-word) changeable module storage binding.
sema_effect_tracked_storage_write_path: fn(nodes: [SemaEffectNode], index: Int, raw_words: NameTable, seen: ^[Bool], visited: ^[Int]) -> [Int] Never! {
    if seen[index] -> return [Int]{}
    seen[index] = true
    visited.push(index)
    if sema_effect_node_tracked_storage_write(nodes[index], raw_words) != None -> return [Int]{index}
    calls: nodes[index].call_targets.len()
    loop position in 0..<(calls + sema_effect_node_value_count(nodes[index])) {
        target: if position < calls -> nodes[index].call_targets[position] else -> sema_effect_node_value_target(nodes[index], position - calls)
        if target < 0 -> next
        tail: sema_effect_tracked_storage_write_path(nodes, target, raw_words, seen, visited)
        if tail.len() == 0 -> next
        ^path: [Int]{index}
        loop step in tail -> path.push(step)
        return path
    }
    [Int]{}
}

// Collects every tracked (non-raw-word) storage global read and written
// transitively from `index`.
sema_effect_collect_tracked_storage_touches: fn(nodes: [SemaEffectNode], index: Int, raw_words: NameTable, seen: ^[Bool], visited: ^[Int], reads: ^[String], writes: ^[String]) Never! {
    if seen[index] -> return
    seen[index] = true
    visited.push(index)
    if nodes[index].rare == .Val(rare) {
        loop write in rare.module_writes {
            if write.storage && name_find(raw_words, write.name) == None && !writes.contains(write.name) {
                writes.push(write.name)
            }
        }
        loop read in rare.module_reads {
            if read.storage && name_find(raw_words, read.name) == None && !reads.contains(read.name) {
                reads.push(read.name)
            }
        }
    }
    calls: nodes[index].call_targets.len()
    loop position in 0..<(calls + sema_effect_node_value_count(nodes[index])) {
        target: if position < calls -> nodes[index].call_targets[position] else -> sema_effect_node_value_target(nodes[index], position - calls)
        if target < 0 -> next
        sema_effect_collect_tracked_storage_touches(nodes, target, raw_words, seen, visited, reads, writes)
    }
}

// Whether a `BodyCoreClosureKind.Spawn` is unscoped: either started outside
// any `task.group` (`group == None`) or spawned through a `Group` parameter
// (whose opener cannot see the child's borrows).
sema_effect_spawn_is_unscoped: fn(function: FnBody, group: Int?) -> Bool Never! {
    group_node: group ?? return true
    if body_node(function.tree, group_node).kind == .Local(local) {
        loop param in function.params {
            if param.name == local.name -> return true
        }
    }
    false
}

sema_effect_guest_export_storage_diagnostic: fn(nodes: [SemaEffectNode], path: [Int], raw_words: NameTable) -> Diagnostic {
    node: nodes[path[0]]
    leaf: nodes[path[path.len() - 1]]
    touch: sema_effect_node_tracked_storage_touch(leaf, raw_words) ?? TEffectSpan{name: leaf.name, span: node.name_span, storage: true}
    chain: loop step in path -> nodes[step].chain_name
    what: if path.len() == 1 -> "`#Export(c)` `{node.name}` uses changeable module state `{touch.name}`" else -> "`#Export(c)` `{node.name}` reaches changeable module state `{touch.name}`"
    why: if path.len() == 1 -> "a C host can call `#Export(c)` `{node.name}` on any thread, where accessing changeable module state `{touch.name}` would race Jet tasks" else -> "a C host can call `#Export(c)` `{node.name}` on any thread, and {chain.join(" → ")} touches changeable module state `{touch.name}`"
    diagnostic: sema_error("E3203", node.name_span, what, why, "pass `{touch.name}` as a parameter, keep shared state in `Shared{{…}}`, or confine every write to `{touch.name}` inside `#Unsafe`")
    diagnostic_with_rights(diagnostic, "export", chain, [String]{}, None)
}

sema_effect_unscoped_task_storage_diagnostic: fn(nodes: [SemaEffectNode], path: [Int], raw_words: NameTable, spawn_span: Span) -> Diagnostic {
    leaf: nodes[path[path.len() - 1]]
    touch: sema_effect_node_tracked_storage_touch(leaf, raw_words) ?? TEffectSpan{name: leaf.name, span: spawn_span, storage: true}
    chain: loop step in path -> nodes[step].chain_name
    why: "a task started outside a lexical `task.group` may outlive its starter and race other accesses to `{touch.name}` ({chain.join(" → ")})"
    diagnostic: sema_error("E1102", spawn_span, "this task reaches changeable module state `{touch.name}` through `{nodes[path[0]].chain_name}`", why, "spawn the task inside a `task.group`, pass `{touch.name}` in by value, or keep shared state in `Shared{{…}}`")
    diagnostic_with_rights(diagnostic, "task", chain, [String]{}, None)
}

sema_effect_combinator_write_diagnostic: fn(nodes: [SemaEffectNode], path: [Int], raw_words: NameTable, span: Span) -> Diagnostic {
    leaf: nodes[path[path.len() - 1]]
    write: sema_effect_node_tracked_storage_write(leaf, raw_words) ?? TEffectSpan{name: leaf.name, span: span, storage: true}
    chain: loop step in path -> nodes[step].chain_name
    why: "branches of `task.all`, `task.race`, and `task.any` run concurrently, and {chain.join(" → ")} writes changeable module state `{write.name}`"
    diagnostic: sema_error("E1101", span, "`{write.name}` cannot be written inside a concurrent task combinator", why, "read `{write.name}` only, move the write after the combinator, or share it with `Shared{{…}}`")
    diagnostic_with_rights(diagnostic, "task", chain, [String]{}, None)
}

sema_effect_para_write_diagnostic: fn(nodes: [SemaEffectNode], path: [Int], raw_words: NameTable, span: Span) -> Diagnostic {
    leaf: nodes[path[path.len() - 1]]
    write: sema_effect_node_tracked_storage_write(leaf, raw_words) ?? TEffectSpan{name: leaf.name, span: span, storage: true}
    chain: loop step in path -> nodes[step].chain_name
    why: "parallel workers run concurrently over items, and {chain.join(" → ")} writes changeable module state `{write.name}`"
    diagnostic: sema_error("E1101", span, "`{write.name}` cannot be written inside a parallel worker", why, "read `{write.name}` only, return values from the worker instead, or share it with `Shared{{…}}`")
    diagnostic_with_rights(diagnostic, "parallel worker", chain, [String]{}, None)
}

SemaEffectGroupChild: struct {
    binding: String?,
    span: Span,
    direct_reads: [String],
    direct_writes: [String],
    trans_reads: [String],
    trans_writes: [String],
}

// Collects every `CoreClosureCall(.Spawn(...))` node offset reachable inside a
// `TaskGroupAll` / `TaskGroupRace` / `TaskGroupAny` branch expression.
sema_effect_collect_combinator_spawns: fn(tree: BodyTree, node_id: Int, out: ^[Int:Bool]) Never! {
    offset: body_node_index(tree, node_id)
    node: tree.nodes[offset]
    if node.kind == .CoreClosureCall(closure_kind) {
        if closure_kind == .Spawn(_, _, _, _) {
            out[offset] = true
            return
        }
    }
    body_each_node_kind_child(tree, node.kind, fn(child: Int) { sema_effect_collect_combinator_spawns(tree, child, out) })
}

// Collects direct tracked storage reads and writes inside a BodyTree expression
// or statement block (for matching against transitive writes in `task.group`).
sema_effect_collect_direct_storage_in_expr: fn(tree: BodyTree, node_id: Int, tracked: NameTable, calls: SemaEffectCallIndex, reads: ^[String], writes: ^[String], skip_spawns: Bool) Never! {
    node: body_node(tree, node_id)
    if node.kind == .CoreClosureCall(closure_kind) {
        if skip_spawns && closure_kind == .Spawn(_, _, _, _) -> return
    }
    if node.kind == .ConstRef(symbol_id) {
        if sema_effect_run_key(calls.symbols, symbol_id) == .Val(key) {
            leaf: symbol_key_leaf(key)
            if name_find(tracked, leaf) != None && !reads.contains(leaf) -> reads.push(leaf)
        }
        return
    }
    if node.kind == .Lambda(lambda) {
        sema_effect_collect_direct_storage_in_lambda(tree, lambda, tracked, calls, reads, writes)
        return
    }
    body_each_node_kind_child(tree, node.kind, fn(child: Int) { sema_effect_collect_direct_storage_in_expr(tree, child, tracked, calls, reads, writes, skip_spawns) })
}

sema_effect_collect_direct_storage_in_lambda: fn(tree: BodyTree, lambda: BodyLambda, tracked: NameTable, calls: SemaEffectCallIndex, reads: ^[String], writes: ^[String]) Never! {
    if lambda.executable == {
        .Expr(value) -> sema_effect_collect_direct_storage_in_expr(tree, value, tracked, calls, reads, writes, false)
        .Block(body) -> {
            loop stmt_id in body {
                sema_effect_collect_direct_storage_in_stmt(tree, stmt_id, tracked, calls, reads, writes)
            }
        }
    }
}

sema_effect_collect_direct_storage_in_stmt: fn(tree: BodyTree, stmt_id: Int, tracked: NameTable, calls: SemaEffectCallIndex, reads: ^[String], writes: ^[String]) Never! {
    offset: stmt_id - tree.stmt_base
    if offset < 0 || offset >= tree.stmts.len() -> return
    statement: tree.stmts[offset]
    if statement == .Assign(place, _, value, _, _) {
        if place == .Expr(target_id) {
            if body_node(tree, target_id).kind == .Local(local) {
                if local.persist_key != None && name_find(tracked, local.name) != None && !writes.contains(local.name) {
                    writes.push(local.name)
                }
            }
        }
        sema_effect_collect_direct_storage_in_expr(tree, value, tracked, calls, reads, writes, false)
        return
    }
    body_each_stmt_child(tree, statement, fn(child: Int) { sema_effect_collect_direct_storage_in_expr(tree, child, tracked, calls, reads, writes, false) })
}

// Checks a single `task.group` body for data races involving at least one
// transitive storage global touch through a called function (direct-vs-direct
// races are already reported at expression spans in TaskGroups.jet), and for
// `.detach()` on a handle whose child transitively touches a storage global.
sema_effect_group_record_child: fn(tree: BodyTree, group_name: String, binding: String?, executable: BodyLambda, spawn_span: Span, in_loop: Bool, tracked: NameTable, nodes: [SemaEffectNode], calls: SemaEffectCallIndex, raw_words: NameTable, seen: ^[Bool], visited: ^[Int], children: ^[SemaEffectGroupChild], out: ^[Diagnostic]) Never! {
    ^direct_reads: [String]{}
    ^direct_writes: [String]{}
    ^trans_reads: [String]{}
    ^trans_writes: [String]{}
    sema_effect_collect_direct_storage_in_lambda(tree, executable, tracked, calls, direct_reads, direct_writes)
    loop edge in executable.effects.call_edges {
        target: sema_effect_node_index(calls.node_by_key, edge) ?? next
        sema_effect_collect_tracked_storage_touches(nodes, target, raw_words, seen, visited, trans_reads, trans_writes)
        loop row in visited -> seen[row] = false
        visited.clear()
    }
    if in_loop && trans_writes.len() > 0 {
        global_name: trans_writes[0]
        out.push(sema_error("E1101", spawn_span, "`{global_name}` is written by concurrent children of `{group_name}`", "each iteration spawns a child that calls a function writing changeable module state `{global_name}`, which holds the whole global and races sibling iterations", "move the write after `{group_name}` ends, or share `{global_name}` with `Shared{{…}}`"))
    }
    ^reported: name_table_sized(4)
    loop prev in children {
        loop g in trans_writes {
            if name_find(reported, g) == None && (prev.direct_reads.contains(g) || prev.direct_writes.contains(g) || prev.trans_reads.contains(g) || prev.trans_writes.contains(g)) {
                ^_: name_intern(reported, g)
                out.push(sema_error("E1101", spawn_span, "`{g}` is already lent to another task in `{group_name}`", "children of `{group_name}` run concurrently, and a write through a called function holds the whole global `{g}`", "move the write after `{group_name}` ends, pass values in, or share `{g}` with `Shared{{…}}`"))
            }
        }
        loop g in prev.trans_writes {
            if name_find(reported, g) == None && (direct_reads.contains(g) || direct_writes.contains(g) || trans_reads.contains(g) || trans_writes.contains(g)) {
                ^_: name_intern(reported, g)
                out.push(sema_error("E1101", spawn_span, "`{g}` is already lent to another task in `{group_name}`", "children of `{group_name}` run concurrently, and a write through a called function holds the whole global `{g}`", "move the write after `{group_name}` ends, pass values in, or share `{g}` with `Shared{{…}}`"))
            }
        }
        loop g in trans_reads {
            if name_find(reported, g) == None && prev.direct_writes.contains(g) {
                ^_: name_intern(reported, g)
                out.push(sema_error("E1101", spawn_span, "`{g}` is already lent to another task in `{group_name}`", "children of `{group_name}` run concurrently, so reading `{g}` through a call races a sibling child's write", "move the write after `{group_name}` ends, pass values in, or share `{g}` with `Shared{{…}}`"))
            }
        }
        loop g in direct_writes {
            if name_find(reported, g) == None && prev.trans_reads.contains(g) {
                ^_: name_intern(reported, g)
                out.push(sema_error("E1101", spawn_span, "`{g}` is already lent to another task in `{group_name}`", "children of `{group_name}` run concurrently, so writing `{g}` races a sibling child's read through a call", "move the write after `{group_name}` ends, pass values in, or share `{g}` with `Shared{{…}}`"))
            }
        }
    }
    children.push(SemaEffectGroupChild{binding: binding, span: spawn_span, direct_reads: direct_reads, direct_writes: direct_writes, trans_reads: trans_reads, trans_writes: trans_writes})
}

sema_effect_group_check_opener_expr: fn(tree: BodyTree, group_name: String, node_id: Int, tracked: NameTable, nodes: [SemaEffectNode], calls: SemaEffectCallIndex, raw_words: NameTable, seen: ^[Bool], visited: ^[Int], children: ^[SemaEffectGroupChild], in_loop: Bool, let_binding: String?, out: ^[Diagnostic]) Never! {
    node: body_node(tree, node_id)
    if node.kind == .CoreClosureCall(closure_kind) {
        if closure_kind == .Spawn(group, _, _, executable) {
            if group == .Val(group_id) {
                if body_node(tree, group_id).kind == .Local(local) && local.name == group_name {
                    sema_effect_group_record_child(tree, group_name, let_binding, executable, node.span, in_loop, tracked, nodes, calls, raw_words, seen, visited, children, out)
                    return
                }
            }
            return
        }
    }
    if node.kind == .HandleMethod(receiver_id, operation, _) && operation == BodyHandleOp.TaskDetach {
        if body_node(tree, receiver_id).kind == .Local(local) {
            loop child in children {
                if child.binding == Val(local.name) && child.direct_reads.len() == 0 && child.direct_writes.len() == 0 && (child.trans_reads.len() > 0 || child.trans_writes.len() > 0) {
                    out.push(sema_error("E1106", node.span, "can't detach task `{local.name}` — it borrows changeable module state through a call", "a detached task runs unsupervised and may outlive `{group_name}` and race accesses to module state", "join `{local.name}` inside `{group_name}`, pass the value in, or share it with `Shared{{…}}`"))
                    break
                }
            }
        }
    }
    if children.len() > 0 {
        if node.kind == .ConstRef(symbol_id) {
            if sema_effect_run_key(calls.symbols, symbol_id) == .Val(key) {
                leaf: symbol_key_leaf(key)
                if name_find(tracked, leaf) != None {
                    loop child in children {
                        if child.trans_writes.contains(leaf) {
                            out.push(sema_error("E1101", node.span, "`{leaf}` cannot be read while a child of `{group_name}` writes it", "a running child of `{group_name}` calls a function writing `{leaf}`, so reading `{leaf}` here would race that child", "read `{leaf}` after the `{group_name}` block ends, or share it with `Shared{{…}}`"))
                            break
                        }
                    }
                }
            }
            return
        }
        ^callee_node: -1
        if node.kind == .Call(callee_decl, _, _) {
            callee_node = sema_effect_decl_node(calls, callee_decl)
        } else if node.kind == .MethodCall(_, method, _, _) {
            if sema_effect_run_key(calls.symbols, method.symbol) == .Val(key) {
                callee_node = sema_effect_node_index(calls.node_by_key, key) ?? -1
            }
        }
        if callee_node >= 0 {
            ^op_reads: [String]{}
            ^op_writes: [String]{}
            sema_effect_collect_tracked_storage_touches(nodes, callee_node, raw_words, seen, visited, op_reads, op_writes)
            loop row in visited -> seen[row] = false
            visited.clear()
            ^hit: false
            loop child in children {
                loop g in op_writes {
                    if child.direct_reads.contains(g) || child.direct_writes.contains(g) || child.trans_reads.contains(g) || child.trans_writes.contains(g) {
                        out.push(sema_error("E1101", node.span, "`{g}` cannot be written while `{group_name}` has children using it", "this call writes changeable module state `{g}` while a child of `{group_name}` runs concurrently", "call this after `{group_name}` ends, or share `{g}` with `Shared{{…}}`"))
                        hit = true
                        break
                    }
                }
                if hit -> break
                loop g in op_reads {
                    if child.direct_writes.contains(g) || child.trans_writes.contains(g) {
                        out.push(sema_error("E1101", node.span, "`{g}` cannot be read while a child of `{group_name}` writes it", "this call reads changeable module state `{g}` while a child of `{group_name}` writes it concurrently", "call this after `{group_name}` ends, or share `{g}` with `Shared{{…}}`"))
                        hit = true
                        break
                    }
                }
                if hit -> break
            }
        }
    }
    body_each_node_kind_child(tree, node.kind, fn(child: Int) { sema_effect_group_check_opener_expr(tree, group_name, child, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, None, out) })
}

sema_effect_group_check_stmts: fn(tree: BodyTree, group_name: String, stmts: [Int], tracked: NameTable, nodes: [SemaEffectNode], calls: SemaEffectCallIndex, raw_words: NameTable, seen: ^[Bool], visited: ^[Int], children: ^[SemaEffectGroupChild], in_loop: Bool, out: ^[Diagnostic]) Never! {
    loop stmt_id in stmts {
        offset: stmt_id - tree.stmt_base
        if offset < 0 || offset >= tree.stmts.len() -> next
        statement: tree.stmts[offset]
        if statement == {
            .TaskGroup(_, _, _, _) -> next
            .Let(local, _, init_id, _, _, _) -> {
                sema_effect_group_check_opener_expr(tree, group_name, init_id, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, Val(local.name), out)
            }
            .Assign(place, _, value, _, span) -> {
                if children.len() > 0 && place == .Expr(target_id) {
                    if body_node(tree, target_id).kind == .Local(local) && local.persist_key != None && name_find(tracked, local.name) != None {
                        loop child in children {
                            if child.trans_reads.contains(local.name) || child.trans_writes.contains(local.name) {
                                out.push(sema_error("E1101", span, "`{local.name}` cannot be written while a child of `{group_name}` uses it", "a running child of `{group_name}` accesses `{local.name}` through a call, so writing `{local.name}` here would race that child", "write `{local.name}` after the `{group_name}` block ends, or share it with `Shared{{…}}`"))
                                break
                            }
                        }
                    }
                }
                sema_effect_group_check_opener_expr(tree, group_name, value, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, None, out)
            }
            .If(condition, then_body, else_body, _, _) -> {
                body_each_if_cond_child(tree, condition, fn(child: Int) { sema_effect_group_check_opener_expr(tree, group_name, child, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, None, out) })
                sema_effect_group_check_stmts(tree, group_name, then_body, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, out)
                if else_body == .Val(else_stmts) {
                    sema_effect_group_check_stmts(tree, group_name, else_stmts, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, out)
                }
            }
            .Loop(_, body, _) -> {
                sema_effect_group_check_stmts(tree, group_name, body, tracked, nodes, calls, raw_words, seen, visited, children, true, out)
            }
            .While(_, condition, body, _) -> {
                sema_effect_group_check_opener_expr(tree, group_name, condition, tracked, nodes, calls, raw_words, seen, visited, children, true, None, out)
                sema_effect_group_check_stmts(tree, group_name, body, tracked, nodes, calls, raw_words, seen, visited, children, true, out)
            }
            .ForRange(_, _, start_id, end_id, step_id, _, body, _, _) -> {
                sema_effect_group_check_opener_expr(tree, group_name, start_id, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, None, out)
                sema_effect_group_check_opener_expr(tree, group_name, end_id, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, None, out)
                if step_id == .Val(sid) -> sema_effect_group_check_opener_expr(tree, group_name, sid, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, None, out)
                sema_effect_group_check_stmts(tree, group_name, body, tracked, nodes, calls, raw_words, seen, visited, children, true, out)
            }
            .ForIn(_, _, _, source_id, coll_id, step_id, _, _, _, _, body, _) -> {
                sema_effect_group_check_opener_expr(tree, group_name, source_id, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, None, out)
                sema_effect_group_check_opener_expr(tree, group_name, coll_id, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, None, out)
                if step_id == .Val(sid) -> sema_effect_group_check_opener_expr(tree, group_name, sid, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, None, out)
                sema_effect_group_check_stmts(tree, group_name, body, tracked, nodes, calls, raw_words, seen, visited, children, true, out)
            }
            .CountedLoop(_, init_stmt, cond_id, step_stmt, _, body, _) -> {
                sema_effect_group_check_stmts(tree, group_name, [Int]{init_stmt}, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, out)
                sema_effect_group_check_opener_expr(tree, group_name, cond_id, tracked, nodes, calls, raw_words, seen, visited, children, true, None, out)
                if step_stmt == .Val(s_id) -> sema_effect_group_check_stmts(tree, group_name, [Int]{s_id}, tracked, nodes, calls, raw_words, seen, visited, children, true, out)
                sema_effect_group_check_stmts(tree, group_name, body, tracked, nodes, calls, raw_words, seen, visited, children, true, out)
            }
            .ExprStmt(value, _) -> {
                sema_effect_group_check_opener_expr(tree, group_name, value, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, None, out)
            }
            .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .Inline(body, _) | .DebugOnly(body, _) | .DeepCheck(body, _) | .SentryPolicy(_, body, _) | .Impure(body, _) | .Region(body, _) | .Layout(_, _, body, _) | .ContextBlock(_, body, _) | .Live(body, _) | .Shield(body, _) | .Defer(body, _) | .ScopeMember(_, body, _) | .Transact(_, _, _, body, _) | .ContractScope(_, body, _, _, _) -> {
                sema_effect_group_check_stmts(tree, group_name, body, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, out)
            }
            .Contract(_) | .RefutableBind(_, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .Return(_, _) | .DeferClose(_, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .Match(_, _, _, _) | .EnumMatch(_, _, _, _, _) | .RangeSwitch(_, _, _, _) | .MixedSwitch(_, _, _, _, _) | .Reactive(_, _) | .GCEdit(_, _, _, _, _, _, _) -> {
                body_each_stmt_child(tree, statement, fn(child: Int) { sema_effect_group_check_opener_expr(tree, group_name, child, tracked, nodes, calls, raw_words, seen, visited, children, in_loop, None, out) })
            }
        }
    }
}

// Checks `#Export(c)`, combinator branches, parallel collection callbacks,
// unscoped task spawns, and lexical `task.group` transitive races against
// tracked (non-raw-word) changeable module storage globals.
sema_effect_check_storage_concurrency: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], nodes: [SemaEffectNode], calls: SemaEffectCallIndex, raw_words: NameTable, state_seen: ^[Bool], state_visited: ^[Int], diagnostics: ^[Diagnostic]) {
    // 1. `#Export(c)` functions may be called by a C host on any thread, so
    // touching any non-raw-word storage global (directly or transitively) is E3203.
    loop node_index in 0..<nodes.len() {
        if !nodes[node_index].is_guest_export -> next
        touch_path: sema_effect_tracked_storage_touch_path(nodes, node_index, raw_words, state_seen, state_visited)
        loop row in state_visited -> state_seen[row] = false
        state_visited.clear()
        if touch_path.len() == 0 -> next
        ^export_diagnostics: [Diagnostic]{sema_effect_guest_export_storage_diagnostic(nodes, touch_path, raw_words)}
        sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, export_diagnostics)
    }
    // Collect all tracked storage global names referenced in the program for
    // matching direct reads/writes inside `task.group` bodies.
    ^tracked_names: name_table_sized(8)
    loop node in nodes {
        rare: node.rare ?? next
        loop write in rare.module_writes {
            if write.storage && name_find(raw_words, write.name) == None -> ^_: name_intern(tracked_names, write.name)
        }
        loop read in rare.module_reads {
            if read.storage && name_find(raw_words, read.name) == None -> ^_: name_intern(tracked_names, read.name)
        }
    }
    if name_count(tracked_names) == 0 -> return
    // 2-5. Task combinators, parallel callbacks, unscoped spawns, and lexical
    // `task.group` transitive races.
    loop input_index in 0..<inputs.len() {
        module_row: inputs[input_index]
        ^module_diags: [Diagnostic]{}
        loop function in modules[module_row.module_index].functions {
            ^combinator_spawns: [Int:Bool]{}
            loop body_node in function.tree.nodes {
                if body_node.kind == {
                    .TaskGroupAll(tasks) | .TaskGroupRace(tasks) | .TaskGroupAny(tasks) -> {
                        sema_effect_collect_combinator_spawns(function.tree, tasks, combinator_spawns)
                    }
                    .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
                }
            }
            loop (node_offset, item_node) in function.tree.nodes {
                if item_node.kind == .CoreClosureCall(closure_kind) {
                    if closure_kind == .Spawn(group, _, _, executable) {
                        if combinator_spawns.get(node_offset) != None {
                            loop edge in executable.effects.call_edges {
                                target: sema_effect_node_index(calls.node_by_key, edge) ?? next
                                write_path: sema_effect_tracked_storage_write_path(nodes, target, raw_words, state_seen, state_visited)
                                loop row in state_visited -> state_seen[row] = false
                                state_visited.clear()
                                if write_path.len() == 0 -> next
                                module_diags.push(sema_effect_combinator_write_diagnostic(nodes, write_path, raw_words, item_node.span))
                                break
                            }
                            next
                        }
                        if !sema_effect_spawn_is_unscoped(function, group) -> next
                        loop edge in executable.effects.call_edges {
                            target: sema_effect_node_index(calls.node_by_key, edge) ?? next
                            touch_path: sema_effect_tracked_storage_touch_path(nodes, target, raw_words, state_seen, state_visited)
                            loop row in state_visited -> state_seen[row] = false
                            state_visited.clear()
                            if touch_path.len() == 0 -> next
                            module_diags.push(sema_effect_unscoped_task_storage_diagnostic(nodes, touch_path, raw_words, item_node.span))
                            break
                        }
                    }
                } else if item_node.kind == .ClosureMethod(_, operation, args) {
                    is_para: operation == TClosureOp.ParaMap || operation == TClosureOp.ParaFilter || operation == TClosureOp.ParaPartition || operation == TClosureOp.ParaFold
                    if !is_para -> next
                    loop arg_id in args {
                        arg_node: body_node(function.tree, arg_id)
                        if arg_node.kind == .Lambda(cb_lambda) {
                            loop edge in cb_lambda.effects.call_edges {
                                target: sema_effect_node_index(calls.node_by_key, edge) ?? next
                                write_path: sema_effect_tracked_storage_write_path(nodes, target, raw_words, state_seen, state_visited)
                                loop row in state_visited -> state_seen[row] = false
                                state_visited.clear()
                                if write_path.len() == 0 -> next
                                module_diags.push(sema_effect_para_write_diagnostic(nodes, write_path, raw_words, arg_node.span))
                                break
                            }
                        } else if arg_node.kind == .FnValue(fn_val) {
                            if fn_val == .NamedFn(decl_opt, _) {
                                if decl_opt == .Val(decl_id) {
                                    target: sema_effect_decl_node(calls, decl_id)
                                    if target >= 0 {
                                        write_path: sema_effect_tracked_storage_write_path(nodes, target, raw_words, state_seen, state_visited)
                                        loop row in state_visited -> state_seen[row] = false
                                        state_visited.clear()
                                        if write_path.len() > 0 {
                                            module_diags.push(sema_effect_para_write_diagnostic(nodes, write_path, raw_words, arg_node.span))
                                        }
                                    }
                                }
                            }
                        } else if arg_node.kind == .ConstRef(symbol_id) {
                            if sema_effect_run_key(calls.symbols, symbol_id) == .Val(key) {
                                if sema_effect_node_index(calls.node_by_key, key) == .Val(target) {
                                    write_path: sema_effect_tracked_storage_write_path(nodes, target, raw_words, state_seen, state_visited)
                                    loop row in state_visited -> state_seen[row] = false
                                    state_visited.clear()
                                    if write_path.len() > 0 {
                                        module_diags.push(sema_effect_para_write_diagnostic(nodes, write_path, raw_words, arg_node.span))
                                    }
                                }
                            }
                        }
                    }
                }
            }
            loop statement in function.tree.stmts {
                if statement == .TaskGroup(group_local, _, body, _) {
                    ^children: [SemaEffectGroupChild]{}
                    sema_effect_group_check_stmts(function.tree, group_local.name, body, tracked_names, nodes, calls, raw_words, state_seen, state_visited, children, false, module_diags)
                }
            }
        }
        if module_diags.len() > 0 {
            sema_effect_publish_diagnostics(diagnostics, module_row.source_segments, module_diags)
        }
    }
}

// A comptime input call (`embed_file`, `embed_bytes`, `find`, `net.fetch`)
// at `node`, charged to `node_index` once per call span.
sema_effect_record_comptime_input: fn(nodes: ^[SemaEffectNode], node_index: Int, node: BodyNode) Never! {
    if node.kind == .HostCall(call) {
        if call == .ComptimeInput(builtin, _, _) {
            sema_effect_node_rare_open(nodes[node_index])
            if nodes[node_index].rare.in_place() == .Val(rare) {
                loop seen in rare.comptime_inputs {
                    if seen.span.start == node.span.start && seen.span.end == node.span.end {
                        return
                    }
                }
                name: if builtin == "fetch" -> "net.fetch" else -> builtin
                rare.comptime_inputs.push(TEffectSpan{name: name, span: node.span})
            }
        }
    }
}

// A task context read at `node`, charged to `node_index` once per field
// (`context.<field>`) or key (`context.get(key)`), or a call through a
// function value that is not a lambda this body writes
// (sema_effect_local_lambda_call), whose callee's reads the graph can't
// follow. `context.scratch` is no read: as an allocator guard, or as the
// view of the task's arena a call allocates from, it names where values
// are made, not what they are.
sema_effect_record_context: fn(interner: Interner, nodes: ^[SemaEffectNode], node_index: Int, tree: BodyTree, node: BodyNode) Never! {
    if node.kind == .HostCall(call) {
        if call == {
            .ContextRead(field) -> {
                if field == "scratch" {
                    return
                }
                sema_effect_node_rare_open(nodes[node_index])
                if nodes[node_index].rare.in_place() == .Val(rare) {
                    if !rare.context_reads.contains(field) -> rare.context_reads.push(field.copy())
                }
            }
            .ContextGet(key, default, equatable) -> {
                sema_effect_node_rare_open(nodes[node_index])
                if nodes[node_index].rare.in_place() == .Val(rare) {
                    sema_effect_add_context_key(rare.context_keys, TEffectContextKey{key: key.copy(), ty: body_type(interner, tree, default), equatable: equatable})
                }
            }
            .Method(_, _, _) | .CellGuardProject(_, _, _, _, _) | .OptionProbe(_, _) | .TupleIndex(_, _) | .SwitchSubjectValue | .YieldSend(_) | .NumericBounds(_, _) | .ComptimeInput(_, _, _) | .MemoStats(_, _) | .DebugTrace(_) -> {}
        }
        return
    }
    if node.kind == .IndirectCall(_, _, _, _) && !sema_effect_local_lambda_call(tree, node.kind) {
        nodes[node_index].context_open = true
    }
}

sema_effect_add_context_key: fn(keys: ^[TEffectContextKey], read: ^^TEffectContextKey) Never! {
    loop known in keys {
        if known.key == read.key {
            return
        }
    }
    keys.push(read)
}

// The task context the function at `root` can read: each field
// (`context.<field>`, in the order of sema_context_read_fields, then
// `trace`) and each key (`context.get(key)`, in first-read order) a body it
// reaches reads, following its calls and the functions it takes as values.
// When a reached body calls code the graph can't follow (an unknown callee
// (maximal), an unbounded trait or type-parameter dispatch, or a function
// value), it is the whole context: every field, `trace` when any body of
// the program reads it, and every key any body of the program reads. A
// `#Memo` function's key holds each one beside its arguments (IR
// BuildMemo.jet).
sema_effect_context_reach: fn(nodes: [SemaEffectNode], root: Int, facts: ^TEffectFacts) Never! {
    every: sema_context_read_fields()
    ^read: [String]{}
    ^keys: [TEffectContextKey]{}
    ^seen: (loop _ in nodes -> false)
    seen[root] = true
    ^pending: [Int]{root}
    ^cursor: 0
    loop cursor < pending.len() {
        index: pending[cursor]
        cursor += 1
        rare: nodes[index].rare ?? SEMA_EFFECT_NODE_NO_RARE
        if nodes[index].context_open || nodes[index].maximal || nodes[index].dispatches.len() > 0 || rare.param_dispatches.len() > 0 {
            facts.context = every
            ^all_keys: [TEffectContextKey]{}
            ^traced: false
            loop node in nodes {
                held: node.rare ?? next
                loop key in held.context_keys -> sema_effect_add_context_key(all_keys, key.copy())
                if held.context_reads.contains("trace") -> traced = true
            }
            if traced -> facts.context.push("trace")
            facts.context_keys = all_keys
            return
        }
        loop field in rare.context_reads {
            if !read.contains(field) -> read.push(field.copy())
        }
        loop key in rare.context_keys -> sema_effect_add_context_key(keys, key.copy())
        calls: nodes[index].call_targets.len()
        loop position in 0..<(calls + rare.value_targets.len()) {
            target: if position < calls -> nodes[index].call_targets[position] else -> rare.value_targets[position - calls]
            if target < 0 -> next
            if seen[target] -> next
            seen[target] = true
            pending.push(target)
        }
    }
    ^fields: loop field in every if read.contains(field) -> field
    if read.contains("trace") -> fields.push("trace")
    facts.context = fields
    facts.context_keys = keys
}

// The compiler answers a comptime input while it compiles, so the running
// program must never reach one. The runtime entries are the functions that
// nothing names: no function calls or takes them as a value, no
// compile-time site (a comptime item, a `#run {}` site or a module value,
// SemaCallSiteFact.compile_time) calls them, and the build did not check them to
// run while compiling (`prep_functions`, a comptime item's callees). That is
// `run`, a test, a job and a callback a host names; `build`, which runs while
// building, is not one. A function that only compile-time sites or prep code
// name is prep code. The result holds, for each function the entries reach
// that makes an input, the call path from an entry to it, entry first
// (E0956).
sema_effect_runtime_input_paths: fn(nodes: [SemaEffectNode], modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], prep_functions: NameTable, symbols: SymbolTable) -> [[Int]] Never! {
    ^paths: [[Int]]{}
    any: loop node in nodes {
        if node.rare == .Val(rare) && rare.comptime_inputs.len() > 0 {
            break true
        }
    } ?? false
    if !any -> return paths
    ^comptime_callees: prep_functions.copy()
    loop module_row in inputs {
        loop fact in modules[module_row.module_index].call_facts {
            if !fact.compile_time -> next
            callee: fact.callee ?? next
            key: sema_effect_run_key(symbols, callee) ?? next
            ^_: name_intern(comptime_callees, key)
        }
    }
    ^named: (loop _ in nodes -> false)
    loop (index, node) in nodes {
        calls: node.call_targets.len()
        loop position in 0..<(calls + sema_effect_node_value_count(node)) {
            target: if position < calls -> node.call_targets[position] else -> sema_effect_node_value_target(node, position - calls)
            if target < 0 -> next
            if target != index -> named[target] = true
        }
    }
    // -2: not reached; -1: an entry; else the caller it was reached from.
    ^parent: (loop _ in nodes -> -2)
    ^queue: [Int]{}
    loop (index, node) in nodes {
        if named[index] || name_find(comptime_callees, node.key) != None || node.chain_name == "build" {
            next
        }
        parent[index] = -1
        queue.push(index)
    }
    ^head: 0
    loop head < queue.len() {
        index: queue[head]
        head += 1
        calls: nodes[index].call_targets.len()
        loop position in 0..<(calls + sema_effect_node_value_count(nodes[index])) {
            target: if position < calls -> nodes[index].call_targets[position] else -> sema_effect_node_value_target(nodes[index], position - calls)
            if target < 0 -> next
            if parent[target] != -2 -> next
            parent[target] = index
            queue.push(target)
        }
    }
    loop index in queue {
        rare: nodes[index].rare ?? next
        if rare.comptime_inputs.len() == 0 -> next
        ^path: [Int]{index}
        ^step: parent[index]
        loop step >= 0 {
            path.push(step)
            step = parent[step]
        }
        path.reverse()
        paths.push(path)
    }
    paths
}

// A comptime input a runtime entry reaches: `path` runs from the entry to
// the function that makes the call (sema_effect_runtime_input_paths), and
// the report points at the call.
sema_effect_runtime_input_diagnostic: fn(nodes: [SemaEffectNode], path: [Int], input: TEffectSpan) -> Diagnostic {
    maker: nodes[path[path.len() - 1]].chain_name
    if path.len() == 1 {
        return sema_error("E0956", input.span, "`{maker}` runs in the program, so it can't call `{input.name}`", "the compiler answers `{input.name}` while it compiles, and nothing calls `{maker}` at compile time, so the call would run in the program", "call `{input.name}` from a prepared constant (`NAME: #run {{ … }}`) and read that value at run time")
    }
    chain: loop step in path -> nodes[step].chain_name
    sema_error("E0956", input.span, "`{maker}` calls `{input.name}`, and the running program reaches `{maker}` from `{chain[0]}`", "the call path {chain.join(" → ")} runs in the program, and the compiler answers `{input.name}` only while it compiles", "call `{maker}` only from compile-time code, such as a prepared constant (`NAME: #run {maker}()`), and read that value at run time")
}

// Code handed the root's `Compiler` value runs while the build runs and acts
// through the value: a function that takes it (a hook, as `install: fn(meta:
// Compiler)` is) and a `meta.events` handler, which takes the
// `CompilerEvent` the value hears. Such code launches no process (E3410), so
// it can't start another compiler run with authority of its own; the report
// names the hook and the call path to the launch. Build code that takes no
// value, `#Impure` build code and declared steps (`b.run`, which the build
// runs after its `build: fn` returns) are never held to this.
sema_effect_check_compiler_hooks: fn(table: ModuleTable, modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], nodes: [SemaEffectNode], node_by_key: SemaEffectNodeKeys, solved: [[String]], diagnostics: ^[Diagnostic]) {
    launch: [String]{"Exec"}
    // A hook's own report covers the handlers it registers, whose calls are
    // its calls.
    ^reported: (loop _ in nodes -> false)
    loop module_row in inputs {
        loop function in modules[module_row.module_index].functions {
            ^taken: String?{None}
            loop parameter in function.params {
                if parameter.ty == .Named(name) {
                    if name == "Compiler" {
                        taken = Val("Compiler")
                        break
                    }
                    if name == "CompilerEvent" || name == "<corelib>/core.prelude.CompilerEvent" {
                        taken = Val("CompilerEvent")
                        break
                    }
                }
            }
            hook_param: taken ?? next
            node_index: sema_effect_node_index(node_by_key, function.key) ?? next
            if sema_effect_covered(solved[node_index], launch).len() == 0 -> next
            reported[node_index] = true
            ^seen: (loop _ in nodes -> false)
            path: sema_effect_launch_path(nodes, solved, node_index, seen)
            chain: loop step in path -> sema_effect_launch_step_name(table, nodes[step])
            ^hook_diagnostics: [Diagnostic]{sema_effect_compiler_hook_diagnostic("`{nodes[node_index].name}`", hook_param, chain, nodes[node_index].name_span)}
            sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, hook_diagnostics)
        }
    }
    loop node_index in 0..<nodes.len() {
        if reported[node_index] -> next
        rare: nodes[node_index].rare ?? next
        loop hook in rare.hook_lambdas {
            ^inferred: hook.direct.copy()
            if hook.maximal -> sema_effect_set_union(inferred, authority_grantable_roots())
            loop edge in hook.call_edges {
                target: sema_effect_node_index(node_by_key, edge) ?? next
                sema_effect_set_union(inferred, solved[target])
            }
            if sema_effect_covered(inferred, launch).len() == 0 -> next
            ^chain: [String]{if hook.taken == "CompilerEvent" -> "meta.events handler" else -> "lambda"}
            if sema_effect_covered(hook.direct, launch).len() == 0 {
                ^seen: (loop _ in nodes -> false)
                loop edge in hook.call_edges {
                    target: sema_effect_node_index(node_by_key, edge) ?? next
                    if sema_effect_covered(solved[target], launch).len() == 0 -> next
                    loop step in sema_effect_launch_path(nodes, solved, target, seen) {
                        chain.push(sema_effect_launch_step_name(table, nodes[step]))
                    }
                    break
                }
            }
            subject: if hook.taken == "CompilerEvent" -> "The `meta.events` handler" else -> "The lambda"
            ^hook_diagnostics: [Diagnostic]{sema_effect_compiler_hook_diagnostic(subject, hook.taken, chain, hook.span)}
            sema_effect_publish_diagnostics(diagnostics, inputs[nodes[node_index].module_index].source_segments, hook_diagnostics)
        }
    }
}

// The compiler value type a function or lambda with parameter types `params`
// takes: the host's `Compiler`, or the Prelude's `CompilerEvent` a
// `meta.events` handler hears. A program type of either name is
// module-qualified, so it is neither.
sema_effect_compiler_hook_param: fn(params: [Type]) -> String? Never! {
    loop param in params {
        if param == .Named(name) {
            if name == "Compiler" -> return Val("Compiler")
            if name == "CompilerEvent" || name == "<corelib>/core.prelude.CompilerEvent" {
                return Val("CompilerEvent")
            }
        }
    }
    None
}

// The call path from `index` to the process launch its solved row reaches:
// the functions it calls whose rows reach it, depth-first, up to the one
// that launches directly or the Core function it calls to, both ends
// included.
sema_effect_launch_path: fn(nodes: [SemaEffectNode], solved: [[String]], index: Int, seen: ^[Bool]) -> [Int] Never! {
    if seen[index] -> return [Int]{}
    seen[index] = true
    launch: [String]{"Exec"}
    if module_is_core(nodes[index].module_identity) || nodes[index].maximal || sema_effect_covered(nodes[index].direct, launch).len() > 0 {
        return [Int]{index}
    }
    loop target in nodes[index].call_targets {
        if target < 0 -> next
        if sema_effect_covered(solved[target], launch).len() == 0 -> next
        rest: sema_effect_launch_path(nodes, solved, target, seen)
        if rest.len() == 0 -> next
        ^path: [Int]{index}
        loop step in rest -> path.push(step)
        return path
    }
    [Int]{index}
}

// A launch path step as the report names it: a Core function by its module
// (`core.process.call`), any other by its chain name.
sema_effect_launch_step_name: fn(table: ModuleTable, node: SemaEffectNode) -> String Never! {
    if module_is_core(node.module_identity) {
        return "{module_text(table, node.module_identity).removeprefix("<corelib>/")}.{node.chain_name}"
    }
    node.chain_name
}

// E3410 at the hook (`subject`, which takes the `taken` compiler value type)
// whose call path `chain` launches a process.
sema_effect_compiler_hook_diagnostic: fn(subject: String, taken: String, chain: [String], span: Span) -> Diagnostic {
    holds: if taken == "CompilerEvent" -> "hears the root's `Compiler` value" else -> "takes the root's `Compiler` value"
    diagnostic: sema_error("E3410", span, "{subject} {holds} and launches a process through {chain.join(" → ")}", "code handed the `Compiler` value runs while the build runs and acts only through the value; a process it launched would run another program, such as a second compiler, with authority of its own", "act through the `Compiler` value, or declare the process as a build step (`b.run`) in the root's `build: fn`")
    diagnostic_with_rights(diagnostic, "invocation", chain, [String]{}, None)
}

// A module or type cap as one checked function meets it. `site` names where
// the cap is written (`run.jet:1`) when it isn't in the function's own file;
// a cap in the function's file is labeled in the report.
SemaEffectModuleCap: struct {
    cap: ModuleCap,
    site: String?,
}

// A struct's, enum's or trait's cap and the module that declares it.
SemaEffectTypeCap: struct {
    module_identity: ModuleID,
    cap: SemaEffectModuleCap,
}

// A module's or type's `#FX(…)` cap over one function: the function-row rule,
// with plain entries as a ceiling and `!` entries as denials, both E0749 and
// both holding through every callee the function can reach. A bare `#FX` is
// the empty ceiling, so the function is pure. A row the function declares
// may only narrow the cap, so a declared effect outside it is E0749 too, even
// when the body doesn't use it. Names were validated once per cap
// (sema_effect_module_cap_names).
sema_effect_check_module_cap: fn(nodes: [SemaEffectNode], node_index: Int, solved: [String], cap: SemaEffectModuleCap, notes: [SemaEffectInstanceNote], stack: ^SemaStackWalk, frames: SemaStackFrames, diagnostics: ^[Diagnostic]) {
    node: nodes[node_index]
    loop entry in cap.cap.entries {
        if !entry.name.starts_with("!") -> next
        effect_name: sema_effect_parse_name(entry.name.slice(1, entry.name.len())) ?? next
        if sema_effect_stack_bound(effect_name) != None {
            span: if cap.site == None -> entry.span else -> node.name_span
            sema_effect_check_stack(stack, frames, nodes, node_index, EffectRowEntry{name: effect_name, span: span}, "cap `#FX({entry.name})` over {node.display_key}", diagnostics)
            next
        }
        if sema_effect_memory_fact(effect_name) == .Val(fact) {
            span: if cap.site == None -> entry.span else -> node.name_span
            _: sema_effect_memory_project(nodes, node_index, EffectRowEntry{name: effect_name, span: span}, fact, diagnostics)
            next
        }
        reached: sema_effect_covered_one(solved, effect_name)
        if reached.len() == 0 {
            declared: sema_effect_declared_hits(node.declared, effect_name)
            if declared.len() > 0 {
                diagnostics.push(sema_effect_module_row_denied_diagnostic(node, declared, effect_name, cap))
            }
            next
        }
        ^panic_steps: [String]{}
        if sema_effect_root(effect_name) == "Panic" {
            panic_steps = sema_effect_panic_steps(nodes, node_index)
        }
        ^unsafe_reach: SemaEffectUnsafeReach?{None}
        if sema_effect_root(effect_name) == "Unsafe" {
            unsafe_reach = Val(sema_effect_unsafe_reach(nodes, node_index))
        }
        diagnostics.push(sema_effect_with_instance_notes(sema_effect_module_denied_diagnostic(node, reached, effect_name, panic_steps, unsafe_reach, cap), notes, reached))
    }
    ceiling: sema_effect_cap_ceiling(cap.cap) ?? return
    ^over: sema_effect_uncovered(solved, ceiling)
    if over.len() > 0 {
        over.sort()
        diagnostics.push(sema_effect_with_instance_notes(sema_effect_module_ceiling_diagnostic(node, over, ceiling, cap), notes, over))
        return
    }
    wider: sema_effect_uncovered(node.declared, ceiling)
    if wider.len() > 0 {
        diagnostics.push(sema_effect_module_row_ceiling_diagnostic(node, wider, ceiling, cap))
    }
}

// The declared effects that overlap `denied`: the denied effect itself, a
// leaf under it, or a root above it (a row granting `FS` grants `FS.Read`).
sema_effect_declared_hits: fn(declared: [String], denied: String) -> [String] Never! {
    ^hits: [String]{}
    loop effect_name in declared {
        if sema_effect_covers(denied, effect_name) || sema_effect_covers(effect_name, denied) {
            sema_effect_set_add(hits, effect_name)
        }
    }
    hits
}

sema_effect_module_row_denied_diagnostic: fn(node: SemaEffectNode, declared: [String], denied: String, cap: SemaEffectModuleCap) -> Diagnostic {
    name: sema_inline_member_source_name(node.name)
    scope: cap.cap.scope
    owner: cap.cap.owner
    declared_list: sema_effect_show(declared)
    diagnostic: sema_error(sema_effect_cap_code(cap), node.row_span ?? node.name_span, "`{name}`'s row declares `{declared_list}`, which {scope} `{owner}` denies", "a row written inside a cap may only narrow it; the {scope}'s `#FX(…)` cap denies `{denied}` to {sema_effect_cap_members(cap)}{sema_effect_module_cap_where(cap)}", "drop `{declared_list}` from `{name}`'s row, {sema_effect_cap_move(name, cap)}or drop `!{denied}` from the {scope}'s `#FX(…)` cap")
    sema_effect_module_cap_report(diagnostic, [String]{name}, cap)
}

sema_effect_module_row_ceiling_diagnostic: fn(node: SemaEffectNode, wider: ^^[String], ceiling: [String], cap: SemaEffectModuleCap) -> Diagnostic {
    name: sema_inline_member_source_name(node.name)
    scope: cap.cap.scope
    owner: cap.cap.owner
    ^sorted: wider
    sorted.sort()
    wider_list: sema_effect_show(sorted)
    narrow: if ceiling.len() == 0 -> "write `-[]>` as `{name}`'s row" else -> "narrow `{name}`'s row to `{sema_effect_show(ceiling)}`"
    diagnostic: sema_error(sema_effect_cap_code(cap), node.row_span ?? node.name_span, "`{name}`'s row declares `{wider_list}`, which {scope} `{owner}`'s `#FX(…)` cap doesn't allow", "a row written inside a cap may only narrow it; the {scope}'s cap allows {sema_effect_cap_allows(ceiling)} in {sema_effect_cap_members(cap)}{sema_effect_module_cap_where(cap)}", "{narrow}, or add `{wider_list}` to the {scope}'s `#FX(…)` cap")
    sema_effect_module_cap_report(diagnostic, [String]{name}, cap)
}

// What a cap's ceiling admits, for the reports above: a bare `#FX` admits
// nothing.
sema_effect_cap_allows: fn(ceiling: [String]) -> String Never! {
    if ceiling.len() == 0 -> return "no effects"
    "only `{sema_effect_show(ceiling)}`"
}

sema_effect_module_cap_where: fn(cap: SemaEffectModuleCap) -> String Never! {
    if cap.site == .Val(site) -> return "; the cap is written at `{site}`"
    ""
}

// Who the cap binds: a module's functions, a type's methods or the
// implementations of a trait's methods.
sema_effect_cap_members: fn(cap: SemaEffectModuleCap) -> String Never! {
    if cap.cap.scope == "type" -> return "every method of the type"
    if cap.cap.scope == "trait" -> return "every implementation of the trait's methods"
    "every function inside it"
}

// A trait's cap binds implementations written in any package, so it is its
// own code; a module's or a type's is E0749.
sema_effect_cap_code: fn(cap: SemaEffectModuleCap) -> String Never! {
    if cap.cap.scope == "trait" -> return "E0754"
    "E0749"
}

// The fix that moves the function out from under the cap, with its trailing
// `, `. An implementation of a capped trait's method can't leave the trait.
sema_effect_cap_move: fn(name: String, cap: SemaEffectModuleCap) -> String Never! {
    if cap.cap.scope == "trait" -> return ""
    "move `{name}` out of {cap.cap.scope} `{cap.cap.owner}`, "
}

sema_effect_module_cap_report: fn(diagnostic: Diagnostic, chain: [String], cap: SemaEffectModuleCap) -> Diagnostic {
    ^labeled: diagnostic
    if cap.site == None {
        labeled = diagnostic_with_label(labeled, cap.cap.span, "{cap.cap.scope} `{cap.cap.owner}` is capped here")
    }
    diagnostic_with_rights(labeled, "invocation", chain, [String]{"{cap.cap.scope} {cap.cap.owner}"}, None)
}

sema_effect_module_denied_diagnostic: fn(node: SemaEffectNode, reached: [String], denied: String, panic_steps: [String], unsafe_reach: SemaEffectUnsafeReach?, cap: SemaEffectModuleCap) -> Diagnostic {
    name: sema_inline_member_source_name(node.name)
    scope: cap.cap.scope
    owner: cap.cap.owner
    members: sema_effect_cap_members(cap)
    where: sema_effect_module_cap_where(cap)
    if sema_effect_root(denied) == "Panic" {
        panic_site: sema_effect_panic_site_name(node, panic_steps)
        diagnostic: sema_error(sema_effect_cap_code(cap), node.name_span, "`{name}` can stop, but {scope} `{owner}` denies Panic", "`{panic_site}` can stop; the {scope}'s `#FX(!Panic)` cap means {members} and every callee it can reach must not stop{where}", "return a fallible result for expected failure, add facts or a `#Pre`/refinement proof for a programmer-error stop, or drop `!Panic` from the {scope}'s `#FX(…)` cap")
        return sema_effect_module_cap_report(diagnostic, sema_effect_panic_chain(name, panic_steps), cap)
    }
    if unsafe_reach == .Val(reach) {
        opener: sema_effect_panic_site_name(node, reach.steps)
        diagnostic: sema_error(sema_effect_cap_code(cap), node.name_span, "`{name}` reaches `#Unsafe` code, but {scope} `{owner}` denies Unsafe", "`{opener}` {sema_effect_unsafe_gate_text(reach.gate)}; the {scope}'s `#FX(!Unsafe)` cap means {members} and every callee it can reach must stay out of `#Unsafe` code{where}", "remove the `#Unsafe` gate from `{opener}` or stop calling it, {sema_effect_cap_move(name, cap)}or drop `!Unsafe` from the {scope}'s `#FX(…)` cap")
        return sema_effect_module_cap_report(diagnostic, sema_effect_panic_chain(name, reach.steps), cap)
    }
    reached_list: sema_effect_show(reached)
    diagnostic: sema_error(sema_effect_cap_code(cap), node.name_span, "`{name}` reaches the `{reached_list}` effect, which {scope} `{owner}` denies", "the {scope}'s `#FX(…)` cap denies `{denied}` to {members} and every callee it can reach{where}", "remove the call that introduces `{reached_list}`, {sema_effect_cap_move(name, cap)}or drop `!{denied}` from the {scope}'s `#FX(…)` cap")
    sema_effect_module_cap_report(diagnostic, [String]{name}, cap)
}

sema_effect_module_ceiling_diagnostic: fn(node: SemaEffectNode, over: [String], ceiling: [String], cap: SemaEffectModuleCap) -> Diagnostic {
    name: sema_inline_member_source_name(node.name)
    scope: cap.cap.scope
    owner: cap.cap.owner
    over_list: sema_effect_show(over)
    elsewhere: if cap.cap.scope == "trait" -> "remove that work from `{name}`" else -> "move that work out of {scope} `{owner}`"
    diagnostic: sema_error(sema_effect_cap_code(cap), node.name_span, "`{name}` uses the effect `{over_list}`, which {scope} `{owner}`'s `#FX(…)` cap doesn't allow", "the {scope}'s cap allows {sema_effect_cap_allows(ceiling)} in {sema_effect_cap_members(cap)}, even through a call{sema_effect_module_cap_where(cap)}", "add `{over_list}` to the {scope}'s `#FX(…)` cap, or {elsewhere}")
    sema_effect_module_cap_report(diagnostic, [String]{name}, cap)
}

// A function-typed field of a capped type whose fixed row reaches outside
// the cap, reported at the field (E0755). Its row runs wherever a method
// calls the field, so each calling method is E0749 too; this names the
// field path itself, called or not.
sema_effect_check_field_rows: fn(module_row: SemaRegistrationModule, caps: [U32:SemaEffectTypeCap], diagnostics: ^[Diagnostic]) {
    loop nominal in module_row.nominals {
        found: caps.get(nominal.symbol.id.id) ?? next
        cap: SemaEffectModuleCap{cap: found.cap.cap, site: None}
        ceiling: sema_effect_cap_ceiling(cap.cap)
        loop field in nominal.fields {
            row: if field.ty == .Fn(_, _, bound, _, _, _) -> bound ?? next else -> next
            ^declared: [String]{}
            loop entry in row {
                if entry.name.starts_with("!") || entry.name.starts_with("..") -> next
                effect_name: sema_effect_parse_name(entry.name) ?? next
                sema_effect_set_add(declared, effect_name)
            }
            ^outside: [String]{}
            loop entry in cap.cap.entries {
                if !entry.name.starts_with("!") -> next
                denied: sema_effect_parse_name(entry.name.slice(1, entry.name.len())) ?? next
                loop hit in sema_effect_declared_hits(declared, denied) {
                    sema_effect_set_add(outside, hit)
                }
            }
            if ceiling == .Val(bound) {
                loop wider in sema_effect_uncovered(declared, bound) {
                    sema_effect_set_add(outside, wider)
                }
            }
            if outside.len() > 0 {
                diagnostics.push(sema_effect_field_row_diagnostic(field.symbol.name, field.symbol.span, outside, cap))
            }
        }
    }
}

sema_effect_field_row_diagnostic: fn(name: String, span: Span, outside: ^^[String], cap: SemaEffectModuleCap) -> Diagnostic {
    ^sorted: outside
    sorted.sort()
    outside_list: sema_effect_show(sorted)
    owner: cap.cap.owner
    diagnostic: sema_error("E0755", span, "field `{name}`'s row declares `{outside_list}`, which type `{owner}` doesn't allow", "a method that calls `{name}` runs its row, and the type's `#FX(…)` cap bounds every method of the type", "narrow `{name}`'s row to fit the cap, move `{name}` out of type `{owner}`, or widen the type's `#FX(…)` cap")
    sema_effect_module_cap_report(diagnostic, [String]{name}, cap)
}

// Each `#FX(…)` cap on a module, generic module, struct, enum or trait
// declared in `items`, nested modules included, names known effects; a
// positive `Panic` is rejected as in a row (E0749). Reported once per cap,
// where it is written.
sema_effect_module_cap_names: fn(items: [Item], diagnostics: ^[Diagnostic]) {
    loop item in items {
        if item == {
            .CodeModule(definition) -> {
                if definition.cap == .Val(cap) -> sema_effect_cap_entry_names(cap, diagnostics)
                if definition.body == .Val(body) -> sema_effect_module_cap_names(body, diagnostics)
            }
            .GenericModule(definition) -> {
                if definition.cap == .Val(cap) -> sema_effect_cap_entry_names(cap, diagnostics)
                sema_effect_module_cap_names(definition.body, diagnostics)
            }
            .Struct(definition) -> {
                if definition.cap == .Val(cap) -> sema_effect_cap_entry_names(cap, diagnostics)
            }
            .Enum(definition) -> {
                if definition.cap == .Val(cap) -> sema_effect_cap_entry_names(cap, diagnostics)
            }
            .Trait(definition) -> {
                if definition.cap == .Val(cap) -> sema_effect_cap_entry_names(cap, diagnostics)
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

sema_effect_cap_entry_names: fn(cap: ModuleCap, diagnostics: ^[Diagnostic]) {
    loop index in 0..<cap.entries.len() {
        entry: cap.entries[index]
        raw: if entry.name.starts_with("!") -> entry.name.slice(1, entry.name.len()) else -> entry.name
        effect_name: sema_effect_parse_name(raw) ?? {
            diagnostics.push(sema_effect_unknown_entry(raw, entry.span, (loop written in cap.entries -> written.span), index))
            next
        }
        if !entry.name.starts_with("!") && sema_effect_root(effect_name) == "Panic" {
            diagnostics.push(sema_effect_positive_panic(entry.span))
        }
    }
}

// The `#FX(…)` cap of every struct and enum in the graph, by the type's
// nominal key, each with the `file:line` it is written at.
sema_effect_type_caps: fn(graph_modules: [SemaRegistrationModule]) -> [U32:SemaEffectTypeCap] {
    ^caps: [U32:SemaEffectTypeCap]{}
    loop module_row in graph_modules {
        loop nominal in module_row.nominals {
            cap: sema_effect_nominal_cap(nominal) ?? next
            caps[nominal.symbol.id.id] = SemaEffectTypeCap{module_identity: module_row.module_identity, cap: SemaEffectModuleCap{cap: cap.copy(), site: Val(sema_effect_cap_site(module_row, cap.span))}}
        }
    }
    caps
}

// The `#FX(…)` cap of every trait in `graph`, by the trait's SymbolID, each
// with the `file:line` it is written at.
sema_effect_trait_caps: fn(graph: SemaRegistrationGraph) -> [U32:SemaEffectTypeCap] {
    ^caps: [U32:SemaEffectTypeCap]{}
    loop module_row in graph.modules {
        loop item in module_row.declarations {
            if item == .Trait(definition) {
                cap: definition.cap ?? next
                trait_id: sema_type_graph_trait_symbol(graph, module_row.module_identity, definition.name) ?? next
                site: sema_effect_cap_site(module_row, cap.span)
                caps[trait_id.id.id] = SemaEffectTypeCap{module_identity: module_row.module_identity, cap: SemaEffectModuleCap{cap: cap, site: Val(site)}}
            }
        }
    }
    caps
}

// The ceiling of a cap: its plain entries. A bare `#FX` has none and is the
// empty ceiling, pure. None when the cap only denies, so its ceiling is the
// rungs' above, or when a plain entry names no effect (reported once per cap
// by sema_effect_module_cap_names).
sema_effect_cap_ceiling: fn(cap: ModuleCap) -> [String]? Never! {
    ^ceiling: [String]{}
    ^bounded: cap.entries.len() == 0
    loop entry in cap.entries {
        if entry.name.starts_with("!") -> next
        bounded = true
        effect_name: sema_effect_parse_name(entry.name) ?? return None
        if sema_effect_root(effect_name) != "Panic" -> sema_effect_set_add(ceiling, effect_name)
    }
    if !bounded -> return None
    Val(ceiling)
}

// The run-time frames of the caps over one function whose entries scope FS
// or Net (FnBody.effect_scope): each is named after its module, type or
// trait and spelled as a written row's frame (effect_scope_descriptor), and
// frames are separated by a blank line. "" when no cap scopes either, so an
// unscoped cap costs nothing at run time.
sema_effect_cap_frames: fn(caps: [SemaEffectModuleCap]) -> String Never! {
    ^frames: [String]{}
    loop cap in caps {
        entries: loop entry in cap.cap.entries -> entry.name.copy()
        frame: effect_scope_descriptor("{cap.cap.scope} {cap.cap.owner}", "", false, Val(entries))
        if frame != "" -> frames.push(frame)
    }
    frames.join("\n\n")
}

// A function's effect-scope descriptor `own` under its caps' `frames`: the
// caps' frames are outermost, so a Core publisher's marker stays innermost.
sema_effect_capped_scope: fn(frames: String, own: String) -> String Never! {
    // copy: the frames stay in the per-node table.
    if own == "" -> return frames.copy()
    "{frames}\n\n{own}"
}

sema_effect_nominal_cap: fn(nominal: SemaRegistrationNominal) -> ModuleCap? Never! {
    if nominal.source == .SourceAST(item) {
        if item == {
            .Struct(definition) -> return definition.cap
            .Enum(definition) -> return definition.cap
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    None
}

// Binds the cap of the type `nominal_key` names to a method of it declared
// in `module_identity`. A cap written in the method's own module is labeled
// where it is written; one in another module is named by `file:line`.
sema_effect_bind_type_cap: fn(source: ^SemaEffectFunctionSource, caps: [U32:SemaEffectTypeCap], nominal: SymbolID?, module_identity: ModuleID) {
    id: nominal ?? return
    found: caps.get(id.id) ?? return
    site: if found.module_identity == module_identity -> None else -> found.cap.site
    source.type_cap = Val(SemaEffectModuleCap{cap: found.cap.cap, site: site})
}

// `#FX(…) name: module` over a file module: every function in the file takes
// the cap, and each file that file declares takes it too. So does an `#FX(…)`
// at the head of a file, named after the file. The result is by graph module
// index, outermost cap first.
sema_effect_file_module_caps: fn(graph_modules: [SemaRegistrationModule], edges: [SemaRegistrationImportEdge]) -> [[SemaEffectModuleCap]] {
    ^rows: [U32:Int]{}
    loop (index, module_row) in graph_modules -> rows[module_row.module_identity.id] = index
    ^direct: (loop _ in graph_modules -> [SemaEffectModuleCap]{})
    ^parents: (loop _ in graph_modules -> [Int]{})
    // The file-module edges taken, by `source * modules + target`, each with
    // the aliases (interned in `aliases`) it was taken under.
    ^aliases: name_table()
    ^seen: [Int:[Int]]{}
    loop edge in edges {
        if edge.declaration.kind == .File(_, _) {
            source: rows.get(edge.source_module_identity.id) ?? next
            target: rows.get(edge.target_module_identity.id) ?? next
            pair: source * graph_modules.len() + target
            alias: name_index(name_intern(aliases, edge.declaration.alias))
            ^taken: seen.get(pair) ?? [Int]{}
            if taken.contains(alias) -> next
            if !sema_effect_declares_file_module(graph_modules[source].program.items, edge.declaration.alias) {
                next
            }
            taken.push(alias)
            seen[pair] = taken
            parents[target].push(source)
            cap: sema_effect_file_module_cap(graph_modules[source].program.items, edge.declaration.alias) ?? next
            direct[target].push(SemaEffectModuleCap{cap: cap.copy(), site: Val(sema_effect_cap_site(graph_modules[source], cap.span))})
        }
    }
    // A head cap comes last in its own file's row, labeled where it is
    // written; the files it declares name it by `file:line`.
    ^heads: (loop _ in graph_modules -> false)
    loop (index, module_row) in graph_modules {
        ^head: module_row.program.file_cap ?? next
        head.owner = sema_effect_source_display(sema_source_file_at(module_row.source_segments, module_row.source_file, module_row.source_origin, head.span))
        direct[index].push(SemaEffectModuleCap{cap: head.copy(), site: Val(sema_effect_cap_site(module_row, head.span))})
        heads[index] = true
    }
    (loop index in 0..<graph_modules.len() -> sema_effect_own_file_caps(sema_effect_file_caps_of(index, direct, parents, 0), heads[index]))
}

sema_effect_cap_site: fn(module_row: SemaRegistrationModule, span: Span) -> String {
    file: sema_effect_source_display(sema_source_file_at(module_row.source_segments, module_row.source_file, module_row.source_origin, span))
    if sema_source_line_at(module_row.source_segments, span) == .Val(line) -> return "{file}:{line}"
    file
}

sema_effect_own_file_caps: fn(caps: [SemaEffectModuleCap], has_head: Bool) -> [SemaEffectModuleCap] Never! {
    ^own: caps
    if has_head && own.len() > 0 -> own[own.len() - 1].site = None
    own
}

sema_effect_declares_file_module: fn(items: [Item], name: String) -> Bool Never! {
    loop item in items {
        if item == .CodeModule(definition) && definition.name == name && definition.body == None {
            return true
        }
    }
    false
}

sema_effect_file_module_cap: fn(items: [Item], name: String) -> ModuleCap? Never! {
    loop item in items {
        if item == .CodeModule(definition) && definition.name == name && definition.body == None {
            return definition.cap
        }
    }
    None
}

// The module graph is acyclic (import cycles are load errors); `depth` only
// bounds the walk.
sema_effect_file_caps_of: fn(index: Int, direct: [[SemaEffectModuleCap]], parents: [[Int]], depth: Int) -> [SemaEffectModuleCap] Never! {
    ^caps: [SemaEffectModuleCap]{}
    if depth > direct.len() -> return caps
    loop parent in parents[index] {
        loop cap in sema_effect_file_caps_of(parent, direct, parents, depth + 1) -> caps.push(cap)
    }
    loop cap in direct[index] -> caps.push(cap.copy())
    caps
}

sema_effect_replayable_diagnostic: fn(node: SemaEffectNode, reached: [String]) -> Diagnostic {
    span: node.replayable_span ?? node.name_span
    diagnostic: sema_error("E0725", span, "`{node.name}` is `#Replayable` but reaches `{sema_effect_show(reached)}`", "`#Replayable` code must replay from explicit inputs; ambient time, randomness, network, or console IO would make the same replay diverge", "inject a deterministic clock/RNG or mockable input, pass recorded data in, or move the ambient effect outside the replayable function")
    diagnostic_with_rights(diagnostic, "replayable", [String]{node.name}, [String]{}, None)
}

// `effect_key`: a method's key is `Owner.name`.
sema_effect_chain_name: fn(function: FnBody) -> String Never! {
    owner: if function.kind == {
        .Method(_, owner_type) -> owner_type
        .TraitMethod(_, _, owner_type, _, _) -> owner_type
        .TopLevel -> {
            return function.name
        }
    }
    if owner == {
        .Named(name) | .Apply(name, _) -> "{symbol_key_leaf(name)}.{function.name}"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> function.name
    }
}

// The panic site, with the path to it: the functions from `index` to the first
// one reached depth-first that stops (a maximal row, a direct Panic, or a stop
// sentinel), both ends included, so a function that stops itself is its own
// one-step path. Empty when none stops.
sema_effect_panic_path: fn(nodes: [SemaEffectNode], index: Int, seen: ^[Bool]) -> [Int] Never! {
    if seen[index] -> return [Int]{}
    seen[index] = true
    if nodes[index].maximal -> return [Int]{index}
    loop effect_name in nodes[index].direct {
        if sema_effect_root(effect_name) == "Panic" -> return [Int]{index}
    }
    loop edge in nodes[index].call_edges {
        if edge == "__jet_panic__" -> return [Int]{index}
    }
    loop target in nodes[index].call_targets {
        if target < 0 -> next
        rest: sema_effect_panic_path(nodes, target, seen)
        if rest.len() == 0 -> next
        ^path: [Int]{index}
        loop step in rest -> path.push(step)
        return path
    }
    [Int]{}
}

// The steps of a reached Panic's call chain after function `node_index`: the
// chain names along sema_effect_panic_path past its first, so a function that
// stops itself has none. "the reachable call graph" when no stop is found.
sema_effect_panic_steps: fn(nodes: [SemaEffectNode], node_index: Int) -> [String] Never! {
    ^seen: (loop _ in nodes -> false)
    path: sema_effect_panic_path(nodes, node_index, seen)
    if path.len() == 0 -> return [String]{"the reachable call graph"}
    steps: loop at in 1..<path.len() -> nodes[path[at]].chain_name
    steps
}

// The function a denied Panic names as the one that stops: the last step, or
// the denied function itself when it stops directly.
sema_effect_panic_site_name: fn(node: SemaEffectNode, panic_steps: [String]) -> String Never! {
    if panic_steps.len() == 0 -> return node.chain_name
    panic_steps[panic_steps.len() - 1]
}

// A denied Panic's call chain: `first` (the denied function as its report
// names it), then the steps to the function that stops.
sema_effect_panic_chain: fn(first: String, panic_steps: [String]) -> [String] Never! {
    ^chain: [String]{first}
    loop step in panic_steps -> chain.push(step.copy())
    chain
}

// Where a denied Unsafe enters the call graph: the chain names past the
// denied function (`steps`, as sema_effect_panic_steps gives them) and the
// gate the chain ends at as `file:line`, or "" when it ends at an opaque call.
SemaEffectUnsafeReach: struct {
    steps: [String],
    gate: String,
}

// Whether a function brings the Unsafe fact in itself: outside Core, it
// opens an `#Unsafe` gate or makes an opaque call (a maximal row), which
// fails closed. Core's gates are vetted and sealed.
sema_effect_unsafe_opens: fn(node: SemaEffectNode) -> Bool Never! {
    if module_is_core(node.module_identity) -> return false
    node.maximal || node.direct.contains("Unsafe")
}

// The functions from `index` to the first one reached depth-first that
// brings the Unsafe fact in (sema_effect_unsafe_opens), both ends included,
// so a function that opens a gate itself is its own one-step path. Empty
// when none does.
sema_effect_unsafe_path: fn(nodes: [SemaEffectNode], index: Int, seen: ^[Bool]) -> [Int] Never! {
    if seen[index] -> return [Int]{}
    seen[index] = true
    if sema_effect_unsafe_opens(nodes[index]) -> return [Int]{index}
    loop target in nodes[index].call_targets {
        if target < 0 -> next
        rest: sema_effect_unsafe_path(nodes, target, seen)
        if rest.len() == 0 -> next
        ^path: [Int]{index}
        loop step in rest -> path.push(step)
        return path
    }
    [Int]{}
}

// A reached Unsafe's call chain after function `node_index` and the gate it
// ends at; "the reachable call graph" when no opener is found.
sema_effect_unsafe_reach: fn(nodes: [SemaEffectNode], node_index: Int) -> SemaEffectUnsafeReach Never! {
    ^seen: (loop _ in nodes -> false)
    path: sema_effect_unsafe_path(nodes, node_index, seen)
    if path.len() == 0 {
        return SemaEffectUnsafeReach{steps: [String]{"the reachable call graph"}, gate: ""}
    }
    steps: loop at in 1..<path.len() -> nodes[path[at]].chain_name
    SemaEffectUnsafeReach{steps: steps, gate: nodes[path[path.len() - 1]].unsafe_site}
}

// Whether a denial's reached effects include the Unsafe fact.
sema_effect_reaches_unsafe: fn(reached: [String]) -> Bool Never! {
    loop effect_name in reached {
        if sema_effect_root(effect_name) == "Unsafe" -> return true
    }
    false
}

// What the function a denied Unsafe names does: opens the gate at
// `file:line`, or makes an opaque call when the chain ends at one.
sema_effect_unsafe_gate_text: fn(gate: String) -> String Never! {
    if gate == "" -> return "makes an opaque call, which can reach `#Unsafe` code"
    "opens the `#Unsafe` gate at {gate}"
}

// An `#Unsafe` gate a body opens (an `#Unsafe` block, an `#Unsafe` function,
// a foreign function's gate) records the deny-only Unsafe fact at `span`;
// callers inherit it through the solved rows. Core's gates record none.
sema_effect_record_unsafe_gate: fn(nodes: ^[SemaEffectNode], node_index: Int, gate: TUnsafeGate, span: Span) Never! {
    if module_is_core(nodes[node_index].module_identity) {
        return
    }
    if nodes[node_index].unsafe_site == "" {
        nodes[node_index].unsafe_site = sema_effect_unsafe_site(gate)
    }
    sema_effect_node_add_direct(nodes, node_index, "Unsafe", span)
}

sema_effect_unsafe_site: fn(gate: TUnsafeGate) -> String Never! {
    "{sema_effect_source_display(gate.file)}:{gate.line}"
}

// An `#Unsafe` gate the walk meets records the Unsafe fact on the function it
// collects for; a lambda's gate is its enclosing function's, as its loops
// are (SemaEffectWalk.LambdaBody). A flat gate with no span of its own is
// charged at the function.
sema_effect_walk_unsafe_gate: fn(walk: SemaEffectWalk, nodes: ^[SemaEffectNode], gate: TUnsafeGate, span: Span?) Never! {
    node_index: if walk == {
        .Collect(index) | .TransactCollect(index) | .LambdaBody(index) -> index
        .Unsafe(_) | .Region(_, _, _) -> {
            return
        }
    }
    sema_effect_record_unsafe_gate(nodes, node_index, gate, span ?? nodes[node_index].span)
}

// ────────────────────────────────────────────────────────────────────────────
// Summary construction

// A module's function sources by key and by name: each spelling's id in
// `texts`, its first source's position at that id in `by_key` or `by_name`.
SemaEffectSourceIndex: struct {
    texts: NameTable,
    by_key: [Int],
    by_name: [Int],
}

sema_effect_source_index: fn(sources: [SemaEffectFunctionSource]) -> SemaEffectSourceIndex Never! {
    ^index: SemaEffectSourceIndex{texts: name_column_table(sources.len() * 2), by_key: name_column(sources.len()), by_name: name_column(sources.len())}
    loop (position, source) in sources {
        name_column_set_first(index.texts, index.by_key, source.key, position)
        name_column_set_first(index.texts, index.by_name, source.name, position)
    }
    index
}

// The position of `function`'s source row in its module's sources; the
// caller reads the row in place.
sema_effect_source_position: fn(function: FnBody, index: SemaEffectSourceIndex) -> Int? Never! {
    position: name_column_get(index.texts, index.by_key, function.key) ?? {
        name_column_get(index.texts, index.by_name, function.name) ?? return None
    }
    Val(position)
}

sema_effect_node_add_direct: fn(nodes: ^[SemaEffectNode], node_index: Int, name: String, span: Span) Never! {
    if sema_effect_set_add(nodes[node_index].direct, name) {
        nodes[node_index].direct_spans.push(TEffectSpan{name: name, span: span})
    }
}

// A call edge of node `node_index`, appended as the walk finds it: adding
// each to the ordered set (sema_effect_set_add) rescans and re-sorts the row
// once per call, quadratic in a body's calls. The walk that collects the
// node orders and dedupes the row once it ends
// (sema_effect_node_settle_edges), to the same set.
sema_effect_node_add_edge: fn(nodes: ^[SemaEffectNode], node_index: Int, edge: String) Never! {
    // copy: the node's row owns its key; the caller keeps its own.
    nodes[node_index].call_edges.push(edge.copy())
}

// The call edges sema_effect_node_add_edge appended to `node`, as the
// ordered set sema_effect_set_add builds: each once, by root rank, then by
// name.
sema_effect_node_settle_edges: fn(node: ^SemaEffectNode) Never! {
    node.call_edges = sema_effect_set_of(node.call_edges)
}

// `callee` is taken as a value here and may run later through it; only a
// function with a body in this program is an edge.
sema_effect_node_add_value_edge: fn(nodes: ^[SemaEffectNode], node_by_key: SemaEffectNodeKeys, node_index: Int, callee: String) Never! {
    if sema_effect_node_index(node_by_key, callee) == None {
        return
    }
    sema_effect_node_rare_open(nodes[node_index])
    if nodes[node_index].rare.in_place() == .Val(rare) {
        sema_effect_set_add(rare.value_edges, callee)
    }
}

// Each node key's id in `names` and its first node at that id in `nodes`
// (sema_effect_node_key_table).
SemaEffectNodeKeys: struct {
    names: NameTable,
    nodes: [Int],
}

sema_effect_node_index: fn(node_by_key: SemaEffectNodeKeys, key: String) -> Int? Never! {
    name_column_get(node_by_key.names, node_by_key.nodes, key)
}

// A compiler thread is admitted for at least this many key lookups (about a
// millisecond of them), so a small program looks its keys up on the calling
// thread.
SEMA_EFFECT_LOOKUPS_PER_THREAD: 2048

// Each input module's functions' graph nodes (-1 for a function without
// one), in input and function order: every pass over the functions reads its
// node here instead of looking its key up again. On up to `threads` compiler
// threads, each over consecutive input modules; the rows are the same for
// any thread count.
sema_effect_function_nodes: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], calls: SemaEffectCallIndex, threads: CompilerThreads) -> [[Int]] Never! {
    ^weights: [Int]{}
    ^work: 0
    loop module_row in inputs {
        weight: modules[module_row.module_index].functions.len() + 1
        weights.push(weight)
        work += weight
    }
    workers: compiler_threads_admit(threads, inputs.len(), work, SEMA_EFFECT_LOOKUPS_PER_THREAD, 0, 0)
    if workers <= 1 {
        return sema_effect_function_nodes_part(modules, inputs, calls, 0, inputs.len())
    }
    ^rows: [[Int]]{}
    loop part in sema_effect_function_nodes_parts(modules, inputs, calls, compiler_threads_partition(weights, workers), 0) {
        rows.extend(part)
    }
    rows
}

sema_effect_function_nodes_parts: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], calls: SemaEffectCallIndex, bounds: [Int], at: Int) -> [[[Int]]] Never! {
    ^done: [[[Int]]]{}
    if at + 1 >= bounds.len() -> return done
    from: bounds[at]
    to: bounds[at + 1]
    if at + 2 == bounds.len() {
        done.push(sema_effect_function_nodes_part(modules, inputs, calls, from, to))
        return done
    }
    task.group sema_effect_function_node_threads {
        head: task sema_effect_function_nodes_part(modules, inputs, calls, from, to)
        rest: sema_effect_function_nodes_parts(modules, inputs, calls, bounds, at + 1)
        done.push(compiler_threads_joined(head))
        loop part in rest.move() -> done.push(part)
    }
    done
}

sema_effect_function_nodes_part: fn(modules: [SemaGraphModuleResult], inputs: [SemaEffectModuleInput], calls: SemaEffectCallIndex, from: Int, to: Int) -> [[Int]] Never! {
    ^rows: [[Int]]{}
    loop position in from..<to {
        rows.push(loop function in modules[inputs[position].module_index].functions -> sema_effect_node_index(calls.node_by_key, function.key) ?? -1)
    }
    rows
}

// One node's call edges, value edges, instance reaches, memory calls and
// instantiations as node indices (-1 for a key without a node).
SemaEffectNodeTargets: struct {
    calls: [Int],
    values: [Int],
    reaches: [Int],
    memory: [Int],
    instantiations: [Int],
}

// Each node's call edges, value edges and memory calls as node indices, once
// the graph's edges are final (after sema_effect_resolve_type_params): the
// walks over the graph follow these and never look a callee's key up again.
// The lookups run on up to `threads` compiler threads, each over consecutive
// nodes reading the graph in place; the caller then moves each node's indices
// into it, so the result is the same for any thread count.
sema_effect_resolve_edges: fn(nodes: ^[SemaEffectNode], calls: SemaEffectCallIndex, threads: CompilerThreads) Never! {
    ^weights: [Int]{}
    ^work: 0
    loop node in nodes {
        ^weight: 1 + node.call_edges.len() + node.memory_calls.len() + node.instantiations.len()
        if node.rare == .Val(rare) -> weight += rare.value_edges.len() + rare.instance_reaches.len()
        weights.push(weight)
        work += weight
    }
    workers: compiler_threads_admit(threads, nodes.len(), work, SEMA_EFFECT_LOOKUPS_PER_THREAD, 0, 0)
    if workers <= 1 {
        loop index in 0..<nodes.len() {
            targets: sema_effect_node_targets(nodes[index], calls)
            sema_effect_place_targets(nodes[index], targets)
        }
        return
    }
    ^parts: sema_effect_resolve_edge_parts(nodes, calls, compiler_threads_partition(weights, workers), 0)
    // Last part and last node first, so each row moves out of its part.
    ^index: nodes.len()
    loop parts.len() > 0 {
        ^part: parts.pop() ?? break
        loop part.len() > 0 {
            targets: part.pop() ?? break
            index -= 1
            sema_effect_place_targets(nodes[index], targets)
        }
    }
}

sema_effect_resolve_edge_parts: fn(nodes: [SemaEffectNode], calls: SemaEffectCallIndex, bounds: [Int], at: Int) -> [[SemaEffectNodeTargets]] Never! {
    ^done: [[SemaEffectNodeTargets]]{}
    if at + 1 >= bounds.len() -> return done
    from: bounds[at]
    to: bounds[at + 1]
    if at + 2 == bounds.len() {
        done.push(sema_effect_resolve_edge_part(nodes, calls, from, to))
        return done
    }
    task.group sema_effect_resolve_edge_threads {
        head: task sema_effect_resolve_edge_part(nodes, calls, from, to)
        rest: sema_effect_resolve_edge_parts(nodes, calls, bounds, at + 1)
        done.push(compiler_threads_joined(head))
        loop part in rest.move() -> done.push(part)
    }
    done
}

sema_effect_resolve_edge_part: fn(nodes: [SemaEffectNode], calls: SemaEffectCallIndex, from: Int, to: Int) -> [SemaEffectNodeTargets] Never! {
    loop index in from..<to -> sema_effect_node_targets(nodes[index], calls)
}

sema_effect_node_targets: fn(node: SemaEffectNode, calls: SemaEffectCallIndex) -> SemaEffectNodeTargets Never! {
    call_targets: loop edge in node.call_edges -> sema_effect_node_index(calls.node_by_key, edge) ?? -1
    ^values: [Int]{}
    ^reaches: [Int]{}
    if node.rare == .Val(rare) {
        values = loop edge in rare.value_edges -> sema_effect_node_index(calls.node_by_key, edge) ?? -1
        reaches = loop reach in rare.instance_reaches -> sema_effect_node_index(calls.node_by_key, reach.target) ?? -1
    }
    memory: loop call in node.memory_calls -> sema_effect_node_index(calls.node_by_key, call.callee) ?? -1
    instantiations: loop site in node.instantiations -> sema_effect_node_index(calls.node_by_key, site.callee) ?? -1
    SemaEffectNodeTargets{calls: call_targets, values: values, reaches: reaches, memory: memory, instantiations: instantiations}
}

// Moves `targets` (sema_effect_node_targets of `node`) into `node`.
sema_effect_place_targets: fn(node: ^SemaEffectNode, targets: ^^SemaEffectNodeTargets) Never! {
    node.call_targets = targets.calls.move()
    if node.rare.in_place() == .Val(rare) {
        rare.value_targets = targets.values.move()
        loop at in 0..<rare.instance_reaches.len() {
            rare.instance_reaches[at].target_node = targets.reaches[at]
        }
    }
    loop at in 0..<node.memory_calls.len() -> node.memory_calls[at].target = targets.memory[at]
    loop at in 0..<node.instantiations.len() {
        node.instantiations[at].callee_node = targets.instantiations[at]
    }
}

// Each diagnostic of the batch moves into `all` (the batch is the caller's
// own list), so locating it never copies it.
sema_effect_publish_diagnostics: fn(all: ^[Diagnostic], source_segments: [SemaSourceSegment], batch: ^^[Diagnostic]) Never! {
    loop diagnostic in batch.move() {
        located: if diagnostic.source_path != None -> diagnostic.move() else -> sema_diagnostic_with_source_location(diagnostic, source_segments)
        all.push(located)
    }
}

// The graph node of `function`.
sema_effect_node_from_source: fn(function: FnBody, sources: [SemaEffectFunctionSource], source_position: Int?, module_index: Int, library: [SemaLibraryEffectName], symbols: SymbolTable, diagnostics: ^[Diagnostic]) -> SemaEffectNode {
    ^node: SemaEffectNode{
        key: function.key,
        name: function.name,
        module_identity: function.module_identity,
        module_index: module_index,
        span: function.source_span,
        name_span: function.source_span,
        direct: [String]{},
        direct_spans: [TEffectSpan]{},
        call_edges: [String]{},
        maximal: false,
        maximal_span: None,
        declared: [String]{},
        prohibited: [String]{},
        has_declared_row: false,
        is_pure: function.is_pure,
        is_replayable: false,
        replayable_span: None,
        is_unsafe: function.is_unsafe,
        unsafe_reason: None,
        unsafe_span: None,
        effect_via: None,
        dispatches: [TEffectSpan]{},
    }
    loop effect_name in function.effects.direct {
        if !sema_effect_set_add(node.direct, effect_name) -> next
        node.direct_spans.push(TEffectSpan{name: effect_name, span: function.source_span})
    }
    loop edge in function.effects.call_edges -> sema_effect_set_add(node.call_edges, edge)
    if function.unsafe_gate == .Val(gate) && !module_is_core(function.module_identity) {
        node.unsafe_site = sema_effect_unsafe_site(gate)
        if sema_effect_set_add(node.direct, "Unsafe") {
            node.direct_spans.push(TEffectSpan{name: "Unsafe", span: function.source_span})
        }
    }
    if function.effects.value_edges.len() > 0 || function.effects.module_writes.len() > 0 || function.effects.module_reads.len() > 0 {
        ^rare: SemaEffectNodeRare{}
        loop edge in function.effects.value_edges -> sema_effect_set_add(rare.value_edges, edge)
        // copy: the node keeps the writes; the function keeps its effect facts.
        rare.module_writes = function.effects.module_writes.copy()
        rare.module_reads = (loop item in function.effects.module_reads -> TEffectSpan{name: item.name, span: item.span, held: item.held, storage: item.storage})
        node.rare = Val(rare)
    }
    if function.effects.maximal {
        node.maximal = true
        node.maximal_span = Val(function.source_span)
    }
    node.display_key = "{function.module_name}.{function.name}"
    node.platform_env = sema_effect_platform_env_read(function.role)
    node.source_display = sema_effect_source_display(function.source_file)
    node.chain_name = sema_effect_chain_name(function).replace(".", ".")
    node.owner_params = sema_effect_owner_params(function.kind)
    node.type_params = node.owner_params
    loop param in function.generic_params -> sema_effect_set_add(node.type_params, param.name)
    if function.kind == .TraitMethod(_, _, _, trait_symbol, _) {
        if !symbol_is_local(trait_symbol) -> node.trait_symbol = Val(trait_symbol)
    }
    node.path_first = function.params.len() > 0 && function.params[0].name == "path"
    at: source_position ?? {
        sema_effect_check_tfunc_unsafe(function, diagnostics)
        return node
    }
    actual: sources[at]
    node.span = actual.span
    node.name_span = actual.name_span ?? actual.span
    node.has_declared_row = actual.declared_effects != None
    node.is_pure = actual.is_pure
    node.is_replayable = actual.is_replayable
    node.is_unsafe = actual.is_unsafe
    node.is_guest_export = actual.is_guest_export
    node.replayable_span = actual.replayable_span
    node.unsafe_reason = actual.unsafe_reason
    node.effect_via = actual.effect_via
    node.unsafe_span = actual.unsafe_span
    node.loop_spans = actual.loop_spans
    if actual.assume_det_spans.len() > 0 || actual.module_caps.len() > 0 || actual.repeatable != None || actual.job_retry != None {
        sema_effect_node_rare_open(node)
        if node.rare.in_place() == .Val(rare) {
            rare.assume_det_spans = actual.assume_det_spans
            rare.module_caps = actual.module_caps
            rare.repeatable = actual.repeatable
            rare.job_retry = actual.job_retry
        }
    }
    node.memo_span = actual.memo_span
    node.kernel = actual.kernel
    if actual.type_cap == .Val(type_cap) -> node.type_cap = Val(type_cap.copy())
    if actual.trait_symbol != None -> node.trait_symbol = actual.trait_symbol.copy()
    if actual.is_unsafe && !sema_effect_check_unsafe_function(actual, diagnostics) {

    }
    // The diagnostic is already source-backed; retain the node so the graph
    // remains inspectable after a failed gate check.
    if actual.declared_effects == .Val(effect_row) {
        if effect_row.len() > 0 -> node.row_span = Val(effect_row[0].span)
        loop index in 0..<effect_row.len() {
            entry: effect_row[index]
            // An open row (`-[..E]>`, `-[IO, ..E]>`) has no closed ceiling:
            // its named effects are a floor, so no bound is checked.
            if entry.name.starts_with("..") {
                node.has_declared_row = false
                next
            }
            prohibited: entry.name.starts_with("!")
            if prohibited && node.prohibition_span == None {
                node.prohibition_span = Val(entry.span)
            }
            // A value's text may hold a `!` of its own.
            raw: if prohibited -> entry.name.slice(1, entry.name.len()) else -> entry.name
            effect_name: sema_effect_parse_name(raw) ?? {
                if sema_library_effect_value_problem(library, raw, entry.span) == .Val(problem) {
                    diagnostics.push(problem)
                    next
                }
                // A library effect admits the kernel effects it lists; a
                // denial of it is checked over the library effects reached.
                library_name: sema_library_effect_find(library, raw) ?? {
                    diagnostics.push(sema_effect_unknown_entry(raw, entry.span, sema_effect_row_sources(effect_row), index))
                    next
                }
                if prohibited {
                    sema_effect_node_rare_open(node)
                    if node.rare.in_place() == .Val(rare) {
                        rare.library_denials.push(SemaLibraryEffectDenial{name: library_name, span: entry.span})
                    }
                    next
                }
                loop listed in library_name.kernel -> sema_effect_set_add(node.declared, listed)
                sema_effect_node_rare_open(node)
                if node.rare.in_place() == .Val(rare) -> rare.library_rows.push(library_name)
                next
            }
            if !prohibited && sema_effect_root(effect_name) == "Panic" {
                diagnostics.push(sema_effect_positive_panic(entry.span))
                next
            }
            if {
                // Memory denials are proved over memory
                // events (E0921), not the ambient prohibition check.
                prohibited && sema_effect_root(effect_name) == "Mem" -> {
                    sema_effect_node_rare_open(node)
                    if node.rare.in_place() == .Val(rare) {
                        rare.memory_denials.push(EffectRowEntry{name: effect_name, span: entry.span})
                    }
                }
                prohibited -> { ^_: sema_effect_set_add(node.prohibited, effect_name) }
                else -> {
                    ^_: sema_effect_set_add(node.declared, effect_name)
                    sema_effect_node_rare_open(node)
                    if node.rare.in_place() == .Val(rare) {
                        ^_: sema_effect_set_add(rare.written_declared, effect_name)
                    }
                }
            }
        }
    }
    if actual.effect_via != None -> sema_effect_apply_via(node, function, diagnostics)
    node
}

// Intrinsic producers use the same fact carrier as checked calls. The effect
// row is authoritative producer input: an empty present row means known-pure,
// while an absent row remains unknown and is conservatively maximal downstream.
sema_effect_record_intrinsic_fact: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, context: ^SemaCheckContext, api: String, span: Span, facts: SemaCallFacts, diagnostics: ^[Diagnostic]) -> Bool Never! {
    ^wall: sema_effect_check_transaction_wall(environment, program, scopes, facts.effect_bound, api, span, diagnostics)
    allowed: wall ?? return false
    if !allowed -> return false
    ^caller_key: sema_scope_function_owner_key(scopes)
    // A compile-time value has no owner frame; its sites still feed the
    // ambient time/randomness check (sema_effect_comptime_nondeterministic).
    if caller_key != "" || scopes.comptime_execution_depth > 0 {
        context.call_facts.push(
            SemaCallSiteFact{
                span: span,
                caller_key: caller_key,
                callee: None,
                facts: SemaCallSiteFacts{effect_bound: facts.effect_bound, local_lambda: facts.local_lambda},
                discarded: false,
                detail: Val(SemaCallSiteDetail{intrinsic_api: Val(api)}),
            },
        )
    }
    true
}

// Convenience entry point for intrinsic operations whose only call metadata
// is their canonical effect row. Use an empty row to record a known-pure site.
sema_effect_record_intrinsic_effects: fn(check: ^SemaBodyCheck, api: String, span: Span, effect_row: [EffectRowEntry]) -> Bool Never! {
    if effect_row.len() > 0 && check.scopes.transaction_wall_depth > 0 {
        ^wall: sema_effect_check_transaction_wall(check.environment.*, check.program.*, check.scopes, Val(effect_row), api, span, check.diagnostics)
        allowed: wall ?? return false
        if !allowed -> return false
    }
    ^caller_key: sema_scope_function_owner_key(check.scopes)
    if caller_key != "" || check.scopes.comptime_execution_depth > 0 {
        check.context.call_facts.push(
            SemaCallSiteFact{
                span: span,
                caller_key: caller_key,
                callee: None,
                facts: SemaCallSiteFacts{effect_bound: Val(effect_row), local_lambda: None},
                discarded: false,
                detail: Val(SemaCallSiteDetail{intrinsic_api: Val(api)}),
            },
        )
    }
    true
}

// Fast path for in-place collection and value mutations whose sole effect is
// deny-only `Mem`: omits the unused `SemaCallSiteDetail` payload.
sema_effect_record_mem_intrinsic: fn(check: ^SemaBodyCheck, api: String, span: Span) -> Bool Never! {
    effect_row: [EffectRowEntry]{EffectRowEntry{name: "Mem", span: span}}
    if check.scopes.transaction_wall_depth > 0 {
        ^wall: sema_effect_check_transaction_wall(check.environment.*, check.program.*, check.scopes, Val(effect_row), api, span, check.diagnostics)
        allowed: wall ?? return false
        if !allowed -> return false
    }
    ^caller_key: sema_scope_function_owner_key(check.scopes)
    if caller_key != "" || check.scopes.comptime_execution_depth > 0 {
        check.context.call_facts.push(
            SemaCallSiteFact{
                span: span,
                caller_key: caller_key,
                callee: None,
                facts: SemaCallSiteFacts{effect_bound: Val(effect_row), local_lambda: None},
                discarded: false,
                detail: None,
            },
        )
    }
    true
}

sema_effect_record_fact: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, tree: BodyTree, node_index: Int, expression: BodyNode, fact: SemaCallSiteFact, diagnostics: ^[Diagnostic]) {
    // A call through a `:` local bound to a lambda written in this body adds
    // nothing: that lambda's effects are already this function's where it is
    // written (sema_effect_merge_lambda). The call node itself skips its fact
    // (sema_effect_local_lambda_call), but another body node with the call's
    // span finds the same fact here.
    if fact.facts.local_lambda != None {
        return
    }
    // A foreign body with a known effect root records that root and an open
    // memory dispatch; only an extern with no root, or a C binding whose row no
    // descriptor owns, is an unknown callee that forces the maximal set.
    if fact.detail == .Val(detail) && detail.foreign_effect_root == .Val(root) {
        effect_name: sema_effect_parse_name(root) ?? {
            diagnostics.push(sema_effect_unknown(root, fact.span))
            return
        }
        sema_effect_node_add_direct(nodes, node_index, effect_name, fact.span)
        sema_effect_record_memory_open(nodes, node_index, fact.span, "foreign function body")
        if detail.foreign_opaque && !nodes[node_index].maximal {
            nodes[node_index].maximal = true
            nodes[node_index].maximal_span = Val(fact.span)
        }
        return
    }
    callee_key: if fact.callee == .Val(callee) -> symbol_key(facts.symbols, tree.symbols, callee) else -> ""
    callee_node: if callee_key != "" -> sema_effect_node_index(facts.node_by_key, callee_key) else -> None
    known_callee: callee_node != None
    if callee_key != "" -> sema_effect_node_add_edge(nodes, node_index, callee_key)
    // One call site is one call: another body node with the call's span finds
    // the same fact, and a second row would count the callee's arena bytes
    // twice.
    if callee_node == .Val(callee_row) {
        row: sema_effect_memory_call_key(callee_row, fact.span)
        if nodes[node_index].memory_call_rows.get(row) == None {
            nodes[node_index].memory_call_rows[row] = true
            executions: sema_effect_memory_executions(nodes[node_index], fact.span)
            nodes[node_index].memory_calls.push(SemaMemoryCall{callee: callee_key, span: fact.span, executions: executions})
        }
    }
    row_known: fact.facts.effect_bound != None
    // The closed `core.db` table carries its declared leaves
    // (`DB.Read` on queries, `DB.Write` on `execute`, the `DB` root on
    // transaction control) even though its body reaches only intrinsics.
    declared_row: !known_callee || sema_effect_core_db_callee(callee_key)
    if fact.facts.effect_bound == .Val(effect_row) {
        loop entry in effect_row {
            raw: entry.name
            if raw.starts_with("!") || raw.starts_with("..") -> next
            effect_name: sema_effect_parse_name(raw) ?? {
                // A callee with a body checks its own row where it is
                // written, library effects included (sema_effect_node_from_source).
                if !known_callee -> diagnostics.push(sema_effect_unknown(raw, entry.span))
                next
            }
            if declared_row {
                sema_effect_node_add_direct(nodes, node_index, effect_name, if known_callee -> fact.span else -> entry.span)
            }
        }
    }
    if callee_key == "" && !row_known {
        nodes[node_index].maximal = true
        nodes[node_index].maximal_span = Val(fact.span)
        sema_effect_record_memory_open(nodes, node_index, fact.span, "foreign or dynamically selected function body")
    }
    // A callee with no body in this program has no effects: only its declared
    // row, recorded above, contributes. Its memory behavior stays unproven,
    // unless it is a runtime door (sema_effect_runtime_door_callee). A trait
    // method called through a trait value is no such callee: the call runs
    // the implementations (sema_effect_dispatched_call).
    if callee_key != "" && !known_callee && !row_known && !sema_effect_runtime_door_callee(callee_key) && !sema_effect_dispatched_call(facts, tree, expression) {
        sema_effect_record_memory_open(nodes, node_index, fact.span, "callee body is unavailable and has no verified signed memory summary")
    }
}

// Whether `expression` calls a trait method through a trait value whose
// implementations sema_effect_record_dispatch makes its call edges, so the
// call runs those bodies and not the trait's bodiless declaration. A trait
// under a `#FX` ceiling takes its row from the ceiling and has no edges.
// Another node with the call's span (a body's tail value) finds the same
// fact and holds that call.
sema_effect_dispatched_call: fn(facts: SemaEffectCallIndex, tree: BodyTree, expression: BodyNode) -> Bool Never! {
    if expression.kind == .MethodCall(receiver, method, _, _) {
        trait_owner: method.trait_owner ?? return false
        if type_kind(facts.interner, body_type_id(tree, receiver)) == TypeKind.TraitObject {
            if facts.trait_caps.get(trait_owner.id) == .Val(found) {
                if sema_effect_cap_ceiling(found.cap.cap) != None -> return false
            }
            method_row: sema_effect_method_row(facts.impls, symbol_key(facts.symbols, tree.symbols, trait_owner), method.name)
            return method_row >= 0 && facts.impls.dyn_lists[method_row].len() > 0
        }
        return false
    }
    loop node in tree.nodes {
        if node.span.start == expression.span.start && node.span.end == expression.span.end && node.kind == .MethodCall(_, _, _, _) {
            return sema_effect_dispatched_call(facts, tree, node)
        }
    }
    false
}

// A callee declared in `core.db`. The key alone decides it
// (`kind:module.owner.name`): a collecting thread holds only its own node.
sema_effect_core_db_callee: fn(callee_key: String) -> Bool Never! {
    callee_key.contains(":<corelib>/core.db.")
}

// The module identity prefix of the jet.runtime interface units (Driver
// RuntimeInterface.jet jet_driver_runtime_interface_sources): Core units
// that only the toolchain writes, so no package's module carries it.
SEMA_EFFECT_RUNTIME_DOOR_MODULES: "<corelib>/jet.runtime."

// A member of the jet.runtime interface: Core's body-less `#Import(c)` door
// into the runtime (sema_guest_runtime_binding). It is toolchain code, not an
// open-world body: its declaration is its contract, so its call is no open
// memory dispatch. What it reserves is counted where Core's source states
// it, as an allocator constructor's literal capacity is at the constructor's
// call (sema_call_memory_allocator_name), and the stack proof leaves its
// runtime frame uncounted. The key alone decides it (`kind:module.name`).
sema_effect_runtime_door_callee: fn(callee_key: String) -> Bool Never! {
    (callee_key.split_once(":") ?? return false).after.starts_with(SEMA_EFFECT_RUNTIME_DOOR_MODULES)
}

sema_effect_record_memory_open: fn(nodes: ^[SemaEffectNode], node_index: Int, span: Span, reason: String) Never! {
    source: nodes[node_index].source_display.copy()
    sema_effect_node_rare_open(nodes[node_index])
    if nodes[node_index].rare.in_place() == .Val(rare) {
        rare.memory_opens.push(SemaMemoryOpen{span: span, source: source, reason: reason})
    }
}

// Indices store positions, not copied semantic facts. Caller buckets order
// their positions by span start and then source order, and equal-width
// interval ties and exact duplicates resolve to the first fact in source
// order, just as the original search did. One index serves every module;
// each walk names its module in its caller (SemaEffectCaller), so walks of
// different modules read the one index at once.
SemaEffectCallIndex: struct {
    modules: [SemaEffectModuleCalls],
    node_by_key: SemaEffectNodeKeys,
    // The program's trait implementations: each trait's implementing types,
    // each implementation's own summary key and each method's
    // implementations, the targets of a call through a trait value.
    impls: SemaEffectTraitImpls{SemaEffectTraitImpls{}},
    // Owner type name -> the keys of that type's own `close` methods
    // (`….{Owner}:close`), the targets of `close(value)`.
    close_method_names: NameTable{name_table_sized(4)},
    close_method_rows: [Int]{name_column()},
    close_method_lists: [[String]]{[[String]]{}},
    // The `#FX(…)` cap of each capped trait, by its SymbolID
    // (sema_effect_trait_caps).
    trait_caps: [U32:SemaEffectTypeCap]{[U32:SemaEffectTypeCap]{}},
    // The name of the node each `#Unsafe` function's key names
    // (`node_by_key`), so an unsafe-call check reads no node: its row in
    // `unsafe_name_texts` at the key's id in the node keys' table.
    unsafe_rows: [Int]{name_column()},
    unsafe_name_texts: [String]{[String]{}},
    // The node of each registered declaration with a body, by DeclID row
    // (-1: none), so a direct call finds its callee's node without its key.
    node_by_decl: [Int]{[Int]{}},
    // The run's symbol table: the key of a fact's or a body node's id (a
    // walk reads a body's own ids from its tree).
    symbols: SymbolTable{symbol_table()},
    // Each node's key, in node order, so a walk names its callee's node
    // without reading that node: a collecting thread holds only its own
    // node's row (sema_effect_collect_claimed).
    node_keys: [String]{[String]{}},
    // Each node's module identity, in node order, for the same reason.
    node_modules: [ModuleID]{[ModuleID]{}},
    // The effect each Core scope publisher publishes, by key
    // (effect_scope_published_effect), read off its node before the walks:
    // a collecting thread holds only its own node's row.
    // `published_texts` row at the key's id in the node keys' table.
    published_rows: [Int]{name_column()},
    published_texts: [String]{[String]{}},
    interner: Interner,
}

// The node key of the implementation of method row `method_row` by the type
// whose leaf name has id `owner` in the implementations' names.
sema_effect_trait_impl_of: fn(impls: SemaEffectTraitImpls, method_row: Int, owner: Int) -> String? Never! {
    if method_row < 0 -> return None
    impls.impl_keys.get((method_row << 32) | owner)
}

// The key of a run-wide `id`; a body's own id names no declaration here.
sema_effect_run_key: fn(symbols: SymbolTable, id: SymbolID) -> String? Never! {
    if symbol_is_local(id) -> return None
    Val(symbol_table_key(symbols, id))
}

// The effect node of the declaration `callee`, -1 when it has no body here.
sema_effect_decl_node: fn(facts: SemaEffectCallIndex, callee: DeclID) -> Int Never! {
    index: callee.row.index()
    if index >= facts.node_by_decl.len() -> return -1
    facts.node_by_decl[index]
}

// node_by_decl over the DeclTable's `decl_rows` rows: the node of every key
// a declaration registered (`node_decls`: each node's declaration row, -1
// when none). Of two keys that name one declaration the greater keeps it, as
// a walk in key order leaves it.
sema_effect_nodes_by_decl: fn(node_by_key: SemaEffectNodeKeys, node_decls: [Int], decl_rows: Int) -> [Int] Never! {
    ^rows: (loop _ in 0..<decl_rows -> -1)
    ^row_keys: (loop _ in 0..<decl_rows -> -1)
    loop key_index in 0..<node_by_key.nodes.len() {
        node: node_by_key.nodes[key_index]
        if node < 0 -> next
        row: node_decls[node]
        if row < 0 -> next
        if row_keys[row] >= 0 && node_by_key.names.texts[row_keys[row]] > node_by_key.names.texts[key_index] {
            next
        }
        rows[row] = node
        row_keys[row] = key_index
    }
    rows
}

// The caller a walk reads its call facts under: its module's row in the call
// index and its slot among that module's callers (-1 when it owns no facts).
SemaEffectCaller: struct {
    module_index: Int,
    slot: Int,
}

// A module's call facts by caller. Caller `slot`'s facts are
// `positions[sema_effect_caller_from(calls, slot)..<caller_ends[slot]]`,
// ordered by span start and then source order, so its facts of one start are
// a run found by a binary search.
SemaEffectModuleCalls: struct {
    caller_names: NameTable,
    caller_slots: [Int],
    caller_ends: [Int],
    positions: [Int],
    has_clock_intrinsic: Bool{false},
}

sema_effect_module_calls: fn(facts: [SemaCallSiteFact]) -> SemaEffectModuleCalls Never! {
    ^calls: SemaEffectModuleCalls{caller_names: name_column_table(facts.len() /% 4), caller_slots: name_column(), caller_ends: [Int]{}, positions: [Int]{}, has_clock_intrinsic: false}
    ^slots: [Int]{}
    if facts.len() > 0 {
        slots.try_reserve(facts.len()) ?? ()
        calls.positions.try_reserve(facts.len()) ?? ()
    }
    loop (position, fact) in facts {
        if !calls.has_clock_intrinsic && fact.callee == None && fact.detail == .Val(detail) && detail.intrinsic_api == .Val(api) && api.starts_with("Clock.") {
            calls.has_clock_intrinsic = true
        }
        hash: name_text_hash(fact.caller_key)
        ^slot: name_column_get_hashed(calls.caller_names, calls.caller_slots, fact.caller_key, hash) ?? -1
        if slot < 0 {
            slot = calls.caller_ends.len()
            name_column_set_hashed(calls.caller_names, calls.caller_slots, fact.caller_key, hash, slot)
            calls.caller_ends.push(0)
        }
        calls.caller_ends[slot] = calls.caller_ends[slot] + 1
        slots.push(slot)
        calls.positions.push(position)
    }
    loop slot in 1..<calls.caller_ends.len() {
        calls.caller_ends[slot] = calls.caller_ends[slot] + calls.caller_ends[slot - 1]
    }
    calls.positions.sort_by(fn(left: Int, right: Int) { (slots[left] <=> slots[right]).then(facts[left].span.start <=> facts[right].span.start).then(left <=> right) })
    calls
}

// Where caller `slot`'s facts start in `positions`.
sema_effect_caller_from: fn(calls: SemaEffectModuleCalls, slot: Int) -> Int Never! {
    if slot == 0 -> 0 else -> calls.caller_ends[slot - 1]
}

// Where caller `slot`'s first fact starting at or after `start` is in
// `positions`.
sema_effect_caller_start_at: fn(calls: SemaEffectModuleCalls, module_facts: [SemaCallSiteFact], slot: Int, start: Int) -> Int Never! {
    ^low: sema_effect_caller_from(calls, slot)
    ^high: calls.caller_ends[slot]
    loop low < high {
        middle: (low + high) /% 2
        if module_facts[calls.positions[middle]].span.start < start -> low = middle + 1 else {
            high = middle
        }
    }
    low
}

// The caller `key` of module `module`; its slot is -1 when it owns no facts
// there (or the index has no such module: FailureLaw's structure-only walk).
// A walk resolves its caller once, so the per-expression fact lookups below
// never search the caller map.
sema_effect_caller_slot: fn(index: SemaEffectCallIndex, module_index: Int, key: String) -> SemaEffectCaller Never! {
    if module_index < 0 || module_index >= index.modules.len() {
        return SemaEffectCaller{module_index: module_index, slot: -1}
    }
    SemaEffectCaller{module_index: module_index, slot: name_column_get(index.modules[module_index].caller_names, index.modules[module_index].caller_slots, key) ?? -1}
}

// The position, in the caller's module facts, of the narrowest fact of the
// caller whose span contains or is contained by `span` (the first in source
// order of equal widths); the caller reads the fact in place.
sema_effect_find_fact: fn(index: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], caller: SemaEffectCaller, span: Span) -> Int? Never! {
    if caller.slot < 0 -> return None
    calls: index.modules[caller.module_index]
    exact: sema_effect_exact_position(calls, module_facts, caller.slot, span)
    if exact != None -> return exact
    ^best: -1
    ^best_width: 2147483647
    loop at in sema_effect_caller_from(calls, caller.slot)..<calls.caller_ends[caller.slot] {
        position: calls.positions[at]
        fact_span: module_facts[position].span
        if fact_span.start > span.end -> break
        if sema_effect_span_contains(fact_span, span) || sema_effect_span_contains(span, fact_span) {
            width: fact_span.end - fact_span.start
            if width < best_width || (width == best_width && position < best) {
                best_width = width
                best = position
            }
        }
    }
    if best < 0 -> None else -> Val(best)
}

sema_effect_find_exact_fact: fn(index: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], caller: SemaEffectCaller, span: Span) -> Int? Never! {
    if caller.slot < 0 -> return None
    sema_effect_exact_position(index.modules[caller.module_index], module_facts, caller.slot, span)
}

// The first of caller `slot`'s facts whose span is exactly `span`.
sema_effect_exact_position: fn(calls: SemaEffectModuleCalls, module_facts: [SemaCallSiteFact], slot: Int, span: Span) -> Int? Never! {
    ^at: sema_effect_caller_start_at(calls, module_facts, slot, span.start)
    loop at < calls.caller_ends[slot] && module_facts[calls.positions[at]].span.start == span.start {
        if module_facts[calls.positions[at]].span.end == span.end -> return Val(calls.positions[at])
        at += 1
    }
    None
}

// The caller's Clock intrinsic fact whose span is exactly `span`. A Clock
// method is a declared Core method, so its call fact (with a callee) shares
// the site with the intrinsic fact the time route recorded.
sema_effect_clock_intrinsic_position: fn(index: SemaEffectCallIndex, module_facts: [SemaCallSiteFact], caller: SemaEffectCaller, span: Span) -> Int? Never! {
    if caller.slot < 0 -> return None
    calls: index.modules[caller.module_index]
    if !calls.has_clock_intrinsic -> return None
    ^at: sema_effect_caller_start_at(calls, module_facts, caller.slot, span.start)
    loop at < calls.caller_ends[caller.slot] && module_facts[calls.positions[at]].span.start == span.start {
        position: calls.positions[at]
        at += 1
        fact: module_facts[position]
        if fact.span.end != span.end || fact.callee != None -> next
        if fact.detail == .Val(detail) && detail.intrinsic_api == .Val(api) && api.starts_with("Clock.") {
            return Val(position)
        }
    }
    None
}

sema_effect_is_call: fn(kind: NodeKind) -> Bool Never! {
    if kind == {
        .Call(_, _, _) | .GlobalShared(_, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .StaticCall(_, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .HostCall(_) | .AllocNew(_, _) | .BuiltinMethod(_, _, _) | .ClosureMethod(_, _, _) | .HandleMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .SharedGuardWait(_, _, _) | .CoreClosureCall(_) -> true
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .ConditionNotify(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .DecodeUnder(_, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .OverflowOpt(_, _, _, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> false
    }
}

// Whether a `BuiltinMethod` op can carry a `Mem` (in-place write) or atomic
// effect; read-only builtin methods record no call fact and need no lookup.
sema_effect_builtin_may_have_effect: fn(op: TBuiltinOp) -> Bool Never! {
    if op == {
        .AtomicMethod(_) | .Push | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .StringEdit(_) | .Pop | .PriorityQueuePop | .InsertMap | .AddNewMap | .MapUpdate | .MapMerge | .MapMergeWith | .InsertList | .RemoveMap | .RemoveList(_, _) | .ExtendList | .Reverse | .SwapList | .ListFill | .ListFillRepeat | .Sort | .SortDesc | .Clear | .IterNext | .IterSplit | .MapPopFirst | .ListReplace | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetRemove | .SetPop | .SetReplace | .SetSort | .SortedSetInsert | .SortedSetRemove | .PriorityQueueRemove(_, _) | .LRUPut | .LRUAddNew | .LRUGet | .LRURemove | .BitSetAdd | .BitSetRemove | .ByteBufferWrite(_) | .ByteBufferMethod(_) | .BagAdd | .BagRemove | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequeDelete | .DequeJoin | .DequeReverse | .DequeSplit | .SplitWrite | .GetDisjointWrite | .Zip(_, _, _, _, _, _) | .OptionZip(_) | .ListLazy | .IterShuffle -> true
        .LenString | .LenList | .IsEmpty | .ListTryNew | .ListTryWithCapacity | .CountList | .Counts | .ConcatList | .GetMap | .GetList | .First | .Last | .Contains | .IndexOf | .OrderingThen | .OrderingReverse | .JoinSep | .Sum(_, _) | .Product(_) | .Min(_) | .Max(_) | .Flatten | .Intersperse | .Unzip | .Chars | .Bytes(_) | .StringFromBytes | .StringFromBytesLossy | .StringWithCapacity | .Trim | .TrimStart | .TrimEnd | .PadStart | .PadEnd | .StringIndexOf | .StringCount | .StringIsAlphabetic | .StringIsNumeric | .StringIsWhitespace | .StringIsASCII | .StringToTitle | .StringMethod(_) | .StringSplitOnce | .StringCutLast | .Split | .Lines | .ParseInt | .ParseFloat | .IntToRadix | .IntFromRadix | .StartsWith | .EndsWith | .Replace | .ToUpper | .ToLower | .ToASCIILower | .ToASCIIUpper | .Repeat | .Slice(_) | .After | .Before | .TrimView | .AfterView | .BeforeView | .Keys | .Values | .ContainsKey | .ToString | .Take | .Skip | .IterToList | .IterCollect | .StepBy | .Dedup | .Chunks | .Windows | .IterRepeat | .IterCycle | .IterDropLast | .IterIsSorted | .IterLastIndexOf | .IterAverage(_) | .IterCompare | .ListSlice | .ListEqual | .ListBinarySearch | .ListUnion | .ListIntersection | .ListDifference | .ListRandom | .ListMinMax | .MapEqual | .MapFirst | .MapToList | .MapTopN | .MapMin | .MapMax | .MapIntersection | .MapSliceKeys | .MapFromKeys | .MapContainsValue | .Indexed | .Indexes | .SetFrom | .SetToList | .SetUnion | .SetIntersection | .SetDifference | .SetSymmetricDifference | .SetIsSubset | .SetIsSuperset | .SetIsDisjoint | .SetEqual | .SetCapacity | .SetFirst | .SetValues | .SetShuffle | .SortedSetFrom | .SortedSetToList | .SortedSetUnion | .SortedSetIntersection | .SortedSetDifference | .SortedSetSymmetricDifference | .SortedSetIsSubset | .SortedSetIsSuperset | .SortedSetIsDisjoint | .PriorityQueueFrom | .PriorityQueuePeek | .PriorityQueueToSortedList | .KeyOrdered(_, _) | .LRUCapacity | .LRUKeys | .BitSetCount | .BitSetToList | .ByteBufferFrom | .ByteBufferToBytes | .ByteBufferWithCapacity | .BagHas | .BagCount | .DequePeekFront | .DequePeekBack | .DequeCapacity | .DequeContains | .DequeGet | .DequeToList | .DequeFrom | .TryCollect | .ViewNew(_) -> false
    }
}

// Compiler-owned intrinsic operations have no callee body: host calls
// (Shared access, typed text, `yield`), handle methods (`60s` Duration
// literals and Duration scaling, Dyn accessors, ...), compiler-built
// numeric operations (`1 / 3` as an exact `Fraction`, Decimal and math-type
// arithmetic, numeric casts), the ambient `close(value)` / `drop(value)`
// protocol sugar, and closure intrinsics (`scope.guard`, `on_commit`, task
// spawn), whose lambda bodies the walk visits on their own, and the
// `mem.Fixed` constructors, which take frame or caller storage.
// Their effects are recorded inline (`close`/`drop`/`scope.guard` record none)
// and only opaque callees take the maximal row, so one with no recorded call
// fact contributes no effect; it is not an unknown callee.
sema_effect_is_compiler_intrinsic: fn(kind: NodeKind) -> Bool Never! {
    if kind == {
        .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .HostCall(_) | .HandleMethod(_, _, _) -> true
        .Close(_) | .Drop(_) | .CoreClosureCall(_) | .AllocNew(_, _) -> true
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .Print(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> false
    }
}

sema_effect_merge_lambda: fn(nodes: ^[SemaEffectNode], node_index: Int, lambda: BodyLambda) Never! {
    loop effect_name in lambda.effects.direct {
        ^span: lambda.source_span
        loop entry in lambda.effects.direct_spans {
            if entry.name == effect_name -> span = entry.span
        }
        sema_effect_node_add_direct(nodes, node_index, effect_name, span)
    }
    loop edge in lambda.effects.call_edges -> sema_effect_node_add_edge(nodes, node_index, edge)
    if lambda.effects.maximal {
        nodes[node_index].maximal = true
        nodes[node_index].maximal_span = Val(lambda.source_span)
    }
}

// Whether `kind` calls a lambda written in this body, such as a local bound
// to one with `:`. That lambda's effects are already this function's where it
// is written (sema_effect_merge_lambda), so its call is a known body and adds
// nothing, not an unknown callee's maximal row.
sema_effect_local_lambda_call: fn(tree: BodyTree, kind: NodeKind) -> Bool Never! {
    if kind == .IndirectCall(callee, _, _, _) -> return sema_effect_written_lambda(tree, callee)
    false
}

// Whether the node at `value` is a lambda written in this body: the lambda
// itself, a borrow of one, or a `:` local bound to one. A call that pins its
// arguments reads its callee through a generated `:` binder local, which is
// followed the same way.
sema_effect_written_lambda: fn(tree: BodyTree, value: Int) -> Bool Never! {
    node: body_node(tree, value)
    if node.kind == .Lambda(_) -> return true
    if node.kind == .Borrow(place, _) -> return sema_effect_written_lambda(tree, place)
    if node.kind == .Local(local) {
        if local.mutable || local.symbol_id == None -> return false
        loop statement in tree.stmts {
            if statement == .Let(bound, _, init, _, _, _) {
                if bound.symbol_id != local.symbol_id -> next
                return sema_effect_written_lambda(tree, init)
            }
        }
    }
    false
}

sema_effect_record_unresolved_call: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, tree: BodyTree, node_index: Int, expression: BodyNode) Never! {
    // A direct call and a shared global's initializer name their callee's
    // node through the callee's DeclID.
    if expression.kind == .Call(callee, _, _) {
        return sema_effect_record_decl_call(nodes, facts, node_index, callee, expression.span)
    }
    if expression.kind == .GlobalShared(initializer, _) {
        return sema_effect_record_decl_call(nodes, facts, node_index, initializer, expression.span)
    }
    callee: if expression.kind == {
        .MethodCall(_, method, _, _) -> method.symbol.copy()
        .StaticCall(_, _, method, _, _) -> method.symbol.copy()
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> symbol_none()
    }
    callee_key: if symbol_is_none(callee) -> "" else -> symbol_key(facts.symbols, tree.symbols, callee)
    if {
        callee_key != "" && sema_effect_node_index(facts.node_by_key, callee_key) != None -> {
            sema_effect_node_add_edge(nodes, node_index, callee_key)
        }
        // A named callee with no body in this program has no effects; a
        // runtime door is no open memory dispatch (sema_effect_runtime_door_callee).
        callee_key != "" -> {
            if !sema_effect_runtime_door_callee(callee_key) {
                sema_effect_record_memory_open(nodes, node_index, expression.span, "callee body is unavailable and has no verified signed memory summary")
            }
        }
        else -> {
            nodes[node_index].maximal = true
            nodes[node_index].maximal_span = Val(expression.span)
            sema_effect_record_memory_open(nodes, node_index, expression.span, "foreign or dynamically selected function body")
        }
    }
}

sema_effect_record_decl_call: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, callee: DeclID, span: Span) Never! {
    target: sema_effect_decl_node(facts, callee)
    if target >= 0 -> sema_effect_node_add_edge(nodes, node_index, facts.node_keys[target]) else {
        sema_effect_record_memory_open(nodes, node_index, span, "callee body is unavailable and has no verified signed memory summary")
    }
}

// `attribute_fn_arg`: a named function passed to a function-typed parameter
// flows its effects through to this caller, and the callee may invoke it any
// number of times.
sema_effect_record_function_arguments: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, tree: BodyTree, args: [BodyCallArg]) Never! {
    loop argument in args {
        if type_kind(facts.interner, body_type_id(tree, argument.value)) == TypeKind.Fn {
            value: body_node(tree, argument.value)
            if value.kind == .ConstRef(symbol) {
                key: symbol_key(facts.symbols, tree.symbols, symbol)
                target: sema_effect_node_index(facts.node_by_key, key) ?? next
                sema_effect_node_add_edge(nodes, node_index, key)
                nodes[node_index].memory_call_rows[sema_effect_memory_call_key(target, value.span)] = true
                nodes[node_index].memory_calls.push(SemaMemoryCall{callee: key, span: value.span, executions: None})
            }
        }
    }
}

// The closed effect row of a function-typed slot, or None for no row, an
// open row (`-[..E]>`), or a row that is already its own error.
sema_effect_callback_row: fn(ty: Type) -> SemaEffectCallbackRow? {
    if ty == .Fn(_, _, bound, _, _, _) {
        row: bound ?? return None
        ^parsed: SemaEffectCallbackRow{bound: [String]{}, denied: [String]{}}
        loop entry in row {
            if entry.name.starts_with("..") -> return None
            denial: entry.name.starts_with("!")
            raw: if denial -> entry.name.removeprefix("!") else -> entry.name
            // An unknown or positive `Panic` entry is already its own error;
            // the bound it spoils holds no callback to account.
            effect_name: sema_effect_parse_name(raw) ?? return None
            if denial {
                // A memory denial is proved over memory events (E0921), not
                // over rows, so a callback row does not hold it.
                if sema_effect_root(effect_name) != "Mem" {
                    sema_effect_set_add(parsed.denied, effect_name)
                }
                next
            }
            if sema_effect_root(effect_name) == "Panic" -> return None
            ^_: sema_effect_set_add(parsed.bound, effect_name)
        }
        return Val(parsed)
    }
    None
}

// A named function read whose value type carries a closed effect row records
// that row against the function's node. A function read under its own
// declared row passes trivially; one that took a callback slot's row is
// the obligation sema_effect_check_callback_bounds settles.
sema_effect_record_callback_bound: fn(nodes: ^[SemaEffectNode], node_by_key: SemaEffectNodeKeys, node_index: Int, callee: String, ty: Type, span: Span) {
    row: sema_effect_callback_row(ty) ?? return
    if sema_effect_node_index(node_by_key, callee) == None {
        return
    }
    sema_effect_node_rare_open(nodes[node_index])
    if nodes[node_index].rare.in_place() == .Val(rare) {
        rare.callback_bounds.push(SemaEffectCallbackBound{callee: callee, row: row, span: span})
    }
}

// A lambda whose value type carries a closed effect row (the row of the slot
// it fills, or its own written row) records its own row: its call facts, and
// what a walk of its body charges (loops, value reads, stops), on a node
// appended to `nodes` for the walk and removed again. A lambda handed the
// root's `Compiler` value (a `meta.events` handler) records the same as a
// compiler hook (sema_effect_check_compiler_hooks).
sema_effect_record_lambda_bound: fn(nodes: ^[SemaEffectNode], node_index: Int, facts: SemaEffectCallIndex, caller: SemaEffectCaller, tree: BodyTree, lambda: BodyLambda, ty: Type, span: Span) {
    row: sema_effect_callback_row(ty)
    hook: sema_effect_compiler_hook_param(if ty == .Fn(params, _, _, _, _, _) -> params else -> [Type]{})
    if row == None && hook == None {
        return
    }
    // The adapter the compiler writes around an App handler
    // (sema_app_handler_adapter) is no function value the program passes:
    // the function registering the handler already carries the handler's
    // effects, so the App's internal handler slot holds it to no row.
    if lambda.source_params.len() == 1 && lambda.source_params[0] == SEMA_APP_ADAPTER_PARAM {
        return
    }
    // copy: the lambda node starts from its owner's facts and spans; the
    // owner node stays in the graph.
    ^lambda_node: nodes[node_index].copy()
    lambda_node.key = "{nodes[node_index].key}#lambda@{lambda.source_span.start}"
    lambda_node.direct = [String]{}
    lambda_node.direct_spans = [TEffectSpan]{}
    lambda_node.call_edges = [String]{}
    lambda_node.maximal = false
    lambda_node.maximal_span = None
    if lambda_node.rare.in_place() == .Val(rare) {
        rare.callback_bounds = [SemaEffectCallbackBound]{}
        rare.lambda_bounds = [SemaEffectLambdaBound]{}
        rare.hook_lambdas = [SemaEffectHookLambda]{}
    }
    nodes.push(lambda_node)
    lambda_index: nodes.len() - 1
    sema_effect_merge_lambda(nodes, lambda_index, lambda)
    ^ignored: [Diagnostic]{}
    sema_effect_walk_lambda_children(SemaEffectWalk.LambdaBody{node_index: lambda_index}, nodes, facts, [SemaCallSiteFact]{}, ignored, caller, tree, lambda)
    ^walked: nodes.pop() ?? panic("the lambda's row node left the graph")
    sema_effect_node_settle_edges(walked)
    sema_effect_node_rare_open(nodes[node_index])
    if nodes[node_index].rare.in_place() == .Val(rare) {
        if hook == .Val(taken) {
            rare.hook_lambdas.push(SemaEffectHookLambda{direct: walked.direct, call_edges: walked.call_edges, maximal: walked.maximal, taken: taken, span: span})
        }
        if row == .Val(bound) {
            rare.lambda_bounds.push(SemaEffectLambdaBound{direct: walked.direct.move(), call_edges: walked.call_edges.move(), maximal: walked.maximal, row: bound, span: span})
        }
    }
}

// E0747: a named function's contract is its declared row (or `-[]>`); an
// undeclared function is judged by its solved row. A denial is judged by the
// solved row, which holds the deny-only rights (`Panic`, `Mem`); one the
// function's own row already denies is its own E0749.
sema_effect_check_callback_bounds: fn(nodes: [SemaEffectNode], node_by_key: SemaEffectNodeKeys, solved: [[String]], node_index: Int, diagnostics: ^[Diagnostic]) {
    rare: nodes[node_index].rare ?? return
    loop obligation in rare.callback_bounds {
        target: sema_effect_node_index(node_by_key, obligation.callee) ?? next
        row: if nodes[target].has_declared_row || nodes[target].is_pure -> nodes[target].declared else -> solved[target]
        over: sema_effect_uncovered(row, obligation.row.bound)
        if over.len() > 0 {
            diagnostics.push(sema_effect_callback_diagnostic(over, obligation.row.bound, obligation.span))
        }
        ^denied: [String]{}
        loop name in sema_effect_covered(solved[target], obligation.row.denied) {
            if !sema_effect_is_covered_by(name, nodes[target].prohibited) {
                sema_effect_set_add(denied, name)
            }
        }
        if denied.len() > 0 {
            diagnostics.push(sema_effect_callback_denied_diagnostic(denied, obligation.row, obligation.span))
        }
    }
    loop obligation in rare.lambda_bounds {
        ^inferred: obligation.direct.copy()
        if obligation.maximal -> sema_effect_set_union(inferred, authority_grantable_roots())
        loop edge in obligation.call_edges {
            if edge == "__jet_panic__" {
                sema_effect_set_add(inferred, "Panic")
                next
            }
            target: sema_effect_node_index(node_by_key, edge) ?? next
            sema_effect_set_union(inferred, solved[target])
        }
        over: sema_effect_uncovered(inferred, obligation.row.bound)
        if over.len() > 0 {
            diagnostics.push(sema_effect_callback_diagnostic(over, obligation.row.bound, obligation.span))
        }
        denied: sema_effect_covered(inferred, obligation.row.denied)
        if denied.len() > 0 {
            diagnostics.push(sema_effect_callback_denied_diagnostic(denied, obligation.row, obligation.span))
        }
    }
}

// A call through a trait value runs whichever implementation the value
// holds. A trait method's declared row bounds it (recorded with the call).
// Otherwise the trait's `#FX(…)` ceiling is its row, and with no ceiling it
// takes the union of every implementation of the method in the program,
// inherited defaults included. A trait with no implementation is the
// open-world dispatch (E0743 under a ceiling).
sema_effect_record_dispatch: fn(nodes: ^[SemaEffectNode], facts: SemaEffectCallIndex, node_index: Int, tree: BodyTree, expression: BodyNode, fact: SemaCallSiteFact) Never! {
    if fact.facts.effect_bound != None {
        return
    }
    if expression.kind == {
        .MethodCall(receiver, method, _, _) -> {
            trait_owner: method.trait_owner ?? return
            if body_type(facts.interner, tree, receiver) == {
                .TraitObject(_) -> {}
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return
            }
            owner_key: symbol_key(facts.symbols, tree.symbols, trait_owner)
            method_row: sema_effect_method_row(facts.impls, owner_key, method.name)
            if facts.trait_caps.get(trait_owner.id) == .Val(found) {
                // A bare `#FX` above the trait is the empty ceiling: the
                // dispatch reaches nothing.
                if sema_effect_cap_ceiling(found.cap.cap) == .Val(ceiling) {
                    loop effect_name in ceiling {
                        sema_effect_node_add_direct(nodes, node_index, effect_name, fact.span)
                    }
                    return
                }
            }
            if method_row < 0 || facts.impls.dyn_lists[method_row].len() == 0 {
                nodes[node_index].dispatches.push(TEffectSpan{name: "{symbol_key_leaf(owner_key)}.{method.name}", span: fact.span})
                return
            }
            loop impl_key in facts.impls.dyn_lists[method_row] {
                sema_effect_node_add_edge(nodes, node_index, impl_key)
            }
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .TypePath(_) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
