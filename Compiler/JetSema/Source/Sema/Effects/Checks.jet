// Effect rows and checked unsafe-boundary facts.
//
// The effect graph is a semantic projection over TIR and the call facts already
// recorded by Sema.  It does not resolve names, own a second scope table, or
// infer a new type relation.  Direct rows are collected from checked calls and
// TIR sentinels, then one fixed-point solver projects the same solved row back
// onto every TFunc.
//
// Effect names are canonical dotted paths.  The roots are closed; descendants
// below a known root are open declaration leaves.  Panic and Mem are retained
// for denial/reachability facts but are deny-only and never become positive
// grants.
use jet_foundation.[
    Diagnostic,
    EffectRowEntry,
    Func,
    FunctionDefaultRef,
    Item,
    NamedSpan,
    Span,
    Stmt,
    SymbolKind,
    TContract,
    TEffectFacts,
    TEffectSpan,
    TExpr,
    TFailureCarrier,
    TFunc,
    TIfCond,
    TLambda,
    TStmt,
    Type,
    diagnostic_with_rights,
    diagnostic_with_source_derived_suggestion,
    symbol_id,
    tir_expr_children,
    tir_stmt_children,
    type_name,
]

pub struct SemaEffectFunctionSource {
    pub key: String
    pub name: String
    pub span: Span
    // The function's name, where trait-bound reports (E0742) point.
    pub name_span: Span?{None}
    pub declared_effects: [EffectRowEntry]?
    pub is_pure: Bool
    pub is_replayable: Bool
    pub is_unsafe: Bool
    pub unsafe_reason: String?
    pub unsafe_span: Span?
    pub replayable_span: Span?
    pub effect_via: NamedSpan?
    // D-EFF1: the body's `#FX(…)` regions with valid cap lists (E0712).
    pub fx_regions: [SemaEffectFxRegion]{[SemaEffectFxRegion]{}}
    // D-AUTHORITY-MEM2: loop statement spans; memory work inside one has no
    // static execution count.
    pub loop_spans: [Span]{[Span]{}}
    // D-DET1: `assume_deterministic` blocks suspend E3403.
    pub assume_det_spans: [Span]{[Span]{}}
}

// One `#FX(…)` region: its parsed caps, the head span E0712 points at, and
// the block span its `TStmt.Region` lowering keeps.
pub struct SemaEffectFxRegion {
    pub caps: [String]
    pub caps_span: Span
    pub span: Span
}

pub struct SemaEffectModuleInput {
    pub module_identity: String
    pub functions: [TFunc]
    pub sources: [SemaEffectFunctionSource]
    pub call_facts: [SemaCallSiteFact]
    pub source_segments: [SemaSourceSegment]
    // D-EFF3 trait-method effect ceilings this module declares (E0742).
    pub trait_bounds: [SemaEffectTraitBound]{[SemaEffectTraitBound]{}}
}

// One bounded trait method: an impl of `trait_name.method` may use only the
// effects in `bound` (`-[]>` is the empty bound).
pub struct SemaEffectTraitBound {
    pub trait_name: String
    pub method: String
    pub bound: [String]
}

pub struct SemaEffectModuleResult {
    pub module_identity: String
    pub functions: [TFunc]
    pub diagnostics: [Diagnostic]
    pub complete: Bool
}

pub struct SemaEffectGraphResult {
    pub modules: [SemaEffectModuleResult]
    pub diagnostics: [Diagnostic]
    pub complete: Bool
}

// One memory operation a body performs directly (Rust `MemoryEvent`): `kind`
// is "alloc", "rc" or "arena"; an arena event's `bytes` is its proven upper
// bound (None is unprovable); `executions` is None inside a loop.
struct SemaMemoryEvent {
    span: Span
    operation: String
    kind: String{"alloc"}
    bytes: Int?{None}
    executions: Int?{Val(1)}
}

// A call site to a user function, for arena multiplicity (Rust `MemoryCall`).
struct SemaMemoryCall {
    callee: String
    span: Span
    executions: Int?
}

// A place a strict memory fact cannot see through (Rust `OpenMemoryDispatch`).
struct SemaMemoryOpen {
    span: Span
    source: String
    reason: String
}

// The first violation on a path: an event (in node `owner`) or an open
// dispatch, and the arena bytes used up to it.
struct SemaMemoryFinding {
    event: SemaMemoryEvent?
    owner: Int
    open: SemaMemoryOpen?
    path: [String]
    used: Int
}

// Rust `ArenaProof`, or the finding that stops the proof.
struct SemaMemoryArena {
    bytes: Int
    witness: SemaMemoryFinding?
    failure: SemaMemoryFinding?
}

fn sema_effect_is_fixed_list(ty: Type) -> Bool Never! {
    if ty == {
        .FixedList(_, _) -> true
        else -> false
    }
}

fn sema_effect_source_display(path: String) -> String Never! {
    parts :: path.split("/").to_list()
    if parts.len() == 0 -> path else -> parts[parts.len() - 1]
}

struct SemaEffectNode {
    key: String
    name: String
    module_identity: String
    module_index: Int
    span: Span
    name_span: Span
    direct: [String]
    direct_spans: [TEffectSpan]
    call_edges: [String]
    maximal: Bool
    maximal_span: Span?
    declared: [String]
    prohibited: [String]
    has_declared_row: Bool
    is_pure: Bool
    is_replayable: Bool
    replayable_span: Span?
    is_unsafe: Bool
    unsafe_reason: String?
    unsafe_span: Span?
    effect_via: NamedSpan?
    // Calls through a trait value whose trait method declares no effect row
    // (`Trait::method` at the call). A ceiling above them is E0743.
    dispatches: [TEffectSpan]
    // D-AUTHORITY-MEM1: the memory operations this body performs directly
    // and the `-[!Mem.*]>` denials its signature declares (E0921).
    memory_events: [SemaMemoryEvent]{[SemaMemoryEvent]{}}
    memory_denials: [EffectRowEntry]{[EffectRowEntry]{}}
    // User-function call sites and loop spans for arena multiplicity.
    memory_calls: [SemaMemoryCall]{[SemaMemoryCall]{}}
    memory_opens: [SemaMemoryOpen]{[SemaMemoryOpen]{}}
    loop_spans: [Span]{[Span]{}}
    assume_det_spans: [Span]{[Span]{}}
    // `module::name` in call paths and the source file name in reports.
    display_key: String{""}
    source_display: String{""}
}

pub fn sema_effect_source_from_function(func: Func, module_identity: String) -> SemaEffectFunctionSource Never! {
    SemaEffectFunctionSource{
        key: symbol_id(SymbolKind.Function, module_identity, "", func.name).key,
        name: func.name,
        span: func.span,
        name_span: Val(func.name_span),
        declared_effects: func.declared_effects,
        is_pure: func.is_pure,
        is_replayable: func.is_replayable,
        is_unsafe: func.is_unsafe,
        unsafe_reason: func.unsafe_reason,
        unsafe_span: func.unsafe_span,
        replayable_span: func.replayable_span,
        effect_via: func.effect_via,
        fx_regions: sema_authority_fx_regions(func.body),
        loop_spans: sema_effect_statement_spans(func.body, false),
        assume_det_spans: sema_effect_statement_spans(func.body, true),
    }
}

// The spans of the body's loop statements, or of its `assume_deterministic`
// blocks when `assume_det` is set.
fn sema_effect_statement_spans(statements: [Stmt], assume_det: Bool) -> [Span] {
    spans := [Span]{}
    sema_effect_collect_statement_spans(statements, assume_det, &spans)
    spans
}

fn sema_effect_collect_statement_spans(statements: [Stmt], assume_det: Bool, spans: &[Span]) {
    loop statement in statements {
        if statement == {
            .While(_, body, span, _, _) | .For(_, _, _, _, body, span, _, _, _) | .Loop(body, span, _, _) | .CountedLoop(_, _, _, body, span, _, _) -> {
                if !assume_det -> &spans.push(span)
                sema_effect_collect_statement_spans(body, assume_det, &spans)
            }
            .AssumeDet(_, _, body, span) -> {
                if assume_det -> &spans.push(span)
                sema_effect_collect_statement_spans(body, assume_det, &spans)
            }
            .Unsafe(_, _, body, _)
            | .Impure(_, _, body, _)
            | .Reactive(body, _)
            | .Shield(body, _)
            | .Switched(_, body, _)
            | .Region(_, _, body, _)
            | .Policy(_, body, _)
            | .TaskGroup(_, _, _, body, _)
            | .Layout(_, _, body, _)
            | .AuthorityScope(_, _, _, body, _)
            | .ContextBlock(_, body, _)
            | .Live(body, _)
            | .Transact(_, _, body, _, _)
            | .ScopeMember(_, _, _, _, body, _, _, _) -> sema_effect_collect_statement_spans(body, assume_det, &spans)
            .Switch(_, arms, else_body, _) -> {
                loop arm in arms -> sema_effect_collect_statement_spans(arm.body, assume_det, &spans)
                if else_body == .Val(body) -> sema_effect_collect_statement_spans(body, assume_det, &spans)
            }
            .ComptimeIf(_, _, then_body, else_body, _, _) -> {
                sema_effect_collect_statement_spans(then_body, assume_det, &spans)
                if else_body == .Val(body) -> sema_effect_collect_statement_spans(body, assume_det, &spans)
            }
            else -> {}
        }
    }
}

// E2-M16 (Rust core-call E3403): a non-deterministic Core call (a `Time` or
// `Rand` row) inside a pure function, outside `assume_deterministic`.
fn sema_effect_nondeterministic_core(node: SemaEffectNode, expression: TExpr, fact: SemaCallSiteFact) -> String? {
    if !node.is_pure || fact.callee != None -> return None
    api := ""
    if expression.kind == .CoreCall(record, _, _, _, _, _, _) {
        parts :: record.module_name.split(".").to_list()
        if parts.len() > 0 -> api = "{parts[parts.len() - 1]}.{record.member}"
    }
    if api == "" -> return None
    row :: fact.facts.effect_bound ?? return None
    loop span in node.assume_det_spans {
        if sema_effect_span_contains(span, expression.span) -> return None
    }
    loop entry in row {
        if entry.name.starts_with("!") -> next
        root :: sema_effect_root(entry.name)
        if root == "Time" || root == "Rand" -> return Val(api)
    }
    None
}

// Rust `memory_control_multiplier`: one execution, or None inside a loop.
fn sema_effect_memory_executions(node: SemaEffectNode, span: Span) -> Int? {
    loop loop_span in node.loop_spans {
        if sema_effect_span_contains(loop_span, span) -> return None
    }
    Val(1)
}

fn sema_effect_push_memory_event(nodes: &[SemaEffectNode], node_index: Int, span: Span, operation: String, kind: String, bytes: Int?) {
    executions :: sema_effect_memory_executions(nodes[node_index], span)
    &nodes[node_index].memory_events.push(SemaMemoryEvent{span: span, operation: operation, kind: kind, bytes: bytes, executions: executions})
}

pub fn sema_effect_source_from_function_key(func: Func, module_identity: String, key: String) -> SemaEffectFunctionSource Never! {
    source := sema_effect_source_from_function(func, module_identity)
    source.key = key
    source
}

// ────────────────────────────────────────────────────────────────────────────
// Canonical effect vocabulary and set operations

pub fn sema_effect_grantable_roots() -> [String] Never! {
    [String]{"Net", "FS", "IO", "DB", "Time", "Rand", "Env", "Exec", "Log", "GPU", "FFI", "Browser", "Secret"}
}

fn sema_effect_known_root(root: String) -> Bool Never! {
    if root == "Panic" || root == "Mem" -> return true
    loop candidate in sema_effect_grantable_roots() {
        if candidate == root -> return true
    }
    false
}

pub fn sema_effect_root(name: String) -> String Never! {
    base := name
    if base.contains("(") {
        parts :: base.split("(").to_list()
        if parts.len() > 0 -> base = parts[0]
    }
    parts :: base.split(".").to_list()
    if parts.len() == 0 -> base else -> parts[0]
}

fn sema_effect_rank(name: String) -> Int Never! {
    root :: sema_effect_root(name)
    if root == {
        "Net" -> 0
        "FS" -> 1
        "IO" -> 2
        "DB" -> 3
        "Time" -> 4
        "Rand" -> 5
        "Env" -> 6
        "Exec" -> 7
        "Log" -> 8
        "GPU" -> 9
        "FFI" -> 10
        "Browser" -> 11
        "Secret" -> 12
        "Panic" -> 13
        "Mem" -> 14
        else -> 100
    }
}

fn sema_effect_set_contains(set: [String], value: String) -> Bool Never! {
    loop item in set {
        if item == value -> return true
    }
    false
}

fn sema_effect_set_add(set: &[String], value: String) -> Bool Never! {
    if sema_effect_set_contains(set, value) -> return false
    &set.push(value)
    index := set.len() - 1
    loop index > 0 {
        left :: sema_effect_rank(set[index - 1])
        right :: sema_effect_rank(set[index])
        if left < right || (left == right && set[index - 1] <= set[index]) -> break
        swap := set[index - 1]
        set[index - 1] = set[index]
        set[index] = swap
        index -= 1
    }
    true
}

fn sema_effect_set_union(target: &[String], values: [String]) -> Bool Never! {
    changed := false
    loop value in values {
        if sema_effect_set_add(&target, value) -> changed = true
    }
    changed
}

pub fn sema_effect_covers(bound: String, effect_name: String) -> Bool Never! {
    if bound == effect_name -> return true
    prefix :: "{bound}."
    effect_name.starts_with(prefix)
}

pub fn sema_effect_parse_name(name: String) -> String? {
    if name == "" || name.starts_with("..") -> return None
    base := name
    if base.contains("(") {
        parts :: base.split("(").to_list()
        if parts.len() != 2 -> return None
        closing :: parts[1].split(")").to_list()
        if closing.len() != 2 || closing[1] != "" -> return None
        base = parts[0]
        if base != "Mem.Alloc" -> return None
        arguments :: closing[0].trim().split(":").to_list()
        if arguments.len() != 2 || arguments[0].trim() != "above" -> return None
        amount :: Int.parse(arguments[1].trim()) ?? return None
        if amount <= 0 -> return None
    }
    root :: sema_effect_root(base)
    if !sema_effect_known_root(root) -> return None
    loop segment in base.split(".") {
        if segment == "" -> return None
    }
    Val(name)
}

fn sema_effect_without_deny_only(values: [String]) -> [String] Never! {
    result := [String]{}
    loop value in values {
        root :: sema_effect_root(value)
        if root != "Panic" && root != "Mem" -> sema_effect_set_add(&result, value)
    }
    result
}

fn sema_effect_uncovered(inferred: [String], bounds: [String]) -> [String] Never! {
    result := [String]{}
    loop effect_name in sema_effect_without_deny_only(inferred) {
        covered :: loop bound in bounds {
            if sema_effect_covers(bound, effect_name) -> break true
        } ?? false
        if !covered -> sema_effect_set_add(&result, effect_name)
    }
    result
}

fn sema_effect_covered(inferred: [String], prohibited: [String]) -> [String] Never! {
    result := [String]{}
    loop effect_name in inferred {
        loop bound in prohibited {
            if sema_effect_covers(bound, effect_name) {
                sema_effect_set_add(&result, effect_name)
                break
            }
        }
    }
    result
}

pub fn sema_effect_authority_deny_covered(denies: [String], inferred: [String]) -> [String] Never! {
    prohibited := [String]{}
    loop raw in denies {
        effect_name := raw
        if raw.starts_with("!") {
            pieces :: raw.split("!").to_list()
            if pieces.len() <= 1 -> next
            effect_name = pieces[1]
        }
        parsed :: sema_effect_parse_name(effect_name)
        if parsed == .Val(value) -> sema_effect_set_add(&prohibited, value)
    }
    sema_effect_covered(inferred, prohibited)
}

fn sema_effect_show(values: [String]) -> String Never! {
    values.join(", ")
}


fn sema_effect_span_contains(outer: Span, inner: Span) -> Bool Never! {
    outer.start <= inner.start && inner.end <= outer.end
}

fn sema_effect_declarations_irreversible_fact(declarations: [Item], effect_name: String) -> Bool? {
    found := false
    irreversible := false
    loop item in declarations {
        if item == {
            .EffectDecl(declaration) -> {
                if sema_effect_root(declaration.name) == sema_effect_root(effect_name) {
                    found = true
                    if declaration.irreversible -> irreversible = true
                }
            }
            else -> {}
        }
    }
    if found -> Val(irreversible) else -> None
}

// The transaction wall follows the canonical `effect … $irreversible`
// declarations loaded from the pinned Prelude module. It deliberately does
// not maintain a second root allowlist: adding or removing an irreversible
// effect in Prelude/Effects.jet changes this fact at the source boundary.
fn sema_effect_canonical_irreversible_fact(environment: SemaScopeEnvironment, effect_name: String) -> Bool? {
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return None
    canonical_identity :: graph.canonical_effect_module_identity
    if canonical_identity == "" -> return None
    module_index :: sema_registration_module_index(graph, canonical_identity) ?? return None
    if graph.modules[module_index].package_identity != JET_CANONICAL_EFFECT_PACKAGE_IDENTITY || graph.modules[module_index].module_path != JET_CANONICAL_EFFECT_MODULE_PATH -> return None
    sema_effect_declarations_irreversible_fact(graph.modules[module_index].program.items, effect_name)
}

pub fn sema_effect_root_is_irreversible(environment: SemaScopeEnvironment, effect_name: String) -> Bool? {
    sema_effect_canonical_irreversible_fact(environment, effect_name)
}

pub fn sema_effect_transaction_wall_diagnostic(api: String, effect_name: String, span: Span) -> Diagnostic {
    effect_root :: sema_effect_root(effect_name)
    diagnostic :: if effect_root == "FFI" -> sema_error("E0746", span, "`{api}` has the `FFI` effect, which can't be rolled back inside a `#Transact` block", "a foreign function can change external state that the compiler cannot undo automatically", "move this call after the block, or declare `#Undo(inverse)` on the foreign binding so rollback can call the inverse") else -> sema_error("E0746", span, "`{api}` has the `{effect_root}` effect, which can't be rolled back inside a `#Transact` block", "a `#Transact` block undoes its work on a `?`-failure; a network, file, or subprocess effect (`{effect_root}`) leaves committed external state a rollback can't take back", "move this call after the block, or register it with `<handle>.on_commit(() -> {{ … }})` so it runs only on a clean commit")
    diagnostic_with_rights(^diagnostic, "transaction", [String]{api}, [String]{}, None)
}

// Check a call's declared effect row at the authored-transaction wall. The
// caller supplies the canonical API spelling because TIR call nodes may no
// longer retain the registration module/member pair.
pub fn sema_effect_check_transaction_wall(environment: SemaScopeEnvironment, scopes: SemaScopeTable, effect_row: [EffectRowEntry]?, api: String, span: Span, diagnostics: &[Diagnostic]) -> Bool? {
    if scopes.transaction_wall_depth <= 0 -> return Val(true)
    row :: effect_row ?? return Val(true)
    loop entry in row {
        if entry.name.starts_with("!") || entry.name.starts_with("..") -> next
        parsed :: sema_effect_parse_name(entry.name) ?? next
        irreversible :: sema_effect_root_is_irreversible(environment, parsed) ?? return None
        if irreversible {
            &diagnostics.push(sema_effect_transaction_wall_diagnostic(api, parsed, span))
            return Val(false)
        }
    }
    Val(true)
}

pub fn sema_effect_call_api(value: TExpr) -> String Never! {
    if value.kind == {
        .CoreCall(record, _, _, _, _, _, _) -> "{record.module_name}.{record.member}"
        .Call(callee, _, _) -> callee.key
        .MethodCall(_, method, _, _) -> method.name
        .IndirectCall(_, _, _, _) -> "indirect call"
        .BuiltinMethod(_, _, _) | .ClosureMethod(_, _, _) | .HandleMethod(_, _, _) -> "intrinsic method"
        .AllocNew(_, _) -> "intrinsic allocation"
        .SharedGuardWait(_, _, _) -> "shared guard wait"
        .CoreClosureCall(_) -> "core closure intrinsic"
        else -> "call"
    }
}

// ────────────────────────────────────────────────────────────────────────────
// Diagnostics and explicit audit gates
// ────────────────────────────────────────────────────────────────────────────

pub fn sema_effect_unknown(name: String, span: Span) -> Diagnostic {
    sema_error("E0119", span, "`{name}` isn't a known effect", "an effect list names compiler-known effects such as `Net`, `FS`, `IO`, `DB`, or `Time`", "use a known effect name, or remove it from the list")
}

fn sema_effect_positive_panic(span: Span) -> Diagnostic {
    sema_error("E0751", span, "`Panic` can't be granted, only denied", "`Panic` is a deny-only effect row; no positive effect bound or authority can grant it", "drop `Panic` from the list, or write `-[!Panic]>`")
}

pub fn sema_effect_check_unsafe_region(reason: String?, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if (reason ?? "").len() > 0 -> return true
    &diagnostics.push(sema_error("E3112", span, "this `#Unsafe` block has no reason", "every audited region must record why it cannot break memory safety", "add the reason: `#Unsafe(\"why this is safe\") {{ … }}`"))
    false
}

pub fn sema_effect_check_unsafe_function(source: SemaEffectFunctionSource, diagnostics: &[Diagnostic]) -> Bool {
    if !source.is_unsafe -> return true
    sema_effect_check_unsafe_region(source.unsafe_reason, source.unsafe_span ?? source.span, &diagnostics)
}

pub fn sema_effect_require_unsafe_call(callee: String, callee_is_unsafe: Bool, audited: Bool, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if !callee_is_unsafe || audited -> return true
    &diagnostics.push(sema_error("E3103", span, "`{callee}` is an `#Unsafe` function", "its contract can't be checked by the compiler, so the caller must vouch for it", "call it inside `#Unsafe(\"…\") {{ … }}`"))
    false
}

pub fn sema_effect_check_tfunc_unsafe(function: TFunc, diagnostics: &[Diagnostic]) -> Bool {
    if !function.is_unsafe -> return true
    sema_effect_check_unsafe_region(function.unsafe_gate.map((gate) -> gate.reason), function.source_span, &diagnostics)
}

fn sema_effect_via_unknown_parameter(function: TFunc, parameter: String, span: Span) -> Diagnostic {
    sema_error("E0748", span, "`-[via {parameter}]>` on `{function.name}` names no such parameter", "`-[via f]>` publishes the effects of a callback parameter, but this function has no parameter named `{parameter}`", "name one of the function's callback parameters after `via`")
}

fn sema_effect_via_not_callback(function: TFunc, parameter: String, ty: Type, span: Span) -> Diagnostic {
    sema_error("E0748", span, "`-[via {parameter}]>` on `{function.name}` names a parameter that isn't a callback", "`{parameter}` has type `{type_name(ty)}`, not a function type with an effect row", "point `via` at a function parameter, or remove the `via` annotation")
}

fn sema_effect_apply_via(nodes: &[SemaEffectNode], node_index: Int, function: TFunc, diagnostics: &[Diagnostic]) {
    via :: nodes[node_index].effect_via ?? return
    parameter_type := Type?{None}
    loop parameter in function.params {
        if parameter.name == via.name {
            parameter_type = Val(parameter.ty)
            break
        }
    }
    callback_type :: parameter_type ?? {
        &diagnostics.push(sema_effect_via_unknown_parameter(function, via.name, via.span))
        return
    }
    if callback_type == {
        .Fn(_, _, effect_bound, _, _, _) -> if effect_bound == {
            .Val(effect_row) -> loop entry in effect_row {
                if entry.name.starts_with("..") -> next
                raw := entry.name
                if raw.starts_with("!") {
                    pieces :: raw.split("!").to_list()
                    if pieces.len() > 1 -> raw = pieces[1]
                }
                effect_name :: sema_effect_parse_name(raw) ?? {
                    &diagnostics.push(sema_effect_unknown(raw, entry.span))
                    next
                }
                if sema_effect_root(effect_name) == "Panic" {
                    &diagnostics.push(sema_effect_positive_panic(entry.span))
                    next
                }
                sema_effect_node_add_direct(&nodes, node_index, effect_name, entry.span)
            }
            .None -> {
                nodes[node_index].maximal = true
                nodes[node_index].maximal_span = Val(via.span)
            }
        }
        else -> &diagnostics.push(sema_effect_via_not_callback(function, via.name, callback_type, via.span))
    }
}

fn sema_effect_bound_diagnostic(node: SemaEffectNode, over: [String]) -> Diagnostic {
    declared :: if node.declared.len() == 0 -> "no effects" else -> "`-[{sema_effect_show(node.declared)}]>`"
    sema_error("E0740", node.span, "`{node.name}` uses the effect `{sema_effect_show(over)}`, which its signature doesn't allow", "the signature declares {declared}, so the body may only use those effects", "add `{sema_effect_show(over)}` to the effect list, or stop using it in `{node.name}`")
}

fn sema_effect_prohibited_diagnostic(node: SemaEffectNode, reached: [String]) -> Diagnostic {
    sema_error("E0749", node.span, "`{node.name}` reaches the `{sema_effect_show(reached)}` effect, which it prohibits", "a prohibited effect row applies to the function and every callee it can reach", "remove the call that introduces `{sema_effect_show(reached)}`, or drop the prohibition")
}

fn sema_effect_pure_diagnostic(node: SemaEffectNode, reached: [String]) -> Diagnostic {
    sema_error("E3401", node.span, "`{node.name}` calls or reaches impure effects `{sema_effect_show(reached)}`", "a pure function must produce the same result without ambient effects", "remove the call that introduces `{sema_effect_show(reached)}`, or drop the `-[]>` bound from `{node.name}` so its effects are inferred")
}

fn sema_effect_replayable_diagnostic(node: SemaEffectNode, reached: [String]) -> Diagnostic {
    span :: node.replayable_span ?? node.span
    sema_error("E0725", span, "`{node.name}` is `#Replayable` but reaches `{sema_effect_show(reached)}`", "replayable code must use explicit deterministic inputs rather than ambient time, randomness, network, or console IO", "inject a deterministic provider or move the ambient effect outside the replayable function")
}

// ────────────────────────────────────────────────────────────────────────────
// Summary construction

struct SemaEffectSourceIndex {
    by_key: [String:Int]
    by_name: [String:Int]
}

fn sema_effect_source_index(sources: [SemaEffectFunctionSource]) -> SemaEffectSourceIndex Never! {
    index := SemaEffectSourceIndex{by_key: [String:Int]{}, by_name: [String:Int]{}}
    loop (position, source) in sources {
        if index.by_key.get(source.key) == None -> index.by_key[source.key] = position
        if index.by_name.get(source.name) == None -> index.by_name[source.name] = position
    }
    index
}

fn sema_effect_source_for(function: TFunc, sources: [SemaEffectFunctionSource], index: SemaEffectSourceIndex) -> SemaEffectFunctionSource? {
    position :: index.by_key.get(function.key) ?? {
        index.by_name.get(function.name) ?? return None
    }
    Val(sources[position])
}

fn sema_effect_node_add_direct(nodes: &[SemaEffectNode], node_index: Int, name: String, span: Span) Never! {
    if sema_effect_set_add(&nodes[node_index].direct, name) {
        &nodes[node_index].direct_spans.push(TEffectSpan{name: name, span: span})
    }
}

fn sema_effect_node_add_edge(nodes: &[SemaEffectNode], node_index: Int, edge: String) Never! {
    sema_effect_set_add(&nodes[node_index].call_edges, edge)
}

fn sema_effect_node_index(node_by_key: [String:Int], key: String) -> Int? Never! {
    node_by_key.get(key)
}

fn sema_effect_publish_diagnostics(all: &[Diagnostic], modules: &[SemaEffectModuleResult], module_index: Int, source_segments: [SemaSourceSegment], batch: [Diagnostic]) Never! {
    loop diagnostic in batch {
        located :: sema_diagnostic_with_source_location(^diagnostic, source_segments)
        &all.push(located)
        &modules[module_index].diagnostics.push(located)
    }
}

fn sema_effect_node_from_source(function: TFunc, source: SemaEffectFunctionSource?, module_index: Int, diagnostics: &[Diagnostic]) -> SemaEffectNode {
    node := SemaEffectNode{
        key: function.key,
        name: function.name,
        module_identity: function.module_identity,
        module_index: module_index,
        span: function.source_span,
        name_span: function.source_span,
        direct: [String]{},
        direct_spans: [TEffectSpan]{},
        call_edges: [String]{},
        maximal: false,
        maximal_span: None,
        declared: [String]{},
        prohibited: [String]{},
        has_declared_row: false,
        is_pure: function.is_pure,
        is_replayable: false,
        replayable_span: None,
        is_unsafe: function.is_unsafe,
        unsafe_reason: None,
        unsafe_span: None,
        effect_via: None,
        dispatches: [TEffectSpan]{},
    }
    loop effect_name in function.effects.direct {
        if sema_effect_set_add(&node.direct, effect_name) -> &node.direct_spans.push(TEffectSpan{name: effect_name, span: function.source_span})
    }
    loop edge in function.effects.call_edges -> sema_effect_set_add(&node.call_edges, edge)
    if function.effects.maximal {
        node.maximal = true
        node.maximal_span = Val(function.source_span)
    }
    node.display_key = "{function.module_name}::{function.name}"
    node.source_display = sema_effect_source_display(function.source_file)
    if source == None {
        sema_effect_check_tfunc_unsafe(function, &diagnostics)
        return node
    }
    actual :: source
    node.span = actual.span
    node.name_span = actual.name_span ?? actual.span
    node.has_declared_row = actual.declared_effects != None
    node.is_pure = actual.is_pure
    node.is_replayable = actual.is_replayable
    node.is_unsafe = actual.is_unsafe
    node.replayable_span = actual.replayable_span
    node.unsafe_reason = actual.unsafe_reason
    node.effect_via = actual.effect_via
    node.unsafe_span = actual.unsafe_span
    node.loop_spans = actual.loop_spans
    node.assume_det_spans = actual.assume_det_spans
    if actual.is_unsafe && !sema_effect_check_unsafe_function(actual, &diagnostics) {
        // The diagnostic is already source-backed; retain the node so the graph
        // remains inspectable after a failed gate check.
    }
    if actual.declared_effects == .Val(effect_row) {
        loop entry in effect_row {
            prohibited :: entry.name.starts_with("!")
            raw := entry.name
            if prohibited {
                pieces :: entry.name.split("!").to_list()
                if pieces.len() > 1 -> raw = pieces[1]
            }
            effect_name :: sema_effect_parse_name(raw) ?? {
                &diagnostics.push(sema_effect_unknown(raw, entry.span))
                next
            }
            if !prohibited && sema_effect_root(effect_name) == "Panic" {
                &diagnostics.push(sema_effect_positive_panic(entry.span))
                next
            }
            if {
                // D-AUTHORITY-MEM1: memory denials are proved over memory
                // events (E0921), not the ambient prohibition check.
                prohibited && sema_effect_root(effect_name) == "Mem" -> {
                    &node.memory_denials.push(EffectRowEntry{name: effect_name, span: entry.span})
                }
                prohibited -> {
                    _ := sema_effect_set_add(&node.prohibited, effect_name)
                }
                else -> {
                    _ := sema_effect_set_add(&node.declared, effect_name)
                }
            }
        }
    }
    if actual.effect_via != None {
        via_nodes := [SemaEffectNode]{node}
        sema_effect_apply_via(&via_nodes, 0, function, &diagnostics)
        node = via_nodes[0]
    }
    node
}

// Intrinsic producers use the same fact carrier as checked calls. The effect
// row is authoritative producer input: an empty present row means known-pure,
// while an absent row remains unknown and is conservatively maximal downstream.
pub fn sema_effect_record_intrinsic_fact(environment: SemaScopeEnvironment, scopes: &SemaScopeTable, context: &SemaCheckContext, api: String, span: Span, facts: SemaCallFacts, diagnostics: &[Diagnostic]) -> Bool Never! {
    wall := sema_effect_check_transaction_wall(environment, scopes, facts.effect_bound, api, span, &diagnostics)
    allowed :: wall ?? return false
    if !allowed -> return false
    caller_key := sema_scope_function_owner_key(scopes)
    if caller_key != "" {
        &context.call_facts.push(SemaCallSiteFact{
            span: span,
            caller_key: caller_key,
            callee: None,
            facts: facts,
            discarded: false,
        })
    }
    true
}

// Convenience entry point for intrinsic operations whose only call metadata
// is their canonical effect row. Use an empty row to record a known-pure site.
pub fn sema_effect_record_intrinsic_effects(environment: SemaScopeEnvironment, scopes: &SemaScopeTable, context: &SemaCheckContext, api: String, span: Span, effect_row: [EffectRowEntry], diagnostics: &[Diagnostic]) -> Bool Never! {
    sema_effect_record_intrinsic_fact(
        environment,
        &scopes,
        &context,
        api,
        span,
        SemaCallFacts{
            return_type: Type.Named{name: "Unit"},
            failure_carrier: TFailureCarrier.Infallible,
            effect_bound: Val(effect_row),
            type_args: [Type]{},
            default_refs: [FunctionDefaultRef]{},
        },
        &diagnostics,
    )
}

fn sema_effect_record_fact(nodes: &[SemaEffectNode], node_by_key: [String:Int], node_index: Int, fact: SemaCallSiteFact, diagnostics: &[Diagnostic]) {
    callee_key :: fact.callee.map((callee) -> callee.key) ?? ""
    known_callee :: callee_key != "" && sema_effect_node_index(node_by_key, callee_key) != None
    if callee_key != "" -> sema_effect_node_add_edge(&nodes, node_index, callee_key)
    if known_callee {
        executions :: sema_effect_memory_executions(nodes[node_index], fact.span)
        &nodes[node_index].memory_calls.push(SemaMemoryCall{callee: callee_key, span: fact.span, executions: executions})
    }
    row_known :: fact.facts.effect_bound != None
    if fact.facts.effect_bound == .Val(effect_row) {
        loop entry in effect_row {
            raw :: entry.name
            if raw.starts_with("!") -> next
            effect_name :: sema_effect_parse_name(raw) ?? {
                &diagnostics.push(sema_effect_unknown(raw, entry.span))
                next
            }
            if !known_callee -> sema_effect_node_add_direct(&nodes, node_index, effect_name, entry.span)
        }
    }
    if callee_key == "" && !row_known {
        nodes[node_index].maximal = true
        nodes[node_index].maximal_span = Val(fact.span)
        sema_effect_record_memory_open(&nodes, node_index, fact.span, "foreign or dynamically selected function body")
    }
    if callee_key != "" && !known_callee && !row_known {
        nodes[node_index].maximal = true
        nodes[node_index].maximal_span = Val(fact.span)
        sema_effect_record_memory_open(&nodes, node_index, fact.span, "callee body is unavailable and has no verified signed memory summary")
    }
}

fn sema_effect_record_memory_open(nodes: &[SemaEffectNode], node_index: Int, span: Span, reason: String) Never! {
    source :: ~nodes[node_index].source_display
    &nodes[node_index].memory_opens.push(SemaMemoryOpen{span: span, source: source, reason: reason})
}

// Indices store positions, not copied semantic facts. Caller buckets retain
// source order, including equal-width interval ties; exact duplicates use the
// first row just as the original search did.
struct SemaEffectCallIndex {
    facts: [SemaCallSiteFact]
    exact: [String:Int]
    caller_slots: [String:Int]
    callers: [[Int]]
    node_by_key: [String:Int]
}

fn sema_effect_fact_key(caller_key: String, span: Span) -> String Never! {
    "{caller_key.len()}:{caller_key}:{span.start}:{span.end}"
}

fn sema_effect_call_index(facts: [SemaCallSiteFact], node_by_key: [String:Int]) -> SemaEffectCallIndex Never! {
    index := SemaEffectCallIndex{facts: facts, exact: [String:Int]{}, caller_slots: [String:Int]{}, callers: [[Int]]{}, node_by_key: node_by_key}
    loop (position, fact) in facts {
        key :: sema_effect_fact_key(fact.caller_key, fact.span)
        if index.exact.get(key) == None -> index.exact[key] = position
        slot := index.caller_slots.get(fact.caller_key) ?? -1
        if slot < 0 {
            slot = index.callers.len()
            index.caller_slots[fact.caller_key] = slot
            &index.callers.push([Int]{})
        }
        &index.callers[slot].push(position)
    }
    index
}

fn sema_effect_find_fact(index: SemaEffectCallIndex, caller_key: String, span: Span) -> SemaCallSiteFact? {
    exact :: sema_effect_find_exact_fact(index, caller_key, span)
    if exact != None -> return exact
    slot :: index.caller_slots.get(caller_key) ?? return None
    best := SemaCallSiteFact?{None}
    best_width := 2147483647
    loop position in index.callers[slot] {
        fact :: index.facts[position]
        if sema_effect_span_contains(fact.span, span) || sema_effect_span_contains(span, fact.span) {
            width :: fact.span.end - fact.span.start
            if width < best_width {
                best_width = width
                best = Val(fact)
            }
        }
    }
    best
}

fn sema_effect_find_exact_fact(index: SemaEffectCallIndex, caller_key: String, span: Span) -> SemaCallSiteFact? {
    position :: index.exact.get(sema_effect_fact_key(caller_key, span)) ?? return None
    Val(index.facts[position])
}



fn sema_effect_is_call(expression: TExpr) -> Bool Never! {
    if expression.kind == {
        .Call(_, _, _)
        | .IndirectCall(_, _, _, _)
        | .MethodCall(_, _, _, _)
        | .StaticCall(_, _, _, _, _)
        | .ModuleCall(_, _, _, _, _)
        | .CoreCall(_, _, _, _, _, _, _)
        | .ExternCall(_, _, _)
        | .MathBuiltin(_, _, _)
        | .PreciseBuiltin(_, _, _)
        | .Print(_)
        | .Drop(_)
        | .Close(_)
        | .ResourceNew(_)
        | .AmbientInput(_)
        | .HostCall(_)
        | .AllocNew(_, _)
        | .BuiltinMethod(_, _, _)
        | .ClosureMethod(_, _, _)
        | .HandleMethod(_, _, _)
        | .NumericMethod(_, _)
        | .NumericBinaryMethod(_, _, _)
        | .SharedGuardWait(_, _, _)
        | .CoreClosureCall(_) -> true
        else -> false
    }
}

// Compiler-built numeric operations (`1 / 3` as an exact `Fraction`, Decimal
// and math-type arithmetic, numeric casts) have no callee body. Rust records
// no effect for them, so one with no recorded call fact is pure, not an
// unknown callee that forces the maximal row.
fn sema_effect_is_numeric_builtin(expression: TExpr) -> Bool Never! {
    if expression.kind == {
        .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) -> true
        else -> false
    }
}

fn sema_effect_merge_lambda(nodes: &[SemaEffectNode], node_index: Int, lambda: TLambda) Never! {
    loop effect_name in lambda.effects.direct {
        span := lambda.source_span
        loop entry in lambda.effects.direct_spans {
            if entry.name == effect_name -> span = entry.span
        }
        sema_effect_node_add_direct(&nodes, node_index, effect_name, span)
    }
    loop edge in lambda.effects.call_edges -> sema_effect_node_add_edge(&nodes, node_index, edge)
    if lambda.effects.maximal {
        nodes[node_index].maximal = true
        nodes[node_index].maximal_span = Val(lambda.source_span)
    }
}

fn sema_effect_record_unresolved_call(nodes: &[SemaEffectNode], node_by_key: [String:Int], node_index: Int, expression: TExpr) Never! {
    callee_key :: if expression.kind == {
        .Call(callee, _, _) -> callee.key
        .MethodCall(_, method, _, _) -> method.symbol.key
        .StaticCall(_, _, method, _, _) -> method.symbol.key
        else -> ""
    }
    if {
        callee_key != "" && sema_effect_node_index(node_by_key, callee_key) != None -> sema_effect_node_add_edge(&nodes, node_index, callee_key)
        else -> {
            nodes[node_index].maximal = true
            nodes[node_index].maximal_span = Val(expression.span)
            sema_effect_record_memory_open(&nodes, node_index, expression.span, "foreign or dynamically selected function body")
        }
    }
}

fn sema_effect_symbol_leaf(key: String) -> String Never! {
    parts :: key.split(":").to_list()
    if parts.len() == 0 -> key else -> parts[parts.len() - 1]
}

// D-EFF3: a call through a trait value sees the trait method's declared
// dispatch bound, not one implementation body. A trait method with no
// declared row is an open-world dispatch (E0743 under a ceiling).
fn sema_effect_record_dispatch(nodes: &[SemaEffectNode], node_index: Int, expression: TExpr, fact: SemaCallSiteFact) Never! {
    if fact.facts.effect_bound != None -> return
    if expression.kind == {
        .MethodCall(receiver, method, _, _) -> {
            trait_owner :: method.trait_owner ?? return
            if receiver.ty == {
                .TraitObject(_) -> &nodes[node_index].dispatches.push(TEffectSpan{name: "{sema_effect_symbol_leaf(trait_owner.key)}::{method.name}", span: fact.span})
                else -> {}
            }
        }
        else -> {}
    }
}

fn sema_effect_walk_expr(nodes: &[SemaEffectNode], node_index: Int, expression: TExpr, facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller_key: String) {
    if {
        sema_effect_is_call(expression) -> {
            fact :: sema_effect_find_fact(facts, caller_key, expression.span)
            if fact == {
                .Val(value) -> {
                    nondeterministic :: sema_effect_nondeterministic_core(nodes[node_index], expression, value)
                    if nondeterministic == .Val(api) {
                        // Rust returns before recording the call's effects, so
                        // the pure function reports E3403 instead of E3401.
                        &diagnostics.push(sema_error("E3403", expression.span, "`{api}` is non-deterministic and cannot appear in a pure evaluation.", "Pure evaluation must produce the same result on every machine (D-PURE2).", "remove this call, or remove the enclosing function's explicit empty effect bound."))
                    } else {
                        sema_effect_record_fact(&nodes, facts.node_by_key, node_index, value, &diagnostics)
                        sema_effect_record_dispatch(&nodes, node_index, expression, value)
                    }
                }
                .None -> {
                    if !sema_effect_is_numeric_builtin(expression) -> sema_effect_record_unresolved_call(&nodes, facts.node_by_key, node_index, expression)
                }
            }
        }
        else -> {
            fact :: sema_effect_find_exact_fact(facts, caller_key, expression.span)
            if fact == .Val(value) -> sema_effect_record_fact(&nodes, facts.node_by_key, node_index, value, &diagnostics)
        }
    }
    if expression.kind == {
        .ExternCall(_, _, _) -> {
            sema_effect_node_add_direct(&nodes, node_index, "FFI", expression.span)
            nodes[node_index].maximal = true
            nodes[node_index].maximal_span = Val(expression.span)
            sema_effect_record_memory_open(&nodes, node_index, expression.span, "foreign or dynamically selected function body")
        }
        .RequireStop(_, _, _) | .Never(_) -> sema_effect_node_add_edge(&nodes, node_index, "__jet_panic__")
        .Lambda(value) | .LambdaValue(value) -> {
            sema_effect_merge_lambda(&nodes, node_index, value)
            return
        }
        .StrLit(parts) -> {
            interpolated :: loop part in parts {
                if part == .Interpolation(_, _) -> break true
            } ?? false
            if interpolated -> sema_effect_push_memory_event(&nodes, node_index, expression.span, "string interpolation allocates a new `String`", "alloc", None)
        }
        .List(values, _) | .ListLit(values) -> {
            if values.len() > 0 && !sema_effect_is_fixed_list(expression.ty) -> sema_effect_push_memory_event(&nodes, node_index, expression.span, "list construction allocates backing storage", "alloc", None)
        }
        .Map(entries) | .MapLit(entries) -> {
            if entries.len() > 0 -> sema_effect_push_memory_event(&nodes, node_index, expression.span, "map construction allocates backing storage", "alloc", None)
        }
        // Rust `Arena.new`/`Bump.new`: a literal capacity is the proven bound.
        .AllocNew(ctor, args) -> {
            allocator :: if ctor == {
                .Arena -> "Arena"
                .Bump -> "Bump"
                else -> ""
            }
            if allocator != "" {
                bound := Int?{None}
                if args.len() > 0 && args[0].value.kind == .IntLit(bytes, _) && bytes >= 0 -> bound = Val(bytes)
                sema_effect_push_memory_event(&nodes, node_index, expression.span, "`{allocator}.new` reserves bounded arena storage", "arena", bound)
                sema_effect_push_memory_event(&nodes, node_index, expression.span, "`{allocator}.new` allocates from arena storage", "alloc", None)
            }
        }
        // A copy of a `Shared<T>` handle retains one more reference.
        .ExplicitCopy(_) -> {
            if expression.ty == .Shared(_) -> sema_effect_push_memory_event(&nodes, node_index, expression.span, "`copy` of `{type_name(expression.ty)}` retains a shared reference", "rc", None)
        }
        .Clone(_, _) -> {
            if expression.ty == .Shared(_) -> sema_effect_push_memory_event(&nodes, node_index, expression.span, "implicit copy of `{type_name(expression.ty)}` retains a shared reference", "rc", None)
        }
        else -> {}
    }
    loop child in tir_expr_children(expression) -> sema_effect_walk_expr(&nodes, node_index, child, facts, &diagnostics, caller_key)
}

fn sema_effect_collect_function(nodes: &[SemaEffectNode], node_index: Int, function: TFunc, facts: SemaEffectCallIndex, diagnostics: &[Diagnostic]) {
    loop statement in function.body {
        loop expression in tir_stmt_children(statement) -> sema_effect_walk_expr(&nodes, node_index, expression, facts, &diagnostics, function.key)
    }
}

fn sema_effect_check_unsafe_expr(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, caller_key: String, expression: TExpr, audited: Bool, diagnostics: &[Diagnostic]) {
    if sema_effect_is_call(expression) {
        fact :: sema_effect_find_fact(facts, caller_key, expression.span)
        if fact == .Val(value) {
            if value.callee == .Val(callee) {
                target_index :: sema_effect_node_index(facts.node_by_key, callee.key)
                if target_index == .Val(index) {
                    target :: nodes[index]
                    if target.is_unsafe -> sema_effect_require_unsafe_call(target.name, true, audited, expression.span, &diagnostics)
                }
            }
        }
    }
    if expression.kind == {
        .Lambda(value) | .LambdaValue(value) -> {
            if value.executable == {
                .Expr(inner) -> {
                    sema_effect_check_unsafe_expr(&nodes, facts, caller_key, inner, false, &diagnostics)
                }
                .Block(body) | .SharedBlock(body) -> {
                    sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, false, &diagnostics)
                }
            }
            return
        }
        else -> {}
    }
    loop child in tir_expr_children(expression) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, child, audited, &diagnostics)
}

fn sema_effect_check_unsafe_condition(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, caller_key: String, condition: TIfCond, audited: Bool, diagnostics: &[Diagnostic]) {
    if condition == {
        .Plain(value) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, value, audited, &diagnostics)
        .And(left, right) -> {
            sema_effect_check_unsafe_condition(&nodes, facts, caller_key, left, audited, &diagnostics)
            sema_effect_check_unsafe_condition(&nodes, facts, caller_key, right, audited, &diagnostics)
        }
        .IfLet(_, subject) | .IsNone(subject) | .Matches(_, subject) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, subject, audited, &diagnostics)
        .WithPrelude(prelude, nested) -> {
            sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, prelude, audited, &diagnostics)
            sema_effect_check_unsafe_condition(&nodes, facts, caller_key, nested, audited, &diagnostics)
        }
    }
}

fn sema_effect_check_unsafe_contracts(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, caller_key: String, contracts: [TContract], audited: Bool, diagnostics: &[Diagnostic]) {
    loop contract in contracts {
        sema_effect_check_unsafe_expr(&nodes, facts, caller_key, contract.condition, audited, &diagnostics)
        sema_effect_check_unsafe_expr(&nodes, facts, caller_key, contract.message, audited, &diagnostics)
    }
}

fn sema_effect_check_unsafe_statements_tir(nodes: &[SemaEffectNode], facts: SemaEffectCallIndex, caller_key: String, statements: [TStmt], audited: Bool, diagnostics: &[Diagnostic]) {
    loop statement in statements {
        if statement == {
            .Contract(contract) -> {
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, contract.condition, audited, &diagnostics)
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, contract.message, audited, &diagnostics)
            }
            .ContractScope(pre, body, post, _, _) -> {
                sema_effect_check_unsafe_contracts(&nodes, facts, caller_key, pre, audited, &diagnostics)
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
                sema_effect_check_unsafe_contracts(&nodes, facts, caller_key, post, audited, &diagnostics)
            }
            .Let(_, _, init, _, _, _) | .TupleDestructure(_, init, _, _, _) | .StructDestructure(_, init, _, _, _) | .ListDestructure(_, init, _, _, _, _, _) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, init, audited, &diagnostics)
            .RefutableBind(_, init, fallback, _) -> {
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, init, audited, &diagnostics)
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, fallback, audited, &diagnostics)
            }
            .Assign(place, _, value, _, _, _) -> {
                if place == {
                    .Expr(place_value) -> {
                        sema_effect_check_unsafe_expr(&nodes, facts, caller_key, place_value, audited, &diagnostics)
                    }
                    else -> {}
                }
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, value, audited, &diagnostics)
            }
            .CountedLoop(_, init, condition, step, _, body, _) -> {
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, [TStmt]{init}, audited, &diagnostics)
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, condition, audited, &diagnostics)
                if step == .Val(step_statement) -> sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, [TStmt]{step_statement}, audited, &diagnostics)
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
            }
            .ForRange(_, _, start, end, step, _, body, _, _) -> {
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, start, audited, &diagnostics)
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, end, audited, &diagnostics)
                if step == .Val(step_value) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, step_value, audited, &diagnostics)
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
            }
            .Range(_, _, source, start, end, step, _, _, body, _) -> {
                if source == .Val(source_value) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, source_value, audited, &diagnostics)
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, start, audited, &diagnostics)
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, end, audited, &diagnostics)
                if step == .Val(step_value) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, step_value, audited, &diagnostics)
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
            }
            .ExprStmt(value, _) | .DeferClose(value, _, _, _) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, value, audited, &diagnostics)
            .TaskGroup(_, limit, body, _) -> {
                if limit == .Val(limit_value) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, limit_value, audited, &diagnostics)
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
            }
            .If(condition, then_body, else_body, _, _) -> {
                sema_effect_check_unsafe_condition(&nodes, facts, caller_key, condition, audited, &diagnostics)
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, then_body, audited, &diagnostics)
                if else_body == .Val(else_statements) -> sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, else_statements, audited, &diagnostics)
            }
            .Loop(_, body, _) -> sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
            .While(_, condition, body, _) -> {
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, condition, audited, &diagnostics)
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
            }
            .BreakValue(_, value, _) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, value, audited, &diagnostics)
            .Match(subject, arms, _, _) -> {
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, subject, audited, &diagnostics)
                loop arm in arms -> sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, arm.body, audited, &diagnostics)
            }
            .EnumMatch(scrutinee, _, arms, else_body, _, _) -> {
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, scrutinee, audited, &diagnostics)
                loop arm in arms -> sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, arm.body, audited, &diagnostics)
                if else_body == .Val(else_statements) -> sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, else_statements, audited, &diagnostics)
            }
            .RangeSwitch(subject, arms, else_body, _) -> {
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, subject, audited, &diagnostics)
                loop arm in arms -> sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, arm.body, audited, &diagnostics)
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, else_body, audited, &diagnostics)
            }
            .IndexAssign(_, base, index, _, value, _) | .IndexHookAssign(_, base, index, value, _) -> {
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, base, audited, &diagnostics)
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, index, audited, &diagnostics)
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, value, audited, &diagnostics)
            }
            .IndexFieldAssign(value, _) -> {
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, value.base, audited, &diagnostics)
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, value.index, audited, &diagnostics)
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, value.value, audited, &diagnostics)
            }
            .MathSwizzleAssign(base, _, _, value, _, _) -> {
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, base, audited, &diagnostics)
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, value, audited, &diagnostics)
            }
            .ForIn(_, _, _, source, collection, step, _, _, _, _, body, _) -> {
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, source, audited, &diagnostics)
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, collection, audited, &diagnostics)
                if step == .Val(step_value) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, step_value, audited, &diagnostics)
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
            }
            .Inline(body, _) | .DebugOnly(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) -> {
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
            }
            .MixedSwitch(subject, _, arms, else_body, _) -> {
                sema_effect_check_unsafe_expr(&nodes, facts, caller_key, subject, audited, &diagnostics)
                loop arm in arms {
                    sema_effect_check_unsafe_expr(&nodes, facts, caller_key, arm.condition, audited, &diagnostics)
                    sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, arm.body, audited, &diagnostics)
                }
                if else_body == .Val(else_statements) -> sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, else_statements, audited, &diagnostics)
            }
            .Unsafe(_, body) | .UnsafeBlock(_, body, _) -> {
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, true, &diagnostics)
            }
            .SentryPolicy(_, body, _) | .Impure(body, _) -> {
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
            }
            .Reactive(executable, _) -> {
                if executable.executable == {
                    .Expr(value) -> {
                        sema_effect_check_unsafe_expr(&nodes, facts, caller_key, value, false, &diagnostics)
                    }
                    .Block(body) | .SharedBlock(body) -> {
                        sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, false, &diagnostics)
                    }
                }
            }
            .Layout(_, _, body, _) -> {
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
            }
            .ContextBlock(guards, body, _) -> {
                loop guard in guards -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, guard.value, audited, &diagnostics)
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
            }
            .ScopeMember(_, body, _) -> {
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
            }
            .Transact(_, _, _, body, _) -> {
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, body, audited, &diagnostics)
            }
            .GCEdit(_, _, _, _, index_temp, nested, _) -> {
                if index_temp == .Val(index_value) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, index_value, audited, &diagnostics)
                sema_effect_check_unsafe_statements_tir(&nodes, facts, caller_key, [TStmt]{nested}, audited, &diagnostics)
            }
            .SplitViews(owner, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) -> {
                if owner == .Val(owner_value) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, owner_value, audited, &diagnostics)
            }
            else -> {
                loop expression in tir_stmt_children(statement) -> sema_effect_check_unsafe_expr(&nodes, facts, caller_key, expression, audited, &diagnostics)
            }
        }
    }
}

fn sema_effect_scope_diagnostic(marker: String, over: [String], bounds: [String], span: Span) -> Diagnostic {
    allowed :: if bounds.len() == 0 -> "no effects" else -> "`{sema_effect_show(bounds)}`"
    sema_error("E0712", span, "this `#{marker}` region uses the effect `{sema_effect_show(over)}`, which it has no authority for", "`#{marker}(…)` allows only {allowed}; an effect reached inside — even through a call — must be in that list", "add `{sema_effect_show(over)}` to the `#{marker}(…)` list, or move that work outside the region")
}

pub fn sema_effect_check_scope_caps(marker: String, caps: [String], inferred: [String], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    bounds := [String]{}
    valid := true
    loop raw in caps {
        if raw.starts_with("..") -> next
        prohibited :: raw.starts_with("!")
        name := raw
        if prohibited {
            pieces :: raw.split("!").to_list()
            if pieces.len() > 1 -> name = pieces[1]
        }
        effect_name :: sema_effect_parse_name(name) ?? {
            &diagnostics.push(sema_effect_unknown(name, span))
            valid = false
            next
        }
        if !prohibited && sema_effect_root(effect_name) == "Panic" {
            &diagnostics.push(sema_effect_positive_panic(span))
            valid = false
            next
        }
        if prohibited -> next
        sema_effect_set_add(&bounds, effect_name)
    }
    over :: sema_effect_uncovered(inferred, bounds)
    if over.len() > 0 {
        &diagnostics.push(sema_effect_scope_diagnostic(marker, over, bounds, span))
        valid = false
    }
    valid
}

fn sema_effect_callback_diagnostic(over: [String], bounds: [String], span: Span) -> Diagnostic {
    allowed :: if bounds.len() == 0 -> "the parameter is `fn(…) -[]>`, so the callback must be pure" else -> "the parameter allows only `-[{sema_effect_show(bounds)}]>` effects"
    sema_error("E0747", span, "this callback uses the effect `{sema_effect_show(over)}`, which the parameter doesn't allow", "{allowed}; `{sema_effect_show(over)}` is outside that bound", "pass a callback within the declared effect bound, or widen the parameter's bound")
}

pub fn sema_effect_check_callback_bound(callback_effects: [String], bounds: [String], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    parsed_bounds := [String]{}
    valid := true
    loop raw in bounds {
        if raw.starts_with("..") -> next
        if raw.starts_with("!") -> next
        effect_name :: sema_effect_parse_name(raw) ?? {
            &diagnostics.push(sema_effect_unknown(raw, span))
            valid = false
            next
        }
        if sema_effect_root(effect_name) == "Panic" {
            &diagnostics.push(sema_effect_positive_panic(span))
            valid = false
            next
        }
        sema_effect_set_add(&parsed_bounds, effect_name)
    }
    over :: sema_effect_uncovered(callback_effects, parsed_bounds)
    if over.len() > 0 {
        &diagnostics.push(sema_effect_callback_diagnostic(over, parsed_bounds, span))
        valid = false
    }
    valid
}

// ────────────────────────────────────────────────────────────────────────────
// Call-graph fixed point and public graph hook

fn sema_effect_all_grantable() -> [String] Never! {
    sema_effect_grantable_roots()
}

struct SemaEffectPending {
    node: Int
    name: String
}

// Propagate each newly reached effect to callers once. Set insertion keeps
// the established root-rank/name order, so worklist order cannot change
// published rows or diagnostics. Direct rows and call-site spans are untouched.
fn sema_effect_solve(nodes: [SemaEffectNode], node_by_key: [String:Int]) -> [[String]] Never! {
    solved := [[String]]{}
    callers := (loop _ in nodes -> [Int]{})
    pending := [SemaEffectPending]{}
    loop (index, node) in nodes {
        row := node.direct
        if node.maximal -> sema_effect_set_union(&row, sema_effect_all_grantable())
        loop edge in node.call_edges {
            if edge == "__jet_panic__" {
                sema_effect_set_add(&row, "Panic")
                next
            }
            target :: sema_effect_node_index(node_by_key, edge) ?? next
            &callers[target].push(index)
        }
        loop name in row -> &pending.push(SemaEffectPending{node: index, name: name})
        &solved.push(row)
    }
    cursor := 0
    loop cursor < pending.len() {
        incoming :: pending[cursor]
        cursor += 1
        loop caller in callers[incoming.node] {
            if sema_effect_set_add(&solved[caller], incoming.name) -> &pending.push(SemaEffectPending{node: caller, name: incoming.name})
        }
    }
    solved
}

// Rust `solve_reachability` "secret" row: only a direct `Secret` read seeds
// it, never the every-root row of an open-world (maximal) call, and callers
// inherit it along call edges. E1264 consults this row, not `solved`.
fn sema_effect_secret_reach(nodes: [SemaEffectNode], node_by_key: [String:Int]) -> [Bool] Never! {
    reached := (loop _ in nodes -> false)
    callers := (loop _ in nodes -> [Int]{})
    pending := [Int]{}
    loop (index, node) in nodes {
        loop edge in node.call_edges {
            target :: sema_effect_node_index(node_by_key, edge) ?? next
            &callers[target].push(index)
        }
        loop effect_name in node.direct {
            if sema_effect_root(effect_name) == "Secret" {
                reached[index] = true
                &pending.push(index)
                break
            }
        }
    }
    cursor := 0
    loop cursor < pending.len() {
        incoming :: pending[cursor]
        cursor += 1
        loop caller in callers[incoming] {
            if reached[caller] -> next
            reached[caller] = true
            &pending.push(caller)
        }
    }
    reached
}

fn sema_effect_tfacts(node: SemaEffectNode, solved: [String]) -> TEffectFacts Never! {
    TEffectFacts{direct: node.direct, solved: solved, call_edges: node.call_edges, maximal: node.maximal, direct_spans: node.direct_spans}
}

fn sema_effect_secret_diagnostic(node: SemaEffectNode) -> Diagnostic {
    sema_error("E1264", node.span, "`{node.name}` reads a secret but doesn't declare the `Secret` effect", "reading a secret always requires an explicit grant; unlike other effects, there is no silently inferred default", "add `Secret` to `{node.name}`'s effect row, or widen an existing row to cover it")
}

fn sema_effect_unbounded_dispatch_diagnostic(dispatch: TEffectSpan) -> Diagnostic {
    sema_error("E0743", dispatch.span, "dynamic call `{dispatch.name}` has no effect bound", "a trait value can select any implementation at runtime, so an enclosing effect ceiling needs the trait method's declared upper bound", "declare an effect row on `{dispatch.name}`, such as `-[]>` for pure dispatch, or move this dynamic call outside the bounded function")
}

// The first unbounded trait dispatch reachable from `index` through the call
// graph, the function's own calls first.
fn sema_effect_find_dispatch(nodes: [SemaEffectNode], node_by_key: [String:Int], index: Int, seen: &[Bool]) -> TEffectSpan? {
    if seen[index] -> return None
    seen[index] = true
    if nodes[index].dispatches.len() > 0 -> return Val(nodes[index].dispatches[0])
    loop edge in nodes[index].call_edges {
        target :: sema_effect_node_index(node_by_key, edge) ?? next
        found :: sema_effect_find_dispatch(nodes, node_by_key, target, &seen)
        if found != None -> return found
    }
    None
}

fn sema_effect_trait_bound_diagnostic(bound: SemaEffectTraitBound, over: [String], span: Span, impl_key: String) -> Diagnostic {
    over_list :: sema_effect_show(over)
    bound_text :: if bound.bound.len() == 0 -> "`{bound.trait_name}` bounds `{bound.method}` to `-[]>`, so impls must be pure" else -> "`{bound.trait_name}` bounds `{bound.method}` to `-[{sema_effect_show(bound.bound)}]>`, so impls may use only those"
    diagnostic :: sema_error("E0742", span, "this `{bound.method}` impl uses the effect `{over_list}`, which the trait doesn't allow", "{bound_text}; `{over_list}` is outside that bound", "remove the `{over_list}` work from this impl, or widen the bound on the trait method")
    diagnostic_with_rights(^diagnostic, "invocation", [String]{impl_key}, [String]{}, None)
}

// D-EFF3: every impl of a bounded trait method stays within the trait's row.
fn sema_effect_check_trait_bounds(module_row: SemaEffectModuleInput, source_index: SemaEffectSourceIndex, nodes: [SemaEffectNode], node_by_key: [String:Int], solved: [[String]], diagnostics: &[Diagnostic]) {
    if module_row.trait_bounds.len() == 0 -> return
    loop function in module_row.functions {
        if function.kind == {
            .TraitMethod(_, _, owner_type, trait_symbol, _) -> {
                node_index :: sema_effect_node_index(node_by_key, function.key) ?? next
                source :: sema_effect_source_for(function, module_row.sources, source_index)
                method :: source.map((value) -> value.name) ?? function.name
                trait_name :: sema_effect_symbol_leaf(trait_symbol.key)
                loop bound in module_row.trait_bounds {
                    if bound.trait_name != trait_name || bound.method != method -> next
                    over :: sema_effect_uncovered(solved[node_index], bound.bound)
                    if over.len() > 0 -> &diagnostics.push(sema_effect_trait_bound_diagnostic(bound, over, nodes[node_index].name_span, "{type_name(owner_type)}::{method}"))
                    break
                }
            }
            else -> {}
        }
    }
}

// D-AUTHORITY-MEM2: the byte bound of `Mem.Alloc(above: N)`.
fn sema_effect_memory_bound(name: String) -> Int? {
    if !name.starts_with("Mem.Alloc(") -> return None
    parts :: name.split(":").to_list()
    if parts.len() != 2 -> return None
    amount :: parts[1].split(")").to_list()
    if amount.len() == 0 -> return None
    bytes :: Int.parse(amount[0].trim()) ?? return None
    Val(bytes)
}

// Rust `MemoryFact::display` for the denials a memory proof covers.
fn sema_effect_memory_fact(name: String) -> String? {
    if name == "Mem.Alloc" || name == "Mem.Rc" -> return Val("!{name}")
    bound :: sema_effect_memory_bound(name) ?? return None
    Val("!Mem.Alloc(above: {bound})")
}

fn sema_effect_span_before(left: Span, right: Span) -> Bool Never! {
    left.start < right.start || (left.start == right.start && left.end < right.end)
}

fn sema_effect_memory_sorted_events(events: [SemaMemoryEvent]) -> [SemaMemoryEvent] {
    sorted := [SemaMemoryEvent]{}
    loop event in events {
        &sorted.push(event)
        index := sorted.len() - 1
        loop index > 0 && sema_effect_span_before(sorted[index].span, sorted[index - 1].span) {
            swap := sorted[index - 1]
            sorted[index - 1] = sorted[index]
            sorted[index] = swap
            index -= 1
        }
    }
    sorted
}

fn sema_effect_memory_sorted_calls(calls: [SemaMemoryCall]) -> [SemaMemoryCall] {
    sorted := [SemaMemoryCall]{}
    loop call in calls {
        &sorted.push(call)
        index := sorted.len() - 1
        loop index > 0 && sema_effect_span_before(sorted[index].span, sorted[index - 1].span) {
            swap := sorted[index - 1]
            sorted[index - 1] = sorted[index]
            sorted[index] = swap
            index -= 1
        }
    }
    sorted
}

fn sema_effect_memory_open_finding(span: Span, source: String, reason: String, owner: Int, path: [String], used: Int) -> SemaMemoryFinding Never! {
    SemaMemoryFinding{event: None, owner: owner, open: Val(SemaMemoryOpen{span: span, source: source, reason: reason}), path: path, used: used}
}

fn sema_effect_arena_failure(finding: SemaMemoryFinding) -> SemaMemoryArena Never! {
    SemaMemoryArena{bytes: 0, witness: None, failure: Val(finding)}
}

// Rust `shortest_violation` for the unbounded facts: breadth-first search
// gives the shortest call path to the first event of `kind` ("alloc" for
// `!Mem.Alloc`, "rc" for `!Mem.Rc`) or to an open dispatch.
fn sema_effect_memory_search(nodes: [SemaEffectNode], node_by_key: [String:Int], root: Int, kind: String) -> SemaMemoryFinding? {
    queue := [Int]{root}
    paths := [[String]]{[String]{nodes[root].display_key}}
    seen := (loop _ in nodes -> false)
    cursor := 0
    loop cursor < queue.len() {
        index :: queue[cursor]
        path :: ~paths[cursor]
        cursor += 1
        if seen[index] -> next
        seen[index] = true
        loop event in sema_effect_memory_sorted_events(nodes[index].memory_events) {
            if event.kind == kind -> return Val(SemaMemoryFinding{event: Val(event), owner: index, open: None, path: path, used: 0})
        }
        if nodes[index].memory_opens.len() > 0 -> return Val(SemaMemoryFinding{event: None, owner: index, open: Val(~nodes[index].memory_opens[0]), path: path, used: 0})
        edges := nodes[index].call_edges
        loop edge in edges {
            target :: sema_effect_node_index(node_by_key, edge) ?? next
            next_path := ~path
            &next_path.push(nodes[target].display_key)
            &queue.push(target)
            &paths.push(next_path)
        }
    }
    None
}

// Rust `may_reach_arena` over the known call graph.
fn sema_effect_may_reach_arena(nodes: [SemaEffectNode], node_by_key: [String:Int], index: Int, visiting: &[Bool]) -> Bool {
    if visiting[index] -> return true
    visiting[index] = true
    found := false
    loop event in nodes[index].memory_events {
        if event.kind == "arena" -> found = true
    }
    if !found {
        loop edge in nodes[index].call_edges {
            target :: sema_effect_node_index(node_by_key, edge) ?? next
            if sema_effect_may_reach_arena(nodes, node_by_key, target, &visiting) {
                found = true
                break
            }
        }
    }
    visiting[index] = false
    found
}

// Rust `arena_bound`: the proven arena bytes `index` can reserve, with the
// event that witnesses the total, or the finding that stops the proof.
fn sema_effect_arena_bound(nodes: [SemaEffectNode], node_by_key: [String:Int], index: Int, visiting: &[Bool], path: [String]) -> SemaMemoryArena {
    if visiting[index] -> return sema_effect_arena_failure(sema_effect_memory_open_finding(Span{start: 0, end: 0}, nodes[index].display_key, "recursive call multiplicity is not statically bounded for arena accounting", index, path, 0))
    visiting[index] = true
    result :: sema_effect_arena_bound_inner(nodes, node_by_key, index, &visiting, path)
    visiting[index] = false
    result
}

fn sema_effect_arena_bound_inner(nodes: [SemaEffectNode], node_by_key: [String:Int], index: Int, visiting: &[Bool], path: [String]) -> SemaMemoryArena {
    node :: nodes[index]
    if node.memory_opens.len() > 0 -> return sema_effect_arena_failure(SemaMemoryFinding{event: None, owner: index, open: Val(~node.memory_opens[0]), path: path, used: 0})
    total := 0
    witness := SemaMemoryFinding?{None}
    loop event in sema_effect_memory_sorted_events(node.memory_events) {
        if event.kind != "arena" -> next
        bytes :: event.bytes ?? return sema_effect_arena_failure(SemaMemoryFinding{event: Val(event), owner: index, open: None, path: path, used: total})
        executions :: event.executions ?? return sema_effect_arena_failure(sema_effect_memory_open_finding(event.span, node.source_display, "loop iteration count is not statically bounded for arena accounting", index, path, total))
        total += bytes * executions
        witness = Val(SemaMemoryFinding{event: Val(event), owner: index, open: None, path: path, used: 0})
    }
    loop edge in node.call_edges {
        target :: sema_effect_node_index(node_by_key, edge) ?? next
        called := false
        loop call in node.memory_calls {
            if call.callee == edge -> called = true
        }
        if called -> next
        reach_visiting := (loop _ in nodes -> false)
        if sema_effect_may_reach_arena(nodes, node_by_key, target, &reach_visiting) -> return sema_effect_arena_failure(sema_effect_memory_open_finding(Span{start: 0, end: 0}, nodes[target].display_key, "call-site multiplicity is unavailable for arena accounting", index, path, total))
    }
    loop call in sema_effect_memory_sorted_calls(node.memory_calls) {
        target :: sema_effect_node_index(node_by_key, call.callee) ?? next
        call_path := ~path
        &call_path.push(nodes[target].display_key)
        proof :: sema_effect_arena_bound(nodes, node_by_key, target, &visiting, call_path)
        if proof.failure != None -> return proof
        if proof.bytes == 0 -> next
        executions :: call.executions ?? return sema_effect_arena_failure(sema_effect_memory_open_finding(call.span, node.source_display, "loop iteration count is not statically bounded for arena accounting", index, call_path, total))
        total += proof.bytes * executions
        if proof.witness != None -> witness = proof.witness
    }
    SemaMemoryArena{bytes: total, witness: witness, failure: None}
}

// Rust `memory_violation`.
fn sema_effect_memory_violation(nodes: [SemaEffectNode], root: Int, denial: EffectRowEntry, fact: String, bounded: Bool, finding: SemaMemoryFinding) -> Diagnostic {
    declared_at :: nodes[root].source_display
    provenance :: "signature denial `-[!{denial.name}]>` in {declared_at}"
    path_text :: finding.path.join(" -> ")
    if finding.event == .Val(event) {
        owner :: nodes[finding.owner]
        arena :: if bounded -> "; the proven path total is {finding.used} bytes" else -> ""
        return sema_error("E0921", event.span, "{event.operation} at {owner.source_display} violates the effective `{fact}` declared at {declared_at}", "{owner.source_display} is reachable through {path_text} from code governed by `{fact}`{arena}; declaration provenance: {provenance}; operation provenance: {owner.name} in {owner.source_display}", "remove or replace the incompatible operation, seal the target set, or move the call outside this denial")
    }
    open :: finding.open ?? SemaMemoryOpen{span: denial.span, source: declared_at, reason: "memory proof is incomplete"}
    span :: if open.span.start == open.span.end -> denial.span else -> open.span
    sema_error("E0921", span, "`{fact}` cannot be proved through the open dispatch at {open.source}", "{open.reason} is reachable through {path_text}; a strict transitive fact cannot assume an unknown future target is compatible; declaration provenance: {provenance}", "seal the target set, consume a verified signed dependency summary that proves the denial, or move the dispatch outside it")
}

// D-AUTHORITY-MEM1/2 (Rust `check_memory_facts`): a `-[!Mem.Alloc]>`,
// `-[!Mem.Rc]>` or `-[!Mem.Alloc(above: N)]>` denial holds for every
// function the root can reach (E0921).
fn sema_effect_check_memory_denials(nodes: [SemaEffectNode], node_by_key: [String:Int], root: Int, diagnostics: &[Diagnostic]) {
    loop denial in nodes[root].memory_denials {
        fact :: sema_effect_memory_fact(denial.name) ?? next
        limit :: sema_effect_memory_bound(denial.name)
        if limit == .Val(bytes_limit) {
            visiting := (loop _ in nodes -> false)
            proof :: sema_effect_arena_bound(nodes, node_by_key, root, &visiting, [String]{nodes[root].display_key})
            if proof.failure == .Val(failure) {
                &diagnostics.push(sema_effect_memory_violation(nodes, root, denial, fact, true, failure))
                next
            }
            if proof.bytes <= bytes_limit -> next
            finding :: proof.witness ?? sema_effect_memory_open_finding(Span{start: 0, end: 0}, nodes[root].display_key, "the verified upper bound is {proof.bytes} bytes, above the declared {bytes_limit} bytes", root, [String]{nodes[root].display_key}, 0)
            finding_total := finding
            finding_total.used = proof.bytes
            &diagnostics.push(sema_effect_memory_violation(nodes, root, denial, fact, true, finding_total))
            next
        }
        kind :: if denial.name == "Mem.Rc" -> "rc" else -> "alloc"
        found :: sema_effect_memory_search(nodes, node_by_key, root, kind) ?? next
        &diagnostics.push(sema_effect_memory_violation(nodes, root, denial, fact, false, found))
    }
}

fn sema_effect_check_node(node: SemaEffectNode, solved: [String], secret_reached: Bool, dispatch: TEffectSpan?, diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    secret_granted :: loop bound in node.declared {
        if sema_effect_root(bound) == "Secret" -> break true
    } ?? false
    if secret_reached && !secret_granted {
        &diagnostics.push(sema_effect_secret_diagnostic(node))
        valid = false
    }
    if {
        dispatch == .Val(found) -> {
            // The open dispatch makes the row maximal; a written ceiling
            // reports the missing trait bound once instead of the generic
            // ceiling diagnostics, and a bare purity marker reports nothing.
            if !node.has_declared_row -> return valid
            &diagnostics.push(sema_effect_unbounded_dispatch_diagnostic(found))
            return false
        }
        node.is_pure -> {
            over :: sema_effect_without_deny_only(solved)
            if over.len() > 0 {
                &diagnostics.push(sema_effect_pure_diagnostic(node, over))
                valid = false
            }
        }
        node.has_declared_row && node.declared.len() > 0 -> {
            over :: sema_effect_uncovered(solved, node.declared)
            if over.len() > 0 {
                &diagnostics.push(sema_effect_bound_diagnostic(node, over))
                valid = false
            }
        }
    }
    prohibited :: sema_effect_covered(solved, node.prohibited)
    if prohibited.len() > 0 {
        &diagnostics.push(sema_effect_prohibited_diagnostic(node, prohibited))
        valid = false
    }
    if node.is_replayable {
        forbidden := [String]{}
        loop effect_name in solved {
            root :: sema_effect_root(effect_name)
            if root == "Time" || root == "Rand" || root == "Net" || root == "IO" -> sema_effect_set_add(&forbidden, effect_name)
        }
        if forbidden.len() > 0 {
            &diagnostics.push(sema_effect_replayable_diagnostic(node, forbidden))
            valid = false
        }
    }
    valid
}

// P7: memory rights are not an observable outcome of a call; every other
// root (including `Panic`) and an open-world row give the call a purpose.
fn sema_effect_row_has_no_outcome(node: SemaEffectNode, solved: [String]) -> Bool Never! {
    if node.maximal -> return false
    loop effect_name in solved {
        if sema_effect_root(effect_name) != "Mem" -> return false
    }
    true
}

// The callee as written stands in for the call text (the Rust reference's
// span covers the callee name, so its call text is that name).
fn sema_effect_discarded_result_diagnostic(node: SemaEffectNode, span: Span) -> Diagnostic {
    diagnostic :: sema_error("E0433", span, "the result of `{node.name}` is thrown away", "`{node.name}` is pure (it has no effects and changes nothing through `&`), so this line does nothing", "use the result, bind it with `result :: {node.name}`, or write `.drop(\"reason\")` if dropping it is intended")
    diagnostic_with_source_derived_suggestion(diagnostic, Span{start: span.start, end: span.start}, "result :: ")
}

// D-EFF1: the part of `expression` inside `region` (a `#FX` block span).
fn sema_effect_walk_region_expr(nodes: &[SemaEffectNode], node_index: Int, expression: TExpr, region: Span, facts: SemaEffectCallIndex, diagnostics: &[Diagnostic], caller_key: String) {
    if sema_effect_span_contains(region, expression.span) {
        sema_effect_walk_expr(&nodes, node_index, expression, facts, &diagnostics, caller_key)
        return
    }
    if !sema_effect_span_contains(expression.span, region) -> return
    loop child in tir_expr_children(expression) -> sema_effect_walk_region_expr(&nodes, node_index, child, region, facts, &diagnostics, caller_key)
}

// D-EFF1 (Rust `check_region_caps`): the effects a `#FX(…)` region reaches:
// its own sites, everything its callees reach, and every effect when it makes
// an unknown call.
fn sema_effect_region_inferred(nodes: [SemaEffectNode], solved: [[String]], owner: Int, function: TFunc, region: SemaEffectFxRegion, facts: SemaEffectCallIndex) -> [String] {
    scratch := nodes
    region_node := nodes[owner]
    region_node.key = "{function.key}#FX@{region.span.start}"
    region_node.direct = [String]{}
    region_node.direct_spans = [TEffectSpan]{}
    region_node.call_edges = [String]{}
    region_node.maximal = false
    region_node.maximal_span = None
    region_node.dispatches = [TEffectSpan]{}
    region_node.memory_events = [SemaMemoryEvent]{}
    &scratch.push(region_node)
    region_index :: scratch.len() - 1
    ignored := [Diagnostic]{}
    loop statement in function.body {
        loop expression in tir_stmt_children(statement) -> sema_effect_walk_region_expr(&scratch, region_index, expression, region.span, facts, &ignored, function.key)
    }
    inferred := scratch[region_index].direct
    if scratch[region_index].maximal -> sema_effect_set_union(&inferred, sema_effect_all_grantable())
    loop edge in scratch[region_index].call_edges {
        if edge == "__jet_panic__" {
            sema_effect_set_add(&inferred, "Panic")
            next
        }
        target :: sema_effect_node_index(facts.node_by_key, edge) ?? next
        sema_effect_set_union(&inferred, solved[target])
    }
    inferred
}

pub fn sema_effects_check_modules(inputs: [SemaEffectModuleInput]) -> SemaEffectGraphResult {
    diagnostics := [Diagnostic]{}
    nodes := [SemaEffectNode]{}
    results := [SemaEffectModuleResult]{}
    source_indices :: loop module_row in inputs -> sema_effect_source_index(module_row.sources)
    node_by_key := [String:Int]{}
    loop module_row in inputs -> &results.push(SemaEffectModuleResult{module_identity: module_row.module_identity, functions: module_row.functions, diagnostics: [Diagnostic]{}, complete: true})
    loop (module_index, module_row) in inputs {
        loop function in module_row.functions {
            source := sema_effect_source_for(function, module_row.sources, source_indices[module_index])
            function_diagnostics := [Diagnostic]{}
            if node_by_key.get(function.key) == None -> node_by_key[function.key] = nodes.len()
            &nodes.push(sema_effect_node_from_source(function, source, module_index, &function_diagnostics))
            sema_effect_publish_diagnostics(&diagnostics, &results, module_index, module_row.source_segments, function_diagnostics)
        }
    }
    fact_indices :: loop module_row in inputs -> sema_effect_call_index(module_row.call_facts, node_by_key)

    loop (module_index, module_row) in inputs {
        loop function in module_row.functions {
            node_index :: sema_effect_node_index(node_by_key, function.key) ?? next
            function_diagnostics := [Diagnostic]{}
            sema_effect_collect_function(&nodes, node_index, function, fact_indices[module_index], &function_diagnostics)
            audited := function.is_unsafe && (function.unsafe_gate.map((gate) -> gate.enabled) ?? false)
            sema_effect_check_unsafe_statements_tir(&nodes, fact_indices[module_index], function.key, function.body, audited, &function_diagnostics)
            sema_effect_publish_diagnostics(&diagnostics, &results, module_index, module_row.source_segments, function_diagnostics)
        }
    }

    solved :: sema_effect_solve(nodes, node_by_key)
    secret_reach :: sema_effect_secret_reach(nodes, node_by_key)
    loop node_index in 0..<nodes.len() {
        function_diagnostics := [Diagnostic]{}
        dispatch := TEffectSpan?{None}
        if nodes[node_index].has_declared_row || nodes[node_index].is_pure {
            seen := (loop _ in nodes -> false)
            dispatch = sema_effect_find_dispatch(nodes, node_by_key, node_index, &seen)
        }
        if !sema_effect_check_node(nodes[node_index], solved[node_index], secret_reach[node_index], dispatch, &function_diagnostics) {
            // Keep all diagnostics; the caller receives one complete graph
            // result instead of a partially updated function list.
        }
        sema_effect_publish_diagnostics(&diagnostics, &results, nodes[node_index].module_index, inputs[nodes[node_index].module_index].source_segments, function_diagnostics)
    }
    loop (module_index, module_row) in inputs {
        bound_diagnostics := [Diagnostic]{}
        sema_effect_check_trait_bounds(module_row, source_indices[module_index], nodes, node_by_key, solved, &bound_diagnostics)
        sema_effect_publish_diagnostics(&diagnostics, &results, module_index, module_row.source_segments, bound_diagnostics)
    }
    loop node_index in 0..<nodes.len() {
        memory_diagnostics := [Diagnostic]{}
        sema_effect_check_memory_denials(nodes, node_by_key, node_index, &memory_diagnostics)
        sema_effect_publish_diagnostics(&diagnostics, &results, nodes[node_index].module_index, inputs[nodes[node_index].module_index].source_segments, memory_diagnostics)
    }
    loop (module_index, module_row) in inputs {
        region_diagnostics := [Diagnostic]{}
        loop function in module_row.functions {
            source :: sema_effect_source_for(function, module_row.sources, source_indices[module_index]) ?? next
            if source.fx_regions.len() == 0 -> next
            node_index :: sema_effect_node_index(node_by_key, function.key) ?? next
            loop region in source.fx_regions {
                inferred :: sema_effect_region_inferred(nodes, solved, node_index, function, region, fact_indices[module_index])
                over :: sema_effect_uncovered(inferred, region.caps)
                if over.len() > 0 -> &region_diagnostics.push(sema_effect_scope_diagnostic("FX", over, region.caps, region.caps_span))
            }
        }
        sema_effect_publish_diagnostics(&diagnostics, &results, module_index, module_row.source_segments, region_diagnostics)
    }
    loop (module_index, module_row) in inputs {
        discarded := [Diagnostic]{}
        loop fact in module_row.call_facts {
            if !fact.discarded -> next
            callee :: fact.callee ?? next
            node_index :: sema_effect_node_index(node_by_key, callee.key) ?? next
            if !sema_effect_row_has_no_outcome(nodes[node_index], solved[node_index]) -> next
            &discarded.push(sema_effect_discarded_result_diagnostic(nodes[node_index], fact.span))
        }
        sema_effect_publish_diagnostics(&diagnostics, &results, module_index, module_row.source_segments, discarded)
    }
    loop module_index in 0..<inputs.len() {
        module_row := inputs[module_index]
        functions := module_row.functions
        loop function_index in 0..<functions.len() {
            node_index :: sema_effect_node_index(node_by_key, functions[function_index].key) ?? next
            functions[function_index].effects = sema_effect_tfacts(nodes[node_index], solved[node_index])
        }
        results[module_index].functions = functions
        results[module_index].complete = !sema_has_error_since(diagnostics, 0)
    }
    complete :: !sema_has_error_since(diagnostics, 0)
    SemaEffectGraphResult{modules: results, diagnostics: diagnostics, complete: complete}
}

pub fn sema_effects_check_module(input: SemaEffectModuleInput) -> SemaEffectGraphResult {
    sema_effects_check_modules([SemaEffectModuleInput]{input})
}

pub fn sema_effect_check_unsafe_statements(statements: [Stmt], diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    loop statement in statements {
        if statement == {
            .Unsafe(audit, _, body, span) -> {
                if !sema_effect_check_unsafe_region(audit, span, &diagnostics) -> valid = false
                if !sema_effect_check_unsafe_statements(body, &diagnostics) -> valid = false
            }
            .While(_, body, _, _, _) -> {
                if !sema_effect_check_unsafe_statements(body, &diagnostics) -> valid = false
            }
            .For(_, _, _, _, body, _, _, _, _) -> {
                if !sema_effect_check_unsafe_statements(body, &diagnostics) -> valid = false
            }
            .Switch(_, arms, else_body, _) -> {
                loop arm in arms {
                    if !sema_effect_check_unsafe_statements(arm.body, &diagnostics) -> valid = false
                }
                if else_body != None && !sema_effect_check_unsafe_statements(else_body, &diagnostics) -> valid = false
            }
            .Loop(body, _, _, _) -> {
                if !sema_effect_check_unsafe_statements(body, &diagnostics) -> valid = false
            }
            .CountedLoop(_, _, _, body, _, _, _) -> {
                if !sema_effect_check_unsafe_statements(body, &diagnostics) -> valid = false
            }
            .Impure(_, _, body, _)
            | .Reactive(body, _)
            | .Shield(body, _)
            | .Switched(_, body, _)
            | .Region(_, _, body, _)
            | .Policy(_, body, _)
            | .TaskGroup(_, _, _, body, _)
            | .Layout(_, _, body, _)
            | .Live(body, _)
            | .Transact(_, _, body, _, _)
            | .ComptimeBlock(body, _, _)
            | .ContextBlock(_, body, _)
            | .AssumeDet(_, _, body, _) -> {
                if !sema_effect_check_unsafe_statements(body, &diagnostics) -> valid = false
            }
            .AuthorityScope(_, _, _, body, _) -> {
                if !sema_effect_check_unsafe_statements(body, &diagnostics) -> valid = false
            }
            .ComptimeIf(_, _, then_body, else_body, _, _) -> {
                if !sema_effect_check_unsafe_statements(then_body, &diagnostics) -> valid = false
                if else_body != None && !sema_effect_check_unsafe_statements(else_body, &diagnostics) -> valid = false
            }
            .ComptimeSwitch(_, arms, else_body, _) -> {
                loop arm in arms {
                    if !sema_effect_check_unsafe_statements(arm.body, &diagnostics) -> valid = false
                }
                if else_body != None && !sema_effect_check_unsafe_statements(else_body, &diagnostics) -> valid = false
            }
            .ScopeMember(_, _, _, _, body, _, _, _) -> {
                if !sema_effect_check_unsafe_statements(body, &diagnostics) -> valid = false
            }
            else -> {}
        }
    }
    valid
}
