// This rule declared effect leaves (E0750).
//
// A root that has declared leaves (`Log.Audit: effect`, or a Prelude leaf such
// as `FS.Read`) is closed below it: every leaf written in an effect row, a
// callback type, a trait method row or a module's or type's `#FX(…)` cap must
// resolve to one declared name. A root with no declared leaves stays open.
// Every module except the canonical Prelude effect module is validated, and
// every module contributes leaves.
use jet_foundation.[
    EFFECT_VOCABULARY_LEAVES,
    OWNED_TRAITS,
    Diagnostic,
    EffectRowEntry,
    Func,
    Item,
    ModuleCap,
    Span,
    Stmt,
    TextEdit,
    Type,
    diagnostic_with_edit,
    diagnostic_with_rights,
]

SemaEffectLeaf: struct {
    root: String
    member: String
}

// The name a leaf check reads: parameters (`Mem.Alloc(above: N)`) and a
// resource qualifier (`FS.Read:/data`) are not part of the leaf name.
sema_effect_leaf_name: fn(name: String) -> String Never! {
    name.split("(").to_list()[0].split(":").to_list()[0].trim()
}

// A dotted right under a root whose leaves Prelude/Effects.jet closes
// (`FS.Bogus`) names no declared leaf.
sema_effect_builtin_leaf_unknown: fn(name: String) -> Bool Never! {
    bare: sema_effect_leaf_name(name)
    member: sema_effect_leaf_member(bare) ?? return false
    root: sema_effect_root(bare)
    closed := false
    loop leaf in EFFECT_VOCABULARY_LEAVES {
        if leaf == bare -> return false
        if sema_effect_root(leaf) == root -> closed = true
    }
    closed && member != ""
}

sema_effect_leaf_member: fn(name: String) -> String? {
    root: sema_effect_root(name)
    prefix: "{root}."
    if !name.starts_with(prefix) -> return None
    Val(name.slice(prefix.len(), name.len()))
}

sema_effect_leaf_add: fn(leaves: &[SemaEffectLeaf], name: String) Never! {
    member: sema_effect_leaf_member(name) ?? return
    leaves.push(SemaEffectLeaf{root: sema_effect_root(name), member: member})
}

sema_effect_leaf_collect: fn(leaves: &[SemaEffectLeaf], items: [Item]) Never! {
    loop item in items {
        if item == {
            .EffectDecl(declaration) -> sema_effect_leaf_add(leaves, declaration.name)
            .CodeModule(code_module) -> {
                if code_module.body == .Val(body) -> sema_effect_leaf_collect(leaves, body)
            }
            .GenericModule(generic_module) -> sema_effect_leaf_collect(leaves, generic_module.body)
            else -> {}
        }
    }
}

sema_effect_leaf_check_name: fn(leaves: [SemaEffectLeaf], name: String, span: Span, diagnostics: &[Diagnostic]) {
    if sema_effect_parse_name(name) == None -> return
    bare: sema_effect_leaf_name(name)
    member: sema_effect_leaf_member(bare) ?? return
    root: sema_effect_root(bare)
    members := [String]{}
    loop leaf in leaves {
        if leaf.root == root -> members.push(leaf.member)
    }
    if members.len() == 0 -> return
    loop candidate in members {
        if candidate == member -> return
    }
    diagnostics.push(sema_effect_leaf_unknown_diagnostic(name, root, member, members, span))
}

// A dotted package-budget right under a root Prelude/Effects.jet closes that
// names none of its leaves; a package budget names leaves exactly (E0750).
sema_effect_builtin_leaf_diagnostic: fn(name: String, span: Span) -> Diagnostic? {
    if !sema_effect_builtin_leaf_unknown(name) -> return None
    bare: sema_effect_leaf_name(name)
    member: sema_effect_leaf_member(bare) ?? return None
    root: sema_effect_root(bare)
    members := [String]{}
    loop leaf in EFFECT_VOCABULARY_LEAVES {
        if sema_effect_root(leaf) == root {
            if sema_effect_leaf_member(leaf) == .Val(leaf_member) -> members.push(leaf_member)
        }
    }
    Val(sema_effect_leaf_unknown_diagnostic(name, root, member, members, span))
}

sema_effect_leaf_unknown_diagnostic: fn(name: String, root: String, member: String, members: [String], span: Span) -> Diagnostic {
    suggestion := String?{None}
    closest_member := String?{None}
    if sema_taint_closest(member, members) == .Val(closest) {
        suggestion = Val("{root}.{closest}")
        closest_member = Val(closest)
    }
    fix: if suggestion == .Val(candidate) -> "did you mean `{candidate}`?" else -> "declare it with `{name}: effect`, or use a declared leaf"
    diagnostic := sema_error("E0750", span, "`{name}` isn't a declared effect", "the `{root}` root has declared leaves, so every leaf under it must resolve to one declared name", fix)
    if suggestion == .Val(candidate) {
        // A span over the leaf alone takes the leaf; a span over the written
        // path takes the whole suggested path.
        new_text := candidate
        if span.end - span.start == member.len() && closest_member == .Val(leaf) -> new_text = leaf
        diagnostic = diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: new_text})
    }
    diagnostic_with_rights(diagnostic, "vocabulary", [String]{name}, [String]{}, None)
}

sema_effect_leaf_check_row: fn(leaves: [SemaEffectLeaf], row: [EffectRowEntry], diagnostics: &[Diagnostic]) {
    loop entry in row {
        if entry.name.starts_with("..") -> next
        sema_effect_leaf_check_name(leaves, entry.name, entry.span, diagnostics)
    }
}

sema_effect_leaf_check_type: fn(leaves: [SemaEffectLeaf], ty: Type, diagnostics: &[Diagnostic]) {
    if ty == {
        .Fn(params, ret, effect_bound, _, _, _) -> {
            loop parameter in params -> sema_effect_leaf_check_type(leaves, parameter, diagnostics)
            if ret == .Val(value) -> sema_effect_leaf_check_type(leaves, value, diagnostics)
            if effect_bound == .Val(row) -> sema_effect_leaf_check_row(leaves, row, diagnostics)
        }
        .List(inner) | .Option(inner) | .Shared(inner) | .Tagged(_, inner) | .FixedList(inner, _) -> sema_effect_leaf_check_type(leaves, inner, diagnostics)
        .Result(ok, err) -> {
            sema_effect_leaf_check_type(leaves, ok, diagnostics)
            sema_effect_leaf_check_type(leaves, err, diagnostics)
        }
        .Apply(_, args) | .Union(args) -> {
            loop argument in args -> sema_effect_leaf_check_type(leaves, argument, diagnostics)
        }
        .Map(key, _, value) -> {
            sema_effect_leaf_check_type(leaves, key, diagnostics)
            sema_effect_leaf_check_type(leaves, value, diagnostics)
        }
        .Tuple(fields) -> {
            loop field in fields -> sema_effect_leaf_check_type(leaves, field.ty, diagnostics)
        }
        else -> {}
    }
}

sema_effect_leaf_check_statements: fn(leaves: [SemaEffectLeaf], statements: [Stmt], diagnostics: &[Diagnostic]) {
    loop statement in statements {
        if statement == {
            .Val(binding) -> {
                if binding.ty == .Val(ty) -> sema_effect_leaf_check_type(leaves, ty, diagnostics)
            }
            .CountedLoop(init, _, _, body, _, _, _) -> {
                if init.ty == .Val(ty) -> sema_effect_leaf_check_type(leaves, ty, diagnostics)
                sema_effect_leaf_check_statements(leaves, body, diagnostics)
            }
            .While(_, body, _, _, _)
            | .For(_, _, _, _, body, _, _, _, _)
            | .Loop(body, _, _, _)
            | .Unsafe(_, _, body, _)
            | .Impure(_, _, body, _)
            | .Reactive(body, _)
            | .Shield(body, _)
            | .Switched(_, body, _)
            | .Region(_, _, body, _)
            | .Policy(_, body, _)
            | .TaskGroup(_, _, _, body, _)
            | .Layout(_, _, body, _)
            | .ComptimeBlock(body, _, _)
            | .ContextBlock(_, body, _)
            | .Live(body, _)
            | .AssumeDet(_, _, body, _)
            | .Transact(_, _, body, _, _)
            | .ScopeMember(_, _, _, _, body, _, _, _) -> sema_effect_leaf_check_statements(leaves, body, diagnostics)
            .AuthorityScope(caps, _, _, body, _) -> {
                loop cap in caps -> sema_effect_leaf_check_name(leaves, cap.name, cap.span, diagnostics)
                sema_effect_leaf_check_statements(leaves, body, diagnostics)
            }
            .Switch(_, arms, else_body, _) | .ComptimeSwitch(_, arms, else_body, _) -> {
                loop arm in arms -> sema_effect_leaf_check_statements(leaves, arm.body, diagnostics)
                if else_body == .Val(body) -> sema_effect_leaf_check_statements(leaves, body, diagnostics)
            }
            .ComptimeIf(_, _, then_body, else_body, _, _) -> {
                sema_effect_leaf_check_statements(leaves, then_body, diagnostics)
                if else_body == .Val(body) -> sema_effect_leaf_check_statements(leaves, body, diagnostics)
            }
            else -> {}
        }
    }
}

sema_effect_leaf_check_function: fn(leaves: [SemaEffectLeaf], function: Func, diagnostics: &[Diagnostic]) {
    if function.declared_effects == .Val(row) {
        loop entry in row {
            name := entry.name
            if name.starts_with("!") -> name = name.slice(1, name.len())
            if name.starts_with("..") -> next
            sema_effect_leaf_check_name(leaves, name, entry.span, diagnostics)
        }
    }
    loop parameter_index in 0..<function.params.len() -> sema_effect_leaf_check_type(leaves, function.params[parameter_index].ty, diagnostics)
    if function.return_type == .Val(ty) -> sema_effect_leaf_check_type(leaves, ty, diagnostics)
    sema_effect_leaf_check_statements(leaves, function.body, diagnostics)
}

sema_effect_leaf_check_cap: fn(leaves: [SemaEffectLeaf], cap: ModuleCap?, diagnostics: &[Diagnostic]) {
    written: cap ?? return
    loop entry in written.entries {
        name := entry.name
        if name.starts_with("!") -> name = name.slice(1, name.len())
        sema_effect_leaf_check_name(leaves, name, entry.span, diagnostics)
    }
}

sema_effect_leaf_check_items: fn(leaves: [SemaEffectLeaf], items: [Item], diagnostics: &[Diagnostic]) {
    loop item in items {
        if item == {
            .EffectDecl(declaration) -> {
                if sema_effect_parse_name(declaration.name) == None -> diagnostics.push(sema_effect_unknown(declaration.name, declaration.name_span))
            }
            .Func(function) -> sema_effect_leaf_check_function(leaves, function, diagnostics)
            .Struct(definition) -> {
                sema_effect_leaf_check_cap(leaves, definition.cap, diagnostics)
                loop field in definition.fields -> sema_effect_leaf_check_type(leaves, field.ty, diagnostics)
                loop function in definition.methods -> sema_effect_leaf_check_function(leaves, function, diagnostics)
                loop implementation in definition.trait_impls {
                    loop function in implementation.methods -> sema_effect_leaf_check_function(leaves, function, diagnostics)
                }
            }
            .Enum(definition) -> {
                sema_effect_leaf_check_cap(leaves, definition.cap, diagnostics)
                loop variant in definition.variants {
                    if variant.payload == {
                        .Single(ty, _) -> sema_effect_leaf_check_type(leaves, ty, diagnostics)
                        .Named(fields) -> {
                            loop field in fields -> sema_effect_leaf_check_type(leaves, field.ty, diagnostics)
                        }
                        .Unit -> {}
                    }
                }
                loop function in definition.methods -> sema_effect_leaf_check_function(leaves, function, diagnostics)
                loop implementation in definition.trait_impls {
                    loop function in implementation.methods -> sema_effect_leaf_check_function(leaves, function, diagnostics)
                }
            }
            .Impl(implementation) -> {
                loop function in implementation.methods -> sema_effect_leaf_check_function(leaves, function, diagnostics)
            }
            .Trait(definition) -> {
                loop method in definition.methods {
                    if method.declared_effects == .Val(row) {
                        loop entry in row -> sema_effect_leaf_check_name(leaves, entry.name, entry.span, diagnostics)
                    }
                    loop parameter in method.params -> sema_effect_leaf_check_type(leaves, parameter.ty, diagnostics)
                    if method.return_type == .Val(ty) -> sema_effect_leaf_check_type(leaves, ty, diagnostics)
                    if method.default_body == .Val(body) -> sema_effect_leaf_check_statements(leaves, body, diagnostics)
                }
            }
            .Test(test) -> sema_effect_leaf_check_statements(leaves, test.body, diagnostics)
            .CodeModule(code_module) -> {
                sema_effect_leaf_check_cap(leaves, code_module.cap, diagnostics)
                if code_module.body == .Val(body) -> sema_effect_leaf_check_items(leaves, body, diagnostics)
            }
            .GenericModule(generic_module) -> sema_effect_leaf_check_items(leaves, generic_module.body, diagnostics)
            else -> {}
        }
    }
}

// Validate every effect name written in the source modules against the
// declared leaves of its root. Returns true when a diagnostic was reported.
sema_effect_check_declared_leaves: fn(graph: SemaRegistrationGraph, diagnostics: &[Diagnostic]) -> Bool {
    leaves := [SemaEffectLeaf]{}
    loop name in EFFECT_VOCABULARY_LEAVES -> sema_effect_leaf_add(leaves, name)
    loop source_module_index in 0..<graph.modules.len() {
        if graph.modules[source_module_index].module_identity == graph.canonical_effect_module_identity -> next
        sema_effect_leaf_collect(leaves, graph.modules[source_module_index].program.items)
    }
    found := false
    loop source_module_index in 0..<graph.modules.len() {
        if graph.modules[source_module_index].module_identity == graph.canonical_effect_module_identity -> next
        start: diagnostics.len()
        sema_effect_leaf_check_items(leaves, graph.modules[source_module_index].program.items, diagnostics)
        if diagnostics.len() > start {
            sema_attach_diagnostic_source_locations(diagnostics, start, graph.modules[source_module_index].source_segments)
            found = true
        }
    }
    found
}

sema_effect_trait_bound_set: fn(bounds: &[SemaEffectTraitBound], trait_name: String, method: String, bound: [String]) Never! {
    loop index in 0..<bounds.len() {
        if bounds[index].trait_name == trait_name && bounds[index].method == method {
            bounds[index].bound = bound
            return
        }
    }
    bounds.push(SemaEffectTraitBound{trait_name: trait_name, method: method, bound: bound})
}

// The trait-method effect ceilings one module declares. The operator
// hooks are pure; a trait method bounds its impls when it is pure or writes a
// closed row of known effects. An un-annotated method leaves each impl free.
sema_effect_trait_bounds: fn(items: [Item]) -> [SemaEffectTraitBound] Never! {
    bounds := [SemaEffectTraitBound]{}
    loop owned in OWNED_TRAITS {
        if owned.contract == .Operator(hook, _) -> bounds.push(SemaEffectTraitBound{trait_name: owned.name, method: hook, bound: [String]{}})
    }
    loop item in items {
        if item == {
            .Trait(definition) -> {
                loop method in definition.methods {
                    if method.is_pure {
                        sema_effect_trait_bound_set(bounds, definition.name, method.name, [String]{})
                        next
                    }
                    row: method.declared_effects ?? next
                    bound := [String]{}
                    closed := true
                    loop entry in row {
                        if entry.name.starts_with("..") {
                            closed = false
                            next
                        }
                        effect_name: sema_effect_parse_name(entry.name) ?? {
                            closed = false
                            next
                        }
                        if sema_effect_root(effect_name) == "Panic" {
                            closed = false
                            next
                        }
                        bound.push(effect_name)
                    }
                    if closed -> sema_effect_trait_bound_set(bounds, definition.name, method.name, bound)
                }
            }
            else -> {}
        }
    }
    bounds
}

// Rust `seed_trait_dispatch_effects` `implementations`: every
// `{trait}::{owner}` pair one module declares, through an `impl Owner.Trait`
// block or a struct/enum trait-impl block, whether or not the owner writes
// each method itself.
sema_effect_trait_implementers: fn(items: [Item]) -> [String] Never! {
    rows := [String]{}
    loop item in items {
        if item == {
            .Impl(definition) -> {
                if definition.trait_name == .Val(trait_name) -> rows.push("{trait_name}::{definition.type_name}")
            }
            .Struct(definition) -> loop block in definition.trait_impls -> rows.push("{block.trait_name}::{definition.name}")
            .Enum(definition) -> loop block in definition.trait_impls -> rows.push("{block.trait_name}::{definition.name}")
            else -> {}
        }
    }
    rows
}
