            push_diagnostic(&result, source, Diagnostic.error("E3108", "unsafe obligations can only be asserted inside `#Unsafe`", "the assertion discharges one tracked low-level operation and has no ambient meaning", "move it immediately after an operation inside the audited gate", Val(span)))
