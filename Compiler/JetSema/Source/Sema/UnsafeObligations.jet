// D-UNSAFE-OBLIG1=A: policy-resolved typed unsafe obligations.
// Parser-only assertions are checked and stripped before TIR.
use jet_foundation.[Diagnostic, Span, EnumLitArg, Expr, Func, Item, LValue, OrFallback, ProgramBundle, Stmt, StrPart, AppliedRuleApplication]
use jet_foundation.Syntax
use jet_foundation.Policy
use jet_foundation.Policy.[PolicyDeclaration, PolicyKey, PolicyScope, PolicyValue, GateSet]
use jet_sema.[package_policy_source_path, package_policy_path_covers]

