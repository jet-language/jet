// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:43
pub fn inspect(bundle: ProgramBundle) -> UnsafeInspection { inspect_with_gates(bundle, GateSet.default()) }
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:47
pub fn inspect_with_gates(bundle: ProgramBundle, gates: GateSet) -> UnsafeInspection {
    result := UnsafeInspection{gates: [], diagnostics: []}
    loop module in bundle.modules {
        loop item in module.items { visit_item(item, module.display, module.policy_declarations, module.rule_facts, gates, &result) }
    }
    apply_package_surface_policy(bundle, &result)
    result.gates.sort_by(fn(a, b) { (a.source, a.span.start, a.span.end).cmp((b.source, b.span.start, b.span.end)) })
    ^result
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:71
pub fn check_and_strip_with_gates(bundle: &ProgramBundle, gates: GateSet) -> [Diagnostic] {
    result :: inspect_with_gates(bundle, gates)
    loop &module in bundle.modules { loop &item in module.items { strip_item(&item) } }
    result.diagnostics.into_iter().map(fn(entry) { ^entry.diagnostic }).collect()
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:87
fn apply_package_surface_policy(bundle: ProgramBundle, result: &UnsafeInspection) {
    if bundle.package_guarantees.unsafe_paths == .Val(allowed_paths) {
        // Append diagnostics only; the gates remain immutable during this walk.
        loop gate in result.gates {
            if bundle.modules.iter().find(fn(module) { module.display == gate.source || module.path.to_string_lossy() == gate.source }) != .Val(module) -> continue
            if package_policy_source_path(bundle, module) != .Val(path) -> continue
            if !allowed_paths.iter().any(fn(allowed) { package_policy_path_covers(allowed, path) }) {
                push_diagnostic(&result, gate.source, Diagnostic.from_row("E2960", [("rule", "policy.unsafe"), ("subject", "#Unsafe"), ("path", path)], Val(gate.span)))
            }
        }
    }
    if bundle.package_guarantees.expert == Val(false) {
        loop module in bundle.modules {
            if package_policy_source_path(bundle, module) != .Val(path) -> continue
            if module.no_prelude { push_diagnostic(&result, module.display, expert_policy_diagnostic("#NoPrelude", path, None)) }
            loop item in module.items {
                if expert_item(item) == .Val((subject, span)) { push_diagnostic(&result, module.display, expert_policy_diagnostic(subject, path, Val(span))) }
            }
        }
    }
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:149
fn expert_policy_diagnostic(subject: String, path: String, span: Span?) -> Diagnostic {
    Diagnostic.from_row("E2960", [("rule", "policy.expert"), ("subject", subject), ("path", path)], span)
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:161
fn expert_item(item: Item) -> (String, Span)? {
    if item == {
        .Func(function) -> expert_function(function)
        .Struct(definition) -> definition.methods.iter().find_map(expert_function).or_else(fn() {
            definition.trait_impls.iter().flat_map(fn(implementation) { implementation.methods.iter() }).find_map(expert_function)
        })
        .Enum(definition) -> definition.methods.iter().find_map(expert_function).or_else(fn() {
            definition.trait_impls.iter().flat_map(fn(implementation) { implementation.methods.iter() }).find_map(expert_function)
        })
        .Impl(implementation) -> implementation.methods.iter().find_map(expert_function)
        .Test(test) -> expert_body(test.body)
        .CodeModule(module) -> module.body.and_then(fn(items) { items.iter().find_map(expert_item) })
        _ -> None
    }
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:208
fn expert_function(function: Func) -> (String, Span)? {
    if function.is_replayable -> Val(("#Replayable", function.replayable_span ?? function.name_span)) else -> expert_body(function.body)
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:219
fn expert_body(body: [Stmt]) -> (String, Span)? {
    loop statement in body {
        found :: if statement == {
            .Impure(span: span, ..) -> Val(("#Impure", span))
            .Shield(span: span, ..) -> Val(("#Shield", span))
            .Region(span: span, ..) -> Val(("#Region", span))
            .AuthorityScope(span: span, ..) -> Val(("#FX", span))
            .ContextBlock(span: span, ..) -> Val(("#Context", span))
            .Transact(span: span, ..) -> Val(("#Transact", span))
            .Live(span: span, ..) -> Val(("#Live", span))
            .AssumeDet(span: span, ..) -> Val(("assume_deterministic", span))
            .Val(binding) -> if binding.uninit -> Val(("uninit", binding.name_span)) else -> nested_bodies(statement).iter().find_map(expert_body)
            _ -> nested_bodies(statement).iter().find_map(expert_body)
        }
        if found.is_some() -> return found
    }
    None
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:240
fn push_diagnostic(result: &UnsafeInspection, source: String, diagnostic: Diagnostic) {
    result.diagnostics.push(UnsafeDiagnostic{source: source.to_string(), diagnostic: diagnostic})
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:247
fn visit_item(item: Item, source: String, declarations: [PolicyDeclaration], rule_facts: [AppliedRuleApplication], gates: GateSet, result: &UnsafeInspection) {
    if item == {
        .Func(function) -> visit_function(function, source, declarations, rule_facts, gates, &result)
        .Struct(definition) -> {
            loop function in definition.methods { visit_function(function, source, declarations, rule_facts, gates, &result) }
            loop implementation in definition.trait_impls { loop function in implementation.methods { visit_function(function, source, declarations, rule_facts, gates, &result) } }
        }
        .Enum(definition) -> {
            loop function in definition.methods { visit_function(function, source, declarations, rule_facts, gates, &result) }
            loop implementation in definition.trait_impls { loop function in implementation.methods { visit_function(function, source, declarations, rule_facts, gates, &result) } }
        }
        .Impl(implementation) -> { loop function in implementation.methods { visit_function(function, source, declarations, rule_facts, gates, &result) } }
        .Test(test) -> visit_plain_body(test.body, source, declarations, gates, &result)
        .CodeModule(module) -> { if module.body == .Val(items) { loop item in items { visit_item(item, source, declarations, rule_facts, gates, &result) } } }
        _ -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:296
fn visit_function(function: Func, source: String, declarations: [PolicyDeclaration], rule_facts: [AppliedRuleApplication], gates: GateSet, result: &UnsafeInspection) {
    if function.is_unsafe {
        source_has_reason :: rule_facts.iter().any(fn(application) {
            application.target == Val(function.span) && application.marker.name == Syntax.KW_UNSAFE && !application.marker.args.is_empty()
        })
        visit_gate(function.span, function.unsafe_span ?? function.span, true, function.unsafe_reason, source_has_reason, function.body, source, declarations, gates, &result)
    } else { visit_plain_body(function.body, source, declarations, gates, &result) }
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:327
fn visit_plain_body(body: [Stmt], source: String, declarations: [PolicyDeclaration], gates: GateSet, result: &UnsafeInspection) {
    visit_nested_gates(body, source, declarations, gates, &result)
    reject_assertions_outside_gate(body, source, &result)
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:338
fn visit_nested_gates(body: [Stmt], source: String, declarations: [PolicyDeclaration], gates: GateSet, result: &UnsafeInspection) {
    loop statement in body {
        if statement == .Unsafe(audit: audit, audit_expr: audit_expr, body: nested, span: span) {
            visit_gate(span, span, false, audit, audit_expr.is_some(), nested, source, declarations, gates, &result)
        } else {
            loop nested in nested_bodies(statement) { visit_nested_gates(nested, source, declarations, gates, &result) }
        }
    }
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:373
fn visit_gate(target: Span, gate_span: Span, is_function: Bool, reason: String?, source_has_reason: Bool, body: [Stmt], source: String, declarations: [PolicyDeclaration], gates: GateSet, result: &UnsafeInspection) {
    outer := [PolicyDeclaration]{}
    site := [PolicyDeclaration]{}
    loop declaration in declarations {
        if declaration.key != PolicyKey.Unsafe -> continue
        if declaration.scope == .Organization || declaration.scope == .Package || declaration.scope == .Module { outer.push(declaration.clone()) }
        if declaration.target == Val(target) { site.push(declaration.clone()) }
    }
    outer_policy :: Policy.resolve_with_gates(PolicyKey.Unsafe, outer.clone(), gates) or _ => { None }
    chain := ^outer
    chain.extend(site.clone())
    effective :: Policy.resolve_with_gates(PolicyKey.Unsafe, ^chain, gates) or _ => {
        code :: if gates.allows(PolicyKey.Unsafe) -> "E3415" else -> "E0355"
        push_diagnostic(&result, source, Diagnostic.error(code, "audited gate denied by effective policy", "an organization or package policy can refuse an audited escape, including its invocation gate", "remove `--gate unsafe=allow` or change the owning policy", Val(gate_span)))
        None
    }
    value := effective.map(fn(policy) { policy.value }) ?? Policy.default_gate_value(PolicyKey.Unsafe)
    if value == PolicyValue.PerSite {
        push_diagnostic(&result, source, Diagnostic.error("E3106", "this unsafe gate must choose an obligation mode",
            "the effective `.PerSite` policy requires every gate to select `.Track` or `.Skip`", "add `obligations: .Track` (or `.Skip` when organization policy permits it)", Val(gate_span)))
        value = PolicyValue.Track
    }
    if site.iter().any(fn(declaration) { declaration.value == PolicyValue.Skip }) && outer_policy.map(fn(policy) { policy.value }) != Val(PolicyValue.PerSite) {
        push_diagnostic(&result, source, Diagnostic.error("E3106", "this unsafe gate cannot skip obligations", "`.Skip` is site control for an effective `.PerSite` package policy; it is not ambient authorization", "set package policy to `.PerSite`, or remove `.Skip`", Val(gate_span)))
        value = PolicyValue.Track
    }
    if value == PolicyValue.Forbid {
        push_diagnostic(&result, source, Diagnostic.error("E3105", "organization or package policy forbids unsafe code", "a lexical `#Unsafe` gate cannot widen the effective safety floor", "remove the low-level operation or change the outer policy through its owner", Val(gate_span)))
    } else if reason.is_none() && !source_has_reason && value != PolicyValue.Relaxed {
        (what, why, fix) :: if is_function -> ("this `#Unsafe` function has no reason", "every gated function records why callers can rely on its unsafe contract", "add the reason: `#Unsafe(\"why this is safe\") fn ...`")
            else -> ("this `#Unsafe` block has no reason", "every gated region records why it can't break memory safety", "add the reason: `#Unsafe(\"why this is safe\") { … }`")
        push_diagnostic(&result, source, Diagnostic.error("E3112", what, why, fix, Val(gate_span)))
    }
    provenance := [String]{}
    if effective == .Val(policy) {
        loop declaration in policy.provenance {
            provenance.push("{declaration.scope.name()}:{declaration.source}:{declaration.span.start}..{declaration.span.end}={declaration.value.display()}")
        }
    }
    gate := UnsafeGateInspection{source: source.to_string(), span: gate_span, reason: reason.map(fn(text) { text.to_string() }), mode: mode_name(value).to_string(), provenance: ^provenance, operations: []}
    scan_sequence(body, requires_obligations(value), &gate, source, &result.diagnostics)
    result.gates.push(^gate)
    visit_nested_gates(body, source, declarations, gates, &result)
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:528
fn mode_name(value: PolicyValue) -> String {
    if value == {
        .Obligations | .Track -> "Obligations"
        .Relaxed -> "Relaxed"
        .PerSite -> "PerSite"
        .Skip | .Default | .GateOnly -> "GateOnly"
        .Forbid -> "Forbid"
        _ -> "GateOnly"
    }
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:539
fn requires_obligations(value: PolicyValue) -> Bool { value == .Obligations || value == .Track }
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:543
fn scan_sequence(body: [Stmt], track: Bool, gate: &UnsafeGateInspection, source: String, diagnostics: &[UnsafeDiagnostic]) {
    pending_operations := [(String, Span, [String])]{}
    loop statement in body {
        if assertion(statement) == .Val((names, span)) {
            if pending_operations.is_empty() {
                diagnostics.push(UnsafeDiagnostic{source: source.to_string(), diagnostic: Diagnostic.error("E3108", "this unsafe assertion has no preceding operation", "typed obligations attach only to the immediately preceding low-level operation statement", "move the assertion directly after the operation it proves", Val(span))})
                continue
            }
            asserted := [String:Bool]{}
            loop name in names {
                if name == Syntax.UNSAFE_OBLIGATION_VALID_PTR || name == Syntax.UNSAFE_OBLIGATION_ALIGNED || name == Syntax.UNSAFE_OBLIGATION_NO_ALIAS { _ :: asserted.insert(name, true) }
                else {
                    diagnostics.push(UnsafeDiagnostic{source: source.to_string(), diagnostic: Diagnostic.error("E3108", "`{name}` is not an unsafe obligation", "unsafe proofs use the closed typed set `valid_ptr`, `aligned`, and `no_alias`", "fix the obligation name", Val(span))})
                }
            }
            discharge_operations(pending_operations, asserted, track, &gate, source, &diagnostics)
            pending_operations.clear()
            continue
        }
        discharge_operations(pending_operations, [String:Bool]{}, track, &gate, source, &diagnostics)
        pending_operations.clear()
        if statement == .Unsafe(..) -> continue
        collect_shallow_operations(statement, &pending_operations)
        loop nested in nested_bodies(statement) { scan_sequence(nested, track, &gate, source, &diagnostics) }
    }
    discharge_operations(pending_operations, [String:Bool]{}, track, &gate, source, &diagnostics)
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:610
fn discharge_operations(operations: [(String, Span, [String])], asserted: [String:Bool], track: Bool, gate: &UnsafeGateInspection, source: String, diagnostics: &[UnsafeDiagnostic]) {
    sorted_asserted := asserted.keys().collect(); sorted_asserted.sort()
    loop (kind, span, required) in operations {
        missing :: required.iter().filter(fn(name) { !asserted.contains_key(name) }).collect()
        discharged :: !track || missing.is_empty()
        if track && !missing.is_empty() {
            diagnostics.push(UnsafeDiagnostic{source: source.to_string(), diagnostic: Diagnostic.error("E3107", "`{kind}` is missing unsafe obligations: {missing.join(", ")}", "the effective `.Obligations` policy requires a typed proof immediately after each low-level operation", "add `assert {required.join(", ")}` immediately after this operation", Val(span))})
        }
        gate.operations.push(UnsafeOperationInspection{kind: kind.to_string(), span: span, required: required.iter().map(fn(name) { name.to_string() }).collect(), asserted: sorted_asserted.clone(), discharged: discharged})
    }
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:638
fn assertion(statement: Stmt) -> ([String], Span)? {
    if statement != .Expr(.Call(call)) -> return None
    if call.name != Syntax.INTERNAL_UNSAFE_ASSERT -> return None
    Val((call.args.iter().filter_map(fn(argument) { if argument.expr == .Ident(name, _) -> Val(name.clone()) else -> None }).collect(), call.name_span))
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:657
fn collect_shallow_operations(statement: Stmt, out: &[(String, Span, [String])]) {
    if statement == {
        .Expr(expression) | .DeferClose(close: expression, ..) | .Return(.Val(expression), _) -> collect_expr_operations(expression, &out)
        .Val(binding) -> collect_expr_operations(binding.init, &out)
        .Assign(target: target, value: value, ..) -> { collect_lvalue_operations(target, &out); collect_expr_operations(value, &out) }
        .While(cond: cond, ..) -> collect_expr_operations(cond, &out)
        .CountedLoop(init: init, cond: cond, step: step, ..) -> {
            collect_expr_operations(init.init, &out); collect_expr_operations(cond, &out)
            if step == .Val(step) { collect_shallow_operations(step, &out) }
        }
        .For(kind: kind, ..) -> {
            if kind == {
                .Range(start: start, end: end, step: step, ..) -> {
                    collect_expr_operations(start, &out); collect_expr_operations(end, &out)
                    if step == .Val(step) { collect_expr_operations(step, &out) }
                }
                .In(collection: collection, step: step) -> {
                    collect_expr_operations(collection, &out)
                    if step == .Val(step) { collect_expr_operations(step, &out) }
                }
            }
        }
        .Switch(subject: subject, ..) | .ComptimeSwitch(subject: subject, ..) -> collect_expr_operations(subject, &out)
        .ComptimeIf(cond: cond, ..) -> collect_expr_operations(cond, &out)
        .ContextBlock(fields: fields, ..) -> { loop (_, value, _) in fields { collect_expr_operations(value, &out) } }
        .ScopeMember(args: args, ..) -> { loop argument in args { collect_expr_operations(argument, &out) } }
        .Yield(value, _) -> collect_expr_operations(value, &out)
        _ -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:720
fn collect_lvalue_operations(value: LValue, out: &[(String, Span, [String])]) {
    if value == {
        .Local(..) -> {}
        .Index(base: base, index: index, ..) -> { collect_expr_operations(base, &out); collect_expr_operations(index, &out) }
        .Field(base: base, ..) -> collect_expr_operations(base, &out)
    }
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:734
fn collect_expr_operations(expression: Expr, out: &[(String, Span, [String])]) {
    if expression == {
        .PtrFromAddr(addr: addr, span: span, ..) -> {
            out.push(("pointer_from_address", span, [Syntax.UNSAFE_OBLIGATION_VALID_PTR, Syntax.UNSAFE_OBLIGATION_ALIGNED]))
            collect_expr_operations(addr, &out)
        }
        .Deref(inner, span) -> {
            out.push(("dereference", span, [Syntax.UNSAFE_OBLIGATION_VALID_PTR, Syntax.UNSAFE_OBLIGATION_ALIGNED]))
            collect_expr_operations(inner, &out)
        }
        .RawOf(inner, span) -> {
            out.push(("raw_pointer", span, [Syntax.UNSAFE_OBLIGATION_NO_ALIAS]))
            collect_expr_operations(inner, &out)
        }
        .MethodCall(receiver: receiver, method: method, args: args, method_span: method_span, ..) -> {
            required :: if method == {
                "volatile_read" -> Val(("volatile_read", [String]{Syntax.UNSAFE_OBLIGATION_VALID_PTR, Syntax.UNSAFE_OBLIGATION_ALIGNED}))
                "volatile_write" -> Val(("volatile_write", [String]{Syntax.UNSAFE_OBLIGATION_VALID_PTR, Syntax.UNSAFE_OBLIGATION_ALIGNED, Syntax.UNSAFE_OBLIGATION_NO_ALIAS}))
                "cast_ptr" -> Val(("pointer_cast", [String]{Syntax.UNSAFE_OBLIGATION_VALID_PTR, Syntax.UNSAFE_OBLIGATION_ALIGNED}))
                _ -> None
            }
            if required == .Val((kind, obligations)) { out.push((kind, method_span, obligations)) }
            collect_expr_operations(receiver, &out)
            loop argument in args { collect_expr_operations(argument.expr, &out) }
        }
        .Call(call) -> { loop argument in call.args { collect_expr_operations(argument.expr, &out) } }
        .Str(parts, _) -> { loop part in parts { if part == .Interp(value, _) { collect_expr_operations(value, &out) } } }
        .Binary(_, left, right, _) -> { collect_expr_operations(left, &out); collect_expr_operations(right, &out) }
        .CompareChain(operands: operands, ..) | .ListLit(operands, _) -> { loop operand in operands { collect_expr_operations(operand, &out) } }
        .Index(base: base, index: index, ..) -> { collect_expr_operations(base, &out); collect_expr_operations(index, &out) }
        .Slice(base: base, start: start, end: end, range: range, ..) -> {
            collect_expr_operations(base, &out)
            if range == .Val(range) { collect_expr_operations(range, &out) }
            else { collect_expr_operations(start, &out); collect_expr_operations(end, &out) }
        }
        .Range(start: start, end: end, ..) -> { collect_expr_operations(start, &out); collect_expr_operations(end, &out) }
        .Unary(_, inner, _) | .Copy(inner, _) | .Place(inner, _, _) | .Field(inner, _, _)
            | .OptField(base: inner, ..) | .Paren(inner, _) | .Spread(inner, _) -> collect_expr_operations(inner, &out)
        .StructLit(fields: fields, ..) -> { loop (_, _, value) in fields { collect_expr_operations(value, &out) } }
        .TypedLit(body: body, ..) -> body.for_each_expr(fn(value) { collect_expr_operations(value, &out) })
        .EnumLit(args: args, ..) -> {
            loop argument in args { if argument == { .Positional(value) | .Named(expr: value, ..) -> collect_expr_operations(value, &out) } }
        }
        .MapLit(entries, _) -> { loop (key, value) in entries { collect_expr_operations(key, &out); collect_expr_operations(value, &out) } }
        .TupleLit(fields, _, _) -> { loop (_, value) in fields { collect_expr_operations(value, &out) } }
        .CallValue(callee: callee, args: args, ..) -> {
            collect_expr_operations(callee, &out)
            loop argument in args { collect_expr_operations(argument.expr, &out) }
        }
        .Tainted(inner, _, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) -> collect_expr_operations(inner, &out)
        .Try(inner, _, _, note) -> {
            collect_expr_operations(inner, &out)
            if note == .Val(note) { collect_expr_operations(note, &out) }
        }
        .PatternTest(subject: subject, ..) -> collect_expr_operations(subject, &out)
        .OrFallback(value: value, fallback: fallback, ..) -> {
            collect_expr_operations(value, &out)
            if fallback == {
                .Value(value) | .Return(.Val(value), _) -> collect_expr_operations(value, &out)
                .Block(body: body, value: value, ..) -> {
                    loop statement in body { collect_shallow_operations(statement, &out) }
                    if value == .Val(value) { collect_expr_operations(value, &out) }
                }
                .Panic(args: args, ..) -> { loop argument in args { collect_expr_operations(argument.expr, &out) } }
                .Return(.None, _) | .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> {}
            }
        }
        .If(cond: cond, then_value: then_value, else_value: else_value, ..) -> {
            collect_expr_operations(cond, &out); collect_expr_operations(then_value, &out); collect_expr_operations(else_value, &out)
        }
        _ -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/UnsafeObligations.rs:947
pub fn nested_bodies(statement: Stmt) -> [[Stmt]] from statement {
    if statement == {
        .While(body: body, ..) | .For(body: body, ..) | .Loop(body: body, ..) | .CountedLoop(body: body, ..)
            | .Impure(body: body, ..) | .Reactive(body: body, ..) | .Shield(body: body, ..) | .Switched(body: body, ..)
