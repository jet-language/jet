// Shared static-guarantee fact graph; individual sema passes enforce facts.
use jet_foundation.[Diagnostic, Func, Item, Program, Type, PolicyKey]
use jet_lexer.[lex]
use jet_parser.[parse_with_source]

// Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:16
pub enum PolicyDomain { Refinement; Contract; Taint; Budget; Bounds; Replay; Memory }
impl PolicyDomain {
    // Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:28
    pub fn as_str(self) -> String Never! {
        if self == { .Refinement -> "refinement"; .Contract -> "contract"; .Taint -> "taint"; .Budget -> "budget"; .Bounds -> "bounds"; .Replay -> "replay"; .Memory -> "memory" }
    }
}
// Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:42
pub struct PolicyFact { pub domain: PolicyDomain; pub subject: String; pub detail: String }
// Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:50
pub struct PolicyFactGraph { rows: [PolicyFact] }
impl PolicyFactGraph {
    pub fn default() -> PolicyFactGraph Never! { PolicyFactGraph{rows: []} }
    // Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:55
    pub fn record(self: &Self, domain: PolicyDomain, subject: String, detail: String) {
        &self.rows.push(PolicyFact{domain: domain, subject: subject, detail: detail})
    }
    // Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:68
    pub fn facts(self: Self) -> [PolicyFact] Never! { self.rows }
    // Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:72
    pub fn domains(self: Self) -> [PolicyDomain:Bool] Never! {
        // GATE #4499: preserve enum-key equality/order, never string-key encoding.
        domains := [PolicyDomain:Bool]{}
        loop fact in self.rows -> domains[fact.domain] = true
        domains
    }
    // Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:76
    pub fn has_domain(self: Self, domain: PolicyDomain) -> Bool Never! {
        loop fact in self.rows { if fact.domain == domain -> return true }
        false
    }
}
// Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:82
pub fn collect_policy_facts(src: String) -> PolicyFactGraph [Diagnostic]! {
    (tokens, diagnostics) :: lex(src)
    if !diagnostics.is_empty() -> fail diagnostics
    program :: parse_with_source(tokens, src)?
    collect_policy_facts_from_program(program)
}
// Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:91
pub fn collect_policy_facts_from_program(program: Program) -> PolicyFactGraph Never! {
    graph := PolicyFactGraph.default()
    loop declaration in program.policy_declarations {
        if declaration.key == PolicyKey.Copies || declaration.key == PolicyKey.Sentries {
            &graph.record(PolicyDomain.Memory, declaration.key.name(), "{declaration.scope.name()} {declaration.value.display()} at {declaration.span.start}..{declaration.span.end}")
        }
    }
    loop item in program.items -> collect_memory_denials(&graph, item)
    collect_items(&graph, program.items)
    graph
}
// Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:118
fn collect_memory_denials(graph: &PolicyFactGraph, item: Item) {
    record :: fn(function: Func) {
        if function.declared_effects == .Val(effects) {
            loop (name, span) in effects {
                if name.starts_with("!Mem.") -> &graph.record(PolicyDomain.Memory, name, "function denial at {span.start}..{span.end}")
            }
        }
    }
    if item == {
        .Func(function) -> record(function)
        .Impl(definition) -> { loop method in definition.methods -> record(method) }
        .Struct(definition) -> {
            loop method in definition.methods -> record(method)
            loop block in definition.trait_impls { loop method in block.methods -> record(method) }
        }
        .Enum(definition) -> {
            loop method in definition.methods -> record(method)
            loop block in definition.trait_impls { loop method in block.methods -> record(method) }
        }
        .CodeModule(module) -> { if module.body == .Val(body) { loop inner in body -> collect_memory_denials(&graph, inner) } }
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:163
fn collect_items(graph: &PolicyFactGraph, items: [Item]) {
    loop item in items {
        if item == {
            .Distinct(definition) -> {
                if definition.range == .Val((lo, hi, _)) {
                    &graph.record(PolicyDomain.Refinement, definition.name, "range fact proves value in {lo}..{hi}")
                    &graph.record(PolicyDomain.Bounds, definition.name, "interval fact feeds D-OOBPROOF1 fixed-list indexing")
                }
            }
            .Func(function) -> collect_func(&graph, function)
            .Impl(definition) -> { loop method in definition.methods -> collect_func(&graph, method) }
            .Struct(definition) -> {
                loop method in definition.methods -> collect_func(&graph, method)
                loop block in definition.trait_impls { loop method in block.methods -> collect_func(&graph, method) }
            }
            .Enum(definition) -> { loop method in definition.methods -> collect_func(&graph, method) }
            .CodeModule(module) -> { if module.body == .Val(body) -> collect_items(&graph, body) }
            else -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:211
fn collect_func(graph: &PolicyFactGraph, function: Func) {
    if !function.pre.is_empty() || !function.post.is_empty() -> &graph.record(PolicyDomain.Contract, function.name, "#Pre×{function.pre.len()} #Post×{function.post.len()}")
    if function.scrub_tag == .Val(tag) -> &graph.record(PolicyDomain.Taint, function.name, "#Scrub({tag}) clears the declared tag and compiler-owned origin facts (D-TAG-SURFACE1, D-BOUND-TAINT1)")
    if function.is_replayable -> &graph.record(PolicyDomain.Replay, function.name, "#Replayable forbids ambient Time/Rand/Net/IO (D-REPLAY1)")
    if function.declared_effects == .Val(effects) {
        if !effects.is_empty() {
            names := [String]{}
            loop (name, _) in effects -> &names.push(name)
            &graph.record(PolicyDomain.Budget, function.name, "declared effect bound -[{names.join(", ")}]> feeds D-EFFBUDGET1")
        }
    }
    if func_has_fixed_list_param(function) && func_has_interval_index_param(function) -> &graph.record(PolicyDomain.Bounds, function.name, "fixed-list param + interval index param share D-OOBPROOF1 facts")
}
// Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:257
fn func_has_fixed_list_param(function: Func) -> Bool Never! {
    loop param in function.params { if param.ty == .FixedList(_, _) -> return true }
    false
}
// Rust: crates/jet-sema/src/Sema/PolicyFacts.rs:263
fn func_has_interval_index_param(function: Func) -> Bool Never! {
    loop param in function.params { if param.ty == { .Named(_) | .IntN(_, _) -> true; else -> false } -> return true }
    false
}
