use jet_foundation.[AccessConvention, Expr, Type, Span, Item, StrPart, EnumLitArg, OrFallback]
use jet_sema.[Checker, LocalInfo, already_defined, OriginFact]
use jet_comptime.[CtValue, evaluate_owned_with_imports_opts_collecting_items]
use std.borrow.[Cow]
use jet_syntax.[TYPE_COMPLEX, DURATION_TYPE, numeric_conversion_method, KW_FREEZE, KW_IT]

impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:9
    pub fn push_scope(&self) Never! {
        self.flow.enter_scope()
        self.concrete_unit_values.push([:])
        self.lambda_mut_borrow_stack.push([:])
        self.ct_scopes.push([:])
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:16
    pub fn pop_scope(&self) Never! {
        self.check_single_use_consumed_in_current_scope()
        self.drop_scope_no_obligation_checks()
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:21
    pub fn drop_scope_no_obligation_checks(&self) Never! {
        // Every scope-lived plane leaves the shared store together.
        self.flow.leave_scope()
        _ :: self.concrete_unit_values.pop()
        _ :: self.lambda_mut_borrow_stack.pop()
        _ :: self.ct_scopes.pop()
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:31
    pub fn scope_depth(self) -> Int Never! { self.flow.depth }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:38
    pub fn declare_in_scope(&self, name: String, info: ^LocalInfo) Never! {
        depth :: self.flow.depth
        if !info.invalid { self.note_unused_binding(name, info.def_span, info.param_conv.is_some()) }
        sendable :: self.sendability_problem(info.ty, true).is_none()
        self.flow.bindings.set_at(name, depth, ^info)
        self.flow.sendability.set_at(name, depth, sendable)
        self.flow.path_strings.remove_at(name, depth)
        self.flow.origins.set_at(name, depth, OriginFact.untracked())
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:57
    pub fn visible_names(self) -> [String] Never! {
        names := [String]{}
        loop (name, _) in self.flow.bindings.all() { names.push(~name) }
        names
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:65
    pub fn lambda_mut_borrow_active(self, name: String) -> Bool Never! {
        loop scope in self.lambda_mut_borrow_stack { if scope.contains(name) -> return true }
        false
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:71
    pub fn current_ct_globals(self) -> Cow<[String:CtValue]> Never! {
        overlays := false
        loop scope in self.ct_scopes { if !scope.is_empty() { overlays = true; break } }
        if !overlays -> return Cow.Borrowed(self.ct_globals)
        globals := ~self.ct_globals
        loop scope in self.ct_scopes {
            loop (name, value) in scope { globals[~name] = ~value }
        }
        Cow.Owned(^globals)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:91
    pub fn current_ct_binding_types(self, values: [String:CtValue]) -> [String:Type] Never! {
        types := [String:Type]{}
        loop name in values.keys() {
            if self.flow.bindings.get(name) == .Val(info) { types[~name] = ~info.ty }
            else if self.consts.get(name) == .Val(ty) { types[~name] = ~ty }
        }
        types
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:112
    pub fn apply_ct_mutations(&self, mutated: ^[String:CtValue]) Never! {
        loop (name, value) in mutated {
            loop index in (0..<self.ct_scopes.len()).rev() {
                if self.ct_scopes[index].has_key(name) {
                    self.ct_scopes[index][~name] = ^value
                    break
                }
            }
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:136
    pub fn is_explicit_constant(self, expr: Expr, values: [String:CtValue]) -> Bool Never! {
        if expr == {
            .Int, .Float, .Bool, .Char, .Unit, .Absent, .UnitLit, .ComptimeName -> true
            .Str(parts, _) -> {
                loop part in parts {
                    if part == .Interp(inner, _) && !self.is_explicit_constant(inner, values) -> return false
                }
                true
            }
            .Paren(inner, _), .Unary(_, inner, _), .Present(inner, _) -> self.is_explicit_constant(inner, values)
            .Binary(_, left, right, _) -> self.is_explicit_constant(left, values) && self.is_explicit_constant(right, values)
            .CompareChain(operands, _), .ListLit(operands, _) -> {
                loop operand in operands { if !self.is_explicit_constant(operand, values) -> return false }
                true
            }
            .TupleLit(fields, _) -> {
                loop (_, value) in fields { if !self.is_explicit_constant(value, values) -> return false }
                true
            }
            .MapLit(entries, _) -> {
                loop (key, value) in entries { if !self.is_explicit_constant(key, values) || !self.is_explicit_constant(value, values) -> return false }
                true
            }
            .EnumLit(_, _, args, _) -> {
                loop arg in args {
                    value :: if arg == { .Positional(v) -> v; .Named(_, v, _) -> v }
                    if !self.is_explicit_constant(value, values) -> return false
                }
                true
            }
            .Ident(name, _) -> self.names_explicit_constant(name, values)
            .Field(base, _) -> self.qualifies_explicit_constant(base, values)
            .OrFallback(value, .Panic, _) -> self.is_elaborated_unit_literal(value) && self.is_explicit_constant(value, values)
            .MethodCall -> {
                if !self.is_elaborated_unit_literal(expr) -> return false
                loop arg in expr.args { if !self.is_explicit_constant(arg.expr, values) -> return false }
                true
            }
            .Call(call) -> {
                if call.name != TYPE_COMPLEX -> return false
                loop arg in call.args { if !self.is_explicit_constant(arg.expr, values) -> return false }
                true
            }
            else -> false
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:191
    fn is_elaborated_unit_literal(self, expr: Expr) -> Bool Never! {
        if expr != .MethodCall -> return false
        if expr.receiver != .Ident -> return false
        owner :: expr.receiver.name
        if self.lookup(owner).is_some() -> return false
        (owner == DURATION_TYPE && expr.method == "nanoseconds") || (self.registry.is_distinct(owner) && numeric_conversion_method("Float") == Val(expr.method))
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:212
    fn qualifies_explicit_constant(self, base: Expr, values: [String:CtValue]) -> Bool Never! {
        if base == .Field(inner, _) -> return self.qualifies_explicit_constant(inner, values)
        if base == .Ident(name, _) && self.lookup(name).is_none() && !self.consts.has_key(name) -> return true
        self.is_explicit_constant(base, values)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:228
    fn names_explicit_constant(self, name: String, values: [String:CtValue]) -> Bool Never! {
        if self.lookup(name).is_none() -> return values.has_key(name)
        if self.flow.bindings.depth_of(name) != .Val(depth) -> return false
        if depth < 1 || depth > self.ct_scopes.len() -> return false
        if self.ct_scopes[depth - 1].get(name) != .Val(local_value) -> return false
        values.get(name) == Val(local_value)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:254
    pub fn evaluate_constant(self, expr: Expr) -> CtValue? Never! {
        if self.defer_ct_evaluation -> return None
        globals :: self.current_ct_globals().into_owned()
        if !self.is_explicit_constant(expr, globals) -> return None
        binding_types :: self.current_ct_binding_types(globals)
        checked_nominals :: self.checked_comptime_nominals()
        result :: evaluate_owned_with_imports_opts_collecting_items(expr, self.ct_checked_funcs_for_evaluation(), self.ct_externs, self.ct_base_dir, globals, binding_types, self.core_imports, self.gates, 0, [], checked_nominals, None)
        if result == .Ok((value, _)) -> return Val(^value)
        None
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:289
    pub fn lookup(self, name: String) -> LocalInfo? Never! from self {
        if name == "_" -> return None
        declared :: self.flow.bindings.depth_of(name)
        narrowed :: self.flow.narrow.depth_of(name)
        if declared == .Val(d) {
            if narrowed == .Val(n) && n >= d -> return self.flow.narrow.get(name)
            return self.flow.bindings.get(name)
        }
        if narrowed.is_some() -> return self.flow.narrow.get(name)
        None
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:306
    pub fn is_global_mutable_binding(self, name: String) -> Bool Never! {
        loop item in self.items {
            if item == .Const(c) && c.name == name && c.mutable && !c.is_comptime -> return true
        }
        false
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:316
    pub fn sendability_for(self, name: String) -> Bool Never! {
        if self.binding_fact_depth(name) != .Val(depth) -> return true
        self.flow.sendability.get_at(name, depth).unwrap_or(true)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:329
    pub fn frozen_for(self, name: String) -> Span? Never! {
        declared :: self.flow.bindings.depth_of(name)
        narrowed :: self.flow.narrow.depth_of(name)
        if declared == .Val(d) {
            if narrowed == .Val(n) && n >= d {
                if self.flow.frozen.get_at(name, n) == .Val(site) -> return Val(site)
            }
            return self.flow.frozen.get_at(name, d)
        }
        if narrowed == .Val(n) -> return self.flow.frozen.get_at(name, n)
        None
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:345
    pub fn binding_fact_depth(self, name: String) -> Int? Never! {
        declared :: self.flow.bindings.depth_of(name)
        narrowed :: self.flow.narrow.depth_of(name)
        if declared == .Val(d) {
            if narrowed == .Val(n) && n >= d -> return Val(n)
            return Val(d)
        }
        narrowed
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:358
    pub fn frozen_expr_site(self, expr: Expr) -> Span? Never! {
        if expr == {
            .Ident(name, _) -> self.frozen_for(name)
            .Field(base, _), .Index(base, _), .Slice(base, _), .Place(base, _), .Paren(base, _) -> self.frozen_expr_site(base)
            .Call(call) -> { if call.name == KW_FREEZE && call.args.len() == 1 -> return Val(call.name_span); None }
            else -> None
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:377
    pub fn set_interrupt_sendable(&self, name: String, sendable: Bool) Never! {
        if self.flow.bindings.get_mut(name) == .Val(info) { info.interrupt_sendable = sendable && info.param_conv.is_none() }
        if self.flow.narrow.get_mut(name) == .Val(info) { info.interrupt_sendable = sendable && info.param_conv.is_none() }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:389
    pub fn is_borrowed_binding(self, name: String) -> Bool Never! {
        if self.lookup(name) == .Val(info) -> return info.param_conv == Val(AccessConvention.Read) && !info.ty.is_scalar()
        false
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:397
    pub fn declare(&self, name: String, name_span: Span, info: ^LocalInfo) Never! {
        if name == "_" -> return
        if !info.invalid { self.note_unused_binding(name, info.def_span, info.param_conv.is_some()) }
        if self.lookup(name).is_some() || self.consts.has_key(name) || self.loop_labels.contains(name) { self.diags.push(already_defined(name, name_span)) }
        self.clear_moved_binding(name)
        depth :: self.flow.depth
        self.flow.narrow.remove_at(name, depth)
        self.flow.sendability.remove_at(name, depth)
        self.flow.frozen.remove_at(name, depth)
        self.flow.path_strings.remove_at(name, depth)
        self.flow.bindings.set_at(name, depth, ^info)
        self.flow.sendability.set_at(name, depth, true)
        self.flow.origins.set_at(name, depth, OriginFact.untracked())
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:425
    pub fn declare_with_sendability(&self, name: String, name_span: Span, info: ^LocalInfo, sendable: Bool) Never! {
        self.declare(name, name_span, ^info)
        self.flow.sendability.set_at(name, self.flow.depth, sendable)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:437
    pub fn declare_loop_var(&self, name: ^String, name_span: Span, ty: Type) Never! {
        if name == "_" -> return
        if name == KW_IT && self.implicit_loop_subject_depth > 0 -> return
        if self.lookup(name).is_some() || self.consts.has_key(name) || self.loop_labels.contains(name) {
            self.diags.push(already_defined(name, name_span))
        } else {
            depth :: self.flow.depth
            self.note_unused_binding(name, name_span, false)
            self.clear_moved_binding(name)
            self.flow.bindings.set_at(name, depth, LocalInfo{def_span: name_span, binding_sigil_span: None, ty: ~ty, mutable: false, param_conv: None, decl_loop_depth: self.loop_depth, interrupt_sendable: false, reactive_local: false, reactive_shared: false, single_use_span: None, invalid: false})
            self.flow.sendability.set_at(name, depth, true)
            self.flow.path_strings.remove_at(name, depth)
            self.flow.origins.set_at(name, depth, OriginFact.untracked())
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:488
    pub fn declare_invalid_loop_vars(&self, var: String, var_span: Span, var2: (String, Span)?) Never! {
        // At most two names, retaining the original declaration order.
        names := [(String, Span)]{(~var, var_span)}
        if var2 == .Val(second) { names.push(~second) }
        loop (name, name_span) in names {
            if name == "_" || self.lookup(name).is_some() -> continue
            depth :: self.flow.depth
            self.clear_moved_binding(name)
            self.flow.bindings.set_at(name, depth, LocalInfo{def_span: name_span, binding_sigil_span: None, ty: Type.Named(""), mutable: false, param_conv: None, decl_loop_depth: self.loop_depth, interrupt_sendable: false, reactive_local: false, reactive_shared: false, single_use_span: None, invalid: true})
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:524
    pub fn clear_origin(&self, name: String) Never! {
        depth := self.scope_depth()
        if self.binding_fact_depth(name) == .Val(d) { depth = d }
        if self.flow.origins.depth_of(name) == .Val(d) { depth = d }
        self.flow.origins.set_at(name, depth, OriginFact.untracked())
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/scopes.rs:536
    pub fn declare_loop_label(&self, name: String, name_span: Span) Never! {
        if self.lookup(name).is_some() || self.consts.has_key(name) || self.loop_labels.contains(name) { self.diags.push(already_defined(name, name_span)) }
        self.loop_labels.push(~name)
    }
}
