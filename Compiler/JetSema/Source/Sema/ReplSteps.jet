// Persistent statement checking: the file checker owns every rule. Checkpoints
// restore all compiler facts after a refused input; no successful empty TIR.
use jet_foundation.[Binding, Diagnostic, Func, Span, Stmt, TExpr, TFunc, TStmt, TTypeDef, Type]

pub struct SemaReplSession {
    environment: SemaScopeEnvironment
    scopes: SemaScopeTable
    ownership: SemaOwnershipState
    tails: SemaStatementTailStore
    context: SemaCheckContext
    modules: [SemaGraphModuleResult]
    source: Func
    root: TFunc
}

pub struct SemaReplStep {
    pub complete: Bool
    pub root: TFunc
    pub statements: [TStmt]
    pub echo: TExpr?
    pub diagnostics: [Diagnostic]
    pub incomplete_reasons: [String]{[String]{}}
}

pub fn sema_repl_session_new(graph: SemaRegistrationGraph, modules: ^[SemaGraphModuleResult], source: Func, root: TFunc) -> SemaReplSession String! {
    if source.params.len() != 0 || source.body.len() != 0 || root.params.len() != 0 || root.body.len() != 0 {
        return Err("REPL checking requires an empty checked zero-parameter root")
    }
    checked_types := [TTypeDef]{}
    loop module_row in modules {
        loop definition in module_row.declarations.type_defs -> &checked_types.push(definition)
    }
    environment := sema_check_pass_environment(graph, checked_types)
    if !sema_scope_environment_enter_probe_module(&environment, root.module_identity, [SemaComptimeBodyValue]{}) {
        return Err("REPL root is not in the canonical registration graph")
    }
    scopes := sema_scope_init(root.module_identity)
    diagnostics := [Diagnostic]{}
    if !sema_registration_apply_graph_module(graph, root.module_identity, &scopes, &diagnostics) || sema_has_error_since(diagnostics, 0) {
        return Err("REPL declaration environment is not a successfully registered module")
    }
    sema_function_apply_scope_policies(environment, &scopes, source.span, source.markers)
    ownership := sema_ownership_state_init()
    ownership.fixed_length_write_params = environment.fixed_length_write_params
    ownership.static_roots = sema_function_static_roots(environment, root.module_identity)
    _ :: sema_scope_enter(&scopes, &ownership, root.key)
    return_type :: sema_checked_return_type(source.return_type, false)
    scopes.return_type = Val(return_type)
    scopes.failure_carrier = Val(sema_failure_carrier(Val(return_type)))
    context := sema_check_context_init()
    context.function_name = root.name
    context.comptime_body_values = environment.comptime_body_values
    environment.function_name = root.name
    Ok(SemaReplSession{environment: ^environment, scopes: ^scopes, ownership: ^ownership, tails: sema_statement_tail_store_init(), context: ^context, modules: ^modules, source: source, root: root})
}

pub fn sema_repl_type_check_stmts(session: &SemaReplSession, statements: [Stmt], source_segments: [SemaSourceSegment]) -> SemaReplStep {
    scope_mark :: sema_scope_mark(&session.scopes)
    context_mark :: sema_check_context_save(session.context)
    ownership_mark :: sema_ownership_state_snapshot(session.ownership)
    tail_mark :: session.tails.bodies.len()
    previous_segments :: session.environment.source_segments
    session.environment.source_segments = source_segments
    body := statements
    echo_binding := Binding?{None}
    if body.len() > 0 && body[body.len() - 1] == .Val(binding) {
        if binding.name == "__repl_echo__" {
            echo_binding = Val(binding)
            _ :: &body.pop()
        }
    }
    diagnostics := [Diagnostic]{}
    checked :: sema_check_statements(body, session.scopes.return_type, session.environment, &session.scopes, &session.ownership, &session.tails, &session.context, &diagnostics, 0)
    complete := checked.complete
    echo := TExpr?{None}
    if echo_binding == .Val(binding) {
        // A temporary binding checks the expression with the exact ordinary
        // binding rules, including ownership, taint and failure reconciliation.
        // Its generated name never enters the persistent session scope.
        _ :: sema_scope_enter(&session.scopes, &session.ownership, "repl-echo")
        value :: sema_check_statements([Stmt]{Stmt.Val{binding: binding}}, session.scopes.return_type, session.environment, &session.scopes, &session.ownership, &session.tails, &session.context, &diagnostics, 0)
        complete = complete && value.complete
        if value.value.len() == 1 && value.value[0] == .Let(_, _, init, _, _, _) -> echo = Val(init) else {
            complete = false
        }
        sema_scope_leave(&session.scopes, &session.ownership)
    }
    candidate := session.root
    loop statement in checked.value -> &candidate.body.push(statement)
    if echo == .Val(expression) {
        &candidate.body.push(TStmt.ExprStmt{value: expression, span: expression.span})
    }
    source := session.source
    loop statement in statements -> &source.body.push(statement)
    inputs := [SemaEffectModuleInput]{}
    if complete && !sema_has_error_since(diagnostics, 0) && session.environment.registration_graph == .Val(graph) {
        loop module_row in session.modules {
            index :: sema_registration_module_index(graph, module_row.module_identity) ?? next
            source_module :: graph.modules[index]
            functions := module_row.functions
            facts := module_row.call_facts
            sources := sema_comptime_effect_sources(source_module)
            segments := source_module.source_segments
            if module_row.module_identity == candidate.module_identity {
                loop position in 0..<functions.len() {
                    if functions[position].key == candidate.key -> functions[position] = candidate
                }
                loop position in 0..<sources.len() {
                    if sources[position].key == candidate.key {
                        sources[position] = sema_effect_source_from_function_key(source, candidate.module_identity, candidate.key)
                    }
                }
                loop fact in session.context.call_facts -> &facts.push(fact)
                segments = source_segments
            }
            &inputs.push(SemaEffectModuleInput{module_identity: module_row.module_identity, functions: ^functions, sources: ^sources, call_facts: ^facts, source_segments: segments, trait_bounds: sema_effect_trait_bounds(source_module.program.items)})
        }
        effects :: sema_effects_check_modules(^inputs)
        complete = complete && effects.complete
        loop diagnostic in effects.diagnostics -> &diagnostics.push(diagnostic)
        loop module_row in effects.modules {
            loop function in module_row.functions {
                if function.key == candidate.key -> candidate.effects = function.effects
            }
        }
    }
    sema_attach_diagnostic_source_locations(&diagnostics, 0, source_segments)
    complete = complete && !sema_has_error_since(diagnostics, 0)
    if !complete {
        reasons := [String]{}
        loop index in context_mark.incomplete_reasons..<session.context.incomplete_reasons.len() {
            &reasons.push(session.context.incomplete_reasons[index])
        }
        sema_scope_rollback(&session.scopes, scope_mark)
        sema_check_context_rollback(&session.context, context_mark)
        session.ownership = ownership_mark
        session.environment.source_segments = previous_segments
        loop session.tails.bodies.len() > tail_mark -> _ :: &session.tails.bodies.pop()
        return SemaReplStep{complete: false, root: session.root, statements: [TStmt]{}, echo: None, diagnostics: ^diagnostics, incomplete_reasons: ^reasons}
    }
    sema_scope_commit(&session.scopes, scope_mark)
    session.root = candidate
    session.source = source
    SemaReplStep{complete: true, root: candidate, statements: checked.value, echo: echo, diagnostics: ^diagnostics}
}

pub fn sema_repl_session_finalize(session: &SemaReplSession) -> [Diagnostic] {
    diagnostics := [Diagnostic]{}
    sema_ownership_finalize_references(&session.ownership, &diagnostics)
    sema_single_use_leave_scope(&session.scopes, &session.ownership, &diagnostics)
    sema_attach_diagnostic_source_locations(&diagnostics, 0, session.environment.source_segments)
    diagnostics
}
