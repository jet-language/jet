// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1383
struct LowerBlockResult { body: [TStmt] env: LowerEnv }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1388
enum LowerTask { Block(block: LowerBlock) Done(result: LowerBlockResult) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1393
struct LowerBlock {
    stmts: [Stmt]
    cx: Cx
    env: LowerEnv
    out: [TStmt]
    split_views: [USize:PlannedSplitView]
    index: USize
    markers: Bool
    resume: fn(LowerBlockResult) -> LowerTask
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1477
    fn new(stmts: [Stmt], cx: Cx, env: LowerEnv, markers: Bool, resume: fn(LowerBlockResult) -> LowerTask) -> LowerBlock Never! {
        split_views := if markers -> split_view_plan(stmts, cx, env) else -> [:]
        LowerBlock{stmts: stmts, cx: cx, out: [TStmt].with_capacity(stmts.len() * (if cx.debug_linemap -> 3 else -> 2)), env: env, split_views: split_views, index: 0, markers: markers, resume: resume}
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1501
    fn step(self: LowerBlock) -> LowerTask Never! {
        if self.index == self.stmts.len() -> return self.resume(LowerBlockResult{body: ^self.out, env: ^self.env})
        index := self.index
        if self.split_views.remove(index) == {
            Val(view) -> {
                stmt := self.stmts[index]
                if self.markers {
                    self.out.push(TStmt.SourceSpan(stmt.span()))
                    if self.cx.debug_linemap { self.out.push(TStmt.LineMarker(view.candidate.line)) }
                }
                candidate := view.candidate
                elem_ty := if tir_recv_jet_ty(candidate.owner, self.env) == { Val(.List(elem)) | Val(.FixedList(elem, _)) -> Val(elem); else -> None }
                slot := if candidate.single -> TLocal.user(candidate.name).through_ref() else -> TLocal.user(candidate.name)
                self.env.bind(candidate.name, slot, candidate.ty.clone())
                if elem_ty == {
                    Val(elem) -> {
                        handle := if candidate.write -> Val(Type.Apply{name: "ViewMut", args: [elem]}) else if !candidate.single -> Val(Type.Apply{name: "View", args: [elem]}) else -> None
                        if handle == { Val(h) -> self.env.mark_split_view(candidate.name, h); else -> {} }
                    }
                    else -> {}
                }
                self.out.push(TStmt.SplitViews{
                    owner: Val(lower_expr(candidate.owner, self.cx, &self.env)), root: view.root, len: view.len,
                    source: view.source, source_start: view.source_start, before: view.before, split_tail: view.split_tail,
                    segment: view.segment, after: view.after, name: candidate.name, start: candidate.start, end: candidate.end,
                    single: candidate.single, write: candidate.write, elem_ty: elem_ty, line: candidate.line
                })
                self.index += 1
                return LowerTask.Block(self)
            }
            else -> {}
        }
        stmt := self.stmts[index]
        if self.markers {
            self.out.push(TStmt.SourceSpan(stmt.span()))
            if self.cx.debug_linemap { self.out.push(TStmt.LineMarker(self.cx.src_line_col(stmt.span().start).0)) }
        }
        self.index += 1
        plan := lower_stmt_plan(stmt, self.cx, &self.env)
        if plan.bodies.is_empty() {
            lowered := plan.finish([])
            if lowered == {
                .Let{name: name, init: init, ..} -> {
                    if string_bytes_source(init) == {
                        Val(source) -> {
                            if string_bytes_binding_dead_after_next(self.stmts, self.index, name) {
                                if self.env.locals.get_mut(name) == { Val((slot, _)) -> slot = slot.clone().with_string_bytes_source(source); else -> {} }
                            }
                        }
                        else -> {}
                    }
                }
                else -> {}
            }
            self.out.push(lowered)
            return LowerTask.Block(self)
        }
        lower_body_chain(self, plan, [], None)
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1408
fn string_bytes_source(init: TExpr) -> TLocal? {
    if init.kind == {
        .OrFallback{value: value, fallback: fallback} -> {
            if fallback == { .Panic{..} -> {}; else -> return None }
            if value.kind == {
                .BuiltinMethod{recv: recv, op: .StringFromBytes, args: args} -> {
                    if !args.is_empty() -> return None
                    if recv.kind == { .Local(local) -> Val(local.clone()); else -> None }
                }
                else -> None
            }
        }
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1437
fn stable_loop_source_root(collection: Expr) -> String? {
    if collection == {
        .Ident(name, _) -> Val(name)
        .Copy(base, copy_span) -> { if copy_span == base.span() -> stable_loop_source_root(base) else -> None }
        .Field(base, _, _) | .Paren(base, _) -> stable_loop_source_root(base)
        else -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1449
fn source_stmt_uses_ident(stmt: Stmt, name: String) -> Bool Never! {
    used := false
    stmt.for_each_expr(fn(expr) { if expr == { .Ident(candidate, _) -> { if candidate == name { used = true } }; else -> {} } })
    if used -> return true
    if stmt == { .Assign{target: .Local{name: target, ..}, ..} -> target == name; else -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1468
fn string_bytes_binding_dead_after_next(stmts: [Stmt], next_index: USize, name: String) -> Bool Never! {
    stmts.get(next_index.saturating_add(1)..).unwrap_or_default().all(fn(stmt) { !source_stmt_uses_ident(stmt, name) })
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1608
fn lower_body_chain(parent: LowerBlock, plan: LowerStmtPlan, lowered: [[TStmt]], carried_env: LowerEnv?) -> LowerTask Never! {
    bodies := ^plan.bodies
    finish := ^plan.finish
    body := bodies.pop().expect("deferred statement plan has no body")
    child_env := if (body.inherit_env, carried_env) == { (true, Val(carried)) -> carried; else -> body.env.clone() }
    if body.prepare.take() == { Val(prepare) -> prepare(parent.cx, &child_env); else -> {} }
    next_carried := body.carry_env
    propagate_env := body.propagate_env
    LowerTask.Block(LowerBlock.new(body.stmts, parent.cx, child_env, body.markers, fn(result) {
        lowered.push(^result.body)
        next_env := if next_carried -> Val(result.env.clone()) else -> None
        if propagate_env { parent.env = ^result.env }
        if bodies.is_empty() {
            parent.out.push(finish(lowered))
            LowerTask.Block(parent)
        } else {
            lower_body_chain(parent, LowerStmtPlan{bodies: bodies, finish: finish}, lowered, next_env)
        }
    }))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1652
fn lower_stmts_with_markers(stmts: [Stmt], cx: Cx, env: &LowerEnv, markers: Bool) -> [TStmt] Never! {
    root_env := clone_env(env)
    task := LowerTask.Block(LowerBlock.new(stmts, cx, root_env, markers, fn(result) { LowerTask.Done(result) }))
    loop {
        task = if task == {
            .Block(block) -> block.step()
            .Done(result) -> { env = ^result.env; return ^result.body }
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1677
fn mark_resource_binding_mutability(stmt: &TStmt, targets: Set<String>) -> Void Never! {
    if &stmt == {
        .Let{name: name, kw: kw, ..} -> { if kw == "let" && targets.contains(mangle(name)) { kw = "let mut" } }
        .ContractScope{body: body, ..} | .TaskGroup{body: body, ..} | .Loop{body: body, ..}
        | .While{body: body, ..} | .Range{body: body, ..} | .ForIn{body: body, ..}
        | .Unsafe{body: body, ..} | .SentryPolicy{body: body, ..} | .Region(body) | .Impure(body)
        | .Live{body: body} | .Shield{body: body} | .ScopeMember{body: body, ..} | .Transact{body: body, ..}
