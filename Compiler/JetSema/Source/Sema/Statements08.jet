use JetCodegen.Codegen.Cx
use JetCodegen.Codegen.[mangle, mangle_generated]
use JetCodegen.Codegen.TIR.*
use JetCodegen.Codegen.TIR.Lower.*
use JetSema.Sema.Statements09.[lower_stmt_plan, split_view_plan, PlannedSplitView]
use JetSema.AST.[BindPattern, Expr, ForKind, IndexKind, LValue, OrFallback, Pattern, PlaceAccess, Stmt, Type, UnOp, CtValue, Lambda, LambdaBody, TypedLitBody, EnumLitArg, StrPart, union_enum_name, union_member_tag]
use JetSema.[Syntax, Sema]
use JetFoundation.CanonicalPass
use core.collections.Set
use std.cell.Cell
use std.rc.Rc
use std.sync.Arc

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:67
pub fn note_stack_sentry_in_tir(nodes: [TStmt], env: LowerEnv) -> Void Never! {
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:68
    fn walk_expr(node: TExpr) -> Bool Never! {
        if node.kind == {
            .CoreCall{record: record, args: args, ..} -> {
                address := record.module == "core.mem" && record.member == "address_of" && args.first().is_some_and(fn(arg) {
                    if tir_address_lifetime(arg) == { .Stack | .Unknown -> true; else -> false }
                })
                address || args.any(walk_expr)
            }
            .RawOf(inner) -> tir_address_lifetime(inner) == TAddressLifetime.Stack || walk_expr(inner)
            .InlineBlock(body) -> walk_stmts(body)
            .Call{args: args, ..} | .StaticCall{args: args, ..} | .ModuleCall{args: args, ..} | .ExternCall{args: args, ..} -> args.any(fn(arg) { walk_expr(arg.value) })
            .PtrFromAddr{addr: addr, ..} -> walk_expr(addr)
            .DistinctCtor{arg: arg, ..} | .RangeCheckedCtor{arg: arg, ..} | .DistinctConvert{arg: arg, ..}
            | .Print(arg) | .Drop(arg) | .Close(arg) | .ResourceNew(arg) | .Move(arg) | .Deref(arg)
            | .Clone(arg, _) | .ExplicitCopy(arg) | .MaterializeView(arg) | .DistinctRaw(arg)
            | .Present(arg) | .Ok(arg) | .Err(arg, _) | .OptField{base: arg, ..}
            | .PatternMatches{subj: arg, ..} | .NumericMethod{recv: arg, ..} -> walk_expr(arg)
            .AmbientInput{prompt: prompt} -> prompt.is_some_and(walk_expr)
            .Binary{lhs: lhs, rhs: rhs, ..} | .LayoutCompare{lhs: lhs, rhs: rhs, ..} | .OverflowOpt{lhs: lhs, rhs: rhs, ..}
            | .NumericBinaryMethod{recv: lhs, arg: rhs, ..} -> walk_expr(lhs) || walk_expr(rhs)
            .Unary{operand: operand, ..} | .LayoutLit{inner: operand} | .Borrow{place: operand, ..} -> walk_expr(operand)
            .CompareChain{operands: operands, ..} -> operands.any(walk_expr)
            .UnitConvert{arg: arg, rounding: rounding, ..} -> walk_expr(arg) || rounding.is_some_and(fn(pair) { walk_expr(pair.1) })
            .MathBuiltin{args: args, ..} | .PreciseBuiltin{args: args, ..} -> args.any(walk_expr)
            .StructLit{fields: fields, ..} -> fields.any(fn(field) { walk_expr(field.1) })
            .Field{recv: recv, ..} | .SharedGuardValue{guard: recv, ..} | .SharedGuardMap{guard: recv, ..}
            | .SharedGuardSplit{guard: recv, ..} | .MathSwizzleRead{recv: recv, ..}
            | .TaskGroupAll{tasks: recv} | .TaskGroupRace{tasks: recv} | .TaskGroupAny{tasks: recv} -> walk_expr(recv)
            .SharedGuardWait{guard: guard, condition: condition, ..} -> walk_expr(guard) || walk_expr(condition)
            .ConditionNotify{condition: condition, ..} -> walk_expr(condition)
            .ListLit(values) | .ColumnarListLit{elems: values, ..} -> values.any(walk_expr)
            .ListSpread{parts: parts} -> parts.any(fn(part) { if part == { .Elem(value) | .Spread(value) -> walk_expr(value) } })
            .ColumnarGather{base: base, index: index, ..} | .ColumnarColumnRead{base: base, index: index, ..}
            | .Index{base: base, index: index, ..} | .IndexHook{base: base, index: index, ..}
            | .MathLaneIndex{base: base, index: index, ..} -> walk_expr(base) || walk_expr(index)
            .PoolSlot{pool: pool, id: id, ..} -> walk_expr(pool) || walk_expr(id)
            .Slice{base: base, start: start, end: end, range: range, ..} -> walk_expr(base) || walk_expr(start) || walk_expr(end) || range.is_some_and(walk_expr)
            .MethodCall{recv: recv, args: args, ..} -> walk_expr(recv) || args.any(fn(arg) { walk_expr(arg.value) })
            .DecodeUnder{segment: segment, inner: inner} -> walk_expr(segment) || walk_expr(inner)
            .BuiltinMethod{recv: recv, args: args, ..} | .ClosureMethod{recv: recv, args: args, ..} | .HandleMethod{recv: recv, args: args, ..} -> walk_expr(recv) || args.any(walk_expr)
            .IfExpr{cond: cond, then_body: then_body, then_value: then_value, else_body: else_body, else_value: else_value} -> walk_cond(cond) || walk_stmts(then_body) || walk_expr(then_value) || walk_stmts(else_body) || walk_expr(else_value)
            .ResultHandler{subject: subject, ok_body: ok_body, ok_value: ok_value, err_body: err_body, err_value: err_value, terminal: terminal, ..} -> walk_expr(subject) || walk_stmts(ok_body) || walk_expr(ok_value) || walk_stmts(err_body) || walk_expr(err_value) || walk_expr(terminal)
            .Try{inner: inner, note: note, ..} -> walk_expr(inner) || note.is_some_and(walk_expr)
            .OrFallback{value: value, fallback: fallback} -> {
                walk_expr(value) || if fallback == {
                    .Value(v) | .Return(Val(v)) -> walk_expr(v)
                    .Panic{msg: msg, ..} -> walk_expr(msg)
                    else -> false
                }
            }
            .OptionLift2{f: f, a: a, b: b} -> walk_expr(f) || walk_expr(a) || walk_expr(b)
            .HostBorrowCallback{callable: callable, ..} -> walk_expr(callable)
            .SelectRecv{builder: builder, channel: channel} -> walk_expr(builder) || walk_expr(channel)
            .SelectAfter{builder: builder, duration: duration, value: value} -> walk_expr(builder) || walk_expr(duration) || value.is_some_and(walk_expr)
            .SelectWait{builder: builder, ..} -> walk_expr(builder)
            .TupleLit{fields: fields, ..} -> fields.any(fn(pair) { walk_expr(pair.1) })
            .MapLit(fields) -> fields.any(fn(pair) { walk_expr(pair.0) || walk_expr(pair.1) })
            .JSONLit{arg: arg, ..} | .DBValueLit{arg: arg, ..} -> arg.is_some_and(fn(pair) { walk_expr(pair.0) })
            else -> false
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:238
    fn walk_cond(condition: TIfCond) -> Bool Never! {
        if condition == {
            .Plain(value) | .IfLet{subj: value, ..} | .IsNone{subj: value} | .Matches{subj: value, ..} -> walk_expr(value)
            .And{left: left, right: right} -> walk_cond(left) || walk_cond(right)
            .WithPrelude{prelude: prelude, cond: cond} -> walk_stmts(prelude) || walk_cond(cond)
        }
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:249
    fn walk_contract(contract: TContract) -> Bool Never! { walk_expr(contract.condition) || walk_expr(contract.message) }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:253
    fn walk_place(place: TPlace) -> Bool Never! { if place == { .Local(_) -> false; .Expr(value) -> walk_expr(value) } }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:260
    fn walk_stmts(items: [TStmt]) -> Bool Never! {
        items.any(fn(stmt) {
            if stmt == {
                .Contract{contract: contract} -> walk_contract(contract)
                .ContractScope{pre: pre, body: body, post: post, ..} -> pre.any(walk_contract) || walk_stmts(body) || post.any(walk_contract)
                .Let{init: init, ..} | .TupleDestructure{init: init, ..} | .StructDestructure{init: init, ..} | .ListDestructure{init: init, ..} -> walk_expr(init)
                .RefutableBind{init: init, fallback: fallback, ..} -> walk_expr(init) || walk_stmts(fallback)
                .GcEdit{index_temp: index_temp, stmt: nested, ..} -> index_temp.is_some_and(fn(pair) { walk_expr(pair.1) }) || walk_stmts(std.slice.from_ref(nested))
                .SplitViews{owner: owner, ..} -> owner.is_some_and(walk_expr)
                .Assign{place: place, value: value, ..} -> walk_place(place) || walk_expr(value)
                .Return(value) -> value.is_some_and(walk_expr)
                .ExprStmt(value) -> walk_expr(value)
                .TaskGroup{limit: limit, body: body, ..} -> limit.is_some_and(walk_expr) || walk_stmts(body)
                .DeferClose{close: close, ..} -> walk_expr(close)
                .If{cond: cond, then_body: then_body, else_body: else_body, ..} -> walk_cond(cond) || walk_stmts(then_body) || else_body.is_some_and(walk_stmts)
                .Loop{body: body, ..} | .Inline(body) | .DebugOnly(body) | .Unsafe{body: body, ..}
                | .SentryPolicy{body: body, ..} | .Impure(body) | .Region(body) | .Live{body: body}
                | .Shield{body: body} | .ScopeMember{body: body, ..} | .Transact{body: body, ..} | .Layout{body: body, ..} -> walk_stmts(body)
                .While{cond: cond, body: body, ..} -> walk_expr(cond) || walk_stmts(body)
                .CountedLoop{init: init, cond: cond, step: step, body: body, ..} -> walk_stmts(std.slice.from_ref(init)) || walk_expr(cond) || step.is_some_and(fn(s) { walk_stmts(std.slice.from_ref(s)) }) || walk_stmts(body)
                .Range{source: source, start: start, end: end, step: step, body: body, ..} -> source.is_some_and(walk_expr) || walk_expr(start) || walk_expr(end) || step.is_some_and(walk_expr) || walk_stmts(body)
                .BreakValue{value: value, ..} -> walk_expr(value)
                .EnumMatch{scrutinee: scrutinee, arms: arms, else_body: else_body, ..} -> walk_expr(scrutinee) || arms.any(fn(arm) { walk_stmts(arm.body) }) || else_body.is_some_and(walk_stmts)
                .RangeSwitch{subject: subject, arms: arms, else_body: else_body} -> walk_expr(subject) || arms.any(fn(arm) { walk_stmts(arm.2) }) || walk_stmts(else_body)
                .IndexAssign{base: base, index: index, value: value, ..} | .IndexHookAssign{base: base, index: index, value: value, ..} -> walk_expr(base) || walk_expr(index) || walk_expr(value)
                .IndexFieldAssign(assign) -> walk_expr(assign.base) || walk_expr(assign.index) || walk_expr(assign.value)
                .MathSwizzleAssign{base: base, value: value, ..} -> walk_expr(base) || walk_expr(value)
                .ForIn{source: source, collection: collection, step: step, body: body, ..} -> walk_expr(source) || walk_expr(collection) || step.is_some_and(walk_expr) || walk_stmts(body)
                .MixedSwitch{subject: subject, arms: arms, else_body: else_body, ..} -> walk_expr(subject) || arms.any(fn(arm) { walk_expr(arm.0) || walk_stmts(arm.1) }) || else_body.is_some_and(walk_stmts)
                .ContextBlock{guards: guards, body: body} -> guards.any(fn(pair) { walk_expr(pair.1) }) || walk_stmts(body)
                .Reactive{..} | .Break(_) | .Continue(_) | .LineMarker(_) | .SourceSpan(_) | .Erased{..} | .InvariantViolation{..} -> false
            }
        })
    }
    if walk_stmts(nodes) { env.note_stack_address() }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:415
fn bake_comptime_value_with_type(value: CtValue, ty: Type, cx: Cx) -> CtValue Never! {
    if ty == {
        .Union(members) -> {
            enum_name := union_enum_name(members)
            if value == { .Enum(type_name, _, _) -> { if type_name == enum_name -> return value.clone() }; else -> {} }
            member :: members.find(fn(member) { value.jet_type() == member }) ?? return value.clone()
            CtValue.Enum{type_name: enum_name, variant: union_member_tag(member), args: [(None, bake_comptime_value_with_type(value, member, cx))]}
        }
        .Named(_) | .Apply(_, _) -> {
            if value == {
                .Struct(type_name, fields) -> {
                    typed_fields: [(String, CtValue)] := []
                    loop (field, field_value) in fields {
                        field_ty := struct_field_type(cx, ty, field).or_else(fn() { struct_field_type(cx, Type.Named(type_name.clone()), field) })
                        baked := field_ty.map(fn(t) { bake_comptime_value_with_type(field_value, t, cx) }).unwrap_or_else(fn() { field_value.clone() })
                        typed_fields.push((field.clone(), baked))
                    }
                    CtValue.Struct{type_name: type_name.clone(), fields: typed_fields}
                }
                else -> value.clone()
            }
        }
        else -> value.clone()
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:465
fn thread_callback_ident(expr: Expr) -> String? {
    cursor := expr
    loop { if cursor == { .Ident(name, _) -> return Val(name); .Paren(inner, _) -> cursor = inner; else -> return None } }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:476
fn thread_callback_lambda(expr: Expr) -> Lambda? {
    if expr == { .Lambda(lam) -> Val(lam); .Paren(inner, _) -> thread_callback_lambda(inner); else -> None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:484
fn thread_callback_lambda_captures(lam: Lambda) -> Set<String> Never! {
    if lam.body == { .Expr(body) -> Sema.block_free_var_reads([Stmt.Expr(body.clone())]); .Block(body) -> Sema.block_free_var_reads(body) }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:493
fn is_core_os_receiver(expr: Expr, cx: Cx) -> Bool Never! {
    cursor := expr
    loop {
        if cursor == {
            .Ident(alias, _) -> return cx.any_core_import_module(alias).is_some_and(fn(module) { module == "core.sys" })
            .Field(base, leaf, _) -> { if leaf != "os" -> return false; cursor = base }
            else -> return false
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:508
// Borrowed AST work items, not whole AST copies.
enum ThreadCallbackScanTask { Expr(expr: Expr) Stmts(stmts: [Stmt]) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:513
fn collect_thread_callback_names_expr(expr: Expr, cx: Cx, names: &Set<String>) -> Void Never! {
    collect_thread_callback_scan(ThreadCallbackScanTask.Expr(expr), cx, &names)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:517
fn collect_thread_callback_names(stmts: [Stmt], cx: Cx, names: &Set<String>) -> Void Never! {
    collect_thread_callback_scan(ThreadCallbackScanTask.Stmts(stmts), cx, &names)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:521
fn collect_thread_callback_scan(root: ThreadCallbackScanTask, cx: Cx, names: &Set<String>) -> Void Never! {
    work := TirWorklist<ThreadCallbackScanTask>.new()
    work.push(root)
    loop {
        task :: work.pop() ?? break
        if task == {
            .Expr(expr) -> {
                if expr == {
                    .MethodCall{receiver: receiver, method: method, args: args, ..} -> {
                        thread_callback := (method == "on_interrupt" && is_core_os_receiver(receiver, cx)) || method == "with_event_time" || method == "key_by"
                        if thread_callback {
                            if args.first() == {
                                Val(arg) -> {
                                    if thread_callback_ident(arg.expr) == { Val(name) -> names.insert(name.to_string()); else -> {} }
                                    if thread_callback_lambda(arg.expr) == { Val(lam) -> names.extend(thread_callback_lambda_captures(lam)); else -> {} }
                                }
                                else -> {}
                            }
                        }
                        loop arg in args.rev() { work.push(ThreadCallbackScanTask.Expr(arg.expr)) }
                        work.push(ThreadCallbackScanTask.Expr(receiver))
                    }
                    .Call(call) -> { loop arg in call.args.rev() { work.push(ThreadCallbackScanTask.Expr(arg.expr)) } }
                    .CallValue{callee: callee, args: args, ..} -> {
                        loop arg in args.rev() { work.push(ThreadCallbackScanTask.Expr(arg.expr)) }
                        work.push(ThreadCallbackScanTask.Expr(callee))
                    }
                    .Lambda(lam) -> {
                        if lam.meta.collecting_loop || lam.meta.result_loop {
                            if lam.body == { .Expr(body) -> work.push(ThreadCallbackScanTask.Expr(body)); .Block(body) -> work.push(ThreadCallbackScanTask.Stmts(body)) }
                        }
                    }
                    .Paren(inner, _) | .Unary(_, inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _)
                    | .Place(inner, _, _) | .Tainted(inner, _, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Spread(inner, _) -> work.push(ThreadCallbackScanTask.Expr(inner))
                    .Try(inner, _, _, note) -> {
                        work.push(ThreadCallbackScanTask.Expr(inner))
                        if note == { Val(n) -> work.push(ThreadCallbackScanTask.Expr(n)); else -> {} }
                    }
                    .Binary(_, left, right, _) -> { work.push(ThreadCallbackScanTask.Expr(right)); work.push(ThreadCallbackScanTask.Expr(left)) }
                    .CompareChain{operands: operands, ..} -> { loop operand in operands.rev() { work.push(ThreadCallbackScanTask.Expr(operand)) } }
                    .ListLit(items, _) -> { loop item in items.rev() { work.push(ThreadCallbackScanTask.Expr(item)) } }
                    .MemberSpread{base: base, ..} -> work.push(ThreadCallbackScanTask.Expr(base))
                    .MapLit(entries, _) -> { loop (key, value) in entries.rev() { work.push(ThreadCallbackScanTask.Expr(value)); work.push(ThreadCallbackScanTask.Expr(key)) } }
                    .Index{base: base, index: index, ..} -> { work.push(ThreadCallbackScanTask.Expr(index)); work.push(ThreadCallbackScanTask.Expr(base)) }
                    .Slice{base: base, start: start, end: end, range: range, ..} -> {
                        if range == { Val(r) -> work.push(ThreadCallbackScanTask.Expr(r)); else -> {} }
                        work.push(ThreadCallbackScanTask.Expr(end)); work.push(ThreadCallbackScanTask.Expr(start)); work.push(ThreadCallbackScanTask.Expr(base))
                    }
                    .Range{start: start, end: end, ..} -> { work.push(ThreadCallbackScanTask.Expr(end)); work.push(ThreadCallbackScanTask.Expr(start)) }
                    .Field(base, _, _) | .OptField{base: base, ..} -> work.push(ThreadCallbackScanTask.Expr(base))
                    .StructLit{fields: fields, ..} -> { loop (_, _, value) in fields.rev() { work.push(ThreadCallbackScanTask.Expr(value)) } }
                    .TypedLit{body: body, ..} -> {
                        if body == {
                            .Fields(fields) -> { loop (_, _, value) in fields.rev() { work.push(ThreadCallbackScanTask.Expr(value)) } }
                            .Elements(elements) -> { loop value in elements.rev() { work.push(ThreadCallbackScanTask.Expr(value)) } }
                            .Entries(entries) -> { loop (key, value) in entries.rev() { work.push(ThreadCallbackScanTask.Expr(value)); work.push(ThreadCallbackScanTask.Expr(key)) } }
                            .Value(value) -> work.push(ThreadCallbackScanTask.Expr(value))
                            .ByteText(_) | .Empty -> {}
                        }
                    }
                    .EnumLit{args: args, ..} -> {
                        loop arg in args.rev() {
                            value := if arg == { .Positional(value) | .Named{expr: value, ..} -> value }
                            work.push(ThreadCallbackScanTask.Expr(value))
                        }
                    }
                    .Str(parts, _) -> { loop part in parts.rev() { if part == { .Interp(value, _) -> work.push(ThreadCallbackScanTask.Expr(value)); else -> {} } } }
                    .PatternTest{subject: subject, ..} -> work.push(ThreadCallbackScanTask.Expr(subject))
                    .If{cond: cond, then_body: then_body, then_value: then_value, else_body: else_body, else_value: else_value, ..} -> {
                        work.push(ThreadCallbackScanTask.Expr(else_value)); work.push(ThreadCallbackScanTask.Stmts(else_body))
                        work.push(ThreadCallbackScanTask.Expr(then_value)); work.push(ThreadCallbackScanTask.Stmts(then_body)); work.push(ThreadCallbackScanTask.Expr(cond))
                    }
                    .TupleLit(fields, _, _) -> { loop (_, value) in fields.rev() { work.push(ThreadCallbackScanTask.Expr(value)) } }
                    .PtrFromAddr{addr: addr, ..} -> work.push(ThreadCallbackScanTask.Expr(addr))
                    .OrFallback{value: value, ..} -> work.push(ThreadCallbackScanTask.Expr(value))
                    else -> {}
                }
            }
            .Stmts(stmts) -> {
                loop stmt in stmts.rev() {
                    if stmt == {
                        .Expr(expr) | .DeferClose{close: expr, ..} -> work.push(ThreadCallbackScanTask.Expr(expr))
                        .Val(binding) -> work.push(ThreadCallbackScanTask.Expr(binding.init))
                        .Assign{value: value, ..} -> work.push(ThreadCallbackScanTask.Expr(value))
                        .Return(Val(value), _) | .Yield(value, _) -> work.push(ThreadCallbackScanTask.Expr(value))
                        .While{cond: cond, body: body, ..} -> { work.push(ThreadCallbackScanTask.Stmts(body)); work.push(ThreadCallbackScanTask.Expr(cond)) }
                        .For{kind: kind, body: body, ..} -> {
                            work.push(ThreadCallbackScanTask.Stmts(body))
                            if kind == {
                                .In{collection: collection, step: step} -> { if step == { Val(s) -> work.push(ThreadCallbackScanTask.Expr(s)); else -> {} }; work.push(ThreadCallbackScanTask.Expr(collection)) }
                                else -> {}
                            }
                        }
                        .Switch{subject: subject, arms: arms, else_body: else_body, ..} -> {
                            if else_body == { Val(body) -> work.push(ThreadCallbackScanTask.Stmts(body)); else -> {} }
                            loop arm in arms.rev() { work.push(ThreadCallbackScanTask.Stmts(arm.body)); work.push(ThreadCallbackScanTask.Expr(arm.cond)) }
                            work.push(ThreadCallbackScanTask.Expr(subject))
                        }
                        .Loop{body: body, ..} | .Unsafe{body: body, ..} | .Impure{body: body, ..} | .Reactive{body: body, ..}
                        | .Shield{body: body, ..} | .Switched{body: body, ..} | .Region{body: body, ..} | .Policy{body: body, ..}
                        | .TaskGroup{body: body, ..} | .Layout{body: body, ..} | .AuthorityScope{body: body, ..}
                        | .ContextBlock{body: body, ..} | .Live{body: body, ..} | .AssumeDet{body: body, ..}
                        | .Transact{body: body, ..} | .ComptimeBlock{body: body, ..} -> work.push(ThreadCallbackScanTask.Stmts(body))
                        .CountedLoop{init: init, cond: cond, step: step, body: body, ..} -> {
                            work.push(ThreadCallbackScanTask.Stmts(body))
                            if step == { Val(s) -> work.push(ThreadCallbackScanTask.Stmts(std.slice.from_ref(s))); else -> {} }
                            work.push(ThreadCallbackScanTask.Expr(cond)); work.push(ThreadCallbackScanTask.Expr(init.init))
                        }
                        .ComptimeIf{cond: cond, then_body: then_body, else_body: else_body, ..} -> {
                            if else_body == { Val(body) -> work.push(ThreadCallbackScanTask.Stmts(body)); else -> {} }
                            work.push(ThreadCallbackScanTask.Stmts(then_body)); work.push(ThreadCallbackScanTask.Expr(cond))
                        }
                        .ScopeMember{args: args, body: body, ..} -> { work.push(ThreadCallbackScanTask.Stmts(body)); loop arg in args.rev() { work.push(ThreadCallbackScanTask.Expr(arg)) } }
                        .ComptimeSwitch{subject: subject, arms: arms, else_body: else_body, ..} -> {
                            if else_body == { Val(body) -> work.push(ThreadCallbackScanTask.Stmts(body)); else -> {} }
                            loop arm in arms.rev() { work.push(ThreadCallbackScanTask.Stmts(arm.body)) }
                            work.push(ThreadCallbackScanTask.Expr(subject))
                        }
                        else -> {}
                    }
                }
            }
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:838
fn collect_thread_aliases_expr(expr: Expr, aliases: &[(String, String)]) -> Void Never! {
    if expr == {
        .Lambda(lambda) -> { if lambda.body == { .Expr(body) -> collect_thread_aliases_expr(body, &aliases); .Block(body) -> collect_thread_aliases(body, &aliases) } }
        .MethodCall{receiver: receiver, args: args, ..} -> { collect_thread_aliases_expr(receiver, &aliases); loop arg in args { collect_thread_aliases_expr(arg.expr, &aliases) } }
        .Call(call) -> { loop arg in call.args { collect_thread_aliases_expr(arg.expr, &aliases) } }
        .CallValue{callee: callee, args: args, ..} -> { collect_thread_aliases_expr(callee, &aliases); loop arg in args { collect_thread_aliases_expr(arg.expr, &aliases) } }
        .If{cond: cond, then_body: then_body, then_value: then_value, else_body: else_body, else_value: else_value, ..} -> {
            collect_thread_aliases_expr(cond, &aliases); collect_thread_aliases(then_body, &aliases); collect_thread_aliases_expr(then_value, &aliases)
            collect_thread_aliases(else_body, &aliases); collect_thread_aliases_expr(else_value, &aliases)
        }
        .Paren(inner, _) | .Unary(_, inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _)
        | .Place(inner, _, _) | .Tainted(inner, _, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Spread(inner, _) -> collect_thread_aliases_expr(inner, &aliases)
        .Try(inner, _, _, note) -> { collect_thread_aliases_expr(inner, &aliases); if note == { Val(n) -> collect_thread_aliases_expr(n, &aliases); else -> {} } }
        else -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:896
fn collect_thread_aliases(stmts: [Stmt], aliases: &[(String, String)]) -> Void Never! {
    work := TirWorklist<[Stmt]>.new()
    work.push(stmts)
    loop {
        items :: work.pop() ?? break
        loop stmt in items {
            if stmt == {
                .Val(binding) -> {
                    if thread_callback_ident(binding.init) == { Val(source) -> aliases.push((binding.name.clone(), source.to_string())); else -> {} }
                    collect_thread_aliases_expr(binding.init, &aliases)
                }
                .CountedLoop{init: init, step: step, body: body, ..} -> {
                    if thread_callback_ident(init.init) == { Val(source) -> aliases.push((init.name.clone(), source.to_string())); else -> {} }
                    collect_thread_aliases_expr(init.init, &aliases)
                    if step == {
                        Val(.Assign{target: target, value: value, ..}) -> {
                            if target == { .Local{name: name, ..} -> { if thread_callback_ident(value) == { Val(source) -> aliases.push((name.clone(), source.to_string())); else -> {} } }; else -> {} }
                            collect_thread_aliases_expr(value, &aliases)
                        }
                        else -> {}
                    }
                    work.push(body)
                }
                .While{body: body, ..} | .For{body: body, ..} | .Loop{body: body, ..} | .Unsafe{body: body, ..}
                | .Impure{body: body, ..} | .Reactive{body: body, ..} | .Shield{body: body, ..} | .Switched{body: body, ..}
                | .Region{body: body, ..} | .Policy{body: body, ..} | .TaskGroup{body: body, ..} | .Layout{body: body, ..}
                | .AuthorityScope{body: body, ..} | .ContextBlock{body: body, ..} | .Live{body: body, ..}
                | .AssumeDet{body: body, ..} | .Transact{body: body, ..} | .ComptimeBlock{body: body, ..} | .ScopeMember{body: body, ..} -> work.push(body)
                .Switch{arms: arms, else_body: else_body, ..} | .ComptimeSwitch{arms: arms, else_body: else_body, ..} -> {
                    loop arm in arms { work.push(arm.body) }
                    if else_body == { Val(body) -> work.push(body); else -> {} }
                }
                .ComptimeIf{then_body: then_body, else_body: else_body, ..} -> { work.push(then_body); if else_body == { Val(body) -> work.push(body); else -> {} } }
                .Expr(expr) | .DeferClose{close: expr, ..} -> collect_thread_aliases_expr(expr, &aliases)
                .Assign{target: target, value: value, ..} -> {
                    if target == { .Local{name: name, ..} -> { if thread_callback_ident(value) == { Val(source) -> aliases.push((name.clone(), source.to_string())); else -> {} } }; else -> {} }
                    collect_thread_aliases_expr(value, &aliases)
                }
                .Return(Val(value), _) | .Yield(value, _) -> collect_thread_aliases_expr(value, &aliases)
                else -> {}
            }
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:995
fn collect_thread_lambda_captures_expr(expr: Expr, captures: &[(String, String)]) -> Void Never! {
    if expr == {
        .Lambda(lambda) -> { if lambda.body == { .Expr(body) -> collect_thread_lambda_captures_expr(body, &captures); .Block(body) -> collect_thread_lambda_captures(body, &captures) } }
        .MethodCall{receiver: receiver, args: args, ..} -> { collect_thread_lambda_captures_expr(receiver, &captures); loop arg in args { collect_thread_lambda_captures_expr(arg.expr, &captures) } }
        .Call(call) -> { loop arg in call.args { collect_thread_lambda_captures_expr(arg.expr, &captures) } }
        .CallValue{callee: callee, args: args, ..} -> { collect_thread_lambda_captures_expr(callee, &captures); loop arg in args { collect_thread_lambda_captures_expr(arg.expr, &captures) } }
        .If{cond: cond, then_body: then_body, then_value: then_value, else_body: else_body, else_value: else_value, ..} -> {
            collect_thread_lambda_captures_expr(cond, &captures); collect_thread_lambda_captures(then_body, &captures); collect_thread_lambda_captures_expr(then_value, &captures)
            collect_thread_lambda_captures(else_body, &captures); collect_thread_lambda_captures_expr(else_value, &captures)
        }
        .Paren(inner, _) | .Unary(_, inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _)
        | .Place(inner, _, _) | .Tainted(inner, _, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Spread(inner, _) -> collect_thread_lambda_captures_expr(inner, &captures)
        .Try(inner, _, _, note) -> { collect_thread_lambda_captures_expr(inner, &captures); if note == { Val(n) -> collect_thread_lambda_captures_expr(n, &captures); else -> {} } }
        else -> {}
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1057
fn collect_thread_lambda_captures(stmts: [Stmt], captures: &[(String, String)]) -> Void Never! {
    loop stmt in stmts {
        if stmt == {
            .Val(binding) -> {
                if thread_callback_lambda(binding.init) == { Val(lam) -> { loop capture in thread_callback_lambda_captures(lam) { captures.push((binding.name.clone(), capture)) } }; else -> {} }
                collect_thread_lambda_captures_expr(binding.init, &captures)
            }
            .Expr(expr) | .DeferClose{close: expr, ..} -> collect_thread_lambda_captures_expr(expr, &captures)
            .Assign{target: target, value: value, ..} -> {
                if target == {
                    .Local{name: name, ..} -> { if thread_callback_lambda(value) == { Val(lam) -> { loop capture in thread_callback_lambda_captures(lam) { captures.push((name.clone(), capture)) } }; else -> {} } }
                    else -> {}
                }
                collect_thread_lambda_captures_expr(value, &captures)
            }
            .Return(Val(value), _) | .Yield(value, _) -> collect_thread_lambda_captures_expr(value, &captures)
            .CountedLoop{init: init, step: step, body: body, ..} -> {
                if thread_callback_lambda(init.init) == { Val(lam) -> { loop capture in thread_callback_lambda_captures(lam) { captures.push((init.name.clone(), capture)) } }; else -> {} }
                collect_thread_lambda_captures_expr(init.init, &captures)
                if step == {
                    Val(.Assign{target: target, value: value, ..}) -> {
                        if target == {
                            .Local{name: name, ..} -> { if thread_callback_lambda(value) == { Val(lam) -> { loop capture in thread_callback_lambda_captures(lam) { captures.push((name.clone(), capture)) } }; else -> {} } }
                            else -> {}
                        }
                        collect_thread_lambda_captures_expr(value, &captures)
                    }
                    else -> {}
                }
                collect_thread_lambda_captures(body, &captures)
            }
            .While{body: body, ..} | .For{body: body, ..} | .Loop{body: body, ..} | .Unsafe{body: body, ..}
            | .Impure{body: body, ..} | .Reactive{body: body, ..} | .Shield{body: body, ..} | .Switched{body: body, ..}
            | .Region{body: body, ..} | .Policy{body: body, ..} | .TaskGroup{body: body, ..} | .Layout{body: body, ..}
            | .AuthorityScope{body: body, ..} | .ContextBlock{body: body, ..} | .Live{body: body, ..}
            | .AssumeDet{body: body, ..} | .Transact{body: body, ..} | .ComptimeBlock{body: body, ..} | .ScopeMember{body: body, ..} -> collect_thread_lambda_captures(body, &captures)
            .Switch{arms: arms, else_body: else_body, ..} | .ComptimeSwitch{arms: arms, else_body: else_body, ..} -> {
                loop arm in arms { collect_thread_lambda_captures(arm.body, &captures) }
                if else_body == { Val(body) -> collect_thread_lambda_captures(body, &captures); else -> {} }
            }
            .ComptimeIf{then_body: then_body, else_body: else_body, ..} -> {
                collect_thread_lambda_captures(then_body, &captures)
                if else_body == { Val(body) -> collect_thread_lambda_captures(body, &captures); else -> {} }
            }
            else -> {}
        }
    }
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1161
pub fn prepare_interrupt_callback_locals(stmts: [Stmt], cx: Cx, env: &LowerEnv) -> Void Never! { prepare_thread_callback_locals(stmts, cx, &env) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1165
pub fn prepare_interrupt_callback_local_expr(expr: Expr, cx: Cx, env: &LowerEnv) -> Void Never! { prepare_thread_callback_local_expr(expr, cx, &env) }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1169
pub fn prepare_thread_callback_locals(stmts: [Stmt], cx: Cx, env: &LowerEnv) -> Void Never! {
    names := Set<String>.new()
    collect_thread_callback_names(stmts, cx, &names)
    send := names
    aliases: [(String, String)] := []
    collect_thread_aliases(stmts, &aliases)
    lambda_captures: [(String, String)] := []
    collect_thread_lambda_captures(stmts, &lambda_captures)
    loop {
        before := send.len()
        loop (target, source) in aliases {
            if send.contains(target) { send.insert(source.clone()) }
            if send.contains(source) { send.insert(target.clone()) }
        }
        loop (target, source) in lambda_captures { if send.contains(target) { send.insert(source.clone()) } }
        if send.len() == before -> break
    }
    loop name in send { env.mark_send_fn(name) }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1201
pub fn prepare_thread_callback_local_expr(expr: Expr, cx: Cx, env: &LowerEnv) -> Void Never! {
    names := Set<String>.new()
    collect_thread_callback_names_expr(expr, cx, &names)
    aliases: [(String, String)] := []
    collect_thread_aliases_expr(expr, &aliases)
    lambda_captures: [(String, String)] := []
    collect_thread_lambda_captures_expr(expr, &lambda_captures)
    loop {
        before := names.len()
        loop (target, source) in aliases {
            if names.contains(target) { names.insert(source.clone()) }
            if names.contains(source) { names.insert(target.clone()) }
        }
        loop (target, source) in lambda_captures { if names.contains(target) { names.insert(source.clone()) } }
        if names.len() == before -> break
    }
    loop name in names { env.mark_send_fn(name) }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1232
pub fn force_thread_callback_value(init: TExpr, cx: Cx) -> TExpr Never! {
    if init.kind == { .FnValue{kind: .Send{..}} -> return init; else -> {} }
    if &init.kind == {
        .Lambda(lam) -> {
            lam.arc = true
            lam.rc = false
            moved := lam.capture_facts.moved.clone()
            loop (source, _, _) in lam.captures { if !moved.contains(source) { lam.capture_facts.cloned.insert(source.clone()) } }
        }
        .FnValue{kind: .NamedFn{name: Val(name), ..}} -> init.kind = TExprKind.FnValue{kind: TFnValueKind.NamedFn{name: Val(name.clone()), lambda: None}}
        else -> {}
    }
    TExpr{ty: init.ty.clone(), kind: TExprKind.FnValue{kind: TFnValueKind.Send{value: init}}}
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1276
