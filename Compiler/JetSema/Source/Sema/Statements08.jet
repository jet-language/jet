    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1299
    pub fn direct(stmts: [Stmt], env: LowerEnv) -> LowerBody Never! { LowerBody{stmts: stmts, env: env, markers: false, inherit_env: false, carry_env: false, propagate_env: false, prepare: None} }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1311
    pub fn inline(stmts: [Stmt], env: LowerEnv) -> LowerBody Never! { LowerBody{stmts: stmts, env: env, markers: true, inherit_env: false, carry_env: false, propagate_env: true, prepare: None} }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1323
    pub fn inherited(stmts: [Stmt], env: LowerEnv) -> LowerBody Never! { LowerBody{stmts: stmts, env: env, markers: true, inherit_env: true, carry_env: false, propagate_env: false, prepare: None} }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1335
    pub fn prepare(self: LowerBody, prepare: fn(Cx, &LowerEnv) -> Void) -> LowerBody Never! { self.prepare = Val(prepare); self }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1340
    pub fn carry_env(self: LowerBody) -> LowerBody Never! { self.carry_env = true; self }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1346
pub struct LowerStmtPlan {
    bodies: [LowerBody]
    finish: fn([[TStmt]]) -> TStmt
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1352
    pub fn ready(stmt: TStmt) -> LowerStmtPlan Never! { LowerStmtPlan{bodies: [], finish: fn(_) { stmt }} }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1361
    pub fn map_stmt(self: LowerStmtPlan, map: fn(TStmt) -> TStmt) -> LowerStmtPlan Never! {
