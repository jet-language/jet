// Reactive synchronization facts from accepted concurrency boundaries.
// Reports are stable source metadata; reactive handles already own the
// synchronized runtime representation.
use jet_foundation.[
    Binding,
    Expr,
    MARKER_LOCAL,
    MARKER_SHARED,
    Symbol,
    SymbolID,
    Type,
    type_name,
]

sema_function_reactive_handle_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, _) -> name == "Signal" || name == "Derived" || name == "Computed"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_function_reactive_contains: fn(values: [String], value: String) -> Bool Never! {
    loop existing in values { if existing == value -> return true }
    false
}

sema_function_reactive_append_unique: fn(values: &[SymbolID], value: SymbolID) Never! {
    if !values.contains(value) -> values.push(value.copy())
}

sema_function_reactive_is_local: fn(context: SemaCheckContext, symbol: SymbolID) -> Bool Never! {
    context.reactive_local_ids.contains(symbol)
}

sema_function_reactive_is_shared: fn(context: SemaCheckContext, symbol: SymbolID) -> Bool Never! {
    context.reactive_shared_ids.contains(symbol)
}

sema_function_reactive_note_upgrade: fn(context: &SemaCheckContext, name: String, ty: Type, crossing: String) Never! {
    if !sema_function_reactive_contains(context.reactive_upgrade_names, name) -> context.reactive_upgrade_names.push(name.copy())
    line := "{name}: {type_name(ty)} synchronized for {crossing} crossing"
    if !sema_function_reactive_contains(context.reactive_upgrades, line) -> context.reactive_upgrades.push(line)
}

sema_function_reactive_note_channel: fn(context: &SemaCheckContext, value: Expr, ty: Type) Never! {
    if !sema_function_reactive_handle_type(ty) -> return
    name := if value == {
        .Ident(name, _, _) -> name
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> "this value"
    }
    sema_function_reactive_note_upgrade(context, name, ty, "channel")
}

sema_function_reactive_record_binding: fn(context: &SemaCheckContext, binding: Binding, symbol: Symbol, ty: Type) Never! {
    is_local := false
    is_shared := false
    loop marker in binding.markers {
        if marker.name == MARKER_LOCAL -> is_local = true
        if marker.name == MARKER_SHARED -> is_shared = true
    }
    if is_local -> sema_function_reactive_append_unique(context.reactive_local_ids, symbol.id)
    if is_shared -> sema_function_reactive_append_unique(context.reactive_shared_ids, symbol.id)
    if is_shared && sema_function_reactive_handle_type(ty) -> sema_function_reactive_note_upgrade(context, binding.name, ty, "#Shared pin")
}

sema_function_reactive_note_parallel_lambda: fn(context: &SemaCheckContext, lambda: TLambda) Never! {
    loop capture in lambda.captures {
        if sema_function_reactive_contains(lambda.capture_facts.mutable, capture.source) -> next
        if !sema_function_reactive_handle_type(capture.ty) -> next
        symbol: capture.local.symbol_id ?? next
        if sema_function_reactive_is_local(context, symbol) -> next
        sema_function_reactive_note_upgrade(context, capture.source, capture.ty, "parallel")
    }
}

sema_function_reactive_note_task_lambda: fn(context: &SemaCheckContext, lambda: TLambda) Never! {
    loop capture in lambda.captures {
        if !sema_function_reactive_handle_type(capture.ty) -> next
        symbol: capture.local.symbol_id ?? next
        if sema_function_reactive_is_local(context, symbol) -> next
        crossing := "task"
        if sema_function_reactive_is_shared(context, symbol) -> crossing = "#Shared pin + task"
        sema_function_reactive_note_upgrade(context, capture.source, capture.ty, crossing)
    }
}
