// Reactive synchronization facts from accepted concurrency boundaries.
// Reports are stable source metadata; reactive handles already own the
// synchronized runtime representation.

pub fn sema_function_reactive_handle_type(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, _) -> name == "Signal" || name == "Derived" || name == "Computed"
        else -> false
    }
}

fn sema_function_reactive_contains(values: [String], value: String) -> Bool Never! {
    loop existing in values { if existing == value -> return true }
    false
}

fn sema_function_reactive_append_unique(values: &[String], value: String) Never! {
    if !sema_function_reactive_contains(values, value) -> &values.push(value)
}

pub fn sema_function_reactive_is_local(context: SemaCheckContext, symbol_key: String) -> Bool Never! {
    sema_function_reactive_contains(context.reactive_local_keys, symbol_key)
}

pub fn sema_function_reactive_is_shared(context: SemaCheckContext, symbol_key: String) -> Bool Never! {
    sema_function_reactive_contains(context.reactive_shared_keys, symbol_key)
}

pub fn sema_function_reactive_note_upgrade(context: &SemaCheckContext, name: String, ty: Type, crossing: String) Never! {
    sema_function_reactive_append_unique(&context.reactive_upgrade_names, name)
    line := "{name}: {type_name(ty)} synchronized for {crossing} crossing"
    if !sema_function_reactive_contains(context.reactive_upgrades, line) -> &context.reactive_upgrades.push(line)
}

pub fn sema_function_reactive_note_channel(context: &SemaCheckContext, value: Expr, ty: Type) Never! {
    if !sema_function_reactive_handle_type(ty) -> return
    name := if value == {.Ident(name, _) -> name else -> "this value"}
    sema_function_reactive_note_upgrade(&context, name, ty, "channel")
}

pub fn sema_function_reactive_record_binding(context: &SemaCheckContext, binding: Binding, symbol: Symbol, ty: Type) Never! {
    is_local := false
    is_shared := false
    loop marker in binding.markers {
        if marker.name == "Local" -> is_local = true
        if marker.name == "Shared" -> is_shared = true
    }
    if is_local -> sema_function_reactive_append_unique(&context.reactive_local_keys, symbol.id.key)
    if is_shared -> sema_function_reactive_append_unique(&context.reactive_shared_keys, symbol.id.key)
    if is_shared && sema_function_reactive_handle_type(ty) -> sema_function_reactive_note_upgrade(&context, binding.name, ty, "#Shared pin")
}

pub fn sema_function_reactive_note_parallel_lambda(context: &SemaCheckContext, lambda: TLambda) Never! {
    loop capture in lambda.captures {
        if sema_function_reactive_contains(lambda.capture_facts.mutable, capture.source) -> next
        if !sema_function_reactive_handle_type(capture.ty) -> next
        symbol :: capture.local.symbol_id ?? next
        if sema_function_reactive_is_local(context, symbol.key) -> next
        sema_function_reactive_note_upgrade(&context, capture.source, capture.ty, "parallel")
    }
}

pub fn sema_function_reactive_note_task_lambda(context: &SemaCheckContext, lambda: TLambda) Never! {
    loop capture in lambda.captures {
        if !sema_function_reactive_handle_type(capture.ty) -> next
        symbol :: capture.local.symbol_id ?? next
        if sema_function_reactive_is_local(context, symbol.key) -> next
        crossing := "task"
        if sema_function_reactive_is_shared(context, symbol.key) -> crossing = "#Shared pin + task"
        sema_function_reactive_note_upgrade(&context, capture.source, capture.ty, crossing)
    }
}

pub fn sema_function_reactive_apply_upgrade_flags(statements: &[Stmt], names: [String]) Never! {
    index := 0
    loop index < statements.len() {
        statement := statements[index]
        if statement == {
            .Val(binding) -> {
                if sema_function_reactive_contains(names, binding.name) || sema_function_reactive_binding_shared(binding) {
                    binding.reactive_upgrade = true
                    statements[index] = Stmt.Val{binding: binding}
                }
            }
            .While(condition, body, span, arrow_body, label) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.While{cond: condition, body: body, span: span, arrow_body: arrow_body, label: label}
            }
            .For(variable, variable_span, variable_two, kind, body, span, arrow_body, label, vectorization) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.For{var: variable, var_span: variable_span, var2: variable_two, kind: kind, body: body, span: span, arrow_body: arrow_body, label: label, auto_vectorization: vectorization}
            }
            .Loop(body, span, arrow_body, label) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.Loop{body: body, span: span, arrow_body: arrow_body, label: label}
            }
            .CountedLoop(init, condition, step, body, span, arrow_body, label) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.CountedLoop{init: init, cond: condition, step: step, body: body, span: span, arrow_body: arrow_body, label: label}
            }
            .Unsafe(audit, audit_expr, body, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.Unsafe{audit: audit, audit_expr: audit_expr, body: body, span: span}
            }
            .Impure(reason, reason_expr, body, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.Impure{reason: reason, reason_expr: reason_expr, body: body, span: span}
            }
            .Reactive(body, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.Reactive{body: body, span: span}
            }
            .Shield(body, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.Shield{body: body, span: span}
            }
            .Switched(marker, body, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.Switched{marker: marker, body: body, span: span}
            }
            .Region(name, name_span, body, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.Region{name: name, name_span: name_span, body: body, span: span}
            }
            .Policy(declarations, body, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.Policy{declarations: declarations, body: body, span: span}
            }
            .TaskGroup(name, name_span, limit, body, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.TaskGroup{name: name, name_span: name_span, limit: limit, body: body, span: span}
            }
            .AuthorityScope(caps, caps_span, binding, body, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.AuthorityScope{caps: caps, caps_span: caps_span, binding: binding, body: body, span: span}
            }
            .ComptimeBlock(body, is_template_loop, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.ComptimeBlock{body: body, is_template_loop: is_template_loop, span: span}
            }
            .ContextBlock(fields, body, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.ContextBlock{fields: fields, body: body, span: span}
            }
            .Live(body, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.Live{body: body, span: span}
            }
            .AssumeDet(reason, reason_expr, body, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.AssumeDet{reason: reason, reason_expr: reason_expr, body: body, span: span}
            }
            .Transact(name, name_span, body, implicit, span) -> {
                sema_function_reactive_apply_upgrade_flags(&body, names)
                statements[index] = Stmt.Transact{name: name, name_span: name_span, body: body, implicit: implicit, span: span}
            }
            .Switch(subject, arms, else_body, span) | .ComptimeSwitch(subject, arms, else_body, span) -> {
                loop arm_index in 0..<arms.len() {
                    arm := arms[arm_index]
                    sema_function_reactive_apply_upgrade_flags(&arm.body, names)
                    arms[arm_index] = arm
                }
                if else_body == .Val(body) {
                    sema_function_reactive_apply_upgrade_flags(&body, names)
                    else_body = Val(body)
                }
                if statement == {
                    .Switch(_, _, _, _) -> {
                        statements[index] = Stmt.Switch{subject: subject, arms: arms, else_body: else_body, span: span}
                    }
                    else -> {
                        statements[index] = Stmt.ComptimeSwitch{subject: subject, arms: arms, else_body: else_body, span: span}
                    }
                }
            }
            .ComptimeIf(condition, condition_span, then_body, else_body, span, selected_then) -> {
                sema_function_reactive_apply_upgrade_flags(&then_body, names)
                if else_body == .Val(body) {
                    sema_function_reactive_apply_upgrade_flags(&body, names)
                    else_body = Val(body)
                }
                statements[index] = Stmt.ComptimeIf{cond: condition, cond_span: condition_span, then_body: then_body, else_body: else_body, span: span, selected_then: selected_then}
            }
            else -> {}
        }
        index += 1
    }
}

fn sema_function_reactive_binding_shared(binding: Binding) -> Bool Never! {
    loop marker in binding.markers { if marker.name == "Shared" -> return true }
    false
}
