// Reference identities emitted only after checker lookup succeeds.
use jet_foundation.[Span, Expr, Stmt, StrPart, Item, Func, Binding, Param, Diagnostic, TextEdit, NameLedger, NameReference, StructureFact, StructureFactKind]
use jet_foundation.Syntax
use jet_sema.[Checker, LocalInfo, UnusedBinding]
use jet_sema.Comptime.CtValue
use jet_sema.UnsafeObligations.nested_bodies
use std.collections.HashSet

impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:6
    fn unused_name_is_intentional(name: String) -> Bool {
        name.is_empty() || name.starts_with('_') || name == Syntax.KW_SELF || name == "result"
            || name == Syntax.AMBIENT_ERR || name == Syntax.KW_IT
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:15
    pub fn note_unused_binding(self: &Self, name: String, span: Span, parameter: Bool) {
        if Self.unused_name_is_intentional(name) || span.start >= span.end
            || self.unused_bindings.iter().any(fn(binding) { binding.span == span }) -> return
        self.unused_bindings.push(UnusedBinding{name: name.to_string(), span: span, parameter: parameter})
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:32
    pub fn mark_local_write(self: &Self, name: String) {
        if self.lookup(name) == .Val(info) { _ :: self.unused_binding_refs.insert(info.def_span) }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:38
    pub fn mark_local_name_reference(self: &Self, name: String) {
        if self.lookup(name) == .Val(info) { _ :: self.unused_binding_refs.insert(info.def_span) }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:44
    pub fn mark_default_parameter_references(self: &Self, params: [Param]) {
        loop param in params {
            if param.default != .Val(default) -> continue
            copy := default.clone()
            &copy.for_each_expr_mut(fn(node) {
                if node == {
                    .Ident(name, _) | .ComptimeName(name: name, ..) -> &self.mark_local_name_reference(name)
                    .Call(call) -> &self.mark_local_name_reference(call.name)
                    _ -> {}
                }
            })
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:60
    pub fn emit_unused_binding_lints(self: &Self) {
        bindings :: ^self.unused_bindings
        self.unused_bindings = []
        loop binding in bindings {
            if self.unused_binding_refs.contains(binding.span) -> continue
            self.name_ledger.record_structure_fact(StructureFact.new(.Liveness,
                binding.name.clone(), self.module_path.to_string(), binding.span, "unused",
                if binding.parameter -> "parameter is never read" else -> "binding is never read", Val("_name")))
            code :: if binding.parameter -> "L0102" else -> "L0101"
            diagnostic :: Diagnostic.from_row(code, [("name", binding.name)], Val(binding.span))
                .with_edit(self.unused_binding_edit(binding, binding.name))
            self.diags.push(diagnostic)
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:87
    fn unused_binding_edit(self: Self, binding: UnusedBinding, name: String) -> TextEdit {
        if !binding.parameter {
            if self.side_effect_free_binding_span(binding.span) == .Val(span) {
                return TextEdit{span: span, new_text: String.new()}
            }
        }
        TextEdit{span: binding.span, new_text: "_{name}"}
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:106
    fn side_effect_free_binding_span(self: Self, name_span: Span) -> Span? {
        if find_function_by_span(self.items, self.current_function_span) != .Val(function) -> return None
        if binding_by_span(function.body, name_span) != .Val(binding) -> return None
        if binding.pattern.is_some() || binding.is_comptime || binding.ct.is_some() || binding.uninit
            || binding.meta.is_some() || !binding.markers.is_empty() || binding.arena_view || binding.string_view
            || binding.gc_promotion.is_some() || binding.gc_transferred || !literal_without_effects(binding.init) -> return None
        Val(Span.new(binding.name_span.start, binding.init.span().end))
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:126
    pub fn record_reference_anchor(self: &Self, span: Span, module_path: String, kind: String, def_span: Span) {
        &self.record_reference_anchor_with_identity(span, module_path, kind, def_span, None)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:136
    fn record_reference_anchor_with_identity(self: &Self, span: Span, module_path: String, kind: String, def_span: Span, semantic_identity: String?) {
        self.name_ledger.record_reference(self.module_path.to_string(), span.start, span.end,
            NameReference{module_path: module_path.to_string(), kind: kind.to_string(), def_span: def_span, semantic_identity: semantic_identity})
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:157
    pub fn record_semantic_reference(self: &Self, span: Span, semantic_identity: String) {
        self.name_ledger.record_reference(self.module_path.to_string(), span.start, span.end,
            NameReference{module_path: self.module_path.to_string(), kind: "semantic", def_span: span, semantic_identity: Val(semantic_identity)})
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:171
    pub fn record_local_reference(self: &Self, span: Span, info: LocalInfo) {
        _ :: self.unused_binding_refs.insert(info.def_span)
        kind :: if info.param_conv.is_some() -> "param" else -> "local"
        module_path :: self.module_path.to_string()
        &self.record_reference_anchor(span, module_path, kind, info.def_span)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:182
    pub fn record_function_reference(self: &Self, module_idx: USize, name: String, span: Span) {
        if self.name_ledger.declaration(module_idx, name) == .Val(declaration) {
            module_path :: (self.name_ledger.module_path(module_idx) ?? self.module_path).to_string()
            def_span :: declaration.span
            identity :: self.name_ledger.semantic_identity(module_idx, name)
            &self.record_reference_anchor_with_identity(span, module_path, "function", def_span, identity)
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:207
    pub fn record_current_function_reference(self: &Self, name: String, span: Span) {
        &self.record_function_reference(self.module_idx, name, span)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:213
    fn callback_function_target(self: Self, name: String) -> (USize, String)? {
        if self.funcs.contains_key(name) -> return Val((self.module_idx, name.to_string()))
        if self.inline_module == .Val(scope) {
            if self.inline_unqualified.get((scope.clone(), name.to_string())) == .Val(mangled) {
                return Val((self.module_idx, mangled.clone()))
            }
            if self.inline_unqualified_file.get((scope.clone(), name.to_string())) == .Val((function, module)) {
                return Val((module, function.clone()))
            }
        }
        if self.unqualified.get(name) == .Val(mangled) -> return Val((self.module_idx, mangled.clone()))
        if self.unqualified_file.get(name) == .Val((function, module)) -> return Val((module, function.clone()))
        None
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:239
    pub fn callback_function_key(self: Self, name: String) -> String? {
        if self.callback_function_target(name) != .Val((module, function)) -> return None
        self.name_ledger.semantic_identity(module, function)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:244
    pub fn callback_function_is_safe(self: Self, name: String) -> Bool {
        if self.callback_function_target(name) != .Val((module, function)) -> return false
        signature :: if module == self.module_idx -> self.funcs.get(function)
            else -> self.modules.and_then(fn(modules) { modules.get(module) }).and_then(fn(owner) { owner.funcs.get(function) })
        signature.is_some_and(fn(sig) { !sig.is_extern && sig.is_foreign_thread_safe })
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:261
    pub fn record_const_reference(self: &Self, name: String, span: Span) {
        if self.name_ledger.declaration(self.module_idx, name) == .Val(declaration) {
            module_path :: (self.name_ledger.module_path(self.module_idx) ?? self.module_path).to_string()
            def_span :: declaration.span
            identity :: self.name_ledger.semantic_identity(self.module_idx, name)
            &self.record_reference_anchor_with_identity(span, module_path, "const", def_span, identity)
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:286
    pub fn record_import_alias_use(self: &Self, alias: String) -> Span? {
        if self.lookup(alias).is_some() -> return None
        record_import_alias_use_in_ledger(&self.name_ledger, self.module_idx, alias)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:293
    pub fn record_import_alias_reference(self: &Self, alias: String, span: Span) {
        if &self.record_import_alias_use(alias) == .Val(def_span) {
            module_path :: self.module_path.to_string()
            identity :: self.name_ledger.alias_identity(self.module_idx, def_span)
            &self.record_reference_anchor_with_identity(span, module_path, "import_alias", def_span, identity)
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:308
    pub fn record_method_reference(self: &Self, type_name: String, method: String, span: Span) {
        (import_ns, leaf) :: Self.split_type_name(type_name)
        if self.struct_owner_module(leaf, import_ns) != .Val(owner) -> return
        name :: "{leaf}.{method}"
        declaration :: self.name_ledger.declaration(owner, name) or_else fn() { self.name_ledger.declaration(self.module_idx, name) }
        if declaration == .Val(decl) {
            module_path :: (self.name_ledger.module_path(decl.module) ?? self.module_path).to_string()
            def_span :: decl.span
            identity :: self.name_ledger.semantic_identity(decl.module, name)
            &self.record_reference_anchor_with_identity(span, module_path, "function", def_span, identity)
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:346
    pub fn record_field_reference(self: &Self, owner: USize, type_name: String, member: String, span: Span) {
        (_, leaf) :: Self.split_type_name(type_name)
        name :: "{leaf}.{member}"
        if self.name_ledger.declaration(owner, name) == .Val(decl) {
            module_path :: (self.name_ledger.module_path(decl.module) ?? self.module_path).to_string()
            def_span :: decl.span
            identity :: self.name_ledger.semantic_identity(owner, name)
            &self.record_reference_anchor_with_identity(span, module_path, "field", def_span, identity)
        }
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:380
fn record_import_alias_use_in_ledger(ledger: &NameLedger, module_idx: USize, alias: String) -> Span? {
    def_span :: ledger.effective_alias(module_idx, alias).map(fn(alias) { alias.span })
    if def_span == .Val(span) { ledger.record_alias_use(module_idx, span) }
    def_span
}
// Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:393
pub fn record_comptime_import_alias_uses(ledger: &NameLedger, module_idx: USize, expression: Expr, imports: [String:String], globals: [String:CtValue]) {
    global_aliases := HashSet[String].new()
    loop alias in imports.keys() { if globals.contains_key(alias) { _ :: global_aliases.insert(alias.clone()) } }
    shadowed := HashSet[(Span, String)].new()
    expression.for_each_expr(fn(node) {
        if node == {
            .Lambda(lambda) -> {
                lambda_aliases := HashSet[String].new()
                loop parameter in lambda.params {
                    if imports.contains_key(parameter.name) { _ :: lambda_aliases.insert(parameter.name.clone()) }
                }
                loop (name, _) in lambda.take_names {
                    if imports.contains_key(name) { _ :: lambda_aliases.insert(name.clone()) }
                }
                if lambda.body == {
                    .Expr(body) -> mark_shadowed_expr(body, lambda_aliases, &shadowed)
                    .Block(body) -> {
                        mark_shadowed_stmts(body, lambda_aliases, &shadowed)
                        _ :: collect_shadowed_stmts(body, imports, &shadowed)
                    }
                }
            }
            .If(then_body: then_body, then_value: then_value, else_body: else_body, else_value: else_value, ..) -> {
                then_aliases :: collect_shadowed_stmts(then_body, imports, &shadowed)
                mark_shadowed_expr(then_value, then_aliases, &shadowed)
                else_aliases :: collect_shadowed_stmts(else_body, imports, &shadowed)
                mark_shadowed_expr(else_value, else_aliases, &shadowed)
            }
            .OrFallback(fallback: .Block(body: body, value: value, ..), ..) -> {
                fallback_aliases := HashSet[String].new()
                if imports.contains_key(Syntax.AMBIENT_ERR) { _ :: fallback_aliases.insert(Syntax.AMBIENT_ERR.to_string()) }
                mark_shadowed_stmts(body, fallback_aliases, &shadowed)
                fallback_aliases.extend(collect_shadowed_stmts(body, imports, &shadowed))
                if value == .Val(value) { mark_shadowed_expr(value, fallback_aliases, &shadowed) }
            }
            _ -> {}
        }
    })
    expression.for_each_expr(fn(node) {
        alias :: if node == {
            .Call(call) -> Val(call.name.split_once('.').map_or(call.name, fn(alias, _) { alias }))
            .Field(base, ..) | .Index(base: base, ..) | .Slice(base: base, ..)
                | .MethodCall(receiver: base, ..) | .OptField(base: base, ..) -> import_alias_root(base)
            .CallValue(callee: callee, ..) -> import_alias_root(callee)
            .PtrFromAddr(alias: alias, ..) -> Val(alias)
            .StructLit(import_ns: .Val(alias), ..) -> Val(alias)
            _ -> None
        }
        if alias != .Val(alias) -> return
        if !imports.contains_key(alias) || global_aliases.contains(alias) || shadowed.contains((node.span(), alias.to_string())) -> return
        _ :: record_import_alias_use_in_ledger(&ledger, module_idx, alias)
    })
}
// Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:493
fn mark_shadowed_expr(expression: Expr, aliases: HashSet[String], shadowed: &HashSet[(Span, String)]) {
    if aliases.is_empty() -> return
    expression.for_each_expr(fn(node) { loop alias in aliases { _ :: shadowed.insert((node.span(), alias.clone())) } })
}
// Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:508
fn mark_shadowed_stmt(statement: Stmt, aliases: HashSet[String], shadowed: &HashSet[(Span, String)]) {
    if aliases.is_empty() -> return
    statement.for_each_expr(fn(node) { loop alias in aliases { _ :: shadowed.insert((node.span(), alias.clone())) } })
}
// Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:523
fn mark_shadowed_stmts(statements: [Stmt], aliases: HashSet[String], shadowed: &HashSet[(Span, String)]) {
    loop statement in statements { mark_shadowed_stmt(statement, aliases, &shadowed) }
}
// Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:533
fn binding_import_aliases(binding: Binding, imports: [String:String]) -> HashSet[String] {
    aliases := HashSet[String].new()
    if !binding.name.is_empty() && imports.contains_key(binding.name) { _ :: aliases.insert(binding.name.clone()) }
    if binding.pattern == .Val(pattern) {
        loop name in pattern.names() { if imports.contains_key(name.name) { _ :: aliases.insert(name.name.clone()) } }
    }
    ^aliases
}
// Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:551
fn collect_shadowed_stmts(statements: [Stmt], imports: [String:String], shadowed: &HashSet[(Span, String)]) -> HashSet[String] {
    bound := HashSet[String].new()
    loop statement in statements {
        mark_shadowed_stmt(statement, bound, &shadowed)
        collect_shadowed_stmt_scopes(statement, imports, &shadowed)
        if statement == .Val(binding) { bound.extend(binding_import_aliases(binding, imports)) }
    }
    ^bound
}
// Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:567
fn collect_shadowed_stmt_scopes(statement: Stmt, imports: [String:String], shadowed: &HashSet[(Span, String)]) {
    if statement == {
        .While(body: body, ..) | .Loop(body: body, ..) | .Reactive(body: body, ..) | .Shield(body: body, ..)
            | .Switched(body: body, ..) | .Region(body: body, ..) | .Policy(body: body, ..)
            | .AuthorityScope(body: body, ..) | .ComptimeBlock(body: body, ..) | .Live(body: body, ..)
            | .Transact(body: body, ..) | .Layout(body: body, ..) -> { _ :: collect_shadowed_stmts(body, imports, &shadowed) }
        .For(var: var, var2: var2, body: body, ..) -> {
            aliases := HashSet[String].new()
            if imports.contains_key(var) { _ :: aliases.insert(var.clone()) }
            if var2 == .Val((var2, _)) { if imports.contains_key(var2) { _ :: aliases.insert(var2.clone()) } }
            mark_shadowed_stmts(body, aliases, &shadowed)
            _ :: collect_shadowed_stmts(body, imports, &shadowed)
        }
        .Switch(arms: arms, else_body: else_body, ..) | .ComptimeSwitch(arms: arms, else_body: else_body, ..) -> {
            loop arm in arms { _ :: collect_shadowed_stmts(arm.body, imports, &shadowed) }
            if else_body == .Val(body) { _ :: collect_shadowed_stmts(body, imports, &shadowed) }
        }
        .CountedLoop(init: init, cond: cond, step: step, body: body, ..) -> {
            aliases :: binding_import_aliases(init, imports)
            mark_shadowed_expr(cond, aliases, &shadowed)
            if step == .Val(step) {
                mark_shadowed_stmt(step, aliases, &shadowed)
                collect_shadowed_stmt_scopes(step, imports, &shadowed)
            }
            mark_shadowed_stmts(body, aliases, &shadowed)
            _ :: collect_shadowed_stmts(body, imports, &shadowed)
        }
        .Unsafe(body: body, ..) | .Impure(body: body, ..) | .TaskGroup(body: body, ..)
            | .ContextBlock(body: body, ..) | .AssumeDet(body: body, ..) | .ScopeMember(body: body, ..) -> {
            _ :: collect_shadowed_stmts(body, imports, &shadowed)
        }
        .ComptimeIf(then_body: then_body, else_body: else_body, ..) -> {
            _ :: collect_shadowed_stmts(then_body, imports, &shadowed)
            if else_body == .Val(body) { _ :: collect_shadowed_stmts(body, imports, &shadowed) }
        }
        _ -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:660
fn import_alias_root(expr: Expr) -> String? from expr {
    if expr == {
        .Ident(name, _) -> Val(name)
        .Paren(inner, _) | .Copy(inner, _) | .Place(inner, _, _) | .Deref(inner, _) | .RawOf(inner, _)
            | .Tainted(inner, _, _) | .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Try(inner, _, _, _) -> import_alias_root(inner)
        .OrFallback(value: value, ..) -> import_alias_root(value)
        .Index(base: base, ..) | .Slice(base: base, ..) | .Field(base, ..) | .OptField(base: base, ..) -> import_alias_root(base)
        .MethodCall(receiver: receiver, ..) -> import_alias_root(receiver)
        .CallValue(callee: callee, ..) -> import_alias_root(callee)
        .PtrFromAddr(alias: alias, ..) | .StructLit(import_ns: .Val(alias), ..) -> Val(alias)
        _ -> None
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:689
fn find_function_by_span(items: [Item], span: Span) -> Func? from items {
    loop item in items {
        function :: if item == {
            .Func(function) -> if function.span == span -> Val(function) else -> None
            .Struct(definition) -> definition.methods.iter().find(fn(function) { function.span == span }).or_else(fn() {
                definition.trait_impls.iter().flat_map(fn(implementation) { implementation.methods.iter() }).find(fn(function) { function.span == span })
            })
            .Enum(definition) -> definition.methods.iter().find(fn(function) { function.span == span }).or_else(fn() {
                definition.trait_impls.iter().flat_map(fn(implementation) { implementation.methods.iter() }).find(fn(function) { function.span == span })
            })
            .Impl(implementation) -> implementation.methods.iter().find(fn(function) { function.span == span })
            .CodeModule(module) -> module.body.and_then(fn(body) { find_function_by_span(body, span) })
            _ -> None
        }
        if function.is_some() -> return function
    }
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:735
fn binding_by_span(body: [Stmt], span: Span) -> Binding? from body {
    loop statement in body {
        if statement == .Val(binding) { if binding.name_span == span -> return Val(binding) }
        loop nested in nested_bodies(statement) {
            if binding_by_span(nested, span) == .Val(binding) -> return Val(binding)
        }
    }
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerReferences.rs:753
fn literal_without_effects(expr: Expr) -> Bool {
    if expr.without_parens() == {
        .Str(parts, _) -> parts.iter().all(fn(part) { if part == .Lit(_) -> true else -> false })
        .Int(..) | .Float(..) | .Bool(..) | .Char(..) | .Absent(..) -> true
        _ -> false
    }
}
