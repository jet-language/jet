    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:1832
    pub fn rewrite_typed_boundary_literal(self: &Self, e: &Expr, type_name: String, span: Span) -> Type? {
        kind :: Syntax.typed_head_kind(type_name).filter(value -> value.is_boundary()) ?? return None
        if e != .Str(parts, literal_span) {
            return self.rewrite_typed_text_literal(&e, kind.source_name(), span).map(_ -> Type.Named(kind.internal_type_name()))
        }
        has_holes :: parts.iter().any(part -> if part == { .Interp -> true; _ -> false })
        if kind.forbids_holes() && has_holes {
            self.diags.push(Diagnostic.error("E0155", "a `DateTime` literal cannot contain interpolation", "DateTime values are checked as complete RFC3339 literals before the program runs", "write a complete `DateTime{{\"…\"}}` literal, or parse a runtime String explicitly", Val(literal_span)))
            return None
        }
        literals := [String]{""}
        loop part in parts {
            if part == {
                .Lit(text) -> literals[literals.len() - 1].push_str(text)
                .Interp -> literals.push("")
            }
        }
        if validate_typed_boundary_literal(kind, literals) == .Err(reason) {
            self.diags.push(Diagnostic.error("E0155", "this `{type_name}` literal is invalid", reason, "fix the literal, or parse a runtime String with the ordinary `{type_name}` constructor", Val(literal_span)))
            return None
        }
        self.rewrite_typed_text_literal(&e, kind.source_name(), span).map(_ -> Type.Named(kind.internal_type_name()))
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:1886
    pub fn rewrite_regex_literal(self: &Self, e: &Expr, span: Span) -> Type? {
        old :: e.replace(Expr.Absent(span))
        if old != .Str(parts, literal_span) {
            e = ^old
            self.diags.push(Diagnostic.error("E0152", "`Regex.{{ … }}` needs one quoted pattern", "a regex typed literal contains pattern text, not another expression shape", "write `Regex.{{\"...\"}}`", Val(span)))
            return None
        }
        if parts.len() != 1 || !(if parts[0] == { .Lit -> true; _ -> false }) {
            e = Expr.Str(^parts, literal_span)
            self.diags.push(Diagnostic.error("E0152", "a `Regex` literal cannot contain interpolation", "the compiler must know the complete pattern before the program runs", "use a fixed `Regex.{{\"...\"}}` pattern, or build text and call `re.compile(text)`", Val(literal_span)))
            return None
        }
        if parts[0] == .Lit(pattern) {
            if RegexSyntax.validate(pattern) == .Err(error) {
                e = Expr.Str(^parts, literal_span)
                self.diags.push(Diagnostic.error("E0152", "this regex pattern is invalid at position {error.offset}", error.reason, "fix the pattern at the reported position", Val(literal_span)))
                return None
            }
        }
        e = Expr.Call(Call{name: Syntax.TYPE_REGEX, name_span: span, type_args: [], args: [CallArg{convention: AccessConvention.Read, expr: Expr.Str(^parts, literal_span), span: literal_span, flags: CallArgFlags.default(), label: None, spread: false}], resolved_ret: None, range_checked: false, widen_approx: false})
        Val(Type.Named(Syntax.TYPE_REGEX))
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:1944
    pub fn infer_statement_expr(self: &Self, expr: &Expr) -> Type? {
        self.normalize_imported_core_expr(&expr)
        self.normalize_prelude_expr(&expr)
        saved_statement :: self.statement_expr_inference
        saved_root :: self.statement_expr_root_depth
        self.statement_expr_inference = true
        paren_depth := 0
        root := &expr
        loop {
            if root == .Paren(inner, _) { paren_depth += 1; root = &inner }
            else { break }
        }
        direct_call :: if root == { .Call -> true; _ -> false }
        self.statement_expr_root_depth = Val(self.source_nesting + paren_depth + if direct_call { 0 } else { 1 })
        result :: self.infer_fallible_stmt(&expr)
        self.statement_expr_inference = saved_statement
        self.statement_expr_root_depth = saved_root
        result
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:1982
    pub fn auto_propagate_call(self: &Self, e: &Expr, result: Type?) -> Type? {
        declared :: if e.without_parens() == {
            .Call(call) -> ~call.resolved_ret
            .MethodCall(resolved_ret: ret, ..) -> ~ret
            _ -> None
        }
        // Stream is the executable protocol, never a failure rail.
        if declared == .Val(.Apply(name, args)) && name == Syntax.TYPE_STREAM && args.len() == 1 -> return declared
        never_failure :: if declared == { .Val(.Result(_, err)) -> err.is_never(); _ -> false }
        if never_failure && (if self.expected_type == { .Val(.Result) -> true; _ -> false }) -> return result
        if !never_failure {
            if declared.filter(ty -> !ty.is_fallible()) == .Val(ret) {
                carrier :: if result == { .Val(.Result), .Val(.Option) -> true; _ -> false }
                if self.failure_carrier_inference && carrier {
                    if self.failure_carrier == None { self.failure_carrier = ~result }
                    self.task_body_propagates = true
                    return Val(^ret)
                }
                if !result.is_some_and(ty -> ty.is_fallible()) -> return Val(^ret)
            }
        }
        propagation_result :: if e.without_parens() == {
            .MethodCall(resolved_ret: .Val(carrier), ..) && carrier.is_fallible() -> Val(~carrier)
            _ -> ~result
        }
        inline_loop :: if e.without_parens() == {
            .CallValue(callee, args, _) && args.is_empty() -> if callee == { .Lambda(lam) -> lam.meta.collecting_loop || lam.meta.result_loop; _ -> false }
            _ -> false
        }
        nested_statement_value :: self.statement_expr_inference && self.statement_expr_root_depth.is_some_and(root -> self.source_nesting > root) && (self.failure_carrier_inference || (if self.ret == { .Val(.Result) -> true; _ -> false }))
        never_carrier :: if propagation_result == { .Val(.Result(_, err)) -> err.is_never(); _ -> false }
        result_carrier :: if propagation_result == { .Val(.Result) -> true; _ -> false }
        expected_carrier :: if self.expected_type == { .Val(.Result) -> true; _ -> false }
        if self.failure_carrier_inference && !never_carrier && result_carrier && (!expected_carrier || nested_statement_value) {
            if self.failure_carrier == None { self.failure_carrier = ~propagation_result }
            if nested_statement_value { self.ret = self.expected_type.or_else(fn() { ~propagation_result }) }
            else if self.ret == None { self.ret = ~propagation_result }
            self.task_body_propagates = true
            if self.expected_type == None && !nested_statement_value -> return result
        }
        call_shape :: if e.without_parens() == { .Call, .MethodCall, .CallValue -> true; _ -> false }
        expected_real_failure :: if self.expected_type == {
            .Val(.Result(_, err)) -> !(if err == { .Named(name) -> name == Syntax.TYPE_NEVER; _ -> false })
            _ -> false
        }
        if inline_loop || self.compiler_generated || !call_shape || !result_carrier || expected_real_failure -> return result
        span :: e.span()
        inner := e.replace(Expr.Absent(span))
        convert := TryConvert.None
        note := None
        checked :: self.infer_try_with_inner_type(&inner, span, &convert, &note, ^propagation_result)
        e = Expr.Try(^inner, span, ^convert, ^note)
        checked
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2142
    pub fn infer(self: &Self, e: &Expr) -> Type? {
        suppress_auto :: self.failure_auto_root_suppression > 0
        is_paren :: if e == { .Paren -> true; _ -> false }
        if suppress_auto && !is_paren { self.failure_auto_root_suppression -= 1 }
        if !self.enter_source_nesting(e.span()) -> return None
        self.check_scoped_loan_read(e)
        saved_expected :: ~self.expected_type
        preserves_carrier :: if e.without_parens() == {
            .Call, .MethodCall, .CallValue, .Lambda, .Ok, .Err, .Try, .If -> true
            .EnumLit(type_name: type_name, variant: variant, leading_dot: true, ..) && type_name.is_empty() -> if contextual_literal(variant) == { .Val(.Ok), .Val(.Err) -> true; _ -> false }
            _ -> false
        }
        if !preserves_carrier && saved_expected == .Val(.Result(ok, _)) { self.expected_type = Val(~ok) }
        if e == .If { self.note_carrier_chain_subject(e) }
        pattern_if :: if e == { .If(cond: cond, ..) -> if cond == { .PatternTest -> true; _ -> false }; _ -> false }
        if pattern_if || ((if e == { .If -> true; _ -> false }) && noelse_terminated(e)) { self.check_noelse_dispatch_chain(e) }
        result := Type?{None}
        if self.fold_reflect_call(&e) == .Val(folded) { result = ^folded }
        else {
            if e == .Call { self.normalize_contextual_expr(&e) }
            if self.implicit_loop_subject_depth > 0 || self.expected_type.is_some_and(ty -> if ty == { .Fn -> true; .Named(name) -> name == "UIShortcut"; _ -> false }) { normalize_bare_method_head(&e) }
            if e == .Call || e == .CallValue { result = self.infer_call_like(&e) }
            else { result = self.infer_checked(&e) }
        }
        self.expected_type = ^saved_expected
        if !suppress_auto { result = self.auto_propagate_call(&e, ^result) }
        if self.expr_definitely_diverges(e) || result.is_some_and(ty -> if ty == { .Named(name) -> name == Syntax.TYPE_NEVER; _ -> false }) { self.flow.reachable = false }
        if result.is_some_and(ty -> type_uses_default_int(ty)) { self.uses_exact_int = true }
        self.leave_source_nesting()
        result
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2257
    pub fn infer_without_auto_propagation(self: &Self, e: &Expr) -> Type? {
        previous :: self.failure_auto_root_suppression
        self.failure_auto_root_suppression += 1
        result :: self.infer(&e)
        if self.failure_auto_root_suppression > previous { self.failure_auto_root_suppression = previous }
        result
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2270
    pub fn infer_with_expected(self: &Self, e: &Expr, expected: &Type) -> Type? {
        if type_uses_default_int(expected) { self.uses_exact_int = true }
        saved :: self.expected_type.replace(Val(~expected))
        result :: self.infer(&e)
        self.expected_type = ^saved
        result
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2286
    fn infer_aggregate_value(self: &Self, e: &Expr, expected: &Type?) -> Type? {
        escapes :: if e.without_parens() == { .Lambda -> true; _ -> false }
        saved :: self.lambda_escapes
        if escapes { self.lambda_escapes = true }
        result :: if expected == { .Val(ty) -> self.infer_with_expected(&e, ty); .None -> self.infer_owning_value(&e) }
        self.lambda_escapes = saved
        result
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2304
    pub fn implicit_copy_target(self: &Self, e: &Expr, ty: &Type) -> Type? {
        if owned_type_for_read_view(ty) == .Val(target) -> return Val(^target)
        if e == .Ident(name, _) && self.is_string_view(name) && ty == Type.String -> return Val(Type.String)
        sources :: self.view_call_sources(e)
        if !sources.is_empty() && sources.iter().all(fn((path, _, kind, access)) { path.is_empty() && access == ViewAccess.Read && (kind == ViewKind.List || kind == ViewKind.Buffer || kind == ViewKind.Matrix) }) -> return Val(~ty)
        place :: if e == { .Ident, .Field, .Index -> true; _ -> false }
        if !type_is_copy(ty) && place && expr_root_ident(e).is_some_and(root -> self.lookup(root).is_some_and(info -> info.param_conv == Val(AccessConvention.Read) || info.param_conv == Val(AccessConvention.Write))) -> return Val(~ty)
        None
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2359
    pub fn infer_owning_value(self: &Self, e: &Expr) -> Type? {
        owns_arms :: (if e.without_parens() == { .If -> true; _ -> false }) && !self.expected_type.is_some_and(ty -> if ty == { .Apply(name, _) -> name == "View" || name == "ViewMut"; _ -> false })
        saved :: self.owning_if_value_depth
        if owns_arms { self.owning_if_value_depth += 1 }
        result :: self.infer_owning_value_inner(&e)
        self.owning_if_value_depth = saved
        result
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2374
    fn infer_owning_value_inner(self: &Self, e: &Expr) -> Type? {
        default_copy :: !self.copies_explicit()
        projection :: if e == { .Field, .Index -> true; _ -> false }
        borrowed_place :: projection && expr_root_ident(e).is_some_and(root -> self.lookup(root).is_some_and(info -> info.param_conv == Val(AccessConvention.Read) || info.param_conv == Val(AccessConvention.Write)))
        saved_borrow :: self.borrow_ctx
        saved_string :: self.allow_string_view_read
        if default_copy && borrowed_place { self.borrow_ctx = true }
        if default_copy && e == .Ident(name, _) && self.is_string_view(name) { self.allow_string_view_read = true }
        inferred :: self.infer(&e)
        self.borrow_ctx = saved_borrow
        self.allow_string_view_read = saved_string
        ty :: inferred ?? return None
        expected_view :: self.expected_type.is_some_and(expected -> if expected == { .Apply(name, _) -> name == "View" || name == "ViewMut"; _ -> false })
        if !default_copy || expected_view -> return Val(^ty)
        target :: self.implicit_copy_target(e, ty) ?? return Val(^ty)
        if self.expected_type.is_some_and(expected -> expected != target) -> return Val(^ty)
        if self.is_cloneable_type(target) -> Val(self.insert_implicit_copy(&e, ty, target)) else -> Val(^ty)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2432
    fn materialize_if_arm_local_read(self: &Self, e: &Expr, ty: &Type) {
        if e != .Ident(name, name_span) -> return
        if type_is_copy(ty) -> return
        if self.copies_explicit() {
            diagnostic :: Diagnostic.error("E0120", "`{name}` was not copied here, so it cannot fill an owned conditional value", "this arm supplies a non-Copy value to an owning conditional result under `copies: .Explicit`", "copy it explicitly with `{Syntax.SIGIL_COPY}{name}`", Val(name_span))
            self.diags.push(self.with_ownership_copy_edit(diagnostic, name_span, Val(~ty)))
            return
        }
        if self.type_is_single_use(ty) || !self.is_cloneable_type(ty) -> return
        span :: e.span()
        old :: e.replace(Expr.Absent(span))
        e = Expr.Copy(^old, span)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2460
    fn active_arithmetic_policy(self: &Self, operation: ArithmeticOperation, operation_span: Span) -> ArithmeticPolicyFact? {
        fact := self.arithmetic_policy_stack.last().copied() ?? return None
        fact.operation_span = operation_span
        fact.operation = Val(operation)
        Val(^fact)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2475
    fn policy_call(self: &Self, mode: ArithmeticMode, inner: Expr, fact: ArithmeticPolicyFact) -> Expr {
        span :: fact.operation_span
        flags := CallArgFlags.default()
        flags.arithmetic_policy = Val(^fact)
        Expr.Call(Call{name: mode.builtin(), name_span: span, type_args: [], args: [CallArg{convention: AccessConvention.Read, expr: ^inner, span: span, flags: ^flags, label: None, spread: false}], resolved_ret: None, range_checked: false, widen_approx: false})
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2503
    fn push_hidden_cost_lint(self: &Self, operation: String, fix: String, span: Span, edit: TextEdit) {
        diagnostic :: Diagnostic.from_row("L2510", [("operation", operation), ("fix", fix)], Val(span)).with_edit(edit)
        if !self.diags.iter().any(previous -> previous.code == diagnostic.code && previous.span == diagnostic.span && previous.what == diagnostic.what) { self.diags.push(^diagnostic) }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2525
    fn report_hidden_cost_in_loop(self: &Self, e: &Expr, source: &Type, target: &Type) {
        if self.loop_depth == 0 || !type_owns_heap(target, self.registry) -> return
        view_source := owned_type_for_read_view(source) != None || (source == Type.String && (if e == { .Ident(name, _) -> self.is_string_view(name); _ -> false }))
        if !view_source && source == .List {
            sources :: self.view_call_sources(e)
            view_source = view_source || (!sources.is_empty() && sources.iter().all(fn((_, _, kind, access)) { access == ViewAccess.Read && (kind == ViewKind.List || kind == ViewKind.Buffer || kind == ViewKind.Matrix) }))
        }
        if !view_source -> return
        edit :: explicit_copy_edit(self, e) ?? return
        self.push_hidden_cost_lint("this copy of `{target.show()}` view into an owned slot", Syntax.SIGIL_COPY, e.span(), edit)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2563
    pub fn insert_implicit_copy(self: &Self, e: &Expr, source: &Type, target: &Type) -> Type {
        span :: e.span()
        self.report_hidden_cost_in_loop(e, source, target)
        old :: e.replace(Expr.Absent(span))
        e = Expr.Copy(^old, span)
        if target == .Shared {
            self.record_memory_event(MemoryEvent.new(MemoryEventKind.RetainRelease, span, "implicit copy of `{target.show()}` retains a shared reference"))
        } else if type_owns_heap(target, self.registry) {
            self.record_memory_event(MemoryEvent.new(MemoryEventKind.Allocation, span, "implicit copy of `{target.show()}` allocates owned heap data"))
        }
        ~target
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2599
    fn rewrite_contextual_literal(self: &Self, e: &Expr) {
        expected :: if self.expected_type == { .Val(.Tagged(_, inner)) -> ~inner; .Val(ty) -> ~ty; .None -> return }
        (type_name, owner_args) :: if expected == { .Named(name) -> (~name, []); .Apply(name, args) -> (~name, ~args); _ -> return }
        (capability, source) :: if e == { .Int -> (Generics.LITERAL_INT, true); .Float -> (Generics.LITERAL_FLOAT, false); _ -> return }
        if !self.type_implements_trait_for_name(type_name, capability) -> return
        span :: e.span()
        original :: e.replace(Expr.Absent(span))
        argument :: if (source, original) == {
            (true, .Int) -> ^original
            (false, .Float(value, _, _, raw)) -> Expr.Str([StrPart.Lit(raw.unwrap_or_else(fn() { value.to_string() }))], span)
            _ -> { e = ^original; return }
        }
        e = Expr.MethodCall{receiver: Expr.Ident(^type_name, span), method: Generics.LITERAL_FROM_LITERAL, method_span: span, owner_type_args: ^owner_args, type_args: [], args: [CallArg{convention: AccessConvention.Read, expr: ^argument, span: span, flags: CallArgFlags.default(), label: None, spread: false}], recv_type: None, resolved_ret: None, operator_rhs: None, checked_widen: false}
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2652
    fn infer_call_like(self: &Self, e: &Expr) -> Type? {
        if is_optional_method_call(e) -> return self.infer_optional_method_call(&e)
        if e == {
            .Call(call) -> {
                span :: call.name_span
                self.clear_uninit_mut_args(call.args)
                if self.check_call(&call, true) == {
                    .Val(.Val(ty)) -> Val(^ty)
                    .Val(.None) -> {
                        self.diags.push(Diagnostic.error("E0116", "`{call.name}` doesn't hand back a value", "a call is a value only when its function declares a result after the parameter list", "inside an arm, wrap the call in `{{ … }}`; otherwise put `{call.name}` on its own line, or declare it as `fn {call.name}(…) Type -> …`", Val(span)))
                        None
                    }
                    .None -> None
                }
            }
            .CallValue(callee, args, span) -> self.infer_call_value(&callee, &args, span)
            _ -> ice(Val(e.span()), "infer_call_like requires Call or CallValue, got {e}")
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2689
    fn infer_checked(self: &Self, e: &Expr) -> Type? {
        if is_optional_method_call(e) -> return self.infer_optional_method_call(&e)
        self.rewrite_contextual_literal(&e)
        if e == .Field || e == .Index || e == .MethodCall {
            if self.fold_comptime_struct_field(&e) == .Val(ty) -> return Val(^ty)
        }
        conversion_span :: e.span()
        // Destination-owned exact conversion is fallible; rounded carries the mode and precision.
        if e == .MethodCall(receiver: receiver, method: method, args: args, resolved_ret: resolved_ret, ..) {
            if (args.len() == 1 || args.len() == 3) && method.starts_with("from_") && receiver == .Ident(destination, _) {
                if self.unit_fact_for_type(Type.Named(destination)) == .Val((destination_name, destination_fact)) {
                    source_ty :: self.infer(&args[0].expr)
                    if source_ty.and_then(ty -> self.unit_fact_for_type(ty)) == .Val((source_name, source_fact)) {
                        source_leaf :: source_name.rsplit('.').next().unwrap_or(source_name)
                        expected :: Syntax.conversion_method_for_source(source_leaf)
                        exact :: args.len() == 1 && method == expected
                        rounding_mode :: if args.len() == 3 {
                            if args[1].expr == { .EnumLit(type_name: type_name, variant: variant, args: mode_args, ..) -> type_name.is_empty() && Syntax.unit_rounding_mode(variant) != None && mode_args.is_empty(); _ -> false }
                        } else { false }
                        rounded :: args.len() == 3 && method == "{expected}_rounded" && rounding_mode && args[2].label.is_some_and(fn((label, _)) { label == "digits" })
                        measured_crossing :: source_fact.is_measured() || destination_fact.is_measured()
                        rounded_gate :: rounded && knowledge_gate_allows(KnowledgePlane.Unit, KnowledgeGate.RoundedConversion)
                        if ((exact && !measured_crossing) || rounded_gate) && source_fact.package == destination_fact.package && source_fact.family == destination_fact.family && source_fact.dimension == destination_fact.dimension && source_fact.kind == destination_fact.kind {
                            if !source_fact.conversion_is_finite_to(destination_fact) {
                                self.diags.push(self.unit_conversion_overflow_diagnostic(conversion_span))
                                return Val(Type.Named(^destination_name))
                            }
                            if rounded {
                                self.expect_core_arg(method, 2, Type.Int, &args[2])
                                negative_digits :: if args[2].expr == { .Unary(UnOp.Neg, inner, _) -> if inner == { .Int -> true; _ -> false }; _ -> false }
                                if negative_digits { self.diags.push(Diagnostic.error("E0127", "rounded unit conversion needs nonnegative digits", "digits counts destination decimal places", "write `digits: 0` or another nonnegative Int", Val(args[2].expr.span()))) }
