            old :: e.replace(placeholder)
            if old != .Call(call) -> unreachable("default error constructor is a call")
            e = self.default_err_value(^call, expects_result)
        }
        replacement := Expr?{None}
        if e == .Call(call) && !self.funcs.contains_key(call.name) {
            kind :: contextual_literal(call.name)
            unit_result :: if self.expected_type == { .Val(.Result(.Named(name), _)) -> name == Syntax.INTERNAL_UNIT_TYPE; _ -> false }
            if kind == Val(ContextualLiteral.Ok) && call.args.is_empty() && unit_result {
                replacement = Val(Expr.Ok(Expr.Unit(call.name_span), call.name_span))
            } else if (kind == Val(ContextualLiteral.Ok) || kind == Val(ContextualLiteral.Err)) && call.args.len() == 1 && call.args[0].label == None {
