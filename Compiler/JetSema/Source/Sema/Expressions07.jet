        replacement = None
        if e == .EnumLit(type_name: type_name, variant: variant, args: args, leading_dot: leading_dot, span: span, ..) && type_name.is_empty() {
            kind :: contextual_literal(variant)
            optional_kind :: kind == Val(ContextualLiteral.Value) || kind == Val(ContextualLiteral.Null)
            result_kind :: kind == Val(ContextualLiteral.Ok) || kind == Val(ContextualLiteral.Err)
            allowed :: if !leading_dot { optional_kind } else { (optional_kind && (if self.expected_type == { .Val(.Option) -> true; _ -> false })) || (result_kind && expects_result) }
            if allowed {
