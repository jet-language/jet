        rewrite_core_item_call(&e, item)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:2965
    pub fn normalize_prelude_expr(self: &Self, e: &Expr) {
        (name, span) :: if e == { .Call(call) -> (~call.name, call.name_span); _ -> return }
        if self.no_prelude || self.core_item_imports.contains_key(name) || self.funcs.contains_key(name) || self.lookup(name) != None -> return
        entry :: CorePrelude.entry(name) ?? return
        if entry.target == {
            .Core(module, item) -> {
                alias :: core_alias_for(self.core_imports, module) ?? return
                old :: e.replace(Expr.Absent(span))
                if old != .Call(call) -> unreachable("prelude normalization only replaces calls")
                e = Expr.MethodCall{receiver: Expr.Ident(alias, call.name_span), method: item, method_span: call.name_span, owner_type_args: [], type_args: ^call.type_args, args: ^call.args, recv_type: None, resolved_ret: ^call.resolved_ret, operator_rhs: None, checked_widen: false}
            }
            .Builtin && name == "assert" -> if e == .Call(call) { call.name = Syntax.BUILTIN_ASSERT }
            .Builtin && name == "assert_eq" -> if e == .Call(call) { call.name = Syntax.BUILTIN_ASSERT_EQ }
            _ -> {}
        }
    }
