        expects_result :: if self.expected_type == { .Val(.Result) -> true; _ -> false }
        if e == .Call(call) && call.name == Syntax.LIT_ERR && !self.funcs.contains_key(call.name) && (call.args.len() != 1 || call.args.first().is_some_and(arg -> arg.label != None) || !expects_result) {
