// L0103 reports a private import whose
// local name the file never reads. The parser records which import names the
// file spells outside its import declarations (`Program.used_import_names`),
// so every spelled read counts, including impl heads (`impl Local.types.Named`,
// ), `#run` bodies and interpolations, and a `core.mem` import is read where
// the file writes the low-level syntax it gates. C headers stay outside
// liveness because importing a bridge can have link-time meaning even when no
// Jet name is read; foreign bindings stay outside for the same reason. An
// import that shadows a bare Core type is never unused: it rebinds that name
// for the whole module, and a dependency's signatures spell their own types
// bare (`type_name(ty: Type)`), so the import decides what they mean even
// where the file never spells the name.
use jet_foundation.[
    symbol_table_key,
    BodyIfCond,
    BodyPatternShape,
    BodyTree,
    Diagnostic,
    FnBody,
    Func,
    Program,
    Span,
    TBinaryOp,
    TComptimeValue,
    TFieldRef,
    TextEdit,
    StructureFact,
    StructureFactKind,
    Type,
    checked_expr_type_id,
    comptime_walk_identifiers,
    core_bare_source_module,
    core_module_has_type,
    diagnostic_with_edit,
    jet_target_layout_enum_backing,
    jet_target_layout_enum_c_tag,
]

// A verdict's diagnostic is None when the lint is already reported by the
// check that found it (an unused local binding), so only its fact is new.
SemaLivenessVerdict: struct {
    code: String,
    diagnostic: Diagnostic?,
    fact: StructureFact,
}

SemaLivenessResult: struct {
    diagnostics: [Diagnostic],
    facts: [StructureFact],
}

sema_liveness_verdict: fn(code: String, name: String, source: String, span: Span, detail: String, diagnostic: Diagnostic, verdicts: &[SemaLivenessVerdict]) Never! {
    verdicts.push(
        SemaLivenessVerdict{
            code: code,
            diagnostic: Val(diagnostic),
            fact: StructureFact{kind: StructureFactKind.Liveness, subject: name, source: source, span: span, status: "unreachable", detail: detail, gate: None},
        },
    )
}

// L0101: the ownership check reports a local binding no expression reads,
// with the rename to `_name` as its edit, among the module's diagnostics.
// Each such lint becomes the binding's `unused` fact; its name is the edit's
// text past the `_` the rename adds.
sema_liveness_unused_bindings: fn(diagnostics: [Diagnostic], source: String, verdicts: &[SemaLivenessVerdict]) Never! {
    loop diagnostic in diagnostics {
        if diagnostic.code != "L0101" -> next
        span: diagnostic.span ?? next
        edit: diagnostic.edit ?? next
        renamed: edit.new_text.split_once("_") ?? next
        if renamed.before != "" || renamed.after == "" -> next
        name: renamed.after
        verdicts.push(
            SemaLivenessVerdict{
                code: "L0101",
                diagnostic: None,
                fact: StructureFact{kind: StructureFactKind.Liveness, subject: name, source: source, span: span, status: "unused", detail: "binding is never read", gate: None},
            },
        )
    }
}

sema_liveness_located: fn(diagnostic: &&Diagnostic?, segments: [SemaSourceSegment]) -> Diagnostic? Never! {
    found: diagnostic ?? return None
    Val(sema_diagnostic_with_source_location(found, segments))
}

// Whether a member import (`transform: functions.apply`) names `alias` as
// its owner. It reaches the owner through the module import that binds that
// name, so that module import is used.
sema_liveness_member_owner: fn(program: Program, alias: String) -> Bool Never! {
    loop declaration in program.imports {
        if declaration.kind == .Unqualified(module_alias, _, _, _, _) && module_alias == alias {
            return true
        }
    }
    false
}

sema_liveness_unused_imports: fn(program: Program, foreign_aliases: [String], source: String, verdicts: &[SemaLivenessVerdict]) {
    loop declaration in program.imports {
        if declaration.is_pub || declaration.is_package_pub -> next
        if declaration.kind == {
            .File(path, path_span) -> {
                if path.ends_with(".h") -> next
                // `use helper: "./helper"` renames the alias, written before
                // the path; an unaliased file import is removed whole.
                explicit_alias: declaration.alias_span.end <= path_span.start
                span: if explicit_alias -> declaration.alias_span else -> declaration.span
                edit: if explicit_alias -> TextEdit{span: span, new_text: "_{declaration.alias}"} else -> TextEdit{span: span, new_text: ""}
                sema_liveness_note_import(program, foreign_aliases, declaration.alias, source, span, Val(edit), verdicts)
            }
            .Module(_, path_span) -> {
                // `use files: core.files` renames the alias, written before
                // the path; an unaliased path import is removed whole.
                explicit_alias: declaration.alias_span.end <= path_span.start
                span: if explicit_alias -> declaration.alias_span else -> Span{start: path_span.end - declaration.alias.len(), end: path_span.end}
                edit: if explicit_alias -> TextEdit{span: span, new_text: "_{declaration.alias}"} else -> TextEdit{span: declaration.span, new_text: ""}
                if !sema_liveness_member_owner(program, declaration.alias) {
                    sema_liveness_note_import(program, foreign_aliases, declaration.alias, source, span, Val(edit), verdicts)
                }
            }
            .Unqualified(module_alias, module_alias_span, items, _, _) -> {
                loop (index, item) in items {
                    local: sema_registration_import_local(item)
                    span := module_alias_span
                    item_span := module_alias_span
                    if index < declaration.item_spans.len() {
                        item_span = declaration.item_spans[index]
                    }
                    if {
                        index < declaration.local_spans.len() -> {
                            span = declaration.local_spans[index]
                        }
                        index < declaration.item_spans.len() -> span = item_span
                    }
                    // An alias written before the path (`biggest: numeric.max`)
                    // is renamed in place; the dotted member row `owner.member`
                    // becomes the alias row `_member: owner.member`. A member
                    // of a `.[…]` list has no alias to rename, so the lint
                    // carries no edit there.
                    edit := TextEdit?{None}
                    if {
                        item.alias != None || span.end <= module_alias_span.start -> {
                            edit = Val(TextEdit{span: span, new_text: "_{local}"})
                        }
                        items.len() == 1 && item_span.start == module_alias_span.end + 1 -> {
                            edit = Val(TextEdit{span: Span{start: module_alias_span.start, end: item_span.end}, new_text: "_{local}: {module_alias}.{item.original}"})
                        }
                    }
                    sema_liveness_note_import(program, foreign_aliases, local, source, span, edit, verdicts)
                }
            }
        }
    }
}

sema_liveness_note_import: fn(program: Program, foreign_aliases: [String], name: String, source: String, span: Span, edit: TextEdit?, verdicts: &[SemaLivenessVerdict]) Never! {
    if name == "" || name.starts_with("_") || span.start >= span.end {
        return
    }
    if program.used_import_names.contains(name) || foreign_aliases.contains(name) {
        return
    }
    if core_bare_source_module(name) == .Val(owner) && core_module_has_type(owner, name) {
        return
    }
    diagnostic := sema_lint("L0103", span, "Import `{name}` is never used.", "An unused import adds a name and dependency to the file without contributing to checked code.", "Remove the import, or rename `{name}` to `_{name}` when the import is intentionally kept.")
    if edit == .Val(fix) -> diagnostic = diagnostic_with_edit(diagnostic, fix)
    sema_liveness_verdict("L0103", name, source, span, "import is never read", diagnostic, verdicts)
}

// ---------------------------------------------------------------------------:
// L0104 reports a function of a `priv module` that no reference reaches from
// outside its own body (a namespace package's sibling files count as callers);
// L0105 reports a function or constant of a `priv(package) module`, or a
// `pub(package)` re-export, that no other module of its package consumes. An
// inline module's members are lifted under generated `__jet_` names, so they
// are judged and reported by their source names. Roots (the entry `run`, the
// build entry, jobs, wasm and C exports) are never reported. Only snapshot
// (user) modules are judged; every module's references count.

SemaLivenessCandidate: struct {
    module_index: Int,
    body: Span,
    package_identity: String,
    private: Bool,
}

// The candidates by symbol id: `ids` maps an id to its row in `rows` and
// `reached`. A later candidate of the same id replaces the earlier one in
// its row.
SemaLivenessCandidates: struct {
    ids: [U32:Int],
    rows: [SemaLivenessCandidate],
    reached: [Bool],
}

sema_liveness_add_candidate: fn(candidates: &SemaLivenessCandidates, id: SymbolID, candidate: &&SemaLivenessCandidate) Never! {
    if candidates.ids.get(id.id) == .Val(row) {
        candidates.rows[row] = candidate.move()
        return
    }
    candidates.ids[id.id] = candidates.rows.len()
    candidates.rows.push(candidate)
    candidates.reached.push(false)
}

// `name` is the source name: an inline module member's lifted `__jet_` name
// is decoded first, so only truly compiler-generated names stay ignored.
sema_liveness_ignored: fn(name: String) -> Bool Never! {
    name == "" || name.starts_with("_") || name.starts_with("__jet_")
}

sema_liveness_is_root: fn(function: Func, is_entry: Bool) -> Bool Never! {
    if function.name == "build" && function.params.len() == 1 {
        if function.params[0].ty == .Named(name) {
            if name == "Build" -> return true
        }
    }
    if function.name == "dev" && function.params.len() == 1 {
        if function.params[0].ty == .Named(name) {
            if name == "Dev" -> return true
        }
    }
    // A `#Export(c)` function is called by its C symbol, which no Jet
    // reference records.
    if function.is_job || function.web_marker == .Val(.WasmExport) || sema_function_is_guest_export(function) {
        return true
    }
    // A declared `impl Source -> Target` is used by the fallible calls whose
    // failure it converts, which leave no call site or name reference; like
    // any impl it is not dead code.
    if sema_is_error_conversion_function(function) -> return true
    is_entry && function.name == "run"
}

// Rust `removable_private_function`: only a bodiless, unmarked function is
// deleted by the fix; anything else is renamed to `_name`.
sema_liveness_removable: fn(function: Func) -> Bool Never! {
    function.body.len() == 0 && function.meta == None && function.markers.len() == 0 && function.external_type == None && function.inline_foreign == None && function.undo == None && function.web_marker == None && function.pre.len() == 0 && function.post.len() == 0 && !function.compiler_generated && !function.is_unsafe && !function.is_pure && !function.is_reactive && !function.is_replayable && !function.is_job && function.every == None && !function.is_must_use && function.kernel == None
}

// `caller_key` is the calling body's key ("" when unknown).
sema_liveness_note_site: fn(candidates: &SemaLivenessCandidates, graph: SemaRegistrationGraph, source_index: Int, id: SymbolID, site: Span, caller_key: String) Never! {
    row: candidates.ids.get(id.id) ?? return
    candidate: candidates.rows[row]
    if source_index == candidate.module_index {
        // Specialization can carry a sibling's call site into this module's
        // checked rows. Byte offsets from two files are not caller identities.
        if candidate.private {
            if caller_key != "" {
                if caller_key == symbol_table_key(graph.symbols, id) {
                    return
                }
            } else {
                if site.start >= candidate.body.start && site.end <= candidate.body.end {
                    return
                }
            }
        }
        if candidate.private -> candidates.reached[row] = true
        return
    }
    if graph.modules[source_index].package_identity != candidate.package_identity {
        return
    }
    if !candidate.private || sema_registration_package_is_namespace(candidate.package_identity) {
        candidates.reached[row] = true
    }
}

sema_liveness_structure: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult]) -> SemaLivenessResult {
    verdicts := [SemaLivenessVerdict]{}
    // A skipped body (sema_checked_unusable_bodies) leaves its references
    // uncounted, so no verdict holds.
    if modules.len() != graph.modules.len() || graph.unusable_bodies.len() > 0 {
        return SemaLivenessResult{diagnostics: [Diagnostic]{}, facts: [StructureFact]{}}
    }
    candidates := SemaLivenessCandidates{ids: [U32:Int]{}, rows: [SemaLivenessCandidate]{}, reached: [Bool]{}}
    loop (module_index, module_row) in graph.modules {
        if module_row.source_origin != SemaSourceOrigin.Snapshot -> next
        is_entry: module_row.module_identity == graph.entry_module_identity
        loop function in module_row.functions {
            symbol: function.symbol
            if symbol.visibility > 1 || sema_liveness_ignored(sema_inline_member_source_name(symbol.name)) || symbol.span.start >= symbol.span.end {
                next
            }
            // A runtime binding is the jet.runtime interface's member: Core,
            // not the runtime package, calls a `priv` one (#6615).
            if sema_liveness_is_root(function.declaration, is_entry) || sema_guest_runtime_binding(module_row.package_identity, function.declaration) {
                next
            }
            sema_liveness_add_candidate(candidates, symbol.id, SemaLivenessCandidate{module_index: module_index, body: function.declaration.span, package_identity: module_row.package_identity, private: symbol.visibility == 0})
        }
        loop constant in module_row.constants {
            symbol: constant.symbol
            if symbol.visibility != 1 || sema_liveness_ignored(sema_inline_member_source_name(symbol.name)) || symbol.span.start >= symbol.span.end {
                next
            }
            sema_liveness_add_candidate(candidates, symbol.id, SemaLivenessCandidate{module_index: module_index, body: symbol.span, package_identity: module_row.package_identity, private: false})
        }
    }
    loop (source_index, checked) in modules {
        loop reference in checked.name_references {
            sema_liveness_note_site(candidates, graph, source_index, reference.symbol.id, reference.span, "")
        }
        loop call in checked.call_facts {
            callee: call.callee ?? next
            sema_liveness_note_site(candidates, graph, source_index, callee, call.span, call.caller_key)
        }
    }
    // An Output entry is an application root: the function it links (only
    // ever one visible to the Output's module) is consumed.
    loop reference in graph.output_name_references {
        row: candidates.ids.get(reference.symbol.id.id) ?? next
        candidates.reached[row] = true
    }
    member_uses: sema_liveness_member_uses(graph, modules)
    application: sema_liveness_application(graph)
    loop (module_index, module_row) in graph.modules {
        if module_row.source_origin != SemaSourceOrigin.Snapshot -> next
        start: verdicts.len()
        foreign_aliases := [String]{}
        loop edge in graph.edges {
            if edge.source_module_identity != module_row.module_identity -> next
            if edge.foreign_binding == .Val(binding) -> foreign_aliases.push(binding.alias)
        }
        sema_liveness_unused_imports(module_row.program, foreign_aliases, module_row.source_file, verdicts)
        sema_liveness_unused_bindings(modules[module_index].diagnostics, module_row.source_file, verdicts)
        loop function in module_row.functions {
            symbol: function.symbol
            row: candidates.ids.get(symbol.id.id) ?? next
            candidate: candidates.rows[row]
            if candidate.module_index != module_index || candidates.reached[row] -> next
            name: sema_inline_member_source_name(symbol.name)
            if candidate.private {
                edit: if sema_liveness_removable(function.declaration) -> TextEdit{span: function.declaration.span, new_text: ""} else -> TextEdit{span: symbol.span, new_text: "_{name}"}
                diagnostic: sema_lint("L0104", symbol.span, "Private function `{name}` is never called or used as a value.", "A private function with no reachable reference is dead code; public functions stay exempt because other modules may use them.", "Remove the function, or rename `{name}` to `_{name}` when it is intentional.")
                sema_liveness_verdict("L0104", name, module_row.source_file, symbol.span, "private function is never reached", diagnostic_with_edit(diagnostic, edit), verdicts)
            } else {
                sema_liveness_unreachable_export(name, module_row.source_file, symbol.span, verdicts)
            }
        }
        loop constant in module_row.constants {
            symbol: constant.symbol
            row: candidates.ids.get(symbol.id.id) ?? next
            if candidates.rows[row].module_index != module_index || candidates.reached[row] -> next
            sema_liveness_unreachable_export(sema_inline_member_source_name(symbol.name), module_row.source_file, symbol.span, verdicts)
        }
        sema_liveness_unreachable_reexports(graph, module_index, verdicts)
        sema_liveness_unused_members(graph, module_index, application, member_uses, verdicts)
        loop position in start..<verdicts.len() {
            verdicts[position].diagnostic = sema_liveness_located(verdicts[position].diagnostic, module_row.source_segments)
        }
    }
    verdicts.sort_by(fn(left: SemaLivenessVerdict, right: SemaLivenessVerdict) {
        source: left.fact.source <=> right.fact.source
        if source != Ordering.Equal -> source else -> {
            start: left.fact.span.start <=> right.fact.span.start
            if start != Ordering.Equal -> start else -> {
                code: left.code <=> right.code
                if code != Ordering.Equal -> code else -> left.fact.subject <=> right.fact.subject
            }
        }
    })
    result := SemaLivenessResult{diagnostics: [Diagnostic]{}, facts: [StructureFact]{}}
    loop verdict in verdicts {
        if verdict.diagnostic == .Val(found) -> result.diagnostics.push(found)
        result.facts.push(verdict.fact)
    }
    result
}

sema_liveness_unreachable_export: fn(name: String, source: String, span: Span, verdicts: &[SemaLivenessVerdict]) {
    diagnostic: sema_lint("L0105", span, "Package export `{name}` is unreachable.", "The package's explicit import graph and application roots contain no consumer for this package-scoped export; a library's public items remain open to external consumers.", "Remove the export, or rename `{name}` to `_{name}` when it is intentional.")
    sema_liveness_verdict("L0105", name, source, span, "package export is unreachable", diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: "_{name}"}), verdicts)
}

// `pub(package) use m.[name]` is reached when another module of the package
// imports `name` through this module.
sema_liveness_unreachable_reexports: fn(graph: SemaRegistrationGraph, module_index: Int, verdicts: &[SemaLivenessVerdict]) {
    module_row: graph.modules[module_index]
    loop import in module_row.imports {
        if !import.declaration.is_package_pub -> next
        if import.declaration.kind == .Unqualified(_, _, items, _, _) {
            loop (index, item) in items {
                local: sema_registration_import_local(item)
                if sema_liveness_ignored(local) -> next
                span := Span{start: 0, end: 0}
                if {
                    index < import.declaration.local_spans.len() -> {
                        span = import.declaration.local_spans[index]
                    }
                    index < import.declaration.item_spans.len() -> {
                        span = import.declaration.item_spans[index]
                    }
                }
                if span.start >= span.end -> next
                consumed: loop (consumer_index, consumer) in graph.modules {
                    if consumer_index == module_index || consumer.package_identity != module_row.package_identity {
                        next
                    }
                    found: loop candidate in consumer.imports {
                        if candidate.target_module_identity != module_row.module_identity -> next
                        hit: loop binding in candidate.bindings {
                            if binding.original == local {
                                break true
                            }
                        } ?? false
                        if hit {
                            break true
                        }
                    } ?? false
                    if found {
                        break true
                    }
                } ?? false
                if !consumed {
                    sema_liveness_unreachable_export(local, module_row.source_file, span, verdicts)
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// L0106 reports a struct field no code reads and L0107 an enum case no code
// builds. Writing a field (a struct literal, an assignment) never reads it,
// and matching a case never builds it. A field is read by an access, a
// destructuring or a pattern, and by the codec the program demands: a
// generated codec body exists only once encoding or decoding reaches the
// type, and it reads each wire field and builds each case it decodes. The
// derived equality and ordering bodies exist for every type, so they read
// only when the program compares or orders the type or hashes it (a map key
// or set element); derived printing and cloning never read. Generic code the
// type is handed to (`json.decode<T>`, a generic call), reflection (a
// `T.reflect()` record, `reflect.of`, a type a module constant names), a C
// layout and a foreign signature read every field and build every case. A
// checked `#Test` of the package reads and builds as any body does. Only
// snapshot modules are judged: an application's members, and a library's
// members unless the type and the member are public.

SemaLivenessMemberUses: struct {
    // `{owner id}:{field}` for a field read through its owner.
    fields: [String:Bool],
    // A field name read where no owner is known (an optional chain, a
    // destructuring, a pattern): every field of that name counts as read.
    field_names: [String:Bool],
    // The case ids an expression builds.
    cases: [U32:Bool],
    // `{type}.{case}` for a case built by name (a literal, a compile-time
    // value), the type by its last name segment.
    case_names: [String:Bool],
    // Types whose every field counts as read, by last name segment.
    read_types: [String:Bool],
    // Types whose every case counts as built, by last name segment.
    built_types: [String:Bool],

    empty: fn() -> SemaLivenessMemberUses Never! {
        SemaLivenessMemberUses{fields: [String:Bool]{}, field_names: [String:Bool]{}, cases: [U32:Bool]{}, case_names: [String:Bool]{}, read_types: [String:Bool]{}, built_types: [String:Bool]{}}
    }
}

// The package of the entry module when it declares `run`: an application,
// whose public members no outside consumer can read.
sema_liveness_application: fn(graph: SemaRegistrationGraph) -> String? Never! {
    loop module_row in graph.modules {
        if module_row.module_identity != graph.entry_module_identity -> next
        loop function in module_row.functions {
            if function.declaration.name == "run" -> return Val(module_row.package_identity)
        }
    }
    None
}

// Each named type `ty` holds, by last name segment.
sema_liveness_type_names: fn(ty: Type, names: &[String:Bool]) -[Mem.Alloc]> Never! {
    if ty == {
        .Named(name) -> { names[sema_call_reflection_leaf_name(name)] = true }
        .Apply(name, args) -> {
            names[sema_call_reflection_leaf_name(name)] = true
            loop arg in args -> sema_liveness_type_names(arg, names)
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Case(_, inner) | .Quantity(inner, _) -> {
            sema_liveness_type_names(inner, names)
        }
        .Map(key, _, value) | .Result(key, value) -> {
            sema_liveness_type_names(key, names)
            sema_liveness_type_names(value, names)
        }
        .Tuple(fields) -> {
            loop field in fields -> sema_liveness_type_names(field.ty, names)
        }
        .Union(members) -> {
            loop member in members -> sema_liveness_type_names(member, names)
        }
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> {}
    }
}

// The types node `id`'s checked type holds.
sema_liveness_node_type_names: fn(tree: BodyTree, id: Int, names: &[String:Bool]) -[Mem.Alloc]> Never! {
    index: checked_expr_type_id(tree.expr_types, id) ?? return
    sema_liveness_type_names(tree.types.types[index], names)
}

sema_liveness_note_field: fn(field: TFieldRef, uses: &SemaLivenessMemberUses) -[Mem.Alloc]> Never! {
    if field.owner == .Val(owner) -> uses.fields["{owner.id}:{field.name}"] = true else {
        uses.field_names[field.name] = true
    }
}

// A pattern reads the fields it names; matching a case builds nothing.
sema_liveness_pattern_uses: fn(shape: BodyPatternShape, uses: &SemaLivenessMemberUses) -[Mem.Alloc]> Never! {
    if shape == {
        .Struct(fields, _) -> {
            loop field in fields {
                if field == {
                    .Bind(name, _, _) | .Value(name, _, _) -> { uses.field_names[name] = true }
                    .Nested(name, pattern, _) -> {
                        uses.field_names[name] = true
                        sema_liveness_pattern_uses(pattern.shape, uses)
                    }
                }
            }
        }
        .Variant(_, bindings, _, _) | .List(bindings, _, _) -> {
            loop binding in bindings {
                if binding == .Nested(pattern) -> sema_liveness_pattern_uses(pattern.shape, uses)
            }
        }
        .Present(_, _, inner, _) | .Ok(_, _, inner, _) | .Err(_, _, inner, _) -> {
            if inner == .Val(pattern) -> sema_liveness_pattern_uses(pattern.shape, uses)
        }
        .Or(alternatives, _) -> {
            loop alternative in alternatives -> sema_liveness_pattern_uses(alternative, uses)
        }
        .Map(entries, _, _) -> {
            loop entry in entries {
                if entry.slot == .Nested(pattern) -> sema_liveness_pattern_uses(pattern.shape, uses)
            }
        }
        .Absent(_) | .Range(_, _, _) | .Text(_, _) | .Binary(_, _) -> {}
    }
}

sema_liveness_condition_uses: fn(condition: BodyIfCond, uses: &SemaLivenessMemberUses) -[Mem.Alloc]> Never! {
    if condition == {
        .Plain(_) -> {}
        .And(left, right) -> {
            sema_liveness_condition_uses(left, uses)
            sema_liveness_condition_uses(right, uses)
        }
        .IfLet(pattern, _) -> sema_liveness_pattern_uses(pattern.shape, uses)
    }
}

// A compile-time value builds the cases it holds; a `T.reflect()` record
// reflects `T`.
sema_liveness_comptime_uses: fn(value: TComptimeValue, uses: &SemaLivenessMemberUses) -[Mem.Alloc]> Never! {
    if value == {
        .Enum(type_name, variant, args) -> {
            uses.case_names["{sema_call_reflection_leaf_name(type_name)}.{variant}"] = true
            loop arg in args -> sema_liveness_comptime_uses(arg.value, uses)
        }
        .Struct(type_name, fields) -> {
            loop field in fields {
                if type_name == "TypeInfo" && field.name == "name" && field.value == .String(reflected) {
                    leaf: sema_call_reflection_leaf_name(reflected)
                    uses.read_types[leaf] = true
                    uses.built_types[leaf] = true
                }
                sema_liveness_comptime_uses(field.value, uses)
            }
        }
        .List(values) -> {
            loop item in values -> sema_liveness_comptime_uses(item, uses)
        }
        .Map(entries) -> {
            loop entry in entries -> sema_liveness_comptime_uses(entry.value, uses)
        }
        .Present(inner) -> sema_liveness_comptime_uses(inner, uses)
        .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .Failed(_) | .Unit | .Function(_) -> {}
    }
}

sema_liveness_compares: fn(op: TBinaryOp) -> Bool Never! {
    op == TBinaryOp.Eq || op == TBinaryOp.Ne || op == TBinaryOp.Lt || op == TBinaryOp.Gt || op == TBinaryOp.Le || op == TBinaryOp.Ge || op == TBinaryOp.Compare
}

// A type handed to generic code is read and built there: generic code reads
// a value through its contracts (equality, hashing, encoding) and builds one
// through them (decoding, a default).
sema_liveness_generic_uses: fn(type_args: [Type], uses: &SemaLivenessMemberUses) -[Mem.Alloc]> Never! {
    loop ty in type_args {
        sema_liveness_type_names(ty, uses.read_types)
        sema_liveness_type_names(ty, uses.built_types)
    }
}

sema_liveness_member_body_uses: fn(function: FnBody, uses: &SemaLivenessMemberUses) -[Mem.Alloc]> Never! {
    tree: function.tree
    // A plain assignment's target is written, not read; `+=` reads it.
    written := [Int:Bool]{}
    loop statement in tree.stmts {
        if statement == .Assign(place, op, _, _, _) && op == None && place == .Expr(target) {
            written[target] = true
        }
        if statement == .StructDestructure(_, _, _, binds, _) {
            loop bind in binds -> uses.field_names[bind.field] = true
        }
        if statement == .RefutableBind(pattern, _, _, _) {
            sema_liveness_pattern_uses(pattern.shape, uses)
        }
        if statement == .If(condition, _, _, _, _) -> sema_liveness_condition_uses(condition, uses)
        if statement == .Match(_, arms, _, _) {
            loop arm in arms -> sema_liveness_pattern_uses(arm.pattern.shape, uses)
        }
        if statement == .EnumMatch(_, arms, _, _, _) {
            loop arm in arms -> sema_liveness_pattern_uses(arm.pattern.shape, uses)
        }
    }
    loop node in tree.nodes {
        kind: node.kind
        if kind == .Field(_, field) && written.get(node.id) == None {
            sema_liveness_note_field(field, uses)
        }
        if kind == .OptField(_, member, _) -> uses.field_names[member] = true
        if kind == .PoolSlot(_, _, _, field, _, _) && field == .Val(name) {
            uses.field_names[name] = true
        }
        if kind == .SharedGuardMap(_, path, _) {
            loop field in path -> sema_liveness_note_field(field, uses)
        }
        if kind == .SharedGuardSplit(_, first, second, _) {
            loop field in first -> sema_liveness_note_field(field, uses)
            loop field in second -> sema_liveness_note_field(field, uses)
        }
        if kind == .PatternMatches(_, pattern) -> sema_liveness_pattern_uses(pattern.shape, uses)
        if kind == .IfExpr(condition, _, _, _, _) -> sema_liveness_condition_uses(condition, uses)
        if kind == .EnumCtor(_, variant, _) -> uses.cases[variant.id] = true
        if kind == .EnumLit(enum_type, variant, _) {
            uses.case_names["{sema_call_reflection_leaf_name(enum_type)}.{variant}"] = true
        }
        if kind == .CtLit(value) -> sema_liveness_comptime_uses(value, uses)
        if kind == .Binary(op, _, _, lhs, _) && sema_liveness_compares(op) {
            sema_liveness_node_type_names(tree, lhs, uses.read_types)
        }
        if kind == .CompareChain(operands, _, _) {
            loop operand in operands {
                sema_liveness_node_type_names(tree, operand, uses.read_types)
            }
        }
        if kind == .MethodCall(receiver, method, type_args, _) {
            // `a.equal(b)` and `a.compare(b)` call the derived members.
            if method.name == "equal" || method.name == "compare" {
                sema_liveness_node_type_names(tree, receiver, uses.read_types)
            }
            sema_liveness_generic_uses(type_args, uses)
        }
        if kind == .Call(_, type_args, _) -> sema_liveness_generic_uses(type_args, uses)
        if kind == .IndirectCall(_, type_args, _, _) -> sema_liveness_generic_uses(type_args, uses)
        if kind == .StaticCall(_, _, _, type_args, _) -> sema_liveness_generic_uses(type_args, uses)
        if kind == .CoreCall(record, args, _, type_args, _, _) {
            sema_liveness_generic_uses(type_args, uses)
            if sema_call_reflection_leaf_name(record.module_name) == "reflect" {
                loop arg in args {
                    sema_liveness_node_type_names(tree, arg, uses.read_types)
                    sema_liveness_node_type_names(tree, arg, uses.built_types)
                }
            }
        }
    }
    loop ty in tree.types.types {
        if ty == .Map(key, _, _) -> sema_liveness_type_names(key, uses.read_types)
        if ty == .Apply(name, args) && sema_call_reflection_leaf_name(name) == "Set" {
            loop arg in args -> sema_liveness_type_names(arg, uses.read_types)
        }
    }
}

// A type read or built with every member reads or builds the types its
// fields and cases hold: comparing, encoding, reflecting or handing a value
// to foreign code reaches them too.
sema_liveness_member_closure: fn(graph: SemaRegistrationGraph, types: &[String:Bool]) -[Mem.Alloc]> Never! {
    grew := true
    loop grew {
        before: types.len()
        loop module_row in graph.modules {
            if module_row.source_origin != SemaSourceOrigin.Snapshot -> next
            loop nominal in module_row.nominals {
                if types.get(sema_call_reflection_leaf_name(sema_inline_member_source_name(nominal.symbol.name))) == None {
                    next
                }
                loop field in nominal.fields -> sema_liveness_type_names(field.ty, types)
                loop variant in nominal.variants {
                    if variant.payload_type == .Val(payload) {
                        sema_liveness_type_names(payload, types)
                    }
                }
            }
        }
        grew = types.len() > before
    }
}

sema_liveness_member_uses: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult]) -[Mem.Alloc]> SemaLivenessMemberUses Never! {
    uses := SemaLivenessMemberUses.empty()
    loop (module_index, checked) in modules {
        module_row: graph.modules[module_index]
        // Foreign code reads and builds every type its signatures hold.
        loop foreign in module_row.foreign_functions {
            loop parameter in foreign.parameters {
                sema_liveness_type_names(parameter.ty, uses.read_types)
                sema_liveness_type_names(parameter.ty, uses.built_types)
            }
            if foreign.declaration.return_type == .Val(returned) {
                sema_liveness_type_names(returned, uses.read_types)
                sema_liveness_type_names(returned, uses.built_types)
            }
        }
        if module_row.source_origin != SemaSourceOrigin.Snapshot -> next
        // A test checked outside test mode left only its member uses.
        loop (key, _) in checked.test_member_uses.fields -> uses.fields[key] = true
        loop (name, _) in checked.test_member_uses.field_names -> uses.field_names[name] = true
        loop (id, _) in checked.test_member_uses.cases -> uses.cases[id] = true
        loop (name, _) in checked.test_member_uses.case_names -> uses.case_names[name] = true
        loop (name, _) in checked.test_member_uses.read_types -> uses.read_types[name] = true
        loop (name, _) in checked.test_member_uses.built_types -> uses.built_types[name] = true
        loop function in checked.functions {
            if function.synthetic && (function.name == "equal" || function.name == "compare") {
                next
            }
            sema_liveness_member_body_uses(function, uses)
        }
        // A constant is made while compiling: its value builds the cases its
        // type holds, and a type its initializer names (`T.reflect()`) is
        // reflected.
        loop constant in module_row.constants {
            if constant.ty == .Val(ty) -> sema_liveness_type_names(ty, uses.built_types)
            loop site in comptime_walk_identifiers(constant.declaration.value) {
                leaf: sema_call_reflection_leaf_name(site.name)
                uses.read_types[leaf] = true
                uses.built_types[leaf] = true
            }
        }
        loop nominal in module_row.nominals {
            // A field default builds what its type holds wherever a literal
            // leaves the field out.
            loop field in nominal.fields {
                if field.default != None -> sema_liveness_type_names(field.ty, uses.built_types)
            }
            if nominal.source == .SourceAST(item) && item == .Struct(definition) {
                loop block in definition.trait_impls {
                    if block.delegation_field == .Val(field) -> uses.field_names[field] = true
                }
            }
        }
        loop implementation in module_row.impls {
            if implementation.delegation_field == .Val(field) -> uses.field_names[field] = true
        }
    }
    sema_liveness_member_closure(graph, uses.read_types)
    sema_liveness_member_closure(graph, uses.built_types)
    uses
}

sema_liveness_unused_members: fn(graph: SemaRegistrationGraph, module_index: Int, application: String?, uses: SemaLivenessMemberUses, verdicts: &[SemaLivenessVerdict]) -[Mem.Alloc]> Never! {
    module_row: graph.modules[module_index]
    judge_pub: if application == .Val(package) -> package == module_row.package_identity else -> false
    loop nominal in module_row.nominals {
        if nominal.compiler_owned || nominal.generated_provenance != None -> next
        type_name: sema_call_reflection_leaf_name(sema_inline_member_source_name(nominal.symbol.name))
        if sema_liveness_ignored(type_name) || nominal.symbol.span.start >= nominal.symbol.span.end {
            next
        }
        if nominal.source == .SourceAST(item) {
            if item == .Struct(definition) {
                if definition.is_published_schema || uses.read_types.get(type_name) != None -> next
                if definition.layout == .Val(.C) || definition.layout == .Val(.CAligned(_, _)) {
                    next
                }
                loop field in nominal.fields {
                    symbol: field.symbol
                    name: sema_call_reflection_leaf_name(symbol.name)
                    if field.computed || sema_liveness_ignored(name) || symbol.span.start >= symbol.span.end {
                        next
                    }
                    if !judge_pub && nominal.symbol.visibility > 1 && symbol.visibility > 1 -> next
                    if uses.fields.get("{nominal.symbol.id.id}:{name}") != None || uses.field_names.get(name) != None {
                        next
                    }
                    diagnostic: sema_lint("L0106", symbol.span, "Field `{type_name}.{name}` is never read.", "Code may write this field, but nothing reads it, so it carries data no part of the program uses. Encoding, derived equality or ordering, reflection and foreign code count as reads; derived printing and cloning do not.", "Remove the field, or rename `{name}` to `_{name}` when it is intentional.")
                    sema_liveness_verdict("L0106", "{type_name}.{name}", module_row.source_file, symbol.span, "field is never read", diagnostic_with_edit(diagnostic, TextEdit{span: symbol.span, new_text: "_{name}"}), verdicts)
                }
            }
            if item == .Enum(definition) {
                if uses.built_types.get(type_name) != None || jet_target_layout_enum_backing(definition) != None || jet_target_layout_enum_c_tag(definition) != None {
                    next
                }
                loop variant in nominal.variants {
                    symbol: variant.symbol
                    name: sema_call_reflection_leaf_name(symbol.name)
                    if sema_liveness_ignored(name) || symbol.span.start >= symbol.span.end -> next
                    if !judge_pub && nominal.symbol.visibility > 1 && symbol.visibility > 1 -> next
                    if uses.cases.get(symbol.id.id) != None || uses.case_names.get("{type_name}.{name}") != None {
                        next
                    }
                    diagnostic: sema_lint("L0107", symbol.span, "Case `{type_name}.{name}` is never built.", "Code may match this case, but nothing creates it, so the arms that handle it never run. Decoding and foreign code count as building it; matching does not.", "Remove the case, or rename `{name}` to `_{name}` when it is intentional.")
                    sema_liveness_verdict("L0107", "{type_name}.{name}", module_row.source_file, symbol.span, "case is never built", diagnostic_with_edit(diagnostic, TextEdit{span: symbol.span, new_text: "_{name}"}), verdicts)
                }
            }
        }
    }
}
