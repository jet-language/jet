// L0103 reports a private import whose
// local name the file never reads. The parser records which import names the
// file spells outside its import declarations (`Program.used_import_names`),
// so every spelled read counts, including impl heads (`impl Local.types.Named`,
// ), `comptime` bodies and interpolations. C headers stay outside
// liveness because importing a bridge can have link-time meaning even when no
// Jet name is read; foreign bindings stay outside for the same reason.
use jet_foundation.[
    Diagnostic,
    Func,
    Program,
    Span,
    TextEdit,
    StructureFact,
    StructureFactKind,
    diagnostic_with_edit,
]

struct SemaLivenessVerdict {
    code: String
    diagnostic: Diagnostic
    fact: StructureFact
}

struct SemaLivenessResult {
    diagnostics: [Diagnostic]
    facts: [StructureFact]
}

fn sema_liveness_verdict(code: String, name: String, source: String, span: Span, detail: String, diagnostic: Diagnostic, verdicts: &[SemaLivenessVerdict]) Never! {
    &verdicts.push(SemaLivenessVerdict{
        code: code,
        diagnostic: diagnostic,
        fact: StructureFact{kind: StructureFactKind.Liveness, subject: name, source: source, span: span, status: "unreachable", detail: detail, gate: None},
    })
}

fn sema_liveness_unused_imports(program: Program, foreign_aliases: [String], source: String, verdicts: &[SemaLivenessVerdict]) {
    loop declaration in program.imports {
        if declaration.is_pub || declaration.is_package_pub -> next
        if declaration.kind == {
            .File(path, _) -> {
                if path.ends_with(".h") -> next
                explicit_alias :: declaration.alias_span.start > declaration.span.start
                span :: if explicit_alias -> declaration.alias_span else -> declaration.span
                edit :: if explicit_alias -> TextEdit{span: span, new_text: "_{declaration.alias}"} else -> TextEdit{span: span, new_text: ""}
                sema_liveness_note_import(program, foreign_aliases, declaration.alias, source, span, edit, &verdicts)
            }
            .Module(_, path_span) -> {
                // `use core.files as files` renames the alias; an unaliased
                // path import is removed whole.
                explicit_alias :: declaration.alias_span.start >= path_span.end
                span :: if explicit_alias -> declaration.alias_span else -> Span{start: path_span.end - declaration.alias.len(), end: path_span.end}
                edit :: if explicit_alias -> TextEdit{span: span, new_text: "_{declaration.alias}"} else -> TextEdit{span: declaration.span, new_text: ""}
                sema_liveness_note_import(program, foreign_aliases, declaration.alias, source, span, edit, &verdicts)
            }
            .Unqualified(_, module_alias_span, items, _, _) -> {
                loop (index, item) in items {
                    local :: sema_registration_import_local(item)
                    span := module_alias_span
                    if {
                        index < declaration.local_spans.len() -> span = declaration.local_spans[index]
                        index < declaration.item_spans.len() -> span = declaration.item_spans[index]
                    }
                    // A member without `as` keeps its path: `mem` becomes `mem as _mem`.
                    replacement :: if item.alias == None -> "{local} as _{local}" else -> "_{local}"
                    sema_liveness_note_import(program, foreign_aliases, local, source, span, TextEdit{span: span, new_text: replacement}, &verdicts)
                }
            }
        }
    }
}

fn sema_liveness_note_import(program: Program, foreign_aliases: [String], name: String, source: String, span: Span, edit: TextEdit, verdicts: &[SemaLivenessVerdict]) Never! {
    if name == "" || name.starts_with("_") || span.start >= span.end -> return
    if program.used_import_names.contains(name) || foreign_aliases.contains(name) -> return
    diagnostic :: sema_lint("L0103", span, "Import `{name}` is never used.", "An unused import adds a name and dependency to the file without contributing to checked code.", "Remove the import, or rename `{name}` to `_{name}` when the import is intentionally kept.")
    sema_liveness_verdict("L0103", name, source, span, "import is never read", diagnostic_with_edit(diagnostic, edit), &verdicts)
}

// ---------------------------------------------------------------------------
// (Rust `Bundle/Liveness.rs`): L0104 reports a private
// top-level function that no reference reaches from outside its own body (a
// namespace package's sibling files count as callers); L0105 reports a
// `pub(package)` function or constant, or a `pub(package)` re-export, that no
// other module of its package consumes. Roots (the entry `run`, the build
// entry, jobs, wasm exports) are never reported. Only snapshot (user) modules
// are judged; every module's references count.

struct SemaLivenessCandidate {
    module_index: Int
    body: Span
    package_identity: String
    private: Bool
}

fn sema_liveness_ignored(name: String) -> Bool Never! {
    name == "" || name.starts_with("_") || name.starts_with("__jet_")
}

fn sema_liveness_is_root(function: Func, is_entry: Bool) -> Bool Never! {
    if function.name == "build" && function.params.len() == 1 {
        if function.params[0].ty == .Named(name) {
            if name == "Build" -> return true
        }
    }
    if function.name == "dev" && function.params.len() == 1 {
        if function.params[0].ty == .Named(name) {
            if name == "Dev" -> return true
        }
    }
    if function.is_job || function.web_marker == .Val(.WasmExport) -> return true
    is_entry && function.name == "run"
}

// Rust `removable_private_function`: only a bodiless, unmarked function is
// deleted by the fix; anything else is renamed to `_name`.
fn sema_liveness_removable(function: Func) -> Bool Never! {
    function.body.len() == 0 && function.meta == None && function.markers.len() == 0 && function.external_type == None && function.inline_foreign == None && function.undo == None && function.web_marker == None && function.pre.len() == 0 && function.post.len() == 0 && !function.compiler_generated && !function.is_unsafe && !function.is_pure && !function.is_reactive && !function.is_replayable && !function.is_job && function.every == None && !function.is_must_use && function.kernel == None
}

fn sema_liveness_note_site(candidates: [String:SemaLivenessCandidate], reached: &[String:Bool], graph: SemaRegistrationGraph, source_index: Int, key: String, site: Span, caller_key: String) Never! {
    candidate :: candidates.get(key) ?? return
    if source_index == candidate.module_index {
        // Specialization can carry a sibling's call site into this module's
        // checked rows. Byte offsets from two files are not caller identities.
        if candidate.private {
            if caller_key != "" {
                if caller_key == key -> return
            } else {
                if site.start >= candidate.body.start && site.end <= candidate.body.end -> return
            }
        }
        if candidate.private -> reached[key] = true
        return
    }
    if graph.modules[source_index].package_identity != candidate.package_identity -> return
    if !candidate.private || sema_registration_package_is_namespace(candidate.package_identity) -> reached[key] = true
}

fn sema_liveness_structure(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult]) -> SemaLivenessResult {
    verdicts := [SemaLivenessVerdict]{}
    if modules.len() != graph.modules.len() -> return SemaLivenessResult{diagnostics: [Diagnostic]{}, facts: [StructureFact]{}}
    candidates := [String:SemaLivenessCandidate]{}
    loop (module_index, module_row) in graph.modules {
        if module_row.source_origin != SemaSourceOrigin.Snapshot -> next
        is_entry :: module_row.module_identity == graph.entry_module_identity
        loop function in module_row.functions {
            symbol :: function.symbol
            if symbol.visibility > 1 || sema_liveness_ignored(symbol.name) || symbol.span.start >= symbol.span.end -> next
            if sema_liveness_is_root(function.declaration, is_entry) -> next
            candidates[symbol.id.key] = SemaLivenessCandidate{module_index: module_index, body: function.declaration.span, package_identity: module_row.package_identity, private: symbol.visibility == 0}
        }
        loop constant in module_row.constants {
            symbol :: constant.symbol
            if symbol.visibility != 1 || sema_liveness_ignored(symbol.name) || symbol.span.start >= symbol.span.end -> next
            candidates[symbol.id.key] = SemaLivenessCandidate{module_index: module_index, body: symbol.span, package_identity: module_row.package_identity, private: false}
        }
    }
    reached := [String:Bool]{}
    loop (source_index, checked) in modules {
        loop reference in checked.name_references -> sema_liveness_note_site(candidates, &reached, graph, source_index, reference.symbol.id.key, reference.span, "")
        loop call in checked.call_facts {
            callee :: call.callee ?? next
            sema_liveness_note_site(candidates, &reached, graph, source_index, callee.key, call.span, call.caller_key)
        }
    }
    loop (module_index, module_row) in graph.modules {
        if module_row.source_origin != SemaSourceOrigin.Snapshot -> next
        start :: verdicts.len()
        foreign_aliases := [String]{}
        loop edge in graph.edges {
            if edge.source_module_identity != module_row.module_identity -> next
            if edge.foreign_binding == .Val(binding) -> &foreign_aliases.push(binding.alias)
        }
        sema_liveness_unused_imports(module_row.program, foreign_aliases, module_row.module_path, &verdicts)
        loop function in module_row.functions {
            symbol :: function.symbol
            candidate :: candidates.get(symbol.id.key) ?? next
            if candidate.module_index != module_index || reached.get(symbol.id.key) != None -> next
            if candidate.private {
                edit :: if sema_liveness_removable(function.declaration) -> TextEdit{span: function.declaration.span, new_text: ""} else -> TextEdit{span: symbol.span, new_text: "_{symbol.name}"}
                diagnostic :: sema_lint("L0104", symbol.span, "Private function `{symbol.name}` is never called or used as a value.", "A private function with no reachable reference is dead code; public functions stay exempt because other modules may use them.", "Remove the function, or rename `{symbol.name}` to `_{symbol.name}` when it is intentional.")
                sema_liveness_verdict("L0104", symbol.name, module_row.module_path, symbol.span, "private function is never reached", diagnostic_with_edit(diagnostic, edit), &verdicts)
            } else {
                sema_liveness_unreachable_export(symbol.name, module_row.module_path, symbol.span, &verdicts)
            }
        }
        loop constant in module_row.constants {
            symbol :: constant.symbol
            candidate :: candidates.get(symbol.id.key) ?? next
            if candidate.module_index != module_index || reached.get(symbol.id.key) != None -> next
            sema_liveness_unreachable_export(symbol.name, module_row.module_path, symbol.span, &verdicts)
        }
        sema_liveness_unreachable_reexports(graph, module_index, &verdicts)
        loop position in start..<verdicts.len() {
            verdicts[position].diagnostic = sema_diagnostic_with_source_location(verdicts[position].diagnostic, module_row.source_segments)
        }
    }
    &verdicts.sort_by((left: SemaLivenessVerdict, right: SemaLivenessVerdict) -> {
        source :: left.fact.source <=> right.fact.source
        if source != Ordering.Equal -> source else -> {
            start :: left.fact.span.start <=> right.fact.span.start
            if start != Ordering.Equal -> start else -> {
                code :: left.code <=> right.code
                if code != Ordering.Equal -> code else -> left.fact.subject <=> right.fact.subject
            }
        }
    })
    result := SemaLivenessResult{diagnostics: [Diagnostic]{}, facts: [StructureFact]{}}
    loop verdict in verdicts {
        &result.diagnostics.push(verdict.diagnostic)
        &result.facts.push(verdict.fact)
    }
    result
}

fn sema_liveness_unreachable_export(name: String, source: String, span: Span, verdicts: &[SemaLivenessVerdict]) {
    diagnostic :: sema_lint("L0105", span, "Package export `{name}` is unreachable.", "The package's explicit import graph and application roots contain no consumer for this package-scoped export; a library's public items remain open to external consumers.", "Remove the export, or rename `{name}` to `_{name}` when it is intentional.")
    sema_liveness_verdict("L0105", name, source, span, "package export is unreachable", diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: "_{name}"}), &verdicts)
}

// `pub(package) use m.[name]` is reached when another module of the package
// imports `name` through this module.
fn sema_liveness_unreachable_reexports(graph: SemaRegistrationGraph, module_index: Int, verdicts: &[SemaLivenessVerdict]) {
    module_row :: graph.modules[module_index]
    loop import in module_row.imports {
        if !import.declaration.is_package_pub -> next
        if import.declaration.kind == .Unqualified(_, _, items, _, _) {
            loop (index, item) in items {
                local :: sema_registration_import_local(item)
                if sema_liveness_ignored(local) -> next
                span := Span{start: 0, end: 0}
                if {
                    index < import.declaration.local_spans.len() -> span = import.declaration.local_spans[index]
                    index < import.declaration.item_spans.len() -> span = import.declaration.item_spans[index]
                }
                if span.start >= span.end -> next
                consumed :: loop (consumer_index, consumer) in graph.modules {
                    if consumer_index == module_index || consumer.package_identity != module_row.package_identity -> next
                    found :: loop candidate in consumer.imports {
                        if candidate.target_module_identity != module_row.module_identity -> next
                        hit :: loop binding in candidate.bindings {
                            if binding.original == local -> break true
                        } ?? false
                        if hit -> break true
                    } ?? false
                    if found -> break true
                } ?? false
                if !consumed -> sema_liveness_unreachable_export(local, module_row.module_path, span, &verdicts)
            }
        }
    }
}
