// L0103 reports a private import whose
// local name the file never reads. The parser records which import names the
// file spells outside its import declarations (`Program.used_import_names`),
// so every spelled read counts, including impl heads (`impl Local.types.Named`,
// ), `comptime` bodies and interpolations. C headers stay outside
// liveness because importing a bridge can have link-time meaning even when no
// Jet name is read; foreign bindings stay outside for the same reason.
use jet_foundation.[
    Diagnostic,
    Func,
    NameRows,
    Program,
    Span,
    TextEdit,
    StructureFact,
    StructureFactKind,
    diagnostic_with_edit,
    name_rows,
    name_rows_get_text,
    name_rows_set,
]

SemaLivenessVerdict: struct {
    code: String
    diagnostic: Diagnostic
    fact: StructureFact
}

SemaLivenessResult: struct {
    diagnostics: [Diagnostic]
    facts: [StructureFact]
}

sema_liveness_verdict: fn(code: String, name: String, source: String, span: Span, detail: String, diagnostic: Diagnostic, verdicts: &[SemaLivenessVerdict]) Never! {
    verdicts.push(SemaLivenessVerdict{
        code: code,
        diagnostic: diagnostic,
        fact: StructureFact{kind: StructureFactKind.Liveness, subject: name, source: source, span: span, status: "unreachable", detail: detail, gate: None},
    })
}

sema_liveness_unused_imports: fn(program: Program, foreign_aliases: [String], source: String, verdicts: &[SemaLivenessVerdict]) {
    loop declaration in program.imports {
        if declaration.is_pub || declaration.is_package_pub -> next
        if declaration.kind == {
            .File(path, path_span) -> {
                if path.ends_with(".h") -> next
                // `use helper: "./helper"` renames the alias, written before
                // the path; an unaliased file import is removed whole.
                explicit_alias: declaration.alias_span.end <= path_span.start
                span: if explicit_alias -> declaration.alias_span else -> declaration.span
                edit: if explicit_alias -> TextEdit{span: span, new_text: "_{declaration.alias}"} else -> TextEdit{span: span, new_text: ""}
                sema_liveness_note_import(program, foreign_aliases, declaration.alias, source, span, Val(edit), verdicts)
            }
            .Module(_, path_span) -> {
                // `use files: core.files` renames the alias, written before
                // the path; an unaliased path import is removed whole.
                explicit_alias: declaration.alias_span.end <= path_span.start
                span: if explicit_alias -> declaration.alias_span else -> Span{start: path_span.end - declaration.alias.len(), end: path_span.end}
                edit: if explicit_alias -> TextEdit{span: span, new_text: "_{declaration.alias}"} else -> TextEdit{span: declaration.span, new_text: ""}
                sema_liveness_note_import(program, foreign_aliases, declaration.alias, source, span, Val(edit), verdicts)
            }
            .Unqualified(module_alias, module_alias_span, items, _, _) -> {
                loop (index, item) in items {
                    local: sema_registration_import_local(item)
                    span := module_alias_span
                    item_span := module_alias_span
                    if index < declaration.item_spans.len() -> item_span = declaration.item_spans[index]
                    if {
                        index < declaration.local_spans.len() -> span = declaration.local_spans[index]
                        index < declaration.item_spans.len() -> span = item_span
                    }
                    // An alias written before the path (`biggest: numeric.max`)
                    // is renamed in place; the dotted member row `owner.member`
                    // becomes the alias row `_member: owner.member`. A member
                    // of a `.[…]` list has no alias to rename, so the lint
                    // carries no edit there.
                    edit := TextEdit?{None}
                    if {
                        item.alias != None || span.end <= module_alias_span.start -> edit = Val(TextEdit{span: span, new_text: "_{local}"})
                        items.len() == 1 && item_span.start == module_alias_span.end + 1 -> edit = Val(TextEdit{span: Span{start: module_alias_span.start, end: item_span.end}, new_text: "_{local}: {module_alias}.{item.original}"})
                    }
                    sema_liveness_note_import(program, foreign_aliases, local, source, span, edit, verdicts)
                }
            }
        }
    }
}

sema_liveness_note_import: fn(program: Program, foreign_aliases: [String], name: String, source: String, span: Span, edit: TextEdit?, verdicts: &[SemaLivenessVerdict]) Never! {
    if name == "" || name.starts_with("_") || span.start >= span.end -> return
    if program.used_import_names.contains(name) || foreign_aliases.contains(name) -> return
    diagnostic := sema_lint("L0103", span, "Import `{name}` is never used.", "An unused import adds a name and dependency to the file without contributing to checked code.", "Remove the import, or rename `{name}` to `_{name}` when the import is intentionally kept.")
    if edit == .Val(fix) {
        diagnostic = diagnostic_with_edit(diagnostic, fix)
    }
    sema_liveness_verdict("L0103", name, source, span, "import is never read", diagnostic, verdicts)
}

// An inline `#FFI(asm)` body is the `core.mem` import's reader: the import is
// its discovery gate (E3102), so it stays live though no Jet name spells it.
// The gate import is found the way `sema_function_header_inline_has_core_mem`
// finds it.
sema_liveness_inline_asm_gate_aliases: fn(module_row: SemaRegistrationModule, aliases: &[String]) Never! {
    has_asm := false
    loop function in module_row.functions {
        if function.declaration.inline_foreign == .Val(inline) {
            if sema_checked_ascii_lower(inline.lang) == "asm" -> has_asm = true
        }
    }
    if !has_asm -> return
    loop declaration in module_row.program.imports {
        if declaration.kind == {
            .Module(name, _) -> {
                if name == "core.mem" -> aliases.push(declaration.alias)
            }
            .Unqualified(module_alias, _, items, _, _) -> {
                loop item in items {
                    if module_alias == "core.mem" || "{module_alias}.{item.original}" == "core.mem" -> aliases.push(sema_registration_import_local(item))
                }
            }
            .File(_, _) -> {}
        }
    }
}

// ---------------------------------------------------------------------------:
// L0104 reports a function of a `priv module` that no reference reaches from
// outside its own body (a namespace package's sibling files count as callers);
// L0105 reports a function or constant of a `priv(package) module`, or a
// `pub(package)` re-export, that no other module of its package consumes. An
// inline module's members are lifted under generated `__jet_` names, so they
// are judged and reported by their source names. Roots (the entry `run`, the
// build entry, jobs, wasm exports) are never reported. Only snapshot (user)
// modules are judged; every module's references count.

SemaLivenessCandidate: struct {
    module_index: Int
    body: Span
    package_identity: String
    private: Bool
}

// The candidates by symbol ID key: `keys` maps a key to its row in `rows`
// and `reached` (an open-addressing hash, not a String-ordered map, since
// every reference and call fact of the program looks its callee up here).
// A later candidate of the same key replaces the earlier one in its row.
SemaLivenessCandidates: struct {
    keys: NameRows
    rows: [SemaLivenessCandidate]
    reached: [Bool]
}

sema_liveness_add_candidate: fn(candidates: &SemaLivenessCandidates, key: String, candidate: &&SemaLivenessCandidate) Never! {
    if name_rows_get_text(candidates.keys, key) == .Val(row) {
        candidates.rows[row] = candidate.move()
        return
    }
    name_rows_set(candidates.keys, key, candidates.rows.len())
    candidates.rows.push(candidate)
    candidates.reached.push(false)
}

// `name` is the source name: an inline module member's lifted `__jet_` name
// is decoded first, so only truly compiler-generated names stay ignored.
sema_liveness_ignored: fn(name: String) -> Bool Never! {
    name == "" || name.starts_with("_") || name.starts_with("__jet_")
}

sema_liveness_is_root: fn(function: Func, is_entry: Bool) -> Bool Never! {
    if function.name == "build" && function.params.len() == 1 {
        if function.params[0].ty == .Named(name) {
            if name == "Build" -> return true
        }
    }
    if function.name == "dev" && function.params.len() == 1 {
        if function.params[0].ty == .Named(name) {
            if name == "Dev" -> return true
        }
    }
    if function.is_job || function.web_marker == .Val(.WasmExport) -> return true
    // A declared `impl Source -> Target` is used by the fallible calls whose
    // failure it converts, which leave no call site or name reference; like
    // any impl it is not dead code.
    if sema_is_error_conversion_function(function) -> return true
    is_entry && function.name == "run"
}

// Rust `removable_private_function`: only a bodiless, unmarked function is
// deleted by the fix; anything else is renamed to `_name`.
sema_liveness_removable: fn(function: Func) -> Bool Never! {
    function.body.len() == 0 && function.meta == None && function.markers.len() == 0 && function.external_type == None && function.inline_foreign == None && function.undo == None && function.web_marker == None && function.pre.len() == 0 && function.post.len() == 0 && !function.compiler_generated && !function.is_unsafe && !function.is_pure && !function.is_reactive && !function.is_replayable && !function.is_job && function.every == None && !function.is_must_use && function.kernel == None
}

sema_liveness_note_site: fn(candidates: &SemaLivenessCandidates, graph: SemaRegistrationGraph, source_index: Int, key: String, site: Span, caller_key: String) Never! {
    row: name_rows_get_text(candidates.keys, key) ?? return
    candidate: candidates.rows[row]
    if source_index == candidate.module_index {
        // Specialization can carry a sibling's call site into this module's
        // checked rows. Byte offsets from two files are not caller identities.
        if candidate.private {
            if caller_key != "" {
                if caller_key == key -> return
            } else {
                if site.start >= candidate.body.start && site.end <= candidate.body.end -> return
            }
        }
        if candidate.private -> candidates.reached[row] = true
        return
    }
    if graph.modules[source_index].package_identity != candidate.package_identity -> return
    if !candidate.private || sema_registration_package_is_namespace(candidate.package_identity) -> candidates.reached[row] = true
}

sema_liveness_structure: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult]) -> SemaLivenessResult {
    verdicts := [SemaLivenessVerdict]{}
    if modules.len() != graph.modules.len() -> return SemaLivenessResult{diagnostics: [Diagnostic]{}, facts: [StructureFact]{}}
    candidates := SemaLivenessCandidates{keys: name_rows(), rows: [SemaLivenessCandidate]{}, reached: [Bool]{}}
    loop (module_index, module_row) in graph.modules {
        if module_row.source_origin != SemaSourceOrigin.Snapshot -> next
        is_entry: module_row.module_identity == graph.entry_module_identity
        loop function in module_row.functions {
            symbol: function.symbol
            if symbol.visibility > 1 || sema_liveness_ignored(sema_inline_member_source_name(symbol.name)) || symbol.span.start >= symbol.span.end -> next
            // A runtime binding is the jet.runtime interface's member: Core,
            // not the runtime package, calls a `priv` one (#6615).
            if sema_liveness_is_root(function.declaration, is_entry) || sema_guest_runtime_binding(module_row.package_identity, function.declaration) -> next
            sema_liveness_add_candidate(candidates, symbol.id.key, SemaLivenessCandidate{module_index: module_index, body: function.declaration.span, package_identity: module_row.package_identity, private: symbol.visibility == 0})
        }
        loop constant in module_row.constants {
            symbol: constant.symbol
            if symbol.visibility != 1 || sema_liveness_ignored(sema_inline_member_source_name(symbol.name)) || symbol.span.start >= symbol.span.end -> next
            sema_liveness_add_candidate(candidates, symbol.id.key, SemaLivenessCandidate{module_index: module_index, body: symbol.span, package_identity: module_row.package_identity, private: false})
        }
    }
    loop (source_index, checked) in modules {
        loop reference in checked.name_references -> sema_liveness_note_site(candidates, graph, source_index, reference.symbol.id.key, reference.span, "")
        loop call in checked.call_facts {
            callee: call.callee ?? next
            sema_liveness_note_site(candidates, graph, source_index, callee.key, call.span, call.caller_key)
        }
    }
    // An Output entry is an application root: the function it links (only
    // ever one visible to the Output's module) is consumed.
    loop reference in graph.output_name_references {
        row: name_rows_get_text(candidates.keys, reference.symbol.id.key) ?? next
        candidates.reached[row] = true
    }
    loop (module_index, module_row) in graph.modules {
        if module_row.source_origin != SemaSourceOrigin.Snapshot -> next
        start: verdicts.len()
        foreign_aliases := [String]{}
        loop edge in graph.edges {
            if edge.source_module_identity != module_row.module_identity -> next
            if edge.foreign_binding == .Val(binding) -> foreign_aliases.push(binding.alias)
        }
        sema_liveness_inline_asm_gate_aliases(module_row, foreign_aliases)
        sema_liveness_unused_imports(module_row.program, foreign_aliases, module_row.source_file, verdicts)
        loop function in module_row.functions {
            symbol: function.symbol
            row: name_rows_get_text(candidates.keys, symbol.id.key) ?? next
            candidate: candidates.rows[row]
            if candidate.module_index != module_index || candidates.reached[row] -> next
            name: sema_inline_member_source_name(symbol.name)
            if candidate.private {
                edit: if sema_liveness_removable(function.declaration) -> TextEdit{span: function.declaration.span, new_text: ""} else -> TextEdit{span: symbol.span, new_text: "_{name}"}
                diagnostic: sema_lint("L0104", symbol.span, "Private function `{name}` is never called or used as a value.", "A private function with no reachable reference is dead code; public functions stay exempt because other modules may use them.", "Remove the function, or rename `{name}` to `_{name}` when it is intentional.")
                sema_liveness_verdict("L0104", name, module_row.source_file, symbol.span, "private function is never reached", diagnostic_with_edit(diagnostic, edit), verdicts)
            } else {
                sema_liveness_unreachable_export(name, module_row.source_file, symbol.span, verdicts)
            }
        }
        loop constant in module_row.constants {
            symbol: constant.symbol
            row: name_rows_get_text(candidates.keys, symbol.id.key) ?? next
            if candidates.rows[row].module_index != module_index || candidates.reached[row] -> next
            sema_liveness_unreachable_export(sema_inline_member_source_name(symbol.name), module_row.source_file, symbol.span, verdicts)
        }
        sema_liveness_unreachable_reexports(graph, module_index, verdicts)
        loop position in start..<verdicts.len() {
            verdicts[position].diagnostic = sema_diagnostic_with_source_location(verdicts[position].diagnostic, module_row.source_segments)
        }
    }
    verdicts.sort_by((left: SemaLivenessVerdict, right: SemaLivenessVerdict) -> {
        source: left.fact.source <=> right.fact.source
        if source != Ordering.Equal -> source else -> {
            start: left.fact.span.start <=> right.fact.span.start
            if start != Ordering.Equal -> start else -> {
                code: left.code <=> right.code
                if code != Ordering.Equal -> code else -> left.fact.subject <=> right.fact.subject
            }
        }
    })
    result := SemaLivenessResult{diagnostics: [Diagnostic]{}, facts: [StructureFact]{}}
    loop verdict in verdicts {
        result.diagnostics.push(verdict.diagnostic)
        result.facts.push(verdict.fact)
    }
    result
}

sema_liveness_unreachable_export: fn(name: String, source: String, span: Span, verdicts: &[SemaLivenessVerdict]) {
    diagnostic: sema_lint("L0105", span, "Package export `{name}` is unreachable.", "The package's explicit import graph and application roots contain no consumer for this package-scoped export; a library's public items remain open to external consumers.", "Remove the export, or rename `{name}` to `_{name}` when it is intentional.")
    sema_liveness_verdict("L0105", name, source, span, "package export is unreachable", diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: "_{name}"}), verdicts)
}

// `pub(package) use m.[name]` is reached when another module of the package
// imports `name` through this module.
sema_liveness_unreachable_reexports: fn(graph: SemaRegistrationGraph, module_index: Int, verdicts: &[SemaLivenessVerdict]) {
    module_row: graph.modules[module_index]
    loop import in module_row.imports {
        if !import.declaration.is_package_pub -> next
        if import.declaration.kind == .Unqualified(_, _, items, _, _) {
            loop (index, item) in items {
                local: sema_registration_import_local(item)
                if sema_liveness_ignored(local) -> next
                span := Span{start: 0, end: 0}
                if {
                    index < import.declaration.local_spans.len() -> span = import.declaration.local_spans[index]
                    index < import.declaration.item_spans.len() -> span = import.declaration.item_spans[index]
                }
                if span.start >= span.end -> next
                consumed: loop (consumer_index, consumer) in graph.modules {
                    if consumer_index == module_index || consumer.package_identity != module_row.package_identity -> next
                    found: loop candidate in consumer.imports {
                        if candidate.target_module_identity != module_row.module_identity -> next
                        hit: loop binding in candidate.bindings {
                            if binding.original == local -> break true
                        } ?? false
                        if hit -> break true
                    } ?? false
                    if found -> break true
                } ?? false
                if !consumed -> sema_liveness_unreachable_export(local, module_row.source_file, span, verdicts)
            }
        }
    }
}
