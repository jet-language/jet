// E0307: an else-less all-pattern table must cover its subject's whole type.
// One policy serves the statement table (`if x == { … }` as a statement), the
// value dispatch chain that ends in `NoElse`, and multi-head functions. It
// reads the checked conditions, so contextual `.Case` heads are already
// resolved against the subject type.
use jet_foundation.[
    Diagnostic,
    ElseArmSpan,
    Expr,
    Span,
    Stmt,
    TextEdit,
    TBinaryOp,
    Type,
    core_enum_payload_variants,
    core_enum_variants,
    diagnostic_with_edit,
    expr_span,
    measure_literal_value,
    type_name,
]

SemaCoverageTable: struct {
    subject: TExpr
    shapes: [TPatternShape]
}

// The pattern shape's contribution to the covered set. A variant with a range
// payload slot matches only part of that variant, so it covers nothing; an
// S31 nested payload pattern is proved separately by `sema_coverage_keys`.
sema_coverage_shape_keys: fn(shape: TPatternShape, keys: &[String], ranges: &[SemaIntegerRange]) {
    if sema_coverage_nested_part(shape) != None -> return
    if shape == {
        .Variant(variant, bindings, _, _) -> {
            loop binding in bindings {
                if binding == {
                    .Range(_, _) | .Nested(_) | .Value(_) -> return
                    .Wildcard | .Bind(_, _) -> {}
                }
            }
            keys.push(variant.copy())
        }
        .Present(_, _, _, _) -> keys.push("Val")
        .Absent(_) -> keys.push("None")
        .Ok(_, _, _, _) -> keys.push("Ok")
        .Err(_, _, _, _) -> keys.push("Err")
        .Range(lo, hi, _) -> ranges.push(SemaIntegerRange{lo: lo, hi: hi})
        .Or(alternatives, _) -> loop alternative in alternatives -> sema_coverage_shape_keys(alternative, keys, ranges)
        .Struct(_, _) | .List(_, _, _) | .Map(_, _, _) | .Text(_, _) | .Binary(_, _) -> {}
    }
}

// S31: the head key, payload field and nested shape of a partial arm. A case
// with several payload fields is partial on one field when that field holds
// the only nested pattern and every other field is a binding or `_`
// (`.FailedToFetch{url, cause: .BadURL(why)}`).
sema_coverage_nested_part: fn(shape: TPatternShape) -> (key: String, field: Int, inner: TPatternShape)? {
    if shape == {
        .Present(_, _, inner, _) -> if inner == .Val(nested) -> return Val((inner: nested.shape, field: 0, key: "Val"))
        .Ok(_, _, inner, _) -> if inner == .Val(nested) -> return Val((inner: nested.shape, field: 0, key: "Ok"))
        .Err(_, _, inner, _) -> if inner == .Val(nested) -> return Val((inner: nested.shape, field: 0, key: "Err"))
        .Variant(variant, bindings, _, _) -> {
            nested_field := -1
            loop index in 0..<bindings.len() {
                if bindings[index] == {
                    .Wildcard | .Bind(_, _) -> {}
                    .Nested(_) -> {
                        if nested_field >= 0 -> return None
                        nested_field = index
                    }
                    .Range(_, _) | .Value(_) -> return None
                }
            }
            if nested_field >= 0 {
                if bindings[nested_field] == .Nested(nested) -> return Val((inner: nested.shape, field: nested_field, key: variant))
            }
        }
        .Absent(_) | .Range(_, _, _) | .Or(_, _) | .Struct(_, _) | .List(_, _, _) | .Map(_, _, _) | .Text(_, _) | .Binary(_, _) -> {}
    }
    None
}

sema_coverage_collect_nested: fn(shape: TPatternShape, key: String, inner: &[TPatternShape], partial_keys: &[String]) {
    if shape == .Or(alternatives, _) {
        loop alternative in alternatives -> sema_coverage_collect_nested(alternative, key, inner, partial_keys)
        return
    }
    part: sema_coverage_nested_part(shape) ?? return
    if !sema_coverage_has_key(partial_keys, part.key) -> partial_keys.push(part.key)
    if part.key == key -> inner.push(part.inner)
}

// The payload type of field `field` behind a head key, when nested coverage
// applies.
sema_coverage_payload_type: fn(subject_ty: Type, key: String, field: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type? {
    if subject_ty == {
        // copy: `inner` is a payload of read parameter `subject_ty`, which keeps the original; the Val carrier owns this one
        .Option(inner) -> if key == "Val" -> return Val(inner.copy())
        .Result(ok, err) -> {
            if key == "Ok" -> return Val(ok)
            if key == "Err" -> return Val(err)
        }
        .Named(_) | .Apply(_, _) -> {
            if program.registration_graph == .Val(graph) {
                nominal_row: sema_pattern_nominal_row(graph, environment.module_identity, subject_ty) ?? return None
                nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
                loop row in nominal.variants {
                    if row.symbol.name == key {
                        types: sema_pattern_variant_types(program.registration_graph, row.payload, nominal, subject_ty)
                        if field < types.len() -> return Val(types[field])
                    }
                }
            }
        }
        // A union member's payload is the member value (`.Err(.A(.Bad))`).
        .Union(members) -> {
            loop member in members {
                if sema_pattern_union_tag(member) == key -> return Val(member)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    None
}

sema_coverage_is_closed: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Named(_) | .Apply(_, _) | .Option(_) | .Result(_, _) | .Union(_) | .Case(_, _) | .List(_) | .FixedList(_, _) | .Map(_, _, _) -> true
        .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// The S31 nested payload shapes of the arms, grouped by head key and payload
// field in one pass; `partial_keys` lists the keys in first-seen order.
sema_coverage_group_nested: fn(shape: TPatternShape, groups: &[String:[(field: Int, inner: TPatternShape)]], partial_keys: &[String]) {
    if shape == .Or(alternatives, _) {
        loop alternative in alternatives -> sema_coverage_group_nested(alternative, groups, partial_keys)
        return
    }
    part: sema_coverage_nested_part(shape) ?? return
    existing: groups.get(part.key)
    if existing == None -> partial_keys.push(part.key)
    group := existing ?? [(field: Int, inner: TPatternShape)]{}
    group.push((field: part.field, inner: part.inner))
    groups[part.key] = group
}

// S31: the covered keys of a set of arm shapes over `subject_ty`. A head key
// with only nested payload arms is covered when the nested arms on one of
// its payload fields jointly cover that field's type (to any depth).
sema_coverage_keys: fn(subject_ty: Type, shapes: [TPatternShape], environment: SemaScopeEnvironment, program: SemaProgramTables, ranges: &[SemaIntegerRange]) -> [String] {
    keys := [String]{}
    partial_keys := [String]{}
    groups := [String:[(field: Int, inner: TPatternShape)]]{}
    loop shape in shapes {
        sema_coverage_shape_keys(shape, keys, ranges)
        sema_coverage_group_nested(shape, groups, partial_keys)
    }
    key_set := sema_coverage_key_set(keys)
    loop key in partial_keys {
        if sema_coverage_leaf_covered(key_set, key) -> next
        group: groups.get(key) ?? [(field: Int, inner: TPatternShape)]{}
        fields := [Int]{}
        loop entry in group {
            if !fields.contains(entry.field) -> fields.push(entry.field)
        }
        loop field in fields {
            if sema_coverage_field_covers(subject_ty, key, field, group, environment, program) {
                keys.push(key.copy())
                key_set[key] = true
                break
            }
        }
    }
    keys
}

// Whether the nested arms on payload field `field` of head `key` jointly
// cover that field's closed type.
sema_coverage_field_covers: fn(subject_ty: Type, key: String, field: Int, group: [(field: Int, inner: TPatternShape)], environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    payload_ty: sema_pattern_unwrap_tags(sema_coverage_payload_type(subject_ty, key, field, environment, program) ?? return false)
    if !sema_coverage_is_closed(payload_ty) -> return false
    inner := [TPatternShape]{}
    loop entry in group {
        if entry.field == field -> inner.push(entry.inner)
    }
    if payload_ty == .List(_) || payload_ty == .FixedList(_, _) || payload_ty == .Map(_, _, _) {
        rows: loop shape in inner -> SemaPatternCoverageRow{cells: [SemaPatternCoverageCell]{SemaPatternCoverageCell.Shape{shape: shape}}}
        return sema_pattern_matrix_complete(rows, [Type]{payload_ty}, environment, program)
    }
    inner_ranges := [SemaIntegerRange]{}
    inner_keys: sema_coverage_keys(payload_ty, inner, environment, program, inner_ranges)
    sema_coverage_missing(payload_ty, inner_keys, environment, program).len() == 0
}

// Every condition must be a pattern test on the same subject; otherwise the
// table is not an all-pattern table and coverage does not apply.
sema_coverage_pattern_subject: fn(condition: TExpr) -> TExpr? {
    if condition.kind == {
        // copy: `tested` is a payload of read parameter `condition`, which keeps the original; the Val carrier owns this one
        .PatternMatches(tested, _) -> Val(tested.copy())
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> None
    }
}

// A guarded arm (`.Val(x) && x > 0`) tests the subject but covers no case, so
// it adds no shape and the other arms must cover the subject.
sema_coverage_table: fn(conditions: [TExpr]) -> SemaCoverageTable? {
    if conditions.len() == 0 -> return None
    head := conditions[0].copy()
    if sema_coverage_guard_test(conditions[0]) == .Val(test) -> head = test
    subject: sema_coverage_pattern_subject(head) ?? return None
    shapes := [TPatternShape]{}
    loop condition in conditions {
        if sema_coverage_guard_test(condition) == .Val(test) {
            if test.kind == .PatternMatches(tested, _) && tested.span == subject.span -> next
            return None
        }
        if condition.kind == {
            .PatternMatches(tested, pattern) -> {
                if tested.span != subject.span -> return None
                shapes.push(pattern.shape)
            }
            .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> return None
        }
    }
    SemaCoverageTable{subject: subject, shapes: shapes}
}

// The pattern test that starts a guarded arm's `&&` chain.
sema_coverage_guard_test: fn(condition: TExpr) -> TExpr? {
    if condition.kind == .Binary(op, _, _, lhs, _) && op == TBinaryOp.And {
        // copy: `lhs` is a payload of read parameter `condition`; the Val carrier owns this one
        if lhs.kind == .PatternMatches(_, _) -> return Val(lhs.copy())
        return sema_coverage_guard_test(lhs)
    }
    None
}

sema_coverage_has_key: fn(keys: [String], key: String) -> Bool Never! {
    loop candidate in keys {
        if candidate == key -> return true
    }
    false
}

sema_coverage_key_set: fn(keys: [String]) -> [String:Bool] Never! {
    set := [String:Bool]{}
    loop key in keys -> set[key] = true
    set
}

// A leaf is covered by itself or by any ancestor group path.
sema_coverage_leaf_covered: fn(keys: [String:Bool], leaf: String) -> Bool Never! {
    if keys.get(leaf) != None -> return true
    prefix := ""
    loop segment in leaf.split(".") {
        if prefix != "" {
            if keys.get(prefix) != None -> return true
            prefix = "{prefix}."
        }
        prefix = "{prefix}{segment}"
    }
    false
}

sema_coverage_ranges_cover: fn(ranges: [SemaIntegerRange], lo: Int, hi: Int) -> Bool Never! {
    if lo > hi -> return false
    next := lo
    loop {
        advanced := false
        loop range in ranges {
            if range.lo <= next && range.hi >= next {
                if range.hi >= hi -> return true
                next = range.hi + 1
                advanced = true
            }
        }
        if !advanced -> return false
    }
}

// A finite integer subject can be proved total by its range arms. Wide
// fixed-width integers stay open: their bounds are not representable here.
sema_coverage_integer_interval: fn(ty: Type) -> SemaIntegerRange? {
    if ty == {
        .InlineRange(_, lo, hi) -> Val(SemaIntegerRange{lo: lo, hi: hi})
        .IntN(signed, bits) -> if bits <= 0 || bits > 32 -> None else -> Val(sema_expr_integer_range(signed, bits))
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

sema_coverage_is_open_scalar: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Char | .IntN(_, _) | .InlineRange(_, _, _) -> true
        .Float | .Bool | .String | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// Rust `builtin_type_registry`: the compiler-owned runtime enums (`Ordering`,
// `RemoveBy`) and the Core registry enums with no source declaration (`Dyn`)
// are closed sets without a registered nominal.
sema_coverage_compiler_enum: fn(ty: Type) -> [String]? {
    name := ""
    if ty == {
        .Named(value) -> name = value
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
    if sema_compiler_enum_variants(name) == .Val(variants) -> return Val(variants)
    if core_enum_payload_variants(name) == .Val(variants) -> return Val(variants)
    core_enum_variants(name)
}

sema_coverage_missing: fn(subject_ty: Type, keys: [String], environment: SemaScopeEnvironment, program: SemaProgramTables) -> [String] Never! {
    missing := [String]{}
    if subject_ty == {
        .Named(_) | .Apply(_, _) -> {
            if program.registration_graph == .Val(graph) {
                nominal_row: sema_pattern_nominal_row(graph, environment.module_identity, subject_ty) ?? {
                    variants: sema_coverage_compiler_enum(subject_ty) ?? return missing
                    loop variant in variants {
                        if !sema_coverage_has_key(keys, variant) -> missing.push(variant)
                    }
                    return missing
                }
                nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
                if nominal.kind != SemaRegistrationNominalKind.Enum -> return missing
                key_set: sema_coverage_key_set(keys)
                loop row in nominal.variants {
                    if !sema_coverage_leaf_covered(key_set, row.symbol.name) -> missing.push(row.symbol.name)
                }
            }
        }
        .Option(_) -> {
            if !sema_coverage_has_key(keys, "Val") -> missing.push("Val")
            if !sema_coverage_has_key(keys, "None") -> missing.push("None")
        }
        .Result(_, _) -> {
            if !sema_coverage_has_key(keys, "Ok") -> missing.push("Ok(...)")
            if !sema_coverage_has_key(keys, "Err") -> missing.push("Err(...)")
        }
        .Union(members) -> {
            loop member in members {
                member_tag: sema_pattern_union_tag(member)
                if !sema_coverage_has_key(keys, member_tag) -> missing.push(member_tag)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    missing
}

// A `T? E!` subject reports its missing success states
// directly (`Val(...)`, `None`), never as `Ok(...)`.
sema_coverage_three_state_missing: fn(ok: Type, shapes: [TPatternShape], keys: [String], environment: SemaScopeEnvironment, program: SemaProgramTables) -> [String] {
    missing := [String]{}
    if !sema_coverage_has_key(keys, "Ok") {
        inner := [TPatternShape]{}
        seen := [String]{}
        loop shape in shapes -> sema_coverage_collect_nested(shape, "Ok", inner, seen)
        inner_ranges := [SemaIntegerRange]{}
        inner_keys: sema_coverage_keys(ok, inner, environment, program, inner_ranges)
        if !sema_coverage_has_key(inner_keys, "Val") -> missing.push("Val(...)")
        if !sema_coverage_has_key(inner_keys, "None") -> missing.push("None")
    }
    if !sema_coverage_has_key(keys, "Err") -> missing.push("Err(...)")
    missing
}

// A partly matched `Ok`/`Err` names the payload cases its nested arms leave
// open (`Err(.High)`, `Err(.BadNumStr(_))`) instead of `Err(...)`.
sema_coverage_nested_witnesses: fn(subject_ty: Type, missing: [String], shapes: [TPatternShape], environment: SemaScopeEnvironment, program: SemaProgramTables) -> [String] {
    named := [String]{}
    loop entry in missing {
        key: if entry == "Ok(...)" -> "Ok" else if entry == "Err(...)" -> "Err" else -> ""
        cases: if key == "" -> [String]{} else -> sema_coverage_nested_cases(subject_ty, key, shapes, environment, program)
        if cases.len() == 0 {
            named.push(entry.copy())
            next
        }
        loop case in cases -> named.push("{key}({case})")
    }
    named
}

sema_coverage_nested_cases: fn(subject_ty: Type, key: String, shapes: [TPatternShape], environment: SemaScopeEnvironment, program: SemaProgramTables) -> [String] {
    inner := [TPatternShape]{}
    seen := [String]{}
    loop shape in shapes -> sema_coverage_collect_nested(shape, key, inner, seen)
    if inner.len() == 0 -> return [String]{}
    payload_ty: sema_pattern_unwrap_tags(sema_coverage_payload_type(subject_ty, key, 0, environment, program) ?? return [String]{})
    if !(payload_ty == .Named(_) || payload_ty == .Apply(_, _) || payload_ty == .Union(_)) -> return [String]{}
    ranges := [SemaIntegerRange]{}
    keys: sema_coverage_keys(payload_ty, inner, environment, program, ranges)
    loop name in sema_coverage_missing(payload_ty, keys, environment, program) -> ".{name}{if sema_coverage_case_has_payload(payload_ty, name, environment, program) -> "(_)" else -> ""}"
}

sema_coverage_case_has_payload: fn(ty: Type, name: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if ty == .Union(_) -> return true
    if program.registration_graph == .Val(graph) {
        nominal_row: sema_pattern_nominal_row(graph, environment.module_identity, ty) ?? return false
        nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
        loop row in nominal.variants {
            if row.symbol.name == name {
                if row.payload == {
                    .Unit -> return false
                    .Single(_, _) | .Named(_) -> return true
                }
            }
        }
    }
    false
}

// Reports E0307 for an else-less table whose checked pattern conditions leave a
// case open.
sema_coverage_check_table: fn(conditions: [TExpr], multi_head: Bool, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) {
    table: sema_coverage_table(conditions) ?? return
    // (Rust `report_refutable_pattern_without_else`):
    // a text or byte arm can always fail to match, so the table needs `else`.
    if !multi_head {
        has_text := false
        has_binary := false
        loop shape in table.shapes {
            if shape == {
                .Text(_, _) -> has_text = true
                .Binary(_, _) -> has_binary = true
                .Variant(_, _, _, _) | .Present(_, _, _, _) | .Absent(_) | .Ok(_, _, _, _) | .Err(_, _, _, _) | .Range(_, _, _) | .Or(_, _) | .Struct(_, _) | .List(_, _, _) | .Map(_, _, _) -> {}
            }
        }
        if has_binary && !has_text {
            diagnostics.push(sema_error("E0148", span, "this `if` matches bytes but has no `else` arm", "a binary pattern can always fail to match — the fixed bytes might differ, or the subject might be too short", "add `else -> {{ ... }}` to handle bytes that don't match"))
            return
        }
        if has_text {
            diagnostics.push(sema_error("E0148", span, "this `if` matches text but has no `else` arm", "a text pattern can always fail to match — the fixed text might differ, or a typed hole might not read as that type", "add `else -> {{ ... }}` to handle text that doesn't match"))
            return
        }
    }
    subject_ty: sema_pattern_unwrap_tags(table.subject.ty)
    matrix := false
    loop shape in table.shapes {
        if sema_pattern_matrix_needed(shape) -> matrix = true
    }
    if matrix {
        rows: loop shape in table.shapes -> SemaPatternCoverageRow{cells: [SemaPatternCoverageCell]{SemaPatternCoverageCell.Shape{shape: shape}}}
        if sema_pattern_matrix_complete(rows, [Type]{subject_ty}, environment, program) -> return
        // A map pattern names some keys and a map can always hold others, so
        // no arm list covers it: the only cover is `else`.
        if subject_ty == .Map(_, _, _) {
            diagnostics.push(sema_error("E0307", span, "this `if` doesn't cover every `{type_name(subject_ty)}` value — it needs an `else` arm", "every arm tests part of the value's shape, so some values match no arm", "add `else -> {{ … }}` after the last arm"))
            return
        }
        witness: sema_pattern_collection_witness(subject_ty, rows, environment, program)
        diagnostics.push(sema_error("E0307", span, "this `if` doesn't cover every case — missing: {witness}", "pattern arms must cover every collection shape", "add an arm for `{witness}` or an `else` arm"))
        return
    }
    ranges := [SemaIntegerRange]{}
    keys: sema_coverage_keys(subject_ty, table.shapes, environment, program, ranges)
    interval: sema_coverage_integer_interval(subject_ty)
    if interval == .Val(bounds) {
        if sema_coverage_ranges_cover(ranges, bounds.lo, bounds.hi) -> return
    }
    if sema_coverage_is_open_scalar(subject_ty) {
        domain_note: if interval != None -> "`{sema_type_show(subject_ty)}` has a finite integer interval, but the range arms do not cover every value" else -> "`{sema_type_show(subject_ty)}` has infinitely many values; range arms only cover a subset"
        diagnostics.push(sema_error("E0307", span, "this `if` over `{sema_type_show(subject_ty)}` has no `else` arm — range arms can't cover every value", domain_note, "add `else -> {{ … }}` to handle values not matched by any range"))
        return
    }
    missing := sema_coverage_missing(subject_ty, keys, environment, program)
    if subject_ty == .Result(ok, _) {
        ok_ty: sema_pattern_unwrap_tags(ok)
        if sema_pattern_is_option(ok_ty) -> missing = sema_coverage_three_state_missing(ok_ty, table.shapes, keys, environment, program)
    }
    missing = sema_coverage_nested_witnesses(subject_ty, missing, table.shapes, environment, program)
    if missing.len() == 0 -> return
    // A case with several payload fields, one of them nested
    // (`.FailedToFetch{url, cause: .BadURL(why)}`), is proved column by column.
    if sema_coverage_any_multi_field_nested(table.shapes) {
        rows: loop shape in table.shapes -> SemaPatternCoverageRow{cells: [SemaPatternCoverageCell]{SemaPatternCoverageCell.Shape{shape: shape}}}
        if sema_pattern_matrix_complete(rows, [Type]{subject_ty}, environment, program) -> return
    }
    names: missing.join(", ")
    if multi_head {
        diagnostics.push(sema_error("E0307", span, "this multi-head function doesn't cover every case — missing: {names}", "each multi-head head covers one argument shape, so every variant must appear once", "add a head for: {names}"))
        return
    }
    diagnostics.push(sema_error("E0307", span, "this `if` doesn't cover every case — missing: {names}", "every arm here is a pattern test, so each variant must appear once", "add an arm for: {names}"))
}

// `note_pattern_coverage`: an arm head that an earlier full arm, or an ancestor
// group arm already covers is unreachable — E0365 over an anonymous union
// subject, L0301 otherwise.
sema_coverage_check_unreachable_arms: fn(conditions: [TExpr], multi_head: Bool, diagnostics: &[Diagnostic]) {
    table: sema_coverage_table(conditions) ?? return
    union_subject: sema_pattern_unwrap_tags(table.subject.ty) == .Union(_)
    covered := [String]{}
    loop shape in table.shapes {
        full := [String]{}
        partial := [String]{}
        sema_coverage_arm_heads(shape, full, partial)
        heads := [String]{}
        full_heads := [Bool]{}
        loop name in full {
            heads.push(name)
            full_heads.push(true)
        }
        loop name in partial {
            heads.push(name)
            full_heads.push(false)
        }
        loop (index, variant) in heads {
            already := false
            loop earlier in covered {
                if earlier == variant || variant.starts_with("{earlier}.") -> already = true
            }
            if {
                already -> {
                    what: if multi_head -> "head `{variant}` is unreachable — an earlier head already handles it" else -> "arm `{variant}` is unreachable — that case is already handled"
                    why: if multi_head -> "multi-head declaration order selects the first matching head" else -> "every earlier arm already covers this pattern"
                    fix: if multi_head -> "remove this head or merge it with the earlier head" else -> "remove this arm or merge it with the one above"
                    span: sema_coverage_shape_span(shape)
                    diagnostics.push(if union_subject -> sema_error("E0365", span, what, why, fix) else -> sema_lint("L0301", span, what, why, fix))
                }
                full_heads[index] -> covered.push(variant)
            }
        }
    }
}

// Rust `collect_covered_variant_names` / `collect_partial_variant_names`: the
// heads one arm covers fully, and the heads it only tests with a nested
// payload pattern (S31). A range payload slot covers no head.
sema_coverage_arm_heads: fn(shape: TPatternShape, full: &[String], partial: &[String]) {
    if shape == .Or(alternatives, _) {
        loop alternative in alternatives -> sema_coverage_arm_heads(alternative, full, partial)
        return
    }
    if shape == {
        .Variant(variant, bindings, _, _) -> {
            nested := false
            ranged := false
            loop binding in bindings {
                if binding == {
                    .Nested(_) -> nested = true
                    .Range(_, _) -> ranged = true
                    .Wildcard | .Bind(_, _) | .Value(_) -> {}
                }
            }
            if nested {
                partial.push(variant.copy())
            } else if !ranged {
                full.push(variant.copy())
            }
        }
        .Present(_, _, inner, _) -> sema_coverage_push_head("Val", inner == None, full, partial)
        .Absent(_) -> full.push("None")
        .Ok(_, _, inner, _) -> sema_coverage_push_head("Ok", inner == None, full, partial)
        .Err(_, _, inner, _) -> sema_coverage_push_head("Err", inner == None, full, partial)
        .Range(_, _, _) | .Or(_, _) | .Struct(_, _) | .List(_, _, _) | .Map(_, _, _) | .Text(_, _) | .Binary(_, _) -> {}
    }
}

sema_coverage_push_head: fn(head: String, full_cover: Bool, full: &[String], partial: &[String]) {
    if full_cover {
        full.push(head.copy())
    } else {
        partial.push(head.copy())
    }
}

sema_coverage_shape_span: fn(shape: TPatternShape) -> Span Never! {
    if shape == {
        .Variant(_, _, _, span) | .Present(_, _, _, span) | .Ok(_, _, _, span) | .Err(_, _, _, span) -> span
        .Absent(span) -> span
        .Range(_, _, span) | .Or(_, span) | .Struct(_, span) | .List(_, _, span) | .Map(_, _, span) | .Text(_, span) | .Binary(_, span) -> span
    }
}

// A pattern arm lowered to an IfLet condition reads, for coverage, as the
// pattern test it was checked from.
sema_coverage_if_let_value: fn(pattern: TPattern, subject: TExpr) -> TExpr Never! {
    sema_tree_node(Type.Bool, TExprKind.PatternMatches{subject: subject, pattern: pattern}, subject.span)
}

// The value form arrives as a nested `if` chain sharing one span and ending in
// `NoElse` (checked as `Never("no else arm")`). Collect its checked arm
// conditions, or None when the chain has a real `else` value.
// The chain is walked through read parameters (one frame per level), so
// only the collected conditions are copied: holding each level in a local
// copied the rest of the chain once per level.
sema_coverage_noelse_chain_conditions: fn(head_condition: TExpr, else_value: TExpr, span: Span, context: SemaCheckContext) -> [TExpr]? {
    // copy: the result owns each collected condition; the chain stays the caller's.
    conditions := [TExpr]{head_condition.copy()}
    if !sema_coverage_noelse_chain_collect(else_value, span, context, conditions) -> return None
    Val(conditions)
}

sema_coverage_noelse_chain_collect: fn(current: TExpr, span: Span, context: SemaCheckContext, conditions: &[TExpr]) -> Bool Never! {
    if current.kind == {
        // The chain's `NoElse` end is a flat `Never` row (sema_node).
        .Flat(index) -> {
            if context.arena.tree.nodes[index - context.arena.tree.node_base].kind == .Never(reason, _) -> return reason == "no else arm"
            return false
        }
        .IfExpr(cond, _, _, _, next_value) -> {
            if current.span != span -> return false
            if !sema_coverage_chain_condition(cond, conditions) -> return false
            return sema_coverage_noelse_chain_collect(next_value, span, context, conditions)
        }
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) -> return false
    }
}

// Appends the checked condition of one chain level; false for a form the
// coverage proof does not read.
sema_coverage_chain_condition: fn(cond: TIfCond, conditions: &[TExpr]) -> Bool Never! {
    if cond == {
        // copy: the result owns each collected condition.
        .Plain(value) -> conditions.push(value.copy())
        .IfLet(pattern, subject) -> conditions.push(sema_coverage_if_let_value(pattern, subject))
        .And(_, _) -> return false
    }
    true
}

// True when this `if` level heads (or continues) an else-less dispatch chain:
// the nested levels share its span and the last one ends in `NoElse`.
sema_coverage_is_noelse_chain: fn(else_body: [Stmt], else_value: Expr, span: Span) -> Bool Never! {
    if else_body.len() != 0 -> return false
    if else_value == {
        .NoElse(_, _) -> true
        .If(_, _, _, next_body, next_value, next_span, _) -> next_span == span && sema_coverage_is_noelse_chain(next_body, next_value, span)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// The statement form lowers the same chain to nested `TStmt.If` levels.
// Walk the source chain beside it to collect the checked arm conditions.
sema_coverage_noelse_statement_conditions: fn(source: Expr, lowered: TStmt) -> [TExpr]? {
    conditions := [TExpr]{}
    current_source := source
    current_lowered := lowered
    loop {
        if current_source == {
            .If(_, _, _, else_body, else_value, span, _) -> {
                if !sema_coverage_is_noelse_chain(else_body, else_value, span) -> return None
                if current_lowered == {
                    .If(cond, _, else_stmts, _, _) -> {
                        if cond == {
                            .Plain(value) -> conditions.push(value)
                            .IfLet(pattern, subject) -> conditions.push(sema_coverage_if_let_value(pattern, subject))
                            .And(_, _) -> return None
                        }
                        if else_value == {
                            .NoElse(_, _) -> return Val(conditions)
                            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
                        }
                        nested: else_stmts ?? return None
                        if nested.len() != 1 -> return None
                        current_source = else_value
                        current_lowered = nested[0]
                    }
                    .Contract(_) | .ContractScope(_, _, _, _, _) | .Let(_, _, _, _, _, _) | .RefutableBind(_, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .ForRange(_, _, _, _, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .ExprStmt(_, _) | .Return(_, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .Match(_, _, _, _) | .EnumMatch(_, _, _, _, _) | .RangeSwitch(_, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _, _) | .Inline(_, _) | .DebugOnly(_, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .UnsafeBlock(_, _, _) | .SentryPolicy(_, _, _) | .Impure(_, _) | .Reactive(_, _) | .Region(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .Shield(_, _) | .ScopeMember(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> return None
                }
            }
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
        }
    }
}

// E0641: the parser-recorded `else` arm of the dispatch table whose chain
// levels all carry `span`.
sema_coverage_else_arm: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, span: Span) -> ElseArmSpan? {
    loop arm in environment.else_arms {
        if arm.table.start == span.start && arm.table.end == span.end -> return Val(arm)
    }
    None
}

// True when this `if` level belongs to a dispatch table with an `else` arm.
sema_coverage_is_else_table: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, span: Span) -> Bool {
    sema_coverage_else_arm(environment, program, span) != None
}

// A closed set: an enum, `T?`, `T E!`, or a union. Numbers, text, and
// structs stay open, so an `else` after their arms can still run.
sema_coverage_is_closed_set: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if ty == {
        .Option(_) | .Result(_, _) | .Union(_) | .Case(_, _) -> return true
        .Named(_) | .Apply(_, _) -> {}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Quantity(_, _) | .Measure(_) -> return false
    }
    if program.registration_graph == .Val(graph) {
        nominal_row: sema_pattern_nominal_row(graph, environment.module_identity, ty) ?? return sema_coverage_compiler_enum(ty) != None
        return graph.modules[nominal_row.module_index].nominals[nominal_row.row].kind == SemaRegistrationNominalKind.Enum
    }
    false
}

// E0641: one arm of a table that ends in `else`. `shape` is the pattern the
// arm covers; a guarded arm (`.Val(x) && x > 0 ->`) tests the subject but
// covers no case, so its shape is None.
SemaCoverageElseHead: struct {
    subject: TExpr
    shape: TPatternShape?
}

sema_coverage_else_head_of_expr: fn(condition: TExpr) -> SemaCoverageElseHead? {
    if condition.kind == {
        // copy: `tested` is a payload of read parameter `condition`; the head owns its own.
        .PatternMatches(tested, pattern) -> Val(SemaCoverageElseHead{subject: tested.copy(), shape: Val(sema_coverage_else_shape(pattern.shape))})
        .Binary(op, _, _, lhs, _) -> {
            if op != TBinaryOp.And -> return None
            inner: sema_coverage_else_head_of_expr(lhs) ?? return None
            Val(SemaCoverageElseHead{subject: inner.subject, shape: None})
        }
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> None
    }
}

// A stable `x == None` arm is checked as the presence test `x == .Val(x)`
// with its branches exchanged (sema_expression_if_absent_test_swaps), so its
// shape reads `.Val`; the arm still stands for `.None`. The generated test
// binds the subject's own name at the subject's span, before the pattern,
// where a written `.Val(x)` binds inside its pattern.
sema_coverage_else_shape: fn(shape: TPatternShape) -> TPatternShape Never! {
    if shape == .Present(_, binding_span, inner, span) {
        if inner == None && binding_span.start < span.start -> return TPatternShape.Absent{span: span}
    }
    // copy: `shape` is a read parameter; the head owns its own.
    shape.copy()
}

sema_coverage_else_head_of_cond: fn(cond: TIfCond) -> SemaCoverageElseHead? {
    if cond == {
        .Plain(value) -> sema_coverage_else_head_of_expr(value)
        .IfLet(pattern, subject) -> sema_coverage_else_head_of_expr(sema_coverage_if_let_value(pattern, subject))
        .And(left, _) -> {
            inner: sema_coverage_else_head_of_cond(left) ?? return None
            Val(SemaCoverageElseHead{subject: inner.subject, shape: None})
        }
    }
}

// The arms of a value table with an `else` arm: every level that shares the
// table's span, stopping at the `else` value. None when an arm is not a
// pattern test of the subject, which leaves the table open.
sema_coverage_else_chain_heads: fn(head_condition: TExpr, else_value: TExpr, span: Span) -> [SemaCoverageElseHead]? {
    first: sema_coverage_else_head_of_expr(head_condition) ?? return None
    heads := [SemaCoverageElseHead]{first}
    if !sema_coverage_else_chain_collect(else_value, span, heads) -> return None
    Val(heads)
}

sema_coverage_else_chain_collect: fn(current: TExpr, span: Span, heads: &[SemaCoverageElseHead]) -> Bool {
    if current.span != span -> return true
    if current.kind == .IfExpr(cond, _, _, _, next_value) {
        heads.push(sema_coverage_else_head_of_cond(cond) ?? return false)
        return sema_coverage_else_chain_collect(next_value, span, heads)
    }
    true
}

// The statement form of the same table, walked beside its lowered levels.
sema_coverage_else_statement_heads: fn(source: Expr, lowered: TStmt) -> [SemaCoverageElseHead]? {
    heads := [SemaCoverageElseHead]{}
    current_source := source
    current_lowered := lowered
    table_span: expr_span(source)
    loop {
        if current_source == {
            .If(_, _, _, _, else_value, span, _) -> {
                if span != table_span -> return Val(heads)
                if current_lowered == {
                    .If(cond, _, else_stmts, _, _) -> {
                        heads.push(sema_coverage_else_head_of_cond(cond) ?? return None)
                        nested: else_stmts ?? return Val(heads)
                        if nested.len() != 1 -> return Val(heads)
                        current_source = else_value
                        current_lowered = nested[0]
                    }
                    .Contract(_) | .ContractScope(_, _, _, _, _) | .Let(_, _, _, _, _, _) | .RefutableBind(_, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .ForRange(_, _, _, _, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .ExprStmt(_, _) | .Return(_, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .Match(_, _, _, _) | .EnumMatch(_, _, _, _, _) | .RangeSwitch(_, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _, _) | .Inline(_, _) | .DebugOnly(_, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .UnsafeBlock(_, _, _) | .SentryPolicy(_, _, _) | .Impure(_, _) | .Reactive(_, _) | .Region(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .Shield(_, _) | .ScopeMember(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> return Val(heads)
                }
            }
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return Val(heads)
        }
    }
}

// The arms of a statement table (`if x == { … }` with statement bodies).
sema_coverage_else_switch_heads: fn(conditions: [TExpr]) -> [SemaCoverageElseHead]? {
    heads := [SemaCoverageElseHead]{}
    loop condition in conditions -> heads.push(sema_coverage_else_head_of_expr(condition) ?? return None)
    Val(heads)
}

// The source pattern that matches every value of case `name` of `subject_ty`,
// as `jet fix` writes it in place of `else`; None when the case is unknown.
sema_coverage_case_pattern: fn(subject_ty: Type, name: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> String? {
    if subject_ty == {
        .Option(_) -> return Val(if name == "None" -> ".None" else -> ".Val(_)")
        .Result(_, _) -> return Val(if {
            name == "None" -> ".None"
            name.starts_with("Val") -> ".Val(_)"
            name.starts_with("Ok") -> ".Ok(_)"
            else -> ".Err(_)"
        })
        // A union member is tested by its tag alone (`.Int -> …`).
        .Union(_) | .Case(_, _) -> return Val(".{name}")
        .Named(_) | .Apply(_, _) -> {}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
    // The case's payload as pattern checking resolves it, so a Core enum with
    // no registered nominal (`Dyn`, `IOError`) gets its arity too.
    probe := [Diagnostic]{}
    payload: sema_pattern_payload(subject_ty, name, environment, program, Span{start: 0, end: 0}, probe)
    if !payload.known || payload.group -> return None
    Val(sema_coverage_case_slots(name, payload.types.len()))
}

// `.Name` for a unit case, `.Name(_, …)` with `arity` wildcards otherwise.
sema_coverage_case_slots: fn(name: String, arity: Int) -> String {
    if arity == 0 -> return ".{name}"
    slots: loop _ in 0..<arity -> "_"
    ".{name}({slots.join(", ")})"
}

// E0641 (#6281): an `else` over a closed set (an enum, `T?`, `T E!`, or a
// union) is an error. When the arms already cover every case the `else` can
// never run, and its Safe edit deletes it; otherwise the edit writes the
// cases it stands for as one or-pattern arm, so a case added later raises
// E0307 instead of falling into the `else` silently. A table with a
// non-pattern arm stays open and keeps its `else`.
sema_coverage_check_closed_else: fn(heads: [SemaCoverageElseHead]?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) {
    arm: sema_coverage_else_arm(environment, program, span) ?? return
    table: heads ?? return
    if table.len() == 0 -> return
    subject_span: table[0].subject.span
    subject_ty: sema_pattern_unwrap_tags(table[0].subject.ty)
    if !sema_coverage_is_closed_set(subject_ty, environment, program) -> return
    shapes := [TPatternShape]{}
    loop head in table {
        if head.subject.span != subject_span -> return
        if head.shape == .Val(shape) -> shapes.push(shape)
    }
    ranges := [SemaIntegerRange]{}
    keys: sema_coverage_keys(subject_ty, shapes, environment, program, ranges)
    missing := sema_coverage_missing(subject_ty, keys, environment, program)
    if subject_ty == .Result(ok, _) {
        ok_ty: sema_pattern_unwrap_tags(ok)
        if sema_pattern_is_option(ok_ty) -> missing = sema_coverage_three_state_missing(ok_ty, shapes, keys, environment, program)
    }
    shown: type_name(subject_ty)
    // `T?` and `T E!` never gain a case; an enum or a union can.
    fixed_cases: subject_ty == .Option(_) || subject_ty == .Result(_, _)
    why: if fixed_cases -> "`{shown}` is a closed set: an `else` hides which of its cases the arm handles, where naming them keeps the table checked" else -> "`{shown}` is a closed set: an `else` would take any case added to `{shown}` later silently, instead of the compiler asking you to handle it"
    if missing.len() == 0 {
        diagnostic: sema_error("E0641", arm.arm, "this `else` can never run; every case of `{shown}` is already handled", why, "delete the `else` arm")
        diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: arm.delete, new_text: ""}))
        return
    }
    patterns := [String]{}
    loop name in missing {
        pattern: sema_coverage_case_pattern(subject_ty, name, environment, program) ?? {
            diagnostics.push(sema_error("E0641", arm.arm, "this `else` stands for cases of the closed set `{shown}`", why, "write an arm for each remaining case of `{shown}` in place of the `else`: {missing.join(", ")}"))
            return
        }
        if !patterns.contains(pattern) -> patterns.push(pattern)
    }
    written: patterns.join(" | ")
    diagnostic: sema_error("E0641", arm.arm, "this `else` stands for cases of the closed set `{shown}`", why, "name the cases instead: `{written} ->`")
    if !arm.one_line {
        diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: Span{start: arm.arm.start, end: arm.arm.start + 4}, new_text: written}))
        return
    }
    // A one-line table holds one arm and its `else`, so the edit lays the
    // table out one arm per line; a layout the parser could not read keeps
    // the fix as text.
    layout: arm.layout ?? {
        diagnostics.push(diagnostic)
        return
    }
    inner: "{layout.indent}    "
    diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: layout.span, new_text: "\n{inner}{layout.head}\n{inner}{written}{layout.tail}\n{layout.indent}"}))
}

SemaPatternCoverageCell: enum {
    Any
    Shape(shape: TPatternShape)
    Refutable
}

SemaPatternCoverageRow: struct {
    cells: [SemaPatternCoverageCell]
}

SemaPatternCoverageConstructor: struct {
    name: String
    payload: [Type]
}

sema_pattern_matrix_slot: fn(slot: TPatternBinding) -> SemaPatternCoverageCell Never! {
    if slot == {
        .Bind(_, _) | .Wildcard -> SemaPatternCoverageCell.Any
        .Nested(inner) -> SemaPatternCoverageCell.Shape{shape: inner.shape}
        .Range(_, _) | .Value(_) -> SemaPatternCoverageCell.Refutable
    }
}

sema_pattern_matrix_expand: fn(rows: [SemaPatternCoverageRow]) -> [SemaPatternCoverageRow] Never! {
    expanded := [SemaPatternCoverageRow]{}
    loop row in rows {
        if row.cells.len() > 0 && row.cells[0] == .Shape(shape) && shape == .Or(alternatives, _) {
            loop alternative in alternatives {
                cells := row.cells
                cells[0] = SemaPatternCoverageCell.Shape{shape: alternative}
                loop subrow in sema_pattern_matrix_expand([SemaPatternCoverageRow]{SemaPatternCoverageRow{cells: cells}}) -> expanded.push(subrow)
            }
        } else {
            expanded.push(row.copy())
        }
    }
    expanded
}

sema_pattern_matrix_tail: fn(types: [Type]) -> [Type] Never! {
    tail := [Type]{}
    loop (index, ty) in types {
        if index > 0 -> tail.push(ty.copy())
    }
    tail
}

sema_pattern_matrix_append_tail: fn(cells: [SemaPatternCoverageCell], row: SemaPatternCoverageRow) -> SemaPatternCoverageRow Never! {
    result := cells
    loop (index, cell) in row.cells {
        if index > 0 -> result.push(cell.copy())
    }
    SemaPatternCoverageRow{cells: result}
}

sema_pattern_matrix_default: fn(rows: [SemaPatternCoverageRow]) -> [SemaPatternCoverageRow] Never! {
    defaults := [SemaPatternCoverageRow]{}
    loop row in rows {
        if row.cells.len() > 0 && row.cells[0] == .Any -> defaults.push(sema_pattern_matrix_append_tail([SemaPatternCoverageCell]{}, row))
    }
    defaults
}

sema_pattern_matrix_list_rows: fn(rows: [SemaPatternCoverageRow], length: Int, long: Bool) -> [SemaPatternCoverageRow] Never! {
    specialized := [SemaPatternCoverageRow]{}
    loop row in rows {
        if row.cells.len() == 0 -> next
        cells := [SemaPatternCoverageCell]{}
        first: row.cells[0]
        if first == {
            .Any -> loop _ in 0..<length -> cells.push(SemaPatternCoverageCell.Any)
            .Shape(shape) -> if shape == .List(items, rest, _) {
                if rest == None && (long || items.len() != length) -> next
                if items.len() > length -> next
                loop index in 0..<length {
                    cells.push(if index < items.len() -> sema_pattern_matrix_slot(items[index]) else -> SemaPatternCoverageCell.Any)
                }
            } else {
                next
            }
            .Refutable -> next
        }
        specialized.push(sema_pattern_matrix_append_tail(cells, row))
    }
    specialized
}

sema_pattern_matrix_list_complete: fn(rows: [SemaPatternCoverageRow], elem: Type, length: Int, long: Bool, tail: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    types := (loop _ in 0..<length -> elem)
    loop ty in tail -> types.push(ty.copy())
    sema_pattern_matrix_complete(sema_pattern_matrix_list_rows(rows, length, long), types, environment, program)
}

sema_pattern_matrix_list_limit: fn(rows: [SemaPatternCoverageRow]) -> Int Never! {
    limit := 0
    loop row in rows {
        if row.cells.len() > 0 && row.cells[0] == .Shape(shape) && shape == .List(items, _, _) {
            if items.len() > limit -> limit = items.len()
        }
    }
    limit
}

sema_pattern_matrix_map_total: fn(shape: TPatternShape) -> Bool Never! {
    if shape == .Map(entries, rest, _) {
        if !rest -> return false
        loop entry in entries {
            if !entry.optional || sema_pattern_matrix_slot(entry.slot) != SemaPatternCoverageCell.Any -> return false
        }
        return true
    }
    false
}

sema_pattern_matrix_constructors: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> [SemaPatternCoverageConstructor] Never! {
    if ty == {
        .Option(inner) -> {
            return [SemaPatternCoverageConstructor]{
                {name: "Val", payload: [Type]{inner}},
                {name: "None", payload: [Type]{}},
            }
        }
        .Result(ok, err) -> {
            return [SemaPatternCoverageConstructor]{
                {name: "Ok", payload: [Type]{ok}},
                {name: "Err", payload: [Type]{err}},
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    names: sema_coverage_missing(ty, [String]{}, environment, program)
    constructors := [SemaPatternCoverageConstructor]{}
    ignored := [Diagnostic]{}
    loop name in names {
        payload: sema_pattern_payload(ty, name, environment, program, Span{start: 0, end: 0}, ignored)
        constructors.push(SemaPatternCoverageConstructor{name: name, payload: payload.types})
    }
    constructors
}

sema_pattern_matrix_head: fn(shape: TPatternShape) -> String? Never! {
    if shape == {
        .Variant(name, _, _, _) -> Val(name)
        .Present(_, _, _, _) -> Val("Val")
        .Absent(_) -> Val("None")
        .Ok(_, _, _, _) -> Val("Ok")
        .Err(_, _, _, _) -> Val("Err")
        .Range(_, _, _) | .Or(_, _) | .Struct(_, _) | .List(_, _, _) | .Map(_, _, _) | .Text(_, _) | .Binary(_, _) -> None
    }
}

sema_pattern_matrix_constructor_rows: fn(rows: [SemaPatternCoverageRow], constructor: SemaPatternCoverageConstructor) -> [SemaPatternCoverageRow] Never! {
    specialized := [SemaPatternCoverageRow]{}
    loop row in rows {
        if row.cells.len() == 0 -> next
        cells := (loop _ in constructor.payload -> SemaPatternCoverageCell.Any)
        if row.cells[0] == {
            .Any -> {}
            .Refutable -> next
            .Shape(shape) -> {
                head: sema_pattern_matrix_head(shape) ?? next
                if head != constructor.name && !constructor.name.starts_with("{head}.") -> next
                if head == constructor.name {
                    if shape == {
                        .Variant(_, slots, _, _) -> loop (index, slot) in slots {
                            if index < cells.len() -> cells[index] = sema_pattern_matrix_slot(slot)
                        }
                        .Present(_, _, inner, _) | .Ok(_, _, inner, _) | .Err(_, _, inner, _) -> {
                            if inner == .Val(nested) && cells.len() > 0 -> cells[0] = SemaPatternCoverageCell.Shape{shape: nested.shape}
                        }
                        .Absent(_) | .Range(_, _, _) | .Or(_, _) | .Struct(_, _) | .List(_, _, _) | .Map(_, _, _) | .Text(_, _) | .Binary(_, _) -> {}
                    }
                }
            }
        }
        specialized.push(sema_pattern_matrix_append_tail(cells, row))
    }
    specialized
}

sema_pattern_matrix_complete: fn(written_rows: [SemaPatternCoverageRow], types: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if types.len() == 0 -> return written_rows.len() > 0
    rows: sema_pattern_matrix_expand(written_rows)
    if rows.len() == 0 -> return false
    tail: sema_pattern_matrix_tail(types)
    defaults: sema_pattern_matrix_default(rows)
    if sema_pattern_matrix_complete(defaults, tail, environment, program) -> return true
    ty: sema_pattern_unwrap_tags(types[0])
    if ty == {
        .List(elem) -> {
            limit: sema_pattern_matrix_list_limit(rows)
            loop length in 0..limit {
                if !sema_pattern_matrix_list_complete(rows, elem, length, false, tail, environment, program) -> return false
            }
            return sema_pattern_matrix_list_complete(rows, elem, limit + 1, true, tail, environment, program)
        }
        .FixedList(elem, measure) -> {
            length: measure_literal_value(measure) ?? return false
            return sema_pattern_matrix_list_complete(rows, elem, length, false, tail, environment, program)
        }
        .Map(_, _, _) -> {
            settled := [SemaPatternCoverageRow]{}
            loop row in rows {
                if row.cells.len() > 0 && row.cells[0] == .Shape(shape) && sema_pattern_matrix_map_total(shape) {
                    settled.push(sema_pattern_matrix_append_tail([SemaPatternCoverageCell]{}, row))
                }
            }
            return sema_pattern_matrix_complete(settled, tail, environment, program)
        }
        .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    if program.registration_graph == .Val(graph) && sema_pattern_nominal_row(graph, environment.module_identity, ty) == .Val(owner) {
        nominal: graph.modules[owner.module_index].nominals[owner.row]
        if nominal.kind == SemaRegistrationNominalKind.Struct {
            field_types := [Type]{}
            generic_names: loop parameter in nominal.generic_params -> parameter.name
            args: sema_pattern_subject_args(ty)
            loop field in nominal.fields -> field_types.push(sema_inference_substitute_type(field.ty, generic_names, args))
            specialized := [SemaPatternCoverageRow]{}
            loop row in rows {
                if row.cells.len() == 0 -> next
                cells := (loop _ in field_types -> SemaPatternCoverageCell.Any)
                if row.cells[0] == .Shape(shape) && shape == .Struct(written, _) {
                    loop (index, declared) in nominal.fields {
                        loop field in written {
                        if field == {
                            .Bind(_, _, _) -> {}
                            .Value(name, _, _) -> if name == declared.symbol.name -> cells[index] = SemaPatternCoverageCell.Refutable
                            .Nested(name, nested, _) -> if name == declared.symbol.name -> cells[index] = SemaPatternCoverageCell.Shape{shape: nested.shape}
                        }
                        }
                    }
                } else if row.cells[0] != SemaPatternCoverageCell.Any -> next
                specialized.push(sema_pattern_matrix_append_tail(cells, row))
            }
            loop rest_ty in tail -> field_types.push(rest_ty)
            return sema_pattern_matrix_complete(specialized, field_types, environment, program)
        }
    }
    constructors: sema_pattern_matrix_constructors(ty, environment, program)
    if constructors.len() == 0 -> return false
    loop constructor in constructors {
        payload := constructor.payload
        loop rest_ty in tail -> payload.push(rest_ty)
        if !sema_pattern_matrix_complete(sema_pattern_matrix_constructor_rows(rows, constructor), payload, environment, program) -> return false
    }
    true
}

sema_pattern_collection_witness: fn(ty: Type, rows: [SemaPatternCoverageRow], environment: SemaScopeEnvironment, program: SemaProgramTables) -> String Never! {
    if ty == .List(elem) {
        limit: sema_pattern_matrix_list_limit(rows)
        loop length in 0..limit {
            if !sema_pattern_matrix_list_complete(rows, elem, length, false, [Type]{}, environment, program) {
                items: loop _ in 0..<length -> "_"
                return "[{items.join(", ")}]"
            }
        }
        return "[_, ..]"
    }
    "_"
}

sema_pattern_matrix_needed: fn(shape: TPatternShape) -> Bool Never! {
    if shape == {
        .Struct(_, _) | .List(_, _, _) | .Map(_, _, _) -> true
        .Variant(_, slots, _, _) -> {
            loop slot in slots {
                if slot == .Nested(inner) && sema_pattern_matrix_needed(inner.shape) -> return true
            }
            false
        }
        .Present(_, _, inner, _) | .Ok(_, _, inner, _) | .Err(_, _, inner, _) -> if inner == .Val(nested) -> sema_pattern_matrix_needed(nested.shape) else -> false
        .Or(alternatives, _) -> {
            loop alternative in alternatives {
                if sema_pattern_matrix_needed(alternative) -> return true
            }
            false
        }
        .Absent(_) | .Range(_, _, _) | .Text(_, _) | .Binary(_, _) -> false
    }
}

sema_coverage_any_multi_field_nested: fn(shapes: [TPatternShape]) -> Bool Never! {
    loop shape in shapes {
        if sema_coverage_multi_field_nested(shape) -> return true
    }
    false
}

// Whether `shape` holds, at any depth, a case pattern with more than one
// payload field where one field is itself a nested pattern.
sema_coverage_multi_field_nested: fn(shape: TPatternShape) -> Bool Never! {
    if shape == {
        .Variant(_, slots, _, _) -> {
            loop slot in slots {
                if slot == .Nested(inner) {
                    if slots.len() > 1 || sema_coverage_multi_field_nested(inner.shape) -> return true
                }
            }
            false
        }
        .Present(_, _, inner, _) | .Ok(_, _, inner, _) | .Err(_, _, inner, _) -> if inner == .Val(nested) -> sema_coverage_multi_field_nested(nested.shape) else -> false
        .Or(alternatives, _) -> sema_coverage_any_multi_field_nested(alternatives)
        .Absent(_) | .Range(_, _, _) | .Struct(_, _) | .List(_, _, _) | .Map(_, _, _) | .Text(_, _) | .Binary(_, _) -> false
    }
}
