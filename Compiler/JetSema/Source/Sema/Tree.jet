    Drop(value: TExpr)
    Close(value: TExpr)
    Move(value: TExpr)
    AmbientInput(prompt: TExpr?)
    RequireStop(kind: TRequireKind, location: TPanicLoc, always_stops: Bool)
    Binary(op: TBinaryOp, overflow: Bool, line: Int, lhs: TExpr, rhs: TExpr)
    CompareChain(operands: [TExpr], operators: [TBinaryOp], hooks: [Bool])
    Unary(op: TUnaryOp, operand: TExpr)
    StructLit(fields: [TStructFieldValue])
    Field(receiver: TExpr, field: TFieldRef)
    Index(base: TExpr, index: TExpr, kind: TIndexKind, access: AccessConvention, checked_call: SymbolID?, location: TPanicLoc)
    Slice(base: TExpr, start: TExpr, end: TExpr, range: TExpr?, location: TPanicLoc)
    Range(start: TExpr, end: TExpr, exclusive: Bool)
    Tuple(values: [TExpr])
    List(values: [TExpr], trait_coercion: Type?)
    Map(entries: [TMapEntry])
    Try(value: TExpr, conversion: TTryConvert, failure: TFailureCarrier)
    TryWithContext(inner: TExpr, note: TExpr?, convert: TTryConvert, file: String, line: Int, function: String)
    Lambda(value: TLambda)
    Borrow(place: TExpr, access: AccessConvention)
    RawAddressOf(place: TPlace)
    Deref(value: TExpr)
    PtrFromAddr(address: TExpr, element: Type)
    LayoutLiteral(value: TExpr)
    LayoutCompare(op: TBinaryOp, lhs: TExpr, rhs: TExpr)
    SharedGuardValue(guard: TExpr)
    SharedGuardWait(guard: TExpr, condition: TExpr, predicate: TLambda)
    CoreCall(record: CoreCallRecord, args: [TExpr], source_span: Span, type_args: [Type], widen_to_vec: [Bool], fallibility: TFailureCarrier)
    HostCall(call: THostCall)
    AllocNew(ctor: TAllocCtor, args: [TCallArg])
    EnumLit(enum_type: String, variant: String, payload: TEnumPayload)
    JSONLit(variant: String, arg: TExpr?, clone_arg: Bool)
    ListLit(values: [TExpr])
    ListSpread(parts: [TListSpreadPart])
    MapLit(entries: [TMapEntry])
    PoolSlot(pool: TExpr, id: TExpr, mutable: Bool, field: String?, line: Int, source_line: String)
    // #4318: `fact` is the sema decision behind the copy; MIR keeps it on Copy.
    Clone(value: TExpr, fact: CopyFact)
    ExplicitCopy(value: TExpr)
    MaterializeView(value: TExpr)
    StaticCall(owner: TStaticOwner, owner_type: Type?, method: TMethodRef, type_args: [Type], args: [TCallArg])
    BuiltinMethod(receiver: TExpr, operation: TBuiltinOp, args: [TExpr])
    IfExpr(cond: TIfCond, then_body: [TStmt], then_value: TExpr, else_body: [TStmt], else_value: TExpr)
    ResultHandler(subject: TExpr, ok_pattern: TPattern, ok_body: [TStmt], ok_value: TExpr, err_pattern: TPattern, err_body: [TStmt], err_value: TExpr, terminal: TExpr)
    RawOf(value: TExpr)
    DistinctRaw(value: TExpr)
    Present(value: TExpr)
    Ok(value: TExpr)
    Err(value: TExpr)
    OrFallback(value: TExpr, fallback: TOrFallback, ambient_err: TLocal?)
    OptField(base: TExpr, member: String, flatten: Bool)
    OptMethodCall(base: TExpr, binding: TLocal, call: TExpr, flatten: Bool)
    PatternMatches(subject: TExpr, pattern: TPattern)
    ClosureMethod(receiver: TExpr, operation: TClosureOp, args: [TExpr])
    NumericMethod(receiver: TExpr, operation: TNumericOp)
    NumericBinaryMethod(receiver: TExpr, operation: TNumericOp, argument: TExpr)
    OverflowOpt(prefix: String, operation: String, line: Int, lhs: TExpr, rhs: TExpr)
    HandleMethod(receiver: TExpr, operation: THandleOp, args: [TExpr])
    CoreClosureCall(kind: TCoreClosureKind)
    TaskGroupAll(tasks: TExpr)
    TaskGroupRace(tasks: TExpr)
    TaskGroupAny(tasks: TExpr)
    SelectRecv(builder: TExpr, channel: TExpr)
    SelectAfter(builder: TExpr, duration: TExpr, value: TExpr?)
    FnValue(kind: TFnValueKind)
    // A node the checker built as row `index` of its arena (sema_node): the
    // row's NodeKind holds the node, with arena row indices as children.
    Flat(index: Int)
}

// `id` keys the node's row in its function's flat body (BodyFlatten.jet): the
// AST NodeId of the expression sema checked it from, or a negative
// function-local id (below AST_NODE_GENERATED) for a node the checker gave
// one in its context (sema_check_record_expr_id). A node built without one is
// AST_NODE_GENERATED and takes a fresh id when it is flattened.
struct TExpr {
    ty: Type
    kind: TExprKind
    span: Span
    id: Int{-1}
}

// Gives `value` a type other than the one its checked source node has (a
// coercion or wrapper retyping a checked node): the node leaves its source
// id and takes a function-local one of its own when it is flattened.
fn tir_expr_retype(value: &TExpr, ty: Type) Never! {
    value.ty = ty
    value.id = AST_NODE_GENERATED
}

