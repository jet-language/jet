enum TStrPart {
    Literal(text: String)
    Interpolation(value: TExpr, format: TStrFormat)
}

struct TCallArg {
    value: TExpr
    template_items: [SymbolID]
    borrow: Bool
    mut_borrow: Bool
    fn_coerce: TFnCoerce?
    widen_to_vec: Bool
    widen_to_union: Type?
    box_as_trait: Type?
    label: String?
    spread: Bool
}

struct TEnumArg {
    value: TExpr
}

enum TEnumPayload {
    Unit
    Positional(args: [TEnumArg])
    Named(fields: [TNamedEnumArg])
}

struct TNamedEnumArg {
    name: String
    value: TEnumArg
}

enum TPatternShape {
    Variant(variant: String, bindings: [TPatternBinding], leading_dot: Bool, span: Span)
    // S31: `inner` is a nested payload pattern (`.Val(.Rect(w, h))`).
    Present(binding: String, binding_span: Span, inner: TNestedPattern?, span: Span)
    Absent(span: Span)
    Ok(binding: String, binding_span: Span, inner: TNestedPattern?, span: Span)
    Err(binding: String, binding_span: Span, inner: TNestedPattern?, span: Span)
    Range(lo: Int, hi: Int, span: Span)
    Or(alternatives: [TPatternShape], span: Span)
    Struct(fields: [TPatternField], span: Span)
    List(items: [TPatternBinding], rest: TListPatternRest?, span: Span)
    Map(entries: [TMapPatternEntry], rest: Bool, span: Span)
    Text(parts: [TTextPatternPart], span: Span)
    Binary(parts: [TBinaryPatternPart], span: Span)
}

// S31: a checked nested payload pattern with the payload type's owner.
struct TNestedPattern {
    shape: TPatternShape
    enum_type: SymbolID?
}

struct TPattern {
    shape: TPatternShape
    bindings: [TPatternBindingFact]
    enum_type: SymbolID?
    position: TPatternPosition
    mutable: Bool
    boxed: Bool
}

enum TPatternBinding {
    Wildcard
    Bind(name: String, span: Span)
    Range(lo: Int, hi: Int)
    Nested(pattern: TNestedPattern)
    Value(value: TExpr)
}

enum TPatternField {
    Bind(field: String, local: String, span: Span)
    Value(field: String, value: TExpr, span: Span)
    Nested(field: String, pattern: TNestedPattern, span: Span)
}

struct TMapPatternEntry {
    key: TExpr
    optional: Bool
    slot: TPatternBinding
    span: Span
}

// Logical key identity ignores source spelling and resolved constant aliases.
fn tir_pattern_key_identity(key: TExpr, context: SemaCheckContext) -> String? Never! {
    if key.kind == {
        .IntLit(value, _) -> Val("int:{value}")
        .StrLit(value) -> Val("text:{value}")
        // A scalar literal or a constant reference is a flat row (sema_node).
        .Flat(index) -> if context.arena.tree.nodes[index - context.arena.tree.node_base].kind == {
            .BoolLit(value) -> Val("bool:{value}")
            .CharLit(value) -> Val("char:{value}")
            .ConstRef(symbol) -> Val("constant:{symbol.key}")
            else -> None
        }
        .EnumLit(owner, variant, _) -> Val("enum:{owner}:{variant}")
        .Unary(op, value) -> {
            if op == TUnaryOp.Neg && value.kind == .IntLit(number, _) -> Val("int:{-number}") else -> None
        }
        .CtLit(value) -> if value == {
            .Int(number) -> Val("int:{number}")
            .BigInt(number) -> Val("int:{number}")
            .String(text) -> Val("text:{text}")
            .Bool(flag) -> Val("bool:{flag}")
            .Char(character) -> Val("char:{character}")
            .Enum(owner, variant, _) -> Val("enum:{owner}:{variant}")
            else -> None
        }
        else -> None
    }
}

struct TMatchArm {
    pattern: TPattern
    body: [TStmt]
}

enum TIfCond {
    Plain(value: TExpr)
    And(left: TIfCond, right: TIfCond)
    IfLet(pattern: TPattern, subj: TExpr)
}

struct TContract {
    kind: TContractKind
    condition: TExpr
    message: TExpr
    file: String
    line: Int
    span: Span
    disposition: TContractDisposition
}

enum TStmt {
    Contract(contract: TContract)
    ContractScope(pre: [TContract], body: [TStmt], post: [TContract], result: TContractResult, span: Span)
    Let(local: TLocal, let_ty: TLetTy, init: TExpr, gc_promotion: TGCPromotion?, gc_transferred: Bool, span: Span)
    RefutableBind(pattern: TPattern, init: TExpr, fallback: [TStmt], span: Span)
    TupleDestructure(temp: TLocal, init: TExpr, move_fields: Bool, binds: [TDestructureBinding], span: Span)
    StructDestructure(temp: TLocal, init: TExpr, move_fields: Bool, binds: [TDestructureBinding], span: Span)
    ListDestructure(temp: TLocal, init: TExpr, count: Int, line: Int, elements: [TLocal], span: Span)
    Assign(place: TPlace, op: TBinaryOp?, value: TExpr, line: Int, span: Span)
    CountedLoop(label: String?, init: TStmt, condition: TExpr, step: TStmt?, vectorization: AutoVectorizationFacts?, body: [TStmt], span: Span)
    ForRange(label: String?, local: TLocal, start: TExpr, end: TExpr, step: TExpr?, exclusive: Bool, body: [TStmt], vectorization: AutoVectorizationFacts?, span: Span)
    Range(label: String?, variable: TLocal, source: TExpr?, start: TExpr, end: TExpr, step: TExpr?, exclusive: Bool, vectorization: AutoVectorizationFacts?, body: [TStmt], span: Span)
    ExprStmt(value: TExpr, span: Span)
    Return(value: TExpr?, span: Span)
    TaskGroup(group: TLocal, limit: TExpr?, body: [TStmt], span: Span)
    DeferClose(close: TExpr, resource: SymbolID, span: Span)
    If(condition: TIfCond, then_body: [TStmt], else_body: [TStmt]?, else_is_elseif: Bool, span: Span)
    Loop(label: String?, body: [TStmt], span: Span)
    While(label: String?, condition: TExpr, body: [TStmt], span: Span)
    Break(label: String?, span: Span)
    BreakValue(label: String?, value: TExpr, span: Span)
    Continue(label: String?, span: Span)
    Match(subject: TExpr, arms: [TMatchArm], exhaustive: Bool, span: Span)
    EnumMatch(scrutinee: TExpr, arms: [TMatchArm], else_body: [TStmt]?, fallthrough: Bool, span: Span)
    RangeSwitch(subject: TExpr, arms: [TRangeArm], else_body: [TStmt], span: Span)
    ForIn(label: String?, variable: TLocal, variable_two: TLocal?, source: TExpr, collection: TExpr, step: TExpr?, method_kind: TForInMethod?, columnar: Bool, by_value: Bool, source_stable: Bool, body: [TStmt], span: Span)
    Inline(body: [TStmt], span: Span)
    DebugOnly(body: [TStmt], span: Span)
    MixedSwitch(subject: TExpr, class: TBranchClass, arms: [TMixedArm], else_body: [TStmt]?, span: Span)
    Unsafe(gate: TUnsafeGate, body: [TStmt])
    UnsafeBlock(gate: TUnsafeGate, body: [TStmt], span: Span)
    SentryPolicy(enabled: Bool, body: [TStmt], span: Span)
    Impure(body: [TStmt], span: Span)
    Reactive(executable: TLambda, span: Span)
    Region(body: [TStmt], span: Span)
    Layout(handle: TLocal, label: String, body: [TStmt], span: Span)
    ContextBlock(guards: [TContextGuard], body: [TStmt], span: Span)
    Live(body: [TStmt], span: Span)
    Shield(body: [TStmt], span: Span)
    ScopeMember(kind: TScopeMemberKind, body: [TStmt], span: Span)
    Transact(handle: TLocal?, snapshots: [TTransactionSnapshot], stm: TLocal?, body: [TStmt], span: Span)
    GCEdit(root: String, slot: String, edges: [String], replace_all: Bool, index_temp: TExpr?, statement: TStmt, span: Span)
}

