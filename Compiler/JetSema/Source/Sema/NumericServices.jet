// Private compiler numeric services: exact unit conversion proofs through the
// service the host installs (sema_numeric_unit_conversion_exact_service).
use {
    jet_foundation.[
        UnitRatio,
    ]
    math: core.math
}

SemaNumericUnitConversionProof: enum {
    Exact(value: Float)
    Inexact
    Unavailable
}

// How a check reaches the host callbacks (SemaRegistrationHostHooks). A check
// on the thread that owns them calls them. Callbacks never cross a compiler
// thread, so a check on another one finds them withheld: it records that it
// wanted them in the shared `wanted` row, and its function is checked again on
// the owning thread. A check with no access at all (no registration graph) has
// no callbacks.
SemaHostHookAccess: enum {
    Callbacks(hooks: Shared<SemaRegistrationHostHooks>, observed: Shared<SemaBodyCheckReach>?)
    Withheld(wanted: Shared<SemaHostHookWanted>, observed: Shared<SemaBodyCheckReach>?)
}

SemaHostHookWanted: struct {
    wanted: Bool
}

// Sticky for one accepted logical body query, including share-site passes and
// the owning thread's retry. A cold check has no observer and allocates none.
SemaBodyCheckReach: struct {
    host: Bool
    foreign_raw_body: Bool
}

sema_host_hook_access: fn(hooks: Shared<SemaRegistrationHostHooks>) -> SemaHostHookAccess? {
    Val(SemaHostHookAccess.Callbacks{hooks: hooks, observed: None})
}

// The callbacks behind `access`, or None. A withheld access records that this
// check wanted them.
sema_host_hook_callbacks: fn(access: SemaHostHookAccess?) -> Shared<SemaRegistrationHostHooks>? {
    row: access ?? return None
    if row == {
        .Callbacks(hooks, observed) -> {
            sema_body_check_mark_host(observed)
            Val(hooks)
        }
        .Withheld(wanted, observed) -> {
            sema_body_check_mark_host(observed)
            cell := wanted
            permit: cell.guard_edit()
            permit.value.wanted = true
            None
        }
    }
}

// Whether `access` withholds the callbacks (a check on a compiler thread).
sema_host_hooks_withheld: fn(access: SemaHostHookAccess?) -> Bool {
    row: access ?? return false
    if row == {
        .Callbacks(_, _) -> false
        .Withheld(_, _) -> true
    }
}

sema_body_check_observe: fn(access: SemaHostHookAccess?, observed: Shared<SemaBodyCheckReach>?) -> SemaHostHookAccess? {
    // copy: the observed access is a new owned Option. With nothing observed it equals `access`,
    // the caller's host-hook access (a read parameter), which the caller keeps for its other body
    // checks.
    if observed == None -> return access.copy()
    row: access ?? return None
    Val(if row == {
        .Callbacks(hooks, _) -> SemaHostHookAccess.Callbacks{hooks: hooks, observed: observed}
        .Withheld(wanted, _) -> SemaHostHookAccess.Withheld{wanted: wanted, observed: observed}
    })
}

sema_body_check_mark_host: fn(observed: Shared<SemaBodyCheckReach>?) {
    cell: observed ?? return
    permit: cell.guard_edit()
    permit.value.host = true
}

sema_body_check_mark_foreign_raw_body: fn(access: SemaHostHookAccess?) {
    row: access ?? return
    observed: if row == {
        .Callbacks(_, observer) -> observer
        .Withheld(_, observer) -> observer
    }
    cell: observed ?? return
    permit: cell.guard_edit()
    permit.value.foreign_raw_body = true
}

sema_numeric_unit_conversion_exact: fn(access: SemaHostHookAccess?, value: Float, scale: UnitRatio, offset: UnitRatio) -> SemaNumericUnitConversionProof {
    hooks: sema_host_hook_callbacks(access) ?? return SemaNumericUnitConversionProof.Unavailable
    callback: hooks.numeric_unit_conversion_exact ?? return SemaNumericUnitConversionProof.Unavailable
    result: callback(value, "{scale.numerator}", "{scale.denominator}", "{offset.numerator}", "{offset.denominator}") ?? return SemaNumericUnitConversionProof.Inexact
    SemaNumericUnitConversionProof.Exact{value: result}
}

// The exact unit conversion service the host installs: `value * scale +
// offset`, each ratio given as numerator and denominator text, when that is
// an integer some Float holds exactly; else None.
sema_numeric_unit_conversion_exact_service: fn(value: Float, scale_numerator: String, scale_denominator: String, offset_numerator: String, offset_denominator: String) -[]> Float? {
    if !math.is_finite(value) -> return None
    // `value` is exactly `top / bottom`, `bottom` a power of two.
    bits: math.to_bits(value)
    exponent: (bits >> 52).bit_and(2047)
    top := bits.bit_and(4503599627370495)
    power := -1074
    if exponent != 0 {
        top = top.bit_or(4503599627370496)
        power = exponent - 1075
    }
    bottom := 1
    loop power > 0 {
        top = top * 2
        power -= 1
    }
    loop power < 0 {
        bottom = bottom * 2
        power += 1
    }
    if value < 0.0 -> top = -top
    numerator := top * sema_numeric_ratio_part(scale_numerator) * sema_numeric_ratio_part(offset_denominator) + sema_numeric_ratio_part(offset_numerator) * bottom * sema_numeric_ratio_part(scale_denominator)
    denominator := bottom * sema_numeric_ratio_part(scale_denominator) * sema_numeric_ratio_part(offset_denominator)
    if denominator == 0 -> return None
    if denominator < 0 {
        numerator = -numerator
        denominator = -denominator
    }
    if numerator %% denominator != 0 -> return None
    converted: numerator /% denominator
    if converted == 0 -> return Val(0.0)
    // A Float holds the integer when its odd part fits 53 bits below 2^1024.
    odd := if converted < 0 -> -converted else -> converted
    shift := 0
    loop odd %% 2 == 0 {
        odd = odd /% 2
        shift += 1
    }
    width := 0
    remaining := odd
    loop remaining > 0 {
        remaining = remaining /% 2
        width += 1
    }
    if width > 53 || shift + width > 1024 -> return None
    result := Float.from_int(odd)
    loop shift > 0 {
        result = result * 2.0
        shift -= 1
    }
    Val(if converted < 0 -> -result else -> result)
}

sema_numeric_ratio_part: fn(text: String) -[]> Int {
    negative := false
    total := 0
    loop byte in text.bytes() {
        code: Int.from_u8(byte)
        if code == 45 -> negative = true
        else -> total = total * 10 + (code - 48)
    }
    if negative -> -total else -> total
}
