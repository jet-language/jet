// Private compiler numeric services.  The Source Sema asks the configured
// native service for exact unit conversion proofs; arithmetic remains owned by
// Foundation's canonical unit kernel.
use jet_foundation.[
    UnitRatio,
]

enum SemaNumericUnitConversionProof {
    Exact(value: Float)
    Inexact
    Unavailable
}

// How a check reaches the host callbacks (SemaRegistrationHostHooks). A check
// on the thread that owns them calls them. Callbacks never cross a compiler
// thread, so a check on another one finds them withheld: it records that it
// wanted them in the shared `wanted` row, and its function is checked again on
// the owning thread. A check with no access at all (no registration graph) has
// no callbacks.
enum SemaHostHookAccess {
    Callbacks(hooks: Shared<SemaRegistrationHostHooks>, observed: Shared<SemaBodyCheckReach>?)
    Withheld(wanted: Shared<SemaHostHookWanted>, observed: Shared<SemaBodyCheckReach>?)
}

struct SemaHostHookWanted {
    wanted: Bool
}

// Sticky for one accepted logical body query, including share-site passes and
// the owning thread's retry. A cold check has no observer and allocates none.
struct SemaBodyCheckReach {
    host: Bool
    foreign_raw_body: Bool
}

fn sema_host_hook_access(hooks: Shared<SemaRegistrationHostHooks>) -> SemaHostHookAccess? {
    Val(SemaHostHookAccess.Callbacks{hooks: hooks, observed: None})
}

// The callbacks behind `access`, or None. A withheld access records that this
// check wanted them.
fn sema_host_hook_callbacks(access: SemaHostHookAccess?) -> Shared<SemaRegistrationHostHooks>? {
    row :: access ?? return None
    if row == {
        .Callbacks(hooks, observed) -> {
            sema_body_check_mark_host(observed)
            Val(hooks)
        }
        .Withheld(wanted, observed) -> {
            sema_body_check_mark_host(observed)
            cell := wanted
            permit :: cell.guard_edit()
            permit.value.wanted = true
            None
        }
    }
}

// Whether `access` withholds the callbacks (a check on a compiler thread).
fn sema_host_hooks_withheld(access: SemaHostHookAccess?) -> Bool {
    row :: access ?? return false
    if row == {
        .Callbacks(_, _) -> false
        .Withheld(_, _) -> true
    }
}

fn sema_body_check_observe(access: SemaHostHookAccess?, observed: Shared<SemaBodyCheckReach>?) -> SemaHostHookAccess? {
    // copy: the observed access is a new owned Option. With nothing observed it equals `access`,
    // the caller's host-hook access (a read parameter), which the caller keeps for its other body
    // checks.
    if observed == None -> return access.copy()
    row :: access ?? return None
    Val(if row == {
        .Callbacks(hooks, _) -> SemaHostHookAccess.Callbacks{hooks: hooks, observed: observed}
        .Withheld(wanted, _) -> SemaHostHookAccess.Withheld{wanted: wanted, observed: observed}
    })
}

fn sema_body_check_mark_host(observed: Shared<SemaBodyCheckReach>?) {
    cell :: observed ?? return
    permit :: cell.guard_edit()
    permit.value.host = true
}

fn sema_body_check_mark_foreign_raw_body(access: SemaHostHookAccess?) {
    row :: access ?? return
    observed :: if row == {
        .Callbacks(_, observer) -> observer
        .Withheld(_, observer) -> observer
    }
    cell :: observed ?? return
    permit :: cell.guard_edit()
    permit.value.foreign_raw_body = true
}

fn sema_numeric_unit_conversion_exact(access: SemaHostHookAccess?, value: Float, scale: UnitRatio, offset: UnitRatio) -> SemaNumericUnitConversionProof {
    hooks :: sema_host_hook_callbacks(access) ?? return SemaNumericUnitConversionProof.Unavailable
    callback :: hooks.numeric_unit_conversion_exact ?? return SemaNumericUnitConversionProof.Unavailable
    result :: callback(value, "{scale.numerator}", "{scale.denominator}", "{offset.numerator}", "{offset.denominator}") ?? return SemaNumericUnitConversionProof.Inexact
    SemaNumericUnitConversionProof.Exact{value: result}
}
