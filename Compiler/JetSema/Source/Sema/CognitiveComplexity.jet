// Rust: crates/jet-sema/src/Sema/CognitiveComplexity.rs:1
// Deterministic scoring: controls add 1 + enclosing depth, mixed boolean
// sequences add one, direct recursion adds one; lambdas only add depth.
use jet_sema.Diagnostics.[Span]
use jet_sema.AST.[BinOp, Expr, Func, Item, LambdaBody, Program, Stmt]

// Rust: crates/jet-sema/src/Sema/CognitiveComplexity.rs:13
pub struct CognitiveComplexityReport {
    name: String
    span: Span
    score: U32
}

// Rust: crates/jet-sema/src/Sema/CognitiveComplexity.rs:19
pub fn cognitive_complexity_reports(program: Program) -> [CognitiveComplexityReport] Never! {
    functions := [&Func]{}
    collect_items(program.items, &functions)
    reports := [CognitiveComplexityReport]{}
    loop function in functions {
        reports.push(CognitiveComplexityReport{name: function.name.clone(), span: function.span, score: cognitive_complexity(function)})
    }
    reports.sort_by(fn(left: CognitiveComplexityReport, right: CognitiveComplexityReport) {
        right.score.cmp(left.score).then_with(fn() { left.span.start.cmp(right.span.start) }).then_with(fn() { left.name.cmp(right.name) })
    })
    reports
}

// Rust: crates/jet-sema/src/Sema/CognitiveComplexity.rs:40
fn collect_items(items: [Item], functions: &[&Func]) Never! {
    loop item in items {
        if item == {
            .Func(function) -> functions.push(&function)
            .Impl(implementation) -> { loop method in implementation.methods { functions.push(&method) } }
            .Struct(definition) -> {
                loop method in definition.methods { functions.push(&method) }
                loop implementation in definition.trait_impls { loop method in implementation.methods { functions.push(&method) } }
            }
            .Enum(definition) -> {
                loop method in definition.methods { functions.push(&method) }
                loop implementation in definition.trait_impls { loop method in implementation.methods { functions.push(&method) } }
            }
            .CodeModule(module) -> { if module.body == .Val(body) { collect_items(body, functions) } }
            .GenericModule(module) -> collect_items(module.body, functions)
            _ -> {}
        }
    }
}

// Rust: crates/jet-sema/src/Sema/CognitiveComplexity.rs:68
fn cognitive_complexity(function: Func) -> U32 Never! {
    body := function.body.clone()
    controls := [Span]{}
    nesting := [Span]{}
    mixed_boolean_sequences := 0 as U32
    recursive := false
    loop &statement in body {
        visit_statement_shapes(statement, &controls, &nesting)
        statement.for_each_expr_mut(fn(expression: &Expr) Never! {
            if expression == {
                .If(.., span) -> { controls.push(span); nesting.push(span) }
                .Lambda(lambda) -> {
                    nesting.push(lambda.span)
                    if lambda.body == .Block(body) {
                        loop statement in body { visit_statement_shapes(statement, &controls, &nesting) }
                    }
                }
                .Call(call) -> { if call.name == function.name { recursive = true } }
                .Binary(.And, ..) | .Binary(.Or, ..) -> {
                    if is_mixed_boolean_sequence(expression) { mixed_boolean_sequences += 1 }
                }
                _ -> {}
            }
        })
    }
    structure_score := 0 as U32
    loop inner in controls {
        structure_score += 1
        loop outer in nesting { if contains(outer, inner) { structure_score += 1 } }
    }
    structure_score + mixed_boolean_sequences + (if recursive -> 1 else -> 0)
}

// Rust: crates/jet-sema/src/Sema/CognitiveComplexity.rs:110
fn contains(outer: Span, inner: Span) -> Bool { outer.start < inner.start && inner.end < outer.end }

// Rust: crates/jet-sema/src/Sema/CognitiveComplexity.rs:114
fn is_mixed_boolean_sequence(expression: Expr) -> Bool Never! {
    has_and := false
    has_or := false
    collect_boolean_operators(expression, &has_and, &has_or)
    has_and && has_or
}

// Rust: crates/jet-sema/src/Sema/CognitiveComplexity.rs:121
fn collect_boolean_operators(expression: Expr, has_and: &Bool, has_or: &Bool) Never! {
    if expression == {
        .Binary(.And, left, right, _) -> {
            has_and = true
            collect_boolean_operators(left, has_and, has_or)
            collect_boolean_operators(right, has_and, has_or)
        }
        .Binary(.Or, left, right, _) -> {
            has_or = true
            collect_boolean_operators(left, has_and, has_or)
            collect_boolean_operators(right, has_and, has_or)
        }
        .Paren(inner, _) -> collect_boolean_operators(inner, has_and, has_or)
        _ -> {}
    }
}

// Rust: crates/jet-sema/src/Sema/CognitiveComplexity.rs:138
fn visit_statement_shapes(statement: Stmt, controls: &[Span], nesting: &[Span]) Never! {
    // Rust: crates/jet-sema/src/Sema/CognitiveComplexity.rs:139
    fn visit_body(body: [Stmt], controls: &[Span], nesting: &[Span]) Never! {
        loop statement in body { visit_statement_shapes(statement, controls, nesting) }
    }
    if statement == {
        .While{body, span, ..} | .For{body, span, ..} | .Loop{body, span, ..} -> {
            controls.push(span); nesting.push(span)
            visit_body(body, controls, nesting)
        }
        .CountedLoop{body, step, span, ..} -> {
            controls.push(span); nesting.push(span)
            if step == .Val(step) { visit_statement_shapes(step, controls, nesting) }
            visit_body(body, controls, nesting)
        }
        .Switch{arms, else_body, span, ..} | .ComptimeSwitch{arms, else_body, span, ..} -> {
            controls.push(span); nesting.push(span)
            loop arm in arms { visit_body(arm.body, controls, nesting) }
            if else_body == .Val(body) { visit_body(body, controls, nesting) }
        }
        .ComptimeIf{then_body, else_body, span, ..} -> {
            controls.push(span); nesting.push(span)
            visit_body(then_body, controls, nesting)
            if else_body == .Val(body) { visit_body(body, controls, nesting) }
        }
        .Unsafe{body, ..} | .Impure{body, ..} | .Reactive{body, ..}
        | .Shield{body, ..} | .Switched{body, ..} | .Region{body, ..}
        | .Policy{body, ..} | .TaskGroup{body, ..} | .Layout{body, ..}
        | .AuthorityScope{body, ..} | .ComptimeBlock{body, ..} | .Live{body, ..}
        | .Transact{body, ..} | .ScopeMember{body, ..} | .ContextBlock{body, ..}
        | .AssumeDet{body, ..} -> visit_body(body, controls, nesting)
        _ -> {}
    }
}
