// Compiler-owned Shared/Cell callback and plain-field access seam.
//
// Shared field syntax is lowered to the existing read/edit callback methods;
// the callback argument is tagged with CallArgFlags.shared_access_desugar so
// retired user-written Shared.read/edit spelling cannot reach this route.
use jet_foundation.[
    AccessConvention,
    BinOp,
    CallArg,
    EffectRowEntry,
    Expr,
    LValue,
    Lambda,
    LambdaBody,
    LambdaParam,
    NamedSpan,
    Span,
    Stmt,
    Type,
    ast_empty_call_arg_flags,
    ast_empty_lambda_meta,
    expr_span,
]

SEMA_SHARED_PAYLOAD_PARAM :: prep { "__jet_shared_value" }
SEMA_SHARED_HOISTED_RHS :: prep { "__jet_shared_rhs" }

fn sema_shared_access_inner(ty: Type) -> Type? {
    if ty == {
        // copy: `inner` is a payload of read parameter `ty`, which keeps the original; the Val carrier owns this one
        .Shared(inner) -> Val(inner.copy())
        else -> None
    }
}

fn sema_shared_access_is_shared_type(ty: Type) -> Bool Never! {
    if ty == {.Shared(_) -> true else -> false}
}

fn sema_shared_access_is_cell_type(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, _) -> name == "Cell"
        else -> false
    }
}

fn sema_shared_access_is_cell_guard_type(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, _) -> name == "CellReadGuard" || name == "CellEditGuard"
        else -> false
    }
}

// The value a `Shared<T>` or a `Cell<T>`-family handle guards.
fn sema_shared_access_guarded_inner(ty: Type) -> Type? {
    if sema_shared_access_inner(ty) == .Val(inner) -> return Val(inner)
    sema_shared_access_cell_inner(ty)
}

fn sema_shared_access_cell_inner(ty: Type) -> Type? {
    if ty == {
        .Apply(name, args) -> if (name == "Cell" || name == "CellReadGuard" || name == "CellEditGuard") && args.len() == 1 -> Val(args[0]) else -> None
        else -> None
    }
}

fn sema_shared_access_is_desugar(args: [CallArg]) -> Bool Never! {
    if args.len() != 1 -> return false
    args[0].flags.shared_access_desugar
}

fn sema_shared_access_host_method(ty: Type, method: String) -> Bool Never! {
    if ty == {
        .Shared(_) -> method == "read" || method == "edit"
        .Apply(name, _) -> if name == {
            "Cell" | "CellEditGuard" -> method == "read" || method == "edit"
            "CellReadGuard" -> method == "read"
            else -> false
        }
        else -> false
    }
}

fn sema_shared_access_host_method_writes(ty: Type, method: String) -> Bool Never! {
    if method != "edit" -> return false
    if ty == {
        .Shared(_) -> true
        .Apply(name, _) -> name == "Cell" || name == "CellEditGuard"
        else -> false
    }
}

fn sema_shared_access_host_method_name(ty: Type, method: String) -> String Never! {
    if ty == {
        .Shared(_) -> "shared.{method}"
        .Apply(name, _) -> if name == {
            "Cell" -> "cell.{method}"
            "CellReadGuard" -> "cell_read_guard.{method}"
            "CellEditGuard" -> "cell_edit_guard.{method}"
            else -> method
        }
        else -> method
    }
}

// Rust `method_calls.rs` (D-REALTIME1): every `Shared<T>` protocol access
// blocks on the cell's lock and records `Time.Wait`, except the wait-free
// scalar `read`/`get`/`set`/`replace` rail. The other Shared owner methods
// (`capture`, `same`, `downgrade`, …) and the Cell family record no effect.
// The row is authoritative: a compiler-owned host call is never an unknown
// callee, so it must not fall back to the maximal effect set.
fn sema_shared_access_effect_row(ty: Type, method: String, span: Span) -> [EffectRowEntry] Never! {
    inner :: sema_shared_access_inner(ty) ?? return [EffectRowEntry]{}
    scalar_atomic :: (method == "read" || method == "get" || method == "set" || method == "replace") && sema_ownership_type_is_scalar(inner)
    protocol :: method == "get" || method == "set" || method == "replace" || method == "read" || method == "edit" || method == "guard_read" || method == "guard_edit" || method == "read_txn" || method == "edit_txn"
    if protocol && !scalar_atomic -> return [EffectRowEntry]{EffectRowEntry{name: "Time.Wait", span: span}}
    [EffectRowEntry]{}
}

fn sema_shared_access_user_method_forbidden(ty: Type, method: String, args: [CallArg]) -> Bool Never! {
    sema_shared_access_is_shared_type(ty) && (method == "read" || method == "edit") && !sema_shared_access_is_desugar(args)
}

fn sema_shared_access_host_callback_type(inner: Type, result: Type?, shared: Bool) -> Type Never! {
    if shared -> Type.Fn{params: [Type]{inner}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None} else -> Type.Fn{params: [Type]{inner}, ret: result, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
}

fn sema_shared_access_expr_ident_is_shared(value: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if value == {
        .Ident(name, _) -> {
            index :: sema_scope_resolve_index(scopes, name) ?? return false
            ty :: scopes.bindings[index].symbol.ty ?? return false
            sema_shared_access_is_shared_type(ty)
        }
        else -> false
    }
}

fn sema_shared_access_expr_list_touches_shared(values: [Expr], scopes: SemaScopeTable) -> Bool {
    loop value in values {
        if sema_shared_access_expr_touches_shared(value, scopes) -> return true
    }
    false
}

fn sema_shared_access_expr_call_args_touches_shared(args: [CallArg], scopes: SemaScopeTable) -> Bool {
    loop argument in args {
        if sema_shared_access_expr_touches_shared(argument.expr, scopes) -> return true
    }
    false
}

fn sema_shared_access_expr_touches_shared(value: Expr, scopes: SemaScopeTable) -> Bool {
    if value == {
        .Field(base, _, _) -> {
            if sema_shared_access_expr_ident_is_shared(base, scopes) -> return true
            return sema_shared_access_expr_touches_shared(base, scopes)
        }
        .OptField(base, _, _, _, _) -> return sema_shared_access_expr_touches_shared(base, scopes)
        .Ident(_, _) -> return false
        .Str(parts, _) -> {
            loop part in parts {
                if part == .Interp(inner, _) && sema_shared_access_expr_touches_shared(inner, scopes) -> return true
            }
        }
        .ListLit(values, _) -> return sema_shared_access_expr_list_touches_shared(values, scopes)
        .MapLit(entries, _) -> {
            loop entry in entries {
                if sema_shared_access_expr_touches_shared(entry.key, scopes) || sema_shared_access_expr_touches_shared(entry.value, scopes) -> return true
            }
        }
        .MemberSpread(base, _, _) -> return sema_shared_access_expr_touches_shared(base, scopes)
        .Spread(inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _) | .Place(inner, _, _) | .Tainted(inner, _, _) | .Present(inner, _) -> return sema_shared_access_expr_touches_shared(inner, scopes)
        .Index(base, index, _, _) -> return sema_shared_access_expr_touches_shared(base, scopes) || sema_shared_access_expr_touches_shared(index, scopes)
        .Slice(base, start, end, range, _) -> {
            if sema_shared_access_expr_touches_shared(base, scopes) || sema_shared_access_expr_touches_shared(start, scopes) || sema_shared_access_expr_touches_shared(end, scopes) -> return true
            if range == {
                .Val(inner) -> return sema_shared_access_expr_touches_shared(inner, scopes)
                else -> {}
            }
        }
        .Range(start, end, _, _) -> return sema_shared_access_expr_touches_shared(start, scopes) || sema_shared_access_expr_touches_shared(end, scopes)
        .Unary(_, inner, _) -> return sema_shared_access_expr_touches_shared(inner, scopes)
        .Binary(_, left, right, _) -> return sema_shared_access_expr_touches_shared(left, scopes) || sema_shared_access_expr_touches_shared(right, scopes)
        .CompareChain(values, _, _, _) -> return sema_shared_access_expr_list_touches_shared(values, scopes)
        .Call(call) -> return sema_shared_access_expr_call_args_touches_shared(call.args, scopes)
        .MethodCall(receiver, _, _, _, _, args, _, _) | .OptMethodCall(receiver, _, _, _, args, _) -> return sema_shared_access_expr_touches_shared(receiver, scopes) || sema_shared_access_expr_call_args_touches_shared(args, scopes)
        .StructLit(_, _, _, _, fields, _, _) -> {
            loop field in fields {
                if sema_shared_access_expr_touches_shared(field.value, scopes) -> return true
            }
        }
        .TypedLit(_, body, _) -> {
            if body == {
                .Fields(fields) -> loop field in fields {
                    if sema_shared_access_expr_touches_shared(field.value, scopes) -> return true
                }
                .Elements(elements) -> return sema_shared_access_expr_list_touches_shared(elements, scopes)
                .Entries(entries) -> loop entry in entries {
                    if sema_shared_access_expr_touches_shared(entry.key, scopes) || sema_shared_access_expr_touches_shared(entry.value, scopes) -> return true
                }
                .Value(inner) -> return sema_shared_access_expr_touches_shared(inner, scopes)
                else -> {}
            }
            return false
        }
        .EnumLit(_, _, _, args, _, _) -> {
            loop argument in args {
                if argument == {
                    .Positional(inner) -> if sema_shared_access_expr_touches_shared(inner, scopes) -> return true
                    .Named(_, inner) -> if sema_shared_access_expr_touches_shared(inner, scopes) -> return true
                }
            }
        }
        .PatternTest(subject, _, _) | .Ok(subject, _) | .Err(subject, _) -> return sema_shared_access_expr_touches_shared(subject, scopes)
        .Try(subject, _, _, context) -> {
            if sema_shared_access_expr_touches_shared(subject, scopes) -> return true
            if context == {
                .Val(inner) -> return sema_shared_access_expr_touches_shared(inner, scopes)
                else -> {}
            }
        }
        .OrFallback(subject, fallback, _, _) -> {
            if sema_shared_access_expr_touches_shared(subject, scopes) -> return true
            if fallback == {
                .Value(inner) -> return sema_shared_access_expr_touches_shared(inner, scopes)
                .Return(inner, _) -> {
                    if inner == {
                        .Val(returned) -> return sema_shared_access_expr_touches_shared(returned, scopes)
                        else -> {}
                    }
                }
                .Block(_, inner, _) -> {
                    if inner == {
                        .Val(produced) -> return sema_shared_access_expr_touches_shared(produced, scopes)
                        else -> {}
                    }
                }
                else -> {}
            }
        }
        .TupleLit(fields, _, _) -> {
            loop field in fields {
                if sema_shared_access_expr_touches_shared(field.value, scopes) -> return true
            }
        }
        .CallValue(callee, args, _) -> return sema_shared_access_expr_touches_shared(callee, scopes) || sema_shared_access_expr_call_args_touches_shared(args, scopes)
        .PtrFromAddr(_, _, _, address, _) -> return sema_shared_access_expr_touches_shared(address, scopes)
        .Paren(inner, _) -> return sema_shared_access_expr_touches_shared(inner, scopes)
        else -> {}
    }
    false
}

fn sema_shared_access_payload(span: Span) -> Expr Never! {
    Expr.Ident{name: SEMA_SHARED_PAYLOAD_PARAM, span: span}
}

fn sema_shared_access_callback(body: LambdaBody, span: Span) -> Expr Never! {
    lambda_meta :: ast_empty_lambda_meta()
    lambda :: Lambda{
        take_names: [NamedSpan]{},
        params: [LambdaParam]{LambdaParam{name: SEMA_SHARED_PAYLOAD_PARAM, name_span: span, ty: None, ty_span: None}},
        effects: None,
        body: body,
        span: span,
        meta: lambda_meta,
    }
    Expr.Lambda{lambda: lambda}
}

fn sema_shared_access_call(handle: Expr, method: String, body: LambdaBody, span: Span) -> Expr Never! {
    callback :: sema_shared_access_callback(body, span)
    flags := ast_empty_call_arg_flags()
    flags.shared_access_desugar = true
    argument :: CallArg{convention: AccessConvention.Read, expr: callback, span: span, flags: flags, label: None, spread: false}
    Expr.MethodCall{receiver: handle, method: method, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{argument}, recv_type: None, resolved_ret: None}
}

// `handle.field` -> the internal locked-read callback. The caller supplies the
// already checked receiver type so this helper never re-infers or emits a
// diagnostic while deciding whether the rewrite applies.
fn sema_shared_access_desugar_field_read(handle: Expr, field: String, span: Span, receiver_ty: Type) -> Expr? {
    if !sema_shared_access_is_shared_type(receiver_ty) -> return None
    projection :: Expr.Field{base: sema_shared_access_payload(span), member: field, span: span}
    Val(sema_shared_access_call(handle, "read", LambdaBody.Expr{value: projection}, span))
}

// Probe stored place types without checking (and therefore copying) the place.
fn sema_shared_access_place_type(value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> Type? {
    if value == {
        .Paren(inner, _) -> { return sema_shared_access_place_type(inner, environment, program, &scopes) }
        .Ident(name, _) -> {
            index :: sema_scope_resolve_index(scopes, name) ?? return None
            return sema_scope_binding_type(environment, scopes, index)
        }
        .Field(base, member, _) -> {
            owner_ty := sema_shared_access_place_type(base, environment, program, &scopes) ?? return None
            if owner_ty == .Shared(inner) -> owner_ty = inner
            owner_name :: if owner_ty == {
                .Named(name) | .Apply(name, _) -> name
                else -> { return None }
            }
            owner_args :: if owner_ty == {
                .Apply(_, args) -> args
                else -> [Type]{}
            }
            owner := sema_expression_type_symbol(&scopes, environment, program, owner_name)
            if owner == None -> owner = sema_expression_carrier_type_symbol(environment, program, owner_name)
            owner_symbol :: owner ?? return None
            definition :: sema_scope_declaration_struct(environment, program, owner_symbol.id) ?? return None
            names :: loop parameter in definition.type_params -> parameter.name
            loop field in definition.fields {
                if field.name == member -> return Val(sema_inference_substitute_type(sema_expression_field_owner_type(environment, program, owner_symbol.module_name, field.ty, names), names, owner_args))
            }
        }
        .Index(base, _, _, _) -> {
            owner_ty :: sema_shared_access_place_type(base, environment, program, &scopes) ?? return None
            if owner_ty == {
                .List(element) | .FixedList(element, _) -> return Val(element)
                .Map(_, _, element) -> return Val(element)
                else -> {}
            }
        }
        else -> { return sema_stmt_return_known_type(value, environment, scopes) }
    }
    None
}

// Split at the cell, retaining every field/index below it in the edit callback.
fn sema_shared_access_project_place(value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> (handle: Expr, place: Expr)? {
    ty := sema_shared_access_place_type(value, environment, program, &scopes)
    if ty == .Val(known) && sema_shared_access_is_shared_type(known) -> return Val((handle: value, place: sema_shared_access_payload(expr_span(value))))
    if value == {
        .Field(base, member, span) -> {
            projected :: sema_shared_access_project_place(base, environment, program, &scopes) ?? return None
            return Val((handle: projected.handle, place: Expr.Field{base: projected.place, member: member, span: span}))
        }
        .Index(base, index, span, kind) -> {
            projected :: sema_shared_access_project_place(base, environment, program, &scopes) ?? return None
            return Val((handle: projected.handle, place: Expr.Index{base: projected.place, index: index, span: span, kind: kind}))
        }
        .Paren(inner, _) -> { return sema_shared_access_project_place(inner, environment, program, &scopes) }
        else -> { return None }
    }
}

fn sema_shared_access_write_place(target: LValue, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> (handle: Expr, target: LValue, span: Span)? {
    if target == {
        .Field(base, field, span) -> {
            projected :: sema_shared_access_project_place(base, environment, program, &scopes) ?? return None
            return Val((handle: projected.handle, target: LValue.Field{base: projected.place, field: field, span: span}, span: span))
        }
        .Index(base, index, span, kind) -> {
            projected :: sema_shared_access_project_place(base, environment, program, &scopes) ?? return None
            return Val((handle: projected.handle, target: LValue.Index{base: projected.place, index: index, span: span, kind: kind}, span: span))
        }
        else -> { return None }
    }
}

fn sema_shared_access_desugar_place_write(handle: Expr, target: LValue, op: BinOp?, op_span: Span, value: Expr, span: Span) -> Expr Never! {
    assignment :: Stmt.Assign{target: target, op: op, op_span: op_span, value: value}
    sema_shared_access_call(handle, "edit", LambdaBody.Block{body: [Stmt]{assignment}}, span)
}
