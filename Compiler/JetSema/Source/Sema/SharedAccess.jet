// Compiler-owned Shared/Cell callback and plain-field access seam.
//
// Shared field syntax is lowered to the existing read/edit callback methods;
// the callback argument is tagged with CallArgFlags.shared_access_desugar so
// retired user-written Shared.read/edit spelling cannot reach this route.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    BinOp,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    LValue,
    Lambda,
    LambdaBody,
    LambdaParam,
    NamedSpan,
    PlaceAccess,
    Span,
    Stmt,
    Type,
    ast_binding,
    ast_empty_call_arg_flags,
    ast_empty_lambda_meta,
    ast_visit_body,
    ast_visit_expr,
    expr_span,
]

SEMA_SHARED_PAYLOAD_PARAM: "__jet_shared_value"
SEMA_SHARED_HOISTED_RHS: "__jet_shared_rhs"

sema_shared_access_inner: fn(ty: Type) -> Type? {
    if ty == {
        // copy: `inner` is a payload of read parameter `ty`, which keeps the original; the Val carrier owns this one
        .Shared(inner) -> Val(inner.copy())
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> None
    }
}

sema_shared_access_is_shared_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Shared(_) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}


sema_shared_access_is_cell_guard_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, _) -> name == "CellReadGuard" || name == "CellEditGuard"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// The value a `Shared<T>` or a `Cell<T>`-family handle guards.
sema_shared_access_guarded_inner: fn(ty: Type) -> Type? {
    if sema_shared_access_inner(ty) == .Val(inner) -> return Val(inner)
    sema_shared_access_cell_inner(ty)
}

sema_shared_access_cell_inner: fn(ty: Type) -> Type? {
    if ty == {
        .Apply(name, args) -> if (name == "Cell" || name == "CellReadGuard" || name == "CellEditGuard") && args.len() == 1 -> Val(args[0]) else -> None
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> None
    }
}

sema_shared_access_is_desugar: fn(args: [CallArg]) -> Bool Never! {
    if args.len() != 1 -> return false
    args[0].flags.shared_access_desugar
}

sema_shared_access_host_method: fn(ty: Type, method: String) -> Bool Never! {
    if ty == {
        .Shared(_) -> method == "read" || method == "edit"
        .Apply(name, _) -> if name == {
            "Cell" | "CellEditGuard" -> method == "read" || method == "edit"
            "CellReadGuard" -> method == "read"
            else -> false
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_shared_access_host_method_writes: fn(ty: Type, method: String) -> Bool Never! {
    if method != "edit" -> return false
    if ty == {
        .Shared(_) -> true
        .Apply(name, _) -> name == "Cell" || name == "CellEditGuard"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_shared_access_host_method_name: fn(ty: Type, method: String) -> String Never! {
    if ty == {
        .Shared(_) -> "shared.{method}"
        .Apply(name, _) -> if name == {
            "Cell" -> "cell.{method}"
            "CellReadGuard" -> "cell_read_guard.{method}"
            "CellEditGuard" -> "cell_edit_guard.{method}"
            else -> method
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> method
    }
}

// Every `Shared<T>` protocol access blocks on the cell's lock and records
// `Time.Wait`, except the wait-free scalar `read`/`get`/`set`/`replace` rail.
// The other Shared owner methods (`capture`, `same`, `downgrade`, …) and the
// Cell family record no effect. The row is authoritative: a compiler-owned host
// call is never an unknown callee, so it must not fall back to the maximal
// effect set.
sema_shared_access_effect_row: fn(ty: Type, method: String, span: Span) -> [EffectRowEntry] Never! {
    inner: sema_shared_access_inner(ty) ?? return [EffectRowEntry]{}
    scalar_atomic: (method == "read" || method == "get" || method == "set" || method == "replace") && sema_ownership_type_is_scalar(inner)
    protocol: method == "get" || method == "set" || method == "replace" || method == "read" || method == "edit" || method == "guard_read" || method == "guard_edit" || method == "read_txn" || method == "edit_txn"
    if protocol && !scalar_atomic -> return [EffectRowEntry]{EffectRowEntry{name: "Time.Wait", span: span}}
    [EffectRowEntry]{}
}

sema_shared_access_user_method_forbidden: fn(ty: Type, method: String, args: [CallArg]) -> Bool Never! {
    sema_shared_access_is_shared_type(ty) && (method == "read" || method == "edit") && !sema_shared_access_is_desugar(args)
}

sema_shared_access_host_callback_type: fn(inner: Type, result: Type?, shared: Bool) -> Type Never! {
    if shared -> Type.Fn{params: [Type]{inner}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None} else -> Type.Fn{params: [Type]{inner}, ret: result, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
}

sema_shared_access_expr_ident_is_shared: fn(value: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if value == {
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(scopes, name) ?? return false
            ty: scopes.bindings[index].symbol.ty ?? return false
            sema_shared_access_is_shared_type(ty)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

sema_shared_access_expr_list_touches_shared: fn(values: [Expr], scopes: SemaScopeTable) -> Bool {
    loop value in values {
        if sema_shared_access_expr_touches_shared(value, scopes) -> return true
    }
    false
}

sema_shared_access_expr_call_args_touches_shared: fn(args: [CallArg], scopes: SemaScopeTable) -> Bool {
    loop argument in args {
        if sema_shared_access_expr_touches_shared(argument.expr, scopes) -> return true
    }
    false
}

sema_shared_access_expr_touches_shared: fn(value: Expr, scopes: SemaScopeTable) -> Bool {
    if value == {
        .Field(base, _, _, _) -> {
            if sema_shared_access_expr_ident_is_shared(base, scopes) -> return true
            return sema_shared_access_expr_touches_shared(base, scopes)
        }
        .OptField(base, _, _, _, _, _) -> return sema_shared_access_expr_touches_shared(base, scopes)
        .Ident(_, _, _) -> return false
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(inner, _) && sema_shared_access_expr_touches_shared(inner, scopes) -> return true
            }
        }
        .ListLit(values, _, _) -> return sema_shared_access_expr_list_touches_shared(values, scopes)
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                if sema_shared_access_expr_touches_shared(entry.key, scopes) || sema_shared_access_expr_touches_shared(entry.value, scopes) -> return true
            }
        }
        .MemberSpread(base, _, _, _) -> return sema_shared_access_expr_touches_shared(base, scopes)
        .Spread(inner, _, _) | .Deref(inner, _, _) | .RawOf(inner, _, _) | .Copy(inner, _, _) | .Place(inner, _, _, _) | .Tainted(inner, _, _, _) | .Present(inner, _, _) -> return sema_shared_access_expr_touches_shared(inner, scopes)
        .Index(base, index, _, _, _) -> return sema_shared_access_expr_touches_shared(base, scopes) || sema_shared_access_expr_touches_shared(index, scopes)
        .Slice(base, start, end, range, _, _) -> {
            if sema_shared_access_expr_touches_shared(base, scopes) || sema_shared_access_expr_touches_shared(start, scopes) || sema_shared_access_expr_touches_shared(end, scopes) -> return true
            if range == {
                .Val(inner) -> return sema_shared_access_expr_touches_shared(inner, scopes)
                .None -> {}
            }
        }
        .Range(start, end, _, _, _) -> return sema_shared_access_expr_touches_shared(start, scopes) || sema_shared_access_expr_touches_shared(end, scopes)
        .Unary(_, inner, _, _) -> return sema_shared_access_expr_touches_shared(inner, scopes)
        .Binary(_, left, right, _, _) -> return sema_shared_access_expr_touches_shared(left, scopes) || sema_shared_access_expr_touches_shared(right, scopes)
        .CompareChain(values, _, _, _, _) -> return sema_shared_access_expr_list_touches_shared(values, scopes)
        .Call(call, _) -> return sema_shared_access_expr_call_args_touches_shared(call.args, scopes)
        .MethodCall(receiver, _, _, _, _, args, _) | .OptMethodCall(receiver, _, _, _, args, _, _) -> return sema_shared_access_expr_touches_shared(receiver, scopes) || sema_shared_access_expr_call_args_touches_shared(args, scopes)
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            loop field in fields {
                if sema_shared_access_expr_touches_shared(field.value, scopes) -> return true
            }
        }
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> loop field in fields {
                    if sema_shared_access_expr_touches_shared(field.value, scopes) -> return true
                }
                .Elements(elements) -> return sema_shared_access_expr_list_touches_shared(elements, scopes)
                .Entries(entries) -> loop entry in entries {
                    if sema_shared_access_expr_touches_shared(entry.key, scopes) || sema_shared_access_expr_touches_shared(entry.value, scopes) -> return true
                }
                .Value(inner) -> return sema_shared_access_expr_touches_shared(inner, scopes)
                .ByteText(_) | .Empty -> {}
            }
            return false
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop argument in args {
                if argument == {
                    .Positional(inner) -> if sema_shared_access_expr_touches_shared(inner, scopes) -> return true
                    .Named(_, inner) -> if sema_shared_access_expr_touches_shared(inner, scopes) -> return true
                }
            }
        }
        .PatternTest(subject, _, _, _) | .Ok(subject, _, _) | .Err(subject, _, _) -> return sema_shared_access_expr_touches_shared(subject, scopes)
        .Try(subject, _, _, context, _) -> {
            if sema_shared_access_expr_touches_shared(subject, scopes) -> return true
            if context == {
                .Val(inner) -> return sema_shared_access_expr_touches_shared(inner, scopes)
                .None -> {}
            }
        }
        .OrFallback(subject, fallback, _, _, _) -> {
            if sema_shared_access_expr_touches_shared(subject, scopes) -> return true
            if fallback == {
                .Value(inner) -> return sema_shared_access_expr_touches_shared(inner, scopes)
                .Return(inner, _) -> {
                    if inner == {
                        .Val(returned) -> return sema_shared_access_expr_touches_shared(returned, scopes)
                        .None -> {}
                    }
                }
                .Block(_, inner, _) -> {
                    if inner == {
                        .Val(produced) -> return sema_shared_access_expr_touches_shared(produced, scopes)
                        .None -> {}
                    }
                }
                .Panic(_, _) | .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
            }
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields {
                if sema_shared_access_expr_touches_shared(field.value, scopes) -> return true
            }
        }
        .CallValue(callee, args, _, _) -> return sema_shared_access_expr_touches_shared(callee, scopes) || sema_shared_access_expr_call_args_touches_shared(args, scopes)
        .PtrFromAddr(_, _, _, address, _, _) -> return sema_shared_access_expr_touches_shared(address, scopes)
        .Paren(inner, _, _) -> return sema_shared_access_expr_touches_shared(inner, scopes)
        .Pipe(head, steps, _, _) -> {
            if sema_shared_access_expr_touches_shared(head, scopes) -> return true
            loop step in steps {
                if sema_shared_access_expr_touches_shared(step.value, scopes) -> return true
            }
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    false
}

sema_shared_access_payload: fn(span: Span) -> Expr Never! {
    Expr.Ident{name: SEMA_SHARED_PAYLOAD_PARAM, span: span, id: AST_NODE_GENERATED}
}

sema_shared_access_callback: fn(body: LambdaBody, span: Span) -> Expr Never! {
    lambda_meta: ast_empty_lambda_meta()
    lambda: Lambda{
        take_names: [NamedSpan]{},
        params: [LambdaParam]{LambdaParam{name: SEMA_SHARED_PAYLOAD_PARAM, name_span: span, ty: None, ty_span: None, convention: AccessConvention.Read}},
        effects: None,
        body: body,
        span: span,
        meta: lambda_meta,
    }
    Expr.Lambda{lambda: lambda, id: AST_NODE_GENERATED}
}

sema_shared_access_call: fn(handle: Expr, method: String, body: LambdaBody, span: Span) -> Expr Never! {
    callback: sema_shared_access_callback(body, span)
    flags := ast_empty_call_arg_flags()
    flags.shared_access_desugar = true
    argument: CallArg{convention: AccessConvention.Read, expr: callback, span: span, flags: flags, label: None, spread: false}
    Expr.MethodCall{receiver: handle, method: method, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{argument}, id: AST_NODE_GENERATED}
}

// `handle.field` -> the internal locked-read callback. The caller supplies the
// already checked receiver type so this helper never re-infers or emits a
// diagnostic while deciding whether the rewrite applies.
sema_shared_access_desugar_field_read: fn(handle: Expr, field: String, span: Span, receiver_ty: Type) -> Expr? {
    if !sema_shared_access_is_shared_type(receiver_ty) -> return None
    projection: Expr.Field{base: sema_shared_access_payload(span), member: field, span: span, id: AST_NODE_GENERATED}
    Val(sema_shared_access_call(handle, "read", LambdaBody.Expr{value: projection}, span))
}

// Probe stored place types without checking (and therefore copying) the place.
sema_shared_access_place_type: fn(value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> Type? {
    if value == {
        .Paren(inner, _, _) -> { return sema_shared_access_place_type(inner, environment, program, scopes) }
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(scopes, name) ?? return None
            return sema_scope_binding_type(environment, scopes, index)
        }
        .Field(base, member, _, _) -> {
            owner_ty := sema_shared_access_place_type(base, environment, program, scopes) ?? return None
            if owner_ty == .Shared(inner) -> owner_ty = inner
            return sema_shared_access_field_type(owner_ty, member, environment, program, scopes)
        }
        .Index(base, _, _, _, _) -> {
            owner_ty: sema_shared_access_place_type(base, environment, program, scopes) ?? return None
            if owner_ty == {
                .List(element) | .FixedList(element, _) -> return Val(element)
                .Map(_, _, element) -> return Val(element)
                // A pool slot `pool[id]` holds the pool's element type.
                .Apply(name, args) -> if name == "Pool" && args.len() == 1 -> return Val(args[0])
                .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {}
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> { return sema_stmt_return_known_type(value, environment, scopes) }
    }
    None
}

// The declared type of field `member` of a stored `owner_ty` struct, with the
// struct's type arguments substituted.
sema_shared_access_field_type: fn(owner_ty: Type, member: String, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> Type? {
    owner_name: if owner_ty == {
        .Named(name) | .Apply(name, _) -> name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> { return None }
    }
    owner_args: if owner_ty == {
        .Apply(_, args) -> args
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> [Type]{}
    }
    owner := sema_expression_type_symbol(scopes, environment, program, owner_name)
    if owner == None -> owner = sema_expression_carrier_type_symbol(environment, program, owner_name)
    owner_symbol: owner ?? return None
    definition: sema_scope_declaration_struct(environment, program, owner_symbol.id) ?? return None
    names: loop parameter in definition.type_params -> parameter.name
    loop field in definition.fields {
        if field.name == member -> return Val(sema_inference_substitute_type(sema_expression_field_owner_type(environment, program, owner_symbol.module_name, field.ty, names), names, owner_args))
    }
    None
}

// Split at the cell, retaining every field/index below it in the edit callback.
sema_shared_access_project_place: fn(value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> (handle: Expr, place: Expr)? {
    ty := sema_shared_access_place_type(value, environment, program, scopes)
    if ty == .Val(known) && sema_shared_access_is_shared_type(known) -> return Val((handle: value, place: sema_shared_access_payload(expr_span(value))))
    if value == {
        .Field(base, member, span, node) -> {
            projected: sema_shared_access_project_place(base, environment, program, scopes) ?? return None
            return Val((handle: projected.handle, place: Expr.Field{base: projected.place, member: member, span: span, id: node}))
        }
        .Index(base, index, span, kind, node) -> {
            projected: sema_shared_access_project_place(base, environment, program, scopes) ?? return None
            return Val((handle: projected.handle, place: Expr.Index{base: projected.place, index: index, span: span, kind: kind, id: node}))
        }
        .Paren(inner, _, _) -> { return sema_shared_access_project_place(inner, environment, program, scopes) }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> { return None }
    }
}

// True when a projected place is the cell's whole value (the place was the
// `Shared` handle itself).
sema_shared_access_is_payload: fn(place: Expr) -> Bool Never! {
    if place == .Ident(name, _, _) -> return name == SEMA_SHARED_PAYLOAD_PARAM
    false
}

// The locked-edit callback spans the whole written place, from its first
// byte: the payload name the projection reads (spanned at the cell handle)
// resolves against the callback parameter, which must not start after it.
sema_shared_access_write_place: fn(target: LValue, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> (handle: Expr, target: LValue, span: Span)? {
    if target == {
        .Field(base, field, span) -> {
            projected: sema_shared_access_project_place(base, environment, program, scopes) ?? return None
            return Val((handle: projected.handle, span: Span{start: sema_shared_access_place_start(base), end: span.end}, target: LValue.Field{base: projected.place, field: field, span: span}))
        }
        .Index(base, index, span, kind) -> {
            projected: sema_shared_access_project_place(base, environment, program, scopes) ?? return None
            return Val((handle: projected.handle, span: Span{start: sema_shared_access_place_start(base), end: span.end}, target: LValue.Index{base: projected.place, index: index, span: span, kind: kind}))
        }
        .Local(_, _) -> { return None }
    }
}

// The first source byte of a place: a field or an element is spanned at its
// member or brackets, so the place starts at its root.
sema_shared_access_place_start: fn(value: Expr) -> Int Never! {
    if value == {
        .Field(base, _, _, _) | .Index(base, _, _, _, _) | .Slice(base, _, _, _, _, _) -> return sema_shared_access_place_start(base)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return expr_span(value).start
    }
}

sema_shared_access_desugar_place_write: fn(handle: Expr, target: LValue, op: BinOp?, op_span: Span, value: Expr, span: Span) -> Expr Never! {
    assignment: Stmt.Assign{target: target, op: op, op_span: op_span, value: value}
    sema_shared_access_call(handle, "edit", LambdaBody.Block{body: [Stmt]{assignment}}, span)
}

// `handle.place.method(args)` -> the locked-edit callback, so a writing call
// edits the stored value rather than a read copy of it.
sema_shared_access_desugar_place_call: fn(handle: Expr, place: Expr, place_span: Span, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], span: Span) -> Expr Never! {
    call: Expr.MethodCall{receiver: Expr.Place{value: place, access: PlaceAccess.Write, span: place_span, id: AST_NODE_GENERATED}, method: method, method_span: method_span, owner_type_args: owner_type_args, type_args: type_args, args: args, id: AST_NODE_GENERATED}
    sema_shared_access_call(handle, "edit", LambdaBody.Expr{value: call}, span)
}

// The shared cell a writing call `place.method(…)` edits: the cell handle,
// the place below it, and the call's span from the place's first byte. None
// when the receiver is not a written place inside a cell.
sema_shared_access_call_place: fn(receiver: Expr, method_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> (handle: Expr, place: Expr, place_span: Span, span: Span)? {
    if receiver == .Place(value, access, place_span, _) {
        if access != PlaceAccess.Write -> return None
        projected: sema_shared_access_project_place(value, environment, program, scopes) ?? return None
        if sema_shared_access_is_payload(projected.place) -> return None
        return Val((handle: projected.handle, place: projected.place, place_span: place_span, span: Span{start: sema_shared_access_place_start(value), end: method_span.end}))
    }
    None
}

// A statement `cell.place.method(args)` whose arguments read shared state
// binds those arguments first, inside one implicit transaction with the edit,
// as a shared place assignment's right side does.
sema_shared_access_place_call_transaction: fn(expr: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> Stmt? {
    if expr == .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, node) {
        if !sema_stmt_binding_is_write_place(receiver) || !sema_shared_access_expr_call_args_touches_shared(args, scopes) -> return None
        found: sema_shared_access_call_place(receiver, method_span, environment, program, scopes) ?? return None
        body := [Stmt]{}
        hoisted := [CallArg]{}
        loop index in 0..<args.len() {
            // copy: `args` is a read parameter the caller keeps; the hoisted call owns its arguments.
            argument := args[index].copy()
            if sema_shared_access_expr_touches_shared(argument.expr, scopes) {
                name: "{SEMA_SHARED_HOISTED_RHS}_{index}"
                span: expr_span(argument.expr)
                body.push(Stmt.Val{binding: ast_binding(name, span, false, argument.expr, None)})
                argument.expr = Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
            }
            hoisted.push(argument)
        }
        body.push(Stmt.Expr{expr: Expr.MethodCall{receiver: receiver, method: method, method_span: method_span, owner_type_args: owner_type_args, type_args: type_args, args: hoisted, id: node}})
        return Val(Stmt.Transact{name: None, name_span: None, body: body, implicit: true, span: Span{start: found.span.start, end: expr_span(expr).end}})
    }
    None
}

// L0207 (lint_shared_busy_wait): an unbounded conditional loop
// that polls a field of a `Shared` handle, with no wait point, sleep, channel
// receive, or write to the polled field in its body, spins a core. Runs on the
// parsed condition and body before they are checked.
sema_shared_access_lint_busy_wait: fn(condition: Expr, body: [Stmt], scopes: SemaScopeTable, diagnostics: &[Diagnostic]) {
    handles := [String]{}
    members := [String]{}
    ast_visit_expr(condition, fn(expression: Expr) { sema_shared_access_note_field_read(handles, members, expression) })
    poll := -1
    loop index in 0..<handles.len() {
        if sema_shared_access_name_is_shared(handles[index], scopes) {
            poll = index
            break
        }
    }
    if poll < 0 -> return
    blocking := false
    ast_visit_body(body, fn(expression: Expr) { sema_shared_access_note_blocking_call(blocking, expression) }, true)
    if blocking || sema_shared_access_statements_write_field(body, handles[poll], members[poll]) -> return
    diagnostics.push(sema_lint("L0207", sema_shared_access_condition_span(condition), "this unbounded loop polls `Shared` state without waiting", "an empty or non-blocking body reads a lock-backed value repeatedly and can consume a core while another task makes progress", "wait on a `Condition` through an edit guard, or receive from a channel; an empty plain-field predicate can use that wait directly"))
}

// The Rust checker reported the condition from its leftmost operand's own
// span: a field operand (`flag.ready == false`) starts at its member name.
sema_shared_access_condition_span: fn(condition: Expr) -> Span Never! {
    if condition == .Binary(_, left, _, span, _) -> return Span{start: sema_shared_access_condition_span(left).start, end: span.end}
    expr_span(condition)
}

sema_shared_access_name_is_shared: fn(name: String, scopes: SemaScopeTable) -> Bool Never! {
    index: sema_scope_resolve_index(scopes, name) ?? return false
    ty: scopes.bindings[index].symbol.ty ?? return false
    sema_shared_access_is_shared_type(ty)
}

// A `handle.field` read whose base is a plain name: a poll candidate.
sema_shared_access_note_field_read: fn(handles: &[String], members: &[String], expression: Expr) Never! {
    if expression == .Field(base, member, _, _) {
        if sema_shared_access_without_parens_name(base) == .Val(name) {
            handles.push(name)
            // copy: `member` is a payload of the visited expression, which the walk keeps
            members.push(member.copy())
        }
    }
}

sema_shared_access_without_parens_name: fn(value: Expr) -> String? Never! {
    if value == {
        // copy: `name` is a payload of read parameter `value`; the Val carrier owns this one
        .Ident(name, _, _) -> Val(name.copy())
        .Paren(inner, _, _) -> sema_shared_access_without_parens_name(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// Rust body_has_blocking_call: a call that can park the loop. A module or
// receiver call (`time.sleep`, `rx.receive`) counts by its last segment.
sema_shared_access_note_blocking_call: fn(found: &Bool, expression: Expr) Never! {
    if expression == {
        .Call(call, _) -> {
            parts: call.name.split(".").to_list()
            if sema_shared_access_is_blocking_name(parts[parts.len() - 1]) -> found = true
        }
        .MethodCall(_, method, _, _, _, _, _) | .OptMethodCall(_, method, _, _, _, _, _) -> {
            if sema_shared_access_is_blocking_name(method) -> found = true
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

sema_shared_access_is_blocking_name: fn(name: String) -> Bool Never! {
    name == "join" || name == "read" || name == "read_line" || name == "receive" || name == "recv" || name == "sleep" || name == "sleep_until" || name == "wait" || name == "yield_now"
}

// Rust body_writes_shared_field: an assignment to the polled field, or to any
// element under the handle, in the body or a nested statement block.
sema_shared_access_statements_write_field: fn(body: [Stmt], handle: String, field: String) -> Bool Never! {
    loop statement in body {
        if sema_shared_access_statement_writes_field(statement, handle, field) -> return true
    }
    false
}

sema_shared_access_statement_writes_field: fn(statement: Stmt, handle: String, field: String) -> Bool Never! {
    if statement == {
        .Assign(target, _, _, _) -> {
            if target == {
                .Local(_, _) -> return false
                .Index(base, _, _, _) -> return sema_shared_access_expr_root_is(base, handle)
                .Field(base, name, _) -> return name == field && sema_shared_access_expr_root_is(base, handle)
            }
        }
        .While(_, body, _, _, _) | .For(_, _, _, _, body, _, _, _, _) | .Loop(body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .ContextBlock(_, body, _) | .Live(body, _) | .AssumeDet(_, _, body, _) | .Transact(_, _, body, _, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> return sema_shared_access_statements_write_field(body, handle, field)
        .CountedLoop(_, _, step, body, _, _, _) -> {
            if step == .Val(inner) && sema_shared_access_statement_writes_field(inner, handle, field) -> return true
            return sema_shared_access_statements_write_field(body, handle, field)
        }
        .Switch(_, arms, else_body, _) | .ComptimeSwitch(_, arms, else_body, _) -> {
            loop arm in arms {
                if sema_shared_access_statements_write_field(arm.body, handle, field) -> return true
            }
            if else_body == .Val(rest) -> return sema_shared_access_statements_write_field(rest, handle, field)
            return false
        }
        .ComptimeIf(_, _, then_body, else_body, _, _) -> {
            if sema_shared_access_statements_write_field(then_body, handle, field) -> return true
            if else_body == .Val(rest) -> return sema_shared_access_statements_write_field(rest, handle, field)
            return false
        }
        .Expr(_) | .Val(_) | .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Yield(_, _) | .DeferClose(_, _) -> return false
    }
}

sema_shared_access_expr_root_is: fn(value: Expr, name: String) -> Bool Never! {
    if value == {
        .Ident(candidate, _, _) -> candidate == name
        .Paren(inner, _, _) -> sema_shared_access_expr_root_is(inner, name)
        .Field(base, _, _, _) | .OptField(base, _, _, _, _, _) | .Index(base, _, _, _, _) | .Slice(base, _, _, _, _, _) -> sema_shared_access_expr_root_is(base, name)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}
