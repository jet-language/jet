// Typed expression construction for Jet's source-level semantic model.
// Registry-dependent paths retain their diagnostics until they have checked
// metadata; no unchecked expression is lowered as if it were valid.
use {
    math: core.math
    jet_foundation.[
        AST_NODE_GENERATED,
        AccessConvention,
        access_sigil,
        ArithmeticOperation,
        ArithmeticPolicyFact,
        BinOp,
        BodyNode,
        NodeKind,
        TExprType,
        StmtKind,
        compiler_transfer_rows,
        type_table_intern,
        Call,
        CallArg,
        CallContractRow,
        CtValue,
        Diagnostic,
        Dimension,
        DimensionAxis,
        EffectRowEntry,
        Expr,
        Func,
        Item,
        IntegerWidth,
        CopyFact,
        OperatorMarker,
        ParamZone,
        QuantityKind,
        Span,
        StrFormat,
        StrPart,
        Symbol,
        SymbolID,
        SymbolKind,
        TBinaryOp,
        TCanonicalField,
        TComptimeValue,
        TGenericParam,
        TIntegerBounds,
        TIntegerWidth,
        TMethodRef,
        TNarrowOutcome,
        TNumericOp,
        TPatternPosition,
        TStrFormat,
        TTypedGoal,
        TUnaryOp,
        TUnitFormat,
        TUnitRoundingMode,
        TraitImplBlock,
        Type,
        TypeTupleField,
        UnOp,
        UnitFormat,
        UnitRatio,
        ast_comptime_value_type,
        ast_empty_call_arg_flags,
        compute_shape_dimensions,
        core_module_export,
        core_source_owns_type,
        core_source_receiver_method,
        core_source_receiver_method_routes,
        dimension_display_name,
        dimension_divide,
        dimension_identity,
        dimension_multiply,
        expr_source_start,
        expr_span,
        owned_trait_for_operator,
        owned_trait_for_operator_hook,
        symbol_id,
        checked_symbol_local,
        type_identity_equal,
        type_name,
        CORE_SOURCE_OWNED_ROWS,
        Lambda,
        LambdaBody,
        LambdaParam,
        NamedSpan,
        Pattern,
        PlaceAccess,
        TTryConvert,
        ast_empty_lambda_meta,
        core_module_has_type,
        diagnostic_with_edit,
        TextEdit,
    ]
}

// A checked node of `kind`. The kind moves in: callers build it as a literal
// around their checked children, and copying it copied the whole subtree.
sema_tree_node: fn(ty: Type, kind: &&TExprKind, span: Span) -> TExpr Never! {
    // copy: node types are shared with the caller's checked children and context.
    TExpr{ty: ty.copy(), kind: kind.move(), span: span}
}

// The read form, for a caller that keeps reading its kind.
sema_tree_expr: fn(ty: Type, kind: TExprKind, span: Span) -> TExpr Never! {
    // copy: the caller keeps `kind`; the node owns its own.
    sema_tree_node(ty, kind.copy(), span)
}

// A checked node of `kind` built flat: a row of the context's arena, whose
// children are arena row indices (sema_arena_adopt). The returned handle
// names the row; its id and type are the node's (a retype or a filed id
// lands on the handle, BodyFlatten.jet body_flat_arena_node).
sema_node: fn(context: &SemaCheckContext, ty: Type, kind: &&NodeKind, span: Span) -> TExpr Never! {
    context.arena.tree.nodes.push(BodyNode{id: AST_NODE_GENERATED, kind: kind.move(), span: span})
    row_type: type_table_intern(context.arena.tree.types, ty)
    context.arena.tree.expr_types.push(TExprType{id: AST_NODE_GENERATED, ty: row_type})
    // copy: the row keeps its type; the handle carries its own.
    TExpr{ty: ty.copy(), kind: .Flat(index: context.arena.tree.node_base + context.arena.tree.nodes.len() - 1), span: span}
}

// The arena row index of checked child `value`, for a flat node's kind: a
// Flat handle with its row's id and type is that row; any other node (a
// tree, or a retyped handle) is filed into the arena, children first.
sema_arena_adopt: fn(context: &SemaCheckContext, value: TExpr) -> Int Never! {
    body_flat_expr(value, context.arena)
}

// Appends the arena of a nested check (a snapshot of this context's check,
// sema_check_context_snapshot) to the context's arena. Its rows continue
// this arena's, so every index its nodes hold stays valid, and each row
// moves once: no check copies the arena. The nested arena interned its own
// types, so each moved type row is interned again here.
sema_arena_take_back: fn(context: &SemaCheckContext, rows: &&BodyFlat) Never! {
    nested := rows.move()
    if nested.tree.node_base != context.arena.tree.node_base + context.arena.tree.nodes.len() || nested.tree.stmt_base != context.arena.tree.stmt_base + context.arena.tree.stmts.len() -> panic("sema_arena_take_back: the enclosing check built nodes while a nested check ran")
    compiler_transfer_rows<BodyNode>(context.arena.tree.nodes, nested.tree.nodes)
    loop row in nested.tree.expr_types {
        ty: type_table_intern(context.arena.tree.types, nested.tree.types.types[row.ty])
        context.arena.tree.expr_types.push(TExprType{id: row.id, ty: ty})
    }
    compiler_transfer_rows<StmtKind>(context.arena.tree.stmts, nested.tree.stmts)
}

// (Rust `policy_call` and its lowering): under the
// function's `#Arithmetic(mode)` a fixed-width `+`, `-`, `*`, `**` or signed
// negation lowers through that mode's overflow route; `Checked` is the
// trapping policy route.
sema_expr_arithmetic_policy_value: fn(policy: ArithmeticPolicyFact, operation: ArithmeticOperation, ty: Type, span: Span, line: Int, lhs: TExpr, rhs: TExpr) -> TExpr Never! {
    prefix: if policy.mode == {
        .Checked -> "checked_policy"
        .Wrapping -> "wrapping"
        .Saturating -> "saturating"
    }
    name: if operation == {
        .Add -> "add"
        .Sub | .Neg -> "sub"
        .Mul -> "mul"
        .Pow -> "pow"
    }
    sema_tree_node(ty, TExprKind.OverflowOpt{prefix: prefix, operation: name, line: line, lhs: lhs, rhs: rhs}, span)
}

sema_expr_unwrap_tag: fn(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) -> return sema_expr_unwrap_tag(inner)
        else -> {}
    }
    // copy: the unwrapped type is a new owned Type. For an untagged type it equals `ty`, the
    // caller's checked type (a read parameter), which stays on its node.
    ty.copy()
}

sema_expr_is_integer: fn(ty: Type) -> Bool Never! {
    if sema_expr_unwrap_tag(ty) == {
        .Int -> true
        .IntN(_, _) -> true
        .InlineRange(_, _, _) -> true
        else -> false
    }
}

sema_expr_is_numeric: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .IntN(_, _) -> true
        .Float -> true
        .Float32 -> true
        else -> false
    }
}

sema_expr_has_numeric_overload: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Named(_) -> true
        .Apply(_, _) -> true
        .Quantity(_, _) -> true
        else -> false
    }
}
sema_expr_numeric_base: fn(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) -> return sema_expr_numeric_base(inner)
        .InlineRange(base, _, _) -> return sema_expr_numeric_base(base)
        else -> {}
    }
    // copy: the numeric base is a new owned Type. For a non-unit type it equals `ty`, the caller's
    // checked type (a read parameter), which stays on its node.
    ty.copy()
}

sema_expr_integer_range_for_type: fn(ty: Type) -> SemaIntegerRange? {
    if ty == {
        .IntN(signed, bits) -> return Val(sema_expr_integer_range(signed, bits))
        .InlineRange(_, lo, hi) -> return Val(SemaIntegerRange{lo: lo, hi: hi})
        .Tagged(_, inner) -> return sema_expr_integer_range_for_type(inner)
        else -> None
    }
}

sema_expr_numeric_widening_to: fn(source: Type, target: Type) -> Bool? {
    source_base := sema_expr_numeric_base(source)
    target_base := sema_expr_numeric_base(target)
    if type_identity_equal(source, target) && sema_expr_is_numeric(source) -> return Val(false)
    source_bounds := sema_expr_integer_range_for_type(source)
    target_bounds := sema_expr_integer_range_for_type(target)
    if source_bounds != None && target_bounds != None {
        source_range: source_bounds ?? SemaIntegerRange{lo: 0, hi: 0}
        target_range: target_bounds ?? SemaIntegerRange{lo: 0, hi: 0}
        // Interval containment is the only fixed-width widening; a pair that
        // neither contains has no join (`U8` and `I8`).
        if target_range.lo <= source_range.lo && source_range.hi <= target_range.hi -> return Val(false)
        return None
    }
    if source != source_base {
        if type_identity_equal(source_base, target) -> return Val(false)
        return sema_expr_numeric_widening_to(source_base, target)
    }
    if target != target_base {
        return None
    }
    if type_identity_equal(source_base, target_base) && sema_expr_is_numeric(source_base) -> return Val(false)
    if source_base == {
        .IntN(_, _) -> {
            if target_base == Type.Int -> return Val(false)
        }
        // `Int` holds every 64-bit signed value, so only `I64` holds all of
        // it; any narrower width never takes an `Int` implicitly. A
        // whole-number literal still adopts a width it fits
        // (`sema_expr_numeric_value_widening`).
        .Int -> {
            if target_base == .IntN(signed, bits) {
                if signed && bits >= 64 -> return Val(true)
                return None
            }
        }
        .Float32 -> {
            if target_base == Type.Float -> return Val(false)
        }
        else -> {}
    }
    if source_base == Type.Int && (target_base == Type.Float || target_base == Type.Float32) -> return Val(true)
    if sema_expr_is_integer(source_base) && (target_base == Type.Float || target_base == Type.Float32) {
        bits := 64
        signed := true
        if source_base == {
            .IntN(source_signed, source_bits) -> {
                bits = source_bits
                signed = source_signed
            }
            else -> {}
        }
        precision := if target_base == Type.Float32 -> 24 else -> 53
        exact := if signed -> bits <= precision + 1 else -> bits <= precision
        return Val(!exact)
    }
    None
}

// A lossless direction wins over a checked one in either operand order, so
// `cp & 63` with `63: U8` joins at `Int` instead of narrowing `cp`.
sema_expr_numeric_join: fn(left: Type, right: Type) -> Type? {
    forward: sema_expr_numeric_widening_to(left, right)
    backward: sema_expr_numeric_widening_to(right, left)
    if !(forward ?? true) -> return Val(right)
    if !(backward ?? true) -> return Val(left)
    if forward != None -> return Val(right)
    if backward != None -> return Val(left)
    None
}
sema_expr_numeric_join_values: fn(left: TExpr, right: TExpr) -> Type? {
    left_literal := sema_expr_integer_literal_value(left)
    right_literal := sema_expr_integer_literal_value(right)
    if left_literal != None {
        if right.ty == {
            .IntN(signed, bits) -> {
                if sema_expr_integer_fits(left_literal ?? 0, signed, bits) -> return Val(right.ty)
                return Val(Type.Int)
            }
            else -> {}
        }
    }
    if right_literal != None {
        if left.ty == {
            .IntN(signed, bits) -> {
                if sema_expr_integer_fits(right_literal ?? 0, signed, bits) -> return Val(left.ty)
                return Val(Type.Int)
            }
            else -> {}
        }
    }
    sema_expr_numeric_join(left.ty, right.ty)
}

// `sema_expr_numeric_widening_to` for a checked value: an untyped
// whole-number literal also takes any fixed width it fits, so `byte += 1`
// stays a `U8` update while `byte += count` with `count: Int` is refused.
sema_expr_numeric_value_widening: fn(value: TExpr, target: Type) -> Bool? {
    widening: sema_expr_numeric_widening_to(value.ty, target)
    if widening != None -> return widening
    literal: sema_expr_integer_literal_value(value) ?? return None
    if target == .IntN(signed, bits) && sema_expr_integer_fits(literal, signed, bits) -> return Val(true)
    None
}

sema_expr_numeric_rust_type: fn(ty: Type) -> String? {
    base := sema_expr_numeric_base(ty)
    if base == {
        .Int -> return Val("i64")
        .Float -> return Val("f64")
        .Float32 -> return Val("f32")
        .IntN(signed, bits) -> {
            prefix := if signed -> "i" else -> "u"
            if bits == 8 || bits == 16 || bits == 32 || bits == 64 -> return Val("{prefix}{bits}")
        }
        else -> {}
    }
    None
}

sema_expr_numeric_host_kind: fn(ty: Type) -> Int? {
    base := sema_expr_numeric_base(ty)
    if base == {
        .IntN(signed, bits) -> {
            if {
                signed -> {
                    if bits == 8 -> return Val(0)
                    if bits == 16 -> return Val(1)
                    if bits == 32 -> return Val(2)
                    if bits == 64 -> return Val(3)
                }
                else -> {
                    if bits == 8 -> return Val(4)
                    if bits == 16 -> return Val(5)
                    if bits == 32 -> return Val(6)
                    if bits == 64 -> return Val(7)
                }
            }
        }
        else -> {}
    }
    None
}

// Whether every value of the fixed-width integer `source` is a value of the
// fixed-width integer `destination`, so converting needs no range check.
sema_expr_fixed_holds: fn(destination: Type, source: Type) -> Bool {
    if destination == .IntN(destination_signed, destination_bits) {
        if source == .IntN(source_signed, source_bits) {
            if destination_signed == source_signed -> return destination_bits >= source_bits
            return destination_signed && destination_bits > source_bits
        }
    }
    false
}

// The outcome an overflow word gives the narrowing conversion it wraps.
sema_expr_word_outcome: fn(word: String) -> TNarrowOutcome? Never! {
    if word == "wrapping" -> return Val(TNarrowOutcome.Wrap)
    if word == "saturating" -> return Val(TNarrowOutcome.Saturate)
    if word == "checked" -> return Val(TNarrowOutcome.Absent)
    None
}

// What a narrowing typed-literal conversion yields for a value that doesn't
// fit: the outcome of the overflow word written around it, else the E3010
// stop.
sema_expr_narrow_outcome: fn(word: String?) -> TNarrowOutcome Never! {
    name: word ?? return TNarrowOutcome.Stop
    sema_expr_word_outcome(name) ?? TNarrowOutcome.Stop
}

// Whether `converted` is a narrowing conversion: to a fixed width from Int,
// or from a fixed width that can't hold its source.
sema_expr_is_narrowing: fn(converted: TExpr) -> Bool Never! {
    if converted.kind == .NumericMethod(_, operation) {
        return operation == .CheckedIntToFixed(_, _) || operation == .FixedNarrow(_, _)
    }
    false
}

// The narrowing conversion `converted` (sema_expr_is_narrowing) taking
// `outcome` for a value that doesn't fit; `Absent` makes its type `T?`.
sema_expr_narrowing_with: fn(converted: TExpr, outcome: TNarrowOutcome, line: Int) -> TExpr Never! {
    ty: if outcome == TNarrowOutcome.Absent -> Type.Option{inner: converted.ty} else -> converted.ty
    if converted.kind == .NumericMethod(receiver, _) {
        return TExpr{ty: ty, kind: TExprKind.NumericMethod{receiver: receiver, operation: TNumericOp.FixedNarrow{outcome: outcome, line: line}}, span: converted.span}
    }
    panic("sema_expr_narrowing_with: not a narrowing conversion")
}

sema_expr_integer_literal_value: fn(value: TExpr) -> Int? {
    if value.kind == {
        .IntLit(number, width) -> if width == None -> return Val(number)
        // A literal beyond i64 is a BigInt constant with its exact decimal.
        .CtLit(_) -> return tree_expr_literal_integer(value)
        .Unary(operator, operand) -> {
            if operator == TUnaryOp.Neg {
                inner: sema_expr_integer_literal_value(operand) ?? return None
                return Val(-inner)
            }
        }
        else -> {}
    }
    None
}

sema_expr_numeric_conversion: fn(value: TExpr, target: Type, span: Span, line: Int) -> TExpr? {
    source := sema_expr_numeric_base(value.ty)
    destination := sema_expr_numeric_base(target)
    // A transparent fact tag (`#Raw Int`) has its inner type's identity; the
    // operand still takes the plain numeric type the operator computes in.
    tagged: value.ty == .Tagged(_, _)
    if type_identity_equal(value.ty, target) && !tagged -> return Val(value)
    if type_identity_equal(source, destination) {
        return Val(TExpr{ty: target, kind: value.kind, span: span})
    }
    operation := TNumericOp?{None}
    if destination == Type.Float || destination == Type.Float32 {
        if sema_expr_is_integer(source) {
            source_signed := true
            if source == .IntN(signed, _) -> source_signed = signed
            operation = Val(TNumericOp.CheckedIntToFloat{source_signed: source_signed, target_f32: destination == Type.Float32, line: line})
        }
    }
    destination_is_fixed := if destination == {.IntN(_, _) -> true else -> false}
    if destination_is_fixed && source == Type.Int {
        host_kind: sema_expr_numeric_host_kind(destination) ?? return None
        operation = Val(TNumericOp.CheckedIntToFixed{host_kind: host_kind, line: line})
    }
    // A fixed-width source the destination can't hold every value of is
    // range-checked where it converts, and stops with E3010 when it doesn't
    // fit, exactly as a conversion from Int does.
    if destination_is_fixed && operation == None && source == .IntN(_, _) && !sema_expr_fixed_holds(destination, source) {
        operation = Val(TNumericOp.FixedNarrow{outcome: TNarrowOutcome.Stop, line: line})
    }
    if operation == None {
        if {
            destination == Type.Float32 && source == Type.Float -> {
                operation = Val(TNumericOp.FloatNarrow)
            }
            else -> {
                rust_type: sema_expr_numeric_rust_type(destination) ?? return None
                operation = Val(TNumericOp.CastAs{dst_rust: rust_type})
            }
        }
    }
    TExpr{ty: target, kind: TExprKind.NumericMethod{receiver: value, operation: operation ?? TNumericOp.CastAs{dst_rust: ""}}, span: span}
}

sema_expr_numeric_literal_conversion: fn(value: TExpr, target: Type, span: Span, line: Int, diagnostics: &[Diagnostic]) -> TExpr? {
    if !sema_expr_float_literal_fits(value, target, span, diagnostics) -> return None
    sema_expr_numeric_conversion(value, target, span, line)
}

// E1003: a whole-number literal crossing into Float or F32 must have an exact
// value there, for `Float{n}` and `Float.from_int(n)` alike.
sema_expr_float_literal_fits: fn(value: TExpr, target: Type, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    literal: sema_expr_integer_literal_value(value) ?? return true
    if target != Type.Float && target != Type.Float32 -> return true
    limit: if target == Type.Float32 -> 1 << 24 else -> 1 << 53
    lower: -limit
    if literal >= lower && literal <= limit -> return true
    diagnostics.push(sema_error("E1003", span, "{literal} does not fit exactly in {type_name(target)}", "{type_name(target)} holds every whole number only from {lower} through {limit}", "use a whole-number type, or write a value from {lower} through {limit}"))
    false
}

// The exact number a type is, by identity: the root name a literal carries
// (`Decimal`) and the canonical Core identity a `core.math` hook returns
// (`core.math::Decimal`) are one type.
sema_expr_precise_name: fn(ty: Type) -> String? {
    if ty == {
        .Named(name) -> {
            leaf := name
            if name.cut_last("::") == .Val(parts) && core_source_owns_type(name) -> leaf = parts.after
            if leaf == "Decimal" || leaf == "Fraction" || leaf == "Complex" -> return Val(leaf)
        }
        else -> {}
    }
    None
}

sema_expr_precise_integer: fn(value: TExpr, type_name_value: String, span: Span) -> TExpr? {
    literal: sema_expr_integer_literal_value(value) ?? return None
    if type_name_value == "Fraction" {
        one := sema_tree_node(Type.Int, TExprKind.IntLit{value: 1, width: None}, span)
        numerator: sema_expr_unbounded_integer_literal(literal, span)
        return Val(sema_tree_node(Type.Named{name: "Fraction"}, TExprKind.PreciseBuiltin{type_name: "Fraction", function: "from_parts", args: [TExpr]{numerator, one}}, span))
    }
    if type_name_value == "Decimal" {
        text := sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "{literal}"}}}, span)
        return Val(sema_tree_node(Type.Named{name: "Decimal"}, TExprKind.PreciseBuiltin{type_name: "Decimal", function: "from_str", args: [TExpr]{text}}, span))
    }
    None
}

sema_expr_decimal_from_int: fn(value: TExpr, span: Span) -> TExpr Never! {
    sema_tree_node(Type.Named{name: "Decimal"}, TExprKind.PreciseBuiltin{type_name: "Decimal", function: "from_int", args: [TExpr]{value}}, span)
}

sema_expr_precise_complex: fn(value: TExpr, span: Span, line: Int, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if !sema_expr_is_numeric(value.ty) -> return None
    real: sema_expr_numeric_literal_conversion(value, Type.Float, span, line, diagnostics) ?? return None
    imaginary := sema_node(context, Type.Float, NodeKind.FloatLit{value: 0.0}, span)
    Val(sema_tree_node(Type.Named{name: "Complex"}, TExprKind.PreciseBuiltin{type_name: "Complex", function: "from_parts", args: [TExpr]{real, imaginary}}, span))
}

// The owned operator trait a binary operator calls (`Equatable` for `!=`),
// read from the operator symbols OWNED_TRAITS declares.
sema_expr_operator_trait: fn(op: BinOp) -> String? {
    owned: owned_trait_for_operator(sema_expr_binary_name(op)) ?? return None
    Val(owned.name.copy())
}

// The hook method of that trait: `equal` for `!=`.
sema_expr_operator_method: fn(op: BinOp) -> String? {
    owned: owned_trait_for_operator(sema_expr_binary_name(op)) ?? return None
    if owned.contract == .Operator(hook, _) -> return Val(hook.copy())
    None
}

sema_expr_operator_commutative: fn(op: BinOp) -> Bool Never! {
    op == BinOp.Add || op == BinOp.Mul
}

SemaExprOperatorResolution: struct {
    candidate: SemaCallMethodCandidate
    receiver_is_left: Bool
    // The hook is compiler-generated (a derive), not authored.
    derived: Bool
}

// The `equal` or `compare` hook `==`/`!=` (and `assert_eq`) dispatch to.
// `==` is Equatable's operator, so an authored `equal` wins (S55: a
// hand-written implementation wins). `compare`, tested against
// `Ordering.Equal`, answers beside a derived `equal`, or alone when authored:
// a derived order never gives `==` to a type that refused `Equatable`.
sema_expr_equality_resolution: fn(graph: SemaRegistrationGraph, op: BinOp, lhs: Type, rhs: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaExprOperatorResolution? {
    comparable: sema_expr_registration_operator_candidates(graph, lhs, rhs, "Comparable", "compare", false, span, environment, program, scopes, diagnostics)
    equatable: sema_expr_registration_operator_candidates(graph, lhs, rhs, "Equatable", "equal", false, span, environment, program, scopes, diagnostics)
    if equatable.len() == 1 && !equatable[0].derived -> return Val(equatable[0])
    if comparable.len() == 1 && (equatable.len() == 1 || (equatable.len() == 0 && !comparable[0].derived)) -> return Val(comparable[0])
    sema_expr_operator_resolution(op, lhs, rhs, span, environment, program, scopes, diagnostics)
}
// `signature` is `function`'s signature specialized to the receiver; the
// registered row itself is only read. `receiver_type` is the owner as its own
// module names it, while the operator identity keeps the declared owner.
sema_expr_operator_candidate_from_function: fn(function: SemaRegistrationFunction, signature: Type, graph: SemaRegistrationGraph?, owner_type: Type, receiver_type: Type, trait_symbol: Symbol?, trait_name: String, method: String, rhs: Type, span: Span, caller_module: String, caller_package: String, lexical_generic_params: [TGenericParam], diagnostics: &[Diagnostic]) -> SemaCallMethodCandidate? {
    if function.symbol.name != method || function.parameters.len() == 0 -> return None
    // Rust `is_builtin_trait`: the arithmetic hook traits (`Add`, `Sub`,
    // `Mul`, `Div`) are compiler-owned and no source module declares them, so
    // a hook's trait owner is the builtin trait identity when no visible
    // declaration names it. A missing owner silently dropped every user
    // operator hook (E0360 on `impl R.Mul(Int)`, Core `impl Float.Mul(Vec3)`).
    trait_symbol_value: trait_symbol ?? sema_type_builtin_trait_symbol(trait_name) ?? return None
    method_ref := TMethodRef{symbol: function.symbol.id, name: method, mangled: false, trait_owner: Val(trait_symbol_value.id), operator_identity: Val("{type_name(owner_type)}::{trait_name}::{method}<{type_name(rhs)}>")}
    sema_call_method_candidate_from_registration(signature, function.generic_params, graph, caller_module, caller_package, lexical_generic_params, Val(receiver_type), function.parameters[0].convention, 1, method_ref, [Type]{}, span, diagnostics)
}

// Rust `owner_type_for_reader`: a hook's owner and signature name types as
// the owner's module sees them, with the owner's and the method's type
// parameters kept, so a receiver from another module that carries the
// canonical `module::Name` identity matches its own declaration.
sema_expr_operator_reader_type: fn(graph: SemaRegistrationGraph, ty: Type, owner_module: String, owner_generics: [SemaRegistrationGenericParam], function_generics: [SemaRegistrationGenericParam]) -> Type Never! {
    generics := [TGenericParam]{}
    loop param in owner_generics -> generics.push(TGenericParam{name: param.name, bounds: [SymbolID]{}})
    loop param in function_generics -> generics.push(TGenericParam{name: param.name, bounds: [SymbolID]{}})
    sema_type_resolve_declared_with_generics(graph, ty, owner_module, generics)
}

sema_expr_operator_resolution: fn(op: BinOp, lhs: Type, rhs: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaExprOperatorResolution? {
    trait_name: sema_expr_operator_trait(op) ?? return None
    method: sema_expr_operator_method(op) ?? return None
    if program.registration_graph == .Val(graph) {
    direct := sema_expr_registration_operator_candidates(graph, lhs, rhs, trait_name, method, false, span, environment, program, scopes, diagnostics)
    if direct.len() > 1 {
        diagnostics.push(sema_error("E0772", span, "this operator matches more than one callable body", "operator dispatch requires one exact registered trait implementation", "remove the duplicate operator implementation or make the right-hand type unambiguous"))
        return None
    }
    if direct.len() == 1 -> return Val(direct[0])
    if sema_expr_operator_commutative(op) {
        reverse := sema_expr_registration_operator_candidates(graph, rhs, lhs, trait_name, method, true, span, environment, program, scopes, diagnostics)
        if reverse.len() > 1 {
            diagnostics.push(sema_error("E0772", span, "this operator matches more than one callable body", "commutative operator dispatch requires one exact registered trait implementation", "remove the duplicate operator implementation or make the right-hand type unambiguous"))
            return None
        }
        if reverse.len() == 1 {
            result := reverse[0]
            result.receiver_is_left = false
            return Val(result)
        }
    }
    }
    None
}

// `<` is `== Less`, `<=` is `!= Greater`, `>` is `== Greater`, `>=` is `!=
// Less`; `==`/`!=` test Equal.
sema_expr_operator_ordering_variant: fn(op: BinOp) -> String Never! {
    if op == BinOp.Lt || op == BinOp.Ge -> return "Less"
    if op == BinOp.Gt || op == BinOp.Le -> return "Greater"
    "Equal"
}

sema_expr_operator_ordering_test: fn(op: BinOp, comparison: TExpr, span: Span, line: Int) -> TExpr Never! {
    variant := sema_expr_operator_ordering_variant(op)
    ordering := sema_tree_node(Type.Named{name: "Ordering"}, TExprKind.EnumLit{enum_type: "Ordering", variant: variant, payload: TEnumPayload.Unit}, span)
    test_op := TBinaryOp.Eq
    if op == BinOp.Le || op == BinOp.Ge || op == BinOp.Ne -> test_op = TBinaryOp.Ne
    sema_tree_node(Type.Bool, TExprKind.Binary{op: test_op, overflow: false, line: line, lhs: comparison, rhs: ordering}, span)
}
sema_expr_check_operator: fn(op: BinOp, left: Expr, right: Expr, lhs: TExpr, rhs: TExpr, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], line: Int) -> TExpr? {
    resolution := SemaExprOperatorResolution?{None}
    if {
        op == BinOp.Eq || op == BinOp.Ne -> {
            graph: program.registration_graph ?? return None
            resolution = sema_expr_equality_resolution(graph, op, lhs.ty, rhs.ty, span, environment, program, scopes, diagnostics)
        }
        else -> {
            resolution = sema_expr_operator_resolution(op, lhs.ty, rhs.ty, span, environment, program, scopes, diagnostics)
        }
    }
    resolved: resolution ?? return None
    // E0361 (operator hooks and relational chains): inside the hook itself, the
    // operator on a value of the hook's own receiver type dispatches back to
    // the same hook.
    relational: op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge
    hook_method: sema_expr_operator_method(op) ?? ""
    if (relational || op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div) && environment.function_name == hook_method {
        self_index: sema_scope_resolve_index(scopes, "self")
        if self_index == .Val(index) {
            if scopes.bindings[index].symbol.ty == .Val(self_ty) {
                if sema_expression_nominal_identity(self_ty, lhs.ty, environment, program) {
                    fix: if relational -> "compare the value's fields or call a different named helper inside the hook" else -> "combine the value's fields or call a different named helper inside the hook"
                    diagnostics.push(sema_error("E0361", span, "`{hook_method}` calls itself through `{sema_expr_binary_name(op)}`", "the operator symbol dispatches back to this same hook, so evaluation would recurse forever", fix))
                    return None
                }
            }
        }
    }
    receiver_expr := left
    receiver_value := lhs
    argument_expr := right
    if !resolved.receiver_is_left {
        receiver_expr = right
        receiver_value = rhs
        argument_expr = left
    }
    argument := CallArg{convention: AccessConvention.Read, expr: argument_expr, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
    scopes.ownership_call_depth += 1
    checked := sema_call_check_method_candidate_from_value_owned(state, receiver_expr, receiver_value, resolved.candidate, [CallArg]{argument}, [SemaCallDefaultValue]{}, span, None, environment, program, scopes, tail_store, context, diagnostics)
    scopes.ownership_call_depth -= 1
    value_checked: checked ?? return None
    context.call_return_views.push(SemaCallReturnView{span: span, facts: value_checked.return_view_facts})
    if !sema_expr_record_call_fact(environment, program, scopes, context, span, value_checked, diagnostics) -> return None
    value := value_checked.value
    // A hook declared `-> T Never!` yields its success value: the uninhabited
    // failure is erased exactly as the automatic propagation of any other
    // `Never!` call (`TTryConvert.Never`), so `rhs * self` is a plain `T`.
    if sema_expr_unwrap_tag(value.ty) == .Result(_, error) && sema_expr_unwrap_tag(error) == (Type.Named{name: "Never"}) {
        value = sema_expression_propagated(value, TTryConvert.Never, span) ?? return None
    }
    if op == BinOp.Compare -> return sema_expr_expected(value, expected, environment, program, diagnostics)
    if op == BinOp.Eq || op == BinOp.Ne {
        if resolved.candidate.method.name == "compare" {
            result := sema_expr_operator_ordering_test(op, value, span, line)
            return sema_expr_expected_owned(result, expected, environment, program, diagnostics)
        }
        if op == BinOp.Ne {
            result := sema_tree_node(Type.Bool, TExprKind.Unary{op: TUnaryOp.Not, operand: value}, span)
            return sema_expr_expected_owned(result, expected, environment, program, diagnostics)
        }
    }
    if op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge {
        return sema_expr_expected_owned(sema_expr_operator_ordering_test(op, value, span, line), expected, environment, program, diagnostics)
    }
    sema_expr_expected(value, expected, environment, program, diagnostics)
}

sema_expr_operator_target_matches: fn(implementation: SemaRegistrationImpl, nominal: SemaRegistrationNominal) -> Bool Never! {
    if implementation.target_identity_key == nominal.identity_key -> return true
    target_module: nominal.symbol.module_name
    if implementation.target_module_identity == (Val(target_module)) && implementation.target_type_name == nominal.symbol.name -> return true
    false
}

sema_expr_operator_rhs_matches: fn(rhs: Type?, expected: Type) -> Bool Never! {
    if rhs == None -> return false
    type_identity_equal(rhs, expected)
}

sema_expr_operator_row_name: fn(name: String) -> String Never! {
    parts: name.split("::").to_list()
    parts[parts.len() - 1]
}

sema_expr_registration_operator_candidates: fn(graph: SemaRegistrationGraph, receiver_type: Type, rhs_type: Type, trait_name: String, method: String, require_commutative: Bool, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> [SemaExprOperatorResolution] Never! {
    candidates := [SemaExprOperatorResolution]{}
    receiver_name := sema_expr_type_base_name(receiver_type) ?? ""
    if receiver_name == "" {
        // A built-in scalar receiver reaches its `impl Int.Mul(Price)`
        // hooks through the impl rows registered under the scalar's name.
        scalar_name: type_name(receiver_type)
        if sema_registration_builtin_scalar(scalar_name) != (Val(receiver_type)) -> return candidates
        receiver_name = scalar_name
    }
    caller_module := environment.module_identity
    if scopes.frames.len() > 0 -> caller_module = scopes.frames[0].owner
    caller_package := environment.package_identity
    // Only the nominals and impls registered under the receiver's base name,
    // in the module/row order of the whole-graph scans these rows replace.
    // The rows are keyed by the declared spelling (`Vec2`); a resolved
    // receiver carries its canonical identity (`module::Vec2`), so the row key
    // is the canonical leaf. Owner inference below still checks the identity.
    receiver_canonical: receiver_name.contains("::")
    receiver_name = sema_expr_operator_row_name(receiver_name)
    nominal_rows: sema_registration_nominal_rows_named(graph, receiver_name)
    // Each registered row is passed as a place to a read parameter, which
    // borrows it; binding the row (or looping over the row lists) copied
    // whole nominals, impls and functions natively, once per operator.
    loop nominal_row in nominal_rows {
        sema_expr_operator_nominal_candidates(graph, graph.modules[nominal_row.module_index].nominals[nominal_row.row], nominal_row.module_index, receiver_canonical, receiver_type, rhs_type, trait_name, method, require_commutative, span, caller_module, caller_package, environment, program, diagnostics, candidates)
    }
    impl_rows: sema_registration_impl_rows_named(graph, receiver_name)
    loop impl_row in impl_rows {
        sema_expr_operator_impl_row_candidates(graph, graph.modules[impl_row.module_index].impls[impl_row.row], impl_row.module_index, receiver_type, rhs_type, trait_name, method, require_commutative, span, caller_module, caller_package, environment, program, diagnostics, candidates)
    }
    candidates
}

// The operator candidates one registered nominal declares: its matching impl
// rows, then the trait blocks of its source declaration.
sema_expr_operator_nominal_candidates: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, module_index: Int, receiver_canonical: Bool, receiver_type: Type, rhs_type: Type, trait_name: String, method: String, require_commutative: Bool, span: Span, caller_module: String, caller_package: String, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic], candidates: &[SemaExprOperatorResolution]) Never! {
    // A resolved receiver carries the canonical identity (`module::Vec2`)
    // while the registered row keeps the declared spelling; infer such a
    // receiver against the declaration resolved in its own module.
    owner_module: graph.modules[module_index].module_identity
    inference_ty := nominal.ty
    if receiver_canonical -> inference_ty = sema_type_resolve_declared(graph, nominal.ty, owner_module)
    // Every registered nominal of the receiver's name is a candidate owner
    // (a user `Transform` beside `core.math`'s `Transform<From, To>`); one
    // whose declaration cannot own the receiver is skipped, not reported.
    probe_diagnostics := [Diagnostic]{}
    owner_inference: sema_infer_registered_nominal(nominal, inference_ty, program.registration_graph, caller_module, caller_package, environment.generic_params, receiver_type, [Type]{}, None, span, probe_diagnostics) ?? return
    if !owner_inference.complete || !owner_inference.compatible -> return
    owner_type: sema_inference_substitute_type_bindings(nominal.ty, owner_inference.substitutions)
    receiver_owner: sema_inference_substitute_type_bindings(sema_expr_operator_reader_type(graph, nominal.ty, owner_module, nominal.generic_params, [SemaRegistrationGenericParam]{}), owner_inference.substitutions)
    // Only this module's impls declaring `trait_name` can pass
    // sema_expr_operator_nominal_impl_candidates: with the registration
    // index built they are read from the trait-name rows (module/row order,
    // so the candidates land in the order the module scan produced them).
    if graph.impl_traits_indexed {
        if graph.impl_trait_name_slots.get(trait_name) == .Val(found) {
            loop impl_row in graph.impl_trait_name_buckets[found] {
                if impl_row.module_index != module_index -> next
                sema_expr_operator_nominal_impl_candidates(graph, graph.modules[module_index].impls[impl_row.row], nominal, module_index, owner_inference.substitutions, owner_type, receiver_owner, rhs_type, trait_name, method, require_commutative, span, caller_module, caller_package, environment, program, diagnostics, candidates)
            }
        }
    } else {
        loop impl_index in 0..<graph.modules[module_index].impls.len() {
            sema_expr_operator_nominal_impl_candidates(graph, graph.modules[module_index].impls[impl_index], nominal, module_index, owner_inference.substitutions, owner_type, receiver_owner, rhs_type, trait_name, method, require_commutative, span, caller_module, caller_package, environment, program, diagnostics, candidates)
        }
    }
    if nominal.source == .SourceAST(item) -> sema_expr_operator_source_candidates(graph, nominal, item, module_index, owner_module, owner_inference.substitutions, owner_type, receiver_owner, rhs_type, trait_name, method, require_commutative, span, caller_module, caller_package, environment, program, diagnostics, candidates)
}

sema_expr_operator_nominal_impl_candidates: fn(graph: SemaRegistrationGraph, implementation: SemaRegistrationImpl, nominal: SemaRegistrationNominal, module_index: Int, substitutions: [SemaInferenceBinding], owner_type: Type, receiver_owner: Type, rhs_type: Type, trait_name: String, method: String, require_commutative: Bool, span: Span, caller_module: String, caller_package: String, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic], candidates: &[SemaExprOperatorResolution]) Never! {
    if !sema_expr_operator_target_matches(implementation, nominal) -> return
    if implementation.trait_name != (Val(trait_name)) -> return
    if require_commutative && implementation.operator_marker != (Val(OperatorMarker.Commutative)) -> return
    // The authored right-hand type resolves in the impl's module, like the
    // source blocks' (`impl Point2.Add(Delta2<T, Space>)` matched against a
    // canonical `core.math::Delta2<Float, World>` operand).
    qualified_rhs: if implementation.operator_rhs == .Val(authored) -> sema_inference_substitute_type_bindings(sema_type_resolve_declared(graph, authored, implementation.source_module_identity), substitutions) else -> owner_type
    if !sema_expr_operator_rhs_matches(Val(qualified_rhs), rhs_type) -> return
    trait_symbol := implementation.trait_symbol
    if trait_symbol == None -> trait_symbol = sema_type_graph_trait_symbol(graph, implementation.source_module_identity, trait_name)
    loop function_index in 0..<implementation.methods.len() {
        sema_expr_operator_function_candidate(graph, implementation.methods[function_index], module_index, implementation.source_module_identity, nominal.generic_params, Val(substitutions), owner_type, receiver_owner, trait_symbol, trait_name, method, qualified_rhs, span, caller_module, caller_package, environment, program, diagnostics, candidates)
    }
}

sema_expr_operator_source_candidates: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, item: Item, module_index: Int, owner_module: String, substitutions: [SemaInferenceBinding], owner_type: Type, receiver_owner: Type, rhs_type: Type, trait_name: String, method: String, require_commutative: Bool, span: Span, caller_module: String, caller_package: String, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic], candidates: &[SemaExprOperatorResolution]) Never! {
    if item == {
        .Struct(definition) -> sema_expr_operator_block_candidates(graph, nominal, definition.trait_impls, module_index, owner_module, substitutions, owner_type, receiver_owner, rhs_type, trait_name, method, require_commutative, span, caller_module, caller_package, environment, program, diagnostics, candidates)
        .Enum(definition) -> sema_expr_operator_block_candidates(graph, nominal, definition.trait_impls, module_index, owner_module, substitutions, owner_type, receiver_owner, rhs_type, trait_name, method, require_commutative, span, caller_module, caller_package, environment, program, diagnostics, candidates)
        else -> {}
    }
}

sema_expr_operator_block_candidates: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, blocks: [TraitImplBlock], module_index: Int, owner_module: String, substitutions: [SemaInferenceBinding], owner_type: Type, receiver_owner: Type, rhs_type: Type, trait_name: String, method: String, require_commutative: Bool, span: Span, caller_module: String, caller_package: String, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic], candidates: &[SemaExprOperatorResolution]) Never! {
    loop block_index in 0..<blocks.len() {
        sema_expr_operator_block_methods(graph, nominal, blocks[block_index], module_index, owner_module, substitutions, owner_type, receiver_owner, rhs_type, trait_name, method, require_commutative, span, caller_module, caller_package, environment, program, diagnostics, candidates)
    }
}

sema_expr_operator_block_methods: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, block: TraitImplBlock, module_index: Int, owner_module: String, substitutions: [SemaInferenceBinding], owner_type: Type, receiver_owner: Type, rhs_type: Type, trait_name: String, method: String, require_commutative: Bool, span: Span, caller_module: String, caller_package: String, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic], candidates: &[SemaExprOperatorResolution]) Never! {
    if block.trait_name != trait_name -> return
    if require_commutative && block.operator_marker != (Val(OperatorMarker.Commutative)) -> return
    // The authored right-hand type resolves in the owner's module, like the
    // impl rows.
    block_rhs: sema_inference_substitute_type_bindings(sema_type_resolve_declared(graph, block.operator_rhs ?? nominal.ty, owner_module), substitutions)
    if !sema_expr_operator_rhs_matches(Val(block_rhs), rhs_type) -> return
    trait_symbol: sema_type_graph_trait_symbol(graph, graph.modules[module_index].module_identity, trait_name)
    loop source_index in 0..<block.methods.len() {
        if block.methods[source_index].name != method -> next
        registered := -1
        loop index in 0..<nominal.methods.len() {
            if nominal.methods[index].declaration.span == block.methods[source_index].span -> registered = index
        }
        if registered < 0 -> next
        sema_expr_operator_function_candidate(graph, nominal.methods[registered], module_index, owner_module, nominal.generic_params, Val(substitutions), owner_type, receiver_owner, trait_symbol, trait_name, method, block_rhs, span, caller_module, caller_package, environment, program, diagnostics, candidates)
    }
}

// The impls registered under the receiver's name (hooks such as
// `impl Int.Mul(Price)`), whose target resolves to the receiver's own type.
sema_expr_operator_impl_row_candidates: fn(graph: SemaRegistrationGraph, implementation: SemaRegistrationImpl, module_index: Int, receiver_type: Type, rhs_type: Type, trait_name: String, method: String, require_commutative: Bool, span: Span, caller_module: String, caller_package: String, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic], candidates: &[SemaExprOperatorResolution]) Never! {
    if implementation.trait_name != (Val(trait_name)) -> return
    if require_commutative && implementation.operator_marker != (Val(OperatorMarker.Commutative)) -> return
    // The leaf row key admits same-named owners of other modules; only an
    // impl whose resolved target is the receiver's own type applies.
    if sema_expr_type_base_name(sema_type_resolve_declared(graph, implementation.target_type, implementation.source_module_identity)) != sema_expr_type_base_name(sema_type_resolve_declared(graph, receiver_type, caller_module)) -> return
    // The authored right-hand type resolves in the impl's module, like the
    // canonical operand type it is matched against (`Int.Mul(Price)`).
    implementation_rhs: sema_type_resolve_declared(graph, implementation.operator_rhs ?? implementation.target_type, implementation.source_module_identity)
    if !sema_expr_operator_rhs_matches(Val(implementation_rhs), rhs_type) -> return
    if sema_type_resolve_nominal_row(graph, implementation.target_type, implementation.source_module_identity) == .Val(owner_row) {
        sema_expr_operator_impl_row_methods(graph, implementation, module_index, graph.modules[owner_row.module_index].nominals[owner_row.row].generic_params, implementation_rhs, trait_name, method, span, caller_module, caller_package, environment, program, diagnostics, candidates)
        return
    }
    sema_expr_operator_impl_row_methods(graph, implementation, module_index, [SemaRegistrationGenericParam]{}, implementation_rhs, trait_name, method, span, caller_module, caller_package, environment, program, diagnostics, candidates)
}

sema_expr_operator_impl_row_methods: fn(graph: SemaRegistrationGraph, implementation: SemaRegistrationImpl, module_index: Int, owner_generics: [SemaRegistrationGenericParam], implementation_rhs: Type, trait_name: String, method: String, span: Span, caller_module: String, caller_package: String, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic], candidates: &[SemaExprOperatorResolution]) Never! {
    receiver_owner: sema_expr_operator_reader_type(graph, implementation.target_type, implementation.source_module_identity, owner_generics, [SemaRegistrationGenericParam]{})
    trait_symbol := implementation.trait_symbol
    if trait_symbol == None -> trait_symbol = sema_type_graph_trait_symbol(graph, implementation.source_module_identity, trait_name)
    loop function_index in 0..<implementation.methods.len() {
        sema_expr_operator_function_candidate(graph, implementation.methods[function_index], module_index, implementation.source_module_identity, owner_generics, None, implementation.target_type, receiver_owner, trait_symbol, trait_name, method, implementation_rhs, span, caller_module, caller_package, environment, program, diagnostics, candidates)
    }
}

// One registered method as an operator candidate: visible to the caller,
// its signature read as the owner's module names it (and specialized by
// `substitutions` when the owner was inferred), added once per method
// identity.
sema_expr_operator_function_candidate: fn(graph: SemaRegistrationGraph, function: SemaRegistrationFunction, module_index: Int, signature_module: String, owner_generics: [SemaRegistrationGenericParam], substitutions: [SemaInferenceBinding]?, owner_type: Type, receiver_owner: Type, trait_symbol: Symbol?, trait_name: String, method: String, rhs: Type, span: Span, caller_module: String, caller_package: String, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic], candidates: &[SemaExprOperatorResolution]) Never! {
    if !sema_registration_visible(function.symbol.visibility, caller_module, caller_package, graph.modules[module_index].module_identity, graph.modules[module_index].package_identity) -> return
    reader: sema_expr_operator_reader_type(graph, function.signature, signature_module, owner_generics, function.generic_params)
    specialized: if substitutions == .Val(bindings) -> sema_inference_substitute_type_bindings(reader, bindings) else -> reader
    candidate: sema_expr_operator_candidate_from_function(function, specialized, program.registration_graph, owner_type, receiver_owner, trait_symbol, trait_name, method, rhs, span, caller_module, caller_package, environment.generic_params, diagnostics) ?? return
    loop existing in candidates {
        if existing.candidate.method.symbol.key == candidate.method.symbol.key && existing.candidate.method.operator_identity == candidate.method.operator_identity -> return
    }
    candidates.push(SemaExprOperatorResolution{candidate: candidate, receiver_is_left: true, derived: function.declaration.compiler_generated})
}

sema_expr_tree_binary_op: fn(op: BinOp) -> TBinaryOp Never! {
    if op == {
        .Add -> TBinaryOp.Add
        .Sub -> TBinaryOp.Sub
        .Mul -> TBinaryOp.Mul
        .Div -> TBinaryOp.Div
        .FloorDiv -> TBinaryOp.FloorDiv
        .Mod -> TBinaryOp.Mod
        .Rem -> TBinaryOp.Rem
        .Pow -> TBinaryOp.Pow
        .BitAnd -> TBinaryOp.BitAnd
        .BitOr -> TBinaryOp.BitOr
        .BitXor -> TBinaryOp.BitXor
        .Shl -> TBinaryOp.Shl
        .Shr -> TBinaryOp.Shr
        .Eq -> TBinaryOp.Eq
        .Ne -> TBinaryOp.Ne
        .Lt -> TBinaryOp.Lt
        .Gt -> TBinaryOp.Gt
        .Le -> TBinaryOp.Le
        .Ge -> TBinaryOp.Ge
        .Compare -> TBinaryOp.Compare
        .And -> TBinaryOp.And
        .Or -> TBinaryOp.Or
    }
}

sema_expr_binary_name: fn(op: BinOp) -> String Never! {
    if op == {
        .Add -> "+"
        .Sub -> "-"
        .Mul -> "*"
        .Div -> "/"
        .FloorDiv -> "/%"
        .Mod -> "%"
        .Rem -> "rem"
        .Pow -> "pow"
        .BitAnd -> "bit_and"
        .BitOr -> "bit_or"
        .BitXor -> "bit_xor"
        .Shl -> "<<"
        .Shr -> ">>"
        .Eq -> "=="
        .Ne -> "!="
        .Lt -> "<"
        .Gt -> ">"
        .Le -> "<="
        .Ge -> ">="
        .Compare -> "<=>"
        .And -> "&&"
        .Or -> "||"
    }
}

sema_expr_binary_type: fn(op: BinOp, lhs: Type, rhs: Type, span: Span, diagnostics: &[Diagnostic]) -> Type? {
    if op == BinOp.And || op == BinOp.Or {
        if lhs == Type.Bool && rhs == Type.Bool -> return Val(Type.Bool)
        diagnostics.push(sema_error("E0110", span, "logical operators need Bool values", "a logical condition must have a clear yes or no value", "compare each value to produce Bool"))
        return None
    }
    if op == BinOp.Eq || op == BinOp.Ne {
        if !type_identity_equal(lhs, rhs) {
            if sema_expr_numeric_join(lhs, rhs) != None -> return Val(Type.Bool)
            diagnostics.push(sema_error("E0109", span, "both sides of this comparison must have the same type", "equality compares values of one type", "convert one side or compare values with matching types"))
            return None
        }
        // Rust `infer_binary` Eq/Ne: float `==` is almost always a bug
        // (D-SMELLLINT1, L0502).
        if lhs == Type.Float || lhs == Type.Float32 -> diagnostics.push(sema_lint("L0502", span, "Comparing floats with `{sema_expr_binary_name(op)}` is unreliable", "Floating-point arithmetic is inexact; two values computed differently may not be bit-identical even when mathematically equal", "Compare within a tolerance: `(a - b).abs() < 1e-9`"))
        if (lhs == Type.Int || lhs == Type.Float || lhs == Type.Float32 || lhs == Type.Bool || lhs == Type.String || lhs == Type.Char) || sema_expr_is_integer(lhs) || sema_expr_precise_name(lhs) != None -> return Val(Type.Bool)
        return None
    }
    if op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge {
        if !type_identity_equal(lhs, rhs) {
            if sema_expr_numeric_join(lhs, rhs) != None -> return Val(Type.Bool)
            diagnostics.push(sema_error("E0109", span, "both sides of this comparison must have the same type", "an ordered comparison needs matching numeric operands", "make both sides the same number type"))
            return None
        }
        if sema_expr_is_numeric(lhs) || sema_expr_precise_name(lhs) != None -> return Val(Type.Bool)
        diagnostics.push(sema_error("E0109", span, "ordered comparisons need numeric operands", "this operator is defined for numbers", "use a numeric value here"))
        return None
    }
    if op == BinOp.Compare {
        if type_identity_equal(lhs, rhs) && (sema_expr_is_numeric(lhs) || sema_expr_precise_name(lhs) != None) -> return Val(Type.Named{name: "Ordering"})
        if sema_expr_numeric_join(lhs, rhs) != None -> return Val(Type.Named{name: "Ordering"})
        return None
    }
    if op == BinOp.Shl || op == BinOp.Shr {
        if sema_expr_is_integer(lhs) && sema_expr_is_integer(rhs) -> return Val(lhs)
        diagnostics.push(sema_error("E0109", span, "shift operators work on integer values only", "the left side is the value being shifted and the right side is its bit count", "use whole-number operands"))
        return None
    }
    if op == BinOp.Mod || op == BinOp.Rem || op == BinOp.BitAnd || op == BinOp.BitOr || op == BinOp.BitXor {
        if type_identity_equal(lhs, rhs) && sema_expr_is_integer(lhs) -> return Val(lhs)
        if {
            !sema_expr_is_integer(lhs) || !sema_expr_is_integer(rhs) -> diagnostics.push(sema_error("E0109", span, "this operator works on integer values only", "remainder and bitwise operations preserve an integer width", "use whole-number operands"))
            else -> diagnostics.push(sema_error("E0109", span, "both sides of this operator need the same integer type", "bitwise and remainder operations preserve one width", "make both operands the same integer type"))
        }
        return None
    }
    if op == BinOp.Div && lhs == Type.Int && rhs == Type.Int -> return Val(Type.Named{name: "Fraction"})
    if op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div || op == BinOp.FloorDiv || op == BinOp.Pow {
        if type_identity_equal(lhs, rhs) && sema_expr_is_numeric(lhs) -> return Val(lhs)
        if sema_expr_precise_name(lhs) != None && type_identity_equal(lhs, rhs) -> return Val(lhs)
        // Two numbers with no widening join (`U8` and `I8`): neither side
        // holds every value of the other, so no result type is implied.
        if sema_expr_is_numeric(lhs) && sema_expr_is_numeric(rhs) {
            diagnostics.push(sema_error("E0109", span, "{sema_expr_operator_label(op)} can't compare or combine {sema_type_show(lhs)} and {sema_type_show(rhs)}", "Neither {type_name(lhs)} contains every value of {type_name(rhs)}, nor {type_name(rhs)} every value of {type_name(lhs)}", "Choose the result type and convert the other side into it"))
            return None
        }
        if op == BinOp.FloorDiv || (op == BinOp.Add && lhs == Type.String) {
            diagnostics.push(sema_error("E0109", span, "arithmetic needs matching number types", "arithmetic operands must share a supported numeric type", "make both operands the same number type"))
            return None
        }
        diagnostics.push(sema_expr_op_mismatch(op, lhs, rhs, span))
        return None
    }
    None
}

// Rust `operator_label`: the operator as written, in backticks.
sema_expr_operator_label: fn(op: BinOp) -> String Never! {
    "`{sema_expr_binary_name(op)}`"
}

// Rust `op_mismatch`: an operator with no rule for this operand pair.
sema_expr_op_mismatch: fn(op: BinOp, lhs: Type, rhs: Type, span: Span) -> Diagnostic Never! {
    label: sema_expr_operator_label(op)
    if type_identity_equal(lhs, rhs) {
        return sema_error("E0109", span, "{label} can't compare or combine {sema_type_show(lhs)} and {sema_type_show(rhs)}", "{label} is not defined for {sema_type_show(lhs)}", "use an operation supported by {sema_type_show(lhs)}, or call a named method")
    }
    sema_error("E0109", span, "{label} can't compare or combine {sema_type_show(lhs)} and {sema_type_show(rhs)}", "the operator has no built-in rule and no user-defined `impl Type.Trait` hook for this operand pair", "use a supported operand pair, call a named method, or implement the operator's hook trait on your own type for this pair")
}

sema_expr_tree_unit_format: fn(format: UnitFormat) -> TUnitFormat Never! {
    if format == {
        .Symbol -> TUnitFormat.Symbol
        .Name -> TUnitFormat.Name
        .Bare -> TUnitFormat.Bare
    }
}

sema_expr_string_format: fn(format: StrFormat) -> TStrFormat Never! {
    if format == {
        .Display -> TStrFormat.Display
        .Debug -> TStrFormat.Debug
        .Pretty -> TStrFormat.Pretty
        .Fixed(digits) -> TStrFormat.Fixed{digits: digits}
        .Grouped(digits) -> TStrFormat.Grouped{digits: digits}
        .Hex(digits) -> TStrFormat.Hex{digits: digits}
        .Pad(width, fill) -> TStrFormat.Pad{width: width, fill: fill}
        .PadLeft(width, fill) -> TStrFormat.PadLeft{width: width, fill: fill}
        .Sci(digits) -> TStrFormat.Sci{digits: digits}
        .Percent(digits) -> TStrFormat.Percent{digits: digits}
        .Bin -> TStrFormat.Bin
        .Oct -> TStrFormat.Oct
        .Unit(unit_format) -> TStrFormat.Unit{format: sema_expr_tree_unit_format(unit_format)}
    }
}

sema_expr_byte_text: fn(value: U8) -> String Never! {
    byte: Int.from_u8(value)
    if byte < 128 -> return String.from_bytes([U8]{value}) ?? ""
    first: U8{192 + (byte >> 6)}
    second: U8{128 + ((byte).bit_and(63))}
    String.from_bytes([U8]{first, second}) ?? ""
}

sema_expr_expected_type: fn(value: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type Never! {
    if program.registration_graph == .Val(graph) -> return sema_type_resolve_declared_recursive(graph, value, sema_scope_caller_row(environment, graph), environment.generic_params)
    // copy: the expected type is a new owned Type. When nothing resolves it equals `value`, the
    // caller's expectation (a read parameter), which the caller keeps.
    value.copy()
}

sema_expr_expected_assignable: fn(required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool? {
    if program.registration_graph == .Val(graph_value) {
        return sema_type_assignable_in_graph_at(graph_value, required, offered, sema_scope_caller_row(environment, graph_value), environment.generic_params)
    }
    Val(sema_type_assignable(required, offered))
}

sema_expr_expected_trait_coercion: fn(value: &&TExpr, required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TExpr Never! {
    updated := value
    if required == {
        .TraitObject(bounds) -> {
            if bounds.len() != 1 -> return updated
            if offered == .TraitObject(_) -> return updated
            source := updated
            tree_expr_retype(updated, required)
            updated.kind = TExprKind.TraitBox{value: source, target: required}
            return updated
        }
        else -> {}
    }
    updated
}

// A plain `T` fills a slot whose checked type is `T?`. The slot
// type is already fixed, so the lift never picks a callee or infers a generic;
// it adds exactly one `Present` last. A value that is already optional or
// fallible, or that never returns, keeps the ordinary checks (E0108/E0309).
sema_expr_optional_lift: fn(value: TExpr, required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TExpr? {
    lifted_type: sema_expr_optional_lift_type(required, offered, environment, program) ?? return None
    // copy: the caller keeps its operand; the lifted node owns its own.
    Val(sema_tree_node(lifted_type, TExprKind.Present{value: value.copy()}, value.span))
}

// Whether a value of `ty` can never be None: a built-in value type that is
// not optional. A named or applied type (an alias, a type parameter, `Dyn`),
// a trait object and a union stay open, since they may hold None.
sema_expr_never_none: fn(ty: Type) -> Bool Never! {
    if sema_expr_unwrap_tag(ty) == {
        .Int | .Float | .Float32 | .Bool | .String | .Char | .IntN(_, _) | .InlineRange(_, _, _) | .Quantity(_, _) | .Measure(_) -> true
        .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Tuple(_) | .FixedList(_, _) -> true
        else -> false
    }
}

// The optional type a value of type `offered` lifts to under `required`, or
// None when it does not lift. Decided from the types alone, so an owning
// caller moves its value into the lift.
sema_expr_optional_lift_type: fn(required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type? {
    normalized := sema_expr_unwrap_tag(required)
    lifts := false
    if normalized == {
        .Option(payload) -> {
            if sema_expr_unwrap_tag(offered) == {
                .Option(_) | .Result(_, _) -> return None
                .Named(name) -> {
                    if name == "Never" -> return None
                }
                else -> {}
            }
            fits: sema_expr_expected_assignable(payload, offered, environment, program) ?? return None
            if !fits -> return None
            lifts = true
        }
        else -> {}
    }
    if lifts -> return Val(normalized.move())
    None
}

// `value` as `expected` asks for it: the read form for a caller that keeps
// reading its value. A caller done with its value passes it to
// sema_expr_expected_owned instead, which moves it through.
sema_expr_expected: fn(value: TExpr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    // copy: the caller keeps reading `value`; the result is a value of its own.
    sema_expr_expected_owned(value.copy(), expected, environment, program, diagnostics)
}

sema_expr_expected_owned: fn(value: &&TExpr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    owned := value.move()
    // `expected` is known present below this line.
    if expected == None -> return Val(owned.move())
    if sema_expr_expected_keeps(owned.ty, expected) -> return Val(owned.move())
    // A value of the very named type expected resolves to the same type on
    // both sides: no Dyn wrap, lift, zone or trait coercion applies to it.
    if sema_type_same_named(expected, owned.ty) -> return Val(owned.move())
    required := sema_expr_expected_type(expected, environment, program)
    offered := sema_expr_expected_type(owned.ty, environment, program)
    // (Rust `wrap_dyn_value`): a Dyn has no truthiness, and a
    // wrappable value placed where a Dyn is expected wraps into one. A literal
    // map keeps its source order; any other value goes through its Encode.
    if required == Type.Bool && sema_dyn_is_type(offered) {
        diagnostics.push(sema_dyn_condition_error(owned.span))
        return None
    }
    if sema_dyn_is_type(required) && !sema_dyn_is_type(offered) {
        if !sema_dyn_wrappable(offered) {
            diagnostics.push(sema_error("E0172", owned.span, "`{type_name(offered)}` does not wrap into `Dyn` automatically", "only primitive data and recursively wrappable collections wrap automatically", "write `Dyn.from(value)` (the type must implement `Encode`)"))
            return None
        }
        span: owned.span
        if owned.kind == .Map(entries) {
            payload: sema_tree_node(owned.ty, TExprKind.MapLit{entries: entries}, span)
            return Val(sema_tree_node(required, TExprKind.JSONLit{variant: "Object", arg: Val(payload), clone_arg: false}, span))
        }
        return Val(sema_tree_node(required, TExprKind.HandleMethod{receiver: owned.move(), operation: THandleOp.SerdeEncode, args: [TExpr]{}}, span))
    }
    if sema_expr_optional_lift_type(required, offered, environment, program) == .Val(lifted_type) {
        span: owned.span
        return Val(sema_tree_node(lifted_type, TExprKind.Present{value: owned.move()}, span))
    }
    if sema_expr_strict_zone_erased(required, offered, environment, program) {
        diagnostics.push(sema_error("E0771", owned.span, "this needs {sema_type_show(required)}, but the function value is {sema_type_show(offered)}", "public labels and parameter zones are part of a function's callable type", "use `{type_name(required)}` here"))
        return None
    }
    compatible: sema_expr_expected_assignable(required, offered, environment, program) ?? return None
    if !compatible {
        diagnostics.push(sema_expr_mismatch_diagnostic(required, offered, owned.span))
        return None
    }
    Val(sema_expr_expected_trait_coercion(owned, required, offered, environment, program))
}

// Whether sema_expr_expected(value, expected) is `value` itself, decided by
// the value's type alone: no expected type, or a scalar leaf expected type the
// value has exactly (a scalar leaf resolves to itself and is assignable to
// itself, with no lift, zone or coercion; most literals, locals and operators
// land here). A caller that owns the value keeps it instead of passing it in
// to be copied back out.
sema_expr_expected_keeps: fn(ty: Type, expected: Type?) -> Bool Never! {
    required_leaf: expected ?? return true
    sema_expr_scalar_leaf(required_leaf) && type_identity_equal(required_leaf, ty)
}

// The scalar leaf types: no name to resolve and nothing nested.
sema_expr_scalar_leaf: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 -> true
        else -> false
    }
}

// The rejection for a value that can't fill `required`: the callable and
// carrier contracts get their own codes before the plain type mismatch.
sema_expr_mismatch_diagnostic: fn(required: Type, offered: Type, span: Span) -> Diagnostic {
    // E2426: a callable promised to return `Never` can't be a
    // value-producing function.
    if required == .Fn(_, required_ret, _, _, _, _) && offered == .Fn(_, offered_ret, _, _, _, _) && sema_expr_never_success(required_ret) && !sema_expr_never_success(offered_ret) {
        return sema_error("E2426", span, "Function value does not satisfy `fn() Never`.", "`fn() Never` promises the callable never completes, so a returning function has the wrong contract.", "Pass a function declared `Never`, or change the expected function type.")
    }
    if sema_plain_carrier_mismatch(required, offered, span) == .Val(carrier) -> return carrier
    sema_type_mismatch(required, offered, span)
}

// Rust `Type::has_never_success`: `Never`, or a fallible `Never !E`.
sema_expr_never_success: fn(ty: Type?) -> Bool Never! {
    value: ty ?? return false
    never: Type.Named{name: "Never"}
    if value == {
        .Result(ok, _) -> ok == never
        else -> value == never
    }
}

// An erased function type carries no proof that it honors a strict
// positional-only or label-only zone, so it can't cross into one (E0771).
sema_expr_strict_zone_erased: fn(required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if required == .Fn(params, ret, effects, contract, metadata, provenance) && contract == .Val(rows) && offered == .Fn(_, _, _, offered_contract, _, _) && offered_contract == None {
        if !sema_expr_contract_has_strict_zone(rows) -> return false
        erased: Type.Fn{params: params, ret: ret, effect_bound: effects, param_contract: None, call_metadata: metadata, return_view_provenance: provenance}
        return sema_expr_expected_assignable(erased, offered, environment, program) == (Val(true))
    }
    false
}

sema_expr_contract_has_strict_zone: fn(rows: [CallContractRow]) -> Bool Never! {
    loop row in rows {
        if row.zone == ParamZone.PositionalOnly || row.zone == ParamZone.LabelOnly -> return true
    }
    false
}
sema_expr_precise_error: fn(op: BinOp, lhs: Type, rhs: Type, span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_error("E0133", span, "`{sema_expr_binary_name(op)}` isn't defined between `{type_name(lhs)}` and `{type_name(rhs)}`", "`Decimal` supports `+`, `-`, `*`, `/` (giving a `Fraction`), and `==`/`!=`; `Fraction` and `Complex` support only their declared exact operations", "use a named exact constructor or make both operands the same precise type"))
}

sema_expr_precise_orders_by_compare: fn(op: BinOp, lhs: Type, rhs: Type) -> Bool Never! {
    if op != BinOp.Compare && op != BinOp.Lt && op != BinOp.Le && op != BinOp.Gt && op != BinOp.Ge -> return false
    name: sema_expr_precise_name(lhs) ?? return false
    if sema_expr_precise_name(rhs) != (Val(name)) -> return false
    name == "Decimal" || name == "Fraction"
}

sema_expr_check_precise_binary: fn(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    left_name := sema_expr_precise_name(lhs.ty)
    right_name := sema_expr_precise_name(rhs.ty)
    if left_name == None && right_name == None -> return None
    left := lhs
    right := rhs
    lname := left_name
    rname := right_name
    if {
        lname == (Val("Complex")) && rname == None && sema_expr_is_numeric(rhs.ty) -> {
            right = sema_expr_precise_complex(rhs, span, line, context, diagnostics) ?? return None
            rname = Val("Complex")
        }
        rname == (Val("Complex")) && lname == None && sema_expr_is_numeric(lhs.ty) -> {
            left = sema_expr_precise_complex(lhs, span, line, context, diagnostics) ?? return None
            lname = Val("Complex")
        }
        lname != None && rname == None && lname != (Val("Complex")) -> {
            if sema_expr_integer_literal_value(rhs) != None {
                right = sema_expr_precise_integer(rhs, lname ?? "", span) ?? {
                    sema_expr_precise_error(op, lhs.ty, rhs.ty, span, diagnostics)
                    return None
                }
                rname = lname
            }
        }
        rname != None && lname == None && rname != (Val("Complex")) -> {
            if sema_expr_integer_literal_value(lhs) != None {
                left = sema_expr_precise_integer(lhs, rname ?? "", span) ?? {
                    sema_expr_precise_error(op, lhs.ty, rhs.ty, span, diagnostics)
                    return None
                }
                lname = rname
            }
        }
    }
    // An exact Int crosses into Decimal without loss, so it meets a Decimal as
    // a Decimal of the same value (`qty * price`).
    if lname == (Val("Decimal")) && rname == None && rhs.ty == Type.Int {
        right = sema_expr_decimal_from_int(rhs.copy(), span)
        rname = Val("Decimal")
    }
    if rname == (Val("Decimal")) && lname == None && lhs.ty == Type.Int {
        left = sema_expr_decimal_from_int(lhs.copy(), span)
        lname = Val("Decimal")
    }
    if (lname == (Val("Decimal")) && (rhs.ty == Type.Float || rhs.ty == Type.Float32)) || (rname == (Val("Decimal")) && (lhs.ty == Type.Float || lhs.ty == Type.Float32)) {
        diagnostics.push(sema_error("E0131", span, "`Float` and `Decimal` can't be mixed — got `{sema_type_show(lhs.ty)}` and `{sema_type_show(rhs.ty)}`", "precise numeric types never mix with fixed-width integers or floats without an explicit constructor", "use `Decimal(\"…\")` for exact money arithmetic; `Float` is for approximate science"))
        return None
    }
    if lname == None || rname == None || lname != rname {
        sema_expr_precise_error(op, lhs.ty, rhs.ty, span, diagnostics)
        return None
    }
    precise_name: lname ?? return None
    method := String?{None}
    result_ty := Type.Named{name: precise_name}
    if op == BinOp.Add -> method = Val("add")
    if op == BinOp.Sub -> method = Val("sub")
    if op == BinOp.Mul -> method = Val("mul")
    if op == BinOp.Div {
        method = Val("div")
        // Decimal division is exact only as a Fraction (`__decimal_div`):
        // a repeating quotient has no Decimal.
        if precise_name == "Decimal" -> result_ty = Type.Named{name: "Fraction"}
    }
    if op == BinOp.Eq || op == BinOp.Ne {
        if precise_name == "Complex" {
            sema_expr_precise_error(op, lhs.ty, rhs.ty, span, diagnostics)
            return None
        }
        method = Val("equal")
        result_ty = Type.Bool
    }
    operation: method ?? {
        sema_expr_precise_error(op, lhs.ty, rhs.ty, span, diagnostics)
        return None
    }
    value := sema_tree_node(result_ty, TExprKind.PreciseBuiltin{type_name: precise_name, function: operation, args: [TExpr]{left, right}}, span)
    if op == BinOp.Ne -> return Val(sema_tree_node(Type.Bool, TExprKind.Unary{op: TUnaryOp.Not, operand: value}, span))
    Val(value)
}
sema_expr_is_math_type_name: fn(name: String) -> Bool Never! {
    if name == "Vec2" || name == "Vec3" || name == "Vec4" || name == "Mat3" || name == "Mat4" -> return true
    if name == "F32x4" || name == "F64x4" || name == "I32x4" || name == "U32x4" || name == "I64x4" || name == "U64x4" -> return true
    if name == "F64x2" || name == "I64x2" || name == "U64x2" -> return true
    if name == "F32x8" || name == "I16x8" || name == "U16x8" || name == "I32x8" || name == "U32x8" -> return true
    if name == "I8x16" || name == "U8x16" || name == "I16x16" || name == "U16x16" -> return true
    name == "I8x32" || name == "U8x32"
}

// The math type a value of `ty` is: its bare name (`Vec3`), also when the
// type carries the Core declaration's canonical identity
// (`<corelib>/core.math::Vec3`), as an operator hook's return does.
sema_expr_math_leaf_name: fn(ty: Type) -> String? {
    name: sema_expr_type_base_name(ty) ?? return None
    if sema_expr_is_math_type_name(name) -> return Val(name)
    if !name.starts_with("<corelib>/") -> return None
    parts: name.split("::").to_list()
    leaf: parts[parts.len() - 1]
    if sema_expr_is_math_type_name(leaf) -> return Val(leaf)
    None
}

sema_expr_math_scalar_operand: fn(ty: Type) -> Bool Never! {
    if ty == Type.Int || ty == Type.Float || ty == Type.Float32 -> return true
    if ty == .IntN(_, _) -> return true
    if ty == .InlineRange(_, _, _) -> return true
    if ty == (Type.Named{name: "Decimal"}) || ty == (Type.Named{name: "Fraction"}) || ty == (Type.Named{name: "F64"}) -> return true
    false
}

sema_expr_math_result: fn(op: BinOp, left_name: String, right_name: String) -> Type? {
    same := left_name == right_name
    if op == BinOp.Add || op == BinOp.Sub {
        if same && sema_expr_is_math_type_name(left_name) -> return Val(Type.Named{name: left_name})
        return None
    }
    if op == BinOp.Mul {
        if same && sema_expr_is_math_type_name(left_name) -> return Val(Type.Named{name: left_name})
        if left_name == "Mat3" && right_name == "Vec3" -> return Val(Type.Named{name: "Vec3"})
        if left_name == "Mat4" && right_name == "Vec4" -> return Val(Type.Named{name: "Vec4"})
        return None
    }
    if op == BinOp.Div && same && (left_name == "F32x4" || left_name == "F64x4" || left_name == "I32x4" || left_name == "U32x4" || left_name == "I64x4" || left_name == "U64x4" || left_name == "F64x2" || left_name == "I64x2" || left_name == "U64x2" || left_name == "F32x8" || left_name == "I16x8" || left_name == "U16x8" || left_name == "I32x8" || left_name == "U32x8" || left_name == "I8x16" || left_name == "U8x16" || left_name == "I16x16" || left_name == "U16x16" || left_name == "I8x32" || left_name == "U8x32") -> return Val(Type.Named{name: left_name})
    if (op == BinOp.Eq || op == BinOp.Ne) && same && sema_expr_is_math_type_name(left_name) -> return Val(Type.Bool)
    None
}

sema_expr_math_scalar_result: fn(op: BinOp, math_name: String, scalar: Type) -> Type? {
    if (op != BinOp.Mul && op != BinOp.Div) || !sema_expr_is_math_type_name(math_name) || !sema_expr_math_scalar_operand(scalar) -> return None
    Val(Type.Named{name: math_name})
}

sema_expr_math_scalar_to_float: fn(value: TExpr, span: Span, line: Int, diagnostics: &[Diagnostic]) -> TExpr? {
    if value.ty == Type.Float || value.ty == Type.Float32 || value.ty == (Type.Named{name: "F64"}) -> return Val(value)
    if value.ty == (Type.Named{name: "Decimal"}) || value.ty == (Type.Named{name: "Fraction"}) {
        return Val(sema_tree_node(Type.Float, TExprKind.PreciseBuiltin{type_name: type_name(value.ty), function: "to_float", args: [TExpr]{value}}, span))
    }
    sema_expr_numeric_literal_conversion(value, Type.Float, span, line, diagnostics)
}

sema_expr_check_math_binary: fn(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int, diagnostics: &[Diagnostic]) -> TExpr? {
    left_name: sema_expr_type_base_name(lhs.ty)
    right_name: sema_expr_type_base_name(rhs.ty)
    left_math := left_name != None && sema_expr_is_math_type_name(left_name ?? "")
    right_math := right_name != None && sema_expr_is_math_type_name(right_name ?? "")
    if !left_math && !right_math -> return None
    if left_math && right_math {
        result: sema_expr_math_result(op, left_name ?? "", right_name ?? "") ?? return None
        function := sema_expr_binary_name(op)
        if op == BinOp.Add -> function = "add"
        if op == BinOp.Sub -> function = "sub"
        if op == BinOp.Mul {
            function = if left_name != right_name -> "transform" else if left_name == (Val("Vec3")) -> "hadamard_mul" else if left_name == (Val("Mat3")) || left_name == (Val("Mat4")) -> "matmul" else -> "mul"
        }
        if op == BinOp.Div -> function = "div"
        if op == BinOp.Eq -> function = "equal"
        if op == BinOp.Ne -> function = "equal"
        value := sema_tree_node(result, TExprKind.MathBuiltin{type_name: left_name ?? "", function: function, args: [TExpr]{lhs, rhs}}, span)
        if op == BinOp.Ne -> return Val(sema_tree_node(Type.Bool, TExprKind.Unary{op: TUnaryOp.Not, operand: value}, span))
        return Val(value)
    }
    if left_math {
        scalar_result := sema_expr_math_scalar_result(op, left_name ?? "", rhs.ty) ?? return None
        scalar: sema_expr_math_scalar_to_float(rhs, span, line, diagnostics) ?? return None
        function := if op == BinOp.Mul -> "mul" else -> "div"
        return Val(sema_tree_node(scalar_result, TExprKind.MathBuiltin{type_name: left_name ?? "", function: function, args: [TExpr]{lhs, scalar}}, span))
    }
    scalar_result := sema_expr_math_scalar_result(op, right_name ?? "", lhs.ty) ?? return None
    scalar: sema_expr_math_scalar_to_float(lhs, span, line, diagnostics) ?? return None
    right_name_value := right_name ?? ""
    function := if op == BinOp.Mul -> "mul_{right_name_value}" else -> "div_{right_name_value}"
    Val(sema_tree_node(scalar_result, TExprKind.MathBuiltin{type_name: "Float", function: function, args: [TExpr]{scalar, rhs}}, span))
}
sema_expr_geometry_is_point: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> return sema_geometry_nominal_leaf(name) == "ScreenPoint" || sema_geometry_nominal_leaf(name) == "WorldPoint" || sema_geometry_nominal_leaf(name) == "ViewPoint" || sema_geometry_nominal_leaf(name) == "CameraPoint" || sema_geometry_nominal_leaf(name) == "DevicePoint"
        .Apply(name, args) -> return sema_geometry_nominal_leaf(name) == "Point2" && args.len() == 2
        else -> false
    }
}

sema_expr_geometry_is_delta: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> return sema_geometry_nominal_leaf(name) == "ScreenDelta" || sema_geometry_nominal_leaf(name) == "WorldDelta" || sema_geometry_nominal_leaf(name) == "ViewDelta" || sema_geometry_nominal_leaf(name) == "CameraDelta" || sema_geometry_nominal_leaf(name) == "DeviceDelta"
        .Apply(name, args) -> return sema_geometry_nominal_leaf(name) == "Delta2" && args.len() == 2
        else -> false
    }
}

sema_expr_geometry_space: fn(ty: Type) -> Type? {
    if ty == {
        .Named(source_name) -> {
            name: sema_geometry_nominal_leaf(source_name)
            if name == "ScreenPoint" || name == "ScreenDelta" -> return Val(Type.Named{name: "Screen"})
            if name == "WorldPoint" || name == "WorldDelta" -> return Val(Type.Named{name: "World"})
            if name == "ViewPoint" || name == "ViewDelta" -> return Val(Type.Named{name: "View"})
            if name == "CameraPoint" || name == "CameraDelta" -> return Val(Type.Named{name: "Camera"})
            if name == "DevicePoint" || name == "DeviceDelta" -> return Val(Type.Named{name: "Device"})
        }
        .Apply(name, args) -> {
            if (sema_geometry_nominal_leaf(name) == "Point2" || sema_geometry_nominal_leaf(name) == "Delta2") && args.len() == 2 -> return Val(args[1])
        }
        else -> {}
    }
    None
}

sema_expr_geometry_dynamic: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, _) -> return sema_geometry_nominal_leaf(name) == "Point2" || sema_geometry_nominal_leaf(name) == "Delta2"
        else -> false
    }
}

sema_expr_geometry_scalar: fn(ty: Type) -> Type Never! {
    if ty == {.Apply(_, args) -> if args.len() > 0 -> return args[0] else -> Type.Float else -> Type.Float}
}

sema_expr_geometry_generic: fn(name: String, source: Type) -> Type Never! {
    Type.Apply{name: name, args: [Type]{sema_expr_geometry_scalar(source), sema_expr_geometry_space(source) ?? Type.Named{name: "Unknown"}}}
}

sema_expr_geometry_result: fn(op: BinOp, lhs: Type, rhs: Type) -> Type? {
    result: sema_expr_geometry_result_inner(op, lhs, rhs) ?? return None
    source: if sema_geometry_nominal_leaf(sema_expr_geometry_name(lhs)) != sema_expr_geometry_name(lhs) -> lhs else -> rhs
    if result == (Type.Named{name: "__GeometrySpaceMismatch"}) || result == (Type.Named{name: "__GeometryUnsupported"}) -> return Val(result)
    Val(sema_geometry_restore_owner(result, source))
}

sema_expr_geometry_result_inner: fn(op: BinOp, lhs: Type, rhs: Type) -> Type? {
    left_point := sema_expr_geometry_is_point(lhs)
    right_point := sema_expr_geometry_is_point(rhs)
    left_delta := sema_expr_geometry_is_delta(lhs)
    right_delta := sema_expr_geometry_is_delta(rhs)
    if !(left_point || right_point || left_delta || right_delta) -> return None
    left_space: sema_expr_geometry_space(lhs) ?? Type.Named{name: "Unknown"}
    right_space: sema_expr_geometry_space(rhs) ?? Type.Named{name: "Unknown"}
    if !type_identity_equal(left_space, right_space) -> return Val(Type.Named{name: "__GeometrySpaceMismatch"})
    dynamic := sema_expr_geometry_dynamic(lhs) || sema_expr_geometry_dynamic(rhs)
    result := Type?{None}
    if {
        op == BinOp.Add -> {
            if {
                left_point && right_delta -> {
                    result = Val(if dynamic -> sema_expr_geometry_generic("Point2", lhs) else -> lhs)
                }
                left_delta && right_point -> {
                    result = Val(if dynamic -> sema_expr_geometry_generic("Point2", rhs) else -> rhs)
                }
                left_delta && right_delta -> {
                    result = Val(if dynamic -> sema_expr_geometry_generic("Delta2", lhs) else -> lhs)
                }
            }
        }
        op == BinOp.Sub -> {
            if {
                left_point && right_delta -> {
                    result = Val(if dynamic -> sema_expr_geometry_generic("Point2", lhs) else -> lhs)
                }
                left_point && right_point -> {
                    if {
                        dynamic -> {
                            result = Val(sema_expr_geometry_generic("Delta2", lhs))
                        }
                        else -> {
                            point_leaf: sema_geometry_nominal_leaf(sema_expr_geometry_name(lhs))
                            point_name: if point_leaf == "ScreenPoint" -> "ScreenDelta" else -> if point_leaf == "WorldPoint" -> "WorldDelta" else -> if point_leaf == "ViewPoint" -> "ViewDelta" else -> if point_leaf == "CameraPoint" -> "CameraDelta" else -> if point_leaf == "DevicePoint" -> "DeviceDelta" else -> ""
                            if point_name != "" -> result = Val(Type.Named{name: point_name})
                        }
                    }
                }
                left_delta && right_delta -> {
                    result = Val(if dynamic -> sema_expr_geometry_generic("Delta2", lhs) else -> lhs)
                }
            }
        }
        op == BinOp.Eq || op == BinOp.Ne -> {
            if (left_point && right_point) || (left_delta && right_delta) -> result = Val(Type.Bool)
        }
    }
    result_value: result ?? return Val(Type.Named{name: "__GeometryUnsupported"})
    if dynamic && result_value != Type.Bool {
        return Val(Type.Result{ok: result_value, err: Type.Named{name: "TransformError"}})
    }
    Val(result_value)
}

sema_expr_geometry_name: fn(ty: Type) -> String Never! {
    if ty == {
        .Named(name) -> return name
        .Apply(name, _) -> return name
        else -> return type_name(ty)
    }
}

sema_expr_geometry_diagnostic: fn(op: BinOp, lhs: Type, rhs: Type, span: Span, diagnostics: &[Diagnostic]) {
    expected := type_name(sema_expr_geometry_space(lhs) ?? lhs)
    actual := type_name(sema_expr_geometry_space(rhs) ?? rhs)
    if sema_expr_geometry_is_point(lhs) && sema_expr_geometry_is_point(rhs) {
        expected = "a displacement in {expected}"
        actual = "a point in {actual}"
    }
    diagnostics.push(sema_error("E2520", span, "`{sema_expr_binary_name(op)}` needs `{expected}` space, got `{actual}`.", "Coordinate-space tags are ordinary type facts; combining different spaces would make a numerically valid result mean the wrong thing.", "Use a `{expected}` point or displacement, or convert it with a checked transform."))
}

sema_expr_check_geometry_binary: fn(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int, diagnostics: &[Diagnostic]) -> TExpr? {
    if !sema_expr_geometry_is_point(lhs.ty) && !sema_expr_geometry_is_delta(lhs.ty) && !sema_expr_geometry_is_point(rhs.ty) && !sema_expr_geometry_is_delta(rhs.ty) -> return None
    left_space: sema_expr_geometry_space(lhs.ty) ?? lhs.ty
    right_space: sema_expr_geometry_space(rhs.ty) ?? rhs.ty
    if !type_identity_equal(left_space, right_space) {
        sema_expr_geometry_diagnostic(op, lhs.ty, rhs.ty, span, diagnostics)
        return None
    }
    result: sema_expr_geometry_result(op, lhs.ty, rhs.ty) ?? {
        sema_expr_geometry_diagnostic(op, lhs.ty, rhs.ty, span, diagnostics)
        return None
    }
    if result == (Type.Named{name: "__GeometryUnsupported"}) {
        sema_expr_geometry_diagnostic(op, lhs.ty, rhs.ty, span, diagnostics)
        return None
    }
    if result == (Type.Named{name: "__GeometrySpaceMismatch"}) -> return None
    if op == BinOp.Eq || op == BinOp.Ne {
        test_op := TBinaryOp.Eq
        if op == BinOp.Ne -> test_op = TBinaryOp.Ne
        value := sema_tree_node(Type.Bool, TExprKind.Binary{op: test_op, overflow: false, line: line, lhs: lhs, rhs: rhs}, span)
        return Val(value)
    }
    if op == BinOp.Add || op == BinOp.Sub {
        function := "add"
        if op == BinOp.Sub -> function = "sub"
        value := sema_tree_node(result, TExprKind.MathBuiltin{type_name: sema_expr_geometry_name(lhs.ty), function: function, args: [TExpr]{lhs, rhs}}, span)
        return Val(value)
    }
    sema_expr_geometry_diagnostic(op, lhs.ty, rhs.ty, span, diagnostics)
    None
}

sema_expr_check_duration_binary: fn(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span) -> TExpr? {
    if lhs.ty == (Type.Named{name: "Duration"}) && rhs.ty == Type.Int && (op == BinOp.Mul || op == BinOp.Div) {
        operation := THandleOp.DurationScale
        if op == BinOp.Div -> operation = THandleOp.DurationDivide
        return Val(sema_tree_node(Type.Named{name: "Duration"}, TExprKind.HandleMethod{receiver: lhs, operation: operation, args: [TExpr]{rhs}}, span))
    }
    if lhs.ty == Type.Int && rhs.ty == (Type.Named{name: "Duration"}) && op == BinOp.Mul {
        return Val(sema_tree_node(Type.Named{name: "Duration"}, TExprKind.HandleMethod{receiver: rhs, operation: THandleOp.DurationScale, args: [TExpr]{lhs}}, span))
    }
    None
}

sema_expr_check_time_binary: fn(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int) -> TExpr? {
    if lhs.ty != (Type.Named{name: "Duration"}) && lhs.ty != (Type.Named{name: "Instant"}) -> return None
    if rhs.ty != (Type.Named{name: "Duration"}) && rhs.ty != (Type.Named{name: "Instant"}) -> return None
    if op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge || op == BinOp.Compare {
        if lhs.ty != rhs.ty -> return None
        result_ty := if op == BinOp.Compare -> Type.Named{name: "Ordering"} else -> Type.Bool
        return Val(sema_tree_node(result_ty, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span))
    }
    result := Type?{None}
    if {
        lhs.ty == (Type.Named{name: "Duration"}) && rhs.ty == (Type.Named{name: "Duration"}) -> {
            if op == BinOp.Add || op == BinOp.Sub -> result = Val(Type.Named{name: "Duration"})
        }
        lhs.ty == (Type.Named{name: "Instant"}) && rhs.ty == (Type.Named{name: "Instant"}) -> {
            if op == BinOp.Sub -> result = Val(Type.Named{name: "Duration"})
        }
        (lhs.ty == Type.Named{name: "Instant"} && rhs.ty == Type.Named{name: "Duration"}) || (lhs.ty == Type.Named{name: "Duration"} && rhs.ty == Type.Named{name: "Instant"}) -> {
            if op == BinOp.Add -> result = Val(Type.Named{name: "Instant"})
            if lhs.ty == (Type.Named{name: "Instant"}) && op == BinOp.Sub -> result = Val(Type.Named{name: "Instant"})
        }
    }
    result_ty: result ?? return None
    Val(sema_tree_node(result_ty, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span))
}

SemaExprDistinctFacts: struct {
    name: String
    // The declaration's symbol key: one distinct type under any spelling
    // (`Severity`, `module.Severity`).
    key: String
    base: Type
    numeric: Bool
    range: TIntegerBounds?
}

sema_expr_distinct_same: fn(lhs: Type, rhs: Type, left_facts: SemaExprDistinctFacts?, right_facts: SemaExprDistinctFacts?) -> Bool Never! {
    if lhs == rhs -> return true
    if left_facts == .Val(left) {
        if right_facts == .Val(right) -> return left.key == right.key
    }
    false
}

// A quantity unit type's declared base: `.raw()` extracts its unchanged
// magnitude.
sema_expr_quantity_raw_base: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> Type? {
    if ty == .Quantity(base, _) -> return Val(base)
    if sema_expr_unit_fact(ty, environment, program) != None -> return Val(Type.Float)
    name: if ty == {
        .Named(value) -> value
        else -> { return None }
    }
    owner: sema_expression_type_symbol(scopes, environment, program, name) ?? return None
    definition_value: sema_scope_declaration_distinct(environment, program, owner.id) ?? return None
    if definition_value.quantity == None -> return None
    if program.registration_graph == .Val(graph) -> return Val(sema_type_resolve_declared(graph, definition_value.base, owner.module_name))
    Val(definition_value.base)
}

sema_expr_distinct_facts: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> SemaExprDistinctFacts? {
    sema_expr_declared_distinct_facts(ty, false, environment, program, scopes)
}

// A `#UnitFamily` member is a distinct type with a quantity facet: it owns the
// same base conversion (`Meter.from_float`), while its arithmetic is the unit
// algebra's, so only the conversion admits it.
sema_expr_declared_distinct_facts: fn(ty: Type, admit_quantity: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> SemaExprDistinctFacts? {
    name := ""
    if ty == {
        .Named(value) -> name = value
        else -> return None
    }
    owner := sema_expression_type_symbol(scopes, environment, program, name) ?? return None
    definition_value: sema_scope_declaration_distinct(environment, program, owner.id) ?? return None
    if definition_value.quantity != None && !admit_quantity -> return None
    // Imported projections retain nominal bases from the declaring module.
    base := definition_value.base
    if program.registration_graph == .Val(graph) {
        base = sema_type_resolve_declared(graph, base, owner.module_name)
    }
    numeric := false
    loop marker in definition_value.derives {
        if marker.name == "Numeric" -> numeric = true
    }
    range := TIntegerBounds?{None}
    if definition_value.range != None {
        value: definition_value.range ?? return None
        range = Val(TIntegerBounds{lo: value.lo, hi: value.hi})
    }
    Val(SemaExprDistinctFacts{name: name, key: owner.id.key, base: base, numeric: numeric, range: range})
}

sema_expr_check_distinct_binary: fn(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int, left_facts: SemaExprDistinctFacts?, right_facts: SemaExprDistinctFacts?, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> TExpr? {
    if left_facts == None && right_facts == None -> return None
    arithmetic := op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div || op == BinOp.FloorDiv || op == BinOp.Mod || op == BinOp.Rem || op == BinOp.BitAnd || op == BinOp.BitOr || op == BinOp.BitXor || op == BinOp.Shl || op == BinOp.Shr
    if arithmetic {
        distinct: if left_facts != None -> left_facts else -> right_facts ?? return None
        if !distinct.numeric {
            diagnostics.push(sema_error("E0127", span, "`{sema_expr_binary_name(op)}` is not available on `{distinct.name}`", "`{distinct.name}` is a distinct type but isn't marked `#Numeric`, so it doesn't inherit arithmetic operators — only `==` is available", "add `#Numeric` before the declaration if this is a quantity, or use `.raw()` to work on the underlying value"))
            return None
        }
        if !sema_expr_distinct_same(lhs.ty, rhs.ty, left_facts, right_facts) {
            diagnostics.push(sema_error("E0127", span, "`{sema_expr_binary_name(op)}` is not available between `{type_name(lhs.ty)}` and `{type_name(rhs.ty)}`", "`#Numeric` distinct types only support arithmetic between the same type", "both sides must be `{distinct.name}`"))
            return None
        }
        effective_lhs := lhs
        effective_rhs := rhs
        result_ty := lhs.ty
        if distinct.range != None {
            _ := sema_scope_require_knowledge_gate(scopes, SemaKnowledgePlane.Range, SemaKnowledgeGate.BoundedArithmetic, span, diagnostics)
            base := distinct.base
            effective_lhs = sema_tree_node(base, TExprKind.DistinctRaw{value: lhs}, span)
            effective_rhs = sema_tree_node(base, TExprKind.DistinctRaw{value: rhs}, span)
            result_ty = base
        }
        return Val(sema_tree_node(result_ty, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: effective_lhs, rhs: effective_rhs}, span))
    }
    if op == BinOp.Eq || op == BinOp.Ne {
        if !sema_expr_distinct_same(lhs.ty, rhs.ty, left_facts, right_facts) {
            distinct: if left_facts != None -> left_facts else -> right_facts ?? return None
            diagnostics.push(sema_error("E0753", span, "a `{type_name(lhs.ty)}` can't be compared with a `{type_name(rhs.ty)}`", "`{distinct.name}` is a distinct type; it only compares equal to another `{distinct.name}`", "use `.raw()` to compare the underlying values, or construct a `{distinct.name}`"))
            return None
        }
        return Val(sema_tree_node(Type.Bool, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span))
    }
    None
}

sema_expr_unit_fact: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaRegistrationUnitFact? {
    if program.registration_graph == .Val(graph) -> return sema_registration_unit_fact_for_type(graph, ty)
    None
}

sema_expr_unit_ratio_sub: fn(left: UnitRatio, right: UnitRatio) -> UnitRatio Never! {
    UnitRatio{numerator: left.numerator * right.denominator - right.numerator * left.denominator, denominator: left.denominator * right.denominator}
}

sema_expr_unit_ratio_div: fn(left: UnitRatio, right: UnitRatio) -> UnitRatio? {
    if right.numerator == 0 -> return None
    Val(UnitRatio{numerator: left.numerator * right.denominator, denominator: left.denominator * right.numerator})
}

sema_expr_unit_ratio_abs: fn(value: UnitRatio) -> UnitRatio Never! {
    numerator := value.numerator
    denominator := value.denominator
    if numerator < 0 -> numerator = -numerator
    if denominator < 0 -> denominator = -denominator
    UnitRatio{numerator: numerator, denominator: denominator}
}

sema_expr_unit_ratio_le: fn(left: UnitRatio, right: UnitRatio) -> Bool Never! {
    left_abs := sema_expr_unit_ratio_abs(left)
    right_abs := sema_expr_unit_ratio_abs(right)
    left_abs.numerator * right_abs.denominator <= right_abs.numerator * left_abs.denominator
}

sema_expr_unit_ratio_text: fn(value: UnitRatio) -> String Never! {
    "{value.numerator}/{value.denominator}"
}
sema_expr_unit_ratio_equal: fn(left: UnitRatio, right: UnitRatio) -> Bool Never! {
    left.numerator * right.denominator == right.numerator * left.denominator
}

sema_expr_unit_is_measured: fn(fact: SemaRegistrationUnitFact) -> Bool Never! {
    if fact.scale_provenance == {.Measured(_, _, _) -> true else -> false}
}

sema_expr_unit_is_symbolic: fn(fact: SemaRegistrationUnitFact) -> Bool Never! {
    if fact.scale_provenance == {.SymbolicPi(_, _) -> true else -> false}
}

sema_expr_unit_conversion_total: fn(source: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact) -> Bool Never! {
    sema_expr_unit_ratio_equal(source.scale, destination.scale) && sema_expr_unit_ratio_equal(source.offset, destination.offset)
}

sema_expr_unit_conversion_method: fn(fact: SemaRegistrationUnitFact) -> String Never! {
    parts := fact.name.split(".").to_list()
    leaf := if parts.len() > 0 -> parts[parts.len() - 1] else -> fact.name
    bytes := leaf.bytes()
    output := [U8]{}
    index := 0
    loop index < bytes.len() {
        code := Int.from_u8(bytes[index])
        previous := if index > 0 -> Int.from_u8(bytes[index - 1]) else -> 0
        next := if index + 1 < bytes.len() -> Int.from_u8(bytes[index + 1]) else -> 0
        uppercase := code >= 65 && code <= 90
        boundary := uppercase && index > 0 && ((previous >= 97 && previous <= 122) || (previous >= 65 && previous <= 90 && next >= 97 && next <= 122))
        if boundary -> output.push(U8{95})
        if uppercase -> output.push(U8{code + 32}) else -> output.push(bytes[index])
        index += 1
    }
    snake := String.from_bytes(output) ?? leaf
    "from_{snake}"
}
sema_expr_unit_concrete_value: fn(value: TExpr, context: SemaCheckContext) -> Float? {
    if value.kind == {
        .IntLit(number, _) -> return Val(approx(number))
        .Flat(index) -> return sema_expr_unit_concrete_node(index, context)
        .CtLit(comptime_value) -> {
            if comptime_value == {
                .Int(number) -> return Val(approx(number))
                .Float(number, _) -> return Val(number)
                else -> {}
            }
        }
        .Unary(op, operand) -> {
            if op == TUnaryOp.Neg {
                concrete: sema_expr_unit_concrete_value(operand, context) ?? return None
                return Val(-concrete)
            }
        }
        .UnitConvert(argument, _, _, _, _, _, _, _) | .DistinctCtor(argument) -> return sema_expr_unit_concrete_value(argument, context)
        .MethodCall(_, method, _, args) -> {
            if method.name == "from_float" && args.len() == 1 -> return sema_expr_unit_concrete_value(args[0].value, context)
        }
        else -> {}
    }
    None
}

// The literal value behind arena row `index`: a numeric literal, its negation,
// or a distinct conversion (`Double.from_float(-1.0)`) of one.
sema_expr_unit_concrete_node: fn(index: Int, context: SemaCheckContext) -> Float? {
    if context.arena.tree.nodes[index - context.arena.tree.node_base].kind == {
        .FloatLit(number) -> return Val(number)
        .IntLit(number, _) -> return Val(approx(number))
        .Unary(op, operand) -> {
            if op == TUnaryOp.Neg {
                concrete: sema_expr_unit_concrete_node(operand, context) ?? return None
                return Val(-concrete)
            }
        }
        .DistinctConvert(_, argument, _, _, _) | .DistinctCtor(argument) -> return sema_expr_unit_concrete_node(argument, context)
        else -> {}
    }
    None
}

sema_expr_unit_exact_proof: fn(concrete: Float, source: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact, environment: SemaScopeEnvironment, program: SemaProgramTables, context: SemaCheckContext) -> Bool? {
    if program.registration_graph == None -> return None
    scale: sema_expr_unit_ratio_div(source.scale, destination.scale) ?? return Val(false)
    offset: sema_expr_unit_ratio_div(sema_expr_unit_ratio_sub(source.offset, destination.offset), destination.scale) ?? return Val(false)
    proof := sema_numeric_unit_conversion_exact(context.host_hooks, concrete, scale, offset)
    if proof == {
        .Exact(_) -> return Val(true)
        .Inexact -> return Val(false)
        .Unavailable -> return None
    }
}

sema_expr_unit_conversion_gate: fn(value: TExpr, source: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if source.name == destination.name -> return true
    if sema_expr_unit_is_measured(source) || sema_expr_unit_is_measured(destination) {
        measured := if sema_expr_unit_is_measured(source) -> source else -> destination
        if measured.scale_provenance == {
            .Measured(central_value, standard_uncertainty, provenance_source) -> {
                diagnostics.push(sema_error("E0127", span, "`{source.name}` to `{destination.name}` crosses a measured scale", "the pinned central value is {central_value} with standard uncertainty {standard_uncertainty} ({provenance_source})", "write an explicit rounded conversion to `{destination.name}` and audit the pinned source"))
            }
            else -> {}
        }
        return false
    }
    if !sema_expr_unit_conversion_is_finite(source, destination) {
        diagnostics.push(sema_error("E0127", span, "this unit conversion overflows its runtime representation", "the declared exact scale or offset is outside Float's finite range", "choose units with a finite conversion boundary"))
        return false
    }
    if !sema_expr_unit_is_symbolic(source) && !sema_expr_unit_is_symbolic(destination) && !sema_expr_unit_conversion_total(source, destination) {
        exact := false
        concrete := sema_expr_unit_concrete_value(value, context)
        if concrete != None {
            exact = sema_expr_unit_exact_proof(concrete ?? 0.0, source, destination, environment, program, context) ?? return false
        }
        if !exact && !sema_scope_knowledge_gate_allows(scopes, SemaKnowledgePlane.Unit, SemaKnowledgeGate.RoundedConversion) {
            method := sema_expr_unit_conversion_method(source)
            diagnostics.push(sema_error("E0127", span, "this implicit unit conversion would round", "the exact scale or offset cannot be represented as an integer conversion at this boundary", "write `{destination.name}.{method}_rounded(expr, .NearestEven, digits: 0)?` or choose another rounding policy"))
            return false
        }
    }
    if sema_scope_unit_explicit_units(scopes) {
        method := sema_expr_unit_conversion_method(source)
        diagnostics.push(sema_error("E0127", span, "`explicit_units` requires a written conversion", "this scope does not convert `{source.name}` to `{destination.name}` implicitly", "write `{destination.name}.{method}(expr)`"))
        return false
    }
    true
}

sema_expr_unit_conversion_pair_allowed: fn(left_value: TExpr, left: SemaRegistrationUnitFact, left_destination: SemaRegistrationUnitFact, right_value: TExpr, right: SemaRegistrationUnitFact, right_destination: SemaRegistrationUnitFact, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if !sema_expr_unit_conversion_gate(left_value, left, left_destination, span, environment, program, scopes, context, diagnostics) -> return false
    sema_expr_unit_conversion_gate(right_value, right, right_destination, span, environment, program, scopes, context, diagnostics)
}

// Rust `implicitly_convert_unit`: a unit value offered where another unit of
// the same family, dimension and kind is required converts implicitly.
sema_expr_unit_implicit_applies: fn(required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    destination: sema_expr_unit_fact(required, environment, program) ?? return false
    source: sema_expr_unit_fact(offered, environment, program) ?? return false
    source.name != destination.name && source.package == destination.package && source.family == destination.family && source.kind == destination.kind && sema_expr_unit_dimensions_equal(source.dimension, destination.dimension)
}

// The converted value, or None once the conversion gate has reported why the
// implicit conversion is refused (E0127).
sema_expr_unit_implicit_conversion: fn(value: TExpr, required: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    destination: sema_expr_unit_fact(required, environment, program) ?? return None
    source: sema_expr_unit_fact(value.ty, environment, program) ?? return None
    span: value.span
    if !sema_expr_unit_conversion_gate(value, source, destination, span, environment, program, scopes, context, diagnostics) -> return None
    line: sema_source_line_at(environment.source_segments, span) ?? 0
    Val(sema_expr_unit_conversion(value, source, destination, span, line, environment, program))
}

sema_expr_unit_ratio_is_finite: fn(value: UnitRatio) -> Bool {
    numerator := approx(value.numerator)
    denominator := approx(value.denominator)
    math.is_finite(numerator) && math.is_finite(denominator) && denominator != 0.0
}

sema_expr_unit_conversion_is_finite: fn(source: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact) -> Bool {
    scale: sema_expr_unit_ratio_div(source.scale, destination.scale) ?? return false
    offset: sema_expr_unit_ratio_div(sema_expr_unit_ratio_sub(source.offset, destination.offset), destination.scale) ?? return false
    sema_expr_unit_ratio_is_finite(scale) && sema_expr_unit_ratio_is_finite(offset)
}

sema_expr_unit_quantity_base_is_float: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if ty == {
        .Quantity(base, _) -> return base == Type.Float
        else -> {}
    }
    if sema_expr_unit_fact(ty, environment, program) != None -> return true
    ty == Type.Float
}

sema_expr_dimension_combine: fn(left: Dimension, right: Dimension, multiply: Bool) -> Dimension? {
    if multiply -> dimension_multiply(left, right) else -> dimension_divide(left, right)
}

sema_expr_unit_dimension: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Dimension? {
    if ty == {
        // copy: `dimension` is a payload of read parameter `ty`, which keeps the original; the Val carrier owns this one
        .Quantity(_, dimension) -> return Val(dimension.copy())
        else -> {}
    }
    fact := sema_expr_unit_fact(ty, environment, program) ?? return None
    fact.dimension
}

sema_expr_unit_counterpart: fn(fact: SemaRegistrationUnitFact, kind: QuantityKind, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaRegistrationUnitFact? {
    if program.registration_graph == .Val(graph) {
    loop candidate_index in 0..<graph.unit_facts.len() {
        if graph.unit_facts[candidate_index].package == fact.package && graph.unit_facts[candidate_index].family == fact.family && graph.unit_facts[candidate_index].member == fact.member && graph.unit_facts[candidate_index].kind == kind -> return Val(graph.unit_facts[candidate_index])
    }
    }
    None
}

sema_expr_unit_raw: fn(value: TExpr, span: Span) -> TExpr Never! {
    sema_tree_node(Type.Float, TExprKind.DistinctRaw{value: value}, span)
}

sema_expr_unit_measured_relative_uncertainty: fn(fact: SemaRegistrationUnitFact) -> Float? {
    if fact.scale_provenance == {
        .Measured(_, standard_uncertainty, _) -> {
            uncertainty: Float.parse(standard_uncertainty) ?? return None
            numerator := approx(fact.scale.numerator)
            denominator := approx(fact.scale.denominator)
            scale := math.fabs(numerator / denominator)
            if !math.is_finite(scale) || scale <= 0.0 -> return None
            return Val(math.fabs(uncertainty) / scale)
        }
        else -> None
    }
}

sema_expr_unit_relative_uncertainty: fn(source: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact) -> Float? {
    source_value := sema_expr_unit_measured_relative_uncertainty(source)
    destination_value := sema_expr_unit_measured_relative_uncertainty(destination)
    if source_value == None && destination_value == None -> return None
    left := source_value ?? 0.0
    right := destination_value ?? 0.0
    Val(math.hypot(left, right))
}

sema_expr_unit_conversion: fn(value: TExpr, source: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact, span: Span, line: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TExpr Never! {
    // copy: the converted value is a new owned TExpr. Between equal units it equals `value`, the
    // caller's checked operand (a read parameter), which the caller keeps.
    if source.name == destination.name -> return value.copy()
    scale: sema_expr_unit_ratio_div(source.scale, destination.scale) ?? UnitRatio{numerator: 1, denominator: 1}
    offset := sema_expr_unit_ratio_div(sema_expr_unit_ratio_sub(source.offset, destination.offset), destination.scale) ?? UnitRatio{numerator: 0, denominator: 1}
    relative_uncertainty := sema_expr_unit_relative_uncertainty(source, destination)
    sema_tree_node(Type.Named{name: destination.name}, TExprKind.UnitConvert{argument: value, scale: sema_expr_unit_ratio_text(scale), offset: sema_expr_unit_ratio_text(offset), rounding: None, fallible: false, relative_uncertainty: relative_uncertainty, file: environment.source_file, line: line}, span)
}

sema_expr_unit_arithmetic_mismatch: fn(op: BinOp, lhs: Type, rhs: Type, span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_error("E0127", span, "`{sema_expr_binary_name(op)}` is not available between `{type_name(lhs)}` and `{type_name(rhs)}`", "unit-family arithmetic only defines scalar scaling and physical dimension algebra; nominal units and affine points do not multiply or divide", "scale a linear unit or delta by a plain numeric scalar, or use a dimensioned linear/delta family for physical products"))
}

sema_expr_unit_dimension_mismatch: fn(op: BinOp, left: Dimension, right: Dimension, span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_error("E0359", span, "`{sema_expr_binary_name(op)}` can't combine {dimension_display_name(left)} with {dimension_display_name(right)}", "physical quantities must have compatible dimensions before they can be added, subtracted, or compared", "use matching dimensions, or use `*` or `/` to derive a new dimension"))
}

// Addition, subtraction and comparison need equal dimensions.
sema_expr_unit_needs_equal_dimensions: fn(op: BinOp) -> Bool Never! {
    op == BinOp.Add || op == BinOp.Sub || op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge || op == BinOp.Compare
}

sema_expr_unit_is_time: fn(fact: SemaRegistrationUnitFact) -> Bool Never! {
    fact.family == "Time" && fact.package == "core.units"
}

sema_expr_unit_is_scalable: fn(fact: SemaRegistrationUnitFact) -> Bool Never! {
    !sema_expr_unit_is_time(fact) && (fact.kind == QuantityKind.Linear || fact.kind == QuantityKind.Delta)
}

sema_expr_unit_binary_result: fn(op: BinOp, lhs: TExpr, rhs: TExpr, left_fact: SemaRegistrationUnitFact, right_fact: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact, span: Span, line: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TExpr Never! {
    left_value := sema_expr_unit_raw(sema_expr_unit_conversion(lhs, left_fact, destination, span, line, environment, program), span)
    right_value := sema_expr_unit_raw(sema_expr_unit_conversion(rhs, right_fact, destination, span, line, environment, program), span)
    raw := sema_tree_node(Type.Float, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: left_value, rhs: right_value}, span)
    if op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge {
        return sema_tree_expr(Type.Bool, raw.kind, span)
    }
    if op == BinOp.Compare -> return sema_tree_expr(Type.Named{name: "Ordering"}, raw.kind, span)
    sema_expr_unit_wrap_raw(raw, destination, span, line, environment, program)
}

sema_expr_unit_wrap_raw: fn(value: TExpr, fact: SemaRegistrationUnitFact, span: Span, line: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TExpr Never! {
    relative_uncertainty := sema_expr_unit_measured_relative_uncertainty(fact)
    sema_tree_node(Type.Named{name: fact.name}, TExprKind.UnitConvert{argument: value, scale: "1/1", offset: "0/1", rounding: None, fallible: false, relative_uncertainty: relative_uncertainty, file: environment.source_file, line: line}, span)
}

sema_expr_unit_dimensions_equal: fn(left: Dimension?, right: Dimension?) -> Bool Never! {
    if left == None || right == None -> return left == None && right == None
    dimension_identity(left ?? Dimension{axes: [DimensionAxis]{}}) == dimension_identity(right ?? Dimension{axes: [DimensionAxis]{}})
}

sema_expr_unit_dimension_overflow: fn(op: BinOp, span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_error("E0359", span, "{sema_expr_binary_name(op)} makes the physical dimension too large", "physical dimension exponents are checked compiler facts and cannot overflow", "simplify the repeated physical multiplication or division"))
}

sema_expr_unit_mixed_result: fn(op: BinOp, lhs: TExpr, rhs: TExpr, left_source: SemaRegistrationUnitFact, left_destination: SemaRegistrationUnitFact, right_source: SemaRegistrationUnitFact, right_destination: SemaRegistrationUnitFact, result_ty: Type, span: Span, line: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TExpr Never! {
    left_value := sema_expr_unit_raw(sema_expr_unit_conversion(lhs, left_source, left_destination, span, line, environment, program), span)
    right_value := sema_expr_unit_raw(sema_expr_unit_conversion(rhs, right_source, right_destination, span, line, environment, program), span)
    raw := sema_tree_node(Type.Float, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: left_value, rhs: right_value}, span)
    result_fact := sema_expr_unit_fact(result_ty, environment, program) ?? left_destination
    sema_expr_unit_wrap_raw(raw, result_fact, span, line, environment, program)
}

sema_expr_check_unit_binary: fn(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    left_fact := sema_expr_unit_fact(lhs.ty, environment, program)
    right_fact := sema_expr_unit_fact(rhs.ty, environment, program)
    left_dimension := sema_expr_unit_dimension(lhs.ty, environment, program)
    right_dimension := sema_expr_unit_dimension(rhs.ty, environment, program)
    if left_fact == None && right_fact == None && left_dimension == None && right_dimension == None -> return None

    if op == BinOp.Mul || op == BinOp.Div {
        if left_fact != None && right_fact == None && sema_expr_is_numeric(rhs.ty) {
            fact: left_fact ?? return None
            if !sema_expr_unit_is_scalable(fact) {
                sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, diagnostics)
                return None
            }
            scalar: sema_expr_numeric_conversion(rhs, Type.Float, span, line) ?? return None
            raw := sema_tree_node(Type.Float, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: sema_expr_unit_raw(lhs, span), rhs: scalar}, span)
            return Val(sema_expr_unit_wrap_raw(raw, fact, span, line, environment, program))
        }
        if right_fact != None && left_fact == None && sema_expr_is_numeric(lhs.ty) {
            fact: right_fact ?? return None
            if op != BinOp.Mul || !sema_expr_unit_is_scalable(fact) {
                sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, diagnostics)
                return None
            }
            scalar: sema_expr_numeric_conversion(lhs, Type.Float, span, line) ?? return None
            raw := sema_tree_node(Type.Float, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: scalar, rhs: sema_expr_unit_raw(rhs, span)}, span)
            return Val(sema_expr_unit_wrap_raw(raw, fact, span, line, environment, program))
        }
        if left_fact != None && right_fact != None {
            left: left_fact ?? return None
            right: right_fact ?? return None
            if left.kind == QuantityKind.Point || right.kind == QuantityKind.Point || left.dimension == None || right.dimension == None {
                sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, diagnostics)
                return None
            }
            dimensions: sema_expr_dimension_combine(left.dimension ?? Dimension{axes: [DimensionAxis]{}}, right.dimension ?? Dimension{axes: [DimensionAxis]{}}, op == BinOp.Mul) ?? {
                sema_expr_unit_dimension_overflow(op, span, diagnostics)
                return None
            }
            raw_lhs := sema_expr_unit_raw(lhs, span)
            raw_rhs := sema_expr_unit_raw(rhs, span)
            raw := sema_tree_node(Type.Float, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: raw_lhs, rhs: raw_rhs}, span)
            if dimensions.axes.len() == 0 -> return Val(raw)
            return Val(sema_tree_expr(Type.Quantity{base: Type.Float, dimension: dimensions}, raw.kind, span))
        }
        if left_dimension != None || right_dimension != None {
            left_point := false
            if left_fact != None {
                left_unit: left_fact ?? return None
                left_point = left_unit.kind == QuantityKind.Point
            }
            right_point := false
            if right_fact != None {
                right_unit: right_fact ?? return None
                right_point = right_unit.kind == QuantityKind.Point
            }
            if left_point || right_point {
                sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, diagnostics)
                return None
            }
            if !sema_expr_unit_quantity_base_is_float(lhs.ty, environment, program) || !sema_expr_unit_quantity_base_is_float(rhs.ty, environment, program) {
                diagnostics.push(sema_error("E0109", span, "{sema_expr_binary_name(op)} can't compare or combine {type_name(lhs.ty)} and {type_name(rhs.ty)}", "the operator has no built-in rule and no user-defined `impl Type.Trait` hook for this operand pair", "use a supported operand pair, call a named method, or implement the operator's hook trait on your own type for this pair"))
                return None
            }
            left_dim: left_dimension ?? Dimension{axes: [DimensionAxis]{}}
            right_dim: right_dimension ?? Dimension{axes: [DimensionAxis]{}}
            dimensions: sema_expr_dimension_combine(left_dim, right_dim, op == BinOp.Mul) ?? {
                sema_expr_unit_dimension_overflow(op, span, diagnostics)
                return None
            }
            left_value := if sema_expr_unit_fact(lhs.ty, environment, program) != None -> sema_expr_unit_raw(lhs, span) else -> lhs
            right_value := if sema_expr_unit_fact(rhs.ty, environment, program) != None -> sema_expr_unit_raw(rhs, span) else -> rhs
            raw := sema_tree_node(Type.Float, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: left_value, rhs: right_value}, span)
            if dimensions.axes.len() == 0 -> return Val(raw)
            return Val(sema_tree_expr(Type.Quantity{base: Type.Float, dimension: dimensions}, raw.kind, span))
        }
    }

    if left_fact != None && right_fact != None {
        left: left_fact ?? return None
        right: right_fact ?? return None
        same_family := left.package == right.package && left.family == right.family
        if !same_family {
            // Different dimensions are E0359 before the family check (spec
            // "Physical dimensions"); same-dimension nominal families stay E0127.
            if sema_expr_unit_needs_equal_dimensions(op) && left.dimension != None && right.dimension != None && !sema_expr_unit_dimensions_equal(left.dimension, right.dimension) {
                sema_expr_unit_dimension_mismatch(op, left.dimension ?? Dimension{axes: [DimensionAxis]{}}, right.dimension ?? Dimension{axes: [DimensionAxis]{}}, span, diagnostics)
                return None
            }
            sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, diagnostics)
            return None
        }
        if !sema_expr_unit_dimensions_equal(left.dimension, right.dimension) {
            if left.dimension != None || right.dimension != None {
                sema_expr_unit_dimension_mismatch(op, left.dimension ?? Dimension{axes: [DimensionAxis]{}}, right.dimension ?? Dimension{axes: [DimensionAxis]{}}, span, diagnostics)
            }
            return None
        }
        comparisons := op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge || op == BinOp.Compare
        if comparisons && left.kind == right.kind {
            destination := if sema_expr_unit_ratio_le(left.scale, right.scale) -> left else -> right
            if !sema_expr_unit_conversion_pair_allowed(lhs, left, destination, rhs, right, destination, span, environment, program, scopes, context, diagnostics) -> return None
            return Val(sema_expr_unit_binary_result(op, lhs, rhs, left, right, destination, span, line, environment, program))
        }
        if op == BinOp.Add || op == BinOp.Sub {
            if left.kind == QuantityKind.Point && right.kind == QuantityKind.Delta {
                delta_destination: sema_expr_unit_counterpart(left, QuantityKind.Delta, environment, program) ?? return None
                if !sema_expr_unit_conversion_pair_allowed(lhs, left, left, rhs, right, delta_destination, span, environment, program, scopes, context, diagnostics) -> return None
                return Val(sema_expr_unit_mixed_result(op, lhs, rhs, left, left, right, delta_destination, Type.Named{name: left.name}, span, line, environment, program))
            }
            if left.kind == QuantityKind.Delta && right.kind == QuantityKind.Point && op == BinOp.Add {
                delta_destination: sema_expr_unit_counterpart(right, QuantityKind.Delta, environment, program) ?? return None
                if !sema_expr_unit_conversion_pair_allowed(lhs, left, delta_destination, rhs, right, right, span, environment, program, scopes, context, diagnostics) -> return None
                return Val(sema_expr_unit_mixed_result(op, lhs, rhs, left, delta_destination, right, right, Type.Named{name: right.name}, span, line, environment, program))
            }
            if left.kind == QuantityKind.Point && right.kind == QuantityKind.Point && op == BinOp.Sub {
                destination := if sema_expr_unit_ratio_le(left.scale, right.scale) -> left else -> right
                delta_destination: sema_expr_unit_counterpart(destination, QuantityKind.Delta, environment, program) ?? return None
                if !sema_expr_unit_conversion_pair_allowed(lhs, left, destination, rhs, right, destination, span, environment, program, scopes, context, diagnostics) -> return None
                return Val(sema_expr_unit_mixed_result(op, lhs, rhs, left, destination, right, destination, Type.Named{name: delta_destination.name}, span, line, environment, program))
            }
            if (left.kind == QuantityKind.Linear && right.kind == QuantityKind.Linear) || (left.kind == QuantityKind.Delta && right.kind == QuantityKind.Delta) {
                destination := if sema_expr_unit_ratio_le(left.scale, right.scale) -> left else -> right
                if !sema_expr_unit_conversion_pair_allowed(lhs, left, destination, rhs, right, destination, span, environment, program, scopes, context, diagnostics) -> return None
                return Val(sema_expr_unit_binary_result(op, lhs, rhs, left, right, destination, span, line, environment, program))
            }
            if (left.kind == QuantityKind.Point && right.kind == QuantityKind.Point) || (left.kind == QuantityKind.Delta && right.kind == QuantityKind.Point) {
                diagnostics.push(sema_error("E0127", span, "`{sema_expr_binary_name(op)}` is not available between `{type_name(lhs.ty)}` and `{type_name(rhs.ty)}`", "affine points are positions; only point + delta, point - delta, point - point, and delta + delta are defined", "subtract two points for a delta, or add a matching Delta to a point"))
                return None
            }
        }
        sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, diagnostics)
        return None
    }

    if left_dimension != None || right_dimension != None {
        if sema_expr_unit_needs_equal_dimensions(op) {
            if left_dimension != None && right_dimension != None && !sema_expr_unit_dimensions_equal(left_dimension, right_dimension) {
                sema_expr_unit_dimension_mismatch(op, left_dimension ?? Dimension{axes: [DimensionAxis]{}}, right_dimension ?? Dimension{axes: [DimensionAxis]{}}, span, diagnostics)
                return None
            }
            // A plain number has the Scalar dimension: `1meter < 1.0` compares
            // Length with Scalar.
            plain: if left_dimension == None -> lhs.ty else -> rhs.ty
            if (left_dimension == None) != (right_dimension == None) && (sema_expr_is_numeric(plain) || sema_expr_precise_name(plain) != None) {
                sema_expr_unit_dimension_mismatch(op, left_dimension ?? Dimension{axes: [DimensionAxis]{}}, right_dimension ?? Dimension{axes: [DimensionAxis]{}}, span, diagnostics)
                return None
            }
            if type_identity_equal(lhs.ty, rhs.ty) {
                result_ty := if op == BinOp.Compare -> Type.Named{name: "Ordering"} else -> if op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge -> Type.Bool else -> lhs.ty
                return Val(sema_tree_node(result_ty, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span))
            }
            sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, diagnostics)
            return None
        }
    }
    None
}

SemaIntegerRange: struct {
    lo: Int
    hi: Int
}

sema_expr_integer_range: fn(signed: Bool, bits: Int) -> SemaIntegerRange Never! {
    if bits <= 0 -> return SemaIntegerRange{lo: 0, hi: 0}
    if signed {
        limit: 1 << (bits - 1)
        return SemaIntegerRange{lo: -limit, hi: limit - 1}
    }
    limit: 1 << bits
    SemaIntegerRange{lo: 0, hi: limit - 1}
}

sema_expr_integer_fits: fn(value: Int, signed: Bool, bits: Int) -> Bool Never! {
    if bits <= 0 -> return false
    bounds: sema_expr_integer_range(signed, bits)
    value >= bounds.lo && value <= bounds.hi
}

// Rust `int_range_error`: an integer literal outside its fixed width. `U8`
// keeps its byte-framed reason; the other widths get the general one.
sema_expr_integer_range_error: fn(signed: Bool, bits: Int, span: Span, diagnostics: &[Diagnostic]) {
    bounds: sema_expr_integer_range(signed, bits)
    spelling: type_name(Type.IntN{signed: signed, bits: bits})
    article: if signed -> "an" else -> "a"
    why: if !signed && bits == 8 -> "binary APIs use one byte per value" else -> "{article} `{spelling}` is a fixed-width number — values outside its range can't fit"
    diagnostics.push(sema_error("E1003", span, "{article} `{spelling}` holds {bounds.lo}..{bounds.hi}", why, "use a number from {bounds.lo} through {bounds.hi}"))
}

// The token's i64 field is only a fast path. An integer literal's
// exact value comes from its preserved spelling (Rust
// `exact_integer_literal`); a spelling that is not an integer literal keeps
// the token value.
sema_expr_exact_integer_literal: fn(value: Int, raw: String?) -> Int Never! {
    text: raw ?? return value
    bytes: text.bytes()
    i := 0
    negative := false
    if bytes.len() > 0 && (Int.from_u8(bytes[0]) == 45 || Int.from_u8(bytes[0]) == 43) {
        negative = Int.from_u8(bytes[0]) == 45
        i = 1
    }
    radix := 10
    if i + 1 < bytes.len() && Int.from_u8(bytes[i]) == 48 {
        marker: Int.from_u8(bytes[i + 1])
        if marker == 120 || marker == 88 -> radix = 16
        if marker == 111 || marker == 79 -> radix = 8
        if marker == 98 || marker == 66 -> radix = 2
        if radix != 10 -> i += 2
    }
    exact := 0
    digits := 0
    loop i < bytes.len() {
        code: Int.from_u8(bytes[i])
        i += 1
        if code == 95 -> next
        digit: if {
            code >= 48 && code <= 57 -> code - 48
            code >= 97 && code <= 122 -> code - 87
            code >= 65 && code <= 90 -> code - 55
            else -> radix
        }
        if digit >= radix -> return value
        exact = exact * radix + digit
        digits += 1
    }
    if digits == 0 -> return value
    if negative -> -exact else -> exact
}

// Only a written negative numeral selects the Fraction carrier;
// a dynamic exponent (including unary minus on a name) remains Int.
sema_expr_written_negative_integer: fn(value: Expr) -> Bool Never! {
    if value == {
        .Paren(inner, _, _) -> sema_expr_written_negative_integer(inner)
        .Int(integer, _, _, raw, _) -> sema_expr_exact_integer_literal(integer, raw) < 0
        .Unary(operator, inner, _, _) -> {
            if operator != UnOp.Neg -> return false
            if inner == {
                .Int(integer, _, _, raw, _) -> sema_expr_exact_integer_literal(integer, raw) > 0
                else -> false
            }
        }
        else -> false
    }
}

// `base.pow(-n)` with a written negative exponent is the exact Fraction
// `1 / base.pow(n)`; ir_precise_division stops a zero base at the line.
sema_expr_negative_int_power: fn(base: TExpr, exponent: TExpr, line: Int, span: Span) -> TExpr Never! {
    positive: sema_tree_node(Type.Int, TExprKind.Unary{op: TUnaryOp.Neg, operand: exponent}, exponent.span)
    power: sema_tree_node(Type.Int, TExprKind.Binary{op: TBinaryOp.Pow, overflow: true, line: line, lhs: base, rhs: positive}, span)
    one: sema_tree_node(Type.Int, TExprKind.IntLit{value: 1, width: None}, span)
    sema_tree_node(Type.Named{name: "Fraction"}, TExprKind.PreciseBuiltin{type_name: "Fraction", function: "quotient", args: [TExpr]{one, power}}, span)
}

// Every synthesized unbounded literal shares the native i64/BigInt boundary;
// Jet's exact Int carrier is wider than Rust's CtValue.Int and its lowered IntLit.
sema_expr_unbounded_integer_literal: fn(value: Int, span: Span) -> TExpr Never! {
    kind: if value >= -9223372036854775807 - 1 && value <= 9223372036854775807 -> TExprKind.IntLit{value: value, width: None} else -> TExprKind.CtLit{value: TComptimeValue.BigInt{decimal: "{value}"}}
    TExpr{ty: Type.Int, kind: kind, span: span}
}

// A literal outside the i64 range keeps its exact value as a
// BigInt constant (the Rust reference lowering's `CtLit(BigInt)`); a fixed-width one crosses the
// checked Int-to-fixed conversion, as in Rust's lowering.
sema_expr_int_literal_tree: fn(value: Int, ty: Type, width: TIntegerWidth?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TExpr? {
    if value >= -9223372036854775807 - 1 && value <= 9223372036854775807 {
        return Val(TExpr{ty: ty, kind: TExprKind.IntLit{value: value, width: width}, span: span})
    }
    big: sema_expr_unbounded_integer_literal(value, span)
    if width == None -> return Val(big)
    line: sema_source_line_at(environment.source_segments, span) ?? 0
    sema_expr_numeric_conversion(big, ty, span, line)
}

// A bare numeral in an `Int(lo..hi)` slot is a value of that
// range, proved at compile time (E0135 outside it). The slot's bounds, or
// None when it is not an integer range.
sema_expr_literal_range: fn(expected: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaIntegerRange? {
    resolved: sema_expr_expected_type(expected, environment, program)
    if resolved == .InlineRange(base, lo, hi) {
        if base == Type.Int -> return Val(SemaIntegerRange{lo: lo, hi: hi})
    }
    None
}

sema_expr_integer_literal: fn(value: Int, width: IntegerWidth?, expected: Type?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    // D-INTLIT-WIDTH1: a bare numeral in a Float/F32 slot widens there,
    // checked exactly at compile time (E1003 past 2^53 / 2^24).
    if width == None && expected != None {
        contextual_expected: expected
        if contextual_expected == Type.Float || contextual_expected == Type.Float32 {
            literal: sema_expr_int_literal_tree(value, Type.Int, None, span, environment, program) ?? return None
            return sema_expr_numeric_literal_conversion(literal, contextual_expected, span, sema_source_line_at(environment.source_segments, span) ?? 0, diagnostics)
        }
    }
    ty := Type.Int
    tree_width := TIntegerWidth?{None}
    if {
        width != None -> {
            literal_width: width
            ty = Type.IntN{signed: literal_width.signed, bits: literal_width.bits}
            tree_width = Val(TIntegerWidth{signed: literal_width.signed, bits: literal_width.bits})
        }
        expected != None -> {
            contextual: expected
            if contextual == .IntN(signed, bits) {
                ty = contextual
                tree_width = Val(TIntegerWidth{signed: signed, bits: bits})
            }
            if sema_expr_literal_range(contextual, environment, program) == .Val(range) {
                if value < range.lo || value > range.hi {
                    diagnostics.push(sema_inline_range_out_of_bounds(value, range.lo, range.hi, span))
                    return None
                }
                ty = Type.InlineRange{base: Type.Int, lo: range.lo, hi: range.hi}
            }
        }
        else -> {}
    }
    if ty == {
        .IntN(signed, bits) -> {
            if !sema_expr_integer_fits(value, signed, bits) {
                sema_expr_integer_range_error(signed, bits, span, diagnostics)
                return None
            }
        }
        else -> {}
    }
    bounded: sema_expr_int_literal_tree(value, ty, tree_width, span, environment, program) ?? return None
    sema_expr_expected(bounded, expected, environment, program, diagnostics)
}

// `literal_span` is the written numeral's own span, where a range error points.
sema_expr_negative_integer: fn(value: Int, width: IntegerWidth?, expected: Type?, span: Span, literal_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    // D-INTLIT-WIDTH1: as sema_expr_integer_literal, `-7` in a Float slot.
    if width == None && expected != None {
        contextual_expected: expected
        if contextual_expected == Type.Float || contextual_expected == Type.Float32 {
            literal: sema_expr_int_literal_tree(-value, Type.Int, None, span, environment, program) ?? return None
            return sema_expr_numeric_literal_conversion(literal, contextual_expected, span, sema_source_line_at(environment.source_segments, span) ?? 0, diagnostics)
        }
    }
    ty := Type.Int
    tree_width := TIntegerWidth?{None}
    if {
        width != None -> {
            literal_width: width
            ty = Type.IntN{signed: literal_width.signed, bits: literal_width.bits}
            tree_width = Val(TIntegerWidth{signed: literal_width.signed, bits: literal_width.bits})
        }
        expected != None -> {
            contextual: expected
            if contextual == .IntN(signed, bits) {
                ty = contextual
                tree_width = Val(TIntegerWidth{signed: signed, bits: bits})
            }
            if sema_expr_literal_range(contextual, environment, program) == .Val(range) {
                if -value < range.lo || -value > range.hi {
                    diagnostics.push(sema_inline_range_out_of_bounds(-value, range.lo, range.hi, literal_span))
                    return None
                }
                ty = Type.InlineRange{base: Type.Int, lo: range.lo, hi: range.hi}
            }
        }
        else -> {}
    }
    negated := -value
    if ty == {
        .IntN(signed, bits) -> {
            if !sema_expr_integer_fits(negated, signed, bits) {
                sema_expr_integer_range_error(signed, bits, literal_span, diagnostics)
                return None
            }
            // The width's minimum has no positive operand to negate (`I8{-128}`):
            // it is one exact literal.
            if !sema_expr_integer_fits(value, signed, bits) {
                minimum: sema_expr_int_literal_tree(negated, ty, tree_width, span, environment, program) ?? return None
                return sema_expr_expected(minimum, expected, environment, program, diagnostics)
            }
        }
        else -> {}
    }
    operand: sema_expr_int_literal_tree(value, ty, tree_width, span, environment, program) ?? return None
    bounded: TExpr{ty: ty, kind: TExprKind.Unary{op: TUnaryOp.Neg, operand: operand}, span: span}
    sema_expr_expected(bounded, expected, environment, program, diagnostics)
}

// Interpolation check: each numeric or text selector names the one value family
// its Core/Text/Fmt.jet formatter takes, and any other value is E0112 at the
// interpolated value. Every integer width meets the integer formatters as an
// exact `Int`, and padding takes a scalar's Display text.
sema_expr_check_format_selector: fn(checked: TExpr, format: StrFormat, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Bool {
    ty: checked.ty
    shown: sema_type_show(ty)
    integer: sema_expr_is_integer(ty)
    if format == {
        .Fixed(_) -> {
            if ty == Type.Float || integer -> return true
            diagnostics.push(sema_error("E0112", checked.span, "{shown} can't use `:Fixed(n)`", "fixed interpolation uses `core.text.fmt.decimal`, which formats `Float` or integer values", "pass a `Float` or an integer, or use bare interpolation for this value"))
        }
        .Grouped(_) -> {
            if ty == Type.Float || integer -> return true
            diagnostics.push(sema_error("E0112", checked.span, "{shown} can't use `:Grouped(n)`", "grouped interpolation uses `core.text.fmt.grouped`, which formats `Float` or integer values", "pass a `Float` or an integer, or use bare interpolation for this value"))
        }
        .Hex(_) -> {
            if integer -> return true
            diagnostics.push(sema_error("E0112", checked.span, "{shown} can't use `:Hex(n)`", "hex interpolation uses `core.text.fmt.hex`, which formats integer values", "pass an integer, or use bare interpolation for this value"))
        }
        .Sci(_) -> {
            if ty == Type.Float -> return true
            diagnostics.push(sema_error("E0112", checked.span, "{shown} can't use `:Sci(n)`", "scientific interpolation formats Float values", "pass a `Float`, or use bare interpolation for this value"))
        }
        .Percent(_) -> {
            if ty == Type.Float -> return true
            diagnostics.push(sema_error("E0112", checked.span, "{shown} can't use `:Percent(n)`", "percent interpolation formats Float values", "pass a `Float`, or use bare interpolation for this value"))
        }
        .Bin -> {
            if integer -> return true
            diagnostics.push(sema_error("E0112", checked.span, "{shown} can't use `:Bin`", "binary interpolation formats integer values", "pass an integer, or use bare interpolation for this value"))
        }
        .Oct -> {
            if integer -> return true
            diagnostics.push(sema_error("E0112", checked.span, "{shown} can't use `:Oct`", "octal interpolation formats integer values", "pass an integer, or use bare interpolation for this value"))
        }
        .Pad(_, _) | .PadLeft(_, _) -> {
            if ty == Type.String || ty == Type.Float || integer -> return true
            selector: if format == {
                .Pad(_, _) -> "Pad"
                else -> "PadLeft"
            }
            diagnostics.push(sema_error("E0112", checked.span, "{shown} can't use `:{selector}(n)`", "padding interpolation formats String, integer, or Float values", "pass a `String`, an integer, or a `Float`, or use bare interpolation for this value"))
        }
        .Unit(_) -> {
            if sema_expr_scalable_unit_type(ty, environment, program) -> return true
            diagnostics.push(sema_error("E0112", checked.span, "{shown} can't use `:Unit(…)`", "unit formatting needs a quantity or a `#UnitFamily` value", "use bare interpolation, or pass a value that has a unit"))
        }
        .Display | .Debug | .Pretty -> return true
    }
    false
}

sema_expr_call_callee: fn(program: SemaProgramTables, value: TExpr) -> SymbolID? {
    if value.kind == {
        .Call(callee, _, _) -> return Val(SymbolID{key: sema_program_decl_key(program, callee)})
        .MethodCall(_, method, _, _) -> return Val(method.symbol)
        // A call behind its generated argument pins keeps its callee.
        .InlineBlock(body) -> {
            if body.len() == 0 -> return None
            loop index in 0..<body.len() - 1 {
                if body[index] == .Let(local, _, _, _, _, _) && local.generated -> next
                if body[index] == .Contract(_) -> next
                return None
            }
            if body[body.len() - 1] == .ExprStmt(tail, _) -> return sema_expr_call_callee(program, tail)
            return None
        }
        else -> None
    }
}
SemaExprComptimeTarget: struct {
    module_identity: String
    declaration: Func
    path: String
    kind: String
}

sema_expr_comptime_method_target: fn(methods: [Func], owner_name: String, module_identity: String, symbol: SymbolID) -> SemaExprComptimeTarget? {
    owner := symbol_id(SymbolKind.Type, module_identity, "", owner_name)
    loop method in methods {
        candidate: symbol_id(SymbolKind.Function, module_identity, owner.key, method.name)
        if candidate.key == symbol.key -> return Val(SemaExprComptimeTarget{module_identity: module_identity, declaration: method, path: "{owner_name}.{method.name}", kind: "method"})
    }
    None
}

sema_expr_comptime_local_method_target: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, symbol: SymbolID) -> SemaExprComptimeTarget? {
    loop row_index in 0..<environment.declarations.len() {
        target: if environment.declarations[row_index].item == {
            .Struct(value) -> sema_expr_comptime_method_target(value.methods, value.name, environment.module_identity, symbol)
            .Enum(value) -> sema_expr_comptime_method_target(value.methods, value.name, environment.module_identity, symbol)
            else -> None
        }
        if target != None -> return target
    }
    None
}

sema_expr_comptime_target: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, symbol: SymbolID) -> SemaExprComptimeTarget? {
    if program.registration_graph == .Val(graph) {
        // One keyed callable lookup (Rust `funcs.get`): top-level functions
        // and nominal methods are compile-time targets.
        row: sema_registration_callable_row(graph, symbol.key) ?? return None
        if row == {
            .Function(module_index, index) -> return Val(SemaExprComptimeTarget{module_identity: graph.modules[module_index].module_identity, declaration: graph.modules[module_index].functions[index].declaration, path: graph.modules[module_index].functions[index].symbol.name, kind: "function"})
            .NominalMethod(module_index, owner, index) -> return Val(SemaExprComptimeTarget{module_identity: graph.modules[module_index].module_identity, declaration: graph.modules[module_index].nominals[owner].methods[index].declaration, path: "{graph.modules[module_index].nominals[owner].symbol.name}.{graph.modules[module_index].nominals[owner].methods[index].symbol.name}", kind: "method"})
            else -> return None
        }
    }
    declaration: sema_scope_resolve_declaration(environment, program, symbol) ?? {
        target: sema_expr_comptime_local_method_target(environment, program, symbol) ?? return None
        return Val(target)
    }
    if declaration == {
        .Func(func) -> {
            module_identity := scopes.frames[0].owner
            loop binding in scopes.bindings {
                if binding.symbol.id.key == symbol.key -> module_identity = binding.symbol.module_name
            }
            return Val(SemaExprComptimeTarget{module_identity: module_identity, declaration: func, path: func.name, kind: "function"})
        }
        else -> {}
    }
    None
}

// Whether sema_expr_comptime_target's target for `symbol` is declared
// `comptime`, read in place from the graph rows.
sema_expr_comptime_target_declared: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, symbol: SymbolID) -> Bool {
    if program.registration_graph == .Val(graph) {
        row: sema_registration_callable_row(graph, symbol.key) ?? return false
        return if row == {
            .Function(module_index, index) -> graph.modules[module_index].functions[index].declaration.is_comptime
            .NominalMethod(module_index, owner, index) -> graph.modules[module_index].nominals[owner].methods[index].declaration.is_comptime
            else -> false
        }
    }
    target: sema_expr_comptime_target(environment, program, scopes, symbol) ?? return false
    target.declaration.is_comptime
}

sema_expr_comptime_value: fn(value: TExpr, context: SemaCheckContext) -> TComptimeValue? {
    if value.kind == {
        .IntLit(number, _) -> {
            return Val(TComptimeValue.Int{value: number})
        }
        // A scalar literal is a flat row (sema_node).
        .Flat(index) -> {
            if context.arena.tree.nodes[index - context.arena.tree.node_base].kind == {
                .FloatLit(number) -> return Val(TComptimeValue.Float{value: number, bits: if value.ty == Type.Float32 -> 32 else -> 64})
                .BoolLit(boolean) -> return Val(TComptimeValue.Bool{value: boolean})
                .CharLit(character) -> return Val(TComptimeValue.Char{value: character})
                .Unit -> return Val(TComptimeValue.Unit)
                else -> return None
            }
        }
        // copy: `comptime_value` is a payload of read parameter `value`, which keeps the original; the Val carrier owns this one
        .CtLit(comptime_value) -> return Val(comptime_value.copy())
        .StrLit(parts) -> {
            text := ""
            loop part in parts {
                if part == {
                    .Literal(literal) -> text = "{text}{literal}"
                    else -> return None
                }
            }
            return Val(TComptimeValue.String{value: text})
        }
        .List(values, _) -> {
            output := [TComptimeValue]{}
            loop element in values {
                output.push(sema_expr_comptime_value(element, context) ?? return None)
            }
            return Val(TComptimeValue.List{values: output})
        }
        .ListLit(values) -> {
            output := [TComptimeValue]{}
            loop element in values {
                output.push(sema_expr_comptime_value(element, context) ?? return None)
            }
            return Val(TComptimeValue.List{values: output})
        }
        .Present(inner) | .Ok(inner) -> {
            converted: sema_expr_comptime_value(inner, context) ?? return None
            return Val(TComptimeValue.Present{value: converted})
        }
        else -> None
    }
}

sema_expr_comptime_args: fn(args: [TCallArg], receiver: TExpr?, context: SemaCheckContext) -> [TComptimeValue]? {
    output := [TComptimeValue]{}
    if receiver != None {
        receiver_value: receiver
        output.push(sema_expr_comptime_value(receiver_value, context) ?? return None)
    }
    loop arg in args -> output.push(sema_expr_comptime_value(arg.value, context) ?? return None)
    Val(output)
}

sema_expr_comptime_call_args: fn(value: TExpr, context: SemaCheckContext) -> [TComptimeValue]? {
    if value.kind == {
        .Call(_, _, args) -> return sema_expr_comptime_args(args, None, context)
        .MethodCall(receiver, _, _, args) -> return sema_expr_comptime_args(args, Val(receiver), context)
        else -> None
    }
}

sema_expr_record_call_fact: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, span: Span, checked: SemaCallChecked, diagnostics: &[Diagnostic]) -> Bool {
    wall := sema_effect_check_transaction_wall(environment, program, scopes, checked.facts.effect_bound, sema_effect_call_api(program, checked.value), span, diagnostics)
    allowed: wall ?? return false
    if !allowed -> return false
    callee := sema_expr_call_callee(program, checked.value)
    foreign_effect_root: sema_expr_call_foreign_effect_root(program, callee)
    // Rust `check_foreign_transaction_call`: a foreign call is a boundary of
    // an authored `#Transact` block unless its binding declares `#Undo`.
    if scopes.transaction_wall_depth > 0 && sema_expr_call_foreign_without_undo(program, callee) {
        diagnostics.push(sema_effect_transaction_wall_diagnostic(sema_effect_call_api(program, checked.value), "FFI", span))
        return false
    }
    context.call_facts.push(SemaCallSiteFact{
        span: span,
        caller_key: sema_scope_function_owner_key(scopes),
        callee: callee,
        facts: checked.facts,
        discarded: false,
        foreign_effect_root: foreign_effect_root,
        unsafe_foreign_name: sema_expr_call_unsafe_foreign_name(program, callee, foreign_effect_root),
        foreign_capability: sema_expr_call_foreign_capability(program, callee),
        replacement_hidden: sema_expr_call_replacement_hidden(program, scopes, callee, span),
    })
    // Demand: a codec call requires the generated codec it reaches, and a
    // call of a demand-checked derived method requires its body.
    sema_codec_demand_call(program, callee, checked.value, checked.facts.return_type)
    sema_derive_demand_call(program, callee)
    symbol: callee ?? return true
    // Every early return here is the same `true`, and the target lookup is
    // pure, so the cheap tests go first and only a `comptime` target builds
    // its row (whose declaration copy is the callee's whole body).
    if scopes.comptime_execution_depth > 0 -> return true
    if !sema_expr_comptime_target_declared(environment, program, scopes, symbol) -> return true
    target: sema_expr_comptime_target(environment, program, scopes, symbol) ?? return true
    args: sema_expr_comptime_call_args(checked.value, context) ?? {
        diagnostics.push(sema_error("E0956", span, "compile-time call `{target.path}` needs compile-time value arguments", "the deferred IR evaluator receives only canonical TComptimeValue arguments", "pass supported compile-time values to this call"))
        return false
    }
    context.comptime_requests.push(SemaComptimeRequest{callee_key: symbol.key, module_identity: target.module_identity, args: args, span: span, checked_text: None})
    true
}

// An extern callee (`#FFI(<lang>)` body or foreign row) carries its one foreign
// effect root; a Jet callee has none.
sema_expr_call_foreign_effect_root: fn(program: SemaProgramTables, callee: SymbolID?) -> String? {
    symbol: callee ?? return None
    if program.registration_graph == .Val(graph) {
        abi: sema_registration_callable_abi(graph, symbol) ?? return None
        if abi.is_extern -> return abi.foreign_effect_root
    }
    None
}

// Whether `callee` is an extern body (`#FFI(<lang>)` function or foreign
// row) whose binding declares no `#Undo(inverse)`.
sema_expr_call_foreign_without_undo: fn(program: SemaProgramTables, callee: SymbolID?) -> Bool {
    symbol: callee ?? return false
    if program.registration_graph == .Val(graph) {
        row: sema_registration_callable_row(graph, symbol.key) ?? return false
        if row == {
            .Function(module_index, index) -> return graph.modules[module_index].functions[index].abi.is_extern && graph.modules[module_index].functions[index].declaration.undo == None
            .Foreign(module_index, index) -> return graph.modules[module_index].foreign_functions[index].declaration.undo == None
            else -> return false
        }
    }
    false
}

// Whether renaming this call to its declared callee's `#Deprecated(use:)`
// replacement would fail to call it: at the call, the replacement's name
// resolves to a local or parameter, or to nothing (a function of that name,
// or an import of it, is the rename).
sema_expr_call_replacement_hidden: fn(program: SemaProgramTables, scopes: SemaScopeTable, callee: SymbolID?, span: Span) -> Bool {
    symbol: callee ?? return false
    if program.registration_graph == .Val(graph) {
        row: sema_registration_callable_row(graph, symbol.key) ?? return false
        if row == .Function(module_index, index) {
            if graph.modules[module_index].functions[index].declaration.markers.len() == 0 -> return false
            payload: sema_lifecycle_marker(graph.modules[module_index].functions[index].declaration.markers, "") ?? return false
            parts: payload.replacement.split(".").to_list()
            leaf: parts[parts.len() - 1].trim()
            binding: sema_scope_resolve_index_at(scopes, leaf, span) ?? return true
            kind: scopes.bindings[binding].symbol.kind
            return kind == SymbolKind.Local || kind == SymbolKind.Parameter
        }
    }
    false
}

// The name of an `#Unsafe` inline foreign callee (`#[Unsafe("…"), FFI(c)]`),
// whose every call needs an audited region (E3103); None for any other
// callee.
sema_expr_call_unsafe_foreign_name: fn(program: SemaProgramTables, callee: SymbolID?, foreign_effect_root: String?) -> String? {
    if foreign_effect_root == None -> return None
    symbol: callee ?? return None
    if program.registration_graph == .Val(graph) {
        declaration: sema_registration_callable_declaration(graph, symbol) ?? return None
        if declaration.inline_foreign != None && declaration.is_unsafe -> return Val(declaration.name)
    }
    None
}

// The raw `extern rust` callee whose parameter takes a capability, with the
// first such sigil: `&` lets the foreign side write Jet storage and `&&`
// gives it away, so the call needs an audited region (E0702). A generated
// binding is callable directly; None for any other callee.
sema_expr_call_foreign_capability: fn(program: SemaProgramTables, callee: SymbolID?) -> SemaForeignCapability? {
    symbol: callee ?? return None
    if program.registration_graph == .Val(graph) {
        row: sema_registration_callable_row(graph, symbol.key) ?? return None
        if row == .Foreign(module_index, index) {
            if graph.modules[module_index].foreign_functions[index].owner != SemaRegistrationForeignOwner.ExternRust || graph.modules[module_index].foreign_functions[index].declaration.generated -> return None
            loop parameter in graph.modules[module_index].foreign_functions[index].declaration.params {
                sigil: access_sigil(parameter.convention)
                if sigil != "" -> return Val(SemaForeignCapability{name: graph.modules[module_index].foreign_functions[index].declaration.name.copy(), sigil: sigil})
            }
        }
    }
    None
}

sema_expr_type_base_name: fn(ty: Type) -> String? {
    if ty == {
        .Named(name) -> return Val(name)
        .Apply(name, _) -> return Val(name)
        else -> None
    }
}

// The method candidates of `method` on `receiver_type` as module
// `caller_module` sees them; generic parameters are `environment`'s.
sema_expr_registration_method_candidates: fn(graph: SemaRegistrationGraph, caller_module: String, receiver_type: Type, method: String, owner_type_args: [Type], type_args: [Type], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> [SemaCallMethodCandidate] Never! {
    candidates := [SemaCallMethodCandidate]{}
    caller_package := ""
    if sema_registration_module_index(graph, caller_module) == .Val(caller_index) -> caller_package = graph.modules[caller_index].package_identity
    trait_candidates := sema_call_trait_method_candidates(graph, receiver_type, method, type_args, caller_module, caller_package, environment.generic_params, span, diagnostics)
    if trait_candidates.len() > 0 -> return trait_candidates
    // Fact tags remain on the checked value, not on declaration lookup.
    lookup_type: sema_expr_unwrap_tag(receiver_type)
    receiver_name: sema_expr_type_base_name(lookup_type) ?? return candidates
    // Native carrier methods live on registered impls, never fake nominals;
    // only the Core source modules indexed as owning this name's impls.
    if graph.source_impl_owner_modules.get(receiver_name) == .Val(owner_modules) {
        loop owner_index in owner_modules {
            loop implementation_index in 0..<graph.modules[owner_index].impls.len() {
                if graph.modules[owner_index].impls[implementation_index].target_type_name != receiver_name -> next
                loop function_index in 0..<graph.modules[owner_index].impls[implementation_index].methods.len() {
                    // A static method (no `self`) is named through the type, never a value.
                    if graph.modules[owner_index].impls[implementation_index].methods[function_index].symbol.name != method || graph.modules[owner_index].impls[implementation_index].methods[function_index].parameters.len() == 0 || graph.modules[owner_index].impls[implementation_index].methods[function_index].parameters[0].symbol.name != "self" -> next
                    method_ref: TMethodRef{symbol: graph.modules[owner_index].impls[implementation_index].methods[function_index].symbol.id, name: graph.modules[owner_index].impls[implementation_index].methods[function_index].symbol.name, mangled: true, trait_owner: None, operator_identity: None}
                    // The impl's signature names types as its owning module
                    // sees them (Rust `owner_type_for_reader`).
                    generics: loop param_index in 0..<graph.modules[owner_index].impls[implementation_index].methods[function_index].generic_params.len() -> TGenericParam{name: graph.modules[owner_index].impls[implementation_index].methods[function_index].generic_params[param_index].name, bounds: [SymbolID]{}}
                    owner_signature: sema_type_resolve_declared_with_generics(graph, graph.modules[owner_index].impls[implementation_index].methods[function_index].signature, graph.modules[owner_index].module_identity, generics)
                    candidate: sema_call_method_candidate_from_registration(owner_signature, graph.modules[owner_index].impls[implementation_index].methods[function_index].generic_params, program.registration_graph, caller_module, caller_package, environment.generic_params, Val(lookup_type), graph.modules[owner_index].impls[implementation_index].methods[function_index].parameters[0].convention, 1, method_ref, type_args, span, diagnostics) ?? next
                    candidates.push(candidate)
                }
            }
        }
    }
    if candidates.len() > 0 -> return candidates
    // The rows are keyed by the declared spelling (`Rect`); a resolved
    // receiver carries its canonical identity (`module::Rect`), so the row key
    // is the canonical leaf, and such a receiver is inferred against the
    // declaration resolved in its own module (as operator lookup does).
    receiver_canonical: receiver_name.contains("::")
    // The nominal the caller's scope names wins: a user type shadows a
    // same-named type of another module (the prelude's `Severity`), so the
    // other rows never offer their methods to this receiver.
    caller_row: if sema_registration_module_index(graph, caller_module) == .Val(index) -> index else -> -1
    scoped_row: sema_type_resolve_nominal_row_at(graph, lookup_type, caller_row)
    found_owner := false
    loop nominal_row in sema_registration_nominal_rows_named(graph, sema_expr_operator_row_name(receiver_name)) {
        owner_index: nominal_row.module_index
        nominal: graph.modules[owner_index].nominals[nominal_row.row]
        if scoped_row == .Val(scoped) && graph.modules[scoped.module_index].nominals[scoped.row].kind != SemaRegistrationNominalKind.TypeAlias && (scoped.module_index != owner_index || scoped.row != nominal_row.row) -> next
        found_owner = true
        inference_ty := nominal.ty
        if receiver_canonical -> inference_ty = sema_type_resolve_declared(graph, nominal.ty, graph.modules[owner_index].module_identity)
        // A same-named nominal that cannot own the receiver is skipped, not
        // reported (see sema_expr_operator_nominal_candidates).
        probe_diagnostics := [Diagnostic]{}
        owner_inference: sema_infer_registered_nominal(nominal, inference_ty, program.registration_graph, caller_module, caller_package, environment.generic_params, lookup_type, owner_type_args, None, span, probe_diagnostics) ?? next
        if !owner_inference.complete || !owner_inference.compatible -> next
        // A canonical receiver meets its owner by identity (Rust
        // `struct_owner_module` names the owner; the receiver is never
        // re-read in the caller's module): the candidate's receiver is the
        // declaration's type as its own module names it, so a bare leaf the
        // caller cannot see (`core.crypto`'s `Digest256`) still matches.
        owner_declared := nominal.ty
        if receiver_canonical {
            owner_generics: loop param in nominal.generic_params -> TGenericParam{name: param.name, bounds: [SymbolID]{}}
            owner_declared = sema_type_resolve_declared_with_generics(graph, nominal.ty, graph.modules[owner_index].module_identity, owner_generics)
        }
        owner_type := sema_inference_substitute_type_bindings(owner_declared, owner_inference.substitutions)
        written_before: candidates.len()
        loop function in nominal.methods {
            if function.symbol.name != method || function.parameters.len() == 0 || function.parameters[0].symbol.name != "self" -> next
            // Resolve the declared signature in the owner's module, with the
            // owner's and the method's type parameters kept, before the
            // receiver's arguments are substituted (Rust
            // `owner_type_for_reader`): `clock.__observer()` returns
            // `core.time`'s own `__ClockObserver` in every caller.
            generics := [TGenericParam]{}
            loop param in nominal.generic_params -> generics.push(TGenericParam{name: param.name, bounds: [SymbolID]{}})
            loop param in function.generic_params -> generics.push(TGenericParam{name: param.name, bounds: [SymbolID]{}})
            owner_signature: sema_type_resolve_declared_with_generics(graph, function.signature, graph.modules[owner_index].module_identity, generics)
            method_signature: sema_inference_substitute_type_bindings(owner_signature, owner_inference.substitutions)
            method_ref := TMethodRef{symbol: function.symbol.id, name: function.symbol.name, mangled: true, trait_owner: None, operator_identity: None}
            candidate: sema_call_method_candidate_from_registration(method_signature, function.generic_params, program.registration_graph, caller_module, caller_package, environment.generic_params, Val(owner_type), function.parameters[0].convention, 1, method_ref, type_args, span, diagnostics) ?? next
            candidates.push(candidate)
        }
        // S62: a trait default body or a `using` delegation.
        if candidates.len() == written_before {
            loop candidate in sema_call_implemented_trait_method_candidates(graph, nominal, owner_type, method, type_args, caller_module, caller_package, environment.generic_params, span, diagnostics) -> candidates.push(candidate)
        }
    }
    if !found_owner -> return sema_call_local_method_candidates(environment, program, method, owner_type_args, type_args)
    candidates
}

// Resolve the method owner's home through the declaration index, without
// changing the annotation's public spelling or inventing a Core alias table.
sema_expr_receiver_nominal_identity: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, receiver_type: Type) -> String Never! {
    base_name: sema_expr_type_base_name(receiver_type) ?? return type_name(receiver_type)
    if program.registration_graph == .Val(graph) {
    if sema_type_resolve_nominal_row_at(graph, receiver_type, sema_scope_caller_row(environment, graph)) == .Val(row) {
        nominal: graph.modules[row.module_index].nominals[row.row]
        return "{nominal.symbol.module_name}::{nominal.symbol.name}"
    }
    found := String?{None}
    loop row in sema_registration_nominal_rows_named(graph, sema_expr_operator_row_name(base_name)) {
        nominal: graph.modules[row.module_index].nominals[row.row]
        if nominal.kind == SemaRegistrationNominalKind.TypeAlias -> next
        identity: "{nominal.symbol.module_name}::{nominal.symbol.name}"
        if base_name.contains("::") && base_name != identity -> next
        if found != None -> return base_name
        found = Val(identity)
    }
    return found ?? base_name
    }
    base_name
}

// True only when a declared nominal method collides with a builtin handle
// method of the same owner leaf and name (Core's `URL`/`MIME`, or a user type
// spelled like a handle carrier); every other declared method keeps the
// special routes, as in the Rust reference lowering's handle_method_op gate.
sema_expr_declares_nominal_method: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, receiver_type: Type, method: String, needs_receiver: Bool) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
    // A resolved receiver carries its canonical identity (`module::URL`).
    base_name: sema_expr_type_base_name(sema_expr_unwrap_tag(receiver_type)) ?? return false
    if graph.source_impl_owner_modules.get(base_name) == .Val(owner_modules) {
        loop owner_index in owner_modules {
            loop implementation_index in 0..<graph.modules[owner_index].impls.len() {
                if graph.modules[owner_index].impls[implementation_index].target_type_name != base_name -> next
                loop function_index in 0..<graph.modules[owner_index].impls[implementation_index].methods.len() {
                    if graph.modules[owner_index].impls[implementation_index].methods[function_index].symbol.name == method && (!needs_receiver || graph.modules[owner_index].impls[implementation_index].methods[function_index].parameters.len() > 0) -> return true
                }
            }
        }
    }
    receiver_name: sema_expr_operator_row_name(base_name)
    caller: sema_scope_caller_row(environment, graph)
    source_declaration := sema_type_source_owns_nominal(graph, base_name, caller)
    if sema_type_resolve_nominal_row_at(graph, sema_expr_unwrap_tag(receiver_type), caller) == .Val(owner) {
        module_row: graph.modules[owner.module_index]
        if module_row.module_identity.starts_with("<corelib>/") {
            loop row in CORE_SOURCE_OWNED_ROWS {
                if row.module_name == module_row.module_name && row.alias == module_row.core_source_alias && module_row.source_file == "<corelib>/{row.path}" -> source_declaration = true
            }
        }
    }
    if !source_declaration && !sema_network_handle_known_method(receiver_name, method) -> return false
    loop nominal_row in sema_registration_nominal_rows_named(graph, receiver_name) {
        methods: graph.modules[nominal_row.module_index].nominals[nominal_row.row].methods
        loop method_index in 0..<methods.len() {
            function: methods[method_index]
            if function.symbol.name == method && (!needs_receiver || function.parameters.len() > 0) -> return true
        }
    }
    }
    false
}

// The receiver type's own method `method`, declared in its body, in an
// inherent `impl`, or in an impl of a trait other than the codec itself
// (`Encode`/`Decode`). A type's own `encode` keeps its own call instead of the
// Encode contract route.
sema_expr_declares_own_method: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, receiver_type: Type, method: String) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
    base_name: sema_expr_type_base_name(sema_expr_unwrap_tag(receiver_type)) ?? return false
    if graph.source_impl_owner_modules.get(base_name) == .Val(owner_modules) {
        loop owner_index in owner_modules {
            loop implementation in graph.modules[owner_index].impls {
                if implementation.target_type_name != base_name || sema_derive_is_codec_trait(implementation.trait_name ?? "") -> next
                loop function in implementation.methods {
                    if function.symbol.name == method && function.parameters.len() > 0 -> return true
                }
            }
        }
    }
    caller: sema_type_module_row(graph, environment.module_identity)
    owner: sema_type_resolve_nominal_row_at(graph, sema_expr_unwrap_tag(receiver_type), caller) ?? return false
    loop function in graph.modules[owner.module_index].nominals[owner.row].methods {
        if function.symbol.name == method && function.parameters.len() > 0 -> return true
    }
    }
    false
}

// Rust `funcs.get(name)`: some declared function (local or imported) has
// this name in any frame, even when a nearer binding shadows it.
sema_expr_declared_function_named: fn(scopes: SemaScopeTable, name: String) -> Bool Never! {
    slot: sema_scope_name_slot(scopes, name) ?? return false
    loop index in scopes.name_positions[slot] {
        if scopes.bindings[index].symbol.kind == SymbolKind.Function -> return true
    }
    false
}

// Rust `infer_call` ("Lexical value bindings win over file functions and
// imported calls"): the nearest binding of the name is a parameter or local
// whose type is a function, so the call reads that value even when a
// declared function of the same name is visible further out.
sema_expr_callable_local_index: fn(environment: SemaScopeEnvironment, scopes: SemaScopeTable, name: String) -> Int? {
    index: sema_scope_resolve_index(scopes, name) ?? return None
    if scopes.bindings[index].symbol.kind == SymbolKind.Function -> return None
    callable_ty: sema_scope_binding_type(environment, scopes, index) ?? return None
    if sema_call_type_is_function(callable_ty) -> Val(index) else -> None
}

sema_expr_check_direct_call: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    // `close(value)` is the ambient `Close` sugar ahead
    // of every declared function (Rust `check_call_inner`).
    if call.name == "close" -> return sema_call_check_ambient_close(call, environment, program, scopes, state, tail_store, context, diagnostics)
    // Teaching forms, `measurement` and `apply` precede name resolution.
    forms := sema_call_try_direct_forms(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if forms.handled -> return forms.value
    // A callable parameter or local wins over a same-named declared, Core or
    // ambient function.
    if sema_expr_callable_local_index(environment, scopes, call.name) != None {
        return sema_expr_check_indirect_call(Expr.Ident{name: call.name, span: call.name_span, id: AST_NODE_GENERATED}, call.args, sema_expr_local_call_span(call), expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    // A loaded declaration owns the call even when Core also imports the name.
    if sema_expr_declared_function_named(scopes, call.name) {
        return sema_expr_check_declared_direct_call(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    if sema_expression_zip_family_name(call.name) && sema_scope_resolve_index(scopes, call.name) == None {
        return sema_expression_zip_free_call(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    no_prelude := sema_marker_rules_no_prelude_call(call, environment, program, scopes, state, tail_store, context, diagnostics)
    if no_prelude -> return None
    core_direct := sema_call_try_core_direct_call(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if core_direct.handled -> return core_direct.value
    // The `consume` builtin, unless a user `consume` shadows it.
    if call.name == "consume" && sema_call_gate_is_unshadowed(call.name, scopes) -> return sema_single_use_check_consume(call, environment, program, scopes, state, tail_store, context, diagnostics).value
    special := sema_call_try_knowledge_builtin(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if special.handled -> return special.value
    ambient := sema_call_try_ambient_prelude(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if ambient.handled -> return ambient.value
    if sema_call_default_err_candidate(call, expected, scopes) {
        scopes.ownership_call_depth += 1
        checked_default := sema_call_check_default_err(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        scopes.ownership_call_depth -= 1
        value: checked_default ?? return None
        return Val(value)
    }
    sema_expr_check_declared_direct_call(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

// The span a call through a callable local is checked and published at: its
// name through its last argument.
sema_expr_local_call_span: fn(call: Call) -> Span Never! {
    value_end := call.name_span.end
    if call.args.len() > 0 -> value_end = expr_span(call.args[call.args.len() - 1].expr).end
    Span{start: call.name_span.start, end: value_end}
}

sema_expr_check_declared_direct_call: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    // `Float(n)`: a number type is built with braces, not called.
    if call.type_args.len() == 0 && call.args.len() == 1 && SEMA_NUMBER_TYPE_NAMES.contains(call.name) && sema_scope_resolve_index(scopes, call.name) == None {
        diagnostics.push(sema_error("E0102", call.name_span, "`{call.name}` is a number type, not a function", "Jet builds a value of a number type with braces; parentheses call a function", "write `{call.name}{{{sema_expr_number_type_argument_text(call.args[0].expr)}}}`"))
        return None
    }
    scopes.ownership_call_depth += 1
    target: sema_call_resolve_direct(call.name, call.type_args, environment, program, scopes, call.name_span, diagnostics) ?? {
        scopes.ownership_call_depth -= 1
        sema_expr_check_mismatched_type_arg_call(call, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    checked := sema_call_check_direct_target_owned(state, target, call, [SemaCallDefaultValue]{}, expected, environment, program, scopes, tail_store, context, diagnostics)
    scopes.ownership_call_depth -= 1
    value: checked ?? return None
    context.call_return_views.push(SemaCallReturnView{span: call.name_span, facts: value.return_view_facts})
    if !sema_expr_record_call_fact(environment, program, scopes, context, call.name_span, value, diagnostics) -> return None
    Val(value.value)
}

// The built-in number types `Name(value)` is refused for (Jet: `Name{value}`).
SEMA_NUMBER_TYPE_NAMES: comptime { [String]{"Int", "Float", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F32", "F64"} }

// The argument as the Fix spells it: a name or literal as written, any other
// expression elided.
sema_expr_number_type_argument_text: fn(expr: Expr) -> String Never! {
    if expr == {
        .Ident(name, _, _) -> name
        .Int(value, _, _, raw, _) -> raw ?? "{value}"
        .Float(value, _, _, raw, _) -> raw ?? "{value}"
        else -> "…"
    }
}

// then: after a type-argument count mismatch (E0119) the arguments are still
// checked, against the callee's declared parameter types with its type
// parameters unbound (E0112).
sema_expr_check_mismatched_type_arg_call: fn(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) {
    signature: sema_call_direct_type_arg_mismatch_signature(call.name, call.type_args, environment, program, scopes) ?? return
    params: sema_call_params_from_type(signature) ?? return
    loop (index, argument) in call.args {
        value: sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? next
        if index >= params.len() -> next
        required: params[index].ty ?? next
        if sema_call_type_assignable(required, value.ty, environment, program) == (Val(false)) {
            diagnostics.push(sema_error("E0112", expr_span(argument.expr), "`{call.name}` wants {sema_type_show(required)} for argument {index + 1}, but this is {sema_type_show(value.ty)}", "every argument must match its parameter's type", sema_type_fix_hint(required, value.ty)))
        }
    }
}

sema_expr_check_indirect_call: fn(callee: Expr, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    scopes.ownership_call_depth += 1
    checked := sema_call_check_value_owned(state, callee, args, span, [SemaCallDefaultValue]{}, expected, environment, program, scopes, tail_store, context, diagnostics)
    scopes.ownership_call_depth -= 1
    value: checked ?? return None
    context.call_return_views.push(SemaCallReturnView{span: span, facts: value.return_view_facts})
    if !sema_expr_record_call_fact(environment, program, scopes, context, span, value, diagnostics) -> return None
    Val(value.value)
}

sema_expr_unit_rounding_mode: fn(value: Expr) -> TUnitRoundingMode? {
    if value == {
        .EnumLit(type_name, variant, _, args, _, _, _) -> {
            if type_name != "" || args.len() != 0 -> return None
            if variant == "TowardZero" -> return Val(TUnitRoundingMode.TowardZero)
            if variant == "Floor" -> return Val(TUnitRoundingMode.Floor)
            if variant == "Ceiling" -> return Val(TUnitRoundingMode.Ceiling)
            if variant == "NearestEven" -> return Val(TUnitRoundingMode.NearestEven)
        }
        else -> {}
    }
    None
}

sema_expr_check_unit_conversion_source: fn(argument: Expr, method: String, rounded: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], rounded_allowed: &Bool) -> TExpr? {
    rounded_allowed = !rounded
    if rounded {
        gate := sema_call_method_gate(method) ?? SemaKnowledgeGate.RoundedConversion
        gate_scope := sema_call_enter_gate(scopes, gate)
        rounded_allowed = sema_scope_knowledge_gate_allows(scopes, SemaKnowledgePlane.Unit, SemaKnowledgeGate.RoundedConversion)
        scopes.ownership_call_depth += 1
        checked := sema_check_expression(argument, None, environment, program, scopes, state, tail_store, context, diagnostics)
        scopes.ownership_call_depth -= 1
        sema_call_leave_gate(scopes, gate_scope)
        return checked
    }
    scopes.ownership_call_depth += 1
    checked := sema_check_expression(argument, None, environment, program, scopes, state, tail_store, context, diagnostics)
    scopes.ownership_call_depth -= 1
    checked
}

// Checks `value` for its own type only, on the live scope table, context and
// ownership state: all three are rolled back afterwards (the ownership state
// through a fork, which the probe runs in as on a whole-state copy), so the
// probe leaves nothing behind except what it reports to `diagnostics`. This
// replaces whole-table and whole-state snapshots, which copied every module
// binding and every row the function had accumulated, per probe.
sema_probe_expression: fn(value: Expr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    scope_mark: sema_scope_mark(scopes)
    context_mark: sema_check_context_mark(context)
    fork: sema_ownership_fork(state)
    checked: sema_check_expression(value, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    sema_ownership_fork_rollback(state, fork)
    sema_ownership_fork_close(state, fork)
    sema_check_context_rollback(context, context_mark)
    sema_scope_rollback(scopes, scope_mark)
    checked
}

sema_expr_try_explicit_unit_method: fn(receiver: Expr, method: String, method_span: Span, args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    destination_name := ""
    if receiver == {
        .Ident(name, _, _) -> destination_name = name
        else -> return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if !method.starts_with("from_") -> return SemaMethodSpecialCheck{handled: false, value: None}
    destination_fact: sema_expr_unit_fact(Type.Named{name: destination_name}, environment, program) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    rounded := sema_call_method_gate(method) != None
    if {
        rounded -> {
            if args.len() != 3 -> return SemaMethodSpecialCheck{handled: false, value: None}
            _ := sema_expr_unit_rounding_mode(args[1].expr) ?? return SemaMethodSpecialCheck{handled: false, value: None}
            label: args[2].label ?? return SemaMethodSpecialCheck{handled: false, value: None}
            if label.name != "digits" -> return SemaMethodSpecialCheck{handled: false, value: None}
        }
        else -> {
            if args.len() != 1 -> return SemaMethodSpecialCheck{handled: false, value: None}
        }
    }

    rounding_mode := TUnitRoundingMode?{None}
    if rounded {
        rounding_mode = Val(sema_expr_unit_rounding_mode(args[1].expr) ?? return SemaMethodSpecialCheck{handled: false, value: None})
    }
    probe_scope_mark: sema_scope_mark(scopes)
    probe_context_mark: sema_check_context_mark(context)
    probe_fork: sema_ownership_fork(state)
    probe_diagnostics := [Diagnostic]{}
    // The probe shares the enclosing statement-tail store: the liveness
    // frames in `context` index it.
    probe_rounded_allowed := false
    probe_source := sema_expr_check_unit_conversion_source(args[0].expr, method, rounded, environment, program, scopes, state, tail_store, context, probe_diagnostics, probe_rounded_allowed)
    sema_ownership_fork_rollback(state, probe_fork)
    sema_ownership_fork_close(state, probe_fork)
    sema_check_context_rollback(context, probe_context_mark)
    sema_scope_rollback(scopes, probe_scope_mark)
    source_probe: probe_source ?? return SemaMethodSpecialCheck{handled: false, value: None}
    source_fact: sema_expr_unit_fact(source_probe.ty, environment, program) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    expected_method := sema_expr_unit_conversion_method(source_fact)
    if !rounded && method != expected_method -> return SemaMethodSpecialCheck{handled: false, value: None}
    rounded_method: "{expected_method}_rounded"
    if rounded && method != rounded_method -> return SemaMethodSpecialCheck{handled: false, value: None}
    measured_crossing := sema_expr_unit_is_measured(source_fact) || sema_expr_unit_is_measured(destination_fact)
    if rounded && !probe_rounded_allowed -> return SemaMethodSpecialCheck{handled: false, value: None}
    if !rounded && measured_crossing -> return SemaMethodSpecialCheck{handled: false, value: None}
    if source_fact.package != destination_fact.package || source_fact.family != destination_fact.family || source_fact.dimension != destination_fact.dimension || source_fact.kind != destination_fact.kind -> return SemaMethodSpecialCheck{handled: false, value: None}

    conversion_end := method_span.end
    if args.len() > 0 -> conversion_end = args[args.len() - 1].span.end
    conversion_span := Span{start: expr_source_start(receiver), end: conversion_end}

    rounded_allowed := false
    source_value := sema_expr_check_unit_conversion_source(args[0].expr, method, rounded, environment, program, scopes, state, tail_store, context, diagnostics, rounded_allowed) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if rounded && !rounded_allowed -> return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_expr_unit_conversion_is_finite(source_fact, destination_fact) {
        diagnostics.push(sema_error("E0127", conversion_span, "this unit conversion overflows its runtime representation", "the declared exact scale or offset is outside Float's finite range", "choose units with a finite conversion boundary"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    digits_value := TExpr?{None}
    if rounded {
        checked_digits := sema_check_expression(args[2].expr, Val(Type.Int), environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        digits_value = Val(checked_digits)
        if args[2].expr == {
            .Unary(operator, inner, _, _) -> {
                if operator == UnOp.Neg {
                    if inner == {
                        .Int(_, _, _, _, _) -> {
                            diagnostics.push(sema_error("E0127", expr_span(args[2].expr), "rounded unit conversion needs nonnegative digits", "digits counts destination decimal places", "write `digits: 0` or another nonnegative Int"))
                        }
                        else -> {}
                    }
                }
            }
            else -> {}
        }
    }
    rounding := TUnitRounding?{None}
    if rounded {
        mode: rounding_mode ?? return SemaMethodSpecialCheck{handled: true, value: None}
        digits: digits_value ?? return SemaMethodSpecialCheck{handled: true, value: None}
        rounding = Val(TUnitRounding{mode: mode, digits: digits})
    }
    scale: sema_expr_unit_ratio_div(source_fact.scale, destination_fact.scale) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    offset: sema_expr_unit_ratio_div(sema_expr_unit_ratio_sub(source_fact.offset, destination_fact.offset), destination_fact.scale) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    converted := if measured_crossing -> Type.Apply{name: "Measurement", args: [Type]{Type.Float}} else -> Type.Named{name: destination_name}
    result_ty := Type.Result{ok: converted, err: Type.String}
    relative_uncertainty := sema_expr_unit_relative_uncertainty(source_fact, destination_fact)
    line := sema_source_line_at(environment.source_segments, conversion_span) ?? 0
    scalar_ty: if measured_crossing -> Type.Result{ok: Type.Float, err: Type.String} else -> result_ty
    value := sema_tree_node(scalar_ty, TExprKind.UnitConvert{argument: source_value, scale: sema_expr_unit_ratio_text(scale), offset: sema_expr_unit_ratio_text(offset), rounding: rounding, fallible: true, relative_uncertainty: None, file: environment.source_file, line: line}, conversion_span)
    if measured_crossing {
        relative: sema_node(context, Type.Float, NodeKind.FloatLit{value: relative_uncertainty ?? 0.0}, conversion_span)
        value = sema_expression_measurement_source_call("__measurement_result", [TExpr]{value, relative}, result_ty, conversion_span, environment, program) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    }
    checked := sema_expr_expected(value, expected, environment, program, diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

sema_expr_check_take_pattern_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "take_pattern" || (receiver_value.ty != Type.Named{name: "Cursor"} && receiver_value.ty != Type.Named{name: "Reader"}) -> return SemaMethodSpecialCheck{handled: false, value: None}
    // The Rust original resolves `take_pattern` beside `Arena.alloc` with no
    // receiver gate: the cursor's position is runtime-owned handle state, so
    // the unmarked receiver of a `:` Cursor or Reader binding is read here.
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() != 1 {
        diagnostics.push(sema_error("E0104", span, "`take_pattern` expects one literal pattern, got {args.len()} arguments", "a pattern is a compile-time literal and is the whole argument list", "write exactly one string or `[U8]` pattern literal"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if receiver_value.ty == (Type.Named{name: "Cursor"}) {
        if args[0].expr == {
            .StrMatchLit(parts, lit_span, _) -> {
                validation := sema_pattern_text(Type.String, parts, lit_span, diagnostics, false, scopes, false)
                if !validation.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
                canonical := [TCanonicalField]{}
                tuple_fields := [TypeTupleField]{}
                loop binding in validation.bindings {
                    canonical.push(TCanonicalField{name: binding.name, ty: binding.ty})
                    tuple_fields.push(TypeTupleField{name: binding.name, ty: binding.ty})
                }
                ok_ty := if tuple_fields.len() == 0 -> Type.Named{name: "Unit"} else -> Type.Tuple{fields: tuple_fields}
                result_ty := Type.Result{ok: ok_ty, err: Type.String}
                operation := THandleOp.CursorTakePattern{parts: parts, canonical: canonical}
                value := sema_tree_node(result_ty, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{}}, span)
                checked := sema_expr_expected(value, expected, environment, program, diagnostics)
                return SemaMethodSpecialCheck{handled: true, value: checked}
            }
            else -> {
                diagnostics.push(sema_error("E0112", args[0].span, "`Cursor.take_pattern` needs a literal text pattern", "Cursor patterns use string literals with typed capture holes", "write `cursor.take_pattern(\"prefix-{{{{name:Int}}}}-suffix\")`"))
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
        }
    }
    if args[0].expr == {
        .BinMatchLit(parts, lit_span, _) -> {
            byte_type := Type.List{element: Type.IntN{signed: false, bits: 8}}
            validation := sema_pattern_binary(byte_type, parts, lit_span, diagnostics, false, scopes, false)
            if !validation.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
            canonical := [TCanonicalField]{}
            tuple_fields := [TypeTupleField]{}
            loop binding in validation.bindings {
                canonical.push(TCanonicalField{name: binding.name, ty: binding.ty})
                tuple_fields.push(TypeTupleField{name: binding.name, ty: binding.ty})
            }
            ok_ty := if tuple_fields.len() == 0 -> Type.Named{name: "Unit"} else -> Type.Tuple{fields: tuple_fields}
            result_ty := Type.Result{ok: ok_ty, err: Type.String}
            operation := THandleOp.ReaderTakePattern{parts: parts, canonical: canonical}
            value := sema_tree_node(result_ty, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{}}, span)
            checked := sema_expr_expected(value, expected, environment, program, diagnostics)
            return SemaMethodSpecialCheck{handled: true, value: checked}
        }
        else -> {
            diagnostics.push(sema_error("E0112", args[0].span, "`Reader.take_pattern` needs a literal binary pattern", "Reader patterns use `[U8]` literals with typed bit or rest captures", "write `reader.take_pattern([U8]{{\"prefix-{{{{name:U8}}}}-suffix\"}})`"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
}

sema_expr_core_module_alias_visible: fn(alias: String, scopes: SemaScopeTable) -> Bool Never! {
    index: sema_scope_resolve_index(scopes, alias) ?? return false
    kind := scopes.bindings[index].symbol.kind
    kind == SymbolKind.Module || kind == SymbolKind.Import
}

// Rust `copy_receiver_names_type`. A receiver that names a
// declared type (`Recipe.copy()`, `List<Int>.copy()`, `alias.Type.copy()`)
// keeps associated-function lookup; every other receiver is a value.
sema_expr_copy_receiver_names_type: fn(receiver: Expr, owner_type_args: [Type], scopes: SemaScopeTable) -> Bool Never! {
    if owner_type_args.len() > 0 -> return true
    if receiver == .Ident(name, _, _) {
        index: sema_scope_resolve_index(scopes, name) ?? return false
        return scopes.bindings[index].symbol.kind == SymbolKind.Type
    }
    if receiver == .Field(base, _, _, _) {
        if base == .Ident(alias, _, _) -> return sema_expr_core_module_alias_visible(alias, scopes)
    }
    false
}

// A `.move()` receiver that is a value: not a type (as for `.copy()`), and not
// a module or import whose own `move` member the call names.
sema_expr_move_receiver_names_value: fn(receiver: Expr, owner_type_args: [Type], scopes: SemaScopeTable) -> Bool Never! {
    if sema_expr_copy_receiver_names_type(receiver, owner_type_args, scopes) -> return false
    if receiver == .Ident(name, _, _) -> return !sema_expr_core_module_alias_visible(name, scopes)
    true
}

// `name.move()` or `name.field.move()` written as a call argument: the take of
// that place, which the call checks as its own take (`pair(d.title,
// d.title.move())` is E0204, not a later use of a moved field). Returns the
// bare place, which the caller passes with the `Move` convention.
sema_expr_argument_move_place: fn(arg: CallArg, scopes: SemaScopeTable) -> Expr? Never! {
    if arg.convention != AccessConvention.Read -> return None
    if arg.expr == .MethodCall(receiver, method, _, owner_type_args, type_args, args, _) {
        if method != "move" || args.len() > 0 || type_args.len() > 0 -> return None
        if !sema_expr_move_receiver_names_value(receiver, owner_type_args, scopes) -> return None
        if receiver == {
            .Ident(_, _, _) | .Field(_, _, _, _) -> return Val(receiver)
            else -> return None
        }
    }
    None
}

// `name.move()` or `name.field.move()` written where a statement reads its
// operand's shape (a loop source): the exact take of that place, as the
// expression check builds it. None for any other expression.
sema_expr_take_place_form: fn(expr: Expr, scopes: SemaScopeTable) -> Expr? Never! {
    if expr == .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, _) {
        if method != "move" || args.len() > 0 || type_args.len() > 0 -> return None
        if !sema_expr_move_receiver_names_value(receiver, owner_type_args, scopes) -> return None
        if receiver == {
            .Ident(_, _, _) | .Field(_, _, _, _) -> return Val(Expr.Place{value: receiver, access: PlaceAccess.Take, span: Span{start: expr_source_start(receiver), end: method_span.end}, id: AST_NODE_GENERATED})
            else -> return None
        }
    }
    None
}

sema_expr_canonical_type_binding: fn(name: String, scopes: SemaScopeTable) -> Bool Never! {
    index: sema_scope_resolve_index(scopes, name) ?? return false
    binding := scopes.bindings[index]
    if binding.symbol.kind != SymbolKind.Type -> return false
    if binding.symbol.module_name == "" || binding.symbol.module_name.starts_with("core.") -> return true
    sema_scope_binding_is_compiler_builtin(binding, name)
}

SemaExprCoreReceiverPath: struct {
    alias: String
    alias_span: Span
    leaves: [String]
}

// A Core call receiver: an import alias, or a field chain over one
// (`core.math` in `core.math.fabs(n)`); the leaves name submodules.
sema_expr_core_module_receiver_path: fn(receiver: Expr) -> SemaExprCoreReceiverPath? Never! {
    if receiver == {
        .Ident(name, span, _) -> return Val(SemaExprCoreReceiverPath{alias: name, alias_span: span, leaves: [String]{}})
        .Field(base, leaf, _, _) -> {
            path := sema_expr_core_module_receiver_path(base) ?? return None
            path.leaves.push(leaf)
            return Val(path)
        }
        else -> return None
    }
}

sema_expr_try_core_module_method: fn(receiver: Expr, method: String, method_span: Span, type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    before: diagnostics.len()
    unbuilt := SemaCoreUnbuiltCall?{None}
    checked: sema_expr_core_module_method_checked(receiver, method, method_span, type_args, args, expected, environment, program, scopes, state, tail_store, context, unbuilt, diagnostics)
    if checked.handled -> sema_call_core_unbuilt_settle(unbuilt, before, diagnostics)
    checked
}

sema_expr_core_module_method_checked: fn(receiver: Expr, method: String, method_span: Span, type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, unbuilt: &SemaCoreUnbuiltCall?, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    path: sema_expr_core_module_receiver_path(receiver) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    alias: path.alias
    alias_span: path.alias_span
    if !sema_expr_core_module_alias_visible(alias, scopes) -> return SemaMethodSpecialCheck{handled: false, value: None}
    module_name := sema_call_core_import_module(environment, program, alias) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    // Rust `core_module_path_from_receiver`: `alias.leaf.method(...)` calls
    // into the known Core submodule `<alias module>.leaf`.
    loop leaf in path.leaves {
        module_name = "{module_name}.{leaf}"
        if core_module_export(module_name) == None -> return SemaMethodSpecialCheck{handled: false, value: None}
    }
    nested: path.leaves.len() > 0
    if sema_call_core_math_exact_crossing(module_name, method, args, environment, program, scopes, state, tail_store, context) == .Val(crossed) -> return sema_expr_try_core_module_method(receiver, method, method_span, type_args, crossed, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    guard := sema_call_try_scope_guard(module_name, method, alias, alias_span, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if guard.handled -> return SemaMethodSpecialCheck{handled: true, value: guard.value}
    ui := sema_call_try_ui_core_call(module_name, method, alias, alias_span, args, type_args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if ui.handled -> return SemaMethodSpecialCheck{handled: true, value: ui.value}
    decode := sema_call_try_args_decode(module_name, method, alias, alias_span, args, type_args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if decode.handled -> return SemaMethodSpecialCheck{handled: true, value: decode.value}
    form := sema_call_try_web_form(module_name, method, alias, alias_span, args, type_args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if form.handled -> return SemaMethodSpecialCheck{handled: true, value: form.value}
    transform := sema_call_try_compute_transform(module_name, method, alias, alias_span, args, type_args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if transform.handled -> return SemaMethodSpecialCheck{handled: true, value: transform.value}
    if !nested {
        live := sema_call_try_live(module_name, method, alias, alias_span, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        if live.handled -> return SemaMethodSpecialCheck{handled: true, value: live.value}
    }
    // `reactive.signal/derived/computed/autorun` have no Core call record:
    // they check here, not by route.
    if module_name == "core.reactive" && (method == "signal" || method == "derived" || method == "computed" || method == "autorun") {
        reactive := sema_call_try_reactive_core_call(module_name, method, args, type_args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: reactive.handled, value: reactive.value}
    }
    if sema_call_core_crypto_expert_gate(module_name, method, method_span, context, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    if sema_call_core_vault_build_time_gate(module_name, method, method_span, scopes, environment.function_name, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    sema_call_core_unbuilt_note(module_name, method, method_span, environment, program, unbuilt)
    if !nested && sema_call_core_variadic_print(environment, program, scopes, alias, method, args.len(), alias_span, context) {
        printed := sema_call_check_ambient_print(Call{name: "{alias}.{method}", name_span: method_span, type_args: type_args, args: args}, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: printed.value}
    }
    diagnostics_before := diagnostics.len()
    route := if nested -> sema_call_core_resolve_import_path_route(environment, program, scopes, alias, module_name, method, type_args, args.len(), sema_call_core_configured_client(args), method_span, alias_span, context, diagnostics) else -> sema_call_core_resolve_import_route(environment, program, scopes, alias, method, type_args, args.len(), sema_call_core_configured_client(args), method_span, alias_span, context, diagnostics)
    route_value: route ?? {
        if diagnostics.len() != diagnostics_before -> return SemaMethodSpecialCheck{handled: true, value: None}
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if route_value == {
        .SharedSite(lifetime) -> return SemaMethodSpecialCheck{handled: true, value: sema_call_core_global_shared(lifetime, method, type_args, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)}
        .Source(target) -> {
            // ("core.mem", "volatile_read" | "volatile_write"): an audited
            // `core.mem` operation outside `#Unsafe` is E3101 at the call, before
            // its arguments are checked.
            if module_name == "core.mem" && (method == "volatile_read" || method == "volatile_write") {
                _: sema_expr_require_unsafe(method, method_span, context, diagnostics)
            }
            math_abs: sema_call_try_core_math_abs(module_name, method, type_args, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            if math_abs.handled -> return SemaMethodSpecialCheck{handled: true, value: math_abs.value}
            float_class: sema_call_try_core_math_float_class(module_name, method, type_args, args, environment, program, scopes, state, tail_store, context, diagnostics)
            if float_class.handled -> return SemaMethodSpecialCheck{handled: true, value: float_class.value}
            f32_math: sema_call_try_core_math_f32(module_name, method, type_args, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            if f32_math.handled -> return SemaMethodSpecialCheck{handled: true, value: f32_math.value}
            // `csv.query<Row>(path, SQL{…})` checks its literal SQL columns against `Row` (E2420).
            if module_name == "core.encoding.csv" && method == "query" && type_args.len() == 1 && args.len() == 2 -> sema_data_check_analytics_sql_schema(type_args[0], args[1].expr, expr_span(args[1].expr), environment, program, diagnostics)
            if module_name == "core.ui" && method == "node_role" -> sema_call_core_ui_node_role_lint(args, method_span, environment, program, scopes, diagnostics)
            scopes.ownership_call_depth += 1
            value := sema_call_core_check_source_owned(target, "{module_name}.{method}", type_args, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            scopes.ownership_call_depth -= 1
            return SemaMethodSpecialCheck{handled: true, value: value}
        }
        .Core(record) -> {
            special := sema_call_try_core_direct_record(record, args, type_args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            if special.handled -> return SemaMethodSpecialCheck{handled: true, value: special.value}
            scopes.ownership_call_depth += 1
            value := sema_call_core_check_fixed(environment, program, module_name, method, type_args, args, method_span, expected, scopes, state, tail_store, context, diagnostics)
            scopes.ownership_call_depth -= 1
            return SemaMethodSpecialCheck{handled: true, value: value}
        }
    }
}

sema_expr_try_method_static_routes: fn(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    task_surface := sema_taskgroup_check_surface_method(receiver, method, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if task_surface.handled -> return task_surface

    module_alias := if receiver == {
        .Field(base, _, _, _) -> if base == {.Ident(name, _, _) -> Val(name) else -> None}
        else -> None
    }
    alias: module_alias ?? ""
    if alias != "" && sema_expr_core_module_alias_visible(alias, scopes) {
        memory := sema_call_try_memory_static(receiver, method, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        if memory.handled -> return memory
        http := sema_call_try_http_static(receiver, method, owner_type_args, type_args, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        if http.handled -> return http
    }
    // `mem.address_of(place)` names the module itself as its receiver.
    if receiver == .Ident(name, _, _) {
        if sema_expr_core_module_alias_visible(name, scopes) {
            memory := sema_call_try_memory_static(receiver, method, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            if memory.handled -> return memory
        }
    }

    owner := if receiver == {.Ident(name, _, _) -> name else -> ""}
    // `alias.Type.method(...)` names the same Core owner as bare `Type` when the
    // aliased Core module exports that type.
    qualified_owner := false
    if alias != "" && sema_expr_core_module_alias_visible(alias, scopes) && receiver == .Field(_, leaf, _, _) {
        if sema_call_core_import_module(environment, program, alias) == .Val(module_name) && core_module_has_type(module_name, leaf) {
            owner = leaf
            qualified_owner = true
        }
    }
    // The Prelude `FieldError.under` framing helper
    // (Rust checks it by owner name before any user lookup).
    if owner == "FieldError" && method == "under" -> return sema_data_check_field_error_under(args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    // Rust `core_type_known`: a prelude core type (`Reader`, `Dyn`, …)
    // needs no `use`, so an unbound owner reaches the reserved constructors
    // too; each route matches only its own owner names.
    if owner != "" && (qualified_owner || sema_scope_resolve_index(scopes, owner) == None || sema_expr_canonical_type_binding(owner, scopes)) {
        stream := sema_call_try_stream_handle_static(owner, method, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        if stream.handled -> return stream
        time := sema_call_try_time_static_method(owner, method, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        if time.handled -> return time
        if owner == "Dyn" && !sema_data_check_explicit_type_args("Dyn.{method}", type_args, 0, method_span, diagnostics) {
            sema_data_check_discarded_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        data := sema_call_try_data_literal(Type.Named{name: owner}, method, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        if data.handled -> return data
    }

    game := sema_call_try_game_static(receiver, method, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if game.handled -> return game

    static := sema_call_try_static_method(receiver, method, method_span, owner_type_args, type_args, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if static.handled -> return static

    core := sema_expr_try_core_module_method(receiver, method, method_span, type_args, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if core.handled -> return core
    if receiver == .Ident(alias_name, alias_span, _) {
        if sema_expr_core_module_alias_visible(alias_name, scopes) -> return sema_call_try_source_module_call(alias_name, alias_span, method, method, type_args, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        if sema_call_taken_over_file_member(alias_name, method, method_span, environment, program, scopes) == .Val(taken) {
            diagnostics.push(taken)
            loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    // `helper.internal.secret()`: a member of an inline module of an imported
    // file module, lifted beside it under its member identity.
    if receiver == .Field(base, submodule, _, _) && base == .Ident(alias_name, alias_span, _) {
        if sema_expr_core_module_alias_visible(alias_name, scopes) && sema_call_source_import_inline_module(environment, program, alias_name, submodule) {
            return sema_call_try_source_module_call(alias_name, alias_span, sema_inline_member_name(submodule, method), "{submodule}.{method}", type_args, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        // `text.wrap.decorate()`: `text.wrap` is a function the module
        // publishes, and a function has no methods.
        if sema_expr_core_module_alias_visible(alias_name, scopes) && sema_call_module_member_is_function(environment, program, alias_name, submodule) {
            diagnostics.push(sema_error("E0311", method_span, "`{method}` isn't a method on this value", "`{alias_name}.{submodule}` is a function, and a function has no methods", "call `{alias_name}.{submodule}(…)` itself, or call an item that `{alias_name}` publishes"))
            loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}
sema_expr_record_hardware_result: fn(result: SemaHardwareMethodCheck, scopes: &SemaScopeTable, context: &SemaCheckContext) -> SemaMethodSpecialCheck Never! {
    sema_hardware_use_merge(context.hardware_use, sema_hardware_use_snapshot(result.hardware_use))
    // copy: `fact` is a payload of read parameter `result`, which keeps the original; the pushed list `scopes.hardware_pending_transfers` owns this one
    if result.dma_transfer == .Val(fact) && result.check.value != None -> scopes.hardware_pending_transfers.push(fact.copy())
    result.check
}

sema_expr_try_hardware_pre_receiver: fn(receiver: Expr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    hardware := sema_call_try_hardware_pre_receiver(receiver, method, args, None, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if hardware == .Val(result) && result.check.handled -> return sema_expr_record_hardware_result(result, scopes, context)
    SemaMethodSpecialCheck{handled: false, value: None}
}

sema_expr_try_method_special_routes: fn(receiver: Expr, receiver_value: TExpr, method: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    // Rust `infer_method_call`: a secret-bearing crypto value is move-only and
    // exposes no clone, encode, hash, debug or display method.
    if sema_call_reflection_secret_bearing(receiver_value.ty) && (method == "clone" || method == "encode" || method == "hash" || method == "debug" || method == "display") {
        diagnostics.push(sema_error("E0311", span, "`{method}` is forbidden on secret-bearing `{type_name(receiver_value.ty)}`", "secret-bearing cryptographic values are move-only and expose no clone, hash, serialization, Debug, or Display operation", "move the value to its next owner; use only a named `core.crypto.expert` exposure inside an audited `#Unsafe` region when raw bytes are required"))
        sema_data_check_discarded_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    debug := sema_call_try_debug_method(receiver, receiver_value, method, args, type_args, span, expected, environment, program, scopes, state, diagnostics)
    if debug.handled -> return debug
    data := sema_call_try_data_method(receiver, receiver_value, method, args, type_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if data.handled -> return data

    http := sema_call_try_http_method(receiver, receiver_value, method, owner_type_args, type_args, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if http.handled -> return http
    web_form := sema_call_try_web_form_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if web_form.handled -> return web_form
    layout := sema_call_try_layout_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if layout.handled -> return layout
    ui := sema_call_try_ui_handle_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if ui.handled -> return ui
    stream := sema_call_try_stream_handle_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if stream.handled -> return stream
    process := sema_call_try_process_handle_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if process.handled -> return process
    time := sema_call_try_time_handle_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if time.handled -> return time
    app := sema_call_try_app_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if app.handled -> return app
    network := sema_call_try_network_handle_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if network.handled -> return network
    reflection := sema_call_try_reflection_handle_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if reflection.handled -> return reflection
    compiler_value := sema_call_try_compiler_value_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if compiler_value.handled -> return compiler_value

    queue := sema_call_try_job_queue_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if queue.handled -> return queue

    tree := sema_check_service_tree_method(method, receiver, receiver_value, args, expected, span, environment, program, scopes, state, tail_store, context, diagnostics)
    if tree == .Val(check) {
        if check.handled -> return check
    }
    workflow := sema_check_service_workflow_method(method, receiver, receiver_value, args, expected, span, environment, program, scopes, state, tail_store, context, diagnostics)
    if workflow == .Val(check) {
        if check.handled -> return check
    }
    endpoint := sema_check_service_endpoint_method(method, receiver, receiver_value, args, expected, span, environment, program, scopes, state, tail_store, context, diagnostics)
    if endpoint == .Val(check) {
        if check.handled -> return check
    }
    delivery := sema_check_delivery_method(method, receiver, receiver_value, args, expected, span, environment, program, scopes, state, tail_store, context, diagnostics)
    if delivery == .Val(check) {
        if check.handled -> return check
    }
    delivery_state := sema_check_delivery_state_method(method, receiver, receiver_value, args, expected, span, environment, program, scopes, state, tail_store, context, diagnostics)
    if delivery_state == .Val(check) {
        if check.handled -> return check
    }
    runtime := sema_check_service_runtime_method(method, receiver, receiver_value, args, expected, span, environment, program, scopes, state, tail_store, context, diagnostics)
    if runtime == .Val(check) {
        if check.handled -> return check
    }

    reactive := sema_call_try_reactive_handle_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if reactive.handled -> return reactive
    event_handle := sema_call_try_event_handle_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if event_handle.handled -> return event_handle
    int_abs := sema_call_try_int_abs_source(receiver, receiver_value, method, type_args, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if int_abs.handled -> return int_abs
    // Complex is not Numeric; its magnitude is its own
    // `abs` method (a Float), lowered to the MathBuiltin route `math.abs` uses.
    if receiver_value.ty == (Type.Named{name: "Complex"}) && method == "abs" && args.len() == 0 {
        magnitude := sema_tree_node(Type.Float, TExprKind.MathBuiltin{type_name: "Complex", function: "abs", args: [TExpr]{receiver_value}}, span)
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(magnitude, expected, environment, program, diagnostics)}
    }
    game := sema_call_try_game_method(receiver, receiver_value, method, args, type_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if game == .Val(check) {
        if check.handled -> return check
    }
    geometry := sema_call_try_geometry(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if geometry.handled -> return geometry
    math := sema_call_try_math_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if math.handled -> return math
    transfer_fact := sema_hardware_transfer_fact_for_expr(receiver, scopes, state)
    hardware := sema_call_try_hardware_method(receiver, receiver_value, method, args, transfer_fact, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if hardware == .Val(result) && result.check.handled -> return sema_expr_record_hardware_result(result, scopes, context)
    memory := sema_call_try_memory_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if memory.handled -> return memory
    collections := sema_call_try_builtin_collections(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if collections.handled -> return collections
    concurrency := sema_call_try_builtin_concurrency(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if concurrency.handled -> return concurrency
    task_group := sema_taskgroup_check_group_method(receiver, receiver_value.ty, method, args, span, environment, program, scopes, state, tail_store, context, diagnostics)
    if task_group.handled -> return task_group
    task_handle := sema_taskgroup_check_task_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, context, diagnostics)
    if task_handle.handled -> return task_handle

    value_method := sema_call_try_value_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if value_method.handled -> return value_method
    builtin := sema_call_try_builtin_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if builtin.handled -> return builtin
    SemaMethodSpecialCheck{handled: false, value: None}
}

// This rule a=A: the receiver type `.new(...)` takes from its expected type.
sema_expr_inferred_new_owner: fn(expected: Type?) -> Type? {
    ty: expected ?? return None
    if ty == {
        .Named(_) | .Apply(_, _) -> Val(ty)
        .Shared(inner) -> Val(Type.Apply{name: "Shared", args: [Type]{inner}})
        .List(inner) -> Val(Type.Apply{name: "List", args: [Type]{inner}})
        .Map(key, _, value) -> Val(Type.Apply{name: "Map", args: [Type]{key, value}})
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 -> Val(Type.Named{name: type_name(ty)})
        .Tagged(_, inner) -> if inner == {
            .Named(_) | .Apply(_, _) -> Val(inner)
            else -> None
        }
        else -> None
    }
}

// A callable field is the direct-call route only in the absence of a method.
// Query declaration identity before visibility, inference, or argument shape:
// a rejected method call must never become a successful field call.
sema_expr_function_field: fn(receiver: Type, name: String, method_name: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    // D-COMPUTE-VJP1=A: `run.pull(seed)` calls the run's Fn-typed `pull`
    // field (Rust core_generic_struct_field); `VJPRun` declares no methods.
    if sema_expr_unwrap_tag(receiver) == .Apply(run_name, run_args) {
        if run_name == "VJPRun" && run_args.len() == 1 {
            run_field: sema_expression_vjp_run_field(run_args[0], name) ?? return false
            return sema_call_type_is_function(run_field)
        }
    }
    type_name: sema_type_graph_base_name(sema_expr_unwrap_tag(receiver)) ?? return false
    definition: sema_serde_type_definition(environment, program, type_name) ?? return false
    callable := false
    if definition.kind == .Struct(fields, _) {
        loop field in fields {
            if field.name == name {
                callable = sema_call_type_is_function(sema_call_resolved_type(field.ty, environment, program))
                break
            }
        }
    }
    if !callable -> return false
    if sema_expr_declares_nominal_method(environment, program, sema_expr_unwrap_tag(receiver), method_name, false) -> return false
    if program.registration_graph == .Val(graph) {
        if sema_type_resolve_nominal_row_at(graph, receiver, sema_scope_caller_row(environment, graph)) == .Val(row) {
            nominal: graph.modules[row.module_index].nominals[row.row]
            loop method in nominal.methods {
                if method.symbol.name == method_name -> return false
            }
            loop implementation_row in sema_registration_impl_rows_named(graph, nominal.symbol.name) {
                implementation: graph.modules[implementation_row.module_index].impls[implementation_row.row]
                if implementation.target_identity_key != nominal.identity_key -> next
                loop method in implementation.methods {
                    if method.symbol.name == method_name -> return false
                }
                trait_symbol: implementation.trait_symbol ?? next
                trait_row: sema_call_trait_row_for_symbol(graph, trait_symbol.id) ?? next
                trait_nominal: graph.modules[trait_row.module_index].nominals[trait_row.row]
                loop method in trait_nominal.trait_methods {
                    if method.declaration.name == method_name && (implementation.delegation_field != None || method.declaration.default_body != None) -> return false
                }
            }
            if nominal.source == .SourceAST(item) {
                loop block in sema_registration_item_trait_blocks(item) {
                    trait_row: sema_checked_trait_nominal_row(graph, nominal.symbol.module_name, block.trait_name) ?? next
                    trait_nominal: graph.modules[trait_row.module_index].nominals[trait_row.row]
                    loop method in trait_nominal.trait_methods {
                        if method.declaration.name == method_name && (block.delegation_field != None || method.declaration.default_body != None) -> return false
                    }
                }
            }
        }
    } else {
        loop declaration_index in 0..<environment.declarations.len() {
            if environment.declarations[declaration_index].item == {
                .Struct(value) -> {
                    if value.name != definition.name -> next
                    loop method in value.methods {
                        if method.name == method_name -> return false
                    }
                    loop block in value.trait_impls {
                        loop method in block.methods {
                            if method.name == method_name -> return false
                        }
                    }
                }
                .Impl(value) -> {
                    if value.type_name != definition.name -> next
                    loop method in value.methods {
                        if method.name == method_name -> return false
                    }
                }
                else -> {}
            }
        }
    }
    true
}

// Whether `receiver.method(…)` is an allocator's `alloc`, `try_alloc` or
// `reset` on a name: those keep the arena's views (Rust
// `allocator_view_preserving_receiver`).
sema_expr_allocator_view_receiver: fn(receiver: Expr, method: String, environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> Bool {
    if method != "alloc" && method != "try_alloc" && method != "reset" -> return false
    if receiver == .Ident(name, span, _) {
        index: sema_scope_resolve_index_at(scopes, name, span) ?? return false
        ty: sema_scope_binding_type(environment, scopes, index) ?? return false
        return sema_call_memory_allocator_name(ty) != None
    }
    false
}

sema_expr_check_method_call: fn(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    // L0505 / L0506: a growing call in a loop of a `core.mem` file, or inside
    // a `#Context` block that names no allocator, may reach the global heap.
    if method == "push" || method == "append" || method == "insert" || method == "add" || method == "add_new" {
        if scopes.loop_depth > 0 && sema_stmt_module_uses_core_mem(environment, program) {
            diagnostics.push(sema_lint("L0505", method_span, "Heap growth inside a loop — consider an arena", "Each `push` may allocate on the global heap; in a hot loop that adds up", "Bind `arena: mem.Arena.new()` outside the loop and use `arena.alloc(…)` for scratch data"))
        }
        if scopes.context_allocation == 1 {
            diagnostics.push(sema_lint("L0506", method_span, "Hidden allocation inside `#Context` without an allocator", "This call may allocate on the global heap while a scoped context is active", "Add `allocator: …` to the `#Context(…)` fields, or move the allocation outside the block"))
        }
    }
    sema_expr_lint_unit_scalar_rewrap(receiver, method, args, method_span, environment, program, scopes, context, diagnostics)
    if method == "call" -> sema_expr_lint_inline_autodiff(receiver, environment, program, scopes, context, diagnostics)
    // This rule a=A: `.new(...)` leaves only the static receiver implicit; the
    // ordinary expected type names it (E0356 when there is none).
    if receiver == .Ident(receiver_name, receiver_span, _) && receiver_name == "" {
        owner: sema_expr_inferred_new_owner(expected) ?? {
            loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
            diagnostics.push(sema_error("E0356", method_span, "`.new(...)` needs one known receiver type here", "the inferred constructor uses the surrounding expected type; Jet does not search a global constructor registry", "write the full `Type.new(...)` form, or use `.new(...)` where its type is already expected"))
            return None
        }
        owner_name := ""
        inferred_args := owner_type_args
        if owner == {
            .Apply(name, apply_args) -> {
                owner_name = name
                if owner_type_args.len() == 0 -> inferred_args = apply_args
            }
            .Named(name) -> owner_name = name
            else -> return None
        }
        return sema_expr_check_method_call(Expr.Ident{name: owner_name, span: receiver_span, id: AST_NODE_GENERATED}, method, method_span, inferred_args, type_args, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    checked_text := sema_expression_checked_text_static_method_call(receiver, method, method_span, owner_type_args, type_args, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if checked_text.handled -> return checked_text.value
    explicit_unit := sema_expr_try_explicit_unit_method(receiver, method, method_span, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if explicit_unit.handled -> return explicit_unit.value
    enum_variant := sema_expression_enum_variant_call(receiver, method, method_span, owner_type_args, type_args, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if enum_variant.handled -> return enum_variant.value
    receipt_attach := sema_receipt_try_attach(receiver, method, method_span, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if receipt_attach.handled -> return receipt_attach.value
    pre_receiver := sema_expr_try_method_static_routes(receiver, method, method_span, owner_type_args, type_args, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if pre_receiver.handled -> return pre_receiver.value
    hardware_pre_receiver := sema_expr_try_hardware_pre_receiver(receiver, method, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if hardware_pre_receiver.handled -> return hardware_pre_receiver.value
    memo_stats: sema_function_header_memo_stats(receiver, method, args, method_span, environment, program, scopes, diagnostics)
    if memo_stats.handled -> return memo_stats.value
    root_call := sema_root_call_try(receiver, method, method_span, type_args, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if root_call.handled -> return root_call.value
    missing := sema_call_static_missing_member(receiver, method, method_span, args, environment, program, scopes, state, tail_store, context, diagnostics)
    if missing.handled -> return missing.value
    outcome_read := sema_value_method_outcome_read(receiver, method, method_span, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if outcome_read.handled -> return outcome_read.value
    scopes.ownership_call_depth += 1
    // Chaining `.trim()`/`.after()`/`.before()` onto a string view
    // reads it as the `&str` those methods take, so the view read is allowed.
    // (Rust `infer_method_call`): any other method but the
    // `&str` kernels (`starts_with`, `ends_with`, `contains`) reads the view
    // through a `String` receiver, so it takes the default owning copy.
    previous_string_view_read := context.allow_string_view_read
    exempt_view_receiver: sema_string_view_exempt_receiver(receiver, method, scopes)
    if exempt_view_receiver -> context.allow_string_view_read = true
    receiver_checked := TExpr?{None}
    if !exempt_view_receiver && method != "starts_with" && method != "ends_with" && method != "contains" && sema_string_view_owning_read(receiver, Type.String, scopes) && receiver == .Ident(view_name, view_span, _) {
        receiver_checked = sema_string_view_materialize(view_name, view_span, None, environment, program, scopes, state, context, diagnostics)
    } else {
        // Rust `allocator_view_preserving_receiver`: `alloc` and `reset` on an
        // allocator name run no owner read on it, or a live arena view would be
        // E0220 before `reset` can invalidate it.
        previous_root_read: context.suppress_partial_move_root_read
        if sema_expr_allocator_view_receiver(receiver, method, environment, scopes) -> context.suppress_partial_move_root_read = true
        receiver_checked = sema_check_expression(receiver, None, environment, program, scopes, state, tail_store, context, diagnostics)
        context.suppress_partial_move_root_read = previous_root_read
    }
    context.allow_string_view_read = previous_string_view_read
    scopes.ownership_call_depth -= 1
    receiver_value: receiver_checked ?? return None
    if method == "text" -> sema_expr_lint_default_body_text(receiver, receiver_value.ty, args, scopes, diagnostics)
    if method == "replace" -> sema_expr_lint_fixed_cleanup(receiver, receiver_value.ty, args, method_span, diagnostics)
    // `.call(...)` on a function-typed receiver is the builtin call projection,
    // checked exactly like calling the value directly (mirrors METHOD_CALL on
    // Type::Fn).
    receiver_signature: sema_call_resolved_type(receiver_value.ty, environment, program)
    if method == "call" && sema_call_type_is_function(receiver_signature) {
        call_end := method_span.end
        if args.len() > 0 -> call_end = expr_span(args[args.len() - 1].expr).end
        scopes.ownership_call_depth += 1
        projected := sema_call_value_checked_from_type(state, receiver, receiver_value, receiver_signature, args, Span{start: expr_span(receiver).start, end: call_end}, [SemaCallDefaultValue]{}, expected, environment, program, scopes, tail_store, context, diagnostics)
        scopes.ownership_call_depth -= 1
        projected_value: projected ?? return None
        context.call_return_views.push(SemaCallReturnView{span: method_span, facts: projected_value.return_view_facts})
        if !sema_expr_record_call_fact(environment, program, scopes, context, method_span, projected_value, diagnostics) -> return None
        return Val(projected_value.value)
    }
    routed_method: sema_call_geometry_routed_method(receiver_value.ty, method, args.len(), environment, program) ?? core_source_receiver_method(if core_source_receiver_method_routes(method, args.len()) -> sema_expr_receiver_nominal_identity(environment, program, receiver_value.ty) else -> type_name(receiver_value.ty), method, args.len())
    // Only method absence enables the callable field. As in the reference,
    // the callee field is spanned at the method name and the call runs from
    // that name to its last argument.
    if sema_expr_function_field(receiver_value.ty, method, routed_method, environment, program) {
        call_end := method_span.end
        if args.len() > 0 -> call_end = expr_span(args[args.len() - 1].expr).end
        return sema_expr_check_indirect_call(Expr.Field{base: receiver, member: method, span: method_span, id: AST_NODE_GENERATED}, args, Span{start: method_span.start, end: call_end}, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    take_pattern := sema_expr_check_take_pattern_method(receiver, receiver_value, method, args, method_span, expected, environment, program, scopes, state, diagnostics)
    if take_pattern.handled -> return take_pattern.value
    zip := sema_expression_zip_method(receiver, receiver_value, method, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if zip.handled -> return zip.value
    // D-VALIDATE1=A: a `Validate.over(value)` rule binds `at:` to a field of
    // the validated type, then checks as the Core builder method.
    if method == SEMA_VALIDATE_CHECK && sema_validate_over_receiver(receiver_value.ty, environment, program) == .Val(subject) {
        rule: sema_validate_over_rule(subject, args, method_span, environment, program, scopes, diagnostics) ?? {
            // The `at:` field name is not a value; its E0354 is the report.
            discarded := [CallArg]{}
            loop argument in args {
                if argument.label == .Val(label) {
                    if label.name == "at" && argument.expr == .Ident(_, _, _) -> next
                }
                discarded.push(argument.copy()) // copy: `args` is the caller's read parameter
            }
            sema_data_check_discarded_arguments(discarded, environment, program, scopes, state, tail_store, context, diagnostics)
            return None
        }
        return sema_expr_check_declared_method(receiver, receiver_value, method, routed_method, method_span, owner_type_args, type_args, rule, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    if sema_call_math_lane_reduce_rejected(receiver_value.ty, method, args, diagnostics) -> return None
    if method == "routes" -> sema_call_app_route_registrations(receiver, receiver_value, method, args, method_span, environment, program, diagnostics)
    if method == "csr" || method == "island" || method == "hydration_dev" || method == "hydration_release" -> sema_call_app_browser_feature(receiver_value, method, method_span, environment, program, context.function_name, diagnostics)
    // A declared nominal owns the methods it declares, even when its leaf
    // spells a builtin carrier such as Core's `URL` or `MIME`; builtin handle
    // routes apply only when no declared method matches.
    declared: sema_expr_declares_nominal_method(environment, program, receiver_value.ty, routed_method, true)
    if !declared {
        special := sema_expr_try_method_special_routes(receiver, receiver_value, method, owner_type_args, type_args, args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        if special.handled -> return special.value
    } else if sema_time_handle_receiver_name(receiver_value.ty) == "Clock" {
        // Core declares Clock's methods, but reading a Clock that is neither
        // deterministic nor the system clock still reads ambient time (Rust
        // `Clock.{method}` check): the time route records that site before
        // the declared method checks the call.
        if sema_time_clock_record(receiver_value, method, args, method_span, environment, program, scopes, context, diagnostics) == .Val(recorded) && !recorded -> return None
    }
    if method == "with" && sema_expr_expiring_secret_inner(receiver_value.ty, environment, program) == .Val(secret_type) {
        return sema_expr_check_expiring_secret_with(receiver, receiver_value, secret_type, routed_method, method_span, owner_type_args, type_args, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    sema_expr_check_declared_method(receiver, receiver_value, method, routed_method, method_span, owner_type_args, type_args, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

// The ordinary registered-method call: operator or declared candidates,
// inference over the argument types, then the checked candidate.
sema_expr_check_declared_method: fn(receiver: Expr, receiver_value: TExpr, method: String, routed_method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    operator_trait: owned_trait_for_operator_hook(method)
    argument_types := [Type?]{}
    argument_index := 0
    loop argument_index < args.len() {
        argument := args[argument_index]
        if {
            // A decimal literal's carrier comes from the parameter it meets.
            sema_call_inference_needs_context(argument.expr) || (operator_trait == None && sema_expr_decimal_literal_operand(argument.expr, true)) -> {
                argument_types.push(None)
            }
            else -> {
                probe_diagnostics := [Diagnostic]{}
                checked_argument := sema_probe_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, probe_diagnostics)
                if {
                    checked_argument != None -> {
                        checked_value: checked_argument ?? return None
                        argument_types.push(Val(checked_value.ty))
                    }
                    else -> {
                        argument_types.push(None)
                    }
                }
            }
        }
        argument_index += 1
    }
    // Core declares `Transform.then<Next>`, so a chain whose middle spaces
    // differ reaches this declared call; it is E2521, not an uninferable `Next`.
    if method == "then" && args.len() == 1 && argument_types[0] == .Val(next_type) {
        // copy: `argument_types` stays live for the inference call below
        if sema_call_geometry_report_transform_chain_mismatch(receiver_value.ty, method, [Type]{next_type.copy()}, method_span, environment, program, diagnostics) -> return None
    }
    candidates := [SemaCallMethodCandidate]{}
    if args.len() == 1 && operator_trait == .Val(trait_name) {
        if argument_types[0] == .Val(rhs) && program.registration_graph == .Val(graph) {
            loop resolution in sema_expr_registration_operator_candidates(graph, receiver_value.ty, rhs, trait_name, method, false, method_span, environment, program, scopes, diagnostics) -> candidates.push(resolution.candidate)
        }
    }
    if candidates.len() == 0 {
        candidates = if program.registration_graph == {
            .Val(graph) -> sema_expr_registration_method_candidates(graph, environment.module_identity, receiver_value.ty, routed_method, owner_type_args, type_args, method_span, environment, program, diagnostics)
            .None -> sema_call_local_method_candidates(environment, program, routed_method, owner_type_args, type_args)
        }
    }
    // `.call(…)` on a value that is neither a function nor declares `call`
    // is a call of a non-function, not a misspelt method.
    if method == "call" && !sema_expr_candidates_accept_receiver(candidates, routed_method, receiver_value.ty, environment, program) {
        diagnostics.push(sema_call_projection_not_callable(receiver, receiver_value.ty, method_span, args))
        return None
    }
    candidate: sema_call_resolve_method_with_inference(receiver_value.ty, routed_method, args, argument_types, expected, candidates, environment, program, scopes, method_span, diagnostics) ?? return None
    scopes.ownership_call_depth += 1
    checked := sema_call_check_method_candidate_from_value_owned(state, receiver, receiver_value, candidate, args, [SemaCallDefaultValue]{}, method_span, expected, environment, program, scopes, tail_store, context, diagnostics)
    scopes.ownership_call_depth -= 1
    value: checked ?? return None
    context.call_return_views.push(SemaCallReturnView{span: method_span, facts: value.return_view_facts})
    if !sema_expr_record_call_fact(environment, program, scopes, context, method_span, value, diagnostics) -> return None
    Val(value.value)
}

sema_expr_candidates_accept_receiver: fn(candidates: [SemaCallMethodCandidate], method: String, receiver: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    loop candidate in candidates {
        if candidate.method.name != method -> next
        if sema_call_method_receiver_candidate_type(candidate) == .Val(expected) {
            if sema_call_type_assignable(expected, receiver, environment, program) ?? false -> return true
        }
    }
    false
}

// The secret type `T` of an `ExpiringSecret<T>` receiver.
sema_expr_expiring_secret_inner: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type? {
    resolved: sema_expr_unwrap_tag(sema_call_resolved_type(ty, environment, program))
    if resolved == .Apply(name, args) {
        if sema_is_expiring_secret_name(name) && args.len() == 1 -> return Val(args[0])
    }
    None
}

// `ExpiringSecret.with` lends its callback a read loan of the secret. The
// callback is first judged as an open callback of `fn(#loan T)` (no return
// row, never stored): a move, store, return or replacement of the loan reports
// against the loan (E0201), and a result that still holds the loan, or a
// function that could capture it, escapes the callback (E0201 at `.with`).
// A callback judged clean runs the ordinary source call with its result as
// `R`; otherwise the call stands as the `R Expired!` it would return (`Unit`
// for an escaped result), so its own failure route is still judged.
sema_expr_check_expiring_secret_with: fn(receiver: Expr, receiver_value: TExpr, secret_type: Type, routed_method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if args.len() != 1 {
        diagnostics.push(sema_error("E0104", method_span, "`with` expects 1 argument, got {args.len()}", "`.with` takes exactly one closure", "call `.with(value -> ...)` with a closure"))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    callback_is_lambda: if args[0].expr == {
        .Lambda(_, _) -> true
        else -> false
    }
    if !callback_is_lambda {
        diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`with` needs a lambda, not a value", "`.with` runs a short function against the locked value", "write `.with(value -> …)`"))
        _ := sema_check_expression(args[0].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    loan_expected: Type.Fn{params: [Type]{sema_expiring_secret_loan_type(secret_type)}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    loan_reports := [Diagnostic]{}
    scope_mark: sema_scope_mark(scopes)
    context_mark: sema_check_context_mark(context)
    fork: sema_ownership_fork(state)
    callback: sema_expression_lambda_collection_callback(args[0].expr, Val(loan_expected), environment, program, scopes, state, tail_store, context, loan_reports)
    sema_ownership_fork_rollback(state, fork)
    sema_ownership_fork_close(state, fork)
    sema_check_context_rollback(context, context_mark)
    sema_scope_rollback(scopes, scope_mark)
    result := Type.Named{name: "Unit"}
    if callback == .Val(checked_callback) -> result = sema_call_signature_return(checked_callback.ty) ?? Type.Named{name: "Unit"}
    returns_function: if result == {
        .Fn(_, _, _, _, _, _) -> true
        else -> false
    }
    escaped: returns_function || sema_contains_expiring_secret_loan(result)
    if !escaped && !sema_has_error_since(loan_reports, 0) {
        result_args: if type_args.len() > 0 -> type_args else -> [Type]{result}
        return sema_expr_check_declared_method(receiver, receiver_value, "with", routed_method, method_span, owner_type_args, result_args, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    loop report in loan_reports -> diagnostics.push(report)
    if escaped {
        diagnostics.push(sema_error("E0201", method_span, "an ExpiringSecret loan cannot escape its callback", "the callback receives a temporary read-only loan; returning a secret would create another owned credential outside the expiry boundary", "return a non-secret result such as a signature, public key, status, or response"))
        result = Type.Named{name: "Unit"}
    }
    Val(sema_node(context, Type.Result{ok: result, err: Type.Named{name: "Expired"}}, NodeKind.Unit, method_span))
}

sema_expr_check_identifier: fn(name: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    diagnostics_before: diagnostics.len()
    if sema_scope_has_loop_label(scopes, name) {
        diagnostics.push(sema_error("E0988", span, "loop label `{name}` is not a runtime value", "a loop label names a control-flow destination, so it cannot be read, passed, or stored", "use `break({name})` or `next({name})` to control the loop"))
        return None
    }
    if name == "err" && context.fallback_err_denial == .Val(code) {
        diagnostics.push(sema_fallback_err_denied(code, span))
        return None
    }
    // Resolved once: nothing below rebinds a name before the reference fact
    // reads this binding again (sema_expr_check_ident only reads the table).
    unresolved_index: sema_scope_resolve_index(scopes, name)
    if unresolved_index == .Val(unresolved) {
        if scopes.bindings[unresolved].symbol.kind == SymbolKind.Constant && sema_scope_binding_type(environment, scopes, unresolved) == None {
            context.name_references.push(SemaNameReferenceFact{span: span, symbol: sema_scope_binding_symbol(environment, scopes, unresolved), kind: "const"})
            // A comptime probe reads this reference as a dependency wait; a
            // body check after the comptime run reaches here only when the
            // constant's value never landed, which the reason names.
            sema_check_unsupported(context, "constant `{name}` (read at offset {span.start}) has no staged compile-time value")
            return None
        }
    }
    // A prepared local reads as its compile-time value.
    if unresolved_index == .Val(prepared_index) {
        if scopes.bindings[prepared_index].prepared != None {
            prepared_binding: sema_scope_binding_row(environment, scopes, prepared_index)
            if prepared_binding.prepared == .Val(known) {
                prepared_ty: prepared_binding.symbol.ty ?? {
                    sema_check_unsupported(context, "prepared local `{name}` (read at offset {span.start}) has no checked type")
                    return None
                }
                context.name_references.push(SemaNameReferenceFact{span: span, symbol: prepared_binding.symbol, kind: "local"})
                if !sema_ownership_note_reference(state, name, span, scopes, SemaOwnershipReferenceKind.Read) -> return None
                if sema_compiler_host_value_held(prepared_ty) == .Val(held) -> sema_compiler_host_value_runtime_read(name, held, span, scopes, environment.function_name, diagnostics)
                sema_comptime_use_value_read(name, prepared_ty, span, environment, program, scopes, diagnostics)
                prepared: sema_fact_prepared_expr(known, prepared_ty, span, environment, program, context) ?? return None
                return sema_expr_expected_owned(prepared, expected, environment, program, diagnostics)
            }
        }
    }
    // E0420: a `Type{ uninit }` binding read before
    // every path wrote it reports once, then the read resolves as usual.
    if unresolved_index == .Val(read_index) && sema_ownership_uninit_take(state, scopes.bindings[read_index].symbol.id.key) != None {
        diagnostics.push(sema_error("E0420", span, "`{name}` may be read before it is given a value", "`{name}` was declared with `Type{{ uninit }}`, so no value is available until you write to it — this read could see garbage", "write to `{name}` on every path before reading it (e.g. fill it via `mut {name}`)"))
    }
    value: sema_expr_check_ident(name, span, expected, environment, program, scopes, context, diagnostics) ?? {
        if !sema_has_error_since(diagnostics, diagnostics_before) {
            if sema_expr_core_module_alias_visible(name, scopes) -> diagnostics.push(sema_module_used_as_value(name, span)) else -> sema_check_unsupported(context, "`{name}` (read at offset {span.start}) has no checked type")
        }
        return None
    }
    expr := Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
    if unresolved_index == .Val(unresolved) {
        kind: scopes.bindings[unresolved].symbol.kind
        if kind == SymbolKind.Local || kind == SymbolKind.Parameter {
            if !sema_ownership_note_reference(state, name, span, scopes, SemaOwnershipReferenceKind.Read) -> return None
        }
    }
    use_checked: if context.suppress_partial_move_root_read -> sema_ownership_check_root_base_use(state, expr, scopes, diagnostics) else -> sema_ownership_check_use(state, expr, scopes, diagnostics)
    if !use_checked -> return None
    if !sema_hardware_note_cpu_use(expr, scopes, state, context, diagnostics) -> return None
    sema_string_view_check_read(name, span, scopes, state, context, diagnostics)
    binding_index: unresolved_index ?? return Val(value)
    symbol: sema_scope_binding_symbol(environment, scopes, binding_index)
    reference_kind := "semantic"
    if symbol.kind == {
        .Function -> reference_kind = "function"
        .Constant -> reference_kind = "const"
        .Parameter -> reference_kind = "param"
        .Local -> reference_kind = "local"
        .Type -> reference_kind = "type"
        .Trait -> reference_kind = "trait"
        .Module -> reference_kind = "module"
        else -> {}
    }
    context.name_references.push(SemaNameReferenceFact{span: span, symbol: symbol, kind: reference_kind})
    Val(value)
}

sema_expr_check_string: fn(parts: [StrPart], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    sema_expr_lint_raw_multiline_html(parts, span, expected, environment, context, diagnostics)
    tree_parts := [TStrPart]{}
    index := 0
    loop index < parts.len() {
        if parts[index] == {
            .Lit(text) -> tree_parts.push(TStrPart.Literal{text: text})
            .Byte(value) -> tree_parts.push(TStrPart.Literal{text: sema_expr_byte_text(value)})
            .Interp(value, format) -> {
                // Interpolation reads a string view through Display.
                previous_string_view_read := context.allow_string_view_read
                context.allow_string_view_read = true
                checked_value := sema_check_expression(value, None, environment, program, scopes, state, tail_store, context, diagnostics)
                context.allow_string_view_read = previous_string_view_read
                checked: checked_value ?? return None
                // Rust expr.rs: formatting a value that holds an observable
                // Clock reads ambient time (E3403 `Clock formatting` in a pure body).
                if sema_copy_observable_clock(checked.ty, environment, program, context.generic_params) {
                    _ := sema_effect_record_intrinsic_effects(environment, program, scopes, context, "Clock formatting", checked.span, [EffectRowEntry]{EffectRowEntry{name: "Time", span: checked.span}}, diagnostics)
                }
                if format == StrFormat.Display && !sema_expression_interpolation_display(checked, environment, program, scopes, diagnostics) -> return None
                // Rust interpolation check: bare Display uses the relation above
                // and the Debug family uses `is_debuggable`; only the numeric and
                // text selectors use the primitive table.
                debug_family: format == StrFormat.Debug || format == StrFormat.Pretty
                if debug_family && !sema_call_debug_traceable(checked.ty, environment, program) {
                    selector: if format == StrFormat.Debug -> "Debug" else -> "Pretty"
                    if sema_call_reflection_secret_bearing(checked.ty) -> diagnostics.push(sema_error("E0112", checked.span, "secret-bearing `{type_name(checked.ty)}` cannot use `:{selector}`", "Debug output could copy cryptographic secret material into logs or diagnostics", "remove the interpolation; log a public operation label or key identifier instead")) else -> diagnostics.push(sema_error("E0112", checked.span, "{sema_type_show(checked.ty)} can't be shown with :{selector} yet", "debug interpolation needs a debuggable value", "implement `Debug` or use a debuggable part"))
                    return None
                }
                if !debug_family && format != StrFormat.Display && !sema_expr_check_format_selector(checked, format, environment, program, diagnostics) -> return None
                formatted: if format == StrFormat.Display && sema_expr_measurement_type(checked.ty) -> sema_expression_measurement_source_call("__measurement_show", [TExpr]{checked}, Type.String, checked.span, environment, program) ?? return None else -> checked
                tree_parts.push(TStrPart.Interpolation{value: formatted, format: sema_expr_string_format(format)})
            }
        }
        index += 1
    }
    sema_expr_expected_owned(sema_tree_node(Type.String, TExprKind.StrLit{parts: tree_parts}, span), expected, environment, program, diagnostics)
}

// L0524: a multiline literal that holds an HTML tag and stays a plain String.
// The AST keeps no quote form, so the literal whose span crosses a line is the
// triple-quoted one; the report points at its opening `"""`.
sema_expr_lint_raw_multiline_html: fn(parts: [StrPart], span: Span, expected: Type?, environment: SemaScopeEnvironment, context: SemaCheckContext, diagnostics: &[Diagnostic]) {
    if context.compiler_generated -> return
    if expected == .Val(wanted) {
        if wanted != Type.String -> return
    }
    tagged := false
    loop part in parts {
        if part == .Lit(text) {
            if sema_expr_text_has_html_tag(text) -> tagged = true
        }
    }
    if !tagged -> return
    loop segment in environment.source_segments {
        if span.start >= segment.generated.start && span.end <= segment.generated.end && span.end > span.start {
            first: sema_source_segment_line(segment, span.start - segment.generated.start) ?? return
            last: sema_source_segment_line(segment, span.end - 1 - segment.generated.start) ?? return
            if first != last -> diagnostics.push(sema_lint("L0524", Span{start: span.start, end: span.start + 3}, "This multiline HTML fragment is still a plain `String`", "Plain String interpolation cannot distinguish trusted HTML fragments from text that must be escaped", "Wrap the literal in `HTML{{…}}` and type any trusted fragment holes as `HTML`"))
            return
        }
    }
}

// `<` then a letter or `/` and a letter, closed by a later `>`.
sema_expr_text_has_html_tag: fn(text: String) -> Bool Never! {
    bytes: text.bytes()
    index := 0
    loop index + 2 < bytes.len() {
        if bytes[index] == (U8{60}) {
            at := index + 1
            if bytes[at] == (U8{47}) -> at += 1
            if at < bytes.len() && sema_expr_ascii_letter(bytes[at]) {
                close := at + 1
                loop close < bytes.len() {
                    if bytes[close] == (U8{62}) -> return true
                    if bytes[close] == (U8{60}) -> break
                    close += 1
                }
            }
        }
        index += 1
    }
    false
}

sema_expr_ascii_letter: fn(byte: U8) -> Bool Never! {
    (byte >= (U8{65}) && byte <= (U8{90})) || (byte >= (U8{97}) && byte <= (U8{122}))
}

sema_expr_check_ident: fn(name: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    index: sema_scope_resolve_index(scopes, name) ?? {
        diagnostics.push(sema_unknown_name_in(name, span, scopes))
        return None
    }
    ty: sema_scope_binding_type(environment, scopes, index) ?? return None
    kind: scopes.bindings[index].symbol.kind
    // A constant read in a body is known while compiling; runtime code may
    // read it unless it holds a compiler value or a value of a `comptime use`
    // module's types.
    if kind == SymbolKind.Constant && environment.function_name != "" {
        if sema_compiler_host_value_held(ty) == .Val(held) -> sema_compiler_host_value_runtime_read(name, held, span, scopes, environment.function_name, diagnostics)
        sema_comptime_use_value_read(name, ty, span, environment, program, scopes, diagnostics)
    }
    result := TExpr?{None}
    if kind == SymbolKind.Local || kind == SymbolKind.Parameter {
        local := checked_symbol_local(name, scopes.bindings[index].symbol.span, scopes.bindings[index].symbol.id, ty)
        local.mutable = scopes.bindings[index].mutable
        local.integer_bounds = scopes.bindings[index].integer_bounds
        value: TExpr{ty: ty, kind: TExprKind.Local{local: local}, span: span}
        result = sema_expr_expected(value, expected, environment, program, diagnostics)
    }
    if kind == SymbolKind.Constant || kind == SymbolKind.Function {
        if kind == SymbolKind.Function && sema_expr_marked_function_value(name, scopes.bindings[index].symbol.id, span, environment, program, diagnostics) -> return None
        value_ty: if kind == SymbolKind.Function -> sema_function_value_type(program, ty, scopes.bindings[index].symbol.module_name, expected) else -> ty
        value: sema_node(context, value_ty, NodeKind.ConstRef{symbol: scopes.bindings[index].symbol.id}, span)
        result = sema_expr_expected(value, expected, environment, program, diagnostics)
    }
    result
}

// E0227: a named function with a `&` or `&&` parameter stays direct-call-only.
// A function type gives every parameter read access, so its value would drop
// the write or take its parameter declares.
sema_expr_marked_function_value: fn(name: String, id: SymbolID, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Bool {
    param: sema_scope_declaration_function_marked_param(environment, program, id) ?? return false
    mark: if param.convention == AccessConvention.Write -> "&" else -> "&&"
    diagnostics.push(sema_error("E0227", span, "`{name}` can't be used as a function value because its parameter `{param.name}` is `{mark}`", "a function type gives each parameter plain read access, so a value of `{name}` would drop the `{mark}` its parameter declares", "call `{name}` directly, or pass a lambda that makes that call"))
    true
}

// A function's symbol type spells its parameter and result types as its
// declaration writes them. The function value carries them resolved, as in
// the function's own checked signature: a written trait name is a trait
// value, and a nominal type is its declared identity. A value filling a slot
// with a closed effect bound (`fn(T) -[]> U`) takes that bound: a body's row is
// known only once every body is solved, so the effect phase holds the
// function to it then (E0747), not the type check.
sema_function_value_type: fn(program: SemaProgramTables, ty: Type, module_name: String, expected: Type?) -> Type Never! {
    resolved: if program.registration_graph == .Val(graph) -> sema_type_resolve_declared(graph, ty, module_name) else -> ty.copy()
    if expected == .Val(required) && required == .Fn(_, _, bound, _, _, _) && bound == .Val(row) {
        open: loop entry in row {
            if entry.name.starts_with("..") -> break true
        } ?? false
        if !open && resolved == .Fn(params, ret, _, contract, metadata, provenance) {
            // copy: the adopted type is a new owned Type built from `resolved`'s payloads and the slot's row.
            return Type.Fn{params: params.copy(), ret: ret.copy(), effect_bound: Val(row.copy()), param_contract: contract.copy(), call_metadata: metadata.copy(), return_view_provenance: provenance.copy()}
        }
    }
    resolved
}

sema_expr_check_unary: fn(op: UnOp, operand: Expr, expected: Type?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if op == UnOp.Neg {
        if operand == .Int(value, literal_span, width, raw, _) -> return sema_expr_negative_integer(sema_expr_exact_integer_literal(value, raw), width, expected, span, literal_span, environment, program, diagnostics)
        // `-1.5` is one exact Decimal literal; the sign folds into its
        // spelling unless a Float carrier is expected. Transparent
        // parentheses keep the same literal: `-(2.5)` is `-2.5`.
        if sema_expr_paren_decimal_spelling(operand) == .Val(text) {
            if !sema_expr_expects_machine_float(expected) -> return sema_expr_expected_owned(sema_expr_decimal_literal("-{text}", span), expected, environment, program, diagnostics)
        }
    }
    // Rust checks the operand under the surrounding expectation; only a
    // Float carrier changes how a decimal literal operand elaborates.
    operand_expected := Type?{None}
    // copy: `operand_expected` is the operand's own expectation, while `expected` (the caller's
    // expectation, a read parameter) is still read below for the result. Under a Dyn
    // expectation the literal operand is a Float that wraps after negation.
    if op == UnOp.Neg && sema_expr_expects_machine_float(expected) && sema_expr_decimal_literal_operand(operand, true) -> operand_expected = if expected == (Val(sema_dyn_type())) -> Val(Type.Float) else -> expected.copy()
    value: sema_check_expression(operand, operand_expected, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if op == UnOp.Neg {
        if value.ty == {
            .IntN(signed, bits) -> {
                if !signed {
                    diagnostics.push(sema_error("E0109", span, "`-` can't negate {type_name(value.ty)}, which is unsigned", "unsigned numbers have no negative values", "use a signed integer type if this value needs a negative result"))
                    return None
                }
                if context.arithmetic_policy == .Val(policy) {
                    line: sema_source_line_at(environment.source_segments, span) ?? return None
                    zero: TExpr{ty: value.ty, kind: TExprKind.IntLit{value: 0, width: Val(TIntegerWidth{signed: true, bits: bits})}, span: span}
                    negated: sema_expr_arithmetic_policy_value(policy, ArithmeticOperation.Neg, value.ty, span, line, zero, value)
                    return sema_expr_expected_owned(negated, expected, environment, program, diagnostics)
                }
            }
            else -> {}
        }
        // Decimal is exact, so `-d` is `0 - d` through the same Core subtraction.
        if sema_expr_precise_name(value.ty) == (Val("Decimal")) {
            negated: sema_tree_node(Type.Named{name: "Decimal"}, TExprKind.PreciseBuiltin{type_name: "Decimal", function: "sub", args: [TExpr]{sema_expr_decimal_literal("0", span), value}}, span)
            return sema_expr_expected_owned(negated, expected, environment, program, diagnostics)
        }
        if !sema_expr_is_numeric(value.ty) {
            // UnOp::Neg: no user or Core type has a negation hook (Duration has
            // `.negated()`), so every other operand is this report, never an
            // unreported incomplete check.
            diagnostics.push(sema_error("E0109", span, "`-` needs a number, but this is {sema_type_show(value.ty)}", "only Int, Float and Decimal values can be negated", "use a number here"))
            return None
        }
        result_ty := sema_expr_numeric_base(value.ty)
        return sema_expr_expected_owned(sema_tree_node(result_ty, TExprKind.Unary{op: TUnaryOp.Neg, operand: value}, span), expected, environment, program, diagnostics)
    }
    if sema_dyn_is_type(sema_expr_expected_type(value.ty, environment, program)) {
        diagnostics.push(sema_dyn_condition_error(span))
        return None
    }
    if value.ty == Type.Bool {
        return sema_expr_expected_owned(sema_tree_node(Type.Bool, TExprKind.Unary{op: TUnaryOp.Not, operand: value}, span), expected, environment, program, diagnostics)
    }
    if sema_expr_is_integer(value.ty) {
        diagnostics.push(sema_error("E0398", span, "`!` needs Bool; use `bit_not` to flip integer bits", "marks express ownership and outcomes; arithmetic uses named methods", "write `value.bit_not()` for an integer, or compare the value to produce Bool"))
        return None
    }
    diagnostics.push(sema_error("E0109", span, "`!` needs Bool; use `bit_not` to flip integer bits", "marks express ownership and outcomes; arithmetic uses named methods", "write `value.bit_not()` for an integer, or compare the value to produce Bool"))
    None
}

// The spelling of a decimal literal under any number of parentheses.
sema_expr_paren_decimal_spelling: fn(expr: Expr) -> String? Never! {
    if expr == {
        .Float(_, _, _, raw, _) -> raw
        .Paren(inner, _, _) -> sema_expr_paren_decimal_spelling(inner)
        else -> None
    }
}

// An untyped decimal literal is exact Decimal by default
// and adopts the machine carrier only where Float or F32 is expected (Rust
// `Expr::Float` inference), a union slot included when it has no Decimal
// member.
sema_expr_expects_machine_float: fn(expected: Type?) -> Bool Never! {
    if expected == .Val(.Union(members)) -> return sema_expr_union_machine_float(members) != None
    expected == (Val(Type.Float)) || expected == (Val(Type.Float32)) || expected == (Val(sema_dyn_type()))
}

// The machine float a union slot takes for a decimal literal: Float when it
// is a member, else F32; None when the union has neither or takes Decimal.
sema_expr_union_machine_float: fn(members: [Type]) -> Type? Never! {
    float := false
    narrow := false
    loop member in members {
        if member == (Type.Named{name: "Decimal"}) -> return None
        if member == Type.Float -> float = true
        if member == Type.Float32 -> narrow = true
    }
    if float -> return Val(Type.Float)
    if narrow -> return Val(Type.Float32)
    None
}

sema_expr_decimal_literal: fn(text: String, span: Span) -> TExpr Never! {
    spelling: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: text}}}, span)
    sema_tree_node(Type.Named{name: "Decimal"}, TExprKind.PreciseBuiltin{type_name: "Decimal", function: "from_str", args: [TExpr]{spelling}}, span)
}

sema_expr_float_literal: fn(value: Float, is_f32: Bool, raw: String?, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if raw == .Val(text) {
        if !sema_expr_expects_machine_float(expected) -> return sema_expr_expected_owned(sema_expr_decimal_literal(text, span), expected, environment, program, diagnostics)
    }
    ty := Type.Float
    if expected == (Val(Type.Float32)) || (is_f32 && expected != (Val(Type.Float))) -> ty = Type.Float32
    if expected == .Val(.Union(members)) {
        if sema_expr_union_machine_float(members) == .Val(machine) -> ty = machine
    }
    sema_expr_expected_owned(sema_node(context, ty, NodeKind.FloatLit{value: value}, span), expected, environment, program, diagnostics)
}

// The opposite Dyn operand contextualizes a fractional literal without
// rechecking either expression (Decimal variables still do not auto-wrap).
sema_dyn_float_literal_value: fn(expr: Expr) -> Float? Never! {
    if expr == {
        .Float(value, _, is_f32, _, _) -> if is_f32 -> None else -> Val(value)
        .Paren(inner, _, _) -> sema_dyn_float_literal_value(inner)
        .Unary(op, inner, _, _) -> if op == UnOp.Neg -> Val(-(sema_dyn_float_literal_value(inner) ?? return None)) else -> None
        else -> None
    }
}

// Rust `expr_wants_expected_type` for a decimal literal operand. A binary's
// left operand also inherits the surrounding expectation in Rust, so
// `through_binary` follows it for an operand that is itself checked under
// that expectation.
// A loop, not recursion: a left operand chain is as long as its source
// (#6072).
sema_expr_decimal_literal_operand: fn(expr: Expr, through_binary: Bool) -> Bool Never! {
    current := expr
    loop {
        if current == {
            .Paren(inner, _, _) -> current = inner
            .Unary(op, inner, _, _) -> {
                if op != UnOp.Neg -> return false
                current = inner
            }
            .Binary(_, left, _, _, _) -> {
                if !through_binary -> return false
                current = left
            }
            else -> break
        }
    }
    current == .Float(_, _, _, _, _)
}

sema_expr_measurement_type: fn(ty: Type) -> Bool Never! {
    if ty == .Apply(name, _) -> return name == "Measurement"
    false
}

sema_expr_scalable_unit_type: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    sema_expr_unit_fact(ty, environment, program) != None || sema_expr_unit_dimension(ty, environment, program) != None
}

// Rust `known_unit_expr` / `known_measurement_expr` read a name's or field's
// known type, a unit literal, a unit-receiver call, or `measurement(...)`;
// only those right operands are probed.
sema_expr_unit_probe_shape: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Ident(_, _, _) | .Field(_, _, _, _) | .UnitLit(_, _, _, _, _, _, _) -> true
        .Paren(inner, _, _) -> sema_expr_unit_probe_shape(inner)
        .Unary(op, inner, _, _) -> op == UnOp.Neg && sema_expr_unit_probe_shape(inner)
        .MethodCall(receiver, _, _, _, _, _, _) -> receiver == .Ident(_, _, _)
        .Call(call, _) -> call.name == "measurement"
        else -> false
    }
}

// Rust `infer_binary`: the left operand keeps the surrounding expectation,
// and a literal before a measurement (or a unit under `*` or `/`) is Float.
// `decimal`: the left operand is a decimal literal operand
// (sema_expr_decimal_literal_operand through binaries).
sema_expr_decimal_lhs_expected: fn(op: BinOp, decimal: Bool, right: Expr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Type? {
    if !decimal -> return None
    // copy: the left-hand expectation is a new owned Type equal to `expected`, the caller's
    // expectation (a read parameter), which the caller keeps for the right side.
    if sema_expr_expects_machine_float(expected) -> return expected.copy()
    if !sema_expr_unit_probe_shape(right) -> return None
    probe_diagnostics := [Diagnostic]{}
    probed: sema_probe_expression(right, None, environment, program, scopes, state, tail_store, context, probe_diagnostics) ?? return None
    if sema_expr_measurement_type(probed.ty) || ((op == BinOp.Mul || op == BinOp.Div) && sema_expr_scalable_unit_type(probed.ty, environment, program)) -> return Val(Type.Float)
    // A scalar scales a math value by its lane scalar (`2.0 * v`).
    if op == BinOp.Mul || op == BinOp.Div {
        if sema_expr_math_leaf_name(probed.ty) == .Val(math) -> return Val(sema_call_math_scalar_type(math))
    }
    None
}

// Rust `infer_binary`: for arithmetic and comparison a decimal literal on the
// right takes the left operand's type, and Float beside a measurement or a
// scalable unit under `*` or `/`.
sema_expr_decimal_rhs_expected: fn(op: BinOp, lhs: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type? {
    if !sema_expr_same_type_operator(op) -> return None
    if sema_expr_measurement_type(lhs) -> return Val(Type.Float)
    if sema_dyn_is_type(sema_expr_expected_type(lhs, environment, program)) -> return Val(Type.Float)
    if (op == BinOp.Mul || op == BinOp.Div) && sema_expr_scalable_unit_type(lhs, environment, program) -> return Val(Type.Float)
    // A math value scales by its lane scalar (`v * 2.0`).
    if op == BinOp.Mul || op == BinOp.Div {
        if sema_expr_math_leaf_name(lhs) == .Val(math) -> return Val(sema_call_math_scalar_type(math))
    }
    // Any other left type is no Float carrier, so the literal stays Decimal
    // and the operator check reports the pairing.
    if lhs == Type.Float || lhs == Type.Float32 -> return Val(lhs)
    None
}

sema_expr_same_type_operator: fn(op: BinOp) -> Bool Never! {
    op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div || op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Compare || op == BinOp.Lt || op == BinOp.Le || op == BinOp.Gt || op == BinOp.Ge
}

// Rust `expr_wants_expected_type` beyond the decimal literal: an inferred
// struct literal, an untyped typed literal, a contextual enum case (`.Red`,
// `Val(x)`), or a bare `None` needs the surrounding type, which a same-type
// operator takes from its left operand.
sema_expr_wants_expected_form: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(inner, _, _) -> sema_expr_wants_expected_form(inner)
        .Unary(op, inner, _, _) -> op == UnOp.Neg && sema_expr_wants_expected_form(inner)
        .StructLit(_, _, _, _, _, inferred, _, _) -> inferred
        .TypedLit(head, _, _, _) -> head == None
        .EnumLit(type_name, _, _, _, _, _, _) -> type_name == ""
        .Absent(_, _) -> true
        else -> false
    }
}

// Rust passes the left operand's type to such a right operand only as an
// inference hint, then lifts the plain side of `==`/`!=`. An
// optional builder (`Val(x)`, `None`) compared with a plain left operand
// (a flow-refined `x` after `if x == None -> …`) is built at the lifted `T?`.
sema_expr_rhs_hint: fn(op: BinOp, left: Type, right: Expr) -> Type Never! {
    // copy: the right-hand hint is a new owned Type. For a non-equality it equals `left`, the left
    // operand's checked type (a read parameter), which stays on that node.
    if op != BinOp.Eq && op != BinOp.Ne -> return left.copy()
    // copy: the right-hand hint is a new owned Type. For an Option left side it equals `left`, the
    // left operand's checked type (a read parameter), which stays on that node.
    if sema_expr_unwrap_tag(left) == .Option(_) -> return left.copy()
    // copy: the right-hand hint is a new owned Type. Without an optional builder it equals `left`,
    // the left operand's checked type (a read parameter), which stays on that node.
    if !sema_expr_optional_builder(right) -> return left.copy()
    // copy: the Option hint wraps its own copy of `left`, the left operand's checked type (a read
    // parameter), which stays on that node.
    Type.Option{inner: left.copy()}
}

sema_expr_optional_builder: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(inner, _, _) -> sema_expr_optional_builder(inner)
        .Absent(_, _) -> true
        .EnumLit(type_name, variant, _, args, _, _, _) -> type_name == "" && ((variant == "Val" && args.len() == 1) || (variant == "None" && args.len() == 0))
        else -> false
    }
}

sema_expr_missing_operator_hook: fn(op: BinOp, owner: Type, span: Span) -> Diagnostic Never! {
    name: type_name(owner)
    trait_name: sema_expr_operator_trait(op) ?? ""
    sema_error("E0360", span, "no `{sema_expr_binary_name(op)}` operator is defined for `{name}`", "user arithmetic dispatches only through one `impl {name}.{trait_name}` hook", "implement `{name}.{trait_name}`, or call a named method")
}

// E2511: a lane or linalg operator outside its fixed operand shapes.
sema_expr_math_shape_mismatch: fn(op: BinOp, left: Type, right: Type, span: Span) -> Diagnostic Never! {
    left_name: sema_expr_math_leaf_name(left) ?? type_name(left)
    right_name: sema_expr_math_leaf_name(right) ?? type_name(right)
    sema_error("E2511", span, "`{sema_expr_binary_name(op)}` isn't defined between `{left_name}` and `{right_name}`", "built-in lane and linalg operators keep fixed shapes: one lane/vector type on both sides, or a matrix and its matching vector; any other pair needs an operator hook", "match the operand types (`T.splat(x)` lifts a scalar into every lane), call a named method like `.dot()`/`.matmul()`, or implement the operator's hook trait on your own type for this pair")
}

// L0516 (D-HTTP-TEXT1=A): `request.body().text(limit)` with the default
// limit repeats what `request.text()` / `response.text()` already do.
// The default is Core/Http/Http.jet `C_MAX_BODY_BYTES`.
SEMA_HTTP_DEFAULT_TEXT_LIMIT: 1048576

sema_expr_lint_default_body_text: fn(receiver: Expr, receiver_type: Type, args: [CallArg], scopes: SemaScopeTable, diagnostics: &[Diagnostic]) Never! {
    if args.len() != 1 -> return
    start := 0
    if receiver == .MethodCall(owner, receiver_method, _, _, _, _, _) {
        if receiver_method != "body" -> return
        start = expr_span(owner).start
    } else {
        return
    }
    if receiver_type == .Named(name) {
        if sema_call_reflection_leaf_name(name) != "Body" -> return
    } else {
        return
    }
    limit: sema_expr_lint_int_constant(args[0].expr, scopes) ?? return
    if limit != SEMA_HTTP_DEFAULT_TEXT_LIMIT -> return
    span: Span{start: start, end: expr_span(args[0].expr).end + 1}
    diagnostics.push(sema_lint("L0516", span, "The default HTTP body text limit is passed through a lower-level body call", "`request.text()` and `response.text()` already read the body with the same default cap as `body().text({SEMA_HTTP_DEFAULT_TEXT_LIMIT})`", "Replace `body().text({SEMA_HTTP_DEFAULT_TEXT_LIMIT})` with `text()`"))
}

// L0518: `"{x:Fixed(n)}".replace(",", "")` removes grouping separators that
// plain `Fixed(n)` output never has, so the cleanup changes nothing. The AST
// keeps no call-end span, so the edit deletes from the receiver's end through
// the byte after the last argument, the call's `)` as written.
sema_expr_lint_fixed_cleanup: fn(receiver: Expr, receiver_type: Type, args: [CallArg], method_span: Span, diagnostics: &[Diagnostic]) Never! {
    if receiver_type != Type.String || args.len() != 2 -> return
    loop arg in args {
        if arg.label != None || arg.spread -> return
    }
    if !sema_expr_is_string_literal(args[0].expr, ",") || !sema_expr_is_string_literal(args[1].expr, "") -> return
    if receiver == .Str(parts, _, _) {
        if parts.len() != 1 -> return
        if parts[0] == .Interp(_, format) {
            if format == .Fixed(_) {
                lint: sema_lint("L0518", method_span, "Plain `Fixed(n)` output immediately removes grouping separators", "`Fixed(n)` is machine-plain; deleting this cleanup preserves the same text", "Delete `.replace(\",\", \"\")` from the `Fixed(n)` projection")
                diagnostics.push(diagnostic_with_edit(lint, TextEdit{span: Span{start: expr_span(receiver).end, end: expr_span(args[1].expr).end + 1}, new_text: ""}))
            }
        }
    }
}

// L1141: `compute.gradient(f).call(…)` calls the derivative a transform
// returns without naming it; the report covers the transform call. A direct
// form (`compute.gradient(f, w)`) returns values, not a callable.
sema_expr_lint_inline_autodiff: fn(callee: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: &[Diagnostic]) {
    if context.compiler_generated -> return
    if sema_failure_union_unparen(callee) == .MethodCall(owner, member, _, _, _, args, _) {
        if member != "gradient" && member != "value_and_gradient" && member != "vjp" && member != "jvp" -> return
        if args.len() == 0 -> return
        loop (index, argument) in args {
            if index == 0 -> next
            if argument.label == .Val(label) && label.name == "wrt" -> next
            return
        }
        alias: sema_shared_access_without_parens_name(owner) ?? return
        if !sema_expr_core_module_alias_visible(alias, scopes) -> return
        if sema_call_core_import_module(environment, program, alias) != (Val("core.compute")) -> return
        target: sema_shared_access_without_parens_name(args[0].expr) ?? "f"
        span: Span{start: expr_source_start(owner), end: args[args.len() - 1].span.end + 1}
        diagnostics.push(sema_lint("L1141", span, "An autodiff transform result is called inline", "The transform arity returns a callable; inline calls make it unclear whether a direct gradient or a derivative function was requested", "Bind the derivative first, then call the binding: `d_{target}: {alias}.{member}({target})`"))
    }
}

// L0519: `Meter.from_float(value.raw() * 2)` unwraps a linear unit, scales the
// scalar and rewraps the same unit, which `value * 2` says directly. A point of
// an affine family, or a rewrap inside `#Arithmetic`, keeps its explicit form.
sema_expr_lint_unit_scalar_rewrap: fn(receiver: Expr, method: String, args: [CallArg], method_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: &[Diagnostic]) {
    if !method.starts_with("from_") || args.len() != 1 || args[0].label != None || args[0].spread || context.arithmetic_policy != None -> return
    unit_name: sema_shared_access_without_parens_name(receiver) ?? return
    unit: sema_expr_unit_fact(Type.Named{name: unit_name}, environment, program) ?? return
    if unit.kind == QuantityKind.Point -> return
    if sema_failure_union_unparen(args[0].expr) == .Binary(operator, left, right, _, _) {
        if operator != BinOp.Mul && operator != BinOp.Div -> return
        scaled: sema_expr_lint_unit_projection(left, unit.name, environment, program, scopes) && sema_expr_lint_direct_scalar(right)
        if scaled || (operator == BinOp.Mul && sema_expr_lint_direct_scalar(left) && sema_expr_lint_unit_projection(right, unit.name, environment, program, scopes)) {
            diagnostics.push(sema_lint("L0519", method_span, "A policy-free unit unwrap/scale/rewrap can use direct scalar unit arithmetic", "The expression unwraps a linear unit, applies one scalar operation, and immediately rewraps the same unit", "Use `unit * scalar`, `scalar * unit`, or `unit / scalar` directly"))
        }
    }
}

// `name.raw()` where `name` is a binding of the unit `unit_name`.
sema_expr_lint_unit_projection: fn(expr: Expr, unit_name: String, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> Bool {
    if sema_failure_union_unparen(expr) == .MethodCall(inner, method, _, _, _, args, _) {
        if method != "raw" || args.len() != 0 -> return false
        if inner == .Ident(name, _, _) {
            index: sema_scope_resolve_index(scopes, name) ?? return false
            ty: sema_scope_binding_type(environment, scopes, index) ?? return false
            fact: sema_expr_unit_fact(ty, environment, program) ?? return false
            return fact.name == unit_name
        }
    }
    false
}

// A scalar operand that is a literal, a name, a negated literal or
// `Float.from_int` of one, so no call result is folded into the rewrite.
sema_expr_lint_direct_scalar: fn(expr: Expr) -> Bool Never! {
    current := sema_failure_union_unparen(expr)
    loop {
        if current == {
            .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Ident(_, _, _) -> return true
            .Unary(op, inner, _, _) -> {
                if op != UnOp.Neg -> return false
                if sema_failure_union_unparen(inner) == {
                    .Int(_, _, _, _, _) | .Float(_, _, _, _, _) -> return true
                    else -> return false
                }
            }
            .MethodCall(owner, method, _, _, _, args, _) -> {
                if method != "from_int" || args.len() != 1 || sema_shared_access_without_parens_name(owner) != Val("Float") -> return false
                current = sema_failure_union_unparen(args[0].expr)
            }
            else -> return false
        }
    }
}

sema_expr_is_string_literal: fn(expr: Expr, expected: String) -> Bool Never! {
    if expr == .Str(parts, _, _) {
        if parts.len() == 1 && parts[0] == .Lit(text) -> return text == expected
        return parts.len() == 0 && expected == ""
    }
    false
}

// An integer a lint can read without running code: a literal, a sum,
// difference, product or negation of such integers, or a
// `name: comptime { … }` local already folded.
sema_expr_lint_int_constant: fn(expr: Expr, scopes: SemaScopeTable) -> Int? {
    if expr == {
        .Int(value, _, _, raw, _) -> { return Val(sema_expr_exact_integer_literal(value, raw)) }
        .Paren(inner, _, _) -> { return sema_expr_lint_int_constant(inner, scopes) }
        .Unary(op, operand, _, _) -> {
            if op != UnOp.Neg -> return None
            value: sema_expr_lint_int_constant(operand, scopes) ?? return None
            return Val(-value)
        }
        .Binary(op, left, right, _, _) -> {
            if op != BinOp.Add && op != BinOp.Sub && op != BinOp.Mul -> return None
            lhs: sema_expr_lint_int_constant(left, scopes) ?? return None
            rhs: sema_expr_lint_int_constant(right, scopes) ?? return None
            if op == {
                .Add -> return Val(lhs + rhs)
                .Sub -> return Val(lhs - rhs)
                else -> return Val(lhs * rhs)
            }
        }
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(scopes, name) ?? return None
            if scopes.bindings[index].prepared == .Val(known) {
                if known == .Int(value) -> return Val(value)
            }
            return None
        }
        else -> { return None }
    }
}

// L0517 (D-PATH-CONTAINMENT1=A): `child != base && !child.starts_with("{base}/")`
// over the texts of two typed normalized Paths repeats the separator-aware
// lexical containment `Path.is_within()` owns.
sema_expr_lint_path_prefix: fn(op: BinOp, left: Expr, right: Expr, span: Span, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) Never! {
    if op != BinOp.And -> return
    child := ""
    base := ""
    if left == .Binary(left_op, left_child, left_base, _, _) {
        if left_op != BinOp.Ne -> return
        child = sema_expr_lint_ident(left_child)
        base = sema_expr_lint_ident(left_base)
    }
    if child == "" || base == "" -> return
    if right == .Unary(right_op, call, _, _) {
        if right_op != UnOp.Not -> return
        if call == .MethodCall(call_receiver, call_method, _, _, _, call_args, _) {
            if call_method != "starts_with" || call_args.len() != 1 || sema_expr_lint_ident(call_receiver) != child -> return
            if !sema_expr_lint_dir_prefix(call_args[0].expr, base) -> return
        } else {
            return
        }
    } else {
        return
    }
    if !sema_expr_lint_normalized_path_text(child, scopes) || !sema_expr_lint_normalized_path_text(base, scopes) -> return
    diagnostics.push(sema_lint("L0517", span, "A typed normalized Path is checked with a string prefix", "`Path.is_within()` owns separator-aware lexical containment; converting both paths to strings repeats that policy", "Replace the string comparison with `Path.is_within()`"))
}

// `"{base}/"`: the text of `base` followed by one separator.
sema_expr_lint_dir_prefix: fn(expr: Expr, base: String) -> Bool Never! {
    if expr == .Str(parts, _, _) {
        if parts.len() != 2 -> return false
        if parts[0] == .Interp(part, _) {
            if sema_expr_lint_ident(part) != base -> return false
        } else {
            return false
        }
        if parts[1] == .Lit(text) -> return text == "/"
    }
    false
}

sema_expr_lint_ident: fn(expr: Expr) -> String Never! {
    // copy: the name is returned past the read-only `expr` it lives in.
    if expr == .Ident(name, _, _) -> return name.copy()
    ""
}

// Rust `simple_text_operand`: a bare name, looking through parentheses.
sema_expr_simple_text_operand: fn(expr: Expr) -> String Never! {
    if expr == {
        .Paren(inner, _, _) -> return sema_expr_simple_text_operand(inner)
        .Ident(name, _, _) -> return name.copy()
        else -> return ""
    }
}

// Text joined with `+` teaches interpolation (S8).
sema_expr_text_plus: fn(left: Expr, right: Expr, span: Span) -> Diagnostic {
    left_name: sema_expr_simple_text_operand(left)
    right_name: sema_expr_simple_text_operand(right)
    if left_name != "" && right_name != "" {
        return sema_error("E0109", span, "text values `{left_name}` and `{right_name}` aren't joined with `+`", "there's one way to build text: interpolation (S8)", "write the pieces inside one string: \"{{{left_name}}}{{{right_name}}}\"")
    }
    sema_error("E0109", span, "text isn't joined with `+`", "there's one way to build text: interpolation (S8)", "write the pieces inside one interpolated string (schematic: the checked operands are not simple names)")
}

sema_expr_lint_normalized_path_text: fn(name: String, scopes: SemaScopeTable) -> Bool Never! {
    index: sema_scope_resolve_index(scopes, name) ?? return false
    scopes.bindings[index].normalized_path_text
}

// L0532: an integer `/`, `/%`, `%` or `%%` whose divisor is a literal or
// constant-folded zero stops every run with E3010. Only integer operands are
// read; Float, Decimal and unit carriers keep their own zero rules.
sema_expr_lint_zero_divisor: fn(op: BinOp, right: Expr, dividend: Type, divisor: Type, span: Span, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) Never! {
    if op != BinOp.Div && op != BinOp.FloorDiv && op != BinOp.Mod && op != BinOp.Rem -> return
    spelling: if op == {
        .Div -> "/"
        .FloorDiv -> "/%"
        .Mod -> "%"
        else -> "%%"
    }
    if !sema_expr_is_integer(dividend) || !sema_expr_is_integer(divisor) -> return
    value: sema_expr_lint_int_constant(right, scopes) ?? return
    if value != 0 -> return
    diagnostics.push(sema_lint("L0532", span, "This `{spelling}` always divides by zero", "The divisor folds to 0 at compile time, so every run of this line stops with E3010 (divided by zero)", "Divide by a value that can't be zero, or check the divisor and handle zero before dividing"))
}

sema_expr_check_binary: fn(op: BinOp, left: Expr, right: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if left == .Binary(_, _, _, _, _) -> return sema_expr_check_binary_chain(op, left, right, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    sema_expr_lint_path_prefix(op, left, right, span, scopes, diagnostics)
    checked_lhs := sema_check_expression(left, sema_expr_decimal_lhs_expected(op, sema_expr_decimal_literal_operand(left, true), right, expected, environment, program, scopes, state, tail_store, context), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    sema_expr_check_binary_operands(op, left, right, span, expected, checked_lhs, environment, program, scopes, state, tail_store, context, diagnostics)
}

// One inner operator of a left-leaning chain (`a + b + c …`): its Binary
// node and the expectation its value is checked under.
SemaBinaryLevel: struct {
    expr: Expr
    expected: Type?
}

// A left-leaning chain checks in this one frame, not one checking frame per
// operator, so its length is no source nesting and costs no stack (#6072).
// Going down, each level runs its lint and computes its left operand's
// expectation; the innermost left operand is checked; going up, each level
// checks its right operand and operator and files its node as
// sema_check_expression does. That is the order checking level by level
// runs them. Every left operand on the chain shares its innermost one's
// decimal-literal shape, so that walk runs once.
sema_expr_check_binary_chain: fn(op: BinOp, left: Expr, right: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    decimal: sema_expr_decimal_literal_operand(left, true)
    sema_expr_lint_path_prefix(op, left, right, span, scopes, diagnostics)
    levels := [SemaBinaryLevel]{}
    operand_expected := sema_expr_decimal_lhs_expected(op, decimal, right, expected, environment, program, scopes, state, tail_store, context)
    operand := left
    loop {
        if operand == .Binary(level_op, level_left, level_right, level_span, _) {
            sema_expr_lint_path_prefix(level_op, level_left, level_right, level_span, scopes, diagnostics)
            inner_expected: sema_expr_decimal_lhs_expected(level_op, decimal, level_right, operand_expected, environment, program, scopes, state, tail_store, context)
            levels.push(SemaBinaryLevel{expr: operand, expected: operand_expected})
            operand_expected = inner_expected
            operand = level_left
        } else {
            break
        }
    }
    checked := sema_check_expression(operand, operand_expected, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    index := levels.len() - 1
    loop index >= 0 {
        if levels[index].expr == .Binary(level_op, level_left, level_right, level_span, _) {
            value := sema_expr_check_binary_operands(level_op, level_left, level_right, level_span, levels[index].expected, checked, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
            if sema_core_type_uses_default_int(value.ty) -> context.exact_int_reachable = true
            sema_cell_guard_check_construct(levels[index].expr, value.ty, diagnostics)
            sema_check_record_expr_id(levels[index].expr, value, context)
            checked = value.move()
        }
        index -= 1
    }
    sema_expr_check_binary_operands(op, left, right, span, expected, checked, environment, program, scopes, state, tail_store, context, diagnostics)
}

// D-FLOATW1: a float power keeps one width, as an operator or as `a.pow(b)`.
sema_expr_pow_widths_mixed: fn(base: Type, exponent: Type) -> Bool Never! {
    (base == Type.Float && exponent == Type.Float32) || (base == Type.Float32 && exponent == Type.Float)
}

sema_expr_pow_width_mismatch: fn(span: Span) -> Diagnostic {
    sema_error("E0109", span, "`pow` needs both float operands to have the same width", "D-FLOATW1: mixing float widths is not allowed", "convert the operands to the same float width")
}

// A binary operator whose left operand `left` is checked (`checked_left`):
// its right operand and the operator.
sema_expr_check_binary_operands: fn(op: BinOp, left: Expr, right: Expr, span: Span, expected: Type?, checked_left: &&TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked_lhs := checked_left.move()
    rhs_expected := Type?{None}
    if {
        sema_expr_layout_compare_literal(op, checked_lhs.ty, right) -> rhs_expected = Val(Type.Float)
        sema_expr_decimal_literal_operand(right, false) -> rhs_expected = sema_expr_decimal_rhs_expected(op, checked_lhs.ty, environment, program)
        sema_expr_same_type_operator(op) && sema_expr_wants_expected_form(right) -> rhs_expected = Val(sema_expr_rhs_hint(op, checked_lhs.ty, right))
        else -> {}
    }
    if op == BinOp.Eq || op == BinOp.Ne {
        if right == .Ident(bare, bare_span, _) {
            if sema_scope_resolve_index(scopes, bare) == None {
                if sema_pattern_bare_case(checked_lhs.ty, bare, bare_span, environment, program) == .Val(bare_case) {
                    diagnostics.push(bare_case)
                    return None
                }
            }
        }
    }
    checked_rhs: sema_check_expression(right, rhs_expected, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    // A fractional literal before a Dyn operand is a Float, not a Decimal.
    if sema_dyn_is_type(sema_expr_expected_type(checked_rhs.ty, environment, program)) && sema_dyn_float_literal_value(left) == .Val(number) {
        checked_lhs = sema_node(context, Type.Float, NodeKind.FloatLit{value: number}, checked_lhs.span)
    }
    // A value whose type is not optional is never None, so `x == None` /
    // `x != None` would answer the same every time: refused here, before
    // the lift below turns it into an optional comparison (#6122).
    if op == BinOp.Eq || op == BinOp.Ne {
        compared: if {
            sema_expression_absent_none(right) -> Val(checked_lhs.ty)
            sema_expression_absent_none(left) -> Val(checked_rhs.ty)
            else -> Type?{None}
        }
        if compared == .Val(value_ty) {
            if sema_expr_never_none(value_ty) {
                answer: if op == BinOp.Eq -> "false" else -> "true"
                diagnostics.push(sema_error("E0109", span, "only an optional value can be compared with `None`, but this is {sema_type_show(value_ty)}", "a value whose type isn't optional is never None, so this comparison is always {answer}", "remove the comparison, or give the value an optional type such as `{type_name(value_ty)}?` if it can be missing"))
                return None
            }
            // An optional compared with `None` is the presence test
            // (S31 `x == None`, D-FLOWTYPE1 `x != None`): it reads the
            // tag only, so the payload needs no Equatable.
            if sema_expr_unwrap_tag(value_ty) == .Option(_) {
                none_right: sema_expression_absent_none(right)
                none_span: if none_right -> expr_span(right) else -> expr_span(left)
                subject: if none_right -> checked_lhs else -> checked_rhs
                checked_pattern := sema_check_pattern(subject, Pattern.Absent{span: none_span}, TPatternPosition.Arm, false, false, environment, program, scopes, state, tail_store, context, diagnostics)
                checked: checked_pattern.checked ?? return None
                absent: sema_tree_node(Type.Bool, TExprKind.PatternMatches{subject: checked.subject, pattern: checked.pattern}, span)
                if op == BinOp.Eq -> return sema_expr_expected_owned(absent, expected, environment, program, diagnostics)
                return sema_expr_expected_owned(sema_tree_node(Type.Bool, TExprKind.Unary{op: TUnaryOp.Not, operand: absent}, span), expected, environment, program, diagnostics)
            }
        }
    }
    // `x == 5` holds only when the optional `x` holds 5, and
    // `x != 5` is its opposite. The plain side lifts once, so the comparison
    // is the existing optional equality.
    equality := op == BinOp.Eq || op == BinOp.Ne
    lifted_rhs := if equality -> sema_expr_optional_lift(checked_rhs, checked_lhs.ty, checked_rhs.ty, environment, program) else -> None
    lifted_lhs := if equality && lifted_rhs == None -> sema_expr_optional_lift(checked_lhs, checked_rhs.ty, checked_lhs.ty, environment, program) else -> None
    lhs: lifted_lhs ?? checked_lhs
    rhs: lifted_rhs ?? checked_rhs
    if op == BinOp.Pow && sema_expr_pow_widths_mixed(lhs.ty, rhs.ty) {
        diagnostics.push(sema_expr_pow_width_mismatch(span))
        return None
    }
    line: sema_source_line_at(environment.source_segments, span) ?? return None
    // `a.width + 16.0`, `a.right <= b.left`: layout values combine into
    // layout values and compare into a Constraint (E2932 across axes).
    layout: sema_expr_check_layout_binary(op, lhs, rhs, span, line, expected, environment, program, diagnostics)
    if layout.handled -> return layout.value
    if sema_dyn_is_type(sema_expr_expected_type(lhs.ty, environment, program)) || sema_dyn_is_type(sema_expr_expected_type(rhs.ty, environment, program)) {
        if op == BinOp.And || op == BinOp.Or {
            diagnostics.push(sema_dyn_condition_error(span))
            return None
        }
        arithmetic: op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div
        ordering: op == BinOp.Lt || op == BinOp.Le || op == BinOp.Gt || op == BinOp.Ge
        if !arithmetic && !ordering && !equality {
            diagnostics.push(sema_error("E0109", span, "`{sema_expr_binary_name(op)}` is not defined for Dyn", "Dyn supports arithmetic, equality and ordered comparisons only", "use a supported Dyn operator"))
            return None
        }
        dynamic_left: sema_expr_expected(lhs, Val(sema_dyn_type()), environment, program, diagnostics) ?? return None
        dynamic_right: sema_expr_expected(rhs, Val(sema_dyn_type()), environment, program, diagnostics) ?? return None
        ty: if arithmetic -> sema_dyn_type() else -> Type.Bool
        if equality {
            value: sema_tree_node(ty, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: dynamic_left, rhs: dynamic_right}, span)
            return sema_expr_expected_owned(value, expected, environment, program, diagnostics)
        }
        site: "{sema_dyn_site(left)} {sema_expr_binary_name(op)} {sema_dyn_site(right)}"
        location: sema_expression_panic_location(environment, program, scopes, span)
        operation: if arithmetic -> THandleOp.DynBinary{op: sema_expr_binary_name(op), site: site, location: location} else -> THandleOp.DynCompare{op: sema_expr_binary_name(op), site: site, location: location}
        value: sema_tree_node(ty, TExprKind.HandleMethod{receiver: dynamic_left, operation: operation, args: [TExpr]{dynamic_right}}, span)
        return sema_expr_expected_owned(value, expected, environment, program, diagnostics)
    }
    if op == BinOp.And || op == BinOp.Or {
        // Each side of `||`/`&&` is reported at its own span (D-S25-RETIRE1=A).
        if lhs.ty != Type.Bool -> diagnostics.push(sema_error("E0110", lhs.span, "the left side of `{sema_expr_binary_name(op)}` must be {sema_type_show(Type.Bool)}, but this is {sema_type_show(lhs.ty)}", "logic joins yes/no values", "compare the value to something first"))
        if rhs.ty != Type.Bool -> diagnostics.push(sema_error("E0110", rhs.span, "the right side of `{sema_expr_binary_name(op)}` must be {sema_type_show(Type.Bool)}, but this is {sema_type_show(rhs.ty)}", "each side of a logic operator must be a yes/no comparison", "write the full comparison, e.g. `x == 2`"))
        if lhs.ty != Type.Bool || rhs.ty != Type.Bool -> return None
        ty: sema_expr_binary_type(op, lhs.ty, rhs.ty, span, diagnostics) ?? return None
        value: TExpr{ty: ty, kind: TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span: span}
        if sema_expr_expected_keeps(value.ty, expected) -> return Val(value)
        return sema_expr_expected_owned(value, expected, environment, program, diagnostics)
    }

    sema_expr_lint_zero_divisor(op, right, lhs.ty, rhs.ty, span, scopes, diagnostics)
    // `Int / Int` is the exact Fraction quotient; IR stops a zero divisor at
    // the operator (`Fraction.from_parts` names the same parts with no operator).
    if op == BinOp.Div && lhs.ty == Type.Int && rhs.ty == Type.Int {
        value := sema_tree_node(Type.Named{name: "Fraction"}, TExprKind.PreciseBuiltin{type_name: "Fraction", function: "quotient", args: [TExpr]{lhs, rhs}}, span)
        return sema_expr_expected_owned(value, expected, environment, program, diagnostics)
    }
    // (Rust `infer_binary`, E2512): `Matrix * Matrix`
    // matches the left column measure against the right row measure.
    if op == BinOp.Mul && lhs.ty == .Apply(left_head, _) && rhs.ty == .Apply(right_head, _) && left_head == "Matrix" && right_head == "Matrix" {
        left_shape: compute_shape_dimensions(lhs.ty) ?? [Int]{}
        right_shape: compute_shape_dimensions(rhs.ty) ?? [Int]{}
        if left_shape.len() == 2 && right_shape.len() == 2 && left_shape[1] != right_shape[0] {
            diagnostics.push(sema_error("E2512", span, "matrix multiplication needs equal inner sides, but these are {left_shape[1]} and {right_shape[0]}", "the left column measure must match the right row measure", "use `Matrix<{left_shape[0]}, {left_shape[1]}> * Matrix<{left_shape[1]}, {right_shape[1]}>`"))
            return None
        }
    }
    if (sema_expr_measurement_type(lhs.ty) || sema_expr_measurement_type(rhs.ty)) && (op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div) {
        measured_type: Type.Apply{name: "Measurement", args: [Type]{Type.Float}}
        operands := [TExpr]{lhs, rhs}
        loop index in 0..<operands.len() {
            operand := operands[index]
            if operand.ty != Type.Float && sema_expr_numeric_widening_to(operand.ty, Type.Float) != None -> operand = sema_expr_numeric_literal_conversion(operand, Type.Float, span, line, diagnostics) ?? return None
            if operand.ty == Type.Float {
                zero: sema_node(context, Type.Float, NodeKind.FloatLit{value: 0.0}, span)
                operand = sema_expression_measurement_source_call("__measurement_new", [TExpr]{operand, zero}, measured_type, span, environment, program) ?? return None
            }
            if !type_identity_equal(operand.ty, measured_type) {
                _ := sema_expr_binary_type(op, lhs.ty, rhs.ty, span, diagnostics)
                return None
            }
            operands[index] = operand
        }
        function: if op == {
            .Add -> "add"
            .Sub -> "sub"
            .Mul -> "mul"
            else -> "div"
        }
        value: sema_expression_measurement_source_call("__measurement_{function}", operands, measured_type, span, environment, program) ?? return None
        return sema_expr_expected_owned(value, expected, environment, program, diagnostics)
    }
    left_point: if lhs.ty == {.Named(name) -> name.ends_with("::Instant") && core_source_owns_type(name) else -> false}
    right_point: if rhs.ty == {.Named(name) -> name.ends_with("::Instant") && core_source_owns_type(name) else -> false}
    left_delta: lhs.ty == Type.Named{name: "Duration"}
    right_delta: rhs.ty == Type.Named{name: "Duration"}
    point_method := ""
    if {
        op == BinOp.Add && left_point && right_delta -> point_method = "__add"
        op == BinOp.Add && left_delta && right_point -> point_method = "__delta_add"
        op == BinOp.Sub && left_point && right_delta -> point_method = "__subtract"
        op == BinOp.Sub && left_point && right_point -> point_method = "__difference"
        else -> {}
    }
    if point_method != "" {
        arguments: [CallArg]{
            {convention: AccessConvention.Read, expr: left, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false},
            {convention: AccessConvention.Read, expr: right, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
        }
        constructor: Expr.MethodCall{receiver: Expr.Ident{name: "Instant", span: span, id: AST_NODE_GENERATED}, method: point_method, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: arguments, id: AST_NODE_GENERATED}
        return sema_check_expression(constructor, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    if (op == BinOp.Add && left_point && right_point) || (op == BinOp.Sub && left_delta && right_point) {
        diagnostics.push(sema_error("E0127", span, "`{sema_expr_binary_name(op)}` is not available between `{type_name(lhs.ty)}` and `{type_name(rhs.ty)}`", "Time points are positions; only point + delta, point - delta, point - point, and delta + delta are defined", "subtract two Instants for a Duration, or add a Duration to an Instant"))
        return None
    }
    duration := sema_expr_check_duration_binary(op, lhs, rhs, span)
    if duration != None -> return sema_expr_expected(duration ?? lhs, expected, environment, program, diagnostics)
    time := sema_expr_check_time_binary(op, lhs, rhs, span, line)
    if time != None -> return sema_expr_expected(time ?? lhs, expected, environment, program, diagnostics)
    if (lhs.ty == Type.Named{name: "Instant"} && rhs.ty == Type.Named{name: "Instant"} && op == BinOp.Add) || (lhs.ty == Type.Named{name: "Duration"} && rhs.ty == Type.Named{name: "Instant"} && op == BinOp.Sub) {
        diagnostics.push(sema_error("E0127", span, "`{sema_expr_binary_name(op)}` is not available between `{type_name(lhs.ty)}` and `{type_name(rhs.ty)}`", "Time points are positions; only point + delta, point - delta, point - point, and delta + delta are defined", "subtract two Instants for a Duration, or add a Duration to an Instant"))
        return None
    }
    unit_present := sema_expr_unit_fact(lhs.ty, environment, program) != None || sema_expr_unit_fact(rhs.ty, environment, program) != None || sema_expr_unit_dimension(lhs.ty, environment, program) != None || sema_expr_unit_dimension(rhs.ty, environment, program) != None
    unit := sema_expr_check_unit_binary(op, lhs, rhs, span, line, environment, program, scopes, context, diagnostics)
    if unit != None -> return sema_expr_expected(unit ?? lhs, expected, environment, program, diagnostics)
    if unit_present -> return None
    distinct_lhs := sema_expr_distinct_facts(lhs.ty, environment, program, scopes)
    distinct_rhs := sema_expr_distinct_facts(rhs.ty, environment, program, scopes)
    if distinct_lhs != None || distinct_rhs != None {
        distinct := sema_expr_check_distinct_binary(op, lhs, rhs, span, line, distinct_lhs, distinct_rhs, scopes, diagnostics)
        if distinct != None -> return sema_expr_expected(distinct ?? lhs, expected, environment, program, diagnostics)
        return None
    }
    // An exact number (`Decimal`, `Fraction`, `Complex`) mixed with a plain
    // operand (`0 - span / 2`) takes the precise route below, which lifts an
    // integer literal (Rust `infer_binary`); the exact type's own `Sub(Self)`
    // hook does not name the plain operand's type.
    source_operator := false
    core_math_operand := false
    if program.registration_graph == .Val(graph) {
        if (sema_expr_precise_name(lhs.ty) == None) == (sema_expr_precise_name(rhs.ty) == None) {
            left_name: sema_expr_type_base_name(lhs.ty) ?? ""
            right_name: sema_expr_type_base_name(rhs.ty) ?? ""
            caller: sema_scope_caller_row(environment, graph)
            left_core: sema_type_source_owns_nominal(graph, left_name, caller)
            right_core: sema_type_source_owns_nominal(graph, right_name, caller)
            source_operator = left_core || right_core
            core_math_operand = (left_core && sema_expr_math_leaf_name(lhs.ty) != None) || (right_core && sema_expr_math_leaf_name(rhs.ty) != None)
        }
    }
    geometry_present: sema_expr_geometry_is_point(lhs.ty) || sema_expr_geometry_is_delta(lhs.ty) || sema_expr_geometry_is_point(rhs.ty) || sema_expr_geometry_is_delta(rhs.ty)
    if source_operator && sema_expr_operator_trait(op) != None {
        before: diagnostics.len()
        value: sema_expr_check_operator(op, left, right, lhs, rhs, span, expected, environment, program, scopes, state, tail_store, context, diagnostics, line)
        if value != None || diagnostics.len() != before -> return value
        // An exact number with no source hook keeps its built-in exact
        // operations (the precise route below).
        if (op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div) && sema_expr_precise_name(lhs.ty) == None {
            // A Core lane or linalg type keeps its fixed operand shapes.
            if core_math_operand {
                diagnostics.push(sema_expr_math_shape_mismatch(op, lhs.ty, rhs.ty, span))
                return None
            }
            // A Core point or displacement with no hook for this operand
            // pair names its coordinate spaces (E2520 below), not a missing hook.
            if !geometry_present {
                diagnostics.push(sema_expr_missing_operator_hook(op, lhs.ty, span))
                return None
            }
        }
    }
    geometry := sema_expr_check_geometry_binary(op, lhs, rhs, span, line, diagnostics)
    if geometry != None -> return sema_expr_expected(geometry ?? lhs, expected, environment, program, diagnostics)
    if geometry_present -> return None
    // Operator hooks: a same-typed exact number that implements `Comparable`
    // (`Decimal`, `Fraction`) orders through its `compare` method; the
    // arithmetic and equality operators stay on the precise route below.
    if sema_expr_precise_orders_by_compare(op, lhs.ty, rhs.ty) {
        argument: CallArg{convention: AccessConvention.Read, expr: right, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
        call: Expr.MethodCall{receiver: left, method: "compare", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{argument}, id: AST_NODE_GENERATED}
        comparison: sema_check_expression(call, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        if op == BinOp.Compare -> return sema_expr_expected(comparison, expected, environment, program, diagnostics)
        return sema_expr_expected_owned(sema_expr_operator_ordering_test(op, comparison, span, line), expected, environment, program, diagnostics)
    }
    precise := sema_expr_check_precise_binary(op, lhs, rhs, span, line, context, diagnostics)
    if precise != None -> return sema_expr_expected(precise ?? lhs, expected, environment, program, diagnostics)
    if sema_expr_precise_name(lhs.ty) != None || sema_expr_precise_name(rhs.ty) != None {
        return None
    }
    math := sema_expr_check_math_binary(op, lhs, rhs, span, line, diagnostics)
    if math != None -> return sema_expr_expected(math ?? lhs, expected, environment, program, diagnostics)
    math_left := sema_expr_type_base_name(lhs.ty)
    math_right := sema_expr_type_base_name(rhs.ty)
    if (math_left != None && sema_expr_is_math_type_name(math_left ?? "")) || (math_right != None && sema_expr_is_math_type_name(math_right ?? "")) {
        diagnostics.push(sema_expr_math_shape_mismatch(op, lhs.ty, rhs.ty, span))
        return None
    }
    if sema_expr_has_numeric_overload(lhs.ty) || sema_expr_has_numeric_overload(rhs.ty) {
        before: diagnostics.len()
        operator_value := sema_expr_check_operator(op, left, right, lhs, rhs, span, expected, environment, program, scopes, state, tail_store, context, diagnostics, line)
        // A hook that recurses through its own operator (E0361) has no
        // missing hook to report as well.
        if operator_value != None || diagnostics.len() != before -> return operator_value
    }
    comparison := sema_comparability_check_binary(op, lhs, rhs, span, line, environment, program, diagnostics)
    if comparison.handled {
        compared: comparison.value ?? return None
        return sema_expr_expected(compared, expected, environment, program, diagnostics)
    }
    if (op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div) && (sema_expr_has_numeric_overload(lhs.ty) || sema_expr_has_numeric_overload(rhs.ty)) {
        // Only a named left operand owns a missing hook (E0360); a built-in
        // left operand (`2 - debt`) has no rule for the pair (E0109).
        if lhs.ty == {
            .Named(_) -> diagnostics.push(sema_expr_missing_operator_hook(op, lhs.ty, span))
            else -> diagnostics.push(sema_expr_op_mismatch(op, lhs.ty, rhs.ty, span))
        }
        return None
    }

    effective_lhs := lhs
    effective_rhs := rhs
    target := Type?{None}
    if {
        op == BinOp.Shl || op == BinOp.Shr -> {
            if sema_expr_is_integer(lhs.ty) && sema_expr_is_integer(rhs.ty) && (!type_identity_equal(lhs.ty, rhs.ty) || sema_expr_numeric_base(lhs.ty) != lhs.ty || sema_expr_numeric_base(rhs.ty) != rhs.ty) {
                target = Val(sema_expr_numeric_base(lhs.ty))
            }
        }
        op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div || op == BinOp.FloorDiv || op == BinOp.Pow || op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Compare || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge -> {
            target = sema_expr_numeric_join_values(lhs, rhs)
        }
        op == BinOp.Mod || op == BinOp.Rem || op == BinOp.BitAnd || op == BinOp.BitOr || op == BinOp.BitXor -> {
            if sema_expr_is_integer(lhs.ty) && sema_expr_is_integer(rhs.ty) -> target = sema_expr_numeric_join_values(lhs, rhs)
        }
    }
    if target != None {
        target_type := sema_expr_numeric_base(target ?? lhs.ty)
        effective_lhs = sema_expr_numeric_literal_conversion(lhs, target_type, span, line, diagnostics) ?? return None
        effective_rhs = sema_expr_numeric_literal_conversion(rhs, target_type, span, line, diagnostics) ?? return None
    }
    if (op == BinOp.Shl || op == BinOp.Shr) && (!sema_expr_is_integer(effective_lhs.ty) || !sema_expr_is_integer(effective_rhs.ty)) {
        sema_expr_binary_type(op, effective_lhs.ty, effective_rhs.ty, span, diagnostics) ?? return None
        return None
    }
    if op == BinOp.Pow && effective_lhs.ty == Type.Int && effective_rhs.ty == Type.Int && sema_expr_written_negative_integer(right) {
        exact: sema_expr_negative_int_power(effective_lhs, effective_rhs, line, span)
        return sema_expr_expected_owned(exact, expected, environment, program, diagnostics)
    }
    if op == BinOp.Add && effective_lhs.ty == Type.String {
        diagnostics.push(sema_expr_text_plus(left, right, span))
        return None
    }
    ty: sema_expr_binary_type(op, effective_lhs.ty, effective_rhs.ty, span, diagnostics) ?? return None
    if (op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Pow) && ty == .IntN(_, _) && context.arithmetic_policy == .Val(policy) {
        operation: if op == {
            .Add -> ArithmeticOperation.Add
            .Sub -> ArithmeticOperation.Sub
            .Mul -> ArithmeticOperation.Mul
            else -> ArithmeticOperation.Pow
        }
        policed: sema_expr_arithmetic_policy_value(policy, operation, ty, span, line, effective_lhs, effective_rhs)
        if sema_expr_expected_keeps(policed.ty, expected) -> return Val(policed)
        return sema_expr_expected_owned(policed, expected, environment, program, diagnostics)
    }
    overflow := false
    if (op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div) && (sema_expr_is_integer(effective_lhs.ty) || sema_expr_is_integer(effective_rhs.ty)) -> overflow = true
    if op == BinOp.Pow && sema_expr_is_integer(effective_lhs.ty) -> overflow = true
    if (op == BinOp.Shl || op == BinOp.Shr) && sema_expr_is_integer(effective_lhs.ty) -> overflow = true
    // Built and kept in place (sema_tree_expr and sema_expr_expected copy
    // their borrowed value, and with it both operand trees, at every level).
    value: TExpr{ty: ty, kind: TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: overflow, line: line, lhs: effective_lhs, rhs: effective_rhs}, span: span}
    if sema_expr_expected_keeps(value.ty, expected) -> return Val(value)
    sema_expr_expected(value, expected, environment, program, diagnostics)
}

sema_expr_reject_unlowered: fn(span: Span, diagnostics: &[Diagnostic]) -> TExpr? {
    diagnostics.push(sema_error("E0119", span, "this expression has no dependency-closed checked-tree lowering yet", "the checker refuses to invent a successful type or discard expression metadata", "use a supported expression form in this checker path"))
    None
}

sema_expr_copy_string_view: fn(value: Expr, scopes: &SemaScopeTable) -> Bool Never! {
    if value == {
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(scopes, name) ?? return false
            return scopes.bindings[index].string_view
        }
        .Paren(inner, _, _) -> return sema_expr_copy_string_view(inner, scopes)
        else -> false
    }
}

// `share`: a share site (sema_expr_check_shared_identifier),
// whose copy IR records with the Share fact, not the authored `.copy()`.
sema_expr_check_copy_typed: fn(checked: TExpr, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, context: &SemaCheckContext, diagnostics: &[Diagnostic], string_view: Bool, share: Bool) -> TExpr? {
    facts := sema_copy_classify(checked.ty, SemaCopyIntent.Explicit, environment, program, context.generic_params, string_view)
    effect_name := sema_copy_effect_name(facts)
    if effect_name != None -> context.copy_events.push(SemaCopyEvent{span: span, facts: facts})
    if !facts.accepted {
        // Rust `Expr::Copy` reports E0211 and keeps the copy's type, so the
        // binding it initializes still opens its views (E0212).
        report: sema_copy_diagnostic(facts, span) ?? {
            sema_check_unsupported(context, "the copy of `{type_name(checked.ty)}` at offset {span.start} has incomplete copy facts")
            return None
        }
        diagnostics.push(report)
        ty: checked.ty
        return sema_expr_expected_owned(sema_tree_expr(ty, TExprKind.ExplicitCopy{value: checked}, span), expected, environment, program, diagnostics)
    }
    if sema_copy_memory_operation(facts) != None && effect_name == None -> context.copy_events.push(SemaCopyEvent{span: span, facts: facts})
    result_kind := if share -> TExprKind.Clone{value: checked, fact: CopyFact.Share} else -> TExprKind.ExplicitCopy{value: checked}
    if facts.lowering == {
        .Clone -> result_kind = TExprKind.Clone{value: checked, fact: if share -> CopyFact.Share else -> CopyFact.Explicit}
        .MaterializeView -> result_kind = TExprKind.MaterializeView{value: checked}
        else -> {}
    }
    sema_expr_expected_owned(sema_tree_expr(facts.target, result_kind, span), expected, environment, program, diagnostics)
}

sema_expr_check_copy: fn(value: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    previous_borrow := context.borrow_ctx
    previous_string_view_read := context.allow_string_view_read
    context.borrow_ctx = true
    context.allow_string_view_read = true
    checked_value := sema_check_expression(value, None, environment, program, scopes, state, tail_store, context, diagnostics)
    context.borrow_ctx = previous_borrow
    context.allow_string_view_read = previous_string_view_read
    checked: checked_value ?? return None
    // Rust expr.rs `Expr::Copy`: copying a value that holds an observable
    // Clock reads ambient time (E3403 `Clock copy` in a pure body).
    if sema_copy_observable_clock(checked.ty, environment, program, context.generic_params) {
        _ := sema_effect_record_intrinsic_effects(environment, program, scopes, context, "Clock copy", span, [EffectRowEntry]{EffectRowEntry{name: "Time", span: span}}, diagnostics)
    }
    window_copy: sema_call_compute_window_copy(checked, span, expected, environment, program, diagnostics)
    if window_copy.handled -> return window_copy.value
    sema_expr_check_copy_typed(checked, span, expected, environment, program, context, diagnostics, sema_expr_copy_string_view(value, scopes), false)
}

// An unmarked move site that a later use reached is a
// share. It checks like the authored copy `name.copy()`; IR records it as a Share
// copy, the clone the checked-tree read paths can elide like any sema-inserted copy.
sema_expr_check_shared_identifier: fn(name: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    previous_borrow := context.borrow_ctx
    previous_string_view_read := context.allow_string_view_read
    context.borrow_ctx = true
    context.allow_string_view_read = true
    checked_value := sema_expr_check_identifier(name, span, None, environment, program, scopes, state, context, diagnostics)
    context.borrow_ctx = previous_borrow
    context.allow_string_view_read = previous_string_view_read
    checked: checked_value ?? return None
    sema_expr_check_copy_typed(checked, span, expected, environment, program, context, diagnostics, sema_expr_copy_string_view(Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}, scopes), true)
}

// A raw pointer operation is a low-level memory operation: outside an
// audited region it is E3101 (E3103 is the call of an `#Unsafe fn`).
sema_expr_require_unsafe: fn(operation: String, span: Span, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if context.unsafe_depth > 0 -> return true
    diagnostics.push(sema_error("E3101", span, "`{operation}` can only run inside an `#Unsafe` block", "this operation can violate memory safety, so it must sit in an audited region", "wrap it: #Unsafe(\"why this is safe\") {{ … }}"))
    false
}

sema_expr_core_import_module: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, alias: String) -> String? {
    if program.registration_graph == .Val(graph) {
    module_index: sema_scope_caller_index(environment, graph) ?? return None
    imports: sema_core_registration_imports(graph.modules[module_index])
    imported: sema_core_import_find(imports, alias) ?? return None
    target := sema_registration_module_index(graph, imported.module_name)
    if target != None {
        index: target ?? return None
        return Val(graph.modules[index].module_name)
    }
    return Val(imported.module_name)
    }
    None
}

sema_expr_check_pointer_from_address: fn(alias: String, alias_span: Span, element: Type, address: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if sema_expr_core_import_module(environment, program, alias) != (Val("core.mem")) {
        diagnostics.push(sema_error("E3102", alias_span, "`Ptr` is part of the low-level tier", "naming `Ptr`, `volatile_read`, or an allocator needs the discovery gate", "add `use core.mem;` and call through `{alias}.…`"))
        _ := sema_check_expression(address, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    forbidden := context.unsafe_depth == 0
    if forbidden {
        diagnostics.push(sema_error("E3101", span, "`from_addr` can only run inside an `#Unsafe` block", "this operation can violate memory safety, so it must sit in an audited region", "wrap it: #Unsafe(\"why this is safe\") {{ … }}"))
    }
    checked: sema_check_expression(address, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    valid_address := if checked.ty == {
        .Int | .InlineRange(_, _, _) -> true
        else -> false
    }
    if !valid_address {
        diagnostics.push(sema_error("E0112", expr_span(address), "`from_addr` needs an Int address, not {type_name(checked.ty)}", "a pointer is built from a numeric machine address", "pass an Int, e.g. from `mem.address_of(x)`"))
        return None
    }
    if forbidden -> return None
    pointer := Type.Apply{name: "Ptr", args: [Type]{element}}
    sema_expr_expected_owned(sema_tree_node(pointer, TExprKind.PtrFromAddr{address: checked, element: element}, span), expected, environment, program, diagnostics)
}

sema_expr_check_comptime_name: fn(name: String, span: Span, embedded: CtValue?, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if embedded == .Val(value) {
        if value == .Int(number) {
            literal: sema_expr_int_literal_tree(number, Type.Int, None, span, environment, program) ?? return None
            return sema_expr_expected_owned(literal, expected, environment, program, diagnostics)
        }
        ty := sema_expr_expected_type(ast_comptime_value_type(value), environment, program)
        if value == .Bool(flag) -> return sema_expr_expected_owned(sema_node(context, ty, NodeKind.BoolLit{value: flag}, span), expected, environment, program, diagnostics)
        if value == .Unit -> return sema_expr_expected_owned(sema_node(context, ty, NodeKind.Unit, span), expected, environment, program, diagnostics)
        if value == .Char(character) {
            code: sema_checked_const_char("{character}") ?? return None
            return sema_expr_expected_owned(sema_node(context, ty, NodeKind.CharLit{value: code}, span), expected, environment, program, diagnostics)
        }
        if value == .Float(float_value) {
            bits: if float_value == {
                .F32(number) | .F64(number) -> number
            }
            return sema_expr_expected_owned(sema_node(context, ty, NodeKind.FloatLit{value: bits}, span), expected, environment, program, diagnostics)
        }
        kind := if value == {
            .Str(text) -> TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: text}}}
            .Enum(type_name, variant, args) -> if args.len() == 0 -> TExprKind.EnumLit{enum_type: type_name, variant: variant, payload: TEnumPayload.Unit} else -> TExprKind.CtLit{value: sema_checked_comptime(value) ?? return None}
            else -> TExprKind.CtLit{value: sema_checked_comptime(value) ?? return None}
        }
        return sema_expr_expected_owned(sema_tree_expr(ty, kind, span), expected, environment, program, diagnostics)
    }
    if sema_scope_resolve_index(scopes, name) == None {
        if scopes.comptime_execution_depth == 0 -> diagnostics.push(sema_unknown_name_in(name, span, scopes))
        return None
    }
    sema_expr_check_identifier(name, span, expected, environment, program, scopes, state, context, diagnostics)
}

// An expected nominal type that implements `Literal.Int` or `Literal.Float`
// takes an unsuffixed literal through its compile-time `from_literal` hook:
// the Int itself, or a Float's written digits as text so no rounding happens.
sema_expr_contextual_literal: fn(expr: Expr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Expr? {
    target: expected ?? return None
    type_name := ""
    owner_type_args := [Type]{}
    if target == {
        .Named(name) -> type_name = name
        .Apply(name, args) -> {
            type_name = name
            owner_type_args = args
        }
        else -> return None
    }
    span: expr_span(expr)
    argument := expr
    if expr == {
        .Int(_, _, width, _, _) -> {
            if width != None || !sema_expr_has_literal_hook(environment, program, target, "Literal.Int") -> return None
        }
        .Float(value, _, is_f32, raw, _) -> {
            if is_f32 || !sema_expr_has_literal_hook(environment, program, target, "Literal.Float") -> return None
            argument = Expr.Str{parts: [StrPart]{StrPart.Lit{text: raw ?? "{value}"}}, span: span, id: AST_NODE_GENERATED}
        }
        else -> return None
    }
    receiver: Expr.Ident{name: type_name, span: span, id: AST_NODE_GENERATED}
    call_args: [CallArg]{CallArg{convention: AccessConvention.Read, expr: argument, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}}
    Val(Expr.MethodCall{receiver: receiver, method: "from_literal", method_span: span, owner_type_args: owner_type_args, type_args: [Type]{}, args: call_args, id: AST_NODE_GENERATED})
}

// A `impl T.Literal.Int` / `impl T.Literal.Float` capability of the nominal
// `ty`, or an `impl Literal.Int` block in its body, read by the written
// trait name.
sema_expr_has_literal_hook: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type, capability: String) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
        row: sema_type_resolve_nominal_row_at(graph, ty, sema_scope_caller_row(environment, graph)) ?? return false
        key: graph.modules[row.module_index].nominals[row.row].identity_key
        loop module_index in 0..<graph.modules.len() {
            loop impl_index in 0..<graph.modules[module_index].impls.len() {
                if graph.modules[module_index].impls[impl_index].target_identity_key != key -> next
                if (graph.modules[module_index].impls[impl_index].declaration.trait_name ?? "") == capability -> return true
            }
        }
        if graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
            loop block in sema_registration_item_trait_blocks(item) {
                if block.trait_name == capability -> return true
            }
        }
    }
    false
}

// An unconstrained goal continues as Int, but its goal row's card still says
// "(unknown)". Consumers read the function's checked goal rows, never infer a
// type from the source spelling. `line` is the goal's source line, which its
// E3011 stop names.
sema_expression_todo: fn(expected: Type?, span: Span, line: Int, context: &SemaCheckContext) -> TExpr? Never! {
    card: if expected == .Val(ty) -> type_name(ty) else -> "(unknown)"
    context.typed_goals.push(TTypedGoal{span: span, expected: card})
    Val(sema_node(context, expected ?? Type.Int, NodeKind.Never{reason: "todo", line: line}, span))
}

// One expression level. Every recursive check passes through this frame, so
// it holds only the common forms, each one call; the rest check in
// sema_check_expression_cold, and the multi-step forms in their own helpers,
// so their locals live in frames only those forms enter.
sema_check_expression_inner: fn(expr: Expr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    return if expr == {
        .Int(value, span, width, raw, _) -> {
            if sema_expr_contextual_literal(expr, expected, environment, program) == .Val(hooked) -> return sema_check_expression(hooked, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            sema_expr_integer_literal(sema_expr_exact_integer_literal(value, raw), width, expected, span, environment, program, diagnostics)
        }
        .Float(value, span, is_f32, raw, _) -> {
            if sema_expr_contextual_literal(expr, expected, environment, program) == .Val(hooked) -> return sema_check_expression(hooked, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            sema_expr_float_literal(value, is_f32, raw, span, expected, environment, program, context, diagnostics)
        }
        .Bool(value, span, _) -> sema_expr_expected_owned(sema_node(context, Type.Bool, NodeKind.BoolLit{value: value}, span), expected, environment, program, diagnostics)
        .Unit(span, _) -> sema_expr_expected_owned(sema_node(context, Type.Named{name: "Unit"}, NodeKind.Unit, span), expected, environment, program, diagnostics)
        .Str(parts, span, _) -> sema_expr_check_string(parts, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Ident(name, span, _) -> if sema_ownership_is_share_site(state, span) -> sema_expr_check_shared_identifier(name, span, expected, environment, program, scopes, state, context, diagnostics) else -> sema_expr_check_identifier(name, span, expected, environment, program, scopes, state, context, diagnostics)
        .Paren(value, span, _) -> sema_expr_check_paren(value, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Unary(op, operand, span, _) -> sema_expr_check_unary(op, operand, expected, span, environment, program, scopes, state, tail_store, context, diagnostics)
        .Binary(op, left, right, span, _) -> sema_expr_check_binary(op, left, right, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Call(call, _) -> sema_expr_check_call_expr(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, _) -> sema_expr_check_method_call_expr(receiver, method, method_span, owner_type_args, type_args, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .ListLit(elements, span, _) -> sema_expr_check_list_literal(elements, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Range(start, end, exclusive, span, _) -> sema_expression_range(start, end, exclusive, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Index(base, index, span, kind, _) -> sema_expression_index(base, index, kind, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Field(base, member, span, _) -> sema_expression_field(expr, base, member, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Place(value, access, span, _) -> sema_expr_check_place_expr(expr, value, access, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .TypedLit(head, body, span, _) -> sema_expression_typed_literal(head, body, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .StructLit(type_name, type_args, _, as_trait, fields, inferred, span, _) -> sema_expression_struct_literal(type_name, type_args, fields, inferred, as_trait, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .EnumLit(type_name, variant, variant_span, args, leading_dot, span, _) -> sema_expression_enum_literal(type_name, [Type]{}, variant, args, leading_dot, variant_span, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Ok(value, span, _) -> sema_expression_result_payload(value, true, false, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Err(value, span, _) -> sema_expr_check_err_literal(value, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .CompareChain(operands, ops, hooks, span, _) -> sema_expression_compare_chain(operands, ops, hooks, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .OrFallback(value, fallback, _, span, _) -> sema_expression_or_fallback(value, fallback, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Try(value, span, conversion, note, _) -> sema_expression_try(value, span, conversion, note, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .If(condition, then_body, then_value, else_body, else_value, span, _) -> sema_expression_if(condition, then_body, then_value, else_body, else_value, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Lambda(lambda, _) -> sema_expression_lambda(lambda, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .PatternTest(subject, pattern, span, _) -> sema_expr_check_pattern_test(subject, pattern, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        else -> sema_check_expression_cold(expr, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
}

// The less common expression forms (sema_check_expression_inner).
sema_check_expression_cold: fn(expr: Expr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    return if expr == {
        .Absent(span, _) -> sema_expression_absent(span, expected, context, diagnostics)
        .Char(value, span, _) -> sema_expression_char(value, span, expected, environment, program, context, diagnostics)
        .StrMatchLit(_, span, _) -> {
            diagnostics.push(sema_error("E0112", span, "a pattern literal is only valid as a `take_pattern` argument", "this string has typed holes (`{{name:Type}}`), which only `take_pattern` understands", "call it as `cursor.take_pattern(\"…\")`, or drop the `:Type` for an ordinary interpolated string"))
            None
        }
        .BinMatchLit(_, span, _) -> {
            diagnostics.push(sema_error("E0112", span, "a binary pattern literal is only valid as a `take_pattern` argument", "this `[U8].{{\"…\"}}` literal has typed holes (`{{name:U<width>}}`), which only `take_pattern` understands", "call it as `reader.take_pattern([U8].{{\"…\"}})`"))
            None
        }
        .UnitLit(raw, int_value, float_value, suffix, suffix_span, span, _) -> sema_expression_unit_literal(raw, int_value, float_value, suffix, suffix_span, span, expected, environment, program, scopes, context, diagnostics)
        .Ident(name, span, _) -> if sema_ownership_is_share_site(state, span) -> sema_expr_check_shared_identifier(name, span, expected, environment, program, scopes, state, context, diagnostics) else -> sema_expr_check_identifier(name, span, expected, environment, program, scopes, state, context, diagnostics)
        .ComptimeName(name, span, value, _) -> sema_expr_check_comptime_name(name, span, value, expected, environment, program, scopes, state, context, diagnostics)
        .Paren(value, span, _) -> {
            checked: sema_check_expression(value, expected, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
            return Val(TExpr{ty: checked.ty, kind: checked.kind, span: span})
        }
        .Unary(op, operand, span, _) -> sema_expr_check_unary(op, operand, expected, span, environment, program, scopes, state, tail_store, context, diagnostics)
        .Binary(op, left, right, span, _) -> sema_expr_check_binary(op, left, right, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Call(call, _) -> {
            if sema_expression_contextual_result_call(call, expected, scopes) == .Val(success) {
                payload: sema_expression_result_call_payload(call, state, scopes)
                span: Span{start: call.name_span.start, end: expr_span(payload).end}
                if !success -> context.failure_edges.push("")
                return sema_expression_result_payload(payload, success, sema_expression_result_call_takes_field(call, state, scopes), span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            }
            sema_expr_check_direct_call(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        .CallValue(callee, args, span, _) -> sema_expr_check_indirect_call(callee, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .ListLit(elements, span, node) -> {
            expanded := sema_expression_list_member_spreads(elements)
            sema_expression_list(Expr.ListLit{elements: expanded, span: span, id: node}, expanded, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        .MapLit(entries, span, _) -> sema_expression_map(expr, entries, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .TupleLit(fields, span, _, _) -> sema_expression_tuple(fields, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Range(start, end, exclusive, span, _) -> sema_expression_range(start, end, exclusive, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Index(base, index, span, kind, _) -> sema_expression_index(base, index, kind, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Slice(base, start, end, range, span, _) -> sema_expression_slice(base, start, end, range, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Field(base, member, span, _) -> sema_expression_field(expr, base, member, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .OptField(base, member, member_span, _, span, _) -> sema_expression_optional_field(base, member, member_span, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .OptMethodCall(receiver, method, method_span, type_args, args, span, _) -> sema_expression_optional_method_call(receiver, method, method_span, type_args, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Deref(value, span, _) -> sema_expression_deref(value, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Place(value, access, span, _) -> {
            if scopes.ownership_call_depth == 0 && !sema_ownership_check_expression(state, expr, scopes, diagnostics) -> return None
            sema_expression_place(value, access, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        .TypedLit(head, body, span, _) -> sema_expression_typed_literal(head, body, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .StructLit(type_name, type_args, _, as_trait, fields, inferred, span, _) -> sema_expression_struct_literal(type_name, type_args, fields, inferred, as_trait, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .EnumLit(type_name, variant, variant_span, args, leading_dot, span, _) -> sema_expression_enum_literal(type_name, [Type]{}, variant, args, leading_dot, variant_span, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Present(value, span, _) -> sema_expression_present(value, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Ok(value, span, _) -> sema_expression_result_payload(value, true, false, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Err(value, span, _) -> {
            // #3708: an `Err` written anywhere in the body (callbacks too) is
            // a failure source of its own; the empty key never resolves.
            context.failure_edges.push("")
            sema_expression_result_payload(value, false, false, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        .CompareChain(operands, ops, hooks, span, _) -> sema_expression_compare_chain(operands, ops, hooks, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .OrFallback(value, fallback, _, span, _) -> sema_expression_or_fallback(value, fallback, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Try(value, span, conversion, note, _) -> sema_expression_try(value, span, conversion, note, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .If(condition, then_body, then_value, else_body, else_value, span, _) -> sema_expression_if(condition, then_body, then_value, else_body, else_value, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Lambda(lambda, _) -> sema_expression_lambda(lambda, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Todo(span, _, _) -> sema_expression_todo(expected, span, sema_source_line_at(environment.source_segments, span) ?? 0, context)
        .NoElse(span, _) -> Val(sema_node(context, expected ?? Type.Named{name: "Never"}, NodeKind.Never{reason: "no else arm", line: 0}, span))
        .RawOf(value, span, _) -> {
            forbidden := context.unsafe_depth == 0
            if forbidden {
                diagnostics.push(sema_error("E0208", span, "taking a raw pointer requires `#Unsafe`", "`*x` takes a raw pointer to `x`; that is a raw memory operation, only valid inside a `#Unsafe {{ … }}` region", "wrap this in `#Unsafe(\"why this is safe\") {{ … }}` — to dereference a pointer use postfix `p.*`"))
            }
            checked: sema_check_expression(value, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
            if forbidden -> return None
            pointer := Type.Apply{name: "Ptr", args: [Type]{checked.ty}}
            sema_expr_expected_owned(sema_tree_node(pointer, TExprKind.RawOf{value: checked}, span), expected, environment, program, diagnostics)
        }
        .PtrFromAddr(alias, alias_span, element, address, span, _) -> sema_expr_check_pointer_from_address(alias, alias_span, element, address, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Tainted(value, tag_value, span, _) -> {
            if tag_value != None && !sema_taint_validate_tag(tag_value, environment, program, span, diagnostics) -> return None
            sema_check_expression(value, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        .Copy(value, span, _) -> sema_expr_check_copy(value, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        .Spread(_, span, _) -> sema_expr_reject_unlowered(span, diagnostics)
        .MemberSpread(base, members, span, _) -> {
            fields := sema_expression_member_spread_fields(base, members, span)
            sema_expression_list(Expr.ListLit{elements: fields, span: span, id: AST_NODE_GENERATED}, fields, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        else -> None
    }
}

sema_expr_check_paren: fn(value: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked: sema_check_expression(value, expected, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    Val(TExpr{ty: checked.ty, kind: checked.kind, span: span})
}

sema_expr_check_call_expr: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if sema_expression_contextual_result_call(call, expected, scopes) == .Val(success) {
        payload: sema_expression_result_call_payload(call, state, scopes)
        span: Span{start: call.name_span.start, end: expr_span(payload).end}
        if !success -> context.failure_edges.push("")
        return sema_expression_result_payload(payload, success, sema_expression_result_call_takes_field(call, state, scopes), span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    sema_expr_check_direct_call(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_expr_check_method_call_expr: fn(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    // `expect(value).snapshot()` is the snapshot assertion builtin, unless a
    // local or function named `expect` shadows it.
    if method == "snapshot" && receiver == .Call(call, _) {
        if call.name == "expect" && sema_call_gate_is_unshadowed(call.name, scopes) -> return sema_call_check_expect_snapshot(call, args, type_args, method_span, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    // `value.copy()` with no arguments is the
    // compiler-owned copy, resolved before ordinary method lookup so
    // no type can redefine it; a type receiver keeps associated
    // lookup (Rust `copy_receiver_names_type`). The copy spans its receiver
    // through the method name.
    if method == "copy" && args.len() == 0 && type_args.len() == 0 && !sema_expr_copy_receiver_names_type(receiver, owner_type_args, scopes) {
        return sema_expr_check_copy(receiver, Span{start: expr_source_start(receiver), end: method_span.end}, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    // D-COPY-MOVE-SPELL1=A: `value.move()` with no arguments is the
    // compiler-owned take of a named place. A name or a
    // field moves out of its owner; an element stays owned by its collection
    // and a fresh value has no place to give up (E0225). A receiver naming a
    // module, an import, or a type keeps its member lookup (`files.move`).
    if method == "move" && args.len() == 0 && type_args.len() == 0 && sema_expr_move_receiver_names_value(receiver, owner_type_args, scopes) {
        moved_span: Span{start: expr_source_start(receiver), end: method_span.end}
        if receiver == {
            .Ident(_, _, _) | .Field(_, _, _, _) -> {
                return sema_check_expression(Expr.Place{value: receiver, access: PlaceAccess.Take, span: moved_span, id: AST_NODE_GENERATED}, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            }
            else -> {}
        }
        diagnostics.push(sema_error("E0225", moved_span, "`.move()` takes a named place, not this value", "`.move()` moves a name or one of its fields out of its owner; an element stays owned by its collection, and a call result or literal is already new", "move the whole collection or name, or drop `.move()` from a fresh value"))
        return None
    }
    // A writing call on a place inside a shared cell edits the stored value
    // through the cell's locked-edit callback, not a read copy of the place.
    // Whatever a writing call stores into a cell must not close a strong
    // cycle; that check runs once the call's references are recorded.
    written_place: sema_stmt_binding_is_write_place(receiver)
    if written_place {
        if sema_shared_access_call_place(receiver, method_span, environment, program, scopes) == .Val(cell) {
            rewritten: sema_shared_access_desugar_place_call(cell.handle, cell.place, cell.place_span, method, method_span, owner_type_args, type_args, args, cell.span)
            edited: sema_check_expression(rewritten, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            if receiver == .Place(value, _, _, _) -> sema_shared_cycle_check_call(value, args, environment, program, scopes, state, diagnostics)
            return edited
        }
    }
    // D-CALLSITE-MARK2=A: an unmarked place inside a shared cell is edited
    // through the cell when the resolved method writes its receiver, as
    // `cell.place.method()` was. The built place spans its value, so it
    // carries no written mark.
    if !written_place && sema_receiver_mark_place_root(receiver) != None {
        place: Expr.Place{value: receiver, access: PlaceAccess.Write, span: expr_span(receiver), id: AST_NODE_GENERATED}
        if sema_shared_access_call_place(place, method_span, environment, program, scopes) == .Val(cell) {
            if sema_expr_shared_place_call_writes(receiver, method, method_span, owner_type_args, type_args, args, environment, program, scopes, state, tail_store, context) {
                rewritten: sema_shared_access_desugar_place_call(cell.handle, cell.place, cell.place_span, method, method_span, owner_type_args, type_args, args, cell.span)
                edited: sema_check_expression(rewritten, expected, environment, program, scopes, state, tail_store, context, diagnostics)
                sema_shared_cycle_check_call(receiver, args, environment, program, scopes, state, diagnostics)
                return edited
            }
        }
    }
    // Check the ordinary unmarked call inside a receiver frame, which records
    // the receiver's resolved convention for the shared-place probe above.
    unmarked: sema_receiver_mark_begin(state, receiver)
    fixed_over: sema_stmt_uninit_fixed_over_take(receiver, method, args, state, scopes)
    checked := sema_expr_check_method_call(unmarked, method, method_span, owner_type_args, type_args, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    loop fact in fixed_over -> sema_ownership_uninit_set(state, fact)
    sema_receiver_mark_finish(state)
    if written_place {
        if receiver == .Place(value, _, _, _) -> sema_shared_cycle_check_call(value, args, environment, program, scopes, state, diagnostics)
    }
    checked
}

// Whether the plain call `receiver.method(args)` resolves to a method that
// writes its receiver. The call is checked as a probe: scopes, context and
// ownership state roll back and its diagnostics are dropped.
sema_expr_shared_place_call_writes: fn(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Bool {
    scope_mark: sema_scope_mark(scopes)
    context_mark: sema_check_context_mark(context)
    fork: sema_ownership_fork(state)
    probe_diagnostics := [Diagnostic]{}
    unmarked: sema_receiver_mark_begin(state, receiver)
    _ := sema_expr_check_method_call(unmarked, method, method_span, owner_type_args, type_args, args, None, environment, program, scopes, state, tail_store, context, probe_diagnostics)
    writes := false
    if state.receiver_frames.len() > 0 {
        frame: state.receiver_frames.pop() ?? panic("a receiver frame was pushed")
        writes = frame.convention == (Val(AccessConvention.Write))
    }
    sema_ownership_fork_rollback(state, fork)
    sema_ownership_fork_close(state, fork)
    sema_check_context_rollback(context, context_mark)
    sema_scope_rollback(scopes, scope_mark)
    writes
}

sema_expr_check_list_literal: fn(elements: [Expr], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    expanded := sema_expression_list_member_spreads(elements)
    checked := sema_expression_list(Expr.ListLit{elements: expanded, span: span, id: AST_NODE_GENERATED}, expanded, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if checked != None && sema_expr_repeated_list_head(elements) == .Val(head) {
        diagnostics.push(sema_lint("L0523", span, "this list repeats `{head}` on every element", "a typed list head states the shared element type once and leaves each record body focused on its fields", "write `[{head}]{{{{…}}, {{…}}}}` and remove the repeated element heads"))
    }
    checked
}

// L0523 (repeated_struct_list_edit): two or more elements that each spell the
// same struct head (`[Point{…}, Point{…}]`, parsed as typed literals with field
// bodies, or `alias.Type{…}`). The head named in the message is the written
// one.
sema_expr_repeated_list_head: fn(elements: [Expr]) -> String? Never! {
    if elements.len() < 2 -> return None
    head := ""
    loop element in elements {
        written: sema_expr_struct_literal_head(element) ?? return None
        if head == "" {
            head = written
        } else if head != written {
            return None
        }
    }
    Val(head)
}

// The written head of a struct literal element with a field body.
sema_expr_struct_literal_head: fn(element: Expr) -> String? Never! {
    if element == {
        .StructLit(type_name, type_args, import_ns, as_trait, _, inferred, _, _) -> {
            if inferred || as_trait != None -> return None
            return Val(sema_expr_struct_head_text(type_name, type_args, import_ns))
        }
        .TypedLit(head, body, _, _) -> {
            if body == {
                .Fields(_) -> {}
                else -> return None
            }
            if head == .Val(ty) {
                if ty == {
                    .Named(_) | .Apply(_, _) -> return Val(type_name(ty))
                    else -> return None
                }
            }
            return None
        }
        else -> return None
    }
}

sema_expr_struct_head_text: fn(head_name: String, type_args: [Type], import_ns: String?) -> String Never! {
    text := if import_ns == .Val(namespace) -> "{namespace}.{head_name}" else -> head_name.copy()
    if type_args.len() == 0 -> return text
    "{text}<{(loop arg in type_args -> type_name(arg)).join(", ")}>"
}

// `expr` is the place expression itself (`.Place(value, access, span, _)`).
sema_expr_check_place_expr: fn(expr: Expr, value: Expr, access: PlaceAccess, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if scopes.ownership_call_depth == 0 && !sema_ownership_check_expression(state, expr, scopes, diagnostics) -> return None
    sema_expression_place(value, access, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_expr_check_err_literal: fn(value: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    // #3708: an `Err` written anywhere in the body (callbacks too) is
    // a failure source of its own; the empty key never resolves.
    context.failure_edges.push("")
    sema_expression_result_payload(value, false, false, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_expr_check_pattern_test: fn(subject: Expr, pattern: Pattern, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    // An `.Ok`/`.Err` pattern consumes the
    // subject's Result carrier, so its call root must not propagate.
    subject_value: if sema_pattern_consumes_result_carrier(pattern) -> sema_check_expression_carrier(subject, None, environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_check_expression(subject, None, environment, program, scopes, state, tail_store, context, diagnostics)
    checked_subject: subject_value ?? return None
    if sema_pattern_test_reused_payload_name(pattern, scopes, diagnostics) -> return None
    checked_pattern := sema_check_pattern(checked_subject, pattern, TPatternPosition.Arm, false, false, environment, program, scopes, state, tail_store, context, diagnostics)
    checked: checked_pattern.checked ?? return None
    sema_expr_expected_owned(sema_tree_node(Type.Bool, TExprKind.PatternMatches{subject: checked.subject, pattern: checked.pattern}, span), expected, environment, program, diagnostics)
}

// The deepest source nesting sema checks; the parser enforces the same
// limit (MAX_EXPRESSION_DEPTH).
SEMA_MAX_SOURCE_NESTING: 256

// Enter one checked source form (a statement list or an expression level).
// Past the shared limit this reports E1403 and refuses the form, so nothing
// beneath it is checked; a refused form is not entered.
sema_enter_source_nesting: fn(context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    depth: context.source_nesting + 1
    if depth > SEMA_MAX_SOURCE_NESTING {
        diagnostics.push(sema_error("E1403", span, "this code nests {depth} levels deep; the limit is {SEMA_MAX_SOURCE_NESTING}", "each nested source form needs one compiler checking frame, and the parser and sema enforce the same published limit", "pull inner parts out into named bindings or helper functions"))
        return false
    }
    context.source_nesting = depth
    true
}

sema_leave_source_nesting: fn(context: &SemaCheckContext) Never! {
    context.source_nesting -= 1
}

// The parser's empty receiver `Ident("")` of a lower-case `.member` chain.
sema_expr_is_bare_subject: fn(expr: Expr) -> Bool Never! {
    if expr == .Ident(name, _, _) -> return name == ""
    false
}

// (Rust `is_bare_member_chain`): `.a.b(x)` rooted in the
// parser's empty receiver.
sema_expr_is_bare_member_chain: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Field(base, _, _, _) -> sema_expr_is_bare_subject(base) || sema_expr_is_bare_member_chain(base)
        .MethodCall(receiver, _, _, _, _, _, _) -> sema_expr_is_bare_subject(receiver) || sema_expr_is_bare_member_chain(receiver)
        else -> false
    }
}

// This rule a=A: `.new(...)` is inferred construction, never subject shorthand.
sema_expr_is_inferred_constructor: fn(expr: Expr) -> Bool Never! {
    if expr == .MethodCall(receiver, method, _, _, _, _, _) -> return method == "new" && sema_expr_is_bare_subject(receiver)
    false
}

sema_expr_bare_member_chain_text: fn(expr: Expr) -> String Never! {
    if expr == {
        .Ident(name, _, _) -> if name == "" -> "" else -> ".member"
        .Field(base, member, _, _) -> "{sema_expr_bare_member_chain_text(base)}.{member}"
        .MethodCall(receiver, method, _, _, _, _, _) -> "{sema_expr_bare_member_chain_text(receiver)}.{method}(…)"
        else -> ".member"
    }
}

// The chain with its empty receiver named `subject`.
sema_expr_replace_bare_subject: fn(expr: Expr, subject: String) -> Expr Never! {
    if expr == {
        // copy: the rewritten guard is a new owned Expr. A named identifier stays as written, and
        // `expr` is the caller's AST node (a read parameter), which the caller keeps.
        .Ident(name, span, node) -> if name == "" -> Expr.Ident{name: subject, span: span, id: node} else -> expr.copy()
        .Field(base, member, span, node) -> Expr.Field{base: sema_expr_replace_bare_subject(base, subject), member: member, span: span, id: node}
        .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, node) -> Expr.MethodCall{receiver: sema_expr_replace_bare_subject(receiver, subject), method: method, method_span: method_span, owner_type_args: owner_type_args, type_args: type_args, args: args, id: node}
        // copy: the rewritten guard is a new owned Expr. Other kinds stay as written, and `expr` is
        // the caller's AST node (a read parameter), which the caller keeps.
        else -> expr.copy()
    }
}

// (Rust `infer_inner`): where a one-parameter callable is
// expected, a bare member chain is that callable's subject shorthand, the
// ordinary lambda `(__jet_subject: T) -> __jet_subject.chain`. None when the
// expectation is no unary callable or a bindingless loop owns the subject.
sema_expr_subject_shorthand: fn(expr: Expr, expected: Type?, context: SemaCheckContext, diagnostics: &[Diagnostic]) -> Lambda? {
    if context.implicit_loop_subject_depth > 0 || !sema_expr_is_bare_member_chain(expr) -> return None
    required: expected ?? return None
    if required == .Fn(params, _, _, _, _, _) {
        if params.len() != 1 -> return None
        span: expr_span(expr)
        chain: sema_expr_bare_member_chain_text(expr)
        if context.subject_shorthand_depth > 0 -> diagnostics.push(sema_lint("L0512", span, "subject shorthand `{chain}` is nested inside another subject shorthand", "implicit subjects become hard to track when shorthand scopes nest", "rewrite it with a named binding: `(item) -> item{chain}`"))
        // A nested shorthand's subject is its own parameter: Jet names never
        // shadow, so each nesting depth spells a distinct generated name.
        subject: if context.subject_shorthand_depth == 0 -> "__jet_subject" else -> "__jet_subject_{context.subject_shorthand_depth}"
        // The reference spans the parameter at the chain's node (its last
        // member); the subject the chain reads is spanned at its leading `.`,
        // and a name resolves only at or after its declaration, so the
        // parameter starts at the chain's first byte.
        param_span: Span{start: expr_source_start(expr), end: span.end}
        return Val(Lambda{take_names: [NamedSpan]{}, params: [LambdaParam]{LambdaParam{name: subject, name_span: param_span, ty: Val(params[0]), ty_span: None}}, effects: None, body: LambdaBody.Expr{value: sema_expr_replace_bare_subject(expr, subject)}, span: span, meta: ast_empty_lambda_meta()})
    }
    None
}

// (Rust `infer_inner`): inside a
// bindingless loop a bare member chain reads the implicit `it`; where a
// one-parameter callable is expected it is subject shorthand; elsewhere it
// is no value. Unhandled when `expr` is not a bare member chain.
sema_expr_check_bare_member_chain: fn(expr: Expr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if !sema_expr_is_bare_member_chain(expr) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if context.implicit_loop_subject_depth > 0 -> return SemaMethodSpecialCheck{handled: true, value: sema_check_expression(sema_expr_replace_bare_subject(expr, "it"), expected, environment, program, scopes, state, tail_store, context, diagnostics)}
    required: expected ?? return SemaMethodSpecialCheck{handled: false, value: None}
    span: expr_span(expr)
    chain: sema_expr_bare_member_chain_text(expr)
    shorthand: sema_expr_subject_shorthand(expr, expected, context, diagnostics)
    if shorthand == .Val(lambda) {
        context.subject_shorthand_depth += 1
        value: sema_check_expression(Expr.Lambda{lambda: lambda, id: AST_NODE_GENERATED}, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        context.subject_shorthand_depth -= 1
        return SemaMethodSpecialCheck{handled: true, value: value}
    }
    if required == .Fn(params, _, _, _, _, _) {
        diagnostics.push(sema_error("E-SUBJECT-CALL-ARITY", span, "a bare member chain cannot supply a {params.len()}-parameter callable here", "lower-case `.member` shorthand supplies exactly one subject; a callable with {params.len()} parameters needs all parameters named", "write the full lambda, for example `(first, second) -> first{chain}`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if sema_expr_is_inferred_constructor(expr) -> return SemaMethodSpecialCheck{handled: false, value: None}
    diagnostics.push(sema_error("E-SUBJECT-CALL", span, "a bare member chain cannot be used as a value of type {type_name(required)} here", "lower-case `.member` is shorthand only for a one-parameter callable; this argument expects an ordinary value", "write a value of type {type_name(required)}, or use `(subject: {type_name(required)}) -> subject{chain}`"))
    SemaMethodSpecialCheck{handled: true, value: None}
}

sema_check_expression: fn(expr: Expr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    sema_taskgroup_check_scoped_loan_read(context, expr, scopes, state, diagnostics)
    if context.lending_view_parameter_keys.len() > 0 {
        if expr == {
            .Call(call, _) -> loop argument in call.args -> _ := sema_ownership_report_lending_view_escape(argument.expr, "be passed to a call", scopes, context, diagnostics)
            .MethodCall(_, _, _, _, _, args, _) | .OptMethodCall(_, _, _, _, args, _, _) | .CallValue(_, args, _, _) -> loop argument in args -> _ := sema_ownership_report_lending_view_escape(argument.expr, "be passed to a call", scopes, context, diagnostics)
            else -> {}
        }
    }
    // A direct ranged argument to a View slot borrows the same place as a local.
    if expected == .Val(required) {
        if required == .Apply(name, args) {
            if name == "View" && args.len() == 1 {
                ranged := if expr == {
                    .Slice(_, _, _, _, _, _) | .Index(_, _, _, _, _) -> true
                    else -> false
                }
                if ranged && sema_expression_is_place(expr) {
                    span: expr_span(expr)
                    window: Expr.Place{value: expr, access: PlaceAccess.Read, span: span, id: AST_NODE_GENERATED}
                    return sema_check_expression_recorded(expr, sema_expr_check_place_expr(window, expr, PlaceAccess.Read, span, expected, environment, program, scopes, state, tail_store, context, diagnostics), context)
                }
            }
        }
    }
    // (Rust `infer`, `implicit_copy_target`): a read view
    // local read where its owned type is expected (`View<T>` at `[T]`), or a
    // string view binding read where `String` is expected, outside a borrow
    // position, materializes one owned copy.
    if expected == .Val(destination) && expr == .Ident(view_name, view_span, _) {
        if sema_read_view_owning_read(view_name, destination, scopes, context) || (!context.borrow_ctx && sema_string_view_owning_read(expr, destination, scopes)) -> return sema_check_expression_recorded(expr, sema_string_view_materialize(view_name, view_span, expected, environment, program, scopes, state, context, diagnostics), context)
    }
    // Only a bare member chain can be handled there; testing that here keeps
    // the chain check's frame off every other expression level.
    if sema_expr_is_bare_member_chain(expr) {
        bare_member: sema_expr_check_bare_member_chain(expr, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        if bare_member.handled -> return sema_check_expression_recorded(expr, bare_member.value, context)
    }
    if !sema_enter_source_nesting(context, expr_span(expr), diagnostics) -> return None
    // A call root auto-propagates its Result carrier
    // unless a carrier consumer claimed it. Grouping and access marks are
    // transparent, so the consumer's token reaches the underlying call.
    carrier_root: context.failure_carrier_root
    grouping: if expr == {
        .Paren(_, _, _) | .Place(_, _, _, _) -> true
        else -> false
    }
    if !grouping -> context.failure_carrier_root = false
    propagates: !grouping && !carrier_root && sema_expression_propagating_call(expr)
    previous_success_view: context.failure_success_view
    context.failure_success_view = propagates
    checked := sema_check_expression_inner(expr, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    sema_leave_source_nesting(context)
    context.failure_success_view = previous_success_view
    if propagates && checked != None {
        taken_checked := checked.move()
        checked = None
        call_value := taken_checked.move() ?? return None
        checked = sema_expression_auto_propagate(expr, call_value, expected, environment, program, scopes, context, diagnostics)
    }
    // The checked value moves out and back: binding it while `checked` was
    // still returned copied the whole checked tree at every level.
    value := checked ?? return None
    if sema_core_type_uses_default_int(value.ty) -> context.exact_int_reachable = true
    sema_cell_guard_check_construct(expr, value.ty, diagnostics)
    sema_check_record_expr_id(expr, value, context)
    Val(value.move())
}

// An expression form checked outside the common exit (a ranged view
// argument, a materialized view read, a bare member chain) files its node id
// there.
sema_check_expression_recorded: fn(expr: Expr, checked: TExpr?, context: &SemaCheckContext) -> TExpr? Never! {
    value := checked ?? return None
    sema_check_record_expr_id(expr, value, context)
    Val(value.move())
}

// Check a carrier consumer's subject (`??`, `?`, an `.Ok`/`.Err` pattern): the
// call root keeps its Result carrier; nested calls still propagate.
sema_check_expression_carrier: fn(expr: Expr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    context.failure_carrier_root = true
    checked := sema_check_expression(expr, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    context.failure_carrier_root = false
    checked
}

// The type `expr` would check to, learned without keeping the check: a local
// answers from its binding; any other expression is checked, and that check
// is rolled back. `carrier` probes as a carrier consumer's subject does, so a
// call root keeps its Result carrier.
sema_expr_probe_type: fn(expr: Expr, carrier: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Type? {
    if expr == .Ident(_, _, _) -> return sema_stmt_return_known_type(expr, environment, scopes)
    scope_mark: sema_scope_mark(scopes)
    context_mark: sema_check_context_save(context)
    // copy: the probe's ownership state is restored after the check.
    saved_state: state.copy()
    diagnostic_count: diagnostics.len()
    tail_body_count: tail_store.bodies.len()
    previous_root_read: context.suppress_partial_move_root_read
    context.suppress_partial_move_root_read = true
    probed: if carrier -> sema_check_expression_carrier(expr, None, environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_check_expression(expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
    context.suppress_partial_move_root_read = previous_root_read
    sema_check_context_rollback(context, context_mark)
    sema_scope_rollback(scopes, scope_mark)
    sema_ownership_state_restore(state, saved_state)
    loop diagnostics.len() > diagnostic_count -> _ := diagnostics.pop()
    loop tail_store.bodies.len() > tail_body_count -> _ := tail_store.bodies.pop()
    checked: probed ?? return None
    Val(checked.ty)
}
sema_check_expression_with_lambda_escapes: fn(expr: Expr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, lambda_escapes: Bool?, diagnostics: &[Diagnostic]) -> TExpr? {
    previous_lambda_escapes := context.lambda_escapes
    context.lambda_escapes = lambda_escapes
    checked := sema_check_expression(expr, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    context.lambda_escapes = previous_lambda_escapes
    checked
}

#Test("Source coordinates preserve the existing same-space binary oracle") {
    point: Type.Named{name: "<corelib>/core.math::ScreenPoint"}
    delta: Type.Named{name: "<corelib>/core.math::ScreenDelta"}
    world: Type.Named{name: "<corelib>/core.math::WorldDelta"}
    assert(sema_expr_geometry_is_point(point))
    assert_eq(sema_expr_geometry_space(point), Val(Type.Named{name: "Screen"}))
    assert_eq(sema_expr_geometry_result(BinOp.Add, point, delta), Val(point))
    assert_eq(sema_expr_geometry_result(BinOp.Add, point, world), Val(Type.Named{name: "__GeometrySpaceMismatch"}))
    assert(!sema_expr_geometry_is_point(Type.Named{name: "user::ScreenPoint"}))
}
