// Typed expression construction for Jet's source-level semantic model.
// Registry-dependent paths retain their diagnostics until they have checked
// metadata; no unchecked expression is lowered as if it were valid.
use core.math as math
use jet_foundation.[
    AccessConvention,
    BinOp,
    Call,
    CallArg,
    CallContractRow,
    CtValue,
    Diagnostic,
    Dimension,
    DimensionAxis,
    Expr,
    Func,
    IntegerWidth,
    Measure,
    MIRCopyFact,
    OperatorMarker,
    ParamZone,
    QuantityKind,
    Span,
    StrFormat,
    StrPart,
    Symbol,
    SymbolID,
    SymbolKind,
    TBinaryOp,
    TCallArg,
    TCanonicalField,
    TCoercionTarget,
    TComptimeValue,
    TEnumPayload,
    TExpr,
    TExprKind,
    TGenericParam,
    THandleOp,
    TIntegerBounds,
    TIntegerWidth,
    TMethodRef,
    TNumericOp,
    TPatternPosition,
    TStrFormat,
    TStrPart,
    TUnaryOp,
    TUnitFormat,
    TUnitRounding,
    TUnitRoundingMode,
    Type,
    TypeTupleField,
    UnOp,
    UnitFormat,
    UnitRatio,
    ast_comptime_value_type,
    ast_empty_call_arg_flags,
    core_call_typed_signature,
    core_module_export,
    dimension_display_name,
    dimension_identity,
    expr_span,
    integer_bounds_exact,
    measure_signed_value,
    symbol_id,
    tir_symbol_local,
    type_identity_equal,
    type_name,
]

fn sema_tir_expr(ty: Type, kind: TExprKind, span: Span) -> TExpr Never! {
    TExpr{ty: ty, kind: kind, span: span, integer_bounds: None, cost: None}
}

fn sema_expr_unwrap_tag(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) -> return sema_expr_unwrap_tag(inner)
        else -> {}
    }
    ~ty
}

fn sema_expr_is_integer(ty: Type) -> Bool Never! {
    if sema_expr_unwrap_tag(ty) == {
        .Int -> true
        .IntN(_, _) -> true
        .InlineRange(_, _, _) -> true
        else -> false
    }
}

fn sema_expr_is_numeric(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .IntN(_, _) -> true
        .Float -> true
        .Float32 -> true
        else -> false
    }
}

fn sema_expr_has_numeric_overload(ty: Type) -> Bool Never! {
    if ty == {
        .Named(_) -> true
        .Apply(_, _) -> true
        .Quantity(_, _) -> true
        else -> false
    }
}
fn sema_expr_numeric_base(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(_, inner) -> return sema_expr_numeric_base(inner)
        .InlineRange(base, _, _) -> return sema_expr_numeric_base(base)
        else -> {}
    }
    ~ty
}

fn sema_expr_integer_range_for_type(ty: Type) -> SemaIntegerRange? {
    if ty == {
        .IntN(signed, bits) -> return Val(sema_expr_integer_range(signed, bits))
        .InlineRange(_, lo, hi) -> return Val(SemaIntegerRange{lo: lo, hi: hi})
        .Tagged(_, inner) -> return sema_expr_integer_range_for_type(inner)
        else -> None
    }
}

fn sema_expr_numeric_widening_to(source: Type, target: Type) -> Bool? {
    source_base := sema_expr_numeric_base(source)
    target_base := sema_expr_numeric_base(target)
    if type_identity_equal(source, target) && sema_expr_is_numeric(source) -> return Val(false)
    source_bounds := sema_expr_integer_range_for_type(source)
    target_bounds := sema_expr_integer_range_for_type(target)
    if source_bounds != None && target_bounds != None {
        source_range :: source_bounds ?? SemaIntegerRange{lo: 0, hi: 0}
        target_range :: target_bounds ?? SemaIntegerRange{lo: 0, hi: 0}
        return Val(target_range.lo <= source_range.lo && source_range.hi <= target_range.hi)
    }
    if source != source_base {
        if type_identity_equal(source_base, target) -> return Val(false)
        return sema_expr_numeric_widening_to(source_base, target)
    }
    if target != target_base {
        return None
    }
    if type_identity_equal(source_base, target_base) && sema_expr_is_numeric(source_base) -> return Val(false)
    if source_base == {
        .IntN(_, _) -> {
            if target_base == Type.Int -> return Val(false)
        }
        .Int -> {
            if target_base == .IntN(_, _) -> return Val(true)
        }
        .Float32 -> {
            if target_base == Type.Float -> return Val(false)
        }
        else -> {}
    }
    if source_base == Type.Int && (target_base == Type.Float || target_base == Type.Float32) -> return Val(true)
    if sema_expr_is_integer(source_base) && (target_base == Type.Float || target_base == Type.Float32) {
        bits := 64
        signed := true
        if source_base == {
            .IntN(source_signed, source_bits) -> {
                bits = source_bits
                signed = source_signed
            }
            else -> {}
        }
        precision := if target_base == Type.Float32 -> 24 else -> 53
        exact := if signed -> bits <= precision + 1 else -> bits <= precision
        return Val(!exact)
    }
    None
}

// A lossless direction wins over a checked one in either operand order, so
// `cp & 63` with `63: U8` joins at `Int` instead of narrowing `cp`.
fn sema_expr_numeric_join(left: Type, right: Type) -> Type? {
    forward :: sema_expr_numeric_widening_to(left, right)
    backward :: sema_expr_numeric_widening_to(right, left)
    if !(forward ?? true) -> return Val(right)
    if !(backward ?? true) -> return Val(left)
    if forward != None -> return Val(right)
    if backward != None -> return Val(left)
    None
}
fn sema_expr_numeric_join_values(left: TExpr, right: TExpr) -> Type? {
    left_literal := sema_expr_integer_literal_value(left)
    right_literal := sema_expr_integer_literal_value(right)
    if left_literal != None {
        if right.ty == {
            .IntN(signed, bits) -> {
                if sema_expr_integer_fits(left_literal ?? 0, signed, bits) -> return Val(right.ty)
                return Val(Type.Int)
            }
            else -> {}
        }
    }
    if right_literal != None {
        if left.ty == {
            .IntN(signed, bits) -> {
                if sema_expr_integer_fits(right_literal ?? 0, signed, bits) -> return Val(left.ty)
                return Val(Type.Int)
            }
            else -> {}
        }
    }
    sema_expr_numeric_join(left.ty, right.ty)
}

fn sema_expr_numeric_rust_type(ty: Type) -> String? {
    base := sema_expr_numeric_base(ty)
    if base == {
        .Int -> return Val("i64")
        .Float -> return Val("f64")
        .Float32 -> return Val("f32")
        .IntN(signed, bits) -> {
            prefix := if signed -> "i" else -> "u"
            if bits == 8 || bits == 16 || bits == 32 || bits == 64 -> return Val("{prefix}{bits}")
        }
        else -> {}
    }
    None
}

fn sema_expr_numeric_host_kind(ty: Type) -> Int? {
    base := sema_expr_numeric_base(ty)
    if base == {
        .IntN(signed, bits) -> {
            if {
                signed -> {
                    if bits == 8 -> return Val(0)
                    if bits == 16 -> return Val(1)
                    if bits == 32 -> return Val(2)
                    if bits == 64 -> return Val(3)
                }
                else -> {
                    if bits == 8 -> return Val(4)
                    if bits == 16 -> return Val(5)
                    if bits == 32 -> return Val(6)
                    if bits == 64 -> return Val(7)
                }
            }
        }
        else -> {}
    }
    None
}

fn sema_expr_integer_literal_value(value: TExpr) -> Int? {
    if value.kind == {
        .IntLit(number, width) -> if width == None -> return Val(number)
        // D-INTBIG1: a literal beyond i64 keeps its exact value in its bounds.
        .CtLit(constant) -> {
            if constant == .BigInt(_) && value.integer_bounds == .Val(bounds) {
                if bounds.lo == bounds.hi -> return Val(bounds.lo)
            }
        }
        .Unary(operator, operand) -> {
            if operator == TUnaryOp.Neg {
                inner :: sema_expr_integer_literal_value(operand) ?? return None
                return Val(-inner)
            }
        }
        else -> {}
    }
    None
}

fn sema_expr_numeric_conversion(value: TExpr, target: Type, span: Span, line: Int) -> TExpr? {
    source := sema_expr_numeric_base(value.ty)
    destination := sema_expr_numeric_base(target)
    if type_identity_equal(value.ty, target) -> return Val(value)
    if type_identity_equal(source, destination) {
        return Val(TExpr{ty: target, kind: value.kind, span: span, integer_bounds: value.integer_bounds, cost: value.cost})
    }
    operation := TNumericOp?{None}
    if destination == Type.Float || destination == Type.Float32 {
        if sema_expr_is_integer(source) {
            source_signed := true
            if source == .IntN(signed, _) -> source_signed = signed
            operation = Val(TNumericOp.CheckedIntToFloat{source_signed: source_signed, target_f32: destination == Type.Float32, line: line})
        }
    }
    destination_is_fixed := if destination == {.IntN(_, _) -> true else -> false}
    if destination_is_fixed && source == Type.Int {
        host_kind :: sema_expr_numeric_host_kind(destination) ?? return None
        rust_type :: sema_expr_numeric_rust_type(destination) ?? return None
        operation = Val(TNumericOp.CheckedIntToFixed{host_kind: host_kind, dst_rust: rust_type, dst_spelling: type_name(destination), line: line})
    }
    if operation == None {
        if {
            destination == Type.Float32 && source == Type.Float -> {
                operation = Val(TNumericOp.FloatNarrow{dst_spelling: type_name(destination)})
            }
            else -> {
                rust_type :: sema_expr_numeric_rust_type(destination) ?? return None
                operation = Val(TNumericOp.CastAs{dst_rust: rust_type})
            }
        }
    }
    TExpr{ty: target, kind: TExprKind.NumericMethod{receiver: value, operation: operation ?? TNumericOp.CastAs{dst_rust: ""}}, span: span, integer_bounds: None, cost: None}
}

fn sema_expr_numeric_literal_conversion(value: TExpr, target: Type, span: Span, line: Int, diagnostics: &[Diagnostic]) -> TExpr? {
    literal :: sema_expr_integer_literal_value(value)
    if literal != None && (target == Type.Float || target == Type.Float32) {
        limit := if target == Type.Float32 -> 1 << 24 else -> 1 << 53
        literal_value := literal
        lower := -limit
        if literal_value < lower || literal_value > limit {
            &diagnostics.push(sema_error("E1003", span, "{literal_value} does not fit exactly in {type_name(target)}", "{type_name(target)} holds every whole number only from {lower} through {limit}", "use a whole-number type, or write a value from {lower} through {limit}"))
            return None
        }
    }
    sema_expr_numeric_conversion(value, target, span, line)
}

fn sema_expr_precise_name(ty: Type) -> String? {
    if ty == {
        .Named(name) -> {
            if name == "Decimal" || name == "Fraction" || name == "Complex" -> return Val(name)
        }
        else -> {}
    }
    None
}

fn sema_expr_precise_integer(value: TExpr, type_name_value: String, span: Span) -> TExpr? {
    literal :: sema_expr_integer_literal_value(value) ?? return None
    if type_name_value == "Fraction" {
        one := sema_tir_expr(Type.Int, TExprKind.IntLit{value: 1, width: None}, span)
        return Val(sema_tir_expr(Type.Named{name: "Fraction"}, TExprKind.PreciseBuiltin{type_name: "Fraction", function: "from_parts", args: [TExpr]{sema_tir_expr(Type.Int, TExprKind.IntLit{value: literal, width: None}, span), one}}, span))
    }
    if type_name_value == "Decimal" {
        text := sema_tir_expr(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "{literal}"}}}, span)
        return Val(sema_tir_expr(Type.Named{name: "Decimal"}, TExprKind.PreciseBuiltin{type_name: "Decimal", function: "from_str", args: [TExpr]{text}}, span))
    }
    None
}

fn sema_expr_precise_complex(value: TExpr, span: Span, line: Int, diagnostics: &[Diagnostic]) -> TExpr? {
    if !sema_expr_is_numeric(value.ty) -> return None
    real :: sema_expr_numeric_literal_conversion(value, Type.Float, span, line, &diagnostics) ?? return None
    imaginary := sema_tir_expr(Type.Float, TExprKind.FloatLit{value: 0.0}, span)
    Val(sema_tir_expr(Type.Named{name: "Complex"}, TExprKind.PreciseBuiltin{type_name: "Complex", function: "from_parts", args: [TExpr]{real, imaginary}}, span))
}

fn sema_expr_operator_trait(op: BinOp) -> String? {
    if op == {
        .Add -> return Val("Add")
        .Sub -> return Val("Sub")
        .Mul -> return Val("Mul")
        .Div -> return Val("Div")
        .Eq | .Ne -> return Val("Equatable")
        .Compare | .Lt | .Gt | .Le | .Ge -> return Val("Comparable")
        else -> None
    }
}

fn sema_expr_operator_method(op: BinOp) -> String? {
    if op == {
        .Add -> return Val("add")
        .Sub -> return Val("sub")
        .Mul -> return Val("mul")
        .Div -> return Val("div")
        .Eq | .Ne -> return Val("equal")
        .Compare | .Lt | .Gt | .Le | .Ge -> return Val("compare")
        else -> None
    }
}

fn sema_expr_operator_commutative(op: BinOp) -> Bool Never! {
    op == BinOp.Add || op == BinOp.Mul
}

struct SemaExprOperatorResolution {
    candidate: SemaCallMethodCandidate
    receiver_is_left: Bool
}
// `signature` is `function`'s signature specialized to the receiver; the
// registered row itself is only read.
fn sema_expr_operator_candidate_from_function(function: SemaRegistrationFunction, signature: Type, graph: SemaRegistrationGraph?, owner_type: Type, trait_symbol: Symbol?, trait_name: String, method: String, rhs: Type, span: Span, caller_module: String, caller_package: String, lexical_generic_params: [TGenericParam], diagnostics: &[Diagnostic]) -> SemaCallMethodCandidate? {
    if function.symbol.name != method || function.parameters.len() == 0 -> return None
    trait_symbol_value :: trait_symbol ?? return None
    method_ref := TMethodRef{symbol: function.symbol.id, name: method, mangled: false, trait_owner: Val(trait_symbol_value.id), operator_identity: Val("{type_name(owner_type)}::{trait_name}::{method}<{type_name(rhs)}>")}
    sema_call_method_candidate_from_registration(signature, function.generic_params, graph, caller_module, caller_package, lexical_generic_params, Val(owner_type), function.parameters[0].convention, 1, method_ref, [Type]{}, span, &diagnostics)
}

fn sema_expr_operator_resolution(op: BinOp, lhs: Type, rhs: Type, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaExprOperatorResolution? {
    trait_name :: sema_expr_operator_trait(op) ?? return None
    method :: sema_expr_operator_method(op) ?? return None
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return None
    direct := sema_expr_registration_operator_candidates(graph, lhs, rhs, trait_name, method, false, span, environment, &scopes, &diagnostics)
    if direct.len() > 1 {
        &diagnostics.push(sema_error("E0772", span, "this operator matches more than one callable body", "operator dispatch requires one exact registered trait implementation", "remove the duplicate operator implementation or make the right-hand type unambiguous"))
        return None
    }
    if direct.len() == 1 -> return Val(direct[0])
    if sema_expr_operator_commutative(op) {
        reverse := sema_expr_registration_operator_candidates(graph, rhs, lhs, trait_name, method, true, span, environment, &scopes, &diagnostics)
        if reverse.len() > 1 {
            &diagnostics.push(sema_error("E0772", span, "this operator matches more than one callable body", "commutative operator dispatch requires one exact registered trait implementation", "remove the duplicate operator implementation or make the right-hand type unambiguous"))
            return None
        }
        if reverse.len() == 1 {
            result := reverse[0]
            result.receiver_is_left = false
            return Val(result)
        }
    }
    None
}

fn sema_expr_operator_ordering_variant(op: BinOp) -> String Never! {
    if op == BinOp.Lt -> return "Less"
    if op == BinOp.Gt -> return "Greater"
    "Equal"
}

fn sema_expr_operator_ordering_test(op: BinOp, comparison: TExpr, span: Span, line: Int) -> TExpr Never! {
    variant := sema_expr_operator_ordering_variant(op)
    ordering := sema_tir_expr(Type.Named{name: "Ordering"}, TExprKind.EnumLit{enum_type: "Ordering", variant: variant, payload: TEnumPayload.Unit}, span)
    test_op := TBinaryOp.Eq
    if op == BinOp.Le || op == BinOp.Ge || op == BinOp.Ne -> test_op = TBinaryOp.Ne
    sema_tir_expr(Type.Bool, TExprKind.Binary{op: test_op, overflow: false, line: line, lhs: comparison, rhs: ordering}, span)
}
fn sema_expr_check_operator(op: BinOp, left: Expr, right: Expr, lhs: TExpr, rhs: TExpr, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], line: Int) -> TExpr? {
    resolution := SemaExprOperatorResolution?{None}
    if {
        op == BinOp.Eq || op == BinOp.Ne -> {
            graph_option :: environment.registration_graph
            graph :: graph_option ?? return None
            comparable := sema_expr_registration_operator_candidates(graph, lhs.ty, rhs.ty, "Comparable", "compare", false, span, environment, &scopes, &diagnostics)
            equatable := sema_expr_registration_operator_candidates(graph, lhs.ty, rhs.ty, "Equatable", "equal", false, span, environment, &scopes, &diagnostics)
            if {
                comparable.len() == 1 && equatable.len() == 1 -> {
                    resolution = Val(comparable[0])
                }
                else -> {
                    resolution = sema_expr_operator_resolution(op, lhs.ty, rhs.ty, span, environment, &scopes, &diagnostics)
                }
            }
        }
        else -> {
            resolution = sema_expr_operator_resolution(op, lhs.ty, rhs.ty, span, environment, &scopes, &diagnostics)
        }
    }
    resolved :: resolution ?? return None
    receiver_expr := left
    receiver_value := lhs
    argument_expr := right
    if !resolved.receiver_is_left {
        receiver_expr = right
        receiver_value = rhs
        argument_expr = left
    }
    argument := CallArg{convention: AccessConvention.Read, expr: argument_expr, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
    scopes.ownership_call_depth += 1
    checked := sema_call_check_method_candidate_from_value_owned(&state, receiver_expr, receiver_value, resolved.candidate, [CallArg]{argument}, [SemaCallDefaultValue]{}, span, None, environment, &scopes, &tail_store, &context, &diagnostics)
    scopes.ownership_call_depth -= 1
    value_checked :: checked ?? return None
    &context.call_return_views.push(SemaCallReturnView{span: span, facts: value_checked.return_view_facts})
    if !sema_expr_record_call_fact(environment, &scopes, &context, span, value_checked, &diagnostics) -> return None
    value := value_checked.value
    if op == BinOp.Compare -> return sema_expr_expected(value, expected, environment, &diagnostics)
    if op == BinOp.Eq || op == BinOp.Ne {
        if resolved.candidate.method.name == "compare" {
            result := sema_expr_operator_ordering_test(op, value, span, line)
            return sema_expr_expected(result, expected, environment, &diagnostics)
        }
        if op == BinOp.Ne {
            result := sema_tir_expr(Type.Bool, TExprKind.Unary{op: TUnaryOp.Not, operand: value}, span)
            return sema_expr_expected(result, expected, environment, &diagnostics)
        }
    }
    if op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge {
        return sema_expr_expected(sema_expr_operator_ordering_test(op, value, span, line), expected, environment, &diagnostics)
    }
    sema_expr_expected(value, expected, environment, &diagnostics)
}

fn sema_expr_operator_target_matches(implementation: SemaRegistrationImpl, nominal: SemaRegistrationNominal) -> Bool Never! {
    if implementation.target_identity_key == nominal.identity_key -> return true
    target_module :: nominal.symbol.module_name
    if implementation.target_module_identity == (Val(target_module)) && implementation.target_type_name == nominal.symbol.name -> return true
    false
}

fn sema_expr_operator_rhs_matches(rhs: Type?, expected: Type) -> Bool Never! {
    if rhs == None -> return false
    type_identity_equal(rhs, expected)
}

fn sema_expr_operator_row_name(name: String) -> String Never! {
    parts :: name.split("::").to_list()
    parts[parts.len() - 1]
}

fn sema_expr_registration_operator_candidates(graph: SemaRegistrationGraph, receiver_type: Type, rhs_type: Type, trait_name: String, method: String, require_commutative: Bool, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> [SemaExprOperatorResolution] Never! {
    candidates := [SemaExprOperatorResolution]{}
    receiver_name := sema_expr_type_base_name(receiver_type) ?? ""
    if receiver_name == "" {
        // D-OPMIX1: a built-in scalar receiver reaches its `impl Int.Mul(Price)`
        // hooks through the impl rows registered under the scalar's name.
        scalar_name :: type_name(receiver_type)
        if sema_registration_builtin_scalar(scalar_name) != (Val(receiver_type)) -> return candidates
        receiver_name = scalar_name
    }
    caller_module := environment.module_identity
    if scopes.frames.len() > 0 -> caller_module = scopes.frames[0].owner
    caller_package := environment.package_identity
    // Only the nominals and impls registered under the receiver's base name,
    // in the module/row order of the whole-graph scans these rows replace.
    // The rows are keyed by the declared spelling (`Vec2`); a resolved
    // receiver carries its canonical identity (`module::Vec2`), so the row key
    // is the canonical leaf. Owner inference below still checks the identity.
    receiver_canonical :: receiver_name.contains("::")
    receiver_name = sema_expr_operator_row_name(receiver_name)
    nominal_rows :: sema_registration_nominal_rows_named(graph, receiver_name)
    loop nominal_row in nominal_rows {
        module_index :: nominal_row.module_index
        nominal :: graph.modules[module_index].nominals[nominal_row.row]
        // A resolved receiver carries the canonical identity (`module::Vec2`)
        // while the registered row keeps the declared spelling; infer such a
        // receiver against the declaration resolved in its own module.
        owner_module :: graph.modules[module_index].module_identity
        inference_ty := nominal.ty
        if receiver_canonical -> inference_ty = sema_type_resolve_declared(graph, nominal.ty, owner_module)
        owner_inference :: sema_infer_registered_nominal(nominal, inference_ty, environment.registration_graph, caller_module, caller_package, environment.generic_params, receiver_type, [Type]{}, None, span, &diagnostics) ?? next
        if !owner_inference.complete || !owner_inference.compatible -> next
        owner_type := sema_inference_substitute_type_bindings(nominal.ty, owner_inference.substitutions)
        loop implementation in graph.modules[module_index].impls {
            if !sema_expr_operator_target_matches(implementation, nominal) -> next
            if implementation.trait_name != (Val(trait_name)) -> next
            if require_commutative && implementation.operator_marker != (Val(OperatorMarker.Commutative)) -> next
            implementation_rhs := implementation.operator_rhs
            if implementation_rhs == None -> implementation_rhs = Val(owner_type)
            qualified_rhs := sema_inference_substitute_type_bindings(implementation_rhs ?? owner_type, owner_inference.substitutions)
            if !sema_expr_operator_rhs_matches(Val(qualified_rhs), rhs_type) -> next
            trait_symbol := implementation.trait_symbol
            if trait_symbol == None -> trait_symbol = sema_type_graph_trait_symbol(graph, implementation.source_module_identity, trait_name)
            loop function in implementation.methods {
                if !sema_registration_visible(function.symbol.visibility, caller_module, caller_package, graph.modules[module_index].module_identity, graph.modules[module_index].package_identity) -> next
                specialized :: sema_inference_substitute_type_bindings(function.signature, owner_inference.substitutions)
                candidate :: sema_expr_operator_candidate_from_function(function, specialized, environment.registration_graph, owner_type, trait_symbol, trait_name, method, qualified_rhs, span, caller_module, caller_package, environment.generic_params, &diagnostics) ?? next
                duplicate := false
                loop existing in candidates {
                    if existing.candidate.method.symbol.key == candidate.method.symbol.key && existing.candidate.method.operator_identity == candidate.method.operator_identity {
                        duplicate = true
                    }
                }
                if !duplicate -> &candidates.push(SemaExprOperatorResolution{candidate: candidate, receiver_is_left: true})
            }
        }
        if nominal.source == {
            .SourceAST(item) -> {
                if item == {
                    .Struct(definition) -> {
                        loop block in definition.trait_impls {
                            if block.trait_name != trait_name -> next
                            if require_commutative && block.operator_marker != (Val(OperatorMarker.Commutative)) -> next
                            // The authored right-hand type resolves in the owner's
                            // module, like the impl rows below.
                            block_rhs := sema_type_resolve_declared(graph, block.operator_rhs ?? nominal.ty, owner_module)
                            block_rhs = sema_inference_substitute_type_bindings(block_rhs, owner_inference.substitutions)
                            if !sema_expr_operator_rhs_matches(Val(block_rhs), rhs_type) -> next
                            trait_symbol :: sema_type_graph_trait_symbol(graph, graph.modules[module_index].module_identity, trait_name)
                            loop source_method in block.methods {
                                if source_method.name != method -> next
                                registered := -1
                                loop (index, candidate_function) in nominal.methods {
                                    if candidate_function.declaration.span == source_method.span -> registered = index
                                }
                                if registered < 0 -> next
                                function :: nominal.methods[registered]
                                if !sema_registration_visible(function.symbol.visibility, caller_module, caller_package, graph.modules[module_index].module_identity, graph.modules[module_index].package_identity) -> next
                                specialized :: sema_inference_substitute_type_bindings(function.signature, owner_inference.substitutions)
                                candidate :: sema_expr_operator_candidate_from_function(function, specialized, environment.registration_graph, owner_type, trait_symbol, trait_name, method, block_rhs, span, caller_module, caller_package, environment.generic_params, &diagnostics) ?? next
                                duplicate := false
                                loop existing in candidates {
                                    if existing.candidate.method.symbol.key == candidate.method.symbol.key && existing.candidate.method.operator_identity == candidate.method.operator_identity {
                                        duplicate = true
                                    }
                                }
                                if !duplicate -> &candidates.push(SemaExprOperatorResolution{candidate: candidate, receiver_is_left: true})
                            }
                        }
                    }
                    .Enum(definition) -> {
                        loop block in definition.trait_impls {
                            if block.trait_name != trait_name -> next
                            if require_commutative && block.operator_marker != (Val(OperatorMarker.Commutative)) -> next
                            block_rhs := sema_type_resolve_declared(graph, block.operator_rhs ?? nominal.ty, owner_module)
                            block_rhs = sema_inference_substitute_type_bindings(block_rhs, owner_inference.substitutions)
                            if !sema_expr_operator_rhs_matches(Val(block_rhs), rhs_type) -> next
                            trait_symbol :: sema_type_graph_trait_symbol(graph, graph.modules[module_index].module_identity, trait_name)
                            loop source_method in block.methods {
                                if source_method.name != method -> next
                                registered := -1
                                loop (index, candidate_function) in nominal.methods {
                                    if candidate_function.declaration.span == source_method.span -> registered = index
                                }
                                if registered < 0 -> next
                                function :: nominal.methods[registered]
                                if !sema_registration_visible(function.symbol.visibility, caller_module, caller_package, graph.modules[module_index].module_identity, graph.modules[module_index].package_identity) -> next
                                specialized :: sema_inference_substitute_type_bindings(function.signature, owner_inference.substitutions)
                                candidate :: sema_expr_operator_candidate_from_function(function, specialized, environment.registration_graph, owner_type, trait_symbol, trait_name, method, block_rhs, span, caller_module, caller_package, environment.generic_params, &diagnostics) ?? next
                                duplicate := false
                                loop existing in candidates {
                                    if existing.candidate.method.symbol.key == candidate.method.symbol.key && existing.candidate.method.operator_identity == candidate.method.operator_identity {
                                        duplicate = true
                                    }
                                }
                                if !duplicate -> &candidates.push(SemaExprOperatorResolution{candidate: candidate, receiver_is_left: true})
                            }
                        }
                    }
                    else -> {}
                }
            }
            else -> {}
        }
    }
    impl_rows :: sema_registration_impl_rows_named(graph, receiver_name)
    loop impl_row in impl_rows {
        module_index :: impl_row.module_index
        implementation :: graph.modules[module_index].impls[impl_row.row]
        if implementation.trait_name != (Val(trait_name)) -> next
        if require_commutative && implementation.operator_marker != (Val(OperatorMarker.Commutative)) -> next
        owner_type := implementation.target_type
        // The leaf row key admits same-named owners of other modules; only an
        // impl whose resolved target is the receiver's own type applies.
        if sema_expr_type_base_name(sema_type_resolve_declared(graph, owner_type, implementation.source_module_identity)) != sema_expr_type_base_name(sema_type_resolve_declared(graph, receiver_type, caller_module)) -> next
        // The authored right-hand type resolves in the impl's module, like the
        // canonical operand type it is matched against (D-OPMIX1 `Int.Mul(Price)`).
        implementation_rhs := sema_type_resolve_declared(graph, implementation.operator_rhs ?? owner_type, implementation.source_module_identity)
        if !sema_expr_operator_rhs_matches(Val(implementation_rhs), rhs_type) -> next
        trait_symbol := implementation.trait_symbol
        if trait_symbol == None -> trait_symbol = sema_type_graph_trait_symbol(graph, implementation.source_module_identity, trait_name)
        loop function in implementation.methods {
            if !sema_registration_visible(function.symbol.visibility, caller_module, caller_package, graph.modules[module_index].module_identity, graph.modules[module_index].package_identity) -> next
            candidate :: sema_expr_operator_candidate_from_function(function, function.signature, environment.registration_graph, owner_type, trait_symbol, trait_name, method, implementation_rhs, span, caller_module, caller_package, environment.generic_params, &diagnostics) ?? next
            duplicate := false
            loop existing in candidates {
                if existing.candidate.method.symbol.key == candidate.method.symbol.key && existing.candidate.method.operator_identity == candidate.method.operator_identity {
                    duplicate = true
                }
            }
            if !duplicate -> &candidates.push(SemaExprOperatorResolution{candidate: candidate, receiver_is_left: true})
        }
    }
    candidates
}

fn sema_expr_tir_binary_op(op: BinOp) -> TBinaryOp Never! {
    if op == {
        .Add -> TBinaryOp.Add
        .Sub -> TBinaryOp.Sub
        .Mul -> TBinaryOp.Mul
        .Div -> TBinaryOp.Div
        .FloorDiv -> TBinaryOp.FloorDiv
        .Mod -> TBinaryOp.Mod
        .Rem -> TBinaryOp.Rem
        .Pow -> TBinaryOp.Pow
        .BitAnd -> TBinaryOp.BitAnd
        .BitOr -> TBinaryOp.BitOr
        .BitXor -> TBinaryOp.BitXor
        .Shl -> TBinaryOp.Shl
        .Shr -> TBinaryOp.Shr
        .Eq -> TBinaryOp.Eq
        .Ne -> TBinaryOp.Ne
        .Lt -> TBinaryOp.Lt
        .Gt -> TBinaryOp.Gt
        .Le -> TBinaryOp.Le
        .Ge -> TBinaryOp.Ge
        .Compare -> TBinaryOp.Compare
        .And -> TBinaryOp.And
        .Or -> TBinaryOp.Or
    }
}

fn sema_expr_binary_name(op: BinOp) -> String Never! {
    if op == {
        .Add -> "+"
        .Sub -> "-"
        .Mul -> "*"
        .Div -> "/"
        .FloorDiv -> "/%"
        .Mod -> "%"
        .Rem -> "rem"
        .Pow -> "**"
        .BitAnd -> "&"
        .BitOr -> "|"
        .BitXor -> "^"
        .Shl -> "<<"
        .Shr -> ">>"
        .Eq -> "=="
        .Ne -> "!="
        .Lt -> "<"
        .Gt -> ">"
        .Le -> "<="
        .Ge -> ">="
        .Compare -> "<=>"
        .And -> "&&"
        .Or -> "||"
    }
}

fn sema_expr_binary_type(op: BinOp, lhs: Type, rhs: Type, span: Span, diagnostics: &[Diagnostic]) -> Type? {
    if op == BinOp.And || op == BinOp.Or {
        if lhs == Type.Bool && rhs == Type.Bool -> return Val(Type.Bool)
        &diagnostics.push(sema_error("E0110", span, "logical operators need Bool values", "a logical condition must have a clear yes or no value", "compare each value to produce Bool"))
        return None
    }
    if op == BinOp.Eq || op == BinOp.Ne {
        if !type_identity_equal(lhs, rhs) {
            if sema_expr_numeric_join(lhs, rhs) != None -> return Val(Type.Bool)
            &diagnostics.push(sema_error("E0109", span, "both sides of this comparison must have the same type", "equality compares values of one type", "convert one side or compare values with matching types"))
            return None
        }
        if (lhs == Type.Int || lhs == Type.Float || lhs == Type.Float32 || lhs == Type.Bool || lhs == Type.String || lhs == Type.Char) || sema_expr_is_integer(lhs) || sema_expr_precise_name(lhs) != None -> return Val(Type.Bool)
        return None
    }
    if op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge {
        if !type_identity_equal(lhs, rhs) {
            if sema_expr_numeric_join(lhs, rhs) != None -> return Val(Type.Bool)
            &diagnostics.push(sema_error("E0109", span, "both sides of this comparison must have the same type", "an ordered comparison needs matching numeric operands", "make both sides the same number type"))
            return None
        }
        if sema_expr_is_numeric(lhs) || sema_expr_precise_name(lhs) != None -> return Val(Type.Bool)
        &diagnostics.push(sema_error("E0109", span, "ordered comparisons need numeric operands", "this operator is defined for numbers", "use a numeric value here"))
        return None
    }
    if op == BinOp.Compare {
        if type_identity_equal(lhs, rhs) && (sema_expr_is_numeric(lhs) || sema_expr_precise_name(lhs) != None) -> return Val(Type.Named{name: "Ordering"})
        if sema_expr_numeric_join(lhs, rhs) != None -> return Val(Type.Named{name: "Ordering"})
        return None
    }
    if op == BinOp.Shl || op == BinOp.Shr {
        if sema_expr_is_integer(lhs) && sema_expr_is_integer(rhs) -> return Val(lhs)
        &diagnostics.push(sema_error("E0109", span, "shift operators work on integer values only", "the left side is the value being shifted and the right side is its bit count", "use whole-number operands"))
        return None
    }
    if op == BinOp.Mod || op == BinOp.Rem || op == BinOp.BitAnd || op == BinOp.BitOr || op == BinOp.BitXor {
        if type_identity_equal(lhs, rhs) && sema_expr_is_integer(lhs) -> return Val(lhs)
        if {
            !sema_expr_is_integer(lhs) || !sema_expr_is_integer(rhs) -> &diagnostics.push(sema_error("E0109", span, "this operator works on integer values only", "remainder and bitwise operations preserve an integer width", "use whole-number operands"))
            else -> &diagnostics.push(sema_error("E0109", span, "both sides of this operator need the same integer type", "bitwise and remainder operations preserve one width", "make both operands the same integer type"))
        }
        return None
    }
    if op == BinOp.Div && lhs == Type.Int && rhs == Type.Int -> return Val(Type.Named{name: "Fraction"})
    if op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div || op == BinOp.FloorDiv || op == BinOp.Pow {
        if type_identity_equal(lhs, rhs) && sema_expr_is_numeric(lhs) -> return Val(lhs)
        if sema_expr_precise_name(lhs) != None && type_identity_equal(lhs, rhs) -> return Val(lhs)
        if sema_expr_is_numeric(lhs) && sema_expr_is_numeric(rhs) -> return None
        &diagnostics.push(sema_error("E0109", span, "arithmetic needs matching number types", "arithmetic operands must share a supported numeric type", "make both operands the same number type"))
        return None
    }
    None
}

fn sema_expr_tir_unit_format(format: UnitFormat) -> TUnitFormat Never! {
    if format == {
        .Symbol -> TUnitFormat.Symbol
        .Name -> TUnitFormat.Name
        .Bare -> TUnitFormat.Bare
    }
}

fn sema_expr_string_format(format: StrFormat) -> TStrFormat Never! {
    if format == {
        .Display -> TStrFormat.Display
        .Debug -> TStrFormat.Debug
        .Pretty -> TStrFormat.Pretty
        .Fixed(digits) -> TStrFormat.Fixed{digits: digits}
        .Grouped(digits) -> TStrFormat.Grouped{digits: digits}
        .Hex(digits) -> TStrFormat.Hex{digits: digits}
        .Pad(width, fill) -> TStrFormat.Pad{width: width, fill: fill}
        .PadLeft(width, fill) -> TStrFormat.PadLeft{width: width, fill: fill}
        .Sci(digits) -> TStrFormat.Sci{digits: digits}
        .Percent(digits) -> TStrFormat.Percent{digits: digits}
        .Bin -> TStrFormat.Bin
        .Oct -> TStrFormat.Oct
        .Unit(unit_format) -> TStrFormat.Unit{format: sema_expr_tir_unit_format(unit_format)}
    }
}

fn sema_expr_byte_text(value: U8) -> String Never! {
    byte :: Int.from_u8(value)
    if byte < 128 -> return String.from_bytes([U8]{value}) ?? ""
    first :: U8{192 + (byte >> 6)}
    second :: U8{128 + (byte & 63)}
    String.from_bytes([U8]{first, second}) ?? ""
}


fn sema_expr_expected_type(value: Type, environment: SemaScopeEnvironment) -> Type Never! {
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return value
    sema_type_resolve_declared_with_generics(graph, value, environment.module_identity, environment.generic_params)
}

fn sema_expr_expected_assignable(required: Type, offered: Type, environment: SemaScopeEnvironment) -> Bool? {
    if environment.registration_graph == .Val(graph_value) {
        return sema_type_assignable_in_graph_with_generics(graph_value, required, offered, environment.module_identity, environment.generic_params)
    }
    Val(sema_type_assignable(required, offered))
}

fn sema_expr_expected_trait_symbol(graph: SemaRegistrationGraph, bound: String, caller_module: String) -> Symbol? {
    resolved := sema_registration_lookup_name(graph, caller_module, bound)
    if resolved != None {
        symbol :: resolved ?? return None
        if symbol.symbol.kind == SymbolKind.Trait -> return Val(symbol.symbol)
    }
    parts := bound.split("::").to_list()
    if parts.len() < 2 -> return None
    leaf := parts[parts.len() - 1]
    module_parts := [String]{}
    index := 0
    loop index < parts.len() - 1 {
        &module_parts.push(parts[index])
        index += 1
    }
    module_name := module_parts.join("::")
    module_index :: sema_registration_module_index(graph, module_name) ?? return None
    loop symbol in graph.modules[module_index].symbols {
        if symbol.kind == SymbolKind.Trait && symbol.name == leaf -> return Val(symbol)
    }
    None
}

fn sema_expr_expected_trait_coercion(value: ^TExpr, required: Type, offered: Type, environment: SemaScopeEnvironment) -> TExpr Never! {
    updated := value
    if required == {
        .TraitObject(bounds) -> {
            if bounds.len() != 1 -> return updated
            if offered == .TraitObject(_) -> return updated
            if updated.kind == {
                .StructLit(fields, extra, coercion) -> {
                    if coercion != None {
                        updated.ty = required
                        return updated
                    }
                    graph_option :: environment.registration_graph
                    graph :: graph_option ?? return updated
                    trait_name :: bounds[0]
                    trait_symbol :: sema_expr_expected_trait_symbol(graph, trait_name, environment.module_identity) ?? return updated
                    concrete :: sema_type_resolve_nominal_row(graph, offered, environment.module_identity) ?? return updated
                    updated.ty = required
                    updated.kind = TExprKind.StructLit{fields: fields, extra: extra, as_trait: Val(TCoercionTarget{trait_symbol: trait_symbol.id, concrete_type: graph.modules[concrete.module_index].nominals[concrete.row].symbol.id})}
                    return updated
                }
                else -> {}
            }
            source := updated
            updated.ty = required
            updated.kind = TExprKind.TraitBox{value: source, target: required}
            return updated
        }
        else -> {}
    }
    updated
}

// D-OPT-LIFT1=A: a plain `T` fills a slot whose checked type is `T?`. The slot
// type is already fixed, so the lift never picks a callee or infers a generic;
// it adds exactly one `Present` last. A value that is already optional or
// fallible, or that never returns, keeps the ordinary checks (E0108/E0309).
fn sema_expr_optional_lift(value: TExpr, required: Type, offered: Type, environment: SemaScopeEnvironment) -> TExpr? {
    normalized :: sema_expr_unwrap_tag(required)
    if normalized == {
        .Option(payload) -> {
            if sema_expr_unwrap_tag(offered) == {
                .Option(_) | .Result(_, _) -> return None
                .Named(name) -> {
                    if name == "Never" -> return None
                }
                else -> {}
            }
            fits :: sema_expr_expected_assignable(payload, offered, environment) ?? return None
            if !fits -> return None
            return Val(sema_tir_expr(normalized, TExprKind.Present{value: value}, value.span))
        }
        else -> {}
    }
    None
}

fn sema_expr_expected(value: TExpr, expected: Type?, environment: SemaScopeEnvironment, diagnostics: &[Diagnostic]) -> TExpr? {
    if expected == None -> return Val(value)
    required := sema_expr_expected_type(expected, environment)
    offered := sema_expr_expected_type(value.ty, environment)
    lifted :: sema_expr_optional_lift(value, required, offered, environment)
    if lifted != None -> return lifted
    if sema_expr_strict_zone_erased(required, offered, environment) {
        &diagnostics.push(sema_error("E0771", value.span, "this needs {sema_type_show(required)}, but the function value is {sema_type_show(offered)}", "public labels and parameter zones are part of a function's callable type", "use `{type_name(required)}` here"))
        return None
    }
    compatible :: sema_expr_expected_assignable(required, offered, environment) ?? return None
    if !compatible {
        &diagnostics.push(sema_expr_mismatch_diagnostic(required, offered, value.span))
        return None
    }
    Val(sema_expr_expected_trait_coercion(^value, required, offered, environment))
}

// The rejection for a value that can't fill `required`: the callable and
// carrier contracts get their own codes before the plain type mismatch.
fn sema_expr_mismatch_diagnostic(required: Type, offered: Type, span: Span) -> Diagnostic {
    // D-NEVER2=B (E2426): a callable promised to return `Never` can't be a
    // value-producing function.
    if required == .Fn(_, required_ret, _, _, _, _) && offered == .Fn(_, offered_ret, _, _, _, _) && sema_expr_never_success(required_ret) && !sema_expr_never_success(offered_ret) {
        return sema_error("E2426", span, "Function value does not satisfy `fn() Never`.", "`fn() Never` promises the callable never completes, so a returning function has the wrong contract (D-NEVER2=B).", "Pass a function declared `Never`, or change the expected function type.")
    }
    // E0401: `T !E` where plain `T` is needed.
    required_plain :: if required == {
        .Result(_, _) -> false
        else -> true
    }
    if required_plain && offered == .Result(ok, _) && type_identity_equal(ok, required) {
        return sema_error("E0401", span, "this needs {sema_type_show(required)}, but the value is {sema_type_show(offered)}", "a fallible result must be checked before its value is used", "use `?`, `??`, or test with `== Ok(...)` / `== Err(...)`")
    }
    sema_type_mismatch(required, offered, span)
}

// Rust `Type::has_never_success`: `Never`, or a fallible `Never !E`.
fn sema_expr_never_success(ty: Type?) -> Bool Never! {
    value :: ty ?? return false
    never :: Type.Named{name: "Never"}
    if value == {
        .Result(ok, _) -> ok == never
        else -> value == never
    }
}

// An erased function type carries no proof that it honors a strict
// positional-only or label-only zone, so it can't cross into one (E0771).
fn sema_expr_strict_zone_erased(required: Type, offered: Type, environment: SemaScopeEnvironment) -> Bool {
    if required == .Fn(params, ret, effects, contract, metadata, provenance) && contract == .Val(rows) && offered == .Fn(_, _, _, offered_contract, _, _) && offered_contract == None {
        if !sema_expr_contract_has_strict_zone(rows) -> return false
        erased :: Type.Fn{params: params, ret: ret, effect_bound: effects, param_contract: None, call_metadata: metadata, return_view_provenance: provenance}
        return sema_expr_expected_assignable(erased, offered, environment) == (Val(true))
    }
    false
}

fn sema_expr_contract_has_strict_zone(rows: [CallContractRow]) -> Bool Never! {
    loop row in rows {
        if row.zone == ParamZone.PositionalOnly || row.zone == ParamZone.LabelOnly -> return true
    }
    false
}
fn sema_expr_precise_error(op: BinOp, lhs: Type, rhs: Type, span: Span, diagnostics: &[Diagnostic]) {
    &diagnostics.push(sema_error("E0133", span, "{sema_expr_binary_name(op)} isn't defined between `{type_name(lhs)}` and `{type_name(rhs)}`", "`Decimal` supports `+`, `-`, `*`, and `==`/`!=`; `Fraction` and `Complex` support only their declared exact operations", "use a named exact constructor or make both operands the same precise type"))
}

fn sema_expr_check_precise_binary(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int, diagnostics: &[Diagnostic]) -> TExpr? {
    left_name := sema_expr_precise_name(lhs.ty)
    right_name := sema_expr_precise_name(rhs.ty)
    if left_name == None && right_name == None -> return None
    left := lhs
    right := rhs
    lname := left_name
    rname := right_name
    if {
        lname == (Val("Complex")) && rname == None && sema_expr_is_numeric(rhs.ty) -> {
            right = sema_expr_precise_complex(rhs, span, line, &diagnostics) ?? return None
            rname = Val("Complex")
        }
        rname == (Val("Complex")) && lname == None && sema_expr_is_numeric(lhs.ty) -> {
            left = sema_expr_precise_complex(lhs, span, line, &diagnostics) ?? return None
            lname = Val("Complex")
        }
        lname != None && rname == None && lname != (Val("Complex")) -> {
            if sema_expr_integer_literal_value(rhs) != None {
                right = sema_expr_precise_integer(rhs, lname ?? "", span) ?? {
                    sema_expr_precise_error(op, lhs.ty, rhs.ty, span, &diagnostics)
                    return None
                }
                rname = lname
            }
        }
        rname != None && lname == None && rname != (Val("Complex")) -> {
            if sema_expr_integer_literal_value(lhs) != None {
                left = sema_expr_precise_integer(lhs, rname ?? "", span) ?? {
                    sema_expr_precise_error(op, lhs.ty, rhs.ty, span, &diagnostics)
                    return None
                }
                lname = rname
            }
        }
    }
    if (lname == (Val("Decimal")) && (rhs.ty == Type.Float || rhs.ty == Type.Float32)) || (rname == (Val("Decimal")) && (lhs.ty == Type.Float || lhs.ty == Type.Float32)) {
        &diagnostics.push(sema_error("E0131", span, "`Float` and `Decimal` can't be mixed — got `{type_name(lhs.ty)}` and `{type_name(rhs.ty)}`", "exact Decimal values do not silently cross the approximate floating-point boundary", "use `Decimal` for both operands, or convert explicitly at the call site"))
        return None
    }
    if lname == None || rname == None || lname != rname {
        sema_expr_precise_error(op, lhs.ty, rhs.ty, span, &diagnostics)
        return None
    }
    precise_name :: lname ?? return None
    method := String?{None}
    result_ty := Type.Named{name: precise_name}
    if op == BinOp.Add -> method = Val("add")
    if op == BinOp.Sub -> method = Val("sub")
    if op == BinOp.Mul -> method = Val("mul")
    if op == BinOp.Div -> method = Val("div")
    if op == BinOp.Eq || op == BinOp.Ne {
        if precise_name == "Complex" {
            sema_expr_precise_error(op, lhs.ty, rhs.ty, span, &diagnostics)
            return None
        }
        method = Val("equal")
        result_ty = Type.Bool
    }
    operation :: method ?? {
        sema_expr_precise_error(op, lhs.ty, rhs.ty, span, &diagnostics)
        return None
    }
    value := sema_tir_expr(result_ty, TExprKind.PreciseBuiltin{type_name: precise_name, function: operation, args: [TExpr]{left, right}}, span)
    if op == BinOp.Ne -> return Val(sema_tir_expr(Type.Bool, TExprKind.Unary{op: TUnaryOp.Not, operand: value}, span))
    Val(value)
}
fn sema_expr_is_math_type_name(name: String) -> Bool Never! {
    if name == "Vec2" || name == "Vec3" || name == "Vec4" || name == "Mat3" || name == "Mat4" -> return true
    if name == "F32x4" || name == "F64x4" || name == "I32x4" || name == "U32x4" || name == "I64x4" || name == "U64x4" -> return true
    if name == "F64x2" || name == "I64x2" || name == "U64x2" -> return true
    if name == "F32x8" || name == "I16x8" || name == "U16x8" || name == "I32x8" || name == "U32x8" -> return true
    if name == "I8x16" || name == "U8x16" || name == "I16x16" || name == "U16x16" -> return true
    name == "I8x32" || name == "U8x32"
}

fn sema_expr_math_scalar_operand(ty: Type) -> Bool Never! {
    if ty == Type.Int || ty == Type.Float || ty == Type.Float32 -> return true
    if ty == .IntN(_, _) -> return true
    if ty == .InlineRange(_, _, _) -> return true
    if ty == (Type.Named{name: "Decimal"}) || ty == (Type.Named{name: "Fraction"}) || ty == (Type.Named{name: "F64"}) -> return true
    false
}

fn sema_expr_math_result(op: BinOp, left_name: String, right_name: String) -> Type? {
    same := left_name == right_name
    if op == BinOp.Add || op == BinOp.Sub {
        if same && sema_expr_is_math_type_name(left_name) -> return Val(Type.Named{name: left_name})
        return None
    }
    if op == BinOp.Mul {
        if same && sema_expr_is_math_type_name(left_name) -> return Val(Type.Named{name: left_name})
        if left_name == "Mat3" && right_name == "Vec3" -> return Val(Type.Named{name: "Vec3"})
        if left_name == "Mat4" && right_name == "Vec4" -> return Val(Type.Named{name: "Vec4"})
        return None
    }
    if op == BinOp.Div && same && (left_name == "F32x4" || left_name == "F64x4" || left_name == "I32x4" || left_name == "U32x4" || left_name == "I64x4" || left_name == "U64x4" || left_name == "F64x2" || left_name == "I64x2" || left_name == "U64x2" || left_name == "F32x8" || left_name == "I16x8" || left_name == "U16x8" || left_name == "I32x8" || left_name == "U32x8" || left_name == "I8x16" || left_name == "U8x16" || left_name == "I16x16" || left_name == "U16x16" || left_name == "I8x32" || left_name == "U8x32") -> return Val(Type.Named{name: left_name})
    if (op == BinOp.Eq || op == BinOp.Ne) && same && sema_expr_is_math_type_name(left_name) -> return Val(Type.Bool)
    None
}

fn sema_expr_math_scalar_result(op: BinOp, math_name: String, scalar: Type) -> Type? {
    if (op != BinOp.Mul && op != BinOp.Div) || !sema_expr_is_math_type_name(math_name) || !sema_expr_math_scalar_operand(scalar) -> return None
    Val(Type.Named{name: math_name})
}

fn sema_expr_math_scalar_to_float(value: TExpr, span: Span, line: Int, diagnostics: &[Diagnostic]) -> TExpr? {
    if value.ty == Type.Float || value.ty == Type.Float32 || value.ty == (Type.Named{name: "F64"}) -> return Val(value)
    if value.ty == (Type.Named{name: "Decimal"}) || value.ty == (Type.Named{name: "Fraction"}) {
        return Val(sema_tir_expr(Type.Float, TExprKind.PreciseBuiltin{type_name: type_name(value.ty), function: "to_float", args: [TExpr]{value}}, span))
    }
    sema_expr_numeric_literal_conversion(value, Type.Float, span, line, &diagnostics)
}

fn sema_expr_check_math_binary(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int, diagnostics: &[Diagnostic]) -> TExpr? {
    left_name :: sema_expr_type_base_name(lhs.ty)
    right_name :: sema_expr_type_base_name(rhs.ty)
    left_math := left_name != None && sema_expr_is_math_type_name(left_name ?? "")
    right_math := right_name != None && sema_expr_is_math_type_name(right_name ?? "")
    if !left_math && !right_math -> return None
    if left_math && right_math {
        result :: sema_expr_math_result(op, left_name ?? "", right_name ?? "") ?? return None
        function := sema_expr_binary_name(op)
        if op == BinOp.Add -> function = "add"
        if op == BinOp.Sub -> function = "sub"
        if op == BinOp.Mul -> function = "mul"
        if op == BinOp.Div -> function = "div"
        if op == BinOp.Eq -> function = "equal"
        if op == BinOp.Ne -> function = "equal"
        value := sema_tir_expr(result, TExprKind.MathBuiltin{type_name: left_name ?? "", function: function, args: [TExpr]{lhs, rhs}}, span)
        if op == BinOp.Ne -> return Val(sema_tir_expr(Type.Bool, TExprKind.Unary{op: TUnaryOp.Not, operand: value}, span))
        return Val(value)
    }
    if left_math {
        scalar_result := sema_expr_math_scalar_result(op, left_name ?? "", rhs.ty) ?? return None
        scalar :: sema_expr_math_scalar_to_float(rhs, span, line, &diagnostics) ?? return None
        function := if op == BinOp.Mul -> "mul" else -> "div"
        return Val(sema_tir_expr(scalar_result, TExprKind.MathBuiltin{type_name: left_name ?? "", function: function, args: [TExpr]{lhs, scalar}}, span))
    }
    scalar_result := sema_expr_math_scalar_result(op, right_name ?? "", lhs.ty) ?? return None
    scalar :: sema_expr_math_scalar_to_float(lhs, span, line, &diagnostics) ?? return None
    right_name_value := right_name ?? ""
    function := if op == BinOp.Mul -> "mul_{right_name_value}" else -> "div_{right_name_value}"
    Val(sema_tir_expr(scalar_result, TExprKind.MathBuiltin{type_name: "Float", function: function, args: [TExpr]{scalar, rhs}}, span))
}
fn sema_expr_geometry_is_point(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> return name == "ScreenPoint" || name == "WorldPoint" || name == "ViewPoint" || name == "CameraPoint" || name == "DevicePoint"
        .Apply(name, args) -> return name == "Point2" && args.len() == 2
        else -> false
    }
}

fn sema_expr_geometry_is_delta(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> return name == "ScreenDelta" || name == "WorldDelta" || name == "ViewDelta" || name == "CameraDelta" || name == "DeviceDelta"
        .Apply(name, args) -> return name == "Delta2" && args.len() == 2
        else -> false
    }
}

fn sema_expr_geometry_space(ty: Type) -> Type? {
    if ty == {
        .Named(name) -> {
            if name == "ScreenPoint" || name == "ScreenDelta" -> return Val(Type.Named{name: "Screen"})
            if name == "WorldPoint" || name == "WorldDelta" -> return Val(Type.Named{name: "World"})
            if name == "ViewPoint" || name == "ViewDelta" -> return Val(Type.Named{name: "View"})
            if name == "CameraPoint" || name == "CameraDelta" -> return Val(Type.Named{name: "Camera"})
            if name == "DevicePoint" || name == "DeviceDelta" -> return Val(Type.Named{name: "Device"})
        }
        .Apply(name, args) -> {
            if (name == "Point2" || name == "Delta2") && args.len() == 2 -> return Val(args[1])
        }
        else -> {}
    }
    None
}

fn sema_expr_geometry_dynamic(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, _) -> return name == "Point2" || name == "Delta2"
        else -> false
    }
}

fn sema_expr_geometry_scalar(ty: Type) -> Type Never! {
    if ty == {.Apply(_, args) -> if args.len() > 0 -> return args[0] else -> Type.Float else -> Type.Float}
}

fn sema_expr_geometry_generic(name: String, source: Type) -> Type Never! {
    Type.Apply{name: name, args: [Type]{sema_expr_geometry_scalar(source), sema_expr_geometry_space(source) ?? Type.Named{name: "Unknown"}}}
}

fn sema_expr_geometry_result(op: BinOp, lhs: Type, rhs: Type) -> Type? {
    left_point := sema_expr_geometry_is_point(lhs)
    right_point := sema_expr_geometry_is_point(rhs)
    left_delta := sema_expr_geometry_is_delta(lhs)
    right_delta := sema_expr_geometry_is_delta(rhs)
    if !(left_point || right_point || left_delta || right_delta) -> return None
    left_space :: sema_expr_geometry_space(lhs) ?? Type.Named{name: "Unknown"}
    right_space :: sema_expr_geometry_space(rhs) ?? Type.Named{name: "Unknown"}
    if !type_identity_equal(left_space, right_space) -> return Val(Type.Named{name: "__GeometrySpaceMismatch"})
    dynamic := sema_expr_geometry_dynamic(lhs) || sema_expr_geometry_dynamic(rhs)
    result := Type?{None}
    if {
        op == BinOp.Add -> {
            if {
                left_point && right_delta -> {
                    result = Val(if dynamic -> sema_expr_geometry_generic("Point2", lhs) else -> lhs)
                }
                left_delta && right_point -> {
                    result = Val(if dynamic -> sema_expr_geometry_generic("Point2", rhs) else -> rhs)
                }
                left_delta && right_delta -> {
                    result = Val(if dynamic -> sema_expr_geometry_generic("Delta2", lhs) else -> lhs)
                }
            }
        }
        op == BinOp.Sub -> {
            if {
                left_point && right_delta -> {
                    result = Val(if dynamic -> sema_expr_geometry_generic("Point2", lhs) else -> lhs)
                }
                left_point && right_point -> {
                    if {
                        dynamic -> {
                            result = Val(sema_expr_geometry_generic("Delta2", lhs))
                        }
                        else -> {
                            point_name :: if lhs == (Type.Named{name: "ScreenPoint"}) -> "ScreenDelta" else -> if lhs == (Type.Named{name: "WorldPoint"}) -> "WorldDelta" else -> if lhs == (Type.Named{name: "ViewPoint"}) -> "ViewDelta" else -> if lhs == (Type.Named{name: "CameraPoint"}) -> "CameraDelta" else -> if lhs == (Type.Named{name: "DevicePoint"}) -> "DeviceDelta" else -> ""
                            if point_name != "" -> result = Val(Type.Named{name: point_name})
                        }
                    }
                }
                left_delta && right_delta -> {
                    result = Val(if dynamic -> sema_expr_geometry_generic("Delta2", lhs) else -> lhs)
                }
            }
        }
        op == BinOp.Eq || op == BinOp.Ne -> {
            if (left_point && right_point) || (left_delta && right_delta) -> result = Val(Type.Bool)
        }
    }
    result_value :: result ?? return Val(Type.Named{name: "__GeometryUnsupported"})
    if dynamic && result_value != Type.Bool {
        return Val(Type.Result{ok: result_value, err: Type.Named{name: "TransformError"}})
    }
    Val(result_value)
}

fn sema_expr_geometry_name(ty: Type) -> String Never! {
    if ty == {
        .Named(name) -> return name
        .Apply(name, _) -> return name
        else -> return type_name(ty)
    }
}

fn sema_expr_geometry_diagnostic(op: BinOp, lhs: Type, rhs: Type, span: Span, diagnostics: &[Diagnostic]) {
    expected := type_name(sema_expr_geometry_space(lhs) ?? lhs)
    actual := type_name(sema_expr_geometry_space(rhs) ?? rhs)
    if sema_expr_geometry_is_point(lhs) && sema_expr_geometry_is_point(rhs) {
        expected = "a displacement in {expected}"
        actual = "a point in {actual}"
    }
    &diagnostics.push(sema_error("E2520", span, "`{sema_expr_binary_name(op)}` needs `{expected}` space, got `{actual}`.", "Coordinate-space tags are ordinary type facts; combining different spaces would make a numerically valid result mean the wrong thing.", "Use a `{expected}` point or displacement, or convert it with a checked transform."))
}

fn sema_expr_check_geometry_binary(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int, diagnostics: &[Diagnostic]) -> TExpr? {
    if !sema_expr_geometry_is_point(lhs.ty) && !sema_expr_geometry_is_delta(lhs.ty) && !sema_expr_geometry_is_point(rhs.ty) && !sema_expr_geometry_is_delta(rhs.ty) -> return None
    left_space :: sema_expr_geometry_space(lhs.ty) ?? lhs.ty
    right_space :: sema_expr_geometry_space(rhs.ty) ?? rhs.ty
    if !type_identity_equal(left_space, right_space) {
        sema_expr_geometry_diagnostic(op, lhs.ty, rhs.ty, span, &diagnostics)
        return None
    }
    result :: sema_expr_geometry_result(op, lhs.ty, rhs.ty) ?? {
        sema_expr_geometry_diagnostic(op, lhs.ty, rhs.ty, span, &diagnostics)
        return None
    }
    if result == (Type.Named{name: "__GeometryUnsupported"}) {
        sema_expr_geometry_diagnostic(op, lhs.ty, rhs.ty, span, &diagnostics)
        return None
    }
    if result == (Type.Named{name: "__GeometrySpaceMismatch"}) -> return None
    if op == BinOp.Eq || op == BinOp.Ne {
        test_op := TBinaryOp.Eq
        if op == BinOp.Ne -> test_op = TBinaryOp.Ne
        value := sema_tir_expr(Type.Bool, TExprKind.Binary{op: test_op, overflow: false, line: line, lhs: lhs, rhs: rhs}, span)
        return Val(value)
    }
    if op == BinOp.Add || op == BinOp.Sub {
        function := "add"
        if op == BinOp.Sub -> function = "sub"
        value := sema_tir_expr(result, TExprKind.MathBuiltin{type_name: sema_expr_geometry_name(lhs.ty), function: function, args: [TExpr]{lhs, rhs}}, span)
        return Val(value)
    }
    sema_expr_geometry_diagnostic(op, lhs.ty, rhs.ty, span, &diagnostics)
    None
}

fn sema_expr_check_duration_binary(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span) -> TExpr? {
    if lhs.ty == (Type.Named{name: "Duration"}) && rhs.ty == Type.Int && (op == BinOp.Mul || op == BinOp.Div) {
        operation := THandleOp.DurationScale
        if op == BinOp.Div -> operation = THandleOp.DurationDivide
        return Val(sema_tir_expr(Type.Named{name: "Duration"}, TExprKind.HandleMethod{receiver: lhs, operation: operation, args: [TExpr]{rhs}}, span))
    }
    if lhs.ty == Type.Int && rhs.ty == (Type.Named{name: "Duration"}) && op == BinOp.Mul {
        return Val(sema_tir_expr(Type.Named{name: "Duration"}, TExprKind.HandleMethod{receiver: rhs, operation: THandleOp.DurationScale, args: [TExpr]{lhs}}, span))
    }
    None
}

fn sema_expr_check_time_binary(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int) -> TExpr? {
    if lhs.ty != (Type.Named{name: "Duration"}) && lhs.ty != (Type.Named{name: "Instant"}) -> return None
    if rhs.ty != (Type.Named{name: "Duration"}) && rhs.ty != (Type.Named{name: "Instant"}) -> return None
    if op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge || op == BinOp.Compare {
        if lhs.ty != rhs.ty -> return None
        result_ty := if op == BinOp.Compare -> Type.Named{name: "Ordering"} else -> Type.Bool
        return Val(sema_tir_expr(result_ty, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span))
    }
    result := Type?{None}
    if {
        lhs.ty == (Type.Named{name: "Duration"}) && rhs.ty == (Type.Named{name: "Duration"}) -> {
            if op == BinOp.Add || op == BinOp.Sub -> result = Val(Type.Named{name: "Duration"})
        }
        lhs.ty == (Type.Named{name: "Instant"}) && rhs.ty == (Type.Named{name: "Instant"}) -> {
            if op == BinOp.Sub -> result = Val(Type.Named{name: "Duration"})
        }
        (lhs.ty == Type.Named{name: "Instant"} && rhs.ty == Type.Named{name: "Duration"}) || (lhs.ty == Type.Named{name: "Duration"} && rhs.ty == Type.Named{name: "Instant"}) -> {
            if op == BinOp.Add -> result = Val(Type.Named{name: "Instant"})
            if lhs.ty == (Type.Named{name: "Instant"}) && op == BinOp.Sub -> result = Val(Type.Named{name: "Instant"})
        }
    }
    result_ty :: result ?? return None
    Val(sema_tir_expr(result_ty, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span))
}

struct SemaExprDistinctFacts {
    name: String
    base: Type
    numeric: Bool
    range: TIntegerBounds?
}

fn sema_expr_distinct_facts(ty: Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable) -> SemaExprDistinctFacts? {
    name := ""
    if ty == {
        .Named(value) -> name = value
        else -> return None
    }
    owner := sema_expression_type_symbol(&scopes, environment, name) ?? return None
    definition_value :: sema_scope_declaration_distinct(environment, owner.id) ?? return None
    if definition_value.quantity != None -> return None
    numeric := false
    loop marker in definition_value.derives {
        if marker.name == "Numeric" -> numeric = true
    }
    range := TIntegerBounds?{None}
    if definition_value.range != None {
        value :: definition_value.range ?? return None
        range = Val(TIntegerBounds{lo: value.lo, hi: value.hi})
    }
    Val(SemaExprDistinctFacts{name: name, base: definition_value.base, numeric: numeric, range: range})
}

fn sema_expr_check_distinct_binary(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int, left_facts: SemaExprDistinctFacts?, right_facts: SemaExprDistinctFacts?, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> TExpr? {
    if left_facts == None && right_facts == None -> return None
    arithmetic := op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div || op == BinOp.FloorDiv || op == BinOp.Mod || op == BinOp.Rem || op == BinOp.BitAnd || op == BinOp.BitOr || op == BinOp.BitXor || op == BinOp.Shl || op == BinOp.Shr
    if arithmetic {
        distinct :: if left_facts != None -> left_facts else -> right_facts ?? return None
        if !distinct.numeric {
            &diagnostics.push(sema_error("E0127", span, "{sema_expr_binary_name(op)} is not available on `{distinct.name}`", "`{distinct.name}` is a distinct type but isn't marked `#Numeric`, so it doesn't inherit arithmetic operators — only `==` is available", "add `#Numeric` before the declaration if this is a quantity, or use `.raw()` to work on the underlying value"))
            return None
        }
        if lhs.ty != rhs.ty {
            &diagnostics.push(sema_error("E0127", span, "{sema_expr_binary_name(op)} is not available between `{type_name(lhs.ty)}` and `{type_name(rhs.ty)}`", "`#Numeric` distinct types only support arithmetic between the same type", "both sides must be `{distinct.name}`"))
            return None
        }
        effective_lhs := lhs
        effective_rhs := rhs
        result_ty := lhs.ty
        if distinct.range != None {
            _ := sema_scope_require_knowledge_gate(&scopes, SemaKnowledgePlane.Range, SemaKnowledgeGate.BoundedArithmetic, span, &diagnostics)
            base := distinct.base
            effective_lhs = sema_tir_expr(base, TExprKind.DistinctRaw{value: lhs}, span)
            effective_rhs = sema_tir_expr(base, TExprKind.DistinctRaw{value: rhs}, span)
            result_ty = base
        }
        return Val(sema_tir_expr(result_ty, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: effective_lhs, rhs: effective_rhs}, span))
    }
    if op == BinOp.Eq || op == BinOp.Ne {
        if lhs.ty != rhs.ty {
            distinct :: if left_facts != None -> left_facts else -> right_facts ?? return None
            &diagnostics.push(sema_error("E0128", span, "a `{type_name(lhs.ty)}` can't be compared with a `{type_name(rhs.ty)}`", "`{distinct.name}` is a distinct type; it only compares equal to another `{distinct.name}`", "use `.raw()` to compare the underlying values, or construct a `{distinct.name}`"))
            return None
        }
        return Val(sema_tir_expr(Type.Bool, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span))
    }
    None
}

fn sema_expr_unit_fact(ty: Type, environment: SemaScopeEnvironment) -> SemaRegistrationUnitFact? {
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return None
    sema_registration_unit_fact_for_type(graph, ty)
}


fn sema_expr_unit_ratio_sub(left: UnitRatio, right: UnitRatio) -> UnitRatio Never! {
    UnitRatio{numerator: left.numerator * right.denominator - right.numerator * left.denominator, denominator: left.denominator * right.denominator}
}

fn sema_expr_unit_ratio_div(left: UnitRatio, right: UnitRatio) -> UnitRatio? {
    if right.numerator == 0 -> return None
    Val(UnitRatio{numerator: left.numerator * right.denominator, denominator: left.denominator * right.numerator})
}

fn sema_expr_unit_ratio_abs(value: UnitRatio) -> UnitRatio Never! {
    numerator := value.numerator
    denominator := value.denominator
    if numerator < 0 -> numerator = -numerator
    if denominator < 0 -> denominator = -denominator
    UnitRatio{numerator: numerator, denominator: denominator}
}

fn sema_expr_unit_ratio_le(left: UnitRatio, right: UnitRatio) -> Bool Never! {
    left_abs := sema_expr_unit_ratio_abs(left)
    right_abs := sema_expr_unit_ratio_abs(right)
    left_abs.numerator * right_abs.denominator <= right_abs.numerator * left_abs.denominator
}

fn sema_expr_unit_ratio_text(value: UnitRatio) -> String Never! {
    "{value.numerator}/{value.denominator}"
}
fn sema_expr_unit_ratio_equal(left: UnitRatio, right: UnitRatio) -> Bool Never! {
    left.numerator * right.denominator == right.numerator * left.denominator
}

fn sema_expr_unit_is_measured(fact: SemaRegistrationUnitFact) -> Bool Never! {
    if fact.scale_provenance == {.Measured(_, _, _) -> true else -> false}
}

fn sema_expr_unit_is_symbolic(fact: SemaRegistrationUnitFact) -> Bool Never! {
    if fact.scale_provenance == {.SymbolicPi(_, _) -> true else -> false}
}

fn sema_expr_unit_conversion_total(source: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact) -> Bool Never! {
    sema_expr_unit_ratio_equal(source.scale, destination.scale) && sema_expr_unit_ratio_equal(source.offset, destination.offset)
}

fn sema_expr_unit_conversion_method(fact: SemaRegistrationUnitFact) -> String Never! {
    parts := fact.name.split(".").to_list()
    leaf := if parts.len() > 0 -> parts[parts.len() - 1] else -> fact.name
    bytes := leaf.bytes()
    output := [U8]{}
    index := 0
    loop index < bytes.len() {
        code := Int.from_u8(bytes[index])
        previous := if index > 0 -> Int.from_u8(bytes[index - 1]) else -> 0
        next := if index + 1 < bytes.len() -> Int.from_u8(bytes[index + 1]) else -> 0
        uppercase := code >= 65 && code <= 90
        boundary := uppercase && index > 0 && ((previous >= 97 && previous <= 122) || (previous >= 65 && previous <= 90 && next >= 97 && next <= 122))
        if boundary -> &output.push(U8{95})
        if uppercase -> &output.push(U8{code + 32}) else -> &output.push(bytes[index])
        index += 1
    }
    snake := String.from_bytes(output) ?? leaf
    "from_{snake}"
}
fn sema_expr_unit_concrete_value(value: TExpr) -> Float? {
    if value.kind == {
        .IntLit(number, _) -> return Val(Float.from_int(number))
        .FloatLit(number) -> return Val(number)
        .CtLit(comptime_value) -> {
            if comptime_value == {
                .Int(number) -> return Val(Float.from_int(number))
                .Float(number, _) -> return Val(number)
                else -> {}
            }
        }
        .Unary(op, operand) -> {
            if op == TUnaryOp.Neg {
                concrete :: sema_expr_unit_concrete_value(operand) ?? return None
                return Val(-concrete)
            }
        }
        .UnitConvert(_, argument, _, _, _, _, _, _, _) -> return sema_expr_unit_concrete_value(argument)
        .MethodCall(_, method, _, args) -> {
            if method.name == "from_float" && args.len() == 1 {
                argument := args[0].value
                if argument.kind == {
                    .FloatLit(number) -> return Val(number)
                    .IntLit(number, _) -> return Val(Float.from_int(number))
                    .Unary(op, operand) -> {
                        if op == TUnaryOp.Neg {
                            if operand.kind == {
                                .FloatLit(number) -> return Val(-number)
                                .IntLit(number, _) -> return Val(-Float.from_int(number))
                                else -> {}
                            }
                        }
                    }
                    else -> {}
                }
            }
        }
        else -> {}
    }
    None
}

fn sema_expr_unit_exact_proof(concrete: Float, source: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact, environment: SemaScopeEnvironment) -> Bool? {
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return None
    scale :: sema_expr_unit_ratio_div(source.scale, destination.scale) ?? return Val(false)
    offset :: sema_expr_unit_ratio_div(sema_expr_unit_ratio_sub(source.offset, destination.offset), destination.scale) ?? return Val(false)
    proof := sema_numeric_unit_conversion_exact(graph, concrete, scale, offset)
    if proof == {
        .Exact(_) -> return Val(true)
        .Inexact -> return Val(false)
        .Unavailable -> return None
    }
}

fn sema_expr_unit_conversion_gate(value: TExpr, source: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if source.name == destination.name -> return true
    if sema_expr_unit_is_measured(source) || sema_expr_unit_is_measured(destination) {
        measured := if sema_expr_unit_is_measured(source) -> source else -> destination
        if measured.scale_provenance == {
            .Measured(central_value, standard_uncertainty, provenance_source) -> {
                &diagnostics.push(sema_error("E0127", span, "`{source.name}` to `{destination.name}` crosses a measured scale", "the pinned central value is {central_value} with standard uncertainty {standard_uncertainty} ({provenance_source})", "write an explicit rounded conversion to `{destination.name}` and audit the pinned source"))
            }
            else -> {}
        }
        return false
    }
    if !sema_expr_unit_conversion_is_finite(source, destination) {
        &diagnostics.push(sema_error("E0127", span, "this unit conversion overflows its runtime representation", "the declared exact scale or offset is outside Float's finite range", "choose units with a finite conversion boundary"))
        return false
    }
    if !sema_expr_unit_is_symbolic(source) && !sema_expr_unit_is_symbolic(destination) && !sema_expr_unit_conversion_total(source, destination) {
        exact := false
        concrete := sema_expr_unit_concrete_value(value)
        if concrete != None {
            exact = sema_expr_unit_exact_proof(concrete ?? 0.0, source, destination, environment) ?? return false
        }
        if !exact && !sema_scope_knowledge_gate_allows(scopes, SemaKnowledgePlane.Unit, SemaKnowledgeGate.RoundedConversion) {
            method := sema_expr_unit_conversion_method(source)
            &diagnostics.push(sema_error("E0127", span, "this implicit unit conversion would round", "the exact scale or offset cannot be represented as an integer conversion at this boundary", "write `{destination.name}.{method}_rounded(expr, .NearestEven, digits: 0)?` or choose another rounding policy"))
            return false
        }
    }
    if sema_scope_unit_explicit_units(scopes) {
        method := sema_expr_unit_conversion_method(source)
        &diagnostics.push(sema_error("E0127", span, "`explicit_units` requires a written conversion", "this scope does not convert `{source.name}` to `{destination.name}` implicitly", "write `{destination.name}.{method}(expr)"))
        return false
    }
    true
}

fn sema_expr_unit_conversion_pair_allowed(left_value: TExpr, left: SemaRegistrationUnitFact, left_destination: SemaRegistrationUnitFact, right_value: TExpr, right: SemaRegistrationUnitFact, right_destination: SemaRegistrationUnitFact, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    if !sema_expr_unit_conversion_gate(left_value, left, left_destination, span, environment, &scopes, &diagnostics) -> return false
    sema_expr_unit_conversion_gate(right_value, right, right_destination, span, environment, &scopes, &diagnostics)
}

fn sema_expr_unit_ratio_is_finite(value: UnitRatio) -> Bool {
    numerator := Float.from_int(value.numerator)
    denominator := Float.from_int(value.denominator)
    math.is_finite(numerator) && math.is_finite(denominator) && denominator != 0.0
}

fn sema_expr_unit_conversion_is_finite(source: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact) -> Bool {
    scale :: sema_expr_unit_ratio_div(source.scale, destination.scale) ?? return false
    offset :: sema_expr_unit_ratio_div(sema_expr_unit_ratio_sub(source.offset, destination.offset), destination.scale) ?? return false
    sema_expr_unit_ratio_is_finite(scale) && sema_expr_unit_ratio_is_finite(offset)
}


fn sema_expr_dimension_add_axis(axes: &[DimensionAxis], name: String, exponent: Int) -> Bool Never! {
    index := 0
    loop index < axes.len() {
        if axes[index].name == name {

            current :: measure_signed_value(axes[index].exponent) ?? return false
            next := current + exponent
            if {
                next == 0 -> {
                    _ := &axes.remove(index, .Slot)
                }
                else -> {
                    axes[index].exponent = Measure.SignedLiteral{kind: "dimension", value: next}
                }
            }
            return true
        }
        index += 1
    }
    if exponent != 0 -> &axes.push(DimensionAxis{name: name, exponent: Measure.SignedLiteral{kind: "dimension", value: exponent}})
    true
}
fn sema_expr_unit_quantity_base_is_float(ty: Type, environment: SemaScopeEnvironment) -> Bool Never! {
    if ty == {
        .Quantity(base, _) -> return base == Type.Float
        else -> {}
    }
    if sema_expr_unit_fact(ty, environment) != None -> return true
    ty == Type.Float
}

fn sema_expr_dimension_combine(left: Dimension, right: Dimension, multiply: Bool) -> Dimension? {
    axes := [DimensionAxis]{}
    loop axis in left.axes {
        exponent :: measure_signed_value(axis.exponent) ?? return None
        if !sema_expr_dimension_add_axis(&axes, axis.name, exponent) -> return None
    }
    loop axis in right.axes {
        exponent := measure_signed_value(axis.exponent) ?? return None
        if !multiply -> exponent = -exponent
        if !sema_expr_dimension_add_axis(&axes, axis.name, exponent) -> return None
    }
    Val(Dimension{axes: axes})
}

fn sema_expr_unit_dimension(ty: Type, environment: SemaScopeEnvironment) -> Dimension? {
    if ty == {
        .Quantity(_, dimension) -> return Val(dimension)
        else -> {}
    }
    fact := sema_expr_unit_fact(ty, environment) ?? return None
    fact.dimension
}

fn sema_expr_unit_counterpart(fact: SemaRegistrationUnitFact, kind: QuantityKind, environment: SemaScopeEnvironment) -> SemaRegistrationUnitFact? {
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return None
    loop candidate in graph.unit_facts {
        if candidate.package == fact.package && candidate.family == fact.family && candidate.member == fact.member && candidate.kind == kind -> return Val(candidate)
    }
    None
}

fn sema_expr_unit_raw(value: TExpr, span: Span) -> TExpr Never! {
    sema_tir_expr(Type.Float, TExprKind.DistinctRaw{value: value}, span)
}

fn sema_expr_unit_measured_relative_uncertainty(fact: SemaRegistrationUnitFact) -> Float? {
    if fact.scale_provenance == {
        .Measured(_, standard_uncertainty, _) -> {
            uncertainty :: Float.parse(standard_uncertainty) ?? return None
            numerator := Float.from_int(fact.scale.numerator)
            denominator := Float.from_int(fact.scale.denominator)
            scale := math.fabs(numerator / denominator)
            if !math.is_finite(scale) || scale <= 0.0 -> return None
            return Val(math.fabs(uncertainty) / scale)
        }
        else -> None
    }
}

fn sema_expr_unit_relative_uncertainty(source: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact) -> Float? {
    source_value := sema_expr_unit_measured_relative_uncertainty(source)
    destination_value := sema_expr_unit_measured_relative_uncertainty(destination)
    if source_value == None && destination_value == None -> return None
    left := source_value ?? 0.0
    right := destination_value ?? 0.0
    Val(math.hypot(left, right))
}

fn sema_expr_unit_conversion(value: TExpr, source: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact, span: Span, line: Int, environment: SemaScopeEnvironment) -> TExpr Never! {
    if source.name == destination.name -> return ~value
    scale :: sema_expr_unit_ratio_div(source.scale, destination.scale) ?? UnitRatio{numerator: 1, denominator: 1}
    offset := sema_expr_unit_ratio_div(sema_expr_unit_ratio_sub(source.offset, destination.offset), destination.scale) ?? UnitRatio{numerator: 0, denominator: 1}
    destination_symbol := symbol_id(SymbolKind.Type, destination.package, "", destination.name)
    relative_uncertainty := sema_expr_unit_relative_uncertainty(source, destination)
    sema_tir_expr(Type.Named{name: destination.name}, TExprKind.UnitConvert{destination: destination_symbol, argument: value, scale: sema_expr_unit_ratio_text(scale), offset: sema_expr_unit_ratio_text(offset), rounding: None, fallible: false, relative_uncertainty: relative_uncertainty, file: environment.source_file, line: line}, span)
}

fn sema_expr_unit_arithmetic_mismatch(op: BinOp, lhs: Type, rhs: Type, span: Span, diagnostics: &[Diagnostic]) {
    &diagnostics.push(sema_error("E0127", span, "{sema_expr_binary_name(op)} is not available between `{type_name(lhs)}` and `{type_name(rhs)}`", "unit-family arithmetic only defines scalar scaling and physical dimension algebra; nominal units and affine points do not multiply or divide", "scale a linear unit or delta by a plain numeric scalar, or use a dimensioned linear/delta family for physical products"))
}

fn sema_expr_unit_dimension_mismatch(op: BinOp, left: Dimension, right: Dimension, span: Span, diagnostics: &[Diagnostic]) {
    &diagnostics.push(sema_error("E0359", span, "{sema_expr_binary_name(op)} can't combine {dimension_display_name(left)} with {dimension_display_name(right)}", "physical quantities must have compatible dimensions before they can be added, subtracted, or compared", "use matching dimensions, or use `*` or `/` to derive a new dimension"))
}

fn sema_expr_unit_is_time(fact: SemaRegistrationUnitFact) -> Bool Never! {
    fact.family == "Time" && fact.package == "core.units"
}

fn sema_expr_unit_is_scalable(fact: SemaRegistrationUnitFact) -> Bool Never! {
    !sema_expr_unit_is_time(fact) && (fact.kind == QuantityKind.Linear || fact.kind == QuantityKind.Delta)
}

fn sema_expr_unit_binary_result(op: BinOp, lhs: TExpr, rhs: TExpr, left_fact: SemaRegistrationUnitFact, right_fact: SemaRegistrationUnitFact, destination: SemaRegistrationUnitFact, span: Span, line: Int, environment: SemaScopeEnvironment) -> TExpr Never! {
    left_value := sema_expr_unit_raw(sema_expr_unit_conversion(lhs, left_fact, destination, span, line, environment), span)
    right_value := sema_expr_unit_raw(sema_expr_unit_conversion(rhs, right_fact, destination, span, line, environment), span)
    raw := sema_tir_expr(Type.Float, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: left_value, rhs: right_value}, span)
    if op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge {
        return sema_tir_expr(Type.Bool, raw.kind, span)
    }
    if op == BinOp.Compare -> return sema_tir_expr(Type.Named{name: "Ordering"}, raw.kind, span)
    sema_expr_unit_wrap_raw(raw, destination, span, line, environment)
}

fn sema_expr_unit_wrap_raw(value: TExpr, fact: SemaRegistrationUnitFact, span: Span, line: Int, environment: SemaScopeEnvironment) -> TExpr Never! {
    destination_symbol := symbol_id(SymbolKind.Type, fact.package, "", fact.name)
    relative_uncertainty := sema_expr_unit_measured_relative_uncertainty(fact)
    sema_tir_expr(Type.Named{name: fact.name}, TExprKind.UnitConvert{destination: destination_symbol, argument: value, scale: "1/1", offset: "0/1", rounding: None, fallible: false, relative_uncertainty: relative_uncertainty, file: environment.source_file, line: line}, span)
}

fn sema_expr_unit_dimensions_equal(left: Dimension?, right: Dimension?) -> Bool Never! {
    if left == None || right == None -> return left == None && right == None
    dimension_identity(left ?? Dimension{axes: [DimensionAxis]{}}) == dimension_identity(right ?? Dimension{axes: [DimensionAxis]{}})
}

fn sema_expr_unit_dimension_overflow(op: BinOp, span: Span, diagnostics: &[Diagnostic]) {
    &diagnostics.push(sema_error("E0359", span, "{sema_expr_binary_name(op)} makes the physical dimension too large", "physical dimension exponents are checked compiler facts and cannot overflow", "simplify the repeated physical multiplication or division"))
}

fn sema_expr_unit_mixed_result(op: BinOp, lhs: TExpr, rhs: TExpr, left_source: SemaRegistrationUnitFact, left_destination: SemaRegistrationUnitFact, right_source: SemaRegistrationUnitFact, right_destination: SemaRegistrationUnitFact, result_ty: Type, span: Span, line: Int, environment: SemaScopeEnvironment) -> TExpr Never! {
    left_value := sema_expr_unit_raw(sema_expr_unit_conversion(lhs, left_source, left_destination, span, line, environment), span)
    right_value := sema_expr_unit_raw(sema_expr_unit_conversion(rhs, right_source, right_destination, span, line, environment), span)
    raw := sema_tir_expr(Type.Float, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: left_value, rhs: right_value}, span)
    result_fact := sema_expr_unit_fact(result_ty, environment) ?? left_destination
    sema_expr_unit_wrap_raw(raw, result_fact, span, line, environment)
}

fn sema_expr_check_unit_binary(op: BinOp, lhs: TExpr, rhs: TExpr, span: Span, line: Int, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> TExpr? {
    left_fact := sema_expr_unit_fact(lhs.ty, environment)
    right_fact := sema_expr_unit_fact(rhs.ty, environment)
    left_dimension := sema_expr_unit_dimension(lhs.ty, environment)
    right_dimension := sema_expr_unit_dimension(rhs.ty, environment)
    if left_fact == None && right_fact == None && left_dimension == None && right_dimension == None -> return None

    if op == BinOp.Mul || op == BinOp.Div {
        if left_fact != None && right_fact == None && sema_expr_is_numeric(rhs.ty) {
            fact :: left_fact ?? return None
            if !sema_expr_unit_is_scalable(fact) {
                sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, &diagnostics)
                return None
            }
            scalar :: sema_expr_numeric_conversion(rhs, Type.Float, span, line) ?? return None
            raw := sema_tir_expr(Type.Float, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: sema_expr_unit_raw(lhs, span), rhs: scalar}, span)
            return Val(sema_expr_unit_wrap_raw(raw, fact, span, line, environment))
        }
        if right_fact != None && left_fact == None && sema_expr_is_numeric(lhs.ty) {
            fact :: right_fact ?? return None
            if op != BinOp.Mul || !sema_expr_unit_is_scalable(fact) {
                sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, &diagnostics)
                return None
            }
            scalar :: sema_expr_numeric_conversion(lhs, Type.Float, span, line) ?? return None
            raw := sema_tir_expr(Type.Float, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: scalar, rhs: sema_expr_unit_raw(rhs, span)}, span)
            return Val(sema_expr_unit_wrap_raw(raw, fact, span, line, environment))
        }
        if left_fact != None && right_fact != None {
            left :: left_fact ?? return None
            right :: right_fact ?? return None
            if left.kind == QuantityKind.Point || right.kind == QuantityKind.Point || left.dimension == None || right.dimension == None {
                sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, &diagnostics)
                return None
            }
            dimensions :: sema_expr_dimension_combine(left.dimension ?? Dimension{axes: [DimensionAxis]{}}, right.dimension ?? Dimension{axes: [DimensionAxis]{}}, op == BinOp.Mul) ?? {
                sema_expr_unit_dimension_overflow(op, span, &diagnostics)
                return None
            }
            raw_lhs := sema_expr_unit_raw(lhs, span)
            raw_rhs := sema_expr_unit_raw(rhs, span)
            raw := sema_tir_expr(Type.Float, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: raw_lhs, rhs: raw_rhs}, span)
            if dimensions.axes.len() == 0 -> return Val(raw)
            return Val(sema_tir_expr(Type.Quantity{base: Type.Float, dimension: dimensions}, raw.kind, span))
        }
        if left_dimension != None || right_dimension != None {
            left_point := false
            if left_fact != None {
                left_unit :: left_fact ?? return None
                left_point = left_unit.kind == QuantityKind.Point
            }
            right_point := false
            if right_fact != None {
                right_unit :: right_fact ?? return None
                right_point = right_unit.kind == QuantityKind.Point
            }
            if left_point || right_point {
                sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, &diagnostics)
                return None
            }
            if !sema_expr_unit_quantity_base_is_float(lhs.ty, environment) || !sema_expr_unit_quantity_base_is_float(rhs.ty, environment) {
                &diagnostics.push(sema_error("E0109", span, "{sema_expr_binary_name(op)} can't compare or combine {type_name(lhs.ty)} and {type_name(rhs.ty)}", "the operator has no built-in rule and no user-defined `impl Type.Trait` hook for this operand pair", "use a supported operand pair, call a named method, or implement the operator's hook trait on your own type for this pair"))
                return None
            }
            left_dim :: left_dimension ?? Dimension{axes: [DimensionAxis]{}}
            right_dim :: right_dimension ?? Dimension{axes: [DimensionAxis]{}}
            dimensions :: sema_expr_dimension_combine(left_dim, right_dim, op == BinOp.Mul) ?? {
                sema_expr_unit_dimension_overflow(op, span, &diagnostics)
                return None
            }
            left_value := if sema_expr_unit_fact(lhs.ty, environment) != None -> sema_expr_unit_raw(lhs, span) else -> lhs
            right_value := if sema_expr_unit_fact(rhs.ty, environment) != None -> sema_expr_unit_raw(rhs, span) else -> rhs
            raw := sema_tir_expr(Type.Float, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: left_value, rhs: right_value}, span)
            if dimensions.axes.len() == 0 -> return Val(raw)
            return Val(sema_tir_expr(Type.Quantity{base: Type.Float, dimension: dimensions}, raw.kind, span))
        }
    }

    if left_fact != None && right_fact != None {
        left :: left_fact ?? return None
        right :: right_fact ?? return None
        same_family := left.package == right.package && left.family == right.family
        if !same_family {
            sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, &diagnostics)
            return None
        }
        if !sema_expr_unit_dimensions_equal(left.dimension, right.dimension) {
            if left.dimension != None || right.dimension != None {
                sema_expr_unit_dimension_mismatch(op, left.dimension ?? Dimension{axes: [DimensionAxis]{}}, right.dimension ?? Dimension{axes: [DimensionAxis]{}}, span, &diagnostics)
            }
            return None
        }
        comparisons := op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge || op == BinOp.Compare
        if comparisons && left.kind == right.kind {
            destination := if sema_expr_unit_ratio_le(left.scale, right.scale) -> left else -> right
            if !sema_expr_unit_conversion_pair_allowed(lhs, left, destination, rhs, right, destination, span, environment, &scopes, &diagnostics) -> return None
            return Val(sema_expr_unit_binary_result(op, lhs, rhs, left, right, destination, span, line, environment))
        }
        if op == BinOp.Add || op == BinOp.Sub {
            if left.kind == QuantityKind.Point && right.kind == QuantityKind.Delta {
                delta_destination :: sema_expr_unit_counterpart(left, QuantityKind.Delta, environment) ?? return None
                if !sema_expr_unit_conversion_pair_allowed(lhs, left, left, rhs, right, delta_destination, span, environment, &scopes, &diagnostics) -> return None
                return Val(sema_expr_unit_mixed_result(op, lhs, rhs, left, left, right, delta_destination, Type.Named{name: left.name}, span, line, environment))
            }
            if left.kind == QuantityKind.Delta && right.kind == QuantityKind.Point && op == BinOp.Add {
                delta_destination :: sema_expr_unit_counterpart(right, QuantityKind.Delta, environment) ?? return None
                if !sema_expr_unit_conversion_pair_allowed(lhs, left, delta_destination, rhs, right, right, span, environment, &scopes, &diagnostics) -> return None
                return Val(sema_expr_unit_mixed_result(op, lhs, rhs, left, delta_destination, right, right, Type.Named{name: right.name}, span, line, environment))
            }
            if left.kind == QuantityKind.Point && right.kind == QuantityKind.Point && op == BinOp.Sub {
                destination := if sema_expr_unit_ratio_le(left.scale, right.scale) -> left else -> right
                delta_destination :: sema_expr_unit_counterpart(destination, QuantityKind.Delta, environment) ?? return None
                if !sema_expr_unit_conversion_pair_allowed(lhs, left, destination, rhs, right, destination, span, environment, &scopes, &diagnostics) -> return None
                return Val(sema_expr_unit_mixed_result(op, lhs, rhs, left, destination, right, destination, Type.Named{name: delta_destination.name}, span, line, environment))
            }
            if (left.kind == QuantityKind.Linear && right.kind == QuantityKind.Linear) || (left.kind == QuantityKind.Delta && right.kind == QuantityKind.Delta) {
                destination := if sema_expr_unit_ratio_le(left.scale, right.scale) -> left else -> right
                if !sema_expr_unit_conversion_pair_allowed(lhs, left, destination, rhs, right, destination, span, environment, &scopes, &diagnostics) -> return None
                return Val(sema_expr_unit_binary_result(op, lhs, rhs, left, right, destination, span, line, environment))
            }
            if (left.kind == QuantityKind.Point && right.kind == QuantityKind.Point) || (left.kind == QuantityKind.Delta && right.kind == QuantityKind.Point) {
                sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, &diagnostics)
                return None
            }
        }
        sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, &diagnostics)
        return None
    }

    if left_dimension != None || right_dimension != None {
        if op == BinOp.Add || op == BinOp.Sub || op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge || op == BinOp.Compare {
            if left_dimension != None && right_dimension != None && !sema_expr_unit_dimensions_equal(left_dimension, right_dimension) {
                sema_expr_unit_dimension_mismatch(op, left_dimension ?? Dimension{axes: [DimensionAxis]{}}, right_dimension ?? Dimension{axes: [DimensionAxis]{}}, span, &diagnostics)
                return None
            }
            if type_identity_equal(lhs.ty, rhs.ty) {
                result_ty := if op == BinOp.Compare -> Type.Named{name: "Ordering"} else -> if op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge -> Type.Bool else -> lhs.ty
                return Val(sema_tir_expr(result_ty, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span))
            }
            sema_expr_unit_arithmetic_mismatch(op, lhs.ty, rhs.ty, span, &diagnostics)
            return None
        }
    }
    None
}

struct SemaIntegerRange {
    lo: Int
    hi: Int
}

fn sema_expr_integer_range(signed: Bool, bits: Int) -> SemaIntegerRange Never! {
    if bits <= 0 -> return SemaIntegerRange{lo: 0, hi: 0}
    if signed {
        limit :: 1 << (bits - 1)
        return SemaIntegerRange{lo: -limit, hi: limit - 1}
    }
    limit :: 1 << bits
    SemaIntegerRange{lo: 0, hi: limit - 1}
}

fn sema_expr_integer_fits(value: Int, signed: Bool, bits: Int) -> Bool Never! {
    if bits <= 0 -> return false
    bounds :: sema_expr_integer_range(signed, bits)
    value >= bounds.lo && value <= bounds.hi
}

fn sema_expr_integer_range_error(value: Int, signed: Bool, bits: Int, span: Span, diagnostics: &[Diagnostic]) {
    bounds :: sema_expr_integer_range(signed, bits)
    ty_name :: type_name(Type.IntN{signed: signed, bits: bits})
    &diagnostics.push(sema_error("E1003", span, "{value} does not fit exactly in {ty_name}", "{ty_name} holds every whole number only from {bounds.lo} through {bounds.hi}", "use a whole-number type, or write a value from {bounds.lo} through {bounds.hi}"))
}

// D-INTBIG1: the token's i64 field is only a fast path. An integer literal's
// exact value comes from its preserved spelling (Rust
// `exact_integer_literal`); a spelling that is not an integer literal keeps
// the token value.
fn sema_expr_exact_integer_literal(value: Int, raw: String?) -> Int Never! {
    text :: raw ?? return value
    bytes :: text.bytes()
    i := 0
    negative := false
    if bytes.len() > 0 && (Int.from_u8(bytes[0]) == 45 || Int.from_u8(bytes[0]) == 43) {
        negative = Int.from_u8(bytes[0]) == 45
        i = 1
    }
    radix := 10
    if i + 1 < bytes.len() && Int.from_u8(bytes[i]) == 48 {
        marker :: Int.from_u8(bytes[i + 1])
        if marker == 120 || marker == 88 -> radix = 16
        if marker == 111 || marker == 79 -> radix = 8
        if marker == 98 || marker == 66 -> radix = 2
        if radix != 10 -> i += 2
    }
    exact := 0
    digits := 0
    loop i < bytes.len() {
        code :: Int.from_u8(bytes[i])
        i += 1
        if code == 95 -> next
        digit :: if {
            code >= 48 && code <= 57 -> code - 48
            code >= 97 && code <= 122 -> code - 87
            code >= 65 && code <= 90 -> code - 55
            else -> radix
        }
        if digit >= radix -> return value
        exact = exact * radix + digit
        digits += 1
    }
    if digits == 0 -> return value
    if negative -> -exact else -> exact
}

// D-INTBIG1: a literal outside the i64 range keeps its exact value as a
// BigInt constant (Rust TIR `CtLit(BigInt)`); a fixed-width one crosses the
// checked Int-to-fixed conversion, as in Rust's lowering.
fn sema_expr_int_literal_tir(value: Int, ty: Type, width: TIntegerWidth?, span: Span, environment: SemaScopeEnvironment) -> TExpr? {
    bounds :: integer_bounds_exact(value)
    if value >= -9223372036854775807 - 1 && value <= 9223372036854775807 {
        return Val(TExpr{ty: ty, kind: TExprKind.IntLit{value: value, width: width}, span: span, integer_bounds: Val(bounds), cost: None})
    }
    big :: TExpr{ty: Type.Int, kind: TExprKind.CtLit{value: TComptimeValue.BigInt{decimal: "{value}"}}, span: span, integer_bounds: Val(bounds), cost: None}
    if width == None -> return Val(big)
    line :: sema_source_line_at(environment.source_segments, span) ?? 0
    sema_expr_numeric_conversion(big, ty, span, line)
}

fn sema_expr_integer_literal(value: Int, width: IntegerWidth?, expected: Type?, span: Span, environment: SemaScopeEnvironment, diagnostics: &[Diagnostic]) -> TExpr? {
    if expected != None {
        contextual_expected :: expected
        if contextual_expected == Type.Float || contextual_expected == Type.Float32 -> return None
    }
    ty := Type.Int
    tir_width := TIntegerWidth?{None}
    if {
        width != None -> {
            literal_width :: width
            ty = Type.IntN{signed: literal_width.signed, bits: literal_width.bits}
            tir_width = Val(TIntegerWidth{signed: literal_width.signed, bits: literal_width.bits})
        }
        expected != None -> {
            contextual :: expected
            if contextual == .IntN(signed, bits) {
                ty = contextual
                tir_width = Val(TIntegerWidth{signed: signed, bits: bits})
            }
        }
        else -> {}
    }
    if ty == {
        .IntN(signed, bits) -> {
            if !sema_expr_integer_fits(value, signed, bits) {
                sema_expr_integer_range_error(value, signed, bits, span, &diagnostics)
                return None
            }
        }
        else -> {}
    }
    bounded :: sema_expr_int_literal_tir(value, ty, tir_width, span, environment) ?? return None
    sema_expr_expected(bounded, expected, environment, &diagnostics)
}

fn sema_expr_negative_integer(value: Int, width: IntegerWidth?, expected: Type?, span: Span, environment: SemaScopeEnvironment, diagnostics: &[Diagnostic]) -> TExpr? {
    if expected != None {
        contextual_expected :: expected
        if contextual_expected == Type.Float || contextual_expected == Type.Float32 -> return None
    }
    ty := Type.Int
    tir_width := TIntegerWidth?{None}
    if {
        width != None -> {
            literal_width :: width
            ty = Type.IntN{signed: literal_width.signed, bits: literal_width.bits}
            tir_width = Val(TIntegerWidth{signed: literal_width.signed, bits: literal_width.bits})
        }
        expected != None -> {
            contextual :: expected
            if contextual == .IntN(signed, bits) {
                ty = contextual
                tir_width = Val(TIntegerWidth{signed: signed, bits: bits})
            }
        }
        else -> {}
    }
    negated := -value
    if ty == {
        .IntN(signed, bits) -> {
            if !sema_expr_integer_fits(negated, signed, bits) {
                sema_expr_integer_range_error(negated, signed, bits, span, &diagnostics)
                return None
            }
            if !sema_expr_integer_fits(value, signed, bits) -> return None
        }
        else -> {}
    }
    operand :: sema_expr_int_literal_tir(value, ty, tir_width, span, environment) ?? return None
    bounded :: TExpr{ty: ty, kind: TExprKind.Unary{op: TUnaryOp.Neg, operand: operand}, span: span, integer_bounds: Val(integer_bounds_exact(negated)), cost: None}
    sema_expr_expected(bounded, expected, environment, &diagnostics)
}

fn sema_expr_format_supported(ty: Type, format: StrFormat) -> Bool Never! {
    if format == {
        .Fixed(_) -> sema_expr_is_numeric(ty)
        .Grouped(_) -> sema_expr_is_numeric(ty)
        .Hex(_) -> sema_expr_is_integer(ty)
        .Pad(_, _) -> sema_expr_is_numeric(ty) || ty == Type.String || ty == Type.Bool || ty == Type.Char
        .PadLeft(_, _) -> sema_expr_is_numeric(ty) || ty == Type.String || ty == Type.Bool || ty == Type.Char
        .Sci(_) -> sema_expr_is_numeric(ty)
        .Percent(_) -> sema_expr_is_numeric(ty)
        .Bin -> sema_expr_is_integer(ty)
        .Oct -> sema_expr_is_integer(ty)
        .Unit(_) -> false
        .Display -> sema_expr_is_numeric(ty) || ty == Type.String || ty == Type.Bool || ty == Type.Char
        .Debug -> sema_expr_is_numeric(ty) || ty == Type.String || ty == Type.Bool || ty == Type.Char
        .Pretty -> sema_expr_is_numeric(ty) || ty == Type.String || ty == Type.Bool || ty == Type.Char
    }
}

fn sema_expr_call_callee(value: TExpr) -> SymbolID? {
    if value.kind == {
        .Call(symbol, _, _) -> return Val(symbol)
        .MethodCall(_, method, _, _) -> return Val(method.symbol)
        // A call behind its generated argument pins keeps its callee.
        .InlineBlock(body) -> {
            if body.len() == 0 -> return None
            loop index in 0..<body.len() - 1 {
                if body[index] == .Let(local, _, _, _, _, _) && local.generated -> next
                if body[index] == .Contract(_) -> next
                return None
            }
            if body[body.len() - 1] == .ExprStmt(tail, _) -> return sema_expr_call_callee(tail)
            return None
        }
        else -> None
    }
}
struct SemaExprComptimeTarget {
    module_identity: String
    declaration: Func
    path: String
    kind: String
}

fn sema_expr_comptime_method_target(methods: [Func], owner_name: String, module_identity: String, symbol: SymbolID) -> SemaExprComptimeTarget? {
    owner := symbol_id(SymbolKind.Type, module_identity, "", owner_name)
    loop method in methods {
        candidate :: symbol_id(SymbolKind.Function, module_identity, owner.key, method.name)
        if candidate.key == symbol.key -> return Val(SemaExprComptimeTarget{module_identity: module_identity, declaration: method, path: "{owner_name}.{method.name}", kind: "method"})
    }
    None
}

fn sema_expr_comptime_local_method_target(environment: SemaScopeEnvironment, symbol: SymbolID) -> SemaExprComptimeTarget? {
    loop row in environment.declarations {
        target :: if row.item == {
            .Struct(value) -> sema_expr_comptime_method_target(value.methods, value.name, environment.module_identity, symbol)
            .Enum(value) -> sema_expr_comptime_method_target(value.methods, value.name, environment.module_identity, symbol)
            else -> None
        }
        if target != None -> return target
    }
    None
}

fn sema_expr_comptime_target(environment: SemaScopeEnvironment, scopes: &SemaScopeTable, symbol: SymbolID) -> SemaExprComptimeTarget? {
    if environment.registration_graph == .Val(graph) {
        // One keyed `callable_rows` lookup (Rust `funcs.get`): top-level
        // functions and nominal methods are compile-time targets.
        row :: graph.callable_rows.get(symbol.key) ?? return None
        if row == {
            .Function(module_index, index) -> return Val(SemaExprComptimeTarget{module_identity: graph.modules[module_index].module_identity, declaration: graph.modules[module_index].functions[index].declaration, path: graph.modules[module_index].functions[index].symbol.name, kind: "function"})
            .NominalMethod(module_index, owner, index) -> return Val(SemaExprComptimeTarget{module_identity: graph.modules[module_index].module_identity, declaration: graph.modules[module_index].nominals[owner].methods[index].declaration, path: "{graph.modules[module_index].nominals[owner].symbol.name}.{graph.modules[module_index].nominals[owner].methods[index].symbol.name}", kind: "method"})
            else -> return None
        }
    }
    declaration :: sema_scope_resolve_declaration(environment, symbol) ?? {
        target :: sema_expr_comptime_local_method_target(environment, symbol) ?? return None
        return Val(target)
    }
    if declaration == {
        .Func(func) -> {
            module_identity := scopes.frames[0].owner
            loop binding in scopes.bindings {
                if binding.symbol.id.key == symbol.key -> module_identity = binding.symbol.module_name
            }
            return Val(SemaExprComptimeTarget{module_identity: module_identity, declaration: func, path: func.name, kind: "function"})
        }
        else -> {}
    }
    None
}

fn sema_expr_comptime_value(value: TExpr) -> TComptimeValue? {
    if value.kind == {
        .IntLit(number, _) -> {
            return Val(TComptimeValue.Int{value: number})
        }
        .FloatLit(number) -> return Val(TComptimeValue.Float{value: number, bits: if value.ty == Type.Float32 -> 32 else -> 64})
        .BoolLit(boolean) -> return Val(TComptimeValue.Bool{value: boolean})
        .CharLit(character) -> return Val(TComptimeValue.Char{value: character})
        .Unit -> return Val(TComptimeValue.Unit)
        .CtLit(comptime_value) -> return Val(comptime_value)
        .StrLit(parts) -> {
            text := ""
            loop part in parts {
                if part == {
                    .Literal(literal) -> text = "{text}{literal}"
                    else -> return None
                }
            }
            return Val(TComptimeValue.String{value: text})
        }
        .List(values, _) -> {
            output := [TComptimeValue]{}
            loop element in values {
                &output.push(sema_expr_comptime_value(element) ?? return None)
            }
            return Val(TComptimeValue.List{values: output})
        }
        .ListLit(values) -> {
            output := [TComptimeValue]{}
            loop element in values {
                &output.push(sema_expr_comptime_value(element) ?? return None)
            }
            return Val(TComptimeValue.List{values: output})
        }
        .Present(inner) | .Ok(inner) -> {
            converted :: sema_expr_comptime_value(inner) ?? return None
            return Val(TComptimeValue.Present{value: converted})
        }
        else -> None
    }
}

fn sema_expr_comptime_args(args: [TCallArg], receiver: TExpr?) -> [TComptimeValue]? {
    output := [TComptimeValue]{}
    if receiver != None {
        receiver_value :: receiver
        &output.push(sema_expr_comptime_value(receiver_value) ?? return None)
    }
    loop arg in args -> &output.push(sema_expr_comptime_value(arg.value) ?? return None)
    Val(output)
}

fn sema_expr_comptime_call_args(value: TExpr) -> [TComptimeValue]? {
    if value.kind == {
        .Call(_, _, args) -> return sema_expr_comptime_args(args, None)
        .MethodCall(receiver, _, _, args) -> return sema_expr_comptime_args(args, Val(receiver))
        else -> None
    }
}

fn sema_expr_record_call_fact(environment: SemaScopeEnvironment, scopes: &SemaScopeTable, context: &SemaCheckContext, span: Span, checked: SemaCallChecked, diagnostics: &[Diagnostic]) -> Bool {
    wall := sema_effect_check_transaction_wall(environment, scopes, checked.facts.effect_bound, sema_effect_call_api(checked.value), span, &diagnostics)
    allowed :: wall ?? return false
    if !allowed -> return false
    callee := sema_expr_call_callee(checked.value)
    &context.call_facts.push(SemaCallSiteFact{
        span: span,
        caller_key: sema_scope_function_owner_key(scopes),
        callee: callee,
        facts: checked.facts,
        discarded: false,
    })
    symbol :: callee ?? return true
    target :: sema_expr_comptime_target(environment, &scopes, symbol) ?? return true
    if !target.declaration.is_comptime -> return true
    if scopes.comptime_execution_depth > 0 -> return true
    args :: sema_expr_comptime_call_args(checked.value) ?? {
        &diagnostics.push(sema_error("E0956", span, "compile-time call `{target.path}` needs compile-time value arguments", "the deferred MIR evaluator receives only canonical TComptimeValue arguments", "pass supported compile-time values to this call"))
        return false
    }
    &context.comptime_requests.push(SemaComptimeRequest{callee_key: symbol.key, module_identity: target.module_identity, args: args, span: span, checked_text: None})
    true
}

fn sema_expr_type_base_name(ty: Type) -> String? {
    if ty == {
        .Named(name) -> return Val(name)
        .Apply(name, _) -> return Val(name)
        else -> None
    }
}

fn sema_expr_registration_method_candidates(graph: SemaRegistrationGraph, receiver_type: Type, method: String, owner_type_args: [Type], type_args: [Type], span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> [SemaCallMethodCandidate] Never! {
    candidates := [SemaCallMethodCandidate]{}
    caller_module := environment.module_identity
    caller_package := ""
    if sema_registration_module_index(graph, caller_module) == .Val(caller_index) -> caller_package = graph.modules[caller_index].package_identity
    trait_candidates := sema_call_trait_method_candidates(graph, receiver_type, method, type_args, caller_module, caller_package, environment.generic_params, span, &diagnostics)
    if trait_candidates.len() > 0 -> return trait_candidates
    receiver_name :: sema_expr_type_base_name(receiver_type) ?? return candidates
    // The rows are keyed by the declared spelling (`Rect`); a resolved
    // receiver carries its canonical identity (`module::Rect`), so the row key
    // is the canonical leaf, and such a receiver is inferred against the
    // declaration resolved in its own module (as operator lookup does).
    receiver_canonical :: receiver_name.contains("::")
    found_owner := false
    loop nominal_row in sema_registration_nominal_rows_named(graph, sema_expr_operator_row_name(receiver_name)) {
        owner_index :: nominal_row.module_index
        nominal :: graph.modules[owner_index].nominals[nominal_row.row]
        found_owner = true
        inference_ty := nominal.ty
        if receiver_canonical -> inference_ty = sema_type_resolve_declared(graph, nominal.ty, graph.modules[owner_index].module_identity)
        owner_inference :: sema_infer_registered_nominal(nominal, inference_ty, environment.registration_graph, caller_module, caller_package, environment.generic_params, receiver_type, owner_type_args, None, span, &diagnostics) ?? next
        if !owner_inference.complete || !owner_inference.compatible -> next
        owner_type := sema_inference_substitute_type_bindings(nominal.ty, owner_inference.substitutions)
        loop function in nominal.methods {
            if function.symbol.name != method || function.parameters.len() == 0 -> next
            if !sema_registration_visible(function.symbol.visibility, caller_module, caller_package, graph.modules[owner_index].module_identity, graph.modules[owner_index].package_identity) -> next
            method_signature :: sema_inference_substitute_type_bindings(function.signature, owner_inference.substitutions)
            method_ref := TMethodRef{symbol: function.symbol.id, name: function.symbol.name, mangled: true, trait_owner: None, operator_identity: None}
            candidate :: sema_call_method_candidate_from_registration(method_signature, function.generic_params, environment.registration_graph, caller_module, caller_package, environment.generic_params, Val(owner_type), function.parameters[0].convention, 1, method_ref, type_args, span, &diagnostics) ?? next
            &candidates.push(candidate)
        }
    }
    if !found_owner -> return sema_call_local_method_candidates(environment, method, owner_type_args, type_args)
    candidates
}

// True only when a declared nominal method collides with a builtin handle
// method of the same owner leaf and name (Core's `URL`/`MIME`, or a user type
// spelled like a handle carrier); every other declared method keeps the
// special routes, as in the Rust TIR lowering's handle_method_op gate.
fn sema_expr_declares_nominal_method(environment: SemaScopeEnvironment, receiver_type: Type, method: String) -> Bool Never! {
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return false
    // A resolved receiver carries its canonical identity (`module::URL`).
    base_name :: sema_expr_type_base_name(receiver_type) ?? return false
    receiver_name :: sema_expr_operator_row_name(base_name)
    if !sema_text_handle_known_method(receiver_name, method) && !sema_network_handle_known_method(receiver_name, method) -> return false
    loop nominal_row in sema_registration_nominal_rows_named(graph, receiver_name) {
        methods :: graph.modules[nominal_row.module_index].nominals[nominal_row.row].methods
        loop method_index in 0..<methods.len() {
            function :: methods[method_index]
            if function.symbol.name == method && function.parameters.len() > 0 -> return true
        }
    }
    false
}

// Rust `funcs.get(name)`: some declared function (local or imported) has
// this name in any frame, even when a nearer binding shadows it.
fn sema_expr_declared_function_named(scopes: SemaScopeTable, name: String) -> Bool Never! {
    slot :: scopes.name_slots.get(name) ?? return false
    loop index in scopes.name_positions[slot] {
        if scopes.bindings[index].symbol.kind == SymbolKind.Function -> return true
    }
    false
}

fn sema_expr_check_direct_call(call: Call, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if sema_expression_zip_family_name(call.name) && sema_scope_resolve_index(scopes, call.name) == None {
        return sema_expression_zip_free_call(call, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    no_prelude := sema_marker_rules_no_prelude_call(call, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if no_prelude -> return None
    core_direct := sema_call_try_core_direct_call(call, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if core_direct.handled -> return core_direct.value
    // D-LIN1-DROP: the `consume` builtin, unless a user `consume` shadows it.
    if call.name == "consume" && sema_call_gate_is_unshadowed(call.name, scopes) -> return sema_single_use_check_consume(call, environment, &scopes, &state, &tail_store, &context, &diagnostics).value
    special := sema_call_try_knowledge_builtin(call, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if special.handled -> return special.value
    ambient := sema_call_try_ambient_prelude(call, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if ambient.handled -> return ambient.value
    // Rust `infer_call` callable-binding route (`direct_calls.rs`): only when
    // no declared function has the name (`funcs.get(name).is_none()`), a
    // parameter or local whose type is a function is called as a value.
    callable_index := sema_scope_resolve_index(scopes, call.name)
    if callable_index == .Val(index) && !sema_expr_declared_function_named(scopes, call.name) {
        callable :: scopes.bindings[index].symbol
        if callable.kind != SymbolKind.Function && callable.ty == .Val(callable_ty) && sema_call_type_is_function(callable_ty) {
            value_end := call.name_span.end
            if call.args.len() > 0 -> value_end = expr_span(call.args[call.args.len() - 1].expr).end
            return sema_expr_check_indirect_call(Expr.Ident{name: call.name, span: call.name_span}, call.args, Span{start: call.name_span.start, end: value_end}, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        }
    }
    if sema_call_default_err_candidate(call, expected, scopes) {
        scopes.ownership_call_depth += 1
        checked_default := sema_call_check_default_err(call, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        scopes.ownership_call_depth -= 1
        value :: checked_default ?? return None
        return Val(value)
    }
    scopes.ownership_call_depth += 1
    target :: sema_call_resolve_direct(call.name, call.type_args, environment, &scopes, call.name_span, &diagnostics) ?? {
        scopes.ownership_call_depth -= 1
        return None
    }
    checked := sema_call_check_direct_target_owned(&state, target, call, [SemaCallDefaultValue]{}, expected, environment, &scopes, &tail_store, &context, &diagnostics)
    scopes.ownership_call_depth -= 1
    value :: checked ?? return None
    &context.call_return_views.push(SemaCallReturnView{span: call.name_span, facts: value.return_view_facts})
    if !sema_expr_record_call_fact(environment, &scopes, &context, call.name_span, value, &diagnostics) -> return None
    Val(value.value)
}

fn sema_expr_check_indirect_call(callee: Expr, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    scopes.ownership_call_depth += 1
    checked := sema_call_check_value_owned(&state, callee, args, span, [SemaCallDefaultValue]{}, expected, environment, &scopes, &tail_store, &context, &diagnostics)
    scopes.ownership_call_depth -= 1
    value :: checked ?? return None
    &context.call_return_views.push(SemaCallReturnView{span: span, facts: value.return_view_facts})
    if !sema_expr_record_call_fact(environment, &scopes, &context, span, value, &diagnostics) -> return None
    Val(value.value)
}

fn sema_expr_unit_rounding_mode(value: Expr) -> TUnitRoundingMode? {
    if value == {
        .EnumLit(type_name, variant, _, args, _, _) -> {
            if type_name != "" || args.len() != 0 -> return None
            if variant == "TowardZero" -> return Val(TUnitRoundingMode.TowardZero)
            if variant == "Floor" -> return Val(TUnitRoundingMode.Floor)
            if variant == "Ceiling" -> return Val(TUnitRoundingMode.Ceiling)
            if variant == "NearestEven" -> return Val(TUnitRoundingMode.NearestEven)
        }
        else -> {}
    }
    None
}

fn sema_expr_check_unit_conversion_source(argument: Expr, method: String, rounded: Bool, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], rounded_allowed: &Bool) -> TExpr? {
    rounded_allowed = !rounded
    if rounded {
        gate := sema_call_method_gate(method) ?? SemaKnowledgeGate.RoundedConversion
        gate_scope := sema_call_enter_gate(&scopes, gate)
        rounded_allowed = sema_scope_knowledge_gate_allows(scopes, SemaKnowledgePlane.Unit, SemaKnowledgeGate.RoundedConversion)
        scopes.ownership_call_depth += 1
        checked := sema_check_expression(argument, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        scopes.ownership_call_depth -= 1
        sema_call_leave_gate(&scopes, gate_scope)
        return checked
    }
    scopes.ownership_call_depth += 1
    checked := sema_check_expression(argument, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    scopes.ownership_call_depth -= 1
    checked
}

// Checks `value` for its own type only, on the live scope table and context:
// both are rolled back afterwards and the ownership state is a throwaway copy,
// so the probe leaves nothing behind except what it reports to `diagnostics`.
// This replaces whole-table snapshots, which copied every module binding and
// every row the function had accumulated, per probe.
pub fn sema_probe_expression(value: Expr, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    scope_mark :: sema_scope_mark(&scopes)
    context_mark :: sema_check_context_mark(&context)
    probe_state := sema_ownership_state_snapshot(state)
    checked :: sema_check_expression(value, expected, environment, &scopes, &probe_state, &tail_store, &context, &diagnostics)
    sema_check_context_rollback(&context, context_mark)
    sema_scope_rollback(&scopes, scope_mark)
    checked
}

fn sema_expr_try_explicit_unit_method(receiver: Expr, method: String, method_span: Span, args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    destination_name := ""
    if receiver == {
        .Ident(name, _) -> destination_name = name
        else -> return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if !method.starts_with("from_") -> return SemaMethodSpecialCheck{handled: false, value: None}
    destination_fact :: sema_expr_unit_fact(Type.Named{name: destination_name}, environment) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    rounded := sema_call_method_gate(method) != None
    if {
        rounded -> {
            if args.len() != 3 -> return SemaMethodSpecialCheck{handled: false, value: None}
            _ := sema_expr_unit_rounding_mode(args[1].expr) ?? return SemaMethodSpecialCheck{handled: false, value: None}
            label :: args[2].label ?? return SemaMethodSpecialCheck{handled: false, value: None}
            if label.name != "digits" -> return SemaMethodSpecialCheck{handled: false, value: None}
        }
        else -> {
            if args.len() != 1 -> return SemaMethodSpecialCheck{handled: false, value: None}
        }
    }

    rounding_mode := TUnitRoundingMode?{None}
    if rounded {
        rounding_mode = Val(sema_expr_unit_rounding_mode(args[1].expr) ?? return SemaMethodSpecialCheck{handled: false, value: None})
    }
    probe_scope_mark :: sema_scope_mark(&scopes)
    probe_context_mark :: sema_check_context_mark(&context)
    probe_state := sema_ownership_state_snapshot(state)
    probe_diagnostics := [Diagnostic]{}
    // The probe shares the enclosing statement-tail store: the liveness
    // frames in `context` index it.
    probe_rounded_allowed := false
    probe_source := sema_expr_check_unit_conversion_source(args[0].expr, method, rounded, environment, &scopes, &probe_state, &tail_store, &context, &probe_diagnostics, &probe_rounded_allowed)
    sema_check_context_rollback(&context, probe_context_mark)
    sema_scope_rollback(&scopes, probe_scope_mark)
    source_probe :: probe_source ?? return SemaMethodSpecialCheck{handled: false, value: None}
    source_fact :: sema_expr_unit_fact(source_probe.ty, environment) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    expected_method := sema_expr_unit_conversion_method(source_fact)
    if !rounded && method != expected_method -> return SemaMethodSpecialCheck{handled: false, value: None}
    rounded_method :: "{expected_method}_rounded"
    if rounded && method != rounded_method -> return SemaMethodSpecialCheck{handled: false, value: None}
    measured_crossing := sema_expr_unit_is_measured(source_fact) || sema_expr_unit_is_measured(destination_fact)
    if rounded && !probe_rounded_allowed -> return SemaMethodSpecialCheck{handled: false, value: None}
    if !rounded && measured_crossing -> return SemaMethodSpecialCheck{handled: false, value: None}
    if source_fact.package != destination_fact.package || source_fact.family != destination_fact.family || source_fact.dimension != destination_fact.dimension || source_fact.kind != destination_fact.kind -> return SemaMethodSpecialCheck{handled: false, value: None}

    destination_span :: if receiver == {.Ident(_, span) -> span else -> method_span}
    conversion_end := method_span.end
    if args.len() > 0 -> conversion_end = args[args.len() - 1].span.end
    conversion_span := Span{start: destination_span.start, end: conversion_end}

    rounded_allowed := false
    source_value := sema_expr_check_unit_conversion_source(args[0].expr, method, rounded, environment, &scopes, &state, &tail_store, &context, &diagnostics, &rounded_allowed) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if rounded && !rounded_allowed -> return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_expr_unit_conversion_is_finite(source_fact, destination_fact) {
        &diagnostics.push(sema_error("E0127", conversion_span, "this unit conversion overflows its runtime representation", "the declared exact scale or offset is outside Float's finite range", "choose units with a finite conversion boundary"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    digits_value := TExpr?{None}
    if rounded {
        checked_digits := sema_check_expression(args[2].expr, Val(Type.Int), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        digits_value = Val(checked_digits)
        if args[2].expr == {
            .Unary(operator, inner, _) -> {
                if operator == UnOp.Neg {
                    if inner == {
                        .Int(_, _, _, _) -> {
                            &diagnostics.push(sema_error("E0127", expr_span(args[2].expr), "rounded unit conversion needs nonnegative digits", "digits counts destination decimal places", "write `digits: 0` or another nonnegative Int"))
                        }
                        else -> {}
                    }
                }
            }
            else -> {}
        }
    }
    rounding := TUnitRounding?{None}
    if rounded {
        mode :: rounding_mode ?? return SemaMethodSpecialCheck{handled: true, value: None}
        digits :: digits_value ?? return SemaMethodSpecialCheck{handled: true, value: None}
        rounding = Val(TUnitRounding{mode: mode, digits: digits})
    }
    scale :: sema_expr_unit_ratio_div(source_fact.scale, destination_fact.scale) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    offset :: sema_expr_unit_ratio_div(sema_expr_unit_ratio_sub(source_fact.offset, destination_fact.offset), destination_fact.scale) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    converted := if measured_crossing -> Type.Apply{name: "Measurement", args: [Type]{Type.Float}} else -> Type.Named{name: destination_name}
    result_ty := Type.Result{ok: converted, err: Type.String}
    destination_symbol := symbol_id(SymbolKind.Type, destination_fact.package, "", destination_fact.name)
    relative_uncertainty := sema_expr_unit_relative_uncertainty(source_fact, destination_fact)
    line := sema_source_line_at(environment.source_segments, conversion_span) ?? 0
    value := sema_tir_expr(result_ty, TExprKind.UnitConvert{destination: destination_symbol, argument: source_value, scale: sema_expr_unit_ratio_text(scale), offset: sema_expr_unit_ratio_text(offset), rounding: rounding, fallible: true, relative_uncertainty: relative_uncertainty, file: environment.source_file, line: line}, conversion_span)
    checked := sema_expr_expected(value, expected, environment, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

fn sema_expr_check_take_pattern_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "take_pattern" || (receiver_value.ty != Type.Named{name: "Cursor"} && receiver_value.ty != Type.Named{name: "Reader"}) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Write, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() != 1 {
        &diagnostics.push(sema_error("E0104", span, "`take_pattern` expects one literal pattern, got {args.len()} arguments", "a pattern is a compile-time literal and is the whole argument list", "write exactly one string or `[U8]` pattern literal"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if receiver_value.ty == (Type.Named{name: "Cursor"}) {
        if args[0].expr == {
            .StrMatchLit(parts, lit_span) -> {
                validation := sema_pattern_text(Type.String, parts, lit_span, &diagnostics, false)
                if !validation.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
                canonical := [TCanonicalField]{}
                tuple_fields := [TypeTupleField]{}
                loop binding in validation.bindings {
                    &canonical.push(TCanonicalField{name: binding.name, ty: binding.ty})
                    &tuple_fields.push(TypeTupleField{name: binding.name, ty: binding.ty})
                }
                ok_ty := if tuple_fields.len() == 0 -> Type.Named{name: "Unit"} else -> Type.Tuple{fields: tuple_fields}
                result_ty := Type.Result{ok: ok_ty, err: Type.String}
                operation := THandleOp.CursorTakePattern{parts: parts, canonical: canonical}
                value := sema_tir_expr(result_ty, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{}}, span)
                checked := sema_expr_expected(value, expected, environment, &diagnostics)
                return SemaMethodSpecialCheck{handled: true, value: checked}
            }
            else -> {
                &diagnostics.push(sema_error("E0112", args[0].span, "`Cursor.take_pattern` needs a literal text pattern", "Cursor patterns use string literals with typed capture holes", "write `cursor.take_pattern(\"prefix-{{{{name:Int}}}}-suffix\")`"))
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
        }
    }
    if args[0].expr == {
        .BinMatchLit(parts, lit_span) -> {
            byte_type := Type.List{element: Type.IntN{signed: false, bits: 8}}
            validation := sema_pattern_binary(byte_type, parts, lit_span, &diagnostics, false)
            if !validation.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
            canonical := [TCanonicalField]{}
            tuple_fields := [TypeTupleField]{}
            loop binding in validation.bindings {
                &canonical.push(TCanonicalField{name: binding.name, ty: binding.ty})
                &tuple_fields.push(TypeTupleField{name: binding.name, ty: binding.ty})
            }
            ok_ty := if tuple_fields.len() == 0 -> Type.Named{name: "Unit"} else -> Type.Tuple{fields: tuple_fields}
            result_ty := Type.Result{ok: ok_ty, err: Type.String}
            operation := THandleOp.ReaderTakePattern{parts: parts, canonical: canonical}
            value := sema_tir_expr(result_ty, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{}}, span)
            checked := sema_expr_expected(value, expected, environment, &diagnostics)
            return SemaMethodSpecialCheck{handled: true, value: checked}
        }
        else -> {
            &diagnostics.push(sema_error("E0112", args[0].span, "`Reader.take_pattern` needs a literal binary pattern", "Reader patterns use `[U8]` literals with typed bit or rest captures", "write `reader.take_pattern([U8]{{\"prefix-{{{{name:U8}}}}-suffix\"}})`"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
}

fn sema_expr_core_module_alias_visible(alias: String, scopes: SemaScopeTable) -> Bool Never! {
    index :: sema_scope_resolve_index(scopes, alias) ?? return false
    kind := scopes.bindings[index].symbol.kind
    kind == SymbolKind.Module || kind == SymbolKind.Import
}

fn sema_expr_canonical_type_binding(name: String, scopes: SemaScopeTable) -> Bool Never! {
    index :: sema_scope_resolve_index(scopes, name) ?? return false
    binding := scopes.bindings[index]
    if binding.symbol.kind != SymbolKind.Type -> return false
    if binding.symbol.module_name == "" || binding.symbol.module_name.starts_with("core.") -> return true
    sema_scope_binding_is_compiler_builtin(binding, name)
}

struct SemaExprCoreReceiverPath {
    alias: String
    alias_span: Span
    leaves: [String]
}

// A Core call receiver: an import alias, or a field chain over one
// (`core.math` in `core.math.fabs(n)`); the leaves name submodules.
fn sema_expr_core_module_receiver_path(receiver: Expr) -> SemaExprCoreReceiverPath? Never! {
    if receiver == {
        .Ident(name, span) -> return Val(SemaExprCoreReceiverPath{alias: name, alias_span: span, leaves: [String]{}})
        .Field(base, leaf, _) -> {
            path := sema_expr_core_module_receiver_path(base) ?? return None
            &path.leaves.push(leaf)
            return Val(path)
        }
        else -> return None
    }
}

fn sema_expr_try_core_module_method(receiver: Expr, method: String, method_span: Span, type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    path :: sema_expr_core_module_receiver_path(receiver) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    alias :: path.alias
    alias_span :: path.alias_span
    if !sema_expr_core_module_alias_visible(alias, scopes) -> return SemaMethodSpecialCheck{handled: false, value: None}
    module_name := sema_call_core_import_module(environment, alias) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    // Rust `core_module_path_from_receiver`: `alias.leaf.method(...)` calls
    // into the known Core submodule `<alias module>.leaf`.
    loop leaf in path.leaves {
        module_name = "{module_name}.{leaf}"
        if core_module_export(module_name) == None -> return SemaMethodSpecialCheck{handled: false, value: None}
    }
    nested :: path.leaves.len() > 0
    if !nested && sema_call_core_variadic_print(environment, scopes, alias, method, args.len(), alias_span, &context) {
        printed := sema_call_check_ambient_print(Call{name: "{alias}.{method}", name_span: method_span, type_args: type_args, args: args, resolved_ret: None, range_checked: false, widen_approx: false}, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: printed.value}
    }
    expected_type_arg_count := 0
    if core_call_typed_signature(module_name, method, args.len()) == {
        .Val(signature) -> expected_type_arg_count = signature.type_parameters.len()
        .None -> {}
    }
    diagnostics_before := diagnostics.len()
    route := if nested -> sema_call_core_resolve_import_path_route(environment, scopes, alias, module_name, method, type_args, expected_type_arg_count, true, args.len(), method_span, alias_span, &context, &diagnostics) else -> sema_call_core_resolve_import_route(environment, scopes, alias, method, type_args, expected_type_arg_count, true, args.len(), method_span, alias_span, &context, &diagnostics)
    route_value :: route ?? {
        if diagnostics.len() != diagnostics_before -> return SemaMethodSpecialCheck{handled: true, value: None}
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if route_value == {
        .Source(target) -> {
            scopes.ownership_call_depth += 1
            value := sema_call_core_check_source_owned(target, "{module_name}.{method}", type_args, args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            scopes.ownership_call_depth -= 1
            return SemaMethodSpecialCheck{handled: true, value: value}
        }
        .Core(record) -> {
            special := sema_call_try_core_direct_record(record, args, type_args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            if special.handled -> return SemaMethodSpecialCheck{handled: true, value: special.value}
            scopes.ownership_call_depth += 1
            value := sema_call_core_check_fixed(environment, module_name, method, type_args, args, method_span, expected, &scopes, &state, &tail_store, &context, &diagnostics)
            scopes.ownership_call_depth -= 1
            return SemaMethodSpecialCheck{handled: true, value: value}
        }
    }
}

fn sema_expr_try_method_static_routes(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    task_surface := sema_taskgroup_check_surface_method(receiver, method, args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if task_surface.handled -> return task_surface

    module_alias := if receiver == {
        .Field(base, _, _) -> if base == {.Ident(name, _) -> Val(name) else -> None}
        else -> None
    }
    alias :: module_alias ?? ""
    if alias != "" && sema_expr_core_module_alias_visible(alias, scopes) {
        memory := sema_call_try_memory_static(receiver, method, args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if memory.handled -> return memory
        http := sema_call_try_http_static(receiver, method, owner_type_args, type_args, args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if http.handled -> return http
        tls := sema_call_try_network_tls_static(receiver, method, args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if tls.handled -> return tls
    }

    owner :: if receiver == {.Ident(name, _) -> name else -> ""}
    // Rust `core_type_known`: a prelude core type (`Reader`, `DataTree`, …)
    // needs no `use`, so an unbound owner reaches the reserved constructors
    // too; each route matches only its own owner names.
    if owner != "" && (sema_scope_resolve_index(scopes, owner) == None || sema_expr_canonical_type_binding(owner, scopes)) {
        stream := sema_call_try_stream_handle_static(owner, method, args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if stream.handled -> return stream
        time := sema_call_try_time_static_method(owner, method, args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if time.handled -> return time
        data := sema_call_try_data_literal(Type.Named{name: owner}, method, args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if data.handled -> return data
    }

    game := sema_call_try_game_static(receiver, method, args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if game.handled -> return game

    static := sema_call_try_static_method(receiver, method, method_span, owner_type_args, type_args, args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if static.handled -> return static

    core := sema_expr_try_core_module_method(receiver, method, method_span, type_args, args, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if core.handled -> return core
    SemaMethodSpecialCheck{handled: false, value: None}
}
fn sema_expr_record_hardware_result(result: SemaHardwareMethodCheck, scopes: &SemaScopeTable, context: &SemaCheckContext) -> SemaMethodSpecialCheck Never! {
    sema_hardware_use_merge(&context.hardware_use, sema_hardware_use_snapshot(result.hardware_use))
    if result.dma_transfer == .Val(fact) && result.check.value != None -> &scopes.hardware_pending_transfers.push(fact)
    result.check
}

fn sema_expr_try_hardware_pre_receiver(receiver: Expr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    hardware := sema_call_try_hardware_pre_receiver(receiver, method, args, None, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if hardware == .Val(result) && result.check.handled -> return sema_expr_record_hardware_result(result, &scopes, &context)
    SemaMethodSpecialCheck{handled: false, value: None}
}


fn sema_expr_try_method_special_routes(receiver: Expr, receiver_value: TExpr, method: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    data := sema_call_try_data_method(receiver, receiver_value, method, args, type_args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if data.handled -> return data

    sql := sema_call_try_sql_raw(receiver, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if sql.handled -> return sql
    database := sema_call_try_database_method(receiver, receiver_value, method, args, type_args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if database.handled -> return database

    http := sema_call_try_http_method(receiver, receiver_value, method, owner_type_args, type_args, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if http.handled -> return http
    ui := sema_call_try_ui_handle_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if ui.handled -> return ui
    stream := sema_call_try_stream_handle_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if stream.handled -> return stream
    process := sema_call_try_process_handle_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if process.handled -> return process
    time := sema_call_try_time_handle_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if time.handled -> return time
    network := sema_call_try_network_handle_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if network.handled -> return network
    text := sema_call_try_text_handle_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if text.handled -> return text
    email := sema_call_try_email_handle_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if email.handled -> return email
    reflection := sema_call_try_reflection_handle_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if reflection.handled -> return reflection
    compiler_value := sema_call_try_compiler_value_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if compiler_value.handled -> return compiler_value

    tree := sema_check_service_tree_method(method, receiver, receiver_value, args, expected, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if tree == .Val(check) {
        if check.handled -> return check
    }
    workflow := sema_check_service_workflow_method(method, receiver, receiver_value, args, expected, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if workflow == .Val(check) {
        if check.handled -> return check
    }
    endpoint := sema_check_service_endpoint_method(method, receiver, receiver_value, args, expected, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if endpoint == .Val(check) {
        if check.handled -> return check
    }
    delivery := sema_check_delivery_method(method, receiver, receiver_value, args, expected, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if delivery == .Val(check) {
        if check.handled -> return check
    }
    delivery_state := sema_check_delivery_state_method(method, receiver, receiver_value, args, expected, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if delivery_state == .Val(check) {
        if check.handled -> return check
    }
    runtime := sema_check_service_runtime_method(method, receiver, receiver_value, args, expected, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if runtime == .Val(check) {
        if check.handled -> return check
    }

    reactive := sema_call_try_reactive_handle_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if reactive.handled -> return reactive
    game := sema_call_try_game_method(receiver, receiver_value, method, args, type_args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if game == .Val(check) {
        if check.handled -> return check
    }
    geometry := sema_call_try_geometry(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if geometry.handled -> return geometry
    transfer_fact := sema_hardware_transfer_fact_for_expr(receiver, scopes, &state)
    hardware := sema_call_try_hardware_method(receiver, receiver_value, method, args, transfer_fact, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if hardware == .Val(result) && result.check.handled -> return sema_expr_record_hardware_result(result, &scopes, &context)
    memory := sema_call_try_memory_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if memory.handled -> return memory
    collections := sema_call_try_builtin_collections(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if collections.handled -> return collections
    concurrency := sema_call_try_builtin_concurrency(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if concurrency.handled -> return concurrency
    task_group := sema_taskgroup_check_group_method(receiver, receiver_value.ty, method, args, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if task_group.handled -> return task_group

    value_method := sema_call_try_value_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if value_method.handled -> return value_method
    builtin := sema_call_try_builtin_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if builtin.handled -> return builtin
    SemaMethodSpecialCheck{handled: false, value: None}
}

// D-SHAPE3a=A: the receiver type `.new(...)` takes from its expected type.
fn sema_expr_inferred_new_owner(expected: Type?) -> Type? {
    ty :: expected ?? return None
    if ty == {
        .Named(_) | .Apply(_, _) -> Val(ty)
        .Shared(inner) -> Val(Type.Apply{name: "Shared", args: [Type]{inner}})
        .List(inner) -> Val(Type.Apply{name: "List", args: [Type]{inner}})
        .Map(key, _, value) -> Val(Type.Apply{name: "Map", args: [Type]{key, value}})
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 -> Val(Type.Named{name: type_name(ty)})
        .Tagged(_, inner) -> if inner == {
            .Named(_) | .Apply(_, _) -> Val(inner)
            else -> None
        }
        else -> None
    }
}

// Whether the struct `receiver` names declares a field `name` of function type.
fn sema_expr_function_field(receiver: Type, name: String, environment: SemaScopeEnvironment) -> Bool {
    type_name :: sema_type_graph_base_name(sema_expr_unwrap_tag(receiver)) ?? return false
    definition :: sema_serde_type_definition(environment, type_name) ?? return false
    if definition.kind == .Struct(fields, _) {
        loop field in fields {
            if field.name == name -> return sema_call_type_is_function(sema_call_resolved_type(field.ty, environment))
        }
    }
    false
}

fn sema_expr_check_method_call(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    // D-SHAPE3a=A: `.new(...)` leaves only the static receiver implicit; the
    // ordinary expected type names it (E0356 when there is none).
    if receiver == .Ident(receiver_name, receiver_span) && receiver_name == "" {
        owner :: sema_expr_inferred_new_owner(expected) ?? {
            loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            &diagnostics.push(sema_error("E0356", method_span, "`.new(...)` needs one known receiver type here", "the inferred constructor uses the surrounding expected type; Jet does not search a global constructor registry", "add a type annotation or write the full `Type.new(...)` form"))
            return None
        }
        owner_name := ""
        inferred_args := owner_type_args
        if owner == {
            .Apply(name, apply_args) -> {
                owner_name = name
                if owner_type_args.len() == 0 -> inferred_args = apply_args
            }
            .Named(name) -> owner_name = name
            else -> return None
        }
        return sema_expr_check_method_call(Expr.Ident{name: owner_name, span: receiver_span}, method, method_span, inferred_args, type_args, args, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    checked_text := sema_expression_checked_text_static_method_call(receiver, method, method_span, owner_type_args, type_args, args, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if checked_text.handled -> return checked_text.value
    explicit_unit := sema_expr_try_explicit_unit_method(receiver, method, method_span, args, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if explicit_unit.handled -> return explicit_unit.value
    enum_variant := sema_expression_enum_variant_call(receiver, method, method_span, owner_type_args, type_args, args, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if enum_variant.handled -> return enum_variant.value
    pre_receiver := sema_expr_try_method_static_routes(receiver, method, method_span, owner_type_args, type_args, args, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if pre_receiver.handled -> return pre_receiver.value
    hardware_pre_receiver := sema_expr_try_hardware_pre_receiver(receiver, method, args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if hardware_pre_receiver.handled -> return hardware_pre_receiver.value
    scopes.ownership_call_depth += 1
    // D-MEM1: chaining `.trim()`/`.after()`/`.before()` onto a string view
    // reads it as the `&str` those methods take, so the view read is allowed.
    previous_string_view_read := context.allow_string_view_read
    if sema_string_view_exempt_receiver(receiver, method, scopes) -> context.allow_string_view_read = true
    receiver_checked := sema_check_expression(receiver, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    context.allow_string_view_read = previous_string_view_read
    scopes.ownership_call_depth -= 1
    receiver_value :: receiver_checked ?? return None
    // D-CALLVALUE1=B: `.call(...)` on a function-typed receiver is the builtin
    // call projection, checked exactly like calling the value directly
    // (mirrors Rust CheckerInfer/calls/method_calls.rs METHOD_CALL on Type::Fn).
    receiver_signature :: sema_call_resolved_type(receiver_value.ty, environment)
    if method == "call" && sema_call_type_is_function(receiver_signature) {
        call_end := method_span.end
        if args.len() > 0 -> call_end = expr_span(args[args.len() - 1].expr).end
        scopes.ownership_call_depth += 1
        projected := sema_call_value_checked_from_type(&state, receiver, receiver_value, receiver_signature, args, Span{start: expr_span(receiver).start, end: call_end}, [SemaCallDefaultValue]{}, expected, environment, &scopes, &tail_store, &context, &diagnostics)
        scopes.ownership_call_depth -= 1
        projected_value :: projected ?? return None
        &context.call_return_views.push(SemaCallReturnView{span: method_span, facts: projected_value.return_view_facts})
        if !sema_expr_record_call_fact(environment, &scopes, &context, method_span, projected_value, &diagnostics) -> return None
        return Val(projected_value.value)
    }
    // Rust `infer_method_call`: a struct field holding a function value is
    // called through the field (`worker.step(4)`), ahead of method lookup.
    if sema_expr_function_field(receiver_value.ty, method, environment) {
        call_end := method_span.end
        if args.len() > 0 -> call_end = expr_span(args[args.len() - 1].expr).end
        return sema_expr_check_indirect_call(Expr.Field{base: receiver, member: method, span: method_span}, args, Span{start: expr_span(receiver).start, end: call_end}, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    take_pattern := sema_expr_check_take_pattern_method(receiver, receiver_value, method, args, method_span, expected, environment, &scopes, &state, &diagnostics)
    if take_pattern.handled -> return take_pattern.value
    zip := sema_expression_zip_method(receiver, receiver_value, method, args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if zip.handled -> return zip.value
    // A declared nominal owns the methods it declares, even when its leaf
    // spells a builtin carrier such as Core's `URL` or `MIME`; builtin handle
    // routes apply only when no declared method matches.
    if !sema_expr_declares_nominal_method(environment, receiver_value.ty, method) {
        special := sema_expr_try_method_special_routes(receiver, receiver_value, method, owner_type_args, type_args, args, method_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if special.handled -> return special.value
    }
    candidates :: if environment.registration_graph == {
        .Val(graph) -> sema_expr_registration_method_candidates(graph, receiver_value.ty, method, owner_type_args, type_args, method_span, environment, &scopes, &diagnostics)
        .None -> sema_call_local_method_candidates(environment, method, owner_type_args, type_args)
    }
    argument_types := [Type?]{}
    argument_index := 0
    loop argument_index < args.len() {
        argument := args[argument_index]
        if {
            // A decimal literal's carrier comes from the parameter it meets.
            sema_call_inference_needs_context(argument.expr) || sema_expr_decimal_literal_operand(argument.expr, true) -> {
                &argument_types.push(None)
            }
            else -> {
                probe_diagnostics := [Diagnostic]{}
                checked_argument := sema_probe_expression(argument.expr, None, environment, &scopes, state, &tail_store, &context, &probe_diagnostics)
                if {
                    checked_argument != None -> {
                        checked_value :: checked_argument ?? return None
                        &argument_types.push(Val(checked_value.ty))
                    }
                    else -> {
                        &argument_types.push(None)
                    }
                }
            }
        }
        argument_index += 1
    }
    candidate :: sema_call_resolve_method_with_inference(receiver_value.ty, method, args, argument_types, expected, candidates, environment, &scopes, method_span, &diagnostics) ?? return None
    scopes.ownership_call_depth += 1
    checked := sema_call_check_method_candidate_from_value_owned(&state, receiver, receiver_value, candidate, args, [SemaCallDefaultValue]{}, method_span, expected, environment, &scopes, &tail_store, &context, &diagnostics)
    scopes.ownership_call_depth -= 1
    value :: checked ?? return None
    &context.call_return_views.push(SemaCallReturnView{span: method_span, facts: value.return_view_facts})
    if !sema_expr_record_call_fact(environment, &scopes, &context, method_span, value, &diagnostics) -> return None
    Val(value.value)
}


fn sema_expr_check_identifier(name: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if name == "err" && context.fallback_err_denial == .Val(code) {
        &diagnostics.push(sema_fallback_err_denied(code, span))
        return None
    }
    unresolved_index := sema_scope_resolve_index(scopes, name)
    if unresolved_index != None {
        unresolved :: unresolved_index ?? 0
        symbol := scopes.bindings[unresolved].symbol
        if symbol.kind == SymbolKind.Constant && symbol.ty == None {
            &context.name_references.push(SemaNameReferenceFact{span: span, symbol: symbol, kind: "const"})
            return None
        }
    }
    // D-PREP-SURFACE2=A: a prepared local reads as its compile-time value.
    if unresolved_index == .Val(prepared_index) {
        prepared_binding :: scopes.bindings[prepared_index]
        if prepared_binding.prepared == .Val(known) {
            prepared_ty :: prepared_binding.symbol.ty ?? return None
            &context.name_references.push(SemaNameReferenceFact{span: span, symbol: prepared_binding.symbol, kind: "local"})
            return sema_expr_expected(sema_fact_prepared_expr(known, prepared_ty, span), expected, environment, &diagnostics)
        }
    }
    // D-UNINIT-SENTINEL2 (E0420): a `Type{ uninit }` binding read before
    // every path wrote it reports once, then the read resolves as usual.
    if unresolved_index == .Val(read_index) && sema_ownership_uninit_take(&state, scopes.bindings[read_index].symbol.id.key) != None {
        &diagnostics.push(sema_error("E0420", span, "`{name}` may be read before it is given a value", "`{name}` was declared with `Type{{ uninit }}`, so no value is available until you write to it — this read could see garbage", "write to `{name}` on every path before reading it (e.g. fill it via `mut {name}`)"))
    }
    value :: sema_expr_check_ident(name, span, expected, environment, &scopes, &diagnostics) ?? return None
    expr := Expr.Ident{name: name, span: span}
    if unresolved_index != None {
        unresolved :: unresolved_index ?? 0
        symbol := scopes.bindings[unresolved].symbol
        if symbol.kind == SymbolKind.Local || symbol.kind == SymbolKind.Parameter {
            if !sema_ownership_note_reference(&state, name, span, scopes, SemaOwnershipReferenceKind.Read) -> return None
        }
    }
    use_checked :: if context.suppress_partial_move_root_read -> sema_ownership_check_root_base_use(&state, expr, scopes, &diagnostics) else -> sema_ownership_check_use(&state, expr, scopes, &diagnostics)
    if !use_checked -> return None
    if !sema_hardware_note_cpu_use(expr, scopes, &state, &context, &diagnostics) -> return None
    sema_string_view_check_read(name, span, scopes, state, context, &diagnostics)
    binding_index :: sema_scope_resolve_index(scopes, name) ?? return Val(value)
    symbol := scopes.bindings[binding_index].symbol
    reference_kind := "semantic"
    if symbol.kind == {
        .Function -> reference_kind = "function"
        .Constant -> reference_kind = "const"
        .Parameter -> reference_kind = "param"
        .Local -> reference_kind = "local"
        .Type -> reference_kind = "type"
        .Trait -> reference_kind = "trait"
        .Module -> reference_kind = "module"
        else -> {}
    }
    &context.name_references.push(SemaNameReferenceFact{span: span, symbol: symbol, kind: reference_kind})
    Val(value)
}

fn sema_expr_check_string(parts: [StrPart], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    tir_parts := [TStrPart]{}
    index := 0
    loop index < parts.len() {
        if parts[index] == {
            .Lit(text) -> &tir_parts.push(TStrPart.Literal{text: text})
            .Byte(value) -> &tir_parts.push(TStrPart.Literal{text: sema_expr_byte_text(value)})
            .Interp(value, format) -> {
                // D-MEM1: interpolation reads a string view through Display.
                previous_string_view_read := context.allow_string_view_read
                context.allow_string_view_read = true
                checked_value := sema_check_expression(value, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                context.allow_string_view_read = previous_string_view_read
                checked :: checked_value ?? return None
                if format == StrFormat.Display && !sema_expression_interpolation_display(checked, environment, &scopes, &diagnostics) -> return None
                // Rust interpolation check (CheckerInfer/expr.rs:3985-4126): bare
                // Display uses the relation above and the Debug family uses
                // `is_debuggable`; only the numeric and text selectors use the
                // primitive table.
                debug_family :: format == StrFormat.Debug || format == StrFormat.Pretty
                if debug_family && !sema_call_debug_traceable(checked.ty, environment) {
                    selector :: if format == StrFormat.Debug -> "Debug" else -> "Pretty"
                    if sema_call_reflection_secret_bearing(checked.ty) -> &diagnostics.push(sema_error("E0112", checked.span, "secret-bearing `{type_name(checked.ty)}` cannot use `:{selector}`", "Debug output could copy cryptographic secret material into logs or diagnostics", "remove the interpolation; log a public operation label or key identifier instead")) else -> &diagnostics.push(sema_error("E0112", checked.span, "{sema_type_show(checked.ty)} can't be shown with :{selector} yet", "debug interpolation needs a debuggable value", "implement `Debug` or use a debuggable part"))
                    return None
                }
                if !debug_family && format != StrFormat.Display && !sema_expr_format_supported(checked.ty, format) -> return None
                &tir_parts.push(TStrPart.Interpolation{value: checked, format: sema_expr_string_format(format)})
            }
        }
        index += 1
    }
    sema_expr_expected(sema_tir_expr(Type.String, TExprKind.StrLit{parts: tir_parts}, span), expected, environment, &diagnostics)
}

fn sema_expr_check_ident(name: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> TExpr? {
    index :: sema_scope_resolve_index(scopes, name) ?? {
        &diagnostics.push(sema_unknown_name(name, span))
        return None
    }
    binding :: ~scopes.bindings[index]
    symbol :: binding.symbol
    ty :: symbol.ty ?? return None
    result := TExpr?{None}
    if symbol.kind == SymbolKind.Local || symbol.kind == SymbolKind.Parameter {
        local := tir_symbol_local(name, symbol.span, symbol.id)
        local.mutable = binding.mutable
        local.integer_bounds = binding.integer_bounds
        value :: TExpr{ty: ty, kind: TExprKind.Local{local: local}, span: span, integer_bounds: binding.integer_bounds, cost: None}
        result = sema_expr_expected(value, expected, environment, &diagnostics)
    }
    if symbol.kind == SymbolKind.Constant || symbol.kind == SymbolKind.Function {
        value :: sema_tir_expr(ty, TExprKind.ConstRef{symbol: symbol.id}, span)
        result = sema_expr_expected(value, expected, environment, &diagnostics)
    }
    result
}

fn sema_expr_check_unary(op: UnOp, operand: Expr, expected: Type?, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if op == UnOp.Neg {
        if operand == {
            .Int(value, _, width, raw) -> return sema_expr_negative_integer(sema_expr_exact_integer_literal(value, raw), width, expected, span, environment, &diagnostics)
            // D-TYPE2-DEFAULT1: `-1.5` is one exact Decimal literal; the sign
            // folds into its spelling unless a Float carrier is expected.
            .Float(_, _, _, raw) -> {
                if raw == .Val(text) {
                    if !sema_expr_expects_machine_float(expected) -> return sema_expr_expected(sema_expr_decimal_literal("-{text}", span), expected, environment, &diagnostics)
                }
            }
            else -> {}
        }
    }
    // Rust checks the operand under the surrounding expectation; only a
    // Float carrier changes how a decimal literal operand elaborates.
    operand_expected := Type?{None}
    if op == UnOp.Neg && sema_expr_expects_machine_float(expected) && sema_expr_decimal_literal_operand(operand, true) -> operand_expected = ~expected
    value :: sema_check_expression(operand, operand_expected, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if op == UnOp.Neg {
        if value.ty == {
            .IntN(signed, _) -> {
                if !signed {
                    &diagnostics.push(sema_error("E0109", span, "`-` can't negate {type_name(value.ty)}, which is unsigned", "unsigned numbers have no negative values", "use a signed integer type if this value needs a negative result"))
                    return None
                }
            }
            else -> {}
        }
        if !sema_expr_is_numeric(value.ty) {
            if sema_expr_has_numeric_overload(value.ty) -> return None
            &diagnostics.push(sema_error("E0109", span, "unary `-` needs a number", "negation is defined for numeric values", "use a number here"))
            return None
        }
        result_ty := sema_expr_numeric_base(value.ty)
        return sema_expr_expected(sema_tir_expr(result_ty, TExprKind.Unary{op: TUnaryOp.Neg, operand: value}, span), expected, environment, &diagnostics)
    }
    if value.ty == Type.Bool || sema_expr_is_integer(value.ty) {
        result_ty := if value.ty == Type.Bool -> Type.Bool else -> sema_expr_numeric_base(value.ty)
        return sema_expr_expected(sema_tir_expr(result_ty, TExprKind.Unary{op: TUnaryOp.Not, operand: value}, span), expected, environment, &diagnostics)
    }
    &diagnostics.push(sema_error("E0109", span, "logical `!` needs a Bool or whole number", "logical negation flips a yes-or-no value and bitwise negation flips every integer bit", "compare the value to produce Bool, or use a whole-number value"))
    None
}

// D-TYPE2-DEFAULT1: an untyped decimal literal is exact Decimal by default
// and adopts the machine carrier only where Float or F32 is expected (Rust
// `Expr::Float` inference).
fn sema_expr_expects_machine_float(expected: Type?) -> Bool Never! {
    expected == (Val(Type.Float)) || expected == (Val(Type.Float32))
}

fn sema_expr_decimal_literal(text: String, span: Span) -> TExpr Never! {
    spelling :: sema_tir_expr(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: text}}}, span)
    sema_tir_expr(Type.Named{name: "Decimal"}, TExprKind.PreciseBuiltin{type_name: "Decimal", function: "from_str", args: [TExpr]{spelling}}, span)
}

fn sema_expr_float_literal(value: Float, is_f32: Bool, raw: String?, span: Span, expected: Type?, environment: SemaScopeEnvironment, diagnostics: &[Diagnostic]) -> TExpr? {
    if raw == .Val(text) {
        if !sema_expr_expects_machine_float(expected) -> return sema_expr_expected(sema_expr_decimal_literal(text, span), expected, environment, &diagnostics)
    }
    ty := Type.Float
    if expected == (Val(Type.Float32)) || (is_f32 && expected != (Val(Type.Float))) -> ty = Type.Float32
    sema_expr_expected(sema_tir_expr(ty, TExprKind.FloatLit{value: value}, span), expected, environment, &diagnostics)
}

// Rust `expr_wants_expected_type` for a decimal literal operand. A binary's
// left operand also inherits the surrounding expectation in Rust, so
// `through_binary` follows it for an operand that is itself checked under
// that expectation.
fn sema_expr_decimal_literal_operand(expr: Expr, through_binary: Bool) -> Bool Never! {
    if expr == {
        .Float(_, _, _, _) -> true
        .Paren(inner, _) -> sema_expr_decimal_literal_operand(inner, through_binary)
        .Unary(op, inner, _) -> op == UnOp.Neg && sema_expr_decimal_literal_operand(inner, through_binary)
        .Binary(_, left, _, _) -> through_binary && sema_expr_decimal_literal_operand(left, true)
        else -> false
    }
}

fn sema_expr_measurement_type(ty: Type) -> Bool Never! {
    if ty == .Apply(name, _) -> return name == "Measurement"
    false
}

fn sema_expr_scalable_unit_type(ty: Type, environment: SemaScopeEnvironment) -> Bool Never! {
    sema_expr_unit_fact(ty, environment) != None || sema_expr_unit_dimension(ty, environment) != None
}

// Rust `known_unit_expr` / `known_measurement_expr` read a name's or field's
// known type, a unit literal, a unit-receiver call, or `measurement(...)`;
// only those right operands are probed.
fn sema_expr_unit_probe_shape(expr: Expr) -> Bool Never! {
    if expr == {
        .Ident(_, _) | .Field(_, _, _) | .UnitLit(_, _, _, _, _, _) -> true
        .Paren(inner, _) -> sema_expr_unit_probe_shape(inner)
        .Unary(op, inner, _) -> op == UnOp.Neg && sema_expr_unit_probe_shape(inner)
        .MethodCall(receiver, _, _, _, _, _, _, _, _, _) -> receiver == .Ident(_, _)
        .Call(call) -> call.name == "measurement"
        else -> false
    }
}

// Rust `infer_binary`: the left operand keeps the surrounding expectation,
// and a literal before a measurement (or a unit under `*` or `/`) is Float.
fn sema_expr_decimal_lhs_expected(op: BinOp, left: Expr, right: Expr, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Type? {
    if !sema_expr_decimal_literal_operand(left, true) -> return None
    if sema_expr_expects_machine_float(expected) -> return ~expected
    if !sema_expr_unit_probe_shape(right) -> return None
    probe_diagnostics := [Diagnostic]{}
    probed :: sema_probe_expression(right, None, environment, &scopes, state, &tail_store, &context, &probe_diagnostics) ?? return None
    if sema_expr_measurement_type(probed.ty) || ((op == BinOp.Mul || op == BinOp.Div) && sema_expr_scalable_unit_type(probed.ty, environment)) -> return Val(Type.Float)
    None
}

// Rust `infer_binary`: for arithmetic and comparison a decimal literal on the
// right takes the left operand's type, and Float beside a measurement or a
// scalable unit under `*` or `/`.
fn sema_expr_decimal_rhs_expected(op: BinOp, lhs: Type, environment: SemaScopeEnvironment) -> Type? {
    if !sema_expr_same_type_operator(op) -> return None
    if sema_expr_measurement_type(lhs) -> return Val(Type.Float)
    if (op == BinOp.Mul || op == BinOp.Div) && sema_expr_scalable_unit_type(lhs, environment) -> return Val(Type.Float)
    // Any other left type is no Float carrier, so the literal stays Decimal
    // and the operator check reports the pairing.
    if lhs == Type.Float || lhs == Type.Float32 -> return Val(lhs)
    None
}

fn sema_expr_same_type_operator(op: BinOp) -> Bool Never! {
    op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div || op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Compare || op == BinOp.Lt || op == BinOp.Le || op == BinOp.Gt || op == BinOp.Ge
}

// Rust `expr_wants_expected_type` beyond the decimal literal: an inferred
// struct literal, an untyped typed literal, a contextual enum case (`.Red`,
// `Val(x)`), or a bare `None` needs the surrounding type, which a same-type
// operator takes from its left operand.
fn sema_expr_wants_expected_form(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(inner, _) -> sema_expr_wants_expected_form(inner)
        .Unary(op, inner, _) -> op == UnOp.Neg && sema_expr_wants_expected_form(inner)
        .StructLit(_, _, _, _, _, inferred, _) -> inferred
        .TypedLit(head, _, _) -> head == None
        .EnumLit(type_name, _, _, _, _, _) -> type_name == ""
        .Absent(_) -> true
        else -> false
    }
}

// Rust passes the left operand's type to such a right operand only as an
// inference hint, then lifts the plain side of `==`/`!=` (D-OPT-LIFT1=A). An
// optional builder (`Val(x)`, `None`) compared with a plain left operand
// (a flow-refined `x` after `if x == None -> …`) is built at the lifted `T?`.
fn sema_expr_rhs_hint(op: BinOp, left: Type, right: Expr) -> Type Never! {
    if op != BinOp.Eq && op != BinOp.Ne -> return ~left
    if sema_expr_unwrap_tag(left) == .Option(_) -> return ~left
    if !sema_expr_optional_builder(right) -> return ~left
    Type.Option{inner: ~left}
}

fn sema_expr_optional_builder(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(inner, _) -> sema_expr_optional_builder(inner)
        .Absent(_) -> true
        .EnumLit(type_name, variant, _, args, _, _) -> type_name == "" && ((variant == "Val" && args.len() == 1) || (variant == "None" && args.len() == 0))
        else -> false
    }
}

fn sema_expr_check_binary(op: BinOp, left: Expr, right: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked_lhs :: sema_check_expression(left, sema_expr_decimal_lhs_expected(op, left, right, expected, environment, &scopes, state, &tail_store, &context), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    rhs_expected := Type?{None}
    if {
        sema_expr_decimal_literal_operand(right, false) -> rhs_expected = sema_expr_decimal_rhs_expected(op, checked_lhs.ty, environment)
        sema_expr_same_type_operator(op) && sema_expr_wants_expected_form(right) -> rhs_expected = Val(sema_expr_rhs_hint(op, checked_lhs.ty, right))
        else -> {}
    }
    checked_rhs :: sema_check_expression(right, rhs_expected, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    // D-OPT-LIFT1=A: `x == 5` holds only when the optional `x` holds 5, and
    // `x != 5` is its opposite. The plain side lifts once, so the comparison
    // is the existing optional equality.
    equality := op == BinOp.Eq || op == BinOp.Ne
    lifted_rhs := if equality -> sema_expr_optional_lift(checked_rhs, checked_lhs.ty, checked_rhs.ty, environment) else -> None
    lifted_lhs := if equality && lifted_rhs == None -> sema_expr_optional_lift(checked_lhs, checked_rhs.ty, checked_lhs.ty, environment) else -> None
    lhs :: lifted_lhs ?? checked_lhs
    rhs :: lifted_rhs ?? checked_rhs
    if op == BinOp.Pow && lhs.ty == Type.Int {
        if right == {
            .Unary(operator, _, _) -> {
                if operator == UnOp.Neg -> return None
            }
            else -> {}
        }
    }
    line :: sema_source_line_at(environment.source_segments, span) ?? return None
    if op == BinOp.And || op == BinOp.Or {
        ty :: sema_expr_binary_type(op, lhs.ty, rhs.ty, span, &diagnostics) ?? return None
        value := sema_tir_expr(ty, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: false, line: line, lhs: lhs, rhs: rhs}, span)
        return sema_expr_expected(value, expected, environment, &diagnostics)
    }

    if op == BinOp.Div && lhs.ty == Type.Int && rhs.ty == Type.Int {
        value := sema_tir_expr(Type.Named{name: "Fraction"}, TExprKind.PreciseBuiltin{type_name: "Fraction", function: "from_parts", args: [TExpr]{lhs, rhs}}, span)
        return sema_expr_expected(value, expected, environment, &diagnostics)
    }
    duration := sema_expr_check_duration_binary(op, lhs, rhs, span)
    if duration != None -> return sema_expr_expected(duration ?? lhs, expected, environment, &diagnostics)
    time := sema_expr_check_time_binary(op, lhs, rhs, span, line)
    if time != None -> return sema_expr_expected(time ?? lhs, expected, environment, &diagnostics)
    if (lhs.ty == Type.Named{name: "Instant"} && rhs.ty == Type.Named{name: "Instant"} && op == BinOp.Add) || (lhs.ty == Type.Named{name: "Duration"} && rhs.ty == Type.Named{name: "Instant"} && op == BinOp.Sub) {
        &diagnostics.push(sema_error("E0127", span, "{sema_expr_binary_name(op)} is not available between `{type_name(lhs.ty)}` and `{type_name(rhs.ty)}`", "Time points are positions; only point + delta, point - delta, point - point, and delta + delta are defined", "subtract two Instants for a Duration, or add a Duration to an Instant"))
        return None
    }
    unit_present := sema_expr_unit_fact(lhs.ty, environment) != None || sema_expr_unit_fact(rhs.ty, environment) != None || sema_expr_unit_dimension(lhs.ty, environment) != None || sema_expr_unit_dimension(rhs.ty, environment) != None
    unit := sema_expr_check_unit_binary(op, lhs, rhs, span, line, environment, &scopes, &diagnostics)
    if unit != None -> return sema_expr_expected(unit ?? lhs, expected, environment, &diagnostics)
    if unit_present -> return None
    distinct_lhs := sema_expr_distinct_facts(lhs.ty, environment, &scopes)
    distinct_rhs := sema_expr_distinct_facts(rhs.ty, environment, &scopes)
    if distinct_lhs != None || distinct_rhs != None {
        distinct := sema_expr_check_distinct_binary(op, lhs, rhs, span, line, distinct_lhs, distinct_rhs, &scopes, &diagnostics)
        if distinct != None -> return sema_expr_expected(distinct ?? lhs, expected, environment, &diagnostics)
        return None
    }
    geometry_present := sema_expr_geometry_is_point(lhs.ty) || sema_expr_geometry_is_delta(lhs.ty) || sema_expr_geometry_is_point(rhs.ty) || sema_expr_geometry_is_delta(rhs.ty)
    geometry := sema_expr_check_geometry_binary(op, lhs, rhs, span, line, &diagnostics)
    if geometry != None -> return sema_expr_expected(geometry ?? lhs, expected, environment, &diagnostics)
    if geometry_present -> return None
    precise := sema_expr_check_precise_binary(op, lhs, rhs, span, line, &diagnostics)
    if precise != None -> return sema_expr_expected(precise ?? lhs, expected, environment, &diagnostics)
    if sema_expr_precise_name(lhs.ty) != None || sema_expr_precise_name(rhs.ty) != None {
        return None
    }
    if sema_expr_has_numeric_overload(lhs.ty) || sema_expr_has_numeric_overload(rhs.ty) {
        operator_value := sema_expr_check_operator(op, left, right, lhs, rhs, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics, line)
        if operator_value != None -> return operator_value
    }
    math := sema_expr_check_math_binary(op, lhs, rhs, span, line, &diagnostics)
    if math != None -> return sema_expr_expected(math ?? lhs, expected, environment, &diagnostics)
    math_left := sema_expr_type_base_name(lhs.ty)
    math_right := sema_expr_type_base_name(rhs.ty)
    if (math_left != None && sema_expr_is_math_type_name(math_left ?? "")) || (math_right != None && sema_expr_is_math_type_name(math_right ?? "")) {
        &diagnostics.push(sema_error("E2511", span, "{sema_expr_binary_name(op)} isn't defined between `{type_name(lhs.ty)}` and `{type_name(rhs.ty)}`", "built-in lane and linalg operators keep fixed shapes and scalar rules", "match the operand shapes or call a named math method"))
        return None
    }
    comparison := sema_comparability_check_binary(op, lhs, rhs, span, line, environment, &diagnostics)
    if comparison.handled {
        compared :: comparison.value ?? return None
        return sema_expr_expected(compared, expected, environment, &diagnostics)
    }
    if sema_expr_has_numeric_overload(lhs.ty) || sema_expr_has_numeric_overload(rhs.ty) {
        &diagnostics.push(sema_error("E0360", span, "no {sema_expr_binary_name(op)} operator is defined for `{type_name(lhs.ty)}` and `{type_name(rhs.ty)}`", "user arithmetic and ordering dispatch requires one exact registered trait implementation", "implement the operator trait for this pair, or call a named method"))
        return None
    }

    effective_lhs := lhs
    effective_rhs := rhs
    target := Type?{None}
    if {
        op == BinOp.Shl || op == BinOp.Shr -> {
            if sema_expr_is_integer(lhs.ty) && sema_expr_is_integer(rhs.ty) && (!type_identity_equal(lhs.ty, rhs.ty) || sema_expr_numeric_base(lhs.ty) != lhs.ty || sema_expr_numeric_base(rhs.ty) != rhs.ty) {
                target = Val(sema_expr_numeric_base(lhs.ty))
            }
        }
        op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div || op == BinOp.FloorDiv || op == BinOp.Pow || op == BinOp.Eq || op == BinOp.Ne || op == BinOp.Compare || op == BinOp.Lt || op == BinOp.Gt || op == BinOp.Le || op == BinOp.Ge -> {
            target = sema_expr_numeric_join_values(lhs, rhs)
        }
        op == BinOp.Mod || op == BinOp.Rem || op == BinOp.BitAnd || op == BinOp.BitOr || op == BinOp.BitXor -> {
            if sema_expr_is_integer(lhs.ty) && sema_expr_is_integer(rhs.ty) -> target = sema_expr_numeric_join_values(lhs, rhs)
        }
    }
    if target != None {
        target_type := sema_expr_numeric_base(target ?? lhs.ty)
        effective_lhs = sema_expr_numeric_literal_conversion(lhs, target_type, span, line, &diagnostics) ?? return None
        effective_rhs = sema_expr_numeric_literal_conversion(rhs, target_type, span, line, &diagnostics) ?? return None
    }
    if (op == BinOp.Shl || op == BinOp.Shr) && (!sema_expr_is_integer(effective_lhs.ty) || !sema_expr_is_integer(effective_rhs.ty)) {
        sema_expr_binary_type(op, effective_lhs.ty, effective_rhs.ty, span, &diagnostics) ?? return None
        return None
    }
    ty :: sema_expr_binary_type(op, effective_lhs.ty, effective_rhs.ty, span, &diagnostics) ?? return None
    overflow := false
    if (op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div) && (sema_expr_is_integer(effective_lhs.ty) || sema_expr_is_integer(effective_rhs.ty)) -> overflow = true
    if op == BinOp.Pow && sema_expr_is_integer(effective_lhs.ty) -> overflow = true
    if (op == BinOp.Shl || op == BinOp.Shr) && sema_expr_is_integer(effective_lhs.ty) -> overflow = true
    value :: sema_tir_expr(ty, TExprKind.Binary{op: sema_expr_tir_binary_op(op), overflow: overflow, line: line, lhs: effective_lhs, rhs: effective_rhs}, span)
    sema_expr_expected(value, expected, environment, &diagnostics)
}

fn sema_expr_reject_unlowered(span: Span, diagnostics: &[Diagnostic]) -> TExpr? {
    &diagnostics.push(sema_error("E0119", span, "this expression has no dependency-closed TIR lowering yet", "the checker refuses to invent a successful type or discard expression metadata", "use a supported expression form in this checker path"))
    None
}

fn sema_expr_copy_string_view(value: Expr, scopes: &SemaScopeTable) -> Bool Never! {
    if value == {
        .Ident(name, _) -> {
            index :: sema_scope_resolve_index(scopes, name) ?? return false
            return scopes.bindings[index].string_view
        }
        .Paren(inner, _) -> return sema_expr_copy_string_view(inner, &scopes)
        else -> false
    }
}

// `share`: a D-COPY-DEFAULT1 share site (sema_expr_check_shared_identifier),
// whose copy MIR records with the Share fact, not the authored `~`.
pub fn sema_expr_check_copy_typed(checked: TExpr, span: Span, expected: Type?, environment: SemaScopeEnvironment, context: &SemaCheckContext, diagnostics: &[Diagnostic], string_view: Bool, share: Bool) -> TExpr? {
    facts := sema_copy_classify(checked.ty, SemaCopyIntent.Explicit, environment, context.generic_params, string_view)
    effect_name := sema_copy_effect_name(facts)
    if effect_name != None -> &context.copy_events.push(SemaCopyEvent{span: span, facts: facts})
    if !facts.accepted {
        diagnostic := sema_copy_diagnostic(facts, span)
        if diagnostic != None -> &diagnostics.push(diagnostic ?? sema_error("E0119", span, "copy facts are incomplete", "the copy classifier could not establish a dependency-closed result", "use a type with a known copy contract"))
        return None
    }
    if sema_copy_memory_operation(facts) != None && effect_name == None -> &context.copy_events.push(SemaCopyEvent{span: span, facts: facts})
    result_kind := if share -> TExprKind.Clone{value: checked, fact: MIRCopyFact.Share} else -> TExprKind.ExplicitCopy{value: checked}
    if facts.lowering == {
        .Clone -> result_kind = TExprKind.Clone{value: checked, fact: if share -> MIRCopyFact.Share else -> MIRCopyFact.Explicit}
        .MaterializeView -> result_kind = TExprKind.MaterializeView{value: checked}
        else -> {}
    }
    sema_expr_expected(sema_tir_expr(facts.target, result_kind, span), expected, environment, &diagnostics)
}

fn sema_expr_check_copy(value: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    previous_borrow := context.borrow_ctx
    previous_string_view_read := context.allow_string_view_read
    context.borrow_ctx = true
    context.allow_string_view_read = true
    checked_value := sema_check_expression(value, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    context.borrow_ctx = previous_borrow
    context.allow_string_view_read = previous_string_view_read
    checked :: checked_value ?? return None
    sema_expr_check_copy_typed(checked, span, expected, environment, &context, &diagnostics, sema_expr_copy_string_view(value, &scopes), false)
}

// D-COPY-DEFAULT1=A: an unmarked move site that a later use reached is a
// share. It checks like the authored copy `~name`; MIR records it as a Share
// copy, the clone the TIR read paths can elide like any sema-inserted copy.
fn sema_expr_check_shared_identifier(name: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    previous_borrow := context.borrow_ctx
    previous_string_view_read := context.allow_string_view_read
    context.borrow_ctx = true
    context.allow_string_view_read = true
    checked_value := sema_expr_check_identifier(name, span, None, environment, &scopes, &state, &context, &diagnostics)
    context.borrow_ctx = previous_borrow
    context.allow_string_view_read = previous_string_view_read
    checked :: checked_value ?? return None
    sema_expr_check_copy_typed(checked, span, expected, environment, &context, &diagnostics, sema_expr_copy_string_view(Expr.Ident{name: name, span: span}, &scopes), true)
}

fn sema_expr_require_unsafe(operation: String, span: Span, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if context.unsafe_depth > 0 -> return true
    &diagnostics.push(sema_error("E3103", span, "`{operation}` requires an `#Unsafe` region", "raw pointer operations can violate memory safety and must be explicitly audited", "put this operation inside `#Unsafe(\"reason\") {{ … }}`"))
    false
}

fn sema_expr_core_import_module(environment: SemaScopeEnvironment, alias: String) -> String? {
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return None
    module_index :: sema_registration_module_index(graph, environment.module_identity) ?? return None
    imports :: sema_core_registration_imports(graph.modules[module_index])
    imported :: sema_core_import_find(imports, alias) ?? return None
    target := sema_registration_module_index(graph, imported.module_name)
    if target != None {
        index :: target ?? return None
        return Val(graph.modules[index].module_name)
    }
    Val(imported.module_name)
}

fn sema_expr_check_pointer_from_address(alias: String, alias_span: Span, element: Type, address: Expr, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if sema_expr_core_import_module(environment, alias) != (Val("core.mem")) {
        &diagnostics.push(sema_error("E3102", alias_span, "`Ptr` is part of the low-level tier", "naming `Ptr`, `volatile_read`, or an allocator needs the discovery gate", "add `use core.mem;` and call through `{alias}.…`"))
        _ := sema_check_expression(address, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return None
    }
    forbidden := context.unsafe_depth == 0
    if forbidden {
        &diagnostics.push(sema_error("E3101", span, "`from_addr` can only run inside an `#Unsafe` block", "this operation can violate memory safety, so it must sit in an audited region", "wrap it: #Unsafe(\"why this is safe\") {{ … }}"))
    }
    checked :: sema_check_expression(address, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    valid_address := if checked.ty == {
        .Int | .InlineRange(_, _, _) -> true
        else -> false
    }
    if !valid_address {
        &diagnostics.push(sema_error("E0112", expr_span(address), "`from_addr` needs an Int address, not {type_name(checked.ty)}", "a pointer is built from a numeric machine address", "pass an Int, e.g. from `mem.address_of(x)`"))
        return None
    }
    if forbidden -> return None
    pointer := Type.Apply{name: "Ptr", args: [Type]{element}}
    sema_expr_expected(sema_tir_expr(pointer, TExprKind.PtrFromAddr{address: checked, element: element}, span), expected, environment, &diagnostics)
}

fn sema_expr_check_comptime_name(name: String, span: Span, embedded: CtValue?, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if embedded == .Val(value) {
        ty := sema_expr_expected_type(ast_comptime_value_type(value), environment)
        kind := if value == {
            .Int(number) -> TExprKind.IntLit{value: number, width: None}
            .Float(float_value) -> if float_value == {
                .F32(bits) | .F64(bits) -> TExprKind.FloatLit{value: bits}
            }
            .Bool(flag) -> TExprKind.BoolLit{value: flag}
            .Char(character) -> {
                code :: sema_checked_const_char("{character}") ?? return None
                TExprKind.CharLit{value: code}
            }
            .Str(text) -> TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: text}}}
            .Unit -> TExprKind.Unit
            .Enum(type_name, variant, args) -> if args.len() == 0 -> TExprKind.EnumLit{enum_type: type_name, variant: variant, payload: TEnumPayload.Unit} else -> TExprKind.CtLit{value: sema_checked_comptime(value) ?? return None}
            else -> TExprKind.CtLit{value: sema_checked_comptime(value) ?? return None}
        }
        return sema_expr_expected(sema_tir_expr(ty, kind, span), expected, environment, &diagnostics)
    }
    if sema_scope_resolve_index(scopes, name) == None {
        if scopes.comptime_execution_depth == 0 -> &diagnostics.push(sema_unknown_name(name, span))
        return None
    }
    sema_expr_check_identifier(name, span, expected, environment, &scopes, &state, &context, &diagnostics)
}

fn sema_check_expression_inner(expr: Expr, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    return if expr == {
        .Int(value, span, width, raw) -> sema_expr_integer_literal(sema_expr_exact_integer_literal(value, raw), width, expected, span, environment, &diagnostics)
        .Float(value, span, is_f32, raw) -> sema_expr_float_literal(value, is_f32, raw, span, expected, environment, &diagnostics)
        .Bool(value, span) -> sema_expr_expected(sema_tir_expr(Type.Bool, TExprKind.BoolLit{value: value}, span), expected, environment, &diagnostics)
        .Unit(span) -> sema_expr_expected(sema_tir_expr(Type.Named{name: "Unit"}, TExprKind.Unit, span), expected, environment, &diagnostics)
        .Absent(span) -> sema_expression_absent(span, expected, &diagnostics)
        .Char(value, span) -> sema_expression_char(value, span, expected, environment, &diagnostics)
        .Str(parts, span) -> sema_expr_check_string(parts, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .StrMatchLit(_, span) -> {
            &diagnostics.push(sema_error("E0112", span, "a pattern literal is only valid as a `take_pattern` argument", "this string has typed holes (`{{name:Type}}`), which only `take_pattern` understands", "call it as `cursor.take_pattern(\"…\")`, or drop the `:Type` for an ordinary interpolated string"))
            None
        }
        .BinMatchLit(_, span) -> {
            &diagnostics.push(sema_error("E0112", span, "a binary pattern literal is only valid as a `take_pattern` argument", "this `[U8].{{\"…\"}}` literal has typed holes (`{{name:U<width>}}`), which only `take_pattern` understands", "call it as `reader.take_pattern([U8].{{\"…\"}})`"))
            None
        }
        .UnitLit(raw, int_value, float_value, suffix, suffix_span, span) -> sema_expression_unit_literal(raw, int_value, float_value, suffix, suffix_span, span, expected, environment, &diagnostics)
        .Ident(name, span) -> if sema_ownership_is_share_site(state, span) -> sema_expr_check_shared_identifier(name, span, expected, environment, &scopes, &state, &context, &diagnostics) else -> sema_expr_check_identifier(name, span, expected, environment, &scopes, &state, &context, &diagnostics)
        .ComptimeName(name, span, value) -> sema_expr_check_comptime_name(name, span, value, expected, environment, &scopes, &state, &context, &diagnostics)
        .Paren(value, span) -> {
            checked :: sema_check_expression(value, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            return Val(TExpr{ty: checked.ty, kind: checked.kind, span: span, integer_bounds: checked.integer_bounds, cost: checked.cost})
        }
        .Unary(op, operand, span) -> sema_expr_check_unary(op, operand, expected, span, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Binary(op, left, right, span) -> sema_expr_check_binary(op, left, right, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Call(call) -> {
            if sema_expression_contextual_result_call(call, expected, scopes) == .Val(success) {
                payload := Expr.Unit{span: call.name_span}
                if call.args.len() == 1 -> payload = call.args[0].expr
                span :: Span{start: call.name_span.start, end: expr_span(payload).end}
                if !success -> &context.failure_edges.push("")
                return sema_expression_result_payload(payload, success, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            }
            sema_stmt_uninit_write_args(call.args, state, scopes, &diagnostics)
            sema_expr_check_direct_call(call, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        }
        .CallValue(callee, args, span) -> sema_expr_check_indirect_call(callee, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, _, _, _, _) -> {
            // D-CAP-RECEIVER1=D: check the ordinary unmarked call, then
            // compare the written receiver mark with its resolved convention.
            unmarked :: sema_receiver_mark_begin(&state, receiver)
            fixed_over :: sema_stmt_uninit_fixed_over_take(receiver, method, args, &state, scopes)
            if fixed_over.len() == 0 -> sema_stmt_uninit_write_args(args, state, scopes, &diagnostics)
            checked := sema_expr_check_method_call(unmarked, method, method_span, owner_type_args, type_args, args, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            loop fact in fixed_over -> sema_ownership_uninit_set(&state, fact)
            receiver_last_use := false
            if unmarked == .Ident(name, _) {
                receiver_last_use = !sema_ownership_name_live_after(name, &tail_store, &context)
            }
            sema_receiver_mark_finish(&state, unmarked, scopes, receiver_last_use, &diagnostics)
            checked
        }
        .ListLit(elements, span) -> {
            expanded := sema_expression_list_member_spreads(elements)
            sema_expression_list(Expr.ListLit{elements: expanded, span: span}, expanded, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        }
        .MapLit(entries, span) -> sema_expression_map(expr, entries, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .TupleLit(fields, span, _) -> sema_expression_tuple(fields, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Range(start, end, exclusive, span) -> sema_expression_range(start, end, exclusive, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Index(base, index, span, kind) -> sema_expression_index(base, index, kind, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Slice(base, start, end, range, span) -> sema_expression_slice(base, start, end, range, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Field(base, member, span) -> sema_expression_field(base, member, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .OptField(base, member, member_span, _, span) -> sema_expression_optional_field(base, member, member_span, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .OptMethodCall(receiver, method, method_span, type_args, args, span) -> sema_expression_optional_method_call(receiver, method, method_span, type_args, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Deref(value, span) -> sema_expression_deref(value, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Place(value, access, span) -> {
            if scopes.ownership_call_depth == 0 && !sema_ownership_check_expression(&state, expr, scopes, &diagnostics) -> return None
            sema_expression_place(value, access, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        }
        .TypedLit(head, body, span) -> sema_expression_typed_literal(head, body, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .StructLit(type_name, type_args, _, as_trait, fields, inferred, span) -> sema_expression_struct_literal(type_name, type_args, fields, inferred, as_trait, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .EnumLit(type_name, variant, variant_span, args, leading_dot, span) -> sema_expression_enum_literal(type_name, [Type]{}, variant, args, leading_dot, variant_span, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Present(value, span) -> sema_expression_present(value, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Ok(value, span) -> sema_expression_result_payload(value, true, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Err(value, span) -> {
            // #3708: an `Err` written anywhere in the body (callbacks too) is
            // a failure source of its own; the empty key never resolves.
            &context.failure_edges.push("")
            sema_expression_result_payload(value, false, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        }
        .CompareChain(operands, ops, hooks, span) -> sema_expression_compare_chain(operands, ops, hooks, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .OrFallback(value, fallback, _, span) -> sema_expression_or_fallback(value, fallback, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Try(value, span, conversion, note) -> sema_expression_try(value, span, conversion, note, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .If(condition, then_body, then_value, else_body, else_value, span) -> sema_expression_if(condition, then_body, then_value, else_body, else_value, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Lambda(lambda) -> sema_expression_lambda(lambda, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .ReduceMarker(name, span) -> {
            &diagnostics.push(sema_error("E2510", span, "`#{name}` is only valid inside a lane `.reduce(…)`", "a reduce-op marker names the fold operation; it isn't a value on its own", "write `v.reduce(.Add)`, `.Mul`, `.Min`, `.Max`, or `.Avg`"))
            None
        }
        .Todo(span, _) -> Val(sema_tir_expr(expected ?? Type.Named{name: "Never"}, TExprKind.Never{reason: "todo"}, span))
        .NoElse(span) -> Val(sema_tir_expr(expected ?? Type.Named{name: "Never"}, TExprKind.Never{reason: "no else arm"}, span))
        .RawOf(value, span) -> {
            forbidden := context.unsafe_depth == 0
            if forbidden {
                &diagnostics.push(sema_error("E0208", span, "taking a raw pointer requires `#Unsafe`", "`*x` takes a raw pointer to `x`; that is a raw memory operation, only valid inside a `#Unsafe {{ … }}` region", "wrap this in `#Unsafe(\"why this is safe\") {{ … }}` — to dereference a pointer use postfix `p.*`"))
            }
            checked :: sema_check_expression(value, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
            if forbidden -> return None
            pointer := Type.Apply{name: "Ptr", args: [Type]{checked.ty}}
            sema_expr_expected(sema_tir_expr(pointer, TExprKind.RawOf{value: checked}, span), expected, environment, &diagnostics)
        }
        .PtrFromAddr(alias, alias_span, element, address, span) -> sema_expr_check_pointer_from_address(alias, alias_span, element, address, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Tainted(value, tag_value, span) -> {
            if tag_value != None && !sema_taint_validate_tag(tag_value, environment, span, &diagnostics) -> return None
            sema_check_expression(value, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        }
        .Copy(value, span) -> sema_expr_check_copy(value, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        .Spread(_, span) -> sema_expr_reject_unlowered(span, &diagnostics)
        .MemberSpread(base, members, span) -> {
            fields := sema_expression_member_spread_fields(base, members, span)
            sema_expression_list(Expr.ListLit{elements: fields, span: span}, fields, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        }
        .PatternTest(subject, pattern, span) -> {
            // D-FAILURE-FOUNDATION1=A: an `.Ok`/`.Err` pattern consumes the
            // subject's Result carrier, so its call root must not propagate.
            subject_value :: if sema_pattern_consumes_result_carrier(pattern) -> sema_check_expression_carrier(subject, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(subject, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            checked_subject :: subject_value ?? return None
            checked_pattern := sema_check_pattern(checked_subject, pattern, TPatternPosition.Arm, false, false, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            checked :: checked_pattern.checked ?? return None
            sema_expr_expected(sema_tir_expr(Type.Bool, TExprKind.PatternMatches{subject: checked.subject, pattern: checked.pattern}, span), expected, environment, &diagnostics)
        }
        else -> None
    }
}

// D-COMPILE-STACK1=A: the deepest source nesting sema checks, the limit the
// parser and the TIR evaluator share.
SEMA_MAX_SOURCE_NESTING :: 256

// Enter one checked source form (a statement list or an expression level).
// Past the shared limit this reports E1403 and refuses the form, so nothing
// beneath it is checked; a refused form is not entered.
pub fn sema_enter_source_nesting(context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    depth :: context.source_nesting + 1
    if depth > SEMA_MAX_SOURCE_NESTING {
        &diagnostics.push(sema_error("E1403", span, "this code nests {depth} levels deep; the limit is {SEMA_MAX_SOURCE_NESTING}", "each nested source form needs one compiler checking frame, and the parser, sema, and TIR evaluator enforce the same published limit (D-COMPILE-STACK1=A)", "pull inner parts out into named bindings or helper functions"))
        return false
    }
    context.source_nesting = depth
    true
}

pub fn sema_leave_source_nesting(context: &SemaCheckContext) Never! {
    context.source_nesting -= 1
}

// The parser's empty receiver `Ident("")` of a lower-case `.member` chain.
fn sema_expr_is_bare_subject(expr: Expr) -> Bool Never! {
    if expr == .Ident(name, _) -> return name == ""
    false
}

// D-SUBJECT-CALL1=A (Rust `is_bare_member_chain`): `.a.b(x)` rooted in the
// parser's empty receiver.
fn sema_expr_is_bare_member_chain(expr: Expr) -> Bool Never! {
    if expr == {
        .Field(base, _, _) -> sema_expr_is_bare_subject(base) || sema_expr_is_bare_member_chain(base)
        .MethodCall(receiver, _, _, _, _, _, _, _, _, _) -> sema_expr_is_bare_subject(receiver) || sema_expr_is_bare_member_chain(receiver)
        else -> false
    }
}

// D-SHAPE3a=A: `.new(...)` is inferred construction, never subject shorthand.
fn sema_expr_is_inferred_constructor(expr: Expr) -> Bool Never! {
    if expr == .MethodCall(receiver, method, _, _, _, _, _, _, _, _) -> return method == "new" && sema_expr_is_bare_subject(receiver)
    false
}

fn sema_expr_bare_member_chain_text(expr: Expr) -> String Never! {
    if expr == {
        .Ident(name, _) -> if name == "" -> "" else -> ".member"
        .Field(base, member, _) -> "{sema_expr_bare_member_chain_text(base)}.{member}"
        .MethodCall(receiver, method, _, _, _, _, _, _, _, _) -> "{sema_expr_bare_member_chain_text(receiver)}.{method}(…)"
        else -> ".member"
    }
}

// The chain with its empty receiver named `subject`.
fn sema_expr_replace_bare_subject(expr: Expr, subject: String) -> Expr Never! {
    if expr == {
        .Ident(name, span) -> if name == "" -> Expr.Ident{name: subject, span: span} else -> ~expr
        .Field(base, member, span) -> Expr.Field{base: sema_expr_replace_bare_subject(base, subject), member: member, span: span}
        .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, recv_type, resolved_ret, operator_rhs, checked_widen) -> Expr.MethodCall{receiver: sema_expr_replace_bare_subject(receiver, subject), method: method, method_span: method_span, owner_type_args: owner_type_args, type_args: type_args, args: args, recv_type: recv_type, resolved_ret: resolved_ret, operator_rhs: operator_rhs, checked_widen: checked_widen}
        else -> ~expr
    }
}

// D-SUBJECT-CALL1=A (Rust `infer_inner`): where a one-parameter callable is
// expected, a bare member chain is that callable's subject shorthand, the
// ordinary lambda `(__jet_subject: T) -> __jet_subject.chain`. None when the
// expectation is no unary callable or a bindingless loop owns the subject.
pub fn sema_expr_subject_shorthand(expr: Expr, expected: Type?, context: SemaCheckContext, diagnostics: &[Diagnostic]) -> Lambda? {
    if context.implicit_loop_subject_depth > 0 || !sema_expr_is_bare_member_chain(expr) -> return None
    required :: expected ?? return None
    if required == .Fn(params, _, _, _, _, _) {
        if params.len() != 1 -> return None
        span :: expr_span(expr)
        chain :: sema_expr_bare_member_chain_text(expr)
        if context.subject_shorthand_depth > 0 -> &diagnostics.push(sema_lint("L0512", span, "subject shorthand `{chain}` is nested inside another subject shorthand", "implicit subjects become hard to track when shorthand scopes nest", "rewrite it with a named binding: `(item) -> item{chain}`"))
        subject :: "__jet_subject"
        return Val(Lambda{take_names: [NamedSpan]{}, params: [LambdaParam]{LambdaParam{name: subject, name_span: span, ty: Val(params[0]), ty_span: None}}, effects: None, body: LambdaBody.Expr{value: sema_expr_replace_bare_subject(expr, subject)}, span: span, meta: ast_empty_lambda_meta()})
    }
    None
}

// D-SUBJECT-CALL1=A / D-LOOP-SUBJECT1=A (Rust `infer_inner`): inside a
// bindingless loop a bare member chain reads the implicit `it`; where a
// one-parameter callable is expected it is subject shorthand; elsewhere it
// is no value. Unhandled when `expr` is not a bare member chain.
fn sema_expr_check_bare_member_chain(expr: Expr, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if !sema_expr_is_bare_member_chain(expr) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if context.implicit_loop_subject_depth > 0 -> return SemaMethodSpecialCheck{handled: true, value: sema_check_expression(sema_expr_replace_bare_subject(expr, "it"), expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)}
    required :: expected ?? return SemaMethodSpecialCheck{handled: false, value: None}
    span :: expr_span(expr)
    chain :: sema_expr_bare_member_chain_text(expr)
    shorthand :: sema_expr_subject_shorthand(expr, expected, context, &diagnostics)
    if shorthand == .Val(lambda) {
        context.subject_shorthand_depth += 1
        value :: sema_check_expression(Expr.Lambda{lambda: lambda}, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        context.subject_shorthand_depth -= 1
        return SemaMethodSpecialCheck{handled: true, value: value}
    }
    if required == .Fn(params, _, _, _, _, _) {
        &diagnostics.push(sema_error("E-SUBJECT-CALL-ARITY", span, "a bare member chain cannot supply a {params.len()}-parameter callable here", "lower-case `.member` shorthand supplies exactly one subject; a callable with {params.len()} parameters needs all parameters named", "write the full lambda, for example `(first, second) -> first{chain}`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if sema_expr_is_inferred_constructor(expr) -> return SemaMethodSpecialCheck{handled: false, value: None}
    &diagnostics.push(sema_error("E-SUBJECT-CALL", span, "a bare member chain cannot be used as a value of type {type_name(required)} here", "lower-case `.member` is shorthand only for a one-parameter callable; this argument expects an ordinary value", "write a value of type {type_name(required)}, or use `(subject: {type_name(required)}) -> subject{chain}`"))
    SemaMethodSpecialCheck{handled: true, value: None}
}

pub fn sema_check_expression(expr: Expr, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    bare_member :: sema_expr_check_bare_member_chain(expr, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if bare_member.handled -> return bare_member.value
    if !sema_enter_source_nesting(&context, expr_span(expr), &diagnostics) -> return None
    // D-FAILURE-FOUNDATION1=A: a call root auto-propagates its Result carrier
    // unless a carrier consumer claimed it. Grouping is transparent, so the
    // consumer's one-shot token passes through parentheses.
    carrier_root :: context.failure_carrier_root
    grouping :: if expr == {
        .Paren(_, _) -> true
        else -> false
    }
    if !grouping -> context.failure_carrier_root = false
    propagates :: !grouping && !carrier_root && sema_expression_propagating_call(expr)
    previous_success_view :: context.failure_success_view
    context.failure_success_view = propagates
    checked := sema_check_expression_inner(expr, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    sema_leave_source_nesting(&context)
    context.failure_success_view = previous_success_view
    if propagates && checked != None {
        call_value :: checked ?? return None
        checked = sema_expression_auto_propagate(expr, call_value, expected, environment, &scopes, &context, &diagnostics)
    }
    if checked != None {
        value :: checked ?? return None
        if sema_core_type_uses_default_int(value.ty) -> context.exact_int_reachable = true
        sema_cell_guard_check_construct(expr, value.ty, &diagnostics)
    }
    checked
}

// Check a carrier consumer's subject (`??`, `?`, an `.Ok`/`.Err` pattern): the
// call root keeps its Result carrier; nested calls still propagate.
pub fn sema_check_expression_carrier(expr: Expr, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    context.failure_carrier_root = true
    checked := sema_check_expression(expr, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    context.failure_carrier_root = false
    checked
}
pub fn sema_check_expression_with_lambda_escapes(expr: Expr, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, lambda_escapes: Bool?, diagnostics: &[Diagnostic]) -> TExpr? {
    previous_lambda_escapes := context.lambda_escapes
    context.lambda_escapes = lambda_escapes
    checked := sema_check_expression(expr, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    context.lambda_escapes = previous_lambda_escapes
    checked
}
