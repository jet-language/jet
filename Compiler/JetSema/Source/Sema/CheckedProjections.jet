// Read-only projections of canonical checked reflection and prepared values.
use jet_foundation.[Item, Span, TargetLayoutEngine, TComptimeValue, TComptimeReport, TComptimeField, TOriginProjection, Expr, FactRead, Type, jet_target_layout_struct_facts_in_module]
SemaLayoutProjectionRow: struct {
    name: String
    span: Span
    value: TComptimeValue
}
// `module_index` is the row in `registration` of the module whose `items`
// these are; it qualifies each layout field's TypeId.
sema_checked_layout_items: fn(registration: SemaRegistrationGraph, module_index: Int, items: [Item], engine: TargetLayoutEngine, module_identity: String, rows: &[SemaLayoutProjectionRow]) {
    loop item in items {
        if item == {
            .Struct(definition) -> rows.push(SemaLayoutProjectionRow{name: definition.name, span: definition.name_span, value: sema_comptime_reflection_struct_layout(registration, module_index, definition, engine, jet_target_layout_struct_facts_in_module(engine, definition, module_identity))})
            .Enum(definition) -> rows.push(SemaLayoutProjectionRow{name: definition.name, span: definition.name_span, value: sema_comptime_reflection_enum_layout(registration, module_index, definition, engine, module_identity)})
            .CodeModule(definition) -> if definition.body == .Val(body) -> sema_checked_layout_items(registration, module_index, body, engine, module_identity, rows)
            .GenericModule(definition) -> sema_checked_layout_items(registration, module_index, definition.body, engine, module_identity, rows)
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}
sema_checked_layout_projections: fn(registration: SemaRegistrationGraph, module_index: Int, items: [Item], engine: TargetLayoutEngine, module_identity: String) -> [SemaLayoutProjectionRow] {
    rows := [SemaLayoutProjectionRow]{}
    sema_checked_layout_items(registration, module_index, items, engine, module_identity, rows)
    rows
}
sema_origin_optional_int: fn(value: Int?) -> TComptimeValue Never! {
    if value == .Val(number) -> TComptimeValue.Present{value: TComptimeValue.Int{value: number}} else -> TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Option{inner: Type.Int}}}
}
// Moved/untracked locals answer None; a readable tracked origin retains its
// actual source site.
sema_fact_local_origin: fn(origin: SemaOriginFact?) -> TComptimeValue Never! {
    fact: origin ?? return TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Option{inner: Type.Named{name: "OriginInfo"}}}}
    TComptimeValue.Present{value: TComptimeValue.Struct{type_name: "OriginInfo", fields: [TComptimeField]{
        TComptimeField{name: "tracked", value: TComptimeValue.Bool{value: true}},
        TComptimeField{name: "source", value: TComptimeValue.Present{value: TComptimeValue.String{value: fact.source}}},
        TComptimeField{name: "line", value: sema_origin_optional_int(fact.line)},
        TComptimeField{name: "column", value: sema_origin_optional_int(fact.column)},
        TComptimeField{name: "ambiguity", value: TComptimeValue.Bool{value: false}},
    }}}
}
sema_origin_unwrap: fn(expression: Expr) -> Expr Never! {
    if expression == {
        .Paren(inner, _, _) | .Copy(inner, _, _) | .Place(inner, _, _, _) -> sema_origin_unwrap(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> expression
    }
}
sema_origin_prepared_projection: fn(expression: Expr, ty: Type, value: TComptimeValue, context: &SemaCheckContext) Never! {
    if ty != (Type.Option{inner: Type.Named{name: "OriginInfo"}}) -> return
    init: sema_origin_unwrap(expression)
    if init == {
        .Field(base, member, span, _) -> {
            if sema_fact_read_kind(member) != Val(FactRead.Origin) -> return
            receiver: if sema_origin_unwrap(base) == .Ident(name, _, _) -> name else -> "value"
            context.origin_facts.push(TOriginProjection{receiver: Val(receiver), span: span, value: value})
        }
        .ComptimeName(_, span, _, _) -> context.origin_facts.push(TOriginProjection{receiver: None, span: span, value: value})
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}
