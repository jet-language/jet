// Rust: crates/jet-sema/src/Sema/Bundle.rs:90
struct PendingFunctionDiagnostic {
    function_key: String
    function_span: Span
    diagnostic: Diagnostic
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:96
fn mark_failed_pending_functions(diagnostics: [Diagnostic], pending: [PendingFunctionDiagnostic], failed: &HashSet<String>) {
    loop diagnostic in diagnostics {
        if diagnostic.severity != .Error -> next
        diagnostic.span == .Val(span) ?? continue
        loop candidate in pending {
            if span.start >= candidate.function_span.start && span.end <= candidate.function_span.end -> &failed.insert(~candidate.function_key)
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle.rs:136
// Authored item order is retained while grouped heads become one enum table.
enum OrderedItem { Item(item: Item); Heads(name: String) }
// Rust: crates/jet-sema/src/Sema/Bundle.rs:122
fn desugar_multi_head_functions(bundle: &ProgramBundle, diags: &[Diagnostic]) {
    variants := [String:[(String, VariantPayload)]]{}
    loop module in bundle.modules {
        loop item in module.items {
            if item == .Enum(def) {
                loop variant in def.variants {
                    if !variants.contains_key(variant.name) -> variants[variant.name] = []
                    &variants[variant.name].push((~def.name, ~variant.payload))
                }
            }
        }
    }
    loop module in &bundle.modules {
        items :: ^module.items
        grouped := [String:[Func]]{}
        ordered := [OrderedItem]{}
        loop item in items {
            if item == .Func(function) && function.head_pattern != None {
                name :: ~function.name
                if !grouped.contains_key(name) -> grouped[name] = []
                if grouped[name].is_empty() -> &ordered.push(.Heads(~name))
                &grouped[name].push(^function)
            } else -> &ordered.push(.Item(^item))
        }
        rebuilt := [Item]{}
        loop item in ordered {
            if item == {
                .Item(item) -> &rebuilt.push(^item)
                .Heads(name) -> {
                    heads :: &grouped.remove(name) ?? panic("multi-head placeholder has a group")
                    &rebuilt.push(.Func(fold_multi_head_function(^heads, variants, diags)))
                }
            }
        }
        module.items = ^rebuilt
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:177
fn fold_multi_head_function(heads: [Func], variants: [String:[(String, VariantPayload)]], diags: &[Diagnostic]) -> Func {
    assert(!heads.is_empty(), "multi-head group is non-empty")
    folded := ~heads[0]
    enum_name := None as String?
    invalid := false
    arms := [SwitchArm]{}
    loop head in heads {
        head.head_pattern == .Val(pattern) ?? { invalid = true; continue }
        pattern == .Variant(variant, _, _, _) ?? {
            &diags.push(Diagnostic.error("E0305", "a multi-head declaration needs an enum variant head", "multi-head coverage is proved by the enum pattern table", "write a variant head such as `Circle(radius: Float)`", .Val(pattern_span(pattern))))
            invalid = true
            continue
        }
        variants.get(variant) == .Val(candidates) ?? {
            &diags.push(Diagnostic.error("E0305", "multi-head variant `{variant}` is not an enum variant", "a multi-head table can only cover variants declared by an enum", "check the variant spelling or declare the enum first", .Val(pattern_span(pattern))))
            invalid = true
            continue
        }
        if candidates.is_empty() { invalid = true; continue }
        (candidate_enum, payload) :: candidates[0]
        ambiguous := false
        loop (other_enum, _) in candidates { if other_enum != candidate_enum -> ambiguous = true }
        if ambiguous {
            &diags.push(Diagnostic.error("E0305", "multi-head variant `{variant}` is ambiguous", "a bare head must identify one enum so one table subject can be typed", "use one enum's variants for this function name", .Val(pattern_span(pattern))))
            invalid = true
        }
        if enum_name == .Val(previous) {
            if previous != candidate_enum {
                &diags.push(Diagnostic.error("E0305", "multi-head variants `{previous}` and `{variant}` belong to different enums", "one function has one argument type and one coverage table", "put heads for one enum under one function name", .Val(pattern_span(pattern))))
                invalid = true
            }
        } else -> enum_name = .Val(~candidate_enum)
        expected := [Type]{}
        if payload == {
            .Unit -> {}
            .Single(ty, _) -> &expected.push(~ty)
            .Named(fields) -> { loop field in fields -> &expected.push(~field.ty) }
        }
        loop index in 0..<head.params.len().min(expected.len()) {
            param :: head.params[index]
            expected_ty :: expected[index]
            if param.ty != expected_ty {
                &diags.push(Diagnostic.error("E0305", "multi-head binding `{param.name}` has type `{type_show(param.ty)}` but variant `{variant}` carries `{type_show(expected_ty)}`", "head bindings must use the variant payload types", "write `{type_show(expected_ty)}` for this binding", .Val(param.ty_span)))
                invalid = true
            }
        }
        span :: pattern_span(pattern)
        &arms.push(SwitchArm{cond: .PatternTest(.Ident(Syntax.INTERNAL_MULTI_HEAD_SUBJECT, folded.name_span), ~pattern, span), body: ~head.body, span: span})
    }
    if invalid || enum_name == None { folded.head_pattern = None; return ^folded }
    name :: enum_name ?? panic("validated multi-head enum")
    full_span :: Span{start: folded.span.start, end: heads[heads.len() - 1].span.end}
    subject :: Expr.Ident(Syntax.INTERNAL_MULTI_HEAD_SUBJECT, folded.name_span)
    folded.params = [Param{convention: .Read, root: false, name: Syntax.INTERNAL_MULTI_HEAD_SUBJECT, name_span: folded.name_span, public_label: None, zone: .Either, ty: .Named(name), ty_span: folded.name_span, default: None, variadic: false, variadic_bound_list: None, declared_view_from_names: None}]
    folded.body = [Stmt.Switch(subject, ^arms, None, folded.name_span)]
    folded.span = full_span
    folded.return_view_provenance = None
    folded.declared_return_view_provenance = None
    folded.head_pattern = None
    ^folded
}

// Rust: crates/jet-sema/src/Sema/Bundle.rs:332
fn dedupe_unknown_names(diagnostics: &[Diagnostic]) {
    // GATE #4499: exact composite hash keys; no encoded-string equivalence.
    seen_unknown := HashSet<(Int, Int)>{}
    seen_exact := HashSet<(String, String, String, String, Int, Int)>{}
    &diagnostics.retain(fn(diagnostic) {
        if diagnostic.code == "E0107" {
            if diagnostic.span == .Val(span) -> return &seen_unknown.insert((span.start, span.end))
            return true
        }
        if diagnostic.code == "E0119" || diagnostic.code == "E0302" || diagnostic.code == "E0354" || diagnostic.code == "E0358" {
            if diagnostic.span == .Val(span) -> return &seen_exact.insert((~diagnostic.code, ~diagnostic.what, ~diagnostic.why, ~diagnostic.fix, span.start, span.end))
        }
        true
    })
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:365
fn prune_conversion_cascades(diagnostics: &[Diagnostic]) {
    impure_spans := HashSet<Span>{}
    vault_spans := HashSet<Span>{}
    loop diagnostic in diagnostics {
        if diagnostic.span == .Val(span) {
            if diagnostic.code == "E3401" -> &impure_spans.insert(span)
            if diagnostic.code == "E0510" -> &vault_spans.insert(span)
        }
    }
    if !impure_spans.is_empty() || !vault_spans.is_empty() {
        &diagnostics.retain(fn(diagnostic) {
            if diagnostic.span == .Val(span) {
                if diagnostic.code == "E2404" -> return !impure_spans.contains(span)
                if diagnostic.code == "E2402" -> return !vault_spans.contains(span)
            }
            true
        })
    }
    // GATE #4499: exact pair equality/hash includes declaration provenance.
    seen_failure_domains := HashSet<(String, String)>{}
    &diagnostics.retain(fn(diagnostic) {
        diagnostic.detail == .Val(raw_detail) ?? return true
        detail := raw_detail.strip_prefix("failure-domain:") ?? return true // #4303
        lines :: detail.lines()
        if lines.is_empty() -> return true
        domain :: lines[0]
        definition := ""
        loop line in lines {
            if line.strip_prefix("definition: ") == .Val(value) { definition = value; break }
        }
        diagnostic.code != "E2404" || &seen_failure_domains.insert((domain.to_string(), definition.to_string()))
    })
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:414
fn dedupe_soft_public_lints(diagnostics: &[Diagnostic]) {
    // GATE #4499: exact composite keys preserve separate messages at a span.
    seen := HashSet<(String, String, Int, Int)>{}
    &diagnostics.retain(fn(diagnostic) {
        if diagnostic.code != "L0601" -> return true
        diagnostic.span == .Val(span) ?? return true
        &seen.insert((~diagnostic.code, ~diagnostic.what, span.start, span.end))
    })
}

// Rust: crates/jet-sema/src/Sema/Bundle.rs:432
fn check_fact_tags_and_states(bundle: ProgramBundle, states: [ModuleState], returns: [String:TagSet], return_types: ReturnTypes, diags: &[Diagnostic]) -> FactRegistry {
    facts := FactRegistry.default()
    register_effect_facts(bundle, &facts)
    register_builtin_tag_facts(&facts)
    scrubbers := [:]
    field_tags := [:]
    field_types := [:]
    known_sources := HashSet<String>{}
    loop module in bundle.modules -> collect_function_paths(module.alias, module.items, &known_sources)
    loop module in bundle.modules {
        collect_field_facts(module.items, &field_tags, &field_types)
        collect_tag_facts(module.items, &facts, &scrubbers, known_sources, diags, true)
    }
    loop module in bundle.modules -> collect_tag_facts(module.items, &facts, &scrubbers, known_sources, diags, false)
    loop index in 0..<bundle.modules.len() {
        loop item in bundle.modules[index].items -> taint_check_item(item, scrubbers, facts, returns, return_types, field_tags, field_types, states[index].core_imports, diags)
    }
    state_table := StateTable.with_facts(^facts)
    loop module in bundle.modules -> &state_table.add_items(module.items)
    if !state_table.is_empty() {
        all_items := [Item]{}
        loop module in bundle.modules { loop item in module.items -> &all_items.push(~item) }
        &state_table.validate_declarations(all_items, diags)
        loop module in bundle.modules -> check_items_state(module.items, state_table, diags)
    }
    ^state_table.into_facts()
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:519
fn collect(items: [Item], facts: &FactRegistry) {
    loop item in items {
        if item == {
            .EffectDecl(declaration) -> {
                root :: effect_root(declaration.name)
                if declaration.name.strip_prefix(root) == .Val(suffix) && suffix.strip_prefix(".") == .Val(member) -> &facts.declare_member(.Effect, root.to_string(), member.to_string())
            }
            .CodeModule(module) -> { if module.body == .Val(body) -> collect(body, facts) }
            .GenericModule(module) -> collect(module.body, facts)
            else -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:509
fn register_effect_facts(bundle: ProgramBundle, facts: &FactRegistry) {
    loop effect in EFFECT_ROOTS -> &facts.declare(.Effect, ~effect, [String]{})
    loop name in Syntax.BUILTIN_EFFECT_LEAVES {
        root :: effect_root(name)
        suffix := name.strip_prefix(root) ?? panic("effect root prefix") // #4303
        member := suffix.trim_start_matches(".") // #4303
        &facts.declare_member(.Effect, root.to_string(), member.to_string())
    }
    loop module in bundle.modules -> collect(module.items, facts)
}

// Rust: crates/jet-sema/src/Sema/Bundle.rs:555
fn check_name(name: String, span: Span, facts: FactRegistry, diags: &[Diagnostic]) {
    if resolve_effect_name(name, facts) == .Err(suggestion) && parse_effect_name(name) != None -> &diags.push(undeclared_effect(name, suggestion, .Val(span)))
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:571
fn check_type(ty: Type, facts: FactRegistry, diags: &[Diagnostic]) {
    if ty == {
        .Fn(params, ret, effect_bound, _, _, _) -> {
            loop parameter in params -> check_type(parameter, facts, diags)
            if ret == .Val(value) -> check_type(value, facts, diags)
            if effect_bound == .Val(names) {
                loop entry in names { if effect_row_var(entry.name) == None -> check_name(entry.name, entry.span, facts, diags) }
            }
        }
        .List(inner) | .Option(inner) | .Shared(inner) | .Tagged(_, inner) | .FixedList(inner, _) -> check_type(inner, facts, diags)
        .Result(ok, err) -> { check_type(ok, facts, diags); check_type(err, facts, diags) }
        .Apply(_, args) | .Union(args) -> { loop argument in args -> check_type(argument, facts, diags) }
        .Map(key, _, value) -> { check_type(key, facts, diags); check_type(value, facts, diags) }
        .Tuple(fields) -> { loop field in fields -> check_type(field.ty, facts, diags) }
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:623
fn check_stmts(body: [Stmt], facts: FactRegistry, diags: &[Diagnostic]) {
    loop statement in body {
        if statement == {
            .Val(binding) -> { if binding.ty == .Val(ty) -> check_type(ty, facts, diags) }
            .CountedLoop(init, _, _, _, _, _, _) -> { if init.ty == .Val(ty) -> check_type(ty, facts, diags) }
            else -> {}
        }
        loop nested in nested_bodies(statement) -> check_stmts(nested, facts, diags)
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:647
fn check_func(function: Func, facts: FactRegistry, diags: &[Diagnostic]) {
    if function.declared_effects == .Val(names) {
        loop entry in names {
            name := entry.name.strip_prefix("!") ?? entry.name // #4303
            if effect_row_var(name) == None -> check_name(name.to_string(), entry.span, facts, diags)
        }
    }
    loop parameter in function.params -> check_type(parameter.ty, facts, diags)
    if function.return_type == .Val(return_type) -> check_type(return_type, facts, diags)
    check_stmts(function.body, facts, diags)
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:668
fn check_items(items: [Item], facts: FactRegistry, diags: &[Diagnostic]) {
    loop item in items {
        if item == {
            .EffectDecl(declaration) -> {
                if parse_effect_name(declaration.name) == None -> &diags.push(unknown_effect(declaration.name, declaration.name_span))
                else if !declaration.name.contains(".") -> &diags.push(effect_leaf_required(declaration.name, .Val(declaration.name_span)))
            }
            .Func(function) -> check_func(function, facts, diags)
            .Struct(definition) -> {
                loop field in definition.fields -> check_type(field.ty, facts, diags)
                loop function in definition.methods -> check_func(function, facts, diags)
                loop implementation in definition.trait_impls { loop function in implementation.methods -> check_func(function, facts, diags) }
            }
            .Enum(definition) -> {
                loop variant in definition.variants {
                    if variant.payload == {
                        .Unit -> {}
                        .Single(ty, _) -> check_type(ty, facts, diags)
                        .Named(fields) -> { loop field in fields -> check_type(field.ty, facts, diags) }
                    }
                }
                loop function in definition.methods -> check_func(function, facts, diags)
                loop implementation in definition.trait_impls { loop function in implementation.methods -> check_func(function, facts, diags) }
            }
            .Impl(implementation) -> { loop function in implementation.methods -> check_func(function, facts, diags) }
            .Trait(definition) -> {
                loop method in definition.methods {
                    if method.declared_effects == .Val(names) { loop entry in names -> check_name(entry.name, entry.span, facts, diags) }
                    loop parameter in method.params -> check_type(parameter.ty, facts, diags)
                    if method.return_type == .Val(return_type) -> check_type(return_type, facts, diags)
                    if method.default_body == .Val(body) -> check_stmts(body, facts, diags)
                }
            }
            .Test(test) -> check_stmts(test.body, facts, diags)
            .CodeModule(module) -> { if module.body == .Val(body) -> check_items(body, facts, diags) }
            .GenericModule(module) -> check_items(module.body, facts, diags)
            else -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:551
fn validate_declared_effects(bundle: ProgramBundle, facts: FactRegistry) -> [Diagnostic] {
    diags := [Diagnostic]{}
    loop module in bundle.modules -> check_items(module.items, facts, &diags)
    ^diags
}

// Rust: crates/jet-sema/src/Sema/Bundle.rs:766
pub struct IncrementalSemaCache {
    environment: [U8]
    module_interfaces: [String:[U8]]
    module_dependencies: [String:[String]]
    functions: [String:CachedFunctionBody]
    hits: U64
    recomputes: U64
    measurement_recomputed_items: [String]
}
impl IncrementalSemaCache {
    // Rust: crates/jet-sema/src/Sema/Bundle.rs:778
    pub fn new() -> Self {
        Self{environment: [], module_interfaces: [:], module_dependencies: [:], functions: [:], hits: 0, recomputes: 0, measurement_recomputed_items: []}
    }
    // Rust: crates/jet-sema/src/Sema/Bundle.rs:782
    pub fn stats(self) -> IncrementalSemaStats {
        bytes := self.environment.len()
        loop (module, fingerprint) in self.module_interfaces -> bytes += module.bytes().len() + fingerprint.len()
        loop (module, dependencies) in self.module_dependencies {
            bytes += module.bytes().len()
            loop dependency in dependencies -> bytes += dependency.bytes().len()
        }
        loop (key, entry) in self.functions {
            bytes += key.bytes().len() + entry.input.len() + "{entry.function:Debug}{entry.diagnostics:Debug}{entry.summaries:Debug}{entry.comptime_inputs:Debug}{entry.address_taken:Debug}{entry.name_ledger:Debug}{entry.pending_diagnostics:Debug}".bytes().len()
        }
        IncrementalSemaStats{hits: self.hits, recomputes: self.recomputes, live_items: self.functions.len(), live_item_bytes: bytes, recomputed_items: ~self.measurement_recomputed_items}
    }
    // Rust: crates/jet-sema/src/Sema/Bundle.rs:822
    pub fn clear_measurement(self: &Self) { &self.measurement_recomputed_items.clear() }
    // Rust: crates/jet-sema/src/Sema/Bundle.rs:826
    pub fn clear(self: &Self) {
        &self.environment.clear()
        &self.module_interfaces.clear()
        &self.module_dependencies.clear()
        &self.functions.clear()
        &self.measurement_recomputed_items.clear()
    }
    // Rust: crates/jet-sema/src/Sema/Bundle.rs:834
    fn begin_bundle(self: &Self, bundle: ProgramBundle, name_ledger: NameLedger, plugin_interfaces: PluginInterfaceRegistry) {
        environment :: incremental_global_environment(bundle, plugin_interfaces.digest())
        environment_changed :: self.environment != environment
        if environment_changed -> self.environment = ^environment
        interfaces := [String:[U8]]{}
        loop module in bundle.modules -> interfaces[module.display] = incremental_module_interface(module)
        dependencies :: incremental_module_dependencies_with_ledger(bundle, name_ledger)
        dirty := HashSet<String>{}
        loop (module, _) in self.module_interfaces { if !interfaces.contains_key(module) -> &dirty.insert(~module) }
        loop (module, fingerprint) in interfaces { if self.module_interfaces.get(module) != .Val(fingerprint) -> &dirty.insert(~module) }
        loop (module, previous) in self.module_dependencies { if dependencies.get(module) != .Val(previous) -> &dirty.insert(~module) }
        loop (module, current) in dependencies { if self.module_dependencies.get(module) != .Val(current) -> &dirty.insert(~module) }
        if environment_changed { loop module in interfaces.keys() -> &dirty.insert(~module) }
        loop {
            newly_dirty := [String]{}
            loop (module, imported) in dependencies {
                if dirty.contains(module) -> next
                loop dependency in imported {
                    if dirty.contains(dependency) { &newly_dirty.push(~module); break }
                }
            }
            if newly_dirty.is_empty() -> break
            loop module in newly_dirty -> &dirty.insert(^module)
        }
        if !dirty.is_empty() {
            &self.functions.retain(fn(key, _) {
                loop module in dirty { if key == module || key.starts_with("{module}::") -> return false }
                true
            })
        }
        self.module_interfaces = ^interfaces
        self.module_dependencies = ^dependencies
    }
    // Rust: crates/jet-sema/src/Sema/Bundle.rs:910
    fn get(self: &Self, key: String, input: [U8]) -> CachedFunctionBody? {
        if self.functions.get(key) == .Val(entry) && entry.input == input {
            self.hits += 1
            return .Val(~entry)
        }
        None
    }
    // Rust: crates/jet-sema/src/Sema/Bundle.rs:922
    fn store(self: &Self, key: String, entry: CachedFunctionBody) {
        &self.record_recompute(~key)
        self.functions[key] = ^entry
    }
    // Rust: crates/jet-sema/src/Sema/Bundle.rs:927
    fn record_recompute(self: &Self, key: String) {
        self.recomputes += 1
        &self.measurement_recomputed_items.push(^key)
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:933
fn incremental_global_environment(bundle: ProgramBundle, plugin_digest: String) -> [U8] {
    guarantees :: bundle.package_guarantees
    authority :: guarantees.application_authority
    package_policy :: (guarantees.contain, guarantees.harden, guarantees.dependency_names, guarantees.effects, guarantees.unsafe_paths, guarantees.expert, guarantees.deps, guarantees.lints_deny, guarantees.memory_denials, authority.granted_effects, authority.denied_effects, authority.authority)
    // Clock-only facts do not invalidate bodies; git/toolchain facts do.
    build_facts := ~bundle.build_facts
    &build_facts.stamp.at.clear()
    _ :: &build_facts.contributions.remove("Build.Stamp.At")
    _ :: &build_facts.setting_provenance.remove("Build.Stamp.At")
    out := canonical_fragment((bundle.entry, bundle.project_root, bundle.active_os, bundle.web_partition_enforced, build_facts, bundle.layer_ceiling, bundle.edition, package_policy, plugin_digest))
    &out.extend("{bundle.project_root:Debug}".bytes())
    ^out
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:980
fn incremental_module_interface(module: LoadedModule) -> [U8] {
    out := [U8]{}
    &out.extend(canonical_fragment((module.path, module.display, module.alias, module.imports, module.web_target_ceiling, module.pub_file, module.no_prelude, module.default_target, module.html_path, module.policy_declarations)))
    &out.extend(canonical_fragment((module.user_policy_declarations, module.rule_facts, module.script_body)))
    loop source_item in module.items {
        item := ~source_item
        clear_callable_bodies(&item)
        &out.extend(canonical_fragment(item))
    }
    ^out
}
