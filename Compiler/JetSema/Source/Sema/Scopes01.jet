//RS             .package_guarantees
//RS             .application_authority
//RS             .denied_effects,
//RS         &bundle.package_guarantees.application_authority.authority,
//RS     );
//RS     // `BuildStamp.at` is a clock. Unlocked checks mint a new timestamp on
