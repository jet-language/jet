// Rust: crates/jet-sema/src/Sema/Bundle.rs:1019
fn incremental_module_dependencies_with_ledger(bundle: ProgramBundle, name_ledger: NameLedger) -> [String:[String]] {
    result := [String:[String]]{}
    loop module_idx in 0..<bundle.modules.len() {
        module :: bundle.modules[module_idx]
        dependencies := [String]{}
        loop (_, import) in walk_imports(module) {
            if incremental_import_target(bundle, name_ledger, module_idx, module, import) == .Val(target) -> &dependencies.push(^target)
        }
        &dependencies.sort()
        &dependencies.dedup()
        result[module.display] = ^dependencies
    }
    ^result
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1045
fn incremental_import_target(bundle: ProgramBundle, name_ledger: NameLedger, source_idx: Int, source: LoadedModule, import: ImportDecl) -> String? {
    if name_ledger.import_target(source_idx, import.span) == .Val(target) {
        if target >= 0 && target < bundle.modules.len() -> return .Val(~bundle.modules[target].display)
        return None
    }
    requested :: if import.kind == { .File(path, _) | .Module(path, _) -> path; .Unqualified(module_alias, _) -> module_alias }
    requested_stem :: OSPath.from(requested).file_stem().and_then(fn(stem) { stem.to_str() }) ?? requested
    requested_path := None as OSPath?
    if import.kind == .File(_, _) {
        path := (source.path.parent() ?? OSPath.from(".")).join(requested)
        if path.extension() == None -> &path.set_extension(Syntax.FILE_EXT.trim_start_matches(".").to_string())
        requested_path = .Val(normalize_incremental_path(path))
    }
    loop candidate in bundle.modules {
        if candidate.display == source.display -> next
        directory_module :: candidate.path.file_name().and_then(fn(name) { name.to_str() }) == .Val(Syntax.DEFAULT_ENTRY_FILE) && candidate.path.parent().and_then(fn(parent) { parent.file_name() }).and_then(fn(name) { name.to_str() }) == .Val(requested_stem)
        path_matches :: if requested_path == { .Val(path) -> normalize_incremental_path(candidate.path) == path; else -> false }
        if path_matches || candidate.alias == requested || candidate.alias == requested_stem || candidate.display == requested || candidate.display.ends_with("/{requested}") || candidate.display.ends_with("/{requested_stem}.jet") || directory_module -> return .Val(~candidate.display)
    }
    None
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1112
fn normalize_incremental_path(path: OSPath) -> OSPath {
    normalized := OSPath.new()
    loop component in path.components() {
        if component == {
            .CurDir -> {}
            .ParentDir -> { _ :: &normalized.pop() }
            else -> &normalized.push(component.as_os_str())
        }
    }
    ^normalized
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1127
fn clear(function: &Func) {
    &function.body.clear()
    function.span = function.name_span
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1126
fn clear_callable_bodies(item: &Item) {
    if item == {
        .Func(function) -> clear(&function)
        .Struct(definition) -> {
            loop function in &definition.methods -> clear(&function)
            loop implementation in &definition.trait_impls { loop function in &implementation.methods -> clear(&function) }
        }
        .Enum(definition) -> {
            loop function in &definition.methods -> clear(&function)
            loop implementation in &definition.trait_impls { loop function in &implementation.methods -> clear(&function) }
        }
        .Impl(implementation) -> { loop function in &implementation.methods -> clear(&function) }
        .CodeModule(module) -> { if module.body == .Val(body) { loop nested in &body -> clear_callable_bodies(&nested) } }
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1157
fn builtin_type_registry() -> TypeRegistry {
    zero :: Span{start: 0, end: 0}
    variants := [String:(Span, VariantPayload)]{}
    variant_order := [String]{}
    loop name in Syntax.ORDERING_VARIANTS {
        variants[name] = (zero, .Unit)
        &variant_order.push(~name)
    }
    types := [String:TypeDef]{}
    types[Syntax.TYPE_ORDERING] = .Enum(^variants, ^variant_order, [:], [:], false, None, false, None)
    remove_by_variants := [String:(Span, VariantPayload)]{}
    loop name in ["Val", "Slot"] -> remove_by_variants[name] = (zero, .Unit)
    types[Syntax.TYPE_REMOVE_BY] = .Enum(^remove_by_variants, ["Val", "Slot"], [:], [:], false, None, false, None)
    time_dimension :: .Val(Dimension.base("core.units::Time"))
    time_package :: OSPath.from("core.units")
    zero_ratio :: UnitRatio.zero()
    one_ratio :: UnitRatio.integer(1)
    unit_types := HashSet<String>{}
    &unit_types.insert(Syntax.DURATION_TYPE)
    &unit_types.insert(Syntax.TYPE_INSTANT)
    unit_facts := [String:UnitFact]{}
    unit_facts[Syntax.DURATION_TYPE] = UnitFact{package: ~time_package, family: "Time", member: "ns", dimension: ~time_dimension, scale: ~one_ratio, scale_provenance: .Rational, offset: ~zero_ratio, kind: .Delta}
    unit_facts[Syntax.TYPE_INSTANT] = UnitFact{package: time_package, family: "Time", member: "ns", dimension: time_dimension, scale: one_ratio, scale_provenance: .Rational, offset: zero_ratio, kind: .Point}
    TypeRegistry{types: ^types, error_types: HashSet<String>{}, unit_types: ^unit_types, unit_facts: ^unit_facts, literal_facts: [:], computed_fields: [:], field_defaults: [:], receipt_sections: [:], nominal_memo: NominalMemo.default()}
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1245
fn unit_fact(family: UnitFamilyDef, type_name: String, dimension: Dimension?, package: OSPath) -> UnitFact? {
    affine := false
    if family.base != None { loop member in family.members { if member.offset != UnitRatio.zero() -> affine = true } }
    loop member in family.members {
        stem :: UnitFamilyDef.type_name(member.name)
        kind :: if {
            affine -> {
                if type_name == "{stem}Point" -> QuantityKind.Point
                else if type_name == "{stem}Delta" -> QuantityKind.Delta
                else -> continue
            }
            type_name == stem -> QuantityKind.Linear
            else -> continue
        }
        return .Val(UnitFact{package: ~package, family: ~family.family, member: ~member.name, dimension: ~dimension, scale: ~member.scale, scale_provenance: ~member.scale_provenance, offset: if kind == .Point -> ~member.offset else -> UnitRatio.zero(), kind: kind})
    }
    None
}

// Rust: crates/jet-sema/src/Sema/Bundle.rs:1288
fn declare_name(ledger: &NameLedger, module: Int, name: String, path: String, kind: String, span: Span, visibility: NameVisibility) {
    &ledger.declare(module, ^name, ^path, kind, span, visibility)
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1307
fn scoped_name(prefix: String?, name: String) -> String {
    if prefix == { .Val(prefix) -> member_name(prefix, name); else -> ~name }
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1314
fn scoped_path(prefix: String, name: String) -> String { "{prefix}.{name}" }
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1318
fn declare_method_names(ledger: &NameLedger, module: Int, owner: String, owner_path: String, methods: [Func]) {
    loop method in methods -> declare_name(ledger, module, "{owner}.{method.name}", "{owner_path}.{method.name}", "method", method.name_span, NameVisibility.from_flags(method.is_pub, method.is_package_pub))
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1338
fn declare_item_names_scoped(ledger: &NameLedger, module: Int, path_prefix: String, name_prefix: String?, item: Item) {
    if item == {
        .Func(function) -> declare_name(ledger, module, scoped_name(name_prefix, function.name), scoped_path(path_prefix, function.name), "function", function.name_span, NameVisibility.from_flags(function.is_pub, function.is_package_pub))
        .Struct(definition) -> {
            item_name :: scoped_name(name_prefix, definition.name)
            item_path :: scoped_path(path_prefix, definition.name)
            visibility :: NameVisibility.from_flags(definition.is_pub, definition.is_package_pub)
            declare_name(ledger, module, ~item_name, ~item_path, "type", definition.name_span, visibility)
            loop field in definition.fields -> declare_name(ledger, module, "{item_name}.{field.name}", "{item_path}.{field.name}", "field", field.name_span, NameVisibility.from_flags(field.is_pub, field.is_package_pub))
            if definition.state == .Val(state) {
                loop entry in state.states -> declare_name(ledger, module, "{item_name}.State.{entry.name}", "{item_path}.State.{entry.name}", "state", entry.span, visibility)
            }
            declare_method_names(ledger, module, item_name, item_path, definition.methods)
            loop implementation in definition.trait_impls -> declare_method_names(ledger, module, item_name, item_path, implementation.methods)
        }
        .Enum(definition) -> {
            item_name :: scoped_name(name_prefix, definition.name)
            item_path :: scoped_path(path_prefix, definition.name)
            visibility :: NameVisibility.from_flags(definition.is_pub, definition.is_package_pub)
            declare_name(ledger, module, ~item_name, ~item_path, "type", definition.name_span, visibility)
            loop variant in definition.variants -> declare_name(ledger, module, "{item_name}.{variant.name}", "{item_path}.{variant.name}", "variant", variant.name_span, visibility)
            declare_method_names(ledger, module, item_name, item_path, definition.methods)
            loop implementation in definition.trait_impls -> declare_method_names(ledger, module, item_name, item_path, implementation.methods)
        }
        .Distinct(definition) -> declare_name(ledger, module, scoped_name(name_prefix, definition.name), scoped_path(path_prefix, definition.name), "type", definition.name_span, NameVisibility.from_flags(definition.is_pub, definition.is_package_pub))
        .TypeAlias(definition) -> declare_name(ledger, module, scoped_name(name_prefix, definition.name), scoped_path(path_prefix, definition.name), "type", definition.name_span, NameVisibility.from_flags(definition.is_pub, definition.is_package_pub))
        .UnitFamily(family) -> {
            loop definition in family.distinct_defs() -> declare_name(ledger, module, scoped_name(name_prefix, definition.name), scoped_path(path_prefix, definition.name), "type", definition.name_span, NameVisibility.from_flags(definition.is_pub, definition.is_package_pub))
        }
        .Trait(definition) -> {
            item_name :: scoped_name(name_prefix, definition.name)
            item_path :: scoped_path(path_prefix, definition.name)
            visibility :: NameVisibility.from_flags(definition.is_pub, definition.is_package_pub)
            declare_name(ledger, module, ~item_name, ~item_path, "trait", definition.name_span, visibility)
            loop method in definition.methods -> declare_name(ledger, module, "{item_name}.{method.name}", "{item_path}.{method.name}", "method", method.name_span, visibility)
        }
        .Tag(definition) -> declare_name(ledger, module, scoped_name(name_prefix, definition.name), scoped_path(path_prefix, definition.name), "tag", definition.name_span, NameVisibility.from_flags(definition.is_pub, definition.is_package_pub))
        .Impl(implementation) -> {
            owner :: scoped_name(name_prefix, implementation.type_name)
            owner_path :: scoped_path(path_prefix, implementation.type_name)
            declare_method_names(ledger, module, owner, owner_path, implementation.methods)
            loop entry in implementation.assoc_type_impls -> declare_name(ledger, module, "{owner}.{entry.name}", "{owner_path}.{entry.name}", "associated_type", entry.span, .Private)
        }
        .Const(definition) -> declare_name(ledger, module, scoped_name(name_prefix, definition.name), scoped_path(path_prefix, definition.name), "const", definition.name_span, NameVisibility.from_flags(definition.is_pub, definition.is_package_pub))
        .ExternRust(block) -> {
            loop function in block.functions -> declare_name(ledger, module, scoped_name(name_prefix, function.name), scoped_path(path_prefix, function.name), "extern", function.name_span, .Private)
        }
        .CModule(module_def) -> {
            loop function in module_def.functions -> declare_name(ledger, module, scoped_name(name_prefix, function.name), scoped_path(path_prefix, function.name), "extern", function.name_span, .Public)
        }
        .CodeModule(code_module) -> {
            item_name :: scoped_name(name_prefix, code_module.name)
            item_path :: scoped_path(path_prefix, code_module.name)
            visibility :: NameVisibility.from_flags(code_module.is_pub, code_module.is_package_pub)
            kind :: if code_module.body != None -> "module" else -> "file_module"
            declare_name(ledger, module, ~item_name, ~item_path, kind, code_module.name_span, visibility)
            if code_module.body == .Val(body) { loop nested in body -> declare_item_names_scoped(ledger, module, item_path, .Val(item_name), nested) }
        }
        .ProtocolDecl(protocol) -> declare_name(ledger, module, scoped_name(name_prefix, protocol.name), scoped_path(path_prefix, protocol.name), "protocol", protocol.name_span, NameVisibility.from_flags(protocol.is_pub, protocol.is_package_pub))
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1597
fn declare_item_names(ledger: &NameLedger, module: Int, module_alias: String, item: Item) {
    declare_item_names_scoped(ledger, module, module_alias, None, item)
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1606
fn state_marker_path(expr: Expr) -> (String, Span)? {
    if expr == {
        .Ident(name, span) -> .Val((~name, span))
        .Field(base, member, span) -> {
            (path, _) :: state_marker_path(base) ?? return None
            .Val(("{path}.{member}", span))
        }
        else -> None
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1616
fn record_state_marker_references_for_method(ledger: &NameLedger, module_idx: Int, source_module: String, owner: String, method: Func) {
    loop marker in method.markers {
        slots :: if { marker.name == Syntax.KW_STATE -> [0]; marker.name == Syntax.KW_TRANSITION -> [0, 1]; else -> [Int]{} }
        loop slot in slots {
            expr :: marker.expr_arg(slot) ?? continue
            (raw, span) :: state_marker_path(expr) ?? continue
            if raw == Syntax.STATE_ENTRY -> next
            // Qualified state names never fall back to the current owner's leaf.
            candidate :: if raw.contains(".State.") -> raw else -> "{owner}.State.{raw}"
            declaration :: ledger.declaration(module_idx, candidate) ?? continue
            target_module :: declaration.module
            def_span :: declaration.span
            semantic_identity :: ledger.semantic_identity(target_module, candidate)
            module_path :: ledger.module_path(target_module) ?? source_module
            &ledger.record_reference(~source_module, span.start, span.end, NameReference{module_path: ~module_path, kind: "state", def_span: def_span, semantic_identity: semantic_identity})
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1680
fn record_state_marker_references_in_items(ledger: &NameLedger, module_idx: Int, source_module: String, items: [Item], prefix: String?) {
    loop item in items {
        if item == {
            .Struct(definition) -> {
                owner :: scoped_name(prefix, definition.name)
                loop method in definition.methods -> record_state_marker_references_for_method(ledger, module_idx, source_module, owner, method)
                loop implementation in definition.trait_impls { loop method in implementation.methods -> record_state_marker_references_for_method(ledger, module_idx, source_module, owner, method) }
            }
            .Impl(implementation) -> {
                owner :: scoped_name(prefix, implementation.type_name)
                loop method in implementation.methods -> record_state_marker_references_for_method(ledger, module_idx, source_module, owner, method)
            }
            .Enum(definition) -> {
                owner :: scoped_name(prefix, definition.name)
                loop method in definition.methods -> record_state_marker_references_for_method(ledger, module_idx, source_module, owner, method)
            }
            .CodeModule(module) -> {
                module_name :: scoped_name(prefix, module.name)
                if module.body == .Val(body) -> record_state_marker_references_in_items(ledger, module_idx, source_module, body, .Val(module_name))
            }
            else -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1753
fn record_state_marker_references(bundle: ProgramBundle, ledger: &NameLedger) {
    loop module_idx in 0..<bundle.modules.len() {
        module :: bundle.modules[module_idx]
        record_state_marker_references_in_items(ledger, module_idx, module.display, module.items, None)
    }
}
