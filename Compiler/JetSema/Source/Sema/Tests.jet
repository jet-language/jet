use jet_foundation.[
    Diagnostic,
    FnBody,
    Func,
    InternerDelta,
    Item,
    TFuncKind,
    TestDef,
    Type,
    ast_func,
    checked_test_artifact_key,
    type_name,
]

// Why the property-test runner can't synthesize values of `ty`, written in
// the module row `module_index`, or None when it can: the scalar value types,
// `[T]`, `T?` and fixed lists of a generatable element, and a struct with no
// type parameters and no `validate` block whose stored fields all are.
// `seen` are the structs being generated around this one; each call leaves
// it as it found it.
sema_property_param_ungeneratable: fn(graph: SemaRegistrationGraph, module_index: Int, ty: Type, seen: ^[Int]) -> String? Never! {
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .Float32 | .IntN(_, _) | .InlineRange(_, _, _) -> None
        .List(inner) -> sema_property_param_ungeneratable(graph, module_index, inner, seen)
        .Option(inner) -> sema_property_param_ungeneratable(graph, module_index, inner, seen)
        .FixedList(elem, _) -> sema_property_param_ungeneratable(graph, module_index, elem, seen)
        .Named(name) -> sema_property_struct_ungeneratable(graph, module_index, ty, name, seen)
        .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> Val("`{type_name(ty)}` has no generator")
    }
}

// sema_property_param_ungeneratable for the type `ty` that names `name`.
sema_property_struct_ungeneratable: fn(graph: SemaRegistrationGraph, module_index: Int, ty: Type, name: String, seen: ^[Int]) -> String? Never! {
    row: sema_type_resolve_nominal_row_at(graph, ty, module_index) ?? return Val("`{name}` has no generator")
    key: (row.module_index << 32) | row.row
    if seen.contains(key) -> return Val("`{name}` holds itself")
    if graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
        if item == .Struct(definition) {
            if definition.type_params.len() > 0 -> return Val("`{name}` has type parameters")
            if definition.validate_span != None -> return Val("`{name}` validates its values")
            seen.push(key)
            loop field in definition.fields {
                if field.computed != None -> next
                reason: sema_property_param_ungeneratable(graph, row.module_index, field.ty, seen) ?? next
                _ := seen.pop()
                return Val("`{name}.{field.name}`: {reason}")
            }
            _ := seen.pop()
            return None
        }
    }
    Val("`{name}` is not a struct")
}

// E0613: one row per parameter of a parameterized `#Test fn` in the module row
// `module_index` whose type has no automatic generator, reported before the
// test body's own diagnostics.
sema_property_param_diagnostics: fn(graph: SemaRegistrationGraph, module_index: Int, test: TestDef) -> [Diagnostic] Never! {
    diagnostics := [Diagnostic]{}
    loop parameter in test.params {
        seen := [Int]{}
        reason: sema_property_param_ungeneratable(graph, module_index, parameter.ty, seen) ?? next
        diagnostics.push(
            sema_error(
                "E0613",
                parameter.ty_span,
                "a property test can't generate values of type `{type_name(parameter.ty)}`",
                "a parameterized `#Test fn` is a property test: Jet generates inputs from each parameter's type, and {reason}",
                "use a generatable type (Int, Float, Bool, String, Char, a sized integer, a list/optional of those, or a struct of them), or write a plain `#Test \"name\" {{ … }}` block and construct the value yourself",
            ),
        )
    }
    diagnostics
}

SemaTestFunctionCheckResult: struct {
    function: FnBody?,
    call_facts: [SemaCallSiteFact],
    comptime_requests: [SemaComptimeRequest],
    name_references: [SemaNameReferenceFact],
    diagnostics: [Diagnostic],
    exact_int_reachable: Bool,
    copy_events: [SemaCopyEvent],
    complete: Bool,
    // Body comptime sites awaiting their values (SemaFunctionResult rows).
    comptime_body_sources: [SemaComptimeBodySource],
    // Why an incomplete result has no diagnostic.
    incomplete_reasons: [String],
    // The answers of the debugger's probes inside the test (EvalProbe.jet).
    eval_answers: [SemaEvalProbeAnswer]{[SemaEvalProbeAnswer]{}},
    type_delta: [InternerDelta]{[InternerDelta]{}},
}

// A test that could not be checked, with no diagnostic of its own.
sema_test_function_incomplete: fn(reason: String) -> SemaTestFunctionCheckResult {
    SemaTestFunctionCheckResult{
        function: None,
        call_facts: [SemaCallSiteFact]{},
        comptime_requests: [SemaComptimeRequest]{},
        name_references: [SemaNameReferenceFact]{},
        diagnostics: [Diagnostic]{},
        exact_int_reachable: false,
        copy_events: [SemaCopyEvent]{},
        complete: false,
        comptime_body_sources: [SemaComptimeBodySource]{},
        incomplete_reasons: [String]{reason},
    }
}

sema_check_test_function: fn(test: TestDef, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: SemaScopeTable, host_hooks: SemaHostHookAccess?) -> SemaTestFunctionCheckResult {
    module_name: sema_scope_environment_module_text(environment, program)
    key := checked_test_artifact_key(module_name, test)
    // Registration minted the id (sema_registration_mint_tests).
    owner_id: sema_symbol_find(program, key) ?? return sema_test_function_incomplete("its test `{key}` has no registered id")
    scopes := sema_scope_snapshot(module_scopes)
    // Names the synthetic body `__test_<name>`. A runtime stop inside the test
    // names it `test "<name>"` (JetIR ir_build_tests).
    temporary_name := "{sema_test_synthetic_prefix()}{test.name ?? "anonymous"}"
    synthetic := ast_func(temporary_name, test.name_span, test.span)
    synthetic.params = test.params
    synthetic.pre = test.pre
    synthetic.body = test.body
    synthetic.compiler_generated = true
    registered := false
    loop !registered {
        synthetic.name = temporary_name.copy()
        symbol := sema_item_symbol(Item.Func{value: synthetic}, environment.module_identity, module_name, environment.source_file, environment.source_origin, environment.source_segments) ?? return sema_test_function_incomplete("its synthetic function symbol could not be formed")
        symbol.id = owner_id
        symbol.ty = Val(sema_function_symbol_type(synthetic, false, key, environment.source_file, environment.source_origin, environment.source_segments))
        registered = sema_scope_add_module_symbol(scopes, symbol, key)
        if !registered -> temporary_name = "{temporary_name}_"
    }
    call_facts := [SemaCallSiteFact]{}
    comptime_requests := [SemaComptimeRequest]{}
    name_references := [SemaNameReferenceFact]{}
    diagnostics := [Diagnostic]{}
    // The synthetic has no own generic parameters: its merged environment is
    // unchanged. The canonical read checker scopes and restores its name.
    checked := sema_function_check_shared(synthetic, key, TFuncKind.TopLevel, false, environment, program, scopes, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    function := FnBody?{None}
    if checked.value == .Val(value) {
        updated_value := value
        updated_value.name = key
        updated_value.module_name = environment.module_name
        updated_value.module_identity = environment.module_identity
        updated_value.key = key
        updated_value.source_span = test.span
        updated_value.synthetic = true
        function = Val(updated_value)
    }
    SemaTestFunctionCheckResult{
        function: function,
        call_facts: call_facts,
        comptime_requests: comptime_requests,
        name_references: name_references,
        diagnostics: diagnostics,
        exact_int_reachable: checked.exact_int_reachable,
        copy_events: checked.copy_events,
        complete: checked.complete,
        comptime_body_sources: checked.comptime_body_sources,
        incomplete_reasons: checked.incomplete_reasons.move(),
        eval_answers: checked.eval_answers.move(),
        type_delta: scopes.type_delta.move(),
    }
}

sema_test_synthetic_prefix: fn() -> String Never! { "__test_" }

// The synthetic function of a `#Test` block. It is marked compiler-generated,
// but its body is the user's test code.
sema_test_synthetic_function: fn(func: Func) -> Bool Never! {
    func.compiler_generated && func.name.starts_with(sema_test_synthetic_prefix())
}
