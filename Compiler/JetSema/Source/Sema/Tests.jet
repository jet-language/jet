use jet_foundation.[
    Diagnostic,
    FnBody,
    Func,
    Item,
    TFuncKind,
    TestDef,
    Type,
    ast_func,
    checked_test_artifact_key,
    type_name,
]

// The parameter types the property-test runner can synthesize inputs for: the
// scalar value types plus `[T]`, `T?` and fixed lists of a generatable element.
sema_property_param_generatable: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .Float32 | .IntN(_, _) | .InlineRange(_, _, _) -> true
        .List(inner) -> sema_property_param_generatable(inner)
        .Option(inner) -> sema_property_param_generatable(inner)
        .FixedList(elem, _) -> sema_property_param_generatable(elem)
        .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// E0613 (Rust `property_param_unsupported`): one row per parameter of a
// parameterized `#Test fn` whose type has no automatic generator, reported
// before the test body's own diagnostics.
sema_property_param_diagnostics: fn(test: TestDef) -> [Diagnostic] Never! {
    diagnostics := [Diagnostic]{}
    loop parameter in test.params {
        if sema_property_param_generatable(parameter.ty) -> next
        diagnostics.push(sema_error(
            "E0613",
            parameter.ty_span,
            "a property test can't generate values of type `{type_name(parameter.ty)}`",
            "a parameterized `#Test fn` is a property test: Jet generates inputs from each parameter's type, but this type has no built-in generator",
            "use a generatable type (Int, Float, Bool, String, Char, a sized integer, or a list/optional of those), or write a plain `#Test \"name\" {{ … }}` block and construct the value yourself",
        ))
    }
    diagnostics
}

SemaTestFunctionCheckResult: struct {
    function: FnBody?
    call_facts: [SemaCallSiteFact]
    comptime_requests: [SemaComptimeRequest]
    name_references: [SemaNameReferenceFact]
    diagnostics: [Diagnostic]
    exact_int_reachable: Bool
    copy_events: [SemaCopyEvent]
    complete: Bool
    // Body comptime sites awaiting their values (SemaFunctionResult rows).
    comptime_body_sources: [SemaComptimeBodySource]
    // Why an incomplete result has no diagnostic.
    incomplete_reasons: [String]
}

sema_check_test_function: fn(test: TestDef, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: SemaScopeTable, host_hooks: SemaHostHookAccess?) -> SemaTestFunctionCheckResult {
    module_name: sema_scope_environment_module_text(environment, program)
    key := checked_test_artifact_key(module_name, test)
    // Registration minted the id (sema_registration_mint_tests).
    owner_id: sema_symbol_find(program, key) ?? panic("test `{key}` has no registered id")
    scopes := sema_scope_snapshot(module_scopes)
    // Names the synthetic body `__test_<name>`. A runtime stop inside the test
    // names it `test "<name>"` (JetIR ir_build_tests).
    temporary_name := "{sema_test_synthetic_prefix()}{test.name ?? "anonymous"}"
    synthetic := ast_func(temporary_name, test.name_span, test.span)
    synthetic.params = test.params
    synthetic.pre = test.pre
    synthetic.body = test.body
    synthetic.compiler_generated = true
    registered := false
    loop !registered {
        synthetic.name = temporary_name
        symbol := sema_item_symbol(Item.Func{value: synthetic}, environment.module_identity, module_name, environment.source_file, environment.source_origin, environment.source_segments) ?? {
            return SemaTestFunctionCheckResult{
                function: None,
                call_facts: [SemaCallSiteFact]{},
                comptime_requests: [SemaComptimeRequest]{},
                name_references: [SemaNameReferenceFact]{},
                diagnostics: [Diagnostic]{},
                exact_int_reachable: false,
                copy_events: [SemaCopyEvent]{},
                complete: false,
                comptime_body_sources: [SemaComptimeBodySource]{},
                incomplete_reasons: [String]{"its synthetic function symbol could not be formed"},
            }
        }
        symbol.id = owner_id
        symbol.ty = Val(sema_function_symbol_type(synthetic, false, key, environment.source_file, environment.source_origin, environment.source_segments))
        registered = sema_scope_add_module_symbol(scopes, symbol, key)
        if !registered -> temporary_name = "{temporary_name}_"
    }
    call_facts := [SemaCallSiteFact]{}
    comptime_requests := [SemaComptimeRequest]{}
    name_references := [SemaNameReferenceFact]{}
    diagnostics := [Diagnostic]{}
    // The synthetic has no own generic parameters: its merged environment is
    // unchanged. The canonical read checker scopes and restores its name.
    checked := sema_function_check_shared(synthetic, key, TFuncKind.TopLevel, false, environment, program, scopes, host_hooks, diagnostics, call_facts, comptime_requests, name_references)
    function := FnBody?{None}
    if checked.value == .Val(value) {
        updated_value := value
        updated_value.name = key
        updated_value.module_name = environment.module_name
        updated_value.module_identity = environment.module_identity
        updated_value.key = key
        updated_value.source_span = test.span
        updated_value.synthetic = true
        function = Val(updated_value)
    }
    SemaTestFunctionCheckResult{
        function: function,
        call_facts: call_facts,
        comptime_requests: comptime_requests,
        name_references: name_references,
        diagnostics: diagnostics,
        exact_int_reachable: checked.exact_int_reachable,
        copy_events: checked.copy_events.copy(),
        complete: checked.complete,
        comptime_body_sources: checked.comptime_body_sources.copy(),
        incomplete_reasons: checked.incomplete_reasons.copy(),
    }
}

sema_test_synthetic_prefix: fn() -> String Never! { "__test_" }

// The synthetic function of a `#Test` block. It is marked compiler-generated,
// but its body is the user's test code.
sema_test_synthetic_function: fn(func: Func) -> Bool Never! {
    func.compiler_generated && func.name.starts_with(sema_test_synthetic_prefix())
}
