use core.files.runtime.kernel_path_components as sema_fixture_path
use jet_foundation.[
    BuildFactSnapshot,
    LoadedModule,
    MIRTargetMachine,
    MIROSTarget,
    ProgramBundle,
    Diagnostic,
    Item,
    SymbolID,
    TFunc,
    TFuncKind,
    TestDef,
    ast_func,
    tir_test_artifact_key,
]

pub struct SemaTestFunctionCheckResult {
    pub function: TFunc?
    pub call_facts: [SemaCallSiteFact]
    pub comptime_requests: [SemaComptimeRequest]
    pub name_references: [SemaNameReferenceFact]
    pub diagnostics: [Diagnostic]
    pub exact_int_reachable: Bool
    pub copy_events: [SemaCopyEvent]
    pub complete: Bool
}

pub fn sema_check_test_function(test: TestDef, environment: SemaScopeEnvironment, module_scopes: SemaScopeTable) -> SemaTestFunctionCheckResult {
    key := tir_test_artifact_key(environment.module_identity, test)
    owner_id := SymbolID{key: key}
    scopes := sema_scope_snapshot(module_scopes)
    temporary_name := "__jet_test_{test.span.start}_{test.span.end}"
    synthetic := ast_func(temporary_name, test.name_span, test.span)
    synthetic.params = test.params
    synthetic.body = test.body
    synthetic.compiler_generated = true
    registered := false
    loop !registered {
        synthetic.name = temporary_name
        symbol := sema_item_symbol(Item.Func{value: synthetic}, environment.module_identity, environment.source_file, environment.source_origin, environment.source_segments) ?? {
            return SemaTestFunctionCheckResult{
                function: None,
                call_facts: [SemaCallSiteFact]{},
                comptime_requests: [SemaComptimeRequest]{},
                name_references: [SemaNameReferenceFact]{},
                diagnostics: [Diagnostic]{},
                exact_int_reachable: false,
                copy_events: [SemaCopyEvent]{},
                complete: false,
            }
        }
        symbol.id = owner_id
        symbol.ty = Val(sema_function_symbol_type(synthetic, false, owner_id, environment.source_file, environment.source_origin, environment.source_segments))
        registered = sema_scope_add_module_symbol(&scopes, symbol)
        if !registered -> temporary_name = "{temporary_name}_"
    }
    call_facts := [SemaCallSiteFact]{}
    comptime_requests := [SemaComptimeRequest]{}
    name_references := [SemaNameReferenceFact]{}
    diagnostics := [Diagnostic]{}
    check_environment := environment
    checked := sema_function_check(&synthetic, owner_id, TFuncKind.TopLevel, false, &check_environment, &scopes, &diagnostics, &call_facts, &comptime_requests, &name_references, sema_function_body_input(synthetic, TFuncKind.TopLevel, false, check_environment))
    function := TFunc?{None}
    if checked.value == .Val(value) {
        updated_value := value
        updated_value.name = key
        updated_value.module_name = environment.module_name
        updated_value.module_identity = environment.module_identity
        updated_value.key = key
        updated_value.source_span = test.span
        updated_value.synthetic = true
        function = Val(updated_value)
    }
    SemaTestFunctionCheckResult{
        function: function,
        call_facts: call_facts,
        comptime_requests: comptime_requests,
        name_references: name_references,
        diagnostics: diagnostics,
        exact_int_reachable: checked.exact_int_reachable,
        copy_events: ~checked.copy_events,
        complete: checked.complete,
    }
}

// Explicit test fixture boundary. It constructs an owner from genuine parsed
// input Programs; production registration never invents native host/path facts.
pub fn sema_test_prepare_graph(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], package_identity: String, entry_module_identity: String, canonical_effect_module_identity: String, foreign_providers: [SemaForeignProviderInput], target_machine: MIRTargetMachine, build_facts: SemaBuildFacts, host_hooks: Shared<SemaRegistrationHostHooks>) -> SemaRegistrationGraph {
    os :: if build_facts.os == { "linux" -> MIROSTarget.Linux; "macos" -> MIROSTarget.MacOS; "windows" -> MIROSTarget.Windows; else -> panic("test fixture must declare its simulated host OS") }
    platform :: if os == MIROSTarget.Windows -> sema_fixture_path.PathPlatform.Windows else -> sema_fixture_path.PathPlatform.Unix
    fixture := ProgramBundle.new(sema_fixture_path.from_text(".", platform), os, build_facts.snapshot ?? BuildFactSnapshot.for_host(os, target_machine.triple), "2028")
    prepared := inputs
    loop index in 0..<prepared.len() {
        if prepared[index].module_identity == canonical_effect_module_identity -> next
        prepared[index].bundle_index = Val(fixture.modules.len())
        if prepared[index].module_identity == entry_module_identity -> fixture.entry = fixture.modules.len()
        program := prepared[index].program
        &fixture.modules.push(LoadedModule.from_program(sema_fixture_path.from_text(prepared[index].source_file, platform), prepared[index].source_file, prepared[index].unit_source, prepared[index].module_name, ^program))
    }
    owner :: shared ^fixture
    loop index in 0..<prepared.len() {
        if prepared[index].module_identity != canonical_effect_module_identity -> prepared[index].bundle_owner = Val(owner)
    }
    sema_registration_prepare_graph(prepared, edges, package_identity, entry_module_identity, canonical_effect_module_identity, foreign_providers, target_machine, build_facts, host_hooks)
}
