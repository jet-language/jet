use jet_foundation.[
    Diagnostic,
    Item,
    SymbolID,
    TFunc,
    TFuncKind,
    TestDef,
    Type,
    ast_func,
    tir_test_artifact_key,
    type_name,
]

// (Rust BodyCheck.rs `property_param_generatable`): the parameter
// types the property-test runner can synthesize inputs for: the scalar value
// types plus `[T]`, `T?` and fixed lists of a generatable element.
fn sema_property_param_generatable(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .Float32 | .IntN(_, _) | .InlineRange(_, _, _) -> true
        .List(inner) -> sema_property_param_generatable(inner)
        .Option(inner) -> sema_property_param_generatable(inner)
        .FixedList(elem, _) -> sema_property_param_generatable(elem)
        else -> false
    }
}

// E0613 (Rust `property_param_unsupported`): one row per parameter of a
// parameterized `#Test fn` whose type has no automatic generator, reported
// before the test body's own diagnostics.
fn sema_property_param_diagnostics(test: TestDef) -> [Diagnostic] Never! {
    diagnostics := [Diagnostic]{}
    loop parameter in test.params {
        if sema_property_param_generatable(parameter.ty) -> next
        &diagnostics.push(sema_error(
            "E0613",
            parameter.ty_span,
            "a property test can't generate values of type `{type_name(parameter.ty)}`",
            "a parameterized `#Test fn` is a property test: Jet generates inputs from each parameter's type, but this type has no built-in generator",
            "use a generatable type (Int, Float, Bool, String, Char, a sized integer, or a list/optional of those), or write a plain `#Test \"name\" {{ … }}` block and construct the value yourself",
        ))
    }
    diagnostics
}

struct SemaTestFunctionCheckResult {
    function: TFunc?
    call_facts: [SemaCallSiteFact]
    comptime_requests: [SemaComptimeRequest]
    name_references: [SemaNameReferenceFact]
    diagnostics: [Diagnostic]
    exact_int_reachable: Bool
    copy_events: [SemaCopyEvent]
    complete: Bool
}

fn sema_check_test_function(test: TestDef, environment: SemaScopeEnvironment, program: SemaProgramTables, module_scopes: SemaScopeTable, host_hooks: SemaHostHookAccess?) -> SemaTestFunctionCheckResult {
    key := tir_test_artifact_key(environment.module_identity, test)
    owner_id := SymbolID{key: key}
    scopes := sema_scope_snapshot(module_scopes)
    // Rust Validation.rs names the synthetic body `__test_<name>`; a runtime
    // stop inside the test reports that name (`in __test_<name>`).
    temporary_name := "__test_{test.name ?? "anonymous"}"
    synthetic := ast_func(temporary_name, test.name_span, test.span)
    synthetic.params = test.params
    synthetic.body = test.body
    synthetic.compiler_generated = true
    registered := false
    loop !registered {
        synthetic.name = temporary_name
        symbol := sema_item_symbol(Item.Func{value: synthetic}, environment.module_identity, environment.source_file, environment.source_origin, environment.source_segments) ?? {
            return SemaTestFunctionCheckResult{
                function: None,
                call_facts: [SemaCallSiteFact]{},
                comptime_requests: [SemaComptimeRequest]{},
                name_references: [SemaNameReferenceFact]{},
                diagnostics: [Diagnostic]{},
                exact_int_reachable: false,
                copy_events: [SemaCopyEvent]{},
                complete: false,
            }
        }
        symbol.id = owner_id
        symbol.ty = Val(sema_function_symbol_type(synthetic, false, owner_id, environment.source_file, environment.source_origin, environment.source_segments))
        registered = sema_scope_add_module_symbol(&scopes, symbol)
        if !registered -> temporary_name = "{temporary_name}_"
    }
    call_facts := [SemaCallSiteFact]{}
    comptime_requests := [SemaComptimeRequest]{}
    name_references := [SemaNameReferenceFact]{}
    diagnostics := [Diagnostic]{}
    // The synthetic has no own generic parameters: its merged environment is
    // unchanged. The canonical read checker scopes and restores its name.
    checked := sema_function_check_shared(synthetic, owner_id, TFuncKind.TopLevel, false, environment, program, &scopes, host_hooks, &diagnostics, &call_facts, &comptime_requests, &name_references)
    function := TFunc?{None}
    if checked.value == .Val(value) {
        updated_value := value
        updated_value.name = key
        updated_value.module_name = environment.module_name
        updated_value.module_identity = environment.module_identity
        updated_value.key = key
        updated_value.source_span = test.span
        updated_value.synthetic = true
        function = Val(updated_value)
    }
    SemaTestFunctionCheckResult{
        function: function,
        call_facts: call_facts,
        comptime_requests: comptime_requests,
        name_references: name_references,
        diagnostics: diagnostics,
        exact_int_reachable: checked.exact_int_reachable,
        copy_events: checked.copy_events.copy(),
        complete: checked.complete,
    }
}
