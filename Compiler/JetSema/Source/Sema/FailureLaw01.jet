use jet_foundation.[Diagnostic, Span, Expr, Type, StrPart]

// Rust: crates/jet-sema/src/Sema/CheckerCore/helpers.rs:8
// D-UNINIT1: plain data cannot expose owned or freed state when uninitialized.
pub fn is_pod_uninit_type(ty: Type) -> Bool Never! {
    if ty == {
        .Int, .Float, .Bool, .Char, .IntN, .InlineRange, .Float32 -> true
        .FixedList(elem, _) -> is_pod_uninit_type(elem)
        else -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/helpers.rs:22
// D-LAYOUT1: fingerprint only the shapes used by layout constraint lines.
fn layout_constraint_fingerprint(e: Expr) -> String Never! {
    if e == {
        .Binary(op, l, r, _) -> "(" + layout_constraint_fingerprint(l) + " " + op.debug() + " " + layout_constraint_fingerprint(r) + ")"
        .MethodCall(receiver, method, _, args, _) -> {
            recv :: layout_constraint_fingerprint(receiver)
            arguments := [String]{}
            loop arg in args { arguments.push(layout_constraint_fingerprint(arg.expr)) }
            recv + "." + method + "(" + arguments.join(",") + ")"
        }
        .Ident(n, _) -> ~n
        .Str(parts, _) -> {
            if parts.len() == 1 && parts[0] == .Lit(s) -> return s.debug()
            "<str>"
        }
        .Float(f, _, _, _) -> f.to_string()
        .Int(i, _, _, _) -> i.to_string()
        else -> "<?>"
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/helpers.rs:54
fn no_any_type(span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0350", "Jet does not have an `Any` type", "a value should keep a precise shape: use an enum for known variants, generics or traits for abstraction, `T?` for absence, and `DataTree` for parsed dynamic data", "replace `Any` with the specific mechanism for this value", Val(span))
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/helpers.rs:67
// D9: a signature names every type; `_` is only a pattern wildcard.
fn type_hole_diag(span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0119", "`_` isn't a type", "a signature names every type; `_` is only a pattern wildcard", "write the type out; in a `T _!` return, name the error domain the body fails with, such as `Int ParseError!`", Val(span))
}
