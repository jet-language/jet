// Rust: crates/jet-sema/src/Sema/CheckerFieldPolicy.rs:1
// Computed fields recompute unless explicitly #Memo. Before registration:
// diagnose raw dependency cycles, rewrite sibling reads onto self, and generate
// ordinary methods. Lambda scopes are deliberately not traversed.
use jet_sema.Sema.[expr_refs_name]
use jet_sema.Diagnostics.[Diagnostic, Span]
use jet_sema.Syntax as Syntax
use jet_sema.AST.[AccessConvention, EnumLitArg, Expr, Field, Func, Item, OrFallback, Param, ParamZone, Pattern, Stmt, StrPart, StructDef, StructPatField, Type]
use std.collections.[HashSet]

// Rust: crates/jet-sema/src/Sema/CheckerFieldPolicy.rs:39
pub fn process_computed_fields(items: &[Item], diags: &[Diagnostic]) Never! {
    loop &item in items {
        if item == .Struct(structure) {
            has_computed := false
            loop field in structure.fields {
                has_computed = has_computed || field.computed.is_some()
                loop marker in field.serde_markers {
                    if marker.name != Syntax.MARKER_MEMO -> continue
                    if field.computed.is_none() || !marker.args.is_empty() { diags.push(e0382_invalid_memo_field(field.name, marker.span)) }
                    break
                }
            }
            if !has_computed -> continue
            cyclic :: check_computed_field_cycles(structure, diags)
            rewrite_computed_field_bodies(&structure)
            loop field in structure.fields {
                if field.computed.is_none() -> continue
                // Cyclic fields still get getters: the diagnostic aborts before codegen.
                _ :: cyclic
                structure.methods.push(synthesize_computed_field_getter(field))
            }
        }
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerFieldPolicy.rs:72
fn check_computed_field_cycles(structure: StructDef, diags: &[Diagnostic]) -> Bool Never! {
    computed := [Field]{}
    loop field in structure.fields { if field.computed.is_some() { computed.push(field) } }
    if computed.is_empty() -> return false
    names := [String]{}
    loop field in computed { names.push(field.name) }
    deps := [String:[String]]{}
    loop field in computed {
        expr :: field.computed.expect("filtered to computed fields")
        dependencies := [String]{}
        loop other in names { if expr_refs_name(expr, other) { dependencies.push(other) } }
        deps[field.name] = ^dependencies
    }
    // Rust: crates/jet-sema/src/Sema/CheckerFieldPolicy.rs:93
    enum Color { White Gray Black }
    color := [String:Color]{}
    reported := HashSet[String].new()
    span_of := [String:Span]{}
    loop name in names { color[name] = .White }
    loop field in computed { span_of[field.name] = field.name_span }
    // Rust: crates/jet-sema/src/Sema/CheckerFieldPolicy.rs:105
    fn dfs(node: String, deps: [String:[String]], color: &[String:Color], span_of: [String:Span], struct_name: String, reported: &HashSet[String], diags: &[Diagnostic]) Never! {
        color[node] = .Gray
        if deps.get(node) == .Val(neighbors) {
            loop neighbor in neighbors {
                if color.get(neighbor) == {
                    .Val(.Gray) -> {
                        if reported.insert(node) { diags.push(e0338_computed_field_cycle(struct_name, node, neighbor, span_of[node])) }
                    }
                    .Val(.White) -> dfs(neighbor, deps, color, span_of, struct_name, reported, diags)
                    _ -> {}
                }
            }
        }
        color[node] = .Black
    }
    loop name in names { if color[name] == .White { dfs(name, deps, &color, span_of, structure.name, &reported, diags) } }
    !reported.is_empty()
}
// Rust: crates/jet-sema/src/Sema/CheckerFieldPolicy.rs:154
fn e0338_computed_field_cycle(struct_name: String, field: String, via: String, span: Span) -> Diagnostic Never! {
    what :: if field == via -> "computed field `{struct_name}.{field}` references itself" else -> "computed field `{struct_name}.{field}` forms a cycle through `{via}`"
    Diagnostic.error("E0338", what,
        "a computed field's formula may only reference OTHER fields — the dependency graph among computed fields must have no cycle",
        "break the cycle: make `{field}` or `{via}` a plain stored field, or rework the formula", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerFieldPolicy.rs:178
fn e0382_invalid_memo_field(field: String, span: Span) -> Diagnostic Never! {
    Diagnostic.from_row("E0382", [(String, String)]{("field", field)}, Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerFieldPolicy.rs:185
fn rewrite_computed_field_bodies(structure: &StructDef) Never! {
    names := HashSet[String].new()
    loop field in structure.fields { _ :: names.insert(field.name.clone()) }
    loop &field in structure.fields { if field.computed == .Val(expr) { rewrite_field_refs(&expr, names, Syntax.KW_SELF) } }
}
// Rust: crates/jet-sema/src/Sema/CheckerFieldPolicy.rs:194
fn self_field(receiver: String, name: String, span: Span) -> Expr Never! {
    Expr.Field{base: Expr.Ident{name: receiver.to_string(), span: span}, member: name.to_string(), span: span}
}
// Rust: crates/jet-sema/src/Sema/CheckerFieldPolicy.rs:207
pub fn rewrite_field_refs(expr: &Expr, names: HashSet[String], receiver: String) Never! {
    if expr == {
        .Ident(name, span) -> { if names.contains(name) { expr = self_field(receiver, name, span) } }
        .PtrFromAddr(_, addr, ..) -> rewrite_field_refs(&addr, names, receiver)
        .Unary(_, inner, _) | .Deref(inner, _) | .RawOf(inner, _) | .Copy(inner, _) | .Place(inner, _, _) -> rewrite_field_refs(&inner, names, receiver)
        .Binary(_, left, right, _) -> { rewrite_field_refs(&left, names, receiver); rewrite_field_refs(&right, names, receiver) }
        .CompareChain(operands, ..) -> { loop &operand in operands { rewrite_field_refs(&operand, names, receiver) } }
        .Call(call) -> { loop &arg in call.args { rewrite_field_refs(&arg.expr, names, receiver) } }
        .CallValue(callee, args, ..) -> {
            rewrite_field_refs(&callee, names, receiver)
            loop &arg in args { rewrite_field_refs(&arg.expr, names, receiver) }
        }
        .Field(inner, _, _) | .Tainted(inner, _, _) | .Present(inner, _) -> rewrite_field_refs(&inner, names, receiver)
        .Try(inner, _, _, note) -> {
            rewrite_field_refs(&inner, names, receiver)
            if note == .Val(value) { rewrite_field_refs(&value, names, receiver) }
        }
        .MemberSpread(base, ..) | .OptField(base, ..) -> rewrite_field_refs(&base, names, receiver)
        .MethodCall(recv, _, _, _, _, args, ..) -> {
            rewrite_field_refs(&recv, names, receiver)
            loop &arg in args { rewrite_field_refs(&arg.expr, names, receiver) }
        }
        .Index(base, index, ..) -> { rewrite_field_refs(&base, names, receiver); rewrite_field_refs(&index, names, receiver) }
        .Slice(base, start, end, range, ..) -> {
            rewrite_field_refs(&base, names, receiver)
            if range == .Val(value) { rewrite_field_refs(&value, names, receiver) }
            else { rewrite_field_refs(&start, names, receiver); rewrite_field_refs(&end, names, receiver) }
        }
        .Range(start, end, ..) -> { rewrite_field_refs(&start, names, receiver); rewrite_field_refs(&end, names, receiver) }
        .ListLit(elems, _) -> { loop &value in elems { rewrite_field_refs(&value, names, receiver) } }
        .TupleLit(fields, _, _) -> { loop &(_, value) in fields { rewrite_field_refs(&value, names, receiver) } }
        .MapLit(entries, _) -> {
            loop &(key, value) in entries { rewrite_field_refs(&key, names, receiver); rewrite_field_refs(&value, names, receiver) }
        }
        .StructLit(_, _, _, _, fields, ..) -> { loop &(_, _, value) in fields { rewrite_field_refs(&value, names, receiver) } }
        .TypedLit(_, _, body, ..) -> { body.for_each_expr_mut(fn(value: &Expr) Never! { rewrite_field_refs(value, names, receiver) }) }
        .EnumLit(_, _, _, args, ..) -> {
            loop &arg in args {
                if arg == { .Positional(value) -> rewrite_field_refs(&value, names, receiver) .Named(_, _, value) -> rewrite_field_refs(&value, names, receiver) }
            }
        }
        .Ok(inner, _) | .Err(inner, _) -> rewrite_field_refs(&inner, names, receiver)
        .OrFallback(value, fallback, ..) -> {
            rewrite_field_refs(&value, names, receiver)
            if fallback == {
                .Value(value) -> rewrite_field_refs(&value, names, receiver)
                .Block(body, value, ..) -> {
                    loop &statement in body { statement.for_each_expr_mut(fn(inner: &Expr) Never! { rewrite_field_refs(inner, names, receiver) }) }
                    if value == .Val(inner) { rewrite_field_refs(&inner, names, receiver) }
                }
                .Return(.Val(value), _) -> rewrite_field_refs(&value, names, receiver)
                _ -> {}
            }
        }
        .PatternTest(subject, pattern, ..) -> {
            rewrite_field_refs(&subject, names, receiver)
            if pattern == .Struct(_, fields, ..) {
                loop &field in fields { if field == .Value(_, value, ..) { rewrite_field_refs(&value, names, receiver) } }
            }
        }
        .Str(parts, _) -> {
            loop &part in parts { if part == .Interp(value, _) { rewrite_field_refs(&value, names, receiver) } }
        }
        .If(cond, then_body, then_value, else_body, else_value, ..) -> {
            rewrite_field_refs(&cond, names, receiver)
            loop &statement in then_body { statement.for_each_expr_mut(fn(inner: &Expr) Never! { rewrite_field_refs(inner, names, receiver) }) }
            rewrite_field_refs(&then_value, names, receiver)
            loop &statement in else_body { statement.for_each_expr_mut(fn(inner: &Expr) Never! { rewrite_field_refs(inner, names, receiver) }) }
            rewrite_field_refs(&else_value, names, receiver)
        }
        .Paren(inner, _) | .Spread(inner, _) -> rewrite_field_refs(&inner, names, receiver)
        // Leaves and lambdas: lambda captures use their ordinary lexical scope.
        _ -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerFieldPolicy.rs:389
fn synthesize_computed_field_getter(field: Field) -> Func Never! {
    span :: field.name_span
    body_expr :: field.computed.expect("computed field").clone()
    self_param :: Param{
        convention: AccessConvention.Read, root: false, name: Syntax.KW_SELF.to_string(), name_span: span,
        ty: Type.Named{name: ""}, ty_span: span, default: None, variadic: false, variadic_bound_list: None,
        declared_view_from_names: None, public_label: None, zone: ParamZone.Either
    }
    Func{
        span: span, is_pub: field.is_pub, is_comptime: false, is_package_pub: field.is_package_pub, external_type: None,
        name: field.name.clone(), name_span: span, meta: None, type_params: [], head_pattern: None, params: [Param]{self_param},
        return_type: Val(field.ty.clone()), return_type_span: Val(field.ty_span), return_view_provenance: None,
        declared_return_view_provenance: None, gc_return: false, diverges: false, gc_scope: false, is_unsafe: false,
        unsafe_reason: None, unsafe_span: None, is_pure: false, is_reactive: false, reactive_upgrades: [], is_replayable: false,
        replayable_span: None, is_job: false, job_span: None, every: None, job_metadata: None, is_must_use: false,
        must_use_span: None, maturity: None, maturity_span: None, kernel: None, is_inline: false, is_inline_always: false,
        inline_span: None, is_sanitizer: false, scrub_tag: None, declared_effects: None, effect_via: None, state_requires: None,
        state_transition: None, web_marker: None, pre: [], post: [], inline_foreign: None, undo: None,
        // #Memo belongs to the field/codegen table, not the internal getter.
        markers: [], compiler_generated: false, body: [Stmt]{Stmt.Return{value: Val(body_expr), span: span}}
    }
}
