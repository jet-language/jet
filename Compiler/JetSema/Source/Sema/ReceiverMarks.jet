// D-CAP-RECEIVER1=D: receiver marks do not change resolution or evaluation.
use jet_foundation.[Diagnostic, Span, TextEdit, Syntax, AccessConvention, Expr, PlaceAccess, Type]
use jet_sema.[Checker, type_is_copy]

// Rust: crates/jet-sema/src/Sema/ReceiverMarks.rs:23
pub struct ReceiverMark { access: PlaceAccess; mark_span: Span }
// Rust: crates/jet-sema/src/Sema/ReceiverMarks.rs:31
pub struct ReceiverMarkFrame { receiver: (Int, Int); convention: AccessConvention? }
// Rust: crates/jet-sema/src/Sema/ReceiverMarks.rs:36
fn convention_rank(convention: AccessConvention) -> U8 Never! {
    if convention == { .Read -> 0; .Write -> 1; .Move -> 2 }
}
// Rust: crates/jet-sema/src/Sema/ReceiverMarks.rs:46
fn place_root(expr: Expr) -> String? {
    if expr == {
        .Ident(name, _) -> Val(name)
        .Field(base, _, _) | .Index(base, _, _, _) | .Slice(base, _, _, _, _) -> place_root(base)
        else -> None
    }
}
// Rust: crates/jet-sema/src/Sema/ReceiverMarks.rs:59
fn start(expr: Expr) -> Int Never! {
    if expr == {
        .Field(base, _, _) | .Index(base, _, _, _) | .Slice(base, _, _, _, _) -> start(base)
        else -> expr.span().start
    }
}
// Rust: crates/jet-sema/src/Sema/ReceiverMarks.rs:58
pub fn place_span(expr: Expr) -> Span Never! {
    span :: expr.span()
    Span.new(start(expr).min(span.start), span.end)
}
// Rust: crates/jet-sema/src/Sema/ReceiverMarks.rs:71
fn is_window_type(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, _) -> name == "ViewMut" || name == "ComputeViewMut"
        .Tagged(_, inner) -> is_window_type(inner)
        else -> false
    }
}
impl Checker {
    // Rust: crates/jet-sema/src/Sema/ReceiverMarks.rs:82
    pub fn begin_receiver_mark(self: &Self, receiver: &Expr) {
        if receiver == .Place(inner, access, span) {
            marked :: access == PlaceAccess.Write || access == PlaceAccess.Take
            sliced :: if inner == { .Slice(_, _, _, _, _) -> true; else -> false }
            if marked && !sliced {
                inner_span :: inner.span()
                // GATE #4499: exact tuple-key identity in Checker.receiver_marks.
                self.receiver_marks[(inner_span.start, inner_span.end)] = ReceiverMark{access: access, mark_span: Span.new(span.start, span.start + 1)}
                receiver = ^inner
            }
        }
        span :: receiver.span()
        &self.receiver_mark_frames.push(ReceiverMarkFrame{receiver: (span.start, span.end), convention: None})
    }
    // Rust: crates/jet-sema/src/Sema/ReceiverMarks.rs:113
    pub fn note_receiver_convention(self: &Self, receiver: Expr, convention: AccessConvention) {
        span :: receiver.span()
        key :: (span.start, span.end)
        i := self.receiver_mark_frames.len()
        loop i > 0 {
            i -= 1
            if self.receiver_mark_frames[i].receiver != key -> continue
            stronger :: if self.receiver_mark_frames[i].convention == { .None -> true; .Val(seen) -> convention_rank(convention) > convention_rank(seen) }
            if stronger -> self.receiver_mark_frames[i].convention = Val(convention)
            break
        }
    }
    // Rust: crates/jet-sema/src/Sema/ReceiverMarks.rs:134
    pub fn finish_receiver_mark(self: &Self, receiver: Expr) {
        frame :: &self.receiver_mark_frames.pop() ?? return
        if self.compiler_generated -> return
        mark :: self.receiver_marks.get(frame.receiver)
        root := place_root(receiver)
        if root == .Val(name) { if self.lookup(name) == None -> root = None }
        if mark == .Val(written) {
            &self.check_written_receiver_mark(receiver, root != None, written, frame.convention)
            return
        }
        root_name :: root ?? return
        span :: place_span(receiver)
        authored :: self.source.get(span.start..span.end).is_some_and(text -> text.starts_with(root_name))
        if !authored -> return
        unmarked_last_use_take := false
        if receiver == .Ident(name, _) {
            if self.lookup(name) == .Val(info) {
                owned :: info.param_conv == None || info.param_conv == Val(AccessConvention.Move)
                unmarked_last_use_take = owned && !self.is_name_live_after(name)
            }
        }
        needed :: if frame.convention == {
            .Val(.Write) -> Syntax.SIGIL_WRITE
            .Val(.Move) -> {
                if unmarked_last_use_take || self.place_expr_type(receiver).is_some_and(ty -> type_is_copy(ty)) -> return
                Syntax.SIGIL_MOVE
            }
            else -> return
        }
        (verb, method_decl) :: if needed == Syntax.SIGIL_WRITE { ("writes", "&self") } else { ("takes", "^self") }
        place := self.source.get(span.start..span.end) ?? root_name // #4303
        diagnostic :: Diagnostic.error("E0224", "this call {verb} `{place}`, but `{place}` has no `{needed}` mark", "the method is declared with `{method_decl}`, so the call {verb} the named place it is called on; the mark sits on that place, the same way `edit(&buf)` and `consume(^text)` mark arguments", "write `{needed}{place}`", Val(span)).with_edit(TextEdit{span: Span.new(span.start, span.start), new_text: needed})
        &self.push_receiver_mark_diagnostic(diagnostic)
    }
    // Rust: crates/jet-sema/src/Sema/ReceiverMarks.rs:205
    fn check_written_receiver_mark(self: &Self, receiver: Expr, is_place: Bool, mark: ReceiverMark, convention: AccessConvention?) {
        written :: if mark.access == PlaceAccess.Take { Syntax.SIGIL_MOVE } else { Syntax.SIGIL_WRITE }
        remove :: fn(what: String, why: String) {
            Diagnostic.error("E0225", what, why, "remove `{written}`", Val(mark.mark_span)).with_edit(TextEdit{span: mark.mark_span, new_text: ""})
        }
        if !is_place {
            diagnostic :: remove("`{written}` marks a fresh value, not a named place", "a mark binds a name plus fields, indexes, or ranges; a call result or literal is new, so the call receives it without a mark")
            &self.push_receiver_mark_diagnostic(diagnostic)
            return
        }
        resolved :: convention ?? return
        replace :: fn(needed: String, verb: String) {
            Diagnostic.error("E0226", "this call {verb} its receiver, so the mark is `{needed}`, not `{written}`", "`&` marks a place the call writes and `^` a place the call takes; the resolved method declares which one", "replace `{written}` with `{needed}`", Val(mark.mark_span)).with_edit(TextEdit{span: mark.mark_span, new_text: needed})
        }
        diagnostic :: if (resolved, mark.access) == {
            (.Write, .Take) -> replace(Syntax.SIGIL_WRITE, "writes")
            (.Move, .Write) -> replace(Syntax.SIGIL_MOVE, "takes")
            (.Read, .Write) -> {
                if self.place_expr_type(receiver).is_some_and(ty -> is_window_type(ty)) -> return
                remove("this call only reads its receiver, so it takes no `{written}` mark", "a mark shows that a call writes (`&`) or takes (`^`) the named place; a read call leaves the place unmarked")
            }
            (.Read, _) -> remove("this call only reads its receiver, so it takes no `{written}` mark", "a mark shows that a call writes (`&`) or takes (`^`) the named place; a read call leaves the place unmarked")
            else -> return
        }
        &self.push_receiver_mark_diagnostic(diagnostic)
    }
    // Rust: crates/jet-sema/src/Sema/ReceiverMarks.rs:272
    fn push_receiver_mark_diagnostic(self: &Self, diagnostic: Diagnostic) {
        loop seen in self.diags { if seen.code == diagnostic.code && seen.span == diagnostic.span -> return }
        &self.diags.push(diagnostic)
    }
}
