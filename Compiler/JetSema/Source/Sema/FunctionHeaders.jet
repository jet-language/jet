// Standalone function-header special forms. These helpers are intentionally
// separate from the body checker so callers can normalize/check headers before
// registering or type-checking ordinary function bodies.
use jet_foundation.[
    AccessConvention,
    ArithmeticMode,
    ArithmeticPolicyFact,
    CallArg,
    Diagnostic,
    Expr,
    Func,
    ImplConstValue,
    ImplDef,
    ImportKind,
    Item,
    Marker,
    NamedType,
    Program,
    Span,
    Stmt,
    SymbolID,
    SymbolKind,
    Type,
]

SemaFunctionHeaderMarkerGate: struct {
    name: String
    span: Span
}

sema_function_header_normalize_external_method: fn(function: Func) -> Item Never! {
    external: function.external_type ?? return Item.Func{value: function}
    method := function
    method.external_type = None
    Item.Impl{value: ImplDef{
        span: method.span,
        type_name: external.name,
        type_span: external.span,
        trait_name: None,
        trait_span: None,
        operator_rhs: None,
        operator_marker: None,
        methods: [Func]{method},
        delegation_field: None,
        assoc_type_impls: [NamedType]{},
        constants: [ImplConstValue]{},
        is_generated_serde: false,
        os_target: None,
    }}
}

// `Type.method: fn(...)` registers as its one-method impl of `Type` (Rust
// parser `normalize_external_method_item`); the formatter keeps the written
// header, so the rewrite happens before any registration. A second
// `Type.method: fn` of the same pair is E0105 in the module namespace, as an
// external method is a module declaration. A header whose bare type no
// declaration or import of the module can name stays a function: its body
// is checked first, so the body's own name errors report before the target
// (the Rust checker's order), and a clean body reports the target, E0301
// (sema_function_header_external_target).
sema_function_header_normalize_external_methods: fn(program: &Program, in_package: Bool, diagnostics: &[Diagnostic]) Never! {
    external := false
    loop item in program.items {
        if item == .Func(function) && function.external_type != None -> external = true
    }
    if !external -> return
    imported := false
    loop import in program.imports {
        if import.kind == .Unqualified(_, _, _, _, _) -> imported = true
    }
    declared := [String:Bool]{}
    loop item in program.items {
        if item == .Func(_) -> next
        name: sema_registration_root_name(item)
        if name != "" -> declared[name] = true
    }
    seen := [String:Bool]{}
    items := [Item]{}
    loop item in program.items {
        if item == .Func(function) && function.external_type == .Val(target) {
            key: "{target.name}.{function.name}"
            if seen.get(key) != None {
                diagnostics.push(sema_defined_twice(function.name, "module declarations share one namespace", function.name_span))
                next
            }
            seen[key] = true
            if in_package || imported || target.name.contains(".") || declared.get(target.name) != None {
                items.push(sema_function_header_normalize_external_method(function))
                next
            }
        }
        items.push(item)
    }
    program.items = items
}

// E0301 for an external method header left a function (its type named by
// nothing the module declares or imports) whose body reported no error.
sema_function_header_external_target: fn(function: Func, diagnostics: &[Diagnostic], start: Int) Never! {
    target: function.external_type ?? return
    if sema_has_error_since(diagnostics, start) -> return
    diagnostics.push(sema_error("E0301", target.span, "the impl target `{target.name}` is not a registered type", "an implementation needs one nominal declaration in the resolved module graph", "declare or import the target type before its impl"))
}

sema_function_header_check_root_params: fn(function: Func, is_method: Bool, diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    if is_method || function.external_type != None {
        loop parameter_index in 0..<function.params.len() {
            if function.params[parameter_index].root {
                diagnostics.push(sema_error("E0103", function.params[parameter_index].name_span, "`#Root` is only valid on a top-level function", "a method already owns its receiver after the dot; marking another receiver would make dispatch ambiguous", "remove `#Root`, or move the function to module scope"))
                valid = false
            }
        }
        return valid
    }
    loop (index, parameter) in function.params {
        if parameter.root && index != 0 {
            diagnostics.push(sema_error("E0103", parameter.name_span, "`#Root` must mark the first parameter", "a reversible dot call has one receiver, and it is always the first value parameter", "move `#Root` to the first parameter"))
            valid = false
        }
        if parameter.root && parameter.convention != AccessConvention.Read {
            diagnostics.push(sema_error("E0103", parameter.name_span, "`#Root` must mark a bare-read parameter", "dot-call syntax never hides write access or a move behind the receiver", "remove the write mark `&` or the take mark `&&` from the `#Root` parameter"))
            valid = false
        }
    }
    valid
}

// L0511: a parameter named `err` is easy to misread as the failure report a
// `??` fallback names `err`, and a fallback in the body would shadow it.
sema_function_header_lint_err_params: fn(function: Func, diagnostics: &[Diagnostic]) {
    loop parameter in function.params {
        if parameter.name == "err" -> diagnostics.push(sema_err_shadow_lint(parameter.name_span))
    }
}

// L0510: a user function whose name is one the readable prelude opens
// replaces that alias in its file; the declaration wins, and is worth seeing.
sema_function_header_lint_prelude_shadow: fn(function: Func, diagnostics: &[Diagnostic]) {
    if function.compiler_generated || !SEMA_CALL_PRELUDE_NAMES.contains(function.name) -> return
    diagnostics.push(sema_lint("L0510", function.name_span, "Declaration {function.name} replaces a Core prelude alias", "The readable Core prelude opens this name automatically, and a user declaration wins in its file", "Keep the declaration to accept the shadow, or rename it to use the prelude alias"))
}

// L2401 (D-NARG1): a public function or method with a positional `Bool`
// parameter and no default invites transposed `true`/`false` arguments at the
// call site.
sema_function_header_lint_positional_bools: fn(function: Func, is_method: Bool, diagnostics: &[Diagnostic]) {
    if !function.is_pub || function.compiler_generated -> return
    noun: if is_method -> "method" else -> "function"
    name: sema_inline_member_source_name(function.name)
    loop parameter in function.params {
        if parameter.ty != Type.Bool || parameter.name == "self" || parameter.default != None -> next
        diagnostics.push(sema_lint("L2401", parameter.name_span, "Public {noun} `{name}` has a positional `Bool` parameter `{parameter.name}`", "Positional booleans are easy to transpose at the call site", "Callers can write `{parameter.name}: true` to make the intent clear (S61 labels)"))
    }
}

// D-MEMO1=A (Rust `memo_bound_from_markers`): the one result-cache
// configuration every execution tier reads. Without `#Memo` the function is
// not memoized; `#Memo(bound: none)` is the explicit unbounded store; any
// other `#Memo` keeps the default bound of 128 entries.
SEMA_DEFAULT_MEMO_BOUND: 128

SemaMemoConfig: struct {
    bound: Int?
    unbounded: Bool
}

sema_function_header_memo_config: fn(function: Func) -> SemaMemoConfig Never! {
    loop marker in function.markers {
        if marker.name != "Memo" -> next
        unbounded := false
        if marker.args.len() == 1 && marker.arg_labels.len() > 0 {
            if marker.arg_labels[0] == .Val(label) {
                if marker.args[0] == .Expr(value) {
                    if value == .Ident(name, _, _) -> unbounded = label.name == "bound" && name == "none"
                }
            }
        }
        if unbounded -> return SemaMemoConfig{bound: None, unbounded: true}
        return SemaMemoConfig{bound: Val(SEMA_DEFAULT_MEMO_BOUND), unbounded: false}
    }
    SemaMemoConfig{bound: None, unbounded: false}
}

// The memo configuration of the function `target` names, read from its
// declaration in place; None for a generic function (one store per
// instance, so no single store to report) or a non-function.
sema_function_header_memo_target: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, target: SymbolID) -> SemaMemoConfig? {
    if program.registration_graph == .Val(graph) {
        row: sema_registration_callable_row(graph, target.key) ?? return None
        if row == .Function(module_index, index) {
            if graph.modules[module_index].functions[index].declaration.type_params.len() > 0 -> return None
            return Val(sema_function_header_memo_config(graph.modules[module_index].functions[index].declaration))
        }
        return None
    }
    item: sema_scope_resolve_declaration(environment, program, target) ?? return None
    if item == .Func(function) && function.type_params.len() == 0 -> return Val(sema_function_header_memo_config(function))
    None
}

// D-MEMO1=A (Rust `infer_method_call`): `name.cache()` naming a memoized
// function is the read-only `MemoStats` of its result store, resolved
// before the ordinary receiver lookup.
sema_function_header_memo_stats: fn(receiver: Expr, method: String, args: [CallArg], method_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    unhandled: SemaDirectSpecialCheck{handled: false, value: None}
    if method != "cache" || args.len() > 0 -> return unhandled
    name := ""
    if receiver == .Ident(receiver_name, _, _) -> name = receiver_name
    if name == "" -> return unhandled
    nearest: sema_scope_resolve_index(scopes, name) ?? return unhandled
    symbol: sema_scope_binding_symbol(environment, scopes, nearest)
    if symbol.kind != SymbolKind.Function -> return unhandled
    config: sema_function_header_memo_target(environment, program, symbol.id) ?? return unhandled
    bound := "none"
    if config.bound == .Val(limit) {
        bound = "{limit}"
    } else if !config.unbounded {
        return unhandled
    }
    function: sema_call_callee_decl(program, symbol.id, method_span, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    SemaDirectSpecialCheck{handled: true, value: Val(sema_tree_node(Type.Named{name: "MemoStats"}, TExprKind.HostCall{call: THostCall.MemoStats{function: function, bound: bound}}, method_span))}
}

// E0126: a default expression may name only parameters written
// before its own; defaults fill left to right. `self` is not a parameter here.
// Answers the indices of the parameters whose defaults read a later one, so
// their defaults aren't checked again (the later name is not in scope there).
sema_function_header_check_default_forward_refs: fn(function: Func, diagnostics: &[Diagnostic]) -> [Int] {
    names := [String]{}
    loop parameter_index in 0..<function.params.len() {
        if function.params[parameter_index].name != "self" -> names.push(function.params[parameter_index].name)
    }
    invalid := [Int]{}
    index := 0
    loop parameter_index in 0..<function.params.len() {
        if function.params[parameter_index].name == "self" -> next
        if function.params[parameter_index].default == .Val(default) {
            references := [Expr]{}
            sema_function_header_default_idents(default, references)
            loop reference in references {
                if reference == .Ident(name, span, _) {
                    later := false
                    loop (position, candidate) in names {
                        if candidate == name {
                            later = position >= index
                            break
                        }
                    }
                    if later {
                        diagnostics.push(sema_error("E0126", span, "default for `{function.params[parameter_index].name}` in `{function.name}` references `{name}`, which comes after it", "defaults fill left to right; a parameter isn't in scope until it appears in the list", "reorder the parameters so `{name}` comes before `{function.params[parameter_index].name}`, or use a constant default"))
                        if invalid.len() == 0 || invalid[invalid.len() - 1] != parameter_index -> invalid.push(parameter_index)
                    }
                }
            }
        }
        index += 1
    }
    invalid
}

// The identifier nodes a default expression reads, in source order.
sema_function_header_default_idents: fn(value: Expr, found: &[Expr]) {
    if value == {
        .Ident(_, _, _) -> found.push(value)
        .Binary(_, left, right, _, _) -> {
            sema_function_header_default_idents(left, found)
            sema_function_header_default_idents(right, found)
        }
        .Unary(_, inner, _, _) | .Paren(inner, _, _) | .Copy(inner, _, _) | .Place(inner, _, _, _) | .Field(inner, _, _, _) | .Spread(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .Present(inner, _, _) | .Tainted(inner, _, _, _) -> sema_function_header_default_idents(inner, found)
        .Index(base, index, _, _, _) -> {
            sema_function_header_default_idents(base, found)
            sema_function_header_default_idents(index, found)
        }
        .Call(call, _) -> loop argument in call.args -> sema_function_header_default_idents(argument.expr, found)
        .CallValue(callee, args, _, _) -> {
            sema_function_header_default_idents(callee, found)
            loop argument in args -> sema_function_header_default_idents(argument.expr, found)
        }
        .MethodCall(receiver, _, _, _, _, args, _) -> {
            sema_function_header_default_idents(receiver, found)
            loop argument in args -> sema_function_header_default_idents(argument.expr, found)
        }
        .ListLit(items, _, _) -> loop item in items -> sema_function_header_default_idents(item, found)
        .TupleLit(fields, _, _, _) -> loop field in fields -> sema_function_header_default_idents(field.value, found)
        .Str(parts, _, _) -> loop part in parts {
            if part == .Interp(inner, _) -> sema_function_header_default_idents(inner, found)
        }
        .If(cond, _, then_value, _, else_value, _, _) -> {
            sema_function_header_default_idents(cond, found)
            sema_function_header_default_idents(then_value, found)
            sema_function_header_default_idents(else_value, found)
        }
        else -> {}
    }
}

sema_function_header_active_marker_gates: fn(function: Func) -> [SemaFunctionHeaderMarkerGate] Never! {
    gates := [SemaFunctionHeaderMarkerGate]{}
    if function.is_unsafe -> gates.push(SemaFunctionHeaderMarkerGate{name: "Unsafe", span: function.unsafe_span ?? function.name_span})
    if function.is_replayable -> gates.push(SemaFunctionHeaderMarkerGate{name: "Replayable", span: function.replayable_span ?? function.name_span})
    if function.is_must_use -> gates.push(SemaFunctionHeaderMarkerGate{name: "MustUse", span: function.must_use_span ?? function.name_span})
    if function.is_inline -> gates.push(SemaFunctionHeaderMarkerGate{name: "Inline", span: function.inline_span ?? function.name_span})
    if function.is_inline_always -> gates.push(SemaFunctionHeaderMarkerGate{name: "Inline", span: function.inline_span ?? function.name_span})
    if function.is_reactive -> gates.push(SemaFunctionHeaderMarkerGate{name: "Reactive", span: function.name_span})
    gates
}

sema_function_header_check_marker_gates: fn(function: Func, function_allowed_markers: [String], diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    loop gate in sema_function_header_active_marker_gates(function) {
        allowed := false
        loop name in function_allowed_markers {
            if name == gate.name -> allowed = true
        }
        if !allowed {
            diagnostics.push(sema_error("E0355", gate.span, "`#{gate.name}` cannot attach to a function", "the compiler-owned applicability registry is shared by parser, sema, formatter, semantic index, and explain", "move the rule to one of its registered sites"))
            valid = false
        }
    }
    valid
}

// The function rules whose meaning the parser projects onto `Func` fields
// that the checker, foreign stage and lowering read, plus `#Arithmetic`,
// which the body checker reads as the function's arithmetic policy
// (sema_function_arithmetic_policy); the marker row itself adds nothing.
// The descriptive rules are read by their own passes, never by the body
// check: `#Job` and its `#Every` schedule by the job artifact and name
// checks (Jobs.jet), `#Doc` by the job and CLI schema docs, `#Deprecated`
// by the lifecycle pass (Edition.jet), `#Scalar` by Core usage, `#Meta` by
// the marker rules, and `#Policy` by the policy wrappers and the call
// routes that apply them (CallablePolicies.jet).
sema_function_header_marker_projected: fn(name: String) -> Bool Never! {
    name == "Unsafe" || name == "Inline" || name == "MustUse" || name == "Replayable" || name == "Scrub" || name == "Comptime" || name == "FFI" || name == "Arithmetic" || name == "Pre" || name == "Post" || name == "Job" || name == "Every" || name == "Doc" || name == "Deprecated" || name == "Scalar" || name == "Meta" || name == "Policy"
}

// (Rust `check_fn`): the first `#Arithmetic(mode)` marker of
// a function opens its lexical fixed-width arithmetic mode for the whole
// body; an argument that names no mode opens none.
sema_function_arithmetic_policy: fn(markers: [Marker]) -> ArithmeticPolicyFact? Never! {
    loop marker in markers {
        if marker.name != "Arithmetic" -> next
        if marker.args.len() == 0 -> return None
        mode: if marker.args[0] == {
            .Expr(value) -> sema_function_arithmetic_mode(value)
            else -> None
        } ?? return None
        return Val(ArithmeticPolicyFact{mode: mode, scope_span: marker.span, operation_span: marker.span, operation: None})
    }
    None
}

// Rust `ArithmeticMode::from_expr`.
sema_function_arithmetic_mode: fn(value: Expr) -> ArithmeticMode? Never! {
    word: if value == {
        .Ident(name, _, _) -> name
        .Field(_, member, _, _) -> member
        .EnumLit(_, variant, _, _, _, _, _) -> variant
        else -> ""
    }
    if word == {
        "Checked" -> Val(ArithmeticMode.Checked)
        "Wrapping" -> Val(ArithmeticMode.Wrapping)
        "Saturating" -> Val(ArithmeticMode.Saturating)
        else -> None
    }
}

// The header forms the body checker does not handle yet. Each one records
// why on `context`, so an incomplete function never fails without a cause.
sema_function_header_supported: fn(function: Func, context: &SemaCheckContext) -> Bool Never! {
    supported := true
    if function.head_pattern != None {
        sema_check_unsupported(context, "the multi-head pattern function `{function.name}` reached body checking without being desugared")
        supported = false
    }
    // (Rust `check_fn`): an `#FFI(<lang>)` body is foreign
    // source, never Jet statements. The registration foreign stage validates
    // it (E3220/E3215/E3222/E3102/E3223) and calls bind to its checked foreign
    // row, so the module loops never send it here; any other route has no Jet
    // body to produce.
    if function.inline_foreign != None {
        sema_check_unsupported(context, "the inline foreign (`#FFI`) function `{function.name}` has no Jet body; calls bind to its checked foreign row, so it cannot be checked or run as a Jet function")
        supported = false
    }
    if function.is_reactive {
        sema_check_unsupported(context, "`#Reactive fn` is not lowered by the self-hosted checker yet")
        supported = false
    }
    loop marker in function.markers {
        // `is_guest_export_marker`: an `#Export(c)` function is an ordinary Jet
        // body; the export row is read after checking (jet_driver_c_exports), so
        // the marker adds nothing to the body check. A `#Kernel(.parallel)`
        // marker is the parsed `function.kernel`, whose proof obligations
        // Kernel.jet checks. `#Memo` is checked by sema_check_memoized_function
        // (E0939/E0940) and the effect pass (E0938); its result cache is the
        // body's memo facts (sema_function_header_memo_config). A
        // `#Target(JS|Wasm)` or `#WasmExport` marker is the parsed
        // `function.web_marker`, which WebPartition.jet checks. A
        // `#State`/`#Transition` marker is the parsed
        // `function.state_requires`/`state_transition`, which StateFacts.jet
        // validates and Typestate.jet checks at each call. An
        // `#Allow(jet.LintName, "why")` is a lint allowance over the body
        // (LintAllowances.jet), validated by MarkerRules. A `#DevPanel` panel is
        // an ordinary Jet body; the devtools publication gate
        // (Calls/Devtools.jet) reads the marker to find the panel's state.
        if sema_function_header_marker_projected(marker.name) || (marker.name == "Reactive" && function.is_reactive) || (marker.name == "Kernel" && function.kernel != None) || marker.name == "Memo" || marker.name == "Allow" || marker.name == "DevPanel" || ((marker.name == "Target" || marker.name == "WasmExport") && function.web_marker != None) || (marker.name == "State" && function.state_requires != None) || (marker.name == "Transition" && function.state_transition != None) || sema_marker_is_guest_export(marker) -> next
        // A user-declared marker is metadata its declaration describes; it
        // has no compiler meaning for the body check or lowering to read.
        if marker.declaration_module != None -> next
        sema_check_unsupported(context, "the function marker `#{marker.name}` is not supported by the self-hosted checker yet")
        supported = false
    }
    loop parameter_index in 0..<function.params.len() {
        if function.params[parameter_index].variadic_bound_list != None {
            sema_check_unsupported(context, "the variadic bound list on parameter `{function.params[parameter_index].name}` is not supported by the self-hosted checker yet")
            supported = false
        }
    }
    supported
}

// Rust `core_imports.values().any(|m| m == "core.mem")`: `use core.mem` parses
// as the unqualified member `mem` of `core`, so the imported module path is
// the alias joined with the member; `use core.mem.[...]` names it directly.
sema_function_header_inline_has_core_mem: fn(module_row: SemaRegistrationModule) -> Bool Never! {
    loop declaration in module_row.program.imports {
        has_core_mem: if declaration.kind == {
            .Module(name, _) -> name == "core.mem"
            .Unqualified(module_alias, _, items, _, _) -> module_alias == "core.mem" || (loop item in items {
                if "{module_alias}.{item.original}" == "core.mem" -> break true
            } ?? false)
            else -> false
        }
        if has_core_mem {
            return true
        }
    }
    false
}

// (Rust `check_variadic_bound_body_shape`, E1314): a
// trait-bounded variadic parameter (`...Trait` / `...[A, B]`) has no single
// Rust type, so its only supported use is the collection of one top-level
// `loop x in name { … }` loop. Every other reference is reported.
sema_function_header_check_variadic_bound_shape: fn(function: Func, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Bool {
    if function.params.len() == 0 -> return true
    last: function.params[function.params.len() - 1]
    if !last.variadic -> return true
    bounded := false
    if last.variadic_bound_list == .Val(list) {
        bounded = list.len() > 0
    } else {
        if last.ty == .Named(trait_name) && trait_name != "" {
            bounded = sema_type_builtin_trait_symbol(trait_name) != None
            if !bounded && program.registration_graph == .Val(graph) -> bounded = sema_type_graph_trait_symbol(graph, environment.module_identity, trait_name) != None
        }
    }
    if !bounded -> return true
    loops := 0
    uses := [Span]{}
    loop statement in function.body -> sema_function_header_variadic_statement(statement, last.name, true, loops, uses)
    if loops > 1 -> uses.push(last.name_span)
    loop span in uses {
        diagnostics.push(sema_error("E1314", span, "`{last.name}` can only be used in a direct `loop x in {last.name} {{ … }}` loop here", "`{last.name}` is a trait-bounded variadic (`...Trait` / `...[A, B]`) — its elements can have different concrete types, so there's no single type to give `{last.name}` outside a loop that visits each argument once", "iterate it with `loop x in {last.name} {{ … }}` — that's the only supported use"))
    }
    uses.len() == 0
}

sema_function_header_variadic_body: fn(body: [Stmt], name: String, loops: &Int, uses: &[Span]) Never! {
    loop statement in body -> sema_function_header_variadic_statement(statement, name, false, loops, uses)
}

sema_function_header_variadic_statement: fn(statement: Stmt, name: String, top_level: Bool, loops: &Int, uses: &[Span]) Never! {
    if statement == {
        .Expr(value) | .DeferClose(value, _) -> sema_function_header_variadic_expr(value, name, uses)
        .Return(value, _) -> {
            if value == .Val(returned) -> sema_function_header_variadic_expr(returned, name, uses)
        }
        .Val(binding) -> sema_function_header_variadic_expr(binding.init, name, uses)
        .Assign(target, _, _, value) -> {
            if target == {
                .Index(base, index, _, _) -> {
                    sema_function_header_variadic_expr(base, name, uses)
                    sema_function_header_variadic_expr(index, name, uses)
                }
                .Field(base, _, _) -> sema_function_header_variadic_expr(base, name, uses)
                .Local(local, local_span) -> {
                    if local == name -> uses.push(local_span)
                }
                else -> {}
            }
            sema_function_header_variadic_expr(value, name, uses)
        }
        .While(cond, body, _, _, _) -> {
            sema_function_header_variadic_expr(cond, name, uses)
            sema_function_header_variadic_body(body, name, loops, uses)
        }
        .For(_, _, second, kind, body, span, _, label, _) -> {
            direct := false
            if top_level && second == None && label == None && kind == .In(direct_collection, direct_step) && direct_step == None && direct_collection == .Ident(direct_name, _, _) && direct_name == name -> direct = true
            if direct {
                loops += 1
            } else {
                if kind == {
                    .Range(start, end, step, _) -> {
                        sema_function_header_variadic_expr(start, name, uses)
                        sema_function_header_variadic_expr(end, name, uses)
                        if step == .Val(step_value) -> sema_function_header_variadic_expr(step_value, name, uses)
                    }
                    .In(collection, step) -> {
                        if collection == .Ident(collection_name, _, _) && collection_name == name {
                            uses.push(span)
                        } else {
                            sema_function_header_variadic_expr(collection, name, uses)
                        }
                        if step == .Val(step_value) -> sema_function_header_variadic_expr(step_value, name, uses)
                    }
                }
            }
            sema_function_header_variadic_body(body, name, loops, uses)
        }
        .Switch(subject, arms, else_body, _) -> {
            sema_function_header_variadic_expr(subject, name, uses)
            loop arm in arms {
                sema_function_header_variadic_expr(arm.cond, name, uses)
                sema_function_header_variadic_body(arm.body, name, loops, uses)
            }
            if else_body == .Val(body) -> sema_function_header_variadic_body(body, name, loops, uses)
        }
        .Loop(body, _, _, _) -> sema_function_header_variadic_body(body, name, loops, uses)
        .CountedLoop(init, cond, step, body, _, _, _) -> {
            sema_function_header_variadic_expr(init.init, name, uses)
            sema_function_header_variadic_expr(cond, name, uses)
            if step == .Val(inner) -> sema_function_header_variadic_statement(inner, name, false, loops, uses)
            sema_function_header_variadic_body(body, name, loops, uses)
        }
        // Scope wrappers (`#Unsafe { }`, regions, groups, …) stay out of the
        // v1 scan, as in the Rust walk.
        else -> {}
    }
}

sema_function_header_variadic_args: fn(args: [CallArg], name: String, uses: &[Span]) Never! {
    loop arg in args -> sema_function_header_variadic_expr(arg.expr, name, uses)
}

sema_function_header_variadic_expr: fn(expr: Expr, name: String, uses: &[Span]) Never! {
    if expr == {
        .Ident(found, span, _) -> {
            if found == name -> uses.push(span)
        }
        .Call(call, _) -> sema_function_header_variadic_args(call.args, name, uses)
        .MethodCall(receiver, _, _, _, _, args, _) | .CallValue(receiver, args, _, _) -> {
            sema_function_header_variadic_expr(receiver, name, uses)
            sema_function_header_variadic_args(args, name, uses)
        }
        .Binary(_, left, right, _, _) -> {
            sema_function_header_variadic_expr(left, name, uses)
            sema_function_header_variadic_expr(right, name, uses)
        }
        .Unary(_, inner, _, _) | .Field(inner, _, _, _) | .Deref(inner, _, _) | .RawOf(inner, _, _) | .Copy(inner, _, _) | .Place(inner, _, _, _) | .Tainted(inner, _, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .OptField(inner, _, _, _, _, _) -> sema_function_header_variadic_expr(inner, name, uses)
        .Try(inner, _, _, note, _) -> {
            sema_function_header_variadic_expr(inner, name, uses)
            if note == .Val(note_value) -> sema_function_header_variadic_expr(note_value, name, uses)
        }
        .Index(base, index, _, _, _) -> {
            sema_function_header_variadic_expr(base, name, uses)
            sema_function_header_variadic_expr(index, name, uses)
        }
        .Slice(base, start, end, range, _, _) -> {
            sema_function_header_variadic_expr(base, name, uses)
            if range == .Val(range_value) {
                sema_function_header_variadic_expr(range_value, name, uses)
            } else {
                sema_function_header_variadic_expr(start, name, uses)
                sema_function_header_variadic_expr(end, name, uses)
            }
        }
        .ListLit(elements, _, _) -> loop element in elements -> sema_function_header_variadic_expr(element, name, uses)
        .MapLit(entries, _, _) -> loop entry in entries {
            sema_function_header_variadic_expr(entry.key, name, uses)
            sema_function_header_variadic_expr(entry.value, name, uses)
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> loop field in fields -> sema_function_header_variadic_expr(field.value, name, uses)
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> loop field in fields -> sema_function_header_variadic_expr(field.value, name, uses)
                .Elements(elements) -> loop element in elements -> sema_function_header_variadic_expr(element, name, uses)
                .Entries(entries) -> loop entry in entries {
                    sema_function_header_variadic_expr(entry.key, name, uses)
                    sema_function_header_variadic_expr(entry.value, name, uses)
                }
                .Value(value) -> sema_function_header_variadic_expr(value, name, uses)
                else -> {}
            }
        }
        .TupleLit(fields, _, _, _) -> loop field in fields -> sema_function_header_variadic_expr(field.value, name, uses)
        .EnumLit(_, _, _, args, _, _, _) -> loop arg in args {
            if arg == {
                .Positional(value) -> sema_function_header_variadic_expr(value, name, uses)
                .Named(_, value) -> sema_function_header_variadic_expr(value, name, uses)
            }
        }
        .Str(parts, _, _) -> loop part in parts {
            if part == .Interp(value, _) -> sema_function_header_variadic_expr(value, name, uses)
        }
        else -> {}
    }
}
