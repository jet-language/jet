use jet_foundation.[Diagnostic, Span, TextEdit, AccessConvention, CtValue, Expr, LValue, LambdaBody, PlaceAccess, Stmt, OrFallback, TEXT_NUL, MirDecisionDisposition, MirDecisionKind, MirDecisionRow]
use jet_sema.[Checker, expr_refs_name, block_definitely_exits, expr_root_ident, RuleSite]
use jet_syntax as Syntax

// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:9
LINT_UNREACHABLE_AFTER_LOOP :: "unreachable_after_loop"
impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:12
    fn attach_decision_row(self: &Self, diagnostic: Diagnostic, kind: MirDecisionKind, disposition: MirDecisionDisposition, span: Span, rule: String, reason: String) -> Diagnostic {
        diagnostic.with_decision_row(MirDecisionRow.new(kind, disposition, None, self.fn_name.clone(), span, rule, reason, "sema.loop-liveness", "static-flow-proof"))
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:37
    pub fn emit_loop_liveness_lints_for_stmt(self: &Self, stmt: &Stmt, reachable_before: Bool, effect_free: Bool) {
        if !reachable_before -> return
        self.emit_constant_loop_condition_lint(stmt)
        self.emit_discarded_expression_lint(stmt, effect_free)
        self.emit_mutable_never_reassigned_lint(stmt)
        self.emit_state_loop_unchanged_lint(stmt)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:55
    pub fn emit_unreachable_after_loop(self: &Self, previous: &Stmt, current: &Stmt) {
        if self.flow.reachable || !self.is_unconditional_loop(previous) || self.statement_lint_is_allowed(current.span(), LINT_UNREACHABLE_AFTER_LOOP) -> return
        diagnostic :: self.attach_decision_row(
            Diagnostic.from_row("L0525", [], Val(current.span())).with_edit(TextEdit{span: current.span(), new_text: ""}),
            MirDecisionKind.Unreachable, MirDecisionDisposition.Selected, current.span(),
            "unreachable-after-loop", "the unconditional loop has no reachable break before this statement")
        self.diags.push(^diagnostic)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:76
    fn emit_constant_loop_condition_lint(self: &Self, stmt: &Stmt) {
        (condition, value, removable) :: if stmt == {
            .While{cond, ..} -> (cond, self.constant_bool(cond) ?? return, true)
            .CountedLoop{cond, ..} -> (cond, self.constant_bool(cond) ?? return, false)
            _ -> return
        }
        span :: condition.span()
        if span.start >= span.end -> return
        diagnostic := Diagnostic.from_row("L0526", [], Val(span))
        // Only a literal true in a plain conditional loop admits a header edit.
        if removable && value && condition.without_parens() == .Bool(true, _) {
            if self.loop_condition_header_span(stmt, span) == .Val(header_span) {
                diagnostic = diagnostic.with_edit(TextEdit{span: header_span, new_text: "loop"})
            }
        }
        diagnostic = self.attach_decision_row(^diagnostic, MirDecisionKind.LoopInvariant, MirDecisionDisposition.Rejected, span, "constant-loop-condition", "the loop condition is constant under the checked flow facts")
        self.diags.push(^diagnostic)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:124
    fn emit_discarded_expression_lint(self: &Self, stmt: &Stmt, effect_free: Bool) {
        if self.arrow_loop_body || !effect_free -> return
        if stmt == .Expr(expr) {
            if self.lost_tail_span == Val(expr.span()) -> return
            discarded :: if expr.without_parens() == {
                .Ident(name, _) -> !name.starts_with(TEXT_NUL) && name != "_"
                .Unary(..) | .Binary(..) | .CompareChain{..} -> true
                _ -> false
            }
            if !discarded -> return
            span :: expr.span()
            if span.start >= span.end -> return
            diagnostic :: self.attach_decision_row(
                Diagnostic.from_row("L0527", [], Val(span)).with_edit(TextEdit{span: span, new_text: ""}),
                MirDecisionKind.LoopInvariant, MirDecisionDisposition.Rejected, span,
                "discarded-expression", "the expression has no checked effect and its value is discarded")
            self.diags.push(^diagnostic)
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:166
    fn emit_mutable_never_reassigned_lint(self: &Self, stmt: &Stmt) {
        if stmt == .Val(binding) {
            if !binding.mutable || binding.name.is_empty() || self.compiler_generated -> return
            (info_mutable, info_sigil_span) :: self.lookup(binding.name).map(fn(info) { (info.mutable, info.binding_sigil_span) }) ?? return
            if !info_mutable -> return
            name :: binding.name
            if self.current_stmt_tail().iter().any(fn(stmt) { statement_writes_name(stmt, name) }) -> return
            sigil_span :: binding.sigil_span.or(info_sigil_span) ?? return
            diagnostic :: Diagnostic.from_row("L0528", [], Val(binding.name_span)).with_edit(TextEdit{span: sigil_span, new_text: "::"})
            diagnostic :: self.attach_decision_row(^diagnostic, MirDecisionKind.LoopInvariant, MirDecisionDisposition.Rejected,
                binding.name_span, "mutable-never-reassigned", "the mutable binding has no checked write in the remaining block")
            self.diags.push(^diagnostic)
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:214
    fn emit_state_loop_unchanged_lint(self: &Self, stmt: &Stmt) {
        if stmt == .CountedLoop{init, cond, step, body, label, ..} {
            if !init.mutable || init.name.is_empty() || !expr_refs_name(cond, init.name) -> return
            name :: init.name
            if body.iter().any(fn(stmt) { statement_writes_name(stmt, name) }) || step.as_ref().is_some_and(fn(stmt) { statement_writes_name(stmt, name) }) -> return
            loop_label :: label.as_ref().map(fn((name, _)) { name })
            if !state_loop_can_reach_next_turn(&body, loop_label) -> return
            diagnostic :: self.attach_decision_row(Diagnostic.from_row("L0529", [], Val(init.name_span)),
                MirDecisionKind.LoopInvariant, MirDecisionDisposition.Rejected, init.name_span,
                "state-loop-unchanged", "the state-loop condition reads unchanged header state before another turn")
            self.diags.push(^diagnostic)
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:252
    fn is_unconditional_loop(self: &Self, stmt: &Stmt) -> Bool {
        if stmt == {
            .Loop{..} -> block_definitely_exits(std.slice.from_ref(stmt))
            .While{cond, ..} | .CountedLoop{cond, ..} -> self.constant_bool(cond) == Val(true) && block_definitely_exits(std.slice.from_ref(stmt))
            _ -> false
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:266
    fn constant_bool(self: &Self, expr: &Expr) -> Bool? {
        if expr.without_parens() == .Bool(value, _) -> return Val(value)
        if self.evaluate_constant(expr) == .Val(.Bool(value)) -> Val(value) else -> None
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:275
    fn loop_condition_header_span(self: &Self, stmt: &Stmt, condition: Span) -> Span? {
        statement :: stmt.span()
        prefix :: self.source.get(statement.start..condition.start) ?? return None
        keyword :: if (prefix.rfind("loop"), prefix.rfind("while")) == {
            (.Val(loop_keyword), .Val(while_keyword)) -> loop_keyword.max(while_keyword)
            (.Val(keyword), .None) | (.None, .Val(keyword)) -> keyword
            (.None, .None) -> return None
        }
        Val(Span.new(statement.start + keyword, condition.end))
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:288
    #Unsafe("read the live AST tail installed by check_block_inner; the AST outlives the checker")
    fn current_stmt_tail(self: &Self) -> &[Stmt] {
        if self.stmt_tail_ptr.is_null() || self.stmt_tail_len == 0 -> return &[]
        // GATE #4494: borrowed retained AST slice, never a Rust callback.
        std.slice.from_raw_parts(self.stmt_tail_ptr, self.stmt_tail_len)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:298
    fn statement_lint_is_allowed(self: &Self, target: Span, lint_name: String) -> Bool {
        self.rule_facts.iter().any(fn(application) {
            if application.marker.name != Syntax.MARKER_ALLOW -> return false
            valid_site :: if application.site == .Val(.Block) | .Val(.Statement) -> true else -> false
            if !valid_site -> return false
            target_matches :: application.target == Val(target) || (application.target.is_none() && application.marker.span.start <= target.start.saturating_add(1) && target.start <= application.marker.span.start)
            target_matches && application.marker.args.iter().filter_map(fn(arg) { arg.as_expr() }).any(fn(argument) {
                if argument == .Ident(name, _) -> name == lint_name else -> false
            })
        })
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:325
fn state_loop_can_reach_next_turn(body: &[Stmt], label: String?) -> Bool {
    if !block_definitely_exits(body) -> return true
    for statement in body {
        if statement_contains_current_continue(statement, label) -> return true
        if block_definitely_exits(std.slice.from_ref(statement)) -> return false
    }
    false
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:342
fn body_contains_current_continue(body: &[Stmt], label: String?) -> Bool {
    body.iter().any(fn(stmt) { statement_contains_current_continue(stmt, label) })
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:347
fn statement_contains_current_continue(stmt: &Stmt, label: String?) -> Bool {
    if stmt == {
        .Continue(_) -> true
        .ContinueLabel(name, _) -> label == Val(name)
        .Switch{arms, else_body, ..} | .ComptimeSwitch{arms, else_body, ..} -> arms.iter().any(fn(arm) { body_contains_current_continue(&arm.body, label) }) || else_body.as_ref().is_some_and(fn(body) { body_contains_current_continue(body, label) })
        .ComptimeIf{then_body, else_body, ..} -> body_contains_current_continue(&then_body, label) || else_body.as_ref().is_some_and(fn(body) { body_contains_current_continue(body, label) })
        .Unsafe{body, ..} | .Impure{body, ..} | .Reactive{body, ..} | .Shield{body, ..} |
        .Switched{body, ..} | .Region{body, ..} | .Policy{body, ..} | .TaskGroup{body, ..} |
        .Layout{body, ..} | .AuthorityScope{body, ..} | .ComptimeBlock{body, ..} |
        .ContextBlock{body, ..} | .Live{body, ..} | .Transact{body, ..} |
        .AssumeDet{body, ..} | .ScopeMember{body, ..} -> body_contains_current_continue(&body, label)
        // Nested loops own their unlabelled continue.
        _ -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:396
fn statement_writes_name(stmt: &Stmt, name: String) -> Bool {
    direct :: if stmt == .Assign{target, ..} -> lvalue_writes_name(target, name) else -> false
    if direct || nested_direct_assignment(stmt, name) -> return true
    writes := false
    stmt.for_each_expr(fn(expr) { writes |= expression_writes_name(expr, name) })
    writes
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:411
fn expression_writes_name(expr: &Expr, name: String) -> Bool {
    if expr.without_parens() == {
        .Place(inner, .Write, _) -> expr_root_name(inner) == Val(name)
        .Call(call) -> call.args.iter().any(fn(arg) { arg.convention == AccessConvention.Write && expr_root_name(&arg.expr) == Val(name) })
        .CallValue{args, ..} -> args.iter().any(fn(arg) { arg.convention == AccessConvention.Write && expr_root_name(&arg.expr) == Val(name) })
        .MethodCall{receiver, args, ..} -> expr_root_name(receiver) == Val(name) || args.iter().any(fn(arg) { arg.convention == AccessConvention.Write && expr_root_name(&arg.expr) == Val(name) })
        .Lambda(lambda) -> if lambda.body == {
            .Expr(body) -> expression_writes_name(body, name)
            .Block(body) -> body.iter().any(fn(stmt) { statement_writes_name(stmt, name) })
        }
        .If{then_body, else_body, ..} -> then_body.iter().any(fn(stmt) { statement_writes_name(stmt, name) }) || else_body.iter().any(fn(stmt) { statement_writes_name(stmt, name) })
        .OrFallback{value, fallback, ..} -> expression_writes_name(value, name) || fallback_writes_name(fallback, name)
        _ -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:450
fn fallback_writes_name(fallback: &OrFallback, name: String) -> Bool {
    if fallback == {
        .Value(value) -> expression_writes_name(value, name)
        .Block{body, value, ..} -> body.iter().any(fn(stmt) { statement_writes_name(stmt, name) }) || value.as_ref().is_some_and(fn(value) { expression_writes_name(value, name) })
        .Return(.Val(value), _) -> expression_writes_name(value, name)
        .Panic{args, ..} -> args.iter().any(fn(arg) { arg.convention == AccessConvention.Write && expr_root_name(&arg.expr) == Val(name) })
        .Return(.None, _) | .Break(_) | .Continue(_) | .BreakLabel(..) | .ContinueLabel(..) -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:472
fn nested_direct_assignment(stmt: &Stmt, name: String) -> Bool {
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:473
    fn body_writes(body: &[Stmt], name: String) -> Bool { body.iter().any(fn(stmt) { statement_writes_name(stmt, name) }) }
    if stmt == {
        .While{body, ..} | .For{body, ..} | .Loop{body, ..} | .Unsafe{body, ..} |
        .Impure{body, ..} | .Reactive{body, ..} | .Shield{body, ..} | .Switched{body, ..} |
        .Region{body, ..} | .Policy{body, ..} | .AuthorityScope{body, ..} |
        .ComptimeBlock{body, ..} | .Live{body, ..} | .Transact{body, ..} |
        .Layout{body, ..} -> body_writes(&body, name)
        .CountedLoop{step, body, ..} -> step.as_ref().is_some_and(fn(step) { statement_writes_name(step, name) }) || body_writes(&body, name)
        .Switch{arms, else_body, ..} | .ComptimeSwitch{arms, else_body, ..} -> arms.iter().any(fn(arm) { body_writes(&arm.body, name) }) || else_body.as_ref().is_some_and(fn(body) { body_writes(body, name) })
        .TaskGroup{body, ..} | .ContextBlock{body, ..} | .AssumeDet{body, ..} | .ScopeMember{body, ..} -> body_writes(&body, name)
        .ComptimeIf{then_body, else_body, ..} -> body_writes(&then_body, name) || else_body.as_ref().is_some_and(fn(body) { body_writes(body, name) })
        _ -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:527
fn lvalue_writes_name(target: &LValue, name: String) -> Bool {
    if target == {
        .Local{name: candidate, ..} -> candidate == name
        .Field{base, ..} | .Index{base, ..} -> expr_root_name(base) == Val(name)
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints/loop_lints.rs:536
fn expr_root_name(expr: &Expr) -> String? { expr_root_ident(expr.without_parens()) }

