use jet_foundation.[Diagnostic, Span, TextEdit, Expr, ForKind, LValue, Stmt, StrPart, Type, Binding]
use jet_sema.[Checker, source_expr_start, source_call_end, landed_core_call]
use jet_sema.CheckerInfer.StdlibLints.[DisplayLint, LoopLints]
use std.[HashSet]

impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:23
    pub fn prepare_stdlib_lint_block(self: &Self, stmts: &[Stmt]) {
        ascii_lower_landed := None
        ascii_upper_landed := None
        replace_landed := None
        for index in 0..stmts.len() {
            (binding, lower, last_end) :: ascii_ladder(stmts, index) ?? continue
            direction_landed :: if lower -> ascii_lower_landed.get_or_insert_with(fn() {
                jet_foundation.Collections.builtin_method_return(&Type.String, "to_ascii_lower", 0, false) == Val(Val(Type.String))
            }) else -> ascii_upper_landed.get_or_insert_with(fn() {
                jet_foundation.Collections.builtin_method_return(&Type.String, "to_ascii_upper", 0, false) == Val(Val(Type.String))
            })
            if !direction_landed -> continue
            if !replace_landed.get_or_insert_with(fn() {
                jet_foundation.Collections.builtin_method_return(&Type.String, "replace", 2, false) == Val(Val(Type.String))
            }) -> continue
            direction :: if lower -> "to_ascii_lower" else -> "to_ascii_upper"
            prefix :: self.source.get(binding.name_span.start..binding.init.span().start) ?? continue
            init :: self.source.get(binding.init.span().start..binding.init.span().end) ?? continue
            edit :: TextEdit{span: Span.new(binding.name_span.start, last_end), new_text: "{prefix}{init}.{direction}()"}
            self.stdlib_lint_candidates.insert(binding.name_span.start, (binding.name_span, edit))
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:87
    pub fn emit_stdlib_lints_for_stmt(self: &Self, stmt: &Stmt) {
        typed_mutable_string :: if stmt == .Val(binding) -> binding.mutable && self.lookup(binding.name).is_some_and(fn(info) { info.ty == Type.String }) else -> false
        if typed_mutable_string && self.flow.reachable {
            if self.stdlib_lint_candidates.remove(stmt.span().start) == .Val((span, edit)) {
                self.diags.push(Diagnostic.from_row("L0521", [], Val(span)).with_edit(^edit))
            }
        }
        if stmt == .For{var, var2: .None, kind: .In{collection, ..}, body, ..} {
            self.check_stdlib_walk_filter(var, collection, &body)
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:115
    fn check_stdlib_walk_filter(self: &Self, var: String, collection: &Expr, body: &[Stmt]) {
        if !self.flow.reachable -> return
        (receiver, method_span) :: direct_fs_walk(self, collection) ?? return
        filter :: body.first() ?? return
        if !is_directory_filter(filter, var) -> return
        path_uses := USize{0}
        for stmt in body.iter().skip(1) {
            facts :: stmt_lint_facts(stmt, var)
            if facts.has_control_flow(stmt) || !facts.uses_only_path() -> return
            path_uses += facts.path_uses
        }
        if path_uses == 0 -> return
        edit :: walk_files_edit(self, receiver, method_span) ?? return
        self.diags.push(Diagnostic.from_row("L0522", [], Val(edit.span)).with_edit(^edit))
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:148
fn direct_fs_walk(checker: &Checker, expr: &Expr) -> (&Expr, Span)? {
    if expr.without_parens() == .OrFallback{value, ..} | .Try(value, ..) -> return direct_fs_walk(checker, value)
    if expr.without_parens() == .MethodCall{receiver, method, method_span, args, ..} {
        if method != "walk" || (args.len() != 1 && args.len() != 2) -> return None
        if !args.iter().enumerate().all(fn((index, arg)) {
            label_ok :: if index == 1 -> arg.label.as_ref().map(fn((label, _)) { label }).is_none_or(fn(label) { label == "ignore" }) else -> arg.label.is_none()
            !arg.spread && label_ok
        }) -> return None
        if checker.core_module_path_from_receiver(receiver).is_some_and(fn((module, alias, _)) { module == "core.files" && alias == "fs" }) &&
            landed_core_call("core.files", "walk", 2) && landed_core_call("core.files", "walk_files", 2) -> return Val((receiver, method_span))
    }
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:186
fn walk_files_edit(checker: &Checker, receiver: &Expr, method_span: Span) -> TextEdit? {
    start :: source_expr_start(receiver)
    end :: source_call_end(checker.source, method_span) ?? return None
    prefix :: checker.source.get(start..method_span.start) ?? return None
    suffix :: checker.source.get(method_span.end..end) ?? return None
    Val(TextEdit{span: Span.new(start, end), new_text: "{prefix}walk_files{suffix}"})
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:197
fn is_directory_filter(stmt: &Stmt, var: String) -> Bool {
    if stmt == .Switch{subject, arms, else_body: .None, span} {
        if !jet_foundation.is_subjectless_guard(subject, span) || arms.len() != 1 -> return false
        arm :: &arms[0]
        if arm.cond.without_parens() == .Field(base, field, _) {
            if base.without_parens() == .Ident(name, _) && name == var && field == "is_dir" && arm.body.len() == 1 {
                if arm.body[0] == .Continue(_) -> return true
            }
        }
    }
    false
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:221
struct StmtLintFacts {
    path_uses: USize = 0
    allowed_path_bases: HashSet<Span> = HashSet.new() // GATE #4499: Span set keys.
    variable_uses: [Span] = []
    has_fallback_exit: Bool = false
}
impl StmtLintFacts {
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:229
    fn uses_only_path(self: &Self) -> Bool { self.variable_uses.iter().all(fn(span) { self.allowed_path_bases.contains(span) }) }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:235
    fn has_control_flow(self: &Self, stmt: &Stmt) -> Bool { self.has_fallback_exit || stmt_has_structural_control_flow(stmt) }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:240
fn stmt_lint_facts(stmt: &Stmt, var: String) -> StmtLintFacts {
    copy := stmt.clone()
    facts := StmtLintFacts{}
    scan_stmt_exprs(&copy, var, &facts)
    ^facts
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:247
fn scan_expr(expr: &Expr, var: String, facts: &StmtLintFacts, check_fallback: Bool) {
    expr.for_each_expr_mut(fn(nested) {
        shape :: nested.without_parens()
        if shape == .Field(base, field, _) && field == "path" {
            if base.without_parens() == .Ident(name, span) && name == var {
                facts.allowed_path_bases.insert(span)
                facts.path_uses += 1
            }
        }
        if shape == .Ident(name, span) && name == var -> facts.variable_uses.push(span)
        if check_fallback && is_fallback_exit_expr(nested) -> facts.has_fallback_exit = true
    })
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:271
fn scan_lvalue(lvalue: &LValue, var: String, facts: &StmtLintFacts) {
    if lvalue == {
        .Local{..} -> {}
        .Index{base, index, ..} -> { scan_expr(base, var, facts, false); scan_expr(index, var, facts, false) }
        .Field{base, ..} -> scan_expr(base, var, facts, false)
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:282
fn scan_for_kind(kind: &ForKind, var: String, facts: &StmtLintFacts) {
    if kind == {
        .Range{start, end, step, ..} -> {
            scan_expr(start, var, facts, true)
            scan_expr(end, var, facts, true)
            if step == .Val(step) -> scan_expr(step, var, facts, true)
        }
        .In{collection, step} -> {
            scan_expr(collection, var, facts, true)
            if step == .Val(step) -> scan_expr(step, var, facts, true)
        }
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:302
fn scan_body(body: &[Stmt], var: String, facts: &StmtLintFacts) {
    for stmt in body -> scan_stmt_exprs(stmt, var, facts)
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:308
fn scan_stmt_exprs(stmt: &Stmt, var: String, facts: &StmtLintFacts) {
    if stmt == {
        .Expr(expr) -> scan_expr(expr, var, facts, true)
        .Val(binding) -> scan_expr(&binding.init, var, facts, true)
        .Assign{target, value, ..} -> { scan_lvalue(target, var, facts); scan_expr(value, var, facts, true) }
        .Return(value, ..) -> { if value == .Val(value) -> scan_expr(value, var, facts, true) }
        .While{cond, body, ..} -> { scan_expr(cond, var, facts, true); scan_body(&body, var, facts) }
        .For{kind, body, ..} -> { scan_for_kind(kind, var, facts); scan_body(&body, var, facts) }
        .Switch{subject, arms, else_body, ..} | .ComptimeSwitch{subject, arms, else_body, ..} -> {
            scan_expr(subject, var, facts, false)
            for arm in &arms { scan_expr(&arm.cond, var, facts, true); scan_body(&arm.body, var, facts) }
            if else_body == .Val(body) -> scan_body(&body, var, facts)
        }
        .BreakValue(value, ..) | .Yield(value, ..) | .BreakLabelValue(_, _, value, ..) -> scan_expr(value, var, facts, true)
        .Loop{body, ..} | .Reactive{body, ..} | .Shield{body, ..} | .Switched{body, ..} |
        .Region{body, ..} | .Policy{body, ..} | .ComptimeBlock{body, ..} | .Live{body, ..} |
        .Transact{body, ..} | .Layout{body, ..} | .AuthorityScope{body, ..} -> scan_body(&body, var, facts)
        .CountedLoop{init, cond, step, body, ..} -> {
            scan_expr(&init.init, var, facts, true)
            scan_expr(cond, var, facts, true)
            if step == .Val(step) -> scan_stmt_exprs(step, var, facts)
            scan_body(&body, var, facts)
        }
        .Unsafe{audit_expr, body, ..} | .Impure{reason_expr: audit_expr, body, ..} -> {
            if audit_expr == .Val(expr) -> scan_expr(expr, var, facts, false)
            scan_body(&body, var, facts)
        }
        .TaskGroup{limit, body, ..} -> {
            if limit == .Val(limit) -> scan_expr(limit, var, facts, true)
            scan_body(&body, var, facts)
        }
        .ComptimeIf{cond, then_body, else_body, ..} -> {
            scan_expr(cond, var, facts, true)
            scan_body(&then_body, var, facts)
            if else_body == .Val(body) -> scan_body(&body, var, facts)
        }
        .ContextBlock{fields, body, ..} -> {
            for (_, value, _) in &fields -> scan_expr(value, var, facts, false)
            scan_body(&body, var, facts)
        }
        .AssumeDet{reason_expr, body, ..} -> { scan_expr(reason_expr, var, facts, false); scan_body(&body, var, facts) }
        .ScopeMember{args, body, ..} -> {
            for arg in &args -> scan_expr(arg, var, facts, false)
            scan_body(&body, var, facts)
        }
        .DeferClose{close, ..} -> scan_expr(close, var, facts, true)
        .Break(..) | .Continue(..) | .BreakLabel(..) | .ContinueLabel(..) -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:434
fn stmt_has_structural_control_flow(stmt: &Stmt) -> Bool {
    if stmt == {
        .Return(..) | .Break(..) | .BreakValue(..) | .Continue(..) | .BreakLabel(..) |
        .BreakLabelValue(..) | .ContinueLabel(..) | .Yield(..) | .While{..} |
        .For{..} | .Loop{..} | .CountedLoop{..} | .Switch{..} | .ComptimeSwitch{..} |
        .ComptimeIf{..} | .TaskGroup{..} -> true
        .Unsafe{body, ..} | .Impure{body, ..} | .Reactive{body, ..} | .Shield{body, ..} |
        .Switched{body, ..} | .Region{body, ..} | .Policy{body, ..} | .ComptimeBlock{body, ..} |
        .ContextBlock{body, ..} | .AuthorityScope{body, ..} | .Live{body, ..} |
        .AssumeDet{body, ..} | .Transact{body, ..} | .ScopeMember{body, ..} |
        .Layout{body, ..} -> body.iter().any(fn(stmt) { stmt_has_structural_control_flow(stmt) })
        .Expr(..) | .Val(..) | .Assign{..} | .DeferClose{..} -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:471
fn is_fallback_exit_expr(expr: &Expr) -> Bool {
    if expr == {
        .OrFallback{..} | .Try(..) | .Todo{..} -> true
        .Call(call) -> call.name == jet_syntax.BUILTIN_PANIC
        _ -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:482
fn ascii_ladder(stmts: &[Stmt], index: USize) -> (&Binding, Bool, USize)? {
    stmt :: stmts.get(index) ?? return None
    binding :: if stmt == .Val(binding) -> binding else -> return None
    if binding.name.is_empty() || binding.pattern.is_some() || binding.is_comptime -> return None
    lower := None
    last_end := binding.init.span().end
    for offset in 0..26 {
        assignment :: stmts.get(index + offset + 1) ?? return None
        if assignment == .Assign{target: .Local{name, ..}, op: .None, value, ..} {
            if name != binding.name -> return None
            (from, to) :: ascii_replace(value, binding.name) ?? return None
            upper :: Char.from_u8(U8{65} + U8.from_usize(offset))
            lower_char :: Char.from_u8(U8{97} + U8.from_usize(offset))
            this_lower :: if from == upper && to == lower_char -> true else if from == lower_char && to == upper -> false else -> return None
            if lower == .Val(previous) {
                if previous != this_lower -> return None
            } else -> lower = Val(this_lower)
            last_end = value.span().end
        } else -> return None
    }
    Val((binding, lower ?? return None, last_end))
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:526
fn ascii_replace(expr: &Expr, binding: String) -> (Char, Char)? {
    if expr.without_parens() == .MethodCall{receiver, method, args, ..} {
        if method != "replace" || args.len() != 2 || args.iter().any(fn(arg) { arg.label.is_some() || arg.spread }) -> return None
        if receiver.without_parens() == .Ident(name, _) && name == binding {
            return Val((single_literal(&args[0].expr) ?? return None, single_literal(&args[1].expr) ?? return None))
        }
    }
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/stdlib_lints.rs:549
fn single_literal(expr: &Expr) -> Char? {
    if expr.without_parens() == .Str(parts, _) && parts.len() == 1 {
        if parts[0] == .Lit(text) {
            chars := text.chars()
            character :: chars.next() ?? return None
            if chars.next().is_none() -> return Val(character)
        }
    }
    None
}

