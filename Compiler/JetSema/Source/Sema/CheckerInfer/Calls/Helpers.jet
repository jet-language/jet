use jet_foundation.[Diagnostic, Span]

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/helpers.rs:5
pub fn e1313(arg_ty_name: String, trait_name: String, param_name: String, fn_name: String, span: Span) -> Diagnostic {
    Diagnostic.error("E1313", "`{arg_ty_name}` doesn't implement `{trait_name}`",
        "`{param_name}: ...{trait_name}` checks every argument against `{trait_name}` — that's how `{fn_name}` accepts a mix of types safely",
        "implement `{trait_name}` for `{arg_ty_name}`'s type, or drop the value from this call",
        Val(span))
}

