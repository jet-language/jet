use jet_foundation.[Diagnostic, Span, AccessConvention, Expr, Type, Call, CallArg, StrPart, TEXT_NUL, OSPath]
use jet_foundation.Names.[member_name]
use jet_foundation.CoreModuleExports.[core_leaf_kind]
use jet_foundation.Syntax
use jet_sema.[Checker, ModuleState, foreign_managed_callback_lambda, foreign_thread_safe_lambda, e3403]
use jet_sema.Diagnostics.[private_item, soft_public_use, type_fix_hint, write_range_window_argument, is_clock_type, is_deterministic_clock_type, core_crypto_canonical_type, expiring_secret_loan_matches]
use jet_sema.FFI.[e3211, foreign_call_boundary_error, is_callback_boundary_param, cpp_callback_abi_type, callback_contract_error, e3203]
use jet_sema.CallBinder.[bind_params_from_sig, bind_call_args]
use jet_sema.Generics.[e0905]
use jet_sema.CheckerCoreLib.NetTextTime.[http_nominal_leaf]

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/imports.rs:10
fn imported_inline_member_name(target: &ModuleState, name: String) -> String? {
    (inline_module, item) := name.split_once('.')?
    canonical := target.code_modules.get(inline_module)?
    mangled := member_name(canonical, item)
    if target.funcs.contains_key(mangled) { Some(mangled) } else { None }
}

impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerCoreLib/imports.rs:24
    pub fn resolve_import_call_path(self: &Self, name: String) -> (String, Int, String)? {
        mut segments := name.split('.')
        alias := segments.next()?.to_string()
        mut module_idx := self.imports.get(alias)?
        mut member := segments.next()?
        loop {
            next := segments.next() ?? return Some((alias, module_idx, member.to_string()))
            module_idx = self.modules?.get(module_idx)?.imports.get(member)?
            member = next
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerCoreLib/imports.rs:46
    fn check_range_window_argument(self: &Self, callee: String, index: Int, arg: &CallArg) -> Unit {
        if arg.convention == AccessConvention.Write && arg.expr is Expr.Slice { .. }
            && !self.fixed_length_write_params.contains((callee, index)) {
            self.diags.push(write_range_window_argument(arg.span))
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerCoreLib/imports.rs:65
    pub fn infer_code_module_call(
        self: &Self, alias: String, mangled: String, alias_span: Span, span: Span,
        type_args: &[Type], args: &[CallArg], resolved_ret_out: &Type?
    ) -> Type? {
        member_prefix := member_name(alias, "")
        item := mangled.strip_prefix(member_prefix).unwrap_or(mangled).to_string() // #4303
        if self.inline_reexport_inline.get((alias, item)).cloned() is Some((real_alias, real_mangled)) {
            self.record_import_alias_reference(alias, alias_span)
            return self.infer_code_module_call(real_alias, real_mangled, alias_span, span, type_args, &args, &resolved_ret_out)
        }
        if self.inline_reexport_file.get((alias, item)).cloned() is Some((real_name, real_idx)) {
            self.record_import_alias_reference(alias, alias_span)
            return self.infer_import_call(alias, real_idx, real_name, alias_span, span, type_args, &args, &resolved_ret_out)
        }
        if self.inline_reexport_core.get((alias, item)).cloned() is Some((module, real_item)) {
            self.record_import_alias_reference(alias, alias_span)
            ret := self.infer_core_call(module, real_item, Some(alias), alias_span, span, type_args, &args, &resolved_ret_out)
            if resolved_ret_out.is_none() { resolved_ret_out = ret.clone() }
            return ret
        }
        sig := self.funcs.get(mangled).cloned() ?? {
            self.diags.push(Diagnostic.error("E0608",
                "`{item}` is not defined in module `{alias}`",
                "check the module body for the function you're calling",
                "make sure the function name is spelled correctly", Some(alias_span)))
            for a in args.iter_mut() { _ :: self.infer(&a.expr) }
            return None
        }
        if sig.deprecation is Some(dep) { self.check_deprecation(item, dep, span) }
        self.check_foreign_transaction_call(sig, item, span)
        if foreign_call_boundary_error(sig, item, self.in_unsafe, span) is Some(diagnostic) {
            self.diags.push(diagnostic)
        }
        self.record_current_function_reference(mangled, span)
        self.record_edge(mangled, span)
        if self.code_module_identities.get(alias).cloned() is Some(identity) {
            self.record_semantic_reference(alias_span, identity.clone())
            self.record_semantic_reference(span, "fn:{identity}::{item}")
        }
        if !self.name_ledger.exported(self.module_idx, mangled) {
            self.diags.push(Diagnostic.error("E0609", "`{item}` is private in module `{alias}`",
                "only `pub` items in an inline module are reachable from outside it",
                "add `pub` before `fn {item}` in module `{alias}`", Some(alias_span)))
            for a in args.iter_mut() { _ :: self.infer(&a.expr) }
            return None
        }
        self.record_import_alias_reference(alias, alias_span)
        if Syntax.classify_identifier(item) == Syntax.IdentifierClass.SoftPublic {
            self.diags.push(soft_public_use(item, span))
        }
        params := bind_params_from_sig(sig)
        if bind_call_args(item, params, &args, span, &self.diags).is_none() {
            for arg in args.iter_mut() { _ :: self.infer(&arg.expr) }
            (_, return_type) := self.checked_return_types(sig.return_type.clone(), sig.is_extern)
            return Some(return_type)
        }
        self.register_binder_refs(args)
        if sig.param_variadic.last().copied().unwrap_or(false) && sig.variadic_bounds.is_none() {
            mut normalized := Call { name: item, name_span: span, type_args: type_args.to_vec(),
                args: ^args, resolved_ret: None, range_checked: false, widen_approx: false }
            args = []
            self.normalize_variadic_call(&normalized, sig)
            args = ^normalized.args
        }
        if args.len() != sig.params.len() {
            plural := if sig.params.len() == 1 { "" } else { "s" }
            self.diags.push(Diagnostic.error("E0104",
                "`{item}` expects {sig.params.len()} argument{plural}, got {args.len()}",
                "every argument must match a parameter",
                "check the definition of `{item}` in module `{alias}`", Some(span)))
        }
        type_params := self.trait_reg.fn_params.get(mangled).cloned().unwrap_or_default()
        mut subst: [String: Type] := [:]
        mut call_access := self.call_access_frame()
        mut pre_inferred: [Type?] := []
        if !type_args.is_empty() {
            if type_params.is_empty() {
                self.diags.push(Diagnostic.error("E0119", "`{alias}.{item}` is not generic",
                    "only functions declared with type parameters accept call-site type arguments",
                    "call {alias}.{item}(...) without type arguments", Some(span)))
            } else if type_args.len() != type_params.len() {
                plural := if type_params.len() == 1 { "" } else { "s" }
                self.diags.push(Diagnostic.error("E0119",
                    "`{alias}.{item}` expects {type_params.len()} type argument{plural}, got {type_args.len()}",
                    "a generic call must provide one type for every declared type parameter",
                    "write {alias}.{item}<…>(...) with the declared types", Some(span)))
            } else {
                for (param, actual_type) in type_params.iter().zip(type_args) {
                    actual := self.resolve_type(actual_type.clone())
                    if !actual.is_never() { self.check_declared_type(actual, span) }
                    for bound in param.bounds {
                        if !self.type_satisfies_bound(actual, bound) {
                            self.diags.push(e0905(actual.name(), bound, span, false))
                        }
                    }
                    subst.insert(param.name.clone(), actual)
                }
            }
        } else if !type_params.is_empty() {
            inference := self.infer_generic_call_args(sig, type_params, &args, &call_access, span, true)
            if inference.complete {
                failure := type_params.iter().find_map(|param| {
                    ty := inference.subst.get(param.name)?
                    param.bounds.iter().find(|bound| !self.type_satisfies_bound(ty, bound)).map(|bound| (ty, bound))
                })
                if failure is Some((ty, bound)) { self.diags.push(e0905(ty.name(), bound, span, false)) }
            }
            pre_inferred = ^inference.pre_inferred
            subst = ^inference.subst
        }
        effective_params := sig.params.iter().map(|(conv, ty)| (conv, self.trait_reg.instantiate_type(ty, subst))).collect()
        for (index, (arg, (pconv, pty))) in args.iter_mut().zip(effective_params.iter()).enumerate() {
            self.check_range_window_argument(mangled, index, arg)
            if pconv == AccessConvention.Read && !pty.is_scalar() { self.borrow_ctx = true }
            saved := self.expected_type.clone()
            self.expected_type = Some(pty.clone())
            aty := pre_inferred.get(index).cloned().unwrap_or_else(|| {
                self.with_call_access(&call_access, |checker| {
                    checker.check_call_argument_access(arg, pconv, pty, true)
                    inferred := checker.infer(&arg.expr)
                    checker.check_call_argument_captures(arg.expr)
                    inferred
                })
            })
            self.expected_type = saved
            if aty is Some(actual) {
                widened := self.widen_numeric_argument(&arg.expr, actual, pty, pconv)
                lifted := self.lift_optional_argument(&arg.expr, widened, pty, pconv)
                arg_span := arg.expr.span()
                if sig.is_pure && is_clock_type(pty) && !is_deterministic_clock_type(lifted) {
                    self.diags.push(e3403("an unproven Clock passed to pure `{item}`", Some(arg_span)))
                }
                _ :: self.check_type_assignable(pty, lifted, arg_span)
            }
            self.check_write_arg_change(arg)
        }
        declared := sig.return_type.clone().map(|return_type| self.trait_reg.instantiate_type(return_type, subst))
        (resolved_ret, ret) := self.checked_return_types(declared, sig.is_extern)
        resolved_ret_out = Some(resolved_ret)
        // Nested argument calls may have left their own inferred type arguments.
        self.inferred_call_type_args = if type_args.is_empty() && !type_params.is_empty() {
            type_params.iter().map(|param| subst.get(param.name).cloned()).collect()
        } else { None }
        Some(ret)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerCoreLib/imports.rs:379
    pub fn infer_import_call(
        self: &Self, alias: String, mod_idx: Int, name: String, alias_span: Span, span: Span,
        type_args: &[Type], args: &[CallArg], resolved_ret_out: &Type?
    ) -> Type? {
        self.infer_import_call_with_warning(alias, mod_idx, name, alias_span, span, type_args, &args, &resolved_ret_out, true)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerCoreLib/imports.rs:395
    fn infer_import_call_with_warning(
        self: &Self, alias: String, mod_idx: Int, name: String, alias_span: Span, span: Span,
        type_args: &[Type], args: &[CallArg], resolved_ret_out: &Type?, warn_soft_public: Bool
    ) -> Type? {
        mods := self.modules ?? return None
        target := mods[mod_idx]
        semantic_name := imported_inline_member_name(target, name).unwrap_or_else(|| name.to_string())
        if target.reexports.get(name) is Some((real_name, real_idx)) {
            if warn_soft_public && mod_idx != self.module_idx && Syntax.classify_identifier(name) == Syntax.IdentifierClass.SoftPublic {
                self.diags.push(soft_public_use(name, span))
            }
            return self.infer_import_call_with_warning(alias, real_idx, real_name.clone(), alias_span, span, type_args, &args, &resolved_ret_out, false)
        }
        if !target.funcs.contains_key(semantic_name) {
            owner := self.name_ledger.namespace_siblings(mod_idx).into_iter().find(|sibling| mods[sibling].funcs.contains_key(name))
            if owner is Some(owner_idx) {
                return self.infer_import_call_with_warning(alias, owner_idx, name, alias_span, span, type_args, &args, &resolved_ret_out, warn_soft_public)
            }
        }
        if target.funcs.contains_key(semantic_name) {
            is_pub := self.name_ledger.visible(self.module_idx, mod_idx, semantic_name)
            if !is_pub && mod_idx != self.module_idx {
                self.diags.push(private_item(name, span))
                for a in args.iter_mut() { _ :: self.infer(&a.expr) }
                return None
            }
            self.record_import_alias_reference(alias, alias_span)
            if warn_soft_public && mod_idx != self.module_idx && is_pub && Syntax.classify_identifier(name) == Syntax.IdentifierClass.SoftPublic {
                self.diags.push(soft_public_use(name, span))
            }
            mut sig := target.funcs.get(semantic_name).unwrap().clone()
            self.qualify_builtin_shadowing_sig(mod_idx, &sig)
            if sig.deprecation is Some(dep) { self.check_deprecation(name, dep, span) }
            self.check_foreign_transaction_call(sig, name, span)
            if foreign_call_boundary_error(sig, name, self.in_unsafe, span) is Some(diagnostic) {
                self.diags.push(diagnostic)
            }
            params := bind_params_from_sig(sig)
            if bind_call_args(name, params, &args, span, &self.diags).is_none() {
                for arg in args.iter_mut() { _ :: self.infer(&arg.expr) }
                (_, return_type) := self.checked_return_types(sig.return_type.clone(), sig.is_extern)
                return Some(return_type)
            }
            self.register_binder_refs(args)
            if sig.param_variadic.last().copied().unwrap_or(false) && sig.variadic_bounds.is_none() {
                mut normalized := Call { name: name, name_span: span, type_args: type_args.to_vec(),
                    args: ^args, resolved_ret: None, range_checked: false, widen_approx: false }
                args = []
                self.normalize_variadic_call(&normalized, sig)
                args = ^normalized.args
            }
            mut call_access := self.call_access_frame()
            type_params := target.trait_reg.fn_params.get(semantic_name).cloned().unwrap_or_default()
            mut subst: [String: Type] := [:]
            mut pre_inferred: [Type?] := []
            if !type_args.is_empty() {
                if type_params.is_empty() {
                    self.diags.push(Diagnostic.error("E0119", "`{name}` is not generic",
                        "only functions declared with type parameters accept call-site type arguments",
                        "call {name}(...) without type arguments", Some(span)))
                } else if type_args.len() != type_params.len() {
                    plural := if type_params.len() == 1 { "" } else { "s" }
                    self.diags.push(Diagnostic.error("E0119",
                        "`{name}` expects {type_params.len()} type argument{plural}, got {type_args.len()}",
                        "a generic call must provide one type for every declared type parameter",
                        "write {name}<…>(...) with the declared types", Some(span)))
                } else {
                    for (param, actual_type) in type_params.iter().zip(type_args) {
                        actual := self.resolve_type(actual_type.clone())
                        if !actual.is_never() { self.check_declared_type(actual, span) }
                        for bound in param.bounds {
                            if !self.type_satisfies_bound(actual, bound) { self.diags.push(e0905(actual.name(), bound, span, false)) }
                        }
                        subst.insert(param.name.clone(), actual)
                    }
                }
            } else if !type_params.is_empty() {
                inference := self.infer_generic_call_args(sig, type_params, &args, &call_access, span, !sig.is_extern)
                if inference.complete {
                    failure := type_params.iter().find_map(|param| {
                        ty := inference.subst.get(param.name)?
                        param.bounds.iter().find(|bound| !self.type_satisfies_bound(ty, bound)).map(|bound| (ty, bound))
                    })
                    if failure is Some((ty, bound)) { self.diags.push(e0905(ty.name(), bound, span, false)) }
                }
                pre_inferred = ^inference.pre_inferred
                subst = ^inference.subst
            }
            canonical_core := |ty: Type| -> Type {
                ty.map_named_types(|qualified| {
                    (core_alias, leaf) := qualified.rsplit_once('.')?
                    module := target.core_imports.get(core_alias)?
                    if module != "core.crypto" && core_leaf_kind(module, leaf).is_some() { Some(leaf.to_string()) } else { None }
                })
            }
            qualify_unit := |ty: Type| -> Type {
                ty.map_named_types(|unit_name| {
                    if http_nominal_leaf(unit_name) is Some(leaf) { return Some(leaf.to_string()) }
                    // Native package paths are compared without lossy text conversion.
                    // GATE #4500: OSPath package identity.
                    target.registry.unit_fact(unit_name)
                        .filter(|fact| fact.dimension.is_some() && fact.package != OSPath.new("core.units"))
                        .map(|_| "{target.module_alias}.{unit_name}")
                })
            }
            effective_params := sig.params.iter().map(|(conv, ty)| {
                (conv, qualify_unit(canonical_core(self.trait_reg.instantiate_type(ty, subst))))
            }).collect()
            target_alias := target.module_alias.clone()
            self.record_edge("{target_alias}.{name}", span)
            self.record_function_reference(mod_idx, semantic_name, span)
            if args.len() != sig.params.len() {
                plural := if sig.params.len() == 1 { "" } else { "s" }
                self.diags.push(Diagnostic.error("E0104", "`{name}` expects {sig.params.len()} argument{plural}, got {args.len()}",
                    "every argument must match a parameter", "check the definition of `{name}` in the imported file", Some(span)))
            }
            for (index, (arg, (pconv, pty))) in args.iter_mut().zip(effective_params.iter()).enumerate() {
                if pconv == AccessConvention.Read && !pty.is_scalar() { self.borrow_ctx = true }
                if sig.is_c_abi && pty == Type.String {
                    if arg.expr is Expr.Str(parts, str_span) {
                        literal: String? := parts.iter().map(|part| {
                            match part { StrPart.Lit(text) -> Some(text.clone()), StrPart.Interp(..) -> None }
                        }).collect()
                        if literal.is_some_and(|text| text.contains(TEXT_NUL)) { self.diags.push(e3211(str_span)) }
                    }
                }
                self.check_range_window_argument(name, index, arg)
                saved := self.expected_type.clone()
                self.expected_type = Some(pty.clone())
                aty := pre_inferred.get(index).cloned().unwrap_or_else(|| {
                    self.with_call_access(&call_access, |checker| {
                        checker.check_call_argument_access(arg, pconv, pty, !sig.is_extern)
                        inferred := checker.infer(&arg.expr)
                        checker.check_call_argument_captures(arg.expr)
                        inferred
                    })
                })
                self.expected_type = saved
                if sig.is_pure && is_clock_type(pty) && aty.is_some_and(|ty| !is_deterministic_clock_type(ty)) {
                    self.diags.push(e3403("an unproven Clock passed to pure `{name}`", Some(arg.expr.span())))
                }
                if is_callback_boundary_param(sig.is_c_abi, pty) {
                    managed := sig.callback_transport.is_some_and(|transport| transport != "none")
                    safe := match arg.expr {
                        Expr.Ident(callback, _) -> self.callback_function_is_safe(callback) || aty.is_some_and(|ty| cpp_callback_abi_type(ty).is_some())
                        Expr.Lambda(lam) -> if managed { foreign_managed_callback_lambda(lam) } else { foreign_thread_safe_lambda(lam) }
                        _ -> false
                    }
                    metadata_complete := !managed || (sig.callback_plan_digest.is_some_and(|digest| !digest.is_empty())
                        && sig.callback_identity.is_some_and(|identity| !identity.is_empty())
                        && sig.foreign_effect_root == Some("FFI.C"))
                    if safe && metadata_complete {
                        arg.flags.c_callback_symbol = true
                        arg.flags.c_callback_function_key = match arg.expr {
                            Expr.Ident(callback, _) -> self.callback_function_key(callback)
                            Expr.Lambda(..) -> None
                            _ -> None
                        }
                        arg.flags.c_callback_managed = managed
                        arg.flags.c_callback_plan_digest = sig.callback_plan_digest.clone()
                        arg.flags.c_callback_identity = sig.callback_identity.clone()
                    } else {
                        self.diags.push(if managed && !metadata_complete {
                            callback_contract_error(pty, arg.expr.span())
                        } else { e3203(pty, arg.expr.span()) })
                    }
                }
                if aty is Some(actual) {
                    widened := self.widen_numeric_argument(&arg.expr, actual, pty, pconv)
                    lifted := self.lift_optional_argument(&arg.expr, widened, pty, pconv)
                    arg_span := arg.expr.span()
                    loan_param_ty := match pty {
                        Type.Named(qualified) -> qualified.split_once('.').and_then(|(core_alias, leaf)| {
                            target.core_imports.get(core_alias).and_then(|module| {
                                if module == "core.crypto" && (leaf == "Secret" || leaf == "SigningKey" || leaf == "X25519SecretKey") {
                                    Some(core_crypto_canonical_type(leaf))
                                } else { None }
                            })
                        }).unwrap_or_else(|| pty.clone())
                        _ -> pty.clone()
                    }
                    reads_expiring_secret_loan := pconv == AccessConvention.Read && arg.convention == AccessConvention.Read
                        && expiring_secret_loan_matches(loan_param_ty, lifted)
                    reported := reads_expiring_secret_loan || self.check_type_assignable(pty, lifted, arg_span)
                    if !reported && lifted != pty && !reads_expiring_secret_loan {
                        self.diags.push(Diagnostic.error("E0112", "`{name}` wants {pty.show()} here, but this is {lifted.show()}",
                            "every argument must match its parameter's type", type_fix_hint(pty, lifted), Some(arg_span)))
                    }
                }
                if arg.expr is Expr.Ident(n, nspan) {
                    match (pconv, arg.convention) {
                        (AccessConvention.Move, AccessConvention.Move) -> {
                            if !pty.is_scalar() { self.mark_moved_by(n.clone(), nspan, name) }
                        }
                        (AccessConvention.Move, AccessConvention.Read) -> {
                            if !pty.is_scalar() { arg.flags.implicit_clone = true }
                        }
                        (AccessConvention.Write, AccessConvention.Read) -> {
                            self.diags.push(Diagnostic.error("E0202",
                                "parameter `{n}` requires the write-access marker `&` at the call site",
                                "`{name}` needs to edit this value with the write-access marker `&`; passing it without that marker grants only read access",
                                "write the write-access marker `&` (`{Syntax.SIGIL_WRITE}{n}`) when calling `{name}`", Some(nspan)))
                        }
                        _ -> {}
                    }
                }
                self.check_write_arg_change(arg)
            }
            declared := sig.return_type.clone().map(|return_type| canonical_core(self.trait_reg.instantiate_type(return_type, subst)))
            (resolved_ret, effective_ret) := self.checked_return_types(declared, sig.is_c_abi || sig.is_extern)
            resolved_ret_out = Some(qualify_unit(resolved_ret.clone()))
            // Qualified C ABI calls expose the declared ABI, not the hidden carrier.
            ret := if sig.is_c_abi || sig.is_extern { resolved_ret } else { effective_ret }
            self.inferred_call_type_args = if type_args.is_empty() && !type_params.is_empty() {
                type_params.iter().map(|param| subst.get(param.name).cloned()).collect()
            } else { None }
            return Some(qualify_unit(ret))
        }
        if target.registry.contains(semantic_name) {
            is_pub := self.type_is_pub_in(mod_idx, semantic_name)
            if !is_pub && mod_idx != self.module_idx {
                self.diags.push(private_item(name, span))
            } else {
                self.diags.push(Diagnostic.error("E0102", "nothing named `{name}` exists in this import",
                    "only `pub` functions and types from the other file are reachable here",
                    "check the spelling, or mark the item `pub` in its file", Some(span)))
            }
        } else {
            self.diags.push(Diagnostic.error("E0102", "nothing named `{name}` exists in this import",
                "only `pub` functions and types from the other file are reachable here",
                "check the spelling, or mark the item `pub` in its file", Some(alias_span)))
        }
        for a in args.iter_mut() { _ :: self.infer(&a.expr) }
        None
    }
}
