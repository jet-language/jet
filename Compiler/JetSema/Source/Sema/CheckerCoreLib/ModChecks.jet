use jet_foundation.[Span, Type, CallArg]
use jet_sema.[Checker, Effect]
use jet_sema.CheckerCoreLib.[result_ty, wrong_core_arity]
impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerCoreLib/mod_checks.rs:12
    pub fn check_mod_method(self: &Self, method: String, args: &[CallArg], span: Span) -> Type?? Never! {
        if method != "on_tick" -> return None
        if args.len() != 1 {
            &self.diags.push(wrong_core_arity("Mod.on_tick", 1, args.len(), span))
            loop arg in &args -> _ :: &self.infer(&arg.expr)
        } else { &self.expect_core_arg("Mod.on_tick", 0, Type.Int, &args[0]) }
        &self.record_effect(Effect.Exec.name(), span)
        Val(Val(result_ty(Type.Int, Type.String)))
    }
}
