use jet_foundation.[FailureContract, Func, Type, Diagnostic, Span, Syntax]
use jet_sema.[TraitRegistry]
use jet_sema.CheckerCoreLib.[is_encodable_ty, is_decodable_ty]
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/server_functions.rs:9
fn wire_type_ok(ty: Type, reg: TraitRegistry) -> Bool Never! {
    if ty == {
        .Result(ok, err) -> is_encodable_ty(ok, reg) && is_decodable_ty(ok, reg) && is_encodable_ty(err, reg) && is_decodable_ty(err, reg)
        else -> is_encodable_ty(ty, reg) && is_decodable_ty(ty, reg)
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/server_functions.rs:21
fn wire_error(function: Func, direction: String, ty: Type, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E2411", "server function `{function.name}` {direction} type `{ty.show()}` is not serializable", "server functions cross a checked JSON boundary for both scripted calls and native forms", "derive Encode and Decode for the type, or use a supported wire type", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/server_functions.rs:47
pub fn validate_server_function_boundary(function: Func, reg: TraitRegistry) -> [Diagnostic] Never! {
    diagnostics := [Diagnostic]{}
    loop parameter in function.params {
        if parameter.name != Syntax.KW_SELF && !wire_type_ok(parameter.ty, reg) -> &diagnostics.push(wire_error(function, "input", parameter.ty, parameter.ty_span))
    }
    if function.failure_contract() == {
        .Default(success, error) | .Explicit(success, error) | .Inferred(success, error) -> {
            if !wire_type_ok(success, reg) -> &diagnostics.push(wire_error(function, "output", success, function.return_type_span ?? function.name_span))
            if !wire_type_ok(error, reg) -> &diagnostics.push(wire_error(function, "error", error, function.return_type_span ?? function.name_span))
        }
        .Optional(success) | .ProvenUnreachable(success) | .InferredNever(success) | .Converted(success, ..) -> {
            if !wire_type_ok(success, reg) -> &diagnostics.push(wire_error(function, "output", success, function.return_type_span ?? function.name_span))
        }
        .DeclaredNever -> {}
    }
    ^diagnostics
}
