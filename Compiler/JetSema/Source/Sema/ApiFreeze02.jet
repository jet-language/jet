//RS /// The API cache directory for a project (`<root>/.jet/cache/api/`), honouring the
//RS /// `JET_API_CACHE_DIR` test override (mirrors the schema cache override).
//RS pub fn api_cache_dir(project_root: &Path) -> PathBuf {
//RS     if let Some(override_dir) = jet_foundation::CheckReads::env_var("JET_API_CACHE_DIR") {
//RS         PathBuf::from(override_dir)
//RS     } else {
//RS         project_root
//RS             .join(Syntax::SOURCE_ROOT_DIR)
//RS             .join(Syntax::API_CACHE_SUBDIR)
//RS     }
//RS }
//RS 
//RS /// Load a package's frozen-API snapshot from disk, or `None` if no prior freeze.
//RS pub fn load_snapshot(project_root: &Path, package: &str) -> Option<ApiSnapshot> {
//RS     let path = api_cache_dir(project_root).join(format!("{}.api", package));
