// Translate in place: replace the //RS lines below with the 1:1 Jet port (keep `// Rust: <file>:<line>` anchors).
//RS //! S2/D-MEM1 (was c129/D-CAP4/D-CAP6/D-CAP8): snapshot a library target's
//RS //! public-fn surface into durable interface metadata, unconditionally on
//RS //! every publish — pub-metadata semver diffing (feeds E1218/E2601). The
//RS //! former `api: stable|explicit` opt-in gate and the capability-tier
//RS //! freeze/drift check (E0912, elevation-based) are retired: a param's sigil
//RS //! is decided at parse time and never drifts silently, so there is nothing
//RS //! left to freeze at that tier — only an ordinary public-signature diff.
//RS //!
//RS //! Format (std-only, lockfile-style — no serde, I6):
//RS //!
//RS //! ```text
//RS //! api_version = 3
//RS //! package = mathkit
//RS //! published_version = 1.2.0
//RS //! fn scale(v: &Vec3, factor: Float)
//RS //! fn length(v: Vec3) Float
//RS //! ```
//RS //!
//RS //! Each `fn` line is the canonical signature: every public function's
//RS //! parameter list carries its D-MEM1 sigil (`&`/`^`/`*`; plain read emits
//RS //! none) plus the return type. The struct/enum/trait surface is diffed
//RS //! separately by the SemVer API check (`Publish::diff_public_api`); this
//RS //! snapshot is the *function-signature* surface specifically.
//RS //!
//RS //! Lives at `.jet/cache/api/<package>.api` (committed, durable contract — the same
//RS //! discipline as the D-MIGRATE1 `#PublishedSchema` snapshot).
//RS 
//RS use crate::Sema::{inline_effect_key, EffectSet};
//RS use crate::Syntax;
//RS use crate::AST::{Func, Item, TraitMethodSig, Type};
//RS use std::collections::HashMap;
//RS use std::path::{Path, PathBuf};
//RS 
//RS pub const API_SNAPSHOT_VERSION: u32 = 3;
//RS 
//RS /// One frozen public function in a package's capability API.
//RS #[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord)]
//RS pub struct FrozenFn {
//RS     pub name: String,
//RS     /// The canonical capability signature, e.g. `fn scale(v: &Vec3, factor: Float)`.
//RS     /// Carries the resolved D-MEM1 sigils that the caller must honour.
//RS     pub signature: String,
//RS }
//RS 
