//RS 
//RS /// The combined capability digest of every frozen API in a project, sorted by
//RS /// package then signature. Folded into the package fingerprint (`Lock`) so a
//RS /// public capability change (read → `&`/`^`) shifts the lock hash even when
//RS /// the source tree hash otherwise matches. Empty when nothing is frozen.
//RS pub fn project_capability_digest(project_root: &Path) -> String {
//RS     let snaps = load_all_snapshots(project_root);
//RS     let mut parts = Vec::new();
//RS     for s in &snaps {
//RS         parts.push(format!("{}\n{}", s.package, s.capability_digest()));
//RS     }
//RS     parts.join("\n--\n")
//RS }
