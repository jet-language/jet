use core.text as units_unicode
use jet_foundation.[Span, name_find_bytes, name_intern, name_table]

// Rust Bundle/Units.rs::SourceMentions. Offsets are UTF-8 bytes, never
// String scalar indices. The source is indexed once, not once per catalog member.
struct SemaUnitSuffixMention {
    text: String
    from_span: Span?
    digit_span: Span?
}
struct SemaUnitSourceMentions {
    identifiers: [String:Span]
    unqualified: [String:Bool]
    suffixes: [SemaUnitSuffixMention]
}
// Rust `is_alphanumeric() || == '_'` on the scalar bytes[at..<end]; ASCII
// scalars are decided from the byte without building a String.
fn sema_units_ident(bytes: [U8], at: Int, end: Int) -> Bool Never! {
    byte :: bytes[at]
    if byte < (U8{128}) -> return byte == (U8{95}) || (byte >= (U8{48}) && byte <= (U8{57})) || (byte >= (U8{65}) && byte <= (U8{90})) || (byte >= (U8{97}) && byte <= (U8{122}))
    scalar :: String.from_bytes(bytes[at..<end]) ?? return false
    units_unicode.is_alphabetic(scalar) || units_unicode.is_numeric(scalar)
}
fn sema_units_ascii_digit(byte: U8) -> Bool Never! {
    byte >= (U8{48}) && byte <= (U8{57})
}
fn sema_units_scalar_end(bytes: [U8], at: Int) -> Int Never! {
    end := at + 1
    loop end < bytes.len() && bytes[end] >= (U8{128}) && bytes[end] <= (U8{191}) -> end += 1
    end
}
fn sema_units_mention_suffix(rows: &[String:SemaUnitSuffixMention], bytes: [U8], start: Int, end: Int, from: Bool) Never! {
    if start == end -> return
    text :: String.from_bytes(bytes[start..<end]) ?? return
    row := rows.get(text) ?? SemaUnitSuffixMention{text: text, from_span: None, digit_span: None}
    if from && row.from_span == None -> row.from_span = Val(Span{start: start, end: end})
    if !from && row.digit_span == None -> row.digit_span = Val(Span{start: start, end: end})
    rows[text] = row
}
// Only identifiers named in `wanted` (the catalog's family names and member
// type names, the only names ever looked up) are indexed: the maps stay
// catalog-sized instead of holding every identifier of the source. The
// wanted names are interned once, so an identifier run is looked up by its
// bytes and only a wanted one is built as a String.
fn sema_units_source_mentions(source: String, wanted: [String:Bool]) -> SemaUnitSourceMentions Never! {
    bytes :: source.bytes()
    wanted_names := name_table()
    loop (name, _) in wanted -> _ := name_intern(&wanted_names, name)
    identifiers := [String:Span]{}
    unqualified := [String:Bool]{}
    suffixes := [String:SemaUnitSuffixMention]{}
    at := 0
    loop at < bytes.len() {
        end := sema_units_scalar_end(bytes, at)
        if !sema_units_ident(bytes, at, end) {
            at = end
            next
        }
        start :: at
        loop at < bytes.len() {
            end = sema_units_scalar_end(bytes, at)
            if !sema_units_ident(bytes, at, end) -> break
            at = end
        }
        if name_find_bytes(wanted_names, bytes, start, at) != None {
            run :: String.from_bytes(bytes[start..<at]) ?? ""
            if identifiers.get(run) == None -> identifiers[run] = Span{start: start, end: at}
            if (start == 0 || bytes[start - 1] != (U8{46})) && unqualified.get(run) == None -> unqualified[run] = true
        }
        // Every scalar start of the run, as the ident loop above visited them.
        offset := start
        loop offset < at {
            if offset > 0 && sema_units_ascii_digit(bytes[offset - 1]) && !sema_units_ascii_digit(bytes[offset]) -> sema_units_mention_suffix(&suffixes, bytes, offset, at, false)
            if offset + 5 <= at && bytes[offset] == (U8{102}) && bytes[offset + 1] == (U8{114}) && bytes[offset + 2] == (U8{111}) && bytes[offset + 3] == (U8{109}) && bytes[offset + 4] == (U8{95}) -> sema_units_mention_suffix(&suffixes, bytes, offset + 5, at, true)
            offset = sema_units_scalar_end(bytes, offset)
        }
    }
    sorted := [SemaUnitSuffixMention]{}
    loop (_, row) in suffixes -> &sorted.push(row)
    &sorted.sort_by((left: SemaUnitSuffixMention, right: SemaUnitSuffixMention) -> left.text <=> right.text)
    SemaUnitSourceMentions{identifiers: ^identifiers, unqualified: ^unqualified, suffixes: ^sorted}
}
fn sema_units_identifier(mentions: SemaUnitSourceMentions, name: String) -> Bool Never! {
    mentions.identifiers.get(name) != None
}
// Rust partition_point: the first suffix not less than the member.
fn sema_units_suffix_start(mentions: SemaUnitSourceMentions, member: String) -> Int Never! {
    low := 0
    high := mentions.suffixes.len()
    loop low < high {
        middle :: low + (high - low) /% 2
        if mentions.suffixes[middle].text < member {
            low = middle + 1
        } else {
            high = middle
        }
    }
    low
}
fn sema_units_member(mentions: SemaUnitSourceMentions, member: String) -> Bool Never! {
    if mentions.unqualified.get(sema_registration_unit_type_name(member)) != None -> return true
    at :: sema_units_suffix_start(mentions, member)
    at < mentions.suffixes.len() && mentions.suffixes[at].text.starts_with(member)
}
fn sema_units_identifier_span(mentions: SemaUnitSourceMentions, name: String) -> Span? {
    mentions.identifiers.get(name)
}
// Rust source_unit_member_span: whole type name, then earliest from_, then
// earliest digit suffix. Prefix suffix matches deliberately need no end boundary.
fn sema_units_member_span(mentions: SemaUnitSourceMentions, member: String) -> Span? {
    if mentions.identifiers.get(sema_registration_unit_type_name(member)) == .Val(span) -> return Val(span)
    from := Span?{None}
    digit := Span?{None}
    at := sema_units_suffix_start(mentions, member)
    loop at < mentions.suffixes.len() && mentions.suffixes[at].text.starts_with(member) {
        row :: mentions.suffixes[at]
        if row.from_span == .Val(span) {
            if from == None || span.start < (from ?? span).start -> from = Val(Span{start: span.start, end: span.start + member.bytes().len()})
        }
        if row.digit_span == .Val(span) {
            if digit == None || span.start < (digit ?? span).start -> digit = Val(Span{start: span.start, end: span.start + member.bytes().len()})
        }
        at += 1
    }
    if from != None -> from else -> digit
}
