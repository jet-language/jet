use {
    units_unicode: core.text
    jet_foundation.[NameTable, Span, name_find, name_find_bytes, name_index, name_intern_bytes, name_table_sized]
}

// Offsets are UTF-8 bytes, never String scalar indices. The source is indexed
// once, not once per catalog member.
SemaUnitSuffixMention: struct {
    text: String,
    from_span: Span?,
    digit_span: Span?,
}

// The wanted identifiers a source names (sema_units_source_mentions), by
// their id in `names`: `spans` holds each one's first span, and
// `unqualified` whether any mention of it is not after a `.`. Id 0, the
// empty name, is no identifier.
SemaUnitSourceMentions: struct {
    names: NameTable,
    spans: [Span],
    unqualified: [Bool],
    suffixes: [SemaUnitSuffixMention],
}

// The mentions of a source that names no catalog unit.
sema_units_mentions_empty: fn() -> SemaUnitSourceMentions Never! {
    SemaUnitSourceMentions{names: name_table_sized(2), spans: [Span]{Span{start: 0, end: 0}}, unqualified: [Bool]{false}, suffixes: [SemaUnitSuffixMention]{}}
}

// The id of identifier `name` among `mentions`, or None when the source
// doesn't name it.
sema_units_mention: fn(mentions: SemaUnitSourceMentions, name: String) -> Int? Never! {
    found: name_find(mentions.names, name) ?? return None
    id: name_index(found)
    if id == 0 -> None else -> Val(id)
}

// Rust `is_alphanumeric() || == '_'` on the scalar bytes[at..<end]; ASCII
// scalars are decided from the byte without building a String.
sema_units_ident: fn(bytes: [U8], at: Int, end: Int) -> Bool Never! {
    byte: bytes[at]
    if byte < (U8{128}) {
        return byte == (U8{95}) || (byte >= (U8{48}) && byte <= (U8{57})) || (byte >= (U8{65}) && byte <= (U8{90})) || (byte >= (U8{97}) && byte <= (U8{122}))
    }
    scalar: String.from_bytes(bytes[at..<end]) ?? return false
    units_unicode.is_alphabetic(scalar) || units_unicode.is_numeric(scalar)
}

sema_units_scalar_end: fn(bytes: [U8], at: Int) -> Int Never! {
    end := at + 1
    loop end < bytes.len() && bytes[end] >= (U8{128}) && bytes[end] <= (U8{191}) -> end += 1
    end
}

// A suffix is kept only when a catalog member name is a prefix of it: those
// are the only suffixes sema_units_member and sema_units_member_span read,
// and leaving the others out changes neither answer (the suffixes a member
// prefixes sit together in the sorted list).
sema_units_mention_suffix: fn(rows: &[String:SemaUnitSuffixMention], names: SemaUnitsCatalogNames, bytes: [U8], start: Int, end: Int, from: Bool) Never! {
    if start == end || !sema_units_member_prefixed(names, bytes, start, end) {
        return
    }
    text: String.from_bytes(bytes[start..<end]) ?? return
    row := rows.get(text) ?? SemaUnitSuffixMention{text: text, from_span: None, digit_span: None}
    if from && row.from_span == None -> row.from_span = Val(Span{start: start, end: end})
    if !from && row.digit_span == None -> row.digit_span = Val(Span{start: start, end: end})
    rows[text] = row
}

// Whether a catalog member name is a prefix of bytes[start..<end], looked up
// by its bytes for each member length.
sema_units_member_prefixed: fn(names: SemaUnitsCatalogNames, bytes: [U8], start: Int, end: Int) -> Bool Never! {
    loop length in names.member_lengths {
        if start + length > end -> return false
        if name_find_bytes(names.members, bytes, start, start + length) != None -> return true
    }
    false
}

// Only identifiers named in `names.wanted` (the catalog's family names and
// member type names, the only names ever looked up; sema_units_catalog_names)
// are indexed, and only suffixes a member name prefixes: the tables stay
// catalog-sized instead of holding every identifier of the source. An
// identifier run is looked up by its bytes and only a wanted one is interned.
// Each scan decides an ASCII byte in place (a scalar of one byte in
// valid UTF-8) and calls sema_units_scalar_end and sema_units_ident only for
// a scalar past ASCII.
sema_units_source_mentions: fn(source: String, names: SemaUnitsCatalogNames) -> SemaUnitSourceMentions Never! {
    bytes: source.bytes()
    count: bytes.len()
    identifiers := name_table_sized(16)
    spans := [Span]{Span{start: 0, end: 0}}
    unqualified := [Bool]{false}
    suffixes := [String:SemaUnitSuffixMention]{}
    at := 0
    loop at < count {
        byte: bytes[at]
        if byte < (U8{128}) {
            if !((byte >= (U8{97}) && byte <= (U8{122})) || byte == (U8{95}) || (byte >= (U8{65}) && byte <= (U8{90})) || (byte >= (U8{48}) && byte <= (U8{57}))) {
                at += 1
                next
            }
        } else {
            end: sema_units_scalar_end(bytes, at)
            if !sema_units_ident(bytes, at, end) {
                at = end
                next
            }
        }
        start: at
        needs_suffix_scan := false
        prev_digit := false
        loop at < count {
            run_byte: bytes[at]
            if run_byte < (U8{128}) {
                is_lower: run_byte >= (U8{97}) && run_byte <= (U8{122})
                is_digit: !is_lower && run_byte >= (U8{48}) && run_byte <= (U8{57})
                if !(is_lower || run_byte == (U8{95}) || (run_byte >= (U8{65}) && run_byte <= (U8{90})) || is_digit) {
                    break
                }
                if prev_digit && !is_digit -> needs_suffix_scan = true
                if run_byte == (U8{102}) && at + 4 < count && bytes[at + 1] == (U8{114}) && bytes[at + 2] == (U8{111}) && bytes[at + 3] == (U8{109}) && bytes[at + 4] == (U8{95}) {
                    needs_suffix_scan = true
                }
                prev_digit = is_digit
                at += 1
            } else {
                end: sema_units_scalar_end(bytes, at)
                if !sema_units_ident(bytes, at, end) -> break
                if prev_digit -> needs_suffix_scan = true
                prev_digit = false
                at = end
            }
        }
        run_len: at - start
        may_match := false
        if run_len >= names.wanted_min_len && run_len <= names.wanted_max_len {
            first: Int{bytes[start]}
            may_match = if {
                first < 64 -> (names.wanted_mask_lo & (1 << first)) != 0
                first < 128 -> (names.wanted_mask_hi & (1 << (first - 64))) != 0
                else -> names.wanted_non_ascii
            }
        }
        if may_match && name_find_bytes(names.wanted, bytes, start, at) != None {
            id: name_index(name_intern_bytes(identifiers, bytes, start, at))
            if id == spans.len() {
                spans.push(Span{start: start, end: at})
                unqualified.push(false)
            }
            if start == 0 || bytes[start - 1] != (U8{46}) -> unqualified[id] = true
        }
        // Every scalar start of the run, as the ident loop above visited them.
        if needs_suffix_scan {
            offset := start
            loop offset < at {
                here: bytes[offset]
                if offset > start && bytes[offset - 1] >= (U8{48}) && bytes[offset - 1] <= (U8{57}) && (here < (U8{48}) || here > (U8{57})) {
                    sema_units_mention_suffix(suffixes, names, bytes, offset, at, false)
                }
                if here == (U8{102}) && offset + 5 <= at && bytes[offset + 1] == (U8{114}) && bytes[offset + 2] == (U8{111}) && bytes[offset + 3] == (U8{109}) && bytes[offset + 4] == (U8{95}) {
                    sema_units_mention_suffix(suffixes, names, bytes, offset + 5, at, true)
                }
                offset = if here < (U8{128}) -> offset + 1 else -> sema_units_scalar_end(bytes, offset)
            }
        }
    }
    sorted := [SemaUnitSuffixMention]{}
    loop (_, row) in suffixes -> sorted.push(row)
    sorted.sort_by(fn(left: SemaUnitSuffixMention, right: SemaUnitSuffixMention) { left.text <=> right.text })
    SemaUnitSourceMentions{names: identifiers.move(), spans: spans.move(), unqualified: unqualified.move(), suffixes: sorted.move()}
}

sema_units_identifier: fn(mentions: SemaUnitSourceMentions, name: String) -> Bool Never! {
    sema_units_mention(mentions, name) != None
}

// Rust partition_point: the first suffix not less than the member.
sema_units_suffix_start: fn(mentions: SemaUnitSourceMentions, member: String) -> Int Never! {
    low := 0
    high := mentions.suffixes.len()
    loop low < high {
        middle: low + (high - low) /% 2
        if mentions.suffixes[middle].text < member -> low = middle + 1 else -> high = middle
    }
    low
}

// Whether the source mentions catalog member `member`, whose type name
// (sema_registration_unit_type_name) is `type_name`.
sema_units_member: fn(mentions: SemaUnitSourceMentions, member: String, type_name: String) -> Bool Never! {
    if sema_units_mention(mentions, type_name) == .Val(id) && mentions.unqualified[id] {
        return true
    }
    at: sema_units_suffix_start(mentions, member)
    at < mentions.suffixes.len() && mentions.suffixes[at].text.starts_with(member)
}

sema_units_identifier_span: fn(mentions: SemaUnitSourceMentions, name: String) -> Span? {
    id: sema_units_mention(mentions, name) ?? return None
    Val(mentions.spans[id])
}

// Rust source_unit_member_span: whole type name, then earliest from_, then
// earliest digit suffix. Prefix suffix matches deliberately need no end boundary.
// `type_name` is the member's type name (sema_registration_unit_type_name).
sema_units_member_span: fn(mentions: SemaUnitSourceMentions, member: String, type_name: String) -> Span? {
    if sema_units_mention(mentions, type_name) == .Val(id) -> return Val(mentions.spans[id])
    from := Span?{None}
    digit := Span?{None}
    at := sema_units_suffix_start(mentions, member)
    loop at < mentions.suffixes.len() && mentions.suffixes[at].text.starts_with(member) {
        row: mentions.suffixes[at]
        if row.from_span == .Val(span) {
            if from == None || span.start < (from ?? span).start {
                from = Val(Span{start: span.start, end: span.start + member.bytes().len()})
            }
        }
        if row.digit_span == .Val(span) {
            if digit == None || span.start < (digit ?? span).start {
                digit = Val(Span{start: span.start, end: span.start + member.bytes().len()})
            }
        }
        at += 1
    }
    if from != None -> from else -> digit
}
