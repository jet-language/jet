// (`expand_module_protocols`): a `protocol Name { … }` declares an ordered
// message exchange. Before registration it becomes two `#SingleUse` handle
// structs, `Name.Client` and `Name.Server`, with one state per exchange step,
// and `#State(A -> B)` impl methods: the sending side's `message(self, fields…)`
// and the receiving side's `recv_message(self)`. The fragment goes through the
// ordinary front end; one that does not parse is E0153 at the protocol's name.
use {
    jet_foundation.[
        Diagnostic,
        Func,
        Item,
        ProtocolDecl,
        ProtocolDirection,
        ProtocolMessage,
        type_name,
    ]
    jet_parser.[
        parse_source,
    ]
}

// The generated items enter just before their protocol declaration.
sema_protocols_expand: fn(items: &[Item], diagnostics: &[Diagnostic]) {
    has_protocol: loop item in items {
        if item == .ProtocolDecl(_) -> break true
    } ?? false
    if !has_protocol -> return
    expanded := [Item]{}
    loop item in items {
        if item == .ProtocolDecl(declaration) {
            parsed: parse_source(sema_protocol_source(declaration).bytes())
            if parsed.diagnostics.len() > 0 {
                diagnostics.push(sema_error("E0153", declaration.name_span, "protocol `{declaration.name}` failed to expand into handle types", "the compiler generates `#SingleUse` `.Client`/`.Server` stubs from the protocol block — a fragment did not parse", "check the protocol declaration for typos; if this persists, file a bug"))
            } else {
                generated := parsed.program.items
                sema_protocol_mark_generated(generated, declaration.name)
                loop value in generated -> expanded.push(value)
            }
        }
        expanded.push(item.copy())
    }
    loop items.len() > 0 -> _ := items.pop()
    loop item in expanded -> items.push(item)
}

// The generated transition methods are compiler scaffolding: they keep their
// declared returns raw. The fragment declares the handles by their leaf names
// (`Client: struct`); they take the protocol's qualified names
// (`Payment.Client`) here, because a written struct name is one identifier.
sema_protocol_mark_generated: fn(items: &[Item], protocol: String) Never! {
    loop index in 0..<items.len() {
        if items[index] == {
            .Impl(definition) -> {
                updated := definition
                sema_protocol_mark_methods(updated.methods)
                items[index] = Item.Impl{value: updated}
            }
            .Struct(definition) -> {
                updated := definition
                updated.name = "{protocol}.{definition.name}"
                sema_protocol_mark_methods(updated.methods)
                items[index] = Item.Struct{value: updated}
            }
            .Enum(definition) -> {
                updated := definition
                sema_protocol_mark_methods(updated.methods)
                items[index] = Item.Enum{value: updated}
            }
            else -> {}
        }
    }
}

sema_protocol_mark_methods: fn(methods: &[Func]) Never! {
    loop index in 0..<methods.len() {
        if methods[index].state_transition != None -> methods[index].compiler_generated = true
    }
}

sema_protocol_source: fn(declaration: ProtocolDecl) -> String Never! {
    client: "{declaration.name}.Client"
    server: "{declaration.name}.Server"
    states: loop index in 0..<(declaration.messages.len() + 1) -> "S{index}"
    state_list: states.join(", ")
    out := [String]{}
    out.push("#SingleUse Client: struct {{\n    state {{ {state_list} }}\n\n    _token: Int\n}}\n\n")
    out.push("#SingleUse Server: struct {{\n    state {{ {state_list} }}\n\n    _token: Int\n}}\n\n")
    out.push("impl {client} {{\n")
    out.push("    #State(_ -> S0) client: fn() -> {client} {{ {{_token: 0}} }}\n\n")
    loop (index, message) in declaration.messages {
        terminal: index + 1 == declaration.messages.len()
        if message.direction == ProtocolDirection.ClientToServer {
            out.push(sema_protocol_send_method(client, states, index, message, terminal))
        } else {
            out.push(sema_protocol_recv_method(client, states, index, message, terminal))
        }
    }
    out.push("}}\n\n")
    out.push("impl {server} {{\n")
    out.push("    #State(_ -> S0) server: fn() -> {server} {{ {{_token: 0}} }}\n\n")
    loop (index, message) in declaration.messages {
        terminal: index + 1 == declaration.messages.len()
        if message.direction == ProtocolDirection.ClientToServer {
            out.push(sema_protocol_recv_method(server, states, index, message, terminal))
        } else {
            out.push(sema_protocol_send_method(server, states, index, message, terminal))
        }
    }
    out.push("}}")
    out.join("")
}

sema_protocol_send_method: fn(handle: String, states: [String], index: Int, message: ProtocolMessage, terminal: Bool) -> String Never! {
    from: states[index]
    to: states[index + 1]
    fields: sema_protocol_fields(message)
    suffix: if fields == "" -> "" else -> ", {fields}"
    if terminal -> return "    #State({from} -> {to}) {message.name}: fn(self: &&{handle}{suffix}) {{}}\n\n"
    "    #State({from} -> {to}) {message.name}: fn(self: &&{handle}{suffix}) -> {handle} Err! {{ Ok(self) }}\n\n"
}

sema_protocol_recv_method: fn(handle: String, states: [String], index: Int, message: ProtocolMessage, terminal: Bool) -> String Never! {
    from: states[index]
    to: states[index + 1]
    if terminal -> return "    #State({from} -> {to}) recv_{message.name}: fn(self: &&{handle}) {{}}\n\n"
    "    #State({from} -> {to}) recv_{message.name}: fn(self: &&{handle}) -> {handle} Err! {{ Ok(self) }}\n\n"
}

sema_protocol_fields: fn(message: ProtocolMessage) -> String Never! {
    parts: loop field in message.fields -> "{field.name}: {type_name(field.ty)}"
    parts.join(", ")
}
