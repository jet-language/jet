// (`expand_module_protocols`): a `protocol Name { … }` declares an ordered
// message exchange. Before registration it becomes two `#SingleUse` handle
// structs, `Name.Client` and `Name.Server`, whose state list runs one step
// per message (`S0 -> S1`, …), and impl methods typed by those states: the
// sending side's `message(self: ^^Name.Client.S0, fields…) -> Name.Client.S1`
// and the receiving side's `recv_message(self)`. The fragment goes through the
// ordinary front end; one that does not parse is E0153 at the protocol's name.
use {
    jet_foundation.[
        Diagnostic,
        Func,
        Item,
        ProtocolDecl,
        ProtocolDirection,
        ProtocolMessage,
        Type,
        type_name,
    ]
    jet_parser.[
        parse_source,
    ]
}

// The generated items enter just before their protocol declaration.
sema_protocols_expand: fn(items: ^[Item], diagnostics: ^[Diagnostic]) {
    has_protocol: loop item in items {
        if item == .ProtocolDecl(_) {
            break true
        }
    } ?? false
    if !has_protocol {
        return
    }
    ^reversed: [Item]{}
    loop items.len() > 0 {
        if items.pop() == .Val(item) -> reversed.push(item)
    }
    loop reversed.len() > 0 {
        item: reversed.pop() ?? break
        if item == .ProtocolDecl(declaration) {
            parsed: parse_source(sema_protocol_source(declaration).bytes())
            if parsed.diagnostics.len() > 0 {
                diagnostics.push(sema_error("E0153", declaration.name_span, "protocol `{declaration.name}` failed to expand into handle types", "the compiler generates `#SingleUse` `.Client`/`.Server` stubs from the protocol block — a fragment did not parse", "check the protocol declaration for typos; if this persists, file a bug"))
            } else {
                ^generated: parsed.program.items
                sema_protocol_mark_generated(generated, declaration.name)
                // Written state types are rewritten before any module
                // registers; the generated handles name theirs here.
                ^owners: sema_state_types_owners()
                sema_state_types_collect(generated, owners)
                rewritten: sema_state_types_rewrite_items(generated, owners)
                loop value in rewritten.move() {
                    items.push(value)
                }
            }
        }
        items.push(item)
    }
}

// The generated methods are compiler scaffolding: they keep their declared
// returns raw. The fragment declares the handles by their leaf names
// (`Client: struct`); they take the protocol's qualified names
// (`Payment.Client`) here, because a written struct name is one identifier.
sema_protocol_mark_generated: fn(items: ^[Item], protocol: String) Never! {
    ^reversed: [Item]{}
    loop items.len() > 0 {
        if items.pop() == .Val(item) -> reversed.push(item)
    }
    loop reversed.len() > 0 {
        item: reversed.pop() ?? break
        is_impl: item == .Impl(_)
        is_struct: item == .Struct(_)
        is_enum: item == .Enum(_)
        if is_impl {
            if item.move() == .Impl(source_definition) {
                ^updated: source_definition.move()
                sema_protocol_mark_methods(updated.methods)
                items.push(Item.Impl{value: updated})
            }
        } else if is_struct {
            if item.move() == .Struct(source_definition) {
                ^updated: source_definition.move()
                updated.name = "{protocol}.{updated.name}"
                sema_protocol_mark_methods(updated.methods)
                items.push(Item.Struct{value: updated})
            }
        } else if is_enum {
            if item.move() == .Enum(source_definition) {
                ^updated: source_definition.move()
                sema_protocol_mark_methods(updated.methods)
                items.push(Item.Enum{value: updated})
            }
        } else {
            items.push(item)
        }
    }
}

sema_protocol_mark_methods: fn(methods: ^[Func]) Never! {
    loop index in 0..<methods.len() -> methods[index].compiler_generated = true
}

sema_protocol_source: fn(declaration: ProtocolDecl) -> String Never! {
    client: "{declaration.name}.Client"
    server: "{declaration.name}.Server"
    states: loop index in 0..<(declaration.messages.len() + 1) -> "S{index}"
    ^lines: [String]{}
    loop index in 0..<declaration.messages.len() {
        lines.push("        {states[index]} -> {states[index + 1]}\n")
    }
    lines.push("        {states[declaration.messages.len()]}\n")
    state_list: lines.join("")
    ^out: [String]{}
    out.push("#SingleUse Client: struct {{\n    state {{\n{state_list}    }}\n\n    _token: Int\n}}\n\n")
    out.push("#SingleUse Server: struct {{\n    state {{\n{state_list}    }}\n\n    _token: Int\n}}\n\n")
    out.push("impl {client} {{\n")
    out.push("    client: fn() -> {client}.S0 {{ {{_token: 0}} }}\n\n")
    loop (index, message) in declaration.messages {
        terminal: index + 1 == declaration.messages.len()
        if message.direction == ProtocolDirection.ClientToServer {
            out.push(sema_protocol_send_method(client, states, index, message, terminal))
        } else { out.push(sema_protocol_recv_method(client, states, index, message, terminal)) }
    }
    out.push("}}\n\n")
    out.push("impl {server} {{\n")
    out.push("    server: fn() -> {server}.S0 {{ {{_token: 0}} }}\n\n")
    loop (index, message) in declaration.messages {
        terminal: index + 1 == declaration.messages.len()
        if message.direction == ProtocolDirection.ClientToServer {
            out.push(sema_protocol_recv_method(server, states, index, message, terminal))
        } else { out.push(sema_protocol_send_method(server, states, index, message, terminal)) }
    }
    out.push("}}")
    out.join("")
}

sema_protocol_send_method: fn(handle: String, states: [String], index: Int, message: ProtocolMessage, terminal: Bool) -> String Never! {
    from: states[index]
    to: states[index + 1]
    fields: sema_protocol_fields(message)
    suffix: if fields == "" -> "" else -> ", {fields}"
    if terminal -> return "    {message.name}: fn(self: ^^{handle}.{from}{suffix}) {{}}\n\n"
    "    {message.name}: fn(self: ^^{handle}.{from}{suffix}) -> {handle}.{to} Err! {{ Ok(self) }}\n\n"
}

sema_protocol_recv_method: fn(handle: String, states: [String], index: Int, message: ProtocolMessage, terminal: Bool) -> String Never! {
    from: states[index]
    to: states[index + 1]
    if terminal -> return "    recv_{message.name}: fn(self: ^^{handle}.{from}) {{}}\n\n"
    "    recv_{message.name}: fn(self: ^^{handle}.{from}) -> {handle}.{to} Err! {{ Ok(self) }}\n\n"
}

sema_protocol_fields: fn(message: ProtocolMessage) -> String Never! {
    parts: loop field in message.fields -> "{field.name}: {type_name(field.ty)}"
    parts.join(", ")
}
