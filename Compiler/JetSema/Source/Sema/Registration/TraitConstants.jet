// Trait constants: a trait declares `name: Type` (with an optional default,
// `name: Type{value}`), each implementation supplies `name: value`, and a
// body reads `Type.name` on a concrete type or `T.name` on a bounded type
// parameter. A value is a literal, an enum case, a record of them, a list of
// them or an optional one, checked against the declared type here and stored
// on the implementation's checked row, so a read needs no code to run.
use jet_foundation.[CallArg, Diagnostic, Expr, ExprField, ImplConstValue, ModuleID, NodeKind, Span, StructDef, TComptimeEnumArg, TComptimeField, TComptimeReport, TComptimeValue, TTraitConstantValue, TraitConstDecl, TraitDef, TraitImplBlock, Type, UnOp, expr_span, type_name]

// What checking a trait constant's value found.
SemaTraitConstantEval: enum {
    Value(value: TComptimeValue)
    // A value of some other type.
    WrongType
    // Not a literal, an enum case, a record or a list of them.
    NotCompileTime
}

// The declaration of a record constant's type: the struct and the module it
// is written in, which its field types resolve in.
SemaTraitConstantRecord: struct {
    definition: StructDef
    module_identity: ModuleID
}

// One trait constant a read can name: its name, the trait's short name, the
// declared type resolved, and the value (None for a type parameter's bound,
// and when the implementation's value was reported already).
SemaTraitConstantFound: struct {
    name: String
    trait_name: String
    ty: Type
    value: TComptimeValue?
}

// Every constant of the traits the type whose nominal is `owner_row` and
// resolved name `owner` implements, with the value its implementation gives.
sema_trait_constants_of_type: fn(graph: SemaRegistrationGraph, owner_row: SemaRegistrationRowRef, owner: String) -> [SemaTraitConstantFound] Never! {
    found := [SemaTraitConstantFound]{}
    sema_trait_constant_collect_impls(graph, owner_row, owner, None, found)
    found
}

// The constants trait row `row` declares.
sema_trait_constants_declared: fn(graph: SemaRegistrationGraph, row: SemaRegistrationRowRef) -> [TraitConstDecl] Never! {
    item: sema_registration_nominal_source_item(graph.modules[row.module_index].nominals[row.row].source) ?? return [TraitConstDecl]{}
    if item == .Trait(definition) -> return definition.constants.copy()
    [TraitConstDecl]{}
}

// The checks of trait `definition` (declared in `module_identity`): each
// constant's name is its own, and each default is a value of its type.
sema_trait_constants_check_trait: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, definition: TraitDef, diagnostics: &[Diagnostic]) Never! {
    loop (index, constant) in definition.constants {
        loop earlier in 0..<index {
            if definition.constants[earlier].name == constant.name {
                diagnostics.push(sema_error("E0937", constant.name_span, "trait `{definition.name}` declares the constant `{constant.name}` twice", "a read `T.{constant.name}` names one constant of the trait", "remove one `{constant.name}` or rename it"))
                break
            }
        }
        loop method in definition.methods {
            if method.name == constant.name {
                diagnostics.push(sema_error("E0937", constant.name_span, "trait `{definition.name}` has a constant and a method both named `{constant.name}`", "`T.{constant.name}` would name both", "rename the constant or the method"))
                break
            }
        }
        value: constant.default ?? next
        ty: sema_checked_qualify_type(graph, constant.ty, module_identity)
        sema_trait_constant_report(sema_trait_constant_eval(graph, value, ty, module_identity, module_identity), constant.name, constant.ty, definition.name, expr_span(value), diagnostics)
    }
}

// The checked constants of an implementation of `trait_name` (None for an
// inherent impl) for `owner`, written in `module_identity`: each constant the
// trait declares, from the implementation's value or else the trait's
// default, in the trait's order. Reports a missing constant (E0933), a value
// of the wrong type (E0934) or not known at compile time (E0935), a constant
// the trait doesn't declare (E0936) and one given twice (E0937).
sema_trait_constants_check_impl: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, trait_name: String?, owner: String, constants: [ImplConstValue], type_span: Span, diagnostics: &[Diagnostic]) -> [TTraitConstantValue] Never! {
    checked := [TTraitConstantValue]{}
    loop (index, constant) in constants {
        loop earlier in 0..<index {
            if constants[earlier].name == constant.name {
                diagnostics.push(sema_error("E0937", constant.name_span, "the impl gives the constant `{constant.name}` twice", "an implementation has one value for each trait constant", "remove one `{constant.name}: …`"))
                break
            }
        }
    }
    name: trait_name ?? {
        loop constant in constants {
            diagnostics.push(sema_error("E0936", constant.name_span, "`impl {owner}` implements no trait, so it has no constant `{constant.name}`", "`name: value` gives a constant its trait declares", "move `{constant.name}` into the impl of the trait that declares it"))
        }
        return checked
    }
    // An unknown trait is reported where the impl names it.
    row: sema_checked_trait_nominal_row(graph, module_identity, name) ?? return checked
    trait_module: graph.modules[row.module_index].module_identity
    declared: sema_trait_constants_declared(graph, row)
    loop constant in constants {
        known := false
        loop declaration in declared {
            if declaration.name == constant.name {
                known = true
                break
            }
        }
        if !known {
            diagnostics.push(sema_error("E0936", constant.name_span, "`{constant.name}` is not a constant of `{name}`", "an implementation gives only the constants its trait declares", "remove `{constant.name}`, or declare `{constant.name}: Type` in `{name}`"))
        }
    }
    loop declaration in declared {
        ty: sema_checked_qualify_type(graph, declaration.ty, trait_module)
        given := -1
        loop (index, constant) in constants {
            if constant.name == declaration.name {
                given = index
                break
            }
        }
        if given >= 0 {
            result: sema_trait_constant_eval(graph, constants[given].value, ty, module_identity, trait_module)
            if result == .Value(value) {
                checked.push(TTraitConstantValue{name: declaration.name, ty: ty, value: value, span: constants[given].span})
            } else {
                sema_trait_constant_report(result, declaration.name, declaration.ty, name, expr_span(constants[given].value), diagnostics)
            }
            next
        }
        default_value: declaration.default ?? {
            diagnostics.push(sema_error("E0933", type_span, "`{owner}` implements `{name}` without its constant `{declaration.name}`", "`{name}` declares `{declaration.name}: {type_name(declaration.ty)}` with no default, so each implementation gives its value", "add `{declaration.name}: value` to the impl"))
            next
        }
        // A default that is not a value of its type is reported on the trait.
        if sema_trait_constant_eval(graph, default_value, ty, trait_module, trait_module) == .Value(value) {
            checked.push(TTraitConstantValue{name: declaration.name, ty: ty, value: value, span: declaration.span})
        }
    }
    checked
}

// The report of a trait constant value that is not one: E0934 for a value of
// another type, E0935 for one not known at compile time.
sema_trait_constant_report: fn(result: SemaTraitConstantEval, name: String, declared: Type, trait_name: String, span: Span, diagnostics: &[Diagnostic]) Never! {
    if result == {
        .Value(_) -> {}
        .WrongType -> diagnostics.push(sema_error("E0934", span, "the value of trait constant `{name}` is not of type `{type_name(declared)}`", "`{trait_name}` declares `{name}: {type_name(declared)}`, and each value has that type", "write a value of type `{type_name(declared)}`"))
        .NotCompileTime -> diagnostics.push(sema_error("E0935", span, "the value of trait constant `{name}` is not known at compile time", "a trait constant is read from its type without running code, so its value is a literal, an enum case or a list of them", "write the value as a literal, an enum case or a list literal"))
    }
}

// `expr` as a value of resolved type `ty`. Type names `expr` writes resolve
// in `module_identity`; `ty` was resolved in `type_module`.
sema_trait_constant_eval: fn(graph: SemaRegistrationGraph, expr: Expr, ty: Type, module_identity: ModuleID, type_module: ModuleID) -> SemaTraitConstantEval Never! {
    if expr == .Paren(inner, _, _) -> return sema_trait_constant_eval(graph, inner, ty, module_identity, type_module)
    if ty == {
        .Option(inner) -> return sema_trait_constant_eval_option(graph, expr, ty, inner, module_identity, type_module)
        .List(element) -> return sema_trait_constant_eval_list(graph, expr, ty, element, module_identity, type_module)
        .Named(name) -> {
            if sema_trait_constant_enum_variants(graph, type_module, name) == .Val(variants) -> return sema_trait_constant_eval_enum(graph, expr, name, variants, module_identity)
            if sema_trait_constant_record(graph, type_module, name) == .Val(record) -> return sema_trait_constant_eval_record(graph, expr, name, record, module_identity)
        }
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    literal: sema_trait_constant_literal(expr) ?? return sema_trait_constant_other(expr)
    fitted: sema_trait_constant_fit(literal, ty) ?? return SemaTraitConstantEval.WrongType
    SemaTraitConstantEval.Value{value: fitted}
}

// Why `expr`, which is no value of the expected type, fails: a literal or a
// list, enum or optional value is of another type; anything else is not
// known at compile time.
sema_trait_constant_other: fn(expr: Expr) -> SemaTraitConstantEval Never! {
    if sema_trait_constant_literal(expr) != None -> return SemaTraitConstantEval.WrongType
    if expr == {
        .ListLit(_, _, _) | .TypedLit(_, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Present(_, _, _) -> SemaTraitConstantEval.WrongType
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) -> SemaTraitConstantEval.NotCompileTime
    }
}

// `expr` as a scalar literal: an integer or float (negated or not), a Bool,
// a Char or a string without interpolation.
sema_trait_constant_literal: fn(expr: Expr) -> TComptimeValue? Never! {
    if expr == {
        .Int(value, _, _, _, _) -> return Val(TComptimeValue.Int{value: value})
        .Float(value, _, is_f32, _, _) -> return Val(TComptimeValue.Float{value: value, bits: if is_f32 -> 32 else -> 64})
        .Bool(value, _, _) -> return Val(TComptimeValue.Bool{value: value})
        .Char(value, _, _) -> {
            code: sema_checked_const_char(value) ?? return None
            return Val(TComptimeValue.Char{value: code})
        }
        .Str(parts, _, _) -> {
            text := ""
            loop part in parts {
                if part == .Lit(piece) {
                    text = "{text}{piece}"
                } else {
                    return None
                }
            }
            return Val(TComptimeValue.String{value: text})
        }
        .Unary(op, operand, _, _) -> {
            if op != UnOp.Neg -> return None
            if operand == {
                .Int(value, _, _, _, _) -> return Val(TComptimeValue.Int{value: 0 - value})
                .Float(value, _, is_f32, _, _) -> return Val(TComptimeValue.Float{value: 0.0 - value, bits: if is_f32 -> 32 else -> 64})
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
            }
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// Scalar `literal` as a value of `ty`, None when it is not one.
sema_trait_constant_fit: fn(literal: TComptimeValue, ty: Type) -> TComptimeValue? Never! {
    if literal == {
        .Int(value) -> {
            if ty == {
                .Int -> return Val(TComptimeValue.Int{value: value})
                .IntN(signed, bits) -> {
                    if sema_trait_constant_int_fits(value, signed, bits) -> return Val(TComptimeValue.Int{value: value})
                    return None
                }
                .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
            }
        }
        .Float(value, bits) -> {
            if ty == .Float && bits == 64 -> return Val(TComptimeValue.Float{value: value, bits: 64})
            if ty == .Float32 -> return Val(TComptimeValue.Float{value: value, bits: 32})
            return None
        }
        .Bool(value) -> return if ty == .Bool -> Val(TComptimeValue.Bool{value: value}) else -> None
        .Char(value) -> return if ty == .Char -> Val(TComptimeValue.Char{value: value}) else -> None
        .String(value) -> return if ty == .String -> Val(TComptimeValue.String{value: value.copy()}) else -> None
        .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit -> None
    }
}

// Whether `value` is in the range of the `bits`-wide integer.
sema_trait_constant_int_fits: fn(value: Int, signed: Bool, bits: Int) -> Bool Never! {
    if bits >= 64 -> return signed || value >= 0
    limit := 1
    width: if signed -> bits - 1 else -> bits
    loop _ in 0..<width -> limit = limit * 2
    if signed -> return value >= 0 - limit && value < limit
    value >= 0 && value < limit
}

// An optional constant: `None` is the clean failure of `ty`; `Val(x)` or a
// bare value is present.
sema_trait_constant_eval_option: fn(graph: SemaRegistrationGraph, expr: Expr, ty: Type, inner: Type, module_identity: ModuleID, type_module: ModuleID) -> SemaTraitConstantEval Never! {
    if expr == {
        .Absent(_, _) -> return SemaTraitConstantEval.Value{value: TComptimeValue.Failed{report: TComptimeReport.Clean{ty: ty.copy()}}}
        .Present(value, _, _) -> return sema_trait_constant_present(sema_trait_constant_eval(graph, value, inner, module_identity, type_module))
        .EnumLit(type_name, variant, _, args, _, _, _) -> {
            if type_name == "" && variant == "None" && args.len() == 0 -> return SemaTraitConstantEval.Value{value: TComptimeValue.Failed{report: TComptimeReport.Clean{ty: ty.copy()}}}
            if type_name == "" && variant == "Val" && args.len() == 1 {
                if args[0] == .Positional(value) -> return sema_trait_constant_present(sema_trait_constant_eval(graph, value, inner, module_identity, type_module))
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    sema_trait_constant_present(sema_trait_constant_eval(graph, expr, inner, module_identity, type_module))
}

sema_trait_constant_present: fn(result: &&SemaTraitConstantEval) -> SemaTraitConstantEval Never! {
    if result == .Value(value) -> return SemaTraitConstantEval.Value{value: TComptimeValue.Present{value: value.copy()}}
    result
}

// A list constant: `[a, b]` or `[T]{a, b}`, each element a value of `element`.
sema_trait_constant_eval_list: fn(graph: SemaRegistrationGraph, expr: Expr, ty: Type, element: Type, module_identity: ModuleID, type_module: ModuleID) -> SemaTraitConstantEval Never! {
    if expr == {
        .ListLit(values, _, _) -> return sema_trait_constant_eval_elements(graph, values, element, module_identity, type_module)
        .TypedLit(head, body, _, _) -> {
            if head == .Val(written) {
                written_type: sema_checked_qualify_type(graph, written, module_identity)
                if written_type != ty -> return SemaTraitConstantEval.WrongType
            }
            if body == {
                .Elements(values) -> return sema_trait_constant_eval_elements(graph, values, element, module_identity, type_module)
                .Empty -> return SemaTraitConstantEval.Value{value: TComptimeValue.List{values: [TComptimeValue]{}}}
                .Fields(_) | .Entries(_) | .Value(_) | .ByteText(_) -> return SemaTraitConstantEval.WrongType
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    sema_trait_constant_other(expr)
}

// Each of `values` as a value of `element`, the list of them.
sema_trait_constant_eval_elements: fn(graph: SemaRegistrationGraph, values: [Expr], element: Type, module_identity: ModuleID, type_module: ModuleID) -> SemaTraitConstantEval Never! {
    checked := [TComptimeValue]{}
    loop item in values {
        result: sema_trait_constant_eval(graph, item, element, module_identity, type_module)
        if result == .Value(value) {
            checked.push(value.copy())
        } else {
            return result
        }
    }
    SemaTraitConstantEval.Value{value: TComptimeValue.List{values: checked}}
}

// The cases without a payload of resolved enum type `name` (resolved in
// `type_module`); None when it names no enum.
sema_trait_constant_enum_variants: fn(graph: SemaRegistrationGraph, type_module: ModuleID, name: String) -> [String]? Never! {
    resolved: sema_type_graph_lookup_symbol(graph, type_module, name) ?? return None
    row: sema_type_graph_resolved_nominal_row(graph, resolved) ?? return None
    if graph.modules[row.module_index].nominals[row.row].kind != SemaRegistrationNominalKind.Enum -> return None
    names := [String]{}
    loop variant in graph.modules[row.module_index].nominals[row.row].variants {
        if variant.payload == .Unit -> names.push(variant.symbol.name.copy())
    }
    Val(names)
}

// The declaration of resolved struct type `name` (resolved in `type_module`);
// None when it names no struct, or a generic one, whose field types a
// constant's value alone does not fix.
sema_trait_constant_record: fn(graph: SemaRegistrationGraph, type_module: ModuleID, name: String) -> SemaTraitConstantRecord? Never! {
    resolved: sema_type_graph_lookup_symbol(graph, type_module, name) ?? return None
    row: sema_type_graph_resolved_nominal_row(graph, resolved) ?? return None
    item: sema_registration_nominal_source_item(graph.modules[row.module_index].nominals[row.row].source) ?? return None
    if item == .Struct(definition) {
        if definition.type_params.len() > 0 -> return None
        return Val(SemaTraitConstantRecord{definition: definition.copy(), module_identity: graph.modules[row.module_index].module_identity})
    }
    None
}

// A record constant: `Name{field: value, …}`, or `{field: value, …}` where
// the type is known. Each stored field is a value of its declared type; a
// field the value leaves out takes the default its declaration writes.
sema_trait_constant_eval_record: fn(graph: SemaRegistrationGraph, expr: Expr, name: String, record: SemaTraitConstantRecord, module_identity: ModuleID) -> SemaTraitConstantEval Never! {
    expected_type: Type.Named{name: name.copy()}
    written := [ExprField]{}
    if expr == {
        .StructLit(type_name, type_args, _, _, fields, _, _, _) -> {
            if type_args.len() > 0 -> return SemaTraitConstantEval.WrongType
            if type_name != "" && sema_checked_qualify_type(graph, Type.Named{name: type_name.copy()}, module_identity) != expected_type -> return SemaTraitConstantEval.WrongType
            written = fields.copy()
        }
        .TypedLit(head, body, _, _) -> {
            if head == .Val(head_type) {
                if sema_checked_qualify_type(graph, head_type, module_identity) != expected_type -> return SemaTraitConstantEval.WrongType
            }
            if body == {
                .Fields(fields) -> written = fields.copy()
                .Empty -> {}
                .Elements(_) | .Entries(_) | .Value(_) | .ByteText(_) -> return SemaTraitConstantEval.WrongType
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) -> return sema_trait_constant_other(expr)
    }
    loop field in written {
        known := false
        loop declared in record.definition.fields {
            if declared.name == field.name && declared.computed == None {
                known = true
                break
            }
        }
        if !known -> return SemaTraitConstantEval.WrongType
    }
    values := [TComptimeField]{}
    loop declared in record.definition.fields {
        if declared.computed != None -> next
        field_type: sema_checked_qualify_type(graph, declared.ty, record.module_identity)
        given := Expr?{None}
        loop field in written {
            if field.name == declared.name {
                given = Val(field.value.copy())
                break
            }
        }
        result := SemaTraitConstantEval.WrongType
        if given == .Val(value) {
            result = sema_trait_constant_eval(graph, value, field_type, module_identity, record.module_identity)
        } else if declared.default == .Val(default_value) {
            result = sema_trait_constant_eval(graph, default_value, field_type, record.module_identity, record.module_identity)
        }
        if result == .Value(value) {
            values.push(TComptimeField{name: declared.name.copy(), value: value.copy()})
        } else {
            return result
        }
    }
    SemaTraitConstantEval.Value{value: TComptimeValue.Struct{type_name: name.copy(), fields: values}}
}

// An enum constant: `.Case`, `Enum.Case` or `module.Enum.Case`, naming a
// case without a payload of enum `name`.
sema_trait_constant_eval_enum: fn(graph: SemaRegistrationGraph, expr: Expr, name: String, variants: [String], module_identity: ModuleID) -> SemaTraitConstantEval Never! {
    if expr == {
        .EnumLit(type_name, case_name, _, args, _, _, _) -> {
            if args.len() > 0 -> return SemaTraitConstantEval.NotCompileTime
            return sema_trait_constant_enum_case(graph, type_name, case_name, name, variants, module_identity)
        }
        .Field(base, member, _, _) -> {
            written: sema_trait_constant_type_path(base) ?? return SemaTraitConstantEval.NotCompileTime
            return sema_trait_constant_enum_case(graph, written, member, name, variants, module_identity)
        }
        .MethodCall(receiver, method, _, _, _, args, _) -> {
            return sema_trait_constant_rewrite(name, receiver, method, args) ?? SemaTraitConstantEval.NotCompileTime
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    sema_trait_constant_other(expr)
}

// `syntax.rewrite(callee: f, replacement: g)` as a `DiagnosticEdit`
// constant: the case `.Rewrite` with `f` and `g` as written, each a function
// name or a `module.name` path. Where the finding is reported
// (Calls/Build.jet sema_call_try_compiler_report) both resolve to functions
// and their types are compared. None for any other method call.
sema_trait_constant_rewrite: fn(name: String, receiver: Expr, method: String, args: [CallArg]) -> SemaTraitConstantEval? Never! {
    // `name` is resolved: Core's enum is `<corelib>/core.prelude::DiagnosticEdit`.
    if name != "DiagnosticEdit" && name != "<corelib>/core.prelude::DiagnosticEdit" -> return None
    if method != "rewrite" || !sema_trait_constant_is_syntax(receiver) -> return None
    callee := String?{None}
    replacement := String?{None}
    loop arg in args {
        label: arg.label ?? return None
        if arg.spread -> return None
        written: sema_trait_constant_callable_path(arg.expr) ?? return None
        if {
            label.name == "callee" && callee == None -> callee = Val(written)
            label.name == "replacement" && replacement == None -> replacement = Val(written)
            else -> return None
        }
    }
    from: callee ?? return None
    to: replacement ?? return None
    Val(SemaTraitConstantEval.Value{value: TComptimeValue.Enum{type_name: name.copy(), variant: "Rewrite", args: [TComptimeEnumArg]{
        TComptimeEnumArg{name: Val("callee"), value: TComptimeValue.String{value: from}},
        TComptimeEnumArg{name: Val("replacement"), value: TComptimeValue.String{value: to}},
    }}})
}

sema_trait_constant_is_syntax: fn(receiver: Expr) -> Bool Never! {
    if receiver == .Ident(written, _, _) -> return written == "syntax"
    false
}

// A function as `syntax.rewrite` names it: `name` or `module.name`.
sema_trait_constant_callable_path: fn(expr: Expr) -> String? Never! {
    if expr == .Ident(written, _, _) -> return Val(written.copy())
    if expr == .Field(base, member, _, _) {
        if base == .Ident(module_alias, _, _) -> return Val("{module_alias}.{member}")
    }
    None
}

// Case `variant` of the enum `written` names ("" for a leading-dot case) as
// a value of resolved enum `name`.
sema_trait_constant_enum_case: fn(graph: SemaRegistrationGraph, written: String, variant: String, name: String, variants: [String], module_identity: ModuleID) -> SemaTraitConstantEval Never! {
    if written != "" {
        written_type: sema_checked_qualify_type(graph, Type.Named{name: written.copy()}, module_identity)
        expected_type: Type.Named{name: name.copy()}
        if written_type != expected_type -> return SemaTraitConstantEval.WrongType
    }
    loop known in variants {
        if known == variant -> return SemaTraitConstantEval.Value{value: TComptimeValue.Enum{type_name: name.copy(), variant: variant.copy(), args: [TComptimeEnumArg]{}}}
    }
    SemaTraitConstantEval.WrongType
}

// The type `Enum` or `module.Enum` a case path's base writes.
sema_trait_constant_type_path: fn(base: Expr) -> String? Never! {
    if base == {
        .Ident(name, _, _) -> Val(name.copy())
        .Field(root, member, _, _) -> {
            if root == .Ident(module_alias, _, _) -> return Val("{module_alias}.{member}")
            None
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// `Type.member` or `T.member` reading a trait constant; unhandled when
// `member` names no trait constant of the type.
sema_expression_trait_constant: fn(type_name: String, member: String, member_span: Span, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if program.registration_graph == .Val(graph) -> return sema_expression_trait_constant_in(graph, type_name, member, member_span, span, expected, environment, program, scopes, context, diagnostics)
    SemaMethodSpecialCheck{handled: false, value: None}
}

sema_expression_trait_constant_in: fn(graph: SemaRegistrationGraph, type_name: String, member: String, member_span: Span, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    unhandled: SemaMethodSpecialCheck{handled: false, value: None}
    found := [SemaTraitConstantFound]{}
    generic := false
    loop parameter in environment.generic_params {
        if parameter.name != type_name -> next
        generic = true
        loop bound in parameter.bounds {
            row: graph.nominal_symbol_rows.get(bound.key) ?? next
            sema_trait_constant_collect(graph, row, graph.modules[row.module_index].module_identity, Val(member), None, found)
        }
    }
    if !generic {
        if sema_expression_type_symbol(scopes, environment, program, type_name) == None -> return unhandled
        resolved: sema_type_graph_lookup_symbol_at(graph, sema_scope_caller_row(environment, graph), type_name) ?? return unhandled
        owner_row: sema_type_graph_resolved_nominal_row(graph, resolved) ?? return unhandled
        owner: sema_trait_constant_head(sema_checked_qualify_type(graph, Type.Named{name: type_name.copy()}, environment.module_identity)) ?? return unhandled
        sema_trait_constant_collect_impls(graph, owner_row, owner, Val(member), found)
    }
    if found.len() == 0 -> return unhandled
    loop index in 1..<found.len() {
        if found[index].trait_name != found[0].trait_name {
            diagnostics.push(sema_error("E0937", member_span, "`{type_name}.{member}` names a constant of both `{found[0].trait_name}` and `{found[index].trait_name}`", "each of the two traits declares a constant `{member}`", "rename the constant in one of the traits"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    if generic {
        value: sema_node(context, found[0].ty, NodeKind.TraitConst{owner: Type.Named{name: type_name.copy()}, trait_name: found[0].trait_name.copy(), name: member.copy()}, span)
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
    }
    // The implementation's value was reported where the impl gives it.
    stored: found[0].value ?? return SemaMethodSpecialCheck{handled: true, value: None}
    value: sema_tree_node(found[0].ty, TExprKind.CtLit{value: stored.copy()}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

// The nominal name a resolved owner type heads.
sema_trait_constant_head: fn(ty: Type) -> String? Never! {
    if ty == {
        .Named(name) -> Val(name.copy())
        .Apply(name, _) -> Val(name.copy())
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// What follows the last `::` or `.` of a type name.
sema_trait_constant_leaf: fn(name: String) -> String Never! {
    if name.cut_last("::") == .Val(parts) -> return sema_trait_constant_leaf(parts.after)
    if name.cut_last(".") == .Val(parts) -> return parts.after.copy()
    name.copy()
}

// Every implementation of a trait with constant `member` (every constant
// when None) for the type whose nominal is `owner_row` and resolved name
// `owner`: the blocks its body writes and each module's `impl` for it.
sema_trait_constant_collect_impls: fn(graph: SemaRegistrationGraph, owner_row: SemaRegistrationRowRef, owner: String, member: String?, found: &[SemaTraitConstantFound]) Never! {
    owner_module: graph.modules[owner_row.module_index].module_identity
    item: sema_registration_nominal_source_item(graph.modules[owner_row.module_index].nominals[owner_row.row].source)
    if item == .Val(source) {
        if source == {
            .Struct(definition) -> sema_trait_constant_collect_blocks(graph, owner_module, definition.trait_impls, member, found)
            .Enum(definition) -> sema_trait_constant_collect_blocks(graph, owner_module, definition.trait_impls, member, found)
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    leaf: sema_trait_constant_leaf(owner)
    loop module_index in 0..<graph.modules.len() {
        loop implementation in graph.modules[module_index].impls {
            trait_name: implementation.trait_name ?? next
            // Only an impl whose written type ends in the owner's name is
            // resolved to compare it.
            written: sema_trait_constant_head(implementation.target_type) ?? next
            if sema_trait_constant_leaf(written) != leaf -> next
            target: sema_trait_constant_head(sema_checked_qualify_type(graph, implementation.target_type, graph.modules[module_index].module_identity)) ?? next
            if target != owner -> next
            row: sema_checked_trait_nominal_row(graph, graph.modules[module_index].module_identity, trait_name) ?? next
            sema_trait_constant_collect(graph, row, graph.modules[module_index].module_identity, member, Val(implementation.declaration.constants), found)
        }
    }
}

// Each of `blocks` (written in the body of a type of `module_identity`)
// whose trait declares constant `member` (any constant when None).
sema_trait_constant_collect_blocks: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, blocks: [TraitImplBlock], member: String?, found: &[SemaTraitConstantFound]) Never! {
    loop block in blocks {
        row: sema_checked_trait_nominal_row(graph, module_identity, block.trait_name) ?? next
        sema_trait_constant_collect(graph, row, module_identity, member, Val(block.constants), found)
    }
}

// Constant `member` of trait row `row` (each of its constants when None),
// when it declares one: with `constants` (an implementation's, written in
// `module_identity`) the value it reads, else (a type parameter's bound) the
// type alone.
sema_trait_constant_collect: fn(graph: SemaRegistrationGraph, row: SemaRegistrationRowRef, module_identity: ModuleID, member: String?, constants: [ImplConstValue]?, found: &[SemaTraitConstantFound]) Never! {
    trait_module: graph.modules[row.module_index].module_identity
    trait_name: graph.modules[row.module_index].nominals[row.row].symbol.name
    loop declaration in sema_trait_constants_declared(graph, row) {
        if member == .Val(wanted) && declaration.name != wanted -> next
        ty: sema_checked_qualify_type(graph, declaration.ty, trait_module)
        value := TComptimeValue?{None}
        if constants == .Val(written) {
            given := false
            loop constant in written {
                if constant.name == declaration.name {
                    given = true
                    if sema_trait_constant_eval(graph, constant.value, ty, module_identity, trait_module) == .Value(result) -> value = Val(result.copy())
                    break
                }
            }
            if !given && declaration.default == .Val(default_value) {
                if sema_trait_constant_eval(graph, default_value, ty, trait_module, trait_module) == .Value(result) -> value = Val(result.copy())
            }
        }
        found.push(SemaTraitConstantFound{name: declaration.name.copy(), trait_name: trait_name.copy(), ty: ty, value: value})
        if member != None -> return
    }
}
