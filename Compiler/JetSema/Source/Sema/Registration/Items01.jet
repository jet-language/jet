//RS /// E2-M7: type-check a method call on a FileReader or FileWriter handle (D-IO2).
//RS /// Returns `Some(return_type)` when the method is valid, or emits E2501 and
//RS /// returns `None` for an invalid method / wrong-direction call.
//RS pub fn file_handle_method_return(
//RS     handle_ty: &str,
//RS     method: &str,
//RS     n_args: usize,
//RS     span: Span,
//RS     diags: &mut Vec<Diagnostic>,
//RS ) -> Option<Option<Type>> {
//RS     let handle_ty = core_file_handle_dispatch_name(handle_ty).unwrap_or(handle_ty);
//RS     let io = io_error_ty();
//RS     let unit = unit_ty();
//RS     match handle_ty {
//RS         "MappedFile" => match (method, n_args) {
//RS             ("window" | "window_len", 2) => Some(Some(result_ty(
//RS                 Type::Apply {
//RS                     name: "View".to_string(),
//RS                     args: vec![Type::List(Box::new(u8_ty()))],
//RS                 },
//RS                 io.clone(),
//RS             ))),
//RS             ("lines", 0) => Some(Some(crate::Collections::view_iter_ty(Type::Apply {
//RS                 name: "View".to_string(),
//RS                 args: vec![Type::List(Box::new(u8_ty()))],
//RS             }))),
//RS             ("len", 0) => Some(Some(Type::Int)),
//RS             ("is_empty", 0) => Some(Some(Type::Bool)),
//RS             _ => None,
//RS         },
//RS         "FileScope" => match (method, n_args) {
//RS             ("read", 1) => Some(Some(result_ty(Type::String, io))),
//RS             _ => None,
//RS         },
//RS         "FileReader" => match method {
//RS             // We encode the return as `Named("FileLines")` so the loop body knows
//RS             // the element type is `String`.
//RS             "lines" if n_args == 0 => Some(Some(Type::Named("FileLines".to_string()))),
//RS             // `.read_line()` — returns one line or `None` at EOF.
//RS             "read_line" if n_args == 0 => {
//RS                 Some(Some(result_ty(Type::Option(Box::new(Type::String)), io)))
//RS             }
//RS             // Wrong direction: writing to a reader.
//RS             "write_line" | "flush" => {
//RS                 diags.push(Diagnostic::error(
//RS                     "E2501",
//RS                     format!("`{}` is not available on a read-only file handle", method),
//RS                     "`files.open` returns a read-only handle; it can only read lines or bytes"
//RS                         .to_string(),
//RS                     "use `files.create` or `files.append` to get a writable handle".to_string(),
//RS                     Some(span),
//RS                 ));
//RS                 Some(None)
//RS             }
//RS             _ => None,
//RS         },
//RS         "FileWriter" => match method {
//RS             // `.write_line(text)` — writes a line followed by a newline.
//RS             "write_line" if n_args == 1 => Some(Some(result_ty(unit.clone(), io.clone()))),
//RS             // `.flush()` — ensure buffered bytes reach disk.
//RS             "flush" if n_args == 0 => Some(Some(result_ty(unit, io))),
//RS             // Wrong direction: reading from a writer.
//RS             "lines" | "read_line" => {
//RS                 diags.push(Diagnostic::error(
//RS                     "E2501",
//RS                     format!("`{}` is not available on a write-only file handle", method),
//RS                     "`files.create` returns a write-only handle; it can only write lines"
//RS                         .to_string(),
//RS                     "use `files.open` to get a readable handle".to_string(),
//RS                     Some(span),
//RS                 ));
//RS                 Some(None)
//RS             }
//RS             _ => None,
//RS         },
//RS         // D-STDIN1=A: StdinHandle methods.
//RS         "StdinHandle" => match method {
//RS             "lines" if n_args == 0 => Some(Some(Type::Named("StdinLines".to_string()))),
//RS             "read_line" if n_args == 0 => {
//RS                 Some(Some(result_ty(Type::Option(Box::new(Type::String)), io)))
//RS             }
//RS             _ => None,
//RS         },
//RS         // D-COREIO1=A: stdout/stderr stream methods.
//RS         "Stdout" | "Stderr" => match method {
//RS             "write" | "write_line" if n_args == 1 => {
//RS                 Some(Some(result_ty(unit.clone(), io.clone())))
//RS             }
//RS             "write_bytes" if n_args == 1 => Some(Some(result_ty(unit.clone(), io.clone()))),
//RS             "flush" if n_args == 0 => Some(Some(result_ty(unit.clone(), io))),
//RS             "is_tty" if n_args == 0 => Some(Some(Type::Bool)),
//RS             _ => None,
//RS         },
//RS         _ => None,
//RS     }
//RS }
