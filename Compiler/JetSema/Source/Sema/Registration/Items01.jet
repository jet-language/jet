//RS /// E2-M10: field definitions for compiler-known constructable struct types.
//RS /// Returns `Some(fields)` when the named type is a prelude struct users can construct.
//RS pub(crate) fn core_constructable_fields(type_name: &str) -> Option<Vec<(String, Type)>> {
//RS     let str_ty = Type::String;
//RS     match type_name {
//RS         // D-COMPUTE1=D: Tensor is a Core-exported struct whose source
