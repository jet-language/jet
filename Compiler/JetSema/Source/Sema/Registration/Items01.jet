pub fn core_constructable_fields(type_name: String) -> [(String, Type)]? {
    str_ty :: Type.String
    if type_name == {
        "Tensor" -> Val([("shape", Type.List{element: Type.Int}), ("data", Type.List{element: Type.Float}), ("device", Type.String), ("numeric_profile", Type.String)])
        name if name == Syntax.TYPE_ERR -> Val([("message", Type.String), ("code", Type.Option{inner: Type.String}), ("cause", Type.Option{inner: Type.Named{name: Syntax.TYPE_ERR}})])
        "HandleID", "TaskID", "EventID" -> Val([("value", Type.Named{name: "Count"})])
        "HistoryCase" -> Val([
