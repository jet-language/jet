pub fn core_event_variants(enum_name: String) -> [String:(Span, VariantPayload)]? {
    zero :: Span.new(0, 0)
    unit :: (names: [String]) -> names.map((name) -> (name, (zero, VariantPayload.Unit))).collect()
    if enum_name == {
        "Overflow" -> Val(unit(["Block", "DropNewest", "DropOldest"]))
        "FailurePolicy" -> Val(unit(["StopFirst", "Collect", "Log", "Ignore"]))
        "DispatchState" -> Val(unit(["Delivered", "HandlerFailed", "DroppedNewest", "DroppedOldest", "Closed", "Cancelled", "DeadlineExceeded"]))
        "HookPolicy" -> Val(unit(["FirstCancelElseTransform"]))
        "HookDecision" -> Val([
            "Continue": (zero, VariantPayload.Unit), "Transform": (zero, VariantPayload.Single{ty: Type.Named{name: "Unknown"}, span: zero}),
            "Cancel": (zero, VariantPayload.Unit), "Fail": (zero, VariantPayload.Single{ty: Type.Named{name: "Unknown"}, span: zero}),
        ])
        "HookOutcome" -> Val([
            "Continue": (zero, VariantPayload.Single{ty: Type.Named{name: "Unknown"}, span: zero}),
            "Cancel": (zero, VariantPayload.Unit), "Fail": (zero, VariantPayload.Single{ty: Type.Named{name: "Unknown"}, span: zero}),
        ])
        else -> None
    }
}
