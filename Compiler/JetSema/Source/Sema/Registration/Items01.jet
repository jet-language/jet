//RS         "FileWriter" | "<corelib>/Core/files::Core/files/files.jet::FileWriter" => {
//RS             Some("FileWriter")
//RS         }
//RS         "StdinHandle" | "<corelib>/Core/term::Core/term/term.jet::StdinHandle" => {
//RS             Some("StdinHandle")
//RS         }
//RS         "Stdout" | "<corelib>/Core/term::Core/term/term.jet::Stdout" => Some("Stdout"),
//RS         "Stderr" | "<corelib>/Core/term::Core/term/term.jet::Stderr" => Some("Stderr"),
//RS         _ => None,
//RS     }
//RS }
