//RS         // D-FAIL-ERROR1=A: constructor calls normalize to this private shape.
//RS         name if name == Syntax::TYPE_ERR => Some(vec![
//RS             ("message".to_string(), Type::String),
//RS             ("code".to_string(), Type::Option(Box::new(Type::String))),
//RS             (
//RS                 "cause".to_string(),
//RS                 Type::Option(Box::new(Type::Named(Syntax::TYPE_ERR.to_string()))),
