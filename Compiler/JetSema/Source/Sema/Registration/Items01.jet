pub fn core_file_handle_dispatch_name(handle_ty: String) -> String? {
    if handle_ty == {
        "FileReader", "<corelib>/Core/files::Core/files/files.jet::FileReader" -> Val("FileReader")
        "FileWriter", "<corelib>/Core/files::Core/files/files.jet::FileWriter" -> Val("FileWriter")
        "StdinHandle", "<corelib>/Core/term::Core/term/term.jet::StdinHandle" -> Val("StdinHandle")
        "Stdout", "<corelib>/Core/term::Core/term/term.jet::Stdout" -> Val("Stdout")
