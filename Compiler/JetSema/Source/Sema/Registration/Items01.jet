//RS     let zero = Span::new(0, 0);
//RS     let field = |name: &str, ty: Type| VariantField {
//RS         name: name.to_string(),
//RS         name_span: zero,
//RS         ty,
//RS         ty_span: zero,
//RS     };
//RS     let mut variants = std::collections::HashMap::new();
//RS     for name in ["InvalidSignature", "WeakKey", "TokenExpired"] {
//RS         variants.insert(name.to_string(), (zero, VariantPayload::Unit));
//RS     }
//RS     for name in [
//RS         "MalformedToken",
//RS         "UnsupportedToken",
//RS         "MissingClaim",
