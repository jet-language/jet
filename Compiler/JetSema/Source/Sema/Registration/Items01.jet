//RS /// D-TERM1 (ratified 2026-06-22): pattern types for `Key` enum variants.
//RS /// Used by the pattern checker to validate `if k == Key.Char(c)` etc.
//RS pub(crate) fn core_key_pattern_types(variant: &str) -> Option<Vec<Type>> {
//RS     match variant {
//RS         // Unit variants — no payload.
//RS         "Enter" | "Escape" | "Backspace" | "Tab" | "Delete" | "Up" | "Down" | "Left" | "Right"
//RS         | "Unknown" => Some(Vec::new()),
//RS         // `Key.Char(c)` — one Char payload.
//RS         "Char" => Some(vec![Type::Char]),
//RS         // `Key.Ctrl(c)` — one Char payload (the control character).
//RS         "Ctrl" => Some(vec![Type::Char]),
//RS         // `Key.F(n)` — one Int payload (function key number 1–12).
//RS         "F" => Some(vec![Type::Int]),
//RS         _ => None,
//RS     }
//RS }
