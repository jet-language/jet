//RS /// D-MIGRATE3=A / card 2021: the ONE Core-struct field-type oracle every tier
//RS /// reads. Sema owns it because sema is what typed the field read in the first
//RS /// place (I3); AOT lowering, the Cranelift JIT and the TIR interpreter are
//RS /// marshalling adapters that must not re-declare a Core record's shape (I9).
//RS ///
//RS /// `Type::Named` receivers go through [`core_struct_field`]; a reserved core
//RS /// GENERIC (`DataJoin<L, R>`, `VjpRun<T>`, `Rotation<T>`)
//RS /// goes through [`core_generic_struct_field`], which needs the type arguments.
//RS /// Neither answers for a USER struct: every caller resolves its own struct
//RS /// table first (D-SHIFT1 user-type-wins), exactly as `Checker::field_type`
//RS /// does.
//RS pub fn core_struct_field_type(type_name: &str, field: &str, args: &[Type]) -> Option<Type> {
//RS     // Corelib nominal types carry a compiler-owned source identity. The
//RS     // canonical Core record oracle is keyed by the declared type leaf.
//RS     let type_name = type_name
//RS         .strip_prefix("<corelib>/")
//RS         .and_then(|identity| identity.rsplit("::").next())
//RS         .unwrap_or(type_name);
