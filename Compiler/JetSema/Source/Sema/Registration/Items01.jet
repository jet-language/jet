// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:3516
pub fn file_handle_method_return(handle_ty: String, method: String, n_args: Int, span: Span, diags: &[Diagnostic]) -> Type?? {
    handle :: core_file_handle_dispatch_name(handle_ty) ?? handle_ty
    io :: io_error_ty()
    unit :: unit_ty()
    if handle == {
        "MappedFile" -> if (method, n_args) == {
            ("window", 2), ("window_len", 2) -> Val(Val(result_ty(Type.Apply{name: "View", args: [Type.List{element: u8_ty()}]}, ~io)))
            ("lines", 0) -> Val(Val(view_iter_ty(Type.Apply{name: "View", args: [Type.List{element: u8_ty()}]})))
            ("len", 0) -> Val(Val(Type.Int))
            ("is_empty", 0) -> Val(Val(Type.Bool))
            else -> None
        }
        "FileScope" -> if method == "read" && n_args == 1 -> Val(Val(result_ty(Type.String, ^io))) else -> None
        "FileReader" -> if method == {
            "lines" -> if n_args == 0 -> Val(Val(Type.Named{name: "FileLines"})) else -> None
            "read_line" -> if n_args == 0 -> Val(Val(result_ty(Type.Option{inner: Type.String}, ^io))) else -> None
            "write_line", "flush" -> {
                &diags.push(Diagnostic.error("E2501", "`{method}` is not available on a read-only file handle",
                    "`files.open` returns a read-only handle; it can only read lines or bytes",
                    "use `files.create` or `files.append` to get a writable handle", Val(span)))
                Val(None)
            }
            else -> None
        }
        "FileWriter" -> if method == {
            "write_line" -> if n_args == 1 -> Val(Val(result_ty(~unit, ~io))) else -> None
            "flush" -> if n_args == 0 -> Val(Val(result_ty(^unit, ^io))) else -> None
            "lines", "read_line" -> {
                &diags.push(Diagnostic.error("E2501", "`{method}` is not available on a write-only file handle",
                    "`files.create` returns a write-only handle; it can only write lines",
                    "use `files.open` to get a readable handle", Val(span)))
                Val(None)
            }
            else -> None
        }
        "StdinHandle" -> if (method, n_args) == {
            ("lines", 0) -> Val(Val(Type.Named{name: "StdinLines"}))
            ("read_line", 0) -> Val(Val(result_ty(Type.Option{inner: Type.String}, ^io)))
            else -> None
        }
        "Stdout", "Stderr" -> if (method, n_args) == {
            ("write", 1), ("write_line", 1), ("write_bytes", 1) -> Val(Val(result_ty(~unit, ~io)))
            ("flush", 0) -> Val(Val(result_ty(^unit, ^io)))
            ("is_tty", 0) -> Val(Val(Type.Bool))
            else -> None
        }
        else -> None
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:3611
pub fn encoding_handle_method_return(handle_ty: String, method: String, n_args: Int) -> Type?? {
    error :: encoding_error_ty()
    unit :: unit_ty()
    if (handle_ty, method, n_args) == {
        ("JSONReader", "next", 0), ("CBORReader", "next", 0) -> Val(Val(result_ty(Type.Option{inner: Type.Named{name: "DataEvent"}}, ^error)))
        ("JSONLReader", "next", 0), ("XMLReader", "next", 0) -> Val(Val(result_ty(Type.Option{inner: Type.Named{name: "DataTree"}}, ^error)))
        ("CSVReader", "next", 0) -> Val(Val(result_ty(Type.Option{inner: Type.Named{name: "CSVRow"}}, ^error)))
        ("JSONWriter", "write", 1), ("JSONWriter", "flush", 0), ("JSONWriter", "finish", 0),
        ("JSONLWriter", "write", 1), ("JSONLWriter", "flush", 0), ("JSONLWriter", "finish", 0),
        ("CSVWriter", "write", 1), ("CSVWriter", "flush", 0), ("CSVWriter", "finish", 0),
        ("XMLWriter", "write", 1), ("XMLWriter", "flush", 0), ("XMLWriter", "finish", 0),
        ("CBORWriter", "write", 1), ("CBORWriter", "flush", 0), ("CBORWriter", "finish", 0) -> Val(Val(result_ty(^unit, ^error)))
        else -> None
    }
}

