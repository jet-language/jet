//RS /// D-CALLVALUE1=B: does a Core handle type own a method under this name?
//RS ///
//RS /// The plugin method set is interface-specific and is resolved by
//RS /// `check_plugin_method`; it must not be treated as a closed Core handle table.
//RS /// Keeping it out of this predicate prevents a stale compatibility alias from
//RS /// hijacking ordinary function-value projection.
//RS pub fn core_handle_owns_method(handle_ty: &str, method: &str) -> bool {
//RS     match handle_ty {
//RS         "Mod" => super::mod_method_return_ty(method).is_some(),
//RS         _ => false,
//RS     }
//RS }
