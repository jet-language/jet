//RS     // Unit variants.
//RS     for name in &[
//RS         "Enter",
//RS         "Escape",
//RS         "Backspace",
//RS         "Tab",
//RS         "Delete",
//RS         "Up",
//RS         "Down",
//RS         "Left",
//RS         "Right",
//RS         "Unknown",
//RS     ] {
//RS         m.insert((*name).to_string(), (zero, VariantPayload::Unit));
//RS     }
//RS     // Single-payload variants.
//RS     m.insert(
//RS         "Char".to_string(),
//RS         (zero, VariantPayload::Single(Type::Char, zero)),
//RS     );
//RS     m.insert(
//RS         "Ctrl".to_string(),
//RS         (zero, VariantPayload::Single(Type::Char, zero)),
//RS     );
//RS     m.insert(
//RS         "F".to_string(),
//RS         (zero, VariantPayload::Single(Type::Int, zero)),
//RS     );
//RS     m
//RS }
