// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:2885
pub fn core_net_control_variants(enum_name: String) -> [String:(Span, VariantPayload)]? {
    names :: if enum_name == { "NetShutdown" -> ["Read", "Write", "Both"]; "NetReadyInterest" -> ["Read", "Write", "ReadWrite"]; else -> return None }
    zero :: Span.new(0, 0)
    variants := [String:(Span, VariantPayload)]{}
    loop name in names -> &variants.insert(name, (zero, VariantPayload.Unit))
    Val(variants)
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:2904
pub fn core_net_error_variants(enum_name: String) -> [String:(Span, VariantPayload)]? {
    zero :: Span.new(0, 0)
    variants := [String:(Span, VariantPayload)]{}
    if enum_name == "NetDnsError" {
        loop name in ["NotFound", "Failure"] -> &variants.insert(name, (zero, VariantPayload.Single{ty: Type.String, span: zero}))
        return Val(variants)
    }
    if enum_name != "NetError" -> return None
    loop name in ["InvalidInput", "PermissionDenied", "AddressInUse", "AddressUnavailable", "ConnectionRefused",
        "ConnectionReset", "NotConnected", "Closed", "Timeout", "Cancelled", "Unsupported", "TLS", "Protocol", "Other"] {
        &variants.insert(name, (zero, VariantPayload.Single{ty: Type.Named{name: "NetErrorDetail"}, span: zero}))
    }
    &variants.insert("DNS", (zero, VariantPayload.Single{ty: Type.Named{name: "NetDnsError"}, span: zero}))
    Val(variants)
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:2959
pub fn core_http_variants(enum_name: String) -> [String:(Span, VariantPayload)]? {
    zero :: Span.new(0, 0)
    variants := [String:(Span, VariantPayload)]{}
    if enum_name == "HTTPOperation" {
        loop name in ["ClientConnect", "ServerBind", "ServeListener"] -> &variants.insert(name, (zero, VariantPayload.Unit))
        return Val(variants)
    }
    if enum_name == "HTTPCorsOrigins" {
        &variants.insert("Any", (zero, VariantPayload.Unit))
        &variants.insert("List", (zero, VariantPayload.Single{ty: Type.List{element: Type.String}, span: zero}))
        return Val(variants)
    }
    if enum_name == "HTTPProxy" {
        &variants.insert("FromEnvironment", (zero, VariantPayload.Unit))
        &variants.insert("None", (zero, VariantPayload.Unit))
        &variants.insert("URL", (zero, VariantPayload.Single{ty: Type.String, span: zero}))
        return Val(variants)
    }
    if enum_name == "HTTPRedirectPolicy" {
        &variants.insert("Follow", (zero, VariantPayload.Named{fields: [
            VariantField{name: "max", name_span: zero, ty: Type.Int, ty_span: zero},
            VariantField{name: "same_origin_credentials", name_span: zero, ty: Type.Bool, ty_span: zero},
        ]}))
        return Val(variants)
    }
    if enum_name == "HTTPRetryPolicy" {
        loop name in ["None", "Safe", "Idempotent"] -> &variants.insert(name, (zero, VariantPayload.Unit))
        return Val(variants)
    }
    if enum_name == "HTTPCookieJar" { &variants.insert("Memory", (zero, VariantPayload.Unit)); return Val(variants) }
    if enum_name == "HTTPCompressEncoding" { &variants.insert("Gzip", (zero, VariantPayload.Unit)); return Val(variants) }
    if enum_name == "WsError" {
        loop name in ["InvalidURL", "InvalidHandshake", "Protocol", "Timeout", "Closed", "Cancelled", "UnsupportedTarget"] -> &variants.insert(name, (zero, VariantPayload.Unit))
        &variants.insert("MessageTooLarge", (zero, VariantPayload.Named{fields: [VariantField{name: "limit", name_span: zero, ty: Type.Int, ty_span: zero}]}))
        &variants.insert("IO", (zero, VariantPayload.Named{fields: [VariantField{name: "operation", name_span: zero, ty: Type.String, ty_span: zero}]}))
        return Val(variants)
    }
    if enum_name != "HTTPError" -> return None
    loop name in ["InvalidMethod", "InvalidURL", "InvalidHeader", "InvalidStatus", "BodyConsumed", "InvalidFraming", "UnsupportedEncoding", "Cancelled"] -> &variants.insert(name, (zero, VariantPayload.Unit))
    loop (name, field, ty) in [
        ("BodyTooLarge", "limit", Type.Int), ("Resolve", "host", Type.String), ("Connect", "address", Type.String),
        ("TLS", "stage", Type.String), ("Timeout", "phase", Type.String), ("Proxy", "stage", Type.String),
        ("Redirect", "reason", Type.String), ("Protocol", "version", Type.String), ("IO", "operation", Type.String),
        ("Policy", "reason", Type.String), ("ResourceUnavailable", "resource", Type.String),
        ("Internal", "incident_id", Type.String), ("UnsupportedTarget", "operation", Type.Named{name: "HTTPOperation"}),
    ] {
        &variants.insert(name, (zero, VariantPayload.Named{fields: [VariantField{name: field, name_span: zero, ty: ^ty, ty_span: zero}]}))
    }
    Val(variants)
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:3122
pub fn core_io_variants(enum_name: String) -> [String:(Span, VariantPayload)]? {
    zero :: Span.new(0, 0)
    variants := [String:(Span, VariantPayload)]{}
    if enum_name == Syntax.TYPE_IO_OPERATION {
        loop name in Syntax.IO_OPERATION_VARIANTS -> &variants.insert(name, (zero, VariantPayload.Unit))
        return Val(variants)
    }
    if !is_io_error_type_name(enum_name) -> return None
    loop name in Syntax.IO_ERROR_VARIANTS {
        payload :: if name == "ResourceLimit" -> VariantPayload.Single{ty: Type.Named{name: Syntax.TYPE_PROCESS_RESOURCE_LIMIT}, span: zero}
            else -> VariantPayload.Single{ty: Type.Named{name: Syntax.TYPE_IO_CONTEXT}, span: zero}
        &variants.insert(name, (zero, ^payload))
    }
    Val(variants)
}
