// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:2187
fn compiler_package_struct_field(type_name: String, field: String) -> Type? {
    string_list :: () -> Type.List{element: Type.String}
    optional_string :: () -> Type.Option{inner: Type.String}
    if type_name == {
        "CompilerPackageError" -> if field == { "code", "message", "file", "cause" -> Val(Type.String); else -> None }
        "CompilerDependency" -> if field == { "name", "source" -> Val(Type.String); else -> None }
        "CompilerPackageTarget" -> if field == { "name" -> Val(Type.String); "targets" -> Val(string_list()); else -> None }
        "CompilerPackageOutput" -> if field == { "name", "kind" -> Val(Type.String); "entry" -> Val(optional_string()); else -> None }
        "CompilerBuildProfile" -> if field == {
            "name", "optimize" -> Val(Type.String)
            "debug_info", "small" -> Val(Type.Bool)
            "panic" -> Val(optional_string())
            else -> None
        }
        "CompilerManifest", "CompilerPackage" -> if field == {
            "schema_version" -> Val(Type.Int)
            "file" -> Val(Type.String)
            "jet", "edition", "description", "license", "repository", "layer", "target" -> Val(optional_string())
            "dependencies" -> Val(Type.List{element: Type.Named{name: "CompilerDependency"}})
            "packages" -> Val(Type.List{element: Type.Named{name: "CompilerPackageTarget"}})
            "outputs" -> Val(Type.List{element: Type.Named{name: "CompilerPackageOutput"}})
            "build_profiles" -> Val(Type.List{element: Type.Named{name: "CompilerBuildProfile"}})
            else -> None
        }
        "CompilerLockedPackage" -> if field == {
            "name", "version", "source_kind", "fingerprint" -> Val(Type.String)
            "source", "revision", "content_hash", "layer", "inferred_layer" -> Val(optional_string())
            "dependencies" -> Val(string_list())
            else -> None
        }
        "CompilerLock" -> if field == {
            "schema_version", "version" -> Val(Type.Int)
            "file" -> Val(Type.String)
            "root_dependencies" -> Val(string_list())
            "packages" -> Val(Type.List{element: Type.Named{name: "CompilerLockedPackage"}})
            else -> None
        }
        "CompilerKeyValue" -> if field == { "key", "value" -> Val(Type.String); else -> None }
        "CompilerProfile" -> if field == {
            "name" -> Val(Type.String)
            "extends", "packages", "sources" -> Val(string_list())
            "collisions" -> Val(Type.List{element: Type.Named{name: "CompilerKeyValue"}})
            else -> None
        }
        "CompilerProfileSet" -> if field == {
            "schema_version" -> Val(Type.Int)
            "file" -> Val(Type.String)
            "profiles" -> Val(Type.List{element: Type.Named{name: "CompilerProfile"}})
            else -> None
        }
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:2287
// The single Core field oracle. User-struct tables are resolved by each caller first.
pub fn core_struct_field_type(type_name: String, field: String, args: [Type]) -> Type? {
    leaf :: type_name.strip_prefix("<corelib>/").and_then((identity) -> identity.rsplit("::").next()) ?? type_name
    if args.is_empty() -> core_struct_field(leaf, field)
    else -> core_generic_struct_field(leaf, field, args).or_else(() -> core_struct_field(leaf, field))
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:2303
impl Checker {
    fn check_game_run_scene_edit(self: &Self, expr: Expr) {
        root :: expr_root_ident(expr) ?? {
            &self.diags.push(Diagnostic.error("E0202", "`game.run` needs a mutable scene binding",
                "running a scene advances its frame hooks and deterministic replay state",
                "store the scene in `scene := game.Scene.new(...)`, then call `game.run(scene)`", Val(expr.span())))
            return
        }
        if self.lookup(root) == .Val(info) && !info.mutable {
            &self.diags.push(Diagnostic.error("E0202", "`game.run` needs edit access to `{root}`",
                "running a scene advances its frame hooks and deterministic replay state",
                "declare `{root} := game.Scene.new(...)` before running it", Val(expr.span())))
        }
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:2334
pub fn core_generic_struct_field(type_name: String, field: String, args: [Type]) -> Type? {
    if type_name == "TypedHistoryCase" && args.len() == 1 -> return if field == {
        "case" -> Val(Type.Named{name: "HistoryCase"})
        "commands" -> Val(Type.List{element: ~args[0]})
        else -> None
    }
    if type_name == "HistoryStrategy" && args.len() == 1 {
        command :: args[0]
        return if field == {
            "generate" -> Val(Type.Fn{params: [Type.Named{name: "HistoryRNG"}, Type.Named{name: "Count"}, Type.Named{name: "Count"}],
                ret: Val(Type.Option{inner: Type.Apply{name: "TypedHistoryCase", args: [~command]}}),
                effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None})
            "rebuild" -> Val(Type.Fn{params: [Type.Named{name: "HistoryCase"}],
                ret: Val(Type.Option{inner: Type.Apply{name: "TypedHistoryCase", args: [~command]}}),
                effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None})
            "valid" -> Val(Type.Fn{params: [Type.Apply{name: "TypedHistoryCase", args: [~command]}], ret: Val(Type.Bool),
                effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None})
            "bounds" -> Val(Type.Named{name: "HistoryBounds"})
            "distributions" -> Val(Type.List{element: Type.Named{name: "HistoryDistribution"}})
            else -> None
        }
    }
    if type_name == "Measurement" && args.len() == 1 -> return if field == { "value", "uncertainty" -> Val(~args[0]); else -> None }
    if type_name == "FfiCallbackEvent" && args.len() == 1 -> return if field == "value" -> Val(~args[0]) else -> None
    if (type_name == "Point2" || type_name == "Delta2") && args.len() == 2 -> return if field == { "x", "y" -> Val(~args[0]); else -> None }
    if type_name == "Ray2" && args.len() == 3 -> return if field == {
        "origin" -> Val(Type.Apply{name: "Point2", args: [~args[0], ~args[2]]})
        "direction" -> Val(Type.Apply{name: "Delta2", args: [~args[0], ~args[2]]})
        else -> None
    }
    if type_name == "Transform" && args.len() == 2 -> return if field == {
        "m00", "m01", "m10", "m11", "tx", "ty" -> Val(Type.Float)
        else -> None
    }
    if type_name == "Transform2" && args.len() == 3 -> return if field == {
        "m00", "m01", "m10", "m11", "tx", "ty" -> Val(~args[0])
        else -> None
    }
    if type_name == "WebTableColumn" && args.len() == 1 -> return if field == { "name", "cell_type" -> Val(Type.String); else -> None }
    if type_name == "WebTablePage" && args.len() <= 1 {
        element :: args.first().cloned() ?? Type.Named{name: "T"}
        return if field == {
            "rows" -> Val(Type.List{element: ^element})
            "row_keys" -> Val(Type.List{element: Type.String})
            "total_rows", "page_index", "page_size", "page_count" -> Val(Type.Int)
            else -> None
        }
    }
    if type_name == "WebTableRow" && args.len() == 1 -> return if field == { "key" -> Val(Type.String); "value" -> Val(~args[0]); else -> None }
    if type_name == "WebTable" && args.len() == 1 -> return if field == "name" -> Val(Type.String) else -> None
    if type_name == "WebStoreTransaction" && args.len() == 1 -> return if field == {
        "generation" -> Val(Type.Int)
        "action" -> Val(Type.String)
        "changed_fields" -> Val(Type.List{element: Type.String})
        "before", "after" -> Val(~args[0])
        else -> None
    }
    if type_name == "WebVirtualPlan" && args.is_empty() -> return if field == {
        "total_count", "scroll_offset", "viewport_width", "viewport_height", "estimated_item_size", "overscan",
        "start", "end", "total_size", "measured_count", "anchor_index", "anchor_offset" -> Val(Type.Int)
        "measurements" -> Val(Type.List{element: Type.Tuple{fields: [
            TypeTupleField{name: "index", ty: Type.Int}, TypeTupleField{name: "size", ty: Type.Int},
        ]}})
        else -> None
    }
    if type_name == "WebVirtualPlanViewport" && args.is_empty() -> return if field == {
        "start", "end", "total_size", "measured_count", "anchor_index", "anchor_offset" -> Val(Type.Int)
        else -> None
    }
    if type_name == "WebStore" && args.len() == 1 -> return if field == "name" -> Val(Type.String) else -> None
    if type_name == "WebStoreInspection" && args.len() == 1 -> return if field == {
        "value" -> Val(~args[0])
        "generation", "cursor", "history_limit" -> Val(Type.Int)
        "history" -> Val(Type.List{element: Type.Apply{name: "WebStoreTransaction", args: [~args[0]]}})
        "events" -> Val(Type.List{element: Type.Named{name: "WebStoreEvent"}})
        "history_enabled" -> Val(Type.Bool)
        else -> None
    }
    if type_name == "DataJoin" && args.len() == 2 -> return if field == { "left" -> Val(~args[0]); "right" -> Val(~args[1]); else -> None }
    if type_name == "JetDataPlot" && args.len() == 1 -> return if field == {
        "rows" -> Val(Type.List{element: ~args[0]})
        "plan" -> Val(Type.Named{name: "JetDataPlotPlan"})
        else -> None
    }
    if type_name == "Group" && args.len() == 2 -> return if field == { "key" -> Val(~args[0]); "value" -> Val(~args[1]); else -> None }
    if type_name == "DataStream" && args.len() == 1 -> return if field == {
        "items" -> Val(Type.List{element: ~args[0]})
        "index" -> Val(Type.Int)
        "cancelled" -> Val(Type.Bool)
        else -> None
    }
    if type_name == "DataLoader" && args.len() == 1 -> return if field == {
        "source" -> Val(Type.Named{name: "DataSourceIdentity"})
        "format" -> Val(Type.Named{name: "DataFormat"})
        "authority" -> Val(Type.Named{name: "DataAuthority"})
        "limits" -> Val(Type.Named{name: "DataLimits"})
        "payload", "last_good" -> Val(Type.Option{inner: Type.List{element: u8_ty()}})
        "cancelled", "offline" -> Val(Type.Bool)
        "status" -> Val(Type.Named{name: "DataLoaderStatus"})
        else -> None
    }
    if type_name == "DataSnapshot" && args.len() == 1 -> return if field == {
        "value" -> Val(~args[0])
        "identity" -> Val(Type.Named{name: "DataSnapshotIdentity"})
        "provenance" -> Val(Type.Named{name: "DataProvenance"})
        "schema" -> Val(Type.Named{name: "DataSchema"})
        "status" -> Val(Type.Named{name: "DataLoaderStatus"})
        "content" -> Val(Type.List{element: u8_ty()})
        else -> None
    }
    if type_name == "VJPRun" && args.len() == 1 -> return if field == {
        "value" -> Val(Type.Named{name: "Tensor"})
        "pull" -> Val(Type.Fn{params: [Type.Named{name: "Tensor"}], ret: Val(~args[0]),
            effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None})
        "grads" -> Val(~args[0])
        else -> None
    }
    if type_name == "Rotation" && args.len() == 1 -> return if field == {
        "previous", "current" -> Val(Type.Apply{name: "KeyRef", args: [~args[0]]})
        else -> None
    }
    None
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:2588
pub fn job_queue_method_return(ty: Type, method: String, n_args: Int) -> Type?? {
    if ty != .Named("JobQueue") -> return None
    result :: (ok) -> result_ty(ok, Type.Named{name: "ServiceError"})
    (valid, ret) :: if method == {
        "enqueue" -> (n_args >= 2 && n_args <= 3, result(Type.Named{name: "JobQueueReceipt"}))
        "delay" -> (n_args == 3, result(Type.Named{name: "JobQueueReceipt"}))
        "receipt" -> (n_args == 1, result(Type.Named{name: "JobQueueReceipt"}))
        "inspect" -> (n_args == 2, result(Type.List{element: Type.Named{name: "JobQueueRecord"}}))
        "events" -> (n_args == 1, result(Type.List{element: Type.Named{name: "JobQueueEvent"}}))
        "claim" -> (n_args == 2, result(Type.List{element: Type.Named{name: "JobQueueClaim"}}))
        "heartbeat", "acknowledge", "fail", "cancel", "dead_letter" -> {
            valid :: if method == { "heartbeat" -> n_args == 1; "acknowledge", "fail" -> n_args == 2; "cancel", "dead_letter" -> n_args >= 2 && n_args <= 3; else -> false }
            (valid, result(Type.Named{name: "JobQueueReceipt"}))
        }
        "recover_expired" -> (n_args == 0, result(unit_ty()))
        "status", "pause", "resume" -> (n_args == 0, result(Type.Named{name: "JobQueueStatus"}))
        "wait" -> (n_args == 1, result(Type.Named{name: "JobQueueStatus"}))
        "prune" -> (n_args == 0, result(Type.Int))
        else -> return None
    }
    Val(if valid -> Val(ret) else -> None)
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:2658
pub fn web_method_return(ty: Type, method: String, n_args: Int) -> Type?? {
    (name, args) :: if ty == { .Named(name) -> (name, [Type]{}); .Apply(name, args) -> (name, args); else -> return None }
    element :: (expected) -> if name == expected && args.len() == 1 -> Val(~args[0]) else -> None
    if name == {
        "JetDataPlot" -> {
            row :: element("JetDataPlot") ?? return None
            plot :: () -> Type.Apply{name: "JetDataPlot", args: [~row]}
            fallible :: () -> result_ty(plot(), Type.Named{name: "DataError"})
            if method == {
                "line", "bar", "point" -> Val(Val(plot()))
                "x", "y", "color", "size", "text", "detail", "with_transform", "with_scale", "with_axis",
                "with_legend", "facet", "with_layer", "with_interaction", "accessibility", "layout", "select_indices" -> Val(Val(fallible()))
                else -> None
            }
        }
        "WebTable" -> {
            row :: element("WebTable") ?? return None
            if method == {
                "with_column", "paginate" -> Val(Val(Type.Apply{name: "WebTable", args: [^row]}))
                "page" -> Val(Val(result_ty(Type.Apply{name: "WebTablePage", args: [^row]}, Type.String)))
                else -> None
            }
        }
        "WebStore" -> {
            row :: element("WebStore") ?? return None
            if method == {
                "set" -> Val(Val(Type.Apply{name: "WebStoreTransaction", args: [^row]}))
                "signal", "state_signal" -> Val(Val(Type.Apply{name: "Signal", args: [^row]}))
                "facts_json" -> Val(Val(Type.String))
                else -> None
            }
        }
        "WebQuery" -> {
            if !args.is_empty() -> return None
            if method == {
                "state" -> Val(Val(Type.Named{name: "WebQueryState"}))
                "state_signal" -> Val(Val(Type.Apply{name: "Signal", args: [Type.Named{name: "WebQueryState"}]}))
                "mutation_state" -> Val(Val(Type.Named{name: "WebMutationState"}))
                "mutation_signal" -> Val(Val(Type.Apply{name: "Signal", args: [Type.Named{name: "WebMutationState"}]}))
                "invalidate" -> Val(Val(Type.Int))
                "get", "show", "facts" -> Val(Val(Type.String))
                "cancel" -> Val(Val(Type.Bool))
                "refresh" -> Val(Val(result_ty(unit_ty(), Type.String)))
                else -> None
            }
        }
        "WebFormTyped" -> {
            if !args.is_empty() -> return None
            if method == {
                "validate" -> if n_args == 0 -> Val(Val(result_ty(unit_ty(), Type.String))) else -> Val(Val(Type.Named{name: "WebFormValidationChain"}))
                "set_async_validator", "blur", "set", "focus" -> Val(Val(result_ty(unit_ty(), Type.String)))
                "set_action", "cancel" -> Val(None)
                "submit", "no_script", "post" -> Val(Val(result_ty(Type.String, Type.String)))
                "state" -> Val(Val(Type.Named{name: "WebFormState"}))
                "lifecycle" -> Val(Val(Type.Named{name: "WebFormLifecycle"}))
                "errors" -> Val(Val(Type.Named{name: "WebFormErrorState"}))
                "render", "show" -> Val(Val(Type.String))
                else -> None
            }
        }
        "WebFormValidationChain" -> if args.is_empty() && method == "render" -> Val(Val(Type.String)) else -> None
        "WebStorePatch" -> {
            row :: element("WebStorePatch") ?? return None
            if method == {
                "generation" -> Val(Val(Type.Int))
                "transaction", "commit" -> Val(Val(Type.Apply{name: "WebStoreTransaction", args: [^row]}))
                "active" -> Val(Val(Type.Bool))
                "rollback" -> Val(Val(Type.Option{inner: ^row}))
                else -> None
            }
        }
        "WebStoreSubscription" -> {
            if !args.is_empty() -> return None
            if method == { "unsubscribe" -> Val(None); "active" -> Val(Val(Type.Bool)); else -> None }
        }
        "WebVirtualWindow" -> if method == "facts_json" -> Val(Val(Type.String)) else -> None
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:2781
pub fn core_json_pattern_types(variant: String) -> [Type]? {
    json :: json_ty()
    if variant == {
        "Null" -> Val([Type]{})
        "Bool" -> Val([Type.Bool])
        "Int" -> Val([Type.Int])
        "Float" -> Val([Type.Float])
        "Text", "Number" -> Val([Type.String])
        "Array" -> Val([Type.List{element: ^json}])
        "Object" -> Val([Type.Map{key: Type.String, key_span: None, value: ^json}])
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:2805
pub fn core_key_pattern_types(variant: String) -> [Type]? {
    if variant == {
        "Enter", "Escape", "Backspace", "Tab", "Delete", "Up", "Down", "Left", "Right", "Unknown" -> Val([Type]{})
        "Char", "Ctrl" -> Val([Type.Char])
        "F" -> Val([Type.Int])
        else -> None
    }
}

