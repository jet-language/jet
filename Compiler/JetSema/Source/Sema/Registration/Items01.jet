//RS /// Project only the stream-handle identities owned by `core.files` and
//RS /// `core.term` onto the existing leaf-keyed method tables. Bare spellings are
//RS /// retained for the pre-existing core handle representation; qualified types
//RS /// require the one canonical source identity so unrelated same-leaf imports
//RS /// stay distinct.
//RS #[doc(hidden)]
//RS pub fn core_file_handle_dispatch_name(handle_ty: &str) -> Option<&'static str> {
//RS     match handle_ty {
//RS         "FileReader" | "<corelib>/Core/files::Core/files/files.jet::FileReader" => {
