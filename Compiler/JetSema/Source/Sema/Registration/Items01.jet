            ("creates", Type.List{element: Type.Named{name: "HandleID"}}),
            ("consumes", Type.List{element: Type.Named{name: "HandleID"}}),
            ("preconditions", Type.List{element: Type.Named{name: "HistoryPrecondition"}}),
            ("depends_on", Type.List{element: Type.Named{name: "Count"}}),
