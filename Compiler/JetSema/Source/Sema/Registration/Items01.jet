//RS /// D-TERM1 (ratified 2026-06-22): synthesised variant table for the `Key` enum.
//RS /// Used by `resolve_enum_variants_cloned` so `Key.Char(c)` / `Key.Enter` literals
//RS /// pass type-checking without `Key` being in the user type registry.
//RS pub(crate) fn core_key_variants(
//RS ) -> std::collections::HashMap<String, (crate::Diagnostics::Span, crate::AST::VariantPayload)> {
//RS     use crate::Diagnostics::Span;
