//RS 
//RS pub fn core_json_pattern_types(variant: &str) -> Option<Vec<Type>> {
//RS     let json = json_ty();
//RS     match variant {
//RS         "Null" => Some(Vec::new()),
//RS         "Bool" => Some(vec![Type::Bool]),
//RS         "Int" => Some(vec![Type::Int]),
//RS         "Float" => Some(vec![Type::Float]),
//RS         "Text" => Some(vec![Type::String]),
//RS         "Array" => Some(vec![Type::List(Box::new(json.clone()))]),
//RS         "Object" => Some(vec![Type::Map {
//RS             key: Box::new(Type::String),
//RS             key_span: None,
//RS             value: Box::new(json),
//RS         }]),
//RS         // `Number` is the compiler-only lexical carrier used by typed JSON
//RS         // parsing. It is accepted in generated union decoder patterns, but
//RS         // has no public `DataTree.Number(...)` constructor.
//RS         "Number" => Some(vec![Type::String]),
//RS         _ => None,
//RS     }
//RS }
