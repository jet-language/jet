//RS         ]),
//RS         "HandleID" | "TaskID" | "EventID" => Some(vec![("value".to_string(), Type::Named("Count".to_string()))]),
//RS         "HistoryCase" => Some(vec![
//RS             ("case_id".to_string(), Type::String),
//RS             ("seed".to_string(), Type::Named("Count".to_string())),
//RS             ("operations".to_string(), Type::List(Box::new(Type::Named("HistoryOperation".to_string())))),
//RS             ("schedule".to_string(), Type::List(Box::new(Type::Named("HistoryScheduleChoice".to_string())))),
