// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:4161
pub fn core_generic_constructable_fields(type_name: String, args: [Type]) -> [(String, Type)]? {
    if type_name == "DataJoin" && args.len() == 2 -> return Val([("left", ~args[0]), ("right", ~args[1])])
    if type_name == "JetDataPlot" && args.len() == 1 -> return Val([("rows", Type.List{element: ~args[0]}), ("plan", Type.Named{name: "JetDataPlotPlan"})])
    if type_name == "DataStream" && args.len() == 1 -> return Val([("items", Type.List{element: ~args[0]}), ("index", Type.Int), ("cancelled", Type.Bool)])
    if args.len() != 1 -> return None
    command :: args[0]
    typed_case :: () -> Type.Apply{name: "TypedHistoryCase", args: [~command]}
    if type_name == {
        "TypedHistoryCase" -> Val([("case", Type.Named{name: "HistoryCase"}), ("commands", Type.List{element: ~command})])
        "HistoryStrategy" -> {
            case_ty :: typed_case()
            Val([
                ("generate", Type.Fn{params: [Type.Named{name: "HistoryRNG"}, Type.Named{name: "Count"}, Type.Named{name: "Count"}],
                    ret: Val(Type.Option{inner: ~case_ty}), effect_bound: None, return_view_provenance: None, param_contract: None, call_metadata: None}),
                ("rebuild", Type.Fn{params: [Type.Named{name: "HistoryCase"}],
                    ret: Val(Type.Option{inner: ~case_ty}), effect_bound: None, return_view_provenance: None, param_contract: None, call_metadata: None}),
                ("valid", Type.Fn{params: [^case_ty], ret: Val(Type.Bool), effect_bound: None, return_view_provenance: None, param_contract: None, call_metadata: None}),
                ("bounds", Type.Named{name: "HistoryBounds"}), ("distributions", Type.List{element: Type.Named{name: "HistoryDistribution"}}),
            ])
        }
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:4261
pub fn core_email_variants(enum_name: String) -> [String:(Span, VariantPayload)]? {
    zero :: Span.new(0, 0)
    variants := [String:(Span, VariantPayload)]{}
    units :: if enum_name == {
        "SMTPSecurity" -> ["StartTLS", "TLS"]
        "RecipientPolicy" -> ["RequireAll", "DeliverAccepted"]
        "EmailError", "SMTPAuth", "TLSTrust" -> [String]{}
        else -> return None
    }
    loop name in units -> &variants.insert(name, (zero, VariantPayload.Unit))
    if enum_name == "EmailError" {
        loop name in ["Configuration", "DNS", "Connect", "TLS", "Auth", "Protocol", "Rejected", "Transient", "TimedOut", "Cancelled", "DeliveryUnknown"] {
            fields :: [("operation", Type.String), ("server", Type.Option{inner: Type.String}), ("code", Type.Option{inner: Type.Int}), ("reason", Type.String)]
                .map((field, ty) -> VariantField{name: field, name_span: zero, ty: ^ty, ty_span: zero}).collect()
            &variants.insert(name, (zero, VariantPayload.Named{fields: ^fields}))
        }
    } else if enum_name == "SMTPAuth" {
        &variants.insert("None", (zero, VariantPayload.Unit))
        &variants.insert("Password", (zero, VariantPayload.Named{fields: [
            VariantField{name: "username", name_span: zero, ty: Type.String, ty_span: zero},
            VariantField{name: "password", name_span: zero, ty: core_crypto_nominal(Type.Named{name: "Secret"}), ty_span: zero},
        ]}))
    } else if enum_name == "TLSTrust" {
        &variants.insert("System", (zero, VariantPayload.Unit))
        &variants.insert("SystemPlusCa", (zero, VariantPayload.Named{fields: [
            VariantField{name: "pem", name_span: zero, ty: Type.List{element: Type.IntN{signed: false, bits: 8}}, ty_span: zero},
        ]}))
    }
    Val(variants)
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:4350
pub fn core_tls_variants(enum_name: String) -> [String:(Span, VariantPayload)]? {
    zero :: Span.new(0, 0)
    roots :: Type.Named{name: "TLSRootCertificates"}
    variants := [String:(Span, VariantPayload)]{}
    if enum_name == {
        "TLSVersion" -> {
            &variants.insert("TLS12", (zero, VariantPayload.Unit))
            &variants.insert("TLS13", (zero, VariantPayload.Unit))
        }
        "TLSClientTrust" -> {
            &variants.insert("System", (zero, VariantPayload.Unit))
            &variants.insert("SystemPlus", (zero, VariantPayload.Single{ty: ~roots, span: zero}))
            &variants.insert("CustomOnly", (zero, VariantPayload.Single{ty: ^roots, span: zero}))
        }
        else -> return None
    }
    Val(variants)
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:4378
pub fn core_encoding_variants(enum_name: String) -> [String:(Span, VariantPayload)]? {
    zero :: Span.new(0, 0)
    variants := [String:(Span, VariantPayload)]{}
    units :: if enum_name == {
        "EncodingFormat" -> ["JSON", "JSONL", "CSV", "TOML", "YAML", "XML", "CBOR"]
        "DataErrorKind" -> ["Decode", "Limit", "IO", "Empty", "InvalidArgument", "NonFinite", "Overflow", "State", "Bridge", "Unsupported", "DuplicateKey", "MissingKey", "WrongOwner", "StaleRevision", "InvalidValue"]
        "DataEvent" -> ["Null", "ArrayStart", "ArrayEnd", "ObjectStart", "ObjectEnd"]
        "DataFormat" -> ["CSV", "JSON", "JSONL", "Parquet", "Arrow"]
        "DataLoaderKind" -> ["File", "URL", "Database", "Value"]
        "DataFreshness" -> ["Pending", "Fresh", "Stale", "Error", "Offline", "Cancelled"]
        "DataInvalidationCause" -> ["NoCause", "Loader", "Input", "ArchiveMember", "Parameters", "Credential", "Capability", "Manual"]
        "JobQueueState" -> ["Queued", "Running", "Retrying", "Completed", "Failed", "DeadLettered", "Cancelled"]
        "JobQueueDeliveryPolicy" -> ["AtLeastOnce"]
        "JetDataPlotMark" -> ["Bar", "Line", "Point"]
        "JetDataPlotChannel" -> ["X", "Y", "Color", "Size"]
        "JetDataPlotAggregate" -> ["Sum", "Mean", "Count", "Min", "Max"]
        "JetDataPlotFilterOp" -> ["Eq", "Ne", "Lt", "Le", "Gt", "Ge"]
        "JetDataPlotValue" -> ["Number", "Text", "Bool"]
        "JetDataPlotTransform" -> ["Identity", "Filter", "Aggregate"]
        "JetDataPlotScaleKind" -> ["Linear", "Log", "Band"]
        "JetDataPlotDomain" -> ["Auto", "Explicit"]
        "JetDataPlotLegendPosition" -> ["Top", "Bottom", "Left", "Right"]
        "JetDataPlotFacetKind" -> ["Wrap", "Grid"]
        "JetDataPlotInteraction" -> ["Hover", "Select", "Pan"]
        "JetDataPlotBackend" -> ["SVG", "Text"]
        "JetDataPlotSupport" -> ["Full", "Partial", "Unsupported"]
        "JetDataPlotErrorKind" -> ["Schema", "Encoding", "Render"]
        "JetDataPlotRenderFormat" -> ["SVG", "Text", "JSON"]
        "CBORErrorKind" -> ["Syntax", "Truncated", "Unsupported", "Limit", "TypeMismatch", "TrailingData", "NonCanonical"]
        "XMLReason" -> ["Syntax", "Truncated", "ForbiddenDTD", "UnknownEntity"]
        "XMLEntityPolicy" -> ["PredefinedOnly", "Reject"]
        "XMLEncoding" -> ["UTF8", "UTF16"]
        "XMLCanonicalMode" -> ["Inclusive", "Exclusive"]
        else -> return None
    }
    loop name in units -> &variants.insert(name, (zero, VariantPayload.Unit))
    if enum_name == "DataEvent" {
        loop (name, ty) in [("Bool", Type.Bool), ("Int", Type.Int), ("Float", Type.Float), ("Text", Type.String), (Syntax.TYPE_BYTES, Type.List{element: u8_ty()}), ("Key", Type.String)] {
            &variants.insert(name, (zero, VariantPayload.Single{ty: ^ty, span: zero}))
        }
    }
    Val(variants)
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:4478
pub fn core_auth_variants(enum_name: String) -> [String:(Span, VariantPayload)]? {
    if enum_name != "AuthError" -> return None
    zero :: Span.new(0, 0)
    field :: (name: String, ty: Type) -> VariantField{name: name, name_span: zero, ty: ^ty, ty_span: zero}
    variants := [String:(Span, VariantPayload)]{}
    loop name in ["InvalidSignature", "WeakKey", "TokenExpired"] -> &variants.insert(name, (zero, VariantPayload.Unit))
    loop name in ["MalformedToken", "UnsupportedToken", "MissingClaim", "DecodeError"] -> &variants.insert(name, (zero, VariantPayload.Single{ty: Type.String, span: zero}))
    &variants.insert("WrongAudience", (zero, VariantPayload.Named{fields: [field("expected", Type.String), field("actual", Type.String)]}))
    &variants.insert("WrongIssuer", (zero, VariantPayload.Named{fields: [field("expected", Type.String), field("actual", Type.Option{inner: Type.String})]}))
    &variants.insert("TokenNotYetValid", (zero, VariantPayload.Unit))
    Val(variants)
}

