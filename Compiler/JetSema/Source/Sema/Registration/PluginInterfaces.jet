// Frozen Component interfaces are immutable semantic facts. Snapshot decoding
// belongs to the bundle boundary; callers pass its complete typed result here.
use jet_foundation.[AccessConvention, Func, Item, Type, mir_sha256_hex_bytes]
use jet_parser.[
    parse_source,
]

pub struct SemaPluginInterfaceExport {
    pub name: String
    pub signature: String
    pub params: [SemaPluginExportParam]
    pub return_type: Type?
}

pub struct SemaPluginExportParam {
    pub convention: AccessConvention
    pub ty: Type
}

pub struct SemaPluginInterface {
    pub artifact: String
    pub identity: String
    pub digest: String
    pub exports: [SemaPluginInterfaceExport]
    pub export_rows: [String:Int]{[String:Int]{}}
}

pub struct SemaPluginArtifactAlias {
    pub artifact: String
    pub identity: String
}


pub struct SemaPluginInterfaceFacts {
    pub interfaces: [SemaPluginInterface]
    pub artifacts: [SemaPluginArtifactAlias]
    pub interface_rows: [String:Int]{[String:Int]{}}
    pub artifact_rows: [String:Int]{[String:Int]{}}
    pub digest: String
    pub complete: Bool
}


pub struct SemaPluginInterfaceBuildInput {
    pub package_name: String
    pub entry_artifact: String
    pub entry_aliases: [String]
    pub frozen_snapshots: [APISnapshot]
}

// Indexed last-writer-wins maps mirror Rust's BTreeMap insertion, followed by
// one deterministic sort at publication. No per-item table scan/copy/sort.
fn sema_plugin_sorted_exports(exports: [String:SemaPluginInterfaceExport]) -> [SemaPluginInterfaceExport] Never! {
    rows := (loop (_, export) in exports -> export)
    &rows.sort_by((left: SemaPluginInterfaceExport, right: SemaPluginInterfaceExport) -> left.name <=> right.name)
    rows
}

fn sema_plugin_export_rows(exports: [SemaPluginInterfaceExport]) -> [String:Int] Never! {
    rows := [String:Int]{}
    loop (index, export) in exports -> rows[export.name] = index
    rows
}

pub fn sema_plugin_interface_export(interface: SemaPluginInterface, name: String) -> SemaPluginInterfaceExport? Never! {
    index :: interface.export_rows.get(name) ?? return None
    Val(interface.exports[index])
}

fn sema_plugin_normalize_artifact(raw: String) -> String? {
    bytes := raw.trim().bytes()
    loop bytes.len() > 0 && bytes[bytes.len() - 1] == (U8{47}) -> _ := &bytes.pop()
    if bytes.len() == 0 -> return None
    start := 0
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{47}) -> start = index + 1
    }
    name :: String.from_bytes(bytes.slice(start, bytes.len())) ?? return None
    name_bytes := name.bytes()
    dot := -1
    loop index in 0..<name_bytes.len() {
        if name_bytes[index] == (U8{46}) -> dot = index
    }
    stem :: if dot > 0 -> String.from_bytes(name_bytes.slice(0, dot)) ?? name else -> name
    if stem == "" -> return None
    Val(stem)
}

fn sema_plugin_put_alias(aliases: &[SemaPluginArtifactAlias], rows: &[String:Int], artifact: String, identity: String) Never! {
    normalized :: sema_plugin_normalize_artifact(artifact) ?? return
    if rows.get(normalized) != None -> return
    rows[normalized] = aliases.len()
    &aliases.push(SemaPluginArtifactAlias{artifact: normalized, identity: identity})
}

fn sema_plugin_identity(artifact: String, digest: String) -> String Never! {
    bytes :: artifact.bytes()
    output := [U8]{}
    index := 0
    loop index < bytes.len() {
        first :: Int.from_u8(bytes[index])
        width :: if first < 128 -> 1 else if first < 224 -> 2 else if first < 240 -> 3 else -> 4
        ascii :: width == 1 && ((first >= 48 && first <= 57) || (first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95)
        &output.push(if ascii -> bytes[index] else -> U8{95})
        index += width
    }
    sanitized :: String.from_bytes(output) ?? panic("plugin identity is ASCII")
    "PluginInterface__{sanitized}__{digest}"
}

fn sema_plugin_export_from_function(function: Func, dimensions: APIUnitDimensions) -> SemaPluginInterfaceExport {
    params := (loop param in function.params -> SemaPluginExportParam{convention: param.convention, ty: param.ty})
    SemaPluginInterfaceExport{
        name: function.name,
        signature: canonical_fn_signature(function, dimensions),
        params: params,
        return_type: function.return_type,
    }
}

fn sema_plugin_sha256(text: String) -> String Never! {
    bytes :: text.bytes()
    mir_sha256_hex_bytes(bytes[0..<bytes.len()])
}

fn sema_plugin_active_interface(graph: SemaRegistrationGraph, input: SemaPluginInterfaceBuildInput, complete: &Bool) -> SemaPluginInterface? {
    artifact := if input.package_name != "" -> "plugin__{input.package_name}" else -> input.entry_artifact
    if artifact == "" {
        complete = false
        return None
    }
    module_index :: sema_registration_module_index(graph, graph.entry_module_identity) ?? {
        complete = false
        return None
    }
    entry_module :: graph.modules[module_index]
    dimensions := APIUnitDimensions{identities: [String:String]{}}
    collect_api_unit_dimensions(entry_module.program.items, input.package_name, &dimensions)
    exports := [String:SemaPluginInterfaceExport]{}
    loop item in entry_module.program.items {
        if item == {
            .Func(function) -> {
                if function.is_pub && !function.is_package_pub {
                    export :: sema_plugin_export_from_function(function, dimensions)
                    exports[export.name] = export
                }
            }
            else -> {}
        }
    }
    ordered :: sema_plugin_sorted_exports(exports)
    signatures := (loop export in ordered -> export.signature)
    digest := sema_plugin_sha256(signatures.join("\n"))
    Val(SemaPluginInterface{artifact: artifact, identity: sema_plugin_identity(artifact, digest), digest: digest, exports: ordered, export_rows: sema_plugin_export_rows(ordered)})
}

pub fn sema_plugin_snapshot_signature_source(signature: String) -> String? {
    effect_parts := signature.split(" -[").to_list()
    before_effects :: effect_parts[0]
    metadata_parts := before_effects.split(" ;").to_list()
    canonical := metadata_parts[0].trim() // #4303
    bytes := canonical.bytes()
    open := -1
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{40}) {
            open = index
            break
        }
    }
    if open < 0 -> return None
    depth := 0
    close := -1
    loop index in open..<bytes.len() {
        if bytes[index] == (U8{40}) -> depth += 1
        if bytes[index] == (U8{41}) {
            depth -= 1
            if depth == 0 {
                close = index
                break
            }
        }
    }
    if close < 0 -> return None
    prefix := String.from_bytes(bytes.slice(0, close + 1)) ?? return None // #4303
    suffix := String.from_bytes(bytes.slice(close + 1, bytes.len())) ?? return None // #4303
    result := suffix.trim() // #4303
    if result == "" -> return Val("{prefix} {{}}")
    if result.starts_with("->") -> return Val("{prefix} {result} {{}}")
    Val("{prefix} -> {result} {{}}")
}

fn sema_plugin_parse_frozen_export(frozen: FrozenFn) -> SemaPluginInterfaceExport? {
    signature_parts := frozen.signature.split(" -[").to_list()
    before_effects :: signature_parts[0]
    metadata_parts := before_effects.split(" ;").to_list()
    signature := metadata_parts[0].trim() // #4303
    source :: sema_plugin_snapshot_signature_source(signature) ?? return None
    parsed := parse_source(source.bytes())
    if parsed.diagnostics.len() != 0 -> return None
    function := Func?{None}
    loop item in parsed.program.items {
        if item == {
            .Func(value) -> {
                function = Val(value)
                break
            }
            else -> {}
        }
    }
    declaration :: function ?? return None
    if declaration.type_params.len() != 0 -> return None
    params := (loop param in declaration.params -> SemaPluginExportParam{convention: param.convention, ty: param.ty})
    Val(SemaPluginInterfaceExport{name: declaration.name, signature: signature, params: params, return_type: declaration.return_type})
}


fn sema_plugin_frozen_interface(snapshot: APISnapshot, complete: &Bool) -> SemaPluginInterface? {
    exports := [String:SemaPluginInterfaceExport]{}
    loop frozen in snapshot.funcs {
        export :: sema_plugin_parse_frozen_export(frozen) ?? {
            complete = false
            return None
        }
        exports[export.name] = export
    }
    ordered :: sema_plugin_sorted_exports(exports)
    digest := sema_plugin_sha256(api_snapshot_capability_digest(snapshot))
    Val(SemaPluginInterface{artifact: snapshot.package, identity: sema_plugin_identity(snapshot.package, digest), digest: digest, exports: ordered, export_rows: sema_plugin_export_rows(ordered)})
}

pub fn sema_plugin_interface_facts(graph: SemaRegistrationGraph, input: SemaPluginInterfaceBuildInput) -> SemaPluginInterfaceFacts {
    interfaces := [String:SemaPluginInterface]{}
    artifacts := [SemaPluginArtifactAlias]{}
    artifact_rows := [String:Int]{}
    complete := true
    active := sema_plugin_active_interface(graph, input, &complete)
    if active == .Val(interface) {
        interfaces[interface.identity] = interface
        sema_plugin_put_alias(&artifacts, &artifact_rows, interface.artifact, interface.identity)
        loop alias in input.entry_aliases -> sema_plugin_put_alias(&artifacts, &artifact_rows, alias, interface.identity)
    }
    loop snapshot in input.frozen_snapshots {
        if !snapshot.package.starts_with("plugin__") -> next
        interface :: sema_plugin_frozen_interface(snapshot, &complete) ?? next
        interfaces[interface.identity] = interface
        sema_plugin_put_alias(&artifacts, &artifact_rows, interface.artifact, interface.identity)
        if interface.artifact.starts_with("plugin__") -> sema_plugin_put_alias(&artifacts, &artifact_rows, sema_plugin_strip_prefix(interface.artifact, "plugin__"), interface.identity)
    }
    ordered := (loop (_, interface) in interfaces -> interface)
    &ordered.sort_by((left: SemaPluginInterface, right: SemaPluginInterface) -> left.identity <=> right.identity)
    interface_rows := [String:Int]{}
    contract := [String]{}
    loop (index, interface) in ordered {
        interface_rows[interface.identity] = index
        &contract.push(interface.identity)
        &contract.push(interface.digest)
        loop export in interface.exports -> &contract.push(export.signature)
    }
    digest_source :: if contract.len() == 0 -> "" else -> "{contract.join("\n")}\n"
    SemaPluginInterfaceFacts{interfaces: ordered, artifacts: artifacts, interface_rows: interface_rows, artifact_rows: artifact_rows, digest: sema_plugin_sha256(digest_source), complete: complete}
}

fn sema_plugin_strip_prefix(value: String, prefix: String) -> String {
    bytes := value.bytes()
    prefix_bytes := prefix.bytes()
    if bytes.len() < prefix_bytes.len() -> return ~value
    if String.from_bytes(bytes.slice(0, prefix_bytes.len())) != prefix -> return ~value
    String.from_bytes(bytes.slice(prefix_bytes.len(), bytes.len())) ?? value
}

pub fn sema_plugin_interface_by_artifact(facts: SemaPluginInterfaceFacts, artifact: String) -> SemaPluginInterface? {
    normalized :: sema_plugin_normalize_artifact(artifact) ?? return None
    alias :: facts.artifact_rows.get(normalized) ?? return None
    sema_plugin_interface_by_identity(facts, facts.artifacts[alias].identity)
}

pub fn sema_plugin_interface_by_identity(facts: SemaPluginInterfaceFacts, identity: String) -> SemaPluginInterface? {
    index :: facts.interface_rows.get(identity) ?? return None
    Val(facts.interfaces[index])
}
