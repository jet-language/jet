// Frozen Component interfaces are immutable semantic facts. Snapshot decoding
// belongs to the bundle boundary; callers pass its complete typed result here.
use jet_foundation.[
    AccessConvention,
    BinOp,
    Dimension,
    Expr,
    Func,
    InternalTag,
    Item,
    Type,
    TypeParam,
    UnitRatio,
    UnitScaleProvenance,
    ViewProvenance,
    ViewProvenanceMap,
    ViewSource,
    ViewSourcePath,
    ViewSourceProjection,
    access_sigil,
    dimension_base,
    dimension_divide,
    dimension_identity,
    dimension_multiply,
    measure_expression,
    mir_sha256_hex_bytes,
    type_name,
    failure_contract_of_function,
]
use jet_parser.[
    parse_source,
]

struct SemaPluginInterfaceExport {
    name: String
    signature: String
    params: [SemaPluginExportParam]
    return_type: Type?
}

struct SemaPluginExportParam {
    convention: AccessConvention
    ty: Type
}

struct SemaPluginInterface {
    artifact: String
    identity: String
    digest: String
    exports: [SemaPluginInterfaceExport]
}

struct SemaPluginArtifactAlias {
    artifact: String
    identity: String
}

struct SemaPluginInterfaceFacts {
    interfaces: [SemaPluginInterface]
    artifacts: [SemaPluginArtifactAlias]
    digest: String
    complete: Bool
}

fn sema_plugin_put_export(exports: &[SemaPluginInterfaceExport], export: SemaPluginInterfaceExport) Never! {
    loop index in 0..<exports.len() {
        if exports[index].name == export.name {
            exports[index] = export
            return
        }
    }
    &exports.push(export)
}

fn sema_plugin_export_after(left: SemaPluginInterfaceExport, right: SemaPluginInterfaceExport) -> Bool Never! {
    left.name > right.name
}

fn sema_plugin_sort_exports(exports: &[SemaPluginInterfaceExport]) Never! {
    loop index in 1..<exports.len() {
        item := exports[index]
        cursor := index
        loop cursor > 0 && sema_plugin_export_after(exports[cursor - 1], item) {
            exports[cursor] = exports[cursor - 1]
            cursor -= 1
        }
        exports[cursor] = item
    }
}

fn sema_plugin_interface_after(left: SemaPluginInterface, right: SemaPluginInterface) -> Bool Never! {
    left.identity > right.identity
}

fn sema_plugin_sort_interfaces(interfaces: &[SemaPluginInterface]) Never! {
    loop index in 1..<interfaces.len() {
        item := interfaces[index]
        cursor := index
        loop cursor > 0 && sema_plugin_interface_after(interfaces[cursor - 1], item) {
            interfaces[cursor] = interfaces[cursor - 1]
            cursor -= 1
        }
        interfaces[cursor] = item
    }
}

fn sema_plugin_put_interface(interfaces: &[SemaPluginInterface], interface: SemaPluginInterface) Never! {
    loop index in 0..<interfaces.len() {
        if interfaces[index].identity == interface.identity {
            interfaces[index] = interface
            return
        }
    }
    &interfaces.push(interface)
}

fn sema_plugin_normalize_artifact(raw: String) -> String? {
    bytes := raw.trim().bytes()
    loop bytes.len() > 0 && bytes[bytes.len() - 1] == (U8{47}) -> _ := &bytes.pop()
    if bytes.len() == 0 -> return None
    start := 0
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{47}) -> start = index + 1
    }
    name :: String.from_bytes(bytes.slice(start, bytes.len())) ?? return None
    name_bytes := name.bytes()
    dot := -1
    loop index in 0..<name_bytes.len() {
        if name_bytes[index] == (U8{46}) -> dot = index
    }
    stem :: if dot > 0 -> String.from_bytes(name_bytes.slice(0, dot)) ?? name else -> name
    if stem == "" -> return None
    Val(stem)
}

fn sema_plugin_put_alias(aliases: &[SemaPluginArtifactAlias], artifact: String, identity: String) Never! {
    normalized :: sema_plugin_normalize_artifact(artifact) ?? return
    loop alias in aliases {
        if alias.artifact == normalized {
            return
        }
    }
    &aliases.push(SemaPluginArtifactAlias{artifact: normalized, identity: identity})
}

fn sema_plugin_identity(artifact: String, digest: String) -> String Never! {
    bytes := artifact.bytes()
    output := ""
    index := 0
    loop index < bytes.len() {
        first :: Int.from_u8(bytes[index])
        width :: if {
            first < 128 -> 1
            first < 224 -> 2
            first < 240 -> 3
            else -> 4
        }
        if {
            width == 1 && ((first >= 48 && first <= 57) || (first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95) -> {
                output = "{output}{String.from_bytes([bytes[index]]) ?? "_"}"
            }
            else -> {
                output = "{output}_"
            }
        }
        index += width
    }
    "PluginInterface__{output}__{digest}"
}
fn sema_plugin_unit_ratio(value: UnitRatio) -> String Never! {
    if value.denominator == 1 {
        return "{value.numerator}"
    }
    return "{value.numerator}/{value.denominator}"
}

// Rust Guest.rs `export_boundary_return_type`: an export publishes the success
// value of its failure contract (the failure-set solve may already have turned
// a written `-> T` into a span-less `T Never!` carrier). Optional and `Never`
// carriers have no success value to publish and keep their written type.
fn sema_plugin_export_boundary_return_type(function: Func) -> Type? {
    written :: function.return_type ?? return None
    if failure_contract_of_function(function.return_type, function.return_type_span) == {
        .Default(success, _) | .Explicit(success, _) | .Inferred(success, _) -> Val(success)
        .Converted(success, _, _) -> Val(success)
        .ProvenUnreachable(success) | .InferredNever(success) -> Val(success)
        .Optional(_) | .DeclaredNever -> Val(written)
    }
}

fn sema_plugin_sha256(text: String) -> String Never! {
    mir_sha256_hex_bytes(text.bytes())
}

fn sema_plugin_snapshot_signature_source(signature: String) -> String? {
    effect_parts := signature.split(" -[").to_list()
    before_effects :: effect_parts[0]
    metadata_parts := before_effects.split(" ;").to_list()
    canonical := metadata_parts[0].trim()
    bytes := canonical.bytes()
    open := -1
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{40}) {
            open = index
            break
        }
    }
    if open < 0 -> return None
    depth := 0
    close := -1
    loop index in open..<bytes.len() {
        if bytes[index] == (U8{40}) -> depth += 1
        if bytes[index] == (U8{41}) {
            depth -= 1
            if depth == 0 {
                close = index
                break
            }
        }
    }
    if close < 0 -> return None
    prefix :: String.from_bytes(bytes.slice(0, close + 1)) ?? return None
    result :: String.from_bytes(bytes.slice(close + 1, bytes.len())) ?? return None
    if result.trim() == "" -> return Val("{prefix} {{}}")
    Val("{prefix} -> {result.trim()} {{}}")
}

fn sema_plugin_strip_prefix(value: String, prefix: String) -> String {
    bytes := value.bytes()
    prefix_bytes := prefix.bytes()
    if bytes.len() < prefix_bytes.len() -> return value.copy()
    if String.from_bytes(bytes.slice(0, prefix_bytes.len())) != prefix -> return value.copy()
    String.from_bytes(bytes.slice(prefix_bytes.len(), bytes.len())) ?? value
}

fn sema_plugin_interface_by_artifact(facts: SemaPluginInterfaceFacts, artifact: String) -> SemaPluginInterface? {
    normalized :: sema_plugin_normalize_artifact(artifact) ?? return None
    found :: loop alias in facts.artifacts {
        if alias.artifact == normalized {
            break alias.identity
        }
    } ?? return None
    loop interface in facts.interfaces {
        if interface.identity == found {
            return Val(interface)
        }
    }
    None
}

fn sema_plugin_interface_by_identity(facts: SemaPluginInterfaceFacts, identity: String) -> SemaPluginInterface? {
    loop interface in facts.interfaces {
        if interface.identity == identity {
            return Val(interface)
        }
    }
    None
}
