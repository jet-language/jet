// Frozen Component interfaces are immutable semantic facts. Snapshot decoding
// belongs to the bundle boundary; callers pass its complete typed result here.
use {
    jet_foundation.[
        AccessConvention,
        BinOp,
        Dimension,
        Expr,
        Func,
        InternalTag,
        Item,
        Type,
        TypeParam,
        UnitRatio,
        UnitScaleProvenance,
        ViewProvenance,
        ViewProvenanceMap,
        ViewSource,
        ViewSourcePath,
        ViewSourceProjection,
        access_sigil,
        dimension_base,
        dimension_divide,
        dimension_identity,
        dimension_multiply,
        measure_expression,
        sha256_hex_bytes,
        type_name,
        failure_contract_of_function,
    ]
    jet_parser.[
        parse_source,
    ]
}

SemaPluginInterfaceExport: struct {
    name: String
    signature: String
    params: [SemaPluginExportParam]
    return_type: Type?
}

SemaPluginExportParam: struct {
    convention: AccessConvention
    ty: Type
}

SemaPluginInterface: struct {
    artifact: String
    identity: String
    digest: String
    exports: [SemaPluginInterfaceExport]
}

SemaPluginArtifactAlias: struct {
    artifact: String
    identity: String
}

SemaPluginInterfaceFacts: struct {
    interfaces: [SemaPluginInterface]
    artifacts: [SemaPluginArtifactAlias]
    digest: String
    complete: Bool
}

sema_plugin_put_export: fn(exports: &[SemaPluginInterfaceExport], export: SemaPluginInterfaceExport) Never! {
    loop index in 0..<exports.len() {
        if exports[index].name == export.name {
            exports[index] = export
            return
        }
    }
    exports.push(export.copy())
}

sema_plugin_export_after: fn(left: SemaPluginInterfaceExport, right: SemaPluginInterfaceExport) -> Bool Never! {
    left.name > right.name
}

sema_plugin_sort_exports: fn(exports: &[SemaPluginInterfaceExport]) Never! {
    loop index in 1..<exports.len() {
        item := exports[index]
        cursor := index
        loop cursor > 0 && sema_plugin_export_after(exports[cursor - 1], item) {
            exports[cursor] = exports[cursor - 1]
            cursor -= 1
        }
        exports[cursor] = item
    }
}

sema_plugin_interface_after: fn(left: SemaPluginInterface, right: SemaPluginInterface) -> Bool Never! {
    left.identity > right.identity
}

sema_plugin_sort_interfaces: fn(interfaces: &[SemaPluginInterface]) Never! {
    loop index in 1..<interfaces.len() {
        item := interfaces[index]
        cursor := index
        loop cursor > 0 && sema_plugin_interface_after(interfaces[cursor - 1], item) {
            interfaces[cursor] = interfaces[cursor - 1]
            cursor -= 1
        }
        interfaces[cursor] = item
    }
}

sema_plugin_put_interface: fn(interfaces: &[SemaPluginInterface], interface: SemaPluginInterface) Never! {
    loop index in 0..<interfaces.len() {
        if interfaces[index].identity == interface.identity {
            interfaces[index] = interface
            return
        }
    }
    interfaces.push(interface.copy())
}

sema_plugin_normalize_artifact: fn(raw: String) -> String? {
    bytes := raw.trim().bytes()
    loop bytes.len() > 0 && bytes[bytes.len() - 1] == (U8{47}) -> _ := bytes.pop()
    if bytes.len() == 0 -> return None
    start := 0
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{47}) -> start = index + 1
    }
    name: String.from_bytes(bytes.slice(start, bytes.len())) ?? return None
    name_bytes := name.bytes()
    dot := -1
    loop index in 0..<name_bytes.len() {
        if name_bytes[index] == (U8{46}) -> dot = index
    }
    stem: if dot > 0 -> String.from_bytes(name_bytes.slice(0, dot)) ?? name else -> name
    if stem == "" -> return None
    Val(stem)
}

sema_plugin_put_alias: fn(aliases: &[SemaPluginArtifactAlias], artifact: String, identity: String) Never! {
    normalized: sema_plugin_normalize_artifact(artifact) ?? return
    loop alias in aliases {
        if alias.artifact == normalized {
            return
        }
    }
    aliases.push(SemaPluginArtifactAlias{artifact: normalized, identity: identity})
}

sema_plugin_identity: fn(artifact: String, digest: String) -> String Never! {
    bytes := artifact.bytes()
    output := ""
    index := 0
    loop index < bytes.len() {
        first: Int.from_u8(bytes[index])
        width: if {
            first < 128 -> 1
            first < 224 -> 2
            first < 240 -> 3
            else -> 4
        }
        if {
            width == 1 && ((first >= 48 && first <= 57) || (first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95) -> {
                output = "{output}{String.from_bytes([bytes[index]]) ?? "_"}"
            }
            else -> {
                output = "{output}_"
            }
        }
        index += width
    }
    "PluginInterface__{output}__{digest}"
}
sema_plugin_unit_ratio: fn(value: UnitRatio) -> String Never! {
    if value.denominator == 1 {
        return "{value.numerator}"
    }
    return "{value.numerator}/{value.denominator}"
}

// `export_boundary_return_type`: an export publishes the success value of its
// failure contract (the failure-set solve may already have turned a written `->
// T` into a span-less `T Never!` carrier). Optional and `Never` carriers have
// no success value to publish and keep their written type.
sema_plugin_export_boundary_return_type: fn(function: Func) -> Type? {
    written: function.return_type ?? return None
    if failure_contract_of_function(function.return_type, function.return_type_span) == {
        .Default(success, _) | .Explicit(success, _) | .Inferred(success, _) -> Val(success)
        .Converted(success, _, _) -> Val(success)
        .ProvenUnreachable(success) | .InferredNever(success) -> Val(success)
        .Optional(_) | .DeclaredNever -> Val(written)
    }
}

sema_plugin_sha256: fn(text: String) -> String Never! {
    sha256_hex_bytes(text.bytes())
}

sema_plugin_snapshot_signature_source: fn(signature: String) -> String? {
    effect_parts := signature.split(" -[").to_list()
    before_effects: effect_parts[0]
    metadata_parts := before_effects.split(" ;").to_list()
    canonical := metadata_parts[0].trim()
    bytes := canonical.bytes()
    open := -1
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{40}) {
            open = index
            break
        }
    }
    if open < 0 -> return None
    depth := 0
    close := -1
    loop index in open..<bytes.len() {
        if bytes[index] == (U8{40}) -> depth += 1
        if bytes[index] == (U8{41}) {
            depth -= 1
            if depth == 0 {
                close = index
                break
            }
        }
    }
    if close < 0 -> return None
    prefix: String.from_bytes(bytes.slice(0, close + 1)) ?? return None
    result: String.from_bytes(bytes.slice(close + 1, bytes.len())) ?? return None
    if result.trim() == "" -> return Val("{prefix} {{}}")
    Val("{prefix} -> {result.trim()} {{}}")
}

sema_plugin_interface_by_artifact: fn(facts: SemaPluginInterfaceFacts, artifact: String) -> SemaPluginInterface? {
    normalized: sema_plugin_normalize_artifact(artifact) ?? return None
    found: loop alias in facts.artifacts {
        if alias.artifact == normalized {
            break alias.identity
        }
    } ?? return None
    loop interface in facts.interfaces {
        if interface.identity == found {
            return Val(interface)
        }
    }
    None
}

sema_plugin_interface_by_identity: fn(facts: SemaPluginInterfaceFacts, identity: String) -> SemaPluginInterface? {
    loop interface in facts.interfaces {
        if interface.identity == identity {
            return Val(interface)
        }
    }
    None
}

// One `.jet/cache/api/plugin__<stem>.api` snapshot as the driver read it:
// `stem` is the artifact stem (`mathkit`), `text` the file's exact bytes.
SemaPluginSnapshot: struct {
    stem: String
    text: String
}

// The frozen interfaces of a project's plugin snapshots. Each snapshot names
// its artifact by stem (`plugin__mathkit` for `…/mathkit.wasm`); its identity
// pins the snapshot bytes, so a changed interface is a different type. An
// export line is `name: fn(a: T, …) R [-[effects]>]`. A line that does not
// parse leaves the facts incomplete instead of guessing a signature.
sema_plugin_interface_facts: fn(snapshots: [SemaPluginSnapshot]) -> SemaPluginInterfaceFacts Never! {
    interfaces := [SemaPluginInterface]{}
    aliases := [SemaPluginArtifactAlias]{}
    complete := true
    digests := ""
    loop snapshot in snapshots {
        stem: snapshot.stem
        digest: sema_plugin_sha256(snapshot.text)
        identity: sema_plugin_identity(stem, digest)
        exports := [SemaPluginInterfaceExport]{}
        loop raw in snapshot.text.split("\n") {
            line: raw.trim()
            if !line.contains(": fn") -> next
            export: sema_plugin_snapshot_export(line) ?? {
                complete = false
                next
            }
            sema_plugin_put_export(exports, export)
        }
        sema_plugin_sort_exports(exports)
        sema_plugin_put_interface(interfaces, SemaPluginInterface{artifact: stem, identity: identity, digest: digest, exports: exports})
        sema_plugin_put_alias(aliases, stem, identity)
        digests = "{digests}{identity}\n"
    }
    sema_plugin_sort_interfaces(interfaces)
    SemaPluginInterfaceFacts{interfaces: interfaces, artifacts: aliases, digest: sema_plugin_sha256(digests), complete: complete}
}

sema_plugin_snapshot_export: fn(line: String) -> SemaPluginInterfaceExport? {
    source: sema_plugin_snapshot_signature_source(line) ?? return None
    parsed: parse_source(source.bytes())
    if parsed.diagnostics.len() != 0 || parsed.program.items.len() != 1 -> return None
    if parsed.program.items[0] == {
        .Func(function) -> {
            params: loop parameter in function.params -> SemaPluginExportParam{convention: parameter.convention, ty: parameter.ty}
            signature: line.split(" -[").to_list()[0].trim()
            return Val(SemaPluginInterfaceExport{name: function.name, signature: signature, params: params, return_type: sema_plugin_export_boundary_return_type(function)})
        }
        .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> return None
    }
}
