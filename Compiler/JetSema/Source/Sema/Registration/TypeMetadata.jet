// Structural type capabilities selected from the declaration's signed markers.
// The caller must pass items from this declaration's module only.
use jet_foundation.[
    EnumDef,
    Item,
    Marker,
    StructDef,
    TraitImplBlock,
    Type,
    VariantPayload,
    type_name,
]

struct SemaTypeMetadataAutoDerives {
    printable: Bool
    debug: Bool
    equatable: Bool
}

fn sema_type_metadata_field_auto_ok(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 | .Measure(_) -> true
        .List(inner) | .Option(inner) | .Tagged(_, inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> sema_type_metadata_field_auto_ok(inner)
        .Map(key, _, value) | .Result(key, value) -> sema_type_metadata_field_auto_ok(key) && sema_type_metadata_field_auto_ok(value)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_type_metadata_field_auto_ok(field.ty) -> return false
            }
            true
        }
        .Union(members) -> {
            loop member in members {
                if !sema_type_metadata_field_auto_ok(member) -> return false
            }
            true
        }
        .Named(_) -> true
        .Apply(name, _) -> name != "SharedGuard"
        .Shared(_) | .TraitObject(_) | .Fn(_, _, _, _, _, _) -> false
    }
}

fn sema_type_metadata_struct_auto_ok(definition: StructDef) -> Bool Never! {
    if definition.is_single_use -> return false
    loop field_index in 0..<definition.fields.len() {
        if definition.fields[field_index].computed != None -> next
        if !sema_type_metadata_field_auto_ok(definition.fields[field_index].ty) -> return false
    }
    true
}

fn sema_type_metadata_variant_auto_ok(payload: VariantPayload) -> Bool Never! {
    if payload == {
        .Unit -> true
        .Single(ty, _) -> sema_type_metadata_field_auto_ok(ty)
        .Named(fields) -> {
            loop field in fields {
                if !sema_type_metadata_field_auto_ok(field.ty) -> return false
            }
            true
        }
    }
}

fn sema_type_metadata_enum_auto_ok(definition: EnumDef) -> Bool Never! {
    if definition.is_single_use -> return false
    loop variant_index in 0..<definition.variants.len() {
        if !sema_type_metadata_variant_auto_ok(definition.variants[variant_index].payload) -> return false
    }
    true
}

// Rust `auto_derive_requested`: the last marker naming the trait decides
// (`!` refuses it); `#Codable` names both codec traits. With no marker the
// package default applies.
fn sema_type_metadata_trait_requested(markers: [Marker], trait_name: String, package_default: Bool) -> Bool Never! {
    codec :: trait_name == "Encode" || trait_name == "Decode"
    index := markers.len() - 1
    loop index >= 0 {
        marker :: markers[index]
        if marker.name == trait_name || (codec && marker.name == "Codable") -> return !marker.negated
        index -= 1
    }
    package_default
}

// Only an authored block suppresses a structural selection; a
// compiler-generated block is that selection's own expansion.
fn sema_type_metadata_has_trait_block(blocks: [TraitImplBlock], trait_name: String) -> Bool Never! {
    loop block in blocks {
        if block.trait_name == trait_name && !block.compiler_generated -> return true
    }
    false
}

fn sema_type_metadata_impl_key(type_name: String, trait_name: String) -> String Never! {
    "{type_name.len()}:{type_name}:{trait_name}"
}

fn sema_type_metadata_has_explicit_impl(declared_trait_impls: [String:Bool], type_name: String, trait_name: String) -> Bool Never! {
    declared_trait_impls.get(sema_type_metadata_impl_key(type_name, trait_name)) != None
}

fn sema_type_metadata_select_trait(markers: [Marker], package_default: Bool, structurally_eligible: Bool, explicit_block: Bool, explicit_impl: Bool, trait_name: String) -> Bool Never! {
    structurally_eligible && !explicit_block && !explicit_impl && sema_type_metadata_trait_requested(markers, trait_name, package_default)
}

// `definition` supplies the complete type-marker sequence, package default,
// fields/variants, and inline trait blocks. `declared_trait_impls` holds only
// that same module's top-level trait impl declarations (see
// `sema_registration_push_declaration`), so unrelated modules cannot suppress
// this type's selection.
fn sema_type_metadata_auto_derives(definition: Item, declared_trait_impls: [String:Bool]) -> SemaTypeMetadataAutoDerives Never! {
    if definition == {
        .Struct(value) -> {
            eligible :: sema_type_metadata_struct_auto_ok(value)
            SemaTypeMetadataAutoDerives{
                printable: sema_type_metadata_select_trait(value.type_markers, value.auto_derive_default, eligible, sema_type_metadata_has_trait_block(value.trait_impls, "Printable"), sema_type_metadata_has_explicit_impl(declared_trait_impls, value.name, "Printable"), "Printable"),
                debug: sema_type_metadata_select_trait(value.type_markers, value.auto_derive_default, eligible, sema_type_metadata_has_trait_block(value.trait_impls, "Debug"), sema_type_metadata_has_explicit_impl(declared_trait_impls, value.name, "Debug"), "Debug"),
                equatable: sema_type_metadata_select_trait(value.type_markers, value.auto_derive_default, eligible, sema_type_metadata_has_trait_block(value.trait_impls, "Equatable"), sema_type_metadata_has_explicit_impl(declared_trait_impls, value.name, "Equatable"), "Equatable"),
            }
        }
        .Enum(value) -> {
            eligible :: sema_type_metadata_enum_auto_ok(value)
            SemaTypeMetadataAutoDerives{
                printable: sema_type_metadata_select_trait(value.type_markers, value.auto_derive_default, eligible, sema_type_metadata_has_trait_block(value.trait_impls, "Printable"), sema_type_metadata_has_explicit_impl(declared_trait_impls, value.name, "Printable"), "Printable"),
                debug: sema_type_metadata_select_trait(value.type_markers, value.auto_derive_default, eligible, sema_type_metadata_has_trait_block(value.trait_impls, "Debug"), sema_type_metadata_has_explicit_impl(declared_trait_impls, value.name, "Debug"), "Debug"),
                equatable: sema_type_metadata_select_trait(value.type_markers, value.auto_derive_default, eligible, sema_type_metadata_has_trait_block(value.trait_impls, "Equatable"), sema_type_metadata_has_explicit_impl(declared_trait_impls, value.name, "Equatable"), "Equatable"),
            }
        }
        else -> SemaTypeMetadataAutoDerives{printable: false, debug: false, equatable: false}
    }
}
