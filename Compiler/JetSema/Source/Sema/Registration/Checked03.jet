// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:4
pub fn name_defined(name: String, funcs: &[String:FuncSig], registry: &TypeRegistry, consts: &[String:Type]) -> Bool {
    funcs.contains_key(name) || registry.contains(name) || consts.contains_key(name)
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:13
fn declared_type_contains_cell_guard(ty: &Type) -> Bool {
    if ty == {
        .Apply(name: name, ..) && (name == "CellReadGuard" || name == "CellEditGuard") -> true
        .List(inner) | .Shared(inner) | .Option(inner) -> declared_type_contains_cell_guard(inner)
        .Map(key: key, value: value, ..) | .Result(ok: key, err: value) -> declared_type_contains_cell_guard(key) || declared_type_contains_cell_guard(value)
        .Fn(params: params, ret: ret, ..) -> params.any(declared_type_contains_cell_guard) || ret.is_some_and(declared_type_contains_cell_guard)
        .Tuple(fields) -> fields.any(field -> declared_type_contains_cell_guard(field.1))
        .FixedList(elem: elem, ..) | .Tagged(inner: elem, ..) -> declared_type_contains_cell_guard(elem)
        .Union(members) | .Apply(args: members, ..) -> members.any(declared_type_contains_cell_guard)
        _ -> false
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:45
fn cell_guard_storage_diagnostic(place: String, span: Span) -> Diagnostic {
    Diagnostic.error("E0217", "a Cell guard cannot be stored in {place}", "a Cell guard is a temporary loan handle; storing it inside another value could keep the loan after its local scope ends", "keep the guard in a local name or a tuple, and use `.map(...)` or `.split(...)` for projections", Val(span))
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:59
fn layout_alignment_literal(expr: &Expr) -> (I128, Span)? {
    if expr == {
        .Int(value, span, _, _) -> Val((I128.from(value), span))
        .Unary(UnOp.Neg, inner, span) -> if inner == { .Int(value, _, _, _) -> Val((-I128.from(value), span)); _ -> None }
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:74
fn nearest_layout_alignment(value: I128) -> String {
    if value <= 0 -> return "1"
    value :: U64.try_from(value).ok() ?? U64.MAX
    upper :: value.checked_next_power_of_two() ?? U64.MAX
    if value > PORTABLE_ALIGNMENT_BASELINE_MAX -> return "{Syntax.LAYOUT_ALIGN_TARGET}, {upper}"
    lower :: upper / 2
    nearest :: if value - lower <= upper.saturating_sub(value) { lower } else { upper }
    nearest.to_string()
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:92
fn validate_layout_alignment(s: &StructDef, target: &TargetLayout, diags: &[Diagnostic]) {
    marker :: s.type_markers.find(marker -> marker.name == Syntax.MARKER_LAYOUT && !marker.negated) ?? return
    if marker.expr_arg(1) != .Val(.Call(call)) -> return
    if call.name != Syntax.LAYOUT_ALIGN -> return
    target_mode :: call.args.len() == 2 && if call.args[0].expr == { .Ident(name, _) -> name == Syntax.LAYOUT_ALIGN_TARGET; _ -> false }
    argument :: if call.args.len() == { 1 -> call.args[0].expr; 2 && target_mode -> call.args[1].expr; _ -> return }
    (value, span) :: layout_alignment_literal(argument) ?? return
    value_text :: value.to_string()
    requested :: U64.try_from(value).ok() ?? {
        diags.push(Diagnostic.from_row("E1119", [("value", value_text), ("reason", "negative values cannot describe byte alignment"), ("suggestion", "1")], Val(span)))
        return
    }
    // GATE #4483: canonical selected target/profile layout facts, never host layout.
    try { _ :: target.layout_facts.check_alignment(requested, 1, target_mode) } catch error {
        reason :: error.reason()
        suggestion :: nearest_layout_alignment(value)
        diags.push(Diagnostic.from_row("E1119", [("value", value_text), ("reason", reason), ("suggestion", suggestion)], Val(span)))
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:160
fn receipt_schema_digest(type_name: String, fields: &[(String, Span, Type)]) -> String {
    schema := ~type_name
    schema.push_str(TEXT_NUL)
    loop (name, _, ty) in fields {
        schema.push_str(name)
        schema.push_str(":")
        schema.push_str(ty.name())
        schema.push_str(";")
    }
    sha256_hex(schema.as_bytes())
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:173
pub fn register_distinct(d: &DistinctDef, registry: &TypeRegistry, diags: &[Diagnostic], funcs: &[String:FuncSig], consts: &[String:Type]) {
    if is_reserved_type(d.name) {
        diags.push(Diagnostic.error("E0106", "the name `{d.name}` is built in and can't be redefined", "`{d.name}` is provided by the language itself", "choose a different name for this distinct type", Val(d.name_span)))
        return
    }
    if name_defined(d.name, funcs, registry, consts) {
        diags.push(defined_twice(d.name, "every distinct type needs a unique name", d.name_span))
        return
    }
    if d.base == .Named(base_name) {
        if registry.is_distinct(base_name) {
            diags.push(Diagnostic.error("E0129", "`{d.name}` can't be built on `{base_name}` — `{base_name}` is itself a distinct type", "`distinct`-over-`distinct` chaining is not allowed in v1; `{base_name}` is already a distinct type", "use `{base_name}` directly, or build on the shared base type", Val(d.base_span)))
            return
        }
    }
    if d.range == .Val((lo, hi, range_span)) {
        if d.base != Type.Int -> diags.push(Diagnostic.error("E0003", "a range constraint only works on `Int`, but `{d.name}` is {d.base.show()}", "`distinct Base(lo..hi)` provably bounds a whole-number value", "use `distinct Int({lo}..{hi})`, or drop the range", Val(range_span)))
    }
    registry.types.insert(~d.name, TypeDef.Distinct(base: ~d.base, derives: d.derives.map(entry -> ~entry.0).collect(), deprecation: deprecation_from_markers(d.type_markers), knowledge: d.range.map(range -> KnowledgeVector.from_interval(range.0, range.1)).unwrap_or_else(fn() { KnowledgeVector.default() })))
    if d.type_markers.any(marker -> marker.name == Syntax.MARKER_ERROR) -> registry.error_types.insert(~d.name, true)
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:259
pub fn register_type_alias(a: &TypeAliasDef, registry: &TypeRegistry, diags: &[Diagnostic], funcs: &[String:FuncSig], consts: &[String:Type]) {
    if is_reserved_type(a.name) {
        diags.push(Diagnostic.error("E0106", "the name `{a.name}` is built in and can't be redefined", "`{a.name}` is provided by the language itself", "choose a different name for this type alias", Val(a.name_span)))
        return
    }
    if name_defined(a.name, funcs, registry, consts) {
        diags.push(defined_twice(a.name, "every type alias needs a unique name", a.name_span))
        return
    }
    if a.type_params.is_empty() {
        diags.push(e0324(a.name_span))
        return
    }
    registry.types.insert(~a.name, TypeDef.Alias(params: ~a.type_params, target: ~a.target, deprecation: None))
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:302
pub fn eval_comptime_items(items: &[Item], consts: &[String:Type], base_dir: OSPath, diags: &[Diagnostic], module_idx: Int, name_ledger: &NameLedger, core_imports: &[String:String], core_item_imports: &[String:String], build_facts: &BuildFactSnapshot, states: &[ModuleState], plugin_interfaces: &PluginInterfaceRegistry, devtools_registry: &DevtoolsRegistry, no_os: Bool, gates: GateSet, no_prelude: Bool, embed_inputs_out: &[ComptimeInput]?, reuse: &ComptimeReuseEnv?) {
    if !items.any(item -> if item == { .Const(c) -> const_evaluated_at_build(c); _ -> false }) -> return
    // Expand an evaluation clone in production derive/serde order without mutating
    // module declarations. Canonical TIR hooks remain identical to runtime hooks.
    eval_items := ~items
    ignored_early_expansion_diags := [Diagnostic]{}
    expand_builtin_derive_items(&eval_items, &ignored_early_expansion_diags)
    expand_builtin_serde_items(&eval_items, &ignored_early_expansion_diags)
    // GATE #4499: exact tuple-key equality/hashing, never string-encoded keys.
    explicit_codecs := [(String, String?):Bool]{}
    loop item in eval_items {
        if item == .Impl(implementation) {
            if !implementation.is_generated_serde && (implementation.trait_name == Val("Encode") || implementation.trait_name == Val("Decode")) -> explicit_codecs.insert((~implementation.type_name, ~implementation.trait_name), true)
        }
    }
    loop item in eval_items {
        nominal :: if item == { .Struct(definition) -> (definition.name, definition.trait_impls); .Enum(definition) -> (definition.name, definition.trait_impls); _ -> continue }
        loop block in nominal.1 {
            if !block.compiler_generated && (block.trait_name == "Encode" || block.trait_name == "Decode") -> explicit_codecs.insert((~nominal.0, Val(~block.trait_name)), true)
        }
    }
    funcs := [String:&Func]{}
    methods := [(String, String):&Func]{}
    distinct_ranges := [String:(Int, Int)?]{}
    distinct_bases := [String:Type]{}
    unit_families := [UnitFamilyDef]{}
    structs := [String:&StructDef]{}
    externs := [String:Bool]{}
    loop item in eval_items {
        if item == {
            .Func(f) -> funcs.insert(~f.name, &f)
            .Impl(implementation) -> {
                if implementation.is_generated_serde && explicit_codecs.contains_key((implementation.type_name, implementation.trait_name)) -> continue
                loop method in implementation.methods {
                    method_key :: (~implementation.type_name, ~method.name)
                    if implementation.trait_name == Val("Encode") || implementation.trait_name == Val("Decode") {
                        key :: "{implementation.type_name}::{method.name}"
                        if implementation.is_generated_serde || method.compiler_generated {
                            if !funcs.contains_key(key) -> funcs.insert(^key, &method)
                            if !methods.contains_key(method_key) -> methods.insert(^method_key, &method)
                        } else {
                            funcs.insert(^key, &method)
                            methods.insert(^method_key, &method)
                        }
                    } else { methods.insert(^method_key, &method) }
                }
            }
            .Struct(s) -> {
                structs.insert(~s.name, &s)
                loop method in s.methods -> methods.insert((~s.name, ~method.name), &method)
                loop block in s.trait_impls {
                    loop method in block.methods {
                        method_key :: (~s.name, ~method.name)
                        if block.trait_name == "Encode" || block.trait_name == "Decode" {
                            key :: "{s.name}::{method.name}"
                            if block.compiler_generated || method.compiler_generated {
                                if !funcs.contains_key(key) -> funcs.insert(^key, &method)
                                if !methods.contains_key(method_key) -> methods.insert(^method_key, &method)
                            } else {
                                funcs.insert(^key, &method)
                                methods.insert(^method_key, &method)
                            }
                        } else { methods.insert(^method_key, &method) }
                    }
                }
            }
            .Enum(e) -> {
                loop method in e.methods -> methods.insert((~e.name, ~method.name), &method)
                loop block in e.trait_impls {
                    loop method in block.methods {
                        method_key :: (~e.name, ~method.name)
                        if block.trait_name == "Encode" || block.trait_name == "Decode" {
                            key :: "{e.name}::{method.name}"
                            if block.compiler_generated || method.compiler_generated {
                                if !funcs.contains_key(key) -> funcs.insert(^key, &method)
                                if !methods.contains_key(method_key) -> methods.insert(^method_key, &method)
                            } else {
                                funcs.insert(^key, &method)
                                methods.insert(^method_key, &method)
                            }
                        } else { methods.insert(^method_key, &method) }
                    }
                }
            }
            .Distinct(definition) -> {
                distinct_ranges.insert(~definition.name, definition.range.map(range -> (range.0, range.1)))
                distinct_bases.insert(~definition.name, ~definition.base)
            }
            .UnitFamily(family) -> {
                loop definition in family.distinct_defs() {
                    distinct_ranges.insert(~definition.name, definition.range.map(range -> (range.0, range.1)))
                    distinct_bases.insert(~definition.name, ^definition.base)
                }
                unit_families.push(~family)
            }
            .ExternRust(b) -> { loop ef in b.functions -> externs.insert(~ef.name, true) }
            _ -> {}
        }
    }
    globals := [String:CtValue]{}
    (ct_funcs, ct_externs, _) :: comptime_context_from_items(eval_items)
    ct_checked_funcs :: [String:TFunc]{}
    checked_nominals := None as CheckedComptimeNominals?
    module_reuse := None as ModuleComptime?
    global_digests := [String:String]{}
    declared_here := [String:Bool]{}
    loop item in items {
        if item == { .Const(c) -> declared_here.insert(~c.name, true); .Func(f) -> declared_here.insert(~f.name, true); _ -> {} }
    }
    sibling_values := [(String, Type, CtValue)]{}
    loop sibling in name_ledger.namespace_siblings(module_idx) {
        loop item in states[sibling].items {
            if item == .Const(constant) {
                if constant.ct == .Val(value) && constant.ty == .Val(ty) && !declared_here.contains_key(constant.name) -> sibling_values.push((~constant.name, ~ty, ~value))
            }
        }
    }
    loop (name, ty, value) in sibling_values {
        if globals.contains_key(name) -> continue
        states[module_idx].consts.insert(~name, ^ty)
        if reuse == .Val(env) -> global_digests.insert(~name, env.value_digest(value))
        globals.insert(^name, ^value)
    }
    loop index in 0..<items.len() {
        binding :: if items[index] == { .Const(c) && const_evaluated_at_build(c) -> (~c.name, ~c.value, ~c.ct, ~c.ty, !c.is_comptime); _ -> continue }
        name :: binding.0
        value :: binding.1
        module_value :: binding.4
        if binding.2 == .Val(known) {
            ty :: binding.3.unwrap_or_else(fn() { known.jet_type() })
            consts.insert(~name, ~ty)
            states[module_idx].consts.insert(~name, ~ty)
            if reuse == .Val(env) -> global_digests.insert(~name, env.value_digest(known))
            mirror_comptime_value(&states[module_idx], name, ty, known)
            globals.insert(~name, ~known)
            if items[index] == .Const(c) {
                c.ty = Val(^ty)
                c.ct = Val(^known)
            }
            continue
        }
        if !check_build_time_io(value, base_dir, &diags) -> continue
        eval_value := ~value
        effect_facts :: states[module_idx].fact_registry
        checker := checker_for_module(module_idx, states, plugin_interfaces, devtools_registry, effect_facts, ct_funcs, ct_checked_funcs, eval_items, ct_externs, base_dir, globals, no_os, gates, no_prelude, name_ledger, None, false, false)
        checker.in_comptime = true
        checker.in_pure = true
        // The build edge has the implicit failure rail, just like fn run.
        checker.ret = Val(FailureContract.from_return_type(None).effective_type())
        checked_ty :: checker.infer(&eval_value)
        invalid :: checker.diags.any(diagnostic -> diagnostic.severity == Severity.Error)
        diags.extend(^checker.diags)
        if invalid -> continue
        eval_value.for_each_expr_mut(fn(expr: &Expr) {
            if expr != .Call(call) -> return
            if funcs.contains_key(call.name) && !core_item_imports.contains_key(call.name) -> return
            item :: core_item_imports.get(call.name) ?? return
            if core_imports.contains_key(call.name) -> rewrite_core_item_call(&expr, item)
        })
        eval_value.for_each_expr_mut(fn(expr: &Expr) {
            call_span :: expr.span()
            if expr != .MethodCall(receiver: receiver, method: method, args: args, ..) -> return
            if receiver != .Ident(alias, _) -> return
            module :: core_imports.get(alias) ?? return
            apply_core_call_defaults(module, method, &args, call_span)
        })
        // Plain literals avoid lowering/optimizing the entire module per constant.
        evaluated :: try {
            if plain_literal_value(eval_value) == .Val(literal) {
                (literal, [ComptimeInput]{})
            } else {
                reuse_key :: reuse.and_then(fn(env) {
                    if module_reuse == None -> module_reuse = Val(ModuleComptime.new(env, module_idx, eval_items, comptime_reuse_context(base_dir, core_imports, core_item_imports)))
                    (module_reuse ?? unreachable("module reuse initialized")).key(name, eval_value, global_digests)
                })
                stored :: reuse.zip(reuse_key).and_then(pair -> pair.0.load(pair.1))
                if stored == .Val(stored) {
                    (stored, [ComptimeInput]{})
                } else {
                    if checked_nominals == None -> checked_nominals = Val(checked_comptime_nominals_for_context(states, module_idx, name_ledger))
                    result :: evaluate_closed_value_with_imports_opts_collecting_structs_and_facts(eval_value, funcs, externs, base_dir, globals, core_imports, GateSet.default(), 0, structs, methods, distinct_ranges, distinct_bases, unit_families, None, eval_items, build_facts, states[module_idx].fact_registry, checked_nominals)
                    // File-reading results depend on more than their reuse key.
                    if reuse == .Val(env) && reuse_key == .Val(key) && result.1.is_empty() -> env.record(key, result.0)
                    ^result
                }
            }
        } catch diagnostic {
            diags.push(^diagnostic)
            continue
        }
        v :: evaluated.0
        inputs :: evaluated.1
        record_comptime_import_alias_uses(&name_ledger, module_idx, eval_value, core_imports, globals)
        ty :: checked_ty.filter(_ -> module_value).unwrap_or_else(fn() { comptime_builtin_fixed_return_type(value, core_imports, v).unwrap_or_else(fn() { v.jet_type() }) })
        consts.insert(~name, ~ty)
        states[module_idx].consts.insert(~name, ~ty)
        if reuse == .Val(env) -> global_digests.insert(~name, env.value_digest(v))
        globals.insert(~name, ~v)
        if items[index] == .Const(c) {
            c.ty = Val(~ty)
            c.ct = Val(~v)
        }
        mirror_comptime_value(&states[module_idx], name, ty, v)
        if embed_inputs_out == .Val(out) -> out.extend(^inputs)
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:784
fn mirror_comptime_value(state: &ModuleState, name: String, ty: &Type, value: &CtValue) {
    loop item in &state.items {
        if item == .Const(constant) && constant.name == name {
            constant.ty = Val(~ty)
            constant.ct = Val(~value)
            return
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:802
fn comptime_reuse_context(base_dir: OSPath, core_imports: &[String:String], core_item_imports: &[String:String]) -> String {
    // The debug renderer retains OS-path escaping and sorted-map framing.
    imports := core_imports.keys().collect()
    imports.sort()
    items := core_item_imports.keys().collect()
    items.sort()
    ordered_imports :: imports.map(key -> (key, core_imports[key])).collect()
    ordered_items :: items.map(key -> (key, core_item_imports[key])).collect()
    // GATE #4500: canonical Rust-compatible sorted-map/path debug presentation.
    "{base_dir.debug()}{TEXT_NUL}{ordered_imports.debug_sorted_map()}{TEXT_NUL}{ordered_items.debug_sorted_map()}"
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:818
fn plain_literal_value(expr: &Expr) -> CtValue? {
    if expr == {
        .Int(value, _, None, None) -> Val(CtValue.Int(value))
        .Unary(UnOp.Neg, inner, _) -> if inner == { .Int(value, _, None, None) -> value.checked_neg().map(CtValue.Int); _ -> None }
        .Bool(value, _) -> Val(CtValue.Bool(value))
        .Char(value, _) -> Val(CtValue.Char(value))
        .Str(parts, _) -> {
            if parts.is_empty() -> return Val(CtValue.Str(""))
            if parts.len() == 1 && parts[0] == .Lit(text) -> return Val(CtValue.Str(~text))
            None
        }
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:841
pub fn resolve_comptime_declaration_values(items: &[Item], base_dir: OSPath, core_imports: &[String:String], diags: &[Diagnostic]) {
    (funcs, externs, globals) :: comptime_context_from_items(items)
    resolver := ComptimeTypeResolver{funcs: ^funcs, externs: ^externs, globals: ^globals, base_dir: base_dir, core_imports: core_imports, diags: diags, allow_symbolic_measures: false}
    resolver.resolve_items(&items)
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:860
struct ComptimeTypeResolver {
    funcs: [String:Func]
    externs: [String:Bool]
    globals: [String:CtValue]
    base_dir: OSPath
    core_imports: &[String:String]
    diags: &[Diagnostic]
    allow_symbolic_measures: Bool
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:870
#Error
enum IntegerFailure { Unknown; NonInteger(String); OutOfRange }

impl ComptimeTypeResolver {
    // Rust: crates/jet-sema/src/Sema/Registration/Items.rs:877
    fn resolve_items(self: &Self, items: &[Item]) {
        loop item in &items -> self.resolve_item(&item)
    }

    // Rust: crates/jet-sema/src/Sema/Registration/Items.rs:883
    fn resolve_item(self: &Self, item: &Item) {
        if item == {
            .Func(function) -> self.resolve_func(&function)
            .Struct(definition) -> {
                self.resolve_fields(&definition.fields)
                loop method in &definition.methods -> self.resolve_func(&method)
                loop implementation in &definition.trait_impls {
                    loop (_, _, ty) in &implementation.assoc_type_impls -> self.resolve_type(&ty)
                    loop method in &implementation.methods -> self.resolve_func(&method)
                }
            }
            .Enum(definition) -> {
                loop variant in &definition.variants {
                    if variant.payload == {
                        .Unit -> {}
                        .Single(ty, _) -> self.resolve_type(&ty)
                        .Named(fields) -> { loop field in &fields -> self.resolve_type(&field.ty) }
                    }
                    if variant.discriminant_expr.take() == .Val(expression) {
                        expression := ^expression
                        span :: expression.span()
                        self.resolve_expr_types(&expression)
                        try {
                            value :: self.evaluate_integer(expression)
                            if value >= I128.from(I64.MIN) && value <= I128.from(I64.MAX) {
                                variant.discriminant = Val(value as I64)
                            } else {
                                self.push_constant_error("E0035", "an enum discriminant is outside the signed integer range", "enum discriminants are stored as signed 64-bit values", "use a compile-time integer between -9223372036854775808 and 9223372036854775807", span)
                            }
                        } catch failure {
                            if failure == {
