//RS /// A handful of comptime builtins have a fixed, non-polymorphic return type
//RS /// regardless of arguments or result size — `find(glob)` always returns
//RS /// `[String]` (D-CTFIND1/2), even when the glob matches nothing. Naming that
//RS /// type here (rather than trusting `CtValue::jet_type()`, which samples the
//RS /// first element and has nothing to sample when the result is empty) is what
//RS /// lets codegen render a correctly-typed empty Rust collection instead of an
//RS /// ambiguous `vec![]` (see `ConstDef::ty`).
//RS fn comptime_builtin_fixed_return_type(
//RS     value: &Expr,
//RS     core_imports: &HashMap<String, String>,
//RS     evaluated: &crate::Comptime::CtValue,
//RS ) -> Option<Type> {
//RS     match value {
//RS         Expr::Call(call) if call.name == Syntax::BUILTIN_FIND => {
//RS             Some(Type::List(Box::new(Type::String)))
//RS         }
//RS         Expr::Call(call) if call.name == Syntax::BUILTIN_EMBED_FILE => Some(Type::String),
//RS         Expr::Call(call) if call.name == Syntax::BUILTIN_EMBED_BYTES => Some(Type::List(
//RS             Box::new(Type::IntN {
//RS                 signed: false,
//RS                 bits: 8,
//RS             }),
//RS         )),
//RS         Expr::MethodCall {
//RS             receiver, method, ..
//RS         } if matches!(receiver.as_ref(), Expr::Ident(alias, _)
//RS             if core_imports.get(alias).map(String::as_str) == Some("core.reactive.loadable")) =>
//RS         {
//RS             let unit = Type::Named("Unit".to_string());
//RS             let payload = match evaluated {
//RS                 crate::Comptime::CtValue::Enum { args, .. } => {
//RS                     args.first().map(|(_, value)| value.jet_type())
//RS                 }
//RS                 _ => None,
//RS             };
//RS             match method.as_str() {
//RS                 "idle" | "loading" => Some(Type::Apply {
//RS                     name: "Loadable".to_string(),
//RS                     args: vec![unit.clone(), unit],
//RS                 }),
//RS                 "loaded" => payload.map(|value| Type::Apply {
//RS                     name: "Loadable".to_string(),
//RS                     args: vec![value, unit],
//RS                 }),
//RS                 "failed" => payload.map(|error| Type::Apply {
//RS                     name: "Loadable".to_string(),
//RS                     args: vec![unit, error],
//RS                 }),
//RS                 _ => None,
