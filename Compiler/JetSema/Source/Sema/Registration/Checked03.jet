//RS                 }
//RS                 for block in &s.trait_impls {
//RS                     for m in &block.methods {
//RS                         funcs.insert(m.name.clone(), m.clone());
//RS                     }
//RS                 }
//RS             }
//RS             Item::Enum(e) => {
//RS                 for m in &e.methods {
//RS                     funcs.insert(m.name.clone(), m.clone());
//RS                 }
//RS             }
//RS             Item::Impl(i) => {
//RS                 for m in &i.methods {
//RS                     funcs.insert(m.name.clone(), m.clone());
//RS                 }
//RS             }
//RS             Item::Const(c) if c.is_comptime => {
//RS                 if let Some(v) = &c.ct {
//RS                     globals.insert(c.name.clone(), v.clone());
//RS                 }
//RS             }
//RS             // An immutable literal module constant is its own value, so build-
//RS             // time code (a `prep { … }` block, a prepared value) reads it like
//RS             // a prepared one; literal data values already carry `ct`.
