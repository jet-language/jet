//RS             Item::EffectDecl(_)
//RS             | Item::Test(_)
//RS             | Item::Const(_)
//RS             | Item::Trait(_)
//RS             | Item::Tag(_) // D-QUAL2: tags contribute no comptime context
//RS             | Item::Module(_)
//RS             | Item::CModule(_) | Item::CodeModule(_)
//RS             | Item::Distinct(_)
//RS             | Item::TypeAlias(_) // D-TYPEALIAS1: erases at codegen
//RS             | Item::UnitFamily(_) // D-QUAL3: contributes no comptime context
//RS             | Item::ErrorConv(_)
//RS             | Item::Migration(_) // D-MIGRATE1
//RS             | Item::ProtocolDecl(_) // D-PROTO1/D-PROTO2
//RS             | Item::UserDerive(_) // D-METADERIVE1=A: expanded in Bundle.rs
//RS             | Item::TemplateLoop(_) // D-STRUCT-ONCE1=A: expanded before registration
//RS             | Item::GenericModule(_) // D-CONF-GENSPELL1=A: template — erases
//RS             | Item::ModuleAlias(_) => {} // D-CONF-GENSPELL1=A: alias — erases after expansion
//RS             Item::MarkerDecl(_) | Item::FactDecl(_) => {
//RS                 unreachable!("declaration items are consumed by the bundle registry")
