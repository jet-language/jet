//RS         Expr::Bool(_, _) => Some(Type::Bool),
//RS         Expr::Char(_, _) => (!c.mutable).then_some(Type::Char),
//RS         Expr::Str(parts, _)
//RS             if !c.mutable && matches!(parts.as_slice(), [crate::AST::StrPart::Lit(_)]) =>
//RS         {
//RS             Some(Type::String)
//RS         }
//RS         _ => supported_module_array_type(c),
//RS     }
//RS }
//RS 
//RS /// D-MODULE-VALUE1: an unmarked immutable module constant whose value is
//RS /// literal data beyond the scalar forms (a struct, enum case, list, or map
//RS /// literal, nested freely). The compile-time evaluator folds it once, exactly
//RS /// like `@name :: value`, and every tier reads the folded value as an ordinary
//RS /// module constant.
//RS fn module_value_const(c: &crate::AST::ConstDef) -> bool {
//RS     !c.is_comptime
//RS         && !c.mutable
//RS         && !c.is_persist
//RS         && !matches!(&c.ty, Some(Type::Named(name)) if name == Syntax::TYPE_OUTPUT || name == Syntax::TYPE_OUTPUT_DEFAULTS)
//RS         && module_scalar_const_type(c).is_none()
//RS         && module_literal_value(&c.value)
//RS }
