// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1379
fn comptime_builtin_fixed_return_type(value: &Expr, core_imports: &[String:String], evaluated: &CtValue) -> Type? {
    if value == {
        .Call(call) && call.name == Syntax.BUILTIN_FIND -> Val(Type.List(Type.String))
        .Call(call) && call.name == Syntax.BUILTIN_EMBED_FILE -> Val(Type.String)
        .Call(call) && call.name == Syntax.BUILTIN_EMBED_BYTES -> Val(Type.List(Type.IntN(signed: false, bits: 8)))
        .MethodCall(receiver: receiver, method: method, ..) -> {
            if receiver != .Ident(alias, _) || core_imports.get(alias) != Val("core.reactive.loadable") -> return None
            unit :: Type.Named("Unit")
            payload :: if evaluated == { .Enum(args: args, ..) -> args.first().map(arg -> arg.1.jet_type()); _ -> None }
            if method == {
                "idle" | "loading" -> Val(Type.Apply(name: "Loadable", args: [~unit, ^unit]))
                "loaded" -> payload.map(value -> Type.Apply(name: "Loadable", args: [value, unit]))
                "failed" -> payload.map(error -> Type.Apply(name: "Loadable", args: [unit, error]))
                _ -> None
            }
        }
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1434
pub fn comptime_context_from_items(items: &[Item]) -> ([String:Func], [String:Bool], [String:CtValue]) {
    funcs := [String:Func]{}
    externs := [String:Bool]{}
    globals := [String:CtValue]{}
    loop item in items {
        if item == {
            .Func(f) -> funcs.insert(~f.name, ~f)
            .Struct(s) -> {
                loop m in s.methods -> funcs.insert(~m.name, ~m)
                loop block in s.trait_impls {
                    loop m in block.methods -> funcs.insert(~m.name, ~m)
                }
            }
            .Enum(e) -> { loop m in e.methods -> funcs.insert(~m.name, ~m) }
            .Impl(i) -> { loop m in i.methods -> funcs.insert(~m.name, ~m) }
            .Const(c) && c.is_comptime -> {
                if c.ct == .Val(v) -> globals.insert(~c.name, ~v)
            }
            .Const(c) && !c.mutable && !c.is_persist -> {
                if c.ct.map(value -> ~value).or_else(fn() { plain_literal_value(c.value) }) == .Val(v) -> globals.insert(~c.name, ^v)
            }
            .ExternRust(b) -> { loop ef in b.functions -> externs.insert(~ef.name, true) }
            // Bundle consumes declaration items before this context projection.
            .MarkerDecl(_) | .FactDecl(_) -> continue
            .EffectDecl(_) | .Test(_) | .Const(_) | .Trait(_) | .Tag(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .UserDerive(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) -> {}
        }
    }
    (^funcs, ^externs, ^globals)
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1515
fn supported_module_array_type(c: &ConstDef) -> Type? {
    if c.mutable || c.is_comptime -> return None
    if c.value != .TypedLit(head: .Val(.List(element)), body: body, ..) -> return None
    if element != Type.Int && element != Type.IntN(signed: false, bits: 8) -> return None
    elements :: if body == { .Elements(elements) -> elements; .Empty -> return Val(Type.List(~element)); _ -> return None }
    supported :: if element == {
        .Int -> elements.all(value -> if value == { .Int(..) -> true; _ -> false })
        .IntN(signed: false, bits: 8) -> elements.all(value -> {
            if value != .Int(number, _, _, raw) -> return false
            exact :: exact_integer_literal(number, raw)
            exact_integer_fits(exact, 0, 255)
        })
        _ -> false
    }
    if supported { Val(Type.List(~element)) } else { None }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1558
pub fn register_const(c: &ConstDef, consts: &[String:Type], diags: &[Diagnostic], funcs: &[String:FuncSig], registry: &TypeRegistry) {
    if name_defined(c.name, funcs, registry, consts) {
        diags.push(defined_twice(c.name, "every const needs a unique name", c.name_span))
        return
    }
    if c.is_comptime -> return
    if c.ty == .Val(.Named(name)) && (name == Syntax.TYPE_OUTPUT || name == Syntax.TYPE_OUTPUT_DEFAULTS) {
        consts.insert(~c.name, ~(c.ty ?? unreachable("matched explicit output type")))
        return
    }
    if module_value_const(c) -> return
    if module_scalar_const_type(c) == .Val(t) {
        consts.insert(~c.name, ^t)
    } else {
        storage :: c.mutable || c.is_persist
        why :: if storage { "a mutable or `#Persist` module global is runtime storage, which every execution tier initializes from a scalar literal before `fn run`" } else { "a module constant is folded once while building, so its value must be literal data: numbers, text, typed literals, and enum cases" }
        fix :: if storage { "use an integer, float, or bool literal, or keep struct and list values in an unmarked `::` constant" } else { "write the value as literal data, such as `RGB{r: U8{0}, g: U8{0}, b: U8{0}}`, prepare it while building with `NAME :: prep { value }`, or compute it inside a function" }
        diags.push(Diagnostic.error("E0622", "a module binding's value must be a literal", why, fix, Val(c.value.span())))
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1620
fn module_scalar_const_type(c: &ConstDef) -> Type? {
    if c.value == {
        .Int(..) -> Val(Type.Int)
        .Float(..) -> Val(Type.Float)
        .Bool(..) -> Val(Type.Bool)
        .Char(..) -> if !c.mutable { Val(Type.Char) } else { None }
        .Str(parts, _) && !c.mutable && parts.len() == 1 && if parts[0] == { .Lit(_) -> true; _ -> false } -> Val(Type.String)
        _ -> supported_module_array_type(c)
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1640
fn module_value_const(c: &ConstDef) -> Bool {
    output :: c.ty.is_some_and(ty -> if ty == { .Named(name) -> name == Syntax.TYPE_OUTPUT || name == Syntax.TYPE_OUTPUT_DEFAULTS; _ -> false })
    !c.is_comptime && !c.mutable && !c.is_persist && !output && module_scalar_const_type(c) == None && module_literal_value(c.value)
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1651
pub fn const_evaluated_at_build(c: &ConstDef) -> Bool { c.is_comptime || module_value_const(c) }

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1657
fn module_literal_value(expr: &Expr) -> Bool {
    // Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1658
    fn type_path(expr: &Expr) -> Bool {
        // Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1659
        upper :: fn(name: String) { name.chars().first().is_some_and(char -> char.is_uppercase()) }
        if expr == { .Ident(name, _) -> upper(name); .Field(base, member, _) -> upper(member) && type_path(base); _ -> false }
    }
    if expr == {
        .Int(..) | .Float(..) | .Bool(..) | .Char(..) | .Unit(_) | .Absent(_) -> true
        .Str(parts, _) -> parts.all(part -> if part == { .Lit(_) -> true; _ -> false })
        .Unary(UnOp.Neg, operand, _) -> if operand == { .Int(..) | .Float(..) -> true; _ -> false }
        .Present(inner, _) -> module_literal_value(inner)
        .ListLit(values, _) -> values.all(module_literal_value)
        .MapLit(entries, _) -> entries.all(entry -> module_literal_value(entry.0) && module_literal_value(entry.1))
        .StructLit(fields: fields, ..) -> fields.all(field -> module_literal_value(field.2))
        .TypedLit(body: body, ..) -> {
            literal := true
            body.for_each_expr(fn(value) { literal = literal && module_literal_value(value) })
            literal
        }
        .EnumLit(args: args, ..) -> args.all(arg -> if arg == { .Positional(value) | .Named(expr: value, ..) -> module_literal_value(value) })
        .Field(..) -> type_path(expr)
        .MethodCall(receiver: receiver, method: method, args: args, type_args: type_args, ..) -> type_args.is_empty() && method.chars().first().is_some_and(char -> char.is_uppercase()) && type_path(receiver) && args.all(arg -> module_literal_value(arg.expr))
        _ -> false
    }
}
