use jet_foundation.[AccessConvention, CtValue, Diagnostic, EnumDef, Expr, Func, Item, Span, StructDef, StructLayout, Type, VariantPayload]
use jet_foundation.Layout.[TargetLayout]
use jet_foundation.Names.[mangle_path]
use jet_foundation.CoreSourceParts.[CORE_TEXT_STRING_ALIAS]
use jet_sema.[FuncSig, MethodSig, ModuleState, NameLedger, ReceiptSectionMeta, Syntax, TypeDef, TypeRegistry, deprecation_from_markers, func_to_method_sig]
use jet_sema.CheckerCore.[reject_never_value_positions]
use jet_sema.Registration.Items.[is_reserved_type, name_defined, defined_twice, validate_layout_alignment, declared_type_contains_cell_guard, cell_guard_storage_diagnostic, is_money_like_name, allows_float_money, receipt_schema_digest, method_field_clash, method_defined_twice, check_default_forward_refs]
use jet_sema.Registration.Derives.[normalize_variant_payload]

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1709
pub fn register_struct(s: &StructDef, registry: &TypeRegistry, diags: &[Diagnostic], funcs: &[String:FuncSig], consts: &[String:Type], target: &TargetLayout) {
    if is_reserved_type(s.name) {
        &diags.push(Diagnostic.error("E0106", "the name `{s.name}` is built in and can't be redefined", "`{s.name}` is provided by the language itself", "choose a different name for this struct", Val(s.name_span)))
        return
    }
    if name_defined(s.name, funcs, registry, consts) {
        &diags.push(defined_twice(s.name, "every struct needs a unique name", s.name_span))
        return
    }
    validate_layout_alignment(s, target, &diags)
    field_names := [String:Bool]{}
    fields := [(String, Span, Type)]{}
    computed_fields := [String:(Span, Type)]{}
    field_defaults := [String:Expr]{}
    loop f in s.fields {
        reject_never_value_positions(&f.ty, f.ty_span, false, &diags)
        if field_names.contains_key(f.name) -> &diags.push(Diagnostic.error("E0105", "field `{f.name}` is defined twice in `{s.name}`", "each field name may appear only once", "rename or remove the duplicate field", Val(f.name_span)))
        &field_names.insert(f.name, true)
        if f.computed != None -> &computed_fields.insert(f.name, (f.name_span, f.ty.clone()))
        else {
            &fields.push((f.name, f.name_span, f.ty.clone()))
            if f.default == .Val(default) -> &field_defaults.insert(f.name, default.clone())
            if declared_type_contains_cell_guard(&f.ty) -> &diags.push(cell_guard_storage_diagnostic("struct field `{f.name}`", f.name_span))
        }
        if f.ty == .Named(Syntax.TYPE_TASKGROUP) -> &diags.push(Diagnostic.error("E1110", "`Group` cannot be stored in a struct field", "a task group is a scoped spawn authority, not a value that can escape its call stack", "pass `group: Group` directly to a helper function or method instead", Val(f.name_span)))
        if f.ty.is_float() && is_money_like_name(f.name) && !allows_float_money(&f.serde_markers) && !allows_float_money(&s.serde_markers) -> &diags.push(Diagnostic.lint("L0504", "field `{f.name}` looks like money but has type `Float`", "floating-point money loses cents on common values like `0.1 + 0.2`", "use `Decimal` for exact money, or suppress with `#[allow(float_money)]` on the field", Val(f.name_span)))
    }
    loop marker in s.type_markers {
        if marker.name != Syntax.MARKER_RECEIPT || marker.negated -> next
        codable :: s.type_markers.any(candidate -> candidate.name == Syntax.MARKER_CODABLE && !candidate.negated)
        if !codable -> &diags.push(Diagnostic.error("E2411", "receipt section type `{s.name}` must be `#Codable`", "typed receipt sections use the shared Codable wire contract", "add `#Codable` beside `#Receipt`", Val(marker.span)))
        else if marker.ct == .Val(.Str(section_name)) {
            if section_name.len() == 0 || section_name.len() > 128 || !section_name.chars().all(ch -> !ch.is_control() && ch != '/' && ch != '\\') -> &diags.push(Diagnostic.error("E0103", "`#Receipt` section name is invalid", "section names are bounded and cannot contain path separators", "use a non-empty name of at most 128 bytes", Val(marker.span)))
            else -> &registry.receipt_sections.insert(s.name, ReceiptSectionMeta{name: section_name, type_name: s.name, schema_digest: receipt_schema_digest(s.name, &fields), span: marker.span})
        } else -> &diags.push(Diagnostic.error("E0103", "`#Receipt` requires one compile-time string name", "receipt section identity is fixed at declaration time", "write `#Receipt(\"name\")`", Val(marker.span)))
        break
    }
    &registry.types.insert(s.name, TypeDef.Struct{fields: ^fields, methods: [String:MethodSig]{}, deprecation: deprecation_from_markers(&s.type_markers), single_use: s.is_single_use, must_use: s.is_must_use, columnar: s.layout.is_some_and(layout -> layout == .Columnar), is_c_layout: s.layout.is_some_and(layout -> layout.is_c()), published: s.is_published_schema || s.derives.any(pair -> pair.0 == Syntax.MARKER_PUBLISHED_SCHEMA)})
    if s.type_markers.any(marker -> marker.name == Syntax.MARKER_ERROR) -> &registry.error_types.insert(s.name, true)
    if computed_fields.len() > 0 -> &registry.computed_fields.insert(s.name, ^computed_fields)
    if field_defaults.len() > 0 -> &registry.field_defaults.insert(s.name, ^field_defaults)
    if s.layout.is_some_and(layout -> layout.is_c()) {
        loop f in s.fields {
            growable :: if f.ty == { .List(_) | .Map(_, _, _) | .String -> true; else -> false }
            if !growable -> next
            layout_span :: s.layout_span ?? s.name_span
            layout_name :: if s.layout == {
                .Val(.CAligned(_, true)) -> "#Layout(c, align(target, N))"
                .Val(.CAligned(_, _)) -> "#Layout(c, align(N))"
                else -> "#Layout(c)"
            }
            &diags.push(Diagnostic.error("E1104", "{layout_name} struct `{s.name}` has a growable field `{f.name}` ({f.ty.name()})", "growable types (`[T]`, `Map`, `String`) don't have a stable C layout", "use a fixed-size array `[T#N]` instead, or remove {layout_name}", Val(layout_span)))
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1932
pub fn check_strong_shared_cycles(states: &[ModuleState], name_ledger: &NameLedger, diags: &[Diagnostic]) {
    graph := StrongSharedCycleGraph.new(states, name_ledger)
    struct_ids := graph.structs.keys().collect()
    &struct_ids.sort()
    loop owner in struct_ids {
        fields :: graph.structs.get(owner) ?? next
        loop (fname, fspan, fty) in fields {
            stack := [StructId]{}
            if graph.strong_shared_cycle_witness(&owner, owner.module, &fty, &stack) == .Val(through) -> &diags.push(Diagnostic.error("E0221", "field `{fname}` on `{owner.name}` can form a strong `Shared` cycle", "a strong `Shared` edge through `{through}` can point back at `{owner.name}`, so reference counting alone cannot free the graph", "use `Shared.Weak<T>` for intentional back-edges, or store an id instead of a strong `Shared` handle", Val(fspan)))
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1969
struct StrongSharedCycleGraph {
    states: &[ModuleState]
    name_ledger: &NameLedger
    // GATE #4499: exact StructId and (StructId, StructId) hash/equality keys.
    structs: [StructId:[(String, Span, Type)]]
    reaches: [(StructId, StructId):Bool]
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1977
#Derive(Clone, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)
struct StructId {
    module: USize
    name: String
}
impl StructId {
    // Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1983
    fn new(module: USize, name: String) -> Self { Self{module: module, name: name} }
}
impl StrongSharedCycleGraph {
    // Rust: crates/jet-sema/src/Sema/Registration/Items.rs:1992
    fn new(states: &[ModuleState], name_ledger: &NameLedger) -> Self {
        structs := [StructId:[(String, Span, Type)]]{}
        loop module in 0..states.len() {
            loop (name, def) in states[module].registry.types {
                if def == .Struct(fields: fields) -> &structs.insert(StructId.new(module, name), fields.clone())
            }
        }
        Self{states: states, name_ledger: name_ledger, structs: ^structs, reaches: [(StructId, StructId):Bool]{}}
    }

    // Rust: crates/jet-sema/src/Sema/Registration/Items.rs:2009
    fn struct_key(self: &Self, module: USize, name: String) -> StructId? {
        key :: StructId.new(module, name)
        if self.structs.contains_key(key) -> Val(^key) else -> None
    }

    // Rust: crates/jet-sema/src/Sema/Registration/Items.rs:2014
    fn imported_struct(self: &Self, from_module: USize, namespace: String, name: String) -> StructId? {
        if from_module >= self.states.len() -> return None
        owner :: self.states[from_module].imports.get(namespace) ?? self.name_ledger.alias(from_module, namespace).and_then(alias -> alias.target_module) ?? return None
        key :: self.struct_key(owner, name) ?? return None
        if self.name_ledger.visible(from_module, owner, name) -> Val(^key) else -> None
    }

    // Rust: crates/jet-sema/src/Sema/Registration/Items.rs:2032
    fn resolve_struct(self: &Self, from_module: USize, name: String) -> StructId? {
        if self.struct_key(from_module, name) == .Val(key) -> return Val(^key)
        if name.rsplit_once("::") == .Val((namespace, leaf)) {
            if self.name_ledger.nominal_module(name) == .Val(owner) {
                if self.struct_key(owner, leaf) == .Val(key) -> return Val(^key)
            }
            return self.imported_struct(from_module, namespace, leaf)
        }
        if name.rsplit_once(".") == .Val((namespace, leaf)) {
            if self.imported_struct(from_module, namespace, leaf) == .Val(key) -> return Val(^key)
        }
        if self.name_ledger.alias(from_module, name) == .Val(alias) {
            if alias.target_module == .Val(owner) {
                leaf :: (alias.target.rsplit_once("::") ?? alias.target.rsplit_once(".")).map(pair -> pair.1) ?? alias.target
                if self.struct_key(owner, leaf) == .Val(key) {
                    if self.name_ledger.visible(from_module, owner, leaf) -> return Val(^key)
                }
            }
        }
        found := StructId?{None}
        loop key in self.structs.keys() {
            if key.name != name || !self.name_ledger.visible(from_module, key.module, name) -> next
            if found.is_some_and(previous -> previous != key) -> return None
            found = Val(key.clone())
        }
        ^found
    }

    // Rust: crates/jet-sema/src/Sema/Registration/Items.rs:2080
    fn strong_shared_cycle_witness(self: &Self, owner: &StructId, from_module: USize, ty: &Type, stack: &[StructId]) -> String? {
        if ty == {
            .Shared(inner) -> if self.payload_can_reach_owner(owner, from_module, &inner) -> Val(inner.name()) else -> None
            .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) -> self.strong_shared_cycle_witness(owner, from_module, &inner, &stack)
            .Map(key, _, value) | .Result(key, value) -> self.strong_shared_cycle_witness(owner, from_module, &key, &stack) ?? self.strong_shared_cycle_witness(owner, from_module, &value, &stack)
            .Tuple(fields) -> {
                loop field in fields {
                    if self.strong_shared_cycle_witness(owner, from_module, &field.ty, &stack) == .Val(hit) -> return Val(hit)
                }
                None
            }
            .Union(members) -> {
                loop member in members {
                    if self.strong_shared_cycle_witness(owner, from_module, &member, &stack) == .Val(hit) -> return Val(hit)
                }
                None
            }
            .Apply(name, args) -> {
                if name == Syntax.TYPE_SHARED_WEAK -> return None
                loop member in args {
                    if self.strong_shared_cycle_witness(owner, from_module, &member, &stack) == .Val(hit) -> return Val(hit)
                }
                None
            }
            .Named(name) -> {
                target :: self.resolve_struct(from_module, name) ?? return None
                if stack.any(s -> s == target) -> return None
                &stack.push(target.clone())
                hit := String?{None}
                if self.structs.get(target) == .Val(fields) {
                    loop (_, _, fty) in fields {
                        hit = self.strong_shared_cycle_witness(owner, target.module, &fty, &stack)
                        if hit != None -> break
                    }
                }
                _ :: &stack.pop()
                ^hit
            }
            else -> None
        }
    }

    // Rust: crates/jet-sema/src/Sema/Registration/Items.rs:2140
    fn payload_can_reach_owner(self: &Self, owner: &StructId, from_module: USize, ty: &Type) -> Bool {
        active := [StructId:Bool]{} // GATE #4499
        self.payload_can_reach_owner_inner(owner, from_module, ty, &active).0
    }

    // Rust: crates/jet-sema/src/Sema/Registration/Items.rs:2146
    fn payload_can_reach_owner_inner(self: &Self, owner: &StructId, from_module: USize, ty: &Type, active: &[StructId:Bool]) -> (Bool, Bool) {
        if ty == {
            .Named(name) -> {
                target :: self.resolve_struct(from_module, name) ?? return (false, false)
                if target == owner -> return (true, false)
                key :: (owner.clone(), target.clone())
                if self.reaches.get(key) == .Val(reaches) -> return (reaches, false)
                if active.contains_key(target) -> return (false, true)
                &active.insert(target.clone(), true)
                reaches := false
                cycle_cut := false
                if self.structs.get(target) == .Val(fields) {
                    loop (_, _, fty) in fields {
                        (hit, cut) :: self.payload_can_reach_owner_inner(owner, target.module, &fty, &active)
                        cycle_cut = cycle_cut || cut
                        if hit { reaches = true; break }
                    }
                }
                _ :: &active.remove(target)
                // A cycle-cut negative must not poison the memo for later sibling edges.
                if reaches || !cycle_cut -> &self.reaches.insert(^key, reaches)
                (reaches, cycle_cut)
            }
            .Shared(inner) | .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) -> self.payload_can_reach_owner_inner(owner, from_module, &inner, &active)
            .Map(key, _, value) | .Result(key, value) -> {
                (key_reaches, key_cycle) :: self.payload_can_reach_owner_inner(owner, from_module, &key, &active)
                if key_reaches -> return (true, key_cycle)
                (value_reaches, value_cycle) :: self.payload_can_reach_owner_inner(owner, from_module, &value, &active)
                (value_reaches, key_cycle || value_cycle)
            }
            .Tuple(fields) -> {
                cycle_cut := false
                loop field in fields {
                    (reaches, cut) :: self.payload_can_reach_owner_inner(owner, from_module, &field.ty, &active)
                    cycle_cut = cycle_cut || cut
                    if reaches -> return (true, cycle_cut)
                }
                (false, cycle_cut)
            }
            .Union(members) -> {
                cycle_cut := false
                loop member in members {
                    (reaches, cut) :: self.payload_can_reach_owner_inner(owner, from_module, &member, &active)
                    cycle_cut = cycle_cut || cut
                    if reaches -> return (true, cycle_cut)
                }
                (false, cycle_cut)
            }
            .Apply(name, args) -> {
                if name == Syntax.TYPE_SHARED_WEAK -> return (false, false)
                cycle_cut := false
                loop member in args {
                    (reaches, cut) :: self.payload_can_reach_owner_inner(owner, from_module, &member, &active)
                    cycle_cut = cycle_cut || cut
                    if reaches -> return (true, cycle_cut)
                }
                (false, cycle_cut)
            }
            else -> (false, false)
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:2253
pub fn register_enum(e: &EnumDef, registry: &TypeRegistry, diags: &[Diagnostic], funcs: &[String:FuncSig], consts: &[String:Type]) {
    if is_reserved_type(e.name) {
        &diags.push(Diagnostic.error("E0106", "the name `{e.name}` is built in and can't be redefined", "`{e.name}` is provided by the language itself", "choose a different name for this enum", Val(e.name_span)))
        return
    }
    if name_defined(e.name, funcs, registry, consts) {
        &diags.push(defined_twice(e.name, "every enum needs a unique name", e.name_span))
        return
    }
    variants := [String:(Span, VariantPayload)]{}
    variant_order := [String]{}
    seen := [String:Bool]{}
    mangled := [String:String]{}
    loop v in e.variants {
        if seen.contains_key(v.name) {
            &diags.push(Diagnostic.error("E0105", "variant `{v.name}` is defined twice in `{e.name}`", "each variant name may appear only once", "rename or remove the duplicate variant", Val(v.name_span)))
            next
        }
        &seen.insert(v.name, true)
        mangled_name :: mangle_path(v.name)
        other :: mangled.get(mangled_name)
        &mangled.insert(mangled_name, v.name)
        if other == .Val(other) {
            &diags.push(Diagnostic.error("E0105", "variant `{v.name}` collides with `{other}` in `{e.name}`", "a grouped path and an underscored name flatten to the same variant", "rename one of the two variants", Val(v.name_span)))
            next
        }
        &variant_order.push(v.name)
        if v.payload == {
            .Unit -> {}
            .Single(ty, span) -> { if declared_type_contains_cell_guard(&ty) -> &diags.push(cell_guard_storage_diagnostic("enum variant `{v.name}`", span)) }
            .Named(fields) -> {
                loop field in fields { if declared_type_contains_cell_guard(&field.ty) -> &diags.push(cell_guard_storage_diagnostic("enum field `{field.name}`", field.name_span)) }
            }
        }
        payload := v.payload.clone()
        normalize_variant_payload(&payload, e.name)
        &variants.insert(v.name, (v.name_span, ^payload))
    }
    groups := [String:(Span, [String])]{}
    loop g in e.groups {
        if variants.contains_key(g.path) || groups.contains_key(g.path) {
            &diags.push(Diagnostic.error("E0105", "variant `{g.path}` is defined twice in `{e.name}`", "a group name and a variant name share one namespace", "rename or remove the duplicate variant", Val(g.name_span)))
            next
        }
        prefix :: "{g.path}."
        leaves :: variant_order.filter(v -> v.starts_with(prefix)).collect()
        &groups.insert(g.path, (g.name_span, ^leaves))
    }
    &registry.types.insert(e.name, TypeDef.Enum{variants: ^variants, variant_order: ^variant_order, groups: ^groups, methods: [String:MethodSig]{}, deprecation: deprecation_from_markers(&e.type_markers), single_use: e.is_single_use, must_use: e.is_must_use, c_layout_tag: e.c_layout_tag()})
    if e.type_markers.any(marker -> marker.name == Syntax.MARKER_ERROR) -> &registry.error_types.insert(e.name, true)
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:2380
pub fn register_type_methods(items: &[Item], registry: &TypeRegistry, diags: &[Diagnostic]) {
    register_type_methods_inner(items, registry, &diags, true)
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:2388
pub fn register_missing_type_methods(items: &[Item], registry: &TypeRegistry, diags: &[Diagnostic]) {
    register_type_methods_inner(items, registry, &diags, false)
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:2396
fn register_type_methods_inner(items: &[Item], registry: &TypeRegistry, diags: &[Diagnostic], error_on_duplicate: Bool) {
    loop item in items {
        methods := [&Func]{}
        field_names := [String]{}
        type_name :: if item == {
            .Struct(s) -> {
                loop m in s.methods -> &methods.push(&m)
                loop block in s.trait_impls { loop m in block.methods -> &methods.push(&m) }
                field_names = registry.field_names(s.name)
                s.name
            }
            .Enum(e) -> {
                loop m in e.methods -> &methods.push(&m)
                loop block in e.trait_impls { loop m in block.methods -> &methods.push(&m) }
                e.name
            }
            else -> next
        }
        type_def :: &registry.types.get_mut(type_name) ?? next
        methods_map :: if type_def == {
            .Struct(methods: methods) | .Enum(methods: methods) -> &methods
            .Distinct | .Alias -> next
        }
        loop m in methods {
            if field_names.any(f -> f == m.name) -> &diags.push(method_field_clash(m.name, type_name, m.name_span))
            if methods_map.contains_key(m.name) {
                if !error_on_duplicate -> next
                &diags.push(method_defined_twice(m.name, type_name, m.name_span, m.self_param() == None))
            } else {
                if m.is_pub {
                    loop p in m.params {
                        if p.name != "self" && p.ty == .Bool && p.default == None -> &diags.push(Diagnostic.lint("L2401", "public method `{m.name}` has a positional `Bool` parameter `{p.name}`", "positional booleans are easy to transpose at the call site", "callers can write `{p.name}: true` to make the intent clear (S61 labels)", Val(p.name_span)))
                    }
                }
                non_self :: m.params.filter(p -> p.name != "self").collect()
                check_default_forward_refs(&non_self, m.name, &diags)
                &methods_map.insert(m.name, func_to_method_sig(m))
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:2480
pub fn register_impl_methods(items: &[Item], registry: &TypeRegistry, diags: &[Diagnostic]) {
    loop item in items {
        if item != .Impl(i) -> next
        if !registry.contains(i.type_name) -> next
        field_names :: registry.field_names(i.type_name)
        type_def :: &registry.types.get_mut(i.type_name) ?? next
        methods_map :: if type_def == {
            .Struct(methods: methods) | .Enum(methods: methods) -> &methods
            .Distinct | .Alias -> next
        }
        loop m in i.methods {
            if field_names.any(f -> f == m.name) -> &diags.push(method_field_clash(m.name, i.type_name, m.name_span))
            if methods_map.contains_key(m.name) -> &diags.push(method_defined_twice(m.name, i.type_name, m.name_span, m.self_param() == None))
            else {
                if m.is_pub {
                    loop p in m.params {
                        if p.name != "self" && p.ty == .Bool && p.default == None -> &diags.push(Diagnostic.lint("L2401", "public method `{m.name}` has a positional `Bool` parameter `{p.name}`", "positional booleans are easy to transpose at the call site", "callers can write `{p.name}: true` to make the intent clear (S61 labels)", Val(p.name_span)))
                    }
                }
                non_self :: m.params.filter(p -> p.name != "self").collect()
                check_default_forward_refs(&non_self, m.name, &diags)
                &methods_map.insert(m.name, func_to_method_sig(&m))
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Items.rs:2552
pub fn core_string_source_method(modules: &[ModuleState], method: String) -> Func? {
    loop module in modules {
        if module.module_alias != CORE_TEXT_STRING_ALIAS -> next
        loop item in module.items {
            if item == .Func(function) {
                if function.is_pub || function.name != method || function.params.len() == 0 -> next
                receiver :: &function.params[0]
                return if receiver.convention == .Read && receiver.ty == .String -> Val(function) else -> None
            }
        }
        return None
    }
    None
}
