// The impl contract check for the compiler-owned traits (OWNED_TRAITS in
// jet_foundation, each row the trait's declaration).
use jet_foundation.[AccessConvention, Diagnostic, Func, NamedType, OwnedMethod, OwnedTrait, Param, Span, Type, access_sigil, type_identity_equal, type_name]

// E0906, E0907 and E0913 for an impl of an owned trait on `owner_type`:
// `rhs` is an operator's right-hand type, `associated` the types the impl
// binds, `sibling` those the `shares` trait's impl binds, `distinct_base` the
// base of a `distinct` owner. Answers whether the impl meets the contract.
sema_owned_check_impl: fn(owned: OwnedTrait, owner_type: Type, rhs: Type, methods: [Func], associated: [NamedType], sibling: [NamedType], distinct_base: Type?, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if owned.contract == {
        .Methods(declared, names, _) -> sema_owned_check_methods(owned.name, declared, names, owner_type, methods, associated, sibling, span, diagnostics)
        .Operator(hook, result) -> sema_owned_check_operator(owned.name, hook, result, rhs, methods, span, diagnostics)
        .Codec(verb) -> sema_owned_check_codec(owned.name, verb, owner_type, methods, span, diagnostics)
        .Literal(source) -> sema_owned_check_literal(owned.name, source, owner_type, methods, span, diagnostics)
        .CheckedText -> sema_owned_check_checked_text(methods, associated, distinct_base, owner_type, span, diagnostics)
        .Derived -> true
    }
}

sema_owned_mismatch: fn(trait_name: String, method: String, expected: String, span: Span) -> Diagnostic {
    sema_error("E0907", span, "`{method}` doesn't match the `{trait_name}` contract", "a trait implementation must use the trait method's receiver, parameters, return type, and effects", "write {expected}, matching the `{trait_name}` declaration exactly, including `self`, types, labels, return type, and effects")
}

sema_owned_missing: fn(trait_name: String, missing: [String], span: Span) -> Diagnostic {
    names: loop name in missing -> "`{name}`"
    sema_error("E0906", span, "`impl …: {trait_name}` is missing {names.join(", ")}", "every `{trait_name}` method must appear in the impl block", "add the missing method signatures and bodies")
}

sema_owned_unbound: fn(trait_name: String, missing: [String], span: Span) -> Diagnostic {
    names: loop name in missing -> "`type {name}`"
    bindings: loop name in missing -> "`type {name} = …`"
    sema_error("E0913", span, "`impl …: {trait_name}` doesn't set {names.join(", ")}", "`{trait_name}` declares an associated type each impl must define", "add {bindings.join(", ")} inside the impl block")
}

// The owner's own name: `Email`, or `Box` for `Box<T>`.
sema_owned_owner_name: fn(owner_type: Type) -> String Never! {
    if owner_type == {
        .Named(name) | .Apply(name, _) -> name.copy()
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> type_name(owner_type)
    }
}

sema_owned_has_self: fn(method: Func) -> Bool Never! {
    method.params.len() > 0 && method.params[0].name == "self"
}

sema_owned_render: fn(method: OwnedMethod, names: [String], types: [Type]) -> String Never! {
    parts := [String]{}
    if method.receiver == {
        .Static -> {}
        .Any -> parts.push("self")
        .Fixed(access) -> parts.push("{access_sigil(access)}self")
    }
    loop param in method.params -> parts.push("{param.name}: {type_name(sema_inference_substitute_type(param.ty, names, types))}")
    rendered: "{method.name}: fn({parts.join(", ")})"
    if method.returns == .Val(returned) -> return "`{rendered} -> {type_name(sema_inference_substitute_type(returned, names, types))}`"
    "`{rendered}`"
}

// A result that can't fail (`T Never!`) is its value `T`.
sema_owned_infallible: fn(returned: Type) -> Type Never! {
    if returned == .Result(ok, err) && err == (Type.Named{name: "Never"}) -> return ok.copy()
    returned.copy()
}

// No value: an absent return, Unit, or a Unit result that can't fail.
sema_owned_returns_nothing: fn(returned: Type?) -> Bool Never! {
    written: returned ?? return true
    sema_owned_infallible(written) == (Type.Named{name: "Unit"})
}

// The receiver, the parameter types and the return type, with `Self` and
// the associated names resolved on both sides.
sema_owned_method_matches: fn(wanted: OwnedMethod, actual: Func, names: [String], types: [Type]) -> Bool Never! {
    has_self: sema_owned_has_self(actual)
    if wanted.receiver == {
        .Static -> if has_self -> return false
        .Any -> if !has_self -> return false
        .Fixed(access) -> if !has_self || actual.params[0].convention != access -> return false
    }
    offset: if has_self -> 1 else -> 0
    if actual.params.len() != wanted.params.len() + offset -> return false
    loop index in 0..<wanted.params.len() {
        written: sema_inference_substitute_type(actual.params[index + offset].ty, names, types)
        if !type_identity_equal(written, sema_inference_substitute_type(wanted.params[index].ty, names, types)) -> return false
    }
    if wanted.returns == .Val(expected) {
        returned: actual.return_type ?? return false
        return type_identity_equal(sema_inference_substitute_type(sema_owned_infallible(returned), names, types), sema_inference_substitute_type(expected, names, types))
    }
    sema_owned_returns_nothing(actual.return_type)
}

// Every method appears (E0906) and every associated type is bound (E0913;
// the signatures can't resolve without it, so nothing more is checked), then
// each declared method matches (E0907). Other methods are the impl's own.
sema_owned_check_methods: fn(trait_name: String, declared: [OwnedMethod], associated_names: [String], owner_type: Type, methods: [Func], associated: [NamedType], sibling: [NamedType], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    missing := [String]{}
    loop wanted in declared {
        present: loop method in methods {
            if method.name == wanted.name -> break true
        } ?? false
        if !present -> missing.push(wanted.name)
    }
    if missing.len() > 0 -> diagnostics.push(sema_owned_missing(trait_name, missing, span))
    names := [String]{"Self"}
    types := [Type]{owner_type.copy()}
    unbound := [String]{}
    loop name in associated_names {
        bound: loop binding in associated {
            if binding.name == name -> break Val(binding.ty.copy())
        } ?? None
        if bound == .Val(ty) {
            names.push(name.copy())
            types.push(ty)
        } else {
            unbound.push(name.copy())
        }
    }
    if unbound.len() > 0 {
        diagnostics.push(sema_owned_unbound(trait_name, unbound, span))
        return false
    }
    loop binding in sibling {
        if !names.contains(binding.name) {
            names.push(binding.name)
            types.push(binding.ty.copy())
        }
    }
    valid := missing.len() == 0
    loop method in methods {
        wanted: loop candidate in declared {
            if candidate.name == method.name -> break Val(candidate)
        } ?? None
        contract: wanted ?? next
        if !sema_owned_method_matches(contract, method, names, types) {
            valid = false
            diagnostics.push(sema_owned_mismatch(trait_name, method.name, sema_owned_render(contract, names, types), method.name_span))
        }
    }
    valid
}

// The hook has the shape operator identity needs: one method, a read
// `self`, a read right-hand side of the declared type, the trait's result
// and no type parameters.
sema_owned_operator_valid: fn(hook: String, result: Type?, rhs: Type, methods: [Func]) -> Bool Never! {
    if methods.len() != 1 -> return false
    method: methods[0]
    if method.name != hook || method.type_params.len() != 0 || method.params.len() < 2 -> return false
    receiver: method.params[0]
    if receiver.name != "self" || receiver.convention != AccessConvention.Read || receiver.variadic || receiver.default != None -> return false
    other: method.params[1]
    if other.convention != AccessConvention.Read || !type_identity_equal(other.ty, rhs) || other.variadic || other.default != None -> return false
    written: method.return_type ?? return false
    if result == .Val(expected) -> return type_identity_equal(sema_owned_infallible(written), expected)
    true
}

// E0906 when the hook method is missing (with E0907 at every other method),
// E0907 at a hook of the wrong shape and at every extra method.
sema_owned_check_operator: fn(trait_name: String, hook: String, result: Type?, rhs: Type, methods: [Func], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    result_text: if result == .Val(expected) -> type_name(expected) else -> "a declared result type"
    expected: "`{hook}: fn(self, rhs: {type_name(rhs)}) -> {result_text}`"
    hook_index: loop index in 0..<methods.len() {
        if methods[index].name == hook -> break Val(index)
    } ?? None
    found: hook_index ?? {
        diagnostics.push(sema_owned_missing(trait_name, [String]{hook}, span))
        loop method in methods -> diagnostics.push(sema_owned_mismatch(trait_name, hook, expected, method.name_span))
        return false
    }
    valid: sema_owned_operator_valid(hook, result, rhs, methods)
    if !valid -> diagnostics.push(sema_owned_mismatch(trait_name, hook, expected, methods[found].name_span))
    loop index in 0..<methods.len() {
        if index != found -> diagnostics.push(sema_owned_mismatch(trait_name, hook, expected, methods[index].name_span))
    }
    valid
}

// The dynamic encoding value and its format-tagged aliases.
sema_owned_codec_data: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "Dyn" || name == "JSON" || name == "TOML" || name == "YAML" || name == "CSV"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// A hand codec is its one method: `encode: fn(self) -> Dyn`, or the static
// `decode: fn(tree: Dyn) -> T [FieldError]!`.
sema_owned_check_codec: fn(trait_name: String, verb: String, owner_type: Type, methods: [Func], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    owner: sema_owned_owner_name(owner_type)
    encode: verb == "encode"
    expected: if encode -> "`encode: fn(self) -> Dyn`" else -> "`decode: fn(tree: Dyn) -> {owner} [FieldError]!`"
    valid := true
    saw_verb := false
    loop method in methods {
        if method.name != verb {
            valid = false
            diagnostics.push(sema_owned_mismatch(trait_name, method.name, "only `{verb}`", method.name_span))
            next
        }
        saw_verb = true
        has_self: sema_owned_has_self(method)
        values: loop param in method.params if param.name != "self" -> param.ty.copy()
        returns_data := false
        returns_owner := false
        if method.return_type == .Val(returned) {
            returns_data = sema_owned_codec_data(sema_owned_infallible(returned))
            if returned == .Result(ok, err) {
                ok_owner: if ok == {
                    .Named(name) -> name == owner || name == "Self"
                    .Apply(name, _) -> name == owner
                    .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
                }
                err_fields: if err == {
                    .List(inner) -> inner == (Type.Named{name: "FieldError"})
                    .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
                }
                returns_owner = ok_owner && err_fields
            }
        }
        shaped: if encode -> has_self && values.len() == 0 && returns_data else -> !has_self && values.len() == 1 && sema_owned_codec_data(values[0]) && returns_owner
        if !shaped {
            valid = false
            diagnostics.push(sema_owned_mismatch(trait_name, method.name, expected, method.name_span))
        }
    }
    if !saw_verb {
        diagnostics.push(sema_owned_missing(trait_name, [String]{verb}, span))
        return false
    }
    valid
}

// `#run from_literal: fn(value: Source) -> T`, once: the hook runs while
// building, on the literal's Int or on a Float's written digits.
sema_owned_check_literal: fn(trait_name: String, source: Type, owner_type: Type, methods: [Func], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    constructors: loop index in 0..<methods.len() if methods[index].name == "from_literal" -> index
    if constructors.len() == 0 {
        diagnostics.push(sema_owned_missing(trait_name, [String]{"from_literal"}, span))
        return false
    }
    owner: sema_owned_owner_name(owner_type)
    hook: methods[constructors[0]]
    valid := constructors.len() == 1 && hook.is_comptime && hook.type_params.len() == 0 && hook.params.len() == 1
    if valid {
        value: hook.params[0]
        valid = value.name != "self" && value.convention == AccessConvention.Read && type_identity_equal(value.ty, source) && value.default == None && !value.variadic
    }
    if valid {
        returned: hook.return_type ?? Type.Named{name: "Unit"}
        success: if returned == .Result(ok, _) -> ok else -> returned
        valid = if success == {
            .Named(name) | .Apply(name, _) -> name == owner
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
    }
    if !valid -> diagnostics.push(sema_owned_mismatch(trait_name, "from_literal", "`#run from_literal: fn(value: {type_name(source)}) -> {owner}`", hook.name_span))
    valid
}

// A read, unlabeled, non-variadic parameter without a default.
sema_owned_plain_param: fn(method: Func, ty: Type) -> Bool Never! {
    if method.params.len() != 1 -> return false
    param: method.params[0]
    param.name != "self" && param.convention == AccessConvention.Read && !param.variadic && param.default == None && param.public_label == None && type_identity_equal(param.ty, ty)
}

// A pure method: the empty effect row `-[]>`, or no row at all, which takes
// the trait's `-[]>` as its ceiling (the effect check holds the body to it,
// E0742).
sema_owned_pure: fn(method: Func) -> Bool Never! {
    if !method.is_pure -> return method.declared_effects == None && method.effect_via == None
    effects: method.declared_effects ?? return false
    effects.len() == 0
}

// `impl T.CheckedText`: one `type Error`, the pure checker
// `check: fn(text: String) Error! -[]>` and the pure hole encoder
// `encode_hole: fn<T: Printable>(value: T) -[]> Hole`. A type whose holes stay
// values binds `type Hole` and declares the pure assembler
// `build: fn(parts: [String], holes: [Hole]) -[]> T`; without `build` the owner
// is a `distinct String`, every hole encodes to String and the literal is the
// joined text.
sema_owned_check_checked_text: fn(methods: [Func], associated: [NamedType], distinct_base: Type?, owner_type: Type, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    trait_name: "CheckedText"
    owner_name: sema_owned_owner_name(owner_type)
    errors: loop index in 0..<associated.len() if associated[index].name == "Error" -> index
    hole_bindings: loop index in 0..<associated.len() if associated[index].name == "Hole" -> index
    builds: loop index in 0..<methods.len() if methods[index].name == "build" -> index
    error_type: if errors.len() > 0 -> associated[errors[0]].ty.copy() else -> Type.Named{name: "Error"}
    hole_type: if hole_bindings.len() > 0 -> associated[hole_bindings[0]].ty.copy() else -> Type.String
    error_name: type_name(error_type)
    hole_name: type_name(hole_type)
    check_expected: "`check: fn(text: String) {error_name}! -[]>`"
    hole_expected: "`encode_hole: fn<T: Printable>(value: T) -[]> {hole_name}`"
    build_expected: "`build: fn(parts: [String], holes: [{hole_name}]) -[]> {owner_name}`"
    string_backed: if distinct_base == .Val(base) -> type_identity_equal(base, Type.String) else -> false
    if !string_backed && builds.len() == 0 {
        diagnostics.push(sema_owned_mismatch(trait_name, "check", "{check_expected} on a `distinct String` type, or a `build` method that assembles `{owner_name}`", span))
        return false
    }
    count: diagnostics.len()
    if errors.len() == 0 -> diagnostics.push(sema_owned_unbound(trait_name, [String]{"Error"}, span))
    loop index in 1..<errors.len() -> diagnostics.push(sema_owned_mismatch(trait_name, "type Error", "one `type Error = …` binding", associated[errors[index]].span))
    loop index in 1..<hole_bindings.len() -> diagnostics.push(sema_owned_mismatch(trait_name, "type Hole", "one `type Hole = …` binding", associated[hole_bindings[index]].span))
    if hole_bindings.len() > 0 && builds.len() == 0 -> diagnostics.push(sema_owned_mismatch(trait_name, "type Hole", "a `build` method that receives the holes", associated[hole_bindings[0]].span))
    loop binding in associated {
        if binding.name != "Error" && binding.name != "Hole" -> diagnostics.push(sema_owned_mismatch(trait_name, "type {binding.name}", "only `type Error = …` and `type Hole = …`", binding.span))
    }
    checks: loop index in 0..<methods.len() if methods[index].name == "check" -> index
    holes: loop index in 0..<methods.len() if methods[index].name == "encode_hole" -> index
    if checks.len() == 0 -> diagnostics.push(sema_owned_missing(trait_name, [String]{"check"}, span))
    if holes.len() == 0 -> diagnostics.push(sema_owned_missing(trait_name, [String]{"encode_hole"}, span))
    loop index in 1..<checks.len() -> diagnostics.push(sema_owned_mismatch(trait_name, "check", check_expected, methods[checks[index]].name_span))
    loop index in 1..<holes.len() -> diagnostics.push(sema_owned_mismatch(trait_name, "encode_hole", hole_expected, methods[holes[index]].name_span))
    loop index in 1..<builds.len() -> diagnostics.push(sema_owned_mismatch(trait_name, "build", build_expected, methods[builds[index]].name_span))
    if checks.len() > 0 {
        check: methods[checks[0]]
        check_ok := check.type_params.len() == 0 && sema_owned_plain_param(check, Type.String) && sema_owned_pure(check) && errors.len() > 0
        if check_ok {
            check_ok = false
            if check.return_type == .Val(returned) {
                if returned == .Result(ok, err) -> check_ok = ok == (Type.Named{name: "Unit"}) && type_identity_equal(err, error_type)
            }
        }
        if !check_ok -> diagnostics.push(sema_owned_mismatch(trait_name, "check", check_expected, check.name_span))
    }
    if holes.len() > 0 {
        hole: methods[holes[0]]
        hole_ok := sema_owned_plain_param(hole, Type.Named{name: "T"}) && sema_owned_pure(hole) && hole.type_params.len() == 1
        if hole_ok -> hole_ok = hole.type_params[0].name == "T" && hole.type_params[0].bounds == ([String]{"Printable"})
        if hole_ok -> hole_ok = if hole.return_type == .Val(returned) -> type_identity_equal(returned, hole_type) else -> false
        if !hole_ok -> diagnostics.push(sema_owned_mismatch(trait_name, "encode_hole", hole_expected, hole.name_span))
    }
    if builds.len() > 0 {
        build: methods[builds[0]]
        build_ok := build.type_params.len() == 0 && sema_owned_pure(build) && build.params.len() == 2
        if build_ok -> build_ok = sema_owned_list_param(build.params[0], Type.String) && sema_owned_list_param(build.params[1], hole_type)
        if build_ok -> build_ok = if build.return_type == .Val(returned) -> sema_owned_owner_name(returned) == owner_name else -> false
        if !build_ok -> diagnostics.push(sema_owned_mismatch(trait_name, "build", build_expected, build.name_span))
    }
    loop method in methods {
        if method.name != "check" && method.name != "encode_hole" && method.name != "build" -> diagnostics.push(sema_owned_mismatch(trait_name, method.name, "only `check`, `encode_hole` and `build`", method.name_span))
    }
    diagnostics.len() == count
}

// A read parameter `name: [element]` with no label, default or spread.
sema_owned_list_param: fn(param: Param, element: Type) -> Bool Never! {
    param.name != "self" && param.convention == AccessConvention.Read && !param.variadic && param.default == None && param.public_label == None && type_identity_equal(param.ty, Type.List{element: element})
}
