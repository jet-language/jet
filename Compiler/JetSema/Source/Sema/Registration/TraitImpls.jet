// A written trait impl answers every method of a trait its module declares, as
// written methods registered and checked like any other. A `using` delegation
// impl gets one forwarding method per trait method, `self.<field>.<m>(args…)`,
// when the field's type implements the trait in this module (E2401 reports the
// rest); any other impl gets the trait's default body for each method it
// doesn't write. A written impl of a trait the compiler owns gets the defaults
// Traits.jet gives it the same way. A top-level `impl T.Trait` and an
// `impl Trait` block in the body of `T` are filled the same way. An impl of a
// trait another module declares gains its default bodies before any module is
// prepared (sema_trait_impls_foreign).
use {
    jet_foundation.[AST_EMPTY_CALL_ARG_FLAGS, AST_NODE_GENERATED, CallArg, Expr, Func, Item, ModuleTable, NameTable, Span, Stmt, TraitImplBlock, TraitMethodSig, Type, ast_func, import_walk_bindings, module_index, module_is_core, module_text, name_count, name_find, name_index, name_intern, name_pair_find_slot, name_pair_slot, name_table, name_table_sized, owned_trait, type_name]
    jet_parser.[parse_generated_source]
}

// One impl's methods with those it gains: the top-level impl at `item`
// (`block` -1), or block `block` of the type body at `item`.
SemaTraitImplGain: struct {
    item: Int,
    block: Int,
    methods: [Func],
}

// A trait another module declares: the position among the inputs of that
// module and the trait's index among its items.
SemaTraitImplForeign: struct {
    position: Int,
    item: Int,
}

// An owned trait whose default methods, as Traits.jet gives them, do not
// parse in a module, and why. Its impls there gain no defaults, and the
// contract check reports none of those methods missing
// (sema_trait_defaults_unknown): the row is the one report, an internal
// compiler error (sema_trait_defaults_unread).
SemaTraitDefaultsUnread: struct {
    trait_name: String,
    problem: String,
}

// The names an impl reads in its module: each trait the module declares, by
// its name's id in `names`, to its index among the items; the impls the
// module writes itself, by (type, trait) pair slot over `names`
// (name_pair_slot); and each field's type name, by (type, field) pair slot.
SemaTraitImplNames: struct {
    names: NameTable{name_table_sized(16)},
    traits: [Int:Int]{[Int:Int]{}},
    pairs: [Int:Bool]{[Int:Bool]{}},
    fields: [Int:String]{[Int:String]{}},
}

// The index of the trait `trait_name` the module declares.
sema_trait_impl_declared: fn(known: SemaTraitImplNames, trait_name: String) -> Int? Never! {
    id: name_find(known.names, trait_name) ?? return None
    known.traits.get(name_index(id))
}

// Fills every impl of `items` with the methods it gains. An owned trait
// whose defaults do not parse is a row of `unread`, once.
sema_trait_impls_synthesize: fn(items: ^[Item], unread: ^[SemaTraitDefaultsUnread]) Never! {
    ^known: SemaTraitImplNames{}
    loop (index, item) in items {
        if item == {
            .Trait(definition) -> {
                known.traits[name_index(name_intern(known.names, definition.name))] = index
            }
            .Impl(definition) -> {
                if definition.trait_name == .Val(trait_name) {
                    if definition.delegation_field == None {
                        known.pairs[name_pair_slot(known.names, definition.type_name, trait_name)] = true
                    }
                }
            }
            .Struct(definition) -> {
                loop block in definition.trait_impls {
                    if block.delegation_field == None {
                        known.pairs[name_pair_slot(known.names, definition.name, block.trait_name)] = true
                    }
                }
                loop field in definition.fields {
                    known.fields[name_pair_slot(known.names, definition.name, field.name)] = type_name(field.ty)
                }
            }
            .Enum(definition) -> {
                loop block in definition.trait_impls {
                    if block.delegation_field == None {
                        known.pairs[name_pair_slot(known.names, definition.name, block.trait_name)] = true
                    }
                }
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    ^gains: [SemaTraitImplGain]{}
    loop (index, item) in items {
        if item == {
            .Impl(definition) -> {
                trait_name: definition.trait_name ?? next
                methods: sema_trait_impl_filled_methods(items, definition.type_name, trait_name, definition.trait_span ?? definition.type_span, definition.methods, definition.delegation_field, known, unread) ?? next
                gains.push(SemaTraitImplGain{item: index, block: -1, methods: methods})
            }
            .Struct(definition) -> {
                sema_trait_impl_filled_blocks(items, index, definition.name, definition.trait_impls, known, gains, unread)
            }
            .Enum(definition) -> {
                sema_trait_impl_filled_blocks(items, index, definition.name, definition.trait_impls, known, gains, unread)
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    sema_trait_impls_fill(items, gains.move())
}

// The gains of the `impl Trait` blocks in the body of `type_name`, item `item`.
sema_trait_impl_filled_blocks: fn(items: [Item], item: Int, type_name: String, blocks: [TraitImplBlock], known: SemaTraitImplNames, gains: ^[SemaTraitImplGain], unread: ^[SemaTraitDefaultsUnread]) Never! {
    loop (block, written) in blocks {
        methods: sema_trait_impl_filled_methods(items, type_name, written.trait_name, written.trait_span, written.methods, written.delegation_field, known, unread) ?? next
        gains.push(SemaTraitImplGain{item: item, block: block, methods: methods})
    }
}

// The methods of `type_name`'s impl of `trait_name`, written at `at`, with its
// synthesized ones, None when it gains none.
sema_trait_impl_filled_methods: fn(items: [Item], type_name: String, trait_name: String, at: Span, methods: [Func], delegation: String?, known: SemaTraitImplNames, unread: ^[SemaTraitDefaultsUnread]) -> [Func]? Never! {
    declared: sema_trait_impl_declared(known, trait_name) ?? return sema_trait_impl_owned_defaults(trait_name, at, methods, delegation, unread)
    if items[declared] == .Trait(definition) {
        sigs: definition.methods
        if delegation == .Val(field_name) {
            field_slot: name_pair_find_slot(known.names, type_name, field_name) ?? return None
            field_type: known.fields.get(field_slot) ?? return None
            impl_slot: name_pair_find_slot(known.names, field_type, trait_name) ?? return None
            if !(known.pairs.get(impl_slot) ?? false) -> return None
            return Val(loop sig in sigs -> sema_trait_impl_forward(sig, field_name))
        }
        extras: sema_trait_impl_defaults(sigs, methods, "")
        return sema_trait_impl_with(methods, extras.move())
    }
    None
}

// The default bodies of `sigs` that `methods` don't write, as impl methods.
// A default body keeps its module's `#FX(…)` caps, and one written in
// another module resolves its names there: `definition_module` is that
// module's identity text, "" for the impl's own (Func.definition_module).
sema_trait_impl_defaults: fn(sigs: [TraitMethodSig], methods: [Func], definition_module: String) -> [Func] Never! {
    ^extras: [Func]{}
    loop sig in sigs {
        body: sig.default_body ?? next
        if sema_trait_impl_writes(methods, sig.name) -> next
        ^function: sema_trait_impl_method(sig)
        function.body = body.copy()
        function.module_caps = sig.module_caps.copy()
        if definition_module != "" -> function.definition_module = definition_module.copy()
        extras.push(function)
    }
    extras
}

// Write each gain's methods into its impl among `items`. The gains come in
// item order, so a type body's blocks are written in one pass.
sema_trait_impls_fill: fn(items: ^[Item], gains: ^^[SemaTraitImplGain]) Never! {
    ^left: gains.move()
    left.reverse()
    loop left.len() > 0 {
        gain: left.pop() ?? break
        index: gain.item
        if items[index] == {
            .Impl(definition) -> {
                ^updated: definition.copy()
                updated.methods = gain.methods.move()
                items[index] = Item.Impl{value: updated}
            }
            .Struct(definition) -> {
                ^updated: definition.copy()
                sema_trait_impls_fill_blocks(updated.trait_impls, gain.move(), left)
                items[index] = Item.Struct{value: updated}
            }
            .Enum(definition) -> {
                ^updated: definition.copy()
                sema_trait_impls_fill_blocks(updated.trait_impls, gain.move(), left)
                items[index] = Item.Enum{value: updated}
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

// Write `first` and each gain after it for the same type body into its
// `blocks`; `left` holds the gains still to write, the next one last.
sema_trait_impls_fill_blocks: fn(blocks: ^[TraitImplBlock], first: ^^SemaTraitImplGain, left: ^[SemaTraitImplGain]) Never! {
    ^gain: first.move()
    loop {
        blocks[gain.block].methods = gain.methods.move()
        if left.len() == 0 || left[left.len() - 1].item != gain.item -> break
        gain = left.pop() ?? break
    }
}

// Before any module is prepared, each impl that names a trait another module
// declares gains that trait's default bodies for the methods it doesn't
// write, as one of its own module's traits gives them in its preparation
// (sema_trait_impls_synthesize). The impl names the trait by a selective
// import's local name, by a module import's `alias.Trait`, by the bare name
// another member of its package namespace declares, or by the bare name of
// the one trait of that name another package declares where the impl sees
// it; an import of a namespaced package offers each member's traits. A trait
// the module declares hides an imported one, an import hides a namespace
// member's, and a namespace member's hides another package's.
// The traits are read in place: only the bodies an impl gains are copied. A
// trait the compiler owns and a `using` delegation are left to the impl's
// own preparation.
sema_trait_impls_has_defaults: fn(sigs: [TraitMethodSig]) -> Bool Never! {
    loop sig in sigs {
        if sig.default_body != None -> return true
    }
    false
}

sema_trait_impls_foreign: fn(inputs: ^[SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], table: ModuleTable) Never! {
    ^default_traits: name_table()
    loop input in inputs {
        loop item in input.program.items {
            if item == .Trait(definition) && sema_trait_impls_has_defaults(definition.methods) {
                ^_: name_intern(default_traits, definition.name)
            }
        }
    }
    if name_count(default_traits) == 0 {
        return
    }
    ^positions: [Int:Int]{}
    loop (position, input) in inputs -> positions[module_index(input.module_identity)] = position
    ^edges_by_source: [Int:[Int]]{}
    loop (edge_index, edge) in edges {
        if edge.source_scope != "" -> next
        src: module_index(edge.source_module_identity)
        if !edges_by_source.has_key(src) -> edges_by_source[src] = [Int]{}
        edges_by_source[src].push(edge_index)
        loop binding in import_walk_bindings(edge.declaration) {
            if binding.original == .Val(original) && name_find(default_traits, original) != None {
                ^_: name_intern(default_traits, binding.local)
            }
        }
    }
    loop position in 0..<inputs.len() {
        ^gains: [SemaTraitImplGain]{}
        loop (index, item) in inputs[position].program.items {
            if item == {
                .Impl(definition) -> {
                    trait_name: definition.trait_name ?? next
                    if definition.delegation_field != None -> next
                    methods: sema_trait_impls_foreign_methods(inputs, position, edges, edges_by_source, positions, default_traits, table, trait_name, definition.methods) ?? next
                    gains.push(SemaTraitImplGain{item: index, block: -1, methods: methods})
                }
                .Struct(definition) -> {
                    sema_trait_impls_foreign_blocks(inputs, position, edges, edges_by_source, positions, default_traits, table, index, definition.trait_impls, gains)
                }
                .Enum(definition) -> {
                    sema_trait_impls_foreign_blocks(inputs, position, edges, edges_by_source, positions, default_traits, table, index, definition.trait_impls, gains)
                }
                .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
            }
        }
        if gains.len() > 0 -> sema_trait_impls_fill(inputs[position].program.items, gains.move())
    }
}

// The gains of the `impl Trait` blocks of the type body at item `item` of
// input `position` from traits other modules declare.
sema_trait_impls_foreign_blocks: fn(inputs: [SemaRegistrationModuleInput], position: Int, edges: [SemaRegistrationImportEdge], edges_by_source: [Int:[Int]], positions: [Int:Int], default_traits: NameTable, table: ModuleTable, item: Int, blocks: [TraitImplBlock], gains: ^[SemaTraitImplGain]) Never! {
    loop (block, written) in blocks {
        if written.delegation_field != None -> next
        methods: sema_trait_impls_foreign_methods(inputs, position, edges, edges_by_source, positions, default_traits, table, written.trait_name, written.methods) ?? next
        gains.push(SemaTraitImplGain{item: item, block: block, methods: methods})
    }
}

// The methods of an impl in input `position` that writes `methods` and names
// `trait_name`, with the default bodies it gains from the trait another
// module declares; None when it gains none.
sema_trait_impls_foreign_methods: fn(inputs: [SemaRegistrationModuleInput], position: Int, edges: [SemaRegistrationImportEdge], edges_by_source: [Int:[Int]], positions: [Int:Int], default_traits: NameTable, table: ModuleTable, trait_name: String, methods: [Func]) -> [Func]? Never! {
    leaf: if trait_name.split_once(".") == .Val(parts) -> parts.after else -> trait_name
    if name_find(default_traits, leaf) == None -> return None
    if owned_trait(trait_name) != None || sema_trait_impls_declared(inputs[position].program.items, trait_name) != None {
        return None
    }
    found: sema_trait_impls_named(inputs, position, edges, edges_by_source, positions, trait_name) ?? return None
    if inputs[found.position].program.items[found.item] == .Trait(definition) {
        extras: sema_trait_impl_defaults(definition.methods, methods, module_text(table, inputs[found.position].module_identity))
        return sema_trait_impl_with(methods, extras.move())
    }
    None
}

// The trait another module declares that an impl in input `position` names
// `written`: through the module's own imports first, then by the other
// members of its package namespace, then as the one trait of that name
// another package declares.
sema_trait_impls_named: fn(inputs: [SemaRegistrationModuleInput], position: Int, edges: [SemaRegistrationImportEdge], edges_by_source: [Int:[Int]], positions: [Int:Int], written: String) -> SemaTraitImplForeign? Never! {
    identity: module_index(inputs[position].module_identity)
    qualified: written.split_once(".")
    if edges_by_source.get(identity) == .Val(source_edges) {
        loop edge_index in source_edges {
            edge: edges[edge_index]
            target: positions.get(module_index(edge.target_module_identity)) ?? next
            loop binding in import_walk_bindings(edge.declaration) {
                if binding.original == .Val(original) {
                    if binding.local == written {
                        return sema_trait_impls_offered(inputs, target, position, original)
                    }
                } else if qualified == .Val(parts) {
                    if binding.local == parts.before {
                        return sema_trait_impls_offered(inputs, target, position, parts.after)
                    }
                }
            }
        }
    }
    member: sema_trait_impls_offered(inputs, position, position, written)
    if member != None || qualified != None -> return member
    sema_trait_impls_unique_owner(inputs, position, edges, positions, written)
}

// The one trait named `written` that a module of another package declares
// and input `position` sees, as the checker resolves a bare type name the
// module neither declares nor imports (sema_type_graph_unique_type_owner):
// two such traits name none, unless exactly one is in a package that
// `position`'s package imports. Core's traits are left to their own routes.
sema_trait_impls_unique_owner: fn(inputs: [SemaRegistrationModuleInput], position: Int, edges: [SemaRegistrationImportEdge], positions: [Int:Int], written: String) -> SemaTraitImplForeign? Never! {
    ^found: SemaTraitImplForeign?{None}
    ^seen: 0
    ^imported: SemaTraitImplForeign?{None}
    ^seen_imported: 0
    loop (index, input) in inputs {
        if input.package_identity == inputs[position].package_identity || module_is_core(input.module_identity) {
            next
        }
        item: sema_trait_impls_declared(input.program.items, written) ?? next
        if input.program.items[item] == .Trait(definition) {
            visibility: sema_registration_visibility(definition.is_pub, definition.is_package_pub)
            if !sema_registration_visible(visibility, inputs[position].module_identity, inputs[position].package_identity, input.module_identity, input.package_identity) {
                next
            }
        }
        seen += 1
        found = Val(SemaTraitImplForeign{position: index, item: item})
        if sema_trait_impls_package_imports(inputs, position, edges, positions, input.package_identity) {
            seen_imported += 1
            imported = Val(SemaTraitImplForeign{position: index, item: item})
        }
    }
    if seen == 1 -> return found
    if seen_imported == 1 -> return imported
    None
}

// Whether a module of input `position`'s package imports a module of the
// package `package_identity`.
sema_trait_impls_package_imports: fn(inputs: [SemaRegistrationModuleInput], position: Int, edges: [SemaRegistrationImportEdge], positions: [Int:Int], package_identity: String) -> Bool Never! {
    loop edge in edges {
        if edge.target_package_identity != package_identity -> next
        source: positions.get(module_index(edge.source_module_identity)) ?? next
        if inputs[source].package_identity == inputs[position].package_identity -> return true
    }
    false
}

// The trait `name` that input `target` offers an importer: its own, or for a
// module of a package namespace, any member's but input `except`'s.
sema_trait_impls_offered: fn(inputs: [SemaRegistrationModuleInput], target: Int, except: Int, name: String) -> SemaTraitImplForeign? Never! {
    loop (position, input) in inputs {
        if position == except -> next
        if position != target && (inputs[target].namespace == "" || input.namespace != inputs[target].namespace) {
            next
        }
        item: sema_trait_impls_declared(input.program.items, name) ?? next
        return Val(SemaTraitImplForeign{position: position, item: item})
    }
    None
}

// The index among `items` of the trait named `name`, if they declare one.
sema_trait_impls_declared: fn(items: [Item], name: String) -> Int? Never! {
    loop (index, item) in items {
        if item == .Trait(definition) {
            if definition.name == name -> return Val(index)
        }
    }
    None
}

// The defaults a written impl of the compiler-owned `trait_name` gains for
// the methods it leaves out. They parse as one generated trait declaration,
// padded to begin one byte into the impl's trait name at `at`: no unit of the
// file begins there, and the parser numbers a unit's nodes from its first
// byte, so every node id it gives is unique in the file. Each gained method
// sits at `at`, so a report about the method itself names the impl. Defaults
// that do not parse are jet's own defect: the impl gains none, and the trait
// is a row of `unread`, once.
sema_trait_impl_owned_defaults: fn(trait_name: String, at: Span, methods: [Func], delegation: String?, unread: ^[SemaTraitDefaultsUnread]) -> [Func]? Never! {
    if delegation != None -> return None
    owned: owned_trait(trait_name) ?? return None
    ^declarations: ""
    if owned.contract == .Methods(declared, _, _) {
        loop method in declared {
            source: method.default_source ?? next
            if !sema_trait_impl_writes(methods, method.name) {
                declarations = "{declarations}{source}\n"
            }
        }
    }
    if declarations == "" -> return None
    ^bytes: [U8]{}
    loop _ in 0..<at.start + 1 -> bytes.push(32)
    loop byte in "{trait_name}: trait {{\n{declarations}}}\n".bytes() -> bytes.push(byte)
    parsed: parse_generated_source(bytes)
    problem: if {
        parsed.diagnostics.len() > 0 -> Val("they do not parse: {parsed.diagnostics[0].what}")
        parsed.program.items.len() != 1 -> Val("they parse as {parsed.program.items.len()} items, not one trait")
        else -> None
    }
    if problem == .Val(text) {
        if !sema_trait_defaults_unknown(unread, trait_name) {
            unread.push(SemaTraitDefaultsUnread{trait_name: trait_name, problem: text})
        }
        return None
    }
    // The one item is the generated trait.
    ^program: parsed.program.move()
    ^extras: [Func]{}
    loop {
        item: program.items.pop() ?? break
        if item.move() == .Trait(source_definition) {
            ^definition: source_definition.move()
            loop {
                sig: definition.methods.pop() ?? break
                ^function: sema_trait_impl_method(sig)
                if sig.default_body.move() == .Val(body) {
                    function.body = body.move()
                    function.span = at
                    function.name_span = at
                    extras.push(function)
                }
            }
        }
    }
    extras.reverse()
    sema_trait_impl_with(methods, extras.move())
}

sema_trait_impl_writes: fn(methods: [Func], name: String) -> Bool Never! {
    loop method in methods {
        if method.name == name -> return true
    }
    false
}

// Whether the defaults of the owned trait `trait_name` did not parse: it is a
// row of `unread`, and no impl gained them.
sema_trait_defaults_unknown: fn(unread: [SemaTraitDefaultsUnread], trait_name: String) -> Bool Never! {
    loop row in unread {
        if row.trait_name == trait_name -> return true
    }
    false
}

// The census of the owned traits whose defaults did not parse in this
// compile, one row per trait, naming the first module that read them. Each
// is jet's own defect, which the driver reports as an internal compiler
// error (JetDriver Pipeline.jet).
sema_trait_defaults_unread: fn(graph: SemaRegistrationGraph) -> [String] Never! {
    ^rows: [String]{}
    loop (index, module_row) in graph.modules {
        loop row in module_row.trait_defaults_unread {
            earlier: loop before in 0..<index {
                if sema_trait_defaults_unknown(graph.modules[before].trait_defaults_unread, row.trait_name) {
                    break true
                }
            } ?? false
            if earlier -> next
            rows.push("the defaults Traits.jet gives `{row.trait_name}`, read in module `{module_text(graph.module_table, module_row.module_identity)}`: {row.problem}")
        }
    }
    rows
}

// `methods` then `extras`, None when there are no extras.
sema_trait_impl_with: fn(methods: [Func], extras: ^^[Func]) -> [Func]? Never! {
    if extras.len() == 0 -> return None
    ^updated: methods.copy()
    updated.extend(extras.move())
    Val(updated)
}

// The trait method's header as an impl method. It is public, as a written
// impl method without `priv` is, so a caller outside the impl's module reaches
// a default the impl gains.
sema_trait_impl_method: fn(sig: TraitMethodSig) -> Func Never! {
    ^function: ast_func(sig.name.copy(), sig.name_span, sig.name_span)
    function.is_pub = true
    function.params = sig.params.copy()
    function.return_type = sig.return_type.copy()
    function.is_pure = sig.is_pure
    function.declared_effects = sig.declared_effects.copy()
    function.return_view_provenance = sig.return_view_provenance.copy()
    function.declared_return_view_provenance = sig.declared_return_view_provenance.copy()
    function
}

// The delegation method: `self.<field>.<m>(args…)` as the body's tail, each
// argument passed with its parameter's convention. Ownership facts are keyed
// by exact span, so every built node takes its own span from the trait
// signature: `self` and each argument their parameter names, the field read
// `m(self`.
sema_trait_impl_forward: fn(sig: TraitMethodSig, field_name: String) -> Func Never! {
    span: sig.name_span
    ^self_span: span
    ^args: [CallArg]{}
    loop param in sig.params {
        if param.name == "self" {
            self_span = param.name_span
            next
        }
        args.push(CallArg{convention: param.convention, expr: Expr.Ident{name: param.name.copy(), span: param.name_span, id: AST_NODE_GENERATED}, span: param.name_span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false})
    }
    receiver: Expr.Field{base: Expr.Ident{name: "self", span: self_span, id: AST_NODE_GENERATED}, member: field_name.copy(), span: Span{start: span.start, end: self_span.end}, id: AST_NODE_GENERATED}
    call: Expr.MethodCall{receiver: receiver, method: sig.name.copy(), method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: args, id: AST_NODE_GENERATED}
    ^function: sema_trait_impl_method(sig)
    function.body = [Stmt]{Stmt.Expr{expr: call}}
    function
}
