// Compiler-owned builtin identity facts for backend lowering.
//
// Builtin owners are supplied by Registration's authoritative graph facts. This
// layer only projects those facts into checked declaration metadata; it does
// not invent source modules, nominal declarations, exports, or ownership from
// a name whitelist.
// These accessors mirror jet_foundation::Syntax::{TYPE_TASK,
// TYPE_RECEIVER,TYPE_SENDER}; Source currently has no imported Syntax constants,
// so this file is the one authoritative Source-side spelling table.
use jet_foundation.[
    SymbolID,
    SymbolKind,
    TCompilerBuiltin,
    TCoreBuiltinOwner,
    TDeclarationOwnership,
    symbol_id,
]

sema_registration_core_builtin_task_name: fn() -> String Never! {
    "Task"
}

sema_registration_core_builtin_receiver_name: fn() -> String Never! {
    "Receiver"
}

sema_registration_core_builtin_sender_name: fn() -> String Never! {
    "Sender"
}

sema_registration_core_builtin_owner_fact: fn(name: String) -> SemaRegistrationCoreBuiltinOwnerFact Never! {
    symbol: symbol_id(SymbolKind.Type, "", "", name)
    SemaRegistrationCoreBuiltinOwnerFact{
        symbol: symbol,
        module_identity: None,
        name: name,
        ownership: TDeclarationOwnership.Owned,
    }
}

sema_registration_core_builtin_owner_facts: fn() -> [SemaRegistrationCoreBuiltinOwnerFact] Never! {
    [SemaRegistrationCoreBuiltinOwnerFact]{
        sema_registration_core_builtin_owner_fact(sema_registration_core_builtin_task_name()),
        sema_registration_core_builtin_owner_fact(sema_registration_core_builtin_receiver_name()),
        sema_registration_core_builtin_owner_fact(sema_registration_core_builtin_sender_name()),
    }
}

sema_registration_core_builtin_is_name: fn(name: String) -> Bool Never! {
    loop fact in sema_registration_core_builtin_owner_facts() {
        if fact.name == name -> return true
    }
    false
}

sema_registration_core_builtin_owner: fn(graph: SemaRegistrationGraph, name: String) -> SemaRegistrationCoreBuiltinOwnerFact? {
    loop fact in graph.core_builtin_owner_facts {
        if fact.name == name -> return Val(fact)
    }
    None
}

SemaRegistrationCoreBuiltinOwnerFact: struct {
    symbol: SymbolID
    module_identity: String?
    name: String
    ownership: TDeclarationOwnership
}

sema_registration_compiler_builtin_marker: fn(nominal: SemaRegistrationNominal) -> TCompilerBuiltin? {
    if !nominal.compiler_owned -> return None
    provenance: nominal.generated_provenance ?? return None
    if provenance == sema_registration_compiler_owned_default_err_provenance() -> Val(TCompilerBuiltin.DefaultErr) else -> None
}

sema_checked_core_builtin_owners: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule) -> [TCoreBuiltinOwner] Never! {
    // A fact without a module identity belongs to every module.
    owners: loop fact in graph.core_builtin_owner_facts if (fact.module_identity ?? module_row.module_identity) == module_row.module_identity -> TCoreBuiltinOwner{
        symbol: fact.symbol,
        module_identity: fact.module_identity,
        name: fact.name,
        ownership: fact.ownership,
    }
    owners
}
