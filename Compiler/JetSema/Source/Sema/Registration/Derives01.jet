use jet_foundation.[CtValue, DeriveDef, Diagnostic, Func, ImplDef, Item, NamedCtValue, NamedSpan, NamedType, Span, TraitImplBlock, Type, TypeParam, VariantPayload]
use jet_lexer.[lex_generated]
use jet_parser.[parse]
use jet_comptime.[expand_derive_body, build_struct_type_info, build_enum_type_info, build_distinct_type_info]
use jet_sema.[TraitRegistry, is_reserved_type, SEMA_PRELUDE_DERIVE_SOURCE]
use std.sync.[LazyLock]

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:9
// Built-in providers are ordinary Prelude declarations, parsed by the normal frontend.
pub const DERIVE_SOURCE: String = SEMA_PRELUDE_DERIVE_SOURCE

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:12
// GATE #4494: process-wide, once-only initialization uses the std synchronization primitive.
const BUILTIN_DERIVE_PROVIDERS: LazyLock<[DeriveDef]> = LazyLock.new(parse_builtin_derive_source)

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:15
fn parse_builtin_derive_source() -> [DeriveDef] {
    (tokens, lex_diagnostics) :: lex_generated(DERIVE_SOURCE)
    if !lex_diagnostics.is_empty() -> panic("invalid Prelude derive declarations: {lex_diagnostics:?}")
    program :: parse(&tokens) catch diagnostics -> panic("invalid Prelude derive declarations: {diagnostics:?}")
    names := [String:Bool]{}
    providers := [DeriveDef]{}
    loop item in program.items {
        if item == .UserDerive(provider) -> &providers.push(^provider)
        else -> panic("Prelude/Derives.jet may contain only derive provider declarations")
    }
    if providers.is_empty() -> panic("Prelude/Derives.jet declares no derive providers")
    loop provider in providers {
        if names.contains_key(provider.trait_name) -> panic("Prelude/Derives.jet declares derive provider `{provider.trait_name}` more than once")
        &names.insert(provider.trait_name, true)
    }
    providers
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:44
fn builtin_derive_provider_enabled(trait_name: String) -> Bool {
    loop provider in BUILTIN_DERIVE_PROVIDERS.get() {
        if provider.trait_name == trait_name -> return true
    }
    false
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:49
fn builtin_derive_provider(trait_name: String) -> DeriveDef? {
    loop provider in BUILTIN_DERIVE_PROVIDERS.get() {
        if provider.trait_name == trait_name -> return Val(provider)
    }
    None
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:62
fn expand_builtin_provider_body(trait_name: String, target_name: String, target_span: Span, owner_type: Type, type_info: CtValue, diags: &[Diagnostic]) -> [Item] {
    provider :: builtin_derive_provider(trait_name) ?? return [Item]{}
    expanded :: expand_derive_body(&provider.body, &provider.type_param, ^type_info, [String:CtValue]{}, OSPath("."), None) catch diagnostic -> {
        &diags.push(^diagnostic)
        return [Item]{}
    }
    ordinary := [Item]{}
    methods := [Func]{}
    loop item in expanded {
        if item == .Func(function) {
            // Derived signature locations refer to the target, not the Prelude source.
            loop parameter in &function.params {
                replace_provider_type(&parameter.ty, provider.type_param, owner_type)
                parameter.ty_span = target_span
            }
            if function.return_type == .Val(return_type) {
                replace_provider_type(&return_type, provider.type_param, owner_type)
                function.return_type_span = Val(target_span)
            }
            function.compiler_generated = true
            &methods.push(^function)
        } else -> &ordinary.push(^item)
    }
    if !methods.is_empty() {
        &ordinary.push(Item.Impl{value: ImplDef{
            span: target_span, type_name: target_name, type_span: target_span,
            trait_name: Val(trait_name), operator_marker: None, operator_rhs: None,
            trait_span: Val(target_span), methods: ^methods, delegation_field: None,
            assoc_type_impls: [NamedType]{}, is_generated_serde: false, os_target: None,
        }})
    }
    ordinary
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:135
fn provider_type_info(type_info: CtValue, kind: String) -> CtValue {
    if type_info == .Struct(_, fields) {
        found := false
        loop field in fields {
            if field.name == "kind" { found = true; break }
        }
        if !found -> &fields.push(NamedCtValue{name: "kind", value: CtValue.Str{value: kind}})
    }
    ^type_info
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:148
fn replace_provider_type(ty: &Type, type_param: String, owner_type: Type) {
    if ty == .Named(name) && name == type_param {
        ty = ~owner_type
        return
    }
    if ty == {
        .List(inner), .Shared(inner), .Option(inner), .FixedList(inner, _),
        .InlineRange(inner, _, _), .Tagged(_, inner), .Quantity(inner, _) -> replace_provider_type(&inner, type_param, owner_type)
        .Map(key, _, value), .Result(key, value) -> {
            replace_provider_type(&key, type_param, owner_type)
            replace_provider_type(&value, type_param, owner_type)
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop param in &params -> replace_provider_type(&param, type_param, owner_type)
            if ret == .Val(value) -> replace_provider_type(&value, type_param, owner_type)
        }
        .Apply(_, args), .Union(args) -> {
            loop arg in &args -> replace_provider_type(&arg, type_param, owner_type)
        }
        .Tuple(fields) -> {
            loop field in &fields -> replace_provider_type(&field.ty, type_param, owner_type)
        }
        else -> {}
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:201
pub fn expand_builtin_derive_items(items: &[Item], diags: &[Diagnostic]) {
    normalize_recursive_enum_payloads(&items)
    auto :: TraitRegistry.auto_derives_for_items(items)
    expand_builtin_derive_items_with_auto(&items, &auto, &diags)
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:211
fn normalize_recursive_enum_payloads(items: &[Item]) {
    loop item in &items {
        if item == .Enum(enum_def) {
            loop variant in &enum_def.variants -> normalize_variant_payload(&variant.payload, enum_def.name)
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:223
pub fn normalize_variant_payload(payload: &VariantPayload, owner: String) {
    if payload == {
        .Unit -> {}
        .Single(ty, _) -> normalize_recursive_payload_type(&ty, owner)
        .Named(fields) -> {
            loop field in &fields -> normalize_recursive_payload_type(&field.ty, owner)
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:237
pub fn normalize_recursive_payload_type(ty: &Type, owner: String) {
    if ty == .Apply(name, args) && name == owner && args.is_empty() {
        ty = Type.Named{name: owner}
        return
    }
    if ty == {
        .List(inner), .Shared(inner), .Option(inner), .FixedList(inner, _),
        .InlineRange(inner, _, _), .Tagged(_, inner), .Quantity(inner, _) -> normalize_recursive_payload_type(&inner, owner)
        .Map(key, _, value), .Result(key, value) -> {
            normalize_recursive_payload_type(&key, owner)
            normalize_recursive_payload_type(&value, owner)
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop param in &params -> normalize_recursive_payload_type(&param, owner)
            if ret == .Val(value) -> normalize_recursive_payload_type(&value, owner)
        }
        .Apply(_, args), .Union(args) -> {
            loop arg in &args -> normalize_recursive_payload_type(&arg, owner)
        }
        .Tuple(fields) -> {
            loop field in &fields -> normalize_recursive_payload_type(&field.ty, owner)
        }
        else -> {}
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:285
pub fn expand_builtin_derive_items_with_auto(items: &[Item], auto: TraitRegistry, diags: &[Diagnostic]) {
    normalize_recursive_enum_payloads(&items)
    struct_equatable :: builtin_derive_provider_enabled("Equatable")
    struct_comparable :: builtin_derive_provider_enabled("Comparable")
    enum_equatable :: builtin_derive_provider_enabled("Equatable")
    enum_comparable :: builtin_derive_provider_enabled("Comparable")
    distinct_equatable :: builtin_derive_provider_enabled("Equatable")
    distinct_comparable :: builtin_derive_provider_enabled("Comparable")
    distinct_names := [String:Bool]{}
    loop item in items {
        if item == .Distinct(d) -> &distinct_names.insert(d.name, true)
    }
    invalid_distinct_names := [String:Bool]{}
    loop item in items {
        if item == .Distinct(d) && d.base == .Named(base) && distinct_names.contains_key(base) -> &invalid_distinct_names.insert(d.name, true)
    }
    generated := [Item]{}
    loop item in items {
        if item == {
            .Struct(s) -> {
                if is_reserved_type(s.name) -> next
                comparable :: struct_comparable && (has_derive(s.derives, "Comparable") || auto.auto_comparable.contains(s.name))
                equatable :: struct_equatable && (has_derive(s.derives, "Equatable") || auto.auto_equatable.contains(s.name))
                owner_type :: applied_owner_type(s.name, s.type_params)
                if equatable && !has_trait_impl(items, s.name, "Equatable") -> &generated.extend(expand_builtin_provider_body("Equatable", s.name, s.name_span, owner_type, provider_type_info(build_struct_type_info(s), "struct"), &diags))
                if comparable && !has_trait_impl(items, s.name, "Comparable") -> &generated.extend(expand_builtin_provider_body("Comparable", s.name, s.name_span, owner_type, provider_type_info(build_struct_type_info(s), "struct"), &diags))
            }
            .Enum(e) -> {
                if is_reserved_type(e.name) -> next
                comparable :: enum_comparable && (has_derive(e.derives, "Comparable") || auto.auto_comparable.contains(e.name))
                equatable :: enum_equatable && (has_derive(e.derives, "Equatable") || auto.auto_equatable.contains(e.name))
                owner_type :: applied_owner_type(e.name, e.type_params)
                if equatable && !has_trait_impl(items, e.name, "Equatable") -> &generated.extend(expand_builtin_provider_body("Equatable", e.name, e.name_span, owner_type, provider_type_info(build_enum_type_info(e), "enum"), &diags))
                if comparable && !has_trait_impl(items, e.name, "Comparable") -> &generated.extend(expand_builtin_provider_body("Comparable", e.name, e.name_span, owner_type, provider_type_info(build_enum_type_info(e), "enum"), &diags))
            }
            .Distinct(d) -> {
                if is_reserved_type(d.name) || invalid_distinct_names.contains_key(d.name) -> next
                owner_type :: Type.Named{name: d.name}
                type_info :: provider_type_info(build_distinct_type_info(d, ""), "distinct")
                if distinct_equatable && !has_trait_impl(items, d.name, "Equatable") -> &generated.extend(expand_builtin_provider_body("Equatable", d.name, d.name_span, owner_type, ~type_info, &diags))
                if distinct_comparable && (has_derive(d.derives, "Comparable") || auto.auto_comparable.contains(d.name)) && !has_trait_impl(items, d.name, "Comparable") -> &generated.extend(expand_builtin_provider_body("Comparable", d.name, d.name_span, owner_type, ^type_info, &diags))
            }
            .UnitFamily(family) -> {
                loop d in family.distinct_defs() {
                    owner_type :: Type.Named{name: d.name}
                    type_info :: provider_type_info(build_distinct_type_info(d, ""), "distinct")
                    if distinct_equatable && !has_trait_impl(items, d.name, "Equatable") -> &generated.extend(expand_builtin_provider_body("Equatable", d.name, d.name_span, owner_type, ~type_info, &diags))
                    if distinct_comparable && (has_derive(d.derives, "Comparable") || auto.auto_comparable.contains(d.name)) && !has_trait_impl(items, d.name, "Comparable") -> &generated.extend(expand_builtin_provider_body("Comparable", d.name, d.name_span, owner_type, ^type_info, &diags))
                }
            }
            else -> {}
        }
    }
    loop item in generated -> attach_generated_derive_item(&items, ^item)
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:452
fn has_derive(derives: [NamedSpan], name: String) -> Bool {
    loop derive in derives {
        if derive.name == name -> return true
    }
    false
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:456
fn attach_generated_derive_item(items: &[Item], item: Item) {
    if item == .Impl(implementation) {
        trait_name :: implementation.trait_name ?? return
        if has_trait_impl(items, implementation.type_name, trait_name) -> return
        block :: TraitImplBlock{
            trait_name: trait_name, trait_span: implementation.trait_span ?? implementation.type_span,
            operator_rhs: ^implementation.operator_rhs, operator_marker: ^implementation.operator_marker,
            methods: ^implementation.methods, compiler_generated: true, assoc_type_impls: ^implementation.assoc_type_impls,
        }
        loop existing in &items {
            if existing == {
                .Struct(s) -> {
                    if s.name == implementation.type_name { &s.trait_impls.push(^block); return }
                }
                .Enum(e) -> {
                    if e.name == implementation.type_name { &e.trait_impls.push(^block); return }
                }
                else -> {}
            }
        }
        // No nominal target: preserve the ordinary standalone implementation.
        implementation.methods = ^block.methods
        implementation.operator_rhs = ^block.operator_rhs
        implementation.operator_marker = ^block.operator_marker
        implementation.assoc_type_impls = ^block.assoc_type_impls
        &items.push(Item.Impl{value: ^implementation})
    } else if item == .Func(function) {
        loop existing in items {
            if existing == .Func(old) && old.name == function.name -> return
        }
        &items.push(Item.Func{value: ^function})
    }
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:495
fn has_trait_impl(items: [Item], type_name: String, trait_name: String) -> Bool {
    loop item in items {
        if item == {
            .Impl(i) -> {
                if i.type_name == type_name && i.trait_name == Val(trait_name) -> return true
            }
            .Struct(s) -> {
                if s.name == type_name {
                    loop i in s.trait_impls {
                        if i.trait_name == trait_name -> return true
                    }
                }
            }
            .Enum(e) -> {
                if e.name == type_name {
                    loop i in e.trait_impls {
                        if i.trait_name == trait_name -> return true
                    }
                }
            }
            else -> {}
        }
    }
    false
}

// Rust: crates/jet-sema/src/Sema/Registration/Derives.rs:508
fn applied_owner_type(name: String, type_params: [TypeParam]) -> Type {
    if type_params.is_empty() -> return Type.Named{name: name}
    args := [Type]{}
    loop param in type_params -> &args.push(Type.Named{name: param.name})
    Type.Apply{name: name, args: ^args}
}
