// The built-in derive providers: ordinary Prelude derives whose typed bodies
// JetSema expands for each selected capability (Registration/Derives.jet).
SEMA_PRELUDE_DERIVE_SOURCE_PATH :: prep { "jet:canonical-prelude/Prelude/Derives.jet" }
SEMA_PRELUDE_DERIVE_SOURCE :: prep { ```// Built-in derive providers are ordinary Prelude derives.
// Their typed bodies use the same template expansion as package source,
// including reflected enum variant payloads.
//
// Enum equality/order match `self` once per variant, then dispatch `rhs`
// inside that arm. A cartesian product of separate `if self ==` tables
// would consume a non-copy payload and then use `self` again (E0121).
// Both match `rhs` against the arm's own variant only (`.$left` again), so
// expansion does one step per variant and the generated body stays linear in
// the variant count: equality lets any other `rhs` variant fall through to
// `return false`, and ordering reads the `rhs` variant ordinal once and orders
// different variants by ordinal before comparing payloads.
derive T.Equatable {
    fn equal(self, rhs: T) -> Bool {
        prep if T.$kind == "enum" {
            prep loop left in T.$fields {
                if self == {
                    .$left -> {
                        if rhs == {
                            .$left -> {
                                prep loop field in left.$fields {
                                    prep if field.$ty == T.$name {
                                        if self.$field.equal(rhs.$field) == false -> return false
                                    } else {
                                        if self.$field != rhs.$field -> return false
                                    }
                                }
                                return true
                            }
                            else -> {}
                        }
                        return false
                    }
                    else -> {}
                }
            }
            return false
        } else {
            prep if T.$kind == "struct" {
                prep loop field in T.$fields {
                    if self.$field != rhs.$field -> return false
                }
                return true
            } else {
                prep if T.$base == "Float" || T.$base == "Float32" {
                    return self.raw() <= rhs.raw() && self.raw() >= rhs.raw()
                } else {
                    return self.raw() == rhs.raw()
                }
            }
        }
    }
}

derive T.Comparable {
    fn compare(self, rhs: T) -> Ordering {
        prep if T.$kind == "enum" {
            jet_rhs_variant_index := 0
            prep loop right in T.$fields {
                if rhs == {
                    .$right -> { jet_rhs_variant_index = right.$index }
                    else -> {}
                }
            }
            prep loop left in T.$fields {
                if self == {
                    .$left -> {
                        if jet_rhs_variant_index > left.$index -> return .Less
                        if jet_rhs_variant_index < left.$index -> return .Greater
                        if rhs == {
                            .$left -> {
                                prep loop field in left.$fields {
                                    prep if field.$ty == T.$name {
                                        if self.$field.compare(rhs.$field) == {
                                            .Less -> return .Less
                                            .Greater -> return .Greater
                                            .Equal -> {}
                                        }
                                    } else {
                                        if self.$field < rhs.$field -> return .Less
                                        if self.$field > rhs.$field -> return .Greater
                                    }
                                }
                                return .Equal
                            }
                            else -> {}
                        }
                        return .Equal
                    }
                    else -> {}
                }
            }
            return .Equal
        } else {
            prep if T.$kind == "struct" {
                prep loop field in T.$fields {
                    if self.$field < rhs.$field -> return .Less
                    if self.$field > rhs.$field -> return .Greater
                }
                return .Equal
            } else {
                if self.raw() < rhs.raw() -> return .Less
                if self.raw() > rhs.raw() -> return .Greater
                return .Equal
            }
        }
    }
}
``` }

// The standard library's own error family and its conversions into the
// default `Err`: ordinary Prelude source JetSema injects where a module needs it.
SEMA_PRELUDE_ERROR_SOURCE_PATH :: prep { "jet:canonical-prelude/Prelude/Errors.jet" }
SEMA_PRELUDE_ERROR_SOURCE :: prep { ```// (ratified 2026-08-17, card #2018): the standard library declares
// the conversion for its own error family. A program can write `fn run()` and
// pass a Core failure up automatically without declaring anything, because
// these declarations already sit on the existing rail. One source;
// every tier lowers the same `impl <CoreError> -> Err` block, the same way
// `Prelude/Units.jet` ships one dimension catalog.
//
// Sema injects only the conversions a module actually exercises — fallible
// calls whose error type is a family member converting into the default `Err`.
// Unused members are not copied into the module, so a defect in one conversion
// cannot break a program that never produces that error.
//
// An author who wants the failure named still writes the named form
// (`fn run() !EncodingError`), and that stays correct: this file only makes the
// unnamed form work.
//
// This rule keeps the rest of the rule intact. A user error type still
// needs its own `impl MyError -> Err { … }`; nothing here weakens that. A module
// that declares its own conversion for one of these pairs wins over the shipped
// one, so a package can still say how its program reports a Core failure.
//
// Family membership is derived, not chosen by taste. A Core error type belongs
// here when all three hold:
//   1. the Prelude registers it printable — `auto_printable` in
//      `TraitRegistry::register_synthetic_display_debug`, so the Prelude already
//      owns its failure text;
//   2. a Core signature returns it in the error position of a `T !E` result, so
//      a program can actually receive one; and
//   3. showing it is not prohibited.
//
// `CryptoError` and `FileCryptoError` are members. Both
// are payload-free enums that name only which check failed, so reporting the
// case carries no secret. The secret-bearing types (`Secret`, `SigningKey`,
// `X25519SecretKey`, `SharedSecret`) keep their E0915 print ban.
//
// Deliberately outside the family:
// * `TaskFailure` — gives cancellation and deadline their own
//     carrier and report; it is not a library error family member.
//   * `[FieldError]` — the Core decode surface returns a list, and a conversion
//     source is one named type.
//   * component types (`DataErrorKind`, `EncodingCause`, `IOContext`,
//     `NetErrorDetail`, `NetDNSError`, …) — no Core call fails with one.

// Original compiler-owned declarations. These private records are ordinary
// checked nominal types; only Err carries the existing default-error role.
// Fresh construction evaluates the declared metadata default in this owner.
// Copy, context and conversion retain the existing stored metadata instead.
struct __jet_ErrorContextFrame {
    text: String
    file: String
    line: Int
}
struct __jet_ErrorConversion {
    source: String
    target: String
}
struct __jet_ErrorField {
    name: String
    value: String
}
struct __jet_ErrorSpan {
    start: Int
    end: Int
}
struct __jet_ErrorDetails {
    variant: String
    fields: [__jet_ErrorField]
    source_span: __jet_ErrorSpan?
}
struct __jet_ErrorMetadata {
    typed_identity: String?
    context_frames: [__jet_ErrorContextFrame]
    conversion_history: [__jet_ErrorConversion]
    details: __jet_ErrorDetails?
}
struct Err {
    message: String
    code: String?
    cause: Err?
    __jet___memo_error_metadata: __jet_ErrorMetadata{__jet_ErrorMetadata{
        typed_identity: None,
        context_frames: [__jet_ErrorContextFrame]{},
        conversion_history: [__jet_ErrorConversion]{},
        details: None,
    }}
}

impl AppError -> Err {
    return Err("{self}")
}

impl ArchiveError -> Err {
    return Err("{self}")
}

