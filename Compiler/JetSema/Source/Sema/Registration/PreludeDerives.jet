SEMA_PRELUDE_DERIVE_SOURCE :: prep { "// D-ONCE-DERIVE1=A: built-in derive providers are ordinary Prelude derives.\n// Their typed bodies use the same template expansion as package source,\n// including reflected enum variant payloads.\n//\n// Enum equality/order match `self` once per variant, then dispatch `rhs`\n// inside that arm. A cartesian product of separate `if self ==` tables\n// would consume a non-copy payload and then use `self` again (E0121).\n// Both match `rhs` against the arm's own variant only (`.$left` again), so\n// expansion does one step per variant and the generated body stays linear in\n// the variant count: equality lets any other `rhs` variant fall through to\n// `return false`, and ordering reads the `rhs` variant ordinal once and orders\n// different variants by ordinal before comparing payloads.\nderive T.Equatable {{\n    fn equal(self, rhs: T) -> Bool {{\n        prep if T.$kind == \"enum\" {{\n            prep loop left in T.$fields {{\n                if self == {{\n                    .$left -> {{\n                        if rhs == {{\n                            .$left -> {{\n                                prep loop field in left.$fields {{\n                                    prep if field.$ty == T.$name {{\n                                        if self.$field.equal(rhs.$field) == false -> return false\n                                    }} else {{\n                                        if self.$field != rhs.$field -> return false\n                                    }}\n                                }}\n                                return true\n                            }}\n                            else -> {{}}\n                        }}\n                        return false\n                    }}\n                    else -> {{}}\n                }}\n            }}\n            return false\n        }} else {{\n            prep if T.$kind == \"struct\" {{\n                prep loop field in T.$fields {{\n                    if self.$field != rhs.$field -> return false\n                }}\n                return true\n            }} else {{\n                prep if T.$base == \"Float\" || T.$base == \"Float32\" {{\n                    return self.raw() <= rhs.raw() && self.raw() >= rhs.raw()\n                }} else {{\n                    return self.raw() == rhs.raw()\n                }}\n            }}\n        }}\n    }}\n}}\n\nderive T.Comparable {{\n    fn compare(self, rhs: T) -> Ordering {{\n        prep if T.$kind == \"enum\" {{\n            jet_rhs_variant_index := 0\n            prep loop right in T.$fields {{\n                if rhs == {{\n                    .$right -> {{ jet_rhs_variant_index = right.$index }}\n                    else -> {{}}\n                }}\n            }}\n            prep loop left in T.$fields {{\n                if self == {{\n                    .$left -> {{\n                        if jet_rhs_variant_index > left.$index -> return .Less\n                        if jet_rhs_variant_index < left.$index -> return .Greater\n                        if rhs == {{\n                            .$left -> {{\n                                prep loop field in left.$fields {{\n                                    prep if field.$ty == T.$name {{\n                                        if self.$field.compare(rhs.$field) == {{\n                                            .Less -> return .Less\n                                            .Greater -> return .Greater\n                                            .Equal -> {{}}\n                                        }}\n                                    }} else {{\n                                        if self.$field < rhs.$field -> return .Less\n                                        if self.$field > rhs.$field -> return .Greater\n                                    }}\n                                }}\n                                return .Equal\n                            }}\n                            else -> {{}}\n                        }}\n                        return .Equal\n                    }}\n                    else -> {{}}\n                }}\n            }}\n            return .Equal\n        }} else {{\n            prep if T.$kind == \"struct\" {{\n                prep loop field in T.$fields {{\n                    if self.$field < rhs.$field -> return .Less\n                    if self.$field > rhs.$field -> return .Greater\n                }}\n                return .Equal\n            }} else {{\n                if self.raw() < rhs.raw() -> return .Less\n                if self.raw() > rhs.raw() -> return .Greater\n                return .Equal\n            }}\n        }}\n    }}\n}}\n" }
