SEMA_PRELUDE_ERROR_SOURCE :: prep { "// D-FAIL-CONV2=A (ratified 2026-08-17, card #2018): the standard library declares\n// the conversion for its own error family. A program can write `fn run()` and\n// pass a Core failure up automatically without declaring anything, because\n// these declarations already sit on the existing D-ERR-CONV rail. One source;\n// every tier lowers the same `impl <CoreError> -> Err` block, the same way\n// `Prelude/Units.jet` ships one dimension catalog.\n//\n// Sema injects only the conversions a module actually exercises — fallible\n// calls whose error type is a family member converting into the default `Err`.\n// Unused members are not copied into the module, so a defect in one conversion\n// cannot break a program that never produces that error.\n//\n// An author who wants the failure named still writes the named form\n// (`fn run() !EncodingError`), and that stays correct: this file only makes the\n// unnamed form work.\n//\n// D-FAIL-CONV1=A keeps the rest of the rule intact. A user error type still\n// needs its own `impl MyError -> Err {{ … }}`; nothing here weakens that. A module\n// that declares its own conversion for one of these pairs wins over the shipped\n// one, so a package can still say how its program reports a Core failure.\n//\n// Family membership is derived, not chosen by taste. A Core error type belongs\n// here when all three hold:\n//   1. the Prelude registers it printable — `auto_printable` in\n//      `TraitRegistry::register_synthetic_display_debug`, so the Prelude already\n//      owns its failure text;\n//   2. a Core signature returns it in the error position of a `T !E` result, so\n//      a program can actually receive one; and\n//   3. showing it is not prohibited.\n//\n// D-CRYPTO-ERRFAM1=A: `CryptoError` and `FileCryptoError` are members. Both\n// are payload-free enums that name only which check failed, so reporting the\n// case carries no secret. The secret-bearing types (`Secret`, `SigningKey`,\n// `X25519SecretKey`, `SharedSecret`) keep their E0915 print ban.\n//\n// Deliberately outside the family:\n//   * `TaskFailure` — D-FAIL-CARRIER1 gives cancellation and deadline their own\n//     carrier and report; it is not a library error family member.\n//   * `[FieldError]` — the Core decode surface returns a list, and a conversion\n//     source is one named type.\n//   * component types (`DataErrorKind`, `EncodingCause`, `IOContext`,\n//     `NetErrorDetail`, `NetDNSError`, …) — no Core call fails with one.\n\n// Original compiler-owned declarations. These private records are ordinary\n// checked nominal types; only Err carries the existing default-error role.\n// Fresh construction evaluates the declared metadata default in this owner.\n// Copy, context and conversion retain the existing stored metadata instead.\nstruct __jet_ErrorContextFrame {{\n    text: String\n    file: String\n    line: Int\n}}\nstruct __jet_ErrorConversion {{\n    source: String\n    target: String\n}}\nstruct __jet_ErrorField {{\n    name: String\n    value: String\n}}\nstruct __jet_ErrorSpan {{\n    start: Int\n    end: Int\n}}\nstruct __jet_ErrorDetails {{\n    variant: String\n    fields: [__jet_ErrorField]\n    source_span: __jet_ErrorSpan?\n}}\nstruct __jet_ErrorMetadata {{\n    typed_identity: String?\n    context_frames: [__jet_ErrorContextFrame]\n    conversion_history: [__jet_ErrorConversion]\n    details: __jet_ErrorDetails?\n}}\nstruct Err {{\n    message: String\n    code: String?\n    cause: Err?\n    __jet___memo_error_metadata: __jet_ErrorMetadata{{__jet_ErrorMetadata{{\n        typed_identity: None,\n        context_frames: [__jet_ErrorContextFrame]{{}},\n        conversion_history: [__jet_ErrorConversion]{{}},\n        details: None,\n    }}}}\n}}\n\nimpl AppError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl ArchiveError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl Base32Error -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl Base64Error -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl BuildError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl BrowserError -> Err {{\n    return Err(\"{{self}}\")\n}}\nimpl CBORError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl ComputeError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl CryptoError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl DBError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl PluginError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl DataError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl EncodingError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl EmailError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl EnvError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl FileCryptoError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl HTTPError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl HexError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl IOError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl MIMEError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl ModError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl NetError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl PerfError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl RangeError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl TextError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl TimeError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl UIHostError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl URLError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl UTF8Error -> Err {{\n    return Err(\"{{self}}\")\n}}\n\nimpl UUIDError -> Err {{\n    return Err(\"{{self}}\")\n}}\nimpl XMLError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\n\nimpl WsError -> Err {{\n    return Err(\"{{self}}\")\n}}\n\n" }
