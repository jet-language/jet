// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:36
pub fn payload_bindings(payload: VariantPayload, prefix: String) -> [String] Never! {
    count :: if payload == { .Unit -> 0; .Single -> 1; .Named(fields) -> fields.len() }
    names := [String]{}
    names.reserve(count)
    loop index in 0..<count { names.push("{prefix}{index}") }
    ^names
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:45
pub fn pattern_test(subject: String, variant: Variant, bindings: [String], span: Span) -> Expr Never! {
    slots := [PatSlot]{}
    slots.reserve(bindings.len())
    loop name in bindings { slots.push(PatSlot.Bind{name: ^name, span: span}) }
    Expr.PatternTest{subject: ident(subject, span), pattern: Pattern.Variant{variant: ~variant.name, bindings: ^slots, leading_dot: true, span: span}, span: span}
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:66
pub fn pattern_switch(subject: Expr, variant: String, bindings: [String], body: [Stmt], else_body: [Stmt]?, span: Span) -> Stmt Never! {
    slots := [PatSlot]{}
    slots.reserve(bindings.len())
    loop name in bindings { slots.push(PatSlot.Bind{name: ^name, span: span}) }
    cond :: Expr.PatternTest{subject: ~subject, pattern: Pattern.Variant{variant: ~variant, bindings: ^slots, leading_dot: true, span: span}, span: span}
    Stmt.Switch{subject: ^subject, arms: [SwitchArm]{SwitchArm{cond: ^cond, body: ^body, span: span}}, else_body: ^else_body, span: span}
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:99
pub fn result_switch(subject: Expr, ok_binding: String, ok_body: [Stmt], err_binding: String, err_body: [Stmt], span: Span) -> Stmt Never! {
    ok_subject :: ~subject
    err_subject :: ~subject
    ok_cond :: Expr.PatternTest{subject: ^ok_subject, pattern: Pattern.Variant{variant: "Ok", bindings: [PatSlot]{PatSlot.Bind{name: ~ok_binding, span: span}}, leading_dot: true, span: span}, span: span}
    err_cond :: Expr.PatternTest{subject: ^err_subject, pattern: Pattern.Variant{variant: "Err", bindings: [PatSlot]{PatSlot.Bind{name: ~err_binding, span: span}}, leading_dot: true, span: span}, span: span}
    Stmt.Switch{subject: ^subject, arms: [SwitchArm]{SwitchArm{cond: ^ok_cond, body: ^ok_body, span: span}, SwitchArm{cond: ^err_cond, body: ^err_body, span: span}}, else_body: Val([Stmt]{}), span: span}
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:152
pub fn option_switch(subject: Expr, binding_name: String, body: [Stmt], else_body: [Stmt], span: Span) -> Stmt Never! {
    pattern_switch(^subject, "Val", [String]{~binding_name}, ^body, Val(^else_body), span)
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:169
pub fn option_encode(subject: Expr, key: String, field_names: [String], span: Span) -> Stmt Never! {
    first :: field_names.first().expect("one field for option encode")
    binding_name :: "jet_serde_option_value_{first.replace('.', "_")}"
    option_switch(^subject, binding_name, [Stmt]{assign_index("out", string_expr(key, span), method(ident(binding_name, span), "encode", [Expr]{}, span), span)}, [Stmt]{}, span)
}
