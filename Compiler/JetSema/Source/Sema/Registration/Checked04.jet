// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:560
pub fn serde_zero_expr(ty: Type, span: Span) -> Expr Never! {
    if ty == {
        .Int | .IntN -> Expr.Int(0, span, None, None)
        .InlineRange(_, lo, _) -> Expr.Int(lo, span, None, None)
        .Float -> Expr.Float(0.0, span, false, None)
        .Float32 -> Expr.Float(0.0, span, true, None)
        .Bool -> Expr.Bool(false, span)
        .String -> string_expr("", span)
        .Option -> Expr.Absent(span)
        .List | .Map -> list_literal([Expr]{}, span)
        .Apply(name, args) -> struct_literal(~name, ~args, [(String, Expr)]{}, span)
        .Named(name) -> struct_literal(~name, [Type]{}, [(String, Expr)]{}, span)
        else -> struct_literal(ty.name(), [Type]{}, [(String, Expr)]{}, span)
    }
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:575
pub fn serde_default_expr(field: Field) -> Expr? Never! {
    if field.default == .Val(expr) -> return Val(~expr)
    marker := Marker?{None}
    loop candidate in field.serde_markers { if candidate.name == Syntax.MARKER_DEFAULT { marker = Val(candidate); break } }
    selected :: marker ?? return None
    if selected.expr_arg(0) == .Val(expr) {
        if selected.ct == .Val(value) -> return serde_ct_expr(value, expr.span())
        return Val(~expr)
    }
    if selected.ct == .Val(value) -> serde_ct_expr(value, selected.span) else -> None
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:595
pub fn serde_ct_expr(value: CtValue, span: Span) -> Expr? Never! {
    Val(if value == {
        .Int(number) -> Expr.Int(number, span, None, None)
        .Float(number) -> Expr.Float(if number == { .F32(f) | .F64(f) -> f }, span, false, None)
        .Bool(flag) -> Expr.Bool(flag, span)
        .Char(character) -> Expr.Char(character, span)
        .Str(text) -> string_expr(text, span)
        .BigInt(number) -> Expr.Int(0, span, None, Val(~number))
        .Bytes(values) -> {
            items := [Expr]{}
            items.reserve(values.len())
            loop byte in values { items.push(Expr.Int(Int.from(byte), span, None, None)) }
            list_literal(^items, span)
        }
        .List(values) -> {
            items := [Expr]{}
            items.reserve(values.len())
            loop item in values { items.push(serde_ct_expr(item, span) ?? return None) }
            list_literal(^items, span)
        }
        .Map(values) -> {
            entries := [(Expr, Expr)]{}
            entries.reserve(values.len())
            loop entry in values { entries.push((serde_ct_expr(entry.key.to_value(), span) ?? return None, serde_ct_expr(entry.value, span) ?? return None)) }
            map_literal(^entries, span)
        }
        .Struct -> {
            fields := [(String, Expr)]{}
            fields.reserve(value.fields.len())
            loop field in value.fields { fields.push((~field.name, serde_ct_expr(field.value, span) ?? return None)) }
            struct_literal(~value.type_name, [Type]{}, ^fields, span)
        }
        .Enum -> {
            args := [EnumLitArg]{}
            args.reserve(value.args.len())
            loop argument in value.args {
                checked :: serde_ct_expr(argument.value, span) ?? return None
                args.push(if argument.label == { .Val(name) -> EnumLitArg.Named{label: ~name, expr: ^checked}; .None -> EnumLitArg.Positional(^checked) })
            }
            Expr.EnumLit{type_name: ~value.type_name, variant: ~value.variant, variant_span: None, args: ^args, leading_dot: false, span: span}
        }
        .Present(inner) -> Expr.Present(serde_ct_expr(inner, span) ?? return None, span)
        .Failed(.Clean(_)) -> Expr.Absent(span)
        .Failed(.Told(inner)) -> Expr.Err(serde_ct_expr(inner, span) ?? return None, span)
        .Unit | .Closure -> return None
    })
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:672
pub fn has_marker(markers: [Marker], name: String) -> Bool Never! { markers.any(|marker| marker.name == name) }
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:676
pub fn serde_enum_variant_key(v: Variant, style: String?) -> String Never! {
    loop marker in v.serde_markers {
        if marker.name == Syntax.MARKER_RENAME -> return marker_static_string_for(marker, "json") ?? marker_static_string(marker) ?? serde_rename_all_name(style, v.name)
    }
    serde_rename_all_name(style, v.name)
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:686
pub fn marker_static_string(marker: Marker) -> String? Never! {
    if marker.ct == .Val(.Str(value)) -> return Val(~value)
    expression :: marker.expr_arg(0) ?? return None
    static_string_expr(expression)
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:693
pub fn marker_static_string_for(marker: Marker, label: String) -> String? Never! {
    loop index in 0..<marker.arg_labels.len() {
        if marker.arg_labels[index] == .Val((name, _)) && name == label {
            arg :: marker.args.get(index) ?? return None
            expression :: arg.as_expr() ?? return None
            return static_string_expr(expression)
        }
    }
    None
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:704
pub fn static_string_expr(expression: Expr) -> String? Never! {
    if expression != .Str(parts, _) -> return None
    if parts.first() == .Val(.Lit(value)) -> Val(~value) else -> None
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:715
pub fn serde_rename_all_style(container: [Marker]) -> String? Never! {
    loop marker in container {
        if marker.name == Syntax.MARKER_RENAME_ALL {
            expression :: marker.expr_arg(0) ?? return None
            if expression == .Ident(name, _) -> return Val(~name)
            return None
        }
    }
    None
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:726
pub fn serde_rename_all_name(style: String?, name: String) -> String Never! {
    if style == {
        .Val("camel") -> Syntax.to_camel_acronym(name)
        .Val("kebab") -> Syntax.to_snake_acronym(name).replace('_', "-")
        .Val("screaming") -> Syntax.to_shouty_acronym(name)
        .Val("pascal") -> Syntax.to_pascal_acronym(name)
        .Val("snake") -> Syntax.to_snake_acronym(name)
        else -> ~name
    }
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:737
pub fn serde_field_key(structure: StructDef, field: Field) -> String Never! {
    ~shape_field_names(structure, field).name_for(ShapeProjectionKind.Json).expect("checked serde field is missing its JSON shape name")
}
