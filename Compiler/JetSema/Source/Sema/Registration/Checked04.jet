// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:458
pub fn method_with_owner_args(receiver: Expr, name: String, owner_type_args: [Type], args: [Expr], span: Span) -> Expr Never! {
    call_args := [CallArg]{}
    call_args.reserve(args.len())
    loop expr in args { call_args.push(call_arg(^expr, span)) }
    Expr.MethodCall{receiver: ^receiver, method: ~name, method_span: span, owner_type_args: ^owner_type_args, type_args: [], args: ^call_args, recv_type: if name == "encode" { Val("__SerdeEncode__") } else { None }, resolved_ret: None, operator_rhs: None, checked_widen: false}
}
