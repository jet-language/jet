// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:391
pub fn data_tree_variant(variant: String, args: [Expr], span: Span) -> Expr Never! {
    if args.is_empty() -> return Expr.Field(ident("DataTree", span), ~variant, span)
    call_args := [CallArg]{}
    call_args.reserve(args.len())
    loop expr in args { call_args.push(call_arg(^expr, span)) }
    Expr.MethodCall{receiver: ident("DataTree", span), method: ~variant, method_span: span, owner_type_args: [], type_args: [], args: ^call_args, recv_type: None, resolved_ret: None, operator_rhs: None, checked_widen: false}
}
// Rust: crates/jet-sema/src/Sema/Registration/Serde/Ast.rs:410
pub fn struct_literal(name: String, type_args: [Type], fields: [(String, Expr)], span: Span) -> Expr Never! {
    converted := [(String, Span, Expr)]{}
    converted.reserve(fields.len())
    loop (field_name, expr) in fields { converted.push((^field_name, span, ^expr)) }
    Expr.StructLit{type_name: ^name, type_args: ^type_args, import_ns: None, as_trait: None, fields: ^converted, inferred: false, span: span}
}
