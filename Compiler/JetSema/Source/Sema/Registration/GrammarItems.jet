// The items a grammar declares. A module binding whose value is a
// `core.grammar.Grammar` literal (sema_grammar_declaring_binding) gives way,
// before registration, to the types its plan describes:
//   a struct per parser rule of one alternative, an enum per rule of several
//                                  (the rule's fields and cases, in order)
//   `<Start>Rule`                  a case per parser rule, numbered by rule
//   `<Start>Token`                 a case per token kind, numbered by kind
//   `<Start>Slot`                  a case per hole, when the grammar has holes
// and to the parser (GrammarParse.jet): each rule type's `parse(text)`, a
// private function per parser rule, and the private scanner constant; to
// the parse into a sink and the check of a literal's parts
// (GrammarWalk.jet) and to the printer (GrammarPrint.jet).
// `<Start>` is the binding's name. The rule and token enums are
// `#Layout(U32)`, so `PairRule.from_int(rule)` names the rule a sink
// receives. Each type takes the binding's visibility, and every name and
// shape is the plan's (Core/Grammar/Shape.jet): this file only arranges the
// plan as items. A binding whose literal the check refused has no plan and
// stays, so the compile proper reports its faults; one whose name is no
// parser rule's type stays too, and reports that it names no start rule. A
// plan read without its rule tree describes the types alone.
use {
    jet_foundation.[
        AST_NODE_GENERATED,
        CallLabel,
        CLICommandBinding,
        ConstDef,
        CtValue,
        Diagnostic,
        EnumDef,
        EnumGroup,
        Expr,
        Field,
        Func,
        Item,
        Marker,
        MarkerCallArg,
        NamedCtValue,
        NamedSpan,
        Program,
        Span,
        Stmt,
        StructDef,
        TraitImplBlock,
        Type,
        TypeParam,
        Variant,
        VariantField,
        VariantPayload,
        expr_span,
    ]
}

// What a generated field holds (core.grammar GrammarFieldKind): a token's
// text, a value of another rule's type, or whether an optional literal was
// there.
SemaGrammarFieldKind: enum {
    Text,
    Rule,
    Flag,
}

// One field of a generated type (core.grammar GrammarField): `nodes` are
// the elements that set it.
SemaGrammarField: struct {
    name: String,
    kind: SemaGrammarFieldKind,
    rule: Int,
    optional: Bool,
    list: Bool,
    nodes: [Int],
}

// One case of a generated enum (core.grammar GrammarCase): the alternative
// `alt` it parses, its fields, or the rule `wraps` whose value it carries
// (-1 for none).
SemaGrammarCase: struct {
    name: String,
    alt: Int,
    fields: [SemaGrammarField],
    wraps: Int,
}

// The type parser rule `rule` generates (core.grammar GrammarShape).
SemaGrammarShape: struct {
    rule: Int,
    name: String,
    is_enum: Bool,
    fields: [SemaGrammarField],
    cases: [SemaGrammarCase],
}

// One rule of the grammar (core.grammar GrammarRule): whether it is a
// parser rule, and its body node.
SemaGrammarRule: struct {
    name: String,
    parser: Bool,
    body: Int,
}

// One element of the rule tree (core.grammar GrammarNode): its kind's
// name, children, label, the rule a reference names and the token kind an
// atom takes (-1 for none).
SemaGrammarNode: struct {
    kind: String,
    children: [Int],
    label: String,
    rule: Int,
    token: Int,
}

// One operator of an operator rule (core.grammar GrammarOperator): its
// alternative, its tail (-1 for a prefix operator), its kind's name
// (Binary, Prefix or Suffix), its level, whether it groups from the right,
// and the level each element parses at (-1 for none).
SemaGrammarOperator: struct {
    alt: Int,
    tail: Int,
    kind: String,
    level: Int,
    right: Bool,
    operands: [Int],
}

// An operator rule's parse (core.grammar GrammarOperatorRule): the choice
// of its primaries and the repeat of its tails.
SemaGrammarOperatorRule: struct {
    rule: Int,
    primary: Int,
    repeat: Int,
    operators: [SemaGrammarOperator],
}

// What the items are made of: the plan's shapes, each token kind's case
// name, each kind's hole name ("" for a kind that is no hole), the parse:
// the rule tree, each node's decision and the operator rules, and each
// rule's grouping alternative (-1 for none) the printer parenthesizes with.
SemaGrammarItemsPlan: struct {
    shapes: [SemaGrammarShape],
    kind_names: [String],
    holes: [String],
    rules: [SemaGrammarRule],
    nodes: [SemaGrammarNode],
    decision_of: [Int],
    operators: [SemaGrammarOperatorRule],
    groups: [Int],
}

// Replace each module binding `plans` names with the items its plan
// describes, accepted as a rule's generated items (UserTemplates.jet
// sema_user_rule_accept), and add the imports the parsers read. A binding
// whose name is no parser rule's type names no start rule: it stays, and
// reports so.
sema_grammar_items_expand: fn(program: ^Program, plans: ^^[NamedCtValue], diagnostics: ^[Diagnostic]) {
    ^parsers: false
    loop plan in plans.move() {
        ^index: -1
        loop (position, item) in program.items {
            if item == .Const(definition) && definition.name == plan.name {
                index = position
                break
            }
        }
        if index < 0 -> next
        read: sema_grammar_items_plan(plan.value)
        if program.items[index] == .Const(definition) && sema_grammar_start_report(definition, read) == .Val(report) {
            diagnostics.push(report)
            next
        }
        removed: program.items.remove(index, .Slot) ?? next
        if removed == .Const(definition) {
            if read.rules.len() > 0 -> parsers = true
            ^expanded: sema_grammar_items(definition, read, plan.value)
            ^generated: [Item]{}
            sema_user_rule_accept(program.items, "Grammar", None, expr_span(definition.value), expanded.move(), generated, diagnostics)
            loop item in generated.move() -> program.items.push(item)
        }
    }
    if parsers -> sema_grammar_imports(program.imports)
}

// The report of grammar binding `definition` when its name is no parser
// rule's type in `plan`, so names no rule a parse starts from.
sema_grammar_start_report: fn(definition: ConstDef, plan: SemaGrammarItemsPlan) -> Diagnostic? Never! {
    if plan.shapes.len() == 0 -> return None
    loop shape in plan.shapes {
        if shape.name == definition.name -> return None
    }
    example: plan.shapes[0]
    rule: if example.rule < plan.rules.len() -> "`{plan.rules[example.rule].name}`" else -> "its rule"
    Val(sema_error("E2718", definition.name_span, "`{definition.name}` names no rule of its grammar", "The binding's name picks the rule a parse starts from: the rule whose name in PascalCase it is", "Name the binding for the rule a parse starts from, as `{example.name}` names {rule}"))
}

// The items of grammar binding `definition` with plan `plan`, computed as
// `value`.
sema_grammar_items: fn(definition: ConstDef, plan: SemaGrammarItemsPlan, value: CtValue) -> [Item] Never! {
    span: expr_span(definition.value)
    ^rule_types: [String]{}
    loop _ in plan.rules -> rule_types.push("")
    loop shape in plan.shapes {
        loop rule_types.len() <= shape.rule -> rule_types.push("")
        rule_types[shape.rule] = shape.name.copy()
    }
    parses: plan.rules.len() > 0
    gen: SemaGrammarGen{start: definition.name.copy(), types: rule_types.copy(), span: span}
    holes: sema_grammar_has_holes(plan)
    ^items: [Item]{}
    loop shape in plan.shapes {
        ^methods: [Func]{}
        if parses {
            methods.push(sema_grammar_parse_method(gen, plan, shape, definition.is_pub, definition.is_package_pub))
            sema_grammar_print_methods(gen, plan, shape, definition.is_pub, definition.is_package_pub, methods)
            methods.push(sema_grammar_into_method(gen, plan, shape, definition.is_pub, definition.is_package_pub))
            if holes -> methods.push(sema_grammar_check_method(gen, plan, shape, definition.is_pub, definition.is_package_pub))
        }
        if shape.is_enum {
            ^variants: [Variant]{}
            loop case in shape.cases {
                ^payload: VariantPayload.Unit
                if case.wraps >= 0 {
                    payload = VariantPayload.Single{ty: Type.Named{name: rule_types[case.wraps].copy()}, span: span}
                } else if case.fields.len() > 0 {
                    ^fields: [VariantField]{}
                    loop field in case.fields {
                        fields.push(VariantField{name: field.name.copy(), name_span: span, ty: sema_grammar_field_type(field, rule_types), ty_span: span})
                    }
                    payload = VariantPayload.Named{fields: fields}
                }
                variants.push(Variant{name: case.name.copy(), name_span: span, payload: payload, discriminant: None, discriminant_expr: None, serde_markers: [Marker]{}})
            }
            items.push(Item.Enum{value: sema_grammar_enum(definition, shape.name.copy(), variants, [Marker]{}, methods.move())})
        } else {
            ^fields: [Field]{}
            loop field in shape.fields {
                fields.push(Field{is_pub: true, is_package_pub: false, name: field.name.copy(), name_span: span, ty: sema_grammar_field_type(field, rule_types), ty_span: span, serde_markers: [Marker]{}, redact: false, computed: None, default: None, default_ct: None})
            }
            items.push(Item.Struct{value: sema_grammar_struct(definition, shape.name.copy(), fields, methods.move())})
        }
    }
    ^rules: [Variant]{}
    loop shape in plan.shapes -> rules.push(sema_grammar_numbered(shape.name.copy(), shape.rule, span))
    items.push(Item.Enum{value: sema_grammar_enum(definition, "{definition.name}Rule", rules, [Marker]{sema_grammar_layout(span)}, [Func]{})})
    ^kinds: [Variant]{}
    ^slots: [Variant]{}
    loop (kind, name) in plan.kind_names {
        kinds.push(sema_grammar_numbered(name.copy(), kind, span))
        if kind < plan.holes.len() && plan.holes[kind] != "" {
            slots.push(Variant{name: sema_grammar_slot_name(plan, kind), name_span: span, payload: VariantPayload.Unit, discriminant: None, discriminant_expr: None, serde_markers: [Marker]{}})
        }
    }
    items.push(Item.Enum{value: sema_grammar_enum(definition, "{definition.name}Token", kinds, [Marker]{sema_grammar_layout(span)}, [Func]{})})
    if slots.len() > 0 {
        items.push(Item.Enum{value: sema_grammar_enum(definition, sema_grammar_slot_type(gen), slots, [Marker]{}, [Func]{})})
    }
    if parses {
        sema_grammar_parser_items(gen, plan, value, items)
        sema_grammar_printer_items(gen, plan, value, items)
        sema_grammar_walk_items(gen, plan, items)
    }
    items
}

// The type of `field`: `String`, `Bool` or the type of the rule it holds,
// in a list or an option as the field is.
sema_grammar_field_type: fn(field: SemaGrammarField, rule_types: [String]) -> Type Never! {
    held: if field.kind == {
        .Text -> Type.String
        .Flag -> Type.Bool
        .Rule -> Type.Named{name: rule_types[field.rule].copy()}
    }
    if field.list -> return Type.List{element: held}
    if field.optional -> return Type.Option{inner: held}
    held
}

// Case `name` of a numbered enum, numbered `number`.
sema_grammar_numbered: fn(name: String, number: Int, span: Span) -> Variant Never! {
    written: Expr.Int{value: number, span: span, width: None, raw: None, id: AST_NODE_GENERATED}
    Variant{name: name, name_span: span, payload: VariantPayload.Unit, discriminant: Val(number), discriminant_expr: Val(written), serde_markers: [Marker]{}}
}

// `#Layout(U32)`, which numbers an enum's cases (EnumNumbers.jet).
sema_grammar_layout: fn(span: Span) -> Marker Never! {
    backing: Expr.Ident{name: "U32", span: span, id: AST_NODE_GENERATED}
    Marker{name: "Layout", negated: false, name_span: span, args: [MarkerCallArg]{MarkerCallArg.Expr{value: backing}}, arg_labels: [CallLabel?]{None}, span: span, ct: None}
}

sema_grammar_struct: fn(definition: ConstDef, name: String, fields: [Field], methods: [Func]) -> StructDef Never! {
    span: expr_span(definition.value)
    StructDef{
        span: span,
        is_pub: definition.is_pub,
        is_package_pub: definition.is_package_pub,
        name: name,
        name_span: span,
        type_params: [TypeParam]{},
        fields: fields,
        state: None,
        methods: methods,
        cli_bindings: [CLICommandBinding]{},
        trait_impls: [TraitImplBlock]{},
        derives: [NamedSpan]{},
        auto_derive_default: true,
        is_published_schema: false,
        published_schema_span: None,
        is_single_use: false,
        single_use_span: None,
        is_must_use: false,
        must_use_span: None,
        layout: None,
        layout_span: None,
        layout_alignment_span: None,
        serde_markers: [Marker]{},
        type_markers: [Marker]{},
        validate_block: [Stmt]{},
        validate_span: None,
    }
}

sema_grammar_enum: fn(definition: ConstDef, name: String, variants: [Variant], markers: [Marker], methods: [Func]) -> EnumDef Never! {
    span: expr_span(definition.value)
    EnumDef{
        span: span,
        is_pub: definition.is_pub,
        is_package_pub: definition.is_package_pub,
        name: name,
        name_span: span,
        type_params: [TypeParam]{},
        variants: variants,
        methods: methods,
        trait_impls: [TraitImplBlock]{},
        derives: [NamedSpan]{},
        auto_derive_default: true,
        is_single_use: false,
        single_use_span: None,
        is_must_use: false,
        must_use_span: None,
        serde_markers: [Marker]{},
        type_markers: markers,
        groups: [EnumGroup]{},
    }
}

// Read the parts of a computed `GrammarPlan` value the items are made of.
sema_grammar_items_plan: fn(value: CtValue) -> SemaGrammarItemsPlan Never! {
    ^plan: SemaGrammarItemsPlan{shapes: [SemaGrammarShape]{}, kind_names: [String]{}, holes: [String]{}, rules: [SemaGrammarRule]{}, nodes: [SemaGrammarNode]{}, decision_of: [Int]{}, operators: [SemaGrammarOperatorRule]{}, groups: [Int]{}}
    if value == .Struct(_, entries) {
        loop entry in entries {
            if entry.name == "tree" -> sema_grammar_tree(entry.value, plan)
            if entry.name == "printer" -> plan.groups = sema_grammar_member_ints(entry.value, "groups")
            if entry.value == .List(values) {
                if entry.name == {
                    "shapes" -> loop shape in values -> plan.shapes.push(sema_grammar_shape(shape))
                    "kind_names" -> loop name in values -> plan.kind_names.push(sema_grammar_text(name))
                    "tokens" -> loop token in values -> plan.holes.push(sema_grammar_member_text(token, "hole"))
                    "decision_of" -> plan.decision_of = sema_grammar_ints(entry.value)
                    "operators" -> loop operator in values -> plan.operators.push(sema_grammar_operator_rule(operator))
                    else -> {}
                }
            }
        }
    }
    plan
}

// Read the rules and nodes of a computed `RuleTree` into `plan`.
sema_grammar_tree: fn(value: CtValue, plan: ^SemaGrammarItemsPlan) Never! {
    if value == .Struct(_, entries) {
        loop entry in entries {
            if entry.value == .List(values) {
                if entry.name == {
                    "rules" -> loop rule in values -> plan.rules.push(sema_grammar_rule(rule))
                    "nodes" -> loop node in values -> plan.nodes.push(sema_grammar_node(node))
                    else -> {}
                }
            }
        }
    }
}

sema_grammar_rule: fn(value: CtValue) -> SemaGrammarRule Never! {
    ^rule: SemaGrammarRule{name: "", parser: false, body: -1}
    if value == .Struct(_, entries) {
        loop entry in entries {
            if entry.name == {
                "name" -> rule.name = sema_grammar_text(entry.value)
                "kind" -> rule.parser = sema_grammar_variant(entry.value) == "Parser"
                "body" -> rule.body = sema_grammar_int(entry.value)
                else -> {}
            }
        }
    }
    rule
}

sema_grammar_node: fn(value: CtValue) -> SemaGrammarNode Never! {
    ^node: SemaGrammarNode{kind: "", children: [Int]{}, label: "", rule: -1, token: -1}
    if value == .Struct(_, entries) {
        loop entry in entries {
            if entry.name == {
                "kind" -> node.kind = sema_grammar_variant(entry.value)
                "children" -> node.children = sema_grammar_ints(entry.value)
                "label" -> node.label = sema_grammar_text(entry.value)
                "rule" -> node.rule = sema_grammar_int(entry.value)
                "token" -> node.token = sema_grammar_int(entry.value)
                else -> {}
            }
        }
    }
    node
}

sema_grammar_operator_rule: fn(value: CtValue) -> SemaGrammarOperatorRule Never! {
    ^operator_rule: SemaGrammarOperatorRule{rule: -1, primary: -1, repeat: -1, operators: [SemaGrammarOperator]{}}
    if value == .Struct(_, entries) {
        loop entry in entries {
            if entry.name == {
                "rule" -> operator_rule.rule = sema_grammar_int(entry.value)
                "primary" -> operator_rule.primary = sema_grammar_int(entry.value)
                "repeat" -> operator_rule.repeat = sema_grammar_int(entry.value)
                "operators" -> if entry.value == .List(values) {
                    loop op in values -> operator_rule.operators.push(sema_grammar_operator(op))
                }
                else -> {}
            }
        }
    }
    operator_rule
}

sema_grammar_operator: fn(value: CtValue) -> SemaGrammarOperator Never! {
    ^op: SemaGrammarOperator{alt: -1, tail: -1, kind: "", level: -1, right: false, operands: [Int]{}}
    if value == .Struct(_, entries) {
        loop entry in entries {
            if entry.name == {
                "alt" -> op.alt = sema_grammar_int(entry.value)
                "tail" -> op.tail = sema_grammar_int(entry.value)
                "kind" -> op.kind = sema_grammar_variant(entry.value)
                "level" -> op.level = sema_grammar_int(entry.value)
                "right" -> op.right = entry.value == .Bool(true)
                "operands" -> op.operands = sema_grammar_ints(entry.value)
                else -> {}
            }
        }
    }
    op
}

sema_grammar_shape: fn(value: CtValue) -> SemaGrammarShape Never! {
    ^shape: SemaGrammarShape{rule: -1, name: "", is_enum: false, fields: [SemaGrammarField]{}, cases: [SemaGrammarCase]{}}
    if value == .Struct(_, entries) {
        loop entry in entries {
            if entry.name == {
                "rule" -> shape.rule = sema_grammar_int(entry.value)
                "name" -> shape.name = sema_grammar_text(entry.value)
                "is_enum" -> shape.is_enum = entry.value == .Bool(true)
                "fields" -> shape.fields = sema_grammar_fields(entry.value)
                "cases" -> if entry.value == .List(values) {
                    loop case in values -> shape.cases.push(sema_grammar_case(case))
                }
                else -> {}
            }
        }
    }
    shape
}

sema_grammar_case: fn(value: CtValue) -> SemaGrammarCase Never! {
    ^case: SemaGrammarCase{name: "", alt: -1, fields: [SemaGrammarField]{}, wraps: -1}
    if value == .Struct(_, entries) {
        loop entry in entries {
            if entry.name == {
                "name" -> case.name = sema_grammar_text(entry.value)
                "alt" -> case.alt = sema_grammar_int(entry.value)
                "fields" -> case.fields = sema_grammar_fields(entry.value)
                "wraps" -> case.wraps = sema_grammar_int(entry.value)
                else -> {}
            }
        }
    }
    case
}

sema_grammar_fields: fn(value: CtValue) -> [SemaGrammarField] Never! {
    ^fields: [SemaGrammarField]{}
    if value == .List(values) {
        loop field in values -> fields.push(sema_grammar_field(field))
    }
    fields
}

sema_grammar_field: fn(value: CtValue) -> SemaGrammarField Never! {
    ^field: SemaGrammarField{name: "", kind: SemaGrammarFieldKind.Text, rule: -1, optional: false, list: false, nodes: [Int]{}}
    if value == .Struct(_, entries) {
        loop entry in entries {
            if entry.name == {
                "name" -> field.name = sema_grammar_text(entry.value)
                "kind" -> if entry.value == .Enum(_, variant, _) {
                    if variant == "Rule" {
                        field.kind = .Rule
                    } else if variant == "Flag" {
                        field.kind = .Flag
                    }
                }
                "rule" -> field.rule = sema_grammar_int(entry.value)
                "optional" -> field.optional = entry.value == .Bool(true)
                "list" -> field.list = entry.value == .Bool(true)
                "nodes" -> field.nodes = sema_grammar_ints(entry.value)
                else -> {}
            }
        }
    }
    field
}

// Text field `name` of struct value `value` ("" when it has none).
sema_grammar_member_text: fn(value: CtValue, name: String) -> String Never! {
    if value == .Struct(_, entries) {
        loop entry in entries {
            if entry.name == name -> return sema_grammar_text(entry.value)
        }
    }
    ""
}

// Int list member `name` of struct value `value` (empty when it has none).
sema_grammar_member_ints: fn(value: CtValue, name: String) -> [Int] Never! {
    if value == .Struct(_, entries) {
        loop entry in entries {
            if entry.name == name -> return sema_grammar_ints(entry.value)
        }
    }
    [Int]{}
}

sema_grammar_text: fn(value: CtValue) -> String Never! {
    if value == .Str(text) -> return text.copy()
    ""
}

sema_grammar_int: fn(value: CtValue) -> Int Never! {
    if value == .Int(number) -> number else -> -1
}

// The variant an enum value names ("" for a value that is no enum).
sema_grammar_variant: fn(value: CtValue) -> String Never! {
    if value == .Enum(_, variant, _) -> return variant.copy()
    ""
}

sema_grammar_ints: fn(value: CtValue) -> [Int] Never! {
    ^numbers: [Int]{}
    if value == .List(values) {
        loop number in values -> numbers.push(sema_grammar_int(number))
    }
    numbers
}
