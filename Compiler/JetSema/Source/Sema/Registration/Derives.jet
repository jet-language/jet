// Built-in derive providers are the Prelude markers in
// SEMA_PRELUDE_DERIVE_SOURCE (PreludeDerives.jet). Each selected capability
// expands the marker's typed template body for one declaration and enters
// registration as a compiler-generated trait block, exactly like the Rust
// bootstrap's + `Comptime::expand_derive_body`.
//
// Expansion is linear in the template: `comptime if` selects its branch before
// the branch is expanded, `comptime loop` pushes one binding onto the shared scope
// per value, and conditions are answered directly on the scope values the
// template already owns (no merged scope snapshot per condition).
use {
    jet_foundation.[
        AST_NODE_GENERATED,
        AccessConvention,
        BinOp,
        BindPattern,
        Binding,
        CallArg,
        ContextField,
        ContractClause,
        CtEnumArg,
        CtReport,
        CtValue,
        DIAGNOSTIC_ERROR,
        DIAGNOSTIC_LINT,
        DeriveBodyItem,
        Diagnostic,
        DiagnosticLabel,
        DistinctDef,
        EffectRowEntry,
        EnumDef,
        EnumLitArg,
        Expr,
        ExprField,
        ExprPair,
        Field,
        ForKind,
        Func,
        ImplConstValue,
        ImplDef,
        Item,
        LValue,
        Lambda,
        LambdaBody,
        LambdaParam,
        MARKER_MEMO,
        Marker,
        MarkerCallArg,
        MarkerDecl,
        NamedCtValue,
        NamedSpan,
        NamedType,
        OrFallback,
        Param,
        ParamZone,
        PatSlot,
        Pattern,
        PipeStep,
        Span,
        Stmt,
        StrFormat,
        StrMatchPart,
        StrPart,
        StructDef,
        SwitchArm,
        TaskGroupArgs,
        TraitImplBlock,
        TupleField,
        Type,
        TypeParam,
        TypeTupleField,
        TypedLitBody,
        UnOp,
        Variant,
        VariantField,
        VariantPayload,
        ast_comptime_value_type,
        ast_empty_call_arg_flags,
        ast_func,
        comptime_walk_identifiers,
        diagnostic_from_registry,
        diagnostic_registry_row,
        diagnostic_sentence_case_line,
        expr_source_span,
        expr_span,
        owned_trait_codec,
        owned_trait_structural_names,
        type_name,
    ]
    jet_parser.[
        parse_source,
    ]
}

SemaDeriveExpansion: struct {
    scope: [NamedCtValue]
    failure: Diagnostic?
    // The `Diagnostic` impls a rule body may raise with `reject(value)`.
    reports: [SemaDeriveReport]{[SemaDeriveReport]{}}
    // The rule's use site: a rejection's primary span.
    site: Span?{None}
    // A marker template of another module: its module identity, which each
    // generated function records (Func.definition_module), and the names
    // pastes produced so far ("" and nothing recorded otherwise).
    definition_module: String{""}
    pasted: [String]{[String]{}}
}

// One `impl T.Diagnostic` visible to a rule body. The declaring module's
// name and `T` make the type path that is the report's default code.
SemaDeriveReport: struct {
    module_name: String
    definition: ImplDef
}

// A template paste `#{name}` names the binding `name`; a `$fact` member is
// the compiler fact `fact`.
sema_derive_bare: fn(name: String) -> String Never! {
    if sema_derive_splice(name) && name.ends_with("}}") -> return name.slice(2, name.len() - 1)
    if name.starts_with("$") -> String.from_bytes(name.bytes()[1..<name.bytes().len()]) ?? name.copy() else -> name.copy()
}

// Whether `name` is a template paste `#{name}`, which the lexer reads as one
// word.
sema_derive_splice: fn(name: String) -> Bool Never! {
    name.starts_with("#{{")
}

// The field a typed layout selector `[.field]` names. The parser keeps the
// selector as an internal identifier, NUL + `jet.layout.selector.<field>`
// (JetParser parser_task_internal).
sema_derive_layout_selector: fn(index: Expr) -> String? Never! {
    if index == .Ident(name, _, _) {
        nul: String.from_bytes([U8]{U8{0}}) ?? ""
        prefix: "{nul}jet.layout.selector."
        if !name.starts_with(prefix) -> return None
        text: String.from_bytes(name.bytes()[prefix.count_bytes()..<name.bytes().len()]) ?? return None
        return Val(text)
    }
    None
}

// The innermost scope row binding `name`, read in place by callers that only
// inspect its value.
sema_derive_scope_index: fn(expansion: SemaDeriveExpansion, name: String) -> Int? Never! {
    key: sema_derive_bare(name)
    index := expansion.scope.len() - 1
    loop index >= 0 {
        if expansion.scope[index].name == key -> return Val(index)
        index -= 1
    }
    None
}

sema_derive_scope_value: fn(expansion: SemaDeriveExpansion, name: String) -> CtValue? Never! {
    index: sema_derive_scope_index(expansion, name) ?? return None
    Val(expansion.scope[index].value)
}

sema_derive_fail: fn(expansion: &SemaDeriveExpansion, diagnostic: Diagnostic) Never! {
    if expansion.failure == None -> expansion.failure = Val(diagnostic)
}

sema_derive_struct_field: fn(value: CtValue, name: String) -> CtValue? Never! {
    if value == .Struct(_, fields) {
        key: sema_derive_bare(name)
        loop field in fields {
            if field.name == key -> return Val(field.value)
        }
    }
    None
}

sema_derive_value_type_name: fn(value: CtValue) -> String Never! {
    type_name(ast_comptime_value_type(value))
}

// ---------------------------------------------------------------------------
// Static condition evaluation (Rust `MirBridge::static_ct_value`).

sema_derive_static_value: fn(expansion: SemaDeriveExpansion, expression: Expr) -> CtValue? Never! {
    if expression == {
        .Int(value, _, _, _, _) -> Val(CtValue.Int{value: value})
        .Bool(value, _, _) -> Val(CtValue.Bool{value: value})
        .Str(parts, _, _) -> sema_derive_static_str(expansion, parts)
        .StructLit(type_name, _, _, _, fields, _, _, _) -> sema_derive_static_struct(expansion, type_name, fields)
        .TypedLit(head, body, _, _) -> sema_derive_static_typed(expansion, head, body)
        .EnumLit(type_name, variant, _, args, _, _, _) -> {
            if args.len() != 0 -> return None
            Val(CtValue.Enum{type_name: type_name, variant: sema_derive_bare(variant), args: [CtEnumArg]{}})
        }
        .Present(value, _, _) -> {
            inner: sema_derive_static_value(expansion, value) ?? return None
            Val(CtValue.Present{value: inner})
        }
        .Unary(op, operand, _, _) -> {
            if op != UnOp.Not -> return None
            inner: sema_derive_static_value(expansion, operand) ?? return None
            if inner == {
                .Bool(value) -> Val(CtValue.Bool{value: !value})
                .Int(_) | .Float(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> None
            }
        }
        .Binary(op, left, right, _, _) -> {
            lhs: sema_derive_static_value(expansion, left) ?? return None
            rhs: sema_derive_static_value(expansion, right) ?? return None
            sema_derive_static_binary(op, lhs, rhs)
        }
        .ListLit(elements, _, _) -> {
            values := [CtValue]{}
            loop element in elements {
                value: sema_derive_static_value(expansion, element) ?? return None
                values.push(value)
            }
            Val(CtValue.List{values: values})
        }
        .Paren(value, _, _) | .Copy(value, _, _) -> sema_derive_static_value(expansion, value)
        .Ident(name, _, _) -> sema_derive_scope_value(expansion, name)
        .ComptimeName(name, _, value, _) -> {
            if value == .Val(known) -> return Val(known)
            sema_derive_scope_value(expansion, name)
        }
        .Field(base, member, _, _) -> {
            owner: sema_derive_static_value(expansion, base) ?? return None
            direct: sema_derive_struct_field(owner, member)
            if direct != None || !member.starts_with("$") -> return direct
            sema_derive_fact_read(owner, sema_derive_bare(member))
        }
        .Index(base, index, _, _, _) -> {
            owner: sema_derive_static_value(expansion, base) ?? return None
            // `info[.count]`: a typed selector names one reflected field row.
            if sema_derive_layout_selector(index) == .Val(field) -> return sema_derive_named_row(owner, "fields", field)
            position: sema_derive_static_value(expansion, index) ?? return None
            if owner == .List(values) {
                if position == .Int(at) {
                    if at >= 0 && at < values.len() -> return Val(values[at])
                }
            }
            if position == .Enum(_, variant, selector_args) {
                if selector_args.len() == 0 -> return sema_derive_named_row(owner, "fields", variant)
            }
            CtValue?{None}
        }
        .MethodCall(receiver, method, _, _, _, args, _) -> sema_derive_static_method(expansion, receiver, method, args)
        // `target.marker(T)?.text`: a present value's field; an absent one
        // stays absent.
        .OptField(base, member, _, _, _, _) -> {
            owner: sema_derive_static_value(expansion, base) ?? return None
            if owner == {
                .Present(inner) -> {
                    field: sema_derive_struct_field(inner, member) ?? return None
                    Val(CtValue.Present{value: field})
                }
                .Failed(_) -> Val(owner)
                .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Unit | .Closure(_) -> None
            }
        }
        // `value ?? fallback` over a known-time Option: its present value,
        // else the fallback value.
        .OrFallback(value, fallback, _, _, _) -> {
            owner: sema_derive_static_value(expansion, value) ?? return None
            if owner == {
                .Present(inner) -> Val(inner)
                .Failed(_) -> {
                    if fallback == .Value(other) -> return sema_derive_static_value(expansion, other)
                    None
                }
                .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Unit | .Closure(_) -> None
            }
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Place(_, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> CtValue?{None}
    }
}

sema_derive_static_length: fn(owner: CtValue) -> CtValue? Never! {
    count := -1
    if owner == .List(values) -> count = values.len()
    if owner == .Bytes(bytes) -> count = bytes.len()
    if owner == .Map(entries) -> count = entries.len()
    if owner == .Str(text) -> count = text.chars().len()
    if count < 0 -> return None
    Val(CtValue.Int{value: count})
}

// `.len()`, `T.reflect()` over the handle itself, and the reflection
// metadata predicates over the handle's own rows.
sema_derive_static_method: fn(expansion: SemaDeriveExpansion, receiver: Expr, method: String, args: [CallArg]) -> CtValue? Never! {
    owner: sema_derive_static_value(expansion, receiver) ?? return None
    // `text.contains(part)`, `text.starts_with(part)` and
    // `text.ends_with(part)` over known-time text (a declared text block's
    // `target`, a marker's own String argument).
    if (method == "contains" || method == "starts_with" || method == "ends_with") && args.len() == 1 {
        if owner == .Str(text) {
            part: sema_derive_static_value(expansion, args[0].expr) ?? return None
            if part == .Str(needle) {
                found := text.contains(needle)
                if method == "starts_with" -> found = text.starts_with(needle)
                if method == "ends_with" -> found = text.ends_with(needle)
                return Val(CtValue.Bool{value: found})
            }
            return None
        }
    }
    if args.len() == 0 {
        if method == "len" -> return sema_derive_static_length(owner)
        if method == "reflect" && sema_derive_named_type(owner) == "TypeInfo" -> return Val(owner)
        return None
    }
    if args.len() != 1 -> return None
    if method == "marker" {
        written: sema_derive_marker_name(args[0].expr) ?? return None
        return Val(sema_derive_marker_value(owner, written))
    }
    argument: sema_derive_static_value(expansion, args[0].expr) ?? return None
    wanted := ""
    if argument == .Str(text) -> wanted = text
    if wanted == "" -> return None
    if method == "has_marker" -> return Val(CtValue.Bool{value: sema_derive_named_row(owner, "markers", wanted) != None})
    if method == "has_method" -> return Val(CtValue.Bool{value: sema_derive_named_row(owner, "methods", wanted) != None})
    None
}

sema_derive_named_type: fn(value: CtValue) -> String Never! {
    if value == .Struct(owner, _) -> return owner
    ""
}

// The marker struct a template's `marker(T)` names: `T` or a dotted path.
sema_derive_marker_name: fn(expression: Expr) -> String? Never! {
    if expression == .Ident(name, _, _) -> return Val(name.copy())
    if expression == .Field(base, member, _, _) {
        owner: sema_derive_marker_name(base) ?? return None
        return Val("{owner}.{member}")
    }
    None
}

// The last segment of a marker name (`Web.Route` is `Route`).
sema_derive_marker_leaf: fn(name: String) -> String Never! {
    parts: name.split(".").to_list()
    if parts.len() == 0 -> return name.copy()
    parts[parts.len() - 1].copy()
}

// `target.marker(T)` over a reflected handle: the first marker `T` in its
// `markers` rows as a `T` whose fields are its written arguments, or the
// absent `T?` when the handle does not carry it. The same read outside a
// template is sema_call_reflection_marker_lookup.
sema_derive_marker_value: fn(owner: CtValue, written: String) -> CtValue Never! {
    wanted: sema_derive_marker_leaf(written)
    absent: CtValue.Failed{report: CtReport.Clean{ty: Type.Named{name: written}}}
    rows: if sema_derive_struct_field(owner, "markers") == .Val(.List(values)) -> values else -> { return absent }
    loop row in rows {
        name: if sema_derive_struct_field(row, "name") == .Val(.Str(text)) -> text else -> { next }
        if sema_derive_marker_leaf(name) != wanted -> next
        fields := [NamedCtValue]{}
        if sema_derive_struct_field(row, "args") == .Val(.List(arguments)) {
            loop argument in arguments {
                label: if sema_derive_struct_field(argument, "name") == .Val(.Str(text)) -> text else -> { next }
                value: sema_derive_struct_field(argument, "value") ?? next
                fields.push(NamedCtValue{name: label, value: value})
            }
        }
        return CtValue.Present{value: CtValue.Struct{type_name: wanted, fields: fields}}
    }
    absent
}

// A string literal whose interpolations are known-time scalars.
sema_derive_static_str: fn(expansion: SemaDeriveExpansion, parts: [StrPart]) -> CtValue? Never! {
    text := ""
    loop part in parts {
        if part == .Lit(value) {
            text = "{text}{value}"
            next
        }
        if part == .Interp(inner, format) {
            if format != StrFormat.Display -> return None
            value: sema_derive_static_value(expansion, inner) ?? return None
            rendered: sema_derive_static_text(value) ?? return None
            text = "{text}{rendered}"
            next
        }
        return None
    }
    Val(CtValue.Str{value: text})
}

sema_derive_static_typed: fn(expansion: SemaDeriveExpansion, head: Type?, body: TypedLitBody) -> CtValue? Never! {
    if body == .Elements(elements) {
        values := [CtValue]{}
        loop element in elements {
            value: sema_derive_static_value(expansion, element) ?? return None
            values.push(value)
        }
        return Val(CtValue.List{values: values})
    }
    if body == .Fields(fields) {
        if head == .Val(.Named(owner)) -> return sema_derive_static_struct(expansion, owner, fields)
    }
    if body == .Empty {
        if head == .Val(.Named(owner)) -> return sema_derive_static_struct(expansion, owner, [ExprField]{})
    }
    None
}

sema_derive_static_text: fn(value: CtValue) -> String? Never! {
    if value == {
        .Str(text) -> Val(text)
        .Int(number) -> Val("{number}")
        .Bool(flag) -> Val("{flag}")
        .Float(_) | .Char(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> None
    }
}

sema_derive_static_struct: fn(expansion: SemaDeriveExpansion, type_name: String, fields: [ExprField]) -> CtValue? Never! {
    values := [NamedCtValue]{}
    loop field in fields {
        value: sema_derive_static_value(expansion, field.value) ?? return None
        values.push(NamedCtValue{name: field.name, value: value})
    }
    Val(CtValue.Struct{type_name: type_name, fields: values})
}

// The reflected row named `name` in the handle's `rows` list (`fields`,
// `markers`, `methods`).
sema_derive_named_row: fn(owner: CtValue, rows: String, name: String) -> CtValue? Never! {
    if sema_derive_struct_field(owner, rows) == .Val(.List(values)) {
        key: sema_derive_bare(name)
        loop value in values {
            if sema_derive_struct_field(value, "name") == .Val(.Str(text)) {
                if text == key -> return Val(value)
            }
        }
    }
    None
}

// `handle.reflect().read` over a reflected handle without a direct
// field reads the handle's homed fact row of that name; the fact value keeps
// its detail under the same name.
sema_derive_fact_read: fn(owner: CtValue, read: String) -> CtValue? Never! {
    fact: sema_derive_named_row(owner, "facts", read) ?? return None
    value: sema_derive_struct_field(fact, "value") ?? return None
    if sema_derive_struct_field(value, read) == .Val(.Present(detail)) -> return Val(detail)
    None
}

sema_derive_ct_bool: fn(value: CtValue) -> Bool? Never! {
    if value == {
        .Bool(flag) -> Val(flag)
        .Int(_) | .Float(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> None
    }
}

sema_derive_ct_int: fn(value: CtValue) -> Int? Never! {
    if value == {
        .Int(number) -> Val(number)
        .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> None
    }
}

// Equality over one scalar kind; mixed or non-scalar kinds are not static.
sema_derive_ct_scalar_equal: fn(lhs: CtValue, rhs: CtValue) -> Bool? Never! {
    if lhs == {
        .Int(a) -> {
            if rhs == .Int(b) -> return Val(a == b)
        }
        .Bool(a) -> {
            if rhs == .Bool(b) -> return Val(a == b)
        }
        .Char(a) -> {
            if rhs == .Char(b) -> return Val(a == b)
        }
        .Str(a) -> {
            if rhs == .Str(b) -> return Val(a == b)
        }
        // A unit variant compares by variant; a leading-dot literal carries no
        // owner name, so only two named owners must also agree.
        .Enum(left_type, left_variant, left_args) -> {
            if rhs == .Enum(right_type, right_variant, right_args) {
                if left_args.len() != 0 || right_args.len() != 0 -> return None
                if left_type != "" && right_type != "" && left_type != right_type -> return Val(false)
                return Val(left_variant == right_variant)
            }
        }
        .Float(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> {}
    }
    None
}

sema_derive_static_binary: fn(op: BinOp, lhs: CtValue, rhs: CtValue) -> CtValue? Never! {
    result := false
    if op == {
        .And | .Or -> {
            left: sema_derive_ct_bool(lhs) ?? return None
            right: sema_derive_ct_bool(rhs) ?? return None
            result = if op == BinOp.And -> left && right else -> left || right
        }
        .Eq | .Ne -> {
            equal: sema_derive_ct_scalar_equal(lhs, rhs) ?? return None
            result = if op == BinOp.Ne -> !equal else -> equal
        }
        .Lt | .Gt | .Le | .Ge -> {
            a: sema_derive_ct_int(lhs) ?? return None
            b: sema_derive_ct_int(rhs) ?? return None
            result = if op == {
                .Lt -> a < b
                .Gt -> a > b
                .Le -> a <= b
                .Add | .Sub | .Mul | .Div | .FloorDiv | .Mod | .Rem | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Ge | .Compare | .And | .Or -> a >= b
            }
        }
        .Add | .Sub | .Mul | .Div | .FloorDiv | .Mod | .Rem | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Compare -> return None
    }
    Val(CtValue.Bool{value: result})
}

// Rust `comptime_literal_expr` / `build_fact_expr`: a template value becomes
// the literal the parser would have produced for it; a unit enum stays a
// value-carrying name so the typed boundary can fold it.
sema_derive_literal_expr: fn(value: CtValue, span: Span) -> Expr? Never! {
    if value == {
        .Int(number) -> Val(Expr.Int{value: number, span: span, width: None, raw: None, id: AST_NODE_GENERATED})
        .Bool(flag) -> Val(Expr.Bool{value: flag, span: span, id: AST_NODE_GENERATED})
        .Str(text) -> Val(Expr.Str{parts: [StrPart.Lit{text: text}], span: span, id: AST_NODE_GENERATED})
        .Char(character) -> Val(Expr.Char{value: "{character}", span: span, id: AST_NODE_GENERATED})
        .Unit -> Val(Expr.Unit{span: span, id: AST_NODE_GENERATED})
        // An absent reflected member (`?T` None) is a typed clean failure,
        // which sema checks from the embedded value.
        .Failed(_) -> Val(Expr.ComptimeName{name: "", span: span, value: Val(value), id: AST_NODE_GENERATED})
        .Enum(_, _, args) -> {
            if args.len() != 0 -> return None
            Val(Expr.ComptimeName{name: "", span: span, value: Val(value), id: AST_NODE_GENERATED})
        }
        .List(values) -> {
            elements := [Expr]{}
            loop item in values {
                element: sema_derive_literal_expr(item, span) ?? return None
                elements.push(element)
            }
            Val(Expr.ListLit{elements: elements, span: span, id: AST_NODE_GENERATED})
        }
        .Present(inner) -> {
            element: sema_derive_literal_expr(inner, span) ?? return None
            Val(Expr.Present{value: element, span: span, id: AST_NODE_GENERATED})
        }
        .Struct(type_name, fields) -> {
            expanded := [ExprField]{}
            loop field in fields {
                element: sema_derive_literal_expr(field.value, span) ?? return None
                expanded.push(ExprField{name: field.name, name_span: span, value: element})
            }
            Val(Expr.StructLit{type_name: type_name, type_args: [Type]{}, import_ns: None, as_trait: None, fields: expanded, inferred: false, span: span, id: AST_NODE_GENERATED})
        }
        .Float(_) | .BigInt(_) | .Bytes(_) | .Map(_) | .Closure(_) -> None
    }
}

// ---------------------------------------------------------------------------
// A paste `#{name}` splices the template binding `name`.

sema_derive_expand_name: fn(expansion: &SemaDeriveExpansion, name: String, span: Span) -> String Never! {
    explicit: sema_derive_splice(name)
    binding: sema_derive_bare(name)
    value: sema_derive_scope_value(expansion, binding) ?? return name
    if value == {
        .Str(text) -> {
            if expansion.definition_module != "" -> expansion.pasted.push(text.copy())
            return text
        }
        .Struct(_, _) -> {
            if !explicit -> return name.copy()
            if sema_derive_struct_field(value, "name") == .Val(.Str(text)) {
                if expansion.definition_module != "" -> expansion.pasted.push(text.copy())
                return text
            }
            sema_derive_fail(expansion, sema_error("E0956", span, "compile-time name `${binding}` has no text name", "a generated item name needs the reflected value's `name` field", "bind the name to a String value"))
        }
        .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> {
            if explicit -> sema_derive_fail(expansion, sema_error("E0956", span, "compile-time name `{name}` is not text", "a generated item name needs text, but this value is {sema_derive_value_type_name(value)}", "bind the name to a String value"))
        }
    }
    name.copy()
}

sema_derive_expand_type: fn(expansion: &SemaDeriveExpansion, ty: Type) -> Type Never! {
    zero: Span{start: 0, end: 0}
    if ty == {
        .Named(name) -> Type.Named{name: sema_derive_expand_name(expansion, name, zero)}
        .List(inner) -> Type.List{element: sema_derive_expand_type(expansion, inner)}
        .Shared(inner) -> Type.Shared{inner: sema_derive_expand_type(expansion, inner)}
        .Option(inner) -> Type.Option{inner: sema_derive_expand_type(expansion, inner)}
        // copy: `len` is a payload of read parameter `ty`, which keeps the original; field `len` of the new Type.FixedList owns this one
        .FixedList(inner, len) -> Type.FixedList{elem: sema_derive_expand_type(expansion, inner), len: len.copy()}
        // copy: `marker` is a payload of read parameter `ty`, which keeps the original; field `marker` of the new Type.Tagged owns this one
        .Tagged(marker, inner) -> Type.Tagged{marker: marker.copy(), inner: sema_derive_expand_type(expansion, inner)}
        // copy: `key_span` is a payload of read parameter `ty`, which keeps the original; field `key_span` of the new Type.Map owns this one
        .Map(key, key_span, value) -> Type.Map{key: sema_derive_expand_type(expansion, key), key_span: key_span.copy(), value: sema_derive_expand_type(expansion, value)}
        .Result(ok, err) -> Type.Result{ok: sema_derive_expand_type(expansion, ok), err: sema_derive_expand_type(expansion, err)}
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            expanded := [Type]{}
            loop param in params -> expanded.push(sema_derive_expand_type(expansion, param))
            Type.Fn{params: expanded, ret: ret.map((value) -> sema_derive_expand_type(expansion, value)), effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
        }
        .Apply(name, args) -> {
            expanded := [Type]{}
            loop arg in args -> expanded.push(sema_derive_expand_type(expansion, arg))
            Type.Apply{name: sema_derive_expand_name(expansion, name, zero), args: expanded}
        }
        .Tuple(fields) -> {
            expanded := [TypeTupleField]{}
            loop field in fields -> expanded.push(TypeTupleField{name: field.name, ty: sema_derive_expand_type(expansion, field.ty)})
            Type.Tuple{fields: expanded}
        }
        .Union(members) -> {
            expanded := [Type]{}
            loop member in members -> expanded.push(sema_derive_expand_type(expansion, member))
            Type.Union{members: expanded}
        }
        // copy: `dimension` is a payload of read parameter `ty`, which keeps the original; field `dimension` of the new Type.Quantity owns this one
        .Quantity(base, dimension) -> Type.Quantity{base: sema_derive_expand_type(expansion, base), dimension: dimension.copy()}
        .InlineRange(base, lo, hi) -> Type.InlineRange{base: sema_derive_expand_type(expansion, base), lo: lo, hi: hi}
        // copy: the derive template type is expanded once per deriving declaration, so the template
        // keeps its node and an unexpanded node is copied into this expansion.
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> ty.copy()
    }
}

sema_derive_expand_types: fn(expansion: &SemaDeriveExpansion, types: [Type]) -> [Type] Never! {
    expanded := [Type]{}
    loop ty in types -> expanded.push(sema_derive_expand_type(expansion, ty))
    expanded
}

// ---------------------------------------------------------------------------
// Reflected enum payload bindings. A `.#{left}` arm binds every payload field of
// the reflected variant under a side-qualified local (`left_Circle_radius`),
// and `self.#{field}` / `rhs.#{field}` inside that arm read the same locals.

sema_derive_reflected_name: fn(value: CtValue) -> String? Never! {
    if sema_derive_struct_field(value, "name") == .Val(.Str(text)) -> return Val(text)
    None
}

sema_derive_is_variant: fn(value: CtValue) -> Bool Never! {
    sema_derive_struct_field(value, "index") != None
}

sema_derive_reflected_variant_name: fn(value: CtValue) -> String? Never! {
    if !sema_derive_is_variant(value) -> return None
    sema_derive_reflected_name(value)
}

sema_derive_field_info_payload: fn(value: CtValue) -> [CtValue]? Never! {
    if !sema_derive_is_variant(value) -> return None
    if sema_derive_struct_field(value, "fields") == .Val(.List(payload)) {
        if payload.len() == 0 -> return None
        return Val(payload)
    }
    None
}

// The `fields` list of a `TypeInfo` value is searched in place: copying it
// out would copy the whole reflected type once per variant arm.
sema_derive_type_info_variant_payload: fn(value: CtValue, variant: String) -> [CtValue]? Never! {
    if value == .Struct(type_name, fields) {
        if type_name != "TypeInfo" -> return None
        loop field in fields {
            if field.name != "fields" -> next
            if field.value == .List(variants) {
                loop info in variants {
                    if (sema_derive_reflected_name(info) ?? "") == variant -> return sema_derive_field_info_payload(info)
                }
            }
            return None
        }
    }
    None
}

sema_derive_variant_payload_fields: fn(expansion: SemaDeriveExpansion, variant: String) -> [CtValue]? Never! {
    key: sema_derive_bare(variant)
    if sema_derive_scope_index(expansion, key) == .Val(index) {
        payload := sema_derive_field_info_payload(expansion.scope[index].value)
        if payload != None -> return payload
        payload = sema_derive_type_info_variant_payload(expansion.scope[index].value, key)
        if payload != None -> return payload
    }
    loop entry in expansion.scope {
        payload := sema_derive_type_info_variant_payload(entry.value, key)
        if payload != None -> return payload
        if (sema_derive_reflected_name(entry.value) ?? "") == key {
            payload = sema_derive_field_info_payload(entry.value)
            if payload != None -> return payload
        }
    }
    None
}

sema_derive_payload_binding_owner: fn(expansion: SemaDeriveExpansion, variant: String) -> String Never! {
    key: sema_derive_bare(variant)
    loop entry in expansion.scope {
        reflected: sema_derive_reflected_name(entry.value) ?? next
        if (reflected == key || entry.name == key) && sema_derive_is_variant(entry.value) {
            if sema_derive_reflected_variant_name(entry.value) == .Val(name) -> return "{entry.name}_{name}"
            return entry.name
        }
    }
    key
}

sema_derive_loop_side: fn(subject: Expr?) -> String? Never! {
    value: subject ?? return None
    name := ""
    if value == {
        .Ident(text, _, _) -> name = text
        .ComptimeName(text, _, _, _) -> name = text
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
    if name == "self" -> return Val("left")
    if name == "rhs" -> return Val("right")
    Val(sema_derive_bare(name))
}

sema_derive_side_payload_owner: fn(expansion: SemaDeriveExpansion, side: String, variant: String) -> String Never! {
    key: sema_derive_bare(variant)
    left := String?{None}
    right := String?{None}
    if sema_derive_scope_value(expansion, "left") == .Val(value) -> left = sema_derive_reflected_variant_name(value)
    if sema_derive_scope_value(expansion, "right") == .Val(value) -> right = sema_derive_reflected_variant_name(value)
    if side == "left" {
        if left == .Val(name) -> return "left_{name}"
        return "left_{key}"
    }
    if side == "right" {
        if left == .Val(left_name) {
            if right == .Val(right_name) -> return "right_{left_name}_{right_name}"
        }
        if right == .Val(right_name) -> return "right_{right_name}"
        // `if rhs == { .#{left} -> … }` matches `rhs` against the arm's own
        // variant; the field reads below name the same locals.
        if left == .Val(left_name) {
            if key == "left" -> return "right_{left_name}"
        }
        return "right_{key}"
    }
    sema_derive_payload_binding_owner(expansion, variant)
}

sema_derive_payload_owner_for_subject: fn(expansion: SemaDeriveExpansion, subject: Expr?, variant: String) -> String Never! {
    side: sema_derive_loop_side(subject) ?? return sema_derive_payload_binding_owner(expansion, variant)
    sema_derive_side_payload_owner(expansion, side, variant)
}

// Only a spliced variant (`.#{left}`) binds the reflected variant's payload: a
// literal variant in the template (`.Equal` of `Ordering`) names its own enum,
// even when the deriving type has a variant of the same name.
sema_derive_fill_variant_bindings: fn(expansion: SemaDeriveExpansion, variant: String, bindings: [PatSlot], span: Span, subject: Expr?, spliced: Bool) -> [PatSlot] Never! {
    if bindings.len() != 0 || !spliced -> return bindings.copy()
    payload: sema_derive_variant_payload_fields(expansion, variant) ?? return bindings.copy()
    owner: sema_derive_payload_owner_for_subject(expansion, subject, variant)
    filled := [PatSlot]{}
    loop field in payload {
        field_name: sema_derive_reflected_name(field) ?? "value"
        filled.push(PatSlot.Bind{name: "{owner}_{field_name}", span: span})
    }
    filled
}

// Rust `derive_payload_owner`: `self.#{field}` / `rhs.#{field}` inside a reflected
// variant arm read the arm's payload locals.
sema_derive_field_payload_owner: fn(expansion: SemaDeriveExpansion, binding: String?) -> String? Never! {
    name: binding ?? return None
    left_value: sema_derive_scope_value(expansion, "left") ?? return None
    left: sema_derive_reflected_variant_name(left_value) ?? return None
    if name == "self" -> return Val("left_{left}")
    if name != "rhs" -> return None
    if sema_derive_scope_value(expansion, "right") == .Val(right_value) {
        if sema_derive_reflected_variant_name(right_value) == .Val(right) -> return Val("right_{left}_{right}")
    }
    Val("right_{left}")
}

// ---------------------------------------------------------------------------
// Patterns.

sema_derive_expand_pattern: fn(expansion: &SemaDeriveExpansion, pattern: Pattern, subject: Expr?) -> Pattern Never! {
    if pattern == {
        .Or(alternatives, span) -> {
            expanded := [Pattern]{}
            loop alternative in alternatives -> expanded.push(sema_derive_expand_pattern(expansion, alternative, None))
            Pattern.Or{alternatives: expanded, span: span}
        }
        .StrMatch(parts, span) -> Pattern.StrMatch{parts: sema_derive_expand_str_match_parts(expansion, parts), span: span}
        .Variant(variant, bindings, leading_dot, span) -> {
            expanded_variant: sema_derive_expand_name(expansion, variant, span)
            Pattern.Variant{variant: expanded_variant, bindings: sema_derive_fill_variant_bindings(expansion, expanded_variant, bindings, span, subject, sema_derive_splice(variant)), leading_dot: leading_dot, span: span}
        }
        // copy: the derive template pattern is expanded once per deriving declaration, so the
        // template keeps its node and an unexpanded node is copied into this expansion.
        .Present(_, _, _, _) | .Absent(_) | .Ok(_, _, _, _) | .Err(_, _, _, _) | .Range(_, _, _) | .Struct(_, _, _, _) | .List(_, _, _) | .Map(_, _, _) | .BinMatch(_, _) -> pattern.copy()
    }
}

sema_derive_expand_str_match_parts: fn(expansion: &SemaDeriveExpansion, parts: [StrMatchPart]) -> [StrMatchPart] Never! {
    expanded := [StrMatchPart]{}
    loop part in parts {
        if part == {
            .Hole(name, ty, span) -> expanded.push(StrMatchPart.Hole{name: name, ty: ty.map((value) -> sema_derive_expand_type(expansion, value)), span: span})
            .Lit(_) -> expanded.push(part.copy())
        }
    }
    expanded
}

sema_derive_pattern_test_from_enum_lit: fn(expansion: SemaDeriveExpansion, subject: Expr, variant: String, args: [EnumLitArg], span: Span, spliced: Bool) -> Expr Never! {
    bindings := sema_derive_fill_variant_bindings(expansion, variant, [PatSlot]{}, span, Val(subject), spliced)
    if bindings.len() == 0 {
        loop arg in args {
            value: if arg == {
                .Positional(expression) -> expression
                .Named(_, expression) -> expression
            }
            if value == .Ident(name, bind_span, _) -> bindings.push(PatSlot.Bind{name: name, span: bind_span})
        }
    }
    Expr.PatternTest{subject: subject, pattern: Pattern.Variant{variant: variant, bindings: bindings, leading_dot: true, span: span}, span: span, id: AST_NODE_GENERATED}
}

// Rust `coerce_derive_enum_arm`: an enum-literal arm of a reflected switch is a
// variant pattern over the switch subject. `spliced` says the template arm
// named a reflected variant (`.#{left}`), not a literal one.
sema_derive_coerce_enum_arm: fn(expansion: SemaDeriveExpansion, cond: Expr, subject: Expr, spliced: Bool) -> Expr Never! {
    if cond == {
        .EnumLit(_, variant, _, args, _, span, _) -> sema_derive_pattern_test_from_enum_lit(expansion, subject, variant, args, span, spliced)
        .Binary(op, _, right, _, _) -> {
            // copy: the derive template condition is expanded once per deriving declaration, so the
            // template keeps `cond` and a non-equality condition is copied into this expansion.
            if op != BinOp.Eq -> return cond.copy()
            if right == .EnumLit(_, variant, _, args, _, span, _) -> return sema_derive_pattern_test_from_enum_lit(expansion, subject, variant, args, span, spliced)
            // copy: the derive template condition is expanded once per deriving declaration, so the
            // template keeps `cond` and an uncoerced condition is copied into this expansion.
            cond.copy()
        }
        // copy: the derive template condition is expanded once per deriving declaration, so the
        // template keeps `cond` and a non-binary condition is copied into this expansion.
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> cond.copy()
    }
}

// The template arm condition names a spliced variant: `.#{left}` or `== .#{left}`.
sema_derive_cond_splices_variant: fn(cond: Expr) -> Bool Never! {
    if cond == .EnumLit(_, variant, _, _, _, _, _) -> return sema_derive_splice(variant)
    if cond == .Binary(op, _, right, _, _) {
        if op == BinOp.Eq && right == .EnumLit(_, variant, _, _, _, _, _) -> return sema_derive_splice(variant)
    }
    false
}

// ---------------------------------------------------------------------------
// Expressions (Rust `expand_template_expr` / `expand_template_expr_node`).

sema_derive_expand_exprs: fn(expansion: &SemaDeriveExpansion, expressions: [Expr]) -> [Expr] Never! {
    expanded := [Expr]{}
    loop expression in expressions -> expanded.push(sema_derive_expand_expr(expansion, expression))
    expanded
}

sema_derive_expand_optional_expr: fn(expansion: &SemaDeriveExpansion, expression: Expr?) -> Expr? Never! {
    if expression == {
        .Val(value) -> Val(sema_derive_expand_expr(expansion, value))
        .None -> None
    }
}

sema_derive_expand_call_args: fn(expansion: &SemaDeriveExpansion, args: [CallArg]) -> [CallArg] Never! {
    expanded := [CallArg]{}
    loop arg in args {
        updated := arg
        updated.expr = sema_derive_expand_expr(expansion, arg.expr)
        expanded.push(updated)
    }
    expanded
}

sema_derive_expand_fields: fn(expansion: &SemaDeriveExpansion, fields: [ExprField]) -> [ExprField] Never! {
    expanded := [ExprField]{}
    loop field in fields -> expanded.push(ExprField{name: field.name, name_span: field.name_span, value: sema_derive_expand_expr(expansion, field.value)})
    expanded
}

sema_derive_expand_pairs: fn(expansion: &SemaDeriveExpansion, entries: [ExprPair]) -> [ExprPair] Never! {
    expanded := [ExprPair]{}
    loop entry in entries -> expanded.push(ExprPair{key: sema_derive_expand_expr(expansion, entry.key), value: sema_derive_expand_expr(expansion, entry.value)})
    expanded
}

sema_derive_expand_str_parts: fn(expansion: &SemaDeriveExpansion, parts: [StrPart]) -> [StrPart] Never! {
    expanded := [StrPart]{}
    loop part in parts {
        if part == {
            .Interp(expression, format) -> expanded.push(StrPart.Interp{expr: sema_derive_expand_hole(expansion, expression), format: format})
            .Lit(_) | .Byte(_) -> expanded.push(part.copy())
        }
    }
    expanded
}

// A hole `{name}` over a template binding reads the binding's value; any
// other hole expands as an expression.
sema_derive_expand_hole: fn(expansion: &SemaDeriveExpansion, expression: Expr) -> Expr Never! {
    if expression == .Ident(name, span, _) {
        if sema_derive_scope_value(expansion, name) == .Val(value) {
            if sema_derive_literal_expr(value, span) == .Val(literal) -> return literal
        }
    }
    sema_derive_expand_expr(expansion, expression)
}

sema_derive_expand_or_fallback: fn(expansion: &SemaDeriveExpansion, fallback: OrFallback) -> OrFallback Never! {
    if fallback == {
        .Value(value) -> OrFallback.Value{value: sema_derive_expand_expr(expansion, value)}
        .Block(body, value, span) -> OrFallback.Block{body: sema_derive_expand_stmts(expansion, body), value: sema_derive_expand_optional_expr(expansion, value), span: span}
        .Return(value, span) -> OrFallback.Return{value: sema_derive_expand_optional_expr(expansion, value), span: span}
        .Panic(name_span, args) -> OrFallback.Panic{name_span: name_span, args: sema_derive_expand_call_args(expansion, args)}
        // copy: the derive template fallback is expanded once per deriving declaration, so the
        // template keeps its node and an unexpanded fallback is copied into this expansion.
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> fallback.copy()
    }
}

sema_derive_expand_lambda: fn(expansion: &SemaDeriveExpansion, lambda: Lambda) -> Lambda Never! {
    updated := lambda
    params := [LambdaParam]{}
    loop param in lambda.params {
        expanded := param
        expanded.ty = param.ty.map((value) -> sema_derive_expand_type(expansion, value))
        params.push(expanded)
    }
    updated.params = params
    updated.result = lambda.result.map((value) -> sema_derive_expand_type(expansion, value))
    updated.body = if lambda.body == {
        .Expr(value) -> LambdaBody.Expr{value: sema_derive_expand_expr(expansion, value)}
        .Block(body) -> LambdaBody.Block{body: sema_derive_expand_stmts(expansion, body)}
    }
    updated
}

// Children first, then the node itself.
sema_derive_expand_expr: fn(expansion: &SemaDeriveExpansion, expression: Expr) -> Expr Never! {
    // copy: after a failed expansion the template expression is returned unchanged, but the
    // template keeps it for the next deriving declaration, so this expansion gets its own copy.
    if expansion.failure != None -> return expression.copy()
    sema_derive_expand_expr_node(expansion, expression)
}

sema_derive_expand_expr_node: fn(expansion: &SemaDeriveExpansion, expression: Expr) -> Expr Never! {
    if expression == {
        .Str(parts, span, node) -> return Expr.Str{parts: sema_derive_expand_str_parts(expansion, parts), span: span, id: node}
        .StrMatchLit(parts, span, node) -> return Expr.StrMatchLit{parts: sema_derive_expand_str_match_parts(expansion, parts), span: span, id: node}
        .ListLit(elements, span, node) -> return Expr.ListLit{elements: sema_derive_expand_exprs(expansion, elements), span: span, id: node}
        .MemberSpread(base, members, span, node) -> return Expr.MemberSpread{base: sema_derive_expand_expr(expansion, base), members: members, span: span, id: node}
        .Spread(value, span, node) -> return Expr.Spread{value: sema_derive_expand_expr(expansion, value), span: span, id: node}
        .MapLit(entries, span, node) -> return Expr.MapLit{entries: sema_derive_expand_pairs(expansion, entries), span: span, id: node}
        // copy: `kind` is a payload of read parameter `expression`, which keeps the original; field `kind` of the new Expr.Index owns this one
        .Index(base, index, span, kind, node) -> return Expr.Index{base: sema_derive_expand_expr(expansion, base), index: sema_derive_expand_expr(expansion, index), span: span, kind: kind.copy(), id: node}
        .Slice(base, start, end, range, span, node) -> return Expr.Slice{base: sema_derive_expand_expr(expansion, base), start: sema_derive_expand_expr(expansion, start), end: sema_derive_expand_expr(expansion, end), range: sema_derive_expand_optional_expr(expansion, range), span: span, id: node}
        .Range(start, end, exclusive, span, node) -> return Expr.Range{start: sema_derive_expand_expr(expansion, start), end: sema_derive_expand_expr(expansion, end), exclusive: exclusive, span: span, id: node}
        .Ident(name, span, _) -> {
            // copy: a name that is no paste is unchanged, but the derive template keeps it for the
            // next deriving declaration, so this expansion gets its own copy.
            if !sema_derive_splice(name) -> return expression.copy()
            // copy: an unbound paste stays as written, but the derive template keeps it for the
            // next deriving declaration, so this expansion gets its own copy.
            value: sema_derive_scope_value(expansion, name) ?? return expression.copy()
            // copy: a value with no literal form stays as written, but the derive template keeps it
            // for the next deriving declaration, so this expansion gets its own copy.
            return sema_derive_literal_expr(value, span) ?? expression.copy()
        }
        .Call(call, node) -> {
            updated := call
            updated.name = sema_derive_expand_name(expansion, call.name, call.name_span)
            updated.type_args = sema_derive_expand_types(expansion, call.type_args)
            updated.args = sema_derive_expand_call_args(expansion, call.args)
            return Expr.Call{call: updated, id: node}
        }
        .Unary(op, operand, span, node) -> return Expr.Unary{op: op, operand: sema_derive_expand_expr(expansion, operand), span: span, id: node}
        .Binary(op, left, right, span, node) -> return Expr.Binary{op: op, left: sema_derive_expand_expr(expansion, left), right: sema_derive_expand_expr(expansion, right), span: span, id: node}
        .CompareChain(operands, ops, hooks, span, node) -> return Expr.CompareChain{operands: sema_derive_expand_exprs(expansion, operands), ops: ops, hooks: hooks, span: span, id: node}
        .Deref(value, span, node) -> return Expr.Deref{value: sema_derive_expand_expr(expansion, value), span: span, id: node}
        .RawOf(value, span, node) -> return Expr.RawOf{value: sema_derive_expand_expr(expansion, value), span: span, id: node}
        .Copy(value, span, node) -> return Expr.Copy{value: sema_derive_expand_expr(expansion, value), span: span, id: node}
        .Place(value, access, span, node) -> return Expr.Place{value: sema_derive_expand_expr(expansion, value), access: access, span: span, id: node}
        .Field(base, member, span, _) -> return sema_derive_expand_field(expansion, base, member, span)
        .OptField(base, member, member_span, flatten, span, node) -> return Expr.OptField{base: sema_derive_expand_expr(expansion, base), member: member, member_span: member_span, flatten: flatten, span: span, id: node}
        .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, node) -> {
            // `T.reflect()` over the template's own reflected handle is the handle.
            if method == "reflect" && args.len() == 0 && owner_type_args.len() == 0 && type_args.len() == 0 {
                folded: sema_derive_reflect_literal(expansion, receiver, method_span)
                if folded == .Val(literal) -> return literal
            }
            return Expr.MethodCall{receiver: sema_derive_expand_expr(expansion, receiver), method: sema_derive_expand_name(expansion, method, method_span), method_span: method_span, owner_type_args: sema_derive_expand_types(expansion, owner_type_args), type_args: sema_derive_expand_types(expansion, type_args), args: sema_derive_expand_call_args(expansion, args), id: node}
        }
        .OptMethodCall(receiver, method, method_span, type_args, args, span, node) -> return Expr.OptMethodCall{receiver: sema_derive_expand_expr(expansion, receiver), method: sema_derive_expand_name(expansion, method, method_span), method_span: method_span, type_args: sema_derive_expand_types(expansion, type_args), args: sema_derive_expand_call_args(expansion, args), span: span, id: node}
        // copy: `import_ns` and `as_trait` are payloads of read parameter `expression`, which keeps the originals; the new Expr.StructLit's fields own `import_ns` and `as_trait`
        .StructLit(type_name, type_args, import_ns, as_trait, fields, inferred, span, node) -> return Expr.StructLit{type_name: sema_derive_expand_name(expansion, type_name, span), type_args: sema_derive_expand_types(expansion, type_args), import_ns: import_ns.copy(), as_trait: as_trait.copy(), fields: sema_derive_expand_fields(expansion, fields), inferred: inferred, span: span, id: node}
        .TypedLit(head, body, span, node) -> return Expr.TypedLit{head: head.map((value) -> sema_derive_expand_type(expansion, value)), body: sema_derive_expand_typed_body(expansion, body), span: span, id: node}
        .EnumLit(type_name, variant, variant_span, args, leading_dot, span, _) -> return sema_derive_expand_enum_lit(expansion, type_name, variant, variant_span, args, leading_dot, span)
        // copy: `tainted_tag` is a payload of read parameter `expression`, which keeps the original; field `tag` of the new Expr.Tainted owns this one
        .Tainted(value, tainted_tag, span, node) -> return Expr.Tainted{value: sema_derive_expand_expr(expansion, value), tag: tainted_tag.copy(), span: span, id: node}
        .Present(value, span, node) -> return Expr.Present{value: sema_derive_expand_expr(expansion, value), span: span, id: node}
        .PatternTest(subject, pattern, span, node) -> {
            expanded_subject: sema_derive_expand_expr(expansion, subject)
            return Expr.PatternTest{subject: expanded_subject, pattern: sema_derive_expand_pattern(expansion, pattern, Val(expanded_subject)), span: span, id: node}
        }
        .Ok(value, span, node) -> return Expr.Ok{value: sema_derive_expand_expr(expansion, value), span: span, id: node}
        .Err(value, span, node) -> return Expr.Err{value: sema_derive_expand_expr(expansion, value), span: span, id: node}
        // copy: `conversion` is a payload of read parameter `expression`, which keeps the original; field `conversion` of the new Expr.Try owns this one
        .Try(value, span, conversion, context, node) -> return Expr.Try{value: sema_derive_expand_expr(expansion, value), span: span, conversion: conversion.copy(), context: sema_derive_expand_optional_expr(expansion, context), id: node}
        .OrFallback(value, fallback, is_option, span, node) -> return Expr.OrFallback{value: sema_derive_expand_expr(expansion, value), fallback: sema_derive_expand_or_fallback(expansion, fallback), is_option: is_option, span: span, id: node}
        .If(cond, then_body, then_value, else_body, else_value, span, node) -> return Expr.If{cond: sema_derive_expand_expr(expansion, cond), then_body: sema_derive_expand_stmts(expansion, then_body), then_value: sema_derive_expand_expr(expansion, then_value), else_body: sema_derive_expand_stmts(expansion, else_body), else_value: sema_derive_expand_expr(expansion, else_value), span: span, id: node}
        .TupleLit(fields, span, ty, node) -> {
            expanded := [TupleField]{}
            loop field in fields -> expanded.push(TupleField{name: field.name, value: sema_derive_expand_expr(expansion, field.value)})
            return Expr.TupleLit{fields: expanded, span: span, ty: ty, id: node}
        }
        .Lambda(lambda, node) -> return Expr.Lambda{lambda: sema_derive_expand_lambda(expansion, lambda), id: node}
        .CallValue(callee, args, span, node) -> return Expr.CallValue{callee: sema_derive_expand_expr(expansion, callee), args: sema_derive_expand_call_args(expansion, args), span: span, id: node}
        .PtrFromAddr(alias, alias_span, elem, addr, span, node) -> return Expr.PtrFromAddr{alias: alias, alias_span: alias_span, elem: sema_derive_expand_type(expansion, elem), addr: sema_derive_expand_expr(expansion, addr), span: span, id: node}
        .ComptimeName(name, span, value, _) -> {
            // copy: a bound name stays as written, but the derive template keeps it for the next
            // deriving declaration, so this expansion gets its own copy.
            if value != None -> return expression.copy()
            // copy: an unbound name stays as written, but the derive template keeps it for the next
            // deriving declaration, so this expansion gets its own copy.
            bound: sema_derive_scope_value(expansion, name) ?? return expression.copy()
            // copy: a value with no literal form stays as written, but the derive template keeps it
            // for the next deriving declaration, so this expansion gets its own copy.
            return sema_derive_literal_expr(bound, span) ?? expression.copy()
        }
        .Paren(value, span, node) -> return Expr.Paren{value: sema_derive_expand_expr(expansion, value), span: span, id: node}
        .Pipe(head, steps, span, node) -> {
            expanded_head: sema_derive_expand_expr(expansion, head)
            expanded := [PipeStep]{}
            loop step in steps -> expanded.push(PipeStep{name: step.name, value: sema_derive_expand_expr(expansion, step.value), reads: step.reads, span: step.span})
            return Expr.Pipe{head: expanded_head, steps: expanded, span: span, id: node}
        }
        .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .TypeValue(_, _, _) -> {}
    }
    // copy: every other expression kind is unchanged by expansion, but the derive template keeps it
    // for the next deriving declaration, so this expansion gets its own copy.
    expression.copy()
}

sema_derive_reflect_literal: fn(expansion: SemaDeriveExpansion, receiver: Expr, span: Span) -> Expr? Never! {
    name := ""
    if receiver == {
        .Ident(text, _, _) -> name = text
        .ComptimeName(text, _, _, _) -> name = text
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
    value: sema_derive_scope_value(expansion, name) ?? return None
    if value == .Struct(type_name, _) {
        if type_name == "TypeInfo" -> return sema_derive_literal_expr(value, span)
    }
    None
}

sema_derive_expand_typed_body: fn(expansion: &SemaDeriveExpansion, body: TypedLitBody) -> TypedLitBody Never! {
    if body == {
        .Fields(fields) -> return TypedLitBody.Fields{fields: sema_derive_expand_fields(expansion, fields)}
        .Elements(elements) -> return TypedLitBody.Elements{elements: sema_derive_expand_exprs(expansion, elements)}
        .Entries(entries) -> return TypedLitBody.Entries{entries: sema_derive_expand_pairs(expansion, entries)}
        .Value(value) -> return TypedLitBody.Value{value: sema_derive_expand_expr(expansion, value)}
        .ByteText(_) | .Empty -> {}
    }
    // copy: a typed literal body without template splices is unchanged, but the derive template
    // keeps it for the next deriving declaration, so this expansion gets its own copy.
    body.copy()
}

sema_derive_expand_enum_lit: fn(expansion: &SemaDeriveExpansion, type_name: String, variant: String, variant_span: Span?, args: [EnumLitArg], leading_dot: Bool, span: Span) -> Expr Never! {
    expanded_args := [EnumLitArg]{}
    loop arg in args {
        if arg == {
            .Positional(value) -> expanded_args.push(EnumLitArg.Positional{value: sema_derive_expand_expr(expansion, value)})
            .Named(label, value) -> expanded_args.push(EnumLitArg.Named{label: label, expr: sema_derive_expand_expr(expansion, value)})
        }
    }
    if expanded_args.len() == 0 && sema_derive_splice(variant) {
        if sema_derive_variant_payload_fields(expansion, variant) == .Val(payload) {
            owner: sema_derive_payload_binding_owner(expansion, variant)
            loop field in payload {
                field_name: sema_derive_reflected_name(field) ?? "value"
                expanded_args.push(EnumLitArg.Positional{value: Expr.Ident{name: "{owner}_{field_name}", span: span, id: AST_NODE_GENERATED}})
            }
        }
    }
    Expr.EnumLit{type_name: sema_derive_expand_name(expansion, type_name, span), variant: sema_derive_expand_name(expansion, variant, span), variant_span: variant_span, args: expanded_args, leading_dot: leading_dot, span: span, id: AST_NODE_GENERATED}
}

sema_derive_expand_field: fn(expansion: &SemaDeriveExpansion, base: Expr, member: String, span: Span) -> Expr Never! {
    binding := String?{None}
    if base == {
        .Ident(name, _, _) -> binding = Val(name)
        .ComptimeName(name, _, value, _) -> {
            if value == None -> binding = Val(name)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    // `left.index` over a reflected template value is that value's literal.
    if binding == .Val(name) {
        if sema_derive_scope_index(expansion, name) == .Val(owner_index) {
            if sema_derive_struct_field(expansion.scope[owner_index].value, member) == .Val(value) {
                if sema_derive_literal_expr(value, span) == .Val(literal) -> return literal
            }
        }
    }
    // A pasted member `x.#{name}` splices its binding; any other member stays
    // for sema.
    if sema_derive_splice(member) && sema_derive_scope_index(expansion, member) != None {
        if sema_derive_field_payload_owner(expansion, binding) == .Val(payload_owner) {
            field_name: sema_derive_expand_name(expansion, member, span)
            return Expr.Ident{name: "{payload_owner}_{field_name}", span: span, id: AST_NODE_GENERATED}
        }
        return Expr.Field{base: sema_derive_expand_expr(expansion, base), member: sema_derive_expand_name(expansion, member, span), span: span, id: AST_NODE_GENERATED}
    }
    Expr.Field{base: sema_derive_expand_expr(expansion, base), member: member, span: span, id: AST_NODE_GENERATED}
}

// ---------------------------------------------------------------------------
// Statements (Rust `expand_template_stmts` and friends).

sema_derive_expand_stmts: fn(expansion: &SemaDeriveExpansion, stmts: [Stmt]) -> [Stmt] Never! {
    out := [Stmt]{}
    loop stmt in stmts {
        if expansion.failure != None -> return out
        sema_derive_expand_stmt_into(expansion, stmt, out)
    }
    out
}

sema_derive_prep_if_selected: fn(expansion: &SemaDeriveExpansion, cond: Expr, cond_span: Span) -> Bool Never! {
    expanded: sema_derive_expand_expr(expansion, cond)
    if expansion.failure != None -> return false
    value: sema_derive_static_value(expansion, expanded) ?? {
        sema_derive_fail(expansion, sema_error("E0956", cond_span, "a `comptime if` condition in a derive template is not a known-time value", "derive template conditions compare reflected facts and literals already in the template scope", "compare reflected facts such as `T.$kind == \"enum\"` or `field.$type == T.reflect().name`"))
        return false
    }
    if value == .Bool(selected) -> return selected
    sema_derive_fail(expansion, sema_error("E0989", cond_span, "a `comptime if` condition must be Bool, not another type", "the condition selects a branch at compile time — it must be true or false", "write a Bool known-time expression, like `comptime if flag {{ … }}`"))
    false
}

sema_derive_expand_stmt_into: fn(expansion: &SemaDeriveExpansion, stmt: Stmt, out: &[Stmt]) Never! {
    if stmt == {
        .ComptimeIf(cond, cond_span, then_body, else_body, _, _) -> {
            // Select first; only the chosen branch is ever expanded.
            chosen: if sema_derive_prep_if_selected(expansion, cond, cond_span) -> then_body else -> else_body ?? [Stmt]{}
            loop inner in chosen {
                if expansion.failure != None -> return
                sema_derive_expand_stmt_into(expansion, inner, out)
            }
        }
        .ComptimeBlock(body, is_template_loop, span) -> {
            if !is_template_loop {
                out.push(Stmt.ComptimeBlock{body: sema_derive_expand_stmts(expansion, body), is_template_loop: false, span: span})
                return
            }
            sema_derive_expand_loop_block(expansion, body, span, out)
        }
        .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> out.push(sema_derive_expand_stmt(expansion, stmt))
    }
}

sema_derive_expand_loop_block: fn(expansion: &SemaDeriveExpansion, body: [Stmt], span: Span, out: &[Stmt]) Never! {
    if body.len() == 0 -> return
    if body[0] == .For(var, _, _, kind, loop_body, _, _, _, _) {
        if kind == .In(collection, _) {
            values: sema_derive_loop_values(expansion, collection) ?? {
                sema_derive_fail(expansion, sema_error("E0956", span, "a `comptime loop` source is not a compile-time list", "`comptime loop` expands one statement template for each value in its source list", "use a reflected/comptime list such as `T.reflect().fields`"))
                return
            }
            // Each iteration's bindings (the loop variable and the bindings
            // its body declares) end with the iteration. A body that declares
            // a local unrolls each iteration into its own block (a selected
            // `comptime if true`), so every iteration's locals stay private.
            depth: expansion.scope.len()
            declares_local := false
            loop inner in loop_body {
                if inner == .Val(_) {
                    declares_local = true
                    break
                }
            }
            loop value in values {
                expansion.scope.push(NamedCtValue{name: var, value: value})
                iteration := [Stmt]{}
                loop inner in loop_body {
                    if expansion.failure != None -> break
                    sema_derive_expand_stmt_into(expansion, inner, iteration)
                }
                loop expansion.scope.len() > depth -> _ := expansion.scope.pop()
                if expansion.failure != None -> return
                if declares_local {
                    out.push(Stmt.ComptimeIf{cond: Expr.Bool{value: true, span: span, id: AST_NODE_GENERATED}, cond_span: span, then_body: iteration, else_body: None, span: span, selected_then: Val(true)})
                } else {
                    loop inner in iteration -> out.push(inner)
                }
            }
            return
        }
    }
    loop inner in sema_derive_expand_stmts(expansion, body) -> out.push(inner)
}

// Rust `eval_template_loop_source`: a reflected list, or a closed list of
// written type names as text bindings.
sema_derive_loop_values: fn(expansion: SemaDeriveExpansion, source: Expr) -> [CtValue]? Never! {
    value := sema_derive_static_value(expansion, source)
    if value == None {
        if source == .ListLit(elements, _, _) {
            if elements.len() > 0 {
                names := [CtValue]{}
                loop element in elements {
                    if element == {
                        .Ident(name, _, _) -> names.push(CtValue.Str{value: name})
                        .ComptimeName(name, _, _, _) -> names.push(CtValue.Str{value: sema_derive_bare(name)})
                        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
                            names = [CtValue]{}
                            break
                        }
                    }
                }
                if names.len() == elements.len() -> value = Val(CtValue.List{values: names})
            }
        }
    }
    if value == .Val(.List(values)) -> return Val(values)
    None
}

sema_derive_expand_binding: fn(expansion: &SemaDeriveExpansion, binding: Binding) -> Binding Never! {
    updated := binding
    updated.ty = binding.ty.map((value) -> sema_derive_expand_type(expansion, value))
    if binding.pattern == .Val(pattern) {
        updated.pattern = Val(if pattern == {
            .Struct(type_name, type_span, fields, rest, span) -> BindPattern.Struct{type_name: sema_derive_expand_name(expansion, type_name, type_span), type_span: type_span, fields: fields, rest: rest, span: span}
            .Refutable(inner, fallback, names, span) -> BindPattern.Refutable{pattern: sema_derive_expand_pattern(expansion, inner, None), fallback: sema_derive_expand_or_fallback(expansion, fallback), names: names, span: span}
            // copy: the binding pattern is unchanged by expansion, but it is a payload view in the
            // derive template, which keeps it for the next deriving declaration.
            .List(_, _) | .Tuple(_, _) -> pattern.copy()
        })
    }
    updated.init = sema_derive_expand_expr(expansion, binding.init)
    updated
}

sema_derive_expand_arms: fn(expansion: &SemaDeriveExpansion, subject: Expr, arms: [SwitchArm]) -> [SwitchArm] Never! {
    expanded := [SwitchArm]{}
    loop arm in arms {
        cond := sema_derive_expand_expr(expansion, arm.cond)
        cond = sema_derive_coerce_enum_arm(expansion, cond, subject, sema_derive_cond_splices_variant(arm.cond))
        if cond == .PatternTest(test_subject, pattern, test_span, _) {
            cond = Expr.PatternTest{subject: test_subject, pattern: sema_derive_expand_pattern(expansion, pattern, Val(test_subject)), span: test_span, id: AST_NODE_GENERATED}
        }
        expanded.push(SwitchArm{cond: cond, body: sema_derive_expand_stmts(expansion, arm.body), span: arm.span, through: arm.through})
    }
    expanded
}

sema_derive_expand_optional_body: fn(expansion: &SemaDeriveExpansion, body: [Stmt]?) -> [Stmt]? Never! {
    if body == {
        .Val(value) -> Val(sema_derive_expand_stmts(expansion, value))
        .None -> None
    }
}

sema_derive_expand_lvalue: fn(expansion: &SemaDeriveExpansion, target: LValue) -> LValue Never! {
    if target == {
        // copy: `kind` is a payload of read parameter `target`, which keeps the original; field `kind` of the new LValue.Index owns this one
        .Index(base, index, span, kind) -> LValue.Index{base: sema_derive_expand_expr(expansion, base), index: sema_derive_expand_expr(expansion, index), span: span, kind: kind.copy()}
        // A pasted target member `out.#{name} = …` splices its binding like a read does.
        .Field(base, field, span) -> LValue.Field{base: sema_derive_expand_expr(expansion, base), field: if sema_derive_splice(field) && sema_derive_scope_index(expansion, field) != None -> sema_derive_expand_name(expansion, field, span) else -> field, span: span}
        // copy: the assignment target is unchanged by expansion, but the derive template keeps it
        // for the next deriving declaration, so this expansion gets its own copy.
        .Local(_, _) -> target.copy()
    }
}

sema_derive_expand_stmt: fn(expansion: &SemaDeriveExpansion, stmt: Stmt) -> Stmt Never! {
    if stmt == {
        .Expr(value) -> Stmt.Expr{expr: sema_derive_expand_expr(expansion, value)}
        .Val(binding) -> Stmt.Val{binding: sema_derive_expand_binding(expansion, binding)}
        // copy: `op` is a payload of read parameter `stmt`, which keeps the original; field `op` of the new Stmt.Assign owns this one
        .Assign(target, op, op_span, value) -> Stmt.Assign{target: sema_derive_expand_lvalue(expansion, target), op: op.copy(), op_span: op_span, value: sema_derive_expand_expr(expansion, value)}
        .Return(value, span) -> Stmt.Return{value: sema_derive_expand_optional_expr(expansion, value), span: span}
        // copy: `label` is a payload of read parameter `stmt`, which keeps the original; field `label` of the new Stmt.While owns this one
        .While(cond, body, span, arrow_body, label) -> Stmt.While{cond: sema_derive_expand_expr(expansion, cond), body: sema_derive_expand_stmts(expansion, body), span: span, arrow_body: arrow_body, label: label.copy()}
        .For(var, var_span, var2, kind, body, span, arrow_body, label, auto_vectorization) -> {
            expanded_kind: if kind == {
                .Range(start, end, step, exclusive) -> ForKind.Range{start: sema_derive_expand_expr(expansion, start), end: sema_derive_expand_expr(expansion, end), step: sema_derive_expand_optional_expr(expansion, step), exclusive: exclusive}
                .In(collection, step) -> ForKind.In{collection: sema_derive_expand_expr(expansion, collection), step: sema_derive_expand_optional_expr(expansion, step)}
            }
            Stmt.For{var: var, var_span: var_span, var2: var2, kind: expanded_kind, body: sema_derive_expand_stmts(expansion, body), span: span, arrow_body: arrow_body, label: label, auto_vectorization: auto_vectorization}
        }
        .Switch(subject, arms, else_body, span) -> {
            expanded_subject: sema_derive_expand_expr(expansion, subject)
            Stmt.Switch{subject: expanded_subject, arms: sema_derive_expand_arms(expansion, expanded_subject, arms), else_body: sema_derive_expand_optional_body(expansion, else_body), span: span}
        }
        .ComptimeSwitch(subject, arms, else_body, span) -> {
            expanded_subject: sema_derive_expand_expr(expansion, subject)
            Stmt.ComptimeSwitch{subject: expanded_subject, arms: sema_derive_expand_arms(expansion, expanded_subject, arms), else_body: sema_derive_expand_optional_body(expansion, else_body), span: span}
        }
        .BreakValue(value, span) -> Stmt.BreakValue{value: sema_derive_expand_expr(expansion, value), span: span}
        .BreakLabelValue(name, name_span, value, span) -> Stmt.BreakLabelValue{name: name, name_span: name_span, value: sema_derive_expand_expr(expansion, value), span: span}
        // copy: `label` is a payload of read parameter `stmt`, which keeps the original; field `label` of the new Stmt.Loop owns this one
        .Loop(body, span, arrow_body, label) -> Stmt.Loop{body: sema_derive_expand_stmts(expansion, body), span: span, arrow_body: arrow_body, label: label.copy()}
        .CountedLoop(init, cond, step, body, span, arrow_body, label) -> {
            expanded_step := Stmt?{None}
            if step == .Val(value) -> expanded_step = Val(sema_derive_expand_stmt(expansion, value))
            Stmt.CountedLoop{init: sema_derive_expand_binding(expansion, init), cond: sema_derive_expand_expr(expansion, cond), step: expanded_step, body: sema_derive_expand_stmts(expansion, body), span: span, arrow_body: arrow_body, label: label}
        }
        // copy: `audit` is a payload of read parameter `stmt`, which keeps the original; field `audit` of the new Stmt.Unsafe owns this one
        .Unsafe(audit, audit_expr, body, span) -> Stmt.Unsafe{audit: audit.copy(), audit_expr: sema_derive_expand_optional_expr(expansion, audit_expr), body: sema_derive_expand_stmts(expansion, body), span: span}
        // copy: `reason` is a payload of read parameter `stmt`, which keeps the original; field `reason` of the new Stmt.Impure owns this one
        .Impure(reason, reason_expr, body, span) -> Stmt.Impure{reason: reason.copy(), reason_expr: sema_derive_expand_optional_expr(expansion, reason_expr), body: sema_derive_expand_stmts(expansion, body), span: span}
        .Reactive(body, span) -> Stmt.Reactive{body: sema_derive_expand_stmts(expansion, body), span: span}
        .Shield(body, span) -> Stmt.Shield{body: sema_derive_expand_stmts(expansion, body), span: span}
        // copy: `marker` is a payload of read parameter `stmt`, which keeps the original; field `marker` of the new Stmt.Switched owns this one
        .Switched(marker, body, span) -> Stmt.Switched{marker: marker.copy(), body: sema_derive_expand_stmts(expansion, body), span: span}
        .Region(name, name_span, body, span) -> Stmt.Region{name: name, name_span: name_span, body: sema_derive_expand_stmts(expansion, body), span: span}
        .Policy(declarations, body, span) -> Stmt.Policy{declarations: declarations, body: sema_derive_expand_stmts(expansion, body), span: span}
        .TaskGroup(name, name_span, args, body, span) -> Stmt.TaskGroup{name: name, name_span: name_span, args: TaskGroupArgs{limit: sema_derive_expand_optional_expr(expansion, args.limit), stack: sema_derive_expand_optional_expr(expansion, args.stack)}, body: sema_derive_expand_stmts(expansion, body), span: span}
        .Layout(name, name_span, body, span) -> Stmt.Layout{name: name, name_span: name_span, body: sema_derive_expand_stmts(expansion, body), span: span}
        // copy: `binding` is a payload of read parameter `stmt`, which keeps the original; field `binding` of the new Stmt.AuthorityScope owns this one
        .AuthorityScope(caps, caps_span, binding, body, span) -> Stmt.AuthorityScope{caps: caps, caps_span: caps_span, binding: binding.copy(), body: sema_derive_expand_stmts(expansion, body), span: span}
        // copy: `cond` and `selected_then` are payloads of read parameter `stmt`, which keeps the originals; the new Stmt.ComptimeIf's fields own `cond` and `selected_then`
        .ComptimeIf(cond, cond_span, then_body, else_body, span, selected_then) -> Stmt.ComptimeIf{cond: cond.copy(), cond_span: cond_span, then_body: sema_derive_expand_stmts(expansion, then_body), else_body: sema_derive_expand_optional_body(expansion, else_body), span: span, selected_then: selected_then.copy()}
        .ComptimeBlock(body, is_template_loop, span) -> Stmt.ComptimeBlock{body: sema_derive_expand_stmts(expansion, body), is_template_loop: is_template_loop, span: span}
        .ContextBlock(fields, body, span) -> {
            expanded := [ContextField]{}
            loop field in fields -> expanded.push(ContextField{name: field.name, value: sema_derive_expand_expr(expansion, field.value), span: field.span})
            Stmt.ContextBlock{fields: expanded, body: sema_derive_expand_stmts(expansion, body), span: span}
        }
        .Live(body, span) -> Stmt.Live{body: sema_derive_expand_stmts(expansion, body), span: span}
        .AssumeDet(reason, reason_expr, body, span) -> Stmt.AssumeDet{reason: reason, reason_expr: sema_derive_expand_expr(expansion, reason_expr), body: sema_derive_expand_stmts(expansion, body), span: span}
        // copy: `name` and `name_span` are payloads of read parameter `stmt`, which keeps the originals; the new Stmt.Transact's fields own `name` and `name_span`
        .Transact(name, name_span, body, implicit, span) -> Stmt.Transact{name: name.copy(), name_span: name_span.copy(), body: sema_derive_expand_stmts(expansion, body), implicit: implicit, span: span}
        .Yield(value, span) -> Stmt.Yield{value: sema_derive_expand_expr(expansion, value), span: span}
        // copy: `args_span` is a payload of read parameter `stmt`, which keeps the original; field `args_span` of the new Stmt.ScopeMember owns this one
        .ScopeMember(name, name_span, args, args_span, body, dsl, dot_span, span) -> Stmt.ScopeMember{name: name, name_span: name_span, args: sema_derive_expand_exprs(expansion, args), args_span: args_span.copy(), body: sema_derive_expand_stmts(expansion, body), dsl: dsl, dot_span: dot_span, span: span}
        .DeferClose(close, span) -> Stmt.DeferClose{close: sema_derive_expand_expr(expansion, close), span: span}
        // copy: the statement kind is unchanged by expansion, but the derive template keeps it for
        // the next deriving declaration, so this expansion gets its own copy.
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> stmt.copy()
    }
}

// ---------------------------------------------------------------------------
// Items (Rust `expand_template_item`).

sema_derive_expand_markers: fn(expansion: &SemaDeriveExpansion, markers: [Marker]) -> [Marker] Never! {
    expanded := [Marker]{}
    loop marker in markers {
        updated := marker
        args := [MarkerCallArg]{}
        loop arg in marker.args {
            if arg == {
                .Expr(value) -> args.push(MarkerCallArg.Expr{value: sema_derive_expand_expr(expansion, value)})
                .EffectRow(_, _) -> args.push(arg.copy())
            }
        }
        updated.args = args
        expanded.push(updated)
    }
    expanded
}

sema_derive_expand_clauses: fn(expansion: &SemaDeriveExpansion, clauses: [ContractClause]) -> [ContractClause] Never! {
    expanded := [ContractClause]{}
    loop clause in clauses {
        updated := clause
        updated.cond = sema_derive_expand_expr(expansion, clause.cond)
        updated.message_expr = sema_derive_expand_expr(expansion, clause.message_expr)
        expanded.push(updated)
    }
    expanded
}

sema_derive_expand_params: fn(expansion: &SemaDeriveExpansion, params: [Param]) -> [Param] Never! {
    expanded := [Param]{}
    loop param in params {
        updated := param
        updated.ty = sema_derive_expand_type(expansion, param.ty)
        updated.default = sema_derive_expand_optional_expr(expansion, param.default)
        expanded.push(updated)
    }
    expanded
}

sema_derive_expand_func: fn(expansion: &SemaDeriveExpansion, function: Func) -> Func Never! {
    first_paste: expansion.pasted.len()
    updated := function
    updated.name = sema_derive_expand_name(expansion, function.name, function.name_span)
    updated.params = sema_derive_expand_params(expansion, function.params)
    updated.return_type = function.return_type.map((value) -> sema_derive_expand_type(expansion, value))
    updated.head_pattern = function.head_pattern.map((value) -> sema_derive_expand_pattern(expansion, value, None))
    updated.markers = sema_derive_expand_markers(expansion, function.markers)
    updated.pre = sema_derive_expand_clauses(expansion, function.pre)
    updated.post = sema_derive_expand_clauses(expansion, function.post)
    updated.body = sema_derive_expand_stmts(expansion, function.body)
    if expansion.definition_module != "" {
        updated.definition_module = expansion.definition_module.copy()
        loop at in first_paste..<expansion.pasted.len() -> updated.site_names.push(expansion.pasted[at].copy())
    }
    updated
}

sema_derive_expand_funcs: fn(expansion: &SemaDeriveExpansion, functions: [Func]) -> [Func] Never! {
    expanded := [Func]{}
    loop function in functions -> expanded.push(sema_derive_expand_func(expansion, function))
    expanded
}

sema_derive_expand_named_types: fn(expansion: &SemaDeriveExpansion, types: [NamedType]) -> [NamedType] Never! {
    expanded := [NamedType]{}
    loop entry in types {
        updated := entry
        updated.ty = sema_derive_expand_type(expansion, entry.ty)
        expanded.push(updated)
    }
    expanded
}

sema_derive_expand_impl_constants: fn(expansion: &SemaDeriveExpansion, constants: [ImplConstValue]) -> [ImplConstValue] Never! {
    loop constant in constants -> ImplConstValue{name: constant.name, name_span: constant.name_span, value: sema_derive_expand_expr(expansion, constant.value), span: constant.span}
}

sema_derive_expand_trait_blocks: fn(expansion: &SemaDeriveExpansion, blocks: [TraitImplBlock]) -> [TraitImplBlock] Never! {
    expanded := [TraitImplBlock]{}
    loop block in blocks {
        updated := block
        updated.trait_name = sema_derive_expand_name(expansion, block.trait_name, block.trait_span)
        updated.methods = sema_derive_expand_funcs(expansion, block.methods)
        updated.assoc_type_impls = sema_derive_expand_named_types(expansion, block.assoc_type_impls)
        updated.constants = sema_derive_expand_impl_constants(expansion, block.constants)
        expanded.push(updated)
    }
    expanded
}

// A generated #Test's name as fixed text: a `comptime loop` template's
// interpolated label (`#Test("case {case.n}")`) once expansion made each
// interpolated part a literal. Every later pass reads the resolved `name`:
// the duplicate-name check, the runnable-test gate and the test plan.
sema_derive_test_static_name: fn(name_expr: Expr?) -> String? Never! {
    expression: name_expr ?? return None
    if expression == .Str(parts, _, _) {
        text := ""
        loop part in parts {
            if part == {
                .Lit(piece) -> text = "{text}{piece}"
                .Interp(value, format) -> {
                    if format == {
                        .Display -> {}
                        .Debug | .Pretty | .Fixed(_) | .Grouped(_) | .Hex(_) | .Pad(_, _) | .PadLeft(_, _) | .Sci(_) | .Percent(_) | .Bin | .Oct | .Unit(_) | .Count -> return None
                    }
                    if value == {
                        .Int(number, _, _, _, _) -> text = "{text}{number}"
                        .Bool(flag, _, _) -> text = "{text}{flag}"
                        .Char(character, _, _) -> text = "{text}{character}"
                        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
                    }
                }
                .Byte(_) -> return None
            }
        }
        return Val(text)
    }
    None
}

sema_derive_expand_item: fn(expansion: &SemaDeriveExpansion, item: Item) -> Item Never! {
    if item == {
        .Func(function) -> Item.Func{value: sema_derive_expand_func(expansion, function)}
        .Impl(definition) -> {
            updated := definition
            updated.type_name = sema_derive_expand_name(expansion, definition.type_name, definition.type_span)
            if definition.trait_name == .Val(trait_name) -> updated.trait_name = Val(sema_derive_expand_name(expansion, trait_name, definition.trait_span ?? definition.type_span))
            updated.methods = sema_derive_expand_funcs(expansion, definition.methods)
            updated.assoc_type_impls = sema_derive_expand_named_types(expansion, definition.assoc_type_impls)
            updated.constants = sema_derive_expand_impl_constants(expansion, definition.constants)
            Item.Impl{value: updated}
        }
        .ErrorConv(definition) -> {
            updated := definition
            updated.from_ty = sema_derive_expand_name(expansion, definition.from_ty, definition.from_span)
            updated.to_ty = sema_derive_expand_name(expansion, definition.to_ty, definition.to_span)
            updated.body = sema_derive_expand_stmts(expansion, definition.body)
            Item.ErrorConv{value: updated}
        }
        .Test(definition) -> {
            updated := definition
            updated.name_expr = sema_derive_expand_optional_expr(expansion, definition.name_expr)
            updated.faults_expr = sema_derive_expand_optional_expr(expansion, definition.faults_expr)
            updated.expected_fail_expr = sema_derive_expand_optional_expr(expansion, definition.expected_fail_expr)
            updated.params = sema_derive_expand_params(expansion, definition.params)
            updated.pre = sema_derive_expand_clauses(expansion, definition.pre)
            updated.body = sema_derive_expand_stmts(expansion, definition.body)
            if updated.name == None -> updated.name = sema_derive_test_static_name(updated.name_expr)
            Item.Test{value: updated}
        }
        .Struct(definition) -> {
            updated := definition
            updated.name = sema_derive_expand_name(expansion, definition.name, definition.name_span)
            fields := [Field]{}
            loop field in definition.fields {
                expanded_field := field
                expanded_field.name = sema_derive_expand_name(expansion, field.name, field.name_span)
                expanded_field.ty = sema_derive_expand_type(expansion, field.ty)
                expanded_field.computed = sema_derive_expand_optional_expr(expansion, field.computed)
                expanded_field.default = sema_derive_expand_optional_expr(expansion, field.default)
                fields.push(expanded_field)
            }
            updated.fields = fields
            updated.serde_markers = sema_derive_expand_markers(expansion, definition.serde_markers)
            updated.type_markers = sema_derive_expand_markers(expansion, definition.type_markers)
            updated.methods = sema_derive_expand_funcs(expansion, definition.methods)
            updated.trait_impls = sema_derive_expand_trait_blocks(expansion, definition.trait_impls)
            updated.validate_block = sema_derive_expand_stmts(expansion, definition.validate_block)
            Item.Struct{value: updated}
        }
        .Enum(definition) -> {
            updated := definition
            updated.name = sema_derive_expand_name(expansion, definition.name, definition.name_span)
            variants := [Variant]{}
            loop variant in definition.variants {
                expanded_variant := variant
                expanded_variant.payload = if variant.payload == {
                    .Unit -> VariantPayload.Unit
                    .Single(ty, span) -> VariantPayload.Single{ty: sema_derive_expand_type(expansion, ty), span: span}
                    .Named(fields) -> {
                        expanded_fields := [VariantField]{}
                        loop field in fields -> expanded_fields.push(VariantField{name: sema_derive_expand_name(expansion, field.name, field.name_span), name_span: field.name_span, ty: sema_derive_expand_type(expansion, field.ty), ty_span: field.ty_span})
                        VariantPayload.Named{fields: expanded_fields}
                    }
                }
                expanded_variant.discriminant_expr = sema_derive_expand_optional_expr(expansion, variant.discriminant_expr)
                expanded_variant.serde_markers = sema_derive_expand_markers(expansion, variant.serde_markers)
                variants.push(expanded_variant)
            }
            updated.variants = variants
            updated.serde_markers = sema_derive_expand_markers(expansion, definition.serde_markers)
            updated.type_markers = sema_derive_expand_markers(expansion, definition.type_markers)
            updated.methods = sema_derive_expand_funcs(expansion, definition.methods)
            updated.trait_impls = sema_derive_expand_trait_blocks(expansion, definition.trait_impls)
            Item.Enum{value: updated}
        }
        // copy: the item kind is unchanged by expansion, but the derive template keeps it for the
        // next deriving declaration, so this expansion gets its own copy.
        .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> item.copy()
    }
}

// Rust `expand_derive_items`: a body-level `name: value` binds a template
// value; items expand against the current scope; a template loop expands its
// items once per source value; a template `if` expands only the chosen
// branch, whose bindings end with it.
sema_derive_expand_body: fn(expansion: &SemaDeriveExpansion, body: [DeriveBodyItem], out: &[Item]) Never! {
    loop body_item in body {
        if expansion.failure != None -> return
        if body_item == {
            .Stmt(stmt) -> {
                if stmt == .Val(binding) {
                    // The binding reads the template scope's values directly;
                    // the expanded form re-reads them from literals, which a
                    // reflected handle (`T.reflect()`, absent members) has none of.
                    value := sema_derive_static_value(expansion, binding.init)
                    if value == None {
                        expanded: sema_derive_expand_expr(expansion, binding.init)
                        value = sema_derive_static_value(expansion, expanded)
                    }
                    known: value ?? {
                        failure: sema_derive_binding_failure(expansion, binding.name_span, binding.init)
                        sema_derive_fail(expansion, failure)
                        return
                    }
                    expansion.scope.push(NamedCtValue{name: binding.name, value: known})
                } else {
                    // Rust `exec_block`: a statement between template items
                    // runs against the template scope; it generates nothing.
                    expanded: sema_derive_expand_stmt(expansion, stmt)
                    sema_derive_exec_stmt(expansion, expanded)
                    if expansion.failure != None -> return
                }
            }
            .Item(item) -> out.push(sema_derive_expand_item(expansion, item))
            .Loop(var, _, source, loop_body, _) -> {
                values: sema_derive_loop_values(expansion, source) ?? {
                    sema_derive_fail(expansion, sema_error("E0956", expr_span(source), "a `comptime loop` source is not a compile-time list", "`comptime loop` expands one item template for each value in its source list", "use a reflected/comptime list such as `T.reflect().fields`, or a closed type list like `[TypeA, TypeB]`"))
                    return
                }
                // Each iteration's bindings (the loop variable and the
                // bindings its body declares) end with the iteration.
                depth: expansion.scope.len()
                loop value in values {
                    expansion.scope.push(NamedCtValue{name: var, value: value})
                    sema_derive_expand_body(expansion, loop_body, out)
                    loop expansion.scope.len() > depth -> _ := expansion.scope.pop()
                    if expansion.failure != None -> return
                }
            }
            .If(cond, cond_span, then_body, else_body, _) -> {
                chosen: if sema_derive_prep_if_selected(expansion, cond, cond_span) -> then_body else -> else_body ?? [DeriveBodyItem]{}
                if expansion.failure != None -> return
                depth: expansion.scope.len()
                sema_derive_expand_body(expansion, chosen, out)
                loop expansion.scope.len() > depth -> _ := expansion.scope.pop()
            }
        }
    }
}

// Rust's typed selector reports an unknown field as E0302; any other binding
// the expansion cannot read is E0956.
sema_derive_binding_failure: fn(expansion: SemaDeriveExpansion, span: Span, init: Expr) -> Diagnostic Never! {
    if init == .Index(base, index, _, _, _) {
        field := sema_derive_layout_selector(index)
        if index == .EnumLit(_, variant, _, args, _, _, _) {
            if args.len() == 0 -> field = Val(sema_derive_bare(variant))
        }
        if field == .Val(name) {
            if sema_derive_static_value(expansion, base) == .Val(owner) {
                if sema_derive_struct_field(owner, "fields") != None && sema_derive_named_row(owner, "fields", name) == None {
                    return sema_error("E0302", span, "the reflected layout has no field `{name}`", "typed selectors must name a field declared by the reflected type", "use one of the names in `T.reflect().fields`")
                }
            }
        }
    }
    sema_error("E0956", span, "a derive template binding is not a known-time value", "a template binding names a reflected fact or literal the expansion reads directly", "bind a reflected fact such as `T.reflect().fields` or a literal")
}

sema_derive_stmt_span: fn(stmt: Stmt) -> Span Never! {
    if stmt == {
        .Expr(value) -> expr_span(value)
        .Val(binding) -> binding.name_span
        .Return(_, span) | .Switch(_, _, _, span) -> span
        .Assign(_, _, _, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> Span{start: 0, end: 0}
    }
}

// Rust `jet_e0956_unsupported`: the registered E0956 row with its `what` hole.
sema_derive_unsupported: fn(span: Span, what: String) -> Diagnostic Never! {
    sema_error("E0956", span, "`{what}` isn't supported by the current evaluator yet", "the canonical evaluator doesn't cover this construct yet", "report this unsupported construct as a compiler bug")
}

// Rust `Interp::exec_block` over a template statement: the statement runs
// against the template scope for its checks (`if`, `reject`) and generates
// nothing. A binding inside a nested block lives until the block ends.
sema_derive_exec_stmts: fn(expansion: &SemaDeriveExpansion, stmts: [Stmt]) Never! {
    depth: expansion.scope.len()
    loop stmt in stmts {
        if expansion.failure != None -> break
        sema_derive_exec_stmt(expansion, stmt)
    }
    loop expansion.scope.len() > depth -> _ := expansion.scope.pop()
}

sema_derive_exec_stmt: fn(expansion: &SemaDeriveExpansion, stmt: Stmt) Never! {
    if stmt == {
        .Expr(value) -> sema_derive_exec_expr(expansion, value)
        // A statement `if` parses as a subjectless arm table (`true`
        // subject): the first arm whose known-time condition holds runs.
        .Switch(subject, arms, else_body, span) -> {
            subjectless := false
            if subject == .Bool(value, _, _) -> subjectless = value
            if !subjectless {
                sema_derive_fail(expansion, sema_derive_unsupported(span, "a template arm table with a subject"))
                return
            }
            loop arm in arms {
                selected: sema_derive_static_value(expansion, arm.cond) ?? {
                    sema_derive_fail(expansion, sema_derive_unsupported(expr_span(arm.cond), "a template `if` condition that is not a known-time value"))
                    return
                }
                taken := false
                if selected == .Bool(flag) {
                    taken = flag
                } else {
                    sema_derive_fail(expansion, sema_derive_unsupported(expr_span(arm.cond), "a template `if` condition that is not a Bool"))
                    return
                }
                if taken {
                    sema_derive_exec_stmts(expansion, arm.body)
                    return
                }
            }
            if else_body == .Val(body) -> sema_derive_exec_stmts(expansion, body)
        }
        .Val(binding) -> {
            value: sema_derive_static_value(expansion, binding.init) ?? {
                failure: sema_derive_binding_failure(expansion, binding.name_span, binding.init)
                sema_derive_fail(expansion, failure)
                return
            }
            expansion.scope.push(NamedCtValue{name: binding.name, value: value})
        }
        .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> sema_derive_fail(expansion, sema_error("E0956", sema_derive_stmt_span(stmt), "a derive template statement is not a binding", "between template items, a derive body only binds known-time values", "move the statement into a generated function body"))
    }
}

sema_derive_exec_expr: fn(expansion: &SemaDeriveExpansion, expression: Expr) Never! {
    if expression == {
        .If(cond, then_body, then_value, else_body, else_value, _, _) -> {
            selected: sema_derive_static_value(expansion, cond) ?? {
                sema_derive_fail(expansion, sema_derive_unsupported(expr_span(cond), "a template `if` condition that is not a known-time value"))
                return
            }
            if selected == .Bool(taken) {
                depth: expansion.scope.len()
                if taken {
                    sema_derive_exec_stmts(expansion, then_body)
                    if expansion.failure == None -> sema_derive_exec_expr(expansion, then_value)
                } else {
                    sema_derive_exec_stmts(expansion, else_body)
                    if expansion.failure == None -> sema_derive_exec_expr(expansion, else_value)
                }
                loop expansion.scope.len() > depth -> _ := expansion.scope.pop()
                return
            }
            sema_derive_fail(expansion, sema_derive_unsupported(expr_span(cond), "a template `if` condition that is not a Bool"))
        }
        .Call(call, _) -> {
            if call.name == "reject" {
                sema_derive_reject(expansion, call.args, call.name_span)
            } else {
                sema_derive_exec_value(expansion, expression)
            }
        }
        .Paren(value, _, _) -> sema_derive_exec_expr(expansion, value)
        .Unit(_, _) | .NoElse(_, _) -> {}
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> sema_derive_exec_value(expansion, expression)
    }
}

// An expression statement whose value is discarded still has to be known.
sema_derive_exec_value: fn(expansion: &SemaDeriveExpansion, expression: Expr) Never! {
    if sema_derive_static_value(expansion, expression) == None {
        sema_derive_fail(expansion, sema_error("E0956", expr_span(expression), "a derive template statement is not a binding", "between template items, a derive body only binds known-time values", "move the statement into a generated function body"))
    }
}

// `reject(value)`: a checked rule raises the diagnostic value at the rule's use
// site. The value's `Diagnostic` impl gives each text as one literal over `self`
// fields and the `code` and `severity` constants; the code defaults to the type
// path (`web.BadPath`). A code with a Jet registry row takes that row's rendering.
sema_derive_reject: fn(expansion: &SemaDeriveExpansion, args: [CallArg], span: Span) Never! {
    if args.len() != 1 || args[0].label != None || args[0].spread {
        sema_derive_fail(expansion, sema_derive_unsupported(span, "`reject` with anything but one diagnostic value"))
        return
    }
    value: sema_derive_static_value(expansion, args[0].expr) ?? {
        sema_derive_fail(expansion, sema_derive_unsupported(expr_span(args[0].expr), "a `reject` argument that is not a known-time value"))
        return
    }
    value_type: if value == .Struct(name, _) -> name else -> sema_derive_value_type_name(value)
    report: sema_derive_report(expansion, value_type) ?? {
        sema_derive_fail(expansion, sema_error("E0905", expr_span(args[0].expr), "`{value_type}` does not implement `Diagnostic`", "`reject` raises a diagnostic value; its type's `Diagnostic` impl gives the code and the texts", "reject with a value whose type has an `impl {value_type}.Diagnostic`"))
        return
    }
    texts := [String]{}
    text_names: [String]{"what", "why", "fix"}
    loop name in text_names {
        text: sema_derive_report_text(report.definition, name, value) ?? {
            sema_derive_fail(expansion, sema_derive_unsupported(span, "a `Diagnostic` `{name}` that is not one text literal over `self` fields"))
            return
        }
        texts.push(text)
    }
    code := "{report.module_name}.{report.definition.type_name}"
    severity := DIAGNOSTIC_ERROR
    loop constant in report.definition.constants {
        known: sema_derive_static_value(SemaDeriveExpansion{scope: [NamedCtValue]{}, failure: None}, constant.value)
        if constant.name == "code" {
            if known == .Val(.Str(text)) -> code = text
            if known == .Val(.Present(.Str(text))) -> code = text
        }
        if constant.name == "severity" {
            if known == .Val(.Enum(_, variant, _)) {
                if variant == "Warning" || variant == "Lint" -> severity = DIAGNOSTIC_LINT
            }
        }
    }
    site: expansion.site ?? span
    if diagnostic_registry_row(code) != None {
        sema_derive_fail(expansion, diagnostic_from_registry(code, Val(site), texts[0], texts[1], texts[2]))
        return
    }
    sema_derive_fail(expansion, Diagnostic{severity: severity, code: code, span: Val(site), what: diagnostic_sentence_case_line(texts[0]), why: diagnostic_sentence_case_line(texts[1]), fix: diagnostic_sentence_case_line(texts[2])})
}

// The visible `Diagnostic` impl for a struct literal's type: `BadPath` in the
// rule's own module first, `web.BadPath` by module name.
sema_derive_report: fn(expansion: SemaDeriveExpansion, value_type: String) -> SemaDeriveReport? Never! {
    loop report in expansion.reports {
        if report.definition.type_name == value_type || "{report.module_name}.{report.definition.type_name}" == value_type -> return Val(report)
    }
    None
}

// A `Diagnostic` text method: one string literal whose holes read `self` fields.
sema_derive_report_text: fn(definition: ImplDef, name: String, value: CtValue) -> String? Never! {
    loop method in definition.methods {
        if method.name != name -> next
        if method.body.len() != 1 -> return None
        if method.body[0] == .Expr(literal) {
            if literal == .Str(_, _, _) {
                scope: [NamedCtValue]{NamedCtValue{name: "self", value: value}}
                known: sema_derive_static_value(SemaDeriveExpansion{scope: scope, failure: None}, literal) ?? return None
                if known == .Str(text) -> return Val(text)
            }
        }
        return None
    }
    None
}

// Rust `Comptime::expand_derive_body`: `name` and the template's `target` are
// bound to the target's reflected handle.
sema_derive_expand_provider_body: fn(body: [DeriveBodyItem], type_info: CtValue, diagnostics: &[Diagnostic]) -> [Item]? {
    sema_derive_expand_rule_body(body, "target", type_info, None, [SemaDeriveReport]{}, None, "", diagnostics)
}

// A marker rule body expands like a provider body; `self` is the marker's own
// value, its fields the use site's arguments; its `reject(value)` raises one
// of `reports` at the rule's use site.
sema_derive_expand_rule_body: fn(body: [DeriveBodyItem], type_param: String, type_info: CtValue, receiver: CtValue?, reports: [SemaDeriveReport], site: Span?, definition_module: String, diagnostics: &[Diagnostic]) -> [Item]? {
    scope := [NamedCtValue]{}
    if receiver == .Val(value) -> scope.push(NamedCtValue{name: "self", value: value})
    if sema_derive_struct_field(type_info, "name") == .Val(.Str(name)) -> scope.push(NamedCtValue{name: "name", value: CtValue.Str{value: name}})
    scope.push(NamedCtValue{name: type_param, value: type_info})
    sema_derive_expand_scoped(body, scope, reports, site, definition_module, diagnostics)
}

// Rust `Comptime::expand_template_body`: expand one typed item template in
// the caller's compile-time scope. A failed expansion reports its one
// diagnostic and generates nothing.
sema_derive_expand_template_body: fn(body: [DeriveBodyItem], scope: [NamedCtValue], diagnostics: &[Diagnostic]) -> [Item]? {
    sema_derive_expand_scoped(body, scope, [SemaDeriveReport]{}, None, "", diagnostics)
}

sema_derive_expand_scoped: fn(body: [DeriveBodyItem], scope: [NamedCtValue], reports: [SemaDeriveReport], site: Span?, definition_module: String, diagnostics: &[Diagnostic]) -> [Item]? {
    expansion := SemaDeriveExpansion{scope: scope, failure: None, reports: reports, site: site, definition_module: definition_module}
    items := [Item]{}
    sema_derive_expand_body(expansion, body, items)
    if expansion.failure == .Val(diagnostic) {
        diagnostics.push(diagnostic)
        return None
    }
    Val(items)
}

// I4 (`author_facing_diagnostics`): a compiler-generated derive body has no
// author and no user-typeable span; its spans are offsets into
// `Prelude/Derives.jet`. Its advice is dropped; its errors are kept and land on
// `anchor`, the derived type's name (the only authored location the derive
// has), once per distinct problem. A generated codec impl's methods drop
// their advice too, keeping their errors where they are
// (sema_check_generated_codec_method).
sema_author_facing_diagnostics: fn(anchor: Span, generated: [Diagnostic], diagnostics: &[Diagnostic]) {
    kept := [Diagnostic]{}
    loop diagnostic in generated {
        if diagnostic.severity != DIAGNOSTIC_ERROR -> next
        if kept.len() > 0 {
            previous: kept[kept.len() - 1]
            if previous.code == diagnostic.code && previous.what == diagnostic.what -> next
        }
        anchored := diagnostic
        anchored.span = Val(anchor)
        anchored.labels = [DiagnosticLabel]{}
        kept.push(anchored)
    }
    loop diagnostic in kept -> diagnostics.push(diagnostic)
}

// ---------------------------------------------------------------------------
// Built-in providers.

// The Prelude derive markers that carry an `expand` template.
sema_derive_builtin_providers: fn() -> [MarkerDecl] {
    parsed: parse_source(SEMA_PRELUDE_DERIVE_SOURCE.bytes())
    providers := [MarkerDecl]{}
    if parsed.diagnostics.len() != 0 -> return providers
    loop item in parsed.program.items {
        if item == .MarkerDecl(provider) && provider.body != None -> providers.push(provider)
    }
    providers
}

sema_derive_provider: fn(providers: [MarkerDecl], trait_name: String) -> MarkerDecl? {
    loop provider in providers {
        if provider.name == trait_name -> return Val(provider)
    }
    None
}

sema_derive_ct_struct: fn(type_name: String, fields: [NamedCtValue]) -> CtValue {
    CtValue.Struct{type_name: type_name, fields: fields}
}

sema_derive_ct_str: fn(name: String, value: String) -> NamedCtValue {
    NamedCtValue{name: name, value: CtValue.Str{value: value}}
}

// A payload type reads as its written name; a nominal applied to no arguments
// is the nominal itself (Rust `normalize_recursive_payload_type`).
sema_derive_type_text: fn(ty: Type) -> String {
    if ty == .Apply(name, args) {
        if args.len() == 0 -> return name
    }
    type_name(ty)
}

// A field row; `default` is where the field's written default expression
// stands (DefaultInfo, read without running it), absent when it has none.
sema_derive_field_info: fn(name: String, ty: Type, is_pub: Bool, default: Span?) -> CtValue {
    default_info := CtValue.Failed{report: CtReport.Clean{ty: Type.Named{name: "DefaultInfo"}}}
    if default == .Val(source) {
        span: sema_derive_ct_struct("SourceSpan", [NamedCtValue]{NamedCtValue{name: "start", value: CtValue.Int{value: source.start}}, NamedCtValue{name: "end", value: CtValue.Int{value: source.end}}})
        default_info = CtValue.Present{value: sema_derive_ct_struct("DefaultInfo", [NamedCtValue]{NamedCtValue{name: "source", value: span}})}
    }
    sema_derive_ct_struct("FieldInfo", [NamedCtValue]{sema_derive_ct_str("name", name), sema_derive_ct_str("type", sema_derive_type_text(ty)), NamedCtValue{name: "is_pub", value: CtValue.Bool{value: is_pub}}, NamedCtValue{name: "default", value: default_info}})
}

sema_derive_type_info: fn(name: String, kind: String, fields: [CtValue], base: String?) -> CtValue {
    rows := [NamedCtValue]{sema_derive_ct_str("name", name), sema_derive_ct_str("path", name), NamedCtValue{name: "fields", value: CtValue.List{values: fields}}}
    if base == .Val(text) -> rows.push(sema_derive_ct_str("base", text))
    rows.push(sema_derive_ct_str("kind", kind))
    sema_derive_ct_struct("TypeInfo", rows)
}

sema_derive_struct_type_info: fn(definition: StructDef) -> CtValue {
    fields := [CtValue]{}
    loop field_index in 0..<definition.fields.len() {
        if definition.fields[field_index].computed != None -> next
        default := Span?{None}
        if definition.fields[field_index].default == .Val(expression) -> default = Val(expr_source_span(expression))
        fields.push(sema_derive_field_info(definition.fields[field_index].name, definition.fields[field_index].ty, definition.fields[field_index].is_pub, default))
    }
    sema_derive_type_info(definition.name, "struct", fields, None)
}

// Variant rows are `FieldInfo`s with an `index` and nested payload rows, so a
// template binds every heterogeneous payload through one primitive.
sema_derive_enum_type_info: fn(definition: EnumDef) -> CtValue {
    variants := [CtValue]{}
    loop (index, variant) in definition.variants {
        payload := [CtValue]{}
        ty := "Unit"
        if variant.payload == {
            .Unit -> {}
            .Single(payload_type, _) -> {
                ty = sema_derive_type_text(payload_type)
                payload.push(sema_derive_field_info("value", payload_type, definition.is_pub, None))
            }
            .Named(fields) -> {
                parts := [String]{}
                loop field in fields {
                    parts.push("{field.name}: {sema_derive_type_text(field.ty)}")
                    payload.push(sema_derive_field_info(field.name, field.ty, definition.is_pub, None))
                }
                ty = "{{{parts.join(", ")}}}"
            }
        }
        variants.push(sema_derive_ct_struct("FieldInfo", [NamedCtValue]{
            sema_derive_ct_str("name", variant.name),
            sema_derive_ct_str("type", ty),
            NamedCtValue{name: "index", value: CtValue.Int{value: index}},
            NamedCtValue{name: "fields", value: CtValue.List{values: payload}},
            NamedCtValue{name: "is_pub", value: CtValue.Bool{value: definition.is_pub}},
        }))
    }
    sema_derive_type_info(definition.name, "enum", variants, None)
}

sema_derive_distinct_type_info: fn(definition: DistinctDef) -> CtValue {
    sema_derive_type_info(definition.name, "distinct", [CtValue]{}, Val(sema_derive_type_text(definition.base)))
}

sema_derive_replace_provider_type: fn(ty: Type, type_param: String, owner_type: Type) -> Type Never! {
    if ty == {
        // copy: the replaced type is a new owned Type. `owner_type` is reused for every matching
        // node of this provider type, and an unmatched `ty` stays in the provider signature, which
        // the caller keeps.
        .Named(name) -> if name == type_param -> owner_type.copy() else -> ty.copy()
        .List(inner) -> Type.List{element: sema_derive_replace_provider_type(inner, type_param, owner_type)}
        .Shared(inner) -> Type.Shared{inner: sema_derive_replace_provider_type(inner, type_param, owner_type)}
        .Option(inner) -> Type.Option{inner: sema_derive_replace_provider_type(inner, type_param, owner_type)}
        // copy: `len` is a payload of read parameter `ty`, which keeps the original; field `len` of the new Type.FixedList owns this one
        .FixedList(inner, len) -> Type.FixedList{elem: sema_derive_replace_provider_type(inner, type_param, owner_type), len: len.copy()}
        .InlineRange(inner, lo, hi) -> Type.InlineRange{base: sema_derive_replace_provider_type(inner, type_param, owner_type), lo: lo, hi: hi}
        // copy: `marker` is a payload of read parameter `ty`, which keeps the original; field `marker` of the new Type.Tagged owns this one
        .Tagged(marker, inner) -> Type.Tagged{marker: marker.copy(), inner: sema_derive_replace_provider_type(inner, type_param, owner_type)}
        // copy: `dimension` is a payload of read parameter `ty`, which keeps the original; field `dimension` of the new Type.Quantity owns this one
        .Quantity(inner, dimension) -> Type.Quantity{base: sema_derive_replace_provider_type(inner, type_param, owner_type), dimension: dimension.copy()}
        // copy: `key_span` is a payload of read parameter `ty`, which keeps the original; field `key_span` of the new Type.Map owns this one
        .Map(key, key_span, value) -> Type.Map{key: sema_derive_replace_provider_type(key, type_param, owner_type), key_span: key_span.copy(), value: sema_derive_replace_provider_type(value, type_param, owner_type)}
        .Result(ok, err) -> Type.Result{ok: sema_derive_replace_provider_type(ok, type_param, owner_type), err: sema_derive_replace_provider_type(err, type_param, owner_type)}
        .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) -> {
            replaced := [Type]{}
            loop param in params -> replaced.push(sema_derive_replace_provider_type(param, type_param, owner_type))
            Type.Fn{params: replaced, ret: ret.map((value) -> sema_derive_replace_provider_type(value, type_param, owner_type)), effect_bound: effect_bound, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
        }
        .Apply(name, args) -> {
            replaced := [Type]{}
            loop arg in args -> replaced.push(sema_derive_replace_provider_type(arg, type_param, owner_type))
            Type.Apply{name: name, args: replaced}
        }
        .Union(members) -> {
            replaced := [Type]{}
            loop member in members -> replaced.push(sema_derive_replace_provider_type(member, type_param, owner_type))
            Type.Union{members: replaced}
        }
        .Tuple(fields) -> {
            replaced := [TypeTupleField]{}
            loop field in fields -> replaced.push(TypeTupleField{name: field.name, ty: sema_derive_replace_provider_type(field.ty, type_param, owner_type)})
            Type.Tuple{fields: replaced}
        }
        // copy: other type kinds are unchanged, but `ty` stays in the provider signature (the
        // caller's read parameter), so the replaced type gets its own copy.
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> ty.copy()
    }
}

sema_derive_owner_type: fn(name: String, type_params: [TypeParam]) -> Type {
    if type_params.len() == 0 -> return Type.Named{name: name}
    args := [Type]{}
    loop param in type_params -> args.push(Type.Named{name: param.name})
    Type.Apply{name: name, args: args}
}

// Expand one provider for one target. The provider signature was parsed from
// `Prelude/Derives.jet`, so its type spans point into that file; the only
// authored location a derived member has is the target's name, and every
// signature span lands there. The template spells the target `#{name}`,
// which becomes the owner type with its parameters. A failed expansion
// reports its diagnostic and generates nothing.
sema_derive_expand_builtin_provider: fn(providers: [MarkerDecl], trait_name: String, target_name: String, target_span: Span, owner_type: Type, type_info: CtValue, diagnostics: &[Diagnostic]) -> TraitImplBlock? {
    provider: sema_derive_provider(providers, trait_name) ?? return None
    expanded: sema_derive_expand_provider_body(provider.body ?? [DeriveBodyItem]{}, type_info, diagnostics) ?? return None
    methods := [Func]{}
    loop item in expanded {
        if item == .Func(function) {
            method := function
            params := [Param]{}
            loop param in function.params {
                updated := param
                updated.ty = sema_derive_replace_provider_type(param.ty, target_name, owner_type)
                updated.ty_span = target_span
                params.push(updated)
            }
            method.params = params
            if function.return_type == .Val(return_type) {
                method.return_type = Val(sema_derive_replace_provider_type(return_type, target_name, owner_type))
                method.return_type_span = Val(target_span)
            }
            method.compiler_generated = true
            methods.push(method)
        }
    }
    if methods.len() == 0 -> return None
    Val(TraitImplBlock{trait_name: trait_name, trait_span: target_span, operator_rhs: None, operator_marker: None, methods: methods, compiler_generated: true, assoc_type_impls: [NamedType]{}, constants: [ImplConstValue]{}})
}

sema_derive_has_name: fn(derives: [NamedSpan], name: String) -> Bool {
    loop entry in derives {
        if entry.name == name -> return true
    }
    false
}

// Membership facts over one module's items, built once per expansion so
// readiness, selection, and the codec expansion ask keyed questions instead of
// rescanning items. `trait_impls` maps an impl key to its sources
// (sema_derive_impl_flags); `nominals` maps a name to its first struct, enum,
// or distinct position. `codec_methods` holds the (type, Encode/Decode) impl
// keys whose type declares that codec's method name (`encode`, `decode`) as an
// ordinary method: the generated codec would be a second member of that name,
// so the package default never selects it (an explicit marker still asks).
SemaDeriveItemIndex: struct {
    trait_impls: [String:Int]
    nominals: [String:Int]
    distincts: [String:Bool]
    codec_methods: [String:Bool]
}

sema_derive_item_index: fn(items: [Item]) -> SemaDeriveItemIndex {
    index := SemaDeriveItemIndex{trait_impls: [String:Int]{}, nominals: [String:Int]{}, distincts: [String:Bool]{}, codec_methods: [String:Bool]{}}
    loop (position, item) in items {
        if item == {
            .Impl(definition) -> {
                key: sema_type_metadata_impl_key(definition.type_name, definition.trait_name ?? "")
                index.trait_impls[key] = sema_derive_impl_flags(index.trait_impls.get(key), definition.is_generated_serde)
                if !sema_derive_is_codec_trait(definition.trait_name ?? "") -> sema_derive_index_codec_methods(index, definition.type_name, definition.methods)
            }
            .Struct(definition) -> {
                loop block in definition.trait_impls {
                    key: sema_type_metadata_impl_key(definition.name, block.trait_name)
                    index.trait_impls[key] = sema_derive_impl_flags(index.trait_impls.get(key), block.compiler_generated)
                    if !sema_derive_is_codec_trait(block.trait_name) -> sema_derive_index_codec_methods(index, definition.name, block.methods)
                }
                sema_derive_index_codec_methods(index, definition.name, definition.methods)
                if index.nominals.get(definition.name) == None -> index.nominals[definition.name] = position
            }
            .Enum(definition) -> {
                loop block in definition.trait_impls {
                    key: sema_type_metadata_impl_key(definition.name, block.trait_name)
                    index.trait_impls[key] = sema_derive_impl_flags(index.trait_impls.get(key), block.compiler_generated)
                    if !sema_derive_is_codec_trait(block.trait_name) -> sema_derive_index_codec_methods(index, definition.name, block.methods)
                }
                sema_derive_index_codec_methods(index, definition.name, definition.methods)
                if index.nominals.get(definition.name) == None -> index.nominals[definition.name] = position
            }
            .Distinct(definition) -> {
                index.distincts[definition.name] = true
                if index.nominals.get(definition.name) == None -> index.nominals[definition.name] = position
            }
            .Func(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    index
}

// An `Encode`/`Decode` impl is the codec itself; any other impl's `encode` or
// `decode` (inherent or another trait's) is a member the codec would collide with.
sema_derive_is_codec_trait: fn(trait_name: String) -> Bool Never! {
    trait_name == "Encode" || trait_name == "Decode"
}

sema_derive_index_codec_methods: fn(index: &SemaDeriveItemIndex, type_name: String, methods: [Func]) {
    loop method in methods {
        if method.name == "encode" -> index.codec_methods[sema_type_metadata_impl_key(type_name, "Encode")] = true
        if method.name == "decode" -> index.codec_methods[sema_type_metadata_impl_key(type_name, "Decode")] = true
    }
}

// The sources of one (type, trait) impl key: bit 1 a written impl item or
// inline trait block, bit 2 a compiler-generated one (a generated codec impl
// item, or a derived inline block).
sema_derive_impl_flags: fn(existing: Int?, generated: Bool) -> Int Never! {
    flags: existing ?? 0
    bit: if generated -> 2 else -> 1
    if flags == 3 || flags == bit -> return flags
    flags + bit
}

sema_derive_has_trait_impl: fn(index: SemaDeriveItemIndex, type_name: String, trait_name: String) -> Bool {
    index.trait_impls.get(sema_type_metadata_impl_key(type_name, trait_name)) != None
}

// ---------------------------------------------------------------------------
// Structural auto-derive selection (Rust `TraitRegistry::compute_auto_derive`
// for Equatable and Comparable over one module's items). Every requesting
// declaration is first assumed to derive; one whose own fields fail, and
// every declaration that relied on it, transitively, loses the derive.

SemaDeriveReadiness: struct {
    index: SemaDeriveItemIndex
    trait_name: String
    candidates: [String:Int]
    relied_on: [Int]
}

sema_derive_builtin_supports: fn(name: String, trait_name: String) -> Bool {
    // Rust `implements_trait` for a codec: the scalars, the sealed dynamic
    // tree (`is_data_type_name`, the identity bridge), and the Core value
    // carriers whose Core source declares their codec (`sema_serde_type_is_admissible`).
    if owned_trait_codec(trait_name) {
        if name == "Int" || name == "Float" || name == "Bool" || name == "String" || name == "Char" || name == "U8" -> return true
        if name == "Dyn" || name == "JSON" || name == "TOML" || name == "YAML" || name == "CSV" -> return true
        return name == "Decimal" || name == "Date" || name == "LocalDate" || name == "LocalTime" || name == "DateTime" || name == "Duration" || name == "ZonedDateTime"
    }
    if name == "Int" || name == "Bool" || name == "String" || name == "Char" || name == "U8" || name == "Ordering" || name == "Float" || name == "Float32" -> return true
    // The Prelude carriers with registered value
    // equality and order (Rust `register_synthetic_display_debug`).
    if name == "DateTime" || name == "LocalDate" || name == "LocalTime" || name == "Duration" || name == "Instant" || name == "ZonedDateTime" -> return true
    if trait_name == "Comparable" -> return name == "Decimal"
    name == "Range" || name == "TLSVersion" || name == "EncodingErrorKind" || name == "EncodingFormat" || name == "EncodingCause" || name == "EncodingError" || name == "EncodingLimits" || name == "DataError" || name == "DataErrorKind" || name == "DataLimits" || name == "ComputeError"
}

// Rust `implements_trait` over this module's declarations.
sema_derive_implements: fn(readiness: &SemaDeriveReadiness, items: [Item], name: String) -> Bool {
    if readiness.candidates.get(name) == .Val(node) {
        readiness.relied_on.push(node)
        return true
    }
    if sema_derive_builtin_supports(name, readiness.trait_name) -> return true
    if sema_derive_has_trait_impl(readiness.index, name, readiness.trait_name) -> return true
    position: readiness.index.nominals.get(name) ?? return false
    if items[position] == {
        .Struct(definition) -> sema_derive_has_name(definition.derives, readiness.trait_name)
        .Enum(definition) -> sema_derive_has_name(definition.derives, readiness.trait_name)
        .Distinct(definition) -> readiness.trait_name == "Equatable" || sema_derive_has_name(definition.derives, readiness.trait_name)
        .Func(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> false
    }
}

sema_derive_native_ordering_ready: fn(ty: Type) -> Bool {
    if ty == {
        .Int | .IntN(_, _) | .Bool | .String | .Char | .Float | .Float32 -> true
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) -> sema_derive_native_ordering_ready(inner)
        .Result(ok, err) -> sema_derive_native_ordering_ready(ok) && sema_derive_native_ordering_ready(err)
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_derive_native_ordering_ready(field.ty) -> return false
            }
            true
        }
        .Named(name) -> name == "U8" || name == "Ordering"
        .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .InlineRange(_, _, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_derive_type_ready: fn(readiness: &SemaDeriveReadiness, items: [Item], ty: Type, type_params: [TypeParam]) -> Bool {
    comparable: readiness.trait_name == "Comparable"
    // Rust `auto_derive_type_ready`: a codec has no wire form for a Result,
    // a tuple, a tagged or quantity carrier, a compile-time measure, or a map
    // keyed by anything but `String`.
    codec: owned_trait_codec(readiness.trait_name)
    if ty == {
        .List(inner) | .Option(inner) | .FixedList(inner, _) -> if comparable -> sema_derive_native_ordering_ready(ty) else -> sema_derive_type_ready(readiness, items, inner, type_params)
        .Result(ok, err) -> {
            if codec -> return false
            if comparable -> sema_derive_native_ordering_ready(ty) else -> sema_derive_type_ready(readiness, items, ok, type_params) && sema_derive_type_ready(readiness, items, err, type_params)
        }
        .Map(key, _, value) -> !comparable && (!codec || key == Type.String) && sema_derive_type_ready(readiness, items, key, type_params) && sema_derive_type_ready(readiness, items, value, type_params)
        .Tuple(fields) -> {
            if codec -> return false
            if comparable -> return sema_derive_native_ordering_ready(ty)
            loop field in fields {
                if !sema_derive_type_ready(readiness, items, field.ty, type_params) -> return false
            }
            true
        }
        .Union(members) -> {
            if comparable -> return sema_derive_native_ordering_ready(ty)
            loop member in members {
                if !sema_derive_type_ready(readiness, items, member, type_params) -> return false
            }
            true
        }
        .Apply(name, args) -> {
            if comparable -> return false
            if !sema_derive_implements(readiness, items, name) -> return false
            loop arg in args {
                if !sema_derive_type_ready(readiness, items, arg, type_params) -> return false
            }
            true
        }
        .Tagged(_, inner) -> {
            if codec -> return false
            if comparable -> sema_derive_native_ordering_ready(ty) else -> sema_derive_type_ready(readiness, items, inner, type_params)
        }
        .InlineRange(inner, _, _) -> sema_derive_type_ready(readiness, items, inner, type_params)
        .Quantity(inner, _) -> !codec && sema_derive_type_ready(readiness, items, inner, type_params)
        .Named(name) -> {
            // A wire-reaching type parameter gains the codec bound on the
            // generated impl (S55), so it never blocks a codec.
            loop param in type_params {
                if param.name == name -> return codec || param.bounds.contains(readiness.trait_name)
            }
            sema_derive_implements(readiness, items, name)
        }
        .Float | .Float32 -> !comparable
        .Int | .Bool | .String | .Char | .IntN(_, _) -> true
        .Measure(_) -> !codec
        .Shared(_) | .TraitObject(_) | .Fn(_, _, _, _, _, _) -> false
    }
}

sema_derive_fields_ready: fn(readiness: &SemaDeriveReadiness, items: [Item], item: Item) -> Bool {
    if item == {
        .Struct(definition) -> {
            loop field in definition.fields {
                if field.computed != None -> next
                if !sema_derive_type_ready(readiness, items, field.ty, definition.type_params) -> return false
            }
            true
        }
        .Enum(definition) -> {
            loop variant in definition.variants {
                if variant.payload == {
                    .Unit -> {}
                    .Single(ty, _) -> if !sema_derive_type_ready(readiness, items, ty, definition.type_params) -> return false
                    .Named(fields) -> {
                        loop field in fields {
                            if !sema_derive_type_ready(readiness, items, field.ty, definition.type_params) -> return false
                        }
                    }
                }
            }
            true
        }
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> false
    }
}

sema_derive_auto_selected: fn(items: [Item], index: SemaDeriveItemIndex, trait_name: String) -> [String:Bool] {
    readiness := SemaDeriveReadiness{index: index, trait_name: trait_name, candidates: [String:Int]{}, relied_on: [Int]{}}
    names := [String]{}
    nodes := [Item]{}
    loop item in items {
        name := ""
        requested := false
        if item == {
            .Struct(definition) -> {
                name = definition.name
                requested = sema_type_metadata_struct_auto_ok(definition) && sema_type_metadata_trait_requested(definition.type_markers, trait_name, definition.auto_derive_default)
            }
            .Enum(definition) -> {
                name = definition.name
                requested = sema_type_metadata_enum_auto_ok(definition) && sema_type_metadata_trait_requested(definition.type_markers, trait_name, definition.auto_derive_default)
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> next
        }
        if !requested || readiness.candidates.get(name) != None || sema_derive_has_trait_impl(index, name, trait_name) || index.codec_methods.get(sema_type_metadata_impl_key(name, trait_name)) != None -> next
        readiness.candidates[name] = names.len()
        names.push(name)
        nodes.push(item.copy())
    }
    failed := [Bool]{}
    dependents := [[Int]]{}
    loop _ in names {
        failed.push(false)
        dependents.push([Int]{})
    }
    loop (node, item) in nodes {
        readiness.relied_on = [Int]{}
        if sema_derive_fields_ready(readiness, items, item) {
            loop dependency in readiness.relied_on {
                if dependency != node -> dependents[dependency].push(node)
            }
        } else {
            failed[node] = true
        }
    }
    pending := [Int]{}
    loop (node, is_failed) in failed {
        if is_failed -> pending.push(node)
    }
    loop pending.len() > 0 {
        node: pending.pop() ?? break
        loop dependent in dependents[node] {
            if !failed[dependent] {
                failed[dependent] = true
                pending.push(dependent)
            }
        }
    }
    selected := [String:Bool]{}
    loop (node, name) in names {
        if !failed[node] -> selected[name] = true
    }
    selected
}

// I3: compiler-owned capability requests use the same
// typed derive-template engine as user-authored code. A struct or enum
// derives Equatable/Comparable when its markers request it (explicitly, or
// through the package auto-derive default with every field ready); every
// distinct over a non-distinct base derives Equatable, and Comparable when
// requested. A declaration that already implements the capability keeps its
// own implementation. `items` is updated in place: only an expanded
// declaration is rewritten, and generated impls are appended.
sema_derive_expand_builtin_items: fn(items: &[Item], diagnostics: &[Diagnostic]) {
    facts: sema_derive_item_index(items)
    auto_equatable: sema_derive_auto_selected(items, facts, "Equatable")
    auto_comparable: sema_derive_auto_selected(items, facts, "Comparable")
    providers := [MarkerDecl]?{None}
    generated := [Item]{}
    // Each item is read in place; an expanded declaration gains its derived
    // trait impls in place.
    loop index in 0..<items.len() {
        // A `#Comparable` over a value with no order at all is one E0905 at
        // the marker; its derived bodies are not expanded, so no `<` error
        // follows from inside them.
        if sema_derive_unordered_comparable(items[index], diagnostics) -> next
        blocks: sema_derive_builtin_blocks(items[index], facts, auto_equatable, auto_comparable, providers, generated, diagnostics)
        if blocks.len() == 0 -> next
        if &items[index] == .Struct(definition) {
            loop block in blocks -> definition.trait_impls.push(block)
        }
        if &items[index] == .Enum(definition) {
            loop block in blocks -> definition.trait_impls.push(block)
        }
    }
    loop item in generated -> items.push(item)
}

// A Float orders by IEEE 754 totalOrder, so it is Comparable like the other
// scalars. A map or a function has no order: an explicit `#Comparable` over a
// type that holds one (a field, a variant payload, or a distinct's base,
// through lists, options, results, tuples and unions) is E0905 at the marker.
sema_derive_unordered_comparable: fn(item: Item, diagnostics: &[Diagnostic]) -> Bool {
    marker: if item == {
        .Struct(definition) -> sema_derive_comparable_marker(definition.derives) ?? return false
        .Enum(definition) -> sema_derive_comparable_marker(definition.derives) ?? return false
        .Distinct(definition) -> sema_derive_comparable_marker(definition.derives) ?? return false
        .Func(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> { return false }
    }
    held: sema_derive_item_unordered_type(item) ?? return false
    held_name: type_name(held)
    row: diagnostic_registry_row("E0905") ?? panic("E0905 must have a registry row")
    diagnostics.push(sema_error("E0905", marker, row.what.replace("{{type}}", held_name).replace("{{bound}}", "Comparable"), row.why.replace("{{why_text}}", "`{held_name}` has no order, so a type that holds it can't be `Comparable`"), row.fix.replace("{{fix_text}}", "remove `#Comparable`, or write the `Comparable` impl by hand over the fields that have an order")))
    true
}

// A distinct type's bundle request (`#Comparable`, `#Printable`, `#Numeric`,
// `#CodableAsBase`) forwards the base type's own implementation, so the base
// must have that trait. A base with no order was already refused at
// registration (sema_derive_unordered_comparable); the rest is answered here
// against the checked types, E0905 at the request naming trait and base.
sema_derive_check_distinct_forwards: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_index: Int, diagnostics: &[Diagnostic]) {
    if program.registration_graph == .Val(graph) {
        loop item in graph.modules[module_index].program.items {
            if item == .Distinct(definition) {
                base := sema_type_resolve_declared(graph, definition.base, environment.module_identity)
                reported := [Span]{}
                loop derived in definition.derives {
                    if reported.contains(derived.span) -> next
                    if sema_derive_distinct_base_has(environment, program, derived.name, base) -> next
                    reported.push(derived.span)
                    diagnostics.push(sema_derive_distinct_forward_error(definition.name, type_name(definition.base), derived.name, derived.span))
                }
            }
        }
    }
}

sema_derive_distinct_base_has: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, trait_name: String, base: Type) -> Bool Never! {
    if {
        trait_name == "Comparable" -> sema_derive_unordered_type(base) != None || sema_type_comparable(environment, program, base)
        trait_name == "Printable" -> sema_call_ambient_printable(base, environment, program)
        trait_name == "Numeric" -> sema_derive_numeric_base(base)
        trait_name == "Encode" -> sema_serde_type_is_admissible(environment, program, base, SemaSerdeDirection.Encode)
        trait_name == "Decode" -> sema_serde_type_is_admissible(environment, program, base, SemaSerdeDirection.Decode)
        else -> true
    }
}

// The built-in numbers carry the arithmetic `#Numeric` forwards; a nominal or
// quantity base brings its own operator impls, which the operators check.
sema_derive_numeric_base: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .IntN(_, _) | .Float | .Float32 | .Named(_) | .Apply(_, _) | .Quantity(_, _) | .Measure(_) -> true
        .Tagged(_, inner) | .InlineRange(inner, _, _) -> sema_derive_numeric_base(inner)
        .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Union(_) -> false
    }
}

sema_derive_distinct_forward_error: fn(name: String, base: String, trait_name: String, span: Span) -> Diagnostic Never! {
    row: diagnostic_registry_row("E0905") ?? panic("E0905 must have a registry row")
    why := "`{name}` forwards `{trait_name}` from its base type `{base}`, and `{base}` has no `{trait_name}` to forward"
    fix := "drop the `{trait_name}` request from `{name}`, or base `{name}` on a type that has `{trait_name}`"
    sema_error("E0905", span, row.what.replace("{{type}}", base).replace("{{bound}}", trait_name), row.why.replace("{{why_text}}", why), row.fix.replace("{{fix_text}}", fix))
}

// The forwarding impls registration generates for the distinct types in
// `items` (sema_derive_expand_builtin_items over the same items), formatted
// as Jet source and keyed by the distinct's name. Printing, the codec and
// arithmetic forward natively and generate no members. A checked module's
// items already hold those impls, each at its distinct's name span; they
// are left out first so the expansion generates them again instead of
// treating them as written impls.
sema_derive_distinct_forward_source: fn(items: [Item]) -> [String:String] {
    names := [String]{}
    name_spans := [Span]{}
    loop item in items {
        if item == .Distinct(definition) {
            names.push(definition.name)
            name_spans.push(definition.name_span)
        }
    }
    output := [String:String]{}
    if names.len() == 0 -> return output
    expanded := [Item]{}
    loop item in items {
        if item == .Impl(implementation) {
            if names.contains(implementation.type_name) && name_spans.contains(implementation.span) -> next
        }
        // copy: the expansion rewrites its own items; the module's stay as checked.
        expanded.push(item.copy())
    }
    count: expanded.len()
    problems := [Diagnostic]{}
    sema_derive_expand_builtin_items(expanded, problems)
    loop name in names {
        generated := [Item]{}
        loop index in count..<expanded.len() {
            if expanded[index] == .Impl(implementation) {
                if implementation.type_name == name -> generated.push(expanded[index].copy())
            }
        }
        if generated.len() > 0 -> output[name] = sema_build_generate_format(generated)
    }
    output
}

// The first unordered type an item holds: in a stored field, a variant
// payload, or a distinct's base.
sema_derive_item_unordered_type: fn(item: Item) -> Type? Never! {
    if item == {
        .Struct(definition) -> {
            loop field in definition.fields {
                if field.computed != None -> next
                if sema_derive_unordered_type(field.ty) == .Val(held) -> return Val(held)
            }
        }
        .Enum(definition) -> {
            loop variant in definition.variants {
                if variant.payload == {
                    .Unit -> {}
                    .Single(ty, _) -> {
                        if sema_derive_unordered_type(ty) == .Val(held) -> return Val(held)
                    }
                    .Named(named) -> {
                        loop field in named {
                            if sema_derive_unordered_type(field.ty) == .Val(held) -> return Val(held)
                        }
                    }
                }
            }
        }
        .Distinct(definition) -> return sema_derive_unordered_type(definition.base)
        .Func(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    None
}

sema_derive_comparable_marker: fn(derives: [NamedSpan]) -> Span? Never! {
    loop derived in derives {
        if derived.name == "Comparable" -> return Val(derived.span)
    }
    None
}

// The first type inside `ty` with no order: a map or a function.
sema_derive_unordered_type: fn(ty: Type) -> Type? Never! {
    if ty == {
        .Map(_, _, _) | .Fn(_, _, _, _, _, _) -> Val(ty)
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> sema_derive_unordered_type(inner)
        .Result(ok, error) -> {
            if sema_derive_unordered_type(ok) == .Val(held) -> return Val(held)
            sema_derive_unordered_type(error)
        }
        .Tuple(members) -> {
            loop member in members {
                if sema_derive_unordered_type(member.ty) == .Val(held) -> return Val(held)
            }
            None
        }
        .Union(members) -> {
            loop member in members {
                if sema_derive_unordered_type(member) == .Val(held) -> return Val(held)
            }
            None
        }
        .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .IntN(_, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> None
    }
}

// The generated getter a computed field `name: T -> formula` reads through.
sema_computed_field_getter: fn(field: String) -> String Never! {
    "__computed_{field}"
}

// The memoized helper a `#Memo` computed field's getter calls.
sema_computed_field_memo_helper: fn(field: String) -> String Never! {
    "{sema_computed_field_getter(field)}__memo"
}

// A computed field's getter body is the user's formula, so it checks as
// user code: its calls propagate failures like any written method. A `#Memo`
// field's helper is generated the same way.
sema_computed_field_getter_function: fn(func: Func) -> Bool Never! {
    func.compiler_generated && func.name.starts_with("__computed_")
}

// The `#Memo` helper of a computed field (sema_computed_field_memo_helper_func).
sema_computed_field_memo_helper_function: fn(func: Func) -> Bool Never! {
    sema_computed_field_getter_function(func) && func.name.ends_with("__memo")
}

// A formula that only reads values (sibling fields, literals, operators)
// makes a getter with the empty effect row (`-[]>`), so a contract may read
// the field. A call or a member read anywhere in it (another type's computed
// field may be a call) leaves the getter's effects undeclared; so does a
// sibling computed field whose own formula does. `depth` stops a cycle, which
// registration reports on its own.
sema_computed_formula_reads_only: fn(formula: Expr, fields: [Field], depth: Int) -> Bool Never! {
    if formula == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Absent(_, _) -> true
        .Ident(name, _, _) -> {
            loop field in fields {
                if field.name != name -> next
                sibling: field.computed ?? return true
                if depth >= fields.len() -> return false
                return sema_computed_formula_reads_only(sibling, fields, depth + 1)
            }
            true
        }
        .Str(parts, _, _) -> loop part in parts {
            if part == .Interp(_, _) -> break false
        } ?? true
        .Paren(value, _, _) -> sema_computed_formula_reads_only(value, fields, depth)
        .Present(value, _, _) -> sema_computed_formula_reads_only(value, fields, depth)
        .Unary(_, operand, _, _) -> sema_computed_formula_reads_only(operand, fields, depth)
        .Binary(_, left, right, _, _) -> sema_computed_formula_reads_only(left, fields, depth) && sema_computed_formula_reads_only(right, fields, depth)
        .CompareChain(operands, _, _, _, _) -> loop operand in operands {
            if !sema_computed_formula_reads_only(operand, fields, depth) -> break false
        } ?? true
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) | .Pipe(_, _, _, _) -> false
    }
}

// Each computed struct field `name: T -> formula` becomes its generated
// getter method `__computed_name(self) -> T`, whose formula reads the
// sibling fields it names as `self.<field>`; a read of `value.name` checks
// as a call of that getter (Places `sema_expression_computed_field_read`).
//
// A `#Memo` field keeps its first read: its formula becomes the
// helper `__computed_name__memo`, marked with the field's `#Memo`, whose
// parameters are the sibling fields the formula reads, and the getter calls
// the helper with their current values. The one `#Memo` store (JetIR
// BuildMemo.jet) keys the answer by those values, so a repeat read is a hit
// and a write to any field the formula reads misses and evaluates again; a
// write to any other field leaves the answer. The helper is pure exactly when
// a `#Memo` function must be (E0938).
sema_derive_computed_getters: fn(items: &[Item]) {
    loop index in 0..<items.len() {
        if &items[index] == .Struct(definition) {
            rewrite := sema_inline_rewrite_empty()
            loop field in definition.fields {
                receiver: Expr.Ident{name: "self", span: field.name_span, id: AST_NODE_GENERATED}
                rewrite.values[field.name] = Expr.Field{base: receiver, member: field.name, span: field.name_span, id: AST_NODE_GENERATED}
            }
            getters := [Func]{}
            loop field in definition.fields {
                if field.computed == .Val(formula) {
                    getter := ast_func(sema_computed_field_getter(field.name), field.name_span, field.name_span)
                    getter.is_pub = field.is_pub
                    getter.is_package_pub = field.is_package_pub
                    getter.compiler_generated = true
                    getter.params = [Param]{Param{
                        convention: AccessConvention.Read,
                        root: false,
                        name: "self",
                        name_span: field.name_span,
                        public_label: None,
                        zone: ParamZone.Either,
                        ty: Type.Named{name: ""},
                        ty_span: field.name_span,
                        default: None,
                        variadic: false,
                        variadic_bound_list: None,
                        declared_view_from_names: None,
                        declared_footprint: None,
                    }}
                    getter.return_type = Val(field.ty.copy())
                    getter.return_type_span = Val(field.ty_span)
                    value := sema_inline_rewrite_expr(rewrite, formula)
                    // A field `#Memo` with arguments is refused (E0382) and keeps no store.
                    if sema_checked_marker(field.serde_markers, MARKER_MEMO) == .Val(marker) && marker.args.len() == 0 {
                        helper: sema_computed_field_memo_helper_func(definition, field, marker, formula)
                        value = sema_computed_field_memo_call(definition, field, helper)
                        getters.push(helper)
                    }
                    getter.body = [Stmt]{Stmt.Return{value: Val(value), span: field.name_span}}
                    if sema_computed_formula_reads_only(formula, definition.fields, 0) {
                        getter.declared_effects = Val([EffectRowEntry]{})
                        getter.is_pure = true
                    }
                    getters.push(getter)
                }
            }
            loop getter in getters -> definition.methods.push(getter)
        }
    }
}

// The `#Memo` helper of computed `field` (sema_derive_computed_getters): one
// parameter per sibling field `formula` reads, in declaration order, and the
// formula itself as its body, where the bare names now read the parameters,
// as the getter's rewrite reads them through `self`. A formula that reads
// `self` also takes the receiver, so the whole value is part of the key.
//
// The helper's failure contract is fixed here, before its body is checked,
// so the body is built for the contract the function returns with (it is no
// failure inference candidate, sema_failure_inference_candidate). A formula
// that only reads values has no failure source: `T Never!`. Any other keeps
// the default `T !` of its written type.
sema_computed_field_memo_helper_func: fn(definition: StructDef, field: Field, marker: Marker, formula: Expr) -> Func {
    named := [String]{}
    loop site in comptime_walk_identifiers(formula) -> named.push(site.name)
    helper := ast_func(sema_computed_field_memo_helper(field.name), field.name_span, field.name_span)
    helper.compiler_generated = true
    helper.markers = [Marker]{marker.copy()}
    params := [Param]{}
    if named.contains("self") -> params.push(sema_computed_field_param("self", Type.Named{name: ""}, field.name_span))
    loop sibling in definition.fields {
        if sibling.name != field.name && named.contains(sibling.name) -> params.push(sema_computed_field_param(sibling.name, sibling.ty.copy(), sibling.name_span))
    }
    helper.params = params
    reads_only: sema_computed_formula_reads_only(formula, definition.fields, 0)
    helper.return_type = Val(field.ty.copy())
    // copy: the contract test takes the written type as a return type.
    if reads_only && sema_failure_contract_is_default(Val(field.ty.copy())) -> helper.return_type = Val(Type.Result{ok: field.ty.copy(), err: Type.Named{name: "Never"}})
    helper.return_type_span = Val(field.ty_span)
    helper.body = [Stmt]{Stmt.Return{value: Val(formula.copy()), span: field.name_span}}
    if reads_only {
        helper.declared_effects = Val([EffectRowEntry]{})
        helper.is_pure = true
    }
    helper
}

// The getter body of a `#Memo` field: a call of its `helper` with the current
// value of each sibling the helper takes, on the receiver when it takes `self`,
// else on the struct type.
sema_computed_field_memo_call: fn(definition: StructDef, field: Field, helper: Func) -> Expr {
    span: field.name_span
    receiver := Expr.Ident{name: definition.name, span: span, id: AST_NODE_GENERATED}
    owner_args := [Type]{}
    loop parameter in definition.type_params -> owner_args.push(Type.Named{name: parameter.name})
    args := [CallArg]{}
    loop parameter in helper.params {
        self_value: Expr.Ident{name: "self", span: span, id: AST_NODE_GENERATED}
        if parameter.name == "self" {
            receiver = self_value
            owner_args = [Type]{}
            next
        }
        args.push(CallArg{convention: AccessConvention.Read, expr: Expr.Field{base: self_value, member: parameter.name, span: span, id: AST_NODE_GENERATED}, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false})
    }
    Expr.MethodCall{receiver: receiver, method: helper.name, method_span: span, owner_type_args: owner_args, type_args: [Type]{}, args: args, id: AST_NODE_GENERATED}
}

// A read parameter `name: ty` of a generated computed-field function.
sema_computed_field_param: fn(name: String, ty: Type, span: Span) -> Param Never! {
    Param{
        convention: AccessConvention.Read,
        root: false,
        name: name,
        name_span: span,
        public_label: None,
        zone: ParamZone.Either,
        ty: ty,
        ty_span: span,
        default: None,
        variadic: false,
        variadic_bound_list: None,
        declared_view_from_names: None,
        declared_footprint: None,
    }
}

// The derived trait impls of a struct or enum `item`, in trait order. A
// distinct's impls join `generated` as separate impl items instead.
sema_derive_builtin_blocks: fn(item: Item, facts: SemaDeriveItemIndex, auto_equatable: [String:Bool], auto_comparable: [String:Bool], providers: &[MarkerDecl]?, generated: &[Item], diagnostics: &[Diagnostic]) -> [TraitImplBlock] {
    blocks := [TraitImplBlock]{}
    if item == {
        .Struct(definition) -> {
            equatable: sema_derive_has_name(definition.derives, "Equatable") || auto_equatable.get(definition.name) != None
            comparable: sema_derive_has_name(definition.derives, "Comparable") || auto_comparable.get(definition.name) != None
            if !equatable && !comparable -> return blocks.move()
            if providers == None -> providers = Val(sema_derive_builtin_providers())
            available: providers ?? [MarkerDecl]{}
            owner_type: sema_derive_owner_type(definition.name, definition.type_params)
            type_info: sema_derive_struct_type_info(definition)
            loop trait_name in owned_trait_structural_names() {
                wanted: (trait_name == "Equatable" && equatable) || (trait_name == "Comparable" && comparable)
                if !wanted || sema_derive_has_trait_impl(facts, definition.name, trait_name) -> next
                block: sema_derive_expand_builtin_provider(available, trait_name, definition.name, definition.name_span, owner_type, type_info, diagnostics) ?? next
                blocks.push(block)
            }
        }
        .Enum(definition) -> {
            equatable: sema_derive_has_name(definition.derives, "Equatable") || auto_equatable.get(definition.name) != None
            comparable: sema_derive_has_name(definition.derives, "Comparable") || auto_comparable.get(definition.name) != None
            if !equatable && !comparable -> return blocks.move()
            if providers == None -> providers = Val(sema_derive_builtin_providers())
            available: providers ?? [MarkerDecl]{}
            owner_type: sema_derive_owner_type(definition.name, definition.type_params)
            type_info: sema_derive_enum_type_info(definition)
            loop trait_name in owned_trait_structural_names() {
                wanted: (trait_name == "Equatable" && equatable) || (trait_name == "Comparable" && comparable)
                if !wanted || sema_derive_has_trait_impl(facts, definition.name, trait_name) -> next
                block: sema_derive_expand_builtin_provider(available, trait_name, definition.name, definition.name_span, owner_type, type_info, diagnostics) ?? next
                blocks.push(block)
            }
        }
        .Distinct(definition) -> {
            // A distinct over another distinct is rejected elsewhere; it
            // derives nothing here.
            if definition.base == .Named(base) {
                if facts.distincts.get(base) != None -> return blocks.move()
            }
            if providers == None -> providers = Val(sema_derive_builtin_providers())
            available: providers ?? [MarkerDecl]{}
            owner_type: Type.Named{name: definition.name}
            type_info: sema_derive_distinct_type_info(definition)
            loop trait_name in owned_trait_structural_names() {
                if trait_name == "Comparable" && !sema_derive_has_name(definition.derives, "Comparable") -> next
                // A function has no equality, so a distinct holding one
                // forwards none; `==` on it is refused where it is written.
                if trait_name == "Equatable" && sema_derive_holds_function(definition.base) -> next
                if sema_derive_has_trait_impl(facts, definition.name, trait_name) -> next
                block := sema_derive_expand_builtin_provider(available, trait_name, definition.name, definition.name_span, owner_type, type_info, diagnostics) ?? next
                generated.push(Item.Impl{value: ImplDef{span: definition.name_span, type_name: definition.name, type_span: definition.name_span, trait_name: Val(trait_name), trait_span: Val(definition.name_span), operator_rhs: None, operator_marker: None, methods: block.methods.move(), delegation_field: None, assoc_type_impls: [NamedType]{}, constants: [ImplConstValue]{}, is_generated_serde: false, os_target: None}})
            }
        }
        .Func(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    blocks.move()
}

// Whether `ty` holds a function value, through the structural carriers.
sema_derive_holds_function: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Fn(_, _, _, _, _, _) -> true
        .List(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .Shared(inner) -> sema_derive_holds_function(inner)
        .Map(key, _, value) | .Result(key, value) -> sema_derive_holds_function(key) || sema_derive_holds_function(value)
        .Tuple(members) -> loop member in members {
            if sema_derive_holds_function(member.ty) -> break true
        } ?? false
        .Union(members) -> loop member in members {
            if sema_derive_holds_function(member) -> break true
        } ?? false
        .Int | .Float | .Bool | .String | .Char | .Named(_) | .Apply(_, _) | .TraitObject(_) | .IntN(_, _) | .Float32 | .InlineRange(_, _, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}
