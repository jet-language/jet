// The export boundary shared by the native Library C exports (owner ruling
// U3) and the `target: sandbox` Component exports (
// ). Which shapes cross each boundary is the MIR export
// law (`mir_c_export_signature`, `mir_component_export_signature`, both over
// the one `mir_c_export_result` success projection); this module owns the
// boundary's diagnostics, the sandbox's export selection, and the frozen
// interface snapshot that versions a sandbox (`.jet/cache/api/plugin__<name>.api`).
use jet_foundation.[
    Diagnostic,
    Func,
    Item,
    Span,
]

// The API snapshot schema shared with ordinary library freezes.
SEMA_API_SNAPSHOT_VERSION :: 3

enum SemaExportBoundary {
    // A `target: sandbox` package's entry-module `fn` rows.
    Sandbox
    // A native Library artifact's `#Export(c)` rows.
    C
}

// E1260: one registered code, worded for the boundary the export crosses.
fn sema_export_unsupported_diagnostic(boundary: SemaExportBoundary, name: String, span: Span) -> Diagnostic {
    if boundary == {
        .Sandbox -> sema_error("E1260", span, "a sandbox's exported function has an unsupported signature", "`fn {name}` crosses the sandbox's Component boundary: each parameter and the result must be `Int`, `Float`, `Bool`, `String`, or a recursively closed `#Codable` record/list/Option/Result shape, and the function must return one", "change each unsupported parameter or result to one of those shapes, or mark it `priv` if this function isn't meant to be called across the sandbox boundary")
        .C -> sema_error("E1260", span, "a native Library's exported function has an unsupported signature", "`#Export(c) fn {name}` crosses the C boundary: each parameter and the result must be one C primitive (`Int`, `Float`, `Bool`, `String`, or a fixed width such as `U8` or `F32`), independently per position", "change each unsupported parameter or result to a C primitive, or drop `#Export(c)` if this function isn't meant to be called from C")
    }
}

// The functions a sandbox exports: every top-level `pub` (not
// `pub(package)`) function of its entry module, in declaration order. There
// is no separate export marker.
fn sema_sandbox_export_functions(graph: SemaRegistrationGraph) -> [Func] Never! {
    functions := [Func]{}
    module_index :: sema_registration_module_index(graph, graph.entry_module_identity) ?? return functions
    loop item_index in 0..<graph.modules[module_index].program.items.len() {
        if graph.modules[module_index].program.items[item_index] == {
            .Func(function) -> {
                if function.is_pub && !function.is_package_pub -> &functions.push(function)
            }
            else -> {}
        }
    }
    functions
}

// The frozen-snapshot package key of sandbox `export_name`, namespaced so it
// never collides with an ordinary library package's frozen API.
fn sema_sandbox_snapshot_package(export_name: String) -> String Never! {
    "plugin__{export_name}"
}

fn sema_sandbox_frozen_after(left: SemaPluginFrozenExportInput, right: SemaPluginFrozenExportInput) -> Bool Never! {
    if left.name != right.name -> return left.name > right.name
    left.signature > right.signature
}

// The current interface of sandbox `export_name`: the canonical signature of
// each exported function in `exported` (the names the checked artifact plan
// exports), sorted by name.
fn sema_sandbox_interface_snapshot(graph: SemaRegistrationGraph, export_name: String, exported: [String]) -> SemaPluginFrozenSnapshotInput {
    dimensions := [SemaPluginUnitDimension]{}
    module_index :: sema_registration_module_index(graph, graph.entry_module_identity)
    if module_index == .Val(index) -> sema_plugin_unit_dimensions_in_items(graph.modules[index].program.items, export_name, &dimensions)
    funcs := [SemaPluginFrozenExportInput]{}
    loop function in sema_sandbox_export_functions(graph) {
        if !exported.contains(function.name) -> next
        &funcs.push(SemaPluginFrozenExportInput{name: function.name, signature: sema_plugin_canonical_fn_signature(function, dimensions)})
    }
    loop index in 1..<funcs.len() {
        item := funcs[index]
        cursor := index
        loop cursor > 0 && sema_sandbox_frozen_after(funcs[cursor - 1], item) {
            funcs[cursor] = funcs[cursor - 1]
            cursor -= 1
        }
        funcs[cursor] = item
    }
    SemaPluginFrozenSnapshotInput{package: sema_sandbox_snapshot_package(export_name), funcs: funcs}
}

// The `.api` snapshot text: a header, then one canonical signature per line.
fn sema_sandbox_snapshot_text(snapshot: SemaPluginFrozenSnapshotInput, published_version: String) -> String Never! {
    version :: if published_version == "" -> "0.0.0" else -> published_version
    lines := [String]{"api_version = {SEMA_API_SNAPSHOT_VERSION}", "package = {snapshot.package}", "published_version = {version}"}
    loop frozen in snapshot.funcs -> &lines.push(frozen.signature)
    "{lines.join("\n")}\n"
}

// Decode `.api` snapshot text; None when it is not a version-3 snapshot.
fn sema_sandbox_parse_snapshot(text: String) -> SemaPluginFrozenSnapshotInput? {
    api_version := ""
    package := ""
    funcs := [SemaPluginFrozenExportInput]{}
    loop raw in text.split("\n") {
        line :: raw.trim()
        if line == "" -> next
        if line.starts_with("fn ") {
            head :: line.split("(").to_list()[0].split("<").to_list()[0]
            &funcs.push(SemaPluginFrozenExportInput{name: head.slice(3, head.len()).trim(), signature: line})
            next
        }
        parts :: line.split(" = ").to_list()
        if parts.len() != 2 -> return None
        if parts[0] == {
            "api_version" -> api_version = parts[1]
            "package" -> package = parts[1]
            "published_version" -> {}
            else -> return None
        }
    }
    if api_version != "{SEMA_API_SNAPSHOT_VERSION}" || package == "" -> return None
    Val(SemaPluginFrozenSnapshotInput{package: package, funcs: funcs})
}

// E1257 for each export the prior frozen interface
// names that is now removed or has a changed signature. Adding an export is
// always compatible, and no prior snapshot freezes the current interface.
fn sema_sandbox_freeze_diagnostics(current: SemaPluginFrozenSnapshotInput, prior: SemaPluginFrozenSnapshotInput?) -> [Diagnostic] Never! {
    diagnostics := [Diagnostic]{}
    frozen :: prior ?? return diagnostics
    loop old in frozen.funcs {
        found := false
        loop now in current.funcs {
            if now.name != old.name -> next
            found = true
            if now.signature != old.signature -> &diagnostics.push(sema_sandbox_version_diagnostic("export `{old.name}` changed from `{old.signature}` to `{now.signature}`"))
        }
        if !found -> &diagnostics.push(sema_sandbox_version_diagnostic("export `{old.name}` was removed"))
    }
    diagnostics
}

fn sema_sandbox_version_diagnostic(delta: String) -> Diagnostic Never! {
    sema_error_optional("E1257", None, "this sandbox's exported interface changed incompatibly", "a sandbox's frozen exported interface is the load-time contract (D-PLUGIN-VERSION1) — {delta}", "restore the removed/changed export, or accept this as an intentional breaking change (delete the stale snapshot under `.jet/cache/api/` to re-freeze)")
}
