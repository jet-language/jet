// Canonical declaration registration and module-graph preparation.
//
// This layer owns declaration identity and graph edges only. Type and TIR remain
// Foundation-owned; callable signatures are projected by Declarations.jet and
// defaults remain AST references keyed by FunctionDefaultRef.
use core.text as unicode
use jet_foundation.[
    AccessConvention,
    CORE_SOURCE_OWNED_ROWS,
    CallContractRow,
    CallablePolicy,
    CallablePolicyChain,
    ConstDef,
    Diagnostic,
    Dimension,
    DimensionAxis,
    EffectRowEntry,
    EnumDef,
    EnumGroup,
    Expr,
    ExternFn,
    Field,
    Func,
    FunctionCallMetadata,
    FunctionDefaultRef,
    ImplDef,
    ImportDecl,
    ImportedItem,
    InternalTag,
    Item,
    MIRSerdeCodec,
    MIRTraitRef,
    MIRTargetMachine,
    MIRTypedHeadKind,
    Marker,
    Measure,
    NamedSpan,
    NamedType,
    OperatorMarker,
    Param,
    ParamZone,
    Program,
    QuantityKind,
    SerdeWireShape,
    Span,
    StructDef,
    Symbol,
    SymbolID,
    SymbolKind,
    TagMarker,
    TExpr,
    TraitImplBlock,
    TraitMethodSig,
    Type,
    TypeIdentity,
    TypeParam,
    TypeTupleField,
    UnitFamilyDef,
    UnitRatio,
    UnitScaleProvenance,
    UserPolicyDecl,
    Variant,
    VariantPayload,
    ast_program,
    core_enum_payload_variants,
    core_enum_variant_payload,
    core_module_export,
    core_module_has_member,
    core_module_has_type,
    core_record_literal_fields,
    core_source_owns_type,
    expr_span,
    mir_builtin_codec_trait_ref,
    sema_reserved_type_name,
    symbol_id,
    type_identity,
    type_identity_key,
    type_name,
    type_with_effective_fn_returns,
    CModule,
    TCompilerBuiltin,
]
use jet_parser.[
    jfmt_decode_shapes,
    parse_generated_source,
]

JET_CANONICAL_EFFECT_PACKAGE_IDENTITY :: prep { "jet:canonical-prelude" }
JET_CANONICAL_EFFECT_MODULE_PATH :: prep { "Prelude/Effects.jet" }

enum SemaRegistrationNominalKind {
    Struct
    Enum
    Distinct
    TypeAlias
    Trait
    Tag
    UnitFamily
    ForeignHandle
}

struct SemaRegistrationForeignHandleFacts {
    library: String
    typedef_name: String
    jet_name: String
    ownership: String
    close: String
    close_source: String
    thread_safety: String
    send: Bool
    sync: Bool
    close_function_key: String?
    source_span: Span
}

enum SemaRegistrationNominalSource {
    SourceAST(value: Item)
    ForeignHandle(value: SemaRegistrationForeignHandleFacts)
    CompilerBuiltinTrait(value: MIRTraitRef)
}

struct SemaRegistrationUnitFact {
    name: String
    package: String
    family: String
    member: String
    dimension: Dimension?
    scale: UnitRatio
    scale_provenance: UnitScaleProvenance
    offset: UnitRatio
    kind: QuantityKind
}

fn sema_registration_compiler_owned_default_err_provenance() -> String Never! {
    "compiler_owned_default_err"
}

fn sema_registration_compiler_owned_enum_provenance() -> String Never! {
    "compiler_owned_enum"
}

fn sema_registration_unit_type_name(name: String) -> String Never! {
    output := ""
    loop piece in name.split("_") {
        if piece == "" -> next
        bytes := piece.bytes()
        if bytes.len() == 0 -> next
        code :: Int.from_u8(bytes[0])
        if code >= 97 && code <= 122 -> bytes[0] = U8{code - 32}
        output = "{output}{String.from_bytes(bytes) ?? piece}"
    }
    if output == "" -> name else -> output
}

fn sema_registration_unit_leaf_name(ty: Type) -> String? {
    if ty == {
        .Tagged(_, inner) -> return sema_registration_unit_leaf_name(inner)
        else -> {}
    }
    name :: if ty == {
        .Named(value) -> Val(value)
        .Apply(value, _) -> Val(value)
        else -> None
    }
    name_value :: name ?? return None
    parts :: name_value.split("::").to_list()
    if parts.len() == 0 -> return None
    Val(parts[parts.len() - 1])
}

fn sema_registration_unit_fact_push(facts: &[SemaRegistrationUnitFact], fact: SemaRegistrationUnitFact) Never! {
    loop existing in facts {
        if existing.name == fact.name -> return
    }
    &facts.push(fact)
}

fn sema_registration_unit_family_facts(definition: UnitFamilyDef, facts: &[SemaRegistrationUnitFact]) Never! {
    package :: definition.resolved_owner ?? return
    if definition.base == None && definition.resolved_dimension == None -> return
    has_offset_member :: loop member in definition.members {
        if member.offset.numerator != 0 -> break true
    } ?? false
    affine :: definition.base != None && has_offset_member
    loop member in definition.members {
        base_name :: sema_registration_unit_type_name(member.name)
        names :: if affine -> [String]{"{base_name}Point", "{base_name}Delta"} else -> [String]{base_name}
        kinds :: if affine -> [QuantityKind]{QuantityKind.Point, QuantityKind.Delta} else -> [QuantityKind]{QuantityKind.Linear}
        loop (index, name) in names {
            offset := UnitRatio{numerator: 0, denominator: 1}
            if kinds[index] == QuantityKind.Point -> offset = member.offset
            sema_registration_unit_fact_push(&facts, SemaRegistrationUnitFact{
                name: name,
                package: package,
                family: definition.family,
                member: member.name,
                dimension: definition.resolved_dimension,
                scale: member.scale,
                scale_provenance: member.scale_provenance,
                offset: offset,
                kind: kinds[index],
            })
        }
    }
}

// The nominal types a unit family declares, each at its member's name: one
// per member, or a `Point` and a `Delta` per member of an affine family.
fn sema_registration_unit_family_type_names(definition: UnitFamilyDef) -> [NamedSpan] Never! {
    has_offset_member :: loop member in definition.members {
        if member.offset.numerator != 0 -> break true
    } ?? false
    affine :: definition.base != None && has_offset_member
    names := [NamedSpan]{}
    loop member in definition.members {
        base_name :: sema_registration_unit_type_name(member.name)
        if affine {
            &names.push(NamedSpan{name: "{base_name}Point", span: member.name_span})
            &names.push(NamedSpan{name: "{base_name}Delta", span: member.name_span})
        } else {
            &names.push(NamedSpan{name: base_name, span: member.name_span})
        }
    }
    names
}

fn sema_registration_unit_facts(graph: SemaRegistrationGraph) -> [SemaRegistrationUnitFact] Never! {
    facts := [SemaRegistrationUnitFact]{}
    time_dimension :: Val(Dimension{axes: [DimensionAxis]{DimensionAxis{name: "core.units::Time", exponent: Measure.SignedLiteral{kind: "dimension", value: 1}}}})
    sema_registration_unit_fact_push(&facts, SemaRegistrationUnitFact{name: "Duration", package: "core.units", family: "Time", member: "ns", dimension: time_dimension, scale: UnitRatio{numerator: 1, denominator: 1}, scale_provenance: UnitScaleProvenance.Rational, offset: UnitRatio{numerator: 0, denominator: 1}, kind: QuantityKind.Delta})
    sema_registration_unit_fact_push(&facts, SemaRegistrationUnitFact{name: "Instant", package: "core.units", family: "Time", member: "ns", dimension: time_dimension, scale: UnitRatio{numerator: 1, denominator: 1}, scale_provenance: UnitScaleProvenance.Rational, offset: UnitRatio{numerator: 0, denominator: 1}, kind: QuantityKind.Point})
    loop module_row_index in 0..<graph.modules.len() {
        loop item_index in 0..<graph.modules[module_row_index].program.items.len() {
            if graph.modules[module_row_index].program.items[item_index] == {
                .UnitFamily(definition) -> sema_registration_unit_family_facts(definition, &facts)
                else -> {}
            }
        }
    }
    facts
}

// Rust unit_fact_for_type resolves a module-qualified name through its
// declaring module's registry, so the compiler-owned `Duration`/`Instant`
// time rows name only the bare built-in carriers: Core/time's source struct
// `<corelib>/...::Instant` is a nominal with Comparable/Equatable hooks, not
// the core.units point.
fn sema_registration_unit_fact_for_type(graph: SemaRegistrationGraph, ty: Type) -> SemaRegistrationUnitFact? {
    name :: sema_registration_unit_leaf_name(ty) ?? return None
    qualified :: sema_registration_unit_type_is_qualified(ty)
    loop fact_index in 0..<graph.unit_facts.len() {
        if graph.unit_facts[fact_index].name != name -> next
        if qualified && sema_registration_unit_fact_is_builtin_time(graph.unit_facts[fact_index]) -> next
        return Val(graph.unit_facts[fact_index])
    }
    None
}

fn sema_registration_unit_fact_is_builtin_time(fact: SemaRegistrationUnitFact) -> Bool Never! {
    fact.package == "core.units" && fact.family == "Time" && (fact.name == "Duration" || fact.name == "Instant")
}

fn sema_registration_unit_type_is_qualified(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(_, inner) -> sema_registration_unit_type_is_qualified(inner)
        .Named(value) | .Apply(value, _) -> value.contains("::")
        else -> false
    }
}

struct SemaRegistrationGenericParam {
    index: Int
    name: String
    bounds: [String]
    span: Span
    identity_key: String
}

struct SemaRegistrationParameter {
    index: Int
    symbol: Symbol
    ty: Type
    convention: AccessConvention
    zone: ParamZone
    public_label: String?
    variadic: Bool
    default: Expr?
    default_ref: FunctionDefaultRef?
}

struct SemaRegistrationCallableABI {
    is_extern: Bool
    is_c_abi: Bool
    c_abi_name: String?
    callback_transport: String?
    callback_plan_digest: String?
    callback_identity: String?
    foreign_effect_root: String?
}

enum SemaRegistrationForeignOwner {
    ExternRust
    CModule
}

struct SemaRegistrationForeignFunction {
    symbol: Symbol
