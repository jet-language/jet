    identity_key: String
    generic_params: [SemaRegistrationGenericParam]
    generic_identity_key: String
    parameters: [SemaRegistrationParameter]
    abi: SemaRegistrationCallableABI
    // The declared return stays raw for a protocol ABI trait-impl method.
    raw_protocol_return: Bool
}

struct SemaRegistrationField {
    symbol: Symbol
    ty: Type
    identity: TypeIdentity
    identity_key: String
    default: Expr?
    // The authenticated original default inferred in its declaration owner.
    checked_default: TExpr?{None}
    computed: Bool
}

