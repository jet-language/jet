}

struct SemaRegistrationAssociatedType {
    symbol: Symbol
    declaration: NamedType
    ty: Type
    identity: TypeIdentity
    identity_key: String
}

struct SemaRegistrationImpl {
    symbol: Symbol
    declaration: ImplDef
    source_module_identity: String
    source_package_identity: String
    target_module_identity: String?
    target_type_name: String
    target_type: Type
    target_identity: TypeIdentity
    target_identity_key: String
    trait_name: String?
    trait_symbol: Symbol?
    trait_identity: TypeIdentity?
    trait_span: Span?
    identity_key: String
    methods: [SemaRegistrationFunction]
    associated_type_impls: [NamedType]
    associated_types: [SemaRegistrationAssociatedType]
    delegation_field: String?
    compiler_generated: Bool
    operator_marker: OperatorMarker?
    operator_rhs: Type?
    target_os: String?
}

struct SemaRegistrationNominal {
    symbol: Symbol
    kind: SemaRegistrationNominalKind
    source: SemaRegistrationNominalSource
    ty: Type
    identity: TypeIdentity
    identity_key: String
    generic_params: [SemaRegistrationGenericParam]
    generic_identity_key: String
    fields: [SemaRegistrationField]
    variants: [SemaRegistrationVariant]
    methods: [SemaRegistrationFunction]
    trait_methods: [SemaRegistrationTraitMethod]
    // Compiler-owned rows are injected from facts rather than source syntax.
    // They remain real registration nominals so field/type identities are
    // available to every downstream consumer without pretending they are
    // foreign handles or user declarations.
    compiler_owned: Bool
    generated_provenance: String?
}

struct SemaRegistrationConstant {
    symbol: Symbol
    declaration: ConstDef
    ty: Type?
    identity_key: String
}

struct SemaRegistrationExport {
    name: String
    symbol: Symbol
    declaration: Item?
    source_module_identity: String
    visibility: Int
}

struct SemaRegistrationImportBinding {
    original: String
    local: String
    symbol: Symbol
    declaration: Item?
    target_module_identity: String
    // Resolved against this graph's fixed module order during registration;
    // Core namespace bindings may name a module that was not loaded.
    target_module_index: Int?
    visibility: Int
}

struct SemaRegistrationImport {
    source_module_identity: String
    source_package_identity: String
    target_module_identity: String
    target_package_identity: String
    declaration: ImportDecl
    visibility: Int
    bindings: [SemaRegistrationImportBinding]
}

struct SemaRegistrationModuleInput {
    package_identity: String
    module_identity: String
    module_name: String
    core_source_alias: String
    module_path: String
    source_file: String
    source_segments: [SemaSourceSegment]
    source_origin: SemaSourceOrigin
    program: Program
    foreign_handles: [SemaRegistrationForeignHandleFacts]
    // Filled by the loader: the package namespace of a member
    // file ("" outside one), the names it contributes in declaration order,
    // and the names of other members its source can reach.
    namespace: String{""}
    namespace_names: [String]{[String]{}}
    namespace_refs: [String]{[String]{}}
    // The module's source text (Rust `Module::source`). A declared text block
    // hands the text inside its braces to its rule.
    source: String{""}
}

struct SemaForeignImportBinding {
    scope: String?
    alias: String
}

struct SemaRegistrationImportEdge {
    source_module_identity: String
    source_scope: String{""}
    source_scope_exported: Bool{false}
    target_module_identity: String
    target_package_identity: String
    foreign_binding: SemaForeignImportBinding?
    declaration: ImportDecl
}

struct SemaRegistrationModule {
    package_identity: String
    module_identity: String
    module_name: String
    core_source_alias: String
    module_path: String
    source_file: String
    source_segments: [SemaSourceSegment]
    source_origin: SemaSourceOrigin
    program: Program
    inline_bindings: SemaInlinePreparedBindings{SemaInlinePreparedBindings{imports: [String:SemaInlineFunctionBinding]{}, modules: [SemaInlineModuleSurface]{}}}
    source: String{""}
    declarations: [Item]
    symbols: [Symbol]
    // Row `i` is the `nominals` row that `symbols[i]` registered (-1 for a
    // symbol without one). Names are unique per module, so this row is the
    // first registered row of the symbol's key: the row
    // `nominal_symbol_rows` answers for it. A resolved symbol carries it, so
    // the hot nominal-row lookups never search the long-key map.
    symbol_nominal_rows: [Int]{[Int]{}}
    symbol_positions: [String:Int]
    declaration_positions: [String:Int]
    impls: [SemaRegistrationImpl]
    functions: [SemaRegistrationFunction]
    foreign_functions: [SemaRegistrationForeignFunction]
    nominals: [SemaRegistrationNominal]
    constants: [SemaRegistrationConstant]
    // Symbol keys of the `#Persist`, mutable, and `#Static` constants
    // (sema_ownership_is_static_root), collected once at registration so a
    // function check reads them without walking the constant ASTs.
    static_roots: [String]{[String]{}}
    imports: [SemaRegistrationImport]
    exports: [SemaRegistrationExport]
    // Local import name -> its binding (Rust `Checker::imports`). Import
    // names are unique per module, so each name has one row.
    import_binding_rows: [String:SemaRegistrationImportBindingRef]{[String:SemaRegistrationImportBindingRef]{}}
    // `{type}:{trait}` for every trait impl among `declarations`, so auto-derive
    // metadata asks once per query instead of rescanning the declarations.
    declared_trait_impls: [String:Bool]
    // The module's package namespace (loader key, "" outside
    // one) and its `namespace_tables` slot (-1 outside one), what the loader
    // recorded for it, the position in `imports` where the package names
    // bind (before the foreign-provider imports, which register last; -1 =
    // after every import), whether every namespace name binds (items from a
    // template declared elsewhere), and the sibling declarations its scope
    // binds: (owner module, symbol row).
    namespace: String{""}
    namespace_slot: Int{-1}
    namespace_names: [String]{[String]{}}
    namespace_refs: [String]{[String]{}}
    namespace_import_split: Int{-1}
    namespace_full: Bool{false}
    namespace_bindings: [SemaRegistrationRowRef]{[SemaRegistrationRowRef]{}}
}

struct SemaRegistrationImportBindingRef {
    import_index: Int
    binding: Int
}

struct SemaRegistrationModuleResult {
    module_row: SemaRegistrationModule
    diagnostics: [Diagnostic]
    complete: Bool
}

// Host callbacks the checker calls into. Function values never copy and never
// cross a compiler thread, so they stay out of the registration graph (which
// compiler threads share): the driver hands them to each check pass, and a
// check reaches them through its context (SemaHostHookAccess).
// Pure compiler services the host installs. Each declares its empty effect
// row: an unbounded function value is the maximal row which would
// make every checker path that consults a hook reach every effect.
struct SemaRegistrationHostHooks {
    numeric_unit_conversion_exact: (fn(Float, String, String, String, String) -[]> Float?)?
    typed_boundary_literal_validate: (fn(MIRTypedHeadKind, [String]) -[]> String?)?
}

// The folded build snapshot the driver
// seeds before checking (Rust `BuildFactSnapshot`). Sema folds `$package.*`
// and `$build.*` reads from these values and never probes the host.
struct SemaBuildFacts {
    package_name: String
    package_version: String
    os: String
    profile: String
    stamp_git: String?
    stamp_dirty: Bool
    stamp_toolchain: String
    stamp_at: String
    // This compile produces a shipped artifact (`jet build`).
    artifact_build: Bool{false}
}

// `debug(…)` traces are development-only. A shipped artifact or a
// release-profile compile rejects any that remain (E3405).
fn sema_build_facts_reject_debug_traces(facts: SemaBuildFacts) -> Bool Never! {
    facts.artifact_build || facts.profile == "release" || facts.profile == "hardened"
}

// #4319 scaling counters (Tools/perf/scaling) of the graph's lookups: module
// rows by identity and names in a module's namespace. One counter set is
// shared by every copy of a graph; it counts only when the graph's
// `counting` is set, so an uncounted lookup costs one flag test.
struct SemaLookupCounters {
    module_lookups: Int
    name_lookups: Int
}

struct SemaRegistrationGraph {
    package_identity: String
    entry_module_identity: String
    canonical_effect_module_identity: String
    target_machine: MIRTargetMachine
    build_facts: SemaBuildFacts
    modules: [SemaRegistrationModule]
    // Module identity -> position in `modules`; fixed at graph construction.
    module_rows: [String:Int]
    edges: [SemaRegistrationImportEdge]
    foreign_providers: [SemaForeignProviderInput]
    core_builtin_owner_facts: [SemaRegistrationCoreBuiltinOwnerFact]
    imports: [SemaRegistrationImport]
    unit_facts: [SemaRegistrationUnitFact]
    // Output alias and callable references come from the same checked graph
    // resolution as their facts; finalization publishes them with body refs.
    output_name_references: [SemaNameReferenceFact]{[SemaNameReferenceFact]{}}
    lookup_counters: Shared<SemaLookupCounters>
    counting: Bool
    internal_problem: String?
    diagnostics: [Diagnostic]
    complete: Bool
    // Canonical callable SymbolId key -> first registered row, in the order
    // `sema_registration_callable_abi` searched before it was indexed.
    callable_rows: [String:SemaRegistrationCallableRow]
    // Base type name -> nominal rows (by `sema_expr_type_base_name`) and impl
    // rows (by `target_type_name`), in module/row order, so operator and
    // method dispatch read only the rows of their receiver type. A name maps
    // to its bucket slot; buckets grow in place (Rust `entry().or_default()`).
    nominal_row_slots: [String:Int]
    nominal_row_buckets: [[SemaRegistrationRowRef]]
    impl_row_slots: [String:Int]
    impl_row_buckets: [[SemaRegistrationRowRef]]
    // Nominal SymbolId key -> first registered nominal row. Kept current from
    // graph construction on: every nominal row pushed later (compiler
    // builtins, user templates, minted failure unions) is indexed as it lands.
    nominal_symbol_rows: [String:SemaRegistrationRowRef]
    // Compiler-owned nominal name (`Err`, `Ordering`, `RemoveBy`) -> its row.
    compiler_builtin_rows: [String:SemaRegistrationRowRef]{[String:SemaRegistrationRowRef]{}}
    // Resolved trait SymbolId key -> the impl rows implementing it, in
    // module/row order (Rust's keyed trait registry), built with the callable
    // index; a bound query before then (`impl_traits_indexed` false) scans
    // every impl.
    impl_trait_slots: [String:Int]{[String:Int]{}}
    impl_trait_buckets: [[SemaRegistrationRowRef]]{[[SemaRegistrationRowRef]]{}}
    impl_traits_indexed: Bool{false}
    // Spelled trait name (an impl's `trait_name`, and its registered trait
    // symbol's name) -> the impl rows under that name, in module/row order,
    // built with the trait index above. The copy-facts and close-owner
    // queries match impls by trait name (sema_copy_nominal_has_impl), so
    // they read one name's rows instead of every impl of the graph.
    impl_trait_name_slots: [String:Int]{[String:Int]{}}
    impl_trait_name_buckets: [[SemaRegistrationRowRef]]{[[SemaRegistrationRowRef]]{}}
    // Opaque impl type name -> the Core source modules that own its impls
    // (`sema_registration_source_owns_impl`), in module order. Built once with
    // the graph, so method lookup reads only the owning modules instead of
    // walking CORE_SOURCE_OWNED_ROWS for every module on every call.
    source_impl_owner_modules: [String:[Int]]{[String:[Int]]{}}
    // JET_KEEP_GOING, the compiler-internal diagnostic mode the driver sets
    // (its output is never shipped): a function whose body check fails is
    // kept as a typed trap of its declared signature instead of being left
    // out, so its callers and every later phase still run.
    keep_going: Bool{false}
    // Test mode (Rust `CompileMode::Test`/`TestOverride`), set by the driver:
    // named `#Test` bodies are checked and lowered as synthetic functions.
    test_mode: Bool{false}
    // One table per package namespace (Rust
    // `NameLedger::namespace_owner`): namespace -> slot, and per slot name ->
    // entry; entry -> declaring module and name. Entries are numbered in
    // module order, then declaration order.
    namespace_slots: [String:Int]{[String:Int]{}}
    namespace_tables: [[String:Int]]{[[String:Int]]{}}
    namespace_entries: [[Int]]{[[Int]]{}}
    namespace_entry_modules: [Int]{[Int]{}}
    namespace_entry_names: [String]{[String]{}}
    // `jet doc` (driver `JetDriverCompileMode.Doc`): finalization keeps each
    // module's settled program (derived impls, inferred failure contracts) in
    // `SemaGraphResult.programs`.
    retain_programs: Bool{false}
    // This rule demand (sema_serde_index_codec_methods): every generated
    // codec impl registers its header only. `codec_method_rows` maps each
    // generated codec method key to its impl row; `codec_demand` collects the
    // Encode/Decode requirements the checks reach (bound checks, codec calls,
    // nested wire fields), and `codec_wave_rows` ("{module}:{row}") names the
    // impls whose bodies the current codec wave checks (sema_codec_waves).
    codec_method_rows: [String:SemaRegistrationRowRef]{[String:SemaRegistrationRowRef]{}}
    codec_demand: Shared<SemaCodecDemand>
    codec_wave_rows: [String:Bool]{[String:Bool]{}}
}

struct SemaRegistrationRowRef {
    module_index: Int
    row: Int
}

// A registered callable addressed by position, so in-place row updates
// (failure-union return types) are read at lookup time.
enum SemaRegistrationCallableRow {
    Function(module_index: Int, row: Int)
    Foreign(module_index: Int, row: Int)
    NominalMethod(module_index: Int, owner: Int, row: Int)
    ImplMethod(module_index: Int, owner: Int, row: Int)
}

// A name resolved to its symbol. The declaration stays in the graph: a type
// symbol's row is `sema_type_graph_nominal_row`, so a lookup copies no item.
struct SemaRegistrationResolvedSymbol {
    symbol: Symbol
    source_module_identity: String
    target_module_identity: String
    visibility: Int
    // The symbol's registered nominal row when the lookup found it beside
    // the symbol (`symbol_nominal_rows`, a builtin row, a nominal row);
    // None leaves `sema_type_graph_resolved_nominal_row` to the key map.
    nominal_row: SemaRegistrationRowRef?{None}
}

fn sema_registration_visibility(is_pub: Bool, is_package_pub: Bool) -> Int Never! {
    if {
        is_pub -> 2
        is_package_pub -> 1
        else -> 0
    }
}

// The files of one manifest package share one namespace. A
// loose source root (the loader's `source-root:` identity) has none: each
// loose file keeps its private names to itself.
fn sema_registration_package_is_namespace(package_identity: String) -> Bool Never! {
    package_identity != "" && !package_identity.starts_with("source-root:")
}

fn sema_registration_visible(visibility: Int, source_module: String, source_package: String, owner_module: String, owner_package: String) -> Bool Never! {
    if {
        source_module == owner_module -> true
        source_module.starts_with("<corelib>/") && owner_module.starts_with("<corelib>/") -> true
        visibility >= 2 -> true
        source_package != owner_package -> false
        else -> visibility >= 1 || sema_registration_package_is_namespace(owner_package)
    }
}

fn sema_registration_identity_key(module_identity: String, ty: Type) -> String Never! {
    "{module_identity}:{type_identity_key(ty)}"
}

fn sema_registration_function_identity_key(module_identity: String, owner_key: String, signature: Type) -> String Never! {
    if owner_key == "" -> sema_registration_identity_key(module_identity, signature) else -> "{module_identity}:{owner_key}:{type_identity_key(signature)}"
}

fn sema_registration_generic_identity(owner_key: String, params: [SemaRegistrationGenericParam]) -> String Never! {
    if params.len() == 0 -> return owner_key.copy()
    parts :: loop parameter in params -> {
        bound :: parameter.bounds.join("+")
        "{parameter.index}:{parameter.name}[{bound}]"
    }
    "{owner_key}<{parts.join(",")}>"
}

fn sema_registration_generic_params(type_params: [TypeParam], owner_key: String, diagnostics: &[Diagnostic]) -> [SemaRegistrationGenericParam] {
    params := [SemaRegistrationGenericParam]{}
    loop (index, parameter) in type_params {
        // `<prep N: Int>` parses into `TypeParam.prep`, but
        // number-parameter substitution, instance identity and layout belong
        // to card #3505. Until they land, the parameter is rejected here, the
        // one registration entry for function, method, struct, enum and alias
        // generics, and never registered as a type parameter.
        if parameter.prep != None {
            &diagnostics.push(sema_error("E0390", parameter.name_span, "`{parameter.name}` is a compile-time number parameter, which this compiler does not support yet", "`<prep N: Int>` is the ratified declaration grammar, but number-parameter substitution, instance identity and layout are not implemented", "use a type parameter, or pass the number as an ordinary argument or field until number parameters ship"))
            next
        }
        duplicate :: loop previous in params {
            if previous.name == parameter.name -> break true
        } ?? false
        if duplicate {
            &diagnostics.push(sema_defined_twice(parameter.name, "generic parameter names must be unique", parameter.name_span))
        }
        bound_key :: parameter.bounds.join("+")
        &params.push(SemaRegistrationGenericParam{
            index: index,
            name: parameter.name,
            bounds: parameter.bounds,
            span: parameter.name_span,
            identity_key: "{owner_key}<{index}:{parameter.name}[{bound_key}]>",
        })
    }
    params
}

fn sema_registration_type_is_fn(ty: Type) -> Bool Never! {
    if ty == {
        .Fn(_, _, _, _, _, _) -> true
        else -> false
    }
}

// Keep this predicate at the ABI boundary: callback transport is determined
// from the effective, instantiated parameter type, not the source spelling.
// In particular, the internal C++ marker is authoritative and user tags are
// never treated as a callback ABI.
fn sema_registration_callback_boundary_param(abi: SemaRegistrationCallableABI, effective_type: Type) -> Bool Never! {
    if effective_type == {
        .Tagged(marker, inner) -> {
            if marker == (TagMarker.Internal{internal_tag: InternalTag.CppCallbackABI}) && sema_registration_type_is_fn(inner) -> return true
        }
        else -> {}
    }
    abi.is_c_abi && sema_registration_type_is_fn(effective_type)
}

fn sema_registration_inline_foreign_effect_root(language: String) -> String Never! {
    if language == {
        "c" -> "FFI.C"
        "asm" -> "FFI.Asm"
        "cpp" -> "FFI.Cpp"
        else -> "FFI.{language}"
    }
}

fn sema_registration_callable_abi_for_func(func: Func) -> SemaRegistrationCallableABI Never! {
    foreign_effect_root :: func.inline_foreign.map((foreign) -> sema_registration_inline_foreign_effect_root(foreign.lang))
    SemaRegistrationCallableABI{
        is_extern: func.inline_foreign != None,
        is_c_abi: false,
        c_abi_name: None,
        callback_transport: None,
        callback_plan_digest: None,
        callback_identity: None,
        foreign_effect_root: foreign_effect_root,
    }
}

fn sema_registration_callable_abi_for_extern(function: ExternFn, owner: SemaRegistrationForeignOwner) -> SemaRegistrationCallableABI Never! {
    c_abi_name :: function.abi.map((abi) -> abi.name)
    SemaRegistrationCallableABI{
        is_extern: true,
        is_c_abi: owner == SemaRegistrationForeignOwner.CModule,
        c_abi_name: c_abi_name,
        callback_transport: function.callback_transport,
        callback_plan_digest: function.callback_plan_digest,
        callback_identity: function.callback_identity,
        foreign_effect_root: function.effect_root,
    }
}

fn sema_registration_extern_contract(params: [Param]) -> [CallContractRow]? {
    contract := [CallContractRow]{}
    has_contract := false
    loop parameter in params {
        implicit_local_label :: parameter.zone == ParamZone.Either && parameter.public_label == None
        label :: if {
            parameter.zone == ParamZone.PositionalOnly || implicit_local_label -> ""
            else -> parameter.public_label.map((public_label) -> public_label.name) ?? parameter.name
        }
        &contract.push(CallContractRow{label: label, zone: parameter.zone})
        if label != "" || parameter.zone != ParamZone.Either -> has_contract = true
    }
    if has_contract -> Val(contract) else -> None
}

fn sema_registration_extern_signature(function: ExternFn) -> Type Never! {
    params := [Type]{}
    names := [String]{}
    defaults := [FunctionDefaultRef?]{}
    variadic := [Bool]{}
    conventions := [AccessConvention]{}
    loop parameter_index in 0..<function.params.len() {
        ty :: function.params[parameter_index].ty
        if function.params[parameter_index].variadic -> &params.push(Type.List{element: ty}) else -> &params.push(ty)
        &names.push(function.params[parameter_index].name)
        &defaults.push(None)
        &variadic.push(function.params[parameter_index].variadic)
        &conventions.push(function.params[parameter_index].convention)
    }
    metadata :: FunctionCallMetadata{
        names: names,
        defaults: defaults,
        variadic: variadic,
        conventions: conventions,
        policies: CallablePolicyChain{policies: [CallablePolicy]{}},
    }
    Type.Fn{params: params, ret: Val(sema_effective_return_type(function.return_type)), effect_bound: None, param_contract: sema_registration_extern_contract(function.params), call_metadata: Val(metadata), return_view_provenance: None}
}

fn sema_registration_extern_parameters(function: ExternFn, module_identity: String, owner: SymbolID, signature: Type) -> [SemaRegistrationParameter] Never! {
    parameters := [SemaRegistrationParameter]{}
    loop (index, parameter) in function.params {
        parameter_ty :: if parameter.variadic -> Type.List{element: parameter.ty} else -> parameter.ty
        &parameters.push(SemaRegistrationParameter{
            index: index,
            symbol: Symbol{
                id: symbol_id(SymbolKind.Parameter, module_identity, owner.key, parameter.name),
                kind: SymbolKind.Parameter,
                name: parameter.name,
                module_name: module_identity,
                owner: Val(owner.key),
                span: parameter.name_span,
                ty: Val(parameter_ty),
                visibility: 0,
            },
            ty: parameter_ty,
            convention: parameter.convention,
            zone: parameter.zone,
            public_label: sema_registration_parameter_label(parameter),
            variadic: parameter.variadic,
            default: None,
            default_ref: None,
        })
    }
    parameters
}

fn sema_registration_function_signature(func: Func, raw_protocol_return: Bool, owner: SymbolID, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> Type {
    projected :: sema_function_symbol_type(func, raw_protocol_return, owner, fallback_source_file, fallback_source_origin, source_segments)
    if func.declared_effects == None -> return projected
    if projected == {
        .Fn(params, ret, _, contract, metadata, provenance) -> Type.Fn{params: params, ret: ret, effect_bound: func.declared_effects, param_contract: contract, call_metadata: metadata, return_view_provenance: provenance}
        else -> projected
    }
}

fn sema_registration_parameter_label(parameter: Param) -> String? {
    if parameter.public_label == .Val(public_label) -> return Val(public_label.name)
    if parameter.zone == {
        .PositionalOnly | .Either -> None
        else -> Val(parameter.name)
    }
}

fn sema_registration_signature_metadata(signature: Type) -> FunctionCallMetadata? {
    if signature == {
        // copy: `metadata` is a payload of read parameter `signature`, which keeps the original; the returned value owns this one
        .Fn(_, _, _, _, metadata, _) -> metadata.copy()
        else -> None
    }
}

fn sema_registration_function_parameters(func: Func, module_identity: String, owner: SymbolID, signature: Type) -> [SemaRegistrationParameter] Never! {
    defaults :: sema_registration_signature_metadata(signature).map((row) -> row.defaults) ?? [FunctionDefaultRef?]{}
    parameters := [SemaRegistrationParameter]{}
    loop (index, parameter) in func.params {
        ty :: type_with_effective_fn_returns(parameter.ty)
        parameter_ty :: if parameter.variadic -> Type.List{element: ty} else -> ty
        default_ref :: if index < defaults.len() -> defaults[index] else -> None
        &parameters.push(SemaRegistrationParameter{
            index: index,
            symbol: Symbol{
                id: symbol_id(SymbolKind.Parameter, module_identity, owner.key, parameter.name),
                kind: SymbolKind.Parameter,
                name: parameter.name,
                module_name: module_identity,
                owner: Val(owner.key),
                span: parameter.name_span,
                ty: Val(parameter_ty),
                visibility: 0,
            },
            ty: parameter_ty,
            convention: parameter.convention,
            zone: parameter.zone,
            public_label: sema_registration_parameter_label(parameter),
            variadic: parameter.variadic,
            default: parameter.default,
            default_ref: default_ref,
        })
    }
    parameters
}

fn sema_registration_function(func: Func, raw_protocol_return: Bool, module_identity: String, owner: SymbolID?, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment], diagnostics: &[Diagnostic]) -> SemaRegistrationFunction {
    owner_key :: owner.map((value) -> value.key) ?? ""
    id_owner :: owner_key
    symbol_kind :: SymbolKind.Function
    symbol_id_value :: symbol_id(symbol_kind, module_identity, id_owner, func.name)
    signature :: sema_registration_function_signature(func, raw_protocol_return, symbol_id_value, fallback_source_file, fallback_source_origin, source_segments)
    visibility :: sema_registration_visibility(func.is_pub, func.is_package_pub)
    symbol :: Symbol{
        id: symbol_id_value,
        kind: symbol_kind,
        name: func.name,
        module_name: module_identity,
        owner: owner.map((value) -> value.key),
        span: func.name_span,
        ty: Val(signature),
        visibility: visibility,
    }
    generic_params :: sema_registration_generic_params(func.type_params, symbol.id.key, &diagnostics)
    generic_identity_key :: sema_registration_generic_identity(symbol.id.key, generic_params)
    abi :: sema_registration_callable_abi_for_func(func)
    parameters :: sema_registration_function_parameters(func, module_identity, symbol.id, signature)
    metadata :: sema_registration_signature_metadata(signature)
    if metadata == .Val(row) {
        loop (index, parameter) in func.params {
            if parameter.default != None && (index >= row.defaults.len() || row.defaults[index] == None) {
                &diagnostics.push(sema_error("E0003", expr_span(parameter.default ?? Expr.Unit{span: parameter.name_span}), "a callable default has no stable source identity", "default expressions are resolved by their owning declaration, parameter index, and span", "preserve the declaration's FunctionDefaultRef metadata"))
            }
        }
    }
    SemaRegistrationFunction{
        symbol: symbol,
        // copy: the function row owns its declaration; the program keeps its item.
        declaration: func.copy(),
        signature: signature,
        identity: type_identity(signature),
        identity_key: sema_registration_function_identity_key(module_identity, owner_key, signature),
        generic_params: generic_params,
        generic_identity_key: generic_identity_key,
        parameters: parameters,
        abi: abi,
        raw_protocol_return: raw_protocol_return,
    }
}

fn sema_registration_foreign_visibility(owner: SemaRegistrationForeignOwner) -> Int Never! {
    if owner == SemaRegistrationForeignOwner.CModule -> 2 else -> 0
}

fn sema_registration_foreign_function(function: ExternFn, module_identity: String, owner: SemaRegistrationForeignOwner, foreign_library: String, foreign_library_span: Span) -> SemaRegistrationForeignFunction Never! {
    signature :: sema_registration_extern_signature(function)
    // Foreign declarations are module-level: no owner segment in the id.
    symbol :: Symbol{
        id: symbol_id(SymbolKind.Function, module_identity, "", function.name),
        kind: SymbolKind.Function,
        name: function.name,
        module_name: module_identity,
        owner: None,
        span: function.name_span,
        ty: Val(signature),
        visibility: sema_registration_foreign_visibility(owner),
    }
    parameters :: sema_registration_extern_parameters(function, module_identity, symbol.id, signature)
    SemaRegistrationForeignFunction{
        symbol: symbol,
        declaration: function,
        owner: owner,
        foreign_library: foreign_library,
        foreign_library_span: foreign_library_span,
        identity: type_identity(signature),
        identity_key: sema_registration_function_identity_key(module_identity, "", signature),
        generic_params: [SemaRegistrationGenericParam]{},
        generic_identity_key: symbol.id.key,
        parameters: parameters,
        abi: sema_registration_callable_abi_for_extern(function, owner),
    }
}

// The sole ABI lookup surface is keyed by the canonical SymbolId. Missing
// rows mean the target is unknown; callers must not manufacture a false ABI.
fn sema_registration_callable_abi(graph: SemaRegistrationGraph, target: SymbolID) -> SemaRegistrationCallableABI? {
    row :: graph.callable_rows.get(target.key) ?? return None
    if row == {
        .Function(module_index, index) -> Val(graph.modules[module_index].functions[index].abi)
        .Foreign(module_index, index) -> Val(graph.modules[module_index].foreign_functions[index].abi)
        .NominalMethod(module_index, owner, index) -> Val(graph.modules[module_index].nominals[owner].methods[index].abi)
        .ImplMethod(module_index, owner, index) -> Val(graph.modules[module_index].impls[owner].methods[index].abi)
    }
}

// The Jet declaration of the callable registered under `target`, through
// `callable_rows` (Rust `funcs.get` / `registry.method`): one keyed lookup
// instead of a scan of every module's callables. Foreign rows have none.
fn sema_registration_callable_declaration(graph: SemaRegistrationGraph, target: SymbolID) -> Func? {
    row :: graph.callable_rows.get(target.key) ?? return None
    if row == {
        .Function(module_index, index) -> Val(graph.modules[module_index].functions[index].declaration)
        .Foreign(_, _) -> None
        .NominalMethod(module_index, owner, index) -> Val(graph.modules[module_index].nominals[owner].methods[index].declaration)
        .ImplMethod(module_index, owner, index) -> Val(graph.modules[module_index].impls[owner].methods[index].declaration)
    }
}

// Records the first registered row of each nominal SymbolId key in
// `module_index` from `first_row` on, and appends the rows' base-name
// buckets. Rows only append, so a key already present keeps its earlier row.
fn sema_registration_index_nominal_rows(graph: &SemaRegistrationGraph, module_index: Int, first_row: Int) Never! {
    loop row in first_row..<graph.modules[module_index].nominals.len() {
        key :: graph.modules[module_index].nominals[row].symbol.id.key.copy()
        if graph.nominal_symbol_rows.get(key) == None -> &graph.nominal_symbol_rows.add(key, SemaRegistrationRowRef{module_index: module_index, row: row}).drop("checked absent above")
    }
    sema_registration_index_nominal_names(&graph, module_index, first_row)
}

// Appends the base-name rows of `module_index`'s nominals from `first_row` on.
fn sema_registration_index_nominal_names(graph: &SemaRegistrationGraph, module_index: Int, first_row: Int) Never! {
    loop row in first_row..<graph.modules[module_index].nominals.len() {
        name :: sema_expr_type_base_name(graph.modules[module_index].nominals[row].ty) ?? next
        reference :: SemaRegistrationRowRef{module_index: module_index, row: row}
        if graph.nominal_row_slots.get(name) == .Val(slot) {
            &graph.nominal_row_buckets[slot].push(reference)
        } else {
            graph.nominal_row_slots[name] = graph.nominal_row_buckets.len()
            &graph.nominal_row_buckets.push([SemaRegistrationRowRef]{reference})
        }
    }
}

// The nominal rows registered under base type name `name`, in module/row order.
fn sema_registration_nominal_rows_named(graph: SemaRegistrationGraph, name: String) -> [SemaRegistrationRowRef] {
    slot :: graph.nominal_row_slots.get(name) ?? return [SemaRegistrationRowRef]{}
    graph.nominal_row_buckets[slot]
}

// The impl rows registered under target type name `name`, in module/row order.
fn sema_registration_impl_rows_named(graph: SemaRegistrationGraph, name: String) -> [SemaRegistrationRowRef] {
    slot :: graph.impl_row_slots.get(name) ?? return [SemaRegistrationRowRef]{}
    graph.impl_row_buckets[slot]
}

// A Map is a sorted entry list: a whole-graph map filled in module/row order
// shifts every later entry on each insert (O(N^2) over the graph). The graph
// indexes below are built from rows merge-sorted once by (key, order), so
// every insert appends and each key's first registered row wins as before.
struct SemaRegistrationKeyedRow {
    key: String
    // Registration order: module, then row.
    order: Int
    reference: SemaRegistrationRowRef
}

struct SemaRegistrationKeyedCallable {
    key: String
    order: Int
    row: SemaRegistrationCallableRow
}

fn sema_registration_keyed_row_push(rows: &[SemaRegistrationKeyedRow], key: String, module_index: Int, row: Int) Never! {
    order :: rows.len()
    // copy: the index rows are sorted on their own; the graph keeps its rows.
    &rows.push(SemaRegistrationKeyedRow{key: key.copy(), order: order, reference: SemaRegistrationRowRef{module_index: module_index, row: row}})
}

fn sema_registration_keyed_rows_sort(rows: &[SemaRegistrationKeyedRow]) Never! {
    rows = loop fresh_item in rows -> fresh_item
    &rows.sort_by((left: SemaRegistrationKeyedRow, right: SemaRegistrationKeyedRow) -> (left.key <=> right.key).then(left.order <=> right.order))
}

struct SemaRegistrationBuckets {
    slots: [String:Int]
    buckets: [[SemaRegistrationRowRef]]
}

// Buckets sorted keyed rows by key: one slot per key, in ascending key
// order, each bucket in registration order.
fn sema_registration_bucket_sorted_rows(rows: [SemaRegistrationKeyedRow]) -> SemaRegistrationBuckets Never! {
    slots := [String:Int]{}
    buckets := [[SemaRegistrationRowRef]]{}
    loop at in 0..<rows.len() {
        if at == 0 || rows[at - 1].key != rows[at].key {
            slots[rows[at].key] = buckets.len()
            &buckets.push([SemaRegistrationRowRef]{rows[at].reference})
        } else {
            last :: buckets.len() - 1
            &buckets[last].push(rows[at].reference)
        }
    }
    SemaRegistrationBuckets{slots: ^slots, buckets: ^buckets}
}

// Graph construction: every module's nominal SymbolId rows (the first row of
// a key wins) and base-name buckets, in one sorted build each. Later rows
// append through `sema_registration_index_nominal_rows`.
fn sema_registration_index_all_nominal_rows(graph: &SemaRegistrationGraph) Never! {
    symbol_rows := [SemaRegistrationKeyedRow]{}
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].nominals.len() -> sema_registration_keyed_row_push(&symbol_rows, graph.modules[module_index].nominals[row].symbol.id.key, module_index, row)
    }
    sema_registration_keyed_rows_sort(&symbol_rows)
    loop at in 0..<symbol_rows.len() {
        if at == 0 || symbol_rows[at - 1].key != symbol_rows[at].key -> graph.nominal_symbol_rows[symbol_rows[at].key] = symbol_rows[at].reference
    }
    sema_registration_index_all_nominal_names(&graph)
}

fn sema_registration_index_all_nominal_names(graph: &SemaRegistrationGraph) Never! {
    name_rows := [SemaRegistrationKeyedRow]{}
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].nominals.len() {
            name :: sema_expr_type_base_name(graph.modules[module_index].nominals[row].ty) ?? next
            sema_registration_keyed_row_push(&name_rows, name, module_index, row)
        }
    }
    sema_registration_keyed_rows_sort(&name_rows)
    named := sema_registration_bucket_sorted_rows(name_rows)
    graph.nominal_row_slots = ^named.slots
    graph.nominal_row_buckets = ^named.buckets
}

// Registration adds no callable or impl after the graph is prepared; later
// edits replace rows in place, so the first-match positions stay exact. The
// base-name buckets are rebuilt here, each in module/row order; nominal rows
// pushed afterwards (minted failure unions) append through
// `sema_registration_index_nominal_rows`.
fn sema_registration_index_callables(graph: &SemaRegistrationGraph) Never! {
    callables := [SemaRegistrationKeyedCallable]{}
    loop (module_index, module_row) in graph.modules {
        loop (index, function) in module_row.functions -> sema_registration_keyed_callable_push(&callables, function.symbol.id.key, SemaRegistrationCallableRow.Function{module_index: module_index, row: index})
        loop (index, function) in module_row.foreign_functions -> sema_registration_keyed_callable_push(&callables, function.symbol.id.key, SemaRegistrationCallableRow.Foreign{module_index: module_index, row: index})
        loop (owner, nominal) in module_row.nominals {
            loop (index, method) in nominal.methods -> sema_registration_keyed_callable_push(&callables, method.symbol.id.key, SemaRegistrationCallableRow.NominalMethod{module_index: module_index, owner: owner, row: index})
        }
        loop (owner, implementation) in module_row.impls {
            loop (index, method) in implementation.methods -> sema_registration_keyed_callable_push(&callables, method.symbol.id.key, SemaRegistrationCallableRow.ImplMethod{module_index: module_index, owner: owner, row: index})
        }
    }
    &callables.sort_by((left: SemaRegistrationKeyedCallable, right: SemaRegistrationKeyedCallable) -> (left.key <=> right.key).then(left.order <=> right.order))
    rows := [String:SemaRegistrationCallableRow]{}
    loop at in 0..<callables.len() {
        if at == 0 || callables[at - 1].key != callables[at].key -> rows[callables[at].key] = callables[at].row
    }
    graph.callable_rows = rows
    sema_registration_index_all_nominal_names(&graph)
    impl_rows := [SemaRegistrationKeyedRow]{}
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].impls.len() -> sema_registration_keyed_row_push(&impl_rows, graph.modules[module_index].impls[row].target_type_name, module_index, row)
    }
    sema_registration_keyed_rows_sort(&impl_rows)
    targets := sema_registration_bucket_sorted_rows(impl_rows)
    graph.impl_row_slots = ^targets.slots
    graph.impl_row_buckets = ^targets.buckets
}

fn sema_registration_keyed_callable_push(rows: &[SemaRegistrationKeyedCallable], key: String, row: SemaRegistrationCallableRow) Never! {
    order :: rows.len()
    // copy: the index rows are sorted on their own; the graph keeps its callables.
    &rows.push(SemaRegistrationKeyedCallable{key: key.copy(), order: order, row: row})
}

// Buckets every impl under the trait it implements (Rust's keyed trait
// registry), in module/row order. An inherent impl or an unresolved trait
// name matches no bound, so it has no bucket.
fn sema_registration_index_impl_traits(graph: &SemaRegistrationGraph) {
    graph.impl_trait_slots = [String:Int]{}
    graph.impl_trait_buckets = [[SemaRegistrationRowRef]]{}
    graph.impl_trait_name_slots = [String:Int]{}
    graph.impl_trait_name_buckets = [[SemaRegistrationRowRef]]{}
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].impls.len() {
            reference :: SemaRegistrationRowRef{module_index: module_index, row: row}
            // By spelled name: the declared trait name and the registered
            // trait symbol's name, once when both spell the same name. The
            // names are copied out first: the push edits the graph.
            declared_name := String?{None}
            if graph.modules[module_index].impls[row].trait_name == .Val(declared) -> declared_name = Val(declared.copy())
            symbol_name := String?{None}
            if graph.modules[module_index].impls[row].trait_symbol == .Val(trait_symbol) -> symbol_name = Val(trait_symbol.name.copy())
            if declared_name == .Val(name) -> sema_registration_impl_trait_name_push(&graph, name, reference)
            if symbol_name == .Val(name) {
                if declared_name != Val((name)) -> sema_registration_impl_trait_name_push(&graph, name, reference)
            }
            trait_key :: sema_type_graph_impl_trait_key(graph, graph.modules[module_index].impls[row]) ?? next
            if graph.impl_trait_slots.get(trait_key) == .Val(slot) {
                &graph.impl_trait_buckets[slot].push(reference)
            } else {
                graph.impl_trait_slots[trait_key] = graph.impl_trait_buckets.len()
                &graph.impl_trait_buckets.push([SemaRegistrationRowRef]{reference})
            }
        }
    }
    graph.impl_traits_indexed = true
}

fn sema_registration_impl_trait_name_push(graph: &SemaRegistrationGraph, trait_name: String, reference: SemaRegistrationRowRef) Never! {
    if graph.impl_trait_name_slots.get(trait_name) == .Val(slot) {
        &graph.impl_trait_name_buckets[slot].push(reference)
    } else {
        graph.impl_trait_name_slots[trait_name] = graph.impl_trait_name_buckets.len()
        &graph.impl_trait_name_buckets.push([SemaRegistrationRowRef]{reference})
    }
}

fn sema_registration_named_symbol(module_identity: String, name: String, span: Span, kind: SymbolKind, ty: Type?, is_pub: Bool, is_package_pub: Bool) -> Symbol Never! {
    Symbol{
        id: symbol_id(kind, module_identity, "", name),
        kind: kind,
        name: name,
        module_name: module_identity,
        owner: None,
        span: span,
        ty: ty,
        visibility: sema_registration_visibility(is_pub, is_package_pub),
    }
}

fn sema_registration_nominal_type(name: String, type_params: [TypeParam]) -> Type Never! {
    if type_params.len() == 0 -> return Type.Named{name: name}
    args :: loop parameter in type_params -> Type.Named{name: parameter.name}
    Type.Apply{name: name, args: args}
}

fn sema_registration_variant_type(payload: VariantPayload) -> Type? {
    if payload == {
        .Unit -> Val(Type.Named{name: "Unit"})
        // copy: `ty` is a payload of read parameter `payload`, which keeps the original; the Val carrier owns this one
        .Single(ty, _) -> Val(ty.copy())
        .Named(fields) -> {
            rows :: loop field in fields -> TypeTupleField{name: field.name, ty: field.ty}
            Val(Type.Tuple{fields: rows})
        }
    }
}

fn sema_registration_struct_fields(definition: StructDef, owner: Symbol, diagnostics: &[Diagnostic]) -> [SemaRegistrationField] {
    fields := [SemaRegistrationField]{}
    seen := [String:Bool]{}
    loop field_index in 0..<definition.fields.len() {
        duplicate :: seen.get(definition.fields[field_index].name) != None
        seen[definition.fields[field_index].name] = true
        if duplicate {
            &diagnostics.push(sema_defined_twice(definition.fields[field_index].name, "fields in one nominal declaration share one namespace", definition.fields[field_index].name_span))
        }
        field_id :: symbol_id(SymbolKind.Field, owner.module_name, owner.id.key, definition.fields[field_index].name)
        field_symbol :: Symbol{
            id: field_id,
            kind: SymbolKind.Field,
            name: definition.fields[field_index].name,
            module_name: owner.module_name,
            owner: Val(owner.id.key),
            span: definition.fields[field_index].name_span,
            ty: Val(definition.fields[field_index].ty),
            visibility: sema_registration_visibility(definition.fields[field_index].is_pub, definition.fields[field_index].is_package_pub),
        }
        &fields.push(SemaRegistrationField{
            symbol: field_symbol,
            ty: definition.fields[field_index].ty,
            identity: type_identity(definition.fields[field_index].ty),
            identity_key: "{owner.id.key}:{definition.fields[field_index].name}:{type_identity_key(definition.fields[field_index].ty)}",
            default: definition.fields[field_index].default,
            computed: definition.fields[field_index].computed != None,
        })
    }
    fields
}

fn sema_registration_enum_variants(definition: EnumDef, owner: Symbol, diagnostics: &[Diagnostic]) -> [SemaRegistrationVariant] {
    variants := [SemaRegistrationVariant]{}
    seen := [String:Bool]{}
    loop variant_index in 0..<definition.variants.len() {
        duplicate :: seen.get(definition.variants[variant_index].name) != None
        seen[definition.variants[variant_index].name] = true
        if duplicate {
            &diagnostics.push(sema_defined_twice(definition.variants[variant_index].name, "variants in one enum declaration share one namespace", definition.variants[variant_index].name_span))
        }
        payload_ty :: sema_registration_variant_type(definition.variants[variant_index].payload)
        variant_symbol :: Symbol{
            id: symbol_id(SymbolKind.Variant, owner.module_name, owner.id.key, definition.variants[variant_index].name),
            kind: SymbolKind.Variant,
            name: definition.variants[variant_index].name,
            module_name: owner.module_name,
            owner: Val(owner.id.key),
            span: definition.variants[variant_index].name_span,
            ty: payload_ty,
            visibility: owner.visibility,
        }
        payload_key :: payload_ty.map((value) -> type_identity_key(value)) ?? "Unit"
        &variants.push(SemaRegistrationVariant{
            symbol: variant_symbol,
            payload: definition.variants[variant_index].payload,
            payload_type: payload_ty,
            identity_key: "{owner.id.key}:{definition.variants[variant_index].name}:{payload_key}",
        })
    }
    variants
}

fn sema_registration_trait_method_signature(method: TraitMethodSig, raw_protocol_return: Bool, owner: SymbolID, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> Type {
    params := [Type]{}
    names := [String]{}
    defaults := [FunctionDefaultRef?]{}
    variadic := [Bool]{}
    conventions := [AccessConvention]{}
    contract := [CallContractRow]{}
    has_contract := false
    loop (index, parameter) in method.params {
        ty :: type_with_effective_fn_returns(parameter.ty)
        if parameter.variadic -> &params.push(Type.List{element: ty}) else -> &params.push(ty)
        &names.push(parameter.name)
        &variadic.push(parameter.variadic)
        &conventions.push(parameter.convention)
        label :: if {
            parameter.zone == ParamZone.PositionalOnly -> ""
            parameter.zone == ParamZone.Either && parameter.public_label == None -> ""
            else -> parameter.public_label.map((public_label) -> public_label.name) ?? parameter.name
        }
        &contract.push(CallContractRow{label: label, zone: parameter.zone})
        if label != "" || parameter.zone != ParamZone.Either -> has_contract = true
        if parameter.default == {
            .Val(expression) -> &defaults.push(Val(FunctionDefaultRef{source_file: sema_source_file_at(source_segments, fallback_source_file, fallback_source_origin, expr_span(expression)), owner_key: owner.key, parameter_index: index, span: expr_span(expression)}))
            .None -> &defaults.push(None)
        }
    }
    return_type :: sema_checked_return_type(method.return_type, raw_protocol_return)
    effect_bound :: if {
        method.declared_effects != None -> method.declared_effects
        method.is_pure -> Val([EffectRowEntry]{})
        else -> None
    }
    param_contract :: if has_contract -> Val(contract) else -> None
    metadata :: Val(FunctionCallMetadata{names: names, defaults: defaults, variadic: variadic, conventions: conventions, policies: CallablePolicyChain{policies: [CallablePolicy]{}}})
    Type.Fn{params: params, ret: Val(return_type), effect_bound: effect_bound, param_contract: param_contract, call_metadata: metadata, return_view_provenance: method.return_view_provenance}
}

fn sema_registration_trait_method(method: TraitMethodSig, module_identity: String, owner: Symbol, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> SemaRegistrationTraitMethod {
    id :: symbol_id(SymbolKind.Function, module_identity, owner.id.key, method.name)
    // A protocol ABI trait's own method signature is raw at dispatch, as in
    // the Rust reference's trait-bound and trait-object method calls.
    signature :: sema_registration_trait_method_signature(method, sema_raw_protocol_trait(Val(owner.name)), id, fallback_source_file, fallback_source_origin, source_segments)
    parameters := [SemaRegistrationParameter]{}
    metadata :: sema_registration_signature_metadata(signature) ?? FunctionCallMetadata{names: [String]{}, defaults: [FunctionDefaultRef?]{}, variadic: [Bool]{}, conventions: [AccessConvention]{}, policies: CallablePolicyChain{policies: [CallablePolicy]{}}}
    loop (index, parameter) in method.params {
        ty :: type_with_effective_fn_returns(parameter.ty)
        parameter_ty :: if parameter.variadic -> Type.List{element: ty} else -> ty
        default_ref :: if index < metadata.defaults.len() -> metadata.defaults[index] else -> None
        &parameters.push(SemaRegistrationParameter{
            index: index,
            symbol: Symbol{id: symbol_id(SymbolKind.Parameter, module_identity, id.key, parameter.name), kind: SymbolKind.Parameter, name: parameter.name, module_name: module_identity, owner: Val(id.key), span: parameter.name_span, ty: Val(parameter_ty), visibility: 0},
            ty: parameter_ty,
            convention: parameter.convention,
            zone: parameter.zone,
            public_label: sema_registration_parameter_label(parameter),
            variadic: parameter.variadic,
            default: parameter.default,
            default_ref: default_ref,
        })
    }
    symbol :: Symbol{id: id, kind: SymbolKind.Function, name: method.name, module_name: module_identity, owner: Val(owner.id.key), span: method.name_span, ty: Val(signature), visibility: owner.visibility}
    SemaRegistrationTraitMethod{symbol: symbol, declaration: method, signature: signature, identity: type_identity(signature), identity_key: sema_registration_function_identity_key(module_identity, owner.id.key, signature), parameters: parameters}
}

// Hook callable identity is the operand pair, not the ordinary owner/name key.
fn sema_registration_operator_owner(owner: SymbolID, module_identity: String, left: Type, trait_name: String?, rhs: Type?) -> SymbolID Never! {
    // copy: the operator owner is a new owned SymbolID. With no trait it equals `owner`, the
    // caller's declaring symbol (a read parameter), which the caller keeps.
    trait_value :: trait_name ?? return owner.copy()
    // copy: the operator owner is a new owned SymbolID. For an unchecked trait it equals `owner`,
    // the caller's declaring symbol (a read parameter), which the caller keeps.
    if !sema_checked_operator_trait(trait_value) -> return owner.copy()
    right :: rhs ?? left
    symbol_id(SymbolKind.Impl, module_identity, owner.key, "{type_name(left)}::{trait_value}<{type_name(right)}>")
}

fn sema_registration_nominal(item: Item, module_identity: String, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment], diagnostics: &[Diagnostic]) -> SemaRegistrationNominal? {
    if item == {
        .Struct(definition) -> {
            ty :: sema_registration_nominal_type(definition.name, definition.type_params)
            symbol :: sema_registration_named_symbol(module_identity, definition.name, definition.name_span, SymbolKind.Type, Val(ty), definition.is_pub, definition.is_package_pub)
            generic_params :: sema_registration_generic_params(definition.type_params, symbol.id.key, &diagnostics)
            generic_identity_key :: sema_registration_generic_identity(symbol.id.key, generic_params)
            methods := [SemaRegistrationFunction]{}
            loop method in definition.methods -> &methods.push(sema_registration_function(method, false, module_identity, Val(symbol.id), fallback_source_file, fallback_source_origin, source_segments, &diagnostics))
            trait_methods :: [SemaRegistrationTraitMethod]{}
            loop block in definition.trait_impls {
                loop method in block.methods {
                    hook_owner :: sema_registration_operator_owner(symbol.id, module_identity, ty, Val(block.trait_name), block.operator_rhs)
                    &methods.push(sema_registration_function(method, sema_raw_protocol_function_return(Val(block.trait_name), block.compiler_generated, method), module_identity, Val(hook_owner), fallback_source_file, fallback_source_origin, source_segments, &diagnostics))
                }
            }
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.Struct, source: SemaRegistrationNominalSource.SourceAST{value: item}, ty: ty, identity: type_identity(ty), identity_key: sema_registration_identity_key(module_identity, ty), generic_params: generic_params, generic_identity_key: generic_identity_key, fields: sema_registration_struct_fields(definition, symbol, &diagnostics), variants: [SemaRegistrationVariant]{}, methods: methods, trait_methods: trait_methods, compiler_owned: definition.compiler_builtin_error, generated_provenance: if definition.compiler_builtin_error -> Val(sema_registration_compiler_owned_default_err_provenance()) else -> None})
        }
        .Enum(definition) -> {
            ty :: sema_registration_nominal_type(definition.name, definition.type_params)
            symbol :: sema_registration_named_symbol(module_identity, definition.name, definition.name_span, SymbolKind.Type, Val(ty), definition.is_pub, definition.is_package_pub)
            generic_params :: sema_registration_generic_params(definition.type_params, symbol.id.key, &diagnostics)
            generic_identity_key :: sema_registration_generic_identity(symbol.id.key, generic_params)
            methods := [SemaRegistrationFunction]{}
            loop method in definition.methods -> &methods.push(sema_registration_function(method, false, module_identity, Val(symbol.id), fallback_source_file, fallback_source_origin, source_segments, &diagnostics))
            trait_methods :: [SemaRegistrationTraitMethod]{}
            loop block in definition.trait_impls {
                loop method in block.methods {
                    hook_owner :: sema_registration_operator_owner(symbol.id, module_identity, ty, Val(block.trait_name), block.operator_rhs)
                    &methods.push(sema_registration_function(method, sema_raw_protocol_function_return(Val(block.trait_name), block.compiler_generated, method), module_identity, Val(hook_owner), fallback_source_file, fallback_source_origin, source_segments, &diagnostics))
                }
            }
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.Enum, source: SemaRegistrationNominalSource.SourceAST{value: item}, ty: ty, identity: type_identity(ty), identity_key: sema_registration_identity_key(module_identity, ty), generic_params: generic_params, generic_identity_key: generic_identity_key, fields: [SemaRegistrationField]{}, variants: sema_registration_enum_variants(definition, symbol, &diagnostics), methods: methods, trait_methods: trait_methods, compiler_owned: false, generated_provenance: None})
        }
        .Distinct(definition) -> {
            ty :: Type.Named{name: definition.name}
            symbol :: sema_registration_named_symbol(module_identity, definition.name, definition.name_span, SymbolKind.Type, Val(ty), definition.is_pub, definition.is_package_pub)
            generic_params :: [SemaRegistrationGenericParam]{}
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.Distinct, source: SemaRegistrationNominalSource.SourceAST{value: item}, ty: ty, identity: type_identity(ty), identity_key: sema_registration_identity_key(module_identity, ty), generic_params: generic_params, generic_identity_key: symbol.id.key, fields: [SemaRegistrationField]{}, variants: [SemaRegistrationVariant]{}, methods: [SemaRegistrationFunction]{}, trait_methods: [SemaRegistrationTraitMethod]{}, compiler_owned: false, generated_provenance: None})
        }
        .TypeAlias(definition) -> {
            ty :: sema_registration_nominal_type(definition.name, definition.type_params)
            symbol :: sema_registration_named_symbol(module_identity, definition.name, definition.name_span, SymbolKind.Type, Val(ty), definition.is_pub, definition.is_package_pub)
            generic_params :: sema_registration_generic_params(definition.type_params, symbol.id.key, &diagnostics)
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.TypeAlias, source: SemaRegistrationNominalSource.SourceAST{value: item}, ty: ty, identity: type_identity(ty), identity_key: sema_registration_identity_key(module_identity, ty), generic_params: generic_params, generic_identity_key: sema_registration_generic_identity(symbol.id.key, generic_params), fields: [SemaRegistrationField]{}, variants: [SemaRegistrationVariant]{}, methods: [SemaRegistrationFunction]{}, trait_methods: [SemaRegistrationTraitMethod]{}, compiler_owned: false, generated_provenance: None})
        }
        .Trait(definition) -> {
            ty :: Type.Named{name: definition.name}
            symbol :: sema_registration_named_symbol(module_identity, definition.name, definition.name_span, SymbolKind.Trait, None, definition.is_pub, definition.is_package_pub)
            trait_methods :: loop method in definition.methods -> sema_registration_trait_method(method, module_identity, symbol, fallback_source_file, fallback_source_origin, source_segments)
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.Trait, source: SemaRegistrationNominalSource.SourceAST{value: item}, ty: ty, identity: type_identity(ty), identity_key: sema_registration_identity_key(module_identity, ty), generic_params: [SemaRegistrationGenericParam]{}, generic_identity_key: symbol.id.key, fields: [SemaRegistrationField]{}, variants: [SemaRegistrationVariant]{}, methods: [SemaRegistrationFunction]{}, trait_methods: trait_methods, compiler_owned: false, generated_provenance: None})
        }
        .Tag(definition) -> {
            ty :: Type.Named{name: definition.name}
            symbol :: sema_registration_named_symbol(module_identity, definition.name, definition.name_span, SymbolKind.Type, Val(ty), definition.is_pub, definition.is_package_pub)
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.Tag, source: SemaRegistrationNominalSource.SourceAST{value: item}, ty: ty, identity: type_identity(ty), identity_key: sema_registration_identity_key(module_identity, ty), generic_params: [SemaRegistrationGenericParam]{}, generic_identity_key: symbol.id.key, fields: [SemaRegistrationField]{}, variants: [SemaRegistrationVariant]{}, methods: [SemaRegistrationFunction]{}, trait_methods: [SemaRegistrationTraitMethod]{}, compiler_owned: false, generated_provenance: None})
        }
        .UnitFamily(definition) -> {
            ty :: Type.Named{name: definition.family}
            symbol :: sema_registration_named_symbol(module_identity, definition.family, definition.family_span, SymbolKind.Type, Val(ty), definition.is_pub, definition.is_package_pub)
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.UnitFamily, source: SemaRegistrationNominalSource.SourceAST{value: item}, ty: ty, identity: type_identity(ty), identity_key: sema_registration_identity_key(module_identity, ty), generic_params: [SemaRegistrationGenericParam]{}, generic_identity_key: symbol.id.key, fields: [SemaRegistrationField]{}, variants: [SemaRegistrationVariant]{}, methods: [SemaRegistrationFunction]{}, trait_methods: [SemaRegistrationTraitMethod]{}, compiler_owned: false, generated_provenance: None})
        }
        else -> None
    }
}

fn sema_registration_original_error_module(diagnostics: &[Diagnostic]) -> SemaRegistrationModuleInput? {
    // Only this exact embedded original parse can mint the DefaultErr marker.
    parsed := parse_generated_source(SEMA_PRELUDE_ERROR_SOURCE.bytes())
    loop diagnostic in parsed.diagnostics -> &diagnostics.push(diagnostic)
    if sema_has_error_since(parsed.diagnostics, 0) -> return None
    program := ^parsed.program
    declarations := [Item]{}
    marked := 0
    loop program.items.len() > 0 {
        item := &program.items.pop() ?? panic("the original Prelude item drain lost a row")
        if ^item == .Struct(source_definition) {
            definition := ^source_definition
            if definition.name == "Err" {
                definition.compiler_builtin_error = true
                marked += 1
            }
            &declarations.push(Item.Struct{value: ^definition})
        }
    }
    if declarations.len() != 7 || marked != 1 {
        &diagnostics.push(sema_error_optional("E0003", None, "the original Prelude error source is incomplete", "the canonical supplier owns seven ordinary declarations and exactly one marked default error", "regenerate the embedded original Prelude source from its canonical authority"))
        return None
    }
    &declarations.reverse()
    program.items = ^declarations
    path :: SEMA_PRELUDE_ERROR_SOURCE_PATH
    bytes :: SEMA_PRELUDE_ERROR_SOURCE.bytes()
    line_starts := [Int]{0}
    loop index in 0..<bytes.len() {
        if bytes[index] == (U8{10}) -> &line_starts.push(index + 1)
    }
    Val(SemaRegistrationModuleInput{
        package_identity: "jet:canonical-prelude",
        module_identity: path,
        module_name: sema_inline_generated_path(path),
        core_source_alias: "",
        module_path: "Prelude/Errors.jet",
        source_file: path,
        source_segments: [SemaSourceSegment]{SemaSourceSegment{generated: Span{start: 0, end: bytes.len()}, source_file: path, source_start: 0, line_starts: ^line_starts, origin: SemaSourceOrigin.CompilerGenerated}},
        source_origin: SemaSourceOrigin.CompilerGenerated,
        program: ^program,
        foreign_handles: [SemaRegistrationForeignHandleFacts]{},
        source: SEMA_PRELUDE_ERROR_SOURCE,
    })
}

// Rust `Prelude::retain_error_prelude_module`: a graph whose inputs already
// retain the original error module (the driver loads it as a source module)
// keeps that one owner after checking its source context; otherwise the
// original module is appended once. An input holding the original path or
// alias without the parsed provenance is refused rather than trusted.
fn sema_registration_retain_original_error_module(inputs: &[SemaRegistrationModuleInput], diagnostics: &[Diagnostic]) {
    path :: SEMA_PRELUDE_ERROR_SOURCE_PATH
    alias :: sema_inline_generated_path(path)
    owners := 0
    loop input in inputs {
        retained := false
        loop item in input.program.items {
            if item == .Struct(definition) && definition.compiler_builtin_error -> retained = true
        }
        if !retained -> next
        owners += 1
        if owners > 1 {
            &diagnostics.push(sema_registration_error_supplier_diagnostic("original Prelude declarations have multiple owners"))
            return
        }
        if input.source_file != path || input.package_identity != JET_CANONICAL_EFFECT_PACKAGE_IDENTITY || input.source != SEMA_PRELUDE_ERROR_SOURCE || input.module_name != alias {
            &diagnostics.push(sema_registration_error_supplier_diagnostic("original Prelude provenance lost its source context"))
            return
        }
    }
    if owners == 1 -> return
    loop input in inputs {
        if input.source_file == path || input.module_identity == path || input.module_name == alias {
            &diagnostics.push(sema_registration_error_supplier_diagnostic("an existing source collides with the original Prelude identity"))
            return
        }
    }
    original :: sema_registration_original_error_module(&diagnostics) ?? return
    &inputs.push(original)
}

fn sema_registration_error_supplier_diagnostic(detail: String) -> Diagnostic {
    sema_error_optional("E0003", None, detail, "default-error declarations retain their original compiler-private source owner", "retain the canonical Prelude source and its parsed declaration provenance")
}

fn sema_registration_compiler_owned_codec_trait(module_identity: String, reference: MIRTraitRef) -> SemaRegistrationNominal {
    span :: Span{start: 0, end: 0}
    ty :: Type.Named{name: reference.name}
    symbol :: sema_registration_named_symbol(module_identity, reference.name, span, SymbolKind.Trait, None, true, false)
    SemaRegistrationNominal{
        symbol: symbol,
        kind: SemaRegistrationNominalKind.Trait,
        source: SemaRegistrationNominalSource.CompilerBuiltinTrait{value: reference},
        ty: ty,
        identity: type_identity(ty),
        identity_key: sema_registration_identity_key(module_identity, ty),
        generic_params: [SemaRegistrationGenericParam]{},
        generic_identity_key: symbol.id.key,
        fields: [SemaRegistrationField]{},
        variants: [SemaRegistrationVariant]{},
        methods: [SemaRegistrationFunction]{},
        trait_methods: [SemaRegistrationTraitMethod]{},
        compiler_owned: true,
        generated_provenance: None,
    }
}

fn sema_registration_is_compiler_owned(nominal: SemaRegistrationNominal) -> Bool Never! {
    nominal.compiler_owned
}

// Compiler-owned enum rows keep their bare canonical identity across modules.
// Runtime enums (`Ordering`, `RemoveBy`, `TaskFailure`) and artifact-declared
// reflection enums share this checked nominal path; runtime ownership is
// decided independently by the emitter's native carrier registry.
fn sema_registration_is_compiler_owned_enum(nominal: SemaRegistrationNominal) -> Bool Never! {
    nominal.compiler_owned && nominal.generated_provenance == (Val(sema_registration_compiler_owned_enum_provenance()))
}

// Canonical unit menus come from the runtime or reflection sema oracle;
// TaskFailure payloads come from the Core enum rows.
fn sema_registration_compiler_owned_enum_variants(name: String) -> [Variant]? {
    span :: Span{start: 0, end: 0}
    names := sema_compiler_enum_variants(name) ?? sema_fact_enum_variants(name) ?? [String]{}
    unit_menu :: names.len() > 0
    if !unit_menu {
        if name != "TaskFailure" -> return None
        names = core_enum_payload_variants(name) ?? return None
    }
    variants := [Variant]{}
    loop variant_name in names {
        payload := VariantPayload.Unit
        if !unit_menu {
            payload_types :: core_enum_variant_payload(name, variant_name) ?? return None
            if payload_types.len() > 1 -> return None
            if payload_types.len() == 1 -> payload = VariantPayload.Single{ty: payload_types[0], span: span}
        }
        &variants.push(Variant{name: variant_name, name_span: span, payload: payload, discriminant: None, discriminant_expr: None, serde_markers: [Marker]{}})
    }
    Val(variants)
}

fn sema_registration_compiler_owned_enum(module_identity: String, name: String, variants: [Variant]) -> SemaRegistrationNominal {
    span :: Span{start: 0, end: 0}
    definition :: EnumDef{
        span: span,
        is_pub: true,
        is_package_pub: false,
        name: name,
        name_span: span,
        type_params: [TypeParam]{},
        variants: variants,
        methods: [Func]{},
        trait_impls: [TraitImplBlock]{},
        derives: [NamedSpan]{},
        auto_derive_default: false,
        is_single_use: false,
        single_use_span: None,
        is_must_use: false,
        must_use_span: None,
        serde_markers: [Marker]{},
        type_markers: [Marker]{},
        groups: [EnumGroup]{},
    }
    ty :: Type.Named{name: name}
    symbol :: sema_registration_named_symbol(module_identity, name, span, SymbolKind.Type, Val(ty), true, false)
    diagnostics := [Diagnostic]{}
    SemaRegistrationNominal{
        symbol: symbol,
        kind: SemaRegistrationNominalKind.Enum,
        source: SemaRegistrationNominalSource.SourceAST{value: Item.Enum{value: definition}},
        ty: ty,
        identity: type_identity(ty),
        identity_key: sema_registration_identity_key(module_identity, ty),
        generic_params: [SemaRegistrationGenericParam]{},
        generic_identity_key: symbol.id.key,
        fields: [SemaRegistrationField]{},
        variants: sema_registration_enum_variants(definition, symbol, &diagnostics),
        methods: [SemaRegistrationFunction]{},
        trait_methods: [SemaRegistrationTraitMethod]{},
        compiler_owned: true,
        generated_provenance: Val(sema_registration_compiler_owned_enum_provenance()),
    }
}

fn sema_registration_foreign_handle_nominal(facts: SemaRegistrationForeignHandleFacts, module_identity: String, diagnostics: &[Diagnostic]) -> SemaRegistrationNominal? {
    if facts.library == "" || facts.typedef_name == "" || facts.jet_name == "" || facts.ownership == "" || facts.close == "" || (facts.close_source != "conventional" && facts.close_source != "overlay") || (facts.thread_safety != "unspecified" && facts.thread_safety != "safe" && facts.thread_safety != "unsafe") {
        &diagnostics.push(sema_error("E3216", facts.source_span, "foreign handle registration facts are incomplete", "an opaque native handle needs its library, typedef, Jet identity, ownership, close provenance, and thread-safety facts before type checking", "retain the complete approved C binding metadata"))
        return None
    }
    ty :: Type.Named{name: facts.jet_name}
    symbol :: sema_registration_named_symbol(module_identity, facts.jet_name, facts.source_span, SymbolKind.Type, Val(ty), true, false)
    Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.ForeignHandle, source: SemaRegistrationNominalSource.ForeignHandle{value: facts}, ty: ty, identity: type_identity(ty), identity_key: sema_registration_identity_key(module_identity, ty), generic_params: [SemaRegistrationGenericParam]{}, generic_identity_key: symbol.id.key, fields: [SemaRegistrationField]{}, variants: [SemaRegistrationVariant]{}, methods: [SemaRegistrationFunction]{}, trait_methods: [SemaRegistrationTraitMethod]{}, compiler_owned: false, generated_provenance: None})
}

fn sema_registration_nominal_source_item(source: SemaRegistrationNominalSource) -> Item? {
    if source == {
        // copy: `value` is a payload of read parameter `source`, which keeps the original; the Val carrier owns this one
        .SourceAST(value) -> Val(value.copy())
        .ForeignHandle(_) | .CompilerBuiltinTrait(_) -> None
    }
}

fn sema_registration_root_name(item: Item) -> String Never! {
    if item == {
        .Func(value) -> value.name
        .Struct(value) -> value.name
        .Enum(value) -> value.name
        .Distinct(value) -> value.name
        .TypeAlias(value) -> value.name
        .Trait(value) -> value.name
        .Tag(value) -> value.name
        .UnitFamily(value) -> value.family
        .Const(value) -> value.name
        .Module(value) -> value.name
        .CodeModule(value) -> value.name
        .GenericModule(value) -> value.name
        .ModuleAlias(value) -> value.name
        else -> ""
    }
}

fn sema_registration_root_span(item: Item) -> Span Never! {
    if item == {
        .Func(value) -> value.name_span
        .Struct(value) -> value.name_span
        .Enum(value) -> value.name_span
        .Distinct(value) -> value.name_span
        .TypeAlias(value) -> value.name_span
        .Trait(value) -> value.name_span
        .Tag(value) -> value.name_span
        .UnitFamily(value) -> value.family_span
        .Const(value) -> value.name_span
        .Module(value) -> value.name_span
        .CodeModule(value) -> value.name_span
        .GenericModule(value) -> value.name_span
        .ModuleAlias(value) -> value.name_span
        else -> Span{start: 0, end: 0}
    }
}

fn sema_registration_root_symbol(item: Item, module_identity: String, source_file: String, source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment], diagnostics: &[Diagnostic]) -> Symbol? {
    if item == {
        .Func(value) -> Val(sema_registration_function(value, false, module_identity, None, source_file, source_origin, source_segments, &diagnostics).symbol)
        .Struct(value) -> Val(sema_registration_named_symbol(module_identity, value.name, value.name_span, SymbolKind.Type, Val(sema_registration_nominal_type(value.name, value.type_params)), value.is_pub, value.is_package_pub))
        .Enum(value) -> Val(sema_registration_named_symbol(module_identity, value.name, value.name_span, SymbolKind.Type, Val(sema_registration_nominal_type(value.name, value.type_params)), value.is_pub, value.is_package_pub))
        .Distinct(value) -> Val(sema_registration_named_symbol(module_identity, value.name, value.name_span, SymbolKind.Type, Val(Type.Named{name: value.name}), value.is_pub, value.is_package_pub))
        .TypeAlias(value) -> Val(sema_registration_named_symbol(module_identity, value.name, value.name_span, SymbolKind.Type, Val(sema_registration_nominal_type(value.name, value.type_params)), value.is_pub, value.is_package_pub))
        .Trait(value) -> Val(sema_registration_named_symbol(module_identity, value.name, value.name_span, SymbolKind.Trait, None, value.is_pub, value.is_package_pub))
        .Tag(value) -> Val(sema_registration_named_symbol(module_identity, value.name, value.name_span, SymbolKind.Type, Val(Type.Named{name: value.name}), value.is_pub, value.is_package_pub))
        .UnitFamily(value) -> Val(sema_registration_named_symbol(module_identity, value.family, value.family_span, SymbolKind.Type, Val(Type.Named{name: value.family}), value.is_pub, value.is_package_pub))
        .Const(value) -> Val(sema_registration_named_symbol(module_identity, value.name, value.name_span, SymbolKind.Constant, value.ty, value.is_pub, value.is_package_pub))
        .Module(value) -> Val(sema_registration_named_symbol(module_identity, value.name, value.name_span, SymbolKind.Module, None, false, false))
        .CodeModule(value) -> Val(sema_registration_named_symbol(module_identity, value.name, value.name_span, SymbolKind.Module, None, value.is_pub, value.is_package_pub))
        .GenericModule(value) -> Val(sema_registration_named_symbol(module_identity, value.name, value.name_span, SymbolKind.Module, None, value.is_pub, value.is_package_pub))
        .ModuleAlias(value) -> Val(sema_registration_named_symbol(module_identity, value.name, value.name_span, SymbolKind.Module, None, value.is_pub, value.is_package_pub))
        else -> None
    }
}

fn sema_registration_module_has_name(module_row: SemaRegistrationModule, name: String) -> Bool Never! {
    module_row.symbol_positions.get(name) != None
}

fn sema_registration_module_has_import_name(module_row: SemaRegistrationModule, name: String) -> Bool Never! {
    module_row.import_binding_rows.get(name) != None
}

fn sema_registration_push_import_binding(graph: &SemaRegistrationGraph, module_index: Int, import_index: Int, binding: SemaRegistrationImportBinding) Never! {
    if graph.modules[module_index].import_binding_rows.get(binding.local) == None {
        graph.modules[module_index].import_binding_rows[binding.local] = SemaRegistrationImportBindingRef{import_index: import_index, binding: graph.modules[module_index].imports[import_index].bindings.len()}
    }
    &graph.modules[module_index].imports[import_index].bindings.push(binding)
}

fn sema_registration_add_foreign_functions(module_row: &SemaRegistrationModule, functions: [ExternFn], owner: SemaRegistrationForeignOwner, foreign_library: String, foreign_library_span: Span, diagnostics: &[Diagnostic]) -> Bool {
    complete := true
    loop function in functions {
        if sema_registration_module_has_name(module_row, function.name) {
            &diagnostics.push(sema_defined_twice(function.name, "module declarations share one namespace", function.name_span))
            complete = false
            next
        }
        registered :: sema_registration_foreign_function(function, module_row.module_identity, owner, foreign_library, foreign_library_span)
        module_row.symbol_positions[registered.symbol.name] = module_row.symbols.len()
        &module_row.symbols.push(registered.symbol)
        &module_row.symbol_nominal_rows.push(-1)
        &module_row.foreign_functions.push(registered)
    }
    complete
}

fn sema_registration_add_root(module_row: &SemaRegistrationModule, item: Item, source_file: String, source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment], diagnostics: &[Diagnostic]) -> Bool {
    if item == {
        .ExternRust(block) -> {
            complete :: sema_registration_add_foreign_functions(&module_row, block.functions, SemaRegistrationForeignOwner.ExternRust, block.crate_spec, block.crate_span, &diagnostics)
            sema_registration_push_declaration(&module_row, item)
            return complete
        }
        .CModule(block) -> {
            complete :: sema_registration_add_foreign_functions(&module_row, block.functions, SemaRegistrationForeignOwner.CModule, block.lib, block.path_span, &diagnostics)
            sema_registration_push_declaration(&module_row, item)
            return complete
        }
        // A body-less `module name` declares a file module the loader
        // binds as the synthetic file import aliased `name` (Rust `load_file`);
        // that import owns the name, so the declaration adds no second symbol.
        .CodeModule(definition) -> if definition.body == None {
            sema_registration_push_declaration(&module_row, item)
            return true
        }
        else -> {}
    }
    name :: sema_registration_root_name(item)
    if name == "" -> return true
    if !sema_registration_reserved_type_rule(module_row, item, name, &diagnostics) -> return false
    if sema_registration_module_has_name(module_row, name) {
        &diagnostics.push(sema_defined_twice(name, "module declarations share one namespace", sema_registration_root_span(item)))
        return false
    }
    if !sema_registration_value_type_rules(module_row, item, &diagnostics) -> return false
    function :: if item == {
        .Func(value) -> Val(sema_registration_function(value, false, module_row.module_identity, None, source_file, source_origin, source_segments, &diagnostics))
        else -> None
    }
    symbol :: if function == {
        // copy: the symbol table and the function row each own the symbol.
        Val(value) -> value.symbol.copy()
        None -> sema_registration_root_symbol(item, module_row.module_identity, source_file, source_origin, source_segments, &diagnostics) ?? return false
    }
    nominal :: sema_registration_nominal(item, module_row.module_identity, source_file, source_origin, source_segments, &diagnostics)
    module_row.symbol_positions[name] = module_row.symbols.len()
    module_row.declaration_positions[name] = module_row.declarations.len()
    &module_row.symbols.push(symbol)
    &module_row.symbol_nominal_rows.push(if nominal != None -> module_row.nominals.len() else -> -1)
    sema_registration_push_declaration(&module_row, item)
    if function == .Val(value) -> &module_row.functions.push(value)
    if nominal == .Val(value) -> &module_row.nominals.push(value)
    if item == {
        .Const(value) -> {
            if sema_ownership_is_static_root(value) -> &module_row.static_roots.push(symbol.id.key)
            &module_row.constants.push(SemaRegistrationConstant{symbol: symbol, declaration: value, ty: value.ty, identity_key: "{module_row.module_identity}:{value.name}"})
        }
        else -> {}
    }
    true
}

fn sema_registration_push_declaration(module_row: &SemaRegistrationModule, item: Item) Never! {
    if item == .Impl(definition) {
        if definition.trait_name == .Val(trait_name) -> module_row.declared_trait_impls[sema_type_metadata_impl_key(definition.type_name, trait_name)] = true
    }
    // copy: the declaration registry owns its item; the program keeps its own.
    &module_row.declarations.push(item.copy())
}

// E0106: the Rust reference's `register_struct`/`register_enum`/
// `register_distinct`/`register_type_alias` reject a built-in type name
// before the declaration registers.
fn sema_registration_reserved_type_rule(module_row: SemaRegistrationModule, item: Item, name: String, diagnostics: &[Diagnostic]) -> Bool {
    kind :: if item == {
        .Struct(_) -> "struct"
        .Enum(_) -> "enum"
        .Distinct(_) -> "distinct type"
        .TypeAlias(_) -> "type alias"
        else -> ""
    }
    if kind == "" || !sema_reserved_type_name(name) -> return true
    // `item` is the loaded declaration; canonical identity supplies the exact
    // source path and name from CORE_SOURCE_OWNED_TYPES, never the export superset.
    if core_source_owns_type("{module_row.module_identity}::{name}") -> return true
    &diagnostics.push(sema_error("E0106", sema_registration_root_span(item), "the name `{name}` is built in and can't be redefined", "`{name}` is provided by the language itself", "choose a different name for this {kind}"))
    false
}

// The registration rules of the Rust
// reference's `register_distinct` and `register_type_alias`. A distinct
// built on a distinct declared earlier (E0129) and an alias without type
// parameters (E0324) are not registered; a range constraint on a base other
// than `Int` is reported and the type still registers.
fn sema_registration_value_type_rules(module_row: SemaRegistrationModule, item: Item, diagnostics: &[Diagnostic]) -> Bool {
    if item == {
        .Distinct(definition) -> {
            if definition.base == .Named(base_name) {
                loop nominal_index in 0..<module_row.nominals.len() {
                    if module_row.nominals[nominal_index].kind == SemaRegistrationNominalKind.Distinct && module_row.nominals[nominal_index].symbol.name == base_name {
                        &diagnostics.push(sema_error("E0129", definition.base_span, "`{definition.name}` can't be built on `{base_name}` — `{base_name}` is itself a distinct type", "`distinct`-over-`distinct` chaining is not allowed in v1; `{base_name}` is already a distinct type", "use `{base_name}` directly, or build on the shared base type"))
                        return false
                    }
                }
            }
            if definition.range == .Val(range) {
                if definition.base != Type.Int {
                    &diagnostics.push(sema_error("E0003", range.span, "a range constraint only works on `Int`, but `{definition.name}` is {sema_type_show(definition.base)}", "`distinct Base(lo..hi)` provably bounds a whole-number value", "use `distinct Int({range.lo}..{range.hi})`, or drop the range"))
                }
            }
        }
        .TypeAlias(definition) -> {
            if definition.type_params.len() == 0 && !(definition.target == .Named(_)) {
                &diagnostics.push(sema_error("E0324", definition.name_span, "a type alias needs type parameters — write `alias Name<T> :: …`", "transparent `alias` is only for shortening generic spellings", "for a distinct type name over a primitive, use `struct Name(BaseType)` instead"))
                return false
            }
        }
        else -> {}
    }
    true
}

// Indexed reads keep each candidate row in place; a two-name walk over the
// rows copies the whole list on every lookup.
fn sema_registration_impl_nominal_index(module_row: SemaRegistrationModule, type_name: String) -> Int Never! {
    loop index in 0..<module_row.nominals.len() {
        if module_row.nominals[index].symbol.name == type_name -> return index
    }
    -1
}

// The nominal rows an impl registration looks up, built once per module
// while its nominals are fixed: `nominals` is the first nominal row of each
// type name (sema_registration_impl_nominal_index's answer) and `traits`
// the first Trait-kind nominal row of each name.
struct SemaRegistrationImplRows {
    nominals: [String:Int]
    traits: [String:Int]
}

fn sema_registration_impl_rows(module_row: SemaRegistrationModule) -> SemaRegistrationImplRows Never! {
    rows := SemaRegistrationImplRows{nominals: [String:Int]{}, traits: [String:Int]{}}
    loop index in 0..<module_row.nominals.len() {
        name :: module_row.nominals[index].symbol.name
        if rows.nominals.get(name) == None -> rows.nominals[name] = index
        if module_row.nominals[index].kind == SemaRegistrationNominalKind.Trait && rows.traits.get(name) == None -> rows.traits[name] = index
    }
    rows
}

// `owner_row` declares the implemented type: the impl's own module, or
// the member file of its package that declares it.
// `owner_rows` indexes `owner_row`'s nominals and `trait_rows` the impl
// module's (sema_registration_impl_rows of each).
fn sema_registration_impl(module_row: SemaRegistrationModule, definition: ImplDef, owner_row: SemaRegistrationModule, owner_rows: SemaRegistrationImplRows, trait_rows: SemaRegistrationImplRows, diagnostics: &[Diagnostic]) -> SemaRegistrationImpl {
    nominal_index :: owner_rows.nominals.get(definition.type_name) ?? -1
    target_type := Type.Named{name: definition.type_name}
    target_identity := type_identity(target_type)
    target_identity_key := "{module_row.module_identity}:{type_identity_key(target_type)}"
    target_module_identity := String?{None}
    owner_id := symbol_id(SymbolKind.Impl, module_row.module_identity, "", "{definition.type_name}:{definition.span.start}:{definition.span.end}")
    if nominal_index >= 0 {
        nominal :: owner_row.nominals[nominal_index]
        target_type = nominal.ty
        target_identity = nominal.identity
        target_identity_key = nominal.identity_key
        target_module_identity = Val(owner_row.module_identity)
        owner_id = nominal.symbol.id
    } else {
        // An operator hook on a built-in scalar (`impl Int.Mul(Price)`)
        // receives that scalar as `self`.
        scalar :: sema_registration_builtin_scalar(definition.type_name)
        if scalar == .Val(builtin_type) {
            target_type = builtin_type
            target_identity = type_identity(target_type)
            target_identity_key = "{module_row.module_identity}:{type_identity_key(target_type)}"
        }
        if sema_registration_source_owns_impl(owner_row, definition.type_name) {
            target_module_identity = Val(owner_row.module_identity)
        }
    }
    trait_symbol := Symbol?{None}
    trait_identity := TypeIdentity?{None}
    if definition.trait_name == .Val(trait_name) {
        if trait_rows.traits.get(trait_name) == .Val(candidate_index) {
            trait_symbol = Val(module_row.nominals[candidate_index].symbol)
            trait_identity = Val(module_row.nominals[candidate_index].identity)
        }
    }
    trait_key :: definition.trait_name ?? ""
    identity_key :: "{module_row.module_identity}:impl:{definition.type_name}:{trait_key}:{definition.span.start}:{definition.span.end}"
    if nominal_index < 0 -> owner_id = symbol_id(SymbolKind.Impl, module_row.module_identity, "", identity_key)
    symbol :: Symbol{id: symbol_id(SymbolKind.Impl, module_row.module_identity, "", identity_key), kind: SymbolKind.Impl, name: definition.type_name, module_name: module_row.module_identity, owner: None, span: definition.type_span, ty: Val(target_type), visibility: 0}
    associated_types :: loop declaration in definition.assoc_type_impls -> {
        associated_symbol :: Symbol{id: symbol_id(SymbolKind.Type, module_row.module_identity, symbol.id.key, declaration.name), kind: SymbolKind.Type, name: declaration.name, module_name: module_row.module_identity, owner: Val(symbol.id.key), span: declaration.span, ty: Val(declaration.ty), visibility: 0}
        SemaRegistrationAssociatedType{symbol: associated_symbol, declaration: declaration, ty: declaration.ty, identity: type_identity(declaration.ty), identity_key: "{symbol.id.key}:{declaration.name}:{type_identity_key(declaration.ty)}"}
    }
    hook_owner :: sema_registration_operator_owner(owner_id, module_row.module_identity, target_type, definition.trait_name, definition.operator_rhs)
    methods :: loop method_index in 0..<definition.methods.len() -> sema_registration_function(definition.methods[method_index], sema_raw_protocol_function_return(definition.trait_name, false, definition.methods[method_index]), module_row.module_identity, Val(hook_owner), module_row.source_file, module_row.source_origin, module_row.source_segments, &diagnostics)
    SemaRegistrationImpl{
        symbol: symbol,
        declaration: definition,
        source_module_identity: module_row.module_identity,
        source_package_identity: module_row.package_identity,
        target_module_identity: target_module_identity,
        target_type_name: definition.type_name,
        target_type: target_type,
        target_identity: target_identity,
        target_identity_key: target_identity_key,
        trait_name: definition.trait_name,
        trait_symbol: trait_symbol,
        trait_identity: trait_identity,
        trait_span: definition.trait_span,
        identity_key: identity_key,
        methods: methods,
        associated_type_impls: definition.assoc_type_impls,
        associated_types: associated_types,
        delegation_field: definition.delegation_field,
        compiler_generated: definition.is_generated_serde,
        operator_marker: definition.operator_marker,
        operator_rhs: definition.operator_rhs,
        target_os: definition.os_target,
    }
}

// `rows` indexes `module_row`'s nominals (sema_registration_impl_rows),
// which no impl registration changes.
fn sema_registration_add_impl(module_row: &SemaRegistrationModule, item: Item, rows: SemaRegistrationImplRows, diagnostics: &[Diagnostic]) {
    if item == {
        .Impl(definition) -> {
            row := sema_registration_impl(module_row, definition, module_row, rows, rows, &diagnostics)
            // In a package, the type may be declared by a
            // sibling member; sema_registration_attach_namespace_impls owns
            // that impl's E0301 once every member is registered.
            if !definition.type_name.contains(".") && row.target_module_identity == None && !sema_registration_package_is_namespace(module_row.package_identity) && !sema_registration_opmix_builtin_impl(module_row, definition) {
                &diagnostics.push(sema_registration_unknown_impl_target(definition))
            }
            &module_row.impls.push(row)
            if row.target_module_identity != None {
                nominal_index :: rows.nominals.get(definition.type_name) ?? -1
                if nominal_index >= 0 {
                    loop method in row.methods -> &module_row.nominals[nominal_index].methods.push(method)
                }
            }
        }
        else -> {}
    }
}

fn sema_registration_unknown_impl_target(definition: ImplDef) -> Diagnostic {
    sema_error("E0301", definition.type_span, "the impl target `{definition.type_name}` is not a registered type", "an implementation needs one nominal declaration in the resolved module graph", "declare or import the target type before its impl")
}

// Opaque impl ownership is metadata, not a nominal declaration or public export.
fn sema_registration_source_owns_impl(module_row: SemaRegistrationModule, name: String) -> Bool Never! {
    if !module_row.module_identity.starts_with("<corelib>/") -> return false
    loop row in CORE_SOURCE_OWNED_ROWS {
        if row.module_name != module_row.module_name || row.alias != module_row.core_source_alias || module_row.source_file != "<corelib>/{row.path}" -> next
        if !sema_reserved_type_name(name) && !core_module_has_type(row.module_name, name) -> next
        loop owner in row.impl_types {
            if owner == name -> return true
        }
    }
    false
}

// The `sema_registration_source_owns_impl` relation for every module and impl
// type at once: `name` maps to module `m` exactly when
// `sema_registration_source_owns_impl(graph.modules[m], name)` holds.
fn sema_registration_index_source_impls(graph: &SemaRegistrationGraph) Never! {
    owners := [String:[Int]]{}
    loop module_index in 0..<graph.modules.len() {
        module_row :: graph.modules[module_index]
        if !module_row.module_identity.starts_with("<corelib>/") -> next
        loop row in CORE_SOURCE_OWNED_ROWS {
            if row.module_name != module_row.module_name || row.alias != module_row.core_source_alias || module_row.source_file != "<corelib>/{row.path}" -> next
            loop owner in row.impl_types {
                if !sema_reserved_type_name(owner) && !core_module_has_type(row.module_name, owner) -> next
                modules := owners.get(owner) ?? [Int]{}
                if modules.contains(module_index) -> next
                &modules.push(module_index)
                owners[owner] = ^modules
            }
        }
    }
    graph.source_impl_owner_modules = ^owners
}

// (Rust `opmix_allows_builtin_impl`): an operator hook on a built-in
// type belongs to the package that declares the other operand, so
// `impl Int.Mul(Price)` is legal when this module declares `Price`.
fn sema_registration_opmix_builtin_impl(module_row: SemaRegistrationModule, definition: ImplDef) -> Bool {
    if definition.type_name.contains(".") -> return false
    if sema_registration_builtin_scalar(definition.type_name) == None && !sema_core_is_math_type(definition.type_name) -> return false
    trait_name :: definition.trait_name ?? return false
    if !sema_checked_operator_trait(trait_name) -> return false
    rhs :: definition.operator_rhs ?? return false
    if rhs == .Named(rhs_name) {
        if rhs_name == definition.type_name -> return false
        loop item_index in 0..<module_row.program.items.len() {
            if sema_registration_declared_type_name(module_row.program.items[item_index]) == rhs_name -> return true
        }
    }
    false
}

// A built-in scalar type named in source (`Int`, `F32`, `U8`, ...).
fn sema_registration_builtin_scalar(name: String) -> Type? {
    scalar :: sema_marker_rules_builtin_type(name) ?? return None
    if scalar == {
        .Named(_) -> None
        else -> Val(scalar)
    }
}

// The type a struct, enum, distinct or alias declaration names; "" otherwise.
fn sema_registration_declared_type_name(item: Item) -> String Never! {
    if item == {
        .Struct(declared) -> declared.name
        .Enum(declared) -> declared.name
        .Distinct(declared) -> declared.name
        .TypeAlias(declared) -> declared.name
        else -> ""
    }
}

// A package is one namespace, so `impl Span` may sit in a
// member file beside the one declaring `Span`. Its row and methods belong to
// the declaring member's nominal; an impl whose type no member declares is
// E0301.
fn sema_registration_attach_namespace_impls(graph: &SemaRegistrationGraph) {
    loop module_index in 0..<graph.modules.len() {
        package_identity :: graph.modules[module_index].package_identity
        if !sema_registration_package_is_namespace(package_identity) -> next
        loop impl_index in 0..<graph.modules[module_index].impls.len() {
            definition :: graph.modules[module_index].impls[impl_index].declaration
            if definition.type_name.contains(".") || graph.modules[module_index].impls[impl_index].target_module_identity != None -> next
            owner_index := -1
            loop candidate_index in 0..<graph.modules.len() {
                if candidate_index == module_index || graph.modules[candidate_index].package_identity != package_identity -> next
                if sema_registration_impl_nominal_index(graph.modules[candidate_index], definition.type_name) >= 0 {
                    owner_index = candidate_index
                    break
                }
            }
            if owner_index < 0 {
                if !sema_registration_opmix_builtin_impl(graph.modules[module_index], definition) -> sema_registration_push_graph_diagnostic(&graph, module_index, sema_registration_unknown_impl_target(definition))
                next
            }
            // The first registration already reported the methods' own
            // diagnostics; re-keying them under the owner repeats nothing.
            repeated := [Diagnostic]{}
            row :: sema_registration_impl(graph.modules[module_index], definition, graph.modules[owner_index], sema_registration_impl_rows(graph.modules[owner_index]), sema_registration_impl_rows(graph.modules[module_index]), &repeated)
            graph.modules[module_index].impls[impl_index] = row
            nominal_index :: sema_registration_impl_nominal_index(graph.modules[owner_index], definition.type_name)
            loop method in row.methods -> &graph.modules[owner_index].nominals[nominal_index].methods.push(method)
        }
    }
}

fn sema_registration_item_has_foreign_name(item: Item, name: String) -> Bool Never! {
    if item == {
        .ExternRust(block) -> {
            loop function in block.functions {
                if function.name == name -> return true
            }
        }
        .CModule(block) -> {
            loop function in block.functions {
                if function.name == name -> return true
            }
        }
        else -> {}
    }
    false
}

// A named root resolves through the module's declaration positions; only a
// foreign function (declared inside an extern block, which has no root name)
// needs the scan over the module's declarations.
fn sema_registration_declaration_for_symbol(module_row: SemaRegistrationModule, symbol: Symbol) -> Item? {
    // copy: an export row owns its declaration; the module row keeps its own.
    if module_row.declaration_positions.get(symbol.name) == .Val(position) -> return Val(module_row.declarations[position].copy())
    loop declaration in module_row.declarations {
        // copy: as above, only the matched declaration is copied out.
        if sema_registration_item_has_foreign_name(declaration, symbol.name) -> return Val(declaration.copy())
    }
    None
}

fn sema_registration_foreign_handle_close_key(module_row: SemaRegistrationModule, facts: SemaRegistrationForeignHandleFacts) -> String? {
    loop registered_index in 0..<module_row.foreign_functions.len() {
        if module_row.foreign_functions[registered_index].owner == SemaRegistrationForeignOwner.CModule && module_row.foreign_functions[registered_index].declaration.name == facts.close {
            return Val(module_row.foreign_functions[registered_index].symbol.id.key)
        }
    }
    None
}

fn sema_registration_prepare_module(input: SemaRegistrationModuleInput) -> SemaRegistrationModuleResult {
    sema_registration_prepare_module_with(input, [SemaGenericModuleSource]{})
}

fn sema_registration_prepare_module_with(input: SemaRegistrationModuleInput, templates: [SemaGenericModuleSource]) -> SemaRegistrationModuleResult {
    diagnostics := [Diagnostic]{}
    policies :: sema_policy_declarations_checked(input.program.user_policy_declarations, &diagnostics)
    module_row := sema_registration_prepare_module_row(input.copy(), templates, policies, &diagnostics)
    SemaRegistrationModuleResult{module_row: module_row, diagnostics: diagnostics, complete: !sema_has_error_since(diagnostics, 0)}
}

// The prepared row of one module; its diagnostics are appended to `reported`.
// The row is returned whole, so the graph takes it without a copy. The input
// is consumed: its program moves into the row instead of being copied.
// `templates` are the generic-module templates the module imports; its own
// templates come from its program. `policies` are its package's checked user
// policy declarations (Rust Registration: one policy set per package).
fn sema_registration_prepare_module_row(input: ^SemaRegistrationModuleInput, templates: [SemaGenericModuleSource], policies: [UserPolicyDecl], reported: &[Diagnostic]) -> SemaRegistrationModule {
    diagnostics := [Diagnostic]{}
    owned := ^input
    module_row := SemaRegistrationModule{
        package_identity: owned.package_identity,
        module_identity: owned.module_identity,
        module_name: owned.module_name,
        core_source_alias: owned.core_source_alias,
        module_path: owned.module_path,
        source_file: owned.source_file,
        source_segments: owned.source_segments,
        source_origin: owned.source_origin,
        program: owned.program,
        source: owned.source,
        symbols: [Symbol]{},
        declarations: [Item]{},
        symbol_positions: [String:Int]{},
        declaration_positions: [String:Int]{},
        impls: [SemaRegistrationImpl]{},
        functions: [SemaRegistrationFunction]{},
        foreign_functions: [SemaRegistrationForeignFunction]{},
        nominals: [SemaRegistrationNominal]{},
        constants: [SemaRegistrationConstant]{},
        imports: [SemaRegistrationImport]{},
        exports: [SemaRegistrationExport]{},
        declared_trait_impls: [String:Bool]{},
        namespace: owned.namespace,
        namespace_names: owned.namespace_names,
        namespace_refs: owned.namespace_refs,
        // Items expanded from a template declared in another module spell
        // names its own source never does: every namespace name binds.
        namespace_full: templates.len() > 0,
    }
    // The reset makes the `^` above a move, not a copy of the program.
    owned.program = ast_program()
    if module_row.package_identity == "" || module_row.module_identity == "" || module_row.module_name == "" || module_row.module_path == "" || module_row.source_file == "" {
        &diagnostics.push(sema_error_optional("E0003", None, "a declaration registry row is missing source identity", "package, module, display path, and source identity remain separate semantic inputs", "provide the loader's canonical package, module, display-path, and source-file identities"))
    }
    // Identifier casing is checked on the parsed source before
    // any declaration is registered or rewritten.
    sema_casing_program(module_row.program, &diagnostics)
    // E0932: `#Deprecated` retires a public item; checked
    // on the parsed items, inline module bodies included, before inline
    // modules are lowered.
    sema_registration_deprecated_visibility(module_row.program.items, &diagnostics)
    loop facts in owned.foreign_handles {
        if sema_registration_module_has_name(module_row, facts.jet_name) {
            &diagnostics.push(sema_defined_twice(facts.jet_name, "module declarations share one namespace", facts.source_span))
            next
        }
        nominal :: sema_registration_foreign_handle_nominal(facts, module_row.module_identity, &diagnostics)
        if nominal == .Val(value) {
            module_row.symbol_positions[value.symbol.name] = module_row.symbols.len()
            &module_row.symbols.push(value.symbol)
            &module_row.symbol_nominal_rows.push(module_row.nominals.len())
            &module_row.nominals.push(value)
        }
    }
    // Each valid module alias becomes an expanded module
    // instance before anything else sees the items (Rust expands before
    // sibling mangling and registration).
    // Each rewrite below updates the program in place and leaves it
    // untouched (uncopied) when it has nothing to rewrite.
    sema_generic_modules_expand(&module_row.program, module_row.module_identity, templates)
    // Inline modules give their members one lifted identity
    // (types beside the module, top-level member functions by member name)
    // and resolve `module.f(...)` and `use module.[f]` before registration.
    module_row.inline_bindings = sema_inline_modules_lower(&module_row.program, &diagnostics)
    sema_policy_materialize(&module_row.program, policies, module_row.module_identity, module_row.source_file, module_row.source_origin, module_row.source_segments, &diagnostics)
    // Root `prep loop` declarations expand first, so every
    // generated impl, conversion, and test registers as a written item.
    sema_derive_expand_template_loops(&module_row.program.items, &diagnostics)
    // Reject reserved type declarations before automatic capability expansion:
    // an invalid nominal must not produce methods that cascade from E0106.
    item_index := 0
    loop item_index < module_row.program.items.len() {
        if !sema_registration_reserved_type_rule(module_row, module_row.program.items[item_index], sema_registration_root_name(module_row.program.items[item_index]), &diagnostics) {
            _ := &module_row.program.items.remove(item_index, .Slot)
        } else {
            item_index += 1
        }
    }
    // Each struct's `validate { … }` block becomes its
    // generated `T.validate(value)` before any declaration is registered.
    sema_validate_blocks(&module_row.program.items, &diagnostics)
    // Declared conversions register once per module and become
    // their checked conversion routines before any declaration is resolved.
    sema_error_conversion_items(&module_row.program.items, module_row.namespace_refs, &diagnostics)
    // Selected built-in capabilities expand from the Prelude
    // derive templates into compiler-generated trait blocks before any
    // declaration, impl, or known-time value is registered.
    sema_derive_expand_builtin_items(&module_row.program.items, &diagnostics)
    // Explicit and structurally selected codecs
    // enter as ordinary generated `impl T.Encode`/`impl T.Decode` items.
    sema_serde_expand_builtin_items(&module_row.program.items)
    row_source_file :: module_row.source_file.copy()
    row_source_origin :: module_row.source_origin.copy()
    row_source_segments :: module_row.source_segments.copy()
    // Registering a root reads no program item, so the items move out for the
    // walk and back after it: each one is read in place instead of copied.
    items := ^module_row.program.items
    module_row.program.items = [Item]{}
    loop index in 0..<items.len() {
        if !sema_registration_add_root(&module_row, items[index], row_source_file, row_source_origin, row_source_segments, &diagnostics) {
            // The first declaration remains the lookup winner after a collision.
        }
    }
    module_row.program.items = ^items
    // (E2408, E2415): serde field markers and anonymous-union decode
    // shapes are checked on the registered items, as the Rust reference's
    // `validate_serde_items` runs after the trait registry is built.
    sema_registration_serde_items(module_row.program.items, &diagnostics)
    // Checked
    // on the registered items, as the Rust reference's `validate_cli_items`
    // runs after struct registration.
    sema_registration_cli_items(module_row.program.items, &diagnostics)
    // Only foreign-handle rows change; every other row is read in place (a
    // copied row would carry its whole source declaration).
    loop nominal_index in 0..<module_row.nominals.len() {
        if module_row.nominals[nominal_index].kind != SemaRegistrationNominalKind.ForeignHandle -> next
        // copy: `source` is read, then the same nominal slot is rewritten with the updated facts.
        // Jet has no writable binding for an enum payload in module_row.nominals.
        source :: module_row.nominals[nominal_index].source.copy()
        if source == .ForeignHandle(facts) {
            updated_facts := facts
            updated_facts.close_function_key = sema_registration_foreign_handle_close_key(module_row, updated_facts)
            module_row.nominals[nominal_index].source = SemaRegistrationNominalSource.ForeignHandle{value: updated_facts}
        }
    }
    // Only impls register here; every other item is skipped without a copy.
    // The nominal rows are indexed once: impls add methods to nominals, never
    // nominals.
    impl_rows :: sema_registration_impl_rows(module_row)
    loop index in 0..<module_row.program.items.len() {
        if module_row.program.items[index] == .Impl(_) {
            // copy: sema_registration_add_impl writes module_row (`&`) and stores the impl rows,
            // while the item stays in module_row.program.items. A view of that list would be live
            // across the write.
            item :: module_row.program.items[index].copy()
            sema_registration_add_impl(&module_row, item, impl_rows, &diagnostics)
        }
    }
    // Root exports are retained separately so private declarations never become
    // cross-module candidates merely because their name is known.
    loop symbol_index in 0..<module_row.symbols.len() {
        // copy: the export row stores its own symbol, while the symbol row stays in
        // module_row.symbols, and module_row is written (exports.push) while it is live.
        symbol :: module_row.symbols[symbol_index].copy()
        if symbol.visibility > 0 {
            declaration :: sema_registration_declaration_for_symbol(module_row, symbol)
            &module_row.exports.push(SemaRegistrationExport{name: symbol.name, symbol: symbol, declaration: declaration, source_module_identity: module_row.module_identity, visibility: symbol.visibility})
        }
    }

    sema_attach_diagnostic_source_locations(&diagnostics, 0, module_row.source_segments)
    loop diagnostic in diagnostics -> &reported.push(diagnostic)
    ^module_row
}

// The CLI shape of one `#CLI` field (Rust `CLIFieldKind`).
enum SemaRegistrationCLIFieldKind {
    Flag
    OptionalOption
    DefaultedOption
    RequiredOption
}

// Rust `validate_cli_items` (CheckerCli.rs): every `#CLI` program struct of the
// module, in item order. A struct that is not `#CLI` may carry neither a
// callable member (E1345) nor `#Short`/`#Env` (E1319). A `#CLI` struct's
// fields each map to one flag (E1305), keep `#Flag` meaningful (E1309), derive
// distinct flags beside the reserved `--help`/`--allow`/`--deny` (E1306), use
// one-letter distinct short names (E1318), and keep `#Env` off presence flags
// (E1319). Its methods and bound members are commands with one namespace
// (E1344), read-only receivers (E1347), and callable shapes (E1345), and are
// not allowed on a Codable struct (E1346).
fn sema_registration_cli_items(items: [Item], diagnostics: &[Diagnostic]) {
    loop item in items {
        if item == .Struct(definition) {
            cli := false
            loop derive_item in definition.derives {
                if derive_item.name == "CLI" -> cli = true
            }
            if !cli {
                loop binding in definition.cli_bindings -> &diagnostics.push(sema_registration_e1345(binding.name, binding.name_span, "a callable member is only valid inside a `#CLI` program struct"))
                loop field in definition.fields {
                    loop marker in field.serde_markers {
                        if marker.name == "Short" || marker.name == "Env" -> &diagnostics.push(sema_registration_e1319(marker.name, field.name, "`#Short` and `#Env` describe generated command inputs, but this struct is not `#CLI`.", "remove the marker, or mark the command-input struct `#CLI`", marker.name_span))
                    }
                }
                next
            }
            seen_flags := [String:Bool]{"help": true, "allow": true, "deny": true}
            seen_shorts := [String:String]{}
            if sema_registration_cli_standard(definition.type_markers) {
                loop name in ([String]{"verbose", "quiet", "color", "version"}) -> seen_flags[name] = true
                seen_shorts["v"] = "standard --verbose"
                seen_shorts["q"] = "standard --quiet"
            }
            loop field in definition.fields {
                kind :: sema_registration_cli_field_kind(field) ?? {
                    &diagnostics.push(sema_error("E1305", field.name_span, "field `{field.name}` has no CLI flag mapping ({type_name(field.ty)})", "a `#[CLI]` field becomes one `--flag` (and a positional when required); only `Int` (including inline ranges), `Float`, `Bool`, `String`, `Path`, and `T?` of those have a defined shape (nested `#[CLI]` structs and other collection/closure types don't).", "change the field to a supported type, or drop it from the `#[CLI]` struct"))
                    next
                }
                flag_marker :: sema_registration_cli_marker(field.serde_markers, "Flag")
                if flag_marker == .Val(marker) && kind != SemaRegistrationCLIFieldKind.RequiredOption {
                    &diagnostics.push(sema_error("E1309", marker.name_span, "`#[Flag]` on `{field.name}` has nothing to opt out of", "`#[Flag]` keeps a required value field flag-only. Bool fields, optional fields (`T?`), and fields with a `{{expr}}` default already stay flag-only.", "remove `#[Flag]`, or make the field a required scalar without a `{{expr}}` default"))
                }
                flag :: sema_checked_field_shape_names(definition, field).args
                if seen_flags.get(flag) != None {
                    &diagnostics.push(sema_error("E1306", field.name_span, "two `#[CLI]` fields both derive the flag `--{flag}`", "every field needs a distinct `--flag`; generated commands reserve `--help`, `--allow`, and `--deny`.", "rename the colliding field or choose a non-reserved flag name"))
                }
                seen_flags[flag] = true
                sema_registration_cli_short_name(field, &seen_shorts, &diagnostics)
                if kind == SemaRegistrationCLIFieldKind.Flag {
                    env_marker :: sema_registration_cli_marker(field.serde_markers, "Env")
                    if env_marker == .Val(marker) && sema_registration_cli_marker_string(marker) != None {
                        &diagnostics.push(sema_registration_e1319("Env", field.name, "a `Bool` command field is a presence flag, while `#Env` lowers to a value option.", "remove `#Env`, or use it on an `Int`, `Float`, `String`, `Path`, or optional value field", marker.name_span))
                    }
                }
            }
            seen_commands := [String:Bool]{}
            command_count := 0
            loop function in definition.methods {
                computed := false
                loop field in definition.fields {
                    if field.computed != None && field.name == function.name -> computed = true
                }
                if computed -> next
                command_count += 1
                command :: unicode.lower(function.name)
                sema_registration_cli_command_word(command, function.name_span, seen_flags, &seen_commands, &diagnostics)
                receiver := Param?{None}
                loop param in function.params {
                    if param.name == "self" {
                        receiver = Val(param)
                        break
                    }
                }
                if receiver == .Val(self_param) && self_param.convention != AccessConvention.Read {
                    &diagnostics.push(sema_error("E1347", self_param.name_span, "a CLI method receiver must be read-only", "shared root flags are parsed into one program value and command dispatch must not mutate that value.", "change the receiver to read-only `self`"))
                }
                sema_registration_cli_callable_params(function, command, None, &diagnostics)
            }
            loop binding in definition.cli_bindings {
                command_count += 1
                sema_registration_cli_command_word(unicode.lower(binding.name), binding.name_span, seen_flags, &seen_commands, &diagnostics)
                foreign_marker := false
                loop marker in binding.markers {
                    if marker.name != "Doc" -> foreign_marker = true
                }
                if foreign_marker -> &diagnostics.push(sema_registration_e1345(binding.name, binding.name_span, "a callable member accepts `#Doc`, but field-only CLI markers do not apply to bindings"))
                target :: sema_registration_cli_binding_target(items, binding.target) ?? {
                    &diagnostics.push(sema_registration_e1345(binding.name, expr_span(binding.target), "the binding target must be a function declared in the same program module"))
                    next
                }
                sema_registration_cli_callable_params(target, binding.name, Val(definition.name), &diagnostics)
            }
            codable := false
            loop derive_item in definition.derives {
                if derive_item.name == "Codable" || derive_item.name == "Encode" || derive_item.name == "Decode" -> codable = true
            }
            if command_count > 0 && codable {
                &diagnostics.push(sema_error("E1346", definition.name_span, "callable CLI members cannot be declared on a Codable struct", "CLI commands are behavior, while Codable structs contain only serializable data fields.", "split the command program struct from the Codable data struct"))
            }
        }
    }
}

// E1318: the field's first `#Short` marker, when its argument is one literal
// string, is one ASCII letter that no earlier field (or the standard pack)
// already selects.
fn sema_registration_cli_short_name(field: Field, seen: &[String:String], diagnostics: &[Diagnostic]) {
    marker_value :: sema_registration_cli_marker(field.serde_markers, "Short")
    if marker_value == None -> return
    marker :: marker_value
    short_value :: sema_registration_cli_marker_string(marker)
    if short_value == None -> return
    short :: short_value
    bytes :: short.bytes()
    letter := false
    if bytes.len() == 1 {
        code :: Int.from_u8(bytes[0])
        letter = (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
    }
    if !letter {
        &diagnostics.push(sema_error("E1318", marker.name_span, "`#Short(\"{short}\")` is not a one-letter option", "the shared command parser treats a short option as one ASCII letter.", "use one letter, such as `#Short(\"p\")`"))
        return
    }
    previous :: seen.get(short)
    seen[short] = field.name
    if previous == .Val(first) -> &diagnostics.push(sema_error("E1318", marker.name_span, "`#Short(\"{short}\")` is used by both `{first}` and `{field.name}`", "each short option must select only one `#CLI` field.", "give `{first}` or `{field.name}` a different `#Short` value"))
}

// E1344: a command word may name neither a root flag nor another command. A
// word that names a root flag is not recorded as a command.
fn sema_registration_cli_command_word(command: String, span: Span, seen_flags: [String:Bool], seen_commands: &[String:Bool], diagnostics: &[Diagnostic]) {
    collides := seen_flags.get(command) != None
    if !collides {
        collides = seen_commands.get(command) != None
        seen_commands[command] = true
    }
    if collides -> &diagnostics.push(sema_error("E1344", span, "CLI command `{command}` collides with another command or root flag", "a program struct has one command namespace and one root flag namespace; a word cannot name both.", "rename the command or the root field so every command word is unique"))
}

// Rust `validate_callable_params`: a command takes the shared program struct
// at most once, first and read-only (bound members only), and otherwise only
// scalar or optional scalar, non-variadic parameters with literal defaults.
fn sema_registration_cli_callable_params(function: Func, command: String, shared_type: String?, diagnostics: &[Diagnostic]) {
    shared_slots := [Int]{}
    if shared_type == .Val(shared_name) {
        loop (index, param) in function.params {
            leaf :: sema_registration_cli_named_leaf(param.ty) ?? next
            if leaf == shared_name -> &shared_slots.push(index)
        }
        if shared_slots.len() > 1 || (shared_slots.len() == 1 && shared_slots[0] != 0) {
            &diagnostics.push(sema_registration_e1345(command, function.name_span, "a bound function may receive the shared program struct only once, as its first parameter"))
        }
    }
    loop (index, param) in function.params {
        if param.name == "self" {
            if shared_type != None -> &diagnostics.push(sema_registration_e1345(command, param.name_span, "a bound function receives shared state as an ordinary first program-struct parameter, not as a method receiver"))
            next
        }
        if shared_slots.contains(index) {
            if param.convention != AccessConvention.Read -> &diagnostics.push(sema_registration_e1345(command, param.name_span, "the shared program-struct parameter must be read-only"))
            next
        }
        if param.variadic || param.variadic_bound_list != None {
            &diagnostics.push(sema_registration_e1345(command, param.name_span, "command parameters cannot be variadic; use one scalar or optional scalar parameter per input"))
            next
        }
        if !sema_registration_cli_field_mapped(param.ty) {
            &diagnostics.push(sema_registration_e1345(command, param.ty_span, "every command parameter must be a CLI scalar or optional scalar"))
        }
        if param.default == .Val(default) && !sema_registration_cli_literal_default(default) {
            &diagnostics.push(sema_registration_e1345(command, param.name_span, "a command default must be a CLI compile-time scalar value"))
        }
    }
}

// Rust `Expr::without_parens` matched against a literal Int, Float, Bool or String.
fn sema_registration_cli_literal_default(expr: Expr) -> Bool Never! {
    current :: sema_registration_cli_without_parens(expr)
    if current == {
        .Int(_, _, _, _) | .Float(_, _, _, _) | .Bool(_, _) | .Str(_, _) -> true
        else -> false
    }
}

// Rust `named_leaf`: the last `.` segment of a named type.
fn sema_registration_cli_named_leaf(ty: Type) -> String? {
    if ty == .Named(name) {
        parts :: name.split(".").to_list()
        return Val(parts[parts.len() - 1])
    }
    None
}

// Rust `binding_target`: the module function a bound CLI member names.
fn sema_registration_cli_binding_target(items: [Item], target: Expr) -> Func? {
    current :: sema_registration_cli_without_parens(target)
    if current == .Ident(name, _) {
        loop item in items {
            if item == .Func(function) && function.name == name -> return Val(function)
        }
    }
    None
}

// Rust `Expr::without_parens`.
fn sema_registration_cli_without_parens(expr: Expr) -> Expr Never! {
    current := expr
    loop {
        if current == .Paren(inner, _) {
            current = inner
        } else {
            break
        }
    }
    current
}

// The first marker named `name` (Rust `iter().find(|m| m.name == name)`).
fn sema_registration_cli_marker(markers: [Marker], name: String) -> Marker? {
    loop marker in markers {
        if marker.name == name -> return Val(marker)
    }
    None
}

// Rust `classify_cli_field`: `Bool` is a flag; `T?` of a CLI scalar is an
// optional option; any other CLI scalar is a defaulted or required option.
fn sema_registration_cli_field_kind(field: Field) -> SemaRegistrationCLIFieldKind? {
    if field.ty == .Bool -> return Val(SemaRegistrationCLIFieldKind.Flag)
    if field.ty == .Option(inner) {
        if sema_registration_cli_scalar(inner) -> return Val(SemaRegistrationCLIFieldKind.OptionalOption)
        return None
    }
    if !sema_registration_cli_scalar(field.ty) -> return None
    defaulted := field.default != None
    loop marker in field.serde_markers {
        if marker.name == "Default" -> defaulted = true
    }
    if defaulted -> return Val(SemaRegistrationCLIFieldKind.DefaultedOption)
    Val(SemaRegistrationCLIFieldKind.RequiredOption)
}

fn sema_registration_e1319(marker: String, field: String, why: String, fix: String, span: Span) -> Diagnostic {
    sema_error("E1319", span, "`#{marker}` has no CLI mapping for field `{field}`", why, fix)
}

fn sema_registration_e1345(name: String, span: Span, why: String) -> Diagnostic {
    sema_error("E1345", span, "CLI command member `{name}` has no callable shape", why, "bind a visible function with scalar parameters and, at most, one first read-only parameter of the program-struct type")
}

// Rust `validate_cli_items` standard-pack test: `#CLI(Standard)`.
fn sema_registration_cli_standard(markers: [Marker]) -> Bool Never! {
    loop marker in markers {
        if marker.name != "CLI" -> next
        loop argument in marker.args {
            if argument == .Expr(value) && value == .Ident(name, _) && name == "Standard" -> return true
        }
    }
    false
}

// Rust `is_cli_scalar` or an optional one (`callable_param_shape`).
fn sema_registration_cli_field_mapped(ty: Type) -> Bool Never! {
    if ty == .Option(inner) -> return sema_registration_cli_scalar(inner)
    sema_registration_cli_scalar(ty)
}

// Rust `is_cli_scalar`: `Int` (and an inline range), `Float`, `Bool`, `String`, `Path`.
fn sema_registration_cli_scalar(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .InlineRange(_, _, _) | .Float | .Bool | .String -> true
        .Named(name) -> name == "Path"
        else -> false
    }
}

// Rust `marker_string`: the marker's first argument when it is one literal string.
fn sema_registration_cli_marker_string(marker: Marker) -> String? {
    if marker.args.len() == 0 -> return None
    if marker.args[0] == .Expr(value) && value == .Str(parts, _) && parts.len() == 1 {
        if parts[0] == .Lit(text) -> return Val(text)
    }
    None
}

// (Rust `validate_serde_items`): on every type that derives a codec
// explicitly, `#Flatten` needs a struct-typed field (E2408), every encoded or
// decoded field or payload needs a wire form (E2411), and every decoded
// anonymous union needs one distinct outer wire shape per member (E2415, or
// E2411 for a member with no known shape). Automatic codecs are selected
// only for declarations whose fields already qualify. The E2409 casing menu
// is not part of this pass (an enum reports it while its checked declaration
// is built).
fn sema_registration_serde_items(items: [Item], diagnostics: &[Diagnostic]) {
    if !sema_registration_serde_any_explicit(items) -> return
    // Keyed wire-form questions: one index per module, not a rescan per field.
    facts :: sema_derive_item_index(items)
    no_auto :: [String:Bool]{}
    loop item in items {
        if item == .Struct(definition) {
            encode :: sema_registration_serde_derives(definition.derives, "Encode")
            decode :: sema_registration_serde_derives(definition.derives, "Decode")
            if !encode && !decode -> next
            loop field in definition.fields {
                skip := false
                flatten := false
                loop marker in field.serde_markers {
                    if marker.name == "Skip" -> skip = true
                    if marker.name == "Flatten" -> flatten = true
                }
                if flatten && !sema_registration_serde_struct_named(field.ty) {
                    &diagnostics.push(sema_error("E2408", field.name_span, "`#[Flatten]` on `{field.name}` needs a struct-typed field", "flatten splices another struct's keys into this object, so the field must be a `#[Codable]` struct — not a primitive, list, or map", "give `{field.name}` a `#[Codable]` struct type, or drop `#[Flatten]`"))
                    next
                }
                if skip || flatten -> next
                sema_registration_serde_wire_form(items, facts, no_auto, field.ty, encode, decode, field.name_span, &diagnostics)
                if decode -> sema_registration_serde_union_shapes(items, field.ty, field.name_span, &diagnostics)
            }
        }
        if item == .Enum(definition) {
            encode :: sema_registration_serde_derives(definition.derives, "Encode")
            decode :: sema_registration_serde_derives(definition.derives, "Decode")
            if !encode && !decode -> next
            loop variant in definition.variants {
                if variant.payload == {
                    .Unit -> {}
                    .Single(ty, _) -> {
                        sema_registration_serde_wire_form(items, facts, no_auto, ty, encode, decode, variant.name_span, &diagnostics)
                        if decode -> sema_registration_serde_union_shapes(items, ty, variant.name_span, &diagnostics)
                    }
                    .Named(fields) -> loop field in fields {
                        sema_registration_serde_wire_form(items, facts, no_auto, field.ty, encode, decode, variant.name_span, &diagnostics)
                        if decode -> sema_registration_serde_union_shapes(items, field.ty, variant.name_span, &diagnostics)
                    }
                }
            }
        }
    }
}

// Whether any struct or enum derives a codec explicitly (the only
// declarations sema_registration_serde_items checks).
fn sema_registration_serde_any_explicit(items: [Item]) -> Bool Never! {
    loop item in items {
        if item == {
            .Struct(definition) -> {
                if sema_registration_serde_derives(definition.derives, "Encode") || sema_registration_serde_derives(definition.derives, "Decode") -> return true
            }
            .Enum(definition) -> {
                if sema_registration_serde_derives(definition.derives, "Encode") || sema_registration_serde_derives(definition.derives, "Decode") -> return true
            }
            else -> {}
        }
    }
    false
}

// Rust `e2411` over `is_encodable_ty`/`is_decodable_ty`: the generated and
// written codecs are already items here, so no automatic set is needed. The
// type is shown only for a report.
fn sema_registration_serde_wire_form(items: [Item], facts: SemaDeriveItemIndex, no_auto: [String:Bool], ty: Type, encode: Bool, decode: Bool, span: Span, diagnostics: &[Diagnostic]) {
    if encode && !sema_serde_items_codable(items, facts, ty, "Encode", no_auto) {
        shown :: sema_type_show(ty)
        &diagnostics.push(sema_error("E2411", span, "`{shown}` can't be serialized", "only types that opt in (and their fields) have a wire form; `{shown}` does not", "add `#[Codable]` or `#[Encode]` to `{shown}`, or remove it from the encoded value"))
    }
    if decode && !sema_serde_items_codable(items, facts, ty, "Decode", no_auto) {
        shown :: sema_type_show(ty)
        &diagnostics.push(sema_error("E2411", span, "`{shown}` can't be decoded", "only types that opt in (and their fields) have a wire form; `{shown}` does not", "add `#[Codable]` or `#[Decode]` to `{shown}`, or remove it from the decoded value"))
    }
}

// (Rust `check_deprecated_visibility`, E0932): a
// `#Deprecated` marker needs a public (not package-public) item. Functions,
// type markers, inherent and trait-impl methods, distinct types, and impl
// methods are checked; an inline module body is walked as its own item list.
fn sema_registration_deprecated_visibility(items: [Item], diagnostics: &[Diagnostic]) {
    loop item in items {
        if item == {
            .Func(function) -> sema_registration_deprecated_markers(function.markers, function.is_pub && !function.is_package_pub, &diagnostics)
            .Struct(definition) -> {
                sema_registration_deprecated_markers(definition.type_markers, definition.is_pub && !definition.is_package_pub, &diagnostics)
                sema_registration_deprecated_methods(definition.methods, &diagnostics)
                loop block in definition.trait_impls -> sema_registration_deprecated_methods(block.methods, &diagnostics)
            }
            .Enum(definition) -> {
                sema_registration_deprecated_markers(definition.type_markers, definition.is_pub && !definition.is_package_pub, &diagnostics)
                sema_registration_deprecated_methods(definition.methods, &diagnostics)
                loop block in definition.trait_impls -> sema_registration_deprecated_methods(block.methods, &diagnostics)
            }
            .Distinct(definition) -> sema_registration_deprecated_markers(definition.type_markers, definition.is_pub && !definition.is_package_pub, &diagnostics)
            .Impl(implementation) -> sema_registration_deprecated_methods(implementation.methods, &diagnostics)
            .CodeModule(code_module) -> {
                if code_module.body == .Val(body) -> sema_registration_deprecated_visibility(body, &diagnostics)
            }
            else -> {}
        }
    }
}

fn sema_registration_deprecated_methods(methods: [Func], diagnostics: &[Diagnostic]) {
    loop method in methods -> sema_registration_deprecated_markers(method.markers, method.is_pub && !method.is_package_pub, &diagnostics)
}

// Rust `check_deprecated_marker_visibility`: the row's text is the report.
fn sema_registration_deprecated_markers(markers: [Marker], is_public: Bool, diagnostics: &[Diagnostic]) {
    if is_public -> return
    loop marker in markers {
        if marker.name == "Deprecated" -> &diagnostics.push(sema_error("E0932", marker.span, "`#Deprecated` requires a public item", "the lifecycle marker retires stable public declarations; an item inside a `priv module` is not part of the public surface", "move the item out of its `priv module`, or remove `#Deprecated`"))
    }
}

fn sema_registration_serde_derives(derives: [NamedSpan], name: String) -> Bool Never! {
    loop derive_item in derives {
        if derive_item.name == name -> return true
    }
    false
}

// Rust `is_struct_named`: a named type that is not a data-tree type.
fn sema_registration_serde_struct_named(ty: Type) -> Bool Never! {
    if ty == .Named(name) -> return !sema_data_is_json_name(name)
    false
}

// Rust `validate_union_decode_shapes`. The Rust parser hands sema every union
// in canonical member order (`canonicalize_union`); the native
// parser keeps the written order, so each union is canonicalized here first.
fn sema_registration_serde_union_shapes(items: [Item], ty: Type, span: Span, diagnostics: &[Diagnostic]) {
    if ty == .Union(written) {
        canonical :: sema_failure_union_canonical(written)
        if canonical == .Union(members) {
            sema_registration_serde_union_members(items, canonical, members, span, &diagnostics)
            loop member in members -> sema_registration_serde_union_shapes(items, member, span, &diagnostics)
            return
        }
        sema_registration_serde_union_shapes(items, canonical, span, &diagnostics)
        return
    }
    if ty == {
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .FixedList(inner, _) -> sema_registration_serde_union_shapes(items, inner, span, &diagnostics)
        .Map(key, _, value) | .Result(key, value) -> {
            sema_registration_serde_union_shapes(items, key, span, &diagnostics)
            sema_registration_serde_union_shapes(items, value, span, &diagnostics)
        }
        .Apply(_, args) -> loop arg in args -> sema_registration_serde_union_shapes(items, arg, span, &diagnostics)
        .Tuple(fields) -> loop field in fields -> sema_registration_serde_union_shapes(items, field.ty, span, &diagnostics)
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params -> sema_registration_serde_union_shapes(items, param, span, &diagnostics)
            if ret == .Val(value) -> sema_registration_serde_union_shapes(items, value, span, &diagnostics)
        }
        else -> {}
    }
}

// One canonical union: each member's sorted outer wire shapes; a shape two
// members share is E2415 once per member pair.
fn sema_registration_serde_union_members(items: [Item], union_ty: Type, members: [Type], span: Span, diagnostics: &[Diagnostic]) {
    union_shown :: sema_type_show(union_ty)
    seen_shapes := [SerdeWireShape]{}
    seen_members := [Type]{}
    reported := [String]{}
    loop member in members {
        visited := [String]{}
        resolved :: jfmt_decode_shapes(items, member, &visited)
        member_label :: sema_registration_serde_label(member)
        if resolved == None {
            &diagnostics.push(sema_error("E2411", span, "union `{union_shown}` can't be decoded — `{member_label}` has no compiler-known wire shape", "`{member_label}` uses a custom or imported decoder; anonymous unions need each member's outer wire shape before codegen", "use a compiler-derived codec, a configured tagged enum, or a #CodableAsBase distinct type"))
            next
        }
        loop shape in sema_registration_serde_sorted_shapes(resolved) {
            previous := -1
            loop (index, known) in seen_shapes {
                if known == shape {
                    previous = index
                    break
                }
            }
            if previous < 0 {
                &seen_shapes.push(shape)
                &seen_members.push(member)
                next
            }
            first_label :: sema_registration_serde_label(seen_members[previous])
            pair :: "{first_label}\n{member_label}"
            if reported.contains(pair) -> next
            &reported.push(pair)
            &diagnostics.push(sema_error("E2415", span, "Union `{union_shown}` can't be decoded — `{first_label}` and `{member_label}` share wire shape `{sema_registration_serde_shape_name(shape)}`", "anonymous-union decode picks a member by wire shape; two members with the same shape would force an arbitrary order", "use a named enum with an explicit tag, or change the members so each has a distinct wire shape"))
        }
    }
}

// Rust `label`: the member's `Type::show` with surrounding backticks trimmed.
fn sema_registration_serde_label(ty: Type) -> String Never! {
    label := sema_type_show(ty)
    loop label.starts_with("`") -> label = label.slice(1, label.len())
    loop label.ends_with("`") -> label = label.slice(0, label.len() - 1)
    label
}

// Rust `SerdeWireShape` order (`finish` sorts each resolved shape set).
fn sema_registration_serde_shape_rank(shape: SerdeWireShape) -> Int Never! {
    if shape == {
        .Null -> 0
        .Int -> 1
        .Float -> 2
        .Bool -> 3
        .Text -> 4
        .Array -> 5
        .Object -> 6
        .Number -> 7
    }
}

fn sema_registration_serde_sorted_shapes(shapes: [SerdeWireShape]) -> [SerdeWireShape] Never! {
    sorted := shapes
    loop index in 1..<sorted.len() {
        current := sorted[index]
        insertion := index - 1
        loop insertion >= 0 && sema_registration_serde_shape_rank(sorted[insertion]) > sema_registration_serde_shape_rank(current) {
            sorted[insertion + 1] = sorted[insertion]
            insertion -= 1
        }
        sorted[insertion + 1] = current
    }
    sorted
}

// Rust `SerdeWireShape::name`.
fn sema_registration_serde_shape_name(shape: SerdeWireShape) -> String Never! {
    if shape == {
        .Null -> "Null"
        .Int -> "Int"
        .Float -> "Float"
        .Bool -> "Bool"
        .Text -> "Text"
        .Array -> "Array"
        .Object -> "Object"
        .Number -> "Number"
    }
}

fn sema_registration_import_is_unqualified(declaration: ImportDecl) -> Bool Never! {
    if declaration.kind == {.Unqualified(_, _, _, _, _) -> true else -> false}
}

// Rust `Bundle/ItemReuse.rs` `by_identity`: module identity -> row.
fn sema_registration_module_index(graph: SemaRegistrationGraph, identity: String) -> Int? {
    if graph.counting {
        counters := graph.lookup_counters
        permit :: counters.guard_edit()
        permit.value.module_lookups += 1
    }
    graph.module_rows.get(identity)
}

// The graph's lookup counts so far (SemaLookupCounters).
fn sema_registration_lookup_counts(graph: SemaRegistrationGraph) -> SemaLookupCounters {
    SemaLookupCounters{module_lookups: graph.lookup_counters.module_lookups, name_lookups: graph.lookup_counters.name_lookups}
}

// The registered module NAME (`core.term`) of a module IDENTITY such as a
// symbol's `module_name` (`<corelib>/core.term`).
fn sema_registration_module_name(graph: SemaRegistrationGraph, identity: String) -> String? {
    index :: sema_registration_module_index(graph, identity) ?? return None
    Val(graph.modules[index].module_name)
}

fn sema_registration_push_graph_diagnostic(graph: &SemaRegistrationGraph, module_index: Int, diagnostic: Diagnostic) Never! {
    if {
        module_index >= 0 && module_index < graph.modules.len() -> {
            // copy: the graph's diagnostics list owns the located row, while `diagnostic` is the
            // caller's row (a read parameter), still used below.
            &graph.diagnostics.push(sema_diagnostic_with_source_location(diagnostic.copy(), graph.modules[module_index].source_segments))
        }
        else -> {
            &graph.diagnostics.push(diagnostic)
        }
    }
}

fn sema_registration_import_visibility(declaration: ImportDecl) -> Int Never! {
    sema_registration_visibility(declaration.is_pub, declaration.is_package_pub)
}

fn sema_registration_import_local(item: ImportedItem) -> String Never! {
    if item.alias == .Val(alias) -> return alias
    parts :: item.original.split(".").to_list()
    parts[parts.len() - 1]
}

fn sema_registration_direct_symbol(module_row: SemaRegistrationModule, name: String) -> SemaRegistrationExport? {
    // The module's own declarations first: they carry the live symbol (a constant's staged type
    // lands on it after registration), while an export row holds a registration-time copy.
    loop index in 0..<module_row.symbols.len() {
        if module_row.symbols[index].name == name {
            declaration :: sema_registration_declaration_for_symbol(module_row, module_row.symbols[index])
            return Val(SemaRegistrationExport{name: name, symbol: module_row.symbols[index], declaration: declaration, source_module_identity: module_row.module_identity, visibility: module_row.symbols[index].visibility})
        }
    }
    loop export in module_row.exports {
        if export.name == name -> return Val(export)
    }
    None
}

fn sema_registration_resolve_export(graph: SemaRegistrationGraph, module_index: Int, name: String, requester_module: String, requester_package: String, seen: [String]) -> SemaRegistrationExport? {
    if module_index < 0 || module_index >= graph.modules.len() -> return None
    key :: "{module_index}:{name}"
    loop previous in seen {
        if previous == key -> return None
    }
    next_seen := seen
    &next_seen.push(key)
    module_row :: graph.modules[module_index]
    direct :: sema_registration_direct_symbol(module_row, name)
    if direct == .Val(export) {
        if sema_registration_visible(export.visibility, requester_module, requester_package, module_row.module_identity, module_row.package_identity) -> return Val(export)
        return None
    }
    loop import in module_row.imports {
        if !import.declaration.is_pub && !import.declaration.is_package_pub -> next
        target_index :: sema_registration_module_index(graph, import.target_module_identity) ?? next
        if import.declaration.kind == {
            .Unqualified(_, _, items, _, _) -> {
                loop item in items {
                    local :: sema_registration_import_local(item)
                    if local != name -> next
                    resolved :: sema_registration_resolve_export(graph, target_index, item.original, module_row.module_identity, module_row.package_identity, next_seen) ?? next
                    if !sema_registration_visible(resolved.visibility, module_row.module_identity, module_row.package_identity, resolved.source_module_identity, graph.modules[target_index].package_identity) -> next
                    return Val(SemaRegistrationExport{name: name, symbol: resolved.symbol, declaration: resolved.declaration, source_module_identity: resolved.source_module_identity, visibility: if import.declaration.is_pub -> 2 else -> 1})
                }
            }
            .File(_, _) | .Module(_, _) -> {
                if import.declaration.alias != name -> next
                visibility :: if import.declaration.is_pub -> 2 else -> 1
                if !sema_registration_visible(visibility, requester_module, requester_package, module_row.module_identity, module_row.package_identity) -> return None
                symbol :: Symbol{id: symbol_id(SymbolKind.Import, module_row.module_identity, import.target_module_identity, name), kind: SymbolKind.Import, name: name.copy(), module_name: module_row.module_identity.copy(), owner: None, span: import.declaration.alias_span, ty: None, visibility: visibility}
                return Val(SemaRegistrationExport{name: name.copy(), symbol: ^symbol, declaration: None, source_module_identity: import.target_module_identity.copy(), visibility: visibility})
            }
        }
    }
    // A dependency package is bound through one member file;
    // a name belongs to whichever member of that package declares it.
    if sema_registration_package_is_namespace(module_row.package_identity) {
        loop (sibling_index, sibling) in graph.modules {
            if sibling_index == module_index || sibling.package_identity != module_row.package_identity -> next
            owned :: sema_registration_direct_symbol(sibling, name) ?? next
            if sema_registration_visible(owned.visibility, requester_module, requester_package, sibling.module_identity, sibling.package_identity) -> return Val(owned)
            return None
        }
    }
    // Core's authoritative export ledger also owns runtime builtin carriers
    // that have no source nominal declaration. Keep their builtin identity,
    // and never apply this rule to a user module with a Core-like name.
    private_native :: requester_module.starts_with("<corelib>/") && (sema_reserved_type_name(name) || core_record_literal_fields(name) != None)
    if module_row.module_identity.starts_with("<corelib>/") && (core_module_has_type(module_row.module_name, name) || private_native) {
        symbol :: sema_registration_named_symbol(module_row.module_identity, name, Span{start: 0, end: 0}, SymbolKind.Type, Val(Type.Named{name: name}), true, false)
        return Val(SemaRegistrationExport{name: name, symbol: symbol, declaration: None, source_module_identity: module_row.module_identity, visibility: 2})
    }
    None
}

// The loader emits one edge per source import, including each import declared
// inside an inline `module name { … }` body (its `source_scope`), so every
// such declaration is a source declaration of its file.
fn sema_registration_declared_import_spans(module_index: Int, imports: [ImportDecl], items: [Item], spans: &[String:Bool]) Never! {
    loop declaration in imports -> spans["{module_index}|{declaration.span.start}|{declaration.span.end}"] = true
    loop item in items {
        if item == .CodeModule(code_module) && code_module.body == .Val(body) -> sema_registration_declared_import_spans(module_index, code_module.imports, body, &spans)
    }
}

// The imports registered so far, by "{module}|{span start}|{span end}" and,
// for module (qualified) imports, by "{module}|{alias}": a duplicate or alias
// check per import scanned every registered import of its module, which a
// package of M files (two compiler-owned imports per sibling) made M³.
struct SemaRegistrationImportIndex {
    spans: [String:Bool]
    aliases: [String:Bool]
}

fn sema_registration_add_import(graph: &SemaRegistrationGraph, registered: &SemaRegistrationImportIndex, source_index: Int, declaration: ImportDecl, target_identity: String, target_package: String) {
    source_identity := graph.modules[source_index].module_identity
    source_package := graph.modules[source_index].package_identity
    visibility :: sema_registration_import_visibility(declaration)
    span_key :: "{source_index}|{declaration.span.start}|{declaration.span.end}"
    if registered.spans.get(span_key) != None {
        sema_registration_push_graph_diagnostic(&graph, source_index, sema_defined_twice(declaration.alias, "an import declaration must be registered once", declaration.span))
        return
    }
    qualified :: !sema_registration_import_is_unqualified(declaration)
    alias_key :: "{source_index}|{declaration.alias}"
    if qualified {
        if registered.aliases.get(alias_key) != None {
            sema_registration_push_graph_diagnostic(&graph, source_index, sema_defined_twice(declaration.alias, "module imports share one namespace alias", declaration.alias_span))
            return
        }
        if sema_registration_module_has_name(graph.modules[source_index], declaration.alias) {
            sema_registration_push_graph_diagnostic(&graph, source_index, sema_defined_twice(declaration.alias, "an import alias shares the module namespace", declaration.alias_span))
            return
        }
    }
    registered.spans[span_key] = true
    if qualified -> registered.aliases[alias_key] = true
    &graph.modules[source_index].imports.push(SemaRegistrationImport{source_module_identity: source_identity, source_package_identity: source_package, target_module_identity: target_identity, target_package_identity: target_package, declaration: declaration, visibility: visibility, bindings: [SemaRegistrationImportBinding]{}})
}

// Resolve each exact identity once per pass, including known absences (-1).
// The cache belongs to one graph with a fixed module order; import bindings
// retain their answer through graph clones and staged value application.
fn sema_registration_cached_module_index(graph: SemaRegistrationGraph, identity: String, indices: &[String:Int]) -> Int? {
    if indices.get(identity) == .Val(index) -> return if index < 0 -> None else -> Val(index)
    index :: sema_registration_module_index(graph, identity)
    indices[identity] = index ?? -1
    index
}

fn sema_registration_populate_imports(graph: &SemaRegistrationGraph, module_index: Int, import_module_indices: &[String:Int]) {
    source_identity := graph.modules[module_index].module_identity
    source_package := graph.modules[module_index].package_identity
    import_count :: graph.modules[module_index].imports.len()
    // The package names bind after this module's own
    // declarations and the imports before `namespace_from`; an import after
    // it (a foreign provider) can't take a package name.
    namespace_from :: if graph.modules[module_index].namespace_import_split < 0 -> import_count else -> graph.modules[module_index].namespace_import_split
    loop import_index in 0..<import_count {
        if import_index == namespace_from -> sema_registration_namespace_collisions(&graph, module_index, import_index)
        namespace_binds :: import_index >= namespace_from
        declaration := graph.modules[module_index].imports[import_index].declaration
        target_identity := graph.modules[module_index].imports[import_index].target_module_identity
        target_index :: sema_registration_cached_module_index(graph, target_identity, &import_module_indices) ?? {
            sema_registration_push_graph_diagnostic(&graph, module_index, sema_error("E0003", declaration.span, "the import target is not in the declaration graph", "qualified imports resolve through the exact loaded module identity", "retain the loader's source and module identity for this import"))
            next
        }
        // Only the target's name is kept: a whole-module copy per import made
        // registration imports × module size (the AST rides in the row).
        target_name :: graph.modules[target_index].module_name.copy()
        if declaration.kind == {
            .Unqualified(_, _, items, _, _) -> loop item in items {
                local :: sema_registration_import_local(item)
                // (Rust `core_list_path`): a member naming a
                // Core submodule (`use core.mem`, `core.encoding.[json]`) binds
                // that module as a namespace, exactly like `use core.mem as mem`.
                submodule :: "{target_name}.{item.original}"
                if (target_name == "core" || target_name.starts_with("core.")) && core_module_export(submodule) != None {
                    if sema_registration_module_has_name(graph.modules[module_index], local) || sema_registration_module_has_import_name(graph.modules[module_index], local) {
                        sema_registration_push_graph_diagnostic(&graph, module_index, sema_defined_twice(local, "imported names share the module namespace", declaration.span))
                        next
                    }
                    import_visibility :: graph.modules[module_index].imports[import_index].visibility
                    module_symbol :: Symbol{id: symbol_id(SymbolKind.Import, source_identity, submodule, local), kind: SymbolKind.Import, name: local, module_name: submodule, owner: None, span: declaration.span, ty: None, visibility: import_visibility}
                    submodule_index :: sema_registration_cached_module_index(graph, submodule, &import_module_indices)
                    sema_registration_push_import_binding(&graph, module_index, import_index, SemaRegistrationImportBinding{original: item.original, local: local, symbol: module_symbol, declaration: None, target_module_identity: submodule, target_module_index: submodule_index, visibility: import_visibility})
                    next
                }
                // A dependency package is one namespace: a member its import landed on stands for
                // the package, so a name another member file declares resolves through that file.
                export_index := target_index
                // (The namespace table, not the owner's symbol index: imports resolve before that
                // index exists.)
                if sema_registration_direct_symbol(graph.modules[target_index], item.original) == None {
                    slot :: graph.modules[target_index].namespace_slot
                    if slot >= 0 {
                        if graph.namespace_tables[slot].get(item.original) == .Val(entry) -> export_index = graph.namespace_entry_modules[entry]
                    }
                }
                resolved :: sema_registration_resolve_export(graph, export_index, item.original, source_identity, source_package, [String]{})
                if resolved == {
                    .Val(export) -> {
                        duplicate :: sema_registration_module_has_name(graph.modules[module_index], local) || sema_registration_module_has_import_name(graph.modules[module_index], local) || (namespace_binds && sema_registration_namespace_owner(graph, module_index, local) != None)
                        if {
                            duplicate -> sema_registration_push_graph_diagnostic(&graph, module_index, sema_defined_twice(local, "imported names share the module namespace", declaration.span))
                            else -> {
                                imported_symbol := export.symbol
                                imported_symbol.name = local
                                origin_index :: sema_registration_cached_module_index(graph, export.source_module_identity, &import_module_indices)
                                sema_registration_push_import_binding(&graph, module_index, import_index, SemaRegistrationImportBinding{original: item.original, local: local, symbol: imported_symbol, declaration: export.declaration, target_module_identity: export.source_module_identity, target_module_index: origin_index, visibility: export.visibility})
                                if declaration.is_pub || declaration.is_package_pub {
                                    &graph.modules[module_index].exports.push(SemaRegistrationExport{name: local, symbol: imported_symbol, declaration: export.declaration, source_module_identity: export.source_module_identity, visibility: if declaration.is_pub -> 2 else -> 1})
                                }
                            }
                        }
                    }
                    .None -> {
                        // (Rust CheckInner `core_list_path`
                        // Item): a Core module's ledger member with no source
                        // declaration (a host leaf such as
                        // `core.files.__host_path_join`) binds as a Core item
                        // import, also inside its own module. Its symbol is
                        // Foreign (no Jet declaration); calls route through
                        // the module's Core call records (Calls/Direct.jet).
                        if (target_name == "core" || target_name.starts_with("core.")) && core_module_has_member(target_name, item.original) && sema_registration_direct_symbol(graph.modules[target_index], item.original) == None {
                            if sema_registration_module_has_name(graph.modules[module_index], local) || sema_registration_module_has_import_name(graph.modules[module_index], local) || (namespace_binds && sema_registration_namespace_owner(graph, module_index, local) != None) {
                                sema_registration_push_graph_diagnostic(&graph, module_index, sema_defined_twice(local, "imported names share the module namespace", declaration.span))
                                next
                            }
                            leaf_identity :: graph.modules[target_index].module_identity.copy()
                            import_visibility :: graph.modules[module_index].imports[import_index].visibility
                            leaf_symbol :: Symbol{id: symbol_id(SymbolKind.Foreign, leaf_identity, "", item.original), kind: SymbolKind.Foreign, name: local, module_name: leaf_identity, owner: None, span: declaration.span, ty: None, visibility: import_visibility}
                            sema_registration_push_import_binding(&graph, module_index, import_index, SemaRegistrationImportBinding{original: item.original, local: local, symbol: leaf_symbol, declaration: None, target_module_identity: leaf_identity, target_module_index: Val(target_index), visibility: import_visibility})
                            next
                        }
                        direct :: sema_registration_direct_symbol(graph.modules[target_index], item.original)
                        private_template := false
                        if direct == .Val(private_export) {
                            if private_export.declaration == .Val(declared) {
                                if declared == .GenericModule(_) -> private_template = true
                            }
                        }
                        if {
                            private_template -> sema_registration_push_graph_diagnostic(&graph, module_index, sema_error("E0609", declaration.span, "`{item.original}` is private in module `{target_name}`", "only `pub` items can be brought into scope with `use`", "add `pub` before `module {item.original}` in the defining file"))
                            direct != None -> sema_registration_push_graph_diagnostic(&graph, module_index, sema_error("E0609", declaration.span, "`{item.original}` is private in module `{target_name}`", "only visible declarations can be selected through an import", "make the declaration public or keep the use in its defining module"))
                            else -> sema_registration_push_graph_diagnostic(&graph, module_index, sema_error("E0611", declaration.span, "`{item.original}` is not defined in module `{target_name}`", "an import member must name one registered declaration", "declare or import the member before selecting it"))
                        }
                    }
                }
            }
            else -> {
                duplicate :: sema_registration_module_has_name(graph.modules[module_index], declaration.alias) || sema_registration_module_has_import_name(graph.modules[module_index], declaration.alias) || (namespace_binds && sema_registration_namespace_owner(graph, module_index, declaration.alias) != None)
                if {
                    duplicate -> sema_registration_push_graph_diagnostic(&graph, module_index, sema_defined_twice(declaration.alias, "imported names share the module namespace", declaration.alias_span))
                    else -> {
                        import_visibility :: graph.modules[module_index].imports[import_index].visibility
                        module_symbol :: Symbol{id: symbol_id(SymbolKind.Import, source_identity, target_identity, declaration.alias), kind: SymbolKind.Import, name: declaration.alias, module_name: target_identity, owner: None, span: declaration.alias_span, ty: None, visibility: import_visibility}
                        sema_registration_push_import_binding(&graph, module_index, import_index, SemaRegistrationImportBinding{original: target_name, local: declaration.alias, symbol: module_symbol, declaration: None, target_module_identity: target_identity, target_module_index: Val(target_index), visibility: import_visibility})
                    }
                }
            }
        }
    }
    if namespace_from >= import_count -> sema_registration_namespace_collisions(&graph, module_index, import_count)
}

// A package name binds after the module's own declarations
// and the imports registered before the package names (`import_count` of
// them), as Rust consults `namespace_owner` last. A name one of those already
// binds stays theirs; the package binding of it is refused (E0105), reported
// at the declaration or import that holds the name.
fn sema_registration_namespace_collisions(graph: &SemaRegistrationGraph, module_index: Int, import_count: Int) {
    if graph.modules[module_index].namespace_slot < 0 -> return
    loop position in 0..<graph.modules[module_index].symbols.len() {
        name :: graph.modules[module_index].symbols[position].name
        if sema_registration_namespace_owner(graph, module_index, name) == None -> next
        span :: graph.modules[module_index].symbols[position].span
        sema_registration_push_graph_diagnostic(&graph, module_index, sema_defined_twice(name, "imported names share the module namespace", span))
    }
    loop import_index in 0..<import_count {
        loop binding_index in 0..<graph.modules[module_index].imports[import_index].bindings.len() {
            local :: graph.modules[module_index].imports[import_index].bindings[binding_index].local
            if sema_registration_namespace_owner(graph, module_index, local) == None -> next
            span :: graph.modules[module_index].imports[import_index].declaration.span
            sema_registration_push_graph_diagnostic(&graph, module_index, sema_defined_twice(local, "imported names share the module namespace", span))
        }
    }
}

fn sema_registration_module_has_nominal_name(module_row: SemaRegistrationModule, name: String) -> Bool Never! {
    loop nominal_index in 0..<module_row.nominals.len() {
        if module_row.nominals[nominal_index].symbol.name == name -> return true
    }
    false
}

// The module that receives a compiler-owned nominal: the entry module unless
// it declares that name itself, else the first module that does not.
fn sema_registration_compiler_builtin_module(graph: SemaRegistrationGraph, name: String) -> Int? {
    entry_index :: sema_registration_module_index(graph, graph.entry_module_identity)
    if entry_index == .Val(index) {
        if !sema_registration_module_has_nominal_name(graph.modules[index], name) -> return Val(index)
    }
    loop (index, module_row) in graph.modules {
        if !sema_registration_module_has_nominal_name(module_row, name) -> return Val(index)
    }
    None
}

fn sema_registration_inject_compiler_builtins(graph: &SemaRegistrationGraph) {
    original := SemaRegistrationRowRef?{None}
    loop (module_index, module_row) in graph.modules {
        loop (row, nominal) in module_row.nominals {
            if sema_registration_compiler_builtin_marker(nominal) != (Val(TCompilerBuiltin.DefaultErr)) -> next
            if original == .Val(_) || nominal.generic_params.len() != 0 {
                graph.internal_problem = Val("the original Prelude default error needs one nongeneric checked owner")
                graph.complete = false
                return
            }
            original = Val(SemaRegistrationRowRef{module_index: module_index, row: row})
        }
    }
    owner :: original ?? {
        graph.internal_problem = Val("the original Prelude error declaration supplier is missing")
        graph.complete = false
        return
    }
    // Resolve implicit compiler names to genuine ordinary declarations in the
    // marked owner's module; emitted aliases never choose this owner.
    loop (row, nominal) in graph.modules[owner.module_index].nominals {
        graph.compiler_builtin_rows[nominal.symbol.name] = SemaRegistrationRowRef{module_index: owner.module_index, row: row}
    }
    compiler_enums :: [String]{"Ordering", "RemoveBy", "TaskFailure", "UnitScaleProvenanceKind"}
    loop name in compiler_enums {
        variants :: sema_registration_compiler_owned_enum_variants(name) ?? panic("compiler-owned enum has no variant menu")
        module_index :: sema_registration_compiler_builtin_module(graph, name) ?? next
        module_identity := graph.modules[module_index].module_identity
        first_nominal :: graph.modules[module_index].nominals.len()
        &graph.modules[module_index].nominals.push(sema_registration_compiler_owned_enum(module_identity, name, variants))
        sema_registration_index_nominal_rows(&graph, module_index, first_nominal)
        graph.compiler_builtin_rows[name] = SemaRegistrationRowRef{module_index: module_index, row: first_nominal}
    }
    loop codec in ([MIRSerdeCodec#2]{.Encode, .Decode}) {
        reference :: mir_builtin_codec_trait_ref(codec)
        module_index :: sema_registration_compiler_builtin_module(graph, reference.name) ?? next
        module_identity :: graph.modules[module_index].module_identity
        first_nominal :: graph.modules[module_index].nominals.len()
        &graph.modules[module_index].nominals.push(sema_registration_compiler_owned_codec_trait(module_identity, reference))
        sema_registration_index_nominal_rows(&graph, module_index, first_nominal)
        graph.compiler_builtin_rows[reference.name] = SemaRegistrationRowRef{module_index: module_index, row: first_nominal}
    }
}

// Compiler names resolve to ordinary original Prelude declarations or the
// existing runtime enum rows. The DefaultErr role comes only from its marker.
fn sema_registration_compiler_builtin_row(graph: SemaRegistrationGraph, name: String) -> SemaRegistrationRowRef? {
    graph.compiler_builtin_rows.get(name)
}

// `counting` sets the graph's `counting` (#4319 lookup counters). The inputs
// are consumed: each program moves into its module row.
fn sema_registration_prepare_graph(inputs: ^[SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], package_identity: String, entry_module_identity: String, canonical_effect_module_identity: String, foreign_providers: [SemaForeignProviderInput], target_machine: MIRTargetMachine, build_facts: SemaBuildFacts, counting: Bool) -> SemaRegistrationGraph {
    modules := [SemaRegistrationModule]{}
    diagnostics := [Diagnostic]{}
    // Rust CheckInner `retain_error_prelude_module` runs first: the original
    // Prelude error declarations join the graph as their own compiler-generated
    // module, the only source of the DefaultErr marker. Then Rust Bundle:
    // inject_units_prelude, then resolve_unit_dimensions, before any module is
    // registered. The compiler-owned effect module is not a source module and
    // takes no catalog families.
    prepared_inputs := ^inputs
    sema_registration_retain_original_error_module(&prepared_inputs, &diagnostics)
    units_catalog :: sema_units_catalog(&diagnostics)
    units_names :: sema_units_catalog_names(units_catalog)
    loop index in 0..<prepared_inputs.len() {
        if prepared_inputs[index].module_identity == canonical_effect_module_identity -> next
        sema_units_inject(&prepared_inputs[index], units_catalog, units_names)
    }
    sema_units_resolve(&prepared_inputs, edges, &diagnostics)
    // Rust CheckInner `bind_marker_applications`: a directly used imported
    // marker binds to its declaring module before any module registers.
    // Each program binds in place; its bindings read every input in place.
    loop index in 0..<prepared_inputs.len() {
        bindings :: sema_marker_module_bindings(prepared_inputs, edges, prepared_inputs[index])
        sema_marker_module_bind_program(&prepared_inputs[index].program, bindings)
    }
    // Module identity -> row; duplicates are rejected below, so the first row
    // is the only row (Rust `Bundle/ItemReuse.rs` `by_identity`).
    module_rows := [String:Int]{}
    generic_module_index :: sema_generic_modules_index(prepared_inputs, edges)
    // User policies are package-scoped, so every module
    // of a package materializes the same checked declarations. Policies and
    // imported templates are read off every input in place first: the loop
    // below consumes the inputs, and a template module may precede its
    // importer.
    package_policies := [String:[UserPolicyDecl]]{}
    imported_templates := [[SemaGenericModuleSource]]{}
    loop index in 0..<prepared_inputs.len() {
        if package_policies.get(prepared_inputs[index].package_identity) == None -> package_policies[prepared_inputs[index].package_identity] = sema_policy_package_declarations(prepared_inputs, prepared_inputs[index].package_identity, &diagnostics)
        &imported_templates.push(sema_generic_modules_imported(prepared_inputs, edges, generic_module_index, prepared_inputs[index].module_identity))
    }
    // Only modules declaring a module alias or a generic module keep their
    // programs as written for the alias check after registration.
    written_inputs :: sema_generic_modules_written(prepared_inputs)
    // Each input moves out of the list (front to back) into its module row.
    &prepared_inputs.reverse()
    &imported_templates.reverse()
    loop prepared_inputs.len() > 0 {
        input := &prepared_inputs.pop() ?? break
        templates := &imported_templates.pop() ?? break
        policies :: package_policies.get(input.package_identity) ?? [UserPolicyDecl]{}
        module_row := sema_registration_prepare_module_row(^input, templates, policies, &diagnostics)
        duplicate :: module_rows.get(module_row.module_identity) != None
        if !duplicate -> module_rows[module_row.module_identity] = modules.len()
        if {
            duplicate -> &diagnostics.push(sema_defined_twice_optional(module_row.module_identity, "module identities must be unique in one declaration graph", None))
            else -> &modules.push(^module_row)
        }
    }
    if package_identity == "" || entry_module_identity == "" {
        &diagnostics.push(sema_error_optional("E0003", None, "the declaration graph is missing its package or entry identity", "cross-module lookup must use one exact graph identity", "provide the loader's canonical package and entry module identities"))
    }
    graph := SemaRegistrationGraph{package_identity: package_identity, entry_module_identity: entry_module_identity, canonical_effect_module_identity: canonical_effect_module_identity, target_machine: target_machine, build_facts: build_facts, modules: modules, module_rows: module_rows, edges: edges, foreign_providers: foreign_providers, core_builtin_owner_facts: sema_registration_core_builtin_owner_facts(), imports: [SemaRegistrationImport]{}, unit_facts: [SemaRegistrationUnitFact]{}, lookup_counters: shared SemaLookupCounters{module_lookups: 0, name_lookups: 0}, counting: counting, internal_problem: None, diagnostics: diagnostics, complete: diagnostics.len() == 0, callable_rows: [String:SemaRegistrationCallableRow]{}, nominal_row_slots: [String:Int]{}, nominal_row_buckets: [[SemaRegistrationRowRef]]{}, impl_row_slots: [String:Int]{}, impl_row_buckets: [[SemaRegistrationRowRef]]{}, nominal_symbol_rows: [String:SemaRegistrationRowRef]{}, codec_demand: shared SemaCodecDemand{keys: [String:Bool]{}, order: [String]{}}}
    sema_registration_index_all_nominal_rows(&graph)
    sema_registration_index_source_impls(&graph)
    sema_serde_index_codec_methods(&graph)
    sema_registration_index_namespaces(&graph)
    if entry_module_identity != "" && sema_registration_module_index(graph, entry_module_identity) == None {
        &graph.diagnostics.push(sema_error_optional("E0003", None, "the declaration graph entry is not loaded", "the entry identity must name one prepared module", "include the entry module in the loader's module inputs"))
    }
    canonical_effect_index :: sema_registration_module_index(graph, canonical_effect_module_identity)
    if canonical_effect_index == {
        .Val(effect_module_index) -> {
            // Read in place: a copy of the row would carry its whole program.
            if graph.modules[effect_module_index].package_identity != JET_CANONICAL_EFFECT_PACKAGE_IDENTITY || graph.modules[effect_module_index].module_path != JET_CANONICAL_EFFECT_MODULE_PATH {
                graph.internal_problem = Val("the canonical Prelude effect module identity does not match its pinned source owner")
                graph.complete = false
            }
            effect_declaration_count := 0
            loop item in graph.modules[effect_module_index].program.items {
                if item == {
                    .EffectDecl(_) -> effect_declaration_count += 1
                    else -> {}
                }
            }
            if effect_declaration_count == 0 {
                graph.internal_problem = Val("the canonical Prelude effect source has no declarations")
                graph.complete = false
            }
        }
        .None -> {
            graph.internal_problem = Val("the canonical Prelude effect declaration module is missing from the registration graph")
            graph.complete = false
        }
    }
    // Marker namespace/declaration laws precede import member registration and
    // generated rule bodies. The complete loader edge set detects ambiguous
    // qualified markers even when two imports share their local alias.
    if sema_marker_module_check(graph) == .Val(marker_diagnostics) {
        loop diagnostic in marker_diagnostics -> &graph.diagnostics.push(diagnostic)
        if marker_diagnostics.len() > 0 {
            graph.complete = false
            return graph
        }
    } else {
        graph.internal_problem = Val("the canonical Prelude marker registry is unavailable")
        graph.complete = false
        return graph
    }
    sema_registration_attach_namespace_impls(&graph)
    sema_registration_inject_compiler_builtins(&graph)
    graph.unit_facts = sema_registration_unit_facts(graph)

    // Source import spans by "{module}|{start}|{end}" (top-level and inline
    // `module name { use … }` imports alike) and edge spans by
    // "{source identity}|{start}|{end}", each built once: matching every edge
    // against its module's imports and every import against every edge made
    // registration M³ and M⁴ for a package of M files.
    declared_spans := [String:Bool]{}
    loop declared_module in 0..<graph.modules.len() -> sema_registration_declared_import_spans(declared_module, graph.modules[declared_module].program.imports, graph.modules[declared_module].program.items, &declared_spans)
    edge_spans := [String:Bool]{}
    loop edge in edges -> edge_spans["{edge.source_module_identity}|{edge.declaration.span.start}|{edge.declaration.span.end}"] = true
    registered := SemaRegistrationImportIndex{spans: [String:Bool]{}, aliases: [String:Bool]{}}
    loop edge in edges {
        source_index :: sema_registration_module_index(graph, edge.source_module_identity)
        target_index :: sema_registration_module_index(graph, edge.target_module_identity)
        if source_index == None || target_index == None {
            sema_registration_push_graph_diagnostic(&graph, source_index ?? -1, sema_error("E0003", edge.declaration.span, "an import edge names a module outside the loaded graph", "module and package identity are resolved before semantic registration", "retain both endpoint identities from the loader"))
            next
        }
        source_module_index :: source_index ?? 0
        declared :: declared_spans.get("{source_module_index}|{edge.declaration.span.start}|{edge.declaration.span.end}") != None
        if {
            !declared -> sema_registration_push_graph_diagnostic(&graph, source_module_index, sema_error("E0003", edge.declaration.span, "an import edge has no source declaration", "semantic preparation only registers imports present in the source program", "retain the original ImportDecl when constructing the resolved edge"))
            edge.target_package_identity != "" && edge.target_package_identity != graph.modules[target_index ?? 0].package_identity -> sema_registration_push_graph_diagnostic(&graph, source_module_index, sema_error("E0003", edge.declaration.span, "an import edge has the wrong target package identity", "package visibility follows the loaded target module identity", "copy the target package identity from the resolved module"))
            else -> {
                if edge.source_scope != "" -> next
                target_package := edge.target_package_identity
                if target_package == "" -> target_package = graph.modules[target_index ?? 0].package_identity
                sema_registration_add_import(&graph, &registered, source_module_index, edge.declaration, edge.target_module_identity, target_package)
            }
        }
    }
    module_index := 0
    loop module_index < graph.modules.len() {
        // Every source import must have one exact edge. A missing edge is not
        // recovered by matching a module name or alias.
        import_count :: graph.modules[module_index].program.imports.len()
        loop import_index in 0..<import_count {
            declaration := graph.modules[module_index].program.imports[import_index]
            found :: edge_spans.get("{graph.modules[module_index].module_identity}|{declaration.span.start}|{declaration.span.end}") != None
            if !found {
                sema_registration_push_graph_diagnostic(&graph, module_index, sema_error("E0003", declaration.span, "an import declaration has no resolved graph edge", "semantic preparation never resolves private or dependency imports by bare name", "provide the loader-resolved target module identity"))
            }
        }
        module_index += 1
    }
    import_module_indices := [String:Int]{}
    module_index = 0
    loop module_index < graph.modules.len() {
        sema_registration_populate_imports(&graph, module_index, &import_module_indices)
        sema_inline_modules_check_imports(&graph, module_index)
        module_index += 1
    }
    sema_registration_canonicalize_qualified_types(&graph)
    module_index = 0
    loop module_index < graph.modules.len() {
        loop import_index in 0..<graph.modules[module_index].imports.len() {
            import := graph.modules[module_index].imports[import_index]
            &graph.imports.push(import)
        }
        module_index += 1
    }
    sema_type_alias_cycles_check(&graph)
    graph.complete = !sema_has_error_since(graph.diagnostics, 0)
    // Generic-module aliases resolve and check their
    // arguments once every import is bound (Rust's expansion pre-pass).
    sema_generic_modules_check(&graph, written_inputs)
    graph.complete = !sema_has_error_since(graph.diagnostics, 0)
    // Rust erases templates and aliases once expanded: their symbols stay
    // registered, but no later pass sees an unexpanded body. They are removed
    // in place; every other item stays where it is, uncopied.
    loop erased_index in 0..<graph.modules.len() {
        item_index := 0
        loop item_index < graph.modules[erased_index].program.items.len() {
            if sema_registration_item_is_expanded_template(graph.modules[erased_index].program.items[item_index]) {
                _ := &graph.modules[erased_index].program.items.remove(item_index, .Slot)
            } else {
                item_index += 1
            }
        }
    }
    // User derives and declared marker
    // bodies expand over the complete graph's reflection and register their
    // generated items before any body is checked.
    own_symbols :: loop row_index in 0..<graph.modules.len() -> graph.modules[row_index].symbols.len()
    items_before := 0
    loop row_index in 0..<graph.modules.len() -> items_before += graph.modules[row_index].program.items.len()
    sema_registration_expand_user_templates(&graph)
    items_after := 0
    loop row_index in 0..<graph.modules.len() -> items_after += graph.modules[row_index].program.items.len()
    sema_registration_bind_namespaces(&graph, own_symbols, items_after != items_before)
    sema_registration_index_callables(&graph)
    sema_registration_index_impl_traits(&graph)
    // Rust CheckInner check_guest_import_surface / check_guest_export_surface /
    // check_guest_symbol_collisions: the C guest boundary is checked once every
    // declaration is registered, before any body is checked.
    sema_guest_check_surfaces(&graph)
    graph
}

fn sema_registration_item_is_expanded_template(item: Item) -> Bool Never! {
    if item == {
        .GenericModule(_) | .ModuleAlias(_) -> true
        else -> false
    }
}

// Appends to `words` each identifier-shaped word of `bytes[start..<end]` that
// `seen` does not hold yet, and records it there: maximal runs of ASCII
// letters, digits and `_`, and of non-ASCII bytes, so a multi-byte letter
// stays inside its word. Comments and strings count too, so the words are a
// superset of the names the range spells (namespace reach).
fn sema_source_words(bytes: [U8], start: Int, end: Int, seen: &[String:Bool], words: &[String]) Never! {
    stop :: if end < bytes.len() -> end else -> bytes.len()
    cursor := if start > 0 -> start else -> 0
    loop cursor < stop {
        if !sema_source_word_byte(bytes[cursor]) {
            cursor += 1
            next
        }
        word_start :: cursor
        loop cursor < stop && sema_source_word_byte(bytes[cursor]) -> cursor += 1
        word :: String.from_bytes(bytes.slice(word_start, cursor)) ?? next
        if seen.get(word) != None -> next
        seen[word] = true
        &words.push(word)
    }
}

fn sema_source_word_byte(byte: U8) -> Bool Never! {
    n :: Int.from_u8(byte)
    n >= 128 || n == 95 || (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122)
}

// Numbers every package namespace name once, per package one
// name -> entry table (Rust `NameLedger` namespace names). Entries run in
// module order, then declaration order; the loader already rejected a name
// two members declare (E0624). The tables are filled from rows sorted by
// (slot, name, entry), so each insert appends (SemaRegistrationKeyedRow).
struct SemaRegistrationNamespaceName {
    slot: Int
    name: String
    entry: Int
}

fn sema_registration_index_namespaces(graph: &SemaRegistrationGraph) Never! {
    rows := [SemaRegistrationNamespaceName]{}
    loop module_index in 0..<graph.modules.len() {
        namespace :: graph.modules[module_index].namespace
        if namespace == "" -> next
        slot := graph.namespace_slots.get(namespace) ?? -1
        if slot < 0 {
            slot = graph.namespace_tables.len()
            graph.namespace_slots[namespace] = slot
            &graph.namespace_tables.push([String:Int]{})
            &graph.namespace_entries.push([Int]{})
        }
        graph.modules[module_index].namespace_slot = slot
        loop name_index in 0..<graph.modules[module_index].namespace_names.len() {
            name :: graph.modules[module_index].namespace_names[name_index]
            entry :: graph.namespace_entry_modules.len()
            // copy: the sorted rows fill the tables; the entry list keeps the name.
            &rows.push(SemaRegistrationNamespaceName{slot: slot, name: name.copy(), entry: entry})
            &graph.namespace_entries[slot].push(entry)
            &graph.namespace_entry_modules.push(module_index)
            &graph.namespace_entry_names.push(name)
        }
    }
    &rows.sort_by((left: SemaRegistrationNamespaceName, right: SemaRegistrationNamespaceName) -> (left.slot <=> right.slot).then(left.name <=> right.name).then(left.entry <=> right.entry))
    loop at in 0..<rows.len() -> graph.namespace_tables[rows[at].slot][rows[at].name] = rows[at].entry
}

// (Rust `NameLedger::namespace_owner`): the registered symbol
// row of `name` in the other member of `module_index`'s package that
// declares it, or none (no namespace, the module's own name, or a
// declaration that did not register).
fn sema_registration_namespace_owner(graph: SemaRegistrationGraph, module_index: Int, name: String) -> SemaRegistrationRowRef? Never! {
    slot :: graph.modules[module_index].namespace_slot
    if slot < 0 -> return None
    entry :: graph.namespace_tables[slot].get(name) ?? return None
    owner :: graph.namespace_entry_modules[entry]
    if owner == module_index -> return None
    row :: graph.modules[owner].symbol_positions.get(name) ?? return None
    Val(SemaRegistrationRowRef{module_index: owner, row: row})
}

// The sibling declarations each package member's module
// scope binds (`namespace_bindings`), in entry order. They are the namespace
// names its source can reach (the loader's `namespace_refs`) and those the
// Prelude derive templates spell, since derived items expand into the
// module; every namespace name when its items come from a template declared
// elsewhere (`namespace_full`, or any user template expansion: `templated`).
// A name the module declared before its imports registered (`own_symbols`
// rows) or imports binds there instead (sema_registration_namespace_collisions).
fn sema_registration_bind_namespaces(graph: &SemaRegistrationGraph, own_symbols: [Int], templated: Bool) {
    if graph.namespace_tables.len() == 0 -> return
    derive_seen := [String:Bool]{}
    derive_words := [String]{}
    source :: SEMA_PRELUDE_DERIVE_SOURCE.bytes()
    sema_source_words(source, 0, source.len(), &derive_seen, &derive_words)
    loop module_index in 0..<graph.modules.len() {
        slot :: graph.modules[module_index].namespace_slot
        if slot < 0 -> next
        entries := [Int]{}
        if templated || graph.modules[module_index].namespace_full {
            entries = graph.namespace_entries[slot]
        } else {
            loop name in graph.modules[module_index].namespace_refs {
                if graph.namespace_tables[slot].get(name) == .Val(entry) -> &entries.push(entry)
            }
            loop name in derive_words {
                if graph.namespace_tables[slot].get(name) == .Val(entry) -> &entries.push(entry)
            }
            &entries.sort()
        }
        bindings := [SemaRegistrationRowRef]{}
        previous := -1
        loop entry in entries {
            if entry == previous -> next
            previous = entry
            name :: graph.namespace_entry_names[entry]
            own :: graph.modules[module_index].symbol_positions.get(name) ?? -1
            if (own >= 0 && own < own_symbols[module_index]) || graph.modules[module_index].import_binding_rows.get(name) != None -> next
            owner :: sema_registration_namespace_owner(graph, module_index, name) ?? next
            &bindings.push(owner)
        }
        graph.modules[module_index].namespace_bindings = bindings
    }
}

fn sema_registration_lookup_name(graph: SemaRegistrationGraph, module_identity: String, name: String) -> SemaRegistrationResolvedSymbol? {
    if graph.counting {
        counters := graph.lookup_counters
        permit :: counters.guard_edit()
        permit.value.name_lookups += 1
    }
    module_index :: sema_registration_module_index(graph, module_identity) ?? return None
    // The module is passed as a place to a read parameter: binding it here
    // copied the whole module (its program and tables) on every lookup.
    local :: sema_registration_lookup_module_name(graph.modules[module_index], module_index, module_identity, name)
    if local != None -> return local
    if sema_registration_namespace_owner(graph, module_index, name) == .Val(owner) {
        return Val(SemaRegistrationResolvedSymbol{symbol: graph.modules[owner.module_index].symbols[owner.row], source_module_identity: graph.modules[owner.module_index].module_identity, target_module_identity: graph.modules[owner.module_index].module_identity, visibility: graph.modules[owner.module_index].symbols[owner.row].visibility, nominal_row: sema_registration_symbol_nominal_row(graph.modules[owner.module_index], owner.module_index, owner.row)})
    }
    builtin :: sema_registration_compiler_builtin_row(graph, name) ?? return None
    nominal_symbol :: graph.modules[builtin.module_index].nominals[builtin.row].symbol
    Val(SemaRegistrationResolvedSymbol{symbol: nominal_symbol, source_module_identity: nominal_symbol.module_name, target_module_identity: nominal_symbol.module_name, visibility: nominal_symbol.visibility, nominal_row: Val(builtin)})
}

// The nominal row `symbols[position]` of module row `module_index`
// registered, as a graph row reference; None for a symbol without one.
fn sema_registration_symbol_nominal_row(module_row: SemaRegistrationModule, module_index: Int, position: Int) -> SemaRegistrationRowRef? Never! {
    row :: module_row.symbol_nominal_rows[position]
    if row < 0 -> return None
    Val(SemaRegistrationRowRef{module_index: module_index, row: row})
}

// A name declared or imported by one module.
fn sema_registration_lookup_module_name(module_row: SemaRegistrationModule, module_index: Int, module_identity: String, name: String) -> SemaRegistrationResolvedSymbol? {
    if module_row.symbol_positions.get(name) == .Val(symbol_position) {
        return Val(SemaRegistrationResolvedSymbol{symbol: module_row.symbols[symbol_position], source_module_identity: module_identity, target_module_identity: module_identity, visibility: module_row.symbols[symbol_position].visibility, nominal_row: sema_registration_symbol_nominal_row(module_row, module_index, symbol_position)})
    }
    if module_row.import_binding_rows.get(name) == .Val(binding_ref) {
        return sema_registration_resolved_import_binding(module_row.imports[binding_ref.import_index].bindings[binding_ref.binding])
    }
    None
}

fn sema_registration_resolved_import_binding(binding: SemaRegistrationImportBinding) -> SemaRegistrationResolvedSymbol? Never! {
    Val(SemaRegistrationResolvedSymbol{symbol: binding.symbol, source_module_identity: binding.target_module_identity, target_module_identity: binding.target_module_identity, visibility: binding.visibility})
}

fn sema_registration_lookup_qualified(graph: SemaRegistrationGraph, module_identity: String, alias: String, name: String) -> SemaRegistrationResolvedSymbol? {
    module_index :: sema_registration_module_index(graph, module_identity) ?? return None
    module_row :: graph.modules[module_index]
    loop import in module_row.imports {
        if import.declaration.alias != alias -> next
        target_index :: sema_registration_module_index(graph, import.target_module_identity) ?? return None
        resolved :: sema_registration_resolve_export(graph, target_index, name, module_identity, module_row.package_identity, [String]{}) ?? return None
        return Val(SemaRegistrationResolvedSymbol{symbol: resolved.symbol, source_module_identity: resolved.source_module_identity, target_module_identity: import.target_module_identity, visibility: resolved.visibility})
    }
    None
}

// The default expression `reference` names. Its owner is one keyed
// `callable_rows` lookup (Rust `CallBinder` default slot of the resolved
// signature); trait method declarations, which are not callable rows, are
// searched only when the owner is not one.
fn sema_registration_resolve_default(graph: SemaRegistrationGraph, reference: FunctionDefaultRef) -> Expr? {
    if graph.callable_rows.get(reference.owner_key) == .Val(row) {
        if row == {
            .Function(module_index, index) -> {
                if reference.source_file != "" {
                    source :: sema_source_file_at(graph.modules[module_index].source_segments, graph.modules[module_index].source_file, graph.modules[module_index].source_origin, reference.span)
                    if source != reference.source_file -> return None
                }
                return sema_registration_parameter_default(graph.modules[module_index].functions[index].parameters, reference)
            }
            .NominalMethod(module_index, owner, index) -> return sema_registration_parameter_default(graph.modules[module_index].nominals[owner].methods[index].parameters, reference)
            .ImplMethod(module_index, owner, index) -> return sema_registration_parameter_default(graph.modules[module_index].impls[owner].methods[index].parameters, reference)
            .Foreign(_, _) -> {}
        }
    }
    loop module_row_index in 0..<graph.modules.len() {
        loop nominal_index in 0..<graph.modules[module_row_index].nominals.len() {
            loop method_index in 0..<graph.modules[module_row_index].nominals[nominal_index].trait_methods.len() {
                if graph.modules[module_row_index].nominals[nominal_index].trait_methods[method_index].symbol.id.key == reference.owner_key -> return sema_registration_parameter_default(graph.modules[module_row_index].nominals[nominal_index].trait_methods[method_index].parameters, reference)
            }
        }
    }
    None
}

fn sema_registration_parameter_default(parameters: [SemaRegistrationParameter], reference: FunctionDefaultRef) -> Expr? {
    if reference.parameter_index < 0 || reference.parameter_index >= parameters.len() -> return None
    parameter :: parameters[reference.parameter_index]
    if parameter.default_ref != reference -> return None
    parameter.default
}

fn sema_registration_apply_graph_module(graph: SemaRegistrationGraph, module_identity: String, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    waiting := [SemaScopeProbeConstant]{}
    sema_registration_apply_graph_module_rows(graph, module_identity, &scopes, &diagnostics, &waiting)
}

// sema_registration_apply_graph_module that also records in `waiting` each
// binding it pushes for a constant still waiting for its known-time type,
// with the graph row the binding was copied from. The module's package
// names (`namespace_bindings`) bind after its own declarations and the
// imports before `namespace_import_split`, as Rust consults
// `namespace_owner` after locals and imports.
fn sema_registration_apply_graph_module_rows(graph: SemaRegistrationGraph, module_identity: String, scopes: &SemaScopeTable, diagnostics: &[Diagnostic], waiting: &[SemaScopeProbeConstant]) -> Bool {
    module_index :: sema_registration_module_index(graph, module_identity) ?? return false
    module_row :: graph.modules[module_index]
    complete := true
    sema_scope_seed_unit_policy(&scopes, graph, module_identity)
    if !sema_scope_add_compiler_builtin(&scopes, graph) -> complete = false
    loop (position, symbol) in module_row.symbols {
        if !sema_scope_add_module_symbol(&scopes, symbol) {
            &diagnostics.push(sema_diagnostic_with_source_location(sema_defined_twice(symbol.name, "module declarations share one namespace", symbol.span), module_row.source_segments))
            complete = false
        } else if sema_comptime_symbol_waits(symbol) {
            &waiting.push(SemaScopeProbeConstant{binding: scopes.bindings.len() - 1, source: SemaScopeProbeSource.Symbol{position: position}})
        }
    }
    namespace_from :: if module_row.namespace_import_split < 0 -> module_row.imports.len() else -> module_row.namespace_import_split
    loop (import_index, import) in module_row.imports {
        if import_index == namespace_from && !sema_registration_apply_namespace(graph, module_index, &scopes, &diagnostics, &waiting) -> complete = false
        loop (binding_index, binding) in import.bindings {
            if !sema_scope_add_module_symbol(&scopes, binding.symbol) {
                &diagnostics.push(sema_diagnostic_with_source_location(sema_defined_twice(binding.local, "imported names share the module namespace", binding.symbol.span), module_row.source_segments))
                complete = false
            } else if sema_comptime_symbol_waits(binding.symbol) {
                &waiting.push(SemaScopeProbeConstant{binding: scopes.bindings.len() - 1, source: SemaScopeProbeSource.Import{import_index: import_index, binding: binding_index}})
            }
        }
    }
    if namespace_from >= module_row.imports.len() && !sema_registration_apply_namespace(graph, module_index, &scopes, &diagnostics, &waiting) -> complete = false
    complete
}

// Binds the module's package names (`namespace_bindings`), each from its
// declaring member's current symbol row.
fn sema_registration_apply_namespace(graph: SemaRegistrationGraph, module_index: Int, scopes: &SemaScopeTable, diagnostics: &[Diagnostic], waiting: &[SemaScopeProbeConstant]) -> Bool {
    complete := true
    loop owner_index in 0..<graph.modules[module_index].namespace_bindings.len() {
        symbol :: graph.modules[graph.modules[module_index].namespace_bindings[owner_index].module_index].symbols[graph.modules[module_index].namespace_bindings[owner_index].row]
        if !sema_scope_add_module_symbol(&scopes, symbol) {
            &diagnostics.push(sema_diagnostic_with_source_location(sema_defined_twice(symbol.name, "imported names share the module namespace", symbol.span), graph.modules[module_index].source_segments))
            complete = false
        } else if sema_comptime_symbol_waits(symbol) {
            &waiting.push(SemaScopeProbeConstant{binding: scopes.bindings.len() - 1, source: SemaScopeProbeSource.Namespace{module_index: graph.modules[module_index].namespace_bindings[owner_index].module_index, position: graph.modules[module_index].namespace_bindings[owner_index].row}})
        }
    }
    complete
}
