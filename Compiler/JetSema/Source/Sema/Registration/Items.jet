// Canonical declaration registration and module-graph preparation.
//
// This layer owns declaration identity and graph edges only. Types and the checked tree remain
// Foundation-owned; callable signatures are projected by Declarations.jet and
// defaults remain AST references keyed by FunctionDefaultRef.
use {
    unicode: core.text
    jet_foundation.[
        symbol_builtin_keys,
        AST_NODE_GENERATED,
        AccessConvention,
        CORE_SOURCE_OWNED_ROWS,
        BodyCodecIn,
        CODABLE_TAG,
        CallContractRow,
        CallablePolicy,
        CallablePolicyChain,
        CompilerThreads,
        ConstDef,
        DeclID,
        DeclTable,
        MARKER_ARG,
        MARKER_AS,
        MARKER_CLI,
        MARKER_DEPRECATED,
        MARKER_DOC,
        MARKER_OPEN,
        MARKER_RENAME,
        codable_form,
        codable_marker,
        codable_option,
        codable_tag_field,
        decl_id_index,
        decl_table_add,
        decl_table_find,
        decl_table_find_symbol,
        decl_table_index,
        Diagnostic,
        Dimension,
        DimensionAxis,
        EFFECT_VOCABULARY_LEAVES,
        EffectRowEntry,
        EnumDef,
        EnumGroup,
        Expr,
        ExternFn,
        Field,
        Func,
        FunctionCallMetadata,
        FunctionDefaultRef,
        ImplDef,
        ImportDecl,
        ImportedItem,
        ImportKind,
        InternalTag,
        Item,
        SerdeCodec,
        TraitRef,
        TargetMachine,
        Marker,
        Measure,
        ModuleCap,
        NamedSpan,
        NamedType,
        NameTable,
        OperatorMarker,
        Param,
        ParamZone,
        Program,
        QuantityKind,
        SerdeWireShape,
        Span,
        StructDef,
        StructureFact,
        SYMBOL_LOCAL_BOUND,
        Symbol,
        SymbolID,
        SymbolKeys,
        SymbolKind,
        SymbolTable,
        TagMarker,
        TraitImplBlock,
        TraitMethodSig,
        Type,
        TypeParam,
        TypeTupleField,
        UnitFamilyDef,
        UnitRatio,
        UnitScaleProvenance,
        UserPolicyDecl,
        Variant,
        Stmt,
        VariantPayload,
        ast_program,
        compiler_apply_order,
        compiler_threads_admit,
        compiler_threads_joined,
        compiler_threads_slot_taken,
        compiler_threads_taken,
        compiler_threads_heaviest_first,
        compiler_threads_partition,
        compiler_transfer_rows,
        core_module_export,
        core_module_has_member,
        core_module_has_type,
        core_record_literal_fields,
        core_source_owns_type,
        expr_span,
        core_bare_source_module,
        ir_runtime_handle_row,
        builtin_codec_trait_ref,
        ModuleID,
        ModuleTable,
        NamedCtValue,
        module_count,
        module_find,
        module_index,
        module_intern,
        module_is_core,
        module_is_none,
        module_none,
        module_text,
        name_count,
        name_find,
        name_find_bytes,
        name_find_hashed,
        name_index,
        name_intern,
        name_intern_hashed,
        name_pair_slot,
        name_table,
        name_table_sized,
        name_text,
        name_text_hash,
        owned_trait_codec,
        owned_trait_codec_marker,
        owned_trait_is_operator,
        owned_trait_keyed_by_argument,
        sema_reserved_type_name,
        checked_test_artifact_key,
        symbol_builtin,
        symbol_builtin_declared,
        symbol_find,
        symbol_intern,
        symbol_is_local,
        symbol_key_text,
        symbol_keys,
        symbol_mint,
        symbol_none,
        symbol_table_key,
        symbol_table_of,
        symbol_table_open,
        type_identity_key,
        type_id_named,
        type_name,
        type_structural_family,
        type_structural_head_names,
        type_with_effective_parameter_fn_return,
        unit_family_distinct_defs,
        CModule,
        Interner,
        interner,
        TCompilerBuiltin,
        foundation_byte_text,
        jet_target_machine_hosted,
    ]
    jet_parser.[
        jfmt_decode_shapes,
        parse_generated_source,
        parse_type_text,
        parser_line_starts,
    ]
}

JET_CANONICAL_EFFECT_PACKAGE_IDENTITY: "jet:canonical-prelude"

JET_CANONICAL_EFFECT_MODULE_PATH: "Prelude/Effects.jet"

SemaRegistrationNominalKind: enum {
    Struct,
    Enum,
    Distinct,
    TypeAlias,
    Trait,
    Tag,
    UnitFamily,
    ForeignHandle,
}

SemaRegistrationForeignHandleFacts: struct {
    library: String,
    typedef_name: String,
    jet_name: String,
    ownership: String,
    close: String,
    close_source: String,
    thread_safety: String,
    send: Bool,
    sync: Bool,
    close_function_key: String?,
    source_span: Span,
}

SemaRegistrationNominalSource: enum {
    SourceAST(value: Item),
    ForeignHandle(value: SemaRegistrationForeignHandleFacts),
    CompilerBuiltinTrait(value: TraitRef),
}

SemaRegistrationUnitFact: struct {
    name: String,
    package: String,
    family: String,
    member: String,
    dimension: Dimension?,
    scale: UnitRatio,
    scale_provenance: UnitScaleProvenance,
    offset: UnitRatio,
    kind: QuantityKind,
}

sema_registration_compiler_owned_default_err_provenance: fn() -> String Never! {
    "compiler_owned_default_err"
}

sema_registration_compiler_owned_enum_provenance: fn() -> String Never! { "compiler_owned_enum" }

// `kilo_meter` -> `KiloMeter`: the `_` separators dropped and the first byte
// of each piece upper-cased when it is `a`..`z`, in one pass over the bytes.
sema_registration_unit_type_name: fn(name: String) -> String Never! {
    output := [U8]{}
    piece_start := true
    loop byte in name.bytes() {
        if byte == (U8{95}) {
            piece_start = true
            next
        }
        if {
            piece_start && byte >= (U8{97}) && byte <= (U8{122}) -> output.push(U8{Int{byte} - 32})
            else -> output.push(byte)
        }
        piece_start = false
    }
    if output.is_empty() -> return name.copy()
    String.from_bytes(output) ?? name.copy()
}

sema_registration_unit_leaf_name: fn(ty: Type) -> String? {
    if ty == {
        .Tagged(_, inner) -> return sema_registration_unit_leaf_name(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    name: if ty == {
        .Named(value) -> Val(value)
        .Apply(value, _) -> Val(value)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
    name_value: name ?? return None
    if name_value.count_bytes() == 0 -> return None
    dot: name_value.rfind(".")
    if dot < 0 -> return Val(name_value)
    Val(name_value.slice((dot + 1)..<name_value.count_bytes()))
}

// One fact per unit type of each package: packages may mint the same leaf
// (`tick` in two families), and each keeps its own family and dimension.
sema_registration_unit_fact_push: fn(facts: ^[SemaRegistrationUnitFact], fact: SemaRegistrationUnitFact) Never! {
    loop existing in facts {
        if existing.name == fact.name && existing.package == fact.package {
            return
        }
    }
    facts.push(fact.copy())
}

sema_registration_unit_family_facts: fn(definition: UnitFamilyDef, facts: ^[SemaRegistrationUnitFact]) Never! {
    package: definition.resolved_owner ?? return
    if definition.base == None && definition.resolved_dimension == None {
        return
    }
    has_offset_member: loop member in definition.members {
        if member.offset.numerator != 0 {
            break true
        }
    } ?? false
    affine: definition.base != None && has_offset_member
    loop member in definition.members {
        base_name: sema_registration_unit_type_name(member.name)
        names: if affine -> [String]{"{base_name}Point", "{base_name}Delta"} else -> [String]{base_name}
        kinds: if affine -> [QuantityKind]{QuantityKind.Point, QuantityKind.Delta} else -> [QuantityKind]{QuantityKind.Linear}
        loop (index, name) in names {
            offset := UnitRatio{numerator: 0, denominator: 1}
            if kinds[index] == QuantityKind.Point -> offset = member.offset
            sema_registration_unit_fact_push(
                facts,
                SemaRegistrationUnitFact{
                    name: name,
                    package: package.copy(),
                    family: definition.family,
                    member: member.name,
                    dimension: definition.resolved_dimension,
                    scale: member.scale,
                    scale_provenance: member.scale_provenance,
                    offset: offset,
                    kind: kinds[index],
                },
            )
        }
    }
}

// The nominal types a unit family declares, each at its member's name: one
// per member, or a `Point` and a `Delta` per member of an affine family.
sema_registration_unit_family_type_names: fn(definition: UnitFamilyDef) -> [NamedSpan] Never! {
    has_offset_member: loop member in definition.members {
        if member.offset.numerator != 0 {
            break true
        }
    } ?? false
    affine: definition.base != None && has_offset_member
    names := [NamedSpan]{}
    loop member in definition.members {
        base_name: sema_registration_unit_type_name(member.name)
        if affine {
            names.push(NamedSpan{name: "{base_name}Point", span: member.name_span})
            names.push(NamedSpan{name: "{base_name}Delta", span: member.name_span})
        } else { names.push(NamedSpan{name: base_name, span: member.name_span}) }
    }
    names
}

// The compiler-owned unit facts every program has, before any family's:
// core.units' `Duration` and `Instant` carriers on the Time axis.
sema_registration_builtin_unit_facts: fn() -> [SemaRegistrationUnitFact] Never! {
    time_dimension: Val(Dimension{axes: [DimensionAxis]{DimensionAxis{name: "core.units.Time", exponent: Measure.SignedLiteral{kind: "dimension", value: 1}}}})
    [SemaRegistrationUnitFact]{
        SemaRegistrationUnitFact{name: "Duration", package: "core.units", family: "Time", member: "ns", dimension: time_dimension, scale: UnitRatio{numerator: 1, denominator: 1}, scale_provenance: UnitScaleProvenance.Rational, offset: UnitRatio{numerator: 0, denominator: 1}, kind: QuantityKind.Delta},
        SemaRegistrationUnitFact{name: "Instant", package: "core.units", family: "Time", member: "ns", dimension: time_dimension, scale: UnitRatio{numerator: 1, denominator: 1}, scale_provenance: UnitScaleProvenance.Rational, offset: UnitRatio{numerator: 0, denominator: 1}, kind: QuantityKind.Point},
    }
}

sema_registration_unit_facts: fn(graph: SemaRegistrationGraph) -> [SemaRegistrationUnitFact] Never! {
    facts := sema_registration_builtin_unit_facts()
    loop module_row_index in 0..<graph.modules.len() {
        loop item_index in 0..<graph.modules[module_row_index].program.items.len() {
            if graph.modules[module_row_index].program.items[item_index] == {
                .UnitFamily(definition) -> sema_registration_unit_family_facts(definition, facts)
                .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
            }
        }
    }
    facts
}

// A module-qualified name resolves through its declaring module's registry,
// so the compiler-owned `Duration`/`Instant` time rows name only the bare
// built-in carriers: Core/Time's source struct `Instant`, under its Core
// module identity, is a nominal with Comparable/Equatable hooks, not the
// core.units point.
sema_registration_unit_fact_for_type: fn(graph: SemaRegistrationGraph, ty: Type) -> SemaRegistrationUnitFact? {
    name: sema_registration_unit_leaf_name(ty) ?? return None
    if graph.unit_facts.len() == 2 && name != "Duration" && name != "Instant" -> return None
    unit_name: name_find(graph.unit_fact_names, name) ?? return None
    slot: Int{unit_name.id}
    qualified: sema_registration_unit_type_is_qualified(ty)
    owner := String?{None}
    owner_read := false
    loop bucket_index in 0..<graph.unit_fact_buckets[slot].len() {
        fact_index: graph.unit_fact_buckets[slot][bucket_index]
        if qualified && sema_registration_unit_fact_is_builtin_time(graph.unit_facts[fact_index]) {
            next
        }
        // A module-qualified unit type names its declaring package's fact.
        if qualified {
            if !owner_read {
                owner = sema_registration_unit_type_package(graph, ty)
                owner_read = true
            }
            if owner == .Val(package) && graph.unit_facts[fact_index].package != package -> next
        }
        return Val(graph.unit_facts[fact_index])
    }
    None
}

// A type a `#UnitFamily` member minted. A nominal family (`#UnitFamily(Currency)
// { usd }`) has no conversion or dimension fact, yet its `Usd` is a unit
// value all the same: it shows its magnitude and the member that minted it.
sema_registration_unit_member_type: fn(graph: SemaRegistrationGraph, ty: Type) -> Bool Never! {
    if sema_registration_unit_fact_for_type(graph, ty) != None -> return true
    if !graph.has_unit_families -> return false
    name: sema_registration_unit_leaf_name(ty) ?? return false
    if name_find(graph.unit_member_names, name) == None -> return false
    owner: if sema_registration_unit_type_is_qualified(ty) -> sema_registration_unit_type_package(graph, ty) else -> None
    loop module_row_index in 0..<graph.modules.len() {
        loop item_index in 0..<graph.modules[module_row_index].program.items.len() {
            if graph.modules[module_row_index].program.items[item_index] == .UnitFamily(definition) {
                if owner == .Val(package) && definition.resolved_owner != Val(package) -> next
                loop minted in sema_registration_unit_family_type_names(definition) {
                    if minted.name == name -> return true
                }
            }
        }
    }
    false
}

// The package identity of the module declaring the qualified nominal `ty`
// (`{module_name}.{name}`), or None when no registered nominal is spelled so.
sema_registration_unit_type_package: fn(graph: SemaRegistrationGraph, ty: Type) -> String? Never! {
    if ty == .Tagged(_, inner) -> return sema_registration_unit_type_package(graph, inner)
    spelled := ""
    if ty == {
        .Named(value) | .Apply(value, _) -> spelled = value.copy()
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
    if graph.canonical_nominals == .Val(canon) {
        if name_find(canon.rows, spelled) == .Val(found) {
            slot: canon.row_slots[name_index(found)]
            if slot >= 0 {
                return Val(graph.modules[canon.owners[slot]].package_identity)
            }
        }
    }
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].nominals.len() {
            if sema_registration_nominal_spelling(graph, SemaRegistrationRowRef{module_index: module_index, row: row}) == spelled {
                return Val(graph.modules[module_index].package_identity)
            }
        }
    }
    None
}

// `Quantity<Dimension, .Kind>` (the parser's canonical bound text) holds for a
// unit type of that family and kind, and for any quantity whose physical
// dimension equals the dimension of a family named `Dimension` in that kind; a
// derived quantity such as `kilogram * meter / s / s` is Linear.
sema_registration_quantity_bound_satisfied: fn(graph: SemaRegistrationGraph, actual: Type, bound: String) -> Bool Never! {
    kind := "Linear"
    dimension := Dimension?{None}
    if actual == .Quantity(_, quantity_dimension) -> dimension = Val(quantity_dimension.copy()) else {
        fact: sema_registration_unit_fact_for_type(graph, actual) ?? return false
        kind = if fact.kind == {
            .Linear -> "Linear"
            .Point -> "Point"
            .Delta -> "Delta"
        }
        if bound == "Quantity<{fact.family}, .{kind}>" -> return true
        dimension = fact.dimension
    }
    if dimension == None -> return false
    loop fact in graph.unit_facts {
        if bound == "Quantity<{fact.family}, .{kind}>" && sema_expr_unit_dimensions_equal(fact.dimension, dimension) {
            return true
        }
    }
    false
}

sema_registration_unit_fact_is_builtin_time: fn(fact: SemaRegistrationUnitFact) -> Bool Never! {
    fact.package == "core.units" && fact.family == "Time" && (fact.name == "Duration" || fact.name == "Instant")
}

sema_registration_unit_type_is_qualified: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(_, inner) -> sema_registration_unit_type_is_qualified(inner)
        .Named(value) | .Apply(value, _) -> value.contains(".")
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

SemaRegistrationGenericParam: struct {
    index: Int,
    name: String,
    bounds: [String],
    span: Span,
    identity_key: String,
    // The declaring module, where the bounds' trait names resolve.
    module_identity: ModuleID,
    // A `<N: Int>` number parameter (TGenericParam.number).
    number: Bool{false},
}

SemaRegistrationParameter: struct {
    index: Int,
    name: String,
    span: Span,
    ty: Type,
    convention: AccessConvention,
    zone: ParamZone,
    public_label: String?,
    variadic: Bool,
    default: Expr?,
    default_ref: FunctionDefaultRef?,
}

SemaRegistrationCallableABI: struct {
    is_extern: Bool,
    is_c_abi: Bool,
    c_abi_name: String?,
    callback_transport: String?,
    callback_plan_digest: String?,
    callback_identity: String?,
    foreign_effect_root: String?,
}

SemaRegistrationForeignOwner: enum {
    ExternRust,
    CModule,
}

SemaRegistrationForeignFunction: struct {
    symbol: Symbol,
    declaration: ExternFn,
    owner: SemaRegistrationForeignOwner,
    foreign_library: String,
    foreign_library_span: Span,
    generic_params: [SemaRegistrationGenericParam],
    parameters: [SemaRegistrationParameter],
    abi: SemaRegistrationCallableABI,
}

SemaRegistrationFunction: struct {
    symbol: Symbol,
    declaration: Func,
    signature: Type,
    generic_params: [SemaRegistrationGenericParam],
    parameters: [SemaRegistrationParameter],
    abi: SemaRegistrationCallableABI,
    // The declared return stays raw for a protocol ABI trait-impl method.
    raw_protocol_return: Bool,
    // A method of a conditional impl (`impl Pair<T: Priced>.Describe`): the
    // owner's parameters with the bounds the impl applies under.
    impl_conditions: [TypeParam]{[TypeParam]{}},
    // Solved or stated receiver field footprint (sorted stored field names);
    // None when the method touches whole `self` or has no non-consuming receiver.
    receiver_footprint: [String]?{None},
    // Index in `module_row.program.items` for a declaration whose body lives
    // only on the program item; -1 for synthetic or cross-module declarations.
    item_index: Int{-1},
    // Index in the owning item's `methods` (or trait_impls[trait_block_index].methods);
    // -1 for top-level functions or declarations owning their body.
    method_index: Int{-1},
    // Index in a struct/enum's `trait_impls`; -1 for inherent/impl methods.
    trait_block_index: Int{-1},
}

SemaRegistrationField: struct {
    symbol: Symbol,
    ty: Type,
    default: Expr?,
    computed: Bool,
}

SemaRegistrationVariant: struct {
    symbol: Symbol,
    payload: VariantPayload,
    payload_type: Type?,
}

SemaRegistrationTraitMethod: struct {
    symbol: Symbol,
    declaration: TraitMethodSig,
    signature: Type,
    parameters: [SemaRegistrationParameter],
}

SemaRegistrationAssociatedType: struct {
    symbol: Symbol,
    declaration: NamedType,
    ty: Type,
}

SemaRegistrationImpl: struct {
    symbol: Symbol,
    declaration: ImplDef,
    source_module_identity: ModuleID,
    source_package_identity: String,
    target_module_identity: ModuleID,
    target_type_name: String,
    target_type: Type,
    target_identity_key: String,
    trait_name: String?,
    trait_symbol: Symbol?,
    trait_span: Span?,
    methods: [SemaRegistrationFunction],
    associated_type_impls: [NamedType],
    associated_types: [SemaRegistrationAssociatedType],
    delegation_field: String?,
    compiler_generated: Bool,
    operator_marker: OperatorMarker?,
    operator_rhs: Type?,
    target_os: String?,
    // The symbol id of the nominal `target_type` names from the impl's
    // module, resolved once when the trait index is built
    // (sema_registration_index_impl_traits); None while unresolved.
    target_nominal: SymbolID?{None},
}

SemaRegistrationNominal: struct {
    symbol: Symbol,
    kind: SemaRegistrationNominalKind,
    source: SemaRegistrationNominalSource,
    ty: Type,
    identity_key: String,
    generic_params: [SemaRegistrationGenericParam],
    fields: [SemaRegistrationField],
    variants: [SemaRegistrationVariant],
    methods: [SemaRegistrationFunction],
    trait_methods: [SemaRegistrationTraitMethod],
    // Compiler-owned rows are injected from facts rather than source syntax.
    // They remain real registration nominals so field/type identities are
    // available to every downstream consumer without pretending they are
    // foreign handles or user declarations.
    compiler_owned: Bool,
    generated_provenance: String?,
    // Public enum marked `#Open`: external matches and nested patterns require
    // a catch-all (`else` or `_`).
    is_open: Bool{false},
}

// A module constant's row. `typed` when the binding writes its type: the
// compile-time run later gives an unwritten one's `ty` and declaration the
// type of its staged value, so neither tells a written type afterwards.
SemaRegistrationConstant: struct {
    symbol: Symbol,
    declaration: ConstDef,
    ty: Type?,
    typed: Bool,
}

SemaRegistrationExport: struct {
    name: String,
    symbol: Symbol,
    // The position of the declaration in the `declarations` of module
    // `source_module_identity`; None for a module import or a Core leaf with
    // no source declaration. The row holds no copy of the declaration.
    declaration_position: Int?,
    source_module_identity: ModuleID,
    visibility: Int,
    // Index in `graph.modules[source].symbols` holding the live `ty` when
    // `symbol.ty == None`; -1 when `symbol` owns `ty`.
    target_symbol_row: Int{-1},
}

SemaRegistrationImportBinding: struct {
    original: String,
    local: String,
    symbol: Symbol,
    // As SemaRegistrationExport.declaration_position, in module
    // `target_module_identity`.
    declaration_position: Int?,
    target_module_identity: ModuleID,
    // Resolved against this graph's fixed module order during registration;
    // Core namespace bindings may name a module that was not loaded.
    target_module_index: Int?,
    visibility: Int,
    // Index in `graph.modules[target_module_index].symbols` holding the live
    // `ty` for this binding when `symbol.ty == None`; -1 when `symbol` owns `ty`.
    target_symbol_row: Int{-1},
}

SemaRegistrationImport: struct {
    source_module_identity: ModuleID,
    source_package_identity: String,
    target_module_identity: ModuleID,
    target_package_identity: String,
    declaration: ImportDecl,
    visibility: Int,
    bindings: [SemaRegistrationImportBinding],
}

SemaRegistrationModuleInput: struct {
    package_identity: String,
    module_identity: ModuleID,
    module_name: String,
    core_source_alias: String,
    module_path: String,
    source_file: String,
    source_segments: [SemaSourceSegment],
    source_origin: SemaSourceOrigin,
    program: Program,
    foreign_handles: [SemaRegistrationForeignHandleFacts],
    // Filled by the loader: the package namespace of a member
    // file ("" outside one), the names it contributes in declaration order,
    // the names it keeps to itself (a named entry's or a command home's own
    // command function), and the names of other members its source can reach.
    namespace: String{""},
    namespace_names: [String]{[String]{}},
    namespace_private: [String]{[String]{}},
    namespace_refs: [String]{[String]{}},
    // The dotted `name: module` path that declared the file ("" at the
    // package root): the start of SourceLocation's `module`.
    declared_module: String{""},
    // The module's source text. A declared text block hands the text inside its
    // braces to its rule.
    source: String{""},
    // The unit mentions of `source` (sema_units_source_mentions) when the
    // driver already holds them, as for a Core module whose rows it read
    // from the Core interface; registration then scans no text for them.
    units_mentions: SemaUnitSourceMentions?{None},
    // Filled by the driver: the module's file from its package root and its
    // package, which its Module record names (ModuleMeta.jet).
    meta: SemaModuleMetaSource{SemaModuleMetaSource{}},
    // False for a Core module of a compile that reaches Core on demand: like
    // the Core bodies no program calls, its casing is the Core library's check
    // (`jet check Core`), which leaves this true.
    check_casing: Bool{true},
    // The derive templates' expansions this module's registration takes or
    // keeps (Derives.jet SemaDeriveMemo, CoreBodies.jet
    // sema_core_derives_attach): the Core library's check keeps a Core
    // module's, which SemaRegistrationModule.derive_captures records, and a
    // compile bound to that Core takes them from the record.
    derive_memo: SemaDeriveMemo{SemaDeriveMemo{}},
    // The values the build computed for the module values its root `#loop`
    // declarations read (`#loop row in ROWS` over `ROWS: #run rows()`):
    // the driver computes them in a first pass and hands them to the
    // registration that expands the loops (UserTemplates.jet
    // sema_derive_template_loop_waits).
    loop_values: [NamedCtValue]{[NamedCtValue]{}},
    // Set on that first pass: a root `#loop` over a value not computed yet
    // is left out, without a report, until the value is known.
    loop_values_pending: Bool{false},
}

SemaForeignImportBinding: struct {
    scope: String?,
    alias: String,
}

SemaRegistrationImportEdge: struct {
    source_module_identity: ModuleID,
    source_scope: String{""},
    source_scope_exported: Bool{false},
    target_module_identity: ModuleID,
    target_package_identity: String,
    foreign_binding: SemaForeignImportBinding?,
    declaration: ImportDecl,
}

SemaRegistrationModule: struct {
    package_identity: String,
    module_identity: ModuleID,
    module_name: String,
    core_source_alias: String,
    module_path: String,
    // The dotted `name: module` path that declared the file ("" at the
    // package root): the start of SourceLocation's `module`.
    declared_module: String{""},
    // The package the loader read for this module (its manifest name and
    // version; the defaults for a source without one): ProgramInfo groups
    // its modules into one PackageInfo by `package_identity`.
    package: SemaModulePackage{SemaModulePackage{}},
    // The `package_settings` row of the build facts that holds its
    // package's declared settings, -1 for the built package's
    // (sema_build_facts_settings_at).
    settings_row: Int{-1},
    // Whether the file is one of its package's memory kernel files
    // (`policy.memory`): its types' `priv` fields are then private to the
    // kernel files, not the whole package (sema_expression_field_visible).
    memory_kernel: Bool{false},
    source_file: String,
    source_segments: [SemaSourceSegment],
    source_origin: SemaSourceOrigin,
    program: Program,
    inline_bindings: SemaInlinePreparedBindings{SemaInlinePreparedBindings{}},
    source: String{""},
    // The `#FX(…)` cap of each generic-module template erased from
    // `program.items` once expanded: the cap's names are still checked
    // where it is written (E0119, E0750), instantiated or not.
    template_caps: [ModuleCap]{[ModuleCap]{}},
    declarations: [Item],
    symbols: [Symbol],
    // Row `i` is the `nominals` row that `symbols[i]` registered (-1 for a
    // symbol without one). Names are unique per module, so this row is the
    // first registered row of the symbol's key: the row
    // `nominal_symbol_rows` answers for it. A resolved symbol carries it, so
    // the hot nominal-row lookups never search the long-key map.
    symbol_nominal_rows: [Int]{[Int]{}},
    // Symbol name -> its `symbols` row, over interned names, and by the same
    // id its root declaration's row in `declarations` (-1: none).
    symbol_names: NameTable,
    symbol_rows: [Int],
    declaration_rows: [Int],
    impls: [SemaRegistrationImpl],
    functions: [SemaRegistrationFunction],
    foreign_functions: [SemaRegistrationForeignFunction],
    nominals: [SemaRegistrationNominal],
    constants: [SemaRegistrationConstant],
    // Symbol ids of the `#Persist`, mutable, and `#Static` constants
    // (sema_ownership_is_static_root), collected once at registration so a
    // function check reads them without walking the constant ASTs.
    static_roots: [SymbolID]{[SymbolID]{}},
    // The `#Persist` subset of `static_roots`: mutable module state whose
    // cell may be lent for writing.
    persist_roots: [SymbolID]{[SymbolID]{}},
    imports: [SemaRegistrationImport],
    exports: [SemaRegistrationExport],
    // Local import name -> its binding. Import names are unique per module, so
    // each name has one row; the row packs the import and binding positions
    // (sema_registration_import_binding_at).
    import_binding_names: NameTable,
    import_binding_values: [Int],
    // `{type}:{trait}` for every trait impl among `declarations`, so auto-derive
    // metadata asks once per query instead of rescanning the declarations.
    declared_trait_impls: NameTable,
    // The module's package namespace (loader key, "" outside
    // one) and its `namespace_tables` slot (-1 outside one), what the loader
    // recorded for it, the position in `imports` where the package names
    // bind (before the foreign-provider imports, which register last; -1 =
    // after every import), whether every namespace name binds (items from a
    // template declared elsewhere), and the sibling declarations its scope
    // binds: (owner module, symbol row).
    namespace: String{""},
    namespace_slot: Int{-1},
    namespace_names: [String]{[String]{}},
    namespace_private: [String]{[String]{}},
    namespace_refs: [String]{[String]{}},
    namespace_import_split: Int{-1},
    namespace_full: Bool{false},
    namespace_bindings: [SemaRegistrationRowRef]{[SemaRegistrationRowRef]{}},
    // The record of the derive templates' expansions the Core library's
    // check kept for this Core module (Derives.jet sema_derive_memo_capture),
    // at most one, which its bodies file holds (CoreBodies.jet
    // sema_core_derive_bodies), and how many expansions of the record this
    // module took did not read (SemaDeriveMemo.unread), a census row
    // (CoreBodies.jet sema_core_bodies_unread).
    derive_captures: [SemaDeriveCapture]{[SemaDeriveCapture]{}},
    derive_unread: Int{0},
    // The owned traits whose defaults did not parse in this module, so its
    // impls of them gained none (TraitImpls.jet SemaTraitDefaultsUnread), a
    // census row (sema_trait_defaults_unread).
    trait_defaults_unread: [SemaTraitDefaultsUnread]{[SemaTraitDefaultsUnread]{}},
    // True when any local symbol, import binding, or namespace entry visible
    // from this module contains `.`, so dotted canonical lookups must probe
    // local scope first (computed by sema_registration_index_canonical_nominals).
    has_dotted_symbols: Bool{false},
}

SemaRegistrationImportBindingRef: struct {
    import_index: Int,
    binding: Int,
}

// Host callbacks the checker calls into. Function values never copy and never
// cross a compiler thread, so they stay out of the registration graph (which
// compiler threads share): the driver hands them to each check pass, and a
// check reaches them through its context (SemaHostHookAccess).
// Compiler services the host installs. Each declares its effect row (a pure
// one its empty row): an unbounded function value is the maximal row which
// would make every checker path that consults a hook reach every effect.
SemaRegistrationHostHooks: struct {
    numeric_unit_conversion_exact: (fn(Float, String, String, String, String) -[]> Float?)?,
    // A `jet run` that may bind to the Core image: the host's read of the
    // seal it would carry (CoreSeal.jet), which its Core demand makes once
    // (CoreDemand.jet sema_core_stand_in_bind) and leaves None after.
    core_seal: SemaCoreSealSource?{None},
    // A compile whose Core is the Core built into the host: the Core
    // library's bodies file (CoreBodies.jet), whose Core packets a check
    // loads in place of checking from text, the host's read of its records
    // at their offsets (None: they are read from the lent bytes), which of
    // its records it so loaded, by position, how many of the file's bytes
    // those records hold, and the reader every load reads its packet with,
    // whose pool of strings (BodyCodecIn.spellings) holds one String per
    // spelling across every load. A Core demand wave's packets read ahead
    // on compiler threads wait in `core_bodies_ahead`, by function symbol
    // id, for the wave's loads to take them, each leaving None in its place
    // (CoreBodies.jet sema_core_bodies_ahead, sema_core_body_ahead_take).
    // A record that does not read is a row of `core_bodies_unread`, the
    // compile's census of them (CoreBodies.jet sema_core_bodies_unread).
    core_bodies: SemaCoreBodies?{None},
    core_bodies_records: SemaCoreBodiesRecords?{None},
    core_bodies_loaded: [Bool]{[Bool]{}},
    core_bodies_read: Int{0},
    core_bodies_reader: BodyCodecIn{BodyCodecIn{at: 0, end: 0, failed: false, symbols: [SymbolID]{}, decls: [DeclID]{}, modules: [ModuleID]{}}},
    core_bodies_ahead: [U32:SemaCoreBodyAhead?]{[U32:SemaCoreBodyAhead?]{}},
    core_bodies_unread: [String]{[String]{}},
}

// The folded build snapshot the driver seeds before checking. Sema folds
// `#package.*` and `build.*` reads from these values and never probes the host.
SemaBuildFacts: struct {
    package_name: String,
    package_version: String,
    os: String,
    profile: String,
    stamp_git: String?,
    stamp_dirty: Bool,
    stamp_toolchain: String,
    stamp_at: String,
    // The machine running the build (`#build.host.os`, `#build.host.arch`):
    // its OS as `#build.target.os` spells one, and its architecture as a
    // triple's first part; "" when the host names none.
    host_os: String{""},
    host_arch: String{""},
    // This compile produces a shipped artifact (`jet build`).
    artifact_build: Bool{false},
    // The built package's declared settings with this build's values
    // (`#build.settings.*`, sema_fact_build_setting).
    settings: [SemaBuildSetting]{[SemaBuildSetting]{}},
    // Each loaded dependency's declared settings with this build's values,
    // one row per package; a module's `settings_row` names its package's.
    package_settings: [SemaPackageSettings]{[SemaPackageSettings]{}},
    // The host's compiler identity ("" when the host names none); a history
    // artifact's `tool` names it (#6410).
    compiler_identity: String{""},
    // The markers `package.jet`'s header writes on the package record (the
    // Package site), as written and, after sema_marker_package_check, bound
    // to their declarations; their spans are in `package_manifest`.
    package_markers: [Marker]{[Marker]{}},
    package_manifest: String{""},
    // The device permissions the package's `purposes:` gives a purpose
    // for, by key; a call that needs another one fails the build
    // (sema_call_app_permission_purpose).
    purposes: [String]{[String]{}},
}

// One declared setting: its type as written (`Bool`, `Int`, `Char`,
// `String` or a fieldless enum), its value's text for this build, its
// declared default's text, and each writer of its chain from least to most
// explicit layer, the one the contribution law selected marked.
SemaBuildSetting: struct {
    name: String,
    ty: String,
    value: String,
    default: String,
    contributions: [SemaSettingContribution],
}

// One writer of a setting: its value's text, where it is written (the file
// and span of its manifest entry; "" and an empty span for a writer with no
// source site), its layer as a ContributionKind variant (`Declaration`,
// `Profile`, `Build` or `CommandLine`) and whether the contribution law
// selected it.
SemaSettingContribution: struct {
    value: String,
    file: String,
    span: Span,
    kind: String,
    selected: Bool,
}

// One loaded dependency's declared settings with this build's values.
SemaPackageSettings: struct {
    package_identity: String,
    settings: [SemaBuildSetting],
}

// `debug(…)` traces are development-only. A shipped artifact or a
// release-profile compile rejects any that remain (E3405).
sema_build_facts_reject_debug_traces: fn(facts: SemaBuildFacts) -> Bool Never! {
    facts.artifact_build || facts.profile == "release" || facts.profile == "hardened"
}

// The declared settings a module whose `settings_row` is `row` reads: its
// dependency's own row of `facts.package_settings`, else (-1) the built
// package's. A dependency never reads the built package's settings.
sema_build_facts_settings_at: fn(facts: SemaBuildFacts, row: Int) -> [SemaBuildSetting] Never! {
    if row >= 0 -> return facts.package_settings[row].settings
    facts.settings
}

// #4319 scaling counters (Tools/Perf/Scaling) of the graph's lookups: module
// rows by identity and names in a module's namespace, and of the scope
// tables built from its module rows: name resolutions and the binding rows
// they examine. One counter set is shared by every copy of a graph and by
// those scope tables; it counts only when the graph's `counting` is set, so
// an uncounted lookup costs one flag test. Each count is one atomic add under
// a shared read permit, so threads that count don't wait for each other.
SemaLookupCounters: struct {
    module_lookups: Atomic<Int>,
    name_lookups: Atomic<Int>,
    scope_lookups: Atomic<Int>,
    scope_compares: Atomic<Int>,
}

// The counts of a SemaLookupCounters at one moment.
SemaLookupCounts: struct {
    module_lookups: Int,
    name_lookups: Int,
    scope_lookups: Int,
    scope_compares: Int,
}

// What the program tables' registration graph stands for. A Program graph is
// the one a registered build made. A Snapshot graph is the empty one given
// to a check of one program alone (check_program) or to a schema read: it
// registers nothing, so every lookup in it misses. The few checks that
// resolve a snapshot's own declarations without a registration branch on
// `.Snapshot`, each with a line saying why.
SemaTablesMode: enum {
    Program,
    Snapshot,
}

SemaRegistrationGraph: struct {
    package_identity: String,
    entry_module_identity: ModuleID,
    // The module that holds the entry's `run: fn` when a `meta.rewrite_body`
    // module replaced it (JetDriver jet_driver_entry_run_module); None when
    // the entry module keeps its own.
    entry_run_module: ModuleID?{None},
    canonical_effect_module_identity: ModuleID,
    target_machine: TargetMachine,
    build_facts: SemaBuildFacts,
    modules: [SemaRegistrationModule],
    // The loaded modules' identities (the loader's table, and the graph's
    // own original Prelude error module): every ModuleID names a row here.
    module_table: ModuleTable,
    // ModuleID index -> position in `modules`, -1 for an id with no row;
    // fixed at graph construction.
    module_rows: [Int],
    // The run's symbols (Docs/Spec/compiler-data.md): each module's range,
    // reserved before the module is prepared, and the open range the serial
    // passes after preparation intern into.
    symbols: SymbolTable,
    edges: [SemaRegistrationImportEdge],
    // The import edges a package's `boundaries` policy decided, as the
    // loader recorded them (allowed or denied, gated by the manifest rule):
    // each stands in for the plain resolved fact of its edge
    // (sema_name_structure_facts).
    boundary_facts: [StructureFact]{[StructureFact]{}},
    foreign_providers: [SemaForeignProviderInput],
    core_builtin_owner_facts: [SemaRegistrationCoreBuiltinOwnerFact],
    imports: [SemaRegistrationImport],
    unit_facts: [SemaRegistrationUnitFact],
    unit_fact_names: NameTable{name_table()},
    unit_fact_buckets: [[Int]]{[[Int]]{}},
    has_unit_families: Bool{false},
    unit_member_names: NameTable{name_table_sized(4)},
    // Output alias and callable references come from the same checked graph
    // resolution as their facts; finalization publishes them with body refs.
    output_name_references: [SemaNameReferenceFact]{[SemaNameReferenceFact]{}},
    lookup_counters: Shared<SemaLookupCounters>,
    counting: Bool,
    internal_problem: String?,
    diagnostics: [Diagnostic],
    complete: Bool,
    // Per module row, its markers that no rule, marker declaration or derive
    // provider names (E0927, sema_marker_module_check); the module's
    // declaration check reports them, so they do not stop registration.
    unknown_rule_diagnostics: [[Diagnostic]]{[[Diagnostic]]{}},
    // The run-wide declaration table (Cutover B L2b): one DeclID row per
    // registered callable (functions, foreign functions, nominal methods,
    // impl methods; module order, a key's first row found), and each row's
    // place, indexed by its DeclID.
    decls: DeclTable{DeclTable{}},
    callables: [SemaRegistrationCallableRow]{[SemaRegistrationCallableRow]{}},
    // Base type name -> nominal rows (by `sema_expr_type_base_name`) and impl
    // rows (by `target_type_name`), in module/row order, so operator and
    // method dispatch read only the rows of their receiver type. Each name's
    // `name_index` indexes directly into its bucket list (row 0 unused).
    nominal_row_names: NameTable{NameTable{bytes: [U8]{}, ends: [Int]{0}, texts: [String]{""}, hashes: [Int]{0}, slots: [Int]{0, 0}, mask: 1}},
    nominal_row_buckets: [[SemaRegistrationRowRef]],
    impl_row_names: NameTable{NameTable{bytes: [U8]{}, ends: [Int]{0}, texts: [String]{""}, hashes: [Int]{0}, slots: [Int]{0, 0}, mask: 1}},
    impl_row_buckets: [[SemaRegistrationRowRef]],
    // Nominal SymbolID -> first registered nominal row. Kept current from
    // graph construction on: every nominal row pushed later (compiler
    // builtins, user templates, minted failure unions) is indexed as it lands.
    nominal_symbol_rows: [U32:SemaRegistrationRowRef],
    // Source package identity -> its row in `package_reach`: per module row,
    // whether the package's own modules reach it through their imports
    // (sema_registration_index_package_reach). Empty until every import is
    // bound.
    package_reach_names: NameTable{NameTable{bytes: [U8]{}, ends: [Int]{0}, texts: [String]{""}, hashes: [Int]{0}, slots: [Int]{0, 0}, mask: 1}},
    package_reach: [[Bool]]{[[Bool]]{}},
    // Compiler-owned nominal name (`Err`, `Ordering`, `RemoveBy`) -> its row.
    compiler_builtin_names: NameTable{NameTable{bytes: [U8]{}, ends: [Int]{0}, texts: [String]{""}, hashes: [Int]{0}, slots: [Int]{0, 0}, mask: 1}},
    compiler_builtin_refs: [SemaRegistrationRowRef?]{[SemaRegistrationRowRef?]{}},
    // Resolved trait symbol id -> the impl rows implementing it, in module/row
    // order, built with the callable index; a bound query before then
    // (`impl_traits_indexed` false) scans every impl.
    impl_trait_slots: [U32:Int]{[U32:Int]{}},
    impl_trait_buckets: [[SemaRegistrationRowRef]]{[[SemaRegistrationRowRef]]{}},
    impl_traits_indexed: Bool{false},
    // Spelled trait name (an impl's `trait_name`, and its registered trait
    // symbol's name) -> the impl rows under that name, in module/row order,
    // built with the trait index above. The copy-facts and close-owner
    // queries match impls by trait name (sema_copy_nominal_has_impl), so
    // they read one name's rows instead of every impl of the graph.
    impl_trait_names: NameTable{NameTable{bytes: [U8]{}, ends: [Int]{0}, texts: [String]{""}, hashes: [Int]{0}, slots: [Int]{0, 0}, mask: 1}},
    impl_trait_name_buckets: [[SemaRegistrationRowRef]]{[[SemaRegistrationRowRef]]{}},
    // The impl rows that implement core.prelude's CheckedText
    // (sema_type_graph_is_checked_text_impl), in module/row order, built with
    // the trait index above. A typed literal or static call looks its head's
    // checked-text impl up among these rows instead of every impl of the graph
    // (sema_expression_checked_text_target).
    checked_text_impl_rows: [SemaRegistrationRowRef]{[SemaRegistrationRowRef]{}},
    // Opaque impl type name -> the Core source modules that own its impls
    // (`sema_registration_source_owns_impl`), in module order. Built once with
    // the graph, so method lookup reads only the owning modules instead of
    // walking CORE_SOURCE_OWNED_ROWS for every module on every call.
    source_impl_owner_names: NameTable{NameTable{bytes: [U8]{}, ends: [Int]{0}, texts: [String]{""}, hashes: [Int]{0}, slots: [Int]{0, 0}, mask: 1}},
    source_impl_owner_rows: [[Int]]{[[Int]]{}},
    // Whether some registered function marks its first parameter `#Root`
    // (sema_registration_note_root_functions). Set when the graph is built and
    // when a user template registers more functions, never cleared, so a
    // graph without one skips the receiver-first probe's import walk
    // (sema_root_call_imported) on every method call.
    root_functions: Bool{false},
    // The inferred never-return set: the SymbolIDs of the functions that never return to
    // their caller, one fixed point once every declaration is registered
    // (sema_divergence_solve).
    diverging_functions: [U32:Bool]{[U32:Bool]{}},
    // The symbol keys of the bodies that reach a nominal whose declared
    // member type names nothing (sema_checked_unusable_bodies): the check
    // skips them and records each as skipped, so it reports no follow-on
    // error of theirs while every other body is checked. Set after the
    // declaration pass of a compile with errors; empty otherwise.
    unusable_bodies: NameTable{NameTable{bytes: [U8]{}, ends: [Int]{0}, texts: [String]{""}, hashes: [Int]{0}, slots: [Int]{0, 0}, mask: 1}},
    // #3708: the bundle failure solve has settled every unannotated
    // callable's contract, so a body checked again (the recheck pass) reads
    // a still-defaulted callee as one the solve left fallible.
    failure_solved: Bool{false},
    // JET_KEEP_GOING, the compiler-internal diagnostic mode the driver sets
    // (its output is never shipped): a function whose body check fails is
    // kept as a typed trap of its declared signature instead of being left
    // out, so its callers and every later phase still run.
    keep_going: Bool{false},
    // Under keep_going, per module row: whether the row's own sources hold no
    // registration-blocking error (sema_registration_settle_modules). One
    // module's error leaves the graph incomplete, yet every other module
    // registered in full, so its facts stay known
    // (sema_registration_module_settled). Empty when not set, or when an
    // error names no source file.
    settled_modules: [Bool]{[Bool]{}},
    // Test mode, set by the driver: named `#Test` bodies are checked and
    // lowered as synthetic functions.
    test_mode: Bool{false},
    // Test mode: each law test the compiler could not make (TraitLaws.jet),
    // its test key with why. The test fails and the run ends as an internal
    // compiler error.
    law_faults: [SemaTraitLawFault]{[SemaTraitLawFault]{}},
    // Check mode (`jet check`), set by the driver: named `#Test` bodies are
    // checked for their diagnostics only; nothing is lowered or registered,
    // so no "not built yet" E2104 applies (sema_refuses_unbuilt).
    check_tests: Bool{false},
    // Program mode (`jet build`, `jet run`), set by the driver: the root
    // package's named `#Test` bodies are checked for their diagnostics only,
    // as under `jet check`, so a body `jet test` refuses is refused here too
    // (sema_check_module_tests). E2104 still applies.
    check_root_tests: Bool{false},
    // The packages whose compile-time code may reach the host, set by the
    // driver: each holds the expert effect `Meta.Host` and no `deny` row that
    // binds it covers it. The file calls of an `#Impure` block a `#run` value
    // of one of their modules makes run natively; any other package's are
    // refused (E3411).
    comptime_host_packages: [String]{[String]{}},
    // `#run use` (ComptimeUse.jet): the slot of a module and a target
    // (sema_comptime_use_slot) -> the `#run ` prefix of the import that
    // brings `target` into `module` for compile-time code only, so a
    // runtime read of a value of its types is reported with the edit that
    // drops the prefix.
    comptime_use_targets: [Int:Span]{[Int:Span]{}},
    // User modules only compile-time code uses, however they are imported;
    // the driver leaves their functions out of the shipped program.
    comptime_only_modules: [ModuleID]{[ModuleID]{}},
    // One table per package namespace: namespace -> slot, and per slot name ->
    // entry; entry -> declaring module and name. Entries are numbered in module
    // order, then declaration order.
    namespace_names: NameTable{NameTable{bytes: [U8]{}, ends: [Int]{0}, texts: [String]{""}, hashes: [Int]{0}, slots: [Int]{0, 0}, mask: 1}},
    namespace_tables: [NameTable]{[NameTable]{}},
    namespace_table_entries: [[Int]]{[[Int]]{}},
    namespace_entries: [[Int]]{[[Int]]{}},
    namespace_entry_modules: [Int]{[Int]{}},
    namespace_entry_names: [String]{[String]{}},
    // `jet doc` (driver `JetDriverCompileMode.Doc`): finalization keeps each
    // module's settled program (derived impls, inferred failure contracts) in
    // `SemaGraphResult.programs`.
    retain_programs: Bool{false},
    // A retaining compile whose reader takes only the user modules
    // (`jet fix`): its Core bodies wait for demand all the same
    // (CoreDemand.jet), so a Core module's kept program has only the bodies a
    // checked body named checked.
    retained_core_demand: Bool{false},
    // Every Core body is checked whether a checked body names it or not
    // (JET_KEEP_GOING, `jet check Core`), so none waits for demand.
    every_core_body: Bool{false},
    // `jet check Core` (driver core_entry with every_core_body, not the Core
    // library's sealing check): the program is Core's own check, so
    // finalization reports Core's lints rather than dropping them
    // (Finalize.jet sema_core_lint_dropped).
    core_own_check: Bool{false},
    // The Core library's check (driver JetDriverCompileRequest.core_seal):
    // finalization summarizes the Core functions for a bound program
    // (CoreSeal.jet) into SemaGraphResult.core_seal.
    core_seal: Bool{false},
    // The Core function checks stay on the module pass's thread, off the
    // compiler threads, so that thread captures them (`core_seal`) or loads
    // them from the host's bodies file (CoreBodies.jet
    // sema_core_bodies_hold), as the body pass sets it.
    core_bodies_held: Bool{false},
    // A `jet run` that may bind to the Core image: `core_seal_pending`, its
    // Core seal is in the host hooks (SemaRegistrationHostHooks.core_seal)
    // and not yet read, which the Core demand does once it first names a
    // deferred Core body (CoreDemand.jet sema_core_stand_in_bind).
    // `core_stand_ins`: the seal so read, whose stand-in Core functions the
    // Core demand checks by signature only (sema_core_stand_in_wait); None
    // checks every demanded body. `core_stand_in_wave`: the current demand
    // wave is such a stand-in wave.
    core_seal_pending: Bool{false},
    core_stand_ins: SemaCoreSeal?{None},
    core_stand_in_wave: Bool{false},
    // This rule demand (sema_serde_index_codec_methods): every generated
    // codec impl registers its header only. `codec_method_rows` maps the
    // SymbolID of each generated codec method to its impl row; `codec_demand` collects the
    // Encode/Decode requirements the checks reach (bound checks, codec calls,
    // nested wire fields), and `codec_wave_rows` (sema_codec_wave_slot) names
    // the impls whose bodies the current codec wave checks (sema_codec_waves).
    codec_method_rows: [U32:SemaRegistrationRowRef]{[U32:SemaRegistrationRowRef]{}},
    codec_demand: Shared<SemaCodecDemand>,
    codec_wave_rows: [Int:Bool]{[Int:Bool]{}},
    // Demand-checked derives (sema_derive_index_methods): the derived
    // `equal`/`compare` methods of compiler-owned modules (the Prelude error
    // module, Core) are checked only when a checked call names one or an
    // Equatable/Comparable bound is met at its type. `derive_method_rows`
    // maps each such method's SymbolID to its row, `derive_type_methods` each owner's
    // leaf name to its method keys, `derive_demand` collects the keys the
    // checks reach, `derive_wave_rows` names (by SymbolID) the methods the
    // current derive wave checks (sema_derive_waves), and `derive_checked`
    // every method a wave of this finalization checked.
    derive_method_rows: [U32:SemaDeriveMethodRow]{[U32:SemaDeriveMethodRow]{}},
    derive_type_methods: SemaDeriveTypeMethods{SemaDeriveTypeMethods{leaves: NameTable{bytes: [U8]{}, ends: [Int]{0}, texts: [String]{""}, hashes: [Int]{0}, slots: [Int]{0, 0}, mask: 1}, keys: [[String]]{[String]{}}}},
    derive_demand: Shared<SemaDeriveDemand>,
    derive_wave_rows: [U32:Bool]{[U32:Bool]{}},
    derive_checked: [U32:Bool]{[U32:Bool]{}},
    // Demand-checked Core bodies (sema_core_demand_index): a Core module's
    // top-level functions (and, under `jet check`, its inherent methods) are
    // checked only once a checked body names one. `core_demand` holds each
    // such function key with its module and whether a wave of this
    // finalization checked it, and `core_wave_rows` names the bodies the
    // current wave checks (sema_core_demand_waves).
    core_demand: SemaCoreDemandRows{SemaCoreDemandRows{keys: NameTable{bytes: [U8]{}, ends: [Int]{0}, texts: [String]{""}, hashes: [Int]{0}, slots: [Int]{0, 0}, mask: 1}, modules: [Int]{-1}, checked: [Bool]{false}}},
    core_wave_rows: NameTable{NameTable{bytes: [U8]{}, ends: [Int]{0}, texts: [String]{""}, hashes: [Int]{0}, slots: [Int]{0, 0}, mask: 1}},
    // A compile that lowers, set by the driver: the keys of the top-level
    // Core functions its lowering keeps with no keyed call in a checked body
    // (driver jet_driver_core_lowering_roots), which Core demand checks up
    // front. None for a compile that lowers nothing.
    core_lowering_roots: NameTable?{None},
    // The canonical spellings of the nominals registered by the end of
    // sema_registration_prepare_graph (sema_registration_index_canonical_nominals);
    // None for a graph built another way, whose lookups cut each spelling.
    canonical_nominals: SemaCanonicalNominals?{None},
    // The interfaces of the project's plugins, read from each literal
    // artifact's Component (jet_driver_plugin_facts): what
    // `plugin.load("artifact")` and its export calls check against.
    plugin_facts: SemaPluginInterfaceFacts{SemaPluginInterfaceFacts{interfaces: [SemaPluginInterface]{}, artifacts: [SemaPluginArtifactAlias]{}, digest: ""}},
    // The registry of the prelude's builtin applied rules (MARKER_SOURCE),
    // built once with the marker module check; the marker-signature checks
    // (sema_marker_rules_check_rule_signature) read it at every site.
    marker_catalog: SemaScopeMembersMarkerRegistry?{None},
    // The debugger's position probes for this compile (EvalProbe.jet); None
    // for a compile with none. Their answers come back in the check's result
    // (SemaGraphResult.eval_answers).
    eval_probes: SemaEvalProbes?{None},
    // The compilation's shared type and name interner (JetFoundation TypeIDs.jet),
    // seeded once at graph preparation and read zero-copy through worker-local
    // InternerDeltas during parallel body checks.
    interner: Interner,
    // Keep Local/Parameter name reference facts across functions only when
    // name facts, programs, or Core bodies are being built.
    keep_local_name_references: Bool{true},
    // Snapshot for the empty graph of a lone program's check
    // (sema_registration_graph_snapshot).
    mode: SemaTablesMode{SemaTablesMode.Program},
}

// The empty graph of a snapshot check (SemaTablesMode.Snapshot): no modules,
// symbols or rows, and a fresh interner. It keeps local name references, as
// a check of one program always did.
sema_registration_graph_snapshot: fn() -> SemaRegistrationGraph Never! {
    SemaRegistrationGraph{
        package_identity: "",
        entry_module_identity: module_none(),
        canonical_effect_module_identity: module_none(),
        target_machine: jet_target_machine_hosted("", ""),
        build_facts: SemaBuildFacts{package_name: "", package_version: "", os: "", profile: "", stamp_git: None, stamp_dirty: false, stamp_toolchain: "", stamp_at: ""},
        modules: [SemaRegistrationModule]{},
        module_table: ModuleTable{identities: name_table()},
        module_rows: [Int]{},
        symbols: symbol_table_of([SymbolKeys]{symbol_builtin_keys()}),
        edges: [SemaRegistrationImportEdge]{},
        foreign_providers: [SemaForeignProviderInput]{},
        core_builtin_owner_facts: [SemaRegistrationCoreBuiltinOwnerFact]{},
        imports: [SemaRegistrationImport]{},
        unit_facts: [SemaRegistrationUnitFact]{},
        lookup_counters: Shared{SemaLookupCounters{module_lookups: 0, name_lookups: 0, scope_lookups: 0, scope_compares: 0}},
        counting: false,
        internal_problem: None,
        diagnostics: [Diagnostic]{},
        complete: true,
        nominal_row_buckets: [[SemaRegistrationRowRef]]{[SemaRegistrationRowRef]{}},
        impl_row_buckets: [[SemaRegistrationRowRef]]{[SemaRegistrationRowRef]{}},
        nominal_symbol_rows: [U32:SemaRegistrationRowRef]{},
        codec_demand: Shared{sema_codec_demand_new()},
        derive_demand: Shared{sema_derive_demand_new()},
        interner: interner(),
        mode: SemaTablesMode.Snapshot,
    }
}

// `{module_name}.{name}` of every nominal row registered by the end of graph
// construction. Rows never move and their symbols never rename, so a row the
// table holds keeps its spelling; a row pushed later is spelled where it is read.
SemaCanonicalNominals: struct {
    // names[module_index][row]: the nominal row's canonical spelling.
    names: [[String]],
    // Canonical spelling -> row of `owners`/`leaves`: the module `module_rows`
    // gives its `module_name` and the row's whole name, which a cut at the last
    // `.` (sema_type_graph_lookup_symbol_at) also finds unless the name holds a
    // `.` itself, as a protocol's `Payment.Client` does: only this table finds
    // those. Spellings whose module is not registered are left out.
    rows: NameTable,
    row_slots: [Int],
    owners: [Int],
    leaves: [String],
    // Pre-resolved symbol for O(1) canonical lookup without a second hash probe.
    resolved: [SemaRegistrationResolvedSymbol?],
    // True when the resolved symbol is a plain non-alias, non-trait Type whose
    // canonical spelling equals this row's spelling (resolve_named fast path).
    is_plain_type: [Bool],
    // True when the nominal is a non-Core, non-Layout, markerless Struct/Enum
    // with no built-in handle leaf name (method special-route fast bypass).
    is_ordinary_user_type: [Bool],
}

SemaRegistrationRowRef: struct {
    module_index: Int,
    row: Int,
}

// A demand-checked derived method: nominal `nominal` of module
// `module_index`, method `method` of it.
SemaDeriveMethodRow: struct {
    module_index: Int,
    nominal: Int,
    method: Int,
}

// The derived method keys a check reached (sema_derive_demand_add); while
// `capturing`, `captured` also gets each key a check records
// (sema_demand_capture_open).
SemaDeriveDemand: struct {
    keys: NameTable,
    capturing: Bool{false},
    captured: [String]{[String]{}},
}

// Each owner's leaf name in `leaves`, and by its id the keys of its derived
// methods (sema_derive_index_methods). Id 0, the empty spelling, owns none.
SemaDeriveTypeMethods: struct {
    leaves: NameTable,
    keys: [[String]],
}

// A registered callable addressed by position, so in-place row updates
// (failure-union return types) are read at lookup time.
SemaRegistrationCallableRow: enum {
    Function(module_index: Int, row: Int),
    Foreign(module_index: Int, row: Int),
    NominalMethod(module_index: Int, owner: Int, row: Int),
    ImplMethod(module_index: Int, owner: Int, row: Int),
}

// A name resolved to its symbol (Cutover B L2a). The symbol row stays in the
// graph: a lookup returns its place, and readers take the fields they need
// (sema_resolved_kind/_name/_key/_ty), so no lookup copies a Symbol. A type
// symbol's nominal row is `sema_type_graph_resolved_nominal_row`.
SemaRegistrationResolvedSymbol: struct {
    place: SemaRegistrationSymbolPlace,
    source_module_identity: ModuleID,
    target_module_identity: ModuleID,
    visibility: Int,
    // The symbol's registered nominal row when the lookup found it beside
    // the symbol (`symbol_nominal_rows`, a builtin row, a nominal row);
    // None leaves `sema_type_graph_resolved_nominal_row` to the key map.
    nominal_row: SemaRegistrationRowRef?{None},
}

// Where a resolved symbol's row lives. `Detached` holds a symbol no graph row
// keeps: a builtin trait bound and an export row resolved through a chain.
SemaRegistrationSymbolPlace: enum {
    Declared(module_index: Int, row: Int),
    Imported(module_index: Int, import_index: Int, binding: Int),
    Nominal(module_index: Int, row: Int),
    Detached(symbol: Symbol),
}

sema_resolved_kind: fn(graph: SemaRegistrationGraph, resolved: SemaRegistrationResolvedSymbol) -> SymbolKind Never! {
    if resolved.place == {
        .Declared(module_index, row) -> graph.modules[module_index].symbols[row].kind
        .Imported(module_index, import_index, binding) -> graph.modules[module_index].imports[import_index].bindings[binding].symbol.kind
        .Nominal(module_index, row) -> graph.modules[module_index].nominals[row].symbol.kind
        .Detached(symbol) -> symbol.kind
    }
}

sema_resolved_name: fn(graph: SemaRegistrationGraph, resolved: SemaRegistrationResolvedSymbol) -> String Never! {
    if resolved.place == {
        .Declared(module_index, row) -> graph.modules[module_index].symbols[row].name
        .Imported(module_index, import_index, binding) -> graph.modules[module_index].imports[import_index].bindings[binding].symbol.name
        .Nominal(module_index, row) -> graph.modules[module_index].nominals[row].symbol.name
        .Detached(symbol) -> symbol.name
    }
}

// The symbol's SymbolID.
sema_resolved_id: fn(graph: SemaRegistrationGraph, resolved: SemaRegistrationResolvedSymbol) -> SymbolID Never! {
    if resolved.place == {
        .Declared(module_index, row) -> graph.modules[module_index].symbols[row].id
        .Imported(module_index, import_index, binding) -> graph.modules[module_index].imports[import_index].bindings[binding].symbol.id
        .Nominal(module_index, row) -> graph.modules[module_index].nominals[row].symbol.id
        .Detached(symbol) -> symbol.id
    }
}

// The symbol's key text (a registered symbol's: graph resolution yields no
// body's own id).
sema_resolved_key: fn(graph: SemaRegistrationGraph, resolved: SemaRegistrationResolvedSymbol) -> String Never! {
    symbol_table_key(graph.symbols, sema_resolved_id(graph, resolved))
}

sema_registration_binding_ty: fn(graph: SemaRegistrationGraph, binding: SemaRegistrationImportBinding) -> Type? Never! {
    if binding.symbol.ty != None -> return binding.symbol.ty
    if binding.target_symbol_row >= 0 {
        if binding.target_module_index == .Val(owner_index) {
            return graph.modules[owner_index].symbols[binding.target_symbol_row].ty
        }
    }
    None
}

sema_registration_binding_symbol: fn(graph: SemaRegistrationGraph, binding: SemaRegistrationImportBinding) -> Symbol Never! {
    if binding.symbol.ty != None || binding.target_symbol_row < 0 -> return binding.symbol
    if binding.target_module_index == .Val(owner_index) {
        updated := binding.symbol
        updated.ty = graph.modules[owner_index].symbols[binding.target_symbol_row].ty
        return updated
    }
    binding.symbol
}

sema_registration_export_ty: fn(graph: SemaRegistrationGraph, export: SemaRegistrationExport) -> Type? Never! {
    if export.symbol.ty != None -> return export.symbol.ty
    if export.target_symbol_row >= 0 {
        if sema_registration_module_index(graph, export.source_module_identity) == .Val(owner_index) {
            return graph.modules[owner_index].symbols[export.target_symbol_row].ty
        }
    }
    None
}

sema_registration_export_symbol: fn(graph: SemaRegistrationGraph, export: SemaRegistrationExport) -> Symbol Never! {
    if export.symbol.ty != None || export.target_symbol_row < 0 -> return export.symbol
    if sema_registration_module_index(graph, export.source_module_identity) == .Val(owner_index) {
        updated := export.symbol
        updated.ty = graph.modules[owner_index].symbols[export.target_symbol_row].ty
        return updated
    }
    export.symbol
}

sema_resolved_ty: fn(graph: SemaRegistrationGraph, resolved: SemaRegistrationResolvedSymbol) -> Type? Never! {
    if resolved.place == {
        .Declared(module_index, row) -> graph.modules[module_index].symbols[row].ty
        .Imported(module_index, import_index, binding) -> sema_registration_binding_ty(graph, graph.modules[module_index].imports[import_index].bindings[binding])
        .Nominal(module_index, row) -> graph.modules[module_index].nominals[row].symbol.ty
        .Detached(symbol) -> symbol.ty
    }
}

sema_resolved_module_identity: fn(graph: SemaRegistrationGraph, resolved: SemaRegistrationResolvedSymbol) -> ModuleID Never! {
    if resolved.place == {
        .Declared(module_index, row) -> graph.modules[module_index].symbols[row].module_identity
        .Imported(module_index, import_index, binding) -> graph.modules[module_index].imports[import_index].bindings[binding].symbol.module_identity
        .Nominal(module_index, row) -> graph.modules[module_index].nominals[row].symbol.module_identity
        .Detached(symbol) -> symbol.module_identity
    }
}

// A copy of the resolved Symbol, for a caller that keeps it.
sema_resolved_symbol: fn(graph: SemaRegistrationGraph, resolved: SemaRegistrationResolvedSymbol) -> Symbol Never! {
    if resolved.place == {
        .Declared(module_index, row) -> graph.modules[module_index].symbols[row]
        .Imported(module_index, import_index, binding) -> sema_registration_binding_symbol(graph, graph.modules[module_index].imports[import_index].bindings[binding])
        .Nominal(module_index, row) -> graph.modules[module_index].nominals[row].symbol
        .Detached(symbol) -> symbol
    }
}

sema_registration_visibility: fn(is_pub: Bool, is_package_pub: Bool) -> Int Never! {
    if {
        is_pub -> 2
        is_package_pub -> 1
        else -> 0
    }
}

// The registered visibility of a declaration named `name` at a module's top
// level. A Core item named `__…` is Core's machine space and Core declares it
// `priv` (E0645), but user source can't spell a `__` name (E0067), nor can a
// package's template paste one (Derives.jet sema_derive_paste_refused): the
// names that reach one are Core's own and the code the compiler generates
// into any module, which passes visibility. So its symbol is reachable as a
// public one is, and `priv` keeps it out of Core's listed surface.
priv sema_registration_item_visibility: fn(module_id: ModuleID, name: String, is_pub: Bool, is_package_pub: Bool) -> Int Never! {
    if module_is_core(module_id) && name.starts_with("__") -> return 2
    sema_registration_visibility(is_pub, is_package_pub)
}

// The files of one manifest package share one namespace. A
// loose source root (the loader's `source-root:` identity) has none: each
// loose file keeps its private names to itself.
sema_registration_package_is_namespace: fn(package_identity: String) -> Bool Never! {
    package_identity != "" && !package_identity.starts_with("source-root:")
}

sema_registration_visible: fn(visibility: Int, source_module: ModuleID, source_package: String, owner_module: ModuleID, owner_package: String) -> Bool Never! {
    if {
        source_module == owner_module -> true
        module_is_core(source_module) && module_is_core(owner_module) -> true
        visibility >= 2 -> true
        source_package != owner_package -> false
        else -> visibility >= 1 || sema_registration_package_is_namespace(owner_package)
    }
}

sema_registration_identity_key: fn(module_identity: String, ty: Type) -> String Never! {
    "{module_identity}:{type_identity_key(ty)}"
}

// `module_identity` is the declaring module: the bounds' trait names resolve
// there, whichever module calls the declaration.
sema_registration_generic_params: fn(type_params: [TypeParam], owner_key: String, module_identity: ModuleID, diagnostics: ^[Diagnostic]) -> [SemaRegistrationGenericParam] {
    params := [SemaRegistrationGenericParam]{}
    loop (index, parameter) in type_params {
        // A `<N: Int>` number parameter is a generic parameter whose
        // arguments are numbers; one of another value type is E0390 in the
        // casing walk and is never registered.
        if parameter.prep == .Val(prep) && prep.value_type != "Int" -> next
        duplicate: loop previous in params {
            if previous.name == parameter.name {
                break true
            }
        } ?? false
        if duplicate {
            diagnostics.push(sema_defined_twice(parameter.name, "generic parameter names must be unique", parameter.name_span))
        }
        bound_key: parameter.bounds.join("+")
        params.push(
            SemaRegistrationGenericParam{
                index: index,
                name: parameter.name,
                bounds: parameter.bounds,
                span: parameter.name_span,
                identity_key: "{owner_key}<{index}:{parameter.name}[{bound_key}]>",
                module_identity: module_identity,
                number: parameter.prep != None,
            },
        )
    }
    params
}

sema_registration_type_is_fn: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Fn(_, _, _, _, _, _) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// Keep this predicate at the ABI boundary: callback transport is determined
// from the effective, instantiated parameter type, not the source spelling.
// In particular, the internal C++ marker is authoritative and user tags are
// never treated as a callback ABI.
sema_registration_callback_boundary_param: fn(abi: SemaRegistrationCallableABI, effective_type: Type) -> Bool Never! {
    if effective_type == {
        .Tagged(marker, inner) -> {
            if marker == (TagMarker.Internal{internal_tag: InternalTag.CppCallbackABI}) && sema_registration_type_is_fn(inner) {
                return true
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    abi.is_c_abi && sema_registration_type_is_fn(effective_type)
}

// The effect an inline `#FFI(<lang>)` body runs under: the FFI leaf named by
// the language, or the FFI root for a language with no leaf.
sema_registration_inline_foreign_effect_root: fn(language: String) -> String Never! {
    wanted: "ffi.{language.lower()}"
    loop leaf in EFFECT_VOCABULARY_LEAVES {
        if leaf.lower() == wanted -> return leaf.copy()
    }
    "FFI"
}

sema_registration_callable_abi_for_func: fn(func: Func) -> SemaRegistrationCallableABI Never! {
    foreign_effect_root: func.inline_foreign.map(fn(foreign) { sema_registration_inline_foreign_effect_root(foreign.lang) })
    SemaRegistrationCallableABI{
        is_extern: func.inline_foreign != None,
        is_c_abi: false,
        c_abi_name: None,
        callback_transport: None,
        callback_plan_digest: None,
        callback_identity: None,
        foreign_effect_root: foreign_effect_root,
    }
}

sema_registration_callable_abi_for_extern: fn(function: ExternFn, owner: SemaRegistrationForeignOwner) -> SemaRegistrationCallableABI Never! {
    c_abi_name: function.abi.map(fn(abi) { abi.name })
    SemaRegistrationCallableABI{
        is_extern: true,
        is_c_abi: owner == SemaRegistrationForeignOwner.CModule,
        c_abi_name: c_abi_name,
        callback_transport: function.callback_transport,
        callback_plan_digest: function.callback_plan_digest,
        callback_identity: function.callback_identity,
        foreign_effect_root: function.effect_root,
    }
}

sema_registration_extern_contract: fn(params: [Param]) -> [CallContractRow]? {
    contract := [CallContractRow]{}
    has_contract := false
    loop parameter in params {
        implicit_local_label: parameter.zone == ParamZone.Either && parameter.public_label == None
        label: if {
            parameter.zone == ParamZone.PositionalOnly || implicit_local_label -> ""
            else -> parameter.public_label.map(fn(public_label) { public_label.name }) ?? parameter.name
        }
        contract.push(CallContractRow{label: label, zone: parameter.zone})
        if label != "" || parameter.zone != ParamZone.Either -> has_contract = true
    }
    if has_contract -> Val(contract) else -> None
}

// A written C binding (`#Import c.lib: module { … }`) calls a C symbol that has
// no Jet failure rail: its contract is `T Never!`, and `#Import` declarations
// cannot spell a contract (E3203). Bridge and generated rows keep the
// declared-return projection.
sema_registration_extern_signature: fn(function: ExternFn, owner: SemaRegistrationForeignOwner) -> Type Never! {
    params := [Type]{}
    names := [String]{}
    defaults := [FunctionDefaultRef?]{}
    variadic := [Bool]{}
    conventions := [AccessConvention]{}
    loop parameter_index in 0..<function.params.len() {
        ty: function.params[parameter_index].ty
        if function.params[parameter_index].variadic -> params.push(Type.List{element: ty}) else {
            params.push(ty.copy())
        }
        names.push(function.params[parameter_index].name)
        defaults.push(None)
        variadic.push(function.params[parameter_index].variadic)
        conventions.push(function.params[parameter_index].convention)
    }
    metadata: FunctionCallMetadata{
        names: names,
        defaults: defaults,
        variadic: variadic,
        conventions: conventions,
        policies: CallablePolicyChain{policies: [CallablePolicy]{}},
    }
    ret: if owner == SemaRegistrationForeignOwner.CModule && !function.generated -> Type.Result{ok: function.return_type ?? Type.Named{name: "Unit"}, err: Type.Named{name: "Never"}} else -> sema_effective_return_type(function.return_type)
    Type.Fn{params: params, ret: Val(ret), effect_bound: None, param_contract: sema_registration_extern_contract(function.params), call_metadata: Val(metadata), return_view_provenance: None}
}

sema_registration_extern_parameters: fn(function: ExternFn, module_id: ModuleID, module_identity: String, owner_key: String, symbols: ^SymbolTable, signature: Type) -> [SemaRegistrationParameter] Never! {
    parameters := [SemaRegistrationParameter]{}
    loop (index, parameter) in function.params {
        parameter_ty: if parameter.variadic -> Type.List{element: parameter.ty} else -> parameter.ty
        parameters.push(
            SemaRegistrationParameter{
                index: index,
                name: parameter.name,
                span: parameter.name_span,
                ty: parameter_ty,
                convention: parameter.convention,
                zone: parameter.zone,
                public_label: sema_registration_parameter_label(parameter),
                variadic: parameter.variadic,
                default: None,
                default_ref: None,
            },
        )
    }
    parameters
}

sema_registration_function_signature: fn(func: Func, raw_protocol_return: Bool, owner_key: String, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> Type {
    projected: sema_function_symbol_type(func, raw_protocol_return, owner_key, fallback_source_file, fallback_source_origin, source_segments)
    if func.declared_effects == None -> return projected
    if projected == {
        .Fn(params, ret, _, contract, metadata, provenance) -> Type.Fn{params: params, ret: ret, effect_bound: func.declared_effects, param_contract: contract, call_metadata: metadata, return_view_provenance: provenance}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> projected
    }
}

sema_registration_parameter_label: fn(parameter: Param) -> String? {
    if parameter.public_label == .Val(public_label) -> return Val(public_label.name)
    if parameter.zone == {
        .PositionalOnly | .Either -> None
        .LabelOnly -> Val(parameter.name)
    }
}

sema_registration_signature_metadata: fn(signature: Type) -> FunctionCallMetadata? {
    if signature == {
        // copy: `metadata` is a payload of read parameter `signature`, which keeps the original; the returned value owns this one
        .Fn(_, _, _, _, metadata, _) -> metadata.copy()
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

sema_registration_function_parameters: fn(func: Func, signature: Type) -> [SemaRegistrationParameter] Never! {
    parameters := [SemaRegistrationParameter]{}
    if func.params.len() == 0 -> return parameters
    parameters.try_reserve(func.params.len()) ?? ()
    has_defaults := false
    loop parameter in func.params {
        if parameter.default != None {
            has_defaults = true
            break
        }
    }
    defaults := if has_defaults -> sema_registration_signature_metadata(signature).map(fn(row) { row.defaults }) ?? [FunctionDefaultRef?]{} else -> [FunctionDefaultRef?]{}
    loop (index, parameter) in func.params {
        ty: type_with_effective_parameter_fn_return(parameter.ty)
        parameter_ty: if parameter.variadic -> Type.List{element: ty} else -> ty
        default_ref: if index < defaults.len() -> defaults[index] else -> None
        parameters.push(
            SemaRegistrationParameter{
                index: index,
                name: parameter.name,
                span: parameter.name_span,
                ty: parameter_ty,
                convention: parameter.convention,
                zone: parameter.zone,
                public_label: sema_registration_parameter_label(parameter),
                variadic: parameter.variadic,
                default: parameter.default,
                default_ref: default_ref,
            },
        )
    }
    parameters
}

// `module_id` is the declaring module and `module_identity` its identity
// text, which the function's symbol keys spell; `symbols` mints them.
sema_registration_func_header: fn(func: Func) -> Func Never! {
    Func{
        span: func.span,
        is_pub: func.is_pub,
        is_package_pub: func.is_package_pub,
        is_comptime: func.is_comptime,
        external_type: func.external_type,
        name: func.name,
        name_span: func.name_span,
        meta: func.meta,
        type_params: func.type_params,
        head_pattern: func.head_pattern,
        params: func.params,
        return_type: func.return_type,
        return_type_span: func.return_type_span,
        return_view_provenance: func.return_view_provenance,
        declared_return_view_provenance: func.declared_return_view_provenance,
        gc_return: func.gc_return,
        diverges: func.diverges,
        gc_scope: func.gc_scope,
        is_unsafe: func.is_unsafe,
        unsafe_reason: func.unsafe_reason,
        unsafe_span: func.unsafe_span,
        is_pure: func.is_pure,
        scrub_tag: func.scrub_tag,
        declared_effects: func.declared_effects,
        effect_via: func.effect_via,
        is_reactive: func.is_reactive,
        reactive_upgrades: func.reactive_upgrades,
        is_replayable: func.is_replayable,
        replayable_span: func.replayable_span,
        is_job: func.is_job,
        job_span: func.job_span,
        job_metadata: func.job_metadata,
        every: func.every,
        is_must_use: func.is_must_use,
        must_use_span: func.must_use_span,
        maturity: func.maturity,
        maturity_span: func.maturity_span,
        kernel: func.kernel,
        is_inline: func.is_inline,
        is_inline_always: func.is_inline_always,
        inline_span: func.inline_span,
        web_marker: func.web_marker,
        pre: func.pre,
        post: func.post,
        inline_foreign: func.inline_foreign,
        undo: func.undo,
        markers: func.markers,
        compiler_generated: func.compiler_generated,
        body: [Stmt]{},
        module_caps: func.module_caps,
        definition_module: func.definition_module,
        site_names: func.site_names,
        max_depth: func.max_depth,
        state_types: func.state_types,
        marker_check: func.marker_check,
    }
}

sema_registration_trait_impl_block_header: fn(block: TraitImplBlock) -> TraitImplBlock Never! {
    methods: loop method in block.methods -> sema_registration_func_header(method)
    TraitImplBlock{
        trait_name: block.trait_name,
        trait_span: block.trait_span,
        operator_rhs: block.operator_rhs,
        operator_marker: block.operator_marker,
        methods: methods,
        compiler_generated: block.compiler_generated,
        assoc_type_impls: block.assoc_type_impls,
        constants: block.constants,
        delegation_field: block.delegation_field,
        markers: block.markers,
        os_target: block.os_target,
        span: block.span,
    }
}

sema_registration_impl_header: fn(definition: ImplDef) -> ImplDef Never! {
    methods: loop method in definition.methods -> sema_registration_func_header(method)
    ImplDef{
        span: definition.span,
        type_name: definition.type_name,
        type_span: definition.type_span,
        trait_name: definition.trait_name,
        trait_span: definition.trait_span,
        operator_rhs: definition.operator_rhs,
        operator_marker: definition.operator_marker,
        methods: methods,
        delegation_field: definition.delegation_field,
        assoc_type_impls: definition.assoc_type_impls,
        constants: definition.constants,
        is_generated_serde: definition.is_generated_serde,
        os_target: definition.os_target,
        markers: definition.markers,
        type_params: definition.type_params,
    }
}

sema_registration_struct_header: fn(definition: StructDef) -> StructDef Never! {
    methods: loop method in definition.methods -> sema_registration_func_header(method)
    trait_impls: loop block in definition.trait_impls -> sema_registration_trait_impl_block_header(block)
    StructDef{
        span: definition.span,
        is_pub: definition.is_pub,
        is_package_pub: definition.is_package_pub,
        compiler_builtin_error: definition.compiler_builtin_error,
        name: definition.name,
        name_span: definition.name_span,
        type_params: definition.type_params,
        fields: definition.fields,
        state: definition.state,
        methods: methods,
        cli_bindings: definition.cli_bindings,
        trait_impls: trait_impls,
        derives: definition.derives,
        auto_derive_default: definition.auto_derive_default,
        is_published_schema: definition.is_published_schema,
        published_schema_span: definition.published_schema_span,
        is_single_use: definition.is_single_use,
        single_use_span: definition.single_use_span,
        is_must_use: definition.is_must_use,
        must_use_span: definition.must_use_span,
        layout: definition.layout,
        layout_span: definition.layout_span,
        layout_alignment_span: definition.layout_alignment_span,
        serde_markers: definition.serde_markers,
        type_markers: definition.type_markers,
        validate_block: definition.validate_block,
        validate_span: definition.validate_span,
        marker: definition.marker,
        marker_span: definition.marker_span,
        marker_expand_span: definition.marker_expand_span,
        effect_impl: definition.effect_impl,
        fact: definition.fact,
        cap: definition.cap,
        inline_module: definition.inline_module,
    }
}

sema_registration_enum_header: fn(definition: EnumDef) -> EnumDef Never! {
    methods: loop method in definition.methods -> sema_registration_func_header(method)
    trait_impls: loop block in definition.trait_impls -> sema_registration_trait_impl_block_header(block)
    EnumDef{
        span: definition.span,
        is_pub: definition.is_pub,
        is_package_pub: definition.is_package_pub,
        name: definition.name,
        name_span: definition.name_span,
        type_params: definition.type_params,
        variants: definition.variants,
        methods: methods,
        trait_impls: trait_impls,
        derives: definition.derives,
        auto_derive_default: definition.auto_derive_default,
        is_single_use: definition.is_single_use,
        single_use_span: definition.single_use_span,
        is_must_use: definition.is_must_use,
        must_use_span: definition.must_use_span,
        serde_markers: definition.serde_markers,
        type_markers: definition.type_markers,
        groups: definition.groups,
        effect_impl: definition.effect_impl,
        cap: definition.cap,
        state: definition.state,
    }
}

// Canonical body of a registered function or method: reads the program item
// in place when the registration row stores only a header (`item_index >= 0`).
sema_registration_function_body: fn(module_row: SemaRegistrationModule, function: SemaRegistrationFunction) -> [Stmt] Never! {
    if function.declaration.body.len() > 0 -> return function.declaration.body
    index: function.item_index
    if index >= 0 && index < module_row.program.items.len() {
        if module_row.program.items[index] == {
            .Func(item_func) -> {
                if item_func.name == function.declaration.name && item_func.span == function.declaration.span {
                    return item_func.body
                }
            }
            .Impl(item_impl) -> {
                method_index: function.method_index
                if method_index >= 0 && method_index < item_impl.methods.len() {
                    if item_impl.methods[method_index].name == function.declaration.name && item_impl.methods[method_index].span == function.declaration.span {
                        return item_impl.methods[method_index].body
                    }
                }
            }
            .Struct(item_struct) -> {
                method_index: function.method_index
                trait_block_index: function.trait_block_index
                if trait_block_index >= 0 {
                    if trait_block_index < item_struct.trait_impls.len() && method_index >= 0 && method_index < item_struct.trait_impls[trait_block_index].methods.len() {
                        if item_struct.trait_impls[trait_block_index].methods[method_index].name == function.declaration.name && item_struct.trait_impls[trait_block_index].methods[method_index].span == function.declaration.span {
                            return item_struct.trait_impls[trait_block_index].methods[method_index].body
                        }
                    }
                } else if method_index >= 0 && method_index < item_struct.methods.len() {
                    if item_struct.methods[method_index].name == function.declaration.name && item_struct.methods[method_index].span == function.declaration.span {
                        return item_struct.methods[method_index].body
                    }
                }
            }
            .Enum(item_enum) -> {
                method_index: function.method_index
                trait_block_index: function.trait_block_index
                if trait_block_index >= 0 {
                    if trait_block_index < item_enum.trait_impls.len() && method_index >= 0 && method_index < item_enum.trait_impls[trait_block_index].methods.len() {
                        if item_enum.trait_impls[trait_block_index].methods[method_index].name == function.declaration.name && item_enum.trait_impls[trait_block_index].methods[method_index].span == function.declaration.span {
                            return item_enum.trait_impls[trait_block_index].methods[method_index].body
                        }
                    }
                } else if method_index >= 0 && method_index < item_enum.methods.len() {
                    if item_enum.methods[method_index].name == function.declaration.name && item_enum.methods[method_index].span == function.declaration.span {
                        return item_enum.methods[method_index].body
                    }
                }
            }
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    if function.method_index < 0 {
        loop item in module_row.program.items {
            if item == .Func(item_func) {
                if item_func.name == function.declaration.name && item_func.span == function.declaration.span {
                    return item_func.body
                }
            }
        }
    }
    function.declaration.body
}

// Points every function and method row of `module_row` at its item's index
// once items left `program.items`: `moved` holds each old index's new one,
// or -1 for an item that left. A row past `moved` names no program item.
sema_registration_move_item_rows: fn(module_row: ^SemaRegistrationModule, moved: [Int]) Never! {
    loop row in 0..<module_row.functions.len() {
        module_row.functions[row].item_index = sema_registration_moved_item(moved, module_row.functions[row].item_index)
    }
    loop nominal in 0..<module_row.nominals.len() {
        loop row in 0..<module_row.nominals[nominal].methods.len() {
            module_row.nominals[nominal].methods[row].item_index = sema_registration_moved_item(moved, module_row.nominals[nominal].methods[row].item_index)
        }
    }
    loop owner in 0..<module_row.impls.len() {
        loop row in 0..<module_row.impls[owner].methods.len() {
            module_row.impls[owner].methods[row].item_index = sema_registration_moved_item(moved, module_row.impls[owner].methods[row].item_index)
        }
    }
}

sema_registration_moved_item: fn(moved: [Int], index: Int) -> Int Never! {
    if index < 0 || index >= moved.len() -> return -1
    moved[index]
}

sema_registration_function_with_body: fn(module_row: SemaRegistrationModule, function: SemaRegistrationFunction) -> Func Never! {
    updated := sema_registration_func_header(function.declaration)
    updated.body = sema_registration_function_body(module_row, function)
    updated
}

sema_registration_function: fn(func: Func, raw_protocol_return: Bool, module_id: ModuleID, module_identity: String, owner: SymbolID?, symbols: ^SymbolTable, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment], diagnostics: ^[Diagnostic], keep_body: Bool{true}, item_index: Int{-1}, method_index: Int{-1}, trait_block_index: Int{-1}) -> SemaRegistrationFunction {
    owner_key: if owner == .Val(value) -> symbol_table_key(symbols, value) else -> ""
    symbol_kind: SymbolKind.Function
    symbol_id_value: symbol_mint(symbols, symbol_kind, module_identity, owner_key, func.name)
    // The interned key itself: the parameters' owner and the signature share
    // it, so the run holds one copy of each function key.
    key: symbol_table_key(symbols, symbol_id_value)
    signature: sema_registration_function_signature(func, raw_protocol_return, key, fallback_source_file, fallback_source_origin, source_segments)
    visibility: if owner == None -> sema_registration_item_visibility(module_id, func.name, func.is_pub, func.is_package_pub) else -> sema_registration_visibility(func.is_pub, func.is_package_pub)
    symbol: Symbol{
        id: symbol_id_value,
        kind: symbol_kind,
        name: func.name,
        module_identity: module_id,
        owner: if owner == None -> None else -> Val(owner_key),
        span: func.name_span,
        ty: None,
        visibility: visibility,
    }
    generic_params: sema_registration_generic_params(func.type_params, key, module_id, diagnostics)
    abi: sema_registration_callable_abi_for_func(func)
    parameters: sema_registration_function_parameters(func, signature)
    has_defaults := false
    loop parameter in func.params {
        if parameter.default != None {
            has_defaults = true
            break
        }
    }
    if has_defaults {
        metadata: sema_registration_signature_metadata(signature)
        if metadata == .Val(row) {
            loop (index, parameter) in func.params {
                if parameter.default != None && (index >= row.defaults.len() || row.defaults[index] == None) {
                    diagnostics.push(sema_error("E0003", expr_span(parameter.default ?? Expr.Unit{span: parameter.name_span, id: AST_NODE_GENERATED}), "a callable default has no stable source identity", "default expressions are resolved by their owning declaration, parameter index, and span", "preserve the declaration's FunctionDefaultRef metadata"))
                }
            }
        }
    }
    SemaRegistrationFunction{
        symbol: symbol,
        // copy: synthetic/cross-module rows own their declaration; program-backed functions and methods store a header and read their body from program.items.
        declaration: if keep_body -> func.copy() else -> sema_registration_func_header(func),
        signature: signature,
        generic_params: generic_params,
        parameters: parameters,
        abi: abi,
        raw_protocol_return: raw_protocol_return,
        item_index: item_index,
        method_index: method_index,
        trait_block_index: trait_block_index,
    }
}

sema_registration_foreign_visibility: fn(owner: SemaRegistrationForeignOwner) -> Int Never! {
    if owner == SemaRegistrationForeignOwner.CModule -> 2 else -> 0
}

sema_registration_foreign_function: fn(function: ExternFn, module_id: ModuleID, module_identity: String, owner: SemaRegistrationForeignOwner, symbols: ^SymbolTable, foreign_library: String, foreign_library_span: Span) -> SemaRegistrationForeignFunction Never! {
    signature: sema_registration_extern_signature(function, owner)
    // Foreign declarations are module-level: no owner segment in the id.
    id: symbol_mint(symbols, SymbolKind.Function, module_identity, "", function.name)
    symbol: Symbol{
        id: id,
        kind: SymbolKind.Function,
        name: function.name,
        module_identity: module_id,
        owner: None,
        span: function.name_span,
        ty: Val(signature),
        visibility: sema_registration_foreign_visibility(owner),
    }
    key: symbol_table_key(symbols, id)
    parameters: sema_registration_extern_parameters(function, module_id, module_identity, key, symbols, signature)
    SemaRegistrationForeignFunction{
        symbol: symbol,
        declaration: function,
        owner: owner,
        foreign_library: foreign_library,
        foreign_library_span: foreign_library_span,
        generic_params: [SemaRegistrationGenericParam]{},
        parameters: parameters,
        abi: sema_registration_callable_abi_for_extern(function, owner),
    }
}

// The callable registered under `key`: one keyed lookup of its DeclID. None
// means the target is unknown; callers must not manufacture a false ABI.
sema_registration_callable_row: fn(graph: SemaRegistrationGraph, key: String) -> SemaRegistrationCallableRow? Never! {
    id: decl_table_find(graph.decls, graph.symbols, key) ?? return None
    Val(graph.callables[decl_id_index(id)])
}

// The DeclID of the callable registered as the run-wide `symbol`.
sema_registration_callable_id: fn(graph: SemaRegistrationGraph, symbol: SymbolID) -> DeclID? Never! {
    decl_table_find_symbol(graph.decls, symbol)
}

// The key text of a run-wide symbol; a body's own id names none ("").
sema_registration_symbol_key: fn(graph: SemaRegistrationGraph, id: SymbolID) -> String Never! {
    if symbol_is_local(id) -> return ""
    symbol_table_key(graph.symbols, id)
}

// The callable registered as `target`; a body's own id names none.
sema_registration_callable_row_of: fn(graph: SemaRegistrationGraph, target: SymbolID) -> SemaRegistrationCallableRow? Never! {
    if symbol_is_local(target) -> return None
    id: decl_table_find_symbol(graph.decls, target) ?? return None
    Val(graph.callables[decl_id_index(id)])
}

sema_registration_callable_abi: fn(graph: SemaRegistrationGraph, target: SymbolID) -> SemaRegistrationCallableABI? {
    row: sema_registration_callable_row_of(graph, target) ?? return None
    if row == {
        .Function(module_index, index) -> Val(graph.modules[module_index].functions[index].abi)
        .Foreign(module_index, index) -> Val(graph.modules[module_index].foreign_functions[index].abi)
        .NominalMethod(module_index, owner, index) -> Val(graph.modules[module_index].nominals[owner].methods[index].abi)
        .ImplMethod(module_index, owner, index) -> Val(graph.modules[module_index].impls[owner].methods[index].abi)
    }
}

// The Jet declaration of the callable registered under `target`: one keyed
// lookup instead of a scan of every module's callables. Foreign rows have none.
sema_registration_callable_declaration: fn(graph: SemaRegistrationGraph, target: SymbolID) -> Func? {
    row: sema_registration_callable_row_of(graph, target) ?? return None
    if row == {
        .Function(module_index, index) -> Val(graph.modules[module_index].functions[index].declaration)
        .Foreign(_, _) -> None
        .NominalMethod(module_index, owner, index) -> Val(graph.modules[module_index].nominals[owner].methods[index].declaration)
        .ImplMethod(module_index, owner, index) -> Val(graph.modules[module_index].impls[owner].methods[index].declaration)
    }
}

// Records the first registered row of each nominal SymbolID in
// `module_index` from `first_row` on, and appends the rows' base-name
// buckets. Rows only append, so an id already present keeps its earlier row.
sema_registration_index_nominal_rows: fn(graph: ^SemaRegistrationGraph, module_index: Int, first_row: Int) Never! {
    loop row in first_row..<graph.modules[module_index].nominals.len() {
        id: graph.modules[module_index].nominals[row].symbol.id.id
        if graph.nominal_symbol_rows.get(id) == None {
            graph.nominal_symbol_rows.add(id, SemaRegistrationRowRef{module_index: module_index, row: row}).drop("checked absent above")
        }
    }
    sema_registration_index_nominal_names(graph, module_index, first_row)
}

// Appends the base-name rows of `module_index`'s nominals from `first_row` on.
sema_registration_index_nominal_names: fn(graph: ^SemaRegistrationGraph, module_index: Int, first_row: Int) Never! {
    loop row in first_row..<graph.modules[module_index].nominals.len() {
        name: sema_expr_type_base_name(graph.modules[module_index].nominals[row].ty) ?? next
        reference: SemaRegistrationRowRef{module_index: module_index, row: row}
        slot: name_index(name_intern(graph.nominal_row_names, name))
        loop graph.nominal_row_buckets.len() <= slot -> graph.nominal_row_buckets.push([SemaRegistrationRowRef]{})
        graph.nominal_row_buckets[slot].push(reference)
    }
}

// The nominal rows registered under base type name `name`, in module/row order.
sema_registration_nominal_rows_named: fn(graph: SemaRegistrationGraph, name: String) -> [SemaRegistrationRowRef] {
    found: name_find(graph.nominal_row_names, name) ?? return [SemaRegistrationRowRef]{}
    slot: name_index(found)
    if slot >= graph.nominal_row_buckets.len() -> return [SemaRegistrationRowRef]{}
    graph.nominal_row_buckets[slot]
}

// Whether the package of module row `from` reaches module row `to` through
// its imports (SemaRegistrationGraph.package_reach). A Core module, a row
// the graph grew after the reach was cut, and a graph cut without it reach
// nothing.
sema_registration_reaches: fn(graph: SemaRegistrationGraph, from: Int, to: Int) -> Bool Never! {
    if from < 0 || from >= graph.modules.len() || to < 0 -> return false
    found: name_find(graph.package_reach_names, graph.modules[from].package_identity) ?? return false
    slot: name_index(found)
    if slot >= graph.package_reach.len() -> return false
    to < graph.package_reach[slot].len() && graph.package_reach[slot][to]
}

// Each source package's reach (SemaRegistrationGraph.package_reach), once
// every import is bound. A package reaches its own modules; an import of
// another source package's module reaches that whole package, whose files
// see each other's names; an import of a Core module reaches that module
// and what it imports.
sema_registration_index_package_reach: fn(graph: ^SemaRegistrationGraph) Never! {
    names := name_table_sized(16)
    members := [[Int]]{[Int]{}}
    loop row in 0..<graph.modules.len() {
        if module_is_core(graph.modules[row].module_identity) -> next
        slot: name_index(name_intern(names, graph.modules[row].package_identity))
        loop members.len() <= slot -> members.push([Int]{})
        members[slot].push(row)
    }
    reach := [[Bool]]{[Bool]{}}
    loop slot in 1..<members.len() {
        seen := (loop _ in 0..<graph.modules.len() -> false)
        pending := [Int]{}
        loop member in members[slot] {
            seen[member] = true
            pending.push(member)
        }
        loop pending.len() > 0 {
            from: pending.pop() ?? break
            loop import in graph.modules[from].imports {
                if !module_is_core(import.target_module_identity) {
                    target_found: name_find(names, import.target_package_identity) ?? next
                    target_slot: name_index(target_found)
                    if target_slot >= members.len() -> next
                    loop member in members[target_slot] {
                        if seen[member] -> next
                        seen[member] = true
                        pending.push(member)
                    }
                    next
                }
                target: sema_registration_module_index(graph, import.target_module_identity) ?? next
                if seen[target] -> next
                seen[target] = true
                pending.push(target)
            }
        }
        reach.push(seen.move())
    }
    graph.package_reach_names = names.move()
    graph.package_reach = reach.move()
}

// The impl rows registered under target type name `name`, in module/row order.
// A structural impl (`impl [T].Trait`) is registered under its shape's family
// (type_structural_family), which every receiver of that shape names.
sema_registration_impl_rows_named: fn(graph: SemaRegistrationGraph, name: String) -> [SemaRegistrationRowRef] {
    found: name_find(graph.impl_row_names, name) ?? return [SemaRegistrationRowRef]{}
    slot: name_index(found)
    if slot >= graph.impl_row_buckets.len() -> return [SemaRegistrationRowRef]{}
    graph.impl_row_buckets[slot]
}

sema_registration_impl_row_key: fn(implementation: SemaRegistrationImpl) -> String {
    if type_structural_head_names(implementation.target_type) != None {
        if type_structural_family(implementation.target_type) == .Val(family) -> return family
    }
    implementation.target_type_name
}

// A Map is a sorted entry list: a whole-graph map filled in module/row order
// shifts every later entry on each insert (O(N^2) over the graph). The graph
// indexes below are built from rows merge-sorted once by (key, order), so
// every insert appends and each key's first registered row wins as before.
SemaRegistrationKeyedRow: struct {
    key: String,
    // Registration order: module, then row.
    order: Int,
    reference: SemaRegistrationRowRef,
}

sema_registration_keyed_row_push: fn(rows: ^[SemaRegistrationKeyedRow], key: String, module_index: Int, row: Int) Never! {
    order: rows.len()
    // copy: the index rows are sorted on their own; the graph keeps its rows.
    rows.push(SemaRegistrationKeyedRow{key: key.copy(), order: order, reference: SemaRegistrationRowRef{module_index: module_index, row: row}})
}

sema_registration_keyed_rows_sort: fn(rows: ^[SemaRegistrationKeyedRow]) Never! {
    rows = loop fresh_item in rows -> fresh_item
    rows.sort_by(fn(left: SemaRegistrationKeyedRow, right: SemaRegistrationKeyedRow) { (left.key <=> right.key).then(left.order <=> right.order) })
}

SemaRegistrationBuckets: struct {
    names: NameTable,
    buckets: [[SemaRegistrationRowRef]],
}

// Buckets sorted keyed rows by key: one slot per key, in ascending key
// order, each bucket in registration order.
sema_registration_bucket_sorted_rows: fn(rows: [SemaRegistrationKeyedRow]) -> SemaRegistrationBuckets Never! {
    names := name_table_sized(rows.len() * 2 + 2)
    buckets := [[SemaRegistrationRowRef]]{[SemaRegistrationRowRef]{}}
    loop at in 0..<rows.len() {
        if at == 0 || rows[at - 1].key != rows[at].key {
            slot: name_index(name_intern(names, rows[at].key))
            loop buckets.len() <= slot -> buckets.push([SemaRegistrationRowRef]{})
            buckets[slot].push(rows[at].reference)
        } else {
            last: buckets.len() - 1
            buckets[last].push(rows[at].reference)
        }
    }
    SemaRegistrationBuckets{names: names.move(), buckets: buckets.move()}
}

// Graph construction: every module's nominal SymbolID rows (the first row of
// an id wins) and base-name buckets. Later rows append through
// `sema_registration_index_nominal_rows`.
sema_registration_index_all_nominal_rows: fn(graph: ^SemaRegistrationGraph) Never! {
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].nominals.len() {
            id: graph.modules[module_index].nominals[row].symbol.id.id
            if graph.nominal_symbol_rows.get(id) == None {
                graph.nominal_symbol_rows[id] = SemaRegistrationRowRef{module_index: module_index, row: row}
            }
        }
    }
    sema_registration_index_all_nominal_names(graph)
}

// Graph construction's last step: the canonical spelling of every nominal row
// registered by then (SemaCanonicalNominals). A spelling's first row wins; any
// row of one spelling names the same module and leaf.
sema_registration_index_canonical_nominals: fn(graph: ^SemaRegistrationGraph) Never! {
    builtin_dotted := false
    loop idx in 1..<graph.compiler_builtin_names.texts.len() {
        if graph.compiler_builtin_names.texts[idx].contains(".") {
            builtin_dotted = true
            break
        }
    }
    ns_dotted := [Bool]{}
    loop slot in 0..<graph.namespace_tables.len() {
        dotted := false
        loop idx in 1..<graph.namespace_tables[slot].texts.len() {
            if graph.namespace_tables[slot].texts[idx].contains(".") {
                dotted = true
                break
            }
        }
        ns_dotted.push(dotted)
    }
    total_nominals := 0
    loop module_index in 0..<graph.modules.len() {
        total_nominals += graph.modules[module_index].nominals.len()
        dotted := builtin_dotted
        if !dotted {
            slot: graph.modules[module_index].namespace_slot
            if slot >= 0 && slot < ns_dotted.len() && ns_dotted[slot] -> dotted = true
        }
        if !dotted {
            loop idx in 1..<graph.modules[module_index].symbol_names.texts.len() {
                if graph.modules[module_index].symbol_names.texts[idx].contains(".") {
                    dotted = true
                    break
                }
            }
        }
        if !dotted {
            loop idx in 1..<graph.modules[module_index].import_binding_names.texts.len() {
                if graph.modules[module_index].import_binding_names.texts[idx].contains(".") {
                    dotted = true
                    break
                }
            }
        }
        graph.modules[module_index].has_dotted_symbols = dotted
    }
    table := SemaCanonicalNominals{names: [[String]]{}, rows: name_table_sized(total_nominals * 2 + 2), row_slots: [Int]{-1}, owners: [Int]{}, leaves: [String]{}, resolved: [SemaRegistrationResolvedSymbol?]{}, is_plain_type: [Bool]{}, is_ordinary_user_type: [Bool]{}}
    loop module_index in 0..<graph.modules.len() {
        names := [String]{}
        is_core_mod: module_is_core(graph.modules[module_index].module_identity)
        loop row in 0..<graph.modules[module_index].nominals.len() {
            leaf: graph.modules[module_index].nominals[row].symbol.name
            spelling: "{module_text(graph.module_table, graph.modules[module_index].nominals[row].symbol.module_identity)}.{leaf}"
            names.push(spelling.copy())
            owner: sema_registration_module_index(graph, graph.modules[module_index].nominals[row].symbol.module_identity) ?? next
            hash: name_text_hash(spelling)
            id: name_index(name_intern_hashed(table.rows, spelling, hash))
            loop table.row_slots.len() <= id -> table.row_slots.push(-1)
            if table.row_slots[id] >= 0 -> next
            leaf_hash: name_text_hash(leaf)
            owner_id: graph.modules[owner].module_identity
            found := sema_registration_lookup_module_probe(graph.modules[owner], owner, owner_id, leaf, leaf_hash)
            if found == None {
                if sema_registration_namespace_owner_at(graph, owner, leaf, leaf_hash) == .Val(ns_owner) {
                    found = Val(SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Declared{module_index: ns_owner.module_index, row: ns_owner.row}, source_module_identity: graph.modules[ns_owner.module_index].module_identity, target_module_identity: graph.modules[ns_owner.module_index].module_identity, visibility: graph.modules[ns_owner.module_index].symbols[ns_owner.row].visibility, nominal_row: sema_registration_symbol_nominal_row(graph.modules[ns_owner.module_index], ns_owner.module_index, ns_owner.row)})
                } else if sema_registration_compiler_builtin_row_hashed(graph, leaf, leaf_hash) == .Val(builtin) {
                    builtin_owner: graph.modules[builtin.module_index].nominals[builtin.row].symbol.module_identity
                    found = Val(SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Nominal{module_index: builtin.module_index, row: builtin.row}, source_module_identity: builtin_owner, target_module_identity: builtin_owner, visibility: graph.modules[builtin.module_index].nominals[builtin.row].symbol.visibility, nominal_row: Val(builtin)})
                }
            }
            plain := false
            if found == .Val(sym) {
                if sym.place == .Declared(dm, dr) && graph.modules[dm].symbols[dr].kind == SymbolKind.Type {
                    if sym.nominal_row == .Val(nr) && nr.module_index == module_index && nr.row == row {
                        nk: graph.modules[nr.module_index].nominals[nr.row].kind
                        if nk != SemaRegistrationNominalKind.TypeAlias && nk != SemaRegistrationNominalKind.Trait -> plain = true
                    }
                } else if sym.place == .Nominal(nm, nr) && nm == module_index && nr == row && graph.modules[nm].nominals[nr].symbol.kind == SymbolKind.Type {
                    nk: graph.modules[nm].nominals[nr].kind
                    if nk != SemaRegistrationNominalKind.TypeAlias && nk != SemaRegistrationNominalKind.Trait -> plain = true
                }
            }
            ordinary := false
            if plain && !is_core_mod && !graph.modules[module_index].nominals[row].compiler_owned && !sema_registration_is_special_receiver_leaf(leaf) {
                if graph.modules[module_index].nominals[row].source == .SourceAST(ast_item) {
                    if ast_item == {
                        .Struct(def) -> {
                            if def.layout == None && def.type_markers.len() == 0 && def.serde_markers.len() == 0 && def.marker == None && def.effect_impl == None && def.fact == None && def.cli_bindings.len() == 0 {
                                ordinary = true
                            }
                        }
                        .Enum(def) -> {
                            if def.type_markers.len() == 0 && def.serde_markers.len() == 0 && def.effect_impl == None {
                                ordinary = true
                            }
                        }
                        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
                    }
                }
            }
            table.row_slots[id] = table.owners.len()
            table.owners.push(owner)
            table.leaves.push(graph.modules[module_index].nominals[row].symbol.name)
            table.resolved.push(found)
            table.is_plain_type.push(plain)
            table.is_ordinary_user_type.push(ordinary)
        }
        table.names.push(names)
    }
    graph.canonical_nominals = Val(table.move())
}

sema_registration_is_special_receiver_leaf: fn(leaf: String) -> Bool Never! {
    if leaf == {
        "Dyn" | "JSON" | "App" | "Group" | "Task" | "Complex" | "ServiceTree" | "ServiceWorkflow" | "ServiceEndpoint" | "Delivery" | "DeliveryState" | "ServiceRuntime" | "HTTP" | "Router" | "Request" | "Response" | "Stream" | "Process" | "Command" | "Clock" | "Instant" | "Duration" | "Date" | "Socket" | "Listener" | "TcpStream" | "TcpListener" | "UdpSocket" | "Arena" | "Bump" | "Pool" | "Ptr" | "Guard" | "Signal" | "Cell" | "Shared" | "Channel" | "Receiver" | "Sender" | "TypeInfo" | "FieldInfo" | "CaseInfo" | "Value" | "Expr" | "Item" | "Vec2" | "Vec3" | "Vec4" | "Mat2" | "Mat3" | "Mat4" | "Quat" | "Rect" | "Point" | "Size" | "Color" | "Canvas" | "Sprite" | "World" | "Entity" | "Event" | "Queue" | "JobQueue" | "Set" | "Deque" | "PriorityQueue" | "Seq" | "RingBuffer" | "File" | "Path" | "Dir" | "Reader" | "Writer" | "Lines" | "Bytes" | "Buffer" | "Err" -> true
        else -> false
    }
}

sema_registration_is_ordinary_user_type: fn(graph: SemaRegistrationGraph, name: String) -> Bool Never! {
    if graph.canonical_nominals == .Val(canon) {
        if name_find(canon.rows, name) == .Val(found) {
            slot: canon.row_slots[name_index(found)]
            if slot >= 0 -> return canon.is_ordinary_user_type[slot]
        }
    }
    false
}

// `{module_name}.{name}` of nominal row `row`: the spelling built with the
// graph, or spelled here for a row registered after it.
sema_registration_nominal_spelling: fn(graph: SemaRegistrationGraph, row: SemaRegistrationRowRef) -> String Never! {
    if graph.canonical_nominals == .Val(table) {
        if row.module_index < table.names.len() && row.row < table.names[row.module_index].len() {
            return table.names[row.module_index][row.row]
        }
    }
    "{module_text(graph.module_table, graph.modules[row.module_index].nominals[row.row].symbol.module_identity)}.{graph.modules[row.module_index].nominals[row.row].symbol.name}"
}

sema_registration_index_all_nominal_names: fn(graph: ^SemaRegistrationGraph) Never! {
    name_rows := [SemaRegistrationKeyedRow]{}
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].nominals.len() {
            name: sema_expr_type_base_name(graph.modules[module_index].nominals[row].ty) ?? next
            sema_registration_keyed_row_push(name_rows, name, module_index, row)
        }
    }
    sema_registration_keyed_rows_sort(name_rows)
    named := sema_registration_bucket_sorted_rows(name_rows)
    graph.nominal_row_names = named.names.move()
    graph.nominal_row_buckets = named.buckets.move()
}

// Registration adds no callable or impl after the graph is prepared; later
// edits replace rows in place, so the first-match positions stay exact. This
// is the registration freeze of the callables' SymbolIds (Cutover B L2b). The
// base-name buckets are rebuilt here, each in module/row order; nominal rows
// pushed afterwards (minted failure unions) append through
// `sema_registration_index_nominal_rows`. A debugger's held check appends
// a function of the program's source its cut left out, a last row of both
// tables (JetSema ScriptHelpers.jet sema_script_probe_append).
sema_registration_index_callables: fn(graph: ^SemaRegistrationGraph) Never! {
    decls := DeclTable{}
    callables := [SemaRegistrationCallableRow]{}
    loop (module_index, module_row) in graph.modules {
        loop (index, function) in module_row.functions {
            _: decl_table_add(decls, function.symbol)
            callables.push(SemaRegistrationCallableRow.Function{module_index: module_index, row: index})
        }
        loop (index, function) in module_row.foreign_functions {
            _: decl_table_add(decls, function.symbol)
            callables.push(SemaRegistrationCallableRow.Foreign{module_index: module_index, row: index})
        }
        loop (owner, nominal) in module_row.nominals {
            loop (index, method) in nominal.methods {
                _: decl_table_add(decls, method.symbol)
                callables.push(SemaRegistrationCallableRow.NominalMethod{module_index: module_index, owner: owner, row: index})
            }
        }
        loop (owner, implementation) in module_row.impls {
            loop (index, method) in implementation.methods {
                _: decl_table_add(decls, method.symbol)
                callables.push(SemaRegistrationCallableRow.ImplMethod{module_index: module_index, owner: owner, row: index})
            }
        }
    }
    decl_table_index(decls)
    graph.decls = decls.move()
    graph.callables = callables.move()
    sema_registration_index_all_nominal_names(graph)
    impl_rows := [SemaRegistrationKeyedRow]{}
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].impls.len() {
            sema_registration_keyed_row_push(impl_rows, sema_registration_impl_row_key(graph.modules[module_index].impls[row]), module_index, row)
        }
    }
    sema_registration_keyed_rows_sort(impl_rows)
    targets := sema_registration_bucket_sorted_rows(impl_rows)
    graph.impl_row_names = targets.names.move()
    graph.impl_row_buckets = targets.buckets.move()
}

// Buckets every impl under the trait it implements, in module/row order. An
// inherent impl or an unresolved trait name matches no bound, so it has no
// bucket. The CheckedText impls are listed once more on their own
// (`checked_text_impl_rows`).
SemaRegistrationImplResolved: struct {
    target_nominal: SymbolID?,
    trait_id: SymbolID?,
    checked_text: Bool,
}

sema_registration_resolve_impl_traits_range: fn(graph: SemaRegistrationGraph, from: Int, to: Int) -> [[SemaRegistrationImplResolved]] {
    out := [[SemaRegistrationImplResolved]]{}
    loop module_index in from..<to {
        rows := [SemaRegistrationImplResolved]{}
        loop row in 0..<graph.modules[module_index].impls.len() {
            target_nominal: sema_type_graph_impl_target_nominal(graph, graph.modules[module_index].impls[row])
            trait_id: sema_type_graph_impl_trait(graph, graph.modules[module_index].impls[row])
            checked_text: sema_type_graph_is_checked_text_impl(graph, graph.modules[module_index].impls[row])
            rows.push(SemaRegistrationImplResolved{target_nominal: target_nominal, trait_id: trait_id, checked_text: checked_text})
        }
        out.push(rows.move())
    }
    out
}

sema_registration_resolve_impl_traits_spawn: fn(graph: SemaRegistrationGraph, bounds: [Int], part: Int, out: ^[[SemaRegistrationImplResolved]]) {
    if part + 1 >= bounds.len() -> return
    from: bounds[part]
    to: bounds[part + 1]
    if part + 2 >= bounds.len() {
        out.extend(sema_registration_resolve_impl_traits_range(graph, from, to))
        return
    }
    task.group sema_registration_impl_traits {
        head: task sema_registration_resolve_impl_traits_range(graph, from, to)
        rest := [[SemaRegistrationImplResolved]]{}
        sema_registration_resolve_impl_traits_spawn(graph, bounds, part + 1, rest)
        out.extend(compiler_threads_joined(head))
        out.extend(rest.move())
    }
}

sema_registration_index_impl_traits: fn(graph: ^SemaRegistrationGraph, threads: CompilerThreads) {
    weights := [Int]{}
    total_impls := 0
    loop module_index in 0..<graph.modules.len() {
        count: graph.modules[module_index].impls.len()
        weights.push(count)
        total_impls += count
    }
    workers: compiler_threads_admit(threads, graph.modules.len(), total_impls, 128, 0, 0)
    resolved := [[SemaRegistrationImplResolved]]{}
    if workers <= 1 {
        resolved = sema_registration_resolve_impl_traits_range(graph, 0, graph.modules.len())
    } else {
        was_counting: graph.counting
        graph.counting = false
        bounds: compiler_threads_partition(weights, workers)
        sema_registration_resolve_impl_traits_spawn(graph, bounds, 0, resolved)
        graph.counting = was_counting
    }
    graph.impl_trait_slots = [U32:Int]{}
    graph.impl_trait_buckets = [[SemaRegistrationRowRef]]{}
    graph.impl_trait_names = name_table_sized(64)
    graph.impl_trait_name_buckets = [[SemaRegistrationRowRef]]{[SemaRegistrationRowRef]{}}
    checked_text := [SemaRegistrationRowRef]{}
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].impls.len() {
            item: resolved[module_index][row]
            graph.modules[module_index].impls[row].target_nominal = item.target_nominal
            reference: SemaRegistrationRowRef{module_index: module_index, row: row}
            if item.checked_text -> checked_text.push(SemaRegistrationRowRef{module_index: module_index, row: row})
            // By spelled name: the declared trait name and the registered
            // trait symbol's name, once when both spell the same name. The
            // names are copied out first: the push edits the graph.
            declared_name := String?{None}
            if graph.modules[module_index].impls[row].trait_name == .Val(declared) {
                declared_name = Val(declared.copy())
            }
            symbol_name := String?{None}
            if graph.modules[module_index].impls[row].trait_symbol == .Val(trait_symbol) {
                symbol_name = Val(trait_symbol.name.copy())
            }
            if declared_name == .Val(name) {
                sema_registration_impl_trait_name_push(graph, name, reference)
            }
            if symbol_name == .Val(name) {
                if declared_name != Val((name)) {
                    sema_registration_impl_trait_name_push(graph, name, reference)
                }
            }
            trait_id: item.trait_id ?? next
            if graph.impl_trait_slots.get(trait_id.id) == .Val(slot) {
                graph.impl_trait_buckets[slot].push(reference)
            } else {
                graph.impl_trait_slots[trait_id.id] = graph.impl_trait_buckets.len()
                graph.impl_trait_buckets.push([SemaRegistrationRowRef]{reference})
            }
        }
    }
    graph.checked_text_impl_rows = checked_text.move()
    graph.impl_traits_indexed = true
}

sema_registration_impl_trait_name_push: fn(graph: ^SemaRegistrationGraph, trait_name: String, reference: SemaRegistrationRowRef) Never! {
    slot: name_index(name_intern(graph.impl_trait_names, trait_name))
    loop graph.impl_trait_name_buckets.len() <= slot -> graph.impl_trait_name_buckets.push([SemaRegistrationRowRef]{})
    graph.impl_trait_name_buckets[slot].push(reference.copy())
}

sema_registration_impl_trait_name_slot: fn(graph: SemaRegistrationGraph, trait_name: String) -> Int? Never! {
    found: name_find(graph.impl_trait_names, trait_name) ?? return None
    slot: name_index(found)
    if slot < graph.impl_trait_name_buckets.len() && graph.impl_trait_name_buckets[slot].len() > 0 -> return Val(slot)
    None
}

sema_registration_named_symbol: fn(module_id: ModuleID, module_identity: String, symbols: ^SymbolTable, name: String, span: Span, kind: SymbolKind, ty: Type?, is_pub: Bool, is_package_pub: Bool) -> Symbol Never! {
    Symbol{
        id: symbol_mint(symbols, kind, module_identity, "", name),
        kind: kind,
        name: name,
        module_identity: module_id,
        owner: None,
        span: span,
        ty: ty,
        visibility: sema_registration_item_visibility(module_id, name, is_pub, is_package_pub),
    }
}

// A trait declared in the module named `module_name`. An owned trait its
// module declares (OwnedTrait.declared_in) takes the trait's builtin id, so a
// bound written bare in any other module names this declaration. The check
// reads the module's name: a Core module's identity text is its source path.
sema_registration_trait_symbol: fn(module_id: ModuleID, module_identity: String, module_name: String, symbols: ^SymbolTable, name: String, span: Span, visibility: Int) -> Symbol Never! {
    Symbol{
        id: symbol_builtin_declared(SymbolKind.Trait, module_name, name) ?? symbol_mint(symbols, SymbolKind.Trait, module_identity, "", name),
        kind: SymbolKind.Trait,
        name: name,
        module_identity: module_id,
        owner: None,
        span: span,
        ty: None,
        visibility: visibility,
    }
}

sema_registration_nominal_type: fn(name: String, type_params: [TypeParam]) -> Type Never! {
    if type_params.len() == 0 -> return Type.Named{name: name}
    args: loop parameter in type_params -> Type.Named{name: parameter.name}
    Type.Apply{name: name, args: args}
}

sema_registration_variant_type: fn(payload: VariantPayload) -> Type? {
    if payload == {
        .Unit -> Val(Type.Named{name: "Unit"})
        // copy: `ty` is a payload of read parameter `payload`, which keeps the original; the Val carrier owns this one
        .Single(ty, _) -> Val(ty.copy())
        .Named(fields) -> {
            rows: loop field in fields -> TypeTupleField{name: field.name, ty: field.ty}
            Val(Type.Tuple{fields: rows})
        }
    }
}

sema_registration_struct_fields: fn(definition: StructDef, module_identity: String, owner: Symbol, symbols: ^SymbolTable, diagnostics: ^[Diagnostic]) -> [SemaRegistrationField] {
    owner_key: symbol_table_key(symbols, owner.id)
    fields := [SemaRegistrationField]{}
    seen := name_table_sized(definition.fields.len() + 1)
    loop field_index in 0..<definition.fields.len() {
        known: name_count(seen)
        duplicate: name_index(name_intern(seen, definition.fields[field_index].name)) < known
        if duplicate {
            diagnostics.push(sema_field_defined_twice(definition.fields[field_index].name, owner.name, definition.fields[field_index].name_span))
        }
        field_id: symbol_mint(symbols, SymbolKind.Field, module_identity, owner_key, definition.fields[field_index].name)
        field_symbol: Symbol{
            id: field_id,
            kind: SymbolKind.Field,
            name: definition.fields[field_index].name,
            module_identity: owner.module_identity,
            owner: Val(owner_key.copy()),
            span: definition.fields[field_index].name_span,
            ty: Val(definition.fields[field_index].ty),
            visibility: sema_registration_visibility(definition.fields[field_index].is_pub, definition.fields[field_index].is_package_pub),
        }
        fields.push(
            SemaRegistrationField{
                symbol: field_symbol,
                ty: definition.fields[field_index].ty,
                default: definition.fields[field_index].default,
                computed: definition.fields[field_index].computed != None,
            },
        )
    }
    fields
}

sema_registration_enum_variants: fn(definition: EnumDef, module_identity: String, owner: Symbol, symbols: ^SymbolTable, diagnostics: ^[Diagnostic]) -> [SemaRegistrationVariant] {
    owner_key: symbol_table_key(symbols, owner.id)
    variants := [SemaRegistrationVariant]{}
    seen := name_table_sized(definition.variants.len() + 1)
    loop variant_index in 0..<definition.variants.len() {
        known: name_count(seen)
        duplicate: name_index(name_intern(seen, definition.variants[variant_index].name)) < known
        if duplicate {
            diagnostics.push(sema_defined_twice(definition.variants[variant_index].name, "variants in one enum declaration share one namespace", definition.variants[variant_index].name_span))
        }
        payload_ty: sema_registration_variant_type(definition.variants[variant_index].payload)
        variant_symbol: Symbol{
            id: symbol_mint(symbols, SymbolKind.Variant, module_identity, owner_key, definition.variants[variant_index].name),
            kind: SymbolKind.Variant,
            name: definition.variants[variant_index].name,
            module_identity: owner.module_identity,
            owner: Val(owner_key.copy()),
            span: definition.variants[variant_index].name_span,
            ty: payload_ty,
            visibility: owner.visibility,
        }
        variants.push(
            SemaRegistrationVariant{
                symbol: variant_symbol,
                payload: definition.variants[variant_index].payload,
                payload_type: payload_ty,
            },
        )
    }
    variants
}

sema_registration_trait_method_signature: fn(method: TraitMethodSig, raw_protocol_return: Bool, owner_key: String, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> Type {
    params := [Type]{}
    names := [String]{}
    defaults := [FunctionDefaultRef?]{}
    variadic := [Bool]{}
    conventions := [AccessConvention]{}
    contract := [CallContractRow]{}
    has_contract := false
    loop (index, parameter) in method.params {
        ty: type_with_effective_parameter_fn_return(parameter.ty)
        if parameter.variadic -> params.push(Type.List{element: ty}) else -> params.push(ty)
        names.push(parameter.name)
        variadic.push(parameter.variadic)
        conventions.push(parameter.convention)
        label: if {
            parameter.zone == ParamZone.PositionalOnly -> ""
            parameter.zone == ParamZone.Either && parameter.public_label == None -> ""
            else -> parameter.public_label.map(fn(public_label) { public_label.name }) ?? parameter.name
        }
        contract.push(CallContractRow{label: label, zone: parameter.zone})
        if label != "" || parameter.zone != ParamZone.Either -> has_contract = true
        if parameter.default == {
            .Val(expression) -> {
                defaults.push(Val(FunctionDefaultRef{source_file: sema_source_file_at(source_segments, fallback_source_file, fallback_source_origin, expr_span(expression)), owner_key: owner_key, parameter_index: index, span: expr_span(expression)}))
            }
            .None -> defaults.push(None)
        }
    }
    return_type: sema_checked_return_type(method.return_type, raw_protocol_return)
    effect_bound: if {
        method.declared_effects != None -> method.declared_effects
        method.is_pure -> Val([EffectRowEntry]{})
        else -> None
    }
    param_contract: if has_contract -> Val(contract) else -> None
    metadata: Val(FunctionCallMetadata{names: names, defaults: defaults, variadic: variadic, conventions: conventions, policies: CallablePolicyChain{policies: [CallablePolicy]{}}})
    Type.Fn{params: params, ret: Val(return_type), effect_bound: effect_bound, param_contract: param_contract, call_metadata: metadata, return_view_provenance: sema_signature_view_provenance(method.return_view_provenance, method.declared_return_view_provenance, method.return_type)}
}

sema_registration_trait_method: fn(method: TraitMethodSig, module_identity: String, module_name: String, owner: Symbol, symbols: ^SymbolTable, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> SemaRegistrationTraitMethod {
    // An owned trait's declaration holds the trait's builtin id
    // (sema_registration_trait_symbol), outside the module's own range, which
    // is all a prepared module's table holds; its key is the builtin one.
    owner_key: if symbol_builtin_declared(SymbolKind.Trait, module_name, owner.name) != None -> symbol_key_text(SymbolKind.Trait, module_name, "", owner.name) else -> symbol_table_key(symbols, owner.id)
    id: symbol_mint(symbols, SymbolKind.Function, module_identity, owner_key, method.name)
    key: symbol_table_key(symbols, id)
    // A protocol ABI trait's own method signature is raw at dispatch, for
    // trait-bound and trait-object method calls alike.
    signature: sema_registration_trait_method_signature(method, sema_raw_protocol_trait(Val(owner.name)), key, fallback_source_file, fallback_source_origin, source_segments)
    parameters := [SemaRegistrationParameter]{}
    metadata: sema_registration_signature_metadata(signature) ?? FunctionCallMetadata{names: [String]{}, defaults: [FunctionDefaultRef?]{}, variadic: [Bool]{}, conventions: [AccessConvention]{}, policies: CallablePolicyChain{policies: [CallablePolicy]{}}}
    loop (index, parameter) in method.params {
        ty: type_with_effective_parameter_fn_return(parameter.ty)
        parameter_ty: if parameter.variadic -> Type.List{element: ty} else -> ty
        default_ref: if index < metadata.defaults.len() -> metadata.defaults[index] else -> None
        parameters.push(
            SemaRegistrationParameter{
                index: index,
                name: parameter.name,
                span: parameter.name_span,
                ty: parameter_ty,
                convention: parameter.convention,
                zone: parameter.zone,
                public_label: sema_registration_parameter_label(parameter),
                variadic: parameter.variadic,
                default: parameter.default,
                default_ref: default_ref,
            },
        )
    }
    symbol: Symbol{id: id, kind: SymbolKind.Function, name: method.name, module_identity: owner.module_identity, owner: Val(owner_key), span: method.name_span, ty: Val(signature), visibility: owner.visibility}
    SemaRegistrationTraitMethod{symbol: symbol, declaration: method, signature: signature, parameters: parameters}
}

// Hook callable identity is the operand pair, not the ordinary owner/name
// key, and a conversion's is its target and source (`impl Celsius.From(Float)`
// and `impl Celsius.From(Int)` each declare a `from`).
sema_registration_operator_owner: fn(owner: SymbolID, symbols: ^SymbolTable, module_identity: String, left: Type, trait_name: String?, rhs: Type?) -> SymbolID Never! {
    trait_value: trait_name ?? return owner.copy()
    if !owned_trait_keyed_by_argument(trait_value) -> return owner.copy()
    right: rhs ?? left
    owner_key: symbol_table_key(symbols, owner)
    symbol_mint(symbols, SymbolKind.Impl, module_identity, owner_key, "{type_name(left)}.{trait_value}<{type_name(right)}>")
}

// Whether the struct or enum `item` writes an `impl` block of `trait_name`
// in its body; the blocks are read in place, not copied.
sema_registration_item_has_trait_block: fn(item: Item, trait_name: String) -> Bool Never! {
    if item == {
        .Struct(definition) -> return definition.trait_impls.any(fn(block) { block.trait_name == trait_name })
        .Enum(definition) -> return definition.trait_impls.any(fn(block) { block.trait_name == trait_name })
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    false
}

// The `impl Trait { … }` blocks a struct or enum writes in its body.
sema_registration_item_trait_blocks: fn(item: Item) -> [TraitImplBlock] Never! {
    if item == {
        .Struct(definition) -> return definition.trait_impls
        .Enum(definition) -> return definition.trait_impls
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    [TraitImplBlock]{}
}

// `module_id` is the declaring module, `module_identity` its identity text,
// which the nominal's symbol keys spell, and `module_name` its module name.
sema_registration_nominal: fn(item: Item, module_id: ModuleID, module_identity: String, module_name: String, symbols: ^SymbolTable, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment], diagnostics: ^[Diagnostic], item_index: Int{-1}) -> SemaRegistrationNominal? {
    if item == {
        .Struct(definition) -> {
            ty: sema_registration_nominal_type(definition.name, definition.type_params)
            symbol: sema_registration_named_symbol(module_id, module_identity, symbols, definition.name, definition.name_span, SymbolKind.Type, Val(ty), definition.is_pub, definition.is_package_pub)
            key: symbol_table_key(symbols, symbol.id)
            generic_params: sema_registration_generic_params(definition.type_params, key, module_id, diagnostics)
            methods := [SemaRegistrationFunction]{}
            loop method_index in 0..<definition.methods.len() {
                methods.push(sema_registration_function(definition.methods[method_index], false, module_id, module_identity, Val(symbol.id), symbols, fallback_source_file, fallback_source_origin, source_segments, diagnostics, item_index < 0, item_index, method_index, -1))
            }
            trait_methods: [SemaRegistrationTraitMethod]{}
            loop block_index in 0..<definition.trait_impls.len() {
                block: definition.trait_impls[block_index]
                loop method_index in 0..<block.methods.len() {
                    method: block.methods[method_index]
                    hook_owner: sema_registration_operator_owner(symbol.id, symbols, module_identity, ty, Val(block.trait_name), block.operator_rhs)
                    methods.push(sema_registration_function(method, sema_raw_protocol_function_return(Val(block.trait_name), block.compiler_generated, method), module_id, module_identity, Val(hook_owner), symbols, fallback_source_file, fallback_source_origin, source_segments, diagnostics, item_index < 0, item_index, method_index, block_index))
                }
            }
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.Struct, source: SemaRegistrationNominalSource.SourceAST{value: Item.Struct{value: sema_registration_struct_header(definition)}}, ty: ty, identity_key: sema_registration_identity_key(module_identity, ty), generic_params: generic_params, fields: sema_registration_struct_fields(definition, module_identity, symbol, symbols, diagnostics), variants: [SemaRegistrationVariant]{}, methods: methods, trait_methods: trait_methods, compiler_owned: definition.compiler_builtin_error, generated_provenance: if definition.compiler_builtin_error -> Val(sema_registration_compiler_owned_default_err_provenance()) else -> None})
        }
        .Enum(definition) -> {
            ty: sema_registration_nominal_type(definition.name, definition.type_params)
            symbol: sema_registration_named_symbol(module_id, module_identity, symbols, definition.name, definition.name_span, SymbolKind.Type, Val(ty), definition.is_pub, definition.is_package_pub)
            key: symbol_table_key(symbols, symbol.id)
            generic_params: sema_registration_generic_params(definition.type_params, key, module_id, diagnostics)
            methods := [SemaRegistrationFunction]{}
            loop method_index in 0..<definition.methods.len() {
                methods.push(sema_registration_function(definition.methods[method_index], false, module_id, module_identity, Val(symbol.id), symbols, fallback_source_file, fallback_source_origin, source_segments, diagnostics, item_index < 0, item_index, method_index, -1))
            }
            trait_methods: [SemaRegistrationTraitMethod]{}
            loop block_index in 0..<definition.trait_impls.len() {
                block: definition.trait_impls[block_index]
                loop method_index in 0..<block.methods.len() {
                    method: block.methods[method_index]
                    hook_owner: sema_registration_operator_owner(symbol.id, symbols, module_identity, ty, Val(block.trait_name), block.operator_rhs)
                    methods.push(sema_registration_function(method, sema_raw_protocol_function_return(Val(block.trait_name), block.compiler_generated, method), module_id, module_identity, Val(hook_owner), symbols, fallback_source_file, fallback_source_origin, source_segments, diagnostics, item_index < 0, item_index, method_index, block_index))
                }
            }
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.Enum, source: SemaRegistrationNominalSource.SourceAST{value: Item.Enum{value: sema_registration_enum_header(definition)}}, ty: ty, identity_key: sema_registration_identity_key(module_identity, ty), generic_params: generic_params, fields: [SemaRegistrationField]{}, variants: sema_registration_enum_variants(definition, module_identity, symbol, symbols, diagnostics), methods: methods, trait_methods: trait_methods, compiler_owned: false, generated_provenance: None, is_open: sema_registration_has_open_marker(definition.type_markers)})
        }
        .Distinct(definition) -> {
            ty: Type.Named{name: definition.name}
            symbol: sema_registration_named_symbol(module_id, module_identity, symbols, definition.name, definition.name_span, SymbolKind.Type, Val(ty), definition.is_pub, definition.is_package_pub)
            generic_params: [SemaRegistrationGenericParam]{}
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.Distinct, source: SemaRegistrationNominalSource.SourceAST{value: item}, ty: ty, identity_key: sema_registration_identity_key(module_identity, ty), generic_params: generic_params, fields: [SemaRegistrationField]{}, variants: [SemaRegistrationVariant]{}, methods: [SemaRegistrationFunction]{}, trait_methods: [SemaRegistrationTraitMethod]{}, compiler_owned: false, generated_provenance: None})
        }
        .TypeAlias(definition) -> {
            ty: sema_registration_nominal_type(definition.name, definition.type_params)
            symbol: sema_registration_named_symbol(module_id, module_identity, symbols, definition.name, definition.name_span, SymbolKind.Type, Val(ty), definition.is_pub, definition.is_package_pub)
            key: symbol_table_key(symbols, symbol.id)
            generic_params: sema_registration_generic_params(definition.type_params, key, module_id, diagnostics)
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.TypeAlias, source: SemaRegistrationNominalSource.SourceAST{value: item}, ty: ty, identity_key: sema_registration_identity_key(module_identity, ty), generic_params: generic_params, fields: [SemaRegistrationField]{}, variants: [SemaRegistrationVariant]{}, methods: [SemaRegistrationFunction]{}, trait_methods: [SemaRegistrationTraitMethod]{}, compiler_owned: false, generated_provenance: None})
        }
        .Trait(definition) -> {
            ty: Type.Named{name: definition.name}
            symbol: sema_registration_trait_symbol(module_id, module_identity, module_name, symbols, definition.name, definition.name_span, sema_registration_item_visibility(module_id, definition.name, definition.is_pub, definition.is_package_pub))
            trait_methods: loop method in definition.methods -> sema_registration_trait_method(method, module_identity, module_name, symbol, symbols, fallback_source_file, fallback_source_origin, source_segments)
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.Trait, source: SemaRegistrationNominalSource.SourceAST{value: item}, ty: ty, identity_key: sema_registration_identity_key(module_identity, ty), generic_params: [SemaRegistrationGenericParam]{}, fields: [SemaRegistrationField]{}, variants: [SemaRegistrationVariant]{}, methods: [SemaRegistrationFunction]{}, trait_methods: trait_methods, compiler_owned: false, generated_provenance: None})
        }
        .Tag(definition) -> {
            ty: Type.Named{name: definition.name}
            symbol: sema_registration_named_symbol(module_id, module_identity, symbols, definition.name, definition.name_span, SymbolKind.Type, Val(ty), definition.is_pub, definition.is_package_pub)
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.Tag, source: SemaRegistrationNominalSource.SourceAST{value: item}, ty: ty, identity_key: sema_registration_identity_key(module_identity, ty), generic_params: [SemaRegistrationGenericParam]{}, fields: [SemaRegistrationField]{}, variants: [SemaRegistrationVariant]{}, methods: [SemaRegistrationFunction]{}, trait_methods: [SemaRegistrationTraitMethod]{}, compiler_owned: false, generated_provenance: None})
        }
        .UnitFamily(definition) -> {
            ty: Type.Named{name: definition.family}
            symbol: sema_registration_named_symbol(module_id, module_identity, symbols, definition.family, definition.family_span, SymbolKind.Type, Val(ty), definition.is_pub, definition.is_package_pub)
            Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.UnitFamily, source: SemaRegistrationNominalSource.SourceAST{value: item}, ty: ty, identity_key: sema_registration_identity_key(module_identity, ty), generic_params: [SemaRegistrationGenericParam]{}, fields: [SemaRegistrationField]{}, variants: [SemaRegistrationVariant]{}, methods: [SemaRegistrationFunction]{}, trait_methods: [SemaRegistrationTraitMethod]{}, compiler_owned: false, generated_provenance: None})
        }
        .Func(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}

// Why a Prelude text the compiler carries does not read: `file` is its
// path and `line` the line of its first problem, None when the problem is
// the text as a whole. Its readers run only in Compiler/Toolchain/PreludeRows
// and JetParser Tests/PreludeBuildRows.jet, which report it and fail.
#Error
SemaPreludeTextError: struct {
    file: String,
    line: Int?,
    message: String,
}

// The first of `diagnostics`, from parsing the Prelude text `source` at
// `file`, as that text's error at its line.
sema_prelude_text_error: fn(file: String, source: String, diagnostics: [Diagnostic]) -> SemaPreludeTextError Never! {
    first: diagnostics[0]
    message: "does not parse: {first.what}"
    at: first.span ?? return SemaPreludeTextError{file: file, line: None, message: message}
    bytes: source.bytes()
    end: if at.start < bytes.len() -> at.start else -> bytes.len()
    line := 1
    loop byte in bytes[0..<end] {
        if byte == 10 -> line += 1
    }
    SemaPreludeTextError{file: file, line: Val(line), message: message}
}

// The byte offset of each line of SEMA_PRELUDE_ERROR_SOURCE.
SEMA_PRELUDE_ERROR_LINE_STARTS: #run parser_line_starts(SEMA_PRELUDE_ERROR_SOURCE.bytes())

// The original Prelude error declarations: only this embedded original parse
// can mint the DefaultErr marker. SEMA_PRELUDE_ERROR_PROGRAM (PreludeRows.jet)
// is what this returns, written by Compiler/Toolchain/PreludeRows, so neither
// a compile nor the compiler's build parses the error text; a text that does
// not parse, or that does not hold seven declarations with exactly one marked
// default error, is that tool's error.
sema_registration_original_error_program: fn() -> Program SemaPreludeTextError! {
    parsed := parse_generated_source(SEMA_PRELUDE_ERROR_SOURCE.bytes())
    if parsed.diagnostics.len() > 0 {
        return Err(sema_prelude_text_error("Prelude/Errors.jet", SEMA_PRELUDE_ERROR_SOURCE, parsed.diagnostics))
    }
    program := parsed.program.move()
    declarations := [Item]{}
    marked := 0
    loop {
        item := program.items.pop() ?? break
        if item.move() == .Struct(source_definition) {
            definition := source_definition.move()
            if definition.name == "Err" {
                definition.compiler_builtin_error = true
                marked += 1
            }
            declarations.push(Item.Struct{value: definition.move()})
        }
    }
    if declarations.len() != 7 || marked != 1 {
        return Err(SemaPreludeTextError{file: "Prelude/Errors.jet", line: None, message: "must hold seven declarations and exactly one marked default error, `Err`"})
    }
    declarations.reverse()
    program.items = declarations.move()
    Ok(program)
}

sema_registration_original_error_module: fn(module_table: ^ModuleTable) -> SemaRegistrationModuleInput {
    path: SEMA_PRELUDE_ERROR_SOURCE_PATH
    SemaRegistrationModuleInput{
        package_identity: "jet:canonical-prelude",
        module_identity: module_intern(module_table, path),
        module_name: sema_inline_generated_path(path),
        core_source_alias: "",
        module_path: "Prelude/Errors.jet",
        source_file: path,
        source_segments: [SemaSourceSegment]{SemaSourceSegment{generated: Span{start: 0, end: SEMA_PRELUDE_ERROR_SOURCE.count_bytes()}, source_file: path, source_start: 0, line_starts: SEMA_PRELUDE_ERROR_LINE_STARTS, origin: SemaSourceOrigin.CompilerGenerated}},
        source_origin: SemaSourceOrigin.CompilerGenerated,
        program: SEMA_PRELUDE_ERROR_PROGRAM,
        foreign_handles: [SemaRegistrationForeignHandleFacts]{},
        source: SEMA_PRELUDE_ERROR_SOURCE,
    }
}

// The byte offset of each line of SEMA_PRELUDE_RULE_SOURCE.
SEMA_PRELUDE_RULE_LINE_STARTS: #run parser_line_starts(SEMA_PRELUDE_RULE_SOURCE.bytes())

// The Prelude rule module's declarations (Prelude/Rules.jet: the `check`
// rules of the contract markers). SEMA_PRELUDE_RULE_PROGRAM (PreludeRows.jet)
// is what this returns, written by Compiler/Toolchain/PreludeRows, so neither
// a compile nor the compiler's build parses the rule text; a text that does
// not parse is that tool's error.
sema_registration_rule_program: fn() -> Program SemaPreludeTextError! {
    parsed: parse_generated_source(SEMA_PRELUDE_RULE_SOURCE.bytes())
    if parsed.diagnostics.len() > 0 {
        return Err(sema_prelude_text_error("Prelude/Rules.jet", SEMA_PRELUDE_RULE_SOURCE, parsed.diagnostics))
    }
    Ok(parsed.program.move())
}

// The Prelude rule module as one compiler-generated source module of the
// canonical Prelude package, which the driver loads into a program that
// declares a `#run { … }` contract clause (JetDriver
// jet_driver_retain_prelude_modules); its rules hear the calls whose clause
// fails (Contracts.jet sema_contract_rule).
sema_registration_rule_module: fn(module_table: ^ModuleTable) -> SemaRegistrationModuleInput {
    path: SEMA_PRELUDE_RULE_SOURCE_PATH
    SemaRegistrationModuleInput{
        package_identity: "jet:canonical-prelude",
        module_identity: module_intern(module_table, path),
        module_name: sema_inline_generated_path(path),
        core_source_alias: "",
        module_path: "Prelude/Rules.jet",
        source_file: path,
        source_segments: [SemaSourceSegment]{SemaSourceSegment{generated: Span{start: 0, end: SEMA_PRELUDE_RULE_SOURCE.count_bytes()}, source_file: path, source_start: 0, line_starts: SEMA_PRELUDE_RULE_LINE_STARTS, origin: SemaSourceOrigin.CompilerGenerated}},
        source_origin: SemaSourceOrigin.CompilerGenerated,
        program: SEMA_PRELUDE_RULE_PROGRAM,
        foreign_handles: [SemaRegistrationForeignHandleFacts]{},
        source: SEMA_PRELUDE_RULE_SOURCE,
    }
}

// A graph whose inputs already retain the original error module (the driver
// loads it as a source module) keeps that one owner after checking its source
// context; otherwise the original module is appended once. An input holding the
// original path or alias without the parsed provenance is refused rather than
// trusted.
sema_registration_retain_original_error_module: fn(inputs: ^[SemaRegistrationModuleInput], module_table: ^ModuleTable, diagnostics: ^[Diagnostic]) {
    path: SEMA_PRELUDE_ERROR_SOURCE_PATH
    alias: sema_inline_generated_path(path)
    owners := 0
    loop input in inputs {
        retained := false
        loop item in input.program.items {
            if item == .Struct(definition) && definition.compiler_builtin_error -> retained = true
        }
        if !retained -> next
        owners += 1
        if owners > 1 {
            diagnostics.push(sema_registration_error_supplier_diagnostic("original Prelude declarations have multiple owners"))
            return
        }
        if input.source_file != path || input.package_identity != JET_CANONICAL_EFFECT_PACKAGE_IDENTITY || input.source != SEMA_PRELUDE_ERROR_SOURCE || input.module_name != alias {
            diagnostics.push(sema_registration_error_supplier_diagnostic("original Prelude provenance lost its source context"))
            return
        }
    }
    if owners == 1 {
        return
    }
    loop input in inputs {
        if input.source_file == path || module_text(module_table, input.module_identity) == path || input.module_name == alias {
            diagnostics.push(sema_registration_error_supplier_diagnostic("an existing source collides with the original Prelude identity"))
            return
        }
    }
    inputs.push(sema_registration_original_error_module(module_table))
}

sema_registration_error_supplier_diagnostic: fn(detail: String) -> Diagnostic {
    sema_error_optional("E0003", None, detail, "default-error declarations retain their original compiler-private source owner", "retain the canonical Prelude source and its parsed declaration provenance")
}

// The row a codec trait (Encode, Decode) resolves to by name in a module
// that declares none (sema_registration_lookup_name_hashed): the owned trait,
// under its builtin id, which core.encoding's declaration takes too.
sema_registration_compiler_owned_codec_trait: fn(module_id: ModuleID, module_identity: String, reference: TraitRef) -> SemaRegistrationNominal {
    span: Span{start: 0, end: 0}
    ty: Type.Named{name: reference.name}
    symbol: Symbol{
        id: symbol_builtin(SymbolKind.Trait, reference.name) ?? panic("the codec trait `{reference.name}` is not an owned trait"),
        kind: SymbolKind.Trait,
        name: reference.name,
        module_identity: module_id,
        owner: None,
        span: span,
        ty: None,
        visibility: sema_registration_visibility(true, false),
    }
    SemaRegistrationNominal{
        symbol: symbol,
        kind: SemaRegistrationNominalKind.Trait,
        source: SemaRegistrationNominalSource.CompilerBuiltinTrait{value: reference},
        ty: ty,
        identity_key: sema_registration_identity_key(module_identity, ty),
        generic_params: [SemaRegistrationGenericParam]{},
        fields: [SemaRegistrationField]{},
        variants: [SemaRegistrationVariant]{},
        methods: [SemaRegistrationFunction]{},
        trait_methods: [SemaRegistrationTraitMethod]{},
        compiler_owned: true,
        generated_provenance: None,
    }
}

// Compiler-owned enum rows keep their bare canonical identity across modules.
// Runtime enums (`Ordering`, `RemoveBy`, `TaskPauseMode`) and artifact-declared
// reflection enums share this checked nominal path; runtime ownership is
// decided independently by the emitter's native carrier registry.
sema_registration_is_compiler_owned_enum: fn(nominal: SemaRegistrationNominal) -> Bool Never! {
    nominal.compiler_owned && nominal.generated_provenance == (Val(sema_registration_compiler_owned_enum_provenance()))
}

// Canonical unit menus come from the runtime or reflection sema oracle.
sema_registration_compiler_owned_enum_variants: fn(name: String) -> [Variant]? {
    span: Span{start: 0, end: 0}
    names: sema_compiler_enum_variants(name) ?? sema_fact_enum_variants(name) ?? return None
    if names.len() == 0 -> return None
    variants: loop variant_name in names -> Variant{name: variant_name, name_span: span, payload: VariantPayload.Unit, discriminant: None, discriminant_expr: None, serde_markers: [Marker]{}}
    Val(variants)
}

sema_registration_compiler_owned_enum: fn(module_id: ModuleID, module_identity: String, symbols: ^SymbolTable, name: String, variants: [Variant]) -> SemaRegistrationNominal {
    span: Span{start: 0, end: 0}
    definition: EnumDef{
        span: span,
        is_pub: true,
        is_package_pub: false,
        name: name,
        name_span: span,
        type_params: [TypeParam]{},
        variants: variants,
        methods: [Func]{},
        trait_impls: [TraitImplBlock]{},
        derives: [NamedSpan]{},
        auto_derive_default: false,
        is_single_use: false,
        single_use_span: None,
        is_must_use: false,
        must_use_span: None,
        serde_markers: [Marker]{},
        type_markers: [Marker]{},
        groups: [EnumGroup]{},
    }
    ty: Type.Named{name: name}
    symbol: sema_registration_named_symbol(module_id, module_identity, symbols, name, span, SymbolKind.Type, Val(ty), true, false)
    diagnostics := [Diagnostic]{}
    SemaRegistrationNominal{
        symbol: symbol,
        kind: SemaRegistrationNominalKind.Enum,
        source: SemaRegistrationNominalSource.SourceAST{value: Item.Enum{value: definition}},
        ty: ty,
        identity_key: sema_registration_identity_key(module_identity, ty),
        generic_params: [SemaRegistrationGenericParam]{},
        fields: [SemaRegistrationField]{},
        variants: sema_registration_enum_variants(definition, module_identity, symbol, symbols, diagnostics),
        methods: [SemaRegistrationFunction]{},
        trait_methods: [SemaRegistrationTraitMethod]{},
        compiler_owned: true,
        generated_provenance: Val(sema_registration_compiler_owned_enum_provenance()),
    }
}

sema_registration_foreign_handle_nominal: fn(facts: SemaRegistrationForeignHandleFacts, module_id: ModuleID, module_identity: String, symbols: ^SymbolTable, diagnostics: ^[Diagnostic]) -> SemaRegistrationNominal? {
    if facts.library == "" || facts.typedef_name == "" || facts.jet_name == "" || facts.ownership == "" || facts.close == "" || (facts.close_source != "conventional" && facts.close_source != "overlay") || (facts.thread_safety != "unspecified" && facts.thread_safety != "safe" && facts.thread_safety != "unsafe") {
        diagnostics.push(sema_error("E3216", facts.source_span, "foreign handle registration facts are incomplete", "an opaque native handle needs its library, typedef, Jet identity, ownership, close provenance, and thread-safety facts before type checking", "retain the complete approved C binding metadata"))
        return None
    }
    ty: Type.Named{name: facts.jet_name}
    symbol: sema_registration_named_symbol(module_id, module_identity, symbols, facts.jet_name, facts.source_span, SymbolKind.Type, Val(ty), true, false)
    Val(SemaRegistrationNominal{symbol: symbol, kind: SemaRegistrationNominalKind.ForeignHandle, source: SemaRegistrationNominalSource.ForeignHandle{value: facts}, ty: ty, identity_key: sema_registration_identity_key(module_identity, ty), generic_params: [SemaRegistrationGenericParam]{}, fields: [SemaRegistrationField]{}, variants: [SemaRegistrationVariant]{}, methods: [SemaRegistrationFunction]{}, trait_methods: [SemaRegistrationTraitMethod]{}, compiler_owned: false, generated_provenance: None})
}

sema_registration_nominal_source_item: fn(source: SemaRegistrationNominalSource) -> Item? {
    if source == {
        // copy: `value` is a payload of read parameter `source`, which keeps the original; the Val carrier owns this one
        .SourceAST(value) -> Val(value.copy())
        .ForeignHandle(_) | .CompilerBuiltinTrait(_) -> None
    }
}

sema_registration_root_name: fn(item: Item) -> String Never! {
    if item == {
        .Func(value) -> value.name
        .Struct(value) -> value.name
        .Enum(value) -> value.name
        .Distinct(value) -> value.name
        .TypeAlias(value) -> value.name
        .Trait(value) -> value.name
        .Tag(value) -> value.name
        .UnitFamily(value) -> value.family
        .Const(value) -> value.name
        .Module(value) -> value.name
        .CodeModule(value) -> value.name
        .GenericModule(value) -> value.name
        .ModuleAlias(value) -> value.name
        .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .MarkerDecl(_) | .FactDecl(_) -> ""
    }
}

sema_registration_root_span: fn(item: Item) -> Span Never! {
    if item == {
        .Func(value) -> value.name_span
        .Struct(value) -> value.name_span
        .Enum(value) -> value.name_span
        .Distinct(value) -> value.name_span
        .TypeAlias(value) -> value.name_span
        .Trait(value) -> value.name_span
        .Tag(value) -> value.name_span
        .UnitFamily(value) -> value.family_span
        .Const(value) -> value.name_span
        .Module(value) -> value.name_span
        .CodeModule(value) -> value.name_span
        .GenericModule(value) -> value.name_span
        .ModuleAlias(value) -> value.name_span
        .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .MarkerDecl(_) | .FactDecl(_) -> Span{start: 0, end: 0}
    }
}

sema_registration_root_symbol: fn(item: Item, module_id: ModuleID, module_identity: String, module_name: String, symbols: ^SymbolTable, source_file: String, source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment], diagnostics: ^[Diagnostic]) -> Symbol? {
    if item == {
        // sema_registration_add_root registers a function through sema_registration_function.
        .Func(_) -> None
        .Struct(value) -> Val(sema_registration_named_symbol(module_id, module_identity, symbols, value.name, value.name_span, SymbolKind.Type, Val(sema_registration_nominal_type(value.name, value.type_params)), value.is_pub, value.is_package_pub))
        .Enum(value) -> Val(sema_registration_named_symbol(module_id, module_identity, symbols, value.name, value.name_span, SymbolKind.Type, Val(sema_registration_nominal_type(value.name, value.type_params)), value.is_pub, value.is_package_pub))
        .Distinct(value) -> Val(sema_registration_named_symbol(module_id, module_identity, symbols, value.name, value.name_span, SymbolKind.Type, Val(Type.Named{name: value.name}), value.is_pub, value.is_package_pub))
        .TypeAlias(value) -> Val(sema_registration_named_symbol(module_id, module_identity, symbols, value.name, value.name_span, SymbolKind.Type, Val(sema_registration_nominal_type(value.name, value.type_params)), value.is_pub, value.is_package_pub))
        .Trait(value) -> Val(sema_registration_trait_symbol(module_id, module_identity, module_name, symbols, value.name, value.name_span, sema_registration_item_visibility(module_id, value.name, value.is_pub, value.is_package_pub)))
        .Tag(value) -> Val(sema_registration_named_symbol(module_id, module_identity, symbols, value.name, value.name_span, SymbolKind.Type, Val(Type.Named{name: value.name}), value.is_pub, value.is_package_pub))
        .UnitFamily(value) -> Val(sema_registration_named_symbol(module_id, module_identity, symbols, value.family, value.family_span, SymbolKind.Type, Val(Type.Named{name: value.family}), value.is_pub, value.is_package_pub))
        .Const(value) -> Val(sema_registration_named_symbol(module_id, module_identity, symbols, value.name, value.name_span, SymbolKind.Constant, value.ty, value.is_pub, value.is_package_pub))
        .Module(value) -> Val(sema_registration_named_symbol(module_id, module_identity, symbols, value.name, value.name_span, SymbolKind.Module, None, false, false))
        .CodeModule(value) -> Val(sema_registration_named_symbol(module_id, module_identity, symbols, value.name, value.name_span, SymbolKind.Module, None, value.is_pub, value.is_package_pub))
        .GenericModule(value) -> Val(sema_registration_named_symbol(module_id, module_identity, symbols, value.name, value.name_span, SymbolKind.Module, None, value.is_pub, value.is_package_pub))
        .ModuleAlias(value) -> Val(sema_registration_named_symbol(module_id, module_identity, symbols, value.name, value.name_span, SymbolKind.Module, None, value.is_pub, value.is_package_pub))
        .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}

sema_registration_module_has_name: fn(module_row: SemaRegistrationModule, name: String) -> Bool Never! {
    found: name_find(module_row.symbol_names, name) ?? return false
    id: name_index(found)
    id < module_row.symbol_rows.len() && module_row.symbol_rows[id] >= 0
}

sema_registration_module_has_import_name: fn(module_row: SemaRegistrationModule, name: String) -> Bool Never! {
    found: name_find(module_row.import_binding_names, name) ?? return false
    id: name_index(found)
    id < module_row.import_binding_values.len() && module_row.import_binding_values[id] >= 0
}

// A body-less `name: module` binds its file as a file import aliased `name`.
// When the same module also takes `name` from that file with a top-level
// re-export (`wrap: wrap.wrap`), that item owns the name: the file import binds
// nothing and exports nothing, and the file stays reachable only where a
// module is expected (a `use` root), which the loader resolves.
sema_registration_file_import_taken_over: fn(module_row: SemaRegistrationModule, import: SemaRegistrationImport) -> Bool Never! {
    listed := false
    if import.declaration.kind == .File(_, _) -> listed = true
    if !listed -> return false
    name: import.declaration.alias
    declared := false
    loop declaration in module_row.declarations {
        if declaration == .CodeModule(definition) && definition.name == name && definition.body == None {
            declared = true
        }
    }
    if !declared -> return false
    loop other in module_row.imports {
        if other.target_module_identity != import.target_module_identity -> next
        if other.declaration.kind == .Unqualified(_, _, items, _, _) {
            loop item in items {
                if sema_registration_import_local(item) == name -> return true
            }
        }
    }
    false
}

// Whether `module_row` lists the file module `name` and also takes the file's
// item `name` with a `use`, so `name` is that item and not the file (see
// sema_registration_file_import_taken_over).
sema_registration_file_name_taken_over: fn(module_row: SemaRegistrationModule, name: String) -> Bool Never! {
    loop import in module_row.imports {
        if import.declaration.alias == name && sema_registration_file_import_taken_over(module_row, import) {
            return true
        }
    }
    false
}

sema_registration_set_symbol_position: fn(module_row: ^SemaRegistrationModule, name: String, row: Int) Never! {
    id: name_index(name_intern(module_row.symbol_names, name))
    loop module_row.symbol_rows.len() <= id -> module_row.symbol_rows.push(-1)
    module_row.symbol_rows[id] = row
}

// The `symbols` row of `name` (whose name_text_hash is `hash`) in `module_row`.
sema_registration_symbol_position: fn(module_row: SemaRegistrationModule, name: String, hash: Int) -> Int? Never! {
    found: name_find_hashed(module_row.symbol_names, name, hash) ?? return None
    id: name_index(found)
    if id < module_row.symbol_rows.len() && module_row.symbol_rows[id] >= 0 -> return Val(module_row.symbol_rows[id])
    None
}

// The `declarations` row of the root named `name` in `module_row`.
sema_registration_declaration_row: fn(module_row: SemaRegistrationModule, name: String) -> Int? Never! {
    found: name_find(module_row.symbol_names, name) ?? return None
    id: name_index(found)
    if id < module_row.declaration_rows.len() && module_row.declaration_rows[id] >= 0 -> return Val(module_row.declaration_rows[id])
    None
}

// Unbinds a symbol name and its declaration (sema_graph_module_rollback).
sema_registration_forget_symbol_position: fn(module_row: ^SemaRegistrationModule, name: String) Never! {
    found: name_find(module_row.symbol_names, name) ?? return
    id: name_index(found)
    if id < module_row.symbol_rows.len() -> module_row.symbol_rows[id] = -1
    if id < module_row.declaration_rows.len() -> module_row.declaration_rows[id] = -1
}

// `import_binding_values` packs a binding reference as one row.
SEMA_IMPORT_BINDING_STRIDE: 4294967296

// The import binding `name` (whose name_text_hash is `hash`) binds in `module_row`.
sema_registration_import_binding_at: fn(module_row: SemaRegistrationModule, name: String, hash: Int) -> SemaRegistrationImportBindingRef? Never! {
    found: name_find_hashed(module_row.import_binding_names, name, hash) ?? return None
    id: name_index(found)
    if id >= module_row.import_binding_values.len() -> return None
    packed: module_row.import_binding_values[id]
    if packed < 0 -> return None
    Val(SemaRegistrationImportBindingRef{import_index: packed /% SEMA_IMPORT_BINDING_STRIDE, binding: packed % SEMA_IMPORT_BINDING_STRIDE})
}

sema_registration_import_binding_named: fn(module_row: SemaRegistrationModule, name: String) -> SemaRegistrationImportBindingRef? Never! {
    sema_registration_import_binding_at(module_row, name, name_text_hash(name))
}

// The E0105 for import `declaration` binding `local` a second time. A
// re-export (a public row; a `use` row is never public) of a name a `use` row
// already binds gets the fix that deletes the name from that row, since the
// re-export binds it in this module too.
sema_registration_import_twice: fn(module_row: SemaRegistrationModule, declaration: ImportDecl, local: String, span: Span) -[]> Diagnostic {
    if (declaration.is_pub || declaration.is_package_pub) && !sema_registration_module_has_name(module_row, local) {
        if sema_registration_import_binding_named(module_row, local) == .Val(earlier) {
            used: module_row.imports[earlier.import_index].declaration
            if !used.is_pub && !used.is_package_pub {
                return sema_error("E0105", span, "`{local}` is both imported and re-exported", "a `use` row binds `{local}` in this module, and the re-export binds it again", "delete `{local}` from the `use` line; the re-export already binds it here")
            }
        }
    }
    sema_defined_twice(local, "imported names share the module namespace", span)
}

sema_registration_push_import_binding: fn(graph: ^SemaRegistrationGraph, module_index: Int, import_index: Int, binding: ^^SemaRegistrationImportBinding) Never! {
    if !sema_registration_module_has_import_name(graph.modules[module_index], binding.local) {
        packed: import_index * SEMA_IMPORT_BINDING_STRIDE + graph.modules[module_index].imports[import_index].bindings.len()
        id: name_index(name_intern(graph.modules[module_index].import_binding_names, binding.local))
        loop graph.modules[module_index].import_binding_values.len() <= id -> graph.modules[module_index].import_binding_values.push(-1)
        graph.modules[module_index].import_binding_values[id] = packed
    }
    graph.modules[module_index].imports[import_index].bindings.push(binding.move())
}

sema_registration_add_foreign_functions: fn(module_row: ^SemaRegistrationModule, module_text: String, symbols: ^SymbolTable, functions: [ExternFn], owner: SemaRegistrationForeignOwner, foreign_library: String, foreign_library_span: Span, diagnostics: ^[Diagnostic]) -> Bool {
    complete := true
    loop function in functions {
        if sema_registration_module_has_name(module_row, function.name) {
            diagnostics.push(sema_defined_twice(function.name, "module declarations share one namespace", function.name_span))
            complete = false
            next
        }
        registered: sema_registration_foreign_function(function, module_row.module_identity, module_text, owner, symbols, foreign_library, foreign_library_span)
        sema_registration_set_symbol_position(module_row, registered.symbol.name, module_row.symbols.len())
        module_row.symbols.push(registered.symbol)
        module_row.symbol_nominal_rows.push(-1)
        module_row.foreign_functions.push(registered)
    }
    complete
}

// `module_text` is the row's identity text, which its symbol keys spell;
// `symbols` mints them.
sema_registration_add_root: fn(module_row: ^SemaRegistrationModule, module_text: String, symbols: ^SymbolTable, item: Item, source_file: String, source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment], diagnostics: ^[Diagnostic], item_index: Int{-1}) -> Bool {
    if item == {
        .ExternRust(block) -> {
            complete: sema_registration_add_foreign_functions(module_row, module_text, symbols, block.functions, SemaRegistrationForeignOwner.ExternRust, block.crate_spec, block.crate_span, diagnostics)
            sema_registration_push_declaration(module_row, item)
            return complete
        }
        .CModule(block) -> {
            complete: sema_registration_add_foreign_functions(module_row, module_text, symbols, block.functions, SemaRegistrationForeignOwner.CModule, block.lib, block.path_span, diagnostics)
            sema_registration_push_declaration(module_row, item)
            return complete
        }
        // A body-less `name: module` declares a file module the loader binds as
        // the synthetic file import aliased `name`; that import owns the name,
        // so the declaration adds no second symbol.
        .CodeModule(definition) -> {
            if definition.body == None {
                sema_registration_push_declaration(module_row, item)
                return true
            }
        }
        .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .Module(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    name: sema_registration_root_name(item)
    if name == "" -> return true
    if !sema_registration_reserved_type_rule(module_text, item, name, diagnostics) -> return false
    if sema_registration_module_has_name(module_row, name) {
        why: if item == .Func(_) -> "every function needs a unique name so calls aren't ambiguous" else -> "module declarations share one namespace"
        diagnostics.push(sema_defined_twice(name, why, sema_registration_root_span(item)))
        return false
    }
    if !sema_registration_value_type_rules(module_row, item, diagnostics) -> return false
    function: if item == {
        .Func(value) -> Val(sema_registration_function(value, false, module_row.module_identity, module_text, None, symbols, source_file, source_origin, source_segments, diagnostics, item_index < 0, item_index))
        .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
    symbol: if function == {
        Val(value) -> Symbol{id: value.symbol.id, kind: value.symbol.kind, name: value.symbol.name, module_identity: value.symbol.module_identity, owner: value.symbol.owner, span: value.symbol.span, ty: Val(value.signature), visibility: value.symbol.visibility}
        None -> sema_registration_root_symbol(item, module_row.module_identity, module_text, module_row.module_name, symbols, source_file, source_origin, source_segments, diagnostics) ?? return false
    }
    nominal: sema_registration_nominal(item, module_row.module_identity, module_text, module_row.module_name, symbols, source_file, source_origin, source_segments, diagnostics, item_index)
    sema_registration_set_symbol_position(module_row, name, module_row.symbols.len())
    declaration_id: name_index(name_find(module_row.symbol_names, name) ?? panic("a registered name lost its id"))
    loop module_row.declaration_rows.len() <= declaration_id -> module_row.declaration_rows.push(-1)
    module_row.declaration_rows[declaration_id] = module_row.declarations.len()
    module_row.symbols.push(symbol.copy())
    module_row.symbol_nominal_rows.push(if nominal != None -> module_row.nominals.len() else -> -1)
    sema_registration_push_declaration(module_row, item)
    if function == .Val(value) -> module_row.functions.push(value)
    if nominal == .Val(value) -> module_row.nominals.push(value)
    if item == {
        .Const(value) -> {
            if sema_ownership_is_static_root(value) {
                module_row.static_roots.push(SymbolID{id: symbol.id.id})
            }
            if value.is_persist -> module_row.persist_roots.push(SymbolID{id: symbol.id.id})
            module_row.constants.push(SemaRegistrationConstant{symbol: symbol, declaration: value, ty: value.ty, typed: value.ty != None})
        }
        // Each member type a unit family declared in this module mints
        // registers as its own distinct declaration, so `Usd.from_float(...)`
        // and `CelsiusPoint` resolve. The standard core.units families every
        // module sees keep their one canonical owner.
        .UnitFamily(family) -> {
            if family.resolved_owner == Val("core.units") -> return true
            loop definition in unit_family_distinct_defs(family) {
                _ := sema_registration_add_root(module_row, module_text, symbols, Item.Distinct{value: definition}, source_file, source_origin, source_segments, diagnostics)
            }
        }
        .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    true
}

sema_registration_push_declaration: fn(module_row: ^SemaRegistrationModule, item: Item) Never! {
    if item == .Impl(definition) {
        if definition.trait_name == .Val(trait_name) {
            _ := name_intern(module_row.declared_trait_impls, sema_type_metadata_impl_key(definition.type_name, trait_name))
        }
        if definition.is_generated_serde -> return
    }
    module_row.declarations.push(sema_registration_declared_item(item))
}

// The declaration registry's row for `item`. Its readers take names, spans
// and signatures, never a function body, so functions, impls, structs, enums,
// and tests are kept without bodies: the program items hold the only bodies.
sema_registration_declared_item: fn(item: Item) -> Item Never! {
    if item == {
        .Func(source) -> return Item.Func{value: sema_registration_func_header(source)}
        .Impl(source) -> return Item.Impl{value: sema_registration_impl_header(source)}
        .Struct(source) -> return Item.Struct{value: sema_registration_struct_header(source)}
        .Enum(source) -> return Item.Enum{value: sema_registration_enum_header(source)}
        .Test(source) -> return Item.Test{value: TestDef{
            span: source.span,
            name: source.name,
            name_expr: source.name_expr,
            faults_expr: source.faults_expr,
            faults: source.faults,
            expected_fail_expr: source.expected_fail_expr,
            expected_fail: source.expected_fail,
            marker_name_span: source.marker_name_span,
            name_prefix: source.name_prefix,
            name_span: source.name_span,
            params: source.params,
            fn_keyword_span: source.fn_keyword_span,
            body: [Stmt]{},
            pre: source.pre,
        }}
        .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    // copy: the declaration registry owns its row; the program keeps its own item.
    item.copy()
}

// E0106: a struct, enum, distinct type or type alias named like a built-in
// type is rejected before the declaration registers.
sema_registration_reserved_type_rule: fn(module_text: String, item: Item, name: String, diagnostics: ^[Diagnostic]) -> Bool {
    kind: if item == {
        .Struct(_) -> "struct"
        .Enum(_) -> "enum"
        .Distinct(_) -> "distinct type"
        .TypeAlias(_) -> "type alias"
        .Func(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> ""
    }
    if kind == "" || !sema_reserved_type_name(name) -> return true
    // `item` is the loaded declaration; canonical identity supplies the exact
    // source path and name from CORE_SOURCE_OWNED_TYPES, never the export superset.
    if core_source_owns_type("{module_text}.{name}") -> return true
    diagnostics.push(sema_error("E0106", sema_registration_root_span(item), "the name `{name}` is built in and can't be redefined", "`{name}` is provided by the language itself", "choose a different name for this {kind}"))
    false
}

// The registration rules of distinct types and type aliases. A distinct
// built on a distinct declared earlier (E0129) and an alias without type
// parameters over a plain type (E0324) are not registered. An alias without
// type parameters stands when it names a record type (`Bounds: {min: Int,
// max: Int}`) or one application of a generic type (`Ids: Set<Int>`,
// `Totals: [Int: Float]`, `Byte: Unsigned<8>`): it still only shortens a
// generic spelling. A range constraint on a base other than `Int` is
// reported and the type still registers.
sema_registration_value_type_rules: fn(module_row: SemaRegistrationModule, item: Item, diagnostics: ^[Diagnostic]) -> Bool {
    if item == {
        .Distinct(definition) -> {
            if definition.base == .Named(base_name) {
                loop nominal_index in 0..<module_row.nominals.len() {
                    if module_row.nominals[nominal_index].kind == SemaRegistrationNominalKind.Distinct && module_row.nominals[nominal_index].symbol.name == base_name {
                        diagnostics.push(sema_error("E0129", definition.base_span, "`{definition.name}` can't be built on `{base_name}` — `{base_name}` is itself a distinct type", "`distinct`-over-`distinct` chaining is not allowed in v1; `{base_name}` is already a distinct type", "use `{base_name}` directly, or build on the shared base type"))
                        return false
                    }
                }
            }
            if definition.range == .Val(range) {
                if definition.base != Type.Int {
                    diagnostics.push(sema_error("E0003", range.span, "a range constraint only works on `Int`, but `{definition.name}` is {sema_type_show(definition.base)}", "`distinct Base(lo..hi)` provably bounds a whole-number value", "use `distinct Int({range.lo}..{range.hi})`, or drop the range"))
                }
            }
        }
        .TypeAlias(definition) -> {
            if definition.type_params.len() == 0 && !(definition.target == .Named(_)) && !sema_registration_record_type(definition.target) && !sema_registration_generic_application(definition.target) {
                if sema_casing_alias_number_zero(definition) == .Val(zero) {
                    diagnostics.push(sema_casing_alias_number_diagnostic(definition, zero))
                    return false
                }
                diagnostics.push(sema_error("E0324", definition.name_span, "a type alias of a plain type needs type parameters — write `Name<T>: …`", "a transparent type alias is only for shortening generic spellings, so one without type parameters names a generic application such as `Set<Int>`", "for a distinct type name over a primitive, use `Name: distinct BaseType` instead"))
                return false
            }
        }
        .Func(_) | .Struct(_) | .Enum(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    true
}

// Whether `target` is a record type: a tuple type whose members all carry
// names. A record has no other name, so a plain alias may give it one.
sema_registration_record_type: fn(target: Type) -> Bool Never! {
    if target == .Tuple(fields) {
        if fields.len() == 0 -> return false
        loop field in fields {
            if field.name == "" -> return false
        }
        return true
    }
    false
}

// Whether `target` applies a generic type to its arguments: `Box<Int>`,
// `Set<Int>`, `Int?`, `T E!`, `[T]`, `[T#4]`, `[K: V]` or `@T`.
sema_registration_generic_application: fn(target: Type) -> Bool Never! {
    if target == {
        .Apply(_, args) -> args.len() > 0
        .Option(_) | .Result(_, _) | .Shared(_) | .List(_) | .FixedList(_, _) | .Map(_, _, _) -> true
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// Indexed reads keep each candidate row in place; a two-name walk over the
// rows copies the whole list on every lookup.
sema_registration_impl_nominal_index: fn(module_row: SemaRegistrationModule, type_name: String) -> Int Never! {
    loop index in 0..<module_row.nominals.len() {
        if module_row.nominals[index].symbol.name == type_name -> return index
    }
    -1
}

// The nominal rows an impl registration looks up, built once per module
// while its nominals are fixed: `nominals` is the first nominal row of each
// type name (sema_registration_impl_nominal_index's answer) and `traits`
// the first Trait-kind nominal row of each name.
SemaRegistrationImplRows: struct {
    nominal_names: NameTable,
    nominal_rows: [Int],
    trait_names: NameTable,
    trait_rows: [Int],
}

sema_registration_impl_rows: fn(module_row: SemaRegistrationModule) -> SemaRegistrationImplRows Never! {
    rows := SemaRegistrationImplRows{
        nominal_names: name_table_sized(module_row.nominals.len() * 2 + 2),
        nominal_rows: [Int]{-1},
        trait_names: name_table_sized(4),
        trait_rows: [Int]{-1},
    }
    loop index in 0..<module_row.nominals.len() {
        name: module_row.nominals[index].symbol.name
        if name_find(rows.nominal_names, name) == None {
            _: name_intern(rows.nominal_names, name)
            rows.nominal_rows.push(index)
        }
        if module_row.nominals[index].kind == SemaRegistrationNominalKind.Trait && name_find(rows.trait_names, name) == None {
            _: name_intern(rows.trait_names, name)
            rows.trait_rows.push(index)
        }
    }
    rows
}

sema_registration_impl_rows_nominal: fn(rows: SemaRegistrationImplRows, name: String) -> Int Never! {
    found: name_find(rows.nominal_names, name) ?? return -1
    rows.nominal_rows[name_index(found)]
}

sema_registration_impl_rows_trait: fn(rows: SemaRegistrationImplRows, name: String) -> Int Never! {
    found: name_find(rows.trait_names, name) ?? return -1
    rows.trait_rows[name_index(found)]
}

// `owner_row` declares the implemented type: the impl's own module, or
// the member file of its package that declares it.
// `owner_rows` indexes `owner_row`'s nominals and `trait_rows` the impl
// module's (sema_registration_impl_rows of each). `module_text` is
// `module_row`'s identity text, which the impl's symbol keys spell. A
// structural head (`impl [T].Trait`) targets its shape over its parameters.
sema_registration_impl: fn(module_row: SemaRegistrationModule, module_text: String, symbols: ^SymbolTable, definition: ImplDef, owner_row: SemaRegistrationModule, owner_rows: SemaRegistrationImplRows, trait_rows: SemaRegistrationImplRows, diagnostics: ^[Diagnostic], item_index: Int{-1}) -> SemaRegistrationImpl {
    nominal_index: sema_registration_impl_rows_nominal(owner_rows, definition.type_name)
    target_type := Type.Named{name: definition.type_name}
    target_identity_key := "{module_text}:{type_identity_key(target_type)}"
    target_module_identity := module_none()
    owner_id := symbol_none()
    if nominal_index >= 0 {
        target_type = owner_row.nominals[nominal_index].ty
        target_identity_key = owner_row.nominals[nominal_index].identity_key
        target_module_identity = owner_row.module_identity
        owner_id = owner_row.nominals[nominal_index].symbol.id
    } else if sema_registration_structural_head(definition.type_name) == .Val(head) {
        target_type = head
        target_identity_key = "{module_text}:{type_identity_key(target_type)}"
    } else {
        // An operator hook on a built-in scalar (`impl Int.Mul(Price)`)
        // receives that scalar as `self`.
        scalar: sema_registration_builtin_scalar(definition.type_name)
        if scalar == .Val(builtin_type) {
            target_type = builtin_type
            target_identity_key = "{module_text}:{type_identity_key(target_type)}"
        }
        if sema_registration_source_owns_impl(owner_row, definition.type_name) {
            target_module_identity = owner_row.module_identity
        }
    }
    trait_symbol := Symbol?{None}
    if definition.trait_name == .Val(trait_name) {
        candidate_index: sema_registration_impl_rows_trait(trait_rows, trait_name)
        if candidate_index >= 0 {
            trait_symbol = Val(module_row.nominals[candidate_index].symbol)
        }
    }
    trait_key: definition.trait_name ?? ""
    identity_key: "{module_text}:impl:{definition.type_name}:{trait_key}:{definition.span.start}:{definition.span.end}"
    impl_id: symbol_mint(symbols, SymbolKind.Impl, module_text, "", identity_key)
    if nominal_index < 0 -> owner_id = impl_id
    symbol: Symbol{id: impl_id, kind: SymbolKind.Impl, name: definition.type_name, module_identity: module_row.module_identity, owner: None, span: definition.type_span, ty: Val(target_type), visibility: 0}
    impl_key: symbol_key_text(SymbolKind.Impl, module_text, "", identity_key)
    associated_types: loop declaration in definition.assoc_type_impls -> {
        associated_symbol: Symbol{id: symbol_mint(symbols, SymbolKind.Type, module_text, impl_key, declaration.name), kind: SymbolKind.Type, name: declaration.name, module_identity: module_row.module_identity, owner: Val(impl_key.copy()), span: declaration.span, ty: Val(declaration.ty), visibility: 0}
        SemaRegistrationAssociatedType{symbol: associated_symbol, declaration: declaration.copy(), ty: declaration.ty}
    }
    hook_owner: sema_registration_operator_owner(owner_id, symbols, module_text, target_type, definition.trait_name, definition.operator_rhs)
    methods := loop method_index in 0..<definition.methods.len() -> sema_registration_function(definition.methods[method_index], sema_raw_protocol_function_return(definition.trait_name, false, definition.methods[method_index]), module_row.module_identity, module_text, Val(hook_owner), symbols, module_row.source_file, module_row.source_origin, module_row.source_segments, diagnostics, item_index < 0, item_index, method_index, -1)
    // A conditional impl's methods carry its bounds. A list that does not
    // name a resolved type's parameters is E0003 and the impl applies as an
    // unconditional one. The type another package member declares resolves
    // when the impl is attached to it (sema_registration_attach_namespace_impls).
    if definition.type_params.len() > 0 {
        valid: if nominal_index >= 0 -> sema_registration_impl_conditions_valid(definition, owner_row.nominals[nominal_index].generic_params, diagnostics) else if sema_registration_builtin_scalar(definition.type_name) != None -> sema_registration_impl_conditions_valid(definition, [SemaRegistrationGenericParam]{}, diagnostics) else -> true
        if valid {
            // copy: each method keeps the conditions; the declaration keeps its own.
            loop index in 0..<methods.len() {
                methods[index].impl_conditions = definition.type_params.copy()
            }
        }
    }
    SemaRegistrationImpl{
        symbol: symbol,
        declaration: sema_registration_impl_header(definition),
        source_module_identity: module_row.module_identity,
        source_package_identity: module_row.package_identity,
        target_module_identity: target_module_identity,
        target_type_name: definition.type_name,
        target_type: target_type,
        target_identity_key: target_identity_key,
        trait_name: definition.trait_name,
        trait_symbol: trait_symbol,
        trait_span: definition.trait_span,
        methods: methods,
        associated_type_impls: definition.assoc_type_impls,
        associated_types: associated_types,
        delegation_field: definition.delegation_field,
        compiler_generated: definition.is_generated_serde,
        operator_marker: definition.operator_marker,
        operator_rhs: definition.operator_rhs,
        target_os: definition.os_target,
    }
}

// A conditional impl lists its type's parameters in their declared order,
// each with the bounds the impl applies under: `impl Pair<T: Priced>.Describe`
// for `Pair: struct<T>`. Any other list is E0003 at the list.
sema_registration_impl_conditions_valid: fn(definition: ImplDef, declared: [SemaRegistrationGenericParam], diagnostics: ^[Diagnostic]) -> Bool {
    matches := declared.len() == definition.type_params.len()
    if matches {
        loop index in 0..<declared.len() {
            if declared[index].name != definition.type_params[index].name {
                matches = false
                break
            }
        }
    }
    names: loop param in declared -> param.name
    written: loop param in definition.type_params -> param.name
    span: Span{start: definition.type_params[0].name_span.start, end: definition.type_params[definition.type_params.len() - 1].name_span.end}
    // A list with no bound on a trait impl (`impl Many<Small>.Name`) names
    // type arguments, unless it restates the type's own parameters.
    unbounded: loop param in definition.type_params {
        if param.bounds.len() > 0 {
            break false
        }
    } ?? true
    if unbounded {
        trait_name: definition.trait_name ?? ""
        if matches {
            diagnostics.push(sema_error("E0003", span, "`impl {definition.type_name}<{written.join(", ")}>.{trait_name}` restates the type parameters of `{definition.type_name}`", "an impl of a generic type names the type bare and its methods already see the type's parameters; a list after the type gives the bounds a conditional impl applies under", "write `impl {definition.type_name}.{trait_name} {{`"))
            return false
        }
        diagnostics.push(sema_error("E0908", span, "`impl {definition.type_name}<{written.join(", ")}>.{trait_name}` singles out one instance of `{definition.type_name}`", "impls may not overlap, so an impl of `{trait_name}` covers every `{definition.type_name}` whose parameters meet its bounds and never names a type argument such as `<{written.join(", ")}>`", "implement `{trait_name}` once for every `{definition.type_name}`, with bounds on its parameters, and move what differs for `{written.join(", ")}` into impls on those types"))
        return false
    }
    if matches -> return true
    have: if names.len() == 0 -> "`{definition.type_name}` has no type parameters" else -> "`{definition.type_name}` declares `<{names.join(", ")}>`"
    fix: if names.len() == 0 -> "remove `<{written.join(", ")}>` from the impl head" else -> "write `impl {definition.type_name}<{names.join(", ")}>` with each bound on its parameter"
    diagnostics.push(sema_error("E0003", span, "the conditional impl of `{definition.type_name}` names `<{written.join(", ")}>`", "{have}; a conditional impl lists them in order, each with the bounds it applies under", fix))
    false
}

// `rows` indexes `module_row`'s nominals (sema_registration_impl_rows),
// which no impl registration changes. `items` are the module's program items,
// moved out of `module_row` while it is written.
sema_registration_add_impl: fn(module_row: ^SemaRegistrationModule, module_text: String, symbols: ^SymbolTable, item: Item, items: [Item], rows: SemaRegistrationImplRows, diagnostics: ^[Diagnostic], item_index: Int{-1}) {
    if item == {
        .Impl(definition) -> {
            row := sema_registration_impl(module_row, module_text, symbols, definition, module_row, rows, rows, diagnostics, item_index)
            // In a package, the type may be declared by a
            // sibling member; sema_registration_attach_namespace_impls owns
            // that impl's E0301 once every member is registered.
            if !definition.type_name.contains(".") && module_is_none(row.target_module_identity) && !sema_registration_package_is_namespace(module_row.package_identity) && !sema_registration_builtin_impl_allowed(items, definition) {
                diagnostics.push(sema_registration_unknown_impl_target(definition))
            }
            // A structural head stands for every value of its shape, so a
            // position naming a declared type would be a concrete head.
            if type_structural_head_names(row.target_type) == .Val(names) {
                loop name in names {
                    if sema_registration_impl_rows_nominal(rows, name) < 0 -> next
                    diagnostics.push(sema_error("E0003", definition.type_span, "`impl {definition.type_name}` names the type `{name}` in its head", "a structural impl implements its trait for every value of its shape, so each position of the head is a new parameter name, not a type", "rename the parameter, as in `T` or `Item`"))
                }
            }
            nominal_index: sema_registration_impl_rows_nominal(rows, definition.type_name)
            if definition.trait_name == None && nominal_index >= 0 && module_row.nominals[nominal_index].kind == SemaRegistrationNominalKind.Trait {
                diagnostics.push(sema_registration_impl_on_trait(definition))
            }
            if !module_is_none(row.target_module_identity) && nominal_index >= 0 {
                loop method in row.methods {
                    module_row.nominals[nominal_index].methods.push(method)
                }
            }
            module_row.impls.push(row.move())
        }
        .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

// A built-in target and an undeclared name share E0301 with different teaching.
sema_registration_unknown_impl_target: fn(definition: ImplDef) -> Diagnostic {
    type_name: definition.type_name
    header: if definition.trait_name == .Val(trait_name) -> "{type_name}.{trait_name}" else -> type_name
    dot: type_name.rfind(".")
    leaf: foundation_byte_text(type_name.bytes(), dot + 1, type_name.count_bytes())
    built_in: dot < 0 && (sema_registration_builtin_scalar(type_name) != None || sema_core_is_math_type(type_name))
    why := "no struct, enum, or distinct type named `{type_name}` is declared here, and an `impl` only extends a declared type"
    fix := if dot >= 0 -> "export `{leaf}` from `{foundation_byte_text(type_name.bytes(), 0, dot)}` as a struct, enum, or distinct type, or check the spelling" else -> "declare `{leaf}: struct`, `{leaf}: enum`, or `{leaf}: distinct …` first, or check the spelling"
    if built_in {
        why = "`{type_name}` is built in, and an `impl` only extends a struct, enum, or distinct type declared by your program"
        trait_name: definition.trait_name ?? ""
        fix = if {
            trait_name == "" -> "call a named method, or wrap `{type_name}` in a struct or distinct type of your own and implement the methods there"
            owned_trait_is_operator(trait_name) -> "call a named method, or implement `{trait_name}` on a struct or distinct type of your own (an operator hook on `{type_name}` belongs to the package that declares the other operand type)"
            else -> "implement `{trait_name}` on a struct or distinct type of your own, or wrap `{type_name}` in one"
        }
    }
    if sema_registration_structural_head(type_name) != None {
        trait_name: definition.trait_name ?? ""
        why = "`{type_name}` stands for every value of that shape, so only the module that declares `{trait_name}` implements it there"
        fix = "implement `{trait_name}` in the module that declares it, or wrap the value in a struct or distinct type of your own"
    }
    sema_error("E0301", definition.type_span, "`impl {header}` needs a user-defined type", why, fix)
}

// `impl Shape { … }` outside a type body, where `Shape` is a trait, names no
// type to implement it for: an in-body `impl Shape` is the enclosing type's,
// and an outside one is written `impl Type.Shape`.
sema_registration_impl_on_trait: fn(definition: ImplDef) -> Diagnostic {
    name: definition.type_name
    sema_error("E0301", definition.type_span, "`impl {name}` needs a user-defined type", "`{name}` is a trait, and an `impl` outside a type body only extends a declared struct, enum, or distinct type, so these methods would belong to no type", "write `impl Type.{name} {{ … }}` for the type that implements `{name}`, or move the block into that type's body")
}

// Opaque impl ownership is metadata, not a nominal declaration or public export.
// A runtime handle the module owns takes its Core impls the way a declared
// nominal does; any other opaque type is named in the row's `impl_types`.
sema_registration_source_owns_impl: fn(module_row: SemaRegistrationModule, name: String) -> Bool Never! {
    if !module_is_core(module_row.module_identity) -> return false
    loop row in CORE_SOURCE_OWNED_ROWS {
        if row.module_name != module_row.module_name || row.alias != module_row.core_source_alias {
            next
        }
        if sema_registration_core_handle_owner(row.module_name, name) -> return true
        if !sema_reserved_type_name(name) && !core_module_has_type(row.module_name, name) -> next
        loop owner in row.impl_types {
            if owner == name -> return true
        }
    }
    false
}

// A runtime handle belongs to the Core module that exports it or, for a bare
// prelude spelling (`Path`), to the module that declares that spelling.
sema_registration_core_handle_owner: fn(module_name: String, name: String) -> Bool Never! {
    if ir_runtime_handle_row(name) == None -> return false
    core_module_has_type(module_name, name) || core_bare_source_module(name) == Val((module_name))
}

// The `sema_registration_source_owns_impl` relation for every module and impl
// type at once: `name` maps to module `m` exactly when
// `sema_registration_source_owns_impl(graph.modules[m], name)` holds.
sema_registration_index_source_impls: fn(graph: ^SemaRegistrationGraph) Never! {
    owner_names := name_table_sized(32)
    owner_rows := [[Int]]{[Int]{}}
    loop module_index in 0..<graph.modules.len() {
        module_row: graph.modules[module_index]
        if !module_is_core(module_row.module_identity) -> next
        loop row in CORE_SOURCE_OWNED_ROWS {
            if row.module_name != module_row.module_name || row.alias != module_row.core_source_alias {
                next
            }
            row_owners := row.impl_types.copy()
            loop implementation in module_row.impls {
                if sema_registration_core_handle_owner(row.module_name, implementation.target_type_name) && !row_owners.contains(implementation.target_type_name) {
                    row_owners.push(implementation.target_type_name.copy())
                }
            }
            loop owner in row_owners {
                if !sema_registration_core_handle_owner(row.module_name, owner) && !sema_reserved_type_name(owner) && !core_module_has_type(row.module_name, owner) {
                    next
                }
                slot: name_index(name_intern(owner_names, owner))
                loop owner_rows.len() <= slot -> owner_rows.push([Int]{})
                if owner_rows[slot].contains(module_index) -> next
                owner_rows[slot].push(module_index)
            }
        }
    }
    graph.source_impl_owner_names = owner_names.move()
    graph.source_impl_owner_rows = owner_rows.move()
}

sema_registration_source_impl_owners: fn(graph: SemaRegistrationGraph, name: String) -> [Int]? Never! {
    found: name_find(graph.source_impl_owner_names, name) ?? return None
    slot: name_index(found)
    if slot < graph.source_impl_owner_rows.len() && graph.source_impl_owner_rows[slot].len() > 0 -> return Val(graph.source_impl_owner_rows[slot])
    None
}

// Sets graph.root_functions when module `module_index` registers a function
// whose first parameter is `#Root`.
sema_registration_note_root_functions: fn(graph: ^SemaRegistrationGraph, module_index: Int) Never! {
    if graph.root_functions {
        return
    }
    loop function in graph.modules[module_index].functions {
        if function.declaration.params.len() > 0 && function.declaration.params[0].root {
            graph.root_functions = true
            return
        }
    }
}

// Whether a built-in target is this module's to extend: an operator hook
// whose other operand it declares (sema_registration_opmix_builtin_impl), or
// a trait it declares itself (`Named: trait` then `impl Int.Named`), since the
// orphan rule lets the owner of either the trait or the type write the impl.
// `items` are the module's program items.
sema_registration_builtin_impl_allowed: fn(items: [Item], definition: ImplDef) -> Bool {
    if sema_registration_opmix_builtin_impl(items, definition) -> return true
    if definition.type_name.contains(".") -> return false
    if sema_registration_builtin_scalar(definition.type_name) == None && !sema_core_is_math_type(definition.type_name) && sema_registration_structural_head(definition.type_name) == None {
        return false
    }
    trait_name: definition.trait_name ?? return false
    loop item_index in 0..<items.len() {
        if items[item_index] == .Trait(declared) {
            if declared.name == trait_name -> return true
        }
    }
    false
}

// An operator hook on a built-in type belongs to the package that declares the
// other operand, so `impl Int.Mul(Price)` is legal when this module declares
// `Price`, and so does a conversion into a built-in type from its source
// (`impl Float.From(Celsius)`). An imported operand
// (`impl Int.Sub(lib.Foreign)`) is not a built-in target error: the orphan rule
// (E0902) judges which package owns it. `items` are the module's program items.
sema_registration_opmix_builtin_impl: fn(items: [Item], definition: ImplDef) -> Bool {
    if definition.type_name.contains(".") -> return false
    if sema_registration_builtin_scalar(definition.type_name) == None && !sema_core_is_math_type(definition.type_name) {
        return false
    }
    trait_name: definition.trait_name ?? return false
    if !owned_trait_keyed_by_argument(trait_name) -> return false
    rhs: definition.operator_rhs ?? return false
    if rhs == .Named(rhs_name) {
        if rhs_name == definition.type_name -> return false
        if rhs_name.contains(".") -> return true
        loop item_index in 0..<items.len() {
            if sema_registration_declared_type_name(items[item_index]) == rhs_name -> return true
        }
    }
    false
}

// A built-in scalar type named in source (`Int`, `F32`, `U8`, ...).
sema_registration_builtin_scalar: fn(name: String) -> Type? {
    scalar: sema_marker_rules_builtin_type(name) ?? return None
    if scalar == {
        .Named(_) -> None
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> Val(scalar)
    }
}

// The head of a structural impl (`impl [T].Trait`, `impl [T#N].Trait`,
// `impl T?.Trait`, `impl [K: V].Trait`), which the parser names by the
// head's canonical spelling. None for any other impl's type name.
sema_registration_structural_head: fn(type_name: String) -> Type? {
    if !type_name.starts_with("[") && !type_name.ends_with("?") -> return None
    head: parse_type_text(type_name) ?? return None
    if type_structural_head_names(head) == None -> return None
    Val(head)
}

// The type a struct, enum, distinct or alias declaration names; "" otherwise.
sema_registration_declared_type_name: fn(item: Item) -> String Never! {
    if item == {
        .Struct(declared) -> declared.name
        .Enum(declared) -> declared.name
        .Distinct(declared) -> declared.name
        .TypeAlias(declared) -> declared.name
        .Func(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> ""
    }
}

// A package is one namespace, so `impl Span` may sit in a
// member file beside the one declaring `Span`. Its row and methods belong to
// the declaring member's nominal; an impl whose type no member declares is
// E0301.
sema_registration_attach_namespace_impls: fn(graph: ^SemaRegistrationGraph) {
    loop module_index in 0..<graph.modules.len() {
        package_identity: graph.modules[module_index].package_identity
        if !sema_registration_package_is_namespace(package_identity) -> next
        loop impl_index in 0..<graph.modules[module_index].impls.len() {
            definition: graph.modules[module_index].impls[impl_index].declaration
            if definition.type_name.contains(".") || !module_is_none(graph.modules[module_index].impls[impl_index].target_module_identity) {
                next
            }
            owner_index := -1
            loop candidate_index in 0..<graph.modules.len() {
                if candidate_index == module_index || graph.modules[candidate_index].package_identity != package_identity {
                    next
                }
                if sema_registration_impl_nominal_index(graph.modules[candidate_index], definition.type_name) >= 0 {
                    owner_index = candidate_index
                    break
                }
            }
            if owner_index < 0 {
                if !sema_registration_builtin_impl_allowed(graph.modules[module_index].program.items, definition) {
                    sema_registration_push_graph_diagnostic(graph, module_index, sema_registration_unknown_impl_target(definition))
                }
                next
            }
            owner_nominal: sema_registration_impl_nominal_index(graph.modules[owner_index], definition.type_name)
            if definition.trait_name == None && graph.modules[owner_index].nominals[owner_nominal].kind == SemaRegistrationNominalKind.Trait {
                sema_registration_push_graph_diagnostic(graph, module_index, sema_registration_impl_on_trait(definition))
            }
            // The first registration already reported the methods' own
            // diagnostics; re-keying them under the owner repeats nothing.
            repeated := [Diagnostic]{}
            row := sema_registration_impl(graph.modules[module_index], module_text(graph.module_table, graph.modules[module_index].module_identity), graph.symbols, definition, graph.modules[owner_index], sema_registration_impl_rows(graph.modules[owner_index]), sema_registration_impl_rows(graph.modules[module_index]), repeated)
            attached_methods := [SemaRegistrationFunction]{}
            loop m_idx in 0..<row.methods.len() {
                if m_idx < graph.modules[module_index].impls[impl_index].methods.len() {
                    row.methods[m_idx].item_index = graph.modules[module_index].impls[impl_index].methods[m_idx].item_index
                    row.methods[m_idx].method_index = graph.modules[module_index].impls[impl_index].methods[m_idx].method_index
                    row.methods[m_idx].trait_block_index = graph.modules[module_index].impls[impl_index].methods[m_idx].trait_block_index
                    row.methods[m_idx].declaration.body = graph.modules[module_index].impls[impl_index].methods[m_idx].declaration.body
                }
                attached := row.methods[m_idx]
                if attached.declaration.body.len() == 0 && attached.item_index >= 0 {
                    attached.declaration.body = sema_registration_function_body(graph.modules[module_index], attached)
                    attached.item_index = -1
                    attached.method_index = -1
                    attached.trait_block_index = -1
                }
                attached_methods.push(attached)
            }
            // Only the attached registration knows the owner's parameters.
            if definition.type_params.len() > 0 {
                refused := [Diagnostic]{}
                _: sema_registration_impl_conditions_valid(definition, graph.modules[owner_index].nominals[owner_nominal].generic_params, refused)
                loop diagnostic in refused {
                    sema_registration_push_graph_diagnostic(graph, module_index, diagnostic)
                }
            }
            graph.modules[module_index].impls[impl_index] = row.move()
            loop method in attached_methods {
                graph.modules[owner_index].nominals[owner_nominal].methods.push(method)
            }
        }
    }
}

sema_registration_item_has_foreign_name: fn(item: Item, name: String) -> Bool Never! {
    if item == {
        .ExternRust(block) -> {
            loop function in block.functions {
                if function.name == name -> return true
            }
        }
        .CModule(block) -> {
            loop function in block.functions {
                if function.name == name -> return true
            }
        }
        .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .Module(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    false
}

// The position of `symbol`'s declaration in `module_row.declarations`. A
// named root resolves through the module's declaration positions; only a
// foreign function (declared inside an extern block, which has no root name)
// needs the scan over the module's declarations.
sema_registration_declaration_position: fn(module_row: SemaRegistrationModule, symbol: Symbol) -> Int? {
    if sema_registration_declaration_row(module_row, symbol.name) == .Val(position) -> return Val(position)
    loop (position, declaration) in module_row.declarations {
        if sema_registration_item_has_foreign_name(declaration, symbol.name) -> return Val(position)
    }
    None
}

sema_registration_foreign_handle_close_key: fn(module_row: SemaRegistrationModule, symbols: SymbolTable, facts: SemaRegistrationForeignHandleFacts) -> String? {
    loop registered_index in 0..<module_row.foreign_functions.len() {
        if module_row.foreign_functions[registered_index].owner == SemaRegistrationForeignOwner.CModule && module_row.foreign_functions[registered_index].declaration.name == facts.close {
            return Val(symbol_table_key(symbols, module_row.foreign_functions[registered_index].symbol.id))
        }
    }
    None
}

// The prepared row of one module; its diagnostics are appended to `reported`.
// The row is returned whole, so the graph takes it without a copy. The input is
// consumed: its program moves into the row instead of being copied.
// `module_text` is the input's identity text, which its symbol keys spell;
// `symbols` holds the module's reserved range, which mints them. `templates` are
// the generic-module templates the module imports; its own templates come from
// its program. `policies` are its package's checked user policy declarations.
// `settings` are its package's declared settings (sema_build_facts_settings_at),
// which module arguments may read. `codecs` are the codecs the graph gives the
// types its declarations hold (sema_derive_foreign_codecs).
sema_registration_prepare_module_row: fn(input: ^^SemaRegistrationModuleInput, module_text: String, symbols: ^SymbolTable, templates: [SemaGenericModuleSource], policies: [UserPolicyDecl], settings: [SemaBuildSetting], codecs: SemaCodecNames, reported: ^[Diagnostic]) -> SemaRegistrationModule {
    diagnostics := [Diagnostic]{}
    owned := input.move()
    module_row := SemaRegistrationModule{
        package_identity: owned.package_identity,
        module_identity: owned.module_identity,
        module_name: owned.module_name,
        core_source_alias: owned.core_source_alias,
        module_path: owned.module_path,
        declared_module: owned.declared_module,
        package: owned.meta.package.copy(),
        memory_kernel: owned.meta.memory_kernel,
        source_file: owned.source_file,
        source_segments: owned.source_segments,
        source_origin: owned.source_origin,
        program: owned.program,
        source: owned.source,
        symbols: [Symbol]{},
        declarations: [Item]{},
        symbol_names: name_table_sized(16),
        symbol_rows: [Int]{-1},
        declaration_rows: [Int]{-1},
        impls: [SemaRegistrationImpl]{},
        functions: [SemaRegistrationFunction]{},
        foreign_functions: [SemaRegistrationForeignFunction]{},
        nominals: [SemaRegistrationNominal]{},
        constants: [SemaRegistrationConstant]{},
        imports: [SemaRegistrationImport]{},
        exports: [SemaRegistrationExport]{},
        import_binding_names: name_table_sized(16),
        import_binding_values: [Int]{-1},
        declared_trait_impls: name_table_sized(4),
        namespace: owned.namespace,
        namespace_names: owned.namespace_names,
        namespace_private: owned.namespace_private,
        namespace_refs: owned.namespace_refs,
        // Items expanded from a template declared in another module spell
        // names its own source never does: every namespace name binds.
        namespace_full: templates.len() > 0,
    }
    // The reset makes the `.move()` above a move, not a copy of the program.
    owned.program = ast_program()
    if module_row.package_identity == "" || module_is_none(module_row.module_identity) || module_row.module_name == "" || module_row.module_path == "" || module_row.source_file == "" {
        diagnostics.push(sema_error_optional("E0003", None, "a declaration registry row is missing source identity", "package, module, display path, and source identity remain separate semantic inputs", "provide the loader's canonical package, module, display-path, and source-file identities"))
    }
    // A module's field lines become its Module record before casing would
    // read them as constants. Core source carries no record.
    if !module_is_core(module_row.module_identity) {
        sema_module_meta_lower(module_row.program, module_row.declared_module, owned.meta, module_row.source, diagnostics)
    }
    // Identifier casing is checked on the parsed source before any
    // declaration is registered or rewritten, except where the input defers
    // it (SemaRegistrationModuleInput.check_casing).
    if owned.check_casing -> sema_casing_program(module_row.program, diagnostics)
    // E0932: `#Deprecated` retires a public item; checked
    // on the parsed items, inline module bodies included, before inline
    // modules are lowered.
    sema_registration_deprecated_visibility(module_row.program.items, diagnostics)
    // E1137: `#Open` is valid only on public enums (inline module bodies
    // included), checked before inline modules are lowered.
    sema_registration_open_enum_markers(module_row.program.items, true, diagnostics)
    // E0645: a Core item named `__…` is `priv` (inline module bodies
    // included); sema_registration_item_visibility registers it.
    if module_is_core(module_row.module_identity) -> sema_registration_dunder_visibility(module_row.program.items, diagnostics)
    loop facts in owned.foreign_handles {
        if sema_registration_module_has_name(module_row, facts.jet_name) {
            diagnostics.push(sema_defined_twice(facts.jet_name, "module declarations share one namespace", facts.source_span))
            next
        }
        nominal: sema_registration_foreign_handle_nominal(facts, module_row.module_identity, module_text, symbols, diagnostics)
        if nominal == .Val(value) {
            sema_registration_set_symbol_position(module_row, value.symbol.name, module_row.symbols.len())
            module_row.symbols.push(value.symbol)
            module_row.symbol_nominal_rows.push(module_row.nominals.len())
            module_row.nominals.push(value)
        }
    }
    // Each valid module alias becomes an expanded module instance before
    // anything else sees the items. Each rewrite below updates the program in
    // place and leaves it untouched (uncopied) when it has nothing to rewrite.
    sema_generic_modules_expand(module_row.program, module_row.module_identity, module_text, templates, settings)
    // Ordered multi-head declarations fold into one ordinary enum pattern
    // table before inline lifting and registration see the items.
    sema_head_patterns_fold_items(module_row.program.items, diagnostics)
    // Inline modules give their members one lifted identity
    // (types beside the module, top-level member functions by member name)
    // and resolve `module.f(...)` and `use module.[f]` before registration.
    module_row.inline_bindings = sema_inline_modules_lower(module_row.program, diagnostics)
    // Trait-bounded variadics become one closed function per called arity.
    sema_variadic_bounds_expand(module_row.program)
    sema_policy_materialize(module_row.program, policies, module_text, module_row.source_file, module_row.source_origin, module_row.source_segments, diagnostics)
    // Every `#Allow` names its reason (L3103) and never `allow_reason`
    // (E0355), as check_program does for one file.
    sema_marker_rules_validate_allow(module_row.program, diagnostics)
    // Root `#loop` declarations expand first, so every
    // generated impl, conversion, and test registers as a written item.
    sema_derive_expand_template_loops(module_row.program.items, owned.loop_values.move(), owned.loop_values_pending, module_is_core(module_row.module_identity), diagnostics)
    // A number family's impl becomes one impl per standard size, after the
    // root `#loop`s so a family impl one generates expands too.
    module_row.program.items = sema_derive_expand_family_impls(module_row.program.items.move(), module_row.program.imports, diagnostics)
    // Each `protocol` becomes its generated `.Client`/`.Server` handle types
    // and transition methods before any declaration is registered.
    sema_protocols_expand(module_row.program.items, diagnostics)
    // External `Type.method: fn` headers become one-method impls
    // (FunctionHeaders.jet sema_function_header_normalize_external_methods).
    sema_function_header_normalize_external_methods(module_row.program, sema_registration_package_is_namespace(module_row.package_identity), diagnostics)
    // Reject reserved type declarations before automatic capability expansion:
    // an invalid nominal must not produce methods that cascade from E0106.
    item_index := 0
    loop item_index < module_row.program.items.len() {
        if !sema_registration_reserved_type_rule(module_text, module_row.program.items[item_index], sema_registration_root_name(module_row.program.items[item_index]), diagnostics) {
            _ := module_row.program.items.remove(item_index, .Slot)
        } else { item_index += 1 }
    }
    // Each `#Patchable` struct gains its generated `T.Patch` and
    // apply/diff/merge methods (Patchable.jet).
    sema_patchable_expand(module_row.program.items)
    // Each struct's `validate { … }` block becomes its
    // generated `T.validate(value)` before any declaration is registered.
    sema_validate_blocks(module_row.program.tables, module_row.program.items, diagnostics)
    // A `#Layout(U8)` enum gains its `to_int` and `from_int` methods
    // (EnumNumbers.jet).
    sema_enum_numbers_expand(module_row.program.items, module_row.source, diagnostics)
    // `#As` sits on one stored field of a struct (E1129, E1131), read
    // before the computed fields become getters.
    sema_registration_as_fields(module_row.program.items, diagnostics)
    // Each computed field becomes its generated getter method, which a
    // read of the field calls.
    sema_derive_computed_getters(module_row.program.items)
    // Declared conversions register once per module and become
    // their checked conversion routines before any declaration is resolved.
    sema_error_conversion_items(module_row.program.items, module_row.program.rule_facts, module_row.namespace_refs, diagnostics)
    // Selected built-in capabilities expand from the Prelude
    // derive templates into compiler-generated trait blocks before any
    // declaration, impl, or known-time value is registered. The Core
    // library's check keeps a Core module's template expansions; a compile
    // bound to that Core takes them in place of expanding.
    derive_memo := owned.derive_memo.move()
    sema_derive_expand_builtin_items_with(module_row.program.items, diagnostics, derive_memo)
    module_row.derive_unread = derive_memo.unread
    sema_derive_memo_capture(derive_memo.move(), module_row.derive_captures)
    // Explicit and structurally selected codecs
    // enter as ordinary generated `impl T.Encode`/`impl T.Decode` items.
    sema_serde_expand_builtin_items(module_row.program.items, codecs)
    // A user type that holds itself and a Clock gains its generated fork
    // function, the copy that forks each Clock it holds (ForkMethods.jet).
    if !module_is_core(module_row.module_identity) {
        sema_fork_methods_expand(module_row.program.items)
    }
    // S62 delegation and default bodies become written impl methods
    // before registration (TraitImpls.jet).
    sema_trait_impls_synthesize(module_row.program.items, module_row.trait_defaults_unread)
    // A return type naming a fallible alias is written as its expansion.
    sema_registration_expand_fallible_aliases(module_row.program.items)
    // A `Self` written in an impl method's signature names the impl's type.
    sema_registration_expand_impl_self(module_row.program.items)
    row_source_file: module_row.source_file.copy()
    row_source_origin: module_row.source_origin.copy()
    row_source_segments: module_row.source_segments.copy()
    // Registering a root reads no program item, so the items move out for the
    // walk and back after it: each one is read in place instead of copied.
    items := module_row.program.items.move()
    module_row.program.items = [Item]{}
    loop index in 0..<items.len() {
        if !sema_registration_add_root(module_row, module_text, symbols, items[index], row_source_file, row_source_origin, row_source_segments, diagnostics, index) {

        }
        // The first declaration remains the lookup winner after a collision.
    }
    module_row.program.items = items.move()
    // (E2408, E2415): serde field markers and anonymous-union decode shapes
    // are checked on the registered items, after the trait registry is built.
    sema_registration_serde_items(module_row.program.items, diagnostics)
    sema_registration_codable_options(module_row.program.items, diagnostics)
    // The `#CLI` items are checked on the registered items, after struct
    // registration.
    sema_registration_cli_items(module_row.program.items, diagnostics)
    // Only foreign-handle rows change; every other row is read in place (a
    // copied row would carry its whole source declaration).
    loop nominal_index in 0..<module_row.nominals.len() {
        if module_row.nominals[nominal_index].kind != SemaRegistrationNominalKind.ForeignHandle {
            next
        }
        // copy: `source` is read, then the same nominal slot is rewritten with the updated facts.
        // Jet has no writable binding for an enum payload in module_row.nominals.
        source: module_row.nominals[nominal_index].source.copy()
        if source == .ForeignHandle(facts) {
            updated_facts := facts
            updated_facts.close_function_key = sema_registration_foreign_handle_close_key(module_row, symbols, updated_facts)
            module_row.nominals[nominal_index].source = SemaRegistrationNominalSource.ForeignHandle{value: updated_facts}
        }
    }
    // Only impls register here; every other item is skipped. The items move
    // out of the row for the walk and back after it, so each impl is read in
    // place instead of copied while sema_registration_add_impl writes the
    // row. The nominal rows are indexed once: impls add methods to nominals,
    // never nominals.
    impl_rows: sema_registration_impl_rows(module_row)
    items = module_row.program.items.move()
    module_row.program.items = [Item]{}
    loop index in 0..<items.len() {
        if items[index] == .Impl(_) {
            sema_registration_add_impl(module_row, module_text, symbols, items[index], items, impl_rows, diagnostics, index)
        }
    }
    module_row.program.items = items.move()
    // Root exports are retained separately so private declarations never become
    // cross-module candidates merely because their name is known.
    loop symbol_index in 0..<module_row.symbols.len() {
        if module_row.symbols[symbol_index].visibility == 0 -> next
        sym: module_row.symbols[symbol_index]
        export_name: sym.name
        export_visibility: sym.visibility
        declaration_position: sema_registration_declaration_position(module_row, sym)
        is_const: sym.kind == SymbolKind.Constant
        export_symbol: if is_const -> sym.copy() else -> Symbol{id: sym.id, kind: sym.kind, name: sym.name, module_identity: sym.module_identity, owner: sym.owner, span: sym.span, ty: None, visibility: sym.visibility}
        row_ref: if is_const -> -1 else -> symbol_index
        module_row.exports.push(SemaRegistrationExport{name: export_name, symbol: export_symbol, declaration_position: declaration_position, source_module_identity: module_row.module_identity, visibility: export_visibility, target_symbol_row: row_ref})
    }

    sema_attach_diagnostic_source_locations(diagnostics, 0, module_row.source_segments)
    loop diagnostic in diagnostics -> reported.push(diagnostic)
    module_row.move()
}

// A transparent alias of a fallible type (`Parsed<T>: T AppError!`)
// carries the function's failure contract, which is read from the written
// return type: a return type naming such an alias is written as its
// expansion, so `-> Parsed<Int>` has the contract of `-> Int AppError!`.
sema_registration_expand_fallible_aliases: fn(items: ^[Item]) Never! {
    aliases := [TypeAliasDef]{}
    loop item in items {
        if item == .TypeAlias(definition) {
            if definition.target == .Result(_, _) -> aliases.push(definition.copy())
        }
    }
    if aliases.len() == 0 {
        return
    }
    loop index in 0..<items.len() {
        replacement := Item?{None}
        if items[index] == {
            .Func(definition) -> {
                if sema_registration_fallible_alias_return(aliases, definition.return_type) == .Val(expanded) {
                    updated := definition
                    updated.return_type = Val(expanded)
                    replacement = Val(Item.Func{value: updated})
                }
            }
            .Impl(definition) -> {
                updated := definition
                if sema_registration_fallible_alias_methods(aliases, updated.methods) {
                    replacement = Val(Item.Impl{value: updated})
                }
            }
            .Struct(definition) -> {
                updated := definition
                changed := sema_registration_fallible_alias_methods(aliases, updated.methods)
                loop block_index in 0..<updated.trait_impls.len() {
                    if sema_registration_fallible_alias_methods(aliases, updated.trait_impls[block_index].methods) {
                        changed = true
                    }
                }
                if changed -> replacement = Val(Item.Struct{value: updated})
            }
            .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
        if replacement == .Val(item) -> items[index] = item
    }
}

// A method of an impl (`impl T`, `impl T.Trait`, or a declaration's own
// method or trait block) that writes `Self` in a parameter or its return
// means the implemented type: `origin: fn() -> Self` returns a `T`. A type
// with type parameters is `Self` applied to its own (`Pair<T>`); a built-in
// scalar's operator impl (`impl Int.Mul`) has that scalar.
sema_registration_type_mentions_self: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "Self"
        .Apply(name, args) -> {
            if name == "Self" -> return true
            loop arg in args {
                if sema_registration_type_mentions_self(arg) -> return true
            }
            false
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .Quantity(inner, _) -> sema_registration_type_mentions_self(inner)
        .Map(key, _, value) -> sema_registration_type_mentions_self(key) || sema_registration_type_mentions_self(value)
        .Result(ok, err) -> sema_registration_type_mentions_self(ok) || sema_registration_type_mentions_self(err)
        .Tuple(fields) -> {
            loop field in fields {
                if sema_registration_type_mentions_self(field.ty) -> return true
            }
            false
        }
        .Union(members) -> {
            loop member in members {
                if sema_registration_type_mentions_self(member) -> return true
            }
            false
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params {
                if sema_registration_type_mentions_self(param) -> return true
            }
            if ret == .Val(r) && sema_registration_type_mentions_self(r) -> return true
            false
        }
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Case(_, _) | .Measure(_) -> false
    }
}

sema_registration_methods_mention_self: fn(methods: [Func]) -> Bool Never! {
    loop method in methods {
        loop param in method.params {
            if sema_registration_type_mentions_self(param.ty) -> return true
        }
        if method.return_type == .Val(ret) && sema_registration_type_mentions_self(ret) -> return true
    }
    false
}

sema_registration_trait_impls_mention_self: fn(blocks: [TraitImplBlock]) -> Bool Never! {
    loop block in blocks {
        if sema_registration_methods_mention_self(block.methods) -> return true
    }
    false
}

sema_registration_expand_impl_self: fn(items: ^[Item]) {
    // Each generic type's name in `generic_names`, its parameters at its id.
    generic_names := name_table_sized(16)
    generic_params := [[TypeParam]]{[TypeParam]{}}
    has_self := false
    loop item in items {
        if item == {
            .Struct(definition) -> {
                if definition.type_params.len() > 0 -> sema_registration_generic_params_set(generic_names, generic_params, definition.name, definition.type_params)
                if !has_self && (sema_registration_methods_mention_self(definition.methods) || sema_registration_trait_impls_mention_self(definition.trait_impls)) {
                    has_self = true
                }
            }
            .Enum(definition) -> {
                if definition.type_params.len() > 0 -> sema_registration_generic_params_set(generic_names, generic_params, definition.name, definition.type_params)
                if !has_self && (sema_registration_methods_mention_self(definition.methods) || sema_registration_trait_impls_mention_self(definition.trait_impls)) {
                    has_self = true
                }
            }
            .Impl(definition) -> {
                if !has_self && sema_registration_methods_mention_self(definition.methods) -> has_self = true
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    if !has_self -> return
    loop index in 0..<items.len() {
        replacement := Item?{None}
        if items[index] == {
            .Impl(definition) -> {
                if !sema_registration_methods_mention_self(definition.methods) -> next
                updated := definition.copy()
                if sema_registration_impl_self_methods(sema_registration_impl_self_type(definition.type_name, generic_names, generic_params), updated.methods) {
                    replacement = Val(Item.Impl{value: updated})
                }
            }
            .Struct(definition) -> {
                if !sema_registration_methods_mention_self(definition.methods) && !sema_registration_trait_impls_mention_self(definition.trait_impls) -> next
                updated := definition.copy()
                self_type: sema_registration_impl_self_type(definition.name, generic_names, generic_params)
                changed := sema_registration_impl_self_methods(self_type, updated.methods)
                loop block_index in 0..<updated.trait_impls.len() {
                    if sema_registration_impl_self_methods(self_type, updated.trait_impls[block_index].methods) {
                        changed = true
                    }
                }
                if changed -> replacement = Val(Item.Struct{value: updated})
            }
            .Enum(definition) -> {
                if !sema_registration_methods_mention_self(definition.methods) && !sema_registration_trait_impls_mention_self(definition.trait_impls) -> next
                updated := definition.copy()
                self_type: sema_registration_impl_self_type(definition.name, generic_names, generic_params)
                changed := sema_registration_impl_self_methods(self_type, updated.methods)
                loop block_index in 0..<updated.trait_impls.len() {
                    if sema_registration_impl_self_methods(self_type, updated.trait_impls[block_index].methods) {
                        changed = true
                    }
                }
                if changed -> replacement = Val(Item.Enum{value: updated})
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
        if replacement == .Val(item) -> items[index] = item
    }
}

sema_registration_generic_params_set: fn(names: ^NameTable, params: ^[[TypeParam]], name: String, value: [TypeParam]) Never! {
    id: name_index(name_intern(names, name))
    if id == params.len() -> params.push([TypeParam]{})
    params[id] = value
}

// The type `Self` names in an impl of `name`: the type applied to its own
// parameters when `names` (with `params` by id) declares it generic.
sema_registration_impl_self_type: fn(name: String, names: NameTable, params_by_name: [[TypeParam]]) -> Type {
    if sema_registration_builtin_scalar(name) == .Val(scalar) -> return scalar
    found: name_find(names, name) ?? return Type.Named{name: name}
    params: params_by_name[name_index(found)]
    if params.len() == 0 -> return Type.Named{name: name}
    Type.Apply{name: name, args: loop param in params -> Type.Named{name: param.name}}
}

sema_registration_impl_self_methods: fn(self_type: Type, methods: ^[Func]) -> Bool Never! {
    names: [String]{"Self"}
    actuals: [Type]{self_type}
    changed := false
    loop index in 0..<methods.len() {
        loop param_index in 0..<methods[index].params.len() {
            written: methods[index].params[param_index].ty
            substituted: sema_inference_substitute_type(written, names, actuals)
            if substituted != written {
                methods[index].params[param_index].ty = substituted
                changed = true
            }
        }
        if methods[index].return_type == .Val(written) {
            substituted: sema_inference_substitute_type(written, names, actuals)
            if substituted != written {
                methods[index].return_type = Val(substituted)
                changed = true
            }
        }
    }
    changed
}

sema_registration_fallible_alias_methods: fn(aliases: [TypeAliasDef], methods: ^[Func]) -> Bool Never! {
    changed := false
    loop index in 0..<methods.len() {
        if sema_registration_fallible_alias_return(aliases, methods[index].return_type) == .Val(expanded) {
            methods[index].return_type = Val(expanded)
            changed = true
        }
    }
    changed
}

sema_registration_fallible_alias_return: fn(aliases: [TypeAliasDef], return_type: Type?) -> Type? Never! {
    written: return_type ?? return None
    name := ""
    args := [Type]{}
    if written == {
        .Named(head) -> name = head
        .Apply(head, applied) -> {
            name = head
            args = applied
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
    loop alias in aliases {
        if alias.name != name || alias.type_params.len() != args.len() -> next
        names: loop parameter in alias.type_params -> parameter.name
        return Val(sema_inference_substitute_type(alias.target, names, args))
    }
    None
}

// A compiler thread is admitted for at least this many bytes of module
// source to prepare.
SEMA_REGISTRATION_PREPARE_MIN_BYTES_PER_THREAD: 262144

// One module's sema_registration_prepare_module_row inputs.
SemaRegistrationPrepareJob: struct {
    input: SemaRegistrationModuleInput,
    // The input's module identity text, which its symbol keys spell.
    module_text: String,
    // The module's reserved symbol range, which its preparation interns
    // into.
    symbols: SymbolKeys,
    templates: [SemaGenericModuleSource],
    policies: [UserPolicyDecl],
    settings: [SemaBuildSetting],
    codecs: SemaCodecNames,
}

// A prepared module row, its symbol range and the diagnostics its
// preparation reported.
SemaRegistrationPreparedRow: struct {
    module_row: SemaRegistrationModule,
    symbols: SymbolKeys,
    diagnostics: [Diagnostic],
}

sema_registration_prepare_job: fn(job: ^^SemaRegistrationPrepareJob) -> SemaRegistrationPreparedRow {
    owned := job.move()
    input := owned.input.move()
    symbols := symbol_table_open(owned.symbols.move())
    templates := owned.templates.move()
    policies := owned.policies.move()
    settings := owned.settings.move()
    codecs := owned.codecs.move()
    diagnostics := [Diagnostic]{}
    module_row := sema_registration_prepare_module_row(input, owned.module_text, symbols, templates, policies, settings, codecs, diagnostics)
    if !module_is_core(module_row.module_identity) && module_row.package_identity != "jet:canonical-prelude" && module_row.package_identity != JET_CANONICAL_EFFECT_PACKAGE_IDENTITY {
        sema_footprint_populate_module(module_row)
    }
    keys := symbols.ranges.pop() ?? panic("a prepared module lost its symbol range")
    SemaRegistrationPreparedRow{module_row: module_row.move(), symbols: keys.move(), diagnostics: diagnostics.move()}
}

// A module's share of the symbol ids sema_registration_prepare_graph hands
// out: its source bytes, plus a floor for the declarations its preparation
// generates and for each template it instantiates.
SEMA_REGISTRATION_SYMBOL_WEIGHT_FLOOR: 4096

sema_registration_symbol_weight: fn(input: SemaRegistrationModuleInput, templates: Int) -> Int Never! {
    input.source.count_bytes() + SEMA_REGISTRATION_SYMBOL_WEIGHT_FLOOR * (1 + templates)
}

// The prepared row of each job, in job order. A module's preparation reads
// nothing but its own job, so the jobs move into the threads' shared state
// and up to `threads` compiler threads claim them, largest source first;
// each row lands at its job's position, so the rows and their diagnostics
// are the same for any thread count.
sema_registration_prepare_rows: fn(jobs: ^^[SemaRegistrationPrepareJob], threads: CompilerThreads) -> [SemaRegistrationPreparedRow] {
    owned := jobs.move()
    weights := [Int]{}
    work := 0
    loop job in owned {
        bytes: job.input.source.count_bytes()
        weights.push(bytes)
        work += bytes
    }
    workers: compiler_threads_admit(threads, owned.len(), work, SEMA_REGISTRATION_PREPARE_MIN_BYTES_PER_THREAD, 0, 0)
    rows := [SemaRegistrationPreparedRow]{}
    if workers <= 1 {
        owned.reverse()
        loop owned.len() > 0 {
            job := owned.pop() ?? break
            rows.push(sema_registration_prepare_job(job))
        }
        return rows
    }
    // The jobs are held lightest first, so each claim pops the largest left;
    // `positions[at]` is the job order position of the job held at `at`.
    heaviest: compiler_threads_heaviest_first(weights)
    positions := [Int]{}
    loop rank in 0..<heaviest.len() -> positions.push(heaviest[heaviest.len() - 1 - rank])
    compiler_apply_order<SemaRegistrationPrepareJob>(owned, positions)
    shared_state: Shared{SemaRegistrationPrepareShared{jobs: [SemaRegistrationPrepareJob]{}, positions: positions.move()}}
    sema_registration_prepare_fill(shared_state, owned)
    slots := [SemaRegistrationPreparedRow?]{}
    loop _ in 0..<weights.len() -> slots.push(None)
    sema_registration_preparers(shared_state, 0, workers, slots)
    slots.reverse()
    loop slots.len() > 0 {
        slot := slots.pop() ?? break
        row := compiler_threads_slot_taken(slot)
        rows.push(row)
    }
    rows
}

// The unclaimed jobs, lightest first, and each one's job order position.
SemaRegistrationPrepareShared: struct {
    jobs: [SemaRegistrationPrepareJob],
    positions: [Int],
}

// One claimed job and its job order position.
SemaRegistrationPrepareClaim: struct {
    position: Int,
    job: SemaRegistrationPrepareJob,
}

// One job's prepared row, prepared by one thread.
SemaRegistrationPreparedSlot: struct {
    position: Int,
    row: SemaRegistrationPreparedRow,
}

sema_registration_prepare_fill: fn(shared_state: Shared<SemaRegistrationPrepareShared>, jobs: ^[SemaRegistrationPrepareJob]) {
    permit: shared_state.guard_edit()
    compiler_transfer_rows<SemaRegistrationPrepareJob>(permit.value.jobs, jobs)
}

// Runs preparing threads `from..<workers`, one task each, and moves every row
// a thread returned into its job's slot of `slots`.
sema_registration_preparers: fn(shared_state: Shared<SemaRegistrationPrepareShared>, from: Int, workers: Int, slots: ^[SemaRegistrationPreparedRow?]) {
    if from >= workers {
        return
    }
    task.group sema_registration_prepare_threads {
        head: task sema_registration_prepare_claimed(shared_state)
        sema_registration_preparers(shared_state, from + 1, workers, slots)
        claimed := compiler_threads_joined(head)
        loop claimed.len() > 0 {
            done := claimed.pop() ?? break
            slots[done.position] = Val(done.row.move())
        }
    }
}

// One thread: prepares the jobs it claims.
sema_registration_prepare_claimed: fn(shared_state: Shared<SemaRegistrationPrepareShared>) -> [SemaRegistrationPreparedSlot] {
    prepared := [SemaRegistrationPreparedSlot]{}
    loop {
        claim := sema_registration_prepare_claim(shared_state) ?? break
        position: claim.position
        row := sema_registration_prepare_job(claim.job.move())
        prepared.push(SemaRegistrationPreparedSlot{position: position, row: row.move()})
    }
    prepared
}

// Pops the largest unclaimed job, or None once every job is claimed.
sema_registration_prepare_claim: fn(shared_state: Shared<SemaRegistrationPrepareShared>) -> SemaRegistrationPrepareClaim? {
    permit: shared_state.guard_edit()
    job := permit.value.jobs.pop() ?? return None
    position: compiler_threads_taken(permit.value.positions)
    Val(SemaRegistrationPrepareClaim{position: position, job: job.move()})
}

// The CLI shape of one `#CLI` field.
SemaRegistrationCLIFieldKind: enum {
    Flag,
    OptionalOption,
    DefaultedOption,
    RequiredOption,
}

// Every `#CLI` program struct of the module, in item order. A struct that is
// not `#CLI` may carry neither a callable member (E1345) nor `#Arg` (E1319). A
// `#CLI` struct's fields each map to one flag (E1305), keep
// `#Arg(flag_only: true)` meaningful (E1309), derive distinct flags beside the
// reserved `--help`/`--allow`/`--deny` (E1306), use one-letter distinct
// `short:` names (E1318), and keep `env:` off presence flags (E1319). Its
// methods and bound members are commands with one namespace (E1344), read-only
// receivers (E1347), and callable shapes (E1345), and are not allowed on a
// Codable struct (E1346).
sema_registration_cli_items: fn(items: [Item], diagnostics: ^[Diagnostic]) {
    loop item in items {
        if item == .Struct(definition) {
            cli := false
            loop derive_item in definition.derives {
                if derive_item.name == "CLI" -> cli = true
            }
            if !cli {
                loop binding in definition.cli_bindings {
                    diagnostics.push(sema_registration_e1345(binding.name, binding.name_span, "a callable member is only valid inside a `#CLI` program struct"))
                }
                loop field in definition.fields {
                    loop marker in field.serde_markers {
                        if marker.name == MARKER_ARG {
                            diagnostics.push(sema_registration_e1319(marker.name, field.name, "`#Arg` describes a generated command input, but this struct is not `#CLI`.", "remove the marker, or mark the command-input struct `#CLI`", marker.name_span))
                        }
                    }
                }
                next
            }
            // Flag, short option and command words are never empty.
            seen_flags := name_table_sized(definition.fields.len() + 8)
            loop name in ([String]{"help", "allow", "deny"}) -> _ := name_intern(seen_flags, name)
            // Each short option in `short_names`, the field that selects it at its id.
            short_names := name_table_sized(8)
            short_fields := [String]{""}
            if sema_registration_cli_standard(definition.type_markers) {
                loop name in ([String]{"verbose", "quiet", "color", "version"}) {
                    _ := name_intern(seen_flags, name)
                }
                _ := sema_registration_cli_short_take(short_names, short_fields, "v", "standard --verbose")
                _ := sema_registration_cli_short_take(short_names, short_fields, "q", "standard --quiet")
            }
            loop field in definition.fields {
                kind: sema_registration_cli_field_kind(field) ?? {
                    diagnostics.push(sema_error("E1305", field.name_span, "field `{field.name}` has no CLI flag mapping ({type_name(field.ty)})", "a `#[CLI]` field becomes one `--flag` (and a positional when required); only `Int` (including inline ranges), `Float`, `Bool`, `String`, `Path`, and `T?` of those have a defined shape (nested `#[CLI]` structs and other collection/closure types don't).", "change the field to a supported type, or drop it from the `#[CLI]` struct"))
                    next
                }
                flag_only: sema_registration_cli_arg_option(field.serde_markers, "flag_only")
                if flag_only == .Val(value) && sema_registration_cli_true(value) && kind != SemaRegistrationCLIFieldKind.RequiredOption {
                    diagnostics.push(sema_error("E1309", expr_span(value), "`#Arg(flag_only: true)` on `{field.name}` has nothing to opt out of", "`flag_only: true` keeps a required value field off bare positional input. Bool fields, optional fields (`T?`), and fields with a `{{expr}}` default already stay flag-only.", "remove `flag_only: true`, or make the field a required scalar without a `{{expr}}` default"))
                }
                flag: sema_checked_field_shape_names(definition, field).args
                known_flags: name_count(seen_flags)
                if name_index(name_intern(seen_flags, flag)) < known_flags {
                    diagnostics.push(sema_error("E1306", field.name_span, "two `#[CLI]` fields both derive the flag `--{flag}`", "every field needs a distinct `--flag`; generated commands reserve `--help`, `--allow`, and `--deny`.", "rename the colliding field or choose a non-reserved flag name."))
                }
                sema_registration_cli_short_name(field, short_names, short_fields, diagnostics)
                if kind == SemaRegistrationCLIFieldKind.Flag {
                    env_option: sema_registration_cli_arg_option(field.serde_markers, "env")
                    if env_option == .Val(value) && sema_registration_cli_literal(value) != None {
                        diagnostics.push(sema_registration_e1319("Arg(env:)", field.name, "a `Bool` command field is a presence flag, while `env:` lowers to a value option.", "remove `env:`, or use it on an `Int`, `Float`, `String`, `Path`, or optional value field", expr_span(value)))
                    }
                }
            }
            seen_commands := name_table_sized(definition.methods.len() + definition.cli_bindings.len() + 1)
            command_count := 0
            loop function in definition.methods {
                if sema_computed_field_getter_function(function) -> next
                command_count += 1
                command: unicode.lower(function.name)
                sema_registration_cli_command_word(command, function.name_span, seen_flags, seen_commands, diagnostics)
                receiver := Param?{None}
                loop param in function.params {
                    if param.name == "self" {
                        receiver = Val(param)
                        break
                    }
                }
                if receiver == .Val(self_param) && self_param.convention != AccessConvention.Read {
                    diagnostics.push(sema_error("E1347", self_param.name_span, "a CLI method receiver must be read-only", "shared root flags are parsed into one program value and command dispatch must not mutate that value.", "change the receiver to read-only `self`"))
                }
                sema_registration_cli_callable_params(function, command, None, diagnostics)
            }
            loop binding in definition.cli_bindings {
                command_count += 1
                sema_registration_cli_command_word(unicode.lower(binding.name), binding.name_span, seen_flags, seen_commands, diagnostics)
                foreign_marker := false
                loop marker in binding.markers {
                    if marker.name != MARKER_DOC -> foreign_marker = true
                }
                if foreign_marker {
                    diagnostics.push(sema_registration_e1345(binding.name, binding.name_span, "a callable member accepts `#Doc`, but field-only CLI markers do not apply to bindings"))
                }
                target: sema_registration_cli_binding_target(items, binding.target) ?? {
                    diagnostics.push(sema_registration_e1345(binding.name, expr_span(binding.target), "the binding target must be a function declared in the same program module"))
                    next
                }
                sema_registration_cli_callable_params(target, binding.name, Val(definition.name), diagnostics)
            }
            codable := false
            loop derive_item in definition.derives {
                if owned_trait_codec_marker(derive_item.name) -> codable = true
            }
            if command_count > 0 && codable {
                diagnostics.push(sema_error("E1346", definition.name_span, "callable CLI members cannot be declared on a Codable struct", "CLI commands are behavior, while Codable structs contain only serializable data fields.", "split the command program struct from the Codable data struct"))
            }
        }
    }
}

// `#As`: a struct passes as one stored field where that
// field's type is expected (sema_expression_as_field). A second `#As` field
// is E1129; `#As` on a computed field, which stores no value, is E1131.
sema_registration_as_fields: fn(items: [Item], diagnostics: ^[Diagnostic]) {
    loop item in items {
        if item == .Struct(definition) {
            first := String?{None}
            loop field in definition.fields {
                marker: sema_registration_as_marker(field.serde_markers) ?? next
                if field.computed != None {
                    diagnostics.push(sema_error("E1131", marker.span, "`#As` is on computed field `{field.name}`", "`#As` passes the struct as a stored field's value, and a computed field stores none", "put `#As` on a stored field, or remove it"))
                    next
                }
                if first == .Val(earlier) {
                    diagnostics.push(sema_error("E1129", marker.span, "`{definition.name}` already passes as its field `{earlier}`", "a struct passes as one field, so only one of its fields carries `#As`", "remove `#As` from all but one field"))
                    next
                }
                first = Val(field.name)
            }
        }
    }
}

sema_registration_as_marker: fn(markers: [Marker]) -> Marker? {
    loop marker in markers {
        if marker.name == MARKER_AS -> return Val(marker.copy())
    }
    None
}

// E1318: the field's `#Arg(short:)`, when it is one literal string, is one
// ASCII letter that no earlier field (or the standard pack) already selects.
sema_registration_cli_short_name: fn(field: Field, short_names: ^NameTable, short_fields: ^[String], diagnostics: ^[Diagnostic]) {
    value: sema_registration_cli_arg_option(field.serde_markers, "short") ?? return
    short: sema_registration_cli_literal(value) ?? return
    span: expr_span(value)
    bytes: short.bytes()
    letter := false
    if bytes.len() == 1 {
        code: Int{bytes[0]}
        letter = (code >= 65 && code <= 90) || (code >= 97 && code <= 122)
    }
    if !letter {
        diagnostics.push(sema_error("E1318", span, "`#Arg(short: \"{short}\")` is not a one-letter option", "the shared command parser treats a short option as one ASCII letter.", "use one letter, such as `#Arg(short: \"p\")`"))
        return
    }
    if sema_registration_cli_short_take(short_names, short_fields, short, field.name) == .Val(first) {
        diagnostics.push(sema_error("E1318", span, "`#Arg(short: \"{short}\")` is used by both `{first}` and `{field.name}`", "each short option must select only one `#CLI` field.", "give `{first}` or `{field.name}` a different `short:` value"))
    }
}

// The field that selected short option `short` before `field_name` takes it
// (`names` holds each short option, `fields` its field by id).
sema_registration_cli_short_take: fn(names: ^NameTable, fields: ^[String], short: String, field_name: String) -> String? Never! {
    id: name_index(name_intern(names, short))
    if id == fields.len() {
        fields.push("")
        fields[id] = field_name
        return None
    }
    previous: fields[id]
    fields[id] = field_name
    Val(previous)
}

// E1344: a command word may name neither a root flag nor another command. A
// word that names a root flag is not recorded as a command.
sema_registration_cli_command_word: fn(command: String, span: Span, seen_flags: NameTable, seen_commands: ^NameTable, diagnostics: ^[Diagnostic]) {
    collides := name_find(seen_flags, command) != None
    if !collides {
        known: name_count(seen_commands)
        collides = name_index(name_intern(seen_commands, command)) < known
    }
    if collides {
        diagnostics.push(sema_error("E1344", span, "CLI command `{command}` collides with another command or root flag", "a program struct has one command namespace and one root flag namespace; a word cannot name both.", "rename the command or the root field so every command word is unique"))
    }
}

// A command takes the shared program struct at most once, first and read-only
// (bound members only), and otherwise only scalar or optional scalar,
// non-variadic parameters with literal defaults.
sema_registration_cli_callable_params: fn(function: Func, command: String, shared_type: String?, diagnostics: ^[Diagnostic]) {
    shared_slots := [Int]{}
    if shared_type == .Val(shared_name) {
        loop (index, param) in function.params {
            leaf: sema_registration_cli_named_leaf(param.ty) ?? next
            if leaf == shared_name -> shared_slots.push(index)
        }
        if shared_slots.len() > 1 || (shared_slots.len() == 1 && shared_slots[0] != 0) {
            diagnostics.push(sema_registration_e1345(command, function.name_span, "a bound function may receive the shared program struct only once, as its first parameter"))
        }
    }
    loop (index, param) in function.params {
        if param.name == "self" {
            if shared_type != None {
                diagnostics.push(sema_registration_e1345(command, param.name_span, "a bound function receives shared state as an ordinary first program-struct parameter, not as a method receiver"))
            }
            next
        }
        if shared_slots.contains(index) {
            if param.convention != AccessConvention.Read {
                diagnostics.push(sema_registration_e1345(command, param.name_span, "the shared program-struct parameter must be read-only"))
            }
            next
        }
        if param.variadic || param.variadic_bound_list != None {
            diagnostics.push(sema_registration_e1345(command, param.name_span, "command parameters cannot be variadic; use one scalar or optional scalar parameter per input"))
            next
        }
        if !sema_registration_cli_field_mapped(param.ty) {
            diagnostics.push(sema_registration_e1345(command, param.ty_span, "every command parameter must be a CLI scalar or optional scalar"))
        }
        if param.default == .Val(default) && !sema_registration_cli_literal_default(default) {
            diagnostics.push(sema_registration_e1345(command, param.name_span, "a command default must be a CLI compile-time scalar value"))
        }
    }
}

// A literal Int, Float, Bool or String, under any parentheses.
sema_registration_cli_literal_default: fn(expr: Expr) -> Bool Never! {
    current: sema_registration_cli_without_parens(expr)
    if current == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Str(_, _, _) -> true
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// The last `.` segment of a named type.
sema_registration_cli_named_leaf: fn(ty: Type) -> String? {
    if ty == .Named(name) {
        parts: name.split(".").to_list()
        return Val(parts[parts.len() - 1])
    }
    None
}

// The module function a bound CLI member names.
sema_registration_cli_binding_target: fn(items: [Item], target: Expr) -> Func? {
    current: sema_registration_cli_without_parens(target)
    if current == .Ident(name, _, _) {
        loop item in items {
            if item == .Func(function) && function.name == name -> return Val(function)
        }
    }
    None
}

sema_registration_cli_without_parens: fn(expr: Expr) -> Expr Never! {
    current := expr
    loop {
        if current == .Paren(inner, _, _) -> current = inner else { break }
    }
    current
}

// The first marker named `name`.
sema_registration_cli_marker: fn(markers: [Marker], name: String) -> Marker? {
    loop marker in markers {
        if marker.name == name -> return Val(marker)
    }
    None
}

// The written option of a field's `#Arg(flag_only:, short:,
// env:)` bound to `name`, by label or by position.
sema_registration_cli_arg_option: fn(markers: [Marker], name: String) -> Expr? {
    marker: sema_registration_cli_marker(markers, MARKER_ARG) ?? return None
    parameters: [String]{"flag_only", "short", "env"}
    loop index in 0..<marker.args.len() {
        bound := if index < parameters.len() -> parameters[index] else -> ""
        if index < marker.arg_labels.len() && marker.arg_labels[index] == .Val(label) {
            bound = label.name
        }
        if bound != name -> next
        if marker.args[index] == .Expr(value) -> return Val(value)
        return None
    }
    None
}

// An `#Arg` option's one literal string.
sema_registration_cli_literal: fn(value: Expr) -> String? {
    if value == .Str(parts, _, _) && parts.len() == 1 {
        if parts[0] == .Lit(text) -> return Val(text)
    }
    None
}

sema_registration_cli_true: fn(value: Expr) -> Bool Never! {
    if value == .Bool(written, _, _) -> return written
    false
}

// Whether the field's `#Arg` says `flag_only: true`.
sema_registration_cli_arg_flag_only: fn(markers: [Marker]) -> Bool Never! {
    value: sema_registration_cli_arg_option(markers, "flag_only") ?? return false
    sema_registration_cli_true(value)
}

// The `#Arg` option's text (`short:` or `env:`), when it is one literal string.
sema_registration_cli_arg_text: fn(markers: [Marker], name: String) -> String? {
    value: sema_registration_cli_arg_option(markers, name) ?? return None
    sema_registration_cli_literal(value)
}

// `Bool` is a flag; `T?` of a CLI scalar is an optional option; any other CLI
// scalar is a defaulted or required option.
sema_registration_cli_field_kind: fn(field: Field) -> SemaRegistrationCLIFieldKind? {
    if field.ty == .Bool -> return Val(SemaRegistrationCLIFieldKind.Flag)
    if field.ty == .Option(inner) {
        if sema_registration_cli_scalar(inner) {
            return Val(SemaRegistrationCLIFieldKind.OptionalOption)
        }
        return None
    }
    if !sema_registration_cli_scalar(field.ty) -> return None
    defaulted := field.default != None
    loop marker in field.serde_markers {
        if marker.name == "Default" -> defaulted = true
    }
    if defaulted -> return Val(SemaRegistrationCLIFieldKind.DefaultedOption)
    Val(SemaRegistrationCLIFieldKind.RequiredOption)
}

sema_registration_e1319: fn(marker: String, field: String, why: String, fix: String, span: Span) -> Diagnostic {
    sema_error("E1319", span, "`#{marker}` has no CLI mapping for field `{field}`", why, fix)
}

sema_registration_e1345: fn(name: String, span: Span, why: String) -> Diagnostic {
    sema_error("E1345", span, "CLI command member `{name}` has no callable shape", why, "bind a visible function with scalar parameters and, at most, one first read-only parameter of the program-struct type")
}

// The `#CLI` standard-pack test: `#CLI(Standard)`.
sema_registration_cli_standard: fn(markers: [Marker]) -> Bool Never! {
    loop marker in markers {
        if marker.name != MARKER_CLI -> next
        loop argument in marker.args {
            if argument == .Expr(value) && value == .Ident(name, _, _) && name == "Standard" {
                return true
            }
        }
    }
    false
}

// A CLI scalar, or an optional one.
sema_registration_cli_field_mapped: fn(ty: Type) -> Bool Never! {
    if ty == .Option(inner) -> return sema_registration_cli_scalar(inner)
    sema_registration_cli_scalar(ty)
}

// `Int` (and an inline range), `Float`, `Bool`, `String`, `Path`.
sema_registration_cli_scalar: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .InlineRange(_, _, _) | .Float | .Bool | .String -> true
        .Named(name) -> name == "Path"
        .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// The marker's first argument when it is one literal string.
sema_registration_cli_marker_string: fn(marker: Marker) -> String? {
    if marker.args.len() == 0 -> return None
    if marker.args[0] == .Expr(value) && value == .Str(parts, _, _) && parts.len() == 1 {
        if parts[0] == .Lit(text) -> return Val(text)
    }
    None
}

// On every type that derives a codec explicitly, a container `#Rename(.Case)`
// names one of the closed casing styles (E2409), `#Codable(.Flatten)` needs a
// struct-typed field (E2408), every encoded or decoded field or payload needs a
// wire form (E2411), and every decoded anonymous union needs one distinct outer
// wire shape per member (E2415, or E2411 for a member with no known shape).
// Automatic codecs are selected only for declarations whose fields already
// qualify.
sema_registration_serde_items: fn(items: [Item], diagnostics: ^[Diagnostic]) {
    if !sema_registration_serde_any_explicit(items) {
        return
    }
    // Keyed wire-form questions: one index per module, not a rescan per field.
    facts: sema_derive_item_index(items)
    no_auto: name_table_sized(4)
    loop item in items {
        if item == .Struct(definition) {
            encode: sema_registration_serde_derives(definition.derives, "Encode")
            decode: sema_registration_serde_derives(definition.derives, "Decode")
            if !encode && !decode -> next
            sema_registration_serde_rename_all(definition.serde_markers, diagnostics)
            loop field in definition.fields {
                flatten: sema_serde_items_flattens(field)
                if flatten && !sema_registration_serde_struct_named(field.ty) {
                    diagnostics.push(sema_error("E2408", field.name_span, "`#Codable(.Flatten)` on `{field.name}` needs a struct-typed field", "flatten splices another struct's keys into this object, so the field must be a `#[Codable]` struct — not a primitive, list, or map", "give `{field.name}` a `#[Codable]` struct type, or drop `#Codable(.Flatten)`"))
                    next
                }
                if flatten || sema_serde_items_skips(field) -> next
                if encode {
                    sema_registration_serde_wire_report(sema_registration_serde_wire_form(items, facts, no_auto, field.ty, SemaSerdeDirection.Encode), field.ty, SemaSerdeDirection.Encode, field.name_span, diagnostics)
                }
                if decode {
                    sema_registration_serde_wire_report(sema_registration_serde_wire_form(items, facts, no_auto, field.ty, SemaSerdeDirection.Decode), field.ty, SemaSerdeDirection.Decode, field.name_span, diagnostics)
                }
                if decode {
                    sema_registration_serde_union_shapes(items, field.ty, field.name_span, diagnostics)
                }
            }
        }
        if item == .Enum(definition) {
            encode: sema_registration_serde_derives(definition.derives, "Encode")
            decode: sema_registration_serde_derives(definition.derives, "Decode")
            if !encode && !decode -> next
            sema_registration_serde_rename_all(definition.serde_markers, diagnostics)
            loop variant in definition.variants {
                if variant.payload == {
                    .Unit -> {}
                    .Single(ty, _) -> {
                        if encode {
                            sema_registration_serde_wire_report(sema_registration_serde_wire_form(items, facts, no_auto, ty, SemaSerdeDirection.Encode), ty, SemaSerdeDirection.Encode, variant.name_span, diagnostics)
                        }
                        if decode {
                            sema_registration_serde_wire_report(sema_registration_serde_wire_form(items, facts, no_auto, ty, SemaSerdeDirection.Decode), ty, SemaSerdeDirection.Decode, variant.name_span, diagnostics)
                        }
                        if decode {
                            sema_registration_serde_union_shapes(items, ty, variant.name_span, diagnostics)
                        }
                    }
                    .Named(fields) -> {
                        loop field in fields {
                            if encode {
                                sema_registration_serde_wire_report(sema_registration_serde_wire_form(items, facts, no_auto, field.ty, SemaSerdeDirection.Encode), field.ty, SemaSerdeDirection.Encode, variant.name_span, diagnostics)
                            }
                            if decode {
                                sema_registration_serde_wire_report(sema_registration_serde_wire_form(items, facts, no_auto, field.ty, SemaSerdeDirection.Decode), field.ty, SemaSerdeDirection.Decode, variant.name_span, diagnostics)
                            }
                            if decode {
                                sema_registration_serde_union_shapes(items, field.ty, variant.name_span, diagnostics)
                            }
                        }
                    }
                }
            }
        }
    }
}

// E0930: `#Codable` takes its type options on a type and one form on a
// field. `.Skip` and `.Flatten` belong on a field and the type options on
// the type; `tag:` applies to an enum, whose `.Field(…)` names its key as one
// string.
sema_registration_codable_options: fn(items: [Item], diagnostics: ^[Diagnostic]) {
    loop item in items {
        if item == .Struct(definition) {
            sema_registration_codable_type(item, definition.type_markers, diagnostics)
            loop field in definition.fields {
                sema_registration_codable_field(field.serde_markers, diagnostics)
            }
        }
        if item == .Enum(definition) {
            sema_registration_codable_type(item, definition.type_markers, diagnostics)
        }
        if item == .Distinct(definition) {
            sema_registration_codable_type(item, definition.type_markers, diagnostics)
        }
    }
}

// `item` is the struct, enum or distinct type `markers` mark.
sema_registration_codable_type: fn(item: Item, markers: [Marker], diagnostics: ^[Diagnostic]) {
    marker: codable_marker(markers) ?? return
    is_enum: item == .Enum(_)
    is_distinct: item == .Distinct(_)
    shown: if {
        is_enum -> "an enum"
        is_distinct -> "a distinct type"
        else -> "a struct"
    }
    if codable_form(marker) == .Val(form) {
        diagnostics.push(sema_registration_codable_error(marker, "`.{form}` is a field form of `#Codable`", "`.Skip` and `.Flatten` say how one field rides on the wire, so they go on a field, not on {shown}", "move `#Codable(.{form})` onto the field"))
    }
    if !is_enum && codable_option(marker, CODABLE_TAG) != None {
        diagnostics.push(sema_registration_codable_error(marker, "`tag:` applies to enums only", "`tag:` sets how an enum names its case on the wire, and {shown} has no cases", "remove `tag:`"))
    }
    if is_enum && codable_tag_field(markers) == Val("") {
        diagnostics.push(sema_registration_codable_error(marker, "`tag: .Field(…)` needs its key as one string", "the case name rides under this key in the encoded object", "write the key, as in `tag: .Field(\"kind\")`"))
    }
}

sema_registration_codable_field: fn(markers: [Marker], diagnostics: ^[Diagnostic]) {
    marker: codable_marker(markers) ?? return
    labeled := false
    loop label in marker.arg_labels {
        if label != None -> labeled = true
    }
    if labeled || marker.args.len() != 1 || codable_form(marker) == None {
        diagnostics.push(sema_registration_codable_error(marker, "`#Codable` on a field takes `.Skip` or `.Flatten`", "a field rides on the wire as written, skipped, or flattened; the options `only:`, `unknown:`, `tag:` and `published` belong on the type", "write `#Codable(.Skip)` or `#Codable(.Flatten)` on the field, and the options on the type"))
    }
}

sema_registration_codable_error: fn(marker: Marker, what: String, why: String, fix: String) -> Diagnostic Never! {
    sema_error("E0930", Span{start: marker.name_span.start, end: marker.span.end}, what, why, fix)
}

// E2409: the container casing menu on a type. `#Rename` there takes a
// NamingCase word; an unknown word, a plain name or a string there is refused.
// An argument that is neither a name nor text is the marker signature's problem
// (E0930).
sema_registration_serde_rename_all: fn(markers: [Marker], diagnostics: ^[Diagnostic]) {
    loop marker in markers {
        if marker.name != MARKER_RENAME || marker.negated || marker.args.len() == 0 -> next
        if marker.args[0] == .Expr(argument) {
            written := ""
            if argument == {
                .EnumLit(_, name, _, _, _, _, _) -> {
                    if sema_checked_wire_style_valid(sema_checked_rename_case_word(marker)) -> next
                    written = ".{name}"
                }
                .Ident(name, _, _) -> { written = name.copy() }
                .Str(_, _, _) -> {
                    text: sema_checked_marker_text(marker) ?? next
                    written = "\"{text}\""
                }
                .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) -> {
                    next
                }
            }
            row: sema_diagnostic_row("E2409")
            diagnostics.push(sema_error("E2409", expr_span(argument), row.what.replace("{{style}}", written), row.why.replace("{{style}}", written), row.fix.replace("{{style}}", written)))
        }
    }
}

// Whether any struct or enum derives a codec explicitly (the only
// declarations sema_registration_serde_items checks).
sema_registration_serde_any_explicit: fn(items: [Item]) -> Bool Never! {
    loop item in items {
        if item == {
            .Struct(definition) -> {
                if sema_registration_serde_derives_codec(definition.derives) -> return true
            }
            .Enum(definition) -> {
                if sema_registration_serde_derives_codec(definition.derives) -> return true
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    false
}

// E2411 over encodability and decodability: the generated and written codecs
// are already items here, so no automatic set is needed.
// None when `ty` has the `direction` codec; otherwise the type on its path
// that has none, innermost first (an element, a map value, a wire-reaching
// type argument or a union member, else `ty` itself), with that type's own
// fix. A distinct type this module declares codes as its base: when the base
// has a codec the type was refused one, otherwise the fix is the base's.
sema_registration_serde_wire_form: fn(items: [Item], facts: SemaDeriveItemIndex, no_auto: NameTable, ty: Type, direction: SemaSerdeDirection) -> SemaSerdeLack? Never! {
    trait_name: sema_serde_codec_name(direction)
    if sema_serde_items_codable(items, facts, ty, trait_name, no_auto) -> return None
    if ty == {
        .List(element) | .Option(element) | .Shared(element) | .FixedList(element, _) -> return sema_registration_serde_wire_form(items, facts, no_auto, element, direction)
        .Map(key, _, value) -> {
            if key == Type.String {
                return sema_registration_serde_wire_form(items, facts, no_auto, value, direction)
            }
        }
        .Apply(name, args) -> {
            if sema_serde_items_nominal_codable(items, facts, name, trait_name, no_auto) {
                wire: sema_serde_items_wire_params(items, facts, name)
                loop (index, arg) in args {
                    if wire == .Val(flags) && index < flags.len() && !flags[index] -> next
                    lack: sema_registration_serde_wire_form(items, facts, no_auto, arg, direction) ?? next
                    return Val(lack)
                }
            }
        }
        .Union(members) -> {
            loop member in members {
                lack: sema_registration_serde_wire_form(items, facts, no_auto, member, direction) ?? next
                return Val(lack)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .Float32 | .IntN(_, _) | .Named(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .InlineRange(_, _, _) | .Tagged(_, _) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    shown: sema_type_show_quoted(ty)
    if ty == .Named(name) && sema_derive_nominal_row(facts, name) == .Val(position) && items[position] == .Distinct(definition) {
        fix: if sema_serde_items_codable(items, facts, definition.base, trait_name, no_auto) -> sema_serde_distinct_wire_fix(shown, direction) else -> sema_serde_distinct_base_wire_fix(shown, sema_type_show_quoted(definition.base))
        return Val(SemaSerdeLack{shown: shown, fix: fix})
    }
    fix: sema_serde_wire_fix(shown, direction)
    Val(SemaSerdeLack{shown: shown, fix: fix})
}

// E2411 on `span` for `ty`, whose path holds `lack`, when there is one.
sema_registration_serde_wire_report: fn(lack: SemaSerdeLack?, ty: Type, direction: SemaSerdeDirection, span: Span, diagnostics: ^[Diagnostic]) {
    found: lack ?? return
    shown: sema_type_show_quoted(ty)
    verb: if direction == SemaSerdeDirection.Encode -> "serialized" else -> "decoded"
    diagnostics.push(sema_error("E2411", span, "{shown} can't be {verb}", sema_serde_lack_why(found.shown, shown), found.fix))
}

// E0932: a `#Deprecated` marker needs a public (not package-public) item.
// Functions, type markers, inherent and trait-impl methods, distinct types, and
// impl methods are checked; an inline module body is walked as its own item
// list.
sema_registration_deprecated_visibility: fn(items: [Item], diagnostics: ^[Diagnostic]) {
    loop item in items {
        if item == {
            .Func(function) -> {
                sema_registration_deprecated_markers(function.markers, function.is_pub && !function.is_package_pub, diagnostics)
            }
            .Struct(definition) -> {
                sema_registration_deprecated_markers(definition.type_markers, definition.is_pub && !definition.is_package_pub, diagnostics)
                sema_registration_deprecated_methods(definition.methods, diagnostics)
                loop block in definition.trait_impls {
                    sema_registration_deprecated_methods(block.methods, diagnostics)
                }
            }
            .Enum(definition) -> {
                sema_registration_deprecated_markers(definition.type_markers, definition.is_pub && !definition.is_package_pub, diagnostics)
                sema_registration_deprecated_methods(definition.methods, diagnostics)
                loop block in definition.trait_impls {
                    sema_registration_deprecated_methods(block.methods, diagnostics)
                }
            }
            .Distinct(definition) -> {
                sema_registration_deprecated_markers(definition.type_markers, definition.is_pub && !definition.is_package_pub, diagnostics)
            }
            .Impl(implementation) -> {
                sema_registration_deprecated_methods(implementation.methods, diagnostics)
            }
            .CodeModule(code_module) -> {
                if code_module.body == .Val(body) {
                    sema_registration_deprecated_visibility(body, diagnostics)
                }
            }
            .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

sema_registration_deprecated_methods: fn(methods: [Func], diagnostics: ^[Diagnostic]) {
    loop method in methods {
        sema_registration_deprecated_markers(method.markers, method.is_pub && !method.is_package_pub, diagnostics)
    }
}

// The row's text is the report.
sema_registration_deprecated_markers: fn(markers: [Marker], is_public: Bool, diagnostics: ^[Diagnostic]) {
    if is_public {
        return
    }
    loop marker in markers {
        if marker.name == MARKER_DEPRECATED {
            diagnostics.push(sema_error("E0932", marker.span, "`#Deprecated` requires a public item", "the lifecycle marker retires stable public declarations; an item inside a `priv module` is not part of the public surface", "move the item out of its `priv module`, or remove `#Deprecated`"))
        }
    }
}

sema_registration_has_open_marker: fn(markers: [Marker]) -> Bool Never! {
    loop marker in markers {
        if marker.name == MARKER_OPEN && !marker.negated -> return true
    }
    false
}

// E1137: `#Open` is valid only on public (non-`priv`) enums. Structs,
// distinct types, and private enums (including enums inside a `priv` module)
// are refused before inline module lowering.
sema_registration_open_enum_markers: fn(items: [Item], in_public_module: Bool, diagnostics: ^[Diagnostic]) {
    loop item in items {
        if item == {
            .Struct(definition) -> {
                sema_registration_reject_open_marker(definition.type_markers, "struct", definition.name, false, diagnostics)
            }
            .Distinct(definition) -> {
                sema_registration_reject_open_marker(definition.type_markers, "distinct type", definition.name, false, diagnostics)
            }
            .Enum(definition) -> {
                is_public: in_public_module && definition.is_pub && !definition.is_package_pub
                if !is_public {
                    sema_registration_reject_open_marker(definition.type_markers, "private enum", definition.name, true, diagnostics)
                }
            }
            .CodeModule(code_module) -> {
                if code_module.body == .Val(body) {
                    sema_registration_open_enum_markers(body, in_public_module && code_module.is_pub && !code_module.is_package_pub, diagnostics)
                }
            }
            .Func(_) | .Impl(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

// E0645 for each public item named `__…` that `items` spell (a function the
// compiler generates is its own), inline module bodies walked as their own
// item lists.
sema_registration_dunder_visibility: fn(items: [Item], diagnostics: ^[Diagnostic]) {
    loop item in items {
        if item == {
            .Func(value) -> sema_registration_dunder_report(value.name, value.name_span, value.is_pub && !value.compiler_generated, diagnostics)
            .Struct(value) -> sema_registration_dunder_report(value.name, value.name_span, value.is_pub, diagnostics)
            .Enum(value) -> sema_registration_dunder_report(value.name, value.name_span, value.is_pub, diagnostics)
            .Distinct(value) -> sema_registration_dunder_report(value.name, value.name_span, value.is_pub, diagnostics)
            .TypeAlias(value) -> sema_registration_dunder_report(value.name, value.name_span, value.is_pub, diagnostics)
            .Trait(value) -> sema_registration_dunder_report(value.name, value.name_span, value.is_pub, diagnostics)
            .Tag(value) -> sema_registration_dunder_report(value.name, value.name_span, value.is_pub, diagnostics)
            .UnitFamily(value) -> sema_registration_dunder_report(value.family, value.family_span, value.is_pub, diagnostics)
            .Const(value) -> sema_registration_dunder_report(value.name, value.name_span, value.is_pub, diagnostics)
            .GenericModule(value) -> sema_registration_dunder_report(value.name, value.name_span, value.is_pub, diagnostics)
            .ModuleAlias(value) -> sema_registration_dunder_report(value.name, value.name_span, value.is_pub, diagnostics)
            .ProtocolDecl(value) -> sema_registration_dunder_report(value.name, value.name_span, value.is_pub, diagnostics)
            .MarkerDecl(value) -> sema_registration_dunder_report(value.name, value.name_span, value.is_pub, diagnostics)
            .CodeModule(code_module) -> {
                sema_registration_dunder_report(code_module.name, code_module.name_span, code_module.is_pub, diagnostics)
                if code_module.body == .Val(body) {
                    sema_registration_dunder_visibility(body, diagnostics)
                }
            }
            .Module(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .TemplateLoop(_) | .FactDecl(_) -> {}
        }
    }
}

priv sema_registration_dunder_report: fn(name: String, span: Span, is_pub: Bool, diagnostics: ^[Diagnostic]) {
    if !is_pub || !name.starts_with("__") -> return
    diagnostics.push(sema_error("E0645", span, "`{name}` is a Core machine name, which is `priv`", "a `__` name is Core's machine space: user source can't spell one, so only Core and the code the compiler generates reach it, and it never joins Core's public surface", "declare it `priv {name}`, or give a public item a name without the leading `__`"))
}

sema_registration_reject_open_marker: fn(markers: [Marker], kind: String, name: String, is_private_enum: Bool, diagnostics: ^[Diagnostic]) {
    loop marker in markers {
        if marker.name == MARKER_OPEN {
            why: if is_private_enum -> "`#Open` governs cross-package matches on public enums; a private enum is never matched outside its declaring package" else -> "`#Open` marks a public enum whose variants may grow across releases without breaking external matches"
            fix: if is_private_enum -> "remove `#Open`, or make `{name}` public by removing `priv`" else -> "remove `#Open` from `{name}`"
            diagnostics.push(sema_error("E1137", marker.span, "`#Open` is on {kind} `{name}`, not a public enum", why, fix))
        }
    }
}

sema_registration_serde_derives: fn(derives: [NamedSpan], name: String) -> Bool Never! {
    loop derive_item in derives {
        if derive_item.name == name -> return true
    }
    false
}

sema_registration_serde_derives_codec: fn(derives: [NamedSpan]) -> Bool Never! {
    loop derive_item in derives {
        if owned_trait_codec(derive_item.name) -> return true
    }
    false
}

// A named type that is not a data-tree type.
sema_registration_serde_struct_named: fn(ty: Type) -> Bool Never! {
    if ty == .Named(name) -> return !sema_data_is_json_name(name)
    false
}

// Union decode shapes. The parser writes every union in canonical member order
// (type_union_sort); a nested union is flattened into its members here first.
sema_registration_serde_union_shapes: fn(items: [Item], ty: Type, span: Span, diagnostics: ^[Diagnostic]) {
    if ty == .Union(written) {
        canonical: sema_failure_union_canonical(written)
        if canonical == .Union(members) {
            sema_registration_serde_union_members(items, canonical, members, span, diagnostics)
            loop member in members {
                sema_registration_serde_union_shapes(items, member, span, diagnostics)
            }
            return
        }
        sema_registration_serde_union_shapes(items, canonical, span, diagnostics)
        return
    }
    if ty == {
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .FixedList(inner, _) -> {
            sema_registration_serde_union_shapes(items, inner, span, diagnostics)
        }
        .Map(key, _, value) | .Result(key, value) -> {
            sema_registration_serde_union_shapes(items, key, span, diagnostics)
            sema_registration_serde_union_shapes(items, value, span, diagnostics)
        }
        .Apply(_, args) -> {
            loop arg in args -> sema_registration_serde_union_shapes(items, arg, span, diagnostics)
        }
        .Tuple(fields) -> {
            loop field in fields {
                sema_registration_serde_union_shapes(items, field.ty, span, diagnostics)
            }
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params {
                sema_registration_serde_union_shapes(items, param, span, diagnostics)
            }
            if ret == .Val(value) {
                sema_registration_serde_union_shapes(items, value, span, diagnostics)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .Named(_) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
}

// One canonical union: each member's sorted outer wire shapes; a shape two
// members share is E2415 once per member pair.
sema_registration_serde_union_members: fn(items: [Item], union_ty: Type, members: [Type], span: Span, diagnostics: ^[Diagnostic]) {
    union_shown: sema_type_show(union_ty)
    seen_shapes := [SerdeWireShape]{}
    // The row in `members` of each seen shape's first member.
    seen_members := [Int]{}
    // The member pairs reported, first member's row in the high half.
    reported := [Int]{}
    loop (member_row, member) in members {
        visited := [String]{}
        resolved: jfmt_decode_shapes(items, member, visited)
        member_label: sema_registration_serde_label(member)
        if resolved == None {
            diagnostics.push(sema_error("E2411", span, "union `{union_shown}` can't be decoded — `{member_label}` has no compiler-known wire shape", "`{member_label}` uses a custom or imported decoder; anonymous unions need each member's outer wire shape before codegen", "use a compiler-derived codec, a configured tagged enum, or a `#Codable` distinct type"))
            next
        }
        loop shape in sema_registration_serde_sorted_shapes(resolved) {
            previous := -1
            loop (index, known) in seen_shapes {
                if known == shape {
                    previous = index
                    break
                }
            }
            if previous < 0 {
                seen_shapes.push(shape)
                seen_members.push(member_row)
                next
            }
            first_label: sema_registration_serde_label(members[seen_members[previous]])
            pair: (seen_members[previous] << 32) | member_row
            if reported.contains(pair) -> next
            reported.push(pair)
            diagnostics.push(sema_error("E2415", span, "Union `{union_shown}` can't be decoded — `{first_label}` and `{member_label}` share wire shape `{sema_registration_serde_shape_name(shape)}`", "anonymous-union decode picks a member by wire shape; two members with the same shape would force an arbitrary order", "use a named enum with an explicit tag, or change the members so each has a distinct wire shape"))
        }
    }
}

// The member's `Type.show` with surrounding backticks trimmed.
sema_registration_serde_label: fn(ty: Type) -> String Never! {
    label := sema_type_show(ty)
    loop label.starts_with("`") -> label = label.slice(1, label.len())
    loop label.ends_with("`") -> label = label.slice(0, label.len() - 1)
    label
}

// The wire shape order (each resolved shape set is sorted).
sema_registration_serde_shape_rank: fn(shape: SerdeWireShape) -> Int Never! {
    if shape == {
        .Null -> 0
        .Int -> 1
        .Float -> 2
        .Bool -> 3
        .Text -> 4
        .Array -> 5
        .Object -> 6
        .Number -> 7
    }
}

sema_registration_serde_sorted_shapes: fn(shapes: [SerdeWireShape]) -> [SerdeWireShape] Never! {
    sorted := shapes
    loop index in 1..<sorted.len() {
        current := sorted[index]
        insertion := index - 1
        loop insertion >= 0 && sema_registration_serde_shape_rank(sorted[insertion]) > sema_registration_serde_shape_rank(current) {
            sorted[insertion + 1] = sorted[insertion]
            insertion -= 1
        }
        sorted[insertion + 1] = current
    }
    sorted
}

sema_registration_serde_shape_name: fn(shape: SerdeWireShape) -> String Never! {
    if shape == {
        .Null -> "Null"
        .Int -> "Int"
        .Float -> "Float"
        .Bool -> "Bool"
        .Text -> "Text"
        .Array -> "Array"
        .Object -> "Object"
        .Number -> "Number"
    }
}

sema_registration_import_is_unqualified: fn(declaration: ImportDecl) -> Bool Never! {
    if declaration.kind == {
        .Unqualified(_, _, _, _, _) -> true
        .File(_, _) | .Module(_, _) -> false
    }
}

// Records, for JET_KEEP_GOING, which module rows registered in full: a row
// is settled when no registration-blocking error
// (sema_registration_blocking_diagnostic) lies in one of its source files.
// An error with no source file could belong to any row, so it leaves every
// row unsettled.
sema_registration_settle_modules: fn(graph: ^SemaRegistrationGraph) Never! {
    graph.settled_modules = [Bool]{}
    if graph.internal_problem != None {
        return
    }
    settled := (loop _ in 0..<graph.modules.len() -> true)
    loop diagnostic in graph.diagnostics {
        if !sema_registration_blocking_diagnostic(diagnostic) -> next
        path: diagnostic.source_path ?? return
        loop module_index in 0..<graph.modules.len() {
            loop segment in graph.modules[module_index].source_segments {
                if segment.source_file == path {
                    settled[module_index] = false
                    break
                }
            }
        }
    }
    graph.settled_modules = settled.move()
}

// Whether module row `module_index`'s registered declarations are final: the
// graph is complete, or JET_KEEP_GOING settled the row. Facts a query reads
// from a settled row are known even when the graph is incomplete.
sema_registration_module_settled: fn(graph: SemaRegistrationGraph, module_index: Int) -> Bool Never! {
    if graph.complete -> return true
    module_index >= 0 && module_index < graph.settled_modules.len() && graph.settled_modules[module_index]
}

// sema_registration_module_settled for the row of module `module_id`.
sema_registration_identity_settled: fn(graph: SemaRegistrationGraph, module_id: ModuleID) -> Bool Never! {
    if graph.complete -> return true
    position: module_index(module_id)
    if position >= graph.module_rows.len() || graph.module_rows[position] < 0 -> return false
    sema_registration_module_settled(graph, graph.module_rows[position])
}

// Whether every module row of the package that owns module `module_id` is
// settled (sema_registration_module_settled): an impl for a type may sit in
// any module of the type's package, so an impl query about the type is known
// only when all of them registered in full.
sema_registration_package_settled: fn(graph: SemaRegistrationGraph, module_id: ModuleID) -> Bool Never! {
    if graph.complete -> return true
    position: module_index(module_id)
    if position >= graph.module_rows.len() || graph.module_rows[position] < 0 -> return false
    package: graph.modules[graph.module_rows[position]].package_identity
    loop row in 0..<graph.modules.len() {
        if graph.modules[row].package_identity == package && !sema_registration_module_settled(graph, row) {
            return false
        }
    }
    true
}

// `by_identity`: the row of module `module_id`, None when it has none.
sema_registration_module_index: fn(graph: SemaRegistrationGraph, module_id: ModuleID) -> Int? {
    if graph.counting {
        counters := graph.lookup_counters
        permit: counters.guard_read()
        _: permit.value.module_lookups.add(1)
    }
    position: module_index(module_id)
    if position >= graph.module_rows.len() || graph.module_rows[position] < 0 -> return None
    Val(graph.module_rows[position])
}

// The row of the module whose identity text is `identity`, None when no
// loaded module has it.
sema_registration_module_index_text: fn(graph: SemaRegistrationGraph, identity: String) -> Int? {
    module_id: module_find(graph.module_table, identity) ?? return None
    sema_registration_module_index(graph, module_id)
}

// The ModuleID of identity text `identity`, the none id when no module of the
// graph has it.
sema_registration_module_id: fn(graph: SemaRegistrationGraph, identity: String) -> ModuleID {
    module_find(graph.module_table, identity) ?? module_none()
}

// The graph's lookup counts so far (SemaLookupCounters).
sema_registration_lookup_counts: fn(graph: SemaRegistrationGraph) -> SemaLookupCounts {
    counters := graph.lookup_counters
    permit: counters.guard_read()
    SemaLookupCounts{module_lookups: permit.value.module_lookups.load(), name_lookups: permit.value.name_lookups.load(), scope_lookups: permit.value.scope_lookups.load(), scope_compares: permit.value.scope_compares.load()}
}

// The registered module NAME (`core.term`) of module `module_id` (its Core
// module identity for a Core module).
sema_registration_module_name: fn(graph: SemaRegistrationGraph, module_id: ModuleID) -> String? {
    index: sema_registration_module_index(graph, module_id) ?? return None
    Val(graph.modules[index].module_name)
}

sema_registration_push_graph_diagnostic: fn(graph: ^SemaRegistrationGraph, module_index: Int, diagnostic: Diagnostic) Never! {
    if {
        module_index >= 0 && module_index < graph.modules.len() -> {
            // copy: the graph's diagnostics list owns the located row, while `diagnostic` is the
            // caller's row (a read parameter), still used below.
            graph.diagnostics.push(sema_diagnostic_with_source_location(diagnostic.copy(), graph.modules[module_index].source_segments))
        }
        else -> { graph.diagnostics.push(diagnostic.copy()) }
    }
}

sema_registration_import_visibility: fn(declaration: ImportDecl) -> Int Never! {
    sema_registration_visibility(declaration.is_pub, declaration.is_package_pub)
}

sema_registration_import_local: fn(item: ImportedItem) -> String Never! {
    if item.alias == .Val(alias) -> return alias
    parts: item.original.split(".").to_list()
    parts[parts.len() - 1]
}

sema_registration_direct_symbol: fn(module_row: SemaRegistrationModule, name: String) -> SemaRegistrationExport? {
    // The module's own declarations first: they carry the live symbol (a constant's staged type
    // lands on it after registration), while an export row holds a registration-time copy. A
    // module's symbol names are distinct, so its position map finds the one row of `name`.
    if sema_registration_symbol_position(module_row, name, name_text_hash(name)) == .Val(index) {
        sym: module_row.symbols[index]
        declaration_position: sema_registration_declaration_position(module_row, sym)
        is_const: sym.kind == SymbolKind.Constant
        export_symbol: if is_const -> sym else -> Symbol{id: sym.id, kind: sym.kind, name: sym.name, module_identity: sym.module_identity, owner: sym.owner, span: sym.span, ty: None, visibility: sym.visibility}
        row_ref: if is_const -> -1 else -> index
        return Val(SemaRegistrationExport{name: name, symbol: export_symbol, declaration_position: declaration_position, source_module_identity: module_row.module_identity, visibility: sym.visibility, target_symbol_row: row_ref})
    }
    loop export in module_row.exports {
        if export.name == name -> return Val(export)
    }
    None
}

// A Core module's public surface is its `module core.X exports {…}` row in
// Compiler/Prelude/Core.rows, not its source visibility: every Core item is
// public by default. Code outside Core reaches
// only the names that row lists, or a Core submodule; the rest (a handle
// struct such as `SqliteDB { raw }`, a host leaf, an internal constant) is
// Core's own. Core itself reaches every Core item. A dotted member
// (`use core.[math.abs]`) is checked against its own module's row. A
// function that fills a role (CoreRoles.jet) is reached through that role
// by the code the compiler generates into any module, so no row lists it;
// its own visibility still decides who reaches it.
sema_registration_core_private: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, name: String, requester_module: ModuleID) -> Bool {
    if !module_is_core(module_row.module_identity) || module_is_core(requester_module) {
        return false
    }
    owner := module_row.module_name.copy()
    leaf := name.copy()
    if name.cut_last(".") == .Val(parts) {
        owner = "{owner}.{parts.before}"
        leaf = parts.after.copy()
    }
    if core_module_export(owner) == None -> return false
    if core_module_has_member(owner, leaf) || core_module_has_type(owner, leaf) || core_module_export("{owner}.{leaf}") != None {
        return false
    }
    !sema_core_role_filler(graph, module_row, name)
}

sema_registration_core_private_error: fn(name: String, module_name: String, span: Span) -> Diagnostic {
    sema_error("E0609", span, "`{name}` is private in module `{module_name}`", "a Core module's API is the names it exports; its other types and helpers belong to Core alone", "use what `{module_name}` exports instead")
}

// Whether `module_row` declares a child module `name` (`name: module` /
// `priv(package) name: module`), whether or not the requester may see it.
sema_registration_module_declares_child: fn(module_row: SemaRegistrationModule, name: String) -> Bool Never! {
    loop import in module_row.imports {
        if import.declaration.kind == {
            .File(_, _) | .Module(_, _) -> {
                if import.declaration.alias == name -> return true
            }
            .Unqualified(_, _, _, _, _) -> {}
        }
    }
    false
}

// The Core module behind `alias` when `alias.name` names a declaration that
// module keeps private from `module_identity`: the qualified spelling of an
// import the E0609 above refuses (`db.SqliteDB{raw: 1}`).
sema_registration_core_private_qualified: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, alias: String, name: String) -> String? {
    module_index: sema_registration_module_index(graph, module_identity) ?? return None
    loop import in graph.modules[module_index].imports {
        if import.declaration.alias != alias || sema_registration_file_import_taken_over(graph.modules[module_index], import) {
            next
        }
        target_index: sema_registration_module_index(graph, import.target_module_identity) ?? return None
        target: graph.modules[target_index]
        if !sema_registration_core_private(graph, target, name, module_identity) -> return None
        if sema_registration_lookup_name_at(graph, target_index, target.module_identity, name) == None {
            return None
        }
        return Val(target.module_name.copy())
    }
    None
}

// The `alias.child` path when `alias.child.…` reaches into a `priv module`
// `child` that the module imported as `alias` declares: only that module
// (and, for `priv(package)`, its package) may name what it holds.
sema_registration_private_module_path: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, name: String) -> String? {
    qualified: name.split_once(".") ?? return None
    nested: qualified.after.split_once(".") ?? return None
    module_index: sema_registration_module_index(graph, module_identity) ?? return None
    loop import in graph.modules[module_index].imports {
        if import.declaration.alias != qualified.before || sema_registration_file_import_taken_over(graph.modules[module_index], import) {
            next
        }
        target_index: sema_registration_module_index(graph, import.target_module_identity) ?? return None
        if target_index == module_index -> return None
        loop declaration in graph.modules[target_index].declarations {
            if declaration == .CodeModule(definition) {
                if definition.name != nested.before || definition.body == None || definition.is_pub {
                    next
                }
                if definition.is_package_pub && graph.modules[target_index].package_identity == graph.modules[module_index].package_identity {
                    return None
                }
                return Val("{qualified.before}.{nested.before}")
            }
        }
        return None
    }
    None
}

sema_registration_private_module_error: fn(path: String, span: Span) -> Diagnostic {
    sema_error("E0605", span, "`{path}` is private to its module", "a `priv module` is usable only by its enclosing module (`priv(package)`: by its package), and a `priv` field only by its type's module", "use what `{path}` holds from inside its enclosing module, or remove `priv` from the module")
}

// Whether `alias.member` names a declaration that the source module imported
// as `alias` keeps private from `module_identity` (`geo.Secret` for a
// `priv Secret: struct` of the file module `geo`). Core modules keep their
// own route (sema_registration_core_private_qualified).
sema_registration_private_member: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, alias: String, member: String) -> Bool Never! {
    module_index: sema_registration_module_index(graph, module_identity) ?? return false
    loop import in graph.modules[module_index].imports {
        if import.declaration.alias != alias || sema_registration_file_import_taken_over(graph.modules[module_index], import) {
            next
        }
        target_index: sema_registration_module_index(graph, import.target_module_identity) ?? return false
        target: graph.modules[target_index]
        if target_index == module_index || module_is_core(target.module_identity) -> return false
        declared: sema_registration_direct_symbol(target, member) ?? return false
        return !sema_registration_visible(declared.visibility, module_identity, graph.modules[module_index].package_identity, target.module_identity, target.package_identity)
    }
    false
}

// E0605 for `member`, a `priv` declaration of module `owner` used outside
// that module and its children.
sema_registration_private_member_error: fn(member: String, owner: String, span: Span) -> Diagnostic Never! {
    sema_error("E0605", span, "`{member}` is private to module `{owner}`", "a `priv` declaration is usable only inside the module that declares it and that module's children", "use `{member}` from inside `{owner}`, or remove `priv` from it")
}

sema_registration_resolve_export: fn(graph: SemaRegistrationGraph, module_index: Int, name: String, requester_module: ModuleID, requester_package: String, seen: [String]) -> SemaRegistrationExport? {
    if module_index < 0 || module_index >= graph.modules.len() -> return None
    module_row: graph.modules[module_index]
    if seen.len() == 0 {
        if sema_registration_core_private(graph, module_row, name, requester_module) -> return None
        direct: sema_registration_direct_symbol(module_row, name)
        if direct == .Val(export) {
            if sema_registration_visible(export.visibility, requester_module, requester_package, module_row.module_identity, module_row.package_identity) {
                return Val(export)
            }
            return None
        }
        next_seen := [String]{"{module_index}:{name}"}
        return sema_registration_resolve_export_indirect(graph, module_index, name, requester_module, requester_package, next_seen)
    }
    key: "{module_index}:{name}"
    loop previous in seen {
        if previous == key -> return None
    }
    next_seen := seen
    next_seen.push(key)
    if sema_registration_core_private(graph, module_row, name, requester_module) -> return None
    direct: sema_registration_direct_symbol(module_row, name)
    if direct == .Val(export) {
        if sema_registration_visible(export.visibility, requester_module, requester_package, module_row.module_identity, module_row.package_identity) {
            return Val(export)
        }
        return None
    }
    sema_registration_resolve_export_indirect(graph, module_index, name, requester_module, requester_package, next_seen)
}

sema_registration_resolve_export_indirect: fn(graph: SemaRegistrationGraph, module_index: Int, name: String, requester_module: ModuleID, requester_package: String, next_seen: [String]) -> SemaRegistrationExport? {
    module_row: graph.modules[module_index]
    loop import in module_row.imports {
        if !import.declaration.is_pub && !import.declaration.is_package_pub -> next
        target_index: sema_registration_module_index(graph, import.target_module_identity) ?? next
        if import.declaration.kind == {
            .Unqualified(_, _, items, _, _) -> {
                loop item in items {
                    local: sema_registration_import_local(item)
                    if local != name -> next
                    resolved: sema_registration_resolve_export(graph, target_index, item.original, module_row.module_identity, module_row.package_identity, next_seen) ?? next
                    if !sema_registration_visible(resolved.visibility, module_row.module_identity, module_row.package_identity, resolved.source_module_identity, graph.modules[target_index].package_identity) {
                        next
                    }
                    return Val(SemaRegistrationExport{name: name, symbol: resolved.symbol, declaration_position: resolved.declaration_position, source_module_identity: resolved.source_module_identity, visibility: if import.declaration.is_pub -> 2 else -> 1, target_symbol_row: resolved.target_symbol_row})
                }
            }
            .File(_, _) | .Module(_, _) -> {
                if import.declaration.alias != name || sema_registration_file_import_taken_over(module_row, import) {
                    next
                }
                visibility: if import.declaration.is_pub -> 2 else -> 1
                if !sema_registration_visible(visibility, requester_module, requester_package, module_row.module_identity, module_row.package_identity) {
                    return None
                }
                module_row_text: module_text(graph.module_table, module_row.module_identity)
                id: symbol_find(graph.symbols, symbol_key_text(SymbolKind.Import, module_row_text, module_text(graph.module_table, import.target_module_identity), name)) ?? panic("the module import `{name}` of `{module_row_text}` has no symbol (sema_registration_mint_module_imports)")
                symbol: Symbol{id: id, kind: SymbolKind.Import, name: name.copy(), module_identity: module_row.module_identity, owner: None, span: import.declaration.alias_span, ty: None, visibility: visibility}
                return Val(SemaRegistrationExport{name: name.copy(), symbol: symbol.move(), declaration_position: None, source_module_identity: import.target_module_identity, visibility: visibility})
            }
        }
    }
    // A dependency package is bound through one member file;
    // a name belongs to whichever member of that package declares it.
    if sema_registration_package_is_namespace(module_row.package_identity) {
        loop (sibling_index, sibling) in graph.modules {
            if sibling_index == module_index || sibling.package_identity != module_row.package_identity {
                next
            }
            owned: sema_registration_direct_symbol(sibling, name) ?? next
            if sema_registration_visible(owned.visibility, requester_module, requester_package, sibling.module_identity, sibling.package_identity) {
                return Val(owned)
            }
            return None
        }
    }
    // Core's authoritative export ledger also owns runtime builtin carriers
    // that have no source nominal declaration. Keep their builtin identity,
    // and never apply this rule to a user module with a Core-like name. No
    // registration declares such a carrier, so its symbol is none.
    private_native: module_is_core(requester_module) && (sema_reserved_type_name(name) || core_record_literal_fields(name) != None)
    if module_is_core(module_row.module_identity) && (core_module_has_type(module_row.module_name, name) || private_native) {
        id: symbol_find(graph.symbols, symbol_key_text(SymbolKind.Type, module_text(graph.module_table, module_row.module_identity), "", name)) ?? symbol_none()
        visibility: sema_registration_visibility(true, false)
        symbol: Symbol{id: id, kind: SymbolKind.Type, name: name, module_identity: module_row.module_identity, owner: None, span: Span{start: 0, end: 0}, ty: Val(Type.Named{name: name}), visibility: visibility}
        return Val(SemaRegistrationExport{name: name, symbol: symbol, declaration_position: None, source_module_identity: module_row.module_identity, visibility: visibility})
    }
    None
}

// The loader emits one edge per source import, including each import declared
// inside an inline `name: module { … }` body (its `source_scope`), so every
// such declaration is a source declaration of its file.
sema_registration_span_key: fn(span: Span) -> Int Never! {
    span.start * 4294967296 + span.end
}

sema_registration_declared_import_spans: fn(imports: [ImportDecl], items: [Item], spans: ^[Int:Bool]) Never! {
    loop declaration in imports {
        spans[sema_registration_span_key(declaration.span)] = true
    }
    loop item in items {
        if item == .CodeModule(code_module) && code_module.body == .Val(body) {
            sema_registration_declared_import_spans(code_module.imports, body, spans)
        }
    }
}

// A C library import (`use c.lib`, `use x: c.lib`, `use c.[lib, …]`)
// binds its one library alias to the synthetic `__c_{lib}` module, as a
// qualified module import does, whichever spelling named it.
sema_registration_foreign_import_declaration: fn(edge: SemaRegistrationImportEdge) -> ImportDecl Never! {
    declaration := edge.declaration
    binding: edge.foreign_binding ?? return declaration
    alias_span := declaration.alias_span
    module_name := ""
    if edge.declaration.kind == .Unqualified(module_alias, _, items, _, _) {
        loop (index, item) in items {
            if sema_registration_import_local(item) == binding.alias && index < edge.declaration.local_spans.len() {
                alias_span = edge.declaration.local_spans[index]
            }
        }
        module_name = "{module_alias}.{binding.alias}"
    }
    if module_name != "" {
        declaration.kind = ImportKind.Module{name: module_name, span: edge.declaration.span}
    }
    declaration.alias = binding.alias
    declaration.alias_span = alias_span
    declaration
}

// The imports registered so far, per source module: every alias by packed
// span key (`span_aliases`; a C library span registers one per library),
// and for module (qualified) imports each module-scope alias in `aliases`
// and each inline-module alias in `scoped_aliases`, by (scope, alias) pair
// slot over `scope_names` (name_pair_slot): zero string formatting.
SemaRegistrationImportIndex: struct {
    span_aliases: [[Int:[String]]],
    aliases: [NameTable],
    scope_names: NameTable,
    scoped_aliases: [[Int:Bool]],
}

sema_registration_import_index: fn(module_count: Int) -> SemaRegistrationImportIndex Never! {
    span_aliases := [[Int:[String]]]{}
    aliases := [NameTable]{}
    scoped_aliases := [[Int:Bool]]{}
    loop _ in 0..<module_count {
        span_aliases.push([Int:[String]]{})
        aliases.push(name_table_sized(8))
        scoped_aliases.push([Int:Bool]{})
    }
    SemaRegistrationImportIndex{span_aliases: span_aliases.move(), aliases: aliases.move(), scope_names: name_table_sized(4), scoped_aliases: scoped_aliases.move()}
}

sema_registration_add_import: fn(graph: ^SemaRegistrationGraph, registered: ^SemaRegistrationImportIndex, source_index: Int, scope: String, declaration: ImportDecl, target_identity: ModuleID, target_package: String) {
    source_identity := graph.modules[source_index].module_identity
    source_package := graph.modules[source_index].package_identity
    visibility: sema_registration_import_visibility(declaration)
    // A span registers once per alias: one `use c.[a, b]` declaration
    // registers one library-module import per C library it names.
    skey: sema_registration_span_key(declaration.span)
    if registered.span_aliases[source_index].get(skey) == .Val(span_aliases) && span_aliases.contains(declaration.alias) {
        sema_registration_push_graph_diagnostic(graph, source_index, sema_defined_twice(declaration.alias, "an import declaration must be registered once", declaration.span))
        return
    }
    qualified: !sema_registration_import_is_unqualified(declaration)
    // A C library alias written in an inline module (`m: module { use lib: c.m }`)
    // lives in that module's scope: sibling modules may reuse the alias.
    if qualified {
        alias_dup: if scope == "" -> name_find(registered.aliases[source_index], declaration.alias) != None else -> registered.scoped_aliases[source_index].get(name_pair_slot(registered.scope_names, scope, declaration.alias)) != None
        if alias_dup {
            sema_registration_push_graph_diagnostic(graph, source_index, sema_defined_twice(declaration.alias, "module imports share one namespace alias", declaration.alias_span))
            return
        }
        if sema_registration_module_has_name(graph.modules[source_index], declaration.alias) {
            sema_registration_push_graph_diagnostic(graph, source_index, sema_defined_twice(declaration.alias, "an import alias shares the module namespace", declaration.alias_span))
            return
        }
    }
    if registered.span_aliases[source_index].get(skey) == None -> registered.span_aliases[source_index][skey] = [String]{}
    registered.span_aliases[source_index][skey].push(declaration.alias)
    if qualified {
        if scope == "" {
            _ := name_intern(registered.aliases[source_index], declaration.alias)
        } else {
            registered.scoped_aliases[source_index][name_pair_slot(registered.scope_names, scope, declaration.alias)] = true
        }
    }
    graph.modules[source_index].imports.push(SemaRegistrationImport{source_module_identity: source_identity, source_package_identity: source_package, target_module_identity: target_identity, target_package_identity: target_package, declaration: declaration, visibility: visibility, bindings: [SemaRegistrationImportBinding]{}})
}

// Resolve each exact identity once per pass, including known absences (-1).
// The cache belongs to one graph with a fixed module order; import bindings
// retain their answer through graph clones and staged value application.
sema_registration_cached_module_index: fn(graph: SemaRegistrationGraph, identity: ModuleID, indices: ^[Int]) -> Int? {
    position: module_index(identity)
    loop indices.len() <= position -> indices.push(-2)
    if indices[position] != -2 {
        return if indices[position] < 0 -> None else -> Val(indices[position])
    }
    index: sema_registration_module_index(graph, identity)
    indices[position] = index ?? -1
    index
}

// `import_module_indices` caches each import target's row by ModuleID index
// (sema_registration_cached_module_index).
sema_registration_populate_imports: fn(graph: ^SemaRegistrationGraph, module_index: Int, import_module_indices: ^[Int]) {
    source_identity := graph.modules[module_index].module_identity
    source_text: module_text(graph.module_table, source_identity)
    source_package := graph.modules[module_index].package_identity
    import_count: graph.modules[module_index].imports.len()
    // The package names bind after this module's own
    // declarations and the imports before `namespace_from`; an import after
    // it (a foreign provider) can't take a package name.
    namespace_from: if graph.modules[module_index].namespace_import_split < 0 -> import_count else -> graph.modules[module_index].namespace_import_split
    loop import_index in 0..<import_count {
        if import_index == namespace_from {
            sema_registration_namespace_collisions(graph, module_index, import_index)
        }
        namespace_binds: import_index >= namespace_from
        declaration := graph.modules[module_index].imports[import_index].declaration
        target_identity := graph.modules[module_index].imports[import_index].target_module_identity
        target_index: sema_registration_cached_module_index(graph, target_identity, import_module_indices) ?? {
            sema_registration_push_graph_diagnostic(graph, module_index, sema_error("E0003", declaration.span, "the import target is not in the declaration graph", "qualified imports resolve through the exact loaded module identity", "retain the loader's source and module identity for this import"))
            next
        }
        // Only the target's name is kept: a whole-module copy per import made
        // registration imports × module size (the AST rides in the row).
        target_name: graph.modules[target_index].module_name.copy()
        if declaration.kind == {
            .Unqualified(_, _, items, _, _) -> {
                loop item in items {
                    local: sema_registration_import_local(item)
                    // A member naming a Core submodule (`use core.mem`,
                    // `core.encoding.[json]`) binds that module as a namespace,
                    // exactly like `use mem: core.mem`.
                    submodule: "{target_name}.{item.original}"
                    if (target_name == "core" || target_name.starts_with("core.")) && core_module_export(submodule) != None {
                        if sema_registration_module_has_name(graph.modules[module_index], local) || sema_registration_module_has_import_name(graph.modules[module_index], local) {
                            twice: sema_registration_import_twice(graph.modules[module_index], declaration, local, declaration.span)
                            sema_registration_push_graph_diagnostic(graph, module_index, twice)
                            next
                        }
                        import_visibility: graph.modules[module_index].imports[import_index].visibility
                        // A Core submodule binding names its module (`core.mem`), interned
                        // beside the loaded identities; a module not loaded has no row.
                        submodule_identity: module_intern(graph.module_table, submodule)
                        module_symbol: Symbol{id: symbol_mint(graph.symbols, SymbolKind.Import, source_text, submodule, local), kind: SymbolKind.Import, name: local, module_identity: submodule_identity, owner: None, span: declaration.span, ty: None, visibility: import_visibility}
                        submodule_index: sema_registration_core_unit_index(graph, submodule)
                        sema_registration_push_import_binding(graph, module_index, import_index, SemaRegistrationImportBinding{original: item.original, local: local, symbol: module_symbol, declaration_position: None, target_module_identity: submodule_identity, target_module_index: submodule_index, visibility: import_visibility})
                        next
                    }
                    // A dependency package is one namespace: a member its import landed on stands for
                    // the package, so a name another member file declares resolves through that file.
                    export_index := target_index
                    // (The namespace table, not the owner's symbol index: imports resolve before that
                    // index exists.)
                    if sema_registration_direct_symbol(graph.modules[target_index], item.original) == None {
                        slot: graph.modules[target_index].namespace_slot
                        if slot >= 0 {
                            if sema_registration_namespace_entry_hashed(graph, slot, item.original, name_text_hash(item.original)) == .Val(entry) {
                                export_index = graph.namespace_entry_modules[entry]
                            }
                        }
                    }
                    resolved: sema_registration_resolve_export(graph, export_index, item.original, source_identity, source_package, [String]{})
                    if resolved == {
                        .Val(export) -> {
                            duplicate: sema_registration_module_has_name(graph.modules[module_index], local) || sema_registration_module_has_import_name(graph.modules[module_index], local) || (namespace_binds && sema_registration_namespace_function_conflict(graph, module_index, local, item.original, export.source_module_identity))
                            if {
                                duplicate -> {
                                    twice: sema_registration_import_twice(graph.modules[module_index], declaration, local, declaration.span)
                                    sema_registration_push_graph_diagnostic(graph, module_index, twice)
                                }
                                else -> {
                                    origin_index: sema_registration_cached_module_index(graph, export.source_module_identity, import_module_indices)
                                    if declaration.is_pub || declaration.is_package_pub {
                                        reexport_symbol: Symbol{id: export.symbol.id, kind: export.symbol.kind, name: local, module_identity: export.symbol.module_identity, owner: export.symbol.owner, span: export.symbol.span, ty: export.symbol.ty, visibility: export.symbol.visibility}
                                        graph.modules[module_index].exports.push(SemaRegistrationExport{name: local, symbol: reexport_symbol, declaration_position: export.declaration_position, source_module_identity: export.source_module_identity, visibility: if declaration.is_pub -> 2 else -> 1, target_symbol_row: export.target_symbol_row})
                                    }
                                    target_row := export.target_symbol_row
                                    if target_row < 0 && origin_index == .Val(owner_idx) && export.symbol.kind != SymbolKind.Constant {
                                        if sema_registration_symbol_position(graph.modules[owner_idx], export.symbol.name, name_text_hash(export.symbol.name)) == .Val(row) && graph.modules[owner_idx].symbols[row].id == export.symbol.id {
                                            target_row = row
                                        } else if item.original != export.symbol.name && sema_registration_symbol_position(graph.modules[owner_idx], item.original, name_text_hash(item.original)) == .Val(row) && graph.modules[owner_idx].symbols[row].id == export.symbol.id {
                                            target_row = row
                                        }
                                    }
                                    binding_symbol: if {
                                        target_row >= 0 -> Symbol{id: export.symbol.id, kind: export.symbol.kind, name: local, module_identity: export.symbol.module_identity, owner: export.symbol.owner, span: export.symbol.span, ty: None, visibility: export.symbol.visibility}
                                        else -> Symbol{id: export.symbol.id, kind: export.symbol.kind, name: local, module_identity: export.symbol.module_identity, owner: export.symbol.owner, span: export.symbol.span, ty: sema_registration_export_ty(graph, export), visibility: export.symbol.visibility}
                                    }
                                    sema_registration_push_import_binding(graph, module_index, import_index, SemaRegistrationImportBinding{original: item.original, local: local, symbol: binding_symbol, declaration_position: export.declaration_position, target_module_identity: export.source_module_identity, target_module_index: origin_index, target_symbol_row: target_row, visibility: export.visibility})
                                }
                            }
                        }
                        .None -> {
                            // A Core module's ledger member with no source
                            // declaration (a host leaf such as
                            // `core.files.__directory_fd`) binds as a Core item
                            // import, also inside its own module. Its symbol is
                            // Foreign (no Jet declaration); calls route through
                            // the module's Core call records (Calls/Direct.jet).
                            if (target_name == "core" || target_name.starts_with("core.")) && core_module_has_member(target_name, item.original) && sema_registration_direct_symbol(graph.modules[target_index], item.original) == None {
                                if sema_registration_module_has_name(graph.modules[module_index], local) || sema_registration_module_has_import_name(graph.modules[module_index], local) || (namespace_binds && sema_registration_namespace_function_owner(graph, module_index, local)) {
                                    twice: sema_registration_import_twice(graph.modules[module_index], declaration, local, declaration.span)
                                    sema_registration_push_graph_diagnostic(graph, module_index, twice)
                                    next
                                }
                                leaf_identity: graph.modules[target_index].module_identity
                                leaf_text: module_text(graph.module_table, leaf_identity)
                                import_visibility: graph.modules[module_index].imports[import_index].visibility
                                leaf_symbol: Symbol{id: symbol_mint(graph.symbols, SymbolKind.Foreign, leaf_text, "", item.original), kind: SymbolKind.Foreign, name: local, module_identity: leaf_identity, owner: None, span: declaration.span, ty: None, visibility: import_visibility}
                                sema_registration_push_import_binding(graph, module_index, import_index, SemaRegistrationImportBinding{original: item.original, local: local, symbol: leaf_symbol, declaration_position: None, target_module_identity: leaf_identity, target_module_index: Val(target_index), visibility: import_visibility})
                                next
                            }
                            direct: sema_registration_direct_symbol(graph.modules[target_index], item.original)
                            private_template := false
                            // An item its own declaration keeps private (`priv`) gets the
                            // ordinary error below whether Core or a package declares it.
                            declared_private := false
                            if direct == .Val(private_export) {
                                if private_export.declaration_position == .Val(position) {
                                    owner: sema_registration_module_index(graph, private_export.source_module_identity) ?? -1
                                    if owner >= 0 && graph.modules[owner].declarations[position] == .GenericModule(_) {
                                        private_template = true
                                    }
                                }
                                declared_private = !sema_registration_visible(private_export.visibility, source_identity, source_package, graph.modules[target_index].module_identity, graph.modules[target_index].package_identity)
                            }
                            if {
                                private_template -> {
                                    sema_registration_push_graph_diagnostic(graph, module_index, sema_error("E0609", declaration.span, "`{item.original}` is private in module `{target_name}`", "only public items can be brought into scope with `use`", "remove `priv` from `{item.original}: module` in the defining file"))
                                }
                                direct != None && !declared_private && sema_registration_core_private(graph, graph.modules[target_index], item.original, source_identity) -> {
                                    sema_registration_push_graph_diagnostic(graph, module_index, sema_registration_core_private_error(item.original, target_name, declaration.span))
                                }
                                direct != None -> {
                                    sema_registration_push_graph_diagnostic(graph, module_index, sema_error("E0609", declaration.span, "`{item.original}` is private in module `{target_name}`", "only visible declarations can be selected through an import", "make the declaration public or keep the use in its defining module"))
                                }
                                sema_registration_module_declares_child(graph.modules[export_index], item.original) -> {
                                    sema_registration_push_graph_diagnostic(graph, module_index, sema_error("E0609", declaration.span, "`{item.original}` is private in module `{target_name}`", "a `priv module` is usable only by its enclosing module, and a `priv(package) module` only by its own package", "use what `{target_name}` makes public, or import `{item.original}` from inside its package"))
                                }
                                else -> {
                                    sema_registration_push_graph_diagnostic(graph, module_index, sema_error("E0611", declaration.span, "`{item.original}` is not defined in module `{target_name}`", "an import member must name one registered declaration", "declare or import the member before selecting it"))
                                }
                            }
                        }
                    }
                }
            }
            // A file whose same-named item this module takes binds no name.
            .File(_, _) | .Module(_, _) -> {
                if !sema_registration_file_import_taken_over(graph.modules[module_index], graph.modules[module_index].imports[import_index]) {
                    duplicate: sema_registration_module_has_name(graph.modules[module_index], declaration.alias) || sema_registration_module_has_import_name(graph.modules[module_index], declaration.alias)
                    if {
                        duplicate -> {
                            twice: sema_registration_import_twice(graph.modules[module_index], declaration, declaration.alias, declaration.alias_span)
                            sema_registration_push_graph_diagnostic(graph, module_index, twice)
                        }
                        else -> {
                            import_visibility: graph.modules[module_index].imports[import_index].visibility
                            target_text: module_text(graph.module_table, target_identity)
                            module_symbol: Symbol{id: symbol_find(graph.symbols, symbol_key_text(SymbolKind.Import, source_text, target_text, declaration.alias)) ?? panic("the module import `{declaration.alias}` of `{source_text}` has no symbol (sema_registration_mint_module_imports)"), kind: SymbolKind.Import, name: declaration.alias, module_identity: target_identity, owner: None, span: declaration.alias_span, ty: None, visibility: import_visibility}
                            sema_registration_push_import_binding(graph, module_index, import_index, SemaRegistrationImportBinding{original: target_name, local: declaration.alias, symbol: module_symbol, declaration_position: None, target_module_identity: target_identity, target_module_index: Val(target_index), visibility: import_visibility})
                        }
                    }
                }
            }
        }
    }
    if namespace_from >= import_count {
        sema_registration_namespace_collisions(graph, module_index, import_count)
    }
}

// The id of each file or module import's binding of the module at
// `module_index`. A module that re-exports one
// (sema_registration_resolve_export) may be read before its own imports
// populate, so every module's are minted first, in module order.
sema_registration_mint_module_imports: fn(graph: ^SemaRegistrationGraph, module_index: Int) {
    source_text: module_text(graph.module_table, graph.modules[module_index].module_identity)
    keys := [String]{}
    loop import in graph.modules[module_index].imports {
        if import.declaration.kind == .Unqualified(_, _, _, _, _) -> next
        keys.push(symbol_key_text(SymbolKind.Import, source_text, module_text(graph.module_table, import.target_module_identity), import.declaration.alias))
    }
    loop key in keys -> _ := symbol_intern(graph.symbols, key)
}

// The id of each `#Test` block's synthetic function in the module at
// `module_index` (sema_check_test_function), keyed checked_test_artifact_key.
sema_registration_mint_tests: fn(graph: ^SemaRegistrationGraph, module_index: Int) {
    source_text: module_text(graph.module_table, graph.modules[module_index].module_identity)
    keys := [String]{}
    loop item in graph.modules[module_index].program.items {
        if item == .Test(test) -> keys.push(checked_test_artifact_key(source_text, test))
    }
    loop key in keys -> _ := symbol_intern(graph.symbols, key)
}

// A package name binds after the module's own declarations and the imports
// registered before the package names (`import_count` of them): the package
// namespace is consulted last. A name one of those already binds stays theirs.
// A declaration of a package name is refused (E0105), unless the module keeps
// that name to itself (`namespace_private`: a named entry's or a command
// home's own command function, which the loader leaves out of the namespace),
// and so is an imported item of a package function's name unless it imports
// that very function; a module alias or an imported type shadows the package
// name.
sema_registration_namespace_collisions: fn(graph: ^SemaRegistrationGraph, module_index: Int, import_count: Int) {
    if graph.modules[module_index].namespace_slot < 0 {
        return
    }
    loop position in 0..<graph.modules[module_index].symbols.len() {
        name: graph.modules[module_index].symbols[position].name
        if graph.modules[module_index].namespace_private.contains(name) -> next
        if sema_registration_namespace_owner(graph, module_index, name) == None -> next
        span: graph.modules[module_index].symbols[position].span
        sema_registration_push_graph_diagnostic(graph, module_index, sema_defined_twice(name, "imported names share the module namespace", span))
    }
    loop import_index in 0..<import_count {
        loop binding_index in 0..<graph.modules[module_index].imports[import_index].bindings.len() {
            if graph.modules[module_index].imports[import_index].bindings[binding_index].symbol.kind == .Import {
                next
            }
            local: graph.modules[module_index].imports[import_index].bindings[binding_index].local
            original: graph.modules[module_index].imports[import_index].bindings[binding_index].original
            source: graph.modules[module_index].imports[import_index].bindings[binding_index].target_module_identity
            if !sema_registration_namespace_function_conflict(graph, module_index, local, original, source) {
                next
            }
            span: graph.modules[module_index].imports[import_index].declaration.span
            sema_registration_push_graph_diagnostic(graph, module_index, sema_defined_twice(local, "imported names share the module namespace", span))
        }
    }
}

// Whether `name` is a package function another member of `module_index`'s
// package declares: an imported item of that name is ambiguous (E0105).
sema_registration_namespace_function_owner: fn(graph: SemaRegistrationGraph, module_index: Int, name: String) -> Bool Never! {
    owner: sema_registration_namespace_owner(graph, module_index, name) ?? return false
    graph.modules[owner.module_index].symbols[owner.row].kind == .Function
}

// Whether importing `original` from `source_module_identity` as `local`
// collides with a package function another member declares. The import that
// names the very declaration the package already binds under that name
// (`use mathlib.clamp` beside the `clamp` of mathlib.jet, `wrap: wrap.wrap`)
// binds nothing new, so it is no collision.
sema_registration_namespace_function_conflict: fn(graph: SemaRegistrationGraph, module_index: Int, local: String, original: String, source_module_identity: ModuleID) -> Bool Never! {
    owner: sema_registration_namespace_owner(graph, module_index, local) ?? return false
    if graph.modules[owner.module_index].symbols[owner.row].kind != .Function -> return false
    original != local || graph.modules[owner.module_index].module_identity != source_module_identity
}

sema_registration_module_has_nominal_name: fn(module_row: SemaRegistrationModule, name: String) -> Bool Never! {
    loop nominal_index in 0..<module_row.nominals.len() {
        if module_row.nominals[nominal_index].symbol.name == name -> return true
    }
    false
}

// The module that receives a compiler-owned nominal: the entry module unless
// it declares that name itself, else the first module that does not.
sema_registration_compiler_builtin_module: fn(graph: SemaRegistrationGraph, name: String) -> Int? {
    entry_index: sema_registration_module_index(graph, graph.entry_module_identity)
    if entry_index == .Val(index) {
        if !sema_registration_module_has_nominal_name(graph.modules[index], name) {
            return Val(index)
        }
    }
    loop (index, module_row) in graph.modules {
        if !sema_registration_module_has_nominal_name(module_row, name) -> return Val(index)
    }
    None
}

sema_registration_inject_compiler_builtins: fn(graph: ^SemaRegistrationGraph) {
    original := SemaRegistrationRowRef?{None}
    loop (module_index, module_row) in graph.modules {
        loop (row, nominal) in module_row.nominals {
            if sema_registration_compiler_builtin_marker(nominal) != (Val(TCompilerBuiltin.DefaultErr)) {
                next
            }
            if original == .Val(_) || nominal.generic_params.len() != 0 {
                graph.internal_problem = Val("the original Prelude default error needs one nongeneric checked owner")
                graph.complete = false
                return
            }
            original = Val(SemaRegistrationRowRef{module_index: module_index, row: row})
        }
    }
    owner: original ?? {
        graph.internal_problem = Val("the original Prelude error declaration supplier is missing")
        graph.complete = false
        return
    }
    // Resolve implicit compiler names to genuine ordinary declarations in the
    // marked owner's module; emitted aliases never choose this owner.
    loop (row, nominal) in graph.modules[owner.module_index].nominals {
        sema_registration_set_compiler_builtin(graph, nominal.symbol.name, SemaRegistrationRowRef{module_index: owner.module_index, row: row})
    }
    compiler_enums: [String]{"Ordering", "RemoveBy", "TaskPauseMode", "UnitScaleProvenanceKind"}
    loop name in compiler_enums {
        variants: sema_registration_compiler_owned_enum_variants(name) ?? panic("compiler-owned enum has no variant menu")
        module_index: sema_registration_compiler_builtin_module(graph, name) ?? next
        module_identity := module_text(graph.module_table, graph.modules[module_index].module_identity)
        first_nominal: graph.modules[module_index].nominals.len()
        nominal: sema_registration_compiler_owned_enum(graph.modules[module_index].module_identity, module_identity, graph.symbols, name, variants)
        graph.modules[module_index].nominals.push(nominal)
        sema_registration_index_nominal_rows(graph, module_index, first_nominal)
        sema_registration_set_compiler_builtin(graph, name, SemaRegistrationRowRef{module_index: module_index, row: first_nominal})
    }
    loop codec in ([SerdeCodec#2]{.Encode, .Decode}) {
        reference: builtin_codec_trait_ref(codec)
        module_index: sema_registration_compiler_builtin_module(graph, reference.name) ?? next
        module_identity: module_text(graph.module_table, graph.modules[module_index].module_identity)
        first_nominal: graph.modules[module_index].nominals.len()
        nominal: sema_registration_compiler_owned_codec_trait(graph.modules[module_index].module_identity, module_identity, reference)
        graph.modules[module_index].nominals.push(nominal)
        sema_registration_index_nominal_rows(graph, module_index, first_nominal)
        sema_registration_set_compiler_builtin(graph, reference.name, SemaRegistrationRowRef{module_index: module_index, row: first_nominal})
    }
}

sema_registration_set_compiler_builtin: fn(graph: ^SemaRegistrationGraph, name: String, ref: SemaRegistrationRowRef) Never! {
    id: name_index(name_intern(graph.compiler_builtin_names, name))
    loop graph.compiler_builtin_refs.len() <= id -> graph.compiler_builtin_refs.push(None)
    graph.compiler_builtin_refs[id] = Val(ref)
}

// Compiler names resolve to ordinary original Prelude declarations or the
// existing runtime enum rows. The DefaultErr role comes only from its marker.
sema_registration_compiler_builtin_row: fn(graph: SemaRegistrationGraph, name: String) -> SemaRegistrationRowRef? Never! {
    sema_registration_compiler_builtin_row_hashed(graph, name, name_text_hash(name))
}

sema_registration_compiler_builtin_row_hashed: fn(graph: SemaRegistrationGraph, name: String, hash: Int) -> SemaRegistrationRowRef? Never! {
    found: name_find_hashed(graph.compiler_builtin_names, name, hash) ?? return None
    id: name_index(found)
    if id < graph.compiler_builtin_refs.len() -> return graph.compiler_builtin_refs[id]
    None
}

// `counting` sets the graph's `counting` (#4319 lookup counters). The inputs
// are consumed: each program moves into its module row. The unit scans and
// the module rows are prepared on up to `threads` compiler threads, with the
// same rows and diagnostics for any thread count. The Core library's check
// (`capture_derives`) records each Core module's derive expansion; a
// compile whose host lends that check's bodies file (`derive_hooks`) takes
// the records in place of expanding (CoreBodies.jet sema_core_derives_attach).
sema_registration_prepare_graph: fn(inputs: ^^[SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], package_identity: String, entry_module_identity: ModuleID, canonical_effect_module_identity: ModuleID, module_table: ^^ModuleTable, foreign_providers: [SemaForeignProviderInput], target_machine: TargetMachine, build_facts: SemaBuildFacts, counting: Bool, threads: CompilerThreads, derive_hooks: SemaHostHookAccess?{None}, capture_derives: Bool{false}) -> SemaRegistrationGraph {
    modules := [SemaRegistrationModule]{}
    diagnostics := [Diagnostic]{}
    // The original Prelude error declarations join the graph first, as their
    // own compiler-generated module, the only source of the DefaultErr marker.
    // Then the units Prelude is injected and unit dimensions resolve, before
    // any module is registered. The compiler-owned effect module is not a
    // source module and takes no catalog families.
    prepared_inputs := inputs.move()
    table := module_table.move()
    sema_registration_retain_original_error_module(prepared_inputs, table, diagnostics)
    sema_core_derives_attach(prepared_inputs, table, derive_hooks, capture_derives)
    units_names: SEMA_UNITS_CATALOG_NAMES
    units_mentions: sema_units_scan_mentions(prepared_inputs, canonical_effect_module_identity, units_names, threads)
    // An input that mentions no catalog unit takes no family.
    loop index in 0..<prepared_inputs.len() {
        if !sema_units_scanned(prepared_inputs, index, canonical_effect_module_identity) || !sema_units_mentioned(SEMA_UNITS_CATALOG, units_names, units_mentions[index]) {
            next
        }
        sema_units_inject(prepared_inputs[index], SEMA_UNITS_CATALOG, units_names, units_mentions[index])
    }
    sema_units_resolve(prepared_inputs, edges, diagnostics)
    // #6176: a `Name: path` binding whose path names a type is a type
    // alias; it is rewritten before markers bind or casing reads the items.
    sema_alias_classify_inputs(prepared_inputs, edges)
    // A parameter or result typed by states (`Order.Draft`) takes its
    // owner's plain type before any module registers; the function keeps
    // the states for the typestate checks.
    sema_state_types_rewrite_inputs(prepared_inputs)
    // A use of a parameterized trait, `Store<Int>`, becomes the ordinary
    // trait it names before any module registers.
    sema_trait_instances_rewrite_inputs(prepared_inputs, diagnostics)
    // A directly used imported marker binds to its declaring module before any
    // module registers.
    marker_bindings := sema_marker_module_bindings_threads(prepared_inputs, edges, threads)
    loop index in 0..<prepared_inputs.len() {
        if marker_bindings[index].len() > 0 {
            sema_marker_module_bind_program(prepared_inputs[index].program, marker_bindings[index])
        }
    }
    // ModuleID -> row; duplicates are rejected below, so the first row is
    // the only row (`by_identity`).
    module_rows := [Int]{}
    loop _ in 0..<module_count(table) -> module_rows.push(-1)
    generic_module_index: sema_generic_modules_index(prepared_inputs, edges)
    // User policies are package-scoped, so every module
    // of a package materializes the same checked declarations. Policies and
    // imported templates are read off every input in place first: the loop
    // below consumes the inputs, and a template module may precede its
    // importer.
    // Each package identity in `policy_packages`, its policies at its id once
    // `policy_ready` marks them read.
    policy_packages := name_table_sized(16)
    package_policies := [[UserPolicyDecl]]{}
    policy_ready := [Bool]{}
    imported_templates := [[SemaGenericModuleSource]]{}
    loop index in 0..<prepared_inputs.len() {
        policy_id: name_index(name_intern(policy_packages, prepared_inputs[index].package_identity))
        loop package_policies.len() <= policy_id {
            package_policies.push([UserPolicyDecl]{})
            policy_ready.push(false)
        }
        if !policy_ready[policy_id] {
            package_policies[policy_id] = sema_policy_package_declarations(prepared_inputs, prepared_inputs[index].package_identity, diagnostics)
            policy_ready[policy_id] = true
        }
        imported_templates.push(sema_generic_modules_imported(prepared_inputs, edges, generic_module_index, prepared_inputs[index].module_identity, table))
    }
    // Each dependency's row of `build_facts.package_settings`, by a
    // pass-local id of its package identity (-1 at id 0, the empty identity,
    // and for every package without a row).
    settings_names := name_table_sized(build_facts.package_settings.len() * 2 + 2)
    settings_rows := [Int]{-1}
    loop (row, package) in build_facts.package_settings {
        id: name_index(name_intern(settings_names, package.package_identity))
        if id == settings_rows.len() -> settings_rows.push(row) else -> settings_rows[id] = row
    }
    // A module carries its Module record only when a source reads it as a
    // value or its body sets a field; the reads span every input.
    sema_module_meta_mark_reads(prepared_inputs)
    // Only modules declaring a module alias or a generic module keep their
    // programs as written for the alias check after registration.
    written_inputs: sema_generic_modules_written(prepared_inputs)
    // The codecs each module's auto-derive reads off the types other modules
    // declare: one fixed point over every parsed input before any module is
    // prepared, so each preparation still reads only its own job.
    codecs := sema_derive_foreign_codecs(prepared_inputs, threads)
    // An impl of a trait another module declares gains the trait's default
    // bodies, read off every input the same way.
    sema_trait_impls_foreign(prepared_inputs, edges, table)
    // Each module interns its symbols into its own id range, fixed before any
    // thread runs, so every id is the same for any thread count
    // (Docs/Spec/compiler-data.md). The modules share three quarters of the
    // ids after the builtin range, each in proportion to its source and the
    // templates it instantiates, and the serial passes intern after the last
    // range.
    builtin := symbol_builtin_keys()
    symbols_cursor := builtin.base + builtin.bound
    symbols_weight := 0
    loop index in 0..<prepared_inputs.len() {
        symbols_weight += sema_registration_symbol_weight(prepared_inputs[index], imported_templates[index].len())
    }
    symbols_share: (SYMBOL_LOCAL_BOUND - symbols_cursor) /% 4 * 3
    // Each input moves out of the list (front to back) into its prepare job.
    prepared_inputs.reverse()
    imported_templates.reverse()
    codecs.reverse()
    jobs := [SemaRegistrationPrepareJob]{}
    // Each job's `settings_row`, in job order.
    job_settings := [Int]{}
    loop prepared_inputs.len() > 0 {
        input := prepared_inputs.pop() ?? break
        templates := imported_templates.pop() ?? break
        module_codecs := codecs.pop() ?? break
        // Every input's package identity was interned above.
        policies: if name_find(policy_packages, input.package_identity) == .Val(policy_name) -> package_policies[name_index(policy_name)] else -> [UserPolicyDecl]{}
        input_text: module_text(table, input.module_identity)
        settings_row: if name_find(settings_names, input.package_identity) == .Val(found) -> settings_rows[name_index(found)] else -> -1
        settings: sema_build_facts_settings_at(build_facts, settings_row)
        job_settings.push(settings_row)
        bound: symbols_share * sema_registration_symbol_weight(input, templates.len()) /% symbols_weight
        symbols := symbol_keys(symbols_cursor, bound)
        symbols_cursor += bound
        symbols.module_identity = input.module_identity
        jobs.push(SemaRegistrationPrepareJob{input: input.move(), module_text: input_text, symbols: symbols.move(), templates: templates.move(), policies: policies, settings: settings, codecs: module_codecs.move()})
    }
    prepared := sema_registration_prepare_rows(jobs, threads)
    // Each prepared row moves out (front to back) into its module row, after
    // its diagnostics, as one module after another reported them.
    prepared.reverse()
    job_settings.reverse()
    // Each prepared module's range, then the builtin range. A duplicate
    // keeps no range: its keys are its first row's, which the graph holds.
    symbol_ranges := [SymbolKeys]{}
    loop prepared.len() > 0 {
        row := prepared.pop() ?? break
        loop diagnostic in row.diagnostics -> diagnostics.push(diagnostic)
        module_row := row.module_row.move()
        module_row.settings_row = job_settings.pop() ?? -1
        identity: module_index(module_row.module_identity)
        duplicate: module_rows[identity] >= 0
        if {
            duplicate -> {
                diagnostics.push(sema_defined_twice_optional(module_text(table, module_row.module_identity), "module identities must be unique in one declaration graph", None))
            }
            else -> {
                module_rows[identity] = modules.len()
                modules.push(module_row)
                symbol_ranges.push(row.symbols.move())
            }
        }
    }
    symbol_ranges.push(builtin)
    if package_identity == "" || module_is_none(entry_module_identity) {
        diagnostics.push(sema_error_optional("E0003", None, "the declaration graph is missing its package or entry identity", "cross-module lookup must use one exact graph identity", "provide the loader's canonical package and entry module identities"))
    }
    graph := SemaRegistrationGraph{package_identity: package_identity, entry_module_identity: entry_module_identity, canonical_effect_module_identity: canonical_effect_module_identity, target_machine: target_machine, build_facts: build_facts, modules: modules, module_table: table.move(), module_rows: module_rows, symbols: symbol_table_of(symbol_ranges), edges: edges, foreign_providers: foreign_providers, core_builtin_owner_facts: sema_registration_core_builtin_owner_facts(), imports: [SemaRegistrationImport]{}, unit_facts: [SemaRegistrationUnitFact]{}, lookup_counters: Shared{SemaLookupCounters{module_lookups: 0, name_lookups: 0, scope_lookups: 0, scope_compares: 0}}, counting: counting, internal_problem: None, diagnostics: diagnostics, complete: diagnostics.len() == 0, nominal_row_buckets: [[SemaRegistrationRowRef]]{[SemaRegistrationRowRef]{}}, impl_row_buckets: [[SemaRegistrationRowRef]]{[SemaRegistrationRowRef]{}}, nominal_symbol_rows: [U32:SemaRegistrationRowRef]{}, codec_demand: Shared{sema_codec_demand_new()}, derive_demand: Shared{sema_derive_demand_new()}, interner: interner()}
    sema_registration_index_all_nominal_rows(graph)
    sema_registration_index_source_impls(graph)
    loop module_index in 0..<graph.modules.len() {
        sema_registration_note_root_functions(graph, module_index)
        if graph.core_seal {
            sema_footprint_populate_module(graph.modules[module_index])
        }
    }
    sema_serde_index_codec_methods(graph)
    sema_derive_index_methods(graph)
    sema_registration_index_namespaces(graph)
    if !module_is_none(entry_module_identity) && sema_registration_module_index(graph, entry_module_identity) == None {
        graph.diagnostics.push(sema_error_optional("E0003", None, "the declaration graph entry is not loaded", "the entry identity must name one prepared module", "include the entry module in the loader's module inputs"))
    }
    canonical_effect_index: sema_registration_module_index(graph, canonical_effect_module_identity)
    if canonical_effect_index == {
        .Val(effect_module_index) -> {
            // Read in place: a copy of the row would carry its whole program.
            if graph.modules[effect_module_index].package_identity != JET_CANONICAL_EFFECT_PACKAGE_IDENTITY || graph.modules[effect_module_index].module_path != JET_CANONICAL_EFFECT_MODULE_PATH {
                graph.internal_problem = Val("the canonical Prelude effect module identity does not match its pinned source owner")
                graph.complete = false
            }
            effect_declaration_count := 0
            loop item in graph.modules[effect_module_index].program.items {
                if item == {
                    .EffectDecl(_) -> effect_declaration_count += 1
                    .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
                }
            }
            if effect_declaration_count == 0 {
                graph.internal_problem = Val("the canonical Prelude effect source has no declarations")
                graph.complete = false
            }
        }
        .None -> {
            graph.internal_problem = Val("the canonical Prelude effect declaration module is missing from the registration graph")
            graph.complete = false
        }
    }
    // Marker namespace/declaration laws precede import member registration and
    // generated rule bodies. The complete loader edge set detects ambiguous
    // qualified markers even when two imports share their local alias. A
    // marker-law error leaves the graph incomplete, so no rule body expands
    // (sema_registration_expand_user_templates), but registration goes on
    // binding imports: the declaration pass then reports every error that
    // does not depend on the invalid marker, without unbound-import cascades.
    marker_diagnostics := [Diagnostic]?{None}
    package_markers := [Marker]?{None}
    canonical_markers: sema_marker_module_effect_roots_are_canonical(graph)
    applied_opt: if canonical_markers -> SEMA_PRELUDE_APPLIED_CATALOG else -> sema_marker_module_applied_catalog(graph)
    if applied_opt == .Val(applied) {
        // A `#Rename` format label is any `impl Format` name the graph
        // declares, a package's beside Core's.
        graph.marker_catalog = sema_scope_members_with_format_names(if canonical_markers -> SEMA_PRELUDE_MARKER_REGISTRY else -> sema_marker_module_catalog_registry(applied), graph)
        unknown_rules := [[Diagnostic]]{}
        if graph.marker_catalog == .Val(catalog) {
            found := sema_marker_module_check_threads(graph, applied, catalog, threads, unknown_rules)
            package_site := sema_marker_package_check(graph, applied, catalog)
            loop diagnostic in package_site.diagnostics -> found.push(diagnostic)
            package_markers = Val(package_site.markers.move())
            marker_diagnostics = Val(found)
        }
        graph.unknown_rule_diagnostics = unknown_rules.move()
    }
    if package_markers == .Val(bound) -> graph.build_facts.package_markers = bound
    if marker_diagnostics == .Val(found) {
        loop diagnostic in found -> graph.diagnostics.push(diagnostic)
        if found.len() > 0 -> graph.complete = false
    } else {
        graph.internal_problem = Val("the canonical Prelude marker registry is unavailable")
        graph.complete = false
        return graph
    }
    sema_registration_attach_namespace_impls(graph)
    sema_registration_inject_compiler_builtins(graph)
    graph.unit_facts = sema_registration_unit_facts(graph)
    // A fact's bucket sits at its name's id; id 0 is the table's empty
    // spelling, so every id up to the new one gets its bucket first.
    loop fact_index in 0..<graph.unit_facts.len() {
        fact_name: graph.unit_facts[fact_index].name
        slot: Int{name_intern(graph.unit_fact_names, fact_name).id}
        loop graph.unit_fact_buckets.len() <= slot -> graph.unit_fact_buckets.push([Int]{})
        graph.unit_fact_buckets[slot].push(fact_index)
    }
    loop module_row_index in 0..<graph.modules.len() {
        loop item_index in 0..<graph.modules[module_row_index].program.items.len() {
            if graph.modules[module_row_index].program.items[item_index] == .UnitFamily(definition) {
                graph.has_unit_families = true
                loop minted in sema_registration_unit_family_type_names(definition) {
                    _ := name_intern(graph.unit_member_names, minted.name)
                }
            }
        }
    }

    // Per-module packed span sets (`sema_registration_span_key`), avoiding
    // string formatting and hashing across every import edge.
    declared_spans := [[Int:Bool]]{}
    edge_spans := [[Int:Bool]]{}
    loop declared_module in 0..<graph.modules.len() {
        module_spans := [Int:Bool]{}
        sema_registration_declared_import_spans(graph.modules[declared_module].program.imports, graph.modules[declared_module].program.items, module_spans)
        declared_spans.push(module_spans.move())
        edge_spans.push([Int:Bool]{})
    }
    loop edge in edges {
        if sema_registration_module_index(graph, edge.source_module_identity) == .Val(edge_mod) {
            edge_spans[edge_mod][sema_registration_span_key(edge.declaration.span)] = true
        }
    }
    registered := sema_registration_import_index(graph.modules.len())
    loop edge in edges {
        source_index: sema_registration_module_index(graph, edge.source_module_identity)
        target_index: sema_registration_module_index(graph, edge.target_module_identity)
        if source_index == None || target_index == None {
            sema_registration_push_graph_diagnostic(graph, source_index ?? -1, sema_error("E0003", edge.declaration.span, "an import edge names a module outside the loaded graph", "module and package identity are resolved before semantic registration", "retain both endpoint identities from the loader"))
            next
        }
        source_module_index: source_index ?? 0
        declared: declared_spans[source_module_index].get(sema_registration_span_key(edge.declaration.span)) != None
        if {
            !declared -> {
                sema_registration_push_graph_diagnostic(graph, source_module_index, sema_error("E0003", edge.declaration.span, "an import edge has no source declaration", "semantic preparation only registers imports present in the source program", "retain the original ImportDecl when constructing the resolved edge"))
            }
            edge.target_package_identity != "" && edge.target_package_identity != graph.modules[target_index ?? 0].package_identity -> {
                sema_registration_push_graph_diagnostic(graph, source_module_index, sema_error("E0003", edge.declaration.span, "an import edge has the wrong target package identity", "package visibility follows the loaded target module identity", "copy the target package identity from the resolved module"))
            }
            else -> {
                if edge.source_scope != "" -> next
                target_package := edge.target_package_identity
                if target_package == "" {
                    target_package = graph.modules[target_index ?? 0].package_identity
                }
                scope: if edge.foreign_binding == .Val(binding) -> binding.scope ?? "" else -> ""
                sema_registration_add_import(graph, registered, source_module_index, scope, sema_registration_foreign_import_declaration(edge), edge.target_module_identity, target_package)
            }
        }
    }
    // A lowered inline module's Core member import reads a file-level Core
    // alias that shares the scoped declaration's span (InlineModules.jet
    // sema_inline_core_imports), and a module's Module record reads core.meta
    // through its generated alias (ModuleMeta.jet); each alias binds the
    // loaded Core module it names.
    hoisted_names := name_table_sized(2)
    hoisted_rows := [Int]{-1}
    hoisted_indexed := false
    loop hoisted_module in 0..<graph.modules.len() {
        hoisted := [ImportDecl]{}
        loop declaration in graph.modules[hoisted_module].program.imports {
            if sema_inline_core_alias_import(declaration) || sema_module_meta_import(declaration) {
                hoisted.push(declaration)
            }
        }
        if hoisted.len() == 0 -> next
        if !hoisted_indexed {
            hoisted_indexed = true
            hoisted_names = name_table_sized(graph.modules.len() * 2 + 2)
            hoisted_rows = [Int]{-1}
            loop candidate in 0..<graph.modules.len() {
                id: name_index(name_intern(hoisted_names, graph.modules[candidate].module_name))
                if id == hoisted_rows.len() -> hoisted_rows.push(candidate)
            }
        }
        loop declaration in hoisted {
            if declaration.kind == .Module(name, _) {
                target := -1
                if name_find(hoisted_names, name) == .Val(found_name) {
                    target = hoisted_rows[name_index(found_name)]
                }
                if target < 0 {
                    sema_registration_push_graph_diagnostic(graph, hoisted_module, sema_error("E0003", declaration.span, "the Core module `{name}` an inline module import reads is not in the declaration graph", "a lowered inline module reads its Core members through the loaded Core module", "keep the loader's edge to `{name}` for the inline module's import"))
                    next
                }
                target_identity: graph.modules[target].module_identity
                target_package: graph.modules[target].package_identity.copy()
                sema_registration_add_import(graph, registered, hoisted_module, "", declaration, target_identity, target_package)
            }
        }
    }
    // A lowered inline module's own module or file import reads a generated
    // file-level alias that shares the scoped declaration's span
    // (InlineModules.jet sema_inline_alias_imports); the alias binds the
    // module that declaration's own edge names.
    edges_by_source := [U32:[Int]]{}
    edges_indexed := false
    loop aliased_module in 0..<graph.modules.len() {
        aliased := [ImportDecl]{}
        loop declaration in graph.modules[aliased_module].program.imports {
            if sema_inline_module_alias_import(declaration) -> aliased.push(declaration)
        }
        if aliased.len() == 0 -> next
        if !edges_indexed {
            edges_indexed = true
            loop edge_index in 0..<edges.len() {
                src: edges[edge_index].source_module_identity.id
                if !edges_by_source.has_key(src) -> edges_by_source[src] = [Int]{}
                edges_by_source[src].push(edge_index)
            }
        }
        source_identity: graph.modules[aliased_module].module_identity
        source_edges: edges_by_source.get(source_identity.id) ?? [Int]{}
        loop declaration in aliased {
            bound := false
            loop edge_index in source_edges {
                edge: edges[edge_index]
                if bound -> break
                if edge.declaration.span.start != declaration.span.start || edge.declaration.span.end != declaration.span.end {
                    next
                }
                target_index: sema_registration_module_index(graph, edge.target_module_identity) ?? next
                target_package := edge.target_package_identity
                if target_package == "" {
                    target_package = graph.modules[target_index].package_identity
                }
                lifted := sema_registration_foreign_import_declaration(edge)
                lifted.alias = declaration.alias.copy()
                lifted.is_pub = false
                lifted.is_package_pub = false
                sema_registration_add_import(graph, registered, aliased_module, "", lifted, edge.target_module_identity, target_package)
                bound = true
            }
            if !bound {
                sema_registration_push_graph_diagnostic(graph, aliased_module, sema_error("E0003", declaration.span, "an inline module's own import has no resolved graph edge", "a lowered inline module reads its own import through the module that import's edge names", "keep the loader's scoped edge for the inline module's import"))
            }
        }
    }
    module_index := 0
    loop module_index < graph.modules.len() {
        // Every source import must have one exact edge. A missing edge is not
        // recovered by matching a module name or alias.
        import_count: graph.modules[module_index].program.imports.len()
        loop import_index in 0..<import_count {
            declaration := graph.modules[module_index].program.imports[import_index]
            found: edge_spans[module_index].get(sema_registration_span_key(declaration.span)) != None
            if !found && !sema_module_meta_import(declaration) {
                sema_registration_push_graph_diagnostic(graph, module_index, sema_error("E0003", declaration.span, "an import declaration has no resolved graph edge", "semantic preparation never resolves private or dependency imports by bare name", "provide the loader-resolved target module identity"))
            }
        }
        module_index += 1
    }
    // Each module's file and module import ids first
    // (sema_registration_mint_module_imports).
    module_index = 0
    loop module_index < graph.modules.len() {
        sema_registration_mint_module_imports(graph, module_index)
        module_index += 1
    }
    import_module_indices := [Int]{}
    module_index = 0
    loop module_index < graph.modules.len() {
        sema_registration_populate_imports(graph, module_index, import_module_indices)
        sema_inline_modules_check_imports(graph, module_index)
        module_index += 1
    }
    sema_registration_index_package_reach(graph)
    graph = sema_comptime_use_check(graph, threads)
    graph = sema_registration_canonicalize_qualified_types(graph, threads)
    sema_type_alias_cycles_check(graph)
    graph.complete = !sema_registration_blocking_error(graph.diagnostics)
    // Generic-module aliases resolve and check their arguments once every
    // import is bound.
    sema_generic_modules_check(graph, written_inputs)
    graph.complete = !sema_registration_blocking_error(graph.diagnostics)
    // Templates and aliases are erased once expanded: their symbols stay
    // registered, but no later pass sees an unexpanded body. They are removed
    // in place; every other item stays in order, uncopied, and the rows that
    // read their bodies by item index follow them (`moved`: each old index's
    // new one, -1 for an erased item).
    loop erased_index in 0..<graph.modules.len() {
        item_index := 0
        moved := [Int]{}
        removed := false
        loop item_index < graph.modules[erased_index].program.items.len() {
            if sema_registration_item_is_expanded_template(graph.modules[erased_index].program.items[item_index]) {
                erased_cap: sema_registration_template_cap(graph.modules[erased_index].program.items[item_index])
                if erased_cap == .Val(cap) -> graph.modules[erased_index].template_caps.push(cap)
                _ := graph.modules[erased_index].program.items.remove(item_index, .Slot)
                moved.push(-1)
                removed = true
            } else {
                moved.push(item_index)
                item_index += 1
            }
        }
        if removed -> sema_registration_move_item_rows(graph.modules[erased_index], moved)
    }
    // User derives and declared marker
    // bodies expand over the complete graph's reflection and register their
    // generated items before any body is checked.
    own_symbols: loop row_index in 0..<graph.modules.len() -> graph.modules[row_index].symbols.len()
    items_before := 0
    loop row_index in 0..<graph.modules.len() {
        items_before += graph.modules[row_index].program.items.len()
    }
    sema_registration_expand_user_templates(graph)
    items_after := 0
    loop row_index in 0..<graph.modules.len() {
        items_after += graph.modules[row_index].program.items.len()
    }
    sema_registration_bind_namespaces(graph, own_symbols, items_after != items_before, threads)
    sema_registration_index_callables(graph)
    sema_registration_index_impl_traits(graph, threads)
    // The C guest boundary (import surface, export surface, symbol
    // collisions) is checked once every declaration is registered, before any
    // body is checked.
    sema_guest_check_surfaces(graph)
    // Every performance role elaborates into its canonical typed budgets once
    // every declaration is registered.
    budget_findings: sema_budget_validate_graph(graph)
    loop finding in budget_findings {
        sema_registration_push_graph_diagnostic(graph, finding.module_index, finding.diagnostic)
        graph.complete = false
    }
    sema_registration_index_canonical_nominals(graph)
    graph = sema_divergence_solve(graph, threads)
    // Each test's id once the user templates have generated theirs.
    loop row_index in 0..<graph.modules.len() -> sema_registration_mint_tests(graph, row_index)
    sema_registration_seed_interner(graph)
    graph
}

// Seeds the graph's shared Interner with every registered nominal spelling
// once, so parallel body workers hit the read-only shared tables with zero copies.
sema_registration_seed_interner: fn(graph: ^SemaRegistrationGraph) Never! {
    loop module_index in 0..<graph.modules.len() {
        loop nominal in graph.modules[module_index].nominals {
            _: type_id_named(graph.interner, nominal.symbol.name)
        }
    }
    if graph.canonical_nominals == .Val(canonical) {
        loop mod_names in canonical.names {
            loop spelling in mod_names {
                _: type_id_named(graph.interner, spelling)
            }
        }
    }
}

sema_registration_item_is_expanded_template: fn(item: Item) -> Bool Never! {
    if item == {
        .GenericModule(_) | .ModuleAlias(_) -> true
        .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .MarkerDecl(_) | .FactDecl(_) -> false
    }
}

// The `#FX(…)` cap written above a generic-module template, if any.
sema_registration_template_cap: fn(item: Item) -> ModuleCap? Never! {
    if item == .GenericModule(template) -> return template.cap
    None
}

// Appends to `words` each identifier-shaped word of `bytes[start..<end]` that
// `seen` does not hold yet, and records it there: maximal runs of ASCII
// letters, digits and `_`, and of non-ASCII bytes, so a multi-byte letter
// stays inside its word. Comments and strings count too, so the words are a
// superset of the names the range spells (namespace reach).
sema_source_words: fn(bytes: [U8], start: Int, end: Int, seen: ^NameTable, words: ^[String]) Never! {
    stop: if end < bytes.len() -> end else -> bytes.len()
    cursor := if start > 0 -> start else -> 0
    loop cursor < stop {
        if !sema_source_word_byte(bytes[cursor]) {
            cursor += 1
            next
        }
        word_start: cursor
        loop cursor < stop && sema_source_word_byte(bytes[cursor]) -> cursor += 1
        word: String.from_bytes(bytes.slice(word_start, cursor)) ?? next
        known: name_count(seen)
        if name_index(name_intern(seen, word)) < known -> next
        words.push(word)
    }
}

// sema_source_words over all of `bytes`, keeping only the words `wanted`
// interns: a word outside it is skipped by its bytes, never built as a
// String, so `seen` and `words` hold exactly the wanted words
// sema_source_words would have added, in the same order. A wanted word
// already met is skipped by its id, so each one is looked up in `seen` once.
// The byte test is sema_source_word_byte written inline: this loop reads
// every byte of every namespace member.
sema_word_byte_table: fn() -> [Bool] Never! {
    table: loop n in 0..<256 -> n >= 128 || n == 95 || (n >= 48 && n <= 57) || (n >= 65 && n <= 90) || (n >= 97 && n <= 122)
    table
}

SEMA_WORD_BYTE: #run sema_word_byte_table()

sema_source_wanted_words: fn(bytes: [U8], wanted: NameTable, seen: ^NameTable, words: ^[String]) Never! {
    met := [Bool]{}
    loop _ in 0..<name_count(wanted) -> met.push(false)
    count: I64{bytes.len()}
    cursor := I64{0}
    loop cursor < count {
        first: bytes[Int{cursor}]
        cursor += I64{1}
        if !SEMA_WORD_BYTE[Int{first}] -> next
        word_start: Int{cursor - I64{1}}
        loop cursor < count {
            if !SEMA_WORD_BYTE[Int{bytes[Int{cursor}]}] -> break
            cursor += I64{1}
        }
        if first >= (U8{48}) && first <= (U8{57}) -> next
        name: name_find_bytes(wanted, bytes, word_start, Int{cursor}) ?? next
        id: Int{name.id}
        if met[id] -> next
        met[id] = true
        // The table interned this spelling from a String, so it is its text.
        word: name_text(wanted, name)
        known: name_count(seen)
        if name_index(name_intern(seen, word)) < known -> next
        words.push(word)
    }
}

sema_source_word_byte: fn(byte: U8) -> Bool Never! {
    SEMA_WORD_BYTE[Int{byte}]
}

// Numbers every package namespace name once, per package one name -> entry
// table. Entries run in module order, then declaration order; the loader
// already rejected a name two members declare (E0624). The tables are filled
// from rows sorted by (slot, name, entry), so each insert appends
// (SemaRegistrationKeyedRow).
SemaRegistrationNamespaceName: struct {
    slot: Int,
    name: String,
    entry: Int,
}

sema_registration_canonical_nominal_row: fn(table: SemaCanonicalNominals, name: String, hash: Int) -> Int? Never! {
    found: name_find_hashed(table.rows, name, hash) ?? return None
    id: name_index(found)
    if id < table.row_slots.len() && table.row_slots[id] >= 0 -> return Val(table.row_slots[id])
    None
}

sema_registration_index_namespaces: fn(graph: ^SemaRegistrationGraph) Never! {
    loop module_index in 0..<graph.modules.len() {
        namespace: graph.modules[module_index].namespace
        if namespace == "" -> next
        slot: name_index(name_intern(graph.namespace_names, namespace)) - 1
        loop graph.namespace_tables.len() <= slot {
            graph.namespace_tables.push(name_table_sized(64))
            graph.namespace_table_entries.push([Int]{-1})
            graph.namespace_entries.push([Int]{})
        }
        graph.modules[module_index].namespace_slot = slot
        loop name_idx in 0..<graph.modules[module_index].namespace_names.len() {
            name: graph.modules[module_index].namespace_names[name_idx]
            entry: graph.namespace_entry_modules.len()
            graph.namespace_entries[slot].push(entry)
            graph.namespace_entry_modules.push(module_index)
            graph.namespace_entry_names.push(name.copy())
            id: name_index(name_intern(graph.namespace_tables[slot], name))
            loop graph.namespace_table_entries[slot].len() <= id -> graph.namespace_table_entries[slot].push(-1)
            graph.namespace_table_entries[slot][id] = entry
        }
    }
}

sema_registration_namespace_entry_hashed: fn(graph: SemaRegistrationGraph, slot: Int, name: String, hash: Int) -> Int? Never! {
    found: name_find_hashed(graph.namespace_tables[slot], name, hash) ?? return None
    id: name_index(found)
    if id < graph.namespace_table_entries[slot].len() && graph.namespace_table_entries[slot][id] >= 0 -> return Val(graph.namespace_table_entries[slot][id])
    None
}

// The registered symbol row of `name` in the other member of `module_index`'s
// package that declares it, or none (no namespace, the module's own name, or a
// declaration that did not register).
sema_registration_namespace_owner: fn(graph: SemaRegistrationGraph, module_index: Int, name: String) -> SemaRegistrationRowRef? Never! {
    if graph.modules[module_index].namespace_slot < 0 -> return None
    sema_registration_namespace_owner_at(graph, module_index, name, name_text_hash(name))
}

// sema_registration_namespace_owner of `name`, whose name_text_hash is `hash`.
sema_registration_namespace_owner_at: fn(graph: SemaRegistrationGraph, module_index: Int, name: String, hash: Int) -> SemaRegistrationRowRef? Never! {
    slot: graph.modules[module_index].namespace_slot
    if slot < 0 -> return None
    entry: sema_registration_namespace_entry_hashed(graph, slot, name, hash) ?? return None
    owner: graph.namespace_entry_modules[entry]
    if owner == module_index -> return None
    row: sema_registration_symbol_position(graph.modules[owner], name, hash) ?? return None
    Val(SemaRegistrationRowRef{module_index: owner, row: row})
}

// The words the Prelude derive templates spell (sema_source_words of
// SEMA_PRELUDE_DERIVE_SOURCE). SEMA_PRELUDE_DERIVE_WORDS (PreludeRows.jet) is
// what this returns, written by Compiler/Toolchain/PreludeRows, so a compile
// never scans the derive text.
sema_registration_derive_words: fn() -> [String] Never! {
    seen := name_table_sized(256)
    words := [String]{}
    source: SEMA_PRELUDE_DERIVE_SOURCE.bytes()
    sema_source_words(source, 0, source.len(), seen, words)
    words
}

// The sibling declarations each package member's module
// scope binds (`namespace_bindings`), in entry order. They are the namespace
// names its source can reach (the loader's `namespace_refs`) and those the
// Prelude derive templates spell (SEMA_PRELUDE_DERIVE_WORDS), since derived
// items expand into the module; every namespace name when its items come from
// a template declared elsewhere (`namespace_full`, or any user template
// expansion: `templated`). A name the module declared before its imports
// registered (`own_symbols` rows) or imports binds there instead
// (sema_registration_namespace_collisions).
SEMA_BIND_NAMESPACE_MIN_REFS_PER_THREAD: 2048

sema_registration_bind_namespace_module: fn(graph: SemaRegistrationGraph, own_symbols: [Int], templated: Bool, module_index: Int) -> [SemaRegistrationRowRef] {
    slot: graph.modules[module_index].namespace_slot
    if slot < 0 -> return [SemaRegistrationRowRef]{}
    entries := [Int]{}
    if templated || graph.modules[module_index].namespace_full {
        entries = graph.namespace_entries[slot]
    } else {
        loop name in graph.modules[module_index].namespace_refs {
            if sema_registration_namespace_entry_hashed(graph, slot, name, name_text_hash(name)) == .Val(entry) {
                entries.push(entry)
            }
        }
        loop name in SEMA_PRELUDE_DERIVE_WORDS {
            if sema_registration_namespace_entry_hashed(graph, slot, name, name_text_hash(name)) == .Val(entry) {
                entries.push(entry)
            }
        }
        entries.sort()
    }
    bindings := [SemaRegistrationRowRef]{}
    previous := -1
    loop entry in entries {
        if entry == previous -> next
        previous = entry
        owner_mod: graph.namespace_entry_modules[entry]
        if owner_mod == module_index -> next
        name: graph.namespace_entry_names[entry]
        hash: name_text_hash(name)
        own: sema_registration_symbol_position(graph.modules[module_index], name, hash) ?? -1
        if (own >= 0 && own < own_symbols[module_index]) || sema_registration_import_binding_at(graph.modules[module_index], name, hash) != None {
            next
        }
        owner_row: sema_registration_symbol_position(graph.modules[owner_mod], name, hash) ?? next
        bindings.push(SemaRegistrationRowRef{module_index: owner_mod, row: owner_row})
    }
    bindings
}

sema_registration_bind_namespace_range: fn(graph: SemaRegistrationGraph, own_symbols: [Int], templated: Bool, from: Int, to: Int) -> [[SemaRegistrationRowRef]] {
    out: loop module_index in from..<to -> sema_registration_bind_namespace_module(graph, own_symbols, templated, module_index)
    out
}

sema_registration_bind_namespace_parts: fn(graph: SemaRegistrationGraph, own_symbols: [Int], templated: Bool, bounds: [Int], at: Int) -> [[[SemaRegistrationRowRef]]] {
    done := [[[SemaRegistrationRowRef]]]{}
    if at + 1 >= bounds.len() -> return done
    from: bounds[at]
    to: bounds[at + 1]
    if at + 2 == bounds.len() {
        done.push(sema_registration_bind_namespace_range(graph, own_symbols, templated, from, to))
        return done
    }
    task.group sema_bind_ns_group {
        head: task sema_registration_bind_namespace_range(graph, own_symbols, templated, from, to)
        rest := sema_registration_bind_namespace_parts(graph, own_symbols, templated, bounds, at + 1)
        done.push(compiler_threads_joined(head))
        loop part in rest.move() -> done.push(part)
    }
    done
}

sema_registration_bind_namespaces: fn(graph: ^SemaRegistrationGraph, own_symbols: [Int], templated: Bool, threads: CompilerThreads) {
    if graph.namespace_tables.len() == 0 {
        return
    }
    weights := [Int]{}
    work := 0
    loop module_index in 0..<graph.modules.len() {
        slot: graph.modules[module_index].namespace_slot
        weight: if {
            slot < 0 -> 0
            templated || graph.modules[module_index].namespace_full -> graph.namespace_entries[slot].len()
            else -> graph.modules[module_index].namespace_refs.len() + SEMA_PRELUDE_DERIVE_WORDS.len()
        }
        weights.push(weight)
        work += weight
    }
    workers: compiler_threads_admit(threads, weights.len(), work, SEMA_BIND_NAMESPACE_MIN_REFS_PER_THREAD, 0, 0)
    if workers <= 1 {
        loop module_index in 0..<graph.modules.len() {
            if graph.modules[module_index].namespace_slot < 0 -> next
            graph.modules[module_index].namespace_bindings = sema_registration_bind_namespace_module(graph, own_symbols, templated, module_index)
        }
        return
    }
    parts := sema_registration_bind_namespace_parts(graph, own_symbols, templated, compiler_threads_partition(weights, workers), 0)
    parts.reverse()
    module_index := 0
    loop parts.len() > 0 {
        part := parts.pop() ?? break
        part.reverse()
        loop part.len() > 0 {
            bindings := part.pop() ?? break
            if graph.modules[module_index].namespace_slot >= 0 {
                graph.modules[module_index].namespace_bindings = bindings.move()
            }
            module_index += 1
        }
    }
}

sema_registration_lookup_name: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, name: String) -> SemaRegistrationResolvedSymbol? {
    module_index: sema_registration_module_index(graph, module_identity) ?? return None
    sema_registration_lookup_name_at(graph, module_index, module_identity, name)
}

// sema_registration_lookup_name in the module row `module_index` (the row of
// `module_identity`), for a caller that already holds it.
sema_registration_lookup_name_at: fn(graph: SemaRegistrationGraph, module_index: Int, module_identity: ModuleID, name: String) -> SemaRegistrationResolvedSymbol? {
    sema_registration_lookup_name_hashed(graph, module_index, module_identity, name, name_text_hash(name))
}

// sema_registration_lookup_name_at for a caller that already computed
// `name_text_hash(name)`.
sema_registration_lookup_name_hashed: fn(graph: SemaRegistrationGraph, module_index: Int, module_identity: ModuleID, name: String, hash: Int) -> SemaRegistrationResolvedSymbol? {
    if graph.counting {
        counters := graph.lookup_counters
        permit: counters.guard_read()
        _: permit.value.name_lookups.add(1)
    }
    // The module is passed as a place to a read parameter: binding it here
    // copied the whole module (its program and tables) on every lookup.
    local: sema_registration_lookup_module_probe(graph.modules[module_index], module_index, module_identity, name, hash)
    if local != None -> return local
    if sema_registration_namespace_owner_at(graph, module_index, name, hash) == .Val(owner) {
        return Val(SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Declared{module_index: owner.module_index, row: owner.row}, source_module_identity: graph.modules[owner.module_index].module_identity, target_module_identity: graph.modules[owner.module_index].module_identity, visibility: graph.modules[owner.module_index].symbols[owner.row].visibility, nominal_row: sema_registration_symbol_nominal_row(graph.modules[owner.module_index], owner.module_index, owner.row)})
    }
    builtin: sema_registration_compiler_builtin_row_hashed(graph, name, hash) ?? return None
    // The nominal's symbol is read in place: binding it copied the Symbol.
    owner: graph.modules[builtin.module_index].nominals[builtin.row].symbol.module_identity
    Val(SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Nominal{module_index: builtin.module_index, row: builtin.row}, source_module_identity: owner, target_module_identity: owner, visibility: graph.modules[builtin.module_index].nominals[builtin.row].symbol.visibility, nominal_row: Val(builtin)})
}

// The nominal row `symbols[position]` of module row `module_index`
// registered, as a graph row reference; None for a symbol without one.
sema_registration_symbol_nominal_row: fn(module_row: SemaRegistrationModule, module_index: Int, position: Int) -> SemaRegistrationRowRef? Never! {
    row: module_row.symbol_nominal_rows[position]
    if row < 0 -> return None
    Val(SemaRegistrationRowRef{module_index: module_index, row: row})
}

// A name declared or imported by one module, hashed once (A1).
sema_registration_lookup_module_probe: fn(module_row: SemaRegistrationModule, module_index: Int, module_identity: ModuleID, name: String, hash: Int) -> SemaRegistrationResolvedSymbol? {
    if sema_registration_symbol_position(module_row, name, hash) == .Val(symbol_position) {
        return Val(SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Declared{module_index: module_index, row: symbol_position}, source_module_identity: module_identity, target_module_identity: module_identity, visibility: module_row.symbols[symbol_position].visibility, nominal_row: sema_registration_symbol_nominal_row(module_row, module_index, symbol_position)})
    }
    if sema_registration_import_binding_at(module_row, name, hash) == .Val(binding_ref) {
        binding: binding_ref.binding
        import_index: binding_ref.import_index
        return Val(SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Imported{module_index: module_index, import_index: import_index, binding: binding}, source_module_identity: module_row.imports[import_index].bindings[binding].target_module_identity, target_module_identity: module_row.imports[import_index].bindings[binding].target_module_identity, visibility: module_row.imports[import_index].bindings[binding].visibility})
    }
    None
}

sema_registration_lookup_qualified: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, alias: String, name: String) -> SemaRegistrationResolvedSymbol? {
    module_index: sema_registration_module_index(graph, module_identity) ?? return None
    module_row: graph.modules[module_index]
    loop import in module_row.imports {
        // `use core.mem` selects the Core submodule `mem` from `core`: the
        // alias names the loaded unit its binding holds, not the import's
        // `core` target.
        if import.declaration.kind == .Unqualified(_, _, _, _, _) {
            loop binding in import.bindings {
                if binding.local != alias || binding.symbol.kind != SymbolKind.Import -> next
                core_index: binding.target_module_index ?? next
                resolved: sema_registration_resolve_export(graph, core_index, name, module_identity, module_row.package_identity, [String]{}) ?? return None
                return Val(SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Detached{symbol: sema_registration_export_symbol(graph, resolved)}, source_module_identity: resolved.source_module_identity, target_module_identity: graph.modules[core_index].module_identity, visibility: resolved.visibility})
            }
        }
        if import.declaration.alias != alias || sema_registration_file_import_taken_over(module_row, import) {
            next
        }
        target_index: sema_registration_module_index(graph, import.target_module_identity) ?? return None
        resolved: sema_registration_resolve_export(graph, target_index, name, module_identity, module_row.package_identity, [String]{}) ?? return None
        return Val(SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Detached{symbol: sema_registration_export_symbol(graph, resolved)}, source_module_identity: resolved.source_module_identity, target_module_identity: import.target_module_identity, visibility: resolved.visibility})
    }
    None
}

// The loaded unit of a Core module: the loader loads one unit per Core module
// name (jet_driver_core_unit), and its identity is the unit's source path,
// not the module name a namespace binding records.
sema_registration_core_unit_index: fn(graph: SemaRegistrationGraph, module_name: String) -> Int? {
    loop index in 0..<graph.modules.len() {
        if graph.modules[index].module_name == module_name && module_is_core(graph.modules[index].module_identity) {
            return Val(index)
        }
    }
    None
}

// The default expression `reference` names. Its owner is one keyed callable
// lookup; trait method declarations, which are not callable rows, are searched
// only when the owner is not one.
sema_registration_resolve_default: fn(graph: SemaRegistrationGraph, reference: FunctionDefaultRef) -> Expr? {
    if sema_registration_callable_row(graph, reference.owner_key) == .Val(row) {
        if row == {
            .Function(module_index, index) -> {
                if reference.source_file != "" {
                    source: sema_source_file_at(graph.modules[module_index].source_segments, graph.modules[module_index].source_file, graph.modules[module_index].source_origin, reference.span)
                    if source != reference.source_file -> return None
                }
                return sema_registration_parameter_default(graph.modules[module_index].functions[index].parameters, reference)
            }
            .NominalMethod(module_index, owner, index) -> return sema_registration_parameter_default(graph.modules[module_index].nominals[owner].methods[index].parameters, reference)
            .ImplMethod(module_index, owner, index) -> return sema_registration_parameter_default(graph.modules[module_index].impls[owner].methods[index].parameters, reference)
            .Foreign(_, _) -> {}
        }
    }
    owner: symbol_find(graph.symbols, reference.owner_key) ?? return None
    loop module_row_index in 0..<graph.modules.len() {
        loop nominal_index in 0..<graph.modules[module_row_index].nominals.len() {
            loop method_index in 0..<graph.modules[module_row_index].nominals[nominal_index].trait_methods.len() {
                if graph.modules[module_row_index].nominals[nominal_index].trait_methods[method_index].symbol.id == owner {
                    return sema_registration_parameter_default(graph.modules[module_row_index].nominals[nominal_index].trait_methods[method_index].parameters, reference)
                }
            }
        }
    }
    None
}

sema_registration_parameter_default: fn(parameters: [SemaRegistrationParameter], reference: FunctionDefaultRef) -> Expr? {
    if reference.parameter_index < 0 || reference.parameter_index >= parameters.len() -> return None
    parameter: parameters[reference.parameter_index]
    if parameter.default_ref != reference -> return None
    parameter.default
}

sema_registration_apply_graph_module: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, scopes: ^SemaScopeTable, diagnostics: ^[Diagnostic]) -> Bool {
    waiting := [SemaComptimeWaitingConstant]{}
    sema_registration_apply_graph_module_rows(graph, module_identity, scopes, diagnostics, waiting)
}

// sema_registration_apply_graph_module that also records in `waiting` each
// binding it pushes for a constant still waiting for its known-time type,
// with the graph row the binding was copied from. The module's package
// names (`namespace_bindings`) bind after its own declarations and the
// imports before `namespace_import_split`: the package namespace comes after
// locals and imports.
sema_registration_apply_graph_module_rows: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, scopes: ^SemaScopeTable, diagnostics: ^[Diagnostic], waiting: ^[SemaComptimeWaitingConstant]) -> Bool {
    module_index: sema_registration_module_index(graph, module_identity) ?? return false
    module_row: graph.modules[module_index]
    complete := true
    // The table's name resolutions count into the graph's counters while it
    // counts (SemaLookupCounters).
    if graph.counting {
        scopes.lookup_counters = Val(SemaScopeLookupCounters{counters: graph.lookup_counters})
    }
    sema_scope_seed_unit_policy(scopes, graph, module_identity)
    if !sema_scope_add_compiler_builtin(scopes, graph) -> complete = false
    loop (position, symbol) in module_row.symbols {
        if !sema_scope_add_module_symbol(scopes, symbol, symbol_table_key(graph.symbols, symbol.id)) {
            why: if symbol.kind == SymbolKind.Function -> "every function needs a unique name so calls aren't ambiguous" else -> "module declarations share one namespace"
            diagnostics.push(sema_diagnostic_with_source_location(sema_defined_twice(symbol.name, why, symbol.span), module_row.source_segments))
            complete = false
        } else if sema_comptime_symbol_waits(symbol) {
            waiting.push(SemaComptimeWaitingConstant{binding: scopes.bindings.len() - 1, source: SemaComptimeWaitingSource.Symbol{position: position}})
        }
    }
    namespace_from: if module_row.namespace_import_split < 0 -> module_row.imports.len() else -> module_row.namespace_import_split
    loop (import_index, import) in module_row.imports {
        if import_index == namespace_from && !sema_registration_apply_namespace(graph, module_index, scopes, diagnostics, waiting) {
            complete = false
        }
        loop (binding_index, binding) in import.bindings {
            resolved_symbol: sema_registration_binding_symbol(graph, binding)
            if !sema_scope_add_module_symbol(scopes, resolved_symbol, symbol_table_key(graph.symbols, resolved_symbol.id)) {
                diagnostics.push(sema_diagnostic_with_source_location(sema_defined_twice(binding.local, "imported names share the module namespace", resolved_symbol.span), module_row.source_segments))
                complete = false
            } else if sema_comptime_symbol_waits(resolved_symbol) {
                waiting.push(SemaComptimeWaitingConstant{binding: scopes.bindings.len() - 1, source: SemaComptimeWaitingSource.Import{import_index: import_index, binding: binding_index}})
            }
        }
    }
    if namespace_from >= module_row.imports.len() && !sema_registration_apply_namespace(graph, module_index, scopes, diagnostics, waiting) {
        complete = false
    }
    complete
}

// Binds the module's package names (`namespace_bindings`), each from its
// declaring member's current symbol row.
sema_registration_apply_namespace: fn(graph: SemaRegistrationGraph, module_index: Int, scopes: ^SemaScopeTable, diagnostics: ^[Diagnostic], waiting: ^[SemaComptimeWaitingConstant]) -> Bool {
    complete := true
    loop owner_index in 0..<graph.modules[module_index].namespace_bindings.len() {
        symbol: graph.modules[graph.modules[module_index].namespace_bindings[owner_index].module_index].symbols[graph.modules[module_index].namespace_bindings[owner_index].row]
        if !sema_scope_add_module_symbol(scopes, symbol, symbol_table_key(graph.symbols, symbol.id)) {
            diagnostics.push(sema_diagnostic_with_source_location(sema_defined_twice(symbol.name, "imported names share the module namespace", symbol.span), graph.modules[module_index].source_segments))
            complete = false
        } else if sema_comptime_symbol_waits(symbol) {
            waiting.push(SemaComptimeWaitingConstant{binding: scopes.bindings.len() - 1, source: SemaComptimeWaitingSource.Namespace{module_index: graph.modules[module_index].namespace_bindings[owner_index].module_index, position: graph.modules[module_index].namespace_bindings[owner_index].row}})
        }
    }
    complete
}
