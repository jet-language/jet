// `#Layout(U8) Mode: enum { Read = 1, Write }`
// is a numbered enum. Each case's number is its written value, or one more
// than the case before it (the first case counts from 0). Before
// registration the enum gains two ordinary methods, so every tier runs the
// same source:
//   `mode.to_int() -> Int`             the case's number
//   `Mode.from_int(value: Int) -> Mode Err!`      the case with that number,
//                                     an error saying the backing can't hold
//                                     the number, or an error naming a number
//                                     the backing holds but no case has
// A case payload (E1120), a number outside the backing type (E1121) and a
// number two cases share (E1122) are refused; a case number is an integer
// literal (E0035), so the checks see every number. E1120's edit deletes the
// `#Layout` line, and E1121's names the narrowest backing type that holds
// every case number.
//
// `#[Specified, Layout(U8)]` makes every case of a numbered enum state its
// number, so adding or moving a case renumbers no other: a case without one
// is E1124, and `#Specified` on a type without case numbers is E1125.
use {
    jet_foundation.[
        Diagnostic,
        EnumDef,
        Expr,
        Func,
        Item,
        Marker,
        Span,
        TextEdit,
        UnOp,
        diagnostic_with_edit,
        expr_span,
        jet_layout_integer_backing_max,
        jet_layout_integer_backing_min,
        jet_target_layout_enum_backing,
        jet_target_layout_enum_c_tag,
        jet_target_layout_marker_expression,
    ]
    jet_parser.[
        parse_source,
    ]
}

sema_enum_numbers_expand: fn(items: &[Item], source: String, diagnostics: &[Diagnostic]) {
    loop index in 0..<items.len() {
        if items[index] == .Struct(definition) {
            if sema_enum_numbers_marker(definition.type_markers, "Specified") == .Val(specified) -> diagnostics.push(sema_enum_numbers_unnumbered_specified(specified, "struct `{definition.name}`, which has no cases"))
        }
        if items[index] == .Enum(definition) {
            sema_enum_numbers_check_specified(definition, diagnostics)
            backing: jet_target_layout_enum_backing(definition) ?? next
            numbers: sema_enum_numbers_checked(definition, backing, source, diagnostics) ?? next
            methods: sema_enum_numbers_methods(definition, backing, numbers, diagnostics) ?? next
            updated := definition
            // The methods are the compiler's: they report at the enum, and
            // their bodies' spans index the generated fragment, not the
            // user's file, so a refused number is no journey site (JetIR
            // ir_generated_fragment_function).
            loop method in methods {
                generated := method
                generated.span = definition.span
                generated.name_span = definition.name_span
                generated.compiler_generated = true
                updated.methods.push(generated)
            }
            items[index] = Item.Enum{value: updated}
        }
    }
}

// E1124 for each case of a `#Specified` enum that states no number, E1125
// when the enum numbers no case.
sema_enum_numbers_check_specified: fn(definition: EnumDef, diagnostics: &[Diagnostic]) {
    specified: sema_enum_numbers_marker(definition.type_markers, "Specified") ?? return
    if jet_target_layout_enum_backing(definition) == None && jet_target_layout_enum_c_tag(definition) == None {
        diagnostics.push(sema_enum_numbers_unnumbered_specified(specified, "enum `{definition.name}`, whose cases have no numbers"))
        return
    }
    next_number := 0
    loop variant in definition.variants {
        if variant.discriminant_expr == .Val(expression) {
            if sema_enum_numbers_literal(expression) == .Val(written) -> next_number = if written == 9223372036854775807 -> written else -> written + 1
            next
        }
        diagnostics.push(sema_error("E1124", variant.name_span, "case `{variant.name}` of `{definition.name}` states no number", "`#Specified` makes every case of `{definition.name}` state its number, so adding or moving a case renumbers no other", "write the number: `{variant.name} = {next_number}`"))
        next_number = if next_number == 9223372036854775807 -> next_number else -> next_number + 1
    }
}

sema_enum_numbers_unnumbered_specified: fn(specified: Marker, subject: String) -> Diagnostic {
    sema_error("E1125", specified.span, "`#Specified` is on {subject}", "`#Specified` makes every case of a numbered enum state its number, and only a `#Layout(U8)`-style or `#Layout(c)` enum numbers its cases", "number the cases with a backing such as `#Layout(U8)`, or remove `#Specified`")
}

sema_enum_numbers_marker: fn(markers: [Marker], name: String) -> Marker? {
    loop candidate in markers {
        if candidate.name == name -> return Val(candidate.copy())
    }
    None
}

// Every case's number in declaration order, or None after a diagnostic.
sema_enum_numbers_checked: fn(definition: EnumDef, backing: String, source: String, diagnostics: &[Diagnostic]) -> [Int]? {
    marker: sema_enum_numbers_layout_marker(definition)
    loop variant in definition.variants {
        if !(variant.payload == .Unit) {
            diagnostic := sema_error("E1120", marker.span, "`#Layout({backing})` backs only a payload-free enum, and case `{variant.name}` of `{definition.name}` carries a payload", "a backing type gives each case one number; a case with fields is more than a number", "remove the payload from `{variant.name}`, or remove `#Layout({backing})` and convert with your own methods")
            if sema_enum_numbers_marker_removal(marker, source) == .Val(edit) -> diagnostic = diagnostic_with_edit(diagnostic, edit)
            diagnostics.push(diagnostic)
            return None
        }
    }
    least: jet_layout_integer_backing_min(backing)
    greatest: jet_layout_integer_backing_max(backing)
    numbers := [Int]{}
    valid := true
    // The first E1121, which carries the edit that widens the backing.
    first_range := -1
    next_number := 0
    loop variant in definition.variants {
        number := next_number
        if variant.discriminant_expr == .Val(expression) {
            if sema_enum_numbers_literal(expression) == .Val(written) {
                number = written
                if number < least || number > greatest {
                    if first_range < 0 -> first_range = diagnostics.len()
                    diagnostics.push(sema_error("E1121", expr_span(expression), "case `{variant.name}` is {number}, which `{backing}` can't hold", "`#Layout({backing})` stores every case number of `{definition.name}` as a `{backing}` ({least} to {greatest})", "use a number from {least} to {greatest}, or a wider backing type"))
                    valid = false
                }
            } else {
                diagnostics.push(sema_error("E0035", expr_span(expression), "case `{variant.name}` of `{definition.name}` needs a literal number", "`#Layout({backing})` case numbers are checked against `{backing}` and against each other where the enum is declared", "write the number as an integer literal, such as `{variant.name} = {next_number}`"))
                valid = false
            }
        } else if number > greatest {
            if first_range < 0 -> first_range = diagnostics.len()
            diagnostics.push(sema_error("E1121", variant.name_span, "case `{variant.name}` counts up to {number}, which `{backing}` can't hold", "a case without a number is one more than the case before it, and `#Layout({backing})` stores numbers from {least} to {greatest}", "give `{variant.name}` a number from {least} to {greatest}, or use a wider backing type"))
            valid = false
        }
        loop earlier in 0..<numbers.len() {
            if numbers[earlier] == number {
                diagnostics.push(sema_error("E1122", variant.name_span, "cases `{definition.variants[earlier].name}` and `{variant.name}` of `{definition.name}` are both {number}", "`{definition.name}.from_int({number})` has to name one case", "give `{variant.name}` a number no other case uses"))
                valid = false
                break
            }
        }
        numbers.push(number)
        // The greatest Int has no successor; a following unnumbered case is
        // refused by the range check above.
        next_number = if number == 9223372036854775807 -> number else -> number + 1
    }
    if first_range >= 0 {
        if sema_enum_numbers_widened(marker, backing, numbers) == .Val(edit) -> diagnostics[first_range] = diagnostic_with_edit(diagnostics[first_range], edit)
    }
    if !valid -> return None
    Val(numbers)
}

// The edit that names, in place of `backing`, the narrowest backing type that
// holds every case number: unsigned unless `backing` or a number is signed.
// None when no backing type holds them all.
sema_enum_numbers_widened: fn(marker: Marker, backing: String, numbers: [Int]) -> TextEdit? {
    written: jet_target_layout_marker_expression(marker, 0) ?? return None
    least := 0
    greatest := 0
    loop number in numbers {
        if number < least -> least = number
        if number > greatest -> greatest = number
    }
    candidates: if least < 0 || backing.starts_with("I") -> [String]{"I8", "I16", "I32", "I64"} else -> [String]{"U8", "U16", "U32", "U64"}
    loop candidate in candidates {
        if jet_layout_integer_backing_min(candidate) <= least && jet_layout_integer_backing_max(candidate) >= greatest -> return Val(TextEdit{span: expr_span(written), new_text: candidate})
    }
    None
}

// The edit that deletes a `#Layout(…)` marker written alone on its line, with
// that line. None for a marker that shares its line, sits in a `#[…]` list or
// is written inside the body.
sema_enum_numbers_marker_removal: fn(marker: Marker, source: String) -> TextEdit? {
    if marker.inside -> return None
    raw: source.bytes()
    start: marker.span.start
    end: marker.span.end
    if start < 0 || end > raw.len() || start >= end || raw[start] != (U8{35}) -> return None
    line_start := start
    loop line_start > 0 && (raw[line_start - 1] == (U8{32}) || raw[line_start - 1] == (U8{9})) -> line_start -= 1
    if line_start > 0 && raw[line_start - 1] != (U8{10}) -> return None
    line_end := end
    loop line_end < raw.len() && (raw[line_end] == (U8{32}) || raw[line_end] == (U8{9}) || raw[line_end] == (U8{13})) -> line_end += 1
    if line_end >= raw.len() || raw[line_end] != (U8{10}) -> return None
    Val(TextEdit{span: Span{start: line_start, end: line_end + 1}, new_text: ""})
}

sema_enum_numbers_layout_marker: fn(definition: EnumDef) -> Marker Never! {
    loop candidate in definition.type_markers {
        if candidate.name == "Layout" -> return candidate
    }
    panic("a backed enum has a `#Layout` marker")
}

sema_enum_numbers_literal: fn(expression: Expr) -> Int? {
    if expression == {
        .Int(number, _, _, _, _) -> Val(number)
        .Unary(op, operand, _, _) -> {
            if op != UnOp.Neg -> return None
            if operand == {
                .Int(number, _, _, _, _) -> Val(0 - number)
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// The generated `to_int` and `from_int`, omitting a method the enum declares
// itself. `to_int` is written `Never!`: a generated method is no candidate
// of the failure solve (sema_failure_inference_candidate), so an unwritten
// route would stay the default `Err!` and every caller would have to handle
// a failure a case number can't have. `from_int` tells a number the backing
// type can't hold apart from a number it holds that no case has.
sema_enum_numbers_methods: fn(definition: EnumDef, backing: String, numbers: [Int], diagnostics: &[Diagnostic]) -> [Func]? {
    has_to_int: loop method in definition.methods {
        if method.name == "to_int" -> break true
    } ?? false
    has_from_int: loop method in definition.methods {
        if method.name == "from_int" -> break true
    } ?? false
    if has_to_int && has_from_int -> return Val([Func]{})
    name: definition.name
    out := [String]{}
    out.push("impl {name} {{\n")
    if !has_to_int {
        out.push("    to_int: fn(self) -> Int Never! {{\n        if self == {{\n")
        loop index in 0..<numbers.len() -> out.push("            .{definition.variants[index].name} -> {numbers[index]}\n")
        out.push("        }}\n    }}\n")
    }
    if !has_from_int {
        out.push("    from_int: fn(value: Int) -> {name} Err! {{\n")
        outside := [String]{}
        least: jet_layout_integer_backing_min(backing)
        greatest: jet_layout_integer_backing_max(backing)
        if least > -9223372036854775807 - 1 -> outside.push("value < {least}")
        if greatest < 9223372036854775807 -> outside.push("value > {greatest}")
        if outside.len() > 0 -> out.push("        if {outside.join(" || ")} -> return Err(\"{{value}} doesn't fit `{backing}`, the backing of `{name}`\")\n")
        out.push("        if value == {{\n")
        loop index in 0..<numbers.len() -> out.push("            {numbers[index]} -> Ok({name}.{definition.variants[index].name})\n")
        out.push("            else -> Err(\"{{value}} is not a case number of `{name}`\")\n        }}\n    }}\n")
    }
    out.push("}}\n")
    parsed: parse_source(out.join("").bytes())
    if parsed.diagnostics.len() > 0 || parsed.program.items.len() != 1 {
        diagnostics.push(sema_error("E0153", definition.name_span, "enum `{name}` failed to expand its `to_int` and `from_int` methods", "the compiler generates them from the `#Layout` case numbers, and a fragment did not parse", "check the enum declaration for typos; if this persists, file a bug"))
        return None
    }
    if parsed.program.items[0] == {
        .Impl(block) -> Val(block.methods)
        .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}
