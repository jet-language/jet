// Owner ruling (#6176): `Name: path` at file or module
// scope means what its path names. The parser cannot tell `RNG: random.RNG`
// from `MAX: other.MAX`, so it reads every bare-path right-hand side as a
// constant binding (parser_path_binding_ahead_at). Before any module
// registers, each such binding whose path resolves to a type becomes a
// transparent type alias; every other one stays a constant. The name's casing
// never decides.
//
// The path resolves the way a name does: the declaring scope (an inline module
// body, then each enclosing scope), that scope's imports, then the types every
// module sees (primitives, the compiler builtins, Core root types, a type a
// loaded module declares). A path through a type (`Finish.Gloss`) names a
// value. A binding whose path names another such binding takes that one's
// meaning; a cycle, or a path that resolves to nothing, stays a constant and
// is reported as one.
use jet_foundation.[
    ConstDef,
    Expr,
    ImportDecl,
    Item,
    NameTable,
    Span,
    Type,
    TypeAliasDef,
    TypeParam,
    core_root_type,
    expr_span,
    foundation_named_type,
    import_walk_bindings,
    name_find,
    name_index,
    name_intern,
    name_table_sized,
]

SemaAliasMeaning: enum {
    Type,
    Value,
    Module,
    Unknown,
}

// What one declaration of a scope means for a path that reaches it.
SemaAliasDeclared: struct {
    meaning: SemaAliasMeaning,
    // A bare-path constant binding: its own path, still to resolve.
    binding: [String]?,
}

// The lookup state of one path: the module input it resolves in, the inline
// module scope inside that input, and the binding chain depth.
SemaAliasSite: struct {
    input: Int,
    scope: [String],
    depth: Int,
}

SEMA_ALIAS_MAX_DEPTH: 32

// The names the inputs declare at their top level as types, kept as the
// inputs are rewritten: per name id in `names`, how many inputs' first
// top-level declaration of it is a type (sema_alias_declared_in). `seen`
// stamps the ids one input's count has passed, with `stamp`.
SemaAliasGlobals: struct {
    names: NameTable,
    types: [Int],
    seen: [Int],
    stamp: Int,
}

// Rewrites, in place, every bare-path binding whose path names a type into a
// type alias. Modules without such a binding are not walked again. A bare
// name every module sees reads the inputs' top-level types, counted once and
// kept as each module's bindings are rewritten, not walked over every input
// for each name.
sema_alias_classify_inputs: fn(inputs: ^[SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge]) Never! {
    rows := [U32:Int]{}
    pending := [Int]{}
    globals := SemaAliasGlobals{names: name_table_sized(64), types: [Int]{0}, seen: [Int]{0}, stamp: 0}
    loop index in 0..<inputs.len() {
        rows[inputs[index].module_identity.id] = index
        if sema_alias_items_bind_paths(inputs[index].program.items) -> pending.push(index)
        sema_alias_globals_add(globals, inputs[index].program.items, 1)
    }
    loop index in pending {
        keys := [SemaAliasKey]{}
        sema_alias_collect_types(inputs, edges, rows, globals, index, inputs[index].program.items, [String]{}, keys)
        if keys.len() > 0 {
            sema_alias_globals_add(globals, inputs[index].program.items, -1)
            inputs[index].program.items = sema_alias_rewrite_items(inputs[index].program.items, keys)
            sema_alias_globals_add(globals, inputs[index].program.items, 1)
        }
    }
}

// Adds `delta` to the count of each name whose first declaration among
// `items`, one input's top level, is a type.
sema_alias_globals_add: fn(globals: ^SemaAliasGlobals, items: [Item], delta: Int) Never! {
    globals.stamp += 1
    loop item in items {
        name: sema_alias_item_name(item)
        if name == "" -> next
        id: name_index(name_intern(globals.names, name))
        loop globals.types.len() <= id {
            globals.types.push(0)
            globals.seen.push(0)
        }
        if globals.seen[id] == globals.stamp -> next
        globals.seen[id] = globals.stamp
        if sema_alias_item_declares(item, name).meaning == .Type {
            globals.types[id] = globals.types[id] + delta
        }
    }
}

// The name `item` declares in its scope (sema_alias_item_declares), "" for
// none.
sema_alias_item_name: fn(item: Item) -> String Never! {
    if item == {
        .Struct(value) -> value.name
        .Enum(value) -> value.name
        .Distinct(value) -> value.name
        .TypeAlias(value) -> value.name
        .Trait(value) -> value.name
        .Tag(value) -> value.name
        .UnitFamily(value) -> value.family
        .Func(value) -> value.name
        .Const(value) -> value.name
        .CodeModule(value) -> value.name
        .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> ""
    }
}

sema_alias_items_bind_paths: fn(items: [Item]) -> Bool Never! {
    loop index in 0..<items.len() {
        if items[index] == .Const(definition) {
            if sema_alias_binding_path(definition) != None -> return true
        }
        if items[index] == .CodeModule(code_module) {
            if code_module.body == .Val(body) {
                if sema_alias_items_bind_paths(body) -> return true
            }
        }
    }
    false
}

// The path of a plain `Name: path` binding: immutable, untyped, unmarked, and
// a right-hand side that is only a dotted name.
sema_alias_binding_path: fn(definition: ConstDef) -> [String]? Never! {
    if definition.mutable || definition.is_comptime || definition.is_persist || definition.ty != None || definition.meta != None || definition.ct != None || definition.attrs.len() > 0 {
        return None
    }
    sema_alias_expr_path(definition.value)
}

sema_alias_expr_path: fn(value: Expr) -> [String]? Never! {
    if value == {
        .Ident(name, _, _) -> Val([String]{name})
        .Field(base, member, _, _) -> {
            parts := sema_alias_expr_path(base) ?? return None
            parts.push(member.copy())
            Val(parts)
        }
        .EnumLit(type_name, variant, _, args, leading_dot, _, _) -> {
            if leading_dot || args.len() > 0 || type_name == "" -> return None
            parts := type_name.split(".").to_list()
            parts.push(variant.copy())
            Val(parts)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// The span of a binding's dotted path, from its first name to its last, as a
// written type's span covers the whole path: a Field's own span is only its
// member's.
sema_alias_expr_path_span: fn(value: Expr) -> Span Never! {
    if value == .Field(base, _, span, _) {
        return Span{start: sema_alias_expr_path_span(base).start, end: span.end}
    }
    expr_span(value)
}

// A binding the rewrite turns into a type alias: its name where it is
// declared.
SemaAliasKey: struct {
    start: Int,
    end: Int,
    name: String,
}

sema_alias_key: fn(definition: ConstDef) -> SemaAliasKey Never! {
    SemaAliasKey{start: definition.name_span.start, end: definition.name_span.end, name: definition.name}
}

// Whether `keys` holds `definition`'s key.
sema_alias_keyed: fn(keys: [SemaAliasKey], definition: ConstDef) -> Bool Never! {
    loop key in keys {
        if key.start == definition.name_span.start && key.end == definition.name_span.end && key.name == definition.name {
            return true
        }
    }
    false
}

sema_alias_collect_types: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], rows: [U32:Int], globals: SemaAliasGlobals, index: Int, items: [Item], scope: [String], keys: ^[SemaAliasKey]) Never! {
    loop item_index in 0..<items.len() {
        if items[item_index] == .Const(definition) {
            path: sema_alias_binding_path(definition) ?? next
            if sema_alias_path_meaning(inputs, edges, rows, globals, SemaAliasSite{input: index, scope: scope, depth: 0}, path) == .Type {
                keys.push(sema_alias_key(definition))
            }
        }
        if items[item_index] == .CodeModule(code_module) {
            if code_module.body == .Val(body) {
                inner := scope
                inner.push(code_module.name)
                sema_alias_collect_types(inputs, edges, rows, globals, index, body, inner, keys)
            }
        }
    }
}

sema_alias_rewrite_items: fn(items: [Item], keys: [SemaAliasKey]) -> [Item] Never! {
    rewritten := [Item]{}
    loop item in items {
        value := item.copy()
        if item == {
            .Const(definition) -> {
                if sema_alias_keyed(keys, definition) {
                    path: sema_alias_binding_path(definition) ?? [String]{}
                    value = Item.TypeAlias{value: TypeAliasDef{is_pub: definition.is_pub, is_package_pub: definition.is_package_pub, name: definition.name, name_span: definition.name_span, type_params: [TypeParam]{}, target: foundation_named_type(path.join(".")), target_span: sema_alias_expr_path_span(definition.value), span: definition.span}}
                }
            }
            .CodeModule(code_module) -> {
                row := code_module.copy()
                if code_module.body == .Val(body) {
                    row.body = Val(sema_alias_rewrite_items(body, keys))
                }
                value = Item.CodeModule{value: row}
            }
            .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
        rewritten.push(value)
    }
    rewritten
}

// The meaning of `path` written in `site`: each scope from the innermost
// outward, with its imports, then the global types.
sema_alias_path_meaning: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], rows: [U32:Int], globals: SemaAliasGlobals, site: SemaAliasSite, path: [String]) -> SemaAliasMeaning Never! {
    if site.depth > SEMA_ALIAS_MAX_DEPTH || path.len() == 0 -> return .Unknown
    level := site.scope.len()
    loop level >= 0 {
        scope: site.scope.slice(0, level)
        declared: sema_alias_declared_in(inputs[site.input].program.items, scope, 0, path[0])
        if declared.meaning != .Unknown {
            return sema_alias_follow(inputs, edges, rows, globals, SemaAliasSite{input: site.input, scope: scope, depth: site.depth}, declared, path)
        }
        imported: sema_alias_imported(inputs, edges, rows, globals, SemaAliasSite{input: site.input, scope: scope, depth: site.depth}, path, false)
        if imported != .Unknown -> return imported
        level -= 1
    }
    if path.len() == 1 && sema_alias_global_type(globals, path[0]) -> return SemaAliasMeaning.Type
    SemaAliasMeaning.Unknown
}

// The meaning of `path` as a member of the scope `site` names in another
// module: its declarations, then what it re-exports.
sema_alias_member_meaning: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], rows: [U32:Int], globals: SemaAliasGlobals, site: SemaAliasSite, path: [String]) -> SemaAliasMeaning Never! {
    if site.depth > SEMA_ALIAS_MAX_DEPTH || path.len() == 0 -> return .Unknown
    declared: sema_alias_declared_in(inputs[site.input].program.items, site.scope, 0, path[0])
    if declared.meaning != .Unknown {
        return sema_alias_follow(inputs, edges, rows, globals, site, declared, path)
    }
    sema_alias_imported(inputs, edges, rows, globals, site, path, true)
}

// The meaning of `path` whose head names `declared` in `site`.
sema_alias_follow: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], rows: [U32:Int], globals: SemaAliasGlobals, site: SemaAliasSite, declared: SemaAliasDeclared, path: [String]) -> SemaAliasMeaning Never! {
    rest: path.slice(1, path.len())
    if declared.meaning == {
        .Type -> if rest.len() == 0 -> .Type else -> .Value
        .Value -> {
            if rest.len() > 0 -> return .Value
            binding: declared.binding ?? return .Value
            sema_alias_path_meaning(inputs, edges, rows, globals, SemaAliasSite{input: site.input, scope: site.scope, depth: site.depth + 1}, binding)
        }
        .Module -> {
            if rest.len() == 0 -> return .Unknown
            inner := site.scope
            inner.push(path[0])
            sema_alias_member_meaning(inputs, edges, rows, globals, SemaAliasSite{input: site.input, scope: inner, depth: site.depth + 1}, rest)
        }
        .Unknown -> .Unknown
    }
}

// The declaration named `name` directly in the scope `scope` of `items`.
sema_alias_declared_in: fn(items: [Item], scope: [String], from: Int, name: String) -> SemaAliasDeclared Never! {
    if from < scope.len() {
        loop index in 0..<items.len() {
            if items[index] == .CodeModule(code_module) {
                if code_module.name == scope[from] && code_module.body == .Val(body) {
                    return sema_alias_declared_in(body, scope, from + 1, name)
                }
            }
        }
        return SemaAliasDeclared{meaning: .Unknown, binding: None}
    }
    loop index in 0..<items.len() {
        declared: sema_alias_item_declares(items[index], name)
        if declared.meaning != .Unknown -> return declared
    }
    SemaAliasDeclared{meaning: .Unknown, binding: None}
}

// What `item` means when it declares `name`; `.Unknown` otherwise.
sema_alias_item_declares: fn(item: Item, name: String) -> SemaAliasDeclared Never! {
    meaning: if item == {
        .Struct(value) -> sema_alias_meaning_if(value.name == name, .Type)
        .Enum(value) -> sema_alias_meaning_if(value.name == name, .Type)
        .Distinct(value) -> sema_alias_meaning_if(value.name == name, .Type)
        .TypeAlias(value) -> sema_alias_meaning_if(value.name == name, .Type)
        .Trait(value) -> sema_alias_meaning_if(value.name == name, .Type)
        .Tag(value) -> sema_alias_meaning_if(value.name == name, .Type)
        .UnitFamily(value) -> sema_alias_meaning_if(value.family == name, .Type)
        .Func(value) -> sema_alias_meaning_if(value.name == name, .Value)
        .Const(value) -> sema_alias_meaning_if(value.name == name, .Value)
        .CodeModule(value) -> sema_alias_meaning_if(value.name == name, .Module)
        .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> SemaAliasMeaning.Unknown
    }
    if meaning == .Value && item == .Const(value) {
        return SemaAliasDeclared{meaning: meaning, binding: sema_alias_binding_path(value)}
    }
    SemaAliasDeclared{meaning: meaning, binding: None}
}

sema_alias_meaning_if: fn(matches: Bool, meaning: SemaAliasMeaning) -> SemaAliasMeaning Never! {
    if matches -> meaning else -> .Unknown
}

// The meaning of `path` through an import of the scope `site`. A module's
// member (`exported`) is reached only through its re-exports.
sema_alias_imported: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], rows: [U32:Int], globals: SemaAliasGlobals, site: SemaAliasSite, path: [String], exported: Bool) -> SemaAliasMeaning Never! {
    identity: inputs[site.input].module_identity
    source_scope: site.scope.join(".")
    loop edge in edges {
        if edge.source_module_identity != identity || edge.source_scope != source_scope -> next
        if exported && !edge.declaration.is_pub -> next
        target: rows.get(edge.target_module_identity.id) ?? next
        meaning: sema_alias_import_meaning(inputs, edges, rows, globals, SemaAliasSite{input: target, scope: [String]{}, depth: site.depth + 1}, edge.declaration, path)
        if meaning != .Unknown -> return meaning
    }
    SemaAliasMeaning.Unknown
}

sema_alias_import_meaning: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], rows: [U32:Int], globals: SemaAliasGlobals, target: SemaAliasSite, declaration: ImportDecl, path: [String]) -> SemaAliasMeaning Never! {
    rest: path.slice(1, path.len())
    loop binding in import_walk_bindings(declaration) {
        if binding.original == .Val(original) {
            if binding.local != path[0] -> next
            member := original.split(".").to_list()
            loop part in rest -> member.push(part)
            return sema_alias_member_meaning(inputs, edges, rows, globals, target, member)
        }
        parts: binding.local.split(".").to_list()
        if binding.local != path[0] && parts[parts.len() - 1] != path[0] -> next
        if rest.len() == 0 -> return .Unknown
        return sema_alias_member_meaning(inputs, edges, rows, globals, target, rest)
    }
    SemaAliasMeaning.Unknown
}

// A bare name every module sees as a type: a built-in type, or a type some
// input declares first at its top level.
sema_alias_global_type: fn(globals: SemaAliasGlobals, name: String) -> Bool Never! {
    if foundation_named_type(name) != (Type.Named{name: name}) -> return true
    if name == "Unit" || name == "Never" || name == "Err" || sema_registration_core_builtin_is_name(name) || core_root_type(name) {
        return true
    }
    id: name_index(name_find(globals.names, name) ?? return false)
    globals.types[id] > 0
}
