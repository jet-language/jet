// Owner ruling (#6176): `Name: path` at file or module
// scope means what its path names. The parser cannot tell `RNG: random.RNG`
// from `MAX: other.MAX`, so it reads every bare-path right-hand side as a
// constant binding (parser_path_binding_ahead_at). Before any module
// registers, each such binding whose path resolves to a type becomes a
// transparent type alias; every other one stays a constant. The name's casing
// never decides.
//
// The path resolves the way a name does: the declaring scope (an inline module
// body, then each enclosing scope), that scope's imports, then the types every
// module sees (primitives, the compiler builtins, Core root types, a type a
// loaded module declares). A path through a type (`Finish.Gloss`) names a
// value. A binding whose path names another such binding takes that one's
// meaning; a cycle, or a path that resolves to nothing, stays a constant and
// is reported as one.
use jet_foundation.[
    ConstDef,
    Expr,
    ImportDecl,
    Item,
    Type,
    TypeAliasDef,
    TypeParam,
    core_root_type,
    expr_span,
    foundation_named_type,
    import_walk_bindings,
]

SemaAliasMeaning: enum {
    Type
    Value
    Module
    Unknown
}

// What one declaration of a scope means for a path that reaches it.
SemaAliasDeclared: struct {
    meaning: SemaAliasMeaning
    // A bare-path constant binding: its own path, still to resolve.
    binding: [String]?
}

// The lookup state of one path: the module input it resolves in, the inline
// module scope inside that input, and the binding chain depth.
SemaAliasSite: struct {
    input: Int
    scope: [String]
    depth: Int
}

SEMA_ALIAS_MAX_DEPTH: 32

// Rewrites, in place, every bare-path binding whose path names a type into a
// type alias. Modules without such a binding are not walked again.
sema_alias_classify_inputs: fn(inputs: &[SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge]) Never! {
    rows := [String:Int]{}
    pending := [Int]{}
    loop index in 0..<inputs.len() {
        rows[inputs[index].module_identity] = index
        if sema_alias_items_bind_paths(inputs[index].program.items) -> pending.push(index)
    }
    loop index in pending {
        keys := [String]{}
        sema_alias_collect_types(inputs, edges, rows, index, inputs[index].program.items, [String]{}, keys)
        if keys.len() > 0 -> inputs[index].program.items = sema_alias_rewrite_items(inputs[index].program.items, keys)
    }
}

sema_alias_items_bind_paths: fn(items: [Item]) -> Bool Never! {
    loop index in 0..<items.len() {
        if items[index] == .Const(definition) {
            if sema_alias_binding_path(definition) != None -> return true
        }
        if items[index] == .CodeModule(code_module) {
            if code_module.body == .Val(body) {
                if sema_alias_items_bind_paths(body) -> return true
            }
        }
    }
    false
}

// The path of a plain `Name: path` binding: immutable, untyped, unmarked, and
// a right-hand side that is only a dotted name.
sema_alias_binding_path: fn(definition: ConstDef) -> [String]? Never! {
    if definition.mutable || definition.is_comptime || definition.is_persist || definition.ty != None || definition.meta != None || definition.ct != None || definition.attrs.len() > 0 -> return None
    sema_alias_expr_path(definition.value)
}

sema_alias_expr_path: fn(value: Expr) -> [String]? Never! {
    if value == {
        .Ident(name, _, _) -> Val([String]{name})
        .Field(base, member, _, _) -> {
            parts := sema_alias_expr_path(base) ?? return None
            parts.push(member.copy())
            Val(parts)
        }
        .EnumLit(type_name, variant, _, args, leading_dot, _, _) -> {
            if leading_dot || args.len() > 0 || type_name == "" -> return None
            parts := type_name.split(".").to_list()
            parts.push(variant.copy())
            Val(parts)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_alias_key: fn(definition: ConstDef) -> String Never! {
    "{definition.name_span.start}:{definition.name_span.end}:{definition.name}"
}

sema_alias_collect_types: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], rows: [String:Int], index: Int, items: [Item], scope: [String], keys: &[String]) Never! {
    loop item_index in 0..<items.len() {
        if items[item_index] == .Const(definition) {
            path: sema_alias_binding_path(definition) ?? next
            if sema_alias_path_meaning(inputs, edges, rows, SemaAliasSite{input: index, scope: scope, depth: 0}, path) == .Type -> keys.push(sema_alias_key(definition))
        }
        if items[item_index] == .CodeModule(code_module) {
            if code_module.body == .Val(body) {
                inner := scope
                inner.push(code_module.name)
                sema_alias_collect_types(inputs, edges, rows, index, body, inner, keys)
            }
        }
    }
}

sema_alias_rewrite_items: fn(items: [Item], keys: [String]) -> [Item] Never! {
    rewritten := [Item]{}
    loop item in items {
        value := item
        if item == {
            .Const(definition) -> {
                if keys.contains(sema_alias_key(definition)) {
                    path: sema_alias_binding_path(definition) ?? [String]{}
                    value = Item.TypeAlias{value: TypeAliasDef{is_pub: definition.is_pub, is_package_pub: definition.is_package_pub, name: definition.name, name_span: definition.name_span, type_params: [TypeParam]{}, target: foundation_named_type(path.join(".")), target_span: expr_span(definition.value), span: definition.span}}
                }
            }
            .CodeModule(code_module) -> {
                row := code_module
                if code_module.body == .Val(body) -> row.body = Val(sema_alias_rewrite_items(body, keys))
                value = Item.CodeModule{value: row}
            }
            .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
        rewritten.push(value)
    }
    rewritten
}

// The meaning of `path` written in `site`: each scope from the innermost
// outward, with its imports, then the global types.
sema_alias_path_meaning: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], rows: [String:Int], site: SemaAliasSite, path: [String]) -> SemaAliasMeaning Never! {
    if site.depth > SEMA_ALIAS_MAX_DEPTH || path.len() == 0 -> return .Unknown
    level := site.scope.len()
    loop level >= 0 {
        scope: site.scope.slice(0, level)
        declared: sema_alias_declared_in(inputs[site.input].program.items, scope, 0, path[0])
        if declared.meaning != .Unknown -> return sema_alias_follow(inputs, edges, rows, SemaAliasSite{input: site.input, scope: scope, depth: site.depth}, declared, path)
        imported: sema_alias_imported(inputs, edges, rows, SemaAliasSite{input: site.input, scope: scope, depth: site.depth}, path, false)
        if imported != .Unknown -> return imported
        level -= 1
    }
    if path.len() == 1 && sema_alias_global_type(inputs, path[0]) -> return SemaAliasMeaning.Type
    SemaAliasMeaning.Unknown
}

// The meaning of `path` as a member of the scope `site` names in another
// module: its declarations, then what it re-exports with `pub use`.
sema_alias_member_meaning: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], rows: [String:Int], site: SemaAliasSite, path: [String]) -> SemaAliasMeaning Never! {
    if site.depth > SEMA_ALIAS_MAX_DEPTH || path.len() == 0 -> return .Unknown
    declared: sema_alias_declared_in(inputs[site.input].program.items, site.scope, 0, path[0])
    if declared.meaning != .Unknown -> return sema_alias_follow(inputs, edges, rows, site, declared, path)
    sema_alias_imported(inputs, edges, rows, site, path, true)
}

// The meaning of `path` whose head names `declared` in `site`.
sema_alias_follow: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], rows: [String:Int], site: SemaAliasSite, declared: SemaAliasDeclared, path: [String]) -> SemaAliasMeaning Never! {
    rest: path.slice(1, path.len())
    if declared.meaning == {
        .Type -> if rest.len() == 0 -> .Type else -> .Value
        .Value -> {
            if rest.len() > 0 -> return .Value
            binding: declared.binding ?? return .Value
            sema_alias_path_meaning(inputs, edges, rows, SemaAliasSite{input: site.input, scope: site.scope, depth: site.depth + 1}, binding)
        }
        .Module -> {
            if rest.len() == 0 -> return .Unknown
            inner := site.scope
            inner.push(path[0])
            sema_alias_member_meaning(inputs, edges, rows, SemaAliasSite{input: site.input, scope: inner, depth: site.depth + 1}, rest)
        }
        .Unknown -> .Unknown
    }
}

// The declaration named `name` directly in the scope `scope` of `items`.
sema_alias_declared_in: fn(items: [Item], scope: [String], from: Int, name: String) -> SemaAliasDeclared Never! {
    if from < scope.len() {
        loop index in 0..<items.len() {
            if items[index] == .CodeModule(code_module) {
                if code_module.name == scope[from] && code_module.body == .Val(body) -> return sema_alias_declared_in(body, scope, from + 1, name)
            }
        }
        return SemaAliasDeclared{meaning: .Unknown, binding: None}
    }
    loop index in 0..<items.len() {
        declared: sema_alias_item_declares(items[index], name)
        if declared.meaning != .Unknown -> return declared
    }
    SemaAliasDeclared{meaning: .Unknown, binding: None}
}

// What `item` means when it declares `name`; `.Unknown` otherwise.
sema_alias_item_declares: fn(item: Item, name: String) -> SemaAliasDeclared Never! {
    meaning: if item == {
        .Struct(value) -> sema_alias_meaning_if(value.name == name, .Type)
        .Enum(value) -> sema_alias_meaning_if(value.name == name, .Type)
        .Distinct(value) -> sema_alias_meaning_if(value.name == name, .Type)
        .TypeAlias(value) -> sema_alias_meaning_if(value.name == name, .Type)
        .Trait(value) -> sema_alias_meaning_if(value.name == name, .Type)
        .Tag(value) -> sema_alias_meaning_if(value.name == name, .Type)
        .UnitFamily(value) -> sema_alias_meaning_if(value.family == name, .Type)
        .Func(value) -> sema_alias_meaning_if(value.name == name, .Value)
        .Const(value) -> sema_alias_meaning_if(value.name == name, .Value)
        .CodeModule(value) -> sema_alias_meaning_if(value.name == name, .Module)
        .EffectDecl(_) | .Impl(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> SemaAliasMeaning.Unknown
    }
    if meaning == .Value && item == .Const(value) -> return SemaAliasDeclared{meaning: meaning, binding: sema_alias_binding_path(value)}
    SemaAliasDeclared{meaning: meaning, binding: None}
}

sema_alias_meaning_if: fn(matches: Bool, meaning: SemaAliasMeaning) -> SemaAliasMeaning Never! {
    if matches -> meaning else -> .Unknown
}

// The meaning of `path` through an import of the scope `site`. A module's
// member (`exported`) is reached only through its `pub use` re-exports.
sema_alias_imported: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], rows: [String:Int], site: SemaAliasSite, path: [String], exported: Bool) -> SemaAliasMeaning Never! {
    identity: inputs[site.input].module_identity
    source_scope: site.scope.join(".")
    loop edge in edges {
        if edge.source_module_identity != identity || edge.source_scope != source_scope -> next
        if exported && !edge.declaration.is_pub -> next
        target: rows.get(edge.target_module_identity) ?? next
        meaning: sema_alias_import_meaning(inputs, edges, rows, SemaAliasSite{input: target, scope: [String]{}, depth: site.depth + 1}, edge.declaration, path)
        if meaning != .Unknown -> return meaning
    }
    SemaAliasMeaning.Unknown
}

sema_alias_import_meaning: fn(inputs: [SemaRegistrationModuleInput], edges: [SemaRegistrationImportEdge], rows: [String:Int], target: SemaAliasSite, declaration: ImportDecl, path: [String]) -> SemaAliasMeaning Never! {
    rest: path.slice(1, path.len())
    loop binding in import_walk_bindings(declaration) {
        if binding.original == .Val(original) {
            if binding.local != path[0] -> next
            member := original.split(".").to_list()
            loop part in rest -> member.push(part)
            return sema_alias_member_meaning(inputs, edges, rows, target, member)
        }
        parts: binding.local.split(".").to_list()
        if binding.local != path[0] && parts[parts.len() - 1] != path[0] -> next
        if rest.len() == 0 -> return .Unknown
        return sema_alias_member_meaning(inputs, edges, rows, target, rest)
    }
    SemaAliasMeaning.Unknown
}

// A bare name every module sees as a type.
sema_alias_global_type: fn(inputs: [SemaRegistrationModuleInput], name: String) -> Bool Never! {
    if foundation_named_type(name) != (Type.Named{name: name}) -> return true
    if name == "Unit" || name == "Never" || name == "Err" || sema_registration_core_builtin_is_name(name) || core_root_type(name) -> return true
    loop index in 0..<inputs.len() {
        if sema_alias_declared_in(inputs[index].program.items, [String]{}, 0, name).meaning == .Type -> return true
    }
    false
}
