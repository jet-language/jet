// Checked declaration producers for the canonical TIR declaration schema.
//
// Registration owns the source-identity and graph facts used here.  This file
// is intentionally the only producer of TDeclarationFacts: TIR consumers get
// resolved types, callable keys, storage/layout markers, and recursive edges
// without looking back through raw AST declarations or guessing defaults.
use jet_foundation.[
    AccessConvention,
    ConstDef,
    CtKey,
    CtValue,
    Diagnostic,
    EffectRowEntry,
    EnumDef,
    Expr,
    ExprField,
    ExprPair,
    Field,
    Func,
    ImplDef,
    InlineAsmContract,
    Item,
    LayoutFacts,
    Marker,
    NamedSpan,
    OperatorMarker,
    Param,
    ParamZone,
    Span,
    StructDef,
    StructLayout,
    SymbolID,
    SymbolKind,
    TAssociatedTypeDecl,
    TAssociatedTypeValue,
    TCEnumTag,
    TCLIBinding,
    TComptimeEnumArg,
    TComptimeField,
    TComptimeKey,
    TComptimeKeyField,
    TComptimeMapEntry,
    TComptimeReport,
    TComptimeValue,
    TConstantDef,
    TCoreBuiltinOwner,
    TDeclarationFacts,
    TDeclarationOwnership,
    TDeclarationParam,
    TEffectSpan,
    TFailureCarrier,
    TField,
    TGenericParam,
    TImplDef,
    TIntegerRange,
    TOperatorMarker,
    TSerdeAttribute,
    TSerdeAttributeKind,
    TSerdeCodec,
    TShapeFieldNames,
    TStructLayout,
    TTargetOS,
    TTraitDef,
    TTraitMethod,
    TTypeDef,
    TTypeDefKind,
    TVariant,
    TVariantPayload,
    TVisibility,
    TargetLayoutEngine,
    TargetLayoutNameResolution,
    TargetLayoutQualifiedItem,
    TraitDef,
    TraitImplBlock,
    TraitMethodSig,
    Type,
    TypeParam,
    UnOp,
    UnitFamilyDef,
    Variant,
    VariantField,
    VariantPayload,
    expr_span,
    jet_target_layout_engine_with_registry,
    jet_target_layout_enum_c_tag,
    jet_target_layout_enum_facts_in_module,
    jet_target_layout_from_machine,
    type_identity_equal,
    type_name,
]

fn sema_checked_module_key(module_row: SemaRegistrationModule, name: String) -> String Never! {
    if module_row.module_identity == "" -> name else -> "{module_row.module_identity}::{name}"
}

fn sema_checked_visibility(value: Int) -> TVisibility Never! {
    if {
        value >= 2 -> TVisibility.Public
        value >= 1 -> TVisibility.Package
        else -> TVisibility.Private
    }
}

fn sema_checked_ownership(single_use: Bool) -> TDeclarationOwnership Never! {
    if single_use -> TDeclarationOwnership.Move else -> TDeclarationOwnership.Owned
}

fn sema_checked_marker(markers: [Marker], name: String) -> Marker? {
    loop marker in markers {
        if marker.name == name && !marker.negated -> return Val(marker)
    }
    None
}

fn sema_checked_marker_text(marker: Marker) -> String? {
    if marker.ct == .Val(value) {
        if value == .Str(text) -> return Val(text)
    }
    if marker.args.len() == 0 -> return None
    if marker.args[0] == {
        .Expr(expression) -> if expression == {
            .Ident(name, _) -> Val(name)
            .Str(parts, _) -> if parts.len() == 1 && parts[0] == .Lit(text) -> Val(text) else -> None
            else -> None
        }
        else -> None
    }
}

fn sema_checked_marker_text_label(marker: Marker, label: String) -> String? {
    loop index in 0..<marker.arg_labels.len() {
        if marker.arg_labels[index] == .Val(value) {
            if value.name == label && index < marker.args.len() {
                if marker.args[index] == {
                    .Expr(expression) -> {
                        if expression == {
                            .Str(parts, _) -> {
                                if parts.len() == 1 && parts[0] == .Lit(text) -> return Val(text)
                                return None
                            }
                            .Ident(name, _) -> return Val(name)
                            else -> return None
                        }
                    }
                    else -> return None
                }
            }
        }
    }
    None
}

fn sema_checked_derive_names(derives: [NamedSpan]) -> [String] Never! {
    names :: loop derived in derives -> derived.name
    names
}

fn sema_checked_has_name(names: [String], expected: String) -> Bool Never! {
    loop name in names {
        if name == expected -> return true
    }
    false
}

fn sema_checked_ascii_upper(text: String) -> String Never! {
    bytes := text.bytes()
    loop index in 0..<bytes.len() {
        code :: Int.from_u8(bytes[index])
        if code >= 97 && code <= 122 -> bytes[index] = U8{code - 32}
    }
    String.from_bytes(bytes) ?? text
}

fn sema_checked_shape_names(name: String) -> TShapeFieldNames Never! {
    TShapeFieldNames{
        text: name,
        json: None,
        cbor: None,
        csv: None,
        toml: None,
        yaml: None,
        xml: None,
        args: name.replace("_", "-"),
        env: sema_checked_ascii_upper(name.replace("-", "_")),
        db: None,
        layout: None,
    }
}

fn sema_checked_field_shape_names(definition: StructDef, field: Field) -> TShapeFieldNames Never! {
    style := String?{None}
    rename_all :: sema_checked_marker(definition.serde_markers, "RenameAll")
    if rename_all == .Val(marker) -> style = sema_checked_marker_text(marker)
    rename :: sema_checked_marker(field.serde_markers, "Rename")
    shared := sema_checked_wire_case(style, field.name)
    if rename == .Val(marker) -> shared = sema_checked_marker_text(marker) ?? shared
    names := sema_checked_shape_names(shared)
    if rename == .Val(rename_marker) {
        names = TShapeFieldNames{
            text: names.text,
            json: sema_checked_marker_text_label(rename_marker, "json"),
            cbor: sema_checked_marker_text_label(rename_marker, "cbor"),
            csv: sema_checked_marker_text_label(rename_marker, "csv"),
            toml: sema_checked_marker_text_label(rename_marker, "toml"),
            yaml: sema_checked_marker_text_label(rename_marker, "yaml"),
            xml: sema_checked_marker_text_label(rename_marker, "xml"),
            args: sema_checked_marker_text_label(rename_marker, "args") ?? names.args,
            env: sema_checked_marker_text_label(rename_marker, "env") ?? names.env,
            db: sema_checked_marker_text_label(rename_marker, "db"),
            layout: sema_checked_marker_text_label(rename_marker, "layout"),
        }
    }
    env_marker :: sema_checked_marker(field.serde_markers, "Env")
    if env_marker == .Val(marker) {
        names = TShapeFieldNames{text: names.text, json: names.json, cbor: names.cbor, csv: names.csv, toml: names.toml, yaml: names.yaml, xml: names.xml, args: names.args, env: sema_checked_marker_text(marker) ?? names.env, db: names.db, layout: names.layout}
    }
    names
}

fn sema_checked_serde_attribute(marker: Marker) -> TSerdeAttribute? {
    kind :: if marker.name == {
        "RenameAll" -> Val(TSerdeAttributeKind.RenameAll)
        "Discriminant" | "Tag" -> Val(TSerdeAttributeKind.Tag)
        "Untagged" -> Val(TSerdeAttributeKind.Untagged)
        "DenyUnknownFields" -> Val(TSerdeAttributeKind.DenyUnknownFields)
        else -> None
    }
    kind_value :: kind ?? return None
    TSerdeAttribute{kind: kind_value, value: sema_checked_marker_text(marker), span: marker.span}
}

fn sema_checked_serde_attributes(markers: [Marker]) -> [TSerdeAttribute] Never! {
    attributes := [TSerdeAttribute]{}
    loop marker in markers {
        if marker.negated -> next
        attribute :: sema_checked_serde_attribute(marker) ?? next
        &attributes.push(attribute)
    }
    attributes
}

fn sema_checked_layout(layout: StructLayout?) -> TStructLayout? {
    value :: layout ?? return None
    if value == {
        .C -> Val(TStructLayout.C)
        .CAligned(alignment, target) -> Val(TStructLayout.CAligned{alignment: alignment, target: target})
        .Columnar -> Val(TStructLayout.Columnar)
    }
}

fn sema_checked_effects(effects: [EffectRowEntry]?) -> [TEffectSpan]? {
    effect_row :: effects ?? return None
    spans :: loop effect_entry in effect_row -> TEffectSpan{name: effect_entry.name, span: effect_entry.span}
    Val(spans)
}

fn sema_checked_failure(return_type: Type?) -> TFailureCarrier Never! {
    ty :: return_type ?? return TFailureCarrier.Result{success: Type.Named{name: "Unit"}, error: Type.Named{name: "Err"}}
    if ty == {
        .Named(name) -> if name == "Never" -> TFailureCarrier.Diverges{value: ty} else -> TFailureCarrier.Result{success: ty, error: Type.Named{name: "Err"}}
        .Option(value) -> TFailureCarrier.Optional{value: value}
        .Result(ok, err) -> if err == (Type.Named{name: "Never"}) -> TFailureCarrier.Infallible else -> TFailureCarrier.Result{success: ok, error: err}
        else -> TFailureCarrier.Result{success: ty, error: Type.Named{name: "Err"}}
    }
}

fn sema_checked_parameter_ownership(convention: AccessConvention) -> TDeclarationOwnership Never! {
    if convention == {
        .Move -> TDeclarationOwnership.Move
        .Write -> TDeclarationOwnership.WriteBorrow
        else -> TDeclarationOwnership.ReadBorrow
    }
}

