// Checked declaration producers for the canonical checked declaration schema.
//
// Registration owns the source-identity and graph facts used here.  This file
// is intentionally the only producer of TDeclarationFacts: checked-tree consumers get
// resolved types, callable keys, storage/layout markers, and recursive edges
// without looking back through raw AST declarations or guessing defaults.
use {
    jet_foundation.[
        AccessConvention,
        ConstDef,
        CtKey,
        CtValue,
        Diagnostic,
        EffectRowEntry,
        EnumDef,
        Expr,
        ExprField,
        ExprPair,
        Field,
        Func,
        ImplDef,
        InlineAsmContract,
        Item,
        LayoutFacts,
        MARKER_MEMO,
        MARKER_RENAME,
        Marker,
        NamedSpan,
        OperatorMarker,
        Param,
        ParamZone,
        Span,
        StructDef,
        StructLayout,
        SymbolID,
        SymbolKind,
        TAssociatedTypeDecl,
        TAssociatedTypeValue,
        TCEnumTag,
        TCLIBinding,
        TComptimeEnumArg,
        TComptimeField,
        TComptimeKey,
        checked_comptime_integer_key,
        TComptimeKeyField,
        TComptimeMapEntry,
        TComptimeReport,
        TComptimeValue,
        TConstantDef,
        TCoreBuiltinOwner,
        TDeclarationFacts,
        TDeclarationOwnership,
        TDeclarationParam,
        TEffectSpan,
        TFailureCarrier,
        TField,
        TGenericParam,
        TImplDef,
        TTraitConstantValue,
        TIntegerRange,
        TOperatorMarker,
        TSerdeAttribute,
        TSerdeAttributeKind,
        TSerdeCodec,
        TShapeFieldNames,
        TStructLayout,
        TTargetOS,
        TTraitDef,
        TTraitMethod,
        TTypeDef,
        TTypeDefKind,
        TUnsafeGate,
        TVariant,
        TVariantPayload,
        TVisibility,
        TargetLayoutEngine,
        TargetLayoutNameResolution,
        TargetLayoutQualifiedItem,
        TraitDef,
        TraitImplBlock,
        TraitMethodSig,
        Type,
        TypeParam,
        UnOp,
        UnitFamilyDef,
        Variant,
        VariantField,
        VariantPayload,
        ast_comptime_generated_path,
        comptime_walk_calls,
        comptime_walk_identifiers,
        core_bare_source_module,
        diagnostic_registry_row,
        expr_span,
        jet_target_layout_engine_with_registry,
        jet_target_layout_enum_c_tag,
        jet_target_layout_enum_facts_in_module,
        jet_target_layout_from_machine,
        owned_trait,
        owned_trait_arithmetic,
        owned_trait_commutative,
        owned_trait_is_operator,
        owned_trait_literal,
        owned_trait_structural_names,
        target_os_parse,
        symbol_kind_name,
        type_identity_equal,
        type_name,
        unit_family_distinct_defs,
        access_sigil,
        CModule,
    ]
    jet_parser.[parser_guest_import_symbol]
}

sema_checked_module_key: fn(module_row: SemaRegistrationModule, name: String) -> String Never! {
    if module_row.module_identity == "" -> name else -> "{module_row.module_identity}::{name}"
}

// The member types of a standard core.units family every module sees. They
// register no nominal (one canonical owner across modules), so each module
// carries them as checked Float distincts for lowering.
sema_checked_standard_unit_defs: fn(module_row: SemaRegistrationModule, family: UnitFamilyDef, rows: &[TTypeDef]) Never! {
    if family.resolved_owner != Val("core.units") -> return
    loop definition in unit_family_distinct_defs(family) {
        derives := [String]{}
        loop named in definition.derives -> derives.push(named.name)
        rows.push(TTypeDef{
            module_identity: module_row.module_identity,
            key: sema_checked_module_key(module_row, definition.name),
            name: definition.name,
            span: definition.name_span,
            public: definition.is_pub,
            package_public: definition.is_package_pub,
            generic_params: [TGenericParam]{},
            boxed_edges: [String]{},
            derives: derives,
            auto_derive_default: false,
            auto_printable: false,
            published_schema: false,
            single_use: false,
            must_use: false,
            layout: None,
            c_layout_tag: None,
            enum_layout: None,
            layout_alignment: None,
            serde: [TSerdeAttribute]{},
            cli_bindings: [TCLIBinding]{},
            ownership: TDeclarationOwnership.Owned,
            compiler_builtin: None,
            kind: TTypeDefKind.Distinct{base: Type.Float, range: None},
        })
    }
}

sema_checked_visibility: fn(value: Int) -> TVisibility Never! {
    if {
        value >= 2 -> TVisibility.Public
        value >= 1 -> TVisibility.Package
        else -> TVisibility.Private
    }
}

sema_checked_ownership: fn(single_use: Bool) -> TDeclarationOwnership Never! {
    if single_use -> TDeclarationOwnership.Move else -> TDeclarationOwnership.Owned
}

sema_checked_marker: fn(markers: [Marker], name: String) -> Marker? {
    loop marker in markers {
        if marker.name == name && !marker.negated -> return Val(marker)
    }
    None
}

sema_checked_marker_text: fn(marker: Marker) -> String? {
    if marker.ct == .Val(value) {
        if value == .Str(text) -> return Val(text)
    }
    if marker.args.len() == 0 -> return None
    if marker.args[0] == {
        .Expr(expression) -> if expression == {
            .Ident(name, _, _) -> Val(name)
            .Str(parts, _, _) -> {
                if parts.len() == 1 {
                    if parts[0] == .Lit(text) -> return Val(text)
                }
                None
            }
            .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
        }
        .EffectRow(_, _) -> None
    }
}

// A type's `#Rename(.Camel)` sets the wire casing of its
// fields or variants. The style is the casing menu's word (`camel`); a
// NamingCase the menu doesn't know comes back as written so E2409 can name
// it. None when the type has no casing `#Rename`.
sema_checked_rename_case: fn(markers: [Marker]) -> String? {
    loop marker in markers {
        if marker.name != MARKER_RENAME || marker.negated -> next
        return sema_checked_rename_case_word(marker)
    }
    None
}

sema_checked_rename_case_word: fn(marker: Marker) -> String? {
    if marker.args.len() == 0 -> return None
    if marker.args[0] == .Expr(expression) {
        if expression == .EnumLit(_, name, _, _, _, _, _) {
            return if name == {
                "Camel" -> Val("camel")
                "Snake" -> Val("snake")
                "Pascal" -> Val("pascal")
                "Kebab" -> Val("kebab")
                "Screaming" -> Val("screaming")
                else -> Val(name.copy())
            }
        }
    }
    None
}

sema_checked_marker_text_label: fn(marker: Marker, label: String) -> String? {
    loop index in 0..<marker.arg_labels.len() {
        if marker.arg_labels[index] == .Val(value) {
            if value.name == label && index < marker.args.len() {
                if marker.args[index] == {
                    .Expr(expression) -> {
                        if expression == {
                            .Str(parts, _, _) -> {
                                if parts.len() == 1 {
                                    if parts[0] == .Lit(text) -> return Val(text)
                                }
                                return None
                            }
                            .Ident(name, _, _) -> return Val(name)
                            .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
                        }
                    }
                    .EffectRow(_, _) -> return None
                }
            }
        }
    }
    None
}

// Rust reference lowering: `lower_derive_names` drops the `#CLI` marker; it
// is a CLI entry fact, not a derived trait.
sema_checked_derive_names: fn(derives: [NamedSpan]) -> [String] Never! {
    names := [String]{}
    loop derived in derives {
        if derived.name != "CLI" -> names.push(derived.name)
    }
    names
}

// Rust reference lowering: `lower_derive_names`
// / has_generated_block. The automatic Debug selection and sema's
// structural Equatable and Comparable providers (compiler-generated blocks on
// the type) reach the lowered program as derives, which the Rust printer lowers to `JetDebug`,
// native `PartialEq`, and the native `Eq`/`PartialOrd`/`Ord` an ordered map key
// needs.
sema_checked_type_derive_names: fn(derives: [NamedSpan], definition: Item, auto_debug: Bool) -> [String] Never! {
    names := sema_checked_derive_names(derives)
    if auto_debug && !sema_checked_has_name(names, "Debug") -> names.push("Debug")
    loop structural in owned_trait_structural_names() {
        if sema_checked_has_generated_block(definition, structural) && !sema_checked_has_name(names, structural) -> names.push(structural.copy())
    }
    names
}

// Rust reference lowering: `has_generated_block`: any builtin structural
// provider sema attached to a struct or enum.
sema_checked_has_generated_block: fn(definition: Item, trait_name: String) -> Bool Never! {
    if definition == {
        .Struct(value) -> {
            loop block in value.trait_impls {
                if block.compiler_generated && block.trait_name == trait_name -> return true
            }
        }
        .Enum(value) -> {
            loop block in value.trait_impls {
                if block.compiler_generated && block.trait_name == trait_name -> return true
            }
        }
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    false
}

sema_checked_has_name: fn(names: [String], expected: String) -> Bool Never! {
    loop name in names {
        if name == expected -> return true
    }
    false
}

sema_checked_ascii_upper: fn(text: String) -> String Never! {
    bytes := text.bytes()
    loop index in 0..<bytes.len() {
        code: Int.from_u8(bytes[index])
        if code >= 97 && code <= 122 -> bytes[index] = U8{code - 32}
    }
    String.from_bytes(bytes) ?? text
}

sema_checked_shape_names: fn(name: String) -> TShapeFieldNames Never! {
    TShapeFieldNames{
        text: name,
        json: None,
        cbor: None,
        csv: None,
        toml: None,
        yaml: None,
        xml: None,
        args: name.replace("_", "-"),
        env: sema_checked_ascii_upper(name.replace("-", "_")),
        db: None,
        layout: None,
    }
}

sema_checked_field_shape_names: fn(definition: StructDef, field: Field) -> TShapeFieldNames Never! {
    style: sema_checked_rename_case(definition.serde_markers)
    rename: sema_checked_marker(field.serde_markers, "Rename")
    shared := sema_checked_wire_case(style, field.name)
    if rename == .Val(marker) -> shared = sema_checked_marker_text(marker) ?? shared
    names := sema_checked_shape_names(shared)
    if rename == .Val(rename_marker) {
        names = TShapeFieldNames{
            text: names.text,
            json: sema_checked_marker_text_label(rename_marker, "json"),
            cbor: sema_checked_marker_text_label(rename_marker, "cbor"),
            csv: sema_checked_marker_text_label(rename_marker, "csv"),
            toml: sema_checked_marker_text_label(rename_marker, "toml"),
            yaml: sema_checked_marker_text_label(rename_marker, "yaml"),
            xml: sema_checked_marker_text_label(rename_marker, "xml"),
            args: sema_checked_marker_text_label(rename_marker, "args") ?? names.args,
            env: sema_checked_marker_text_label(rename_marker, "env") ?? names.env,
            db: sema_checked_marker_text_label(rename_marker, "db"),
            layout: sema_checked_marker_text_label(rename_marker, "layout"),
        }
    }
    // `#Arg(env:)` names the field's environment fallback.
    if sema_registration_cli_arg_text(field.serde_markers, "env") == .Val(env) {
        names = TShapeFieldNames{text: names.text, json: names.json, cbor: names.cbor, csv: names.csv, toml: names.toml, yaml: names.yaml, xml: names.xml, args: names.args, env: env, db: names.db, layout: names.layout}
    }
    names
}

sema_checked_serde_attribute: fn(marker: Marker) -> TSerdeAttribute? {
    kind: if marker.name == {
        "Rename" -> Val(TSerdeAttributeKind.RenameAll)
        "Discriminant" | "Tag" -> Val(TSerdeAttributeKind.Tag)
        "Untagged" -> Val(TSerdeAttributeKind.Untagged)
        "DenyUnknownFields" -> Val(TSerdeAttributeKind.DenyUnknownFields)
        else -> None
    }
    kind_value: kind ?? return None
    value: if kind_value == .RenameAll -> sema_checked_rename_case_word(marker) else -> sema_checked_marker_text(marker)
    TSerdeAttribute{kind: kind_value, value: value, span: marker.span}
}

sema_checked_serde_attributes: fn(markers: [Marker]) -> [TSerdeAttribute] Never! {
    attributes := [TSerdeAttribute]{}
    loop marker in markers {
        if marker.negated -> next
        attribute: sema_checked_serde_attribute(marker) ?? next
        attributes.push(attribute)
    }
    attributes
}

sema_checked_layout: fn(layout: StructLayout?) -> TStructLayout? {
    value: layout ?? return None
    if value == {
        .C -> Val(TStructLayout.C)
        .CAligned(alignment, target) -> Val(TStructLayout.CAligned{alignment: alignment, target: target})
        .Columnar -> Val(TStructLayout.Columnar)
    }
}

sema_checked_effects: fn(effects: [EffectRowEntry]?) -> [TEffectSpan]? {
    effect_row: effects ?? return None
    spans: loop effect_entry in effect_row -> TEffectSpan{name: effect_entry.name, span: effect_entry.span}
    Val(spans)
}

sema_checked_failure: fn(return_type: Type?) -> TFailureCarrier Never! {
    ty: return_type ?? return TFailureCarrier.Result{success: Type.Named{name: "Unit"}, error: Type.Named{name: "Err"}}
    if ty == {
        .Named(name) -> if name == "Never" -> TFailureCarrier.Diverges{value: ty} else -> TFailureCarrier.Result{success: ty, error: Type.Named{name: "Err"}}
        .Option(value) -> TFailureCarrier.Optional{value: value}
        .Result(ok, err) -> if err == (Type.Named{name: "Never"}) -> TFailureCarrier.Infallible else -> TFailureCarrier.Result{success: ok, error: err}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> TFailureCarrier.Result{success: ty, error: Type.Named{name: "Err"}}
    }
}

sema_checked_parameter_ownership: fn(convention: AccessConvention) -> TDeclarationOwnership Never! {
    if convention == {
        .Move -> TDeclarationOwnership.Move
        .Write -> TDeclarationOwnership.WriteBorrow
        .Read -> TDeclarationOwnership.ReadBorrow
    }
}

SemaCheckedForeignOwner: enum {
    Inline
    ExternRust
    CModule
    // A per-callable `#Import(c)` declaration (Rust `lower_guest_import_foreign`).
    GuestImport
}

