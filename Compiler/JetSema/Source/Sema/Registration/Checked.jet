sema_checked_foreign_provider_error: fn(span: Span, subject: String, reason: String, fix: String) -> Diagnostic {
    sema_error("E3216", span, subject, reason, fix)
}

sema_checked_foreign_list_has: fn(values: [String], value: String) -> Bool Never! {
    loop current in values {
        if current == value -> return true
    }
    false
}

// Whether boundary evidence of `basis` verifies its obligation: a checker
// proved it, the generated wrapper enforces it, or the boundary contains it.
// `trusted` evidence is an assumption nothing checked and `unknown` is opaque,
// so neither ever reads as verified.
sema_checked_foreign_basis_verified: fn(basis: String) -> Bool Never! {
    basis == "proved" || basis == "enforced" || basis == "contained"
}

sema_checked_foreign_boundary: fn(input: SemaForeignBoundaryInput, library: String, span: Span, diagnostics: &[Diagnostic]) -> SemaCheckedForeignBoundary? {
    valid := true
    if input.schema == "" || input.digest == "" || input.language == "" || input.library == "" || input.effect_root == "" || input.effects == "" || input.source_authority == "" || input.artifact_coverage_digest == "" || input.loaded_artifact == "" || input.target == "" || input.generator == "" {
        diagnostics.push(sema_checked_foreign_provider_error(span, "foreign boundary carrier is incomplete", "the provider must retain its schema, artifact identity, source authority, target, generator, and effect root", "supply the complete approved C backend boundary record"))
        valid = false
    }
    if input.library != library {
        diagnostics.push(sema_checked_foreign_provider_error(span, "foreign boundary carrier names the wrong library", "a boundary record must belong to the C library whose declarations it checks", "retain the provider library identity without rewriting it"))
        valid = false
    }
    if !sema_checked_foreign_list_has(input.effects.split(";").to_list(), input.effect_root) {
        diagnostics.push(sema_checked_foreign_provider_error(span, "foreign boundary carrier narrowed its effect root", "the provider effect set must retain its descriptor-owned root", "preserve the descriptor-owned effect root in the boundary record"))
        valid = false
    }
    coverage_complete: input.transitive_dependencies != None && input.reachable_callbacks != None && input.compiler_flags != None
    obligations := [SemaCheckedForeignBoundaryObligation]{}
    names := [String]{}
    loop obligation in input.obligations {
        basis_known: obligation.basis != "unknown"
        if obligation.name == "" || obligation.checker == "" || obligation.assumptions.len() == 0 || obligation.coverage_digest != input.artifact_coverage_digest {
            diagnostics.push(sema_checked_foreign_provider_error(span, "foreign boundary carrier has an invalid obligation", "every obligation needs its checker, assumptions, and exact artifact coverage digest", "regenerate the approved C backend boundary record"))
            valid = false
        }
        if obligation.basis != "proved" && obligation.basis != "enforced" && obligation.basis != "contained" && obligation.basis != "trusted" && obligation.basis != "unknown" {
            diagnostics.push(sema_checked_foreign_provider_error(span, "foreign boundary carrier has an unknown evidence basis", "boundary evidence uses the closed proved/enforced/contained/trusted/unknown vocabulary", "preserve the provider's canonical evidence basis"))
            valid = false
        }
        if {
            sema_checked_foreign_list_has(names, obligation.name) -> {
                diagnostics.push(sema_checked_foreign_provider_error(span, "foreign boundary carrier repeats an obligation", "each native boundary obligation has one canonical evidence row", "remove the repeated obligation row"))
                valid = false
            }
            else -> {
                names.push(obligation.name)
            }
        }
        obligations.push(SemaCheckedForeignBoundaryObligation{name: obligation.name, basis: obligation.basis, checker: obligation.checker, assumptions: obligation.assumptions, coverage_digest: obligation.coverage_digest})
        if basis_known && !coverage_complete {
            diagnostics.push(sema_checked_foreign_provider_error(span, "foreign boundary carrier has incomplete artifact coverage", "proved boundary evidence requires dependency, callback, and compiler-flag coverage", "retain all approved artifact coverage lists"))
            valid = false
        }
    }
    required: [String]{"abi", "layout", "width", "alignment", "ownership", "lifetime", "cleanup", "encoding", "nullability", "errors", "exceptions", "callbacks", "task-thread", "target", "copy-cost", "effects"}
    loop name in required {
        if !sema_checked_foreign_list_has(names, name) {
            diagnostics.push(sema_checked_foreign_provider_error(span, "foreign boundary carrier omits an obligation", "the canonical C backend contract requires ABI, layout, ownership, cleanup, callback, target, and effect evidence", "retain every approved boundary obligation"))
            valid = false
        }
    }
    if !valid -> return None
    SemaCheckedForeignBoundary{
        schema: input.schema,
        digest: input.digest,
        language: input.language,
        library: input.library,
        effect_root: input.effect_root,
        effects: input.effects,
        source_authority: input.source_authority,
        artifact_coverage_digest: input.artifact_coverage_digest,
        loaded_artifact: input.loaded_artifact,
        transitive_dependencies: input.transitive_dependencies,
        reachable_callbacks: input.reachable_callbacks,
        compiler_flags: input.compiler_flags,
        target: input.target,
        generator: input.generator,
        obligations: obligations,
    }
}

sema_checked_foreign_provider: fn(input: SemaForeignProviderInput, diagnostics: &[Diagnostic]) -> SemaCheckedForeignProvider? {
    valid := input.module_identity != "" && input.library != "" && input.module_library != "" && (input.language == "c" || input.language == "cpp")
    if input.library == "" {
        diagnostics.push(sema_checked_foreign_provider_error(input.source_span, "foreign provider has no library identity", "native backend facts must be scoped to one declared library", "retain the source provider's library identity"))
    }
    if input.module_identity == "" {
        diagnostics.push(sema_checked_foreign_provider_error(input.source_span, "foreign provider has no exact module identity", "provider facts must remain bound to the actual loaded synthetic CModule identity", "preserve the producer-owned JetDriverLoadedModule.module_identity"))
    }
    if input.module_library == "" {
        diagnostics.push(sema_checked_foreign_provider_error(input.source_span, "foreign provider has no native module library identity", "link facts must retain the exact cache CModule library identity", "preserve the producer-owned native module library"))
    }
    if input.language != "c" && input.language != "cpp" {
        diagnostics.push(sema_checked_foreign_provider_error(input.source_span, "foreign provider has an unsupported language", "native provider language must be the producer-owned canonical `c` or `cpp` identity", "preserve the native cache's generated language"))
    }
    handles := [SemaCheckedForeignHandle]{}
    loop handle in input.handles {
        if handle.library != input.library || handle.typedef_name == "" || handle.jet_name == "" || handle.close == "" || (handle.close_source != "conventional" && handle.close_source != "overlay") || (handle.thread_safety != "unspecified" && handle.thread_safety != "safe" && handle.thread_safety != "unsafe") {
            diagnostics.push(sema_checked_foreign_provider_error(input.source_span, "foreign provider has an invalid handle fact", "handle ownership, close provenance, library identity, and thread-safety facts are compiler-owned ABI evidence", "preserve the complete approved handle metadata"))
            valid = false
            next
        }
        duplicate: loop existing in handles {
            if existing.jet_name == handle.jet_name -> break true
        } ?? false
        if duplicate {
            diagnostics.push(sema_checked_foreign_provider_error(input.source_span, "foreign provider repeats a handle type", "one Jet handle name must resolve to one native typedef and close symbol", "remove the duplicate provider handle row"))
            valid = false
            next
        }
        handles.push(SemaCheckedForeignHandle{
            library: input.library,
            typedef_name: handle.typedef_name,
            jet_name: handle.jet_name,
            ownership: "Owned",
            close: handle.close,
            close_source: handle.close_source,
            thread_safety: handle.thread_safety,
            send: handle.thread_safety == "safe",
            sync: handle.thread_safety == "safe",
            close_function_key: None,
            close_foreign_key: handle.close_function_key,
            undo_function_key: None,
        })
    }
    close_adapters := [SemaCheckedForeignCloseAdapter]{}
    loop adapter in input.close_adapters {
        if adapter.library != input.library || adapter.handle_type == "" || adapter.raw_function == "" || adapter.adapter_function == "" {
            diagnostics.push(sema_checked_foreign_provider_error(input.source_span, "foreign provider has an invalid close adapter", "status-returning native closers need one complete raw/adapter identity", "preserve the approved close adapter metadata"))
            valid = false
            next
        }
        close_adapters.push(SemaCheckedForeignCloseAdapter{library: input.library, handle_type: adapter.handle_type, raw_function: adapter.raw_function, adapter_function: adapter.adapter_function})
    }
    overrides := [SemaCheckedForeignOverlayOverride]{}
    loop override in input.overrides {
        if override.generated_symbol == "" || override.overlay_symbol == "" {
            diagnostics.push(sema_checked_foreign_provider_error(input.source_span, "foreign provider has an incomplete overlay override", "each accepted generated-symbol replacement must retain both exact Rust symbols", "preserve the generated binding symbol and overlay Rust path"))
            valid = false
            next
        }
        overrides.push(SemaCheckedForeignOverlayOverride{generated_symbol: override.generated_symbol, overlay_symbol: override.overlay_symbol})
    }
    boundary := SemaCheckedForeignBoundary?{None}
    if input.boundary == .Val(value) {
        boundary = sema_checked_foreign_boundary(value, input.library, input.source_span, diagnostics)
        if boundary == {
            .Val(checked_boundary) -> {
                if checked_boundary.language != input.language {
                    diagnostics.push(sema_checked_foreign_provider_error(input.source_span, "foreign boundary language disagrees with its provider", "the native generated language is authoritative and boundary provenance must match it", "retain the same producer-owned canonical language on both records"))
                    valid = false
                }
            }
            .None -> valid = false
        }
    }
    loop library in input.direct_links {
        if library == "" {
            diagnostics.push(sema_checked_foreign_provider_error(input.source_span, "foreign provider has an empty direct link", "native link closure identities must be explicit", "retain the approved direct library name"))
            valid = false
        }
    }
    loop library in input.transitive_links {
        if library == "" {
            diagnostics.push(sema_checked_foreign_provider_error(input.source_span, "foreign provider has an empty transitive link", "native link closure identities must be explicit", "retain the approved transitive library name"))
            valid = false
        }
    }
    if !valid -> return None
    SemaCheckedForeignProvider{language: input.language, module_identity: input.module_identity, library: input.library, module_library: input.module_library, handles: handles, close_adapters: close_adapters, overrides: overrides, boundary: boundary, direct_links: input.direct_links, transitive_links: input.transitive_links}
}

sema_checked_foreign_providers: fn(inputs: [SemaForeignProviderInput], diagnostics: &[Diagnostic]) -> [SemaCheckedForeignProvider] Never! {
    result := [SemaCheckedForeignProvider]{}
    loop input in inputs {
        value: sema_checked_foreign_provider(input, diagnostics) ?? next
        result.push(value)
    }
    result
}

SemaCheckedForeignParam: struct {
    index: Int
    name: String
    span: Span
    ty: Type
    convention: AccessConvention
    ownership: TDeclarationOwnership
    public_label: String
    zone: ParamZone
    variadic: Bool
    default_present: Bool
}

// Checked foreign facts are the only source Codegen may use for MirForeign
// rows. They retain ABI/lifecycle provenance without exposing raw ExternFn
// payloads to downstream lowering.
SemaCheckedForeignFunction: struct {
    symbol_id: SymbolID
    key: String
    module_identity: String
    module_name: String
    module_path: String
    source_file: String
    name: String
    span: Span
    owner: SemaCheckedForeignOwner
    symbol: String
    path: String
    params: [SemaCheckedForeignParam]
    raw_scalar_abi: Bool
    bridge_eligible: Bool
    return_type: Type?
    abi: String
    language: String
    effect_root: String?
    callback_transport: String?
    callback_plan_digest: String?
    callback_identity: String?
    link_key: String?
    callback_key: String?
    handle_key: String?
    close_function_key: String?
    close_foreign_key: String?
    undo_function_key: String?
    // The target-checked operand contract of an `#FFI(asm)` body (Rust
    // `check_inline_asm` stores it on the function); None for every other row.
    asm_contract: InlineAsmContract?
    // The audited `#Unsafe` gate an inline foreign declaration
    // carries; every call to the row runs inside this sentry scope.
    unsafe_gate: TUnsafeGate?
}

sema_checked_foreign_key: fn(module_identity: String, name: String) -> String Never! {
    if module_identity == "" -> return name.copy()
    if name == "" -> return module_identity.copy()
    "{module_identity}::{name}"
}

sema_checked_foreign_parameter_type: fn(parameter: SemaRegistrationParameter) -> Type Never! {
    if parameter.variadic && parameter.ty == .List(inner) -> inner else -> parameter.ty
}

sema_checked_foreign_params: fn(graph: SemaRegistrationGraph, module_identity: String, parameters: [SemaRegistrationParameter]) -> [SemaCheckedForeignParam] Never! {
    result := [SemaCheckedForeignParam]{}
    loop parameter in parameters {
        ty: sema_checked_qualify_type(graph, sema_checked_foreign_parameter_type(parameter), module_identity)
        result.push(SemaCheckedForeignParam{
            index: parameter.index,
            name: parameter.symbol.name,
            span: parameter.symbol.span,
            ty: ty,
            convention: parameter.convention,
            ownership: sema_checked_parameter_ownership(parameter.convention),
            public_label: parameter.public_label ?? "",
            zone: parameter.zone,
            variadic: parameter.variadic,
            default_present: parameter.default != None || parameter.default_ref != None,
        })
    }
    result
}

sema_checked_foreign_return_type: fn(graph: SemaRegistrationGraph, module_identity: String, return_type: Type?) -> Type? {
    value: return_type ?? return None
    Val(sema_checked_qualify_type(graph, value, module_identity))
}

sema_checked_foreign_owner: fn(owner: SemaRegistrationForeignOwner) -> SemaCheckedForeignOwner Never! {
    if owner == SemaRegistrationForeignOwner.CModule -> SemaCheckedForeignOwner.CModule else -> SemaCheckedForeignOwner.ExternRust
}

sema_checked_foreign_abi_name: fn(abi: SemaRegistrationCallableABI) -> String Never! {
    abi.c_abi_name ?? "C"
}

sema_checked_foreign_named_key: fn(module_identity: String, value: NamedSpan?) -> String? {
    named: value ?? return None
    Val(sema_checked_foreign_key(module_identity, named.name))
}

sema_checked_foreign_seen: fn(seen: [String], key: String) -> Bool Never! {
    loop value in seen {
        if value == key -> return true
    }
    false
}

sema_checked_foreign_struct_c_layout: fn(layout: StructLayout?) -> Bool Never! {
    value: layout ?? return false
    if value == {
        .C | .CAligned(_, _) -> true
        .Columnar -> false
    }
}

sema_checked_foreign_enum_c_layout_tag: fn(definition: EnumDef) -> TCEnumTag? {
    layout_tag: jet_target_layout_enum_c_tag(definition) ?? return None
    if layout_tag == {
        .CInt -> Val(TCEnumTag.CInt)
        .U8 -> Val(TCEnumTag.U8)
        .I8 -> Val(TCEnumTag.I8)
        .U16 -> Val(TCEnumTag.U16)
        .I16 -> Val(TCEnumTag.I16)
        .U32 -> Val(TCEnumTag.U32)
        .I32 -> Val(TCEnumTag.I32)
        .U64 -> Val(TCEnumTag.U64)
        .I64 -> Val(TCEnumTag.I64)
    }
}

sema_checked_foreign_handle_source_matches: fn(handles: [SemaCheckedForeignHandle], facts: SemaRegistrationForeignHandleFacts) -> Bool Never! {
    loop handle in handles {
        if handle.library == facts.library && handle.typedef_name == facts.typedef_name && handle.jet_name == facts.jet_name && handle.ownership == facts.ownership && handle.close == facts.close && handle.close_source == facts.close_source && handle.thread_safety == facts.thread_safety && handle.send == facts.send && handle.sync == facts.sync -> return true
    }
    false
}

sema_checked_foreign_nominal_type: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, c_abi: Bool, generated: Bool, handles: [SemaCheckedForeignHandle], seen: [String]) -> Bool Never! {
    key: nominal.symbol.id.key
    if sema_checked_foreign_seen(seen, key) -> return false
    next_seen := seen
    next_seen.push(key.copy())
    if nominal.source == {
        .CompilerBuiltinTrait(_) -> false
        .ForeignHandle(facts) -> c_abi && sema_checked_foreign_handle_source_matches(handles, facts)
        .SourceAST(item) -> if item == {
            .Struct(definition) -> {
                if c_abi && !sema_checked_foreign_struct_c_layout(definition.layout) -> return false
                loop field in definition.fields {
                    if !sema_checked_foreign_type(graph, field.ty, nominal.symbol.module_name, c_abi, generated, handles, next_seen) -> return false
                }
                true
            }
            .Enum(definition) -> {
                if c_abi && sema_checked_foreign_enum_c_layout_tag(definition) == None -> return false
                payload_handles: if c_abi -> [SemaCheckedForeignHandle]{} else -> handles
                payload_generated: if c_abi -> false else -> generated
                loop variant in definition.variants {
                    if variant.payload == {
                        .Single(ty, _) -> if !sema_checked_foreign_type(graph, ty, nominal.symbol.module_name, c_abi, payload_generated, payload_handles, next_seen) -> return false
                        .Named(fields) -> {
                            loop field in fields {
                                if !sema_checked_foreign_type(graph, field.ty, nominal.symbol.module_name, c_abi, payload_generated, payload_handles, next_seen) -> return false
                            }
                        }
                        .Unit -> {}
                    }
                }
                true
            }
            .Distinct(definition) -> sema_checked_foreign_type(graph, definition.base, nominal.symbol.module_name, c_abi, generated, handles, next_seen)
            .TypeAlias(definition) -> sema_checked_foreign_type(graph, definition.target, nominal.symbol.module_name, c_abi, generated, handles, next_seen)
            .Func(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> false
        }
    }
}

sema_checked_foreign_builtin_type: fn(name: String) -> Bool Never! {
    name == "Int" || name == "Float" || name == "Bool" || name == "String" || name == "Char" || name == "I8" || name == "I16" || name == "I32" || name == "I64" || name == "U8" || name == "U16" || name == "U32" || name == "U64" || name == "F32"
}

sema_checked_foreign_type: fn(graph: SemaRegistrationGraph, ty: Type, caller_module: String, c_abi: Bool, generated: Bool, handles: [SemaCheckedForeignHandle], seen: [String]) -> Bool Never! {
    qualified: sema_checked_qualify_type(graph, ty, caller_module)
    if qualified == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 -> true
        .List(inner) -> if {
            !c_abi -> sema_checked_foreign_type(graph, inner, caller_module, c_abi, generated, handles, seen)
            !generated -> false
            else -> sema_checked_foreign_type(graph, inner, caller_module, c_abi, false, handles, seen)
        }
        .Option(inner) | .FixedList(inner, _) -> !c_abi && sema_checked_foreign_type(graph, inner, caller_module, c_abi, generated, handles, seen)
        .Map(key, _, value) -> !c_abi && sema_checked_foreign_type(graph, key, caller_module, c_abi, generated, handles, seen) && sema_checked_foreign_type(graph, value, caller_module, c_abi, generated, handles, seen)
        .Result(ok, err) -> !c_abi && sema_checked_foreign_type(graph, ok, caller_module, c_abi, generated, handles, seen) && sema_checked_foreign_type(graph, err, caller_module, c_abi, generated, handles, seen)
        .Shared(_) -> false
        .Fn(params, ret, effects, _, _, _) -> {
            if !c_abi -> return false
            bound: effects ?? return false
            if bound.len() != 0 -> return false
            loop parameter in params {
                if !sema_checked_foreign_type(graph, parameter, caller_module, c_abi, generated, handles, seen) -> return false
            }
            if ret == .Val(returned) -> sema_checked_foreign_type(graph, returned, caller_module, c_abi, generated, handles, seen) else -> true
        }
        .Apply(name, args) -> c_abi && name == "Ptr" && args.len() == 1 && sema_checked_foreign_type(graph, args[0], caller_module, c_abi, false, handles, seen)
        .Named(name) -> {
            if sema_checked_foreign_builtin_type(name) -> return true
            nominal_row: sema_type_resolve_nominal_row(graph, qualified, caller_module) ?? return false
            sema_checked_foreign_nominal_type(graph, graph.modules[nominal_row.module_index].nominals[nominal_row.row], c_abi, generated, handles, seen)
        }
        .Tagged(_, inner) -> sema_checked_foreign_type(graph, inner, caller_module, c_abi, generated, handles, seen)
        .InlineRange(base, _, _) -> sema_checked_foreign_type(graph, base, caller_module, c_abi, generated, handles, seen)
        .TraitObject(_) | .Tuple(_) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// Whether a C function may take `&ty` as the address of the Jet value's own
// bytes: a struct, of any layout, whose stored fields are machine integers,
// floats, Bools or such structs. A C declaration that follows the struct's
// `$layout` reads and writes those bytes in place.
sema_checked_foreign_by_reference_struct: fn(graph: SemaRegistrationGraph, ty: Type, caller_module: String, seen: [String]) -> Bool Never! {
    qualified: sema_checked_qualify_type(graph, ty, caller_module)
    nominal_row: sema_type_resolve_nominal_row(graph, qualified, caller_module) ?? return false
    nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
    key: nominal.symbol.id.key
    if sema_checked_foreign_seen(seen, key) -> return false
    next_seen := seen
    next_seen.push(key.copy())
    if nominal.source == .SourceAST(.Struct(definition)) {
        if definition.type_params.len() > 0 -> return false
        loop field in definition.fields {
            if field.computed != None -> next
            if !sema_checked_foreign_by_reference_field(graph, field.ty, nominal.symbol.module_name, next_seen) -> return false
        }
        return true
    }
    false
}

sema_checked_foreign_by_reference_field: fn(graph: SemaRegistrationGraph, ty: Type, caller_module: String, seen: [String]) -> Bool Never! {
    if sema_checked_qualify_type(graph, ty, caller_module) == {
        .IntN(_, bits) -> bits == 8 || bits == 16 || bits == 32 || bits == 64
        .Float | .Float32 | .Bool -> true
        .Named(name) -> if name == {
            "I8" | "I16" | "I32" | "I64" | "U8" | "U16" | "U32" | "U64" | "Float" | "F64" | "F32" | "Bool" -> true
            else -> sema_checked_foreign_by_reference_struct(graph, ty, caller_module, seen)
        }
        .Int | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// What a call of the C import registered under `target` asks the native
// backend (ir_foreign_call) to do that it has no C ABI marshalling for yet:
// a calling convention other than C, a non-handle pointer, a struct, payload
// enum, Option, tuple, map or Result by value, or a List whose elements have
// no C array layout. None when every part crosses, or the target is no C
// import.
sema_checked_foreign_c_marshal_gap: fn(graph: SemaRegistrationGraph, target: SymbolID) -> String? Never! {
    row: sema_registration_callable_row(graph, target.key) ?? return None
    if row == .Foreign(module_index, index) {
        module_identity: graph.modules[module_index].module_identity
        registered: graph.modules[module_index].foreign_functions[index]
        if registered.owner != SemaRegistrationForeignOwner.CModule -> return None
        if registered.abi.c_abi_name == .Val(name) && name != "C" -> return Val("call a C function through `#ABI({name})`")
        loop parameter in registered.declaration.params {
            if !sema_checked_foreign_c_marshals(graph, parameter.ty, module_identity, parameter.convention == AccessConvention.Write) -> return Val("pass the `{type_name(parameter.ty)}` parameter `{parameter.name}` to C")
        }
        returned: registered.declaration.return_type ?? return None
        if !sema_checked_foreign_c_marshals(graph, returned, module_identity, false) -> return Val("return a `{type_name(returned)}` from C")
    }
    None
}

// Whether the native backend marshals `ty` across a C call: by value for a
// read, moved or returned value, by address for a `written` one. An F32
// crosses only as a List element. A C handle or a Jet function (a callback,
// refused on its own) crosses.
sema_checked_foreign_c_marshals: fn(graph: SemaRegistrationGraph, ty: Type, module_identity: String, written: Bool) -> Bool Never! {
    qualified: sema_checked_qualify_type(graph, ty, module_identity)
    if qualified == {
        .Int | .String | .Char | .Bool -> !written
        .Float32 -> false
        .List(element) -> sema_checked_foreign_c_array_element(graph, element, module_identity)
        .Option(_) | .Tuple(_) | .Map(_, _, _) | .Result(_, _) | .Shared(_) | .Union(_) | .Case(_, _) | .FixedList(_, _) -> false
        .Apply(name, args) -> !(name == "Ptr" && args.len() == 1)
        .Tagged(_, inner) -> sema_checked_foreign_c_marshals(graph, inner, module_identity, written)
        .Named(name) -> {
            if name == "Int" || name == "String" || name == "Char" || name == "Bool" -> return !written
            if name == "F32" -> return false
            if sema_checked_foreign_builtin_type(name) -> return true
            nominal_row: sema_type_resolve_nominal_row(graph, qualified, module_identity) ?? return true
            nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
            if nominal.source == .SourceAST(item) {
                if item == {
                    // A written struct of machine scalars crosses as its bytes.
                    .Struct(_) -> return written
                    .Enum(definition) -> {
                        loop variant in definition.variants {
                            if variant.payload == .Unit -> next
                            return false
                        }
                    }
                    .Distinct(definition) -> return sema_checked_foreign_c_marshals(graph, definition.base, nominal.symbol.module_name, written)
                    .TypeAlias(definition) -> return sema_checked_foreign_c_marshals(graph, definition.target, nominal.symbol.module_name, written)
                    .Func(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
                }
            }
            true
        }
        .Float | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Quantity(_, _) | .Measure(_) -> true
    }
}

// Whether a List of `ty` crosses as a C array: its elements are machine
// integers, floats, Bools or structs, never an exact Int, text, an enum or a
// container.
sema_checked_foreign_c_array_element: fn(graph: SemaRegistrationGraph, ty: Type, module_identity: String) -> Bool Never! {
    qualified: sema_checked_qualify_type(graph, ty, module_identity)
    if qualified == {
        .Int | .String | .Char | .List(_) | .Option(_) | .Tuple(_) | .Map(_, _, _) | .Result(_, _) | .Shared(_) | .Union(_) | .Case(_, _) | .FixedList(_, _) | .Fn(_, _, _, _, _, _) -> false
        .Apply(name, args) -> !(name == "Ptr" && args.len() == 1)
        .Tagged(_, inner) -> sema_checked_foreign_c_array_element(graph, inner, module_identity)
        .Named(name) -> {
            if name == "Int" || name == "String" || name == "Char" -> return false
            if sema_checked_foreign_builtin_type(name) -> return true
            nominal_row: sema_type_resolve_nominal_row(graph, qualified, module_identity) ?? return true
            nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
            if nominal.source == .SourceAST(item) {
                if item == {
                    .Enum(_) -> return false
                    .Distinct(definition) -> return sema_checked_foreign_c_array_element(graph, definition.base, nominal.symbol.module_name)
                    .TypeAlias(definition) -> return sema_checked_foreign_c_array_element(graph, definition.target, nominal.symbol.module_name)
                    .Func(_) | .Struct(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
                }
            }
            true
        }
        .Float | .Bool | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> true
    }
}

sema_checked_foreign_type_error: fn(ty: Type, span: Span, c_abi: Bool) -> Diagnostic {
    if {
        c_abi -> sema_error("E3203", span, "`{type_name(ty)}` is not a C-compatible type for a foreign function parameter or return.", "`#Import` / `#Export` functions must use types with a stable C ABI at the edge.", "Use scalars, `String`, or a struct with C layout; pointers only through the gated tier.")
        else -> sema_error("E0702", span, "the foreign type `{type_name(ty)}` cannot cross into Rust", "foreign functions must return and accept values supported by the Rust FFI boundary", "use a checked value type, `&T` for one-call exclusive access, or `&&T` to give ownership")
    }
}

sema_checked_foreign_integer_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .IntN(_, _) | .InlineRange(_, _, _) -> true
        .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_checked_foreign_array_length_name: fn(name: String) -> Bool Never! {
    lower: sema_checked_ascii_lower(name)
    if lower == {
        "n" | "len" | "length" | "count" | "size" | "num" | "number" -> true
        else -> lower.ends_with("_len") || lower.ends_with("_length") || lower.ends_with("_count") || lower.ends_with("_size") || lower.ends_with("_num") || lower.ends_with("_number") || lower.starts_with("len_") || lower.starts_with("length_") || lower.starts_with("count_") || lower.starts_with("size_") || lower.starts_with("num_") || lower.starts_with("number_")
    }
}

sema_checked_foreign_has_array_length: fn(params: [Param]) -> Bool Never! {
    loop parameter in params {
        if parameter.convention == AccessConvention.Write && sema_checked_foreign_integer_type(parameter.ty) && sema_checked_foreign_array_length_name(parameter.name) -> return true
    }
    false
}

sema_checked_foreign_bridge_handle_type: fn(graph: SemaRegistrationGraph, module_identity: String, ty: Type, handles: [SemaCheckedForeignHandle]) -> Bool Never! {
    qualified: sema_checked_qualify_type(graph, ty, module_identity)
    nominal_row: sema_type_resolve_nominal_row(graph, qualified, module_identity) ?? return false
    nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
    if nominal.kind != SemaRegistrationNominalKind.ForeignHandle -> return false
    if nominal.source == {
        .ForeignHandle(facts) -> sema_checked_foreign_handle_source_matches(handles, facts)
        .SourceAST(_) | .CompilerBuiltinTrait(_) -> false
    }
}

sema_checked_foreign_bridge_scalar_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .IntN(_, _) | .Float | .Float32 | .Bool -> true
        .InlineRange(base, _, _) | .Tagged(_, base) | .Quantity(base, _) -> sema_checked_foreign_bridge_scalar_type(base)
        .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Union(_) | .Case(_, _) | .Measure(_) -> false
    }
}

sema_checked_foreign_bridge_array_element: fn(graph: SemaRegistrationGraph, module_identity: String, ty: Type, handles: [SemaCheckedForeignHandle]) -> Bool Never! {
    if ty == {
        .Int | .IntN(_, _) | .Float | .Float32 | .Bool | .Char | .InlineRange(_, _, _) | .Tagged(_, _) | .Quantity(_, _) | .Named(_) -> !sema_checked_foreign_bridge_handle_type(graph, module_identity, ty, handles)
        .String | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Union(_) | .Case(_, _) | .Measure(_) -> false
    }
}

sema_checked_foreign_bridge_resident_value: fn(graph: SemaRegistrationGraph, module_identity: String, ty: Type, handles: [SemaCheckedForeignHandle]) -> Bool Never! {
    ty == Type.String || sema_checked_foreign_bridge_scalar_type(ty) || sema_checked_foreign_bridge_handle_type(graph, module_identity, ty, handles)
}

sema_checked_foreign_bridge_companion_count: fn(params: [SemaCheckedForeignParam], except: Int) -> Bool Never! {
    loop (index, parameter) in params {
        if index != except && sema_checked_foreign_array_length_name(parameter.name) && sema_checked_foreign_integer_type(parameter.ty) -> return true
    }
    false
}

sema_checked_foreign_bridge_return_count: fn(params: [SemaCheckedForeignParam]) -> Bool Never! {
    loop parameter in params {
        if parameter.convention == AccessConvention.Write && sema_checked_foreign_array_length_name(parameter.name) && sema_checked_foreign_integer_type(parameter.ty) -> return true
    }
    false
}

sema_checked_foreign_bridge_generated_shape: fn(graph: SemaRegistrationGraph, module_identity: String, generated: Bool, params: [SemaCheckedForeignParam], return_type: Type?, handles: [SemaCheckedForeignHandle]) -> Bool Never! {
    if !generated -> return false
    loop (index, parameter) in params {
        if parameter.ty == {
            .List(inner) -> {
                if parameter.convention == AccessConvention.Move || !sema_checked_foreign_bridge_array_element(graph, module_identity, inner, handles) || !sema_checked_foreign_bridge_companion_count(params, index) -> return false
            }
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
                if parameter.convention == {
                    .Read -> {}
                    .Write -> {
                        return_is_list := false
                        if return_type == {
                            .Val(return_value) -> {
                                if return_value == {
                                    .List(_) -> return_is_list = true
                                    .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
                                }
                            }
                            .None -> {}
                        }
                        if !return_is_list || !sema_checked_foreign_array_length_name(parameter.name) || !sema_checked_foreign_integer_type(parameter.ty) -> return false
                    }
                    .Move -> {
                        if !sema_checked_foreign_bridge_handle_type(graph, module_identity, parameter.ty, handles) -> return false
                    }
                }
            }
        }
    }
    if return_type == {
        .Val(return_value) -> {
            if return_value == {
                .List(_) -> return sema_checked_foreign_bridge_return_count(params)
                .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
            }
        }
        .None -> {}
    }
    true
}

sema_checked_foreign_bridge_resident_shape: fn(graph: SemaRegistrationGraph, module_identity: String, params: [SemaCheckedForeignParam], return_type: Type?, handles: [SemaCheckedForeignHandle]) -> Bool Never! {
    loop parameter in params {
        if parameter.convention == {
            .Read | .Write -> {
                if !sema_checked_foreign_bridge_resident_value(graph, module_identity, parameter.ty, handles) -> return false
            }
            .Move -> {
                if !sema_checked_foreign_bridge_handle_type(graph, module_identity, parameter.ty, handles) -> return false
            }
        }
    }
    if return_type == .Val(returned) -> sema_checked_foreign_bridge_resident_value(graph, module_identity, returned, handles) else -> true
}

sema_checked_foreign_bridge_types_equal: fn(params: [SemaCheckedForeignParam], expected: [Type]) -> Bool Never! {
    if params.len() != expected.len() -> return false
    loop (index, parameter) in params {
        if !type_identity_equal(parameter.ty, expected[index]) -> return false
    }
    true
}

sema_checked_foreign_bridge_all_read: fn(params: [SemaCheckedForeignParam]) -> Bool Never! {
    loop parameter in params {
        if parameter.convention != AccessConvention.Read -> return false
    }
    true
}

sema_checked_foreign_bridge_one_handle: fn(graph: SemaRegistrationGraph, module_identity: String, params: [SemaCheckedForeignParam], handles: [SemaCheckedForeignHandle]) -> Bool Never! {
    params.len() == 1 && sema_checked_foreign_bridge_handle_type(graph, module_identity, params[0].ty, handles)
}

sema_checked_foreign_bridge_legacy_shape: fn(graph: SemaRegistrationGraph, module_identity: String, params: [SemaCheckedForeignParam], return_type: Type?, handles: [SemaCheckedForeignHandle]) -> Bool Never! {
    if !sema_checked_foreign_bridge_all_read(params) -> return false
    if return_type == {
        None -> return params.len() == 0 || sema_checked_foreign_bridge_types_equal(params, [Type]{Type.Int}) || sema_checked_foreign_bridge_one_handle(graph, module_identity, params, handles)
        .Val(return_value) -> {
            if return_value == {
                .Int -> return params.len() == 0 || sema_checked_foreign_bridge_types_equal(params, [Type]{Type.Int}) || sema_checked_foreign_bridge_types_equal(params, [Type]{Type.String}) || sema_checked_foreign_bridge_types_equal(params, [Type]{Type.Int, Type.Int}) || sema_checked_foreign_bridge_types_equal(params, [Type]{Type.Int, Type.String}) || sema_checked_foreign_bridge_one_handle(graph, module_identity, params, handles)
                .Float -> {
                    six_floats := params.len() == 6
                    if six_floats {
                        loop parameter in params {
                            if parameter.ty != Type.Float -> six_floats = false
                        }
                    }
                    return sema_checked_foreign_bridge_types_equal(params, [Type]{Type.Float}) || six_floats || sema_checked_foreign_bridge_types_equal(params, [Type]{Type.Int, Type.String}) || sema_checked_foreign_bridge_one_handle(graph, module_identity, params, handles)
                }
                .Bool -> return params.len() == 0 || sema_checked_foreign_bridge_types_equal(params, [Type]{Type.Bool}) || sema_checked_foreign_bridge_one_handle(graph, module_identity, params, handles)
                .String -> return sema_checked_foreign_bridge_types_equal(params, [Type]{Type.String}) || sema_checked_foreign_bridge_types_equal(params, [Type]{Type.Int, Type.String}) || sema_checked_foreign_bridge_types_equal(params, [Type]{Type.Int, Type.String, Type.Int}) || sema_checked_foreign_bridge_one_handle(graph, module_identity, params, handles)
                .Named(_) -> return params.len() == 0 && sema_checked_foreign_bridge_handle_type(graph, module_identity, return_type ?? Type.Named{name: "Unit"}, handles)
                .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return false
            }
        }
    }
    false
}

sema_checked_foreign_bridge_eligible: fn(graph: SemaRegistrationGraph, module_identity: String, registered: SemaRegistrationForeignFunction, params: [SemaCheckedForeignParam], return_type: Type?, handles: [SemaCheckedForeignHandle]) -> Bool Never! {
    if registered.owner != SemaRegistrationForeignOwner.CModule -> return false
    generated: registered.declaration.generated
    transport: registered.declaration.callback_transport
    managed: generated && ((transport ?? "") == "managed" || (transport ?? "") == "managed-close" || (transport ?? "") == "emit-task" || registered.declaration.name.starts_with("__jet_native_"))
    managed || sema_checked_foreign_bridge_generated_shape(graph, module_identity, generated, params, return_type, handles) || sema_checked_foreign_bridge_resident_shape(graph, module_identity, params, return_type, handles) || sema_checked_foreign_bridge_legacy_shape(graph, module_identity, params, return_type, handles)
}

sema_checked_foreign_signature: fn(graph: SemaRegistrationGraph, module_identity: String, registered: SemaRegistrationForeignFunction, c_abi: Bool, handles: [SemaCheckedForeignHandle], diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    loop parameter in registered.declaration.params {
        if !sema_checked_foreign_type(graph, parameter.ty, module_identity, c_abi, registered.declaration.generated, handles, [String]{}) && !(c_abi && parameter.convention == AccessConvention.Write && sema_checked_foreign_by_reference_struct(graph, parameter.ty, module_identity, [String]{})) {
            diagnostics.push(sema_checked_foreign_type_error(parameter.ty, parameter.ty_span, c_abi))
            valid = false
        }
    }
    if registered.declaration.return_type == .Val(return_type) {
        return_span: registered.declaration.return_type_span ?? registered.declaration.name_span
        pointer_return: if return_type == {
            .Apply(name, _) -> c_abi && name == "Ptr"
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        if {
            pointer_return -> {
                row: diagnostic_registry_row("E3202") ?? panic("E3202 has no registry row")
                diagnostics.push(sema_error("E3202", return_span, row.what.replace("{{ty}}", type_name(return_type)), row.why, row.fix))
                valid = false
            }
            !sema_checked_foreign_type(graph, return_type, module_identity, c_abi, registered.declaration.generated, handles, [String]{}) -> {
                diagnostics.push(sema_checked_foreign_type_error(return_type, return_span, c_abi))
                valid = false
            }
            else -> {}
        }
        generated_list_return := false
        if return_type == {
            .List(_) -> generated_list_return = true
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
        }
        if c_abi && registered.declaration.generated && generated_list_return && !sema_checked_foreign_has_array_length(registered.declaration.params) {
            diagnostics.push(sema_checked_foreign_type_error(return_type, return_span, c_abi))
            valid = false
        }
    }
    valid
}

sema_checked_foreign_abi: fn(graph: SemaRegistrationGraph, registered: SemaRegistrationForeignFunction, diagnostics: &[Diagnostic]) -> Bool {
    if registered.owner == SemaRegistrationForeignOwner.ExternRust {
        if registered.declaration.abi == .Val(abi) {
            diagnostics.push(sema_error("E3212", abi.span, "`#ABI` only applies to C declarations", "Rust FFI uses its declared Rust ABI and cannot select a C calling convention", "remove `#ABI` from the `extern rust` function"))
            return false
        }
        return true
    }
    abi: registered.declaration.abi ?? return true
    known: if abi.name == {
        "system" | "cdecl" | "stdcall" | "fastcall" | "win64" | "sysv64" -> true
        else -> false
    }
    if !known {
        diagnostics.push(sema_error("E3212", abi.span, "`{abi.name}` is not a known C calling convention", "`#ABI` accepts only the ratified native ABI names", "use `system`, `cdecl`, `stdcall`, `fastcall`, `win64`, or `sysv64`"))
        return false
    }
    // Admissibility follows the selected target, not the compiler host.
    windows: graph.target_machine.triple.contains("windows")
    x86: graph.target_machine.triple.starts_with("i686-")
    x64: graph.target_machine.triple.starts_with("x86_64-")
    available: if abi.name == {
        "system" -> true
        "cdecl" | "stdcall" | "fastcall" -> windows && x86
        "win64" -> windows && x64
        "sysv64" -> !windows && x64
        else -> false
    }
    valid := true
    if !available {
        diagnostics.push(sema_error("E3213", abi.span, "`{abi.name}` is not available on this target", "native calling conventions are restricted by operating system and architecture", "use the default C ABI or `system` for portable declarations"))
        valid = false
    }
    variadic := false
    loop param in registered.declaration.params {
        if param.variadic -> variadic = true
    }
    if variadic && !(abi.name == "cdecl" && windows && x86) {
        diagnostics.push(sema_error("E3214", abi.span, "variadic C function `{registered.declaration.name}` cannot use `{abi.name}`", "variadics allow only the default C ABI, or cdecl on Windows x86", "remove `#ABI`, or use `#ABI(cdecl)` on Windows x86"))
        valid = false
    }
    valid
}

sema_checked_foreign_access_keyword: fn(convention: AccessConvention) -> String Never! {
    if convention == {
        .Read -> "read"
        .Write -> "&"
        .Move -> "&&"
    }
}

sema_checked_foreign_close: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, registered: SemaRegistrationForeignFunction, providers: [SemaCheckedForeignProvider], diagnostics: &[Diagnostic]) -> Bool {
    close: registered.declaration.close ?? return true
    return_type: registered.declaration.return_type ?? {
        diagnostics.push(sema_error("E0702", close.span, "`#Close({close.name})` is attached to `{registered.declaration.name}`", "a close function belongs to a returned foreign handle", "remove `#Close`, or give the foreign function a handle return type"))
        return false
    }
    function_candidate := SemaRegistrationFunction?{None}
    loop function_index in 0..<module_row.functions.len() {
        if module_row.functions[function_index].declaration.name == close.name {
            function_candidate = Val(module_row.functions[function_index])
            break
        }
    }
    if function_candidate == .Val(candidate_value) {
        valid: candidate_value.parameters.len() == 1 && !candidate_value.parameters[0].variadic && candidate_value.parameters[0].convention == AccessConvention.Move && candidate_value.parameters[0].ty == return_type && candidate_value.declaration.return_type == None
        if valid -> return true
        diagnostics.push(sema_error("E0702", candidate_value.declaration.name_span, "foreign close function `{close.name}` has the wrong signature", "`#Close` runs the named function exactly once by consuming the returned handle", "declare one `&&` parameter with the returned handle type and no return value"))
        return false
    }
    candidate := SemaRegistrationForeignFunction?{None}
    loop function_index in 0..<module_row.foreign_functions.len() {
        if module_row.foreign_functions[function_index].declaration.name == close.name {
            candidate = Val(module_row.foreign_functions[function_index])
            break
        }
    }
    if candidate == None {
        loop provider in providers {
            if provider.module_identity != module_row.module_identity -> next
            loop adapter in provider.close_adapters {
                if adapter.adapter_function != close.name -> next
                loop function_index in 0..<module_row.foreign_functions.len() {
                    if module_row.foreign_functions[function_index].declaration.name == adapter.raw_function && module_row.foreign_functions[function_index].declaration.return_type != None && module_row.foreign_functions[function_index].parameters.len() == 1 {
                        parameter: module_row.foreign_functions[function_index].parameters[0]
                        handle_match: return_type == Type.Named{name: adapter.handle_type}
                        if !parameter.variadic && parameter.convention == AccessConvention.Move && parameter.ty == return_type && handle_match -> return true
                    }
                }
            }
        }
    }
    candidate_value: candidate ?? {
        diagnostics.push(sema_error("E0702", close.span, "foreign close function `{close.name}` is not declared", "the close protocol must name a function in the same foreign binding", "declare the close function with one consuming handle parameter, or remove `#Close`"))
        return false
    }
    valid: candidate_value.parameters.len() == 1 && !candidate_value.parameters[0].variadic && candidate_value.parameters[0].convention == AccessConvention.Move && candidate_value.parameters[0].ty == return_type && candidate_value.declaration.return_type == None
    if valid -> return true
    diagnostics.push(sema_error("E0702", candidate_value.declaration.name_span, "foreign close function `{close.name}` has the wrong signature", "`#Close` runs the named function exactly once by consuming the returned handle", "declare one `&&` parameter with the returned handle type and no return value"))
    false
}

sema_checked_foreign_undo: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, registered: SemaRegistrationForeignFunction, diagnostics: &[Diagnostic]) -> Bool {
    inverse: registered.declaration.undo ?? return true
    inverse_params := [SemaRegistrationParameter]{}
    inverse_return := Type?{None}
    found := false
    // A C binding lives in a shared module; its inverse belongs to the module
    // that imports the binding and defines that name. Two such modules leave
    // the owner ambiguous.
    owners := [Int]{}
    loop edge in graph.edges {
        if edge.target_module_identity != module_row.module_identity || edge.source_module_identity == module_row.module_identity -> next
        loop (position, candidate) in graph.modules {
            if candidate.module_identity != edge.source_module_identity || owners.contains(position) -> next
            loop function in candidate.functions {
                if function.declaration.name == inverse.name {
                    owners.push(position)
                    break
                }
            }
        }
    }
    if owners.len() > 1 {
        names := [String]{}
        loop position in owners -> names.push(graph.modules[position].module_name)
        diagnostics.push(sema_error("E0105", inverse.span, "undo function `{inverse.name}` is ambiguous for foreign binding `{registered.declaration.name}`", "the shared C binding is imported by more than one module that defines `{inverse.name}`: {names.join(", ")}", "give the foreign binding one uniquely named inverse in one defining module"))
        return false
    }
    if owners.len() == 1 {
        loop function in graph.modules[owners[0]].functions {
            if function.declaration.name == inverse.name {
                inverse_params = function.parameters
                inverse_return = function.declaration.return_type
                found = true
                break
            }
        }
    }
    loop function_index in 0..<module_row.functions.len() {
        if found -> break
        if module_row.functions[function_index].declaration.name == inverse.name {
            inverse_params = module_row.functions[function_index].parameters
            inverse_return = module_row.functions[function_index].declaration.return_type
            found = true
            break
        }
    }
    if !found {
        loop function_index in 0..<module_row.foreign_functions.len() {
            if module_row.foreign_functions[function_index].declaration.name == inverse.name {
                inverse_params = module_row.foreign_functions[function_index].parameters
                inverse_return = module_row.foreign_functions[function_index].declaration.return_type
                found = true
                break
            }
        }
    }
    if !found {
        diagnostics.push(sema_error("E0102", inverse.span, "undo function `{inverse.name}` is not defined", "rollback must call a function that is registered in the same program", "define the undo function or correct the `#Undo` name"))
        return false
    }
    if inverse_params.len() != registered.parameters.len() {
        diagnostics.push(sema_error("E0104", inverse.span, "undo function `{inverse.name}` expects {inverse_params.len()} arguments, but `{registered.declaration.name}` has {registered.parameters.len()}", "the compensating call receives the same captured arguments as the foreign call", "give the undo function the same parameter count as the foreign call"))
        return false
    }
    valid := true
    loop (index, forward) in registered.parameters {
        inverse_parameter: inverse_params[index]
        forward_type: sema_checked_qualify_type(graph, forward.ty, module_row.module_identity)
        inverse_type: sema_checked_qualify_type(graph, inverse_parameter.ty, module_row.module_identity)
        if forward.convention != inverse_parameter.convention || !type_identity_equal(forward_type, inverse_type) {
            reason: if forward.convention != inverse_parameter.convention -> "access convention `{sema_checked_foreign_access_keyword(inverse_parameter.convention)}` does not match `{sema_checked_foreign_access_keyword(forward.convention)}`" else -> "type `{type_name(inverse_type)}` does not match `{type_name(forward_type)}`"
            diagnostics.push(sema_error("E0112", inverse.span, "undo function `{inverse.name}` parameter {index + 1} is incompatible with `{registered.declaration.name}`: {reason}", "rollback passes the foreign call's captured arguments to the inverse with the same Jet signature", "make parameter {index + 1} of `{inverse.name}` use the same type and access convention as `{registered.declaration.name}`"))
            valid = false
        }
    }
    if inverse_return == .Val(return_type) {
        if return_type != (Type.Named{name: "Unit"}) {
            diagnostics.push(sema_error("E0113", inverse.span, "undo function `{inverse.name}` returns `{type_name(return_type)}`, but rollback functions must return Unit", "rollback invokes the inverse for its side effect and cannot use a returned value", "remove `{type_name(return_type)}` from `{inverse.name}` so it returns Unit"))
            valid = false
        }
    }
    valid
}

sema_checked_foreign_crate_version: fn(library: String, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if library == "std" || library.split("@").len() > 1 -> return true
    diagnostics.push(sema_error("E0701", span, "the crate `{library}` needs a version pin", "every non-`std` `extern rust` crate must pin an exact version so builds stay reproducible", "write `extern rust \"{library}@0.1\" {{ ... }}`"))
    false
}

sema_checked_foreign_first_library: fn(module_row: SemaRegistrationModule, registered: SemaRegistrationForeignFunction) -> Bool Never! {
    loop function_index in 0..<module_row.foreign_functions.len() {
        if module_row.foreign_functions[function_index].owner == registered.owner && module_row.foreign_functions[function_index].foreign_library == registered.foreign_library {
            return module_row.foreign_functions[function_index].symbol.id.key == registered.symbol.id.key
        }
    }
    true
}

// Rust `inline_ffi_scalar`: the scalar values every inline foreign binder accepts.
sema_checked_inline_ffi_scalar: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Float32 | .Bool -> true
        .IntN(_, bits) -> bits == 8 || bits == 16 || bits == 32 || bits == 64
        .InlineRange(_, _, _) -> true
        .Named(name) -> name == "Unit"
        .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// Rust `inline_asm_integer`: the general-purpose register values of the
// assembly binder.
sema_checked_inline_asm_integer: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .IntN(_, bits) -> bits == 8 || bits == 16 || bits == 32 || bits == 64
        .InlineRange(_, _, _) -> true
        .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// Rust `inline_asm_integer_or_void`: an assembly result register or no result.
sema_checked_inline_asm_integer_or_void: fn(ty: Type) -> Bool Never! {
    if ty == .Named(name) -> return name == "Unit"
    sema_checked_inline_asm_integer(ty)
}

sema_checked_inline_validation: fn(module_row: SemaRegistrationModule, registered: SemaRegistrationFunction, diagnostics: &[Diagnostic]) -> Bool {
    inline: registered.declaration.inline_foreign ?? return true
    language: sema_checked_ascii_lower(inline.lang)
    if language == {
        "c" | "cpp" | "asm" -> {}
        else -> {
            diagnostics.push(sema_error("E3220", inline.lang_span, "no inline foreign binder for `{inline.lang}` yet", "the inline foreign tier ships `c`, `cpp`, and `asm`; no other language has an inline binder yet", "use `#FFI(c)`, `#FFI(cpp)`, or `#FFI(asm)`"))
            return false
        }
    }
    if !registered.declaration.is_unsafe {
        diagnostics.push(sema_error("E3215", inline.marker_span, "`#FFI({inline.lang})` needs an `#Unsafe(\"reason\")` gate", "`{inline.lang}` is an unsafe foreign language — an inline `{inline.lang}` body can break memory safety, so Jet requires you to state why it is sound to call", "add the gate: `#[Unsafe(\"…\"), FFI({inline.lang})] name: fn …`"))
        return false
    }
    scalar_valid := registered.declaration.type_params.len() == 0
    loop parameter in registered.declaration.params {
        if !sema_checked_inline_ffi_scalar(parameter.ty) -> scalar_valid = false
    }
    if registered.declaration.return_type == .Val(return_type) {
        if !sema_checked_inline_ffi_scalar(return_type) -> scalar_valid = false
    }
    if !scalar_valid {
        diagnostics.push(sema_error("E3222", registered.declaration.name_span, "`#FFI({inline.lang})` has a signature its binder can't represent", "inline foreign contracts are ABI boundaries; this systems tier accepts concrete integer, float, and Bool values only", "replace generic, collection, String, callback, or user-defined values with an explicit scalar ABI contract"))
        return false
    }
    if language != "asm" -> return true
    // Rust `check_inline_asm`: the register binder takes integers only.
    asm_valid := true
    loop parameter in registered.declaration.params {
        if !sema_checked_inline_asm_integer(parameter.ty) -> asm_valid = false
    }
    if registered.declaration.return_type == .Val(return_type) {
        if !sema_checked_inline_asm_integer_or_void(return_type) -> asm_valid = false
    }
    if !asm_valid {
        diagnostics.push(sema_error("E3222", registered.declaration.name_span, "`#FFI(asm)` has a signature its register binder can't represent", "the audited assembly bridge uses general-purpose integer registers; floats and Bool need explicit conversion in Jet before the boundary", "use Int or I8/I16/I32/I64/U8/U16/U32/U64 parameters and return values"))
        return false
    }
    if !sema_function_header_inline_has_core_mem(module_row) {
        diagnostics.push(sema_error("E3102", inline.marker_span, "inline assembly is part of the low-level memory tier", "assembly can read registers and memory outside Jet's safe value model, so discovery requires the explicit `core.mem` opt-in", "add `use core.mem` at the top of this file"))
        return false
    }
    true
}

sema_checked_inline_undo: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, registered: SemaRegistrationFunction, diagnostics: &[Diagnostic]) -> Bool {
    inverse: registered.declaration.undo ?? return true
    inverse_params := [SemaRegistrationParameter]{}
    inverse_return := Type?{None}
    found := false
    loop function_index in 0..<module_row.functions.len() {
        if module_row.functions[function_index].declaration.name == inverse.name {
            inverse_params = module_row.functions[function_index].parameters
            inverse_return = module_row.functions[function_index].declaration.return_type
            found = true
            break
        }
    }
    if !found {
        loop function_index in 0..<module_row.foreign_functions.len() {
            if module_row.foreign_functions[function_index].declaration.name == inverse.name {
                inverse_params = module_row.foreign_functions[function_index].parameters
                inverse_return = module_row.foreign_functions[function_index].declaration.return_type
                found = true
                break
            }
        }
    }
    if !found {
        diagnostics.push(sema_error("E0102", inverse.span, "undo function `{inverse.name}` is not defined", "rollback must call a function that is registered in the same program", "define the undo function or correct the `#Undo` name"))
        return false
    }
    if inverse_params.len() != registered.parameters.len() {
        diagnostics.push(sema_error("E0104", inverse.span, "undo function `{inverse.name}` expects {inverse_params.len()} arguments, but `{registered.declaration.name}` has {registered.parameters.len()}", "the compensating call receives the same captured arguments as the foreign call", "give the undo function the same parameter count as the foreign call"))
        return false
    }
    valid := true
    loop (index, forward) in registered.parameters {
        inverse_parameter: inverse_params[index]
        forward_type: sema_checked_qualify_type(graph, forward.ty, module_row.module_identity)
        inverse_type: sema_checked_qualify_type(graph, inverse_parameter.ty, module_row.module_identity)
        if forward.convention != inverse_parameter.convention || !type_identity_equal(forward_type, inverse_type) {
            diagnostics.push(sema_error("E0112", inverse.span, "undo function `{inverse.name}` parameter {index + 1} is incompatible with `{registered.declaration.name}`", "rollback passes the foreign call's captured arguments to the inverse with the same Jet signature", "make parameter {index + 1} of `{inverse.name}` use the same type and access convention as `{registered.declaration.name}`"))
            valid = false
        }
    }
    if inverse_return == .Val(return_type) {
        if return_type != (Type.Named{name: "Unit"}) {
            diagnostics.push(sema_error("E0113", inverse.span, "undo function `{inverse.name}` returns `{type_name(return_type)}`, but rollback functions must return Unit", "rollback invokes the inverse for its side effect and cannot use a returned value", "remove `{type_name(return_type)}` from `{inverse.name}` so it returns Unit"))
            valid = false
        }
    }
    valid
}

sema_checked_foreign_handle_key_for_type: fn(graph: SemaRegistrationGraph, module_identity: String, ty: Type, provider: SemaCheckedForeignProvider) -> String? {
    qualified: sema_checked_qualify_type(graph, ty, module_identity)
    nominal_row: sema_type_resolve_nominal_row(graph, qualified, module_identity) ?? return None
    nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
    if nominal.source == {
        .ForeignHandle(facts) -> if sema_checked_foreign_handle_source_matches(provider.handles, facts) -> Val("c::{provider.module_library}::{facts.jet_name}") else -> None
        .SourceAST(_) | .CompilerBuiltinTrait(_) -> None
    }
}

sema_checked_foreign_handle_key: fn(graph: SemaRegistrationGraph, module_identity: String, registered: SemaRegistrationForeignFunction, providers: [SemaCheckedForeignProvider]) -> String? {
    loop provider in providers {
        if provider.module_identity != module_identity -> next
        if registered.declaration.return_type == .Val(return_type) {
            key := sema_checked_foreign_handle_key_for_type(graph, module_identity, return_type, provider)
            if key != None -> return key
        }
        loop parameter in registered.parameters {
            key := sema_checked_foreign_handle_key_for_type(graph, module_identity, parameter.ty, provider)
            if key != None -> return key
        }
    }
    None
}

sema_checked_foreign_close_foreign_key: fn(module_row: SemaRegistrationModule, registered: SemaRegistrationForeignFunction, providers: [SemaCheckedForeignProvider]) -> String? {
    close: registered.declaration.close ?? return None
    if sema_checked_foreign_registered_close_key(module_row, Val(close)) != None -> return None
    loop provider in providers {
        if provider.module_identity != module_row.module_identity -> next
        loop adapter in provider.close_adapters {
            if adapter.adapter_function != close.name -> next
            loop function_index in 0..<module_row.foreign_functions.len() {
                if module_row.foreign_functions[function_index].declaration.name == adapter.raw_function -> return Val(module_row.foreign_functions[function_index].symbol.id.key)
            }
        }
    }
    loop function_index in 0..<module_row.foreign_functions.len() {
        if module_row.foreign_functions[function_index].declaration.name == close.name -> return Val(module_row.foreign_functions[function_index].symbol.id.key)
    }
    None
}

sema_checked_foreign_registered_close_key: fn(module_row: SemaRegistrationModule, close: NamedSpan?) -> String? {
    named: close ?? return None
    loop function_index in 0..<module_row.functions.len() {
        if module_row.functions[function_index].declaration.name == named.name -> return Val(module_row.functions[function_index].symbol.id.key)
    }
    None
}

sema_checked_foreign_boundary_effect: fn(registered: SemaRegistrationForeignFunction, providers: [SemaCheckedForeignProvider], diagnostics: &[Diagnostic]) -> Bool {
    loop provider in providers {
        if provider.module_identity != registered.symbol.module_name -> next
        if provider.boundary == .Val(boundary) {
            if registered.abi.foreign_effect_root == .Val(root) {
                if root != boundary.effect_root || !sema_checked_foreign_list_has(boundary.effects.split(";").to_list(), root) {
                    diagnostics.push(sema_checked_foreign_provider_error(registered.declaration.span, "foreign function effect root disagrees with its provider boundary", "generated C functions must retain the descriptor-owned effect root", "preserve the provider boundary effect root on the foreign declaration"))
                    return false
                }
            }
        }
    }
    true
}

sema_checked_foreign_row: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, registered: SemaRegistrationForeignFunction, providers: [SemaCheckedForeignProvider], diagnostics: &[Diagnostic]) -> SemaCheckedForeignFunction? {
    valid := true
    rust_owner: registered.owner == SemaRegistrationForeignOwner.ExternRust
    c_abi: registered.owner == SemaRegistrationForeignOwner.CModule
    handles := [SemaCheckedForeignHandle]{}
    scoped_providers := [SemaCheckedForeignProvider]{}
    if {
        c_abi -> {
            loop provider in providers {
                if provider.module_identity != module_row.module_identity -> next
                scoped_providers.push(provider.copy())
                loop handle in provider.handles -> handles.push(handle.copy())
            }
        }
        else -> {
            scoped_providers = providers
        }
    }
    if rust_owner && sema_checked_foreign_first_library(module_row, registered) && !sema_checked_foreign_crate_version(registered.foreign_library, registered.foreign_library_span, diagnostics) -> valid = false
    if !sema_checked_foreign_abi(graph, registered, diagnostics) -> valid = false
    if !sema_checked_foreign_signature(graph, module_row.module_identity, registered, c_abi, handles, diagnostics) -> valid = false
    if !sema_checked_foreign_close(graph, module_row, registered, scoped_providers, diagnostics) -> valid = false
    if !sema_checked_foreign_undo(graph, module_row, registered, diagnostics) -> valid = false
    if c_abi && !sema_checked_foreign_boundary_effect(registered, scoped_providers, diagnostics) -> valid = false
    if !valid -> return None
    module_identity: module_row.module_identity
    key: if rust_owner -> sema_checked_foreign_key(module_identity, registered.declaration.rust_path) else -> sema_checked_foreign_key(module_identity, registered.declaration.name)
    symbol: if rust_owner -> key else -> registered.declaration.rust_path
    // An `extern rust` crate is resolved by the foreign-crate build, not by an
    // IR link unit; only C providers own link rows.
    link_key: if rust_owner -> None else -> Val("c::{registered.foreign_library}")
    close_key: sema_checked_foreign_registered_close_key(module_row, registered.declaration.close)
    undo_key: sema_checked_foreign_named_key(module_identity, registered.declaration.undo)
    params: sema_checked_foreign_params(graph, module_identity, registered.parameters)
    return_type: sema_checked_foreign_return_type(graph, module_identity, registered.declaration.return_type)
    handle_key := if c_abi -> sema_checked_foreign_handle_key(graph, module_identity, registered, scoped_providers) else -> None
    bridge_eligible: if c_abi -> sema_checked_foreign_bridge_eligible(graph, module_identity, registered, params, return_type, handles) else -> true
    SemaCheckedForeignFunction{
        symbol_id: registered.symbol.id,
        key: key,
        module_identity: module_identity,
        module_name: module_row.module_name,
        module_path: module_row.module_path,
        source_file: module_row.source_file,
        name: registered.declaration.name,
        span: registered.declaration.span,
        owner: sema_checked_foreign_owner(registered.owner),
        symbol: symbol,
        path: registered.declaration.rust_path,
        params: params,
        raw_scalar_abi: false,
        bridge_eligible: bridge_eligible,
        return_type: return_type,
        abi: sema_checked_foreign_abi_name(registered.abi),
        language: if rust_owner -> "rust:{registered.foreign_library}" else -> "c",
        effect_root: registered.abi.foreign_effect_root,
        callback_transport: registered.abi.callback_transport,
        callback_plan_digest: registered.abi.callback_plan_digest,
        callback_identity: registered.abi.callback_identity,
        link_key: link_key,
        handle_key: handle_key,
        callback_key: None,
        close_function_key: close_key,
        close_foreign_key: sema_checked_foreign_close_foreign_key(module_row, registered, scoped_providers),
        undo_function_key: undo_key,
        asm_contract: None,
        unsafe_gate: None,
    }
}

sema_checked_inline_foreign_row: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, registered: SemaRegistrationFunction, diagnostics: &[Diagnostic]) -> SemaCheckedForeignFunction? {
    if !registered.abi.is_extern -> return None
    inline: registered.declaration.inline_foreign ?? return None
    if !sema_checked_inline_validation(module_row, registered, diagnostics) -> return None
    if !sema_checked_inline_undo(graph, module_row, registered, diagnostics) -> return None
    // Rust `check_inline_asm`: an assembly body's operand contract (E3223) for
    // the selected target, kept on the checked row for the wrapper generator,
    // and on x86-64 the mnemonics its template assembler encodes (E3221).
    language: sema_checked_ascii_lower(inline.lang)
    asm_contract: if language == "asm" -> sema_inline_assembly_contract(registered.declaration, graph.target_machine.triple, module_row.source, diagnostics) else -> None
    if language == "asm" && asm_contract == None -> return None
    wrapper: "jet_ffi_{registered.declaration.name}"
    module_identity: module_row.module_identity
    SemaCheckedForeignFunction{
        symbol_id: registered.symbol.id,
        key: sema_checked_foreign_key(module_identity, wrapper),
        module_identity: module_identity,
        module_name: module_row.module_name,
        module_path: module_row.module_path,
        // Rust `function_foreign_provenance` keeps the leaf on its own source
        // file, as an ordinary checked function's FnBody does, so the native
        // backend reads the inline body from the declaration span.
        source_file: sema_source_file_at(module_row.source_segments, module_row.source_file, module_row.source_origin, registered.declaration.span),
        name: registered.declaration.name,
        span: registered.declaration.span,
        owner: SemaCheckedForeignOwner.Inline,
        symbol: "jet_inline_{wrapper}",
        path: wrapper,
        params: sema_checked_foreign_params(graph, module_identity, registered.parameters),
        raw_scalar_abi: true,
        bridge_eligible: true,
        return_type: sema_checked_foreign_return_type(graph, module_identity, registered.declaration.return_type),
        abi: "C",
        language: language,
        effect_root: None,
        callback_transport: None,
        callback_plan_digest: None,
        callback_identity: None,
        link_key: None,
        callback_key: None,
        handle_key: None,
        close_function_key: None,
        close_foreign_key: None,
        undo_function_key: None,
        asm_contract: asm_contract,
        unsafe_gate: sema_checked_inline_foreign_gate(module_row, registered.declaration),
    }
}

// `lower_guest_import_foreign`: one per-callable `#Import(c)` declaration
// becomes the foreign row its calls bind to. The row keeps the function's
// symbol identity, so a checked direct call to the declaration lowers as a
// foreign C call of the marker's symbol; the declaration itself has no Jet body
// and no FnBody.
sema_checked_guest_import_foreign_row: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, registered: SemaRegistrationFunction) -> SemaCheckedForeignFunction? {
    symbol: parser_guest_import_symbol(registered.declaration) ?? return None
    module_identity: module_row.module_identity
    params: sema_checked_foreign_params(graph, module_identity, registered.parameters)
    // The failure solve projects an unannotated import onto `T Never!` (a C
    // function cannot fail); the C value is still that plain success.
    written := registered.declaration.return_type
    if written == .Val(.Result(ok, err)) && err == (Type.Named{name: "Never"}) -> written = Val(ok)
    return_type: sema_checked_foreign_return_type(graph, module_identity, written)
    bridge_eligible: sema_guest_import_bridge_compatible(registered.declaration)
    // A runtime binding crosses the runtime's route carriers (#6615).
    runtime_binding: sema_guest_runtime_binding(module_row.package_identity, registered.declaration)
    // A plain written return is the default failure carrier at every call
    // site; the C value is that carrier's success (Rust `wraps_default_failure`).
    wraps_default_failure: if registered.declaration.return_type == {
        None -> false
        Val(declared) -> sema_effective_return_type(Val(declared)) != declared
    }
    owner: if module_row.module_name == "" -> "root" else -> module_row.module_name
    wrapper: ast_comptime_generated_path("jet_ffi_guest.{owner}.{registered.declaration.name}")
    SemaCheckedForeignFunction{
        symbol_id: registered.symbol.id,
        key: sema_checked_foreign_key(module_identity, wrapper),
        module_identity: module_identity,
        module_name: module_row.module_name,
        module_path: module_row.module_path,
        source_file: sema_source_file_at(module_row.source_segments, module_row.source_file, module_row.source_origin, registered.declaration.span),
        name: registered.declaration.name,
        span: registered.declaration.span,
        owner: SemaCheckedForeignOwner.GuestImport,
        symbol: symbol,
        path: symbol,
        params: params,
        raw_scalar_abi: !runtime_binding,
        bridge_eligible: bridge_eligible,
        return_type: return_type,
        abi: if runtime_binding -> SEMA_GUEST_RUNTIME_ABI else -> "C",
        language: "c",
        effect_root: None,
        callback_transport: if wraps_default_failure -> Val("guest-import-result") else -> None,
        callback_plan_digest: None,
        callback_identity: None,
        link_key: None,
        callback_key: None,
        handle_key: None,
        close_function_key: None,
        close_foreign_key: None,
        undo_function_key: None,
        asm_contract: None,
        unsafe_gate: sema_checked_inline_foreign_gate(module_row, registered.declaration),
    }
}

// The same gate check_function builds for a gated Jet function (CheckProgram):
// the declaration's source file, the `#Unsafe` marker line, and its reason.
sema_checked_inline_foreign_gate: fn(module_row: SemaRegistrationModule, func: Func) -> TUnsafeGate? {
    if !func.is_unsafe || func.unsafe_reason == None -> return None
    unsafe_span: func.unsafe_span ?? func.span
    line: sema_source_line_at(module_row.source_segments, unsafe_span) ?? return None
    file: sema_source_file_at(module_row.source_segments, module_row.source_file, module_row.source_origin, unsafe_span)
    Val(TUnsafeGate{file: file, line: line, reason: func.unsafe_reason ?? "", enabled: true, fenced: false})
}

// Normalize foreign declarations once after Registration has established
// ownership, signatures, and parameter rows. Codegen consumes these facts and
// never reads ExternFn/Func payloads to reconstruct an ABI decision.
sema_checked_foreign_functions: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, providers: [SemaCheckedForeignProvider], diagnostics: &[Diagnostic]) -> [SemaCheckedForeignFunction] Never! {
    result := [SemaCheckedForeignFunction]{}
    loop registered_index in 0..<module_row.foreign_functions.len() {
        row_value: sema_checked_foreign_row(graph, module_row, module_row.foreign_functions[registered_index], providers, diagnostics) ?? next
        result.push(row_value)
    }
    loop registered_index in 0..<module_row.functions.len() {
        if sema_checked_inline_foreign_row(graph, module_row, module_row.functions[registered_index], diagnostics) == .Val(inline_row) {
            result.push(inline_row)
            next
        }
        guest_row: sema_checked_guest_import_foreign_row(graph, module_row, module_row.functions[registered_index]) ?? next
        result.push(guest_row)
    }
    result
}

sema_checked_declaration_params: fn(graph: SemaRegistrationGraph, caller_module: String, parameters: [SemaRegistrationParameter]) -> [TDeclarationParam] Never! {
    result := [TDeclarationParam]{}
    loop parameter in parameters {
        result.push(TDeclarationParam{
            index: result.len(),
            name: parameter.symbol.name,
            span: parameter.symbol.span,
            ty: sema_checked_qualify_type(graph, parameter.ty, caller_module),
            access: parameter.convention,
            ownership: sema_checked_parameter_ownership(parameter.convention),
            public_label: parameter.public_label ?? "",
            variadic: parameter.variadic,
            default_present: parameter.default != None,
        })
    }
    result
}

sema_checked_trait_method_key: fn(module_row: SemaRegistrationModule, trait_name: String, method: TraitMethodSig) -> String Never! {
    // Trait defaults are registered under their source callable key, matching
    // the canonical checked-tree producer.  Implementations use the owner-qualified
    // key below and never infer this from a parameter name.
    "{module_row.module_identity}::{method.name}"
}

sema_checked_trait_method: fn(graph: SemaRegistrationGraph, method: SemaRegistrationTraitMethod, module_row: SemaRegistrationModule, trait_name: String) -> TTraitMethod Never! {
    declaration: method.declaration
    self_access := AccessConvention?{None}
    parameter_start := 0
    if declaration.params.len() > 0 && declaration.params[0].name == "self" {
        self_access = Val(declaration.params[0].convention)
        parameter_start = 1
    }
    parameters: loop index in parameter_start..<method.parameters.len() -> method.parameters[index]
    qualified_return: sema_checked_qualify_optional_type(graph, declaration.return_type, module_row.module_identity)
    TTraitMethod{
        key: sema_checked_trait_method_key(module_row, trait_name, declaration),
        name: declaration.name,
        span: declaration.span,
        self_access: self_access,
        params: sema_checked_declaration_params(graph, module_row.module_identity, parameters),
        declared_return: qualified_return,
        return_type: sema_checked_qualify_type(graph, sema_effective_return_type(declaration.return_type), module_row.module_identity),
        failure: sema_checked_failure(qualified_return),
        is_pure: declaration.is_pure,
        declared_effects: sema_checked_effects(declaration.declared_effects),
        return_view_provenance: declaration.return_view_provenance,
        declared_return_view_provenance: declaration.declared_return_view_provenance,
        default_function_key: if declaration.default_body != None -> Val(sema_checked_trait_method_key(module_row, trait_name, declaration)) else -> None,
    }
}

sema_checked_trait_associated_types: fn(definition: TraitDef) -> [TAssociatedTypeDecl] Never! {
    associated_types: loop associated in definition.assoc_types -> TAssociatedTypeDecl{name: associated.name, span: associated.span}
    associated_types
}

sema_checked_trait_row_value: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, nominal: SemaRegistrationNominal, definition: TraitDef) -> TTraitDef Never! {
    methods: loop method in nominal.trait_methods -> sema_checked_trait_method(graph, method, module_row, definition.name)
    TTraitDef{
        module_identity: module_row.module_identity,
        key: definition.name,
        name: definition.name,
        span: definition.span,
        visibility: sema_checked_visibility(nominal.symbol.visibility),
        associated_types: sema_checked_trait_associated_types(definition),
        methods: methods,
    }
}

sema_checked_trait_row: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, nominal: SemaRegistrationNominal) -> TTraitDef? {
    if nominal.kind != SemaRegistrationNominalKind.Trait -> return None
    definition: sema_registration_nominal_source_item(nominal.source) ?? return None
    if definition == {
        .Trait(value) -> Val(sema_checked_trait_row_value(graph, module_row, nominal, value))
        .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}

sema_checked_field: fn(field: Field, ty: Type, shape_names: TShapeFieldNames) -> TField Never! {
    TField{
        name: field.name,
        shape_names: shape_names,
        skip: sema_checked_marker(field.serde_markers, "Skip") != None || sema_checked_marker(field.serde_markers, "skip") != None,
        ty: ty,
        span: field.name_span,
        public: field.is_pub,
        package_public: field.is_package_pub,
        computed: field.computed != None,
        has_default: field.default != None,
        redact: field.redact,
    }
}

sema_checked_variant_field: fn(field: VariantField, ty: Type) -> TField Never! {
    TField{
        name: field.name,
        shape_names: sema_checked_shape_names(field.name),
        skip: false,
        ty: ty,
        span: field.name_span,
        public: true,
        package_public: false,
        computed: false,
        has_default: false,
        redact: false,
    }
}

sema_checked_ascii_lower: fn(text: String) -> String Never! {
    bytes := text.bytes()
    loop index in 0..<bytes.len() {
        code: Int.from_u8(bytes[index])
        if code >= 65 && code <= 90 -> bytes[index] = U8{code + 32}
    }
    String.from_bytes(bytes) ?? text
}

sema_checked_wire_words: fn(name: String) -> [String] Never! {
    words := [String]{}
    loop segment in name.split("_") {
        if segment == "" -> next
        bytes: segment.bytes()
        start := 0
        loop index in 0..<bytes.len() {
            code: Int.from_u8(bytes[index])
            if code >= 65 && code <= 90 && index > start {
                previous: Int.from_u8(bytes[index - 1])
                next_lower := false
                if index + 1 < bytes.len() {
                    next_code: Int.from_u8(bytes[index + 1])
                    next_lower = next_code >= 97 && next_code <= 122
                }
                if (previous >= 97 && previous <= 122) || next_lower {
                    word: String.from_bytes(bytes.slice(start, index)) ?? ""
                    if word != "" -> words.push(word)
                    start = index
                }
            }
        }
        if start < bytes.len() {
            word: String.from_bytes(bytes.slice(start, bytes.len())) ?? ""
            if word != "" -> words.push(word)
        }
    }
    words
}

sema_checked_restore_wire_word: fn(word: String) -> String Never! {
    lower: sema_checked_ascii_lower(word)
    if lower == {
        "jethttp" -> "JetHTTP"
        "jettls" -> "JetTLS"
        "jetdns" -> "JetDNS"
        "jettcp" -> "JetTCP"
        "jetudp" -> "JetUDP"
        "jetio" -> "JetIO"
        "jetjson" -> "JetJSON"
        "jetcbor" -> "JetCBOR"
        "jetmime" -> "JetMIME"
        "utf8" -> "UTF8"
        "utf8error" -> "UTF8Error"
        "ipaddr" -> "IPAddr"
        "ip" -> "IP"
        "dbvalue" -> "DBValue"
        "ioerror" -> "IOError"
        "iocontext" -> "IOContext"
        "iooperation" -> "IOOperation"
        "macos" -> "MacOS"
        "http" -> "HTTP"
        "tls" -> "TLS"
        "dns" -> "DNS"
        "tcp" -> "TCP"
        "udp" -> "UDP"
        "html" -> "HTML"
        "json" -> "JSON"
        "toml" -> "TOML"
        "yaml" -> "YAML"
        "csv" -> "CSV"
        "sql" -> "SQL"
        "cli" -> "CLI"
        "abi" -> "ABI"
        "cpu" -> "CPU"
        "gpu" -> "GPU"
        "fs" -> "FS"
        "db" -> "DB"
        "io" -> "IO"
        "os" -> "OS"
        "js" -> "JS"
        "cbor" -> "CBOR"
        "url" -> "URL"
        "mime" -> "MIME"
        else -> {
            bytes := word.bytes()
            if bytes.len() == 0 -> return word.copy()
            code: Int.from_u8(bytes[0])
            if code >= 97 && code <= 122 -> bytes[0] = U8{code - 32}
            rest: String.from_bytes(bytes.slice(1, bytes.len())) ?? ""
            "{String.from_bytes(bytes.slice(0, 1)) ?? ""}{sema_checked_ascii_lower(rest)}"
        }
    }
}

sema_checked_wire_case: fn(style: String?, name: String) -> String Never! {
    style_value: style ?? return name
    words: sema_checked_wire_words(name)
    if words.len() == 0 -> return name.copy()
    if style_value == {
        "kebab" | "snake" | "screaming" -> {
            rendered := [String]{}
            loop word in words {
                if style_value == "screaming" -> rendered.push(sema_checked_ascii_upper(word)) else -> rendered.push(sema_checked_ascii_lower(word))
            }
            rendered.join(if style_value == "kebab" -> "-" else -> "_")
        }
        "pascal" -> {
            output := ""
            loop word in words -> output = "{output}{sema_checked_restore_wire_word(word)}"
            output
        }
        "camel" -> {
            output := sema_checked_ascii_lower(words[0])
            loop index in 1..<words.len() -> output = "{output}{sema_checked_restore_wire_word(words[index])}"
            output
        }
        else -> sema_checked_wire_case(Val("snake"), name)
    }
}

sema_checked_variant_wire_name: fn(variant: Variant, style: String?) -> String Never! {
    rename: sema_checked_marker(variant.serde_markers, "Rename")
    if rename == {
        .Val(marker) -> {
            if sema_checked_marker_text_label(marker, "json") == .Val(label) -> return label
            sema_checked_marker_text(marker) ?? variant.name
        }
        .None -> sema_checked_wire_case(style, variant.name)
    }
}

sema_checked_cli_bindings: fn(module_row: SemaRegistrationModule, definition: StructDef) -> [TCLIBinding] Never! {
    result := [TCLIBinding]{}
    loop binding in definition.cli_bindings {
        target_name: if binding.target == {
            .Ident(name, _, _) -> name
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> binding.name
        }
        markers: loop marker in binding.markers if !marker.negated -> marker.name
        result.push(TCLIBinding{name: binding.name, span: binding.name_span, function_key: sema_checked_module_key(module_row, target_name), markers: markers})
    }
    result
}

// E0119 at a struct field or enum payload type that names nothing (#6294),
// and E0963 at one whose fixed length names nothing: a misspelled member type
// is reported at its declaration, not its first use.
sema_checked_member_type_names: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, ty: Type, span: Span, generic_params: [TGenericParam], diagnostics: &[Diagnostic]) {
    module_index: sema_registration_module_index(graph, module_row.module_identity) ?? return
    generic_names: loop parameter in generic_params -> parameter.name
    sema_type_unknown_written_names(graph, module_index, ty, span, generic_names, diagnostics)
    sema_type_unknown_measure_names(graph, module_index, ty, span, generic_names, diagnostics)
}

// Whether a struct field or enum payload type of `nominal`, a row of module
// `module_index`, names nothing (sema_checked_member_type_names). Such a
// declaration is unusable: each body that meets the type would report
// follow-on errors of its own, so those bodies are not checked
// (sema_checked_unusable_bodies).
sema_checked_member_types_name_nothing: fn(graph: SemaRegistrationGraph, module_index: Int, nominal: SemaRegistrationNominal) -> Bool {
    unknown := [Diagnostic]{}
    generic_names: loop param in nominal.generic_params -> param.name
    item: sema_registration_nominal_source_item(nominal.source) ?? return false
    if item == {
        .Struct(definition) -> loop field in definition.fields -> sema_type_unknown_written_names(graph, module_index, field.ty, field.ty_span, generic_names, unknown)
        .Enum(definition) -> loop variant in definition.variants {
            if variant.payload == {
                .Single(ty, span) -> sema_type_unknown_written_names(graph, module_index, ty, span, generic_names, unknown)
                .Named(fields) -> loop field in fields -> sema_type_unknown_written_names(graph, module_index, field.ty, field.ty_span, generic_names, unknown)
                .Unit -> {}
            }
        }
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    unknown.len() > 0
}

sema_checked_struct_fields: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, definition: StructDef, generic_params: [TGenericParam], diagnostics: &[Diagnostic]) -> [TField] {
    fields := [TField]{}
    loop source_index in 0..<definition.fields.len() {
        sema_checked_member_type_names(graph, module_row, definition.fields[source_index].ty, definition.fields[source_index].ty_span, generic_params, diagnostics)
        ty: sema_checked_qualify_type_with_generics(graph, definition.fields[source_index].ty, module_row.module_identity, generic_params)
        if sema_type_has_forbidden_never(definition.fields[source_index].ty, false) {
            diagnostics.push(sema_never_as_value(definition.fields[source_index].ty_span))
        }
        sema_checked_validate_struct_field(definition, definition.fields[source_index], diagnostics)
        fields.push(sema_checked_field(definition.fields[source_index], ty, sema_checked_field_shape_names(definition, definition.fields[source_index])))
    }
    fields
}

sema_checked_type_contains_name: fn(ty: Type, names: [String]) -> Bool Never! {
    if ty == {
        .Named(name) -> sema_checked_has_name(names, name)
        .Apply(name, args) -> {
            if sema_checked_has_name(names, name) -> return true
            loop arg in args {
                if sema_checked_type_contains_name(arg, names) -> return true
            }
            false
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .Case(_, inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) -> sema_checked_type_contains_name(inner, names)
        .Map(key, _, value) -> sema_checked_type_contains_name(key, names) || sema_checked_type_contains_name(value, names)
        .Result(ok, err) -> sema_checked_type_contains_name(ok, names) || sema_checked_type_contains_name(err, names)
        .Fn(params, ret, _, _, _, _) -> {
            loop parameter in params {
                if sema_checked_type_contains_name(parameter, names) -> return true
            }
            if ret == .Val(returned) -> sema_checked_type_contains_name(returned, names) else -> false
        }
        .Tuple(fields) -> {
            loop field in fields {
                if sema_checked_type_contains_name(field.ty, names) -> return true
            }
            false
        }
        .Union(members) -> {
            loop member in members {
                if sema_checked_type_contains_name(member, names) -> return true
            }
            false
        }
        .Quantity(base, _) -> sema_checked_type_contains_name(base, names)
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> false
    }
}

sema_checked_layout_is_c: fn(layout: StructLayout?) -> Bool Never! {
    value: layout ?? return false
    if value == {
        .C | .CAligned(_, _) -> true
        .Columnar -> false
    }
}

sema_checked_type_is_growable: fn(ty: Type) -> Bool Never! {
    if ty == {
        .String | .List(_) | .Map(_, _, _) -> true
        .Int | .Float | .Bool | .Char | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// E0217 (Rust `cell_guard_storage_diagnostic`): a Cell guard declared inside
// a struct field or an enum payload.
sema_checked_cell_guard_storage: fn(place: String, span: Span) -> Diagnostic {
    sema_error("E0217", span, "a Cell guard cannot be stored in {place}", "a Cell guard is a temporary loan handle; storing it inside another value could keep the loan after its local scope ends", "keep the guard in a local name or a tuple, and use `.map(...)` or `.split(...)` for projections")
}

sema_checked_validate_struct_field: fn(definition: StructDef, field: Field, diagnostics: &[Diagnostic]) {
    if field.computed == None && sema_checked_type_contains_name(field.ty, [String]{"CellReadGuard", "CellEditGuard"}) {
        diagnostics.push(sema_checked_cell_guard_storage("struct field `{field.name}`", field.name_span))
    }
    if field.ty == (Type.Named{name: "Group"}) {
        diagnostics.push(sema_error("E1110", field.name_span, "`Group` cannot be stored in a struct field", "a task group is a scoped spawn authority, not a value that can escape its call stack", "pass `group: Group` directly to a helper function or method instead"))
    }
    if sema_checked_layout_is_c(definition.layout) && sema_checked_type_is_growable(field.ty) {
        diagnostics.push(sema_error("E1104", definition.layout_span ?? field.name_span, "`#Layout(c)` struct `{definition.name}` has a growable field `{field.name}` ({type_name(field.ty)})", "growable types (`[T]`, `Map`, `String`) don't have a stable C layout", "use a fixed-size array `[T#N]` instead, or remove `#Layout(c)`"))
    }
    if sema_checked_type_is_float(field.ty) && sema_checked_money_like_name(field.name) && !sema_checked_allows_float_money(field.serde_markers) && !sema_checked_allows_float_money(definition.serde_markers) {
        diagnostics.push(sema_lint("L0504", field.name_span, "field `{field.name}` looks like money but has type `Float`", "floating-point money loses cents on common values like `0.1 + 0.2`", "use `Decimal` for exact money, or suppress with `#Allow(jet.FloatMoney, \"why\")` on the field"))
    }
}

// The float-money lint (and `is_money_like_name`/`allows_float_money` @
// 6083377777).
SEMA_CHECKED_MONEY_WORDS: [String]{"price", "cost", "amount", "fee", "balance", "tax"}

sema_checked_type_is_float: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Float | .Float32 -> true
        .Tagged(_, inner) -> sema_checked_type_is_float(inner)
        .Quantity(base, _) -> sema_checked_type_is_float(base)
        .Int | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Union(_) | .Case(_, _) | .Measure(_) -> false
    }
}

sema_checked_money_like_name: fn(name: String) -> Bool Never! {
    lower: sema_checked_ascii_lower(name)
    loop word in SEMA_CHECKED_MONEY_WORDS {
        if lower.contains(word) -> return true
    }
    false
}

sema_checked_allows_float_money: fn(markers: [Marker]) -> Bool Never! {
    loop marker in markers {
        if (sema_lint_allowance_name(marker) ?? next) == "jet.FloatMoney" -> return true
    }
    false
}

sema_checked_validate_layout: fn(definition: StructDef, diagnostics: &[Diagnostic]) {
    if definition.layout == .Val(layout) {
        if layout == .CAligned(alignment, target_mode) {
            reason: if {
                alignment <= 0 -> "the value is not positive"
                (alignment).bit_and((alignment - 1)) != 0 -> "the value is not a power of two"
                !target_mode && alignment > 1048576 -> "the value is larger than the portable baseline of 1048576 bytes"
                else -> ""
            }
            if reason != "" {
                suggestion: "{sema_checked_usable_alignment(alignment, target_mode)}"
                span: definition.layout_alignment_span ?? (definition.layout_span ?? definition.name_span)
                row: diagnostic_registry_row("E1119") ?? panic("E1119 has no registry row")
                diagnostics.push(sema_error("E1119", span, row.what.replace("{{value}}", "{alignment}"), row.why.replace("{{reason}}", reason), row.fix.replace("{{suggestion}}", suggestion)))
            }
        }
    }
}

// The largest power of two at or below `alignment`, at least 1 and, outside
// target mode, at most the portable baseline.
sema_checked_usable_alignment: fn(alignment: Int, target_mode: Bool) -> Int Never! {
    limit: if !target_mode && alignment > 1048576 -> 1048576 else -> alignment
    usable := 1
    loop {
        if usable * 2 > limit -> break
        usable = usable * 2
    }
    usable
}

// `process_computed_fields`: E0382 for a field `#Memo` without a bare formula,
// then E0338 for a computed-field cycle.
sema_checked_validate_field_policy: fn(definition: StructDef, diagnostics: &[Diagnostic]) {
    loop field_index in 0..<definition.fields.len() {
        loop marker in definition.fields[field_index].serde_markers {
            if marker.name != MARKER_MEMO -> next
            if definition.fields[field_index].computed == None || marker.args.len() != 0 {
                diagnostics.push(sema_error("E0382", marker.span, "`#Memo` cannot mark `{definition.fields[field_index].name}`.", "A stored computed result needs a formula and its dependency set; field `#Memo` does not take cache arguments.", "Write `#Memo` before `{definition.fields[field_index].name}: T -> expr` without arguments."))
            }
            break
        }
    }
    names := [String]{}
    spans := [Span]{}
    formulas := [Expr]{}
    loop field_index in 0..<definition.fields.len() {
        if definition.fields[field_index].computed == .Val(formula) {
            names.push(definition.fields[field_index].name)
            spans.push(definition.fields[field_index].name_span)
            formulas.push(formula.copy())
        }
    }
    if names.len() == 0 -> return
    // `expr_refs_name`: an identifier read or a call name.
    deps := [[Int]]{}
    loop formula in formulas {
        referenced := [String]{}
        loop site in comptime_walk_identifiers(formula) -> referenced.push(site.name)
        loop site in comptime_walk_calls(formula) -> referenced.push(site.name)
        edges := [Int]{}
        loop index in 0..<names.len() {
            if referenced.contains(names[index]) -> edges.push(index)
        }
        deps.push(edges)
    }
    colors := [Int]{}
    reported := [Bool]{}
    loop _ in names {
        colors.push(0)
        reported.push(false)
    }
    loop index in 0..<names.len() {
        if colors[index] == 0 -> sema_checked_computed_field_visit(definition.name, index, names, spans, deps, colors, reported, diagnostics)
    }
}

// Depth-first walk over computed-field dependencies; colors are 0 white,
// 1 gray (on the current path) and 2 black (finished).
sema_checked_computed_field_visit: fn(struct_name: String, node: Int, names: [String], spans: [Span], deps: [[Int]], colors: &[Int], reported: &[Bool], diagnostics: &[Diagnostic]) {
    colors[node] = 1
    loop neighbor in deps[node] {
        if {
            colors[neighbor] == 1 && !reported[node] -> {
                reported[node] = true
                field: names[node]
                via: names[neighbor]
                what: if field == via -> "computed field `{struct_name}.{field}` references itself" else -> "computed field `{struct_name}.{field}` forms a cycle through `{via}`"
                diagnostics.push(sema_error("E0338", spans[node], what, "a computed field's formula may only reference OTHER fields — the dependency graph among computed fields must have no cycle", "break the cycle: make `{field}` or `{via}` a plain stored field, or rework the formula"))
            }
            colors[neighbor] == 0 -> sema_checked_computed_field_visit(struct_name, neighbor, names, spans, deps, colors, reported, diagnostics)
        }
    }
    colors[node] = 2
}

sema_checked_validate_patchable: fn(definition: StructDef, diagnostics: &[Diagnostic]) {
    patchable := false
    loop derived in definition.derives {
        if derived.name == "Patchable" -> patchable = true
    }
    if !patchable -> return
    if definition.type_params.len() != 0 {
        diagnostics.push(sema_error("E0336", definition.name_span, "`#[Patchable]` on generic struct `{definition.name}` isn't supported yet", "`T.Patch` codegen needs a concrete field list — generic patches are a follow-on", "remove the type parameters, or drop `#[Patchable]` for now"))
        return
    }
    loop field_index in 0..<definition.fields.len() {
        if definition.fields[field_index].ty == .Fn(_, _, _, _, _, _) {
            diagnostics.push(sema_error("E0337", definition.fields[field_index].name_span, "`#[Patchable]` struct `{definition.name}` field `{definition.fields[field_index].name}` has function type", "patches are data values — function-typed fields can't be patched", "store a callable handle type instead, or drop `#[Patchable]`"))
            return
        }
    }
}

sema_checked_wire_style_valid: fn(style: String?) -> Bool Never! {
    value: style ?? return true
    if value == {
        "camel" | "kebab" | "screaming" | "pascal" | "snake" -> true
        else -> false
    }
}

sema_checked_variant_payload: fn(graph: SemaRegistrationGraph, payload: VariantPayload, module_identity: String, generic_params: [TGenericParam]) -> TVariantPayload Never! {
    if payload == {
        .Unit -> TVariantPayload.Unit
        .Single(ty, _) -> TVariantPayload.Single{value: sema_checked_qualify_type_with_generics(graph, ty, module_identity, generic_params)}
        .Named(fields) -> {
            rows: loop field in fields -> sema_checked_variant_field(field, sema_checked_qualify_type_with_generics(graph, field.ty, module_identity, generic_params))
            TVariantPayload.Named{fields: rows}
        }
    }
}

sema_checked_variant_cell_guards: fn(variant: Variant, diagnostics: &[Diagnostic]) {
    guards: [String]{"CellReadGuard", "CellEditGuard"}
    if variant.payload == {
        .Unit -> {}
        .Single(ty, span) -> {
            if sema_checked_type_contains_name(ty, guards) -> diagnostics.push(sema_checked_cell_guard_storage("enum variant `{variant.name}`", span))
        }
        .Named(fields) -> {
            loop field in fields {
                if sema_checked_type_contains_name(field.ty, guards) -> diagnostics.push(sema_checked_cell_guard_storage("enum field `{field.name}`", field.name_span))
            }
        }
    }
}

sema_checked_variants: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, definition: EnumDef, generic_params: [TGenericParam], diagnostics: &[Diagnostic]) -> [TVariant] {
    variants := [TVariant]{}
    style: sema_checked_rename_case(definition.serde_markers)
    loop (index, variant) in definition.variants {
        duplicate: loop previous in 0..<index {
            if definition.variants[previous].name == variant.name -> break true
        } ?? false
        if duplicate -> diagnostics.push(sema_defined_twice(variant.name, "enum variants share one namespace", variant.name_span))
        wire_name: sema_checked_variant_wire_name(variant, style)
        loop existing in variants {
            if existing.wire_name == wire_name {
                diagnostics.push(sema_defined_twice(wire_name, "enum variants must have distinct checked wire names", variant.name_span))
                break
            }
        }
        sema_checked_variant_cell_guards(variant, diagnostics)
        if variant.payload == {
            .Single(ty, span) -> sema_checked_member_type_names(graph, module_row, ty, span, generic_params, diagnostics)
            .Named(fields) -> loop field in fields -> sema_checked_member_type_names(graph, module_row, field.ty, field.ty_span, generic_params, diagnostics)
            .Unit -> {}
        }
        variants.push(TVariant{name: variant.name, wire_name: wire_name, span: variant.name_span, payload: sema_checked_variant_payload(graph, variant.payload, module_row.module_identity, generic_params), discriminant: variant.discriminant})
    }
    variants
}

// The graph nodes `ty` names through the containers a recursive layout sees
// (option, list, map, result), resolved from `caller_module` like any field
// type. Only struct and enum nominals are nodes: no other type has fields.
sema_checked_box_targets: fn(graph: SemaRegistrationGraph, ty: Type, caller_module: String, nodes: [String:Int], targets: &[Int]) Never! {
    if ty == {
        .Named(name) | .Apply(name, _) -> {
            row: sema_type_resolve_nominal_row(graph, Type.Named{name: name}, caller_module) ?? return
            node: nodes.get(graph.modules[row.module_index].nominals[row.row].symbol.id.key) ?? return
            targets.push(node)
        }
        .Option(inner) | .List(inner) -> sema_checked_box_targets(graph, inner, caller_module, nodes, targets)
        .Map(key, _, value) -> {
            sema_checked_box_targets(graph, key, caller_module, nodes, targets)
            sema_checked_box_targets(graph, value, caller_module, nodes, targets)
        }
        .Result(ok, err) -> {
            sema_checked_box_targets(graph, ok, caller_module, nodes, targets)
            sema_checked_box_targets(graph, err, caller_module, nodes, targets)
        }
        .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
}

sema_checked_box_is_node: fn(nominal: SemaRegistrationNominal) -> Bool Never! {
    if nominal.source == .SourceAST(item) {
        if item == {
            .Struct(_) | .Enum(_) -> return true
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    false
}

// One edge per field, single payload (`Variant`) and named payload field
// (`Variant.field`) of `nominal`, appended to `box_graph`.
sema_checked_box_node_edges: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, nodes: [String:Int], box_graph: &SemaCheckedBoxGraph) Never! {
    caller: nominal.symbol.module_name
    if nominal.source == .SourceAST(item) {
        if item == {
            .Struct(definition) -> {
                loop field in definition.fields {
                    box_graph.names.push(field.name)
                    box_graph.target_starts.push(box_graph.targets.len())
                    sema_checked_box_targets(graph, field.ty, caller, nodes, box_graph.targets)
                }
            }
            .Enum(definition) -> {
                loop variant in definition.variants {
                    if variant.payload == {
                        .Single(ty, _) -> {
                            box_graph.names.push(variant.name)
                            box_graph.target_starts.push(box_graph.targets.len())
                            sema_checked_box_targets(graph, ty, caller, nodes, box_graph.targets)
                        }
                        .Named(fields) -> {
                            loop field in fields {
                                box_graph.names.push("{variant.name}.{field.name}")
                                box_graph.target_starts.push(box_graph.targets.len())
                                sema_checked_box_targets(graph, field.ty, caller, nodes, box_graph.targets)
                            }
                        }
                        .Unit -> {}
                    }
                }
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

// The recursive-layout edge graph over struct and enum nodes: node `n`
// (nominal SymbolId key `keys[n]`) owns edges `edge_starts[n]..<edge_starts[n + 1]`,
// and edge `e` (key `names[e]`) names nodes `targets[target_starts[e]..<target_starts[e + 1]]`.
// A node's successors are therefore one contiguous run of `targets`.
SemaCheckedBoxGraph: struct {
    keys: [String]
    edge_starts: [Int]
    names: [String]
    target_starts: [Int]
    targets: [Int]
}

// Iterative Tarjan: the strongly connected component of every node.
sema_checked_box_components: fn(box_graph: SemaCheckedBoxGraph) -> [Int] Never! {
    count: box_graph.keys.len()
    order := [Int]{}
    low := [Int]{}
    on_stack := [Bool]{}
    component := [Int]{}
    loop _ in 0..<count {
        order.push(-1)
        low.push(0)
        on_stack.push(false)
        component.push(-1)
    }
    stack := [Int]{}
    frame_nodes := [Int]{}
    frame_cursors := [Int]{}
    next_order := 0
    components := 0
    loop start in 0..<count {
        if order[start] >= 0 -> next
        order[start] = next_order
        low[start] = next_order
        next_order += 1
        stack.push(start)
        on_stack[start] = true
        frame_nodes.push(start)
        frame_cursors.push(box_graph.target_starts[box_graph.edge_starts[start]])
        loop frame_nodes.len() > 0 {
            top: frame_nodes.len() - 1
            node := frame_nodes[top]
            cursor := frame_cursors[top]
            if cursor < box_graph.target_starts[box_graph.edge_starts[node + 1]] {
                child: box_graph.targets[cursor]
                frame_cursors[top] = cursor + 1
                if order[child] < 0 {
                    order[child] = next_order
                    low[child] = next_order
                    next_order += 1
                    stack.push(child)
                    on_stack[child] = true
                    frame_nodes.push(child)
                    frame_cursors.push(box_graph.target_starts[box_graph.edge_starts[child]])
                } else if on_stack[child] && order[child] < low[node] {
                    low[node] = order[child]
                }
                next
            }
            _ := frame_nodes.pop()
            _ := frame_cursors.pop()
            if frame_nodes.len() > 0 {
                parent: frame_nodes[frame_nodes.len() - 1]
                if low[node] < low[parent] -> low[parent] = low[node]
            }
            if low[node] == order[node] {
                loop stack.len() > 0 {
                    member: stack.pop() ?? break
                    on_stack[member] = false
                    component[member] = components
                    if member == node -> break
                }
                components += 1
            }
        }
    }
    component
}

// `owner --key--> target` is boxed iff `target` reaches `owner`: the two share
// a component (a self-loop is its owner's own component). Each owner's keys
// are sorted like Rust `owner_boxed_edges`; owners with none are absent.
sema_checked_box_select: fn(box_graph: SemaCheckedBoxGraph, component: [Int]) -> [String:[String]] Never! {
    boxed := [String:[String]]{}
    loop node in 0..<box_graph.keys.len() {
        owner_edges := [String]{}
        loop edge in box_graph.edge_starts[node]..<box_graph.edge_starts[node + 1] {
            loop position in box_graph.target_starts[edge]..<box_graph.target_starts[edge + 1] {
                if component[box_graph.targets[position]] == component[node] {
                    if !owner_edges.contains(box_graph.names[edge]) -> owner_edges.push(box_graph.names[edge])
                    break
                }
            }
        }
        if owner_edges.len() == 0 -> next
        owner_edges.sort()
        boxed[box_graph.keys[node]] = owner_edges
    }
    boxed
}

// The recursive-layout edges that need a box, for every struct and enum of the
// graph, computed once: Rust `find_box_edges`. Every struct and enum is a root
// and only those have edges, so no multi-type cycle runs through a non-root and
// Rust's SCC answer is exact (its path-enumeration fallback never applies).
// Result: nominal SymbolId key -> the owner's boxed keys.
sema_checked_program_boxed_edges: fn(graph: SemaRegistrationGraph) -> [String:[String]] Never! {
    nodes := [String:Int]{}
    rows := [SemaRegistrationRowRef]{}
    box_graph := SemaCheckedBoxGraph{keys: [String]{}, edge_starts: [Int]{}, names: [String]{}, target_starts: [Int]{}, targets: [Int]{}}
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].nominals.len() {
            if !sema_checked_box_is_node(graph.modules[module_index].nominals[row]) -> next
            key: graph.modules[module_index].nominals[row].symbol.id.key
            // Names resolve to the first registered row of a key.
            first: graph.nominal_symbol_rows.get(key) ?? next
            if first.module_index != module_index || first.row != row || nodes.get(key) != None -> next
            nodes[key] = box_graph.keys.len()
            box_graph.keys.push(key.copy())
            rows.push(first)
        }
    }
    loop row in rows {
        box_graph.edge_starts.push(box_graph.names.len())
        sema_checked_box_node_edges(graph, graph.modules[row.module_index].nominals[row.row], nodes, box_graph)
    }
    box_graph.edge_starts.push(box_graph.names.len())
    box_graph.target_starts.push(box_graph.targets.len())
    sema_checked_box_select(box_graph, sema_checked_box_components(box_graph))
}

// The checked recursive-layout keys of `definition`, read from the graph's
// one edge set (`sema_checked_program_boxed_edges`).
sema_checked_boxed_edges: fn(graph: SemaRegistrationGraph, boxed_edges: [String:[String]], module_identity: String, definition: Item) -> [String] Never! {
    owner: sema_registration_root_name(definition)
    if owner == "" -> return [String]{}
    row: sema_type_resolve_nominal_row(graph, Type.Named{name: owner}, module_identity) ?? return [String]{}
    boxed_edges.get(graph.modules[row.module_index].nominals[row.row].symbol.id.key) ?? [String]{}
}

sema_checked_type_has_boxed_edge: fn(definition: TTypeDef, edge: String) -> Bool Never! {
    loop boxed_edge in definition.boxed_edges {
        if boxed_edge == edge -> return true
    }
    false
}

sema_checked_generic_params: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, params: [SemaRegistrationGenericParam], diagnostics: &[Diagnostic]) -> [TGenericParam] {
    result := [TGenericParam]{}
    loop parameter in params {
        bounds := [SymbolID]{}
        loop bound in parameter.bounds {
            // Rust never rejects an unregistered bound name at the declaration
            // (`T: Clone`); it carries no trait identity, so it is dropped.
            symbol: sema_type_graph_bound_symbol(graph, module_row.module_identity, bound) ?? next
            if sema_resolved_kind(graph, symbol) != SymbolKind.Trait {
                diagnostics.push(sema_error("E0301", parameter.span, "the generic bound `{bound}` is not a trait", "generic bounds refer to trait contracts", "use a trait name as the generic bound"))
                next
            }
            bounds.push(sema_resolved_id(graph, symbol))
        }
        result.push(TGenericParam{name: parameter.name, bounds: bounds, number: parameter.number})
    }
    result
}

// A type row names each method by its function's SymbolId key, the key its
// checked FnBody carries (the Rust reference lowering's `resolve_type_methods`
// resolves these through the checked function registry).
sema_checked_nominal_methods: fn(definition: Item, methods: [SemaRegistrationFunction]) -> [String] Never! {
    keys := [String]{}
    if definition == {
        .Struct(value) -> loop method in value.methods {
            loop registered in methods {
                if registered.declaration.name == method.name {
                    keys.push(registered.symbol.id.key)
                    break
                }
            }
        }
        .Enum(value) -> loop method in value.methods {
            loop registered in methods {
                if registered.declaration.name == method.name {
                    keys.push(registered.symbol.id.key)
                    break
                }
            }
        }
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    keys
}

sema_checked_item_span: fn(item: Item) -> Span Never! {
    if item == {
        .Struct(value) -> value.span
        .Enum(value) -> value.span
        .Distinct(value) -> value.span
        .TypeAlias(value) -> value.span
        .Trait(value) -> value.span
        .Tag(value) -> value.span
        .UnitFamily(value) -> value.span
        .Func(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> Span{start: 0, end: 0}
    }
}

// . Resolve nominal identity through the registration graph,
// not a leaf-name scan, and only traverse structs like Rust StrongSharedCycleGraph.
sema_checked_shared_reaches: fn(graph: SemaRegistrationGraph, owner: String, caller: String, ty: Type, memo: &[String:Bool], active: &[String:Bool]) -> (reaches: Bool, cut: Bool) Never! {
    if ty == {
        .Named(_) -> {
            row: sema_type_resolve_nominal_row(graph, ty, caller) ?? return (cut: false, reaches: false)
            key: graph.modules[row.module_index].nominals[row.row].symbol.id.key
            // Two single-level matches read the declaration in place; a nested
            // `.SourceAST(.Struct(definition))` pattern clones the whole Item.
            if graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
                if item == .Struct(definition) {
                    if key == owner -> return (cut: false, reaches: true)
                    if memo.get(key) == .Val(known) -> return (cut: false, reaches: known)
                    if active.get(key) == (Val(true)) -> return (cut: true, reaches: false)
                    active[key] = true
                    reaches := false
                    cut := false
                    module_identity: graph.modules[row.module_index].module_identity
                    loop field in definition.fields {
                        if field.computed != None -> next
                        result: sema_checked_shared_reaches(graph, owner, module_identity, field.ty, memo, active)
                        cut = cut || result.cut
                        if result.reaches {
                            reaches = true
                            break
                        }
                    }
                    active[key] = false
                    // A negative reached through an active cycle is provisional:
                    // a later sibling may reach the owner. Never memoize that cut.
                    if reaches || !cut -> memo[key] = reaches
                    return (cut: cut, reaches: reaches)
                }
            }
            (cut: false, reaches: false)
        }
        .Shared(inner) | .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .Case(_, inner) -> sema_checked_shared_reaches(graph, owner, caller, inner, memo, active)
        .Map(first, _, second) | .Result(first, second) -> {
            left: sema_checked_shared_reaches(graph, owner, caller, first, memo, active)
            if left.reaches -> return left
            right: sema_checked_shared_reaches(graph, owner, caller, second, memo, active)
            (cut: left.cut || right.cut, reaches: right.reaches)
        }
        .Tuple(fields) -> {
            cut := false
            loop field in fields {
                result: sema_checked_shared_reaches(graph, owner, caller, field.ty, memo, active)
                cut = cut || result.cut
                if result.reaches -> return (cut: cut, reaches: true)
            }
            (cut: cut, reaches: false)
        }
        .Union(members) | .Apply(_, members) -> {
            if ty == .Apply(name, _) && name == "Shared.Weak" -> return (cut: false, reaches: false)
            cut := false
            loop member in members {
                result: sema_checked_shared_reaches(graph, owner, caller, member, memo, active)
                cut = cut || result.cut
                if result.reaches -> return (cut: cut, reaches: true)
            }
            (cut: cut, reaches: false)
        }
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> (cut: false, reaches: false)
    }
}

// One owner's witness search: `stack` holds the struct keys on the current
// by-value path; `met_path` is set when the walk meets one of them. `clear`
// holds every struct key whose whole walk found no witness without meeting a
// key on its path: that walk explored every by-value path below the key, and
// any later walk from it explores a subset of them (a key on a later path cuts
// a path short and finds nothing), so it finds no witness either and the walk
// returns None at once instead of walking the same struct graph again.
SemaSharedWitnessWalk: struct {
    stack: [String]
    clear: [String:Bool]
    met_path: Bool
}

// Returns the first strong payload that closes a cycle. By-value struct
// paths can contain the Shared edge; weak handles never contribute one.
sema_checked_shared_witness: fn(graph: SemaRegistrationGraph, owner: String, caller: String, ty: Type, memo: &[String:Bool], walk: &SemaSharedWitnessWalk) -> String? Never! {
    if ty == {
        .Shared(inner) -> {
            active := [String:Bool]{}
            result: sema_checked_shared_reaches(graph, owner, caller, inner, memo, active)
            if result.reaches -> Val(type_name(inner)) else -> None
        }
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .Case(_, inner) -> sema_checked_shared_witness(graph, owner, caller, inner, memo, walk)
        .Map(first, _, second) | .Result(first, second) -> {
            first_witness: sema_checked_shared_witness(graph, owner, caller, first, memo, walk)
            if first_witness == {
                .Val(witness) -> Val(witness)
                .None -> sema_checked_shared_witness(graph, owner, caller, second, memo, walk)
            }
        }
        .Tuple(fields) -> {
            loop field in fields {
                witness: sema_checked_shared_witness(graph, owner, caller, field.ty, memo, walk)
                if witness != None -> return witness
            }
            None
        }
        .Union(members) | .Apply(_, members) -> {
            if ty == .Apply(name, _) && name == "Shared.Weak" -> return None
            loop member in members {
                witness: sema_checked_shared_witness(graph, owner, caller, member, memo, walk)
                if witness != None -> return witness
            }
            None
        }
        .Named(_) -> {
            row: sema_type_resolve_nominal_row(graph, ty, caller) ?? return None
            key: graph.modules[row.module_index].nominals[row.row].symbol.id.key
            if walk.clear.has_key(key) -> return None
            if walk.stack.contains(key) {
                walk.met_path = true
                return None
            }
            // Single-level matches borrow the declaration in place (see
            // sema_checked_shared_reaches); a nested pattern clones the Item.
            if graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
                if item == .Struct(definition) {
                    walk.stack.push(key.copy())
                    outer_met: walk.met_path
                    walk.met_path = false
                    witness := String?{None}
                    module_identity: graph.modules[row.module_index].module_identity
                    loop field in definition.fields {
                        if field.computed != None -> next
                        witness = sema_checked_shared_witness(graph, owner, module_identity, field.ty, memo, walk)
                        if witness != None -> break
                    }
                    _ := walk.stack.pop()
                    if witness == None && !walk.met_path -> walk.clear[key] = true
                    walk.met_path = walk.met_path || outer_met
                    return witness
                }
            }
            None
        }
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> None
    }
}

sema_checked_type_def: fn(graph: SemaRegistrationGraph, boxed: [String:[String]], module_row: SemaRegistrationModule, layout_engine: TargetLayoutEngine?, nominal: SemaRegistrationNominal, diagnostics: &[Diagnostic]) -> TTypeDef? {
    definition: sema_registration_nominal_source_item(nominal.source) ?? return None
    if nominal.kind == SemaRegistrationNominalKind.Trait -> return None
    name: nominal.symbol.name
    generic_params: sema_checked_generic_params(graph, module_row, nominal.generic_params, diagnostics)
    layout := TStructLayout?{None}
    c_layout_tag := TCEnumTag?{None}
    enum_layout := LayoutFacts?{None}
    serde := [TSerdeAttribute]{}
    cli_bindings := [TCLIBinding]{}
    boxed_edges := sema_checked_boxed_edges(graph, boxed, module_row.module_identity, definition)
    if nominal.compiler_owned -> boxed_edges = [String]{}
    derives := [String]{}
    // Rust reference lowering lower_struct/lower_enum: the declaration's
    // structural auto-derive selection (`TypeMetadata`) supplies the
    // auto-Printable fact and the automatic Debug derive.
    auto_derives: sema_type_metadata_auto_derives(definition, module_row.declared_trait_impls)
    auto_printable := false
    auto_derive_default := false
    published_schema := false
    single_use := false
    must_use := false
    ownership := TDeclarationOwnership.Owned
    kind := TTypeDefKind?{None}
    if definition == {
        .Struct(value) -> {
            derives = sema_checked_type_derive_names(value.derives, definition, auto_derives.debug)
            auto_printable = auto_derives.printable
            auto_derive_default = value.auto_derive_default
            published_schema = value.is_published_schema || sema_checked_has_name(derives, "PublishedSchema")
            single_use = value.is_single_use
            must_use = value.is_must_use
            layout = sema_checked_layout(value.layout)
            serde = sema_checked_serde_attributes(value.serde_markers)
            cli_bindings = sema_checked_cli_bindings(module_row, value)
            ownership = sema_checked_ownership(single_use)
            sema_checked_validate_field_policy(value, diagnostics)
            sema_checked_validate_patchable(value, diagnostics)
            sema_checked_validate_layout(value, diagnostics)
            sema_receipt_validate_declaration(value, diagnostics)
            fields: sema_checked_struct_fields(graph, module_row, value, generic_params, diagnostics)
            kind = Val(TTypeDefKind.Struct{fields: fields, methods: sema_checked_nominal_methods(definition, nominal.methods)})
        }
        .Enum(value) -> {
            derives = sema_checked_type_derive_names(value.derives, definition, auto_derives.debug)
            auto_printable = auto_derives.printable
            auto_derive_default = value.auto_derive_default
            single_use = value.is_single_use
            must_use = value.is_must_use
            serde = sema_checked_serde_attributes(value.serde_markers)
            ownership = sema_checked_ownership(single_use)
            c_layout_tag = sema_checked_foreign_enum_c_layout_tag(value)
            if c_layout_tag != None {
                layout = Val(TStructLayout.C)
                engine: layout_engine ?? return None
                enum_layout = Val(jet_target_layout_enum_facts_in_module(engine, value, module_row.module_identity))
            }
            variants: sema_checked_variants(graph, module_row, value, generic_params, diagnostics)
            kind = Val(TTypeDefKind.Enum{variants: variants, methods: sema_checked_nominal_methods(definition, nominal.methods)})
        }
        .Distinct(value) -> {
            derives = sema_checked_derive_names(value.derives)
            base: sema_checked_qualify_type_with_generics(graph, value.base, module_row.module_identity, generic_params)
            kind = Val(TTypeDefKind.Distinct{base: base, range: value.range.map(fn(item) { TIntegerRange{lo: item.lo, hi: item.hi} })})
        }
        .TypeAlias(value) -> kind = Val(TTypeDefKind.Alias{target: sema_checked_qualify_type_with_generics(graph, value.target, module_row.module_identity, generic_params)})
        .UnitFamily(value) -> {
            members: loop member in value.members -> member.name
            base := String?{None}
            if value.base == .Val(named) -> base = Val(named.name)
            kind = Val(TTypeDefKind.UnitFamily{members: members, base: base})
        }
        .Func(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> return None
    }
    type_kind: kind ?? return None
    TTypeDef{
        module_identity: module_row.module_identity,
        key: if sema_registration_is_compiler_owned_enum(nominal) -> name else -> sema_checked_module_key(module_row, name),
        name: name,
        span: sema_checked_item_span(definition),
        public: nominal.symbol.visibility >= 2,
        package_public: nominal.symbol.visibility >= 1,
        generic_params: generic_params,
        derives: derives,
        auto_derive_default: auto_derive_default,
        auto_printable: auto_printable,
        published_schema: published_schema,
        single_use: single_use,
        must_use: must_use,
        layout: layout,
        c_layout_tag: c_layout_tag,
        enum_layout: enum_layout,
        layout_alignment: None,
        serde: serde,
        cli_bindings: cli_bindings,
        ownership: ownership,
        compiler_builtin: sema_registration_compiler_builtin_marker(nominal),
        specified: if definition == .Enum(value) -> sema_enum_numbers_marker(value.type_markers, "Specified") != None else -> false,
        boxed_edges: boxed_edges,
        kind: type_kind,
    }
}

sema_checked_impl_key: fn(module_row: SemaRegistrationModule, type_name: String, trait_name: String?) -> String Never! {
    if trait_name == .Val(trait_name_value) -> "{module_row.module_identity}::{type_name}::{trait_name_value}" else -> "{module_row.module_identity}::{type_name}"
}

sema_checked_impl_method_key: fn(module_row: SemaRegistrationModule, definition: ImplDef, method: Func) -> String Never! {
    trait_name_value: definition.trait_name ?? return "{module_row.module_identity}::{definition.type_name}::{method.name}"
    if owned_trait_is_operator(trait_name_value) {
        rhs: definition.operator_rhs ?? Type.Named{name: definition.type_name}
        return "{module_row.module_identity}::{definition.type_name}::{trait_name_value}::{method.name}<{type_name(rhs)}>"
    }
    "{module_row.module_identity}::{definition.type_name}::{trait_name_value}::{method.name}"
}

sema_checked_nested_impl_key: fn(module_row: SemaRegistrationModule, type_name: String, block: TraitImplBlock) -> String Never! {
    "{module_row.module_identity}::{type_name}::{block.trait_name}"
}

sema_checked_target_os: fn(target: String?) -> TTargetOS? {
    target_os_parse(target ?? return None)
}

sema_checked_serde_codec: fn(trait_name: String?) -> TSerdeCodec? {
    name: trait_name ?? return None
    if name == {
        "Encode" -> Val(TSerdeCodec.Encode)
        "Decode" -> Val(TSerdeCodec.Decode)
        else -> None
    }
}

sema_checked_operator_marker: fn(marker: OperatorMarker?) -> TOperatorMarker? {
    value: marker ?? return None
    if value == {
        .Commutative -> Val(TOperatorMarker.Commutative)
    }
}

sema_checked_impl_row: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, registered: SemaRegistrationImpl, constants: [TTraitConstantValue]) -> TImplDef Never! {
    definition: registered.declaration
    methods: loop method in definition.methods -> sema_checked_impl_method_key(module_row, definition, method)
    associated: loop value in registered.associated_types -> TAssociatedTypeValue{name: value.symbol.name, ty: sema_checked_qualify_type(graph, value.ty, module_row.module_identity), span: value.symbol.span}
    TImplDef{
        module_identity: module_row.module_identity,
        key: sema_checked_impl_key(module_row, definition.type_name, definition.trait_name),
        span: definition.span,
        self_type: sema_checked_qualify_type(graph, registered.target_type, module_row.module_identity),
        trait_name: definition.trait_name,
        trait_ref: definition.trait_name,
        associated_types: associated,
        constants: constants,
        methods: methods,
        delegation_field: definition.delegation_field,
        compiler_generated: definition.is_generated_serde,
        serde: sema_checked_serde_codec(definition.trait_name),
        operator_rhs: sema_checked_qualify_optional_type(graph, definition.operator_rhs, module_row.module_identity),
        operator_marker: sema_checked_operator_marker(definition.operator_marker),
        target_os: sema_checked_target_os(definition.os_target),
    }
}

sema_checked_trait_nominal_row: fn(graph: SemaRegistrationGraph, module_identity: String, trait_name: String) -> SemaRegistrationRowRef? {
    resolved: sema_type_graph_lookup_symbol(graph, module_identity, trait_name) ?? return None
    if sema_resolved_kind(graph, resolved) != SymbolKind.Trait -> return None
    sema_type_graph_resolved_nominal_row(graph, resolved)
}

sema_checked_validate_impl: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, implementation: SemaRegistrationImpl, diagnostics: &[Diagnostic]) {
    trait_name: implementation.trait_name ?? return
    // A generated codec is its own type's codec: asking the bound would only
    // demand its body (sema_codec_demand_type) for no use.
    bound: if implementation.declaration.is_generated_serde -> Bool?{Val(true)} else -> sema_type_bound_satisfied(graph, implementation.target_type, trait_name, module_row.module_identity)
    if bound == {
        .Val(bound_value) -> {
            if !bound_value {
                diagnostics.push(sema_error("E0913", implementation.declaration.type_span, "the impl target does not satisfy its declared trait", "a checked implementation requires a matching nominal trait contract", "implement the required trait methods for this target"))
            }
        }
        .None -> {}
    }
    forwards: implementation.declaration.delegation_field != None || implementation.declaration.is_generated_serde
    sema_checked_validate_trait_contract(graph, module_row, implementation.target_type, trait_name, implementation.methods, implementation.associated_type_impls, forwards, implementation.declaration.type_span, diagnostics)
}

// The trait contract an `impl Trait` block in a struct or enum body meets,
// checked as sema_checked_validate_impl checks a top-level impl. The block's
// methods registered on the nominal; they are the rows at the block's
// method spans.
sema_checked_validate_nested_impl: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, nominal: SemaRegistrationNominal, block: TraitImplBlock, diagnostics: &[Diagnostic]) {
    methods := [SemaRegistrationFunction]{}
    loop method in block.methods {
        loop registered in nominal.methods {
            if registered.declaration.name_span == method.name_span && registered.declaration.name == method.name {
                methods.push(registered.copy())
                break
            }
        }
    }
    sema_checked_validate_trait_contract(graph, module_row, nominal.ty, block.trait_name, methods, block.assoc_type_impls, block.delegation_field != None || block.compiler_generated, block.trait_span, diagnostics)
}

sema_checked_validate_trait_contract: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, target_type: Type, trait_name: String, methods: [SemaRegistrationFunction], associated_type_impls: [NamedType], forwards: Bool, span: Span, diagnostics: &[Diagnostic]) {
    trait_ref: sema_checked_trait_nominal_row(graph, module_row.module_identity, trait_name) ?? return
    // Rust `validate_trait_impl` (E0906): every trait method without a default
    // body appears in the impl. A `using` delegation forwards them instead, and
    // a generated codec writes its own.
    if !forwards {
        missing := [String]{}
        loop required_index in 0..<graph.modules[trait_ref.module_index].nominals[trait_ref.row].trait_methods.len() {
            if graph.modules[trait_ref.module_index].nominals[trait_ref.row].trait_methods[required_index].declaration.default_body != None -> next
            required_name: graph.modules[trait_ref.module_index].nominals[trait_ref.row].trait_methods[required_index].declaration.name
            provided := false
            loop actual in methods {
                if actual.declaration.name == required_name {
                    provided = true
                    break
                }
            }
            if !provided -> missing.push("`{required_name}`")
        }
        if missing.len() > 0 {
            listed: missing.join(", ")
            diagnostics.push(sema_error("E0906", span, "`impl …: {trait_name}` is missing {listed}", "every `{trait_name}` method must appear in the impl block", "add the missing method signatures and bodies"))
        }
        // E0913: an associated type the trait declares and the impl leaves
        // unset. The method contract names that type, so it is not compared.
        unset := [String]{}
        trait_item: sema_registration_nominal_source_item(graph.modules[trait_ref.module_index].nominals[trait_ref.row].source)
        if trait_item == .Val(item) {
            if item == .Trait(definition) {
                loop declared in definition.assoc_types {
                    bound := false
                    loop written in associated_type_impls {
                        if written.name == declared.name {
                            bound = true
                            break
                        }
                    }
                    if !bound -> unset.push(declared.name)
                }
            }
        }
        if unset.len() > 0 {
            diagnostics.push(sema_owned_unbound(trait_name, unset, span))
            return
        }
    }
    // The trait writes its associated types abstractly (`-> Elem`) and its
    // implementer as `Self`; the impl writes the concrete types it binds
    // (`type Elem = Int`, `-> Int`) and its own type.
    associated_names := loop associated in associated_type_impls -> associated.name
    associated_types := loop associated in associated_type_impls -> associated.ty.copy()
    associated_names.push("Self")
    associated_types.push(target_type.copy())
    loop expected_index in 0..<graph.modules[trait_ref.module_index].nominals[trait_ref.row].trait_methods.len() {
        found := SemaRegistrationFunction?{None}
        loop actual in methods {
            if actual.declaration.name == graph.modules[trait_ref.module_index].nominals[trait_ref.row].trait_methods[expected_index].declaration.name {
                found = Val(actual)
                break
            }
        }
        actual: found ?? next
        declared_signature: graph.modules[trait_ref.module_index].nominals[trait_ref.row].trait_methods[expected_index].signature
        expected_signature: sema_inference_substitute_type(declared_signature, associated_names, associated_types)
        compatible: sema_type_assignable_in_graph(graph, expected_signature, sema_checked_impl_signature(expected_signature, actual.signature), module_row.module_identity)
        signature_differs: if compatible == {
            .Val(value) -> !value
            .None -> graph.complete
        }
        // The compared signature leaves the receiver out, so it is compared
        // here. A compiler-owned trait's contract row states its receiver, and
        // that check (sema_owned_method_matches) owns it.
        receiver_differs: owned_trait(trait_name) == None && !sema_checked_receiver_matches(graph.modules[trait_ref.module_index].nominals[trait_ref.row].trait_methods[expected_index].declaration.params, actual.declaration.params)
        if signature_differs || receiver_differs {
            expected_declaration: graph.modules[trait_ref.module_index].nominals[trait_ref.row].trait_methods[expected_index].declaration
            written: sema_checked_trait_method_expected(expected_declaration, associated_names, associated_types)
            diagnostics.push(sema_error("E0907", actual.declaration.name_span, "`{actual.declaration.name}` doesn't match the `{trait_name}` contract", "a trait implementation must use the trait method's receiver, parameters, return type, and effects", "write `{written}`, matching the `{trait_name}` declaration exactly, including `self`, types, labels, return type, and effects"))
        }
    }
    loop associated in associated_type_impls {
        resolved: sema_type_associated(graph, target_type, trait_name, associated.name, module_row.module_identity)
        if resolved == None && graph.complete {
            diagnostics.push(sema_error("E0913", associated.span, "associated type `{associated.name}` is not resolved for this impl", "associated types are checked against one trait implementation", "declare the associated type in the trait and provide one concrete value"))
        }
    }
}

// (Rust `trait_method_expected_signature`) The callable a trait declares, as
// this impl must write it: `Self` and the associated types are the impl's
// concrete types. An effect row rides the arrow (`-[IO]> T`, pure `-[]> T`);
// otherwise a success value is spelled `-> T`, and a Unit or unit-fallible
// result keeps the arrowless form.
sema_checked_trait_method_expected: fn(declaration: TraitMethodSig, names: [String], types: [Type]) -> String {
    params := [String]{}
    loop param in declaration.params {
        sigil: access_sigil(param.convention)
        if param.name == "self" {
            params.push("{sigil}self")
        } else {
            params.push("{param.name}: {sigil}{type_name(sema_inference_substitute_type(param.ty, names, types))}")
        }
    }
    rendered := "{declaration.name}: fn({params.join(", ")})"
    success_value := false
    if declaration.return_type == .Val(returned) {
        success_value = true
        if returned == .Result(ok, _) {
            if ok == (Type.Named{name: "Unit"}) -> success_value = false
        } else if returned == (Type.Named{name: "Unit"}) {
            success_value = false
        }
    }
    if declaration.declared_effects == .Val(effects) {
        effect_names := [String]{}
        loop entry in effects -> effect_names.push(entry.name)
        rendered = "{rendered} -[{effect_names.join(", ")}]>"
    } else if declaration.is_pure {
        rendered = "{rendered} -[]>"
    } else if success_value {
        rendered = "{rendered} ->"
    }
    if declaration.return_type == .Val(returned) -> rendered = "{rendered} {type_name(sema_inference_substitute_type(returned, names, types))}"
    rendered
}

// An impl method that writes no effect row keeps its inferred row, which the
// trait bound checks (E0742); only its parameters and return must match here.
sema_checked_impl_signature: fn(expected: Type, actual: Type) -> Type Never! {
    if actual == .Fn(params, ret, effect_bound, param_contract, call_metadata, return_view_provenance) {
        if effect_bound == None && expected == .Fn(_, _, wanted, _, _, _) -> return Type.Fn{params: params, ret: ret, effect_bound: wanted, param_contract: param_contract, call_metadata: call_metadata, return_view_provenance: return_view_provenance}
    }
    actual.copy()
}

// Whether the impl method takes `self` as the trait method declares it: both
// without a receiver, or both with the same `self`, `&self` or `&&self`.
sema_checked_receiver_matches: fn(declared: [Param], written: [Param]) -> Bool Never! {
    declared_self: declared.len() > 0 && declared[0].name == "self"
    written_self: written.len() > 0 && written[0].name == "self"
    if declared_self != written_self -> return false
    !declared_self || declared[0].convention == written[0].convention
}

// Rust `TraitRegistry` coherence (orphan rule). Top-level
// impls register in source order, then the derive requests, then the trait
// blocks of struct and enum declarations, so a duplicate reports at the later
// block. An operator impl's identity includes its right-hand type.
SemaCheckedOperatorImpl: struct {
    left: String
    trait_name: String
    rhs: Type
}

SemaCheckedCoherence: struct {
    // Registered `{owner}::{trait}` pairs (Rust `trait_impls`).
    trait_keys: [String:Bool]
    // `{left}::{trait}` -> the right-hand types of its valid operator impls.
    operator_slots: [String:Int]
    operator_rhs: [[Type]]
    // The module's declarations, indexed once per check (Rust `local_types`,
    // `local_tags`, `local_traits`): local type names, the applied owner type
    // of the first struct, enum or alias of each name, tag and trait names.
    local_types: [String:Bool]
    owner_types: [String:Type]
    tags: [String:Bool]
    traits: [String:Bool]
    // `{owner}::{trait}` -> the associated types that impl binds, read by an
    // owned trait whose contract shares them (IndexMut reads Index's).
    associated: [String:[NamedType]]
    // A `distinct` type's base, by name.
    distinct_bases: [String:Type]
}

// Rust `TraitRegistry` local sets: one pass over the module's items and
// nominals.
sema_checked_coherence_state: fn(module_row: SemaRegistrationModule) -> SemaCheckedCoherence Never! {
    state := SemaCheckedCoherence{trait_keys: [String:Bool]{}, operator_slots: [String:Int]{}, operator_rhs: [[Type]]{}, local_types: [String:Bool]{}, owner_types: [String:Type]{}, tags: [String:Bool]{}, traits: [String:Bool]{}, associated: [String:[NamedType]]{}, distinct_bases: [String:Type]{}}
    loop item_index in 0..<module_row.program.items.len() {
        if module_row.program.items[item_index] == {
            .Struct(value) -> {
                state.local_types[value.name] = true
                if state.owner_types.get(value.name) == None -> state.owner_types[value.name] = sema_checked_coherence_applied(value.name, value.type_params)
                sema_checked_coherence_note_associated(state, value.name, value.trait_impls)
            }
            .Enum(value) -> {
                state.local_types[value.name] = true
                if state.owner_types.get(value.name) == None -> state.owner_types[value.name] = sema_checked_coherence_applied(value.name, value.type_params)
                sema_checked_coherence_note_associated(state, value.name, value.trait_impls)
            }
            .TypeAlias(value) -> {
                state.local_types[value.name] = true
                if state.owner_types.get(value.name) == None -> state.owner_types[value.name] = sema_checked_coherence_applied(value.name, value.type_params)
            }
            .Distinct(value) -> {
                state.local_types[value.name] = true
                state.distinct_bases[value.name] = value.base.copy()
            }
            .UnitFamily(value) -> loop member in value.members {
                state.local_types[member.name] = true
            }
            .Func(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    loop nominal_index in 0..<module_row.nominals.len() {
        if module_row.nominals[nominal_index].kind == SemaRegistrationNominalKind.Tag -> state.tags[module_row.nominals[nominal_index].symbol.name] = true
        if module_row.nominals[nominal_index].kind == SemaRegistrationNominalKind.Trait -> state.traits[module_row.nominals[nominal_index].symbol.name] = true
    }
    loop implementation in module_row.impls {
        trait_name: implementation.declaration.trait_name ?? next
        if implementation.declaration.assoc_type_impls.len() > 0 -> state.associated["{implementation.declaration.type_name}::{trait_name}"] = implementation.declaration.assoc_type_impls.copy()
    }
    state
}

sema_checked_coherence_note_associated: fn(state: &SemaCheckedCoherence, owner_name: String, blocks: [TraitImplBlock]) Never! {
    loop block in blocks {
        if block.assoc_type_impls.len() > 0 -> state.associated["{owner_name}::{block.trait_name}"] = block.assoc_type_impls.copy()
    }
}

// A type declared by this module (Rust `local_types`).
sema_checked_coherence_local_type: fn(state: SemaCheckedCoherence, type_name: String) -> Bool Never! {
    state.local_types.get(type_name) != None
}

sema_checked_coherence_applied: fn(name: String, params: [TypeParam]) -> Type Never! {
    if params.len() == 0 -> return Type.Named{name: name}
    args: loop param in params -> Type.Named{name: param.name}
    Type.Apply{name: name, args: args}
}

// Rust `impl_owner_type`: a generic owner is applied to its own parameters.
sema_checked_coherence_owner_type: fn(state: SemaCheckedCoherence, owner_name: String) -> Type Never! {
    state.owner_types.get(owner_name) ?? Type.Named{name: owner_name}
}

// Rust `local_traits`: a compiler-owned trait the table marks local, a trait
// this module declares, or one imported from the same package (the package
// is the orphan unit).
sema_checked_coherence_local_trait: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, state: SemaCheckedCoherence, trait_name: String) -> Bool Never! {
    if trait_name.contains(".") -> return false
    if owned_trait(trait_name) == .Val(owned) -> return owned.local
    if state.traits.get(trait_name) != None -> return true
    trait_ref: sema_checked_trait_nominal_row(graph, module_row.module_identity, trait_name) ?? return false
    trait_module: graph.modules[trait_ref.module_index].nominals[trait_ref.row].symbol.module_name
    trait_module_index: sema_registration_module_index(graph, trait_module) ?? return false
    graph.modules[trait_module_index].package_identity == module_row.package_identity
}

sema_checked_coherence_rhs_local: fn(state: SemaCheckedCoherence, rhs: Type) -> Bool Never! {
    if rhs == {
        .Named(name) | .Apply(name, _) -> sema_checked_coherence_local_type(state, name)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// Rust `validate_operator_marker` (E0907): `#Commutative` only on a typed Add
// or Mul hook.
sema_checked_coherence_operator_marker: fn(marker: OperatorMarker?, trait_name: String?, operator_rhs: Type?, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if marker == None -> return true
    name: trait_name ?? "the impl"
    if owned_trait_commutative(name) && trait_name != None && operator_rhs != None -> return true
    diagnostics.push(sema_error("E0907", span, "`#Commutative` is not valid on `{name}`", "`#Commutative` derives a reverse lookup only for a typed Add or Mul hook", "use `impl Type.Add(Other) #Commutative` or `impl Type.Mul(Other) #Commutative`"))
    false
}

// Rust `validate_trait_impl` up to the orphan rule (E0731, E0908, E0902),
// then the owned-trait contract. A compiler-generated impl writes its own
// methods, so only its operator identity is checked.
sema_checked_coherence_register: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, owner_name: String, trait_name: String, operator_rhs: Type?, operator_marker: OperatorMarker?, methods: [Func], associated: [NamedType], generated: Bool, local_type: Bool, span: Span, state: &SemaCheckedCoherence, diagnostics: &[Diagnostic]) {
    if !sema_checked_coherence_operator_marker(operator_marker, Val(trait_name), operator_rhs, span, diagnostics) -> return
    if state.tags.get(trait_name) != None {
        diagnostics.push(sema_error("E0731", span, "`{trait_name}` is a tag, but an `impl` block needs a trait", "a `tag` is a marker that erases at runtime and carries no methods; dispatch and method attachment need a `trait`", "declare `{trait_name}` as a `trait` with the method(s) it should provide"))
        return
    }
    if !sema_checked_coherence_trait_known(graph, module_row, state, owner_name, trait_name, span, diagnostics) -> return
    operator_trait: owned_trait_is_operator(trait_name)
    owner_type: sema_checked_coherence_owner_type(state, owner_name)
    rhs: operator_rhs ?? owner_type
    rhs_name: type_name(rhs)
    key: "{owner_name}::{trait_name}"
    if operator_trait {
        if state.operator_slots.get(key) == .Val(operator_slot) {
            loop existing in state.operator_rhs[operator_slot] {
                if type_identity_equal(existing, rhs) {
                    diagnostics.push(sema_error("E0908", span, "`{owner_name}` already implements `{trait_name}` for `{rhs_name}`", "operator implementation identity includes both the left and right operand types", "remove the duplicate hook or choose a different right-hand type than `{rhs_name}`"))
                    return
                }
            }
        }
        state.trait_keys[key] = true
    } else {
        if state.trait_keys.get(key) != None {
            diagnostics.push(sema_error("E0908", span, "`{owner_name}` already implements `{trait_name}`", "each type may implement a trait only once", "remove the duplicate `impl` block"))
            return
        }
        state.trait_keys[key] = true
    }
    if sema_checked_coherence_orphan(graph, module_row, state, owner_name, trait_name, operator_rhs, local_type) {
        diagnostics.push(sema_error("E0902", span, "this `impl` can't live here", "at least one of the trait or the type must be defined in this program (orphan rule)", "define the trait or type in this file, or move the impl"))
        return
    }
    owned: owned_trait(trait_name) ?? return
    if generated && !operator_trait -> return
    sibling := [NamedType]{}
    if owned.contract == .Methods(_, _, shares) {
        if shares == .Val(other) -> sibling = state.associated.get("{owner_name}::{other}") ?? [NamedType]{}
    }
    valid: sema_owned_check_impl(owned, owner_type, rhs, methods, associated, sibling, state.distinct_bases.get(owner_name), span, diagnostics)
    if operator_trait && valid -> sema_checked_coherence_add_operator(state, owner_name, trait_name, rhs)
}

// Rust `validate_trait_impl` orphan rule (E0902): neither the trait nor the
// type is this program's; an operator hook also needs its left type local,
// or, for arithmetic, a local right-hand type.
sema_checked_coherence_orphan: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, state: SemaCheckedCoherence, owner_name: String, trait_name: String, operator_rhs: Type?, local_type: Bool) -> Bool {
    operator_trait: owned_trait_is_operator(trait_name)
    rhs_local: operator_rhs != None && sema_checked_coherence_rhs_local(state, operator_rhs ?? sema_checked_coherence_owner_type(state, owner_name))
    (operator_trait && !local_type && !(owned_trait_arithmetic(trait_name) && rhs_local)) || (!local_type && !sema_checked_coherence_local_trait(graph, module_row, state, trait_name))
}

// A top-level impl the orphan rule refuses (E0902) is not this program's
// to check: its body produces no follow-on diagnostics.
sema_checked_impl_refused: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, state: SemaCheckedCoherence, implementation: SemaRegistrationImpl) -> Bool {
    trait_name: implementation.declaration.trait_name ?? return false
    if implementation.declaration.delegation_field != None && !owned_trait_literal(trait_name) -> return false
    local_type: sema_checked_coherence_local_type(state, implementation.declaration.type_name) || implementation.target_module_identity != None
    if local_type -> return false
    sema_checked_coherence_orphan(graph, module_row, state, implementation.declaration.type_name, trait_name, implementation.declaration.operator_rhs, local_type)
}

// E0923: the trait an `impl Type.Trait` block names is compiler-owned, declared
// in this module, a core trait every module sees bare (`Diagnostic`), or
// resolves to a trait through the module's scope.
sema_checked_coherence_trait_known: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, state: SemaCheckedCoherence, owner_name: String, trait_name: String, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if owned_trait(trait_name) != None || state.traits.get(trait_name) != None -> return true
    if core_bare_source_module(trait_name) == .Val(owner_module) && sema_checked_coherence_core_trait(graph, owner_module, trait_name) -> return true
    resolved: sema_type_graph_lookup_symbol(graph, module_row.module_identity, trait_name) ?? {
        diagnostics.push(sema_error("E0923", span, "`impl {owner_name}.{trait_name}` names no trait", "an `impl Type.Trait` block implements a trait the program declares or imports, or one the compiler owns; no trait named `{trait_name}` is in scope here", "declare or import `{trait_name}: trait`, correct the trait name, or write `impl {owner_name} {{` for methods of `{owner_name}` alone"))
        return false
    }
    kind: sema_resolved_kind(graph, resolved)
    if kind == SymbolKind.Trait -> return true
    diagnostics.push(sema_error("E0923", span, "`impl {owner_name}.{trait_name}` names no trait", "`{trait_name}` is a {symbol_kind_name(kind)}, and an `impl Type.Trait` block implements a trait", "name a trait after `{owner_name}.`, or write `impl {owner_name} {{` for methods of `{owner_name}` alone"))
    false
}

// A bare core name is a trait when its core module declares it as one. A
// program that never loads that module cannot tell, so the name stands.
sema_checked_coherence_core_trait: fn(graph: SemaRegistrationGraph, owner_module: String, trait_name: String) -> Bool {
    loaded := false
    loop index in 0..<graph.modules.len() {
        if graph.modules[index].module_name != owner_module -> next
        loaded = true
        if sema_registration_lookup_name_at(graph, index, graph.modules[index].module_identity, trait_name) == .Val(found) {
            if sema_resolved_kind(graph, found) == SymbolKind.Trait -> return true
        }
    }
    !loaded
}

// Operator identity is the left owner, the trait and the right-hand type.
sema_checked_coherence_add_operator: fn(state: &SemaCheckedCoherence, left: String, trait_name: String, rhs: Type) Never! {
    operator_key: "{left}::{trait_name}"
    if state.operator_slots.get(operator_key) == .Val(slot) {
        state.operator_rhs[slot].push(rhs.copy())
    } else {
        state.operator_slots[operator_key] = state.operator_rhs.len()
        state.operator_rhs.push([Type]{rhs})
    }
}

// Rust `register_impl`: a `using` delegation registers its pair without the
// coherence checks (sema owns its E2401 field check); a literal capability is
// still validated in full.
sema_checked_coherence_impl: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, implementation: SemaRegistrationImpl, state: &SemaCheckedCoherence, diagnostics: &[Diagnostic]) {
    definition: implementation.declaration
    if !sema_checked_coherence_operator_marker(definition.operator_marker, definition.trait_name, definition.operator_rhs, definition.type_span, diagnostics) -> return
    trait_name: definition.trait_name ?? return
    literal_capability: owned_trait_literal(trait_name)
    if definition.delegation_field != None && !literal_capability {
        key: "{definition.type_name}::{trait_name}"
        state.trait_keys[key] = true
        if owned_trait_arithmetic(trait_name) {
            rhs: definition.operator_rhs ?? sema_checked_coherence_owner_type(state, definition.type_name)
            sema_checked_coherence_add_operator(state, definition.type_name, trait_name, rhs)
        }
        return
    }
    local_type: sema_checked_coherence_local_type(state, definition.type_name) || implementation.target_module_identity != None
    sema_checked_coherence_register(graph, module_row, definition.type_name, trait_name, definition.operator_rhs, None, definition.methods, definition.assoc_type_impls, definition.is_generated_serde, local_type, definition.type_span, state, diagnostics)
}

sema_checked_coherence_derives: fn(state: SemaCheckedCoherence, derives: [NamedSpan], diagnostics: &[Diagnostic]) {
    loop request in derives {
        if state.tags.get(request.name) != None -> diagnostics.push(sema_error("E0731", request.span, "`{request.name}` is a tag, but `derive` needs a trait", "a `tag` is a marker that erases at runtime and carries no methods; dispatch and method attachment need a `trait`", "declare `{request.name}` as a `trait` with the method(s) it should provide"))
    }
}

sema_checked_coherence_blocks: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, owner_name: String, blocks: [TraitImplBlock], state: &SemaCheckedCoherence, diagnostics: &[Diagnostic]) {
    loop block in blocks {
        if block.delegation_field != None {
            state.trait_keys["{owner_name}::{block.trait_name}"] = true
            if owned_trait_arithmetic(block.trait_name) {
                rhs: block.operator_rhs ?? sema_checked_coherence_owner_type(state, owner_name)
                sema_checked_coherence_add_operator(state, owner_name, block.trait_name, rhs)
            }
            next
        }
        sema_checked_coherence_register(graph, module_row, owner_name, block.trait_name, block.operator_rhs, block.operator_marker, block.methods, block.assoc_type_impls, block.compiler_generated, true, block.trait_span, state, diagnostics)
    }
}

// Rust S62 E2401: a `using` delegation names a field of the struct, and that
// field's type implements the delegated trait.
sema_checked_validate_delegation: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, implementation: SemaRegistrationImpl, diagnostics: &[Diagnostic]) {
    definition: implementation.declaration
    trait_name: definition.trait_name ?? return
    field_name: definition.delegation_field ?? return
    owner_module: implementation.target_module_identity ?? return
    owner_index: sema_registration_module_index(graph, owner_module) ?? return
    sema_checked_validate_delegation_field(graph, module_row, owner_index, definition.type_name, trait_name, field_name, definition.type_span, diagnostics)
}

// The same E2401 check for an `impl Trait using field` block in a struct body.
sema_checked_validate_block_delegations: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, owner_name: String, blocks: [TraitImplBlock], diagnostics: &[Diagnostic]) {
    owner_index: sema_registration_module_index(graph, module_row.module_identity) ?? return
    loop block in blocks {
        field_name: block.delegation_field ?? next
        sema_checked_validate_delegation_field(graph, module_row, owner_index, owner_name, block.trait_name, field_name, block.trait_span, diagnostics)
    }
}

sema_checked_validate_delegation_field: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, owner_index: Int, type_name_text: String, trait_name: String, field_name: String, span: Span, diagnostics: &[Diagnostic]) {
    loop nominal_index in 0..<graph.modules[owner_index].nominals.len() {
        // Read in place: binding the row copied every nominal of the module.
        if graph.modules[owner_index].nominals[nominal_index].kind != SemaRegistrationNominalKind.Struct || graph.modules[owner_index].nominals[nominal_index].symbol.name != type_name_text -> next
        loop field_index in 0..<graph.modules[owner_index].nominals[nominal_index].fields.len() {
            if graph.modules[owner_index].nominals[nominal_index].fields[field_index].symbol.name != field_name -> next
            field_type_name: type_name(graph.modules[owner_index].nominals[nominal_index].fields[field_index].ty)
            satisfied: sema_type_bound_satisfied(graph, graph.modules[owner_index].nominals[nominal_index].fields[field_index].ty, trait_name, module_row.module_identity) ?? true
            if !satisfied {
                diagnostics.push(sema_error("E2401", span, "`{field_type_name}` doesn't implement `{trait_name}`, so it can't delegate", "`impl {type_name_text}.{trait_name} using {field_name}` forwards `{trait_name}` methods to the `{field_name}` field, but `{field_type_name}` doesn't implement `{trait_name}`", "implement `impl {field_type_name}.{trait_name}` on the field's type, or choose a different field"))
            }
            return
        }
        diagnostics.push(sema_error("E2401", span, "`{type_name_text}` has no field `{field_name}`", "`impl {type_name_text}.{trait_name} using {field_name}` needs `{type_name_text}` to have a field named `{field_name}`", "add `{field_name}: Type` to `{type_name_text}: struct`"))
        return
    }
}

// Fields and methods have separate namespaces.
// Only operator hooks may repeat a method name (pair coherence checks the RHS).
// A generated codec's reserved `__` helper (a decode's `__read`) repeats only
// with its codec's own method, which reports the repeat, so it is not named.
sema_checked_member_names: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, diagnostics: &[Diagnostic]) {
    names := [String:Bool]{}
    loop nominal_index in 0..<module_row.nominals.len() {
        owner: module_row.nominals[nominal_index].symbol.id.key
        loop method in module_row.nominals[nominal_index].methods {
            key: "{owner}::{method.symbol.name}"
            hook: method.symbol.owner != Val(owner)
            previous: names.get(key)
            if previous != None && !(hook && previous == (Val(true))) && !sema_checked_generated_helper(method) {
                diagnostics.push(sema_method_defined_twice(method.symbol.name, module_row.nominals[nominal_index].symbol.name, method.symbol.span))
            }
            if previous == None -> names.add(key, hook).drop("new member name")
        }
    }
    loop implementation_index in 0..<module_row.impls.len() {
        // Rust register_impl_methods inserts each impl method into its type's
        // method table once. An impl attached to a registered nominal row
        // already contributed its methods to `nominal.methods`, which the
        // owner module's walk above names; walking it again would see the
        // same declaration twice. Only unattached impls are named here.
        if module_row.impls[implementation_index].target_module_identity == .Val(target_module) {
            if sema_registration_module_index(graph, target_module) == .Val(target_index) {
                if sema_registration_impl_nominal_index(graph.modules[target_index], module_row.impls[implementation_index].target_type_name) >= 0 -> next
            }
        }
        row: sema_type_resolve_nominal_row(graph, module_row.impls[implementation_index].target_type, module_row.module_identity)
        owner: if row == .Val(value) -> graph.modules[value.module_index].nominals[value.row].symbol.id.key else -> type_name(module_row.impls[implementation_index].target_type)
        owner_name: if row == .Val(value) -> graph.modules[value.module_index].nominals[value.row].symbol.name else -> type_name(module_row.impls[implementation_index].target_type)
        hook: owned_trait_is_operator(module_row.impls[implementation_index].trait_name ?? "")
        loop method in module_row.impls[implementation_index].methods {
            key: "{owner}::{method.symbol.name}"
            previous: names.get(key)
            if previous != None && !(hook && previous == (Val(true))) && !sema_checked_generated_helper(method) {
                diagnostics.push(sema_method_defined_twice(method.symbol.name, owner_name, method.symbol.span))
            }
            if previous == None -> names.add(key, hook).drop("new member name")
        }
    }
}

sema_checked_generated_helper: fn(method: SemaRegistrationFunction) -> Bool Never! {
    method.declaration.compiler_generated && method.symbol.name.starts_with("__")
}

sema_checked_impl_coherence: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, diagnostics: &[Diagnostic]) {
    sema_checked_member_names(graph, module_row, diagnostics)
    state := sema_checked_coherence_state(module_row)
    // Written impls claim their traits first: the top-level ones, then the
    // inline trait blocks; a generated codec repeating one reports the repeat.
    loop implementation_index in 0..<module_row.impls.len() {
        if !module_row.impls[implementation_index].declaration.is_generated_serde -> sema_checked_coherence_impl(graph, module_row, module_row.impls[implementation_index], state, diagnostics)
    }
    // The struct and enum sources are read in place (derives first, then
    // the inline trait blocks), never copied out of their nominal rows.
    loop nominal_index in 0..<module_row.nominals.len() {
        if module_row.nominals[nominal_index].source == .SourceAST(item) {
            if item == {
                .Struct(value) -> sema_checked_coherence_derives(state, value.derives, diagnostics)
                .Enum(value) -> sema_checked_coherence_derives(state, value.derives, diagnostics)
                .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
            }
        }
    }
    loop nominal_index in 0..<module_row.nominals.len() {
        if module_row.nominals[nominal_index].source == .SourceAST(item) {
            if item == {
                .Struct(value) -> sema_checked_coherence_blocks(graph, module_row, value.name, value.trait_impls, state, diagnostics)
                .Enum(value) -> sema_checked_coherence_blocks(graph, module_row, value.name, value.trait_impls, state, diagnostics)
                .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
            }
        }
    }
    loop implementation_index in 0..<module_row.impls.len() {
        if module_row.impls[implementation_index].declaration.is_generated_serde -> sema_checked_coherence_impl(graph, module_row, module_row.impls[implementation_index], state, diagnostics)
    }
    loop implementation_index in 0..<module_row.impls.len() -> sema_checked_validate_delegation(graph, module_row, module_row.impls[implementation_index], diagnostics)
    loop nominal_index in 0..<module_row.nominals.len() {
        if module_row.nominals[nominal_index].source == .SourceAST(item) {
            if item == .Struct(value) -> sema_checked_validate_block_delegations(graph, module_row, value.name, value.trait_impls, diagnostics)
        }
    }
}

sema_checked_nested_impl_row: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, owner_name: String, block: TraitImplBlock, constants: [TTraitConstantValue]) -> TImplDef Never! {
    methods := [String]{}
    loop method in block.methods {
        if {
            owned_trait_is_operator(block.trait_name) -> {
                rhs: block.operator_rhs ?? Type.Named{name: owner_name}
                methods.push("{module_row.module_identity}::{owner_name}::{block.trait_name}::{method.name}<{type_name(rhs)}>")
            }
            else -> {
                methods.push("{module_row.module_identity}::{owner_name}::{block.trait_name}::{method.name}")
            }
        }
    }
    associated: loop value in block.assoc_type_impls -> TAssociatedTypeValue{name: value.name, ty: sema_checked_qualify_type(graph, value.ty, module_row.module_identity), span: value.span}
    TImplDef{
        module_identity: module_row.module_identity,
        key: sema_checked_nested_impl_key(module_row, owner_name, block),
        span: block.trait_span,
        self_type: Type.Named{name: sema_checked_module_key(module_row, owner_name)},
        trait_name: Val(block.trait_name),
        trait_ref: Val(block.trait_name),
        associated_types: associated,
        constants: constants,
        methods: methods,
        delegation_field: block.delegation_field,
        compiler_generated: block.compiler_generated,
        serde: sema_checked_serde_codec(Val(block.trait_name)),
        operator_rhs: sema_checked_qualify_optional_type(graph, block.operator_rhs, module_row.module_identity),
        operator_marker: sema_checked_operator_marker(block.operator_marker),
        target_os: sema_checked_target_os(block.os_target),
    }
}

sema_checked_const_char: fn(text: String) -> Int? Never! {
    bytes: text.bytes()
    if bytes.len() == 0 -> return None
    first: Int.from_u8(bytes[0])
    if first < 128 -> return Val(first)
    width: if {
        first >= 192 && first < 224 -> 2
        first >= 224 && first < 240 -> 3
        first >= 240 && first < 248 -> 4
        else -> 0
    }
    if width == 0 || bytes.len() < width -> return None
    value: if width == {
        2 -> (first - 192) * 64 + (Int.from_u8(bytes[1]) - 128)
        3 -> (first - 224) * 4096 + (Int.from_u8(bytes[1]) - 128) * 64 + (Int.from_u8(bytes[2]) - 128)
        else -> (first - 240) * 262144 + (Int.from_u8(bytes[1]) - 128) * 4096 + (Int.from_u8(bytes[2]) - 128) * 64 + (Int.from_u8(bytes[3]) - 128)
    }
    Val(value)
}

sema_checked_comptime_key: fn(key: CtKey) -> TComptimeKey? {
    if key == {
        .Int(value) -> Val(checked_comptime_integer_key(value))
        .BigInt(decimal) -> {
            number: Int.parse(decimal) ?? return None
            Val(checked_comptime_integer_key(number))
        }
        .Str(value) -> Val(TComptimeKey.String{value: value})
        .Bool(value) -> Val(TComptimeKey.Bool{value: value})
        .Char(value) -> sema_checked_const_char("{value}").map(fn(code) { TComptimeKey.Char{value: code} })
        .Tuple(fields) -> {
            result := [TComptimeKeyField]{}
            loop field in fields {
                nested: sema_checked_comptime_key(field.value) ?? return None
                result.push(TComptimeKeyField{name: field.name, key: nested})
            }
            Val(TComptimeKey.Tuple{fields: result})
        }
        .Struct(type_name, fields) -> {
            result := [TComptimeKeyField]{}
            loop field in fields {
                nested: sema_checked_comptime_key(field.value) ?? return None
                result.push(TComptimeKeyField{name: field.name, key: nested})
            }
            Val(TComptimeKey.Struct{type_name: type_name, fields: result})
        }
        .Enum(type_name, variant) -> Val(TComptimeKey.Enum{type_name: type_name, variant: variant})
    }
}

sema_checked_comptime: fn(source: CtValue) -> TComptimeValue? {
    if source == {
        .Int(number) -> Val(TComptimeValue.Int{value: number})
        .Float(float_value) -> if float_value == {
            .F32(bits32) -> Val(TComptimeValue.Float{value: bits32, bits: 32})
            .F64(bits64) -> Val(TComptimeValue.Float{value: bits64, bits: 64})
        }
        .Bool(flag) -> Val(TComptimeValue.Bool{value: flag})
        .Char(character) -> sema_checked_const_char("{character}").map(fn(code) { TComptimeValue.Char{value: code} })
        .Str(text) -> Val(TComptimeValue.String{value: text})
        .BigInt(decimal) -> Val(TComptimeValue.BigInt{decimal: decimal})
        .Bytes(bytes) -> Val(TComptimeValue.Bytes{value: bytes})
        .List(values) -> {
            result := [TComptimeValue]{}
            loop item in values {
                converted: sema_checked_comptime(item) ?? return None
                result.push(converted)
            }
            Val(TComptimeValue.List{values: result})
        }
        .Map(entries) -> {
            result := [TComptimeMapEntry]{}
            loop entry in entries {
                key: sema_checked_comptime_key(entry.key) ?? return None
                item: sema_checked_comptime(entry.value) ?? return None
                result.push(TComptimeMapEntry{key: key, value: item})
            }
            Val(TComptimeValue.Map{entries: result})
        }
        .Struct(type_name, fields) -> {
            result := [TComptimeField]{}
            loop field in fields {
                item: sema_checked_comptime(field.value) ?? return None
                result.push(TComptimeField{name: field.name, value: item})
            }
            Val(TComptimeValue.Struct{type_name: type_name, fields: result})
        }
        .Enum(type_name, variant, args) -> {
            result := [TComptimeEnumArg]{}
            loop argument in args {
                item: sema_checked_comptime(argument.value) ?? return None
                result.push(TComptimeEnumArg{name: argument.label, value: item})
            }
            Val(TComptimeValue.Enum{type_name: type_name, variant: variant, args: result})
        }
        .Present(inner) -> sema_checked_comptime(inner).map(fn(item) { TComptimeValue.Present{value: item} })
        .Failed(report) -> if report == {
            .Clean(ty) -> Val(TComptimeValue.Failed{report: TComptimeReport.Clean{ty: ty}})
            .Told(inner) -> sema_checked_comptime(inner).map(fn(item) { TComptimeValue.Failed{report: TComptimeReport.Told{value: item}} })
        }
        .Unit -> Val(TComptimeValue.Unit)
        .Closure(_) -> None
    }
}

sema_checked_constant_type: fn(definition: ConstDef) -> Type? {
    if definition.ty != None -> return definition.ty
    if definition.value == {
        .Int(_, _, _, _, _) -> Val(Type.Int)
        .Float(_, _, _, _, _) -> Val(Type.Float)
        .Bool(_, _, _) -> Val(Type.Bool)
        .Char(_, _, _) -> Val(Type.Char)
        .Str(parts, _, _) -> if parts.len() == 1 && parts[0] == .Lit(_) -> Val(Type.String) else -> None
        .TypedLit(_, _, _, _) -> sema_checked_typed_scalar_literal_type(definition.value)
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// Preserve the type on a scalar literal when no staged type
// has been installed yet. Calls/operators remain outside module storage.
sema_checked_typed_scalar_literal_type: fn(value: Expr) -> Type? {
    if value == .TypedLit(head, body, _, _) {
        ty: head ?? return None
        if ty == {
            .Int | .IntN(_, _) | .Float | .Float32 | .Bool -> {}
            .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> { return None }
        }
        inner: if body == {
            .Value(item) -> item
            .Elements(items) -> {
                if items.len() != 1 -> return None
                items[0]
            }
            .Fields(_) | .Entries(_) | .ByteText(_) | .Empty -> { return None }
        }
        if sema_checked_module_scalar_literal(inner) -> return Val(ty)
    }
    None
}

sema_checked_module_scalar_literal: fn(value: Expr) -> Bool Never! {
    if value == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) -> true
        .Unary(op, inner, _, _) -> op == UnOp.Neg && (inner == .Int(_, _, _, _, _) || inner == .Float(_, _, _, _, _))
        .Paren(inner, _, _) -> sema_checked_module_scalar_literal(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

sema_checked_constant: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, definition: ConstDef, diagnostics: &[Diagnostic]) -> TConstantDef? {
    value: definition.ct ?? return None
    checked_value: sema_checked_comptime(value) ?? {
        diagnostics.push(sema_error("E0109", definition.span, "this constant value is not representable in the checked tree", "module constants need a closed compile-time value", "use a supported scalar, string, byte-list, or closed aggregate literal"))
        return None
    }
    if !sema_checked_runtime_constant_supported(definition, value) {
        diagnostics.push(sema_checked_module_value_error(definition))
        return None
    }
    ty: sema_checked_constant_type(definition) ?? {
        diagnostics.push(sema_error("E0109", definition.span, "this constant has no checked type", "constant declarations need a stable value type", "provide a supported constant literal"))
        return None
    }
    TConstantDef{module_identity: module_row.module_identity, key: sema_checked_module_key(module_row, definition.name), name: definition.name, span: definition.span, visibility: TVisibility.Public, ty: sema_checked_qualify_type(graph, ty, module_row.module_identity), is_comptime: definition.is_comptime, is_storage: !definition.is_comptime && (definition.is_persist || definition.mutable), value: checked_value}
}

// An immutable module constant holds any folded literal value; runtime
// storage (mutable or `#Persist`) keeps the portable scalar carriers.
sema_checked_runtime_tvalue_supported: fn(definition: ConstDef, value: TComptimeValue) -> Bool Never! {
    if definition.is_comptime -> return true
    ty: definition.ty ?? Type.Named{name: ""}
    if ty == (Type.Named{name: "Output"}) || ty == (Type.Named{name: "__OutputDefaults"}) -> return true
    if !definition.mutable && !definition.is_persist -> return true
    if value == {
        .Int(_) | .Float(_, _) | .Bool(_) -> true
        .Char(_) | .String(_) -> !definition.mutable
        .List(values) -> {
            if definition.mutable -> return false
            loop item in values {
                if item == {
                    .Int(_) -> {}
                    .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit -> return false
                }
            }
            true
        }
        // A computed [U8] lands as its bytes (JetEval Values.jet).
        .Bytes(_) -> !definition.mutable
        .BigInt(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit -> false
    }
}

sema_checked_constant_from_value: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, constant: SemaRegistrationConstant, value: SemaComptimeItemValue, diagnostics: &[Diagnostic]) -> TConstantDef? {
    if !sema_checked_runtime_tvalue_supported(constant.declaration, value.value) {
        diagnostics.push(sema_checked_module_value_error(constant.declaration))
        return None
    }
    ty := constant.declaration.ty ?? value.ty
    if ty == (Type.Named{name: ""}) {
        ty = sema_checked_constant_type(constant.declaration) ?? {
            diagnostics.push(sema_error("E0109", constant.declaration.span, "this constant has no checked type", "constant declarations need a stable value type", "provide a supported constant literal"))
            return None
        }
    }
    TConstantDef{module_identity: module_row.module_identity, key: sema_checked_module_key(module_row, constant.declaration.name), name: constant.declaration.name, span: constant.declaration.span, visibility: TVisibility.Public, ty: sema_checked_qualify_type(graph, ty, module_row.module_identity), is_comptime: constant.declaration.is_comptime, is_storage: !constant.declaration.is_comptime && (constant.declaration.is_persist || constant.declaration.mutable), value: value.value, shared_holder: value.shared_holder}
}

// `staged_values` holds the module's staged constant values by symbol key.
sema_checked_constant_with_values: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, constant: SemaRegistrationConstant, staged_values: [String:SemaComptimeItemValue], diagnostics: &[Diagnostic]) -> TConstantDef? {
    if sema_output_metadata_binding(constant.declaration) -> return None
    if !sema_checked_module_value_evaluates(constant.declaration) && !sema_checked_module_value_computed(constant.declaration) {
        diagnostics.push(sema_checked_module_value_error(constant.declaration))
        return None
    }
    staged: staged_values.get(constant.symbol.id.key)
    if staged == {
        .Val(value) -> sema_checked_constant_from_value(graph, module_row, constant, value, diagnostics)
        .None -> sema_checked_constant(graph, module_row, constant.declaration, diagnostics)
    }
}

// A comptime `@name` binding evaluates any pure expression,
// and a typed Output carries its own closed shape. Every other module binding
// holds literal data, which the compile-time evaluator folds once.
sema_checked_module_value_evaluates: fn(definition: ConstDef) -> Bool Never! {
    if definition.is_comptime -> return true
    ty: definition.ty ?? Type.Named{name: ""}
    if ty == (Type.Named{name: "Output"}) || ty == (Type.Named{name: "__OutputDefaults"}) -> return true
    sema_checked_module_literal(definition.value)
}

// An immutable `NAME: expr` whose value is not literal data: the build
// computes it, and refuses it (E0643) when its evaluation is impure or
// fails. Runtime storage (mutable or `#Persist`) still needs a literal.
sema_checked_module_value_computed: fn(definition: ConstDef) -> Bool Never! {
    if definition.mutable || definition.is_persist -> return false
    !sema_checked_module_value_evaluates(definition)
}

sema_checked_module_value_error: fn(definition: ConstDef) -> Diagnostic {
    sema_error("E0622", expr_span(definition.value), "a module binding's value must be a literal", "a mutable or `#Persist` module global is runtime storage, which every execution tier initializes from a scalar literal before `run: fn`", "use an integer, float, or bool literal, or keep struct and list values in an unmarked `:` constant")
}

// Literal data only: no calls, operators, or name reads. An uppercase
// `Type.Case` path, optionally `Type.Case(args)`, names an enum case.
sema_checked_module_literal: fn(value: Expr) -> Bool Never! {
    if value == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Char(_, _, _) | .Unit(_, _) | .Absent(_, _) -> true
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Lit(_) -> next
                return false
            }
            true
        }
        .Unary(op, operand, _, _) -> op == UnOp.Neg && (operand == .Int(_, _, _, _, _) || operand == .Float(_, _, _, _, _))
        .Paren(inner, _, _) -> sema_checked_module_literal(inner)
        .Present(inner, _, _) -> sema_checked_module_literal(inner)
        .ListLit(elements, _, _) -> sema_checked_module_literal_list(elements)
        .MapLit(entries, _, _) -> sema_checked_module_literal_pairs(entries)
        .StructLit(_, _, _, _, fields, _, _, _) -> sema_checked_module_literal_fields(fields)
        .TypedLit(_, body, _, _) -> if body == {
            .Fields(fields) -> sema_checked_module_literal_fields(fields)
            .Elements(elements) -> sema_checked_module_literal_list(elements)
            .Entries(entries) -> sema_checked_module_literal_pairs(entries)
            .Value(inner) -> sema_checked_module_literal(inner)
            .ByteText(_) | .Empty -> true
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop argument in args {
                item: if argument == {
                    .Positional(inner) -> inner
                    .Named(_, inner) -> inner
                }
                if !sema_checked_module_literal(item) -> return false
            }
            true
        }
        .Field(_, _, _, _) -> sema_checked_module_type_path(value)
        .MethodCall(receiver, method, _, _, type_args, args, _) -> {
            if type_args.len() != 0 || !sema_checked_module_uppercase(method) || !sema_checked_module_type_path(receiver) -> return false
            loop argument in args {
                if !sema_checked_module_literal(argument.expr) -> return false
            }
            true
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

sema_checked_module_literal_list: fn(values: [Expr]) -> Bool Never! {
    loop value in values {
        if !sema_checked_module_literal(value) -> return false
    }
    true
}

sema_checked_module_literal_pairs: fn(entries: [ExprPair]) -> Bool Never! {
    loop entry in entries {
        if !sema_checked_module_literal(entry.key) || !sema_checked_module_literal(entry.value) -> return false
    }
    true
}

sema_checked_module_literal_fields: fn(fields: [ExprField]) -> Bool Never! {
    loop field in fields {
        if !sema_checked_module_literal(field.value) -> return false
    }
    true
}

sema_checked_module_type_path: fn(value: Expr) -> Bool Never! {
    if value == {
        .Ident(name, _, _) -> sema_checked_module_uppercase(name)
        .Field(base, member, _, _) -> sema_checked_module_uppercase(member) && sema_checked_module_type_path(base)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

sema_checked_module_uppercase: fn(name: String) -> Bool Never! {
    bytes: name.bytes()
    if bytes.len() == 0 -> return false
    first: Int.from_u8(bytes[0])
    first >= 65 && first <= 90
}

sema_checked_runtime_constant_supported: fn(definition: ConstDef, value: CtValue) -> Bool Never! {
    if definition.is_comptime -> return true
    ty: definition.ty ?? Type.Named{name: ""}
    if ty == (Type.Named{name: "Output"}) || ty == (Type.Named{name: "__OutputDefaults"}) -> return true
    if !definition.mutable && !definition.is_persist -> return true
    if value == {
        .Int(_) | .Float(_) | .Bool(_) -> true
        .Char(_) | .Str(_) -> !definition.mutable
        .List(values) -> {
            if definition.mutable -> return false
            loop item in values {
                if item == {
                    .Int(_) -> {}
                    .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> return false
                }
            }
            true
        }
        .BigInt(_) | .Bytes(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> false
    }
}

sema_checked_qualify_type: fn(graph: SemaRegistrationGraph, ty: Type, caller_module: String) -> Type Never! {
    sema_type_resolve_declared(graph, ty, caller_module)
}

// `ty.map((value) -> sema_checked_qualify_type(graph, …))` without the
// callback, which would capture (copy) the whole graph and module row.
sema_checked_qualify_optional_type: fn(graph: SemaRegistrationGraph, ty: Type?, caller_module: String) -> Type? Never! {
    value: ty ?? return None
    Val(sema_type_resolve_declared(graph, value, caller_module))
}

sema_checked_qualify_type_with_generics: fn(graph: SemaRegistrationGraph, ty: Type, caller_module: String, generic_params: [TGenericParam]) -> Type Never! {
    sema_type_resolve_declared_with_generics(graph, ty, caller_module, generic_params)
}

// The implementation blocks a struct or enum writes inside its body, each
// with its checked trait constants.
sema_checked_add_nested_impls: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, definition: Item, impls: &[TImplDef], diagnostics: &[Diagnostic]) Never! {
    if definition == {
        .Struct(value) -> {
            loop block in value.trait_impls {
                constants: sema_trait_constants_check_impl(graph, module_row.module_identity, Val(block.trait_name), value.name, block.constants, block.trait_span, diagnostics)
                impls.push(sema_checked_nested_impl_row(graph, module_row, value.name, block, constants))
            }
        }
        .Enum(value) -> {
            loop block in value.trait_impls {
                constants: sema_trait_constants_check_impl(graph, module_row.module_identity, Val(block.trait_name), value.name, block.constants, block.trait_span, diagnostics)
                impls.push(sema_checked_nested_impl_row(graph, module_row, value.name, block, constants))
            }
        }
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

sema_checked_layout_item_name: fn(item: Item) -> String? {
    if item == {
        .Struct(value) -> Val(value.name)
        .Enum(value) -> Val(value.name)
        .Distinct(value) -> Val(value.name)
        .TypeAlias(value) -> Val(value.name)
        .Func(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}

sema_checked_layout_type_resolution: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, owner_qualified_name: String, source_name: String, generic_params: [TypeParam], resolutions: &[TargetLayoutNameResolution]) Never! {
    loop parameter in generic_params {
        if parameter.name == source_name -> return
    }
    qualified: sema_checked_qualify_type(graph, Type.Named{name: source_name}, module_row.module_identity)
    if qualified == .Named(qualified_name) {
        if qualified_name == source_name -> return
        loop existing in resolutions {
            if existing.owner_qualified_name == owner_qualified_name && existing.source_name == source_name -> return
        }
        resolutions.push(TargetLayoutNameResolution{owner_qualified_name: owner_qualified_name, source_name: source_name, qualified_name: qualified_name})
    }
}

sema_checked_layout_type_resolutions: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, owner_qualified_name: String, generic_params: [TypeParam], ty: Type, resolutions: &[TargetLayoutNameResolution]) Never! {
    if ty == {
        .Named(name) -> sema_checked_layout_type_resolution(graph, module_row, owner_qualified_name, name, generic_params, resolutions)
        .Apply(name, args) -> {
            sema_checked_layout_type_resolution(graph, module_row, owner_qualified_name, name, generic_params, resolutions)
            loop arg in args -> sema_checked_layout_type_resolutions(graph, module_row, owner_qualified_name, generic_params, arg, resolutions)
        }
        .FixedList(inner, _) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Quantity(inner, _) -> sema_checked_layout_type_resolutions(graph, module_row, owner_qualified_name, generic_params, inner, resolutions)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .Float32 | .Union(_) | .Case(_, _) | .Measure(_) -> {}
    }
}

sema_checked_layout_item_resolutions: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule, owner_qualified_name: String, item: Item, resolutions: &[TargetLayoutNameResolution]) Never! {
    if item == {
        .Struct(value) -> {
            generic_params: value.type_params
            loop field in value.fields -> sema_checked_layout_type_resolutions(graph, module_row, owner_qualified_name, generic_params, field.ty, resolutions)
        }
        .Enum(value) -> {
            generic_params: value.type_params
            loop variant in value.variants {
                if variant.payload == {
                    .Unit -> {}
                    .Single(ty, _) -> sema_checked_layout_type_resolutions(graph, module_row, owner_qualified_name, generic_params, ty, resolutions)
                    .Named(fields) -> loop field in fields -> sema_checked_layout_type_resolutions(graph, module_row, owner_qualified_name, generic_params, field.ty, resolutions)
                }
            }
        }
        .Distinct(value) -> sema_checked_layout_type_resolutions(graph, module_row, owner_qualified_name, [TypeParam]{}, value.base, resolutions)
        .TypeAlias(value) -> {
            generic_params: value.type_params
            sema_checked_layout_type_resolutions(graph, module_row, owner_qualified_name, generic_params, value.target, resolutions)
        }
        .Func(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
}

sema_checked_layout_engine: fn(graph: SemaRegistrationGraph, module_row: SemaRegistrationModule) -> TargetLayoutEngine Never! {
    qualified_items := [TargetLayoutQualifiedItem]{}
    name_resolutions := [TargetLayoutNameResolution]{}
    loop source_module_index in 0..<graph.modules.len() {
        loop item_index in 0..<graph.modules[source_module_index].program.items.len() {
            item_name: sema_checked_layout_item_name(graph.modules[source_module_index].program.items[item_index]) ?? next
            identity: sema_checked_module_key(graph.modules[source_module_index], item_name)
            qualified_items.push(TargetLayoutQualifiedItem{qualified_name: identity, module_identity: graph.modules[source_module_index].module_identity, item: graph.modules[source_module_index].program.items[item_index]})
            sema_checked_layout_item_resolutions(graph, graph.modules[source_module_index], identity, graph.modules[source_module_index].program.items[item_index], name_resolutions)
        }
    }
    jet_target_layout_engine_with_registry([Item]{}, qualified_items, name_resolutions, jet_target_layout_from_machine(graph.target_machine))
}

sema_checked_declaration_facts: fn(graph: SemaRegistrationGraph, module_index: Int, diagnostics: &[Diagnostic], values: [SemaComptimeItemValue], boxed: [String:[String]]) -> TDeclarationFacts {
    if module_index < 0 || module_index >= graph.modules.len() -> return TDeclarationFacts{type_defs: [TTypeDef]{}, traits: [TTraitDef]{}, impls: [TImplDef]{}, constants: [TConstantDef]{}, core_builtin_owners: [TCoreBuiltinOwner]{}}
    module_row: graph.modules[module_index]
    layout_engine := TargetLayoutEngine?{None}
    type_defs := [TTypeDef]{}
    traits := [TTraitDef]{}
    impls := [TImplDef]{}
    constants := [TConstantDef]{}
    core_builtin_owners: sema_checked_core_builtin_owners(graph, module_row)
    loop nominal in module_row.nominals {
        source_item: sema_registration_nominal_source_item(nominal.source)
        if layout_engine == None && source_item == .Val(item) {
            if item == .Enum(value) {
                if sema_checked_foreign_enum_c_layout_tag(value) != None -> layout_engine = Val(sema_checked_layout_engine(graph, module_row))
            }
        }
        trait_row: sema_checked_trait_row(graph, module_row, nominal)
        if trait_row == .Val(value) -> traits.push(value)
        definition: sema_checked_type_def(graph, boxed, module_row, layout_engine, nominal, diagnostics)
        if definition == .Val(value) -> type_defs.push(value)
        if source_item == .Val(item) {
            if item == .UnitFamily(value) -> sema_checked_standard_unit_defs(module_row, value, type_defs)
            if item == .Trait(value) -> sema_trait_constants_check_trait(graph, module_row.module_identity, value, diagnostics)
            sema_checked_add_nested_impls(graph, module_row, item, impls, diagnostics)
            loop block in sema_registration_item_trait_blocks(item) -> sema_checked_validate_nested_impl(graph, module_row, nominal, block, diagnostics)
        }
    }
    sema_checked_impl_coherence(graph, module_row, diagnostics)
    loop implementation in module_row.impls {
        sema_checked_validate_impl(graph, module_row, implementation, diagnostics)
        impl_constants: sema_trait_constants_check_impl(graph, module_row.module_identity, implementation.declaration.trait_name, implementation.declaration.type_name, implementation.declaration.constants, implementation.declaration.type_span, diagnostics)
        impls.push(sema_checked_impl_row(graph, module_row, implementation, impl_constants))
    }
    // The module's staged constant values by key, first row winning: one
    // pass over the values rather than one per constant.
    staged_values := [String:SemaComptimeItemValue]{}
    if module_row.constants.len() > 0 {
        loop value in values {
            if value.kind != SemaComptimeItemKind.Constant || value.module_identity != module_row.module_identity -> next
            if staged_values.get(value.key) == None -> staged_values[value.key] = value
        }
    }
    loop constant in module_row.constants {
        if sema_output_metadata_binding(constant.declaration) -> next
        row: sema_checked_constant_with_values(graph, module_row, constant, staged_values, diagnostics) ?? next
        constants.push(row)
    }
    TDeclarationFacts{type_defs: type_defs, traits: traits, impls: impls, constants: constants, core_builtin_owners: core_builtin_owners}
}

// `boxed` is `sema_checked_program_boxed_edges(graph)`, computed once per graph.
sema_registration_check_declarations_with_values: fn(graph: SemaRegistrationGraph, module_index: Int, diagnostics: &[Diagnostic], values: [SemaComptimeItemValue], boxed: [String:[String]]) -> TDeclarationFacts {
    sema_checked_declaration_facts(graph, module_index, diagnostics, values, boxed)
}
