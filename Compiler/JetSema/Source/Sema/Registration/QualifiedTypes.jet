// Types written with a module alias (`enc.EncodingError`) name their target
// through the declaring file's import; the alias means nothing in any other
// module. A bare type name means what the declaring module sees under it: a
// type it declares, one its package's other modules declare, or one it
// imports (`use jet_foundation.[Effect]`). Another module resolves the same
// bare name among its own names, where it can name a different type (its
// own `Type`, or the prelude's) or none. Once imports are bound, each
// module's declared signatures replace such a name with the target's
// canonical key, so every copy of a symbol (an import binding, a package
// name) carries types that resolve in whichever module checks a use of it.
use jet_foundation.[
    CompilerThreads,
    Symbol,
    Type,
    compiler_threads_admit,
    compiler_threads_heaviest_first,
    compiler_threads_slot_taken,
    type_identity_equal,
    ModuleID,
    module_is_core,
]

// Every module's keys, then its rewritten types,
// are read off the graph alone, each module's by itself, so both run as graph
// scans (sema_graph_scan), claimed largest source first; each module's
// rewritten types then move into its rows, the same for any thread count.
sema_registration_canonicalize_qualified_types: fn(graph: ^^SemaRegistrationGraph, threads: CompilerThreads) -> SemaRegistrationGraph {
    ^owned: graph.move()
    count: owned.modules.len()
    ^rows: [Int]{}
    ^weights: [Int]{}
    ^work: 0
    loop module_index in 0..<count {
        bytes: owned.modules[module_index].source.count_bytes()
        rows.push(module_index)
        weights.push(bytes)
        work += bytes
    }
    workers: compiler_threads_admit(threads, rows.len(), work, SEMA_QUALIFIED_MIN_BYTES_PER_THREAD, 0, 0)
    ^keyed: sema_graph_scan(sema_graph_scan_new(owned, [SemaGraphModuleResult]{}, rows, compiler_threads_heaviest_first(weights)), workers)
    ^jobs: SemaQualifiedJobs{keys: [[String:Type]]{}}
    loop _ in 0..<count -> jobs.keys.push([String:Type]{})
    ^found_keys: sema_registration_qualified_take(keyed.found)
    loop found_keys.len() > 0 {
        ^found: found_keys.pop() ?? break
        jobs.keys[keyed.rows[found_keys.len()]] = compiler_threads_slot_taken(found.keys.move())
    }
    ^scan: sema_graph_scan_new(keyed.graph.move(), [SemaGraphModuleResult]{}, keyed.rows.move(), keyed.order.move())
    scan.qualified = Val(jobs.move())
    ^rewritten: sema_graph_scan(scan, workers)
    owned = rewritten.graph.move()
    ^rewrites: sema_registration_qualified_take(rewritten.found)
    loop rewrites.len() > 0 {
        ^found: rewrites.pop() ?? break
        sema_registration_qualified_apply(owned, rewritten.rows[rewrites.len()], found.types.move())
    }
    owned
}

// A program with less source per admitted thread finds its keys and types on
// the calling thread.
SEMA_QUALIFIED_MIN_BYTES_PER_THREAD: 262144

// What a module's qualified scan reads besides the graph: every graph
// module's keys.
SemaQualifiedJobs: struct {
    keys: [[String:Type]],
}

// One module's qualified scan: its keys, or its rewritten types, one slot
// per type the rewrite reads (None keeps the slot's own type).
SemaQualifiedFound: struct {
    keys: [String:Type]?,
    types: [Type?],
}

// With no keys yet, a module's scan finds its keys; with every module's
// keys, its rewritten types.
sema_registration_qualified_scan: fn(graph: SemaRegistrationGraph, module_index: Int, jobs: SemaQualifiedJobs?) -> SemaQualifiedFound Never! {
    if jobs == .Val(keyed) {
        return SemaQualifiedFound{keys: None, types: sema_registration_qualified_types(graph, module_index, keyed)}
    }
    SemaQualifiedFound{keys: Val(sema_registration_module_qualified_keys(graph, module_index)), types: [Type?]{}}
}

// A graph scan's qualified findings, by position.
sema_registration_qualified_take: fn(found: ^^[SemaGraphScanFound?]) -> [SemaQualifiedFound] {
    ^slots: found.move()
    slots.reverse()
    ^taken: [SemaQualifiedFound]{}
    loop slots.len() > 0 {
        ^slot: slots.pop() ?? break
        ^row: compiler_threads_slot_taken(slot)
        taken.push(compiler_threads_slot_taken(row.qualified.move()))
    }
    taken
}

// The module's rewritten types: per function row of its functions, then of
// its nominals' and its impls' methods, the signature, the symbol's type
// and each parameter's type and symbol type; then its symbols' types; then
// its import bindings' symbol types, an import binding being a copy of its
// declaring module's symbol, written in that module's names.
sema_registration_qualified_types: fn(graph: SemaRegistrationGraph, module_index: Int, jobs: SemaQualifiedJobs) -> [Type?] Never! {
    ^slots: [Type?]{}
    sema_registration_qualified_function_types(graph.modules[module_index].functions, jobs, module_index, slots)
    loop nominal in graph.modules[module_index].nominals {
        sema_registration_qualified_function_types(nominal.methods, jobs, module_index, slots)
    }
    loop implementation in graph.modules[module_index].impls {
        sema_registration_qualified_function_types(implementation.methods, jobs, module_index, slots)
    }
    loop symbol in graph.modules[module_index].symbols {
        slots.push(sema_registration_qualified_symbol_type(symbol, jobs, module_index))
    }
    loop import in graph.modules[module_index].imports {
        loop binding in import.bindings {
            if binding.symbol.ty != None && sema_registration_module_index(graph, binding.symbol.module_identity) == .Val(source) {
                slots.push(sema_registration_qualified_symbol_type(binding.symbol, jobs, source))
            } else { slots.push(None) }
        }
    }
    slots
}

sema_registration_qualified_function_types: fn(functions: [SemaRegistrationFunction], jobs: SemaQualifiedJobs, source: Int, slots: ^[Type?]) Never! {
    loop function in functions {
        slots.push(sema_registration_canonical_type(function.signature, jobs.keys[source]))
        loop parameter in function.parameters {
            slots.push(sema_registration_canonical_type(parameter.ty, jobs.keys[source]))
        }
    }
}

// The symbol's type with module `source`'s keys, if it has one they change.
sema_registration_qualified_symbol_type: fn(symbol: Symbol, jobs: SemaQualifiedJobs, source: Int) -> Type? Never! {
    if symbol.ty == .Val(ty) -> return sema_registration_canonical_type(ty, jobs.keys[source])
    None
}

// Moves a module's rewritten types (sema_registration_qualified_types) into
// its rows, slot by slot in the same order. A module with no rewritten type
// keeps its rows untouched, so rows another holder shares are not copied;
// within a module, only a row a slot rewrites is written, so a list whose
// rows keep their types is not copied either.
sema_registration_qualified_apply: fn(graph: ^SemaRegistrationGraph, module_index: Int, types: ^^[Type?]) {
    ^slots: types.move()
    if !sema_registration_qualified_rewrites(slots) {
        return
    }
    slots.reverse()
    sema_registration_qualified_apply_functions(graph.modules[module_index].functions, slots)
    loop nominal in 0..<graph.modules[module_index].nominals.len() {
        sema_registration_qualified_apply_functions(graph.modules[module_index].nominals[nominal].methods, slots)
    }
    loop implementation in 0..<graph.modules[module_index].impls.len() {
        sema_registration_qualified_apply_functions(graph.modules[module_index].impls[implementation].methods, slots)
    }
    loop position in 0..<graph.modules[module_index].symbols.len() {
        if sema_registration_qualified_next(slots) == .Val(ty) {
            graph.modules[module_index].symbols[position].ty = Val(ty)
        }
    }
    loop import_index in 0..<graph.modules[module_index].imports.len() {
        loop binding in 0..<graph.modules[module_index].imports[import_index].bindings.len() {
            if sema_registration_qualified_next(slots) == .Val(ty) {
                graph.modules[module_index].imports[import_index].bindings[binding].symbol.ty = Val(ty)
            }
        }
    }
}

// Whether one of a module's slots holds a rewritten type.
sema_registration_qualified_rewrites: fn(slots: [Type?]) -> Bool Never! {
    loop slot in slots {
        if slot != None -> return true
    }
    false
}

sema_registration_qualified_apply_functions: fn(functions: ^[SemaRegistrationFunction], slots: ^[Type?]) {
    loop row in 0..<functions.len() {
        if sema_registration_qualified_next(slots) == .Val(ty) -> functions[row].signature = ty
        loop parameter in 0..<functions[row].parameters.len() {
            if sema_registration_qualified_next(slots) == .Val(ty) {
                functions[row].parameters[parameter].ty = ty
            }
        }
    }
}

// The next slot's rewritten type, None to keep the row's own (as every row
// past the last slot does).
sema_registration_qualified_next: fn(slots: ^[Type?]) -> Type? { slots.pop() ?? None }

// Each alias-qualified or bare type name the module's declarations write,
// mapped to the type it resolves to in that module (the checker's own
// resolution). A bare name keys only a user package's type: Core types keep
// their spelling, as does a name some generic parameter or associated type
// of the module spells, which means that parameter where it is written.
sema_registration_module_qualified_keys: fn(graph: SemaRegistrationGraph, module_index: Int) -> [String:Type] Never! {
    ^names: [String]{}
    loop function in graph.modules[module_index].functions {
        sema_registration_function_qualified_names(function, names)
    }
    loop nominal in graph.modules[module_index].nominals {
        loop method in nominal.methods -> sema_registration_function_qualified_names(method, names)
    }
    loop implementation in graph.modules[module_index].impls {
        loop method in implementation.methods {
            sema_registration_function_qualified_names(method, names)
        }
    }
    loop symbol in graph.modules[module_index].symbols {
        if symbol.ty == .Val(ty) -> sema_registration_type_qualified_names(ty, names)
    }
    ^keys: [String:Type]{}
    identity: graph.modules[module_index].module_identity
    loop name in names {
        if sema_registration_canonical_spelling(graph, name) -> next
        if !name.contains(".") && (!sema_registration_bare_user_type(graph, module_index, identity, name) || sema_registration_module_spells_parameter(graph.modules[module_index], name)) {
            next
        }
        written: Type.Named{name: name}
        resolved: sema_type_resolve_declared(graph, written, identity)
        if !type_identity_equal(resolved, written) -> keys[name] = resolved
    }
    keys
}

// Whether `name` is a canonical key, `{module identity}.{Name}` of a module
// the graph holds: already resolved. An alias-qualified name (`alias.Name`)
// is dotted too, but its prefix is an import alias, never a module identity.
sema_registration_canonical_spelling: fn(graph: SemaRegistrationGraph, name: String) -> Bool Never! {
    cut: name.cut_last(".") ?? return false
    sema_registration_module_index_text(graph, cut.before) != None
}

// Whether the bare `name` names a declaration of a user package in module
// row `module_index`: its own, its package's, or an imported one.
sema_registration_bare_user_type: fn(graph: SemaRegistrationGraph, module_index: Int, identity: ModuleID, name: String) -> Bool Never! {
    found: sema_registration_lookup_name_at(graph, module_index, identity, name) ?? return false
    !module_is_core(found.source_module_identity)
}

// Whether one of the module's generic parameters, impl conditions or
// associated types is spelled `name`.
sema_registration_module_spells_parameter: fn(module_row: SemaRegistrationModule, name: String) -> Bool Never! {
    loop function in module_row.functions {
        if sema_registration_function_spells_parameter(function, name) -> return true
    }
    loop nominal in module_row.nominals {
        loop parameter in nominal.generic_params {
            if parameter.name == name -> return true
        }
        loop method in nominal.methods {
            if sema_registration_function_spells_parameter(method, name) -> return true
        }
    }
    loop implementation in module_row.impls {
        loop method in implementation.methods {
            if sema_registration_function_spells_parameter(method, name) -> return true
        }
        loop associated in implementation.associated_type_impls {
            if associated.name == name -> return true
        }
        loop associated in implementation.associated_types {
            if associated.declaration.name == name -> return true
        }
    }
    false
}

sema_registration_function_spells_parameter: fn(function: SemaRegistrationFunction, name: String) -> Bool Never! {
    loop parameter in function.generic_params {
        if parameter.name == name -> return true
    }
    loop condition in function.impl_conditions {
        if condition.name == name -> return true
    }
    false
}

sema_registration_function_qualified_names: fn(function: SemaRegistrationFunction, names: ^[String]) Never! {
    sema_registration_type_qualified_names(function.signature, names)
    loop parameter in function.parameters {
        sema_registration_type_qualified_names(parameter.ty, names)
    }
}

// `ty` with `keys`, or None when it writes no name they key.
sema_registration_canonical_type: fn(ty: Type, keys: [String:Type]) -> Type? Never! {
    if keys.len() == 0 -> return None
    ^names: [String]{}
    sema_registration_type_qualified_names(ty, names)
    ^found: [String]{}
    actuals: loop name in names -> {
        resolved: keys.get(name) ?? next
        found.push(name)
        resolved
    }
    if found.len() == 0 -> return None
    ^substituted: sema_inference_substitute_type(ty, found, actuals)
    sema_registration_canonical_heads(substituted, keys)
    Val(substituted)
}

// Rewrites each alias-qualified generic head (`alias.Name<T>`, #6410) in `ty`
// in place to the key its `Named` spelling resolves to; the arguments are
// already canonical.
sema_registration_canonical_heads: fn(ty: ^Type, keys: [String:Type]) Never! {
    if ty.in_place() == {
        .List(inner) -> sema_registration_canonical_heads(inner, keys)
        .Map(key, _, value) -> {
            sema_registration_canonical_heads(key, keys)
            sema_registration_canonical_heads(value, keys)
        }
        .Shared(inner) -> sema_registration_canonical_heads(inner, keys)
        .Option(inner) -> sema_registration_canonical_heads(inner, keys)
        .Result(ok, err) -> {
            sema_registration_canonical_heads(ok, keys)
            sema_registration_canonical_heads(err, keys)
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop index in 0..<params.len() -> sema_registration_canonical_heads(params[index], keys)
            if ret.in_place() == .Val(declared) -> sema_registration_canonical_heads(declared, keys)
        }
        .Apply(name, args) -> {
            loop index in 0..<args.len() -> sema_registration_canonical_heads(args[index], keys)
            if keys.get(name) == .Val(resolved) {
                if resolved == .Named(key) -> name = key.copy()
            }
        }
        .Tuple(fields) -> {
            loop index in 0..<fields.len() -> sema_registration_canonical_heads(fields[index].ty, keys)
        }
        .FixedList(element, _) -> sema_registration_canonical_heads(element, keys)
        .InlineRange(base, _, _) -> sema_registration_canonical_heads(base, keys)
        .Tagged(_, inner) -> sema_registration_canonical_heads(inner, keys)
        .Union(members) -> {
            loop index in 0..<members.len() -> sema_registration_canonical_heads(members[index], keys)
        }
        .Case(_, payload) -> sema_registration_canonical_heads(payload, keys)
        .Quantity(base, _) -> sema_registration_canonical_heads(base, keys)
        .Int | .Float | .Bool | .String | .Char | .Named(_) | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> {}
    }
}

// The alias-qualified and bare type names in `ty`: `Named` types and generic
// heads (`alias.Name`, `alias.Name<T>`), canonical keys among them
// (sema_registration_canonical_spelling).
sema_registration_type_qualified_names: fn(ty: Type, names: ^[String]) Never! {
    if ty == {
        .Named(name) -> sema_registration_push_qualified_name(name, names)
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .Case(_, inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> {
            sema_registration_type_qualified_names(inner, names)
        }
        .Map(key, _, value) -> {
            sema_registration_type_qualified_names(key, names)
            sema_registration_type_qualified_names(value, names)
        }
        .Result(ok, err) -> {
            sema_registration_type_qualified_names(ok, names)
            sema_registration_type_qualified_names(err, names)
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params -> sema_registration_type_qualified_names(param, names)
            if ret == .Val(declared) -> sema_registration_type_qualified_names(declared, names)
        }
        .Apply(name, args) -> {
            sema_registration_push_qualified_name(name, names)
            loop arg in args -> sema_registration_type_qualified_names(arg, names)
        }
        .Tuple(fields) -> {
            loop field in fields -> sema_registration_type_qualified_names(field.ty, names)
        }
        .Union(members) -> {
            loop member in members -> sema_registration_type_qualified_names(member, names)
        }
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> {}
    }
}

// An alias-qualified name, a bare one an import may bind, or a canonical key.
sema_registration_push_qualified_name: fn(name: String, names: ^[String]) Never! {
    if name != "" && !name.starts_with("type:") && !names.contains(name) -> names.push(name.copy())
}
