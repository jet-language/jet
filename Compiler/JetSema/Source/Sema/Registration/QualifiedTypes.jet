// Types written with a module alias (`enc.EncodingError`) name their target
// through the declaring file's import; the alias means nothing in any other
// module. Once imports are bound, each module's declared signatures replace
// such a name with the target's canonical key, so every copy of a symbol (an
// import binding, a package name) carries types that resolve in whichever
// module checks a use of it.
use jet_foundation.[
    Symbol,
    Type,
    TypeTupleField,
    type_identity_equal,
]

fn sema_registration_canonicalize_qualified_types(graph: &SemaRegistrationGraph) Never! {
    module_keys := [[String:Type]]{}
    loop module_index in 0..<graph.modules.len() -> &module_keys.push(sema_registration_module_qualified_keys(graph, module_index))
    loop module_index in 0..<graph.modules.len() {
        keys :: module_keys[module_index]
        if keys.len() > 0 {
            sema_registration_canonical_functions(&graph.modules[module_index].functions, keys)
            loop nominal in 0..<graph.modules[module_index].nominals.len() -> sema_registration_canonical_functions(&graph.modules[module_index].nominals[nominal].methods, keys)
            loop implementation in 0..<graph.modules[module_index].impls.len() -> sema_registration_canonical_functions(&graph.modules[module_index].impls[implementation].methods, keys)
            loop position in 0..<graph.modules[module_index].symbols.len() -> sema_registration_canonical_symbol(&graph.modules[module_index].symbols[position], keys)
        }
        // An import binding copies its declaring module's symbol, written
        // in that module's names.
        loop import_index in 0..<graph.modules[module_index].imports.len() {
            loop binding in 0..<graph.modules[module_index].imports[import_index].bindings.len() {
                source :: graph.modules[module_index].imports[import_index].bindings[binding].symbol.module_name
                source_index :: sema_registration_module_index(graph, source) ?? next
                if module_keys[source_index].len() == 0 -> next
                sema_registration_canonical_symbol(&graph.modules[module_index].imports[import_index].bindings[binding].symbol, module_keys[source_index])
            }
        }
    }
}

// Each alias-qualified type name the module's declarations write, mapped to
// the type it resolves to in that module (the checker's own resolution).
fn sema_registration_module_qualified_keys(graph: SemaRegistrationGraph, module_index: Int) -> [String:Type] Never! {
    names := [String]{}
    loop function in graph.modules[module_index].functions -> sema_registration_function_qualified_names(function, &names)
    loop nominal in graph.modules[module_index].nominals {
        loop method in nominal.methods -> sema_registration_function_qualified_names(method, &names)
    }
    loop implementation in graph.modules[module_index].impls {
        loop method in implementation.methods -> sema_registration_function_qualified_names(method, &names)
    }
    loop symbol in graph.modules[module_index].symbols {
        if symbol.ty == .Val(ty) -> sema_registration_type_qualified_names(ty, &names)
    }
    keys := [String:Type]{}
    identity :: graph.modules[module_index].module_identity
    loop name in names {
        written :: Type.Named{name: name}
        resolved :: sema_type_resolve_declared(graph, written, identity)
        if !type_identity_equal(resolved, written) -> keys[name] = resolved
    }
    keys
}

fn sema_registration_function_qualified_names(function: SemaRegistrationFunction, names: &[String]) Never! {
    sema_registration_type_qualified_names(function.signature, &names)
    loop parameter in function.parameters -> sema_registration_type_qualified_names(parameter.ty, &names)
}

fn sema_registration_canonical_functions(functions: &[SemaRegistrationFunction], keys: [String:Type]) Never! {
    loop row in 0..<functions.len() {
        functions[row].signature = sema_registration_canonical_type(functions[row].signature, keys)
        sema_registration_canonical_symbol(&functions[row].symbol, keys)
        loop parameter in 0..<functions[row].parameters.len() {
            functions[row].parameters[parameter].ty = sema_registration_canonical_type(functions[row].parameters[parameter].ty, keys)
            sema_registration_canonical_symbol(&functions[row].parameters[parameter].symbol, keys)
        }
    }
}

fn sema_registration_canonical_symbol(symbol: &Symbol, keys: [String:Type]) Never! {
    if symbol.ty == .Val(ty) -> symbol.ty = Val(sema_registration_canonical_type(ty, keys))
}

fn sema_registration_canonical_type(ty: Type, keys: [String:Type]) -> Type Never! {
    names := [String]{}
    sema_registration_type_qualified_names(ty, &names)
    found := [String]{}
    actuals := [Type]{}
    loop name in names {
        resolved :: keys.get(name) ?? next
        &found.push(name)
        &actuals.push(resolved)
    }
    if found.len() == 0 -> return ty.copy()
    sema_registration_canonical_heads(sema_inference_substitute_type(ty, found, actuals), keys)
}

// `ty` with each alias-qualified generic head (`alias.Name<T>`, #6410)
// spelled by the key its `Named` spelling resolves to; the arguments are
// already canonical.
fn sema_registration_canonical_heads(ty: Type, keys: [String:Type]) -> Type Never! {
    if ty == {
        .List(inner) -> Type.List{element: sema_registration_canonical_heads(inner, keys)}
        // copy: `key_span` is a payload of read parameter `ty`; field `key_span` of the new Type.Map owns this one
        .Map(key, key_span, value) -> Type.Map{key: sema_registration_canonical_heads(key, keys), key_span: key_span.copy(), value: sema_registration_canonical_heads(value, keys)}
        .Shared(inner) -> Type.Shared{inner: sema_registration_canonical_heads(inner, keys)}
        .Option(inner) -> Type.Option{inner: sema_registration_canonical_heads(inner, keys)}
        .Result(ok, err) -> Type.Result{ok: sema_registration_canonical_heads(ok, keys), err: sema_registration_canonical_heads(err, keys)}
        .Fn(params, ret, effects, contract, metadata, provenance) -> {
            canonical :: loop param in params -> sema_registration_canonical_heads(param, keys)
            canonical_ret :: if ret == .Val(declared) -> Val(sema_registration_canonical_heads(declared, keys)) else -> None
            Type.Fn{params: canonical, ret: canonical_ret, effect_bound: effects, param_contract: contract, call_metadata: metadata, return_view_provenance: provenance}
        }
        .Apply(name, args) -> {
            canonical :: loop arg in args -> sema_registration_canonical_heads(arg, keys)
            head := name.copy()
            if keys.get(name) == .Val(resolved) {
                if resolved == .Named(key) -> head = key.copy()
            }
            Type.Apply{name: head, args: canonical}
        }
        .Tuple(fields) -> Type.Tuple{fields: loop field in fields -> TypeTupleField{name: field.name, ty: sema_registration_canonical_heads(field.ty, keys)}}
        // copy: `length` is a payload of read parameter `ty`; field `len` of the new Type.FixedList owns this one
        .FixedList(element, length) -> Type.FixedList{elem: sema_registration_canonical_heads(element, keys), len: length.copy()}
        .InlineRange(base, lo, hi) -> Type.InlineRange{base: sema_registration_canonical_heads(base, keys), lo: lo, hi: hi}
        // copy: `marker` is a payload of read parameter `ty`; field `marker` of the new Type.Tagged owns this one
        .Tagged(marker, inner) -> Type.Tagged{marker: marker.copy(), inner: sema_registration_canonical_heads(inner, keys)}
        .Union(members) -> Type.Union{members: loop member in members -> sema_registration_canonical_heads(member, keys)}
        // copy: `dimension` is a payload of read parameter `ty`; field `dimension` of the new Type.Quantity owns this one
        .Quantity(base, dimension) -> Type.Quantity{base: sema_registration_canonical_heads(base, keys), dimension: dimension.copy()}
        else -> ty
    }
}

// The alias-qualified type names in `ty`: `Named` types and generic heads
// (`alias.Name`, `alias.Name<T>`; a canonical key holds `::` and is already
// resolved).
fn sema_registration_type_qualified_names(ty: Type, names: &[String]) Never! {
    if ty == {
        .Named(name) -> sema_registration_push_qualified_name(name, &names)
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> sema_registration_type_qualified_names(inner, &names)
        .Map(key, _, value) -> {
            sema_registration_type_qualified_names(key, &names)
            sema_registration_type_qualified_names(value, &names)
        }
        .Result(ok, err) -> {
            sema_registration_type_qualified_names(ok, &names)
            sema_registration_type_qualified_names(err, &names)
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params -> sema_registration_type_qualified_names(param, &names)
            if ret == .Val(declared) -> sema_registration_type_qualified_names(declared, &names)
        }
        .Apply(name, args) -> {
            sema_registration_push_qualified_name(name, &names)
            loop arg in args -> sema_registration_type_qualified_names(arg, &names)
        }
        .Tuple(fields) -> loop field in fields -> sema_registration_type_qualified_names(field.ty, &names)
        .Union(members) -> loop member in members -> sema_registration_type_qualified_names(member, &names)
        else -> {}
    }
}

fn sema_registration_push_qualified_name(name: String, names: &[String]) Never! {
    if name.contains(".") && !name.contains("::") && !name.starts_with("type:") && !names.contains(name) -> &names.push(name)
}
