// Rust State.rs::checked_state_graphs: canonical erased metadata projection.
// Bundle collection stores only marker/state/member facts, never copies Func
// bodies or a flattened Item/registration graph for reflection or validation.
use jet_foundation.[Func, Item, NamedSpan, Span, StateTransition, StateNode, StateGraphTransition]

pub struct SemaStateGraphFact {
    pub type_name: String
    pub states: [StateNode]
    pub transitions: [StateGraphTransition]
}
struct SemaStateDeclarationFact {
    type_name: String
    states: [NamedSpan]
    span: Span
}
struct SemaStateMethodFact {
    name: String
    requires: NamedSpan?
    transition: StateTransition?
    span: Span
}
struct SemaStateMetadata {
    declarations: [String:SemaStateDeclarationFact]
    declaration_order: [String]
    methods: [String:[SemaStateMethodFact]]
    members: [String:[String:Bool]]
}
fn sema_state_metadata_new() -> SemaStateMetadata Never! {
    SemaStateMetadata{declarations: [String:SemaStateDeclarationFact]{}, declaration_order: [], methods: [String:[SemaStateMethodFact]]{}, members: [String:[String:Bool]]{}}
}
fn sema_state_metadata_methods(metadata: &SemaStateMetadata, owner: String, methods: [Func]) Never! {
    rows := &metadata.methods.remove(owner) ?? [SemaStateMethodFact]{}
    members := &metadata.members.remove(owner) ?? [String:Bool]{}
    loop method in methods {
        &rows.push(SemaStateMethodFact{name: method.name, requires: method.state_requires, transition: method.state_transition, span: method.span})
        members[method.name] = true
    }
    metadata.methods[owner] = rows
    metadata.members[owner] = members
}
fn sema_state_metadata_add_item(metadata: &SemaStateMetadata, item: Item) Never! {
    if item == {
        .Impl(value) -> sema_state_metadata_methods(&metadata, value.type_name, value.methods)
        .Struct(value) -> {
            if value.state == .Val(state) {
                if metadata.declarations.get(value.name) == None -> &metadata.declaration_order.push(value.name)
                metadata.declarations[value.name] = SemaStateDeclarationFact{type_name: value.name, states: state.states, span: state.span}
            }
            members := &metadata.members.remove(value.name) ?? [String:Bool]{}
            loop field in value.fields -> members[field.name] = true
            metadata.members[value.name] = members
            sema_state_metadata_methods(&metadata, value.name, value.methods)
            loop block in value.trait_impls -> sema_state_metadata_methods(&metadata, value.name, block.methods)
        }
        .Enum(value) -> sema_state_metadata_methods(&metadata, value.name, value.methods)
        else -> {}
    }
}
fn sema_state_metadata_add(metadata: &SemaStateMetadata, items: [Item]) Never! {
    loop item in items -> sema_state_metadata_add_item(&metadata, item)
}
fn sema_state_graph_leaf(owner: String, state: String) -> String? {
    if !state.contains(".") -> return Val(state)
    prefix :: "{owner}.State."
    if !state.starts_with(prefix) -> return None
    bytes :: state.bytes()
    leaf := String.from_bytes(bytes[prefix.bytes().len()..<bytes.len()]) ?? return None // #4303
    if leaf.contains(".") -> return None
    Val(leaf)
}
fn sema_state_graph_for_declaration(declaration: SemaStateDeclarationFact, methods: [SemaStateMethodFact]) -> SemaStateGraphFact Never! {
    state_names := [String:Bool]{}
    loop member in declaration.states -> state_names[member.name] = true
    outgoing := [String:Bool]{}
    edges := [String:[String]]{}
    transitions := [StateGraphTransition]{}
    entries := [String]{}
    loop method in methods {
        transition :: method.transition ?? next
        from := String?{None}
        if transition.from == .Val(raw) {
            leaf :: sema_state_graph_leaf(declaration.type_name, raw) ?? next
            if state_names.get(leaf) == None -> next
            from = Val(leaf)
        }
        to :: sema_state_graph_leaf(declaration.type_name, transition.to) ?? next
        if state_names.get(to) == None -> next
        if from == {
            .Val(name) -> {
                outgoing[name] = true
                next_states := &edges.remove(name) ?? [String]{}
                &next_states.push(to)
                edges[name] = next_states
            }
            .None -> &entries.push(to)
        }
        &transitions.push(StateGraphTransition{operation: method.name, from: from, to: to})
    }
    reachable := [String:Bool]{}
    queue := ~entries
    cursor := 0
    loop cursor < queue.len() {
        current :: queue[cursor]
        cursor += 1
        if reachable.get(current) != None -> next
        reachable[current] = true
        &queue.extend(edges.get(current) ?? [String]{})
    }
    nodes := [StateNode]{}
    loop member in declaration.states {
        &nodes.push(StateNode{name: member.name, terminal: outgoing.get(member.name) == None, reachable: if entries.len() == 0 -> None else -> Val(reachable.get(member.name) != None)})
    }
    SemaStateGraphFact{type_name: declaration.type_name, states: nodes, transitions: transitions}
}
// Prep precedes body checking and generated declarations may still arrive.
// Resolve the requested owner from the current complete registration bundle,
// not an owner-module slice or a not-yet-published checked registry.
fn sema_state_preparation_graph_fact(graph: SemaRegistrationGraph, owner: String) -> SemaStateGraphFact? {
    metadata := sema_state_metadata_new()
    loop module in graph.modules {
        loop item in module.program.items {
            if item == {
                .Struct(value) -> if value.name == owner -> sema_state_metadata_add_item(&metadata, item)
                .Impl(value) -> if value.type_name == owner -> sema_state_metadata_add_item(&metadata, item)
                .Enum(value) -> if value.name == owner -> sema_state_metadata_add_item(&metadata, item)
                else -> {}
            }
        }
    }
    declaration :: metadata.declarations.get(owner) ?? return None
    Val(sema_state_graph_for_declaration(declaration, metadata.methods.get(owner) ?? [SemaStateMethodFact]{}))
}
