// Package-authored templates (user `derive T.Name` providers, declared marker
// bodies and root `comptime loop` declarations) expand through the same typed
// template engine as the Prelude providers (Registration/Derives.jet). Generated
// items re-enter ordinary registration as written items; nothing is serialized
// or re-lexed. Rust: (user derives, marker bodies) and
// `expand_item_template_loops`.
use jet_foundation.[
    CallLabel,
    CtEnumArg,
    CtFloat,
    CtKey,
    ast_comptime_integer_key,
    CtMapEntry,
    CtReport,
    CtValue,
    DeriveBodyItem,
    DeriveDef,
    Diagnostic,
    Func,
    ImplConstValue,
    ImplDef,
    Item,
    LValue,
    Marker,
    MarkerCallArg,
    NamedCtValue,
    NamedType,
    Span,
    Stmt,
    StructDef,
    TAppliedRule,
    TAppliedRuleArgumentMenu,
    TAppliedRuleCatalog,
    TComptimeKey,
    TComptimeValue,
    TraitImplBlock,
    diagnostic_with_detail,
    expr_span,
]

SemaUserDeriveProvider: struct {
    module_index: Int
    definition: DeriveDef
}

// One member a generated method may collide with: its name, how the
// diagnostic names it, and where it is declared.
SemaUserMemberSite: struct {
    name: String
    site: String
    span: Span
}

// ---------------------------------------------------------------------------
// Reflection carrier. Reflection builds handles on the typed `TComptimeValue`
// carrier; the template engine reads the AST `CtValue` carrier. A value with
// no AST spelling (a character or closure) makes the handle unavailable.

sema_user_template_ct_key: fn(key: TComptimeKey) -> CtKey? Never! {
    if key == {
        .Int(number) -> Val(ast_comptime_integer_key(number))
        .BigInt(decimal) -> {
            number: Int.parse(decimal) ?? return None
            Val(ast_comptime_integer_key(number))
        }
        .String(text) -> Val(CtKey.Str{value: text})
        .Bool(flag) -> Val(CtKey.Bool{value: flag})
        .Enum(owner, variant) -> Val(CtKey.Enum{type_name: owner, variant: variant})
        else -> None
    }
}

sema_user_template_ct_values: fn(values: [TComptimeValue]) -> [CtValue]? Never! {
    converted := [CtValue]{}
    loop item in values {
        value: sema_user_template_ct_value(item) ?? return None
        converted.push(value)
    }
    Val(converted)
}

sema_user_template_ct_value: fn(value: TComptimeValue) -> CtValue? Never! {
    if value == {
        .Int(number) -> Val(CtValue.Int{value: number})
        .Float(number, bits) -> Val(CtValue.Float{value: if bits == 32 -> CtFloat.F32{value: number} else -> CtFloat.F64{value: number}})
        .Bool(flag) -> Val(CtValue.Bool{value: flag})
        .String(text) -> Val(CtValue.Str{value: text})
        .BigInt(decimal) -> Val(CtValue.BigInt{value: decimal})
        .Bytes(bytes) -> Val(CtValue.Bytes{value: bytes})
        .List(values) -> {
            converted: sema_user_template_ct_values(values) ?? return None
            Val(CtValue.List{values: converted})
        }
        .Map(entries) -> {
            converted := [CtMapEntry]{}
            loop entry in entries {
                key: sema_user_template_ct_key(entry.key) ?? return None
                item: sema_user_template_ct_value(entry.value) ?? return None
                converted.push(CtMapEntry{key: key, value: item})
            }
            Val(CtValue.Map{entries: converted})
        }
        .Struct(owner, fields) -> {
            converted := [NamedCtValue]{}
            loop field in fields {
                item: sema_user_template_ct_value(field.value) ?? return None
                converted.push(NamedCtValue{name: field.name, value: item})
            }
            Val(CtValue.Struct{type_name: owner, fields: converted})
        }
        .Enum(owner, variant, args) -> {
            converted := [CtEnumArg]{}
            loop arg in args {
                item: sema_user_template_ct_value(arg.value) ?? return None
                converted.push(CtEnumArg{label: arg.name, value: item})
            }
            Val(CtValue.Enum{type_name: owner, variant: variant, args: converted})
        }
        .Present(inner) -> {
            item: sema_user_template_ct_value(inner) ?? return None
            Val(CtValue.Present{value: item})
        }
        .Failed(report) -> if report == {
            .Clean(ty) -> Val(CtValue.Failed{report: CtReport.Clean{ty: ty}})
            .Told(inner) -> {
                item: sema_user_template_ct_value(inner) ?? return None
                Val(CtValue.Failed{report: CtReport.Told{value: item}})
            }
        }
        .Unit -> Val(CtValue.Unit)
        .Char(_) -> None
    }
}

sema_user_template_catalog: fn() -> TAppliedRuleCatalog Never! {
    TAppliedRuleCatalog{rows: [TAppliedRule]{}, argument_menus: [TAppliedRuleArgumentMenu]{}}
}

// The registered nominal's full reflection handle (Rust
// `build_struct_type_info_with_path_and_vocabulary_and_engine`).
sema_user_template_type_info: fn(graph: SemaRegistrationGraph, module_index: Int, owner: String) -> CtValue? {
    info: sema_comptime_reflection_type_info(graph, graph.modules[module_index].module_identity, owner, sema_user_template_catalog()) ?? return None
    sema_user_template_ct_value(info)
}

// Rust `build_function_type_info`: a function rule sees the target's stable
// source shape; program-wide effect facts stay a separate reflection input,
// so `effects` lists the declared row.
sema_user_template_function_info: fn(function: Func) -> CtValue? {
    effects := [TComptimeValue]{}
    if function.declared_effects == .Val(rows) {
        loop row in rows -> effects.push(TComptimeValue.String{value: row.name})
    }
    params := [TComptimeValue]{}
    loop param_index in 0..<function.params.len() -> params.push(TComptimeValue.String{value: function.params[param_index].name})
    info: sema_comptime_reflection_struct("FunctionInfo", [SemaComptimeReflectionField]{
        SemaComptimeReflectionField{name: "name", value: TComptimeValue.String{value: function.name}},
        SemaComptimeReflectionField{name: "module", value: TComptimeValue.String{value: ""}},
        SemaComptimeReflectionField{name: "identity", value: TComptimeValue.String{value: function.name}},
        SemaComptimeReflectionField{name: "failure_contract", value: sema_comptime_reflection_method_failure_type(function)},
        SemaComptimeReflectionField{name: "failure_source", value: TComptimeValue.String{value: sema_failure_contract_source(function.return_type)}},
        SemaComptimeReflectionField{name: "params", value: TComptimeValue.List{values: params}},
        SemaComptimeReflectionField{name: "span", value: sema_comptime_reflection_span(function.name_span)},
        SemaComptimeReflectionField{name: "effects", value: sema_comptime_reflection_struct("EffectInfo", [SemaComptimeReflectionField]{SemaComptimeReflectionField{name: "values", value: TComptimeValue.List{values: effects}}})},
        SemaComptimeReflectionField{name: "reaches_panic", value: TComptimeValue.Bool{value: false}},
        SemaComptimeReflectionField{name: "arithmetic", value: TComptimeValue.List{values: sema_comptime_reflection_arithmetic_facts(function.body)}},
        SemaComptimeReflectionField{name: "facts", value: TComptimeValue.List{values: sema_comptime_reflection_declared_function_facts(function, function.name)}},
    })
    sema_user_template_ct_value(info)
}

// ---------------------------------------------------------------------------
// Root `comptime loop` declarations (Rust `expand_item_template_loops`). They
// expand before registration in the module's known-time constant scope.

// Expands the root `comptime loop` items of `items` in place; a list without one
// is left untouched (not copied).
sema_derive_expand_template_loops: fn(items: &[Item], diagnostics: &[Diagnostic]) {
    has_loop: loop item in items {
        if item == .TemplateLoop(_) -> break true
    } ?? false
    if !has_loop -> return
    scope := [NamedCtValue]{}
    loop item in items {
        if item == .Const(definition) {
            value := definition.ct
            if value == None -> value = sema_derive_static_value(SemaDeriveExpansion{scope: scope, failure: None}, definition.value)
            known: value ?? next
            scope.push(NamedCtValue{name: definition.name, value: known})
        }
    }
    expanded := [Item]{}
    loop item in items {
        if item == .TemplateLoop(template) {
            body: [DeriveBodyItem]{DeriveBodyItem.Loop{var: template.var, var_span: template.var_span, source: template.source, body: template.body, span: template.span}}
            generated: sema_derive_expand_template_body(body, scope, diagnostics) ?? next
            loop generated_item in generated -> expanded.push(generated_item)
            next
        }
        expanded.push(item.copy())
    }
    items = expanded
}

// ---------------------------------------------------------------------------
// Registration of generated items: roots first, then impls, exactly like a
// prepared module, so a generated impl may extend a generated type.

sema_user_template_register: fn(graph: &SemaRegistrationGraph, module_index: Int, written: [Item], diagnostics: [Diagnostic]) {
    problems := diagnostics
    if written.len() > 0 {
        // Generated items take the written items' capability passes
        // (Items.jet module registration): selected Prelude derives and
        // codecs, then `Self` in impl signatures, so a generated `#Codable`
        // struct registers with its `impl T.Decode` like a written one.
        generated := written
        sema_derive_expand_builtin_items(generated, problems)
        sema_serde_expand_builtin_items(generated)
        sema_registration_expand_impl_self(generated)
        module_row := graph.modules[module_index]
        first_nominal: module_row.nominals.len()
        source_file: module_row.source_file.copy()
        source_origin: module_row.source_origin.copy()
        source_segments: module_row.source_segments.copy()
        loop item in generated {
            module_row.program.items.push(item.copy())
            if item == {
                .Impl(_) -> {}
                else -> {
                    _ := sema_registration_add_root(module_row, item, source_file, source_origin, source_segments, problems)
                }
            }
        }
        impl_rows: sema_registration_impl_rows(module_row)
        // The items move out of the row while sema_registration_add_impl
        // writes it, so they are read in place.
        items := module_row.program.items.move()
        module_row.program.items = [Item]{}
        loop item in generated -> sema_registration_add_impl(module_row, item, items, impl_rows, problems)
        module_row.program.items = items.move()
        graph.modules[module_index] = module_row
        sema_registration_index_nominal_rows(graph, module_index, first_nominal)
    }
    loop problem in problems -> sema_registration_push_graph_diagnostic(graph, module_index, problem)
}

// ---------------------------------------------------------------------------
// User derives. A struct requesting `#Name` expands the
// `derive T.Name` provider preferring the entry module, then the target's
// own module. The orphan law (E2711) requires the provider or the target to
// be entry-local. Generated functions become ordinary members of the target;
// other generated items join the target's module.

sema_user_derive_member_sites: fn(items: [Item], owner: String) -> [SemaUserMemberSite] {
    sites := [SemaUserMemberSite]{}
    loop item in items {
        if item == {
            .Struct(candidate) -> {
                if candidate.name == owner {
                    loop method in candidate.methods -> sites.push(SemaUserMemberSite{name: method.name, site: "existing method `{owner}.{method.name}`", span: method.name_span})
                }
            }
            .Impl(candidate) -> {
                if candidate.type_name == owner {
                    loop method in candidate.methods -> sites.push(SemaUserMemberSite{name: method.name, site: "existing method `{owner}.{method.name}`", span: method.name_span})
                }
            }
            else -> {}
        }
    }
    sites
}

// The latest site recorded for `name` (Rust keeps one map entry per name;
// a later declaration replaces an earlier one).
sema_user_member_site: fn(sites: [SemaUserMemberSite], name: String) -> SemaUserMemberSite? Never! {
    index := sites.len() - 1
    loop index >= 0 {
        if sites[index].name == name -> return Val(sites[index])
        index -= 1
    }
    None
}

sema_user_derive_collision: fn(derive_name: String, owner: String, method: Func, site: SemaUserMemberSite) -> Diagnostic {
    diagnostic: sema_error("E0105", method.name_span, "generated method `{method.name}` from `derive T.{derive_name}` collides with {site.site}", "`derive T.{derive_name}` and {site.site} both define a member named `{method.name}` on `{owner}`", "rename the generated member in `derive T.{derive_name}`, or rename the colliding member")
    diagnostic_with_detail(diagnostic, "generated member `{method.name}` from `derive T.{derive_name}` at span {method.name_span.start}..{method.name_span.end}\n{site.site} at span {site.span.start}..{site.span.end}")
}

sema_user_derive_provider: fn(providers: [SemaUserDeriveProvider], name: String, module_index: Int, entry_index: Int) -> SemaUserDeriveProvider? Never! {
    chosen := SemaUserDeriveProvider?{None}
    rank := 3
    loop candidate in providers {
        if candidate.definition.trait_name != name -> next
        candidate_rank: if candidate.module_index == entry_index -> 0 else -> if candidate.module_index == module_index -> 1 else -> 2
        if candidate_rank < rank {
            chosen = Val(candidate)
            rank = candidate_rank
        }
    }
    chosen
}

sema_user_derive_expand_struct: fn(graph: SemaRegistrationGraph, module_index: Int, items: [Item], definition: StructDef, providers: [SemaUserDeriveProvider], entry_index: Int, generated: &[Item], diagnostics: &[Diagnostic]) {
    sites: sema_user_derive_member_sites(items, definition.name)
    generated_sites := [SemaUserMemberSite]{}
    type_info := CtValue?{None}
    loop requested in definition.derives {
        provider: sema_user_derive_provider(providers, requested.name, module_index, entry_index) ?? next
        if module_index != entry_index && provider.module_index != entry_index {
            // The violating marker belongs to an imported source file, so the
            // diagnostic carries no entry-file caret.
            diagnostics.push(sema_error_optional("E2711", None, "derive orphan rule: neither `derive T.{requested.name}` nor `{definition.name}` is local", "a generated implementation is owned locally only when the derive provider or target type lives in the entry module", "define `derive T.{requested.name}` or `{definition.name}` in the entry module"))
            next
        }
        if type_info == None -> type_info = sema_user_template_type_info(graph, module_index, definition.name)
        info: type_info ?? next
        expanded: sema_derive_expand_provider_body(provider.definition.body, provider.definition.type_param, info, diagnostics) ?? next
        methods := [Func]{}
        loop expanded_item in expanded {
            if expanded_item == {
                .Func(function) -> {
                    existing: sema_user_member_site(sites, function.name)
                    if existing == .Val(site) {
                        diagnostics.push(sema_user_derive_collision(requested.name, definition.name, function, site))
                        next
                    }
                    prior: sema_user_member_site(generated_sites, function.name)
                    if prior == .Val(site) {
                        diagnostics.push(sema_user_derive_collision(requested.name, definition.name, function, site))
                        next
                    }
                    generated_sites.push(SemaUserMemberSite{name: function.name, site: "generated member `{function.name}` from `derive T.{requested.name}`", span: function.name_span})
                    methods.push(function)
                }
                else -> generated.push(expanded_item)
            }
        }
        // The provider name selects the derive; its body supplies ordinary
        // members on the target, not a trait conformance.
        if methods.len() > 0 {
            generated.push(Item.Impl{value: ImplDef{span: definition.span, type_name: definition.name, type_span: definition.name_span, trait_name: None, trait_span: None, operator_rhs: None, operator_marker: None, methods: methods, delegation_field: None, assoc_type_impls: [NamedType]{}, constants: [ImplConstValue]{}, is_generated_serde: false, os_target: None}})
        }
    }
}

sema_user_derive_collect_module: fn(graph: SemaRegistrationGraph, module_index: Int, providers: [SemaUserDeriveProvider], entry_index: Int, generated: &[Item], diagnostics: &[Diagnostic]) {
    items: graph.modules[module_index].program.items
    loop item in items {
        if item == .Struct(definition) -> sema_user_derive_expand_struct(graph, module_index, items, definition, providers, entry_index, generated, diagnostics)
    }
}

sema_user_derive_expand_module: fn(graph: &SemaRegistrationGraph, module_index: Int, providers: [SemaUserDeriveProvider], entry_index: Int) {
    generated := [Item]{}
    diagnostics := [Diagnostic]{}
    sema_user_derive_collect_module(graph, module_index, providers, entry_index, generated, diagnostics)
    sema_user_template_register(graph, module_index, generated, diagnostics)
}

// ---------------------------------------------------------------------------
// Declared marker bodies. `target` is the struct's TypeInfo
// or the function's FunctionInfo. A generated impl may add members but never
// change or shadow a written (or earlier generated) member.

// A marker application's rule body, with the `Diagnostic` impls of the rule's
// declaring module that its `reject(value)` may raise.
SemaUserRule: struct {
    body: [DeriveBodyItem]
    reports: [SemaDeriveReport]
}

sema_user_rule_body: fn(graph: SemaRegistrationGraph, module_identity: String, marker: Marker) -> SemaUserRule? {
    resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
    declaration: resolved.declaration ?? return None
    body: declaration.body ?? return None
    reports := [SemaDeriveReport]{}
    if sema_registration_module_index(graph, resolved.declaring_module_identity) == .Val(index) {
        module_name: graph.modules[index].module_name
        loop item in graph.modules[index].program.items {
            if item == {
                .Impl(definition) -> {
                    if definition.trait_name == .Val(trait_name) {
                        if trait_name == "Diagnostic" -> reports.push(SemaDeriveReport{module_name: module_name, definition: definition})
                    }
                }
                .Struct(definition) -> sema_user_rule_nested_reports(module_name, definition.name, definition.name_span, definition.trait_impls, reports)
                .Enum(definition) -> sema_user_rule_nested_reports(module_name, definition.name, definition.name_span, definition.trait_impls, reports)
                else -> {}
            }
        }
    }
    Val(SemaUserRule{body: body, reports: reports})
}

// A struct's or enum's `impl Diagnostic { … }` written inside its body is the
// same report as a top-level `impl Name.Diagnostic { … }`.
sema_user_rule_nested_reports: fn(module_name: String, owner: String, owner_span: Span, blocks: [TraitImplBlock], reports: &[SemaDeriveReport]) Never! {
    loop block in blocks {
        if block.trait_name != "Diagnostic" -> next
        definition: ImplDef{
            span: block.span ?? owner_span, type_name: owner.copy(), type_span: owner_span,
            trait_name: Val(block.trait_name), trait_span: Val(block.trait_span),
            operator_rhs: block.operator_rhs, operator_marker: block.operator_marker,
            methods: block.methods, delegation_field: block.delegation_field,
            assoc_type_impls: block.assoc_type_impls, constants: block.constants,
            is_generated_serde: false, os_target: block.os_target, markers: block.markers,
        }
        reports.push(SemaDeriveReport{module_name: module_name.copy(), definition: definition})
    }
}

sema_user_rule_existing_span: fn(items: [Item], owner: String, member: String) -> Span? Never! {
    loop item in items {
        if item == {
            .Struct(definition) -> {
                if definition.name == owner {
                    loop field in definition.fields {
                        if field.name == member -> return Val(field.name_span)
                    }
                    loop method in definition.methods {
                        if method.name == member -> return Val(method.name_span)
                    }
                }
            }
            .Enum(definition) -> {
                if definition.name == owner {
                    loop method in definition.methods {
                        if method.name == member -> return Val(method.name_span)
                    }
                }
            }
            .Impl(definition) -> {
                if definition.type_name == owner {
                    loop method in definition.methods {
                        if method.name == member -> return Val(method.name_span)
                    }
                }
            }
            else -> {}
        }
    }
    None
}

sema_user_rule_accept: fn(items: [Item], rule: String, expanded: [Item], generated: &[Item], diagnostics: &[Diagnostic]) {
    loop expanded_item in expanded {
        if expanded_item == {
            .Impl(implementation) -> {
                methods := [Func]{}
                loop method in implementation.methods {
                    existing := sema_user_rule_existing_span(items, implementation.type_name, method.name)
                    if existing == None -> existing = sema_user_rule_existing_span(generated, implementation.type_name, method.name)
                    if existing == .Val(span) {
                        diagnostic: sema_error("E0105", method.name_span, "generated member `{method.name}` would change or shadow `{method.name}` on `{implementation.type_name}`", "a rule may add a member but cannot change or shadow a written member", "rename the generated member or remove the existing member")
                        diagnostics.push(diagnostic_with_detail(diagnostic, "generated member `{method.name}` from rule `{rule}` at span {method.name_span.start}..{method.name_span.end}\nexisting member `{implementation.type_name}.{method.name}` at span {span.start}..{span.end}"))
                        next
                    }
                    methods.push(method.copy())
                }
                if methods.len() > 0 {
                    accepted := implementation
                    accepted.methods = methods
                    generated.push(Item.Impl{value: accepted})
                }
            }
            else -> generated.push(expanded_item.copy())
        }
    }
}

sema_user_rule_collect_module: fn(graph: SemaRegistrationGraph, module_index: Int, generated: &[Item], diagnostics: &[Diagnostic]) {
    items: graph.modules[module_index].program.items
    loop item in items {
        if item == .Struct(definition) {
            type_info := CtValue?{None}
            loop marker in definition.type_markers {
                if marker.negated -> next
                rule: sema_user_rule_body(graph, graph.modules[module_index].module_identity, marker) ?? next
                if type_info == None -> type_info = sema_user_template_type_info(graph, module_index, definition.name)
                info: type_info ?? next
                expanded: sema_derive_expand_rule_body(rule.body, "target", info, rule.reports, Val(marker.span), diagnostics) ?? next
                sema_user_rule_accept(items, marker.name, expanded, generated, diagnostics)
            }
        }
    }
    // Function-site rules see a FunctionInfo and may emit any top-level item.
    loop item in items {
        if item == .Func(function) {
            loop marker in function.markers {
                if marker.negated -> next
                rule: sema_user_rule_body(graph, graph.modules[module_index].module_identity, marker) ?? next
                info: sema_user_template_function_info(function) ?? next
                expanded: sema_derive_expand_rule_body(rule.body, "target", info, rule.reports, Val(marker.span), diagnostics) ?? next
                loop expanded_item in expanded -> generated.push(expanded_item)
            }
        }
    }
    // A `.Block` rule receives the text inside Jet's closed braces as its
    // `target` value. The rule body can check that text and emit ordinary Jet
    // items through the same typed path as a type or function rule (declared
    // text blocks).
    source: graph.modules[module_index].source
    block_spans: graph.modules[module_index].program.block_spans
    blocks := [SemaUserTextBlock]{}
    loop item in items -> sema_user_text_blocks_in_item(item, source, block_spans, blocks)
    loop block in blocks {
        marker: Marker{name: block.name, negated: false, name_span: block.span, args: [MarkerCallArg]{}, arg_labels: [CallLabel?]{}, span: block.span, ct: None}
        rule: sema_user_rule_body(graph, graph.modules[module_index].module_identity, marker) ?? next
        expanded: sema_derive_expand_rule_body(rule.body, "target", CtValue.Str{value: block.text}, rule.reports, Val(block.site), diagnostics) ?? next
        loop expanded_item in expanded -> generated.push(expanded_item)
    }
}

// ---------------------------------------------------------------------------
// Declared text blocks (`block_source`, `collect_declared_text_blocks`,
// `collect_item_declared_text_blocks`).

// `span` covers the whole block, `site` its `#Name` use site, where a
// rejection reports.
SemaUserTextBlock: struct {
    name: String
    text: String
    span: Span
    site: Span
}

// Rust `LValue::span`.
sema_user_text_lvalue_span: fn(target: LValue) -> Span Never! {
    if target == {
        .Local(_, span) | .Index(_, _, span, _) | .Field(_, _, span) -> span
    }
}

// Rust `Stmt::span`.
sema_user_text_stmt_span: fn(statement: Stmt) -> Span Never! {
    if statement == {
        .Expr(value) -> expr_span(value)
        .Val(binding) -> binding.name_span
        .Assign(target, _, _, _) -> sema_user_text_lvalue_span(target)
        else -> sema_compiler_index_stmt_span(statement)
    }
}

// The text inside the block's braces: the widest recorded block inside the
// statement that covers every body statement (the last of equal widths), or
// for an empty body the first recorded block inside it.
sema_user_text_block_source: fn(source: String, body: [Stmt], block_spans: [Span], outer: Span) -> String Never! {
    chosen := Span?{None}
    if body.len() > 0 {
        first: sema_user_text_stmt_span(body[0]).start
        last: sema_user_text_stmt_span(body[body.len() - 1]).end
        width := -1
        loop span in block_spans {
            if span.start > outer.start && span.end < outer.end && span.start <= first && span.end >= last {
                candidate: if span.end > span.start -> span.end - span.start else -> 0
                if candidate >= width {
                    width = candidate
                    chosen = Val(span)
                }
            }
        }
    } else {
        loop span in block_spans {
            if span.start > outer.start && span.end < outer.end {
                if chosen == .Val(best) {
                    if span.start < best.start -> chosen = Val(span)
                } else {
                    chosen = Val(span)
                }
            }
        }
    }
    span: chosen ?? return ""
    bytes: source.bytes()
    if span.start < 0 || span.end < span.start || span.end > bytes.len() -> return ""
    String.from_bytes(bytes[span.start..<span.end]) ?? ""
}

// Rust `ScopeMembers::statement_bodies`.
sema_user_text_statement_bodies: fn(statement: Stmt) -> [[Stmt]] Never! {
    if statement == {
        .Switch(_, arms, else_body, _) | .ComptimeSwitch(_, arms, else_body, _) -> {
            bodies := [[Stmt]]{}
            loop arm in arms -> bodies.push(arm.body)
            if else_body == .Val(body) -> bodies.push(body.copy())
            bodies
        }
        .ComptimeIf(_, _, then_body, else_body, _, _) -> {
            bodies := [[Stmt]]{then_body}
            if else_body == .Val(body) -> bodies.push(body.copy())
            bodies
        }
        .While(_, body, _, _, _) | .For(_, _, _, _, body, _, _, _, _) | .Loop(body, _, _, _) | .CountedLoop(_, _, _, body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .ContextBlock(_, body, _) | .Live(body, _) | .AssumeDet(_, _, body, _) | .Transact(_, _, body, _, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> [[Stmt]]{body}
        else -> [[Stmt]]{}
    }
}

sema_user_text_blocks_in: fn(statements: [Stmt], source: String, block_spans: [Span], blocks: &[SemaUserTextBlock]) {
    loop statement in statements {
        if statement == .ScopeMember(name, name_span, _, _, body, dsl, hash_span, span) {
            if dsl -> blocks.push(SemaUserTextBlock{name: name, text: sema_user_text_block_source(source, body, block_spans, span), span: span, site: Span{start: hash_span.start, end: name_span.end}})
        }
        loop child in sema_user_text_statement_bodies(statement) -> sema_user_text_blocks_in(child, source, block_spans, blocks)
    }
}

sema_user_text_blocks_in_methods: fn(methods: [Func], source: String, block_spans: [Span], blocks: &[SemaUserTextBlock]) {
    loop method in methods -> sema_user_text_blocks_in(method.body, source, block_spans, blocks)
}

sema_user_text_blocks_in_item: fn(item: Item, source: String, block_spans: [Span], blocks: &[SemaUserTextBlock]) {
    if item == {
        .Func(function) -> sema_user_text_blocks_in(function.body, source, block_spans, blocks)
        .Test(test) -> sema_user_text_blocks_in(test.body, source, block_spans, blocks)
        .Impl(implementation) -> sema_user_text_blocks_in_methods(implementation.methods, source, block_spans, blocks)
        .Struct(definition) -> {
            sema_user_text_blocks_in_methods(definition.methods, source, block_spans, blocks)
            loop implementation in definition.trait_impls -> sema_user_text_blocks_in_methods(implementation.methods, source, block_spans, blocks)
        }
        .Enum(definition) -> {
            sema_user_text_blocks_in_methods(definition.methods, source, block_spans, blocks)
            loop implementation in definition.trait_impls -> sema_user_text_blocks_in_methods(implementation.methods, source, block_spans, blocks)
        }
        .CodeModule(code_module) -> {
            if code_module.body == .Val(body) {
                loop nested in body -> sema_user_text_blocks_in_item(nested, source, block_spans, blocks)
            }
        }
        else -> {}
    }
}

sema_user_rule_expand_module: fn(graph: &SemaRegistrationGraph, module_index: Int) {
    generated := [Item]{}
    diagnostics := [Diagnostic]{}
    sema_user_rule_collect_module(graph, module_index, generated, diagnostics)
    sema_user_template_register(graph, module_index, generated, diagnostics)
}

// ---------------------------------------------------------------------------
// Graph pass. Runs once the declaration graph is complete, so reflection sees
// every registered declaration; generated items register into the target's
// module before any body is checked.

sema_registration_expand_user_templates: fn(graph: &SemaRegistrationGraph) {
    if !graph.complete -> return
    providers := [SemaUserDeriveProvider]{}
    has_any_rule_body := false
    loop (module_index, module_row) in graph.modules {
        loop item in module_row.program.items {
            if item == .UserDerive(definition) -> providers.push(SemaUserDeriveProvider{module_index: module_index, definition: definition})
        }
        loop declaration in sema_marker_module_declarations(module_row.program.items, "", false) {
            if declaration.body != None -> has_any_rule_body = true
        }
    }
    if providers.len() == 0 && !has_any_rule_body -> return
    entry_index: sema_registration_module_index(graph, graph.entry_module_identity) ?? -1
    loop module_index in 0..<graph.modules.len() {
        if providers.len() > 0 -> sema_user_derive_expand_module(graph, module_index, providers, entry_index)
        if has_any_rule_body -> sema_user_rule_expand_module(graph, module_index)
    }
    // A rule's warning-severity `reject` reports without failing the graph.
    graph.complete = !sema_registration_blocking_error(graph.diagnostics)
}
