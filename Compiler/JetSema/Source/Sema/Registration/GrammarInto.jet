// The parse into a sink a grammar declares (GrammarItems.jet). Each parser
// rule's type gets `parse_into(text, sink) -> Int GrammarError!`, run by a
// private function per parser rule. That function walks the rule body as
// the parser does (GrammarParse.jet), deciding by the same plan decisions,
// but builds no value: it sends the sink `open(rule)` and `close(rule)`
// around the rule and each token as it is taken, the skipped tokens before
// it first (core.grammar.runtime `into_token`), so nothing is allocated per
// token. An operator rule opens once for each level it is parsed at: its
// primary, then each tail, which applies to everything before it in that
// rule; an operand that binds tighter is a rule of its own inside. The
// returned offset is the end of the last token taken, so a grammar whose
// start rule does not end at EOF parses a prefix.
use {
    jet_foundation.[
        AST_NODE_GENERATED,
        AccessConvention,
        BinOp,
        Expr,
        Func,
        Item,
        Param,
        Span,
        Stmt,
        SwitchArm,
        Type,
        TypeParam,
    ]
}

// The sink parameter of the generated functions and its type parameter.
SEMA_GRAMMAR_SINK: "__jet_sink"

SEMA_GRAMMAR_SINK_TYPE: "__JetSink"

// The sink function of rule `rule`.
sema_grammar_into_function: fn(gen: SemaGrammarGen, plan: SemaGrammarItemsPlan, rule: Int) -> String Never! {
    "__jet_grammar_{gen.start}_{plan.rules[rule].name}_into"
}

// The sink function of operator rule `rule` that parses at a level.
sema_grammar_into_level_function: fn(gen: SemaGrammarGen, plan: SemaGrammarItemsPlan, rule: Int) -> String Never! {
    "__jet_grammar_{gen.start}_{plan.rules[rule].name}_into_at"
}

// `<__JetSink: GrammarSink>`.
sema_grammar_into_type_params: fn(span: Span) -> [TypeParam] Never! {
    [TypeParam]{TypeParam{name: SEMA_GRAMMAR_SINK_TYPE, name_span: span, bounds: [String]{"{sema_grammar_alias(SEMA_GRAMMAR_SINK_MODULE)}.GrammarSink"}, prep: None}}
}

// `^name: __JetSink`.
sema_grammar_into_sink_param: fn(name: String, span: Span) -> Param Never! {
    ^param: sema_serde_items_param(name, Type.Named{name: SEMA_GRAMMAR_SINK_TYPE}, span)
    param.convention = AccessConvention.Write
    param
}

// `return false`.
sema_grammar_into_refuse: fn(span: Span) -> Stmt Never! {
    sema_serde_items_return(sema_grammar_flag(false, span), span)
}

// `if !taken -> return false`.
sema_grammar_into_check: fn(taken: Expr, span: Span) -> Stmt Never! {
    sema_serde_items_if(sema_serde_items_not(taken, span), [Stmt]{sema_grammar_into_refuse(span)}, span)
}

// `function(cursor, scanner, args…, sink)`.
sema_grammar_into_call: fn(function: String, args: ^^[Expr], span: Span) -> Expr Never! {
    ^all: [Expr]{sema_serde_items_ident(SEMA_GRAMMAR_CURSOR, span), sema_serde_items_ident(SEMA_GRAMMAR_SCANNER, span)}
    loop arg in args.move() -> all.push(arg)
    all.push(sema_serde_items_ident(SEMA_GRAMMAR_SINK, span))
    sema_serde_items_free_call(function, all, span)
}

// `sink.event(rule)`.
sema_grammar_into_event: fn(event: String, rule: Int, span: Span) -> Stmt Never! {
    Stmt.Expr{expr: sema_serde_items_method_call(sema_serde_items_ident(SEMA_GRAMMAR_SINK, span), event, [Expr]{sema_grammar_number(rule, span)}, span)}
}

// `if name < 0 -> return false`.
sema_grammar_into_failed: fn(name: String, span: Span) -> Stmt Never! {
    sema_serde_items_if(sema_grammar_compare(.Lt, sema_serde_items_ident(name, span), sema_grammar_number(0, span), span), [Stmt]{sema_grammar_into_refuse(span)}, span)
}

// `if { name == 0 -> arms[0] … else -> return false }`.
sema_grammar_into_branches: fn(name: String, arms: ^^[[Stmt]], span: Span) -> Stmt Never! {
    ^switch_arms: [SwitchArm]{}
    loop (i, arm) in arms.move() {
        switch_arms.push(SwitchArm{cond: sema_grammar_compare(.Eq, sema_serde_items_ident(name, span), sema_grammar_number(i, span), span), body: arm, span: span})
    }
    Stmt.Switch{subject: sema_grammar_flag(true, span), arms: switch_arms, else_body: Val([Stmt]{sema_grammar_into_refuse(span)}), span: span}
}

// `if !cursor_enter(cursor) -> return false`: the depth bound.
sema_grammar_into_enter: fn(span: Span) -> Stmt Never! {
    sema_grammar_into_check(sema_grammar_core_call(SEMA_GRAMMAR_RUNTIME_MODULE, "cursor_enter", [Expr]{sema_serde_items_ident(SEMA_GRAMMAR_CURSOR, span)}, span), span)
}

// Takes token kind `kind` into the sink.
sema_grammar_into_token: fn(kind: Int, span: Span) -> Stmt Never! {
    args: [Expr]{sema_serde_items_ident(SEMA_GRAMMAR_CURSOR, span), sema_serde_items_ident(SEMA_GRAMMAR_SCANNER, span), sema_grammar_number(kind, span), sema_serde_items_ident(SEMA_GRAMMAR_SINK, span)}
    sema_grammar_into_check(sema_grammar_core_call(SEMA_GRAMMAR_RUNTIME_MODULE, "into_token", args, span), span)
}

// Parses element `n` into the sink.
sema_grammar_into_element: fn(gen: SemaGrammarGen, plan: SemaGrammarItemsPlan, n: Int, body: ^[Stmt]) Never! {
    span: gen.span
    node: plan.nodes[n]
    branch: "__jet_branch_{n}"
    if node.kind == {
        "Alt" -> loop child in node.children -> sema_grammar_into_element(gen, plan, child, body)
        "Choice" -> {
            if node.children.len() == 1 {
                sema_grammar_into_element(gen, plan, node.children[0], body)
                return
            }
            body.push(sema_grammar_decide(branch, plan.decision_of[n], span))
            ^arms: [[Stmt]]{}
            loop alt in node.children {
                ^arm: [Stmt]{}
                sema_grammar_into_element(gen, plan, alt, arm)
                arms.push(arm)
            }
            body.push(sema_grammar_into_branches(branch, arms.move(), span))
        }
        "Optional" -> {
            body.push(sema_grammar_decide(branch, plan.decision_of[n], span))
            body.push(sema_grammar_into_failed(branch, span))
            ^taken: [Stmt]{}
            sema_grammar_into_element(gen, plan, node.children[0], taken)
            body.push(sema_grammar_when(branch, 0, taken, span))
        }
        "Star" -> {
            ^repeat: [Stmt]{sema_grammar_decide(branch, plan.decision_of[n], span), sema_grammar_into_failed(branch, span), sema_grammar_when(branch, 1, [Stmt]{Stmt.Break{span: span}}, span)}
            sema_grammar_into_element(gen, plan, node.children[0], repeat)
            body.push(Stmt.Loop{body: repeat, span: span, arrow_body: false, label: None})
        }
        "Plus" -> {
            ^repeat: [Stmt]{}
            sema_grammar_into_element(gen, plan, node.children[0], repeat)
            repeat.push(sema_grammar_decide(branch, plan.decision_of[n], span))
            repeat.push(sema_grammar_into_failed(branch, span))
            repeat.push(sema_grammar_when(branch, 1, [Stmt]{Stmt.Break{span: span}}, span))
            body.push(Stmt.Loop{body: repeat, span: span, arrow_body: false, label: None})
        }
        "Ref" -> {
            if node.token >= 0 {
                body.push(sema_grammar_into_token(node.token, span))
                return
            }
            body.push(sema_grammar_into_check(sema_grammar_into_call(sema_grammar_into_function(gen, plan, node.rule), [Expr]{}, span), span))
        }
        "Literal" -> body.push(sema_grammar_into_token(node.token, span))
        "Hole" -> body.push(sema_grammar_into_token(node.token, span))
        "End" -> body.push(sema_grammar_into_token(node.token, span))
        // A class or `.` is a token rule's alone: no parser rule holds one.
        else -> {}
    }
}

// Parses the elements of alternative `alt` from element `from` on. An
// element `operands` gives a level (an operator rule's operand) parses at
// that level.
sema_grammar_into_alt: fn(gen: SemaGrammarGen, plan: SemaGrammarItemsPlan, rule: Int, alt: Int, operands: [Int], from: Int, body: ^[Stmt]) Never! {
    span: gen.span
    kids: plan.nodes[alt].children
    loop k in from..<kids.len() {
        if k < operands.len() && operands[k] >= 0 {
            body.push(sema_grammar_into_check(sema_grammar_into_call(sema_grammar_into_level_function(gen, plan, rule), [Expr]{sema_grammar_number(operands[k], span)}, span), span))
            next
        }
        sema_grammar_into_element(gen, plan, kids[k], body)
    }
}

// Ends a rule's sink function: leaves the rule, closes it, and returns
// true.
sema_grammar_into_finish: fn(rule: Int, body: ^[Stmt], span: Span) Never! {
    body.push(sema_grammar_leave(span))
    body.push(sema_grammar_into_event("close", rule, span))
    body.push(sema_serde_items_return(sema_grammar_flag(true, span), span))
}

// A generated generic function over the sink, private to the module.
sema_grammar_into_free_function: fn(name: String, params: [Param], body: ^^[Stmt], span: Span) -> Item Never! {
    ^function: sema_serde_items_method(name, sema_grammar_into_type_params(span), params, Type.Bool, span)
    function.body = body.move()
    Item.Func{value: function}
}

// An operator rule's level function: a primary, then each tail whose
// operator binds at least as tightly as `__jet_level`.
sema_grammar_into_operator_body: fn(gen: SemaGrammarGen, plan: SemaGrammarItemsPlan, rule: Int, op_rule: SemaGrammarOperatorRule) -> [Stmt] Never! {
    span: gen.span
    ^body: [Stmt]{sema_grammar_into_enter(span), sema_grammar_into_event("open", rule, span)}
    primary: plan.nodes[op_rule.primary]
    ^primary_arms: [[Stmt]]{}
    single_primary: primary.children.len() == 1
    loop alt in primary.children {
        ^operands: [Int]{}
        loop op in op_rule.operators {
            if op.alt == alt -> operands = op.operands.copy()
        }
        ^arm: [Stmt]{}
        if single_primary -> sema_grammar_into_alt(gen, plan, rule, alt, operands, 0, body) else -> sema_grammar_into_alt(gen, plan, rule, alt, operands, 0, arm)
        primary_arms.push(arm)
    }
    if !single_primary {
        body.push(sema_grammar_decide("__jet_branch", plan.decision_of[op_rule.primary], span))
        body.push(sema_grammar_into_branches("__jet_branch", primary_arms.move(), span))
    }
    more: "__jet_more"
    ^repeat: [Stmt]{sema_grammar_decide(more, plan.decision_of[op_rule.repeat], span)}
    repeat.push(sema_serde_items_if(sema_grammar_compare(.Ne, sema_serde_items_ident(more, span), sema_grammar_number(0, span), span), [Stmt]{Stmt.Break{span: span}}, span))
    tails_node: plan.nodes[op_rule.repeat].children[0]
    single_tail: plan.nodes[tails_node].children.len() == 1
    ^tail_arms: [[Stmt]]{}
    loop tail in plan.nodes[tails_node].children {
        ^arm: [Stmt]{}
        loop op in op_rule.operators {
            if op.tail != tail -> next
            looser: sema_grammar_compare(.Lt, sema_grammar_number(op.level, span), sema_serde_items_ident(SEMA_GRAMMAR_LEVEL, span), span)
            stop: sema_serde_items_if(looser, [Stmt]{Stmt.Break{span: span}}, span)
            if single_tail {
                repeat.push(stop)
                sema_grammar_into_alt(gen, plan, rule, op.alt, op.operands, 1, repeat)
            } else {
                arm.push(stop)
                sema_grammar_into_alt(gen, plan, rule, op.alt, op.operands, 1, arm)
            }
        }
        tail_arms.push(arm)
    }
    if !single_tail {
        repeat.push(sema_grammar_decide("__jet_tail", plan.decision_of[tails_node], span))
        repeat.push(sema_grammar_into_branches("__jet_tail", tail_arms.move(), span))
    }
    body.push(Stmt.Loop{body: repeat, span: span, arrow_body: false, label: None})
    sema_grammar_into_finish(rule, body, span)
    body
}

// The sink function of rule `shape.rule`, with the operator rule's level
// function when it is one. Rule r's function sits at `4 * rules + r` and
// its level function at `5 * rules + r`, past the parse and print
// functions' spans.
sema_grammar_into_functions: fn(gen: SemaGrammarGen, plan: SemaGrammarItemsPlan, shape: SemaGrammarShape, items: ^[Item]) Never! {
    span: gen.span
    r: shape.rule
    rules: plan.rules.len()
    params: [Param]{sema_grammar_cursor_param(span), sema_grammar_scanner_param(span), sema_grammar_into_sink_param(SEMA_GRAMMAR_SINK, span)}
    loop op_rule in plan.operators {
        if op_rule.rule != r || !shape.is_enum -> next
        ^body: [Stmt]{sema_serde_items_return(sema_grammar_into_call(sema_grammar_into_level_function(gen, plan, r), [Expr]{sema_grammar_number(0, span)}, span), span)}
        items.push(sema_grammar_into_free_function(sema_grammar_into_function(gen, plan, r), params.copy(), body.move(), sema_grammar_span_at(gen, 4 * rules + r)))
        ^level_params: params.copy()
        level_params.push(sema_serde_items_param(SEMA_GRAMMAR_LEVEL, Type.Int, span))
        ^level_body: sema_grammar_into_operator_body(gen, plan, r, op_rule)
        items.push(sema_grammar_into_free_function(sema_grammar_into_level_function(gen, plan, r), level_params, level_body.move(), sema_grammar_span_at(gen, 5 * rules + r)))
        return
    }
    ^body: [Stmt]{sema_grammar_into_enter(span), sema_grammar_into_event("open", r, span)}
    sema_grammar_into_element(gen, plan, plan.rules[r].body, body)
    sema_grammar_into_finish(r, body, span)
    items.push(sema_grammar_into_free_function(sema_grammar_into_function(gen, plan, r), params, body.move(), sema_grammar_span_at(gen, 4 * rules + r)))
}

// `parse_into<S: GrammarSink>(text, ^sink: S) -> Int GrammarError!` of rule
// `shape.rule`'s type: its sink function from the start of `text`, then the
// end of the last token taken or the first error.
sema_grammar_into_method: fn(gen: SemaGrammarGen, plan: SemaGrammarItemsPlan, shape: SemaGrammarShape, is_pub: Bool, is_package_pub: Bool) -> Func Never! {
    span: gen.span
    start: sema_grammar_core_call(SEMA_GRAMMAR_RUNTIME_MODULE, "cursor_of", [Expr]{sema_serde_items_ident("text", span)}, span)
    run: sema_serde_items_free_call(sema_grammar_into_function(gen, plan, shape.rule), [Expr]{sema_serde_items_ident(SEMA_GRAMMAR_CURSOR, span), sema_serde_items_ident(sema_grammar_scanner_constant(gen), span), sema_serde_items_ident("sink", span)}, span)
    result: sema_grammar_core_call(SEMA_GRAMMAR_RUNTIME_MODULE, "into_result", [Expr]{sema_serde_items_ident(SEMA_GRAMMAR_CURSOR, span)}, span)
    failed: Expr.Err{value: sema_grammar_core_call(SEMA_GRAMMAR_RUNTIME_MODULE, "parse_error", [Expr]{sema_serde_items_ident(SEMA_GRAMMAR_CURSOR, span)}, span), span: span, id: AST_NODE_GENERATED}
    returned: Type.Result{ok: Type.Int, err: Type.Named{name: "{sema_grammar_alias(SEMA_GRAMMAR_ERROR_MODULE)}.GrammarError"}}
    params: [Param]{sema_serde_items_param("text", Type.String, span), sema_grammar_into_sink_param("sink", span)}
    ^method: sema_serde_items_method("parse_into", sema_grammar_into_type_params(span), params, returned, Span{start: span.start + 3, end: span.start + 3})
    method.is_pub = is_pub
    method.is_package_pub = is_package_pub
    method.body = [Stmt]{
        sema_serde_items_binding(SEMA_GRAMMAR_CURSOR, None, start, true, span),
        sema_serde_items_if(sema_serde_items_not(run, span), [Stmt]{sema_serde_items_return(failed, span)}, span),
        sema_serde_items_return(result, span),
    }
    method
}

// The sink functions of a grammar: each parser rule's.
sema_grammar_into_items: fn(gen: SemaGrammarGen, plan: SemaGrammarItemsPlan, items: ^[Item]) Never! {
    loop shape in plan.shapes -> sema_grammar_into_functions(gen, plan, shape, items)
}
