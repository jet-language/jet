    pub fn check_params_and_body(self: &Self, f: &Func, owner_type: String?) {
        self.validate_public_failure_carrier(f)
        loop param in f.type_params -> self.warn_soft_public_declared_type(Type.TraitObject(param.bounds), param.name_span)
        if return_type :: f.return_type {
