                &self.diags.push(Diagnostic.error("E1110", "`Group` cannot be returned", "a task group is a scoped spawn authority; the block that owns it joins its children when it closes, so a returned handle would already be dead", "take `group: Group` as a parameter of a function or method and do the work there", Val(f.return_type_span ?? f.name_span)))
            } else {
                self.check_declared_return_type(self.resolve_type(return_type), f.return_type_span ?? f.name_span)
            }
        }
        loop p in f.params {
            if p.name == Syntax.AMBIENT_ERR -> &self.diags.push(Diagnostic.lint("L0511", "binding `err` shadows the fallback's ambient failure report", "`err` has a special meaning inside a fallible `??` fallback, so the same name is easy to misread as the report there", "rename the binding, or use it outside a fallback", Val(p.name_span)))
            empty_named :: p.ty == .Named(n) && n.is_empty()
            skip_type_check :: (p.name == Syntax.KW_SELF || p.variadic_bound_list != None) && empty_named
