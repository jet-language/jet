impl Checker {
    // Rust: crates/jet-sema/src/Sema/Registration.rs:336
    fn check_inline_foreign_fn(self: &Self, f: &Func) Never! {
        inl :: f.inline_foreign ?? return
        // Rust: crates/jet-sema/src/Sema/Registration.rs:341
        UNSAFE_INLINE_LANGS :: [Syntax.C_MODULE_ROOT, Syntax.CPP_MODULE_ROOT, Syntax.ASM_LANG]
        if !UNSAFE_INLINE_LANGS.contains(inl.lang) {
            &self.diags.push(Diagnostic.error("E3220", "no inline foreign binder for `{inl.lang}` yet", "the inline foreign tier ships `c`, `cpp`, and `asm` first (the systems floor, card #501); other languages arrive on later polyglot cards", "use `#FFI(c)`, `#FFI(cpp)`, or `#FFI(asm)`", Val(inl.lang_span)))
            return
        }
        if !f.is_unsafe {
            &self.diags.push(Diagnostic.error("E3215", "`#FFI({inl.lang})` needs an `#Unsafe(\"reason\")` gate", "`{inl.lang}` is an unsafe foreign language — an inline `{inl.lang}` body can break memory safety, so Jet requires you to state why it is sound to call (I1/S58)", "add the gate: `#Unsafe(\"…\") #FFI({inl.lang}) fn …`", Val(inl.marker_span)))
            return
        }
        bad_signature := !f.type_params.is_empty()
        loop parameter in f.params { if !sema_checked_inline_ffi_scalar(parameter.ty) -> bad_signature = true }
        if ty :: f.return_type { if !sema_checked_inline_ffi_scalar(ty) -> bad_signature = true }
        if bad_signature {
            &self.diags.push(Diagnostic.error("E3222", "`#FFI({inl.lang})` has a signature its binder can't represent", "inline foreign contracts are ABI boundaries; this systems tier accepts concrete integer, float, and Bool values only", "replace generic, collection, String, callback, or user-defined values with an explicit scalar ABI contract", Val(f.name_span)))
            return
        }
        if inl.lang == Syntax.ASM_LANG -> self.check_inline_asm(&f)
    }

    // Rust: crates/jet-sema/src/Sema/Registration.rs:391
    fn check_inline_asm(self: &Self, f: &Func) Never! {
        inl :: f.inline_foreign ?? return
        bad_signature := false
        loop parameter in f.params { if !sema_checked_inline_asm_integer(parameter.ty) -> bad_signature = true }
        if ty :: f.return_type { if !sema_checked_inline_asm_integer_or_void(ty) -> bad_signature = true }
        if bad_signature {
            &self.diags.push(Diagnostic.error("E3222", "`#FFI(asm)` has a signature its register binder can't represent", "the audited assembly bridge uses general-purpose integer registers; floats and Bool need explicit conversion in Jet before the boundary", "use Int or I8/I16/I32/I64/U8/U16/U32/U64 parameters and return values", Val(f.name_span)))
            return
        }
        has_mem := false
        loop (_, path) in self.core_imports { if path == Syntax.CORE_MEM_MODULE -> has_mem = true }
        if !has_mem {
            &self.diags.push(Diagnostic.error("E3102", "inline assembly is part of the low-level memory tier", "assembly can read registers and memory outside Jet's safe value model, so discovery requires the explicit `core.mem` opt-in", "add `use core.mem` at the top of this file", Val(inl.marker_span)))
            return
        }
        params := [String:Int]{}
        loop (index, parameter) in f.params -> params[parameter.name] = index
        target :: self.layout_target().triple // GATE #4483 selected target, not host.
        target_arch :: inline_asm_target_arch(target)
        used := [String:Bool]{}
        clobbers := [String]{}
        seen_clobbers := [String:Bool]{}
        return_anchors := 0
        return_destination := None as InlineAsmOutput?
        bad := None as String?
        loop source_line in inl.source.lines() {
            line := source_line.trim() // #4303
            if rest :: line.strip_prefix("; clobbers ") {
                loop raw in rest.split(fn(c) -> c == ',' || c.is_whitespace()).filter(fn(s) -> !s.is_empty()) {
                    register :: (raw.strip_prefix("%") ?? raw).to_ascii_lowercase()
                    if target_arch == None || !inline_asm_register_known(target, register) {
                        bad = Val("`{raw}` isn't an audited register on this target")
                    } else if seen_clobbers.get(register) != None {
                        bad = Val("clobber register `{raw}` is listed more than once")
                    } else {
                        seen_clobbers[register] = true
                        &clobbers.push(register)
                    }
                }
                next
            }
            if line.contains("; -> return") {
                return_anchors += 1
                destination := None as String?
                if parts :: line.split_once("; -> return") {
                    body := parts.0.trim() // #4303
                    destination = sema_inline_assembly_first_operand(body)
                }
                checked_destination := None as InlineAsmOutput?
                if operand :: destination {
                    parameter_name := None as String?
                    if name :: operand.strip_prefix("{") -> parameter_name = name.strip_suffix("}")
                    if name :: parameter_name {
                        if index :: params.get(name) -> checked_destination = Val(InlineAsmOutput.Parameter(index))
                    } else {
                        register :: (operand.strip_prefix("%") ?? operand).to_ascii_lowercase()
                        if target_arch != None && inline_asm_register_known(target, register) -> checked_destination = Val(InlineAsmOutput.Register(register))
                    }
                }
                if destination_value :: checked_destination {
                    if return_destination != None -> bad = Val("an assembly body can have only one checked return destination") else -> return_destination = Val(destination_value)
                } else {
                    bad = Val("a value-returning assembly body needs a named output operand or an explicit audited target register")
                }
            }
            rest := line
            loop {
                open :: rest.find("{") ?? break
                close_option := rest.slice(open + 1, rest.len()).find("}")
                if close_option == None { bad = Val("an assembly operand has an unmatched `{`"); break }
                close :: close_option ?? unreachable()
                name := rest.slice(open + 1, open + 1 + close) // #4303
                if !params.contains_key(name) -> bad = Val("`{{{name}}}` doesn't name a Jet parameter") else -> used[name] = true
                rest = rest.slice(open + close + 2, rest.len())
            }
        }
        loop (name, _) in params {
            if used.get(name) == None { bad = Val("parameter `{name}` has no named `{{{name}}}` operand"); break }
        }
        returns_value :: if ty :: f.return_type -> !is_void_like_return(ty) else -> false
        expected_anchors :: if returns_value -> 1 else -> 0
        if return_anchors != expected_anchors -> bad = Val(if returns_value -> "a value-returning assembly body needs exactly one `; -> return` anchor" else -> "a void assembly body can't declare a `; -> return` anchor")
        if return_destination == .Val(.Register(register)) {
            if clobbers.contains(register) -> bad = Val("return register `{register}` cannot also be an early-written clobber")
        }
        if target_arch == None -> bad = Val("inline assembly has no audited register set for target `{target}`")
        if problem :: bad {
            &self.diags.push(Diagnostic.error("E3223", "this inline assembly operand contract is incomplete", problem, "bind each Jet parameter as `{{name}}`, mark one result with `; -> return`, and list overwritten registers on `; clobbers …`", Val(inl.source_span)))
            return
        }
        f.inline_foreign.expect("inline foreign checked above").asm_contract = Val(InlineAsmContract{target: target, output: ^return_destination, clobbers: ^clobbers})
    }

