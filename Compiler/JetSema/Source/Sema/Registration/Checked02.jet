        is_fallible_void :: if ty :: body_return -> is_fallible_void_return(ty) else -> false
        if !is_generator && !is_fallible_void && body_return != None && value_return == None && !block_definitely_returns(f.body) {
            rt :: body_return ?? unreachable()
            &self.diags.push(Diagnostic.error("E0114", "`{f.name}` promises to return {rt.show()}, but a path can reach the end without `return`", "every way through the function must hand back a value", "add a final `return ...;`, or an `{Syntax.KW_ELSE}` branch that returns", Val(f.name_span)))
        }
        self.check_kernel_marker(&f, owner_type)
    }

    // Rust: crates/jet-sema/src/Sema/Registration.rs:1016
    fn check_variadic_bound_body_shape(self: &Self, f: Func) Never! {
        last :: f.params.last() ?? return
        if last.variadic_trait_bounds(fn(n) -> self.trait_reg.is_trait_name(n)) == None -> return
        for_hits := 0
        other := [Span]{}
        loop statement in f.body -> sema_function_header_variadic_statement(statement, last.name, true, &for_hits, &other)
        if for_hits > 1 -> &other.push(last.name_span)
        loop span in other -> &self.diags.push(e1314(last.name, span))
    }
}

