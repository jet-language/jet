        if (trait_method, span) :: unbounded_dispatch(key, summaries, &seen_dispatch) { &diags.push(e0743(trait_method, span)); return }
        declared := EffectSet.new()
        prohibited := EffectSet.new()
        bad_name := false
        open_row := false
        loop entry in declared_list {
            name :: entry.name
            span :: entry.span
            is_prohibited :: name.starts_with("!")
            base_name := if is_prohibited -> name.slice(1, name.len()) else -> name // #4303
            if effect_row_var(base_name) != None { open_row = true; next }
            effect := parse_effect_name(base_name)
            if e :: effect {
                if is_prohibited {
                    if effect_root(e) != "Mem" -> &prohibited.insert(e)
                } else if diagnostic :: reject_positive_deny_only_effect(e, span) {
                    &diags.push(diagnostic)
                    bad_name = true
                } else {
                    &declared.insert(e)
                }
            } else {
                &diags.push(unknown_effect(base_name, span))
                bad_name = true
            }
        }
        if bad_name -> return
        inferred :: solved.get(key) ?? EffectSet.new()
        if !open_row && !declared.is_empty() {
            over :: effects_uncovered(inferred, declared)
            if !over.is_empty() {
                span :: if first :: declared_list.first() -> first.span else -> f.name_span
                &diags.push(e0740(f.name, over, declared, span))
            }
        }
        if !prohibited.is_empty() {
            reached :: effects_covered(inferred, prohibited)
            if !reached.is_empty() {
                span := f.name_span
                loop entry in declared_list { if entry.name.starts_with("!") { span = entry.span; break } }
                if effect_set_has_root(reached, Effect.Panic) {
                    seen_panic := [String:Bool]{}
                    site :: panic_site(key, summaries, &seen_panic) ?? "the reachable call graph"
                    &diags.push(e0749_panic(f.name, site, prohibited, span))
                } else {
                    &diags.push(e0749(f.name, reached, prohibited, span))
                }
            }
        }
    }
    loop item in items {
        if item == {
            .Func(f) -> check_one(f, None, None, solved, summaries, &diags)
            .Impl(i) -> loop m in i.methods -> check_one(m, Val(i.type_name), None, solved, summaries, &diags)
            .Struct(s) -> {
                loop m in s.methods -> check_one(m, Val(s.name), None, solved, summaries, &diags)
                loop block in s.trait_impls {
                    loop m in block.methods -> check_one(m, Val(s.name), None, solved, summaries, &diags)
                }
            }
            .Enum(e) -> loop m in e.methods -> check_one(m, Val(e.name), None, solved, summaries, &diags)
            .CodeModule(module) -> {
                if body :: module.body {
                    loop inner in body {
                        if inner == .Func(f) -> check_one(f, None, Val(inline_effect_key(module.name, f.name)), solved, summaries, &diags)
                    }
                }
            }
            else -> {}
        }
    }
    trait_bounds := [(String, String):EffectSet]{} // GATE #4499 exact composite-key hashing.
    loop (trait_name, method) in [(Syntax.TRAIT_ADD, "add"), (Syntax.TRAIT_SUB, "sub"), (Syntax.TRAIT_MUL, "mul"), (Syntax.TRAIT_DIV, "div"), (Syntax.TRAIT_EQUATABLE, "equal"), (Syntax.TRAIT_COMPARABLE, "compare")] -> trait_bounds[(trait_name, method)] = EffectSet.new()
    loop item in items {
        if item != .Trait(_) -> next
        t :: item.Trait
        loop m in t.methods {
            bound := None as EffectSet?
            if m.is_pure {
                bound = Val(EffectSet.new())
            } else if list :: m.declared_effects {
                set := EffectSet.new()
                ok := true
                open := false
                loop entry in list {
                    if effect_row_var(entry.name) != None { open = true; next }
                    if e :: parse_effect_name(entry.name) {
                        if diagnostic :: reject_positive_deny_only_effect(e, entry.span) { &diags.push(diagnostic); ok = false } else -> &set.insert(e)
