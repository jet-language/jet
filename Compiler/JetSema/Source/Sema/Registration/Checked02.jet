//RS /// D-ANY-JAI1: E1314 — a trait-bounded variadic parameter used outside the
//RS /// one supported shape (a direct `loop x in name { … }` loop).
//RS fn e1314(name: &str, span: Span) -> Diagnostic {
//RS     Diagnostic::error(
//RS         "E1314",
//RS         format!("`{name}` can only be used in a direct `loop x in {name} {{ … }}` loop here"),
//RS         format!(
//RS             "`{name}` is a trait-bounded variadic (`...Trait` / `...[A, B]`) — its elements can \
//RS              have different concrete types, so there's no single Rust type to give `{name}` \
//RS              outside a loop that visits each argument once"
//RS         ),
//RS         format!("iterate it with `loop x in {name} {{ … }}` — that's the only supported use"),
//RS         Some(span),
//RS     )
//RS }
//RS 
//RS /// Walk one statement looking for uses of `name` (a trait-bounded variadic
//RS /// parameter). `top_level` is true only for statements directly in the
//RS /// function body (not nested in `if`/`while`/`loop`/`switch`/…) — the blessed
//RS /// `loop x in name { … }` shape is only recognized there; `for_hits` counts how
//RS /// many times it's seen; every other reference to `name` lands in `other`.
//RS fn scan_stmt_for_variadic_uses(
//RS     s: &Stmt,
//RS     name: &str,
//RS     top_level: bool,
//RS     for_hits: &mut usize,
//RS     other: &mut Vec<Span>,
//RS ) {
//RS     match s {
//RS         Stmt::For {
//RS             var2: None,
//RS             kind:
//RS                 crate::AST::ForKind::In {
//RS                     collection,
//RS                     step: None,
//RS                 },
//RS             body,
//RS             label: None,
//RS             ..
//RS         } if top_level && matches!(collection, Expr::Ident(n, _) if n == name) => {
//RS             *for_hits += 1;
//RS             for st in body {
//RS                 scan_stmt_for_variadic_uses(st, name, false, for_hits, other);
//RS             }
//RS         }
//RS         Stmt::Expr(e) | Stmt::DeferClose { close: e, .. } | Stmt::Return(Some(e), _) => {
//RS             expr_uses(e, name, other)
//RS         }
//RS         Stmt::Return(None, _) | Stmt::Break(_) | Stmt::Continue(_) => {}
