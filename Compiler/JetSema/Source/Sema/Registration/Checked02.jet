pub fn method_field_clash(method: String, type_name: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0105", "method `{method}` can't share a name with a field on `{type_name}`", "a type's methods and fields must have different names", "rename the method or the field", Val(span))
}
// Rust: crates/jet-sema/src/Sema/Registration.rs:1707
pub fn method_defined_twice(method: String, type_name: String, span: Span, is_ctor: Bool) -> Diagnostic Never! {
    fix :: if is_ctor -> "named constructors must each have a unique name — call them `{type_name}.{method}` and `{type_name}.other_name`" else -> "rename or remove one of the definitions"
    Diagnostic.error("E0105", "method `{method}` is defined twice on `{type_name}`", "each method name may appear only once on a type", fix, Val(span))
}
// Rust: crates/jet-sema/src/Sema/Registration.rs:1730
pub fn impl_type_exists(type_name: String, registry: TypeRegistry, imports: [String:Int], states: [ModuleState]?) -> Bool Never! {
    if registry.contains(type_name) -> return true
    if (alias, local) :: type_name.rsplit_once(".") {
        modules :: states ?? return false
        idx :: imports.get(alias) ?? return false
        return modules[idx].registry.contains(local)
    }
    false
}

// Rust: crates/jet-sema/src/Sema/Registration.rs:1751
pub fn synthesize_impls(items: &[Item]) Never! {
    trait_methods := [String:[TraitMethodSig]]{}
    loop item in items { if item == .Trait(t) -> trait_methods[t.name] = t.methods }
    impl_pairs := [(String, String):Bool]{} // GATE #4499 exact type/trait pair keys.
    struct_field_types := [String:[String:String]]{}
    loop item in items {
        if item == {
            .Impl(i) -> { if trait_name :: i.trait_name { if i.delegation_field == None -> impl_pairs[(i.type_name, trait_name)] = true } }
            .Struct(s) -> {
                loop block in s.trait_impls -> impl_pairs[(s.name, block.trait_name)] = true
                fields := [String:String]{}
                loop f in s.fields -> fields[f.name] = type_name(f.ty)
                struct_field_types[s.name] = ^fields
            }
            else -> {}
        }
    }
    delegations := [(Int, String, String, String)]{}
    loop (idx, item) in items {
        if item == .Impl(i) {
            if trait_name :: i.trait_name {
                if field_name :: i.delegation_field -> &delegations.push((idx, i.type_name, trait_name, field_name))
            }
        }
    }
    loop (idx, owner_name, trait_name, field_name) in delegations {
        fields :: struct_field_types.get(owner_name) ?? next
        field_type_name :: fields.get(field_name) ?? next
        if impl_pairs.get((field_type_name, trait_name)) == None -> next
        sigs :: trait_methods.get(trait_name) ?? next
        synthesized :: loop m in sigs -> synthesize_delegation_method(m, field_name)
        if items[idx] == .Impl(i) -> i.methods = synthesized
    }
    trait_impls_to_fill := [(Int, String)]{}
    loop (idx, item) in items {
        if item == .Impl(i) {
            if trait_name :: i.trait_name { if i.delegation_field == None -> &trait_impls_to_fill.push((idx, trait_name)) }
        }
    }
    loop (idx, trait_name) in trait_impls_to_fill {
        sigs :: trait_methods.get(trait_name) ?? next
        extras := [Func]{}
        if items[idx] == .Impl(i) {
            provided := [String:Bool]{}
            loop m in i.methods -> provided[m.name] = true
            loop sig in sigs {
                if provided.get(sig.name) == None { if body :: sig.default_body -> &extras.push(synthesize_default_method(sig, body)) }
            }
        }
        if !extras.is_empty() {
            if items[idx] == .Impl(i) -> &i.methods.extend(^extras)
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Registration.rs:1865
pub fn synthesize_delegation_method(sig: TraitMethodSig, field_name: String) -> Func Never! {
    zero :: Span.new(0, 0)
    args := [CallArg]{}
    loop p in sig.params {
        if p.name == Syntax.KW_SELF -> next
        &args.push(CallArg{convention: p.convention, expr: Expr.Ident(p.name, zero), span: zero, flags: ast_empty_call_arg_flags(), label: None, spread: false})
    }
    forward_call :: Expr.MethodCall{receiver: Expr.Field(Expr.Ident(Syntax.KW_SELF, zero), field_name, zero), method: sig.name, method_span: zero, owner_type_args: [], type_args: [], args: ^args, recv_type: None, resolved_ret: None, operator_rhs: None, checked_widen: false}
    body_stmt :: if sig.return_type != None -> Stmt.Return(Val(forward_call), zero) else -> Stmt.Expr(forward_call)
    self_param :: Param{convention: AccessConvention.Read, root: false, name: Syntax.KW_SELF, name_span: zero, ty: Type.Named{name: ""}, ty_span: zero, default: None, variadic: false, variadic_bound_list: None, declared_view_from_names: None, public_label: None, zone: ParamZone.Either}
    params := [self_param]
    loop p in sig.params { if p.name != Syntax.KW_SELF -> &params.push(p) }
    // ast_func initializes every remaining Rust field identically, including
    // compiler_generated=false, effects/markers/contracts empty, and all flags false.
    result := ast_func(sig.name, sig.name_span, sig.name_span)
    result.params = ^params
    result.return_type = sig.return_type
    result.body = [body_stmt]
    result
}

// Rust: crates/jet-sema/src/Sema/Registration.rs:1994
pub fn synthesize_default_method(sig: TraitMethodSig, body: [Stmt]) -> Func Never! {
    zero :: Span.new(0, 0)
    self_param :: Param{convention: AccessConvention.Read, root: false, name: Syntax.KW_SELF, name_span: zero, ty: Type.Named{name: ""}, ty_span: zero, default: None, variadic: false, variadic_bound_list: None, declared_view_from_names: None, public_label: None, zone: ParamZone.Either}
    params := [self_param]
    loop p in sig.params { if p.name != Syntax.KW_SELF -> &params.push(p) }
    result := ast_func(sig.name, sig.name_span, sig.name_span)
    result.params = ^params
    result.return_type = sig.return_type
    result.body = body
    result
}

// Rust: crates/jet-sema/src/Sema/Registration.rs:2086
pub fn check_default_forward_refs(params: [Param], fn_name: String, diags: &[Diagnostic]) Never! {
    param_names :: loop p in params -> p.name
    loop (i, p) in params {
        default :: p.default ?? next
        forward_refs :: find_forward_refs(default, param_names, i)
        loop (fwd_name, fwd_span) in forward_refs -> &diags.push(Diagnostic.error("E0126", "default for `{p.name}` in `{fn_name}` references `{fwd_name}`, which comes after it", "defaults fill left to right; a parameter isn't in scope until it appears in the list", "reorder the parameters so `{fwd_name}` comes before `{p.name}`, or use a constant default", Val(fwd_span)))
    }
}
