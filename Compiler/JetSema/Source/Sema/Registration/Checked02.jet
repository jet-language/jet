    fn unbounded_dispatch(key: String, summaries: [String:EffectSummary], seen: &[String:Bool]) -> (String, Span)? Never! {
        if seen.contains_key(key) -> return None
        seen[key] = true
        summary :: summaries.get(key) ?? return None
        loop callee in summary.edges {
            if target :: summaries.get(callee) {
                if target.unbounded_trait_dispatch {
                    span := Span.new(0, 0)
                    loop call in summary.memory.calls { if call.callee == callee { span = call.span; break } }
                    return Val((callee, span))
                }
            }
            if found :: unbounded_dispatch(callee, summaries, &seen) -> return Val(found)
        }
        None
    }
