    }
    impls := [(String, String, String, Span)]{}
    push_impl :: fn(trait_name, type_name, methods) {
        loop m in methods -> &impls.push((trait_name, type_name, m.name, m.name_span))
    }
    loop item in items {
        if item == {
            .Impl(i) -> { if t :: i.trait_name -> push_impl(t, i.type_name, i.methods) }
            .Struct(s) -> loop block in s.trait_impls -> push_impl(block.trait_name, s.name, block.methods)
            .Enum(e) -> loop block in e.trait_impls -> push_impl(block.trait_name, e.name, block.methods)
            else -> {}
        }
    }
    check_trait_obligations(impls, trait_bounds, solved, &diags)
}

// Rust: crates/jet-sema/src/Sema/Registration.rs:1637
pub fn effect_key(owner_type: String?, name: String) -> String Never! {
    if owner :: owner_type -> "{owner}::{name}" else -> name
}
