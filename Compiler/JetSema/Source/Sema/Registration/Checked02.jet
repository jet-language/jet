// Rust: crates/jet-sema/src/Sema/Registration.rs:30
pub fn register_comptime_declarations(items: [Item], st: &ModuleState, prelude_enabled: Bool) Never! {
    ignored_diags := [Diagnostic]{}
    loop item in items {
        if item == {
            .Func(function) -> register_func_item(function, &st, &ignored_diags, prelude_enabled)
            .CodeModule(module) -> {
                body :: module.body ?? next
                st.code_modules[module.name] = module.name
                st.code_module_identities[module.name] = if identity :: module.instance_identity -> "instance:{identity.fingerprint}" else -> "module:{st.module_path}::{module.name}"
                loop inner in body {
                    if inner == .Func(function) {
                        mangled :: member_name(module.name, function.name)
                        st.funcs[mangled] = func_to_sig(function)
                        if !function.type_params.is_empty() -> st.trait_reg.fn_params[mangled] = function.type_params
                    }
                }
            }
            .ExternRust(block) -> {
                loop function in block.functions -> register_extern_fn(function, &st.funcs, st.registry, st.consts, &ignored_diags, false, prelude_enabled)
            }
            .CModule(module) -> {
                loop function in module.functions -> register_extern_fn(function, &st.funcs, st.registry, st.consts, &ignored_diags, true, prelude_enabled)
            }
            else -> {}
        }
    }
    loop item in items {
        if item == {
            .Struct(definition) -> register_struct(definition, &st.registry, &ignored_diags, st.funcs, st.consts, TargetLayout.from_build_facts(st.build_facts)) // GATE #4483 selected build facts.
            .Enum(definition) -> register_enum(definition, &st.registry, &ignored_diags, st.funcs, st.consts)
            .Distinct(definition) -> register_distinct(definition, &st.registry, &ignored_diags, st.funcs, st.consts)
            .TypeAlias(definition) -> register_type_alias(definition, &st.registry, &ignored_diags, st.funcs, st.consts)
            .UnitFamily(family) -> {
                dimension :: family.resolved_dimension
                loop definition in family.distinct_defs() {
                    register_distinct(definition, &st.registry, &ignored_diags, st.funcs, st.consts)
                    st.registry.unit_types[definition.name] = true
                    if owner :: family.resolved_owner {
                        if family.base != None || dimension != None {
                            if fact :: unit_fact(family, definition.name, dimension, OSPath.from(owner)) -> st.registry.unit_facts[definition.name] = fact
                        }
                    }
                }
            }
            else -> {}
        }
    }
    loop item in items {
        if item == .Const(constant) -> register_const(constant, &st.consts, &ignored_diags, st.funcs, st.registry)
    }
    st.trait_reg.register_synthetic_iter_index()
    st.trait_reg.register_items(items, &ignored_diags)
    register_type_methods(items, &st.registry, &ignored_diags)
    register_impl_methods(items, &st.registry, &ignored_diags)
}

// Rust: crates/jet-sema/src/Sema/Registration.rs:188
pub fn normalize_operator_rhs(items: &[Item]) Never! {
    before :: CanonicalPass.ast_items_payload(items)
    before_identity :: CanonicalPass.ast_items_identity(items)
    // Rust: crates/jet-sema/src/Sema/Registration.rs:191
    fn owner_type(name: String, params: [TypeParam]) -> Type Never! {
        if params.is_empty() -> return Type.Named{name: name}
        args :: loop param in params -> Type.Named{name: param.name}
        Type.Apply{name: name, args: args}
    }
    // Rust: crates/jet-sema/src/Sema/Registration.rs:205
    // is_operator_trait -> Checked.jet::sema_checked_operator_trait (the six exact names).
    // Rust: crates/jet-sema/src/Sema/Registration.rs:217
    fn normalize_nested(items: &[Item]) Never! {
        owners := [String:Type]{}
        loop item in items {
            if item == {
                .Struct(definition) -> owners[definition.name] = owner_type(definition.name, definition.type_params)
                .Enum(definition) -> owners[definition.name] = owner_type(definition.name, definition.type_params)
                else -> {}
            }
        }
        loop item in &items {
            if item == {
                .Struct(definition) -> {
                    owner :: owners.get(definition.name) ?? Type.Named{name: definition.name}
                    loop implementation in &definition.trait_impls {
                        if implementation.operator_rhs == None && sema_checked_operator_trait(implementation.trait_name) -> implementation.operator_rhs = Val(owner)
                    }
                }
                .Enum(definition) -> {
                    owner :: owners.get(definition.name) ?? Type.Named{name: definition.name}
                    loop implementation in &definition.trait_impls {
                        if implementation.operator_rhs == None && sema_checked_operator_trait(implementation.trait_name) -> implementation.operator_rhs = Val(owner)
                    }
                }
                .Impl(implementation) -> {
                    if implementation.operator_rhs == None {
                        if trait_name :: implementation.trait_name {
                            if sema_checked_operator_trait(trait_name) -> implementation.operator_rhs = Val(owners.get(implementation.type_name) ?? Type.Named{name: implementation.type_name})
                        }
                    }
                }
                .CodeModule(module) -> { if body :: &module.body -> normalize_nested(&body) }
                .GenericModule(module) -> normalize_nested(&module.body)
                else -> {}
            }
        }
    }
    normalize_nested(&items)
    CanonicalPass.record("lowering", "sema.normalize-operator-rhs", "crates/jet-sema/src/Sema/Registration.rs", "ast", before, before_identity, "ast", CanonicalPass.ast_items_payload(items), CanonicalPass.ast_items_identity(items), "preserve")
}

// Rust: crates/jet-sema/src/Sema/Registration.rs:302
fn is_void_named(ty: Type) -> Bool Never! {
    if ty == .Named(name) -> return name == Syntax.INTERNAL_UNIT_TYPE
    false
}
// Rust: crates/jet-sema/src/Sema/Registration.rs:309
fn is_void_like_return(ty: Type) -> Bool Never! {
    if ty == .Result(ok, _) -> return is_void_named(ok)
    is_void_named(ty)
}
// Rust: crates/jet-sema/src/Sema/Registration.rs:313
fn is_fallible_void_return(ty: Type) -> Bool Never! {
    if ty == .Result(ok, _) -> return is_void_named(ok)
    false
}
// Rust: crates/jet-sema/src/Sema/Registration.rs:321
