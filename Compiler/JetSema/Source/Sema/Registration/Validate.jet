// (`process_validate_blocks`): a struct's `validate { … }` block becomes,
// before registration, the ordinary method `impl T { validate: fn(value: T) -> T
// [FieldError]! }`. Every rule is `check(condition, at: field, "message")`; the
// method collects one `FieldError{path: "field", reason: message}` per failing
// rule and returns them all, or the value when every rule holds. The method is
// `pure`, so the ordinary purity check confines conditions and messages to pure
// calls. The generated decode of a struct with a block returns
// `T.validate(decoded)` (sema_serde_items_struct_decode_body).
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    Diagnostic,
    Expr,
    Func,
    ImplConstValue,
    ImplDef,
    Item,
    NamedType,
    Param,
    PlaceAccess,
    Span,
    Stmt,
    StrPart,
    StructDef,
    Type,
    ast_empty_call_arg_flags,
    ast_func,
    ast_visit_expr,
    core_record_field,
    core_record_field_is_core_only,
    core_source_is_validate,
    module_is_core,
]

// The rule statement's name (Syntax `VALIDATE_CHECK_FN`).
SEMA_VALIDATE_CHECK: "check"
SEMA_VALIDATE_ERRORS: "__errors"
SEMA_VALIDATE_VALUE: "value"

SemaValidateRule: struct {
    cond: Expr
    field: String
    message: Expr
}

// Rust `process_validate_blocks`: one generated impl per struct with a
// non-empty block, after the written items. A block with a malformed rule
// reports it and generates nothing.
sema_validate_blocks: fn(items: &[Item], diagnostics: &[Diagnostic]) {
    generated := [Item]{}
    loop index in 0..<items.len() {
        if items[index] == .Struct(definition) {
            if definition.validate_block.len() == 0 -> next
            implementation: sema_validate_impl(definition, diagnostics) ?? next
            generated.push(Item.Impl{value: implementation})
        }
    }
    loop item in generated -> items.push(item)
}

// Rust `synthesize_validate_impl`.
sema_validate_impl: fn(definition: StructDef, diagnostics: &[Diagnostic]) -> ImplDef? {
    fields := [String:Bool]{}
    loop field in definition.fields -> fields[field.name] = true
    rules := [SemaValidateRule]{}
    valid := true
    loop statement in definition.validate_block {
        if sema_validate_rule(statement, fields, diagnostics) == .Val(rule) {
            rules.push(rule)
        } else {
            valid = false
        }
    }
    if !valid -> return None
    Val(sema_validate_build(definition, rules, definition.validate_span ?? definition.name_span))
}

// Rust `extract_check_rule`: `check(condition, at: field, message)` with a
// bare sibling field after `at:`. A malformed rule reports its one problem
// and gives None.
sema_validate_rule: fn(statement: Stmt, fields: [String:Bool], diagnostics: &[Diagnostic]) -> SemaValidateRule? {
    if statement == .Expr(expression) {
        if expression == .Call(call, _) {
            if call.name != SEMA_VALIDATE_CHECK || call.args.len() != 3 -> return sema_validate_refuse(sema_validate_e0353(call.name_span), diagnostics)
            if call.args[0].label != None -> return sema_validate_refuse(sema_validate_e0353(call.args[0].span), diagnostics)
            at_label: call.args[1].label ?? return sema_validate_refuse(sema_validate_e0353(call.args[1].span), diagnostics)
            if at_label.name != "at" -> return sema_validate_refuse(sema_validate_e0353(call.args[1].span), diagnostics)
            if call.args[2].label != None -> return sema_validate_refuse(sema_validate_e0353(call.args[2].span), diagnostics)
            if call.args[1].expr == .Ident(name, name_span, _) {
                if fields.get(name) == None -> return sema_validate_refuse(sema_validate_e0354(name, name_span), diagnostics)
                return Val(SemaValidateRule{cond: call.args[0].expr.copy(), field: name.copy(), message: call.args[2].expr.copy()})
            }
            return sema_validate_refuse(sema_validate_e0353(call.args[1].span), diagnostics)
        }
    }
    sema_validate_refuse(sema_validate_e0353(sema_user_text_stmt_span(statement)), diagnostics)
}

sema_validate_refuse: fn(diagnostic: &&Diagnostic, diagnostics: &[Diagnostic]) -> SemaValidateRule? Never! {
    diagnostics.push(diagnostic)
    None
}

sema_validate_e0353: fn(span: Span) -> Diagnostic Never! {
    sema_error("E0353", span, "a `validate` rule must be `check(condition, at: field, \"message\")`", "every statement in a `validate {{ … }}` block is a `check` call — the first argument is the rule's condition, `at:` names the field the failure is reported against, and the last argument is the message text", "write: check(<condition>, at: <field>, \"<message>\")")
}

sema_validate_e0354: fn(name: String, span: Span) -> Diagnostic Never! {
    sema_error("E0354", span, "`at: {name}` doesn't name a field on this struct", "`check(…, at: field, …)`'s `at:` argument must be a bare field name declared on the same struct — it's how the reported `FieldError.path` is chosen", "fix the field name, or add the field to the struct")
}

// Rust `build_validate_impl`. A rule reads its struct's fields by their bare
// names (Rust `rewrite_field_refs` onto `value`): each field a
// rule names is bound to `value.<field>` in the rules' own block, so the
// rules and messages read exactly those fields and `value` stays the
// parameter after the block.
sema_validate_build: fn(definition: StructDef, rules: [SemaValidateRule], span: Span) -> ImplDef {
    fields := [String:Bool]{}
    loop field in definition.fields -> fields[field.name] = true
    referenced: sema_validate_referenced_fields(rules, fields)
    checks := [Stmt]{}
    loop name in referenced -> checks.push(sema_serde_items_binding(name, None, sema_serde_items_field_read(SEMA_VALIDATE_VALUE, name, span), false, span))
    loop rule in rules {
        failure: sema_serde_items_field_error_value(sema_serde_items_string(rule.field, span), rule.message.copy(), span)
        // `__errors.push(failure)`: the push writes the collected list.
        errors: Expr.Place{value: sema_serde_items_ident(SEMA_VALIDATE_ERRORS, span), access: PlaceAccess.Write, span: span, id: AST_NODE_GENERATED}
        push: Stmt.Expr{expr: sema_serde_items_method_call(errors, "push", [Expr]{failure}, span)}
        checks.push(sema_serde_items_if(sema_serde_items_not(rule.cond.copy(), span), [Stmt]{push}, span))
    }
    body := [Stmt]{sema_serde_items_binding(SEMA_VALIDATE_ERRORS, Val(sema_data_decode_error()), Expr.ListLit{elements: [Expr]{}, span: span, id: AST_NODE_GENERATED}, true, span)}
    body.push(sema_serde_items_if(Expr.Bool{value: true, span: span, id: AST_NODE_GENERATED}, checks, span))
    has_errors: sema_serde_items_not(sema_serde_items_method_call(sema_serde_items_ident(SEMA_VALIDATE_ERRORS, span), "is_empty", [Expr]{}, span), span)
    body.push(sema_serde_items_if(has_errors, [Stmt]{sema_serde_items_return(Expr.Err{value: sema_serde_items_ident(SEMA_VALIDATE_ERRORS, span), span: span, id: AST_NODE_GENERATED}, span)}, span))
    // `Ok(value)` is the body's tail value, as a written body ends; a final
    // `return` would be reported (L0530) at the user's `validate {`.
    body.push(Stmt.Expr{expr: Expr.Ok{value: sema_serde_items_copy(sema_serde_items_ident(SEMA_VALIDATE_VALUE, span), span), span: span, id: AST_NODE_GENERATED}})
    target: Type.Named{name: definition.name}
    function := ast_func("validate", span, span)
    function.is_pub = definition.is_pub
    function.is_package_pub = definition.is_package_pub
    function.params = [Param]{sema_serde_items_param(SEMA_VALIDATE_VALUE, target.copy(), span)}
    function.return_type = Val(sema_data_result(target, sema_data_decode_error()))
    function.return_type_span = Val(span)
    // S60/E3401: the purity check covers the whole synthesized rule body.
    function.is_pure = true
    function.body = body
    ImplDef{span: span, type_name: definition.name, type_span: definition.name_span, trait_name: None, trait_span: None, operator_rhs: None, operator_marker: None, methods: [Func]{function}, delegation_field: None, assoc_type_impls: [NamedType]{}, constants: [ImplConstValue]{}, is_generated_serde: false, os_target: None}
}

// The struct fields the rules' conditions and messages name, in order of
// first reference.
sema_validate_referenced_fields: fn(rules: [SemaValidateRule], fields: [String:Bool]) -> [String] {
    found := [String]{}
    // Each visit is written at its call, where it takes the visitor's effect row.
    loop rule in rules {
        ast_visit_expr(rule.cond, fn(expression: Expr) { sema_validate_note_name(fields, found, expression) })
        ast_visit_expr(rule.message, fn(expression: Expr) { sema_validate_note_name(fields, found, expression) })
    }
    found
}

sema_validate_note_name: fn(fields: [String:Bool], found: &[String], expression: Expr) Never! -[Mem.Alloc]> {
    if expression == .Ident(name, _, _) {
        if fields.get(name) == None || found.contains(name) -> return
        found.push(name.copy())
    }
}

// On the Core `Validate<T>` builder (`Validate.over(value)`),
// `.check(condition, at: field, "message")` is the block's rule. `at:` must
// be a bare field of `T`; the Core method receives that field's name, so the
// rule comes back as three positional arguments. A malformed rule reports its
// one problem and gives None.
sema_validate_over_receiver: fn(receiver: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type? Never! {
    if receiver == .Apply(_, args) {
        // copy: the validated type is a payload of read parameter `receiver`
        if args.len() == 1 && core_source_is_validate(sema_expr_receiver_nominal_identity(environment, program, receiver)) -> return Val(args[0].copy())
    }
    None
}

sema_validate_over_rule: fn(subject: Type, args: [CallArg], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> [CallArg]? {
    if args.len() != 3 -> return sema_validate_over_refuse(sema_validate_e0353(span), diagnostics)
    if args[0].label != None -> return sema_validate_over_refuse(sema_validate_e0353(args[0].span), diagnostics)
    at_label: args[1].label ?? return sema_validate_over_refuse(sema_validate_e0353(args[1].span), diagnostics)
    if at_label.name != "at" -> return sema_validate_over_refuse(sema_validate_e0353(args[1].span), diagnostics)
    if args[2].label != None -> return sema_validate_over_refuse(sema_validate_e0353(args[2].span), diagnostics)
    if args[1].expr == .Ident(name, name_span, _) {
        if !sema_validate_over_has_field(subject, name, environment, program, scopes) -> return sema_validate_over_refuse(sema_validate_e0354(name, name_span), diagnostics)
        rule := args
        // copy: the field name is a payload of read parameter `args`; the rewritten rule owns its String
        rule[1] = CallArg{convention: AccessConvention.Read, expr: Expr.Str{parts: [StrPart]{StrPart.Lit{text: name.copy()}}, span: name_span, id: AST_NODE_GENERATED},
            span: args[1].span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
        return Val(rule)
    }
    sema_validate_over_refuse(sema_validate_e0353(args[1].span), diagnostics)
}

sema_validate_over_refuse: fn(diagnostic: &&Diagnostic, diagnostics: &[Diagnostic]) -> [CallArg]? Never! {
    diagnostics.push(diagnostic)
    None
}

// Whether `name` is a declared field of the validated type: a struct's own
// field, or a builtin Core record's field row.
sema_validate_over_has_field: fn(subject: Type, name: String, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> Bool {
    owner_name: if subject == {
        .Named(type_name) -> type_name
        .Apply(type_name, _) -> type_name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ""
    }
    if owner_name == "" -> return false
    owner := sema_expression_type_symbol(scopes, environment, program, owner_name)
    if owner == None -> owner = sema_expression_carrier_type_symbol(environment, program, owner_name)
    if owner == .Val(owner_symbol) {
        if sema_scope_declaration_struct(environment, program, owner_symbol.id) == .Val(shape) {
            loop field in shape.fields {
                if field.name == name -> return true
            }
            return false
        }
    }
    if core_record_field_is_core_only(owner_name, name) && !module_is_core(environment.module_identity) -> return false
    core_record_field(owner_name, name) != None
}
