        .MathLaneIndex(f_lane_type, f_base, f_index, f_line) -> NodeKind.MathLaneIndex{lane_type: f_lane_type, base: body_flat_expr(f_base, &tree), index: body_flat_expr(f_index, &tree), line: f_line}
        .MathSwizzleRead(f_type_name, f_receiver, f_lanes) -> NodeKind.MathSwizzleRead{type_name: f_type_name, receiver: body_flat_expr(f_receiver, &tree), lanes: f_lanes}
        .Clone(f_value, f_fact) -> NodeKind.Clone{value: body_flat_expr(f_value, &tree), fact: f_fact}
        .ExplicitCopy(f_value) -> NodeKind.ExplicitCopy{value: body_flat_expr(f_value, &tree)}
        .MaterializeView(f_value) -> NodeKind.MaterializeView{value: body_flat_expr(f_value, &tree)}
        .StaticCall(f_owner, f_owner_type, f_method, f_type_args, f_args) -> NodeKind.StaticCall{owner: f_owner, owner_type: f_owner_type, method: f_method, type_args: f_type_args, args: body_flat_list_call_arg(f_args, &tree)}
