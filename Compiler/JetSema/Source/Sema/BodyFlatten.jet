        .NumericBinaryMethod(f_receiver, f_operation, f_argument) -> NodeKind.NumericBinaryMethod{receiver: body_flat_expr(f_receiver, &tree), operation: f_operation, argument: body_flat_expr(f_argument, &tree)}
