        .TaskGroupRace(f_tasks) -> NodeKind.TaskGroupRace{tasks: body_flat_expr(f_tasks, &tree)}
        .TaskGroupAny(f_tasks) -> NodeKind.TaskGroupAny{tasks: body_flat_expr(f_tasks, &tree)}
