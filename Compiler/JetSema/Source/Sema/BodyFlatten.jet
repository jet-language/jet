// Flattens a checked function into its FnBody: every expression becomes a
// BodyNode row keyed by its node id, children first, every statement a
// StmtKind row in post order.
use jet_foundation.[
    AST_NODE_GENERATED,
    BodyCallArg,
    BodyContextGuard,
    BodyContract,
    BodyCoreClosureKind,
    BodyEnumArg,
    BodyEnumPayload,
    BodyFnValueKind,
    BodyHandleOp,
    BodyHostCall,
    BodyIfCond,
    BodyLambda,
    BodyLambdaBody,
    BodyListSpreadPart,
    BodyMapEntry,
    BodyMapPatternEntry,
    BodyMatchArm,
    BodyMixedArm,
    BodyNamedEnumArg,
    BodyNestedPattern,
    BodyNode,
    BodyOrFallback,
    BodyParameter,
    BodyPattern,
    BodyPatternBinding,
    BodyPatternField,
    BodyPatternShape,
    BodyPlace,
    BodyRangeArm,
    BodyRequireKind,
    BodyScopeMemberKind,
    BodyStrPart,
    BodyStructFieldValue,
    BodyTree,
    BodyUnitRounding,
    Call,
    Expr,
    Field,
    FnBody,
    Lambda,
    Measure,
    NodeKind,
    OrFallback,
    StmtKind,
    TEXPR_FIRST_FLAT_ID,
    TExprType,
    Variant,
    body_tree_new,
]

// The FnBody of checked function `value`.
fn body_flat_function(value: TFunc) -> FnBody Never! {
    tree := body_tree_new()
    params :: body_flat_list_parameter(value.params, &tree)
    body :: body_flat_list_stmt(value.body, &tree)
    body_tree_finish(&tree)
    FnBody{
        name: value.name,
        module_name: value.module_name,
        module_identity: value.module_identity,
        key: value.key,
        source_file: value.source_file,
        source_span: value.source_span,
        failure_carrier: value.failure_carrier,
        effects: value.effects,
        target_applicability: value.target_applicability,
        web_bucket: value.web_bucket,
        web_marker: value.web_marker,
        visibility: value.visibility,
        foreign: value.foreign,
        params: params,
        web_param_reconstructions: value.web_param_reconstructions,
        ret: value.ret,
        gc_return: value.gc_return,
        gc_scope: value.gc_scope,
        return_view_provenance: value.return_view_provenance,
        generic_params: value.generic_params,
        is_main: value.is_main,
        line: value.line,
        synthetic: value.synthetic,
        is_unsafe: value.is_unsafe,
        unsafe_gate: value.unsafe_gate,
        is_pure: value.is_pure,
        memo_bound: value.memo_bound,
        memo_unbounded: value.memo_unbounded,
        is_reactive: value.is_reactive,
        reactive_upgrades: value.reactive_upgrades,
        is_inline: value.is_inline,
        is_inline_always: value.is_inline_always,
        is_scalar: value.is_scalar,
        kernel_proof: value.kernel_proof,
        uses_stack_sentry: value.uses_stack_sentry,
        body: body,
        kind: value.kind,
        origin_facts: value.origin_facts,
        typed_goals: value.typed_goals,
        tree: tree,
    }
}

// Sorts the rows by node id. A node a desugaring placed twice keeps one row.
fn body_tree_finish(tree: &BodyTree) Never! {
    &tree.nodes.sort_by((left: BodyNode, right: BodyNode) -> left.id <=> right.id)
    &tree.expr_types.sort_by((left: TExprType, right: TExprType) -> left.id <=> right.id)
    nodes := [BodyNode]{}
    types := [TExprType]{}
    loop index in 0..<tree.nodes.len() {
        if index > 0 && tree.nodes[index].id == tree.nodes[index - 1].id -> next
        &nodes.push(tree.nodes[index])
        &types.push(tree.expr_types[index])
    }
    tree.nodes = ^nodes
    tree.expr_types = ^types
}

// Files `value` as a row of `tree`, children first. A node the checker gave no
// id (AST_NODE_GENERATED) takes the next flat-local id below
// TEXPR_FIRST_FLAT_ID: one per row, so no two such nodes share one.
fn body_flat_expr(value: TExpr, tree: &BodyTree) -> Int Never! {
    kind :: body_flat_expr_kind(value.kind, &tree)
    id :: if value.id == AST_NODE_GENERATED -> TEXPR_FIRST_FLAT_ID - tree.nodes.len() else -> value.id
    &tree.nodes.push(BodyNode{id: id, kind: kind, span: value.span})
    &tree.expr_types.push(TExprType{id: id, ty: value.ty})
    id
}

fn body_flat_stmt(value: TStmt, tree: &BodyTree) -> Int Never! {
    kind :: body_flat_stmt_kind(value, &tree)
    &tree.stmts.push(kind)
    tree.stmts.len() - 1
}

fn body_flat_str_part(value: TStrPart, tree: &BodyTree) -> BodyStrPart Never! {
    if value == {
        .Literal(f_text) -> BodyStrPart.Literal{text: f_text}
        .Interpolation(f_value, f_format) -> BodyStrPart.Interpolation{value: body_flat_expr(f_value, &tree), format: f_format}
    }
}

fn body_flat_call_arg(value: TCallArg, tree: &BodyTree) -> BodyCallArg Never! {
    BodyCallArg{
        value: body_flat_expr(value.value, &tree),
        template_items: value.template_items,
        borrow: value.borrow,
        mut_borrow: value.mut_borrow,
        fn_coerce: value.fn_coerce,
        widen_to_vec: value.widen_to_vec,
        widen_to_union: value.widen_to_union,
        box_as_trait: value.box_as_trait,
        label: value.label,
        spread: value.spread,
    }
}

fn body_flat_enum_arg(value: TEnumArg, tree: &BodyTree) -> BodyEnumArg Never! {
    BodyEnumArg{
        value: body_flat_expr(value.value, &tree),
    }
}

fn body_flat_enum_payload(value: TEnumPayload, tree: &BodyTree) -> BodyEnumPayload Never! {
    if value == {
        .Unit -> BodyEnumPayload.Unit
        .Positional(f_args) -> BodyEnumPayload.Positional{args: body_flat_list_enum_arg(f_args, &tree)}
        .Named(f_fields) -> BodyEnumPayload.Named{fields: body_flat_list_named_enum_arg(f_fields, &tree)}
    }
}

fn body_flat_named_enum_arg(value: TNamedEnumArg, tree: &BodyTree) -> BodyNamedEnumArg Never! {
    BodyNamedEnumArg{
        name: value.name,
        value: body_flat_enum_arg(value.value, &tree),
    }
}

fn body_flat_pattern_shape(value: TPatternShape, tree: &BodyTree) -> BodyPatternShape Never! {
    if value == {
        .Variant(f_variant, f_bindings, f_leading_dot, f_span) -> BodyPatternShape.Variant{variant: f_variant, bindings: body_flat_list_pattern_binding(f_bindings, &tree), leading_dot: f_leading_dot, span: f_span}
        .Present(f_binding, f_binding_span, f_inner, f_span) -> BodyPatternShape.Present{binding: f_binding, binding_span: f_binding_span, inner: body_flat_opt_nested_pattern(f_inner, &tree), span: f_span}
        .Absent(f_span) -> BodyPatternShape.Absent{span: f_span}
        .Ok(f_binding, f_binding_span, f_inner, f_span) -> BodyPatternShape.Ok{binding: f_binding, binding_span: f_binding_span, inner: body_flat_opt_nested_pattern(f_inner, &tree), span: f_span}
        .Err(f_binding, f_binding_span, f_inner, f_span) -> BodyPatternShape.Err{binding: f_binding, binding_span: f_binding_span, inner: body_flat_opt_nested_pattern(f_inner, &tree), span: f_span}
        .Range(f_lo, f_hi, f_span) -> BodyPatternShape.Range{lo: f_lo, hi: f_hi, span: f_span}
        .Or(f_alternatives, f_span) -> BodyPatternShape.Or{alternatives: body_flat_list_pattern_shape(f_alternatives, &tree), span: f_span}
        .Struct(f_fields, f_span) -> BodyPatternShape.Struct{fields: body_flat_list_pattern_field(f_fields, &tree), span: f_span}
        .List(f_items, f_rest, f_span) -> BodyPatternShape.List{items: body_flat_list_pattern_binding(f_items, &tree), rest: f_rest, span: f_span}
        .Map(f_entries, f_rest, f_span) -> BodyPatternShape.Map{entries: body_flat_list_map_pattern_entry(f_entries, &tree), rest: f_rest, span: f_span}
        .Text(f_parts, f_span) -> BodyPatternShape.Text{parts: f_parts, span: f_span}
        .Binary(f_parts, f_span) -> BodyPatternShape.Binary{parts: f_parts, span: f_span}
    }
}

fn body_flat_nested_pattern(value: TNestedPattern, tree: &BodyTree) -> BodyNestedPattern Never! {
    BodyNestedPattern{
        shape: body_flat_pattern_shape(value.shape, &tree),
        enum_type: value.enum_type,
    }
}

fn body_flat_pattern(value: TPattern, tree: &BodyTree) -> BodyPattern Never! {
    BodyPattern{
        shape: body_flat_pattern_shape(value.shape, &tree),
        bindings: value.bindings,
        enum_type: value.enum_type,
        position: value.position,
        mutable: value.mutable,
        boxed: value.boxed,
    }
}

fn body_flat_pattern_binding(value: TPatternBinding, tree: &BodyTree) -> BodyPatternBinding Never! {
    if value == {
        .Wildcard -> BodyPatternBinding.Wildcard
        .Bind(f_name, f_span) -> BodyPatternBinding.Bind{name: f_name, span: f_span}
        .Range(f_lo, f_hi) -> BodyPatternBinding.Range{lo: f_lo, hi: f_hi}
        .Nested(f_pattern) -> BodyPatternBinding.Nested{pattern: body_flat_nested_pattern(f_pattern, &tree)}
        .Value(f_value) -> BodyPatternBinding.Value{value: body_flat_expr(f_value, &tree)}
    }
}

fn body_flat_pattern_field(value: TPatternField, tree: &BodyTree) -> BodyPatternField Never! {
    if value == {
        .Bind(f_field, f_local, f_span) -> BodyPatternField.Bind{field: f_field, local: f_local, span: f_span}
        .Value(f_field, f_value, f_span) -> BodyPatternField.Value{field: f_field, value: body_flat_expr(f_value, &tree), span: f_span}
        .Nested(f_field, f_pattern, f_span) -> BodyPatternField.Nested{field: f_field, pattern: body_flat_nested_pattern(f_pattern, &tree), span: f_span}
    }
}

fn body_flat_map_pattern_entry(value: TMapPatternEntry, tree: &BodyTree) -> BodyMapPatternEntry Never! {
    BodyMapPatternEntry{
        key: body_flat_expr(value.key, &tree),
        optional: value.optional,
        slot: body_flat_pattern_binding(value.slot, &tree),
        span: value.span,
    }
}

fn body_flat_match_arm(value: TMatchArm, tree: &BodyTree) -> BodyMatchArm Never! {
    BodyMatchArm{
        pattern: body_flat_pattern(value.pattern, &tree),
        body: body_flat_list_stmt(value.body, &tree),
    }
}

fn body_flat_if_cond(value: TIfCond, tree: &BodyTree) -> BodyIfCond Never! {
    if value == {
        .Plain(f_value) -> BodyIfCond.Plain{value: body_flat_expr(f_value, &tree)}
        .And(f_left, f_right) -> BodyIfCond.And{left: body_flat_if_cond(f_left, &tree), right: body_flat_if_cond(f_right, &tree)}
        .IfLet(f_pattern, f_subj) -> BodyIfCond.IfLet{pattern: body_flat_pattern(f_pattern, &tree), subj: body_flat_expr(f_subj, &tree)}
    }
}

fn body_flat_contract(value: TContract, tree: &BodyTree) -> BodyContract Never! {
    BodyContract{
        kind: value.kind,
        condition: body_flat_expr(value.condition, &tree),
        message: body_flat_expr(value.message, &tree),
        file: value.file,
        line: value.line,
        span: value.span,
        disposition: value.disposition,
    }
}

fn body_flat_stmt_kind(value: TStmt, tree: &BodyTree) -> StmtKind Never! {
    if value == {
        .Contract(f_contract) -> StmtKind.Contract{contract: body_flat_contract(f_contract, &tree)}
        .ContractScope(f_pre, f_body, f_post, f_result, f_span) -> StmtKind.ContractScope{pre: body_flat_list_contract(f_pre, &tree), body: body_flat_list_stmt(f_body, &tree), post: body_flat_list_contract(f_post, &tree), result: f_result, span: f_span}
        .Let(f_local, f_let_ty, f_init, f_gc_promotion, f_gc_transferred, f_span) -> StmtKind.Let{local: f_local, let_ty: f_let_ty, init: body_flat_expr(f_init, &tree), gc_promotion: f_gc_promotion, gc_transferred: f_gc_transferred, span: f_span}
        .RefutableBind(f_pattern, f_init, f_fallback, f_span) -> StmtKind.RefutableBind{pattern: body_flat_pattern(f_pattern, &tree), init: body_flat_expr(f_init, &tree), fallback: body_flat_list_stmt(f_fallback, &tree), span: f_span}
        .TupleDestructure(f_temp, f_init, f_move_fields, f_binds, f_span) -> StmtKind.TupleDestructure{temp: f_temp, init: body_flat_expr(f_init, &tree), move_fields: f_move_fields, binds: f_binds, span: f_span}
        .StructDestructure(f_temp, f_init, f_move_fields, f_binds, f_span) -> StmtKind.StructDestructure{temp: f_temp, init: body_flat_expr(f_init, &tree), move_fields: f_move_fields, binds: f_binds, span: f_span}
        .ListDestructure(f_temp, f_init, f_count, f_line, f_elements, f_span) -> StmtKind.ListDestructure{temp: f_temp, init: body_flat_expr(f_init, &tree), count: f_count, line: f_line, elements: f_elements, span: f_span}
        .Assign(f_place, f_op, f_value, f_line, f_span) -> StmtKind.Assign{place: body_flat_place(f_place, &tree), op: f_op, value: body_flat_expr(f_value, &tree), line: f_line, span: f_span}
        .CountedLoop(f_label, f_init, f_condition, f_step, f_vectorization, f_body, f_span) -> StmtKind.CountedLoop{label: f_label, init: body_flat_stmt(f_init, &tree), condition: body_flat_expr(f_condition, &tree), step: body_flat_opt_stmt(f_step, &tree), vectorization: f_vectorization, body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .ForRange(f_label, f_local, f_start, f_end, f_step, f_exclusive, f_body, f_vectorization, f_span) -> StmtKind.ForRange{label: f_label, local: f_local, start: body_flat_expr(f_start, &tree), end: body_flat_expr(f_end, &tree), step: body_flat_opt_expr(f_step, &tree), exclusive: f_exclusive, body: body_flat_list_stmt(f_body, &tree), vectorization: f_vectorization, span: f_span}
        .Range(f_label, f_variable, f_source, f_start, f_end, f_step, f_exclusive, f_vectorization, f_body, f_span) -> StmtKind.Range{label: f_label, variable: f_variable, source: body_flat_opt_expr(f_source, &tree), start: body_flat_expr(f_start, &tree), end: body_flat_expr(f_end, &tree), step: body_flat_opt_expr(f_step, &tree), exclusive: f_exclusive, vectorization: f_vectorization, body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .ExprStmt(f_value, f_span) -> StmtKind.ExprStmt{value: body_flat_expr(f_value, &tree), span: f_span}
        .Return(f_value, f_span) -> StmtKind.Return{value: body_flat_opt_expr(f_value, &tree), span: f_span}
        .TaskGroup(f_group, f_limit, f_body, f_span) -> StmtKind.TaskGroup{group: f_group, limit: body_flat_opt_expr(f_limit, &tree), body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .DeferClose(f_close, f_resource, f_span) -> StmtKind.DeferClose{close: body_flat_expr(f_close, &tree), resource: f_resource, span: f_span}
        .If(f_condition, f_then_body, f_else_body, f_else_is_elseif, f_span) -> StmtKind.If{condition: body_flat_if_cond(f_condition, &tree), then_body: body_flat_list_stmt(f_then_body, &tree), else_body: body_flat_opt_list_stmt(f_else_body, &tree), else_is_elseif: f_else_is_elseif, span: f_span}
        .Loop(f_label, f_body, f_span) -> StmtKind.Loop{label: f_label, body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .While(f_label, f_condition, f_body, f_span) -> StmtKind.While{label: f_label, condition: body_flat_expr(f_condition, &tree), body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .Break(f_label, f_span) -> StmtKind.Break{label: f_label, span: f_span}
        .BreakValue(f_label, f_value, f_span) -> StmtKind.BreakValue{label: f_label, value: body_flat_expr(f_value, &tree), span: f_span}
        .Continue(f_label, f_span) -> StmtKind.Continue{label: f_label, span: f_span}
        .Match(f_subject, f_arms, f_exhaustive, f_span) -> StmtKind.Match{subject: body_flat_expr(f_subject, &tree), arms: body_flat_list_match_arm(f_arms, &tree), exhaustive: f_exhaustive, span: f_span}
        .EnumMatch(f_scrutinee, f_arms, f_else_body, f_fallthrough, f_span) -> StmtKind.EnumMatch{scrutinee: body_flat_expr(f_scrutinee, &tree), arms: body_flat_list_match_arm(f_arms, &tree), else_body: body_flat_opt_list_stmt(f_else_body, &tree), fallthrough: f_fallthrough, span: f_span}
        .RangeSwitch(f_subject, f_arms, f_else_body, f_span) -> StmtKind.RangeSwitch{subject: body_flat_expr(f_subject, &tree), arms: body_flat_list_range_arm(f_arms, &tree), else_body: body_flat_list_stmt(f_else_body, &tree), span: f_span}
        .ForIn(f_label, f_variable, f_variable_two, f_source, f_collection, f_step, f_method_kind, f_columnar, f_by_value, f_source_stable, f_body, f_span) -> StmtKind.ForIn{label: f_label, variable: f_variable, variable_two: f_variable_two, source: body_flat_expr(f_source, &tree), collection: body_flat_expr(f_collection, &tree), step: body_flat_opt_expr(f_step, &tree), method_kind: f_method_kind, columnar: f_columnar, by_value: f_by_value, source_stable: f_source_stable, body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .Inline(f_body, f_span) -> StmtKind.Inline{body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .DebugOnly(f_body, f_span) -> StmtKind.DebugOnly{body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .MixedSwitch(f_subject, f_class, f_arms, f_else_body, f_span) -> StmtKind.MixedSwitch{subject: body_flat_expr(f_subject, &tree), class: f_class, arms: body_flat_list_mixed_arm(f_arms, &tree), else_body: body_flat_opt_list_stmt(f_else_body, &tree), span: f_span}
        .Unsafe(f_gate, f_body) -> StmtKind.Unsafe{gate: f_gate, body: body_flat_list_stmt(f_body, &tree)}
        .UnsafeBlock(f_gate, f_body, f_span) -> StmtKind.UnsafeBlock{gate: f_gate, body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .SentryPolicy(f_enabled, f_body, f_span) -> StmtKind.SentryPolicy{enabled: f_enabled, body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .Impure(f_body, f_span) -> StmtKind.Impure{body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .Reactive(f_executable, f_span) -> StmtKind.Reactive{executable: body_flat_lambda(f_executable, &tree), span: f_span}
        .Region(f_body, f_span) -> StmtKind.Region{body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .Layout(f_handle, f_label, f_body, f_span) -> StmtKind.Layout{handle: f_handle, label: f_label, body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .ContextBlock(f_guards, f_body, f_span) -> StmtKind.ContextBlock{guards: body_flat_list_context_guard(f_guards, &tree), body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .Live(f_body, f_span) -> StmtKind.Live{body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .Shield(f_body, f_span) -> StmtKind.Shield{body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .ScopeMember(f_kind, f_body, f_span) -> StmtKind.ScopeMember{kind: body_flat_scope_member_kind(f_kind, &tree), body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .Transact(f_handle, f_snapshots, f_stm, f_body, f_span) -> StmtKind.Transact{handle: f_handle, snapshots: f_snapshots, stm: f_stm, body: body_flat_list_stmt(f_body, &tree), span: f_span}
        .GCEdit(f_root, f_slot, f_edges, f_replace_all, f_index_temp, f_statement, f_span) -> StmtKind.GCEdit{root: f_root, slot: f_slot, edges: f_edges, replace_all: f_replace_all, index_temp: body_flat_opt_expr(f_index_temp, &tree), statement: body_flat_stmt(f_statement, &tree), span: f_span}
    }
}

fn body_flat_range_arm(value: TRangeArm, tree: &BodyTree) -> BodyRangeArm Never! {
    BodyRangeArm{
        lo: value.lo,
        hi: value.hi,
        body: body_flat_list_stmt(value.body, &tree),
    }
}

fn body_flat_mixed_arm(value: TMixedArm, tree: &BodyTree) -> BodyMixedArm Never! {
    BodyMixedArm{
        condition: body_flat_expr(value.condition, &tree),
        body: body_flat_list_stmt(value.body, &tree),
    }
}

fn body_flat_context_guard(value: TContextGuard, tree: &BodyTree) -> BodyContextGuard Never! {
    BodyContextGuard{
        field: value.field,
        value: body_flat_expr(value.value, &tree),
    }
}

fn body_flat_expr_kind(value: TExprKind, tree: &BodyTree) -> NodeKind Never! {
    if value == {
        .IntLit(f_value, f_width) -> NodeKind.IntLit{value: f_value, width: f_width}
        .FloatLit(f_value) -> NodeKind.FloatLit{value: f_value}
        .BoolLit(f_value) -> NodeKind.BoolLit{value: f_value}
        .CharLit(f_value) -> NodeKind.CharLit{value: f_value}
        .StrLit(f_parts) -> NodeKind.StrLit{parts: body_flat_list_str_part(f_parts, &tree)}
        .Local(f_local) -> NodeKind.Local{local: f_local}
        .Unit -> NodeKind.Unit
        .InlineBlock(f_body) -> NodeKind.InlineBlock{body: body_flat_list_stmt(f_body, &tree)}
        .Uninit -> NodeKind.Uninit
        .CtLit(f_value) -> NodeKind.CtLit{value: f_value}
        .ConstRef(f_symbol) -> NodeKind.ConstRef{symbol: f_symbol}
        .GlobalShared(f_initializer, f_lifetime) -> NodeKind.GlobalShared{initializer: f_initializer, lifetime: f_lifetime}
        .Call(f_callee, f_type_args, f_args) -> NodeKind.Call{callee: f_callee, type_args: f_type_args, args: body_flat_list_call_arg(f_args, &tree)}
        .IndirectCall(f_callee, f_type_args, f_args, f_signature) -> NodeKind.IndirectCall{callee: body_flat_expr(f_callee, &tree), type_args: f_type_args, args: body_flat_list_call_arg(f_args, &tree), signature: f_signature}
        .MethodCall(f_receiver, f_method, f_type_args, f_args) -> NodeKind.MethodCall{receiver: body_flat_expr(f_receiver, &tree), method: f_method, type_args: f_type_args, args: body_flat_list_call_arg(f_args, &tree)}
        .DistinctCtor(f_argument) -> NodeKind.DistinctCtor{argument: body_flat_expr(f_argument, &tree)}
        .DistinctConvert(f_owner, f_argument, f_operation, f_range, f_fallible) -> NodeKind.DistinctConvert{owner: f_owner, argument: body_flat_expr(f_argument, &tree), operation: f_operation, range: f_range, fallible: f_fallible}
        .TraitBox(f_value, f_target) -> NodeKind.TraitBox{value: body_flat_expr(f_value, &tree), target: f_target}
