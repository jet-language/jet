fn body_flat_require_kind(value: TRequireKind, tree: &BodyTree) -> BodyRequireKind Never! {
    if value == {
        .Require(f_cond, f_msg) -> BodyRequireKind.Require{cond: body_flat_expr(f_cond, &tree), msg: body_flat_opt_expr(f_msg, &tree)}
        .RequireEq(f_left, f_right) -> BodyRequireKind.RequireEq{left: body_flat_expr(f_left, &tree), right: body_flat_expr(f_right, &tree)}
        .Panic(f_msg) -> BodyRequireKind.Panic{msg: body_flat_expr(f_msg, &tree)}
    }
}

fn body_flat_lambda(value: TLambda, tree: &BodyTree) -> BodyLambda Never! {
    BodyLambda{
        executable: body_flat_lambda_body(value.executable, &tree),
        source_span: value.source_span,
        frame_schedule: value.frame_schedule,
        frame_schedule_derivation: value.frame_schedule_derivation,
        capture_facts: value.capture_facts,
        failure_carrier: value.failure_carrier,
        effects: value.effects,
        host_param_conventions: value.host_param_conventions,
        source_params: value.source_params,
        source_param_symbols: value.source_param_symbols,
        param_types: value.param_types,
        ret: value.ret,
        is_move: value.is_move,
        boxed: value.boxed,
        rc: value.rc,
        captures: value.captures,
        materialized_captures: value.materialized_captures,
        frozen_captures: value.frozen_captures,
        uses_stack_sentry: value.uses_stack_sentry,
    }
}

fn body_flat_lambda_body(value: TLambdaBody, tree: &BodyTree) -> BodyLambdaBody Never! {
    if value == {
        .Expr(f_value) -> BodyLambdaBody.Expr{value: body_flat_expr(f_value, &tree)}
        .Block(f_body) -> BodyLambdaBody.Block{body: body_flat_list_stmt(f_body, &tree)}
    }
}

fn body_flat_parameter(value: TParameter, tree: &BodyTree) -> BodyParameter Never! {
    BodyParameter{
        local: value.local,
        name: value.name,
        span: value.span,
        ty: value.ty,
        convention: value.convention,
        public_label: value.public_label,
        zone: value.zone,
        default: body_flat_opt_expr(value.default, &tree),
        variadic: value.variadic,
    }
}

fn body_flat_place(value: TPlace, tree: &BodyTree) -> BodyPlace Never! {
    if value == {
        .Local(f_local) -> BodyPlace.Local{local: f_local}
        .Expr(f_value) -> BodyPlace.Expr{value: body_flat_expr(f_value, &tree)}
    }
}

fn body_flat_list_parameter(values: [TParameter], tree: &BodyTree) -> [BodyParameter] Never! {
    result := [BodyParameter]{}
    loop value in values -> &result.push(body_flat_parameter(value, &tree))
    result
}

fn body_flat_list_stmt(values: [TStmt], tree: &BodyTree) -> [Int] Never! {
    result := [Int]{}
    loop value in values -> &result.push(body_flat_stmt(value, &tree))
    result
}

