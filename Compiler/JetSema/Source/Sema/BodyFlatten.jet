fn body_flat_struct_field_value(value: TStructFieldValue, tree: &BodyTree) -> BodyStructFieldValue Never! {
    BodyStructFieldValue{
        field: value.field,
        value: body_flat_expr(value.value, &tree),
        boxed: value.boxed,
    }
}

fn body_flat_map_entry(value: TMapEntry, tree: &BodyTree) -> BodyMapEntry Never! {
    BodyMapEntry{
        key: body_flat_expr(value.key, &tree),
        value: body_flat_expr(value.value, &tree),
    }
}

fn body_flat_list_spread_part(value: TListSpreadPart, tree: &BodyTree) -> BodyListSpreadPart Never! {
    if value == {
        .Element(f_value) -> BodyListSpreadPart.Element{value: body_flat_expr(f_value, &tree)}
        .Spread(f_value) -> BodyListSpreadPart.Spread{value: body_flat_expr(f_value, &tree)}
    }
}

fn body_flat_scope_member_kind(value: TScopeMemberKind, tree: &BodyTree) -> BodyScopeMemberKind Never! {
    if value == {
        .Setup -> BodyScopeMemberKind.Setup
        .ExpectFail(f_code, f_message) -> BodyScopeMemberKind.ExpectFail{code: f_code, message: f_message}
        .Timeout(f_duration) -> BodyScopeMemberKind.Timeout{duration: body_flat_expr(f_duration, &tree)}
        .Measure -> BodyScopeMemberKind.Measure
        .Skip -> BodyScopeMemberKind.Skip
    }
}

fn body_flat_or_fallback(value: TOrFallback, tree: &BodyTree) -> BodyOrFallback Never! {
    if value == {
        .Value(f_value) -> BodyOrFallback.Value{value: body_flat_expr(f_value, &tree)}
        .Return(f_value) -> BodyOrFallback.Return{value: body_flat_opt_expr(f_value, &tree)}
        .Panic(f_message, f_location) -> BodyOrFallback.Panic{message: body_flat_expr(f_message, &tree), location: f_location}
        .Break -> BodyOrFallback.Break
        .Continue -> BodyOrFallback.Continue
        .BreakLabel(f_label) -> BodyOrFallback.BreakLabel{label: f_label}
        .ContinueLabel(f_label) -> BodyOrFallback.ContinueLabel{label: f_label}
    }
}

fn body_flat_host_call(value: THostCall, tree: &BodyTree) -> BodyHostCall Never! {
    if value == {
        .Method(f_receiver, f_method, f_args) -> BodyHostCall.Method{receiver: body_flat_expr(f_receiver, &tree), method: f_method, args: body_flat_list_expr(f_args, &tree)}
        .CellGuardProject(f_receiver, f_paths, f_result_type, f_editable, f_edit_paths_disjoint) -> BodyHostCall.CellGuardProject{receiver: body_flat_expr(f_receiver, &tree), paths: f_paths, result_type: f_result_type, editable: f_editable, edit_paths_disjoint: f_edit_paths_disjoint}
        .TypedText(f_kind, f_argument) -> BodyHostCall.TypedText{kind: f_kind, argument: body_flat_expr(f_argument, &tree)}
        .OptionProbe(f_inner, f_kind) -> BodyHostCall.OptionProbe{inner: body_flat_expr(f_inner, &tree), kind: f_kind}
        .TupleIndex(f_base, f_index) -> BodyHostCall.TupleIndex{base: body_flat_expr(f_base, &tree), index: f_index}
        .SwitchSubjectValue -> BodyHostCall.SwitchSubjectValue
        .YieldSend(f_value) -> BodyHostCall.YieldSend{value: body_flat_expr(f_value, &tree)}
        .TypedTextInterp(f_kind, f_literals, f_holes, f_trusted_html) -> BodyHostCall.TypedTextInterp{kind: f_kind, literals: f_literals, holes: body_flat_list_expr(f_holes, &tree), trusted_html: f_trusted_html}
        .NumericBounds(f_ty, f_member) -> BodyHostCall.NumericBounds{ty: f_ty, member: f_member}
        .ComptimeInput(f_builtin, f_path) -> BodyHostCall.ComptimeInput{builtin: f_builtin, path: f_path}
    }
}

fn body_flat_core_closure_kind(value: TCoreClosureKind, tree: &BodyTree) -> BodyCoreClosureKind Never! {
    if value == {
        .Spawn(f_group, f_site, f_label, f_executable) -> BodyCoreClosureKind.Spawn{group: body_flat_opt_expr(f_group, &tree), site: f_site, label: f_label, executable: body_flat_lambda(f_executable, &tree)}
        .Realtime(f_rate, f_frames, f_executable) -> BodyCoreClosureKind.Realtime{rate: body_flat_expr(f_rate, &tree), frames: body_flat_expr(f_frames, &tree), executable: body_flat_lambda(f_executable, &tree)}
        .Guard(f_executable) -> BodyCoreClosureKind.Guard{executable: body_flat_lambda(f_executable, &tree)}
        .OnCommit(f_handle_name, f_executable) -> BodyCoreClosureKind.OnCommit{handle_name: f_handle_name, executable: body_flat_lambda(f_executable, &tree)}
        .OnRollback(f_handle_name, f_executable) -> BodyCoreClosureKind.OnRollback{handle_name: f_handle_name, executable: body_flat_lambda(f_executable, &tree)}
        .UIButtonOnClick(f_label, f_shortcut, f_accessible_label, f_executable) -> BodyCoreClosureKind.UIButtonOnClick{label: body_flat_expr(f_label, &tree), shortcut: body_flat_expr(f_shortcut, &tree), accessible_label: body_flat_expr(f_accessible_label, &tree), executable: body_flat_lambda(f_executable, &tree)}
        .UITextInputOnDrop(f_state, f_ime, f_executable) -> BodyCoreClosureKind.UITextInputOnDrop{state: body_flat_expr(f_state, &tree), ime: body_flat_expr(f_ime, &tree), executable: body_flat_lambda(f_executable, &tree)}
        .ReactiveDerived(f_executable) -> BodyCoreClosureKind.ReactiveDerived{executable: body_flat_lambda(f_executable, &tree)}
        .ReactiveEffect(f_executable) -> BodyCoreClosureKind.ReactiveEffect{executable: body_flat_lambda(f_executable, &tree)}
        .UIReactiveRender(f_executable) -> BodyCoreClosureKind.UIReactiveRender{executable: body_flat_lambda(f_executable, &tree)}
    }
}

fn body_flat_fn_value_kind(value: TFnValueKind, tree: &BodyTree) -> BodyFnValueKind Never! {
    if value == {
        .NamedFn(f_name, f_lambda) -> BodyFnValueKind.NamedFn{name: f_name, lambda: body_flat_opt_lambda(f_lambda, &tree)}
        .Policy(f_fn_type, f_policy_args, f_policy_conventions, f_wrapper_name, f_captures, f_callee) -> BodyFnValueKind.Policy{fn_type: f_fn_type, policy_args: body_flat_list_call_arg(f_policy_args, &tree), policy_conventions: f_policy_conventions, wrapper_name: f_wrapper_name, captures: f_captures, callee: body_flat_expr(f_callee, &tree)}
        .Call(f_callee, f_args) -> BodyFnValueKind.Call{callee: body_flat_expr(f_callee, &tree), args: body_flat_list_call_arg(f_args, &tree)}
        .Send(f_value) -> BodyFnValueKind.Send{value: body_flat_expr(f_value, &tree)}
    }
}

