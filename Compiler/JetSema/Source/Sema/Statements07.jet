//RS //! Parallel sema work: a bounded pool of compiler-stack workers that see the
//RS //! same thread-local compiler context as the checking thread.
//RS //!
//RS //! Callers hand in independent jobs and get the results back in job order,
//RS //! then merge them serially in source order. That keeps every diagnostic,
//RS //! fact and checked body identical to a serial run; `JET_CHECK_THREADS=1`
//RS //! runs the same jobs inline, in order, for debugging and for comparing the
//RS //! two.
//RS 
//RS /// Default upper bound on sema workers. Each worker holds a full checker and
//RS /// may lower whole-module comptime fragments, so the peak grows with the
//RS /// worker count; `JET_CHECK_THREADS` sets a different count explicitly.
//RS const MAX_CHECK_WORKERS: usize = 8;
//RS 
//RS /// Workers for `jobs` independent jobs: `JET_CHECK_THREADS` when set to a
//RS /// positive number, otherwise the machine's available parallelism, capped by
//RS /// the job count and `MAX_CHECK_WORKERS`. The setting only changes how the
//RS /// work is scheduled, never its result, so it is read directly rather than
//RS /// through `CheckReads` (it is not an input of the checked program).
//RS pub(crate) fn check_worker_count(jobs: usize) -> usize {
//RS     let requested = std::env::var("JET_CHECK_THREADS")
