// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3781
pub fn statically_bounded_for_iterations(kind: ForKind) -> U64? {
    return if kind == {
        .Range(start, end, step, exclusive) -> {
            if start != .Int(a, ..) -> return None
            if end != .Int(b, ..) -> return None
            stride: I128 :: if step == {
                .Val(.Int(s, ..)) if s > 0 -> s as I128
                .None -> 1
                _ -> return None
            }
            if exclusive {
                if b <= a -> return Val(0)
                return U64.try_from(((b as I128 - a as I128) + stride - 1) / stride).ok()
            }
            if b < a -> return Val(0)
            U64.try_from(((b as I128 - a as I128) / stride) + 1).ok()
        }
        .In(.ListLit(items, _), step) -> {
            len :: U64.try_from(items.len()).ok()?
            stride: U64 :: if step == {
                .Val(.Int(s, ..)) if s > 0 -> s as U64
                .None -> 1
                _ -> return None
            }
            Val(len.div_ceil(stride))
        }
        .In(..) -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3831
pub fn range_end_len_root(end: Expr) -> String? {
    return if end == {
        .MethodCall{receiver, method, args, ..} if method == "len" && args.is_empty() ->
            collection_root_name(receiver).or_else(() -> expr_root_ident(receiver).map(name -> ~name))
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3846
pub fn stmts_index_root_with(body: [Stmt], root: String, index_var: String) -> Bool {
    return body.iter().any(s -> stmt_indexes_root_with(s, root, index_var))
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3851
pub fn stmt_indexes_root_with(stmt: Stmt, root: String, index_var: String) -> Bool {
    return if stmt == {
        .Expr(e) | .DeferClose{close: e, ..} | .Return(.Val(e), _) -> expr_indexes_root_with(e, root, index_var)
        .Val(b) -> expr_indexes_root_with(b.init, root, index_var)
        .Assign{target, value, ..} -> lvalue_indexes_root_with(target, root, index_var) || expr_indexes_root_with(value, root, index_var)
        .While{cond, body, ..} -> expr_indexes_root_with(cond, root, index_var) || stmts_index_root_with(body, root, index_var)
        .For{kind, body, ..} -> {
            kind_hits :: if kind == {
                .Range(start, end, step, _) -> expr_indexes_root_with(start, root, index_var) || expr_indexes_root_with(end, root, index_var) || step.is_some_and(s -> expr_indexes_root_with(s, root, index_var))
                .In(collection, step) -> expr_indexes_root_with(collection, root, index_var) || step.is_some_and(s -> expr_indexes_root_with(s, root, index_var))
            }
            kind_hits || stmts_index_root_with(body, root, index_var)
        }
        .Loop{body, ..} | .Unsafe{body, ..} | .Region{body, ..} -> stmts_index_root_with(body, root, index_var)
        .CountedLoop{init, cond, step, body, ..} ->
            expr_indexes_root_with(init.init, root, index_var) || expr_indexes_root_with(cond, root, index_var) || step.is_some_and(s -> stmt_indexes_root_with(s, root, index_var)) || stmts_index_root_with(body, root, index_var)
        .Switch{subject, arms, else_body, ..} | .ComptimeSwitch{subject, arms, else_body, ..} ->
            expr_indexes_root_with(subject, root, index_var) || arms.iter().any(a -> expr_indexes_root_with(a.cond, root, index_var) || stmts_index_root_with(a.body, root, index_var)) || else_body.is_some_and(b -> stmts_index_root_with(b, root, index_var))
        _ -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3927
pub fn lvalue_indexes_root_with(lv: LValue, root: String, index_var: String) -> Bool {
    return if lv == {
        .Index{base, index, ..} -> (expr_root_ident(base) == Val(root) && expr_is_ident(index, index_var)) || expr_indexes_root_with(base, root, index_var) || expr_indexes_root_with(index, root, index_var)
        _ -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3939
pub fn expr_is_ident(expr: Expr, name: String) -> Bool {
    return if expr == { .Ident(n, _) -> n == name; _ -> false }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3943
pub fn expr_indexes_root_with(expr: Expr, root: String, index_var: String) -> Bool {
    return if expr == {
        .Index{base, index, ..} -> (expr_root_ident(base) == Val(root) && expr_is_ident(index, index_var)) || expr_indexes_root_with(base, root, index_var) || expr_indexes_root_with(index, root, index_var)
        .Str(parts, _) -> parts.iter().any(p -> if p == {
            .Interp(inner, _) -> expr_indexes_root_with(inner, root, index_var)
            .Lit(_) -> false
        })
        .Call(c) -> c.args.iter().any(a -> expr_indexes_root_with(a.expr, root, index_var))
        .CallValue{callee, args, ..} -> expr_indexes_root_with(callee, root, index_var) || args.iter().any(a -> expr_indexes_root_with(a.expr, root, index_var))
        .MethodCall{receiver, args, ..} -> expr_indexes_root_with(receiver, root, index_var) || args.iter().any(a -> expr_indexes_root_with(a.expr, root, index_var))
        .Field(inner, _, _) | .Spread(inner, _) | .Copy(inner, _) | .RawOf(inner, _) | .Place(inner, _, _) | .Present(inner, _) | .Tainted(inner, _, _) | .Ok(inner, _) | .Err(inner, _) -> expr_indexes_root_with(inner, root, index_var)
        .Try(inner, _, _, note) -> expr_indexes_root_with(inner, root, index_var) || note.is_some_and(n -> expr_indexes_root_with(n, root, index_var))
        .Binary(_, left, right, _) -> expr_indexes_root_with(left, root, index_var) || expr_indexes_root_with(right, root, index_var)
        .ListLit(items, _) -> items.iter().any(e -> expr_indexes_root_with(e, root, index_var))
        .TupleLit(items, _, _) -> items.iter().any(pair -> expr_indexes_root_with(pair.1, root, index_var))
        .Slice{base, start, end, range, ..} -> expr_indexes_root_with(base, root, index_var) || (if range == {
            .Val(r) -> expr_indexes_root_with(r, root, index_var)
            .None -> expr_indexes_root_with(start, root, index_var) || expr_indexes_root_with(end, root, index_var)
        })
        .OrFallback{value, ..} -> expr_indexes_root_with(value, root, index_var)
        .If{cond, then_body, then_value, else_body, else_value, ..} ->
            expr_indexes_root_with(cond, root, index_var) || stmts_index_root_with(then_body, root, index_var) || expr_indexes_root_with(then_value, root, index_var) || stmts_index_root_with(else_body, root, index_var) || expr_indexes_root_with(else_value, root, index_var)
        _ -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:4032
pub fn prefer_compound_assign(target: LValue, value: Expr) -> (String, BinOp, String)? {
    if target == .Index{..} -> return None
    if value.without_parens() != .Binary(op, left, _, _) -> return None
    compound :: op.compound_spell()?
    if !lvalue_same_place(target, left) -> return None
    return Val((lvalue_spell(target)?, op, compound))
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:4049
pub fn lvalue_same_place(lv: LValue, expr: Expr) -> Bool {
    return if (lv, expr.without_parens()) == {
        (.Local{name, ..}, .Ident(n, _)) -> name == n
        (.Field{base, field, ..}, .Field(b, f, _)) -> field == f && expr_same_place(base, b)
        _ -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:4059
pub fn expr_same_place(a: Expr, b: Expr) -> Bool {
    return if (a.without_parens(), b.without_parens()) == {
        (.Ident(n1, _), .Ident(n2, _)) -> n1 == n2
        (.Field(b1, f1, _), .Field(b2, f2, _)) -> f1 == f2 && expr_same_place(b1, b2)
        (.Index{base: b1, index: i1, ..}, .Index{base: b2, index: i2, ..}) -> expr_same_place(b1, b2) && expr_same_place(i1, i2)
        _ -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:4079
pub fn lvalue_spell(lv: LValue) -> String? {
    return if lv == {
        .Local{name, ..} -> Val(~name)
        .Field{base, field, ..} -> Val("{expr_place_spell(base)?}.{field}")
        .Index{..} -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:4087
pub fn expr_place_spell(expr: Expr) -> String? {
    return if expr.without_parens() == {
        .Ident(name, _) -> Val(~name)
        .Field(base, field, _) -> Val("{expr_place_spell(base)?}.{field}")
        .Index{base, index, ..} -> Val("{expr_place_spell(base)?}[{expr_place_spell(index).unwrap_or_else(() -> "…")}]")
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fields_ptrs.rs:8
pub fn infer_core_field(self: &Checker, alias: String, module: String, name: String, alias_span: Span, span: Span) -> Type? {
    if module == "core.encoding" && alias == "DataTree" && ["Null", "Bool", "Int", "Float", "Text", "Array", "Object"].contains(name) {
        self.record_import_alias_reference(alias, alias_span)
        return Val(json_ty())
    }
    if module == "core.encoding" && ["DataEvent", "EncodingErrorKind", "EncodingFormat"].contains(alias) && self.resolve_enum_variants_cloned(alias).is_some_and(variants -> variants.contains_key(name)) {
        self.record_import_alias_reference(alias, alias_span)
        return Val(Type.Named(~alias))
    }
    if self.core_item_imports.get(alias) == .Val(item) {
        core_enum :: if CoreModuleExports.core_leaf_kind(module, item) == {
            .Val(.Enum(_)) -> true
            _ -> false
        }
        if core_enum && self.resolve_enum_variants_cloned(item).is_some_and(variants -> variants.contains_key(name)) {
            self.record_import_alias_reference(alias, alias_span)
            return Val(Type.Named(~item))
        }
    }
    result :: if (module, name) == {
        ("core.math", "pi" | "e" | "tau" | "infinity" | "nan") -> Val(Type.Float)
        ("core.mem", "Arena") -> Val(Type.Named(Syntax.MEM_ARENA))
        ("core.mem", "Bump") -> Val(Type.Named(Syntax.MEM_BUMP))
        ("core.mem", "Pool") -> Val(Type.Named(Syntax.MEM_POOL))
        ("core.mem", "Fixed") -> Val(Type.Named(Syntax.MEM_FIXED))
        ("core.mem", "AllocError") -> Val(Type.Named(Syntax.TYPE_ALLOC_ERROR))
        ("core.compute.solve", "Solver") -> Val(Type.Named(Syntax.SOLVER_TYPE))
        ("core.game", "Scene") -> Val(Type.Named("GameSceneType"))
        ("core.game", "Replay") -> Val(Type.Named("GameReplayType"))
        ("core.game", "Backend") -> Val(Type.Named("GameBackendType"))
        ("core.net.tls", "ClientConfig") -> Val(Type.Named("TLSClientConfigType"))
        ("core.http.client", "Client") -> Val(Type.Named("HTTPClientType"))
        ("core.http.client", "Proxy") -> Val(Type.Named("HTTPProxy"))
        ("core.http.client", "RedirectPolicy") -> Val(Type.Named("HTTPRedirectPolicy"))
        ("core.http.client", "CookieJar") -> Val(Type.Named("HTTPCookieJar"))
        ("core.net.tls", "RootCertificates") -> Val(Type.Named("TLSRootCertificatesType"))
        ("core.net.tls", "ClientIdentity") -> Val(Type.Named("TLSClientIdentityType"))
        ("core.net.tls", "TLSVersion") -> Val(Type.Named("TLSVersion"))
        ("core.perf", "Perf") -> Val(Type.Named("Perf"))
        ("core.encoding", "DataEvent" | "EncodingLimits" | "EncodingError" | "EncodingCause" | "EncodingErrorKind" | "EncodingFormat") -> Val(Type.Named(~name))
        ("core.encoding.json", "JSONReader" | "JSONWriter") -> Val(Type.Named(~name))
        ("core.encoding.jsonl", "JSONLReader" | "JSONLWriter") -> Val(Type.Named(~name))
        ("core.encoding.csv", "CSVReader" | "CSVWriter" | "CSVRow") -> Val(Type.Named(~name))
        ("core.encoding.xml", "XMLReader" | "XMLWriter") -> Val(Type.Named(~name))
        ("core.encoding.cbor", "CBORReader" | "CBORWriter") -> Val(Type.Named(~name))
        _ -> {
            &self.diags.push(unknown_core_item(module, name, span))
            None
        }
    }
    if result.is_some() -> self.record_import_alias_reference(alias, alias_span)
    return ^result
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fields_ptrs.rs:129
pub fn infer_ptr_from_addr(self: &Checker, alias: String, alias_span: Span, elem: Type, addr: &Expr, span: Span) -> Type? {
    is_mem :: self.core_imports.get(alias).is_some_and(m -> m == Syntax.CORE_MEM_MODULE)
    if !is_mem {
        &self.diags.push(e3102(self, alias, alias_span))
        _ :: self.infer(&addr)
        return None
    }
    if Syntax.core_mem_requires_audit(Syntax.MEM_FROM_ADDR) && !self.in_unsafe -> &self.diags.push(e3101(Syntax.MEM_FROM_ADDR, span))
    if self.infer(&addr) == .Val(t) {
        valid :: if t == { .Int | .InlineRange{..} -> true; _ -> false }
        if !valid -> &self.diags.push(Diagnostic.error("E0112", "`{Syntax.MEM_FROM_ADDR}` needs an Int address, not {t.show()}", "a pointer is built from a numeric machine address", "pass an Int, e.g. from `mem.address_of(x)`", Val(addr.span())))
    }
    return Val(ptr_type(~elem))
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fields_ptrs.rs:173
pub fn e3102(self: Checker, alias: String, span: Span) -> Diagnostic {
    return Diagnostic.error("E3102", "`{Syntax.TYPE_PTR}` is part of the low-level tier", "naming `{Syntax.TYPE_PTR}`, `{Syntax.MEM_VOLATILE_READ}`, or an allocator needs the discovery gate", "add `use {Syntax.CORE_MEM_MODULE};` and call through `{alias}.…`", Val(span))
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/helpers_call_values.rs:7
pub fn is_inline_compute_transform(checker: Checker, expr: Expr) -> Bool {
    return if expr == {
        .Paren(inner, _) -> is_inline_compute_transform(checker, inner)
        .MethodCall{receiver, method, args, ..} ->
            ["gradient", "value_and_gradient", "vjp", "jvp"].contains(method) && core_module_path_from_receiver(checker, receiver).is_some_and(path -> path.0 == "core.compute") && args.iter().skip(1).all(arg -> arg.label.is_some_and(label -> label.0 == "wrt"))
        .CallValue{callee, ..} -> is_inline_compute_transform(checker, callee)
        _ -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/helpers_call_values.rs:34
pub fn synthesized_string_arg(value: String, span: Span) -> CallArg {
    return CallArg{convention: AccessConvention.Read, expr: Expr.Str([StrPart.Lit(^value)], span), span: span, flags: CallArgFlags.default(), label: None, spread: false}
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/helpers_call_values.rs:45
pub fn type_arg_name(t: Type) -> String {
    return if t == {
        .Named(n) -> ~n
        .Apply{name, args} if args.is_empty() -> ~name
        _ -> t.show()
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/helpers_call_values.rs:53
pub fn core_module_path_from_receiver(self: Checker, receiver: Expr) -> (String, String, Span)? {
    return if receiver == {
        .Ident(alias, span) if self.lookup(alias).is_none() -> self.core_imports.get(alias).map(module -> (~module, ~alias, span))
        .Field(base, leaf, _) -> {
            (module, alias, span) :: core_module_path_from_receiver(self, base)?
            submodule :: "{module}.{leaf}"
            if Syntax.is_known_core_module(submodule) -> Val((^submodule, ^alias, span)) else -> None
        }
        _ -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/helpers_call_values.rs:72
pub fn infer_call_value(self: &Checker, callee: &Expr, args: &[CallArg], span: Span) -> Type? {
    if is_inline_compute_transform(self, callee) {
        &self.diags.push(Diagnostic.lint("L1141", "an autodiff transform result is called inline", "the transform arity returns a callable; inline calls make it unclear whether a direct gradient or a derivative function was requested", "bind the derivative first, then call the binding: `d_loss :: compute.gradient(loss)`", Val(span)))
    }
    inline_loop :: if callee == { .Lambda(lam) -> lam.meta.collecting_loop || lam.meta.result_loop; _ -> false }
    call_access := self.call_access_frame()
    callee_ty := self.with_call_access(&call_access, checker -> {
        if !inline_loop -> checker.check_call_receiver_evaluation(callee, callee.span())
        saved_escapes :: checker.lambda_escapes
        if inline_loop -> checker.lambda_escapes = false
        inferred :: checker.infer(&callee)
        checker.lambda_escapes = saved_escapes
        if !inline_loop -> checker.check_call_argument_captures(callee)
        return ^inferred
    })?
    // Immediately evaluated collecting/open loops retain their source carrier.
    source_carrier :: if callee == {
        .Lambda(lam) -> lam.meta.collecting_loop || (lam.meta.result_loop && !lam.meta.requires_exhaustion_route)
        _ -> false
    }
    if !source_carrier -> callee_ty = callee_ty.with_effective_fn_returns()
    if callee_ty != .Fn{params, ret, effect_bound, param_contract, call_metadata, ..} {
        &self.diags.push(Diagnostic.error("E0803", "this is {callee_ty.show()}, not a function", "only a function value can be called with `.call(…)`", "call a defined `fn` by name, or store a lambda in a binding before `.call(…)`", Val(span)))
        for arg in &args -> _ :: self.infer(&arg.expr)
        return None
    }
    if callee == .Ident(name, _) && self.funcs.get(name) == .Val(sig) {
        if sig.deprecation == .Val(dep) -> self.check_deprecation(name, dep, span)
        self.check_foreign_transaction_call(sig, name, span)
    }
    if !inline_loop {
        if effect_bound == {
            .None -> {
                param_call :: if callee == { .Ident(name, _) -> self.lookup(name).is_some_and(info -> info.param_conv.is_some()); _ -> false }
                if !param_call -> self.record_maximal(span)
            }
            .Val(row) -> {
                for (effect, _) in row {
                    if effect_row_var(effect).is_none() && parse_effect_name(effect).is_some() -> self.record_effect(effect, span)
                }
            }
        }
    }
    metadata :: call_metadata
    bind: [BindParam] := []
    for index in 0..<params.len() {
        (label, zone) :: param_contract.and_then(contract -> contract.get(index)).unwrap_or(("", ParamZone.Either))
        &bind.push(BindParam{
            label: label,
            name: metadata.and_then(meta -> meta.names.get(index)).unwrap_or(label),
            zone: zone,
            default: metadata.and_then(meta -> meta.defaults.get(index)).and_then(value -> value),
            convention: metadata.and_then(meta -> meta.conventions.get(index)).unwrap_or(AccessConvention.Read),
            ty: params.get(index),
            variadic: metadata.and_then(meta -> meta.variadic.get(index)).unwrap_or(false),
            core_default: None,
        })
    }
    callee_name :: if callee == { .Ident(name, _) -> ~name; _ -> "this function value" }
    bound :: bind_call_args(callee_name, bind, &args, span, &self.diags)
    self.register_binder_refs(args)
    if bound.is_none() {
        for arg in &args -> _ :: self.infer(&arg.expr)
        return ret.map(r -> ~r)
    }
    if metadata.is_some_and(meta -> meta.variadic.last().unwrap_or(false)) {
        sig_params: [(AccessConvention, Type)] := []
        param_info: [(String, Bool)] := []
        for index in 0..<params.len() {
            convention :: metadata.and_then(meta -> meta.conventions.get(index)).unwrap_or(AccessConvention.Read)
            &sig_params.push((convention, ~params[index]))
            name :: metadata.and_then(meta -> meta.names.get(index)).map(n -> ~n).or_else(() -> param_contract.and_then(contract -> contract.get(index)).map(pair -> ~pair.0)).unwrap_or("")
            has_default :: metadata.and_then(meta -> meta.defaults.get(index)).is_some_and(value -> value.is_some())
            &param_info.push((^name, has_default))
        }
        fake_sig :: FuncSig{
            params: ^sig_params, root_param: false, return_type: ret.map(r -> ~r), deprecation: None,
            return_view_provenance: ViewProvenanceCell.new(),
            is_extern: false, is_unsafe: false, is_pure: false, memo_bound: None,
            is_foreign_thread_safe: false, is_sanitizer: false, is_must_use: false, is_c_abi: false,
            c_abi_name: None, callback_transport: None, callback_plan_digest: None, callback_identity: None,
            foreign_effect_root: None, undo: None, param_info: ^param_info,
            param_call: param_contract.map(contract -> ~contract).unwrap_or([]),
            defaults: metadata.map(meta -> ~meta.defaults).unwrap_or_else(() -> [None; params.len()]),
            param_variadic: metadata.map(meta -> ~meta.variadic).unwrap_or_else(() -> [false; params.len()]),
            variadic_bounds: None, param_view_from_names: [], callable_policies: CallablePolicyChain.default(),
        }
        packed := Call{name: ~callee_name, name_span: span, type_args: [], args: args.take(), resolved_ret: None, range_checked: false, widen_approx: false}
        self.normalize_variadic_call(&packed, fake_sig)
        args = ^packed.args
    }
    if args.len() != params.len() {
        plural :: if params.len() == 1 -> "" else -> "s"
        &self.diags.push(Diagnostic.error("E0104", "this function wants {params.len()} argument{plural}, got {args.len()}", "every argument must match a parameter", "check how many values this function expects", Val(span)))
    }
    for (i, arg) in args.iter_mut().enumerate() {
        if params.get(i) == .Val(param_ty) {
            param_convention :: metadata.and_then(meta -> meta.conventions.get(i)).unwrap_or(AccessConvention.Read)
            saved :: self.expected_type.take()
            saved_borrow :: self.borrow_ctx
            self.expected_type = Val(~param_ty)
            self.borrow_ctx = arg.convention == AccessConvention.Write || param_convention == AccessConvention.Write || (param_convention == AccessConvention.Read && !param_ty.is_scalar())
            inferred :: self.with_call_access(&call_access, checker -> {
                checker.check_call_argument_access(arg, param_convention, param_ty, true)
                result :: checker.infer(&arg.expr)
                checker.check_call_argument_captures(arg.expr)
                return ^result
            })
            self.expected_type = ^saved
            self.borrow_ctx = saved_borrow
            if inferred == .Val(got_initial) {
                widened :: self.widen_numeric_argument(&arg.expr, ^got_initial, param_ty, param_convention)
                got :: self.lift_optional_argument(&arg.expr, ^widened, param_ty, param_convention)
                boxes_as_trait :: self.trait_slot_accepts(param_ty, got)
                both_callable :: if (param_ty, got) == { (.Fn{..}, .Fn{..}) -> true; _ -> false }
                callable_shape_compatible :: both_callable && fn_types_compatible(param_ty, got)
                missing_strict_contract :: callable_shape_compatible && (if (param_ty, got) == {
                    (.Fn{param_contract: .Val(required), ..}, .Fn{param_contract: .None, ..}) -> required.iter().any(pair -> pair.1 == ParamZone.PositionalOnly || pair.1 == ParamZone.LabelOnly)
                    _ -> false
                })
                callable_compatible :: callable_shape_compatible && Type.obligations_satisfy(param_ty, got) && !missing_strict_contract
                if boxes_as_trait -> self.note_move_if_direct_ident(arg.expr, "the call")
                type_mismatch :: if both_callable -> !callable_compatible else -> !Type.compute_tensor_compatible(param_ty, got)
                if type_mismatch && !boxes_as_trait -> &self.diags.push(Diagnostic.error("E0112", "argument {i + 1} should be {param_ty.show()}, not {got.show()}", "every argument must match its parameter's type", type_fix_hint(param_ty, got), Val(arg.expr.span())))
            }
            self.check_callable_argument_ownership(callee_name, i, param_convention, param_ty, arg)
        } else {
            _ :: self.infer(&arg.expr)
        }
    }
    return ret.map(r -> ~r)
}

// Workers return job order; callers merge serially in source order.
// Rust: crates/jet-sema/src/Sema/Bundle/Parallel.rs:13
MAX_CHECK_WORKERS: USize :: 8

// Rust: crates/jet-sema/src/Sema/Bundle/Parallel.rs:20
pub fn check_worker_count(jobs: USize) -> USize {
    // GATE #4494: scheduling-only environment and native parallelism primitives.
    requested :: std.env.var("JET_CHECK_THREADS").ok().and_then(value -> {
        text := value.trim() // #4303
        return text.parse<USize>().ok()
    }).filter(threads -> threads > 0)
    threads :: requested.unwrap_or_else(() -> std.thread.available_parallelism().map(value -> value.get()).unwrap_or(1).min(MAX_CHECK_WORKERS))
    return threads.min(jobs).max(1)
}

// Rust: crates/jet-sema/src/Sema/Bundle/Parallel.rs:38
pub fn map_checked<T, R>(jobs: [T], work: fn(T) -> R) -> [R] {
    workers :: check_worker_count(jobs.len())
    if workers <= 1 -> return jobs.into_iter().map(work).collect()
    edition :: PackageEdition.package_edition()
    ambient :: ambient_runtime_snapshot()
    driver :: terminator_driver()
    // GATE #4494: compiler-stack workers and scoped TLS context propagation.
    return CompilerStack.map_on_compiler_workers(^jobs, workers, job ->
        PackageEdition.with_package_edition(edition, () ->
            with_terminator_driver(~driver, () ->
                with_ambient_runtime_snapshot(~ambient, () -> work(^job)))))
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:17
pub fn expand_item_template_loops(items: &[Item], base_dir: OSPath, diags: &[Diagnostic]) {
    has_loops :: items.iter().any(item -> if item == { .TemplateLoop(_) -> true; _ -> false })
    if !has_loops -> return
    (funcs_owned, _, globals) :: comptime_context_from_items(items)
    funcs :: funcs_owned.iter().map(pair -> (~pair.0, pair.1)).collect()
    source_items :: items.take()
    expanded_items: [Item] := []
    &expanded_items.reserve(source_items.len())
    for item in source_items {
        if item != .TemplateLoop(loop_item) {
            &expanded_items.push(^item)
            continue
        }
        template :: jet_foundation.DeriveBodyItem.Loop{
            var: ^loop_item.var, var_span: loop_item.var_span, source: ^loop_item.source,
            body: ^loop_item.body, span: loop_item.span,
        }
        if expand_template_body([template], globals, funcs, base_dir) == {
            .Ok(generated) -> &expanded_items.extend(^generated)
            .Err(diagnostic) -> &diags.push(^diagnostic)
        }
    }
    items = ^expanded_items
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:66
pub fn e0301_impl_target(i: ImplDef) -> Diagnostic {
    type_name :: i.type_name
    header :: i.trait_name.map(trait_name -> "{type_name}.{trait_name}").unwrap_or_else(() -> ~type_name)
    (leaf_ns, leaf) :: type_name.rsplit_once('.').map(pair -> (Val(pair.0), pair.1)).unwrap_or((None, type_name))
    built_in :: leaf_ns.is_none() && (builtin_type_from_ident(leaf).is_some() || core_type_known(leaf) || is_math_type(leaf) || is_reserved_type(leaf))
    (why, fix) :: if built_in {
        why :: "`{type_name}` is built in, and an `impl` only extends a struct, enum, or distinct type declared by your program"
        fix :: if i.trait_name == {
            .Val(trait_name) if is_operator_trait_name(trait_name) -> "call a named method, or implement `{trait_name}` on a struct or distinct type of your own (an operator hook on `{type_name}` belongs to the package that declares the other operand type, D-OPMIX1)"
            .Val(trait_name) -> "implement `{trait_name}` on a struct or distinct type of your own, or wrap `{type_name}` in one"
            .None -> "call a named method, or wrap `{type_name}` in a struct or distinct type of your own and implement the methods there"
        }
        (^why, ^fix)
    } else {
        why :: "no struct, enum, or distinct type named `{type_name}` is declared here, and an `impl` only extends a declared type"
        fix :: if leaf_ns == {
            .Val(ns) -> "export `{leaf}` from `{ns}` as a struct, enum, or distinct type, or check the spelling"
            .None -> "declare `struct {leaf}`, `enum {leaf}`, or `{leaf} :: distinct …` first, or check the spelling"
        }
        (^why, ^fix)
    }
    return Diagnostic.error("E0301", "`impl {header}` needs a user-defined type", ^why, ^fix, Val(i.type_span))
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:128
pub fn impl_target_is_builtin(type_name: String) -> Bool {
    (leaf_ns, leaf) :: type_name.rsplit_once('.').map(pair -> (Val(pair.0), pair.1)).unwrap_or((None, type_name))
    return leaf_ns.is_none() && (builtin_type_from_ident(leaf).is_some() || core_type_known(leaf) || is_math_type(leaf) || is_reserved_type(leaf))
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:139
pub fn is_operator_trait_name(name: String) -> Bool {
    return name == Syntax.TRAIT_ADD || name == Syntax.TRAIT_SUB || name == Syntax.TRAIT_MUL || name == Syntax.TRAIT_DIV || name == Syntax.TRAIT_EQUATABLE || name == Syntax.TRAIT_COMPARABLE
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:151
pub fn module_declares_named_type(items: [Item], name: String) -> Bool {
    return items.iter().any(item -> if item == {
        .Struct(definition) -> definition.name == name
        .Enum(definition) -> definition.name == name
        .Distinct(definition) -> definition.name == name
        .TypeAlias(definition) -> definition.name == name
        _ -> false
    })
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:164
pub fn opmix_allows_builtin_impl(implementation: ImplDef, items: [Item]) -> Bool {
    if !impl_target_is_builtin(implementation.type_name) -> return false
    if !implementation.trait_name.is_some_and(is_operator_trait_name) -> return false
    return if implementation.operator_rhs == {
        .Val(.Named(rhs)) -> rhs != implementation.type_name && module_declares_named_type(items, rhs)
        _ -> false
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:186
pub fn register_test_item(test: TestDef, state: &ModuleState, diags: &[Diagnostic]) {
    if test.name != .Val(name) -> return
    if name_defined(name, state.funcs, state.registry, state.consts) || state.tests.contains_key(name) {
        &diags.push(defined_twice(name, "every test needs a unique name so failures are easy to find", test.name_span))
    } else {
        &state.tests.insert(~name, test.name_span)
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:210
pub fn fact_identity(declaration: FactDecl) -> String {
    identity :: declaration.params.iter().find(parameter -> parameter.name == "$name").and_then(parameter -> parameter.value).and_then(value -> {
        if value != .Str(parts, _) -> return None
        text := ""
        for part in parts {
            if part == {
                .Lit(value) -> &text.push_str(value)
                .Interp(..) -> return None
            }
        }
        return Val(^text)
    })
    return identity.unwrap_or_else(() -> ~declaration.name)
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:232
pub fn register_fact_declaration(declaration: FactDecl, module_idx: USize, declarations: &[String:(USize, Span, String)], diags: &[Diagnostic]) {
    identity :: fact_identity(declaration)
    if declarations.get(identity) == .Val((first_module, first_span, first_source)) {
        &diags.push(Diagnostic.error("E0105", "fact `{identity}` is declared twice (spans {first_span.start}..{first_span.end} and {declaration.name_span.start}..{declaration.name_span.end})", "one fact name must resolve to one declaration in the loaded bundle", "rename or remove one of the fact declarations", Val(declaration.name_span))
            .with_detail("first declaration `{first_source}`: module {first_module}, span {first_span.start}..{first_span.end}\nsecond declaration `{declaration.name}`: module {module_idx}, span {declaration.name_span.start}..{declaration.name_span.end}"))
        return
    }
    &declarations.insert(^identity, (module_idx, declaration.name_span, ~declaration.name))
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:272
pub fn register_generated_union_enums(items: [Item], state: &ModuleState, diags: &[Diagnostic]) {
    for item in items {
        if item == {
            .Enum(definition) if definition.name.starts_with("__JetUnion_") && !state.registry.contains(definition.name) ->
                register_enum(definition, &state.registry, &diags, state.funcs, state.consts)
            .CodeModule(module) -> {
                if module.body == .Val(body) -> register_generated_union_enums(body, &state, &diags)
            }
            _ -> {}
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:301
pub fn existing_member_span(items: [Item], type_name: String, member: String) -> Span? {
    for item in items {
        if item == {
            .Struct(def) if def.name == type_name -> {
                if def.fields.iter().find(field -> field.name == member) == .Val(field) -> return Val(field.name_span)
                if def.methods.iter().find(method -> method.name == member) == .Val(method) -> return Val(method.name_span)
            }
            .Enum(def) if def.name == type_name -> {
                if def.methods.iter().find(method -> method.name == member) == .Val(method) -> return Val(method.name_span)
            }
            .Impl(def) if def.type_name == type_name -> {
                if def.methods.iter().find(method -> method.name == member) == .Val(method) -> return Val(method.name_span)
            }
            _ -> {}
        }
    }
    return None
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:328
pub fn block_source(source: String, body: [Stmt], block_spans: [Span], outer: Span) -> String {
    candidate :: if (body.first(), body.last()) == {
        (.Val(first), .Val(last)) -> block_spans.iter().filter(span -> span.start > outer.start && span.end < outer.end && span.start <= first.span().start && span.end >= last.span().end).max_by_key(span -> span.end.saturating_sub(span.start))
        _ -> block_spans.iter().filter(span -> span.start > outer.start && span.end < outer.end).min_by_key(span -> span.start)
    }
    return candidate.and_then(span -> source.get(span.start..<span.end)).unwrap_or("").to_string()
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:356
pub fn collect_declared_text_blocks(statements: [Stmt], source: String, block_spans: [Span], blocks: &[(String, String, Span)]) {
    for statement in statements {
        if statement == .ScopeMember{name, body, dsl: true, span, ..} -> &blocks.push((~name, block_source(source, body, block_spans, span), span))
        for child in statement_bodies(statement) -> collect_declared_text_blocks(child, source, block_spans, &blocks)
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:383
pub fn collect_item_declared_text_blocks(item: Item, source: String, block_spans: [Span], blocks: &[(String, String, Span)]) {
    if item == {
        .Func(function) -> collect_declared_text_blocks(function.body, source, block_spans, &blocks)
        .Test(test) -> collect_declared_text_blocks(test.body, source, block_spans, &blocks)
        .Impl(implementation) -> {
            for method in implementation.methods -> collect_declared_text_blocks(method.body, source, block_spans, &blocks)
        }
        .Struct(definition) -> {
            for method in definition.methods -> collect_declared_text_blocks(method.body, source, block_spans, &blocks)
            for implementation in definition.trait_impls {
                for method in implementation.methods -> collect_declared_text_blocks(method.body, source, block_spans, &blocks)
            }
        }
        .Enum(definition) -> {
            for method in definition.methods -> collect_declared_text_blocks(method.body, source, block_spans, &blocks)
            for implementation in definition.trait_impls {
                for method in implementation.methods -> collect_declared_text_blocks(method.body, source, block_spans, &blocks)
            }
        }
        .CodeModule(module) -> {
            if module.body == .Val(body) {
                for child in body -> collect_item_declared_text_blocks(child, source, block_spans, &blocks)
            }
        }
        _ -> {}
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:430
pub fn derive_member_collision(derive_name: String, type_name: String, method: Func, existing_site: String, existing_span: Span) -> Diagnostic {
    return Diagnostic.error("E0105", "generated method `{method.name}` from `derive T.{derive_name}` collides with {existing_site}", "`derive T.{derive_name}` and {existing_site} both define a member named `{method.name}` on `{type_name}`", "rename the generated member in `derive T.{derive_name}`, or rename the colliding member", Val(method.name_span))
        .with_detail("generated member `{method.name}` from `derive T.{derive_name}` at span {method.name_span.start}..{method.name_span.end}\n{existing_site} at span {existing_span.start}..{existing_span.end}")
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:465
pub fn validate_foreign_imports(bundle: ProgramBundle) -> [Diagnostic] {
    diagnostics: [Diagnostic] := []
    seen: [(USize, Span):Bool] := [:]
    seen_aliases: [(USize, String?):[String:Bool]] := [:]
    for (module_idx, module) in bundle.modules.iter().enumerate() {
        for (scope, import) in jet_foundation.walk_imports(module) {
            identity :: (module_idx, import.span)
            if seen.contains_key(identity) -> continue
            &seen.insert(identity, true)
            foreign :: if import.foreign_imports() == {
                .Ok(foreign) -> ^foreign
                .Err(error) -> {
                    &diagnostics.push(error.diagnostic())
                    continue
                }
            }
            if foreign.is_empty() -> continue
            aliases :: &seen_aliases.entry((module_idx, scope.map(name -> ~name))).or_insert([:])
            for (_, alias) in foreign {
                if !aliases.contains_key(alias) {
                    &aliases.insert(^alias, true)
                    continue
                }
                &diagnostics.push(Diagnostic.error("E0105", "the import name `{alias}` is used twice", "each import needs a unique namespace name in this file", "rename one with `{Syntax.KW_AS} alias`", Val(import.alias_span)))
            }
        }
    }
    return ^diagnostics
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:504
pub fn foreign_imports_after_validation(import: ImportDecl) -> [(ForeignNamespace, String)] {
    return import.foreign_imports().unwrap_or_else(error -> panic("invalid foreign import reached sema after validation: {error.path}"))
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:515
pub fn is_c_import_after_validation(import: ImportDecl) -> Bool {
    return import.is_c_import().unwrap_or_else(error -> panic("invalid foreign import reached sema after validation: {error.path}"))
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:524
pub fn check_bundle_opts_for_output(bundle: &ProgramBundle, mode: CompileMode, no_os: Bool, gates: GateSet, explicit_output: String?, incremental: &IncrementalSemaCache?) -> ([Diagnostic], SemIndexEffectFacts) {
    return check_bundle_opts_for_output_with_context(&bundle, mode, no_os, gates, explicit_output, &incremental, false)
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:565
pub fn check_bundle_opts_for_output_with_context(bundle: &ProgramBundle, mode: CompileMode, no_os: Bool, gates: GateSet, explicit_output: String?, incremental: &IncrementalSemaCache?, allow_compiler_api: Bool) -> ([Diagnostic], SemIndexEffectFacts) {
    // Re-entrancy is checked before any capture/spawn.
    // GATE #4494: native compiler-stack and ambient TLS boundary.
    if CompilerStack.on_compiler_worker() -> return check_bundle_opts_for_output_on_stack(&bundle, mode, no_os, gates, explicit_output, &incremental, allow_compiler_api)
    (ambient_core_call, ambient_handle, ambient_extern_call) :: ambient_hooks()
    return CompilerStack.run_on_compiler_stack(() ->
        with_ambient(ambient_core_call, ambient_handle, ambient_extern_call, () ->
            check_bundle_opts_for_output_on_stack(&bundle, mode, no_os, gates, explicit_output, &incremental, allow_compiler_api)))
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:606
pub fn check_bundle_opts_for_output_on_stack(bundle: &ProgramBundle, mode: CompileMode, no_os: Bool, gates: GateSet, explicit_output: String?, incremental: &IncrementalSemaCache?, allow_compiler_api: Bool) -> ([Diagnostic], SemIndexEffectFacts) {
    edition :: ~bundle.edition
    (diags, facts) :: PackageEdition.with_package_edition(edition, () ->
        check_bundle_opts_for_output_inner(&bundle, mode, no_os, gates, explicit_output, &incremental, allow_compiler_api))
    return (summarize_dependency_reports(bundle, ^diags), ^facts)
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:634
pub fn summarize_dependency_reports(bundle: ProgramBundle, diags: [Diagnostic]) -> [Diagnostic] {
    if bundle.dep_roots.is_empty() -> return ^diags
    failing: [String:OSPath] := [:]
    kept: [Diagnostic] := []
    &kept.reserve(diags.len())
    for diagnostic in diags {
        owner :: diagnostic.origin().and_then(origin -> {
            path :: OSPath.new(origin.path)
            return bundle.dep_roots.iter().filter(pair -> path.starts_with(pair.1)).max_by_key(pair -> pair.1.components().count())
        })
        if owner == {
            .Val((name, root)) -> {
                if diagnostic.severity == Severity.Error -> &failing.insert(~name, ~root)
            }
            .None -> &kept.push(^diagnostic)
        }
    }
    packages := failing.keys().collect()
    &packages.sort()
    for package in packages {
        root :: failing[package]
        displayed :: root.strip_prefix(bundle.project_root).unwrap_or(root).display().to_string()
        &kept.push(Diagnostic.from_row("E0626", [("package", package), ("root", displayed)], None))
    }
    return ^kept
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:679
pub fn guard_fact_registry_law() {
    if Registry.law_violations().into_iter().next() == .Val(violation) -> jet_foundation.ice(None, "fact registry law violation: {violation}")
}

// Rust: crates/jet-sema/src/Sema/Bundle/Pipeline.rs:692
pub fn default_entry_return(bundle: &ProgramBundle) {
    if bundle.modules.get_mut(bundle.entry) != .Val(module) -> return
    for item in &module.items {
        if item == .Func(function) && function.name == "run" {
            if function.return_type.is_none() -> function.return_type = Val(Type.Result{ok: Type.Named(Syntax.INTERNAL_UNIT_TYPE), err: Type.Named(Syntax.TYPE_ERR)})
            return
        }
    }
}

