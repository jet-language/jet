//RS             .map(std::num::NonZeroUsize::get)
//RS             .unwrap_or(1)
//RS             .min(MAX_CHECK_WORKERS)
//RS     });
//RS     threads.min(jobs).max(1)
//RS }
//RS 
//RS /// Run `work` on every job with `check_worker_count` workers and return the
//RS /// results in job order. Each worker runs with the checking thread's package
//RS /// edition, comptime ambient hooks and terminator-pass driver, the
//RS /// thread-local context body checking reads.
//RS pub(crate) fn map_checked<T: Send, R: Send>(
