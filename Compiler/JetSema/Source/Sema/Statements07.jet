//RS         no_os,
//RS         gates,
//RS         explicit_output,
//RS         incremental,
//RS         false,
//RS     )
//RS }
//RS 
//RS /// Checking is an unbounded-depth recursive descent over user syntax, so the
//RS /// frame requirement is per source-nesting level, not per program size. This is
//RS /// the narrowest point every public `check_bundle*` shares, so the sized
//RS /// stack is installed here instead of being chased caller by caller:
//RS /// `Sema::check_bundle` and its siblings are public API, and an embedder
//RS /// holding its own bundle — or a 2 MiB libtest worker — would otherwise run
//RS /// the descent on whatever stack it happens to have, aborting the process on
//RS /// overflow.
//RS ///
//RS /// The re-entrancy flag is shared in `jet-foundation`, so an outer boundary
//RS /// already on the worker (a driver funnel, a JIT public entry, the loader)
//RS /// makes this run inline: the check comes *first*, so the inline path does no
//RS /// capture and no spawn.
//RS ///
//RS /// Thread-locals across the spawn. `PACKAGE_EDITION` is established *inside*
//RS /// the worker from `bundle.edition`, so `with_package_edition` stays under the
//RS /// boundary rather than over it. The comptime ambient hooks are the one piece
//RS /// of caller-established state the check reads back (derive/comptime folding
//RS /// reaches them through `MirBridge`), so they are carried across explicitly —
//RS /// the same carry `jet_driver::run_compiler_work` performs. `MirBridge`'s own
//RS /// hooks are a process-global `OnceLock`, not thread-local, so they need no
//RS /// carry.
//RS pub(super) fn check_bundle_opts_for_output_with_context(
//RS     bundle: &mut ProgramBundle,
//RS     mode: CompileMode,
//RS     no_os: bool,
//RS     gates: crate::Policy::GateSet,
//RS     explicit_output: Option<&str>,
//RS     incremental: Option<&mut IncrementalSemaCache>,
//RS     allow_compiler_api: bool,
//RS ) -> (Vec<Diagnostic>, super::super::Effects::SemIndexEffectFacts) {
//RS     if jet_foundation::CompilerStack::on_compiler_worker() {
//RS         return check_bundle_opts_for_output_on_stack(
//RS             bundle,
//RS             mode,
//RS             no_os,
//RS             gates,
//RS             explicit_output,
//RS             incremental,
//RS             allow_compiler_api,
//RS         );
//RS     }
//RS     let (ambient_core_call, ambient_handle, ambient_extern_call) = crate::Comptime::ambient_hooks();
//RS     jet_foundation::CompilerStack::run_on_compiler_stack(move || {
//RS         crate::Comptime::with_ambient(
//RS             ambient_core_call,
//RS             ambient_handle,
//RS             ambient_extern_call,
//RS             || {
//RS                 check_bundle_opts_for_output_on_stack(
//RS                     bundle,
//RS                     mode,
//RS                     no_os,
//RS                     gates,
//RS                     explicit_output,
//RS                     incremental,
//RS                     allow_compiler_api,
//RS                 )
//RS             },
//RS         )
//RS     })
//RS }
