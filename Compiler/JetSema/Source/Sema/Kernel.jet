// The `#Kernel(.parallel)` safe-kernel proof (
// `check_kernel_marker`). A marker is not a proof: sema admits only a
// read-only, effect-free expression kernel over the audited Core compute calls.
// The declaration and worker-boundary obligations are checked with the function
// header (sema_kernel_check_declaration); the effect and body obligations once
// the effect rows are known (sema_effect_check_node), effects first, in the
// Rust reference's order. Each kernel reports its first unproved obligation
// (E1102).
use jet_foundation.[AccessConvention, CallArg, Diagnostic, Expr, Func, KernelMarker, ModuleTable, PlaceAccess, Span, Stmt, Type, expr_span]

SEMA_KERNEL_SAFE_COMPUTE_CALLS: [String]{
    "abs", "add", "broadcast_to", "det", "div", "exp", "fft", "full", "from_list", "inv", "matmul",
    "maximum", "minimum", "mul", "negate", "numel", "ones", "rank", "reshape", "shape", "solve",
    "sqrt", "sub", "sum", "sum_axis", "to_list", "to_sparse", "transpose", "zeros",
}

// One unproved obligation and where it fails.
SemaKernelFailure: struct {
    obligation: String
    span: Span
}

// A kernel whose declaration obligations hold, waiting for its effect row:
// the marker, whether it declares a non-empty effect row, and its first body
// obligation failure.
SemaKernelPending: struct {
    span: Span
    declared_effects: Bool
    body_failure: SemaKernelFailure?
}

sema_kernel_failure: fn(obligation: String, span: Span) -> Diagnostic Never! {
    sema_error("E1102", span, "`#Kernel(.parallel)` cannot cross its worker boundary: sema cannot prove {obligation}", "a safe kernel crosses a worker boundary only after sema proves sendability, bounds, aliasing, captures, races, barriers, and control flow before lowering", "use a read-only effect-free expression over checked Core compute operations, or move provider/raw code behind its typed `#Unsafe` boundary")
}

// The declaration obligations read from the header alone, in order: a
// top-level declaration, a safe boundary, an effect-free kind of body, and
// read-only monomorphic parameters.
sema_kernel_declaration_failure: fn(func: Func, kernel: KernelMarker, method: Bool) -> SemaKernelFailure? Never! {
    if method -> return Val(SemaKernelFailure{obligation: "top-level declaration", span: kernel.span})
    if func.is_unsafe -> return Val(SemaKernelFailure{obligation: "safe memory boundary", span: func.unsafe_span ?? kernel.span})
    if func.is_reactive || func.is_job || func.inline_foreign != None -> return Val(SemaKernelFailure{obligation: "effect-free function body", span: kernel.span})
    read_only: loop param in func.params {
        if param.variadic || param.convention != AccessConvention.Read -> break false
    } ?? true
    if func.type_params.len() > 0 || !read_only -> return Val(SemaKernelFailure{obligation: "read-only, monomorphic parameters", span: kernel.span})
    None
}

// The header obligations of `func`'s kernel: the declaration, then every
// parameter and the declared result as a sendable kernel boundary value.
// False when one fails, reported.
sema_kernel_check_declaration: fn(func: Func, kernel: KernelMarker, method: Bool, params: [TParameter], result: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if sema_kernel_declaration_failure(func, kernel, method) == .Val(failure) {
        diagnostics.push(sema_kernel_failure(failure.obligation, failure.span))
        return false
    }
    loop param in params {
        problem: sema_ownership_crossing_problem(param.ty, SemaSendCrossing.Kernel, true, environment, program, scopes, context) ?? next
        diagnostics.push(sema_ownership_crossing_diagnostic(param.name, param.ty, problem, SemaSendCrossing.Kernel, kernel.span))
        return false
    }
    if func.return_type != None {
        if sema_ownership_crossing_problem(result, SemaSendCrossing.Kernel, true, environment, program, scopes, context) == .Val(problem) {
            diagnostics.push(sema_ownership_crossing_diagnostic("kernel result", result, problem, SemaSendCrossing.Kernel, kernel.span))
            return false
        }
    }
    true
}

// The pending effect and body obligations of a top-level kernel whose header
// obligations hold, or None. `compute_aliases` are the module's aliases of
// `core.compute`.
sema_kernel_pending: fn(func: Func, compute_aliases: [String]) -> SemaKernelPending? Never! {
    kernel: func.kernel ?? return None
    if sema_kernel_declaration_failure(func, kernel, false) != None -> return None
    names := (loop param in func.params -> param.name)
    body_failure := SemaKernelFailure?{None}
    loop statement in func.body {
        body_failure = sema_kernel_prove_statement(statement, names, compute_aliases)
        if body_failure != None -> break
    }
    declared: if func.declared_effects == .Val(row) -> row.len() > 0 else -> false
    Val(SemaKernelPending{span: kernel.span, declared_effects: declared, body_failure: body_failure})
}

sema_kernel_prove_statement: fn(statement: Stmt, names: &[String], compute_aliases: [String]) -> SemaKernelFailure? Never! {
    if statement == {
        .Expr(value) -> return sema_kernel_prove_expr(value, names, compute_aliases)
        .Return(value, _) -> return if value == .Val(returned) -> sema_kernel_prove_expr(returned, names, compute_aliases) else -> None
        .Val(binding) -> {
            if binding.mutable || binding.pattern != None -> return Val(SemaKernelFailure{obligation: "immutable scalar locals", span: binding.name_span})
            failure: sema_kernel_prove_expr(binding.init, names, compute_aliases)
            if failure != None -> return failure
            names.push(binding.name)
            return None
        }
        .Assign(_, _, _, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Defer(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> return Val(SemaKernelFailure{obligation: "uniform straight-line control flow", span: sema_user_text_stmt_span(statement)})
    }
}

sema_kernel_prove_args: fn(args: [CallArg], names: [String], compute_aliases: [String]) -> SemaKernelFailure? Never! {
    loop argument in args {
        failure: sema_kernel_prove_expr(argument.expr, names, compute_aliases)
        if failure != None -> return failure
    }
    None
}

sema_kernel_prove_expr: fn(expression: Expr, names: [String], compute_aliases: [String]) -> SemaKernelFailure? Never! {
    if expression == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Char(_, _, _) -> return None
        .Ident(name, span, _) -> return if names.contains(name) -> None else -> Val(SemaKernelFailure{obligation: "closed captures", span: span})
        .Unary(_, inner, _, _) | .Paren(inner, _, _) | .Copy(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .Present(inner, _, _) | .Tainted(inner, _, _, _) | .Field(inner, _, _, _) -> return sema_kernel_prove_expr(inner, names, compute_aliases)
        .Place(inner, access, span, _) -> return if access == PlaceAccess.Read -> sema_kernel_prove_expr(inner, names, compute_aliases) else -> Val(SemaKernelFailure{obligation: "race-free straight-line body", span: span})
        .Binary(_, left, right, _, _) -> {
            failure: sema_kernel_prove_expr(left, names, compute_aliases)
            if failure != None -> return failure
            return sema_kernel_prove_expr(right, names, compute_aliases)
        }
        .ListLit(items, _, _) -> {
            loop item in items {
                failure: sema_kernel_prove_expr(item, names, compute_aliases)
                if failure != None -> return failure
            }
            return None
        }
        .MethodCall(receiver, method, method_span, _, _, args, _) -> {
            audited: if receiver == .Ident(alias, _, _) -> compute_aliases.contains(alias) && SEMA_KERNEL_SAFE_COMPUTE_CALLS.contains(method) else -> false
            if audited -> return sema_kernel_prove_args(args, names, compute_aliases)
            return Val(SemaKernelFailure{obligation: "audited Core compute calls only", span: method_span})
        }
        .Call(call, _) -> return Val(SemaKernelFailure{obligation: "closed captures and provider calls", span: call.name_span})
        .Index(_, _, span, _, _) | .Slice(_, _, _, _, span, _) -> return Val(SemaKernelFailure{obligation: "statically proved bounds", span: span})
        .Lambda(lambda, _) -> return Val(SemaKernelFailure{obligation: "no captures", span: lambda.span})
        .CallValue(_, _, span, _) -> return Val(SemaKernelFailure{obligation: "closed calls", span: span})
        // A collection literal builds new storage on the worker; that, not a
        // race, is what keeps the body from being a proved kernel.
        .TypedLit(head, body, span, _) -> {
            fixed: if head == .Val(ty) -> sema_effect_is_fixed_list(ty) else -> false
            collection: if body == {
                .Elements(_) | .Entries(_) | .ByteText(_) -> true
                .Fields(_) | .Value(_) | .Empty -> false
            }
            if collection && !fixed -> return Val(SemaKernelFailure{obligation: "an allocation-free body: this literal allocates new collection storage", span: span})
            return Val(SemaKernelFailure{obligation: "race-free straight-line body", span: span})
        }
        .MapLit(_, span, _) -> return Val(SemaKernelFailure{obligation: "an allocation-free body: this literal allocates new collection storage", span: span})
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Range(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return Val(SemaKernelFailure{obligation: "race-free straight-line body", span: expr_span(expression)})
    }
}

// The effect and body obligations of a pending kernel, with its solved
// effect facts: no declared, direct, called or opaque effects, then the body.
// A Panic stop alone (an index, a slice, a `panic` call) always
// comes with a body failure at its own site ("statically proved bounds", a
// call), so that failure is the report rather than the effect row.
sema_kernel_check_effects: fn(pending: SemaKernelPending, direct: [String], call_edges: [String], maximal: Bool, diagnostics: &[Diagnostic]) -> Bool {
    effect_edges := call_edges.len()
    if pending.body_failure != None {
        effect_edges = 0
        loop edge in call_edges {
            if edge != "__jet_panic__" -> effect_edges += 1
        }
    }
    // The deny-only Unsafe fact an `#Unsafe` gate records is no effect.
    direct_effects: loop name in direct {
        if name != "Unsafe" -> break true
    } ?? false
    if pending.declared_effects || direct_effects || effect_edges > 0 || maximal {
        diagnostics.push(sema_kernel_failure("no reachable effects or opaque calls", pending.span))
        return false
    }
    if pending.body_failure == .Val(failure) {
        diagnostics.push(sema_kernel_failure(failure.obligation, failure.span))
        return false
    }
    true
}

// The module's local aliases of `core.compute`.
sema_kernel_compute_aliases: fn(module_row: SemaRegistrationModule, table: ModuleTable) -> [String] Never! {
    aliases := [String]{}
    loop row in sema_core_registration_imports(module_row, table) {
        if row.module_name == "core.compute" && row.item == None -> aliases.push(row.alias)
    }
    aliases
}
