    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:2972
    fn check_stmt_counted_loop(&self, init: &Binding, cond: &Expr, body: &[Stmt], step: &Stmt?, label: (String, Span)?, span: Span, arrow_body: Bool) Never! {
        memory_multiplier :: self.memory_control_multiplier
        self.memory_control_multiplier = None
        if label == .Val((name, label_span)) -> &self.declare_loop_label(name, label_span)
        &self.push_scope()
        &self.check_binding(&init)
        &self.lint_shared_busy_wait(cond, body, span, false)
        record_authority_alias(&self, init)
        &self.require_bool(&cond, "a `loop` condition")
        &self.push_loop_value_frame(label)
        &self.push_loop_break_frame()
        self.loop_depth += 1
        before_loop :: ~self.flow
        previous_arrow_loop_body :: self.arrow_loop_body
        self.arrow_loop_body = arrow_body
        &self.check_block(&body, true)
        self.arrow_loop_body = previous_arrow_loop_body
        if step == .Val(step_stmt) -> &self.check_stmt(&step_stmt)
        after_body :: ~self.flow
        may_skip := true
        if cond.without_parens() == .Bool(true, _) -> may_skip = false
        &self.join_loop_flow(before_loop, after_body, may_skip)
        self.loop_depth -= 1
        &self.pop_loop_value_frame()
        &self.pop_scope()
        if label != None -> _ :: &self.loop_labels.pop()
        self.memory_control_multiplier = memory_multiplier
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3016
    fn check_stmt_loop(&self, inner: &[Stmt], label: (String, Span)?, arrow_body: Bool) Never! {
        memory_multiplier :: self.memory_control_multiplier
        self.memory_control_multiplier = None
        if label == .Val((name, label_span)) -> &self.declare_loop_label(name, label_span)
