    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3643
    fn check_stmt_transact(&self, name: String?, name_span: Span?, body: &[Stmt], implicit: Bool) Never! {
        &self.push_scope()
        if name == .Val(handle) && name_span == .Val(handle_span) -> &self.declare_loop_var(~handle, handle_span, Type.Named(TXN_HANDLE_TYPE))
        self.txn_depth += 1
        if !implicit -> self.txn_wall_depth += 1
        &self.check_block(&body, true)
        if !implicit -> self.txn_wall_depth -= 1
        self.txn_depth -= 1
        &self.pop_scope()
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3673
    fn check_stmt_context_block(&self, fields: &[(String, Expr, Span)], body: &[Stmt], span: Span) Never! {
        rule_fact :: self.take_rule_fact(CTX_BLOCK, span)
        signature_checked :: rule_fact != None
        validated :: rule_fact.and_then(fn(marker) {
            loop index in 0..<min(marker.args.len(), fields.len()) {
                if marker.args[index].as_expr_mut() == .Val(argument) -> swap(&argument, &fields[index].1)
            }
            result :: self.validate_rule_signature(&marker)
            loop index in 0..<min(marker.args.len(), fields.len()) {
                if marker.args[index].as_expr_mut() == .Val(argument) -> swap(&argument, &fields[index].1)
            }
            result
        })
        signature_valid :: !signature_checked || validated != None
        loop source_index in 0..<fields.len() {
            field_name :: fields[source_index].0
            field_span :: fields[source_index].2
            ty :: if signature_checked {
                validated.and_then(fn(arguments) {
                    arguments.bindings.find(fn(binding) { binding.source_index == source_index }).and_then(fn(binding) {
                        if binding.ty == RuleArgType.Any -> return self.infer(&fields[source_index].1)
                        arguments.type_for_source(source_index)
                    })
                })
            } else { self.infer(&fields[source_index].1) }
            if field_name == CTX_FIELD_ALLOCATOR {
                if !signature_valid -> continue
                ok := false
                if ty == .Val(.Named(n)) -> ok = alloc_handle_rust_type(n) != None
                if !ok {
                    got :: ty.map(fn(t) { t.show() }).unwrap_or_else(fn() { "unknown" })
                    &self.diags.push(Diagnostic.error("E0762", "`allocator` needs an allocator, got {got}", "the `allocator` field takes an `Arena`, `Bump`, `Pool`, or `Fixed` value", "pass an allocator, e.g. `mem.Arena.new()`", Val(field_span)))
                }
            } else if field_name == CTX_FIELD_LOGGER {
                _ :: ty
            } else if field_name == CTX_FIELD_DEADLINE {
                if !signature_valid -> continue
                valid_deadline := false
                if ty == .Val(.Int) -> valid_deadline = true
                if ty == .Val(.InlineRange(..)) -> valid_deadline = true
                if !valid_deadline {
                    got :: ty.map(fn(t) { t.show() }).unwrap_or_else(fn() { "unknown" })
                    &self.diags.push(Diagnostic.error("E0762", "`deadline` needs an Int epoch-millis instant, got {got}", "the `deadline` field carries an absolute time budget in milliseconds", "pass an Int, e.g. `time.now() + 200`", Val(field_span)))
                }
            }
        }
        has_allocator :: fields.any(fn(field) { field.0 == CTX_FIELD_ALLOCATOR })
        saved_depth :: self.context_depth
        saved_alloc :: self.context_allocator_active
        self.context_depth += 1
        if has_allocator -> self.context_allocator_active = true
        &self.check_block(&body, true)
        self.context_allocator_active = saved_alloc
        self.context_depth = saved_depth
    }
}
