    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3210
    fn check_stmt_arithmetic_scope(&self, args: [Expr], body: &[Stmt], span: Span) Never! {
        mode :: args.first().and_then(ArithmeticMode.from_expr)
        if mode == .Val(arithmetic_mode) {
            &self.arithmetic_policy_stack.push(ArithmeticPolicyFact{mode: arithmetic_mode, scope_span: span, operation_span: span, operation: None})
            &self.check_block(&body, true)
            _ :: &self.arithmetic_policy_stack.pop()
        } else {
            &self.diags.push(marker_argument_shape_error(MARKER_ARITHMETIC, span))
            &self.check_block(&body, true)
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3237
    fn check_stmt_task_group(&self, name: String, name_span: Span, limit: &Expr?, body: &[Stmt]) Never! {
        if limit == .Val(limit_expr) {
            if self.infer(&limit_expr) == .Val(limit_ty) && !(limit_ty is Type.InlineRange) -> _ :: &self.check_type_assignable(Type.Int, limit_ty, limit_expr.span())
        }
        &self.push_scope()
        &self.declare(name, name_span, LocalInfo{def_span: name_span, binding_sigil_span: None, ty: Type.Named(TYPE_TASKGROUP), mutable: false, param_conv: None, decl_loop_depth: self.loop_depth, interrupt_sendable: false, reactive_local: false, reactive_shared: false, single_use_span: None, invalid: false})
        &self.mark_local_name_reference(name)
        &self.taskgroup_stack.push(TaskGroupCtx.new(~name, name_span))
        &self.check_block(&body, false)
        &self.mark_taskgroup_spawns_owned(TaskGroupOrigin.Lexical)
        _ :: &self.taskgroup_stack.pop()
        &self.pop_scope()
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3293
    fn check_stmt_layout(&self, name: String, name_span: Span, body: &[Stmt]) Never! {
        &self.declare(name, name_span, LocalInfo{def_span: name_span, binding_sigil_span: None, ty: Type.Named(LAYOUT_TYPE), mutable: false, param_conv: None, decl_loop_depth: self.loop_depth, interrupt_sendable: false, reactive_local: false, reactive_shared: false, single_use_span: None, invalid: false})
        &self.push_scope()
        seen_constraints := [String:Bool]{}
        loop &stmt in &body {
            if stmt == .Expr(e) {
                fp :: layout_constraint_fingerprint(e)
                t :: self.infer(&e)
                is_constraint := false
                if t == .Val(.Named(n)) && n == LAYOUT_CONSTRAINT_TYPE -> is_constraint = true
                if !is_constraint && t != None {
                    found :: t.map(fn(ty) { ty.name() }).unwrap_or_default()
                    &self.diags.push(Diagnostic.error("E2933", "this element inside `{name} {SIGIL_BIND_IMMUT} {LAYOUT_TYPE}.{{ … }}` doesn't produce a constraint (found `{found}`)", "every element inside a `{LAYOUT_TYPE}.{{ … }}` body must be a `>=`/`<=`/`==` comparison of layout values (a `Constraint`), comma-separated", "write a comparison, e.g. `label.width >= 80.0`", Val(e.span())))
                } else if is_constraint {
                    if seen_constraints.has_key(fp) {
                        &self.diags.push(Diagnostic.lint("E2934", "this constraint repeats one already written in this `{LAYOUT_TYPE}.{{ … }}` body", "an exact duplicate constraint doesn't tighten the layout — it's almost always a copy-paste leftover", "remove the duplicate line, or change it if a different constraint was meant", Val(e.span())))
                    } else { seen_constraints[fp] = true }
                }
            } else if stmt == .Val(b) {
                fp :: layout_constraint_fingerprint(b.init)
                &self.check_stmt(&stmt)
                if stmt == .Val(checked_binding) {
                    bname :: ~checked_binding.name
                    binding_span :: checked_binding.name_span
                    is_constraint :: self.lookup(bname).map(fn(info) { if info.ty == .Named(n) -> return n == LAYOUT_CONSTRAINT_TYPE; false }).unwrap_or(false)
                    if !is_constraint {
                        &self.diags.push(Diagnostic.error("E2933", "this binding inside `{name} {SIGIL_BIND_IMMUT} {LAYOUT_TYPE}.{{ … }}` doesn't capture a constraint", "every element inside a `{LAYOUT_TYPE}.{{ … }}` body must be a `>=`/`<=`/`==` comparison of layout values (a `Constraint`), optionally captured with `::`", "bind a comparison: `c :: label.width >= 80.0`", Val(binding_span)))
                    } else if seen_constraints.has_key(fp) {
                        &self.diags.push(Diagnostic.lint("E2934", "this constraint repeats one already written in this `{LAYOUT_TYPE}.{{ … }}` body", "an exact duplicate constraint doesn't tighten the layout — it's almost always a copy-paste leftover", "remove the duplicate line, or change it if a different constraint was meant", Val(binding_span)))
                    } else { seen_constraints[fp] = true }
                }
            } else {
                &self.diags.push(Diagnostic.error("E2933", "only constraint elements belong directly inside a `{LAYOUT_TYPE}.{{ … }}` body", "every element inside a `{LAYOUT_TYPE}.{{ … }}` body must be a `>=`/`<=`/`==` comparison of layout values (a `Constraint`), optionally captured with `::`", "write a comparison, e.g. `label.width >= 80.0`", Val(stmt.span())))
            }
        }
        &self.pop_scope()
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3426
    fn check_stmt_authority_scope(&self, caps: [(String, Span)], caps_span: Span, binding: String?, binding_span: Span?, body: &[Stmt], span: Span) Never! {
        cap_set := EffectSet.new()
        bad := false
        loop (name, effect_span) in caps {
            resolved :: resolve_effect_name(name, self.effect_facts)
            if resolved == .Ok(e) {
                if reject_positive_deny_only_effect(e, effect_span) == .Val(diagnostic) {
                    &self.diags.push(diagnostic)
                    bad = true
                } else { &cap_set.insert(e) }
            } else if resolved == .Err(suggestion) {
                if parse_effect_name(name) != None {
                    &self.diags.push(undeclared_effect(name, suggestion, Val(effect_span)))
                } else { &self.diags.push(unknown_effect(name, effect_span)) }
                bad = true
            }
        }
        if self.region_stack.last() == .Val(outer) {
            widening :: effects_uncovered(cap_set, outer.caps)
            if !widening.is_empty() {
                &self.diags.push(e0712(widening, outer.caps, caps_span, KW_FX))
                bad = true
            }
        }
        if binding == .Val(binding_name) {
            handle_span :: binding_span.expect("named #FX binding has a span")
            &self.push_scope()
            &self.declare_loop_var(~binding_name, handle_span, Type.Named(AUTHORITY_HANDLE_TYPE))
        }
        &self.region_stack.push(RegionAccum{binding: ~binding, aliases: [:], caps: cap_set, caps_span: caps_span, direct: EffectSet.new(), edges: [:], maximal: false})
        &self.check_block(&body, true)
        acc :: &self.region_stack.pop().expect("pushed above")
        if binding == .Val(binding_name) {
            loop delegation in authority_delegations(body, binding_name, span) {
                if !self.fx_authority_delegations.any(fn(existing) { existing.span == delegation.span && existing.resource == delegation.resource && existing.operation == delegation.operation }) -> &self.fx_authority_delegations.push(delegation)
            }
            if grant_handle_escape(body, binding_name) == .Val(escape_span) -> &self.diags.push(e0711(binding_name, KW_FX, escape_span))
            &self.pop_scope()
        }
        if !bad -> &self.fx_regions.push(RegionSummary{caps: ^acc.caps, direct: ^acc.direct, edges: ^acc.edges, maximal: acc.maximal, caps_span: acc.caps_span})
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3547
    fn check_stmt_live(&self, body: &[Stmt], span: Span) Never! {
        if self.in_pure -> &self.diags.push(e3401(self.fn_name, "#Live { … }", [], span))
        if self.no_os -> &self.diags.push(e3301("#Live { … }", "Terminal I/O requires an OS terminal device. Select a hosted target or declare an IO.Write provider.", span))
        &self.check_block(&body, true)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3577
    fn check_stmt_scope_member(&self, name: String, args: &[Expr], body: &[Stmt]) Never! {
        if name == SCOPE_TEST_TIMEOUT && args.len() == 1 {
            expected :: Type.Named(DURATION_TYPE)
            if self.infer_with_expected(&args[0], expected) == .Val(got) {
                reported :: self.check_type_assignable(expected, got, args[0].span())
                if !reported && got != expected -> &self.diags.push(Diagnostic.error("E0112", "`.timeout` wants {expected.show()}, but this is {got.show()}", "a timeout budget is a Duration value", type_fix_hint(expected, got), Val(args[0].span())))
            }
        }
        has_type_parameter :: applied_rule(name).is_some_and(fn(row) { row.signature.params.first().is_some_and(fn(parameter) { parameter.source_type == "Type" }) })
        if has_type_parameter && args.len() == 1 {
            if args[0] == .Ident(type_name, type_span) -> &self.check_declared_type_rules(Type.Named(~type_name), type_span)
        }
        leak :: name == SCOPE_TEST_SETUP
        &self.check_block(&body, !leak)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3626
    fn check_stmt_assume_det(&self, body: &[Stmt], span: Span) Never! {
        policy_allowed :: self.audited_gate_allowed(PolicyKey.Nondeterministic, span)
        if policy_allowed -> self.det_suppress += 1
        &self.check_block(&body, true)
        if policy_allowed -> self.det_suppress -= 1
