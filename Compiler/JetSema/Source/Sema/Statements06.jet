    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3084
    fn check_stmt_reactive(&self, body: &[Stmt], span: Span) Never! {
        if self.in_comptime -> &self.diags.push(Diagnostic.error("E2914", "`#Reactive` can't run at comptime", "reactive effects subscribe to runtime signals and re-run when they change (D-REACTCORE1)", "move `#Reactive { … }` out of the `comptime` block", Val(span)))
        captures := block_free_var_reads(body).collect()
        &captures.sort()
        loop name in captures {
            if self.is_view(name) {
                read_only :: self.view_facts(name).all(fn(fact) { fact.access == ViewAccess.Read })
                copy_ty :: self.lookup(name).map(fn(info) { ~info.ty }).and_then(fn(ty) {
                    owned_type_for_read_view(ty).or_else(fn() {
                        if self.is_string_view(name) && ty == Type.String -> return Val(Type.String)
                        None
                    })
                })
                if !self.copies_explicit() && read_only && copy_ty.is_some_and(fn(ty) { self.is_cloneable_type(ty) }) -> continue
                &self.report_view_escape(name, "be captured by a reactive effect", span)
            }
        }
        enclosing_mut_captures :: ^self.inferred_lambda_mut_captures
        self.inferred_lambda_mut_captures = [:]
        &self.check_block(&body, true)
        self.inferred_lambda_mut_captures = enclosing_mut_captures
    }
    // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3136
    fn check_stmt_switched(&self, marker: Marker, body: &[Stmt]) Never! {
        if switched_off(marker) {
            original_body :: ^body
            body = []
            checked_body := ~original_body
            &self.with_erased_scope(fn(checker: &Checker) Never! {
                checker.suppress_must_use = true
                &checker.push_scope()
                loop &stmt in &checked_body -> &checker.check_stmt(&stmt)
                &checker.check_single_use_consumed_in_current_scope()
                &checker.drop_scope_no_obligation_checks()
            })
            body = original_body
            loop &stmt in &body -> &stmt.for_each_expr_mut(fn(expr: &Expr) Never! {
                if expr == .Lambda(lambda) -> lambda.meta.runtime_erased = true
            })
            return
        }
        // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3165
        if marker.name == MARKER_DEBUG_ONLY {
            &self.with_erased_scope(fn(checker: &Checker) Never! {
                checker.suppress_must_use = true
                &checker.push_scope()
                loop &stmt in &body {
                    &checker.check_stmt(&stmt)
                    &stmt.for_each_expr_mut(fn(expr: &Expr) Never! {
                        if expr == .Lambda(lambda) -> lambda.meta.runtime_erased = true
                    })
                }
                &checker.check_single_use_consumed_in_current_scope()
                &checker.drop_scope_no_obligation_checks()
            })
            return
        }
        // Rust: crates/jet-sema/src/Sema/CheckerCore/statements.rs:3186
        &self.check_block(&body, true)
    }
