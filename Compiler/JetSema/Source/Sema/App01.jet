// Rust: crates/jet-sema/src/Sema/App.rs:228
// collect_store_facts -> sema_app_collect_discovery_typed below, using exact
// visitor store-call/method branches at App.jet:734-735/758-777.
// Rust: crates/jet-sema/src/Sema/App.rs:281
// store_call_kind -> SemaAppDiscovery.visit, App.jet:734-735: store/web.store/
// core.web.store => default; their .with_history calls => with_history.
// Rust: crates/jet-sema/src/Sema/App.rs:291
// store_method_kind -> SemaAppDiscovery.visit, App.jet:758-760 (new/with_history).
// Rust: crates/jet-sema/src/Sema/App.rs:299
// is_store_receiver -> sema_app_store_receiver, App.jet:703.
// Rust: crates/jet-sema/src/Sema/App.rs:319
// collect_form_facts -> sema_app_collect_discovery_typed below. The visitor
// retains the original source span and first occurrence for each exact key.

// Rust BTreeSet/BTreeMap keys must stay composite; arbitrary source text can
// contain NUL, so concatenated string encodings are not an equality contract.
// GATE #4499: exact tuple equality/hash and lexicographic key ordering.
fn sema_app_collect_discovery_typed(registration: SemaRegistrationGraph, locations: [SemaAppFunctionLocation], functions: [String:SemaAppFunctionLocation], builder: &SemaAppBuilder) Never! {
    queries := [(key: String, footprint: String, source: String, kind: String):MIRAppQueryFact]{}
    stores := [(name: String, source: String, kind: String, history_limit: String):MIRAppStoreFact]{}
    forms := [(model: String, action: String, source: String):SemaAppFormCall]{}
    loop location in locations {
        function :: sema_app_function(registration, location)
        visitor := SemaAppDiscovery{source: function.name, queries: [], stores: [], forms: []}
        loop statement in function.body -> ast_stmt_for_each_expr<SemaAppDiscovery>(statement, &visitor)
        loop query in visitor.queries {
            key :: (key: query.key, footprint: query.footprint, source: query.source, kind: query.kind)
            queries[key] = query
        }
        loop store in visitor.stores {
            key :: (name: store.name, source: store.source, kind: store.kind, history_limit: store.history_limit)
            stores[key] = store
        }
        loop form in visitor.forms {
            key :: (model: form.model, action: form.action, source: form.source)
            if forms.get(key) == None -> forms[key] = form
        }
    }
    query_keys := [(key: String, footprint: String, source: String, kind: String)]{}
    loop (key, _) in queries -> &query_keys.push(key)
    &query_keys.sort()
    builder.graph.queries = []
    loop key in query_keys -> &builder.graph.queries.push(queries.get(key) ?? panic("query discovery disappeared"))
    store_keys := [(name: String, source: String, kind: String, history_limit: String)]{}
    loop (key, _) in stores -> &store_keys.push(key)
    &store_keys.sort()
    builder.graph.stores = []
    loop key in store_keys -> &builder.graph.stores.push(stores.get(key) ?? panic("store discovery disappeared"))
    form_keys := [(model: String, action: String, source: String)]{}
    loop (key, _) in forms -> &form_keys.push(key)
    &form_keys.sort()
    builder.graph.forms = []
    loop key in form_keys {
        call :: forms.get(key) ?? panic("form discovery disappeared")
        record :: sema_app_find_struct_bundle(registration, call.model) ?? next
        fields := [MIRAppFormFieldFact]{}
        loop field in record.fields {
            if field.computed != None -> next
            base :: if field.ty == { .Option(inner) -> inner; else -> field.ty }
            ty :: if base == {
                .Int | .IntN(_, _) -> "Int"
                .Float -> "Float"
                .Bool -> "Bool"
                .String -> "String"
                else -> type_name(base)
            }
            control :: if base == {
                .Int | .IntN(_, _) | .Float -> "Number"
                .Bool -> "Checkbox"
                else -> "Text"
            }
            &fields.push(MIRAppFormFieldFact{name: field.name, ty: ty,
                required: !sema_app_optional(field.ty) && field.default == None,
                default: sema_app_wire_text(field.default), label: form_label(field.name),
                control: control, wire_name: field.name})
        }
        declaration :: if functions.get(call.action) == {
            .Val(location) -> Val(sema_app_function(registration, location))
            .None -> None
        }
        contract :: sema_app_action_contract(declaration, call.action, call.action, "form", call.span, false, call.source)
        &builder.graph.forms.push(MIRAppFormFact{name: call.model, model: call.model, action: call.action,
            input_type: contract.input_type, output_type: contract.output_type, error_type: contract.error_type,
            endpoint: contract.endpoint, method: contract.method, csrf: contract.csrf, effects: contract.effects,
            fields: fields, middleware: contract.middleware, provenance: call.source,
            span_start: call.span.start, span_end: call.span.end})
    }
}

// Rust: crates/jet-sema/src/Sema/App.rs:402
// form_call_parts -> SemaAppDiscovery.visit, App.jet:736-747. Only the three
// exact form-call names, exactly two args, first action label else arg1,
// model/action nonempty, name_span; not a method call or an arbitrary form.
// Rust: crates/jet-sema/src/Sema/App.rs:427
// form_model_name -> sema_app_form_model, App.jet:714. Ident, parens,
// OrFallback value and input/.input with first constant text argument only.

// Rust: crates/jet-sema/src/Sema/App.rs:442
fn form_label(name: String) -> String Never! {
    labels := [String]{}
    loop part in name.split("_") {
        if part.is_empty() -> next
        chars := part.chars()
        first :: &chars.next() ?? next
        // Unicode uppercase may expand one scalar (ß -> SS); the rest starts
        // after that scalar's UTF-8 width, never after the first byte.
        rest := chars.as_str() // #4303
        upper :: first.to_uppercase().collect<String>() // GATE #4500: exact Unicode uppercase iterator
        &labels.push("{upper}{rest}")
    }
    labels.join(" ")
}

