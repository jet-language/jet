// Rust: crates/jet-sema/src/Sema/App.rs:1946
fn const_int_arg(args: [CallArg], index: Int) -> Int? Never! {
    if index < 0 || index >= args.len() -> return None
    sema_app_int(args[index].expr)
}
// Rust: crates/jet-sema/src/Sema/App.rs:1950
// const_int_expr -> sema_app_int, App.jet:145: i64 range, parentheses, checked_neg.
// Rust: crates/jet-sema/src/Sema/App.rs:1959
// labeled_string_arg -> sema_app_labeled_string, App.jet:122 (first label only).
// Rust: crates/jet-sema/src/Sema/App.rs:1965
fn labeled_bool_arg(args: [CallArg], label: String) -> Bool? Never! {
    // A present label whose expression is not Bool must still try the last
    // unlabelled argument (Rust Option.and_then(...).or_else(...)).
    loop arg in args {
        if arg.label == .Val(name) && name.name == label {
            if const_bool_expr(arg.expr) == .Val(value) -> return Val(value)
            break
        }
    }
    index := args.len()
    loop index > 0 {
        index -= 1
        if args[index].label == None -> return const_bool_expr(args[index].expr)
    }
    None
}
// Rust: crates/jet-sema/src/Sema/App.rs:1977
fn const_bool_expr(expr: Expr) -> Bool? Never! {
    if expr == .Bool(value, _) -> return Val(value)
    None
}
