// Rust: crates/jet-sema/src/Sema/App.rs:1652
fn append_function_effects(function: Func, module_alias: String, solved: [String:[String]]?, out: &[String:Bool]) Never! {
    if solved == .Val(effects) {
        if lookup_effects(effects, module_alias, function.name) == .Val(found) {
            loop effect in found -> out[effect] = true
            return
        }
    }
    loop declared in function.declared_effects ?? [] -> out[declared.name] = true
}

// Rust: crates/jet-sema/src/Sema/App.rs:1669
fn lookup_effects(solved: [String:[String]], module_alias: String, function: String) -> [String]? Never! {
    if solved.get("{module_alias}::{function}") == .Val(effects) -> return Val(effects)
    if solved.get(function) == .Val(effects) -> return Val(effects)
    loop (key, effects) in solved {
        if key.rsplit("::").next() == Val(function) || key.rsplit("__").next() == Val(function) -> return Val(effects)
    }
    None
}

// Rust: crates/jet-sema/src/Sema/App.rs:1687
fn effect_root(effect: String) -> String Never! {
    effect.split(".").next() ?? effect
}
// Rust: crates/jet-sema/src/Sema/App.rs:1691
fn is_runtime_effect(effect: String) -> Bool Never! {
    root :: effect_root(effect)
    root == "DB" || root == "FS" || root == "Net" || root == "IO" || root == "Time" || root == "Rand" || root == "Env" || root == "Exec" || root == "Secret" || root == "RequestContext"
}
