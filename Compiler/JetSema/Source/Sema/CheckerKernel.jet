// Conservative safe-kernel proof: a marker is not a proof. Only exact checked
// loop shapes or read-only effect-free expressions over audited Core compute qualify.
use jet_foundation.[Diagnostic, Span, AccessConvention, AutoVectorizationFacts, BinOp, Binding, Expr, ForKind, Func, KernelMode, KernelProof, LValue, Stmt, Type, UnOp, PlaceAccess]
use jet_sema.[Checker, SendCrossing]

// Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:17
const SAFE_COMPUTE_CALLS :: ["abs", "add", "broadcast_to", "det", "div", "exp", "fft", "full", "from_list", "inv", "matmul", "maximum", "minimum", "mul", "negate", "numel", "ones", "rank", "reshape", "shape", "solve", "sqrt", "sub", "sum_axis", "to_list", "to_sparse", "transpose", "zeros"]
// Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:48
#Error
struct KernelFailure { obligation: String, span: Span }
// Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:53
struct AutoVectorBodyProof {
    outputs: [String:Bool]
    inputs: [String:Bool]
    element_type: Type
    no_early_exit: Bool
    no_cross_iteration_deps: Bool
}

impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:68
    pub fn prove_auto_vectorization_loop(self: &Self, kind: &ForKind, loop_var: String, body: &[Stmt], before_direct: &[String:Bool], before_edges: &[String:Bool], before_maximal: Bool) -> AutoVectorizationFacts? {
        if kind != .Range(start: start, end: end, step: step, exclusive: exclusive) -> return None
        if !exclusive || step != None -> return None
        if start.without_parens() != .Int(0, ..) -> return None
        end_root :: if end.without_parens() == {
            .MethodCall(receiver: receiver, method: method, args: args, ..) && method == "len" && args.is_empty() -> if receiver.without_parens() == { .Ident(root, _) -> Val(~root); _ -> return None }
            _ -> None
        }
        extent :: if end.without_parens() == {
            .Int(value, ..) && value >= 0 -> Val(U64.try_from(value).ok() ?? return None)
            _ -> {
                root :: end_root ?? return None
                info :: self.lookup(root) ?? return None
                if info.ty == { .FixedList(_, len) -> Val(len.literal_value() ?? return None); .List -> None; _ -> return None }
            }
        }
        proof :: self.prove_auto_body(body, loop_var, extent) ?? return None
        if proof.outputs.is_empty() && proof.inputs.is_empty() -> return None
        collection_roots := [String:Bool]{}
        loop (root, _) in proof.outputs { collection_roots.insert(~root, true) }
        loop (root, _) in proof.inputs { collection_roots.insert(~root, true) }
        dynamic_root :: collection_roots.keys().any(root -> self.lookup(root).is_some_and(info -> if info.ty == { .List -> true; _ -> false }))
        if dynamic_root && (end_root == None || collection_roots.len() != 1 || !end_root.is_some_and(root -> collection_roots.contains_key(root))) -> return None
        if proof.inputs.len() > 1 && proof.inputs.keys().any(name -> self.lookup(name).is_some_and(info -> info.param_conv == Val(AccessConvention.Read))) -> return None
        effect_free :: self.fx_direct.keys().all(name -> before_direct.contains_key(name)) && self.fx_edges.keys().all(name -> before_edges.contains_key(name)) && self.fx_maximal == before_maximal
        if !effect_free -> return None
        Val(AutoVectorizationFacts{element_type: ^proof.element_type, no_aliasing: true, no_early_exit: proof.no_early_exit, effect_free_body: effect_free, no_cross_iteration_deps: proof.no_cross_iteration_deps})
    }
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:165
    fn prove_auto_body(self: &Self, body: &[Stmt], loop_var: String, extent: U64?) -> AutoVectorBodyProof? {
        self.prove_auto_control_body(body, loop_var, extent).or_else(fn() { self.prove_auto_reduction_body(body, loop_var, extent) }).or_else(fn() { self.prove_auto_elementwise_body(body, loop_var, extent) })
    }
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:179
    fn prove_auto_control_body(self: &Self, body: &[Stmt], loop_var: String, extent: U64?) -> AutoVectorBodyProof? {
        if body.len() != 1 -> return None
        if body[0] != .Switch(subject: subject, arms: arms, else_body: None, ..) -> return None
        if arms.len() != 1 || subject.without_parens() != .Bool(true, _) -> return None
        arm :: &arms[0]
        inputs := [String:Bool]{}
        condition_type := Type?{None}
        if !self.prove_auto_condition_expr(arm.cond, loop_var, extent, &condition_type, &inputs) -> return None
        element_type :: condition_type ?? return None
        if !is_auto_scalar(element_type) || inputs.is_empty() || arm.body.len() != 1 -> return None
        if arm.body[0] == {
            .Assign(target: .Local(name: name, ..), op: .Val(.Add), value: value, ..) -> {
                info :: self.lookup(name) ?? return None
                if !is_auto_vectorizable_scalar(element_type) || info.ty != element_type || !info.mutable || info.param_conv != None -> return None
                if self.expr_mentions_ident(value, name) -> return None
                if !self.prove_auto_element_expr(value, loop_var, element_type, extent, "", false, &inputs) -> return None
                Val(AutoVectorBodyProof{outputs: [:], inputs: ^inputs, element_type: ^element_type, no_early_exit: true, no_cross_iteration_deps: false})
            }
            .Return(.Val(value), _) -> {
                expected := Val(~element_type)
                if !self.prove_auto_condition_expr(value, loop_var, extent, &expected, &inputs) -> return None
                Val(AutoVectorBodyProof{outputs: [:], inputs: ^inputs, element_type: ^element_type, no_early_exit: false, no_cross_iteration_deps: true})
            }
            _ -> None
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:273
    fn prove_auto_condition_expr(self: &Self, expr: &Expr, loop_var: String, extent: U64?, element_type: &Type?, inputs: &[String:Bool]) -> Bool {
        if expr.without_parens() == {
            .Int, .Float, .Bool -> true
            .Ident(name, _) && name == loop_var -> true
            .Ident(name, _) -> self.lookup(name).is_some_and(info -> is_auto_scalar(info.ty) && element_type.is_none_or(expected -> expected == info.ty))
            .Unary(UnOp.Neg, inner, _), .Unary(UnOp.Not, inner, _) -> self.prove_auto_condition_expr(inner, loop_var, extent, &element_type, &inputs)
            .Binary(op, left, right, _) && (op.is_comparison() || op == BinOp.And || op == BinOp.Or || op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div) -> self.prove_auto_condition_expr(left, loop_var, extent, &element_type, &inputs) && self.prove_auto_condition_expr(right, loop_var, extent, &element_type, &inputs)
            .Index(base: base, index: index, ..) -> {
                if base.without_parens() != .Ident(root, _) -> return false
                ty :: self.auto_collection_element_type(root, index, loop_var, extent) ?? return false
                if !is_auto_scalar(ty) || element_type.is_some_and(expected -> expected != ty) -> return false
                element_type = Val(^ty)
                inputs.insert(~root, true)
                true
            }
            .Field(base, field, span) -> {
                if base.without_parens() != .Index(base: collection, index: index, ..) -> return false
                if collection.without_parens() != .Ident(root, _) -> return false
                elem :: self.auto_collection_element_type(root, index, loop_var, extent) ?? return false
                ty :: self.field_type(elem, field, span) ?? return false
                if !is_auto_scalar(ty) || element_type.is_some_and(expected -> expected != ty) -> return false
                element_type = Val(^ty)
                inputs.insert(~root, true)
                true
            }
            _ -> false
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:363
    fn prove_auto_elementwise_body(self: &Self, body: &[Stmt], loop_var: String, extent: U64?) -> AutoVectorBodyProof? {
        outputs := [String:Bool]{}
        inputs := [String:Bool]{}
        // GATE #4499: exact tuple key identity; do not stringify output places.
        written := [(String, String?):Bool]{}
        element_type := Type?{None}
        loop stmt in body {
            if stmt != .Assign(target: target, op: None, value: value, ..) -> return None
            (root, field, output_elem) :: self.auto_output_place(target, loop_var, extent) ?? return None
            key :: (~root, ^field)
            if written.contains_key(key) -> return None
            written.insert(^key, true)
            outputs.insert(~root, true)
            if !is_auto_vectorizable_scalar(output_elem) -> return None
            if element_type == .Val(expected) {
                if expected != output_elem -> return None
            } else { element_type = Val(~output_elem) }
            if !self.prove_auto_element_expr(value, loop_var, output_elem, extent, root, true, &inputs) -> return None
        }
        Val(AutoVectorBodyProof{outputs: ^outputs, inputs: ^inputs, element_type: element_type ?? return None, no_early_exit: true, no_cross_iteration_deps: true})
    }
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:420
    fn auto_output_place(self: &Self, target: &LValue, loop_var: String, extent: U64?) -> (String, String?, Type)? {
        if target == {
            .Index(base: base, index: index, ..) -> {
                if base.without_parens() != .Ident(root, _) -> return None
                if index.without_parens() != .Ident(name, _) || name != loop_var -> return None
                elem :: self.auto_collection_element_type(root, index, loop_var, extent) ?? return None
                _ :: self.check_auto_output_root(root, extent) ?? return None
                Val((~root, None, ^elem))
            }
            .Field(base: base, field: field, span: span) -> {
                if base.without_parens() != .Index(base: collection, index: index, ..) -> return None
                if collection.without_parens() != .Ident(root, _) -> return None
                elem :: self.auto_collection_element_type(root, index, loop_var, extent) ?? return None
                ty :: self.field_type(elem, field, span) ?? return None
                _ :: self.check_auto_output_root(root, extent) ?? return None
                Val((~root, Val(~field), ^ty))
            }
            .Local -> None
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:456
    fn check_auto_output_root(self: &Self, root: String, extent: U64?) -> Unit? {
        info :: self.lookup(root) ?? return None
        if info.ty == {
            .FixedList(_, len) -> {
                if Val(len.literal_value() ?? return None) != extent -> return None
                if info.param_conv != None || !info.mutable -> return None
            }
            .List -> {
                if info.param_conv.is_some_and(conv -> conv != AccessConvention.Write) || (!info.mutable && info.param_conv != Val(AccessConvention.Write)) -> return None
            }
            _ -> return None
        }
        Val(())
    }
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:481
    fn auto_collection_element_type(self: &Self, root: String, index: &Expr, loop_var: String, extent: U64?) -> Type? {
        if index.without_parens() != .Ident(name, _) || name != loop_var -> return None
        info :: self.lookup(root) ?? return None
        if info.ty == {
            .FixedList(elem, len) -> {
                if Val(len.literal_value() ?? return None) != extent -> return None
                Val(~elem)
            }
            .List(elem) -> Val(~elem)
            _ -> None
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:505
    fn prove_auto_reduction_body(self: &Self, body: &[Stmt], loop_var: String, extent: U64?) -> AutoVectorBodyProof? {
        if body.len() != 1 -> return None
        if body[0] != .Assign(target: .Local(name: name, ..), op: op, value: value, ..) -> return None
        info :: self.lookup(name) ?? return None
        element_type :: ~info.ty
        if !is_auto_vectorizable_scalar(element_type) || !info.mutable || info.param_conv != None -> return None
        addend :: if op == {
            .Val(.Add) && !self.expr_mentions_ident(value, name) -> &value
            .None -> {
                if value.without_parens() != .Binary(BinOp.Add, left, right, _) -> return None
                left_has :: self.expr_mentions_ident(left, name)
                right_has :: self.expr_mentions_ident(right, name)
                if (left_has, right_has) == { (true, false) -> &right; (false, true) -> &left; _ -> return None }
            }
            _ -> return None
        }
        inputs := [String:Bool]{}
        if !self.prove_auto_element_expr(addend, loop_var, element_type, extent, "", false, &inputs) || inputs.is_empty() -> return None
        // MIR replaces the loop-carried accumulator with the fixed-width lane tree.
        Val(AutoVectorBodyProof{outputs: [:], inputs: ^inputs, element_type: ^element_type, no_early_exit: true, no_cross_iteration_deps: false})
    }
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:569
    fn expr_mentions_ident(self: &Self, expr: &Expr, name: String) -> Bool {
        if expr.without_parens() == {
            .Ident(current, _) -> current == name
            .Unary(_, inner, _) -> self.expr_mentions_ident(inner, name)
            .Binary(_, left, right, _) -> self.expr_mentions_ident(left, name) || self.expr_mentions_ident(right, name)
            .Field(base, _, _), .Index(base: base, ..) -> self.expr_mentions_ident(base, name)
            _ -> false
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:583
    fn prove_auto_element_expr(self: &Self, expr: &Expr, loop_var: String, element_type: &Type, extent: U64?, output: String, same_lane_output: Bool, inputs: &[String:Bool]) -> Bool {
        if expr.without_parens() == {
            .Int, .Float -> true
            .Ident(name, _) && name == loop_var -> true
            .Ident(name, _) -> self.lookup(name).is_some_and(info -> is_auto_vectorizable_scalar(info.ty) && info.ty == element_type)
            .Unary(UnOp.Neg, inner, _) -> self.prove_auto_element_expr(inner, loop_var, element_type, extent, output, same_lane_output, &inputs)
            .Binary(op, left, right, _) && (op == BinOp.Add || op == BinOp.Sub || op == BinOp.Mul || op == BinOp.Div) -> self.prove_auto_element_expr(left, loop_var, element_type, extent, output, same_lane_output, &inputs) && self.prove_auto_element_expr(right, loop_var, element_type, extent, output, same_lane_output, &inputs)
            .Index(base: base, index: index, ..) -> {
                if base.without_parens() != .Ident(root, _) -> return false
                ty :: self.auto_collection_element_type(root, index, loop_var, extent) ?? return false
                if ty != element_type || !is_auto_vectorizable_scalar(ty) || root == output -> return false
                inputs.insert(~root, true)
                true
            }
            .Field(base, field, span) -> {
                if base.without_parens() != .Index(base: collection, index: index, ..) -> return false
                if collection.without_parens() != .Ident(root, _) -> return false
                elem :: self.auto_collection_element_type(root, index, loop_var, extent) ?? return false
                ty :: self.field_type(elem, field, span) ?? return false
                if ty != element_type || !is_auto_vectorizable_scalar(ty) || root == output -> return false
                inputs.insert(~root, true)
                true
            }
            _ -> false
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:676
    pub fn check_kernel_marker(self: &Self, f: &Func, owner_type: String?) {
        if f.kernel != .Val(marker) -> return
        failure := KernelFailure?{None}
        if owner_type != None { failure = Val(KernelFailure{obligation: "top-level declaration", span: marker.span}) }
        else if marker.mode != KernelMode.Parallel { failure = Val(KernelFailure{obligation: "parallel execution mode", span: marker.span}) }
        else if f.is_unsafe { failure = Val(KernelFailure{obligation: "safe memory boundary", span: f.unsafe_span.unwrap_or(marker.span)}) }
        else if f.is_reactive || f.is_job || f.inline_foreign != None { failure = Val(KernelFailure{obligation: "effect-free function body", span: marker.span}) }
        else if !f.type_params.is_empty() || f.params.any(param -> param.variadic || param.convention != AccessConvention.Read) { failure = Val(KernelFailure{obligation: "read-only, monomorphic parameters", span: marker.span}) }
        else if f.params.any(param -> self.crossing_problem(param.ty, SendCrossing.Kernel, true) != None) || f.return_type.is_some_and(ty -> self.crossing_problem(ty, SendCrossing.Kernel, true) != None) { failure = Val(KernelFailure{obligation: "sendable kernel boundary values", span: marker.span}) }
        else if f.declared_effects.is_some_and(effects -> !effects.is_empty()) || !self.fx_direct.is_empty() || !self.fx_edges.is_empty() || self.fx_maximal { failure = Val(KernelFailure{obligation: "no reachable effects or opaque calls", span: marker.span}) }
        else {
            names := [String:Bool]{}
            loop param in f.params { names.insert(~param.name, true) }
            loop statement in f.body {
                if failure != None -> break
                self.prove_kernel_statement(statement, &names) catch found -> { failure = Val(^found) }
            }
        }
        if failure == .Val(found) {
            marker.proof = None
            if found.obligation == "sendable kernel boundary values" {
                loop param in f.params {
                    if self.crossing_problem(param.ty, SendCrossing.Kernel, true) == .Val(problem) {
                        self.report_unsendable(param.name, param.ty, ^problem, SendCrossing.Kernel, marker.span)
                        return
                    }
                }
                if f.return_type == .Val(ty) {
                    if self.crossing_problem(ty, SendCrossing.Kernel, true) == .Val(problem) {
                        self.report_unsendable("kernel result", ty, ^problem, SendCrossing.Kernel, marker.span)
                        return
                    }
                }
            }
            self.diags.push(kernel_failure(found.obligation, found.span))
        } else { marker.proof = Val(KernelProof.parallel()) }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:781
    fn prove_kernel_statement(self: &Self, statement: &Stmt, names: &[String:Bool]) KernelFailure! {
        if statement == {
            .Expr(expression), .Return(.Val(expression), _) -> self.prove_kernel_expr(expression, names)
            .Return(.None, _) -> {}
            .Val(binding) && !binding.mutable && binding.pattern == None -> self.prove_kernel_binding(binding, &names)
            .Val(binding) -> throw KernelFailure{obligation: "immutable scalar locals", span: binding.name_span}
            _ -> throw KernelFailure{obligation: "uniform straight-line control flow", span: statement.span()}
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:804
    fn prove_kernel_binding(self: &Self, binding: &Binding, names: &[String:Bool]) KernelFailure! {
        self.prove_kernel_expr(binding.init, names)
        names.insert(~binding.name, true)
    }
    // Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:814
    fn prove_kernel_expr(self: &Self, expression: &Expr, names: &[String:Bool]) KernelFailure! {
        if expression == {
            .Int, .Float, .Bool, .Char -> {}
            .Ident(name, _) && names.contains_key(name) -> {}
            .Ident(_, span) -> throw KernelFailure{obligation: "closed captures", span: span}
            .Unary(_, inner, _), .Paren(inner, _), .Copy(inner, _), .Ok(inner, _), .Err(inner, _), .Present(inner, _), .Tainted(inner, _, _), .Place(inner, PlaceAccess.Read, _) -> self.prove_kernel_expr(inner, names)
            .Binary(_, left, right, _) -> { self.prove_kernel_expr(left, names); self.prove_kernel_expr(right, names) }
            .Field(base, _, _) -> self.prove_kernel_expr(base, names)
            .ListLit(items, _) -> loop item in items { self.prove_kernel_expr(item, names) }
            .MethodCall(receiver: receiver, method: method, args: args, ..) && (if receiver == { .Ident(alias, _) -> self.core_imports.get(alias).is_some_and(module -> module == "core.compute"); _ -> false }) && SAFE_COMPUTE_CALLS.contains(method) -> loop argument in args { self.prove_kernel_expr(argument.expr, names) }
            .MethodCall(method_span: span, ..) -> throw KernelFailure{obligation: "audited Core compute calls only", span: span}
            .Call(call) -> throw KernelFailure{obligation: "closed captures and provider calls", span: call.name_span}
            .Index(span: span, ..), .Slice(span: span, ..) -> throw KernelFailure{obligation: "statically proved bounds", span: span}
            .Lambda(lambda) -> throw KernelFailure{obligation: "no captures", span: lambda.span}
            .CallValue(span: span, ..) -> throw KernelFailure{obligation: "closed calls", span: span}
            _ -> throw KernelFailure{obligation: "race-free straight-line body", span: expression.span()}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:895
fn is_auto_vectorizable_scalar(ty: &Type) -> Bool { ty == Type.Float || ty == Type.Float32 }
// Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:899
fn is_auto_scalar(ty: &Type) -> Bool { if ty == { .Int, .Float, .Bool, .IntN, .Float32 -> true; _ -> false } }
// Rust: crates/jet-sema/src/Sema/CheckerKernel.rs:906
fn kernel_failure(obligation: String, span: Span) -> Diagnostic {
    Diagnostic.error("E1102", "`#Kernel(.parallel)` cannot cross its worker boundary: sema cannot prove {obligation}", "a safe kernel crosses a worker boundary only after sema proves sendability, bounds, aliasing, captures, races, barriers, and control flow before TIR", "use a read-only effect-free expression over checked Core compute operations, or move provider/raw code behind its typed `#Unsafe` boundary", Val(span))
}
