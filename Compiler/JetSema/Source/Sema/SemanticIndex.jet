// Checked Source metadata shared with the inward pure JetSemIndex builder.
// The obsolete AST/graph -> partial Ct index has been removed: Driver retains
// ONE full SemIndex and Eval projects its original compiler reflection view.
// Keep the real registry producer and shared source-span helpers used by normal
// semantic checking; neither constructs a competing semantic index.
use core.files.runtime.kernel_path_components as sema_index_os_path
use jet_foundation.[FactKind, FactRegistry, LValue, Span, Stmt, expr_span, fact_registry_declare, fact_registry_declare_member, fact_registry_declare_with_rules, fact_registry_new]

pub struct SemaCompilerModuleSource {
    pub module_identity: String
    pub source: String
    // ProgramBundle/LoadedModule provenance, retained by the real Loader.
    // Generated source labels are paths, never invented filesystem files.
    pub loaded_source: String
    pub path: String
    pub display: String
    pub relative_path: String
    pub alias: String
    pub pub_file: Bool
    pub source_origin: SemaSourceOrigin
    pub physical_path: sema_index_os_path.OsPath?
    // Compact original bundle order; None marks registration-only modules.
    pub loaded_module_index: Int?
}

// Rust Bundle.rs::register_effect_facts/check_fact_tags_and_states: the
// actual effect declaration owner and checked taint owner populate one
// canonical registry. StateTable attaches validated rows/graphs afterward.
pub fn sema_fact_registry_from_checked_taint(registration: SemaRegistrationGraph, taint: SemaTaintResult) -> FactRegistry Never! {
    registry := fact_registry_new()
    loop root in sema_effect_grantable_roots() -> fact_registry_declare(&registry, FactKind.Effect, root, [String]{})
    leaves := [SemaEffectLeaf]{}
    loop name in sema_effect_builtin_leaves() -> sema_effect_leaf_add(&leaves, name)
    loop registered_module in registration.modules -> sema_effect_leaf_collect(&leaves, registered_module.program.items)
    loop leaf in leaves -> fact_registry_declare_member(&registry, FactKind.Effect, leaf.root, leaf.member)
    loop tag in taint.tag_facts -> fact_registry_declare_with_rules(&registry, FactKind.Tag, tag.name, [String]{}, tag.deny, tag.from)
    registry
}

fn sema_compiler_index_lvalue_span(target: LValue) -> Span Never! {
    if target == {
        .Local(_, span) | .Index(_, _, span, _) | .Field(_, _, span) -> span
    }
}
pub fn sema_compiler_index_stmt_span(statement: Stmt) -> Span {
    if statement == {
        .Expr(value) -> expr_span(value)
        .Val(binding) -> Span{start: if binding.sigil_span == .Val(sigil) -> sigil.start else -> binding.name_span.start, end: expr_span(binding.init).end}
        .Assign(target, _, _, value) -> Span{start: sema_compiler_index_lvalue_span(target).start, end: expr_span(value).end}
        .Return(_, span) | .While(_, _, span, _, _) | .For(_, _, _, _, _, span, _, _, _) | .Switch(_, _, _, span) | .Break(span) | .BreakValue(_, span) | .Continue(span) | .BreakLabel(_, span) | .BreakLabelValue(_, _, _, span) | .ContinueLabel(_, span) | .Loop(_, span, _, _) | .CountedLoop(_, _, _, _, span, _, _) | .Unsafe(_, _, _, span) | .Impure(_, _, _, span) | .Reactive(_, span) | .Shield(_, span) | .Switched(_, _, span) | .Region(_, _, _, span) | .Policy(_, _, span) | .TaskGroup(_, _, _, _, span) | .Layout(_, _, _, span) | .AuthorityScope(_, _, _, _, span) | .ComptimeIf(_, _, _, _, span, _) | .ComptimeSwitch(_, _, _, span) | .ComptimeBlock(_, _, span) | .ContextBlock(_, _, span) | .Live(_, span) | .AssumeDet(_, _, _, span) | .Transact(_, _, _, _, span) | .Yield(_, span) | .ScopeMember(_, _, _, _, _, _, _, span) | .DeferClose(_, span) -> span
    }
}
