// Compiler-facing projection of package-wide checked Source Sema facts.
// This never runs a second checker; callers pass the registered graph and its
// finalized checked result so imported modules and solved effects stay intact.
use jet_foundation.[
    authority_grantable_roots,
    ArithmeticMode,
    ArithmeticOperation,
    ArithmeticPolicyFact,
    CallArg,
    ConstDef,
    DerivationRecord,
    DeriveBodyItem,
    Expr,
    ExprField,
    ExprPair,
    FnBody,
    ForKind,
    Func,
    Item,
    LValue,
    DerivationDisposition,
    DerivationMethod,
    OutputKind,
    ParamZone,
    ResolvedOutput,
    Span,
    Stmt,
    StructDef,
    SwitchArm,
    Symbol,
    SymbolKind,
    TComptimeField,
    TComptimeReport,
    TComptimeValue,
    TLocal,
    TupleField,
    Type,
    ViewProvenance,
    ViewProvenanceMap,
    ViewSource,
    ViewSourcePath,
    derivation_identity,
    derivation_payload_json,
    derivation_record,
    expr_span,
    failure_contract_shown_type,
    failure_contract_source,
    sha256_hex,
    type_name,
]

// `missing` names the first fact that left the index incomplete ("" when complete).
SemaCompilerSemanticIndexFacts: struct {
    value: TComptimeValue
    complete: Bool
    missing: String{""}
}
SemaCompilerModuleSource: struct {
    module_identity: String
    source: String
}

// The first registered module without exactly one source, or source without a
// registered module; "" when the sources match the registration one-to-one.
sema_compiler_index_module_sources_missing: fn(registration: SemaRegistrationGraph, module_sources: [SemaCompilerModuleSource]) -> String Never! {
    loop registered_module_index in 0..<registration.modules.len() {
        matches := 0
        loop module_source in module_sources {
            if module_source.module_identity == registration.modules[registered_module_index].module_identity -> matches += 1
        }
        if matches != 1 -> return "registered module `{registration.modules[registered_module_index].module_identity}` has {matches} sources"
    }
    loop module_source in module_sources {
        found := false
        loop registered_module_index in 0..<registration.modules.len() {
            if module_source.module_identity == registration.modules[registered_module_index].module_identity {
                found = true
                break
            }
        }
        if !found -> return "source module `{module_source.module_identity}` is not registered"
    }
    ""
}

sema_compiler_index_module_source: fn(module_sources: [SemaCompilerModuleSource], module_identity: String) -> String? {
    loop module_source in module_sources {
        if module_source.module_identity == module_identity -> return Val(module_source.source)
    }
    None
}

sema_compiler_index_string: fn(value: String) -> TComptimeValue Never! { TComptimeValue.String{value: value} }
sema_compiler_index_int: fn(value: Int) -> TComptimeValue Never! { TComptimeValue.Int{value: value} }
sema_compiler_index_bool: fn(value: Bool) -> TComptimeValue Never! { TComptimeValue.Bool{value: value} }
// `value` as a SourceSpan of the text of `file`, the module whose text its
// offsets index.
sema_compiler_index_span: fn(value: Span, file: String) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "SourceSpan", fields: [TComptimeField]{
        TComptimeField{name: "file", value: sema_compiler_index_string(file)},
        TComptimeField{name: "start", value: sema_compiler_index_int(value.start)},
        TComptimeField{name: "end", value: sema_compiler_index_int(value.end)},
    }}
}
sema_compiler_index_option_string: fn(value: String?) -> TComptimeValue Never! {
    if value == .Val(item) -> return TComptimeValue.Present{value: sema_compiler_index_string(item)}
    TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.String}}
}
sema_compiler_index_strings: fn(values: [String]) -> TComptimeValue Never! {
    output := [TComptimeValue]{}
    loop value in values -> output.push(sema_compiler_index_string(value))
    TComptimeValue.List{values: output}
}
sema_compiler_index_span_list: fn(values: [Span], file: String) -> TComptimeValue Never! {
    output := [TComptimeValue]{}
    loop value in values -> output.push(sema_compiler_index_span(value, file))
    TComptimeValue.List{values: output}
}

sema_compiler_index_module_path: fn(registration: SemaRegistrationGraph, module_name: String) -> String Never! {
    loop registered_module_index in 0..<registration.modules.len() {
        if registration.modules[registered_module_index].module_name == module_name -> return registration.modules[registered_module_index].module_path
    }
    module_name.copy()
}

// The source file of the module named `module_name`; "" when no module of
// `registration` has that name.
sema_compiler_index_module_file: fn(registration: SemaRegistrationGraph, module_name: String) -> String Never! {
    loop registered_module in registration.modules {
        if registered_module.module_name == module_name -> return registered_module.source_file
    }
    ""
}

sema_compiler_index_definition_kind: fn(symbol: Symbol, registration: SemaRegistrationGraph) -> String Never! {
    if symbol.kind == {
        .Module -> return "module"
        .Function -> return "function"
        .Trait -> return "trait"
        .Constant -> return "const"
        .Field -> return "field"
        .Variant -> return "variant"
        .Parameter -> return "param"
        .Local -> return "local"
        .Type -> {
            loop registered_module_index in 0..<registration.modules.len() {
                if registration.modules[registered_module_index].module_name != symbol.module_name -> next
                loop nominal_index in 0..<registration.modules[registered_module_index].nominals.len() {
                    if registration.modules[registered_module_index].nominals[nominal_index].symbol.id.key != symbol.id.key -> next
                    if registration.modules[registered_module_index].nominals[nominal_index].kind == SemaRegistrationNominalKind.Struct -> return "struct"
                    if registration.modules[registered_module_index].nominals[nominal_index].kind == SemaRegistrationNominalKind.Enum -> return "enum"
                    if registration.modules[registered_module_index].nominals[nominal_index].kind == SemaRegistrationNominalKind.Tag -> return "tag"
                }
            }
            return "type"
        }
        .Impl | .Import | .Foreign | .Label -> return "type"
    }
}

// A type the index names, as the TypeId reflection gives it; `caller` is the
// row of the module the type is written in. Every symbol the index describes
// is registered in this compilation, so every type it names has a TypeId.
sema_compiler_index_type_id_option: fn(registration: SemaRegistrationGraph, caller: Int, ty: Type?) -> TComptimeValue {
    if ty == .Val(value) -> return sema_comptime_reflection_some(sema_comptime_reflection_type_id(registration, caller, value))
    sema_comptime_reflection_none(Type.Named{name: "TypeId"})
}

sema_compiler_index_parameter_values: fn(registration: SemaRegistrationGraph, caller: Int, parameters: [SemaRegistrationParameter]) -> TComptimeValue {
    values := [TComptimeValue]{}
    loop parameter in parameters {
        values.push(TComptimeValue.Struct{type_name: "CompilerParam", fields: [TComptimeField]{
            TComptimeField{name: "name", value: sema_compiler_index_string(parameter.symbol.name)},
            TComptimeField{name: "type", value: sema_comptime_reflection_type_id(registration, caller, parameter.ty)},
        }})
    }
    TComptimeValue.List{values: values}
}

// The CompilerSymbolKind of `symbol`, declared in the module at row `caller`.
sema_compiler_index_symbol_kind: fn(registration: SemaRegistrationGraph, caller: Int, symbol: Symbol) -> TComptimeValue {
    registered_module: registration.modules[caller]
    kind := "type"
    params := TComptimeValue.List{values: [TComptimeValue]{}}
    ret := sema_compiler_index_type_id_option(registration, caller, None)
    parent := symbol.owner
    fields := [TComptimeValue]{}
    variants := [String]{}
    mutable := TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Bool}}
    if symbol.kind == {
        .Module -> kind = "module"
        .Function -> {
            kind = "function"
            loop function in registered_module.functions {
                if function.symbol.id.key != symbol.id.key -> next
                params = sema_compiler_index_parameter_values(registration, caller, function.parameters)
                if function.signature == .Fn(_, return_type, _, _, _, _) {
                    if return_type != None -> ret = sema_compiler_index_type_id_option(registration, caller, return_type)
                }
            }
        }
        .Type -> {
            kind = "type"
            loop nominal in registered_module.nominals {
                if nominal.symbol.id.key != symbol.id.key -> next
                if nominal.kind == SemaRegistrationNominalKind.Struct {
                    kind = "struct"
                    loop field in nominal.fields {
                        fields.push(TComptimeValue.Struct{type_name: "CompilerField", fields: [TComptimeField]{
                            TComptimeField{name: "name", value: sema_compiler_index_string(field.symbol.name)},
                            TComptimeField{name: "type", value: sema_comptime_reflection_type_id(registration, caller, field.ty)},
                        }})
                    }
                }
                if nominal.kind == SemaRegistrationNominalKind.Enum {
                    kind = "enum"
                    loop variant in nominal.variants -> variants.push(variant.symbol.name)
                }
            }
        }
        .Trait -> kind = "trait"
        .Impl -> kind = "impl"
        .Constant -> kind = "const"
        .Field -> kind = "field"
        .Variant -> kind = "enum_variant"
        .Parameter -> kind = "param"
        .Local -> kind = "local"
        .Import -> kind = "import"
        .Foreign -> kind = "foreign"
        .Label -> kind = "label"
    }
    TComptimeValue.Struct{type_name: "CompilerSymbolKind", fields: [TComptimeField]{
        TComptimeField{name: "kind", value: sema_compiler_index_string(kind)},
        TComptimeField{name: "params", value: params},
        TComptimeField{name: "ret", value: ret},
        TComptimeField{name: "parent", value: sema_compiler_index_option_string(parent)},
        TComptimeField{name: "type", value: sema_compiler_index_type_id_option(registration, caller, symbol.ty)},
        TComptimeField{name: "fields", value: TComptimeValue.List{values: fields}},
        TComptimeField{name: "variants", value: sema_compiler_index_strings(variants)},
        TComptimeField{name: "mutable", value: mutable},
    }}
}
sema_compiler_index_view_source_value: fn(source: ViewSource) -> TComptimeValue Never! {
    if source == {
        .Receiver -> return TComptimeValue.Struct{type_name: "CompilerViewSource", fields: [TComptimeField]{
            TComptimeField{name: "kind", value: sema_compiler_index_string("receiver")},
            TComptimeField{name: "index", value: sema_compiler_index_option_int(None)},
            TComptimeField{name: "module", value: sema_compiler_index_option_string(None)},
            TComptimeField{name: "name", value: sema_compiler_index_option_string(None)},
        }}
        .Parameter(index) -> return TComptimeValue.Struct{type_name: "CompilerViewSource", fields: [TComptimeField]{
            TComptimeField{name: "kind", value: sema_compiler_index_string("parameter")},
            TComptimeField{name: "index", value: sema_compiler_index_option_int(Val(index))},
            TComptimeField{name: "module", value: sema_compiler_index_option_string(None)},
            TComptimeField{name: "name", value: sema_compiler_index_option_string(None)},
        }}
        .Static(module_path, name) -> return TComptimeValue.Struct{type_name: "CompilerViewSource", fields: [TComptimeField]{
            TComptimeField{name: "kind", value: sema_compiler_index_string("static")},
            TComptimeField{name: "index", value: sema_compiler_index_option_int(None)},
            TComptimeField{name: "module", value: sema_compiler_index_option_string(Val(module_path))},
            TComptimeField{name: "name", value: sema_compiler_index_option_string(Val(name))},
        }}
    }
}

sema_compiler_index_view_provenance_value: fn(value: ViewProvenance, output_path: [String]) -> TComptimeValue Never! {
    sources := [TComptimeValue]{}
    loop path in value.sources {
        projections := [TComptimeValue]{}
        loop projection in path.projections {
            if projection == {
                .Field(name) -> projections.push(TComptimeValue.Struct{type_name: "CompilerViewProjection", fields: [TComptimeField]{
                    TComptimeField{name: "kind", value: sema_compiler_index_string("field")},
                    TComptimeField{name: "name", value: sema_compiler_index_option_string(Val(name))},
                }})
                .Index -> projections.push(TComptimeValue.Struct{type_name: "CompilerViewProjection", fields: [TComptimeField]{
                    TComptimeField{name: "kind", value: sema_compiler_index_string("index")},
                    TComptimeField{name: "name", value: sema_compiler_index_option_string(None)},
                }})
                .Range -> projections.push(TComptimeValue.Struct{type_name: "CompilerViewProjection", fields: [TComptimeField]{
                    TComptimeField{name: "kind", value: sema_compiler_index_string("range")},
                    TComptimeField{name: "name", value: sema_compiler_index_option_string(None)},
                }})
            }
        }
        sources.push(TComptimeValue.Struct{type_name: "CompilerViewSourcePath", fields: [TComptimeField]{
            TComptimeField{name: "source", value: sema_compiler_index_view_source_value(path.source)},
            TComptimeField{name: "projections", value: TComptimeValue.List{values: projections}},
        }})
    }
    TComptimeValue.Struct{type_name: "CompilerViewProvenance", fields: [TComptimeField]{
        TComptimeField{name: "output_path", value: sema_compiler_index_strings(output_path)},
        TComptimeField{name: "sources", value: TComptimeValue.List{values: sources}},
        TComptimeField{name: "mutable", value: sema_compiler_index_bool(value.mutable)},
    }}
}

sema_compiler_index_view_provenance_values: fn(map: ViewProvenanceMap?) -> TComptimeValue Never! {
    if map == .Val(value) {
        values := [TComptimeValue]{}
        loop entry in value.entries -> values.push(sema_compiler_index_view_provenance_value(entry.value, entry.slot))
        return TComptimeValue.List{values: values}
    }
    TComptimeValue.List{values: [TComptimeValue]{}}
}

// `caller` is the row of the module that declares `symbol`.
sema_compiler_index_definition: fn(registration: SemaRegistrationGraph, caller: Int, symbol: Symbol, view_provenance: TComptimeValue) -> TComptimeValue {
    TComptimeValue.Struct{type_name: "CompilerDefinition", fields: [TComptimeField]{
        TComptimeField{name: "identity", value: sema_compiler_index_string(symbol.id.key)},
        TComptimeField{name: "name", value: sema_compiler_index_string(symbol.name)},
        TComptimeField{name: "module", value: sema_compiler_index_string(registration.modules[caller].module_path)},
        TComptimeField{name: "span", value: sema_compiler_index_span(symbol.span, registration.modules[caller].source_file)},
        TComptimeField{name: "kind", value: sema_compiler_index_symbol_kind(registration, caller, symbol)},
        TComptimeField{name: "view_provenance", value: view_provenance},
    }}
}

sema_compiler_index_anchor: fn(symbol: Symbol, registration: SemaRegistrationGraph) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "CompilerDefinitionAnchor", fields: [TComptimeField]{
        TComptimeField{name: "module", value: sema_compiler_index_string(sema_compiler_index_module_path(registration, symbol.module_name))},
        TComptimeField{name: "kind", value: sema_compiler_index_string(sema_compiler_index_definition_kind(symbol, registration))},
        TComptimeField{name: "semantic_identity", value: sema_compiler_index_option_string(Val(symbol.id.key))},
        TComptimeField{name: "span", value: sema_compiler_index_span(symbol.span, sema_compiler_index_module_file(registration, symbol.module_name))},
    }}
}

sema_compiler_index_reference: fn(reference: SemaNameReferenceFact, registration: SemaRegistrationGraph, module_path: String, file: String) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "CompilerReference", fields: [TComptimeField]{
        TComptimeField{name: "name", value: sema_compiler_index_string(reference.symbol.name)},
        TComptimeField{name: "module", value: sema_compiler_index_string(module_path)},
        TComptimeField{name: "scope_identity", value: sema_compiler_index_option_string(None)},
        TComptimeField{name: "target", value: TComptimeValue.Present{value: sema_compiler_index_anchor(reference.symbol, registration)}},
        TComptimeField{name: "span", value: sema_compiler_index_span(reference.span, file)},
    }}
}

sema_compiler_index_call: fn(call: SemaCallSiteFact, module_path: String, file: String) -> TComptimeValue? {
    callee: call.callee ?? return None
    TComptimeValue.Struct{type_name: "CompilerCall", fields: [TComptimeField]{
        TComptimeField{name: "caller", value: sema_compiler_index_string(call.caller_key)},
        TComptimeField{name: "callee", value: sema_compiler_index_string(callee.key)},
        TComptimeField{name: "module", value: sema_compiler_index_string(module_path)},
        TComptimeField{name: "span", value: sema_compiler_index_span(call.span, file)},
    }}
}

sema_compiler_index_provenance: fn(function: FnBody, effect_name: String, file: String) -> [TComptimeValue] Never! {
    output := [TComptimeValue]{}
    loop source in function.effects.direct_spans {
        if source.name != effect_name -> next
        output.push(TComptimeValue.Struct{type_name: "CompilerEffectProvenance", fields: [TComptimeField]{
            TComptimeField{name: "effect", value: sema_compiler_index_string(effect_name)},
            TComptimeField{name: "call_path", value: sema_compiler_index_strings([String]{function.key})},
            TComptimeField{name: "spans", value: sema_compiler_index_span_list([Span]{source.span}, file)},
        }})
    }
    output
}

sema_compiler_index_effect: fn(function: FnBody, file: String) -> TComptimeValue Never! {
    provenance := [TComptimeValue]{}
    loop effect_name in function.effects.solved {
        loop row in sema_compiler_index_provenance(function, effect_name, file) -> provenance.push(row)
    }
    TComptimeValue.Struct{type_name: "CompilerEffect", fields: [TComptimeField]{
        TComptimeField{name: "function", value: sema_compiler_index_string(function.key)},
        TComptimeField{name: "direct", value: sema_compiler_index_strings(function.effects.direct)},
        TComptimeField{name: "callees", value: sema_compiler_index_strings(function.effects.call_edges)},
        TComptimeField{name: "inferred", value: sema_compiler_index_strings(function.effects.solved)},
        TComptimeField{name: "maximal", value: sema_compiler_index_bool(function.effects.maximal)},
        TComptimeField{name: "provenance", value: TComptimeValue.List{values: provenance}},
    }}
}

sema_compiler_index_option_int: fn(value: Int?) -> TComptimeValue Never! {
    if value == .Val(item) -> return TComptimeValue.Present{value: sema_compiler_index_int(item)}
    TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Int}}
}

sema_compiler_index_option_bool: fn(value: Bool?) -> TComptimeValue Never! {
    if value == .Val(item) -> return TComptimeValue.Present{value: sema_compiler_index_bool(item)}
    TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Bool}}
}

sema_compiler_index_arithmetic_mode: fn(mode: ArithmeticMode) -> String Never! {
    if {
        mode == ArithmeticMode.Checked -> "Checked"
        mode == ArithmeticMode.Wrapping -> "Wrapping"
        else -> "Saturating"
    }
}

sema_compiler_index_arithmetic_operation: fn(operation: ArithmeticOperation) -> String Never! {
    if {
        operation == ArithmeticOperation.Add -> "add"
        operation == ArithmeticOperation.Sub -> "sub"
        operation == ArithmeticOperation.Mul -> "mul"
        operation == ArithmeticOperation.Neg -> "neg"
        else -> "pow"
    }
}

sema_compiler_index_arithmetic_fact: fn(fact: ArithmeticPolicyFact, module_path: String, file: String) -> TComptimeValue Never! {
    operation: fact.operation ?? ArithmeticOperation.Add
    TComptimeValue.Struct{type_name: "CompilerArithmeticOperation", fields: [TComptimeField]{
        TComptimeField{name: "operation", value: sema_compiler_index_string(sema_compiler_index_arithmetic_operation(operation))},
        TComptimeField{name: "policy", value: sema_compiler_index_string(sema_compiler_index_arithmetic_mode(fact.mode))},
        TComptimeField{name: "module", value: sema_compiler_index_string(module_path)},
        TComptimeField{name: "operation_span", value: sema_compiler_index_span(fact.operation_span, file)},
        TComptimeField{name: "scope_span", value: sema_compiler_index_span(fact.scope_span, file)},
    }}
}

sema_compiler_index_output_kind: fn(kind: OutputKind) -> String Never! {
    if {
        kind == OutputKind.Library -> "library"
        kind == OutputKind.Executable -> "executable"
        kind == OutputKind.Service -> "service"
        kind == OutputKind.Check -> "check"
        kind == OutputKind.Environment -> "environment"
        kind == OutputKind.Image -> "image"
        kind == OutputKind.Bundle -> "bundle"
        kind == OutputKind.Fleet -> "fleet"
        else -> "system"
    }
}

// The CompilerOutput of a resolved `output` bound by `binding` in the module at
// row `caller`; the entry's types are written in the entry's own module.
sema_compiler_index_output_value: fn(output: ResolvedOutput, binding: ConstDef, registration: SemaRegistrationGraph, caller: Int) -> TComptimeValue {
    registered_module: registration.modules[caller]
    target_row: if output.module_id >= 0 && output.module_id < registration.modules.len() -> output.module_id else -> caller
    target_module: registration.modules[target_row]
    params := [TComptimeValue]{}
    loop parameter in output.params -> params.push(sema_comptime_reflection_type_id(registration, target_row, parameter.ty))
    effects := output.effects
    TComptimeValue.Struct{type_name: "CompilerOutput", fields: [TComptimeField]{
        TComptimeField{name: "binding", value: sema_compiler_index_string(binding.name)},
        TComptimeField{name: "kind", value: sema_compiler_index_string(sema_compiler_index_output_kind(output.kind))},
        TComptimeField{name: "name", value: sema_compiler_index_string(output.output_name)},
        TComptimeField{name: "module", value: sema_compiler_index_string(registered_module.module_path)},
        TComptimeField{name: "span", value: sema_compiler_index_span(binding.span, registered_module.source_file)},
        TComptimeField{name: "entry", value: TComptimeValue.Struct{type_name: "CompilerOutputEntry", fields: [TComptimeField]{
            TComptimeField{name: "identity", value: sema_compiler_index_string("{target_module.module_name}::{output.semantic_name}")},
            TComptimeField{name: "name", value: sema_compiler_index_string(output.source_name)},
            TComptimeField{name: "module", value: sema_compiler_index_string(output.source_path)},
            TComptimeField{name: "definition_span", value: sema_compiler_index_span(output.definition, target_module.source_file)},
            TComptimeField{name: "reference_span", value: sema_compiler_index_span(output.reference, registered_module.source_file)},
            TComptimeField{name: "params", value: TComptimeValue.List{values: params}},
            TComptimeField{name: "return_type", value: sema_compiler_index_type_id_option(registration, target_row, output.return_type)},
            TComptimeField{name: "failure_contract", value: sema_compiler_index_string(type_name(failure_contract_shown_type(output.failure_contract)))},
            TComptimeField{name: "failure_source", value: sema_compiler_index_string(failure_contract_source(output.failure_contract))},
            TComptimeField{name: "authority", value: sema_compiler_index_string("safe-jet")},
            TComptimeField{name: "effects", value: sema_compiler_index_strings(effects)},
        }}},
    }}
}

sema_compiler_index_state_graph_value: fn(fact: SemaStateGraphFact, definition: StructDef, module_path: String, file: String) -> TComptimeValue Never! {
    nodes := [TComptimeValue]{}
    loop node in fact.states {
        state_span := Span{start: 0, end: 0}
        if definition.state == .Val(state) {
            loop declaration in state.states {
                if declaration.name == node.name -> state_span = declaration.span
            }
        }
        nodes.push(TComptimeValue.Struct{type_name: "CompilerStateNode", fields: [TComptimeField]{
            TComptimeField{name: "name", value: sema_compiler_index_string(node.name)},
            TComptimeField{name: "terminal", value: sema_compiler_index_bool(node.terminal)},
            TComptimeField{name: "reachable", value: sema_compiler_index_option_bool(node.reachable)},
            TComptimeField{name: "span", value: sema_compiler_index_span(state_span, file)},
        }})
    }
    transitions := [TComptimeValue]{}
    loop transition in fact.transitions {
        transitions.push(TComptimeValue.Struct{type_name: "CompilerStateTransition", fields: [TComptimeField]{
            TComptimeField{name: "operation", value: sema_compiler_index_string(transition.operation)},
            TComptimeField{name: "from", value: sema_compiler_index_option_string(transition.from)},
            TComptimeField{name: "to", value: sema_compiler_index_string(transition.to)},
        }})
    }
    TComptimeValue.Struct{type_name: "CompilerStateGraph", fields: [TComptimeField]{
        TComptimeField{name: "owner", value: sema_compiler_index_string(fact.type_name)},
        TComptimeField{name: "module", value: sema_compiler_index_string(module_path)},
        TComptimeField{name: "states", value: TComptimeValue.List{values: nodes}},
        TComptimeField{name: "transitions", value: TComptimeValue.List{values: transitions}},
    }}
}

sema_compiler_index_fact_declaration: fn(kind: String, name: String, members: [String], deny: [String], from: [String]) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "CompilerFactDeclaration", fields: [TComptimeField]{
        TComptimeField{name: "kind", value: sema_compiler_index_string(kind)},
        TComptimeField{name: "name", value: sema_compiler_index_string(name)},
        TComptimeField{name: "members", value: sema_compiler_index_strings(members)},
        TComptimeField{name: "deny", value: sema_compiler_index_strings(deny)},
        TComptimeField{name: "from", value: sema_compiler_index_strings(from)},
    }}
}

sema_compiler_index_sorted_strings: fn(values: [String]) -> [String] Never! {
    result := values
    loop i in 1..<result.len() {
        value := result[i]
        j := i
        loop j > 0 && result[j - 1] > value {
            result[j] = result[j - 1]
            j -= 1
        }
        result[j] = value
    }
    unique := [String]{}
    loop value in result {
        if unique.len() == 0 || unique[unique.len() - 1] != value -> unique.push(value)
    }
    unique
}

SemaCompilerFactRegistryRow: struct {
    kind: String
    name: String
    members: [String]
    deny: [String]
    from: [String]
}

sema_compiler_index_fact_kind_order: fn(kind: String) -> Int Never! {
    if {
        kind == "Effect" -> 0
        kind == "State" -> 1
        else -> 2
    }
}

sema_compiler_index_fact_registry: fn(registration: SemaRegistrationGraph) -> TComptimeValue Never! {
    rows := [SemaCompilerFactRegistryRow]{}
    loop root in sema_compiler_index_sorted_strings(authority_grantable_roots()) {
        members := [String]{}
        loop registration_module_index in 0..<registration.modules.len() {
            loop item_index in 0..<registration.modules[registration_module_index].program.items.len() {
                if registration.modules[registration_module_index].program.items[item_index] == .EffectDecl(declaration) {
                    parts := declaration.name.split(".").to_list()
                    if parts.len() == 2 && parts[0] == root -> members.push(parts[1])
                }
            }
        }
        rows.push(SemaCompilerFactRegistryRow{
            kind: "Effect",
            name: root,
            members: sema_compiler_index_sorted_strings(members),
            deny: [String]{},
            from: [String]{},
        })
    }
    all_items := [Item]{}
    loop registration_module_index in 0..<registration.modules.len() {
        loop item_index in 0..<registration.modules[registration_module_index].program.items.len() {
            item: registration.modules[registration_module_index].program.items[item_index]
            all_items.push(item.copy())
        }
    }
    loop fact in sema_state_graph_facts(all_items) {
        members := [String]{}
        loop node in fact.states -> members.push(node.name)
        rows.push(SemaCompilerFactRegistryRow{
            kind: "State",
            name: "{fact.type_name}.State",
            members: members,
            deny: [String]{},
            from: [String]{},
        })
    }
    loop name in sema_taint_builtin_tag_names() {
        builtin: sema_taint_builtin_tag(name) ?? next
        rows.push(SemaCompilerFactRegistryRow{
            kind: "Tag",
            name: builtin.name,
            members: [String]{},
            deny: sema_compiler_index_sorted_strings(builtin.deny),
            from: sema_compiler_index_sorted_strings(builtin.from),
        })
    }
    loop registration_module_index in 0..<registration.modules.len() {
        loop item_index in 0..<registration.modules[registration_module_index].program.items.len() {
            if registration.modules[registration_module_index].program.items[item_index] == .Tag(tag_value) {
                deny := [String]{}
                from := [String]{}
                loop entry in tag_value.deny -> deny.push(entry.name)
                loop entry in tag_value.from -> from.push(entry.name)
                rows.push(SemaCompilerFactRegistryRow{
                    kind: "Tag",
                    name: tag_value.name,
                    members: [String]{},
                    deny: sema_compiler_index_sorted_strings(deny),
                    from: sema_compiler_index_sorted_strings(from),
                })
            }
        }
    }
    loop i in 1..<rows.len() {
        value := rows[i]
        j := i
        loop j > 0 && (
            sema_compiler_index_fact_kind_order(rows[j - 1].kind) > sema_compiler_index_fact_kind_order(value.kind)
            || (sema_compiler_index_fact_kind_order(rows[j - 1].kind) == sema_compiler_index_fact_kind_order(value.kind) && rows[j - 1].name > value.name)
        ) {
            rows[j] = rows[j - 1]
            j -= 1
        }
        rows[j] = value
    }
    values := [TComptimeValue]{}
    loop row in rows -> values.push(sema_compiler_index_fact_declaration(row.kind, row.name, row.members, row.deny, row.from))
    TComptimeValue.List{values: values}
}

SemaCompilerIndexStructuralRecord: struct {
    id: Int
    parent: Int?
    slot: String
    slot_is_list: Bool
    ordinal: Int
    class: String
    shape: String
    module_path: String
    module_identity: String
    span: Span
}

SemaCompilerIndexWalkState: struct {
    nodes: [TComptimeValue]
    structural: [SemaCompilerIndexStructuralRecord]
    arithmetic: [TComptimeValue]
    parents: [Int]
    // The next ordinal of each (parent, slot) pair, keyed by sema_compiler_index_ordinal_key.
    ordinals: [String:Int]
    slot: String
    slot_is_list: Bool
    module_identity: String
    // The source file of the module being walked.
    file: String
}

sema_compiler_index_walk_state: fn() -> SemaCompilerIndexWalkState Never! {
    SemaCompilerIndexWalkState{
        nodes: [TComptimeValue]{},
        structural: [SemaCompilerIndexStructuralRecord]{},
        arithmetic: [TComptimeValue]{},
        parents: [Int]{},
        ordinals: [String:Int]{},
        slot: "root",
        slot_is_list: true,
        module_identity: "",
        file: "",
    }
}

sema_compiler_index_item_shape: fn(item: Item) -> String Never! {
    index := if item == {
        .Func(_) -> 0
        .Struct(_) -> 1
        .Enum(_) -> 2
        .Distinct(_) -> 3
        .TypeAlias(_) -> 4
        .UnitFamily(_) -> 5
        .Trait(_) -> 6
        .Tag(_) -> 7
        .EffectDecl(_) -> 8
        .Impl(_) -> 9
        .Const(_) -> 10
        .Test(_) -> 11
        .ExternRust(_) -> 12
        .Module(_) -> 13
        .CModule(_) -> 14
        .CodeModule(_) -> 15
        .ErrorConv(_) -> 16
        .Migration(_) -> 17
        .ProtocolDecl(_) -> 18
        .TemplateLoop(_) -> 19
        .GenericModule(_) -> 20
        .ModuleAlias(_) -> 21
        .MarkerDecl(_) -> 22
        .FactDecl(_) -> 23
    }
    "Discriminant({index})"
}

sema_compiler_index_item_span: fn(item: Item) -> Span Never! {
    if item == {
        .Func(value) -> value.span
        .Struct(value) -> value.span
        .Enum(value) -> value.span
        .Distinct(value) -> value.span
        .TypeAlias(value) -> value.span
        .UnitFamily(value) -> value.span
        .Trait(value) -> value.span
        .Tag(value) -> value.span
        .EffectDecl(value) -> value.span
        .Impl(value) -> value.span
        .Const(value) -> value.span
        .Test(value) -> value.span
        .ExternRust(value) -> value.span
        .Module(value) -> value.span
        .CModule(value) -> value.span
        .CodeModule(value) -> value.span
        .ErrorConv(value) -> value.from_span
        .Migration(value) -> value.span
        .ProtocolDecl(value) -> value.span
        .TemplateLoop(value) -> value.span
        .GenericModule(value) -> value.span
        .ModuleAlias(value) -> value.span
        .MarkerDecl(value) -> value.span
        .FactDecl(value) -> value.span
    }
}

sema_compiler_index_expr_shape: fn(expression: Expr) -> String {
    index := if expression == {
        .Str(_, _, _) -> 0
        .StrMatchLit(_, _, _) -> 1
        .BinMatchLit(_, _, _) -> 2
        .Int(_, _, _, _, _) -> 3
        .Float(_, _, _, _, _) -> 4
        .Bool(_, _, _) -> 5
        .Unit(_, _) -> 6
        .Char(_, _, _) -> 7
        .ListLit(_, _, _) -> 8
        .MemberSpread(_, _, _, _) -> 9
        .Spread(_, _, _) -> 10
        .MapLit(_, _, _) -> 11
        .Index(_, _, _, _, _) -> 12
        .Slice(_, _, _, _, _, _) -> 13
        .Range(_, _, _, _, _) -> 14
        .Ident(_, _, _) -> 15
        .Call(_, _) -> 16
        .Unary(_, _, _, _) -> 17
        .Binary(_, _, _, _, _) -> 18
        .CompareChain(_, _, _, _, _) -> 19
        .UnitLit(_, _, _, _, _, _, _) -> 20
        .Deref(_, _, _) -> 21
        .RawOf(_, _, _) -> 22
        .Copy(_, _, _) -> 23
        .Place(_, _, _, _) -> 24
        .Field(_, _, _, _) -> 25
        .OptField(_, _, _, _, _, _) -> 26
        .MethodCall(_, _, _, _, _, _, _) -> 27
        .StructLit(_, _, _, _, _, _, _, _) -> 28
        .TypedLit(_, _, _, _) -> 29
        .EnumLit(_, _, _, _, _, _, _) -> 30
        .Tainted(_, _, _, _) -> 31
        .Present(_, _, _) -> 32
        .Absent(_, _) -> 33
        .Todo(_, _, _) -> 34
        .NoElse(_, _) -> 35
        .PatternTest(_, _, _, _) -> 37
        .Ok(_, _, _) -> 38
        .Err(_, _, _) -> 39
        .Try(_, _, _, _, _) -> 40
        .OrFallback(_, _, _, _, _) -> 41
        .If(_, _, _, _, _, _, _) -> 42
        .TupleLit(_, _, _, _) -> 43
        .Lambda(_, _) -> 44
        .CallValue(_, _, _, _) -> 45
        .PtrFromAddr(_, _, _, _, _, _) -> 46
        .ComptimeName(_, _, _, _) -> 47
        .Paren(_, _, _) -> 48
        .OptMethodCall(_, _, _, _, _, _, _) -> 49
        .Pipe(_, _, _, _) -> 50
        .TypeValue(_, _, _) -> 51
    }
    "Discriminant({index})"
}

sema_compiler_index_expr_structural_span: fn(expression: Expr) -> Span {
    if expression == {
        .Call(call, _) -> {
            end := call.name_span.end + 2
            if call.args.len() > 0 -> end = expr_span(call.args[call.args.len() - 1].expr).end + 1
            Span{start: call.name_span.start, end: end}
        }
        .MethodCall(receiver, _, method_span, _, _, args, _) | .OptMethodCall(receiver, _, method_span, _, args, _, _) -> {
            end := method_span.end + 2
            if args.len() > 0 -> end = expr_span(args[args.len() - 1].expr).end + 1
            Span{start: expr_span(receiver).start, end: end}
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> expr_span(expression)
    }
}

sema_compiler_index_lvalue_span: fn(target: LValue) -> Span Never! {
    if target == {
        .Local(_, span) | .Index(_, _, span, _) | .Field(_, _, span) -> span
    }
}

sema_compiler_index_stmt_shape: fn(statement: Stmt) -> String Never! {
    index := if statement == {
        .Expr(_) -> 0
        .Val(_) -> 1
        .Assign(_, _, _, _) -> 2
        .Return(_, _) -> 3
        .While(_, _, _, _, _) -> 4
        .For(_, _, _, _, _, _, _, _, _) -> 5
        .Switch(_, _, _, _) -> 6
        .Break(_) -> 7
        .BreakValue(_, _) -> 8
        .Continue(_) -> 9
        .BreakLabel(_, _) -> 10
        .BreakLabelValue(_, _, _, _) -> 11
        .ContinueLabel(_, _) -> 12
        .Loop(_, _, _, _) -> 13
        .CountedLoop(_, _, _, _, _, _, _) -> 14
        .Unsafe(_, _, _, _) -> 15
        .Impure(_, _, _, _) -> 16
        .Reactive(_, _) -> 17
        .Shield(_, _) -> 18
        .Switched(_, _, _) -> 19
        .Region(_, _, _, _) -> 20
        .Policy(_, _, _) -> 21
        .TaskGroup(_, _, _, _, _) -> 22
        .Layout(_, _, _, _) -> 23
        .AuthorityScope(_, _, _, _, _) -> 24
        .ComptimeIf(_, _, _, _, _, _) -> 25
        .ComptimeSwitch(_, _, _, _) -> 26
        .ComptimeBlock(_, _, _) -> 27
        .ContextBlock(_, _, _) -> 28
        .Live(_, _) -> 29
        .AssumeDet(_, _, _, _) -> 30
        .Transact(_, _, _, _, _) -> 31
        .Yield(_, _) -> 32
        .ScopeMember(_, _, _, _, _, _, _, _) -> 33
        .DeferClose(_, _) -> 34
    }
    "Discriminant({index})"
}

sema_compiler_index_stmt_span: fn(statement: Stmt) -> Span {
    if statement == {
        .Expr(value) -> expr_span(value)
        .Val(binding) -> Span{start: if binding.sigil_span == .Val(sigil) -> sigil.start else -> binding.name_span.start, end: expr_span(binding.init).end}
        .Assign(target, _, _, value) -> Span{start: sema_compiler_index_lvalue_span(target).start, end: expr_span(value).end}
        .Return(_, span) | .While(_, _, span, _, _) | .For(_, _, _, _, _, span, _, _, _) | .Switch(_, _, _, span) | .Break(span) | .BreakValue(_, span) | .Continue(span) | .BreakLabel(_, span) | .BreakLabelValue(_, _, _, span) | .ContinueLabel(_, span) | .Loop(_, span, _, _) | .CountedLoop(_, _, _, _, span, _, _) | .Unsafe(_, _, _, span) | .Impure(_, _, _, span) | .Reactive(_, span) | .Shield(_, span) | .Switched(_, _, span) | .Region(_, _, _, span) | .Policy(_, _, span) | .TaskGroup(_, _, _, _, span) | .Layout(_, _, _, span) | .AuthorityScope(_, _, _, _, span) | .ComptimeIf(_, _, _, _, span, _) | .ComptimeSwitch(_, _, _, span) | .ComptimeBlock(_, _, span) | .ContextBlock(_, _, span) | .Live(_, span) | .AssumeDet(_, _, _, span) | .Transact(_, _, _, _, span) | .Yield(_, span) | .ScopeMember(_, _, _, _, _, _, _, span) | .DeferClose(_, span) -> span
    }
}

// One (parent, slot) pair as a map key: a node id never contains `:`.
sema_compiler_index_ordinal_key: fn(parent: Int?, slot: String) -> String Never! {
    if parent == .Val(id) -> return "{id}:{slot}"
    "-:{slot}"
}

sema_compiler_index_walk_node: fn(state: &SemaCompilerIndexWalkState, class: String, shape: String, module_path: String, span: Span) -> Int? {
    if span.end < span.start -> return None
    parent := Int?{None}
    if state.parents.len() > 0 -> parent = Val(state.parents[state.parents.len() - 1])
    key: sema_compiler_index_ordinal_key(parent, state.slot)
    ordinal: state.ordinals.get(key) ?? 0
    state.ordinals[key] = ordinal + 1
    id := state.nodes.len()
    slot_kind := if state.slot_is_list -> "list" else -> "scalar"
    state.structural.push(SemaCompilerIndexStructuralRecord{
        id: id,
        parent: parent,
        slot: state.slot,
        slot_is_list: state.slot_is_list,
        ordinal: ordinal,
        class: class,
        shape: shape,
        module_path: module_path,
        module_identity: state.module_identity,
        span: span,
    })
    state.nodes.push(TComptimeValue.Struct{type_name: "CompilerStructuralNode", fields: [TComptimeField]{
        TComptimeField{name: "id", value: sema_compiler_index_int(id)},
        TComptimeField{name: "parent", value: sema_compiler_index_option_int(parent)},
        TComptimeField{name: "slot", value: sema_compiler_index_string(state.slot)},
        TComptimeField{name: "slot_kind", value: sema_compiler_index_string(slot_kind)},
        TComptimeField{name: "ordinal", value: sema_compiler_index_int(ordinal)},
        TComptimeField{name: "class", value: sema_compiler_index_string(class)},
        TComptimeField{name: "shape", value: sema_compiler_index_string(shape)},
        TComptimeField{name: "module", value: sema_compiler_index_string(module_path)},
        TComptimeField{name: "span", value: sema_compiler_index_span(span, state.file)},
    }})
    Val(id)
}

sema_compiler_index_walk_expr_slot: fn(state: &SemaCompilerIndexWalkState, slot: String, expression: Expr, module_path: String) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = false
    sema_compiler_index_walk_expr(state, expression, module_path)
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_stmt_slot: fn(state: &SemaCompilerIndexWalkState, slot: String, statements: [Stmt], module_path: String) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop statement in statements -> sema_compiler_index_walk_stmt(state, statement, module_path)
    state.slot = old_slot
    state.slot_is_list = old_list
}
sema_compiler_index_walk_call_args_slot: fn(state: &SemaCompilerIndexWalkState, slot: String, args: [CallArg], module_path: String) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop argument in args {
        sema_compiler_index_walk_expr(state, argument.expr, module_path)
    }
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_call_args: fn(state: &SemaCompilerIndexWalkState, args: [CallArg], module_path: String) {
    sema_compiler_index_walk_call_args_slot(state, "args", args, module_path)
}

sema_compiler_index_walk_expr_list: fn(state: &SemaCompilerIndexWalkState, slot: String, expressions: [Expr], module_path: String) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop expression in expressions -> sema_compiler_index_walk_expr(state, expression, module_path)
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_expr_fields: fn(state: &SemaCompilerIndexWalkState, slot: String, fields: [ExprField], module_path: String) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop field in fields -> sema_compiler_index_walk_expr(state, field.value, module_path)
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_tuple_fields: fn(state: &SemaCompilerIndexWalkState, slot: String, fields: [TupleField], module_path: String) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop field in fields -> sema_compiler_index_walk_expr(state, field.value, module_path)
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_expr_pairs: fn(state: &SemaCompilerIndexWalkState, slot: String, entries: [ExprPair], keys: Bool, module_path: String) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop entry in entries {
        if keys -> sema_compiler_index_walk_expr(state, entry.key, module_path)
        else -> sema_compiler_index_walk_expr(state, entry.value, module_path)
    }
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_expr: fn(state: &SemaCompilerIndexWalkState, expression: Expr, module_path: String) {
    id: sema_compiler_index_walk_node(state, "expr", sema_compiler_index_expr_shape(expression), module_path, sema_compiler_index_expr_structural_span(expression)) ?? return
    state.parents.push(id)
    if expression == {
        .Call(call, _) -> sema_compiler_index_walk_call_args(state, call.args, module_path)
        .MethodCall(receiver, _, _, _, _, args, _) | .OptMethodCall(receiver, _, _, _, args, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "receiver", receiver, module_path)
            sema_compiler_index_walk_call_args(state, args, module_path)
        }
        .PtrFromAddr(_, _, _, address, _, _) -> sema_compiler_index_walk_expr_slot(state, "address", address, module_path)
        .Pipe(head, steps, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "head", head, module_path)
            sema_compiler_index_walk_expr_list(state, "steps", loop step in steps -> step.value, module_path)
        }
        .Field(base, _, _, _) | .OptField(base, _, _, _, _, _) | .MemberSpread(base, _, _, _) -> sema_compiler_index_walk_expr_slot(state, "base", base, module_path)
        .Binary(_, left, right, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "lhs", left, module_path)
            sema_compiler_index_walk_expr_slot(state, "rhs", right, module_path)
        }
        .CompareChain(operands, _, _, _, _) -> sema_compiler_index_walk_expr_list(state, "operands", operands, module_path)
        .Unary(_, operand, _, _) | .Deref(operand, _, _) | .RawOf(operand, _, _) | .Copy(operand, _, _) | .Place(operand, _, _, _) -> sema_compiler_index_walk_expr_slot(state, "operand", operand, module_path)
        .Index(base, index, _, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "base", base, module_path)
            sema_compiler_index_walk_expr_slot(state, "index", index, module_path)
        }
        .Slice(base, start, end, range, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "base", base, module_path)
            if range == .Val(value) -> sema_compiler_index_walk_expr_slot(state, "range", value, module_path)
            else {
                sema_compiler_index_walk_expr_slot(state, "start", start, module_path)
                sema_compiler_index_walk_expr_slot(state, "end", end, module_path)
            }
        }
        .Range(start, end, _, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "start", start, module_path)
            sema_compiler_index_walk_expr_slot(state, "end", end, module_path)
        }
        .Str(parts, _, _) -> {
            old_slot := state.slot
            old_list := state.slot_is_list
            state.slot = "interpolations"
            state.slot_is_list = true
            loop part in parts {
                if part == .Interp(value, _) -> sema_compiler_index_walk_expr(state, value, module_path)
            }
            state.slot = old_slot
            state.slot_is_list = old_list
        }
        .ListLit(items, _, _) -> sema_compiler_index_walk_expr_list(state, "items", items, module_path)
        .Spread(value, _, _) | .Tainted(value, _, _, _) | .Present(value, _, _) | .Ok(value, _, _) | .Err(value, _, _) -> sema_compiler_index_walk_expr_slot(state, "value", value, module_path)
        .MapLit(entries, _, _) -> {
            sema_compiler_index_walk_expr_pairs(state, "keys", entries, true, module_path)
            sema_compiler_index_walk_expr_pairs(state, "values", entries, false, module_path)
        }
        .TupleLit(fields, _, _, _) -> sema_compiler_index_walk_tuple_fields(state, "fields", fields, module_path)
        .StructLit(_, _, _, _, fields, _, _, _) -> sema_compiler_index_walk_expr_fields(state, "fields", fields, module_path)
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> sema_compiler_index_walk_expr_fields(state, "body", fields, module_path)
                .Elements(values) -> sema_compiler_index_walk_expr_list(state, "body", values, module_path)
                .Entries(entries) -> {
                    old_slot := state.slot
                    old_list := state.slot_is_list
                    state.slot = "body"
                    state.slot_is_list = true
                    loop entry in entries {
                        sema_compiler_index_walk_expr(state, entry.key, module_path)
                        sema_compiler_index_walk_expr(state, entry.value, module_path)
                    }
                    state.slot = old_slot
                    state.slot_is_list = old_list
                }
                .Value(value) -> {
                    old_slot := state.slot
                    old_list := state.slot_is_list
                    state.slot = "body"
                    state.slot_is_list = true
                    sema_compiler_index_walk_expr(state, value, module_path)
                    state.slot = old_slot
                    state.slot_is_list = old_list
                }
                .ByteText(_) | .Empty -> {}
            }
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            old_slot := state.slot
            old_list := state.slot_is_list
            state.slot = "args"
            state.slot_is_list = true
            loop argument in args {
                if argument == {
                    .Positional(value) -> sema_compiler_index_walk_expr(state, value, module_path)
                    .Named(_, value) -> sema_compiler_index_walk_expr(state, value, module_path)
                }
            }
            state.slot = old_slot
            state.slot_is_list = old_list
        }
        .Try(value, _, _, context, _) -> {
            sema_compiler_index_walk_expr_slot(state, "value", value, module_path)
            if context == .Val(note) -> sema_compiler_index_walk_expr_slot(state, "note", note, module_path)
        }
        .OrFallback(value, fallback, _, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "value", value, module_path)
            if fallback == {
                .Value(fallback_value) -> sema_compiler_index_walk_expr_slot(state, "fallback", fallback_value, module_path)
                .Block(body, result, _) -> {
                    sema_compiler_index_walk_stmt_slot(state, "fallback_body", body, module_path)
                    if result == .Val(result_value) -> sema_compiler_index_walk_expr_slot(state, "fallback", result_value, module_path)
                }
                .Return(result, _) -> if result == .Val(result_value) -> sema_compiler_index_walk_expr_slot(state, "fallback", result_value, module_path)
                .Panic(_, args) -> sema_compiler_index_walk_call_args_slot(state, "fallback_args", args, module_path)
                .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
            }
        }
        .If(condition, then_body, then_value, else_body, else_value, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "condition", condition, module_path)
            sema_compiler_index_walk_stmt_slot(state, "then_body", then_body, module_path)
            sema_compiler_index_walk_expr_slot(state, "then_value", then_value, module_path)
            sema_compiler_index_walk_stmt_slot(state, "else_body", else_body, module_path)
            sema_compiler_index_walk_expr_slot(state, "else_value", else_value, module_path)
        }
        .Lambda(lambda, _) -> {
            if lambda.body == {
                .Expr(value) -> sema_compiler_index_walk_expr_slot(state, "body", value, module_path)
                .Block(body) -> sema_compiler_index_walk_stmt_slot(state, "body", body, module_path)
            }
        }
        .CallValue(callee, args, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "callee", callee, module_path)
            sema_compiler_index_walk_call_args(state, args, module_path)
        }
        .PatternTest(subject, _, _, _) -> sema_compiler_index_walk_expr_slot(state, "subject", subject, module_path)
        .Paren(value, _, _) -> sema_compiler_index_walk_expr_slot(state, "inner", value, module_path)
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Ident(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    _ := state.parents.pop()
}

sema_compiler_index_walk_lvalue: fn(state: &SemaCompilerIndexWalkState, target: LValue, module_path: String) {
    if target == {
        .Local(_, _) -> {}
        .Index(base, index, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "target_base", base, module_path)
            sema_compiler_index_walk_expr_slot(state, "target_index", index, module_path)
        }
        .Field(base, _, _) -> sema_compiler_index_walk_expr_slot(state, "target_base", base, module_path)
    }
}

sema_compiler_index_walk_for_kind: fn(state: &SemaCompilerIndexWalkState, kind: ForKind, module_path: String) {
    if kind == {
        .Range(start, end, step, _) -> {
            sema_compiler_index_walk_expr_slot(state, "range_start", start, module_path)
            sema_compiler_index_walk_expr_slot(state, "range_end", end, module_path)
            if step == .Val(value) -> sema_compiler_index_walk_expr_slot(state, "range_step", value, module_path)
        }
        .In(collection, step) -> {
            sema_compiler_index_walk_expr_slot(state, "source", collection, module_path)
            if step == .Val(value) -> sema_compiler_index_walk_expr_slot(state, "stride", value, module_path)
        }
    }
}

sema_compiler_index_walk_arms: fn(state: &SemaCompilerIndexWalkState, arms: [SwitchArm], module_path: String) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = "arms"
    state.slot_is_list = true
    loop arm in arms {
        id: sema_compiler_index_walk_node(state, "arm", "switch_arm", module_path, arm.span) ?? next
        state.parents.push(id)
        sema_compiler_index_walk_expr_slot(state, "condition", arm.cond, module_path)
        sema_compiler_index_walk_stmt_slot(state, "body", arm.body, module_path)
        _ := state.parents.pop()
    }
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_stmt: fn(state: &SemaCompilerIndexWalkState, statement: Stmt, module_path: String) {
    id: sema_compiler_index_walk_node(state, "stmt", sema_compiler_index_stmt_shape(statement), module_path, sema_compiler_index_stmt_span(statement)) ?? return
    state.parents.push(id)
    if statement == {
        .Val(binding) -> {
            if binding.ty_span == .Val(span) -> sema_compiler_index_walk_type_slot(state, "type", span, module_path, false)
            sema_compiler_index_walk_expr_slot(state, "initializer", binding.init, module_path)
        }
        .Expr(value) | .Yield(value, _) -> sema_compiler_index_walk_expr_slot(state, "value", value, module_path)
        .DeferClose(value, _) -> sema_compiler_index_walk_expr_slot(state, "close", value, module_path)
        .Assign(target, _, _, value) -> {
            sema_compiler_index_walk_lvalue(state, target, module_path)
            sema_compiler_index_walk_expr_slot(state, "value", value, module_path)
        }
        .Return(value, _) -> if value == .Val(expr) -> sema_compiler_index_walk_expr_slot(state, "value", expr, module_path)
        .BreakValue(value, _) -> sema_compiler_index_walk_expr_slot(state, "value", value, module_path)
        .BreakLabelValue(_, _, value, _) -> sema_compiler_index_walk_expr_slot(state, "value", value, module_path)
        .While(condition, body, _, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "condition", condition, module_path)
            sema_compiler_index_walk_stmt_slot(state, "body", body, module_path)
        }
        .For(_, _, _, kind, body, _, _, _, _) -> {
            sema_compiler_index_walk_for_kind(state, kind, module_path)
            sema_compiler_index_walk_stmt_slot(state, "body", body, module_path)
        }
        .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
            sema_compiler_index_walk_expr_slot(state, "subject", subject, module_path)
            sema_compiler_index_walk_arms(state, arms, module_path)
            if else_body == .Val(body) -> sema_compiler_index_walk_stmt_slot(state, "else_body", body, module_path)
        }
        .Loop(body, _, _, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .Live(body, _) | .Transact(_, _, body, _, _) -> sema_compiler_index_walk_stmt_slot(state, "body", body, module_path)
        .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .TaskGroup(_, _, _, body, _) | .AssumeDet(_, _, body, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> sema_compiler_index_walk_stmt_slot(state, "body", body, module_path)
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "init", init.init, module_path)
            sema_compiler_index_walk_expr_slot(state, "condition", condition, module_path)
            if step == .Val(step_statement) {
                old_slot := state.slot
                old_list := state.slot_is_list
                state.slot = "afterthought"
                state.slot_is_list = false
                sema_compiler_index_walk_stmt(state, step_statement, module_path)
                state.slot = old_slot
                state.slot_is_list = old_list
            }
            sema_compiler_index_walk_stmt_slot(state, "body", body, module_path)
        }
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "condition", condition, module_path)
            sema_compiler_index_walk_stmt_slot(state, "then_body", then_body, module_path)
            if else_body == .Val(body) -> sema_compiler_index_walk_stmt_slot(state, "else_body", body, module_path)
        }
        .ContextBlock(fields, body, _) -> {
            old_slot := state.slot
            old_list := state.slot_is_list
            state.slot = "fields"
            state.slot_is_list = true
            loop field in fields -> sema_compiler_index_walk_expr(state, field.value, module_path)
            state.slot = old_slot
            state.slot_is_list = old_list
            sema_compiler_index_walk_stmt_slot(state, "body", body, module_path)
        }
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
    }
    _ := state.parents.pop()
}

sema_compiler_index_walk_type_slot: fn(state: &SemaCompilerIndexWalkState, slot: String, span: Span, module_path: String, is_list: Bool) Never! {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = is_list
    _ := sema_compiler_index_walk_node(state, "type", "type", module_path, span)
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_function: fn(state: &SemaCompilerIndexWalkState, function: Func, module_path: String, body_slot: String) {
    loop fact in sema_arithmetic_policy_facts(function) -> state.arithmetic.push(sema_compiler_index_arithmetic_fact(fact, module_path, state.file))
    loop parameter_index in 0..<function.params.len() -> sema_compiler_index_walk_type_slot(state, "params", function.params[parameter_index].ty_span, module_path, true)
    if function.return_type_span == .Val(span) -> sema_compiler_index_walk_type_slot(state, "return_type", span, module_path, false)
    sema_compiler_index_walk_stmt_slot(state, body_slot, function.body, module_path)
}

sema_compiler_index_walk_methods: fn(state: &SemaCompilerIndexWalkState, methods: [Func], module_path: String) {
    loop method in methods -> sema_compiler_index_walk_function(state, method, module_path, "method_bodies")
}

sema_compiler_index_walk_items_slot: fn(state: &SemaCompilerIndexWalkState, slot: String, items: [Item], module_path: String) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop item in items -> sema_compiler_index_walk_item(state, item, module_path)
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_derive_body: fn(state: &SemaCompilerIndexWalkState, body: [DeriveBodyItem], module_path: String) {
    loop body_item in body {
        if body_item == {
            .Item(item) -> sema_compiler_index_walk_item(state, item, module_path)
            .Stmt(statement) -> sema_compiler_index_walk_stmt(state, statement, module_path)
            .Loop(_, _, source, nested, _) -> {
                sema_compiler_index_walk_expr(state, source, module_path)
                sema_compiler_index_walk_derive_body(state, nested, module_path)
            }
            .If(cond, _, then_body, else_body, _) -> {
                sema_compiler_index_walk_expr(state, cond, module_path)
                sema_compiler_index_walk_derive_body(state, then_body, module_path)
                if else_body == .Val(branch) -> sema_compiler_index_walk_derive_body(state, branch, module_path)
            }
        }
    }
}

sema_compiler_index_walk_item: fn(state: &SemaCompilerIndexWalkState, item: Item, module_path: String) {
    // A standard family the units prelude injected (owner `core.units`) is a
    // catalog copy whose span is in the prelude text, not a definition of
    // this module's source.
    if item == .UnitFamily(family) && family.resolved_owner == (Val("core.units")) -> return
    id: sema_compiler_index_walk_node(state, "item", sema_compiler_index_item_shape(item), module_path, sema_compiler_index_item_span(item)) ?? return
    state.parents.push(id)
    if item == {
        .Func(function) -> sema_compiler_index_walk_function(state, function, module_path, "body")
        .Distinct(definition) -> sema_compiler_index_walk_type_slot(state, "base", definition.base_span, module_path, false)
        .TypeAlias(definition) -> sema_compiler_index_walk_type_slot(state, "target", definition.target_span, module_path, false)
        .Struct(definition) -> {
            loop field in definition.fields -> sema_compiler_index_walk_type_slot(state, "field_types", field.ty_span, module_path, true)
            old_slot := state.slot
            old_list := state.slot_is_list
            state.slot = "computed_fields"
            state.slot_is_list = true
            loop field in definition.fields {
                if field.computed == .Val(expression) -> sema_compiler_index_walk_expr(state, expression, module_path)
            }
            state.slot = old_slot
            state.slot_is_list = old_list
            sema_compiler_index_walk_methods(state, definition.methods, module_path)
            loop trait_impl in definition.trait_impls -> sema_compiler_index_walk_methods(state, trait_impl.methods, module_path)
        }
        .Enum(definition) -> {
            loop variant in definition.variants {
                if variant.payload == {
                    .Single(_, span) -> sema_compiler_index_walk_type_slot(state, "variant_types", span, module_path, true)
                    .Named(fields) -> loop field in fields -> sema_compiler_index_walk_type_slot(state, "variant_types", field.ty_span, module_path, true)
                    .Unit -> {}
                }
                if variant.discriminant_expr == .Val(expression) -> sema_compiler_index_walk_expr(state, expression, module_path)
            }
            sema_compiler_index_walk_methods(state, definition.methods, module_path)
            loop trait_impl in definition.trait_impls -> sema_compiler_index_walk_methods(state, trait_impl.methods, module_path)
        }
        .Impl(definition) -> sema_compiler_index_walk_methods(state, definition.methods, module_path)
        .Const(definition) -> sema_compiler_index_walk_expr_slot(state, "value", definition.value, module_path)
        .Test(definition) -> sema_compiler_index_walk_stmt_slot(state, "body", definition.body, module_path)
        .ErrorConv(definition) -> sema_compiler_index_walk_stmt_slot(state, "body", definition.body, module_path)
        .TemplateLoop(definition) -> {
            sema_compiler_index_walk_expr_slot(state, "source", definition.source, module_path)
            old_slot := state.slot
            old_list := state.slot_is_list
            state.slot = "body"
            state.slot_is_list = true
            sema_compiler_index_walk_derive_body(state, definition.body, module_path)
            state.slot = old_slot
            state.slot_is_list = old_list
        }
        .CodeModule(definition) -> if definition.body == .Val(items) -> sema_compiler_index_walk_items_slot(state, "items", items, module_path)
        .GenericModule(definition) -> sema_compiler_index_walk_items_slot(state, "body", definition.body, module_path)
        .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .Migration(_) | .ProtocolDecl(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    _ := state.parents.pop()
}

sema_compiler_index_param_zone: fn(zone: ParamZone) -> String Never! {
    return if {
        zone == ParamZone.PositionalOnly -> "PositionalOnly"
        zone == ParamZone.LabelOnly -> "LabelOnly"
        else -> "Either"
    }
}

sema_compiler_index_view_source_path: fn(path: ViewSourcePath) -> String Never! {
    source := if path.source == {
        .Receiver -> "receiver"
        .Parameter(index) -> "parameter:{index}"
        .Static(module_path, name) -> "static:{module_path}::{name}"
    }
    projections := [String]{}
    loop projection in path.projections {
        if projection == {
            .Field(name) -> projections.push("field:{name}")
            .Index -> projections.push("index")
            .Range -> projections.push("range")
        }
    }
    "{source};path:{projections.join("/")}"
}

sema_compiler_index_view_provenance: fn(value: ViewProvenance) -> String Never! {
    access := if value.mutable -> "write" else -> "read"
    sources := [String]{}
    loop source in value.sources -> sources.push(sema_compiler_index_view_source_path(source))
    sources = sema_compiler_index_sorted_strings(sources)
    if sources.len() == 1 {
        parts := sources[0].split(";path:").to_list()
        if parts.len() == 2 -> return "{parts[0]};access:{access};path:{parts[1]}"
    }
    "one_of({sources.join(",")});access:{access}"
}

sema_compiler_index_view_map: fn(map: ViewProvenanceMap?) -> String Never! {
    value: map ?? return ""
    rows := [String]{}
    loop entry in value.entries {
        slot := if entry.slot.len() == 0 -> "$" else -> entry.slot.join(".")
        rows.push("{slot}={sema_compiler_index_view_provenance(entry.value)}")
    }
    rows.join("|")
}

sema_compiler_index_function_signature: fn(function: SemaRegistrationFunction) -> String Never! {
    if function.signature == .Fn(parameters, return_type, _, contract, _, provenance) {
        parameter_names := [String]{}
        loop parameter in parameters -> parameter_names.push(type_name(parameter))
        contracts := [String]{}
        loop index in 0..<parameters.len() {
            label := ""
            zone := ParamZone.Either
            variadic := false
            if index < function.parameters.len() {
                parameter := function.parameters[index]
                label = if parameter.public_label == .Val(value) -> value else -> parameter.symbol.name
                zone = parameter.zone
                variadic = parameter.variadic
            }
            if contract == .Val(rows) && index < rows.len() {
                label = rows[index].label
                zone = rows[index].zone
            }
            contracts.push("{label}:{sema_compiler_index_param_zone(zone)}:{variadic}")
        }
        ret := if return_type == .Val(value) -> type_name(value) else -> "()"
        view := sema_compiler_index_view_map(provenance)
        return "({parameter_names.join(",")})->{ret};call_contract=[{contracts.join(",")}];view_source={view}"
    }
    if function.symbol.ty == .Val(ty) -> return type_name(ty)
    "function"
}

sema_compiler_index_definition_signature: fn(symbol: Symbol, registered_module: SemaRegistrationModule, registration: SemaRegistrationGraph) -> String Never! {
    if symbol.kind == SymbolKind.Function {
        loop function in registered_module.functions {
            if function.symbol.id.key == symbol.id.key -> return sema_compiler_index_function_signature(function)
        }
        loop function in registered_module.foreign_functions {
            if function.symbol.id.key == symbol.id.key {
                if function.symbol.ty == .Val(ty) -> return type_name(ty)
            }
        }
    }
    if symbol.kind == SymbolKind.Type {
        loop nominal in registered_module.nominals {
            if nominal.symbol.id.key != symbol.id.key -> next
            if nominal.kind == SemaRegistrationNominalKind.Struct {
                fields := [String]{}
                loop field in nominal.fields -> fields.push(type_name(field.ty))
                return "{{{fields.join(",")}}}"
            }
            if nominal.kind == SemaRegistrationNominalKind.Enum -> return "variants:{nominal.variants.len()}"
        }
    }
    sema_compiler_index_definition_kind(symbol, registration)
}

sema_compiler_index_derivation_definition_eligible: fn(symbol: Symbol) -> Bool Never! {
    if symbol.kind == SymbolKind.Local || symbol.kind == SymbolKind.Parameter || symbol.kind == SymbolKind.Field || symbol.kind == SymbolKind.Variant -> return false
    true
}
sema_compiler_index_source_fragment: fn(source: String, span: Span) -> String? {
    bytes := source.bytes()
    if span.start < 0 || span.end < span.start || span.end > bytes.len() -> return None
    text: String.from_bytes(bytes.slice(span.start, span.end)) ?? return None
    Val(text)
}

sema_compiler_index_normalize_definition: fn(source: String) -> String Never! {
    bytes := source.bytes()
    output := [U8]{}
    in_string := false
    index := 0
    loop index < bytes.len() {
        code := Int.from_u8(bytes[index])
        if in_string {
            output.push(bytes[index])
            if code == 34 -> in_string = false
            index += 1
            next
        }
        if code == 34 {
            in_string = true
            output.push(bytes[index])
            index += 1
            next
        }
        if code == 47 && index + 1 < bytes.len() && Int.from_u8(bytes[index + 1]) == 47 {
            index += 2
            loop index < bytes.len() && Int.from_u8(bytes[index]) != 10 -> index += 1
            next
        }
        if code != 9 && code != 10 && code != 11 && code != 12 && code != 13 && code != 32 -> output.push(bytes[index])
        index += 1
    }
    String.from_bytes(output) ?? source
}

// `missing` names the first item whose derivation could not be read ("" when complete).
SemaCompilerIndexDerivationFacts: struct {
    value: TComptimeValue
    missing: String
}

sema_compiler_index_derivation_value: fn(record: DerivationRecord) -> TComptimeValue Never! {
    method := if {
        record.method == DerivationMethod.StaticDerivation -> "static_derivation"
        record.method == DerivationMethod.FormalProof -> "formal_proof"
        record.method == DerivationMethod.RecordedExecution -> "recorded_execution"
        record.method == DerivationMethod.SampledAgreement -> "sampled_agreement"
        else -> "external_assumption"
    }
    disposition := if {
        record.disposition == DerivationDisposition.Current -> "current"
        record.disposition == DerivationDisposition.Stale -> "stale"
        record.disposition == DerivationDisposition.Expired -> "expired"
        record.disposition == DerivationDisposition.Redacted -> "redacted"
        record.disposition == DerivationDisposition.Unavailable -> "unavailable"
        record.disposition == DerivationDisposition.Unsupported -> "unsupported"
        record.disposition == DerivationDisposition.BudgetExhausted -> "budget_exhausted"
        else -> "unknown"
    }
    observation := TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Named{name: "CompilerDerivationObservation"}}}
    if record.observation == .Val(value) {
        observation = TComptimeValue.Present{value: TComptimeValue.Struct{type_name: "CompilerDerivationObservation", fields: [TComptimeField]{
            TComptimeField{name: "counterexample", value: sema_compiler_index_option_string(value.counterexample_id)},
            TComptimeField{name: "event", value: sema_compiler_index_option_string(value.event_id)},
        }}}
    }
    payload := TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Named{name: "CompilerDerivationPayload"}}}
    if record.payload == .Val(value) {
        payload = TComptimeValue.Present{value: TComptimeValue.Struct{type_name: "CompilerDerivationPayload", fields: [TComptimeField]{
            TComptimeField{name: "kind", value: sema_compiler_index_string("frame_schedule")},
            TComptimeField{name: "json", value: sema_compiler_index_string(derivation_payload_json(value))},
        }}}
    }
    TComptimeValue.Struct{type_name: "CompilerDerivationRecord", fields: [TComptimeField]{
        TComptimeField{name: "id", value: sema_compiler_index_string(record.id)},
        TComptimeField{name: "subject", value: sema_compiler_index_string(record.subject)},
        TComptimeField{name: "claim", value: sema_compiler_index_string(record.claim)},
        TComptimeField{name: "producer", value: sema_compiler_index_string(record.producer)},
        TComptimeField{name: "method", value: sema_compiler_index_string(method)},
        TComptimeField{name: "rule", value: sema_compiler_index_string(record.rule)},
        TComptimeField{name: "premises", value: sema_compiler_index_strings(record.premises)},
        TComptimeField{name: "identity", value: TComptimeValue.Struct{type_name: "CompilerDerivationIdentity", fields: [TComptimeField]{
            TComptimeField{name: "source", value: sema_compiler_index_string(record.identity.source)},
            TComptimeField{name: "build", value: sema_compiler_index_string(record.identity.build)},
            TComptimeField{name: "run", value: sema_compiler_index_string(record.identity.run)},
            TComptimeField{name: "target", value: sema_compiler_index_string(record.identity.target)},
        }}},
        TComptimeField{name: "assumptions", value: sema_compiler_index_strings(record.assumptions)},
        TComptimeField{name: "disposition", value: sema_compiler_index_string(disposition)},
        TComptimeField{name: "observation", value: observation},
        TComptimeField{name: "payload", value: payload},
    }}
}

sema_compiler_index_derivations: fn(registration: SemaRegistrationGraph, structural: [SemaCompilerIndexStructuralRecord], module_sources: [SemaCompilerModuleSource]) -> SemaCompilerIndexDerivationFacts Never! {
    records := [DerivationRecord]{}
    missing := ""
    loop node in structural {
        if node.parent != None || node.class != "item" -> next
        module_index: sema_registration_module_index(registration, node.module_identity) ?? {
            if missing == "" -> missing = "item at {node.span.start}..{node.span.end} of `{node.module_identity}` has no registered module"
            next
        }
        registered_module: registration.modules[module_index]
        source: sema_compiler_index_module_source(module_sources, node.module_identity) ?? {
            if missing == "" -> missing = "module `{node.module_identity}` has no source"
            next
        }
        definition_source: sema_compiler_index_source_fragment(source, node.span) ?? {
            if missing == "" -> missing = "item at {node.span.start}..{node.span.end} lies outside the {source.count_bytes()}-byte source of `{node.module_identity}`"
            next
        }
        symbol := Symbol?{None}
        loop candidate in registered_module.symbols {
            if !sema_compiler_index_derivation_definition_eligible(candidate) -> next
            if candidate.span.start < node.span.start || candidate.span.end > node.span.end -> next
            if {
                symbol == None -> {
                    symbol = Val(candidate)
                }
                else -> {
                    current: symbol ?? candidate
                    if candidate.span.start < current.span.start -> symbol = Val(candidate)
                }
            }
        }
        definition: symbol ?? next
        kind := sema_compiler_index_definition_kind(definition, registration)
        structural_key := "{kind}|{definition.id.key}"
        stable_id := "def:{sha256_hex(structural_key).slice(0, 16)}"
        signature := sema_compiler_index_definition_signature(definition, registered_module, registration)
        signature_key := "{kind}|{signature}"
        signature_id := "sig:{sha256_hex(signature_key).slice(0, 16)}"
        normalized := sema_compiler_index_normalize_definition(definition_source)
        content_id := "sha256:{sha256_hex(normalized)}"
        record := derivation_record(
            stable_id,
            definition.id.key,
            "jet-sema",
            DerivationMethod.StaticDerivation,
            "checked-definition",
            [String]{signature_id, content_id},
            derivation_identity(content_id, signature_id, "", registered_module.module_path),
        )
        records.push(record)
    }
    // Stable, as the insertion sort this replaces: equal (subject, claim) keep record order.
    records.sort_by((left: DerivationRecord, right: DerivationRecord) -> (left.subject <=> right.subject).then(left.claim <=> right.claim))
    values := [TComptimeValue]{}
    loop record in records -> values.push(sema_compiler_index_derivation_value(record))
    SemaCompilerIndexDerivationFacts{value: TComptimeValue.List{values: values}, missing: missing}
}
// Function key -> the view provenance values of the first checked function
// with that key (module, then declaration, order), built once per index; a
// definition that is no function reads an empty list.
sema_compiler_index_function_views: fn(graph: SemaGraphResult) -> [String:TComptimeValue] Never! {
    views := [String:TComptimeValue]{}
    loop checked_module in graph.modules {
        loop function in checked_module.functions {
            if views.get(function.key) == None -> views[function.key] = sema_compiler_index_view_provenance_values(function.return_view_provenance)
        }
    }
    views
}

sema_compiler_index_append_definition: fn(registration: SemaRegistrationGraph, caller: Int, symbol: Symbol, views: [String:TComptimeValue], definitions: &[TComptimeValue], seen: &[String:Bool]) {
    if seen.get(symbol.id.key) != None -> return
    seen[symbol.id.key] = true
    definitions.push(sema_compiler_index_definition(registration, caller, symbol, views.get(symbol.id.key) ?? TComptimeValue.List{values: [TComptimeValue]{}}))
}

sema_compiler_index_append_checked_local: fn(local: TLocal, module_identity: String, owner: String, registration: SemaRegistrationGraph, caller: Int, views: [String:TComptimeValue], definitions: &[TComptimeValue], seen: &[String:Bool]) {
    local_id: local.symbol_id ?? return
    symbol := Symbol{id: local_id, kind: SymbolKind.Local, name: local.name, module_name: module_identity, owner: Val(owner), span: local.span, ty: None, visibility: 0}
    sema_compiler_index_append_definition(registration, caller, symbol, views, definitions, seen)
}

sema_compiler_index_collect_checked_locals: fn(function: FnBody, module_identity: String, owner: String, registration: SemaRegistrationGraph, caller: Int, views: [String:TComptimeValue], definitions: &[TComptimeValue], seen: &[String:Bool]) {
    loop statement in function.body {
        if function.tree.stmts[statement] == {
            .Let(local, _, _, _, _, _) -> sema_compiler_index_append_checked_local(local, module_identity, owner, registration, caller, views, definitions, seen)
            .TupleDestructure(temp, _, _, binds, _) -> {
                sema_compiler_index_append_checked_local(temp, module_identity, owner, registration, caller, views, definitions, seen)
                loop bind in binds -> sema_compiler_index_append_checked_local(bind.local, module_identity, owner, registration, caller, views, definitions, seen)
            }
            .StructDestructure(temp, _, _, binds, _) -> {
                sema_compiler_index_append_checked_local(temp, module_identity, owner, registration, caller, views, definitions, seen)
                loop bind in binds -> sema_compiler_index_append_checked_local(bind.local, module_identity, owner, registration, caller, views, definitions, seen)
            }
            .ListDestructure(temp, _, _, _, elements, _) -> {
                sema_compiler_index_append_checked_local(temp, module_identity, owner, registration, caller, views, definitions, seen)
                loop local in elements -> sema_compiler_index_append_checked_local(local, module_identity, owner, registration, caller, views, definitions, seen)
            }
            .Contract(_) | .ContractScope(_, _, _, _, _) | .RefutableBind(_, _, _, _) | .Assign(_, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .ForRange(_, _, _, _, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .ExprStmt(_, _) | .Return(_, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .If(_, _, _, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .Match(_, _, _, _) | .EnumMatch(_, _, _, _, _) | .RangeSwitch(_, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _, _) | .Inline(_, _) | .DebugOnly(_, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .UnsafeBlock(_, _, _) | .SentryPolicy(_, _, _) | .Impure(_, _) | .Reactive(_, _) | .Region(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .Shield(_, _) | .ScopeMember(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> {}
        }
    }
}

sema_compiler_semantic_index_from_checked: fn(registration: SemaRegistrationGraph, graph: SemaGraphResult, source: String, module_sources: [SemaCompilerModuleSource]) -> SemaCompilerSemanticIndexFacts {
    definitions := [TComptimeValue]{}
    definition_keys := [String:Bool]{}
    function_views: sema_compiler_index_function_views(graph)
    references := [TComptimeValue]{}
    calls := [TComptimeValue]{}
    effects := [TComptimeValue]{}
    outputs := [TComptimeValue]{}
    state_graphs := [TComptimeValue]{}
    loop registered_module_index in 0..<registration.modules.len() {
        loop symbol_index in 0..<registration.modules[registered_module_index].symbols.len() -> sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].symbols[symbol_index], function_views, definitions, definition_keys)
        loop nominal_index in 0..<registration.modules[registered_module_index].nominals.len() {
            sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].nominals[nominal_index].symbol, function_views, definitions, definition_keys)
            loop field_index in 0..<registration.modules[registered_module_index].nominals[nominal_index].fields.len() -> sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].nominals[nominal_index].fields[field_index].symbol, function_views, definitions, definition_keys)
            loop variant_index in 0..<registration.modules[registered_module_index].nominals[nominal_index].variants.len() -> sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].nominals[nominal_index].variants[variant_index].symbol, function_views, definitions, definition_keys)
            loop method_index in 0..<registration.modules[registered_module_index].nominals[nominal_index].methods.len() -> sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].nominals[nominal_index].methods[method_index].symbol, function_views, definitions, definition_keys)
            loop method_index in 0..<registration.modules[registered_module_index].nominals[nominal_index].trait_methods.len() -> sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].nominals[nominal_index].trait_methods[method_index].symbol, function_views, definitions, definition_keys)
        }
        loop implementation_index in 0..<registration.modules[registered_module_index].impls.len() {
            sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].impls[implementation_index].symbol, function_views, definitions, definition_keys)
            loop method_index in 0..<registration.modules[registered_module_index].impls[implementation_index].methods.len() -> sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].impls[implementation_index].methods[method_index].symbol, function_views, definitions, definition_keys)
            loop associated_index in 0..<registration.modules[registered_module_index].impls[implementation_index].associated_types.len() -> sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].impls[implementation_index].associated_types[associated_index].symbol, function_views, definitions, definition_keys)
        }
        loop constant_index in 0..<registration.modules[registered_module_index].constants.len() {
            if registration.modules[registered_module_index].constants[constant_index].declaration.resolved_output == .Val(output) {
                solved := output
                loop fact in graph.outputs {
                    if fact.address == output.address && fact.module_id == output.module_id && fact.reference == output.reference {
                        solved = fact
                        break
                    }
                }
                outputs.push(sema_compiler_index_output_value(solved, registration.modules[registered_module_index].constants[constant_index].declaration, registration, registered_module_index))
            }
        }
        graph_facts := sema_state_graph_facts(registration.modules[registered_module_index].program.items)
        loop fact in graph_facts {
            definition := StructDef?{None}
            loop item_index in 0..<registration.modules[registered_module_index].program.items.len() {
                if registration.modules[registered_module_index].program.items[item_index] == .Struct(value) && value.name == fact.type_name {
                    definition = Val(value)
                    break
                }
            }
            if definition == .Val(value) -> state_graphs.push(sema_compiler_index_state_graph_value(fact, value, registration.modules[registered_module_index].module_path, registration.modules[registered_module_index].source_file))
        }
    }
    loop checked_module in graph.modules {
        module_index: sema_registration_module_index(registration, checked_module.module_identity) ?? next
        registered_module: registration.modules[module_index]
        loop reference in checked_module.name_references {
            target_index := sema_registration_module_index(registration, reference.symbol.module_name) ?? module_index
            sema_compiler_index_append_definition(registration, target_index, reference.symbol, function_views, definitions, definition_keys)
            references.push(sema_compiler_index_reference(reference, registration, checked_module.module_path, registered_module.source_file))
        }
        loop function in checked_module.functions {
            effects.push(sema_compiler_index_effect(function, registered_module.source_file))
            loop parameter in function.params {
                parameter_id: parameter.local.symbol_id ?? next
                parameter_symbol := Symbol{id: parameter_id, kind: SymbolKind.Parameter, name: parameter.name, module_name: checked_module.module_identity, owner: Val(function.key), span: parameter.span, ty: Val(parameter.ty), visibility: 0}
                sema_compiler_index_append_definition(registration, module_index, parameter_symbol, function_views, definitions, definition_keys)
            }
            sema_compiler_index_collect_checked_locals(function, checked_module.module_identity, function.key, registration, module_index, function_views, definitions, definition_keys)
        }
        loop call in checked_module.call_facts {
            value: sema_compiler_index_call(call, checked_module.module_path, registered_module.source_file) ?? next
            calls.push(value)
        }
    }
    walk := sema_compiler_index_walk_state()
    loop registered_module_index in 0..<registration.modules.len() {
        walk.module_identity = registration.modules[registered_module_index].module_identity
        walk.file = registration.modules[registered_module_index].source_file
        sema_compiler_index_walk_items_slot(walk, "root", registration.modules[registered_module_index].program.items, registration.modules[registered_module_index].module_path)
    }
    derivations := sema_compiler_index_derivations(registration, walk.structural, module_sources)
    missing := if !registration.complete -> "the registration graph is incomplete" else if !graph.complete -> "the checked graph is incomplete" else -> sema_compiler_index_module_sources_missing(registration, module_sources)
    loop registered_module_index in 0..<registration.modules.len() {
        found := false
        loop checked_module in graph.modules {
            if checked_module.module_identity == registration.modules[registered_module_index].module_identity {
                found = true
                break
            }
        }
        if !found && missing == "" -> missing = "registered module `{registration.modules[registered_module_index].module_identity}` has no checked result"
    }
    loop checked_module in graph.modules {
        found := false
        loop registered_module_index in 0..<registration.modules.len() {
            if checked_module.module_identity == registration.modules[registered_module_index].module_identity {
                found = true
                break
            }
        }
        if !found && missing == "" -> missing = "checked module `{checked_module.module_identity}` is not registered"
    }
    if derivations.missing != "" && missing == "" -> missing = "derivations: {derivations.missing}"
    index := TComptimeValue.Struct{type_name: "CompilerSemanticIndex", fields: [TComptimeField]{
        TComptimeField{name: "schema_version", value: sema_compiler_index_int(20)},
        TComptimeField{name: "source_digest", value: sema_compiler_index_string(sha256_hex(source))},
        TComptimeField{name: "definitions", value: TComptimeValue.List{values: definitions}},
        TComptimeField{name: "references", value: TComptimeValue.List{values: references}},
        TComptimeField{name: "calls", value: TComptimeValue.List{values: calls}},
        TComptimeField{name: "structural_nodes", value: TComptimeValue.List{values: walk.nodes}},
        TComptimeField{name: "effects", value: TComptimeValue.List{values: effects}},
        TComptimeField{name: "arithmetic", value: TComptimeValue.List{values: walk.arithmetic}},
        TComptimeField{name: "outputs", value: TComptimeValue.List{values: outputs}},
        TComptimeField{name: "state_graphs", value: TComptimeValue.List{values: state_graphs}},
        TComptimeField{name: "fact_registry", value: sema_compiler_index_fact_registry(registration)},
        TComptimeField{name: "derivations", value: derivations.value},
    }}
    SemaCompilerSemanticIndexFacts{value: index, complete: missing == "", missing: missing}
}
