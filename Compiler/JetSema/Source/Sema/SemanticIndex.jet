// Compiler-facing projection of package-wide checked Source Sema facts.
// This never runs a second checker; callers pass the registered graph and its
// finalized checked result so imported modules and solved effects stay intact.
use jet_foundation.[
    foundation_byte_text,
    symbol_is_local,
    symbol_key_leaf_start,
    symbol_key_parts,
    symbol_local_keys_count,
    symbol_local_keys_text_at,
    symbol_local_row,
    symbol_table_key,
    authority_grantable_roots,
    name_column,
    name_column_get,
    name_column_set,
    name_column_table,
    name_find,
    name_index,
    name_intern,
    name_table,
    NameTable,
    ArithmeticMode,
    ArithmeticOperation,
    ArithmeticPolicyFact,
    CallArg,
    ConstDef,
    DerivationRecord,
    DeriveBodyItem,
    Expr,
    ExprField,
    ExprPair,
    FnBody,
    ForKind,
    Func,
    Item,
    NamedSpan,
    LValue,
    DerivationDisposition,
    DerivationMethod,
    OutputKind,
    ParamZone,
    ResolvedOutput,
    Span,
    Stmt,
    StructDef,
    SwitchArm,
    Symbol,
    SymbolKind,
    TComptimeField,
    TComptimeReport,
    TComptimeValue,
    TLocal,
    TupleField,
    Type,
    ViewProvenance,
    ViewProvenanceMap,
    ViewSource,
    ViewSourcePath,
    derivation_identity,
    derivation_payload_json,
    derivation_payload_kind,
    derivation_record,
    expr_span,
    failure_contract_shown_name,
    failure_contract_source,
    sha256_hex,
    type_name,
    ModuleID,
    module_text,
]

// `missing` names the first fact that left the index incomplete ("" when complete).
SemaCompilerSemanticIndexFacts: struct {
    value: TComptimeValue,
    complete: Bool,
    missing: String{""},
}

SemaCompilerModuleSource: struct {
    module_identity: ModuleID,
    source: String,
}

// The first registered module without exactly one source, or source without a
// registered module; "" when the sources match the registration one-to-one.
sema_compiler_index_module_sources_missing: fn(registration: SemaRegistrationGraph, module_sources: [SemaCompilerModuleSource]) -> String Never! {
    loop registered_module_index in 0..<registration.modules.len() {
        matches := 0
        loop module_source in module_sources {
            if module_source.module_identity == registration.modules[registered_module_index].module_identity {
                matches += 1
            }
        }
        if matches != 1 {
            return "registered module `{module_text(registration.module_table, registration.modules[registered_module_index].module_identity)}` has {matches} sources"
        }
    }
    loop module_source in module_sources {
        found := false
        loop registered_module_index in 0..<registration.modules.len() {
            if module_source.module_identity == registration.modules[registered_module_index].module_identity {
                found = true
                break
            }
        }
        if !found {
            return "source module `{module_text(registration.module_table, module_source.module_identity)}` is not registered"
        }
    }
    ""
}

sema_compiler_index_module_source: fn(module_sources: [SemaCompilerModuleSource], module_identity: ModuleID) -> String? {
    loop module_source in module_sources {
        if module_source.module_identity == module_identity -> return Val(module_source.source)
    }
    None
}

sema_compiler_index_string: fn(value: String) -> TComptimeValue Never! {
    TComptimeValue.String{value: value}
}

sema_compiler_index_int: fn(value: Int) -> TComptimeValue Never! {
    TComptimeValue.Int{value: value}
}

sema_compiler_index_bool: fn(value: Bool) -> TComptimeValue Never! {
    TComptimeValue.Bool{value: value}
}

// `value` as a SourceSpan of the text of `file`, the module whose text its
// offsets index.
sema_compiler_index_span: fn(value: Span, file: String) -> TComptimeValue Never! {
    TComptimeValue.Struct{
        type_name: "SourceSpan",
        fields: [TComptimeField]{
            TComptimeField{name: "file", value: sema_compiler_index_string(file)},
            TComptimeField{name: "start", value: sema_compiler_index_int(value.start)},
            TComptimeField{name: "end", value: sema_compiler_index_int(value.end)},
        },
    }
}

sema_compiler_index_option_string: fn(value: String?) -> TComptimeValue Never! {
    if value == .Val(item) -> return TComptimeValue.Present{value: sema_compiler_index_string(item)}
    TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.String}}
}

sema_compiler_index_strings: fn(values: [String]) -> TComptimeValue Never! {
    output := [TComptimeValue]{}
    loop value in values -> output.push(sema_compiler_index_string(value))
    TComptimeValue.List{values: output}
}

sema_compiler_index_span_list: fn(values: [Span], file: String) -> TComptimeValue Never! {
    output := [TComptimeValue]{}
    loop value in values -> output.push(sema_compiler_index_span(value, file))
    TComptimeValue.List{values: output}
}

// The name the identities spell the module `module_identity` by
// (sema_compiler_identity): its registered name, or its identity text when
// `registration` holds no such module.
sema_compiler_index_module_name: fn(registration: SemaRegistrationGraph, module_identity: ModuleID) -> String {
    if sema_registration_module_index(registration, module_identity) == .Val(row) {
        return registration.modules[row].module_name
    }
    module_text(registration.module_table, module_identity)
}

// The source file of the module named `module_name`; "" when no module of
// `registration` has that name.
sema_compiler_index_module_file: fn(registration: SemaRegistrationGraph, module_name: String) -> String Never! {
    loop registered_module in registration.modules {
        if registered_module.module_name == module_name -> return registered_module.source_file
    }
    ""
}

// The identity a compiler value names the declaration keyed `key` by
// (symbol_key_text's `kind:module.owner.name`): a kind word, then the dotted
// path of its module's name, its owner and its own name, as in
// `fn:app.helper`, `method:app.Point.area` or `param:app.helper.x`. A text
// that is no declaration key, such as an ambient call's name, is its own
// identity.
sema_compiler_identity: fn(registration: SemaRegistrationGraph, key: String) -> String {
    kind: (key.split_once(":") ?? return key.copy()).before
    rest: key.slice(kind.len() + 1, key.len())
    name_start: symbol_key_leaf_start(rest)
    if name_start == 0 -> return key.copy()
    name: foundation_byte_text(rest.bytes(), name_start, rest.count_bytes())
    // A module identity may hold `.` and `:` of its own: the key's module is
    // the registered one symbol_key_parts finds, and the rest its owner. A
    // key of no registered module is cut at the last `.` before its name.
    declaring := ""
    owner := ""
    declared_row := Int?{None}
    if symbol_key_parts(key, fn(text: String) { sema_registration_module_index_text(registration, text) != None }) == .Val(parts) {
        if sema_registration_module_index_text(registration, parts.module_identity) == .Val(row) {
            declaring = registration.modules[row].module_name.copy()
            declared_row = Val(row)
        }
        owner = parts.owner
    } else {
        head: foundation_byte_text(rest.bytes(), 0, name_start - 1)
        split: head.cut_last(".")
        declaring = if split == .Val(parts) -> parts.before.copy() else -> head.copy()
        owner = if split == .Val(parts) -> parts.after.copy() else -> ""
    }
    nested: owner.contains(":")
    word: if {
        kind == "function" && owner != "" && !nested -> "method"
        kind == "function" -> "fn"
        kind == "constant" -> "const"
        kind == "parameter" -> "param"
        else -> kind
    }
    // A type lifted from an inline module, and each member it holds, reads by
    // the path its source writes (`M3GeoPoint` is `geo.Point`), as its
    // TypeInfo's identity does (sema_comptime_reflection_declared_identity).
    if declared_row == .Val(row) && declaring != "" && !nested {
        items: registration.modules[row].program.items
        if owner == "" -> return "{word}:{sema_name_type_path(declaring, items, name)}"
        return "{word}:{sema_name_type_path(declaring, items, owner)}.{name}"
    }
    scope: if {
        owner == "" -> declaring
        nested -> sema_compiler_identity_path(sema_compiler_identity(registration, owner))
        else -> "{declaring}.{owner}"
    }
    "{word}:{scope}.{name}"
}

// The dotted path of an identity: the text after its kind word.
sema_compiler_identity_path: fn(identity: String) -> String Never! {
    (identity.split_once(":") ?? return identity.copy()).after
}

// The DeclarationKind variant of `symbol`: what a definition and every
// reference to it say it declares. A function a type or trait owns is a
// Method; a type is the kind of its nominal declaration, an impl's
// associated type AssociatedType, and a type no module declares (a builtin
// carrier) Builtin.
sema_compiler_index_declaration_kind: fn(symbol: Symbol, registration: SemaRegistrationGraph) -> String Never! {
    if symbol.kind == {
        .Module -> "Module"
        .Function -> if symbol.owner == None -> "Function" else -> "Method"
        .Trait -> "Trait"
        .Impl -> "Impl"
        .Constant -> "Constant"
        .Field -> "Field"
        .Variant -> "Variant"
        .Parameter -> "Parameter"
        .Local -> "Local"
        .Import -> "Import"
        .Foreign -> "Foreign"
        .Label -> "Label"
        .Type -> {
            if symbol.owner != None -> return "AssociatedType"
            caller: sema_registration_module_index(registration, symbol.module_identity) ?? return "Builtin"
            nominal: loop row in registration.modules[caller].nominals {
                if row.symbol.id == symbol.id {
                    break row.kind
                }
            } ?? return "Builtin"
            if nominal == {
                .Struct -> "Struct"
                .Enum -> "Enum"
                .Distinct -> "Distinct"
                .TypeAlias -> "Alias"
                .Trait -> "Trait"
                .Tag -> "Tag"
                .UnitFamily -> "UnitFamily"
                .ForeignHandle -> "ForeignHandle"
            }
        }
    }
}

sema_compiler_index_declaration_kind_value: fn(symbol: Symbol, registration: SemaRegistrationGraph) -> TComptimeValue Never! {
    TComptimeValue.Enum{type_name: "DeclarationKind", variant: sema_compiler_index_declaration_kind(symbol, registration), args: [TComptimeEnumArg]{}}
}

// The kind word a definition's derivation keys hash (its stable and
// signature ids). It is key text, never a reflected value: the index reports
// a definition's kind as its DeclarationKind.
sema_compiler_index_definition_kind: fn(symbol: Symbol, registration: SemaRegistrationGraph) -> String Never! {
    if symbol.kind == {
        .Module -> return "module"
        .Function -> return "function"
        .Trait -> return "trait"
        .Constant -> return "const"
        .Field -> return "field"
        .Variant -> return "variant"
        .Parameter -> return "param"
        .Local -> return "local"
        .Type -> {
            loop registered_module_index in 0..<registration.modules.len() {
                if registration.modules[registered_module_index].module_identity != symbol.module_identity {
                    next
                }
                loop nominal_index in 0..<registration.modules[registered_module_index].nominals.len() {
                    if registration.modules[registered_module_index].nominals[nominal_index].symbol.id != symbol.id {
                        next
                    }
                    if registration.modules[registered_module_index].nominals[nominal_index].kind == SemaRegistrationNominalKind.Struct {
                        return "struct"
                    }
                    if registration.modules[registered_module_index].nominals[nominal_index].kind == SemaRegistrationNominalKind.Enum {
                        return "enum"
                    }
                    if registration.modules[registered_module_index].nominals[nominal_index].kind == SemaRegistrationNominalKind.Tag {
                        return "tag"
                    }
                }
            }
            return "type"
        }
        .Impl | .Import | .Foreign | .Label -> return "type"
    }
}

// A type the index names, as the TypeId reflection gives it; `caller` is the
// row of the module the type is written in. Every symbol the index describes
// is registered in this compilation, so every type it names has a TypeId.
sema_compiler_index_type_id_option: fn(registration: SemaRegistrationGraph, caller: Int, ty: Type?) -> TComptimeValue {
    if ty == .Val(value) {
        return sema_comptime_reflection_some(sema_comptime_reflection_type_id(registration, caller, value))
    }
    sema_comptime_reflection_none(Type.Named{name: "TypeId"})
}

sema_compiler_index_parameter_values: fn(registration: SemaRegistrationGraph, caller: Int, parameters: [SemaRegistrationParameter]) -> TComptimeValue {
    values := [TComptimeValue]{}
    loop parameter in parameters {
        values.push(
            TComptimeValue.Struct{
                type_name: "CompilerParam",
                fields: [TComptimeField]{
                    TComptimeField{name: "name", value: sema_compiler_index_string(parameter.name)},
                    TComptimeField{name: "type", value: sema_comptime_reflection_type_id(registration, caller, parameter.ty)},
                },
            },
        )
    }
    TComptimeValue.List{values: values}
}

// The CompilerSymbolKind of `symbol`, declared in the module at row `caller`.
sema_compiler_index_symbol_kind: fn(registration: SemaRegistrationGraph, caller: Int, symbol: Symbol) -> TComptimeValue {
    registered_module: registration.modules[caller]
    params := TComptimeValue.List{values: [TComptimeValue]{}}
    ret := sema_compiler_index_type_id_option(registration, caller, None)
    // The owner as the index names definitions (`type:app.Shape` for a
    // variant), never as the checker's internal key.
    parent: if symbol.owner == .Val(owner) -> Val(sema_compiler_identity(registration, owner)) else -> String?{None}
    fields := [TComptimeValue]{}
    variants := [String]{}
    mutable := TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Bool}}
    if symbol.kind == .Function {
        loop function in registered_module.functions {
            if function.symbol.id != symbol.id -> next
            params = sema_compiler_index_parameter_values(registration, caller, function.parameters)
            if function.signature == .Fn(_, return_type, _, _, _, _) {
                if return_type != None {
                    ret = sema_compiler_index_type_id_option(registration, caller, return_type)
                }
            }
        }
    }
    if symbol.kind == .Type {
        loop nominal in registered_module.nominals {
            if nominal.symbol.id != symbol.id -> next
            if nominal.kind == SemaRegistrationNominalKind.Struct {
                loop field in nominal.fields {
                    fields.push(
                        TComptimeValue.Struct{
                            type_name: "CompilerField",
                            fields: [TComptimeField]{
                                TComptimeField{name: "name", value: sema_compiler_index_string(field.symbol.name)},
                                TComptimeField{name: "type", value: sema_comptime_reflection_type_id(registration, caller, field.ty)},
                            },
                        },
                    )
                }
            }
            if nominal.kind == SemaRegistrationNominalKind.Enum {
                loop variant in nominal.variants -> variants.push(variant.symbol.name)
            }
        }
    }
    TComptimeValue.Struct{
        type_name: "CompilerSymbolKind",
        fields: [TComptimeField]{
            TComptimeField{name: "kind", value: sema_compiler_index_declaration_kind_value(symbol, registration)},
            TComptimeField{name: "params", value: params},
            TComptimeField{name: "ret", value: ret},
            TComptimeField{name: "parent", value: sema_compiler_index_option_string(parent)},
            TComptimeField{name: "type", value: sema_compiler_index_type_id_option(registration, caller, symbol.ty)},
            TComptimeField{name: "fields", value: TComptimeValue.List{values: fields}},
            TComptimeField{name: "variants", value: sema_compiler_index_strings(variants)},
            TComptimeField{name: "mutable", value: mutable},
        },
    }
}

sema_compiler_index_view_source_value: fn(source: ViewSource) -> TComptimeValue Never! {
    if source == {
        .Receiver -> return TComptimeValue.Struct{
            type_name: "CompilerViewSource",
            fields: [TComptimeField]{
                TComptimeField{name: "kind", value: sema_compiler_index_string("receiver")},
                TComptimeField{name: "index", value: sema_compiler_index_option_int(None)},
                TComptimeField{name: "module", value: sema_compiler_index_option_string(None)},
                TComptimeField{name: "name", value: sema_compiler_index_option_string(None)},
            },
        }
        .Parameter(index) -> return TComptimeValue.Struct{
            type_name: "CompilerViewSource",
            fields: [TComptimeField]{
                TComptimeField{name: "kind", value: sema_compiler_index_string("parameter")},
                TComptimeField{name: "index", value: sema_compiler_index_option_int(Val(index))},
                TComptimeField{name: "module", value: sema_compiler_index_option_string(None)},
                TComptimeField{name: "name", value: sema_compiler_index_option_string(None)},
            },
        }
        .Static(module_path, name) -> return TComptimeValue.Struct{
            type_name: "CompilerViewSource",
            fields: [TComptimeField]{
                TComptimeField{name: "kind", value: sema_compiler_index_string("static")},
                TComptimeField{name: "index", value: sema_compiler_index_option_int(None)},
                TComptimeField{name: "module", value: sema_compiler_index_option_string(Val(module_path))},
                TComptimeField{name: "name", value: sema_compiler_index_option_string(Val(name))},
            },
        }
    }
}

sema_compiler_index_view_provenance_value: fn(value: ViewProvenance, output_path: [String]) -> TComptimeValue Never! {
    sources := [TComptimeValue]{}
    loop path in value.sources {
        projections := [TComptimeValue]{}
        loop projection in path.projections {
            if projection == {
                .Field(name) -> {
                    projections.push(
                        TComptimeValue.Struct{
                            type_name: "CompilerViewProjection",
                            fields: [TComptimeField]{
                                TComptimeField{name: "kind", value: sema_compiler_index_string("field")},
                                TComptimeField{name: "name", value: sema_compiler_index_option_string(Val(name))},
                            },
                        },
                    )
                }
                .Index -> {
                    projections.push(
                        TComptimeValue.Struct{
                            type_name: "CompilerViewProjection",
                            fields: [TComptimeField]{
                                TComptimeField{name: "kind", value: sema_compiler_index_string("index")},
                                TComptimeField{name: "name", value: sema_compiler_index_option_string(None)},
                            },
                        },
                    )
                }
                .Range -> {
                    projections.push(
                        TComptimeValue.Struct{
                            type_name: "CompilerViewProjection",
                            fields: [TComptimeField]{
                                TComptimeField{name: "kind", value: sema_compiler_index_string("range")},
                                TComptimeField{name: "name", value: sema_compiler_index_option_string(None)},
                            },
                        },
                    )
                }
            }
        }
        sources.push(
            TComptimeValue.Struct{
                type_name: "CompilerViewSourcePath",
                fields: [TComptimeField]{
                    TComptimeField{name: "source", value: sema_compiler_index_view_source_value(path.source)},
                    TComptimeField{name: "projections", value: TComptimeValue.List{values: projections}},
                },
            },
        )
    }
    TComptimeValue.Struct{
        type_name: "CompilerViewProvenance",
        fields: [TComptimeField]{
            TComptimeField{name: "output_path", value: sema_compiler_index_strings(output_path)},
            TComptimeField{name: "sources", value: TComptimeValue.List{values: sources}},
            TComptimeField{name: "mutable", value: sema_compiler_index_bool(value.mutable)},
        },
    }
}

sema_compiler_index_view_provenance_values: fn(map: ViewProvenanceMap?) -> TComptimeValue Never! {
    if map == .Val(value) {
        values := [TComptimeValue]{}
        loop entry in value.entries {
            values.push(sema_compiler_index_view_provenance_value(entry.value, entry.slot))
        }
        return TComptimeValue.List{values: values}
    }
    TComptimeValue.List{values: [TComptimeValue]{}}
}

// `caller` is the row of the module that declares `symbol`, keyed `key`.
// Its `path` is its identity's dotted path, which the identity of its
// per-kind record (TypeInfo, FunctionInfo, TraitInfo, ConstantInfo) spells;
// its `scope` is the path of the declaration that holds it, or its module's
// name for a declaration at module scope; its `module` is that name too.
sema_compiler_index_definition: fn(registration: SemaRegistrationGraph, key: String, caller: Int, symbol: Symbol, view_provenance: TComptimeValue) -> TComptimeValue {
    identity: sema_compiler_identity(registration, key)
    scope: if symbol.owner == .Val(owner) -> sema_compiler_identity_path(sema_compiler_identity(registration, owner)) else -> "{registration.modules[caller].module_name}"
    TComptimeValue.Struct{
        type_name: "CompilerDefinition",
        fields: [TComptimeField]{
            TComptimeField{name: "identity", value: sema_compiler_index_string(identity)},
            TComptimeField{name: "path", value: sema_compiler_index_string(sema_compiler_identity_path(identity))},
            TComptimeField{name: "scope", value: sema_compiler_index_string(scope)},
            TComptimeField{name: "name", value: sema_compiler_index_string(symbol.name)},
            TComptimeField{name: "module", value: sema_compiler_index_string(registration.modules[caller].module_name)},
            TComptimeField{name: "span", value: sema_compiler_index_span(symbol.span, registration.modules[caller].source_file)},
            TComptimeField{name: "kind", value: sema_compiler_index_symbol_kind(registration, caller, symbol)},
            TComptimeField{name: "view_provenance", value: view_provenance},
        },
    }
}

// `key` is the symbol's key text: None for a local no checked body holds.
sema_compiler_index_anchor: fn(symbol: Symbol, key: String?, registration: SemaRegistrationGraph) -> TComptimeValue {
    identity := String?{None}
    if key == .Val(text) -> identity = Val(sema_compiler_identity(registration, text))
    TComptimeValue.Struct{
        type_name: "CompilerDefinitionAnchor",
        fields: [TComptimeField]{
            TComptimeField{name: "module", value: sema_compiler_index_string(sema_compiler_index_module_name(registration, symbol.module_identity))},
            TComptimeField{name: "kind", value: sema_compiler_index_declaration_kind_value(symbol, registration)},
            TComptimeField{name: "semantic_identity", value: sema_compiler_index_option_string(identity)},
            TComptimeField{name: "span", value: sema_compiler_index_span(symbol.span, sema_compiler_index_module_file(registration, module_text(registration.module_table, symbol.module_identity)))},
        },
    }
}

sema_compiler_index_reference: fn(reference: SemaNameReferenceFact, key: String?, registration: SemaRegistrationGraph, module_name: String, file: String) -> TComptimeValue {
    TComptimeValue.Struct{
        type_name: "CompilerReference",
        fields: [TComptimeField]{
            TComptimeField{name: "name", value: sema_compiler_index_string(reference.symbol.name)},
            TComptimeField{name: "module", value: sema_compiler_index_string(module_name)},
            TComptimeField{name: "scope_identity", value: sema_compiler_index_option_string(None)},
            TComptimeField{name: "target", value: TComptimeValue.Present{value: sema_compiler_index_anchor(sema_compiler_index_referent_symbol(reference.symbol, None), key, registration)}},
            TComptimeField{name: "span", value: sema_compiler_index_span(reference.span, file)},
        },
    }
}

// The Symbol the index describes for a reference's declaration. A reference
// keeps no checked type; `ty` is the one its definition reports.
sema_compiler_index_referent_symbol: fn(referent: SemaNameReferent, ty: Type?) -> Symbol Never! {
    owner: if referent.owner == "" -> String?{None} else -> Val(referent.owner)
    Symbol{id: referent.id, kind: referent.kind, name: referent.name, module_identity: referent.module_identity, owner: owner, span: referent.span, ty: ty, visibility: 0}
}

// The checked type of the parameter `id` of `function`, which a definition
// first met through a reference reports as a parameter's own row does.
sema_compiler_index_parameter_type: fn(function: FnBody, id: SymbolID) -> Type? Never! {
    loop parameter in function.params {
        if parameter.local.symbol_id == .Val(local) && local == id -> return Val(parameter.ty)
    }
    None
}

sema_compiler_index_call: fn(call: SemaCallSiteFact, registration: SemaRegistrationGraph, module_name: String, file: String) -> TComptimeValue? {
    callee: call.callee ?? return None
    // A call through a local function value names no definition.
    if symbol_is_local(callee) -> return None
    Val(sema_compiler_call_heard(sema_compiler_identity(registration, call.caller_key), sema_compiler_identity(registration, symbol_table_key(registration.symbols, callee)), module_name, call.span, file))
}

// A CompilerCall a build watches or the semantic index lists. Its call fact
// keeps no argument facts, so its name is the callee's own over the call's
// span and it holds no arguments or receiver; a call a marker's `check` rule
// hears carries all three (sema_rule_call_value).
sema_compiler_call_heard: fn(caller: String, callee: String, module_name: String, span: Span, file: String) -> TComptimeValue Never! {
    path: sema_compiler_identity_path(callee)
    leaf: if path.cut_last(".") == .Val(parts) -> "{parts.after}" else -> path
    TComptimeValue.Struct{
        type_name: "CompilerCall",
        fields: [TComptimeField]{
            TComptimeField{name: "caller", value: sema_compiler_index_string(caller)},
            TComptimeField{name: "callee", value: sema_compiler_index_string(callee)},
            TComptimeField{name: "module", value: sema_compiler_index_string(module_name)},
            TComptimeField{name: "span", value: sema_compiler_index_span(span, file)},
            TComptimeField{name: "name", value: TComptimeValue.Struct{type_name: "CompilerName", fields: [TComptimeField]{TComptimeField{name: "text", value: sema_compiler_index_string(leaf)}, TComptimeField{name: "span", value: sema_compiler_index_span(span, file)}}}},
            TComptimeField{name: "args", value: TComptimeValue.List{values: [TComptimeValue]{}}},
            TComptimeField{name: "receiver", value: sema_comptime_reflection_none(Type.Named{name: "CompilerArg"})},
            TComptimeField{name: "source", value: sema_comptime_reflection_none(Type.String)},
        },
    }
}

sema_compiler_index_provenance: fn(function: FnBody, registration: SemaRegistrationGraph, effect_name: String, file: String) -> [TComptimeValue] {
    output := [TComptimeValue]{}
    loop source in function.effects.direct_spans {
        if source.name != effect_name -> next
        output.push(
            TComptimeValue.Struct{
                type_name: "CompilerEffectProvenance",
                fields: [TComptimeField]{
                    TComptimeField{name: "effect", value: sema_compiler_index_string(effect_name)},
                    TComptimeField{name: "call_path", value: sema_compiler_index_strings([String]{sema_compiler_identity(registration, function.key)})},
                    TComptimeField{name: "spans", value: sema_compiler_index_span_list([Span]{source.span}, file)},
                },
            },
        )
    }
    output
}

sema_compiler_index_effect: fn(function: FnBody, registration: SemaRegistrationGraph, file: String) -> TComptimeValue {
    provenance := [TComptimeValue]{}
    loop effect_name in function.effects.solved {
        loop row in sema_compiler_index_provenance(function, registration, effect_name, file) {
            provenance.push(row)
        }
    }
    TComptimeValue.Struct{
        type_name: "CompilerEffect",
        fields: [TComptimeField]{
            TComptimeField{name: "function", value: sema_compiler_index_string(sema_compiler_identity(registration, function.key))},
            TComptimeField{name: "direct", value: sema_compiler_index_strings(function.effects.direct)},
            TComptimeField{name: "callees", value: sema_compiler_index_strings(loop callee in function.effects.call_edges -> sema_compiler_identity(registration, callee))},
            TComptimeField{name: "inferred", value: sema_compiler_index_strings(function.effects.solved)},
            TComptimeField{name: "maximal", value: sema_compiler_index_bool(function.effects.maximal)},
            TComptimeField{name: "provenance", value: TComptimeValue.List{values: provenance}},
        },
    }
}

sema_compiler_index_option_int: fn(value: Int?) -> TComptimeValue Never! {
    if value == .Val(item) -> return TComptimeValue.Present{value: sema_compiler_index_int(item)}
    TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Int}}
}

sema_compiler_index_option_bool: fn(value: Bool?) -> TComptimeValue Never! {
    if value == .Val(item) -> return TComptimeValue.Present{value: sema_compiler_index_bool(item)}
    TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Bool}}
}

sema_compiler_index_arithmetic_mode: fn(mode: ArithmeticMode) -> String Never! {
    if {
        mode == ArithmeticMode.Checked -> "Checked"
        mode == ArithmeticMode.Wrapping -> "Wrapping"
        else -> "Saturating"
    }
}

sema_compiler_index_arithmetic_operation: fn(operation: ArithmeticOperation) -> String Never! {
    if {
        operation == ArithmeticOperation.Add -> "add"
        operation == ArithmeticOperation.Sub -> "sub"
        operation == ArithmeticOperation.Mul -> "mul"
        operation == ArithmeticOperation.Neg -> "neg"
        else -> "pow"
    }
}

sema_compiler_index_arithmetic_fact: fn(fact: ArithmeticPolicyFact, module_name: String, file: String) -> TComptimeValue Never! {
    operation: fact.operation ?? ArithmeticOperation.Add
    TComptimeValue.Struct{
        type_name: "CompilerArithmeticOperation",
        fields: [TComptimeField]{
            TComptimeField{name: "operation", value: sema_compiler_index_string(sema_compiler_index_arithmetic_operation(operation))},
            TComptimeField{name: "policy", value: sema_compiler_index_string(sema_compiler_index_arithmetic_mode(fact.mode))},
            TComptimeField{name: "module", value: sema_compiler_index_string(module_name)},
            TComptimeField{name: "operation_span", value: sema_compiler_index_span(fact.operation_span, file)},
            TComptimeField{name: "scope_span", value: sema_compiler_index_span(fact.scope_span, file)},
        },
    }
}

sema_compiler_index_output_kind: fn(kind: OutputKind) -> String Never! {
    if {
        kind == OutputKind.Library -> "library"
        kind == OutputKind.Executable -> "executable"
        kind == OutputKind.Service -> "service"
        kind == OutputKind.Check -> "check"
        kind == OutputKind.Environment -> "environment"
        kind == OutputKind.Image -> "image"
        kind == OutputKind.Bundle -> "bundle"
        kind == OutputKind.Fleet -> "fleet"
        else -> "system"
    }
}

// The CompilerOutput of a resolved `output` bound by `binding` in the module at
// row `caller`; the entry's types are written in the entry's own module.
sema_compiler_index_output_value: fn(output: ResolvedOutput, binding: ConstDef, registration: SemaRegistrationGraph, caller: Int) -> TComptimeValue {
    registered_module: registration.modules[caller]
    target_row: if output.module_id >= 0 && output.module_id < registration.modules.len() -> output.module_id else -> caller
    target_module: registration.modules[target_row]
    params := [TComptimeValue]{}
    loop parameter in output.params {
        params.push(sema_comptime_reflection_type_id(registration, target_row, parameter.ty))
    }
    effects := output.effects
    TComptimeValue.Struct{
        type_name: "CompilerOutput",
        fields: [TComptimeField]{
            TComptimeField{name: "binding", value: sema_compiler_index_string(binding.name)},
            TComptimeField{name: "kind", value: sema_compiler_index_string(sema_compiler_index_output_kind(output.kind))},
            TComptimeField{name: "name", value: sema_compiler_index_string(output.output_name)},
            TComptimeField{name: "module", value: sema_compiler_index_string(registered_module.module_name)},
            TComptimeField{name: "span", value: sema_compiler_index_span(binding.span, registered_module.source_file)},
            TComptimeField{
                name: "entry",
                value: TComptimeValue.Struct{
                    type_name: "CompilerOutputEntry",
                    fields: [TComptimeField]{
                        TComptimeField{name: "identity", value: sema_compiler_index_string("{target_module.module_name}.{output.semantic_name}")},
                        TComptimeField{name: "name", value: sema_compiler_index_string(output.source_name)},
                        TComptimeField{name: "module", value: sema_compiler_index_string(target_module.module_name)},
                        TComptimeField{name: "definition_span", value: sema_compiler_index_span(output.definition, target_module.source_file)},
                        TComptimeField{name: "reference_span", value: sema_compiler_index_span(output.reference, registered_module.source_file)},
                        TComptimeField{name: "params", value: TComptimeValue.List{values: params}},
                        TComptimeField{name: "return_type", value: sema_compiler_index_type_id_option(registration, target_row, output.return_type)},
                        TComptimeField{name: "failure_contract", value: sema_compiler_index_string(failure_contract_shown_name(output.failure_contract))},
                        TComptimeField{name: "failure_source", value: sema_compiler_index_string(failure_contract_source(output.failure_contract))},
                        TComptimeField{name: "authority", value: sema_compiler_index_string("safe-jet")},
                        TComptimeField{name: "effects", value: sema_compiler_index_strings(effects)},
                    },
                },
            },
        },
    }
}

sema_compiler_index_state_graph_value: fn(fact: SemaStateGraphFact, definition: StructDef, module_name: String, file: String) -> TComptimeValue Never! {
    nodes := [TComptimeValue]{}
    loop node in fact.states {
        state_span := Span{start: 0, end: 0}
        if definition.state == .Val(state) {
            loop declaration in state.states {
                if declaration.name == node.name -> state_span = declaration.span
            }
        }
        nodes.push(
            TComptimeValue.Struct{
                type_name: "CompilerStateNode",
                fields: [TComptimeField]{
                    TComptimeField{name: "name", value: sema_compiler_index_string(node.name)},
                    TComptimeField{name: "terminal", value: sema_compiler_index_bool(node.terminal)},
                    TComptimeField{name: "reachable", value: sema_compiler_index_option_bool(node.reachable)},
                    TComptimeField{name: "span", value: sema_compiler_index_span(state_span, file)},
                },
            },
        )
    }
    transitions := [TComptimeValue]{}
    loop transition in fact.transitions {
        transitions.push(
            TComptimeValue.Struct{
                type_name: "CompilerStateTransition",
                fields: [TComptimeField]{
                    TComptimeField{name: "operation", value: sema_compiler_index_string(transition.operation)},
                    TComptimeField{name: "from", value: sema_compiler_index_option_string(transition.from)},
                    TComptimeField{name: "to", value: sema_compiler_index_string(transition.to)},
                },
            },
        )
    }
    TComptimeValue.Struct{
        type_name: "CompilerStateGraph",
        fields: [TComptimeField]{
            TComptimeField{name: "owner", value: sema_compiler_index_string(fact.type_name)},
            TComptimeField{name: "module", value: sema_compiler_index_string(module_name)},
            TComptimeField{name: "states", value: TComptimeValue.List{values: nodes}},
            TComptimeField{name: "transitions", value: TComptimeValue.List{values: transitions}},
        },
    }
}

sema_compiler_index_fact_declaration: fn(kind: String, name: String, members: [String], deny: [String], from: [String]) -> TComptimeValue Never! {
    TComptimeValue.Struct{
        type_name: "CompilerFactDeclaration",
        fields: [TComptimeField]{
            TComptimeField{name: "kind", value: sema_compiler_index_string(kind)},
            TComptimeField{name: "name", value: sema_compiler_index_string(name)},
            TComptimeField{name: "members", value: sema_compiler_index_strings(members)},
            TComptimeField{name: "deny", value: sema_compiler_index_strings(deny)},
            TComptimeField{name: "from", value: sema_compiler_index_strings(from)},
        },
    }
}

sema_compiler_index_sorted_strings: fn(values: [String]) -> [String] Never! {
    result := values
    loop i in 1..<result.len() {
        value := result[i]
        j := i
        loop j > 0 && result[j - 1] > value {
            result[j] = result[j - 1]
            j -= 1
        }
        result[j] = value
    }
    unique := [String]{}
    loop value in result {
        if unique.len() == 0 || unique[unique.len() - 1] != value -> unique.push(value)
    }
    unique
}

SemaCompilerFactRegistryRow: struct {
    kind: String,
    name: String,
    members: [String],
    deny: [String],
    from: [String],
}

sema_compiler_index_fact_kind_order: fn(kind: String) -> Int Never! {
    if {
        kind == "Effect" -> 0
        kind == "State" -> 1
        else -> 2
    }
}

sema_compiler_index_fact_registry: fn(registration: SemaRegistrationGraph) -> TComptimeValue Never! {
    rows := [SemaCompilerFactRegistryRow]{}
    loop root in sema_compiler_index_sorted_strings(authority_grantable_roots()) {
        members := [String]{}
        loop registration_module_index in 0..<registration.modules.len() {
            loop item_index in 0..<registration.modules[registration_module_index].program.items.len() {
                if registration.modules[registration_module_index].program.items[item_index] == .EffectDecl(declaration) {
                    parts := declaration.name.split(".").to_list()
                    if parts.len() == 2 && parts[0] == root -> members.push(parts[1])
                }
            }
        }
        rows.push(
            SemaCompilerFactRegistryRow{
                kind: "Effect",
                name: root,
                members: sema_compiler_index_sorted_strings(members),
                deny: [String]{},
                from: [String]{},
            },
        )
    }
    all_items := [Item]{}
    loop registration_module_index in 0..<registration.modules.len() {
        loop item_index in 0..<registration.modules[registration_module_index].program.items.len() {
            item: registration.modules[registration_module_index].program.items[item_index]
            all_items.push(item.copy())
        }
    }
    loop fact in sema_state_graph_facts(all_items) {
        members := [String]{}
        loop node in fact.states -> members.push(node.name)
        rows.push(
            SemaCompilerFactRegistryRow{
                kind: "State",
                name: "{fact.type_name}.State",
                members: members,
                deny: [String]{},
                from: [String]{},
            },
        )
    }
    loop name in sema_taint_builtin_tag_names() {
        builtin: sema_taint_builtin_tag(name) ?? next
        rows.push(
            SemaCompilerFactRegistryRow{
                kind: "Tag",
                name: builtin.name,
                members: [String]{},
                deny: sema_compiler_index_sorted_strings(builtin.deny),
                from: sema_compiler_index_sorted_strings(builtin.from),
            },
        )
    }
    loop registration_module_index in 0..<registration.modules.len() {
        loop item_index in 0..<registration.modules[registration_module_index].program.items.len() {
            if registration.modules[registration_module_index].program.items[item_index] == .Tag(tag_value) {
                deny := [String]{}
                from := [String]{}
                loop entry in tag_value.deny -> deny.push(entry.name)
                loop entry in tag_value.from -> from.push(entry.name)
                rows.push(
                    SemaCompilerFactRegistryRow{
                        kind: "Tag",
                        name: tag_value.name,
                        members: [String]{},
                        deny: sema_compiler_index_sorted_strings(deny),
                        from: sema_compiler_index_sorted_strings(from),
                    },
                )
            }
        }
    }
    loop i in 1..<rows.len() {
        value := rows[i]
        j := i
        loop j > 0 && (sema_compiler_index_fact_kind_order(rows[j - 1].kind) > sema_compiler_index_fact_kind_order(value.kind) || (sema_compiler_index_fact_kind_order(rows[j - 1].kind) == sema_compiler_index_fact_kind_order(value.kind) && rows[j - 1].name > value.name)) {
            rows[j] = rows[j - 1]
            j -= 1
        }
        rows[j] = value
    }
    values := [TComptimeValue]{}
    loop row in rows {
        values.push(sema_compiler_index_fact_declaration(row.kind, row.name, row.members, row.deny, row.from))
    }
    TComptimeValue.List{values: values}
}

SemaCompilerIndexWalkState: struct {
    nodes: [TComptimeValue],
    arithmetic: [TComptimeValue],
    parents: [Int],
    // The next ordinal of each (parent, slot) pair, keyed by sema_compiler_index_ordinal_key.
    ordinal_keys: NameTable{name_column_table()},
    ordinals: [Int]{name_column()},
    slot: String,
    slot_is_list: Bool,
    // The source file and the name of the module being walked.
    file: String,
    module_name: String,
}

sema_compiler_index_walk_state: fn() -> SemaCompilerIndexWalkState Never! {
    SemaCompilerIndexWalkState{
        nodes: [TComptimeValue]{},
        arithmetic: [TComptimeValue]{},
        parents: [Int]{},
        ordinal_keys: name_column_table(),
        ordinals: name_column(),
        slot: "root",
        slot_is_list: true,
        file: "",
        module_name: "",
    }
}

sema_compiler_index_item_shape: fn(item: Item) -> String Never! {
    index := if item == {
        .Func(_) -> 0
        .Struct(_) -> 1
        .Enum(_) -> 2
        .Distinct(_) -> 3
        .TypeAlias(_) -> 4
        .UnitFamily(_) -> 5
        .Trait(_) -> 6
        .Tag(_) -> 7
        .EffectDecl(_) -> 8
        .Impl(_) -> 9
        .Const(_) -> 10
        .Test(_) -> 11
        .ExternRust(_) -> 12
        .Module(_) -> 13
        .CModule(_) -> 14
        .CodeModule(_) -> 15
        .ErrorConv(_) -> 16
        .Migration(_) -> 17
        .ProtocolDecl(_) -> 18
        .TemplateLoop(_) -> 19
        .GenericModule(_) -> 20
        .ModuleAlias(_) -> 21
        .MarkerDecl(_) -> 22
        .FactDecl(_) -> 23
    }
    "Discriminant({index})"
}

sema_compiler_index_item_span: fn(item: Item) -> Span Never! {
    if item == {
        .Func(value) -> value.span
        .Struct(value) -> value.span
        .Enum(value) -> value.span
        .Distinct(value) -> value.span
        .TypeAlias(value) -> value.span
        .UnitFamily(value) -> value.span
        .Trait(value) -> value.span
        .Tag(value) -> value.span
        .EffectDecl(value) -> value.span
        .Impl(value) -> value.span
        .Const(value) -> value.span
        .Test(value) -> value.span
        .ExternRust(value) -> value.span
        .Module(value) -> value.span
        .CModule(value) -> value.span
        .CodeModule(value) -> value.span
        .ErrorConv(value) -> value.from_span
        .Migration(value) -> value.span
        .ProtocolDecl(value) -> value.span
        .TemplateLoop(value) -> value.span
        .GenericModule(value) -> value.span
        .ModuleAlias(value) -> value.span
        .MarkerDecl(value) -> value.span
        .FactDecl(value) -> value.span
    }
}

sema_compiler_index_expr_shape: fn(expression: Expr) -> String {
    index := if expression == {
        .Str(_, _, _) -> 0
        .StrMatchLit(_, _, _) -> 1
        .BinMatchLit(_, _, _) -> 2
        .Int(_, _, _, _, _) -> 3
        .Float(_, _, _, _, _) -> 4
        .Bool(_, _, _) -> 5
        .Unit(_, _) -> 6
        .Char(_, _, _) -> 7
        .ListLit(_, _, _) -> 8
        .MemberSpread(_, _, _, _) -> 9
        .Spread(_, _, _) -> 10
        .MapLit(_, _, _) -> 11
        .Index(_, _, _, _, _) -> 12
        .Slice(_, _, _, _, _, _) -> 13
        .Range(_, _, _, _, _) -> 14
        .Ident(_, _, _) -> 15
        .Call(_, _) -> 16
        .Unary(_, _, _, _) -> 17
        .Binary(_, _, _, _, _) -> 18
        .CompareChain(_, _, _, _, _) -> 19
        .UnitLit(_, _, _, _, _, _, _) -> 20
        .Deref(_, _, _) -> 21
        .RawOf(_, _, _) -> 22
        .Copy(_, _, _) -> 23
        .Place(_, _, _, _) -> 24
        .Field(_, _, _, _) -> 25
        .OptField(_, _, _, _, _, _) -> 26
        .MethodCall(_, _, _, _, _, _, _) -> 27
        .StructLit(_, _, _, _, _, _, _, _) -> 28
        .TypedLit(_, _, _, _) -> 29
        .EnumLit(_, _, _, _, _, _, _) -> 30
        .Tainted(_, _, _, _) -> 31
        .Present(_, _, _) -> 32
        .Absent(_, _) -> 33
        .Todo(_, _, _) -> 34
        .NoElse(_, _) -> 35
        .PatternTest(_, _, _, _) -> 37
        .Ok(_, _, _) -> 38
        .Err(_, _, _) -> 39
        .Try(_, _, _, _, _) -> 40
        .OrFallback(_, _, _, _, _) -> 41
        .If(_, _, _, _, _, _, _) -> 42
        .TupleLit(_, _, _, _) -> 43
        .Lambda(_, _) -> 44
        .CallValue(_, _, _, _) -> 45
        .PtrFromAddr(_, _, _, _, _, _) -> 46
        .ComptimeName(_, _, _, _) -> 47
        .Paren(_, _, _) -> 48
        .OptMethodCall(_, _, _, _, _, _, _) -> 49
        .Pipe(_, _, _, _) -> 50
        .TypeValue(_, _, _) -> 51
    }
    "Discriminant({index})"
}

sema_compiler_index_expr_structural_span: fn(expression: Expr) -> Span {
    if expression == {
        .Call(call, _) -> {
            end := call.name_span.end + 2
            if call.args.len() > 0 -> end = expr_span(call.args[call.args.len() - 1].expr).end + 1
            Span{start: call.name_span.start, end: end}
        }
        .MethodCall(receiver, _, method_span, _, _, args, _) | .OptMethodCall(receiver, _, method_span, _, args, _, _) -> {
            end := method_span.end + 2
            if args.len() > 0 -> end = expr_span(args[args.len() - 1].expr).end + 1
            Span{start: expr_span(receiver).start, end: end}
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> expr_span(expression)
    }
}

sema_compiler_index_lvalue_span: fn(target: LValue) -> Span Never! {
    if target == {
        .Local(_, span) | .Index(_, _, span, _) | .Field(_, _, span) -> span
    }
}

sema_compiler_index_stmt_shape: fn(statement: Stmt) -> String Never! {
    index := if statement == {
        .Expr(_) -> 0
        .Val(_) -> 1
        .Assign(_, _, _, _) -> 2
        .Return(_, _) -> 3
        .While(_, _, _, _, _) -> 4
        .For(_, _, _, _, _, _, _, _, _) -> 5
        .Switch(_, _, _, _) -> 6
        .Break(_) -> 7
        .BreakValue(_, _) -> 8
        .Continue(_) -> 9
        .BreakLabel(_, _) -> 10
        .BreakLabelValue(_, _, _, _) -> 11
        .ContinueLabel(_, _) -> 12
        .Loop(_, _, _, _) -> 13
        .CountedLoop(_, _, _, _, _, _, _) -> 14
        .Unsafe(_, _, _, _) -> 15
        .Impure(_, _, _, _) -> 16
        .Reactive(_, _) -> 17
        .Shield(_, _) | .Defer(_, _) -> 18
        .Switched(_, _, _) -> 19
        .Region(_, _, _, _) -> 20
        .Policy(_, _, _) -> 21
        .TaskGroup(_, _, _, _, _) -> 22
        .Layout(_, _, _, _) -> 23
        .AuthorityScope(_, _, _, _, _) -> 24
        .ComptimeIf(_, _, _, _, _, _) -> 25
        .ComptimeSwitch(_, _, _, _) -> 26
        .ComptimeBlock(_, _, _) -> 27
        .ContextBlock(_, _, _) -> 28
        .Live(_, _) -> 29
        .AssumeDet(_, _, _, _) -> 30
        .Transact(_, _, _, _, _) -> 31
        .Yield(_, _) -> 32
        .ScopeMember(_, _, _, _, _, _, _, _) -> 33
        .DeferClose(_, _) -> 34
    }
    "Discriminant({index})"
}

sema_compiler_index_stmt_span: fn(statement: Stmt) -> Span {
    if statement == {
        .Expr(value) -> expr_span(value)
        .Val(binding) -> Span{start: if binding.sigil_span == .Val(sigil) -> sigil.start else -> binding.name_span.start, end: expr_span(binding.init).end}
        .Assign(target, _, _, value) -> Span{start: sema_compiler_index_lvalue_span(target).start, end: expr_span(value).end}
        .Return(_, span) | .While(_, _, span, _, _) | .For(_, _, _, _, _, span, _, _, _) | .Switch(_, _, _, span) | .Break(span) | .BreakValue(_, span) | .Continue(span) | .BreakLabel(_, span) | .BreakLabelValue(_, _, _, span) | .ContinueLabel(_, span) | .Loop(_, span, _, _) | .CountedLoop(_, _, _, _, span, _, _) | .Unsafe(_, _, _, span) | .Impure(_, _, _, span) | .Reactive(_, span) | .Shield(_, span) | .Defer(_, span) | .Switched(_, _, span) | .Region(_, _, _, span) | .Policy(_, _, span) | .TaskGroup(_, _, _, _, span) | .Layout(_, _, _, span) | .AuthorityScope(_, _, _, _, span) | .ComptimeIf(_, _, _, _, span, _) | .ComptimeSwitch(_, _, _, span) | .ComptimeBlock(_, _, span) | .ContextBlock(_, _, span) | .Live(_, span) | .AssumeDet(_, _, _, span) | .Transact(_, _, _, _, span) | .Yield(_, span) | .ScopeMember(_, _, _, _, _, _, _, span) | .DeferClose(_, span) -> span
    }
}

// One (parent, slot) pair as a map key: a node id never contains `:`.
sema_compiler_index_ordinal_key: fn(parent: Int?, slot: String) -> String Never! {
    if parent == .Val(id) -> return "{id}:{slot}"
    "-:{slot}"
}

sema_compiler_index_walk_node: fn(state: ^SemaCompilerIndexWalkState, class: String, shape: String, span: Span) -> Int? {
    if span.end < span.start -> return None
    parent := Int?{None}
    if state.parents.len() > 0 -> parent = Val(state.parents[state.parents.len() - 1])
    key: sema_compiler_index_ordinal_key(parent, state.slot)
    ordinal: name_column_get(state.ordinal_keys, state.ordinals, key) ?? 0
    name_column_set(state.ordinal_keys, state.ordinals, key, ordinal + 1)
    id := state.nodes.len()
    slot_kind := if state.slot_is_list -> "list" else -> "scalar"
    state.nodes.push(
        TComptimeValue.Struct{
            type_name: "CompilerStructuralNode",
            fields: [TComptimeField]{
                TComptimeField{name: "id", value: sema_compiler_index_int(id)},
                TComptimeField{name: "parent", value: sema_compiler_index_option_int(parent)},
                TComptimeField{name: "slot", value: sema_compiler_index_string(state.slot)},
                TComptimeField{name: "slot_kind", value: sema_compiler_index_string(slot_kind)},
                TComptimeField{name: "ordinal", value: sema_compiler_index_int(ordinal)},
                TComptimeField{name: "class", value: sema_compiler_index_string(class)},
                TComptimeField{name: "shape", value: sema_compiler_index_string(shape)},
                TComptimeField{name: "module", value: sema_compiler_index_string(state.module_name)},
                TComptimeField{name: "span", value: sema_compiler_index_span(span, state.file)},
            },
        },
    )
    Val(id)
}

sema_compiler_index_walk_expr_slot: fn(state: ^SemaCompilerIndexWalkState, slot: String, expression: Expr) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = false
    sema_compiler_index_walk_expr(state, expression)
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_stmt_slot: fn(state: ^SemaCompilerIndexWalkState, slot: String, statements: [Stmt]) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop statement in statements -> sema_compiler_index_walk_stmt(state, statement)
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_call_args_slot: fn(state: ^SemaCompilerIndexWalkState, slot: String, args: [CallArg]) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop argument in args { sema_compiler_index_walk_expr(state, argument.expr) }
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_call_args: fn(state: ^SemaCompilerIndexWalkState, args: [CallArg]) {
    sema_compiler_index_walk_call_args_slot(state, "args", args)
}

sema_compiler_index_walk_expr_list: fn(state: ^SemaCompilerIndexWalkState, slot: String, expressions: [Expr]) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop expression in expressions -> sema_compiler_index_walk_expr(state, expression)
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_expr_fields: fn(state: ^SemaCompilerIndexWalkState, slot: String, fields: [ExprField]) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop field in fields -> sema_compiler_index_walk_expr(state, field.value)
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_tuple_fields: fn(state: ^SemaCompilerIndexWalkState, slot: String, fields: [TupleField]) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop field in fields -> sema_compiler_index_walk_expr(state, field.value)
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_expr_pairs: fn(state: ^SemaCompilerIndexWalkState, slot: String, entries: [ExprPair], keys: Bool) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop entry in entries {
        if keys -> sema_compiler_index_walk_expr(state, entry.key) else {
            sema_compiler_index_walk_expr(state, entry.value)
        }
    }
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_expr: fn(state: ^SemaCompilerIndexWalkState, expression: Expr) {
    id: sema_compiler_index_walk_node(state, "expr", sema_compiler_index_expr_shape(expression), sema_compiler_index_expr_structural_span(expression)) ?? return
    state.parents.push(id)
    if expression == {
        .Call(call, _) -> sema_compiler_index_walk_call_args(state, call.args)
        .MethodCall(receiver, _, _, _, _, args, _) | .OptMethodCall(receiver, _, _, _, args, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "receiver", receiver)
            sema_compiler_index_walk_call_args(state, args)
        }
        .PtrFromAddr(_, _, _, address, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "address", address)
        }
        .Pipe(head, steps, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "head", head)
            sema_compiler_index_walk_expr_list(state, "steps", loop step in steps -> step.value)
        }
        .Field(base, _, _, _) | .OptField(base, _, _, _, _, _) | .MemberSpread(base, _, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "base", base)
        }
        .Binary(_, left, right, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "lhs", left)
            sema_compiler_index_walk_expr_slot(state, "rhs", right)
        }
        .CompareChain(operands, _, _, _, _) -> {
            sema_compiler_index_walk_expr_list(state, "operands", operands)
        }
        .Unary(_, operand, _, _) | .Deref(operand, _, _) | .RawOf(operand, _, _) | .Copy(operand, _, _) | .Place(operand, _, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "operand", operand)
        }
        .Index(base, index, _, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "base", base)
            sema_compiler_index_walk_expr_slot(state, "index", index)
        }
        .Slice(base, start, end, range, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "base", base)
            if range == .Val(value) -> sema_compiler_index_walk_expr_slot(state, "range", value) else {
                sema_compiler_index_walk_expr_slot(state, "start", start)
                sema_compiler_index_walk_expr_slot(state, "end", end)
            }
        }
        .Range(start, end, _, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "start", start)
            sema_compiler_index_walk_expr_slot(state, "end", end)
        }
        .Str(parts, _, _) -> {
            old_slot := state.slot
            old_list := state.slot_is_list
            state.slot = "interpolations"
            state.slot_is_list = true
            loop part in parts {
                if part == .Interp(value, _) -> sema_compiler_index_walk_expr(state, value)
            }
            state.slot = old_slot
            state.slot_is_list = old_list
        }
        .ListLit(items, _, _) -> { sema_compiler_index_walk_expr_list(state, "items", items) }
        .Spread(value, _, _) | .Tainted(value, _, _, _) | .Present(value, _, _) | .Ok(value, _, _) | .Err(value, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "value", value)
        }
        .MapLit(entries, _, _) -> {
            sema_compiler_index_walk_expr_pairs(state, "keys", entries, true)
            sema_compiler_index_walk_expr_pairs(state, "values", entries, false)
        }
        .TupleLit(fields, _, _, _) -> {
            sema_compiler_index_walk_tuple_fields(state, "fields", fields)
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            sema_compiler_index_walk_expr_fields(state, "fields", fields)
        }
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> { sema_compiler_index_walk_expr_fields(state, "body", fields) }
                .Elements(values) -> { sema_compiler_index_walk_expr_list(state, "body", values) }
                .Entries(entries) -> {
                    old_slot := state.slot
                    old_list := state.slot_is_list
                    state.slot = "body"
                    state.slot_is_list = true
                    loop entry in entries {
                        sema_compiler_index_walk_expr(state, entry.key)
                        sema_compiler_index_walk_expr(state, entry.value)
                    }
                    state.slot = old_slot
                    state.slot_is_list = old_list
                }
                .Value(value) -> {
                    old_slot := state.slot
                    old_list := state.slot_is_list
                    state.slot = "body"
                    state.slot_is_list = true
                    sema_compiler_index_walk_expr(state, value)
                    state.slot = old_slot
                    state.slot_is_list = old_list
                }
                .ByteText(_) | .Empty -> {}
            }
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            old_slot := state.slot
            old_list := state.slot_is_list
            state.slot = "args"
            state.slot_is_list = true
            loop argument in args {
                if argument == {
                    .Positional(value) -> { sema_compiler_index_walk_expr(state, value) }
                    .Named(_, value) -> sema_compiler_index_walk_expr(state, value)
                }
            }
            state.slot = old_slot
            state.slot_is_list = old_list
        }
        .Try(value, _, _, context, _) -> {
            sema_compiler_index_walk_expr_slot(state, "value", value)
            if context == .Val(note) -> sema_compiler_index_walk_expr_slot(state, "note", note)
        }
        .OrFallback(value, fallback, _, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "value", value)
            if fallback == {
                .Value(fallback_value) -> {
                    sema_compiler_index_walk_expr_slot(state, "fallback", fallback_value)
                }
                .Block(body, result, _) -> {
                    sema_compiler_index_walk_stmt_slot(state, "fallback_body", body)
                    if result == .Val(result_value) {
                        sema_compiler_index_walk_expr_slot(state, "fallback", result_value)
                    }
                }
                .Return(result, _) -> {
                    if result == .Val(result_value) {
                        sema_compiler_index_walk_expr_slot(state, "fallback", result_value)
                    }
                }
                .Panic(_, args) -> {
                    sema_compiler_index_walk_call_args_slot(state, "fallback_args", args)
                }
                .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
            }
        }
        .If(condition, then_body, then_value, else_body, else_value, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "condition", condition)
            sema_compiler_index_walk_stmt_slot(state, "then_body", then_body)
            sema_compiler_index_walk_expr_slot(state, "then_value", then_value)
            sema_compiler_index_walk_stmt_slot(state, "else_body", else_body)
            sema_compiler_index_walk_expr_slot(state, "else_value", else_value)
        }
        .Lambda(lambda, _) -> {
            if lambda.body == {
                .Expr(value) -> { sema_compiler_index_walk_expr_slot(state, "body", value) }
                .Block(body) -> sema_compiler_index_walk_stmt_slot(state, "body", body)
            }
        }
        .CallValue(callee, args, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "callee", callee)
            sema_compiler_index_walk_call_args(state, args)
        }
        .PatternTest(subject, _, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "subject", subject)
        }
        .Paren(value, _, _) -> { sema_compiler_index_walk_expr_slot(state, "inner", value) }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Ident(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    _ := state.parents.pop()
}

sema_compiler_index_walk_lvalue: fn(state: ^SemaCompilerIndexWalkState, target: LValue) {
    if target == {
        .Local(_, _) -> {}
        .Index(base, index, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "target_base", base)
            sema_compiler_index_walk_expr_slot(state, "target_index", index)
        }
        .Field(base, _, _) -> { sema_compiler_index_walk_expr_slot(state, "target_base", base) }
    }
}

sema_compiler_index_walk_for_kind: fn(state: ^SemaCompilerIndexWalkState, kind: ForKind) {
    if kind == {
        .Range(start, end, step, _) -> {
            sema_compiler_index_walk_expr_slot(state, "range_start", start)
            sema_compiler_index_walk_expr_slot(state, "range_end", end)
            if step == .Val(value) -> sema_compiler_index_walk_expr_slot(state, "range_step", value)
        }
        .In(collection, step) -> {
            sema_compiler_index_walk_expr_slot(state, "source", collection)
            if step == .Val(value) -> sema_compiler_index_walk_expr_slot(state, "stride", value)
        }
    }
}

sema_compiler_index_walk_arms: fn(state: ^SemaCompilerIndexWalkState, arms: [SwitchArm]) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = "arms"
    state.slot_is_list = true
    loop arm in arms {
        id: sema_compiler_index_walk_node(state, "arm", "switch_arm", arm.span) ?? next
        state.parents.push(id)
        sema_compiler_index_walk_expr_slot(state, "condition", arm.cond)
        sema_compiler_index_walk_stmt_slot(state, "body", arm.body)
        _ := state.parents.pop()
    }
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_stmt: fn(state: ^SemaCompilerIndexWalkState, statement: Stmt) {
    id: sema_compiler_index_walk_node(state, "stmt", sema_compiler_index_stmt_shape(statement), sema_compiler_index_stmt_span(statement)) ?? return
    state.parents.push(id)
    if statement == {
        .Val(binding) -> {
            if binding.ty_span == .Val(span) {
                sema_compiler_index_walk_type_slot(state, "type", span, false)
            }
            sema_compiler_index_walk_expr_slot(state, "initializer", binding.init)
        }
        .Expr(value) | .Yield(value, _) -> {
            sema_compiler_index_walk_expr_slot(state, "value", value)
        }
        .DeferClose(value, _) -> { sema_compiler_index_walk_expr_slot(state, "close", value) }
        .Assign(target, _, _, value) -> {
            sema_compiler_index_walk_lvalue(state, target)
            sema_compiler_index_walk_expr_slot(state, "value", value)
        }
        .Return(value, _) -> {
            if value == .Val(expr) -> sema_compiler_index_walk_expr_slot(state, "value", expr)
        }
        .BreakValue(value, _) -> { sema_compiler_index_walk_expr_slot(state, "value", value) }
        .BreakLabelValue(_, _, value, _) -> {
            sema_compiler_index_walk_expr_slot(state, "value", value)
        }
        .While(condition, body, _, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "condition", condition)
            sema_compiler_index_walk_stmt_slot(state, "body", body)
        }
        .For(_, _, _, kind, body, _, _, _, _) -> {
            sema_compiler_index_walk_for_kind(state, kind)
            sema_compiler_index_walk_stmt_slot(state, "body", body)
        }
        .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
            sema_compiler_index_walk_expr_slot(state, "subject", subject)
            sema_compiler_index_walk_arms(state, arms)
            if else_body == .Val(body) {
                sema_compiler_index_walk_stmt_slot(state, "else_body", body)
            }
        }
        .Loop(body, _, _, _) | .Reactive(body, _) | .Shield(body, _) | .Defer(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .Live(body, _) | .Transact(_, _, body, _, _) -> {
            sema_compiler_index_walk_stmt_slot(state, "body", body)
        }
        .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .TaskGroup(_, _, _, body, _) | .AssumeDet(_, _, body, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> {
            sema_compiler_index_walk_stmt_slot(state, "body", body)
        }
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "init", init.init)
            sema_compiler_index_walk_expr_slot(state, "condition", condition)
            if step == .Val(step_statement) {
                old_slot := state.slot
                old_list := state.slot_is_list
                state.slot = "afterthought"
                state.slot_is_list = false
                sema_compiler_index_walk_stmt(state, step_statement)
                state.slot = old_slot
                state.slot_is_list = old_list
            }
            sema_compiler_index_walk_stmt_slot(state, "body", body)
        }
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            sema_compiler_index_walk_expr_slot(state, "condition", condition)
            sema_compiler_index_walk_stmt_slot(state, "then_body", then_body)
            if else_body == .Val(body) {
                sema_compiler_index_walk_stmt_slot(state, "else_body", body)
            }
        }
        .ContextBlock(fields, body, _) -> {
            old_slot := state.slot
            old_list := state.slot_is_list
            state.slot = "fields"
            state.slot_is_list = true
            loop field in fields -> sema_compiler_index_walk_expr(state, field.value)
            state.slot = old_slot
            state.slot_is_list = old_list
            sema_compiler_index_walk_stmt_slot(state, "body", body)
        }
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
    }
    _ := state.parents.pop()
}

sema_compiler_index_walk_type_slot: fn(state: ^SemaCompilerIndexWalkState, slot: String, span: Span, is_list: Bool) Never! {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = is_list
    _ := sema_compiler_index_walk_node(state, "type", "type", span)
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_function: fn(state: ^SemaCompilerIndexWalkState, function: Func, body_slot: String) {
    loop fact in sema_arithmetic_policy_facts(function) {
        state.arithmetic.push(sema_compiler_index_arithmetic_fact(fact, state.module_name, state.file))
    }
    loop parameter_index in 0..<function.params.len() {
        sema_compiler_index_walk_type_slot(state, "params", function.params[parameter_index].ty_span, true)
    }
    if function.return_type_span == .Val(span) {
        sema_compiler_index_walk_type_slot(state, "return_type", span, false)
    }
    sema_compiler_index_walk_stmt_slot(state, body_slot, function.body)
}

sema_compiler_index_walk_methods: fn(state: ^SemaCompilerIndexWalkState, methods: [Func]) {
    loop method in methods { sema_compiler_index_walk_function(state, method, "method_bodies") }
}

sema_compiler_index_walk_items_slot: fn(state: ^SemaCompilerIndexWalkState, slot: String, items: [Item]) {
    old_slot := state.slot
    old_list := state.slot_is_list
    state.slot = slot
    state.slot_is_list = true
    loop item in items -> sema_compiler_index_walk_item(state, item)
    state.slot = old_slot
    state.slot_is_list = old_list
}

sema_compiler_index_walk_derive_body: fn(state: ^SemaCompilerIndexWalkState, body: [DeriveBodyItem]) {
    loop body_item in body {
        if body_item == {
            .Item(item) -> { sema_compiler_index_walk_item(state, item) }
            .Stmt(statement) -> { sema_compiler_index_walk_stmt(state, statement) }
            .Loop(_, _, source, nested, _) -> {
                sema_compiler_index_walk_expr(state, source)
                sema_compiler_index_walk_derive_body(state, nested)
            }
            .If(cond, _, then_body, else_body, _) -> {
                sema_compiler_index_walk_expr(state, cond)
                sema_compiler_index_walk_derive_body(state, then_body)
                if else_body == .Val(branch) -> sema_compiler_index_walk_derive_body(state, branch)
            }
        }
    }
}

// A standard family the units prelude injected (owner `core.units`) is a
// catalog copy whose spans index the prelude text, not this module's source:
// it declares nothing written here.
sema_compiler_index_catalog_item: fn(item: Item) -> Bool Never! {
    if item == .UnitFamily(family) -> return family.resolved_owner == Val("core.units")
    false
}

// Whether `candidate` is the symbol a catalog family in `catalog` (its name
// and name span) registered.
sema_compiler_index_catalog_symbol: fn(catalog: [NamedSpan], candidate: Symbol) -> Bool Never! {
    loop named in catalog {
        if named.span.start == candidate.span.start && named.span.end == candidate.span.end && named.name == candidate.name {
            return true
        }
    }
    false
}

sema_compiler_index_walk_item: fn(state: ^SemaCompilerIndexWalkState, item: Item) {
    if sema_compiler_index_catalog_item(item) {
        return
    }
    id: sema_compiler_index_walk_node(state, "item", sema_compiler_index_item_shape(item), sema_compiler_index_item_span(item)) ?? return
    state.parents.push(id)
    if item == {
        .Func(function) -> { sema_compiler_index_walk_function(state, function, "body") }
        .Distinct(definition) -> {
            sema_compiler_index_walk_type_slot(state, "base", definition.base_span, false)
        }
        .TypeAlias(definition) -> {
            sema_compiler_index_walk_type_slot(state, "target", definition.target_span, false)
        }
        .Struct(definition) -> {
            loop field in definition.fields {
                sema_compiler_index_walk_type_slot(state, "field_types", field.ty_span, true)
            }
            old_slot := state.slot
            old_list := state.slot_is_list
            state.slot = "computed_fields"
            state.slot_is_list = true
            loop field in definition.fields {
                if field.computed == .Val(expression) {
                    sema_compiler_index_walk_expr(state, expression)
                }
            }
            state.slot = old_slot
            state.slot_is_list = old_list
            sema_compiler_index_walk_methods(state, definition.methods)
            loop trait_impl in definition.trait_impls {
                sema_compiler_index_walk_methods(state, trait_impl.methods)
            }
        }
        .Enum(definition) -> {
            loop variant in definition.variants {
                if variant.payload == {
                    .Single(_, span) -> {
                        sema_compiler_index_walk_type_slot(state, "variant_types", span, true)
                    }
                    .Named(fields) -> {
                        loop field in fields {
                            sema_compiler_index_walk_type_slot(state, "variant_types", field.ty_span, true)
                        }
                    }
                    .Unit -> {}
                }
                if variant.discriminant_expr == .Val(expression) {
                    sema_compiler_index_walk_expr(state, expression)
                }
            }
            sema_compiler_index_walk_methods(state, definition.methods)
            loop trait_impl in definition.trait_impls {
                sema_compiler_index_walk_methods(state, trait_impl.methods)
            }
        }
        .Impl(definition) -> { sema_compiler_index_walk_methods(state, definition.methods) }
        .Const(definition) -> {
            sema_compiler_index_walk_expr_slot(state, "value", definition.value)
        }
        .Test(definition) -> { sema_compiler_index_walk_stmt_slot(state, "body", definition.body) }
        .ErrorConv(definition) -> {
            sema_compiler_index_walk_stmt_slot(state, "body", definition.body)
        }
        .TemplateLoop(definition) -> {
            sema_compiler_index_walk_expr_slot(state, "source", definition.source)
            old_slot := state.slot
            old_list := state.slot_is_list
            state.slot = "body"
            state.slot_is_list = true
            sema_compiler_index_walk_derive_body(state, definition.body)
            state.slot = old_slot
            state.slot_is_list = old_list
        }
        .CodeModule(definition) -> {
            if definition.body == .Val(items) {
                sema_compiler_index_walk_items_slot(state, "items", items)
            }
        }
        .GenericModule(definition) -> {
            sema_compiler_index_walk_items_slot(state, "body", definition.body)
        }
        .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .Migration(_) | .ProtocolDecl(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    _ := state.parents.pop()
}

sema_compiler_index_param_zone: fn(zone: ParamZone) -> String Never! {
    return if {
        zone == ParamZone.PositionalOnly -> "PositionalOnly"
        zone == ParamZone.LabelOnly -> "LabelOnly"
        else -> "Either"
    }
}

sema_compiler_index_view_source_path: fn(path: ViewSourcePath) -> String Never! {
    source := if path.source == {
        .Receiver -> "receiver"
        .Parameter(index) -> "parameter:{index}"
        .Static(module_path, name) -> "static:{module_path}.{name}"
    }
    projections := [String]{}
    loop projection in path.projections {
        if projection == {
            .Field(name) -> { projections.push("field:{name}") }
            .Index -> { projections.push("index") }
            .Range -> projections.push("range")
        }
    }
    "{source};path:{projections.join("/")}"
}

sema_compiler_index_view_provenance: fn(value: ViewProvenance) -> String Never! {
    access := if value.mutable -> "write" else -> "read"
    sources := [String]{}
    loop source in value.sources -> sources.push(sema_compiler_index_view_source_path(source))
    sources = sema_compiler_index_sorted_strings(sources)
    if sources.len() == 1 {
        parts := sources[0].split(";path:").to_list()
        if parts.len() == 2 -> return "{parts[0]};access:{access};path:{parts[1]}"
    }
    "one_of({sources.join(",")});access:{access}"
}

sema_compiler_index_view_map: fn(map: ViewProvenanceMap?) -> String Never! {
    value: map ?? return ""
    rows := [String]{}
    loop entry in value.entries {
        slot := if entry.slot.len() == 0 -> "$" else -> entry.slot.join(".")
        rows.push("{slot}={sema_compiler_index_view_provenance(entry.value)}")
    }
    rows.join("|")
}

sema_compiler_index_function_signature: fn(function: SemaRegistrationFunction) -> String Never! {
    if function.signature == .Fn(parameters, return_type, _, contract, _, provenance) {
        parameter_names := [String]{}
        loop parameter in parameters -> parameter_names.push(type_name(parameter))
        contracts := [String]{}
        loop index in 0..<parameters.len() {
            label := ""
            zone := ParamZone.Either
            variadic := false
            if index < function.parameters.len() {
                parameter := function.parameters[index]
                label = if parameter.public_label == .Val(value) -> value else -> parameter.name
                zone = parameter.zone
                variadic = parameter.variadic
            }
            if contract == .Val(rows) && index < rows.len() {
                label = rows[index].label
                zone = rows[index].zone
            }
            contracts.push("{label}:{sema_compiler_index_param_zone(zone)}:{variadic}")
        }
        ret := if return_type == .Val(value) -> type_name(value) else -> "()"
        view := sema_compiler_index_view_map(provenance)
        return "({parameter_names.join(",")})->{ret};call_contract=[{contracts.join(",")}];view_source={view}"
    }
    type_name(function.signature)
}

// A function's signature is its own: a module function's, a foreign one's
// type, or a method's of the nominal or the impl that declares it.
sema_compiler_index_definition_signature: fn(symbol: Symbol, registered_module: SemaRegistrationModule, registration: SemaRegistrationGraph) -> String Never! {
    if symbol.kind == SymbolKind.Function {
        loop function in registered_module.functions {
            if function.symbol.id == symbol.id {
                return sema_compiler_index_function_signature(function)
            }
        }
        loop function in registered_module.foreign_functions {
            if function.symbol.id == symbol.id {
                if function.symbol.ty == .Val(ty) -> return type_name(ty)
            }
        }
        loop nominal in registered_module.nominals {
            loop method in nominal.methods {
                if method.symbol.id == symbol.id {
                    return sema_compiler_index_function_signature(method)
                }
            }
        }
        loop implementation in registered_module.impls {
            loop method in implementation.methods {
                if method.symbol.id == symbol.id {
                    return sema_compiler_index_function_signature(method)
                }
            }
        }
    }
    if symbol.kind == SymbolKind.Type {
        loop nominal in registered_module.nominals {
            if nominal.symbol.id != symbol.id -> next
            if nominal.kind == SemaRegistrationNominalKind.Struct {
                fields := [String]{}
                loop field in nominal.fields -> fields.push(type_name(field.ty))
                return "{{{fields.join(",")}}}"
            }
            if nominal.kind == SemaRegistrationNominalKind.Enum {
                return "variants:{nominal.variants.len()}"
            }
        }
    }
    sema_compiler_index_definition_kind(symbol, registration)
}

sema_compiler_index_derivation_definition_eligible: fn(symbol: Symbol) -> Bool Never! {
    if symbol.kind == SymbolKind.Local || symbol.kind == SymbolKind.Parameter || symbol.kind == SymbolKind.Field || symbol.kind == SymbolKind.Variant {
        return false
    }
    true
}

sema_compiler_index_source_fragment: fn(source: String, span: Span) -> String? {
    bytes := source.bytes()
    if span.start < 0 || span.end < span.start || span.end > bytes.len() -> return None
    text: String.from_bytes(bytes.slice(span.start, span.end)) ?? return None
    Val(text)
}

sema_compiler_index_normalize_definition: fn(source: String) -> String Never! {
    bytes := source.bytes()
    output := [U8]{}
    in_string := false
    index := 0
    loop index < bytes.len() {
        code := Int{bytes[index]}
        if in_string {
            output.push(bytes[index])
            if code == 34 -> in_string = false
            index += 1
            next
        }
        if code == 34 {
            in_string = true
            output.push(bytes[index])
            index += 1
            next
        }
        if code == 47 && index + 1 < bytes.len() && (Int{bytes[index + 1]}) == 47 {
            index += 2
            loop index < bytes.len() && (Int{bytes[index]}) != 10 -> index += 1
            next
        }
        if code != 9 && code != 10 && code != 11 && code != 12 && code != 13 && code != 32 {
            output.push(bytes[index])
        }
        index += 1
    }
    String.from_bytes(output) ?? source
}

// `missing` names the first item whose derivation could not be read ("" when complete).
SemaCompilerIndexDerivationFacts: struct {
    value: TComptimeValue,
    missing: String,
}

sema_compiler_index_derivation_value: fn(record: DerivationRecord) -> TComptimeValue Never! {
    method := if {
        record.method == DerivationMethod.StaticDerivation -> "static_derivation"
        record.method == DerivationMethod.FormalProof -> "formal_proof"
        record.method == DerivationMethod.RecordedExecution -> "recorded_execution"
        record.method == DerivationMethod.SampledAgreement -> "sampled_agreement"
        else -> "external_assumption"
    }
    disposition := if {
        record.disposition == DerivationDisposition.Current -> "current"
        record.disposition == DerivationDisposition.Stale -> "stale"
        record.disposition == DerivationDisposition.Expired -> "expired"
        record.disposition == DerivationDisposition.Redacted -> "redacted"
        record.disposition == DerivationDisposition.Unavailable -> "unavailable"
        record.disposition == DerivationDisposition.Unsupported -> "unsupported"
        record.disposition == DerivationDisposition.BudgetExhausted -> "budget_exhausted"
        else -> "unknown"
    }
    observation := TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Named{name: "CompilerDerivationObservation"}}}
    if record.observation == .Val(value) {
        observation = TComptimeValue.Present{
            value: TComptimeValue.Struct{
                type_name: "CompilerDerivationObservation",
                fields: [TComptimeField]{
                    TComptimeField{name: "counterexample", value: sema_compiler_index_option_string(value.counterexample_id)},
                    TComptimeField{name: "event", value: sema_compiler_index_option_string(value.event_id)},
                },
            },
        }
    }
    payload := TComptimeValue.Failed{report: TComptimeReport.Clean{ty: Type.Named{name: "CompilerDerivationPayload"}}}
    if record.payload == .Val(value) {
        payload = TComptimeValue.Present{
            value: TComptimeValue.Struct{
                type_name: "CompilerDerivationPayload",
                fields: [TComptimeField]{
                    TComptimeField{name: "kind", value: sema_compiler_index_string(derivation_payload_kind(value))},
                    TComptimeField{name: "json", value: sema_compiler_index_string(derivation_payload_json(value))},
                },
            },
        }
    }
    TComptimeValue.Struct{
        type_name: "CompilerDerivationRecord",
        fields: [TComptimeField]{
            TComptimeField{name: "id", value: sema_compiler_index_string(record.id)},
            TComptimeField{name: "subject", value: sema_compiler_index_string(record.subject)},
            TComptimeField{name: "claim", value: sema_compiler_index_string(record.claim)},
            TComptimeField{name: "producer", value: sema_compiler_index_string(record.producer)},
            TComptimeField{name: "method", value: sema_compiler_index_string(method)},
            TComptimeField{name: "rule", value: sema_compiler_index_string(record.rule)},
            TComptimeField{name: "premises", value: sema_compiler_index_strings(record.premises)},
            TComptimeField{
                name: "identity",
                value: TComptimeValue.Struct{
                    type_name: "CompilerDerivationIdentity",
                    fields: [TComptimeField]{
                        TComptimeField{name: "source", value: sema_compiler_index_string(record.identity.source)},
                        TComptimeField{name: "build", value: sema_compiler_index_string(record.identity.build)},
                        TComptimeField{name: "run", value: sema_compiler_index_string(record.identity.run)},
                        TComptimeField{name: "target", value: sema_compiler_index_string(record.identity.target)},
                    },
                },
            },
            TComptimeField{name: "assumptions", value: sema_compiler_index_strings(record.assumptions)},
            TComptimeField{name: "disposition", value: sema_compiler_index_string(disposition)},
            TComptimeField{name: "observation", value: observation},
            TComptimeField{name: "payload", value: payload},
        },
    }
}

// The symbol kind a top-level item of this shape declares, so a struct's
// record never credits a symbol the compiler made at its name; None lets any
// definition the item spans name it.
sema_compiler_index_derivation_item_kind: fn(item: Item) -> SymbolKind? Never! {
    if item == .Func(_) -> return Val(SymbolKind.Function)
    if item == .Struct(_) || item == .Enum(_) -> return Val(SymbolKind.Type)
    None
}

// Appends the record of `definition`, declared by the text at `span`, unless
// a record already credits it; a text outside the source sets `missing`
// when it is still "".
sema_compiler_index_derivation_push: fn(registration: SemaRegistrationGraph, registered_module: SemaRegistrationModule, source: String, definition: Symbol, span: Span, records: ^[DerivationRecord], credited: ^[U32:Bool], missing: ^String) Never! {
    // Keyed by the symbol id: equal ids are equal keys, so no key text is
    // resolved for a definition already credited.
    if credited.get(definition.id.id) != None {
        return
    }
    definition_key: symbol_table_key(registration.symbols, definition.id)
    definition_source: sema_compiler_index_source_fragment(source, span) ?? {
        if missing == "" {
            missing = "`{definition_key}` at {span.start}..{span.end} lies outside the {source.count_bytes()}-byte source of `{module_text(registration.module_table, registered_module.module_identity)}`"
        }
        return
    }
    credited[definition.id.id] = true
    kind := sema_compiler_index_definition_kind(definition, registration)
    structural_key := "{kind}|{definition_key}"
    stable_id := "def:{sha256_hex(structural_key).slice(0, 16)}"
    signature := sema_compiler_index_definition_signature(definition, registered_module, registration)
    signature_key := "{kind}|{signature}"
    signature_id := "sig:{sha256_hex(signature_key).slice(0, 16)}"
    normalized := sema_compiler_index_normalize_definition(definition_source)
    content_id := "sha256:{sha256_hex(normalized)}"
    record := derivation_record(
        stable_id,
        sema_compiler_identity(registration, definition_key),
        "jet-sema",
        DerivationMethod.StaticDerivation,
        "checked-definition",
        [String]{signature_id.copy(), content_id.copy()},
        derivation_identity(content_id, signature_id, "", registered_module.module_path),
    )
    records.push(record)
}

// One record per written declaration, credited to the definition it declares
// and read from that declaration's own text: each top-level item but an impl,
// each impl, and each method of a nominal or an impl. A compiler-made impl
// (the serde codecs; a derive's or a template's, whose span is its type's
// name) or method has no text of its own: its owner's record covers it. Nor
// has a catalog family the units prelude injected: its spans index the
// prelude text, so neither it nor the symbol it registered is credited here.
sema_compiler_index_derivations: fn(registration: SemaRegistrationGraph, module_sources: [SemaCompilerModuleSource]) -> SemaCompilerIndexDerivationFacts Never! {
    records := [DerivationRecord]{}
    credited := [U32:Bool]{}
    missing := ""
    loop module_index in 0..<registration.modules.len() {
        registered_module: registration.modules[module_index]
        if registered_module.program.items.len() == 0 && registered_module.impls.len() == 0 -> next
        source: sema_compiler_index_module_source(module_sources, registered_module.module_identity) ?? {
            if missing == "" {
                missing = "module `{module_text(registration.module_table, registered_module.module_identity)}` has no source"
            }
            next
        }
        catalog := [NamedSpan]{}
        loop item in registered_module.program.items {
            if item == .UnitFamily(family) && sema_compiler_index_catalog_item(item) {
                catalog.push(NamedSpan{name: family.family, span: family.family_span})
            }
        }
        loop item in registered_module.program.items {
            if item == .Impl(_) || sema_compiler_index_catalog_item(item) -> next
            span := sema_compiler_index_item_span(item)
            item_kind := sema_compiler_index_derivation_item_kind(item)
            symbol := Symbol?{None}
            loop candidate in registered_module.symbols {
                if !sema_compiler_index_derivation_definition_eligible(candidate) -> next
                if item_kind == .Val(kind) && candidate.kind != kind -> next
                if candidate.span.start < span.start || candidate.span.end > span.end -> next
                if catalog.len() > 0 && sema_compiler_index_catalog_symbol(catalog, candidate) {
                    next
                }
                if {
                    symbol == None -> { symbol = Val(candidate) }
                    else -> {
                        current: symbol ?? candidate
                        if candidate.span.start < current.span.start -> symbol = Val(candidate)
                    }
                }
            }
            definition: symbol ?? next
            sema_compiler_index_derivation_push(registration, registered_module, source, definition, span, records, credited, missing)
        }
        loop nominal in registered_module.nominals {
            loop method in nominal.methods {
                if method.declaration.compiler_generated -> next
                sema_compiler_index_derivation_push(registration, registered_module, source, method.symbol, method.declaration.span, records, credited, missing)
            }
        }
        loop implementation in registered_module.impls {
            made := implementation.compiler_generated || (implementation.declaration.span.start == implementation.declaration.type_span.start && implementation.declaration.span.end == implementation.declaration.type_span.end)
            if made -> next
            sema_compiler_index_derivation_push(registration, registered_module, source, implementation.symbol, implementation.declaration.span, records, credited, missing)
            loop method in implementation.methods {
                if method.declaration.compiler_generated -> next
                sema_compiler_index_derivation_push(registration, registered_module, source, method.symbol, method.declaration.span, records, credited, missing)
            }
        }
    }
    // Stable, as the insertion sort this replaces: equal (subject, claim) keep record order.
    records.sort_by(fn(left: DerivationRecord, right: DerivationRecord) { (left.subject <=> right.subject).then(left.claim <=> right.claim) })
    values := [TComptimeValue]{}
    loop record in records -> values.push(sema_compiler_index_derivation_value(record))
    SemaCompilerIndexDerivationFacts{value: TComptimeValue.List{values: values}, missing: missing}
}

// Function key -> the view provenance values of the first checked function
// with that key (module, then declaration, order), at the key's id in `keys`,
// built once per index. Row 0 is the empty list a definition that is no
// function reads.
SemaCompilerIndexViews: struct {
    keys: NameTable{name_table()},
    rows: [TComptimeValue]{[TComptimeValue]{TComptimeValue.List{values: [TComptimeValue]{}}}},
}

sema_compiler_index_function_views: fn(graph: SemaGraphResult) -> SemaCompilerIndexViews Never! {
    views := SemaCompilerIndexViews{}
    loop checked_module in graph.modules {
        loop function in checked_module.functions {
            if name_index(name_intern(views.keys, function.key)) == views.rows.len() {
                views.rows.push(sema_compiler_index_view_provenance_values(function.return_view_provenance))
            }
        }
    }
    views
}

sema_compiler_index_view: fn(views: SemaCompilerIndexViews, key: String) -> TComptimeValue Never! {
    id: name_find(views.keys, key) ?? return views.rows[0]
    views.rows[name_index(id)]
}

// One definition, once, under its key text: `local_key` for a body's local
// (its body's own symbols hold it), else the run's key of `symbol`.
sema_compiler_index_append_definition: fn(registration: SemaRegistrationGraph, caller: Int, symbol: Symbol, local_key: String?, views: SemaCompilerIndexViews, definitions: ^[TComptimeValue], seen: ^NameTable) {
    key := local_key ?? symbol_table_key(registration.symbols, symbol.id)
    if name_find(seen, key) != None {
        return
    }
    _ := name_intern(seen, key)
    definitions.push(sema_compiler_index_definition(registration, key, caller, symbol, sema_compiler_index_view(views, key)))
}

// The key of `id` in a checked body: a run-wide id's in `symbols`, a local's
// in the body's own `locals`. A local id outside `locals` names some other
// body's row: it is refused as one row of `refused` (every one is listed) and
// has no key, never read past the keys.
sema_compiler_index_body_key: fn(symbols: SymbolTable, locals: SymbolLocalKeys, id: SymbolID, name: String, span: Span, owner: String, refused: ^[String]) -> String? Never! {
    if !symbol_is_local(id) -> return Val(symbol_table_key(symbols, id))
    if symbol_local_keys_text_at(locals, id) == .Val(key) -> return Val(key)
    refused.push("`{name}` at offset {span.start} in `{owner}`: local row {symbol_local_row(id)} is outside the body's {symbol_local_keys_count(locals)} keys")
    None
}

// The row in its module's functions of the body that recorded a local
// reference (SemaNameReferenceFact.body), by `keys` and `rows` as
// sema_compiler_semantic_index_from_checked builds them; every index is
// bounds-checked. A body with no row (an empty key, or one no checked body
// of the module has) is refused as one row of `refused` and has no row.
sema_compiler_index_body_row: fn(keys: NameTable, rows: [Int], body: String, name: String, span: Span, refused: ^[String]) -> Int? Never! {
    if name_find(keys, body) == .Val(found) {
        at: name_index(found)
        if at > 0 && at < rows.len() -> return Val(rows[at])
    }
    refused.push("`{name}` at offset {span.start}: its body `{body}` has no checked row")
    None
}

// A checked body's local, keyed in the body's own symbols `locals`.
sema_compiler_index_append_checked_local: fn(local: TLocal, locals: SymbolLocalKeys, module_identity: ModuleID, owner: String, registration: SemaRegistrationGraph, caller: Int, views: SemaCompilerIndexViews, definitions: ^[TComptimeValue], seen: ^NameTable, refused: ^[String]) {
    local_id: local.symbol_id ?? return
    key: sema_compiler_index_body_key(registration.symbols, locals, local_id, local.name, local.span, owner, refused) ?? return
    symbol := Symbol{id: local_id, kind: SymbolKind.Local, name: local.name, module_identity: module_identity, owner: Val(owner), span: local.span, ty: None, visibility: 0}
    sema_compiler_index_append_definition(registration, caller, symbol, Val(key), views, definitions, seen)
}

sema_compiler_index_collect_checked_locals: fn(function: FnBody, module_identity: ModuleID, owner: String, registration: SemaRegistrationGraph, caller: Int, views: SemaCompilerIndexViews, definitions: ^[TComptimeValue], seen: ^NameTable, refused: ^[String]) {
    loop statement in function.body {
        if function.tree.stmts[statement] == {
            .Let(local, _, _, _, _, _) -> {
                sema_compiler_index_append_checked_local(local, function.tree.symbols, module_identity, owner, registration, caller, views, definitions, seen, refused)
            }
            .TupleDestructure(temp, _, _, binds, _) -> {
                sema_compiler_index_append_checked_local(temp, function.tree.symbols, module_identity, owner, registration, caller, views, definitions, seen, refused)
                loop bind in binds {
                    sema_compiler_index_append_checked_local(bind.local, function.tree.symbols, module_identity, owner, registration, caller, views, definitions, seen, refused)
                }
            }
            .StructDestructure(temp, _, _, binds, _) -> {
                sema_compiler_index_append_checked_local(temp, function.tree.symbols, module_identity, owner, registration, caller, views, definitions, seen, refused)
                loop bind in binds {
                    sema_compiler_index_append_checked_local(bind.local, function.tree.symbols, module_identity, owner, registration, caller, views, definitions, seen, refused)
                }
            }
            .ListDestructure(temp, _, _, _, elements, _) -> {
                sema_compiler_index_append_checked_local(temp, function.tree.symbols, module_identity, owner, registration, caller, views, definitions, seen, refused)
                loop local in elements {
                    sema_compiler_index_append_checked_local(local, function.tree.symbols, module_identity, owner, registration, caller, views, definitions, seen, refused)
                }
            }
            .Contract(_) | .ContractScope(_, _, _, _, _) | .RefutableBind(_, _, _, _) | .Assign(_, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .ForRange(_, _, _, _, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .ExprStmt(_, _) | .Return(_, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .If(_, _, _, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .Match(_, _, _, _) | .EnumMatch(_, _, _, _, _) | .RangeSwitch(_, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _, _) | .Inline(_, _) | .DebugOnly(_, _) | .DeepCheck(_, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .UnsafeBlock(_, _, _) | .SentryPolicy(_, _, _) | .Impure(_, _) | .Reactive(_, _) | .Region(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .Shield(_, _) | .Defer(_, _) | .ScopeMember(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> {}
        }
    }
}

// `source_digest` is the digest of the checked entry text, which the caller
// takes once for the index and the diagnostics' origins alike.
sema_compiler_semantic_index_from_checked: fn(registration: SemaRegistrationGraph, graph: SemaGraphResult, source_digest: String, module_sources: [SemaCompilerModuleSource]) -> SemaCompilerSemanticIndexFacts {
    definitions := [TComptimeValue]{}
    definition_keys := name_table()
    function_views: sema_compiler_index_function_views(graph)
    references := [TComptimeValue]{}
    calls := [TComptimeValue]{}
    effects := [TComptimeValue]{}
    outputs := [TComptimeValue]{}
    state_graphs := [TComptimeValue]{}
    // Every local the index could not key in its body (sema_compiler_index_body_key).
    refused := [String]{}
    loop registered_module_index in 0..<registration.modules.len() {
        loop symbol_index in 0..<registration.modules[registered_module_index].symbols.len() {
            sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].symbols[symbol_index], None, function_views, definitions, definition_keys)
        }
        loop nominal_index in 0..<registration.modules[registered_module_index].nominals.len() {
            sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].nominals[nominal_index].symbol, None, function_views, definitions, definition_keys)
            loop field_index in 0..<registration.modules[registered_module_index].nominals[nominal_index].fields.len() {
                sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].nominals[nominal_index].fields[field_index].symbol, None, function_views, definitions, definition_keys)
            }
            loop variant_index in 0..<registration.modules[registered_module_index].nominals[nominal_index].variants.len() {
                sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].nominals[nominal_index].variants[variant_index].symbol, None, function_views, definitions, definition_keys)
            }
            loop method_index in 0..<registration.modules[registered_module_index].nominals[nominal_index].methods.len() {
                sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].nominals[nominal_index].methods[method_index].symbol, None, function_views, definitions, definition_keys)
            }
            loop method_index in 0..<registration.modules[registered_module_index].nominals[nominal_index].trait_methods.len() {
                sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].nominals[nominal_index].trait_methods[method_index].symbol, None, function_views, definitions, definition_keys)
            }
        }
        loop implementation_index in 0..<registration.modules[registered_module_index].impls.len() {
            sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].impls[implementation_index].symbol, None, function_views, definitions, definition_keys)
            loop method_index in 0..<registration.modules[registered_module_index].impls[implementation_index].methods.len() {
                sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].impls[implementation_index].methods[method_index].symbol, None, function_views, definitions, definition_keys)
            }
            loop associated_index in 0..<registration.modules[registered_module_index].impls[implementation_index].associated_types.len() {
                sema_compiler_index_append_definition(registration, registered_module_index, registration.modules[registered_module_index].impls[implementation_index].associated_types[associated_index].symbol, None, function_views, definitions, definition_keys)
            }
        }
        loop constant_index in 0..<registration.modules[registered_module_index].constants.len() {
            if registration.modules[registered_module_index].constants[constant_index].declaration.resolved_output == .Val(output) {
                solved := output.copy()
                loop fact in graph.outputs {
                    if fact.address == output.address && fact.module_id == output.module_id && fact.reference == output.reference {
                        solved = fact
                        break
                    }
                }
                outputs.push(sema_compiler_index_output_value(solved, registration.modules[registered_module_index].constants[constant_index].declaration, registration, registered_module_index))
            }
        }
        graph_facts := sema_state_graph_facts(registration.modules[registered_module_index].program.items)
        loop fact in graph_facts {
            definition := StructDef?{None}
            loop item_index in 0..<registration.modules[registered_module_index].program.items.len() {
                if registration.modules[registered_module_index].program.items[item_index] == .Struct(value) && value.name == fact.type_name {
                    definition = Val(value)
                    break
                }
            }
            if definition == .Val(value) {
                state_graphs.push(sema_compiler_index_state_graph_value(fact, value, registration.modules[registered_module_index].module_name, registration.modules[registered_module_index].source_file))
            }
        }
    }
    loop checked_module in graph.modules {
        module_index: sema_registration_module_index(registration, checked_module.module_identity) ?? next
        registered_module: registration.modules[module_index]
        // A local's key is in the symbols of the body whose check recorded
        // the reference (SemaNameReferenceFact.body), found by that body's
        // key; the first body of a key is the one its references were
        // checked in (a keep-going trap of a cached body follows it). A span
        // names no body: a generated body's span overlaps other bodies'.
        // Name 0 is the empty spelling, which keys no body.
        body_keys := name_table()
        body_rows := [Int]{-1}
        loop (row, function) in checked_module.functions {
            if name_index(name_intern(body_keys, function.key)) == body_rows.len() {
                body_rows.push(row)
            }
        }
        loop reference in checked_module.name_references {
            target_index := sema_registration_module_index(registration, reference.symbol.module_identity) ?? module_index
            key := String?{None}
            parameter_type := Type?{None}
            if !symbol_is_local(reference.symbol.id) {
                key = Val(symbol_table_key(registration.symbols, reference.symbol.id))
            } else if sema_compiler_index_body_row(body_keys, body_rows, reference.body, reference.symbol.name, reference.span, refused) == .Val(body) {
                key = sema_compiler_index_body_key(registration.symbols, checked_module.functions[body].tree.symbols, reference.symbol.id, reference.symbol.name, reference.span, checked_module.functions[body].key, refused)
                if reference.symbol.kind == SymbolKind.Parameter {
                    parameter_type = sema_compiler_index_parameter_type(checked_module.functions[body], reference.symbol.id)
                }
            }
            if key != None {
                sema_compiler_index_append_definition(registration, target_index, sema_compiler_index_referent_symbol(reference.symbol, parameter_type), key, function_views, definitions, definition_keys)
            }
            references.push(sema_compiler_index_reference(reference, key, registration, registered_module.module_name, registered_module.source_file))
        }
        loop function in checked_module.functions {
            effects.push(sema_compiler_index_effect(function, registration, registered_module.source_file))
            loop parameter in function.params {
                parameter_id: parameter.local.symbol_id ?? next
                parameter_symbol := Symbol{id: parameter_id, kind: SymbolKind.Parameter, name: parameter.name, module_identity: checked_module.module_identity, owner: Val(function.key), span: parameter.span, ty: Val(parameter.ty), visibility: 0}
                parameter_key: sema_compiler_index_body_key(registration.symbols, function.tree.symbols, parameter_id, parameter.name, parameter.span, function.key, refused) ?? next
                sema_compiler_index_append_definition(registration, module_index, parameter_symbol, Val(parameter_key), function_views, definitions, definition_keys)
            }
            sema_compiler_index_collect_checked_locals(function, checked_module.module_identity, function.key, registration, module_index, function_views, definitions, definition_keys, refused)
        }
        loop call in checked_module.call_facts {
            value: sema_compiler_index_call(call, registration, registered_module.module_name, registered_module.source_file) ?? next
            calls.push(value)
        }
    }
    walk := sema_compiler_index_walk_state()
    loop registered_module_index in 0..<registration.modules.len() {
        walk.file = registration.modules[registered_module_index].source_file
        walk.module_name = registration.modules[registered_module_index].module_name
        sema_compiler_index_walk_items_slot(walk, "root", registration.modules[registered_module_index].program.items)
    }
    derivations := sema_compiler_index_derivations(registration, module_sources)
    missing := if !registration.complete -> "the registration graph is incomplete" else if !graph.complete -> "the checked graph is incomplete" else -> sema_compiler_index_module_sources_missing(registration, module_sources)
    loop registered_module_index in 0..<registration.modules.len() {
        found := false
        loop checked_module in graph.modules {
            if checked_module.module_identity == registration.modules[registered_module_index].module_identity {
                found = true
                break
            }
        }
        if !found && missing == "" {
            missing = "registered module `{module_text(registration.module_table, registration.modules[registered_module_index].module_identity)}` has no checked result"
        }
    }
    loop checked_module in graph.modules {
        found := false
        loop registered_module_index in 0..<registration.modules.len() {
            if checked_module.module_identity == registration.modules[registered_module_index].module_identity {
                found = true
                break
            }
        }
        if !found && missing == "" {
            missing = "checked module `{module_text(registration.module_table, checked_module.module_identity)}` is not registered"
        }
    }
    if derivations.missing != "" && missing == "" -> missing = "derivations: {derivations.missing}"
    if refused.len() > 0 && missing == "" {
        missing = "{refused.len()} local references are outside their body's keys: {refused.join("; ")}"
    }
    index := TComptimeValue.Struct{
        type_name: "CompilerSemanticIndex",
        fields: [TComptimeField]{
            TComptimeField{name: "schema_version", value: sema_compiler_index_int(20)},
            TComptimeField{name: "source_digest", value: sema_compiler_index_string(source_digest)},
            TComptimeField{name: "definitions", value: TComptimeValue.List{values: definitions}},
            TComptimeField{name: "references", value: TComptimeValue.List{values: references}},
            TComptimeField{name: "calls", value: TComptimeValue.List{values: calls}},
            TComptimeField{name: "structural_nodes", value: TComptimeValue.List{values: walk.nodes}},
            TComptimeField{name: "effects", value: TComptimeValue.List{values: effects}},
            TComptimeField{name: "arithmetic", value: TComptimeValue.List{values: walk.arithmetic}},
            TComptimeField{name: "outputs", value: TComptimeValue.List{values: outputs}},
            TComptimeField{name: "state_graphs", value: TComptimeValue.List{values: state_graphs}},
            TComptimeField{name: "fact_registry", value: sema_compiler_index_fact_registry(registration)},
            TComptimeField{name: "derivations", value: derivations.value},
        },
    }
    SemaCompilerSemanticIndexFacts{value: index, complete: missing == "", missing: missing}
}
