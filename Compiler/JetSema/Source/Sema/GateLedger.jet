// One compile-time gate read model. Source markers and policy remain the writers.
use jet_foundation.[Span, GateDiagnostic, GateEntry, GateKind, GateOperation, NameLedger, BuildFactSnapshot, Expr, Func, Item, ProgramBundle, Stmt, StrPart, Type, DeriveBodyItem, ContribValue, CallArg]
use jet_foundation.Authority as Authority
use jet_foundation.Syntax as Syntax
use jet_sema.Traits.[TraitRegistry]
use jet_sema.Generics.[CHECKED_TEXT]
use jet_sema.Policy.[GateSet]
use jet_sema.Sema.UnsafeObligations.[inspect_with_gates, UnsafeGateInspection, nested_bodies]

// Rust: crates/jet-sema/src/Sema/GateLedger.rs:14
pub struct GateLedger {
    inner: Authority.GateLedger
    pub fn default() -> GateLedger Never! { GateLedger{inner: Authority.GateLedger.default()} }
    // Rust: crates/jet-sema/src/Sema/GateLedger.rs:22
    pub fn collect(bundle: ProgramBundle, gates: GateSet) -> GateLedger Never! {
        inspection :: inspect_with_gates(bundle, gates)
        checked_text_types :: checked_text_type_names(bundle)
        context :: GateContext{checked_text_types: checked_text_types, unsafe_gates: inspection.gates}
        ledger := GateLedger.default()
        loop gate in inspection.gates {
            discharged :: gate.operations.all(fn(operation) { operation.discharged })
            provenance := gate.provenance
            &provenance.push("{gate.source}:{gate.span.start}..{gate.span.end}")
            operations :: loop operation in gate.operations -> GateOperation{kind: operation.kind, span: operation.span, required: operation.required, asserted: operation.asserted, discharged: operation.discharged}
            &ledger.push(GateEntry{kind: GateKind.Unsafe, domain: "security", scope: "source", source: gate.source, span: Val(gate.span), subject: "#Unsafe", reason: gate.reason, status: Val(if discharged -> "discharged" else -> "missing"), detail: "mode={gate.mode}", provenance: provenance, operations: operations})
        }
        &ledger.set_diagnostics(loop entry in inspection.diagnostics -> GateDiagnostic{source: entry.source, diagnostic: entry.diagnostic})
        loop module in bundle.modules {
            visit_statements(module.display, module.script_body, &ledger, context)
            visit_items(module.display, module.items, &ledger, context)
        }
        append_fact_gates(&ledger, bundle.build_facts)
        &ledger.append_structure_facts(bundle.name_ledger)
        &ledger.sort()
        ledger
    }
    // Rust: crates/jet-sema/src/Sema/GateLedger.rs:83
    pub fn entries(self) -> [GateEntry].View Never! { self.inner.entries() }
    // Rust: crates/jet-sema/src/Sema/GateLedger.rs:87
    pub fn diagnostics(self) -> [GateDiagnostic].View Never! { self.inner.diagnostics() }
    // Rust: crates/jet-sema/src/Sema/GateLedger.rs:91
    pub fn set_diagnostics(&self, diagnostics: [GateDiagnostic]) Never! { &self.inner.set_diagnostics(diagnostics) }
    // Rust: crates/jet-sema/src/Sema/GateLedger.rs:97
    pub fn push(&self, entry: GateEntry) Never! { &self.inner.push(entry) }
    // Rust: crates/jet-sema/src/Sema/GateLedger.rs:101
    pub fn sort(&self) Never! { &self.inner.sort() }
    // Rust: crates/jet-sema/src/Sema/GateLedger.rs:108
    pub fn append_structure_facts(&self, facts: NameLedger) Never! {
        loop fact in facts.structure_facts() {
            gate :: fact.gate ?? next
            &self.push(GateEntry{kind: GateKind.Structure, domain: "structure", scope: fact.kind.name(), source: fact.source, span: Val(fact.span), subject: fact.subject, reason: Val(gate), status: Val(fact.status), detail: fact.detail, provenance: ["{fact.source}:{fact.span.start}..{fact.span.end}"], operations: []})
        }
    }
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:137
fn append_fact_gates(ledger: &GateLedger, facts: BuildFactSnapshot) Never! {
    loop fact in facts.contributions.values() {
        loop contribution in fact.provenance {
            if !contribution.force -> next
            &ledger.push(GateEntry{kind: GateKind.BuildFlag, domain: "build", scope: contribution.layer.name(), source: contribution.source, span: Val(contribution.span), subject: fact.key.name, reason: Val(contribution.force_reason ?? ".Force"), status: Val("recorded"), detail: ".Force {contribution.value.display()}", provenance: ["{contribution.source}:{contribution.span.start}..{contribution.span.end}"], operations: []})
        }
    }
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:167
fn source_entry(kind: GateKind, domain: String, scope: String, source: String, span: Span, subject: String, reason: String?, detail: String, status: String) -> GateEntry Never! {
    GateEntry{kind: kind, domain: domain, scope: scope, source: source, span: Val(span), subject: subject, reason: reason, status: Val(status), detail: detail, provenance: ["{source}:{span.start}..{span.end}"], operations: []}
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:193
struct GateContext { checked_text_types: [String:Bool], unsafe_gates: [UnsafeGateInspection] }
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:198
fn checked_text_type_names(bundle: ProgramBundle) -> [String:Bool] Never! {
    registries :: TraitRegistry.bundle_auto_derives(bundle, bundle.name_ledger)
    names := [String:Bool]{}
    loop registry in registries {
        loop (name, base) in registry.distinct_bases {
            if base == Type.String && registry.implements_trait(name, CHECKED_TEXT) -> names[name] = true
        }
    }
    names
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:213
fn visit_items(source: String, items: [Item], ledger: &GateLedger, context: GateContext) Never! {
    loop item in items {
        if item == {
            .Func(function) -> visit_function(source, function, &ledger, context)
            .Const(constant) -> visit_expression(source, constant.value, &ledger, context)
            .Struct(definition) -> {
                loop function in definition.methods -> visit_function(source, function, &ledger, context)
                loop implementation in definition.trait_impls {
                    loop function in implementation.methods -> visit_function(source, function, &ledger, context)
                }
                visit_statements(source, definition.validate_block, &ledger, context)
                loop field in definition.fields {
                    if field.computed == .Val(expression) -> visit_expression(source, expression, &ledger, context)
                    if field.default == .Val(expression) -> visit_expression(source, expression, &ledger, context)
                }
            }
            .Enum(definition) -> {
                loop function in definition.methods -> visit_function(source, function, &ledger, context)
                loop implementation in definition.trait_impls {
                    loop function in implementation.methods -> visit_function(source, function, &ledger, context)
                }
            }
            .Impl(implementation) -> { loop function in implementation.methods -> visit_function(source, function, &ledger, context) }
            .Test(test) -> visit_statements(source, test.body, &ledger, context)
            .CodeModule(module) -> { if module.body == .Val(body) -> visit_items(source, body, &ledger, context) }
            .GenericModule(module) -> visit_items(source, module.body, &ledger, context)
            .Module(module) -> {
                loop expression in module.imports -> visit_expression(source, expression, &ledger, context)
                loop expression in module.members -> visit_expression(source, expression, &ledger, context)
                loop contribution in module.contributions {
                    if contribution.value == .Expr(expression) -> visit_expression(source, expression, &ledger, context)
                }
            }
            .MarkerDecl(marker) -> { if marker.body == .Val(body) -> visit_template_body(source, body, &ledger, context) }
            else -> {}
        }
    }
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:286
fn visit_template_body(source: String, body: [DeriveBodyItem], ledger: &GateLedger, context: GateContext) Never! {
    loop body_item in body {
        if body_item == {
            .Stmt(statement) -> visit_statements(source, [statement], &ledger, context)
            .Item(item) -> visit_items(source, [item], &ledger, context)
            .Loop{source: expression, body, ..} -> {
                visit_expression(source, expression, &ledger, context)
                visit_template_body(source, body, &ledger, context)
            }
        }
    }
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:312
fn visit_function(source: String, function: Func, ledger: &GateLedger, context: GateContext) Never! {
    if function.state_transition == .Val(transition) {
        from :: transition.from ?? "_"
        spelling :: "#Transition({from}, {transition.to})"
        &ledger.push(source_entry(GateKind.StateTransition, "knowledge", "function", source, transition.span, spelling, Val(spelling), "state transition {from} -> {transition.to}", "recorded"))
    }
    if function.scrub_tag == .Val(tag) {
        span :: function.markers.find(fn(marker) { marker.name == Syntax.KW_SCRUB }).map(fn(marker) { marker.span }) ?? function.name_span
        &ledger.push(source_entry(GateKind.TaintScrub, "knowledge", "function", source, span, "#Scrub({tag})", None, "taint removed: {tag}", "cleared"))
    }
    loop marker in function.markers {
        gate :: if marker.name == {
            Syntax.MARKER_NONDETERMINISTIC -> (GateKind.Nondeterministic, "#Nondeterministic", "determinism escape")
            Syntax.KW_IMPURE -> (GateKind.Impure, "#Impure", "impure function")
            else -> next
        }
        &ledger.push(source_entry(gate.0, "security", "function", source, marker.span, gate.1, literal_text(marker.expr_arg(0)), gate.2, "recorded"))
    }
    visit_statements(source, function.body, &ledger, context)
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:380
fn visit_statements(source: String, body: [Stmt], ledger: &GateLedger, context: GateContext) Never! {
    loop statement in body -> visit_statement_expressions(source, statement, &ledger, context)
    visit_statement_gates(source, body, &ledger)
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:392
fn visit_statement_expressions(source: String, statement: Stmt, ledger: &GateLedger, context: GateContext) Never! {
    statement.for_each_expr(fn(expression) { visit_expression_value(source, expression, &ledger, context) })
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:404
fn visit_expression(source: String, expression: Expr, ledger: &GateLedger, context: GateContext) Never! {
    expression.for_each_expr(fn(value) { visit_expression_value(source, value, &ledger, context) })
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:414
fn visit_expression_value(source: String, expression: Expr, ledger: &GateLedger, context: GateContext) Never! {
    if expression == {
        .Call(call) -> {
            if call.widen_approx || call.name == Syntax.BUILTIN_APPROX {
                &ledger.push(source_entry(GateKind.PrecisionDemotion, "knowledge", "expression", source, call.name_span, "approx", None, "exact value widened to an approximation", "recorded"))
            } else if call.name == Syntax.BUILTIN_WRAPPING || call.name == Syntax.BUILTIN_SATURATING || call.name == Syntax.BUILTIN_CHECKED {
                detail :: if call.name == {
                    Syntax.BUILTIN_SATURATING -> "overflow fact replaced by saturating arithmetic"
                    Syntax.BUILTIN_CHECKED -> "overflow fact represented as an optional result"
                    else -> "overflow fact replaced by wrapping arithmetic"
                }
                &ledger.push(source_entry(GateKind.PrecisionDemotion, "knowledge", "expression", source, call.name_span, call.name, None, detail, "recorded"))
            }
        }
        .MethodCall{receiver, method, method_span, args, ..} -> {
            if is_rounded_conversion(method, args) {
                &ledger.push(source_entry(GateKind.PrecisionDemotion, "knowledge", "expression", source, method_span, method, None, "unit conversion rounded with an explicit mode", "recorded"))
            } else if method == Syntax.METHOD_DROP {
                reason :: args.first().and_then(fn(argument) { literal_text(Val(argument.expr)) })
                &ledger.push(source_entry(GateKind.DutyDrop, "duty", "expression", source, method_span, ".drop", reason, "result duty explicitly discharged", "discharged"))
            } else if method == "raw" && is_checked_text_static_receiver(receiver, context.checked_text_types) {
                &ledger.push(checked_text_raw_entry(source, method_span, context))
            } else if method == Syntax.TASK_DETACH {
                &ledger.push(source_entry(GateKind.DutyDrop, "duty", "expression", source, method_span, "detach", None, "join duty explicitly abandoned", "discharged"))
            } else if method == "raw" {
                &ledger.push(source_entry(GateKind.PrecisionDemotion, "knowledge", "expression", source, method_span, ".raw", None, "typed fact extracted as a raw value", "recorded"))
            }
        }
        .RawOf(_, span) -> &ledger.push(source_entry(GateKind.PrecisionDemotion, "knowledge", "expression", source, span, ".raw", None, "typed fact extracted as a raw value", "recorded"))
        else -> {}
    }
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:559
fn is_checked_text_static_receiver(receiver: Expr, checked_text_types: [String:Bool]) -> Bool Never! {
    name :: static_type_receiver_name(receiver) ?? return false
    if checked_text_types.contains(name) -> return true
    if name.rsplit_once("::") == .Val((_, leaf)) -> return checked_text_types.contains(leaf)
    false
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:569
fn static_type_receiver_name(receiver: Expr) -> String? Never! {
    if receiver == {
        .Ident(name, _) -> Val(name)
        .Field(base, name, _) -> if base is Expr.Ident -> Val(name) else -> None
        else -> None
    }
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:577
fn checked_text_raw_entry(source: String, span: Span, context: GateContext) -> GateEntry Never! {
    enclosing := UnsafeGateInspection?{None}
    loop gate in context.unsafe_gates {
        if gate.source != source || gate.span.start > span.start || span.end > gate.span.end -> next
        if enclosing == .Val(previous) {
            if (gate.span.end - gate.span.start, gate.span.start) >= (previous.span.end - previous.span.start, previous.span.start) -> next
        }
        enclosing = Val(gate)
    }
    reason :: enclosing.and_then(fn(gate) { gate.reason })
    entry := source_entry(GateKind.Unsafe, "security", "expression", source, span, "Type.raw", reason, "checked text raw construction requires an audited unsafe region", if reason != None -> "recorded" else -> "missing")
    if enclosing == .Val(gate) -> &entry.provenance.push("unsafe gate {gate.source}:{gate.span.start}..{gate.span.end}")
    entry
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:609
fn is_rounded_conversion(method: String, args: [CallArg]) -> Bool Never! {
    method.starts_with("from_") && method.ends_with("_rounded") && args.len() == 3 && args.any(fn(arg) { arg.label.map(fn(label) { label.0 == "digits" }) ?? false })
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:621
fn literal_text(expression: Expr?) -> String? Never! {
    value :: expression ?? return None
    if value == .Str(parts, _) {
        text := ""
        loop part in parts {
            if part == { .Lit(value) -> &text.push_str(value); else -> return None }
        }
        return Val(text)
    }
    None
}
// Rust: crates/jet-sema/src/Sema/GateLedger.rs:635
fn visit_statement_gates(source: String, body: [Stmt], ledger: &GateLedger) Never! {
    loop statement in body {
        if statement == {
            .Impure{reason, span, ..} -> &ledger.push(source_entry(GateKind.Impure, "security", "block", source, span, "#Impure", reason, "ambient comptime effect gate", if reason != None -> "recorded" else -> "missing"))
            .AuthorityScope{caps, span, ..} -> {
                effects :: (loop cap in caps -> cap.0).join(",")
                &ledger.push(source_entry(GateKind.DependencyGrant, "security", "block", source, span, "#FX", None, "effects: {effects}", "recorded"))
            }
            .AssumeDet{reason, span, ..} -> &ledger.push(source_entry(GateKind.Nondeterministic, "security", "block", source, span, "assume_deterministic", Val(reason), "determinism escape", "recorded"))
            else -> {}
        }
        if statement == .Unsafe{body, ..} -> visit_statement_gates(source, body, &ledger)
        else -> { loop nested in nested_bodies(statement) -> visit_statement_gates(source, nested, &ledger) }
    }
}
