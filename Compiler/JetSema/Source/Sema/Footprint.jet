// Method field footprints.
//
// A method's footprint is the set of record fields its body reads or changes
// through `self`. Calls to sibling methods on `self` add their footprints; any
// other use of the whole `self` makes the footprint the whole record. It is
// solved per owner to a fixpoint over sibling calls. A stated footprint on the
// receiver (`^self.log`, `^self.[log, hits]`) must name stored fields and
// cover the body (E0231).
use {
    jet_foundation.[ASTTables, AccessConvention, Diagnostic, Expr, ExprNode, FnBody, Func, Item, NamedSpan, PublicAPIItem, Span, ast_expr, ast_visit_statement, symbol_none, type_name]
    jet_parser.[parse_generated_source]
}

// What one method body does with `self`, before sibling calls are solved:
// the stored fields it reaches (with their first use), the sibling methods it
// calls on `self`, and the first use of the whole `self`.
SemaFootprintUses: struct {
    known: [String],
    names: [String],
    spans: [Span],
    calls: [NamedSpan],
    whole: Span?,
    // The starts of the `self` bases a field, spread or call already counted;
    // the walk visits a node before its children.
    settled: [Int:Bool],

    visit: fn(^self, tables: ASTTables, expression: ExprNode) Never! {
        if ast_expr(tables, expression) == {
            .Field(base, member, span, _) -> {
                if sema_footprint_self_span(base) == .Val(self_span) {
                    sema_footprint_note_field(self, member, span)
                    self.settled[self_span.start] = true
                }
            }
            .MemberSpread(base, members, _, _) -> {
                if sema_footprint_self_span(base) == .Val(self_span) {
                    loop member in members {
                        sema_footprint_note_field(self, member.name, member.span)
                    }
                    self.settled[self_span.start] = true
                }
            }
            .MethodCall(receiver, method, method_span, _, _, _, _) -> {
                if sema_footprint_self_span(receiver) == .Val(self_span) {
                    // A stored function value called through its field.
                    if self.known.contains(method) {
                        sema_footprint_note_field(self, method, method_span)
                    } else { self.calls.push(NamedSpan{name: method, span: method_span}) }
                    self.settled[self_span.start] = true
                }
            }
            .Ident(name, span, _) -> {
                if name == "self" && self.settled.get(span.start) == None && self.whole == None {
                    self.whole = Val(span)
                }
            }
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
        }
    }
}

// A solved footprint: each field with the span that first reaches it, or the
// whole record (`whole`) with the span that first uses it.
SemaFootprint: struct {
    names: [String],
    spans: [Span],
    whole: Span?,
}

// The span of `self`, or of a marked `^self` / `^^self` place.
sema_footprint_self_span: fn(expression: Expr) -> Span? Never! {
    if expression == {
        .Ident(name, span, _) -> if name == "self" -> Val(span) else -> None
        .Place(inner, _, _, _) | .Paren(inner, _, _) -> sema_footprint_self_span(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// A stored field joins the footprint at its first use; any other member (a
// method value or computed field) reads the whole record.
sema_footprint_note_field: fn(uses: ^SemaFootprintUses, name: String, span: Span) Never! {
    if !uses.known.contains(name) {
        if uses.whole == None -> uses.whole = Val(span)
        return
    }
    if uses.names.contains(name) {
        return
    }
    uses.names.push(name.copy())
    uses.spans.push(span.copy())
}

// The receiver of a method that can have a footprint: a `self` or `^self`
// first parameter, not a consuming `^^self`.
sema_footprint_has_receiver: fn(method: Func) -> Bool Never! {
    if method.params.len() == 0 -> return false
    method.params[0].name == "self" && method.params[0].convention != AccessConvention.Move
}

sema_footprint_body_uses: fn(tables: ASTTables, method: Func, known: [String]) -> SemaFootprintUses {
    uses := SemaFootprintUses{known: known, names: [String]{}, spans: [Span]{}, calls: [NamedSpan]{}, whole: None, settled: [Int:Bool]{}}
    loop statement in method.body {
        ast_visit_statement(tables, statement, fn(expression: ExprNode) { uses.visit(tables, expression) }, true)
    }
    uses
}

// One owner (a struct or an impl target) and its methods, each declared once.
SemaFootprintOwner: struct {
    name: String,
    methods: [Func],
}

// One method's solved or stated receiver field footprint: `fields` holds the
// sorted stored field names when bounded, or None when the method touches
// whole `self` or has no non-consuming receiver.
SemaSolvedMethodFootprint: struct {
    owner: String,
    method: String,
    span: Span,
    fields: [String]?,
}

SemaFootprintModuleResult: struct {
    diagnostics: [Diagnostic],
    footprints: [SemaSolvedMethodFootprint],
}

// Format a bounded receiver field footprint canonically for API snapshots:
// `self.[a, b]` (fields must already be sorted and deduplicated).
sema_footprint_format: fn(fields: [String]) -> String Never! {
    "self.[{fields.join(", ")}]"
}

// Check every stated footprint of the methods declared in `items` against its
// solved body footprint, owner by owner in name order.
sema_footprint_check: fn(tables: ASTTables, items: [Item]) -> [Diagnostic] {
    sema_footprint_solve_module(tables, items).diagnostics
}

// Solve every receiver method's footprint in `items` (stated when declared and
// valid, else inferred to a fixpoint over sibling `self` calls), and check
// every stated footprint against its body (E0231).
sema_footprint_solve_module: fn(tables: ASTTables, items: [Item]) -> SemaFootprintModuleResult {
    diagnostics := [Diagnostic]{}
    footprints := [SemaSolvedMethodFootprint]{}
    has_methods := false
    loop item in items {
        if item == {
            .Struct(definition) -> {
                if definition.methods.len() > 0 || definition.trait_impls.len() > 0 {
                    has_methods = true
                    break
                }
            }
            .Impl(definition) -> {
                if definition.methods.len() > 0 {
                    has_methods = true
                    break
                }
            }
            .Func(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    if !has_methods -> return SemaFootprintModuleResult{diagnostics: diagnostics, footprints: footprints}
    owners := [SemaFootprintOwner]{}
    fields := [String:[String]]{}
    stated := false
    loop item in items {
        if item == {
            .Struct(definition) -> {
                stored := [String]{}
                loop field in definition.fields {
                    if field.computed == None -> stored.push(field.name)
                }
                fields[definition.name] = stored
                methods := definition.methods
                loop block in definition.trait_impls {
                    loop method in block.methods -> methods.push(method.copy())
                }
                if methods.len() > 0 -> sema_footprint_add_owner(owners, definition.name, methods, stated)
            }
            .Impl(definition) -> {
                if definition.methods.len() > 0 -> sema_footprint_add_owner(owners, definition.type_name, definition.methods, stated)
            }
            .Func(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    owners.sort_by(fn(left: SemaFootprintOwner, right: SemaFootprintOwner) { left.name <=> right.name })
    loop owner in owners {
        known: fields.get(owner.name) ?? next
        sema_footprint_solve_owner(tables, owner, known, diagnostics, footprints)
    }
    SemaFootprintModuleResult{diagnostics: diagnostics, footprints: footprints}
}

// Attach solved method footprints onto the matching registered struct and impl
// methods in `module_row`.
sema_footprint_populate_module: fn(module_row: ^SemaRegistrationModule) {
    result: sema_footprint_solve_module(module_row.program.tables, module_row.program.items)
    if result.footprints.len() == 0 -> return
    by_start := [Int:Int]{}
    loop (idx, entry) in result.footprints {
        if entry.span.start != entry.span.end {
            by_start[entry.span.start] = idx
        }
    }
    loop n_idx in 0..<module_row.nominals.len() {
        loop m_idx in 0..<module_row.nominals[n_idx].methods.len() {
            span: module_row.nominals[n_idx].methods[m_idx].declaration.span
            if by_start.get(span.start) == .Val(idx) && result.footprints[idx].span == span {
                module_row.nominals[n_idx].methods[m_idx].receiver_footprint = result.footprints[idx].fields
            }
        }
    }
    loop i_idx in 0..<module_row.impls.len() {
        loop m_idx in 0..<module_row.impls[i_idx].methods.len() {
            span: module_row.impls[i_idx].methods[m_idx].declaration.span
            if by_start.get(span.start) == .Val(idx) && result.footprints[idx].span == span {
                module_row.impls[i_idx].methods[m_idx].receiver_footprint = result.footprints[idx].fields
            }
        }
    }
}

// Look up the solved receiver footprint for a method declaration span in a
// registered module, or None for free functions / whole-receiver methods.
sema_footprint_for_method_span: fn(module_row: SemaRegistrationModule, span: Span) -> [String]? Never! {
    if span.start == span.end -> return None
    loop nominal in module_row.nominals {
        loop method in nominal.methods {
            if method.declaration.span == span -> return method.receiver_footprint
        }
    }
    loop implementation in module_row.impls {
        loop method in implementation.methods {
            if method.declaration.span == span -> return method.receiver_footprint
        }
    }
    None
}

sema_footprint_add_owner: fn(owners: ^[SemaFootprintOwner], name: String, methods: [Func], stated: ^Bool) Never! {
    loop method in methods {
        if method.params.len() > 0 && method.params[0].declared_footprint != None -> stated = true
    }
    loop index in 0..<owners.len() {
        if owners[index].name == name {
            loop method in methods -> owners[index].methods.push(method.copy())
            return
        }
    }
    owners.push(SemaFootprintOwner{name: name, methods: methods})
}

sema_footprint_sorted_unique: fn(names: [String]) -> [String] Never! {
    sorted := names
    sorted.sort()
    unique := [String]{}
    loop name in sorted {
        if unique.len() == 0 || unique[unique.len() - 1] != name -> unique.push(name)
    }
    unique
}

// Solve every method of `owner`, then check each stated footprint and record
// each receiver method's effective footprint (stated when valid, else inferred).
// A name declared twice (an inherent and a trait method) resolves to the whole
// record at its call sites, as does a consuming, static or unknown callee.
sema_footprint_solve_owner: fn(tables: ASTTables, owner: SemaFootprintOwner, known: [String], diagnostics: ^[Diagnostic], footprints: ^[SemaSolvedMethodFootprint]) {
    // The method position each name calls, or -1 when it has no footprint
    // receiver or is declared more than once.
    index := [String:Int]{}
    loop (position, method) in owner.methods {
        if index.get(method.name) != None -> index[method.name] = -1 else {
            index[method.name] = if sema_footprint_has_receiver(method) -> position else -> -1
        }
    }
    uses := [SemaFootprintUses?]{}
    solved := [SemaFootprint?]{}
    loop method in owner.methods {
        if !sema_footprint_has_receiver(method) {
            uses.push(None)
            solved.push(None)
            next
        }
        body: sema_footprint_body_uses(tables, method, known)
        solved.push(Val(SemaFootprint{names: body.names, spans: body.spans, whole: body.whole}))
        uses.push(Val(body))
    }
    changed := true
    loop changed {
        changed = false
        loop position in 0..<uses.len() {
            body: uses[position] ?? next
            loop call in body.calls {
                own: solved[position] ?? next
                if own.whole != None -> next
                target: index.get(call.name) ?? -1
                next_footprint := own.copy()
                called := SemaFootprint?{None}
                if target >= 0 -> called = solved[target]
                if called == .Val(callee) && callee.whole == None {
                    loop name in callee.names {
                        if !next_footprint.names.contains(name) {
                            next_footprint.names.push(name)
                            next_footprint.spans.push(call.span)
                        }
                    }
                } else { next_footprint.whole = Val(call.span) }
                if next_footprint.whole != None || next_footprint.names.len() != own.names.len() {
                    solved[position] = Val(next_footprint)
                    changed = true
                }
            }
        }
    }
    loop (position, method) in owner.methods {
        footprint: solved[position] ?? next
        effective := [String]?{None}
        if footprint.whole == None {
            effective = Val(sema_footprint_sorted_unique(footprint.names))
        }
        if method.params[0].declared_footprint == .Val(declared) {
            stated_names := (loop entry in declared -> entry.name)
            shown: if stated_names.len() == 1 -> "self.{stated_names[0]}" else -> "self.[{stated_names.join(", ")}]"
            named_fields := true
            loop entry in declared {
                if !known.contains(entry.name) {
                    named_fields = false
                    diagnostics.push(sema_error("E0231", entry.span, "`self.{entry.name}` in the receiver of `{method.name}` names no field of `{owner.name}`", "a stated footprint lists the stored fields the method may read or change", "name fields of `{owner.name}` only, or remove `.{entry.name}` from the receiver"))
                }
            }
            if named_fields {
                effective = Val(sema_footprint_sorted_unique(stated_names))
                outside := {what: "", span: Span{start: 0, end: 0}}
                found := false
                if footprint.whole == .Val(whole_span) {
                    outside = {what: "all of `self`", span: whole_span}
                    found = true
                } else {
                    // The first field outside the stated set, in field-name order.
                    order := (loop position_in in 0..<footprint.names.len() -> position_in)
                    sorted_names: footprint.names
                    order.sort_by(fn(at: Int) { sorted_names[at] })
                    loop at in order {
                        if !stated_names.contains(footprint.names[at]) {
                            outside = {what: "`self.{footprint.names[at]}`", span: footprint.spans[at]}
                            found = true
                            break
                        }
                    }
                }
                if found {
                    diagnostics.push(sema_error("E0231", outside.span, "`{method.name}` uses {outside.what} outside its stated footprint `{shown}`", "callers and the published API see the stated footprint, so the body must stay inside it", "add the field to the receiver's footprint, or change `{method.name}` to stay inside `{shown}`"))
                }
            }
        }
        footprints.push(SemaSolvedMethodFootprint{owner: owner.name, method: method.name, span: method.span, fields: effective})
    }
}

#Test("method footprints infer sibling fixpoints, check E0231, publish API snapshots, and expand disjoint receiver accesses") {
    source: `Counter: struct {
    hits: Int,
    log: [String],
    bump: fn(^self) { self.hits += 1 }
    record: fn(^self.[log, hits], msg: String) {
        self.bump()
        self.log.push(msg)
    }
    bad_field: fn(^self.missing) { self.hits += 1 }
    bad_escape: fn(^self.hits) { self.log.push("x") }
}`
    parsed: parse_generated_source(source.bytes())
    assert(parsed.diagnostics.is_empty())
    solved: sema_footprint_solve_module(parsed.program.tables, parsed.program.items)
    assert_eq(solved.diagnostics.len(), 2)
    assert_eq(solved.diagnostics[0].code, "E0231")
    assert_eq(solved.diagnostics[1].code, "E0231")
    bump_fields := [String]?{None}
    record_fields := [String]?{None}
    loop entry in solved.footprints {
        if entry.method == "bump" -> bump_fields = entry.fields
        if entry.method == "record" -> record_fields = entry.fields
    }
    assert_eq(bump_fields, Val([String]{"hits"}))
    assert_eq(record_fields, Val([String]{"hits", "log"}))
    rows := [PublicAPIItem]{}
    sema_public_api_items(parsed.program.items, [FnBody]{}, "", rows)
    record_sig := ""
    loop row in rows {
        if row.name == "Counter.record" -> record_sig = row.signature
    }
    assert(record_sig.ends_with("; footprint = self.[hits, log]"))
    span: Span{start: 0, end: 1}
    base_place: SemaOwnershipPlace{root: "c", root_id: symbol_none(), root_span: span, projections: [String]{}, typed_projections: [SemaOwnershipProjection]{}}
    whole: sema_ownership_method_receiver_accesses([SemaOwnershipPlace]{base_place}, AccessConvention.Write, Val([String]{"hits", "log"}), false, span, false)
    assert_eq(whole.len(), 1)
    assert_eq(whole[0].place.projections.len(), 0)
    disjoint: sema_ownership_method_receiver_accesses([SemaOwnershipPlace]{base_place}, AccessConvention.Write, Val([String]{"hits", "log"}), true, span, false)
    assert_eq(disjoint.len(), 2)
    assert_eq(disjoint[0].place.projections, [String]{".hits"})
    assert_eq(disjoint[1].place.projections, [String]{".log"})
}

#Test("disjoint method footprints allow non-overlapping field borrows and reject overlapping E0212") {
    ok_source: `
Counter: struct {
    hits: Int,
    log: [String],
    bump: fn(^self.hits) { self.hits += 1 }
    peek_log: fn(self.log) -> Int { self.log.len() }
    record: fn(^self.[log, hits], msg: String) {
        self.bump()
        self.log.push(msg)
    }
}

demo: fn() -> Int {
    c := Counter{hits: 0, log: [String]{"a", "b"}}
    view: c.log[0..<2]
    c.bump()
    n: c.peek_log()
    view.len() + n + c.hits
}
`
    parsed_ok: parse_generated_source(ok_source.bytes())
    assert(parsed_ok.diagnostics.is_empty())
    checked_ok: check_program(parsed_ok.program, "test", "test.jet", [SemaSourceSegment]{})
    if !checked_ok.diagnostics.is_empty() {
        panic("disjoint footprint check failed: {checked_ok.diagnostics[0].code}: {checked_ok.diagnostics[0].what}")
    }

    bad_source: `
Counter: struct {
    hits: Int,
    log: [String],
    push_log: fn(^self.log, msg: String) { self.log.push(msg) }
}

demo: fn() -> Int {
    c := Counter{hits: 0, log: [String]{"a"}}
    view: c.log[0..<1]
    c.push_log("b")
    view.len()
}
`
    parsed_bad: parse_generated_source(bad_source.bytes())
    assert(parsed_bad.diagnostics.is_empty())
    checked_bad: check_program(parsed_bad.program, "test", "test.jet", [SemaSourceSegment]{})
    has_e0212 := false
    loop diag in checked_bad.diagnostics {
        if diag.code == "E0212" -> has_e0212 = true
    }
    assert(has_e0212)
}



