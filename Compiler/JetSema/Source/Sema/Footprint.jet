// Method field footprints.
//
// A method's footprint is the set of record fields its body reads or changes
// through `self`. Calls to sibling methods on `self` add their footprints; any
// other use of the whole `self` makes the footprint the whole record. It is
// solved per owner to a fixpoint over sibling calls. A stated footprint on the
// receiver (`&self.log`, `&self.[log, hits]`) must name stored fields and
// cover the body (E0231).
use jet_foundation.[AccessConvention, Diagnostic, Expr, Func, Item, NamedSpan, Span, ast_visit_statement, type_name]

// What one method body does with `self`, before sibling calls are solved:
// the stored fields it reaches (with their first use), the sibling methods it
// calls on `self`, and the first use of the whole `self`.
SemaFootprintUses: struct {
    known: [String]
    names: [String]
    spans: [Span]
    calls: [NamedSpan]
    whole: Span?
    // The starts of the `self` bases a field, spread or call already counted;
    // the walk visits a node before its children.
    settled: [Int:Bool]

    visit: fn(&self, expression: Expr) Never! {
        if expression == {
            .Field(base, member, span, _) -> {
                if sema_footprint_self_span(base) == .Val(self_span) {
                    sema_footprint_note_field(self, member, span)
                    self.settled[self_span.start] = true
                }
            }
            .MemberSpread(base, members, _, _) -> {
                if sema_footprint_self_span(base) == .Val(self_span) {
                    loop member in members -> sema_footprint_note_field(self, member.name, member.span)
                    self.settled[self_span.start] = true
                }
            }
            .MethodCall(receiver, method, method_span, _, _, _, _) -> {
                if sema_footprint_self_span(receiver) == .Val(self_span) {
                    // A stored function value called through its field.
                    if self.known.contains(method) {
                        sema_footprint_note_field(self, method, method_span)
                    } else {
                        self.calls.push(NamedSpan{name: method, span: method_span})
                    }
                    self.settled[self_span.start] = true
                }
            }
            .Ident(name, span, _) -> {
                if name == "self" && self.settled.get(span.start) == None && self.whole == None -> self.whole = Val(span)
            }
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
        }
    }
}

// A solved footprint: each field with the span that first reaches it, or the
// whole record (`whole`) with the span that first uses it.
SemaFootprint: struct {
    names: [String]
    spans: [Span]
    whole: Span?
}

// The span of `self`, or of a marked `&self` / `&&self` place.
sema_footprint_self_span: fn(expression: Expr) -> Span? Never! {
    if expression == {
        .Ident(name, span, _) -> if name == "self" -> Val(span) else -> None
        .Place(inner, _, _, _) | .Paren(inner, _, _) -> sema_footprint_self_span(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// A stored field joins the footprint at its first use; any other member (a
// method value or computed field) reads the whole record.
sema_footprint_note_field: fn(uses: &SemaFootprintUses, name: String, span: Span) Never! {
    if !uses.known.contains(name) {
        if uses.whole == None -> uses.whole = Val(span)
        return
    }
    if uses.names.contains(name) -> return
    uses.names.push(name.copy())
    uses.spans.push(span.copy())
}

// The receiver of a method that can have a footprint: a `self` or `&self`
// first parameter, not a consuming `&&self`.
sema_footprint_has_receiver: fn(method: Func) -> Bool Never! {
    if method.params.len() == 0 -> return false
    method.params[0].name == "self" && method.params[0].convention != AccessConvention.Move
}

sema_footprint_body_uses: fn(method: Func, known: [String]) -> SemaFootprintUses {
    uses := SemaFootprintUses{known: known, names: [String]{}, spans: [Span]{}, calls: [NamedSpan]{}, whole: None, settled: [Int:Bool]{}}
    loop statement in method.body -> ast_visit_statement(statement, fn(expression: Expr) { uses.visit(expression) }, true)
    uses
}

// One owner (a struct or an impl target) and its methods, each declared once.
SemaFootprintOwner: struct {
    name: String
    methods: [Func]
}

// Check every stated footprint of the methods declared in `items` against its
// solved body footprint, owner by owner in name order. A method of an inline
// module is lifted into `items` with its owner before this runs.
sema_footprint_check: fn(items: [Item]) -> [Diagnostic] {
    diagnostics := [Diagnostic]{}
    owners := [SemaFootprintOwner]{}
    fields := [String:[String]]{}
    stated := false
    loop item in items {
        if item == {
            .Struct(definition) -> {
                stored := [String]{}
                loop field in definition.fields {
                    if field.computed == None -> stored.push(field.name)
                }
                fields[definition.name] = stored
                methods := definition.methods
                loop block in definition.trait_impls {
                    loop method in block.methods -> methods.push(method.copy())
                }
                sema_footprint_add_owner(owners, definition.name, methods, stated)
            }
            .Impl(definition) -> sema_footprint_add_owner(owners, definition.type_name, definition.methods, stated)
            .Func(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    if !stated -> return diagnostics
    owners.sort_by(fn(left: SemaFootprintOwner, right: SemaFootprintOwner) { left.name <=> right.name })
    loop owner in owners {
        known: fields.get(owner.name) ?? next
        sema_footprint_solve_owner(owner, known, diagnostics)
    }
    diagnostics
}

sema_footprint_add_owner: fn(owners: &[SemaFootprintOwner], name: String, methods: [Func], stated: &Bool) Never! {
    loop method in methods {
        if method.params.len() > 0 && method.params[0].declared_footprint != None -> stated = true
    }
    loop index in 0..<owners.len() {
        if owners[index].name == name {
            loop method in methods -> owners[index].methods.push(method.copy())
            return
        }
    }
    owners.push(SemaFootprintOwner{name: name, methods: methods})
}

// Solve every method of `owner`, then check each stated footprint. A name
// declared twice (an inherent and a trait method) resolves to the whole
// record at its call sites, as does a consuming, static or unknown callee.
sema_footprint_solve_owner: fn(owner: SemaFootprintOwner, known: [String], diagnostics: &[Diagnostic]) {
    // The method position each name calls, or -1 when it has no footprint
    // receiver or is declared more than once.
    index := [String:Int]{}
    loop (position, method) in owner.methods {
        if index.get(method.name) != None {
            index[method.name] = -1
        } else {
            index[method.name] = if sema_footprint_has_receiver(method) -> position else -> -1
        }
    }
    uses := [SemaFootprintUses?]{}
    solved := [SemaFootprint?]{}
    loop method in owner.methods {
        if !sema_footprint_has_receiver(method) {
            uses.push(None)
            solved.push(None)
            next
        }
        body: sema_footprint_body_uses(method, known)
        solved.push(Val(SemaFootprint{names: body.names, spans: body.spans, whole: body.whole}))
        uses.push(Val(body))
    }
    changed := true
    loop changed {
        changed = false
        loop position in 0..<uses.len() {
            body: uses[position] ?? next
            loop call in body.calls {
                own: solved[position] ?? next
                if own.whole != None -> next
                target: index.get(call.name) ?? -1
                next_footprint := own
                called := SemaFootprint?{None}
                if target >= 0 -> called = solved[target]
                if called == .Val(callee) && callee.whole == None {
                    loop name in callee.names {
                        if !next_footprint.names.contains(name) {
                            next_footprint.names.push(name)
                            next_footprint.spans.push(call.span)
                        }
                    }
                } else {
                    next_footprint.whole = Val(call.span)
                }
                if next_footprint.whole != None || next_footprint.names.len() != own.names.len() {
                    solved[position] = Val(next_footprint)
                    changed = true
                }
            }
        }
    }
    loop (position, method) in owner.methods {
        footprint: solved[position] ?? next
        declared: method.params[0].declared_footprint ?? next
        stated_names := (loop entry in declared -> entry.name)
        shown: if stated_names.len() == 1 -> "self.{stated_names[0]}" else -> "self.[{stated_names.join(", ")}]"
        named_fields := true
        loop entry in declared {
            if !known.contains(entry.name) {
                named_fields = false
                diagnostics.push(sema_error("E0231", entry.span, "`self.{entry.name}` in the receiver of `{method.name}` names no field of `{owner.name}`", "a stated footprint lists the stored fields the method may read or change", "name fields of `{owner.name}` only, or remove `.{entry.name}` from the receiver"))
            }
        }
        if !named_fields -> next
        outside := (what: "", span: Span{start: 0, end: 0})
        found := false
        if footprint.whole == .Val(whole_span) {
            outside = (what: "all of `self`", span: whole_span)
            found = true
        } else {
            // The first field outside the stated set, in field-name order.
            order := (loop position_in in 0..<footprint.names.len() -> position_in)
            sorted_names: footprint.names.copy()
            order.sort_by(fn(at: Int) { sorted_names[at] })
            loop at in order {
                if !stated_names.contains(footprint.names[at]) {
                    outside = (what: "`self.{footprint.names[at]}`", span: footprint.spans[at])
                    found = true
                    break
                }
            }
        }
        if found -> diagnostics.push(sema_error("E0231", outside.span, "`{method.name}` uses {outside.what} outside its stated footprint `{shown}`", "callers and the published API see the stated footprint, so the body must stay inside it", "add the field to the receiver's footprint, or change `{method.name}` to stay inside `{shown}`"))
    }
}
