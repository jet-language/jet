        }
    }
    ^out
}
impl ViewPlace {
    // Rust: crates/jet-sema/src/Sema/mod.rs:1585
    fn overlaps(self: &Self, other: &ViewPlace) -> Bool {
        if self.owner != other.owner -> return false
        loop i in 0..min(self.projections.len(), other.projections.len()) {
            if (self.projections[i], other.projections[i]) == {
                (.Field(a), .Field(b)) -> { if a != b -> return false }
                (.Index(.Val(a), _), .Index(.Val(b), _)) -> { if a != b -> return false }
                (.Index(.Val(index), _), .Range(.Val(start), .Val(end), _)) | (.Range(.Val(start), .Val(end), _), .Index(.Val(index), _)) -> { if index < start || index > end -> return false }
                (.Range(.Val(a_start), .Val(a_end), _), .Range(.Val(b_start), .Val(b_end), _)) -> { if a_end < b_start || b_end < a_start -> return false }
                (.Fresh(a), .Fresh(b)) -> { if a != b -> return false }
                else -> {}
            }
        }
        true
    }
    // Rust: crates/jet-sema/src/Sema/mod.rs:1637
    fn extends(self: &Self, other: &ViewPlace) -> Bool { self.owner == other.owner && self.projections.len() >= other.projections.len() && self.overlaps(other) }
}
