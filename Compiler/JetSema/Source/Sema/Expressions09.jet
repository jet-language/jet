//RS #[derive(Debug, Clone)]
//RS pub(crate) struct LocalInfo {
//RS     def_span: Span,
//RS     /// Source span of this local binding's `::`/`:=` sigil, when it has one.
//RS     /// Parameters and compiler-created locals have no binding sigil.
//RS     binding_sigil_span: Option<Span>,
//RS     ty: Type,
//RS     mutable: bool,
//RS     /// Set when the name is a parameter (with its access convention).
//RS     param_conv: Option<AccessConvention>,
//RS     /// Loop nesting depth where the name was declared (for move-in-loop).
//RS     decl_loop_depth: usize,
//RS     /// Whether a function value has the thread-safe representation required by
//RS     /// `core.sys.on_interrupt`. Ordinary `fn` values use `Rc`; only named
//RS     /// functions and already-proven callback-safe aliases may cross that
//RS     /// boundary.
//RS     interrupt_sendable: bool,
//RS     /// D-DATARACE1=C: `#Local` pin on a reactive binding.
//RS     reactive_local: bool,
//RS     /// D-DATARACE1=C: `#Shared` pin on a reactive binding.
//RS     reactive_shared: bool,
//RS     /// D-LIN1 (ratified 2026-06-21): set (to the binding name's span) when this
//RS     /// local owns a `#SingleUse` value that must be consumed exactly once. `None`
//RS     /// for ordinary values, for parameters (the caller owns the consume duty), and
//RS     /// for `view`/`&` borrows (which never own). When still in scope and not in
//RS     /// `moved` at scope end, E0140 fires.
//RS     single_use_span: Option<Span>,
//RS     /// The initializer reported a type error, so this name has no usable
//RS     /// meaning, even when inference supplied a recovery type. Reads stop here
//RS     /// so the original diagnostic stays paired with the required use-site
//RS     /// diagnostic. A well-typed value whose initializer failed an ownership,
//RS     /// sendability, or contract rule is NOT invalid — its later reports stand.
//RS     invalid: bool,
//RS }
