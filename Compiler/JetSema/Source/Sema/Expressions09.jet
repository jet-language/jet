// Rust: crates/jet-sema/src/Sema/mod.rs:1532
pub fn push_view_fact(store: &ViewStore, name: String, fact: ViewFact) {
    fact := ^fact
    depth :: fact.scope_len
    seq := USize{0}
    loop (_, facts) in store.all() {
        loop held in facts -> seq = max(seq, held.seq + 1)
    }
    fact.seq = seq
    &store.entry_at(name, depth).push(^fact)
}
// Rust: crates/jet-sema/src/Sema/mod.rs:1545
pub fn view_facts_newest_first(store: &ViewStore) -> [(String, &ViewFact)] {
    all := [(String, &ViewFact)]{}
    loop (name, facts) in store.all() {
        loop fact in facts -> &all.push((name, &fact))
    }
    &all.sort_by((left, right) -> right.1.seq.cmp(left.1.seq))
    ^all
}
// Rust: crates/jet-sema/src/Sema/mod.rs:1555
pub fn current_view_fact(store: &ViewStore, name: String) -> &ViewFact? { (store.get(name) ?? return None).last() }
