// Rust: crates/jet-sema/src/Sema/mod.rs:21
pub fn source_expr_start(expr: &Expr) -> USize {
    if expr == {
        .Paren(_, span) -> span.start
        .Field(base, _, _) | .OptField(base, _, _, _, _) -> source_expr_start(&base)
        .MethodCall(receiver, _, _, _, _, _, _, _, _, _) -> source_expr_start(&receiver)
        else -> expr_span(expr).start
    }
}

// Rust: crates/jet-sema/src/Sema/mod.rs:31
pub fn source_call_end(source: String, method_span: Span) -> USize? {
    suffix :: source.get(method_span.end..) ?? return None
    open :: method_span.end + (suffix.find('(') ?? return None)
    depth := USize{0}
    quoted := false
    escaped := false
    text :: source.get(open..) ?? return None
    loop (offset, ch) in text.char_indices() {
        index :: open + offset
        if quoted {
            if escaped -> escaped = false
            else if ch == '\\' -> escaped = true
            else if ch == '"' -> quoted = false
            next
        }
        if ch == {
            '"' -> quoted = true
            '(' -> depth += 1
            ')' -> {
                depth = depth.checked_sub(1) ?? return None
                if depth == 0 -> return Val(index + ch.len_utf8())
            }
            else -> {}
        }
    }
    None
}

// Rust: crates/jet-sema/src/Sema/mod.rs:63
pub fn source_expr_end(source: String, expr: &Expr) -> USize? {
    if expr == {
        .MethodCall(_, _, method_span, _, _, _, _, _, _, _) -> source_call_end(source, method_span)
        .Paren(_, span) -> Val(span.end)
        else -> Val(expr_span(expr).end)
    }
}

