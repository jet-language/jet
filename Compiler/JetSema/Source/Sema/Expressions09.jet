//RS #[derive(Debug, Clone)]
//RS pub(crate) enum TypeDef {
//RS     Struct {
//RS         fields: Vec<(String, Span, Type)>,
//RS         methods: HashMap<String, MethodSig>,
//RS         /// D-STRUCT-LIFE1=A: type-level retiring lifecycle marker.
//RS         deprecation: Option<Deprecation>,
//RS         /// D-LIN1 (ratified 2026-06-21): `#SingleUse` was present before
//RS         /// `struct`. Values of this type must be consumed exactly once
//RS         /// (E0140/E0141) and may not be aliased (E0142).
//RS         single_use: bool,
//RS         /// D-MUSTUSE1 (c18iwxqx): `#MustUse` was present before `struct`.
//RS         /// Values of this type cannot be silently ignored as a bare expression
//RS         /// statement (E0419).
//RS         must_use: bool,
//RS         /// D-SOA1 / D-SOA2A=C: `#layout(columnar)` was present. A `[S]` of this
//RS         /// struct is stored struct-of-arrays; sema gates the list-op surface to
//RS         /// the v1-supported subset (E1108) and codegen lowers it columnar.
//RS         columnar: bool,
//RS         /// D-REPRC1: `#Layout(c)` was present — codegen stamps `#[repr(C)]`
//RS         /// on the generated Rust struct, so field order/size/padding match C.
//RS         /// A plain struct (no `#Layout(c)`) has an UNSPECIFIED Rust layout and
//RS         /// must never be accepted at the C FFI boundary (card #436 / E3203) —
//RS         /// only this flag makes `c_named_type_ok` (Sema/FFI.rs) say yes.
//RS         is_c_layout: bool,
//RS         /// D-MIGRATE1: `#PublishedSchema` was present (either the standalone
//RS         /// prefix or the grouped `#[PublishedSchema, …]` spelling). Codegen
//RS         /// adds a hidden `__jet_unknown_fields` carrier field to the generated
//RS         /// Rust struct, so a comptime-folded value of this type has no
//RS         /// complete literal form (`ct_value_is_emittable`).
//RS         published: bool,
//RS     },
//RS     Enum {
//RS         variants: HashMap<String, (Span, VariantPayload)>,
//RS         variant_order: Vec<String>,
//RS         /// D-TAG1: variant groups — group path → (span, ordered leaf paths in
//RS         /// its subtree). A group name matches its whole subtree in patterns.
//RS         groups: HashMap<String, (Span, Vec<String>)>,
//RS         methods: HashMap<String, MethodSig>,
//RS         /// D-STRUCT-LIFE1=A: type-level retiring lifecycle marker.
//RS         deprecation: Option<Deprecation>,
//RS         /// D-LIN1 (ratified 2026-06-21): `#SingleUse` was present before `enum`.
//RS         single_use: bool,
//RS         /// D-MUSTUSE1 (c18iwxqx): `#MustUse` was present before `enum`.
//RS         must_use: bool,
//RS         /// D-REPRC2: present only for `#Layout(c[, tag: Width])`.
//RS         c_layout_tag: Option<crate::AST::CEnumTag>,
//RS     },
//RS     /// D-DIST1 (ratified 2026-06-19): a distinct type — a nominal wrapper over
//RS     /// a base type. No implicit coercion either direction (E0128). Ability
//RS     /// requests remain ordinary derive rows after registration.
//RS     Distinct {
//RS         base: Type,
//RS         derives: Vec<String>,
//RS         /// D-STRUCT-LIFE1=A: type-level retiring lifecycle marker.
//RS         deprecation: Option<Deprecation>,
//RS         /// D-TYPE2-FOUND1: semantic facts live on the one type knowledge
//RS         /// vector. The interval plane is projected here for existing checks.
//RS         knowledge: KnowledgeVector,
