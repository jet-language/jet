// Rust: crates/jet-sema/src/Sema/mod.rs:86
#Derive(Debug, Clone)
pub struct UninitState {
    fixed_len: U64?
    initialized_indexes: BTreeSet<U64>
}
impl UninitState {
    // Rust: crates/jet-sema/src/Sema/mod.rs:93
    fn scalar() -> Self { Self{fixed_len: None, initialized_indexes: BTreeSet.new()} }
    // Rust: crates/jet-sema/src/Sema/mod.rs:100
    fn fixed(len: U64) -> Self { Self{fixed_len: Val(len), initialized_indexes: BTreeSet.new()} }
    // Rust: crates/jet-sema/src/Sema/mod.rs:110
    fn merge_paths(self: &Self, other: &Self) {
        if self.fixed_len == other.fixed_len -> self.initialized_indexes = self.initialized_indexes.intersection(&other.initialized_indexes).copied().collect()
        else { self.fixed_len = None; &self.initialized_indexes.clear() }
    }
}

