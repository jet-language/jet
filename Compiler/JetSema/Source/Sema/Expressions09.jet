    pub fn distinct_is_comparable(self: &Self, name: String) -> Bool { if self.types.get(name) == { .Val(.Distinct(derives: derives)) -> derives.any(derive -> derive == COMPARABLE); else -> false } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:990
