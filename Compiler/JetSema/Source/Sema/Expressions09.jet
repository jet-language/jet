// Rust: crates/jet-sema/src/Sema/mod.rs:569
#Derive(Debug, Clone)
pub struct UnitFact {
    package: OSPath
    family: String
    member: String
    dimension: Dimension?
    scale: UnitRatio
    scale_provenance: UnitScaleProvenance
    offset: UnitRatio
    kind: QuantityKind
}
impl UnitFact {
    // Rust: crates/jet-sema/src/Sema/mod.rs:584
    fn is_measured(self: &Self) -> Bool { if self.scale_provenance == { .Measured -> true; else -> false } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:591
    fn is_symbolic(self: &Self) -> Bool { if self.scale_provenance == { .SymbolicPi -> true; else -> false } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:598
    fn conversion_parts_to(self: &Self, destination: &Self) -> (UnitRatio, UnitRatio)? {
        scale :: self.scale.div(&destination.scale).ok() ?? return None
        offset :: self.offset.sub(&destination.offset).ok()?.div(&destination.scale).ok() ?? return None
        Val((^scale, ^offset))
    }
    // Rust: crates/jet-sema/src/Sema/mod.rs:612
    fn conversion_is_total_to(self: &Self, destination: &Self) -> Bool {
        self.conversion_parts_to(destination).is_some_and(pair -> pair.0 == UnitRatio.integer(1) && pair.1 == UnitRatio.zero())
    }
    // Rust: crates/jet-sema/src/Sema/mod.rs:620
    fn conversion_is_finite_to(self: &Self, destination: &Self) -> Bool {
        self.conversion_parts_to(destination).is_some_and(pair -> [pair.0, pair.1].all(value -> value.num.to_string().parse<F64>().is_ok_and(value -> value.is_finite()) && value.den.to_string().parse<F64>().is_ok_and(value -> value.is_finite())))
    }
    // Rust: crates/jet-sema/src/Sema/mod.rs:638
    fn converted_value_is_exact_to(self: &Self, destination: &Self, value: F64) -> Bool {
        (scale, offset) :: self.conversion_parts_to(destination) ?? return false
        jet_unit_conversion_exact(value, scale.num.to_string(), scale.den.to_string(), offset.num.to_string(), offset.den.to_string()) != None
    }
}

// Rust: crates/jet-sema/src/Sema/mod.rs:653
#Derive(Clone)
pub struct TypeRegistry {
    types: [String:TypeDef]
    error_types: [String:Bool]
    unit_types: [String:Bool]
    unit_facts: [String:UnitFact]
    literal_facts: [String:UnitFact]
    computed_fields: [String:[String:(Span, Type)]]
    field_defaults: [String:[String:Expr]]
    receipt_sections: [String:ReceiptSectionMeta]
    nominal_memo: NominalMemoCell
}
impl TypeRegistry {
    // Rust: crates/jet-sema/src/Sema/mod.rs:686
    pub fn receipt_section(self: &Self, type_name: String) -> &ReceiptSectionMeta? { self.receipt_sections.get(type_name) }
    // Rust: crates/jet-sema/src/Sema/mod.rs:689
    pub fn contains(self: &Self, name: String) -> Bool { self.types.contains_key(name) }
    // Rust: crates/jet-sema/src/Sema/mod.rs:693
    pub fn is_error_type(self: &Self, name: String) -> Bool { self.error_types.contains_key(name) }

    // Rust: crates/jet-sema/src/Sema/mod.rs:701
    pub fn is_error_domain(self: &Self, ty: &Type) -> Bool {
        // Rust: crates/jet-sema/src/Sema/mod.rs:702
        fn visit(registry: &TypeRegistry, ty: &Type, seen: &[String:Bool]) -> Bool {
            if ty == {
                .Named(name) -> {
                    if name == Syntax.TYPE_ERR || name == Syntax.TYPE_NEVER || registry.is_error_type(name) || (!registry.contains(name) && is_core_error_type(name)) -> return true
                    (params, target) :: registry.type_alias(name) ?? return false
                    if params.len() != 0 || seen.contains_key(name) -> return false
                    &seen.insert(name, true)
                    valid :: visit(registry, target, &seen)
                    _ :: &seen.remove(name)
                    valid
                }
                .Apply(name, args) -> {
                    if registry.is_error_type(name) || (!registry.contains(name) && is_core_error_type(name)) -> return true
                    (params, target) :: registry.type_alias(name) ?? return false
                    if params.len() != args.len() || seen.contains_key(name) -> return false
                    &seen.insert(name, true)
                    substitutions := [String:Type]{}
                    loop i in 0..params.len() -> &substitutions.insert(params[i].name, args[i].clone())
                    expanded :: substitute_type(target, &substitutions)
                    valid :: visit(registry, &expanded, &seen)
                    _ :: &seen.remove(name)
                    valid
                }
                .Union(members) -> members.len() > 0 && members.all(member -> visit(registry, &member, &seen))
                .List(inner) -> if inner == { .Named(name) -> name == "FieldError" && !registry.contains(name); else -> false }
                else -> false
            }
        }
        seen := [String:Bool]{}
        visit(&self, ty, &seen)
    }

    // Rust: crates/jet-sema/src/Sema/mod.rs:770
    pub fn is_user_struct(self: &Self, name: String) -> Bool { if self.types.get(name) == { .Val(.Struct) -> true; else -> false } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:775
    pub fn is_user_enum(self: &Self, name: String) -> Bool { if self.types.get(name) == { .Val(.Enum) -> true; else -> false } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:782
    pub fn is_published_schema_struct(self: &Self, name: String) -> Bool { if self.types.get(name) == { .Val(.Struct(published: true)) -> true; else -> false } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:792
    pub fn unit_dimension(self: &Self, name: String) -> Dimension? { self.unit_facts.get(name).and_then(fact -> fact.dimension.clone()) }
    // Rust: crates/jet-sema/src/Sema/mod.rs:798
    pub fn is_unit_type(self: &Self, name: String) -> Bool { self.unit_types.contains_key(name) }
    // Rust: crates/jet-sema/src/Sema/mod.rs:802
    pub fn unit_fact(self: &Self, name: String) -> &UnitFact? { self.unit_facts.get(name) }
    // Rust: crates/jet-sema/src/Sema/mod.rs:806
    pub fn unit_literal(self: &Self, family: String, member: String) -> &UnitFact? { self.literal_facts.get("{family}::{member}") }
    // Rust: crates/jet-sema/src/Sema/mod.rs:810
    fn struct_fields(self: &Self, name: String) -> &[(String, Span, Type)]? { if self.types.get(name) == { .Val(.Struct(fields: fields)) -> Val(&fields); else -> None } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:819
    pub fn computed_field_types(self: &Self, name: String) -> &[String:(Span, Type)]? { self.computed_fields.get(name) }
    // Rust: crates/jet-sema/src/Sema/mod.rs:827
    pub fn field_defaults(self: &Self, name: String) -> &[String:Expr]? { self.field_defaults.get(name) }
    // Rust: crates/jet-sema/src/Sema/mod.rs:833
    fn is_columnar(self: &Self, name: String) -> Bool { if self.types.get(name) == { .Val(.Struct(columnar: true)) -> true; else -> false } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:840
    fn enum_variants(self: &Self, name: String) -> &[String:(Span, VariantPayload)]? { if self.types.get(name) == { .Val(.Enum(variants: variants)) -> Val(&variants); else -> None } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:847
    fn enum_variant_order(self: &Self, name: String) -> &[String]? { if self.types.get(name) == { .Val(.Enum(variant_order: order)) -> Val(&order); else -> None } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:855
    fn enum_groups(self: &Self, name: String) -> &[String:(Span, [String])]? { if self.types.get(name) == { .Val(.Enum(groups: groups)) -> Val(&groups); else -> None } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:862
    fn method(self: &Self, type_name: String, method: String) -> &MethodSig? { if self.types.get(type_name) == { .Val(.Struct(methods: methods)) | .Val(.Enum(methods: methods)) -> methods.get(method); else -> None } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:871
    pub fn method_names(self: &Self, type_name: String) -> [String] {
        names := if self.types.get(type_name) == { .Val(.Struct(methods: methods)) | .Val(.Enum(methods: methods)) -> methods.keys().cloned().collect(); else -> [String]{} }
        &names.sort()
        ^names
    }
    // Rust: crates/jet-sema/src/Sema/mod.rs:882
    fn field_names(self: &Self, type_name: String) -> [String] { if self.types.get(type_name) == { .Val(.Struct(fields: fields)) -> fields.map(field -> field.0.clone()).collect(); else -> [String]{} } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:892
    pub fn is_distinct(self: &Self, name: String) -> Bool { if self.types.get(name) == { .Val(.Distinct) -> true; else -> false } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:897
    pub fn is_type_alias(self: &Self, name: String) -> Bool { if self.types.get(name) == { .Val(.Alias) -> true; else -> false } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:901
    pub fn type_alias(self: &Self, name: String) -> (&[TypeParam], &Type)? { if self.types.get(name) == { .Val(.Alias(params: params, target: target)) -> Val((&params, &target)); else -> None } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:910
    pub fn is_single_use(self: &Self, name: String) -> Bool { if self.types.get(name) == { .Val(.Struct(single_use: true)) | .Val(.Enum(single_use: true)) -> true; else -> false } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:924
    pub fn is_must_use(self: &Self, name: String) -> Bool { if self.types.get(name) == { .Val(.Struct(must_use: true)) | .Val(.Enum(must_use: true)) -> true; else -> false } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:933
    pub fn distinct_base(self: &Self, name: String) -> &Type? { if self.types.get(name) == { .Val(.Distinct(base: base)) -> Val(&base); else -> None } }
    // Rust: crates/jet-sema/src/Sema/mod.rs:941
    pub fn distinct_is_numeric(self: &Self, name: String) -> Bool { if self.types.get(name) == { .Val(.Distinct(derives: derives)) -> derives.any(derive -> derive == Syntax.MARKER_NUMERIC); else -> false } }
