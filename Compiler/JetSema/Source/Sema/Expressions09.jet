//RS #[derive(Clone)]
//RS pub(crate) struct TypeRegistry {
//RS     types: HashMap<String, TypeDef>,
//RS     /// D-FAILURE-FOUNDATION1=A: user-named types carrying `#Error` may be
//RS     /// used as explicit callable failure domains.
//RS     error_types: HashSet<String>,
//RS     /// D-QUANTITY-PRINT1: all concrete types minted by `#UnitFamily`.
//RS     unit_types: HashSet<String>,
//RS     /// #603: the one normalized source of truth for concrete unit conversion,
//RS     /// package identity, dimension, affine kind, and algebra facts.
//RS     unit_facts: HashMap<String, UnitFact>,
//RS     /// D-TYPE2-PLANE1=A: source-declared unit members are the one literal
//RS     /// fact registry. Canonical Time literals use these registered facts;
//RS     /// there is no compiler-owned suffix parser or duration table.
//RS     literal_facts: HashMap<String, UnitFact>,
//RS     /// D-FIELDPOL1: struct name → computed field name → (span, declared
//RS     /// type). A computed field never appears in `TypeDef::Struct::fields`
//RS     /// (it's not a stored field, and is never required/allowed in a struct
//RS     /// literal — E0339); this side table is the only place sema resolves its
//RS     /// type for a *read* (`field_type`).
//RS     computed_fields: HashMap<String, HashMap<String, (Span, Type)>>,
//RS     /// D-DEFAULT-SHAPE1=B: struct name → field name → default expression for omitted
//RS     /// `Type.{ … }` construction and wire/CLI absence.
//RS     field_defaults: HashMap<String, HashMap<String, crate::AST::Expr>>,
//RS     /// Named checked receipt declarations keyed by canonical type identity.
//RS     receipt_sections: HashMap<String, ReceiptSectionMeta>,
//RS     /// D-COMPILE-SPEED1 (#3661): structural answers about named types,
//RS     /// open only while body checking holds the registry final.
//RS     nominal_memo: NominalWalk::NominalMemoCell,
//RS }
