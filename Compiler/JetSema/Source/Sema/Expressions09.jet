// Rust: crates/jet-sema/src/Sema/mod.rs:1570
pub fn view_facts_for_binding(store: &ViewStore, name: String, binding_span: Span) -> [&ViewFact] {
    out := [&ViewFact]{}
    loop facts in store.facts_of(name) {
