//RS     expr.for_each_expr_mut(|node| {
//RS         let crate::AST::Expr::Ident(name, _) = node else {
//RS             return;
//RS         };
//RS         if let Some((_, replacement)) = refs.iter().find(|(param, _)| *param == name) {
//RS             *name = replacement.clone();
//RS         }
//RS     });
//RS     expr
//RS }
//RS 
//RS /// D-NARG-D2: Use the same exhaustive expression walker to check whether a
//RS /// default expression references any parameter that appears *after* the
//RS /// current parameter index. Collects the names of any forward-referenced
//RS /// parameters found. `all_param_names` is the full list of non-self parameter
//RS /// names for this function (in order).
//RS /// `default_param_idx` is the index of the parameter whose default we're checking.
