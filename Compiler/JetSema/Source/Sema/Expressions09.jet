pub fn checked_body_return_type(function: &Func, raw_protocol_return: Bool) -> Type? {
    if raw_protocol_return || function.name.starts_with("__errconv_") -> function.return_type.clone() else -> Val(function.effective_return_type())
}

// Rust: crates/jet-sema/src/Sema/mod.rs:182
pub const FAILURE_OBLIGATION_MARK: String = "inferred-failure-obligation:"

// Rust: crates/jet-sema/src/Sema/mod.rs:188
#Derive(Debug, Default, Clone)
pub struct FailureUnionProbe {
    members: [Type]
    cases: [FailureCase]
    edges: BTreeSet<(USize, String)>
    general: Bool
}
// Rust: crates/jet-sema/src/Sema/mod.rs:204
#Derive(Debug, Clone)
pub struct FailureCase {
    name: String
    payload: [(String?, Type)]
    span: Span
}
impl FailureUnionProbe {
    // Rust: crates/jet-sema/src/Sema/mod.rs:211
    pub fn add_member(self: &Self, ty: &Type) {
        if ty == {
            .Union(members) -> { loop member in members -> self.add_member(&member) }
            .String -> self.general = true
            .Named(name) -> {
                if name == Syntax.TYPE_ERR -> self.general = true
                else if name != Syntax.TYPE_NEVER && !self.members.contains(ty) -> &self.members.push(ty.clone())
            }
            else -> { if !self.members.contains(ty) -> &self.members.push(ty.clone()) }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/mod.rs:233
pub fn failure_inference_candidate(function: &Func, entry: Bool) -> Bool {
    contract :: function.failure_contract()
    defaulted_run :: entry && function.name == "run" && function.params.len() == 0 && function.return_type_span == None && (if function.return_type == { .Val(.Result(_, .Named(name))) -> name == Syntax.TYPE_ERR; else -> false })
    stream :: if function.return_type == { .Val(.Apply(name, _)) -> name == Syntax.TYPE_STREAM; else -> false }
    (contract.is_default() || defaulted_run) && !function.compiler_generated && !function.is_comptime && !function.is_job && function.every == None && function.inline_foreign == None && !function.gc_return && function.pre.len() == 0 && function.post.len() == 0 && function.web_marker == None && function.external_type == None && !stream
}

// Rust: crates/jet-sema/src/Sema/mod.rs:265
fn body_failure_edges(body: &[Stmt]) -> BTreeSet<String>? {
    edges := BTreeSet<String>.new()
    source := false
    loop stmt in body {
        stmt.for_each_expr(expr -> {
            if expr == {
                .Err(_, _) -> source = true
                .Lambda(lambda) -> { if lambda.meta.fallible_propagation -> source = true }
                .Try(inner, _, convert, _) -> {
                    if inner.without_parens() == .Call(call) -> _ :: &edges.insert(call.name)
                    else if convert != .Never -> source = true
                }
                else -> {}
            }
        })
        if source -> return None
    }
    Val(^edges)
}

// Rust: crates/jet-sema/src/Sema/mod.rs:292
fn failure_edge_owner(module: USize, edge: String, imports: &[String:USize], name_ledger: &NameLedger, owner_of: fn(USize, String) -> USize?) -> (USize, String)? {
    if edge.rsplit_once('.') == .Val((alias, leaf)) {
        target :: imports.get(alias) ?? return None
        return owner_of(target, leaf).map(owner -> (owner, leaf))
    }
    if owner_of(module, edge) == .Val(owner) -> return Val((owner, edge))
    alias :: name_ledger.alias(module, edge) ?? return None
    leaf :: alias.target.rsplit('.').next() ?? return None
    target :: alias.target_module ?? return None
    owner_of(target, leaf).map(owner -> (owner, leaf))
}

// Rust: crates/jet-sema/src/Sema/mod.rs:327
pub fn solve_inferred_failure(bundle: &ProgramBundle, module_summaries: &[(String, [String:EffectSummary])], address_taken: &[String:Bool], fixed: &[USize:[String:Bool]], name_ledger: &NameLedger, diags: &[Diagnostic]) -> [[String:Bool]] {
    module_count :: bundle.modules.len()
    declared := [[String:Bool]]{}
    empty := [[String:Bool]]{}
    candidates := [[String:BTreeSet<String>]]{}
    inferred := [[String:Bool]]{}
    loop module_idx in 0..module_count {
        module :: &bundle.modules[module_idx]
        summaries :: module_summaries.get(module_idx).map(pair -> &pair.1)
        entry :: module_idx == bundle.entry
        recorded :: fixed.get(module_idx)
        module_declared := [String:Bool]{}
        module_empty := [String:Bool]{}
        module_candidates := [String:BTreeSet<String>]{}
        loop item in module.items {
            if item != .Func(function) -> next
            &module_declared.insert(function.name, true)
            if function.failure_contract().is_proven_unreachable() {
                &module_empty.insert(function.name, true)
                next
            }
            row :: summaries.and_then(rows -> rows.get(function.name))
            if recorded != None || !failure_inference_candidate(&function, entry) || address_taken.contains_key(function.name) || row.is_none_or(row -> row.failure_direct) -> next
            if body_failure_edges(&function.body) == .Val(edges) -> &module_candidates.insert(function.name, ^edges)
        }
        module_inferred := [String:Bool]{}
        if recorded == .Val(recorded) -> module_inferred = recorded.clone()
        else { loop name in module_candidates.keys() -> &module_inferred.insert(name, true) }
        &inferred.push(^module_inferred)
        &declared.push(^module_declared)
        &empty.push(^module_empty)
        &candidates.push(^module_candidates)
    }
    imports := [[String:USize]]{}
    members := [[USize]]{}
    loop module_idx in 0..module_count {
        row := [String:USize]{}
        loop import in bundle.modules[module_idx].imports {
            if name_ledger.import_target(module_idx, import.span) == .Val(target) -> &row.insert(import.import_alias(), target)
        }
        &imports.push(^row)
        &members.push(name_ledger.namespace_siblings(module_idx))
    }
    owner_of :: fn(module: USize, leaf: String) -> USize? {
        if declared[module].contains_key(leaf) -> return Val(module)
        loop member in members[module] {
            if declared[member].contains_key(leaf) -> return Val(member)
        }
        None
    }
    resolved := [[(String, [(USize, String)?])]]{}
    loop module_idx in 0..module_count {
        rows := [(String, [(USize, String)?])]{}
        loop (name, edges) in candidates[module_idx] {
            targets := [(USize, String)?]{}
            loop edge in edges -> &targets.push(failure_edge_owner(module_idx, edge, &imports[module_idx], name_ledger, owner_of))
            &rows.push((name, ^targets))
        }
        &resolved.push(^rows)
    }
    loop {
        fallible := [(USize, String)]{}
        loop module_idx in 0..module_count {
            loop (name, edges) in resolved[module_idx] {
                if inferred[module_idx].contains_key(name) && edges.any(edge -> edge.is_none_or(pair -> !inferred[pair.0].contains_key(pair.1) && !empty[pair.0].contains_key(pair.1))) -> &fallible.push((module_idx, name))
            }
        }
        if fallible.len() == 0 -> break
        loop (module_idx, name) in fallible -> _ :: &inferred[module_idx].remove(name)
    }
    loop module_idx in 0..module_count {
        loop item in &bundle.modules[module_idx].items {
            if item != .Func(function) -> next
            if !inferred[module_idx].contains_key(function.name) -> next
            success :: if function.failure_contract() == {
                .Default(success, _) | .Explicit(success, _) -> success
                else -> next
            }
            function.return_type = Val(Type.Result(^success, Type.Named(Syntax.TYPE_NEVER)))
            function.return_type_span = None
        }
    }
    &diags.retain_mut(diagnostic -> {
        detail :: diagnostic.detail ?? return true
        rest :: detail.strip_prefix(FAILURE_OBLIGATION_MARK) ?? return true
        (obligation, remainder) :: rest.split_once('\n') ?? (rest, "")
        discharged :: obligation.split_once(':').is_some_and(pair -> pair.0.parse<USize>().ok().and_then(index -> inferred.get(index)).is_some_and(solved -> solved.contains_key(pair.1)))
        diagnostic.detail = Val(remainder.to_string())
        !discharged
    })
    ^inferred
}

