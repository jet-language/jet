    Enum(variants: [String:(Span, VariantPayload)], variant_order: [String], groups: [String:(Span, [String])], methods: [String:MethodSig], deprecation: Deprecation?, single_use: Bool, must_use: Bool, c_layout_tag: CEnumTag?)
    Distinct(base: Type, derives: [String], deprecation: Deprecation?, knowledge: KnowledgeVector)
