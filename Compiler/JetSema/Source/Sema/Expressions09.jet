// Rust: crates/jet-sema/src/Sema/mod.rs:1031
fn marker_argument(marker: &Marker, name: String, positional: USize) -> &Expr? {
    loop index in 0..marker.arg_labels.len() {
        if marker.arg_labels[index] == .Val((label, _)) {
            if label == name {
                if marker.expr_arg(index) == .Val(expr) -> return Val(expr)
            }
        }
    }
    marker.expr_arg(positional)
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1045
fn marker_string(expr: &Expr) -> String? {
    if expr == .Str(parts, _) {
        text := ""
        loop part in parts {
            if part == { .Lit(value) -> text += value; .Interp(_, _) -> return None }
        }
        return Val(^text)
    }
    None
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1061
fn deprecation_from_markers(markers: &[Marker]) -> Deprecation? {
    loop marker in markers {
        if marker.name != Syntax.MARKER_DEPRECATED -> next
        since_arg :: marker_argument(&marker, "since", 0) ?? return None
        since :: marker_string(since_arg) ?? return None
        use_arg :: marker_argument(&marker, "use", 1) ?? return None
        replacement :: marker_string(use_arg) ?? return None
        return Val(Deprecation{since: ^since, replacement: ^replacement, removed_in: marker_argument(&marker, "removed_in", 2).and_then(expr -> marker_string(expr))})
    }
    None
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1072
fn func_to_method_sig(f: &Func) -> MethodSig {
    self_param :: f.self_param()
    provenance := ViewProvenanceCell.new()
    if f.return_view_provenance == .Val(value) -> _ :: provenance.set(value.clone())
    params := [(AccessConvention, Type)]{}
    param_info := [(String, Bool)]{}
    param_call := [(String, ParamZone)]{}
    param_variadic := [Bool]{}
    defaults := [Expr?]{}
    loop p in f.params {
        base :: p.ty.with_effective_fn_returns()
        ty :: if p.variadic -> Type.List(^base) else -> ^base
        &params.push((p.convention, ^ty))
        if p.name == "self" -> next
        &param_info.push((p.name, p.default != None))
        &param_call.push((p.call_label(), p.zone))
        &param_variadic.push(p.variadic)
        &defaults.push(p.default.clone())
    }
    MethodSig{params: ^params, return_type: f.return_type.clone(), deprecation: deprecation_from_markers(&f.markers), type_params: f.type_params.clone(), is_static: self_param == None, self_conv: self_param.map(p -> p.convention), param_info: ^param_info, param_call: ^param_call, param_variadic: ^param_variadic, defaults: ^defaults, must_use: f.is_must_use, return_view_provenance: ^provenance}
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1117
pub fn func_to_sig(f: &Func) -> FuncSig {
    provenance := ViewProvenanceCell.new()
    if f.return_view_provenance == .Val(value) -> _ :: provenance.set(value.clone())
    policies := CallablePolicyChain.default()
    loop marker in f.markers {
        if marker.name == Syntax.MARKER_POLICY {
            policies = CallablePolicyChain.parse(&marker.expr_args_owned()).ok() ?? CallablePolicyChain.default()
            break
        }
    }
    params := [(AccessConvention, Type)]{}
    param_info := [(String, Bool)]{}
    param_call := [(String, ParamZone)]{}
    param_variadic := [Bool]{}
    defaults := [Expr?]{}
    view_names := [[String]?]{}
    loop p in f.params {
        base :: p.ty.with_effective_fn_returns()
        ty :: if p.variadic -> Type.List(^base) else -> ^base
        &params.push((p.convention, ^ty))
        &param_info.push((p.name, p.default != None))
        &param_call.push((p.call_label(), p.zone))
        &param_variadic.push(p.variadic)
        &defaults.push(p.default.clone())
        &view_names.push(p.declared_view_from_names.clone())
    }
    FuncSig{params: ^params, root_param: f.params.first().is_some_and(p -> p.root), param_info: ^param_info, param_call: ^param_call, defaults: ^defaults, param_variadic: ^param_variadic, variadic_bounds: f.params.last().and_then(p -> p.variadic_bound_list.clone()), return_type: f.return_type.clone(), return_view_provenance: ^provenance, deprecation: deprecation_from_markers(&f.markers), is_extern: f.inline_foreign != None, is_c_abi: false, c_abi_name: None, callback_transport: None, callback_plan_digest: None, callback_identity: None, foreign_effect_root: f.inline_foreign.map(foreign -> inline_foreign_effect_root(foreign.lang)), undo: f.undo.map(pair -> pair.0.clone()), is_unsafe: f.is_unsafe, is_pure: f.is_pure, memo_bound: memo_bound_from_markers(&f.markers), is_foreign_thread_safe: foreign_thread_safe_func(f), is_sanitizer: f.is_sanitizer, is_must_use: f.is_must_use, param_view_from_names: ^view_names, callable_policies: ^policies}
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1190
fn inline_foreign_effect_root(lang: String) -> String {
    if lang == { "c" -> "FFI.C"; "asm" -> "FFI.Asm"; "cpp" -> "FFI.Cpp"; else -> "FFI.{lang}" }
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1199
fn extern_to_sig(ef: &ExternFn, is_c_abi: Bool) -> FuncSig {
    params := [(AccessConvention, Type)]{}
    param_info := [(String, Bool)]{}
    param_call := [(String, ParamZone)]{}
    defaults := [Expr?]{}
    param_variadic := [Bool]{}
    view_names := [[String]?]{}
    loop p in ef.params {
        ty :: if p.variadic -> Type.List(p.ty.clone()) else -> p.ty.clone()
        &params.push((p.convention, ^ty))
        &param_info.push((p.name, false))
        &param_call.push((p.call_label(), p.zone))
        &defaults.push(None)
        &param_variadic.push(p.variadic)
        &view_names.push(None)
    }
    FuncSig{params: ^params, root_param: ef.params.first().is_some_and(p -> p.root), param_info: ^param_info, param_call: ^param_call, defaults: ^defaults, param_variadic: ^param_variadic, variadic_bounds: ef.params.last().and_then(p -> p.variadic_bound_list.clone()), return_type: ef.return_type.clone(), return_view_provenance: ViewProvenanceCell.new(), deprecation: None, is_extern: true, is_c_abi: is_c_abi, c_abi_name: ef.abi.map(pair -> pair.0.clone()), callback_transport: ef.callback_transport.clone(), callback_plan_digest: ef.callback_plan_digest.clone(), callback_identity: ef.callback_identity.clone(), foreign_effect_root: ef.effect_root.clone(), undo: ef.undo.map(pair -> pair.0.clone()), is_unsafe: ef.params.any(p -> p.convention != .Read) || (is_c_abi && ef.params.any(p -> if p.ty == { .Apply(name, _) -> name == Syntax.TYPE_PTR; else -> false })), is_pure: false, memo_bound: None, is_foreign_thread_safe: false, is_sanitizer: false, is_must_use: false, param_view_from_names: ^view_names, callable_policies: CallablePolicyChain.default()}
}

// Rust: crates/jet-sema/src/Sema/mod.rs:1254
fn foreign_thread_safe_expr(e: &Expr) -> Bool {
    if e == {
        .Int(_, _, _, _) | .Float(_, _, _, _) | .Bool(_, _) | .Char(_, _) | .Ident(_, _) -> true
        .Unary(_, a, _) | .Copy(a, _) -> foreign_thread_safe_expr(&a)
        .Binary(_, a, b, _) -> foreign_thread_safe_expr(&a) && foreign_thread_safe_expr(&b)
        .CompareChain(operands, _, _, _) -> operands.all(operand -> foreign_thread_safe_expr(&operand))
        else -> false
    }
}
// Rust: crates/jet-sema/src/Sema/mod.rs:1264
fn foreign_thread_safe_stmt(s: &Stmt) -> Bool {
    if s == { .Return(v, _) -> v.is_none_or(v -> foreign_thread_safe_expr(&v)); .Expr(e) -> foreign_thread_safe_expr(&e); .Val(b) -> foreign_thread_safe_expr(&b.init); else -> false }
}
// Rust: crates/jet-sema/src/Sema/mod.rs:1273
fn foreign_thread_safe_func(f: &Func) -> Bool { f.is_pure && f.type_params.len() == 0 && f.pre.len() == 0 && f.post.len() == 0 && f.body.all(stmt -> foreign_thread_safe_stmt(&stmt)) }
// Rust: crates/jet-sema/src/Sema/mod.rs:1281
pub fn foreign_thread_safe_lambda(lam: &Lambda) -> Bool {
    lam.take_names.len() == 0 && lam.meta.mut_captures.len() == 0 && lam.meta.cloned_captures.len() == 0 && (if lam.body == { .Expr(e) -> foreign_thread_safe_expr(&e); .Block(stmts) -> stmts.all(stmt -> foreign_thread_safe_stmt(&stmt)) })
}
// Rust: crates/jet-sema/src/Sema/mod.rs:1295
pub fn foreign_managed_callback_lambda(lam: &Lambda) -> Bool { lam.take_names.len() == 0 && lam.meta.mut_captures.len() == 0 && !lam.meta.effect_maximal && lam.meta.effect_solved.all(effect -> effect == "IO.Write" || effect == "FFI.C") }

// Rust: crates/jet-sema/src/Sema/mod.rs:1310
pub fn substitute_param_refs(expr: Expr, refs: &[(String, String)]) -> Expr {
    expr := ^expr
    expr.for_each_expr_mut(node -> {
        if node == .Ident(name, _) {
            loop (param, replacement) in refs {
                if param == name { name = replacement.clone(); break }
            }
        }
    })
    ^expr
}
// Rust: crates/jet-sema/src/Sema/mod.rs:1331
pub fn find_forward_refs(expr: &Expr, all_param_names: &[String], default_param_idx: USize) -> [(String, Span)] {
    found := [(String, Span)]{}
    find_forward_refs_inner(expr, all_param_names, default_param_idx, &found)
    ^found
}
// Rust: crates/jet-sema/src/Sema/mod.rs:1341
fn find_forward_refs_inner(expr: &Expr, all_param_names: &[String], default_param_idx: USize, found: &[(String, Span)]) {
    copy := expr.clone()
    copy.for_each_expr_mut(node -> {
        if node == .Ident(name, span) {
            loop idx in 0..all_param_names.len() {
                if all_param_names[idx] != name -> next
                if idx >= default_param_idx -> &found.push((name.clone(), span))
                break
            }
        }
    })
}

