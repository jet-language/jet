// Produce the checked operand contract for an already-admitted #FFI(asm) function.
// The caller supplies the selected target triple; unsupported targets are errors,
// never host-derived fallbacks.
pub fn sema_inline_assembly_contract(function: Func, target: String, diagnostics: &[Diagnostic]) -> ?InlineAsmContract {
    inline :: function.inline_foreign ?? return None
    if inline.lang != "asm" -> return None

    params := function.params
    used := [String]{}
    clobbers := [String]{}
    seen_clobbers := [String]{}
    return_anchors := 0
    return_destination := None
    bad := None
    target_supported := sema_inline_assembly_target_supported(target)

    loop raw_line in inline.source.split("\n") {
        line := raw_line.trim()
        if line.starts_with("; clobbers ") {
            prefix_len := "; clobbers ".bytes().len()
            bytes := line.bytes()
            rest := String.from_bytes(bytes.slice(prefix_len, bytes.len())) ?? ""
            loop raw in sema_inline_assembly_clobber_tokens(rest) {
                register := sema_inline_assembly_normalize_register(raw)
                if {
                    !target_supported || !sema_inline_assembly_register_known(target, register) -> {
                        bad = Val("`{raw}` isn't an audited register on this target")
                    }
                    seen_clobbers.contains(register) -> {
                        bad = Val("clobber register `{raw}` is listed more than once")
                    }
                    else -> {
                        seen_clobbers.push(register)
                        clobbers.push(register)
                    }
                }
            }
            next
        }

        if line.contains("; -> return") {
            return_anchors += 1
            parts := line.split("; -> return")
            operand := if parts.len() > 0 -> sema_inline_assembly_first_operand(parts[0].trim()) else -> None
            checked_destination := if operand == {
                None -> None
                Val(value) -> sema_inline_assembly_return_destination(value, params, target, target_supported)
            }
            if {
                checked_destination != None -> {
                    destination :: checked_destination ?? panic("checked assembly return destination disappeared")
                    if {
                        return_destination != None -> {
                            bad = Val("an assembly body can have only one checked return destination")
                        }
                        else -> {
                            return_destination = Val(destination)
                        }
                    }
                }
                else -> {
                    bad = Val("a value-returning assembly body needs a named output operand or an explicit audited target register")
                }
            }
        }

        rest := line
        loop {
            bytes := rest.bytes()
            open := -1
            index := 0
            loop index < bytes.len() {
                if Int.from_u8(bytes[index]) == 123 {
                    open = index
                    break
                }
                index += 1
            }
            if open < 0 -> break
            close := -1
            index = open + 1
            loop index < bytes.len() {
                if Int.from_u8(bytes[index]) == 125 {
                    close = index
                    break
                }
                index += 1
            }
            if close < 0 {
                bad = Val("an assembly operand has an unmatched `{{`")
                break
            }
            name := String.from_bytes(bytes.slice(open + 1, close)) ?? ""
            parameter_index = -1
            index = 0
            loop index < params.len() {
                if params[index].name == name {
                    parameter_index = index
                    break
                }
                index += 1
            }
            if {
                parameter_index < 0 -> {
                    bad = Val("`{{{name}}}` doesn't name a Jet parameter")
                }
                !used.contains(name) -> {
                    used.push(name)
                }
            }
            rest = String.from_bytes(bytes.slice(close + 1, bytes.len())) ?? ""
        }
    }

    unused_name := None
    loop parameter in params {
        if !used.contains(parameter.name) {
            unused_name = Val(parameter.name)
            break
        }
    }
    if unused_name == {
        Val(name) -> bad = Val("parameter `{name}` has no named `{{{name}}}` operand")
        None -> {}
    }

    returns_value := false
    if function.return_type == {
        None -> {}
        Val(return_type) -> returns_value = return_type != Type.Named("Unit")
    }
    if return_anchors != (if returns_value -> 1 else -> 0) {
        bad = Val(if returns_value -> "a value-returning assembly body needs exactly one `; -> return` anchor" else -> "a void assembly body can't declare a `; -> return` anchor")
    }
    if return_destination == {
        Val(destination) -> {
            if destination == {
                .Register(register) -> {
                    if clobbers.contains(register) -> bad = Val("return register `{register}` cannot also be an early-written clobber")
                }
                else -> {}
            }
        }
        else -> {}
    }
    if !target_supported -> bad = Val("inline assembly has no audited register set for target `{target}`")

    if bad == Val(problem) {
        diagnostics.push(sema_error("E3223", inline.source_span, "this inline assembly operand contract is incomplete", problem, "bind each Jet parameter as `{{name}}`, mark one result with `; -> return`, and list overwritten registers on `; clobbers …`"))
        return None
    }
    return Val(InlineAsmContract{target: target, output: return_destination, clobbers: clobbers})
}

fn sema_inline_assembly_target_supported(target: String) -> Bool {
    parts := target.split("-")
    arch := if parts.len() > 0 -> parts[0] else -> ""
    arch == "x86_64" || arch == "i386" || arch == "i586" || arch == "i686" || arch == "x86" || arch == "aarch64" || arch == "arm" || arch == "armv7" || arch.starts_with("thumb") || arch.starts_with("riscv64")
}

fn sema_inline_assembly_normalize_register(register: String) -> String {
    raw := register
    if raw.starts_with("%") {
        bytes := raw.bytes()
        raw = String.from_bytes(bytes.slice(1, bytes.len())) ?? ""
    }
    bytes := raw.bytes()
    index := 0
    loop index < bytes.len() {
        code := Int.from_u8(bytes[index])
        if code >= 65 && code <= 90 -> bytes[index] = U8{code + 32}
        index += 1
    }
    String.from_bytes(bytes) ?? raw
}

fn sema_inline_assembly_register_number(register: String, prefix: String, lo: Int, hi: Int) -> Bool {
    if !register.starts_with(prefix) -> return false
    bytes := register.bytes()
    prefix_len := prefix.bytes().len()
    if bytes.len() <= prefix_len -> return false
    index := prefix_len
    loop index < bytes.len() {
        code := Int.from_u8(bytes[index])
        if code < 48 || code > 57 -> return false
        index += 1
    }
    suffix := String.from_bytes(bytes.slice(prefix_len, bytes.len())) ?? ""
    number := Int.parse(suffix) ?? return false
    number >= lo && number <= hi
}

fn sema_inline_assembly_register_known(target: String, register: String) -> Bool {
    parts := target.split("-")
    arch := if parts.len() > 0 -> parts[0] else -> ""
    name := sema_inline_assembly_normalize_register(register)
    if arch == "x86_64" {
        return name == "rax" || name == "eax" || name == "ax" || name == "al" || name == "ah" || name == "rbx" || name == "ebx" || name == "bx" || name == "bl" || name == "bh" || name == "rcx" || name == "ecx" || name == "cx" || name == "cl" || name == "ch" || name == "rdx" || name == "edx" || name == "dx" || name == "dl" || name == "dh" || name == "rsi" || name == "esi" || name == "si" || name == "sil" || name == "rdi" || name == "edi" || name == "di" || name == "dil" || name == "r8" || name == "r8d" || name == "r8w" || name == "r8b" || name == "r9" || name == "r9d" || name == "r9w" || name == "r9b" || name == "r10" || name == "r10d" || name == "r10w" || name == "r10b" || name == "r11" || name == "r11d" || name == "r11w" || name == "r11b" || name == "r12" || name == "r12d" || name == "r12w" || name == "r12b" || name == "r13" || name == "r13d" || name == "r13w" || name == "r13b" || name == "r14" || name == "r14d" || name == "r14w" || name == "r14b" || name == "r15" || name == "r15d" || name == "r15w" || name == "r15b"
    }
    if arch == "i386" || arch == "i586" || arch == "i686" || arch == "x86" {
        return name == "eax" || name == "ax" || name == "al" || name == "ah" || name == "ebx" || name == "bx" || name == "bl" || name == "bh" || name == "ecx" || name == "cx" || name == "cl" || name == "ch" || name == "edx" || name == "dx" || name == "dl" || name == "dh" || name == "esi" || name == "si" || name == "sil" || name == "edi" || name == "di" || name == "dil"
    }
    if arch == "aarch64" -> return sema_inline_assembly_register_number(name, "x", 0, 30) || sema_inline_assembly_register_number(name, "w", 0, 30)
    if arch == "arm" || arch == "armv7" || arch.starts_with("thumb") -> return sema_inline_assembly_register_number(name, "r", 0, 12) || name == "r14"
    if arch.starts_with("riscv64") -> return sema_inline_assembly_register_number(name, "x", 1, 31)
    false
}

fn sema_inline_assembly_ascii_whitespace(byte: U8) -> Bool {
    code := Int.from_u8(byte)
    code == 32 || (code >= 9 && code <= 13)
}

fn sema_inline_assembly_clobber_tokens(text: String) -> [String] {
    tokens := [String]{}
    bytes := text.bytes()
    start := 0
    index := 0
    loop index < bytes.len() {
        if Int.from_u8(bytes[index]) == 44 || sema_inline_assembly_ascii_whitespace(bytes[index]) {
            if index > start -> tokens.push(String.from_bytes(bytes.slice(start, index)) ?? "")
            start = index + 1
        }
        index += 1
    }
    if start < bytes.len() -> tokens.push(String.from_bytes(bytes.slice(start, bytes.len())) ?? "")
    tokens
}

fn sema_inline_assembly_first_operand(line: String) -> ?String {
    bytes := line.bytes()
    separator := -1
    index := 0
    loop index < bytes.len() {
        if sema_inline_assembly_ascii_whitespace(bytes[index]) {
            separator = index
            break
        }
        index += 1
    }
    if separator < 0 -> return None
    operands := String.from_bytes(bytes.slice(separator + 1, bytes.len())) ?? ""
    fields := operands.split(",")
    if fields.len() == 0 -> return None
    operand := fields[0].trim()
    if operand == "" -> None else -> Val(operand)
}

fn sema_inline_assembly_return_destination(operand: String, params: [Param], target: String, target_supported: Bool) -> ?InlineAsmOutput {
    bytes := operand.bytes()
    if operand.starts_with("{") && operand.ends_with("}") {
        name := String.from_bytes(bytes.slice(1, bytes.len() - 1)) ?? ""
        index := 0
        loop index < params.len() {
            if params[index].name == name -> return Val(InlineAsmOutput.Parameter(index))
            index += 1
        }
        return None
    }
    register := sema_inline_assembly_normalize_register(operand)
    if target_supported && sema_inline_assembly_register_known(target, register) -> return Val(InlineAsmOutput.Register(register))
    None
}
