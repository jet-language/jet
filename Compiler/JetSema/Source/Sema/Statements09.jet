            field_ty :: if place == { .Expr(expr) -> ~expr.ty; .Local(local) -> env.ty_of(local.name).unwrap_or(.Int) }
            clone_value :: if value == { .Ident(vname, _) -> env.is_borrowed(vname) && env.ty_of(vname).is_some_and(t -> !t.is_scalar()); _ -> false }
            value_t :: lower_expr(value, cx, &env)
            value_t :: preserve_typed_list_shape(value_t, field_ty, cx)
