        .Field{base, field, span} -> {
            if base == .Index{base: collection, index, kind, span: index_span} {
                is_map :: kind == .Map
                index_proven :: kind == .FixedListProof
                if is_map || index_proven || kind == .List {
                    collection_t :: lower_expr_as_mut_place(collection, cx, &env)
                    elem_ty :: if collection_t.ty == {
                        .List(elem) | .FixedList{elem, ..} -> Val(~elem)
                        .Map{value, ..} -> Val(~value)
                        .Apply{name, args} if (name == "View" || name == "ViewMut" || name == "ComputeViewMut") && args.len() == 1 -> Val(~args[0])
                        _ -> None
                    }
                    if elem_ty == .Val(elem_ty) {
                        field_ty :: struct_field_type(cx, elem_ty, field).unwrap_or(.Int)
                        clone_value :: if value == { .Ident(vname, _) -> env.is_borrowed(vname) && env.ty_of(vname).is_some_and(t -> !t.is_scalar()); _ -> false }
                        line :: cx.src_line_col(index_span.start).0
                        value_t :: lower_expr(value, cx, &env)
                        value_t :: preserve_typed_list_shape(value_t, field_ty, cx)
                        return .IndexFieldAssign(TIndexFieldAssign.{base: collection_t, index: lower_expr(index, cx, &env), is_map, index_proven, field: field.to_string(), field_ty, op, value: value_t, clone_value, line})
                    }
