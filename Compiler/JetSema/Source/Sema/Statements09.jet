// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1812
pub fn lower_return_value(e: Expr, cx: Cx, env: &LowerEnv) -> TStmt {
    if e == .Ident(name, _) && env.gc_return && env.is_gc(name) {
        return .Return(Val(TExpr.{ty: env.ty_of(name).unwrap_or(.Int), kind: .Local(env.local_of(name))}))
    }
    return in_own_frame(() -> {
        annotated :: annotate_return_todo(e, env.ret_ty)
        value := lower_owned_expr(annotated.unwrap_or(e), cx, &env)
        suppress_module_call_target_return(&value)
        if env.ret_ty.is_some_and(want -> if want == { .Named(name) -> name == "HTTPHandler" && value.ty == .Fn{..}; _ -> false }) {
            value = force_thread_callback_value(^value, cx)
        }
        if env.ret_ty == .Val(want) {
            if value.kind == .Absent && want == .Option(_) -> value.ty = ~want
            payload :: if want == { .Result{ok, ..} | .Option(ok) -> ok; other -> other }
            value = preserve_typed_list_shape(^value, payload, cx)
            value = maybe_widen_expr_to_union(^value, want)
            carrier_slot :: if want == { .Result{ok, ..} -> ok; other -> other }
            value = box_present_trait_payload(^value, carrier_slot, cx)
            if want == .Result{..} {
                if value.kind == .Ok(_) || value.kind == .Err(..) {
                    value.ty = ~want
                } else if value.ty != .Result{..} {
                    value = TExpr.{ty: ~want, kind: .Ok(^value)}
                }
                if value.kind == .Err(_, origin) {
                    (line, column) :: cx.src_line_col(e.span().start)
                    origin = Val(TFailureOrigin.{file: escape_rust_str(cx.file), line, column, fn_name: escape_rust_str(env.fn_name)})
                }
            }
        }
        is_never :: if value.ty == { .Named(name) -> name == Syntax.TYPE_NEVER; _ -> false }
        if value.ty != .Result{..} && value.ty != .Option(_) && !is_never {
            if !tir_expr_reaches_merge(value) -> return .ExprStmt(^value)
            result :: TLocal.generated("result")
            result_name :: ~result.name
            result_value :: TExpr.{ty: ~value.ty, kind: .Local(TLocal.user(result_name))}
            return .Inline([.Let{name: result_name, kw: "let", let_ty: .Inferred, init: ^value, gc_promotion: None, gc_transferred: false}, .Return(Val(result_value))])
        }
        return .Return(Val(^value))
    })
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1913
pub fn lower_stmts(stmts: [Stmt], cx: Cx, env: &LowerEnv) -> [TStmt] {
    before_payload :: if CanonicalPass.enabled() { Val(CanonicalPass.debug_payload("ast", "tir.lower-statements", stmts)) } else { None }
    before_identity :: if CanonicalPass.enabled() { Val(CanonicalPass.debug_identity("ast", "tir.lower-statements", stmts)) } else { None }
    lowered := lower_stmts_with_markers(stmts, cx, &env, true)
    targets :: env.resource_take_targets()
    mark_resource_bindings_mutable(&lowered, targets)
    if (before_payload, before_identity) == (.Val(payload), .Val(identity)) {
        CanonicalPass.record("lowering", "tir.lower-statements", "crates/jet-codegen/src/Codegen/TIR/lower/statements.rs", "ast", payload, identity, "tir", canonical_statements_payload(lowered), canonical_statements_identity(lowered), "preserve")
    }
    return ^lowered
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1942
pub struct SplitViewCandidate {
    pub stmt_index: USize
    pub owner: Expr
    pub owner_key: String
    pub name: String
    pub ty: Type?
    pub start: I64
    pub end: I64
    pub single: Bool
    pub write: Bool
    pub line: USize
    pub last_use: USize
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1956
pub struct PlannedSplitView {
    pub candidate: SplitViewCandidate
    pub root: String
    pub len: String
    pub source: String
    pub source_start: I64
    pub before: String
    pub split_tail: String
    pub segment: String
    pub after: String
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1968
struct SplitRegion { name: String, start: I64, end: I64? }

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1975
fn const_place_bound(input: Expr) -> I64? {
    expr := input
    negations: USize := 0
    value: I64 := loop {
        if expr == {
            .Int(value, ..) -> break value
            .Unary(.Neg, inner, _) -> { negations += 1; expr = inner }
            .Paren(inner, _) -> expr = inner
            _ -> return None
        }
    }
    loop _ in 0..<negations -> value = value.checked_neg()?
    return Val(value)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:1995
fn split_owner_key(input: Expr) -> String? {
    expr := input
    suffixes: [String] := []
    key := loop {
        if expr == {
            .Ident(name, _) -> break "name:{name}"
            .Field(base, field, _) -> { suffixes.push(".field:{field}"); expr = base }
            .Index{base, index, ..} -> { suffixes.push(".index:{const_place_bound(index)?}"); expr = base }
            .Paren(inner, _) | .Place(inner, _, _) -> expr = inner
            _ -> return None
        }
    }
    loop suffix in suffixes.iter().rev() -> key.push_str(suffix)
    return Val(^key)
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2020
fn split_owner_root(input: Expr) -> String? {
    expr := input
    loop {
        if expr == {
            .Ident(name, _) -> return Val(~name)
            .Field(base, _, _) | .Index{base, ..} -> expr = base
            .Paren(inner, _) | .Place(inner, _, _) -> expr = inner
            _ -> return None
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2037
// mem.pin adds a no-move promise; its runtime shape is the same write window.
pub fn place_window_init(init: Expr, cx: Cx) -> (Expr, PlaceAccess)? {
    return if init == {
        .Place(inner, access, _) -> Val((inner, access))
        .MethodCall{receiver, method, args, ..} if method == Syntax.MEM_PIN && (if receiver == {
            .Ident(alias, _) -> cx.any_core_import_module(alias).is_some_and(m -> m == Syntax.CORE_MEM_MODULE)
            _ -> false
        }) -> {
            inner :: args.first()?.expr
            Val((if inner == { .Place(place, _, _) -> place; other -> other }, .Write))
        }
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2064
fn split_view_candidate(stmt: Stmt, stmt_index: USize, cx: Cx) -> SplitViewCandidate? {
    if stmt != .Val(binding) -> return None
    (inner, access) :: place_window_init(binding.init, cx)?
    (base, start, end, single) :: if inner == {
        .Slice{base, start, end, range, ..} -> {
            (a, b) :: if range == {
                .Val(.Range{start, end, exclusive, ..}) -> {
                    a :: const_place_bound(start)?
                    b :: const_place_bound(end)?
                    (a, if exclusive { b.checked_sub(1)? } else { b })
                }
                .Val(_) -> return None
                .None -> (const_place_bound(start)?, const_place_bound(end)?)
            }
            (base, a, b, false)
        }
        .Index{base, index, ..} -> { i :: const_place_bound(index)?; (base, i, i, true) }
        _ -> return None
    }
    owner_key :: split_owner_key(base)?
    return Val(SplitViewCandidate.{stmt_index, owner: ~base, owner_key, name: ~binding.name, ty: ~binding.ty, start, end, single, write: access == .Write, line: cx.src_line_col(binding.name_span.start).0, last_use: stmt_index})
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2115
pub fn split_view_plan(stmts: [Stmt], cx: Cx, env: LowerEnv) -> [USize: PlannedSplitView] {
    // The temporary type environment advances in source order to preserve shadows.
    owner_env := ~env
    owner_generation: [String: USize] := [:]
    candidates: [SplitViewCandidate] := []
    loop (index, stmt) in stmts.iter().enumerate() {
        if split_view_candidate(stmt, index, cx) == .Val(view) {
            view := ^view
            is_tensor :: tir_recv_jet_ty(view.owner, owner_env).is_some_and(ty -> ty.is_compute_tensor_family())
            if !is_tensor && view.start >= 0 && view.end >= view.start {
                root :: split_owner_root(view.owner).unwrap_or_default()
                generation :: owner_generation.get(root).copied().unwrap_or_default()
                view.owner_key = "{view.owner_key}@{generation}"
                candidates.push(^view)
            }
        }
        if stmt == .Val(binding) {
            generation :: owner_generation.get(binding.name).copied().unwrap_or(0)
            owner_generation.insert(~binding.name, generation + 1)
            owner_env.bind(binding.name, TLocal.user(binding.name), ~binding.ty)
        }
    }
    loop candidate in &candidates {
        last: USize := candidate.stmt_index
        loop index in candidate.stmt_index + 1..<stmts.len() {
            if stmt_references_name_deep(stmts[index], candidate.name) -> last = index
        }
        candidate.last_use = last
    }
    parent: [USize] := (0..<candidates.len()).collect()
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2162
    fn find(parent: &[USize], initial: USize) -> USize {
        index := initial
        loop while parent[index] != index { parent[index] = parent[parent[index]]; index = parent[index] }
        return index
    }
    // Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2169
    fn union(parent: &[USize], first: USize, second: USize) {
        a :: find(&parent, first)
        b :: find(&parent, second)
        if a != b -> parent[b] = a
    }
    loop a in 0..<candidates.len() {
        loop b in a + 1..<candidates.len() {
            earlier :: candidates[a]
            later :: candidates[b]
            if earlier.owner_key == later.owner_key && earlier.last_use >= later.stmt_index && (earlier.write || later.write) && (earlier.end < later.start || later.end < earlier.start) -> union(&parent, a, b)
        }
    }
    grouped: [USize: [USize]] := [:]
    loop index in 0..<candidates.len() {
        root :: find(&parent, index)
        grouped.entry(root).or_default().push(index)
    }
    groups: [[USize]] := grouped.into_values().collect()
    groups.sort_by_key(group -> group.iter().map(index -> candidates[index].stmt_index).min().unwrap_or(USize.MAX))
    planned: [USize: PlannedSplitView] := [:]
    loop (plan_index, group) in groups.into_iter().enumerate() {
        group := ^group
        lone_write :: group.len() == 1 && candidates[group[0]].write
        overlaps :: group.iter().enumerate().any((i, a) -> group.iter().skip(i + 1).any(b -> !(candidates[a].end < candidates[b].start || candidates[b].end < candidates[a].start)))
        if (group.len() < 2 && !lone_write) || overlaps -> continue
        group.sort_by_key(index -> candidates[index].stmt_index)
        root :: mangle_generated("place_plan_{plan_index}_root")
        len :: mangle_generated("place_plan_{plan_index}_len")
        regions: [SplitRegion] := [SplitRegion.{name: ~root, start: 0, end: None}]
        loop (step, candidate_index) in group.into_iter().enumerate() {
            candidate :: ~candidates[candidate_index]
            region_index :: regions.iter().position(region -> candidate.start >= region.start && region.end.is_none_or(end -> candidate.end <= end))
            if region_index != .Val(index) -> continue
            region :: regions.remove(index)
            prefix :: mangle_generated("place_plan_{plan_index}_{step}_before")
            split_tail :: mangle_generated("place_plan_{plan_index}_{step}_tail")
            segment :: mangle_generated("place_plan_{plan_index}_{step}_segment")
            suffix :: mangle_generated("place_plan_{plan_index}_{step}_after")
            if candidate.start > region.start -> regions.push(SplitRegion.{name: ~prefix, start: region.start, end: Val(candidate.start - 1)})
            if region.end.is_none_or(end -> candidate.end < end) -> regions.push(SplitRegion.{name: ~suffix, start: candidate.end + 1, end: region.end})
            planned.insert(candidate.stmt_index, PlannedSplitView.{candidate, root: ~root, len: ~len, source: region.name, source_start: region.start, before: prefix, split_tail, segment, after: suffix})
        }
    }
    return ^planned
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2278
pub fn preserve_typed_list_shape(input: TExpr, expected: Type, cx: Cx) -> TExpr {
    if expected != .List(_) && expected != .FixedList{..} -> return ^input
    if input.ty == .Result{..} || input.ty == .Option(_) -> return ^input
    expr := if input.kind == {
        .ListLit(elems) if elems.len() == 1 && elems[0].ty == expected -> elems.pop().unwrap()
        _ -> ^input
    }
    expected_elem :: if expected == { .List(elem) | .FixedList{elem, ..} -> elem; _ -> return ^expr }
    if expected_elem == .IntN{..} || expected_elem == .InlineRange{..} || expected_elem == .List(_) || expected_elem == .FixedList{..} {
        if expr.kind == .ListLit(elems) {
            loop elem in &elems {
                if (elem.kind, expected_elem) == {
                    (.IntLit(_, width), .IntN{signed, bits}) -> { width = Val((signed, bits)); elem.ty = ~expected_elem }
                    (.IntLit(_, width), .InlineRange{..}) -> { width = None; elem.ty = ~expected_elem }
                    (.ListLit(_), .List(_) | .FixedList{..}) -> elem = preserve_typed_list_shape(^elem, expected_elem, cx)
                    _ -> {}
                }
            }
            expr.ty = ~expected
            return ^expr
        }
    }
    trait_name :: if expected_elem == {
        .TraitObject(names) if names.len() == 1 -> names.first()
        .Named(name) if cx.trait_names.contains(name) -> Val(name)
        _ -> None
    }
    if trait_name != .Val(trait_name) { expr.ty = ~expected; return ^expr }
    if expr.kind != .ListLit(elems) { expr.ty = ~expected; return ^expr }
    loop elem in &elems {
        concrete :: if elem.ty == { .Named(name) | .Apply{name, ..} -> Val(~name); _ -> None }
        if (concrete, elem.kind) != (.Val(concrete), .StructLit{as_trait, ..}) -> continue
        if as_trait.is_none() { as_trait = Val((~trait_name, concrete)); elem.ty = .TraitObject([~trait_name]) }
    }
    expr.ty = ~expected
    return ^expr
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2378
fn is_refutable_unwrap_pattern(pattern: Pattern) -> Bool {
    if pattern.has_nested_pattern() -> return false
    return if pattern == {
        .Ok{..} | .Present{..} -> true
        .Variant{variant, bindings, ..} if bindings.len() == 1 && (variant == Syntax.LIT_OK || variant == Syntax.LIT_VALUE || variant == "value") -> true
        _ -> false
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2398
fn refutable_binding_name(pattern: Pattern, init: TExpr) -> String? {
    return if pattern == {
        .Ok{binding, ..} | .Present{binding, ..} -> Val(binding)
        .Variant{bindings, ..} -> bindings.first().and_then(slot -> slot.as_bind())
        _ -> None
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2408
fn is_direct_refutable_pattern(pattern: Pattern, cx: Cx) -> Bool {
    return if pattern == { .Variant{variant, ..} -> cx.variant_owner.contains_key(variant); _ -> false }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2415
fn lower_refutable_fallback(fallback: OrFallback, cx: Cx, env: LowerEnv) -> [TStmt] {
    fallback_env := clone_env(env)
    unreachable :: () -> TStmt.ExprStmt(TExpr.{ty: unit_type(), kind: .Unreachable{line: 0}})
    return if fallback == {
        .Return(value, _) -> [.Return(value.map(v -> lower_expr(v, cx, &fallback_env)))]
        .Panic{name_span, args} -> {
            (kind, loc) :: lower_panic_stop(name_span, args, cx, &fallback_env)
            assert(kind == .Panic{..})
            [.ExprStmt(TExpr.{ty: unit_type(), kind: .RequireStop{kind, loc, always_stops: true}})]
        }
        .Break(_) -> [.Break(None)]
        .Continue(_) -> [.Continue(None)]
        .BreakLabel(name, _) -> [.Break(Val(~name))]
        .ContinueLabel(name, _) -> [.Continue(Val(~name))]
        .Value(value) -> [.ExprStmt(lower_expr(value, cx, &fallback_env)), unreachable()]
        .Block{body, value, ..} -> {
            out := lower_stmts(body, cx, &fallback_env)
            if value == .Val(v) { out.push(.ExprStmt(lower_expr(v, cx, &fallback_env))); out.push(unreachable()) }
            ^out
        }
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2460
const INT_SMALL_MIN: I128 = -(1 as I128 << 62)
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2461
const INT_SMALL_MAX: I128 = (1 as I128 << 62) - 1
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2463
fn interval_fits_inline(bounds: TIntegerBounds) -> Bool { return bounds.lo >= INT_SMALL_MIN && bounds.hi <= INT_SMALL_MAX }
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2467
pub fn range_iteration_bounds(start: TExpr, end: TExpr, step: TExpr?, exclusive: Bool) -> TIntegerBounds? {
    start :: integer_bounds_for_expr(start)?
    end :: integer_bounds_for_expr(end)?
    step :: if step == { .Val(s) -> integer_bounds_for_expr(s)?; .None -> TIntegerBounds.exact(1) }
    if !interval_fits_inline(start) || !interval_fits_inline(end) || !interval_fits_inline(step) -> return None
    (lo, hi) :: if step.lo >= 1 { (start.lo, if exclusive { end.hi.checked_sub(1)? } else { end.hi }) } else if step.hi <= -1 { (if exclusive { end.lo.checked_add(1)? } else { end.lo }, start.hi) } else { return None }
    bounds :: TIntegerBounds.{lo, hi}
    return if lo <= hi && interval_fits_inline(bounds) { Val(bounds) } else { None }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2507
fn refine_loop_local(env: &LowerEnv, local_expr: TExpr, lower: I128?, upper: I128?) {
    if local_expr.kind != .Local(local) -> return
    if local.deref || local.is_persistent() -> return
    if integer_bounds_for_expr(local_expr) != .Val(current) -> return
    current := current
    if lower == .Val(lo) -> current.lo = current.lo.max(lo)
    if upper == .Val(hi) -> current.hi = current.hi.min(hi)
    if current.lo <= current.hi -> env.set_integer_bounds(local.name, Val(current))
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2533
fn refine_loop_comparison(env: &LowerEnv, op: BinOp, lhs: TExpr, rhs: TExpr) {
    rhs_bounds :: integer_bounds_for_expr(rhs)
    if lhs.kind == .Local(_) {
        if rhs_bounds == .Val(bounds) {
            if op == {
                .Lt -> refine_loop_local(&env, lhs, None, bounds.hi.checked_sub(1))
                .Le -> refine_loop_local(&env, lhs, None, Val(bounds.hi))
                .Gt -> refine_loop_local(&env, lhs, bounds.lo.checked_add(1), None)
                .Ge -> refine_loop_local(&env, lhs, Val(bounds.lo), None)
                .Eq -> refine_loop_local(&env, lhs, Val(bounds.lo), Val(bounds.hi))
                _ -> {}
            }
        }
        return
    }
    if integer_bounds_for_expr(lhs) != .Val(bounds) -> return
    if rhs.kind != .Local(_) -> return
    if op == {
        .Lt -> refine_loop_local(&env, rhs, bounds.lo.checked_add(1), None)
        .Le -> refine_loop_local(&env, rhs, Val(bounds.lo), None)
        .Gt -> refine_loop_local(&env, rhs, None, bounds.hi.checked_sub(1))
        .Ge -> refine_loop_local(&env, rhs, None, Val(bounds.hi))
        .Eq -> refine_loop_local(&env, rhs, Val(bounds.lo), Val(bounds.hi))
        _ -> {}
    }
}
// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2571
pub fn refine_loop_condition(env: &LowerEnv, condition: TExpr) {
    if condition.kind == .Binary{op: .And, lhs, rhs, ..} {
        refine_loop_condition(&env, lhs)
        refine_loop_condition(&env, rhs)
        return
    }
    if condition.kind != .Binary{op, lhs, rhs, ..} -> return
    refine_loop_comparison(&env, op, lhs, rhs)
}

// Rust: crates/jet-codegen/src/Codegen/TIR/lower/statements.rs:2589
pub fn lower_stmt_plan(s: Stmt, cx: Cx, env: &LowerEnv) -> LowerStmtPlan {
    if s == .Assign{target, value, ..} {
        root_name :: if target == {
            .Local{name, ..} -> Val(name)
            .Index{base, ..} | .Field{base, ..} -> if base == { .Ident(name, _) -> Val(name); _ -> None }
        }
        if root_name.filter(name -> env.is_gc(name)) == .Val(name) {
            return in_own_frame(() -> {
                root :: env.place_of(name)
                edges :: env.gc_edges_for_expr(value, Val(name))
                slot :: if target == { .Local{name, ..} -> "local:{name}"; .Field{field, ..} -> "field:{field}"; .Index{span, ..} -> "index:{span.start}" }
                lowered_source := ~s
                index_temp: (String, TExpr)? := None
                if (target, lowered_source) == (.Index{index, span, ..}, .Assign{target: .Index{index: lowered_index, ..}, ..}) {
                    lowered :: lower_expr(index, cx, &env)
                    source_name :: mangle_generated("gc_index_{span.start}")
                    rust_name :: ~source_name
                    lowered_index = .Ident(~source_name, span)
                    env.bind(source_name, TLocal.generated(rust_name), Val(~lowered.ty))
                    index_temp = Val((rust_name, lowered))
                }
                saved :: env.locals.get(name).cloned()
                env.gc_locals.remove(name)
                replacement :: saved.map((slot, _) -> ~slot).unwrap_or_else(() -> TLocal.user(name))
                env.bind(name, replacement, saved.and_then((_, ty) -> ~ty))
                plan :: lower_stmt_plan(lowered_source, cx, &env)
