// Strong `Shared` cycles close at writes, not at declarations.
//
// A new cell is reachable from nothing, so building a graph by construction
// (prepending to a list, adding a new child) never closes a loop. A cycle needs
// a write that stores, into a cell that already exists, a value that can reach
// that cell again through strong `Shared` handles. Such a write into a cell of
// type `T`, whose place can hold a strong edge back to a `T`, must store a
// value built in place (E0221): literals, new cells whose fields are built the
// same way, values whose type cannot reach a `T`, and `:` names bound to a
// new cell and read nowhere else since.
use jet_foundation.[
    CallArg,
    Diagnostic,
    EnumLitArg,
    Expr,
    LValue,
    Span,
    Type,
    expr_source_span,
    expr_span,
    type_name,
]

// Loops and callbacks run a body again after a name in an outer scope was
// stored; a cell bound outside one of these is not new on the next run.
sema_shared_cycle_repeating_frame: fn(owner: String) -> Bool Never! {
    owner.starts_with("lambda@") || owner.starts_with("loop@") || owner.starts_with("for@") || owner.starts_with("for.in@") || owner.starts_with("counted@") || owner.starts_with("while@")
}

// True when the current scope reaches `frame` through scopes that each run
// once per run of `frame`.
sema_shared_cycle_frame_runs_once: fn(scopes: SemaScopeTable, frame: Int) -> Bool Never! {
    cursor := scopes.current
    loop cursor >= 0 {
        if cursor == frame -> return true
        if sema_shared_cycle_repeating_frame(scopes.frames[cursor].owner) -> return false
        cursor = scopes.frames[cursor].parent
    }
    false
}

// The registered key of the cell type `owner_ty`.
sema_shared_cycle_owner_key: fn(owner_ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> String? {
    if program.registration_graph == .Val(graph) {
        row: sema_type_resolve_nominal_row(graph, owner_ty, environment.module_identity) ?? return None
        return Val(graph.modules[row.module_index].nominals[row.row].symbol.id.key)
    }
    None
}

// True when a value of type `ty` can hold a strong `Shared` path to a cell of
// the type registered as `owner`.
sema_shared_cycle_reaches: fn(owner: String, ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
        memo := [String:Bool]{}
        walk := SemaSharedWitnessWalk{stack: [String]{}, clear: [String:Bool]{}, met_path: false}
        return sema_checked_shared_witness(graph, owner, environment.module_identity, ty, memo, walk) != None
    }
    false
}

// The cell a write into `place` lands in and the written place's type: the
// innermost `Shared<T>` handle or editing guard's `.value` on the place's path.
sema_shared_cycle_place: fn(place: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> (owner: Type, place: Type)? {
    if place == {
        .Paren(inner, _, _) -> return sema_shared_cycle_place(inner, environment, program, scopes)
        .Field(base, member, _, _) -> return sema_shared_cycle_field_place(base, member, environment, program, scopes)
        .Index(base, _, _, _, _) -> return sema_shared_cycle_element_place(base, environment, program, scopes)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

sema_shared_cycle_field_place: fn(base: Expr, member: String, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> (owner: Type, place: Type)? {
    base_ty: sema_shared_access_place_type(base, environment, program, scopes)
    if base_ty == .Val(known) {
        if known == .Shared(inner) {
            field: sema_shared_access_field_type(inner, member, environment, program, scopes) ?? return None
            return Val((owner: inner, place: field))
        }
        if member == "value" {
            if sema_expression_shared_guard_value(known) == .Val(guard) {
                if guard.editable -> return Val((owner: guard.value_type, place: guard.value_type))
            }
        }
    }
    outer: sema_shared_cycle_place(base, environment, program, scopes) ?? return None
    field: sema_shared_access_field_type(outer.place, member, environment, program, scopes) ?? return None
    Val((owner: outer.owner, place: field))
}

sema_shared_cycle_element_place: fn(base: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> (owner: Type, place: Type)? {
    outer: sema_shared_cycle_place(base, environment, program, scopes) ?? return None
    if outer.place == {
        .List(element) | .FixedList(element, _) | .Map(_, _, element) -> Val((owner: outer.owner, place: element))
        .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

sema_shared_cycle_option_inner: fn(ty: Type?) -> Type? Never! {
    if ty == .Val(known) {
        if known == .Option(inner) -> return Val(inner)
    }
    None
}

sema_shared_cycle_shared_inner: fn(ty: Type?) -> Type? Never! {
    if ty == .Val(known) {
        if known == .Shared(inner) -> return Val(inner)
    }
    None
}

sema_shared_cycle_element: fn(ty: Type?) -> Type? Never! {
    if ty == .Val(known) {
        if known == {
            .List(element) | .FixedList(element, _) | .Map(_, _, element) -> return Val(element)
            .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
        }
    }
    None
}

sema_shared_cycle_enum_arg: fn(argument: EnumLitArg) -> Expr Never! {
    if argument == {
        .Positional(value) -> value
        .Named(_, value) -> value
    }
}

// True when every recorded reference of binding `key` lies inside one of the
// `allowed` spans: the arguments of the write being checked and the
// initializers of the new cells that took the binding.
sema_shared_cycle_unread: fn(state: SemaOwnershipState, key: String, allowed: [Span]) -> Bool Never! {
    loop reference in state.references {
        if reference.def_key != key -> next
        inside := false
        loop span in allowed {
            if reference.use_span.start >= span.start && reference.use_span.end <= span.end {
                inside = true
                break
            }
        }
        if !inside -> return false
    }
    true
}

// True when `value` builds only new storage relative to `owner`: see the file
// comment. `ty` is the type the value is stored as, when known; `allowed`
// holds the spans a fresh name's references may lie in (sema_shared_cycle_unread).
sema_shared_cycle_fresh: fn(value: Expr, ty: Type?, owner: String, allowed: [Span], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: SemaOwnershipState) -> Bool {
    if ty == .Val(known) && !sema_shared_cycle_reaches(owner, known, environment, program) -> return true
    if value == {
        .Paren(inner, _, _) -> return sema_shared_cycle_fresh(inner, ty, owner, allowed, environment, program, scopes, state)
        // A copy (`x.copy()`, or a generated copy) shares every `Shared`
        // handle its source holds, so it reaches exactly the cells its source
        // reaches.
        .Copy(inner, _, _) -> return sema_shared_cycle_fresh(inner, ty, owner, allowed, environment, program, scopes, state)
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Str(_, _, _) | .Char(_, _, _) | .Unit(_, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Lambda(_, _) -> return true
        .Present(inner, _, _) -> return sema_shared_cycle_fresh(inner, sema_shared_cycle_option_inner(ty), owner, allowed, environment, program, scopes, state)
        .Call(call, _) -> {
            if call.name == "Val" && call.args.len() == 1 -> return sema_shared_cycle_fresh(call.args[0].expr, sema_shared_cycle_option_inner(ty), owner, allowed, environment, program, scopes, state)
        }
        .EnumLit(_, variant, _, args, _, _, _) -> {
            if args.len() == 0 -> return true
            if variant == "Val" && args.len() == 1 -> return sema_shared_cycle_fresh(sema_shared_cycle_enum_arg(args[0]), sema_shared_cycle_option_inner(ty), owner, allowed, environment, program, scopes, state)
        }
        .MethodCall(receiver, method, _, _, _, args, _) -> {
            if method == "copy" && args.len() == 0 -> return sema_shared_cycle_fresh(receiver, ty, owner, allowed, environment, program, scopes, state)
            if method == "new" && args.len() == 1 && args[0].flags.shared_operand {
                if receiver == .Ident(name, _, _) && name == "Shared" -> return sema_shared_cycle_fresh(args[0].expr, sema_shared_cycle_shared_inner(ty), owner, allowed, environment, program, scopes, state)
            }
        }
        .StructLit(type_name, type_args, _, _, fields, _, _, _) -> {
            struct_ty: if type_args.len() == 0 -> Type.Named{name: type_name} else -> Type.Apply{name: type_name, args: type_args}
            loop field in fields {
                if !sema_shared_cycle_fresh(field.value, sema_shared_access_field_type(struct_ty, field.name, environment, program, scopes), owner, allowed, environment, program, scopes, state) -> return false
            }
            return true
        }
        .TypedLit(head, body, _, _) -> {
            target: if head == .Val(written) -> Val(written) else -> ty
            if body == {
                .Empty | .ByteText(_) -> return true
                .Value(inner) -> return sema_shared_cycle_fresh(inner, target, owner, allowed, environment, program, scopes, state)
                .Elements(elements) -> {
                    loop element in elements {
                        if !sema_shared_cycle_fresh(element, sema_shared_cycle_element(target), owner, allowed, environment, program, scopes, state) -> return false
                    }
                    return true
                }
                .Entries(entries) -> {
                    loop entry in entries {
                        if !sema_shared_cycle_fresh(entry.key, None, owner, allowed, environment, program, scopes, state) || !sema_shared_cycle_fresh(entry.value, sema_shared_cycle_element(target), owner, allowed, environment, program, scopes, state) -> return false
                    }
                    return true
                }
                .Fields(fields) -> {
                    struct_ty: target ?? return false
                    loop field in fields {
                        if !sema_shared_cycle_fresh(field.value, sema_shared_access_field_type(struct_ty, field.name, environment, program, scopes), owner, allowed, environment, program, scopes, state) -> return false
                    }
                    return true
                }
            }
        }
        .ListLit(elements, _, _) -> {
            loop element in elements {
                if !sema_shared_cycle_fresh(element, sema_shared_cycle_element(ty), owner, allowed, environment, program, scopes, state) -> return false
            }
            return true
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields {
                if !sema_shared_cycle_fresh(field.value, None, owner, allowed, environment, program, scopes, state) -> return false
            }
            return true
        }
        .Ident(name, _, _) -> {
            if name == "None" && sema_scope_resolve_index(scopes, name) == None -> return true
            if sema_shared_cycle_fresh_name(name, owner, allowed, environment, program, scopes, state) -> return true
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    // Operators build scalars, text and ranges, never handles to cells.
    by_operator: if value == {
        .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .Range(_, _, _, _, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
    probed: sema_shared_access_place_type(value, environment, program, scopes) ?? return by_operator
    !sema_shared_cycle_reaches(owner, probed, environment, program)
}

// A `:` name bound to a new cell in this run of its scope, read nowhere but
// in `allowed`: its cell holds exactly what its initializer built.
sema_shared_cycle_fresh_name: fn(name: String, owner: String, allowed: [Span], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: SemaOwnershipState) -> Bool {
    row: sema_scope_resolve_index(scopes, name) ?? return false
    // copy: checking the initializer below may edit the scope table that holds it.
    init: (scopes.bindings[row].fresh_cell ?? return false).copy()
    if !sema_shared_cycle_frame_runs_once(scopes, scopes.bindings[row].frame) -> return false
    if !sema_shared_cycle_unread(state, scopes.bindings[row].symbol.id.key, allowed) -> return false
    within := allowed.copy()
    within.push(expr_source_span(init))
    sema_shared_cycle_fresh(init, None, owner, within, environment, program, scopes, state)
}

// E0221 for storing `value` into `target`, when the place lies in a shared
// cell and can hold a strong edge back to that cell's type. Runs after the
// assignment is checked, so every reference it makes is recorded.
sema_shared_cycle_check_write: fn(target: LValue, value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: SemaOwnershipState, diagnostics: &[Diagnostic]) {
    if target == {
        .Local(_, _) -> {}
        .Field(base, field, field_span) -> sema_shared_cycle_check_stored(sema_shared_cycle_field_place(base, field, environment, program, scopes), Span{start: sema_shared_access_place_start(base), end: field_span.end}, value, environment, program, scopes, state, diagnostics)
        .Index(base, _, index_span, _) -> sema_shared_cycle_check_stored(sema_shared_cycle_element_place(base, environment, program, scopes), Span{start: sema_shared_access_place_start(base), end: index_span.end}, value, environment, program, scopes, state, diagnostics)
    }
}

sema_shared_cycle_check_stored: fn(found: (owner: Type, place: Type)?, span: Span, value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: SemaOwnershipState, diagnostics: &[Diagnostic]) {
    cell: found ?? return
    owner: sema_shared_cycle_owner_key(cell.owner, environment, program) ?? return
    if !sema_shared_cycle_reaches(owner, cell.place, environment, program) -> return
    if sema_shared_cycle_fresh(value, Val(cell.place), owner, [Span]{expr_source_span(value)}, environment, program, scopes, state) -> return
    diagnostics.push(sema_shared_cycle_diagnostic(span, cell.owner))
}

// E0221 for a writing call on `place` (`cell.kids.push(kid)`): every argument
// it stores must be built in place. Runs after the call is checked. Arguments
// a statement bound ahead of the edit (SEMA_SHARED_HOISTED_RHS) were checked
// there.
sema_shared_cycle_check_call: fn(place: Expr, args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: SemaOwnershipState, diagnostics: &[Diagnostic]) {
    if args.len() == 0 -> return
    found: sema_shared_cycle_place(place, environment, program, scopes) ?? return
    owner: sema_shared_cycle_owner_key(found.owner, environment, program) ?? return
    if !sema_shared_cycle_reaches(owner, found.place, environment, program) -> return
    // A method-call argument (`kid.copy()`) is spanned at its method name, so
    // the allowed extent starts at its receiver.
    allowed: [Span]{Span{start: expr_source_span(args[0].expr).start, end: expr_span(args[args.len() - 1].expr).end}}
    loop argument in args {
        if argument.expr == .Ident(name, _, _) && name.starts_with(SEMA_SHARED_HOISTED_RHS) -> next
        if !sema_shared_cycle_fresh(argument.expr, None, owner, allowed, environment, program, scopes, state) {
            diagnostics.push(sema_shared_cycle_diagnostic(Span{start: sema_shared_access_place_start(place), end: expr_span(place).end}, found.owner))
            return
        }
    }
}

// E0221 for the arguments a writing call statement binds ahead of its edit
// (sema_shared_access_place_call_transaction): the ones that read shared state.
sema_shared_cycle_check_hoisted_call: fn(expr: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: SemaOwnershipState, diagnostics: &[Diagnostic]) {
    if expr == .MethodCall(receiver, _, _, _, _, args, _) {
        if receiver == .Place(value, _, _, _) {
            touching := [CallArg]{}
            loop argument in args {
                // copy: `args` belongs to the statement, which keeps them.
                if sema_shared_access_expr_touches_shared(argument.expr, scopes) -> touching.push(argument.copy())
            }
            sema_shared_cycle_check_call(value, touching, environment, program, scopes, state, diagnostics)
        }
    }
}

// E0221 for replacing a whole cell's value (`cell.try_replace(snapshot, value)`),
// after the replacement is checked.
sema_shared_cycle_check_replace: fn(inner: Type, value: Expr, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: SemaOwnershipState, diagnostics: &[Diagnostic]) {
    owner: sema_shared_cycle_owner_key(inner, environment, program) ?? return
    if !sema_shared_cycle_reaches(owner, inner, environment, program) -> return
    if sema_shared_cycle_fresh(value, Val(inner), owner, [Span]{expr_source_span(value)}, environment, program, scopes, state) -> return
    diagnostics.push(sema_shared_cycle_diagnostic(span, inner))
}

sema_shared_cycle_diagnostic: fn(span: Span, owner_ty: Type) -> Diagnostic {
    name: type_name(owner_ty)
    sema_error("E0221", span, "this write can close a strong `Shared` cycle through `{name}`", "the stored value may already reach this `{name}` cell through strong `Shared` handles, and reference counting never frees a strong cycle", "store a `Shared.Weak<{name}>` back-edge (`.downgrade()`) or an id, or build the stored value here from new cells (`Shared{{{name}{{…}}}}`)")
}

// The initializer a `:` binding keeps for the checks above: one that builds a
// new `Shared` cell (`Shared{T{…}}`, optionally wrapped in `Val`).
sema_shared_cycle_cell_init: fn(init: Expr) -> Bool Never! {
    if init == {
        .Paren(inner, _, _) | .Present(inner, _, _) -> return sema_shared_cycle_cell_init(inner)
        .Call(call, _) -> return call.name == "Val" && call.args.len() == 1 && sema_shared_cycle_cell_init(call.args[0].expr)
        .MethodCall(receiver, method, _, _, _, args, _) -> {
            if method != "new" || args.len() != 1 || !args[0].flags.shared_operand -> return false
            if receiver == .Ident(name, _, _) -> return name == "Shared"
            return false
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}
