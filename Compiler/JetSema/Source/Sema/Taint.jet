// Declared tag policies and source-order taint flow.
//
// Taint is a semantic fact plane.  It is deliberately kept in arrays keyed by
// the registration graph's declaration identities; it is never reconstructed
// from the generated checked tree and it does not maintain a second name registry.
use jet_foundation.[
    ArithmeticMode,
    authority_grantable_roots,
    BinOp,
    BindPattern,
    BUILTIN_METHOD_ROWS,
    CallArg,
    CompilerThreads,
    Diagnostic,
    Effect,
    Expr,
    ExternFn,
    Field,
    Func,
    NameTable,
    NamedSpan,
    SinkClass,
    Span,
    Stmt,
    SwitchArm,
    TagDef,
    TextEdit,
    Type,
    compiler_threads_admit,
    compiler_threads_failure_text,
    compiler_threads_heaviest_first,
    core_call,
    diagnostic_with_edit,
    expr_binary_operands,
    expr_optional_method_call_as_call,
    expr_span,
    name_find,
    name_index,
    name_intern,
    name_table,
    sema_effect_covers,
    type_name,
]

SEMA_TAINT_ORIGIN_NET: "$origin.net"
SEMA_TAINT_ORIGIN_FS: "$origin.fs"
SEMA_TAINT_ORIGIN_ENV: "$origin.env"
SEMA_TAINT_ORIGIN_PROCESS: "$origin.process"
SEMA_TAINT_ORIGIN_FFI: "$origin.ffi"

SemaTaintTagFact: struct {
    name: String
    module_identity: String
    deny: [String]
    from: [String]
    span: Span
    visibility: Int
    // `timing: .Fixed` (core.compiler.lang TagTiming): a value carrying the
    // tag must not steer time or addresses (E0737, E0738, E0739).
    fixed: Bool{false}
    // `protects: .Integrity` (TagProtects): the tag guards what may flow in,
    // not where its value may flow.
    integrity: Bool{false}
}

SemaTaintTagList: struct {
    tags: [String]
}

SemaTaintCallableFact: struct {
    key: String
    module_identity: String
    owner: String
    name: String
    parameter_tags: [SemaTaintTagList]
    return_tags: [String]
    return_type: Type?
    scrub_tag: String?
    ffi_origin: Bool
    span: Span
}

SemaTaintFieldFact: struct {
    module_identity: String
    owner_type: String
    field: String
    tags: [String]
    type_name: String?
    span: Span
}

SemaTaintBindingFact: struct {
    name: String
    tags: [String]
    type_name: String?
}

SemaTaintCatalog: struct {
    tags: [SemaTaintTagFact]
    callables: [SemaTaintCallableFact]
    fields: [SemaTaintFieldFact]
    known_sources: [String]
    // Lookup slots kept beside the rows: the first row of each key wins, as
    // the ordered scans over every callable and field did.
    callable_slots: SemaTaintSlots
    callable_name_slots: SemaTaintSlots
    field_slots: SemaTaintSlots
    field_name_slots: SemaTaintSlots
    known_source_slots: SemaTaintSlots
}

// The first row of each key: `keys` interns the key (an open-addressing
// hash, so a whole-graph catalog filled in module order never shifts a
// sorted entry list) and `rows[id]` is the row of that id (-1: none yet;
// id 0, the empty key, starts with none).
SemaTaintSlots: struct {
    keys: NameTable
    rows: [Int]
}

sema_taint_slots: fn() -> SemaTaintSlots Never! {
    SemaTaintSlots{keys: name_table(), rows: [Int]{-1}}
}

// Records `row` for `key` unless the key has a row; whether it was new.
sema_taint_slot_add: fn(slots: &SemaTaintSlots, key: String, row: Int) -> Bool Never! {
    id: name_index(name_intern(slots.keys, key))
    if id < slots.rows.len() {
        if slots.rows[id] >= 0 -> return false
        slots.rows[id] = row
        return true
    }
    slots.rows.push(row)
    true
}

sema_taint_slot: fn(slots: SemaTaintSlots, key: String) -> Int? Never! {
    name: name_find(slots.keys, key) ?? return None
    row: slots.rows[name_index(name)]
    if row < 0 -> None else -> Val(row)
}

SemaTaintImportAlias: struct {
    alias: String
    module_name: String
}

SemaTaintSnapshot: struct {
    bindings: [SemaTaintBindingFact]
}

SemaTaintFlowState: struct {
    catalog: SemaTaintCatalog
    module_identity: String
    bindings: [SemaTaintBindingFact]
    imports: [SemaTaintImportAlias]
    diagnostics: [Diagnostic]
    // The bundle's switch coverage reports so far (sema_taint_coverage_reports).
    coverage_reports: [Diagnostic]
    // The `timing: .Fixed` tags the module sees by name (sema_taint_fixed_tags).
    fixed_tags: [String]
    // In a wrapping or saturating arithmetic mode (a function's marker or a
    // scope), or at the one operator of a `wrapping(...)` or
    // `saturating(...)` call: `+`, `-` and `*` there do not stop (E0739).
    wrapping: Bool{false}
    // The masked branches found so far (sema_taint_mask_branch), and the
    // fixed tags of the masked branch tests enclosing the statement walked
    // now: a value bound or assigned there carries them.
    masked: [Span]{[Span]{}}
    under: [String]{[String]{}}
    // The branches with an early return the walk of the current body found
    // (sema_taint_exit_arms), settled at its end (sema_taint_settle_exits):
    // each branch's span, its test's span and its fixed tag.
    exits: [Span]{[Span]{}}
    exit_tests: [Span]{[Span]{}}
    exit_tags: [String]{[String]{}}
    // How many reports the walk had made when it reached each exit: a
    // refused exit's report goes there, in source order.
    exit_marks: [Int]{[Int]{}}
    // While the code early returns skip is checked (sema_taint_tail_index):
    // pairs of a counting loop's variable and the list whose length bounds
    // it (`""`: none), and pairs of lists a guard proved as long. tail_any
    // admits every index, for the walk's first look at an exit's arms.
    tail_any: Bool{false}
    tail_loops: [String]{[String]{}}
    tail_same: [String]{[String]{}}
    // The read list parameters of the body being settled: the only lists
    // whose `xs[i]` a tail loop proves in bounds.
    tail_lists: [String]{[String]{}}
}

// The E0307 reports of `diagnostics`: all that settles switch coverage for
// the walk (sema_taint_switch_exhaustive).
sema_taint_coverage_reports: fn(diagnostics: [Diagnostic]) -> [Diagnostic] Never! {
    reports := [Diagnostic]{}
    loop diagnostic in diagnostics {
        if diagnostic.code == "E0307" -> reports.push(diagnostic.copy())
    }
    reports
}

sema_taint_has: fn(values: [String], value: String) -> Bool Never! {
    loop item in values {
        if item == value -> return true
    }
    false
}

sema_taint_add: fn(values: &[String], value: String) Never! {
    if !sema_taint_has(values, value) -> values.push(value.copy())
}

sema_taint_union: fn(target: &[String], values: [String]) Never! {
    loop value in values -> sema_taint_add(target, value)
}

sema_taint_remove: fn(values: &[String], value: String) Never! {
    index := values.len() - 1
    loop index >= 0 {
        if values[index] == value -> _ := values.remove(index, .Slot)
        index -= 1
    }
}

sema_taint_is_origin: fn(value: String) -> Bool Never! {
    value.starts_with("$origin.")
}

sema_taint_clear_origins: fn(values: &[String]) Never! {
    index := values.len() - 1
    loop index >= 0 {
        if sema_taint_is_origin(values[index]) -> _ := values.remove(index, .Slot)
        index -= 1
    }
}

sema_taint_type_name: fn(ty: Type) -> String? {
    if ty == {
        .Named(name) -> return Val(name)
        .Apply(name, _) -> return Val(name)
        .Tagged(_, inner) -> return sema_taint_type_name(inner)
        else -> None
    }
}

sema_taint_type_tags: fn(ty: Type) -> [String] Never! {
    if ty == {
        .Tagged(marker, inner) -> {
            tags := sema_taint_type_tags(inner)
            if marker == {
                .User(name) -> sema_taint_add(tags, name)
                .Internal(_) -> {}
            }
            return tags
        }
        else -> [String]{}
    }
}

// The value a call yields. The failure projection writes every return as
// `T E!`, so the tags and the type a caller sees are the success's.
sema_taint_success_type: fn(ty: Type?) -> Type? Never! {
    if ty == .Val(.Result(ok, _)) -> return Val(ok.copy())
    ty.copy()
}

// The effect of the Core call `module.method` (Rust `Effects::core_effect`):
// its registered row's effect, else the module's resolver default, so a call
// the module does not declare still reaches its effect destination.
sema_taint_core_effect: fn(module_name: String, method: String) -> String? Never! {
    if core_call(module_name, method) == .Val(record) -> return record.effect_kind
    if module_name == "core.service" && method == "state_store" -> return Val("FS")
    if module_name == "core.net" && method == "gethostname" -> return Val("Env")
    if (module_name == "core.sys" && method == "success") || (module_name == "core.process" && method == "status_ok") -> return None
    if module_name == "core.time" && method == "__zone_env" -> return Val("Env")
    if module_name == "core.time" && (method == "zone" || method == "parse_zoned" || method == "__zone_file_bytes") -> return Val("FS")
    if module_name == "core.time" && ["clock", "time", "parse_time", "period", "period_days", "period_months", "period_years", "utc", "zoned", "zoned_local", "__embedded_zone_bytes", "__clock_mono_ns"].contains(method) -> return None
    if module_name == "core.math.random" && method == "rng" -> return None
    if module_name == "core.math" && method == "random" -> return Val("Rand")
    if module_name == "core.term" && method == "style_force" -> return None
    if module_name == "core.net" && ["ip_addr", "ip_to_string", "ip_is_ipv4", "ip", "ipv4", "ipv6", "parse_ip", "is_ipv4", "is_ipv6", "__ip_from_bytes", "__ip_bytes", "__ip_is_v4", "__socket_from_parts", "__socket_ip", "__socket_port", "__socket_scope", "__udp_packet_addr", "socket_addr_parse", "socket_host", "socket_port", "socket_to_string", "ready_readable", "ready_writable", "error_operation", "error_address", "error_name", "error_message", "error_os_code", "dns_srv_target", "dns_srv_port", "dns_srv_priority", "dns_srv_weight", "udp_packet_data", "udp_packet_addr", "udp_packet_bytes", "udp_packet_original_len", "udp_packet_truncated"].contains(method) -> return None
    if module_name == "core.watcher" {
        return if method == {
            "files" -> Val("FS")
            "process_pid" -> Val("Exec")
            "port" -> Val("Net")
            else -> None
        }
    }
    if module_name == "core.web.browser" {
        return if method == {
            "profile" | "timeout" -> None
            "locked" -> Val("FS")
            "config_from_env" -> Val("Env")
            else -> Val("Net")
        }
    }
    if module_name == "core.encoding" && ["__read_byte", "__read_into", "__write_bytes", "__write_text", "__flush"].contains(method) -> return Val("IO")
    if ["core.encoding.json", "core.encoding.jsonl", "core.encoding.csv", "core.encoding.xml", "core.encoding.cbor"].contains(module_name) && (method == "reader" || method == "writer") -> return Val("FS")
    if module_name == "core.compute" && method != "device_cpu" -> return Val("GPU")
    if module_name == "core.crypto" && method.starts_with("__jetc_") -> return Val("FS")
    if module_name == "core.auth" && ["register_user", "password_login", "session_validate", "magic_link_issue", "magic_link_consume", "oauth_begin", "oauth_finish", "__store_load", "__store_replace"].contains(method) -> return Val("DB")
    if module_name == "core.crypto.vault" && ["get", "current", "versions", "load", "status", "prepare_generate", "prepare_store", "prepare_rotate", "prepare_retire", "prepare_revoke", "authorize_write", "commit_generate", "commit_store", "commit_rotate", "commit_retire", "commit_revoke", "export_to_recipients", "export_to_passphrase", "prepare_import_wrapped", "authorize_wrapped_import", "commit_import_wrapped", "prepare_import_signing", "prepare_import_x25519", "commit_import_signing", "commit_import_x25519"].contains(method) -> return Val("Secret")
    if module_name == {
        "core.files" -> Val("FS")
        "core.net" | "core.net.tls" | "core.http.client" | "core.http.server" | "core.http.middleware" -> Val("Net")
        "core.time" -> Val("Time")
        "core.math.random" | "core.crypto.random" -> Val("Rand")
        "core.sys" -> Val("Env")
        "core.process" | "core.plugin" | "core.mod" -> Val("Exec")
        "core.term" -> Val("IO")
        "core.db" -> Val("DB")
        "core.log" -> Val("Log")
        "core.ui" | "core.web" | "core.web.storage.local" | "core.web.storage.session" -> Val("Browser")
        else -> None
    }
}

// A Core call that writes to a log, terminal, or serialized output, where a
// credential would leak (Rust `Syntax::credential_sink`).
sema_taint_credential_sink: fn(module_name: String, method: String) -> Bool Never! {
    if core_call(module_name, method) == .Val(record) {
        if record.sink_class == .Val(sink_class) -> return sink_class == SinkClass.Credential
    }
    if module_name == "core.log" -> return true
    if module_name == "core.term" -> return method == "print" || method == "eprint"
    if ["core.encoding.json", "core.encoding.csv", "core.encoding.toml", "core.encoding.yaml", "core.encoding.cbor", "core.encoding.xml"].contains(module_name) -> return ["to_string", "to_string_pretty", "to_bytes", "to_bytes_canonical"].contains(method)
    module_name == "core.encoding.jsonl" && method == "to_string"
}

sema_taint_builtin_tag: fn(name: String) -> SemaTaintTagFact? {
    injection := [String]{"DB", "Exec", "Net"}
    if name == "Input" || name == "PII" || name == "Secret" {
        return Val(SemaTaintTagFact{name: name, module_identity: "", deny: injection, from: [String]{}, span: Span{start: 0, end: 0}, visibility: 2, fixed: name == "Secret", integrity: name == "Input"})
    }
    if name == "Credential" {
        deny := injection
        deny.push("Log")
        return Val(SemaTaintTagFact{name: name, module_identity: "", deny: deny, from: [String]{}, span: Span{start: 0, end: 0}, visibility: 2})
    }
    None
}

sema_taint_builtin_tag_names: fn() -> [String] Never! {
    [String]{"Input", "PII", "Secret", "Credential"}
}

sema_taint_add_builtin_tags: fn(catalog: &SemaTaintCatalog) Never! {
    loop name in sema_taint_builtin_tag_names() {
        if sema_taint_builtin_tag(name) == {
            .Val(fact) -> catalog.tags.push(fact)
            .None -> {}
        }
    }
    origin_rows := [SemaTaintTagFact]{
        {name: SEMA_TAINT_ORIGIN_NET, module_identity: "", deny: [String]{"SQL.raw", "HTML.raw", "Sh.raw"}, from: [String]{"Net"}, span: Span{start: 0, end: 0}, visibility: 2},
        {name: SEMA_TAINT_ORIGIN_FS, module_identity: "", deny: [String]{"SQL.raw", "HTML.raw", "Sh.raw"}, from: [String]{"FS"}, span: Span{start: 0, end: 0}, visibility: 2},
        {name: SEMA_TAINT_ORIGIN_ENV, module_identity: "", deny: [String]{"SQL.raw", "HTML.raw", "Sh.raw"}, from: [String]{"Env"}, span: Span{start: 0, end: 0}, visibility: 2},
        {name: SEMA_TAINT_ORIGIN_PROCESS, module_identity: "", deny: [String]{"SQL.raw", "HTML.raw", "Sh.raw"}, from: [String]{"Exec"}, span: Span{start: 0, end: 0}, visibility: 2},
        {name: SEMA_TAINT_ORIGIN_FFI, module_identity: "", deny: [String]{"SQL.raw", "HTML.raw", "Sh.raw"}, from: [String]{"FFI"}, span: Span{start: 0, end: 0}, visibility: 2},
    }
    loop row in origin_rows -> catalog.tags.push(row)
}

sema_taint_catalog_init: fn() -> SemaTaintCatalog Never! {
    catalog := SemaTaintCatalog{tags: [SemaTaintTagFact]{}, callables: [SemaTaintCallableFact]{}, fields: [SemaTaintFieldFact]{}, known_sources: [String]{}, callable_slots: sema_taint_slots(), callable_name_slots: sema_taint_slots(), field_slots: sema_taint_slots(), field_name_slots: sema_taint_slots(), known_source_slots: sema_taint_slots()}
    sema_taint_add_builtin_tags(catalog)
    catalog
}

sema_taint_edit_distance: fn(left: String, right: String) -> Int Never! {
    a := left.bytes()
    b := right.bytes()
    previous := [Int]{}
    index := 0
    loop index <= b.len() {
        previous.push(index)
        index += 1
    }
    i := 0
    loop i < a.len() {
        current := [Int]{i + 1}
        j := 0
        loop j < b.len() {
            cost := 0
            if a[i] != b[j] -> cost = 1
            deletion := previous[j + 1] + 1
            insertion := current[j] + 1
            substitution := previous[j] + cost
            best := deletion
            if insertion < best -> best = insertion
            if substitution < best -> best = substitution
            current.push(best)
            j += 1
        }
        previous = current
        i += 1
    }
    previous[b.len()]
}

sema_taint_closest: fn(name: String, candidates: [String]) -> String? {
    best := ""
    best_distance := 4
    ambiguous := false
    loop candidate in candidates {
        distance := sema_taint_edit_distance(name, candidate)
        if distance == 0 || distance > 3 -> next
        if {
            distance < best_distance -> {
                best = candidate
                best_distance = distance
                ambiguous = false
            }
            distance == best_distance && best != candidate -> {
                ambiguous = true
            }
        }
    }
    if best == "" || ambiguous -> None else -> Val(best)
}

sema_taint_tag_candidate_names: fn(catalog: SemaTaintCatalog) -> [String] Never! {
    names := [String]{}
    loop tag_value in catalog.tags {
        if !tag_value.name.starts_with("$origin.") -> sema_taint_add(names, tag_value.name)
    }
    names
}

sema_taint_known_destination: fn(destination: String) -> Bool Never! {
    if destination == "Html" -> return true
    sema_effect_parse_name(destination) != None
}

sema_taint_known_source: fn(source: String, catalog: SemaTaintCatalog) -> Bool Never! {
    sema_effect_parse_name(source) != None || sema_taint_slot(catalog.known_source_slots, source) != None
}

sema_taint_push_invalid_path: fn(diagnostics: &[Diagnostic], name: String, span: Span, destination: Bool, catalog: SemaTaintCatalog) {
    candidates := [String]{}
    if {
        destination -> {
            candidates = authority_grantable_roots()
            candidates.push("Html")
        }
        else -> {
            candidates = catalog.known_sources
        }
    }
    suggestion := sema_taint_closest(name, candidates)
    fix := ""
    if suggestion == {
        .Val(value) -> fix = "did you mean `{value}`?"
        .None -> {
            if destination -> fix = "use a known effect such as `DB`, `Net`, `Exec`, `Log`, or `Html`"
            else -> fix = "use a known effect or a declared function path"
        }
    }
    diagnostic := if destination -> sema_error("E0735", span, "`{name}` is not a known tag destination", "a `deny` entry names an effect or a registered sink", fix) else -> sema_error("E0735", span, "`{name}` is not a known tag source", "a `from` entry names an effect or a function path", fix)
    if suggestion == {
        .Val(value) -> diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: value}))
        .None -> diagnostics.push(diagnostic)
    }
}

// Whether a tag body's `timing:` or `protects:` case, as written, is `name`.
sema_taint_case_is: fn(value: NamedSpan?, name: String) -> Bool Never! {
    if value == .Val(item) -> return item.name == name
    false
}

sema_taint_add_tag_declaration: fn(catalog: &SemaTaintCatalog, module_identity: String, tag_def: TagDef, diagnostics: &[Diagnostic]) {
    deny := [String]{}
    from := [String]{}
    loop item in tag_def.deny {
        deny.push(item.name)
    }
    loop item in tag_def.from {
        from.push(item.name)
    }
    fixed: sema_taint_case_is(tag_def.timing, "Fixed")
    integrity: sema_taint_case_is(tag_def.protects, "Integrity")
    catalog.tags.push(SemaTaintTagFact{name: tag_def.name, module_identity: module_identity, deny: deny, from: from, span: tag_def.name_span, visibility: if tag_def.is_pub -> 2 else -> if tag_def.is_package_pub -> 1 else -> 0, fixed: fixed, integrity: integrity})
    loop item in tag_def.deny {
        if !sema_taint_known_destination(item.name) -> sema_taint_push_invalid_path(diagnostics, item.name, item.span, true, catalog)
    }
    loop item in tag_def.from {
        if !sema_taint_known_source(item.name, catalog) -> sema_taint_push_invalid_path(diagnostics, item.name, item.span, false, catalog)
    }
}
sema_taint_collect_tag_declarations: fn(catalog: &SemaTaintCatalog, graph: SemaRegistrationGraph, diagnostics: &[Diagnostic]) {
    loop module_row_index in 0..<graph.modules.len() {
        module_diagnostics := [Diagnostic]{}
        loop item_index in 0..<graph.modules[module_row_index].program.items.len() {
            if graph.modules[module_row_index].program.items[item_index] == .Tag(tag_value) -> sema_taint_add_tag_declaration(catalog, graph.modules[module_row_index].module_identity, tag_value, module_diagnostics)
        }
        sema_attach_diagnostic_source_locations(module_diagnostics, 0, graph.modules[module_row_index].source_segments)
        loop diagnostic in module_diagnostics -> diagnostics.push(diagnostic)
    }
}

sema_taint_callable_key: fn(module_identity: String, owner: String, name: String) -> String Never! {
    if owner == "" -> return "{module_identity}:{name}"
    "{module_identity}:{owner}::{name}"
}

sema_taint_add_known_source: fn(catalog: &SemaTaintCatalog, source: String) Never! {
    if sema_taint_slot_add(catalog.known_source_slots, source, catalog.known_sources.len()) -> catalog.known_sources.push(source.copy())
}

sema_taint_add_source_path: fn(catalog: &SemaTaintCatalog, module_alias: String, owner: String, name: String) Never! {
    local := if owner == "" -> name else -> "{owner}.{name}"
    sema_taint_add_known_source(catalog, local)
    sema_taint_add_known_source(catalog, "{module_alias}.{local}")
}

// The slots of the callable row just pushed.
sema_taint_index_callable: fn(catalog: &SemaTaintCatalog, module_identity: String, owner: String, name: String) Never! {
    slot: catalog.callables.len() - 1
    exact: "{module_identity}|{owner}|{name}"
    _: sema_taint_slot_add(catalog.callable_slots, exact, slot)
    loose: "{owner}|{name}"
    _: sema_taint_slot_add(catalog.callable_name_slots, loose, slot)
}

sema_taint_add_callable: fn(catalog: &SemaTaintCatalog, module_identity: String, module_alias: String, owner: String, function: Func) Never! {
    params := [SemaTaintTagList]{}
    loop parameter_index in 0..<function.params.len() -> params.push(SemaTaintTagList{tags: sema_taint_type_tags(function.params[parameter_index].ty)})
    success: sema_taint_success_type(function.return_type)
    return_tags := [String]{}
    if success == {
        .Val(ty) -> return_tags = sema_taint_type_tags(ty)
        .None -> {}
    }
    ffi_origin := function.inline_foreign != None
    if ffi_origin -> sema_taint_add(return_tags, SEMA_TAINT_ORIGIN_FFI)
    key := sema_taint_callable_key(module_identity, owner, function.name)
    catalog.callables.push(SemaTaintCallableFact{key: key, module_identity: module_identity, owner: owner, name: function.name, parameter_tags: params, return_tags: return_tags, return_type: success, scrub_tag: function.scrub_tag, ffi_origin: ffi_origin, span: function.name_span})
    sema_taint_index_callable(catalog, module_identity, owner, function.name)
    sema_taint_add_source_path(catalog, module_alias, owner, function.name)
}

sema_taint_add_extern_callable: fn(catalog: &SemaTaintCatalog, module_identity: String, function: ExternFn) Never! {
    params := [SemaTaintTagList]{}
    loop parameter_index in 0..<function.params.len() -> params.push(SemaTaintTagList{tags: sema_taint_type_tags(function.params[parameter_index].ty)})
    success: sema_taint_success_type(function.return_type)
    returns := [String]{SEMA_TAINT_ORIGIN_FFI}
    if success == .Val(ty) -> returns = sema_taint_type_tags(ty)
    sema_taint_add(returns, SEMA_TAINT_ORIGIN_FFI)
    catalog.callables.push(SemaTaintCallableFact{key: "{module_identity}:{function.name}", module_identity: module_identity, owner: "", name: function.name, parameter_tags: params, return_tags: returns, return_type: success, scrub_tag: None, ffi_origin: true, span: function.name_span})
    sema_taint_index_callable(catalog, module_identity, "", function.name)
}

sema_taint_add_field: fn(catalog: &SemaTaintCatalog, module_identity: String, owner: String, field: Field) Never! {
    catalog.fields.push(SemaTaintFieldFact{module_identity: module_identity, owner_type: owner, field: field.name, tags: sema_taint_type_tags(field.ty), type_name: sema_taint_type_name(field.ty), span: field.ty_span})
    slot: catalog.fields.len() - 1
    exact: "{module_identity}|{owner}|{field.name}"
    _: sema_taint_slot_add(catalog.field_slots, exact, slot)
    loose: "{owner}|{field.name}"
    _: sema_taint_slot_add(catalog.field_name_slots, loose, slot)
}
sema_taint_collect_items: fn(catalog: &SemaTaintCatalog, graph: SemaRegistrationGraph) Never! {
    loop module_row_index in 0..<graph.modules.len() {
        loop item_index in 0..<graph.modules[module_row_index].program.items.len() {
            if graph.modules[module_row_index].program.items[item_index] == {
                .Func(function) -> sema_taint_add_callable(catalog, graph.modules[module_row_index].module_identity, graph.modules[module_row_index].module_name, "", function)
                .Struct(definition) -> {
                    loop field in definition.fields -> sema_taint_add_field(catalog, graph.modules[module_row_index].module_identity, definition.name, field)
                    loop method in definition.methods -> sema_taint_add_callable(catalog, graph.modules[module_row_index].module_identity, graph.modules[module_row_index].module_name, definition.name, method)
                    loop trait_impl in definition.trait_impls {
                        loop method in trait_impl.methods -> sema_taint_add_callable(catalog, graph.modules[module_row_index].module_identity, graph.modules[module_row_index].module_name, definition.name, method)
                    }
                }
                .Enum(definition) -> loop method in definition.methods -> sema_taint_add_callable(catalog, graph.modules[module_row_index].module_identity, graph.modules[module_row_index].module_name, definition.name, method)
                .Impl(definition) -> loop method in definition.methods -> sema_taint_add_callable(catalog, graph.modules[module_row_index].module_identity, graph.modules[module_row_index].module_name, definition.type_name, method)
                .ExternRust(block) -> loop function in block.functions -> sema_taint_add_extern_callable(catalog, graph.modules[module_row_index].module_identity, function)
                .CModule(block) -> loop function in block.functions -> sema_taint_add_extern_callable(catalog, graph.modules[module_row_index].module_identity, function)
                else -> {}
            }
        }
    }
}

sema_taint_import_module: fn(graph: SemaRegistrationGraph, module_identity: String, name: String) -> String Never! {
    module_index: sema_registration_module_index(graph, module_identity) ?? return ""
    module_row: graph.modules[module_index]
    // The package names bind after the imports before
    // `namespace_import_split`, unless the module declares the name itself.
    namespace_from: if module_row.namespace_import_split < 0 -> module_row.imports.len() else -> module_row.namespace_import_split
    loop (import_index, import) in module_row.imports {
        if import_index == namespace_from {
            namespace: sema_taint_namespace_module(graph, module_index, name)
            if namespace != "" -> return namespace
        }
        loop binding in import.bindings {
            if binding.local == name -> return binding.target_module_identity
        }
        if import.declaration.alias == name -> return import.target_module_identity
    }
    if namespace_from >= module_row.imports.len() -> return sema_taint_namespace_module(graph, module_index, name)
    ""
}

sema_taint_namespace_module: fn(graph: SemaRegistrationGraph, module_index: Int, name: String) -> String Never! {
    if sema_registration_module_has_name(graph.modules[module_index], name) -> return ""
    owner: sema_registration_namespace_owner(graph, module_index, name) ?? return ""
    graph.modules[owner.module_index].module_identity
}
sema_taint_find_tag: fn(catalog: SemaTaintCatalog, graph: SemaRegistrationGraph, module_identity: String, name: String) -> SemaTaintTagFact? {
    builtin: sema_taint_builtin_tag(name)
    if builtin != None -> return builtin
    index := 0
    loop index < catalog.tags.len() {
        tag_value := catalog.tags[index]
        if tag_value.name == name && (tag_value.module_identity == module_identity || tag_value.module_identity == sema_taint_import_module(graph, module_identity, name)) -> return Val(tag_value)
        index += 1
    }
    None
}

sema_taint_find_callable: fn(catalog: SemaTaintCatalog, module_identity: String, owner: String, name: String) -> SemaTaintCallableFact? {
    exact: sema_taint_slot(catalog.callable_slots, "{module_identity}|{owner}|{name}")
    if exact == .Val(slot) {
        callable := catalog.callables[slot]
        return Val(callable)
    }
    loose: sema_taint_slot(catalog.callable_name_slots, "{owner}|{name}") ?? return None
    callable := catalog.callables[loose]
    Val(callable)
}

// A field of `owner` declared in `module_identity` (or with no declaring
// module), else the first field of that name on any `owner`.
sema_taint_find_field: fn(catalog: SemaTaintCatalog, module_identity: String, owner: String, field: String) -> SemaTaintFieldFact? {
    local: sema_taint_slot(catalog.field_slots, "{module_identity}|{owner}|{field}")
    unowned: sema_taint_slot(catalog.field_slots, "|{owner}|{field}")
    first := local
    if unowned == .Val(unowned_slot) {
        if local == .Val(local_slot) {
            if unowned_slot < local_slot -> first = unowned
        } else {
            first = unowned
        }
    }
    if first == .Val(slot) {
        fact := catalog.fields[slot]
        return Val(fact)
    }
    loose: sema_taint_slot(catalog.field_name_slots, "{owner}|{field}") ?? return None
    fact := catalog.fields[loose]
    Val(fact)
}
sema_taint_validate_tag_in_catalog: fn(tag_value: String, module_identity: String, catalog: SemaTaintCatalog, graph: SemaRegistrationGraph, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if sema_taint_find_tag(catalog, graph, module_identity, tag_value) != None -> return true
    candidates := sema_taint_tag_candidate_names(catalog)
    suggestion := sema_taint_closest(tag_value, candidates)
    fix := ""
    if suggestion == {
        .Val(value) -> fix = "did you mean `{value}`?"
        .None -> fix = "declare it first with `{tag_value}: tag {{ deny: [Effect] }}`, or check the spelling"
    }
    diagnostic := sema_error("E0733", span, "there's no tag called `{tag_value}`", "a value tag must name a declared `tag`", fix)
    if suggestion == {
        .Val(value) -> diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: value}))
        .None -> diagnostics.push(diagnostic)
    }
    false
}
sema_taint_validate_tag_graph: fn(tag_value: String, module_identity: String, graph: SemaRegistrationGraph, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    catalog := sema_taint_catalog_init()
    temporary := [Diagnostic]{}
    sema_taint_collect_tag_declarations(catalog, graph, temporary)
    sema_taint_validate_tag_in_catalog(tag_value, module_identity, catalog, graph, span, diagnostics)
}
sema_taint_validate_tag: fn(tag_value: String, env: SemaScopeEnvironment, program: SemaProgramTables, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if program.registration_graph == {
        .Val(value) -> return sema_taint_validate_tag_graph(tag_value, env.module_identity, value, span, diagnostics)
        .None -> {}
    }
    if sema_taint_builtin_tag(tag_value) != None || tag_value == SEMA_TAINT_ORIGIN_NET || tag_value == SEMA_TAINT_ORIGIN_FS || tag_value == SEMA_TAINT_ORIGIN_ENV || tag_value == SEMA_TAINT_ORIGIN_PROCESS || tag_value == SEMA_TAINT_ORIGIN_FFI -> return true
    candidates := [String]{"Input", "PII", "Secret", "Credential"}
    suggestion := sema_taint_closest(tag_value, candidates)
    fix := ""
    if suggestion == {
        .Val(value) -> fix = "did you mean `{value}`?"
        .None -> fix = "declare it first with `{tag_value}: tag {{ deny: [Effect] }}`, or check the spelling"
    }
    diagnostic := sema_error("E0733", span, "there's no tag called `{tag_value}`", "a value tag must name a declared `tag`", fix)
    if suggestion == {
        .Val(value) -> diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: value}))
        .None -> diagnostics.push(diagnostic)
    }
    false
}

sema_taint_validate_type_tags: fn(graph: SemaRegistrationGraph, ty: Type, module_identity: String, state: &SemaTaintFlowState, span: Span) {
    if ty == {
        .Tagged(marker, inner) -> {
            if marker == {
                .User(name) -> {
                    _ := sema_taint_validate_tag_in_catalog(name, module_identity, state.catalog, graph, span, state.diagnostics)
                }
                .Internal(_) -> {}
            }
            sema_taint_validate_type_tags(graph, inner, module_identity, state, span)
        }
        else -> {}
    }
}

sema_taint_binding_index: fn(bindings: [SemaTaintBindingFact], name: String) -> Int? {
    index := bindings.len() - 1
    loop index >= 0 {
        if bindings[index].name == name -> return Val(index)
        index -= 1
    }
    None
}

sema_taint_copy_bindings: fn(bindings: [SemaTaintBindingFact]) -> [SemaTaintBindingFact] Never! {
    result := [SemaTaintBindingFact]{}
    loop binding in bindings {
        result.push(SemaTaintBindingFact{name: binding.name, tags: binding.tags.copy(), type_name: binding.type_name})
    }
    result
}

sema_taint_set_binding: fn(bindings: &[SemaTaintBindingFact], name: String, tags: [String], type_name: String?) Never! {
    index: sema_taint_binding_index(bindings, name)
    if {
        index == None -> {
            bindings.push(SemaTaintBindingFact{name: name, tags: tags.copy(), type_name: type_name})
        }
        else -> {
            bindings[index] = SemaTaintBindingFact{name: name, tags: tags.copy(), type_name: type_name}
        }
    }
}

sema_taint_get_binding: fn(state: SemaTaintFlowState, name: String) -> SemaTaintBindingFact Never! {
    index: sema_taint_binding_index(state.bindings, name) ?? return SemaTaintBindingFact{name: name, tags: [String]{}, type_name: None}
    state.bindings[index]
}

sema_taint_source_tags: fn(state: SemaTaintFlowState, destinations: [String]) -> [String] Never! {
    tags := [String]{}
    loop fact in state.catalog.tags {
        loop source in fact.from {
            covered := false
            loop destination in destinations {
                if sema_effect_covers(source, destination) {
                    covered = true
                    break
                }
            }
            if covered {
                sema_taint_add(tags, fact.name)
                break
            }
        }
    }
    tags
}

sema_taint_core_alias: fn(state: SemaTaintFlowState, alias: String) -> String Never! {
    loop item in state.imports {
        if item.alias == alias && item.module_name.starts_with("core.") -> return item.module_name
    }
    ""
}

sema_taint_core_module_for_receiver: fn(state: SemaTaintFlowState, receiver: Expr) -> String Never! {
    if receiver == {
        .Ident(name, _, _) -> return sema_taint_core_alias(state, name)
        .Field(base, field, _, _) -> {
            module_row := sema_taint_core_module_for_receiver(state, base)
            if module_row != "" -> return "{module_row}.{field}"
        }
        else -> {}
    }
    ""
}
sema_taint_method_destinations: fn(state: SemaTaintFlowState, receiver: Expr, method: String) -> [String] Never! {
    destinations := [String]{}
    if receiver == {
        .Ident(alias, _, _) -> {
            module_row := sema_taint_core_alias(state, alias)
            if {
                module_row == "" -> {
                    destinations.push("{alias}.{method}")
                }
                else -> {
                    destinations.push("{module_row}.{method}")
                    if sema_taint_core_effect(module_row, method) == .Val(effect_name) -> destinations.push(effect_name)
                    if sema_taint_credential_sink(module_row, method) -> destinations.push("Log")
                }
            }
        }
        else -> {}
    }
    destinations
}
sema_taint_is_typed_decode: fn(state: SemaTaintFlowState, receiver: Expr, method: String) -> Bool Never! {
    if method != "decode" -> return false
    module_row := sema_taint_core_module_for_receiver(state, receiver)
    module_row == "core.encoding.json" || module_row == "core.encoding.jsonl" || module_row == "core.encoding.csv" || module_row == "core.encoding.toml" || module_row == "core.encoding.yaml" || module_row == "core.encoding.cbor" || module_row == "core.encoding.xml"
}

sema_taint_is_credential_verify: fn(state: SemaTaintFlowState, receiver: Expr, method: String) -> Bool Never! {
    module_row := sema_taint_core_module_for_receiver(state, receiver)
    module_row == "core.auth" && (method == "verify_jwt" || method == "verify_paseto")
}

sema_taint_type_of_expr: fn(state: SemaTaintFlowState, expression: Expr) -> String? {
    if expression == {
        .Ident(name, _, _) -> return sema_taint_get_binding(state, name).type_name
        .StructLit(type_name, _, _, _, _, _, _, _) -> return Val(type_name)
        // `Row{field: value}` parses as a typed literal headed by its type.
        .TypedLit(head, _, _, _) -> {
            if head == .Val(ty) -> return sema_taint_type_name(ty)
        }
        .Call(call, _) -> {
            fact: sema_taint_find_callable(state.catalog, state.module_identity, "", call.name) ?? return None
            return sema_taint_type_name(fact.return_type ?? Type.Named{name: "Unit"})
        }
        .OptMethodCall(receiver, method, method_span, type_args, args, _, _) -> return sema_taint_type_of_expr(state, expr_optional_method_call_as_call(receiver, method, method_span, type_args, args))
        .Field(base, field, _, _) | .OptField(base, field, _, _, _, _) -> {
            owner: sema_taint_type_of_expr(state, base) ?? return None
            fact: sema_taint_find_field(state.catalog, state.module_identity, owner, field) ?? return None
            return fact.type_name
        }
        .Paren(inner, _, _) | .Copy(inner, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) -> return sema_taint_type_of_expr(state, inner)
        .Try(inner, _, _, _, _) -> return sema_taint_type_of_expr(state, inner)
        else -> {}
    }
    None
}

sema_taint_call_return_tags: fn(state: SemaTaintFlowState, owner: String, name: String) -> [String] Never! {
    fact: sema_taint_find_callable(state.catalog, state.module_identity, owner, name) ?? return [String]{}
    fact.return_tags
}

sema_taint_scrub: fn(state: SemaTaintFlowState, tags: &[String], owner: String, name: String) Never! {
    fact: sema_taint_find_callable(state.catalog, state.module_identity, owner, name) ?? return
    if fact.scrub_tag == {
        .Val(tag_value) -> {
            sema_taint_remove(tags, tag_value)
            sema_taint_clear_origins(tags)
        }
        .None -> {}
    }
}
 

sema_taint_tags_of: fn(state: &SemaTaintFlowState, expression: Expr) -> [String] {
    if expression == {
        .Tainted(inner, tag_value, _, _) -> {
            tags := sema_taint_tags_of(state, inner)
            actual := tag_value ?? "Input"
            sema_taint_add(tags, actual)
            return tags
        }
        .Ident(name, _, _) -> return sema_taint_get_binding(state, name).tags
        .Call(call, _) -> {
            tags := [String]{}
            loop argument in call.args -> sema_taint_union(tags, sema_taint_tags_of(state, argument.expr))
            sema_taint_union(tags, sema_taint_source_tags(state, [String]{call.name}))
            sema_taint_union(tags, sema_taint_call_return_tags(state, "", call.name))
            sema_taint_scrub(state, tags, "", call.name)
 
            return tags
        }
        .MethodCall(receiver, method, _, _, _, args, _) -> {
            tags := sema_taint_tags_of(state, receiver)
            // A list's or a string's length is public, whatever its contents carry.
            if args.len() == 0 && (method == "len" || method == "is_empty" || method == "capacity") {
                sema_taint_drop_fixed(state, tags)
                return tags
            }
            loop argument in args -> sema_taint_union(tags, sema_taint_tags_of(state, argument.expr))
            destinations := sema_taint_method_destinations(state, receiver, method)
            // A method of a local type also reaches `from:` rows that name it
            // by its type (`Store.read`), whatever the receiver is called.
            if sema_taint_type_of_expr(state, receiver) == .Val(owner) -> destinations.push("{owner}.{method}")
            sema_taint_union(tags, sema_taint_source_tags(state, destinations))
            sema_taint_union(tags, sema_taint_call_return_tags(state, "", method))
            sema_taint_scrub(state, tags, "", method)
            if sema_taint_is_typed_decode(state, receiver, method) -> sema_taint_clear_origins(tags)
            if sema_taint_is_credential_verify(state, receiver, method) -> sema_taint_remove(tags, "Credential")
            return tags
        }
        .OptMethodCall(receiver, method, method_span, type_args, args, _, _) -> return sema_taint_tags_of(state, expr_optional_method_call_as_call(receiver, method, method_span, type_args, args))
        .CallValue(callee, args, _, _) -> {
            tags := sema_taint_tags_of(state, callee)
            loop argument in args -> sema_taint_union(tags, sema_taint_tags_of(state, argument.expr))
            return tags
        }
        // A left-leaning chain (`a + b + c …`) costs no stack per operator.
        .Binary(_, left, right, _, _) -> {
            tags := [String]{}
            loop operand in expr_binary_operands(left, right) -> sema_taint_union(tags, sema_taint_tags_of(state, operand))
            return tags
        }
        .Range(left, right, _, _, _) -> {
            tags := sema_taint_tags_of(state, left)
            sema_taint_union(tags, sema_taint_tags_of(state, right))
            return tags
        }
        .CompareChain(operands, _, _, _, _) | .ListLit(operands, _, _) -> {
            tags := [String]{}
            loop value in operands -> sema_taint_union(tags, sema_taint_tags_of(state, value))
            return tags
        }
        .Field(base, field, _, _) | .OptField(base, field, _, _, _, _) -> {
            tags := sema_taint_tags_of(state, base)
            owner := sema_taint_type_of_expr(state, base)
            if owner == {
                .Val(type_name) -> {
                    fact := sema_taint_find_field(state.catalog, state.module_identity, type_name, field)
                    if fact == {
                        .Val(row) -> sema_taint_union(tags, row.tags)
                        .None -> {}
                    }
                }
                .None -> {}
            }
            return tags
        }
        .Unary(_, inner, _, _) | .Deref(inner, _, _) | .RawOf(inner, _, _) | .Copy(inner, _, _) | .Place(inner, _, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .Paren(inner, _, _) | .Spread(inner, _, _) -> return sema_taint_tags_of(state, inner)
        .Try(inner, _, _, note, _) -> {
            tags := sema_taint_tags_of(state, inner)
            if note == {
                .Val(other) -> sema_taint_union(tags, sema_taint_tags_of(state, other))
                .None -> {}
            }
            return tags
        }
        .MemberSpread(base, _, _, _) -> return sema_taint_tags_of(state, base)
        .Index(base, index, _, _, _) -> {
            tags := sema_taint_tags_of(state, base)
            sema_taint_union(tags, sema_taint_tags_of(state, index))
            return tags
        }
        .Slice(base, start, end, range, _, _) -> {
            tags := sema_taint_tags_of(state, base)
            if range == {
                .Val(value) -> sema_taint_union(tags, sema_taint_tags_of(state, value))
                .None -> {
                    sema_taint_union(tags, sema_taint_tags_of(state, start))
                    sema_taint_union(tags, sema_taint_tags_of(state, end))
                }
            }
            return tags
        }
        .MapLit(entries, _, _) -> {
            tags := [String]{}
            loop entry in entries {
                sema_taint_union(tags, sema_taint_tags_of(state, entry.key))
                sema_taint_union(tags, sema_taint_tags_of(state, entry.value))
            }
            return tags
        }
        .TupleLit(fields, _, _, _) -> {
            tags := [String]{}
            loop field in fields -> sema_taint_union(tags, sema_taint_tags_of(state, field.value))
            return tags
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            tags := [String]{}
            loop field in fields -> sema_taint_union(tags, sema_taint_tags_of(state, field.value))
            sema_taint_clear_origins(tags)
            return tags
        }
        .TypedLit(_, body, _, _) -> {
            tags := [String]{}
            if body == {
                .Fields(fields) -> loop field in fields -> sema_taint_union(tags, sema_taint_tags_of(state, field.value))
                .Elements(elements) -> loop value in elements -> sema_taint_union(tags, sema_taint_tags_of(state, value))
                .Entries(entries) -> loop entry in entries -> sema_taint_union(tags, sema_taint_tags_of(state, entry.value))
                .Value(value) -> sema_taint_union(tags, sema_taint_tags_of(state, value))
                else -> {}
            }
            sema_taint_clear_origins(tags)
            return tags
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            tags := [String]{}
            loop argument in args {
                if argument == {
                    .Positional(value) -> sema_taint_union(tags, sema_taint_tags_of(state, value))
                    .Named(_, value) -> sema_taint_union(tags, sema_taint_tags_of(state, value))
                }
            }
            return tags
        }
        .Str(parts, _, _) -> {
            tags := [String]{}
            loop part in parts {
                if part == .Interp(value, _) -> sema_taint_union(tags, sema_taint_tags_of(state, value))
            }
            return tags
        }
        .OrFallback(value, fallback, _, _, _) -> {
            tags := sema_taint_tags_of(state, value)
            if fallback == {
                .Value(other) -> sema_taint_union(tags, sema_taint_tags_of(state, other))
                .Return(other, _) -> {
                    if other == {
                        .Val(item) -> sema_taint_union(tags, sema_taint_tags_of(state, item))
                        .None -> {}
                    }
                }
                .Block(_, _, _) -> {}
                else -> {}
            }
            return tags
        }
        .PatternTest(subject, _, _, _) -> return sema_taint_tags_of(state, subject)
        // Which arm's value it is depends on the test: a fixed test's tag
        // reaches the value (a masked branch, sema_taint_mask_branch).
        .If(cond, _, then_value, _, else_value, _, _) -> {
            tags := sema_taint_tags_of(state, then_value)
            sema_taint_union(tags, sema_taint_tags_of(state, else_value))
            if sema_taint_fixed_in(state, cond) == .Val(tag_value) -> sema_taint_add(tags, tag_value)
            return tags
        }
        .PtrFromAddr(_, _, _, addr, _, _) -> return sema_taint_tags_of(state, addr)
        // Each step's hidden name carries the tags of the value it receives.
        .Pipe(head, steps, _, _) -> {
            tags := sema_taint_tags_of(state, head)
            loop step in steps {
                sema_taint_set_binding(state.bindings, step.name, tags, None)
                tags = sema_taint_tags_of(state, step.value)
            }
            return tags
        }
        .Lambda(_, _) -> return [String]{}
        else -> return [String]{}
    }
}

sema_taint_denied_tag: fn(graph: SemaRegistrationGraph, state: SemaTaintFlowState, tags: [String], destinations: [String]) -> String? {
    loop tag_value in tags {
        fact: sema_taint_find_tag(state.catalog, graph, state.module_identity, tag_value) ?? next
        loop deny in fact.deny {
            loop destination in destinations {
                if sema_effect_covers(deny, destination) -> return Val(tag_value)
            }
        }
    }
    None
}

sema_taint_e0722: fn(api: String, span: Span) -> Diagnostic {
    sema_error("E0722", span, "a `Credential` value is denied at `{api}`", "`{api}` writes to a log, terminal, or serialized output, where a credential would leak", "log a non-secret field, or pass the value through a matching `#Scrub(Credential)` function")
}

sema_taint_e0721: fn(tag_value: String, api: String, destinations: [String], span: Span) -> Diagnostic {
    destination := if destinations.len() == 0 -> "sink" else -> destinations[destinations.len() - 1]
    fix := if sema_taint_is_origin(tag_value) -> "remove the destination use, decode the value into a declared type, or pass it through an audited #Scrub function" else -> "remove the destination use, or pass the value through a matching `#Scrub({tag_value})` function"
    sema_error("E0721", span, "a `{tag_value}` value is denied at `{api}`", "the declaration for `{tag_value}` denies `{destination}`, which covers this destination", fix)
}

// ---------------------------------------------------------------------------
// Fixed timing: a value carrying a `timing: .Fixed` tag must
// not decide which code runs, which address is touched, or whether the
// program stops.

// The `timing: .Fixed` tags module `module_identity` sees by name: the
// builtin `Secret`, and each declared tag that resolves there as fixed.
sema_taint_fixed_tags: fn(graph: SemaRegistrationGraph, catalog: SemaTaintCatalog, module_identity: String) -> [String] {
    names := [String]{"Secret"}
    loop fact in catalog.tags {
        if !fact.fixed || sema_taint_has(names, fact.name) -> next
        found: sema_taint_find_tag(catalog, graph, module_identity, fact.name) ?? next
        if found.fixed -> names.push(fact.name.copy())
    }
    names
}

// The first fixed tag of `tags`.
sema_taint_fixed_of: fn(state: SemaTaintFlowState, tags: [String]) -> String? Never! {
    loop tag_value in tags {
        if sema_taint_has(state.fixed_tags, tag_value) -> return Val(tag_value.copy())
    }
    None
}

// `tags` without its fixed tags.
sema_taint_drop_fixed: fn(state: SemaTaintFlowState, tags: &[String]) Never! {
    loop tag_value in state.fixed_tags -> sema_taint_remove(tags, tag_value)
}

// The fixed tag `value` carries, if any.
sema_taint_fixed_in: fn(state: &SemaTaintFlowState, value: Expr) -> String? {
    sema_taint_fixed_of(state, sema_taint_tags_of(state, value))
}

sema_taint_either: fn(left: String?, right: String?) -> String? Never! {
    if left != None -> return left.copy()
    right.copy()
}

sema_taint_untagged: fn(ty: Type) -> Type Never! {
    if ty == .Tagged(_, inner) -> return sema_taint_untagged(inner)
    ty.copy()
}

sema_taint_is_str: fn(value: Expr) -> Bool Never! {
    if value == .Str(_, _, _) -> return true
    false
}

sema_taint_e0737: fn(state: &SemaTaintFlowState, tag_value: String, steers: String, span: Span) {
    state.diagnostics.push(sema_taint_e0737_diagnostic(tag_value, steers, span))
}

sema_taint_e0737_diagnostic: fn(tag_value: String, steers: String, span: Span) -> Diagnostic Never! {
    sema_error("E0737", span, "a `{tag_value}` value decides {steers}", "`{tag_value}` is `timing: .Fixed`: which code runs, how long it takes and which addresses it touches must not depend on it", "compute both outcomes and choose with a masked select, or reveal the value through a `#Scrub({tag_value})` function first")
}

sema_taint_e0738: fn(state: &SemaTaintFlowState, tag_value: String, holder: String, span: Span) {
    state.diagnostics.push(sema_error("E0738", span, "`{holder}` holds a `{tag_value}` value", "`{tag_value}` is `timing: .Fixed`, and an `Int` (a big integer) or a `Float` takes time that depends on its value", "keep the value in a fixed-width type such as `U64` or `[U8]`, or reveal it through a `#Scrub({tag_value})` function first"))
}

sema_taint_e0739: fn(state: &SemaTaintFlowState, tag_value: String, what: String, span: Span) {
    state.diagnostics.push(sema_error("E0739", span, "{what} of a `{tag_value}` value could stop the program", "`{tag_value}` is `timing: .Fixed`, and checked arithmetic stops when its result does not fit, so whether the program stops would depend on the value", "use `wrapping_add`, `wrapping_sub`, `wrapping_mul` or `wrapping(...)`, or mask the value into range first"))
}

// E0737 when `value` carries a fixed tag.
sema_taint_check_steer: fn(state: &SemaTaintFlowState, value: Expr, steers: String) {
    tag_value: sema_taint_fixed_in(state, value) ?? return
    sema_taint_e0737(state, tag_value, steers, expr_span(value))
}

// The E0737 and E0739 checks at operator `op` whose operands carry the fixed
// tags `left` and `right`; `text` when it joins strings, which never stops.
sema_taint_check_operator: fn(state: &SemaTaintFlowState, op: BinOp, left: String?, right: String?, text: Bool, span: Span) {
    if op == {
        .Div | .FloorDiv | .Mod | .Rem -> {
            tag_value: sema_taint_either(left, right) ?? return
            sema_taint_e0737(state, tag_value, "a division (its time depends on its operands)", span)
        }
        .Shl | .Shr -> {
            tag_value: right ?? return
            sema_taint_e0737(state, tag_value, "a shift amount (a checked shift stops when it is too wide)", span)
        }
        .Pow -> {
            tag_value: right ?? return
            sema_taint_e0737(state, tag_value, "an exponent (the number of multiplications)", span)
        }
        .And | .Or -> {
            tag_value: left ?? return
            sema_taint_e0737(state, tag_value, "whether `&&` or `||` evaluates its right side", span)
        }
        .Add | .Sub | .Mul -> {
            if state.wrapping || text -> return
            tag_value: sema_taint_either(left, right) ?? return
            sema_taint_e0739(state, tag_value, "checked `+`, `-` or `*`", span)
        }
        else -> {}
    }
}

// Masked branches. A branch on a fixed value whose arms are total runs both
// arms, and the IR keeps the chosen arm's results with a masked select
// (JetIR BuildMask.jet). Total means that no arm stops, calls, writes
// memory or leaves early. Such a branch steers no time and no address, so
// it is no E0737, and its span goes to `state.masked`, which reaches the
// function's FnBody.masked. A total arm binds names and assigns to local
// names. It reads literals, names and fields, and uses only operators that
// cannot stop, the bit methods, the wrapping methods, `len()`, `is_empty()`
// and nested total branches.
sema_taint_mask_branch: fn(state: &SemaTaintFlowState, tag_value: String, total: Bool, span: Span, test_span: Span) {
    if !total {
        sema_taint_e0737(state, tag_value, "a branch that can't be masked (an arm returns, breaks, calls, can stop or writes memory)", test_span)
        return
    }
    loop masked in state.masked {
        if masked.start == span.start && masked.end == span.end -> return
    }
    state.masked.push(span.copy())
}

// The fixed tag of each arm test of a switch ("" for a public one). In a
// statement `if` (a switch on `true`) each fixed test's branch is masked
// when every arm from the first fixed test on, its test and the else body
// are total. The branch of arm 0 is the switch's span and that of a later
// arm is the arm's own span, as the checked `if` chain gives them. Any other
// switch on a fixed arm value is E0737.
sema_taint_mask_arms: fn(state: &SemaTaintFlowState, subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span) -> [String] {
    tests := [String]{}
    first := -1
    loop index in 0..<arms.len() {
        test: sema_taint_fixed_in(state, arms[index].cond) ?? ""
        if test != "" && first < 0 -> first = index
        tests.push(test.copy())
    }
    if first < 0 -> return tests
    total := sema_taint_is_true(subject)
    loop index in first..<arms.len() {
        if !total -> break
        total = sema_taint_total_expr(state, arms[index].cond) && sema_taint_total_block(state, arms[index].body)
    }
    if total {
        if else_body == .Val(body) -> total = sema_taint_total_block(state, body)
    }
    // An `if` with no else whose arms only fail to be total by returning
    // at their end is an early exit, settled once its body is walked.
    plain := !total && sema_taint_is_true(subject)
    if else_body == .Val(_) -> plain = false
    exits := false
    if plain {
        state.tail_any = true
        exits = sema_taint_exit_arms(state, arms, first)
        state.tail_any = false
    }
    loop index in first..<arms.len() {
        if tests[index] == "" -> next
        branch: if index == 0 -> span else -> arms[index].span
        test_span: expr_span(arms[index].cond)
        if exits {
            sema_taint_pend_exit(state, tests[index], branch, test_span)
        } else {
            sema_taint_mask_branch(state, tests[index], total, branch, test_span)
        }
    }
    tests
}

sema_taint_total_block: fn(state: SemaTaintFlowState, body: [Stmt]) -> Bool Never! {
    loop statement in body {
        if !sema_taint_total_stmt(state, statement) -> return false
    }
    true
}

sema_taint_total_stmt: fn(state: SemaTaintFlowState, statement: Stmt) -> Bool Never! {
    if statement == {
        .Val(binding) -> return binding.pattern == None && sema_taint_total_expr(state, binding.init)
        .Assign(target, op, _, value) -> {
            if target == {
                .Local(_, _) -> {}
                else -> return false
            }
            if op == .Val(operator) {
                if !sema_taint_total_operator(state, operator, value) -> return false
            }
            return sema_taint_total_expr(state, value)
        }
        .Switch(subject, arms, else_body, _) -> {
            if !sema_taint_is_true(subject) -> return false
            loop arm in arms {
                if !sema_taint_total_expr(state, arm.cond) || !sema_taint_total_block(state, arm.body) -> return false
            }
            if else_body == .Val(body) -> return sema_taint_total_block(state, body)
            return true
        }
        .Expr(value) -> {
            if value == .If(_, _, _, _, _, _, _) -> return sema_taint_total_expr(state, value)
            return false
        }
        else -> return false
    }
}

sema_taint_is_true: fn(value: Expr) -> Bool Never! {
    if value == .Bool(flag, _, _) -> return flag
    false
}

// Whether operator `op` with right operand `right` cannot stop and does not
// branch. `+`, `-` and `*` stop on overflow unless they wrap; a division, a
// remainder, a power and a shift by an amount that is not a literal can
// stop; `&&` and `||` branch.
sema_taint_total_operator: fn(state: SemaTaintFlowState, op: BinOp, right: Expr) -> Bool Never! {
    if op == {
        .BitAnd | .BitOr | .BitXor | .Eq | .Ne | .Lt | .Gt | .Le | .Ge -> return true
        .Add | .Sub | .Mul -> return state.wrapping
        .Shl | .Shr -> return right == .Int(_, _, _, _, _)
        else -> return false
    }
}

// Whether a call of `method` with `count` arguments cannot stop and does not
// branch: a list's or a string's length query, or a built-in method whose
// registry row (BUILTIN_METHOD_ROWS) of that name and arity lowers to `&`,
// `|`, `^` or a bit not, or to a wrapping `+`, `-` or `*`.
sema_taint_total_method: fn(method: String, count: Int) -> Bool Never! {
    if count == 0 && (method == "len" || method == "is_empty") -> return true
    loop row in BUILTIN_METHOD_ROWS {
        if row.name != method || row.parameters.len() != count -> next
        if row.lowering == {
            .Arithmetic(operation) -> {
                if operation == .BitAnd || operation == .BitOr || operation == .BitXor -> return true
            }
            .BitNot -> return true
            .Overflow(prefix, _) -> {
                if prefix == "wrapping" -> return true
            }
            else -> {}
        }
    }
    false
}

sema_taint_total_expr: fn(state: SemaTaintFlowState, value: Expr) -> Bool Never! {
    if value == {
        .Int(_, _, _, _, _) | .Bool(_, _, _) | .Char(_, _, _) | .Unit(_, _) | .Ident(_, _, _) -> return true
        .TypedLit(_, body, _, _) -> {
            if body == .Value(inner) -> return inner == .Int(_, _, _, _, _) || inner == .Bool(_, _, _)
            return false
        }
        .Paren(inner, _, _) -> return sema_taint_total_expr(state, inner)
        .Field(base, _, _, _) -> return sema_taint_total_expr(state, base)
        .Tainted(inner, _, _, _) -> return sema_taint_total_expr(state, inner)
        .Unary(op, operand, _, _) -> return op == .Not && sema_taint_total_expr(state, operand)
        .Binary(op, left, right, _, _) -> return sema_taint_total_operator(state, op, right) && sema_taint_total_expr(state, left) && sema_taint_total_expr(state, right)
        .CompareChain(operands, _, _, _, _) -> {
            loop operand in operands {
                if !sema_taint_total_expr(state, operand) -> return false
            }
            return true
        }
        // `wrapping(a + b)`: its one operator wraps; the operands' own
        // operators stay checked.
        .Call(call, _) -> {
            if call.name != "wrapping" || call.args.len() != 1 -> return false
            if call.args[0].expr == .Binary(op, left, right, _, _) {
                if op != .Add && op != .Sub && op != .Mul -> return false
                return sema_taint_total_expr(state, left) && sema_taint_total_expr(state, right)
            }
            return false
        }
        .MethodCall(receiver, method, _, _, _, args, _) -> {
            if !sema_taint_total_method(method, args.len()) || !sema_taint_total_expr(state, receiver) -> return false
            loop argument in args {
                if !sema_taint_total_expr(state, argument.expr) -> return false
            }
            return true
        }
        .If(cond, then_body, then_value, else_body, else_value, _, _) -> return sema_taint_total_expr(state, cond) && sema_taint_total_block(state, then_body) && sema_taint_total_expr(state, then_value) && sema_taint_total_block(state, else_body) && sema_taint_total_expr(state, else_value)
        // An index is total only in the code an early return skips, at a
        // counter proved in bounds (sema_taint_tail_index). The walk has no
        // types yet, so the kind is mostly Unknown here; the proof itself
        // only admits list parameters.
        .Index(base, index, _, kind, _) -> {
            if kind == {
                .Unknown | .List | .FixedListProof -> return sema_taint_tail_index(state, base, index)
                else -> return false
            }
        }
        else -> return false
    }
}

// Whether the arms of a statement `if` with no else, from arm `first` on,
// are total but for a last `return` of a total value, and one of them
// returns: an early exit sema_taint_settle_exits may mask.
sema_taint_exit_arms: fn(state: SemaTaintFlowState, arms: [SwitchArm], first: Int) -> Bool Never! {
    exits := false
    loop index in first..<arms.len() {
        if !sema_taint_total_expr(state, arms[index].cond) -> return false
        count: arms[index].body.len()
        loop at in 0..<count {
            statement: arms[index].body[at]
            returned := false
            if at == count - 1 {
                if statement == .Return(value, _) {
                    if value == .Val(result) {
                        if !sema_taint_total_expr(state, result) -> return false
                    }
                    returned = true
                }
            }
            if returned {
                exits = true
            } else if !sema_taint_total_stmt(state, statement) {
                return false
            }
        }
    }
    exits
}

// An early exit's branch (sema_taint_exit_arms), settled at the end of its
// body's walk; a refusal is reported where the walk reached it.
sema_taint_pend_exit: fn(state: &SemaTaintFlowState, tag_value: String, span: Span, test_span: Span) {
    loop pending in state.exits {
        if pending.start == span.start && pending.end == span.end -> return
    }
    state.exits.push(span.copy())
    state.exit_tests.push(test_span.copy())
    state.exit_tags.push(tag_value.copy())
    state.exit_marks.push(state.diagnostics.len())
}

// A body's early exits are masked when the code they skip can run masked:
// from the first top-level statement that holds one on, every statement is
// total, a statement `if` or a counted loop over such code, or a `return` of
// a total value. There `xs[i]` is total when `i` counts a loop `0..<ys.len()`
// and `xs` is `ys`, or a guard before proved the two as long (`if xs.len() !=
// ys.len() -> return …`); `xs` and `ys` are read list parameters (`params`).
// Otherwise each early exit is E0737.
sema_taint_settle_exits: fn(state: &SemaTaintFlowState, body: [Stmt], params: [String]) {
    if state.exits.len() == 0 -> return
    state.tail_loops = [String]{}
    state.tail_same = [String]{}
    state.tail_lists = params.copy()
    masks: sema_taint_exit_tail(state, body, params)
    refused := 0
    loop index in 0..<state.exits.len() {
        tag_value: state.exit_tags[index].copy()
        span: state.exits[index].copy()
        test_span: state.exit_tests[index].copy()
        if masks {
            sema_taint_mask_branch(state, tag_value, true, span, test_span)
        } else {
            at: state.exit_marks[index] + refused
            state.diagnostics.insert(at, sema_taint_e0737_diagnostic(tag_value, "an early return that can't be masked (the code it skips calls, can stop, writes memory or loops on its own)", test_span))
            refused += 1
        }
    }
    state.exits = [Span]{}
    state.exit_tests = [Span]{}
    state.exit_tags = [String]{}
    state.exit_marks = [Int]{}
    state.tail_loops = [String]{}
    state.tail_same = [String]{}
    state.tail_lists = [String]{}
}

sema_taint_exit_tail: fn(state: &SemaTaintFlowState, body: [Stmt], params: [String]) -> Bool {
    held := 0
    started := false
    loop statement in body {
        reach: sema_taint_stmt_reach(statement) ?? Span{start: 0, end: 0}
        inside: sema_taint_exits_in(state, reach)
        if !started && inside == 0 {
            sema_taint_note_guard(state, statement, params)
            next
        }
        started = true
        held += inside
        if !sema_taint_tail_stmt(state, statement) -> return false
    }
    // Every exit lies in a top-level loop or `if` the tail covers.
    held == state.exits.len()
}

// The span of a statement that can hold a statement `if`, else None.
sema_taint_stmt_reach: fn(statement: Stmt) -> Span? Never! {
    if statement == {
        .Switch(_, _, _, span) | .For(_, _, _, _, _, span, _, _, _) | .While(_, _, span, _, _) | .Loop(_, span, _, _) | .CountedLoop(_, _, _, _, span, _, _) -> return Val(span)
        else -> return None
    }
}

// How many early exits lie inside `reach`.
sema_taint_exits_in: fn(state: SemaTaintFlowState, reach: Span) -> Int Never! {
    if reach.end <= reach.start -> return 0
    count := 0
    loop exit in state.exits {
        if exit.start >= reach.start && exit.end <= reach.end -> count += 1
    }
    count
}

// `if xs.len() != ys.len() -> return …` over two read parameters: from here
// on the two lists are as long.
sema_taint_note_guard: fn(state: &SemaTaintFlowState, statement: Stmt, params: [String]) {
    if statement == .Switch(subject, arms, else_body, _) {
        if else_body == .Val(_) -> return
        if !sema_taint_is_true(subject) || arms.len() != 1 || arms[0].body.len() != 1 -> return
        if arms[0].body[0] == .Return(_, _) {
            if arms[0].cond == .Binary(op, left, right, _, _) {
                if op != .Ne -> return
                first: sema_taint_length_of(left) ?? return
                second: sema_taint_length_of(right) ?? return
                if !sema_taint_has(params, first) || !sema_taint_has(params, second) -> return
                state.tail_same.push(first.copy())
                state.tail_same.push(second.copy())
            }
        }
    }
}

// `xs` of `xs.len()`.
sema_taint_length_of: fn(value: Expr) -> String? Never! {
    if value == .MethodCall(receiver, method, _, _, _, args, _) {
        if method != "len" || args.len() != 0 -> return None
        if receiver == .Ident(name, _, _) -> return Val(name)
    }
    None
}

// Whether a statement of the code an early exit skips can run masked.
sema_taint_tail_stmt: fn(state: &SemaTaintFlowState, statement: Stmt) -> Bool {
    if statement == {
        .Val(binding) -> return binding.pattern == None && !sema_taint_tail_named(state, binding.name) && sema_taint_total_expr(state, binding.init)
        .Assign(target, op, _, value) -> {
            if target == .Local(name, _) {
                if sema_taint_tail_named(state, name) -> return false
            } else {
                return false
            }
            if op == .Val(operator) {
                if !sema_taint_total_operator(state, operator, value) -> return false
            }
            return sema_taint_total_expr(state, value)
        }
        .Return(value, _) -> {
            if value == .Val(returned) -> return sema_taint_total_expr(state, returned)
            return true
        }
        .Expr(value) -> return sema_taint_total_expr(state, value)
        .Switch(subject, arms, else_body, _) -> {
            if !sema_taint_is_true(subject) -> return false
            loop arm in arms {
                if !sema_taint_total_expr(state, arm.cond) || !sema_taint_tail_block(state, arm.body) -> return false
            }
            if else_body == .Val(body) -> return sema_taint_tail_block(state, body)
            return true
        }
        .For(counter, _, var2, kind, body, _, _, _, _) -> {
            if var2 == .Val(_) -> return false
            if sema_taint_tail_named(state, counter) -> return false
            if kind == .Range(start, end, step, exclusive) {
                if step == .Val(_) -> return false
                if !sema_taint_total_expr(state, start) || !sema_taint_total_expr(state, end) -> return false
                bound := ""
                if exclusive {
                    if start == .Int(first, _, _, _, _) {
                        if first == 0 -> bound = sema_taint_length_of(end) ?? ""
                    }
                }
                held: state.tail_loops.len()
                state.tail_loops.push(counter.copy())
                state.tail_loops.push(bound.copy())
                total: sema_taint_tail_block(state, body)
                loop state.tail_loops.len() > held -> _ := state.tail_loops.pop()
                return total
            }
            return false
        }
        else -> return false
    }
}

sema_taint_tail_block: fn(state: &SemaTaintFlowState, body: [Stmt]) -> Bool {
    loop statement in body {
        if !sema_taint_tail_stmt(state, statement) -> return false
    }
    true
}

// Whether `name` counts a loop of the tail or is a list a tail proof reads:
// rebinding or assigning it would void the proof.
sema_taint_tail_named: fn(state: SemaTaintFlowState, name: String) -> Bool Never! {
    sema_taint_has(state.tail_loops, name) || sema_taint_has(state.tail_lists, name)
}

// Whether a parameter's written type is a list, tagged or not.
sema_taint_is_list: fn(ty: Type) -> Bool Never! {
    if ty == {
        .List(_) -> return true
        .Tagged(_, inner) -> return sema_taint_is_list(inner)
        else -> return false
    }
}

// `xs[i]` in the code an early exit skips: `i` counts the innermost tail
// loop of that name, below `xs.len()` or the length of a list proved as
// long.
sema_taint_tail_index: fn(state: SemaTaintFlowState, base: Expr, index: Expr) -> Bool Never! {
    if state.tail_any -> return true
    if base == .Ident(list, _, _) {
        if !sema_taint_has(state.tail_lists, list) -> return false
        if index == .Ident(counter, _, _) {
            at := state.tail_loops.len() - 2
            loop at >= 0 {
                if state.tail_loops[at] == counter {
                    bound: state.tail_loops[at + 1]
                    if bound == "" -> return false
                    return bound == list || sema_taint_same_length(state, list, bound)
                }
                at -= 2
            }
        }
    }
    false
}

sema_taint_same_length: fn(state: SemaTaintFlowState, first: String, second: String) -> Bool Never! {
    at := 0
    loop at + 1 < state.tail_same.len() {
        if state.tail_same[at] == first && state.tail_same[at + 1] == second -> return true
        if state.tail_same[at] == second && state.tail_same[at + 1] == first -> return true
        at += 2
    }
    false
}

// The operator checks of the left-leaning chain `expression` heads, innermost
// first. The prefix's fixed tag is the chain's value so far, so the chain
// costs one tags walk per operand.
sema_taint_check_binary_chain: fn(state: &SemaTaintFlowState, expression: Expr) {
    nodes := [Expr]{}
    operand := expression
    loop {
        if operand == .Binary(_, inner_left, _, _, _) {
            nodes.push(operand)
            operand = inner_left
        } else {
            break
        }
    }
    prefix := sema_taint_fixed_in(state, operand)
    text := sema_taint_is_str(operand)
    index := nodes.len() - 1
    loop index >= 0 {
        if nodes[index] == .Binary(op, _, right, span, _) {
            fixed := sema_taint_fixed_in(state, right)
            text = text || sema_taint_is_str(right)
            sema_taint_check_operator(state, op, prefix, fixed, text, span)
            if prefix == None -> prefix = fixed
        }
        index -= 1
    }
}

// Whether `ty`, through its tags, lists and options, holds an `Int` or a
// `Float`.
sema_taint_holds_wide: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Float32 -> true
        .Tagged(_, inner) | .List(inner) | .Option(inner) | .Shared(inner) -> sema_taint_holds_wide(inner)
        .FixedList(elem, _) -> sema_taint_holds_wide(elem)
        else -> false
    }
}

// The fixed tag `ty` puts over an `Int` or a `Float`, if any.
sema_taint_fixed_wide: fn(state: SemaTaintFlowState, ty: Type) -> String? Never! {
    if ty == {
        .Tagged(marker, inner) -> {
            if marker == .User(name) {
                if sema_taint_has(state.fixed_tags, name) && sema_taint_holds_wide(inner) -> return Val(name)
            }
            return sema_taint_fixed_wide(state, inner)
        }
        .List(inner) | .Option(inner) | .Shared(inner) -> return sema_taint_fixed_wide(state, inner)
        .FixedList(elem, _) -> return sema_taint_fixed_wide(state, elem)
        .Result(ok, _) -> return sema_taint_fixed_wide(state, ok)
        .Map(_, _, value) -> return sema_taint_fixed_wide(state, value)
        .Apply(_, args) -> loop arg in args {
            found := sema_taint_fixed_wide(state, arg)
            if found != None -> return found
        }
        else -> {}
    }
    None
}

// E0738 when the written type `ty` puts a fixed tag over an `Int` or a `Float`.
sema_taint_check_wide_type: fn(state: &SemaTaintFlowState, ty: Type, span: Span) {
    tag_value: sema_taint_fixed_wide(state, ty) ?? return
    sema_taint_e0738(state, tag_value, type_name(sema_taint_untagged(ty)), span)
}

// E0738 for `Int.from_…(x)` or `Float.from_…(x)` of a fixed value.
sema_taint_check_wide_from: fn(state: &SemaTaintFlowState, receiver: Expr, method: String, args: [CallArg], span: Span) {
    if !method.starts_with("from") -> return
    holder := ""
    if receiver == .Ident(name, _, _) -> holder = name
    if holder != "Int" && holder != "Float" -> return
    loop argument in args {
        tag_value: sema_taint_fixed_in(state, argument.expr) ?? next
        sema_taint_e0738(state, tag_value, holder, span)
        return
    }
}

// E0737 when the size an allocating method takes first carries a fixed tag.
sema_taint_check_size: fn(state: &SemaTaintFlowState, method: String, args: [CallArg]) {
    if args.len() == 0 -> return
    if method != "with_capacity" && method != "reserve" && method != "repeat" && method != "resize" -> return
    sema_taint_check_steer(state, args[0].expr, "an allocation size")
}

// Whether the `Arithmetic` scope argument `mode` wraps or saturates.
sema_taint_mode_wraps: fn(mode: ArithmeticMode?) -> Bool Never! {
    if mode == .Val(value) -> return value == .Wrapping || value == .Saturating
    false
}

sema_taint_check_expr: fn(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, expression: Expr) {
    if expression == {
        .MethodCall(receiver, method, method_span, _, _, args, _) -> {
            destinations := sema_taint_method_destinations(state, receiver, method)
            loop argument in args {
                tags := sema_taint_tags_of(state, argument.expr)
                denied := sema_taint_denied_tag(graph, state, tags, destinations)
                if denied != None {
                    tag_value: denied ?? "Input"
                    api := if receiver == {.Ident(alias, _, _) -> "{alias}.{method}" else -> method}
                    if {
                        tag_value == "Credential" && sema_taint_has(destinations, "Log") -> {
                            state.diagnostics.push(sema_taint_e0722(api, method_span))
                        }
                        else -> {
                            state.diagnostics.push(sema_taint_e0721(tag_value, api, destinations, method_span))
                        }
                    }
                    break
                }
            }
            sema_taint_check_size(state, method, args)
            sema_taint_check_wide_from(state, receiver, method, args, method_span)
            sema_taint_check_expr(graph, state, receiver)
            loop argument in args -> sema_taint_check_expr(graph, state, argument.expr)
        }
        .Call(call, _) -> {
            credential_sink := call.name == "print" || call.name == "eprint"
            destinations := if credential_sink -> [String]{"Log"} else -> [String]{call.name}
            loop argument in call.args {
                tags := sema_taint_tags_of(state, argument.expr)
                denied := sema_taint_denied_tag(graph, state, tags, destinations)
                if denied != None {
                    tag_value: denied ?? "Input"
                    if {
                        tag_value == "Credential" && credential_sink -> {
                            state.diagnostics.push(sema_taint_e0722(call.name, call.name_span))
                        }
                        else -> {
                            state.diagnostics.push(sema_taint_e0721(tag_value, call.name, destinations, call.name_span))
                        }
                    }
                    break
                }
            }
            // `wrapping(a + b)` and `saturating(a + b)` change only their one
            // operator (E1005): the operands' own operators stay checked.
            if (call.name == "wrapping" || call.name == "saturating") && call.args.len() == 1 {
                if call.args[0].expr == .Binary(op, left, right, span, _) {
                    wrapped := state.wrapping
                    state.wrapping = true
                    left_fixed: sema_taint_fixed_in(state, left)
                    right_fixed: sema_taint_fixed_in(state, right)
                    text: sema_taint_is_str(left) || sema_taint_is_str(right)
                    sema_taint_check_operator(state, op, left_fixed, right_fixed, text, span)
                    state.wrapping = wrapped
                    sema_taint_check_expr(graph, state, left)
                    sema_taint_check_expr(graph, state, right)
                    return
                }
            }
            loop argument in call.args -> sema_taint_check_expr(graph, state, argument.expr)
        }
        .CallValue(callee, args, _, _) -> {
            sema_taint_check_steer(state, callee, "an indirect call target")
            sema_taint_check_expr(graph, state, callee)
            loop argument in args -> sema_taint_check_expr(graph, state, argument.expr)
        }
        .Tainted(inner, _, _, _) -> sema_taint_check_expr(graph, state, inner)
        // A left-leaning chain (`a + b + c …`) costs no stack per operator.
        .Binary(_, left, right, _, _) -> {
            sema_taint_check_binary_chain(state, expression)
            loop operand in expr_binary_operands(left, right) -> sema_taint_check_expr(graph, state, operand)
        }
        .CompareChain(operands, _, _, _, _) | .ListLit(operands, _, _) -> loop value in operands -> sema_taint_check_expr(graph, state, value)
        .Unary(_, inner, _, _) | .Deref(inner, _, _) | .RawOf(inner, _, _) | .Copy(inner, _, _) | .Place(inner, _, _, _) | .Field(inner, _, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .Paren(inner, _, _) | .Spread(inner, _, _) -> sema_taint_check_expr(graph, state, inner)
        .Try(inner, _, _, note, _) -> {
            sema_taint_check_steer(state, inner, "a `?` (it branches on whether the value is an error)")
            sema_taint_check_expr(graph, state, inner)
            if note == {
                .Val(value) -> sema_taint_check_expr(graph, state, value)
                .None -> {}
            }
        }
        .OptField(base, _, _, _, _, _) -> sema_taint_check_expr(graph, state, base)
        .OptMethodCall(receiver, method, method_span, type_args, args, _, _) -> sema_taint_check_expr(graph, state, expr_optional_method_call_as_call(receiver, method, method_span, type_args, args))
        .Index(base, index, _, _, _) -> {
            sema_taint_check_steer(state, index, "an index (the address it reads)")
            sema_taint_check_expr(graph, state, base)
            sema_taint_check_expr(graph, state, index)
        }
        .Slice(base, start, end, range, _, _) -> {
            sema_taint_check_expr(graph, state, base)
            if range == {
                .Val(value) -> {
                    sema_taint_check_steer(state, value, "a slice bound")
                    sema_taint_check_expr(graph, state, value)
                }
                .None -> {
                    sema_taint_check_steer(state, start, "a slice bound")
                    sema_taint_check_steer(state, end, "a slice bound")
                    sema_taint_check_expr(graph, state, start)
                    sema_taint_check_expr(graph, state, end)
                }
            }
        }
        .Range(start, end, _, _, _) -> {
            sema_taint_check_expr(graph, state, start)
            sema_taint_check_expr(graph, state, end)
        }
        .MapLit(entries, _, _) -> loop entry in entries {
            sema_taint_check_expr(graph, state, entry.key)
            sema_taint_check_expr(graph, state, entry.value)
        }
        .TupleLit(fields, _, _, _) -> loop field in fields -> sema_taint_check_expr(graph, state, field.value)
        .StructLit(_, _, _, _, fields, _, _, _) -> loop field in fields -> sema_taint_check_expr(graph, state, field.value)
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> loop field in fields -> sema_taint_check_expr(graph, state, field.value)
                .Elements(elements) -> loop value in elements -> sema_taint_check_expr(graph, state, value)
                .Entries(entries) -> loop entry in entries {
                    sema_taint_check_expr(graph, state, entry.key)
                    sema_taint_check_expr(graph, state, entry.value)
                }
                .Value(value) -> sema_taint_check_expr(graph, state, value)
                else -> {}
            }
        }
        .EnumLit(_, _, _, args, _, _, _) -> loop argument in args {
            if argument == {
                .Positional(value) -> sema_taint_check_expr(graph, state, value)
                .Named(_, value) -> sema_taint_check_expr(graph, state, value)
            }
        }
        .Str(parts, _, _) -> loop part in parts {
            if part == .Interp(value, _) -> sema_taint_check_expr(graph, state, value)
        }
        .OrFallback(value, fallback, _, _, _) -> {
            sema_taint_check_steer(state, value, "a `??` fallback (it branches on whether the value is there)")
            sema_taint_check_expr(graph, state, value)
            if fallback == {
                .Value(other) -> sema_taint_check_expr(graph, state, other)
                .Block(body, tail, _) -> {
                    sema_taint_check_block(graph, state, body)
                    if tail == {
                        .Val(item) -> sema_taint_check_expr(graph, state, item)
                        .None -> {}
                    }
                }
                .Return(other, _) -> {
                    if other == {
                        .Val(item) -> sema_taint_check_expr(graph, state, item)
                        .None -> {}
                    }
                }
                else -> {}
            }
        }
        .PatternTest(subject, _, _, _) -> sema_taint_check_expr(graph, state, subject)
        .If(cond, then_body, then_value, else_body, else_value, span, _) -> {
            test := sema_taint_fixed_in(state, cond) ?? ""
            if test != "" {
                total: sema_taint_total_expr(state, expression)
                sema_taint_mask_branch(state, test, total, span, expr_span(cond))
            }
            sema_taint_check_expr(graph, state, cond)
            if test != "" -> state.under.push(test.copy())
            before := sema_taint_snapshot(state)
            sema_taint_check_block(graph, state, then_body)
            sema_taint_check_expr(graph, state, then_value)
            then_path := sema_taint_snapshot(state)
            state.bindings = sema_taint_copy_bindings(before.bindings)
            sema_taint_check_block(graph, state, else_body)
            sema_taint_check_expr(graph, state, else_value)
            else_path := sema_taint_snapshot(state)
            if test != "" -> _ := state.under.pop()
            sema_taint_merge_paths(state, before, [SemaTaintSnapshot]{then_path, else_path})
        }
        .PtrFromAddr(_, _, _, addr, _, _) -> sema_taint_check_expr(graph, state, addr)
        .Pipe(head, steps, _, _) -> {
            sema_taint_check_expr(graph, state, head)
            received := sema_taint_tags_of(state, head)
            loop step in steps {
                sema_taint_set_binding(state.bindings, step.name, received, None)
                sema_taint_check_expr(graph, state, step.value)
                received = sema_taint_tags_of(state, step.value)
            }
        }
        .Lambda(lambda, _) -> {
            if lambda.body == {
                .Expr(value) -> sema_taint_check_expr(graph, state, value)
                .Block(body) -> sema_taint_check_block(graph, state, body)
            }
        }
        else -> {}
    }
}

sema_taint_pattern_names: fn(pattern: BindPattern) -> [String] Never! {
    names := [String]{}
    if pattern == {
        .Struct(_, _, fields, _, _) -> loop field in fields -> names.push(field.name)
        .List(fields, _) -> loop field in fields -> names.push(field.name)
        .Tuple(fields, _) -> loop field in fields -> names.push(field.name)
        .Refutable(_, _, fields, _) -> loop field in fields -> names.push(field.name)
    }
    names
}

sema_taint_check_stmt: fn(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, statement: Stmt) {
    if statement == {
        .Expr(expression) | .Yield(expression, _) | .DeferClose(expression, _) -> sema_taint_check_expr(graph, state, expression)
        .BreakValue(expression, _) | .BreakLabelValue(_, _, expression, _) -> sema_taint_check_expr(graph, state, expression)
        .Val(binding) -> {
            sema_taint_check_expr(graph, state, binding.init)
            tags := sema_taint_tags_of(state, binding.init)
            sema_taint_union(tags, state.under)
            type_name := String?{None}
            if binding.ty == {
                .Val(ty) -> {
                    sema_taint_union(tags, sema_taint_type_tags(ty))
                    module_identity := state.module_identity
                    sema_taint_validate_type_tags(graph, ty, module_identity, state, binding.ty_span ?? expr_span(binding.init))
                    sema_taint_check_wide_type(state, ty, binding.ty_span ?? expr_span(binding.init))
                    type_name = sema_taint_type_name(ty)
                }
                .None -> type_name = sema_taint_type_of_expr(state, binding.init)
            }
            if binding.pattern == {
                .Val(pattern) -> loop name in sema_taint_pattern_names(pattern) -> sema_taint_set_binding(state.bindings, name, tags, None)
                .None -> if binding.name != "" {
                    sema_taint_set_binding(state.bindings, binding.name, tags, type_name)
                }
            }
        }
        .Assign(target, op, op_span, value) -> {
            sema_taint_check_expr(graph, state, value)
            if op == .Val(operator) {
                held := if target == {
                    .Local(name, _) -> sema_taint_get_binding(state, name).tags
                    .Index(base, _, _, _) | .Field(base, _, _) -> sema_taint_tags_of(state, base)
                }
                held_fixed: sema_taint_fixed_of(state, held)
                value_fixed: sema_taint_fixed_in(state, value)
                sema_taint_check_operator(state, operator, held_fixed, value_fixed, sema_taint_is_str(value), op_span)
            }
            if target == {
                .Local(name, _) -> {
                    tags := sema_taint_tags_of(state, value)
                    sema_taint_union(tags, state.under)
                    if op != None -> sema_taint_union(tags, sema_taint_get_binding(state, name).tags)
                    old := sema_taint_get_binding(state, name)
                    sema_taint_set_binding(state.bindings, name, tags, old.type_name)
                }
                .Index(base, index, _, _) -> {
                    sema_taint_check_steer(state, index, "an index (the address it writes)")
                    sema_taint_check_expr(graph, state, base)
                    sema_taint_check_expr(graph, state, index)
                }
                .Field(base, _, _) -> sema_taint_check_expr(graph, state, base)
            }
        }
        .Return(value, _) -> {
            if value == {
                .Val(expression) -> sema_taint_check_expr(graph, state, expression)
                .None -> {}
            }
        }
        .While(cond, body, _, _, _) -> {
            sema_taint_check_steer(state, cond, "a loop condition")
            sema_taint_check_expr(graph, state, cond)
            sema_taint_check_loop_body(graph, state, body)
        }
        .For(var, _, var2, kind, body, _, _, _, _) -> {
            collection_tags := [String]{}
            if kind == {
                .Range(start, end, step, _) -> {
                    sema_taint_check_steer(state, start, "a loop bound")
                    sema_taint_check_steer(state, end, "a loop bound")
                    sema_taint_check_expr(graph, state, start)
                    sema_taint_check_expr(graph, state, end)
                    if step == {
                        .Val(value) -> {
                            sema_taint_check_steer(state, value, "a loop step")
                            sema_taint_check_expr(graph, state, value)
                        }
                        .None -> {}
                    }
                }
                .In(collection, step) -> {
                    sema_taint_check_expr(graph, state, collection)
                    collection_tags = sema_taint_tags_of(state, collection)
                    if step == {
                        .Val(value) -> sema_taint_check_expr(graph, state, value)
                        .None -> {}
                    }
                }
            }
            sema_taint_set_binding(state.bindings, var, collection_tags, None)
            if var2 == {
                .Val(second) -> sema_taint_set_binding(state.bindings, second.name, collection_tags, None)
                .None -> {}
            }
            sema_taint_check_loop_body(graph, state, body)
        }
        .Switch(subject, arms, else_body, span) | .ComptimeSwitch(subject, arms, else_body, span) -> {
            sema_taint_check_steer(state, subject, "a switch")
            sema_taint_check_expr(graph, state, subject)
            // A statement `if` is a switch on `true` whose arm conditions
            // are the branches; an arm value compared with the subject
            // decides the branch as well.
            tests: sema_taint_mask_arms(state, subject, arms, else_body, span)
            under: state.under.len()
            before := sema_taint_snapshot(state)
            paths := [SemaTaintSnapshot]{}
            loop index in 0..<arms.len() {
                state.bindings = sema_taint_copy_bindings(before.bindings)
                sema_taint_check_expr(graph, state, arms[index].cond)
                if tests[index] != "" -> state.under.push(tests[index].copy())
                sema_taint_check_block(graph, state, arms[index].body)
                paths.push(sema_taint_snapshot(state))
            }
            if else_body == {
                .Val(body) -> paths.push(sema_taint_walk_path(graph, state, before, body))
                .None -> if !sema_taint_switch_exhaustive(arms, state.coverage_reports, span) -> paths.push(before.copy())
            }
            loop state.under.len() > under -> _ := state.under.pop()
            sema_taint_merge_paths(state, before, paths)
        }
        .CountedLoop(init, cond, step, body, _, _, _) -> {
            sema_taint_check_expr(graph, state, init.init)
            sema_taint_check_steer(state, cond, "a loop condition")
            sema_taint_check_expr(graph, state, cond)
            before := sema_taint_snapshot(state)
            sema_taint_check_block(graph, state, body)
            if step == {
                .Val(item) -> sema_taint_check_stmt(graph, state, item)
                .None -> {}
            }
            after_body := sema_taint_snapshot(state)
            sema_taint_merge_paths(state, before, [SemaTaintSnapshot]{before, after_body})
        }
        .Loop(body, _, _, _) -> sema_taint_check_loop_body(graph, state, body)
        .Unsafe(_, audit_expr, body, _) -> {
            if audit_expr == {
                .Val(value) -> sema_taint_check_expr(graph, state, value)
                .None -> {}
            }
            sema_taint_check_block(graph, state, body)
        }
        .Impure(_, reason_expr, body, _) -> {
            if reason_expr == {
                .Val(value) -> sema_taint_check_expr(graph, state, value)
                .None -> {}
            }
            sema_taint_check_block(graph, state, body)
        }
        .TaskGroup(_, _, args, body, _) -> {
            if args.stack == .Val(value) -> sema_taint_check_expr(graph, state, value)
            if args.limit == {
                .Val(value) -> sema_taint_check_expr(graph, state, value)
                .None -> {}
            }
            sema_taint_check_block(graph, state, body)
        }
        .AssumeDet(_, reason_expr, body, _) -> {
            sema_taint_check_expr(graph, state, reason_expr)
            sema_taint_check_block(graph, state, body)
        }
        .ScopeMember(name, _, args, _, body, _, _, _) -> {
            loop argument in args -> sema_taint_check_expr(graph, state, argument)
            wrapped := state.wrapping
            if name == "Arithmetic" && args.len() > 0 -> state.wrapping = sema_taint_mode_wraps(sema_function_arithmetic_mode(args[0]))
            sema_taint_check_block(graph, state, body)
            state.wrapping = wrapped
        }
        .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .Transact(_, _, body, _, _) | .Live(body, _) -> sema_taint_check_block(graph, state, body)
        .ComptimeIf(cond, _, then_body, else_body, _, _) -> {
            sema_taint_check_expr(graph, state, cond)
            before := sema_taint_snapshot(state)
            then_path := sema_taint_walk_path(graph, state, before, then_body)
            other_path := if else_body == {
                .Val(body) -> sema_taint_walk_path(graph, state, before, body)
                .None -> before
            }
            sema_taint_merge_paths(state, before, [SemaTaintSnapshot]{then_path, other_path})
        }
        .ComptimeBlock(body, _, _) -> sema_taint_check_block(graph, state, body)
        .ContextBlock(fields, body, _) -> {
            loop field in fields -> sema_taint_check_expr(graph, state, field.value)
            sema_taint_check_block(graph, state, body)
        }
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
    }
}

sema_taint_check_block: fn(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, body: [Stmt]) {
    loop statement in body -> sema_taint_check_stmt(graph, state, statement)
}

sema_taint_snapshot: fn(state: SemaTaintFlowState) -> SemaTaintSnapshot Never! {
    SemaTaintSnapshot{bindings: sema_taint_copy_bindings(state.bindings)}
}

sema_taint_walk_path: fn(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, before: SemaTaintSnapshot, body: [Stmt]) -> SemaTaintSnapshot {
    state.bindings = sema_taint_copy_bindings(before.bindings)
    sema_taint_check_block(graph, state, body)
    sema_taint_snapshot(state)
}

sema_taint_join_bindings: fn(left: [SemaTaintBindingFact], right: [SemaTaintBindingFact]) -> [SemaTaintBindingFact] Never! {
    result := sema_taint_copy_bindings(left)
    loop binding in right {
        index := sema_taint_binding_index(result, binding.name)
        if index == None -> result.push(SemaTaintBindingFact{name: binding.name, tags: binding.tags.copy(), type_name: binding.type_name}) else {
            current := result[index ?? 0]
            tags := current.tags.copy()
            sema_taint_union(tags, binding.tags)
            type_name := current.type_name
            if type_name == None -> type_name = binding.type_name
            if type_name != None && binding.type_name != None && type_name != binding.type_name -> type_name = None
            result[index ?? 0] = SemaTaintBindingFact{name: binding.name, tags: tags, type_name: type_name}
        }
    }
    result
}

sema_taint_merge_paths: fn(state: &SemaTaintFlowState, before: SemaTaintSnapshot, paths: [SemaTaintSnapshot]) Never! {
    if paths.len() == 0 {
        state.bindings = sema_taint_copy_bindings(before.bindings)
        return
    }
    merged := sema_taint_copy_bindings(paths[0].bindings)
    index := 1
    loop index < paths.len() {
        merged = sema_taint_join_bindings(merged, paths[index].bindings)
        index += 1
    }
    state.bindings = merged
}

sema_taint_check_loop_body: fn(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, body: [Stmt]) {
    before := sema_taint_snapshot(state)
    sema_taint_check_block(graph, state, body)
    after_body := sema_taint_snapshot(state)
    sema_taint_merge_paths(state, before, [SemaTaintSnapshot]{before, after_body})
}

sema_taint_same_span: fn(left: Span?, right: Span?) -> Bool Never! {
    if left == {
        .Val(a) -> {
            if right == {
                .Val(b) -> return a.start == b.start && a.end == b.end
                .None -> return false
            }
        }
        .None -> {
            if right == {
                .None -> return true
                .Val(_) -> return false
            }
        }
    }
}

sema_taint_switch_exhaustive: fn(arms: [SwitchArm], diagnostics: [Diagnostic], span: Span) -> Bool Never! {
    if arms.len() == 0 -> return false
    loop arm in arms {
        if arm.cond == {
            .PatternTest(_, _, _, _) -> {}
            else -> return false
        }
    }
    loop diagnostic in diagnostics {
        if diagnostic.code == "E0307" && sema_taint_same_span(diagnostic.span, Val(span)) -> return false
    }
    true
}

sema_taint_module_name: fn(graph: SemaRegistrationGraph, module_identity: String) -> String Never! {
    module_index: sema_registration_module_index(graph, module_identity) ?? return ""
    graph.modules[module_index].module_name
}

sema_taint_import_module_name: fn(graph: SemaRegistrationGraph, import: SemaRegistrationImport) -> String Never! {
    if import.declaration.kind == {
        .Module(name, _) -> return name
        .Unqualified(module_name, _, _, _, _) -> return module_name
        else -> {}
    }
    sema_taint_module_name(graph, import.target_module_identity)
}

sema_taint_collect_imports: fn(graph: SemaRegistrationGraph, module_identity: String) -> [SemaTaintImportAlias] Never! {
    imports := [SemaTaintImportAlias]{}
    module_index: sema_registration_module_index(graph, module_identity) ?? return imports
    module_row: graph.modules[module_index]
    loop import in module_row.imports {
        target_name := sema_taint_import_module_name(graph, import)
        imports.push(SemaTaintImportAlias{alias: import.declaration.alias, module_name: target_name})
        loop binding in import.bindings -> imports.push(SemaTaintImportAlias{alias: binding.local, module_name: target_name})
    }
    imports
}

// Every `#Scrub(Tag)` function's tag and signature, in catalog order, each
// report placed in its declaring module.
sema_taint_register_scrubbers: fn(catalog: SemaTaintCatalog, graph: SemaRegistrationGraph, diagnostics: &[Diagnostic]) {
    index := 0
    loop index < catalog.callables.len() {
        fact := catalog.callables[index]
        index += 1
        tag_value: fact.scrub_tag ?? next
        found := [Diagnostic]{}
        declared := sema_taint_find_tag(catalog, graph, fact.module_identity, tag_value) != None
        if {
            !declared -> {
                found.push(sema_error("E0733", fact.span, "there's no tag called `{tag_value}`", "a value tag must name a declared `tag`", "declare it first with `{tag_value}: tag {{ deny: [Effect] }}`, or check the spelling"))
            }
            else -> {
                consumes := false
                loop parameter in fact.parameter_tags {
                    if sema_taint_has(parameter.tags, tag_value) -> consumes = true
                }
                returns := sema_taint_has(fact.return_tags, tag_value)
                if !consumes || returns -> found.push(sema_error("E0736", fact.span, "`#Scrub({tag_value})` does not match this function signature", "a scrubber consumes a value carrying that tag and returns a value without it", "accept a `#{tag_value} T` parameter and return the untagged result"))
            }
        }
        if found.len() == 0 -> next
        if sema_registration_module_index(graph, fact.module_identity) == .Val(module_index) -> sema_attach_diagnostic_source_locations(found, 0, graph.modules[module_index].source_segments)
        loop diagnostic in found -> diagnostics.push(diagnostic)
    }
}

sema_taint_initial_parameter_bindings: fn(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, function: Func, owner: String) {
    loop parameter_index in 0..<function.params.len() {
        tags := sema_taint_type_tags(function.params[parameter_index].ty)
        module_identity := state.module_identity
        sema_taint_validate_type_tags(graph, function.params[parameter_index].ty, module_identity, state, function.params[parameter_index].ty_span)
        sema_taint_check_wide_type(state, function.params[parameter_index].ty, function.params[parameter_index].ty_span)
        type_name := sema_taint_type_name(function.params[parameter_index].ty)
        if function.params[parameter_index].name == "self" {
            if function.params[parameter_index].ty == {
                .Named(name) -> {
                    if name == "Self" -> type_name = Val(owner)
                }
                else -> {}
            }
        }
        sema_taint_set_binding(state.bindings, function.params[parameter_index].name, tags, type_name)
    }
}

// One body's flow from its parameters' tags; its reports, placed in the
// body's module, join `found` (sema_taint_join_reports settles repeats).
sema_taint_check_function: fn(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, module_index: Int, function: Func, owner: String, found: &[Diagnostic]) {
    state.bindings = [SemaTaintBindingFact]{}
    state.diagnostics = [Diagnostic]{}
    state.wrapping = false
    if sema_function_arithmetic_policy(function.markers) == .Val(policy) -> state.wrapping = sema_taint_mode_wraps(Val(policy.mode))
    sema_taint_initial_parameter_bindings(graph, state, function, owner)
    if function.return_type == .Val(ty) -> sema_taint_check_wide_type(state, ty, function.return_type_span ?? function.name_span)
    state.exits = [Span]{}
    state.exit_tests = [Span]{}
    state.exit_tags = [String]{}
    state.exit_marks = [Int]{}
    sema_taint_check_block(graph, state, function.body)
    read := [String]{}
    loop parameter in function.params {
        if parameter.convention == .Read && sema_taint_is_list(parameter.ty) -> read.push(parameter.name.copy())
    }
    sema_taint_settle_exits(state, function.body, read)
    sema_taint_finish_body(graph, state, module_index, found)
}

sema_taint_check_body: fn(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, module_index: Int, body: [Stmt], found: &[Diagnostic]) {
    state.bindings = [SemaTaintBindingFact]{}
    state.diagnostics = [Diagnostic]{}
    state.wrapping = false
    state.exits = [Span]{}
    state.exit_tests = [Span]{}
    state.exit_tags = [String]{}
    state.exit_marks = [Int]{}
    sema_taint_check_block(graph, state, body)
    sema_taint_settle_exits(state, body, [String]{})
    sema_taint_finish_body(graph, state, module_index, found)
}

sema_taint_finish_body: fn(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, module_index: Int, found: &[Diagnostic]) {
    if state.diagnostics.len() == 0 -> return
    sema_attach_diagnostic_source_locations(state.diagnostics, 0, graph.modules[module_index].source_segments)
    loop diagnostic in state.diagnostics -> found.push(diagnostic.copy())
}

// The bodies of module `module_index`, walked in item order; their reports
// join `found` in that order, and `state.masked` holds the module's masked
// branches.
sema_taint_check_module: fn(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, module_index: Int, found: &[Diagnostic]) {
    state.masked = [Span]{}
    state.module_identity = graph.modules[module_index].module_identity
    state.imports = sema_taint_collect_imports(graph, state.module_identity)
    state.fixed_tags = sema_taint_fixed_tags(graph, state.catalog, state.module_identity)
    loop item in graph.modules[module_index].program.items {
        if item == {
            .Func(function) -> sema_taint_check_function(graph, state, module_index, function, "", found)
            .Struct(definition) -> {
                state.diagnostics = [Diagnostic]{}
                loop field in definition.fields -> sema_taint_check_wide_type(state, field.ty, field.ty_span)
                sema_taint_finish_body(graph, state, module_index, found)
                loop method in definition.methods -> sema_taint_check_function(graph, state, module_index, method, definition.name, found)
                loop trait_impl in definition.trait_impls {
                    loop method in trait_impl.methods -> sema_taint_check_function(graph, state, module_index, method, definition.name, found)
                }
            }
            .Enum(definition) -> loop method in definition.methods -> sema_taint_check_function(graph, state, module_index, method, definition.name, found)
            .Impl(definition) -> loop method in definition.methods -> sema_taint_check_function(graph, state, module_index, method, definition.type_name, found)
            .Test(test) -> sema_taint_check_body(graph, state, module_index, test.body, found)
            .ErrorConv(definition) -> sema_taint_check_body(graph, state, module_index, definition.body, found)
            else -> {}
        }
    }
}

// A module's reports join `reports` in order, each unless `reports` or
// `existing_diagnostics` already holds it.
sema_taint_join_reports: fn(reports: &[Diagnostic], existing_diagnostics: [Diagnostic], found: [Diagnostic]) {
    loop diagnostic in found {
        if !sema_taint_has_diagnostic(reports, diagnostic) && !sema_taint_has_diagnostic(existing_diagnostics, diagnostic) -> reports.push(diagnostic.copy())
    }
}

// The tag dataflow's catalog of tags, callables and fields, the reports
// building it raised, and each module's walk weight (its items' source
// bytes). It reads only the graph's function, type, extern and tag items,
// which nothing after the failure projection rewrites, so the finalization
// builds it beside its other read-only checks (sema_finalize_side_checks).
SemaTaintPrepared: struct {
    catalog: SemaTaintCatalog
    reports: [Diagnostic]
    weights: [Int]
}

sema_taint_prepared_empty: fn() -> SemaTaintPrepared Never! {
    SemaTaintPrepared{catalog: sema_taint_catalog_init(), reports: [Diagnostic]{}, weights: [Int]{}}
}

sema_taint_prepare: fn(graph: SemaRegistrationGraph) -> SemaTaintPrepared {
    prepared := sema_taint_prepared_empty()
    sema_taint_collect_items(prepared.catalog, graph)
    sema_taint_collect_tag_declarations(prepared.catalog, graph, prepared.reports)
    sema_taint_register_scrubbers(prepared.catalog, graph, prepared.reports)
    loop module_index in 0..<graph.modules.len() {
        weight := 0
        loop item in graph.modules[module_index].program.items {
            span: sema_compiler_index_item_span(item)
            weight += span.end - span.start
        }
        prepared.weights.push(weight)
    }
    prepared
}

// One walked module's reports and masked branches (sema_finalize_walks).
SemaTaintWalked: struct {
    module_index: Int
    found: [Diagnostic]
    masked: [Span]
}

sema_taint_has_diagnostic: fn(diagnostics: [Diagnostic], candidate: Diagnostic) -> Bool Never! {
    loop diagnostic in diagnostics {
        if diagnostic.code == candidate.code && sema_taint_same_span(diagnostic.span, candidate.span) && diagnostic.source_path == candidate.source_path && diagnostic.source_offset == candidate.source_offset && diagnostic.what == candidate.what -> return true
    }
    false
}
