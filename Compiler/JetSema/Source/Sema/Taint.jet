// Declared tag policies and source-order taint flow.
//
// Taint is a semantic fact plane.  It is deliberately kept in arrays keyed by
// the registration graph's declaration identities; it is never reconstructed
// from generated TIR and it does not maintain a second name registry.
use jet_foundation.[
    BindPattern,
    CompilerThreads,
    Diagnostic,
    Effect,
    Expr,
    ExternFn,
    Field,
    Func,
    SinkClass,
    Span,
    Stmt,
    SwitchArm,
    TagDef,
    TextEdit,
    Type,
    compiler_threads_admit,
    compiler_threads_failure_text,
    compiler_threads_heaviest_first,
    core_call,
    diagnostic_with_edit,
    expr_optional_method_call_as_call,
    expr_span,
    sema_effect_covers,
]

SEMA_TAINT_ORIGIN_NET :: prep { "$origin.net" }
SEMA_TAINT_ORIGIN_FS :: prep { "$origin.fs" }
SEMA_TAINT_ORIGIN_ENV :: prep { "$origin.env" }
SEMA_TAINT_ORIGIN_PROCESS :: prep { "$origin.process" }
SEMA_TAINT_ORIGIN_FFI :: prep { "$origin.ffi" }

struct SemaTaintTagFact {
    name: String
    module_identity: String
    deny: [String]
    from: [String]
    span: Span
    visibility: Int
}

struct SemaTaintTagList {
    tags: [String]
}

struct SemaTaintCallableFact {
    key: String
    module_identity: String
    owner: String
    name: String
    parameter_tags: [SemaTaintTagList]
    return_tags: [String]
    return_type: Type?
    scrub_tag: String?
    ffi_origin: Bool
    span: Span
}

struct SemaTaintFieldFact {
    module_identity: String
    owner_type: String
    field: String
    tags: [String]
    type_name: String?
    span: Span
}

struct SemaTaintBindingFact {
    name: String
    tags: [String]
    type_name: String?
}

struct SemaTaintCatalog {
    tags: [SemaTaintTagFact]
    callables: [SemaTaintCallableFact]
    fields: [SemaTaintFieldFact]
    known_sources: [String]
    // Lookup slots kept beside the rows: the first row of each key wins, as
    // the ordered scans over every callable and field did.
    callable_slots: [String:Int]
    callable_name_slots: [String:Int]
    field_slots: [String:Int]
    field_name_slots: [String:Int]
    known_source_slots: [String:Bool]
}

struct SemaTaintImportAlias {
    alias: String
    module_name: String
}

struct SemaTaintSnapshot {
    bindings: [SemaTaintBindingFact]
}

struct SemaTaintFlowState {
    catalog: SemaTaintCatalog
    module_identity: String
    bindings: [SemaTaintBindingFact]
    imports: [SemaTaintImportAlias]
    diagnostics: [Diagnostic]
    existing_diagnostics: [Diagnostic]
}

fn sema_taint_has(values: [String], value: String) -> Bool Never! {
    loop item in values {
        if item == value -> return true
    }
    false
}

fn sema_taint_add(values: &[String], value: String) Never! {
    if !sema_taint_has(values, value) -> &values.push(value)
}

fn sema_taint_union(target: &[String], values: [String]) Never! {
    loop value in values -> sema_taint_add(&target, value)
}

fn sema_taint_remove(values: &[String], value: String) Never! {
    index := values.len() - 1
    loop index >= 0 {
        if values[index] == value -> _ := &values.remove(index, .Slot)
        index -= 1
    }
}

fn sema_taint_is_origin(value: String) -> Bool Never! {
    value.starts_with("$origin.")
}

fn sema_taint_clear_origins(values: &[String]) Never! {
    index := values.len() - 1
    loop index >= 0 {
        if sema_taint_is_origin(values[index]) -> _ := &values.remove(index, .Slot)
        index -= 1
    }
}

fn sema_taint_type_name(ty: Type) -> String? {
    if ty == {
        .Named(name) -> return Val(name)
        .Apply(name, _) -> return Val(name)
        .Tagged(_, inner) -> return sema_taint_type_name(inner)
        else -> None
    }
}

fn sema_taint_type_tags(ty: Type) -> [String] Never! {
    if ty == {
        .Tagged(marker, inner) -> {
            tags := sema_taint_type_tags(inner)
            if marker == {
                .User(name) -> sema_taint_add(&tags, name)
                .Internal(_) -> {}
            }
            return tags
        }
        else -> [String]{}
    }
}

fn sema_taint_effect_name(effect_value: Effect) -> String Never! {
    if effect_value == {
        .Net -> "Net"
        .FS -> "FS"
        .IO -> "IO"
        .DB -> "DB"
        .Time -> "Time"
        .Rand -> "Rand"
        .Env -> "Env"
        .Exec -> "Exec"
        .Log -> "Log"
        .GPU -> "GPU"
        .Panic -> "Panic"
        .FFI -> "FFI"
        .Browser -> "Browser"
        .Secret -> "Secret"
        .Mem -> "Mem"
    }
}

// The effect of the Core call `module.method` (Rust `Effects::core_effect`):
// its registered row's effect, else the module's resolver default, so a call
// the module does not declare still reaches its effect destination.
fn sema_taint_core_effect(module_name: String, method: String) -> Effect? Never! {
    if core_call(module_name, method) == .Val(record) -> return record.effect_kind
    if module_name == "core.service" && method == "state_store" -> return Val(Effect.FS)
    if module_name == "core.net" && method == "gethostname" -> return Val(Effect.Env)
    if module_name == "core.http.server" && method == "__response_parts" -> return None
    if (module_name == "core.sys" && method == "success") || (module_name == "core.process" && method == "status_ok") -> return None
    if module_name == "core.time" && method == "__zone_env" -> return Val(Effect.Env)
    if module_name == "core.time" && (method == "zone" || method == "parse_zoned" || method == "__zone_file_bytes") -> return Val(Effect.FS)
    if module_name == "core.time" && ["clock", "time", "parse_time", "period", "period_days", "period_months", "period_years", "utc", "zoned", "zoned_local", "__embedded_zone_bytes", "__clock_mono_ns"].contains(method) -> return None
    if module_name == "core.math.random" && method == "rng" -> return None
    if module_name == "core.math" && method == "random" -> return Val(Effect.Rand)
    if module_name == "core.term" && method == "style_force" -> return None
    if module_name == "core.net" && ["ip_addr", "ip_to_string", "ip_is_ipv4", "ip", "ipv4", "ipv6", "parse_ip", "is_ipv4", "is_ipv6", "__ip_from_bytes", "__ip_bytes", "__ip_is_v4", "__socket_from_parts", "__socket_ip", "__socket_port", "__socket_scope", "__udp_packet_addr", "socket_addr_parse", "socket_host", "socket_port", "socket_to_string", "ready_readable", "ready_writable", "error_operation", "error_address", "error_name", "error_message", "error_os_code", "dns_srv_target", "dns_srv_port", "dns_srv_priority", "dns_srv_weight", "udp_packet_data", "udp_packet_addr", "udp_packet_bytes", "udp_packet_original_len", "udp_packet_truncated"].contains(method) -> return None
    if module_name == "core.watcher" {
        return if method == {
            "files" -> Val(Effect.FS)
            "process_pid" -> Val(Effect.Exec)
            "port" -> Val(Effect.Net)
            else -> None
        }
    }
    if module_name == "core.web.browser" {
        return if method == {
            "profile" | "timeout" -> None
            "locked" -> Val(Effect.FS)
            "config_from_env" -> Val(Effect.Env)
            else -> Val(Effect.Net)
        }
    }
    if module_name == "core.encoding" && ["__read_byte", "__read_into", "__write_bytes", "__write_text", "__flush"].contains(method) -> return Val(Effect.IO)
    if ["core.encoding.json", "core.encoding.jsonl", "core.encoding.csv", "core.encoding.xml", "core.encoding.cbor"].contains(module_name) && (method == "reader" || method == "writer") -> return Val(Effect.FS)
    if module_name == "core.compute" && method != "device_cpu" -> return Val(Effect.GPU)
    if module_name == "core.crypto" && method.starts_with("__jetc_") -> return Val(Effect.FS)
    if module_name == "core.auth" && ["register_user", "password_login", "session_validate", "magic_link_issue", "magic_link_consume", "oauth_begin", "oauth_finish", "__store_load", "__store_replace"].contains(method) -> return Val(Effect.DB)
    if module_name == "core.crypto.vault" && ["get", "current", "versions", "load", "status", "prepare_generate", "prepare_store", "prepare_rotate", "prepare_retire", "prepare_revoke", "authorize_write", "commit_generate", "commit_store", "commit_rotate", "commit_retire", "commit_revoke", "export_to_recipients", "export_to_passphrase", "prepare_import_wrapped", "authorize_wrapped_import", "commit_import_wrapped", "prepare_import_signing", "prepare_import_x25519", "commit_import_signing", "commit_import_x25519"].contains(method) -> return Val(Effect.Secret)
    if module_name == {
        "core.files" -> Val(Effect.FS)
        "core.net" | "core.net.tls" | "core.http.client" | "core.http.server" | "core.http.middleware" -> Val(Effect.Net)
        "core.game.raylib" -> Val(Effect.GPU)
        "core.time" -> Val(Effect.Time)
        "core.math.random" | "core.crypto.random" -> Val(Effect.Rand)
        "core.sys" -> Val(Effect.Env)
        "core.process" | "core.plugin" | "core.mod" -> Val(Effect.Exec)
        "core.term" -> Val(Effect.IO)
        "core.db" -> Val(Effect.DB)
        "core.log" -> Val(Effect.Log)
        "core.ui" | "core.web" | "core.web.storage.local" | "core.web.storage.session" -> Val(Effect.Browser)
        else -> None
    }
}

// A Core call that writes to a log, terminal, or serialized output, where a
// credential would leak (Rust `Syntax::credential_sink`).
fn sema_taint_credential_sink(module_name: String, method: String) -> Bool Never! {
    if core_call(module_name, method) == .Val(record) {
        if record.sink_class == .Val(sink_class) -> return sink_class == SinkClass.Credential
    }
    if module_name == "core.log" -> return true
    if module_name == "core.term" -> return method == "print" || method == "eprint"
    if ["core.encoding.json", "core.encoding.csv", "core.encoding.toml", "core.encoding.yaml", "core.encoding.cbor", "core.encoding.xml"].contains(module_name) -> return ["to_string", "to_string_pretty", "to_bytes", "to_bytes_canonical"].contains(method)
    module_name == "core.encoding.jsonl" && method == "to_string"
}

fn sema_taint_builtin_tag(name: String) -> SemaTaintTagFact? {
    injection := [String]{"DB", "Exec", "Net"}
    if name == "Input" || name == "PII" || name == "Secret" {
        return Val(SemaTaintTagFact{name: name, module_identity: "", deny: injection, from: [String]{}, span: Span{start: 0, end: 0}, visibility: 2})
    }
    if name == "Credential" {
        deny := injection
        &deny.push("Log")
        return Val(SemaTaintTagFact{name: name, module_identity: "", deny: deny, from: [String]{}, span: Span{start: 0, end: 0}, visibility: 2})
    }
    None
}

fn sema_taint_builtin_tag_names() -> [String] Never! {
    [String]{"Input", "PII", "Secret", "Credential"}
}

fn sema_taint_add_builtin_tags(catalog: &SemaTaintCatalog) Never! {
    loop name in sema_taint_builtin_tag_names() {
        if sema_taint_builtin_tag(name) == {
            .Val(fact) -> &catalog.tags.push(fact)
            .None -> {}
        }
    }
    origin_rows := [SemaTaintTagFact]{
        {name: SEMA_TAINT_ORIGIN_NET, module_identity: "", deny: [String]{"SQL.raw", "HTML.raw", "Sh.raw"}, from: [String]{"Net"}, span: Span{start: 0, end: 0}, visibility: 2},
        {name: SEMA_TAINT_ORIGIN_FS, module_identity: "", deny: [String]{"SQL.raw", "HTML.raw", "Sh.raw"}, from: [String]{"FS"}, span: Span{start: 0, end: 0}, visibility: 2},
        {name: SEMA_TAINT_ORIGIN_ENV, module_identity: "", deny: [String]{"SQL.raw", "HTML.raw", "Sh.raw"}, from: [String]{"Env"}, span: Span{start: 0, end: 0}, visibility: 2},
        {name: SEMA_TAINT_ORIGIN_PROCESS, module_identity: "", deny: [String]{"SQL.raw", "HTML.raw", "Sh.raw"}, from: [String]{"Exec"}, span: Span{start: 0, end: 0}, visibility: 2},
        {name: SEMA_TAINT_ORIGIN_FFI, module_identity: "", deny: [String]{"SQL.raw", "HTML.raw", "Sh.raw"}, from: [String]{"FFI"}, span: Span{start: 0, end: 0}, visibility: 2},
    }
    loop row in origin_rows -> &catalog.tags.push(row)
}

fn sema_taint_catalog_init() -> SemaTaintCatalog Never! {
    catalog := SemaTaintCatalog{tags: [SemaTaintTagFact]{}, callables: [SemaTaintCallableFact]{}, fields: [SemaTaintFieldFact]{}, known_sources: [String]{}, callable_slots: [String:Int]{}, callable_name_slots: [String:Int]{}, field_slots: [String:Int]{}, field_name_slots: [String:Int]{}, known_source_slots: [String:Bool]{}}
    sema_taint_add_builtin_tags(&catalog)
    catalog
}

fn sema_taint_edit_distance(left: String, right: String) -> Int Never! {
    a := left.bytes()
    b := right.bytes()
    previous := [Int]{}
    index := 0
    loop index <= b.len() {
        &previous.push(index)
        index += 1
    }
    i := 0
    loop i < a.len() {
        current := [Int]{i + 1}
        j := 0
        loop j < b.len() {
            cost := 0
            if a[i] != b[j] -> cost = 1
            deletion := previous[j + 1] + 1
            insertion := current[j] + 1
            substitution := previous[j] + cost
            best := deletion
            if insertion < best -> best = insertion
            if substitution < best -> best = substitution
            &current.push(best)
            j += 1
        }
        previous = current
        i += 1
    }
    previous[b.len()]
}

fn sema_taint_closest(name: String, candidates: [String]) -> String? {
    best := ""
    best_distance := 4
    ambiguous := false
    loop candidate in candidates {
        distance := sema_taint_edit_distance(name, candidate)
        if distance == 0 || distance > 3 -> next
        if {
            distance < best_distance -> {
                best = candidate
                best_distance = distance
                ambiguous = false
            }
            distance == best_distance && best != candidate -> {
                ambiguous = true
            }
        }
    }
    if best == "" || ambiguous -> None else -> Val(best)
}

fn sema_taint_tag_candidate_names(catalog: SemaTaintCatalog) -> [String] Never! {
    names := [String]{}
    loop tag_value in catalog.tags {
        if !tag_value.name.starts_with("$origin.") -> sema_taint_add(&names, tag_value.name)
    }
    names
}

fn sema_taint_known_destination(destination: String) -> Bool Never! {
    if destination == "Html" -> return true
    sema_effect_parse_name(destination) != None
}

fn sema_taint_known_source(source: String, catalog: SemaTaintCatalog) -> Bool Never! {
    sema_effect_parse_name(source) != None || catalog.known_source_slots.get(source) != None
}

fn sema_taint_push_invalid_path(diagnostics: &[Diagnostic], name: String, span: Span, destination: Bool, catalog: SemaTaintCatalog) {
    candidates := [String]{}
    if {
        destination -> {
            candidates = sema_effect_grantable_roots()
            &candidates.push("Html")
        }
        else -> {
            candidates = catalog.known_sources
        }
    }
    suggestion := sema_taint_closest(name, candidates)
    fix := ""
    if suggestion == {
        .Val(value) -> fix = "did you mean `{value}`?"
        .None -> {
            if destination -> fix = "use a known effect such as `DB`, `Net`, `Exec`, `Log`, or `Html`"
            else -> fix = "use a known effect or a declared function path"
        }
    }
    diagnostic := if destination -> sema_error("E0735", span, "`{name}` is not a known tag destination", "a `deny` entry names an effect or a registered sink", fix) else -> sema_error("E0735", span, "`{name}` is not a known tag source", "a `from` entry names an effect or a function path", fix)
    if suggestion == {
        .Val(value) -> &diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: value}))
        .None -> &diagnostics.push(diagnostic)
    }
}

fn sema_taint_add_tag_declaration(catalog: &SemaTaintCatalog, module_identity: String, tag_def: TagDef, diagnostics: &[Diagnostic]) {
    deny := [String]{}
    from := [String]{}
    loop item in tag_def.deny {
        &deny.push(item.name)
    }
    loop item in tag_def.from {
        &from.push(item.name)
    }
    &catalog.tags.push(SemaTaintTagFact{name: tag_def.name, module_identity: module_identity, deny: deny, from: from, span: tag_def.name_span, visibility: if tag_def.is_pub -> 2 else -> if tag_def.is_package_pub -> 1 else -> 0})
    loop item in tag_def.deny {
        if !sema_taint_known_destination(item.name) -> sema_taint_push_invalid_path(&diagnostics, item.name, item.span, true, catalog)
    }
    loop item in tag_def.from {
        if !sema_taint_known_source(item.name, catalog) -> sema_taint_push_invalid_path(&diagnostics, item.name, item.span, false, catalog)
    }
}
fn sema_taint_collect_tag_declarations(catalog: &SemaTaintCatalog, graph: SemaRegistrationGraph, diagnostics: &[Diagnostic]) {
    loop module_row_index in 0..<graph.modules.len() {
        module_diagnostics := [Diagnostic]{}
        loop item_index in 0..<graph.modules[module_row_index].program.items.len() {
            if graph.modules[module_row_index].program.items[item_index] == .Tag(tag_value) -> sema_taint_add_tag_declaration(&catalog, graph.modules[module_row_index].module_identity, tag_value, &module_diagnostics)
        }
        sema_attach_diagnostic_source_locations(&module_diagnostics, 0, graph.modules[module_row_index].source_segments)
        loop diagnostic in module_diagnostics -> &diagnostics.push(diagnostic)
    }
}

fn sema_taint_callable_key(module_identity: String, owner: String, name: String) -> String Never! {
    if owner == "" -> return "{module_identity}:{name}"
    "{module_identity}:{owner}::{name}"
}

fn sema_taint_add_known_source(catalog: &SemaTaintCatalog, source: String) Never! {
    if catalog.known_source_slots.get(source) != None -> return
    catalog.known_source_slots[source] = true
    &catalog.known_sources.push(source)
}

fn sema_taint_add_source_path(catalog: &SemaTaintCatalog, module_alias: String, owner: String, name: String) Never! {
    local := if owner == "" -> name else -> "{owner}.{name}"
    sema_taint_add_known_source(&catalog, local)
    sema_taint_add_known_source(&catalog, "{module_alias}.{local}")
}

// The slots of the callable row just pushed.
fn sema_taint_index_callable(catalog: &SemaTaintCatalog, module_identity: String, owner: String, name: String) Never! {
    slot :: catalog.callables.len() - 1
    exact :: "{module_identity}|{owner}|{name}"
    if catalog.callable_slots.get(exact) == None -> catalog.callable_slots[exact] = slot
    loose :: "{owner}|{name}"
    if catalog.callable_name_slots.get(loose) == None -> catalog.callable_name_slots[loose] = slot
}

fn sema_taint_add_callable(catalog: &SemaTaintCatalog, module_identity: String, module_alias: String, owner: String, function: Func) Never! {
    params := [SemaTaintTagList]{}
    loop parameter_index in 0..<function.params.len() -> &params.push(SemaTaintTagList{tags: sema_taint_type_tags(function.params[parameter_index].ty)})
    return_tags := [String]{}
    if function.return_type == {
        .Val(ty) -> return_tags = sema_taint_type_tags(ty)
        .None -> {}
    }
    ffi_origin := function.inline_foreign != None
    if ffi_origin -> sema_taint_add(&return_tags, SEMA_TAINT_ORIGIN_FFI)
    key := sema_taint_callable_key(module_identity, owner, function.name)
    &catalog.callables.push(SemaTaintCallableFact{key: key, module_identity: module_identity, owner: owner, name: function.name, parameter_tags: params, return_tags: return_tags, return_type: function.return_type, scrub_tag: function.scrub_tag, ffi_origin: ffi_origin, span: function.name_span})
    sema_taint_index_callable(&catalog, module_identity, owner, function.name)
    sema_taint_add_source_path(&catalog, module_alias, owner, function.name)
}

fn sema_taint_add_extern_callable(catalog: &SemaTaintCatalog, module_identity: String, function: ExternFn) Never! {
    params := [SemaTaintTagList]{}
    loop parameter_index in 0..<function.params.len() -> &params.push(SemaTaintTagList{tags: sema_taint_type_tags(function.params[parameter_index].ty)})
    returns := [String]{SEMA_TAINT_ORIGIN_FFI}
    if function.return_type != None -> returns = sema_taint_type_tags(function.return_type ?? Type.Named{name: "Unit"})
    sema_taint_add(&returns, SEMA_TAINT_ORIGIN_FFI)
    &catalog.callables.push(SemaTaintCallableFact{key: "{module_identity}:{function.name}", module_identity: module_identity, owner: "", name: function.name, parameter_tags: params, return_tags: returns, return_type: function.return_type, scrub_tag: None, ffi_origin: true, span: function.name_span})
    sema_taint_index_callable(&catalog, module_identity, "", function.name)
}

fn sema_taint_add_field(catalog: &SemaTaintCatalog, module_identity: String, owner: String, field: Field) Never! {
    &catalog.fields.push(SemaTaintFieldFact{module_identity: module_identity, owner_type: owner, field: field.name, tags: sema_taint_type_tags(field.ty), type_name: sema_taint_type_name(field.ty), span: field.ty_span})
    slot :: catalog.fields.len() - 1
    exact :: "{module_identity}|{owner}|{field.name}"
    if catalog.field_slots.get(exact) == None -> catalog.field_slots[exact] = slot
    loose :: "{owner}|{field.name}"
    if catalog.field_name_slots.get(loose) == None -> catalog.field_name_slots[loose] = slot
}
fn sema_taint_collect_items(catalog: &SemaTaintCatalog, graph: SemaRegistrationGraph) Never! {
    loop module_row_index in 0..<graph.modules.len() {
        loop item_index in 0..<graph.modules[module_row_index].program.items.len() {
            if graph.modules[module_row_index].program.items[item_index] == {
                .Func(function) -> sema_taint_add_callable(&catalog, graph.modules[module_row_index].module_identity, graph.modules[module_row_index].module_name, "", function)
                .Struct(definition) -> {
                    loop field in definition.fields -> sema_taint_add_field(&catalog, graph.modules[module_row_index].module_identity, definition.name, field)
                    loop method in definition.methods -> sema_taint_add_callable(&catalog, graph.modules[module_row_index].module_identity, graph.modules[module_row_index].module_name, definition.name, method)
                    loop trait_impl in definition.trait_impls {
                        loop method in trait_impl.methods -> sema_taint_add_callable(&catalog, graph.modules[module_row_index].module_identity, graph.modules[module_row_index].module_name, definition.name, method)
                    }
                }
                .Enum(definition) -> loop method in definition.methods -> sema_taint_add_callable(&catalog, graph.modules[module_row_index].module_identity, graph.modules[module_row_index].module_name, definition.name, method)
                .Impl(definition) -> loop method in definition.methods -> sema_taint_add_callable(&catalog, graph.modules[module_row_index].module_identity, graph.modules[module_row_index].module_name, definition.type_name, method)
                .ExternRust(block) -> loop function in block.functions -> sema_taint_add_extern_callable(&catalog, graph.modules[module_row_index].module_identity, function)
                .CModule(block) -> loop function in block.functions -> sema_taint_add_extern_callable(&catalog, graph.modules[module_row_index].module_identity, function)
                else -> {}
            }
        }
    }
}

fn sema_taint_import_module(graph: SemaRegistrationGraph, module_identity: String, name: String) -> String Never! {
    module_index :: sema_registration_module_index(graph, module_identity) ?? return ""
    module_row :: graph.modules[module_index]
    // The package names bind after the imports before
    // `namespace_import_split`, unless the module declares the name itself.
    namespace_from :: if module_row.namespace_import_split < 0 -> module_row.imports.len() else -> module_row.namespace_import_split
    loop (import_index, import) in module_row.imports {
        if import_index == namespace_from {
            namespace :: sema_taint_namespace_module(graph, module_index, name)
            if namespace != "" -> return namespace
        }
        loop binding in import.bindings {
            if binding.local == name -> return binding.target_module_identity
        }
        if import.declaration.alias == name -> return import.target_module_identity
    }
    if namespace_from >= module_row.imports.len() -> return sema_taint_namespace_module(graph, module_index, name)
    ""
}

fn sema_taint_namespace_module(graph: SemaRegistrationGraph, module_index: Int, name: String) -> String Never! {
    if graph.modules[module_index].symbol_positions.get(name) != None -> return ""
    owner :: sema_registration_namespace_owner(graph, module_index, name) ?? return ""
    graph.modules[owner.module_index].module_identity
}
fn sema_taint_find_tag(catalog: SemaTaintCatalog, graph: SemaRegistrationGraph, module_identity: String, name: String) -> SemaTaintTagFact? {
    builtin :: sema_taint_builtin_tag(name)
    if builtin != None -> return builtin
    index := 0
    loop index < catalog.tags.len() {
        tag_value := catalog.tags[index]
        if tag_value.name == name && (tag_value.module_identity == module_identity || tag_value.module_identity == sema_taint_import_module(graph, module_identity, name)) -> return Val(tag_value)
        index += 1
    }
    None
}

fn sema_taint_find_callable(catalog: SemaTaintCatalog, module_identity: String, owner: String, name: String) -> SemaTaintCallableFact? {
    exact :: catalog.callable_slots.get("{module_identity}|{owner}|{name}")
    if exact == .Val(slot) {
        callable := catalog.callables[slot]
        return Val(callable)
    }
    loose :: catalog.callable_name_slots.get("{owner}|{name}") ?? return None
    callable := catalog.callables[loose]
    Val(callable)
}

// A field of `owner` declared in `module_identity` (or with no declaring
// module), else the first field of that name on any `owner`.
fn sema_taint_find_field(catalog: SemaTaintCatalog, module_identity: String, owner: String, field: String) -> SemaTaintFieldFact? {
    local :: catalog.field_slots.get("{module_identity}|{owner}|{field}")
    unowned :: catalog.field_slots.get("|{owner}|{field}")
    first := local
    if unowned == .Val(unowned_slot) {
        if local == .Val(local_slot) {
            if unowned_slot < local_slot -> first = unowned
        } else {
            first = unowned
        }
    }
    if first == .Val(slot) {
        fact := catalog.fields[slot]
        return Val(fact)
    }
    loose :: catalog.field_name_slots.get("{owner}|{field}") ?? return None
    fact := catalog.fields[loose]
    Val(fact)
}
fn sema_taint_validate_tag_in_catalog(tag_value: String, module_identity: String, catalog: SemaTaintCatalog, graph: SemaRegistrationGraph, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if sema_taint_find_tag(catalog, graph, module_identity, tag_value) != None -> return true
    candidates := sema_taint_tag_candidate_names(catalog)
    suggestion := sema_taint_closest(tag_value, candidates)
    fix := ""
    if suggestion == {
        .Val(value) -> fix = "did you mean `{value}`?"
        .None -> fix = "declare it first with `tag {tag_value} {{ deny: [Effect] }}`, or check the spelling"
    }
    diagnostic := sema_error("E0733", span, "there's no tag called `{tag_value}`", "a value tag must name a declared `tag`", fix)
    if suggestion == {
        .Val(value) -> &diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: value}))
        .None -> &diagnostics.push(diagnostic)
    }
    false
}
fn sema_taint_validate_tag_graph(tag_value: String, module_identity: String, graph: SemaRegistrationGraph, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    catalog := sema_taint_catalog_init()
    temporary := [Diagnostic]{}
    sema_taint_collect_tag_declarations(&catalog, graph, &temporary)
    sema_taint_validate_tag_in_catalog(tag_value, module_identity, catalog, graph, span, &diagnostics)
}
fn sema_taint_validate_tag(tag_value: String, env: SemaScopeEnvironment, program: SemaProgramTables, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if program.registration_graph == {
        .Val(value) -> return sema_taint_validate_tag_graph(tag_value, env.module_identity, value, span, &diagnostics)
        .None -> {}
    }
    if sema_taint_builtin_tag(tag_value) != None || tag_value == SEMA_TAINT_ORIGIN_NET || tag_value == SEMA_TAINT_ORIGIN_FS || tag_value == SEMA_TAINT_ORIGIN_ENV || tag_value == SEMA_TAINT_ORIGIN_PROCESS || tag_value == SEMA_TAINT_ORIGIN_FFI -> return true
    candidates := [String]{"Input", "PII", "Secret", "Credential"}
    suggestion := sema_taint_closest(tag_value, candidates)
    fix := ""
    if suggestion == {
        .Val(value) -> fix = "did you mean `{value}`?"
        .None -> fix = "declare it first with `tag {tag_value} {{ deny: [Effect] }}`, or check the spelling"
    }
    diagnostic := sema_error("E0733", span, "there's no tag called `{tag_value}`", "a value tag must name a declared `tag`", fix)
    if suggestion == {
        .Val(value) -> &diagnostics.push(diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: value}))
        .None -> &diagnostics.push(diagnostic)
    }
    false
}

fn sema_taint_validate_type_tags(graph: SemaRegistrationGraph, ty: Type, module_identity: String, state: &SemaTaintFlowState, span: Span) {
    if ty == {
        .Tagged(marker, inner) -> {
            if marker == {
                .User(name) -> {
                    _ := sema_taint_validate_tag_in_catalog(name, module_identity, state.catalog, graph, span, &state.diagnostics)
                }
                .Internal(_) -> {}
            }
            sema_taint_validate_type_tags(graph, inner, module_identity, &state, span)
        }
        else -> {}
    }
}

fn sema_taint_binding_index(bindings: [SemaTaintBindingFact], name: String) -> Int? {
    index := bindings.len() - 1
    loop index >= 0 {
        if bindings[index].name == name -> return Val(index)
        index -= 1
    }
    None
}

fn sema_taint_copy_bindings(bindings: [SemaTaintBindingFact]) -> [SemaTaintBindingFact] Never! {
    result := [SemaTaintBindingFact]{}
    loop binding in bindings {
        &result.push(SemaTaintBindingFact{name: binding.name, tags: binding.tags.copy(), type_name: binding.type_name})
    }
    result
}

fn sema_taint_set_binding(bindings: &[SemaTaintBindingFact], name: String, tags: [String], type_name: String?) Never! {
    index :: sema_taint_binding_index(bindings, name)
    if {
        index == None -> {
            &bindings.push(SemaTaintBindingFact{name: name, tags: tags.copy(), type_name: type_name})
        }
        else -> {
            bindings[index] = SemaTaintBindingFact{name: name, tags: tags.copy(), type_name: type_name}
        }
    }
}

fn sema_taint_get_binding(state: SemaTaintFlowState, name: String) -> SemaTaintBindingFact Never! {
    index :: sema_taint_binding_index(state.bindings, name) ?? return SemaTaintBindingFact{name: name, tags: [String]{}, type_name: None}
    state.bindings[index]
}

fn sema_taint_source_tags(state: SemaTaintFlowState, destinations: [String]) -> [String] Never! {
    tags := [String]{}
    loop fact in state.catalog.tags {
        loop source in fact.from {
            covered := false
            loop destination in destinations {
                if sema_effect_covers(source, destination) {
                    covered = true
                    break
                }
            }
            if covered {
                sema_taint_add(&tags, fact.name)
                break
            }
        }
    }
    tags
}

fn sema_taint_core_alias(state: SemaTaintFlowState, alias: String) -> String Never! {
    loop item in state.imports {
        if item.alias == alias && item.module_name.starts_with("core.") -> return item.module_name
    }
    ""
}

fn sema_taint_core_module_for_receiver(state: SemaTaintFlowState, receiver: Expr) -> String Never! {
    if receiver == {
        .Ident(name, _, _) -> return sema_taint_core_alias(state, name)
        .Field(base, field, _, _) -> {
            module_row := sema_taint_core_module_for_receiver(state, base)
            if module_row != "" -> return "{module_row}.{field}"
        }
        else -> {}
    }
    ""
}
fn sema_taint_method_destinations(state: SemaTaintFlowState, receiver: Expr, method: String) -> [String] Never! {
    destinations := [String]{}
    if receiver == {
        .Ident(alias, _, _) -> {
            module_row := sema_taint_core_alias(state, alias)
            if {
                module_row == "" -> {
                    &destinations.push("{alias}.{method}")
                }
                else -> {
                    &destinations.push("{module_row}.{method}")
                    if sema_taint_core_effect(module_row, method) == .Val(effect_value) -> &destinations.push(sema_taint_effect_name(effect_value))
                    if sema_taint_credential_sink(module_row, method) -> &destinations.push("Log")
                }
            }
        }
        else -> {}
    }
    destinations
}
fn sema_taint_is_typed_decode(state: SemaTaintFlowState, receiver: Expr, method: String) -> Bool Never! {
    if method != "decode" -> return false
    module_row := sema_taint_core_module_for_receiver(state, receiver)
    module_row == "core.encoding.json" || module_row == "core.encoding.jsonl" || module_row == "core.encoding.csv" || module_row == "core.encoding.toml" || module_row == "core.encoding.yaml" || module_row == "core.encoding.cbor" || module_row == "core.encoding.xml"
}

fn sema_taint_is_credential_verify(state: SemaTaintFlowState, receiver: Expr, method: String) -> Bool Never! {
    module_row := sema_taint_core_module_for_receiver(state, receiver)
    module_row == "core.auth" && (method == "verify_jwt" || method == "verify_paseto")
}

fn sema_taint_type_of_expr(state: SemaTaintFlowState, expression: Expr) -> String? {
    if expression == {
        .Ident(name, _, _) -> return sema_taint_get_binding(state, name).type_name
        .StructLit(type_name, _, _, _, _, _, _, _) -> return Val(type_name)
        .Call(call, _) -> {
            fact :: sema_taint_find_callable(state.catalog, state.module_identity, "", call.name) ?? return None
            return sema_taint_type_name(fact.return_type ?? Type.Named{name: "Unit"})
        }
        .OptMethodCall(receiver, method, method_span, type_args, args, _, _) -> return sema_taint_type_of_expr(state, expr_optional_method_call_as_call(receiver, method, method_span, type_args, args))
        .Field(base, field, _, _) | .OptField(base, field, _, _, _, _) -> {
            owner :: sema_taint_type_of_expr(state, base) ?? return None
            fact :: sema_taint_find_field(state.catalog, state.module_identity, owner, field) ?? return None
            return fact.type_name
        }
        .Paren(inner, _, _) | .Copy(inner, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) -> return sema_taint_type_of_expr(state, inner)
        .Try(inner, _, _, _, _) -> return sema_taint_type_of_expr(state, inner)
        else -> {}
    }
    None
}

fn sema_taint_call_return_tags(state: SemaTaintFlowState, owner: String, name: String) -> [String] Never! {
    fact :: sema_taint_find_callable(state.catalog, state.module_identity, owner, name) ?? return [String]{}
    fact.return_tags
}

fn sema_taint_scrub(state: SemaTaintFlowState, tags: &[String], owner: String, name: String) Never! {
    fact :: sema_taint_find_callable(state.catalog, state.module_identity, owner, name) ?? return
    if fact.scrub_tag == {
        .Val(tag_value) -> {
            sema_taint_remove(&tags, tag_value)
            sema_taint_clear_origins(&tags)
        }
        .None -> {}
    }
}
 

fn sema_taint_tags_of(state: &SemaTaintFlowState, expression: Expr) -> [String] {
    if expression == {
        .Tainted(inner, tag_value, _, _) -> {
            tags := sema_taint_tags_of(&state, inner)
            actual := tag_value ?? "Input"
            sema_taint_add(&tags, actual)
            return tags
        }
        .Ident(name, _, _) -> return sema_taint_get_binding(state, name).tags
        .Call(call, _) -> {
            tags := [String]{}
            loop argument in call.args -> sema_taint_union(&tags, sema_taint_tags_of(&state, argument.expr))
            sema_taint_union(&tags, sema_taint_source_tags(state, [String]{call.name}))
            sema_taint_union(&tags, sema_taint_call_return_tags(state, "", call.name))
            sema_taint_scrub(state, &tags, "", call.name)
 
            return tags
        }
        .MethodCall(receiver, method, _, _, _, args, _) -> {
            tags := sema_taint_tags_of(&state, receiver)
            loop argument in args -> sema_taint_union(&tags, sema_taint_tags_of(&state, argument.expr))
            destinations := sema_taint_method_destinations(state, receiver, method)
            sema_taint_union(&tags, sema_taint_source_tags(state, destinations))
            sema_taint_union(&tags, sema_taint_call_return_tags(state, "", method))
            sema_taint_scrub(state, &tags, "", method)
            if sema_taint_is_typed_decode(state, receiver, method) -> sema_taint_clear_origins(&tags)
            if sema_taint_is_credential_verify(state, receiver, method) -> sema_taint_remove(&tags, "Credential")
            return tags
        }
        .OptMethodCall(receiver, method, method_span, type_args, args, _, _) -> return sema_taint_tags_of(&state, expr_optional_method_call_as_call(receiver, method, method_span, type_args, args))
        .CallValue(callee, args, _, _) -> {
            tags := sema_taint_tags_of(&state, callee)
            loop argument in args -> sema_taint_union(&tags, sema_taint_tags_of(&state, argument.expr))
            return tags
        }
        .Binary(_, left, right, _, _) | .Range(left, right, _, _, _) -> {
            tags := sema_taint_tags_of(&state, left)
            sema_taint_union(&tags, sema_taint_tags_of(&state, right))
            return tags
        }
        .CompareChain(operands, _, _, _, _) | .ListLit(operands, _, _) -> {
            tags := [String]{}
            loop value in operands -> sema_taint_union(&tags, sema_taint_tags_of(&state, value))
            return tags
        }
        .Field(base, field, _, _) | .OptField(base, field, _, _, _, _) -> {
            tags := sema_taint_tags_of(&state, base)
            owner := sema_taint_type_of_expr(state, base)
            if owner == {
                .Val(type_name) -> {
                    fact := sema_taint_find_field(state.catalog, state.module_identity, type_name, field)
                    if fact == {
                        .Val(row) -> sema_taint_union(&tags, row.tags)
                        .None -> {}
                    }
                }
                .None -> {}
            }
            return tags
        }
        .Unary(_, inner, _, _) | .Deref(inner, _, _) | .RawOf(inner, _, _) | .Copy(inner, _, _) | .Place(inner, _, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .Paren(inner, _, _) | .Spread(inner, _, _) -> return sema_taint_tags_of(&state, inner)
        .Try(inner, _, _, note, _) -> {
            tags := sema_taint_tags_of(&state, inner)
            if note == {
                .Val(other) -> sema_taint_union(&tags, sema_taint_tags_of(&state, other))
                .None -> {}
            }
            return tags
        }
        .MemberSpread(base, _, _, _) -> return sema_taint_tags_of(&state, base)
        .Index(base, index, _, _, _) -> {
            tags := sema_taint_tags_of(&state, base)
            sema_taint_union(&tags, sema_taint_tags_of(&state, index))
            return tags
        }
        .Slice(base, start, end, range, _, _) -> {
            tags := sema_taint_tags_of(&state, base)
            if range == {
                .Val(value) -> sema_taint_union(&tags, sema_taint_tags_of(&state, value))
                .None -> {
                    sema_taint_union(&tags, sema_taint_tags_of(&state, start))
                    sema_taint_union(&tags, sema_taint_tags_of(&state, end))
                }
            }
            return tags
        }
        .MapLit(entries, _, _) -> {
            tags := [String]{}
            loop entry in entries {
                sema_taint_union(&tags, sema_taint_tags_of(&state, entry.key))
                sema_taint_union(&tags, sema_taint_tags_of(&state, entry.value))
            }
            return tags
        }
        .TupleLit(fields, _, _, _) -> {
            tags := [String]{}
            loop field in fields -> sema_taint_union(&tags, sema_taint_tags_of(&state, field.value))
            return tags
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            tags := [String]{}
            loop field in fields -> sema_taint_union(&tags, sema_taint_tags_of(&state, field.value))
            sema_taint_clear_origins(&tags)
            return tags
        }
        .TypedLit(_, body, _, _) -> {
            tags := [String]{}
            if body == {
                .Fields(fields) -> loop field in fields -> sema_taint_union(&tags, sema_taint_tags_of(&state, field.value))
                .Elements(elements) -> loop value in elements -> sema_taint_union(&tags, sema_taint_tags_of(&state, value))
                .Entries(entries) -> loop entry in entries -> sema_taint_union(&tags, sema_taint_tags_of(&state, entry.value))
                .Value(value) -> sema_taint_union(&tags, sema_taint_tags_of(&state, value))
                else -> {}
            }
            sema_taint_clear_origins(&tags)
            return tags
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            tags := [String]{}
            loop argument in args {
                if argument == {
                    .Positional(value) -> sema_taint_union(&tags, sema_taint_tags_of(&state, value))
                    .Named(_, value) -> sema_taint_union(&tags, sema_taint_tags_of(&state, value))
                }
            }
            return tags
        }
        .Str(parts, _, _) -> {
            tags := [String]{}
            loop part in parts {
                if part == .Interp(value, _) -> sema_taint_union(&tags, sema_taint_tags_of(&state, value))
            }
            return tags
        }
        .OrFallback(value, fallback, _, _, _) -> {
            tags := sema_taint_tags_of(&state, value)
            if fallback == {
                .Value(other) -> sema_taint_union(&tags, sema_taint_tags_of(&state, other))
                .Return(other, _) -> {
                    if other == {
                        .Val(item) -> sema_taint_union(&tags, sema_taint_tags_of(&state, item))
                        .None -> {}
                    }
                }
                .Block(_, _, _) -> {}
                else -> {}
            }
            return tags
        }
        .PatternTest(subject, _, _, _) -> return sema_taint_tags_of(&state, subject)
        .If(_, _, then_value, _, else_value, _, _) -> {
            tags := sema_taint_tags_of(&state, then_value)
            sema_taint_union(&tags, sema_taint_tags_of(&state, else_value))
            return tags
        }
        .PtrFromAddr(_, _, _, addr, _, _) -> return sema_taint_tags_of(&state, addr)
        .Lambda(_, _) -> return [String]{}
        else -> return [String]{}
    }
}

fn sema_taint_denied_tag(graph: SemaRegistrationGraph, state: SemaTaintFlowState, tags: [String], destinations: [String]) -> String? {
    loop tag_value in tags {
        fact :: sema_taint_find_tag(state.catalog, graph, state.module_identity, tag_value) ?? next
        loop deny in fact.deny {
            loop destination in destinations {
                if sema_effect_covers(deny, destination) -> return Val(tag_value)
            }
        }
    }
    None
}

fn sema_taint_e0722(api: String, span: Span) -> Diagnostic {
    sema_error("E0722", span, "a `Credential` value is denied at `{api}`", "`{api}` writes to a log, terminal, or serialized output, where a credential would leak", "log a non-secret field, or pass the value through a matching `#Scrub(Credential)` function")
}

fn sema_taint_e0721(tag_value: String, api: String, destinations: [String], span: Span) -> Diagnostic {
    destination := if destinations.len() == 0 -> "sink" else -> destinations[destinations.len() - 1]
    fix := if sema_taint_is_origin(tag_value) -> "remove the destination use, decode the value into a declared type, or pass it through an audited #Scrub function" else -> "remove the destination use, or pass the value through a matching `#Scrub({tag_value})` function"
    sema_error("E0721", span, "a `{tag_value}` value is denied at `{api}`", "the declaration for `{tag_value}` denies `{destination}`, which covers this destination", fix)
}

fn sema_taint_check_expr(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, expression: Expr) {
    if expression == {
        .MethodCall(receiver, method, method_span, _, _, args, _) -> {
            destinations := sema_taint_method_destinations(state, receiver, method)
            loop argument in args {
                tags := sema_taint_tags_of(&state, argument.expr)
                denied := sema_taint_denied_tag(graph, state, tags, destinations)
                if denied != None {
                    tag_value :: denied ?? "Input"
                    api := if receiver == {.Ident(alias, _, _) -> "{alias}.{method}" else -> method}
                    if {
                        tag_value == "Credential" && sema_taint_has(destinations, "Log") -> {
                            &state.diagnostics.push(sema_taint_e0722(api, method_span))
                        }
                        else -> {
                            &state.diagnostics.push(sema_taint_e0721(tag_value, api, destinations, method_span))
                        }
                    }
                    break
                }
            }
            sema_taint_check_expr(graph, &state, receiver)
            loop argument in args -> sema_taint_check_expr(graph, &state, argument.expr)
        }
        .Call(call, _) -> {
            credential_sink := call.name == "print" || call.name == "eprint"
            destinations := if credential_sink -> [String]{"Log"} else -> [String]{call.name}
            loop argument in call.args {
                tags := sema_taint_tags_of(&state, argument.expr)
                denied := sema_taint_denied_tag(graph, state, tags, destinations)
                if denied != None {
                    tag_value :: denied ?? "Input"
                    if {
                        tag_value == "Credential" && credential_sink -> {
                            &state.diagnostics.push(sema_taint_e0722(call.name, call.name_span))
                        }
                        else -> {
                            &state.diagnostics.push(sema_taint_e0721(tag_value, call.name, destinations, call.name_span))
                        }
                    }
                    break
                }
            }
            loop argument in call.args -> sema_taint_check_expr(graph, &state, argument.expr)
        }
        .CallValue(callee, args, _, _) -> {
            sema_taint_check_expr(graph, &state, callee)
            loop argument in args -> sema_taint_check_expr(graph, &state, argument.expr)
        }
        .Tainted(inner, _, _, _) -> sema_taint_check_expr(graph, &state, inner)
        .Binary(_, left, right, _, _) -> {
            sema_taint_check_expr(graph, &state, left)
            sema_taint_check_expr(graph, &state, right)
        }
        .CompareChain(operands, _, _, _, _) | .ListLit(operands, _, _) -> loop value in operands -> sema_taint_check_expr(graph, &state, value)
        .Unary(_, inner, _, _) | .Deref(inner, _, _) | .RawOf(inner, _, _) | .Copy(inner, _, _) | .Place(inner, _, _, _) | .Field(inner, _, _, _) | .Present(inner, _, _) | .Ok(inner, _, _) | .Err(inner, _, _) | .Paren(inner, _, _) | .Spread(inner, _, _) -> sema_taint_check_expr(graph, &state, inner)
        .Try(inner, _, _, note, _) -> {
            sema_taint_check_expr(graph, &state, inner)
            if note == {
                .Val(value) -> sema_taint_check_expr(graph, &state, value)
                .None -> {}
            }
        }
        .OptField(base, _, _, _, _, _) -> sema_taint_check_expr(graph, &state, base)
        .OptMethodCall(receiver, method, method_span, type_args, args, _, _) -> sema_taint_check_expr(graph, &state, expr_optional_method_call_as_call(receiver, method, method_span, type_args, args))
        .Index(base, index, _, _, _) -> {
            sema_taint_check_expr(graph, &state, base)
            sema_taint_check_expr(graph, &state, index)
        }
        .Slice(base, start, end, range, _, _) -> {
            sema_taint_check_expr(graph, &state, base)
            if range == {
                .Val(value) -> sema_taint_check_expr(graph, &state, value)
                .None -> {
                    sema_taint_check_expr(graph, &state, start)
                    sema_taint_check_expr(graph, &state, end)
                }
            }
        }
        .Range(start, end, _, _, _) -> {
            sema_taint_check_expr(graph, &state, start)
            sema_taint_check_expr(graph, &state, end)
        }
        .MapLit(entries, _, _) -> loop entry in entries {
            sema_taint_check_expr(graph, &state, entry.key)
            sema_taint_check_expr(graph, &state, entry.value)
        }
        .TupleLit(fields, _, _, _) -> loop field in fields -> sema_taint_check_expr(graph, &state, field.value)
        .StructLit(_, _, _, _, fields, _, _, _) -> loop field in fields -> sema_taint_check_expr(graph, &state, field.value)
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> loop field in fields -> sema_taint_check_expr(graph, &state, field.value)
                .Elements(elements) -> loop value in elements -> sema_taint_check_expr(graph, &state, value)
                .Entries(entries) -> loop entry in entries {
                    sema_taint_check_expr(graph, &state, entry.key)
                    sema_taint_check_expr(graph, &state, entry.value)
                }
                .Value(value) -> sema_taint_check_expr(graph, &state, value)
                else -> {}
            }
        }
        .EnumLit(_, _, _, args, _, _, _) -> loop argument in args {
            if argument == {
                .Positional(value) -> sema_taint_check_expr(graph, &state, value)
                .Named(_, value) -> sema_taint_check_expr(graph, &state, value)
            }
        }
        .Str(parts, _, _) -> loop part in parts {
            if part == .Interp(value, _) -> sema_taint_check_expr(graph, &state, value)
        }
        .OrFallback(value, fallback, _, _, _) -> {
            sema_taint_check_expr(graph, &state, value)
            if fallback == {
                .Value(other) -> sema_taint_check_expr(graph, &state, other)
                .Block(body, tail, _) -> {
                    sema_taint_check_block(graph, &state, body)
                    if tail == {
                        .Val(item) -> sema_taint_check_expr(graph, &state, item)
                        .None -> {}
                    }
                }
                .Return(other, _) -> {
                    if other == {
                        .Val(item) -> sema_taint_check_expr(graph, &state, item)
                        .None -> {}
                    }
                }
                else -> {}
            }
        }
        .PatternTest(subject, _, _, _) -> sema_taint_check_expr(graph, &state, subject)
        .If(cond, then_body, then_value, else_body, else_value, _, _) -> {
            sema_taint_check_expr(graph, &state, cond)
            before := sema_taint_snapshot(state)
            sema_taint_check_block(graph, &state, then_body)
            sema_taint_check_expr(graph, &state, then_value)
            then_path := sema_taint_snapshot(state)
            state.bindings = sema_taint_copy_bindings(before.bindings)
            sema_taint_check_block(graph, &state, else_body)
            sema_taint_check_expr(graph, &state, else_value)
            else_path := sema_taint_snapshot(state)
            sema_taint_merge_paths(&state, before, [SemaTaintSnapshot]{then_path, else_path})
        }
        .PtrFromAddr(_, _, _, addr, _, _) -> sema_taint_check_expr(graph, &state, addr)
        .Lambda(lambda, _) -> {
            if lambda.body == {
                .Expr(value) -> sema_taint_check_expr(graph, &state, value)
                .Block(body) -> sema_taint_check_block(graph, &state, body)
            }
        }
        else -> {}
    }
}

fn sema_taint_pattern_names(pattern: BindPattern) -> [String] Never! {
    names := [String]{}
    if pattern == {
        .Struct(_, _, fields, _, _) -> loop field in fields -> &names.push(field.name)
        .List(fields, _) -> loop field in fields -> &names.push(field.name)
        .Tuple(fields, _) -> loop field in fields -> &names.push(field.name)
        .Refutable(_, _, fields, _) -> loop field in fields -> &names.push(field.name)
    }
    names
}

fn sema_taint_check_stmt(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, statement: Stmt) {
    if statement == {
        .Expr(expression) | .Yield(expression, _) | .DeferClose(expression, _) -> sema_taint_check_expr(graph, &state, expression)
        .BreakValue(expression, _) | .BreakLabelValue(_, _, expression, _) -> sema_taint_check_expr(graph, &state, expression)
        .Val(binding) -> {
            sema_taint_check_expr(graph, &state, binding.init)
            tags := sema_taint_tags_of(&state, binding.init)
            type_name := String?{None}
            if binding.ty == {
                .Val(ty) -> {
                    sema_taint_union(&tags, sema_taint_type_tags(ty))
                    module_identity := state.module_identity
                    sema_taint_validate_type_tags(graph, ty, module_identity, &state, binding.ty_span ?? expr_span(binding.init))
                    type_name = sema_taint_type_name(ty)
                }
                .None -> type_name = sema_taint_type_of_expr(state, binding.init)
            }
            if binding.pattern == {
                .Val(pattern) -> loop name in sema_taint_pattern_names(pattern) -> sema_taint_set_binding(&state.bindings, name, tags, None)
                .None -> if binding.name != "" -> sema_taint_set_binding(&state.bindings, binding.name, tags, type_name)
            }
        }
        .Assign(target, op, _, value) -> {
            sema_taint_check_expr(graph, &state, value)
            if target == {
                .Local(name, _) -> {
                    tags := sema_taint_tags_of(&state, value)
                    if op != None -> sema_taint_union(&tags, sema_taint_get_binding(state, name).tags)
                    old := sema_taint_get_binding(state, name)
                    sema_taint_set_binding(&state.bindings, name, tags, old.type_name)
                }
                .Index(base, index, _, _) -> {
                    sema_taint_check_expr(graph, &state, base)
                    sema_taint_check_expr(graph, &state, index)
                }
                .Field(base, _, _) -> sema_taint_check_expr(graph, &state, base)
            }
        }
        .Return(value, _) -> {
            if value == {
                .Val(expression) -> sema_taint_check_expr(graph, &state, expression)
                .None -> {}
            }
        }
        .While(cond, body, _, _, _) -> {
            sema_taint_check_expr(graph, &state, cond)
            sema_taint_check_loop_body(graph, &state, body)
        }
        .For(var, _, var2, kind, body, _, _, _, _) -> {
            collection_tags := [String]{}
            if kind == {
                .Range(start, end, step, _) -> {
                    sema_taint_check_expr(graph, &state, start)
                    sema_taint_check_expr(graph, &state, end)
                    if step == {
                        .Val(value) -> sema_taint_check_expr(graph, &state, value)
                        .None -> {}
                    }
                }
                .In(collection, step) -> {
                    sema_taint_check_expr(graph, &state, collection)
                    collection_tags = sema_taint_tags_of(&state, collection)
                    if step == {
                        .Val(value) -> sema_taint_check_expr(graph, &state, value)
                        .None -> {}
                    }
                }
            }
            sema_taint_set_binding(&state.bindings, var, collection_tags, None)
            if var2 == {
                .Val(second) -> sema_taint_set_binding(&state.bindings, second.name, collection_tags, None)
                .None -> {}
            }
            sema_taint_check_loop_body(graph, &state, body)
        }
        .Switch(subject, arms, else_body, span) | .ComptimeSwitch(subject, arms, else_body, span) -> {
            sema_taint_check_expr(graph, &state, subject)
            before := sema_taint_snapshot(state)
            paths := [SemaTaintSnapshot]{}
            loop arm in arms {
                state.bindings = sema_taint_copy_bindings(before.bindings)
                sema_taint_check_expr(graph, &state, arm.cond)
                sema_taint_check_block(graph, &state, arm.body)
                &paths.push(sema_taint_snapshot(state))
            }
            if else_body == {
                .Val(body) -> &paths.push(sema_taint_walk_path(graph, &state, before, body))
                .None -> if !sema_taint_switch_exhaustive(arms, state.existing_diagnostics, span) -> &paths.push(before)
            }
            sema_taint_merge_paths(&state, before, paths)
        }
        .CountedLoop(init, cond, step, body, _, _, _) -> {
            sema_taint_check_expr(graph, &state, init.init)
            sema_taint_check_expr(graph, &state, cond)
            before := sema_taint_snapshot(state)
            sema_taint_check_block(graph, &state, body)
            if step == {
                .Val(item) -> sema_taint_check_stmt(graph, &state, item)
                .None -> {}
            }
            after_body := sema_taint_snapshot(state)
            sema_taint_merge_paths(&state, before, [SemaTaintSnapshot]{before, after_body})
        }
        .Loop(body, _, _, _) -> sema_taint_check_loop_body(graph, &state, body)
        .Unsafe(_, audit_expr, body, _) -> {
            if audit_expr == {
                .Val(value) -> sema_taint_check_expr(graph, &state, value)
                .None -> {}
            }
            sema_taint_check_block(graph, &state, body)
        }
        .Impure(_, reason_expr, body, _) -> {
            if reason_expr == {
                .Val(value) -> sema_taint_check_expr(graph, &state, value)
                .None -> {}
            }
            sema_taint_check_block(graph, &state, body)
        }
        .TaskGroup(_, _, limit, body, _) -> {
            if limit == {
                .Val(value) -> sema_taint_check_expr(graph, &state, value)
                .None -> {}
            }
            sema_taint_check_block(graph, &state, body)
        }
        .AssumeDet(_, reason_expr, body, _) -> {
            sema_taint_check_expr(graph, &state, reason_expr)
            sema_taint_check_block(graph, &state, body)
        }
        .ScopeMember(_, _, args, _, body, _, _, _) -> {
            loop argument in args -> sema_taint_check_expr(graph, &state, argument)
            sema_taint_check_block(graph, &state, body)
        }
        .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .Transact(_, _, body, _, _) | .Live(body, _) -> sema_taint_check_block(graph, &state, body)
        .ComptimeIf(cond, _, then_body, else_body, _, _) -> {
            sema_taint_check_expr(graph, &state, cond)
            before := sema_taint_snapshot(state)
            then_path := sema_taint_walk_path(graph, &state, before, then_body)
            other_path := if else_body == {
                .Val(body) -> sema_taint_walk_path(graph, &state, before, body)
                .None -> before
            }
            sema_taint_merge_paths(&state, before, [SemaTaintSnapshot]{then_path, other_path})
        }
        .ComptimeBlock(body, _, _) -> sema_taint_check_block(graph, &state, body)
        .ContextBlock(fields, body, _) -> {
            loop field in fields -> sema_taint_check_expr(graph, &state, field.value)
            sema_taint_check_block(graph, &state, body)
        }
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
    }
}

fn sema_taint_check_block(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, body: [Stmt]) {
    loop statement in body -> sema_taint_check_stmt(graph, &state, statement)
}

fn sema_taint_snapshot(state: SemaTaintFlowState) -> SemaTaintSnapshot Never! {
    SemaTaintSnapshot{bindings: sema_taint_copy_bindings(state.bindings)}
}

fn sema_taint_walk_path(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, before: SemaTaintSnapshot, body: [Stmt]) -> SemaTaintSnapshot {
    state.bindings = sema_taint_copy_bindings(before.bindings)
    sema_taint_check_block(graph, &state, body)
    sema_taint_snapshot(state)
}

fn sema_taint_join_bindings(left: [SemaTaintBindingFact], right: [SemaTaintBindingFact]) -> [SemaTaintBindingFact] Never! {
    result := sema_taint_copy_bindings(left)
    loop binding in right {
        index := sema_taint_binding_index(result, binding.name)
        if index == None -> &result.push(SemaTaintBindingFact{name: binding.name, tags: binding.tags.copy(), type_name: binding.type_name}) else {
            current := result[index ?? 0]
            tags := current.tags.copy()
            sema_taint_union(&tags, binding.tags)
            type_name := current.type_name
            if type_name == None -> type_name = binding.type_name
            if type_name != None && binding.type_name != None && type_name != binding.type_name -> type_name = None
            result[index ?? 0] = SemaTaintBindingFact{name: binding.name, tags: tags, type_name: type_name}
        }
    }
    result
}

fn sema_taint_merge_paths(state: &SemaTaintFlowState, before: SemaTaintSnapshot, paths: [SemaTaintSnapshot]) Never! {
    if paths.len() == 0 {
        state.bindings = sema_taint_copy_bindings(before.bindings)
        return
    }
    merged := sema_taint_copy_bindings(paths[0].bindings)
    index := 1
    loop index < paths.len() {
        merged = sema_taint_join_bindings(merged, paths[index].bindings)
        index += 1
    }
    state.bindings = merged
}

fn sema_taint_check_loop_body(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, body: [Stmt]) {
    before := sema_taint_snapshot(state)
    sema_taint_check_block(graph, &state, body)
    after_body := sema_taint_snapshot(state)
    sema_taint_merge_paths(&state, before, [SemaTaintSnapshot]{before, after_body})
}

fn sema_taint_same_span(left: Span?, right: Span?) -> Bool Never! {
    if left == {
        .Val(a) -> {
            if right == {
                .Val(b) -> return a.start == b.start && a.end == b.end
                .None -> return false
            }
        }
        .None -> {
            if right == {
                .None -> return true
                .Val(_) -> return false
            }
        }
    }
}

fn sema_taint_switch_exhaustive(arms: [SwitchArm], diagnostics: [Diagnostic], span: Span) -> Bool Never! {
    if arms.len() == 0 -> return false
    loop arm in arms {
        if arm.cond == {
            .PatternTest(_, _, _, _) -> {}
            else -> return false
        }
    }
    loop diagnostic in diagnostics {
        if diagnostic.code == "E0307" && sema_taint_same_span(diagnostic.span, Val(span)) -> return false
    }
    true
}

fn sema_taint_module_name(graph: SemaRegistrationGraph, module_identity: String) -> String Never! {
    module_index :: sema_registration_module_index(graph, module_identity) ?? return ""
    graph.modules[module_index].module_name
}

fn sema_taint_import_module_name(graph: SemaRegistrationGraph, import: SemaRegistrationImport) -> String Never! {
    if import.declaration.kind == {
        .Module(name, _) -> return name
        .Unqualified(module_name, _, _, _, _) -> return module_name
        else -> {}
    }
    sema_taint_module_name(graph, import.target_module_identity)
}

fn sema_taint_collect_imports(graph: SemaRegistrationGraph, module_identity: String) -> [SemaTaintImportAlias] Never! {
    imports := [SemaTaintImportAlias]{}
    module_index :: sema_registration_module_index(graph, module_identity) ?? return imports
    module_row :: graph.modules[module_index]
    loop import in module_row.imports {
        target_name := sema_taint_import_module_name(graph, import)
        &imports.push(SemaTaintImportAlias{alias: import.declaration.alias, module_name: target_name})
        loop binding in import.bindings -> &imports.push(SemaTaintImportAlias{alias: binding.local, module_name: target_name})
    }
    imports
}

// Every `#Scrub(Tag)` function's tag and signature, in catalog order, each
// report placed in its declaring module.
fn sema_taint_register_scrubbers(catalog: SemaTaintCatalog, graph: SemaRegistrationGraph, diagnostics: &[Diagnostic]) {
    index := 0
    loop index < catalog.callables.len() {
        fact := catalog.callables[index]
        index += 1
        tag_value :: fact.scrub_tag ?? next
        found := [Diagnostic]{}
        declared := sema_taint_find_tag(catalog, graph, fact.module_identity, tag_value) != None
        if {
            !declared -> {
                &found.push(sema_error("E0733", fact.span, "there's no tag called `{tag_value}`", "a value tag must name a declared `tag`", "declare it first with `tag {tag_value} {{ deny: [Effect] }}`, or check the spelling"))
            }
            else -> {
                consumes := false
                loop parameter in fact.parameter_tags {
                    if sema_taint_has(parameter.tags, tag_value) -> consumes = true
                }
                returns := sema_taint_has(fact.return_tags, tag_value)
                if !consumes || returns -> &found.push(sema_error("E0736", fact.span, "`#Scrub({tag_value})` does not match this function signature", "a scrubber consumes a value carrying that tag and returns a value without it", "accept a `#{tag_value} T` parameter and return the untagged result"))
            }
        }
        if found.len() == 0 -> next
        if sema_registration_module_index(graph, fact.module_identity) == .Val(module_index) -> sema_attach_diagnostic_source_locations(&found, 0, graph.modules[module_index].source_segments)
        loop diagnostic in found -> &diagnostics.push(diagnostic)
    }
}

fn sema_taint_initial_parameter_bindings(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, function: Func, owner: String) {
    loop parameter_index in 0..<function.params.len() {
        tags := sema_taint_type_tags(function.params[parameter_index].ty)
        module_identity := state.module_identity
        sema_taint_validate_type_tags(graph, function.params[parameter_index].ty, module_identity, &state, function.params[parameter_index].ty_span)
        type_name := sema_taint_type_name(function.params[parameter_index].ty)
        if function.params[parameter_index].name == "self" {
            if function.params[parameter_index].ty == {
                .Named(name) -> {
                    if name == "Self" -> type_name = Val(owner)
                }
                else -> {}
            }
        }
        sema_taint_set_binding(&state.bindings, function.params[parameter_index].name, tags, type_name)
    }
}

// One body's flow from its parameters' tags; its reports, placed in the
// body's module, join `found` (sema_taint_join_reports settles repeats).
fn sema_taint_check_function(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, module_index: Int, function: Func, owner: String, found: &[Diagnostic]) {
    state.bindings = [SemaTaintBindingFact]{}
    state.diagnostics = [Diagnostic]{}
    sema_taint_initial_parameter_bindings(graph, &state, function, owner)
    sema_taint_check_block(graph, &state, function.body)
    sema_taint_finish_body(graph, &state, module_index, &found)
}

fn sema_taint_check_body(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, module_index: Int, body: [Stmt], found: &[Diagnostic]) {
    state.bindings = [SemaTaintBindingFact]{}
    state.diagnostics = [Diagnostic]{}
    sema_taint_check_block(graph, &state, body)
    sema_taint_finish_body(graph, &state, module_index, &found)
}

fn sema_taint_finish_body(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, module_index: Int, found: &[Diagnostic]) {
    if state.diagnostics.len() == 0 -> return
    sema_attach_diagnostic_source_locations(&state.diagnostics, 0, graph.modules[module_index].source_segments)
    loop diagnostic in state.diagnostics -> &found.push(diagnostic)
}

// The bodies of module `module_index`, walked in item order; their reports
// join `found` in that order.
fn sema_taint_check_module(graph: SemaRegistrationGraph, state: &SemaTaintFlowState, module_index: Int, found: &[Diagnostic]) {
    state.module_identity = graph.modules[module_index].module_identity
    state.imports = sema_taint_collect_imports(graph, state.module_identity)
    loop item in graph.modules[module_index].program.items {
        if item == {
            .Func(function) -> sema_taint_check_function(graph, &state, module_index, function, "", &found)
            .Struct(definition) -> {
                loop method in definition.methods -> sema_taint_check_function(graph, &state, module_index, method, definition.name, &found)
                loop trait_impl in definition.trait_impls {
                    loop method in trait_impl.methods -> sema_taint_check_function(graph, &state, module_index, method, definition.name, &found)
                }
            }
            .Enum(definition) -> loop method in definition.methods -> sema_taint_check_function(graph, &state, module_index, method, definition.name, &found)
            .Impl(definition) -> loop method in definition.methods -> sema_taint_check_function(graph, &state, module_index, method, definition.type_name, &found)
            .Test(test) -> sema_taint_check_body(graph, &state, module_index, test.body, &found)
            .ErrorConv(definition) -> sema_taint_check_body(graph, &state, module_index, definition.body, &found)
            else -> {}
        }
    }
}

// A module's reports join `reports` in order, each unless `reports` or
// `existing_diagnostics` already holds it.
fn sema_taint_join_reports(reports: &[Diagnostic], existing_diagnostics: [Diagnostic], found: [Diagnostic]) {
    loop diagnostic in found {
        if !sema_taint_has_diagnostic(reports, diagnostic) && !sema_taint_has_diagnostic(existing_diagnostics, diagnostic) -> &reports.push(diagnostic)
    }
}

// A compiler thread is admitted for at least this many bytes of module
// source to walk.
SEMA_TAINT_MIN_BYTES_PER_THREAD :: 65536

// The bundle's tag dataflow (the Rust reference's `check_fact_tags_and_states`
// taint walk): one indexed catalog of tags, callables and fields, then every
// function, method, test and conversion body walked once. Appends the new
// reports to `reports`; `existing_diagnostics` (the bundle's reports so far)
// settles switch coverage and is never repeated. A module's walk reads only
// the graph, the catalog and `existing_diagnostics`, so the modules are
// walked on up to `threads` compiler threads, claimed heaviest source first,
// each module's reports kept apart and joined in module order: the reports
// read exactly as one thread's walk of every module in order. The graph
// moves into the threads' shared state and back; it is returned.
fn sema_taint_check_graph(graph: ^SemaRegistrationGraph, existing_diagnostics: [Diagnostic], threads: CompilerThreads, reports: &[Diagnostic]) -> SemaRegistrationGraph {
    owned := ^graph
    catalog := sema_taint_catalog_init()
    sema_taint_collect_items(&catalog, owned)
    sema_taint_collect_tag_declarations(&catalog, owned, &reports)
    sema_taint_register_scrubbers(catalog, owned, &reports)
    weights := [Int]{}
    work := 0
    loop module_index in 0..<owned.modules.len() {
        weight := 0
        loop item in owned.modules[module_index].program.items {
            span :: sema_compiler_index_item_span(item)
            weight += span.end - span.start
        }
        &weights.push(weight)
        work += weight
    }
    workers :: compiler_threads_admit(threads, weights.len(), work, SEMA_TAINT_MIN_BYTES_PER_THREAD, 0, 0)
    if workers <= 1 {
        state := SemaTaintFlowState{catalog: ^catalog, module_identity: "", bindings: [SemaTaintBindingFact]{}, imports: [SemaTaintImportAlias]{}, diagnostics: [Diagnostic]{}, existing_diagnostics: existing_diagnostics}
        loop module_index in 0..<owned.modules.len() {
            found := [Diagnostic]{}
            sema_taint_check_module(owned, &state, module_index, &found)
            sema_taint_join_reports(&reports, existing_diagnostics, found)
        }
        return owned
    }
    walked := [[Diagnostic]]{}
    loop _ in 0..<owned.modules.len() -> &walked.push([Diagnostic]{})
    shared_state :: shared SemaTaintShared{graphs: [SemaRegistrationGraph]{}, catalogs: [SemaTaintCatalog]{}, existing: [[Diagnostic]]{}, order: compiler_threads_heaviest_first(weights)}
    sema_taint_shared_fill(shared_state, ^owned, ^catalog, existing_diagnostics)
    queue :: shared SemaTaintQueue{next: 0}
    sema_taint_walkers(shared_state, queue, 0, workers, &walked)
    returned := sema_taint_shared_take_graph(shared_state)
    loop found in walked -> sema_taint_join_reports(&reports, existing_diagnostics, found)
    returned
}

// What every walking thread reads: the graph, the catalog and the bundle's
// reports so far (each the one row of its list, moved in, and the graph
// moved back out), and the modules in claim order.
struct SemaTaintShared {
    graphs: [SemaRegistrationGraph]
    catalogs: [SemaTaintCatalog]
    existing: [[Diagnostic]]
    order: [Int]
}

// The next unclaimed rank of the walk.
struct SemaTaintQueue {
    next: Int
}

// One walked module's reports.
struct SemaTaintWalked {
    module_index: Int
    found: [Diagnostic]
}

fn sema_taint_shared_fill(shared_state: Shared<SemaTaintShared>, graph: ^SemaRegistrationGraph, catalog: ^SemaTaintCatalog, existing_diagnostics: [Diagnostic]) {
    permit :: shared_state.guard_edit()
    &permit.value.graphs.push(^graph)
    &permit.value.catalogs.push(^catalog)
    &permit.value.existing.push(existing_diagnostics)
}

fn sema_taint_shared_take_graph(shared_state: Shared<SemaTaintShared>) -> SemaRegistrationGraph {
    permit :: shared_state.guard_edit()
    &permit.value.graphs.pop() ?? panic("the taint walk lost its registration graph")
}

// Runs threads `from..<workers`, each walking the modules it claims, and
// places each walked module's reports at its module in `walked`.
fn sema_taint_walkers(shared_state: Shared<SemaTaintShared>, queue: Shared<SemaTaintQueue>, from: Int, workers: Int, walked: &[[Diagnostic]]) {
    if from >= workers -> return
    task.group sema_taint_threads {
        head :: task sema_taint_walk_claimed(shared_state, queue)
        sema_taint_walkers(shared_state, queue, from + 1, workers, &walked)
        claimed := head.join() ?? panic(compiler_threads_failure_text(err))
        loop claimed.len() > 0 {
            done := &claimed.pop() ?? break
            walked[done.module_index] = ^done.found
        }
    }
}

// One thread: its own flow state over a copy of the catalog, walking the
// modules it claims until none is left.
fn sema_taint_walk_claimed(shared_state: Shared<SemaTaintShared>, queue: Shared<SemaTaintQueue>) -> [SemaTaintWalked] {
    inputs :: shared_state.guard_read()
    state := SemaTaintFlowState{catalog: inputs.value.catalogs[0].copy(), module_identity: "", bindings: [SemaTaintBindingFact]{}, imports: [SemaTaintImportAlias]{}, diagnostics: [Diagnostic]{}, existing_diagnostics: inputs.value.existing[0].copy()}
    claimed := [SemaTaintWalked]{}
    loop {
        rank :: sema_taint_claim_rank(queue)
        if rank >= inputs.value.order.len() -> break
        module_index :: inputs.value.order[rank]
        found := [Diagnostic]{}
        // Passed straight through: a local binding of a guarded row would copy it.
        sema_taint_check_module(inputs.value.graphs[0], &state, module_index, &found)
        &claimed.push(SemaTaintWalked{module_index: module_index, found: ^found})
    }
    claimed
}

fn sema_taint_claim_rank(queue: Shared<SemaTaintQueue>) -> Int {
    permit :: queue.guard_edit()
    rank :: permit.value.next
    permit.value.next = rank + 1
    rank
}

fn sema_taint_has_diagnostic(diagnostics: [Diagnostic], candidate: Diagnostic) -> Bool Never! {
    loop diagnostic in diagnostics {
        if diagnostic.code == candidate.code && sema_taint_same_span(diagnostic.span, candidate.span) && diagnostic.source_path == candidate.source_path && diagnostic.source_offset == candidate.source_offset && diagnostic.what == candidate.what -> return true
    }
    false
}
