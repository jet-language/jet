// Canonical compute/autodiff facts and the post-effect purity/traceability proof.
// Compute-call effects live in the ordinary effect graph; these facts retain
// the separate proof obligations that graph edges cannot express.
use jet_foundation.[
    CoreCallRecord,
    Diagnostic,
    Span,
]

SemaComputeCallFact: struct {
    method: String
    span: Span
}

SemaAutodiffObligation: struct {
    method: String
    target: String
    span: Span
}

// One checked function's proof obligations that only the whole program can
// discharge: its compute/autodiff facts, and the task crossings its type
// parameters reach with the generic calls that decide them
// (Ownership/GenericCrossings.jet).
SemaComputeFunctionFacts: struct {
    function_key: String
    compute_calls: [SemaComputeCallFact]
    autodiff_obligations: [SemaAutodiffObligation]
    autodiff_safe_panic: Bool
    autodiff_unsafe_panic: Bool
    generic_crossings: [SemaGenericCrossing]{[SemaGenericCrossing]{}}
    generic_calls: [SemaGenericCall]{[SemaGenericCall]{}}
}

// Positions loan the already solved module products; no function body or
// compute-fact payload is materialized for this global validation.
SemaComputePosition: struct {
    module_index: Int
    row_index: Int
}

SemaComputeIndex: struct {
    functions: [String:SemaComputePosition]
    facts: [String:SemaComputePosition]
}

SemaComputeValidationWork: struct {
    counting: Bool{false}
    indexed_functions: Int{0}
    indexed_facts: Int{0}
    function_queries: Int{0}
    fact_queries: Int{0}
}

sema_compute_index: fn(modules: [SemaGraphModuleResult], work: &SemaComputeValidationWork) -> SemaComputeIndex {
    index := SemaComputeIndex{functions: [String:SemaComputePosition]{}, facts: [String:SemaComputePosition]{}}
    loop (module_position, module_row) in modules {
        loop (row, function) in module_row.functions {
            if work.counting -> work.indexed_functions += 1
            if index.functions.get(function.key) == .Val(_) {} else {
                index.functions[function.key.copy()] = SemaComputePosition{module_index: module_position, row_index: row}
            }
        }
        loop (row, fact) in module_row.compute_facts {
            if work.counting -> work.indexed_facts += 1
            if index.facts.get(fact.function_key) == .Val(_) {} else {
                index.facts[fact.function_key.copy()] = SemaComputePosition{module_index: module_position, row_index: row}
            }
        }
    }
    index.move()
}

SemaComputePanicMemo: struct {
    function_key: String
    safe: Bool
}

sema_compute_record_core_call: fn(record: CoreCallRecord, span: Span, context: &SemaCheckContext) -> Bool Never! {
    if record.module_name != "core.compute" -> return false
    context.compute_calls.push(SemaComputeCallFact{method: record.member, span: span})
    true
}

sema_compute_record_autodiff_obligation: fn(method: String, target: String, span: Span, context: &SemaCheckContext) Never! {
    context.autodiff_obligations.push(SemaAutodiffObligation{method: method, target: target, span: span})
}

// A panic is admissible under autodiff only when every reachable Panic edge is
// the explicit fallback of a checked Tensor-returning Core compute operation.
sema_compute_note_panic: fn(context: &SemaCheckContext, safe_compute_fallback: Bool) Never! {
    if safe_compute_fallback -> context.autodiff_safe_panic = true else -> context.autodiff_unsafe_panic = true
}

sema_compute_has_panic_edge: fn(edges: [String]) -> Bool Never! {
    loop edge in edges {
        if edge == "__jet_panic__" -> return true
    }
    false
}

sema_compute_effects_have_root: fn(effects: [String], root: String) -> Bool Never! {
    loop effect_name in effects {
        if sema_effect_root(effect_name) == root -> return true
    }
    false
}

sema_compute_function_position: fn(index: SemaComputeIndex, function_key: String, work: &SemaComputeValidationWork) -> SemaComputePosition? {
    if work.counting -> work.function_queries += 1
    index.functions.get(function_key)
}

sema_compute_function_facts_position: fn(index: SemaComputeIndex, function_key: String, work: &SemaComputeValidationWork) -> SemaComputePosition? {
    if work.counting -> work.fact_queries += 1
    index.facts.get(function_key)
}

sema_compute_panic_memo: fn(memo: [SemaComputePanicMemo], function_key: String) -> Bool? {
    loop value in memo {
        if value.function_key == function_key -> return Val(value.safe)
    }
    None
}

sema_compute_panic_sites_are_compute_failures: fn(function_key: String, modules: [SemaGraphModuleResult], index: SemaComputeIndex, visiting: &[String], memo: &[SemaComputePanicMemo], work: &SemaComputeValidationWork) -> Bool Never! {
    if function_key == "__jet_panic__" -> return false
    if sema_compute_panic_memo(memo, function_key) == .Val(value) -> return value
    loop active in visiting {
        if active == function_key -> return false
    }
    position: sema_compute_function_position(index, function_key, work) ?? {
        memo.push(SemaComputePanicMemo{function_key: function_key, safe: false})
        return false
    }
    function: modules[position.module_index].functions[position.row_index]
    body_facts := sema_compute_function_facts_position(index, function_key, work)
    local_safe_panic := if body_facts == .Val(row) -> modules[row.module_index].compute_facts[row.row_index].autodiff_safe_panic else -> false
    local_unsafe_panic := if body_facts == .Val(row) -> modules[row.module_index].compute_facts[row.row_index].autodiff_unsafe_panic else -> false
    local_panic := local_safe_panic || local_unsafe_panic
    safe := !local_panic || (local_safe_panic && !local_unsafe_panic)
    if sema_compute_has_panic_edge(function.effects.call_edges) && !local_panic -> safe = false
    visiting.push(function_key.copy())
    if safe {
        loop edge in modules[position.module_index].functions[position.row_index].effects.call_edges {
            if edge == "__jet_panic__" -> next
            target_position: sema_compute_function_position(index, edge, work) ?? next
            // A core.compute operation is the compute capability itself (see
            // sema_compute_autodiff_reach): its own index and invariant stops
            // are not the differentiated function's panic sites.
            if modules[target_position.module_index].functions[target_position.row_index].module_name == "core.compute" -> next
            if !sema_compute_effects_have_root(modules[target_position.module_index].functions[target_position.row_index].effects.solved, "Panic") -> next
            if !sema_compute_panic_sites_are_compute_failures(edge, modules, index, visiting, memo, work) {
                safe = false
                break
            }
        }
    }
    _ := visiting.pop()
    memo.push(SemaComputePanicMemo{function_key: function_key, safe: safe})
    safe
}

// GPU is the pure compute capability; memory and Unsafe are deny-only
// so allocating a result Tensor never breaks the pure Tensor contract.
sema_compute_forbidden_effects: fn(effects: [String]) -> [String] Never! {
    result := [String]{}
    loop effect_name in effects {
        root: sema_effect_root(effect_name)
        if root != "GPU" && root != "Mem" && root != "Unsafe" -> result.push(effect_name.copy())
    }
    result
}

// The effects of `solved` (the target's row, in its order) that the target
// reaches outside core.compute. A core.compute operation is the compute
// capability itself: its CPU oracle and the autodiff tape it records on
// (the tape's lock and invariant stops) add no effect to the function it
// differentiates.
sema_compute_autodiff_reach: fn(index: SemaComputeIndex, modules: [SemaGraphModuleResult], function_key: String, solved: [String], work: &SemaComputeValidationWork) -> [String] Never! {
    reached := [String]{}
    panics := false
    visited := [String]{}
    pending := [String]{function_key.copy()}
    loop pending.len() > 0 {
        key: pending.pop() ?? break
        if visited.contains(key) -> next
        visited.push(key.copy())
        position: sema_compute_function_position(index, key, work) ?? {
            if key == "__jet_panic__" -> panics = true
            next
        }
        function: modules[position.module_index].functions[position.row_index]
        if function.module_name == "core.compute" -> next
        effects: if function.effects.maximal -> function.effects.solved else -> function.effects.direct
        loop effect_name in effects {
            if !reached.contains(effect_name) -> reached.push(effect_name.copy())
        }
        loop edge in function.effects.call_edges -> pending.push(edge.copy())
    }
    result := [String]{}
    loop effect_name in solved {
        if reached.contains(effect_name) || (panics && sema_effect_root(effect_name) == "Panic") -> result.push(effect_name.copy())
    }
    result
}

sema_compute_panic_only: fn(effects: [String]) -> Bool Never! {
    if effects.len() == 0 -> return false
    loop effect_name in effects {
        if sema_effect_root(effect_name) != "Panic" -> return false
    }
    true
}

sema_compute_trace_forbidden: fn(method: String) -> Bool Never! {
    method == "get" || method == "set" || method == "to_list" || method == "det" || method == "inv" || method == "solve" || method == "fft" || method == "serialize" || method == "to_sparse" || method == "sparse_mv"
}

sema_compute_effect_names: fn(effects: [String]) -> String Never! {
    effects.join(", ")
}

// Borrow the globally solved module products. Keys retain the same first match
// as the old flattened lists, and diagnostics retain module/fact/obligation
// order. The loan ends before the finalizer's next module mutation.
sema_compute_validate_autodiff_purity: fn(modules: [SemaGraphModuleResult], work: &SemaComputeValidationWork) -> [Diagnostic] {
    diagnostics := [Diagnostic]{}
    has_obligations := false
    loop module_row in modules {
        loop fact in module_row.compute_facts {
            if fact.autodiff_obligations.len() != 0 {
                has_obligations = true
                break
            }
        }
        if has_obligations -> break
    }
    if !has_obligations -> return diagnostics.move()
    index: sema_compute_index(modules, work)
    panic_memo := [SemaComputePanicMemo]{}
    loop module_row in modules {
        loop function_facts in module_row.compute_facts {
            loop obligation in function_facts.autodiff_obligations {
                target_position: sema_compute_function_position(index, obligation.target, work) ?? next
                target: modules[target_position.module_index].functions[target_position.row_index]
                forbidden := sema_compute_forbidden_effects(sema_compute_autodiff_reach(index, modules, obligation.target, target.effects.solved, work))
                panic_only := sema_compute_panic_only(forbidden)
                if panic_only && sema_compute_panic_sites_are_compute_failures(obligation.target, modules, index, [String]{}, panic_memo, work) {
                    filtered := [String]{}
                    loop effect_name in forbidden {
                        if sema_effect_root(effect_name) != "Panic" -> filtered.push(effect_name)
                    }
                    forbidden = filtered.move()
                }
                if forbidden.len() == 0 {
                    target_facts := sema_compute_function_facts_position(index, obligation.target, work)
                    if target_facts == .Val(row) {
                        loop call in modules[row.module_index].compute_facts[row.row_index].compute_calls {
                            if !sema_compute_trace_forbidden(call.method) -> next
                            diagnostics.push(sema_error(
                                "E0112",
                                call.span,
                                "`compute.{obligation.method}` cannot trace `compute.{call.method}`",
                                "this operation consumes, mutates, serializes, or has no registered Tensor derivative rule",
                                "keep the differentiated function on pure differentiable Tensor operations",
                            ))
                        }
                    }
                    next
                }
                // The effect graph's display spelling (Effects/Checks.jet
                // `display_key`), not the internal symbol key.
                target_name: "{target.module_name}::{target.name}"
                diagnostics.push(sema_error(
                    "E0112",
                    obligation.span,
                    "`compute.{obligation.method}` needs a pure Tensor function",
                    "`{target_name}` reaches {sema_compute_effect_names(forbidden)}; autodiff records only pure Tensor operations",
                    "remove the effectful operation from `{target_name}`, or differentiate a pure Tensor function",
                ))
            }
        }
    }
    diagnostics.move()
}
