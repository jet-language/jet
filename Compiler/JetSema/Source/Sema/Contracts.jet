// Checked function contracts and call-site precondition production.
//
// A declaration's #Post clauses live in one ContractScope around its body.
// #Pre clauses are caller obligations: this file pins each evaluated argument
// once, checks the clauses against those pins, and leaves the callee scope's
// pre list empty so a contract is never evaluated twice.
use jet_foundation.[
    AccessConvention,
    BindPattern,
    Binding,
    CallArg,
    Diagnostic,
    Expr,
    Func,
    Item,
    LValue,
    OrFallback,
    PatSlot,
    Pattern,
    Span,
    Stmt,
    Symbol,
    SymbolID,
    SymbolKind,
    TBinaryOp,
    TContractDisposition,
    TContractKind,
    TContractResult,
    TContractResultMode,
    TIntegerRange,
    TLetTy,
    TLocal,
    Type,
    expr_span,
    symbol_id,
    tir_generated_local,
    tir_symbol_local,
    type_name,
]

struct SemaContractDeclaration {
    complete: Bool
    post: [TContract]
    result: TContractResult
}

struct SemaContractCall {
    bindings: [TStmt]
    contracts: [TContract]
}

fn sema_contract_success_type(return_type: Type?) -> Type Never! {
    return_type ?? Type.Named{name: "Unit"}
}

fn sema_contract_result_mode(carrier: Type, binding: Type) -> TContractResultMode Never! {
    if carrier == binding -> return TContractResultMode.Direct
    if carrier == {
        .Result(_, _) -> TContractResultMode.ResultPayload
        .Option(_) -> TContractResultMode.OptionPayload
        .Tagged(_, inner) -> sema_contract_result_mode(inner, binding)
        else -> TContractResultMode.Direct
    }
}

// The binding local carries the symbol `#Post` reads of `result` resolve to,
// so lowering binds the checked return value under that identity.
fn sema_contract_result_for_function(return_type: Type?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, owner: String) -> TContractResult Never! {
    carrier :: sema_effective_return_type(return_type)
    binding :: sema_contract_success_type(return_type)
    mode :: sema_contract_result_mode(carrier, binding)
    binding_local := tir_generated_local("result", span)
    binding_local.symbol_id = Val(sema_contract_result_binding_symbol(environment, program, owner, binding, span).id)
    carrier_local :: if mode != TContractResultMode.Direct -> tir_generated_local("result_carrier", span) else -> binding_local
    TContractResult{carrier_ty: carrier, binding_ty: binding, carrier_local: carrier_local, binding_local: binding_local, mode: mode}
}

fn sema_contract_file(environment: SemaScopeEnvironment, program: SemaProgramTables, span: Span) -> String Never! {
    sema_source_file_at(environment.source_segments, environment.source_file, environment.source_origin, span)
}

fn sema_contract_line(environment: SemaScopeEnvironment, program: SemaProgramTables, span: Span) -> Int Never! {
    sema_source_line_at(environment.source_segments, span) ?? 0
}

fn sema_contract_call_is_pure(fact: SemaCallSiteFact, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if fact.facts.effect_bound == .Val(row) {
        loop entry in row {
            if entry.name.starts_with("!") -> next
            return false
        }
        return true
    }
    target :: fact.callee ?? return false
    facts :: sema_contract_function_facts(environment, program, target) ?? return false
    facts.is_pure
}

fn sema_contract_purity_diagnostic(kind: String, span: Span) -> Diagnostic {
    sema_error("E0139", span, "a #{kind} condition can't do I/O", "a contract is checked at every call and must be a pure claim about values", "move the effect out; keep only a pure test")
}

fn sema_contract_check_pure_delta(start: Int, context: SemaCheckContext, kind: String, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    loop index in start..<context.call_facts.len() {
        fact :: context.call_facts[index]
        if !sema_contract_call_is_pure(fact, environment, program) {
            &diagnostics.push(sema_contract_purity_diagnostic(kind, fact.span))
            valid = false
        }
    }
    valid
}

fn sema_contract_merge_context_delta(source: SemaCheckContext, call_start: Int, view_start: Int, name_start: Int, comptime_start: Int, copy_start: Int, destination: &SemaCheckContext) Never! {
    loop index in call_start..<source.call_facts.len() -> &destination.call_facts.push(source.call_facts[index])
    loop index in view_start..<source.call_return_views.len() -> &destination.call_return_views.push(source.call_return_views[index])
    loop index in name_start..<source.name_references.len() -> &destination.name_references.push(source.name_references[index])
    loop index in comptime_start..<source.comptime_requests.len() -> &destination.comptime_requests.push(source.comptime_requests[index])
    loop index in copy_start..<source.copy_events.len() -> &destination.copy_events.push(source.copy_events[index])
    // A snapshot starts with no goal rows, so every row it holds is this condition's.
    loop index in 0..<source.typed_goals.len() -> &destination.typed_goals.push(source.typed_goals[index])
    sema_check_context_merge_expr_ids(source, &destination)
    if source.exact_int_reachable -> destination.exact_int_reachable = true
}

fn sema_contract_result_ident_in_call_args(args: [CallArg]) -> Span? {
    loop argument in args {
        found :: sema_contract_result_ident_in_expr(argument.expr)
        if found != None -> return found
    }
    None
}

fn sema_contract_result_ident_in_optional_expr(value: Expr?) -> Span? {
    if value == {
        .Val(expression) -> sema_contract_result_ident_in_expr(expression)
        else -> None
    }
}

fn sema_contract_result_ident_in_lvalue(value: LValue) -> Span? {
    if value == {
        .Index(base, index, _, _) -> {
            found := sema_contract_result_ident_in_expr(base)
            if found != None -> return found
            sema_contract_result_ident_in_expr(index)
        }
        .Field(base, _, _) -> sema_contract_result_ident_in_expr(base)
        else -> None
    }
}

fn sema_contract_result_ident_in_pattern(value: Pattern) -> Span? {
    if value == {
        .Or(alternatives, _) -> {
            loop alternative in alternatives {
                found :: sema_contract_result_ident_in_pattern(alternative)
                if found != None -> return found
            }
            None
        }
        .Struct(fields, _, _, _) -> {
            loop field in fields {
                if field == .Value(_, _, expression) {
                    found :: sema_contract_result_ident_in_expr(expression)
                    if found != None -> return found
                }
                if field == .Nested(_, _, nested) {
                    found :: sema_contract_result_ident_in_pattern(nested)
                    if found != None -> return found
                }
            }
            None
        }
        .Variant(_, slots, _, _) | .List(slots, _, _) -> {
            loop slot in slots {
                found :: sema_contract_result_ident_in_pattern_slot(slot)
                if found != None -> return found
            }
            None
        }
        .Map(entries, _, _) -> {
            loop entry in entries {
                found :: sema_contract_result_ident_in_expr(entry.key)
                if found != None -> return found
                slot_found :: sema_contract_result_ident_in_pattern_slot(entry.slot)
                if slot_found != None -> return slot_found
            }
            None
        }
        .Present(_, _, inner, _) | .Ok(_, _, inner, _) | .Err(_, _, inner, _) -> {
            if inner == .Val(nested) -> sema_contract_result_ident_in_pattern(nested) else -> None
        }
        else -> None
    }
}

fn sema_contract_result_ident_in_pattern_slot(slot: PatSlot) -> Span? {
    if slot == {
        .Value(value) -> sema_contract_result_ident_in_expr(value)
        .Nested(inner) -> sema_contract_result_ident_in_pattern(inner)
        .Named(_, _, inner) -> sema_contract_result_ident_in_pattern_slot(inner)
        else -> None
    }
}

fn sema_contract_result_ident_in_bind_pattern(value: BindPattern?) -> Span? {
    pattern :: value ?? return None
    if pattern == {
        .Refutable(inner, fallback, _, _) -> {
            found := sema_contract_result_ident_in_pattern(inner)
            if found != None -> return found
            sema_contract_result_ident_in_fallback(fallback)
        }
        else -> None
    }
}

fn sema_contract_result_ident_in_fallback(value: OrFallback) -> Span? {
    if value == {
        .Value(expression) -> sema_contract_result_ident_in_expr(expression)
        .Block(body, expression, _) -> {
            found := sema_contract_result_ident_in_statements(body)
            if found != None -> return found
            sema_contract_result_ident_in_optional_expr(expression)
        }
        .Return(expression, _) -> sema_contract_result_ident_in_optional_expr(expression)
        .Panic(_, args) -> sema_contract_result_ident_in_call_args(args)
        else -> None
    }
}

fn sema_contract_result_ident_in_binding(binding: Binding) -> Span? {
    found := sema_contract_result_ident_in_expr(binding.init)
    if found != None -> return found
    found = sema_contract_result_ident_in_bind_pattern(binding.pattern)
    if found != None -> return found
    loop marker in binding.markers {
        loop argument in marker.args {
            if argument == .Expr(expression) {
                found = sema_contract_result_ident_in_expr(expression)
                if found != None -> return found
            }
        }
    }
    if binding.meta == .Val(meta) {
        loop field in meta.fields {
            if field == {
                .Category(expression, _) | .Maturity(expression, _) -> {
                    found = sema_contract_result_ident_in_expr(expression)
                    if found != None -> return found
                }
                .Unknown(_, expression, _) -> {
                    found = sema_contract_result_ident_in_optional_expr(expression)
                    if found != None -> return found
                }
                .Tunable(_) -> {}
            }
        }
    }
    None
}

fn sema_contract_result_ident_in_stmt(value: Stmt) -> Span? {
    if value == {
        .Expr(expression) -> sema_contract_result_ident_in_expr(expression)
        .Val(binding) -> sema_contract_result_ident_in_binding(binding)
        .Assign(target, _, _, expression) -> {
            found := sema_contract_result_ident_in_lvalue(target)
            if found != None -> return found
            sema_contract_result_ident_in_expr(expression)
        }
        .Return(expression, _) -> sema_contract_result_ident_in_optional_expr(expression)
        .Yield(expression, _) -> sema_contract_result_ident_in_expr(expression)
        .While(condition, body, _, _, _) -> {
            found := sema_contract_result_ident_in_expr(condition)
            if found != None -> return found
            sema_contract_result_ident_in_statements(body)
        }
        .For(_, _, _, kind, body, _, _, _, _) -> {
            found := if kind == {
                .Range(start, end, step, _) -> {
                    candidate := sema_contract_result_ident_in_expr(start)
                    if candidate != None -> return candidate
                    candidate = sema_contract_result_ident_in_expr(end)
                    if candidate != None -> return candidate
                    sema_contract_result_ident_in_optional_expr(step)
                }
                .In(collection, step) -> {
                    candidate := sema_contract_result_ident_in_expr(collection)
                    if candidate != None -> return candidate
                    sema_contract_result_ident_in_optional_expr(step)
                }
            }
            if found != None -> return found
            sema_contract_result_ident_in_statements(body)
        }
        .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
            found := sema_contract_result_ident_in_expr(subject)
            if found != None -> return found
            loop arm in arms {
                found = sema_contract_result_ident_in_expr(arm.cond)
                if found != None -> return found
                found = sema_contract_result_ident_in_statements(arm.body)
                if found != None -> return found
            }
            if else_body == .Val(else_statements) -> sema_contract_result_ident_in_statements(else_statements) else -> None
        }
        .BreakValue(expression, _) | .BreakLabelValue(_, _, expression, _) -> sema_contract_result_ident_in_expr(expression)
        .Loop(body, _, _, _) | .Reactive(body, _) | .Shield(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .Layout(_, _, body, _) | .Live(body, _) | .ComptimeBlock(body, _, _) -> sema_contract_result_ident_in_statements(body)
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            found := sema_contract_result_ident_in_binding(init)
            if found != None -> return found
            found = sema_contract_result_ident_in_expr(condition)
            if found != None -> return found
            if step == .Val(step_statement) {
                found = sema_contract_result_ident_in_stmt(step_statement)
                if found != None -> return found
            }
            sema_contract_result_ident_in_statements(body)
        }
        .Unsafe(_, audit_expr, body, _) | .Impure(_, audit_expr, body, _) -> {
            found := sema_contract_result_ident_in_optional_expr(audit_expr)
            if found != None -> return found
            sema_contract_result_ident_in_statements(body)
        }
        .TaskGroup(_, _, limit, body, _) -> {
            found := sema_contract_result_ident_in_optional_expr(limit)
            if found != None -> return found
            sema_contract_result_ident_in_statements(body)
        }
        .AuthorityScope(_, _, _, body, _) | .Transact(_, _, body, _, _) -> sema_contract_result_ident_in_statements(body)
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            found := sema_contract_result_ident_in_expr(condition)
            if found != None -> return found
            found = sema_contract_result_ident_in_statements(then_body)
            if found != None -> return found
            if else_body == .Val(else_statements) -> sema_contract_result_ident_in_statements(else_statements) else -> None
        }
        .ContextBlock(fields, body, _) -> {
            loop field in fields {
                found :: sema_contract_result_ident_in_expr(field.value)
                if found != None -> return found
            }
            sema_contract_result_ident_in_statements(body)
        }
        .AssumeDet(_, reason_expr, body, _) -> {
            found := sema_contract_result_ident_in_expr(reason_expr)
            if found != None -> return found
            sema_contract_result_ident_in_statements(body)
        }
        .ScopeMember(_, _, args, _, body, _, _, _) -> {
            loop argument in args {
                found :: sema_contract_result_ident_in_expr(argument)
                if found != None -> return found
            }
            sema_contract_result_ident_in_statements(body)
        }
        .DeferClose(expression, _) -> sema_contract_result_ident_in_expr(expression)
        else -> None
    }
}

fn sema_contract_result_ident_in_statements(values: [Stmt]) -> Span? {
    loop value in values {
        found :: sema_contract_result_ident_in_stmt(value)
        if found != None -> return found
    }
    None
}

fn sema_contract_result_ident_in_expr(expr: Expr) -> Span? {
    if expr == {
        .Ident(name, span, _) -> if name == "result" -> Val(span) else -> None
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(value, _) {
                    found :: sema_contract_result_ident_in_expr(value)
                    if found != None -> return found
                }
            }
            None
        }
        .ListLit(elements, _, _) -> {
            loop value in elements {
                found :: sema_contract_result_ident_in_expr(value)
                if found != None -> return found
            }
            None
        }
        .MemberSpread(base, _, _, _) | .Spread(base, _, _) | .Deref(base, _, _) | .RawOf(base, _, _) | .Copy(base, _, _) | .Place(base, _, _, _) | .Tainted(base, _, _, _) | .Present(base, _, _) | .Ok(base, _, _) | .Err(base, _, _) | .Paren(base, _, _) -> sema_contract_result_ident_in_expr(base)
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                found := sema_contract_result_ident_in_expr(entry.key)
                if found != None -> return found
                found = sema_contract_result_ident_in_expr(entry.value)
                if found != None -> return found
            }
            None
        }
        .Index(base, index, _, _, _) -> {
            found := sema_contract_result_ident_in_expr(base)
            if found != None -> return found
            sema_contract_result_ident_in_expr(index)
        }
        .Slice(base, start, end, range, _, _) -> {
            found := sema_contract_result_ident_in_expr(base)
            if found != None -> return found
            found = sema_contract_result_ident_in_expr(start)
            if found != None -> return found
            found = sema_contract_result_ident_in_expr(end)
            if found != None -> return found
            if range == .Val(range_expr) -> sema_contract_result_ident_in_expr(range_expr) else -> None
        }
        .Range(start, end, _, _, _) -> {
            found := sema_contract_result_ident_in_expr(start)
            if found != None -> return found
            sema_contract_result_ident_in_expr(end)
        }
        .Call(call, _) -> sema_contract_result_ident_in_call_args(call.args)
        .CallValue(callee, args, _, _) -> {
            found := sema_contract_result_ident_in_expr(callee)
            if found != None -> return found
            sema_contract_result_ident_in_call_args(args)
        }
        .Unary(_, operand, _, _) -> sema_contract_result_ident_in_expr(operand)
        .Binary(_, left, right, _, _) -> {
            found := sema_contract_result_ident_in_expr(left)
            if found != None -> return found
            sema_contract_result_ident_in_expr(right)
        }
        .CompareChain(operands, _, _, _, _) -> {
            loop operand in operands {
                found :: sema_contract_result_ident_in_expr(operand)
                if found != None -> return found
            }
            None
        }
        .Field(base, _, _, _) | .OptField(base, _, _, _, _, _) -> sema_contract_result_ident_in_expr(base)
        .MethodCall(receiver, _, _, _, _, args, _) | .OptMethodCall(receiver, _, _, _, args, _, _) -> {
            found := sema_contract_result_ident_in_expr(receiver)
            if found != None -> return found
            sema_contract_result_ident_in_call_args(args)
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            loop field in fields {
                found :: sema_contract_result_ident_in_expr(field.value)
                if found != None -> return found
            }
            None
        }
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> loop field in fields {
                    found :: sema_contract_result_ident_in_expr(field.value)
                    if found != None -> return found
                }
                .Elements(elements) -> loop value in elements {
                    found :: sema_contract_result_ident_in_expr(value)
                    if found != None -> return found
                }
                .Entries(entries) -> loop entry in entries {
                    key_found :: sema_contract_result_ident_in_expr(entry.key)
                    if key_found != None -> return key_found
                    value_found :: sema_contract_result_ident_in_expr(entry.value)
                    if value_found != None -> return value_found
                }
                .Value(value) -> return sema_contract_result_ident_in_expr(value)
                else -> {}
            }
            None
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop argument in args {
                if argument == {
                    .Positional(value) -> {
                        found :: sema_contract_result_ident_in_expr(value)
                        if found != None -> return found
                    }
                    .Named(_, value) -> {
                        found :: sema_contract_result_ident_in_expr(value)
                        if found != None -> return found
                    }
                }
            }
            None
        }
        .PatternTest(subject, pattern, _, _) -> {
            found := sema_contract_result_ident_in_expr(subject)
            if found != None -> return found
            sema_contract_result_ident_in_pattern(pattern)
        }
        .Try(value, _, _, context, _) -> {
            found := sema_contract_result_ident_in_expr(value)
            if found != None -> return found
            if context == .Val(context_expr) -> sema_contract_result_ident_in_expr(context_expr) else -> None
        }
        .OrFallback(value, fallback, _, _, _) -> {
            found := sema_contract_result_ident_in_expr(value)
            if found != None -> return found
            sema_contract_result_ident_in_fallback(fallback)
        }
        .If(condition, then_body, then_value, else_body, else_value, _, _) -> {
            found := sema_contract_result_ident_in_expr(condition)
            if found != None -> return found
            found = sema_contract_result_ident_in_statements(then_body)
            if found != None -> return found
            found = sema_contract_result_ident_in_expr(then_value)
            if found != None -> return found
            found = sema_contract_result_ident_in_statements(else_body)
            if found != None -> return found
            sema_contract_result_ident_in_expr(else_value)
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields {
                found :: sema_contract_result_ident_in_expr(field.value)
                if found != None -> return found
            }
            None
        }
        .Lambda(lambda, _) -> if lambda.body == {
            .Expr(value) -> sema_contract_result_ident_in_expr(value)
            .Block(body) -> sema_contract_result_ident_in_statements(body)
        }
        .PtrFromAddr(_, _, _, address, _, _) -> sema_contract_result_ident_in_expr(address)
        else -> None
    }
}

fn sema_contract_check_expr(expr: Expr, expected: Type, kind: String, forbid_result: Bool, check_purity: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, state: SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if forbid_result {
        if sema_contract_result_ident_in_expr(expr) == .Val(result_span) {
            &diagnostics.push(sema_error("E0144", result_span, "`result` isn't available in a `#Pre` condition", "`result` names the return value, which only exists once the function has returned — a `#Pre` condition runs at entry, before there is one", "use `result` only in a `#Post` condition"))
            return None
        }
    }
    checked_scopes := sema_scope_snapshot(scopes)
    checked_state := sema_ownership_state_snapshot(state)
    checked_context := sema_check_context_snapshot(context)
    call_start :: checked_context.call_facts.len()
    view_start :: checked_context.call_return_views.len()
    name_start :: checked_context.name_references.len()
    comptime_start :: checked_context.comptime_requests.len()
    copy_start :: checked_context.copy_events.len()
    value :: sema_check_expression(expr, None, environment, program, &checked_scopes, &checked_state, &tail_store, &checked_context, &diagnostics)
    valid := value != None
    if value == .Val(actual) {
        if actual.ty != expected {
            if {
                expected == Type.Bool -> &diagnostics.push(sema_error("E0110", expr_span(expr), "a `#{kind}` condition must be Bool, but this is {type_name(actual.ty)}", "the program needs a clear yes or no here", "compare the value to something to produce Bool"))
                else -> &diagnostics.push(sema_type_mismatch(expected, actual.ty, expr_span(expr)))
            }
            valid = false
        }
    }
    if check_purity && !sema_contract_check_pure_delta(call_start, checked_context, kind, environment, program, &diagnostics) -> valid = false
    sema_contract_merge_context_delta(checked_context, call_start, view_start, name_start, comptime_start, copy_start, &context)
    // The condition's flat nodes are rows of its arena, which continues this one.
    sema_arena_take_back(&context, ^checked_context.arena)
    if !valid -> return None
    value
}

fn sema_contract_type_name(ty: Type) -> String? {
    if ty == {
        .Named(name) -> Val(name)
        .Tagged(_, inner) -> sema_contract_type_name(inner)
        else -> None
    }
}

fn sema_contract_distinct_range(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TIntegerRange? {
    name :: sema_contract_type_name(ty) ?? return None
    // The first row that is either `name` owned by this module or the
    // qualified `module::name` itself.
    local_row :: sema_scope_checked_type_row(environment, program, environment.module_identity, name)
    qualified_row :: program.checked_type_rows.get(name)
    row := -1
    if local_row == .Val(local) -> row = local
    if qualified_row == .Val(qualified) && (row < 0 || qualified < row) -> row = qualified
    if row < 0 -> return None
    // copy: `range` is a payload of read parameter `program`, which keeps the original; the returned value owns this one
    if program.checked_types[row].kind == .Distinct(_, range) -> return range.copy()
    None
}

fn sema_contract_interval(expr: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TIntegerRange? {
    if expr.kind == {
        .IntLit(value, _) -> Val(TIntegerRange{lo: value, hi: value})
        .Local(_) -> sema_contract_distinct_range(expr.ty, environment, program)
        .MethodCall(value, method, _, _) -> if method.name == "raw" -> sema_contract_interval(value, environment, program) else -> None
        .DistinctRaw(value) -> sema_contract_interval(value, environment, program)
        else -> None
    }
}

fn sema_contract_interval_comparison(op: TBinaryOp, left: TIntegerRange, right: TIntegerRange) -> Bool Never! {
    if op == {
        .Eq -> left.lo == left.hi && left.lo == right.lo && left.hi == right.hi
        .Ne -> left.hi < right.lo || right.hi < left.lo
        .Lt -> left.hi < right.lo
        .Gt -> left.lo > right.hi
        .Le -> left.hi <= right.lo
        .Ge -> left.lo >= right.hi
        else -> false
    }
}

fn sema_contract_expr_proven(expr: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables, context: SemaCheckContext) -> Bool Never! {
    if expr.kind == {
        // A literal condition is a flat `BoolLit` row (sema_node).
        .Flat(index) -> {
            if context.arena.tree.nodes[index - context.arena.base].kind == .BoolLit(value) -> return value
            false
        }
        .Binary(op, _, _, left, right) -> if op == {
            .And -> sema_contract_expr_proven(left, environment, program, context) && sema_contract_expr_proven(right, environment, program, context)
            .Or -> sema_contract_expr_proven(left, environment, program, context) || sema_contract_expr_proven(right, environment, program, context)
            .Eq | .Ne | .Lt | .Gt | .Le | .Ge -> {
                left_range :: sema_contract_interval(left, environment, program) ?? return false
                right_range :: sema_contract_interval(right, environment, program) ?? return false
                sema_contract_interval_comparison(op, left_range, right_range)
            }
            else -> false
        }
        .CompareChain(operands, operators, _) -> {
            if operators.len() + 1 != operands.len() -> return false
            loop index in 0..<operators.len() {
                left_range :: sema_contract_interval(operands[index], environment, program) ?? return false
                right_range :: sema_contract_interval(operands[index + 1], environment, program) ?? return false
                if !sema_contract_interval_comparison(operators[index], left_range, right_range) -> return false
            }
            true
        }
        else -> false
    }
}

fn sema_contract_disposition(condition: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables, context: SemaCheckContext) -> TContractDisposition Never! {
    if sema_contract_expr_proven(condition, environment, program, context) -> TContractDisposition.Proven else -> TContractDisposition.Check
}

fn sema_contract_make(kind: TContractKind, condition: TExpr, message: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables, span: Span, location_span: Span, context: SemaCheckContext) -> TContract Never! {
    TContract{kind: kind, condition: condition, message: message, file: sema_contract_file(environment, program, location_span), line: sema_contract_line(environment, program, location_span), span: span, disposition: sema_contract_disposition(condition, environment, program, context)}
}

// `owner` is the function owner key plus a `post` segment: a body local named
// `result` lives in the function frame itself, so the contract binding needs
// an identity of its own once both are lowered by symbol.
fn sema_contract_result_binding_symbol(environment: SemaScopeEnvironment, program: SemaProgramTables, owner: String, ty: Type, span: Span) -> Symbol Never! {
    result_owner :: "{owner}/post"
    id :: symbol_id(SymbolKind.Local, environment.module_identity, result_owner, "result")
    Symbol{id: id, kind: SymbolKind.Local, name: "result", module_name: environment.module_identity, owner: Val(result_owner), span: span, ty: Val(ty), visibility: 0}
}

fn sema_contract_check_function(func: Func, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaContractDeclaration {
    declared_return := func.return_type
    if program.registration_graph == .Val(graph) && declared_return == .Val(declared) {
        declared_return = Val(sema_type_resolve_declared_with_generics(graph, declared, environment.module_identity, environment.generic_params))
    }
    result :: sema_contract_result_for_function(declared_return, func.name_span, environment, program, sema_scope_function_owner_key(scopes))
    complete := true
    post := [TContract]{}
    loop clause in func.pre {
        condition :: sema_contract_check_expr(clause.cond, Type.Bool, "Pre", true, true, environment, program, scopes, state, &tail_store, &context, &diagnostics)
        if condition == None -> complete = false
        message :: sema_contract_check_expr(clause.message_expr, Type.String, "Pre", false, false, environment, program, scopes, state, &tail_store, &context, &diagnostics)
        if message == None -> complete = false
    }
    if func.post.len() > 0 {
        post_scopes := sema_scope_snapshot(scopes)
        post_state := sema_ownership_state_snapshot(state)
        owner :: sema_scope_function_owner_key(scopes)
        sema_scope_enter(&post_scopes, &post_state, owner)
        result_symbol :: sema_contract_result_binding_symbol(environment, program, owner, result.binding_ty, func.name_span)
        if {
            !sema_scope_declare_local(&post_scopes, result_symbol, false, AccessConvention.Read, None, false) -> {
                &diagnostics.push(sema_already_defined("result", func.name_span))
                complete = false
            }
            else -> {
                sema_ownership_declare_binding(&post_state, result_symbol, false)
                loop clause in func.post {
                    condition :: sema_contract_check_expr(clause.cond, Type.Bool, "Post", false, true, environment, program, post_scopes, post_state, &tail_store, &context, &diagnostics)
                    if condition == None -> complete = false
                    message :: sema_contract_check_expr(clause.message_expr, Type.String, "Post", false, false, environment, program, post_scopes, post_state, &tail_store, &context, &diagnostics)
                    if message == None -> complete = false
                    if condition == .Val(condition_value) && message == .Val(message_value) {
                        &post.push(sema_contract_make(TContractKind.Post, condition_value, message_value, environment, program, clause.span, clause.span, context))
                    }
                }
            }
        }
        sema_scope_leave(&post_scopes, &post_state)
    }
    SemaContractDeclaration{complete: complete, post: post, result: result}
}

fn sema_contract_method_function_for_item(item: Item, target: SymbolID, module_identity: String) -> Func? {
    if item == {
        .Struct(value) -> {
            loop method in value.methods {
                if symbol_id(SymbolKind.Function, module_identity, value.name, method.name).key == target.key -> return Val(method)
            }
        }
        .Enum(value) -> {
            loop method in value.methods {
                if symbol_id(SymbolKind.Function, module_identity, value.name, method.name).key == target.key -> return Val(method)
            }
        }
        .Impl(value) -> {
            loop method in value.methods {
                if symbol_id(SymbolKind.Function, module_identity, value.type_name, method.name).key == target.key -> return Val(method)
            }
        }
        else -> {}
    }
    None
}

fn sema_contract_function_for_symbol(environment: SemaScopeEnvironment, program: SemaProgramTables, target: SymbolID) -> Func? {
    if program.registration_graph == .Val(graph) {
        declaration :: sema_registration_callable_declaration(graph, target)
        if declaration != None -> return declaration
    }
    loop declaration_index in 0..<environment.declarations.len() {
        if environment.declarations[declaration_index].symbol_id.key == target.key {
            // copy: `value` is a payload of read parameter `environment`, which keeps the original; the Val carrier owns this one
            if environment.declarations[declaration_index].item == .Func(value) -> return Val(value.copy())
        }
        method :: sema_contract_method_function_for_item(environment.declarations[declaration_index].item, target, environment.module_identity)
        if method != None -> return method
    }
    None
}

// What a call needs to know about its callee's contract, read from the
// declaration in place: a call checks `pre` clauses only when there are any,
// so it copies the callee's declaration (and its body) only then.
struct SemaContractCalleeFacts {
    pre_count: Int
    is_pure: Bool
}

fn sema_contract_callee_facts(func: Func) -> SemaContractCalleeFacts Never! {
    SemaContractCalleeFacts{pre_count: func.pre.len(), is_pure: func.is_pure}
}

fn sema_contract_registered_facts(graph: SemaRegistrationGraph, target: SymbolID) -> SemaContractCalleeFacts? {
    row :: graph.callable_rows.get(target.key) ?? return None
    if row == {
        .Function(module_index, index) -> Val(sema_contract_callee_facts(graph.modules[module_index].functions[index].declaration))
        .Foreign(_, _) -> None
        .NominalMethod(module_index, owner, index) -> Val(sema_contract_callee_facts(graph.modules[module_index].nominals[owner].methods[index].declaration))
        .ImplMethod(module_index, owner, index) -> Val(sema_contract_callee_facts(graph.modules[module_index].impls[owner].methods[index].declaration))
    }
}

fn sema_contract_method_facts_for_item(item: Item, target: SymbolID, module_identity: String) -> SemaContractCalleeFacts? {
    if item == {
        .Struct(value) -> {
            loop method in value.methods {
                if symbol_id(SymbolKind.Function, module_identity, value.name, method.name).key == target.key -> return Val(sema_contract_callee_facts(method))
            }
        }
        .Enum(value) -> {
            loop method in value.methods {
                if symbol_id(SymbolKind.Function, module_identity, value.name, method.name).key == target.key -> return Val(sema_contract_callee_facts(method))
            }
        }
        .Impl(value) -> {
            loop method in value.methods {
                if symbol_id(SymbolKind.Function, module_identity, value.type_name, method.name).key == target.key -> return Val(sema_contract_callee_facts(method))
            }
        }
        else -> {}
    }
    None
}

// The facts of the declaration `sema_contract_function_for_symbol` resolves
// `target` to (same lookup order), without copying it.
fn sema_contract_function_facts(environment: SemaScopeEnvironment, program: SemaProgramTables, target: SymbolID) -> SemaContractCalleeFacts? {
    if program.registration_graph == .Val(graph) {
        registered :: sema_contract_registered_facts(graph, target)
        if registered != None -> return registered
    }
    loop declaration_index in 0..<environment.declarations.len() {
        if environment.declarations[declaration_index].symbol_id.key == target.key {
            if environment.declarations[declaration_index].item == .Func(value) -> return Val(sema_contract_callee_facts(value))
        }
        method :: sema_contract_method_facts_for_item(environment.declarations[declaration_index].item, target, environment.module_identity)
        if method != None -> return method
    }
    None
}

// True when a call to `target` has `pre` clauses to check.
fn sema_contract_function_has_pre(environment: SemaScopeEnvironment, program: SemaProgramTables, target: SymbolID) -> Bool Never! {
    facts :: sema_contract_function_facts(environment, program, target) ?? return false
    facts.pre_count > 0
}

fn sema_contract_generated_argument_symbol(environment: SemaScopeEnvironment, program: SemaProgramTables, owner: String, index: Int, parameter_name: String, span: Span, ty: Type) -> Symbol Never! {
    name :: "contract_arg_{span.start}_{index}"
    id :: symbol_id(SymbolKind.Local, environment.module_identity, owner, name)
    Symbol{id: id, kind: SymbolKind.Local, name: parameter_name, module_name: environment.module_identity, owner: Val(owner), span: span, ty: Val(ty), visibility: 0}
}

fn sema_contract_pin_argument(environment: SemaScopeEnvironment, program: SemaProgramTables, owner: String, index: Int, parameter_name: String, convention: AccessConvention, argument: &TCallArg, call_span: Span, scopes: &SemaScopeTable, state: &SemaOwnershipState, bindings: &[TStmt]) -> TLocal Never! {
    original := argument.value
    init := original
    local := tir_generated_local("contract_arg_{call_span.start}_{index}", call_span)
    local.mutable = argument.mut_borrow
    if argument.borrow || argument.mut_borrow {
        access :: if argument.mut_borrow -> AccessConvention.Write else -> AccessConvention.Read
        init = sema_tir_node(original.ty, TExprKind.Borrow{place: init, access: access}, original.span)
        local.deref = true
    }
    symbol :: sema_contract_generated_argument_symbol(environment, program, owner, index, parameter_name, call_span, original.ty)
    local = tir_symbol_local(local.name, local.span, symbol.id)
    local.generated = true
    local.mutable = argument.mut_borrow
    local.deref = argument.borrow || argument.mut_borrow
    local_value :: sema_tir_node(original.ty, TExprKind.Local{local: local}, original.span)
    replacement :: if convention == AccessConvention.Move -> sema_tir_node(original.ty, TExprKind.Move{value: local_value}, original.span) else -> local_value
    argument.value = replacement
    &bindings.push(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: init, gc_promotion: None, gc_transferred: false, span: call_span})
    sema_scope_declare_local(&scopes, symbol, argument.mut_borrow, if argument.mut_borrow -> AccessConvention.Write else -> AccessConvention.Read, None, false)
    sema_ownership_declare_binding(&state, symbol, false)
    local
}

fn sema_contract_check_call(func: Func, args: &[TCallArg], slots: [Int], call_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaContractCall? {
    if func.pre.len() == 0 -> return Val(SemaContractCall{bindings: [TStmt]{}, contracts: [TContract]{}})
    if args.len() != slots.len() -> return None
    if func.params.len() == 0 && args.len() > 0 -> return None
    checked_scopes := sema_scope_snapshot(scopes)
    checked_state := sema_ownership_state_snapshot(state)
    owner :: sema_scope_function_owner_key(scopes)
    sema_scope_enter(&checked_scopes, &checked_state, owner)
    bindings := [TStmt]{}
    loop index in 0..<args.len() {
        slot :: slots[index]
        if slot < 0 || slot >= func.params.len() -> return None
        _ := sema_contract_pin_argument(environment, program, owner, index, func.params[slot].name, func.params[slot].convention, &args[index], call_span, &checked_scopes, &checked_state, &bindings)
    }
    contracts := [TContract]{}
    complete := true
    loop clause in func.pre {
        condition :: sema_contract_check_expr(clause.cond, Type.Bool, "Pre", false, true, environment, program, checked_scopes, checked_state, &tail_store, &context, &diagnostics)
        if condition == None -> complete = false
        message :: sema_contract_check_expr(clause.message_expr, Type.String, "Pre", false, false, environment, program, checked_scopes, checked_state, &tail_store, &context, &diagnostics)
        if message == None -> complete = false
        if condition == .Val(condition_value) && message == .Val(message_value) {
            &contracts.push(sema_contract_make(TContractKind.Pre, condition_value, message_value, environment, program, call_span, call_span, context))
        }
    }
    sema_scope_leave(&checked_scopes, &checked_state)
    if !complete -> return None
    Val(SemaContractCall{bindings: bindings, contracts: contracts})
}
