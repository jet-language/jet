// Checked function contracts and call-site precondition production.
//
// A declaration's #Post clauses live in one ContractScope around its body.
// #Pre clauses are caller obligations: this file pins each evaluated argument
// once, checks the clauses against those pins, and leaves the callee scope's
// pre list empty so a contract is never evaluated twice. A clause written
// `#run { … }` is decided for each call while building instead, a #Post one
// over the call's own value computed while building.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    BindPattern,
    Binding,
    Call,
    CallArg,
    ContractClause,
    Diagnostic,
    Expr,
    Func,
    Item,
    LValue,
    OrFallback,
    PatSlot,
    Pattern,
    Span,
    Stmt,
    Symbol,
    SymbolID,
    SymbolKind,
    TBinaryOp,
    TContractDisposition,
    TContractKind,
    TContractSite,
    TContractResult,
    TContractResultMode,
    TIntegerRange,
    TLetTy,
    TLocal,
    Type,
    ast_empty_call_arg_flags,
    expr_span,
    symbol_id,
    checked_generated_local,
    checked_symbol_local,
    type_name,
]

SemaContractDeclaration: struct {
    complete: Bool
    post: [TContract]
    // The checked `#Pre` clauses; only the solver reads them (FnBody.pre).
    pre: [TContract]{[TContract]{}}
    result: TContractResult
}

SemaContractCall: struct {
    bindings: [TStmt]
    contracts: [TContract]
}

// The call a `#Post` decided while building computes again: the callee as
// the call wrote it, called over the pinned arguments, and the type that
// call checked to. Only a direct call by name has one.
SemaContractRecall: struct {
    call: Call
    result_type: Type
}

sema_contract_success_type: fn(return_type: Type?) -> Type Never! {
    return_type ?? Type.Named{name: "Unit"}
}

sema_contract_result_mode: fn(carrier: Type, binding: Type) -> TContractResultMode Never! {
    if carrier == binding -> return TContractResultMode.Direct
    if carrier == {
        .Result(_, _) -> TContractResultMode.ResultPayload
        .Option(_) -> TContractResultMode.OptionPayload
        .Tagged(_, inner) -> sema_contract_result_mode(inner, binding)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> TContractResultMode.Direct
    }
}

// The binding local carries the symbol `#Post` reads of `result` resolve to,
// so lowering binds the checked return value under that identity.
sema_contract_result_for_function: fn(return_type: Type?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, owner: String) -> TContractResult Never! {
    carrier: sema_effective_return_type(return_type)
    binding: sema_contract_success_type(return_type)
    mode: sema_contract_result_mode(carrier, binding)
    binding_local := checked_generated_local("result", span, binding)
    binding_local.symbol_id = Val(sema_contract_result_binding_symbol(environment, program, owner, binding, span).id)
    carrier_local: if mode != TContractResultMode.Direct -> checked_generated_local("result_carrier", span, carrier) else -> binding_local
    TContractResult{carrier_ty: carrier, binding_ty: binding, carrier_local: carrier_local, binding_local: binding_local, mode: mode}
}

sema_contract_file: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, span: Span) -> String Never! {
    sema_source_file_at(environment.source_segments, environment.source_file, environment.source_origin, span)
}

sema_contract_line: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, span: Span) -> Int Never! {
    sema_source_line_at(environment.source_segments, span) ?? 0
}

// The declared site of the clause whose condition spans `span` in the module
// `module_identity`, whose source `segments` map.
sema_contract_site: fn(segments: [SemaSourceSegment], file: String, origin: SemaSourceOrigin, module_identity: String, span: Span) -> TContractSite Never! {
    TContractSite{file: sema_source_file_at(segments, file, origin, span), line: sema_source_line_at(segments, span) ?? 0, column: sema_source_column_at(segments, span) ?? 0, core: sema_module_is_core_source(module_identity)}
}

// The declared sites of `func`'s `pre` clauses: `func` is the declaration
// `target` resolves to (sema_contract_function_for_symbol), in its own
// module, whose source maps the clause spans; a call site's module may differ.
sema_contract_pre_sites: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, target: SymbolID, func: Func) -> [TContractSite] Never! {
    if program.registration_graph == .Val(graph) {
        if sema_registration_callable_row(graph, target.key) == .Val(row) {
            module_index: if row == {
                .Function(index, _) -> index
                .Foreign(index, _) -> index
                .NominalMethod(index, _, _) -> index
                .ImplMethod(index, _, _) -> index
            }
            return loop clause in func.pre -> sema_contract_site(graph.modules[module_index].source_segments, graph.modules[module_index].source_file, graph.modules[module_index].source_origin, graph.modules[module_index].module_identity, expr_span(clause.cond))
        }
    }
    loop clause in func.pre -> sema_contract_site(environment.source_segments, environment.source_file, environment.source_origin, environment.module_identity, expr_span(clause.cond))
}

sema_contract_call_is_pure: fn(fact: SemaCallSiteFact, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if fact.facts.effect_bound == .Val(row) {
        loop entry in row {
            if entry.name.starts_with("!") -> next
            return false
        }
        return true
    }
    target: fact.callee ?? return false
    facts: sema_contract_function_facts(environment, program, target) ?? return false
    facts.is_pure
}

sema_contract_purity_diagnostic: fn(kind: String, span: Span) -> Diagnostic {
    sema_error("E0139", span, "a `#{kind}` condition can't do I/O", "a contract is checked at every call and must be a pure claim about values", "move the effect out; keep only a pure test")
}

sema_contract_check_pure_delta: fn(start: Int, context: SemaCheckContext, kind: String, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    loop index in start..<context.call_facts.len() {
        fact: context.call_facts[index]
        if !sema_contract_call_is_pure(fact, environment, program) {
            diagnostics.push(sema_contract_purity_diagnostic(kind, fact.span))
            valid = false
        }
    }
    valid
}

sema_contract_merge_context_delta: fn(source: SemaCheckContext, call_start: Int, view_start: Int, name_start: Int, comptime_start: Int, copy_start: Int, destination: &SemaCheckContext) Never! {
    loop index in call_start..<source.call_facts.len() -> destination.call_facts.push(source.call_facts[index])
    loop index in view_start..<source.call_return_views.len() -> destination.call_return_views.push(source.call_return_views[index])
    loop index in name_start..<source.name_references.len() -> destination.name_references.push(source.name_references[index])
    loop index in comptime_start..<source.comptime_requests.len() -> destination.comptime_requests.push(source.comptime_requests[index])
    loop index in copy_start..<source.copy_events.len() -> destination.copy_events.push(source.copy_events[index])
    // A snapshot starts with no goal rows and no incomplete reasons, so every
    // row it holds is this condition's; a condition left incomplete keeps why.
    loop index in 0..<source.typed_goals.len() -> destination.typed_goals.push(source.typed_goals[index])
    loop index in 0..<source.index_proofs.len() -> destination.index_proofs.push(source.index_proofs[index])
    loop reason in source.incomplete_reasons -> destination.incomplete_reasons.push(reason.copy())
    sema_check_context_merge_expr_ids(source, destination)
    if source.exact_int_reachable -> destination.exact_int_reachable = true
}

sema_contract_result_ident_in_call_args: fn(args: [CallArg]) -> Span? {
    loop argument in args {
        found: sema_contract_result_ident_in_expr(argument.expr)
        if found != None -> return found
    }
    None
}

sema_contract_result_ident_in_optional_expr: fn(value: Expr?) -> Span? {
    if value == {
        .Val(expression) -> sema_contract_result_ident_in_expr(expression)
        .None -> None
    }
}

sema_contract_result_ident_in_lvalue: fn(value: LValue) -> Span? {
    if value == {
        .Index(base, index, _, _) -> {
            found := sema_contract_result_ident_in_expr(base)
            if found != None -> return found
            sema_contract_result_ident_in_expr(index)
        }
        .Field(base, _, _) -> sema_contract_result_ident_in_expr(base)
        .Local(_, _) -> None
    }
}

sema_contract_result_ident_in_pattern: fn(value: Pattern) -> Span? {
    if value == {
        .Or(alternatives, _) -> {
            loop alternative in alternatives {
                found: sema_contract_result_ident_in_pattern(alternative)
                if found != None -> return found
            }
            None
        }
        .Struct(fields, _, _, _) -> {
            loop field in fields {
                if field == .Value(_, _, expression) {
                    found: sema_contract_result_ident_in_expr(expression)
                    if found != None -> return found
                }
                if field == .Nested(_, _, nested) {
                    found: sema_contract_result_ident_in_pattern(nested)
                    if found != None -> return found
                }
            }
            None
        }
        .Variant(_, slots, _, _) | .List(slots, _, _) -> {
            loop slot in slots {
                found: sema_contract_result_ident_in_pattern_slot(slot)
                if found != None -> return found
            }
            None
        }
        .Map(entries, _, _) -> {
            loop entry in entries {
                found: sema_contract_result_ident_in_expr(entry.key)
                if found != None -> return found
                slot_found: sema_contract_result_ident_in_pattern_slot(entry.slot)
                if slot_found != None -> return slot_found
            }
            None
        }
        .Present(_, _, inner, _) | .Ok(_, _, inner, _) | .Err(_, _, inner, _) -> {
            if inner == .Val(nested) -> sema_contract_result_ident_in_pattern(nested) else -> None
        }
        .Absent(_) | .Range(_, _, _) | .StrMatch(_, _) | .BinMatch(_, _) -> None
    }
}

sema_contract_result_ident_in_pattern_slot: fn(slot: PatSlot) -> Span? {
    if slot == {
        .Value(value) -> sema_contract_result_ident_in_expr(value)
        .Nested(inner) -> sema_contract_result_ident_in_pattern(inner)
        .Named(_, _, inner) -> sema_contract_result_ident_in_pattern_slot(inner)
        .Wildcard | .Bind(_, _) | .Range(_, _) | .Rest(_) -> None
    }
}

sema_contract_result_ident_in_bind_pattern: fn(value: BindPattern?) -> Span? {
    pattern: value ?? return None
    if pattern == {
        .Refutable(inner, fallback, _, _) -> {
            found := sema_contract_result_ident_in_pattern(inner)
            if found != None -> return found
            sema_contract_result_ident_in_fallback(fallback)
        }
        .Struct(_, _, _, _, _) | .List(_, _) | .Tuple(_, _) -> None
    }
}

sema_contract_result_ident_in_fallback: fn(value: OrFallback) -> Span? {
    if value == {
        .Value(expression) -> sema_contract_result_ident_in_expr(expression)
        .Block(body, expression, _) -> {
            found := sema_contract_result_ident_in_statements(body)
            if found != None -> return found
            sema_contract_result_ident_in_optional_expr(expression)
        }
        .Return(expression, _) -> sema_contract_result_ident_in_optional_expr(expression)
        .Panic(_, args) -> sema_contract_result_ident_in_call_args(args)
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> None
    }
}

sema_contract_result_ident_in_binding: fn(binding: Binding) -> Span? {
    found := sema_contract_result_ident_in_expr(binding.init)
    if found != None -> return found
    found = sema_contract_result_ident_in_bind_pattern(binding.pattern)
    if found != None -> return found
    loop marker in binding.markers {
        loop argument in marker.args {
            if argument == .Expr(expression) {
                found = sema_contract_result_ident_in_expr(expression)
                if found != None -> return found
            }
        }
    }
    if binding.meta == .Val(meta) {
        loop field in meta.fields {
            if field == {
                .Category(expression, _) | .Maturity(expression, _) -> {
                    found = sema_contract_result_ident_in_expr(expression)
                    if found != None -> return found
                }
                .Unknown(_, expression, _) -> {
                    found = sema_contract_result_ident_in_optional_expr(expression)
                    if found != None -> return found
                }
                .Tunable(_) -> {}
            }
        }
    }
    None
}

sema_contract_result_ident_in_stmt: fn(value: Stmt) -> Span? {
    if value == {
        .Expr(expression) -> sema_contract_result_ident_in_expr(expression)
        .Val(binding) -> sema_contract_result_ident_in_binding(binding)
        .Assign(target, _, _, expression) -> {
            found := sema_contract_result_ident_in_lvalue(target)
            if found != None -> return found
            sema_contract_result_ident_in_expr(expression)
        }
        .Return(expression, _) -> sema_contract_result_ident_in_optional_expr(expression)
        .Yield(expression, _) -> sema_contract_result_ident_in_expr(expression)
        .While(condition, body, _, _, _) -> {
            found := sema_contract_result_ident_in_expr(condition)
            if found != None -> return found
            sema_contract_result_ident_in_statements(body)
        }
        .For(_, _, _, kind, body, _, _, _, _) -> {
            found := if kind == {
                .Range(start, end, step, _) -> {
                    candidate := sema_contract_result_ident_in_expr(start)
                    if candidate != None -> return candidate
                    candidate = sema_contract_result_ident_in_expr(end)
                    if candidate != None -> return candidate
                    sema_contract_result_ident_in_optional_expr(step)
                }
                .In(collection, step) -> {
                    candidate := sema_contract_result_ident_in_expr(collection)
                    if candidate != None -> return candidate
                    sema_contract_result_ident_in_optional_expr(step)
                }
            }
            if found != None -> return found
            sema_contract_result_ident_in_statements(body)
        }
        .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
            found := sema_contract_result_ident_in_expr(subject)
            if found != None -> return found
            loop arm in arms {
                found = sema_contract_result_ident_in_expr(arm.cond)
                if found != None -> return found
                found = sema_contract_result_ident_in_statements(arm.body)
                if found != None -> return found
            }
            if else_body == .Val(else_statements) -> sema_contract_result_ident_in_statements(else_statements) else -> None
        }
        .BreakValue(expression, _) | .BreakLabelValue(_, _, expression, _) -> sema_contract_result_ident_in_expr(expression)
        .Loop(body, _, _, _) | .Reactive(body, _) | .Shield(body, _) | .Defer(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .Layout(_, _, body, _) | .Live(body, _) | .ComptimeBlock(body, _, _) -> sema_contract_result_ident_in_statements(body)
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            found := sema_contract_result_ident_in_binding(init)
            if found != None -> return found
            found = sema_contract_result_ident_in_expr(condition)
            if found != None -> return found
            if step == .Val(step_statement) {
                found = sema_contract_result_ident_in_stmt(step_statement)
                if found != None -> return found
            }
            sema_contract_result_ident_in_statements(body)
        }
        .Unsafe(_, audit_expr, body, _) | .Impure(_, audit_expr, body, _) -> {
            found := sema_contract_result_ident_in_optional_expr(audit_expr)
            if found != None -> return found
            sema_contract_result_ident_in_statements(body)
        }
        .TaskGroup(_, _, args, body, _) -> {
            found := sema_contract_result_ident_in_optional_expr(args.limit)
            if found != None -> return found
            found = sema_contract_result_ident_in_optional_expr(args.stack)
            if found != None -> return found
            sema_contract_result_ident_in_statements(body)
        }
        .AuthorityScope(_, _, _, body, _) | .Transact(_, _, body, _, _) -> sema_contract_result_ident_in_statements(body)
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            found := sema_contract_result_ident_in_expr(condition)
            if found != None -> return found
            found = sema_contract_result_ident_in_statements(then_body)
            if found != None -> return found
            if else_body == .Val(else_statements) -> sema_contract_result_ident_in_statements(else_statements) else -> None
        }
        .ContextBlock(fields, body, _) -> {
            loop field in fields {
                found: sema_contract_result_ident_in_expr(field.value)
                if found != None -> return found
            }
            sema_contract_result_ident_in_statements(body)
        }
        .AssumeDet(_, reason_expr, body, _) -> {
            found := sema_contract_result_ident_in_expr(reason_expr)
            if found != None -> return found
            sema_contract_result_ident_in_statements(body)
        }
        .ScopeMember(_, _, args, _, body, _, _, _) -> {
            loop argument in args {
                found: sema_contract_result_ident_in_expr(argument)
                if found != None -> return found
            }
            sema_contract_result_ident_in_statements(body)
        }
        .DeferClose(expression, _) -> sema_contract_result_ident_in_expr(expression)
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> None
    }
}

sema_contract_result_ident_in_statements: fn(values: [Stmt]) -> Span? {
    loop value in values {
        found: sema_contract_result_ident_in_stmt(value)
        if found != None -> return found
    }
    None
}

sema_contract_result_ident_in_expr: fn(expr: Expr) -> Span? {
    if expr == {
        .Ident(name, span, _) -> if name == "result" -> Val(span) else -> None
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(value, _) {
                    found: sema_contract_result_ident_in_expr(value)
                    if found != None -> return found
                }
            }
            None
        }
        .ListLit(elements, _, _) -> {
            loop value in elements {
                found: sema_contract_result_ident_in_expr(value)
                if found != None -> return found
            }
            None
        }
        .MemberSpread(base, _, _, _) | .Spread(base, _, _) | .Deref(base, _, _) | .RawOf(base, _, _) | .Copy(base, _, _) | .Place(base, _, _, _) | .Tainted(base, _, _, _) | .Present(base, _, _) | .Ok(base, _, _) | .Err(base, _, _) | .Paren(base, _, _) -> sema_contract_result_ident_in_expr(base)
        .MapLit(entries, _, _) -> {
            loop entry in entries {
                found := sema_contract_result_ident_in_expr(entry.key)
                if found != None -> return found
                found = sema_contract_result_ident_in_expr(entry.value)
                if found != None -> return found
            }
            None
        }
        .Index(base, index, _, _, _) -> {
            found := sema_contract_result_ident_in_expr(base)
            if found != None -> return found
            sema_contract_result_ident_in_expr(index)
        }
        .Slice(base, start, end, range, _, _) -> {
            found := sema_contract_result_ident_in_expr(base)
            if found != None -> return found
            found = sema_contract_result_ident_in_expr(start)
            if found != None -> return found
            found = sema_contract_result_ident_in_expr(end)
            if found != None -> return found
            if range == .Val(range_expr) -> sema_contract_result_ident_in_expr(range_expr) else -> None
        }
        .Range(start, end, _, _, _) -> {
            found := sema_contract_result_ident_in_expr(start)
            if found != None -> return found
            sema_contract_result_ident_in_expr(end)
        }
        .Call(call, _) -> sema_contract_result_ident_in_call_args(call.args)
        .CallValue(callee, args, _, _) -> {
            found := sema_contract_result_ident_in_expr(callee)
            if found != None -> return found
            sema_contract_result_ident_in_call_args(args)
        }
        .Unary(_, operand, _, _) -> sema_contract_result_ident_in_expr(operand)
        .Binary(_, left, right, _, _) -> {
            found := sema_contract_result_ident_in_expr(left)
            if found != None -> return found
            sema_contract_result_ident_in_expr(right)
        }
        .CompareChain(operands, _, _, _, _) -> {
            loop operand in operands {
                found: sema_contract_result_ident_in_expr(operand)
                if found != None -> return found
            }
            None
        }
        .Field(base, _, _, _) | .OptField(base, _, _, _, _, _) -> sema_contract_result_ident_in_expr(base)
        .MethodCall(receiver, _, _, _, _, args, _) | .OptMethodCall(receiver, _, _, _, args, _, _) -> {
            found := sema_contract_result_ident_in_expr(receiver)
            if found != None -> return found
            sema_contract_result_ident_in_call_args(args)
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            loop field in fields {
                found: sema_contract_result_ident_in_expr(field.value)
                if found != None -> return found
            }
            None
        }
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> loop field in fields {
                    found: sema_contract_result_ident_in_expr(field.value)
                    if found != None -> return found
                }
                .Elements(elements) -> loop value in elements {
                    found: sema_contract_result_ident_in_expr(value)
                    if found != None -> return found
                }
                .Entries(entries) -> loop entry in entries {
                    key_found: sema_contract_result_ident_in_expr(entry.key)
                    if key_found != None -> return key_found
                    value_found: sema_contract_result_ident_in_expr(entry.value)
                    if value_found != None -> return value_found
                }
                .Value(value) -> return sema_contract_result_ident_in_expr(value)
                .ByteText(_) | .Empty -> {}
            }
            None
        }
        .EnumLit(_, _, _, args, _, _, _) -> {
            loop argument in args {
                if argument == {
                    .Positional(value) -> {
                        found: sema_contract_result_ident_in_expr(value)
                        if found != None -> return found
                    }
                    .Named(_, value) -> {
                        found: sema_contract_result_ident_in_expr(value)
                        if found != None -> return found
                    }
                }
            }
            None
        }
        .PatternTest(subject, pattern, _, _) -> {
            found := sema_contract_result_ident_in_expr(subject)
            if found != None -> return found
            sema_contract_result_ident_in_pattern(pattern)
        }
        .Try(value, _, _, context, _) -> {
            found := sema_contract_result_ident_in_expr(value)
            if found != None -> return found
            if context == .Val(context_expr) -> sema_contract_result_ident_in_expr(context_expr) else -> None
        }
        .OrFallback(value, fallback, _, _, _) -> {
            found := sema_contract_result_ident_in_expr(value)
            if found != None -> return found
            sema_contract_result_ident_in_fallback(fallback)
        }
        .If(condition, then_body, then_value, else_body, else_value, _, _) -> {
            found := sema_contract_result_ident_in_expr(condition)
            if found != None -> return found
            found = sema_contract_result_ident_in_statements(then_body)
            if found != None -> return found
            found = sema_contract_result_ident_in_expr(then_value)
            if found != None -> return found
            found = sema_contract_result_ident_in_statements(else_body)
            if found != None -> return found
            sema_contract_result_ident_in_expr(else_value)
        }
        .TupleLit(fields, _, _, _) -> {
            loop field in fields {
                found: sema_contract_result_ident_in_expr(field.value)
                if found != None -> return found
            }
            None
        }
        .Lambda(lambda, _) -> if lambda.body == {
            .Expr(value) -> sema_contract_result_ident_in_expr(value)
            .Block(body) -> sema_contract_result_ident_in_statements(body)
        }
        .PtrFromAddr(_, _, _, address, _, _) -> sema_contract_result_ident_in_expr(address)
        .Pipe(head, steps, _, _) -> {
            found := sema_contract_result_ident_in_expr(head)
            if found != None -> return found
            loop step in steps {
                step_found: sema_contract_result_ident_in_expr(step.value)
                if step_found != None -> return step_found
            }
            None
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// `reads` gains the binding key of every name the condition reads: the check
// runs on a snapshot of `state`, so the caller files those reads itself.
sema_contract_check_expr: fn(expr: Expr, expected: Type, kind: String, forbid_result: Bool, check_purity: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, state: SemaOwnershipState, reads: &[String:Bool], tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if forbid_result {
        if sema_contract_result_ident_in_expr(expr) == .Val(result_span) {
            diagnostics.push(sema_error("E0144", result_span, "`result` isn't available in a `#Pre` condition", "`result` names the return value, which only exists once the function has returned — a `#Pre` condition runs at entry, before there is one", "use `result` only in a `#Post` condition"))
            return None
        }
    }
    checked_scopes := sema_scope_snapshot(scopes)
    checked_scopes.position_free = true
    checked_state := sema_ownership_state_snapshot(state)
    checked_context := sema_check_context_snapshot(context)
    call_start: checked_context.call_facts.len()
    view_start: checked_context.call_return_views.len()
    name_start: checked_context.name_references.len()
    comptime_start: checked_context.comptime_requests.len()
    copy_start: checked_context.copy_events.len()
    reference_start: checked_state.references.len()
    value: sema_check_expression(expr, None, environment, program, checked_scopes, checked_state, tail_store, checked_context, diagnostics)
    loop index in reference_start..<checked_state.references.len() -> reads[checked_state.references[index].def_key] = true
    valid := value != None
    if value == .Val(actual) {
        if actual.ty != expected {
            if {
                expected == Type.Bool -> diagnostics.push(sema_error("E0110", expr_span(expr), "a `#{kind}` condition must be Bool, but this is {type_name(actual.ty)}", "the program needs a clear yes or no here", "compare the value to something to produce Bool"))
                else -> diagnostics.push(sema_type_mismatch(expected, actual.ty, expr_span(expr)))
            }
            valid = false
        }
    }
    if check_purity && !sema_contract_check_pure_delta(call_start, checked_context, kind, environment, program, diagnostics) -> valid = false
    sema_contract_merge_context_delta(checked_context, call_start, view_start, name_start, comptime_start, copy_start, context)
    // The condition's flat nodes are rows of its arena, which continues this one.
    sema_arena_take_back(context, checked_context.arena.move())
    if !valid -> return None
    value
}

sema_contract_type_name: fn(ty: Type) -> String? {
    if ty == {
        .Named(name) -> Val(name)
        .Tagged(_, inner) -> sema_contract_type_name(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

sema_contract_distinct_range: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TIntegerRange? {
    name: sema_contract_type_name(ty) ?? return None
    // The first row that is either `name` owned by this module or the
    // qualified `module::name` itself.
    local_row: sema_scope_checked_type_row(environment, program, environment.module_identity, name)
    qualified_row: program.checked_type_rows.get(name)
    row := -1
    if local_row == .Val(local) -> row = local
    if qualified_row == .Val(qualified) && (row < 0 || qualified < row) -> row = qualified
    if row < 0 -> return None
    // copy: `range` is a payload of read parameter `program`, which keeps the original; the returned value owns this one
    if program.checked_types[row].kind == .Distinct(_, range) -> return range.copy()
    None
}

sema_contract_interval: fn(expr: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TIntegerRange? {
    if expr.kind == {
        .IntLit(value, _) -> Val(TIntegerRange{lo: value, hi: value})
        .Local(_) -> sema_contract_distinct_range(expr.ty, environment, program)
        .MethodCall(value, method, _, _) -> if method.name == "raw" -> sema_contract_interval(value, environment, program) else -> None
        .DistinctRaw(value) -> sema_contract_interval(value, environment, program)
        .StrLit(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> None
    }
}

// Each end of an index interval stays within 2^40, so a sum or difference of
// two of them fits in Int.
SEMA_CONTRACT_INDEX_LIMIT: 1099511627776

// The static interval of a fixed-list index read off its parts:
// an Int literal, a `distinct Int(lo..hi)` value or its `.raw()`, and `+` or
// `-` of two such intervals (`faces[roll.raw() - 1]`). None when any part has
// no interval, so the index keeps its runtime check.
sema_contract_index_interval: fn(expr: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TIntegerRange? {
    range := TIntegerRange?{None}
    if expr.kind == .Binary(op, _, _, left, right) {
        if op != .Add && op != .Sub -> return None
        lhs: sema_contract_index_interval(left, environment, program) ?? return None
        rhs: sema_contract_index_interval(right, environment, program) ?? return None
        range = if op == .Add -> Val(TIntegerRange{lo: lhs.lo + rhs.lo, hi: lhs.hi + rhs.hi}) else -> Val(TIntegerRange{lo: lhs.lo - rhs.hi, hi: lhs.hi - rhs.lo})
    } else {
        range = sema_contract_interval(expr, environment, program)
    }
    found: range ?? return None
    if found.lo < -SEMA_CONTRACT_INDEX_LIMIT || found.hi > SEMA_CONTRACT_INDEX_LIMIT -> return None
    Val(found)
}

sema_contract_interval_comparison: fn(op: TBinaryOp, left: TIntegerRange, right: TIntegerRange) -> Bool Never! {
    if op == {
        .Eq -> left.lo == left.hi && left.lo == right.lo && left.hi == right.hi
        .Ne -> left.hi < right.lo || right.hi < left.lo
        .Lt -> left.hi < right.lo
        .Gt -> left.lo > right.hi
        .Le -> left.hi <= right.lo
        .Ge -> left.lo >= right.hi
        .Add | .Sub | .Mul | .Div | .FloorDiv | .Mod | .Rem | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Compare | .And | .Or -> false
    }
}

sema_contract_expr_proven: fn(expr: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables, context: SemaCheckContext) -> Bool Never! {
    if expr.kind == {
        // A literal condition is a flat `BoolLit` row (sema_node).
        .Flat(index) -> {
            if context.arena.tree.nodes[index - context.arena.tree.node_base].kind == .BoolLit(value) -> return value
            false
        }
        .Binary(op, _, _, left, right) -> if op == {
            .And -> sema_contract_expr_proven(left, environment, program, context) && sema_contract_expr_proven(right, environment, program, context)
            .Or -> sema_contract_expr_proven(left, environment, program, context) || sema_contract_expr_proven(right, environment, program, context)
            .Eq | .Ne | .Lt | .Gt | .Le | .Ge -> {
                left_range: sema_contract_interval(left, environment, program) ?? return false
                right_range: sema_contract_interval(right, environment, program) ?? return false
                sema_contract_interval_comparison(op, left_range, right_range)
            }
            .Add | .Sub | .Mul | .Div | .FloorDiv | .Mod | .Rem | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Compare -> false
        }
        .CompareChain(operands, operators, _) -> {
            if operators.len() + 1 != operands.len() -> return false
            loop index in 0..<operators.len() {
                left_range: sema_contract_interval(operands[index], environment, program) ?? return false
                right_range: sema_contract_interval(operands[index + 1], environment, program) ?? return false
                if !sema_contract_interval_comparison(operators[index], left_range, right_range) -> return false
            }
            true
        }
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) -> false
    }
}

sema_contract_disposition: fn(condition: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables, context: SemaCheckContext) -> TContractDisposition Never! {
    if sema_contract_expr_proven(condition, environment, program, context) -> TContractDisposition.Proven else -> TContractDisposition.Check
}

// `site` is the clause's declared site (TContractSite).
sema_contract_make: fn(kind: TContractKind, condition: TExpr, message: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables, span: Span, location_span: Span, site: TContractSite, context: SemaCheckContext) -> TContract Never! {
    TContract{kind: kind, condition: condition, message: message, file: sema_contract_file(environment, program, location_span), line: sema_contract_line(environment, program, location_span), span: span, disposition: sema_contract_disposition(condition, environment, program, context), site: site}
}

// `owner` is the function owner key plus a `post` segment: a body local named
// `result` lives in the function frame itself, so the contract binding needs
// an identity of its own once both are lowered by symbol.
sema_contract_result_binding_symbol: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, owner: String, ty: Type, span: Span) -> Symbol Never! {
    result_owner: "{owner}/post"
    id: symbol_id(SymbolKind.Local, environment.module_identity, result_owner, "result")
    Symbol{id: id, kind: SymbolKind.Local, name: "result", module_name: environment.module_identity, owner: Val(result_owner), span: span, ty: Val(ty), visibility: 0}
}

sema_contract_check_function: fn(func: Func, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaContractDeclaration {
    declared_return := func.return_type
    if program.registration_graph == .Val(graph) && declared_return == .Val(declared) {
        declared_return = Val(sema_type_resolve_declared_with_generics(graph, declared, environment.module_identity, environment.generic_params))
    }
    result: sema_contract_result_for_function(declared_return, func.name_span, environment, program, sema_scope_function_owner_key(scopes))
    complete := true
    post := [TContract]{}
    pre := [TContract]{}
    // A parameter a condition reads is used (L0102).
    reads := [String:Bool]{}
    loop clause in func.pre {
        condition: sema_contract_check_expr(clause.cond, Type.Bool, "Pre", true, true, environment, program, scopes, state, reads, tail_store, context, diagnostics)
        if condition == None -> complete = false
        message: sema_contract_check_expr(clause.message_expr, Type.String, "Pre", false, false, environment, program, scopes, state, reads, tail_store, context, diagnostics)
        if message == None -> complete = false
        if condition == .Val(condition_value) && message == .Val(message_value) {
            site: sema_contract_site(environment.source_segments, environment.source_file, environment.source_origin, environment.module_identity, expr_span(clause.cond))
            pre.push(sema_contract_make(TContractKind.Pre, condition_value, message_value, environment, program, clause.span, clause.span, site, context))
        }
    }
    if func.post.len() > 0 {
        post_scopes := sema_scope_snapshot(scopes)
        post_state := sema_ownership_state_snapshot(state)
        owner: sema_scope_function_owner_key(scopes)
        sema_scope_enter(post_scopes, post_state, owner)
        result_symbol: sema_contract_result_binding_symbol(environment, program, owner, result.binding_ty, func.name_span)
        if {
            !sema_scope_declare_local(post_scopes, result_symbol, false, AccessConvention.Read, None, false) -> {
                diagnostics.push(sema_already_defined("result", func.name_span))
                complete = false
            }
            else -> {
                sema_ownership_declare_binding(post_state, result_symbol, false)
                loop clause in func.post {
                    condition: sema_contract_check_expr(clause.cond, Type.Bool, "Post", false, true, environment, program, post_scopes, post_state, reads, tail_store, context, diagnostics)
                    if condition == None -> complete = false
                    message: sema_contract_check_expr(clause.message_expr, Type.String, "Post", false, false, environment, program, post_scopes, post_state, reads, tail_store, context, diagnostics)
                    if message == None -> complete = false
                    // Each call decides a `#run` clause while building; the
                    // body checks none at run time.
                    if clause.required -> next
                    if condition == .Val(condition_value) && message == .Val(message_value) {
                        site: sema_contract_site(environment.source_segments, environment.source_file, environment.source_origin, environment.module_identity, expr_span(clause.cond))
                        post.push(sema_contract_make(TContractKind.Post, condition_value, message_value, environment, program, clause.span, clause.span, site, context))
                    }
                }
            }
        }
        sema_scope_leave(post_scopes, post_state)
    }
    loop (key, _) in reads -> state.used_keys[key] = true
    SemaContractDeclaration{complete: complete, post: post, pre: pre, result: result}
}

sema_contract_method_function_for_item: fn(item: Item, target: SymbolID, module_identity: String) -> Func? {
    if item == {
        .Struct(value) -> {
            loop method in value.methods {
                if symbol_id(SymbolKind.Function, module_identity, value.name, method.name).key == target.key -> return Val(method)
            }
        }
        .Enum(value) -> {
            loop method in value.methods {
                if symbol_id(SymbolKind.Function, module_identity, value.name, method.name).key == target.key -> return Val(method)
            }
        }
        .Impl(value) -> {
            loop method in value.methods {
                if symbol_id(SymbolKind.Function, module_identity, value.type_name, method.name).key == target.key -> return Val(method)
            }
        }
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    None
}

sema_contract_function_for_symbol: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, target: SymbolID) -> Func? {
    if program.registration_graph == .Val(graph) {
        declaration: sema_registration_callable_declaration(graph, target)
        if declaration != None -> return declaration
    }
    loop declaration_index in 0..<environment.declarations.len() {
        if environment.declarations[declaration_index].symbol_id.key == target.key {
            // copy: `value` is a payload of read parameter `environment`, which keeps the original; the Val carrier owns this one
            if environment.declarations[declaration_index].item == .Func(value) -> return Val(value.copy())
        }
        method: sema_contract_method_function_for_item(environment.declarations[declaration_index].item, target, environment.module_identity)
        if method != None -> return method
    }
    None
}

// What a call needs to know about its callee's contract, read from the
// declaration in place: a call checks clauses only when there are any `pre`
// or `#run` `post` ones (`call_checks` counts both), so it copies the
// callee's declaration (and its body) only then. A callee
// with a parameter `from` clause carries its parameter
// names and each parameter's `from` names; both are empty otherwise.
// `root_receiver`: the first parameter is `#Root`, so the callee also takes
// the receiver-first spelling (RootCalls.jet).
SemaContractCalleeFacts: struct {
    call_checks: Int
    is_pure: Bool
    root_receiver: Bool
    param_names: [String]
    param_view_from: [[String]?]
}

sema_contract_callee_facts: fn(func: Func) -> SemaContractCalleeFacts Never! {
    view_from := loop param in func.params {
        if param.declared_view_from_names != None -> break true
    } ?? false
    param_names := [String]{}
    param_view_from := [[String]?]{}
    if view_from {
        loop param in func.params {
            param_names.push(param.name)
            param_view_from.push(param.declared_view_from_names)
        }
    }
    call_checks := func.pre.len()
    loop clause in func.post {
        if clause.required -> call_checks += 1
    }
    SemaContractCalleeFacts{call_checks: call_checks, is_pure: func.is_pure, root_receiver: func.params.len() > 0 && func.params[0].root, param_names: param_names, param_view_from: param_view_from}
}

sema_contract_registered_facts: fn(graph: SemaRegistrationGraph, target: SymbolID) -> SemaContractCalleeFacts? {
    row: sema_registration_callable_row(graph, target.key) ?? return None
    if row == {
        .Function(module_index, index) -> Val(sema_contract_callee_facts(graph.modules[module_index].functions[index].declaration))
        .Foreign(_, _) -> None
        .NominalMethod(module_index, owner, index) -> Val(sema_contract_callee_facts(graph.modules[module_index].nominals[owner].methods[index].declaration))
        .ImplMethod(module_index, owner, index) -> Val(sema_contract_callee_facts(graph.modules[module_index].impls[owner].methods[index].declaration))
    }
}

sema_contract_method_facts_for_item: fn(item: Item, target: SymbolID, module_identity: String) -> SemaContractCalleeFacts? {
    if item == {
        .Struct(value) -> {
            loop method in value.methods {
                if symbol_id(SymbolKind.Function, module_identity, value.name, method.name).key == target.key -> return Val(sema_contract_callee_facts(method))
            }
        }
        .Enum(value) -> {
            loop method in value.methods {
                if symbol_id(SymbolKind.Function, module_identity, value.name, method.name).key == target.key -> return Val(sema_contract_callee_facts(method))
            }
        }
        .Impl(value) -> {
            loop method in value.methods {
                if symbol_id(SymbolKind.Function, module_identity, value.type_name, method.name).key == target.key -> return Val(sema_contract_callee_facts(method))
            }
        }
        .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
    }
    None
}

// The facts of the declaration `sema_contract_function_for_symbol` resolves
// `target` to (same lookup order), without copying it.
sema_contract_function_facts: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, target: SymbolID) -> SemaContractCalleeFacts? {
    if program.registration_graph == .Val(graph) {
        registered: sema_contract_registered_facts(graph, target)
        if registered != None -> return registered
    }
    loop declaration_index in 0..<environment.declarations.len() {
        if environment.declarations[declaration_index].symbol_id.key == target.key {
            if environment.declarations[declaration_index].item == .Func(value) -> return Val(sema_contract_callee_facts(value))
        }
        method: sema_contract_method_facts_for_item(environment.declarations[declaration_index].item, target, environment.module_identity)
        if method != None -> return method
    }
    None
}

// True when a call to `target` has clauses to check: `pre` ones, or `post`
// ones decided while building.
sema_contract_function_checks_calls: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, target: SymbolID) -> Bool Never! {
    facts: sema_contract_function_facts(environment, program, target) ?? return false
    facts.call_checks > 0
}

sema_contract_generated_argument_symbol: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, owner: String, index: Int, parameter_name: String, span: Span, ty: Type) -> Symbol Never! {
    name: "contract_arg_{span.start}_{index}"
    id: symbol_id(SymbolKind.Local, environment.module_identity, owner, name)
    Symbol{id: id, kind: SymbolKind.Local, name: parameter_name, module_name: environment.module_identity, owner: Val(owner), span: span, ty: Val(ty), visibility: 0}
}

sema_contract_pin_argument: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, owner: String, index: Int, parameter_name: String, convention: AccessConvention, argument: &TCallArg, call_span: Span, scopes: &SemaScopeTable, state: &SemaOwnershipState, bindings: &[TStmt]) -> TLocal Never! {
    original := argument.value
    init := original
    local := checked_generated_local("contract_arg_{call_span.start}_{index}", call_span, original.ty)
    local.mutable = argument.mut_borrow
    if argument.borrow || argument.mut_borrow {
        access: if argument.mut_borrow -> AccessConvention.Write else -> AccessConvention.Read
        init = sema_tree_node(original.ty, TExprKind.Borrow{place: init, access: access}, original.span)
        local.deref = true
    }
    symbol: sema_contract_generated_argument_symbol(environment, program, owner, index, parameter_name, call_span, original.ty)
    local = checked_symbol_local(local.name, local.span, symbol.id, original.ty)
    local.generated = true
    local.mutable = argument.mut_borrow
    local.deref = argument.borrow || argument.mut_borrow
    local_value: sema_tree_node(original.ty, TExprKind.Local{local: local}, original.span)
    replacement: if convention == AccessConvention.Move -> sema_tree_node(original.ty, TExprKind.Move{value: local_value}, original.span) else -> local_value
    argument.value = replacement
    bindings.push(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: init, gc_promotion: None, gc_transferred: false, span: call_span})
    sema_scope_declare_local(scopes, symbol, argument.mut_borrow, if argument.mut_borrow -> AccessConvention.Write else -> AccessConvention.Read, None, false)
    sema_ownership_declare_binding(state, symbol, false)
    local
}

// `target` is the callee's symbol: its clauses' declared sites are read in
// the callee's own module (sema_contract_pre_sites). `recall` is the call
// as written, which a `#Post` decided while building computes again.
sema_contract_check_call: fn(func: Func, target: SymbolID, recall: SemaContractRecall?, args: &[TCallArg], slots: [Int], call_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaContractCall? {
    any_required := false
    loop clause in func.pre {
        if clause.required -> any_required = true
    }
    required_post := false
    loop clause in func.post {
        if clause.required -> required_post = true
    }
    if func.pre.len() == 0 && !required_post -> return Val(SemaContractCall{bindings: [TStmt]{}, contracts: [TContract]{}})
    if required_post -> any_required = true
    if args.len() != slots.len() -> return None
    if func.params.len() == 0 && args.len() > 0 -> return None
    checked_scopes := sema_scope_snapshot(scopes)
    checked_state := sema_ownership_state_snapshot(state)
    owner: sema_scope_function_owner_key(scopes)
    sema_scope_enter(checked_scopes, checked_state, owner)
    bindings := [TStmt]{}
    loop index in 0..<args.len() {
        slot: slots[index]
        if slot < 0 || slot >= func.params.len() -> return None
        known: if any_required -> sema_expr_comptime_value(args[index].value, context) else -> None
        _ := sema_contract_pin_argument(environment, program, owner, index, func.params[slot].name, func.params[slot].convention, args[index], call_span, checked_scopes, checked_state, bindings)
        // A clause decided while building reads each argument the build knows.
        if known == .Val(value) {
            last: checked_scopes.bindings.len() - 1
            sema_scope_note_binding_edit(checked_scopes, last)
            checked_scopes.bindings[last].prepared = Val(value)
        }
    }
    contracts := [TContract]{}
    complete := true
    // Every call site checks its own copy of the callee's clauses.
    fresh_expr_ids: context.fresh_expr_ids
    context.fresh_expr_ids = true
    reads := [String:Bool]{}
    sites: sema_contract_pre_sites(environment, program, target, func)
    loop (clause_index, clause) in func.pre {
        // The declaration already reported `result` in this clause (E0144); checking
        // it again here would only add an unknown-name report for the same span.
        if sema_contract_result_ident_in_expr(clause.cond) != None {
            complete = false
            next
        }
        condition: sema_contract_check_expr(clause.cond, Type.Bool, "Pre", false, true, environment, program, checked_scopes, checked_state, reads, tail_store, context, diagnostics)
        if condition == None -> complete = false
        message: sema_contract_check_expr(clause.message_expr, Type.String, "Pre", false, false, environment, program, checked_scopes, checked_state, reads, tail_store, context, diagnostics)
        if message == None -> complete = false
        if clause.required {
            if condition != None && !sema_contract_required_holds("#Pre", func.name, clause, call_span, environment, program, checked_scopes, context, diagnostics) -> complete = false
            next
        }
        if condition == .Val(condition_value) && message == .Val(message_value) {
            contracts.push(sema_contract_make(TContractKind.Pre, condition_value, message_value, environment, program, call_span, call_span, sites[clause_index], context))
        }
    }
    // A `#Post` decided while building reads `result`: this call's own value.
    loop clause in func.post {
        if !clause.required -> next
        if !sema_contract_required_post_holds(func, clause, recall, call_span, environment, program, checked_scopes, checked_state, reads, tail_store, context, diagnostics) -> complete = false
    }
    context.fresh_expr_ids = fresh_expr_ids
    sema_scope_leave(checked_scopes, checked_state)
    if !complete -> return None
    Val(SemaContractCall{bindings: bindings, contracts: contracts})
}

// A `#run { cond }` clause of the marker written `marker` is decided for
// this call while building, by the one staged-value evaluator, over the
// pinned arguments. The first check stages it; the staged pass reads its
// answer. True needs no run-time check.
sema_contract_required_holds: fn(marker: String, callee: String, clause: ContractClause, call_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    source_span: expr_span(clause.cond)
    staged: sema_comptime_body_value_find(context, environment.module_identity, sema_scope_function_owner_key(scopes), source_span, call_span) ?? {
        _ := sema_comptime_body_capture(context, environment, program, scopes, marker, clause.cond, Type.Bool, source_span, call_span)
        return true
    }
    if staged.value == .Bool(answer) {
        if answer -> return true
        diagnostics.push(sema_error("E0180", call_span, "`{callee}`'s `{marker}` condition is false for this call while building", "the condition is written `#run {{ … }}`, so every call decides it while building from its arguments", "pass arguments that make the condition true, or drop `#run` so the condition is checked when the program runs"))
        return false
    }
    reason: sema_comptime_local_value_reason(staged.value) ?? "it has no `Bool` answer"
    sema_contract_required_unanswered(marker, callee, reason, call_span, diagnostics)
    false
}

sema_contract_required_unanswered: fn(marker: String, callee: String, reason: String, call_span: Span, diagnostics: &[Diagnostic]) Never! {
    diagnostics.push(sema_error("E0180", call_span, "`{callee}`'s `{marker}` condition has no answer for this call while building", "the condition is written `#run {{ … }}`, so every call decides it while building from its arguments, but {reason}", "pass arguments the build can read, or drop `#run` so the condition is checked when the program runs"))
}

// A `#Post` clause written `#run { cond }`, decided for this call while
// building. `result` is the call's own value: the staged-value evaluator
// computes `recall` again over the pinned arguments, keyed by the clause's
// span, and a later check decides `cond` with `result` holding that value.
// Until an answer lands the clause holds. True needs no run-time check.
sema_contract_required_post_holds: fn(func: Func, clause: ContractClause, recall: SemaContractRecall?, call_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, reads: &[String:Bool], tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    written: recall ?? {
        sema_contract_required_unanswered("#Post", func.name, "only a call by name is computed again while building, and this call goes through a method or a function value", call_span, diagnostics)
        return false
    }
    if sema_contract_result_mode(sema_effective_return_type(func.return_type), sema_contract_success_type(func.return_type)) != TContractResultMode.Direct {
        sema_contract_required_unanswered("#Post", func.name, "`result` names the success value of a call that can fail, which building does not compute", call_span, diagnostics)
        return false
    }
    owner: sema_scope_function_owner_key(scopes)
    staged_call: sema_comptime_body_value_find(context, environment.module_identity, owner, clause.span, call_span)
    has_call: staged_call != None
    if staged_call == .Val(call_value) {
        if sema_comptime_local_value_reason(call_value.value) == .Val(reason) {
            sema_contract_required_unanswered("#Post", func.name, "computing the call's own value fails: {reason}", call_span, diagnostics)
            return false
        }
    }
    sema_scope_enter(scopes, state, owner)
    result_symbol: sema_contract_result_binding_symbol(environment, program, owner, written.result_type, call_span)
    if !sema_scope_declare_local(scopes, result_symbol, false, AccessConvention.Read, None, false) {
        diagnostics.push(sema_already_defined("result", call_span))
        sema_scope_leave(scopes, state)
        return false
    }
    if staged_call == .Val(call_value) {
        last: scopes.bindings.len() - 1
        sema_scope_note_binding_edit(scopes, last)
        scopes.bindings[last].prepared = Val(call_value.value)
    }
    sema_ownership_declare_binding(state, result_symbol, false)
    condition: sema_contract_check_expr(clause.cond, Type.Bool, "Post", false, true, environment, program, scopes, state, reads, tail_store, context, diagnostics)
    message: sema_contract_check_expr(clause.message_expr, Type.String, "Post", false, false, environment, program, scopes, state, reads, tail_store, context, diagnostics)
    holds := condition != None && message != None
    if holds && !has_call {
        args: loop param in func.params -> CallArg{convention: AccessConvention.Read, expr: Expr.Ident{name: param.name, span: call_span, id: AST_NODE_GENERATED}, span: call_span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
        // copy: the staged call owns its type arguments; the call site keeps the written ones.
        again: Expr.Call{call: Call{name: written.call.name, name_span: written.call.name_span, type_args: written.call.type_args.copy(), args: args}, id: AST_NODE_GENERATED}
        _ := sema_comptime_body_capture(context, environment, program, scopes, "#Post", again, written.result_type, clause.span, call_span)
    }
    if holds && has_call -> holds = sema_contract_required_holds("#Post", func.name, clause, call_span, environment, program, scopes, context, diagnostics)
    sema_scope_leave(scopes, state)
    holds
}
