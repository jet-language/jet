use jet_foundation.[DataPlanCallable, DataPlanFact, DataPlanNodeId, DataPlanOperationKind, DataPlanPhysicalNode, DataPlanPhysicalOperatorKind, DataPlanSchema, DataPlanSchemaError, DataPlanSourceKind, DataPlanStreamError, DataPlanStreamMode, DataPlanValidationError, DataPlanLogicalNode, DataPlanColumn, Type, Span]

// Sema-owned graph facts accept only checked types/callables; no rows or predicates execute here.
// Rust: crates/jet-sema/src/Sema/DataPlan.rs:18
pub enum DataPlanCallKind {
    Scan(DataPlanSourceKind)
    Filter
    SortBy
    Collect
    InspectPlan
}
// Rust: crates/jet-sema/src/Sema/DataPlan.rs:28
pub fn classify_data_call(module: String, method: String) -> DataPlanCallKind? {
    if module != "core.data" -> return None
    if method == {
        "query" -> Val(DataPlanCallKind.Scan(DataPlanSourceKind.Table))
        "csv" -> Val(DataPlanCallKind.Scan(DataPlanSourceKind.Csv))
        "json" -> Val(DataPlanCallKind.Scan(DataPlanSourceKind.Json))
        "jsonl" -> Val(DataPlanCallKind.Scan(DataPlanSourceKind.Jsonl))
        "parquet" -> Val(DataPlanCallKind.Scan(DataPlanSourceKind.Parquet))
        "arrow" -> Val(DataPlanCallKind.Scan(DataPlanSourceKind.Arrow))
        "load" | "load_default" | "file" | "file_member" | "url" | "database" | "value" -> Val(DataPlanCallKind.Scan(DataPlanSourceKind.Loader))
        "csv_reader" -> Val(DataPlanCallKind.Scan(DataPlanSourceKind.CsvReader))
        "json_reader" -> Val(DataPlanCallKind.Scan(DataPlanSourceKind.JsonReader))
        else -> None
    }
}
// Rust: crates/jet-sema/src/Sema/DataPlan.rs:51
pub fn classify_data_receiver_call(receiver_types: [String], method: String) -> DataPlanCallKind? {
    if !receiver_types.any(fn(name) { name == "Query" }) -> return None
    if method == {
        "filter" -> Val(DataPlanCallKind.Filter)
        "sort_by" -> Val(DataPlanCallKind.SortBy)
        "collect" -> Val(DataPlanCallKind.Collect)
        "plan" -> Val(DataPlanCallKind.InspectPlan)
        else -> None
    }
}
// Rust: crates/jet-sema/src/Sema/DataPlan.rs:72
pub struct DataPlanBuilder {
    plan_fact: DataPlanFact
}
impl DataPlanBuilder {
    // Rust: crates/jet-sema/src/Sema/DataPlan.rs:77
    pub fn new(source: DataPlanSourceKind, schema: DataPlanSchema, span: Span) -> Self DataPlanBuildError! {
        schema.validate().map_err(DataPlanBuildError.Schema)!
        Self{plan_fact: DataPlanFact.scan(source, ^schema, span)}
    }
    // Rust: crates/jet-sema/src/Sema/DataPlan.rs:94
    pub fn from_fact(fact: DataPlanFact) -> Self DataPlanBuildError! {
        fact.validate().map_err(DataPlanBuildError.Validation)!
        Self{plan_fact: ^fact}
    }
    // Rust: crates/jet-sema/src/Sema/DataPlan.rs:100
    pub fn fact(self: &Self) -> &DataPlanFact { &self.plan_fact }
    // Rust: crates/jet-sema/src/Sema/DataPlan.rs:104
    pub fn current_node(self) -> DataPlanLogicalNode? { self.plan_fact.output_node() }
    // Rust: crates/jet-sema/src/Sema/DataPlan.rs:108
    pub fn current_node_id(self) -> DataPlanNodeId { self.plan_fact.output }
    // Rust: crates/jet-sema/src/Sema/DataPlan.rs:113
    pub fn filter(self: &Self, callable: DataPlanCallable, span: Span) -> DataPlanNodeId DataPlanBuildError! {
        &self.append_unary(DataPlanOperationKind.Filter, ^callable, span)!
    }
    // Rust: crates/jet-sema/src/Sema/DataPlan.rs:121
    pub fn sort_by(self: &Self, callable: DataPlanCallable, span: Span) -> DataPlanNodeId DataPlanBuildError! {
        &self.append_unary(DataPlanOperationKind.SortBy, ^callable, span)!
    }
    // Rust: crates/jet-sema/src/Sema/DataPlan.rs:132
    pub fn collect(self: &Self, span: Span) -> DataPlanNodeId DataPlanBuildError! {
        stream :: DataPlanStreamMode.materialized("explicit collect").map_err(DataPlanBuildError.Stream)!
        node :: self.current_node() ?? fail DataPlanBuildError.EmptyInput
        &self.append(DataPlanOperationKind.Collect, [self.current_node_id()], node.schema, None, ^stream, span)!
    }
    // Rust: crates/jet-sema/src/Sema/DataPlan.rs:152
    pub fn append_unary(self: &Self, operation: DataPlanOperationKind, callable: DataPlanCallable, span: Span) -> DataPlanNodeId DataPlanBuildError! {
        node :: self.current_node() ?? fail DataPlanBuildError.EmptyInput
        stream :: default_stream_for(operation)!
        &self.append(operation, [self.current_node_id()], node.schema, Val(^callable), ^stream, span)!
    }
    // Rust: crates/jet-sema/src/Sema/DataPlan.rs:176
    pub fn append(self: &Self, operation: DataPlanOperationKind, inputs: [DataPlanNodeId], schema: DataPlanSchema, callable: DataPlanCallable?, stream: DataPlanStreamMode, span: Span) -> DataPlanNodeId DataPlanBuildError! {
        schema.validate().map_err(DataPlanBuildError.Schema)!
        if inputs.is_empty() && operation != .Scan -> fail DataPlanBuildError.MissingInputs(operation)
        first_id :: inputs.first() ?? fail DataPlanBuildError.UnknownInput
        first_input :: self.plan_fact.logical.get(first_id.index()) ?? fail DataPlanBuildError.UnknownInput
        if callable == .Val(callback) {
            if callback.parameter != first_input.schema.row_type -> fail DataPlanBuildError.CallableParameter{operation: operation, expected: first_input.schema.row_type.name(), actual: callback.parameter.name()}
            expected :: if operation == { .Filter -> Val(Type.Bool) .SortBy -> Val(Type.String) else -> None }
            if expected == .Val(result_type) && callback.result != result_type -> fail DataPlanBuildError.CallableResult{operation: operation, expected: result_type.name(), actual: callback.result.name()}
        }
        id :: &self.plan_fact.append_logical(operation, ^inputs, ^schema, ^callable, stream, span)
        _ :: &self.plan_fact.append_physical(id, operation.default_physical_operator(), ^stream, "identity {operation.as_str()}")
        id
    }
    // Rust: crates/jet-sema/src/Sema/DataPlan.rs:238
    pub fn add_physical_choice(self: &Self, logical: DataPlanNodeId, operator: DataPlanPhysicalOperatorKind, stream: DataPlanStreamMode, reason: String) -> Unit DataPlanBuildError! {
        if logical.index() >= self.plan_fact.logical.len() -> fail DataPlanBuildError.UnknownInput
        trimmed := reason.trim() // #4303
        if trimmed.is_empty() -> fail DataPlanBuildError.MissingPhysicalReason
        _ :: &self.plan_fact.append_physical(logical, operator, ^stream, ^reason)
    }
    // Rust: crates/jet-sema/src/Sema/DataPlan.rs:256
    pub fn finish(self) -> DataPlanFact DataPlanBuildError! {
        self.plan_fact.validate().map_err(DataPlanBuildError.Validation)!
        ^self.plan_fact
    }
}
// Rust: crates/jet-sema/src/Sema/DataPlan.rs:264
fn default_stream_for(operation: DataPlanOperationKind) -> DataPlanStreamMode DataPlanBuildError! {
    if operation == .SortBy -> DataPlanStreamMode.materialized("sort_by requires ordering").map_err(DataPlanBuildError.Stream)!
    else -> DataPlanStreamMode.bounded(None).map_err(DataPlanBuildError.Stream)!
}
// Rust: crates/jet-sema/src/Sema/DataPlan.rs:275
#Error
pub enum DataPlanBuildError {
    Schema(DataPlanSchemaError)
    Stream(DataPlanStreamError)
    Validation(DataPlanValidationError)
    EmptyInput
    MissingInputs(DataPlanOperationKind)
    UnknownInput
    CallableParameter(operation: DataPlanOperationKind, expected: String, actual: String)
    CallableResult(operation: DataPlanOperationKind, expected: String, actual: String)
    MissingPhysicalReason
}
impl DataPlanBuildError {
    // Rust: crates/jet-sema/src/Sema/DataPlan.rs:296
    pub fn show(self) -> String {
        if self == {
            .Schema(error) -> error.show()
            .Stream(error) -> error.show()
            .Validation(error) -> error.show()
            .EmptyInput -> "table plan has no input frame"
            .MissingInputs(operation) -> "table plan `{operation.as_str()}` needs an input"
            .UnknownInput -> "table plan input node is unknown"
            .CallableParameter(operation, expected, actual) -> "table plan `{operation.as_str()}` callback takes {actual}, expected {expected}"
            .CallableResult(operation, expected, actual) -> "table plan `{operation.as_str()}` callback returns {actual}, expected {expected}"
            .MissingPhysicalReason -> "table plan physical choice needs a reason"
        }
    }
}
// Rust: crates/jet-sema/src/Sema/DataPlan.rs:333
pub fn scalar_schema(row_type: Type) -> DataPlanSchema {
    nullable :: if row_type == { .Option(_) -> true else -> false }
    DataPlanSchema.new(row_type, [DataPlanColumn.new("value", row_type).with_nullable(nullable)])
}
// Rust: crates/jet-sema/src/Sema/DataPlan.rs:343
pub fn callable_fact(label: String, parameter: Type, result: Type, span: Span) -> DataPlanCallable {
    DataPlanCallable.new(^label, ^parameter, ^result, span)
}
// Rust: crates/jet-sema/src/Sema/DataPlan.rs:354
pub fn physical_facts(fact: &DataPlanFact) -> &[DataPlanPhysicalNode] { &fact.physical }
