// Declaration-side signature projection. This preserves call obligations and
// default source identity while lowering parser Func metadata into foundation
// Type, rather than reconstructing it at call sites.
use jet_foundation.[
    AccessConvention,
    Call,
    CallContractRow,
    CallLabel,
    CallablePolicy,
    CallablePolicyChain,
    EffectRowEntry,
    Expr,
    Func,
    FunctionCallMetadata,
    FunctionDefaultRef,
    ParamZone,
    StrPart,
    SymbolID,
    Type,
    expr_span,
    failure_contract_effective_type,
    failure_contract_from_return_type,
    failure_contract_source,
    type_with_effective_fn_returns,
    ViewProvenanceMap,
]

fn sema_effective_return_type(return_type: Type?) -> Type Never! {
    // Imported declarations and local calls use the same canonical failure
    // projection; a written success type is not the callable's Result type.
    failure_contract_effective_type(failure_contract_from_return_type(return_type))
}

// These traits are raw protocol ABIs (String, Bool,
// Ordering, Dyn, and same-type arithmetic), never the implicit failure
// carrier, for user and derived impls alike (the Rust reference's
// `uses_raw_protocol_return`).
fn sema_raw_protocol_trait(trait_name: String?) -> Bool Never! {
    name :: trait_name ?? return false
    name == "Display" || name == "Debug" || name == "Encode" || name == "Decode" || name == "Equatable" || name == "Comparable" || name == "Add" || name == "Sub" || name == "Mul" || name == "Div" || name == "Iterable"
}

// Whether a trait-impl method keeps its declared return raw (the Rust
// reference's `uses_raw_protocol_function_return`).
fn sema_raw_protocol_function_return(trait_name: String?, implementation_generated: Bool, func: Func) -> Bool Never! {
    if sema_raw_protocol_trait(trait_name) -> return true
    func.compiler_generated && (implementation_generated || func.state_transition != None)
}

// A callable's checked return: a raw protocol return keeps its declared type
// (Unit when omitted); every other return projects through the failure rail
// (the Rust reference's `checked_return_types`).
fn sema_checked_return_type(return_type: Type?, raw_protocol_return: Bool) -> Type Never! {
    if raw_protocol_return -> return return_type ?? Type.Named{name: "Unit"}
    sema_effective_return_type(return_type)
}

// The stable provenance of a callable's effective failure route, projected
// from its written return type (the Rust reference's
// `FailureContract::from_return_type(..).source()`).
fn sema_failure_contract_source(return_type: Type?) -> String Never! {
    failure_contract_source(failure_contract_from_return_type(return_type))
}
// Guest.rs `export_signature`: failure inference's infallible rail is not
// a second Component value. Keep genuinely fallible and diverging returns.
fn sema_guest_export_value_type(return_type: Type?) -> Type? Never! {
    value :: return_type ?? return None
    if value == .Result(ok, err) && err == .Named(name) && name == "Never" {
        if ok == .Named(success_name) && success_name == "Never" -> return Val(value)
        return Val(ok)
    }
    Val(value)
}

fn sema_callable_policy_string_text(parts: [StrPart]) -> String Never! {
    if parts.len() != 1 -> return "<string>"
    if parts[0] == {
        .Lit(text) -> "\"{text}\""
        else -> "<string>"
    }
}

fn sema_callable_policy_call_text(call: Call) -> String Never! {
    args :: loop argument_index in 0..<call.args.len() -> sema_callable_policy_argument_text(call.args[argument_index].expr)
    "{call.name}({args.join(", ")})"
}

fn sema_callable_policy_argument_text(expr: Expr) -> String Never! {
    if expr == {
        .Str(parts, _, _) -> sema_callable_policy_string_text(parts)
        .Int(value, _, _, raw, _) -> raw ?? "{value}"
        .Float(value, _, _, raw, _) -> raw ?? "{value}"
        .Bool(value, _, _) -> "{value}"
        .Char(value, _, _) -> "'{value}'"
        .Ident(name, _, _) -> name
        .Field(base, member, _, _) -> "{sema_callable_policy_argument_text(base)}.{member}"
        .Call(call, _) -> sema_callable_policy_call_text(call)
        else -> "<expression>"
    }
}

fn sema_callable_policies(func: Func) -> CallablePolicyChain Never! {
    policies := [CallablePolicy]{}
    loop marker in func.markers {
        if marker.name == "Policy" {
            loop argument in marker.args {
                if argument == .Expr(value) {
                    if value == .Call(call, _) {
                        arguments :: loop call_argument in call.args -> sema_callable_policy_argument_text(call_argument.expr)
                        &policies.push(CallablePolicy{name: call.name, arguments: arguments})
                    }
                }
            }
        }
    }
    CallablePolicyChain{policies: policies}
}

fn sema_function_param_types(func: Func) -> [Type] Never! {
    params := [Type]{}
    loop parameter_index in 0..<func.params.len() {
        ty :: type_with_effective_fn_returns(func.params[parameter_index].ty)
        if func.params[parameter_index].variadic -> &params.push(Type.List{element: ty}) else -> &params.push(ty)
    }
    params
}

fn sema_function_param_contract(func: Func) -> [CallContractRow]? {
    contract := [CallContractRow]{}
    has_contract := false
    loop parameter_index in 0..<func.params.len() {
        label := func.params[parameter_index].name
        implicit_local_label :: func.params[parameter_index].zone == ParamZone.Either && func.params[parameter_index].public_label == None
        if func.params[parameter_index].public_label != None -> label = (func.params[parameter_index].public_label ?? CallLabel{name: "", span: func.params[parameter_index].name_span}).name
        if func.params[parameter_index].zone == ParamZone.PositionalOnly || implicit_local_label -> label = ""
        &contract.push(CallContractRow{label: label, zone: func.params[parameter_index].zone})
        if label != "" || func.params[parameter_index].zone != ParamZone.Either -> has_contract = true
    }
    if has_contract -> Val(contract) else -> None
}

fn sema_function_call_metadata(func: Func, owner: SymbolID, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> FunctionCallMetadata {
    names := [String]{}
    defaults := [FunctionDefaultRef?]{}
    variadic := [Bool]{}
    conventions := [AccessConvention]{}
    loop (index, parameter) in func.params {
        &names.push(parameter.name)
        &variadic.push(parameter.variadic)
        &conventions.push(parameter.convention)
        if parameter.default == {
            .Val(default_expr) -> {
                span :: expr_span(default_expr)
                source_file :: sema_source_file_at(source_segments, fallback_source_file, fallback_source_origin, span)
                &defaults.push(Val(FunctionDefaultRef{source_file: source_file, owner_key: owner.key, parameter_index: index, span: span}))
            }
            else -> &defaults.push(None)
        }
    }
    FunctionCallMetadata{
        names: names,
        defaults: defaults,
        variadic: variadic,
        conventions: conventions,
        policies: sema_callable_policies(func),
    }
}

// An inline foreign (`#FFI`) function has no Jet body and no failure rail:
// calls bind to its raw scalar ABI return, which codegen emits unwrapped (the
// Rust reference's `checked_return_types(.., sig.is_extern)` with
// `is_extern: f.inline_foreign.is_some()`).
fn sema_function_symbol_type(func: Func, raw_protocol_return: Bool, owner: SymbolID, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> Type {
    effect_bound :: if func.is_pure -> Val([EffectRowEntry]{}) else -> None
    Type.Fn{
        params: sema_function_param_types(func),
        ret: Val(sema_checked_return_type(func.return_type, raw_protocol_return || func.inline_foreign != None)),
        effect_bound: effect_bound,
        param_contract: sema_function_param_contract(func),
        call_metadata: Val(sema_function_call_metadata(func, owner, fallback_source_file, fallback_source_origin, source_segments)),
        return_view_provenance: sema_function_signature_view_provenance(func),
    }
}

// Rust `check_function_body` publishes a function's return-view contract on
// its signature; with a declared `from` clause callers see the declared
// sources with access taken from the return type's view
// leaves. Another module's caller reads this registered signature, so the
// declared contract is published here, before any body check runs.
fn sema_function_signature_view_provenance(func: Func) -> ViewProvenanceMap? {
    // copy: the signature publishes its own provenance map, while the inferred map stays on `func`
    // (a read parameter, the registered declaration).
    if func.return_view_provenance != None -> return func.return_view_provenance.copy()
    declared :: func.declared_return_view_provenance ?? return None
    mutable :: if func.return_type == .Val(ret) -> sema_ownership_is_window_type(ret) else -> false
    // copy: `published` gets its mutable flags rewritten, while the declared map stays on `func`,
    // the caller's registered declaration.
    published := declared.copy()
    loop index in 0..<published.entries.len() {
        if published.entries[index].slot.len() == 0 -> published.entries[index].value.mutable = mutable
    }
    Val(published)
}
