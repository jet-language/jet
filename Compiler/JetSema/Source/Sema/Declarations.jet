// Declaration-side signature projection. This preserves call obligations and
// default source identity while lowering parser Func metadata into foundation
// Type, rather than reconstructing it at call sites.

pub fn sema_effective_return_type(return_type: ?Type) -> Type {
    if return_type == None -> return Type.Result(Type.Named("Unit"), Type.Named("Err"))
    raw :: return_type ?? Type.Named("Unit")
    if raw == {
        .Named(name) -> if name == "Never" -> return raw
        .Option(_) -> return raw
        .Result(ok, err) -> {
            if err == {.Named(name) -> if name == "Never" -> return Type.Result(ok, err)}
            return raw
        }
        else -> {}
    }
    Type.Result(raw, Type.Named("Err"))
}

fn sema_callable_policy_string_text(parts: [StrPart]) -> String {
    if parts.len() != 1 -> return "<string>"
    if parts[0] == {
        .Lit(text) -> return "\"{text}\""
        else -> {}
    }
    "<string>"
}

fn sema_callable_policy_call_text(call: Call) -> String {
    args := [String]{}
    index := 0
    loop index < call.args.len() {
        args.push(sema_callable_policy_argument_text(call.args[index].expr))
        index += 1
    }
    "{call.name}({args.join(", ")})"
}

fn sema_callable_policy_argument_text(expr: Expr) -> String {
    if expr == {
        .Str(parts, _) -> sema_callable_policy_string_text(parts)
        .Int(value, _, _, raw) -> raw ?? "{value}"
        .Float(value, _, _, raw) -> raw ?? "{value}"
        .Bool(value, _) -> "{value}"
        .Char(value, _) -> "'{value}'"
        .Ident(name, _) -> name
        .Field(base, member, _) -> "{sema_callable_policy_argument_text(base)}.{member}"
        .Call(call) -> sema_callable_policy_call_text(call)
        else -> "<expression>"
    }
}

fn sema_callable_policies(func: Func) -> CallablePolicyChain {
    policies := [CallablePolicy]{}
    marker_index := 0
    loop marker_index < func.markers.len() {
        marker :: func.markers[marker_index]
        if marker.name == "Policy" {
            arg_index := 0
            loop arg_index < marker.args.len() {
                if marker.args[arg_index] == {
                    .Expr(value) -> {
                        if value == {
                            .Call(call) -> {
                                arguments := [String]{}
                                call_arg_index := 0
                                loop call_arg_index < call.args.len() {
                                    arguments.push(sema_callable_policy_argument_text(call.args[call_arg_index].expr))
                                    call_arg_index += 1
                                }
                                policies.push(CallablePolicy{name: call.name, arguments: arguments})
                            }
                        }
                    }
                }
                arg_index += 1
            }
        }
        marker_index += 1
    }
    CallablePolicyChain{policies: policies}
}

fn sema_function_param_types(func: Func) -> [Type] {
    params := [Type]{}
    index := 0
    loop index < func.params.len() {
        parameter :: func.params[index]
        ty :: type_with_effective_fn_returns(parameter.ty)
        if parameter.variadic -> params.push(Type.List(ty)) else -> params.push(ty)
        index += 1
    }
    params
}

fn sema_function_param_contract(func: Func) -> ?[CallContractRow] {
    contract := [CallContractRow]{}
    has_contract := false
    index := 0
    loop index < func.params.len() {
        parameter :: func.params[index]
        label := parameter.name
        implicit_local_label := parameter.zone == ParamZone.Either && parameter.public_label == None
        if parameter.public_label != None -> label = (parameter.public_label ?? CallLabel{name: "", span: parameter.name_span}).name
        if parameter.zone == ParamZone.PositionalOnly || implicit_local_label -> label = ""
        contract.push(CallContractRow{label: label, zone: parameter.zone})
        if label != "" || parameter.zone != ParamZone.Either -> has_contract = true
        index += 1
    }
    if has_contract -> return Val(contract)
    None
}

fn sema_function_call_metadata(func: Func, owner: SymbolId, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> FunctionCallMetadata {
    names := [String]{}
    defaults := [?FunctionDefaultRef]{}
    variadic := [Bool]{}
    conventions := [AccessConvention]{}
    index := 0
    loop index < func.params.len() {
        parameter :: func.params[index]
        names.push(parameter.name)
        variadic.push(parameter.variadic)
        conventions.push(parameter.convention)
        if parameter.default != None {
            default_expr :: parameter.default ?? Expr.Unit(span: parameter.name_span)
            span :: expr_span(default_expr)
            source_file :: sema_source_file_at(source_segments, fallback_source_file, fallback_source_origin, span)
            defaults.push(Val(FunctionDefaultRef{source_file: source_file, owner_key: owner.key, parameter_index: index, span: span}))
        } else {
            defaults.push(None)
        }
        index += 1
    }
    FunctionCallMetadata{
        names: names,
        defaults: defaults,
        variadic: variadic,
        conventions: conventions,
        policies: sema_callable_policies(func),
    }
}

pub fn sema_function_symbol_type(func: Func, owner: SymbolId, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> Type {
    effect_bound := None
    if func.is_pure -> effect_bound = Val([EffectRowEntry]{})
    Type.Fn(
        sema_function_param_types(func),
        Val(sema_effective_return_type(func.return_type)),
        effect_bound,
        sema_function_param_contract(func),
        Val(sema_function_call_metadata(func, owner, fallback_source_file, fallback_source_origin, source_segments)),
        func.return_view_provenance,
    )
}
