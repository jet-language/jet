// Declaration-side signature projection. This preserves call obligations and
// default source identity while lowering parser Func metadata into foundation
// Type, rather than reconstructing it at call sites.
use jet_foundation.[
    AccessConvention,
    Call,
    CallContractRow,
    CallLabel,
    CallablePolicy,
    CallablePolicyChain,
    EffectRowEntry,
    Expr,
    Func,
    FunctionCallMetadata,
    FunctionDefaultRef,
    ParamZone,
    StrPart,
    SymbolID,
    Type,
    expr_span,
    type_name,
    type_with_effective_fn_returns,
]

pub fn sema_effective_return_type(return_type: Type?) -> Type Never! {
    if return_type == None -> return Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "Err"}}
    raw :: return_type
    if raw == {
        .Named(name) -> if name == "Never" -> return raw
        .Option(_) -> return raw
        .Result(ok, err) -> {
            if err == .Named(name) && name == "Never" -> return Type.Result{ok: ok, err: err}
            return raw
        }
        else -> {}
    }
    Type.Result{ok: raw, err: Type.Named{name: "Err"}}
}

// The stable provenance of a callable's effective failure route, projected
// from its written return type (the Rust reference's
// `FailureContract::from_return_type(..).source()`).
pub fn sema_failure_contract_source(return_type: Type?) -> String Never! {
    declared :: return_type ?? return "implicit default !Err"
    if declared == {
        .Named(name) -> if name == "Never" -> return "declared Never return"
        .Option(_) -> return "optional success"
        .Result(_, error) -> {
            if error == .Named(name) && name == "Never" -> return "explicit !Never (proven unreachable)"
            return "explicit !{type_name(error)}"
        }
        else -> {}
    }
    "implicit default !Err"
}

fn sema_callable_policy_string_text(parts: [StrPart]) -> String Never! {
    if parts.len() != 1 -> return "<string>"
    if parts[0] == {
        .Lit(text) -> "\"{text}\""
        else -> "<string>"
    }
}

fn sema_callable_policy_call_text(call: Call) -> String Never! {
    args :: loop argument in call.args -> sema_callable_policy_argument_text(argument.expr)
    "{call.name}({args.join(", ")})"
}

fn sema_callable_policy_argument_text(expr: Expr) -> String Never! {
    if expr == {
        .Str(parts, _) -> sema_callable_policy_string_text(parts)
        .Int(value, _, _, raw) -> raw ?? "{value}"
        .Float(value, _, _, raw) -> raw ?? "{value}"
        .Bool(value, _) -> "{value}"
        .Char(value, _) -> "'{value}'"
        .Ident(name, _) -> name
        .Field(base, member, _) -> "{sema_callable_policy_argument_text(base)}.{member}"
        .Call(call) -> sema_callable_policy_call_text(call)
        else -> "<expression>"
    }
}

fn sema_callable_policies(func: Func) -> CallablePolicyChain Never! {
    policies := [CallablePolicy]{}
    loop marker in func.markers {
        if marker.name == "Policy" {
            loop argument in marker.args {
                if argument == .Expr(value) {
                    if value == .Call(call) {
                        arguments :: loop call_argument in call.args -> sema_callable_policy_argument_text(call_argument.expr)
                        &policies.push(CallablePolicy{name: call.name, arguments: arguments})
                    }
                }
            }
        }
    }
    CallablePolicyChain{policies: policies}
}

fn sema_function_param_types(func: Func) -> [Type] Never! {
    params := [Type]{}
    loop parameter in func.params {
        ty :: type_with_effective_fn_returns(parameter.ty)
        if parameter.variadic -> &params.push(Type.List{element: ty}) else -> &params.push(ty)
    }
    params
}

fn sema_function_param_contract(func: Func) -> [CallContractRow]? {
    contract := [CallContractRow]{}
    has_contract := false
    loop parameter in func.params {
        label := parameter.name
        implicit_local_label :: parameter.zone == ParamZone.Either && parameter.public_label == None
        if parameter.public_label != None -> label = (parameter.public_label ?? CallLabel{name: "", span: parameter.name_span}).name
        if parameter.zone == ParamZone.PositionalOnly || implicit_local_label -> label = ""
        &contract.push(CallContractRow{label: label, zone: parameter.zone})
        if label != "" || parameter.zone != ParamZone.Either -> has_contract = true
    }
    if has_contract -> Val(contract) else -> None
}

fn sema_function_call_metadata(func: Func, owner: SymbolID, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> FunctionCallMetadata {
    names := [String]{}
    defaults := [FunctionDefaultRef?]{}
    variadic := [Bool]{}
    conventions := [AccessConvention]{}
    loop (index, parameter) in func.params {
        &names.push(parameter.name)
        &variadic.push(parameter.variadic)
        &conventions.push(parameter.convention)
        if parameter.default == {
            .Val(default_expr) -> {
                span :: expr_span(default_expr)
                source_file :: sema_source_file_at(source_segments, fallback_source_file, fallback_source_origin, span)
                &defaults.push(Val(FunctionDefaultRef{source_file: source_file, owner_key: owner.key, parameter_index: index, span: span}))
            }
            else -> &defaults.push(None)
        }
    }
    FunctionCallMetadata{
        names: names,
        defaults: defaults,
        variadic: variadic,
        conventions: conventions,
        policies: sema_callable_policies(func),
    }
}

pub fn sema_function_symbol_type(func: Func, owner: SymbolID, fallback_source_file: String, fallback_source_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> Type {
    effect_bound :: if func.is_pure -> Val([EffectRowEntry]{}) else -> None
    Type.Fn{
        params: sema_function_param_types(func),
        ret: Val(sema_effective_return_type(func.return_type)),
        effect_bound: effect_bound,
        param_contract: sema_function_param_contract(func),
        call_metadata: Val(sema_function_call_metadata(func, owner, fallback_source_file, fallback_source_origin, source_segments)),
        return_view_provenance: func.return_view_provenance,
    }
}
