// A script's functions may use the script's variables: each such function
// takes the variables it reaches as extra parameters. Their types are the
// types the script's own statements give them, which only a check of the
// generated `run: fn` (sema_script_entry) knows, and a parameter is `&` when
// a check of the function's body finds it written.
use jet_foundation.[AST_NODE_GENERATED, ASTTables, AccessConvention, BodyTree, DIAGNOSTIC_ERROR, DeclID, Diagnostic, Expr, ExprNode, FnBody, Func, Interner, Item, ModuleID, Span, Symbol, SymbolKind, TEffectSpan, TFuncKind, TLocal, TTypeDef, TypeKind, Type, ast_expr, ast_visit_body, body_node, body_stmt, body_tree_remap_types, body_type_id, checked_builtin_mutates_receiver, compiler_transfer_rows, decl_table_add, decl_table_index, delta_has_rows, diagnostic_with_label, interner_empty, interner_merge_delta, module_text, name_table_sized, symbol_is_local, symbol_key_text, symbol_local_keys_text, type_kind]

// A script variable as the script's own statements bind it: its checked type,
// and whether it is a `:=` binding a function may change.
SemaScriptVariable: struct {
    ty: Type,
    mutable: Bool,
}

// A check of one module's functions against one declaration pass, whose
// reports are dropped.
SemaScriptProbe: struct {
    module_index: Int,
    environment: SemaScopeEnvironment,
    program: SemaProgramTables,
    scopes: SemaScopeTable,
}

// Each script variable in `names` that the entry's top-level statements bind,
// from one check of the entry's generated `run: fn` against the declaration
// pass `stage`. The check's reports are dropped: a call to a function whose
// extra parameters aren't written yet is refused there, and the real check
// reports it. A name whose binding didn't check has no row. `stage` is the
// probe's own and is used up.
sema_script_entry_local_types: fn(stage: &&SemaComptimeDeclarationStage, names: [String]) -> [String:SemaScriptVariable] {
    found := [String:SemaScriptVariable]{}
    probe := sema_script_probe_open(stage) ?? return found
    function: sema_script_probe_check(probe, "run") ?? return found
    sema_script_entry_bound_types(function, names, found)
    found
}

// For each function of the entry named in `candidates`, the extra parameters
// among its candidates that its checked body writes itself. The declaration
// pass `stage` registers each candidate as `&`, so a write checks; one the
// body only reads becomes a read parameter. A parameter a call passes on to
// another script function's parameter is not written here: the caller
// chains the callee's writes. `stage` is used up.
sema_script_helper_writes: fn(stage: &&SemaComptimeDeclarationStage, candidates: [String:[String]]) -> [String:[String]] {
    written := [String:[String]]{}
    probe := sema_script_probe_open(stage) ?? return written
    loop (helper, names) in candidates {
        function: sema_script_probe_check(probe, helper) ?? next
        passed: sema_script_passed_on(function.tree)
        writes := [String]{}
        loop parameter in function.params {
            // copy: the checked body keeps its parameter's name; the answer holds its own
            if names.contains(parameter.name) && sema_script_body_writes(function.tree, parameter.local, passed) {
                writes.push(parameter.name.copy())
            }
        }
        // copy: `candidates` keeps its key
        written[helper.copy()] = writes
    }
    written
}

sema_script_probe_open: fn(stage: &&SemaComptimeDeclarationStage) -> SemaScriptProbe? {
    declarations := stage
    taken := declarations.graph.move()
    declarations.graph = None
    graph := taken.move() ?? return None
    entry: graph.entry_module_identity
    sema_script_probe_over(graph, declarations.modules, entry)
}

// A probe of the module `module_identity` of `graph`. The program's types
// come from `modules`, a declaration pass's or a check's. The probe takes
// the graph and those rows.
sema_script_probe_over: fn(graph: &&SemaRegistrationGraph, modules: &[SemaGraphModuleResult], module_identity: ModuleID) -> SemaScriptProbe? {
    module_index: sema_registration_module_index(graph, module_identity) ?? return None
    types := [TTypeDef]{}
    loop row in 0..<modules.len() {
        compiler_transfer_rows<TTypeDef>(types, modules[row].declarations.type_defs)
    }
    environment := sema_check_pass_environment(graph, types, SemaComptimeBodyValues{})
    program := SemaProgramTables{
        registration_graph: environment.registration_graph.move(),
        checked_types: environment.checked_types.move(),
        checked_type_names: environment.checked_type_names.move(),
        checked_type_name_rows: environment.checked_type_name_rows.move(),
        boxed_edges: environment.boxed_edges.move(),
        copy_facts: environment.copy_facts.move(),
    }
    environment.registration_graph = None
    environment.checked_types = [TTypeDef]{}
    environment.checked_type_names = name_table_sized(2)
    environment.checked_type_name_rows = [[Int]]{}
    environment.boxed_edges = [U32:[String]]{}
    environment.copy_facts = sema_copy_facts_table_empty()
    scopes := sema_check_module_summary_scope_init(environment, program, module_index)
    sema_scope_environment_enter_module(environment, program, module_index, SemaComptimeBodyValues{})
    Val(SemaScriptProbe{module_index: module_index, environment: environment, program: program, scopes: scopes})
}

// The probe moved to the module `module_identity`, whose scope its next
// checks read: false when its graph has no such module.
sema_script_probe_enter: fn(probe: &SemaScriptProbe, module_identity: ModuleID) -> Bool {
    found := Int?{None}
    if probe.program.registration_graph == .Val(graph) {
        found = sema_registration_module_index(graph, module_identity)
    }
    module_index: found ?? return false
    if module_index == probe.module_index -> return true
    probe.scopes = sema_check_module_summary_scope_init(probe.environment, probe.program, module_index)
    sema_scope_environment_enter_module(probe.environment, probe.program, module_index, SemaComptimeBodyValues{})
    probe.module_index = module_index
    true
}

// The checked body of the entry's top-level function `name`.
sema_script_probe_check: fn(probe: &SemaScriptProbe, name: String) -> FnBody? {
    graph: probe.program.registration_graph ?? return None
    item_index: sema_script_entry_function_item(graph.modules[probe.module_index].program.items, name) ?? return None
    job: SemaBodyJob.TopLevel{item_index: item_index}
    owner_id: sema_check_registered_function_id(job, probe.module_index, probe.environment, probe.program)
    dropped := [Diagnostic]{}
    calls := [SemaCallSiteFact]{}
    requests := [SemaComptimeRequest]{}
    references := [SemaNameReferenceFact]{}
    checked := sema_function_check_registered(job, probe.module_index, sema_function_memory_plan_new(), None, owner_id, TFuncKind.TopLevel, false, probe.environment, probe.program, probe.scopes, None, dropped, calls, requests, references)
    function := checked.value.move() ?? return None
    sema_script_probe_merge_types(probe, function)
    Val(function.move())
}

// The type rows the probe's last check interned (its scopes' type delta,
// sema_function_check_pass) merged into the held graph's interner, with
// `function`, that check's body, renumbered to name them there.
sema_script_probe_merge_types: fn(probe: &SemaScriptProbe, function: &FnBody) Never! {
    delta := probe.scopes.type_delta.pop() ?? return
    if &probe.program.registration_graph == .Val(graph) {
        if delta_has_rows(delta) {
            remap: interner_merge_delta(graph.interner, delta.move())
            body_tree_remap_types(function.tree, remap)
        }
    }
}

// A function no registration holds, checked by a probe
// (sema_script_probe_check_func): its checked body, None when the check
// couldn't make one, the check's reports, whether it finished, and what its
// body propagates (SemaFunctionFailureFacts), which no failure solve reads:
// the body keeps its declared carrier (sema_eval_held_failure_settle).
SemaScriptProbeChecked: struct {
    function: FnBody?,
    diagnostics: [Diagnostic],
    complete: Bool,
    failure: SemaFunctionFailureFacts?{None},
}

// `func`, a top-level function of the probe's module that no registration
// holds (the debugger's expression), checked against the probe's
// declarations. It is bound by its name span, with no id, in the module
// scope under a rollback mark that drops it after its check, as a function
// body is checked in place (sema_function_check), so the probe checks the
// next one as it did this one with no copy of the scope. Its reports are
// kept. A name the module already binds is not checked. No effect pass runs
// over it: its own effects and the functions it calls are gathered from its
// calls, as a lambda's are (sema_expression_lambda_add_call_effects).
sema_script_probe_check_func: fn(probe: &SemaScriptProbe, func: Func) -> SemaScriptProbeChecked {
    diagnostics := [Diagnostic]{}
    module_name: sema_scope_environment_module_text(probe.environment, probe.program)
    key: symbol_key_text(SymbolKind.Function, module_name, "", func.name)
    symbol := sema_script_probe_symbol(probe, func, key) ?? return SemaScriptProbeChecked{function: None, diagnostics: diagnostics, complete: false}
    mark: sema_scope_mark(probe.scopes)
    if !sema_scope_add_module_symbol(probe.scopes, symbol, key) {
        sema_scope_rollback(probe.scopes, mark)
        return SemaScriptProbeChecked{function: None, diagnostics: diagnostics, complete: false}
    }
    call_facts := [SemaCallSiteFact]{}
    requests := [SemaComptimeRequest]{}
    references := [SemaNameReferenceFact]{}
    checked := sema_function_check_shared(func, key, TFuncKind.TopLevel, false, probe.environment, probe.program, probe.scopes, None, diagnostics, call_facts, requests, references)
    sema_scope_rollback(probe.scopes, mark)
    function := checked.value.move() ?? return SemaScriptProbeChecked{function: None, diagnostics: diagnostics, complete: false}
    sema_script_probe_merge_types(probe, function)
    sema_script_probe_call_effects(probe.program, function, call_facts)
    SemaScriptProbeChecked{function: Val(function.move()), diagnostics: diagnostics, complete: checked.complete, failure: checked.failure.move()}
}

// The debugger's answer (EvalProbe.jet) for `expression`, parsed at `at` in
// the generated coordinates of the probe's module, where a frame stopped:
// the function of the module whose body holds `at`, the innermost of its
// top-level functions and the methods its check checks
// (sema_check_method_jobs), checked again against the probe's
// declarations as the program's check checked it, with the probe asked
// there. So the expression checks on that check's ownership state at the
// stop, as a compile of the program with the probe would, and nothing else
// is checked. `plan` is the program's memory plan
// (sema_function_memory_plan_from_graph), whose rewrite of a function is
// the body its check reads. The answer of a node starting at `at`, else of
// the statement it lies in; None when no function holds `at` or none
// answers.
sema_script_probe_answer: fn(probe: &SemaScriptProbe, plan: SemaFunctionMemoryPlan, at: Int, expression: &&Expr) -> SemaEvalProbeAnswer? {
    module_index: probe.module_index
    found := SemaBodyJob?{None}
    if probe.program.registration_graph == .Val(graph) {
        found = sema_script_probe_job(graph, module_index, at)
    }
    job: found ?? return None
    if &probe.program.registration_graph == .Val(graph) {
        asked := SemaEvalProbe{module_identity: graph.modules[module_index].module_identity, offset: at, expressions: [Expr]{expression.move()}}
        graph.eval_probes = Val(sema_eval_probes([SemaEvalProbe]{asked.move()}))
    }
    checked := sema_script_probe_recheck(probe, plan, job)
    if &probe.program.registration_graph == .Val(graph) -> graph.eval_probes = None
    chosen := SemaEvalProbeAnswer?{None}
    loop answer in checked.eval_answers.move() {
        if chosen == None || answer.exact -> chosen = Val(answer)
    }
    chosen
}

// The check of the probe's module's function `job` again
// (sema_script_probe_answer), its reports and facts dropped. A method
// checks with its owner's generic parameters, as the program's check
// prepares it (sema_check_registration_method).
sema_script_probe_recheck: fn(probe: &SemaScriptProbe, plan: SemaFunctionMemoryPlan, job: SemaBodyJob) -> SemaFunctionResult {
    module_index: probe.module_index
    owner_id: sema_check_registered_function_id(job, module_index, probe.environment, probe.program)
    position: sema_check_registered_memory_position(job, module_index, plan, probe.environment, probe.program)
    dropped := [Diagnostic]{}
    calls := [SemaCallSiteFact]{}
    requests := [SemaComptimeRequest]{}
    references := [SemaNameReferenceFact]{}
    if job == .TopLevel(_) {
        return sema_function_check_registered(job, module_index, plan, position, owner_id, TFuncKind.TopLevel, false, probe.environment, probe.program, probe.scopes, None, dropped, calls, requests, references)
    }
    input: sema_check_method_input(job, module_index, plan, position, probe.environment, probe.program)
    raw: sema_check_registered_raw_protocol_return(job, module_index, probe.environment, probe.program)
    sema_function_check_registered_on_thread(job, module_index, plan, input.memory_position, owner_id, input.function_kind, raw, input.generic_params, probe.environment, probe.program, probe.scopes, None, dropped, calls, requests, references)
}

// The job of the function of `graph`'s module `module_index` whose body
// holds `at`, the innermost (sema_script_probe_answer). A body the compiler
// generated has no stop of its own (sema_eval_walk_open).
sema_script_probe_job: fn(graph: SemaRegistrationGraph, module_index: Int, at: Int) -> SemaBodyJob? {
    found := SemaBodyJob?{None}
    width := -1
    loop (index, item) in graph.modules[module_index].program.items {
        if item == .Func(func) {
            if !func.compiler_generated && func.external_type == None && sema_script_probe_inside(func.span, at, width) {
                found = Val(SemaBodyJob.TopLevel{item_index: index})
                width = func.span.end - func.span.start
            }
        }
    }
    scanned := 0
    loop job in sema_check_method_jobs(graph, graph.modules[module_index], scanned, false) {
        if job == {
            .NominalMethod(_, owner, row) -> {
                if sema_script_probe_method_inside(graph.modules[module_index].nominals[owner].methods[row].declaration, at, width) {
                    found = Val(job)
                    width = graph.modules[module_index].nominals[owner].methods[row].declaration.span.end - graph.modules[module_index].nominals[owner].methods[row].declaration.span.start
                }
            }
            .ImplMethod(_, owner, row) -> {
                if sema_script_probe_method_inside(graph.modules[module_index].impls[owner].methods[row].declaration, at, width) {
                    found = Val(job)
                    width = graph.modules[module_index].impls[owner].methods[row].declaration.span.end - graph.modules[module_index].impls[owner].methods[row].declaration.span.start
                }
            }
            .TopLevel(_) -> {}
        }
    }
    found
}

sema_script_probe_method_inside: fn(declaration: Func, at: Int, width: Int) -> Bool Never! {
    !declaration.compiler_generated && sema_script_probe_inside(declaration.span, at, width)
}

// Whether `span` holds `at` and is narrower than `width` (-1: none yet).
sema_script_probe_inside: fn(span: Span, at: Int, width: Int) -> Bool Never! {
    at >= span.start && at < span.end && (width < 0 || span.end - span.start < width)
}

// The module scope's symbol of `func`, a top-level function of the probe's
// module keyed `key`, with no id.
sema_script_probe_symbol: fn(probe: SemaScriptProbe, func: Func, key: String) -> Symbol? {
    symbol := sema_item_symbol(Item.Func{value: func}, probe.environment.module_identity, sema_scope_environment_module_text(probe.environment, probe.program), probe.environment.source_file, probe.environment.source_origin, probe.environment.source_segments) ?? return None
    symbol.ty = Val(sema_function_symbol_type(func, false, key, probe.environment.source_file, probe.environment.source_origin, probe.environment.source_segments))
    Val(symbol)
}

// The effects of `function`, a probe's check, from its calls `call_facts`:
// no effect pass runs over it, so its own effects and the functions it
// calls are gathered as a lambda's are (sema_expression_lambda_add_call_effects).
sema_script_probe_call_effects: fn(program: SemaProgramTables, function: &FnBody, call_facts: [SemaCallSiteFact]) Never! {
    direct := [String]{}
    edges := [String]{}
    spans := [TEffectSpan]{}
    maximal := false
    loop fact in call_facts {
        callee_key := String?{None}
        if fact.callee == .Val(callee) {
            callee_key = Val(if symbol_is_local(callee) -> symbol_local_keys_text(function.tree.symbols, callee) else -> sema_program_symbol_key(program, callee))
        }
        sema_expression_lambda_add_call_effects(fact, callee_key, direct, edges, spans, maximal)
    }
    function.effects.direct = direct.move()
    function.effects.call_edges = edges.move()
    function.effects.direct_spans = spans.move()
    function.effects.maximal = maximal
}

// A function a probe appended to its module (sema_script_probe_append):
// its checked body and the declaration a call of it names.
SemaScriptProbeAppended: struct {
    function: FnBody,
    decl: DeclID,
}

// `item`, a top-level function of the program's source that the probe's
// module lacks (a held check of the program's cut left it out, and the
// debugger's expression calls it), registered in the module, checked
// against the probe's declarations and kept as the program's registration
// and check keep its functions: the module's scope binds it and a call of
// it names its declaration. It is kept only when its check is clean, it
// is pure against the held program's checked `functions` (rows `by_key`,
// sema_eval_held_rows) as they were solved (sema_script_probe_pure), and,
// with no written failure contract, the failure solve would make it
// infallible (sema_eval_held_failure_settle). Each function it calls must
// be held already: a call of one with no declaration, itself included,
// doesn't check. Otherwise the module is left as it was, and None.
sema_script_probe_append: fn(probe: &SemaScriptProbe, item: &&Item, functions: [FnBody], by_key: SemaEvalHeldRows) -> SemaScriptProbeAppended? {
    module_index: probe.module_index
    taken := item.move()
    candidate := false
    name := ""
    key := ""
    symbol := Symbol?{None}
    if taken == .Func(func) {
        if func.external_type != None || func.type_params.len() > 0 -> return None
        candidate = sema_failure_inference_candidate(func)
        name = "{func.name}"
        key = symbol_key_text(SymbolKind.Function, sema_scope_environment_module_text(probe.environment, probe.program), "", func.name)
        symbol = sema_script_probe_symbol(probe, func, key)
    }
    scoped := symbol.move() ?? return None
    // The function registers in the module in place, as a minted failure
    // union does (sema_failure_union_mint).
    mark := SemaGraphModuleMark?{None}
    item_index := -1
    if &probe.program.registration_graph == .Val(graph) {
        // A call names the declaration row its callable row shares
        // (sema_registration_index_callables).
        if graph.decls.rows.len() != graph.callables.len() -> return None
        marked: sema_graph_module_mark(graph.modules[module_index])
        registered := [Diagnostic]{}
        registered_module: module_text(graph.module_table, graph.modules[module_index].module_identity)
        added: sema_registration_add_root(graph.modules[module_index], registered_module, graph.symbols, taken, probe.environment.source_file, probe.environment.source_origin, probe.environment.source_segments, registered)
        if !added || registered.len() > 0 {
            sema_graph_module_rollback(graph.modules[module_index], marked, name)
            return None
        }
        graph.modules[module_index].program.items.push(taken.move())
        item_index = graph.modules[module_index].program.items.len() - 1
        mark = Val(marked)
    }
    mark_at: mark ?? return None
    job: SemaBodyJob.TopLevel{item_index: item_index}
    owner_id: sema_check_registered_function_id(job, module_index, probe.environment, probe.program)
    scoped.id = owner_id
    // A registered body checks only when the module scope binds it as
    // itself (sema_function_check_unregistered).
    scope_mark: sema_scope_mark(probe.scopes)
    if !sema_scope_add_module_symbol(probe.scopes, scoped, key) {
        return sema_script_probe_unappend(probe, module_index, mark_at, scope_mark, name)
    }
    diagnostics := [Diagnostic]{}
    calls := [SemaCallSiteFact]{}
    requests := [SemaComptimeRequest]{}
    references := [SemaNameReferenceFact]{}
    checked := sema_function_check_registered(job, module_index, sema_function_memory_plan_new(), None, owner_id, TFuncKind.TopLevel, false, probe.environment, probe.program, probe.scopes, None, diagnostics, calls, requests, references)
    function := checked.value.move() ?? return sema_script_probe_unappend(probe, module_index, mark_at, scope_mark, name)
    sema_script_probe_merge_types(probe, function)
    if !checked.complete || requests.len() > 0 || sema_script_probe_failed(diagnostics) {
        return sema_script_probe_unappend(probe, module_index, mark_at, scope_mark, name)
    }
    sema_script_probe_call_effects(probe.program, function, calls)
    sema_eval_held_failure_settle(function, candidate, checked.failure.move(), functions, by_key)
    pure := false
    if probe.program.registration_graph == .Val(graph_ro) {
        pure = sema_script_probe_pure(graph_ro.interner, function, functions, by_key)
    } else if probe.program.interner == .Val(fallback) {
        pure = sema_script_probe_pure(fallback, function, functions, by_key)
    } else {
        pure = sema_script_probe_pure(interner_empty(), function, functions, by_key)
    }
    if (candidate && function.failure_carrier != .Infallible) || !pure {
        return sema_script_probe_unappend(probe, module_index, mark_at, scope_mark, name)
    }
    decl := DeclID?{None}
    if &probe.program.registration_graph == .Val(held) {
        row: held.modules[module_index].functions.len() - 1
        decl = Val(decl_table_add(held.decls, held.modules[module_index].functions[row].symbol))
        decl_table_index(held.decls)
        held.callables.push(SemaRegistrationCallableRow.Function{module_index: module_index, row: row})
    }
    id: decl ?? panic("a probe's append lost its registration")
    Val(SemaScriptProbeAppended{function: function.move(), decl: id})
}

// Gives back the probe's module `module_index` as it was at `mark`, and its
// scopes as they were at `scope_mark`, before an append of the function
// `name` (sema_script_probe_append): None.
sema_script_probe_unappend: fn(probe: &SemaScriptProbe, module_index: Int, mark: SemaGraphModuleMark, scope_mark: SemaScopeMark, name: String) -> SemaScriptProbeAppended? {
    sema_scope_rollback(probe.scopes, scope_mark)
    if &probe.program.registration_graph == .Val(graph) {
        sema_graph_module_rollback(graph.modules[module_index], mark, name)
    }
    None
}

// Whether the reports `diagnostics` hold an error.
sema_script_probe_failed: fn(diagnostics: [Diagnostic]) -> Bool Never! {
    loop diagnostic in diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> return true
    }
    false
}

// Whether `function`, a probe's check, is pure as the held program's checked
// `functions` (rows `by_key`) were solved: the debugger's verdict on an
// expression refuses nothing it does or calls
// (sema_eval_held_effect_refusals), it writes no module state, and it
// takes no function as a value, a trait value's method included, which
// only the effect pass's value edges would follow.
sema_script_probe_pure: fn(interner: Interner, function: FnBody, functions: [FnBody], by_key: SemaEvalHeldRows) -> Bool {
    if function.effects.module_writes.len() > 0 || sema_eval_held_effect_refusals(function, functions, by_key, function.source_span).len() > 0 {
        return false
    }
    loop node in function.tree.nodes {
        if node.kind == .FnValue(_) -> return false
        if node.kind == .ConstRef(_) && type_kind(interner, body_type_id(function.tree, node.id)) == TypeKind.Fn {
            return false
        }
        if node.kind == .MethodCall(receiver, _, _, _) {
            if type_kind(interner, body_type_id(function.tree, receiver)) == TypeKind.TraitObject -> return false
        }
    }
    true
}

// The row of the top-level function `name` among an entry file's items.
sema_script_entry_function_item: fn(items: [Item], name: String) -> Int? Never! {
    loop (index, item) in items {
        if item == .Func(function) && function.name == name && function.external_type == None {
            return Val(index)
        }
    }
    None
}

// Each top-level binding of `function` named in `names`.
sema_script_entry_bound_types: fn(function: FnBody, names: [String], found: &[String:SemaScriptVariable]) Never! {
    loop index in function.body {
        if body_stmt(function.tree, index) == .Let(local, _, _, _, _, _) {
            if names.contains(local.name) {
                found[local.name] = SemaScriptVariable{ty: local.ty, mutable: local.mutable}
            }
        }
    }
}

// Whether `tree` writes a place rooted at `parameter`: an assignment, or a
// write borrow (a `&` argument, a changing method's receiver, a written
// index), a changing built-in method's receiver (`words.push(…)`), lambdas
// included. The reads in `passed` don't count.
sema_script_body_writes: fn(tree: BodyTree, parameter: TLocal, passed: [Int]) -> Bool Never! {
    loop statement in tree.stmts {
        if statement == .Assign(place, _, _, _, _) {
            if place == {
                .Local(local) -> {
                    if sema_script_same_local(local, parameter) -> return true
                }
                .Expr(value) -> {
                    if sema_script_place_rooted_at(tree, value, parameter, passed) -> return true
                }
            }
        }
    }
    loop node in tree.nodes {
        if node.kind == .Borrow(place, access) && access == AccessConvention.Write && sema_script_place_rooted_at(tree, place, parameter, passed) {
            return true
        }
        if node.kind == .Index(base, _, _, access, _, _) && access == AccessConvention.Write && sema_script_place_rooted_at(tree, base, parameter, passed) {
            return true
        }
        if node.kind == .BuiltinMethod(receiver, operation, _) && checked_builtin_mutates_receiver(operation) && sema_script_place_rooted_at(tree, receiver, parameter, passed) {
            return true
        }
    }
    false
}

// The reads of a script variable a call passes on as another script
// function's default: the call reads each at its own name
// (sema_script_variable_default), so the read carries the call's span.
sema_script_passed_on: fn(tree: BodyTree) -> [Int] Never! {
    passed := [Int]{}
    loop node in tree.nodes {
        if node.kind == .Call(_, _, args) {
            loop argument in args {
                at := argument.value
                if body_node(tree, at).kind == .Borrow(place, _) -> at = place
                read: body_node(tree, at)
                if read.kind == .Local(_) && read.span.start == node.span.start && read.span.end == node.span.end {
                    passed.push(at)
                }
            }
        }
    }
    passed
}

// Whether node `id` is a place whose root local is `parameter`, other than a
// read in `passed`. A place's chain is no longer than the tree.
sema_script_place_rooted_at: fn(tree: BodyTree, id: Int, parameter: TLocal, passed: [Int]) -> Bool Never! {
    at := id
    loop _ in 0..<tree.nodes.len() {
        node: body_node(tree, at)
        if node.kind == .Local(local) {
            return !passed.contains(at) && sema_script_same_local(local, parameter)
        }
        if node.kind == .Field(receiver, _) -> at = receiver else if node.kind == .Index(base, _, _, _, _, _) {
            at = base
        } else if node.kind == .Borrow(place, _) { at = place } else { return false }
    }
    false
}

// A function's own local of a parameter's name is another binding: the
// parameter's span is where it was declared.
sema_script_same_local: fn(local: TLocal, parameter: TLocal) -> Bool Never! {
    local.name == parameter.name && local.span.start == parameter.span.start && local.span.end == parameter.span.end
}

// What one script function's body uses: the script variables it names and
// the rows of the script functions it calls or names.
SemaScriptUses: struct {
    variables: [String],
    functions: [Int],
}

// Whether `function` is a script function, which may take script variables:
// a top-level function of the entry script but `run`. A method is none.
sema_script_function: fn(function: Func) -> Bool Never! {
    function.name != "run" && function.external_type == None
}

// The names of the script functions among an entry script's items, in item
// order: a function's row in the lists that go with it.
sema_script_functions: fn(items: [Item]) -> [String] Never! {
    functions := [String]{}
    loop item in items {
        // copy: the function keeps its name; the row list holds one per function
        if item == .Func(function) && sema_script_function(function) {
            functions.push(function.name.copy())
        }
    }
    functions
}

// The script variables among `locals` that the body of `function` names, in
// the order it first names them, and the rows of the script functions it
// calls or names. A name `function` binds itself is its own.
sema_script_function_uses: fn(tables: ASTTables, function: Func, locals: [String], functions: [String]) -> SemaScriptUses Never! {
    uses := SemaScriptUses{variables: [String]{}, functions: [Int]{}}
    ast_visit_body(tables, function.body, fn(expression: ExprNode) { sema_script_note_use(uses, locals, functions, function, ast_expr(tables, expression)) }, true)
    uses
}

sema_script_note_use: fn(uses: &SemaScriptUses, locals: [String], functions: [String], function: Func, expression: Expr) Never! {
    if expression == .Ident(name, _, _) {
        // copy: the expression keeps its name; the list owns one per variable
        if locals.contains(name) && !uses.variables.contains(name) && !sema_script_function_hides(function, name) {
            uses.variables.push(name.copy())
        }
        sema_script_note_function(uses, functions, function, name)
    }
    if expression == .Call(call, _) {
        sema_script_note_function(uses, functions, function, call.name)
    }
}

sema_script_note_function: fn(uses: &SemaScriptUses, functions: [String], function: Func, name: String) Never! {
    if sema_script_function_hides(function, name) {
        return
    }
    loop (row, candidate) in functions {
        if candidate == name {
            if !uses.functions.contains(row) -> uses.functions.push(row)
            return
        }
    }
}

// Whether `function` binds `name` itself, as a parameter it declares or a
// local of its top-level statements.
sema_script_function_hides: fn(function: Func, name: String) -> Bool Never! {
    loop parameter in function.params {
        if parameter.name == name && !parameter.script_variable -> return true
    }
    loop statement in function.body {
        if statement == .Val(binding) && binding.name == name -> return true
    }
    false
}

// The span of the function the checker gave `parameter`, when `argument`, the
// default a call filled in for it, is a script variable's: such a parameter's
// default names the parameter itself, at the function's name.
sema_script_variable_default: fn(argument: Expr, parameter: SemaCallParam) -> Span? Never! {
    if argument == .Ident(name, at, id) && id == AST_NODE_GENERATED && name == parameter.name {
        return Val(at)
    }
    None
}

// A script variable's default as the call reads it: the caller's binding of
// `name`, at the call.
sema_script_variable_read: fn(name: String, call_span: Span) -> Expr Never! {
    // copy: the parameter keeps its name
    Expr.Ident{name: name.copy(), span: call_span, id: AST_NODE_GENERATED}
}

// E0107 for a call to a script function that needs script variable `name`
// where the caller hasn't bound it: a script line before the one that sets
// it, or code outside the script's lines, such as a `#Test` or a method,
// which passes it by name. `declared` is the function's name, where its
// parameter's default is spanned.
sema_script_unbound_variable: fn(declared: Span, name: String, call_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> Diagnostic {
    graph: program.registration_graph ?? return sema_unknown_name_in(name, call_span, scopes)
    module_index: sema_registration_module_index(graph, environment.module_identity) ?? return sema_unknown_name_in(name, call_span, scopes)
    items: graph.modules[module_index].program.items
    helper: sema_script_function_at(items, declared) ?? return sema_unknown_name_in(name, call_span, scopes)
    chain: sema_script_chain(graph.modules[module_index].program.tables, items, graph.modules[module_index].program.entry_locals, helper, name)
    through: if chain.len() == 0 -> "" else -> " through {sema_script_chain_text(chain)}"
    in_lines: sema_script_lines_hold(items, call_span)
    what: if in_lines -> "`{helper}` needs `{name}`, which the script hasn't set yet here" else -> "`{helper}` needs the script's `{name}`, which isn't bound here"
    why: if in_lines -> "`{helper}` uses the script's `{name}`{through}, so each call passes it, and this call runs before the line that sets it" else -> "`{helper}` uses `{name}`{through}, and only the script's own lines pass it by themselves"
    fix: if in_lines -> "move this call below the line that sets `{name}`" else -> "pass it by name: `{helper}(…, {name}: …)`"
    diagnostic := sema_error("E0107", call_span, what, why, fix)
    bound: sema_script_binding_span(items, name) ?? return diagnostic
    diagnostic_with_label(diagnostic, bound, "`{name}` is set here")
}

// Where the script's own lines bind `name`, at the binding's name.
sema_script_binding_span: fn(items: [Item], name: String) -> Span? Never! {
    entry: sema_script_entry_function_item(items, "run") ?? return None
    if items[entry] == .Func(function) {
        loop statement in function.body {
            if statement == .Val(binding) && binding.name == name -> return Val(binding.name_span)
        }
    }
    None
}

// The script function named at `declared`.
sema_script_function_at: fn(items: [Item], declared: Span) -> String? Never! {
    loop item in items {
        if item == .Func(function) && sema_script_function(function) && function.name_span.start == declared.start && function.name_span.end == declared.end {
            // copy: the item keeps its name
            return Val(function.name.copy())
        }
    }
    None
}

// The script functions through which `helper` reaches `name`, along the
// fewest calls: from the one it calls to the one whose body names `name`.
// Empty when `helper` names it itself.
sema_script_chain: fn(tables: ASTTables, items: [Item], locals: [String], helper: String, name: String) -> [String] Never! {
    functions: sema_script_functions(items)
    uses := [SemaScriptUses]{}
    hides := [Bool]{}
    loop item in items {
        if item == .Func(function) && sema_script_function(function) {
            uses.push(sema_script_function_uses(tables, function, locals, functions))
            hides.push(sema_script_function_hides(function, name))
        }
    }
    parents := [Int]{}
    queue := [Int]{}
    loop (row, candidate) in functions {
        parents.push(-1)
        if candidate == helper {
            parents[row] = row
            queue.push(row)
        }
    }
    head := 0
    loop head < queue.len() {
        row: queue[head]
        head += 1
        if uses[row].variables.contains(name) {
            chain := [String]{}
            at := row
            loop at != parents[at] {
                // copy: the row list keeps its names
                chain.insert(0, functions[at].copy())
                at = parents[at]
            }
            return chain
        }
        if hides[row] -> next
        loop callee in uses[row].functions {
            if parents[callee] < 0 {
                parents[callee] = row
                queue.push(callee)
            }
        }
    }
    [String]{}
}

sema_script_chain_text: fn(chain: [String]) -> String Never! {
    text := ""
    loop (index, function) in chain {
        text = if index == 0 -> "`{function}`" else -> "{text}, then `{function}`"
    }
    text
}

// Whether `span` is among the script's own lines rather than inside one of
// the file's declarations.
sema_script_lines_hold: fn(items: [Item], span: Span) -> Bool Never! {
    loop item in items {
        if item == .Func(function) && function.name == "run" && function.external_type == None {
            next
        }
        declared: sema_compiler_index_item_span(item)
        if declared.start <= span.start && span.end <= declared.end -> return false
    }
    true
}

// E0227 for a script function that changes script variable `variable`, used
// as a function value: the value has no place for the variable.
sema_script_value_diagnostic: fn(helper: String, variable: String, span: Span) -> Diagnostic {
    sema_error("E0227", span, "`{helper}` changes the script's `{variable}`, so it can't be used as a function value", "each call of `{helper}` passes the script's `{variable}` to its extra `&` parameter `{variable}:`, and a function value has no place for it", "call `{helper}` directly, or pass a lambda that makes that call")
}

// E1101 for a call in a task to a script function that changes script
// variable `variable`: the task would change it beside the script.
sema_script_task_diagnostic: fn(helper: String, variable: String, span: Span) -> Diagnostic {
    sema_error("E1101", span, "`{helper}` changes the script's `{variable}`, so it can't be called in a task", "each call of `{helper}` passes the script's `{variable}` to its extra `&` parameter `{variable}:`, and a task runs beside the script, so the change would race it", "call `{helper}` outside the task, or pass the task's own value by name: `{helper}(…, {variable}: …)`")
}

// E0204 for a call whose extra parameter for a script variable overlaps an
// argument the call already passes.
sema_script_alias_diagnostic: fn(helper: String, parameter: SemaCallParam, active_write: Bool, span: Span) -> Diagnostic {
    variable: parameter.name
    writes: parameter.convention == AccessConvention.Write
    through: if writes -> "change it through its extra `&` parameter `{variable}:`" else -> "read it through its extra parameter `{variable}:`"
    passes: if writes -> "`{helper}` changes the script's `{variable}`, so each call passes it as an extra `&` parameter" else -> "`{helper}` reads the script's `{variable}`, so each call passes it as an extra parameter"
    if active_write {
        return sema_error("E0204", span, "`{variable}` is being changed in this call, so `{helper}` can't also {through}", "{passes}, and while something is being changed through a write parameter, nobody else may be looking at it", "pass `{variable}` only once, or pass a copy of it")
    }
    sema_error("E0204", span, "`{variable}` is already shared in this call, so `{helper}` can't also {through}", "{passes}, and while something is being looked at, nobody else may be changing it", "drop the extra use of `{variable}`, or pass a copy of it there")
}
