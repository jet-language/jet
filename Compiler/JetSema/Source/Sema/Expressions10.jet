//RS     pub(crate) fn type_satisfies_bound(&self, ty: &Type, bound: &str) -> bool {
//RS         if let Some((dimension, kind)) = crate::Generics::parse_quantity_bound(bound) {
//RS             if let Some((_, fact)) = self.unit_fact_for_type(ty) {
//RS                 return fact.family == dimension && fact.kind.name() == kind;
//RS             }
//RS             let Some((_, actual_dimension)) = ty.quantity_parts() else {
//RS                 return false;
