//RS     deterministic_world_depth: usize,
//RS     det_suppress: usize,
//RS     context_depth: usize,
//RS     context_allocator_active: bool,
//RS     in_unsafe: bool,
//RS     suppress_must_use: bool,
//RS     in_pure: bool,
//RS     no_prelude: bool,
//RS     in_pre_clause: bool,
//RS     fallback_has_err: Option<bool>,
//RS     failure_auto_root_suppression: usize,
//RS     failure_auto_depth: usize,
//RS     fallback_is_shape_miss: bool,
//RS     in_comptime: bool,
//RS     compiler_api_allowed: bool,
//RS     ret: Option<Type>,
//RS     fn_name: String,
//RS     compiler_generated: bool,
//RS     raw_protocol_return: bool,
//RS     declared_return_type: Option<Type>,
//RS     current_return_type_span: Option<Span>,
//RS     current_param_names: Vec<String>,
//RS     binder_ref_types: HashMap<String, Type>,
