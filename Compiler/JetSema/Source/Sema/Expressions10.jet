//RS pub(crate) struct Checker<'a> {
//RS     funcs: &'a HashMap<String, FuncSig>,
//RS     /// D-NEVER1=C: sema's fixed-point bottom facts. A call consults this
//RS     /// registry before ordinary value joining; no engine infers divergence.
//RS     diverging_functions: &'a std::collections::HashSet<String>,
//RS     /// D-SHAPE-PLACE1=A: proven length-preserving list write parameters.
//RS     fixed_length_write_params: &'a std::collections::HashSet<(String, usize)>,
//RS     effect_facts: &'a jet_foundation::Facts::FactRegistry,
//RS     consts: &'a HashMap<String, Type>,
//RS     pub(crate) devtools_registry: &'a jet_foundation::AST::DevtoolsRegistry,
//RS     registry: &'a TypeRegistry,
//RS     plugin_interfaces: &'a PluginInterfaceRegistry,
//RS     modules: Option<&'a [ModuleState]>,
//RS     /// D-COMPILE-SPEED1: unqualified nominal lookup may otherwise scan every
//RS     /// module for each expression. This cache belongs to one body checker and
//RS     /// is rebuilt after registration, so immutable module states cannot make a
//RS     /// cached owner stale while the checker is alive.
//RS     nominal_owner_cache: std::cell::RefCell<HashMap<String, Option<usize>>>,
//RS     items: &'a [crate::AST::Item],
//RS     module_idx: usize,
//RS     imports: &'a HashMap<String, usize>,
//RS     core_imports: &'a HashMap<String, String>,
//RS     /// D-MOD2: inline code module aliases in scope (alias → module name).
//RS     code_modules: &'a HashMap<String, String>,
//RS     code_module_identities: &'a HashMap<String, String>,
//RS     /// D-MOD3: unqualified inline-module items in scope (name → mangled name).
//RS     unqualified: &'a HashMap<String, String>,
//RS     /// D-MOD3: unqualified file-module items in scope (name → (fn_name, module_idx)).
//RS     unqualified_file: &'a HashMap<String, (String, usize)>,
//RS     /// D-CORE-USELIST1=A: unqualified Core items in scope (local name → member).
//RS     core_item_imports: &'a HashMap<String, String>,
//RS     /// D-NAME-WALK1=A: imports scoped to one inline-module body.
//RS     inline_unqualified: &'a HashMap<(String, String), String>,
//RS     inline_unqualified_file: &'a HashMap<(String, String), (String, usize)>,
//RS     inline_module: Option<String>,
//RS     /// D-NAME-WALK1=A: public re-exports declared inside inline modules.
//RS     inline_reexport_inline: &'a HashMap<(String, String), (String, String)>,
//RS     inline_reexport_file: &'a HashMap<(String, String), (String, usize)>,
//RS     inline_reexport_core: &'a HashMap<(String, String), (String, String)>,
//RS     inline_reexport_foreign: &'a HashMap<(String, String), usize>,
//RS     module_path: &'a str,
//RS     source: &'a str,
//RS     package_scope: &'a str,
//RS     policy_declarations: &'a [crate::Policy::PolicyDeclaration],
//RS     callable_policy_declarations:
//RS         &'a BTreeMap<(String, String), (usize, crate::AST::UserPolicyDecl)>,
//RS     rule_facts: Vec<crate::AST::AppliedRuleApplication>,
//RS     /// D-RESOURCE-SCHEDULE1=A: aggregate access facts for this checked frame
//RS     /// callback body. A second callback is checked as a candidate parallel
//RS     /// system; the first callback's source order remains the reference.
//RS     frame_schedule_systems: Vec<jet_foundation::ResourceSchedule::JetFrameOperation>,
//RS     current_function_span: Span,
//RS     name_ledger: &'a mut jet_foundation::Names::NameLedger,
//RS     diags: Vec<Diagnostic>,
//RS     /// D-SUBJECT-COHERE1=A: statement-local `#allow(lint)` facts collected
//RS     /// while checking the following expression statement.
//RS     statement_lint_allows: Vec<String>,
//RS     /// D-STDLIB-SMALL1: complete replacement idioms are discovered at block
//RS     /// entry and emitted while their first statement is checked, so a local
//RS     /// `#allow` marker can suppress exactly that diagnostic.
//RS     stdlib_lint_candidates: HashMap<usize, (Span, crate::Diagnostics::TextEdit)>,
//RS     /// D-LINT-UNUSED1: source declarations whose successful body check found
//RS     /// no read or write. The declaration identity is the sema `def_span`, so
//RS     /// shadowed names never share a liveness fact.
//RS     unused_bindings: Vec<UnusedBinding>,
//RS     unused_binding_refs: HashSet<Span>,
//RS     /// D-FACT-FLOW1: the one store of per-binding facts — declarations, flow
//RS     /// narrowing, moves, uninitialised places and open borrow windows. Every
//RS     /// plane joins through `FlowFacts`; nothing here keeps the last-walked path.
//RS     flow: FlowFacts::FlowFacts,
//RS     concrete_unit_values: Vec<HashMap<String, f64>>,
//RS     /// Field inference reads its base only to discover its type. Suppress a
//RS     /// partial-root move report there; the complete field place is checked first.
//RS     suppress_partial_move_root_read: bool,
//RS     loop_depth: usize,
//RS     /// D-COPY-DEFAULT1=A: while a `return` or `break` value is checked, the
//RS     /// loop depth that exit lands at, paired with the depth it was set at. A
//RS     /// move there is the last use for every loop it leaves, so it is not a
//RS     /// reuse on a later iteration.
//RS     loop_exit_depth: Option<(usize, usize)>,
//RS     /// D-COPY-DEFAULT1=A: unmarked move sites that a later use turned into
//RS     /// shares. After the body check each site becomes `~name`; the paired
//RS     /// E0121 is reported only if that site cannot be found in the body.
//RS     share_sites: Vec<(Span, Diagnostic)>,
//RS     /// D-LOOP-SUBJECT1=A: active bindingless collecting-loop subjects.
//RS     implicit_loop_subject_depth: usize,
//RS     /// D-SUBJECT-COHERE1=A: active subject-shorthand lambda scopes.
//RS     subject_shorthand_depth: usize,
//RS     source_nesting: usize,
//RS     /// D-LOOPLABEL3=A: stack of `name :: loop` names; scope, innermost last.
//RS     loop_labels: Vec<String>,
//RS     /// D-LOOPEVAL1: item type under each compiler-private collecting loop.
//RS     /// Nested yielding loops push independent slots.
//RS     collect_item_types: Vec<Option<Type>>,
//RS     loop_value_frames: Vec<LoopValueFrame>,
//RS     /// Flow facts captured by `break` exits, aligned with loop_value_frames.
//RS     loop_break_flows: Vec<Vec<FlowFacts::FlowFacts>>,
//RS     pending_loop_value: Option<(LoopValueKind, Option<String>)>,
//RS     /// D-LOOP-STMT-ARROW1=C: the body currently being checked came from a
//RS     /// statement-position loop arrow. Its ordinary expression statement may
//RS     /// compute a value, but that value is intentionally discarded.
//RS     arrow_loop_body: bool,
//RS     last_loop_result_type: Option<Type>,
//RS     /// D-EFF1: effects this function body reaches directly (Core calls, impure
//RS     /// builtins). Accumulated during the walk; rolled into the per-function
//RS     /// `EffectSummary` after the body is checked.
//RS     fx_direct: EffectSet,
//RS     /// First source span that introduced each direct effect, for inspect/LSP
//RS     /// provenance. Duplicate uses keep the earliest stable witness.
//RS     fx_direct_spans: HashMap<String, Span>,
//RS     /// D-EFFECT-LAMBDA1: active lambda rows receive the same effect events as
//RS     /// the enclosing body, preserving nested closure facts without a second
//RS     /// analysis walk.
//RS     lambda_effect_stack: Vec<Effects::LambdaEffectAccum>,
//RS     /// D-EFF1: user functions called in this body (call-graph edges for the
//RS     /// whole-program transitive fixpoint).
//RS     fx_edges: BTreeSet<String>,
//RS     /// D-EFF1: a foreign (`extern`) call was reached — the body's effects are
//RS     /// the maximal set (an un-inspectable body may do anything).
//RS     fx_maximal: bool,
//RS     /// First source span that forced the row maximal.
//RS     fx_maximal_span: Option<Span>,
//RS     /// D-EFF1: stack of active `#FX(…)` regions, innermost last. Every effect
//RS     /// or edge recorded while one is open is also added to it (and all enclosing
//RS     /// regions) so the region's own effect set can be checked against its caps.
//RS     region_stack: Vec<RegionAccum>,
//RS     /// D-EFF1: completed `#FX(…)` regions in this body, rolled into the
//RS     /// `EffectSummary` for the post-pass E0712 check.
//RS     fx_regions: Vec<RegionSummary>,
//RS     /// D-AUTHORITY-RECEIPT1: source facts for Authority handles delegated to
//RS     /// approved Core boundary consumers.
//RS     fx_authority_delegations: Vec<Effects::AuthorityDelegation>,
//RS     /// D-EFF2: callback-bound obligations recorded at higher-order call sites
//RS     /// where the function-typed parameter carries a `#Pure`/`#(…)` bound. Rolled
//RS     /// into the `EffectSummary` for the post-pass E0747 check.
//RS     fx_callback_obligations: Vec<CallbackObligation>,
//RS     /// D-AUTODIFF1: named differentiated functions whose solved effect rows
//RS     /// must be checked after the bundle effect graph closes.
//RS     fx_autodiff_obligations: Vec<Effects::AutodiffObligation>,
//RS     /// D-AUTODIFF1: compute consumers used by this function body.
//RS     fx_compute_calls: Vec<Effects::ComputeCallFact>,
//RS     /// D-AUTODIFF1: a `?? panic` directly attached to a Tensor-returning
//RS     /// `core.compute` operation is a checked domain-failure boundary. Keep its
//RS     /// provenance separate from arbitrary/direct panic sites so autodiff can
//RS     /// admit only the former without erasing the D-NOPANIC effect fact.
//RS     fx_autodiff_safe_panic: bool,
//RS     fx_autodiff_unsafe_panic: bool,
//RS     autodiff_safe_panic_context: bool,
//RS     /// D-CRYPTO-DIAG1: compiler-known crypto facts wait for the function's
//RS     /// syntax/type/effect phases to finish before becoming diagnostics.
//RS     fx_pending_diagnostics: Vec<Diagnostic>,
//RS     /// D-MEM-FACTS1 direct, source-spanned memory evidence accumulated beside
//RS     /// effects so both policies share one pre-TIR call graph.
//RS     fx_memory_events: Vec<MemoryFacts::MemoryEvent>,
//RS     fx_memory_open: Vec<MemoryFacts::OpenMemoryDispatch>,
//RS     memory_policy_stack: Vec<MemoryFacts::MemoryPolicyRegion>,
//RS     /// D-WRAP-SCOPE1=A: active lexical fixed-width arithmetic modes. The last
//RS     /// entry is the innermost block; function markers seed the stack once per
//RS     /// body and never cross a call boundary.
//RS     arithmetic_policy_stack: Vec<crate::AST::ArithmeticPolicyFact>,
//RS     fx_memory_regions: Vec<MemoryFacts::MemoryPolicyRegion>,
//RS     fx_memory_unbounded_control: Vec<Span>,
//RS     fx_memory_calls: Vec<MemoryFacts::MemoryCall>,
//RS     /// Statements that dropped a call's non-Unit result. The solved effect
//RS     /// phase reports those whose callee row is empty (E0433).
//RS     fx_discarded_results: Vec<Effects::DiscardedResultFact>,
//RS     /// D-DISCARD1=A: span of the last statement of a named function with no
//RS     /// written return type. A non-Unit value there is thrown away (E0433).
//RS     lost_tail_span: Option<Span>,
//RS     memory_control_multiplier: Option<u64>,
//RS     /// D-TXN2: nesting depth of `#Transact(name) { … }` blocks whose body is
//RS     /// being checked **directly** (not inside a deferred lambda). While `> 0`, an
//RS     /// irreversible Core effect (Net/FS/Exec) reached directly in the block is
//RS     /// E0746 at the call site — the fix is to move it after the block or register
//RS     /// it via `name.on_commit(…)`. Zeroed and restored around every lambda body
//RS     /// (effects inside an `on_commit`/other lambda are deferred, not rejected).
//RS     txn_depth: usize,
//RS     /// D-CONC-SHARE1=A (card #1561): nesting depth of transaction blocks the
//RS     /// *user* opened. The D-TXN2 effect wall (E0746) keys off this, not
//RS     /// `txn_depth`, so a compiler-synthesized one-statement transaction — the
//RS     /// ordered-commit route for a plain statement touching several `Shared`
//RS     /// cells — carries the commit plane without rejecting effects the author
//RS     /// never put inside a transaction.
//RS     txn_wall_depth: usize,
//RS     /// D-TEST-WORLD1=A: depth of a `testing.world` callback. Calls reached
//RS     /// here must use a scoped provider; external effects cannot be replayed.
//RS     deterministic_world_depth: usize,
//RS     /// D-DET1: nesting depth of `assume_deterministic { … }` blocks currently
//RS     /// being checked. While `> 0`, the determinism rejections inside a `#Pure fn`
//RS     /// (E3403 non-deterministic Core call, E3401 impure Core call) are suspended —
//RS     /// the expert "I know this is deterministic" escape. A semantic footgun
//RS     /// (v1-legal per the card); does not relax memory/type safety, only the
//RS     /// determinism check. Zeroed/restored around lambda bodies like `txn_depth`.
//RS     det_suppress: usize,
//RS     /// D-CTX1 / c26: nesting depth of `#Context { … }` blocks (for L0506).
//RS     context_depth: usize,
//RS     /// True while inside a `#Context` block that set an `allocator` field.
//RS     context_allocator_active: bool,
//RS     in_unsafe: bool,
//RS     /// D-IGNORERET2=A: true while inside a `#Suppress(MustUse) { … }` block.
//RS     /// Suppresses E0402 / E0419 for fallible / `#MustUse` results dropped as statements.
//RS     suppress_must_use: bool,
//RS     /// True while checking a `pure fn` body, so E3403 can fire on a
//RS     /// non-deterministic std call (time/random) reached from pure code.
//RS     in_pure: bool,
//RS     /// D-PRELUDEX1=A: true when the enclosing file declared `#NoPrelude`.
//RS     /// Disables readable Core prelude resolution for this body.
//RS     no_prelude: bool,
//RS     /// D-PREPOST1: true while type-checking a `#Pre` clause's condition —
//RS     /// `result` isn't bound yet at function entry, so a reference to it here
//RS     /// is E0144 instead of the normal "undefined name" error.
//RS     in_pre_clause: bool,
//RS     /// D-FAIL-BIND1=A: `None` means no fallback is being checked; `Some(true)`
//RS     /// is a fallible fallback with an ambient `err`; `Some(false)` has no
//RS     /// failure report and rejects the spelling with E0408 or E0409.
//RS     pub(crate) fallback_has_err: Option<bool>,
//RS     /// D-FAILURE-FOUNDATION1=A: number of root inference calls that own their
//RS     /// carrier explicitly. The token is consumed by that one `infer` call;
//RS     /// recursive child expressions remain ordinary propagation sites.
//RS     pub(crate) failure_auto_root_suppression: usize,
//RS     /// D-FAILURE-FOUNDATION1=A: ambient carrier context retained for checks
//RS     /// that need to distinguish an explicit carrier probe from ordinary value
//RS     /// inference. Automatic propagation itself uses the root token above so
//RS     /// nested call arguments can still propagate.
//RS     pub(crate) failure_auto_depth: usize,
//RS     /// D-CHOOSE-TEST1=A: distinguishes a pure pattern miss from an absent
//RS     /// Optional while `fallback_has_err == Some(false)`.
//RS     pub(crate) fallback_is_shape_miss: bool,
//RS     /// D-GENERIC-CALL1=A: the type arguments a qualified module call
//RS     /// (`table.sort(rows, false, key)`) inferred from its arguments. The
//RS     /// module-call checkers take their spelled type arguments by reference,
//RS     /// so the call site that owns the AST node takes this and records it
//RS     /// there, exactly like a direct call's inferred `call.type_args`.
//RS     pub(crate) inferred_call_type_args: Option<Vec<Type>>,
//RS     /// Reads of an `invalid` binding. Such a read infers no type and emits no
//RS     /// diagnostic, so a binding whose initializer yields no type after one of
//RS     /// these reads is a cascade of the earlier error, not a new failure.
//RS     pub(crate) invalid_binding_reads: usize,
//RS     /// True while inferring a comptime binding's RHS or inside a comptime
//RS     /// context (D-META-STAGE1=B).
//RS     in_comptime: bool,
//RS     /// True only while checking the selected package/workspace `fn build`.
//RS     /// This is passed by the Driver's build authority, never inferred from a
//RS     /// user-chosen function name.
//RS     compiler_api_allowed: bool,
//RS     ret: Option<Type>,
//RS     fn_name: String,
//RS     /// Compiler-generated bodies already spell their Result inspection or
//RS     /// propagation explicitly. Do not apply source-level transparent failure
//RS     /// propagation to those synthetic ASTs.
//RS     compiler_generated: bool,
//RS     /// Compiler-generated trait protocol bodies implement a raw Rust ABI. This
//RS     /// is distinct from `compiler_generated`: policy wrappers and validation
//RS     /// builders remain ordinary Jet callables with the shared failure carrier.
//RS     raw_protocol_return: bool,
//RS     /// Source-declared return type. The checker keeps `ret` as the effective
//RS     /// failure carrier, while generator checks use this declaration directly.
//RS     declared_return_type: Option<Type>,
//RS     current_return_type_span: Option<Span>,
//RS     /// Canonical caller-visible parameter order; excludes `self`.
//RS     current_param_names: Vec<String>,
//RS     /// Compiler-private names in inserted defaults resolve to their declaration
//RS     /// slot type here. This map is populated by the shared call binder.
//RS     pub(crate) binder_ref_types: HashMap<String, Type>,
//RS     /// Context type for bare `null` (E0308).
//RS     expected_type: Option<Type>,
//RS     /// D-INTBIG1: typed reachability fact for this checked/generated body.
//RS     uses_exact_int: bool,
//RS     /// The written bounded-arithmetic call currently checking its argument.
//RS     /// This is a sema-only context; no gate marker reaches TIR or codegen.
//RS     knowledge_gate: Option<KnowledgeGate>,
//RS     /// Collections currently read by an active `for x in xs` loop (E0507).
//RS     iter_borrowed: HashSet<String>,
//RS     /// Card #1440: NoElse-terminated dispatch chains already coverage-checked
//RS     /// (chain span starts) — every level shares one span, the outermost wins.
//RS     noelse_chains_checked: HashSet<usize>,
//RS     /// D-RESULT-DECON2=B: the parser keeps one receiver in both fixed Result
//RS     /// pattern tests. Cache its checked type and elaborated expression by source
//RS     /// span so sema checks effects and ownership once while both lowered copies
//RS     /// retain the same resolved call metadata.
//RS     result_handler_subject_types: HashMap<usize, (Type, Expr)>,
//RS     /// D-OUTCOME-SHAPE1=A: subject span starts of value-form pattern chains
//RS     /// that handle a `T? E!` failure themselves; their `.Val`/`.None` levels
//RS     /// test that same carrier instead of passing the failure up.
//RS     carrier_chain_subjects: HashSet<usize>,
//RS     /// Loop bindings that lend one `ViewMut<T>` element from a collection.
//RS     /// These values may edit during the iteration but may not be retained.
//RS     lending_view_loop_vars: HashSet<String>,
//RS     /// D-MEM-VIEWRET1=B: one canonical public source inferred from every
//RS     /// successful named-view return in this function.
//RS     return_view_provenance: Option<crate::AST::ViewProvenanceMap>,
//RS     /// View names read in the statement currently being checked. Together
//RS     /// with the existing statement-tail analysis, this makes local window
//RS     /// conflicts end at last use instead of lexical scope end.
//RS     views_used_in_stmt: HashSet<String>,
//RS     /// One scoped-loan read report per statement. Nested reads of the same
//RS     /// place (`ps[0].position` is a Field over an Index) would otherwise each
//RS     /// report the one mistake.
//RS     scoped_loan_read_reported: bool,
//RS     /// #1196: argument and receiver loans that remain active until their call
//RS     /// finishes. Nested calls see every outer frame.
//RS     call_access_frames: Vec<CallAccessFrame>,
//RS     /// True while inferring an expression that the generated Rust will only
//RS     /// borrow (method receivers, field/index bases, lvalues). Field reads in
//RS     /// borrow position must NOT be rewritten to `.clone()`.
//RS     borrow_ctx: bool,
//RS     /// D-MEM-COPYSEM1: depth of an owning value-if inference. Only the
//RS     /// value-if arm boundary consults this marker to route its tail through
//RS     /// the owning-position copy rule.
//RS     owning_if_value_depth: usize,
//RS     /// `Fixed.new` / `Fixed.over` must be the whole initializer of one lexical
//RS     /// binding so codegen can place and lifetime-order its inline backing.
//RS     allow_fixed_constructor: bool,
//RS     /// D-MEM-COPYSEM1: true while inferring a string-view fact for a direct
//RS     /// non-owning operation, the operand of `~`, or a read-only view entering
//RS     /// an owning destination. The general `Expr::Ident` arm reports E2307
//RS     /// when this is false and `copies: .Explicit` has disabled materialization.
//RS     allow_string_view_read: bool,
//RS     /// M8: when false, a lambda is consumed inline (collection methods / borrow).
//RS     lambda_escapes: bool,
//RS     /// True only while checking a lambda body. Distinguishes an escaping lambda
//RS     /// from the checker's ordinary top-level default escape policy.
//RS     in_lambda_body: bool,
//RS     /// Builtin mutating receivers discovered while inferring the current
//RS     /// lambda body. The builtin table supplies the mutation fact; inline
//RS     /// callbacks fold these roots into `LambdaMeta::mut_captures`.
//RS     inferred_lambda_mut_captures: HashSet<String>,
//RS     /// `edit_disjoint` lends each callback parameter for that invocation only.
//RS     /// Any store, return, or retaining call from the callback is E0212.
//RS     lambda_params_are_lending_views: bool,
//RS     /// D-CAP-RECEIVER1=D: written `&`/`^` receiver marks, keyed by the
//RS     /// marked place's span. The MethodCall arm removes the mark from the tree
//RS     /// before resolution and keeps it here, so re-inference still sees it.
//RS     receiver_marks: HashMap<(usize, usize), ReceiverMark>,
//RS     /// D-CAP-RECEIVER1=D: one frame per method call being inferred; receiver
//RS     /// hooks record the resolved convention into the frame for that receiver.
//RS     receiver_mark_frames: Vec<ReceiverMarkFrame>,
//RS     /// M11: when true, lambda is being passed to canonical `task` — stricter capture rules (E1101).
//RS     is_task_spawn: bool,
//RS     /// D-CONC-SPAWN1: set by `infer_try` when a `?` in the CURRENT lambda body
//RS     /// is typed against the enclosing fallible return. `infer_lambda` scopes it
//RS     /// per lambda and harvests it into `LambdaMeta::fallible_propagation`.
//RS     task_body_propagates: bool,
//RS     /// #3708: this function body (outside lambdas) produces a failure that is
//RS     /// not a `Try`/`Err` node of the checked AST. Deliberately absent from
//RS     /// the erased-scope snapshot: restoring it could only forget a source.
//RS     failure_direct_source: bool,
//RS     /// D-FAIL-INFER-UNION1=A: set only while the failure-union pre-pass
//RS     /// probes a clone of an unannotated function. Each failure that reaches
//RS     /// the default `Err` route is recorded here instead of being reported.
//RS     failure_union_probe: Option<FailureUnionProbe>,
//RS     /// True while an open callback return is being inferred. A fallible callee
//RS     /// in this position supplies the callback's own Result carrier; it must not
//RS     /// be auto-unwrapped against the enclosing function's return row.
//RS     failure_carrier_inference: bool,
//RS     /// The carrier discovered for the current open callback, if its body has
//RS     /// reached a fallible callee.
//RS     failure_carrier: Option<Type>,
//RS     /// True while the root expression is being checked as a statement. A
//RS     /// dispatch nested in a value expression must keep value-tail checking;
//RS     /// only the statement root may make a braced arm's tail Unit.
//RS     statement_expr_inference: bool,
//RS     /// Source-nesting depth at which the root expression passed to
//RS     /// `infer_statement_expr` is being inferred. Nested value expressions
//RS     /// (for example an `if` passed to `print`) must not inherit the
//RS     /// statement root's Unit result policy.
//RS     statement_expr_root_depth: Option<usize>,
//RS     /// HTTP handlers are retained by the server and invoked on request
//RS     /// workers, so captured state must cross the `Send + Sync` boundary.
//RS     http_handler_depth: usize,
//RS     /// True while checking the callback stored by `core.sys.on_interrupt`.
//RS     /// This boundary retains a callback for asynchronous signal delivery and
//RS     /// therefore needs stricter capture facts than an ordinary higher-order call.
//RS     interrupt_callback_depth: usize,
//RS     /// D-MEM1 S6 (D-SHARED-API1=A): true only while binding `Shared<T>.edit(f)`'s
//RS     /// closure parameter — grants it write access with no `&` sigil (the API
//RS     /// contract IS the exclusive lock; `check_lambda` reads this once, at bind
//RS     /// time, then it's irrelevant for the rest of the closure body).
//RS     lambda_param_mutable: bool,
//RS     /// `ExpiringSecret.with` lends its callback parameter without transferring
//RS     /// ownership. The ordinary parameter convention machinery then rejects
//RS     /// moves and captures before codegen.
//RS     lambda_param_is_secret_loan: bool,
//RS     /// D-DETACH1: task names whose spawn lambda had a non-view sendability error (E1102 fired).
//RS     /// At `.detach()`, if the task is in this set and NOT in view_borrow_escape_tasks, E1103 fires.
//RS     view_capture_tasks: HashSet<String>,
//RS     /// D-DATARACE1=C: human-readable upgrade lines for `jet report` / CompileOutput.
//RS     reactive_upgrades: Vec<String>,
//RS     /// D-DATARACE1=C: binding names that crossed a concurrency boundary this function.
//RS     reactive_upgrade_names: HashSet<String>,
//RS     /// D-DETACH1: task names whose spawn lambda captured a `view` or
//RS     /// task-group-scoped borrow. At `.detach()`, if the task is in this set,
//RS     /// E1106 fires instead of E1103.
//RS     view_borrow_escape_tasks: HashSet<String>,
//RS     /// D-DETACH1: the binding name currently being elaborated (set at check_binding
//RS     /// entry, cleared after). Used to record view-capturing task names.
//RS     current_binding_name: Option<String>,
//RS     /// Binding owned by the task spawn whose lambda is being checked. Nested
//RS     /// task bodies must not reuse that outer name for group auto-join tracking,
//RS     /// but sendability diagnostics still need the outer detach target.
//RS     task_spawn_binding_name: Option<String>,
//RS     /// M8: binding name when checking `f :: (…) => …` (E0804 self-call).
//RS     lambda_binding: Option<String>,
//RS     /// Names mutably captured by an escaping lambda still in scope (E0204).
//RS     lambda_mut_borrow_stack: Vec<HashSet<String>>,
//RS     /// M9: generic/trait metadata for this program.
//RS     trait_reg: &'a TraitRegistry,
//RS     /// M9.5: local comptime declaration context. This retains every declared
//RS     /// body for semantic lookup; execution uses only `ct_checked_funcs`.
//RS     ct_funcs: &'a HashMap<String, Func>,
//RS     /// Function bodies that have completed the semantic checker and are safe
//RS     /// to hand to the canonical comptime MIR evaluator.
//RS     ct_checked_funcs: &'a HashMap<String, Func>,
//RS     /// Source item context supplied to the checked evaluator. It may retain
//RS     /// declarations whose executable method bodies are filtered by
//RS     /// `ct_checked_funcs`.
//RS     ct_items: &'a [crate::AST::Item],
//RS     ct_externs: &'a HashSet<String>,
//RS     ct_base_dir: &'a std::path::Path,
//RS     ct_globals: &'a HashMap<String, crate::Comptime::CtValue>,
//RS     ct_scopes: Vec<HashMap<String, crate::Comptime::CtValue>>,
//RS     /// During the targeted comptime staging pass, type-check bodies without
//RS     /// executing any compile-time expression. The ordinary pass evaluates
//RS     /// mandatory and opportunistic expressions after their callees are safe.
//RS     defer_ct_evaluation: bool,
//RS     /// Active generic type parameters while checking a generic item.
//RS     type_param_scope: Vec<crate::AST::TypeParam>,
//RS     /// E2-M15: reject OS-dependent APIs on a selected no-OS target (E3301).
//RS     no_os: bool,
//RS     /// D-CTEFFECT1: `--gate impure=allow` was passed — `#Impure` blocks may execute
//RS     /// Tier-2 ambient comptime effects (FS/Env/Exec/IO) at compile time.
//RS     gates: crate::Policy::GateSet,
//RS     /// D-CTEFFECT1: nesting depth of `#Impure` blocks currently being checked.
//RS     /// Passed as `initial_impure_depth` to comptime evaluation of bindings
//RS     /// inside, so the interpreter starts with the gate already open.
//RS     ct_impure_depth: usize,
//RS     /// D-CTEFFECT1 Tier-1: embed_file/embed_bytes inputs accumulated while
//RS     /// checking this function body. Drained into `CompileOutput.comptime_inputs`
//RS     /// by Bundle.rs after the full bundle is checked.
//RS     pub(super) ct_embed_inputs: Vec<crate::AST::ComptimeInput>,
//RS     /// D-WHEN2 (ratified 2026-06-19): when true, we are inside a dropped
//RS     /// `@if` arm — name-resolution runs normally (so unknown-name
//RS     /// typos are caught) but all other diagnostics are suppressed and the arm
//RS     /// is never lowered to codegen.
//RS     in_dropped_comptime_arm: bool,
//RS     /// E0209 liveness gate (was D-L0201) — pointer to the statements that follow the
//RS     /// currently-executing statement in the innermost block, plus the count.
//RS     /// Set by `check_block` before each call to `check_stmt`.
//RS     /// Safety: valid for the duration of `check_stmt` — the slice lives in
//RS     /// the `Program` AST which outlives the checker.
//RS     stmt_tail_ptr: *const crate::AST::Stmt,
//RS     stmt_tail_len: usize,
//RS     /// E0209 liveness gate (was D-L0201): stack of enclosing block tails, from outermost to innermost.
//RS     /// Each entry is the (ptr, len) of the tail saved before entering a nested
//RS     /// block, so `is_name_live_after` can walk up through all enclosing scopes.
//RS     liveness_frames: Vec<(*const crate::AST::Stmt, usize)>,
//RS     /// D-CONC-SPAWN1=D: stack of active `task.group` scopes (innermost last).
//RS     taskgroup_stack: Vec<TaskGroupCtx>,
//RS     /// True while inferring a child body passed to `task.group` — suppresses L1101
//RS     /// (the group owns the handle until scope exit or an explicit join).
//RS     in_taskgroup_spawn: bool,
//RS     /// D-METHODMACRO1=A: top-level function names whose bare identifier was
//RS     /// read as a VALUE (not called directly) while checking this one function
//RS     /// body — see `CheckerInfer/expr.rs`'s `Expr::Ident` arm, the single spot
//RS     /// that resolves a bare name to a global function's signature. Rolled up
//RS     /// into a whole-program accumulator (`check_func_body`'s
//RS     /// `global_addr_taken` parameter) so `#Inline(Always)` (E0918) can be
//RS     /// checked once every function has run through here.
//RS     inline_addr_taken: HashSet<String>,
//RS     /// D-DX-PLUGIN1=D: checked `core.devtools.publish` facts of this body.
//RS     /// The body's products carry them out; bundle completion projects them
//RS     /// into the shared panel registry in source order.
//RS     devtools_publications: Vec<jet_foundation::AST::DevtoolsFactPublication>,
//RS     /// This body handed an expression to the compile-time evaluator. The
//RS     /// evaluator reads `ct_checked_funcs`, which grows as the bodies before
//RS     /// this one are checked, so such a body's result depends on check order.
//RS     /// Deliberately not part of the erased-scope snapshot: an erased scope
//RS     /// that evaluated still made this body order-dependent.
//RS     ct_evaluator_ran: std::cell::Cell<bool>,
//RS }
//RS 
//RS /// Mutable checker state that must not cross an erased `#Off`/`#DebugOnly`
//RS /// body boundary. Diagnostics are deliberately not included: erased source is
//RS /// still type-checked and its real diagnostics remain visible.
