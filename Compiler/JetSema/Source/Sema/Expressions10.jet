// Rust: crates/jet-sema/src/Sema/mod.rs:1998
pub fn type_uses_default_int(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> type_uses_default_int(inner)
        .Map(key, _, value) | .Result(key, value) -> type_uses_default_int(key) || type_uses_default_int(value)
        .Tuple(fields) -> { loop field in fields { if type_uses_default_int(field.ty) -> return true }; false }
        .Union(members) | .Apply(_, members) -> { loop member in members { if type_uses_default_int(member) -> return true }; false }
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params { if type_uses_default_int(param) -> return true }
            ret.is_some_and(value -> type_uses_default_int(value))
        }
        .IntN(_, _) | .Float | .Float32 | .Bool | .String | .Char | .Named(_) | .TraitObject(_) | .Measure(_) -> false
    }
}
