//RS                     fact.family == dimension
//RS                         && fact.kind == QuantityKind::Linear
//RS                         && fact.dimension.as_ref() == Some(&actual_dimension)
//RS                 });
//RS         }
//RS         // A type parameter in scope satisfies every bound declared on it, so
//RS         // `fn outer<P: Shape>(shape: P)` may forward `P` to another
//RS         // `<P: Shape>` generic (`inner<P>(shape)` or `inner(shape)`).
//RS         if let Type::Named(name) = ty {
//RS             let mut in_scope = false;
//RS             let mut declared_bound = false;
//RS             for param in self.type_param_scope.iter().filter(|param| param.name == *name) {
//RS                 in_scope = true;
//RS                 declared_bound |= param.bounds.iter().any(|candidate| candidate == bound);
//RS             }
//RS             if declared_bound {
//RS                 return true;
//RS             }
//RS             // An in-scope type parameter without a declared `Decode` bound can
//RS             // be instantiated with any type, so it never satisfies `Decode`.
//RS             // A concrete named type (a `#Codable` / `#Decode` struct or enum)
//RS             // falls through to its registered derive or impl below.
//RS             if in_scope && bound == crate::Generics::DECODE {
//RS                 return false;
