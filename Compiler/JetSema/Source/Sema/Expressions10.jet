// Rust: crates/jet-sema/src/Sema/mod.rs:1886
pub struct SharedFlag { value: AtomicBool }
impl SharedFlag {
    pub fn default() -> SharedFlag { SharedFlag{value: AtomicBool.new(false)} }
    // Rust: crates/jet-sema/src/Sema/mod.rs:1889
    pub fn set(self: Self, value: Bool) { self.value.store(value, Ordering.Relaxed) }
    // Rust: crates/jet-sema/src/Sema/mod.rs:1893
    pub fn get(self: Self) -> Bool { self.value.load(Ordering.Relaxed) }
    // Rust: crates/jet-sema/src/Sema/mod.rs:1899
    pub fn clone(self: Self) -> SharedFlag {
        flag :: SharedFlag.default()
        flag.set(self.get())
        flag
    }
}
