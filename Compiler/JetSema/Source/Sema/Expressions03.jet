    fn infer_mixed_operator(&self, op: BinOp, &lhs: Expr, &rhs: Expr, lt: Type, rt: Type, span: Span, &replacement: Expr?) -> Type? Never! {
        (trait_name, method) :: if op == { .Add -> (Syntax.TRAIT_ADD, "add"); .Sub -> (Syntax.TRAIT_SUB, "sub"); .Mul -> (Syntax.TRAIT_MUL, "mul"); .Div -> (Syntax.TRAIT_DIV, "div"); else -> return None }
        if lt == rt -> return None
        receiver_is_left := true
        row := self.trait_reg.operator_impl_for(lt, trait_name, rt)
        if row.is_none() && self.trait_reg.operator_impl_for(rt, trait_name, lt) == .Val(candidate) {
            if candidate.operator_marker == Val(OperatorMarker.Commutative) { row = Val(candidate); receiver_is_left = false }
        }
        receiver_ty :: if receiver_is_left -> lt else -> rt
        argument_ty :: if receiver_is_left -> rt else -> lt
        (result_ty, recv_type, operator_rhs) :: if row == .Val(selected) -> (selected.result, selected.left, Val(selected.rhs)) else -> {
            if !self.operator_bound_matches(receiver_ty, trait_name, argument_ty) -> return None
            (receiver_ty, trait_name, None)
