    fn direct_static_type_name(&self, expr: Expr) -> String? Never! {
        if expr == {
            .Ident(name, _) -> { if !name.is_empty() && self.lookup(name).is_none() -> return Val(name); None }
            .Field(base, member, _) -> { prefix :: self.direct_static_type_name(base) ?? return None; Val("{prefix}.{member}") }
            .Paren(inner, _) -> self.direct_static_type_name(inner)
            else -> None
        }
    }
