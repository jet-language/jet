    fn operator_operand_needs_borrow(&self, expr: Expr, op: BinOp) -> Bool Never! {
        operand :: expr.without_parens()
        if operand != .Field && operand != .Index -> return false
        if op == { .Eq | .Ne | .Compare | .Lt | .Le | .Gt | .Ge -> true; else -> false } -> return true
        trait_name :: if op == { .Add -> Syntax.TRAIT_ADD; .Sub -> Syntax.TRAIT_SUB; .Mul -> Syntax.TRAIT_MUL; .Div -> Syntax.TRAIT_DIV; else -> return false }
        ty :: self.operator_expr_type(operand) ?? return false
        if ty == .Named(name) -> return self.type_implements_trait_for_name(name, trait_name) || self.type_param_has_bound(ty, trait_name)
        false
    }
