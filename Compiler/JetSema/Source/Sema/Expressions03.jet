    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:983
    fn is_exact_numeric_literal(expr: Expr) -> Bool Never! {
        if expr == { .Int | .Float -> true; .Paren(inner, _) | .Unary(UnOp.Neg, inner, _) -> Self.is_exact_numeric_literal(inner); else -> false }
    }
