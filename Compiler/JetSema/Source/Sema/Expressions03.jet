    fn operator_bound_matches(&self, ty: Type, trait_name: String, rhs: Type) -> Bool Never! {
        if ty != .Named(name) -> return false
        loop param in self.type_param_scope {
            if param.name != name -> next
            typed :: "{trait_name}<{rhs.name()}>"
            return param.bounds.any(bound -> bound == typed || (bound == trait_name && rhs == ty))
        }
        false
    }
