    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:84
    fn path_prefix_guard(expr: Expr) -> (String, String)? Never! {
        if expr.without_parens() != .Unary(UnOp.Not, inner, _) -> return None
        call :: inner.without_parens()
        if call != .MethodCall -> return None
        if call.method != "starts_with" || call.args.len() != 1 || call.args[0].label.is_some() || call.args[0].spread -> return None
        candidate :: Self.path_ident(call.receiver) ?? return None
        if call.args[0].expr.without_parens() != .Str(parts, _) -> return None
        if parts.len() != 2 -> return None
        if parts[0] != .Interp(base, StrFormat.Display) -> return None
        if parts[1] != .Lit(separator) -> return None
        if separator != "/" -> return None
        Val((candidate, Self.path_ident(base) ?? return None))
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:119
    pub fn path_containment_string_prefix_edit(&self, lhs: Expr, rhs: Expr, span: Span) -> TextEdit? Never! {
        equality := lhs
        guard := rhs
        if Self.path_prefix_guard(rhs).is_none() {
            if Self.path_prefix_guard(lhs).is_none() -> return None
            equality = rhs
            guard = lhs
        }
        (candidate, base) :: Self.path_prefix_guard(guard) ?? return None
        if candidate == base -> return None
        if equality.without_parens() != .Binary(BinOp.Ne, left, right, _) -> return None
        left_name :: Self.path_ident(left) ?? return None
        right_name :: Self.path_ident(right) ?? return None
        if !((left_name == candidate && right_name == base) || (left_name == base && right_name == candidate)) -> return None
        candidate_source :: self.path_string_source(candidate) ?? return None
        base_source :: self.path_string_source(base) ?? return None
        if self.lookup(candidate).is_none() || self.lookup(base).is_none() -> return None
        if (self.lookup(candidate) ?? return None).ty != Type.String || (self.lookup(base) ?? return None).ty != Type.String -> return None
        Val(TextEdit{span: span, new_text: "!{candidate_source}.is_within({base_source})"})
    }
