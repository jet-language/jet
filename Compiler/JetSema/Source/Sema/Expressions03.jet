// Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:16
fn is_written_negative_int(expr: Expr) -> Bool Never! {
    if expr == {
        .Paren(inner, _) -> is_written_negative_int(inner)
        .Int(value, _, _, raw) -> exact_integer_literal(value, raw).negative
        .Unary(UnOp.Neg, inner, _) -> {
            if inner == .Int(value, _, _, raw) {
                exact :: exact_integer_literal(value, raw)
                return !exact.is_zero() && !exact.negative
            }
            false
        }
        else -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:33
fn simple_text_operand(expr: Expr) -> String? Never! {
    if expr.without_parens() == .Ident(name, _) -> return Val(name)
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:41
fn known_comptime_value(expr: Expr) -> CtValue? Never! {
    if expr == {
        .ComptimeName -> expr.value
        .EnumLit -> {
            if expr.args.is_empty() && !expr.type_name.is_empty() -> return Val(CtValue.Enum{type_name: expr.type_name, variant: expr.variant, args: [CtValue]{}})
            None
        }
        .Paren(inner, _) | .Copy(inner, _) -> known_comptime_value(inner)
        else -> None
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:61
fn is_folded_fact_expr(expr: Expr) -> Bool Never! {
    if expr == {
        .ComptimeName -> expr.value.is_some()
        .Paren(inner, _) | .Copy(inner, _) -> is_folded_fact_expr(inner)
        else -> false
    }
}

