    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:243
    fn minimal_literal_width(value: CtBigInt, peer: Type?) -> Type Never! {
        if peer != .Val(Type.IntN(signed, _)) -> return Type.Int
        loop bits in [U8]{8, 16, 32, 64} {
            interval :: integer_width_interval(signed, bits)
            if exact_integer_fits(value, interval.lo, interval.hi) -> return Type.IntN{signed: signed, bits: bits}
        }
        Type.Int
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:266
    fn minimal_integer_literal_type(&expr: Expr, peer: Type?) -> Type? Never! {
        if expr == {
            .Paren(inner, _) -> Self.minimal_integer_literal_type(&inner, peer)
            .Unary(UnOp.Neg, inner, _) -> {
                if inner != .Int(value, _, width, raw) -> return None
                if width.is_some() -> return None
                minimal :: Self.minimal_literal_width(exact_integer_literal(value, raw).neg(), peer)
                width = if minimal == .IntN(signed, bits) -> Val((signed, bits)) else -> None
                Val(minimal)
            }
            .Int(value, _, width, raw) -> {
                exact :: exact_integer_literal(value, raw)
                if width.is_some() || exact.compare(CtBigInt.from_int(0)) == .Less -> return None
                minimal :: Self.minimal_literal_width(exact, peer)
                width = if minimal == .IntN(signed, bits) -> Val((signed, bits)) else -> None
                Val(minimal)
            }
            else -> None
        }
    }
