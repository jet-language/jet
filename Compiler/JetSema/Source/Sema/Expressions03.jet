    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:684
    fn operator_expr_type(&self, expr: Expr) -> Type? Never! {
        if expr == {
            .Ident(name, _) -> { info :: self.lookup(name) ?? return None; Val(info.ty) }
            .Field(base, field, _) -> {
                owner := self.operator_expr_type(base) ?? return None
                loop { if owner == .Tagged(_, inner) { owner = inner } else { break } }
                (type_name, type_args) :: if owner == {
                    .Named(name) -> (name, None)
                    .Apply(name, args) -> (name, Val(args))
                    else -> return None
                }
                (import_ns, leaf) :: Self.split_type_name(type_name)
                owner_mod :: self.struct_owner_module(leaf, import_ns) ?? return None
                (registry, trait_reg) :: if owner_mod == self.module_idx -> (self.registry, self.trait_reg) else -> {
                    modules :: self.modules ?? return None
                    module :: modules.get(owner_mod) ?? return None
                    (module.registry, module.trait_reg)
                }
                subst := [String:Type]{}
                if type_args == .Val(args) && trait_reg.struct_params.get(leaf) == .Val(params) {
                    loop index in 0..<min(params.len(), args.len()) { subst.insert(params[index].name, args[index]) }
                }
                fields :: registry.struct_fields(leaf) ?? return None
                loop (candidate, _, ty) in fields { if candidate == field -> return Val(substitute_type(ty, subst)) }
                None
            }
            else -> None
        }
    }
