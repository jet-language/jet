    fn contextualize_numeric_literal(&self, &expr: Expr, target: Type) -> Type? Never! {
        if expr == {
            .Paren(inner, _) -> self.contextualize_numeric_literal(&inner, target)
            .Unary(UnOp.Neg, inner, _) -> {
                if (inner, target) == {
                    (.Int(value, span, width, raw), .InlineRange(base, lo, hi)) -> {
                        negated :: exact_integer_literal(value, raw).neg()
                        interval :: IntegerInterval.new(I128.from_int(lo), I128.from_int(hi))
                        if !exact_integer_fits(negated, interval.lo, interval.hi) -> self.diags.push(inline_range_literal_out_of_bounds(negated, lo, hi, span))
                        width = None
                        Val(Type.InlineRange(base, lo, hi))
                    }
                    (.Int(value, span, width, raw), .IntN(true, bits)) -> {
                        negated :: exact_integer_literal(value, raw).neg()
                        interval :: integer_width_interval(true, bits)
                        if !exact_integer_fits(negated, interval.lo, interval.hi) -> self.diags.push(int_range_error(true, bits, span))
                        width = Val((true, bits))
                        Val(target)
                    }
                    (_, .IntN(false, _)) -> None
                    else -> self.contextualize_numeric_literal(&inner, target)
                }
            }
            .Int(value, span, width, raw) -> {
                if target == {
                    .Int -> { width = None; Val(Type.Int) }
                    .InlineRange(base, lo, hi) -> {
                        exact :: exact_integer_literal(value, raw)
                        interval :: IntegerInterval.new(I128.from_int(lo), I128.from_int(hi))
                        if !exact_integer_fits(exact, interval.lo, interval.hi) -> self.diags.push(inline_range_literal_out_of_bounds(exact, lo, hi, span))
                        width = None
                        Val(Type.InlineRange(base, lo, hi))
                    }
                    .IntN(signed, bits) -> {
                        interval :: integer_width_interval(signed, bits)
                        exact :: exact_integer_literal(value, raw)
                        if !exact_integer_fits(exact, interval.lo, interval.hi) -> self.diags.push(int_range_error(signed, bits, span))
                        width = Val((signed, bits))
                        Val(target)
                    }
                    .Float | .Float32 -> {
                        exact_value :: exact_integer_literal(value, raw)
                        exact := false
                        if exact_value.try_i64() == .Val(integer) {
                            exact = if target == Type.Float32 -> I64.from_f32(F32.from_i64(integer)) == integer else -> I64.from_float(Float.from_i64(integer)) == integer
                        }
                        if !exact {
                            limit :: if target == Type.Float32 -> I128.from_int(1) << 24 else -> I128.from_int(1) << 53
                            self.diags.push(Diagnostic.error("E1003", "{value} does not fit exactly in {target.name()}", "{target.name()} holds every whole number only from -{limit} through {limit}", "use a whole-number type, or write a value from -{limit} through {limit}", Val(span)))
                        }
                        expr = Expr.Float(Float.from_int(value), span, target == Type.Float32, None)
                        Val(target)
                    }
                    else -> None
                }
            }
            .Float(_, _, is_f32, _) -> {
                if target == {
                    .Float -> { is_f32 = false; Val(Type.Float) }
                    .Float32 -> { is_f32 = true; Val(Type.Float32) }
                    else -> None
                }
            }
            else -> None
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:431
    pub fn widen_numeric_expr(&self, &expr: Expr, source: Type, target: Type) Never! {
        if source == target -> return
        erased :: source.erased_inline_ranges()
        if erased != source {
            self.require_knowledge_gate(KnowledgePlane.Range, KnowledgeGate.BoundedArithmetic, expr.span())
            if erased == target -> return
            self.widen_numeric_expr(&expr, erased, target)
            return
        }
        if self.contextualize_numeric_literal(&expr, target).is_some() -> return
        widening :: source.numeric_widening_to(target) ?? return
        span :: expr.span()
        approximate :: Self.take_numeric_approx_operand(&expr, span)
        gate :: if approximate.is_some() -> Val(KnowledgeGate.Approximation) else -> None
        checked :: knowledge_loss_requires_gate(KnowledgePlane.Exactness, gate)
        if checked && target == Type.Float32 && expr == .Float(_, _, is_f32, _) {
            is_f32 = true
            return
        }
        old :: if approximate == .Val(value) -> ^value else -> ^expr
        expr = Expr.MethodCall{receiver: Expr.Ident(target.name(), span), method: Syntax.conversion_method_for_source(source.name()), method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{CallArg{convention: AccessConvention.Read, expr: ^old, span: span, flags: CallArgFlags.default(), label: None, spread: false}}, recv_type: None, resolved_ret: Val(target), operator_rhs: None, checked_widen: widening && checked}
    }
