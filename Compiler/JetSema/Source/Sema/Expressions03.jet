    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:858
    fn direct_unit_raw(&self, expr: Expr, unit_fact: UnitFact) -> Bool Never! {
        operand :: if expr == .Paren(inner, _) -> inner else -> expr
        if operand != .MethodCall -> return false
        if operand.method != Syntax.METHOD_DISTINCT_RAW || !operand.args.is_empty() || operand.args.any(arg -> arg.label.is_some() || arg.spread) -> return false
        (_, raw_fact) :: self.direct_unit_value_fact(operand.receiver) ?? return false
        Self.same_unit_fact(raw_fact, unit_fact)
    }
