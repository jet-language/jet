    // Rust: crates/jet-sema/src/Sema/CheckerInfer/binary.rs:934
    pub fn unit_scalar_rewrap_identity(&self, receiver: Expr, method: String, args: [CallArg], inferred: Type?) -> Bool Never! {
        if !self.arithmetic_policy_stack.is_empty() || method != Syntax.numeric_conversion_method("Float").unwrap() || args.len() != 1 || args[0].label.is_some() || args[0].spread -> return false
        type_name :: self.direct_static_type_name(receiver) ?? return false
        (_, outer_fact) :: self.unit_fact_for_type(Type.Named(type_name)) ?? return false
        if !Self.is_scalable_unit_fact(outer_fact) -> return false
        inferred_ty :: inferred ?? return false
        (_, result_fact) :: self.unit_fact_for_type(inferred_ty) ?? return false
        if !Self.same_unit_fact(outer_fact, result_fact) -> return false
