        if value != .Binary(op, left, right, _) -> return false
        if op == {
            .Mul -> (self.direct_unit_raw(left, outer_fact) && self.direct_unit_scalar(right)) || (self.direct_unit_raw(right, outer_fact) && self.direct_unit_scalar(left))
            .Div -> self.direct_unit_raw(left, outer_fact) && self.direct_unit_scalar(right)
