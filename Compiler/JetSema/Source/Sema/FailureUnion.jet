// The failure union of functions that write no failure contract, and the
// plain-return projection.
//
// Every body check records what reaches the function's default `Err` route
// (`SemaCheckContext.failure_union_*`). After the one check of the bundle,
// the rows of the unannotated top-level functions are joined over their call
// edges (least fixed point). Function-owned cases (`Err(.NotFound(n))`) are
// minted into a closed `#Error enum` named after the function (`find` gives
// `FindError`), and every function whose set holds a typed member is projected
// onto `T (A | B)!` with no written span. Functions the solve proved infallible
// are projected onto `T Never!`. A union contract changes what its callers
// check against, so the modules that declare or reference one are checked
// again (`sema_failure_recheck_modules`); a `T Never!` projection is
// reconciled onto the bodies already checked
// (`sema_failure_reconcile_infallible`; lowering reads a callee's plain return
// against the `Result` carrier its call site names).
use jet_foundation.[
    symbol_table_key,
    Call,
    CallLabel,
    Diagnostic,
    EnumDef,
    EnumGroup,
    Expr,
    Func,
    Item,
    Marker,
    MarkerCallArg,
    expr_span,
    NamedSpan,
    Span,
    Symbol,
    TraitImplBlock,
    Type,
    TypeParam,
    Variant,
    VariantField,
    VariantPayload,
    type_identity_equal,
    type_union_sort,
    sema_casing_acronym_name,
    sema_casing_pascal_words,
    module_text,
    compiler_threads_joined,
]

// Rounds of the call-graph join before a still-growing row widens to the
// general `Err` (rule 5).
JET_FAILURE_UNION_JOIN_ROUND_CAP: 64

SemaFailureCaseField: struct {
    label: String?,
    ty: Type,
    // The argument's span, where a check against another payload reports.
    span: Span,
}

// One `Err(.Case(payload))` written where the default `Err`
// route is expected. The payload types come from the checked arguments.
SemaFailureCase: struct {
    name: String,
    payload: [SemaFailureCaseField],
    span: Span,
}

SemaFailureUnionRow: struct {
    key: String,
    name: String,
    module_index: Int,
    members: [Type],
    general: Bool,
    edges: [String],
    cases: [SemaFailureCase],
    // Position of the function's registry row in its module's `functions`.
    function_row: Int,
}

// A case creation the mint already reported: a case of a type it refused, or
// a creation whose payload differs from the case's first. Checking that
// creation can only restate the report, so the errors the check gives at it
// leave (sema_failure_union_drop_settled): any at the case itself (an untyped
// case, another payload count or label) and a payload type mismatch (E0108)
// at one of its `arguments`.
SemaFailureSettledCase: struct {
    module_index: Int,
    site: Span,
    arguments: [Span],
}

// A typed failure a caller could match: not the general `Err`, a message,
// `Never`, or a Core error family that converts into `Err`.
sema_failure_union_typed: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Union(members) -> {
            loop member in members {
                if sema_failure_union_typed(member) -> return true
            }
            false
        }
        .Named(name) -> name != "Err" && name != "Never" && !sema_core_error_family_member(name)
        .Apply(name, _) -> name != "Err" && name != "Never" && !sema_core_error_family_member(name)
        .String -> false
        .Int | .Float | .Bool | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> true
    }
}

// One failure reaching the default route: a message or the general `Err`
// marks the row general, `Never` adds nothing, a union adds each member.
sema_failure_union_add_member: fn(context: ^SemaCheckContext, ty: Type) Never! {
    if ty == {
        .Union(members) -> {
            loop member in members -> sema_failure_union_add_member(context, member)
            return
        }
        .String -> {
            context.failure_union_general = true
            return
        }
        .Named(name) -> {
            if name == "Err" {
                context.failure_union_general = true
                return
            }
            if name == "Never" {
                return
            }
        }
        .Int | .Float | .Bool | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    loop existing in context.failure_union_members {
        if type_identity_equal(existing, ty) {
            return
        }
    }
    context.failure_union_members.push(ty.copy())
}

sema_failure_union_unparen: fn(value: Expr) -> Expr Never! {
    if value == {
        .Paren(inner, _, _) -> sema_failure_union_unparen(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> value
    }
}

// The type a value has on its own, probed on the live tables and rolled back
// so the ordinary check that follows sees the body unchanged.
sema_failure_union_probe_type: fn(value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck) -> Type? {
    probe_diagnostics := [Diagnostic]{}
    checked: sema_probe_expression(value, None, environment, program, scopes, check, probe_diagnostics) ?? return None
    Val(checked.ty)
}

// Record the value an `Err(...)`
// sends down the default route. A leading-dot case with no type
// (`Err(.NotFound(n))`) becomes a case of the function's own error type with
// the payload types of its arguments; any other value is a member, and a
// message is the general `Err`.
sema_failure_union_record_err: fn(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck) {
    if call.args.len() != 1 || call.args[0].label != None {
        check.context.failure_union_general = true
        return
    }
    value: sema_failure_union_unparen(call.args[0].expr)
    if value == .EnumLit(owner, variant, _, args, _, span, _) {
        if owner == "" {
            payload := [SemaFailureCaseField]{}
            loop argument in args {
                if argument == {
                    .Positional(inner) -> {
                        payload.push(SemaFailureCaseField{label: None, ty: sema_failure_union_probe_type(inner, environment, program, scopes, check) ?? Type.Named{name: "_"}, span: expr_span(inner)})
                    }
                    .Named(label, inner) -> {
                        payload.push(SemaFailureCaseField{label: Val(label), ty: sema_failure_union_probe_type(inner, environment, program, scopes, check) ?? Type.Named{name: "_"}, span: expr_span(inner)})
                    }
                }
            }
            check.context.failure_union_cases.push(SemaFailureCase{name: variant, payload: payload, span: span})
            return
        }
    }
    if value == .Str(_, _, _) {
        check.context.failure_union_general = true
        return
    }
    ty: sema_failure_union_probe_type(value, environment, program, scopes, check) ?? {
        check.context.failure_union_general = true
        return
    }
    sema_failure_union_add_member(check.context, ty)
}

// `find` gives `FindError`; `parse_age` gives `ParseAgeError`; known
// acronyms keep their capitals (`read_http` gives `ReadHTTPError`).
sema_failure_union_type_name: fn(function: String) -> String Never! {
    "{sema_casing_acronym_name(sema_casing_pascal_words(function))}Error"
}

sema_failure_union_case_payload: fn(case_row: SemaFailureCase) -> VariantPayload Never! {
    if case_row.payload.len() == 0 -> return VariantPayload.Unit
    if case_row.payload.len() == 1 && case_row.payload[0].label == None {
        return VariantPayload.Single{ty: case_row.payload[0].ty, span: case_row.span}
    }
    fields := [VariantField]{}
    loop (index, field) in case_row.payload {
        fields.push(VariantField{name: field.label ?? "value{index + 1}", name_span: case_row.span, ty: field.ty, ty_span: case_row.span})
    }
    VariantPayload.Named{fields: fields}
}

sema_failure_union_same_payload: fn(left: VariantPayload, right: VariantPayload) -> Bool Never! {
    if left == {
        .Unit -> right == .Unit
        .Single(left_ty, _) -> if right == {
            .Single(right_ty, _) -> type_identity_equal(left_ty, right_ty)
            .Unit | .Named(_) -> false
        }
        .Named(left_fields) -> if right == {
            .Named(right_fields) -> {
                if left_fields.len() != right_fields.len() -> return false
                loop index in 0..<left_fields.len() {
                    if left_fields[index].name != right_fields[index].name || !type_identity_equal(left_fields[index].ty, right_fields[index].ty) {
                        return false
                    }
                }
                true
            }
            .Unit | .Single(_, _) -> false
        }
    }
}

// The minted type is the `#Error #Printable #Debug enum` the function's cases
// spell, so its report shows with `{e}` and `{e:Debug}` when every payload
// can be shown. It takes no structural equality: those providers attach at
// registration, before any type is minted.
sema_failure_union_enum: fn(type_name_text: String, function: Func, variants: [Variant]) -> EnumDef Never! {
    span: function.name_span
    markers: [Marker]{sema_failure_union_marker("Error", span), sema_failure_union_marker("Printable", span), sema_failure_union_marker("Debug", span)}
    definition := EnumDef{
        span: function.span,
        is_pub: function.is_pub,
        is_package_pub: function.is_package_pub,
        name: type_name_text,
        name_span: function.name_span,
        type_params: [TypeParam]{},
        variants: variants,
        methods: [Func]{},
        trait_impls: [TraitImplBlock]{},
        derives: [NamedSpan]{},
        auto_derive_default: false,
        is_single_use: false,
        single_use_span: None,
        is_must_use: false,
        must_use_span: None,
        serde_markers: [Marker]{},
        type_markers: markers,
        groups: [EnumGroup]{},
    }
    if sema_type_metadata_enum_auto_ok(definition) {
        definition.derives = [NamedSpan]{NamedSpan{name: "Printable", span: span}, NamedSpan{name: "Debug", span: span}}
    }
    definition
}

sema_failure_union_marker: fn(name: String, span: Span) -> Marker Never! {
    Marker{name: name, negated: false, name_span: span, args: [MarkerCallArg]{}, arg_labels: [CallLabel?]{}, span: span, ct: None}
}

// Mint the function's own closed `#Error enum` from the cases
// its body creates, register it in the owning module and add it to the
// module's items so every tier emits it. Returns the minted type. The
// replaced module row and (before the first mint) the nominal indexes are
// recorded on `trail`. Each case creation a report here covers is listed on
// `settled`.
sema_failure_union_mint: fn(graph: ^SemaRegistrationGraph, row: SemaFailureUnionRow, diagnostics: ^[Diagnostic], trail: ^SemaGraphTrail, settled: ^[SemaFailureSettledCase]) -> Type? {
    if row.cases.len() == 0 -> return None
    name: row.name
    owned: sema_failure_union_type_name(name)
    segments := graph.modules[row.module_index].source_segments
    clash := sema_registration_module_has_name(graph.modules[row.module_index], owned) || sema_registration_module_has_import_name(graph.modules[row.module_index], owned) || sema_registration_namespace_owner(graph, row.module_index, owned) != None
    start: diagnostics.len()
    if clash {
        diagnostics.push(sema_error("E0105", row.cases[0].span, "`{name}` creates error cases, but the type `{owned}` already exists", "cases written as `Err(.Case(…))` in `{name}` form its own error type, named `{owned}` after the function", "write the failure contract of `{name}` (for example `-> T {owned}!`), or rename the declared `{owned}`"))
        sema_attach_diagnostic_source_locations(diagnostics, start, segments)
        sema_failure_union_settle_untyped(row, settled)
        return None
    }
    variants := [Variant]{}
    loop case_row in row.cases {
        payload: sema_failure_union_case_payload(case_row)
        existing_index := -1
        loop (index, variant) in variants {
            if variant.name == case_row.name -> existing_index = index
        }
        if existing_index >= 0 {
            if !sema_failure_union_same_payload(variants[existing_index].payload, payload) {
                diagnostics.push(sema_error("E0105", case_row.span, "case `.{case_row.name}` of `{owned}` is created with two different payloads", "every `Err(.{case_row.name}(…))` in `{name}` adds to the one type `{owned}`, so each case has one payload", "give the two failures different case names, or pass the same payload types to `.{case_row.name}`"))
                arguments := [Span]{}
                loop field in case_row.payload -> arguments.push(field.span)
                settled.push(SemaFailureSettledCase{module_index: row.module_index, site: case_row.span, arguments: arguments})
            }
            next
        }
        variants.push(Variant{name: case_row.name, name_span: case_row.span, payload: payload, discriminant: None, discriminant_expr: None, serde_markers: [Marker]{}})
    }
    definition: sema_failure_union_enum(owned, graph.modules[row.module_index].functions[row.function_row].declaration, variants)
    item: Item.Enum{value: definition}
    // The type registers in the module in place; the trail records the
    // appended rows (copying the module, every row of its program, twice per
    // minted type was the cost of the old whole-row record).
    module_index: row.module_index
    mark: sema_graph_module_mark(graph.modules[module_index])
    first_nominal: graph.modules[module_index].nominals.len()
    source_file: graph.modules[module_index].source_file.copy()
    source_origin: graph.modules[module_index].source_origin.copy()
    register_diagnostics := [Diagnostic]{}
    registered_module: module_text(graph.module_table, graph.modules[module_index].module_identity)
    if !sema_registration_add_root(graph.modules[module_index], registered_module, graph.symbols, item, source_file, source_origin, segments, register_diagnostics) || register_diagnostics.len() > 0 {
        sema_graph_module_rollback(graph.modules[module_index], mark, owned)
        loop diagnostic in register_diagnostics -> diagnostics.push(diagnostic)
        sema_attach_diagnostic_source_locations(diagnostics, start, segments)
        sema_failure_union_settle_untyped(row, settled)
        return None
    }
    graph.modules[module_index].program.items.push(item.move())
    // copy: the export row stores its own symbol, while the registered symbol row stays in the
    // module, and `graph` is written (exports.push) while it is live.
    symbol: graph.modules[module_index].symbols[graph.modules[module_index].symbols.len() - 1].copy()
    module_identity: graph.modules[module_index].module_identity.copy()
    if symbol.visibility > 0 {
        graph.modules[module_index].exports.push(SemaRegistrationExport{name: symbol.name, symbol: symbol, declaration_position: sema_registration_declaration_position(graph.modules[module_index], symbol), source_module_identity: module_identity, visibility: symbol.visibility})
    }
    trail.entries.push(SemaGraphUndo.ModuleAppend{module_index: module_index, mark: mark, name: owned})
    if !trail.nominal_indexes_saved {
        trail.entries.push(SemaGraphUndo.NominalIndexes{symbol_rows: graph.nominal_symbol_rows, slots: graph.nominal_row_names, buckets: graph.nominal_row_buckets})
        trail.nominal_indexes_saved = true
    }
    sema_registration_index_nominal_rows(graph, module_index, first_nominal)
    sema_attach_diagnostic_source_locations(diagnostics, start, segments)
    Val(Type.Named{name: owned})
}

// A refused mint leaves every case `row` creates without a type; its report
// covers them all.
sema_failure_union_settle_untyped: fn(row: SemaFailureUnionRow, settled: ^[SemaFailureSettledCase]) Never! {
    loop case_row in row.cases {
        settled.push(SemaFailureSettledCase{module_index: row.module_index, site: case_row.span, arguments: [Span]{}})
    }
}

// Whether `diagnostic` restates the mint's report on `case_row`: an error at
// the case itself, or a payload type mismatch at one of its arguments.
sema_failure_union_restates: fn(diagnostic: Diagnostic, case_row: SemaFailureSettledCase) -> Bool Never! {
    if !diagnostic.code.starts_with("E") -> return false
    span: diagnostic.span ?? return false
    if span.start == case_row.site.start && span.end == case_row.site.end -> return true
    if diagnostic.code != "E0108" -> return false
    loop argument in case_row.arguments {
        if span.start == argument.start && span.end == argument.end -> return true
    }
    false
}

// Drops from each module's reports the errors that restate a settled case
// (SemaFailureSettledCase), from the back, so the kept reports are never
// copied.
sema_failure_union_drop_settled: fn(modules: ^[SemaGraphModuleResult], settled: [SemaFailureSettledCase]) Never! {
    loop case_row in settled {
        if case_row.module_index < 0 || case_row.module_index >= modules.len() -> next
        index := modules[case_row.module_index].diagnostics.len()
        loop index > 0 {
            index -= 1
            if sema_failure_union_restates(modules[case_row.module_index].diagnostics[index], case_row) {
                _ := modules[case_row.module_index].diagnostics.remove(index, .Slot)
            }
        }
    }
}

sema_failure_union_flatten: fn(ty: Type, flat: ^[Type]) Never! {
    if ty == .Union(members) {
        loop member in members -> sema_failure_union_flatten(member, flat)
        return
    }
    loop existing in flat {
        if type_identity_equal(existing, ty) {
            return
        }
    }
    flat.push(ty.copy())
}

// Flatten nested unions, drop exact duplicates and put the rest in the
// canonical order (type_union_sort); one surviving member is that member.
sema_failure_union_canonical: fn(members: [Type]) -> Type Never! {
    flat := [Type]{}
    loop member in members -> sema_failure_union_flatten(member, flat)
    type_union_sort(flat)
    if flat.len() == 0 -> return Type.Named{name: "Unit"}
    if flat.len() == 1 -> return flat[0]
    Type.Union{members: flat}
}

// The success side of an unwritten contract.
sema_failure_union_success: fn(function: Func) -> Type Never! {
    // copy: `written` is a payload of read parameter `function`, which keeps the original; the returned value owns this one
    if function.return_type == .Val(written) -> return written.copy()
    Type.Named{name: "Unit"}
}

// One contract to project: the function key, its registered top-level row,
// and the new return type.
SemaFailureProjection: struct {
    key: String,
    module_index: Int,
    row: Int,
    return_type: Type,
}

// The top-level function row `function_key` registers in `module_index`,
// through its SymbolId; -1 when that module declares none.
sema_failure_function_row: fn(graph: SemaRegistrationGraph, module_index: Int, function_key: String) -> Int Never! {
    row: sema_registration_callable_row(graph, function_key) ?? return -1
    if row == .Function(declaring, index) {
        if declaring == module_index -> return index
    }
    -1
}

// Project contracts onto each declaration, its registry row and symbol, the
// module items and every import binding of it: the written-span-less return
// type every later check and lowering read. Rows are replaced in place, and the
// declaring modules and every import binding are walked once for the whole
// batch, not once per function. Every replaced row is recorded on `trail`.
sema_failure_project_returns: fn(graph: ^SemaRegistrationGraph, projections: [SemaFailureProjection], trail: ^SemaGraphTrail) {
    if projections.len() == 0 {
        return
    }
    // Projected symbol id -> its new symbol and item; per declaring module
    // (slot `declaring_slot[module]`), its projected ids and name -> id, for
    // the rows of that module.
    symbols := [U32:Symbol]{}
    items := [U32:Item]{}
    slot_keys := [[U32:Bool]]{}
    slot_names := [[String:U32]]{}
    declaring := [Int]{}
    declaring_slot := [Int]{}
    loop _ in 0..<graph.modules.len() -> declaring_slot.push(-1)
    unused_diagnostics := [Diagnostic]{}
    loop projection in projections {
        module_index: projection.module_index
        // copy: the projected declaration is a new row; the old row stays on the trail.
        updated := sema_registration_function_with_body(graph.modules[module_index], graph.modules[module_index].functions[projection.row])
        updated.return_type = Val(projection.return_type)
        updated.return_type_span = None
        row := sema_registration_function(updated, graph.modules[module_index].functions[projection.row].raw_protocol_return, graph.modules[module_index].module_identity, module_text(graph.module_table, graph.modules[module_index].module_identity), None, graph.symbols, graph.modules[module_index].source_file, graph.modules[module_index].source_origin, graph.modules[module_index].source_segments, unused_diagnostics, false, graph.modules[module_index].functions[projection.row].item_index)
        if declaring_slot[module_index] < 0 {
            declaring_slot[module_index] = declaring.len()
            declaring.push(module_index)
            slot_keys.push([U32:Bool]{})
            slot_names.push([String:U32]{})
        }
        slot: declaring_slot[module_index]
        id: row.symbol.id.id
        symbols[id] = Symbol{id: row.symbol.id, kind: row.symbol.kind, name: row.symbol.name, module_identity: row.symbol.module_identity, owner: row.symbol.owner, span: row.symbol.span, ty: Val(row.signature), visibility: row.symbol.visibility}
        slot_keys[slot][id] = true
        slot_names[slot][updated.name] = id
        items[id] = Item.Func{value: updated.move()}
        trail.entries.push(SemaGraphUndo.FunctionRow{module_index: module_index, row: projection.row, old: graph.modules[module_index].functions[projection.row]})
        graph.modules[module_index].functions[projection.row] = row.move()
    }
    loop (slot, module_index) in declaring {
        loop index in 0..<graph.modules[module_index].symbols.len() {
            if slot_keys[slot].get(graph.modules[module_index].symbols[index].id.id) == None -> next
            symbol: symbols.get(graph.modules[module_index].symbols[index].id.id) ?? next
            trail.entries.push(SemaGraphUndo.SymbolRow{module_index: module_index, position: index, old: graph.modules[module_index].symbols[index]})
            graph.modules[module_index].symbols[index] = symbol
        }
        loop index in 0..<graph.modules[module_index].declarations.len() {
            found := U32?{None}
            if graph.modules[module_index].declarations[index] == .Func(declared) {
                found = slot_names[slot].get(declared.name)
            }
            key: found ?? next
            item: items.get(key) ?? next
            trail.entries.push(SemaGraphUndo.DeclarationRow{module_index: module_index, position: index, old: graph.modules[module_index].declarations[index]})
            graph.modules[module_index].declarations[index] = sema_registration_declared_item(item)
        }
        loop index in 0..<graph.modules[module_index].program.items.len() {
            found := U32?{None}
            if graph.modules[module_index].program.items[index] == .Func(declared) {
                found = slot_names[slot].get(declared.name)
            }
            key: found ?? next
            item: items.get(key) ?? next
            trail.entries.push(SemaGraphUndo.ProgramItemRow{module_index: module_index, position: index, old: graph.modules[module_index].program.items[index]})
            graph.modules[module_index].program.items[index] = item
        }
        loop index in 0..<graph.modules[module_index].exports.len() {
            if graph.modules[module_index].exports[index].target_symbol_row >= 0 {
                next
            }
            if slot_keys[slot].get(graph.modules[module_index].exports[index].symbol.id.id) == None {
                next
            }
            symbol: symbols.get(graph.modules[module_index].exports[index].symbol.id.id) ?? next
            trail.entries.push(SemaGraphUndo.ExportRow{module_index: module_index, position: index, old: graph.modules[module_index].exports[index]})
            graph.modules[module_index].exports[index].symbol = symbol
        }
    }
    loop importer_index in 0..<graph.modules.len() {
        loop import_index in 0..<graph.modules[importer_index].imports.len() {
            loop binding_index in 0..<graph.modules[importer_index].imports[import_index].bindings.len() {
                if graph.modules[importer_index].imports[import_index].bindings[binding_index].target_symbol_row >= 0 {
                    next
                }
                symbol: symbols.get(graph.modules[importer_index].imports[import_index].bindings[binding_index].symbol.id.id) ?? next
                trail.entries.push(SemaGraphUndo.ImportBindingRow{module_index: importer_index, import_index: import_index, binding: binding_index, old: graph.modules[importer_index].imports[import_index].bindings[binding_index]})
                graph.modules[importer_index].imports[import_index].bindings[binding_index].symbol = symbol
            }
        }
    }
}

// The union contracts one bundle projected: their function keys, the
// modules whose declarations changed (a projected function's or a minted
// `#Error enum`'s declaring module), whether any type was minted, and the
// case creations the mint's reports cover.
SemaFailureUnionProjected: struct {
    keys: [String],
    modules: [Int],
    minted: Bool,
    settled: [SemaFailureSettledCase],
}

// Join the default-route rows of the unannotated
// top-level functions, mint their own cases and project every set that holds
// a typed member. The rows of each part of the modules `bounds` splits
// (sema_failure_module_bounds) are read on its own thread and join in module
// order.
sema_failure_union_infer: fn(graph: ^SemaRegistrationGraph, modules: [SemaGraphModuleResult], bounds: [Int], diagnostics: ^[Diagnostic], trail: ^SemaGraphTrail) -> SemaFailureUnionProjected {
    projected := SemaFailureUnionProjected{keys: [String]{}, modules: [Int]{}, minted: false, settled: [SemaFailureSettledCase]{}}
    rows := [SemaFailureUnionRow]{}
    entry_index: sema_registration_module_index(graph, graph.entry_module_identity) ?? -1
    loop part in sema_failure_union_row_parts(graph, modules, entry_index, bounds, 0) {
        rows.extend(part)
    }
    if rows.len() == 0 -> return projected
    loop row_index in 0..<rows.len() {
        minted: sema_failure_union_mint(graph, rows[row_index], diagnostics, trail, projected.settled) ?? next
        rows[row_index].members.push(minted)
        projected.modules.push(rows[row_index].module_index)
        projected.minted = true
    }
    // Edge targets resolve through one key -> row map (the last row of a key,
    // as the per-edge scan found), not a scan of every row per edge.
    row_slots := [String:Int]{}
    loop (row_index, row) in rows -> row_slots[row.key] = row_index
    settled := false
    round := 0
    loop round < JET_FAILURE_UNION_JOIN_ROUND_CAP {
        changed := false
        loop row_index in 0..<rows.len() {
            edges := rows[row_index].edges.copy()
            key: rows[row_index].key.copy()
            loop edge in edges {
                if edge == key -> next
                incoming := [Type]{}
                incoming_general := true
                if row_slots.get(edge) == .Val(other) {
                    incoming = rows[other].members.copy()
                    incoming_general = rows[other].general
                }
                loop member in incoming {
                    known := false
                    loop existing in rows[row_index].members {
                        if type_identity_equal(existing, member) -> known = true
                    }
                    if !known {
                        rows[row_index].members.push(member)
                        changed = true
                    }
                }
                if incoming_general && !rows[row_index].general {
                    rows[row_index].general = true
                    changed = true
                }
            }
        }
        if !changed {
            settled = true
            break
        }
        round += 1
    }
    projections := [SemaFailureProjection]{}
    loop row in rows {
        typed: loop member in row.members {
            if sema_failure_union_typed(member) {
                break true
            }
        } ?? false
        if !typed -> next
        function_row: sema_failure_function_row(graph, row.module_index, row.key)
        if function_row < 0 -> next
        members := row.members.copy()
        if row.general || !settled -> members.push(Type.Named{name: "Err"})
        contract: Type.Result{ok: sema_failure_union_success(graph.modules[row.module_index].functions[row.function_row].declaration), err: sema_failure_union_canonical(members)}
        projections.push(SemaFailureProjection{key: row.key, module_index: row.module_index, row: function_row, return_type: contract})
        projected.keys.push(row.key)
        projected.modules.push(row.module_index)
    }
    sema_failure_project_returns(graph, projections, trail)
    projected
}

// The union rows of parts `at..<bounds.len() - 1`, in part order: the first
// part on its own thread, the ones after it the same way, and the last on
// this one.
sema_failure_union_row_parts: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], entry_index: Int, bounds: [Int], at: Int) -> [[SemaFailureUnionRow]] Never! {
    done := [[SemaFailureUnionRow]]{}
    if at + 1 >= bounds.len() -> return done
    if at + 2 == bounds.len() {
        done.push(sema_failure_union_row_part(graph, modules, entry_index, bounds[at], bounds[at + 1]))
        return done
    }
    task.group sema_failure_union_row_threads {
        head: task sema_failure_union_row_part(graph, modules, entry_index, bounds[at], bounds[at + 1])
        rest: sema_failure_union_row_parts(graph, modules, entry_index, bounds, at + 1)
        done.push(compiler_threads_joined(head))
        loop part in rest.move() -> done.push(part)
    }
    done
}

// The union row of each unannotated top-level function among the failure
// facts of modules `from..<to`.
sema_failure_union_row_part: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], entry_index: Int, from: Int, to: Int) -> [SemaFailureUnionRow] Never! {
    rows := [SemaFailureUnionRow]{}
    loop at in from..<to {
        module_index: sema_registration_module_index(graph, modules[at].module_identity) ?? next
        loop facts in modules[at].failure_facts {
            function_row: sema_failure_function_row(graph, module_index, facts.function_key)
            if function_row < 0 || !sema_failure_inference_candidate(graph.modules[module_index].functions[function_row].declaration) {
                next
            }
            // The entry `run: fn` carries the default `Unit Err!` exit
            // contract, so its failures meet `Err` instead of joining an
            // inferred union.
            if module_index == entry_index && graph.modules[module_index].functions[function_row].declaration.name == "run" {
                next
            }
            rows.push(SemaFailureUnionRow{key: facts.function_key.copy(), name: graph.modules[module_index].functions[function_row].declaration.name.copy(), module_index: module_index, members: facts.union_members.copy(), general: facts.union_general, edges: facts.union_edges.copy(), cases: facts.union_cases.copy(), function_row: function_row})
        }
    }
    rows
}

// #3708 (card item T1): every function the failure solve proved infallible is
// projected onto the `T Never!` carrier with no written span, which every
// tier lowers as a plain return. A function a compile-time evaluation checked
// is projected too: its reused body, like every body checked before the
// solve, is reconciled (sema_failure_reconcile_infallible), its callers keep
// the carrier they were checked against, and every finalization undoes the
// projection on `trail` before a later comptime run reads the graph. An
// inherent method is projected onto its registered row, and its checked body
// is reconciled like a function's. Returns the projected keys. Every replaced
// row is recorded on `trail`.
sema_failure_project_infallible: fn(graph: ^SemaRegistrationGraph, solved: [String], trail: ^SemaGraphTrail) -> [String] {
    projections := [SemaFailureProjection]{}
    methods := [String]{}
    loop key in solved {
        row: sema_registration_callable_row(graph, key) ?? next
        if row == {
            .Function(module_index, index) -> {
                contract: Type.Result{ok: sema_failure_union_success(graph.modules[module_index].functions[index].declaration), err: Type.Named{name: "Never"}}
                projections.push(SemaFailureProjection{key: key, module_index: module_index, row: index, return_type: contract})
            }
            .Foreign(_, _) -> {}
            .NominalMethod(_, _, _) | .ImplMethod(_, _, _) -> {
                loop site in sema_failure_method_rows(graph, row) {
                    sema_failure_project_method_site(graph, site, trail)
                }
                methods.push(key.copy())
            }
        }
    }
    sema_failure_project_returns(graph, projections, trail)
    projected := loop projection in projections -> projection.key
    loop key in methods -> projected.push(key)
    projected
}

// Projects one registered row of an infallible method (sema_failure_method_rows).
sema_failure_project_method_site: fn(graph: ^SemaRegistrationGraph, site: SemaRegistrationCallableRow, trail: ^SemaGraphTrail) {
    if site == {
        .NominalMethod(module_index, owner, index) -> {
            projected: sema_failure_infallible_method_row(graph.modules[module_index].nominals[owner].methods[index], graph.modules[module_index], graph.symbols)
            trail.entries.push(SemaGraphUndo.NominalMethodRow{module_index: module_index, owner: owner, row: index, old: graph.modules[module_index].nominals[owner].methods[index]})
            graph.modules[module_index].nominals[owner].methods[index] = projected.move()
        }
        .ImplMethod(module_index, owner, index) -> {
            projected: sema_failure_infallible_method_row(graph.modules[module_index].impls[owner].methods[index], graph.modules[module_index], graph.symbols)
            trail.entries.push(SemaGraphUndo.ImplMethodRow{module_index: module_index, owner: owner, row: index, old: graph.modules[module_index].impls[owner].methods[index]})
            graph.modules[module_index].impls[owner].methods[index] = projected.move()
        }
        .Function(_, _) | .Foreign(_, _) -> {}
    }
}

// `method`'s registered row with the span-less `T Never!` return: its
// declaration, signature and symbol type.
sema_failure_infallible_method_row: fn(method: SemaRegistrationFunction, module_row: SemaRegistrationModule, symbols: SymbolTable) -> SemaRegistrationFunction {
    // copy: the projected row is new; the old row stays on the trail.
    updated := method.copy()
    updated.declaration.return_type = Val(Type.Result{ok: sema_failure_union_success(method.declaration), err: Type.Named{name: "Never"}})
    updated.declaration.return_type_span = None
    signature: sema_registration_function_signature(updated.declaration, method.raw_protocol_return, symbol_table_key(symbols, method.symbol.id), module_row.source_file, module_row.source_origin, module_row.source_segments)
    updated.symbol.ty = Val(signature)
    updated.signature = signature
    updated
}
