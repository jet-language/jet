// The failure union of functions that
// write no failure contract, and the #3708 plain-return projection. The Rust
// reference is crates/jet-sema/src/Sema/Bundle/Pipeline/FailureUnion.rs and
// `solve_inferred_failure` (Sema/mod.rs).
//
// Every body check records what reaches the function's default `Err` route
// (`SemaCheckContext.failure_union_*`). After the one check of the bundle,
// the rows of the unannotated top-level functions are joined over their call
// edges (least fixed point). Function-owned cases (`Err(.NotFound(n))`) are
// minted into a closed `#Error enum` named after the function (`find` gives
// `FindError`), and every function whose set holds a typed member is projected
// onto `T (A | B)!` with no written span. Functions the #3708 solve proved
// infallible are projected onto `T Never!`. A union contract changes what its
// callers check against, so the modules that declare or reference one are
// checked again (`sema_failure_recheck_modules`); a `T Never!` projection is
// reconciled onto the bodies already checked, as the Rust reference does
// (`sema_failure_reconcile_infallible`; lowering reads a callee's plain return
// against the `Result` carrier its call site names, #3740).
use jet_foundation.[
    Call,
    CallLabel,
    Diagnostic,
    EnumDef,
    EnumGroup,
    Expr,
    Func,
    Item,
    Marker,
    MarkerCallArg,
    NamedSpan,
    Span,
    Symbol,
    TraitImplBlock,
    Type,
    TypeParam,
    Variant,
    VariantField,
    VariantPayload,
    type_identity_equal,
    type_name,
    sema_casing_pascal_words,
]

// Rounds of the call-graph join before a still-growing row widens to the
// general `Err` (rule 5).
JET_FAILURE_UNION_JOIN_ROUND_CAP :: 64

struct SemaFailureCaseField {
    label: String?
    ty: Type
}

// One `Err(.Case(payload))` written where the default `Err`
// route is expected. The payload types come from the checked arguments.
struct SemaFailureCase {
    name: String
    payload: [SemaFailureCaseField]
    span: Span
}

struct SemaFailureUnionRow {
    key: String
    name: String
    module_index: Int
    members: [Type]
    general: Bool
    edges: [String]
    cases: [SemaFailureCase]
    // Position of the function's registry row in its module's `functions`.
    function_row: Int
}

// A typed failure a caller could match: not the general `Err`, a message,
// `Never`, or a Core error family that converts into `Err`.
fn sema_failure_union_typed(ty: Type) -> Bool Never! {
    if ty == {
        .Union(members) -> {
            loop member in members {
                if sema_failure_union_typed(member) -> return true
            }
            false
        }
        .Named(name) -> name != "Err" && name != "Never" && !sema_core_error_family_member(name)
        .Apply(name, _) -> name != "Err" && name != "Never" && !sema_core_error_family_member(name)
        .String -> false
        else -> true
    }
}

// One failure reaching the default route: a message or the general `Err`
// marks the row general, `Never` adds nothing, a union adds each member.
fn sema_failure_union_add_member(context: &SemaCheckContext, ty: Type) Never! {
    if ty == {
        .Union(members) -> {
            loop member in members -> sema_failure_union_add_member(&context, member)
            return
        }
        .String -> {
            context.failure_union_general = true
            return
        }
        .Named(name) -> {
            if name == "Err" {
                context.failure_union_general = true
                return
            }
            if name == "Never" -> return
        }
        else -> {}
    }
    loop existing in context.failure_union_members {
        if type_identity_equal(existing, ty) -> return
    }
    &context.failure_union_members.push(ty)
}

fn sema_failure_union_unparen(value: Expr) -> Expr Never! {
    if value == {
        .Paren(inner, _) -> sema_failure_union_unparen(inner)
        else -> value
    }
}

// The type a value has on its own, probed on the live tables and rolled back
// so the ordinary check that follows sees the body unchanged.
fn sema_failure_union_probe_type(value: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Type? {
    probe_diagnostics := [Diagnostic]{}
    checked :: sema_probe_expression(value, None, environment, program, &scopes, &state, &tail_store, &context, &probe_diagnostics) ?? return None
    Val(checked.ty)
}

// Record the value an `Err(...)`
// sends down the default route. A leading-dot case with no type
// (`Err(.NotFound(n))`) becomes a case of the function's own error type with
// the payload types of its arguments; any other value is a member, and a
// message is the general `Err`.
fn sema_failure_union_record_err(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) {
    if call.args.len() != 1 || call.args[0].label != None {
        context.failure_union_general = true
        return
    }
    value :: sema_failure_union_unparen(call.args[0].expr)
    if value == .EnumLit(owner, variant, _, args, _, span) {
        if owner == "" {
            payload := [SemaFailureCaseField]{}
            loop argument in args {
                if argument == {
                    .Positional(inner) -> &payload.push(SemaFailureCaseField{label: None, ty: sema_failure_union_probe_type(inner, environment, program, &scopes, &state, &tail_store, &context) ?? Type.Named{name: "_"}})
                    .Named(label, inner) -> &payload.push(SemaFailureCaseField{label: Val(label), ty: sema_failure_union_probe_type(inner, environment, program, &scopes, &state, &tail_store, &context) ?? Type.Named{name: "_"}})
                }
            }
            &context.failure_union_cases.push(SemaFailureCase{name: variant, payload: payload, span: span})
            return
        }
    }
    if value == .Str(_, _) {
        context.failure_union_general = true
        return
    }
    ty :: sema_failure_union_probe_type(value, environment, program, &scopes, &state, &tail_store, &context) ?? {
        context.failure_union_general = true
        return
    }
    sema_failure_union_add_member(&context, ty)
}

// `find` gives `FindError`; `parse_age` gives `ParseAgeError`; known
// acronyms keep their capitals (`read_http` gives `ReadHTTPError`).
fn sema_failure_union_type_name(function: String) -> String Never! {
    "{sema_casing_acronym_name(sema_casing_pascal_words(function))}Error"
}

fn sema_failure_union_case_payload(case_row: SemaFailureCase) -> VariantPayload Never! {
    if case_row.payload.len() == 0 -> return VariantPayload.Unit
    if case_row.payload.len() == 1 && case_row.payload[0].label == None -> return VariantPayload.Single{ty: case_row.payload[0].ty, span: case_row.span}
    fields := [VariantField]{}
    loop (index, field) in case_row.payload {
        &fields.push(VariantField{name: field.label ?? "value{index + 1}", name_span: case_row.span, ty: field.ty, ty_span: case_row.span})
    }
    VariantPayload.Named{fields: fields}
}

fn sema_failure_union_same_payload(left: VariantPayload, right: VariantPayload) -> Bool Never! {
    if left == {
        .Unit -> right == .Unit
        .Single(left_ty, _) -> if right == {
            .Single(right_ty, _) -> type_identity_equal(left_ty, right_ty)
            else -> false
        }
        .Named(left_fields) -> if right == {
            .Named(right_fields) -> {
                if left_fields.len() != right_fields.len() -> return false
                loop index in 0..<left_fields.len() {
                    if left_fields[index].name != right_fields[index].name || !type_identity_equal(left_fields[index].ty, right_fields[index].ty) -> return false
                }
                true
            }
            else -> false
        }
    }
}

fn sema_failure_union_enum(type_name_text: String, function: Func, variants: [Variant]) -> EnumDef Never! {
    marker :: Marker{name: "Error", negated: false, name_span: function.name_span, args: [MarkerCallArg]{}, arg_labels: [CallLabel?]{}, span: function.name_span, ct: None}
    EnumDef{
        span: function.span,
        is_pub: function.is_pub,
        is_package_pub: function.is_package_pub,
        name: type_name_text,
        name_span: function.name_span,
        type_params: [TypeParam]{},
        variants: variants,
        methods: [Func]{},
        trait_impls: [TraitImplBlock]{},
        derives: [NamedSpan]{},
        auto_derive_default: false,
        is_single_use: false,
        single_use_span: None,
        is_must_use: false,
        must_use_span: None,
        serde_markers: [Marker]{},
        type_markers: [Marker]{marker},
        groups: [EnumGroup]{},
    }
}

// Mint the function's own closed `#Error enum` from the cases
// its body creates, register it in the owning module and add it to the
// module's items so every tier emits it. Returns the minted type. The
// replaced module row and (before the first mint) the nominal indexes are
// recorded on `trail`.
fn sema_failure_union_mint(graph: &SemaRegistrationGraph, row: SemaFailureUnionRow, diagnostics: &[Diagnostic], trail: &SemaGraphTrail) -> Type? {
    if row.cases.len() == 0 -> return None
    name :: row.name
    owned :: sema_failure_union_type_name(name)
    segments := graph.modules[row.module_index].source_segments
    clash := sema_registration_module_has_name(graph.modules[row.module_index], owned) || sema_registration_module_has_import_name(graph.modules[row.module_index], owned) || sema_registration_namespace_owner(graph, row.module_index, owned) != None
    start :: diagnostics.len()
    if clash {
        &diagnostics.push(sema_error("E0105", row.cases[0].span, "`{name}` creates error cases, but the type `{owned}` already exists", "cases written as `Err(.Case(…))` in `{name}` form its own error type, named `{owned}` after the function", "write the failure contract of `{name}` (for example `-> T {owned}!`), or rename the declared `{owned}`"))
        sema_attach_diagnostic_source_locations(&diagnostics, start, segments)
        return None
    }
    variants := [Variant]{}
    loop case_row in row.cases {
        payload :: sema_failure_union_case_payload(case_row)
        existing_index := -1
        loop (index, variant) in variants {
            if variant.name == case_row.name -> existing_index = index
        }
        if existing_index >= 0 {
            if !sema_failure_union_same_payload(variants[existing_index].payload, payload) {
                &diagnostics.push(sema_error("E0105", case_row.span, "case `.{case_row.name}` of `{owned}` is created with two different payloads", "every `Err(.{case_row.name}(…))` in `{name}` adds to the one type `{owned}`, so each case has one payload", "give the two failures different case names, or pass the same payload types to `.{case_row.name}`"))
            }
            next
        }
        &variants.push(Variant{name: case_row.name, name_span: case_row.span, payload: payload, discriminant: None, discriminant_expr: None, serde_markers: [Marker]{}})
    }
    definition :: sema_failure_union_enum(owned, graph.modules[row.module_index].functions[row.function_row].declaration, variants)
    item :: Item.Enum{value: definition}
    // The type registers in the module in place; the trail records the
    // appended rows (copying the module, every row of its program, twice per
    // minted type was the cost of the old whole-row record).
    module_index :: row.module_index
    mark :: sema_graph_module_mark(graph.modules[module_index])
    first_nominal :: graph.modules[module_index].nominals.len()
    source_file :: graph.modules[module_index].source_file.copy()
    source_origin :: graph.modules[module_index].source_origin.copy()
    register_diagnostics := [Diagnostic]{}
    if !sema_registration_add_root(&graph.modules[module_index], item, source_file, source_origin, segments, &register_diagnostics) || register_diagnostics.len() > 0 {
        sema_graph_module_rollback(&graph.modules[module_index], mark, owned)
        loop diagnostic in register_diagnostics -> &diagnostics.push(diagnostic)
        sema_attach_diagnostic_source_locations(&diagnostics, start, segments)
        return None
    }
    // copy: the minted enum is stored twice in the graph: as a program item here and as the
    // export's declaration below (`declaration: Val(item)`).
    &graph.modules[module_index].program.items.push(item.copy())
    // copy: the export row stores its own symbol, while the registered symbol row stays in the
    // module, and `graph` is written (exports.push) while it is live.
    symbol :: graph.modules[module_index].symbols[graph.modules[module_index].symbols.len() - 1].copy()
    module_identity :: graph.modules[module_index].module_identity.copy()
    if symbol.visibility > 0 -> &graph.modules[module_index].exports.push(SemaRegistrationExport{name: symbol.name, symbol: symbol, declaration: Val(item), source_module_identity: module_identity, visibility: symbol.visibility})
    &trail.entries.push(SemaGraphUndo.ModuleAppend{module_index: module_index, mark: mark, name: owned})
    if !trail.nominal_indexes_saved {
        &trail.entries.push(SemaGraphUndo.NominalIndexes{symbol_rows: graph.nominal_symbol_rows, slots: graph.nominal_row_slots, buckets: graph.nominal_row_buckets})
        trail.nominal_indexes_saved = true
    }
    sema_registration_index_nominal_rows(&graph, module_index, first_nominal)
    sema_attach_diagnostic_source_locations(&diagnostics, start, segments)
    Val(Type.Named{name: owned})
}

fn sema_failure_union_flatten(ty: Type, flat: &[Type]) Never! {
    if ty == .Union(members) {
        loop member in members -> sema_failure_union_flatten(member, &flat)
        return
    }
    loop existing in flat {
        if type_identity_equal(existing, ty) -> return
    }
    &flat.push(ty)
}

// Flatten nested unions, drop exact duplicates, sort by the
// canonical spelling read without module qualifiers (Rust
// `union_member_order_key`); one surviving member is that member.
fn sema_failure_union_canonical(members: [Type]) -> Type Never! {
    flat := [Type]{}
    loop member in members -> sema_failure_union_flatten(member, &flat)
    index := 1
    loop index < flat.len() {
        current := flat[index]
        insertion := index - 1
        loop insertion >= 0 && sema_failure_union_member_after(flat[insertion], current) {
            flat[insertion + 1] = flat[insertion]
            insertion -= 1
        }
        flat[insertion + 1] = current
        index += 1
    }
    if flat.len() == 0 -> return Type.Named{name: "Unit"}
    if flat.len() == 1 -> return flat[0]
    Type.Union{members: flat}
}

// Resolving a member to its declaration key (`<corelib>/core.http::HTTPError`)
// never reorders the union: the order reads each nominal head unqualified and
// the full spelling only breaks ties.
fn sema_failure_union_member_after(left: Type, right: Type) -> Bool Never! {
    left_key :: sema_failure_union_order_key(left)
    right_key :: sema_failure_union_order_key(right)
    if left_key != right_key -> return left_key > right_key
    type_name(left) > type_name(right)
}

fn sema_failure_union_order_key(ty: Type) -> String Never! {
    if ty == {
        .Named(name) -> return sema_failure_union_unqualified(name)
        .Apply(name, _) -> {
            full :: type_name(ty)
            if full.starts_with(name) -> return "{sema_failure_union_unqualified(name)}{full.slice(name.len(), full.len())}"
            return full
        }
        else -> {}
    }
    type_name(ty)
}

fn sema_failure_union_unqualified(name: String) -> String Never! {
    leaf := name
    loop part in name.split("::") -> leaf = part
    leaf
}

// The success side of an unwritten contract.
fn sema_failure_union_success(function: Func) -> Type Never! {
    // copy: `written` is a payload of read parameter `function`, which keeps the original; the returned value owns this one
    if function.return_type == .Val(written) -> return written.copy()
    Type.Named{name: "Unit"}
}

// One contract to project: the function key, its registered top-level row,
// and the new return type.
struct SemaFailureProjection {
    key: String
    module_index: Int
    row: Int
    return_type: Type
}

// The top-level function row `function_key` registers in `module_index`,
// through `callable_rows`; -1 when that module declares none.
fn sema_failure_function_row(graph: SemaRegistrationGraph, module_index: Int, function_key: String) -> Int Never! {
    row :: graph.callable_rows.get(function_key) ?? return -1
    if row == .Function(declaring, index) {
        if declaring == module_index -> return index
    }
    -1
}

// Project contracts onto each declaration, its registry row and symbol, the
// module items and every import binding of it: the written-span-less return
// type every later check and lowering read. Rows are replaced in place, and
// the declaring modules and every import binding are walked once for the
// whole batch (Rust `solve_inferred_failure` projection), not once per
// function. Every replaced row is recorded on `trail`.
fn sema_failure_project_returns(graph: &SemaRegistrationGraph, projections: [SemaFailureProjection], trail: &SemaGraphTrail) {
    if projections.len() == 0 -> return
    // Projected key -> its new symbol and item; "{module}|{key}" and
    // "{module}|{name}" -> the key, for the rows of its declaring module.
    symbols := [String:Symbol]{}
    items := [String:Item]{}
    local_keys := [String:Bool]{}
    local_names := [String:String]{}
    declaring := [Int]{}
    seen := [Bool]{}
    loop _ in 0..<graph.modules.len() -> &seen.push(false)
    unused_diagnostics := [Diagnostic]{}
    loop projection in projections {
        module_index :: projection.module_index
        // copy: the projected declaration is a new row; the old row stays on the trail.
        updated := graph.modules[module_index].functions[projection.row].declaration.copy()
        updated.return_type = Val(projection.return_type)
        updated.return_type_span = None
        row :: sema_registration_function(updated, graph.modules[module_index].functions[projection.row].raw_protocol_return, graph.modules[module_index].module_identity, None, graph.modules[module_index].source_file, graph.modules[module_index].source_origin, graph.modules[module_index].source_segments, &unused_diagnostics)
        symbols[projection.key] = row.symbol
        local_keys["{module_index}|{projection.key}"] = true
        local_names["{module_index}|{updated.name}"] = projection.key
        items[projection.key] = Item.Func{value: ^updated}
        &trail.entries.push(SemaGraphUndo.FunctionRow{module_index: module_index, row: projection.row, old: graph.modules[module_index].functions[projection.row]})
        graph.modules[module_index].functions[projection.row] = ^row
        if !seen[module_index] {
            seen[module_index] = true
            &declaring.push(module_index)
        }
    }
    loop module_index in declaring {
        loop index in 0..<graph.modules[module_index].symbols.len() {
            key :: graph.modules[module_index].symbols[index].id.key.copy()
            if local_keys.get("{module_index}|{key}") == None -> next
            symbol :: symbols.get(key) ?? next
            &trail.entries.push(SemaGraphUndo.SymbolRow{module_index: module_index, position: index, old: graph.modules[module_index].symbols[index]})
            graph.modules[module_index].symbols[index] = symbol
        }
        loop index in 0..<graph.modules[module_index].declarations.len() {
            name := ""
            if graph.modules[module_index].declarations[index] == .Func(declared) -> name = declared.name
            key :: local_names.get("{module_index}|{name}") ?? next
            item :: items.get(key) ?? next
            &trail.entries.push(SemaGraphUndo.DeclarationRow{module_index: module_index, position: index, old: graph.modules[module_index].declarations[index]})
            graph.modules[module_index].declarations[index] = item
        }
        loop index in 0..<graph.modules[module_index].program.items.len() {
            name := ""
            if graph.modules[module_index].program.items[index] == .Func(declared) -> name = declared.name
            key :: local_names.get("{module_index}|{name}") ?? next
            item :: items.get(key) ?? next
            &trail.entries.push(SemaGraphUndo.ProgramItemRow{module_index: module_index, position: index, old: graph.modules[module_index].program.items[index]})
            graph.modules[module_index].program.items[index] = item
        }
        loop index in 0..<graph.modules[module_index].exports.len() {
            key :: graph.modules[module_index].exports[index].symbol.id.key.copy()
            if local_keys.get("{module_index}|{key}") == None -> next
            symbol :: symbols.get(key) ?? next
            item :: items.get(key) ?? next
            &trail.entries.push(SemaGraphUndo.ExportRow{module_index: module_index, position: index, old: graph.modules[module_index].exports[index]})
            graph.modules[module_index].exports[index].symbol = symbol
            graph.modules[module_index].exports[index].declaration = Val(item)
        }
    }
    loop importer_index in 0..<graph.modules.len() {
        loop import_index in 0..<graph.modules[importer_index].imports.len() {
            loop binding_index in 0..<graph.modules[importer_index].imports[import_index].bindings.len() {
                key :: graph.modules[importer_index].imports[import_index].bindings[binding_index].symbol.id.key.copy()
                symbol :: symbols.get(key) ?? next
                item :: items.get(key) ?? next
                &trail.entries.push(SemaGraphUndo.ImportBindingRow{module_index: importer_index, import_index: import_index, binding: binding_index, old: graph.modules[importer_index].imports[import_index].bindings[binding_index]})
                graph.modules[importer_index].imports[import_index].bindings[binding_index].symbol = symbol
                graph.modules[importer_index].imports[import_index].bindings[binding_index].declaration = Val(item)
            }
        }
    }
}

// The union contracts one bundle projected: their function keys, the
// modules whose declarations changed (a projected function's or a minted
// `#Error enum`'s declaring module), and whether any type was minted.
struct SemaFailureUnionProjected {
    keys: [String]
    modules: [Int]
    minted: Bool
}

// Join the default-route rows of the unannotated
// top-level functions, mint their own cases and project every set that holds
// a typed member.
fn sema_failure_union_infer(graph: &SemaRegistrationGraph, modules: [SemaGraphModuleResult], diagnostics: &[Diagnostic], trail: &SemaGraphTrail) -> SemaFailureUnionProjected {
    projected := SemaFailureUnionProjected{keys: [String]{}, modules: [Int]{}, minted: false}
    rows := [SemaFailureUnionRow]{}
    loop module_result in modules {
        module_index :: sema_registration_module_index(graph, module_result.module_identity) ?? next
        loop facts in module_result.failure_facts {
            function_row :: sema_failure_function_row(graph, module_index, facts.function_key)
            if function_row < 0 || !sema_failure_inference_candidate(graph.modules[module_index].functions[function_row].declaration) -> next
            &rows.push(SemaFailureUnionRow{key: facts.function_key.copy(), name: graph.modules[module_index].functions[function_row].declaration.name.copy(), module_index: module_index, members: facts.union_members.copy(), general: facts.union_general, edges: facts.union_edges.copy(), cases: facts.union_cases.copy(), function_row: function_row})
        }
    }
    if rows.len() == 0 -> return projected
    loop row_index in 0..<rows.len() {
        minted :: sema_failure_union_mint(&graph, rows[row_index], &diagnostics, &trail) ?? next
        &rows[row_index].members.push(minted)
        &projected.modules.push(rows[row_index].module_index)
        projected.minted = true
    }
    // Edge targets resolve through one key -> row map (the last row of a key,
    // as the per-edge scan found), not a scan of every row per edge.
    row_slots := [String:Int]{}
    loop (row_index, row) in rows -> row_slots[row.key] = row_index
    settled := false
    round := 0
    loop round < JET_FAILURE_UNION_JOIN_ROUND_CAP {
        changed := false
        loop row_index in 0..<rows.len() {
            edges := rows[row_index].edges.copy()
            key :: rows[row_index].key.copy()
            loop edge in edges {
                if edge == key -> next
                incoming := [Type]{}
                incoming_general := true
                if row_slots.get(edge) == .Val(other) {
                    incoming = rows[other].members.copy()
                    incoming_general = rows[other].general
                }
                loop member in incoming {
                    known := false
                    loop existing in rows[row_index].members {
                        if type_identity_equal(existing, member) -> known = true
                    }
                    if !known {
                        &rows[row_index].members.push(member)
                        changed = true
                    }
                }
                if incoming_general && !rows[row_index].general {
                    rows[row_index].general = true
                    changed = true
                }
            }
        }
        if !changed {
            settled = true
            break
        }
        round += 1
    }
    projections := [SemaFailureProjection]{}
    loop row in rows {
        typed :: loop member in row.members {
            if sema_failure_union_typed(member) -> break true
        } ?? false
        if !typed -> next
        function_row :: sema_failure_function_row(graph, row.module_index, row.key)
        if function_row < 0 -> next
        members := row.members.copy()
        if row.general || !settled -> &members.push(Type.Named{name: "Err"})
        contract :: Type.Result{ok: sema_failure_union_success(graph.modules[row.module_index].functions[row.function_row].declaration), err: sema_failure_union_canonical(members)}
        &projections.push(SemaFailureProjection{key: row.key, module_index: row.module_index, row: function_row, return_type: contract})
        &projected.keys.push(row.key)
        &projected.modules.push(row.module_index)
    }
    sema_failure_project_returns(&graph, projections, &trail)
    projected
}

// #3708 (card item T1): every function the failure solve proved infallible is
// projected onto the `T Never!` carrier with no written span, which every
// tier lowers as a plain return. A function a compile-time evaluation already
// checked keeps its carrier, so its cached callers stay consistent. Returns
// the projected keys. Every replaced row is recorded on `trail`.
fn sema_failure_project_infallible(graph: &SemaRegistrationGraph, solved: [String], comptime_functions: [SemaComptimeFunctionResult], trail: &SemaGraphTrail) -> [String] {
    // The keys compile-time evaluation reached, collected once.
    comptime_reached := [String:Bool]{}
    loop result in comptime_functions {
        comptime_reached[result.function_key] = true
        loop key in result.reachable_function_keys -> comptime_reached[key] = true
    }
    projections := [SemaFailureProjection]{}
    loop key in solved {
        if comptime_reached.get(key) != None -> next
        row :: graph.callable_rows.get(key) ?? next
        if row == .Function(module_index, index) {
            contract :: Type.Result{ok: sema_failure_union_success(graph.modules[module_index].functions[index].declaration), err: Type.Named{name: "Never"}}
            &projections.push(SemaFailureProjection{key: key, module_index: module_index, row: index, return_type: contract})
        }
    }
    sema_failure_project_returns(&graph, projections, &trail)
    loop projection in projections -> projection.key
}
