// D-SCHEDULE1: resolve raw #Every arguments through registered Time facts.
// Runtime consumers read the checked projection, never source suffixes.
// D-JOB-NAMES1 and D-DX-JOBGRAPH1 validate job names and prerequisites.
use jet_foundation.[Diagnostic, Span, EveryArg, EverySchedule, EveryScheduleError, Func, Item, JobScope, LoadedModule, ProgramBundle]
use jet_foundation.Syntax
use jet_foundation.CLISchema.JobRegistry
use jet_sema.TypeRegistry

// Rust: crates/jet-sema/src/Sema/CheckerSchedule.rs:27
fn resolve_every_arg(arg: EveryArg, registry: TypeRegistry) -> EverySchedule EveryScheduleError! {
    if arg == {
        .Duration(int: int, float: float, suffix: suffix, ..) -> {
            unit :: registry.unit_literal("Time", suffix) ?? throw EveryScheduleError.UnknownDurationUnit
            if int.is_some_and(fn(value) { value <= 0 }) || float.is_some_and(fn(value) { !value.is_finite() || value <= 0.0 }) -> throw EveryScheduleError.NonPositiveDuration
            nanos :: if int == .Val(value) {
                scale :: try { I64.parse(unit.scale.num.to_string())! } catch _ { throw EveryScheduleError.DurationOutOfRange }
                numerator :: I64{value}.checked_mul(scale) ?? throw EveryScheduleError.DurationOutOfRange
                denominator :: try { I64.parse(unit.scale.den.to_string())! } catch _ { throw EveryScheduleError.DurationOutOfRange }
                numerator.checked_div(denominator) ?? throw EveryScheduleError.DurationOutOfRange
            } else {
                value :: float ?? 0.0
                scale_num :: try { Float.parse(unit.scale.num.to_string())! } catch _ { throw EveryScheduleError.DurationOutOfRange }
                scale_den :: try { Float.parse(unit.scale.den.to_string())! } catch _ { throw EveryScheduleError.DurationOutOfRange }
                nanoseconds :: value * scale_num / scale_den
                if !nanoseconds.is_finite() || nanoseconds < -9_223_372_036_854_775_808.0 || nanoseconds >= 9_223_372_036_854_775_808.0 -> throw EveryScheduleError.DurationOutOfRange
                I64{nanoseconds.trunc()}
            }
            if nanos == 0 -> throw EveryScheduleError.NonPositiveDuration
            if nanos < 0 -> throw EveryScheduleError.NonPositiveDuration
            EverySchedule.Duration{nanos: Int{nanos}}
        }
        .WallClock(text: text, ..) -> {
            bytes :: text.as_bytes()
            digits_ok :: bytes.len() == 5 && bytes[2] == U8{58} && bytes[0].is_ascii_digit() && bytes[1].is_ascii_digit() && bytes[3].is_ascii_digit() && bytes[4].is_ascii_digit()
            if !digits_ok -> throw EveryScheduleError.BadWallClockFormat
            hour :: Int{bytes[0] - U8{48}} * 10 + Int{bytes[1] - U8{48}}
            minute :: Int{bytes[3] - U8{48}} * 10 + Int{bytes[4] - U8{48}}
            if hour > 23 -> throw EveryScheduleError.HourOutOfRange
            if minute > 59 -> throw EveryScheduleError.MinuteOutOfRange
            EverySchedule.WallClockTime{hour: hour, minute: minute}
        }
        .Expression(_) -> throw EveryScheduleError.DynamicValue
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerSchedule.rs:126
fn e0926_bad_schedule_value(reason: EveryScheduleError, span: Span) -> Diagnostic {
    (what, why, fix) :: if reason == {
        .UnknownDurationUnit -> (
            "this duration's unit isn't a recognized schedule cadence",
            "a schedule's repeat interval uses the canonical Time family — `ns`/`us`/`ms`/`s`/`min`/`h`/`d` — not an arbitrary `#UnitFamily` member.",
            "use a canonical Time unit such as `min`, `h`, or `d` (e.g. `#Every(2h)`).")
        .NonPositiveDuration -> (
            "a schedule interval must be a positive duration",
            "`#Every(0ms)` or a negative duration never becomes due — it isn't a real cadence.",
            "write a duration greater than zero, e.g. `#Every(5min)`.")
        .DurationOutOfRange -> (
            "this schedule duration is outside the supported range",
            "schedule intervals use the same fixed i64 nanosecond carrier as Duration.",
            "write a smaller positive duration, e.g. `#Every(5min)`.")
        .BadWallClockFormat -> (
            "this daily schedule isn't a plain `\"HH:MM\"` time",
            "a wall-clock trigger is exactly two digits, a colon, and two digits — 24h time, no seconds, no timezone.",
            "write a fixed daily time like `#Every(\"03:00\")`.")
        .HourOutOfRange -> (
            "this daily schedule's hour is out of range",
            "24h wall-clock hours run `00`..=`23`.",
            "write an hour between `00` and `23`, e.g. `#Every(\"03:00\")`.")
        .MinuteOutOfRange -> (
            "this daily schedule's minute is out of range",
            "wall-clock minutes run `00`..=`59`.",
            "write a minute between `00` and `59`, e.g. `#Every(\"03:00\")`.")
        .DynamicValue -> (
            "a job schedule must be known at compile time",
            "the marker argument has the right type, but job discovery needs one fixed cadence.",
            "write a duration or wall-clock literal, e.g. `#Every(5min)` or `#Every(\"03:00\")`.")
    }
    Diagnostic.error("E0926", what, why, fix, Val(span))
}

// Rust: crates/jet-sema/src/Sema/CheckerSchedule.rs:176
fn e0928_reserved_job_name(name: String, span: Span) -> Diagnostic {
    Diagnostic.error("E0928", "`{name}` is reserved by Jet's command line", "`run`, `dev`, `build`, and `test` name Jet's lifecycle entries, and a built program answers `help` and `version` itself", "rename the job, e.g. `#Job fn {name}_all()`", Val(span))
}

// Rust: crates/jet-sema/src/Sema/CheckerSchedule.rs:188
fn e0928_job_collision(name: String, scope: JobScope, span: Span) -> Diagnostic {
    scope_name :: if scope == { .Dev -> "Dev"; .Ship -> "Ship"; .Internal -> "Internal" }
    Diagnostic.error("E0928", "job `{name}` is declared more than once in scope .{scope_name}", "`jet jobs {name}` must select exactly one function", "rename one of the jobs, or give the declarations different scopes", Val(span))
}

// Rust: crates/jet-sema/src/Sema/CheckerSchedule.rs:205
pub fn check_job_marker(f: Func) -> [Diagnostic] {
    if !f.is_job -> return []
    if Syntax.JOB_RESERVED_NAMES.contains(f.name) -> return [e0928_reserved_job_name(f.name, f.job_span ?? f.name_span)]
    []
}

// Rust: crates/jet-sema/src/Sema/CheckerSchedule.rs:217
pub fn check_job_collisions(modules: [LoadedModule]) -> [Diagnostic] {
    seen := [(String, JobScope):Bool]{:}
    diags := [Diagnostic]{}
    loop module in modules {
        loop item in module.items {
            if item != .Func(function) -> continue
            if !function.is_job -> continue
            scope :: function.job_metadata.map(fn(metadata) { metadata.scope }) ?? JobScope.Dev
            key :: (function.name, scope)
            if !seen.contains_key(key) { seen[key] = true }
            else { &diags.push(e0928_job_collision(function.name, scope, function.name_span)) }
        }
    }
    ^diags
}

// Rust: crates/jet-sema/src/Sema/CheckerSchedule.rs:248
fn job_graph_error(code: String, what: String, why: String, fix: String, span: Span) -> Diagnostic {
    Diagnostic.error(code, what, why, fix, Val(span))
}

// Rust: crates/jet-sema/src/Sema/CheckerSchedule.rs:267
pub fn check_job_graph(bundle: ProgramBundle) -> [Diagnostic] {
    jobs := [(String, [String], [String], Span)]{}
    by_name := [String:[Int]]{:}
    loop module in bundle.modules {
        loop item in module.items {
            if item != .Func(function) -> continue
            if !function.is_job -> continue
            index :: jobs.len()
            &by_name.entry(function.name).or_default().push(index)
            &jobs.push((function.name, function.job_metadata.map(fn(metadata) { metadata.after }) ?? [], function.job_metadata.map(fn(metadata) { metadata.packages }) ?? [], function.job_span ?? function.name_span))
        }
    }
    diagnostics := [Diagnostic]{}
    reported := [(String, String, String):Bool]{:}
    loop (name, after, packages, span) in jobs {
        loop dependency in after {
            if dependency == name {
                key :: ("self", name, dependency)
                if !reported.contains_key(key) {
                    reported[key] = true
                    &diagnostics.push(job_graph_error("E1331", "job `{name}` depends on itself", "a job graph must be acyclic so every prerequisite has a finite completion point", "remove the self-reference from `after`", span))
                }
                continue
            }
            if by_name.get(dependency) == {
                .None -> {
                    key :: ("unknown", name, dependency)
                    if !reported.contains_key(key) {
                        reported[key] = true
                        &diagnostics.push(job_graph_error("E1331", "job `{name}` depends on unknown job `{dependency}`", "every `after` name is resolved against the checked #Job declarations before effects", "declare the prerequisite with `#Job`, or correct the name", span))
                    }
                }
                .Val(candidates) && candidates.len() > 1 -> {
                    key :: ("ambiguous", name, dependency)
                    if !reported.contains_key(key) {
                        reported[key] = true
                        &diagnostics.push(job_graph_error("E1331", "job `{name}` has an ambiguous prerequisite `{dependency}`", "the graph uses one source identity per job name and cannot choose between scopes", "rename one declaration or make the prerequisite name unique", span))
                    }
                }
                _ -> {}
            }
        }
        loop package in packages {
            declared :: bundle.package_guarantees.dependency_names.contains(package) || bundle.dep_roots.contains_key(package)
            allowed :: bundle.package_guarantees.deps.is_none_or(fn(allowlist) { allowlist.iter().any(fn(value) { value == package }) })
            if !declared || !allowed -> &diagnostics.push(job_graph_error("E1332", "job `{name}` names unauthorized package `{package}`", "job package capabilities must be declared by the checked package authority", "declare the dependency in package.jet authority, or remove it from `packages`", span))
        }
    }
    state := [U8].repeat(U8{0}, jobs.len())
    stack := [Int]{}
    // Rust: crates/jet-sema/src/Sema/CheckerSchedule.rs:362
    fn visit(index: Int, jobs: [(String, [String], [String], Span)], by_name: [String:[Int]], state: &[U8], stack: &[Int], diagnostics: &[Diagnostic]) -> {
        if state[index] == U8{2} -> return
        if state[index] == U8{1} {
            cycle_start :: stack.iter().position(fn(candidate) { candidate == index }) ?? 0
            cycle_names := [String]{}
            loop candidate in stack[cycle_start..] -> &cycle_names.push(jobs[candidate].0)
            &cycle_names.push(jobs[index].0)
            cycle :: cycle_names.join(" -> ")
            &diagnostics.push(job_graph_error("E1331", "job graph contains a cycle: {cycle}", "a prerequisite graph must reach a completed root before scheduling can start", "remove one `after` edge from the cycle", jobs[index].3))
            return
        }
        state[index] = U8{1}
        &stack.push(index)
        loop dependency in jobs[index].1 {
            candidates :: by_name.get(dependency) ?? continue
            if candidates.len() == 1 -> visit(candidates[0], jobs, by_name, &state, &stack, &diagnostics)
        }
        _ :: &stack.pop()
        state[index] = U8{2}
    }
    loop index in 0..jobs.len() -> visit(index, jobs, by_name, &state, &stack, &diagnostics)
    ^diagnostics
}

// Rust: crates/jet-sema/src/Sema/CheckerSchedule.rs:412
pub fn check_every_marker(f: &Func, registry: TypeRegistry) -> [Diagnostic] {
    diags := check_job_marker(f)
    if f.every != .Val(every) -> return ^diags
    try {
        schedule :: resolve_every_arg(every.arg, registry)!
        every.resolved = Val(schedule)
    } catch reason {
        every.resolved = None
        span :: if every.arg == {
            .Duration(suffix_span: span, ..) -> span
            .WallClock(text_span: span, ..) -> span
            .Expression(expression) -> expression.span()
        }
        &diags.push(e0926_bad_schedule_value(reason, span))
    }
    ^diags
}

// Rust: crates/jet-sema/src/Sema/CheckerSchedule.rs:439
pub fn checked_job_registry(bundle: ProgramBundle) -> JobRegistry {
    JobRegistry.from_bundle(bundle)
}
