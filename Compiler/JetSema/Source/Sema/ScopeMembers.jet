use jet_foundation.[
    AppliedRuleApplication,
    Diagnostic,
    Expr,
    Item,
    MarkerDecl,
    MarkerDeclParam,
    Program,
    Span,
    Stmt,
    TAppliedRule,
    TAppliedRuleArgumentMenu,
    TAppliedRuleCatalog,
    Type,
    ast_visit_statement,
    type_name,
]

SemaScopeMembersMarkerRule: struct {
    name: String
    sites: [String]
    first_parameter_is_type: Bool
    repeatable: Bool
    params: [MarkerDeclParam]
    group: Bool{false}
    declaration_module: String?{None}
    declaration_span: Span?{None}
}

SemaScopeMembersMarkerRegistry: struct {
    applied_rules: [TAppliedRule]
    argument_menus: [TAppliedRuleArgumentMenu]
    marker_rules: [SemaScopeMembersMarkerRule]
    known_marker_names: [String]
    function_allowed_markers: [String]
    block_allowed_markers: [String]
    derive_provider_names: [String]
}

SemaScopeMembersDeclaredTypeArgument: struct {
    name: String
    ty: Type
    span: Span
}

SemaScopeMembersDSLHeaderResult: struct {
    known: Bool
    block_allowed: Bool
    args_valid: Bool
    declared_type_argument: SemaScopeMembersDeclaredTypeArgument?
    diagnostics: [Diagnostic]
}

sema_scope_members_append_name: fn(values: &[String], name: String) Never! {
    loop existing in values {
        if existing == name -> return
    }
    values.push(name.copy())
}

sema_scope_members_site_name: fn(value: Expr) -> String? {
    if value == {
        .Ident(name, _, _) -> {
            if name.starts_with(".") -> return Val(name.slice(1, name.len()))
            return Val(name)
        }
        .Field(_, name, _, _) -> return Val(name)
        .EnumLit(_, name, _, _, _, _, _) -> return Val(name)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

sema_scope_members_site_is_known: fn(name: String) -> Bool Never! {
    name == "Package" || name == "File" || name == "Module" || name == "Function" || name == "Method" || name == "Block" || name == "Statement" || name == "Expression" || name == "Type" || name == "Impl" || name == "Trait" || name == "Declaration" || name == "Constant" || name == "Field" || name == "Variant" || name == "Parameter" || name == "Test" || name == "Operation" || name == "Text"
}

sema_scope_members_declared_sites: fn(declaration: MarkerDecl) -> [String]? {
    found := false
    loop parameter_index in 0..<declaration.params.len() {
        if declaration.params[parameter_index].name != "$sites" -> next
        found = true
        value: declaration.params[parameter_index].value ?? return None
        if value == {
            .ListLit(values, _, _) -> {
                sites := [String]{}
                loop item in values {
                    site: sema_scope_members_site_name(item) ?? return None
                    if !sema_scope_members_site_is_known(site) -> return None
                    sema_scope_members_append_name(sites, site)
                }
                return Val(sites)
            }
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
        }
    }
    if found -> return None
    None
}

sema_scope_members_declared_repeatable: fn(declaration: MarkerDecl) -> Bool? {
    loop parameter_index in 0..<declaration.params.len() {
        if declaration.params[parameter_index].name != "$repeatable" -> next
        value: declaration.params[parameter_index].value ?? return None
        if value == {
            .Bool(repeatable, _, _) -> return Val(repeatable)
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
        }
    }
    Val(false)
}

sema_scope_members_first_parameter_is_type: fn(declaration: MarkerDecl) -> Bool Never! {
    loop parameter_index in 0..<declaration.params.len() {
        if declaration.params[parameter_index].name.starts_with("$") -> next
        return declaration.params[parameter_index].ty == (Val(Type.Named{name: "Type"}))
    }
    false
}

sema_scope_members_registry_add_declaration: fn(registry: &SemaScopeMembersMarkerRegistry, declaration: MarkerDecl) -> Bool Never! {
    sema_scope_members_registry_add_identity(registry, declaration, None, None)
}

sema_scope_members_registry_add_identity: fn(registry: &SemaScopeMembersMarkerRegistry, declaration: MarkerDecl, identity: String?, span: Span?) -> Bool Never! {
    loop existing in registry.marker_rules {
        if existing.name == declaration.name && existing.declaration_module == identity && existing.declaration_span == span -> return identity != None
    }
    if declaration.group != None {
        registry.marker_rules.push(SemaScopeMembersMarkerRule{
            name: declaration.name, sites: [String]{}, first_parameter_is_type: false,
            repeatable: false, params: [MarkerDeclParam]{}, group: true,
            declaration_module: identity, declaration_span: span,
        })
        sema_scope_members_append_name(registry.known_marker_names, declaration.name)
        return true
    }
    sites: sema_scope_members_declared_sites(declaration) ?? return false
    repeatable: sema_scope_members_declared_repeatable(declaration) ?? return false
    registry.marker_rules.push(SemaScopeMembersMarkerRule{
        name: declaration.name,
        sites: sites,
        first_parameter_is_type: sema_scope_members_first_parameter_is_type(declaration),
        repeatable: repeatable,
        params: declaration.params,
        declaration_module: identity, declaration_span: span,
    })
    sema_scope_members_append_name(registry.known_marker_names, declaration.name)
    loop site in sites {
        if site == "Function" -> sema_scope_members_append_name(registry.function_allowed_markers, declaration.name)
        if site == "Block" -> sema_scope_members_append_name(registry.block_allowed_markers, declaration.name)
    }
    true
}

sema_scope_members_registry_add_items: fn(registry: &SemaScopeMembersMarkerRegistry, items: [Item]) -> Bool Never! {
    loop item in items {
        if item == {
            .UserDerive(derive_definition) -> {
                sema_scope_members_append_name(registry.derive_provider_names, derive_definition.trait_name)
                sema_scope_members_append_name(registry.known_marker_names, derive_definition.trait_name)
            }
            .CodeModule(code_module) -> {
                if code_module.body != None {
                    body: code_module.body ?? return false
                    if !sema_scope_members_registry_add_items(registry, body) -> return false
                }
            }
            .Func(_) | .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    true
}

sema_scope_members_registry_add_program: fn(registry: &SemaScopeMembersMarkerRegistry, program: Program) -> Bool Never! {
    loop declaration in sema_marker_module_declarations(program.items, "", false) {
        if !sema_scope_members_registry_add_declaration(registry, declaration) -> return false
    }
    // Derive providers keep their existing lexical registration path.
    sema_scope_members_registry_add_items(registry, program.items)
}

sema_scope_members_registry_add_applied_catalog: fn(registry: &SemaScopeMembersMarkerRegistry, catalog: TAppliedRuleCatalog) -> Bool Never! {
    seen := [String]{}
    loop rule in catalog.rows {
        if seen.contains(rule.name) -> return false
        seen.push(rule.name)
        sema_scope_members_append_name(registry.known_marker_names, rule.name)
        loop site in rule.sites {
            if site == "Function" -> sema_scope_members_append_name(registry.function_allowed_markers, rule.name)
            if site == "Block" -> sema_scope_members_append_name(registry.block_allowed_markers, rule.name)
        }
    }
    true
}

// `catalog` must be built from the complete embedded Prelude/Markers.jet
// source. The graph must be complete because source-declared marker and derive
// names are package-wide. Occurrence facts never authorize marker sites.
sema_scope_members_build_marker_registry: fn(graph: SemaRegistrationGraph, module_identity: String, program: Program, catalog: TAppliedRuleCatalog) -> SemaScopeMembersMarkerRegistry? {
    if !graph.complete -> return None
    registry := SemaScopeMembersMarkerRegistry{
        applied_rules: catalog.rows,
        argument_menus: catalog.argument_menus,
        marker_rules: [SemaScopeMembersMarkerRule]{},
        known_marker_names: [String]{},
        function_allowed_markers: [String]{},
        block_allowed_markers: [String]{},
        derive_provider_names: [String]{},
    }
    if !sema_scope_members_registry_add_applied_catalog(registry, catalog) -> return None
    current_module_found := false
    loop module_row_index in 0..<graph.modules.len() {
        // The current module's rows come from `program`; read either in place.
        if graph.modules[module_row_index].module_identity == module_identity {
            current_module_found = true
            if !sema_scope_members_registry_add_program(registry, program) -> return None
        } else {
            // Derive providers retain their existing package scope; marker
            // declarations enter only through the import-qualified rows below.
            loop item_index in 0..<graph.modules[module_row_index].program.items.len() {
                if graph.modules[module_row_index].program.items[item_index] == .UserDerive(provider) {
                    sema_scope_members_append_name(registry.derive_provider_names, provider.trait_name)
                    sema_scope_members_append_name(registry.known_marker_names, provider.trait_name)
                }
            }
        }
    }
    if !current_module_found -> return None
    loop declaration in sema_marker_module_visible_declarations(graph, module_identity) {
        if !sema_scope_members_registry_add_declaration(registry, declaration) -> return None
    }
    // A group's members may have the same written name as caller-local rows.
    // Their canonical identity selects the declaration, never that name.
    loop marker in sema_marker_rules_collect_program(program) {
        if marker.declaration_module == None -> next
        resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
        declaration := resolved.declaration ?? next
        declaration.name = marker.name
        if !sema_scope_members_registry_add_identity(registry, declaration, marker.declaration_module, marker.declaration_span) -> return None
    }
    Val(registry)
}

sema_scope_members_has_name: fn(values: [String], name: String) -> Bool Never! {
    loop existing in values {
        if existing == name -> return true
    }
    false
}


// `scope_members` the member vocabulary an applied-rule block declares; `#Test`
// is the only marker with members.
sema_scope_members_vocabulary: fn(marker: String) -> [String]? Never! {
    if marker == "Test" -> return Val([String]{"setup", "expect_fail", "timeout", "skip", "measure", "cases"})
    None
}

// `check`: a dot member is legal only as a direct statement of a
// member-declaring marker block (E0614/E0616), never nested (E0618) and never
// in an ordinary function or method body (E0615).
sema_scope_members_check: fn(items: [Item]) -> [Diagnostic] {
    diagnostics := [Diagnostic]{}
    sema_scope_members_check_assertionless_tests(items, diagnostics)
    loop item in items {
        if item == {
            .Test(test) -> sema_scope_members_check_marker_body("Test", test.body, diagnostics)
            .Func(function) -> sema_scope_members_walk(function.body, false, diagnostics)
            .Impl(implementation) -> loop method in implementation.methods -> sema_scope_members_walk(method.body, false, diagnostics)
            .Struct(definition) -> {
                loop method in definition.methods -> sema_scope_members_walk(method.body, false, diagnostics)
                loop implementation in definition.trait_impls {
                    loop method in implementation.methods -> sema_scope_members_walk(method.body, false, diagnostics)
                }
            }
            .Enum(definition) -> {
                loop method in definition.methods -> sema_scope_members_walk(method.body, false, diagnostics)
                loop implementation in definition.trait_impls {
                    loop method in implementation.methods -> sema_scope_members_walk(method.body, false, diagnostics)
                }
            }
            .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .UserDerive(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    diagnostics
}

// `check_assertionless_tests`: a top-level `#Test` whose body never calls
// `assert`/`assert_eq` or `expect(…).snapshot` is L2901. The walk reads every
// expression the body holds, nested blocks and lambdas included, as Rust's
// `statements_have_assertion` does.
sema_scope_members_check_assertionless_tests: fn(items: [Item], diagnostics: &[Diagnostic]) {
    loop item in items {
        if item == .Test(test) {
            found := false
            loop statement in test.body -> ast_visit_statement(statement, (expression: Expr) -> sema_scope_members_note_assertion(found, expression), true)
            if !found -> diagnostics.push(sema_lint("L2901", test.span, "This #Test block has no assertions.", "A test with no assertions cannot find bugs because it always passes.", "Add at least one assertion, or remove the test if it only exercises compilation."))
        }
    }
}

sema_scope_members_note_assertion: fn(found: &Bool, expression: Expr) Never! {
    if expression == {
        .Call(call, _) -> {
            if call.name == "assert" || call.name == "assert_eq" -> found = true
        }
        .MethodCall(receiver, method, _, _, _, _, _) -> {
            if method == "snapshot" && sema_scope_members_is_expect_call(receiver) -> found = true
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

sema_scope_members_is_expect_call: fn(expression: Expr) -> Bool Never! {
    if expression == {
        .Call(call, _) -> call.name == "expect"
        .Paren(inner, _, _) -> sema_scope_members_is_expect_call(inner)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// Rust `check_marker_body`: each direct-child member is validated against the
// marker's vocabulary; anything deeper is nested.
sema_scope_members_check_marker_body: fn(marker: String, body: [Stmt], diagnostics: &[Diagnostic]) {
    loop (index, statement) in body {
        if statement == .ScopeMember(name, _, _, _, member_body, dsl, dot_span, _) {
            if dsl -> next
            sema_scope_members_validate_member(marker, name, index == 0, dot_span, diagnostics)
            sema_scope_members_walk(member_body, true, diagnostics)
            next
        }
        sema_scope_members_walk_children(statement, true, diagnostics)
    }
}

// Rust `validate_member`: E0614 for a marker without members or a name outside
// its vocabulary, E0616 for a `.setup` that is not the first statement.
sema_scope_members_validate_member: fn(marker: String, name: String, is_first: Bool, dot_span: Span, diagnostics: &[Diagnostic]) {
    vocabulary := [String]{}
    if sema_scope_members_vocabulary(marker) == {
        .Val(found) -> vocabulary = found
        .None -> {
            diagnostics.push(sema_error("E0614", dot_span, "`#{marker}` blocks have no members", "only some rule blocks declare a `.member {{ … }}` vocabulary; `#{marker}` isn't one of them", "remove this `.{name}` block"))
            return
        }
    }
    if !vocabulary.contains(name) {
        listed := ""
        loop (index, member) in vocabulary {
            if index > 0 -> listed = "{listed}, "
            listed = "{listed}`.{member}`"
        }
        diagnostics.push(sema_error("E0614", dot_span, "`.{name}` isn't a member of `#{marker}`", "a `#{marker}` block understands these members: {listed}", "use one of {listed}, or remove this block"))
        return
    }
    if name == "setup" && !is_first {
        diagnostics.push(sema_error("E0616", dot_span, "`.setup` must be the first statement in the test", "`.setup` marks the test's initialization; anything before it would run first", "move `.setup {{ … }}` to the top of the block"))
    }
}

// Rust `reject_nested` (nested = true, E0618) and `reject_all` (E0615): every
// dot member anywhere in `body`, through control blocks and member bodies.
sema_scope_members_walk: fn(body: [Stmt], nested: Bool, diagnostics: &[Diagnostic]) {
    loop statement in body {
        if statement == .ScopeMember(name, _, _, _, member_body, dsl, dot_span, _) {
            if !dsl {
                diagnostic: if nested -> sema_error("E0618", dot_span, "scope members can't be nested", "each `.{name}`-style member is a top-level region of the block; nesting one inside another member or a control block has no meaning", "move `.{name} {{ … }}` out to the top level of the block") else -> sema_error("E0615", dot_span, "`.{name}` only works inside a marker block that declares it", "a leading-dot member statement resolves against the enclosing applied rule's vocabulary — here there is no such block", "move it inside a `#Test(\"…\") {{ … }}` block, or write an ordinary statement")
                diagnostics.push(diagnostic)
            }
            sema_scope_members_walk(member_body, nested, diagnostics)
            next
        }
        sema_scope_members_walk_children(statement, nested, diagnostics)
    }
}

// Rust `child_bodies`: walks every statement block a statement carries, in
// place (arms in order, then the else body).
sema_scope_members_walk_children: fn(statement: Stmt, nested: Bool, diagnostics: &[Diagnostic]) {
    if statement == {
        .Switch(_, arms, else_body, _) -> {
            loop arm in arms -> sema_scope_members_walk(arm.body, nested, diagnostics)
            if else_body == .Val(body) -> sema_scope_members_walk(body, nested, diagnostics)
        }
        .While(_, body, _, _, _) | .For(_, _, _, _, body, _, _, _, _) | .Loop(body, _, _, _) | .CountedLoop(_, _, _, body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .ContextBlock(_, body, _) | .Live(body, _) | .AssumeDet(_, _, body, _) | .Transact(_, _, body, _, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> sema_scope_members_walk(body, nested, diagnostics)
        .Expr(_) | .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Shield(_, _) | .Switched(_, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .Yield(_, _) | .DeferClose(_, _) -> {}
    }
}
