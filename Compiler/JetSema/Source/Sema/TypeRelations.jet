// Pure type judgments shared by declaration, expression, and call checking.
// Registry-dependent nominal and trait relations are layered on these rules.
use jet_foundation.[
    CallContractRow,
    Diagnostic,
    Expr,
    Func,
    Item,
    Param,
    Measure,
    MeasureRule,
    UnOp,
    build_time_refused,
    measure_kind,
    measure_literal_value,
    EffectRowEntry,
    FunctionCallMetadata,
    FunctionObligations,
    InternalTag,
    NamedSpan,
    ParamZone,
    Span,
    Symbol,
    SymbolID,
    SymbolKind,
    TGenericParam,
    TagMarker,
    TraitImplBlock,
    Type,
    TypeTupleField,
    ViewProvenance,
    ViewProvenanceMap,
    ViewSource,
    ViewSourcePath,
    ViewSourceProjection,
    core_bare_source_declared,
    core_bare_source_module,
    core_module_export,
    core_module_for_alias,
    core_module_has_member,
    core_module_has_type,
    core_root_type,
    core_type_modules,
    foundation_family_size_list,
    foundation_family_sizes,
    foundation_family_type,
    foundation_named_type,
    foundation_size_alias,
    foundation_number_family,
    owned_trait,
    owned_trait_arithmetic,
    owned_trait_codec,
    owned_trait_implies,
    owned_trait_requirers,
    owned_trait_structural,
    owned_trait_through_elements,
    sema_reserved_type_name,
    boundary_head_owner_module,
    boundary_head_carrier_module,
    symbol_builtin,
    type_identity_equal,
    type_is_unit_callable_return,
    type_with_effective_fn_returns,
    core_source_owns_type,
    type_name,
    type_structural_args,
    type_structural_family,
    type_structural_head_names,
    type_union_member_tag,
    type_unqualified_name,
    type_unqualified_nominals,
    name_text_hash,
    core_identity_in_module,
    core_identity_is,
    MODULE_CORE_PREFIX,
    is_compute_tensor_family,
    ModuleID,
    module_is_core,
    module_is_none,
    module_none,
    module_text,
    AST_NODE_GENERATED,
    comptime_walk_identifiers,
    TypeAliasDef,
    CORE_RECORD_FIELD_ROWS,
    CORE_RECORD_LITERAL_ROWS,
    CoreRecordFieldRow,
    CoreRecordLiteralRow,
    IR_MARKER_ARG_VALUE,
    IR_PRELUDE_MARKER_RECORD,
    TYPE_NAMES,
    core_enum_payload_variants,
    ir_host_value_name,
    ir_runtime_handle_row,
]

sema_type_arguments_have_open_shape: fn(types: [Type]) -> Bool Never! {
    loop ty in types {
        if sema_union_member_has_open_shape(ty) -> return true
    }
    false
}

sema_type_tuple_fields_have_open_shape: fn(fields: [TypeTupleField]) -> Bool Never! {
    loop field in fields {
        if sema_union_member_has_open_shape(field.ty) -> return true
    }
    false
}

sema_union_member_has_open_shape: fn(ty: Type) -> Bool Never! {
    if ty == {
        .TraitObject(_) -> true
        .Fn(_, _, _, _, _, _) -> true
        .List(inner) -> sema_union_member_has_open_shape(inner)
        .Shared(inner) -> sema_union_member_has_open_shape(inner)
        .Option(inner) -> sema_union_member_has_open_shape(inner)
        .Tagged(_, inner) | .Case(_, inner) -> sema_union_member_has_open_shape(inner)
        .FixedList(inner, _) -> sema_union_member_has_open_shape(inner)
        .Map(key, _, value) -> sema_union_member_has_open_shape(key) || sema_union_member_has_open_shape(value)
        .Result(ok, err) -> sema_union_member_has_open_shape(ok) || sema_union_member_has_open_shape(err)
        .Apply(_, args) -> sema_type_arguments_have_open_shape(args)
        .Union(members) -> sema_type_arguments_have_open_shape(members)
        .Tuple(fields) -> sema_type_tuple_fields_have_open_shape(fields)
        .Int | .Float | .Bool | .String | .Char | .Named(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_type_arguments_have_forbidden_never: fn(types: [Type]) -> Bool Never! {
    loop ty in types {
        if sema_type_has_forbidden_never(ty, false) -> return true
    }
    false
}

sema_type_tuple_fields_have_forbidden_never: fn(fields: [TypeTupleField]) -> Bool Never! {
    loop field in fields {
        if sema_type_has_forbidden_never(field.ty, false) -> return true
    }
    false
}

sema_function_type_has_forbidden_never: fn(params: [Type], ret: Type?) -> Bool Never! {
    loop param in params {
        if sema_type_has_forbidden_never(param, false) -> return true
    }
    if ret == {
        .Val(return_type) -> sema_type_has_forbidden_never(return_type, true)
        .None -> false
    }
}

// `true` means the declared value position contains an illegal `Never`.
// Successful callable returns and failure-side `Never!` are the exceptions.
sema_type_has_forbidden_never: fn(ty: Type, allow_success_never: Bool) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "Never" && !allow_success_never
        .List(inner) -> sema_type_has_forbidden_never(inner, false)
        .Shared(inner) -> sema_type_has_forbidden_never(inner, false)
        .Option(inner) -> sema_type_has_forbidden_never(inner, false)
        .Tagged(_, inner) | .Case(_, inner) -> sema_type_has_forbidden_never(inner, false)
        .FixedList(inner, _) -> sema_type_has_forbidden_never(inner, false)
        .InlineRange(base, _, _) -> sema_type_has_forbidden_never(base, false)
        .Quantity(base, _) -> sema_type_has_forbidden_never(base, false)
        .Map(key, _, value) -> sema_type_has_forbidden_never(key, false) || sema_type_has_forbidden_never(value, false)
        .Result(ok, err) -> sema_type_has_forbidden_never(ok, allow_success_never) || sema_type_has_forbidden_never(err, true)
        .Fn(params, ret, _, _, _, _) -> sema_function_type_has_forbidden_never(params, ret)
        .Apply(_, args) -> sema_type_arguments_have_forbidden_never(args)
        .Union(members) -> sema_type_arguments_have_forbidden_never(members)
        .Tuple(fields) -> sema_type_tuple_fields_have_forbidden_never(fields)
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> false
    }
}

// The report for a `Never` that `sema_type_has_forbidden_never` (or a
// constructor naming `Never`) finds in a value position.
sema_never_as_value: fn(span: Span) -> Diagnostic {
    sema_error("E2422", span, "`Never` cannot be used in a value position.", "`Never` has no values; only a function return slot or function-type return slot may promise it.", "Move `Never` to a function return type, or use `()`/another value type.")
}

sema_effect_bound_compatible: fn(required: [EffectRowEntry]?, offered: [EffectRowEntry]?) -> Bool Never! {
    required_row: required ?? return true
    offered_row: offered ?? return false
    loop offered_entry in offered_row {
        found: loop required_entry in required_row {
            if required_entry.name == offered_entry.name {
                break true
            }
        } ?? false
        if !found -> return false
    }
    true
}

// The required row is the use-site contract; the offered row is what the
// function value proves it can satisfy.
sema_view_slot_equal: fn(left: [String], right: [String]) -> Bool Never! {
    if left.len() != right.len() -> return false
    loop (index, segment) in left {
        if segment != right[index] -> return false
    }
    true
}

sema_view_source_equal: fn(left: ViewSource, right: ViewSource) -> Bool Never! {
    if left == {
        .Receiver -> if right == {
            .Receiver -> true
            .Parameter(_) | .Static(_, _) -> false
        }
        .Parameter(index) -> if right == {
            .Parameter(other) -> index == other
            .Receiver | .Static(_, _) -> false
        }
        .Static(module_path, name) -> if right == {
            .Static(other_module, other_name) -> module_path == other_module && name == other_name
            .Receiver | .Parameter(_) -> false
        }
    }
}

sema_view_projection_equal: fn(left: ViewSourceProjection, right: ViewSourceProjection) -> Bool Never! {
    if left == {
        .Field(name) -> if right == {
            .Field(other) -> name == other
            .Index | .Range -> false
        }
        .Index -> if right == {
            .Index -> true
            .Field(_) | .Range -> false
        }
        .Range -> if right == {
            .Range -> true
            .Field(_) | .Index -> false
        }
    }
}

sema_view_source_path_equal: fn(left: ViewSourcePath, right: ViewSourcePath) -> Bool Never! {
    if !sema_view_source_equal(left.source, right.source) -> return false
    if left.projections.len() != right.projections.len() -> return false
    loop (index, projection) in left.projections {
        if !sema_view_projection_equal(projection, right.projections[index]) -> return false
    }
    true
}

sema_view_sources_subset: fn(candidate: [ViewSourcePath], allowed: [ViewSourcePath]) -> Bool Never! {
    loop path in candidate {
        found: loop allowed_path in allowed {
            if sema_view_source_path_equal(path, allowed_path) {
                break true
            }
        } ?? false
        if !found -> return false
    }
    true
}

sema_view_provenance_at: fn(map: ViewProvenanceMap, slot: [String]) -> ViewProvenance? {
    loop entry in map.entries {
        if sema_view_slot_equal(entry.slot, slot) -> return Val(entry.value)
    }
    None
}

sema_function_obligations_satisfy: fn(offered: FunctionObligations, required: FunctionObligations) -> Bool Never! {
    if required.effect_bound == .Val(required_effects) {
        offered_effects: offered.effect_bound ?? return false
        loop offered_effect in offered_effects {
            found: loop required_effect in required_effects {
                if offered_effect == required_effect {
                    break true
                }
            } ?? false
            if !found -> return false
        }
    }

    if required.param_contract != None && offered.param_contract != None {
        required_contract: required.param_contract ?? [CallContractRow]{}
        offered_contract: offered.param_contract ?? [CallContractRow]{}
        if required_contract.len() != offered_contract.len() -> return false
        loop (index, required_row) in required_contract {
            offered_row: offered_contract[index]
            if offered_row.label != required_row.label -> return false
            if offered_row.zone != ParamZone.Either && offered_row.zone != required_row.zone {
                return false
            }
        }
    }

    if required.variadic != None && offered.variadic != None {
        required_variadic: required.variadic ?? [Bool]{}
        offered_variadic: offered.variadic ?? [Bool]{}
        if required_variadic.len() != offered_variadic.len() -> return false
        loop (index, required_flag) in required_variadic {
            if required_flag != offered_variadic[index] -> return false
        }
    }

    if required.return_view_provenance == .Val(required_map) {
        offered_map: offered.return_view_provenance ?? return false
        loop required_entry in required_map.entries {
            offered_value: sema_view_provenance_at(offered_map, required_entry.slot) ?? return false
            if required_entry.value.mutable && !offered_value.mutable -> return false
            if !sema_view_sources_subset(offered_value.sources, required_entry.value.sources) {
                return false
            }
        }
    }
    true
}

sema_type_function_obligations_parts: fn(effect_bound: [EffectRowEntry]?, param_contract: [CallContractRow]?, call_metadata: FunctionCallMetadata?, return_view_provenance: ViewProvenanceMap?) -> FunctionObligations? {
    effect_names: effect_bound.map(fn(row) { loop entry in row -> entry.name })
    variadic := [Bool]?{None}
    if call_metadata == .Val(metadata) {
        has_variadic: loop flag in metadata.variadic {
            if flag {
                break true
            }
        } ?? false
        if has_variadic -> variadic = Val(metadata.variadic)
    }
    if effect_names == None && param_contract == None && variadic == None && return_view_provenance == None {
        return None
    }
    Val(FunctionObligations{effect_bound: effect_names, param_contract: param_contract, variadic: variadic, return_view_provenance: return_view_provenance})
}

sema_type_function_obligations: fn(ty: Type) -> FunctionObligations? {
    if ty == {
        .Fn(_, _, effect_bound, param_contract, call_metadata, return_view_provenance) -> sema_type_function_obligations_parts(effect_bound, param_contract, call_metadata, return_view_provenance)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

sema_type_obligations_nested: fn(required: Type, offered: Type) -> Bool Never! {
    if required == {
        .Fn(required_params, required_ret, _, _, _, _) -> {
            if offered == {
                .Fn(offered_params, offered_ret, _, _, _, _) -> {
                    required_obligations: sema_type_function_obligations(required)
                    if required_obligations == .Val(required_rows) {
                        offered_obligations: sema_type_function_obligations(offered) ?? FunctionObligations{effect_bound: None, param_contract: None, variadic: None, return_view_provenance: None}
                        if !sema_function_obligations_satisfy(offered_obligations, required_rows) {
                            return false
                        }
                    }
                    if required_params.len() != offered_params.len() -> return false
                    loop (index, required_param) in required_params {
                        if !sema_type_obligations_nested(required_param, offered_params[index]) {
                            return false
                        }
                    }
                    if sema_fn_return_is_never(offered_ret) -> return true
                    return if required_ret == {
                        .Val(required_value) -> if offered_ret == {
                            .Val(offered_value) -> sema_type_obligations_nested(required_value, offered_value)
                            .None -> type_is_unit_callable_return(required_value)
                        }
                        .None -> if offered_ret == {
                            .Val(offered_value) -> type_is_unit_callable_return(offered_value)
                            .None -> true
                        }
                    }
                }
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
            }
            return true
        }
        .List(required_inner) -> {
            if offered == .List(offered_inner) {
                return sema_type_obligations_nested(required_inner, offered_inner)
            }
        }
        .Case(required_name, required_payload) -> {
            if offered == .Case(offered_name, offered_payload) {
                return required_name == offered_name && sema_type_obligations_nested(required_payload, offered_payload)
            }
        }
        .Option(required_inner) -> {
            if offered == .Option(offered_inner) {
                return sema_type_obligations_nested(required_inner, offered_inner)
            }
        }
        .Shared(required_inner) -> {
            if offered == .Shared(offered_inner) {
                return sema_type_obligations_nested(required_inner, offered_inner)
            }
        }
        .Result(required_ok, required_err) -> {
            if offered == .Result(offered_ok, offered_err) {
                return sema_type_obligations_nested(required_ok, offered_ok) && sema_type_obligations_nested(required_err, offered_err)
            }
        }
        .Map(required_key, _, required_value) -> {
            if offered == .Map(offered_key, _, offered_value) {
                return sema_type_obligations_nested(required_key, offered_key) && sema_type_obligations_nested(required_value, offered_value)
            }
        }
        .Tuple(required_fields) -> {
            if offered == .Tuple(offered_fields) {
                if required_fields.len() != offered_fields.len() -> return false
                loop (index, required_field) in required_fields {
                    offered_field: offered_fields[index]
                    if required_field.name != offered_field.name || !sema_type_obligations_nested(required_field.ty, offered_field.ty) {
                        return false
                    }
                }
                return true
            }
        }
        .FixedList(required_elem, _) -> {
            if offered == .FixedList(offered_elem, _) {
                return sema_type_obligations_nested(required_elem, offered_elem)
            }
        }
        .Quantity(required_base, _) -> {
            if offered == .Quantity(offered_base, _) {
                return sema_type_obligations_nested(required_base, offered_base)
            }
        }
        .Union(required_members) -> {
            if offered == .Union(offered_members) {
                if required_members.len() != offered_members.len() -> return false
                loop (index, required_member) in required_members {
                    if !sema_type_obligations_nested(required_member, offered_members[index]) {
                        return false
                    }
                }
                return true
            }
        }
        .Tagged(marker, inner) -> return marker == TagMarker.Internal{internal_tag: InternalTag.CoreCryptoNominal} || sema_type_obligations_nested(inner, offered)
        .Int | .Float | .Bool | .String | .Char | .Named(_) | .Apply(_, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Measure(_) -> {}
    }
    if offered == {
        .Tagged(marker, inner) -> marker == TagMarker.Internal{internal_tag: InternalTag.CoreCryptoNominal} || sema_type_obligations_nested(required, inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> true
    }
}

sema_type_obligations_satisfy: fn(required: Type, offered: Type) -> Bool Never! {
    sema_type_obligations_nested(required, offered)
}

sema_type_carrier_compatible: fn(required: Type, offered: Type) -> Bool Never! {
    if required == {
        .List(required_inner) -> {
            if offered == .List(offered_inner) {
                return sema_type_carrier_compatible(required_inner, offered_inner)
            }
        }
        .Case(required_name, required_payload) -> {
            if offered == .Case(offered_name, offered_payload) {
                return required_name == offered_name && sema_type_carrier_compatible(required_payload, offered_payload)
            }
        }
        .Option(required_inner) -> {
            if offered == .Option(offered_inner) {
                return sema_type_carrier_compatible(required_inner, offered_inner)
            }
        }
        .Shared(required_inner) -> {
            if offered == .Shared(offered_inner) {
                return sema_type_carrier_compatible(required_inner, offered_inner)
            }
        }
        .Map(required_key, _, required_value) -> {
            if offered == .Map(offered_key, _, offered_value) {
                return sema_type_carrier_compatible(required_key, offered_key) && sema_type_carrier_compatible(required_value, offered_value)
            }
        }
        .FixedList(required_element, required_length) -> {
            if offered == .FixedList(offered_element, offered_length) {
                return required_length == offered_length && sema_type_carrier_compatible(required_element, offered_element)
            }
        }
        .Tuple(required_fields) -> {
            if offered == .Tuple(offered_fields) {
                if required_fields.len() != offered_fields.len() -> return false
                loop (index, required_field) in required_fields {
                    offered_field: offered_fields[index]
                    if required_field.name != offered_field.name || !sema_type_carrier_compatible(required_field.ty, offered_field.ty) {
                        return false
                    }
                }
                return true
            }
        }
        .Union(required_members) -> {
            if offered == .Union(offered_members) {
                if required_members.len() != offered_members.len() -> return false
                loop (index, required_member) in required_members {
                    if !sema_type_carrier_compatible(required_member, offered_members[index]) {
                        return false
                    }
                }
                return true
            }
        }
        // Two tags of one marker compare their payloads; a `core.crypto`
        // nominal tag on either side is that payload against the other type
        // (`^Secret` meets the tagged `Secret` of a vault row).
        .Tagged(required_marker, required_inner) -> {
            if offered == .Tagged(offered_marker, offered_inner) {
                if required_marker == offered_marker {
                    return sema_type_carrier_compatible(required_inner, offered_inner)
                }
            }
            if required_marker == (TagMarker.Internal{internal_tag: InternalTag.CoreCryptoNominal}) {
                return sema_type_carrier_compatible(required_inner, offered)
            }
        }
        .Quantity(required_base, required_dimension) -> {
            if offered == .Quantity(offered_base, offered_dimension) {
                return required_dimension == offered_dimension && sema_type_carrier_compatible(required_base, offered_base)
            }
        }
        .Result(required_ok, required_err) -> {
            if offered == .Result(offered_ok, offered_err) {
                return sema_type_carrier_compatible(required_ok, offered_ok) && sema_type_carrier_compatible(required_err, offered_err)
            }
        }
        .Apply(required_name, required_args) -> {
            if offered == .Apply(offered_name, offered_args) {
                if required_name != offered_name || required_args.len() != offered_args.len() {
                    return false
                }
                loop (index, required_arg) in required_args {
                    if !sema_type_carrier_compatible(required_arg, offered_args[index]) {
                        return false
                    }
                }
                return true
            }
        }
        .Fn(_, _, _, _, _, _) -> {
            if offered == .Fn(_, _, _, _, _, _) {
                return sema_function_types_compatible(required, offered)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .Named(_) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Measure(_) -> {}
    }
    if offered == .Tagged(offered_marker, offered_inner) {
        if offered_marker == (TagMarker.Internal{internal_tag: InternalTag.CoreCryptoNominal}) {
            return sema_type_carrier_compatible(required, offered_inner)
        }
    }
    type_identity_equal(required, offered)
}

sema_function_types_compatible: fn(required: Type, offered: Type) -> Bool Never! {
    required_normalized: type_with_effective_fn_returns(required)
    offered_normalized: type_with_effective_fn_returns(offered)
    if required_normalized == {
        .Fn(required_params, required_ret, required_effects, _, _, _) -> {
            if offered_normalized == {
                .Fn(offered_params, offered_ret, offered_effects, _, _, _) -> {
                    if required_params.len() != offered_params.len() -> return false
                    loop (index, required_param) in required_params {
                        if !sema_type_carrier_compatible(required_param, offered_params[index]) {
                            return false
                        }
                    }
                    // A callable that never returns (`-> Never`: it panics,
                    // exits or loops) fits any return slot; no caller ever
                    // reads its result.
                    return_compatible: if sema_fn_return_is_never(offered_ret) -> true else -> if required_ret == {
                        .Val(required_value) -> if offered_ret == {
                            .Val(offered_value) -> sema_type_carrier_compatible(required_value, offered_value) || sema_never_failing_return_fits(required_value, offered_value)
                            .None -> type_is_unit_callable_return(required_value)
                        }
                        .None -> if offered_ret == {
                            .Val(offered_value) -> type_is_unit_callable_return(offered_value)
                            .None -> true
                        }
                    }
                    return return_compatible && sema_effect_bound_compatible(required_effects, offered_effects)
                }
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    false
}

sema_fn_return_is_never: fn(ret: Type?) -> Bool Never! {
    if ret == .Val(value) -> return value == (Type.Named{name: "Never"})
    false
}

// A callable that cannot fail (`Never!`, or an optional return, which has no
// failure slot) fits any failure slot of the same success type; the fn-value
// adapter supplies the slot's carrier.
sema_never_failing_return_fits: fn(required: Type, offered: Type) -> Bool Never! {
    if required == .Result(required_ok, _) {
        if offered == .Result(offered_ok, offered_err) {
            return offered_err == (Type.Named{name: "Never"}) && sema_type_carrier_compatible(required_ok, offered_ok)
        }
        if offered == .Option(_) -> return sema_type_carrier_compatible(required_ok, offered)
    }
    false
}

// E0638 (#6281 c123): the first function type held inside the slot's type (a
// list's element, an optional's payload, a tuple field, a parameter or the
// return of a function type) that differs from the offered value's at the
// same place in whether it can fail; the answer is whether the slot's can.
// The fn-value adapter (IR ir_fn_widen) converts a standalone function value
// between its failing and non-failing forms, and its converting closure
// passes each argument on through the same adapter: a non-failing function
// argument widens into the failing form the value's parameter takes
// (sema_type_parameter_fn_failure_gap). Nothing converts the functions a
// collection already holds or a function returns, so such a value can't
// fill the slot. `nested` is false for the slot itself, where the two forms
// convert.
sema_type_nested_fn_failure_gap: fn(required: Type, offered: Type, nested: Bool) -> Bool? Never! {
    if required == {
        .Fn(required_params, required_ret, _, _, _, _) -> {
            if offered == .Fn(offered_params, offered_ret, _, _, _, _) {
                required_fails: sema_fn_return_fails(required_ret)
                if nested && !sema_fn_return_is_never(required_ret) && !sema_fn_return_is_never(offered_ret) && required_fails != sema_fn_return_fails(offered_ret) {
                    return Val(required_fails)
                }
                if required_params.len() == offered_params.len() {
                    loop (index, required_param) in required_params {
                        found: if nested -> sema_type_nested_fn_failure_gap(required_param, offered_params[index], true) else -> sema_type_parameter_fn_failure_gap(required_param, offered_params[index])
                        if found == .Val(gap) -> return Val(gap)
                    }
                }
                if required_ret == .Val(required_value) && offered_ret == .Val(offered_value) {
                    return sema_type_nested_fn_failure_gap(sema_fn_return_success(required_value), sema_fn_return_success(offered_value), true)
                }
            }
        }
        .List(required_inner) -> {
            if offered == .List(offered_inner) {
                return sema_type_nested_fn_failure_gap(required_inner, offered_inner, true)
            }
        }
        .Option(required_inner) -> {
            if offered == .Option(offered_inner) {
                return sema_type_nested_fn_failure_gap(required_inner, offered_inner, true)
            }
        }
        .Shared(required_inner) -> {
            if offered == .Shared(offered_inner) {
                return sema_type_nested_fn_failure_gap(required_inner, offered_inner, true)
            }
        }
        .Map(required_key, _, required_value) -> {
            if offered == .Map(offered_key, _, offered_value) {
                if sema_type_nested_fn_failure_gap(required_key, offered_key, true) == .Val(found) {
                    return Val(found)
                }
                return sema_type_nested_fn_failure_gap(required_value, offered_value, true)
            }
        }
        .FixedList(required_element, _) -> {
            if offered == .FixedList(offered_element, _) {
                return sema_type_nested_fn_failure_gap(required_element, offered_element, true)
            }
        }
        .Tuple(required_fields) -> {
            if offered == .Tuple(offered_fields) {
                if required_fields.len() != offered_fields.len() -> return None
                loop (index, required_field) in required_fields {
                    if sema_type_nested_fn_failure_gap(required_field.ty, offered_fields[index].ty, true) == .Val(found) {
                        return Val(found)
                    }
                }
            }
        }
        .Union(required_members) -> {
            if offered == .Union(offered_members) {
                if required_members.len() != offered_members.len() -> return None
                loop (index, required_member) in required_members {
                    if sema_type_nested_fn_failure_gap(required_member, offered_members[index], true) == .Val(found) {
                        return Val(found)
                    }
                }
            }
        }
        .Result(required_ok, required_err) -> {
            if offered == .Result(offered_ok, offered_err) {
                if sema_type_nested_fn_failure_gap(required_ok, offered_ok, true) == .Val(found) {
                    return Val(found)
                }
                return sema_type_nested_fn_failure_gap(required_err, offered_err, true)
            }
        }
        .Apply(required_name, required_args) -> {
            if offered == .Apply(offered_name, offered_args) {
                if required_name != offered_name || required_args.len() != offered_args.len() {
                    return None
                }
                loop (index, required_arg) in required_args {
                    if sema_type_nested_fn_failure_gap(required_arg, offered_args[index], true) == .Val(found) {
                        return Val(found)
                    }
                }
            }
        }
        // A tag keeps its payload's representation; one tag over the slot
        // keeps the slot's own nesting.
        .Tagged(_, required_inner) -> return sema_type_nested_fn_failure_gap(required_inner, sema_expr_unwrap_tag(offered), nested)
        .Case(_, required_payload) -> {
            if offered == .Case(_, offered_payload) {
                return sema_type_nested_fn_failure_gap(required_payload, offered_payload, true)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .Named(_) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> {}
    }
    None
}

// A function parameter of a standalone function value the slot converts: a
// slot parameter that cannot fail, where the value's can, widens (the
// argument returns Ok of what it returns), but nothing narrows a failing
// argument for a value that takes a non-failing one, and the functions
// inside the parameter keep their form.
sema_type_parameter_fn_failure_gap: fn(required: Type, offered: Type) -> Bool? Never! {
    if required == .Fn(required_params, required_ret, _, _, _, _) {
        if offered == .Fn(offered_params, offered_ret, _, _, _, _) {
            never: sema_fn_return_is_never(required_ret) || sema_fn_return_is_never(offered_ret)
            if !never && sema_fn_return_fails(required_ret) && !sema_fn_return_fails(offered_ret) {
                return Val(true)
            }
            if required_params.len() == offered_params.len() {
                loop (index, required_param) in required_params {
                    if sema_type_nested_fn_failure_gap(required_param, offered_params[index], true) == .Val(found) {
                        return Val(found)
                    }
                }
            }
            if required_ret == .Val(required_value) && offered_ret == .Val(offered_value) {
                return sema_type_nested_fn_failure_gap(sema_fn_return_success(required_value), sema_fn_return_success(offered_value), true)
            }
            return None
        }
    }
    sema_type_nested_fn_failure_gap(required, offered, true)
}

// A function type's return is its Result box: the representation a caller
// of the value reads (IR ir_fn_widens).
sema_fn_return_fails: fn(ret: Type?) -> Bool Never! {
    if ret == .Val(value) -> return sema_expr_unwrap_tag(value) == .Result(_, _)
    false
}

sema_fn_return_success: fn(value: Type) -> Type Never! {
    if value == .Result(ok, _) -> return ok.copy()
    value.copy()
}

// State-free assignment cases. Nominal aliases, trait implementation, and
// knowledge-loss gates require the module registries owned by the full checker.
sema_type_assignable: fn(required: Type, offered: Type) -> Bool Never! {
    // Value-slot comparison is recursive: callable metadata may differ at any
    // container depth, but required labels, effects and view origins still hold.
    if sema_type_carrier_compatible(required, offered) {
        // A nested function differs in failure, which no adapter converts (E0638).
        if sema_type_nested_fn_failure_gap(required, offered, false) != None -> return false
        return sema_type_obligations_satisfy(required, offered)
    }
    if sema_type_compute_tensor_compatible(required, offered) -> return true
    if required == {
        .List(required_element) -> {
            if offered == .FixedList(offered_element, _) {
                return type_identity_equal(required_element, offered_element)
            }
        }
        .Union(members) -> {
            loop member in members {
                if type_identity_equal(member, offered) -> return true
            }
            // A smaller union widens whole into one holding all its members.
            // A container of it does not (sema_type_carrier_compatible).
            if offered == .Union(offered_members) {
                return sema_type_union_covers(members, offered_members)
            }
        }
        // A record whose members are the same named members in another
        // order converts by value. A container of it does not.
        .Tuple(_) -> return sema_type_record_converts(required, offered)
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    false
}

// Whether `offered` is a record holding exactly the named members of the
// record `required`, each of the same type, in another order: it converts
// by value.
sema_type_record_converts: fn(required: Type, offered: Type) -> Bool Never! {
    required_fields: if required == .Tuple(fields) -> fields else -> {
        return false
    }
    offered_fields: if offered == .Tuple(fields) -> fields else -> {
        return false
    }
    if required_fields.len() != offered_fields.len() -> return false
    reordered := false
    loop (index, required_field) in required_fields {
        if required_field.name != offered_fields[index].name -> reordered = true
        matched: loop offered_field in offered_fields {
            if offered_field.name == required_field.name {
                break type_identity_equal(required_field.ty, offered_field.ty)
            }
        } ?? false
        if !matched -> return false
    }
    reordered
}

// Whether every member of `offered_members` is one of `members`.
sema_type_union_covers: fn(members: [Type], offered_members: [Type]) -> Bool Never! {
    loop offered_member in offered_members {
        covered: loop member in members {
            if type_identity_equal(member, offered_member) {
                break true
            }
        } ?? false
        if !covered -> return false
    }
    true
}

// The erased `Tensor` spelling is the storage boundary, so it meets every
// Tensor-family type (the shaped `Vec` and `Matrix` aliases included) in either
// direction; two shaped types stay exact.
sema_type_compute_tensor_compatible: fn(required: Type, offered: Type) -> Bool Never! {
    (sema_type_is_erased_tensor(required) && is_compute_tensor_family(offered)) || (sema_type_is_erased_tensor(offered) && is_compute_tensor_family(required))
}

sema_type_is_erased_tensor: fn(ty: Type) -> Bool Never! {
    if ty == .Named(name) {
        return name == "Tensor" || core_identity_is(name, "core.compute", "Tensor")
    }
    false
}

// The registered row of a type symbol (the first registered row, kept
// current by `sema_registration_index_nominal_rows`). Callers read the
// nominal in place (`graph.modules[row.module_index].nominals[row.row]`),
// so a lookup neither scans the registry nor copies fields, variants or the
// source declaration. A body's own id names no row.
sema_type_graph_nominal_row: fn(graph: SemaRegistrationGraph, id: SymbolID) -> SemaRegistrationRowRef? {
    graph.nominal_symbol_rows.get(id.id)
}

// The registered row of a resolved type symbol: the row the lookup found
// beside the symbol, else the id map (import bindings and export rows
// carry none). Both name the id's first registered row.
sema_type_graph_resolved_nominal_row: fn(graph: SemaRegistrationGraph, resolved: SemaRegistrationResolvedSymbol) -> SemaRegistrationRowRef? {
    if resolved.nominal_row == .Val(row) -> return Val(row)
    graph.nominal_symbol_rows.get(sema_resolved_id(graph, resolved).id)
}

sema_type_graph_canonical_symbol_name: fn(graph: SemaRegistrationGraph, resolved: SemaRegistrationResolvedSymbol) -> String Never! {
    sema_type_graph_canonical_name_at(graph, resolved, sema_type_graph_resolved_nominal_row(graph, resolved))
}

// sema_type_graph_canonical_symbol_name for a caller that already holds the
// symbol's sema_type_graph_resolved_nominal_row.
sema_type_graph_canonical_name_at: fn(graph: SemaRegistrationGraph, resolved: SemaRegistrationResolvedSymbol, nominal: SemaRegistrationRowRef?) -> String Never! {
    if nominal == .Val(row) {
        // The nominal is read in place: binding it copied the row and its Item.
        // Compiler-owned nominals keep the bare shared spelling (`Ordering`).
        if graph.modules[row.module_index].nominals[row.row].compiler_owned {
            return graph.modules[row.module_index].nominals[row.row].symbol.name
        }
        return sema_registration_nominal_spelling(graph, row)
    }
    sema_resolved_name(graph, resolved)
}

sema_type_name_is_generic: fn(generic_params: [TGenericParam], name: String) -> Bool Never! {
    loop generic_param in generic_params {
        if generic_param.name == name -> return true
    }
    false
}

// `caller` is the caller module's registration row (sema_type_module_row;
// -1 for a module the graph does not hold). Named-type resolution keys the
// caller by row: a lookup chain probes the String-keyed module map once, at
// its entry, and never per name.
sema_type_graph_resolve_named: fn(graph: SemaRegistrationGraph, name: String, caller: Int) -> Type Never! {
    // Snapshot: a lone program declares no registered type; a name reads as
    // written.
    if graph.mode == .Snapshot -> return Type.Named{name: name}
    if name == "" || name == "Unit" || name == "Err" || name == "Never" {
        return Type.Named{name: name}
    }
    // O(1) fast path for already-canonical plain nominal spellings (`pkg.Type`)
    // when the caller has no dotted local/import/namespace bindings.
    if name.contains(".") && (caller < 0 || !graph.modules[caller].has_dotted_symbols) {
        if graph.canonical_nominals == .Val(canonical_table) {
            if sema_registration_canonical_nominal_row(canonical_table, name, name_text_hash(name)) == .Val(row) {
                if canonical_table.is_plain_type[row] -> return Type.Named{name: name}
            }
        }
    }
    // A bare `Group` the caller neither declares nor imports is the task
    // group handle `task.group` binds, never a Core struct spelled `Group`
    // (core.data's carrier, core.sys's group entry, core.ui.xkb's key group)
    // that happens to be loaded.
    if name == "Group" && (caller < 0 || sema_registration_lookup_name_at(graph, caller, graph.modules[caller].module_identity, name) == None) {
        return Type.Named{name: name}
    }
    resolved: sema_type_graph_lookup_symbol_at(graph, caller, name) ?? return sema_type_graph_resolve_size_name(graph, name)
    if sema_resolved_kind(graph, resolved) == {
        .Trait -> Type.TraitObject{bounds: [String]{sema_type_graph_canonical_symbol_name(graph, resolved)}}
        .Type -> {
            // One row lookup serves the alias test and the spelling.
            nominal: sema_type_graph_resolved_nominal_row(graph, resolved)
            if nominal == .Val(row) {
                // Read in place: binding the nominal copied the row and its
                // Item. Single-level matches read the alias in place; a nested
                // `.SourceAST(.TypeAlias(definition))` pattern clones the Item.
                if graph.modules[row.module_index].nominals[row.row].kind == SemaRegistrationNominalKind.TypeAlias && graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
                    if item == .TypeAlias(definition) {
                        if definition.type_params.len() == 0 && definition.target == .Named(_) {
                            return sema_type_graph_resolve_named(graph, type_name(definition.target), sema_registration_module_index(graph, graph.modules[row.module_index].nominals[row.row].symbol.module_identity) ?? -1)
                        }
                        // A record alias (`Bounds: {min: Int, max: Int}`)
                        // names its record type, which has no other name; an
                        // alias of one generic application (`Ints: Pair<Int>`,
                        // `Byte: Unsigned<8>`) names that application.
                        if definition.type_params.len() == 0 && (sema_registration_record_type(definition.target) || sema_registration_generic_application(definition.target)) {
                            return sema_type_resolve_declared_recursive(graph, definition.target, sema_registration_module_index(graph, graph.modules[row.module_index].nominals[row.row].symbol.module_identity) ?? -1, [TGenericParam]{})
                        }
                    }
                }
                return Type.Named{name: sema_type_graph_canonical_name_at(graph, resolved, nominal)}
            }
            if module_is_core(resolved.source_module_identity) {
                return sema_resolved_ty(graph, resolved) ?? Type.Named{name: name}
            }
            Type.Named{name: name}
        }
        .Module | .Function | .Impl | .Constant | .Field | .Variant | .Parameter | .Local | .Import | .Foreign | .Label -> Type.Named{name: name}
    }
}

// A size name (`U8`) nothing the caller sees binds is Core's alias of it
// (`U8: Unsigned<8>` in core.prelude), resolved like any alias. The parser
// leaves a written size name as a name only in a file that binds that name
// somewhere (parser_bound_size_rows); everywhere else it reads the alias's
// type at once.
sema_type_graph_resolve_size_name: fn(graph: SemaRegistrationGraph, name: String) -> Type Never! {
    fallback: foundation_size_alias(name) ?? return Type.Named{name: name}
    loop row in sema_registration_nominal_rows_named(graph, name) {
        if graph.modules[row.module_index].module_name != "core.prelude" || !module_is_core(graph.modules[row.module_index].module_identity) -> next
        if graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
            if item == .TypeAlias(definition) -> return sema_type_resolve_declared_recursive(graph, definition.target, row.module_index, [TGenericParam]{})
        }
    }
    fallback
}

sema_type_graph_resolve_apply_name: fn(graph: SemaRegistrationGraph, name: String, caller: Int) -> String Never! {
    if name.contains(".") && (caller < 0 || !graph.modules[caller].has_dotted_symbols) {
        if graph.canonical_nominals == .Val(canonical_table) {
            if sema_registration_canonical_nominal_row(canonical_table, name, name_text_hash(name)) == .Val(row) {
                if canonical_table.is_plain_type[row] -> return if true -> name else -> ""
            }
        }
    }
    resolved: sema_type_graph_lookup_symbol_at(graph, caller, name) ?? return name
    if sema_resolved_kind(graph, resolved) == SymbolKind.Type {
        nominal: sema_type_graph_resolved_nominal_row(graph, resolved)
        if nominal != None -> return sema_type_graph_canonical_name_at(graph, resolved, nominal)
        if module_is_core(resolved.source_module_identity) {
            if sema_resolved_ty(graph, resolved) == .Val(builtin) {
                if builtin == .Named(leaf) -> return leaf
            }
        }
    }
    if true -> name else -> ""
}

sema_type_graph_resolve_trait_bound: fn(graph: SemaRegistrationGraph, name: String, caller: Int) -> String Never! {
    resolved: sema_type_graph_lookup_symbol_at(graph, caller, name) ?? return name
    if sema_resolved_kind(graph, resolved) == SymbolKind.Trait -> sema_type_graph_canonical_symbol_name(graph, resolved) else -> name
}

SemaTypeAliasCycleRow: struct {
    module_index: Int,
    row: Int,
    edges: [Int],
}

sema_type_alias_references: fn(ty: Type, names: ^[String]) Never! {
    if ty == {
        .Named(name) -> { names.push(name.copy()) }
        .Apply(name, args) -> {
            names.push(name.copy())
            loop arg in args -> sema_type_alias_references(arg, names)
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Tagged(_, inner) | .Case(_, inner) | .Quantity(inner, _) -> {
            sema_type_alias_references(inner, names)
        }
        .Map(key, _, value) | .Result(key, value) -> {
            sema_type_alias_references(key, names)
            sema_type_alias_references(value, names)
        }
        .Tuple(fields) -> {
            loop field in fields -> sema_type_alias_references(field.ty, names)
        }
        .Union(members) -> {
            loop member in members -> sema_type_alias_references(member, names)
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop parameter in params -> sema_type_alias_references(parameter, names)
            if ret == .Val(value) -> sema_type_alias_references(value, names)
        }
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> {}
    }
}

sema_type_alias_cycle_visit: fn(graph: ^SemaRegistrationGraph, rows: [SemaTypeAliasCycleRow], at: Int, marks: ^[Int], path: ^[Int]) Never! {
    marks[at] = 1
    path.push(at)
    loop target in rows[at].edges {
        if marks[target] == 0 {
            sema_type_alias_cycle_visit(graph, rows, target, marks, path)
            next
        }
        if marks[target] == 1 {
            start := 0
            loop start < path.len() && path[start] != target -> start += 1
            chain := [String]{}
            loop index in start..<path.len() {
                row: rows[path[index]]
                chain.push(graph.modules[row.module_index].nominals[row.row].symbol.name)
            }
            target_row: rows[target]
            chain.push(graph.modules[target_row.module_index].nominals[target_row.row].symbol.name)
            closing: rows[at]
            nominal: graph.modules[closing.module_index].nominals[closing.row]
            item: sema_registration_nominal_source_item(nominal.source) ?? return
            if item == .TypeAlias(definition) {
                chain_text: chain.join(" -> ")
                sema_registration_push_graph_diagnostic(graph, closing.module_index, sema_error("E0394", definition.target_span, "type alias cycle: {chain_text}", "transparent type aliases must expand to a non-alias type", "break the cycle by making one target a concrete type"))
            }
        }
    }
    _ := path.pop()
    marks[at] = 2
}

sema_type_alias_cycles_check: fn(graph: ^SemaRegistrationGraph) Never! {
    rows := [SemaTypeAliasCycleRow]{}
    positions := [U32:Int]{}
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].nominals.len() {
            // Read in place: binding the row copied every nominal, methods included.
            if graph.modules[module_index].nominals[row].kind != SemaRegistrationNominalKind.TypeAlias {
                next
            }
            positions[graph.modules[module_index].nominals[row].symbol.id.id] = rows.len()
            rows.push(SemaTypeAliasCycleRow{module_index: module_index, row: row, edges: [Int]{}})
        }
    }
    loop at in 0..<rows.len() {
        source: rows[at]
        nominal: graph.modules[source.module_index].nominals[source.row]
        item: sema_registration_nominal_source_item(nominal.source) ?? next
        if item == .TypeAlias(definition) {
            names := [String]{}
            sema_type_alias_references(definition.target, names)
            loop choice in definition.choices -> sema_type_alias_references(choice.target, names)
            loop name in names {
                bound := false
                loop parameter in definition.type_params {
                    if parameter.name == name -> bound = true
                }
                if bound -> next
                resolved: sema_type_graph_lookup_symbol(graph, nominal.symbol.module_identity, name) ?? next
                target: positions.get(sema_resolved_id(graph, resolved).id) ?? next
                rows[at].edges.push(target)
            }
        }
    }
    marks := [Int]{}
    loop _ in rows -> marks.push(0)
    path := [Int]{}
    loop at in 0..<rows.len() {
        if marks[at] == 0 -> sema_type_alias_cycle_visit(graph, rows, at, marks, path)
    }
}

// Whether `name`, written as a type in module row `caller`, names nothing:
// no primitive, type parameter, associated type, compiler or Core carrier
// the checker types itself, compiler-owned bound trait, Core export, or
// declared or imported type
// (#6294). A qualified spelling is judged by its module
// (sema_type_qualified_name_unknown). Core source and an incomplete graph are
// never judged here.
sema_type_written_name_unknown: fn(graph: SemaRegistrationGraph, caller: Int, name: String, generic_names: [String]) -> Bool {
    if !graph.complete || caller < 0 || module_is_core(graph.modules[caller].module_identity) {
        return false
    }
    if name == "" || name.contains(":") || name.contains("$") || generic_names.contains(name) {
        return false
    }
    if name.split_once(".") == .Val(qualified) {
        return sema_type_qualified_name_unknown(graph, caller, name, qualified.before, qualified.after)
    }
    if foundation_named_type(name) != (Type.Named{name: name}) -> return false
    if name == "Self" || name == "Shared" || name == "Unit" || name == "Never" || name == "Err" || name == "Dyn" || name == "_" || name == "()" || name == "str" || name == "bytes" || name == "Complex" {
        return false
    }
    if sema_reserved_type_name(name) || core_root_type(name) || sema_registration_core_builtin_is_name(name) || sema_registration_compiler_builtin_row(graph, name) != None || sema_type_builtin_trait_symbol(name) != None {
        return false
    }
    if sema_process_handle_type(name) || sema_call_reflection_synthetic_printable(name) || sema_stream_handle_owner(Type.Named{name: name}) != None {
        return false
    }
    if sema_type_graph_lookup_symbol_at(graph, caller, name) != None || sema_type_resolve_nominal_row_at(graph, Type.Named{name: name}, caller) != None {
        return false
    }
    // A standard or declared unit's type (`Meter`, an affine unit's `…Point`).
    if sema_registration_unit_fact_for_type(graph, Type.Named{name: name}) != None -> return false
    if core_type_modules(name).len() > 0 || sema_type_compiler_owned_name(name) -> return false
    !sema_type_graph_declares_assoc_type(graph, name)
}

// Whether qualified type name `name`, `alias.leaf`, written in module row
// `caller`, names nothing. A capitalized head (`Self.Item`) is a type's, not
// a module's, and a spelling that resolves names its declaration. Any other
// spelling names nothing when no module called `alias` is in scope there
// (the caller neither imports nor declares `alias`, and it is neither `core`
// nor a Core module's name), or when its module is in scope but its last
// word, a type name, resolves to no declaration: `core.World`,
// `core.math.Point2` (a file names a Core type through the module it
// imports, `math.Point2`; sema_type_core_path_import). A last word in lower
// case is no type name and is left to its module, and a path to a
// declaration its module keeps private (a `priv module` on the way, a `priv`
// member, a Core name the module does not export) is that module's privacy
// error, not a missing type. A type the Core module behind `alias` exports
// names it (sema_type_qualified_core_type).
sema_type_qualified_name_unknown: fn(graph: SemaRegistrationGraph, caller: Int, name: String, alias: String, leaf: String) -> Bool {
    if alias == "" || leaf == "" || sema_checked_module_uppercase(alias) {
        return false
    }
    if sema_type_graph_lookup_symbol_at(graph, caller, name) != None || sema_type_resolve_nominal_row_at(graph, Type.Named{name: name}, caller) != None {
        return false
    }
    if !sema_type_qualified_alias_in_scope(graph, caller, alias) -> return true
    requester: graph.modules[caller].module_identity
    if sema_registration_private_module_path(graph, requester, name) != None || sema_registration_private_member(graph, requester, alias, leaf) || sema_registration_core_private_qualified(graph, requester, alias, leaf) != None {
        return false
    }
    if sema_type_qualified_core_type(graph, caller, alias, leaf) -> return false
    last: if leaf.cut_last(".") == .Val(cut) -> cut.after else -> leaf
    if !sema_checked_module_uppercase(last) -> return false
    if sema_registration_unit_fact_for_type(graph, Type.Named{name: name}) != None -> return false
    !sema_type_compiler_owned_name(name)
}

// Whether `alias.leaf`, written in module row `caller`, names a type the
// Core module behind `alias` exports (`mem.Ptr` under `use core.mem`): the
// Core module the caller imports as `alias`, found as a call through
// `alias` finds it (sema_core_registration_import), else the one `alias` is
// the short name of. The import is judged by its module's name: `use
// core.mem` binds the identity `core.mem`, which is no `<corelib>/` source
// identity, so module_is_core does not hold for it.
sema_type_qualified_core_type: fn(graph: SemaRegistrationGraph, caller: Int, alias: String, leaf: String) -> Bool {
    if sema_core_registration_import(graph.modules[caller], graph.module_table, alias) == .Val(imported) {
        if imported.item != None -> return false
        module_name := imported.module_name
        if sema_registration_module_index_text(graph, imported.module_name) == .Val(index) -> module_name = graph.modules[index].module_name
        return sema_core_import_is_core(module_name) && sema_type_core_module_declares_type(module_name, leaf)
    }
    if core_module_for_alias(alias) == .Val(module_name) -> return sema_type_core_module_declares_type(module_name, leaf)
    false
}

// Whether Core module `module_name` exports type `leaf`: a type it declares,
// or a type the compiler builds that it exports by name (`Ptr` in core.mem),
// which is as much its declaration.
sema_type_core_module_declares_type: fn(module_name: String, leaf: String) -> Bool {
    core_module_has_type(module_name, leaf) || (core_module_has_member(module_name, leaf) && sema_type_compiler_owned_name(leaf))
}

// The import that names the type a Core path spells through `core`
// (`core.math.Point2`) when its Core module exports it: the module
// (`core.math`) and the spelling a file that imports it writes (`math.Point2`).
SemaTypeCoreImport: struct {
    module_name: String,
    written: String,
}

sema_type_core_path_import: fn(name: String) -> SemaTypeCoreImport? {
    path: name.cut_last(".") ?? return None
    if !path.before.starts_with("core.") || !core_module_has_type(path.before, path.after) {
        return None
    }
    module_word: path.before.cut_last(".") ?? return None
    Val(SemaTypeCoreImport{module_name: path.before, written: "{module_word.after}.{path.after}"})
}

// Whether a module called `alias` is in scope in module row `caller`: `core`,
// a Core module's name, an import's alias, or a name the caller declares or
// imports.
sema_type_qualified_alias_in_scope: fn(graph: SemaRegistrationGraph, caller: Int, alias: String) -> Bool {
    if alias == "core" || core_module_for_alias(alias) != None -> return true
    loop import in graph.modules[caller].imports {
        if import.declaration.alias == alias -> return true
    }
    sema_registration_lookup_name_at(graph, caller, graph.modules[caller].module_identity, alias) != None
}

// Whether `name` is a type the compiler owns that a program may write bare
// and no Core export row carries. Each group is read from its owner: the host
// values of build and comptime code (ir_host_value_name) but the two no
// program names, the built-in type catalog (TYPE_NAMES), the reflection
// fact enums (sema_fact_enum_variants), the compiler-owned payload enums
// (CORE_ENUM_PAYLOAD_ROWS), the data format markers (sema_data_is_json_name),
// then the runtime handles and compiler records a program may write
// (SEMA_TYPE_NAMEABLE_HANDLES, SEMA_TYPE_NAMEABLE_RECORDS) and the carriers
// the checker types itself (SEMA_TYPE_COMPILER_CARRIERS).
sema_type_compiler_owned_name: fn(name: String) -> Bool {
    if ir_host_value_name(name) {
        return name != IR_MARKER_ARG_VALUE && name != IR_PRELUDE_MARKER_RECORD
    }
    if TYPE_NAMES.contains(name) || sema_fact_enum_variants(name) != None || core_enum_payload_variants(name) != None {
        return true
    }
    sema_data_is_json_name(name) || SEMA_TYPE_NAMEABLE_HANDLES.contains(name) || SEMA_TYPE_NAMEABLE_RECORDS.contains(name) || SEMA_TYPE_COMPILER_CARRIERS.contains(name)
}

// The runtime handles (IR_RUNTIME_HANDLES) a program may write as a type with
// no import: the solver variables and constraints, the module grant handle,
// the text-width and log-span handles, the realtime receipt, a closed
// channel's marker and the FFI callback registration. The other handles are
// reached through their Core module's export or are the runtime's own.
// SEMA_TYPE_NAMEABLE_HANDLES_CHECKED holds the view to IR_RUNTIME_HANDLES.
SEMA_TYPE_NAMEABLE_HANDLES: [String]{
    "Closed",
    "Constraint",
    "FfiCallbackRegistration",
    "HVar",
    "LengthVar",
    "LogSpan",
    "Mod",
    "RealtimeReceipt",
    "TextWidth",
    "TextWidthAmbiguous",
    "TextWidthControls",
    "VVar",
}

SEMA_TYPE_NAMEABLE_HANDLES_CHECKED: #run sema_type_nameable_handles_checked(SEMA_TYPE_NAMEABLE_HANDLES)

// The number of names in `view` (SEMA_TYPE_NAMEABLE_HANDLES), once each keys
// a row of IR_RUNTIME_HANDLES; else the build stops naming the first stray.
sema_type_nameable_handles_checked: fn(view: [String]) -> Int {
    loop name in view {
        if ir_runtime_handle_row(name) == None {
            build_time_refused("SEMA_TYPE_NAMEABLE_HANDLES names {name}, which IR_RUNTIME_HANDLES does not hold")
        }
    }
    view.len()
}

// The compiler records (CORE_RECORD_FIELD_ROWS, CORE_RECORD_LITERAL_ROWS) a
// program may write as a type with no import: the reflection records that
// are no host value (a span, a type id, a heard call and its parts), a module
// grant and an expiry.
// SEMA_TYPE_NAMEABLE_RECORDS_CHECKED holds the view to the record rows.
SEMA_TYPE_NAMEABLE_RECORDS: [String]{
    "AttributionInfo",
    "ClassificationInfo",
    "CompilerArg",
    "CompilerCall",
    "CompilerName",
    "CompilerRejection",
    "ExactnessInfo",
    "Expired",
    "FactValue",
    "ItemInfo",
    "LayoutFact",
    "LayoutField",
    "MarkerArgInfo",
    "MeasureInfo",
    "ModGrant",
    "MovednessInfo",
    "NominalInfo",
    "ObligationInfo",
    "ObligationParamInfo",
    "OriginInfo",
    "SendabilityInfo",
    "SourceSpan",
    "TypeId",
    "UnitScaleProvenanceInfo",
    "ViewProvenanceInfo",
}

SEMA_TYPE_NAMEABLE_RECORDS_CHECKED: #run sema_type_nameable_records_checked(SEMA_TYPE_NAMEABLE_RECORDS, CORE_RECORD_FIELD_ROWS, CORE_RECORD_LITERAL_ROWS)

// The number of names in `view` (SEMA_TYPE_NAMEABLE_RECORDS), once each owns
// a row of `fields` or `literals`; else the build stops naming the first
// stray.
sema_type_nameable_records_checked: fn(view: [String], fields: [CoreRecordFieldRow], literals: [CoreRecordLiteralRow]) -> Int {
    loop name in view {
        if !sema_type_record_rows_own(fields, literals, name) {
            build_time_refused("SEMA_TYPE_NAMEABLE_RECORDS names {name}, which owns no row of CORE_RECORD_FIELD_ROWS or CORE_RECORD_LITERAL_ROWS")
        }
    }
    view.len()
}

sema_type_record_rows_own: fn(fields: [CoreRecordFieldRow], literals: [CoreRecordLiteralRow], name: String) -> Bool {
    loop row in fields {
        if row.owner == name -> return true
    }
    loop row in literals {
        if row.owner == name -> return true
    }
    false
}

// The carriers the checker types itself, which no Core source or registry
// row declares: the raw pointer `Ptr<T>` (`*T`), the coordinate spaces a
// geometry point, delta or transform names (sema_expr_geometry_space), the
// compute shapes `Vec` and `Matrix`, the collection windows `View` and
// `ViewMut`, a generator's `Stream`, the `FileLines` a file reader's
// `lines()` yields, and the `DataGroupedQuery` a query's `group_by` yields,
// which core.data declares without exporting.
SEMA_TYPE_COMPILER_CARRIERS: [String]{
    "@",
    "Camera",
    "DataGroupedQuery",
    "Device",
    "FileLines",
    "Matrix",
    "Ptr",
    "Screen",
    "Stream",
    "Vec",
    "View",
    "ViewMut",
    "World",
}

// Whether any trait of the graph declares associated type `name`, which its
// methods and implementations spell bare (`at: fn(self, i: Int) -> Elem`).
sema_type_graph_declares_assoc_type: fn(graph: SemaRegistrationGraph, name: String) -> Bool {
    loop module_index in 0..<graph.modules.len() {
        loop item in graph.modules[module_index].program.items {
            if item == .Trait(definition) {
                loop assoc in definition.assoc_types {
                    if assoc.name == name -> return true
                }
            }
        }
    }
    false
}

// Whether `ty`, a parameter type an argument is checked against, spells a
// name the caller cannot resolve and no module declares as a type or a type
// parameter, or a function type whose effect row names an unknown effect. The
// declaration that wrote it already reported E0119, so the argument's
// mismatch against it is no second error (#6294, #5540).
sema_type_names_undeclared: fn(graph: SemaRegistrationGraph, caller: Int, ty: Type, generic_names: [String]) -> Bool {
    if ty == {
        .Named(name) -> sema_type_written_name_unknown(graph, caller, name, generic_names) && !sema_type_graph_declares_name(graph, name)
        .Apply(name, args) -> {
            if sema_type_written_name_unknown(graph, caller, name, generic_names) && !sema_type_graph_declares_name(graph, name) {
                return true
            }
            loop arg in args {
                if sema_type_names_undeclared(graph, caller, arg, generic_names) -> return true
            }
            false
        }
        .List(inner) | .Option(inner) | .Shared(inner) | .Tagged(_, inner) | .Case(_, inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) -> sema_type_names_undeclared(graph, caller, inner, generic_names)
        .Result(ok, err) | .Map(ok, _, err) -> sema_type_names_undeclared(graph, caller, ok, generic_names) || sema_type_names_undeclared(graph, caller, err, generic_names)
        .Tuple(fields) -> {
            loop field in fields {
                if sema_type_names_undeclared(graph, caller, field.ty, generic_names) -> return true
            }
            false
        }
        .Union(members) -> {
            loop member in members {
                if sema_type_names_undeclared(graph, caller, member, generic_names) -> return true
            }
            false
        }
        .Fn(params, ret, effect_bound, _, _, _) -> {
            loop entry in effect_bound ?? [] {
                if entry.name.starts_with("..") -> next
                raw: if entry.name.starts_with("!") -> entry.name.split("!").to_list()[1] else -> entry.name
                if sema_effect_parse_name(raw) == None -> return true
            }
            loop param in params {
                if sema_type_names_undeclared(graph, caller, param, generic_names) -> return true
            }
            if ret == .Val(returned) {
                return sema_type_names_undeclared(graph, caller, returned, generic_names)
            }
            false
        }
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Quantity(_, _) | .Measure(_) -> false
    }
}

// The type parameter names of the generic nominal of a user module that
// `name`, written bare from module row `caller`, resolves to (`[T]` for `Box`
// with `Box: struct<T>`), or None when it names no such type.
sema_type_bare_generic_params: fn(graph: SemaRegistrationGraph, caller: Int, name: String, generic_names: [String]) -> [String]? {
    if generic_names.contains(name) -> return None
    row: sema_type_resolve_nominal_row_at(graph, Type.Named{name: name}, caller) ?? return None
    if module_is_core(graph.modules[row.module_index].module_identity) -> return None
    params: loop param in graph.modules[row.module_index].nominals[row.row].generic_params -> param.name
    if params.len() == 0 -> return None
    Val(params)
}

// E0104 at each generic type `ty` writes bare (`b: Box` for `Box: struct<T>`):
// a type position names one instance, so it spells the type arguments.
sema_type_bare_generic_names: fn(graph: SemaRegistrationGraph, caller: Int, ty: Type, span: Span, generic_names: [String], diagnostics: ^[Diagnostic]) {
    if ty == {
        .Named(name) -> {
            if sema_type_bare_generic_params(graph, caller, name, generic_names) == .Val(params) {
                example: loop _ in params -> "Int"
                diagnostics.push(sema_error("E0104", span, "`{name}` needs its type arguments", "`{name}<{params.join(", ")}>` is generic, and a type position names one of its instances", "write the types it holds, as in `{name}<{example.join(", ")}>`"))
            }
        }
        .Apply(_, args) | .Union(args) -> {
            loop arg in args -> sema_type_bare_generic_names(graph, caller, arg, span, generic_names, diagnostics)
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Quantity(inner, _) | .Case(_, inner) -> {
            sema_type_bare_generic_names(graph, caller, inner, span, generic_names, diagnostics)
        }
        .Map(key, _, value) | .Result(key, value) -> {
            sema_type_bare_generic_names(graph, caller, key, span, generic_names, diagnostics)
            sema_type_bare_generic_names(graph, caller, value, span, generic_names, diagnostics)
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop parameter in params -> sema_type_bare_generic_names(graph, caller, parameter, span, generic_names, diagnostics)
            if ret == .Val(value) -> sema_type_bare_generic_names(graph, caller, value, span, generic_names, diagnostics)
        }
        .Tuple(fields) -> {
            loop field in fields -> sema_type_bare_generic_names(graph, caller, field.ty, span, generic_names, diagnostics)
        }
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> {}
    }
}

// Whether `ty`, a parameter type an argument is checked against, writes a
// generic type bare: its declaration reported E0104
// (sema_type_bare_generic_names), so the argument's mismatch against it is no
// second error.
sema_type_names_bare_generic: fn(graph: SemaRegistrationGraph, caller: Int, ty: Type, generic_names: [String]) -> Bool {
    found := [Diagnostic]{}
    sema_type_bare_generic_names(graph, caller, ty, Span{start: 0, end: 0}, generic_names, found)
    found.len() > 0
}

// Whether any module of the graph declares `name` as a nominal type or as a
// type parameter of a nominal, function or method.
sema_type_graph_declares_name: fn(graph: SemaRegistrationGraph, name: String) -> Bool {
    loop module_index in 0..<graph.modules.len() {
        loop nominal_index in 0..<graph.modules[module_index].nominals.len() {
            if graph.modules[module_index].nominals[nominal_index].symbol.name == name {
                return true
            }
            loop param in graph.modules[module_index].nominals[nominal_index].generic_params {
                if param.name == name -> return true
            }
            loop method_index in 0..<graph.modules[module_index].nominals[nominal_index].methods.len() {
                loop param in graph.modules[module_index].nominals[nominal_index].methods[method_index].generic_params {
                    if param.name == name -> return true
                }
            }
        }
        loop function_index in 0..<graph.modules[module_index].functions.len() {
            loop param in graph.modules[module_index].functions[function_index].generic_params {
                if param.name == name -> return true
            }
        }
        loop impl_index in 0..<graph.modules[module_index].impls.len() {
            loop method_index in 0..<graph.modules[module_index].impls[impl_index].methods.len() {
                loop param in graph.modules[module_index].impls[impl_index].methods[method_index].generic_params {
                    if param.name == name -> return true
                }
            }
        }
    }
    false
}

// E0119 for every name a declared member type (`field: Foo`, `[Bar]?`,
// `Foo<Int>`) writes that names nothing, in walk order, and E0363 for a
// named union case whose name another member of its union takes.
sema_type_unknown_written_names: fn(graph: SemaRegistrationGraph, caller: Int, ty: Type, span: Span, generic_names: [String], diagnostics: ^[Diagnostic]) {
    if ty == {
        .Named(name) -> {
            if sema_type_written_name_unknown(graph, caller, name, generic_names) {
                diagnostics.push(sema_unknown_type_name(name, span, sema_type_declared_names(graph, caller), sema_source_word_span(graph, caller, span, name)))
            }
        }
        .Apply(name, args) -> {
            if sema_type_written_name_unknown(graph, caller, name, generic_names) {
                sema_unknown_generic_type_name(name, span, diagnostics)
            } else if sema_type_family_size_refused(graph, caller, name, args, generic_names) == .Val(written) {
                diagnostics.push(sema_error("E0314", span, "`{written}` is no size of the `{name}` family", "a number family has only its standard sizes: {foundation_family_size_list(name)}", "use a standard size, or a range type such as `Int(0..127)` for a narrower set of values"))
            }
            loop arg in args {
                sema_type_unknown_written_names(graph, caller, arg, span, generic_names, diagnostics)
            }
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Quantity(inner, _) | .Case(_, inner) -> {
            sema_type_unknown_written_names(graph, caller, inner, span, generic_names, diagnostics)
        }
        .Map(key, _, value) | .Result(key, value) -> {
            sema_type_unknown_written_names(graph, caller, key, span, generic_names, diagnostics)
            sema_type_unknown_written_names(graph, caller, value, span, generic_names, diagnostics)
        }
        .Fn(params, ret, _, _, _, _) -> {
            loop parameter in params {
                sema_type_unknown_written_names(graph, caller, parameter, span, generic_names, diagnostics)
            }
            if ret == .Val(value) {
                sema_type_unknown_written_names(graph, caller, value, span, generic_names, diagnostics)
            }
        }
        .Union(members) -> {
            if {
                caller >= 0 && caller < graph.modules.len() -> sema_type_union_case_conflicts(members, graph.modules[caller].program.items, span, diagnostics)
                else -> sema_type_union_case_conflicts(members, [Item]{}, span, diagnostics)
            }
            loop member in members {
                sema_type_unknown_written_names(graph, caller, member, span, generic_names, diagnostics)
            }
        }
        .Tuple(fields) -> {
            loop field in fields {
                sema_type_unknown_written_names(graph, caller, field.ty, span, generic_names, diagnostics)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> {}
    }
}

// E0363 for a named case of the union `members` whose name another member
// takes: a member type with that name or that leaf name (`Point`,
// `geo.Point`, an inline module's `M3GeoPoint` read through `items`, its
// module's items, sema_name_type_leaf), or an earlier case of that name with
// another payload type. A case repeated with its payload is one case.
sema_type_union_case_conflicts: fn(members: [Type], items: [Item], span: Span, diagnostics: ^[Diagnostic]) {
    loop index in 0..<members.len() {
        if members[index] == .Case(name, payload) {
            loop other_index in 0..<members.len() {
                other: members[other_index]
                if other == .Case(other_name, other_payload) {
                    if other_index < index && other_name == name && !type_identity_equal(other_payload, payload) {
                        diagnostics.push(sema_error("E0363", span, "`{type_name(members[index])}` can't be a union member", "the named case `{name}` already carries `{type_name(other_payload)}` in this union", "give each named case one payload type"))
                    }
                } else if type_union_member_tag(other) == name || sema_type_union_member_leaf(items, other) == name {
                    diagnostics.push(sema_error("E0363", span, "`{type_name(members[index])}` can't be a union member", "the named case `{name}` reuses the name of a member type of this union", "rename the case so no member type of the union has its name"))
                }
            }
        }
    }
}

// sema_type_union_case_conflicts for a union written in the environment's
// module, whose items name the types it lifted from inline modules.
sema_type_union_case_conflicts_in: fn(members: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables, span: Span, diagnostics: ^[Diagnostic]) {
    graph: program.registration_graph
    if sema_scope_caller_index(environment, graph) == .Val(row) {
        sema_type_union_case_conflicts(members, graph.modules[row].program.items, span, diagnostics)
        return
    }
    sema_type_union_case_conflicts(members, [Item]{}, span, diagnostics)
}

// The leaf name of nominal union member `member`, a type of the module
// whose items are `items`: `Point` for `Point`, `geo.Point` and the
// `M3GeoPoint` an inline module `geo` lifts; "" for any other member.
sema_type_union_member_leaf: fn(items: [Item], member: Type) -> String Never! {
    sema_name_type_leaf(items, type_unqualified_name(sema_pattern_base_name(member) ?? return ""))
}

// A fixed length `[T#N]` in a declared member type names an integer constant, a
// generic length, or a module value argument (generic modules are expanded
// before registration). A name that is none of these is E0963 at the written
// type, once per type.
sema_type_unknown_measure_names: fn(graph: SemaRegistrationGraph, caller: Int, ty: Type, span: Span, generic_names: [String], diagnostics: ^[Diagnostic]) {
    if ty == {
        .FixedList(inner, len) -> {
            if sema_type_measure_unknown_name(graph, caller, len, generic_names) == .Val(unknown) {
                diagnostics.push(sema_error("E0963", span, "a fixed-size list length must resolve to a compile-time integer", "the measure name `{unknown}` is not a declared constant or module value parameter", "use an integer literal, an integer constant, or a module Int value argument"))
                return
            }
            sema_type_unknown_measure_names(graph, caller, inner, span, generic_names, diagnostics)
        }
        .Apply(_, args) | .Union(args) -> {
            loop arg in args {
                sema_type_unknown_measure_names(graph, caller, arg, span, generic_names, diagnostics)
            }
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .InlineRange(inner, _, _) | .Quantity(inner, _) | .Case(_, inner) -> {
            sema_type_unknown_measure_names(graph, caller, inner, span, generic_names, diagnostics)
        }
        .Map(key, _, value) | .Result(key, value) -> {
            sema_type_unknown_measure_names(graph, caller, key, span, generic_names, diagnostics)
            sema_type_unknown_measure_names(graph, caller, value, span, generic_names, diagnostics)
        }
        .Tuple(fields) -> {
            loop field in fields {
                sema_type_unknown_measure_names(graph, caller, field.ty, span, generic_names, diagnostics)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> {}
    }
}

// The first name in `measure` that resolves to nothing.
sema_type_measure_unknown_name: fn(graph: SemaRegistrationGraph, caller: Int, measure: Measure, generic_names: [String]) -> String? {
    if measure == {
        .Symbol(_, name) -> {
            if generic_names.contains(name) -> return None
            loop constant in graph.modules[caller].constants {
                if constant.symbol.name == name -> return None
            }
            if sema_type_graph_lookup_symbol_at(graph, caller, name) == None -> Val(name.copy()) else -> None
        }
        .Combined(_, _, left, right) -> {
            if sema_type_measure_unknown_name(graph, caller, left, generic_names) == .Val(unknown) {
                return Val(unknown)
            }
            sema_type_measure_unknown_name(graph, caller, right, generic_names)
        }
        .Literal(_, _) | .SignedLiteral(_, _) -> None
    }
}

// E0119 for the written parameter and return type names of `func`, a
// function or method of module row `caller`. A body that reaches an unusable
// declaration has no function check, where a signature is judged otherwise
// (sema_check_failure_contract_type); its misspelled signature types still
// report alongside the misspelled member (sema_check_record_unusable_bodies,
// collect-all).
sema_type_func_unknown_names: fn(graph: SemaRegistrationGraph, caller: Int, func: Func, owner_names: [String], diagnostics: ^[Diagnostic]) {
    generic_names := owner_names.copy()
    loop param in func.type_params -> generic_names.push(param.name)
    loop param in func.params {
        sema_type_unknown_written_names(graph, caller, param.ty, param.ty_span, generic_names, diagnostics)
    }
    if func.return_type == .Val(ty) {
        sema_type_unknown_written_names(graph, caller, ty, func.return_type_span ?? func.name_span, generic_names, diagnostics)
    }
}

sema_type_is_scalar_resolved: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 | .Measure(_) -> true
        .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) -> false
    }
}

sema_type_resolve_declared_recursive: fn(graph: SemaRegistrationGraph, ty: Type, caller: Int, generic_params: [TGenericParam]) -> Type Never! {
    // Snapshot: a lone program declares no registered type; a type reads as
    // written.
    if graph.mode == .Snapshot -> ty else -> sema_type_resolve_declared_rows(graph, ty, caller, generic_params)
}

// sema_type_resolve_declared_recursive on a registered graph's rows.
sema_type_resolve_declared_rows: fn(graph: SemaRegistrationGraph, ty: Type, caller: Int, generic_params: [TGenericParam]) -> Type Never! {
    if ty == {
        .Named(name) -> if sema_type_name_is_generic(generic_params, name) -> ty else -> sema_type_graph_resolve_named(graph, name, caller)
        .Apply(name, args) -> {
            rewritten: loop arg in args -> sema_type_resolve_type_argument(graph, arg, caller, generic_params)
            if rewritten.len() == 1 && name == "@" {
                return Type.Apply{name: "@", args: rewritten}
            }
            if rewritten.len() == 1 && sema_type_core_pointer_name(graph, name, caller) {
                return Type.Apply{name: "Ptr", args: rewritten}
            }
            if sema_type_name_is_generic(generic_params, name) {
                return Type.Apply{name: name, args: rewritten}
            }
            resolved: sema_type_graph_lookup_symbol_at(graph, caller, name)
            head := name
            row := SemaRegistrationRowRef?{None}
            if resolved == .Val(found) {
                if sema_resolved_kind(graph, found) == SymbolKind.Type {
                    nominal := sema_type_graph_resolved_nominal_row(graph, found)
                    if nominal != None {
                        head = sema_type_graph_canonical_name_at(graph, found, nominal)
                        row = nominal
                    } else if module_is_core(found.source_module_identity) {
                        if sema_resolved_ty(graph, found) == .Val(builtin) {
                            if builtin == .Named(leaf) -> head = leaf
                        }
                    }
                }
            } else if !(caller >= 0 && module_is_core(graph.modules[caller].module_identity)) {
                row = sema_type_unscoped_nominal_row(graph, name, caller)
            }
            // A number family nothing the caller sees binds is Core's, as a
            // size name is (sema_type_graph_resolve_size_name): `Unsigned<8>`
            // is U8 wherever core.prelude is not loaded.
            if resolved == None && row == None && foundation_number_family(name) {
                if foundation_family_sizes(rewritten) == .Val(sizes) {
                    if foundation_family_type(name, sizes) == .Val(sized) -> return sized
                }
            }
            // Invalid alias graphs are rejected during registration, before
            // consumers can recurse through their transparent targets; under
            // JET_KEEP_GOING an alias expands only from a settled module row
            // (sema_registration_module_settled), so a cycle reported in its
            // module is never followed.
            if row == .Val(alias_row) {
                if sema_type_number_family_at(graph, alias_row, rewritten) == .Val(sized) -> return sized
                if graph.modules[alias_row.module_index].nominals[alias_row.row].kind == SemaRegistrationNominalKind.TypeAlias && rewritten.len() == graph.modules[alias_row.module_index].nominals[alias_row.row].generic_params.len() && sema_registration_module_settled(graph, alias_row.module_index) {
                    nominal: graph.modules[alias_row.module_index].nominals[alias_row.row]
                    item: sema_registration_nominal_source_item(nominal.source) ?? return Type.Apply{name: head, args: rewritten}
                    if item == .TypeAlias(definition) {
                        names: loop parameter in definition.type_params -> parameter.name
                        target: sema_type_alias_expanded(graph, alias_row.module_index, definition, rewritten, names) ?? return Type.Apply{name: head, args: rewritten}
                        return sema_type_resolve_declared_recursive(graph, target, sema_registration_module_index(graph, nominal.symbol.module_identity) ?? -1, generic_params)
                    }
                }
            }
            Type.Apply{name: head, args: rewritten}
        }
        .List(inner) -> if sema_type_is_scalar_resolved(inner) -> ty else -> Type.List{element: sema_type_resolve_declared_recursive(graph, inner, caller, generic_params)}
        .Shared(inner) -> if sema_type_is_scalar_resolved(inner) -> ty else -> Type.Shared{inner: sema_type_resolve_declared_recursive(graph, inner, caller, generic_params)}
        .Option(inner) -> if sema_type_is_scalar_resolved(inner) -> ty else -> Type.Option{inner: sema_type_resolve_declared_recursive(graph, inner, caller, generic_params)}
        .Result(ok, err) -> if sema_type_is_scalar_resolved(ok) && sema_type_is_scalar_resolved(err) -> ty else -> Type.Result{ok: sema_type_resolve_declared_recursive(graph, ok, caller, generic_params), err: sema_type_resolve_declared_recursive(graph, err, caller, generic_params)}
        .Fn(params, ret, effects, contract, metadata, provenance) -> {
            rewritten: loop parameter in params -> sema_type_resolve_declared_recursive(graph, parameter, caller, generic_params)
            // A plain branch, not `ret.map(…)`: a callback would capture (copy) the whole graph.
            resolved_ret := Type?{None}
            if ret == .Val(value) {
                resolved_ret = Val(sema_type_resolve_declared_recursive(graph, value, caller, generic_params))
            }
            Type.Fn{params: rewritten, ret: resolved_ret, effect_bound: effects, param_contract: contract, call_metadata: metadata, return_view_provenance: provenance}
        }
        .TraitObject(bounds) -> Type.TraitObject{bounds: loop bound in bounds -> sema_type_graph_resolve_trait_bound(graph, bound, caller)}
        .Tuple(fields) -> Type.Tuple{fields: loop field in fields -> TypeTupleField{name: field.name, ty: sema_type_resolve_declared_recursive(graph, field.ty, caller, generic_params)}}
        // copy: an unresolved `length` is a payload of read parameter `ty`, which keeps the original; field `len` of the new Type.FixedList owns this one
        .FixedList(inner, length) -> Type.FixedList{elem: sema_type_resolve_declared_recursive(graph, inner, caller, generic_params), len: sema_type_resolve_measure(graph, length, caller, generic_params, 0)}
        .InlineRange(base, lo, hi) -> Type.InlineRange{base: sema_type_resolve_declared_recursive(graph, base, caller, generic_params), lo: lo, hi: hi}
        // copy: `marker` is a payload of read parameter `ty`, which keeps the original; field `marker` of the new Type.Tagged owns this one
        .Tagged(marker, inner) -> Type.Tagged{marker: marker.copy(), inner: sema_type_resolve_declared_recursive(graph, inner, caller, generic_params)}
        .Union(members) -> Type.Union{members: loop member in members -> sema_type_resolve_declared_recursive(graph, member, caller, generic_params)}
        .Case(name, payload) -> Type.Case{name: name, payload: sema_type_resolve_declared_recursive(graph, payload, caller, generic_params)}
        // copy: `dimension` is a payload of read parameter `ty`, which keeps the original; field `dimension` of the new Type.Quantity owns this one
        .Quantity(base, dimension) -> Type.Quantity{base: sema_type_resolve_declared_recursive(graph, base, caller, generic_params), dimension: dimension.copy()}
        // copy: `key_span` is a payload of read parameter `ty`, which keeps the original; field `key_span` of the new Type.Map owns this one
        .Map(key, key_span, value) -> if sema_type_is_scalar_resolved(key) && sema_type_is_scalar_resolved(value) -> ty else -> Type.Map{key: sema_type_resolve_declared_recursive(graph, key, caller, generic_params), key_span: key_span.copy(), value: sema_type_resolve_declared_recursive(graph, value, caller, generic_params)}
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 | .Measure(_) -> ty
    }
}

// A Core number family (`Signed`, `Unsigned`, `IEEE`,
// declared once in core.prelude) applied to a standard size is that size's
// type: `Unsigned<8>` is U8 and `IEEE<11, 52>` is F64. `row` is the nominal
// the written head resolved to by ordinary lookup, so a type the caller
// declares or imports under a family's name is its own and never a number.
// None for any other head, and for a size the family does not have (E0314,
// sema_type_family_size_refused).
sema_type_number_family_at: fn(graph: SemaRegistrationGraph, row: SemaRegistrationRowRef, args: [Type]) -> Type? Never! {
    if !sema_type_number_family_row(graph, row) -> return None
    sizes: foundation_family_sizes(args) ?? return None
    foundation_family_type(graph.modules[row.module_index].nominals[row.row].symbol.name, sizes)
}

// Whether `row` is one of Core's number family declarations.
sema_type_number_family_row: fn(graph: SemaRegistrationGraph, row: SemaRegistrationRowRef) -> Bool Never! {
    graph.modules[row.module_index].module_name == "core.prelude" && module_is_core(graph.modules[row.module_index].module_identity) && foundation_number_family(graph.modules[row.module_index].nominals[row.row].symbol.name)
}

// The written spelling of a number family application at a size the family
// does not have (`Unsigned<24>`), for E0314. None when `name` is not Core's
// family under the caller's lookup, or a size is not a number literal (the
// family's own `Unsigned<bits>`).
sema_type_family_size_refused: fn(graph: SemaRegistrationGraph, caller: Int, name: String, args: [Type], generic_names: [String]) -> String? {
    if !foundation_number_family(name) || generic_names.contains(name) -> return None
    sizes: foundation_family_sizes(args) ?? return None
    resolved: sema_type_graph_lookup_symbol_at(graph, caller, name) ?? return None
    row: sema_type_graph_resolved_nominal_row(graph, resolved) ?? return None
    if !sema_type_number_family_row(graph, row) || foundation_family_type(name, sizes) != None -> return None
    written: loop size in sizes -> "{size}"
    Val("{name}<{written.join(", ")}>")
}

// How a diagnostic names `written`, a type as its source spells it, when that
// is an application of a generic alias: the alias as written, then its one
// full expansion, `Grid<Int>` (which is [[Int]]). None for any other type,
// and while the alias does not expand (sema_type_resolve_declared_recursive).
sema_type_alias_shown: fn(graph: SemaRegistrationGraph, written: Type, caller: Int, generic_params: [TGenericParam]) -[]> String? {
    if written == .Apply(name, args) {
        if sema_type_name_is_generic(generic_params, name) -> return None
        head: sema_type_graph_resolve_apply_name(graph, name, caller)
        row: sema_type_lookup_nominal_row(graph, sema_type_graph_lookup_symbol_at(graph, caller, head), head, caller) ?? return None
        nominal: graph.modules[row.module_index].nominals[row.row]
        if nominal.kind != SemaRegistrationNominalKind.TypeAlias || nominal.generic_params.len() != args.len() {
            return None
        }
        shown: type_name(type_unqualified_nominals(written))
        expanded: sema_type_resolve_declared_recursive(graph, written, caller, generic_params)
        if type_name(expanded) == shown -> return None
        return Val("`{shown}` (which is {sema_type_show(expanded)})")
    }
    None
}

// Each parameter in `items` whose written type applies a generic alias, by
// the offset of its name: the alias as written and its one expansion
// (sema_type_alias_shown), as hover names the parameter. `caller` is the
// items' module.
sema_type_alias_shown_params: fn(graph: SemaRegistrationGraph, caller: Int, items: [Item]) -[]> [Int:String] {
    shown := [Int:String]{}
    loop item in items {
        if item == .Func(function) {
            sema_type_alias_shown_add(graph, caller, function.params, shown)
        }
        if item == .Struct(value) {
            loop method in value.methods {
                sema_type_alias_shown_add(graph, caller, method.params, shown)
            }
        }
        if item == .Enum(value) {
            loop method in value.methods {
                sema_type_alias_shown_add(graph, caller, method.params, shown)
            }
        }
        if item == .Impl(value) {
            loop method in value.methods {
                sema_type_alias_shown_add(graph, caller, method.params, shown)
            }
        }
    }
    shown
}

sema_type_alias_shown_add: fn(graph: SemaRegistrationGraph, caller: Int, params: [Param], shown: ^[Int:String]) -[]> {
    loop param in params {
        text: sema_type_alias_shown(graph, param.ty, caller, [TGenericParam]{}) ?? next
        shown[param.name_span.start] = text
    }
}

// The type an alias stands for under `args`, with `names` (its parameters, or
// none to keep them as written) substituted by `args`: its target, or the
// first choice of a computed alias whose condition holds. None while a
// condition can't be decided, as when an argument is still a type parameter.
// `module_index` is the alias's module, whose constants a condition may read.
sema_type_alias_expanded: fn(graph: SemaRegistrationGraph, module_index: Int, definition: TypeAliasDef, args: [Type], names: [String]) -> Type? {
    if definition.choices.len() == 0 {
        return Val(sema_inference_substitute_type(definition.target, names, args))
    }
    values: sema_type_alias_number_values(graph, module_index, definition, args)
    loop choice in definition.choices {
        cond: choice.cond ?? return Val(sema_inference_substitute_type(choice.target, names, args))
        folded: sema_genmod_fold(cond, values, SemaGenericModuleEnums{}) ?? return None
        if folded == .Bool(holds, _, _) {
            if holds -> return Val(sema_inference_substitute_type(choice.target, names, args))
        } else { return None }
    }
    None
}

// The whole numbers a computed alias's conditions fold over: its number
// parameters bound to the literals in `args`, and the module constants the
// conditions name. A parameter shadows a constant of the same name.
sema_type_alias_number_values: fn(graph: SemaRegistrationGraph, module_index: Int, definition: TypeAliasDef, args: [Type]) -> SemaInlineValues Never! {
    values := SemaInlineValues{}
    loop (index, param) in definition.type_params {
        if index >= args.len() -> break
        if args[index] == .Measure(measure) {
            if measure_literal_value(measure) == .Val(number) {
                sema_inline_value_put(values, param.name, Expr.Int{value: number, span: param.name_span, width: None, raw: None, id: AST_NODE_GENERATED})
            }
        }
    }
    loop name in sema_type_alias_constant_names(definition) {
        if sema_type_measure_constant(graph, module_index, name, 0) == .Val(number) {
            sema_inline_value_put(values, name, Expr.Int{value: number, span: definition.name_span, width: None, raw: None, id: AST_NODE_GENERATED})
        }
    }
    values
}

// The names a computed alias's conditions read that aren't its parameters:
// each may only be a constant of the alias's module.
sema_type_alias_constant_names: fn(definition: TypeAliasDef) -> [String] Never! {
    names := [String]{}
    loop choice in definition.choices {
        cond: choice.cond ?? next
        loop site in comptime_walk_identifiers(cond) {
            if names.contains(site.name) -> next
            shadowed := false
            loop param in definition.type_params {
                if param.name == site.name -> shadowed = true
            }
            if !shadowed -> names.push(site.name)
        }
    }
    names
}

// One argument of `Name<…>`: a constant of the spelling module (`Packet<SIZE>`)
// is the number it holds, as a literal argument (`Packet<4>`) is.
sema_type_resolve_type_argument: fn(graph: SemaRegistrationGraph, arg: Type, caller: Int, generic_params: [TGenericParam]) -> Type Never! {
    if arg == .Named(name) && !sema_type_name_is_generic(generic_params, name) {
        if sema_type_measure_constant(graph, caller, name, 0) == .Val(value) && value >= 0 {
            return Type.Measure{measure: Measure.Literal{kind: "length", value: value}}
        }
    }
    sema_type_resolve_declared_recursive(graph, arg, caller, generic_params)
}

// A fixed length spelled by a constant of the module that spells it (`[T#N]`,
// `[T#(N * 2)]`) is that constant's integer. A name that isn't such a constant
// (a generic length, a constant computed by code) stays symbolic.
sema_type_resolve_measure: fn(graph: SemaRegistrationGraph, measure: Measure, caller: Int, generic_params: [TGenericParam], depth: Int) -> Measure Never! {
    if measure == {
        .Symbol(kind, name) -> {
            if !sema_type_name_is_generic(generic_params, name) {
                if sema_type_measure_constant(graph, caller, name, depth) == .Val(value) {
                    if value >= 0 -> return Measure.Literal{kind: kind, value: value}
                }
            }
            measure
        }
        .Combined(kind, rule, left, right) -> {
            resolved_left: sema_type_resolve_measure(graph, left, caller, generic_params, depth)
            resolved_right: sema_type_resolve_measure(graph, right, caller, generic_params, depth)
            if rule != MeasureRule.Match {
                if measure_literal_value(resolved_left) == .Val(left_value) {
                    if measure_literal_value(resolved_right) == .Val(right_value) {
                        folded: if rule == MeasureRule.Add -> left_value + right_value else -> left_value * right_value
                        return Measure.Literal{kind: measure_kind(resolved_left), value: folded}
                    }
                }
            }
            Measure.Combined{kind: kind, rule: rule, left: resolved_left, right: resolved_right}
        }
        // copy: as the unresolved symbol above.
        .Literal(_, _) | .SignedLiteral(_, _) -> measure.copy()
    }
}

// The first name in fixed length `measure` that names a type of module
// `module_identity`: a size slot takes a compile-time integer, never a type.
sema_type_measure_type_name: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, measure: Measure) -> String? Never! {
    if measure == {
        .Symbol(_, name) -> {
            found: sema_type_graph_lookup_symbol(graph, module_identity, name) ?? return None
            if sema_resolved_kind(graph, found) == SymbolKind.Type -> Val(name.copy()) else -> None
        }
        .Combined(_, _, left, right) -> {
            found: sema_type_measure_type_name(graph, module_identity, left)
            if found != None -> return found
            sema_type_measure_type_name(graph, module_identity, right)
        }
        .Literal(_, _) | .SignedLiteral(_, _) -> None
    }
}

// The integer of constant `name` of module row `caller`: its staged value,
// or its declared expression folded (an integer literal, `#run { … }`
// holding one, other such constants, `+ - * /`). Chains stop at 32 links.
sema_type_measure_constant: fn(graph: SemaRegistrationGraph, caller: Int, name: String, depth: Int) -> Int? Never! {
    if caller < 0 || depth > 32 -> return None
    loop constant_index in 0..<graph.modules[caller].constants.len() {
        if graph.modules[caller].constants[constant_index].symbol.name != name -> next
        if graph.modules[caller].constants[constant_index].declaration.mutable -> return None
        if graph.modules[caller].constants[constant_index].declaration.ct == .Val(.Int(value)) {
            return Val(value)
        }
        return sema_type_measure_fold(graph, caller, graph.modules[caller].constants[constant_index].declaration.value, depth + 1)
    }
    None
}

sema_type_measure_fold: fn(graph: SemaRegistrationGraph, caller: Int, expression: Expr, depth: Int) -> Int? Never! {
    if expression == {
        .Int(value, _, _, _, _) -> Val(value)
        .Paren(inner, _, _) -> sema_type_measure_fold(graph, caller, inner, depth)
        .Ident(name, _, _) -> sema_type_measure_constant(graph, caller, name, depth)
        .Unary(op, operand, _, _) -> {
            if op != UnOp.Neg -> return None
            value: sema_type_measure_fold(graph, caller, operand, depth) ?? return None
            Val(0 - value)
        }
        .Binary(op, left, right, _, _) -> {
            l: sema_type_measure_fold(graph, caller, left, depth) ?? return None
            r: sema_type_measure_fold(graph, caller, right, depth) ?? return None
            if op == {
                .Add -> Val(l + r)
                .Sub -> Val(l - r)
                .Mul -> Val(l * r)
                .Div | .FloorDiv -> if r <= 0 || l < 0 -> None else -> Val(l /% r)
                .Mod | .Rem | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Gt | .Le | .Ge | .Compare | .And | .Or -> None
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_type_resolve_declared_with_generics: fn(graph: SemaRegistrationGraph, ty: Type, caller_module_identity: ModuleID, generic_params: [TGenericParam]) -> Type Never! {
    sema_type_resolve_declared_recursive(graph, ty, sema_type_module_row(graph, caller_module_identity), generic_params)
}

sema_type_resolve_declared: fn(graph: SemaRegistrationGraph, ty: Type, caller_module_identity: ModuleID) -> Type Never! {
    sema_type_resolve_declared_recursive(graph, ty, sema_type_module_row(graph, caller_module_identity), [TGenericParam]{})
}

// Whether `name` is `<alias>.Ptr` for an import of core.mem in the caller
// module of row `caller`: `mem.Ptr<T>` names the raw pointer `*T`, whether
// the import is `use mem: core.mem` or `use core.mem`.
sema_type_core_pointer_name: fn(graph: SemaRegistrationGraph, name: String, caller: Int) -> Bool Never! {
    if caller < 0 -> return false
    qualified: name.split_once(".") ?? return false
    if qualified.after != "Ptr" -> return false
    loop import in graph.modules[caller].imports {
        if sema_registration_file_import_taken_over(graph.modules[caller], import) -> next
        // `use core.mem` binds the submodule by its last segment, `mem`, to
        // its interned identity, which may have no module row of its own.
        loop binding in import.bindings {
            if binding.local == qualified.before && binding.symbol.kind == SymbolKind.Import && module_text(graph.module_table, binding.target_module_identity) == "core.mem" {
                return true
            }
        }
        if import.declaration.alias == qualified.before {
            target: sema_registration_module_index(graph, import.target_module_identity) ?? return false
            return graph.modules[target].module_name == "core.mem"
        }
    }
    false
}

// A nominal's declared member type (a field, payload, or underlying type)
// resolved in the nominal's own module, where it is spelled: the module that
// classifies a value of the nominal need not import its members' types. The
// nominal's generic parameters stay open for the caller's bindings.
sema_type_resolve_member_type: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, ty: Type) -> Type Never! {
    owner_params: loop parameter in nominal.generic_params -> TGenericParam{name: parameter.name, bounds: [SymbolID]{}}
    sema_type_resolve_declared_with_generics(graph, ty, nominal.symbol.module_identity, owner_params)
}

// The registration row of module `identity`, or -1 when the graph holds no
// such module: the caller key of named-type resolution (`caller` params).
sema_type_module_row: fn(graph: SemaRegistrationGraph, identity: ModuleID) -> Int {
    sema_registration_module_index(graph, identity) ?? -1
}

sema_type_graph_lookup_symbol: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, name: String) -> SemaRegistrationResolvedSymbol? {
    sema_type_graph_lookup_symbol_at(graph, sema_type_module_row(graph, module_identity), name)
}

// sema_type_graph_lookup_symbol from the caller module's row `caller`. An
// unregistered caller (-1) has no local names, imports or visible owners.
sema_type_graph_lookup_symbol_at: fn(graph: SemaRegistrationGraph, caller: Int, name: String) -> SemaRegistrationResolvedSymbol? {
    hash: name_text_hash(name)
    has_dot: name.contains(".")
    if has_dot && (caller < 0 || !graph.modules[caller].has_dotted_symbols) {
        if graph.canonical_nominals == .Val(canonical_table) {
            if sema_registration_canonical_nominal_row(canonical_table, name, hash) == .Val(row) {
                return canonical_table.resolved[row]
            }
        }
    }
    if caller >= 0 {
        // The identity is passed as a place: binding it copied the String.
        local: sema_registration_lookup_name_hashed(graph, caller, graph.modules[caller].module_identity, name, hash)
        if local != None -> return local
    }
    // A canonical nominal spelling's owner and whole name (SemaCanonicalNominals),
    // which the cut below also finds unless the name itself holds a `.`.
    if has_dot {
        if graph.canonical_nominals == .Val(canonical_table) {
            if sema_registration_canonical_nominal_row(canonical_table, name, hash) == .Val(row) {
                return canonical_table.resolved[row]
            }
        }
    }
    // The name is cut in place; no part list is built per lookup.
    // If `cut_last(".")` is None, `name` contains no `.`, so `split_once(".")`
    // would also be None and is skipped.
    if name.cut_last(".") == .Val(canonical) {
        if sema_registration_module_index_text(graph, canonical.before) == .Val(owner_index) {
            return sema_registration_lookup_name_at(graph, owner_index, graph.modules[owner_index].module_identity, canonical.after)
        }
        if caller < 0 -> return None
        if !canonical.before.contains(".") {
            return sema_registration_lookup_qualified(graph, graph.modules[caller].module_identity, canonical.before, canonical.after)
        }
        if name.split_once(".") == .Val(qualified) {
            return sema_registration_lookup_qualified(graph, graph.modules[caller].module_identity, qualified.before, qualified.after)
        }
    }
    // Only the established bare-owner trigger set may supply a global alias
    // or trait. Local declarations and explicit imports have already won above.
    bare_owner: core_bare_source_module(name)
    core_trait := SemaRegistrationResolvedSymbol?{None}
    if bare_owner == .Val(owner_name) {
        // A prelude rename (`LocalDate as Date`) names the declared type.
        if core_bare_source_declared(name) == .Val(declared) {
            return sema_type_graph_bare_rename(graph, declared, owner_name)
        }
        loop row in sema_registration_nominal_rows_named(graph, name) {
            // The module and nominal are passed as places: binding the module
            // copied it whole per row.
            found: sema_type_graph_bare_owned(graph.modules[row.module_index], graph.modules[row.module_index].nominals[row.row], row, owner_name)
            if found == None -> next
            if graph.modules[row.module_index].nominals[row.row].kind != SemaRegistrationNominalKind.Trait {
                return found
            }
            core_trait = found
        }
    }
    // A type the caller sees under the same name from another package (a
    // package's own `Diagnostic` struct) wins over the bare Core trait.
    owned: sema_type_graph_unique_type_owner(graph, caller, name)
    if owned != None -> return owned
    core_trait
}

// The established bare-owner declaration `nominal` (graph row `row`) of
// `module_row`, when it is one: a parameterless alias, or a trait (`Marker`,
// `Diagnostic`), which the unique-owner scan leaves to Core's root traits.
sema_type_graph_bare_owned: fn(module_row: SemaRegistrationModule, nominal: SemaRegistrationNominal, row: SemaRegistrationRowRef, owner_name: String) -> SemaRegistrationResolvedSymbol? Never! {
    if module_row.module_name != owner_name || !module_is_core(module_row.module_identity) || nominal.symbol.visibility < 2 {
        return None
    }
    if nominal.kind != SemaRegistrationNominalKind.Trait && (nominal.kind != SemaRegistrationNominalKind.TypeAlias || nominal.generic_params.len() != 0) {
        return None
    }
    Val(SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Nominal{module_index: row.module_index, row: row.row}, source_module_identity: module_row.module_identity, target_module_identity: module_row.module_identity, visibility: nominal.symbol.visibility, nominal_row: Val(row)})
}

// The Core declaration `declared` of `owner_name` that a prelude rename spells
// bare.
sema_type_graph_bare_rename: fn(graph: SemaRegistrationGraph, declared: String, owner_name: String) -> SemaRegistrationResolvedSymbol? Never! {
    loop row in sema_registration_nominal_rows_named(graph, declared) {
        if graph.modules[row.module_index].module_name != owner_name || !module_is_core(graph.modules[row.module_index].module_identity) {
            next
        }
        identity: graph.modules[row.module_index].module_identity
        return Val(SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Nominal{module_index: row.module_index, row: row.row}, source_module_identity: identity, target_module_identity: identity, visibility: graph.modules[row.module_index].nominals[row.row].symbol.visibility, nominal_row: Val(row)})
    }
    None
}

// A bare type name the caller neither declares nor imports names the one type
// declaration of that name, among the loaded modules, that the caller can
// see. Two owners leave it unresolved, unless exactly one of them is in a
// module the caller's package reaches through its imports
// (sema_registration_reaches): a package then names the same type under every
// importer as when it is checked on its own. A built-in typed head names its
// Core carrier record (`URL` in `core.net.url`, `HTML` in `core.text.html`, …;
// boundary_head_carrier_module) when that module is loaded, and no other
// owner; a parameterless Core alias outside the bare-owner and root-type sets
// is skipped; an alias that re-exports a namespaced type of the same leaf
// names that type's owner. Core source never imports user code, so a Core
// caller sees only Core owners. A builtin type no module declares
// (SYMBOL_BUILTIN_TYPES: `Task`, `Event`, …) has no owner here, so a loaded
// same-named type (a user module's `Task`, `core.compiler.Event`) never
// captures its bare spelling: only a caller that declares or imports that
// name means its own type.
sema_type_graph_unique_type_owner: fn(graph: SemaRegistrationGraph, caller_index: Int, name: String) -> SemaRegistrationResolvedSymbol? {
    if symbol_builtin(SymbolKind.Type, name) != None -> return None
    rows: sema_registration_nominal_rows_named(graph, name)
    if rows.len() == 0 -> return None
    if boundary_head_owner_module(name) != None {
        carrier: boundary_head_carrier_module(name) ?? return None
        loop row in rows {
            carrier_row: graph.modules[row.module_index]
            if carrier_row.module_name != carrier || !module_is_core(carrier_row.module_identity) {
                next
            }
            symbol: carrier_row.nominals[row.row].symbol
            if symbol.name != name -> next
            return Val(SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Nominal{module_index: row.module_index, row: row.row}, source_module_identity: carrier_row.module_identity, target_module_identity: carrier_row.module_identity, visibility: symbol.visibility, nominal_row: Val(row)})
        }
        return None
    }
    if caller_index < 0 -> return None
    scan := sema_type_graph_scan_type_owners(graph, caller_index, name, rows, SemaOwnerCount.Every)
    if scan.ambiguous {
        scan = sema_type_graph_scan_type_owners(graph, caller_index, name, rows, SemaOwnerCount.Reached)
    }
    if scan.ambiguous -> return None
    chosen: scan.found ?? return None
    owner_row: graph.modules[chosen.module_index]
    Val(SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Nominal{module_index: chosen.module_index, row: chosen.row}, source_module_identity: owner_row.module_identity, target_module_identity: owner_row.module_identity, visibility: owner_row.nominals[chosen.row].symbol.visibility, nominal_row: Val(chosen)})
}

// The one owner of a bare type name among its nominal rows, or that two
// modules own one.
SemaTypeOwnerScan: struct {
    found: SemaRegistrationRowRef?,
    ambiguous: Bool,
}

// Which owners a bare type name's scan counts: every one the caller can see,
// or only those in modules the caller's package reaches
// (sema_registration_reaches).
SemaOwnerCount: enum {
    Every,
    Reached,
}

// sema_type_graph_unique_type_owner's scan of `rows`, counting `count`'s owners.
sema_type_graph_scan_type_owners: fn(graph: SemaRegistrationGraph, caller_index: Int, name: String, rows: [SemaRegistrationRowRef], count: SemaOwnerCount) -> SemaTypeOwnerScan {
    caller_is_core: module_is_core(graph.modules[caller_index].module_identity)
    found := SemaRegistrationRowRef?{None}
    loop row in rows {
        owner := row
        alias_row: graph.modules[row.module_index]
        alias: alias_row.nominals[row.row]
        if alias.kind == SemaRegistrationNominalKind.TypeAlias && alias.generic_params.len() == 0 {
            if module_is_core(alias_row.module_identity) && core_bare_source_module(name) == None && !core_root_type(name) {
                next
            }
            item: sema_registration_nominal_source_item(alias.source) ?? next
            if item == .TypeAlias(definition) {
                if definition.target == .Named(target_name) {
                    if (target_name.contains(".") || target_name.contains(".")) && sema_type_graph_leaf(target_name) == name {
                        home: sema_type_graph_lookup_symbol(graph, alias_row.module_identity, target_name)
                        if home == .Val(resolved) {
                            if sema_type_graph_resolved_nominal_row(graph, resolved) == .Val(home_row) {
                                owner = home_row
                            }
                        }
                    }
                }
            }
        }
        owner_row: graph.modules[owner.module_index]
        if caller_is_core && !module_is_core(owner_row.module_identity) -> next
        nominal: owner_row.nominals[owner.row]
        if nominal.symbol.name != name -> next
        // A bare unapplied `Group` is the task group (sema_type_graph_resolve_named),
        // so only a generic `Group<K, V>` (core.data's) can own the bare applied
        // spelling; core.sys's and core.ui.xkb's records never compete for it.
        if name == "Group" && nominal.generic_params.len() == 0 -> next
        if nominal.kind != SemaRegistrationNominalKind.Struct && nominal.kind != SemaRegistrationNominalKind.Enum && nominal.kind != SemaRegistrationNominalKind.Distinct && nominal.kind != SemaRegistrationNominalKind.TypeAlias && (nominal.kind != SemaRegistrationNominalKind.Trait || (module_is_core(owner_row.module_identity) && !core_root_type(name))) {
            // A trait in type position (`CompilerTraceSink?`) is a type too: a signature from
            // another package spells it bare where the caller holds its owner-qualified name.
            // A Core root trait (the TypedDecodeSource filler, the source a generated
            // decode reads) is seen bare wherever Core is loaded, as a Core root value type is.
            next
        }
        if !sema_registration_visible(nominal.symbol.visibility, graph.modules[caller_index].module_identity, graph.modules[caller_index].package_identity, owner_row.module_identity, owner_row.package_identity) {
            next
        }
        if count == SemaOwnerCount.Reached && !sema_registration_reaches(graph, caller_index, owner.module_index) {
            next
        }
        if found == .Val(previous) {
            if previous.module_index != owner.module_index {
                return SemaTypeOwnerScan{found: None, ambiguous: true}
            }
        }
        found = Val(owner)
    }
    SemaTypeOwnerScan{found: found, ambiguous: false}
}

// A qualified type name's leaf: after the last `.`.
sema_type_graph_leaf: fn(name: String) -> String Never! {
    if name.cut_last(".") == {
        .Val(parts) -> parts.after
        .None -> name
    }
}

sema_type_graph_base_name: fn(ty: Type) -> String? {
    if ty == {
        .Named(name) -> Val(name)
        .Apply(name, _) -> Val(name)
        .Tagged(_, inner) -> sema_type_graph_base_name(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// Whether the checked type `ty` is the builtin type `name`, one of
// SYMBOL_BUILTIN_TYPES (symbol_builtin), which no module declares.
// The spelling is its owner: sema spells every resolved source nominal
// `module.Leaf` (sema_registration_nominal_spelling), so a program's own
// `Task` or `Task<T>`, local, aliased or imported, is never spelled bare, and
// a bare `Task` is the handle. This never looks `name` up in a caller's
// scope, where a program type of that name would answer.
sema_type_is_builtin_handle: fn(ty: Type, name: String) -> Bool Never! {
    if ty == {
        .Named(actual) | .Apply(actual, _) -> actual == name && symbol_builtin(SymbolKind.Type, name) != None
        .Tagged(_, inner) -> sema_type_is_builtin_handle(inner, name)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// The registered nominal row `actual` names from `caller_module_identity`.
sema_type_resolve_nominal_row: fn(graph: SemaRegistrationGraph, actual: Type, caller_module_identity: ModuleID) -> SemaRegistrationRowRef? {
    sema_type_resolve_nominal_row_at(graph, actual, sema_type_module_row(graph, caller_module_identity))
}

// sema_type_resolve_nominal_row from the caller module's row `caller`.
sema_type_resolve_nominal_row_at: fn(graph: SemaRegistrationGraph, actual: Type, caller: Int) -> SemaRegistrationRowRef? {
    name: sema_type_graph_base_name(actual) ?? return None
    sema_type_lookup_nominal_row(graph, sema_type_graph_lookup_symbol_at(graph, caller, name), name, caller)
}

// The registered nominal row of `name`, given its lookup from the caller
// module's row `caller`: a Type symbol's row; with no binding, the one
// source nominal of that name (sema_type_unscoped_nominal_row).
sema_type_lookup_nominal_row: fn(graph: SemaRegistrationGraph, resolved: SemaRegistrationResolvedSymbol?, name: String, caller: Int) -> SemaRegistrationRowRef? {
    if resolved == .Val(found) {
        if sema_resolved_kind(graph, found) != SymbolKind.Type -> return None
        return sema_type_graph_resolved_nominal_row(graph, found)
    }
    if caller >= 0 && module_is_core(graph.modules[caller].module_identity) -> return None
    sema_type_unscoped_nominal_row(graph, name, caller)
}

// A value's type can reach a module that never names it: a call into a dependency
// package returns one of its types (`span: parser_cover(..)` gives a `Span` that
// jet_parser never imports). With no binding of the name in the caller's scope, the type
// is the one source nominal of that name in the graph, or, when several share it, the
// one in a module the caller's package reaches; otherwise it is unknown. A bare
// builtin type name is that builtin (sema_type_graph_unique_type_owner).
sema_type_unscoped_nominal_row: fn(graph: SemaRegistrationGraph, name: String, caller: Int) -> SemaRegistrationRowRef? {
    if symbol_builtin(SymbolKind.Type, name) != None -> return None
    scan := sema_type_scan_unscoped_rows(graph, name, caller, SemaOwnerCount.Every)
    if scan.ambiguous {
        scan = sema_type_scan_unscoped_rows(graph, name, caller, SemaOwnerCount.Reached)
    }
    if scan.ambiguous -> return None
    scan.found
}

// sema_type_unscoped_nominal_row's scan, counting `count`'s rows.
sema_type_scan_unscoped_rows: fn(graph: SemaRegistrationGraph, name: String, caller: Int, count: SemaOwnerCount) -> SemaTypeOwnerScan {
    found := SemaRegistrationRowRef?{None}
    loop row in sema_registration_nominal_rows_named(graph, name) {
        if module_is_core(graph.modules[row.module_index].module_identity) -> next
        if count == SemaOwnerCount.Reached && !sema_registration_reaches(graph, caller, row.module_index) {
            next
        }
        if found == .Val(previous) {
            if previous.module_index != row.module_index || previous.row != row.row {
                return SemaTypeOwnerScan{found: None, ambiguous: true}
            }
        }
        found = Val(row)
    }
    SemaTypeOwnerScan{found: found, ambiguous: false}
}

// The ledger alone is not declaration authority: require the registered row.
sema_type_source_owns_nominal: fn(graph: SemaRegistrationGraph, name: String, caller: Int) -> Bool Never! {
    row: sema_type_resolve_nominal_row_at(graph, Type.Named{name: name}, caller) ?? return false
    nominal: graph.modules[row.module_index].nominals[row.row]
    core_source_owns_type("{module_text(graph.module_table, nominal.symbol.module_identity)}.{nominal.symbol.name}")
}

sema_type_graph_trait_symbol: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, bound_name: String) -> Symbol? {
    sema_type_graph_trait_symbol_at(graph, sema_type_module_row(graph, module_identity), bound_name)
}

sema_type_graph_trait_symbol_at: fn(graph: SemaRegistrationGraph, caller: Int, bound_name: String) -> Symbol? {
    resolved: sema_type_graph_lookup_symbol_at(graph, caller, bound_name) ?? return None
    if sema_resolved_kind(graph, resolved) != SymbolKind.Trait -> return None
    Val(sema_resolved_symbol(graph, resolved))
}

// Whether a trait value carrying the traits `carried` meets the bound
// `bound_name`, both named as seen from `caller`: the trait identities are
// compared, never their spellings, so a resolved value's canonical
// `app.Describe` meets the bound written `Describe`. A compiler-owned trait
// no source declares is its builtin identity. An unresolved bound is unmet.
sema_type_trait_value_meets: fn(graph: SemaRegistrationGraph, carried: [String], bound_name: String, caller: Int) -> Bool Never! {
    wanted: sema_type_trait_identity(graph, caller, bound_name) ?? return false
    loop name in carried {
        own: sema_type_trait_identity(graph, caller, name) ?? next
        if own == wanted -> return true
    }
    false
}

sema_type_trait_identity: fn(graph: SemaRegistrationGraph, caller: Int, name: String) -> SymbolID? {
    if sema_type_graph_trait_symbol_at(graph, caller, name) == .Val(declared) -> return Val(declared.id)
    builtin: sema_type_builtin_trait_symbol(name) ?? return None
    Val(builtin.id)
}

// A generic bound may name a compiler-owned trait that no source module
// declares (`bare_bound` in OWNED_TRAITS). Its identity is the bare trait name
// with no owning module.
sema_type_builtin_trait_symbol: fn(name: String) -> Symbol? {
    owned: owned_trait(name) ?? return None
    if !owned.bare_bound -> return None
    Val(Symbol{id: symbol_builtin(SymbolKind.Trait, name) ?? return None, kind: SymbolKind.Trait, name: name, module_identity: module_none(), owner: None, span: Span{start: 0, end: 0}, ty: None, visibility: 2})
}

// A generic bound's trait: the visible declaration of that name, else the
// builtin trait. A visible declaration that is not a trait does not hide a
// builtin one: core.term's cursor struct is named `Reader`, and `<R: Reader>`
// there still bounds on the Prelude trait.
sema_type_graph_bound_symbol: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, name: String) -> SemaRegistrationResolvedSymbol? {
    resolved: sema_type_graph_lookup_symbol(graph, module_identity, name)
    builtin: sema_type_builtin_trait_symbol(name)
    if resolved == .Val(found) {
        if builtin == None || sema_resolved_kind(graph, found) == SymbolKind.Trait {
            return Val(found)
        }
    }
    symbol: builtin ?? return None
    Val(SemaRegistrationResolvedSymbol{place: SemaRegistrationSymbolPlace.Detached{symbol: symbol}, source_module_identity: module_none(), target_module_identity: module_none(), visibility: 2})
}

sema_type_graph_is_checked_text_impl: fn(graph: SemaRegistrationGraph, implementation: SemaRegistrationImpl) -> Bool Never! {
    resolved := implementation.trait_symbol
    if resolved == None {
        name: implementation.trait_name ?? return false
        resolved = sema_type_graph_trait_symbol(graph, implementation.source_module_identity, name)
        // No visible declaration shadows the name: the impl names the
        // compiler-owned trait every module sees.
        if resolved == None -> return name == "CheckedText"
    }
    trait_symbol: resolved ?? return false
    if trait_symbol.kind != SymbolKind.Trait || trait_symbol.name != "CheckedText" -> return false
    owner: sema_registration_module_index(graph, trait_symbol.module_identity) ?? panic("checked trait identity has no registered owner module")
    graph.modules[owner].module_name == "core.prelude"
}

// The declared text-sink fact of a type named `name` (a leaf name): None
// when it declares no `CheckedText` impl, as an `impl Owner.CheckedText`
// block or one in its own body; otherwise whether it has an audited `raw`
// escape too, its own `raw` method or the `Type.raw` of a string-backed
// distinct type. Only its checked literal or that escape fills the sink.
// Matched by name, as it only words a rejection.
sema_type_graph_checked_text_raw: fn(graph: SemaRegistrationGraph, name: String) -> Bool? Never! {
    checked := false
    raw := false
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].impls.len() {
            if graph.modules[module_index].impls[row].target_type_name == name && sema_type_graph_is_checked_text_impl(graph, graph.modules[module_index].impls[row]) {
                checked = true
            }
        }
        loop row in 0..<graph.modules[module_index].nominals.len() {
            if graph.modules[module_index].nominals[row].symbol.name != name -> next
            if graph.modules[module_index].nominals[row].kind == SemaRegistrationNominalKind.Distinct {
                raw = true
            }
            loop method_index in 0..<graph.modules[module_index].nominals[row].methods.len() {
                if graph.modules[module_index].nominals[row].methods[method_index].symbol.name == "raw" {
                    raw = true
                }
            }
            if graph.modules[module_index].nominals[row].source == .SourceAST(item) {
                if sema_registration_item_has_trait_block(item, "CheckedText") -> checked = true
            }
        }
    }
    if checked -> Val(raw) else -> None
}

sema_type_graph_impl_matches_nominal: fn(graph: SemaRegistrationGraph, implementation: SemaRegistrationImpl, nominal: SemaRegistrationNominal) -> Bool? {
    if implementation.target_identity_key == nominal.identity_key -> return Val(true)
    if !module_is_none(implementation.target_module_identity) {
        if implementation.target_module_identity == nominal.symbol.module_identity && implementation.target_type_name == nominal.symbol.name {
            return Val(true)
        }
    }
    if !graph.impl_traits_indexed {
        target: sema_type_graph_impl_target_nominal(graph, implementation) ?? return None
        return Val(target == nominal.symbol.id)
    }
    if implementation.target_nominal == .Val(target) -> return Val(target == nominal.symbol.id)
    None
}

// The symbol id of the nominal an impl's target type names from the impl's
// module. The trait index stores it on each impl (`target_nominal`).
sema_type_graph_impl_target_nominal: fn(graph: SemaRegistrationGraph, implementation: SemaRegistrationImpl) -> SymbolID? {
    row: sema_type_resolve_nominal_row(graph, implementation.target_type, implementation.source_module_identity) ?? return None
    Val(graph.modules[row.module_index].nominals[row.row].symbol.id)
}

sema_type_graph_impl_matches_trait: fn(graph: SemaRegistrationGraph, implementation: SemaRegistrationImpl, trait_symbol: Symbol) -> Bool? {
    declared_trait: implementation.trait_symbol
    if declared_trait == .Val(declared) -> return Val(declared.id == trait_symbol.id)
    name: implementation.trait_name ?? return Val(false)
    resolved: sema_type_graph_trait_symbol(graph, implementation.source_module_identity, name) ?? return None
    Val(resolved.id == trait_symbol.id)
}

// The trait symbol an impl implements: its registered trait symbol, or its
// trait name resolved in the impl's module. An inherent impl or an
// unresolved name has none and matches no bound
// (`sema_type_graph_impl_matches_trait` false or None).
sema_type_graph_impl_trait: fn(graph: SemaRegistrationGraph, implementation: SemaRegistrationImpl) -> SymbolID? {
    if implementation.trait_symbol == .Val(declared) -> return Val(declared.id.copy())
    name: implementation.trait_name ?? return None
    resolved: sema_type_graph_trait_symbol(graph, implementation.source_module_identity, name) ?? return None
    Val(resolved.id.copy())
}

// A trait block written inside a struct or enum body implements that trait
// exactly like an `impl` item. The block's trait name resolves in the owner's
// module.
sema_type_graph_inline_impl_matches_trait: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, trait_symbol: Symbol) -> Bool {
    if nominal.source == .SourceAST(item) {
        if item == {
            .Struct(definition) -> return sema_type_graph_trait_blocks_match(graph, nominal.symbol.module_identity, definition.trait_impls, trait_symbol)
            .Enum(definition) -> return sema_type_graph_trait_blocks_match(graph, nominal.symbol.module_identity, definition.trait_impls, trait_symbol)
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    false
}

sema_type_graph_trait_blocks_match: fn(graph: SemaRegistrationGraph, module_identity: ModuleID, blocks: [TraitImplBlock], trait_symbol: Symbol) -> Bool {
    loop block in blocks {
        resolved: sema_type_graph_trait_symbol(graph, module_identity, block.trait_name) ?? next
        if resolved.id == trait_symbol.id -> return true
    }
    false
}

sema_type_bound_satisfied_resolved: fn(graph: SemaRegistrationGraph, actual_resolved: Type, bound_name: String, caller: Int, generic_params: [TGenericParam]) -> Bool? {
    if actual_resolved == {
        .Named(name) -> {
            if sema_type_name_is_generic(generic_params, name) -> return None
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    // A trait value meets only the traits it carries: the type inside it is
    // not known where it is used, so no impl of another trait can be found
    // for it (a `Shown` value passed where `Back` is expected is refused).
    if actual_resolved == .TraitObject(carried) -> return Val(sema_type_trait_value_meets(graph, carried, bound_name, caller))
    nominal_row: sema_type_resolve_nominal_row_at(graph, actual_resolved, caller) ?? return sema_type_bound_satisfied_builtin_target(graph, actual_resolved, bound_name, caller)
    trait_symbol: sema_type_graph_trait_symbol_at(graph, caller, bound_name) ?? return None
    // The nominal row is passed in place: binding it copied the declaration.
    sema_type_bound_satisfied_nominal(graph, graph.modules[nominal_row.module_index].nominals[nominal_row.row], trait_symbol, bound_name, actual_resolved, generic_params)
}

// A built-in type (`Int`, `[Int]`) has no nominal row: it meets a trait
// outside the builtin family only through an impl written for it (`impl
// Int.Named`), so without one the bound is unmet, not unknown. An exact
// number literal's type (`Decimal`, `Fraction`) has no row where core.math
// is not imported and is judged the same way, and so is a function type,
// which no impl can name. A builtin family bound keeps its own rules, and
// any other type without a row stays unknown.
sema_type_bound_satisfied_builtin_target: fn(graph: SemaRegistrationGraph, actual_resolved: Type, bound_name: String, caller: Int) -> Bool? {
    builtin: if actual_resolved == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 | .List(_) | .Map(_, _, _) | .FixedList(_, _) | .Option(_) | .Tuple(_) | .Fn(_, _, _, _, _, _) -> true
        .Named(name) -> name == "Decimal" || name == "Fraction"
        .Shared(_) | .Result(_, _) | .Apply(_, _) | .TraitObject(_) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
    if !builtin || sema_type_builtin_trait_symbol(bound_name) != None -> return None
    trait_symbol: sema_type_graph_trait_symbol_at(graph, caller, bound_name) ?? return None
    target: type_name(actual_resolved)
    loop module_index in 0..<graph.modules.len() {
        loop impl_index in 0..<graph.modules[module_index].impls.len() {
            if graph.modules[module_index].impls[impl_index].target_type_name != target && sema_type_structural_head_bindings(graph.modules[module_index].impls[impl_index].target_type, actual_resolved) == None {
                next
            }
            trait_matches: sema_type_graph_impl_matches_trait(graph, graph.modules[module_index].impls[impl_index], trait_symbol) ?? next
            if trait_matches -> return Val(true)
        }
    }
    if !graph.complete -> return None
    Val(false)
}

// The bindings structural impl head `head` (`impl [T].Trait`, `impl
// [T#N].Trait`, `impl T?.Trait`, `impl [K: V].Trait`) takes at `actual`: each
// head parameter to `actual`'s argument in that position, a fixed array's
// length as a number. None when `head` is no structural head or `actual` is
// not of its shape.
sema_type_structural_head_bindings: fn(head: Type, actual: Type) -> [SemaInferenceBinding]? Never! {
    names: type_structural_head_names(head) ?? return None
    if type_structural_family(head) != type_structural_family(actual) -> return None
    args: type_structural_args(actual) ?? return None
    if args.len() != names.len() -> return None
    Val(loop index in 0..<names.len() -> SemaInferenceBinding{name: names[index], ty: args[index], source: "structural impl head"})
}

// Impl rows are read by index through the read graph: element loops over
// `graph.modules` copied every module, impls included, on each bound check.
// `actual` is the type the bound is met at, for a conditional impl's bounds.
sema_type_bound_satisfied_nominal: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, trait_symbol: Symbol, bound_name: String, actual: Type, generic_params: [TGenericParam]) -> Bool? {
    if bound_name == "Close" && sema_type_provider_close_owner(graph, nominal) -> return Val(true)
    unresolved_impl := false
    if graph.impl_traits_indexed {
        // Only the impls of this trait, from the registration index.
        slot: graph.impl_trait_slots.get(trait_symbol.id.id)
        if slot == .Val(found) {
            loop impl_row in graph.impl_trait_buckets[found] {
                target_matches: sema_type_graph_impl_matches_nominal(graph, graph.modules[impl_row.module_index].impls[impl_row.row], nominal) ?? {
                    unresolved_impl = true
                    next
                }
                if !target_matches -> next
                conditions_met: sema_type_impl_conditions_met(graph, graph.modules[impl_row.module_index].impls[impl_row.row], actual, generic_params) ?? {
                    unresolved_impl = true
                    next
                }
                if conditions_met -> return Val(true)
            }
        }
    } else {
        loop module_index in 0..<graph.modules.len() {
            loop impl_index in 0..<graph.modules[module_index].impls.len() {
                trait_matches: sema_type_graph_impl_matches_trait(graph, graph.modules[module_index].impls[impl_index], trait_symbol) ?? next
                if !trait_matches -> next
                target_matches: sema_type_graph_impl_matches_nominal(graph, graph.modules[module_index].impls[impl_index], nominal) ?? {
                    unresolved_impl = true
                    next
                }
                if !target_matches -> next
                conditions_met: sema_type_impl_conditions_met(graph, graph.modules[module_index].impls[impl_index], actual, generic_params) ?? {
                    unresolved_impl = true
                    next
                }
                if conditions_met -> return Val(true)
            }
        }
    }
    if sema_type_graph_inline_impl_matches_trait(graph, nominal, trait_symbol) -> return Val(true)
    // No impl found is known once the nominal's and the trait's packages
    // registered in full (sema_registration_package_settled).
    if unresolved_impl || !sema_registration_package_settled(graph, nominal.symbol.module_identity) || !sema_registration_package_settled(graph, trait_symbol.module_identity) {
        return None
    }
    return Val(false)
}

// A conditional impl (`impl Pair<T: Priced>.Describe`) applies at `actual`
// only where its type arguments meet the impl's bounds, named as the impl's
// module names them; an argument that is a type parameter of the caller meets
// the bounds it declares. None while one is unknown.
sema_type_impl_conditions_met: fn(graph: SemaRegistrationGraph, implementation: SemaRegistrationImpl, actual: Type, generic_params: [TGenericParam]) -> Bool? {
    conditions: implementation.declaration.type_params
    if conditions.len() == 0 -> return Val(true)
    arguments: if actual == .Apply(_, written) -> written else -> {
        return None
    }
    if arguments.len() != conditions.len() -> return None
    impl_module: sema_type_module_row(graph, implementation.source_module_identity)
    loop index in 0..<conditions.len() {
        loop bound in conditions[index].bounds {
            met: sema_type_bound_satisfied_at(graph, arguments[index], bound, impl_module, generic_params) ?? return None
            if !met -> return Val(false)
        }
    }
    Val(true)
}

// The head of the conditional impl of `bound_name` for `actual`'s type, as
// written (`impl Pair<T: Priced>.Describe`), when one exists: an unmet
// bound then says that impl doesn't apply rather than asking for another
// impl, which would overlap it (E0908).
sema_type_conditional_impl_head: fn(graph: SemaRegistrationGraph, actual: Type, bound_name: String, caller_module: ModuleID) -> String? {
    caller: sema_type_module_row(graph, caller_module)
    if caller < 0 -> return None
    nominal_row: sema_type_resolve_nominal_row_at(graph, actual, caller) ?? return None
    trait_symbol: sema_type_graph_trait_symbol_at(graph, caller, bound_name) ?? return None
    loop module_index in 0..<graph.modules.len() {
        loop impl_index in 0..<graph.modules[module_index].impls.len() {
            if graph.modules[module_index].impls[impl_index].declaration.type_params.len() == 0 {
                next
            }
            trait_matches: sema_type_graph_impl_matches_trait(graph, graph.modules[module_index].impls[impl_index], trait_symbol) ?? next
            if !trait_matches -> next
            target_matches: sema_type_graph_impl_matches_nominal(graph, graph.modules[module_index].impls[impl_index], graph.modules[nominal_row.module_index].nominals[nominal_row.row]) ?? next
            if !target_matches -> next
            declaration: graph.modules[module_index].impls[impl_index].declaration
            written: loop param in declaration.type_params -> if param.bounds.len() == 1 -> "{param.name}: {param.bounds[0]}" else if param.bounds.len() > 1 -> "{param.name}: [{param.bounds.join(", ")}]" else -> "{param.name}"
            return Val("impl {declaration.type_name}<{written.join(", ")}>.{bound_name}")
        }
    }
    None
}

// A temporary directory or file is a shared runtime owner (its handle clones),
// so it declares no `Close`, which would make it move-only; consuming one
// still runs the runtime's Close protocol. Check the declaring identity, never
// the display path or an application's same-named struct. Every other Core
// owner that closes declares its `impl Close`.
sema_type_provider_close_owner: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal) -> Bool Never! {
    identity: module_text(graph.module_table, nominal.symbol.module_identity)
    if !core_identity_in_module(identity, "core.files") -> return false
    nominal.symbol.name == "TempDir" || nominal.symbol.name == "TempFile"
}

// Bound satisfaction for a bound that names an undeclared builtin trait
// (Generics.BUILTIN_TRAITS): scalars satisfy the builtin family, containers
// recurse, and a nominal needs an impl, trait block or derive of that trait
// name.
sema_type_builtin_bound_satisfied: fn(graph: SemaRegistrationGraph, actual_resolved: Type, bound_name: String, caller: Int, generic_params: [TGenericParam]) -> Bool? {
    scalar_family: bound_name != "Close" && bound_name != "CheckedText"
    arithmetic: owned_trait_arithmetic(bound_name)
    structural: owned_trait_structural(bound_name)
    if actual_resolved == {
        .Int | .Float -> return Val(scalar_family)
        .Bool | .String | .Char -> return Val(scalar_family && !arithmetic && bound_name != "Numeric")
        .IntN(_, _) | .InlineRange(_, _, _) | .Float32 -> return Val(scalar_family)
        .List(inner) | .Option(inner) | .FixedList(inner, _) -> {
            if structural {
                return sema_type_bound_satisfied_at(graph, inner, bound_name, caller, generic_params)
            }
        }
        .Map(key, _, value) -> {
            if bound_name == "Equatable" {
                key_ok: sema_type_bound_satisfied_at(graph, key, bound_name, caller, generic_params) ?? return None
                if !key_ok -> return Val(false)
                return sema_type_bound_satisfied_at(graph, value, bound_name, caller, generic_params)
            }
        }
        .Result(ok, err) -> {
            if structural {
                ok_ok: sema_type_bound_satisfied_at(graph, ok, bound_name, caller, generic_params) ?? return None
                if !ok_ok -> return Val(false)
                return sema_type_bound_satisfied_at(graph, err, bound_name, caller, generic_params)
            }
        }
        .Tuple(fields) -> {
            if structural {
                loop field in fields {
                    field_ok: sema_type_bound_satisfied_at(graph, field.ty, bound_name, caller, generic_params) ?? return None
                    if !field_ok -> return Val(false)
                }
                return Val(true)
            }
        }
        .TraitObject(bounds) -> return Val(sema_type_trait_value_meets(graph, bounds, bound_name, caller))
        // A function value has no nominal row to carry an impl, and no
        // compiler-owned bound trait is met by a function.
        .Fn(_, _, _, _, _, _) -> return Val(false)
        .Tagged(_, inner) -> return sema_type_bound_satisfied_at(graph, inner, bound_name, caller, generic_params)
        .Named(name) -> {
            if sema_type_name_is_generic(generic_params, name) -> return None
            if (name == "Decimal" || name == "Fraction") && owned_trait_implies("Numeric", bound_name) {
                return Val(true)
            }
            // `Duration` is the compiler-owned time carrier: its `==` and
            // ordering are built in, and it has no nominal row to carry an impl.
            if name == "Duration" && structural -> return Val(true)
        }
        .Shared(_) | .Apply(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    nominal_row: sema_type_resolve_nominal_row_at(graph, actual_resolved, caller) ?? return None
    // The nominal row is passed in place: binding it copied the declaration.
    sema_type_builtin_bound_satisfied_nominal(graph, graph.modules[nominal_row.module_index].nominals[nominal_row.row], bound_name)
}

sema_type_builtin_bound_satisfied_nominal: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, bound_name: String) -> Bool? {
    // A caller that sees no declared `Close` reaches the same provider owners.
    if bound_name == "Close" && sema_type_provider_close_owner(graph, nominal) -> return Val(true)
    // `Renderable` is anything interpolatable: a nominal that shows through
    // Display or Printable, or implements Renderable itself.
    if bound_name == "Renderable" {
        if sema_type_builtin_bound_satisfied_nominal(graph, nominal, "Display") == (Val(true)) {
            return Val(true)
        }
        if sema_type_builtin_bound_satisfied_nominal(graph, nominal, "Printable") == (Val(true)) {
            return Val(true)
        }
    }
    unresolved_impl := false
    // Only impls declaring `bound_name` can match: with the registration index
    // built they are read from that name's rows instead of every impl.
    if {
        graph.impl_traits_indexed -> {
            if sema_registration_impl_trait_name_slot(graph, bound_name) == .Val(found) {
                loop impl_row in graph.impl_trait_name_buckets[found] {
                    if sema_type_builtin_bound_impl_matches(graph, graph.modules[impl_row.module_index].impls[impl_row.row], nominal, bound_name, unresolved_impl) {
                        return Val(true)
                    }
                }
            }
        }
        else -> {
            loop module_index in 0..<graph.modules.len() {
                loop impl_index in 0..<graph.modules[module_index].impls.len() {
                    if sema_type_builtin_bound_impl_matches(graph, graph.modules[module_index].impls[impl_index], nominal, bound_name, unresolved_impl) {
                        return Val(true)
                    }
                }
            }
        }
    }
    if nominal.source == .SourceAST(item) {
        if item == {
            .Struct(definition) -> {
                if sema_type_blocks_or_derives_name(definition.trait_impls, definition.derives, bound_name) {
                    return Val(true)
                }
            }
            .Enum(definition) -> {
                if sema_type_blocks_or_derives_name(definition.trait_impls, definition.derives, bound_name) {
                    return Val(true)
                }
            }
            .Distinct(definition) -> {
                if sema_type_blocks_or_derives_name([TraitImplBlock]{}, definition.derives, bound_name) {
                    return Val(true)
                }
            }
            .Func(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
        // An eligible type with no authored `Debug` has the derived one,
        // unless a field it holds has none.
        if bound_name == "Debug" {
            if sema_registration_module_index(graph, nominal.symbol.module_identity) == .Val(module_index) {
                if sema_type_metadata_auto_derives(item, graph.modules[module_index].declared_trait_impls).debug && !sema_comparability_rendering_blocked(graph, nominal.symbol.module_identity, item, "Debug") {
                    return Val(true)
                }
            }
        }
    }
    if unresolved_impl || !sema_registration_package_settled(graph, nominal.symbol.module_identity) {
        return None
    }
    Val(false)
}

// Whether impl `implementation` declares `bound_name` for `nominal`; an impl
// declaring it whose target does not resolve sets `unresolved`.
sema_type_builtin_bound_impl_matches: fn(graph: SemaRegistrationGraph, implementation: SemaRegistrationImpl, nominal: SemaRegistrationNominal, bound_name: String, unresolved: ^Bool) -> Bool {
    if implementation.trait_name != (Val(bound_name)) -> return false
    target_matches: sema_type_graph_impl_matches_nominal(graph, implementation, nominal) ?? {
        unresolved = true
        return false
    }
    target_matches
}

// A trait block or derive named `bound_name`, read in place: collecting the
// blocks into locals copied every block with its methods. A derive also meets
// the traits it requires (`#Numeric` gives `Comparable`).
sema_type_blocks_or_derives_name: fn(blocks: [TraitImplBlock], derives: [NamedSpan], bound_name: String) -> Bool Never! {
    loop index in 0..<blocks.len() {
        if blocks[index].trait_name == bound_name -> return true
    }
    loop index in 0..<derives.len() {
        if owned_trait_implies(derives[index].name, bound_name) -> return true
    }
    false
}

sema_type_bound_satisfied_with_generics: fn(graph: SemaRegistrationGraph, actual: Type, bound_name: String, caller_module_identity: ModuleID, generic_params: [TGenericParam]) -> Bool? {
    sema_type_bound_satisfied_at(graph, actual, bound_name, sema_type_module_row(graph, caller_module_identity), generic_params)
}

// sema_type_bound_satisfied_with_generics from the caller module's row `caller`.
sema_type_bound_satisfied_at: fn(graph: SemaRegistrationGraph, actual: Type, bound_name: String, caller: Int, generic_params: [TGenericParam]) -> Bool? {
    // Snapshot: a bound names a registered trait, and a lone program
    // registers none; whether it holds is unknown.
    if graph.mode == .Snapshot -> return None
    actual_resolved: sema_type_resolve_declared_recursive(graph, actual, caller, generic_params)
    // Demand: a checked codec bound requires the codecs of the
    // types it is met at, so their generated bodies are checked; a
    // structural bound, their demand-checked derived methods.
    if owned_trait_codec(bound_name) -> sema_codec_demand_type(graph, bound_name, actual_resolved)
    if owned_trait_structural(bound_name) -> sema_derive_demand_type(graph, actual_resolved)
    structural: sema_type_codec_structural_bound(graph, actual_resolved, bound_name, caller, generic_params)
    if structural != None -> return structural
    // A compiler-owned type (`Bytes`) has no row to carry an impl, so one
    // without a built-in codec has none at all.
    if owned_trait_codec(bound_name) && actual_resolved == .Named(name) && sema_reserved_type_name(name) && !sema_serde_builtin_codec_name(name) && sema_type_resolve_nominal_row_at(graph, actual_resolved, caller) == None {
        return Val(false)
    }
    generic_satisfied := sema_type_generic_bound_satisfied(graph, actual_resolved, bound_name, caller, generic_params)
    if generic_satisfied != None -> return generic_satisfied
    if bound_name.starts_with("Quantity<") {
        return Val(sema_registration_quantity_bound_satisfied(graph, actual_resolved, bound_name))
    }
    // An exact number (a `3.5` literal is a Decimal) interpolates through its
    // Core Display, so it meets Display and every trait Display requires even
    // where core.math is not imported and no row resolves.
    if owned_trait_implies("Display", bound_name) && actual_resolved == .Named(name) && (name == "Decimal" || name == "Fraction") && sema_type_resolve_nominal_row_at(graph, actual_resolved, caller) == None {
        return Val(true)
    }
    // A pool `ID<T>` is a compiler-owned slot and generation whose built-in
    // `==` compares only those two numbers and never touches `T`, so it meets
    // `Equatable` whatever `T` is. It has no nominal row to carry an impl; a
    // declared `ID` has one.
    if bound_name == "Equatable" && actual_resolved == .Apply(name, _) && sema_serde_named_leaf(name) == "ID" && sema_type_resolve_nominal_row_at(graph, actual_resolved, caller) == None {
        return Val(true)
    }
    // Interpolation prints a list or optional through its elements and a
    // nominal through its Display, so both are Printable the same way.
    if bound_name == "Printable" {
        if actual_resolved == {
            .List(inner) | .Option(inner) | .FixedList(inner, _) -> return sema_type_bound_satisfied_at(graph, inner, bound_name, caller, generic_params)
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
        }
        if sema_type_resolve_nominal_row_at(graph, actual_resolved, caller) != None && sema_type_bound_satisfied_at(graph, actual_resolved, "Display", caller, generic_params) == (Val(true)) {
            return Val(true)
        }
    }
    // A scalar satisfies the builtin trait family by name even where Core
    // declares the trait (`Encode`); a scalar has no nominal row to carry an
    // impl.
    scalar: if actual_resolved == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 -> true
        .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
    if sema_type_builtin_trait_symbol(bound_name) != None && (scalar || sema_type_graph_trait_symbol_at(graph, caller, bound_name) == None) {
        return sema_type_builtin_bound_satisfied(graph, actual_resolved, bound_name, caller, generic_params)
    }
    sema_type_bound_satisfied_resolved(graph, actual_resolved, bound_name, caller, generic_params)
}

// A list, fixed array, or optional value is codable exactly when its element
// is, a map when its key and value are, and an anonymous union when every
// member is (it codes through its structural enum); the dynamic `Dyn` is the
// codec tree itself.
sema_type_codec_structural_bound: fn(graph: SemaRegistrationGraph, actual_resolved: Type, bound_name: String, caller: Int, generic_params: [TGenericParam]) -> Bool? {
    if !owned_trait_through_elements(bound_name) -> return None
    if actual_resolved == {
        .List(inner) | .Option(inner) | .FixedList(inner, _) -> return sema_type_bound_satisfied_at(graph, inner, bound_name, caller, generic_params)
        .Map(key, _, value) -> {
            // A map's keys are text on the wire, so only a map keyed by
            // `String` has a codec, as the codec calls check it.
            if owned_trait_codec(bound_name) && key != Type.String -> return Val(false)
            key_satisfied: sema_type_bound_satisfied_at(graph, key, bound_name, caller, generic_params) ?? return None
            if !key_satisfied -> return Val(false)
            return sema_type_bound_satisfied_at(graph, value, bound_name, caller, generic_params)
        }
        .Union(members) -> {
            loop member in members {
                member_satisfied: sema_type_bound_satisfied_at(graph, member, bound_name, caller, generic_params) ?? return None
                if !member_satisfied -> return Val(false)
            }
            return Val(true)
        }
        .Named(name) -> {
            if name == "Dyn" || name == "DateTime" || name == "ZonedDateTime" || name == "JSON" || name == "TOML" || name == "YAML" || name == "CSV" {
                return Val(true)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    None
}

sema_type_bound_satisfied: fn(graph: SemaRegistrationGraph, actual: Type, bound_name: String, caller_module_identity: ModuleID) -> Bool? {
    sema_type_bound_satisfied_with_generics(graph, actual, bound_name, caller_module_identity, [TGenericParam]{})
}

sema_type_generic_bound_satisfied: fn(graph: SemaRegistrationGraph, actual_resolved: Type, bound_name: String, caller: Int, generic_params: [TGenericParam]) -> Bool? {
    actual_name: if actual_resolved == {
        .Named(name) -> Val(name)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
    name: actual_name ?? return None
    parameter := TGenericParam?{None}
    index := generic_params.len()
    loop index > 0 {
        index -= 1
        candidate: generic_params[index]
        if candidate.name == name {
            parameter = Val(candidate)
            break
        }
    }
    current: parameter ?? return None
    trait_symbol: sema_type_graph_trait_symbol_at(graph, caller, bound_name) ?? sema_type_builtin_trait_symbol(bound_name) ?? return None
    loop bound in current.bounds {
        if bound == trait_symbol.id -> return Val(true)
    }
    // A bound on a trait that requires `bound_name` admits it: `T: Numeric`
    // has `+`, `-`, `*` and ordering.
    loop requirer in owned_trait_requirers(bound_name) {
        requirer_symbol: sema_type_graph_trait_symbol_at(graph, caller, requirer) ?? sema_type_builtin_trait_symbol(requirer) ?? next
        loop bound in current.bounds {
            if bound == requirer_symbol.id -> return Val(true)
        }
    }
    return Val(false)
}

// Whether `required` and `offered` are structurally identical non-callable
// written types: both resolve to the exact same type in the same caller scope
// and generic context, so neither needs resolution or coercion checks.
sema_type_same_named: fn(required: Type, offered: Type) -> Bool Never! {
    if required == {
        .Int -> offered == Type.Int
        .Float -> offered == Type.Float
        .Bool -> offered == Type.Bool
        .String -> offered == Type.String
        .Char -> offered == Type.Char
        .Float32 -> offered == Type.Float32
        .IntN(s1, b1) -> if offered == .IntN(s2, b2) -> s1 == s2 && b1 == b2 else -> false
        .Named(name) -> if offered == .Named(other) -> name != "" && name == other else -> false
        .List(a) -> if offered == .List(b) -> sema_type_same_named(a, b) else -> false
        .Option(a) -> if offered == .Option(b) -> sema_type_same_named(a, b) else -> false
        .Shared(a) -> if offered == .Shared(b) -> sema_type_same_named(a, b) else -> false
        .Result(ok1, err1) -> if offered == .Result(ok2, err2) -> sema_type_same_named(ok1, ok2) && sema_type_same_named(err1, err2) else -> false
        .Map(k1, _, v1) -> if offered == .Map(k2, _, v2) -> sema_type_same_named(k1, k2) && sema_type_same_named(v1, v2) else -> false
        .Apply(n1, args1) -> {
            if offered == .Apply(n2, args2) {
                if n1 == "" || n1 != n2 || args1.len() != args2.len() -> return false
                loop idx in 0..<args1.len() {
                    if !sema_type_same_named(args1[idx], args2[idx]) -> return false
                }
                return true
            }
            false
        }
        .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_type_assignable_in_graph_with_generics: fn(graph: SemaRegistrationGraph, required: Type, offered: Type, caller_module_identity: ModuleID, generic_params: [TGenericParam]) -> Bool? {
    // Snapshot: a lone program declares no registered type; types are
    // assignable as written.
    if graph.mode == .Snapshot -> return Val(sema_type_assignable(required, offered))
    if sema_type_same_named(required, offered) -> return Val(true)
    sema_type_assignable_in_graph_at(graph, required, offered, sema_type_module_row(graph, caller_module_identity), generic_params)
}

// sema_type_assignable_in_graph_with_generics for a caller already resolved
// to its registration row (-1: none).
sema_type_assignable_in_graph_at: fn(graph: SemaRegistrationGraph, required: Type, offered: Type, caller: Int, generic_params: [TGenericParam]) -> Bool? {
    // Snapshot: a lone program declares no registered type; types are
    // assignable as written.
    if graph.mode == .Snapshot -> return Val(sema_type_assignable(required, offered))
    if sema_type_same_named(required, offered) -> return Val(true)
    required_resolved: sema_type_resolve_declared_recursive(graph, required, caller, generic_params)
    offered_resolved: sema_type_resolve_declared_recursive(graph, offered, caller, generic_params)
    if sema_type_assignable(required_resolved, offered_resolved) -> return Val(true)
    if required_resolved == {
        .TraitObject(bounds) -> {
            loop bound in bounds {
                generic_satisfied: sema_type_generic_bound_satisfied(graph, offered_resolved, bound, caller, generic_params)
                if generic_satisfied == .Val(generic_ok) {
                    if !generic_ok -> return Val(false)
                    next
                }
                satisfied: sema_type_bound_satisfied_resolved(graph, offered_resolved, bound, caller, generic_params) ?? return None
                if !satisfied -> return Val(false)
            }
            Val(true)
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> Val(sema_type_assignable(sema_type_core_leaf_form(graph, required_resolved, caller), sema_type_core_leaf_form(graph, offered_resolved, caller)))
    }
}

// A qualified Core type export (`files.Stat`) is named by its bare leaf, the
// spelling a fixed Core row returns (`core.files.stat`'s `Stat`). Registration
// gives the export its owner's canonical identity (the Stat of the core.files
// module identity), so a canonical Core nominal meets the bare leaf when its
// owner Core module exports that type and the leaf names nothing in the
// caller's module. A Core record that only shares a built-in typed head's leaf
// (`core.files.path`'s `Path`) and the `core.crypto` structs keep their
// canonical identity.
sema_type_core_leaf_form: fn(graph: SemaRegistrationGraph, ty: Type, caller: Int) -> Type Never! {
    if ty == {
        .Named(name) -> if sema_type_core_leaf_name(graph, name, caller) == .Val(leaf) -> Type.Named{name: leaf} else -> ty
        .Apply(name, args) -> Type.Apply{name: name, args: loop arg in args -> sema_type_core_leaf_form(graph, arg, caller)}
        .List(inner) -> Type.List{element: sema_type_core_leaf_form(graph, inner, caller)}
        .Shared(inner) -> Type.Shared{inner: sema_type_core_leaf_form(graph, inner, caller)}
        .Option(inner) -> Type.Option{inner: sema_type_core_leaf_form(graph, inner, caller)}
        .Result(ok, err) -> Type.Result{ok: sema_type_core_leaf_form(graph, ok, caller), err: sema_type_core_leaf_form(graph, err, caller)}
        // copy: `key_span` is a payload of read parameter `ty`, which keeps the original; field `key_span` of the new Type.Map owns this one
        .Map(key, key_span, value) -> Type.Map{key: sema_type_core_leaf_form(graph, key, caller), key_span: key_span.copy(), value: sema_type_core_leaf_form(graph, value, caller)}
        // copy: `marker` is a payload of read parameter `ty`, which keeps the original; field `marker` of the new Type.Tagged owns this one
        .Tagged(marker, inner) -> Type.Tagged{marker: marker.copy(), inner: sema_type_core_leaf_form(graph, inner, caller)}
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ty
    }
}

// The bare leaf a canonical Core nominal `name` meets, if any (see above).
sema_type_core_leaf_name: fn(graph: SemaRegistrationGraph, name: String, caller: Int) -> String? {
    if !name.starts_with(MODULE_CORE_PREFIX) -> return None
    parts: name.split(".").to_list()
    if parts.len() < 2 -> return None
    last: parts.len() - 1
    leaf: parts[last]
    owner_parts := [String]{}
    loop index in 0..<last -> owner_parts.push(parts[index])
    module_name: sema_registration_module_name(graph, sema_registration_module_id(graph, owner_parts.join("."))) ?? return None
    if module_name == "core.crypto" -> return None
    if boundary_head_owner_module(leaf) != None && boundary_head_carrier_module(leaf) != Val(module_name) {
        return None
    }
    exports: core_module_export(module_name) ?? return None
    if !exports.type_exports.contains(leaf) -> return None
    if sema_type_graph_lookup_symbol_at(graph, caller, leaf) != None -> return None
    Val(leaf)
}

// A Core row's type (a builtin Core record's field, a fixed Core call's
// parameter or result) spells Core's nominals by their bare names. Such a name
// is Core's even in a program that declares a type of the same name: where
// the caller (row `caller`) resolves it to its own nominal, the name resolves
// in the first loaded Core module exporting it instead
// (sema_type_core_row_owner). Every other spelling is kept, so a Core body,
// and a program that declares no such name, read the row as before.
sema_type_core_row_form: fn(graph: SemaRegistrationGraph, ty: Type, caller: Int) -> Type Never! {
    if ty == {
        .Named(name) -> if sema_type_core_row_owner(graph, name, caller) == .Val(owner) -> sema_type_graph_resolve_named(graph, name, owner) else -> ty
        .Apply(name, args) -> {
            owner: sema_type_core_row_owner(graph, name, caller)
            Type.Apply{
                name: if owner == .Val(core) -> sema_type_graph_resolve_apply_name(graph, name, core) else -> name,
                args: loop arg in args -> sema_type_core_row_form(graph, arg, caller),
            }
        }
        .List(inner) -> Type.List{element: sema_type_core_row_form(graph, inner, caller)}
        .Shared(inner) -> Type.Shared{inner: sema_type_core_row_form(graph, inner, caller)}
        .Option(inner) -> Type.Option{inner: sema_type_core_row_form(graph, inner, caller)}
        .Result(ok, err) -> Type.Result{ok: sema_type_core_row_form(graph, ok, caller), err: sema_type_core_row_form(graph, err, caller)}
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Tagged(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ty
    }
}

// The registration row of the Core module a bare Core row name `name`
// resolves in, when the caller (row `caller`, a program module) declares or
// imports a non-Core nominal of that name: the first loaded Core module that
// exports it. None when the caller's own resolution already names Core's type.
sema_type_core_row_owner: fn(graph: SemaRegistrationGraph, name: String, caller: Int) -> Int? {
    if caller < 0 || module_is_core(graph.modules[caller].module_identity) -> return None
    if name.contains(".") || name.contains(".") -> return None
    resolved: sema_type_graph_lookup_symbol_at(graph, caller, name) ?? return None
    nominal: sema_type_graph_resolved_nominal_row(graph, resolved) ?? return None
    if module_is_core(graph.modules[nominal.module_index].module_identity) || graph.modules[nominal.module_index].nominals[nominal.row].compiler_owned {
        return None
    }
    loop module_name in core_type_modules(name) {
        owner: sema_registration_module_index_text(graph, "{MODULE_CORE_PREFIX}{module_name}") ?? next
        return Val(owner)
    }
    None
}

sema_type_assignable_in_graph: fn(graph: SemaRegistrationGraph, required: Type, offered: Type, caller_module_identity: ModuleID) -> Bool? {
    sema_type_assignable_in_graph_with_generics(graph, required, offered, caller_module_identity, [TGenericParam]{})
}

sema_type_associated: fn(graph: SemaRegistrationGraph, actual: Type, trait_name: String, associated_name: String, caller_module_identity: ModuleID) -> Type? {
    caller: sema_type_module_row(graph, caller_module_identity)
    actual_resolved: sema_type_resolve_declared_recursive(graph, actual, caller, [TGenericParam]{})
    nominal_row: sema_type_resolve_nominal_row_at(graph, actual_resolved, caller) ?? return None
    trait_symbol: sema_type_graph_trait_symbol_at(graph, caller, trait_name) ?? return None
    // The nominal row is passed in place: binding it copied the declaration.
    sema_type_associated_nominal(graph, graph.modules[nominal_row.module_index].nominals[nominal_row.row], trait_symbol, associated_name)
}

sema_type_associated_nominal: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, trait_symbol: Symbol, associated_name: String) -> Type? {
    resolved_type := Type?{None}
    // An associated type an owned trait infers from a method's failure
    // (`Iterator.Error`) is that method's failure when the impl leaves it
    // unset (sema_owned_failure_binds).
    loop module_index in 0..<graph.modules.len() {
        loop impl_index in 0..<graph.modules[module_index].impls.len() {
            trait_matches: sema_type_graph_impl_matches_trait(graph, graph.modules[module_index].impls[impl_index], trait_symbol) ?? next
            if !trait_matches -> next
            target_matches: sema_type_graph_impl_matches_nominal(graph, graph.modules[module_index].impls[impl_index], nominal) ?? next
            if !target_matches -> next
            written := false
            associated_types: graph.modules[module_index].impls[impl_index].associated_types.len()
            loop associated_index in 0..<associated_types {
                if graph.modules[module_index].impls[impl_index].associated_types[associated_index].symbol.name != associated_name {
                    next
                }
                if resolved_type != None -> return None
                written = true
                resolved_type = Val(sema_type_resolve_declared(graph, graph.modules[module_index].impls[impl_index].associated_types[associated_index].ty, graph.modules[module_index].impls[impl_index].source_module_identity))
            }
            if written -> next
            loop method in graph.modules[module_index].impls[impl_index].methods {
                if !sema_owned_failure_binds(trait_symbol.name, associated_name, method.declaration.name) {
                    next
                }
                if resolved_type != None -> return None
                resolved_type = Val(sema_type_resolve_failure(graph, method.declaration.return_type, graph.modules[module_index].impls[impl_index].source_module_identity))
                break
            }
        }
    }
    // An `impl Trait` block in the nominal's own body binds the same way.
    if nominal.source == .SourceAST(item) {
        loop block in sema_registration_item_trait_blocks(item) {
            trait_row: sema_checked_trait_nominal_row(graph, nominal.symbol.module_identity, block.trait_name) ?? next
            if graph.modules[trait_row.module_index].nominals[trait_row.row].symbol.id != trait_symbol.id {
                next
            }
            written := false
            loop associated in block.assoc_type_impls {
                if associated.name != associated_name -> next
                if resolved_type != None -> return None
                written = true
                resolved_type = Val(sema_type_resolve_declared(graph, associated.ty, nominal.symbol.module_identity))
            }
            if written -> next
            loop method in block.methods {
                if !sema_owned_failure_binds(trait_symbol.name, associated_name, method.name) {
                    next
                }
                if resolved_type != None -> return None
                resolved_type = Val(sema_type_resolve_failure(graph, method.return_type, nominal.symbol.module_identity))
                break
            }
        }
    }
    resolved_type
}

// The failure a method declares in its written return (the error of
// `T E!`, else `Never`), resolved as an associated type it binds.
sema_type_resolve_failure: fn(graph: SemaRegistrationGraph, return_type: Type?, caller_module_identity: ModuleID) -> Type Never! {
    if return_type == .Val(written) {
        if written == .Result(_, error) {
            return sema_type_resolve_declared(graph, error, caller_module_identity)
        }
    }
    sema_type_resolve_declared(graph, Type.Named{name: "Never"}, caller_module_identity)
}
