// Context blocks: the check of a `context` block, its scratch and deadline
// guards, and the allocator a block installs with its handler.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    ContextField,
    Expr,
    ExprPair,
    StrPart,
    core_source_owns_type,
    Span,
    Stmt,
    SymbolID,
    TFieldRef,
    Type,
    AST_EMPTY_CALL_ARG_FLAGS,
    symbol_is_none,
]

// Desugar `{CC: "clang", ...}` (inferred anonymous StructLit) in `#Context(env: ...)`
// into a `[String:String]` MapLit whose keys are the field names.
sema_stmt_context_env_desugar: fn(expr: Expr) -> Expr? Never! {
    if expr == .StructLit(type_name, _, _, _, fields, inferred, lit_span, _) && inferred && type_name == "" {
        ^entries: [ExprPair]{}
        loop f in fields {
            key: Expr.Str{parts: [StrPart]{StrPart.Lit{text: f.name}}, span: f.name_span, id: AST_NODE_GENERATED}
            entries.push(ExprPair{key: key, value: f.value})
        }
        return Val(Expr.MapLit{entries: entries, span: lit_span, id: AST_NODE_GENERATED})
    }
    None
}

// Whether `ty` is `core.files.path.Path` (extracting its `.raw: String` field
// for `#Context(dir: path)`).
sema_stmt_context_dir_path: fn(ty: Type) -> Bool Never! {
    if ty == .Named(name) {
        return name == "Path" || (name.ends_with(".Path") && core_source_owns_type(name))
    }
    false
}

// Each `#Context` field value is checked once in the enclosing scope
// (`allocator` an `Arena`, `Bump`, `Pool` or `Fixed` handle,
// `context.scratch`, the task's own arena (sema_stmt_context_scratch), or a
// value whose type implements `mem.Allocator`, whose guard is its handler,
// sema_stmt_context_allocator_handler); `logger` is core.log's
// `logger` key, `on_stop` the stop handler, a `fn(debug.Stop)`, `dir` the
// task working directory (`String` or `Path`), `env` an environment overlay
// (`[String:String]` or `{KEY: "value"}`), and any other label names a
// `#ContextKey` constant, whose value takes the key's type; a label naming
// neither is E0761. A `#Deadline(limit)` block is the context block of its
// one `deadline` field, a `Duration` or an `Instant` (the marker binding,
// E0930). Then the body is an ordinary nested block. Lowering installs the
// guards around the body (IR BuildTransact.jet ir_context_block).
sema_stmt_check_context_block: fn(fields: [ContextField], body: [Stmt], span: Span, return_type: Type?, check: ^SemaBodyCheck, loop_depth: Int, output: ^[TStmt]) -> Bool {
    // The block's `#Context` or `#Deadline` application binds first; fields
    // that do not bind (E0930) get no E0762 of their own.
    signature_valid: sema_marker_rules_check_context_fact(span, check)
    ^complete: signature_valid
    ^guards: [TContextGuard]{}
    loop field in fields {
        if !sema_context_field_settable(field.name) {
            name_span: Span{start: field.span.start, end: field.span.start + field.name.len()}
            found: sema_context_label_key(field.name, check) ?? {
                ^_: sema_check_expression(field.value, None, check)
                check.diagnostics.push(sema_error("E0761", name_span, "`{field.name}` isn't a context field or key", "`#Context` sets `allocator`, `logger` and `on_stop`, and the constants a package declares with `#ContextKey`", "declare `#ContextKey {field.name}: …` or write `#Context(allocator: …)`, `#Context(logger: …)` or `#Context(on_stop: …)`"))
                complete = false
                next
            }
            if field.name == "dir" {
                checked_dir: sema_check_expression(field.value, None, check) ?? {
                    complete = false
                    next
                }
                if sema_stmt_context_dir_path(checked_dir.ty) {
                    reference: TFieldRef{owner: None, name: "raw", ty: Type.String, boxed: false}
                    raw_dir: sema_tree_node(Type.String, TExprKind.Field{receiver: checked_dir, field: reference}, field.span)
                    guards.push(TContextGuard{field: field.name, value: raw_dir, key: found.key})
                    next
                }
                dir_val: sema_expr_expected_owned(checked_dir, Val(found.ty), check.environment.*, check.program.*, check.diagnostics) ?? {
                    complete = false
                    next
                }
                guards.push(TContextGuard{field: field.name, value: dir_val, key: found.key})
                next
            }
            checked_opt: if field.name == "env" && sema_stmt_context_env_desugar(field.value) == .Val(desugared) -> {
                sema_check_expression(desugared, Val(found.ty), check)
            } else -> {
                sema_check_expression(field.value, Val(found.ty), check)
            }
            checked_key: checked_opt ?? {
                complete = false
                next
            }
            // A value of another type is the ordinary mismatch; an optional
            // key takes a present value as `T?`.
            value: sema_expr_expected_owned(checked_key, Val(found.ty), check.environment.*, check.program.*, check.diagnostics) ?? {
                complete = false
                next
            }
            guards.push(TContextGuard{field: field.name, value: value, key: found.key})
            next
        }
        if field.name == "allocator" && sema_stmt_context_scratch(field.value, check) {
            guards.push(TContextGuard{field: field.name, value: sema_tree_node(Type.Named{name: SEMA_MEMORY_ARENA}, TExprKind.HostCall{call: THostCall.ContextRead{field: "scratch"}}, field.span)})
            next
        }
        checked: sema_check_expression(field.value, None, check) ?? {
            complete = false
            next
        }
        if field.name == "deadline" {
            if signature_valid -> guards.push(sema_stmt_deadline_guard(checked, field.span))
            next
        }
        if signature_valid && field.name == "allocator" && !sema_stmt_context_allocator_type(checked.ty) {
            if !sema_stmt_context_user_allocator(checked.ty, check) {
                check.diagnostics.push(sema_error("E0762", field.span, "`allocator` needs an allocator, got {sema_type_show(checked.ty)}", "the `allocator` field takes an `Arena`, `Bump`, `Pool`, or `Fixed` value, or a value whose type implements `mem.Allocator`", "pass an allocator, e.g. `mem.Arena.new()`"))
                complete = false
            } else {
                // The block's allocations write through the allocator it
                // names, so the block writes that binding (E0514, E0518).
                if sema_scope_place_root(field.value) == .Val(root) && sema_scope_resolve_index(check.scopes, root) == .Val(index) {
                    sema_ownership_note_binding_write(check.state, check.scopes.bindings[index])
                }
                handler: sema_stmt_context_allocator_handler(field, checked.ty, check) ?? {
                    complete = false
                    next
                }
                guards.push(TContextGuard{field: field.name, value: handler})
                next
            }
        }
        guards.push(TContextGuard{field: field.name, value: checked})
    }
    previous_allocation: check.scopes.context_allocation
    // Each open block's allocator stays in place while the block runs
    // (Ownership/Checks.jet SemaOwnershipBlockAllocator).
    open_allocators: check.state.block_allocators.len()
    ^names_allocator: false
    loop field in fields {
        if field.name != "allocator" -> next
        names_allocator = true
        places: sema_ownership_places_from_expr_in_state(field.value, check.scopes, check.state)
        if places.len() > 0 && !symbol_is_none(places[0].root_id) {
            check.state.block_allocators.push(SemaOwnershipBlockAllocator{name: sema_ownership_place_name(places[0]), id: SymbolID{id: places[0].root_id.id}})
        }
    }
    // A `#Deadline` block, the block of the one `deadline` field, sets no
    // allocation context of its own; L0506 reads the enclosing one.
    deadline_only: fields.len() == 1 && fields[0].name == "deadline"
    check.scopes.context_allocation = if names_allocator || previous_allocation == 2 -> 2 else if deadline_only -> previous_allocation else -> 1
    nested: sema_stmt_check_block(body, return_type, check, "context@{span.start}", loop_depth)
    loop check.state.block_allocators.len() > open_allocators {
        ^_: check.state.block_allocators.pop()
    }
    check.scopes.context_allocation = previous_allocation
    if !nested.complete -> return false
    if !complete -> return false
    output.push(TStmt.ContextBlock{guards: guards, body: nested.value, span: span})
    true
}

// Whether the allocator guard `value` is `context.scratch` (any root that
// names the task context, sema_context_root), the task's own arena. Its
// guard is a context read of type `Arena` that lowering never evaluates.
sema_stmt_context_scratch: fn(value: Expr, check: ^SemaBodyCheck) -> Bool Never! {
    if value == .Field(base, member, _, _) && member == "scratch" && base == .Ident(root, root_span, _) {
        return sema_context_root(root, root_span, check)
    }
    false
}

// A `#Deadline(limit)` guard reads the bound's nanoseconds: a `Duration`
// bounds the waits that long from entry (`deadline_after_ns`), an `Instant`
// at its monotonic nanosecond (`deadline_at_ns`). Lowering keeps the earlier
// of it and the deadline already in force.
sema_stmt_deadline_guard: fn(limit: ^^TExpr, span: Span) -> TContextGuard Never! {
    at: sema_stmt_deadline_instant(limit.ty)
    member: if at -> "start_ns" else -> "ns"
    reference: TFieldRef{owner: None, name: member, ty: Type.Int, boxed: false}
    TContextGuard{field: if at -> "deadline_at_ns" else -> "deadline_after_ns", value: sema_tree_node(Type.Int, TExprKind.Field{receiver: limit, field: reference}, span)}
}

// Whether a `#Deadline` bound is an `Instant`: the built-in time point or
// Core/Time's source struct (`<corelib>/....Instant`), which `time.instant()`
// returns.
sema_stmt_deadline_instant: fn(ty: Type) -> Bool Never! {
    if ty == .Named(name) {
        return name == "Instant" || (name.ends_with(".Instant") && core_source_owns_type(name))
    }
    false
}

// Whether `ty` is a core.mem allocator (sema_call_memory_allocator_name),
// not a view of one.
sema_stmt_context_allocator_type: fn(ty: Type) -> Bool Never! {
    ty == .Named(_) && sema_call_memory_allocator_name(ty) != None
}

// Whether `ty` names a type that implements core.mem's `Allocator`, as the
// user writes it (a type parameter is not one).
sema_stmt_context_user_allocator: fn(ty: Type, check: SemaBodyCheck) -> Bool {
    graph: check.program.registration_graph
    identity: sema_call_core_module_identity(check.environment.*, check.program.*, "core.mem") ?? return false
    caller: sema_scope_caller_row(check.environment.*, graph)
    actual: sema_type_resolve_declared_recursive(graph, ty, caller, check.environment.generic_params)
    nominal_row: sema_type_resolve_nominal_row_at(graph, actual, caller) ?? return false
    trait_symbol: sema_type_graph_trait_symbol_at(graph, sema_type_module_row(graph, identity), "Allocator") ?? return false
    sema_type_bound_satisfied_nominal(graph, graph.modules[nominal_row.module_index].nominals[nominal_row.row], trait_symbol, "Allocator", actual, check.environment.generic_params) == Val(true)
}

// A `#Context(allocator: a)` block over a user allocator: the guard's value
// is the call, on `a`, of the core.mem function that fills the
// AllocatorHandler role: the function the runtime calls for each allocation
// and release inside the block (JetRuntime Alloc.jet alloc_user_call). It
// lends `a` as `^`, and the block keeps `a` in place until it ends (E0204,
// Ownership/Checks.jet SemaOwnershipBlockAllocator).
sema_stmt_context_allocator_handler: fn(field: ContextField, ty: Type, check: ^SemaBodyCheck) -> TExpr? {
    if sema_call_core_module_identity(check.environment.*, check.program.*, "core.mem") == None {
        return None
    }
    graph: check.program.registration_graph
    filler: sema_core_role_function(graph, "AllocatorHandler") ?? {
        check.diagnostics.push(sema_missing_core_role("AllocatorHandler", field.span))
        return None
    }
    target: sema_call_core_source_target(check.environment.*, check.program.*, filler.module_identity, filler.name, [Type]{ty}, field.span, true, check.diagnostics) ?? {
        check.diagnostics.push(sema_error("E0003", field.span, "core.mem's allocator handler is missing", "a `#Context(allocator:)` block over a user allocator calls the core.mem function that fills the AllocatorHandler role", "load the registered Core source module"))
        return None
    }
    ^args: [CallArg]{CallArg{convention: AccessConvention.Write, expr: field.value, span: field.span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}}
    check.scopes.ownership_call_depth += 1
    ^value: sema_call_core_check_source_owned(target, "#Context(allocator:)", [Type]{ty}, args, field.span, None, check)
    check.scopes.ownership_call_depth -= 1
    value
}
