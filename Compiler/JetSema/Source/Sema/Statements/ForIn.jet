// `loop ... in` statements: range endpoints and strides, the iterable's
// facts and item types, and whether the body may consume or change the
// collection it walks.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    Diagnostic,
    Expr,
    Lambda,
    BodyTree,
    body_each_node_kind_child,
    builtin_carrier_declares,
    body_each_stmt_child,
    NamedSpan,
    OrFallback,
    PlaceAccess,
    Span,
    MarkerHook,
    Stmt,
    Symbol,
    SymbolID,
    SymbolKind,
    TForInMethod,
    TLocal,
    TYPE_ID_NEVER,
    TTryConvert,
    Type,
    TypeTupleField,
    expr_span,
    module_is_core,
    symbol_key_text,
    symbol_local_keys_text,
    symbol_table_key,
    checked_symbol_local,
    type_identity_key,
    type_name,
    TextEdit,
    UnOp,
    diagnostic_with_edit,
]

sema_stmt_range_integer_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .InlineRange(_, _, _) -> true
        .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_stmt_check_range_endpoint: fn(expr: Expr, which: String, check: ^SemaBodyCheck) -> TExpr? {
    value: sema_check_expression(expr, None, check) ?? return None
    if !sema_stmt_range_integer_type(value.ty) {
        check.diagnostics.push(sema_error("E0109", expr_span(expr), "the {which} of a `for` range must be Int, not {type_name(value.ty)}", "`loop` counts whole numbers between two ends", "use Int values for both ends, like `1..10` or `0..<n`"))
        return None
    }
    Val(value)
}

sema_stmt_check_range_stride: fn(expr: Expr, check: ^SemaBodyCheck) -> TExpr? {
    value: sema_check_expression(expr, None, check) ?? return None
    if !sema_stmt_range_integer_type(value.ty) {
        check.diagnostics.push(sema_error("E0123", expr_span(expr), "a range loop stride must be Int, not {type_name(value.ty)}", "the stride is how far to count each turn, so it must be a whole number", "use an Int stride, like `loop i in 0..10, 2`"))
        return None
    }
    if expr == {
        .Int(n, span, _, _, _) -> {
            if n <= 0 {
                check.diagnostics.push(sema_error("E0123", span, "a range loop stride must be positive, not {n}", "a zero or negative stride would never reach the end", "use a stride of 1 or more, like `loop i in 0..10, 2 {{ ... }}`"))
                return None
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    Val(value)
}

// A number written in the source, with an optional leading minus.
sema_range_written_int: fn(expr: Expr) -> Int? {
    if expr == {
        .Int(value, _, _, _, _) -> Val(value)
        .Paren(inner, _, _) -> sema_range_written_int(inner)
        .Unary(op, operand, _, _) -> {
            if op != UnOp.Neg -> return None
            value: sema_range_written_int(operand) ?? return None
            Val(0 - value)
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// Written ends and step that count in opposite directions are E0170. A loop
// range gets a fix edit for its step; a range value is taught to write its ends
// in order.
sema_range_backward_diagnostic: fn(start: Expr, end: Expr, step: Expr?, exclusive: Bool, loop_range: Bool) -> Diagnostic? {
    s: sema_range_written_int(start) ?? return None
    e: sema_range_written_int(end) ?? return None
    op: if exclusive -> "..<" else -> ".."
    ^written_step: Int?{None}
    if step == .Val(step_expr) -> written_step = sema_range_written_int(step_expr)
    range_span: Span{start: expr_span(start).start, end: expr_span(end).end}
    if s > e {
        if step == .Val(step_expr) {
            k: written_step ?? return None
            if k <= 0 -> return None
            diagnostic: sema_error("E0170", expr_span(step_expr), "this range counts down from {s} to {e} but its step {k} counts up", "a positive step moves away from {e}, so the loop would run zero times", "make the step negative: `{s}{op}{e}, -{k}`")
            return Val(diagnostic_with_edit(diagnostic, TextEdit{span: expr_span(step_expr), new_text: "-{k}"}))
        }
        if !loop_range {
            return Val(sema_error("E0170", range_span, "this range counts down from {s} to {e} and holds no numbers", "a range value always counts up from its start, so a bigger start leaves it empty", "write the smaller end first, `{e}{op}{s}`; count down in a loop with `{s}{op}{e}, -1`"))
        }
        diagnostic: sema_error("E0170", range_span, "this range counts down from {s} to {e} but has no step", "a range without a step counts up, so `{s}{op}{e}` would run zero times", "add the minus step: `{s}{op}{e}, -1`")
        end_at: expr_span(end).end
        return Val(diagnostic_with_edit(diagnostic, TextEdit{span: Span{start: end_at, end: end_at}, new_text: ", -1"}))
    }
    if s < e && step == .Val(step_expr) {
        k: written_step ?? return None
        if k >= 0 -> return None
        up: 0 - k
        diagnostic: sema_error("E0170", expr_span(step_expr), "this range counts up from {s} to {e} but its step {k} counts down", "a negative step moves away from {e}, so the loop would run zero times", "make the step positive: `{s}{op}{e}, {up}`")
        return Val(diagnostic_with_edit(diagnostic, TextEdit{span: expr_span(step_expr), new_text: "{up}"}))
    }
    None
}

// A loop source's step: what it walks and its item. `routed` is false when
// an Iterable's `next` fails with a failure the enclosing body has no
// route for (its diagnostic is reported).
SemaForInIterableFact: struct {
    method_kind: TForInMethod,
    item_type: Type,
    routed: Bool{true},
}

SemaForInPairTypes: struct {
    first: Type,
    second: Type,
}

sema_stmt_for_in_named_type_name: fn(ty: Type) -> String? {
    if ty == {
        .Named(name) -> return Val(name)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
}

sema_stmt_for_in_type_is_named: fn(ty: Type, name: String) -> Bool Never! {
    actual: sema_stmt_for_in_named_type_name(ty) ?? return false
    actual == name || actual.ends_with(".{name}")
}

// Whether `ty` holds a `#SingleUse` carrier (`Task<T>`) at any depth, so a
// walk over it has to own its items.
sema_stmt_for_in_type_requires_owned_iteration: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, args) -> {
            if name == "ViewMut" -> return false
            if builtin_carrier_declares(name, MarkerHook.SingleUse) -> return true
            loop arg in args {
                if sema_stmt_for_in_type_requires_owned_iteration(arg) -> return true
            }
            return false
        }
        .List(inner) | .FixedList(inner, _) -> return sema_stmt_for_in_type_requires_owned_iteration(inner)
        .Tuple(fields) -> {
            loop field in fields {
                if sema_stmt_for_in_type_requires_owned_iteration(field.ty) -> return true
            }
            return false
        }
        .Option(inner) | .Shared(inner) -> return sema_stmt_for_in_type_requires_owned_iteration(inner)
        .Result(ok, err) -> return sema_stmt_for_in_type_requires_owned_iteration(ok) || sema_stmt_for_in_type_requires_owned_iteration(err)
        .Map(key, _, value) -> return sema_stmt_for_in_type_requires_owned_iteration(key) || sema_stmt_for_in_type_requires_owned_iteration(value)
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return false
    }
}

// The associated types and method symbol keys of the `trait_name` impl of
// the nominal `identity` keys, and the module that writes it: a top-level
// impl row (the last one, as the loop source reads it), else an
// `impl Trait { … }` block in the nominal's own body, whose methods the
// nominal registers. The associated types, parallel names and types,
// include those the trait infers from a method's failure
// (sema_owned_bind_failure).
SemaForInTraitImpl: struct {
    module_index: Int,
    associated_names: [String],
    associated_types: [Type],
    method_keys: [String:String],
}

sema_stmt_for_in_trait_impl: fn(graph: SemaRegistrationGraph, trait_name: String, identity: String) -> SemaForInTraitImpl? {
    ^found: SemaForInTraitImpl?{None}
    loop module_index in 0..<graph.modules.len() {
        loop implementation_index in 0..<graph.modules[module_index].impls.len() {
            if graph.modules[module_index].impls[implementation_index].trait_name != (Val(trait_name)) || graph.modules[module_index].impls[implementation_index].target_identity_key != identity {
                next
            }
            ^names: loop declared in graph.modules[module_index].impls[implementation_index].associated_types -> declared.declaration.name
            ^types: loop declared in graph.modules[module_index].impls[implementation_index].associated_types -> declared.declaration.ty.copy()
            ^keys: [String:String]{}
            loop method in graph.modules[module_index].impls[implementation_index].methods {
                keys[method.declaration.name] = symbol_table_key(graph.symbols, method.symbol.id)
                sema_owned_bind_failure(trait_name, method.declaration, names, types)
            }
            found = Val(SemaForInTraitImpl{module_index: module_index, associated_names: names, associated_types: types, method_keys: keys})
        }
    }
    if found != None -> return found
    loop module_index in 0..<graph.modules.len() {
        loop nominal_index in 0..<graph.modules[module_index].nominals.len() {
            if graph.modules[module_index].nominals[nominal_index].identity_key != identity -> next
            if graph.modules[module_index].nominals[nominal_index].source == .SourceAST(item) {
                loop block in sema_registration_item_trait_blocks(item) {
                    if block.trait_name != trait_name -> next
                    ^keys: [String:String]{}
                    loop method in graph.modules[module_index].nominals[nominal_index].methods {
                        loop written in block.methods {
                            if written.span == method.declaration.span {
                                keys[method.declaration.name] = symbol_table_key(graph.symbols, method.symbol.id)
                            }
                        }
                    }
                    ^names: loop associated in block.assoc_type_impls -> associated.name
                    ^types: loop associated in block.assoc_type_impls -> associated.ty
                    loop written in block.methods {
                        sema_owned_bind_failure(trait_name, written, names, types)
                    }
                    return Val(SemaForInTraitImpl{module_index: module_index, associated_names: names, associated_types: types, method_keys: keys})
                }
            }
        }
    }
    None
}

// The step of a loop over an Iterable source. The loop header calls `next`,
// so a failure of it passes up as an implicit fallible call's does, through
// the same conversion (sema_expression_propagation_conversion) at the
// header `span`.
sema_stmt_for_in_iterable_fact: fn(check: ^SemaBodyCheck, collection_type: Type, span: Span) -> SemaForInIterableFact? {
    if sema_stmt_for_in_named_type_name(collection_type) == None -> return None
    graph: check.program.registration_graph
    // Impls key their target by the declaring nominal's identity, so a
    // source type and its `Iter` resolve to that nominal first (a Core
    // type written by its bare name, `HTTPBodyChunks`, included).
    ^collection_identity: type_identity_key(collection_type)
    if sema_type_resolve_nominal_row_at(graph, collection_type, sema_scope_caller_row(check.environment.*, graph)) == .Val(row) {
        collection_identity = graph.modules[row.module_index].nominals[row.row].identity_key
    }
    iterable: sema_stmt_for_in_trait_impl(graph, "Iterable", collection_identity) ?? return None
    ^iter_type: Type?{None}
    loop index in 0..<iterable.associated_names.len() {
        if iterable.associated_names[index] == "Iter" {
            iter_type = Val(iterable.associated_types[index])
        }
    }
    resolved_iter_type: iter_type ?? return None
    if sema_stmt_for_in_named_type_name(resolved_iter_type) == None -> return None
    ^iterator_identity: type_identity_key(resolved_iter_type)
    if sema_type_resolve_nominal_row_at(graph, resolved_iter_type, iterable.module_index) == .Val(iter_row) {
        iterator_identity = graph.modules[iter_row.module_index].nominals[iter_row.row].identity_key
    }
    iterator: sema_stmt_for_in_trait_impl(graph, "Iterator", iterator_identity) ?? return None
    ^item_type: Type?{None}
    ^error_type: Type?{None}
    loop index in 0..<iterator.associated_names.len() {
        if iterator.associated_names[index] == "Item" {
            item_type = Val(iterator.associated_types[index])
        }
        if iterator.associated_names[index] == "Error" {
            error_type = Val(iterator.associated_types[index])
        }
    }
    item: item_type ?? return None
    iter_key: iterable.method_keys.get("iter") ?? return None
    next_key: iterator.method_keys.get("next") ?? return None
    ^failure: TTryConvert.Never
    ^routed: true
    if error_type == .Val(error) && error != (Type.Named{name: "Never"}) {
        // The step call the header stands for: its callee is `next`
        // (sema_failure_call_provenance names a method call by its
        // method), so the receiver is not read.
        step_call: Expr.MethodCall{receiver: Expr.Unit{span: span, id: AST_NODE_GENERATED}, method: "next", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, id: AST_NODE_GENERATED}
        callee: SemaFailureCallee{key: next_key, inferable: false}
        converted: sema_expression_propagation_conversion(Type.Result{ok: Type.Option{inner: item}, err: error}, Val(step_call), Val(callee), span, true, check.environment.*, check.program.*, check.scopes, check.context, check.diagnostics)
        routed = converted != None
        failure = converted ?? TTryConvert.Never
        if converted == .Val(conversion) && check.scopes.failures_explicit {
            sema_failure_marks_require_loop_step(span, conversion, Val(callee), check.scopes, check.context, check.diagnostics)
        }
    }
    Val(SemaForInIterableFact{
        method_kind: TForInMethod.Iterable{coll_type: collection_identity, iter_type: iterator_identity, iter_symbol: iter_key, next_symbol: next_key, item_type: item, failure: failure},
        item_type: item,
        routed: routed,
    })
}

// A Core reader, one whose `next(^self)` answers `Item? E!` (`JSONReader`,
// `CBORReader`, `CSVReader`, ...): the loop calls that `next` each step
// (IR ir_encoding_reader_walk), so the item is the `Item` Core declares.
sema_stmt_for_in_reader_fact: fn(check: SemaBodyCheck, collection_type: Type) -> SemaForInIterableFact? {
    graph: check.program.registration_graph
    row: sema_type_resolve_nominal_row_at(graph, collection_type, sema_scope_caller_row(check.environment.*, graph)) ?? return None
    if !module_is_core(graph.modules[row.module_index].nominals[row.row].symbol.module_identity) {
        return None
    }
    loop method in graph.modules[row.module_index].nominals[row.row].methods {
        if method.declaration.name != "next" -> next
        ^item: sema_stmt_for_in_reader_item(method.signature) ?? next
        if collection_type == .Apply(_, args) {
            names: loop param in graph.modules[row.module_index].nominals[row.row].generic_params -> param.name
            item = sema_inference_substitute_type(item, names, args)
        }
        reader: graph.modules[row.module_index].nominals[row.row].identity_key
        return Val(SemaForInIterableFact{method_kind: TForInMethod.EncodingReader{reader_type: reader}, item_type: item})
    }
    None
}

// The `Item` of a reader step `fn(^self) -> Item? E!`, or None for any other
// signature.
sema_stmt_for_in_reader_item: fn(signature: Type) -> Type? {
    if signature == .Fn(params, ret, _, _, _, _) {
        if params.len() != 1 -> return None
        if ret == .Val(returned) {
            if returned == .Result(ok, _) {
                if ok == .Option(item) -> return Val(item)
            }
        }
    }
    None
}

sema_stmt_for_in_method_kind: fn(expression: Expr, collection: TExpr) -> TForInMethod? {
    if expression == {
        .MethodCall(receiver_expr, method, _, _, _, _, _) -> {
            if method == "chars" -> return Val(TForInMethod.Chars)
            if method == "lines" {
                if collection.kind == .MethodCall(receiver_value, _, _, _) {
                    if sema_stmt_for_in_type_is_named(receiver_value.ty, "FileReader") {
                        return Val(TForInMethod.LinesFile)
                    }
                    if sema_stmt_for_in_type_is_named(receiver_value.ty, "StdinHandle") {
                        return Val(TForInMethod.LinesStdin)
                    }
                    if receiver_expr == .Field(_, member, _, _) && (member == "stdout" || member == "stderr") {
                        if receiver_value.kind == .Field(base_value, _) && sema_stmt_for_in_type_is_named(base_value.ty, "ProcessChild") {
                            return Val(TForInMethod.LinesProcessStream)
                        }
                    }
                }
                if sema_stmt_for_in_type_is_named(collection.ty, "FileLines") {
                    return Val(TForInMethod.LinesFile)
                }
                if sema_stmt_for_in_type_is_named(collection.ty, "StdinLines") {
                    return Val(TForInMethod.LinesStdin)
                }
                if sema_stmt_for_in_type_is_named(collection.ty, "ProcessLines") {
                    return Val(TForInMethod.LinesProcessStream)
                }
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    if collection.ty == .Apply(name, args) {
        if name == "Receiver" && args.len() == 1 -> return Val(TForInMethod.ChannelReceiver)
    }
    None
}

sema_stmt_for_in_source: fn(expression: Expr, collection: TExpr, method_kind: TForInMethod?) -> TExpr Never! {
    ^special_source: method_kind == (Val(TForInMethod.Chars)) || method_kind == (Val(TForInMethod.LinesFile)) || method_kind == (Val(TForInMethod.LinesStdin)) || method_kind == (Val(TForInMethod.LinesProcessStream))
    if special_source {
        if expression == {
            .MethodCall(_, method, _, _, _, _, _) -> {
                if method == "chars" || method == "lines" {
                    if collection.kind == {
                        // copy: `receiver` is a payload of read parameter `collection`, which keeps the original; the returned value owns this one
                        .MethodCall(receiver, _, _, _) -> return receiver.copy()
                        // `text.chars()` checks as the String builtin; the
                        // loop walks its receiver's scalars.
                        .BuiltinMethod(receiver, operation, _) -> {
                            if operation == .Chars -> return receiver
                        }
                        // `child.stdout.lines()` checks as the process
                        // stream's handle method; the loop reads the stream.
                        .HandleMethod(receiver, _, _) -> {
                            if method_kind == (Val(TForInMethod.LinesProcessStream)) {
                                return receiver.copy()
                            }
                        }
                        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {}
                    }
                }
            }
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
        }
    }
    // copy: the for-in source is a new owned TExpr. Otherwise it equals `collection`, the caller's
    // checked iterable (a read parameter), which the caller keeps.
    collection.copy()
}

sema_stmt_for_in_expr_root_ident: fn(expression: Expr) -> String? {
    if expression == {
        .Ident(name, _, _) -> return Val(name)
        .Field(base, _, _, _) | .Index(base, _, _, _, _) | .Slice(base, _, _, _, _, _) -> return sema_stmt_for_in_expr_root_ident(base)
        .Paren(value, _, _) | .Copy(value, _, _) -> return sema_stmt_for_in_expr_root_ident(value)
