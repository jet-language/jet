// Prep-time blocks: prep `if` and comptime blocks, the runtime locals they
// may not read, prep type tables and switches, setting switches, and the
// arms of an OS dispatch.
use jet_foundation.[
    AST_NODE_GENERATED,
    BinOp,
    Diagnostic,
    Expr,
    BodyTree,
    body_each_node_kind_child,
    Pattern,
    Span,
    Stmt,
    SwitchArm,
    TComptimeValue,
    TARGET_OS_ALL,
    Type,
    expr_span,
    target_os_name,
    type_name,
]

// `#if` selects a branch while building. Its condition is compile-time
// code, like `name: #run value` (sema_stmt_check_prepared_binding): a
// value already known here selects at once; any other value is staged through
// the body comptime evaluator, and the branch is selected when the owner body
// is checked again. The selected arm is an ordinary nested block emitted
// inline; the dropped arm is checked for name resolution only (its other
// reports and everything it did to the scope, the context and the ownership
// state are rolled back). In a generic body, a condition that reads a type
// parameter's record (`T.reflect()`) has one value per instance: both arms
// are checked, and each instance selects by the value it gives the
// condition (sema_comptime_generic_site_read). False while the arm is
// unselected or incomplete.
sema_stmt_check_prep_if: fn(cond: Expr, cond_span: Span, then_body: [Stmt], else_body: [Stmt]?, span: Span, return_type: Type?, check: ^SemaBodyCheck, loop_depth: Int, output: ^[TStmt]) -> Bool {
    // `#if T == Int { … }` is the one-arm type test,
    // which already keeps its arm only in the `Int` instance.
    if sema_expression_type_table_param(cond, check) != None {
        arm: SwitchArm{cond: cond, body: then_body, span: cond_span}
        return sema_stmt_check_prep_type_table(Expr.Bool{value: true, span: span, id: AST_NODE_GENERATED}, [SwitchArm]{arm}, else_body, span, return_type, check, loop_depth, output)
    }
    fact_start: check.context.call_facts.len()
    reference_start: check.context.name_references.len()
    reflection_start: check.context.generic_reflections.len()
    outer_site: check.context.generic_site
    check.context.generic_site = true
    check.scopes.comptime_execution_depth += 1
    checked: sema_check_expression(cond, None, check)
    check.scopes.comptime_execution_depth -= 1
    check.context.generic_site = outer_site
    condition: checked ?? return false
    if sema_stmt_comptime_site_refused(check, fact_start) -> return false
    // A condition that reads a `name: #run value` local still waiting for
    // its value waits with it.
    if sema_comptime_reads_pending_local(check, reference_start) -> return false
    // A prepared local reads as its value, so a local left in the checked
    // condition is known only at run time.
    runtime_local := false
    sema_stmt_reads_runtime_local(condition, check.context.arena.tree, runtime_local)
    if runtime_local {
        check.diagnostics.push(sema_error("E0989", cond_span, "this `#if` condition can't be known at compile time", "a `#if` condition must be a known-time expression — a prepared value, a literal, or a pure function call with known arguments", "prepare the value first: `flag: #run {{ … }}`, then write `#if flag {{ … }}`"))
        return false
    }
    if sema_expr_unwrap_tag(condition.ty) != Type.Bool {
        check.diagnostics.push(sema_stmt_prep_if_not_bool(cond_span))
        return false
    }
    params: sema_comptime_generic_site_params(check.context, reflection_start)
    if params.len() > 0 {
        return sema_stmt_check_generic_prep_if(cond, condition.ty, params, cond_span, then_body, else_body, span, return_type, check, loop_depth, output)
    }
    value := sema_expr_comptime_value(condition, check.context)
    if value == None -> value = sema_fact_constant_path_value(condition, check.context)
    if value == None {
        // A condition known here runs nothing; one computed while building
        // runs code, which `#Runtime(.Only)` refuses.
        if sema_runtime_policy_only(check.context.runtime_policy) {
            check.diagnostics.push(sema_runtime_only_build_time_diagnostic("This `#if` runs its condition", cond_span))
            return false
        }
        staged: sema_comptime_body_value_find(check.context, check.environment.module_identity, sema_scope_function_owner_key(check.scopes), cond_span, span)
        if staged == .Val(body_value) -> value = Val(body_value.value) else {
            _ := sema_comptime_body_capture(check.context, check.environment.*, check.program.*, check.scopes, "#if", cond, condition.ty, cond_span, span)
            return false
        }
    }
    known: value ?? return false
    selected := false
    if known == .Bool(flag) -> selected = flag else {
        check.diagnostics.push(sema_stmt_prep_if_not_bool(cond_span))
        return false
    }
    owner: "prep-if@{span.start}"
    nested := SemaStatementResult{value: [TStmt]{}, complete: true}
    if selected {
        nested = sema_stmt_check_block(then_body, return_type, check, owner, loop_depth)
        if else_body == .Val(dropped) {
            sema_stmt_check_dropped_prep_arm(dropped, return_type, check, owner, loop_depth)
        }
    } else {
        if else_body == .Val(chosen) {
            nested = sema_stmt_check_block(chosen, return_type, check, owner, loop_depth)
        }
        sema_stmt_check_dropped_prep_arm(then_body, return_type, check, owner, loop_depth)
    }
    if !nested.complete -> return false
    output.push(TStmt.Inline{body: nested.value, span: span})
    true
}

// A `#if` of a generic body whose condition reads the records of type
// parameters `params` (sema_stmt_check_prep_if): an ordinary `if` on the
// value each instance gives the condition, so both arms are checked.
sema_stmt_check_generic_prep_if: fn(
    cond: Expr,
    ty: Type,
    params: [Type],
    cond_span: Span,
    then_body: [Stmt],
    else_body: [Stmt]?,
    span: Span,
    return_type: Type?,
    check: ^SemaBodyCheck,
    loop_depth: Int,
    output: ^[TStmt],
) -> Bool {
    if sema_runtime_policy_only(check.context.runtime_policy) {
        check.diagnostics.push(sema_runtime_only_build_time_diagnostic("This `#if` runs its condition", cond_span))
        return false
    }
    value: sema_comptime_generic_site_read(check, "#if", cond, ty, params, cond_span, span)
    condition: sema_expression_condition_checked(SemaCheckedCondition{condition: TIfCond.Plain{value: value}, value: value, bindings: [SemaConditionBinding]{}})
    if !sema_enter_source_nesting(check, span) -> return false
    unit: Expr.Unit{span: span, id: AST_NODE_GENERATED}
    checked: sema_stmt_check_unit_if_arms(condition, None, None, then_body, unit, else_body ?? [Stmt]{}, unit, span, return_type, check, loop_depth)
    if !checked.complete -> return false
    output.extend(checked.value)
    true
}

// Its statements are staged through the body comptime evaluator like a `#if`
// condition (sema_stmt_check_prep_if), reading the prepared locals before it;
// once the run lands, the owner body is checked again and the block leaves
// nothing behind. A failed check or a panic stops the build.
// False while the block is staged.
sema_stmt_check_comptime_block: fn(body: [Stmt], span: Span, check: ^SemaBodyCheck) -> Bool {
    if sema_runtime_policy_only(check.context.runtime_policy) {
        check.diagnostics.push(sema_runtime_only_build_time_diagnostic("This `#run` block runs its code", span))
        return false
    }
    if sema_comptime_body_value_find(check.context, check.environment.module_identity, sema_scope_function_owner_key(check.scopes), span, span) != None {
        return true
    }
    block: Expr.If{
        cond: Expr.Bool{value: true, span: span, id: AST_NODE_GENERATED},
        then_body: body,
        then_value: Expr.Unit{span: span, id: AST_NODE_GENERATED},
        else_body: [Stmt]{},
        else_value: Expr.Unit{span: span, id: AST_NODE_GENERATED},
        span: span,
        id: AST_NODE_GENERATED,
    }
    fact_start: check.context.call_facts.len()
    reference_start: check.context.name_references.len()
    check.scopes.comptime_execution_depth += 1
    checked: sema_check_expression(block, None, check)
    check.scopes.comptime_execution_depth -= 1
    checked_block: checked ?? return false
    if sema_stmt_comptime_site_refused(check, fact_start) -> return false
    if sema_comptime_reads_pending_local(check, reference_start) -> return false
    _ := sema_comptime_body_capture(check.context, check.environment.*, check.program.*, check.scopes, "comptime block", block, checked_block.ty, span, span)
    false
}

// `arena` holds the rows of the condition's flat nodes (sema_node).
sema_stmt_reads_runtime_local: fn(expression: TExpr, arena: BodyTree, found: ^Bool) Never! {
    if expression.kind == {
        .Local(_) -> {
            found = true
            return
        }
        .Flat(index) -> return sema_stmt_row_reads_runtime_local(arena, index, found)
        .IntLit(_, _) | .StrLit(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) -> {}
    }
    tree_each_expr_child(expression, fn(child: TExpr) { sema_stmt_reads_runtime_local(child, arena, found) })
}

sema_stmt_row_reads_runtime_local: fn(tree: BodyTree, index: Int, found: ^Bool) Never! {
    if tree.nodes[index - tree.node_base].kind == .Local(_) {
        found = true
        return
    }
    body_each_node_kind_child(tree, tree.nodes[index - tree.node_base].kind, fn(child: Int) { sema_stmt_row_reads_runtime_local(tree, child, found) })
}

sema_stmt_prep_if_not_bool: fn(cond_span: Span) -> Diagnostic {
    sema_error("E0989", cond_span, "a `#if` condition must be Bool, not another type", "the condition selects a branch at compile time — it must be true or false", "write a Bool known-time expression, like `#if flag {{ … }}`")
}

// The dropped arm is not a path through this code.
// It is walked for name resolution only: unknown names (E0107, E0102) are
// reported, and nothing else it reports or does survives it.
sema_stmt_check_dropped_prep_arm: fn(body: [Stmt], return_type: Type?, check: ^SemaBodyCheck, owner: String, loop_depth: Int) {
    scope_mark: sema_scope_mark(check.scopes)
    context_mark: sema_check_context_mark(check.context)
    fork: sema_ownership_fork(check.state)
    arm_diagnostics := [Diagnostic]{}
    sema_body_check_swap_diagnostics(check, arm_diagnostics)
    _ := sema_stmt_check_block(body, return_type, check, "{owner}.dropped", loop_depth)
    sema_body_check_swap_diagnostics(check, arm_diagnostics)
    sema_ownership_fork_rollback(check.state, fork)
    sema_ownership_fork_close(check.state, fork)
    sema_check_context_rollback(check.context, context_mark.move())
    sema_scope_rollback(check.scopes, scope_mark)
    loop diagnostic in arm_diagnostics {
        if diagnostic.code == "E0107" || diagnostic.code == "E0102" {
            check.diagnostics.push(diagnostic)
        }
    }
}

// `#run` on a type table or type test changes nothing: it is checked
// as the plain form (sema_stmt_check_switch).
sema_stmt_check_prep_type_table: fn(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span, return_type: Type?, check: ^SemaBodyCheck, loop_depth: Int, output: ^[TStmt]) -> Bool {
    table := sema_stmt_check_switch(subject, arms, else_body, span, return_type, check, loop_depth)
    loop statement in table.value -> output.push(statement)
    table.complete
}

// An OS target switch `#if #build.target.os == { .Linux -> … }` folds to the
// chain of `#if` arms whose conditions are whether the arm names this build's
// `#build.target.os`, as Bool literals, so the `#if` check selects the arm.
// Every arm head is a bare OS variant or an or-pattern of them
// (`.MacOS | .Windows`), no OS appears twice, and the arms name every OS
// whatever the target: `OS` is a closed set, so an `else` is E0641. A
// `#build.settings.<key>` dispatch folds against the declared setting's value
// (sema_stmt_check_setting_switch).
sema_stmt_check_prep_switch: fn(subject: Expr, arms: [SwitchArm], else_body: [Stmt]?, span: Span, return_type: Type?, check: ^SemaBodyCheck, loop_depth: Int, output: ^[TStmt]) -> Bool {
    // `#if T == { … }` over a type parameter is the
    // type table, which already keeps one arm per instance.
    if sema_stmt_type_switch_param(subject, check) != None {
        return sema_stmt_check_prep_type_table(subject, arms, else_body, span, return_type, check, loop_depth, output)
    }
    subject_span: expr_span(subject)
    path: sema_fact_expr_path(subject)
    if path != (Val("#build.target.os")) {
        if path == .Val(text) {
            if sema_fact_build_setting_key(text) == .Val(key) {
                setting: sema_fact_build_setting(key, subject_span, check.environment.*, check.program.*, check.diagnostics) ?? return false
                return sema_stmt_check_setting_switch(key, setting.value, arms, else_body, span, return_type, check, loop_depth, output)
            }
        }
        check.diagnostics.push(sema_error("E-OSTARGET-BUILD-CONTEXT", subject_span, "a `#if … == {{ … }}` dispatch branches on `#build.target.os`", "`#build.target.os` is the one compiler-known value this dispatch folds on — it selects the arm matching the build's target OS at compile time", "write `#if #build.target.os == {{ .Linux -> … }}` with an arm for every OS, or use a plain runtime `if` for a value that isn't known at compile time"))
        return false
    }
    active := ""
    // Snapshot: a lone program's check has no build facts to fold on.
    if check.program.registration_graph.mode == .Snapshot {
        sema_check_unsupported(check.context, "the `#if #build.target.os` dispatch at offset {span.start} has no build facts to fold on")
        return false
    }
    active = check.program.registration_graph.build_facts.os
    oses: loop os in TARGET_OS_ALL -> target_os_name(os)
    seen := [String]{}
    selects := [Bool]{}
    valid := true
    loop arm in arms {
        heads := [String]{}
        fresh := sema_stmt_os_dispatch_heads(arm.cond, heads)
        loop head in heads {
            if !oses.contains(head) || seen.contains(head) -> fresh = false
            seen.push(head)
        }
        if !fresh {
            check.diagnostics.push(sema_stmt_os_dispatch_arm(sema_stmt_os_dispatch_arm_head(arm.cond), arm.span))
            valid = false
            next
        }
        selects.push(heads.contains(active))
    }
    if !valid -> return false
    missing := [String]{}
    loop os in oses {
        if !seen.contains(os) -> missing.push(os)
    }
    if else_body != None {
        // E0641: the `else` stands for the OSes no arm names; the edit names them.
        if sema_coverage_else_arm_at(check.environment.*, span.start) == .Val(else_arm) {
            written: loop os in missing -> ".{os}"
            sema_coverage_report_closed_else(else_arm, "OS", false, written, check.diagnostics)
        }
    } else if missing.len() != 0 {
        list: missing.join(", ")
        check.diagnostics.push(sema_error("E-OSTARGET-DISPATCH-EXHAUSTIVE", span, "this `#build.target.os` dispatch doesn't cover every target OS — missing: {list}", "a build can target any OS of the list, native, web, Wasm or freestanding, so the dispatch must handle each one — otherwise a build for a missing OS would have no arm to run", "add an arm for each missing OS ({list}), or name several in one arm, such as `.Web | .Wasm -> …`"))
        return false
    }
    // Only an `else` arm: it always runs.
    if arms.len() == 0 {
        fallback: else_body ?? return true
        nested: sema_stmt_check_block(fallback, return_type, check, "prep-switch@{span.start}", loop_depth)
        if !nested.complete -> return false
        output.push(TStmt.Inline{body: nested.value, span: span})
        return true
    }
    // The nested chain below arm 0; each condition is whether the arm names `active`.
    tail := else_body
    index := arms.len()
    loop index > 1 {
        index -= 1
        arm: arms[index]
        node: Stmt.ComptimeIf{cond: Expr.Bool{value: selects[index], span: arm.span, id: AST_NODE_GENERATED}, cond_span: arm.span, then_body: arm.body, else_body: tail, span: arm.span, selected_then: None}
        tail = Val([Stmt]{node})
    }
    first: arms[0]
    sema_stmt_check_prep_if(Expr.Bool{value: selects[0], span: first.span, id: AST_NODE_GENERATED}, first.span, first.body, tail, first.span, return_type, check, loop_depth, output)
}

// Whether a setting dispatch arm head names `value`: a literal or `.Variant`
// the dispatch compares against (`true ->`, `8 ->`, `"eu" ->`, `.Fast ->`).
// None when the head is no value of the setting's kind.
sema_stmt_setting_arm_matches: fn(cond: Expr, value: TComptimeValue) -> Bool? Never! {
    if cond == {
        .Binary(op, _, right, _, _) -> {
            if op != BinOp.Eq -> return None
            if right == {
                .Bool(flag, _, _) -> {
                    if value == .Bool(held) -> return Val(flag == held)
                }
                .Int(number, _, _, _, _) -> {
                    if value == .Int(held) -> return Val(number == held)
                }
                .Char(text, _, _) -> {
                    if value == .Char(held) {
                        return Val((sema_checked_const_char(text) ?? -1) == held)
                    }
                }
                .Str(parts, _, _) -> {
                    if value == .String(held) {
                        if parts.len() == 0 -> return Val(held == "")
                        if parts.len() == 1 && parts[0] == .Lit(text) -> return Val(text == held)
                    }
                }
                .EnumLit(_, variant, _, args, _, _, _) -> {
                    if value == .Enum(_, held, _) {
                        if args.len() == 0 -> return Val(variant == held)
                    }
                }
                .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
            }
            None
        }
        .PatternTest(_, pattern, _, _) -> {
            if pattern == .Variant(variant, bindings, _, _) {
                if value == .Enum(_, held, _) {
                    if bindings.len() == 0 -> return Val(variant == held)
                }
            }
            None
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// `#if #build.settings.<key> == { … }`: each arm head is compared
// with the setting's value for this build, and the folded Bool conditions
// select the arm through the `#if` chain, as the `#build.target.os`
// dispatch does. Over an enum setting the table is over a closed set, so an
// `else` is E0641 (#6281); a Bool, number or text setting keeps its `else`.
sema_stmt_check_setting_switch: fn(key: String, value: TComptimeValue, arms: [SwitchArm], else_body: [Stmt]?, span: Span, return_type: Type?, check: ^SemaBodyCheck, loop_depth: Int, output: ^[TStmt]) -> Bool {
    matched := [Bool]{}
    valid := true
    loop arm in arms {
        if sema_stmt_setting_arm_matches(arm.cond, value) == .Val(flag) -> matched.push(flag) else {
            check.diagnostics.push(sema_error("E0302", arm.span, "this arm doesn't name a value of the setting `{key}`", "a `#build.settings.{key}` dispatch compares each arm head with the setting's value for this build", "write each arm head as a literal or `.Variant` of the setting's declared type"))
            valid = false
        }
    }
    if !valid -> return false
    if else_body != None -> sema_stmt_setting_switch_closed_else(value, arms, span, check)
    if arms.len() == 0 {
        fallback: else_body ?? return true
        nested: sema_stmt_check_block(fallback, return_type, check, "prep-switch@{span.start}", loop_depth)
        if !nested.complete -> return false
        output.push(TStmt.Inline{body: nested.value, span: span})
        return true
    }
    tail := else_body
    index := arms.len()
    loop index > 1 {
        index -= 1
        arm: arms[index]
        node: Stmt.ComptimeIf{cond: Expr.Bool{value: matched[index], span: arm.span, id: AST_NODE_GENERATED}, cond_span: arm.span, then_body: arm.body, else_body: tail, span: arm.span, selected_then: None}
        tail = Val([Stmt]{node})
    }
    first: arms[0]
    sema_stmt_check_prep_if(Expr.Bool{value: matched[0], span: first.span, id: AST_NODE_GENERATED}, first.span, first.body, tail, first.span, return_type, check, loop_depth, output)
}

// E0641: the variants of an enum setting that a dispatch's `else` stands for.
sema_stmt_setting_switch_closed_else: fn(value: TComptimeValue, arms: [SwitchArm], span: Span, check: ^SemaBodyCheck) {
    type_name := ""
    if value == .Enum(held_type, _, _) -> type_name = held_type
    if type_name == "" {
        return
    }
    ty: Type.Named{name: type_name}
    if !sema_coverage_is_closed_set(ty, check) {
        return
    }
    else_arm: sema_coverage_else_arm_at(check.environment.*, span.start) ?? return
    named := [String]{}
    loop arm in arms {
        if sema_stmt_setting_arm_variant(arm.cond) == .Val(variant) -> named.push(variant)
    }
    patterns := [String]{}
    loop name in sema_coverage_missing(ty, named, check) {
        patterns.push(sema_coverage_case_pattern(ty, name, check) ?? ".{name}")
    }
    sema_coverage_report_closed_else(else_arm, type_name, false, patterns, check.diagnostics)
}

// The variant a setting dispatch arm names, written `.Fast` or `== .Fast`.
sema_stmt_setting_arm_variant: fn(cond: Expr) -> String? {
    if cond == .PatternTest(_, pattern, _, _) {
        if pattern == .Variant(variant, _, _, _) -> return Val(variant.copy())
    }
    if cond == .Binary(_, _, right, _, _) {
        if right == .EnumLit(_, variant, _, _, _, _, _) -> return Val(variant.copy())
    }
    None
}

sema_stmt_os_dispatch_arm: fn(found: String, span: Span) -> Diagnostic {
    sema_error("E-OSTARGET-DISPATCH-ARM", span, "`{found}` is not an OS arm — a `#build.target.os` dispatch arm names OSes of the `OS` list, such as `.Linux` or `.Web | .Wasm`", "each arm gates code for the OSes it names, so its head is a bare, payload-free OS variant or an or-pattern of them — the same list `#Target(OS.*)` uses — and each OS appears at most once", "name each OS in one arm, such as `.Linux -> …` or `.Web | .Wasm -> …`")
}

// The OSes a `#build.target.os` arm head names into `heads`: a bare `.Linux`
// or an or-pattern of them (`.MacOS | .Windows`). False for any other head.
sema_stmt_os_dispatch_heads: fn(cond: Expr, heads: ^[String]) -> Bool {
    if cond == .PatternTest(_, pattern, _, _) {
        return sema_stmt_os_dispatch_pattern_heads(pattern, heads)
    }
    false
}

sema_stmt_os_dispatch_pattern_heads: fn(pattern: Pattern, heads: ^[String]) -> Bool {
    if pattern == {
        .Variant(name, bindings, _, _) -> {
            if bindings.len() != 0 -> return false
            heads.push(name.copy())
            true
        }
        .Or(alternatives, _) -> {
            loop alternative in alternatives {
                if !sema_stmt_os_dispatch_pattern_heads(alternative, heads) -> return false
            }
            true
        }
        .Present(_, _, _, _) | .Absent(_) | .Ok(_, _, _, _) | .Err(_, _, _, _) | .Range(_, _, _) | .Struct(_, _, _, _) | .List(_, _, _) | .Map(_, _, _) | .StrMatch(_, _) | .BinMatch(_, _) -> false
    }
}

// A short display of a refused `#build.target.os` arm head.
sema_stmt_os_dispatch_arm_head: fn(cond: Expr) -> String Never! {
    if cond == .PatternTest(_, pattern, _, _) {
        if pattern == .Variant(variant, _, _, _) -> return ".{variant}"
        return "this pattern"
    }
    "this arm head"
}
