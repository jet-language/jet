// Rust: crates/jet-sema/src/Sema/CheckerInfer/mod.rs:84
pub fn exact_integer_literal(value: Int, raw: String?) -> CtBigInt {
    raw.and_then((raw) -> CtBigInt.from_literal(raw).ok()).unwrap_or_else(() -> CtBigInt.from_int(value))
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/mod.rs:89
pub fn exact_integer_fits(value: CtBigInt, lo: I128, hi: I128) -> Bool {
    lower :: CtBigInt.from_literal(lo.to_string()).expect("i128 bounds are valid integer literals")
    upper :: CtBigInt.from_literal(hi.to_string()).expect("i128 bounds are valid integer literals")
    value.compare(lower) != Ordering.Less && value.compare(upper) != Ordering.Greater
}
