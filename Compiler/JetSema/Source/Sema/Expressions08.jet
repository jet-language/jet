// Rust: crates/jet-sema/src/Sema/CheckerInfer/mod.rs:73
pub fn integer_width_interval(signed: Bool, bits: U8) -> IntegerInterval {
    IntegerInterval.from_bounds(Type.IntN{signed: signed, bits: bits}.integer_range().expect("fixed integer widths carry an interval fact"))
