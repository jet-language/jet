// Published-schema diff and migration expression desugaring. Field order is not a break.
use jet_foundation.[Diagnostic, Span, AccessConvention, Expr, Func, Item, LambdaBody, MigrationOp, Param, ProgramBundle, Stmt, Type, StructDef, CallArg, CallArgFlags, ParamZone, mangle]
use jet_foundation.Syntax as Syntax
use jet_sema.Generics.[DECODE, ENCODE]
use jet_sema.Traits.[TraitRegistry]
use jet_sema.Sema.[error_conv_fn_name]
use jet_sema.Sema.Schema.[load_snapshot]
use jet_sema.Sema.CheckerCoreLib.[is_decodable_ty]
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:42
fn converter_fn_name(type_name: String, block_idx: Int, field: String) -> String Never! { mangle("migrate_conv_{type_name}_{block_idx}_{field}") }
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:49
fn add_default_fn_name(type_name: String, block_idx: Int, field: String) -> String Never! { mangle("migrate_add_{type_name}_{block_idx}_{field}") }
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:64
pub fn desugar_migrations(bundle: &ProgramBundle) Never! {
    loop &module in &bundle.modules {
        auto_derives :: TraitRegistry.auto_derives_for_items(module.items)
        decodable_published := [String:Bool]{}
        loop item in module.items {
            if item == .Struct(s) {
                published :: s.is_published_schema || s.derives.any(fn(row) { row.0 == Syntax.MARKER_PUBLISHED_SCHEMA })
                if published && s.type_params.is_empty() && (s.derives.any(fn(row) { row.0 == DECODE }) || auto_derives.auto_decode.contains(s.name)) -> decodable_published[s.name] = true
            }
        }
        if decodable_published.is_empty() -> next
        // GATE #4499: exact tuple equality/hash for conversion pairs.
        conversions := [(String, String):Bool]{}
        loop item in module.items {
            if item == .ErrorConv(conversion) -> conversions[(conversion.from_ty, conversion.to_ty)] = true
        }
        block_of_type := [String:Int]{}
        synthetic := [Item]{}
        loop &item in &module.items {
            if item == .Migration(m) {
                if !decodable_published.contains(m.type_name) -> next
                block_idx :: block_of_type.get(m.type_name) ?? 0
                block_of_type[m.type_name] = block_idx + 1
                loop &op in &m.ops {
                    if op == {
                        .Change{field, from_ty, to_ty, converter: .Val(conv), converter_span, conv_fn, ..} -> {
                            name :: converter_fn_name(m.type_name, block_idx, field)
                            span :: converter_span ?? m.span
                            &synthetic.push(Item.Func(build_converter_func(name, from_ty, to_ty, conv, span)))
                            conv_fn = Val(name)
                        }
                        .Change{from_ty, to_ty, converter: .None, conv_fn, ..} -> {
                            from :: from_ty.name()
                            to :: to_ty.name()
                            if conversions.contains((from, to)) -> conv_fn = Val(error_conv_fn_name(from, to))
                        }
                        .Add{field, ty, default, default_span, default_fn, ..} -> {
                            name :: add_default_fn_name(m.type_name, block_idx, field)
                            &synthetic.push(Item.Func(build_default_func(name, ty, default, default_span)))
                            default_fn = Val(name)
                        }
                        else -> {}
                    }
                }
            }
        }
        &module.items.extend(^synthetic)
    }
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:170
fn build_default_func(name: String, ty: Type, default: Expr, span: Span) -> Func Never! {
    Func{
        span: span, is_pub: false, is_comptime: false, is_package_pub: false, external_type: None,
        name: name, name_span: span, meta: None, type_params: [], head_pattern: None, params: [],
        return_type: Val(ty), return_type_span: Val(span), return_view_provenance: None, declared_return_view_provenance: None,
        gc_return: false, diverges: false, gc_scope: false, is_unsafe: false, unsafe_reason: None, unsafe_span: None,
        is_pure: false, is_reactive: false, reactive_upgrades: [], is_replayable: false, replayable_span: None,
        is_job: false, job_span: None, every: None, job_metadata: None, is_must_use: false, must_use_span: None,
        maturity: None, maturity_span: None, kernel: None, is_inline: false, is_inline_always: false, inline_span: None,
        is_sanitizer: false, scrub_tag: None, declared_effects: None, effect_via: None, state_requires: None, state_transition: None,
        web_marker: None, pre: [], post: [], inline_foreign: None, undo: None, markers: [], compiler_generated: false,
        body: [Stmt.Return(Val(~default), span)]
    }
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:231
fn build_converter_func(name: String, old_ty: Type, new_ty: Type, conv: Expr, span: Span) -> Func Never! {
    param_name := "__old"
    body := [Stmt]{}
    if conv == .Lambda(lambda) && lambda.params.len() == 1 {
        param_name = lambda.params[0].name
        if lambda.body == {
            .Expr(expression) -> &body.push(Stmt.Return(Val(~expression), span))
            .Block(statements) -> body = ~statements
        }
    } else {
        arg :: CallArg{convention: AccessConvention.Move, expr: Expr.Ident("__old", span), span: span, flags: CallArgFlags.default(), label: None, spread: false}
        call :: Expr.CallValue{callee: ~conv, args: [arg], span: span}
        &body.push(Stmt.Return(Val(call), span))
    }
    Func{
        span: span, is_pub: false, is_comptime: false, is_package_pub: false, external_type: None,
        name: name, name_span: span, meta: None, type_params: [], head_pattern: None,
        params: [Param{name: param_name, name_span: span, ty: ~old_ty, ty_span: span, convention: AccessConvention.Move, root: false, default: None, variadic: false, variadic_bound_list: None, declared_view_from_names: None, public_label: None, zone: ParamZone.Either}],
        return_type: Val(new_ty), return_type_span: Val(span), return_view_provenance: None, declared_return_view_provenance: None,
        gc_return: false, diverges: false, gc_scope: false, is_unsafe: false, unsafe_reason: None, unsafe_span: None,
        is_pure: false, is_reactive: false, reactive_upgrades: [], is_replayable: false, replayable_span: None,
        is_job: false, job_span: None, every: None, job_metadata: None, is_must_use: false, must_use_span: None,
        maturity: None, maturity_span: None, kernel: None, is_inline: false, is_inline_always: false, inline_span: None,
        is_sanitizer: false, scrub_tag: None, declared_effects: None, effect_via: None, state_requires: None, state_transition: None,
        web_marker: None, pre: [], post: [], inline_foreign: None, undo: None, markers: [], compiler_generated: false,
        body: ^body
    }
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:330
enum DeclaredOp {
    Rename(from: String, to: String)
    Add(field: String, ty: String)
    Remove(field: String)
    Change(field: String, from_ty: String, to_ty: String, has_converter: Bool)
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:354
fn is_decode_only(s: StructDef, reg: TraitRegistry) -> Bool Never! {
    decode :: s.derives.any(fn(row) { row.0 == DECODE }) || reg.auto_decode.contains(s.name)
    encode :: s.derives.any(fn(row) { row.0 == ENCODE }) || reg.auto_encode.contains(s.name)
    decode && !encode
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:365
pub fn check_schema_migrations(items: [Item], project_root: OSPath, reg: TraitRegistry) -> [Diagnostic] -[Env, FS.Read]> {
    diags := [Diagnostic]{}
    migrations := [String:[DeclaredOp]]{}
    loop item in items {
        if item == .Migration(m) {
            if !migrations.contains(m.type_name) -> migrations[m.type_name] = []
            loop op in m.ops {
                declared :: if op == {
                    .Rename{from, to, ..} -> DeclaredOp.Rename(from, to)
                    .Add{field, ty, ..} -> DeclaredOp.Add(field, ty.name())
                    .Remove{field, ..} -> DeclaredOp.Remove(field)
                    .Change{field, from_ty, to_ty, converter, ..} -> DeclaredOp.Change(field, from_ty.name(), to_ty.name(), converter != None)
                }
                &migrations[m.type_name].push(declared)
            }
        }
    }
    conv_impls := [(String, String)]{}
    loop item in items { if item == .ErrorConv(ec) -> &conv_impls.push((ec.from_ty, ec.to_ty)) }
    loop item in items {
        if item != .Struct(s) -> next
        published :: s.is_published_schema || s.derives.any(fn(row) { row.0 == Syntax.MARKER_PUBLISHED_SCHEMA })
        if !published -> next
        prior :: load_snapshot(project_root, s.name) ?? next
        span :: s.published_schema_span ?? s.name_span
        new_fields := [String:String]{}
        loop field in s.fields -> new_fields[field.name] = field.ty.name()
        old_fields := [String:String]{}
        loop field in prior.fields -> old_fields[field.name] = field.ty
        ops :: migrations.get(s.name) ?? []
        loop op in ops {
            if op == {
                .Remove(field) -> {
                    if new_fields.contains(field) -> &diags.push(e0910_remove_still_present(s.name, field, span))
                    else if !old_fields.contains(field) -> &diags.push(e0910_op_unknown_field(s.name, field, "remove", span))
                }
                .Add(field, ty) -> {
                    if old_fields.contains(field) -> &diags.push(e0910_add_not_new(s.name, field, span))
                    else if new_fields.get(field) == .Val(new_ty) {
                        if new_ty != ty -> &diags.push(e0910_add_type_mismatch(s.name, field, ty, new_ty, span))
                        else if is_decode_only(s, reg) {
                            if s.fields.find(fn(f) { f.name == field }) == .Val(added_field) {
                                if !is_decodable_ty(added_field.ty, reg) -> &diags.push(e0910_add_field_not_decodable(s.name, field, new_ty, span))
                            }
                        }
                    } else -> &diags.push(e0910_op_unknown_field(s.name, field, "add", span))
                }
                .Change(field, from_ty, to_ty, _) -> {
                    if (old_fields.get(field), new_fields.get(field)) == {
                        (.Val(old_ty), .Val(new_ty)) -> {
                            if old_ty != from_ty || new_ty != to_ty -> &diags.push(e0910_change_type_mismatch(s.name, field, from_ty, to_ty, old_ty, new_ty, span))
                        }
                        else -> &diags.push(e0910_op_unknown_field(s.name, field, "change", span))
                    }
                }
                .Rename(..) -> {}
            }
        }
        loop old_field in prior.fields {
            if new_fields.contains(old_field.name) -> next
            renamed :: ops.any(fn(op) { if op == { .Rename(from, to) -> from == old_field.name && (new_fields.get(to).map(fn(ty) { ty == old_field.ty }) ?? false); else -> false } })
            removed :: ops.any(fn(op) { if op == { .Remove(field) -> field == old_field.name; else -> false } })
            if renamed || removed -> next
            &diags.push(e0910_dropped(s.name, old_field.name, prior.published_version, span))
        }
        loop f in s.fields {
            old_ty :: old_fields.get(f.name) ?? next
            new_ty :: f.ty.name()
            if old_ty == new_ty -> next
            change_op :: ops.find_map(fn(op) { if op == { .Change(field, from_ty, to_ty, has_converter) -> if field == f.name && from_ty == old_ty && to_ty == new_ty -> Val(has_converter) else -> None; else -> None } })
            if change_op == {
                .Val(true) -> {}
                .Val(false) -> {
                    has_impl :: conv_impls.any(fn(pair) { pair.0 == old_ty && pair.1 == new_ty })
                    if !has_impl -> &diags.push(e0910_change_no_converter(s.name, f.name, old_ty, new_ty, span))
                }
                .None -> &diags.push(e0910_changed_type(s.name, f.name, old_ty, new_ty, span))
            }
        }
        loop f in s.fields {
            if old_fields.contains(f.name) -> next
            from_rename :: ops.any(fn(op) { if op == { .Rename(_, to) -> to == f.name; else -> false } })
            added :: ops.any(fn(op) { if op == { .Add(field, _) -> field == f.name; else -> false } })
            if from_rename || added -> next
            &diags.push(e0910_added_required(s.name, f.name, span))
        }
    }
    diags
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:620
fn e0910_dropped(type_name: String, field: String, version: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0910", "the published record `{type_name}` dropped `{field}` since version `{version}`, with no migration to bridge it", "`#PublishedSchema` pins a record's saved shape at release; old data written with `{field}` could no longer be read", "add `migration {type_name} {{ remove {field} }}` to delete it, `migration {type_name} {{ rename {field} -> <new> }}` if you renamed it, or bump the major version", Val(span))
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:640
fn e0910_changed_type(type_name: String, field: String, old_ty: String, new_ty: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0910", "the published record `{type_name}` changed `{field}` from `{old_ty}` to `{new_ty}`, with no migration to bridge it", "`#PublishedSchema` pins a record's saved shape at release; old data stored at the previous type could no longer be read", "add `migration {type_name} {{ change {field}: {old_ty} -> {new_ty} via {{ (old) -> … }} }}`, or bump the major version", Val(span))
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:664
fn e0910_change_no_converter(type_name: String, field: String, old_ty: String, new_ty: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0910", "the `change {field}: {old_ty} -> {new_ty}` migration on `{type_name}` has no converter", "a type change needs a way to turn an old value into a new one — old data already on disk is read through it", "add an inline `via {{ (old) -> … }}` to the `change` op, or declare `impl {old_ty} -> {new_ty} {{ … }}` in scope", Val(span))
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:687
fn e0910_added_required(type_name: String, field: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0910", "the published record `{type_name}` added `{field}`, but old data has no value for it", "`#PublishedSchema` records already written without this field can't be read unless there's a default to fill it in", "add `migration {type_name} {{ add {field}: <Type> = <default> }}` to supply the value, or bump the major version", Val(span))
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:704
fn e0910_remove_still_present(type_name: String, field: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0910", "the migration removes `{field}`, but `{type_name}` still has that field", "a `remove` op declares a field is gone, but the current `#PublishedSchema` struct still defines it", "delete the field from `struct {type_name}`, or drop the `remove {field}` line", Val(span))
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:718
fn e0910_add_not_new(type_name: String, field: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0910", "the migration adds `{field}`, but `{type_name}` already had that field", "an `add` op declares a brand-new field, but the prior published snapshot already records this one", "drop the `add {field}` line; if its type changed, use `change` instead", Val(span))
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:732
fn e0910_change_type_mismatch(type_name: String, field: String, decl_from: String, decl_to: String, real_from: String, real_to: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0910", "the `change {field}: {decl_from} -> {decl_to}` migration on `{type_name}` doesn't match the real shapes (`{real_from}` -> `{real_to}`)", "the `from` type must be the field's published type and the `to` type must be its current type", "write `change {field}: {real_from} -> {real_to} …`", Val(span))
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:754
fn e0910_add_type_mismatch(type_name: String, field: String, decl_ty: String, real_ty: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0910", "the `add {field}: {decl_ty}` migration on `{type_name}` declares a type the field doesn't have (`{real_ty}`)", "the type in an `add` op must match the field's type in the struct", "write `add {field}: {real_ty} = <default>`", Val(span))
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:777
fn e0910_add_field_not_decodable(type_name: String, field: String, ty: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0910", "the `add {field}: {ty}` migration on `{type_name}` needs `{ty}` to support `Decode`", "`{type_name}` derives `Decode` but not `Encode` — it only ever reads data back, so every field, including one added by a migration, must itself be decodable", "derive `Decode` on `{ty}`, or give `{field}` a decodable type", Val(span))
}
// Rust: crates/jet-sema/src/Sema/SchemaMigration.rs:794
fn e0910_op_unknown_field(type_name: String, field: String, verb: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0910", "the `{verb} {field}` migration on `{type_name}` names a field that doesn't exist", "a migration op must reference a field of this record — either its published shape or its current one", "check the spelling of `{field}`, or remove the `{verb}` op", Val(span))
}
