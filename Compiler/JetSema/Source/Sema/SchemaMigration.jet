//RS /// E0910: a published field was dropped with no migration to bridge it.
//RS fn e0910_dropped(type_name: &str, field: &str, version: &str, span: Span) -> Diagnostic {
//RS     Diagnostic::error(
//RS         "E0910",
//RS         format!(
//RS             "the published record `{}` dropped `{}` since version `{}`, with no migration to bridge it",
//RS             type_name, field, version
//RS         ),
//RS         format!(
//RS             "`#PublishedSchema` pins a record's saved shape at release; old data written with `{}` could no longer be read",
//RS             field
//RS         ),
//RS         format!(
//RS             "add `migration {} {{ remove {} }}` to delete it, `migration {} {{ rename {} -> <new> }}` if you renamed it, or bump the major version",
//RS             type_name, field, type_name, field
//RS         ),
//RS         Some(span),
//RS     )
//RS }
//RS 
//RS /// E0910: a published field changed type, with no `change` op declaring intent.
//RS fn e0910_changed_type(
//RS     type_name: &str,
//RS     field: &str,
//RS     old_ty: &str,
//RS     new_ty: &str,
//RS     span: Span,
//RS ) -> Diagnostic {
//RS     Diagnostic::error(
//RS         "E0910",
//RS         format!(
//RS             "the published record `{}` changed `{}` from `{}` to `{}`, with no migration to bridge it",
//RS             type_name, field, old_ty, new_ty
//RS         ),
//RS         "`#PublishedSchema` pins a record's saved shape at release; old data stored at the previous type could no longer be read".to_string(),
//RS         format!(
//RS             "add `migration {} {{ change {}: {} -> {} via {{ (old) -> … }} }}`, or bump the major version",
//RS             type_name, field, old_ty, new_ty
//RS         ),
//RS         Some(span),
//RS     )
//RS }
//RS 
//RS /// E0910: a `change` op is declared but no converter (neither inline `via` nor
//RS /// an `impl Old -> New` in scope) is available.
//RS fn e0910_change_no_converter(
//RS     type_name: &str,
//RS     field: &str,
//RS     old_ty: &str,
//RS     new_ty: &str,
//RS     span: Span,
//RS ) -> Diagnostic {
//RS     Diagnostic::error(
//RS         "E0910",
//RS         format!(
//RS             "the `change {}: {} -> {}` migration on `{}` has no converter",
//RS             field, old_ty, new_ty, type_name
//RS         ),
//RS         "a type change needs a way to turn an old value into a new one — old data already on disk is read through it".to_string(),
//RS         format!(
//RS             "add an inline `via {{ (old) -> … }}` to the `change` op, or declare `impl {} -> {} {{ … }}` in scope",
//RS             old_ty, new_ty
//RS         ),
//RS         Some(span),
//RS     )
//RS }
//RS 
//RS /// E0910: a new field was added with nothing for old data to supply.
