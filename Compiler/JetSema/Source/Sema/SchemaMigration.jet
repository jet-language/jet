//RS             field, decl_from, decl_to, type_name, real_from, real_to
//RS         ),
//RS         "the `from` type must be the field's published type and the `to` type must be its current type".to_string(),
//RS         format!("write `change {}: {} -> {} …`", field, real_from, real_to),
//RS         Some(span),
//RS     )
//RS }
//RS 
//RS /// E0910: an `add f: T` op's declared type doesn't match the struct field's type.
//RS fn e0910_add_type_mismatch(
//RS     type_name: &str,
//RS     field: &str,
//RS     decl_ty: &str,
//RS     real_ty: &str,
//RS     span: Span,
//RS ) -> Diagnostic {
//RS     Diagnostic::error(
//RS         "E0910",
//RS         format!(
//RS             "the `add {}: {}` migration on `{}` declares a type the field doesn't have (`{}`)",
//RS             field, decl_ty, type_name, real_ty
//RS         ),
//RS         "the type in an `add` op must match the field's type in the struct".to_string(),
//RS         format!("write `add {}: {} = <default>`", field, real_ty),
//RS         Some(span),
//RS     )
//RS }
//RS 
//RS /// E0910: an `add f: T` op on a Decode-only `#PublishedSchema` record names a
//RS /// type `T` that doesn't itself satisfy `Decode`. A Decode-only record only
//RS /// ever deserializes; a field it can't decode would make the generated
//RS /// `decode` impl call a decoder that doesn't exist for `T`.
//RS fn e0910_add_field_not_decodable(type_name: &str, field: &str, ty: &str, span: Span) -> Diagnostic {
//RS     Diagnostic::error(
//RS         "E0910",
//RS         format!(
//RS             "the `add {}: {}` migration on `{}` needs `{}` to support `Decode`",
//RS             field, ty, type_name, ty
//RS         ),
//RS         format!(
//RS             "`{}` derives `Decode` but not `Encode` — it only ever reads data back, so every field, including one added by a migration, must itself be decodable",
//RS             type_name
//RS         ),
//RS         format!("derive `Decode` on `{}`, or give `{}` a decodable type", ty, field),
//RS         Some(span),
//RS     )
//RS }
//RS 
//RS /// E0910: an `add`/`remove`/`change` op names a field that's in neither shape.
//RS fn e0910_op_unknown_field(type_name: &str, field: &str, verb: &str, span: Span) -> Diagnostic {
