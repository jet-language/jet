// D-MIGRATE1/2: Rust SchemaMigration.rs's E0910 diff, independent of I/O.
// None is the status command's deliberately empty advisory registry; builds
// supply the canonical populated scope environment after type registration.
use jet_foundation.[Diagnostic, Item, MigrationOp, Span, StructDef, Type, type_name]

fn sema_schema_published(definition: StructDef) -> Bool Never! {
    if definition.is_published_schema -> return true
    loop derivation in definition.derives { if derivation.name == "PublishedSchema" -> return true }
    false
}

fn sema_schema_codec(definition: StructDef, codec: String, environment: SemaScopeEnvironment?, program: SemaProgramTables) -> Bool Never! {
    if environment == .Val(scope) {
        checked :: sema_serde_type_definition(scope, program, definition.name) ?? return false
        direction :: if codec == "Decode" -> SemaSerdeDirection.Decode else -> SemaSerdeDirection.Encode
        return sema_serde_implementation(scope, program, checked, direction)
    }
    loop derivation in definition.derives { if derivation.name == codec -> return true }
    false
}

fn sema_schema_decodable(ty: Type, environment: SemaScopeEnvironment?, program: SemaProgramTables) -> Bool Never! {
    if environment == .Val(scope) {
        return sema_serde_type_is_admissible(scope, program, ty, SemaSerdeDirection.Decode)
    }
    // Empty TraitRegistry trusts named types, but still rejects structural
    // types for which no decoder exists (CmdSchema.rs's advisory contract).
    if ty == {
        .Named(_) -> true
        .Int | .Float | .Bool | .String | .Char | .Float32 | .IntN(_, _) -> true
        .List(inner) | .Option(inner) | .Shared(inner) | .FixedList(inner, _) -> sema_schema_decodable(inner, None, program)
        .Map(key, _, value) -> key == Type.String && sema_schema_decodable(value, None, program)
        .Union(members) -> {
            loop member in members { if !sema_schema_decodable(member, None, program) -> return false }
            true
        }
        else -> false
    }
}

fn check_schema_migrations(items: [Item], snapshots: [String:SchemaSnapshot], environment: SemaScopeEnvironment?, program: SemaProgramTables) -> [Diagnostic] Never! {
    diagnostics := [Diagnostic]{}
    migrations := [String:[MigrationOp]]{}
    conversions := [(from_ty: String, to_ty: String)]{}
    loop item in items {
        if item == {
            .Migration(migration) -> {
                operations := migrations.get(migration.type_name) ?? [MigrationOp]{}
                loop operation in migration.ops -> &operations.push(operation)
                migrations[migration.type_name] = ^operations
            }
            .ErrorConv(conversion) -> &conversions.push((from_ty: conversion.from_ty, to_ty: conversion.to_ty))
            else -> {}
        }
    }
    loop item in items {
        if item == .Struct(definition) {
            if !sema_schema_published(definition) -> next
            baseline :: snapshots.get(definition.name) ?? next
            span :: definition.published_schema_span ?? definition.name_span
            current := [String:String]{}
            old := [String:String]{}
            loop field in definition.fields -> current[field.name] = type_name(field.ty)
            loop field in baseline.fields -> old[field.name] = field.ty
            operations :: migrations.get(definition.name) ?? [MigrationOp]{}
            name :: definition.name
            loop operation in operations {
                if operation == {
                    .Remove(field, _) -> {
                        if {
                            current.get(field) != None -> &diagnostics.push(sema_schema_remove_present(name, field, span))
                            old.get(field) == None -> &diagnostics.push(sema_schema_unknown(name, field, "remove", span))
                        }
                    }
                    .Add(field, _, ty, _, _, _, _) -> {
                        declared :: type_name(ty)
                        if {
                            old.get(field) != None -> &diagnostics.push(sema_schema_add_old(name, field, span))
                            current.get(field) == .Val(actual) -> {
                                if {
                                    actual != declared -> &diagnostics.push(sema_schema_add_mismatch(name, field, declared, actual, span))
                                    sema_schema_codec(definition, "Decode", environment, program) && !sema_schema_codec(definition, "Encode", environment, program) -> {
                                        loop added in definition.fields {
                                            if added.name == field && !sema_schema_decodable(added.ty, environment, program) -> &diagnostics.push(sema_schema_add_decode(name, field, actual, span))
                                        }
                                    }
                                }
                            }
                            else -> &diagnostics.push(sema_schema_unknown(name, field, "add", span))
                        }
                    }
                    .Change(field, _, from, _, to, _, _, _, _) -> {
                        old_type :: old.get(field)
                        new_type :: current.get(field)
                        if {
                            old_type == .Val(old_ty) -> {
                                if {
                                    new_type == .Val(new_ty) -> {
                                        declared_from :: type_name(from)
                                        declared_to :: type_name(to)
                                        if old_ty != declared_from || new_ty != declared_to -> &diagnostics.push(sema_schema_change_mismatch(name, field, declared_from, declared_to, old_ty, new_ty, span))
                                    }
                                    else -> &diagnostics.push(sema_schema_unknown(name, field, "change", span))
                                }
                            }
                            else -> &diagnostics.push(sema_schema_unknown(name, field, "change", span))
                        }
                    }
                    .Rename(_, _, _, _) -> {}
                }
            }
            loop field in baseline.fields {
                if current.get(field.name) != None -> next
                bridged := false
                loop operation in operations {
                    if operation == {
                        .Rename(from, _, to, _) -> {
                            if current.get(to) == .Val(actual) {
                                if from == field.name && actual == field.ty -> bridged = true
                            }
                        }
                        .Remove(removed, _) -> {
                            if removed == field.name -> bridged = true
                        }
                        else -> {}
                    }
                }
                if !bridged -> &diagnostics.push(sema_schema_dropped(name, field.name, baseline.published_version, span))
            }
            loop field in definition.fields {
                old_ty :: old.get(field.name) ?? next
                new_ty :: type_name(field.ty)
                if old_ty == new_ty -> next
                converter := Bool?{None}
                loop operation in operations {
                    if operation == .Change(changed, _, from, _, to, _, via, _, _) {
                        if changed == field.name && type_name(from) == old_ty && type_name(to) == new_ty {
                            converter = Val(via != None)
                            break
                        }
                    }
                }
                if converter == {
                    .Val(has_converter) -> {
                        if !has_converter {
                            has_impl := false
                            loop conversion in conversions { if conversion.from_ty == old_ty && conversion.to_ty == new_ty -> has_impl = true }
                            if !has_impl -> &diagnostics.push(sema_schema_no_converter(name, field.name, old_ty, new_ty, span))
                        }
                    }
                    .None -> &diagnostics.push(sema_schema_changed(name, field.name, old_ty, new_ty, span))
                }
            }
            loop field in definition.fields {
                if old.get(field.name) != None -> next
                supplied := false
                loop operation in operations {
                    if operation == {
                        .Rename(_, _, to, _) -> {
                            if to == field.name -> supplied = true
                        }
                        .Add(added, _, _, _, _, _, _) -> {
                            if added == field.name -> supplied = true
                        }
                        else -> {}
                    }
                }
                if !supplied -> &diagnostics.push(sema_schema_added(name, field.name, span))
            }
        }
    }
    diagnostics
}

fn sema_schema_dropped(name: String, field: String, version: String, span: Span) -> Diagnostic Never! {
    sema_error("E0910", span, "the published record `{name}` dropped `{field}` since version `{version}`, with no migration to bridge it", "`#PublishedSchema` pins a record's saved shape at release; old data written with `{field}` could no longer be read", "add `migration {name} {{ remove {field} }}` to delete it, `migration {name} {{ rename {field} -> <new> }}` if you renamed it, or bump the major version")
}
fn sema_schema_changed(name: String, field: String, old: String, current: String, span: Span) -> Diagnostic Never! {
    sema_error("E0910", span, "the published record `{name}` changed `{field}` from `{old}` to `{current}`, with no migration to bridge it", "`#PublishedSchema` pins a record's saved shape at release; old data stored at the previous type could no longer be read", "add `migration {name} {{ change {field}: {old} -> {current} via {{ (old) -> … }} }}`, or bump the major version")
}
fn sema_schema_no_converter(name: String, field: String, old: String, current: String, span: Span) -> Diagnostic Never! {
    sema_error("E0910", span, "the `change {field}: {old} -> {current}` migration on `{name}` has no converter", "a type change needs a way to turn an old value into a new one — old data already on disk is read through it", "add an inline `via {{ (old) -> … }}` to the `change` op, or declare `impl {old} -> {current} {{ … }}` in scope")
}
fn sema_schema_added(name: String, field: String, span: Span) -> Diagnostic Never! {
    sema_error("E0910", span, "the published record `{name}` added `{field}`, but old data has no value for it", "`#PublishedSchema` records already written without this field can't be read unless there's a default to fill it in", "add `migration {name} {{ add {field}: <Type> = <default> }}` to supply the value, or bump the major version")
}
fn sema_schema_remove_present(name: String, field: String, span: Span) -> Diagnostic Never! {
    sema_error("E0910", span, "the migration removes `{field}`, but `{name}` still has that field", "a `remove` op declares a field is gone, but the current `#PublishedSchema` struct still defines it", "delete the field from `struct {name}`, or drop the `remove {field}` line")
}
fn sema_schema_add_old(name: String, field: String, span: Span) -> Diagnostic Never! {
    sema_error("E0910", span, "the migration adds `{field}`, but `{name}` already had that field", "an `add` op declares a brand-new field, but the prior published snapshot already records this one", "drop the `add {field}` line; if its type changed, use `change` instead")
}
fn sema_schema_change_mismatch(name: String, field: String, from: String, to: String, old: String, current: String, span: Span) -> Diagnostic Never! {
    sema_error("E0910", span, "the `change {field}: {from} -> {to}` migration on `{name}` doesn't match the real shapes (`{old}` -> `{current}`)", "the `from` type must be the field's published type and the `to` type must be its current type", "write `change {field}: {old} -> {current} …`")
}
fn sema_schema_add_mismatch(name: String, field: String, declared: String, actual: String, span: Span) -> Diagnostic Never! {
    sema_error("E0910", span, "the `add {field}: {declared}` migration on `{name}` declares a type the field doesn't have (`{actual}`)", "the type in an `add` op must match the field's type in the struct", "write `add {field}: {actual} = <default>`")
}
fn sema_schema_add_decode(name: String, field: String, ty: String, span: Span) -> Diagnostic Never! {
    sema_error("E0910", span, "the `add {field}: {ty}` migration on `{name}` needs `{ty}` to support `Decode`", "`{name}` derives `Decode` but not `Encode` — it only ever reads data back, so every field, including one added by a migration, must itself be decodable", "derive `Decode` on `{ty}`, or give `{field}` a decodable type")
}
fn sema_schema_unknown(name: String, field: String, verb: String, span: Span) -> Diagnostic Never! {
    sema_error("E0910", span, "the `{verb} {field}` migration on `{name}` names a field that doesn't exist", "a migration op must reference a field of this record — either its published shape or its current one", "check the spelling of `{field}`, or remove the `{verb}` op")
}

fn sema_schema_enter_registered_module(environment: &SemaScopeEnvironment?, program: SemaProgramTables, module_index: Int) Never! {
    if &environment == .Val(scope) {
        sema_scope_environment_enter_module(&scope, program, module_index, SemaComptimeBodyValues{})
        return
    }
    panic("an owning schema pass lost its scope environment")
}

fn sema_schema_check_registered_module(environment: SemaScopeEnvironment?, program: SemaProgramTables, module_index: Int, snapshots: [String:SchemaSnapshot], diagnostics: &[Diagnostic]) Never! {
    if environment == .Val(scope) {
        if program.registration_graph == .Val(graph) {
            start :: diagnostics.len()
            loop diagnostic in check_schema_migrations(graph.modules[module_index].program.items, snapshots, environment, program) -> &diagnostics.push(diagnostic)
            sema_attach_diagnostic_source_locations(&diagnostics, start, graph.modules[module_index].source_segments)
            return
        }
    }
    panic("an owning schema pass lost its registration graph")
}

// Module entry borrows the schema pass's one program graph; it only replaces
// the selected scope facts and never takes fields from either borrowed owner.
fn sema_check_schema_migration_graph(registration: ^SemaRegistrationGraph, checked: SemaGraphResult, snapshots: [String:SchemaSnapshot]) -> (registration: SemaRegistrationGraph, diagnostics: [Diagnostic]) Never! {
    if snapshots.len() == 0 -> return (diagnostics: [Diagnostic]{}, registration: ^registration)
    module_count :: registration.modules.len()
    types := [TTypeDef]{}
    loop module_row in checked.modules {
        loop definition in module_row.declarations.type_defs -> &types.push(definition)
    }
    scope := sema_check_pass_environment(^registration, types, SemaComptimeBodyValues{})
    program := SemaProgramTables{
        registration_graph: ^scope.registration_graph,
        checked_types: ^scope.checked_types,
        checked_type_rows: ^scope.checked_type_rows,
        checked_type_name_slots: ^scope.checked_type_name_slots,
        checked_type_name_rows: ^scope.checked_type_name_rows,
        boxed_edges: ^scope.boxed_edges,
    }
    scope.registration_graph = None
    scope.checked_types = [TTypeDef]{}
    scope.checked_type_rows = [String:Int]{}
    scope.checked_type_name_slots = [String:Int]{}
    scope.checked_type_name_rows = [[Int]]{}
    scope.boxed_edges = [String:[String]]{}
    environment := Val(^scope)
    diagnostics := [Diagnostic]{}
    loop module_index in 0..<module_count {
        sema_schema_enter_registered_module(&environment, program, module_index)
        sema_schema_check_registered_module(environment, program, module_index, snapshots, &diagnostics)
    }
    graph_out := ^program.registration_graph
    restored :: ^graph_out ?? panic("a completed schema pass lost its registration graph")
    (diagnostics: ^diagnostics, registration: ^restored)
}
