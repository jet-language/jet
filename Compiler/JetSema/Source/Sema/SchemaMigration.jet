//RS         "E0910",
//RS         format!(
//RS             "the `{} {}` migration on `{}` names a field that doesn't exist",
//RS             verb, field, type_name
//RS         ),
//RS         "a migration op must reference a field of this record — either its published shape or its current one".to_string(),
//RS         format!("check the spelling of `{}`, or remove the `{}` op", field, verb),
//RS         Some(span),
//RS     )
//RS }
