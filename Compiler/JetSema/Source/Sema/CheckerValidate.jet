// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:1
// D-VALIDATE1: before registration, validate rule shapes and sibling fields,
// rewrite field references onto value, then synthesize a pure validate method.
// Its ordinary purity pass enforces that conditions/messages only use pure calls.
use jet_sema.Sema.[field_error_ty]
use jet_sema.Sema.CheckerFieldPolicy.[rewrite_field_refs]
use jet_sema.Diagnostics.[Diagnostic, Span]
use jet_sema.Syntax as Syntax
use jet_sema.AST.[AccessConvention, Binding, CallArg, CallArgFlags, Expr, Field, Func, ImplDef, Item, Param, ParamZone, Stmt, StrPart, StructDef, SwitchArm, Type, TypeParam, UnOp]
use std.collections.[HashSet]

// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:36
pub fn process_validate_blocks(items: &[Item], diags: &[Diagnostic]) Never! {
    needs_over :: contains_validate_over(items)
    generated := [Item]{}
    loop item in items {
        if item == .Struct(s) {
            if s.validate_block.is_empty() -> continue
            if synthesize_validate_impl(s, diags) == .Val(imp) { generated.push(Item.Impl(imp)) }
        }
    }
    if needs_over {
        span :: first_item_span(items).unwrap_or_else(fn() { Span.new(0, 0) })
        generated.push(Item.Struct(build_validate_builder_struct(span)))
        generated.push(Item.Impl(build_validate_builder_impl(span)))
    }
    items.extend(^generated)
}

// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:56
fn first_item_span(items: [Item]) -> Span? {
    loop item in items {
        if item == {
            .Func(f) -> return Val(f.span)
            .Struct(s) -> return Val(s.span)
            .Enum(e) -> return Val(e.span)
            .Impl(i) -> return Val(i.span)
            .CodeModule(m) -> return Val(m.name_span)
            .Test(t) -> return Val(t.span)
            _ -> {}
        }
    }
    None
}

// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:68
fn contains_validate_over(items: &[Item]) -> Bool Never! {
    // Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:69
    fn body_contains(body: &[Stmt]) -> Bool Never! {
        found := false
        loop &stmt in body {
            stmt.for_each_expr_mut(fn(expr: &Expr) Never! {
                if expr == .MethodCall{receiver, method, ..} {
                    if method == "over" && receiver == .Ident(Syntax.TYPE_VALIDATE, _) { found = true }
                }
            })
        }
        found
    }
    // Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:89
    fn item_contains(item: &Item) -> Bool Never! {
        if item == {
            .Func(f) -> return body_contains(&f.body)
            .Struct(s) -> {
                loop &f in s.methods { if body_contains(&f.body) -> return true }
                loop &i in s.trait_impls { loop &f in i.methods { if body_contains(&f.body) -> return true } }
            }
            .Enum(e) -> {
                loop &f in e.methods { if body_contains(&f.body) -> return true }
                loop &i in e.trait_impls { loop &f in i.methods { if body_contains(&f.body) -> return true } }
            }
            .Impl(i) -> { loop &f in i.methods { if body_contains(&f.body) -> return true } }
            .Test(t) -> return body_contains(&t.body)
            .CodeModule(m) -> { if m.body == .Val(body) { return contains_validate_over(&body) } }
            _ -> {}
        }
        false
    }
    loop &item in items { if item_contains(&item) -> return true }
    false
}

// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:118
struct ValidateRule { cond: Expr; field: String; msg: Expr }

// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:124
fn synthesize_validate_impl(s: StructDef, diags: &[Diagnostic]) -> ImplDef? Never! {
    field_names := HashSet[String].new()
    loop f in s.fields { _ :: field_names.insert(f.name.clone()) }
    rules := [ValidateRule]{}
    all_ok := true
    loop stmt in s.validate_block {
        if extract_check_rule(stmt, field_names) == {
            .Ok(rule) -> rules.push(^rule)
            .Err(d) -> { diags.push(^d); all_ok = false }
        }
    }
    // Malformed rule bodies never reach codegen.
    if !all_ok -> return None
    span :: s.validate_span.unwrap_or(s.name_span)
    Val(build_validate_impl(s, rules, span))
}

// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:147
fn extract_check_rule(stmt: Stmt, field_names: HashSet[String]) -> ValidateRule Diagnostic! {
    if stmt == .Expr(.Call(call)) {
        if call.name != Syntax.VALIDATE_CHECK_FN -> return Err(e0353_bad_validate_rule(call.name_span))
        if call.args.len() != 3 -> return Err(e0353_bad_validate_rule(call.name_span))
        cond_arg :: call.args[0]
        at_arg :: call.args[1]
        msg_arg :: call.args[2]
        if cond_arg.label.is_some() -> return Err(e0353_bad_validate_rule(cond_arg.span))
        if at_arg.label == .Val((label, _)) {
            if label != "at" -> return Err(e0353_bad_validate_rule(at_arg.span))
        } else -> return Err(e0353_bad_validate_rule(at_arg.span))
        if msg_arg.label.is_some() -> return Err(e0353_bad_validate_rule(msg_arg.span))
        if at_arg.expr == .Ident(field_name, field_span) {
            if !field_names.contains(field_name) -> return Err(e0354_unknown_validate_field(field_name, field_span))
            return Ok(ValidateRule{cond: cond_arg.expr.clone(), field: field_name.clone(), msg: msg_arg.expr.clone()})
        }
        return Err(e0353_bad_validate_rule(at_arg.span))
    }
    Err(e0353_bad_validate_rule(stmt.span()))
}

// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:189
pub fn e0353_bad_validate_rule(span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0353",
        "a `validate` rule must be `check(condition, at: field, \"message\")`",
        "D-VALIDATE1: every statement in a `validate { … }` block is a `check` call — the first argument is the rule's condition, `at:` names the field the failure is reported against, and the last argument is the message text",
        "write: check(<condition>, at: <field>, \"<message>\")", Val(span))
}

// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:199
pub fn e0354_unknown_validate_field(name: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0354", "`at: {name}` doesn't name a field on this struct",
        "D-VALIDATE1: `check(…, at: field, …)`'s `at:` argument must be a bare field name declared on the same struct — it's how the reported `FieldError.path` is chosen",
        "fix the field name, or add the field to the struct", Val(span))
}

// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:209
fn ident(name: String, span: Span) -> Expr { Expr.Ident(name.to_string(), span) }
// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:213
fn str_lit(text: String, span: Span) -> Expr { Expr.Str([StrPart]{StrPart.Lit(text.to_string())}, span) }
// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:217
fn call_arg(expr: Expr, span: Span) -> CallArg {
    CallArg{convention: .Read, expr: ^expr, span: span, flags: CallArgFlags.default(), label: None, spread: false}
}
// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:228
fn method_call(receiver: Expr, method: String, args: [CallArg], span: Span) -> Expr {
    Expr.MethodCall{receiver: ^receiver, method: method.to_string(), method_span: span,
        owner_type_args: [], type_args: [], args: ^args, recv_type: None, resolved_ret: None,
        operator_rhs: None, checked_widen: false}
}

// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:243
const ERRORS_VAR: String = "__errors"
// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:244
const VALUE_VAR: String = "value"

// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:247
fn build_validate_impl(s: StructDef, rules: [ValidateRule], span: Span) -> ImplDef Never! {
    field_names := HashSet[String].new()
    loop f in s.fields { _ :: field_names.insert(f.name.clone()) }
    errors_binding :: Stmt.Val(Binding{
        mutable: true, markers: [], reactive_upgrade: false, meta: None,
        name: ERRORS_VAR.to_string(), name_span: span, sigil_span: None, pattern: None,
        ty: Val(Type.List(field_error_ty())), ty_span: Val(span), init: Expr.ListLit([], span),
        is_comptime: false, ct: None, uninit: false, arena_view: false, string_view: false,
        gc_promotion: None, gc_transferred: false})
    body := [Stmt]{errors_binding}
    loop rule in rules {
        cond := rule.cond.clone()
        rewrite_field_refs(&cond, field_names, VALUE_VAR)
        msg := rule.msg.clone()
        rewrite_field_refs(&msg, field_names, VALUE_VAR)
        field_error_lit :: Expr.StructLit{
            type_name: "FieldError", type_args: [], import_ns: None, as_trait: None,
            fields: [(String, Span, Expr)]{("path", span, str_lit(rule.field, span)), ("reason", span, ^msg)},
            inferred: false, span: span}
        push_stmt :: Stmt.Expr(method_call(ident(ERRORS_VAR, span), "push", [CallArg]{call_arg(field_error_lit, span)}, span))
        not_cond :: Expr.Unary(.Not, ^cond, span)
        body.push(Stmt.Switch{subject: Expr.Bool(true, span),
            arms: [SwitchArm]{SwitchArm{span: not_cond.span(), cond: ^not_cond, body: [Stmt]{push_stmt}}}, else_body: None, span: span})
    }
    has_errors :: Expr.Unary(.Not, method_call(ident(ERRORS_VAR, span), "is_empty", [], span), span)
    return_err :: Stmt.Return(Val(Expr.Err(ident(ERRORS_VAR, span), span)), span)
    body.push(Stmt.Switch{subject: Expr.Bool(true, span),
        arms: [SwitchArm]{SwitchArm{span: has_errors.span(), cond: has_errors, body: [Stmt]{return_err}}}, else_body: None, span: span})
    body.push(Stmt.Return(Val(Expr.Ok(Expr.Copy(ident(VALUE_VAR, span), span), span)), span))
    // Read at the call site, return an owned copy on success.
    value_param :: Param{convention: .Read, root: false, name: VALUE_VAR.to_string(), name_span: span,
        ty: Type.Named(s.name.clone()), ty_span: span, default: None, variadic: false,
        variadic_bound_list: None, declared_view_from_names: None, public_label: None, zone: .Either}
    validate_func :: Func{
        span: span, is_comptime: false, is_pub: s.is_pub, is_package_pub: s.is_package_pub,
        external_type: None, name: "validate", name_span: span, meta: None,
        type_params: [], head_pattern: None, params: [Param]{value_param},
        return_type: Val(Type.Result{ok: Type.Named(s.name.clone()), err: Type.List(field_error_ty())}),
        return_type_span: Val(span), return_view_provenance: None, declared_return_view_provenance: None,
        gc_return: false, diverges: false, gc_scope: false, is_unsafe: false,
        unsafe_reason: None, unsafe_span: None,
        // S60/E3401 checks purity across the whole synthesized rule body.
        is_pure: true, is_reactive: false, reactive_upgrades: [], is_replayable: false,
        replayable_span: None, is_job: false, job_span: None, every: None, job_metadata: None,
        is_must_use: false, must_use_span: None, maturity: None, maturity_span: None,
        kernel: None, is_inline: false, is_inline_always: false, inline_span: None,
        is_sanitizer: false, scrub_tag: None, declared_effects: None, effect_via: None,
        state_requires: None, state_transition: None, web_marker: None, pre: [], post: [],
        inline_foreign: None, undo: None, markers: [], compiler_generated: false, body: ^body}
    ImplDef{span: span, type_name: s.name.clone(), type_span: s.name_span,
        trait_name: None, trait_span: None, operator_rhs: None, operator_marker: None,
        methods: [Func]{validate_func}, delegation_field: None, assoc_type_impls: [],
        is_generated_serde: false, os_target: None}
}

// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:435
fn generated_field(name: String, ty: Type, span: Span) -> Field {
    Field{is_pub: false, is_package_pub: false, name: name.to_string(), name_span: span,
        ty: ^ty, ty_span: span, serde_markers: [], redact: false, computed: None, default: None, default_ct: None}
}
// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:451
fn generated_param(name: String, convention: AccessConvention, ty: Type, span: Span) -> Param {
    Param{convention: convention, root: false, name: name.to_string(), name_span: span,
        ty: ^ty, ty_span: span, default: None, variadic: false, variadic_bound_list: None,
        declared_view_from_names: None, public_label: None, zone: .Either}
}
// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:468
fn generated_method(name: String, params: [Param], return_type: Type, body: [Stmt], span: Span) -> Func Never! {
    function := Func.implicit_run(^body, span)
    function.name = name.to_string()
    function.name_span = span
    function.params = ^params
    function.return_type = Val(^return_type)
    function.return_type_span = Val(span)
    function.compiler_generated = true
    function
}
// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:485
fn builder_type() -> Type {
    Type.Apply{name: Syntax.TYPE_VALIDATE_BUILDER.to_string(), args: [Type]{Type.Named("T")}}
}
// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:492
fn builder_field(base: String, field: String, span: Span) -> Expr {
    Expr.Field(ident(base, span), field.to_string(), span)
}
// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:496
fn build_validate_builder_struct(span: Span) -> StructDef {
    StructDef{span: span, is_pub: false, is_package_pub: false,
        name: Syntax.TYPE_VALIDATE_BUILDER.to_string(), name_span: span,
        type_params: [TypeParam]{TypeParam{name: "T", name_span: span, bounds: [], prep: None}},
        fields: [Field]{generated_field("value", Type.Named("T"), span), generated_field("errors", Type.List(field_error_ty()), span)},
        state: None, methods: [], cli_bindings: [], trait_impls: [], derives: [],
        auto_derive_default: false, is_published_schema: false, published_schema_span: None,
        is_single_use: false, single_use_span: None, is_must_use: false, must_use_span: None,
        layout: None, layout_span: None, serde_markers: [], type_markers: [], validate_block: [], validate_span: None}
}

// Rust: crates/jet-sema/src/Sema/CheckerValidate.rs:534
fn build_validate_builder_impl(span: Span) -> ImplDef Never! {
    self_param :: generated_param(Syntax.KW_SELF, .Move, Type.Named(""), span)
    condition_param :: generated_param("condition", .Read, Type.Bool, span)
    at_param :: generated_param("at", .Read, Type.String, span)
    reason_param :: generated_param("reason", .Read, Type.String, span)
    error :: Expr.StructLit{type_name: "FieldError", type_args: [], import_ns: None, as_trait: None,
        fields: [(String, Span, Expr)]{("path", span, ident("at", span)), ("reason", span, ident("reason", span))}, inferred: false, span: span}
    errors_binding :: Binding{mutable: true, markers: [], reactive_upgrade: false, meta: None,
        name: ERRORS_VAR.to_string(), name_span: span, sigil_span: None, pattern: None,
        ty: Val(Type.List(field_error_ty())), ty_span: Val(span),
        init: Expr.Copy(builder_field("self", "errors", span), span), is_comptime: false, ct: None,
        uninit: false, arena_view: false, string_view: false, gc_promotion: None, gc_transferred: false}
    append_error :: Stmt.Expr(method_call(ident(ERRORS_VAR, span), "push", [CallArg]{call_arg(error, span)}, span))
    rebuilt :: Expr.StructLit{type_name: Syntax.TYPE_VALIDATE_BUILDER.to_string(), type_args: [Type]{Type.Named("T")},
        import_ns: None, as_trait: None,
        fields: [(String, Span, Expr)]{("value", span, builder_field("self", "value", span)), ("errors", span, ident(ERRORS_VAR, span))},
        inferred: false, span: span}
    check_body :: [Stmt]{
        Stmt.Switch{subject: Expr.Bool(true, span), arms: [SwitchArm]{SwitchArm{span: span,
            cond: Expr.Unary(.Not, ident("condition", span), span),
            body: [Stmt]{Stmt.Val(errors_binding), append_error, Stmt.Return(Val(rebuilt), span)}}}, else_body: None, span: span},
        Stmt.Return(Val(ident(Syntax.KW_SELF, span)), span)}
    check :: generated_method("check", [Param]{self_param.clone(), condition_param, at_param, reason_param}, builder_type(), check_body, span)
    has_errors :: Expr.Unary(.Not, method_call(builder_field(Syntax.KW_SELF, "errors", span), "is_empty", [], span), span)
    finish :: generated_method("finish", [Param]{self_param},
        Type.Result{ok: Type.Named("T"), err: Type.List(field_error_ty())},
        [Stmt]{Stmt.Switch{subject: Expr.Bool(true, span), arms: [SwitchArm]{SwitchArm{span: span, cond: has_errors,
            body: [Stmt]{Stmt.Return(Val(Expr.Err(builder_field(Syntax.KW_SELF, "errors", span), span)), span)}}}, else_body: None, span: span},
            Stmt.Return(Val(Expr.Ok(builder_field(Syntax.KW_SELF, "value", span), span)), span)}, span)
    ImplDef{span: span, type_name: Syntax.TYPE_VALIDATE_BUILDER.to_string(), type_span: span,
        trait_name: None, operator_marker: None, operator_rhs: None, trait_span: None,
        methods: [Func]{check, finish}, delegation_field: None, assoc_type_impls: [], is_generated_serde: false, os_target: None}
}
