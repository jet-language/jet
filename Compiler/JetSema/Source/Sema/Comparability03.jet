// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2176
pub fn collection_changed_in_loop(name: String, span: Span) -> Diagnostic Never! {
    collection_changed_in_loop_with_operation(name, None, span)
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2180
pub fn collection_changed_by_method_in_loop(name: String, method: String, span: Span) -> Diagnostic Never! {
    collection_changed_in_loop_with_operation(name, Val(method), span)
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2188
fn collection_changed_in_loop_with_operation(name: String, method: String?, span: Span) -> Diagnostic Never! {
    operation :: if method == { .Val(value) -> "`{name}.{value}()`"; .None -> "a mutation of `{name}`" }
    Diagnostic.from_row("E0507", [("name", name), ("operation", operation)], Val(span))
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2203
pub fn collection_root_name(expr: Expr) -> String? {
    if expr == {
        .Ident(name, _) -> Val(name)
        .MethodCall(receiver, method, _, _) -> if method == "chars" { collection_root_name(receiver) } else { None }
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2214
pub fn expr_root_ident(expr: Expr) -> String? {
    if expr == {
        .Ident(name, _) -> Val(name)
        .Field(inner, _, _) -> expr_root_ident(inner)
        .Index(base, _, _) | .Slice(base, _, _, _) -> expr_root_ident(base)
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2224
pub fn type_is_copy(ty: Type) -> Bool Never! {
    if ty.is_scalar() || is_u8_ty(ty) -> return true
    if ty == {
        .Char -> true
        .Named(name) -> name == Syntax.TYPE_COMPLEX || name == Syntax.TYPE_RANGE
        else -> false
    }
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2234
pub fn is_task_type(ty: Type) -> Bool Never! {
    if ty == { .Apply(name, _) -> name == "Task"; else -> false }
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2241
pub fn type_requires_owned_iteration(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, args) -> {
            if name == "ViewMut" -> return false
            if name == "Task" -> return true
            loop arg in args { if type_requires_owned_iteration(arg) -> return true }
            false
        }
        .List(inner) | .FixedList(inner, _) | .Option(inner) | .Shared(inner) -> type_requires_owned_iteration(inner)
        .Tuple(fields) -> {
            loop field in fields { if type_requires_owned_iteration(field.ty) -> return true }
            false
        }
        .Result(ok, err) | .Map(ok, _, err) -> type_requires_owned_iteration(ok) || type_requires_owned_iteration(err)
        else -> false
    }
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2266
pub fn prepend_send_path(root: String, field: String, problem: SendabilityProblem) -> SendabilityProblem Never! {
    problem.root = Val(root)
    &problem.path.insert(0, field)
    problem
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2276
pub fn describe_sendability_problem(problem: SendabilityProblem) -> String Never! {
    if problem.kind == {
        .ClosureNeedsTake -> {
            if problem.root == .Val(root) {
                if !problem.path.is_empty() -> return "`{root}` contains `{problem.path.join(".")}`, whose captures cannot cross this boundary"
            }
            "the closure holds state that cannot cross this boundary"
        }
        .ClosureCaptures -> "the closure holds captures that are not sendable"
        .CallableValue -> "a function value carries executable state, not a worker data value"
        .TraitValue(name) -> "`{name}` is a trait value, so the compiler cannot prove which concrete value crosses this boundary"
        .ThreadConfined(name) -> "`{name}` owns thread-local state and must stay on the thread that created it"
        .LocalReactive(name) -> "`#Local` keeps `{name}` in the fast one-thread form"
        .ViewBorrow -> "a view is a borrow, not an owned value"
    }
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2314
pub fn field_read_to_clone(expr: Expr, registry: TypeRegistry, imports: [String:Int]) -> Bool Never! {
    if expr == {
        .Field(inner, member, _) -> {
            if member == "clone" -> return false
            if inner == { .Ident(name, _) -> registry.enum_variants(name) == None && !imports.contains_key(name); else -> true }
        }
        else -> false
    }
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2335
pub fn builtin_type_from_ident(name: String) -> Type? {
    if numeric_type_from_name(name) == .Val(numeric) -> return Val(numeric)
    if name == Syntax.TYPE_BOOL -> return Val(Type.Bool)
    if name == Syntax.TYPE_STRING -> return Val(Type.String)
    if name == Syntax.TYPE_CHAR -> return Val(Type.Char)
    if name == Syntax.DURATION_TYPE || name == Syntax.CLOCK_TYPE || name == Syntax.TYPE_AUTHORITY || name == Syntax.TYPE_DECIMAL || name == Syntax.TYPE_FRACTION || name == "Date" || name == "Instant" || name == "Path" || name == Syntax.TYPE_CONDITION || name == "Cell" -> return Val(Type.Named(name))
    if name == Syntax.TYPE_LIST -> return Val(Type.List(Type.Int))
    None
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2361
pub fn computed_field_not_settable(field: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0339", "`{field}` is a computed field — it can't be assigned", "`{field}` is declared `{field} => …` — its value always comes from that formula; `#Memo` only retains the result between valid reads", "change a stored field the `{field}` formula reads, not `{field}` itself", Val(span))
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2374
pub fn private_item(name: String, span: Span) -> Diagnostic Never! {
    Diagnostic.error("E0605", "`{name}` exists but is private to its file", "only names marked `pub` can be used from another file (S18)", "add `pub` before `{name}`, or don't reach across files here", Val(span))
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:2390
pub fn soft_public_use(name: String, span: Span) -> Diagnostic Never! {
    Diagnostic.lint("L0601", "`{name}` is a soft-public API", "a leading underscore allows outside use but carries no compatibility promise across minor releases", "use a public name without a leading underscore when callers need a stable API", Val(span))
}
