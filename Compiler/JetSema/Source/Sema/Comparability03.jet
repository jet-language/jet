// Diagnostics fragment; canonical owner: Sema/Comparability.jet.
use jet_foundation.[Type, Expr, Diagnostic, Span, Syntax, Generics, VariantPayload]
use jet_sema.[TypeRegistry, TypeDef, TraitRegistry, SendabilityProblem, SendProblemKind]

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:1760
pub fn is_displayable(ty: Type, type_reg: TypeRegistry, trait_reg: TraitRegistry) -> Bool Never! {
    if is_secret_bearing_crypto_type(ty) || is_one_pass_source(ty) -> return false
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 -> true
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> is_displayable(inner, type_reg, trait_reg)
        .Result(ok, err) | .Map(ok, _, err) -> is_displayable(ok, type_reg, trait_reg) && is_displayable(err, type_reg, trait_reg)
        .Named(n) -> type_reg.is_unit_type(n) || trait_reg.implements_trait(n, Generics.DISPLAY) || trait_reg.implements_trait(n, Generics.PRINTABLE) || is_core_shown_type(n) || n == Syntax.TYPE_INT || n == Syntax.TYPE_FLOAT || n == Syntax.TYPE_BOOL || n == Syntax.TYPE_STRING || n == Syntax.TYPE_CHAR
        .Quantity(_, _) -> true
        .Apply(name, args) -> {
            if name == "KeyRef" -> return true
            native_composite :: name == Syntax.TYPE_LIST || name == Syntax.TYPE_SET || name == Syntax.TYPE_RANK || name == Syntax.TYPE_PRIORITY_QUEUE || name == Syntax.TYPE_QUEUE || name == Syntax.TYPE_LRU || name == Syntax.EXPIRING_VALUE_TYPE || name == "Loadable" || name == "View"
            if !(native_composite || trait_reg.implements_trait(name, Generics.DISPLAY) || trait_reg.implements_trait(name, Generics.PRINTABLE)) -> return false
            loop arg in args { if !is_displayable(arg, type_reg, trait_reg) -> return false }
            true
        }
        .Tuple(fields) -> {
            loop field in fields { if !is_displayable(field.ty, type_reg, trait_reg) -> return false }
            true
        }
        // D-ANY-JAI1: any Renderable bound grants interpolation.
        .TraitObject(bounds) -> {
            loop bound in bounds { if bound == Generics.RENDERABLE -> return true }
            false
        }
        .Shared(_) | .Fn(_, _, _, _, _, _) | .Measure(_) -> false
        .Union(members) -> {
            loop member in members { if !is_displayable(member, type_reg, trait_reg) -> return false }
            true
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:1843
pub fn e0138(type_name: String, operation: String, needed_bundle: String, granted: [String], span: Span) -> Diagnostic Never! {
    has :: if granted.is_empty() { "no operation bundles" } else { "only {granted.join(", ")}" }
    Diagnostic.error("E0138", "`{type_name}` doesn't support {operation}", "a nominal type only gets the operations its operation bundles grant; `{type_name}` has {has}", "add `{needed_bundle}` before the declaration, or convert to the base type first", Val(span))
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:1872
pub fn e0139(clause_kw: String, span: Span?) -> Diagnostic Never! {
    Diagnostic.error("E0139", "a `#{clause_kw}` condition can't do I/O", "a contract is checked at every call and must be a pure claim about values", "move the effect out; keep only a pure test", span)
}

// Rust: crates/jet-sema/src/Sema/Diagnostics.rs:1883
pub fn is_debuggable(ty: Type, type_reg: TypeRegistry, trait_reg: TraitRegistry) -> Bool Never! {
    if is_secret_bearing_crypto_type(ty) -> return false
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 -> true
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> is_debuggable(inner, type_reg, trait_reg)
        .Result(ok, err) | .Map(ok, _, err) -> is_debuggable(ok, type_reg, trait_reg) && is_debuggable(err, type_reg, trait_reg)
        .Named(n) -> type_reg.is_unit_type(n) || trait_reg.implements_trait(n, Generics.DEBUG) || is_core_shown_type(n)
        .Quantity(_, _) -> true
        .Apply(name, args) -> {
            if name == "KeyRef" -> return true
            if !trait_reg.implements_trait(name, Generics.DEBUG) -> return false
            loop arg in args { if !is_debuggable(arg, type_reg, trait_reg) -> return false }
            true
        }
        .Tuple(fields) -> {
            loop field in fields { if !is_debuggable(field.ty, type_reg, trait_reg) -> return false }
            true
        }
        .TraitObject(_) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Measure(_) -> false
        .Union(members) -> {
            loop member in members { if !is_debuggable(member, type_reg, trait_reg) -> return false }
            true
        }
    }
}

