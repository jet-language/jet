//RS thread_local! {
//RS     /// Named types already entered by the comparability query running on this
//RS     /// thread, plus the query's nesting depth (the set clears when it ends).
//RS     static COMPARABLE_VISITED: std::cell::RefCell<(usize, HashSet<String>)> =
//RS         std::cell::RefCell::new((0, HashSet::new()));
//RS }
//RS 
//RS /// A recursive type (`enum Expr { Neg(inner: Expr) }`) reaches itself through
//RS /// its fields, and shared field types are reached many times. A revisit adds
//RS /// no obligation: a type still being decided is assumed comparable
//RS /// (coinduction), and a type that finished as incomparable already ended the
//RS /// whole query, because every caller short-circuits on the first failure. So
//RS /// a visited type answers `true`, and each type is walked once per query.
//RS /// Without the guard a recursive type never terminates (stack overflow while
//RS /// checking the self-hosted compiler) and a shared graph costs exponential time.
//RS fn named_fields_comparable(name: &str, ty: &Type, registry: &TypeRegistry) -> bool {
//RS     let entered = COMPARABLE_VISITED.with(|state| {
//RS         let mut state = state.borrow_mut();
//RS         if !state.1.insert(name.to_string()) {
//RS             return false;
//RS         }
//RS         state.0 += 1;
//RS         true
//RS     });
//RS     if !entered {
//RS         return true;
//RS     }
//RS     let comparable = incomparable_field(ty, registry).is_none();
//RS     COMPARABLE_VISITED.with(|state| {
//RS         let mut state = state.borrow_mut();
//RS         state.0 -= 1;
//RS         if state.0 == 0 {
//RS             state.1.clear();
//RS         }
//RS     });
//RS     comparable
//RS }
