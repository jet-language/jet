// The services a build's target lacks. An artifact built for a machine gets
// only the services the machine provides (the facts `core.target` declares).
// Each service it lacks denies the effect that needs it: every function the
// entry reaches whose solved row uses a denied effect reports E1123 where the
// effect enters the program's own code, a use in its body or its call into
// Core; a call into another program function reports there instead. On a
// machine with no OS, each Core operation the program's own code uses is
// validated against the machine's declared services, and a service it lacks
// is E3311 where the code first uses it.
use jet_foundation.[
    symbol_is_local,
    symbol_table_key,
    Diagnostic,
    Span,
    TargetMachineError,
    authority_own_process_leaf,
    jet_target_machine_denied_effects,
    jet_target_machine_error_diagnostic,
    jet_target_machine_use_default,
    jet_target_machine_use_from_core_apis,
    jet_target_machine_validate,
    module_is_core,
    sema_effect_covers,
]

sema_target_denial_check: fn(modules: [SemaGraphModuleResult], graph: SemaRegistrationGraph, diagnostics: &[Diagnostic]) Never! {
    denied: jet_target_machine_denied_effects(graph.target_machine)
    if denied.len() == 0 -> return
    // Each checked function by key: its module result and its row there.
    // The roots are the entry module's `run` and every function an Output
    // links, the entries the artifact starts at (sema_liveness_is_root); a
    // `build: fn` runs on the building machine, not the target.
    slots := [String:SemaTargetSlot]{}
    roots := [String]{}
    loop module_index in 0..<modules.len() {
        loop (row, function) in modules[module_index].functions {
            if slots.get(function.key) != None -> next
            slots[function.key] = SemaTargetSlot{module_index: module_index, row: row}
            if function.name == "run" && function.module_identity == graph.entry_module_identity -> roots.push(function.key)
        }
    }
    loop reference in graph.output_name_references -> roots.push(symbol_table_key(graph.symbols, reference.symbol.id))
    // The functions the entry reaches through calls and function values,
    // in the order the walk first meets them.
    reached := [String]{}
    seen := [String:Bool]{}
    loop key in roots {
        if seen.get(key) != None -> next
        seen[key] = true
        reached.push(key)
    }
    at := 0
    loop at < reached.len() {
        key: reached[at]
        at += 1
        slot: slots.get(key) ?? next
        effects: modules[slot.module_index].functions[slot.row].effects
        if sema_effect_covered(effects.solved, denied).len() == 0 -> next
        loop edge in effects.call_edges {
            if slots.get(edge) == None || seen.get(edge) != None -> next
            seen[edge.copy()] = true
            reached.push(edge.copy())
        }
        loop edge in effects.value_edges {
            if slots.get(edge) == None || seen.get(edge) != None -> next
            seen[edge.copy()] = true
            reached.push(edge.copy())
        }
    }
    target: graph.target_machine.triple
    loop key in reached {
        slot: slots.get(key) ?? next
        function: modules[slot.module_index].functions[slot.row]
        if module_is_core(function.module_identity) -> next
        if sema_effect_covered(function.effects.solved, denied).len() == 0 -> next
        found := [Diagnostic]{}
        reported := [String]{}
        loop site in function.effects.direct_spans {
            denial: sema_target_denied_by(site.name, denied) ?? next
            if reported.contains(denial) -> next
            reported.push(denial.copy())
            found.push(sema_target_denied_diagnostic(function.name, denial, target, site.span))
        }
        loop call in modules[slot.module_index].call_facts {
            if call.caller_key != key -> next
            callee: call.callee ?? next
            if symbol_is_local(callee) -> next
            callee_slot: slots.get(symbol_table_key(graph.symbols, callee)) ?? next
            callee_function: modules[callee_slot.module_index].functions[callee_slot.row]
            // A call into a program function reports inside that function.
            if !module_is_core(callee_function.module_identity) -> next
            loop effect_name in callee_function.effects.solved {
                denial: sema_target_denied_by(effect_name, denied) ?? next
                if reported.contains(denial) -> next
                reported.push(denial.copy())
                found.push(sema_target_denied_diagnostic(function.name, denial, target, call.span))
            }
        }
        if found.len() == 0 -> next
        registration: sema_registration_module_index(graph, function.module_identity) ?? next
        sema_attach_diagnostic_source_locations(found, 0, graph.modules[registration].source_segments)
        loop diagnostic in found -> diagnostics.push(diagnostic)
    }
}

// Where a checked function's body is: its module result and its row there.
SemaTargetSlot: struct {
    module_index: Int
    row: Int
}

// The effect of `denied` that covers `effect_name`, None when none does. An
// `Exec` leaf acting on the program's own process (reading its arguments,
// ending it) needs no process service, so only a denial that names it exactly
// refuses it; the `Exec` root's denial refuses starting other programs.
sema_target_denied_by: fn(effect_name: String, denied: [String]) -> String? Never! {
    own_process: authority_own_process_leaf(effect_name)
    loop denial in denied {
        if own_process && denial != effect_name -> next
        if sema_effect_covers(denial, effect_name) -> return Val(denial.copy())
    }
    None
}

sema_target_denied_diagnostic: fn(function: String, denied: String, target: String, span: Span) -> Diagnostic Never! {
    sema_error("E1123", span, "`{function}` uses `{denied}`, which target `{target}` denies", "an artifact built for `{target}` gets only the services that machine provides, and it lacks the one `{denied}` needs", "keep the `{denied}` work out of the code this entry reaches, or build the entry for a target that provides `{denied}`")
}

// On a machine with no OS: each Core operation a program module uses (its
// `core_usage` rows, first site per operation) is validated against the
// machine (jet_target_machine_validate), and each service the operation needs
// that the machine's profile lacks is E3311 at that site, once per module.
// Only operations are checked: a Core type a signature names (`__type__`,
// `typed_head`) needs no service, and `#Live`'s terminal (a row naming only
// `core.term`) is refused at the block (E3301). A module no machine without
// an OS can serve is refused at each call instead (E3301,
// sema_call_core_no_os_hint), and the validator's runtime-layer and allocator
// rows are the per-site E3301 and E3303 reports, so only its capability rows
// are reported here.
sema_target_capability_check: fn(graph: SemaRegistrationGraph, core_usage: SemaCoreUsageResult, diagnostics: &[Diagnostic]) -> Bool Never! {
    machine: graph.target_machine
    if !machine.no_os -> return true
    // The profile's own gaps hold for every program; only what a use adds is
    // the program's.
    declared: jet_target_machine_validate(machine, jet_target_machine_use_default())
    complete := true
    loop module_usage in core_usage.modules {
        if module_is_core(module_usage.module_identity) -> next
        found := [Diagnostic]{}
        reported := [TargetMachineError]{}
        loop site in module_usage.usage_spans {
            parts: site.usage.split("::").to_list()
            if parts.len() < 2 || parts[1] == "__type__" || parts[1] == "typed_head" -> next
            if sema_call_core_no_os_hint(parts[0]) != None -> next
            loop error in jet_target_machine_validate(machine, jet_target_machine_use_from_core_apis([String]{site.usage})) {
                if declared.contains(error) || reported.contains(error) -> next
                diagnostic := jet_target_machine_error_diagnostic(machine, error)
                if diagnostic.code != "E3311" -> next
                reported.push(error.copy()) // copy: the validator's list keeps its row.
                diagnostic.span = Val(site.span)
                found.push(diagnostic)
            }
        }
        if found.len() == 0 -> next
        complete = false
        registration: sema_registration_module_index(graph, module_usage.module_identity) ?? next
        sema_attach_diagnostic_source_locations(found, 0, graph.modules[registration].source_segments)
        loop diagnostic in found -> diagnostics.push(diagnostic)
    }
    complete
}
