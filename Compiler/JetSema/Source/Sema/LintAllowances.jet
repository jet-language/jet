// Site rungs: `#Allow(jet.UnusedParameter, "why")` on a
// statement, a function or method, or a struct field silences that one lint
// inside its target. The lint is named by its diagnostic type path.
// MarkerRules validates the reason (L3103) and refuses `jet.AllowReason`
// (E0355); this pass only applies the allowance.
use jet_foundation.[
    DIAGNOSTIC_LINT,
    Diagnostic,
    Func,
    Item,
    Marker,
    Program,
    RuleSite,
    Span,
    diagnostic_display_name,
    expr_span,
]

// One allowance in its module's aggregate coordinates, keyed by the source
// file segment it sits in (the same key a located diagnostic carries).
struct SemaLintAllowance {
    lint: String
    source_path: String
    source_offset: Int
    target: Span
}

// The lint type path an `#Allow` marker names (`jet.UnusedParameter`), if it
// is one.
fn sema_lint_allowance_name(marker: Marker) -> String? Never! {
    if marker.name != "Allow" || marker.negated || marker.args.len() == 0 -> return None
    if marker.args[0] == .Expr(expr) {
        if expr == .Field(base, member, _, _) {
            if base == .Ident(package, _, _) -> return Val("{package}.{member}")
        }
    }
    None
}

fn sema_lint_allowance_push(markers: [Marker], target: Span, segments: [SemaSourceSegment], allowances: &[SemaLintAllowance]) Never! {
    loop marker in markers {
        lint :: sema_lint_allowance_name(marker) ?? next
        location :: sema_source_location_at(segments, target) ?? next
        &allowances.push(SemaLintAllowance{lint: lint, source_path: location.source_path, source_offset: location.aggregate_start, target: target})
    }
}

fn sema_lint_allowance_functions(functions: [Func], segments: [SemaSourceSegment], allowances: &[SemaLintAllowance]) Never! {
    loop function in functions -> sema_lint_allowance_push(function.markers, function.span, segments, &allowances)
}

fn sema_lint_allowance_item(item: Item, segments: [SemaSourceSegment], allowances: &[SemaLintAllowance]) Never! {
    if item == {
        .Func(function) -> sema_lint_allowance_push(function.markers, function.span, segments, &allowances)
        .Struct(definition) -> {
            loop field in definition.fields {
                end := field.ty_span.end
                if field.computed == .Val(computed) -> end = expr_span(computed).end
                if field.default == .Val(default) -> end = expr_span(default).end
                sema_lint_allowance_push(field.serde_markers, Span{start: field.name_span.start, end: end}, segments, &allowances)
            }
            sema_lint_allowance_functions(definition.methods, segments, &allowances)
            loop implementation in definition.trait_impls -> sema_lint_allowance_functions(implementation.methods, segments, &allowances)
        }
        .Enum(definition) -> {
            sema_lint_allowance_functions(definition.methods, segments, &allowances)
            loop implementation in definition.trait_impls -> sema_lint_allowance_functions(implementation.methods, segments, &allowances)
        }
        .Impl(implementation) -> sema_lint_allowance_functions(implementation.methods, segments, &allowances)
        .CodeModule(code_module) -> {
            if code_module.body == .Val(body) {
                loop nested in body -> sema_lint_allowance_item(nested, segments, &allowances)
            }
        }
        else -> {}
    }
}

// Every allowance a module's program writes: the statement rung is the
// parser's applied rule with its statement target.
fn sema_lint_allowances(program: Program, segments: [SemaSourceSegment], allowances: &[SemaLintAllowance]) Never! {
    loop application in program.applied_rules {
        if application.site != Val(RuleSite.Statement) -> next
        target :: application.target ?? next
        sema_lint_allowance_push([Marker]{application.marker}, target, segments, &allowances)
    }
    loop item in program.items -> sema_lint_allowance_item(item, segments, &allowances)
}

// Whether a located lint diagnostic falls inside an allowance for its lint.
fn sema_lint_allowed(diagnostic: Diagnostic, allowances: [SemaLintAllowance]) -> Bool Never! {
    if diagnostic.severity != DIAGNOSTIC_LINT || allowances.len() == 0 -> return false
    span :: diagnostic.span ?? return false
    path :: diagnostic.source_path ?? return false
    offset :: diagnostic.source_offset ?? return false
    lint :: diagnostic_display_name(diagnostic.code)
    loop allowance in allowances {
        if allowance.lint == lint && allowance.source_path == path && allowance.source_offset == offset && allowance.target.start <= span.start && span.end <= allowance.target.end -> return true
    }
    false
}
