use jet_foundation.[CallArg, Expr, Func, Item, Type, StructDef, Diagnostic, Span, DevtoolsFactPublication, DevtoolsPanel, DevtoolsRegistry, DevtoolsRegistryError, DevtoolsStateField]
use jet_syntax as Syntax

// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:10
pub E_DEVTOOLS_PUBLISH_GATE: String :: "E1404"
// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:11
pub E_DEVTOOLS_DUPLICATE_PANEL: String :: "E1410"
// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:12
pub E_DEVTOOLS_INVALID_PANEL: String :: "E1411"
// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:13
pub E_DEVTOOLS_UNKNOWN_FIELD: String :: "E1412"
// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:14
pub E_DEVTOOLS_FIELD_TYPE: String :: "E1413"
// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:15
pub E_DEVTOOLS_UNFED_FIELD: String :: "E1414"

// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:20
pub fn check_devtools_panels(package: String, module: String, package_items: [Item], module_items: [Item], registry: &DevtoolsRegistry, diags: &[Diagnostic]) {
    structs := [String: StructDef]{}
    loop item in package_items {
        if item == .Struct(def) -> structs[def.name] = def
    }
    loop item in module_items {
        if item != .Func(function) || !has_dev_panel_marker(function) -> next
        marker :: function.dev_panel_marker() ?? next
        marker_count := 0
        loop candidate in function.markers {
            if candidate.dev_panel_marker() != None -> marker_count += 1
        }
        if marker_count != 1 {
            &diags.push(panel_error(E_DEVTOOLS_DUPLICATE_PANEL, function.name, "a devtools panel is registered once per function", "keep one `#DevPanel` marker on the public `panel` function", marker.span))
            next
        }
        if !marker.is_valid() {
            &diags.push(panel_error(E_DEVTOOLS_INVALID_PANEL, function.name, "`#DevPanel` has no arguments and cannot be negated", "write `#DevPanel` without `!` or marker arguments", marker.span))
            next
        }
        state_type :: validate_panel_signature(function, &diags) ?? next
        // Retain the original total lookup guard even if future types gain new cases.
        if state_type != .Named(state_name) -> next
        state :: structs.get(state_name) ?? {
            &diags.push(panel_error(E_DEVTOOLS_INVALID_PANEL, function.name, "panel state type `{state_name}` is not a declared struct", "declare `struct {state_name}` in the same package", function.params[0].ty_span))
            next
        }
        state_fields := [DevtoolsStateField]{}
        loop field in state.fields {
            &state_fields.push(DevtoolsStateField.new(field.name, field.ty, field.name_span, field.default != None))
        }
        loop field in state_fields {
            if !field.is_ready_before_publication() {
                &diags.push(panel_error(E_DEVTOOLS_INVALID_PANEL, function.name, "state field `{field.name}` has neither an absence default nor an optional type", "give `{field.name}` a default value or declare it as `{field.ty.name()}?`", field.span))
            }
        }
        panel :: DevtoolsPanel.new(package, module, function.name, state_type, ^state_fields, function.span)
        if &registry.register_panel(^panel) == .Err(error) -> &diags.push(registry_error(error))
    }
}

// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:131
pub fn check_devtools_publish(package: String, module: String, args: &[CallArg], value_type: Type?, span: Span, registry: DevtoolsRegistry, facts: &[DevtoolsFactPublication], diags: &[Diagnostic]) -> Bool {
    if args.len() != 2 || arg_label(args, 0) != Val("field") || arg_label(args, 1) != Val("value") {
        &diags.push(Diagnostic.error(E_DEVTOOLS_PUBLISH_GATE, "this published value has no gate", "a published value must name itself with `field:` and `value:`", "write `devtools.publish(field: .state_field, value: <expr>)`", Val(span)))
        return false
    }
    field :: leading_field_name(args[0].expr) ?? {
        &diags.push(panel_error(E_DEVTOOLS_UNKNOWN_FIELD, "publish", "the `field:` argument must be a leading-dot state field selector", "write `field: .state_field` for a field in the marked panel state", args[0].expr.span()))
        return false
    }
    checked_type :: value_type ?? return false
    panel :: registry.panel_for_field(package, module, field) ?? registry.unique_panel_for_field(package, field) ?? {
        &diags.push(panel_error(E_DEVTOOLS_UNKNOWN_FIELD, "publish", "the package has no uniquely identified panel field `{field}`", "publish a field declared by the package's marked `panel` state", args[0].expr.span()))
        return false
    }
    publication :: DevtoolsFactPublication.new(package, panel.module, panel.identity(), field, checked_type, span)
    if registry.validate_publication(publication) == .Err(error) {
        &diags.push(registry_error(error))
        return false
    }
    // Retain checked source identity once even when inference revisits a span.
    if !facts.any(fn(existing) { existing.span == publication.span }) -> &facts.push(^publication)
    true
}
// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:204
fn arg_label(args: [CallArg], index: Int) -> String? {
    arg :: args.get(index) ?? return None
    label :: arg.label ?? return None
    Val(label.0)
}
// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:211
pub fn unfed_state_fields(package: String, registry: DevtoolsRegistry) -> Iterator<(DevtoolsPanel, DevtoolsStateField)> {
    registry.panels().filter(fn(panel) { panel.package == package }).flat_map(fn(panel) {
        panel.state_fields.iter().filter(fn(field) {
            !registry.publications().iter().any(fn(publication) { publication.panel == panel.identity() && publication.field == field.name })
        }).map(fn(field) { (panel, field) })
    })
}
// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:233
pub fn check_unfed_state_fields(registry: DevtoolsRegistry, diags: &[Diagnostic]) {
    loop panel in registry.panels() {
        loop field in panel.state_fields {
            fed :: registry.publications().iter().any(fn(publication) { publication.panel == panel.identity() && publication.field == field.name })
            if fed -> next
            &diags.push(Diagnostic.error(E_DEVTOOLS_UNFED_FIELD, "devtools panel `{panel.identity()}` state field `{field.name}` has no publication", "every panel state field must have a checked `core.devtools.publish` site", "publish `field: .{field.name}` with the field's declared type", Val(field.span)))
        }
    }
}
// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:258
fn has_dev_panel_marker(function: Func) -> Bool {
    function.markers.any(fn(marker) { marker.name == Syntax.MARKER_DEV_PANEL })
}
// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:265
fn validate_panel_signature(function: Func, diags: &[Diagnostic]) -> Type? {
    if !function.is_pub || function.is_package_pub {
        &diags.push(panel_error(E_DEVTOOLS_INVALID_PANEL, function.name, "a devtools panel is a public package entry point", "write `pub fn panel(state: State) -> UINode {{ ... }}`", function.name_span))
        return None
    }
    if function.name != "panel" || !function.type_params.is_empty() || function.params.len() != 1 || function.params[0].name != "state" || function.params[0].default != None || function.params[0].variadic {
        &diags.push(panel_error(E_DEVTOOLS_INVALID_PANEL, function.name, "a devtools panel must be the public `panel(state: State)` function", "write one non-generic `state` parameter without a default or variadic marker", function.name_span))
        return None
    }
    return_type :: function.return_type ?? {
        &diags.push(panel_error(E_DEVTOOLS_INVALID_PANEL, function.name, "a devtools panel must return a `UINode` tree", "declare `UINode` before the function body arrow", function.name_span))
        return None
    }
    if return_type != Type.Named(Syntax.TYPE_UI_NODE) {
        &diags.push(panel_error(E_DEVTOOLS_INVALID_PANEL, function.name, "a devtools panel returns `{return_type.show()}` instead of `UINode`", "return the portable `UINode` tree from the panel function", function.return_type_span ?? function.name_span))
        return None
    }
    Val(function.params[0].ty)
}
// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:315
fn leading_field_name(expr: Expr) -> String? {
    if expr == .Field(base, field, _) && base == .Ident(name, _) && name.is_empty() -> Val(field)
    else -> None
}
// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:326
fn panel_error(code: String, panel: String, why: String, fix: String, span: Span) -> Diagnostic {
    Diagnostic.error(code, "devtools panel `{panel}` is invalid", why, fix, Val(span))
}
// Rust: crates/jet-sema/src/Sema/DevtoolsPanel.rs:336
pub fn registry_error(error: DevtoolsRegistryError) -> Diagnostic {
    if error == {
        .DuplicatePanel{identity, first, duplicate} -> Diagnostic.error(E_DEVTOOLS_DUPLICATE_PANEL, "devtools panel `{identity}` is registered twice", "one package/module/function identity may describe only one panel (first at {first.start}..{first.end})", "keep one marked public `panel` function for this package", Val(duplicate))
        .UnknownStateField{package, module, panel, field, span} -> Diagnostic.error(E_DEVTOOLS_UNKNOWN_FIELD, "devtools publication names unknown state field `{field}`", "package `{package}` module `{module}` has no marked panel `{panel}` field with that name", "write `field: .{field}` using a field from the package's `panel` state", Val(span))
        .StateFieldTypeMismatch{package, module, panel, field, expected, actual, span} -> Diagnostic.error(E_DEVTOOLS_FIELD_TYPE, "published value for `{package}::{module}::{panel}::{field}` has type `{actual.show()}`", "the panel state field has type `{expected.show()}`", "publish a value with type `{expected.show()}` or change the state field", Val(span))
    }
}
