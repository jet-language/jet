// The flow-fact walk: one store and one path rule set for
// every plane that keeps per-binding facts along a body. A walk carries the
// store at the current point, whether the current path has left its block
// (`return`, `panic`, `break`, `continue`), and the store of each path that
// left the innermost loop. The store (SemaFlowFacts) holds every per-binding
// fact, keyed by plane and binding; a plane keeps no facts of its own and
// supplies only its join (SemaFlowPlane). Which paths meet is decided here,
// the same way at every `if`, loop and arm table:
// - a path that left its block meets no join after it;
// - when no path falls through, the walk after them has left its block;
// - a loop's zero-turn path meets its one-turn path and every path that
//   leaves the body with `break` or `continue`;
// - an arm table without `else` has a skip-every-arm path unless sema
//   proved it exhaustive (no E0307 at its span).
// Typestate (Typestate.jet) and taint (Taint.jet) are planes. The borrow
// checker is a prover, not a plane: its fork joins take
// which paths meet from sema_flow_reaching. The effect checks keep no
// per-binding facts along a body, so they are no plane.
use jet_foundation.[Span, SwitchArm]

// The planes' keys in the store.
SEMA_FLOW_PLANE_STATE: 0

SEMA_FLOW_PLANE_TAINT: 1

// Where paths met and leave binding `binding` (the plane's id for it) with
// two different facts, `one` and `other` as the plane spells them. A plane
// whose join never loses a fact reports none.
SemaFlowSplit: struct {
    binding: Int,
    one: String,
    other: String,
}

// One binding's fact on one plane at one point. `held` when the plane
// tracks the binding there; `one` is the plane's single value for it ("" for
// none: typestate's one known state, taint's declared type name) and `many`
// its set (typestate's states where paths met in different states, taint's
// tags).
SemaFlowFact: struct {
    held: Bool{false},
    one: String{""},
    many: [String]{[String]{}},
}

// The one flow-fact store: the per-binding facts at one point, keyed by
// plane (`plane`, a SEMA_FLOW_PLANE_* key) and binding (the plane's interned
// local id, a column of `facts`; id 0 tracks nothing). `any_many` is whether
// a binding's `many` was filled on this path, so a plane can skip lookups
// while none was.
SemaFlowFacts: struct {
    plane: Int,
    facts: [SemaFlowFact],
    any_many: Bool{false},
}

// A plane on the walk: only its join. `flow_join` is the fact `binding`
// holds where a path holding `one` meets a path holding `other` (either may
// be unheld), reporting each split the plane reports.
SemaFlowPlane: trait {
    flow_join: fn(self, binding: Int, one: ^^SemaFlowFact, other: ^^SemaFlowFact, splits: ^[SemaFlowSplit]) -> SemaFlowFact Never!,
}

// One body's walk of plane `P`: the store at the current point, whether the
// current path has left its block, and, for each loop around it, innermost
// last, the store of each path that left that loop's body.
SemaFlowWalk: struct<P> {
    plane: P,
    current: SemaFlowFacts,
    ended: Bool,
    exits: [[SemaFlowFacts]],
}

// What a loop's walk restores when it leaves the loop: the store before the
// loop, its zero-turn path.
SemaFlowLoop: struct {
    before: SemaFlowFacts,
}

// A store of plane `plane` that tracks no binding.
sema_flow_facts: fn(plane: Int) -> SemaFlowFacts Never! {
    SemaFlowFacts{plane: plane, facts: [SemaFlowFact]{SemaFlowFact{}}}
}

// Binding `binding`'s fact in `facts`; unheld when it has none.
sema_flow_fact: fn(facts: SemaFlowFacts, binding: Int) -> SemaFlowFact Never! {
    if binding >= facts.facts.len() -> return SemaFlowFact{}
    facts.facts[binding]
}

// Binding `binding` holds `fact` in `facts`.
sema_flow_put: fn(facts: ^SemaFlowFacts, binding: Int, fact: SemaFlowFact) Never! {
    loop facts.facts.len() <= binding -> facts.facts.push(SemaFlowFact{})
    if fact.many.len() > 0 -> facts.any_many = true
    facts.facts[binding] = fact
}

// Binding `binding` holds no fact in `facts`.
sema_flow_drop: fn(facts: ^SemaFlowFacts, binding: Int) Never! {
    if binding < facts.facts.len() -> facts.facts[binding] = SemaFlowFact{}
}

// A body's walk of `plane` from `start`, on a path that has not left it.
sema_flow_start: fn<P: SemaFlowPlane>(plane: P, start: SemaFlowFacts) -> SemaFlowWalk<P> Never! {
    SemaFlowWalk<P>{plane: plane, current: start, ended: false, exits: [[SemaFlowFacts]]{}}
}

// Continue from `facts` on a path that has not left its block: a fork
// starts each of its paths from the store before it.
sema_flow_restore: fn<P: SemaFlowPlane>(walk: ^SemaFlowWalk<P>, facts: SemaFlowFacts) Never! {
    walk.current = facts.copy()
    walk.ended = false
}

// A `return` or `panic`: nothing after it runs on this path, and it meets
// no join.
sema_flow_end: fn<P: SemaFlowPlane>(walk: ^SemaFlowWalk<P>) Never! {
    walk.ended = true
}

// A `break` or `continue` leaves the body: its store meets the paths that
// leave the innermost loop, and nothing after it in the block runs on this
// path.
sema_flow_leave_loop: fn<P: SemaFlowPlane>(walk: ^SemaFlowWalk<P>) Never! {
    if !walk.ended && walk.exits.len() > 0 -> walk.exits[walk.exits.len() - 1].push(walk.current.copy())
    walk.ended = true
}

// The current path reaches its join when it falls through.
sema_flow_reach: fn<P: SemaFlowPlane>(walk: SemaFlowWalk<P>, paths: ^[SemaFlowFacts]) Never! {
    if !walk.ended -> paths.push(walk.current.copy())
}

// The store where a path holding `left` meets one holding `right`: each
// binding either holds is joined by the plane.
sema_flow_join: fn<P: SemaFlowPlane>(plane: P, left: SemaFlowFacts, right: SemaFlowFacts, splits: ^[SemaFlowSplit]) -> SemaFlowFacts Never! {
    out := sema_flow_facts(left.plane)
    count := left.facts.len()
    if right.facts.len() > count -> count = right.facts.len()
    loop binding in 1..<count {
        one: sema_flow_fact(left, binding)
        other: sema_flow_fact(right, binding)
        if !one.held && !other.held -> next
        joined: plane.flow_join(binding, one, other, splits)
        if joined.held -> sema_flow_put(out, binding, joined)
    }
    out
}

// The one branch-merge rule: the paths that fall through meet, in order.
// When none falls through, the walk after them has left its block.
sema_flow_meet: fn<P: SemaFlowPlane>(walk: ^SemaFlowWalk<P>, paths: ^^[SemaFlowFacts], splits: ^[SemaFlowSplit]) Never! {
    pending := paths.move()
    pending.reverse()
    merged := pending.pop() ?? {
        walk.ended = true
        return
    }
    loop pending.len() > 0 {
        next_path: pending.pop() ?? break
        merged = sema_flow_join(walk.plane, merged, next_path, splits)
    }
    walk.current = merged
    walk.ended = false
}

// Enter a loop body: its exits start empty. The body starts from the store
// before the loop, which the zero-turn path keeps.
sema_flow_loop_enter: fn<P: SemaFlowPlane>(walk: ^SemaFlowWalk<P>) -> SemaFlowLoop Never! {
    walk.exits.push([SemaFlowFacts]{})
    SemaFlowLoop{before: walk.current.copy()}
}

// The one loop rule: the zero-turn path meets the one-turn path and every
// path that left the body with `break` or `continue`.
sema_flow_loop_leave: fn<P: SemaFlowPlane>(walk: ^SemaFlowWalk<P>, entered: ^^SemaFlowLoop, splits: ^[SemaFlowSplit]) Never! {
    paths := [SemaFlowFacts]{entered.before.move()}
    sema_flow_reach(walk, paths)
    left: walk.exits.pop() ?? [SemaFlowFacts]{}
    loop exit in left.move() -> paths.push(exit)
    sema_flow_meet(walk, paths, splits)
}

// The one arm-table rule: the arm paths in `paths` (each pushed by
// sema_flow_reach) meet; a table without `else` (`has_else` false) also has
// the path that skips every arm, from `before`, unless it is `exhaustive`.
sema_flow_arms_meet: fn<P: SemaFlowPlane>(walk: ^SemaFlowWalk<P>, before: ^^SemaFlowFacts, paths: ^^[SemaFlowFacts], has_else: Bool, exhaustive: Bool, splits: ^[SemaFlowSplit]) Never! {
    met := paths.move()
    if !has_else && !exhaustive -> met.push(before.move())
    sema_flow_meet(walk, met, splits)
}

// Whether the arm table at `span` with `arms` covers every value, so no
// path skips every arm: each arm tests a pattern and sema proved the table
// exhaustive (`open` holds the spans of its E0307 reports).
sema_flow_arms_exhaustive: fn(arms: [SwitchArm], open: [Span], span: Span) -> Bool Never! {
    if arms.len() == 0 -> return false
    loop arm in arms {
        if arm.cond == .PatternTest(_, _, _, _) -> next
        return false
    }
    !open.contains(span)
}

// The paths that meet where `reaches.len()` paths end, by position: each
// one that falls through, in order. Empty when none does, and the walk
// after them has left its block. A prover's fork join (the borrow
// checker's) takes its paths from here.
sema_flow_reaching: fn(reaches: [Bool]) -> [Int] Never! {
    loop at in 0..<reaches.len() if reaches[at] -> at
}
