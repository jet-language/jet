// The built-in math value types no Core declaration names (and the linear-algebra
// arms): the `[T#N]` `to_array` bridge, the vector and matrix products, and the
// `splat` / `from_array` statics. A math type Core declares (every SIMD lane
// type, `Vec3`) keeps its own source methods; a lane `v[i]` reads its `lanes`
// array.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    Expr,
    Measure,
    Span,
    Type,
    expr_span,
    type_identity_equal,
    type_name,
    type_simd_lane_arity,
]

SEMA_MATH_REDUCE_OP_TYPE: "ReduceOp"
SEMA_MATH_REDUCE_OP_VALUES: [String]{"Add", "Mul", "Min", "Max", "Avg"}

sema_call_math_is_lane: fn(name: String) -> Bool Never! {
    type_simd_lane_arity(name) != None
}

// The SIMD lane type `ty` names (`F32x4`), bare or as the Core declaration's
// canonical identity (`<corelib>/core.math::F32x4`).
sema_call_math_lane_name: fn(ty: Type) -> String? {
    name: sema_expr_math_leaf_name(ty) ?? return None
    if sema_call_math_is_lane(name) -> Val(name) else -> None
}

// The compiler-provided math type `ty` names: a math family member with no
// registered declaration (Rust `is_math_type && !registry.contains`).
sema_call_math_builtin_name: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> String? {
    name: if ty == {
        .Named(found) -> found
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> { return None }
    }
    if !sema_core_is_math_type(name) -> return None
    if program.registration_graph == .Val(graph) {
        if sema_type_resolve_nominal_row(graph, ty, environment.module_identity) != None -> return None
    }
    Val(name)
}

// Rust `math_array_bridge_ty`: `[T#N]` of the scalar, N the component count.
sema_call_math_array_bridge: fn(name: String) -> Type Never! {
    Type.FixedList{elem: sema_call_math_scalar_type(name), len: Measure.Literal{kind: "length", value: sema_call_math_arity(name)}}
}

// Rust `math_method_return`.
sema_call_math_method_return: fn(name: String, method: String, argument_count: Int) -> Type? {
    self_type: Type.Named{name: name}
    if name == "Vec2" || name == "Vec3" || name == "Vec4" {
        if method == "dot" && argument_count == 1 -> return Val(Type.Float)
        if method == "cross" && argument_count == 1 && name == "Vec3" -> return Val(self_type)
        if method == "length" && argument_count == 0 -> return Val(Type.Float)
        if method == "normalize" && argument_count == 0 -> return Val(self_type)
        if method == "to_array" && argument_count == 0 -> return Val(sema_call_math_array_bridge(name))
        return None
    }
    if name == "Mat3" || name == "Mat4" {
        if method == "matmul" && argument_count == 1 -> return Val(self_type)
        if method == "transpose" && argument_count == 0 -> return Val(self_type)
        if method == "transform" && argument_count == 1 -> return Val(Type.Named{name: if name == "Mat3" -> "Vec3" else -> "Vec4"})
        if method == "to_array" && argument_count == 0 -> return Val(sema_call_math_array_bridge(name))
    }
    None
}

// Rust `math_method_arg_ty`.
sema_call_math_method_argument: fn(name: String, method: String) -> Type? {
    if method == "dot" || method == "cross" || method == "matmul" -> return Val(Type.Named{name: name})
    if name == "Mat3" && method == "transform" -> return Val(Type.Named{name: "Vec3"})
    if name == "Mat4" && method == "transform" -> return Val(Type.Named{name: "Vec4"})
    None
}

sema_call_math_reduce_error: fn(span: Span, what: String, why: String, fix: String) -> Diagnostic Never! {
    sema_error("E2510", span, what, why, fix)
}

// `v.reduce(.Op)` on a SIMD lane takes one Core `ReduceOp`
// value. A written value that names no `ReduceOp` variant is E2510 before the
// Core `reduce` method checks the call; true when it was.
sema_call_math_lane_reduce_rejected: fn(receiver: Type, method: String, args: [CallArg], diagnostics: &[Diagnostic]) -> Bool Never! {
    if method != "reduce" || args.len() != 1 || sema_call_math_lane_name(receiver) == None -> return false
    if args[0].expr == {
        .EnumLit(enum_type, variant, _, payload, _, value_span, _) -> {
            if (enum_type == "" || enum_type == SEMA_MATH_REDUCE_OP_TYPE) && payload.len() == 0 && SEMA_MATH_REDUCE_OP_VALUES.contains(variant) -> return false
            diagnostics.push(sema_call_math_reduce_error(value_span, "this value is not a `ReduceOp`", "`reduce` accepts `.Add`, `.Mul`, `.Min`, `.Max`, or `.Avg`", "use a Core `ReduceOp` value"))
            return true
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    false
}

// An instance method on a compiler-provided math value. A method the table
// does not name falls through to the ordinary missing-method diagnostic.
sema_call_try_math_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    name: sema_call_math_builtin_name(receiver_value.ty, environment, program) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    result: sema_call_math_method_return(name, method, args.len()) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    wanted: sema_call_math_method_argument(name, method)
    values := [TExpr]{}
    complete := true
    loop argument in args {
        checked: sema_check_expression(argument.expr, wanted, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            complete = false
            next
        }
        if wanted == .Val(required) && !type_identity_equal(checked.ty, required) {
            diagnostics.push(sema_error("E0112", expr_span(argument.expr), "`.{method}()` on `{name}` expects a `{type_name(required)}`, got `{type_name(checked.ty)}`", "`{name}.{method}(…)` operates on a `{type_name(required)}`", "pass a `{type_name(required)}` value"))
            complete = false
            next
        }
        values.push(checked)
    }
    if !complete -> return failed
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return failed
    value: sema_tree_node(result, TExprKind.HandleMethod{receiver: receiver_value, operation: THandleOp.MathMethod{type_name: name, method: method}, args: values}, span)
    if !sema_effect_record_intrinsic_fact(environment, program, scopes, context, "{name}.{method}", span, sema_call_geometry_call_facts(result), diagnostics) -> return failed
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

// Rust `math_static_return` / `math_static_arg_ty`: `T.splat(scalar)` and
// `T.from_array([T#N])` build the value through the `jet_math_<T>_<method>`
// builtin; the argument is checked against its expected type first.
sema_call_try_math_static: fn(owner: String, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    unhandled: SemaMethodSpecialCheck{handled: false, value: None}
    self_type: Type.Named{name: owner}
    name: sema_call_math_builtin_name(self_type, environment, program) ?? return unhandled
    if (method != "splat" && method != "from_array") || args.len() != 1 -> return unhandled
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    wanted: if method == "splat" -> sema_call_math_scalar_type(name) else -> sema_call_math_array_bridge(name)
    checked: sema_check_expression(args[0].expr, Val(wanted), environment, program, scopes, state, tail_store, context, diagnostics) ?? return failed
    if !type_identity_equal(checked.ty, wanted) {
        diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{name}.{method}()` expects a `{type_name(wanted)}`, got `{type_name(checked.ty)}`", "`{name}.{method}` builds a `{name}` from a `{type_name(wanted)}`", "pass a `{type_name(wanted)}` value"))
        return failed
    }
    value: sema_tree_node(self_type, TExprKind.MathBuiltin{type_name: name, function: method, args: [TExpr]{checked}}, span)
    if !sema_effect_record_intrinsic_fact(environment, program, scopes, context, "{name}.{method}", span, sema_call_geometry_call_facts(self_type), diagnostics) -> return failed
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}
