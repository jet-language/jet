// Source-semantic checks for the Core service APIs. Core identities and row
// signatures come from the shared registry; this file only applies the
// service-specific source contract before constructing the registered call.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    CoreCallRecord,
    Diagnostic,
    Expr,
    FunctionDefaultRef,
    NodeKind,
    ParamZone,
    Span,
    SymbolID,
    SymbolKind,
    TFailureCarrier,
    TGenericParam,
    StrPart,
    Type,
    core_identity_is,
    core_source_owns_type,
    AST_EMPTY_CALL_ARG_FLAGS,
    UnOp,
    expr_span,
    module_text,
    type_name,
]

sema_services_error_type: fn() -> Type Never! { Type.Named{name: "ServiceError"} }

sema_services_result_type: fn(value: Type) -> Type Never! {
    Type.Result{ok: value, err: sema_services_error_type()}
}

sema_services_literal_string: fn(expression: Expr) -> String? {
    if expression == {
        .Str(parts, _, _) -> {
            if parts.len() != 1 -> return None
            return if parts[0] == {
                .Lit(text) -> Val(text)
                .Interp(_, _) | .Byte(_) -> None
            }
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_services_literal_int: fn(expression: Expr) -> Int? {
    if expression == {
        .Int(value, _, _, _, _) -> return Val(value)
        .Paren(inner, _, _) -> return sema_services_literal_int(inner)
        .Unary(operation, inner, _, _) -> {
            if operation == UnOp.Neg {
                return Val((sema_services_literal_int(inner) ?? return None) * -1)
            }
            return None
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_services_valid_name: fn(value: String) -> Bool Never! {
    if value.trim() == "" -> return false
    bytes := value.bytes()
    if bytes.len() > 256 -> return false
    index := 0
    loop index < bytes.len() {
        code := Int{bytes[index]}
        if code < 32 || code == 127 -> return false
        // The control range includes the C1 range U+0080..U+009F.
        if code == 194 && index + 1 < bytes.len() {
            next_code := Int{bytes[index + 1]}
            if next_code >= 128 && next_code <= 159 -> return false
        }
        index += 1
    }
    true
}

sema_services_const_symbol: fn(value: TExpr, context: SemaCheckContext) -> SymbolID? {
    if value.kind == .Flat(index) && context.arena.tree.nodes[index - context.arena.tree.node_base].kind == .ConstRef(symbol) {
        // copy: `symbol` is a payload of the context's arena row, which keeps the original; the Val carrier owns this one
        return Val(symbol.copy())
    }
    None
}

sema_services_result_carrier: fn(result_type: Type) -> TFailureCarrier Never! {
    if result_type == {
        // copy: `ok` and `error` are payloads of read parameter `result_type`, which keeps the originals; the new TFailureCarrier.Result's fields own `ok` and `error`
        .Result(ok, error) -> TFailureCarrier.Result{success: ok.copy(), error: error.copy()}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> TFailureCarrier.Infallible
    }
}

sema_services_report_arity: fn(api: String, actual: Int, expected: Int, span: Span, diagnostics: ^[Diagnostic]) {
    diagnostics.push(sema_call_arity_diagnostic(api, expected, actual, false, span))
}

sema_services_check_untyped_args: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) Never! {
    loop argument in args {
        _ := sema_check_expression(argument.expr, None, environment, program, check)
    }
}

sema_services_bind_labels: fn(api: String, args: ^[CallArg], labels: [String], span: Span, diagnostics: ^[Diagnostic]) -> Bool Never! {
    if labels.len() != args.len() -> return false
    params := [SemaCallParam]{}
    index := 0
    loop index < labels.len() {
        label := labels[index]
        params.push(
            SemaCallParam{
                label: label.copy(),
                name: if label == "" -> "arg{index + 1}" else -> label,
                zone: if label == "" -> ParamZone.PositionalOnly else -> ParamZone.LabelOnly,
                default: None,
                default_ref: None,
                convention: AccessConvention.Read,
                ty: None,
                variadic: false,
            },
        )
        index += 1
    }
    _ := sema_call_bind_args(api, params, args, span, diagnostics) ?? return false
    true
}

sema_services_apply_access: fn(value: TExpr, access: AccessConvention) -> TExpr Never! {
    if access == AccessConvention.Move {
        return sema_tree_node(value.ty, TExprKind.Move{value: value}, value.span)
    }
    // copy: the converted value is a new owned TExpr. For a plain access it equals `value`, the
    // caller's checked argument (a read parameter), which the caller keeps.
    value.copy()
}

// `resolved_accesses` marks `fallback_accesses` as the call's final accesses
// (a method contract already applied its explicit and record accesses).
sema_services_core_call: fn(record: CoreCallRecord, arguments: [TExpr], fallback_accesses: [AccessConvention], method_receiver: Bool, resolved_accesses: Bool, result_type: Type, expected: Type?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    call_arguments := [TExpr]{}
    index := 0
    loop index < arguments.len() {
        fallback := if index < fallback_accesses.len() -> fallback_accesses[index] else -> AccessConvention.Read
        access := if resolved_accesses || (method_receiver && index == 0) -> fallback else -> sema_call_core_access(record, index) ?? fallback
        call_arguments.push(sema_services_apply_access(arguments[index], access))
        index += 1
    }
    failure := sema_services_result_carrier(result_type)
    value: sema_call_core_tree(record, call_arguments, span, [Type]{}, [Bool]{}, result_type, failure, expected, environment, program, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_services_record_call_effects(record, value, span, result_type, failure, environment, program, scopes, context, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    SemaMethodSpecialCheck{handled: true, value: Val(value)}
}

// A service call names the file and wait effects its
// Core source body reaches. A call checked into its Jet source function
// records that function as the callee, so the effect graph infers the row
// from the body (and its jet.runtime leaves) like any source call; a fixed
// record row would hide them. A call still checked into a CoreCall node keeps
// its record row.
sema_services_record_call_effects: fn(record: CoreCallRecord, value: TExpr, span: Span, result_type: Type, failure: TFailureCarrier, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> Bool Never! {
    if value.kind == .Call(_, _, _) {
        context.call_facts.push(
            SemaCallSiteFact{
                span: span,
                caller_key: sema_scope_function_owner_key(scopes),
                callee: sema_expr_call_callee(program, value),
                facts: SemaCallSiteFacts{effect_bound: None},
                discarded: false,
                detail: sema_call_site_detail_of(SemaCallSiteDetail{lifecycle: record.marker}),
            },
        )
        return true
    }
    sema_call_core_record_effects(record, span, [Type]{}, result_type, failure, [FunctionDefaultRef]{}, scopes, context, environment, program, diagnostics)
}

sema_services_method_params: fn(types: [Type], accesses: [AccessConvention]) -> [SemaCallParam] Never! {
    params := [SemaCallParam]{}
    index := 0
    loop index < types.len() {
        access := if index < accesses.len() -> accesses[index] else -> AccessConvention.Read
        params.push(
            SemaCallParam{
                label: "",
                name: "arg{index + 1}",
                zone: ParamZone.PositionalOnly,
                default: None,
                default_ref: None,
                convention: access,
                ty: Val(types[index]),
                variadic: false,
            },
        )
        index += 1
    }
    params
}

// The source call `core.service.<member>(receiver, args…)` at `type_args`;
// `api` names the call in its diagnostics.
sema_services_source_call: fn(api: String, member: String, type_args: [Type], receiver: Expr, receiver_access: AccessConvention, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    identity: sema_call_core_module_identity(environment, program, "core.service") ?? {
        check.diagnostics.push(sema_error("E0003", span, "service source module is not loaded", "`{api}` requires Core/Service/Service.jet", "load the registered Core source module"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    target: sema_call_core_source_target(environment, program, identity, member, type_args, span, true, check.diagnostics) ?? {
        check.diagnostics.push(sema_error("E0003", span, "service source receiver target is missing", "`{api}` requires its canonical source function", "load the registered Core source function"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    source_args := [CallArg]{CallArg{convention: receiver_access, expr: receiver, span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}}
    written := args
    loop argument in written -> source_args.push(argument)
    check.scopes.ownership_call_depth += 1
    value := sema_call_core_check_source_owned(target, api, type_args, source_args, span, expected, environment, program, check)
    check.scopes.ownership_call_depth -= 1
    SemaMethodSpecialCheck{handled: true, value: value}
}

// A service method routes only when the receiver is that service handle
// (`handle_ty == "ServiceTree"`, …); a user type's `start`, `send` or `show`
// keeps its own declaration. A canonical `core.service` identity names the
// same handle, whether its nominal is source-owned or still has a carrier
// projection (`ServiceRuntime`, `DeliveryState`).
sema_services_receiver_is: fn(ty: Type, owner: String) -> Bool Never! {
    if ty == {
        .Named(name) -> name == owner || core_identity_is(name, "core.service", owner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// The builder shape every worker declaration keeps: a visible literal name,
// a positive literal capacity and a top-level function handler. Returns the
// handler's name, or None once a diagnostic reports the shape.
sema_services_worker_shape: fn(name: Expr, handler: Expr, capacity: Expr, scopes: SemaScopeTable, diagnostics: ^[Diagnostic]) -> String? {
    valid := true
    literal: sema_services_literal_string(name)
    if literal == None || !sema_services_valid_name(literal ?? "") {
        diagnostics.push(sema_error("E0112", expr_span(name), "service worker name is outside the checked builder shape", "worker names must be non-empty visible literals of at most 256 bytes", "use a literal visible worker name"))
        valid = false
    }
    if sema_services_literal_int(capacity) == .Val(number) && number <= 0 {
        diagnostics.push(sema_error("E0112", expr_span(capacity), "service worker capacity is outside the checked builder shape", "a service worker needs a positive mailbox capacity", "use a positive integer capacity"))
        valid = false
    }
    handler_name := ""
    if {
        handler == .Ident(identifier, _, _) -> {
            handler_name = identifier
            // Only a body binding is a local; the root frame holds the module's
            // items and imports.
            if sema_scope_resolve_index(scopes, identifier) == .Val(index) && scopes.frames[scopes.bindings[index].frame].parent >= 0 {
                diagnostics.push(sema_error("E0112", expr_span(handler), "service worker handler lifetime is outside the checked builder shape", "service topology values must stay visible to sema before runtime construction", "pass a top-level function, not a local or captured function value"))
                valid = false
            }
        }
        else -> {
            diagnostics.push(sema_error("E0112", expr_span(handler), "service worker handler is outside the checked builder shape", "service handlers must be top-level functions and cannot capture local values", "pass a top-level function name"))
            valid = false
        }
    }
    if !valid -> return None
    Val(handler_name)
}

sema_services_labeled: fn(args: [CallArg], label: String) -> Bool Never! {
    loop argument in args {
        if argument.label == .Val(written) && written.name == label -> return true
    }
    false
}

sema_services_is_unit: fn(ty: Type) -> Bool Never! {
    if ty == .Tuple(fields) -> return fields.len() == 0
    ty == Type.Named{name: "Unit"}
}

// Whether a handler returning `ret` answers nothing: no result, or Unit under
// any failure contract.
sema_services_answers_nothing: fn(ret: Type?) -> Bool Never! {
    value: ret ?? return true
    if value == .Result(ok, _) -> return sema_services_is_unit(ok)
    sema_services_is_unit(value)
}

// `tree.worker(name, handler, …)` whose handler takes its message: the
// source call of Core's typed declaration, which answers Endpoint<Q, R>.
// The labels pick it: `state:` keeps the value the handler's `^S` first
// parameter edits (stateful_worker); `batch:` with `wait:` hands a `[Q]`
// handler up to `batch` waiting messages (batched_worker); otherwise the
// handler runs once per message (typed_worker). A message type that is
// Decode takes the durable form of each, whose handler also receives the
// receipts send_durable keeps. The name, capacity and handler keep the
// builder shape of every worker (sema_services_worker_shape).
sema_services_typed_worker: fn(receiver: Expr, handler_params: [Type], handler_ret: Type?, args: [CallArg], expected: Type?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    api: "ServiceTree.worker"
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    batched: sema_services_labeled(args, "batch") || sema_services_labeled(args, "wait")
    stateful: !batched && sema_services_labeled(args, "state")
    labels: if {
        batched -> [String]{"", "", "batch", "wait", "capacity"}
        stateful -> [String]{"", "", "state", "capacity"}
        else -> [String]{"", "", "capacity"}
    }
    updated_args := args
    if updated_args.len() != labels.len() {
        sema_services_report_arity(api, updated_args.len(), labels.len(), span, check.diagnostics)
        sema_services_check_untyped_args(updated_args, environment, program, check)
        return failed
    }
    if !sema_services_bind_labels(api, updated_args, labels, span, check.diagnostics) {
        sema_services_check_untyped_args(updated_args, environment, program, check)
        return failed
    }
    handler_span: expr_span(updated_args[1].expr)
    shape_errors: check.diagnostics.len()
    if {
        batched && (handler_params.len() != 1 || !(handler_params[0] == .List(_))) -> {
            check.diagnostics.push(sema_error("E0112", handler_span, "a batched worker's handler takes `[T]`", "`batch:` and `wait:` hand the handler a list of up to `batch` waiting messages", "take the batch as `fn(batch: [T])`, or remove `batch:` and `wait:`"))
        }
        batched && !sema_services_answers_nothing(handler_ret) -> {
            check.diagnostics.push(sema_error("E0112", handler_span, "a batched worker's handler answers nothing", "a batch has no one caller to answer, so a batched worker is reached by `send`, not `call`", "remove `batch:` and `wait:`, or the handler's result"))
        }
        stateful && handler_params.len() != 2 -> {
            check.diagnostics.push(sema_error("E0112", handler_span, "a stateful worker's handler takes the state first", "the worker keeps the `state:` value and lends it to each run of the handler as `^S`", "take the state first, as in `fn(s: ^S, q: Q)`, or remove `state:`"))
        }
        !batched && !stateful && handler_params.len() == 2 -> {
            check.diagnostics.push(sema_error("E0112", handler_span, "a handler that takes state needs `state:`", "a two-parameter handler takes the worker's state first, and `state:` gives its first value", "add `state:` with the worker's first state, or take only the message"))
        }
        handler_params.len() > 2 -> {
            check.diagnostics.push(sema_error("E0112", handler_span, "a worker handler takes one message", "each run of the handler takes one message, after the worker's state when it keeps one", "take the message as one parameter"))
        }
    }
    if batched && sema_services_literal_int(updated_args[2].expr) == .Val(size) && size <= 0 {
        check.diagnostics.push(sema_error("E0112", expr_span(updated_args[2].expr), "service worker batch is outside the checked builder shape", "a batch hands the handler at least one message", "use a positive batch size"))
    }
    shaped: sema_services_worker_shape(updated_args[0].expr, updated_args[1].expr, updated_args[labels.len() - 1].expr, check.scopes, check.diagnostics)
    if shaped == None || check.diagnostics.len() > shape_errors {
        sema_services_check_untyped_args(updated_args, environment, program, check)
        return failed
    }
    handler_name: shaped ?? ""
    registered := false
    graph: program.registration_graph
    resolved: sema_registration_lookup_name(graph, environment.module_identity, handler_name)
    if resolved == .Val(function) && sema_resolved_kind(graph, function) == SymbolKind.Function {
        registered = true
    }
    if !registered {
        check.diagnostics.push(sema_error("E0112", handler_span, "service worker handler has no checked top-level function identity", "service handlers must resolve to registered top-level function bodies", "pass a registered top-level function"))
        return failed
    }
    handled: if stateful -> handler_params[1] else -> handler_params[0]
    durable: if batched && handled == .List(element) -> sema_services_type_meets(element, "Decode", environment, program) else -> sema_services_type_meets(handled, "Decode", environment, program)
    // No program spells these names, so each is a Core source route
    // (CoreReach JET_DRIVER_SOURCE_ROUTES) that the load keeps:
    // ("core.service", "durable_batched_worker"), ("core.service", "batched_worker"),
    // ("core.service", "durable_stateful_worker"), ("core.service", "stateful_worker"),
    // ("core.service", "durable_worker"), ("core.service", "typed_worker").
    member: if {
        batched && durable -> "durable_batched_worker"
        batched -> "batched_worker"
        stateful && durable -> "durable_stateful_worker"
        stateful -> "stateful_worker"
        durable -> "durable_worker"
        else -> "typed_worker"
    }
    // The handler's name follows the handler, as Core's declaration takes it.
    source_args := [CallArg]{}
    loop (index, argument) in updated_args {
        source_args.push(argument)
        if index == 1 {
            source_args.push(CallArg{convention: AccessConvention.Read, expr: Expr.Str{parts: [StrPart]{StrPart.Lit{text: handler_name.copy()}}, span: handler_span, id: AST_NODE_GENERATED}, span: handler_span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false})
        }
    }
    sema_services_source_call(api, member, [Type]{}, receiver, AccessConvention.Write, source_args, span, expected, environment, program, check)
}

// Whether `ty` meets the compiler-owned `bound` where the call is written; a
// type parameter is not known to.
sema_services_type_meets: fn(ty: Type, bound: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    graph: program.registration_graph
    sema_type_bound_satisfied_at(graph, ty, bound, sema_scope_caller_row(environment, graph), environment.generic_params) ?? false
}

// `tree.send(endpoint, message)`, `tree.call(endpoint, message)` and
// `tree.send_durable(endpoint, message, key: k)` on a typed Endpoint<Q, R>:
// the source calls typed_send, call and typed_send_durable at the endpoint's
// Q and R, so a message of another type is a mismatch with the endpoint
// (E0112). A worker that answers is reached by `call`, since `send` has no
// place for its answer; a durable message is kept as JSON, so its type is
// Encode and Decode. None leaves the call to the String endpoint's method
// Core declares. It runs ahead of the declared-method check: Core declares
// the tree's `send` and `send_durable` over a ServiceEndpoint and a String,
// and a type parameter cannot tie a typed endpoint's message type to it.
sema_services_typed_delivery: fn(method: String, receiver: Expr, receiver_ty: Type, args: [CallArg], expected: Type?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck? {
    if method != "send" && method != "call" && method != "send_durable" -> return None
    if !sema_services_receiver_is(receiver_ty, "ServiceTree") -> return None
    durable: method == "send_durable"
    if args.len() != (if durable -> 3 else -> 2) -> return None
    endpoint: sema_expr_probe_type(args[0].expr, false, environment, program, check) ?? return None
    if endpoint == .Apply(name, endpoint_args) && endpoint_args.len() == 2 && core_identity_is(name, "core.service", "Endpoint") {
        rejected: SemaMethodSpecialCheck{handled: true, value: None}
        if method == "send" && !sema_services_is_unit(endpoint_args[1]) {
            check.diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "service send reaches a worker that answers", "this worker answers each message with {type_name(endpoint_args[1])}, and `send` has no place for the answer", "use `tree.call(endpoint, message)`, which returns the answer"))
            sema_services_check_untyped_args(args, environment, program, check)
            return Val(rejected)
        }
        // A program spells only `send` and `send_durable`, so each source is
        // a Core source route: ("core.service", "typed_send"),
        // ("core.service", "typed_send_durable").
        if !durable {
            member: if method == "send" -> "typed_send" else -> "call"
            return Val(sema_services_source_call("ServiceTree.{method}", member, endpoint_args, receiver, AccessConvention.Write, args, span, expected, environment, program, check))
        }
        updated_args := args
        if !sema_services_bind_labels("ServiceTree.send_durable", updated_args, [String]{"", "", "key"}, span, check.diagnostics) {
            sema_services_check_untyped_args(updated_args, environment, program, check)
            return Val(rejected)
        }
        if !sema_services_type_meets(endpoint_args[0], "Encode", environment, program) || !sema_services_type_meets(endpoint_args[0], "Decode", environment, program) {
            check.diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "durable service send needs a message that encodes and decodes", "send_durable keeps {type_name(endpoint_args[0])} as JSON until the worker's handler succeeds on it", "derive `Encode` and `Decode` on the worker's message type, or use `tree.send`"))
            sema_services_check_untyped_args(updated_args, environment, program, check)
            return Val(rejected)
        }
        return Val(sema_services_source_call("ServiceTree.send_durable", "typed_send_durable", endpoint_args, receiver, AccessConvention.Write, updated_args, span, expected, environment, program, check))
    }
    None
}

// `tree.worker(…)`; a typed endpoint's `send`, `call` and `send_durable` are
// sema_services_typed_delivery, and every other tree method is the
// ServiceTree method Core declares.
sema_check_service_tree_method: fn(method: String, receiver: Expr, receiver_value: TExpr, args: [CallArg], expected: Type?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck? {
    if !sema_services_receiver_is(receiver_value.ty, "ServiceTree") -> return None
    updated_args := args
    if method == "worker" {
        // A handler that takes its message declares a typed worker.
        if updated_args.len() > 1 && sema_expr_probe_type(updated_args[1].expr, false, environment, program, check) == .Val(probed) {
            if probed == .Fn(handler_params, handler_ret, _, _, _, _) && handler_params.len() > 0 {
                return Val(sema_services_typed_worker(receiver, handler_params, handler_ret, updated_args, expected, span, environment, program, check))
            }
        }
        if updated_args.len() != 3 {
            sema_services_report_arity("ServiceTree.worker", updated_args.len(), 3, span, check.diagnostics)
            sema_services_check_untyped_args(updated_args, environment, program, check)
            return Val(SemaMethodSpecialCheck{handled: true, value: None})
        }
        if !sema_services_bind_labels("ServiceTree.worker", updated_args, [String]{"", "", "capacity"}, span, check.diagnostics) {
            sema_services_check_untyped_args(updated_args, environment, program, check)
            return Val(SemaMethodSpecialCheck{handled: true, value: None})
        }
        values := [TExpr]{}
        valid := true
        name_value := sema_check_expression(updated_args[0].expr, Val(Type.String), environment, program, check)
        if name_value == .Val(item) -> values.push(item) else -> valid = false
        handler_type := Type.Fn{params: [Type]{}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
        handler_value := sema_check_expression(updated_args[1].expr, Val(handler_type), environment, program, check)
        if handler_value == .Val(item) -> values.push(item) else -> valid = false
        capacity_value := sema_check_expression(updated_args[2].expr, Val(Type.Int), environment, program, check)
        if capacity_value == .Val(item) -> values.push(item) else -> valid = false
        shaped: sema_services_worker_shape(updated_args[0].expr, updated_args[1].expr, updated_args[2].expr, check.scopes, check.diagnostics)
        if !valid || shaped == None {
            return Val(SemaMethodSpecialCheck{handled: true, value: None})
        }
        handler_name: shaped ?? ""
        handler := values[1]
        handler_symbol: sema_services_const_symbol(handler, check.context)
        registered_function := false
        graph: program.registration_graph
        resolved := sema_registration_lookup_name(graph, environment.module_identity, handler_name)
        if resolved == .Val(function) && sema_resolved_kind(graph, function) == SymbolKind.Function {
            if handler_symbol == .Val(symbol) && symbol == sema_resolved_id(graph, function) {
                registered_function = true
            }
        }
        if !registered_function {
            check.diagnostics.push(sema_error("E0112", expr_span(updated_args[1].expr), "service worker handler has no checked top-level function identity", "service handlers must resolve to registered top-level function bodies", "pass a registered top-level function"))
            return Val(SemaMethodSpecialCheck{handled: true, value: None})
        }
        core_args := [TExpr]{receiver_value, values[0], handler, sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: handler_name}}}, span), values[2]}
        record: sema_call_core_record("core.service", "worker", core_args.len(), span, check.diagnostics) ?? return Val(SemaMethodSpecialCheck{handled: true, value: None})
        // The handler is a checked top-level function identity, not storage
        // the caller owns: naming it lends nothing and moves nothing.
        params := sema_services_method_params([Type]{Type.String, handler_type, Type.Int}, [AccessConvention]{sema_call_core_access(record, 1) ?? AccessConvention.Read, AccessConvention.Read, sema_call_core_access(record, 4) ?? AccessConvention.Read})
        sema_call_note_route_implicit_takes(params, updated_args, values, environment, program, check.scopes, check.state, check.context)
        ownership := sema_ownership_check_method_call(check.state, "ServiceTree.worker", receiver, AccessConvention.Write, params, updated_args, check.scopes, span, check.diagnostics)
        if !ownership.accepted || !ownership.complete {
            return Val(SemaMethodSpecialCheck{handled: true, value: None})
        }
        fallbacks := [AccessConvention]{AccessConvention.Write, AccessConvention.Read, AccessConvention.Read, AccessConvention.Read, AccessConvention.Read}
        return Val(sema_services_core_call(record, core_args, fallbacks, true, false, sema_services_result_type(Type.Named{name: "ServiceEndpoint"}), expected, span, environment, program, check.scopes, check.context, check.diagnostics))
    }
    None
}

SemaServiceWorkerHandler: struct {
    key: String,
    name: String,
    span: Span,
}

// A checked function's position: its module row and its row in that module's
// functions.
SemaServiceFunctionRow: struct {
    module_index: Int,
    function_index: Int,
}

// The checked type name of the Core nominal `leaf` that `module_name` declares:
// its qualified source name, or the leaf for a compiler-owned nominal. The
// checked #Job identity is normalized BEFORE the registered source target, a
// compiler-owned contract: enqueue/delay are not string-selected public
// operations.
sema_core_module_nominal: fn(program: SemaProgramTables, module_name: String, leaf: String) -> String Never! {
    graph: program.registration_graph
    loop module_index in 0..<graph.modules.len() {
        if graph.modules[module_index].module_name != module_name -> next
        loop nominal_index in 0..<graph.modules[module_index].nominals.len() {
            // Read in place: binding the row copied each module nominal.
            if graph.modules[module_index].nominals[nominal_index].symbol.name == leaf {
                if graph.modules[module_index].nominals[nominal_index].compiler_owned {
                    return leaf.copy()
                }
                return "{module_text(graph.module_table, graph.modules[module_index].nominals[nominal_index].symbol.module_identity)}.{leaf}"
            }
        }
    }
    leaf.copy()
}

sema_job_queue_function: fn(expression: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaRegistrationRowRef? {
    if expression == .Paren(inner, _, _) {
        return sema_job_queue_function(inner, environment, program)
    }
    name: if expression == {
        .Ident(name, _, _) -> name
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
            return None
        }
    }
    graph: program.registration_graph
    resolved: sema_registration_lookup_name(graph, environment.module_identity, name) ?? return None
    if sema_resolved_kind(graph, resolved) != SymbolKind.Function -> return None
    module_index: sema_registration_module_index(graph, resolved.source_module_identity) ?? return None
    id: sema_resolved_id(graph, resolved)
    loop index in 0..<graph.modules[module_index].functions.len() {
        if graph.modules[module_index].functions[index].symbol.id != id -> next
        if !graph.modules[module_index].functions[index].declaration.is_job || graph.modules[module_index].functions[index].declaration.params.len() != 1 {
            return None
        }
        return Val(SemaRegistrationRowRef{module_index: module_index, row: index})
    }
    return None
}

sema_job_queue_identity_error: fn(method: String, span: Span) -> Diagnostic Never! {
    sema_error("E0112", span, "`JobQueue.{method}` expects a checked `#Job` function", "the queue identity is attached to the declared #Job and cannot be selected by an arbitrary function value", "pass the name of a #Job function with exactly one payload parameter")
}

sema_call_try_job_queue_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    unhandled: SemaMethodSpecialCheck{handled: false, value: None}
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    if method != "enqueue" && method != "delay" -> return unhandled
    queue_name: if receiver_value.ty == {
        .Named(name) -> name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            return unhandled
        }
    }
    if queue_name != "JobQueue" && !(core_source_owns_type(queue_name) && queue_name.ends_with(".JobQueue")) {
        return unhandled
    }
    if !sema_ownership_check_call_receiver(check.state, receiver, AccessConvention.Write, check.scopes, span, check.diagnostics) {
        return failed
    }
    required: if method == "enqueue" -> 2 else -> 3
    if args.len() != required && !(method == "enqueue" && args.len() == 3) {
        sema_services_report_arity(method, args.len(), required, span, check.diagnostics)
        sema_services_check_untyped_args(args, environment, program, check)
        return failed
    }
    updated_args := args
    if args.len() == 3 && !sema_services_bind_labels("JobQueue.{method}", updated_args, [String]{"", "", if method == "enqueue" -> "key" else -> "for"}, span, check.diagnostics) {
        return failed
    }
    job: sema_job_queue_function(updated_args[0].expr, environment, program) ?? {
        check.diagnostics.push(sema_job_queue_identity_error(method, expr_span(updated_args[0].expr)))
        sema_services_check_untyped_args(updated_args, environment, program, check)
        return failed
    }
    graph: program.registration_graph
    job_name: graph.modules[job.module_index].functions[job.row].declaration.name
    payload_type: sema_type_resolve_declared_with_generics(graph, graph.modules[job.module_index].functions[job.row].declaration.params[0].ty, graph.modules[job.module_index].module_identity, [TGenericParam]{})
    job_span: expr_span(updated_args[0].expr)
    updated_args[0].expr = Expr.Str{parts: [StrPart]{StrPart.Lit{text: job_name}}, span: job_span, id: AST_NODE_GENERATED}
    sema_call_http_check_serde(SemaSerdeDirection.Encode, payload_type, expr_span(updated_args[1].expr), environment, program, check.diagnostics)
    payload: sema_check_expression(updated_args[1].expr, Val(payload_type), environment, program, check) ?? return failed
    last_type: if method == "enqueue" -> Type.Option{inner: Type.String} else -> Type.Named{name: "Duration"}
    last: if updated_args.len() == 3 -> sema_check_expression(updated_args[2].expr, Val(last_type), environment, program, check) ?? return failed else -> sema_node(check.context, last_type, NodeKind.Absent, span)
    parameter_types: if updated_args.len() == 3 -> [Type]{Type.String, payload_type, last_type} else -> [Type]{Type.String, payload_type}
    params: sema_services_method_params(parameter_types, [AccessConvention]{})
    ownership: sema_ownership_check_method_call(check.state, "JobQueue.{method}", receiver, AccessConvention.Write, params, updated_args, check.scopes, span, check.diagnostics)
    if !ownership.accepted || !ownership.complete -> return failed
    // Source takes its immutable shared handle as a normal read, not the old
    // native mutable carrier. Receiver ownership has already been checked.
    normalized: [TExpr]{receiver_value, sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: job_name}}}, job_span), payload, last}
    record: sema_call_core_receiver_record(Type.Named{name: "JobQueue"}, method, normalized.len(), span, check.diagnostics) ?? return failed
    result_type: sema_services_result_type(Type.Named{name: sema_core_module_nominal(program, "core.jobs", "JobQueueReceipt")})
    failure: sema_services_result_carrier(result_type)
    if !sema_call_core_record_effects(record, span, [Type]{payload_type}, result_type, failure, [FunctionDefaultRef]{}, check.scopes, check.context, environment, program, check.diagnostics) {
        return failed
    }
    value: sema_call_core_tree(record, normalized, span, [Type]{payload_type}, [Bool]{}, result_type, failure, expected, environment, program, check.diagnostics)
    return SemaMethodSpecialCheck{handled: true, value: value}
}
