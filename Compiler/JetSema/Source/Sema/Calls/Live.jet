// `live`, `subscribe`, `push` and `invalidate` (in `app`) name
// a source function and the arguments of one call to it. The checker proves
// the source is a named function whose result and error types are Encode and
// Decode (and, for `live`, that it only reads the database; for `subscribe`,
// that it declares no effect beyond `DB.Read`, `Net` and `Time`), checks the
// arguments as a call to it, and lowers the call to the module's `__live_*`
// helper: each argument is evaluated once into a hidden local, the encoded
// arguments name the binding, and the closure that re-runs the source owns
// the locals. A read-only parameter is copied into its local, or, where no
// closure keeps it, read straight into the key.
//
// `live` also takes a closure, `app.live(fn() { remote.method(args) })`,
// which must be one call of an `app.Remote<S>` endpoint with codable
// arguments (E2816 otherwise). It lowers as a named source does: the
// arguments are evaluated once, and the binding is keyed by the service's
// method and their encodings.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    Call,
    CallArg,
    Diagnostic,
    diagnostic_registry_row,
    EffectRowEntry,
    Expr,
    Lambda,
    LambdaBody,
    LambdaParam,
    NamedSpan,
    Span,
    StrPart,
    SymbolKind,
    Type,
    ast_binding,
    AST_EMPTY_CALL_ARG_FLAGS,
    ast_empty_lambda_meta,
    expr_span,
    owned_trait_codec_names,
    module_text,
    sema_effect_covers,
]

// A live source: a named function, or, for a closure, the endpoint method
// its one call names on the Remote held by `receiver` ("" for a named
// function), with that call's arguments and node ids.
SemaLiveSource: struct {
    name: String,
    wire: String,
    params: [Type],
    ok: Type,
    err: Type,
    receiver: String,
    receiver_span: Span,
    receiver_id: Int,
    call_span: Span,
    call_id: Int,
    args: [CallArg],
}

sema_live_arg: fn(expression: Expr, span: Span) -> CallArg Never! {
    CallArg{
        convention: AccessConvention.Read,
        expr: expression,
        span: span,
        flags: AST_EMPTY_CALL_ARG_FLAGS,
        label: None,
        spread: false,
    }
}

sema_live_string: fn(text: String, span: Span) -> Expr Never! {
    Expr.Str{parts: [StrPart]{StrPart.Lit{text: text}}, span: span, id: AST_NODE_GENERATED}
}

// `alias.member(args)` written as a method call on the module alias, the
// form both the Core-alias and the source-module routes resolve.
sema_live_module_call: fn(alias: String, member: String, type_args: [Type], args: [CallArg], span: Span) -> Expr Never! {
    Expr.MethodCall{receiver: Expr.Ident{name: alias, span: span, id: AST_NODE_GENERATED}, method: member, method_span: span, owner_type_args: [Type]{}, type_args: type_args, args: args, id: AST_NODE_GENERATED}
}

sema_live_unhandled: fn() -> SemaDirectSpecialCheck Never! {
    SemaDirectSpecialCheck{handled: false, value: None}
}

sema_live_rejected: fn() -> SemaDirectSpecialCheck Never! {
    SemaDirectSpecialCheck{handled: true, value: None}
}

// Whether `module_name.member` is one of the live-binding calls, `enqueue`
// (sema_call_enqueue), `endpoints` (sema_call_app_endpoints), `url_of`,
// `presence`, `notify` or `go`, which take a screen state's address
// (sema_call_app_address), or `current` (sema_call_app_current).
sema_live_member: fn(module_name: String, member: String) -> Bool Never! {
    module_name == "app" && (member == "live" || member == "subscribe" || member == "push" || member == "invalidate" || member == "enqueue" || member == "endpoints" || member == "url_of" || member == "presence" || member == "notify" || member == "go" || member == "current")
}

// A live-binding call through a Core module alias (`use app`).
sema_call_try_live: fn(module_name: String, member: String, alias: String, alias_span: Span, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if !sema_live_member(module_name, member) -> return sema_live_unhandled()
    // A nested module path (`alias.leaf.member`) names another module.
    imported_module: sema_call_core_import_module(environment, program, alias) ?? return sema_live_unhandled()
    if imported_module != module_name -> return sema_live_unhandled()
    imported: sema_call_core_import_target(environment, program, alias) ?? return sema_live_unhandled()
    if !sema_call_core_record_import_reference(environment, program, scopes, imported, alias_span, context) {
        return sema_live_unhandled()
    }
    sema_call_live(member, alias, args, type_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

// `alias.member(source, args...)`, where `alias` names `app`
// and the import is already recorded.
sema_call_live: fn(member: String, alias: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if member == {
        "enqueue" -> return sema_call_enqueue(alias, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        "endpoints" -> return sema_call_app_endpoints(alias, type_args, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        "url_of" | "presence" | "notify" | "go" -> return sema_call_app_address(member, alias, args, type_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        "current" -> return sema_call_app_current(alias, args, type_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        else -> {}
    }
    callee: "{alias}.{member}"
    positional := [CallArg]{}
    every := Expr?{None}
    value := Expr?{None}
    loop argument in args {
        if argument.spread {
            diagnostics.push(sema_error("E0104", argument.span, "`{callee}` can't spread its arguments", "the arguments after the source are checked as one call to it", "pass each argument of the source call"))
            return sema_live_rejected()
        }
        if argument.label == .Val(label) {
            if member == "subscribe" && label.name == "every" && every == None {
                every = Val(argument.expr.copy())  // copy: the caller's argument list keeps its expression
                next
            }
            if member == "push" && label.name == "value" && value == None {
                value = Val(argument.expr.copy())  // copy: the caller's argument list keeps its expression
                next
            }
            diagnostics.push(sema_error("E0104", label.span, "`{callee}` has no parameter `{label.name}`", sema_live_shape(member), "remove the `{label.name}:` argument"))
            return sema_live_rejected()
        }
        positional.push(argument.copy())  // copy: the caller's argument list keeps its arguments
    }
    if positional.len() == 0 {
        diagnostics.push(sema_error("E0104", span, "`{callee}` needs a source function", sema_live_shape(member), "pass the source function first, then its arguments"))
        return sema_live_rejected()
    }
    source_span: expr_span(positional[0].expr)
    found: if member == "live" && sema_live_is_closure(positional[0].expr) -> sema_live_remote_source(positional[0].expr, positional.len() - 1, environment, program, scopes, diagnostics) else -> sema_live_source(positional[0].expr, member, environment, program, scopes, diagnostics)
    source: found ?? return sema_live_rejected()
    // A closure's one call gives the arguments; a named source's follow it.
    first := 1
    if source.receiver != "" {
        positional = source.args.move()
        first = 0
    }
    supplied: positional.len() - first
    if member == "push" && value == None {
        diagnostics.push(sema_error("E0104", span, "`{callee}` needs the pushed value", sema_live_shape(member), "add `value: ...` after the source's arguments"))
        return sema_live_rejected()
    }
    whole_source: member == "invalidate" && supplied == 0
    if !whole_source && supplied != source.params.len() {
        diagnostics.push(sema_call_arity_diagnostic(source.name, source.params.len(), supplied, false, source_span))
        return sema_live_rejected()
    }
    graph: program.registration_graph ?? return sema_live_rejected()
    sema_scope_enter(scopes, state, "live:{span.start}")
    body := [TStmt]{}
    keys := [Expr]{}
    reads := [CallArg]{}
    takes := [NamedSpan]{}
    // A read-only parameter passed as an argument stays its caller's: the
    // closure that re-runs the source owns a copy of it, and a call that runs
    // nothing later (`push`, `invalidate`) only reads it into the key.
    keeps_run: member == "live" || member == "subscribe"
    loop index in 0..<supplied {
        argument: positional[index + first]
        encodes: sema_type_bound_satisfied(graph, source.params[index], "Encode", environment.module_identity) == (Val(true))
        borrowed: sema_copy_site_borrowed_param(argument.expr, scopes) != None
        given: argument.expr.copy()  // copy: `positional` keeps its argument
        param_ty: source.params[index].copy()  // copy: the source signature keeps its parameter types
        if borrowed && encodes && !keeps_run {
            keys.push(sema_live_module_call(alias, "__live_arg", [Type]{param_ty}, [CallArg]{sema_live_arg(given, argument.span)}, argument.span))
            next
        }
        local_name: "__jet_live_{span.start}_{index}"
        init: if borrowed -> Expr.Copy{value: given, span: argument.span, id: AST_NODE_GENERATED} else -> given
        binding := ast_binding(local_name, argument.span, false, init, None)
        binding.ty = Val(param_ty)
        statement: sema_stmt_check_binding(binding, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            sema_single_use_leave_scope(scopes, state, diagnostics)
            return sema_live_rejected()
        }
        body.push(statement)
        read: Expr.Ident{name: local_name, span: argument.span, id: AST_NODE_GENERATED}
        // An argument with no encoding (a database scope, a handle) does not
        // tell bindings apart.
        if encodes {
            keys.push(sema_live_module_call(alias, "__live_arg", [Type]{}, [CallArg]{sema_live_arg(read.copy(), argument.span)}, argument.span))
        } else { keys.push(sema_live_string("_", argument.span)) }
        reads.push(sema_live_arg(read, argument.span))
        takes.push(NamedSpan{name: "{local_name}", span: argument.span})
    }
    wire: sema_live_string(source.wire, span)
    key_name: "__jet_live_{span.start}_key"
    key_binding := ast_binding(key_name, span, false, Expr.ListLit{elements: keys, span: span, id: AST_NODE_GENERATED}, None)
    key_binding.ty = Val(Type.List{element: Type.String})
    if !whole_source {
        key_statement: sema_stmt_check_binding(key_binding, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            sema_single_use_leave_scope(scopes, state, diagnostics)
            return sema_live_rejected()
        }
        body.push(key_statement)
    }
    key: Expr.Ident{name: key_name, span: span, id: AST_NODE_GENERATED}
    // The pushed value is checked against the source's value type here, so a
    // mismatch names `push` rather than the call it lowers to.
    pushed := Expr?{None}
    if value == .Val(given) {
        value_name: "__jet_live_{span.start}_value"
        value_binding := ast_binding(value_name, expr_span(given), false, given.copy(), None)  // copy: `value` keeps the caller's expression
        value_binding.ty = Val(source.ok.copy())  // copy: the source signature keeps its value type
        value_statement: sema_stmt_check_binding(value_binding, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            sema_single_use_leave_scope(scopes, state, diagnostics)
            return sema_live_rejected()
        }
        body.push(value_statement)
        pushed = Val(Expr.Ident{name: value_name, span: expr_span(given), id: AST_NODE_GENERATED})
    }
    // A closure's call keeps its own node ids, so the Remote's receiver is
    // checked as the written call it is.
    invocation: if source.receiver == "" -> Expr.Call{call: Call{name: source.name, name_span: span, type_args: [Type]{}, args: reads}, id: AST_NODE_GENERATED} else -> Expr.MethodCall{receiver: Expr.Ident{name: "{source.receiver}", span: source.receiver_span, id: source.receiver_id}, method: "{source.name}", method_span: source.call_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: reads, id: source.call_id}
    run: Expr.Lambda{lambda: Lambda{take_names: takes, params: [LambdaParam]{}, effects: None, body: LambdaBody.Expr{value: invocation}, span: span, meta: ast_empty_lambda_meta()}, id: AST_NODE_GENERATED}
    lowered: if member == {
        "live" -> sema_live_module_call(alias, "__live_bind", [Type]{source.ok.copy(), source.err.copy()}, [CallArg]{sema_live_arg(wire, span), sema_live_arg(key, span), sema_live_arg(run, span)}, span)
        "subscribe" -> sema_live_module_call(alias, "__live_poll", [Type]{source.ok.copy(), source.err.copy()}, [CallArg]{sema_live_arg(wire, span), sema_live_arg(key, span), sema_live_arg(every ?? Expr.Absent{span: span, id: AST_NODE_GENERATED}, span), sema_live_arg(run, span)}, span)
        "push" -> sema_live_module_call(alias, "__live_push", [Type]{source.ok.move()}, [CallArg]{sema_live_arg(wire, span), sema_live_arg(key, span), sema_live_arg(pushed ?? panic("push value was checked above"), span)}, span)
        else -> if whole_source -> sema_live_module_call(alias, "__live_invalidate_all", [Type]{}, [CallArg]{sema_live_arg(wire, span)}, span) else -> sema_live_module_call(alias, "__live_invalidate", [Type]{}, [CallArg]{sema_live_arg(wire, span), sema_live_arg(key, span)}, span)
    }
    checked: sema_check_expression(lowered, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
        sema_single_use_leave_scope(scopes, state, diagnostics)
        return sema_live_rejected()
    }
    result_type: checked.ty.copy()  // copy: the block's value keeps its own type
    body.push(TStmt.ExprStmt{value: checked, span: span})
    sema_single_use_leave_scope(scopes, state, diagnostics)
    lowered_value: sema_tree_node(result_type, TExprKind.InlineBlock{body: body}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(lowered_value, expected, environment, program, diagnostics)}
}

sema_live_shape: fn(member: String) -> String Never! {
    if member == {
        "live" -> "`live(query, args...)` binds a database query to one argument list"
        "subscribe" -> "`subscribe(source, args..., every:)` binds a source to one argument list, optionally polled"
        "push" -> "`push(source, args..., value:)` publishes a value for one argument list of the source"
        else -> "`invalidate(source)` re-runs every binding of the source; `invalidate(source, args...)` re-runs exactly that argument list"
    }
}

// The named source function: its wire name (module path and name), parameter
// types, and result and error types, each Encode and Decode.
sema_live_source: fn(expression: Expr, member: String, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaLiveSource? {
    source_span: expr_span(expression)
    name: if expression == {
        .Ident(written, _, _) -> written
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
            diagnostics.push(sema_error("E0112", source_span, "a live source must be a function name", "a live binding re-runs its source by name, and the source's module path names it on the wire", "declare the source as a top-level `fn` and pass its name"))
            return None
        }
    }
    index: sema_scope_resolve_index(scopes, name) ?? {
        diagnostics.push(sema_unknown_name_in(name, source_span, scopes))
        return None
    }
    if scopes.bindings[index].symbol.kind != SymbolKind.Function {
        diagnostics.push(sema_error("E0112", source_span, "`{name}` is a value, not a named function", "a live binding re-runs its source by name, and the source's module path names it on the wire; a closure has no such name", "declare the source as a top-level `fn` and pass its name"))
        return None
    }
    ty: sema_scope_binding_type(environment, scopes, index) ?? return None
    if ty == .Fn(params, ret, effect_bound, _, metadata, _) {
        if metadata == .Val(call) {
            loop convention in call.conventions {
                if convention != AccessConvention.Read {
                    diagnostics.push(sema_error("E0112", source_span, "`{name}` takes or writes an argument", "a live binding keeps its arguments and re-runs its source with them", "make every parameter of `{name}` a read parameter"))
                    return None
                }
            }
        }
        result: ret ?? Type.Named{name: "Unit"}
        if result == .Result(ok, err) {
            if member == "live" && !sema_live_reads_only(name, effect_bound, source_span, diagnostics) {
                return None
            }
            if member == "subscribe" && !sema_live_subscribable(name, effect_bound, source_span, diagnostics) {
                return None
            }
            graph: program.registration_graph ?? return None
            if !sema_live_codable(graph, name, "result", ok, environment, source_span, diagnostics) {
                return None
            }
            if !sema_live_codable(graph, name, "error", err, environment, source_span, diagnostics) {
                return None
            }
            return Val(SemaLiveSource{name: name.copy(), wire: "{module_text(graph.module_table, scopes.bindings[index].symbol.module_identity)}.{scopes.bindings[index].symbol.name}", params: params.copy(), ok: ok.copy(), err: err.copy(), receiver: "", receiver_span: source_span, receiver_id: AST_NODE_GENERATED, call_span: source_span, call_id: AST_NODE_GENERATED, args: [CallArg]{}})
        }
        diagnostics.push(sema_error("E0112", source_span, "`{name}` can't fail, so its binding has no error to carry", "a live binding's state is loaded or failed with the source's own error", "declare `{name}` with the error it reports: `-> {sema_type_show(result)} E!`"))
        return None
    }
    diagnostics.push(sema_error("E0112", source_span, "`{name}` is not a function", "a live binding re-runs a named function", "pass a top-level `fn`"))
    None
}

// Whether `expression` is a closure, which `live` takes as one remote call.
sema_live_is_closure: fn(expression: Expr) -> Bool Never! {
    if expression == .Lambda(_, _) -> return true
    false
}

// An `app.live` closure that is not one remote call: E2816, naming what it
// is instead.
sema_live_not_remote: fn(found: String, at: Span, diagnostics: &[Diagnostic]) -> SemaLiveSource? {
    entry: diagnostic_registry_row("E2816") ?? panic("E2816 must have a registry row")
    diagnostics.push(sema_error("E2816", at, entry.what.replace("{{found}}", found), entry.why, entry.fix))
    None
}

// The closure `expression` given to `live`, which must take no parameters
// and be one call, `remote.method(args)` (sema_live_remote_call). `extra`
// counts the arguments written after it; its call gives them instead.
sema_live_remote_source: fn(expression: Expr, extra: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaLiveSource? {
    span: expr_span(expression)
    if extra != 0 {
        return sema_live_not_remote("arguments follow it, but its one call gives them", span, diagnostics)
    }
    if expression == .Lambda(lambda, _) {
        if lambda.params.len() != 0 {
            return sema_live_not_remote("it takes parameters", span, diagnostics)
        }
        if lambda.body == .Expr(value) {
            return sema_live_remote_call(value, span, environment, program, scopes, diagnostics)
        }
        if lambda.body == .Block(statements) {
            if statements.len() == 1 {
                if statements[0] == .Expr(value) {
                    return sema_live_remote_call(value, span, environment, program, scopes, diagnostics)
                }
            }
        }
        return sema_live_not_remote("its body is not one call", span, diagnostics)
    }
    None
}

// The closure's one call, which must be a method call without type
// arguments on a name that holds an `app.Remote<S>`.
sema_live_remote_call: fn(call: Expr, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaLiveSource? {
    if call == .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, call_id) {
        if owner_type_args.len() != 0 || type_args.len() != 0 {
            return sema_live_not_remote("its call has type arguments", method_span, diagnostics)
        }
        holder := ""
        holder_span := method_span
        holder_id := AST_NODE_GENERATED
        if receiver == .Ident(written, at, id) {
            holder = "{written}"
            holder_span = at
            holder_id = id
        }
        if holder == "" {
            return sema_live_not_remote("the receiver of `{method}` is not a name that holds an `app.Remote`", expr_span(receiver), diagnostics)
        }
        index: sema_scope_resolve_index(scopes, holder) ?? return sema_live_not_remote("`{holder}` names nothing here", holder_span, diagnostics)
        held: sema_scope_binding_type(environment, scopes, index) ?? return None
        remote_ty: sema_call_resolved_type(held, environment, program)
        if remote_ty == .Apply(_, remote_args) {
            if remote_args.len() == 1 && sema_app_is_remote(remote_ty, environment, program) {
                return sema_live_remote_endpoint(remote_args[0], holder, holder_span, holder_id, method, method_span, args, call_id, environment, program, diagnostics)
            }
        }
        return sema_live_not_remote("`{holder}` is a {sema_type_show_quoted(remote_ty)}, not an `app.Remote`", holder_span, diagnostics)
    }
    sema_live_not_remote("its body is not a method call on an `app.Remote`", span, diagnostics)
}

// `method`, called with `args` through the Remote `holder` of the service
// `service`, as a live source: it must be an `#App.SignedIn` or
// `#App.Public` method of the service that can fail, passed each argument
// in its place, and each parameter type must be Encode and Decode. Its wire
// name is the service's module path, name and method; its result and error
// are the method's.
sema_live_remote_endpoint: fn(service: Type, holder: String, holder_span: Span, holder_id: Int, method: String, method_span: Span, args: [CallArg], call_id: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> SemaLiveSource? {
    graph: program.registration_graph ?? return None
    row: sema_type_resolve_nominal_row(graph, service, environment.module_identity) ?? return None
    service_module: graph.modules[row.module_index].module_identity
    service_name: graph.modules[row.module_index].nominals[row.row].symbol.name
    definition: sema_http_route_find_struct(environment, program, service, environment.module_identity) ?? return None
    at: loop (index, candidate) in definition.methods {
        if candidate.name != method -> next
        endpoint: loop marker in candidate.markers {
            if sema_app_endpoint_marker(marker, graph, service_module) {
                break true
            }
        } ?? false
        if endpoint {
            break index
        }
    } ?? return sema_live_not_remote("`{service_name}.{method}` is not an `#App.SignedIn` or `#App.Public` method", method_span, diagnostics)
    declaration: definition.methods[at]
    loop (index, argument) in args {
        name := ""
        if index + 1 < declaration.params.len() -> name = "{declaration.params[index + 1].name}"
        relabeled: if {
            argument.label == .Val(label) -> label.name != name
            else -> false
        }
        if argument.spread || relabeled {
            return sema_live_not_remote("argument {index + 1} of `{method}` is not passed in its place", argument.span, diagnostics)
        }
    }
    params := [Type]{}
    loop index in 1..<declaration.params.len() {
        param: sema_type_resolve_declared(graph, declaration.params[index].ty, service_module)
        missing: loop codec in owned_trait_codec_names() {
            if sema_type_bound_satisfied(graph, param, codec, environment.module_identity) != (Val(true)) {
                break "{codec}"
            }
        } ?? ""
        if missing != "" {
            at_argument: if index - 1 < args.len() -> args[index - 1].span else -> method_span
            return sema_live_not_remote("parameter `{declaration.params[index].name}` of `{service_name}.{method}` has the type {sema_type_show_quoted(param)}, which isn't `{missing}`", at_argument, diagnostics)
        }
        params.push(param)
    }
    declared: sema_type_resolve_declared(graph, declaration.return_type ?? Type.Named{name: "Unit"}, service_module)
    // As with a named source, the binding's error is the method's own.
    if !(declared == .Result(_, _)) {
        return sema_live_not_remote("`{service_name}.{method}` can't fail, so its binding has no error of its own to carry", method_span, diagnostics)
    }
    made := SemaLiveSource{name: "{method}", wire: "{module_text(graph.module_table, service_module)}.{service_name}.{method}", params: params, ok: Type.Named{name: "Unit"}, err: Type.Named{name: "Unit"}, receiver: "{holder}", receiver_span: holder_span, receiver_id: holder_id, call_span: method_span, call_id: call_id, args: args.copy()}  // copy: the written closure keeps its call's arguments
    if declared == .Result(value, failure) {
        made.ok = value
        made.err = failure
    }
    if !sema_live_codable(graph, "{service_name}.{method}", "result", made.ok, environment, method_span, diagnostics) {
        return None
    }
    if !sema_live_codable(graph, "{service_name}.{method}", "error", made.err, environment, method_span, diagnostics) {
        return None
    }
    Val(made)
}

// A `live` query may only read the database: its declared effects are
// `DB.Read` at most.
sema_live_reads_only: fn(name: String, effect_bound: [EffectRowEntry]?, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    rows: effect_bound ?? {
        diagnostics.push(sema_error("E0740", span, "`{name}` declares no effects, so a live query can't prove it only reads", "`live` re-runs its query whenever the data it read changes, so the query may only read the database", "declare it `{name}: fn(...) -[DB.Read]> ...`, or use `subscribe` for a source that also fetches over `Net` or waits on `Time`"))
        return false
    }
    loop row in rows {
        if row.name != "DB.Read" {
            diagnostics.push(sema_error("E0740", span, "`{name}` uses the effect `{row.name}`, which a live query doesn't allow", "`live` re-runs its query whenever the data it read changes, so the query may only read the database", "keep the query to `-[DB.Read]>`, or use `subscribe` for a source that also fetches over `Net` or waits on `Time`"))
            return false
        }
    }
    true
}

// A `subscribe` source declares only `DB.Read`, `Net` and `Time` effects: a
// binding re-runs its source wherever `state` reads it, a server or a
// browser, and every such target provides those (`app.Live` bounds its run to
// them). A source that declares none is held to that bound by its body's
// inferred effects where the binding is made.
sema_live_subscribable: fn(name: String, effect_bound: [EffectRowEntry]?, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    rows: effect_bound ?? return true
    loop row in rows {
        if sema_effect_covers("DB.Read", row.name) || sema_effect_covers("Net", row.name) || sema_effect_covers("Time", row.name) {
            next
        }
        diagnostics.push(sema_error("E0740", span, "`{name}` uses the effect `{row.name}`, which a subscribed source doesn't allow", "a binding re-runs its source wherever its state is read, on a server or in a browser, so a source may only read the database (`DB.Read`), fetch over `Net` and wait on `Time`", "keep `{name}` to `-[DB.Read, Net, Time]>`, and do the `{row.name}` work outside the source"))
        return false
    }
    true
}

sema_live_codable: fn(graph: SemaRegistrationGraph, name: String, role: String, ty: Type, environment: SemaScopeEnvironment, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    missing: loop codec in owned_trait_codec_names() {
        if sema_type_bound_satisfied(graph, ty, codec, environment.module_identity) != (Val(true)) {
            break codec.copy()
        }
    } ?? ""
    if missing == "" -> return true
    diagnostics.push(sema_error("E0112", span, "`{name}`'s {role} type {sema_type_show(ty)} isn't `{missing}`", "a live binding stores and sends its source's result and error as encoded data", "derive `Encode` and `Decode` for {sema_type_show(ty)}"))
    false
}
