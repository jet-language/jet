// `live`, `subscribe`, `push` and `invalidate` (in `app` and `core.web`) name
// a source function and the arguments of one call to it. The checker proves
// the source is a named function whose result and error types are Encode and
// Decode (and, for `live`, that it only reads the database), checks the
// arguments as a call to it, and lowers the call to the module's `__live_*`
// helper: each argument is evaluated once into a hidden local, the encoded
// arguments name the binding, and the closure that re-runs the source owns
// the locals.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    Call,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    Lambda,
    LambdaBody,
    LambdaParam,
    NamedSpan,
    Span,
    StrPart,
    SymbolKind,
    Type,
    ast_binding,
    ast_empty_call_arg_flags,
    ast_empty_lambda_meta,
    expr_span,
    owned_trait_codec_names,
]

SemaLiveSource: struct {
    name: String
    wire: String
    params: [Type]
    ok: Type
    err: Type
}

sema_live_arg: fn(expression: Expr, span: Span) -> CallArg Never! {
    CallArg{convention: AccessConvention.Read, expr: expression, span: span,
        flags: ast_empty_call_arg_flags(), label: None, spread: false}
}

sema_live_string: fn(text: String, span: Span) -> Expr Never! {
    Expr.Str{parts: [StrPart]{StrPart.Lit{text: text}}, span: span, id: AST_NODE_GENERATED}
}

// `alias.member(args)` written as a method call on the module alias, the
// form both the Core-alias and the source-module routes resolve.
sema_live_module_call: fn(alias: String, member: String, type_args: [Type], args: [CallArg], span: Span) -> Expr Never! {
    Expr.MethodCall{receiver: Expr.Ident{name: alias, span: span, id: AST_NODE_GENERATED}, method: member, method_span: span, owner_type_args: [Type]{}, type_args: type_args, args: args, id: AST_NODE_GENERATED}
}

sema_live_unhandled: fn() -> SemaDirectSpecialCheck Never! { SemaDirectSpecialCheck{handled: false, value: None} }

sema_live_rejected: fn() -> SemaDirectSpecialCheck Never! { SemaDirectSpecialCheck{handled: true, value: None} }

// Whether `module_name.member` is one of the live-binding calls.
sema_live_member: fn(module_name: String, member: String) -> Bool Never! {
    (module_name == "app" || module_name == "core.web") && (member == "live" || member == "subscribe" || member == "push" || member == "invalidate")
}

// A live-binding call through a Core module alias (`use web: core.web`).
sema_call_try_live: fn(module_name: String, member: String, alias: String, alias_span: Span, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if !sema_live_member(module_name, member) -> return sema_live_unhandled()
    // A nested module path (`alias.leaf.member`) names another module.
    imported_module: sema_call_core_import_module(environment, program, alias) ?? return sema_live_unhandled()
    if imported_module != module_name -> return sema_live_unhandled()
    imported: sema_call_core_import_target(environment, program, alias) ?? return sema_live_unhandled()
    if !sema_call_core_record_import_reference(environment, program, scopes, imported, alias_span, context) -> return sema_live_unhandled()
    sema_call_live(member, alias, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

// `alias.member(source, args...)`, where `alias` names `app` or `core.web`
// and the import is already recorded.
sema_call_live: fn(member: String, alias: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    callee: "{alias}.{member}"
    positional := [CallArg]{}
    every := Expr?{None}
    value := Expr?{None}
    loop argument in args {
        if argument.spread {
            diagnostics.push(sema_error("E0104", argument.span, "`{callee}` can't spread its arguments", "the arguments after the source are checked as one call to it", "pass each argument of the source call"))
            return sema_live_rejected()
        }
        if argument.label == .Val(label) {
            if member == "subscribe" && label.name == "every" && every == None {
                every = Val(argument.expr.copy()) // copy: the caller's argument list keeps its expression
                next
            }
            if member == "push" && label.name == "value" && value == None {
                value = Val(argument.expr.copy()) // copy: the caller's argument list keeps its expression
                next
            }
            diagnostics.push(sema_error("E0104", label.span, "`{callee}` has no parameter `{label.name}`", sema_live_shape(member), "remove the `{label.name}:` argument"))
            return sema_live_rejected()
        }
        positional.push(argument.copy()) // copy: the caller's argument list keeps its arguments
    }
    if positional.len() == 0 {
        diagnostics.push(sema_error("E0104", span, "`{callee}` needs a source function", sema_live_shape(member), "pass the source function first, then its arguments"))
        return sema_live_rejected()
    }
    source: sema_live_source(positional[0].expr, member, environment, program, scopes, diagnostics) ?? return sema_live_rejected()
    supplied: positional.len() - 1
    if member == "push" && value == None {
        diagnostics.push(sema_error("E0104", span, "`{callee}` needs the pushed value", sema_live_shape(member), "add `value: ...` after the source's arguments"))
        return sema_live_rejected()
    }
    whole_source: member == "invalidate" && supplied == 0
    if !whole_source && supplied != source.params.len() {
        diagnostics.push(sema_call_arity_diagnostic(source.name, source.params.len(), supplied, false, expr_span(positional[0].expr)))
        return sema_live_rejected()
    }
    graph: program.registration_graph ?? return sema_live_rejected()
    sema_scope_enter(scopes, state, "live:{span.start}")
    body := [TStmt]{}
    keys := [Expr]{}
    reads := [CallArg]{}
    takes := [NamedSpan]{}
    loop index in 0..<supplied {
        argument: positional[index + 1]
        local_name: "__jet_live_{span.start}_{index}"
        binding := ast_binding(local_name, argument.span, false, argument.expr.copy(), None) // copy: `positional` keeps its argument
        binding.ty = Val(source.params[index].copy()) // copy: the source signature keeps its parameter types
        statement: sema_stmt_check_binding(binding, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            sema_single_use_leave_scope(scopes, state, diagnostics)
            return sema_live_rejected()
        }
        body.push(statement)
        read: Expr.Ident{name: local_name, span: argument.span, id: AST_NODE_GENERATED}
        // An argument with no encoding (a database scope, a handle) does not
        // tell bindings apart.
        if sema_type_bound_satisfied(graph, source.params[index], "Encode", environment.module_identity) == (Val(true)) {
            keys.push(sema_live_module_call(alias, "__live_arg", [Type]{}, [CallArg]{sema_live_arg(read.copy(), argument.span)}, argument.span))
        } else {
            keys.push(sema_live_string("_", argument.span))
        }
        reads.push(sema_live_arg(read, argument.span))
        takes.push(NamedSpan{name: local_name.copy(), span: argument.span}) // copy: the read above names the same local
    }
    wire: sema_live_string(source.wire, span)
    key_name: "__jet_live_{span.start}_key"
    key_binding := ast_binding(key_name, span, false, Expr.ListLit{elements: keys, span: span, id: AST_NODE_GENERATED}, None)
    key_binding.ty = Val(Type.List{element: Type.String})
    if !whole_source {
        key_statement: sema_stmt_check_binding(key_binding, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            sema_single_use_leave_scope(scopes, state, diagnostics)
            return sema_live_rejected()
        }
        body.push(key_statement)
    }
    key: Expr.Ident{name: key_name, span: span, id: AST_NODE_GENERATED}
    // The pushed value is checked against the source's value type here, so a
    // mismatch names `push` rather than the call it lowers to.
    pushed := Expr?{None}
    if value == .Val(given) {
        value_name: "__jet_live_{span.start}_value"
        value_binding := ast_binding(value_name, expr_span(given), false, given.copy(), None) // copy: `value` keeps the caller's expression
        value_binding.ty = Val(source.ok.copy()) // copy: the source signature keeps its value type
        value_statement: sema_stmt_check_binding(value_binding, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            sema_single_use_leave_scope(scopes, state, diagnostics)
            return sema_live_rejected()
        }
        body.push(value_statement)
        pushed = Val(Expr.Ident{name: value_name, span: expr_span(given), id: AST_NODE_GENERATED})
    }
    invocation: Expr.Call{call: Call{name: source.name, name_span: span, type_args: [Type]{}, args: reads}, id: AST_NODE_GENERATED}
    run: Expr.Lambda{lambda: Lambda{take_names: takes, params: [LambdaParam]{}, effects: None, body: LambdaBody.Expr{value: invocation}, span: span, meta: ast_empty_lambda_meta()}, id: AST_NODE_GENERATED}
    lowered: if member == {
        "live" -> sema_live_module_call(alias, "__live_bind", [Type]{source.ok.copy(), source.err.copy()}, [CallArg]{sema_live_arg(wire, span), sema_live_arg(key, span), sema_live_arg(run, span)}, span)
        "subscribe" -> sema_live_module_call(alias, "__live_poll", [Type]{source.ok.copy(), source.err.copy()}, [CallArg]{sema_live_arg(wire, span), sema_live_arg(key, span), sema_live_arg(every ?? Expr.Absent{span: span, id: AST_NODE_GENERATED}, span), sema_live_arg(run, span)}, span)
        "push" -> sema_live_module_call(alias, "__live_push", [Type]{source.ok.copy()}, [CallArg]{sema_live_arg(wire, span), sema_live_arg(key, span), sema_live_arg(pushed ?? panic("push value was checked above"), span)}, span)
        else -> if whole_source -> sema_live_module_call(alias, "__live_invalidate_all", [Type]{}, [CallArg]{sema_live_arg(wire, span)}, span) else -> sema_live_module_call(alias, "__live_invalidate", [Type]{}, [CallArg]{sema_live_arg(wire, span), sema_live_arg(key, span)}, span)
    }
    checked: sema_check_expression(lowered, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
        sema_single_use_leave_scope(scopes, state, diagnostics)
        return sema_live_rejected()
    }
    result_type: checked.ty.copy() // copy: the block's value keeps its own type
    body.push(TStmt.ExprStmt{value: checked, span: span})
    sema_single_use_leave_scope(scopes, state, diagnostics)
    lowered_value: sema_tree_node(result_type, TExprKind.InlineBlock{body: body}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(lowered_value, expected, environment, program, diagnostics)}
}

sema_live_shape: fn(member: String) -> String Never! {
    if member == {
        "live" -> "`live(query, args...)` binds a database query to one argument list"
        "subscribe" -> "`subscribe(source, args..., every:)` binds a source to one argument list, optionally polled"
        "push" -> "`push(source, args..., value:)` publishes a value for one argument list of the source"
        else -> "`invalidate(source)` re-runs every binding of the source; `invalidate(source, args...)` re-runs exactly that argument list"
    }
}

// The named source function: its wire name (module path and name), parameter
// types, and result and error types, each Encode and Decode.
sema_live_source: fn(expression: Expr, member: String, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaLiveSource? {
    source_span: expr_span(expression)
    name: if expression == {
        .Ident(written, _, _) -> written
        else -> {
            diagnostics.push(sema_error("E0112", source_span, "a live source must be a function name", "a live binding re-runs its source by name, and the source's module path names it on the wire", "declare the source as a top-level `fn` and pass its name"))
            return None
        }
    }
    index: sema_scope_resolve_index(scopes, name) ?? {
        diagnostics.push(sema_unknown_name_in(name, source_span, scopes))
        return None
    }
    if scopes.bindings[index].symbol.kind != SymbolKind.Function {
        diagnostics.push(sema_error("E0112", source_span, "`{name}` is a value, not a named function", "a live binding re-runs its source by name, and the source's module path names it on the wire; a closure has no such name", "declare the source as a top-level `fn` and pass its name"))
        return None
    }
    ty: sema_scope_binding_type(environment, scopes, index) ?? return None
    if ty == .Fn(params, ret, effect_bound, _, metadata, _) {
        if metadata == .Val(call) {
            loop convention in call.conventions {
                if convention != AccessConvention.Read {
                    diagnostics.push(sema_error("E0112", source_span, "`{name}` takes or writes an argument", "a live binding keeps its arguments and re-runs its source with them", "make every parameter of `{name}` a read parameter"))
                    return None
                }
            }
        }
        result: ret ?? Type.Named{name: "Unit"}
        if result == .Result(ok, err) {
            if member == "live" && !sema_live_reads_only(name, effect_bound, source_span, diagnostics) -> return None
            graph: program.registration_graph ?? return None
            if !sema_live_codable(graph, name, "result", ok, environment, source_span, diagnostics) -> return None
            if !sema_live_codable(graph, name, "error", err, environment, source_span, diagnostics) -> return None
            return Val(SemaLiveSource{name: name.copy(), wire: "{scopes.bindings[index].symbol.module_name}.{scopes.bindings[index].symbol.name}", params: params.copy(), ok: ok.copy(), err: err.copy()})
        }
        diagnostics.push(sema_error("E0112", source_span, "`{name}` can't fail, so its binding has no error to carry", "a live binding's state is loaded or failed with the source's own error", "declare `{name}` with the error it reports: `-> {sema_type_show(result)} E!`"))
        return None
    }
    diagnostics.push(sema_error("E0112", source_span, "`{name}` is not a function", "a live binding re-runs a named function", "pass a top-level `fn`"))
    None
}

// A `live` query may only read the database: its declared effects are
// `DB.Read` at most.
sema_live_reads_only: fn(name: String, effect_bound: [EffectRowEntry]?, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    rows: effect_bound ?? {
        diagnostics.push(sema_error("E0740", span, "`{name}` declares no effects, so a live query can't prove it only reads", "`live` re-runs its query whenever the data it read changes, so the query may only read the database", "declare it `{name}: fn(...) -[DB.Read]> ...`, or use `subscribe` for another source"))
        return false
    }
    loop row in rows {
        if row.name != "DB.Read" {
            diagnostics.push(sema_error("E0740", span, "`{name}` uses the effect `{row.name}`, which a live query doesn't allow", "`live` re-runs its query whenever the data it read changes, so the query may only read the database", "keep the query to `-[DB.Read]>`, or use `subscribe` for another source"))
            return false
        }
    }
    true
}

sema_live_codable: fn(graph: SemaRegistrationGraph, name: String, role: String, ty: Type, environment: SemaScopeEnvironment, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    missing: loop codec in owned_trait_codec_names() {
        if sema_type_bound_satisfied(graph, ty, codec, environment.module_identity) != (Val(true)) -> break codec.copy()
    } ?? ""
    if missing == "" -> return true
    diagnostics.push(sema_error("E0112", span, "`{name}`'s {role} type {sema_type_show(ty)} isn't `{missing}`", "a live binding stores and sends its source's result and error as encoded data", "derive `Encode` and `Decode` for {sema_type_show(ty)}"))
    false
}
