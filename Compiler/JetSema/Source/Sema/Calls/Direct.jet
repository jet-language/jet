// Direct-call resolution and checked-tree construction.
// Ordinary local names resolve through SemaScopeTable. Registration may pass a
// specialized SemaCallDirectTarget for imported, overloaded, or Core routes.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    BinOp,
    Call,
    CallArg,
    CoreCallRecord,
    Diagnostic,
    EffectRowEntry,
    Expr,
    ExprField,
    FunctionDefaultRef,
    Item,
    Program,
    Stmt,
    CopyFact,
    Span,
    StrFormat,
    StrPart,
    SymbolKind,
    TFailureCarrier,
    TLetTy,
    TStrFormat,
    TextEdit,
    Type,
    core_call,
    diagnostic_registry_row,
    diagnostic_with_edit,
    expr_span,
    ast_empty_call_arg_flags,
    checked_generated_local,
    core_input_method_member,
    core_input_method_modules,
    type_identity_equal,
    type_name,
    Func,
]

SemaDirectSpecialCheck: struct {
    handled: Bool
    value: TExpr?
}

sema_call_special_diagnostic: fn(name: String, span: Span) -> Diagnostic {
    sema_error("E1005", span, "`{name}` must wrap a single integer `+`, `-`, `*`, or `/`, or one narrowing conversion", "the overflow opt-ins apply to one arithmetic operation on whole numbers, or to one conversion to a fixed width that can't hold every value of its source", "write it around one operation or conversion, e.g. `{name}(a + b)` or `{name}(U8{{count}})`")
}

sema_call_check_special_overflow: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if call.args.len() != 1 {
        loop argument_index in 0..<call.args.len() -> _ := sema_check_expression(call.args[argument_index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    argument: call.args[0]
    operation := BinOp?{None}
    if argument.expr == .Binary(op, _, _, _, _) {
        if sema_call_is_overflow_operation(op) -> operation = Val(op)
    }
    // `wrapping(U8{x})`: the word chooses what one narrowing typed-literal
    // conversion gives a value that doesn't fit.
    if operation == None && argument.expr == .TypedLit(_, _, _, _) -> return sema_call_check_special_overflow_conversion(call, argument.expr, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    operation_value: operation ?? {
        _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    gate: sema_call_direct_gate(call.name, scopes) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    gate_scope: sema_call_enter_gate(scopes, gate)
    checked_argument: sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
    sema_call_leave_gate(scopes, gate_scope)
    argument_value: checked_argument ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_expr_is_integer(argument_value.ty) {
        diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    lhs := TExpr?{None}
    rhs := TExpr?{None}
    if argument_value.kind == .Binary(_, _, _, left, right) {
        lhs = Val(left)
        rhs = Val(right)
    }
    lhs_value: lhs ?? {
        diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    rhs_value: rhs ?? {
        diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    line: sema_source_line_at(environment.source_segments, call.name_span) ?? 0
    result_ty: if call.name == "checked" -> Type.Option{inner: lhs_value.ty} else -> lhs_value.ty
    value: sema_tree_node(result_ty, TExprKind.OverflowOpt{prefix: call.name, operation: sema_call_overflow_operation_name(operation_value), line: line, lhs: lhs_value, rhs: rhs_value}, call.name_span)
    checked: sema_expr_expected(value, expected, environment, program, diagnostics)
    SemaDirectSpecialCheck{handled: true, value: checked}
}

sema_call_check_special_overflow_conversion: fn(call: Call, argument: Expr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    gate: sema_call_direct_gate(call.name, scopes) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    gate_scope: sema_call_enter_gate(scopes, gate)
    // The typed literal takes the word on entry (sema_expression_typed_literal).
    context.overflow_word = Val(call.name)
    checked_argument: sema_check_expression(argument, None, environment, program, scopes, state, tail_store, context, diagnostics)
    context.overflow_word = None
    sema_call_leave_gate(scopes, gate_scope)
    value: checked_argument ?? return SemaDirectSpecialCheck{handled: true, value: None}
    // Only a narrowing conversion took the word; around any other the word
    // changes nothing, so it is refused.
    if !sema_expr_is_narrowing(value) {
        diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    checked: sema_expr_expected(value, expected, environment, program, diagnostics)
    SemaDirectSpecialCheck{handled: true, value: checked}
}

sema_call_check_special_approx: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if call.args.len() != 1 {
        loop argument_index in 0..<call.args.len() -> _ := sema_check_expression(call.args[argument_index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_error("E0104", call.name_span, "`approx` takes one whole number", "`approx(value)` accepts possible precision loss at one integer-to-float crossing", "write `approx(value)`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    gate: sema_call_direct_gate(call.name, scopes) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    scope: sema_call_enter_gate(scopes, gate)
    checked_argument: sema_check_expression(call.args[0].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
    sema_call_leave_gate(scopes, scope)
    argument: checked_argument ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_expr_is_integer(argument.ty) {
        diagnostics.push(sema_error("E0109", call.args[0].span, "`approx` needs a whole number, but this is {sema_type_show(argument.ty)}", "`approx(value)` only opts one integer-to-float crossing out of its exactness check", "remove `approx`, or pass a whole number that is crossing into a decimal"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    target: if expected == {
        .Val(expected_type) -> if expected_type == {
            .Float32 -> Type.Float32
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> Type.Float
        }
        .None -> Type.Float
    }
    // `approx` is the one explicit lossy crossing (core-library "approx(value)
    // explicitly accepts possible precision loss"): the whole number rounds to
    // the nearest float through a plain cast, never the exactness-checked
    // crossing that stops on a value it cannot hold exactly.
    rust_type: sema_expr_numeric_rust_type(target) ?? "f64"
    converted: TExpr{ty: target, kind: TExprKind.NumericMethod{receiver: argument, operation: TNumericOp.CastAs{dst_rust: rust_type}}, span: call.name_span}
    checked: sema_expr_expected(converted, expected, environment, program, diagnostics)
    SemaDirectSpecialCheck{handled: true, value: checked}
}

// Rust `is_debuggable` the values `debug(value)` can show in
// their Debug form. A nominal needs a registered or auto-derived `Debug`.
sema_call_debug_traceable: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if sema_call_reflection_secret_bearing(ty) -> return false
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 | .Quantity(_, _) -> true
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .InlineRange(inner, _, _) -> sema_call_debug_traceable(inner, environment, program)
        .Result(ok, err) | .Map(ok, _, err) -> sema_call_debug_traceable(ok, environment, program) && sema_call_debug_traceable(err, environment, program)
        .Named(name) -> {
            if sema_call_reflection_leaf_name(name) == "Unit" || sema_call_reflection_core_shown(name) || sema_call_reflection_leaf_name(name) == "Err" -> return true
            // The game asset handles carry a Debug form (`JetDebug for
            // GameImage`/`GameSound`: `GameImage(<path>)`).
            if name == "GameImage" || name == "GameSound" -> return true
            // A Clock's Debug form is its Show form, `Clock { now: N }`.
            if sema_call_is_clock_type(ty) -> return true
            if program.registration_graph == .Val(graph) && sema_registration_unit_fact_for_type(graph, ty) != None -> return true
            sema_comparability_implements(environment, program, ty, "Debug")
        }
        .Apply(name, args) -> {
            if sema_call_reflection_leaf_name(name) == "KeyRef" -> return true
            if !sema_comparability_implements(environment, program, ty, "Debug") -> return false
            loop argument in args {
                if !sema_call_debug_traceable(argument, environment, program) -> return false
            }
            true
        }
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_call_debug_traceable(field.ty, environment, program) -> return false
            }
            true
        }
        .Union(members) -> {
            loop member in members {
                if !sema_call_debug_traceable(member, environment, program) -> return false
            }
            true
        }
        .TraitObject(_) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Measure(_) -> false
    }
}

// Rust `infer_method_call` `.debug()` with no arguments is
// the Debug protocol method on every debuggable receiver, auto-derived or
// handwritten alike; it is the same Debug text `{value:Debug}` renders.
sema_call_try_debug_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "debug" || args.len() != 0 || type_args.len() != 0 || !sema_call_debug_traceable(receiver_value.ty, environment, program) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    text: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Interpolation{value: receiver_value, format: TStrFormat.Debug}}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(text, expected, environment, program, diagnostics)}
}

// The `file.jet:LINE` site of a trace (Rust `check_debug_trace`).
sema_call_debug_site: fn(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables) -> String Never! {
    path: sema_source_file_at(environment.source_segments, environment.source_file, environment.source_origin, call.name_span)
    parts: path.split("/").to_list()
    file: if parts.len() > 0 && parts[parts.len() - 1] != "" -> parts[parts.len() - 1] else -> path
    line: sema_source_line_at(environment.source_segments, call.name_span) ?? 0
    "{file}:{line}"
}

// The traced expression on one line: each authored line trimmed, blank
// lines dropped, joined by one space.
sema_call_debug_expression_text: fn(text: String) -> String Never! {
    lines := [String]{}
    loop line in text.split("\n").to_list() {
        trimmed: line.trim().copy()
        if trimmed != "" -> lines.push(trimmed)
    }
    lines.join(" ")
}

// `debug(value)` evaluates the value once, writes
// `[debug] file.jet:LINE expr = <Debug form>` to stderr through the shared
// `core.term.eprint` row, and yields the value unchanged. The trace adds no
// effect. A shipped artifact or a release-profile build rejects it (E3405)
// with an edit that keeps the traced expression exactly as written.
sema_call_check_special_debug: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if sema_module_no_prelude(environment, program) -> return SemaDirectSpecialCheck{handled: false, value: None}
    if call.args.len() != 1 || call.args[0].label != None || call.args[0].spread {
        loop argument_index in 0..<call.args.len() -> _ := sema_check_expression(call.args[argument_index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_error("E0104", call.name_span, "`debug` takes exactly one value", "`debug(value)` shows one value and returns it unchanged", "write `debug(value)`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    checked: sema_check_expression(call.args[0].expr, expected, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    value_span: expr_span(call.args[0].expr)
    if !sema_call_debug_traceable(checked.ty, environment, program) {
        diagnostics.push(sema_error("E0112", value_span, "`debug` can't show {sema_type_show(checked.ty)}", "`debug` writes the value's Debug form", "implement `Debug`, or trace a debuggable part of the value"))
    }
    authored := String?{None}
    unwrap := TextEdit?{None}
    loop recorded in environment.debug_sites {
        if recorded.name_start == call.name_span.start {
            authored = Val(recorded.text)
            unwrap = Val(TextEdit{span: Span{start: call.name_span.start, end: recorded.close_end}, new_text: recorded.text})
            break
        }
    }
    site: sema_call_debug_site(call, environment, program)
    if program.registration_graph == .Val(graph) && sema_build_facts_reject_debug_traces(graph.build_facts) {
        diagnostic: sema_error("E3405", call.name_span, "A `debug` trace is left at `{site}`.", "`debug(value)` is a development trace: it prints while you run, test, or evaluate a program and adds no effect, so a shipped artifact (`jet build`) or a release-profile build must not contain it.", "Remove the `debug(…)` wrapper and keep the expression; `jet fix` applies this edit.")
        if unwrap == .Val(edit) -> diagnostics.push(diagnostic_with_edit(diagnostic, edit)) else -> diagnostics.push(diagnostic)
    }
    expression_text: sema_call_debug_expression_text(authored ?? "")
    traced := checked
    if !sema_call_is_scalar(checked.ty) {
        if checked.kind == {
            .Local(_) | .Field(_, _) | .Index(_, _, _, _, _, _) -> traced = sema_tree_node(checked.ty, TExprKind.Clone{value: checked, fact: CopyFact.Materialize}, checked.span)
            .IntLit(_, _) | .StrLit(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {}
        }
    }
    local: checked_generated_local("__jet_debug_trace_{call.name_span.start}", call.name_span, checked.ty)
    read: sema_tree_node(checked.ty, TExprKind.Local{local: local}, call.name_span)
    line: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "[debug] {site} {expression_text} = "}, TStrPart.Interpolation{value: read, format: TStrFormat.Debug}}}, call.name_span)
    unavailable: sema_error("E0906", call.name_span, "the canonical `core.term.eprint` route for `debug` is unavailable", "the development trace writes through the registered Core stderr row", "restore the registered `core.term.eprint` route")
    unit: Type.Named{name: "Unit"}
    // The trace adds no effect: its stderr write is a known-pure call site, so
    // pure (`-[]>`) and memoized functions keep their rows (Rust sema records
    // no effect for `debug`).
    if !sema_effect_record_intrinsic_effects(environment, program, scopes, context, "debug", call.name_span, [EffectRowEntry]{}, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    // The stderr write is the registered host row when one exists, else the
    // source-owned `core.term.eprint` declaration.
    write_kind := TExprKind?{None}
    if core_call("core.term", "eprint") == .Val(record) {
        write_kind = Val(TExprKind.CoreCall{record: record, args: [TExpr]{line}, source_span: call.name_span, type_args: [Type]{}, widen_to_vec: [Bool]{false}, fallibility: TFailureCarrier.Infallible})
    } else if sema_call_core_module_identity(environment, program, "core.term") == .Val(identity) {
        if sema_call_core_source_target(environment, program, identity, "eprint", [Type]{}, call.name_span, false, diagnostics) == .Val(target) {
            callee: sema_call_callee_decl(program, target.symbol.id, call.name_span, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
            argument: TCallArg{value: line, template_items: [SymbolID]{}, borrow: false, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
            write_kind = Val(TExprKind.Call{callee: callee, type_args: [Type]{}, args: [TCallArg]{argument}})
        }
    }
    kind: write_kind ?? {
        diagnostics.push(unavailable)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    write: sema_tree_node(unit, kind, call.name_span)
    body: [TStmt]{
        TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: traced, gc_promotion: None, gc_transferred: false, span: call.name_span},
        TStmt.ExprStmt{value: write, span: call.name_span},
        TStmt.ExprStmt{value: read, span: call.name_span},
    }
    SemaDirectSpecialCheck{handled: true, value: Val(sema_tree_node(checked.ty, TExprKind.InlineBlock{body: body}, call.name_span))}
}

sema_call_try_knowledge_builtin: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if !sema_call_gate_is_unshadowed(call.name, scopes) -> return SemaDirectSpecialCheck{handled: false, value: None}
    if call.name == {
        "wrapping" | "saturating" | "checked" -> sema_call_check_special_overflow(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        "approx" -> sema_call_check_special_approx(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        "debug" -> sema_call_check_special_debug(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        "embed_file" | "embed_bytes" | "find" -> sema_call_check_comptime_input(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        else -> SemaDirectSpecialCheck{handled: false, value: None}
    }
}

// The readable prelude's builtin rows (Rust `CorePrelude` Builtin targets
// `print`, `panic`, `assert`, `assert_eq`), checked by one dispatcher
// with the Rust checker's arity and argument rules (check_*_call). A user
// function or local of the same name shadows every row. `#NoPrelude`
// print/input refusal (E0429) runs before this dispatcher. The ambient
// `input` is a value (sema_call_check_ambient_input), not a function.
sema_call_try_ambient_prelude: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if !sema_call_gate_is_unshadowed(call.name, scopes) -> return SemaDirectSpecialCheck{handled: false, value: None}
    if call.name == {
        "channel" -> sema_call_check_channel(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        "freeze" -> sema_call_check_freeze(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        "print" -> sema_call_check_ambient_print(call, environment, program, scopes, state, tail_store, context, diagnostics)
        "__jet_eval_show" -> sema_call_check_eval_show(call, environment, program, scopes, state, tail_store, context, diagnostics)
        "input" -> sema_call_check_ambient_input_call(call, environment, program, scopes, state, tail_store, context, diagnostics)
        "panic" -> sema_call_check_ambient_panic(call, environment, program, scopes, state, tail_store, context, diagnostics)
        "assert" -> sema_call_check_ambient_assert(call, environment, program, scopes, state, tail_store, context, diagnostics)
        "assert_eq" -> sema_call_check_ambient_assert_eq(call, environment, program, scopes, state, tail_store, context, diagnostics)
        // The readable prelude's `pub use core.term.[eprint]` (Rust opens it
        // as a `core.term` item import unless the file is `#NoPrelude`).
        "eprint" -> {
            if sema_module_no_prelude(environment, program) -> return SemaDirectSpecialCheck{handled: false, value: None}
            if core_call("core.term", "eprint") == .Val(record) -> return sema_call_check_term_eprint(record, call.args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            sema_call_ambient_source_alias(call, "core.term", "eprint", expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        // The readable prelude's file aliases (`read_file`, `write_file`,
        // `file_exists`) call their `core.files` declarations.
        "read_file" | "write_file" | "file_exists" -> {
            if sema_module_no_prelude(environment, program) -> return SemaDirectSpecialCheck{handled: false, value: None}
            member: if call.name == {
                "read_file" -> "read"
                "write_file" -> "write"
                else -> "exists"
            }
            sema_call_ambient_source_alias(call, "core.files", member, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        // The benchmark identity sink `keep(value)` calls `core.prelude.keep`.
        "keep" -> sema_call_ambient_source_alias(call, "core.prelude", "keep", expected, environment, program, scopes, state, tail_store, context, diagnostics)
        // The readable prelude's ordered extrema call their `core.prelude`
        // generics (`min(a, b, ...rest)`, `max(...)`, `clamp(x, lo, hi)`).
        "min" | "max" | "clamp" -> {
            if sema_module_no_prelude(environment, program) -> return SemaDirectSpecialCheck{handled: false, value: None}
            sema_call_ambient_source_alias(call, "core.prelude", call.name, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        "Decimal" | "Complex" -> {
            if sema_call_value_type_args_refused(call, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
            if call.name == "Decimal" -> return sema_call_check_value_constructor(call, "Decimal", [Type]{Type.String}, false, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            sema_call_check_value_constructor(call, "Complex", [Type]{Type.Float, Type.Float}, false, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        else -> {
            if !sema_expr_is_math_type_name(call.name) -> return SemaDirectSpecialCheck{handled: false, value: None}
            if sema_call_value_type_args_refused(call, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
            // A math type Core's source declares builds through its own `new`.
            if program.registration_graph == .Val(graph) {
                if sema_type_source_owns_nominal(graph, call.name, sema_scope_caller_row(environment, graph)) {
                    // copy: the generated call owns its arguments; `call` keeps the written ones.
                    invocation: Expr.MethodCall{receiver: Expr.Ident{name: call.name, span: call.name_span, id: AST_NODE_GENERATED}, method: "new", method_span: call.name_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: call.args.copy(), id: AST_NODE_GENERATED}
                    return SemaDirectSpecialCheck{handled: true, value: sema_check_expression(invocation, expected, environment, program, scopes, state, tail_store, context, diagnostics)}
                }
            }
            components := [Type]{}
            loop _ in 0..<sema_call_math_arity(call.name) -> components.push(sema_call_math_scalar_type(call.name))
            sema_call_check_value_constructor(call, call.name, components, true, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
    }
}

// `Mat3<Int>(…)`: a built-in value type built by a call has fixed component
// types and no type parameters, so written type arguments are refused, never
// ignored.
sema_call_value_type_args_refused: fn(call: Call, diagnostics: &[Diagnostic]) -> Bool {
    if call.type_args.len() == 0 -> return false
    diagnostics.push(sema_error("E0119", call.name_span, "`{call.name}` is not generic", "`{call.name}` is a built-in value type with fixed component types, so it takes no type arguments", "remove the type arguments: write `{call.name}(…)`"))
    true
}

// A readable prelude alias whose Core declaration is source-owned is called as
// the item import the prelude opens: its checked source declaration is the
// target.
sema_call_ambient_source_alias: fn(call: Call, module_name: String, member: String, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    module_identity: sema_call_core_module_identity(environment, program, module_name) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    target: sema_call_core_source_target(environment, program, module_identity, member, call.type_args, call.name_span, false, diagnostics) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    scopes.ownership_call_depth += 1
    value := sema_call_core_check_source_owned(target, call.name, call.type_args, call.args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    scopes.ownership_call_depth -= 1
    SemaDirectSpecialCheck{handled: true, value: value}
}

// (Rust `check_call_inner`): `close(value)` is ambient
// sugar for the sole nominal `Close.close(&&self)` protocol, ahead of every
// declared function. It takes exactly one resource, whose type must implement
// `Close`, and produces nothing.
sema_call_check_ambient_close: fn(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if call.args.len() != 1 {
        diagnostics.push(sema_error("E0104", call.name_span, "`close` takes exactly one resource, got {call.args.len()}", "`close` takes one value through its nominal `Close` implementation", "write `close(resource)`"))
        loop argument_index in 0..<call.args.len() -> _ := sema_check_expression(call.args[argument_index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    argument: call.args[0]
    value: sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if argument.convention == AccessConvention.Write {
        diagnostics.push(sema_error("E0201", argument.span, "`close` takes ownership of its resource", "`Close.close(&&self)` takes its receiver, so cleanup runs on exactly one owner; `&` would only lend it", "write `close(resource)`"))
        return None
    }
    if program.registration_graph == .Val(graph) {
        // An undecided bound (a Core native carrier such as `TCPListener`
        // has no nominal row to carry a `Close` impl) is no `Close`
        // implementation, and the user can't add one (#6120).
        decided: sema_type_bound_satisfied_at(graph, value.ty, "Close", sema_scope_caller_row(environment, graph), context.generic_params)
        if decided != .Val(true) {
            shown: type_name(value.ty)
            fix: if decided == None -> "remove the `close` call; `{shown}` has no `Close` implementation to run" else -> "write `impl {shown}.Close {{ … }}` with every required method"
            diagnostics.push(sema_error("E0905", expr_span(argument.expr), "`{shown}` isn't `Close`", "`{shown}` would need to implement `Close` before it can be used here", fix))
            return None
        }
    }
    // `close(name)` consumes the owner exactly, like a `&&` argument: a later
    // use of `name` is E0121 and never turns the move into a hidden copy.
    exact: sema_ownership_unmarked_moves_name(argument.expr)
    moved: if exact -> sema_ownership_mark_move(state, argument.expr, scopes, "`close`", diagnostics) else -> sema_stmt_move_direct(argument.expr, state, scopes, "`close`", diagnostics)
    if !moved -> return None
    Val(sema_tree_node(Type.Named{name: "Unit"}, TExprKind.Close{value: value}, call.name_span))
}

// The scalar slots of a built-in math value type's
// positional constructor (Rust `math_arity`): a lane type's lane count, a
// vector's dimension, a square matrix's N*N column-major components.
sema_call_math_arity: fn(name: String) -> Int Never! {
    if name == {
        "Vec2" -> return 2
        "Vec3" -> return 3
        "Vec4" -> return 4
        "Mat3" -> return 9
        "Mat4" -> return 16
        else -> {}
    }
    lanes: name.split("x").to_list()
    if lanes.len() != 2 -> return 0
    Int.parse(lanes[1]) ?? 0
}

// Rust `math_scalar_ty`: a lane type's component width; linear-algebra types
// are Float.
sema_call_math_scalar_type: fn(name: String) -> Type Never! {
    if name.starts_with("F32x") -> return Type.Float32
    if name.starts_with("I8x") -> return Type.IntN{signed: true, bits: 8}
    if name.starts_with("I16x") -> return Type.IntN{signed: true, bits: 16}
    if name.starts_with("I32x") -> return Type.IntN{signed: true, bits: 32}
    if name.starts_with("I64x") -> return Type.IntN{signed: true, bits: 64}
    if name.starts_with("U8x") -> return Type.IntN{signed: false, bits: 8}
    if name.starts_with("U16x") -> return Type.IntN{signed: false, bits: 16}
    if name.starts_with("U32x") -> return Type.IntN{signed: false, bits: 32}
    if name.starts_with("U64x") -> return Type.IntN{signed: false, bits: 64}
    Type.Float
}

// `Decimal("12.34")` `Complex(re, im)` and
// `Vec3(x, y, z)`-style math constructors each argument
// is checked against its component type in order and the call becomes the
// type's precise or math builtin, as the Rust reference lowering builds it.
sema_call_check_value_constructor: fn(call: Call, type_name_value: String, components: [Type], math: Bool, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if call.args.len() != components.len() {
        what := if {
            type_name_value == "Decimal" -> "`Decimal` takes exactly one argument, got {call.args.len()}"
            type_name_value == "Complex" -> "`Complex` takes exactly two arguments, got {call.args.len()}"
            else -> "`{type_name_value}` takes exactly {components.len()} component{if components.len() == 1 -> "" else -> "s"}, got {call.args.len()}"
        }
        why := if {
            type_name_value == "Decimal" -> "`Decimal` parses an exact base-10 decimal from a `String`"
            type_name_value == "Complex" -> "`Complex` takes the real part first and the imaginary part second"
            else -> "`{type_name_value}` is a built-in {if type_name_value.starts_with("Vec") || type_name_value.starts_with("Mat") -> "linear-algebra" else -> "SIMD lane"} type — construct it from its {components.len()} components"
        }
        fix := if {
            type_name_value == "Decimal" -> "write `Decimal(\"12.34\")`"
            type_name_value == "Complex" -> "write `Complex(real, imaginary)`"
            else -> {
                slots := [String]{}
                loop _ in components -> slots.push("…")
                "write `{type_name_value}({slots.join(", ")})`"
            }
        }
        diagnostics.push(sema_error("E0103", call.name_span, what, why, fix))
        loop argument_index in 0..<call.args.len() -> _ := sema_check_expression(call.args[argument_index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    values := [TExpr]{}
    complete := true
    loop index in 0..<components.len() {
        component: components[index]
        checked: sema_check_expression(call.args[index].expr, Val(component), environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            complete = false
            next
        }
        coerced: sema_expr_expected(checked, Val(component), environment, program, diagnostics) ?? {
            complete = false
            next
        }
        values.push(coerced)
    }
    if !complete -> return SemaDirectSpecialCheck{handled: true, value: None}
    result_ty: Type.Named{name: type_name_value}
    kind: if {
        math -> TExprKind.MathBuiltin{type_name: type_name_value, function: "new", args: values}
        type_name_value == "Decimal" -> TExprKind.PreciseBuiltin{type_name: type_name_value, function: "from_str", args: values}
        else -> TExprKind.PreciseBuiltin{type_name: type_name_value, function: "from_parts", args: values}
    }
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected_owned(sema_tree_expr(result_ty, kind, call.name_span), expected, environment, program, diagnostics)}
}

// An ambient row's IO effect, recorded as its call-site fact so the effect
// solve sees a known call instead of an unresolved one.
sema_call_ambient_record_io: fn(api: String, result_type: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool Never! {
    sema_effect_record_intrinsic_fact(environment, program, scopes, context, api, span, SemaCallFacts{
        return_type: result_type,
        failure_carrier: sema_call_failure_carrier(Val(result_type)),
        effect_bound: Val([EffectRowEntry]{EffectRowEntry{name: "IO", span: span}}),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }, diagnostics)
}

// Rust `is_printable || is_displayable`, plus `Never`. Rust's `is_unit_type`
// there is a measurement-unit family (sema_expression_displayable), so the
// `Unit` value of a function without `->` has no display.
sema_call_ambient_printable: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if ty == (Type.Named{name: "Never"}) -> return true
    sema_expression_typed_literal_printable(ty, environment, program) || sema_expression_displayable(ty, environment, program)
}

sema_call_ambient_print_refusal: fn(ty: Type, span: Span) -> Diagnostic Never! {
    if sema_call_reflection_secret_bearing(ty) -> return sema_error("E0112", span, "secret-bearing `{type_name(ty)}` cannot be printed", "printing could copy cryptographic secret material into terminal output or logs", "print a public operation label or key identifier instead")
    if sema_call_reflection_one_pass(ty) {
        fix := "consume it with a `loop` and print each item instead"
        if ty == {
            .Apply(name, _) -> {
                leaf: sema_call_reflection_leaf_name(name)
                if leaf == "Iter" || leaf == "ViewIter" -> fix = "materialize it first: add `.to_list()` before printing; `.lazy()` or another Iter source enters the one-pass plane"
            }
            .Named(name) -> {
                if sema_call_reflection_leaf_name(name) == "Body" -> fix = "materialize it first: add `.text(limit)` before printing"
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {}
        }
        return sema_error("E0112", span, "`print` cannot show the one-pass source {sema_type_show(ty)}", "reading this value consumes it, so showing it would spend the only pass", fix)
    }
    sema_error("E0112", span, "`print` doesn't know how to show {sema_type_show(ty)}", "print shows values that have a display", "print one of its parts instead")
}

// Variadic `print`: every argument is checked on its own and prints its own
// line, one `Print` per argument in order (Rust `print_values`). It takes
// values only, so a label (`sep:`) names no parameter: E0764.
sema_call_check_ambient_print: fn(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if call.args.len() == 0 {
        diagnostics.push(sema_error("E0103", call.name_span, "`print` needs at least one thing to print", "printing nothing isn't meaningful", "e.g. print(\"hello\")"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    values := [TExpr]{}
    complete := true
    loop argument in call.args {
        if argument.label == .Val(label) {
            diagnostics.push(sema_call_diag_unknown_label(call.name, label.name, [SemaCallParam]{}, label.span))
            complete = false
        }
    }
    loop argument_index in 0..<call.args.len() {
        checked: sema_check_expression(call.args[argument_index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            complete = false
            next
        }
        if !sema_call_ambient_printable(checked.ty, environment, program) {
            diagnostics.push(sema_call_ambient_print_refusal(checked.ty, expr_span(call.args[argument_index].expr)))
            complete = false
            next
        }
        formatted: if checked.ty == (Type.Apply{name: "Measurement", args: [Type]{Type.Float}}) -> sema_expression_measurement_source_call("__measurement_show", [TExpr]{checked}, Type.String, checked.span, environment, program) ?? return SemaDirectSpecialCheck{handled: true, value: None} else -> checked
        values.push(formatted)
    }
    if !complete -> return SemaDirectSpecialCheck{handled: true, value: None}
    unit: Type.Named{name: "Unit"}
    if !sema_call_ambient_record_io("print", unit, call.name_span, environment, program, scopes, context, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    if values.len() == 1 -> return SemaDirectSpecialCheck{handled: true, value: Val(sema_tree_node(unit, TExprKind.Print{value: values[0]}, call.name_span))}
    body := [TStmt]{}
    prints := [TStmt]{}
    loop index in 0..<values.len() {
        local: checked_generated_local("__jet_print_arg_{call.name_span.start}_{index}", call.name_span, values[index].ty)
        body.push(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: values[index], gc_promotion: None, gc_transferred: false, span: call.name_span})
        read: sema_tree_node(values[index].ty, TExprKind.Local{local: local}, call.name_span)
        prints.push(TStmt.ExprStmt{value: sema_tree_node(unit, TExprKind.Print{value: read}, call.name_span), span: call.name_span})
    }
    loop statement in prints -> body.push(statement)
    SemaDirectSpecialCheck{handled: true, value: Val(sema_tree_node(unit, TExprKind.InlineBlock{body: body}, call.name_span))}
}

// `jet -e CODE` runs CODE as the body of `run: fn` (JetCli ScriptCache.jet
// jet_cli_eval_file), and its compile request's `eval_entry` asks for the
// value its last statement leaves: when that statement is an expression with
// a value (any expression but an `if` without `else`), the parsed entry's
// `run` ends in it wrapped in `__jet_eval_show` (Loader.jet). The call exists
// only in the tree, so the code itself keeps every source rule, E0067's
// reserved `__` names included.
sema_eval_entry_show: fn(program: &Program) {
    loop index in 0..<program.items.len() {
        if program.items[index] == .Func(function) {
            if function.name != "run" -> next
            changed := function.copy()
            count: changed.body.len()
            if count == 0 -> return
            value: if changed.body[count - 1] == {
                .Expr(expr) -> expr.copy()
                .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> return
            }
            if sema_eval_entry_valueless(value) -> return
            span: expr_span(value)
            argument: CallArg{convention: AccessConvention.Read, expr: value, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
            changed.body[count - 1] = Stmt.Expr{expr: Expr.Call{call: Call{name: "__jet_eval_show", name_span: span, type_args: [Type]{}, args: [CallArg]{argument}}, id: AST_NODE_GENERATED}}
            program.items[index] = Item.Func{value: changed}
            return
        }
    }
}

// An `if` without `else`: a statement, which leaves no value to show.
sema_eval_entry_valueless: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .If(_, _, _, _, else_value, _, _) -> if else_value == {
            .NoElse(_, _) -> true
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// The value sema_eval_entry_show wraps: a unit value shows nothing, each
// item of a List or an Iter prints on a line
// of its own, as a `loop` over it pulls them, and any other value prints as
// `print` shows it, under `print`'s display rule (E0112).
sema_call_check_eval_show: fn(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if call.args.len() != 1 {
        diagnostics.push(sema_error("E0104", call.name_span, "`__jet_eval_show` expects 1 argument, got {call.args.len()}", "it shows the one value the code of `jet -e` ends in", "pass the one value to show"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    checked: sema_check_expression(call.args[0].expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    unit: Type.Named{name: "Unit"}
    if checked.ty == unit -> return SemaDirectSpecialCheck{handled: true, value: Val(checked)}
    span: expr_span(call.args[0].expr)
    item_type: sema_call_eval_show_item(checked.ty)
    shown_type: item_type ?? checked.ty
    if !sema_call_ambient_printable(shown_type, environment, program) {
        diagnostics.push(sema_call_ambient_print_refusal(shown_type, span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_call_ambient_record_io("print", unit, call.name_span, environment, program, scopes, context, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    item: item_type ?? {
        shown: sema_call_eval_show_text(checked, environment, program) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        return SemaDirectSpecialCheck{handled: true, value: Val(sema_tree_node(unit, TExprKind.Print{value: shown}, span))}
    }
    local: checked_generated_local("__jet_eval_item_{call.name_span.start}", span, item)
    read: sema_tree_node(item, TExprKind.Local{local: local}, span)
    shown: sema_call_eval_show_text(read, environment, program) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    line: TStmt.ExprStmt{value: sema_tree_node(unit, TExprKind.Print{value: shown}, span), span: span}
    by_value: sema_stmt_for_in_consumes_collection(checked.ty, item) && (sema_stmt_for_in_by_value(checked.ty, item) || sema_stmt_for_in_is_list(checked.ty))
    walk: TStmt.ForIn{label: None, variable: local, variable_two: None, source: checked.copy(), collection: checked, step: None, method_kind: None, columnar: false, by_value: by_value, source_stable: false, body: [TStmt]{line}, span: span}
    SemaDirectSpecialCheck{handled: true, value: Val(sema_tree_node(unit, TExprKind.InlineBlock{body: [TStmt]{walk}}, span))}
}

// The item type of a value `jet -e` shows one item per line: a List's element
// or an Iter's item; None for any other value.
sema_call_eval_show_item: fn(ty: Type) -> Type? Never! {
    if ty == {
        .List(element) -> Val(element)
        .Apply(name, args) -> if name == "Iter" && args.len() == 1 -> Val(args[0]) else -> None
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// A shown value as `print` passes it on: a Measurement through its
// `__measurement_show` text, any other value as it is.
sema_call_eval_show_text: fn(value: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables) -> TExpr? Never! {
    if value.ty == (Type.Apply{name: "Measurement", args: [Type]{Type.Float}}) -> return sema_expression_measurement_source_call("__measurement_show", [TExpr]{value}, Type.String, value.span, environment, program)
    Val(value)
}

// The ambient `input`: every line of the program's input, a lazy
// `Iter<String>` over the files its arguments name, in order, else standard
// input. It checks as the line source (THandleOp.LinesIter) of
// `core.term.__input_lines()` (__InputLines), whose `read_line` each pull
// calls: one meaning on every tier. The names are the arguments (Exec.Args).
// Reading the files they name needs no FS.Read grant: the person who ran the
// program designated them on its command line (typed paths are granted), as
// awk's and perl's `<>` operands are. A user
// binding named `input` shadows it; the bare name loads core.term
// (CORE_BARE_SOURCE_MODULES).
sema_call_check_ambient_input: fn(span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if sema_marker_rules_no_prelude_input(span, environment, program, diagnostics) -> return None
    lines: Type.Apply{name: "Iter", args: [Type]{Type.String}}
    effects: [EffectRowEntry]{EffectRowEntry{name: "IO", span: span}, EffectRowEntry{name: "Exec.Args", span: span}, EffectRowEntry{name: "Time.Wait", span: span}}
    facts: SemaCallFacts{return_type: lines.copy(), failure_carrier: TFailureCarrier.Infallible, effect_bound: Val(effects), type_args: [Type]{}, default_refs: [FunctionDefaultRef]{}}
    if !sema_effect_record_intrinsic_fact(environment, program, scopes, context, "input", span, facts, diagnostics) -> return None
    unavailable: sema_error("E0906", span, "the source `core.term.__input_lines` declaration for `input` is unavailable", "the ambient `input` reads through the Core terminal source", "restore the `core.term` source module")
    identity: sema_call_core_module_identity(environment, program, "core.term") ?? {
        diagnostics.push(unavailable)
        return None
    }
    target: sema_call_core_source_target(environment, program, identity, "__input_lines", [Type]{}, span, true, diagnostics) ?? {
        diagnostics.push(unavailable)
        return None
    }
    callee: sema_call_callee_decl(program, target.symbol.id, span, diagnostics) ?? return None
    // `__input_lines` cannot fail (`__InputLines Never!`): the call is the reader.
    returned: sema_call_signature_return(target.signature) ?? return None
    reader: if returned == .Result(ok, _) -> ok.copy() else -> returned
    receiver: sema_tree_node(reader, TExprKind.Call{callee: callee, type_args: [Type]{}, args: [TCallArg]{}}, span)
    value: sema_tree_node(lines, TExprKind.HandleMethod{receiver: receiver, operation: THandleOp.LinesIter, args: [TExpr]{}}, span)
    sema_expr_expected_owned(value, expected, environment, program, diagnostics)
}

// `input(…)`: the ambient `input` is the program's lines, not a function
// (E0803); one line with a prompt is core.term `readline`. The arguments are
// still checked.
sema_call_check_ambient_input_call: fn(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    diagnostics.push(sema_error("E0803", call.name_span, "`input` is Iter<String>, not a function", "`input` is every line of the program's input (the files its arguments name, else standard input), read lazily by a `loop` or an Iter method", "read one line with a prompt through `readline(prompt)` from core.term (`use core.term.[readline]`), or loop over `input`"))
    loop argument in call.args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
    SemaDirectSpecialCheck{handled: true, value: None}
}

// `input.csv<Row>()`, `input.json<Row>()`, `input.edit(change)`: a method of
// the ambient `input` that is not an Iter<String> method is the Core function
// `__input_<method>` of core.term, else of the encoding module the method
// names (core_input_method_modules), and is checked as a call of it whose
// first argument is the ambient `input` itself. The call so charges what
// `input` charges and what the function declares. Unhandled when a binding
// shadows `input` or no module declares the function: `input` is then the
// Iter<String> receiver as usual.
sema_call_try_ambient_input_method: fn(receiver: Expr, method: String, method_span: Span, type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    unhandled: SemaDirectSpecialCheck{handled: false, value: None}
    receiver_span := Span{start: 0, end: 0}
    if receiver == {
        .Ident(name, span, _) -> {
            if name != "input" -> return unhandled
            receiver_span = span
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return unhandled
    }
    if sema_scope_resolve_index(scopes, "input") != None || sema_module_no_prelude(environment, program) -> return unhandled
    member: core_input_method_member(method)
    loop module_name in core_input_method_modules(method) {
        identity: sema_call_core_module_identity(environment, program, module_name) ?? next
        target: sema_call_core_source_target(environment, program, identity, member, type_args, method_span, true, diagnostics) ?? next
        call_args := [CallArg]{CallArg{convention: AccessConvention.Read, expr: receiver.copy(), span: receiver_span, flags: ast_empty_call_arg_flags(), label: None, spread: false}} // copy: the method call keeps its receiver.
        loop argument in args -> call_args.push(argument.copy()) // copy: the method call keeps its arguments.
        scopes.ownership_call_depth += 1
        value := sema_call_core_check_source_owned(target, "input.{method}", type_args, call_args, method_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        scopes.ownership_call_depth -= 1
        return SemaDirectSpecialCheck{handled: true, value: value}
    }
    unhandled
}

// `("core.term", "eprint")` / `("core.term", "readline")`: fixed rows with no typed Source
// contract. `eprint` is variadic: every printable argument joins, one per line, into the row's
// single stderr write (the Rust reference lowering's `join_print_args`); `readline` takes an
// optional String prompt and returns `Result<String, IOError>`.
sema_call_try_term_core_call: fn(record: CoreCallRecord, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if record.module_name != "core.term" -> return SemaDirectSpecialCheck{handled: false, value: None}
    if record.member == {
        "eprint" -> sema_call_check_term_eprint(record, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        "readline" -> sema_call_check_term_readline(record, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        "progress" -> if args.len() == 1 -> SemaDirectSpecialCheck{handled: false, value: None} else -> sema_call_check_term_progress_iter(args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        else -> SemaDirectSpecialCheck{handled: false, value: None}
    }
}

sema_call_check_term_eprint: fn(record: CoreCallRecord, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    complete := true
    if args.len() == 0 {
        diagnostics.push(sema_error("E0103", span, "`eprint` needs at least one thing to print", "printing nothing isn't meaningful", "e.g. io.eprint(\"warning\")"))
        complete = false
    }
    unit: Type.Named{name: "Unit"}
    parts := [TStrPart]{}
    loop argument in args {
        checked: sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            complete = false
            next
        }
        if !sema_expression_typed_literal_printable(checked.ty, environment, program) && checked.ty != unit {
            diagnostics.push(sema_error("E0112", expr_span(argument.expr), "{sema_type_show(checked.ty)} can't be printed yet", "`io.eprint` prints the same values as `print`, but writes to stderr", "print one of its fields, or make it a printable type"))
            complete = false
            next
        }
        if parts.len() > 0 -> parts.push(TStrPart.Literal{text: "\n"})
        formatted: if checked.ty == (Type.Apply{name: "Measurement", args: [Type]{Type.Float}}) -> sema_expression_measurement_source_call("__measurement_show", [TExpr]{checked}, Type.String, checked.span, environment, program) ?? return SemaDirectSpecialCheck{handled: true, value: None} else -> checked
        parts.push(TStrPart.Interpolation{value: formatted, format: TStrFormat.Display})
    }
    if !complete -> return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_call_core_record_effects(record, span, [Type]{}, unit, TFailureCarrier.Infallible, [FunctionDefaultRef]{}, scopes, context, environment, program, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    joined: sema_tree_node(Type.String, TExprKind.StrLit{parts: parts}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_call_core_tree(record, [TExpr]{joined}, span, [Type]{}, [Bool]{false}, unit, TFailureCarrier.Infallible, expected, environment, program, diagnostics)}
}

sema_call_check_term_readline: fn(record: CoreCallRecord, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    complete := true
    if args.len() > 1 {
        diagnostics.push(sema_error("E0104", span, "`readline` expects 1 argument, got {args.len()}", "every argument must match a standard library function parameter", "check the call to `readline`"))
        complete = false
    }
    values := [TExpr]{}
    if args.len() > 0 {
        checked := sema_check_expression(args[0].expr, Val(Type.String), environment, program, scopes, state, tail_store, context, diagnostics)
        if checked == .Val(value) -> values.push(value) else -> complete = false
    } else {
        // The source `readline(prompt: String{""})` takes its default here:
        // the source-owned call passes every normalized argument.
        values.push(sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: ""}}}, span))
    }
    if !complete -> return SemaDirectSpecialCheck{handled: true, value: None}
    result: Type.Result{ok: Type.String, err: Type.Named{name: "IOError"}}
    failure: sema_call_failure_carrier(Val(result))
    if !sema_call_core_record_effects(record, span, [Type]{}, result, failure, [FunctionDefaultRef]{}, scopes, context, environment, program, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    widen_to_vec: loop _ in values -> false
    value: sema_call_core_tree(record, values, span, [Type]{}, widen_to_vec, result, failure, None, environment, program, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    SemaDirectSpecialCheck{handled: true, value: sema_expression_call_expected(value, expected, environment, program, context, diagnostics)}
}

// `("core.term", "progress")` over a sequence: a List or Iter source with a
// description and an optional template is the `progress_iter` row, which hands
// the items on as the loop pulls them. A List is read through its `lazy()`
// iterator; a missing template is empty.
sema_call_check_term_progress_iter: fn(args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    record: core_call("core.term", "progress_iter") ?? return SemaDirectSpecialCheck{handled: false, value: None}
    if args.len() > 3 {
        diagnostics.push(sema_error("E0104", span, "`progress` expects at most 3 arguments, got {args.len()}", "a progress source takes its items, a description and a template", "check the call to `progress`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    source: sema_check_expression(args[0].expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    items: sema_call_collections_list_as_iter(source, span)
    is_iter: if items.ty == .Apply(name, _) -> name == "Iter" else -> false
    if !is_iter {
        diagnostics.push(sema_error("E0108", expr_span(args[0].expr), "`progress` with a description reads a List or an Iter, not `{type_name(items.ty)}`", "the described progress form reports each item the loop pulls", "pass the items to report, or call `progress(label)` alone"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    result: items.ty.copy()
    if !sema_stmt_move_direct(args[0].expr, state, scopes, "`progress`", diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    values := [TExpr]{items}
    loop index in 1..<args.len() {
        text: sema_check_expression(args[index].expr, Val(Type.String), environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        values.push(text)
    }
    loop values.len() < 3 -> values.push(sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{}}, span))
    if !sema_call_core_record_effects(record, span, [Type]{}, result, TFailureCarrier.Infallible, [FunctionDefaultRef]{}, scopes, context, environment, program, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    value: sema_call_core_tree(record, values, span, [Type]{}, [Bool]{false, false, false}, result, TFailureCarrier.Infallible, None, environment, program, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    SemaDirectSpecialCheck{handled: true, value: sema_expression_call_expected(value, expected, environment, program, context, diagnostics)}
}

// `("core.reflect", "of")`: the compiler-owned reflection intrinsic has no
// typed Source contract. Its one argument is legal wherever `"{x}"`
// interpolation is (or a Unit), and the call yields the runtime reflection
// handle `Value`.
sema_call_try_reflect_core_call: fn(record: CoreCallRecord, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if record.module_name != "core.reflect" || record.member != "of" -> return SemaDirectSpecialCheck{handled: false, value: None}
    if args.len() != 1 {
        diagnostics.push(sema_error("E0104", span, "`{record.member}` expects 1 argument, got {args.len()}", "every argument must match a standard library function parameter", "check the call to `{record.member}`"))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    checked: sema_check_expression(args[0].expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_call_reflection_validate_value(checked, expr_span(args[0].expr), environment, program, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    result: Type.Named{name: "Value"}
    if !sema_call_core_record_effects(record, span, [Type]{}, result, TFailureCarrier.Infallible, [FunctionDefaultRef]{}, scopes, context, environment, program, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    names: sema_call_reflection_name_args(checked.ty, span, environment, program, scopes)
    values := [TExpr]{checked}
    values.extend(names)
    widen_to_vec: loop _ in values -> false
    value := sema_tree_node(result, TExprKind.CoreCall{record: record, args: values, source_span: span, type_args: [Type]{}, widen_to_vec: widen_to_vec, fallibility: TFailureCarrier.Infallible}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

// `panic(message)` stops with one String message; the stop is a `Never`
// value and its `__jet_panic__` reachability edge comes from the checked-tree walk.
sema_call_check_ambient_panic: fn(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    // A direct panic is never a Tensor operation's failure route (Rust
    // `check_panic_call`): autodiff rejects a differentiated function that
    // reaches it.
    sema_compute_note_panic(context, false)
    complete := call.args.len() == 1
    if !complete -> diagnostics.push(sema_error("E0103", call.name_span, "`panic` needs exactly one message", "a panic report needs something to show the user", "e.g. panic(\"something went wrong\")"))
    message := TExpr?{None}
    loop argument_index in 0..<call.args.len() {
        checked: sema_check_expression(call.args[argument_index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            complete = false
            next
        }
        if checked.ty != Type.String {
            diagnostics.push(sema_error("E0112", expr_span(call.args[argument_index].expr), "`panic` needs text, but this is {sema_type_show(checked.ty)}", "the panic message is shown to the user as text", "put the message in quotes"))
            complete = false
            next
        }
        message = Val(checked)
    }
    if !complete -> return SemaDirectSpecialCheck{handled: true, value: None}
    text: message ?? return SemaDirectSpecialCheck{handled: true, value: None}
    location := sema_expression_panic_location(environment, program, scopes, call.name_span)
    location.locals = sema_expression_panic_locals(scopes, call.name_span)
    stop := sema_tree_node(Type.Named{name: "Never"}, TExprKind.RequireStop{kind: TRequireKind.Panic{msg: text}, location: location, always_stops: true}, call.name_span)
    SemaDirectSpecialCheck{handled: true, value: Val(stop)}
}

// `assert(condition)` / `assert(condition, message)`.
sema_call_check_ambient_assert: fn(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    complete := call.args.len() == 1 || call.args.len() == 2
    if !complete -> diagnostics.push(sema_error("E0103", call.name_span, "`assert` needs one condition, or a condition and a message", "assert checks a yes/no condition and stops when it's false", "e.g. assert(x > 0) or assert(x > 0, \"x must be positive\")"))
    condition := TExpr?{None}
    if call.args.len() > 0 {
        checked := sema_check_expression(call.args[0].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        if checked == .Val(value) {
            if value.ty != Type.Bool {
                diagnostics.push(sema_error("E0110", expr_span(call.args[0].expr), "`assert` needs {sema_type_show(Type.Bool)}, but this is {sema_type_show(value.ty)}", "the condition must be true or false", "compare values first, e.g. `x > 0`"))
                complete = false
            }
            condition = Val(value)
        } else {
            complete = false
        }
    }
    message := TExpr?{None}
    if call.args.len() > 1 {
        checked := sema_check_expression(call.args[1].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        if checked == .Val(value) {
            if value.ty != Type.String {
                diagnostics.push(sema_error("E0112", expr_span(call.args[1].expr), "`assert` message must be text, but this is {sema_type_show(value.ty)}", "the optional message is shown when the condition is false", "put the message in quotes"))
                complete = false
            }
            message = Val(value)
        } else {
            complete = false
        }
    }
    if !complete -> return SemaDirectSpecialCheck{handled: true, value: None}
    checked_condition: condition ?? return SemaDirectSpecialCheck{handled: true, value: None}
    location := sema_expression_panic_location(environment, program, scopes, call.name_span)
    location.locals = sema_expression_panic_locals(scopes, call.name_span)
    stop := sema_tree_node(Type.Named{name: "Unit"}, TExprKind.RequireStop{kind: TRequireKind.Require{cond: checked_condition, msg: message}, location: location, always_stops: false}, call.name_span)
    SemaDirectSpecialCheck{handled: true, value: Val(stop)}
}

// `assert_eq(got, expected)`: both sides one Equatable type; the right side
// takes the left's type as its expected type, as `==` does, and the sides
// compare through the implementation `==` dispatches to.
sema_call_check_ambient_assert_eq: fn(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if call.args.len() != 2 {
        diagnostics.push(sema_error("E0104", call.name_span, "`assert_eq` needs exactly two values to compare", "assert_eq checks that two values are equal", "e.g. assert_eq(got, expected)"))
        loop argument_index in 0..<call.args.len() -> _ := sema_check_expression(call.args[argument_index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    left := sema_check_expression(call.args[0].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
    right_expected := Type?{None}
    if left == .Val(value) -> right_expected = Val(value.ty)
    right := sema_check_expression(call.args[1].expr, right_expected, environment, program, scopes, state, tail_store, context, diagnostics)
    left_value: left ?? return SemaDirectSpecialCheck{handled: true, value: None}
    right_value: right ?? return SemaDirectSpecialCheck{handled: true, value: None}
    // Declaration identity, not structure: a map type carries the span its
    // key was written at, so two `[String: Int]` maps differ structurally.
    if !type_identity_equal(left_value.ty, right_value.ty) {
        diagnostics.push(sema_error("E0108", call.name_span, "`assert_eq` compared {sema_type_show(left_value.ty)} and {sema_type_show(right_value.ty)}, which don't match", "both sides must be the same type to compare them", "convert one side, or compare fields that have the same type"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_type_equatable(environment, program, left_value.ty) {
        diagnostics.push(sema_error("E0312", call.name_span, "`assert_eq` can't compare values of type `{sema_type_show(left_value.ty)}`", "this type doesn't support `==`", "compare fields individually, or use a different check"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    location := sema_expression_panic_location(environment, program, scopes, call.name_span)
    location.locals = sema_expression_panic_locals(scopes, call.name_span)
    hook: sema_call_assert_eq_hook(left_value, right_value, call.name_span, environment, program, scopes, diagnostics)
    stop := sema_tree_node(Type.Named{name: "Unit"}, TExprKind.RequireStop{kind: TRequireKind.RequireEq{left: left_value, right: right_value, hook: hook}, location: location, always_stops: false}, call.name_span)
    SemaDirectSpecialCheck{handled: true, value: Val(stop)}
}

// `expect(value).snapshot()` asserts that `value`'s
// Display text equals the snapshot `__snapshots__/<file>_<line>.snap` beside
// the test. It is `assert(core.testing.snap(name, "{value}"))` with the name
// taken from the call site, so the first run writes the snapshot, a mismatch
// fails with `snap`'s unified diff, and `jet test -u` rewrites it.
sema_call_check_expect_snapshot: fn(call: Call, args: [CallArg], type_args: [Type], method_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if call.args.len() != 1 || call.args[0].label != None || call.args[0].spread || call.type_args.len() != 0 {
        loop argument in call.args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_error("E0104", call.name_span, "`expect` takes exactly one value", "`expect(value).snapshot()` compares one value with its stored snapshot", "write `expect(value).snapshot()`"))
        return None
    }
    if args.len() != 0 || type_args.len() != 0 {
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_error("E0104", method_span, "`snapshot` takes no arguments", "the snapshot is named after the file and line of the call", "write `expect(value).snapshot()`"))
        return None
    }
    value_span: expr_span(call.args[0].expr)
    text: Expr.Str{parts: [StrPart]{StrPart.Interp{expr: call.args[0].expr, format: StrFormat.Display}}, span: value_span, id: AST_NODE_GENERATED}
    checked_text: sema_check_expression(text, Val(Type.String), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    route: sema_call_core_resolve_route(environment, program, "core.testing", "snap", [Type]{}, 2, false, call.name_span, diagnostics) ?? return None
    target: if route == {
        .Source(source) -> source
        .Core(_) | .SharedSite(_) -> panic("expect(value).snapshot() must resolve core.testing.snap's Jet source body")
    }
    if !sema_effect_record_intrinsic_effects(environment, program, scopes, context, "expect(value).snapshot()", call.name_span, [EffectRowEntry]{EffectRowEntry{name: "FS", span: call.name_span}, EffectRowEntry{name: "Env", span: call.name_span}}, diagnostics) -> return None
    callee: sema_call_callee_decl(program, target.symbol.id, call.name_span, diagnostics) ?? return None
    file: sema_source_file_at(environment.source_segments, environment.source_file, environment.source_origin, call.name_span)
    parts: file.split("/").to_list()
    base: if parts.len() > 0 && parts[parts.len() - 1] != "" -> parts[parts.len() - 1] else -> file
    line: sema_source_line_at(environment.source_segments, call.name_span) ?? 0
    stem: base.replace(".", "_")
    name: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "{stem}_{line}"}}}, call.name_span)
    matched: sema_tree_node(Type.Bool, TExprKind.Call{callee: callee, type_args: [Type]{}, args: [TCallArg]{sema_value_method_source_arg(name), sema_value_method_source_arg(checked_text)}}, call.name_span)
    location := sema_expression_panic_location(environment, program, scopes, call.name_span)
    location.locals = sema_expression_panic_locals(scopes, call.name_span)
    Val(sema_tree_node(Type.Named{name: "Unit"}, TExprKind.RequireStop{kind: TRequireKind.Require{cond: matched, msg: None}, location: location, always_stops: false}, call.name_span))
}

// The authored `equal` (or `compare`) `left == right` dispatches to on a
// nominal operand (sema_expr_equality_resolution); None when the values
// compare structurally, as a derived hook compares them.
sema_call_assert_eq_hook: fn(left: TExpr, right: TExpr, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> TMethodRef? {
    graph: program.registration_graph ?? return None
    if !sema_expr_has_numeric_overload(left.ty) -> return None
    resolved: sema_expr_equality_resolution(graph, BinOp.Eq, left.ty, right.ty, span, environment, program, scopes, diagnostics) ?? return None
    if !resolved.receiver_is_left || resolved.derived -> return None
    Val(resolved.candidate.method)
}

// `("core.mem.scope", "guard")` (option B): the compiler-owned guard has no
// registry row. Its one zero-parameter cleanup lambda becomes the `ScopeGuard`
// whose scope-end drop runs it.
sema_call_try_scope_guard: fn(module_name: String, member: String, alias: String, alias_span: Span, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if module_name != "core.mem.scope" || member != "guard" -> return SemaDirectSpecialCheck{handled: false, value: None}
    imported: sema_call_core_import_target(environment, program, alias) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    if !sema_call_core_record_import_reference(environment, program, scopes, imported, alias_span, context) -> return SemaDirectSpecialCheck{handled: false, value: None}
    if args.len() != 1 {
        diagnostics.push(sema_error("E0104", span, "`guard` expects 1 argument, got {args.len()}", "every argument must match a standard library function parameter", "check the call to `guard`"))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    callback_type: Type.Fn{params: [Type]{}, ret: Val(Type.Named{name: "Unit"}), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    callback: sema_check_expression(args[0].expr, Val(callback_type), environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    cleanup: if callback.kind == {
        .Lambda(value) -> Val(value)
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> None
    } ?? {
        diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`scope.guard` needs a lambda, not {sema_type_show(callback.ty)}", "a scope guard runs a cleanup lambda when the binding goes out of scope", "write `scope.guard(() -> {{ cleanup_code }})`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    arity: cleanup.param_types.len()
    if arity != 0 {
        diagnostics.push(sema_error("E0104", expr_span(args[0].expr), "`scope.guard` needs a zero-parameter lambda, got {arity} parameter{if arity == 1 -> "" else -> "s"}", "the guard body takes no arguments — it captures what it needs via closure", "write `scope.guard(() -> {{ cleanup_code }})` with no parameters"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    value: sema_tree_node(Type.Named{name: "ScopeGuard"}, TExprKind.CoreClosureCall{kind: TCoreClosureKind.Guard{executable: cleanup}}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}
// Core registry rows are selected by the caller's canonical route.  These
// source-owned projections run before the generic fixed-row producer; an
// unhandled projection deliberately leaves the row for that producer.
sema_call_try_core_direct_record: fn(record: CoreCallRecord, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck Never! {
    // Both compiler facts and active build-plan graphs use the checked
    // compile-time service path. Receipt diff remains ordinary Core source.
    if (record.module_name == "core.compiler" || (record.module_name == "core.build" && record.member == "graph")) && sema_compiler_services_call_contract(record.module_name, record.member) != None {
        // A body checked on a compiler thread keeps its name in location_function (Control.jet).
        compiler_allowed := scopes.comptime_execution_depth > 0 || (scopes.location_function ?? environment.function_name) == "build"
        check := sema_compiler_services_check_call(record.module_name, record.member, args, span, compiler_allowed, environment, program, scopes, state, tail_store, context, diagnostics)
        if !check.recognized -> return SemaDirectSpecialCheck{handled: true, value: None}
        if !check.arguments_complete {
            sema_expression_rejected_call_propagation(check.result_type, None, diagnostics.len(), span, expected, environment, program, scopes, context, diagnostics)
            return SemaDirectSpecialCheck{handled: true, value: None}
        }
        value := sema_compiler_services_lower_core_call(check, span, expected, environment, program, scopes, context, diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: value}
    }

    term := sema_call_try_term_core_call(record, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if term.handled -> return term

    reflect := sema_call_try_reflect_core_call(record, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if reflect.handled -> return reflect

    // Every `core.compute` call is recorded before any
    // route returns, so a source-owned member stays visible to the autodiff
    // trace check exactly like a transform.
    _ := sema_compute_record_core_call(record, span, context)

    reactive := sema_call_try_reactive_core_call(record.module_name, record.member, args, type_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if reactive.handled -> return reactive

    data := sema_call_try_data_core_call(record.module_name, record.member, args, type_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if data.handled -> return data

    http := sema_call_try_http_core_call(record, args, type_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if http.handled -> return http

    service := sema_call_try_service_core_call(record.module_name, record.member, args, type_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if service.handled -> return service

    SemaDirectSpecialCheck{handled: false, value: None}
}
sema_call_try_core_direct_call: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck Never! {
    before: diagnostics.len()
    unbuilt := SemaCoreUnbuiltCall?{None}
    checked: sema_call_core_direct_checked(call, expected, environment, program, scopes, state, tail_store, context, unbuilt, diagnostics)
    if checked.handled -> sema_call_core_unbuilt_settle(unbuilt, before, diagnostics)
    checked
}

sema_call_core_direct_checked: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, unbuilt: &SemaCoreUnbuiltCall?, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck Never! {
    alias := call.name
    member := ""
    if call.name.contains(".") {
        parts := call.name.split(".").to_list()
        if parts.len() != 2 -> return SemaDirectSpecialCheck{handled: false, value: None}
        alias = parts[0]
        member = parts[1]
    } else {
        // A Core host-leaf item import (`use core.files.[__host_path_join]`,
        // registered as a Foreign symbol: no Jet declaration) is called by
        // its local name; its member is the imported item.
        visible: sema_scope_resolve_index(scopes, call.name) ?? return SemaDirectSpecialCheck{handled: false, value: None}
        if scopes.bindings[visible].symbol.kind != SymbolKind.Foreign -> return SemaDirectSpecialCheck{handled: false, value: None}
        imported: sema_call_core_import_target(environment, program, call.name) ?? return SemaDirectSpecialCheck{handled: false, value: None}
        member = imported.item ?? return SemaDirectSpecialCheck{handled: false, value: None}
    }
    module_name: sema_call_core_import_module(environment, program, alias) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    if sema_call_core_math_exact_crossing(module_name, member, call.args, environment, program, scopes, state, tail_store, context) == .Val(crossed) {
        return sema_call_try_core_direct_call(Call{name: call.name, name_span: call.name_span, type_args: call.type_args, args: crossed}, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    sema_call_core_unbuilt_note(module_name, member, call.name_span, environment, program, unbuilt)
    guard := sema_call_try_scope_guard(module_name, member, alias, call.name_span, call.args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if guard.handled -> return guard
    ui := sema_call_try_ui_core_call(module_name, member, alias, call.name_span, call.args, call.type_args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if ui.handled -> return ui
    decode := sema_call_try_args_decode(module_name, member, alias, call.name_span, call.args, call.type_args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if decode.handled -> return decode
    form := sema_call_try_web_form(module_name, member, alias, call.name_span, call.args, call.type_args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if form.handled -> return form
    transform := sema_call_try_compute_transform(module_name, member, alias, call.name_span, call.args, call.type_args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if transform.handled -> return transform
    fetched := sema_call_try_comptime_fetch(module_name, member, call.args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if fetched.handled -> return fetched
    live := sema_call_try_live(module_name, member, alias, call.name_span, call.args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if live.handled -> return live
    // `reactive.signal/derived/computed/autorun` have no Core call record:
    // they check here, not by route.
    if module_name == "core.reactive" && (member == "signal" || member == "derived" || member == "computed" || member == "autorun") {
        return sema_call_try_reactive_core_call(module_name, member, call.args, call.type_args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    if sema_call_core_crypto_expert_gate(module_name, member, call.name_span, context, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    if sema_call_core_vault_build_time_gate(module_name, member, call.name_span, scopes, environment.function_name, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    if sema_call_core_variadic_print(environment, program, scopes, alias, member, call.args.len(), call.name_span, context) -> return sema_call_check_ambient_print(call, environment, program, scopes, state, tail_store, context, diagnostics)
    diagnostics_before := diagnostics.len()
    route := sema_call_core_resolve_import_route(environment, program, scopes, alias, member, call.type_args, call.args.len(), sema_call_core_configured_client(call.args), call.name_span, call.name_span, context, diagnostics)
    route_value: route ?? {
        if diagnostics.len() != diagnostics_before -> return SemaDirectSpecialCheck{handled: true, value: None}
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    if route_value == {
        .SharedSite(lifetime) -> { return SemaDirectSpecialCheck{handled: true, value: sema_call_core_global_shared(lifetime, member, call.type_args, call.args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)} }
        .Source(target) -> {
            math_abs: sema_call_try_core_math_abs(module_name, member, call.type_args, call.args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            if math_abs.handled -> return math_abs
            float_class: sema_call_try_core_math_float_class(module_name, member, call.type_args, call.args, environment, program, scopes, state, tail_store, context, diagnostics)
            if float_class.handled -> return float_class
            f32_math: sema_call_try_core_math_f32(module_name, member, call.type_args, call.args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            if f32_math.handled -> return f32_math
            compute_alias: sema_call_try_compute_alias(module_name, member, target, call.type_args, call.args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            if compute_alias.handled -> return SemaDirectSpecialCheck{handled: true, value: compute_alias.value}
            if module_name == "core.ui" && member == "node_role" -> sema_call_core_ui_node_role_lint(call.args, call.name_span, environment, program, scopes, diagnostics)
            scopes.ownership_call_depth += 1
            value := sema_call_core_check_source_owned(target, call.name, call.type_args, call.args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            scopes.ownership_call_depth -= 1
            return SemaDirectSpecialCheck{handled: true, value: value}
        }
        .Core(record) -> {
            special := sema_call_try_core_direct_record(record, call.args, call.type_args, call.name_span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            if special.handled -> return special
            scopes.ownership_call_depth += 1
            value := sema_call_core_check_fixed(environment, program, module_name, member, call.type_args, call.args, call.name_span, expected, scopes, state, tail_store, context, diagnostics)
            scopes.ownership_call_depth -= 1
            return SemaDirectSpecialCheck{handled: true, value: value}
        }
    }
}

sema_call_default_err_span: fn(call: Call) -> Span {

    if {
        call.args.len() > 0 -> {
            last: call.args[call.args.len() - 1]
            Span{start: call.name_span.start, end: expr_span(last.expr).end}
        }
        else -> call.name_span
    }
}

sema_call_default_err_result: fn(expected: Type?) -> Type? {
    expected_value: expected ?? return None
    normalized: sema_expr_unwrap_tag(expected_value)
    if normalized == {
        .Result(ok, err) -> Val(Type.Result{ok: ok, err: err})
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// This predicate is intentionally keyed to the dedicated compiler binding.
// A source/imported function or type named Err remains the ordinary resolver
// winner, matching native shadowing behavior.
sema_call_default_err_candidate: fn(call: Call, expected: Type?, scopes: SemaScopeTable) -> Bool Never! {
    if call.name != "Err" -> return false
    index: sema_scope_resolve_index(scopes, call.name) ?? return false
    sema_scope_binding_is_compiler_builtin(scopes.bindings[index], "Err")
}

sema_call_default_err_invalid_argument: fn(argument: CallArg, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_call_default_err_optional: fn(value: Expr?, value_span: Span?, span: Span) -> Expr {
    if value == {
        .Val(expression) -> {
            present_span: value_span ?? expr_span(expression)
            Expr.Present{value: expression, span: present_span, id: AST_NODE_GENERATED}
        }
        .None -> Expr.Absent{span: span, id: AST_NODE_GENERATED}
    }
}

sema_call_default_err_contextual_result: fn(call: Call, result: Type, ok: Type, err: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if call.args.len() != 1 || call.args[0].label != None -> return None
    payload: sema_check_expression(call.args[0].expr, Val(err), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    compatible: sema_call_type_assignable(err, payload.ty, environment, program) ?? return None
    if !compatible {
        diagnostics.push(sema_type_mismatch(err, payload.ty, expr_span(call.args[0].expr)))
        return None
    }
    value: sema_tree_node(result, TExprKind.Err{value: payload}, sema_call_default_err_span(call))
    sema_expr_expected(value, Val(result), environment, program, diagnostics)
}

sema_call_default_err_constructor: fn(call: Call, expected: Type?, wrap_result: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    span: sema_call_default_err_span(call)
    if call.args.len() < 1 || call.args.len() > 3 {
        diagnostics.push(sema_error("E0104", call.name_span, "`Err` takes a message and optional `code:` and `cause:`, got {call.args.len()} arguments", "the default error stores one message, one optional code, and one optional cause", "write `Err(\"message\")`, then add `code:` or `cause:` labels if needed"))
    }
    message := Expr?{None}
    code := Expr?{None}
    cause := Expr?{None}
    code_span := Span?{None}
    cause_span := Span?{None}
    loop index in 0..<call.args.len() {
        argument: call.args[index]
        label_span := argument.span
        label_name := String?{None}
        if argument.label == .Val(label) {
            label_span = label.span
            label_name = Val(label.name)
        }
        if {
            index == 0 -> {
                if label_name != None -> diagnostics.push(sema_error("E0767", label_span, "`message` is the positional argument of `Err`", "the short constructor starts with the error message", "remove the label and write `Err(\"message\", ...)`"))
                message = Val(argument.expr)
            }
            label_name == (Val("code")) -> {
                if {
                    code != None -> {
                        diagnostics.push(sema_error("E0765", label_span, "`code:` is written twice in this call to `Err`", "each constructor label sets one field", "remove the second `code:` argument"))
                        sema_call_default_err_invalid_argument(argument, environment, program, scopes, state, tail_store, context, diagnostics)
                    }
                    else -> {
                        code = Val(argument.expr)
                        code_span = Val(label_span)
                    }
                }
            }
            label_name == (Val("cause")) -> {
                if {
                    cause != None -> {
                        diagnostics.push(sema_error("E0765", label_span, "`cause:` is written twice in this call to `Err`", "each constructor label sets one field", "remove the second `cause:` argument"))
                        sema_call_default_err_invalid_argument(argument, environment, program, scopes, state, tail_store, context, diagnostics)
                    }
                    else -> {
                        cause = Val(argument.expr)
                        cause_span = Val(label_span)
                    }
                }
            }
            label_name != None -> {
                label: label_name ?? ""
                diagnostics.push(sema_error("E0764", label_span, "`Err` has no parameter labelled `{label}`", "the optional labels are `code:` and `cause:`", "use `code:` or `cause:`, or remove the argument"))
                sema_call_default_err_invalid_argument(argument, environment, program, scopes, state, tail_store, context, diagnostics)
            }
            else -> {
                diagnostics.push(sema_error("E0769", argument.span, "optional `Err` arguments need labels", "`code:` and `cause:` can appear in either order only because their labels identify them", "add `code:` or `cause:` before this argument"))
                sema_call_default_err_invalid_argument(argument, environment, program, scopes, state, tail_store, context, diagnostics)
            }
        }
    }
    message_expr: message ?? Expr.Str{parts: [StrPart]{StrPart.Lit{text: ""}}, span: span, id: AST_NODE_GENERATED}
    fields: [ExprField]{
        {name: "message", name_span: expr_span(message_expr), value: message_expr},
        {name: "code", name_span: span, value: sema_call_default_err_optional(code, code_span, span)},
        {name: "cause", name_span: span, value: sema_call_default_err_optional(cause, cause_span, span)},
    }
    struct_expr: Expr.StructLit{type_name: "Err", type_args: [Type]{}, import_ns: None, as_trait: None, fields: fields, inferred: false, span: span, id: AST_NODE_GENERATED}
    payload: sema_check_expression(struct_expr, Val(Type.Named{name: "Err"}), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if !wrap_result -> return Val(payload)
    result_value: sema_call_default_err_result(expected) ?? Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "Err"}}
    return if result_value == {
        .Result(ok, err) -> {
            compatible: sema_call_type_assignable(err, payload.ty, environment, program) ?? return None
            if !compatible {
                diagnostics.push(sema_type_mismatch(err, payload.ty, span))
                return None
            }
            value: sema_tree_node(Type.Result{ok: ok, err: err}, TExprKind.Err{value: payload}, span)
            sema_expr_expected(value, expected, environment, program, diagnostics)
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> Val(payload)
    }
}

// A union that holds the general `Err` is open: `Err("message")` builds that
// member, the same default error an unannotated function's message sends.
sema_call_default_err_message_into_open_union: fn(value: Expr, err: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Bool {
    open := false
    if sema_expr_unwrap_tag(err) == .Union(members) {
        loop member in members {
            if sema_expr_unwrap_tag(member) == (Type.Named{name: "Err"}) -> open = true
        }
    }
    if !open -> return false
    message: sema_failure_union_unparen(value)
    if message == .Str(_, _, _) -> return true
    probed: sema_failure_union_probe_type(message, environment, program, scopes, state, tail_store, context) ?? return false
    sema_expr_unwrap_tag(probed) == .String
}

sema_call_check_default_err: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    result: sema_call_default_err_result(expected)
    if result == .Val(result_value) {
        // #3708: an `Err(...)` that builds a carrier is a failure source of
        // its own (the Rust reference's checked `Expr::Err`); the empty key
        // never resolves.
        context.failure_edges.push("")
        if result_value == .Result(ok, err) {
            if err != (Type.Named{name: "Err"}) && call.args.len() == 1 && call.args[0].label == None && !sema_call_default_err_message_into_open_union(call.args[0].expr, err, environment, program, scopes, state, tail_store, context) {
                return sema_call_default_err_contextual_result(call, result_value, ok, err, environment, program, scopes, state, tail_store, context, diagnostics)
            }
            // Record what this `Err` sends down the
            // default route before the ordinary check below.
            if err == (Type.Named{name: "Err"}) -> sema_failure_union_record_err(call, environment, program, scopes, state, tail_store, context)
        }
    }
    wrap: result != None
    value: sema_call_default_err_constructor(call, expected, wrap, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    sema_expr_expected(value, expected, environment, program, diagnostics)
}

sema_call_local_default_values: fn(target: SemaCallDirectTarget, binding: SemaCallBinding, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> [SemaCallDefaultValue]? {
    if binding.default_refs.len() == 0 -> return Val([SemaCallDefaultValue]{})
    declaration: sema_scope_resolve_declaration(environment, program, target.symbol.id) ?? return None
    func: if declaration == {
        .Func(value) -> value
        .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {
            return None
        }
    }
    defaults := [SemaCallDefaultValue]{}
    loop reference in binding.default_refs {
        if reference.owner_key != target.symbol.id.key -> return None
        parameter_index: reference.parameter_index
        if parameter_index < 0 || parameter_index >= func.params.len() -> return None
        expression: func.params[parameter_index].default ?? return None
        expression_span: expr_span(expression)
        if expression_span.start != reference.span.start || expression_span.end != reference.span.end -> return None
        source_file: sema_source_file_at(environment.source_segments, reference.source_file, environment.source_origin, expression_span)
        if source_file != reference.source_file -> return None
        defaults.push(SemaCallDefaultValue{reference: reference, expression: expression})
    }
    Val(defaults)
}

// `waiting` is the first argument whose probe checked to no value without an
// error: a read still waiting on a compile-time value (another module's
// constant not staged yet) that gives inference no type. `lambda_returns` are
// the written-parameter lambdas' return facts, also the last of the type lists.
SemaCallInferenceFacts: struct {
    parameter_types: [Type]
    argument_types: [Type]
    waiting: Int?
    lambda_returns: [SemaCallLambdaReturn]
}

// Argument `argument`, a lambda whose parameters are all written, returns
// `value` where its parameter's `fn` type returns `required`.
SemaCallLambdaReturn: struct {
    argument: Int
    required: Type
    value: Type
}

sema_call_inference_needs_context: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Lambda(_, _) -> true
        .ListLit(elements, _, _) -> elements.len() == 0
        .MapLit(entries, _, _) -> entries.len() == 0
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

sema_call_collect_inference_facts: fn(params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> SemaCallInferenceFacts Never! {
    parameter_types := [Type]{}
    argument_types := [Type]{}
    waiting := Int?{None}
    lambda_returns := [SemaCallLambdaReturn]{}
    loop index in 0..<args.len() {
        slot: if index < binding.slots.len() -> binding.slots[index] else -> -1
        if slot >= 0 && slot < params.len() {
            if sema_call_argument_parameter_type(params[slot], args[index]) == .Val(required) {
                if !sema_call_inference_needs_context(args[index].expr) {
                    probe_diagnostics := [Diagnostic]{}
                    value: sema_probe_expression(args[index].expr, None, environment, program, scopes, state, tail_store, context, probe_diagnostics)
                    if value == .Val(checked) {
                        parameter_types.push(required)
                        argument_types.push(checked.ty)
                    } else if waiting == None && !sema_has_error_since(probe_diagnostics, 0) {
                        waiting = Val(index)
                    }
                } else if sema_call_lambda_params_written(args[index].expr) {
                    fact: sema_call_lambda_return_fact(index, required, args[index].expr, environment, program, scopes, state, tail_store, context) ?? next
                    lambda_returns.push(fact)
                }
            }
        }
    }
    // The lambda returns unify after the plain arguments, so a type parameter
    // a plain argument settles stays settled and a lambda returning another
    // type is the conflict (sema_call_lambda_return_conflicts).
    loop row in lambda_returns {
        parameter_types.push(row.required)
        argument_types.push(row.value)
    }
    SemaCallInferenceFacts{parameter_types: parameter_types, argument_types: argument_types, waiting: waiting, lambda_returns: lambda_returns}
}

// A trait-bounded variadic's arity function gives each trailing argument its
// own slot type parameter (`parts__Va0`). An argument whose type misses a
// slot's bound is E1313 at that argument, before inference names the slot.
sema_call_variadic_slot_bounds_met: fn(target: SemaCallDirectTarget, callee: String, params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if program.registration_graph == None -> return true
    loop index in 0..<args.len() {
        slot: if index < binding.slots.len() -> binding.slots[index] else -> -1
        if slot < 0 || slot >= params.len() -> next
        required: sema_call_argument_parameter_type(params[slot], args[index]) ?? next
        if required == .Named(slot_type) {
            parameter_name: sema_variadic_bound_slot_parameter(slot_type) ?? next
            bounds := [String]{}
            loop parameter in target.generic_params {
                if parameter.name == slot_type {
                    bounds = parameter.bounds.copy()
                    break
                }
            }
            probe_diagnostics := [Diagnostic]{}
            checked: sema_probe_expression(args[index].expr, None, environment, program, scopes, state, tail_store, context, probe_diagnostics) ?? next
            loop bound in bounds {
                if sema_call_variadic_bound_met(bound, checked.ty, environment, program) != (Val(false)) -> next
                diagnostics.push(sema_call_variadic_bound_unmet(type_name(checked.ty), parameter_name, bound, callee, expr_span(args[index].expr)))
                return false
            }
        }
    }
    true
}

// A value that is never a number (text, a Bool, a list, ...) passed for a
// `Numeric`-bound type parameter is E0112 at that argument, naming the callee
// and the argument as a fixed number parameter does, not E0905 at the callee
// asking for an `impl` the type can't have.
sema_call_numeric_slot_arguments_met: fn(target: SemaCallDirectTarget, callee: String, params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    loop index in 0..<args.len() {
        slot: if index < binding.slots.len() -> binding.slots[index] else -> -1
        if slot < 0 || slot >= params.len() -> next
        required: sema_call_argument_parameter_type(params[slot], args[index]) ?? next
        if required == .Named(slot_type) {
            numeric := false
            loop parameter in target.generic_params {
                if parameter.name != slot_type -> next
                loop bound in parameter.bounds {
                    if bound == "Numeric" -> numeric = true
                }
            }
            if !numeric -> next
            probe_diagnostics := [Diagnostic]{}
            checked: sema_probe_expression(args[index].expr, None, environment, program, scopes, state, tail_store, context, probe_diagnostics) ?? next
            if !sema_type_never_numeric(checked.ty) -> next
            diagnostics.push(sema_error("E0112", expr_span(args[index].expr), "`{sema_call_reflection_leaf_name(callee)}` wants a number (a `Numeric` type such as Int) for argument {index + 1}, but this is {sema_type_show(checked.ty)}", "every argument must match its parameter's type", "use a number here, such as Int (a whole number)"))
            return false
        }
    }
    true
}

// Built-in types no `#Numeric` marker or `impl Numeric` can make a number.
sema_type_never_numeric: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Tuple(_) | .FixedList(_, _) -> true
        .Tagged(_, inner) -> sema_type_never_numeric(inner)
        .Int | .Float | .Named(_) | .Measure(_) | .Apply(_, _) | .Quantity(_, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Shared(_) | .Union(_) -> false
    }
}

sema_call_lambda_params_written: fn(expr: Expr) -> Bool Never! {
    if expr == .Lambda(lambda, _) {
        loop param in lambda.params {
            if param.ty == None -> return false
        }
        return true
    }
    false
}

// A lambda whose parameters are all written is typed on its own, so its
// return fills the type parameters of the required `fn` return. Of a
// `U E!` return only `U` is this fact: the failure part is
// sema_call_lambda_failure_facts' own.
sema_call_lambda_return_fact: fn(argument: Int, required: Type, lambda: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> SemaCallLambdaReturn? Never! {
    required_value := Type?{None}
    if required == .Fn(_, required_ret, _, _, _, _) -> required_value = required_ret
    ret: required_value ?? return None
    probe_diagnostics := [Diagnostic]{}
    checked: sema_probe_expression(lambda, None, environment, program, scopes, state, tail_store, context, probe_diagnostics) ?? return None
    lambda_value := Type?{None}
    if checked.ty == .Fn(_, lambda_ret, _, _, _, _) -> lambda_value = lambda_ret
    value: lambda_value ?? return None
    if value == .Named(name) {
        if name == "Never" -> return None
    }
    if ret == .Result(ok, _) {
        if value == .Result(value_ok, _) -> return Val(SemaCallLambdaReturn{argument: argument, required: ok, value: value_ok})
        return Val(SemaCallLambdaReturn{argument: argument, required: ok, value: value})
    }
    Val(SemaCallLambdaReturn{argument: argument, required: ret, value: value})
}

// A type parameter the plain arguments settled that a written-parameter
// lambda returns another type for is E0904 at the callee, naming both
// sources; checking the arguments then reports the lambda's own E0112.
sema_call_lambda_return_conflicts: fn(target: SemaCallDirectTarget, rows: [SemaCallLambdaReturn], params: [SemaCallParam], binding: SemaCallBinding, span: Span, diagnostics: &[Diagnostic]) {
    loop row in rows {
        if row.required == .Named(name) {
            loop substitution in target.generic_substitutions {
                if substitution.name != name || type_identity_equal(substitution.ty, row.value) -> next
                source := "the other arguments"
                loop index in 0..<binding.slots.len() {
                    slot: binding.slots[index]
                    if index == row.argument || slot < 0 || slot >= params.len() -> next
                    if sema_call_parameter_type(params[slot]) == (Val(Type.Named{name: name})) {
                        source = "argument {index + 1}"
                        break
                    }
                }
                diagnostics.push(sema_error("E0904", span, "can't figure out what `{name}` should be here", "one generic type parameter received incompatible concrete types", "{name} is {type_name(substitution.ty)} from {source} but {type_name(row.value)} from the lambda return; make those types agree"))
            }
        }
    }
}

// A lambda argument fills a failure-type parameter `E`
// written as `fn(..) -> U E!` with the failure its body really has. The lambda
// is probed on its own; a body that cannot fail, or one that cannot be typed
// before the other type parameters are known, binds `E` to `Never`.
sema_call_lambda_failure_facts: fn(facts: &SemaCallInferenceFacts, generic_params: [SemaInferenceTypeParam], params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) Never! {
    loop index in 0..<args.len() {
        slot: if index < binding.slots.len() -> binding.slots[index] else -> -1
        if sema_call_inference_needs_context(args[index].expr) && slot >= 0 && slot < params.len() {
            if sema_call_parameter_type(params[slot]) == .Val(required) {
                if required == .Fn(_, required_ret, _, _, _, _) {
                    if required_ret == .Val(ret) {
                        if ret == .Result(_, error) {
                            if error == .Named(name) {
                                generic := false
                                loop param in generic_params {
                                    if param.name == name -> generic = true
                                }
                                if generic {
                                    failure := Type.Named{name: "Never"}
                                    probe_diagnostics := [Diagnostic]{}
                                    value: sema_probe_expression(args[index].expr, None, environment, program, scopes, state, tail_store, context, probe_diagnostics)
                                    if value == .Val(checked) {
                                        if checked.ty == .Fn(_, lambda_ret, _, _, _, _) {
                                            if lambda_ret == .Val(lambda_value) {
                                                if lambda_value == .Result(_, lambda_error) -> failure = lambda_error
                                            }
                                        }
                                    }
                                    facts.parameter_types.push(error)
                                    facts.argument_types.push(failure)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sema_call_direct_target_abi: fn(target: SemaCallDirectTarget, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaRegistrationCallableABI? {
    if program.registration_graph == .Val(graph) {
        abi := sema_registration_callable_abi(graph, target.symbol.id)
        if abi != None -> return abi
    }
    declaration: sema_scope_resolve_declaration(environment, program, target.symbol.id) ?? return None
    if declaration == {
        .Func(func) -> Val(sema_registration_callable_abi_for_func(func))
        .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}

// Rust `check_direct_call` (L0202 shared_auto_clone): a bare `Shared` name
// passed to a direct call inside a loop retains the handle once per pass.
sema_call_lint_shared_loop_arguments: fn(args: [CallArg], environment: SemaScopeEnvironment, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) {
    if scopes.loop_depth <= 0 -> return
    loop argument in args {
        if argument.expr == .Ident(name, span, _) {
            index: sema_scope_resolve_index_at(scopes, name, span) ?? next
            ty: sema_scope_binding_type(environment, scopes, index) ?? next
            if ty == .Shared(_) -> diagnostics.push(sema_lint("L0202", span, "Auto-cloned `{name}` inside a loop; consider hoisting or caching", "Shared handles are cloned when used across a loop boundary", "Hoist `{name}` before the loop, or clone once outside"))
        }
    }
}

sema_call_direct_checked_from_target: fn(state: &SemaOwnershipState, target: SemaCallDirectTarget, call: Call, defaults: [SemaCallDefaultValue], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaCallChecked? {
    candidate := target
    params := sema_call_params_from_type(candidate.signature) ?? {
        diagnostics.push(sema_call_not_callable(call.name, candidate.signature, call.name_span))
        return None
    }
    source_args := call.args
    args := call.args
    root_mark: diagnostics.len()
    binding := sema_call_bind_direct(call.name, candidate.signature, args, call.name_span, diagnostics) ?? {
        sema_call_direct_rejected_propagation(candidate, call, root_mark, expected, environment, program, scopes, context, diagnostics)
        return None
    }
    if candidate.generic_params.len() > 0 && candidate.generic_substitutions.len() != candidate.generic_params.len() {
        inferred_facts := sema_call_collect_inference_facts(params, binding, source_args, environment, program, scopes, state, tail_store, context)
        sema_call_lambda_failure_facts(inferred_facts, candidate.generic_params, params, binding, source_args, environment, program, scopes, state, tail_store, context)
        if sema_call_http_source_json_target(candidate, environment, program) {
            loop parameter in candidate.generic_params {
                loop bound in parameter.bounds {
                    if bound != "Encode" -> next
                    loop index in 0..<inferred_facts.parameter_types.len() {
                        if inferred_facts.parameter_types[index] == (Type.Named{name: parameter.name}) {
                            body_type: inferred_facts.argument_types[index]
                            if !sema_serde_type_is_admissible(environment, program, body_type, SemaSerdeDirection.Encode) {
                                sema_call_http_check_serde(SemaSerdeDirection.Encode, body_type, expr_span(source_args[index].expr), environment, program, diagnostics)
                                return None
                            }
                        }
                    }
                }
            }
        }
        if !sema_call_variadic_slot_bounds_met(candidate, call.name, params, binding, source_args, environment, program, scopes, state, tail_store, context, diagnostics) -> return None
        if !sema_call_numeric_slot_arguments_met(candidate, call.name, params, binding, source_args, environment, program, scopes, state, tail_store, context, diagnostics) -> return None
        inference_diagnostics := [Diagnostic]{}
        inferred: sema_call_infer_direct_target_from_types(candidate, inferred_facts.parameter_types, inferred_facts.argument_types, expected, environment, program, scopes, call.name_span, inference_diagnostics) ?? {
            // An argument still waiting on a compile-time value has no type
            // yet. Checking it records the wait, so the call is checked again
            // once the value lands, not reported as uninferrable.
            if inferred_facts.waiting == .Val(index) {
                _ := sema_check_expression(source_args[index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
                return None
            }
            loop diagnostic in inference_diagnostics -> diagnostics.push(diagnostic)
            return None
        }
        loop diagnostic in inference_diagnostics -> diagnostics.push(diagnostic)
        sema_call_lambda_return_conflicts(inferred, inferred_facts.lambda_returns, params, binding, call.name_span, diagnostics)
        candidate = inferred
        params = sema_call_params_from_type(candidate.signature) ?? {
            diagnostics.push(sema_call_not_callable(call.name, candidate.signature, call.name_span))
            return None
        }
        args = call.args
        binding = sema_call_bind_direct(call.name, candidate.signature, args, call.name_span, diagnostics) ?? return None
    }
    if !sema_call_direct_target_generic_ready(candidate, diagnostics, call.name_span) -> return None
    resolved_binding := binding
    resolved_defaults := defaults
    if binding.default_refs.len() > 0 {
        if resolved_defaults.len() == 0 {
            if program.registration_graph == {
                .Val(graph) -> {
                    registered_defaults: sema_call_registration_defaults(graph, binding) ?? {
                        diagnostics.push(sema_error("E0906", call.name_span, "a default argument for this call could not be resolved", "registered callable defaults retain their graph identity and source location", "make the bound default available to Registration before checking this call"))
                        return None
                    }
                    resolved_defaults = registered_defaults
                }
                .None -> {
                    local_defaults: sema_call_local_default_values(candidate, binding, environment, program, scopes) ?? {
                        diagnostics.push(sema_error("E0906", call.name_span, "a default argument for this call could not be resolved", "callable defaults retain their owning declaration and source identity", "make the owning declaration available to Registration before checking this call"))
                        return None
                    }
                    resolved_defaults = local_defaults
                }
            }
        }
        resolved: sema_call_materialize_defaults(params, binding, args, resolved_defaults, call.name_span, diagnostics) ?? return None
        resolved_binding = resolved
    }
    abi: sema_call_direct_target_abi(candidate, environment, program)
    (lowered, pins) := sema_call_check_bound_arguments_owned(state, call.name, params, abi, true, resolved_binding, args, environment, program, scopes, tail_store, context, call.name_span, diagnostics) ?? {
        sema_call_direct_rejected_propagation(candidate, call, root_mark, expected, environment, program, scopes, context, diagnostics)
        return None
    }
    sema_call_lint_shared_loop_arguments(source_args, environment, scopes, diagnostics)
    callee_facts: sema_contract_function_facts(environment, program, candidate.symbol.id)
    if callee_facts == .Val(facts) {
        if facts.param_view_from.len() > 0 && !sema_call_check_param_view_from(facts, resolved_binding.slots, source_args, scopes, state, diagnostics) -> return None
    }
    result_type_raw: sema_call_signature_return(candidate.signature) ?? return None
    result_type: sema_call_resolved_type(result_type_raw, environment, program)
    // E2104: a C import whose convention or values the native backend has no
    // C ABI marshalling for yet (#6366) is refused by a compile that lowers
    // the call, instead of stopping inside the IR.
    if abi == .Val(callable_abi) && callable_abi.is_c_abi && !environment.module_identity.starts_with("<corelib>/") && sema_refuses_unbuilt(program) {
        if program.registration_graph == .Val(graph) {
            if sema_checked_foreign_c_marshal_gap(graph, candidate.symbol.id) == .Val(gap) {
                diagnostics.push(sema_error("E2104", call.name_span, "calling `{call.name}` is not built yet", "This `jet` cannot yet {gap}, and no other `jet` can build it.", "Remove the `{call.name}` call for now; native C ABI marshalling for it needs its Jet implementation first (card #6366)."))
                return None
            }
        }
    }
    contract_bindings := [TStmt]{}
    contract_nodes := [TContract]{}
    // The callee's declaration is copied only when a call checks its clauses.
    contract_callee := Func?{None}
    if callee_facts == .Val(facts) && facts.call_checks > 0 -> contract_callee = sema_contract_function_for_symbol(environment, program, candidate.symbol.id)
    if contract_callee == .Val(contract) {
        slots: loop slot in 0..<params.len() -> slot
        // copy: the contract check may stage this call again by name; the call keeps its written type arguments and its checked type.
        recall: SemaContractRecall{call: Call{name: call.name, name_span: call.name_span, type_args: call.type_args.copy(), args: [CallArg]{}}, result_type: result_type.copy()}
        checked_contract: sema_contract_check_call(contract, candidate.symbol.id, Val(recall), lowered, slots, call.name_span, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        contract_bindings = checked_contract.bindings
        contract_nodes = checked_contract.contracts
    }
    policy_diagnostic_count: diagnostics.len()
    policy_value: sema_policy_direct_value(candidate, call.name_span, environment, program, scopes, state, tail_store, context, diagnostics)
    if sema_has_error_since(diagnostics, policy_diagnostic_count) -> return None
    call_value: if policy_value == .Val(callee) -> {
        sema_tree_node(result_type, TExprKind.IndirectCall{callee: callee, type_args: candidate.type_args, args: lowered, signature: candidate.signature}, call.name_span)
    } else -> {
        callee: sema_call_callee_decl(program, candidate.symbol.id, call.name_span, diagnostics) ?? return None
        sema_tree_node(result_type, TExprKind.Call{callee: callee, type_args: candidate.type_args, args: lowered}, call.name_span)
    }
    contracted: if {
        contract_nodes.len() > 0 -> {
            wrapped := contract_bindings
            loop contract in contract_nodes -> wrapped.push(TStmt.Contract{contract: contract})
            wrapped.push(TStmt.ExprStmt{value: call_value, span: call.name_span})
            sema_tree_node(result_type, TExprKind.InlineBlock{body: wrapped}, call.name_span)
        }
        else -> call_value
    }
    value: sema_call_with_binder_pins(pins, contracted, call.name_span)
    checked: sema_expression_call_expected(value, expected, environment, program, context, diagnostics) ?? return None
    facts: sema_call_facts(candidate.signature, candidate.type_args, resolved_binding) ?? return None
    return_view_facts: sema_call_return_view_facts(candidate.signature, None, args, resolved_binding, scopes, state, call.name_span, diagnostics)
    Val(SemaCallChecked{value: checked, binding: resolved_binding, facts: facts, return_view_facts: return_view_facts})
}

// A direct call rejected at its arguments after its callee resolved: the
// callee's declared result still auto-propagates, linked to the call's own
// error (sema_expression_rejected_call_propagation). Only a rejection that
// reported an error has one: an argument still waiting on a compile-time
// value rejects without one and is checked again. The check adds reports
// only; the facts it would record belong to a call that never lowers, and a
// discarded probe must not keep them, so the context is rolled back. A
// generic callee whose type arguments are still open has no settled result
// type to check.
sema_call_direct_rejected_propagation: fn(candidate: SemaCallDirectTarget, call: Call, root_mark: Int, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    if !sema_has_error_since(diagnostics, root_mark) -> return
    if candidate.generic_params.len() > 0 && candidate.generic_substitutions.len() != candidate.generic_params.len() -> return
    result_type_raw: sema_call_signature_return(candidate.signature) ?? return
    result_type: sema_call_resolved_type(result_type_raw, environment, program)
    source: Expr.Call{call: call.copy(), id: AST_NODE_GENERATED}
    mark: sema_check_context_save(context)
    sema_expression_rejected_call_propagation(result_type, Val(source), root_mark, call.name_span, expected, environment, program, scopes, context, diagnostics)
    sema_check_context_rollback(context, mark.move())
}

// A
// parameter `word: View<str> from corpus` takes only an argument whose view
// owners stay inside the places of the arguments passed for the named sibling
// parameters (E2305). `slots` maps each written argument to its parameter.
sema_call_check_param_view_from: fn(callee: SemaContractCalleeFacts, slots: [Int], args: [CallArg], scopes: SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> Bool {
    valid := true
    loop (index, required) in callee.param_view_from {
        names: required ?? next
        written: sema_call_written_arg_for_slot(slots, index) ?? next
        argument_span: expr_span(args[written].expr)
        actual: sema_ownership_places_from_expr_in_state(args[written].expr, scopes, state)
        if actual.len() == 0 -> next
        allowed := [SemaOwnershipPlace]{}
        loop name in names {
            source_index: loop (position, param_name) in callee.param_names {
                if param_name == name -> break Val(position)
            } ?? None
            source: source_index ?? {
                diagnostics.push(sema_error("E2305", argument_span, "`from {name}` does not name a parameter", "a parameter `from` clause names sibling parameters (or `self`) that own the view", "use a parameter name from this function's signature"))
                valid = false
                next
            }
            source_written: sema_call_written_arg_for_slot(slots, source) ?? next
            loop place in sema_ownership_places_from_expr_in_state(args[source_written].expr, scopes, state) -> allowed.push(place)
        }
        if allowed.len() == 0 -> next
        inside: loop place in actual {
            covered: loop owner in allowed {
                if place.root_key != "" && place.root_key == owner.root_key && sema_ownership_path_starts(place.projections, owner.projections) -> break true
            } ?? false
            if !covered -> break false
        } ?? true
        if !inside {
            diagnostics.push(sema_error("E2305", argument_span, "`{callee.param_names[index]}` must borrow from its declared `from` sources", "this argument's view owners are outside the sources named after `from`", "pass a view derived from those sources, or widen the `from` clause"))
            valid = false
        }
    }
    valid
}

// The written argument bound to parameter `slot`, or None for a default.
sema_call_written_arg_for_slot: fn(slots: [Int], slot: Int) -> Int? Never! {
    loop (written, bound) in slots {
        if bound == slot -> return Val(written)
    }
    None
}

sema_call_check_direct_target_owned: fn(state: &SemaOwnershipState, target: SemaCallDirectTarget, call: Call, defaults: [SemaCallDefaultValue], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaCallChecked? {
    sema_call_direct_checked_from_target(state, target, call, defaults, expected, environment, program, scopes, tail_store, context, diagnostics)
}

// The Rust direct_calls forms ahead of ordinary name resolution
// (check_call_inner), taken first by sema_expr_check_direct_call.
// `measurement(value, uncertainty:)` and 's `apply(policy..., f)` apply
// only unshadowed.
sema_call_try_direct_forms: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if call.name == "measurement" && sema_scope_resolve_index(scopes, call.name) == None {
        labeled: call.args.len() == 2 && call.args[0].label == None && (if call.args[1].label == {
            .Val(label) -> label.name == "uncertainty"
            .None -> false
        })
        if !labeled {
            loop argument_index in 0..<call.args.len() -> _ := sema_check_expression(call.args[argument_index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
            diagnostics.push(sema_error("E0104", call.name_span, "`measurement` needs a value and labeled uncertainty", "a measured value enters the exactness plane at one explicit constructor", "write `measurement(value, uncertainty: standard_uncertainty)`"))
            return SemaDirectSpecialCheck{handled: true, value: None}
        }
        values := [TExpr]{}
        loop argument_index in 0..<call.args.len() {
            value: sema_check_expression(call.args[argument_index].expr, Val(Type.Float), environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
            if !sema_ownership_check_call_receiver(state, call.args[argument_index].expr, AccessConvention.Read, scopes, call.args[argument_index].span, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
            values.push(value)
        }
        result: Type.Apply{name: "Measurement", args: [Type]{Type.Float}}
        value: sema_expression_measurement_source_call("__measurement_new", values, result, call.name_span, environment, program) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        return SemaDirectSpecialCheck{handled: true, value: sema_expr_expected_owned(value, expected, environment, program, diagnostics)}
    }
    sema_policy_try_apply(call, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_call_check_freeze: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if call.args.len() != 1 {
        sema_stream_handle_infer_args(call.args, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_error("E0104", call.name_span, "`freeze` takes exactly one value, got {call.args.len()}", "`freeze(x)` creates one deeply immutable owned snapshot for a crossing", "write `freeze(value)` with exactly one value"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    source := call.args[0].expr
    previous_borrow := context.borrow_ctx
    previous_string_view_read := context.allow_string_view_read
    context.borrow_ctx = true
    context.allow_string_view_read = true
    checked_source := sema_check_expression(source, None, environment, program, scopes, state, tail_store, context, diagnostics)
    context.borrow_ctx = previous_borrow
    context.allow_string_view_read = previous_string_view_read
    checked: checked_source ?? return SemaDirectSpecialCheck{handled: true, value: None}
    string_view := sema_expr_copy_string_view(source, scopes)
    facts := sema_copy_classify(checked.ty, SemaCopyIntent.Clone, environment, program, context.generic_params, string_view)
    problem := sema_ownership_crossing_problem(facts.target, SemaSendCrossing.FrozenSnapshot, true, environment, program, scopes, context)
    reason := String?{None}
    if problem == .Val(found) && found.kind == SemaSendProblemKind.SharedMutation -> reason = Val(sema_ownership_crossing_describe(found))
    if reason == None && facts.resource -> reason = Val("a resource has one cleanup owner and cannot be duplicated into a snapshot")
    if reason == None && (!facts.complete || !facts.cloneable) -> reason = Val("the value contains a resource, function, trait value, or mutable view that Jet cannot duplicate")
    if reason == .Val(explanation) {
        row: diagnostic_registry_row("E1114") ?? panic("E1114 has no registry row")
        what := row.what.replace("{{ty}}", type_name(checked.ty)).replace("{{reason}}", explanation)
        diagnostics.push(sema_error("E1114", expr_span(source), what, row.why, row.fix))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if problem == .Val(found) {
        diagnostics.push(sema_ownership_crossing_diagnostic("this frozen value", facts.target, found, SemaSendCrossing.TaskCapture, expr_span(source)))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    already_frozen := sema_ownership_frozen_expr_site(state, source, scopes) != None
    result := checked
    if !already_frozen {
        if sema_copy_memory_operation(facts) != None || sema_copy_effect_name(facts) != None -> context.copy_events.push(SemaCopyEvent{span: call.name_span, facts: facts})
        kind := if facts.materializes_view -> TExprKind.MaterializeView{value: checked} else -> TExprKind.Clone{value: checked, fact: CopyFact.Explicit}
        result = sema_tree_expr(facts.target, kind, call.name_span)
    }
    state.freeze_sites.push(SemaOwnershipFreezeSite{span: call.name_span, line: sema_source_line_at(environment.source_segments, call.name_span) ?? 1, column: sema_source_column_at(environment.source_segments, call.name_span) ?? 1})
    checked_result := sema_expression_call_expected(result, expected, environment, program, context, diagnostics)
    SemaDirectSpecialCheck{handled: true, value: checked_result}
}

// E2475 (`core.web.table.column`): a literal column name is checked against the
// one row schema the table sorts, filters and renders.
sema_call_web_table_column_schema: fn(args: [CallArg], checked: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) {
    if args.len() == 0 -> return
    column := String?{None}
    if sema_registration_cli_without_parens(args[0].expr) == .Str(parts, _, _) {
        if parts.len() == 1 && parts[0] == .Lit(text) -> column = Val(text.copy())
    }
    column_name: column ?? return
    schema := Type?{None}
    // The checked call keeps its `Never!` carrier (`WebTableColumn<Order> Never!`).
    column_ty := sema_expr_unwrap_tag(checked.ty)
    if column_ty == .Result(ok, _) -> column_ty = sema_expr_unwrap_tag(ok)
    if column_ty == .Apply(_, type_args) {
        if type_args.len() == 1 -> schema = Val(type_args[0])
    }
    row := schema ?? return
    loop {
        if row == .Tagged(_, inner) {
            row = inner
        } else {
            break
        }
    }
    span: args[0].span
    row_name := ""
    if row == .Named(name) -> row_name = name
    if row == .Apply(name, _) -> row_name = name
    if row_name == "" {
        diagnostics.push(sema_error("E2475", span, "table column `{column_name}` needs a declared row schema, got `{sema_type_show(row)}`", "table columns are checked against row fields before a renderer can consume them", "declare a row struct, then use one of its fields as the column name"))
        return
    }
    definition: sema_http_route_find_struct(environment, program, row, environment.module_identity) ?? {
        diagnostics.push(sema_error("E2475", span, "table column `{column_name}` needs fields from row type `{row_name}`", "a typed table column must resolve against a declared row schema", "declare the row fields before constructing the table column"))
        return
    }
    known: definition.fields.map(field -> field.name)
    loop field in known {
        if field == column_name -> return
    }
    suggestion: sema_suggest_field(column_name, known)
    what := "table column `{column_name}` is not a field on `{row_name}`"
    fix := "rename the column to one of the existing fields: {known.join(", ")}"
    if suggestion == .Val(field) {
        what = "table column `{column_name}` is not a field on `{row_name}`; did you mean `{field}`?"
        fix = "rename the column to the existing field `{field}`"
    }
    diagnostics.push(sema_error("E2475", span, what, "the table keeps one row schema for sorting, filtering, and every renderer", fix))
}
