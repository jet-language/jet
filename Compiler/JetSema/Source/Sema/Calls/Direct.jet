// Direct-call resolution and TIR construction.
// Ordinary local names resolve through SemaScopeTable. Registration may pass a
// specialized SemaCallDirectTarget for imported, overloaded, or Core routes.

pub struct SemaDirectSpecialCheck {
    pub handled: Bool
    pub value: TExpr?
}

fn sema_call_special_diagnostic(name: String, span: Span) -> Diagnostic {
    sema_error("E1005", span, "`{name}` must wrap a single integer `+`, `-`, `*`, or `/`", "the overflow opt-ins apply to one arithmetic operation on whole numbers", "write it around one operation, e.g. `{name}(a + b)`")
}

fn sema_call_check_special_overflow(call: Call, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if call.args.len() != 1 {
        loop argument in call.args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        &diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    argument :: call.args[0]
    operation := None
    if argument.expr == .Binary(op, _, _, _) {
        if sema_call_is_overflow_operation(op) -> operation = Val(op)
    }
    operation_value :: operation ?? {
        _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        &diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    gate :: sema_call_direct_gate(call.name, scopes) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    gate_scope :: sema_call_enter_gate(&scopes, gate)
    checked_argument :: sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    sema_call_leave_gate(&scopes, gate_scope)
    argument_value :: checked_argument ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_expr_is_integer(argument_value.ty) {
        &diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    lhs := None
    rhs := None
    if argument_value.kind == .Binary(_, _, _, left, right) {
        lhs = Val(left)
        rhs = Val(right)
    }
    lhs_value :: lhs ?? {
        &diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    rhs_value :: rhs ?? {
        &diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    line :: sema_source_line_at(environment.source_segments, call.name_span) ?? 0
    policy :: argument.flags.arithmetic_policy
    result_ty :: if call.name == "checked" -> Type.Option{inner: lhs_value.ty} else -> lhs_value.ty
    value :: sema_tir_expr(result_ty, TExprKind.OverflowOpt{prefix: call.name, operation: sema_call_overflow_operation_name(operation_value), line: line, policy: policy, lhs: lhs_value, rhs: rhs_value}, call.name_span)
    checked :: sema_expr_expected(value, expected, environment, &diagnostics)
    SemaDirectSpecialCheck{handled: true, value: checked}
}

fn sema_call_check_special_approx(call: Call, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if call.args.len() != 1 {
        loop argument in call.args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        &diagnostics.push(sema_error("E0104", call.name_span, "`approx` takes one whole number", "`approx(value)` accepts possible precision loss at one integer-to-float crossing", "write `approx(value)`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    gate :: sema_call_direct_gate(call.name, scopes) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    scope :: sema_call_enter_gate(&scopes, gate)
    checked_argument :: sema_check_expression(call.args[0].expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    sema_call_leave_gate(&scopes, scope)
    argument :: checked_argument ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_expr_is_integer(argument.ty) {
        &diagnostics.push(sema_error("E0109", call.args[0].span, "`approx` needs a whole number, but this is {type_name(argument.ty)}", "`approx(value)` only opts one integer-to-float crossing out of its exactness check", "remove `approx`, or pass a whole number that is crossing into a decimal"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    target :: if expected == {
        .Val(expected_type) -> if expected_type == {
            .Float32 -> Type.Float32
            else -> Type.Float
        }
        else -> Type.Float
    }
    line :: sema_source_line_at(environment.source_segments, call.name_span) ?? 0
    converted :: sema_expr_numeric_conversion(argument, target, call.name_span, line) ?? argument
    checked :: sema_expr_expected(converted, expected, environment, &diagnostics)
    SemaDirectSpecialCheck{handled: true, value: checked}
}

pub fn sema_call_try_knowledge_builtin(call: Call, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if !sema_call_gate_is_unshadowed(call.name, scopes) -> return SemaDirectSpecialCheck{handled: false, value: None}
    if call.name == {
        "wrapping" | "saturating" | "checked" -> sema_call_check_special_overflow(call, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        "approx" -> sema_call_check_special_approx(call, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        else -> SemaDirectSpecialCheck{handled: false, value: None}
    }
}
// Core registry rows are selected by the caller's canonical route.  These
// source-owned projections run before the generic fixed-row producer; an
// unhandled projection deliberately leaves the row for that producer.
pub fn sema_call_try_core_direct_record(record: CoreCallRecord, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    // The compiler query checker has a source-owned lowerer only for the
    // compiler API.  Build graph rows stay on the fixed Core path until their
    // caller-approved lowering exists; no runtime-shaped fallback is invented.
    if record.module_name == "core.compiler" && sema_compiler_services_call_contract(record.module_name, record.member) != None {
        compiler_allowed := scopes.comptime_execution_depth > 0
        check := sema_compiler_services_check_call(record.module_name, record.member, args, span, compiler_allowed, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if !check.recognized -> return SemaDirectSpecialCheck{handled: true, value: None}
        if !check.arguments_complete -> return SemaDirectSpecialCheck{handled: true, value: None}
        value := sema_compiler_services_lower_core_call(check, span, expected, environment, &scopes, &context, &diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: value}
    }

    models := sema_call_try_compute_models_core_call(record, args, type_args, span, expected, [SemaCallModelOutputInput]{}, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if models.handled -> return SemaDirectSpecialCheck{handled: true, value: models.value}

    reactive := sema_call_try_reactive_core_call(record.module_name, record.member, args, type_args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if reactive.handled -> return reactive

    data := sema_call_try_data_core_call(record.module_name, record.member, args, type_args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if data.handled -> return data

    http := sema_call_try_http_core_call(record, args, type_args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if http.handled -> return http

    service := sema_call_try_service_core_call(record.module_name, record.member, args, type_args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if service.handled -> return service

    ui := sema_call_try_ui_core_call(record.module_name, record.member, args, type_args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if ui.handled -> return ui

    SemaDirectSpecialCheck{handled: false, value: None}
}
pub fn sema_call_try_core_direct_call(call: Call, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if !call.name.contains(".") -> return SemaDirectSpecialCheck{handled: false, value: None}
    parts := call.name.split(".")
    if parts.len() != 2 -> return SemaDirectSpecialCheck{handled: false, value: None}
    alias := parts[0]
    member := parts[1]
    module_name :: sema_call_core_import_module(environment, alias) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    expected_type_arg_count := 0
    if core_call_typed_signature(module_name, member, call.args.len()) == {
        .Val(signature) -> expected_type_arg_count = signature.type_parameters.len()
        .None -> {}
    }
    diagnostics_before := diagnostics.len()
    route := sema_call_core_resolve_import_route(environment, scopes, alias, member, call.type_args, expected_type_arg_count, true, call.args.len(), call.name_span, call.name_span, &context, &diagnostics)
    route_value :: route ?? {
        if diagnostics.len() != diagnostics_before -> return SemaDirectSpecialCheck{handled: true, value: None}
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    if route_value == {
        .Source(target) -> {
            scopes.ownership_call_depth += 1
            value := sema_call_core_check_source_owned(target, call.name, call.type_args, call.args, call.name_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            scopes.ownership_call_depth -= 1
            return SemaDirectSpecialCheck{handled: true, value: value}
        }
        .Core(record) -> {
            special := sema_call_try_core_direct_record(record, call.args, call.type_args, call.name_span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            if special.handled -> return special
            scopes.ownership_call_depth += 1
            value := sema_call_core_check_fixed(environment, module_name, member, call.type_args, call.args, call.name_span, expected, &scopes, &state, &tail_store, &context, &diagnostics)
            scopes.ownership_call_depth -= 1
            return SemaDirectSpecialCheck{handled: true, value: value}
        }
    }
}


fn sema_call_default_err_span(call: Call) -> Span {

    if {
        call.args.len() > 0 -> {
            last :: call.args[call.args.len() - 1]
            Span{start: call.name_span.start, end: expr_span(last.expr).end}
        }
        else -> call.name_span
    }
}

fn sema_call_default_err_result(expected: Type?) -> Type? {
    expected_value :: expected ?? return None
    normalized :: sema_expr_unwrap_tag(expected_value)
    if normalized == {
        .Result(ok, err) -> Val(Type.Result{ok: ok, err: err})
        else -> None
    }
}

// This predicate is intentionally keyed to the dedicated compiler binding.
// A source/imported function or type named Err remains the ordinary resolver
// winner, matching native shadowing behavior.
pub fn sema_call_default_err_candidate(call: Call, expected: Type?, scopes: SemaScopeTable) -> Bool Never! {
    if call.name != "Err" -> return false
    index :: sema_scope_resolve_index(scopes, call.name) ?? return false
    sema_scope_binding_is_compiler_builtin(scopes.bindings[index], "Err")
}

fn sema_call_default_err_invalid_argument(argument: CallArg, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
}

fn sema_call_default_err_optional(value: Expr?, value_span: Span?, span: Span) -> Expr {
    if value == {
        .Val(expression) -> {
            present_span :: value_span ?? expr_span(expression)
            Expr.Present{value: expression, span: present_span}
        }
        else -> Expr.Absent{span: span}
    }
}

fn sema_call_default_err_contextual_result(call: Call, result: Type, ok: Type, err: Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if call.args.len() != 1 || call.args[0].label != None -> return None
    payload :: sema_check_expression(call.args[0].expr, Val(err), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    compatible :: sema_call_type_assignable(err, payload.ty, environment) ?? return None
    if !compatible {
        &diagnostics.push(sema_type_mismatch(err, payload.ty, expr_span(call.args[0].expr)))
        return None
    }
    value :: sema_tir_expr(result, TExprKind.Err{value: payload}, sema_call_default_err_span(call))
    sema_expr_expected(value, Val(result), environment, &diagnostics)
}

fn sema_call_default_err_constructor(call: Call, expected: Type?, wrap_result: Bool, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    span :: sema_call_default_err_span(call)
    if call.args.len() < 1 || call.args.len() > 3 {
        &diagnostics.push(sema_error("E0104", call.name_span, "`Err` takes a message and optional `code:` and `cause:`, got {call.args.len()} arguments", "the default error stores one message, one optional code, and one optional cause", "write `Err(\"message\")`, then add `code:` or `cause:` labels if needed"))
    }
    message := None
    code := None
    cause := None
    code_span := None
    cause_span := None
    loop index in 0..<call.args.len() {
        argument :: call.args[index]
        label_span := argument.span
        label_name := None
        if argument.label == .Val(label) {
            label_span = label.span
            label_name = Val(label.name)
        }
        if {
            index == 0 -> {
                if label_name != None -> &diagnostics.push(sema_error("E0767", label_span, "`message` is the positional argument of `Err`", "the short constructor starts with the error message", "remove the label and write `Err(\"message\", ...)`"))
                message = Val(argument.expr)
            }
            label_name == (Val("code")) -> {
                if {
                    code != None -> {
                        &diagnostics.push(sema_error("E0765", label_span, "`code:` is written twice in this call to `Err`", "each constructor label sets one field", "remove the second `code:` argument"))
                        sema_call_default_err_invalid_argument(argument, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                    }
                    else -> {
                        code = Val(argument.expr)
                        code_span = Val(label_span)
                    }
                }
            }
            label_name == (Val("cause")) -> {
                if {
                    cause != None -> {
                        &diagnostics.push(sema_error("E0765", label_span, "`cause:` is written twice in this call to `Err`", "each constructor label sets one field", "remove the second `cause:` argument"))
                        sema_call_default_err_invalid_argument(argument, environment, &scopes, &state, &tail_store, &context, &diagnostics)
                    }
                    else -> {
                        cause = Val(argument.expr)
                        cause_span = Val(label_span)
                    }
                }
            }
            label_name != None -> {
                label :: label_name ?? ""
                &diagnostics.push(sema_error("E0764", label_span, "`Err` has no parameter labelled `{label}`", "the optional labels are `code:` and `cause:`", "use `code:` or `cause:`, or remove the argument"))
                sema_call_default_err_invalid_argument(argument, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            }
            else -> {
                &diagnostics.push(sema_error("E0769", argument.span, "optional `Err` arguments need labels", "`code:` and `cause:` can appear in either order only because their labels identify them", "add `code:` or `cause:` before this argument"))
                sema_call_default_err_invalid_argument(argument, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            }
        }
    }
    message_expr :: message ?? Expr.Str{parts: [StrPart]{StrPart.Lit{text: ""}}, span: span}
    fields :: [ExprField]{
        ExprField{name: "message", name_span: expr_span(message_expr), value: message_expr},
        ExprField{name: "code", name_span: span, value: sema_call_default_err_optional(code, code_span, span)},
        ExprField{name: "cause", name_span: span, value: sema_call_default_err_optional(cause, cause_span, span)},
    }
    struct_expr :: Expr.StructLit{type_name: "Err", type_args: [Type]{}, import_ns: None, as_trait: None, fields: fields, inferred: false, span: span}
    payload :: sema_check_expression(struct_expr, Val(Type.Named{name: "Err"}), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if !wrap_result -> return Val(payload)
    result_value :: sema_call_default_err_result(expected) ?? Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "Err"}}
    return if result_value == {
        .Result(ok, err) -> {
            compatible :: sema_call_type_assignable(err, payload.ty, environment) ?? return None
            if !compatible {
                &diagnostics.push(sema_type_mismatch(err, payload.ty, span))
                return None
            }
            value :: sema_tir_expr(Type.Result{ok: ok, err: err}, TExprKind.Err{value: payload}, span)
            sema_expr_expected(value, expected, environment, &diagnostics)
        }
        else -> Val(payload)
    }
}

pub fn sema_call_check_default_err(call: Call, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    result :: sema_call_default_err_result(expected)
    if result == .Val(result_value) {
        if result_value == .Result(ok, err) {
            if err != (Type.Named{name: "Err"}) && call.args.len() == 1 && call.args[0].label == None {
                return sema_call_default_err_contextual_result(call, result_value, ok, err, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            }
        }
    }
    wrap :: result != None
    value :: sema_call_default_err_constructor(call, expected, wrap, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    sema_expr_expected(value, expected, environment, &diagnostics)
}

fn sema_call_local_default_values(target: SemaCallDirectTarget, binding: SemaCallBinding, environment: SemaScopeEnvironment, scopes: &SemaScopeTable) -> [SemaCallDefaultValue]? {
    if binding.default_refs.len() == 0 -> return Val([SemaCallDefaultValue]{})
    declaration :: sema_scope_resolve_declaration(environment, target.symbol.id) ?? return None
    func :: if declaration == {
        .Func(value) -> value
        else -> {
            return None
        }
    }
    defaults := [SemaCallDefaultValue]{}
    loop reference in binding.default_refs {
        if reference.owner_key != target.symbol.id.key -> return None
        parameter_index :: reference.parameter_index
        if parameter_index < 0 || parameter_index >= func.params.len() -> return None
        expression :: func.params[parameter_index].default ?? return None
        expression_span :: expr_span(expression)
        if expression_span.start != reference.span.start || expression_span.end != reference.span.end -> return None
        source_file :: sema_source_file_at(environment.source_segments, reference.source_file, environment.source_origin, expression_span)
        if source_file != reference.source_file -> return None
        &defaults.push(SemaCallDefaultValue{reference: reference, expression: expression})
    }
    Val(defaults)
}

struct SemaCallInferenceFacts {
    pub parameter_types: [Type]
    pub argument_types: [Type]
}

fn sema_call_inference_needs_context(expr: Expr) -> Bool Never! {
    if expr == {
        .Lambda(_) -> true
        .ListLit(elements, _) -> elements.len() == 0
        .MapLit(entries, _) -> entries.len() == 0
        else -> false
    }
}

fn sema_call_collect_inference_facts(params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> SemaCallInferenceFacts Never! {
    parameter_types := [Type]{}
    argument_types := [Type]{}
    loop index in 0..<args.len() {
        slot :: if index < binding.slots.len() -> binding.slots[index] else -> -1
        if slot >= 0 && slot < params.len() {
            if sema_call_parameter_type(params[slot]) == .Val(required) && !sema_call_inference_needs_context(args[index].expr) {
                probe_scopes := sema_scope_snapshot(scopes)
                probe_context := sema_check_context_snapshot(context)
                probe_state := sema_ownership_state_snapshot(state)
                probe_diagnostics := [Diagnostic]{}
                value :: sema_check_expression(args[index].expr, None, environment, &probe_scopes, &probe_state, &tail_store, &probe_context, &probe_diagnostics)
                if value == .Val(checked) {
                    &parameter_types.push(required)
                    &argument_types.push(checked.ty)
                }
            }
        }
    }
    SemaCallInferenceFacts{parameter_types: parameter_types, argument_types: argument_types}
}

fn sema_call_direct_target_abi(target: SemaCallDirectTarget, environment: SemaScopeEnvironment) -> SemaRegistrationCallableAbi? {
    if environment.registration_graph == .Val(graph) {
        abi := sema_registration_callable_abi(graph, target.symbol.id)
        if abi != None -> return abi
    }
    declaration :: sema_scope_resolve_declaration(environment, target.symbol.id) ?? return None
    if declaration == {
        .Func(func) -> Val(sema_registration_callable_abi_for_func(func))
        else -> None
    }
}

fn sema_call_direct_checked_from_target(state: &SemaOwnershipState, target: SemaCallDirectTarget, call: Call, defaults: [SemaCallDefaultValue], expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaCallChecked? {
    candidate := target
    params := sema_call_params_from_type(candidate.signature) ?? {
        &diagnostics.push(sema_call_not_callable(call.name, candidate.signature, call.name_span))
        return None
    }
    source_args := call.args
    args := call.args
    binding := sema_call_bind_direct(call.name, candidate.signature, &args, call.name_span, &diagnostics) ?? return None
    if candidate.generic_params.len() > 0 && candidate.generic_substitutions.len() != candidate.generic_params.len() {
        inferred_facts := sema_call_collect_inference_facts(params, binding, source_args, environment, &scopes, &state, &tail_store, &context)
        inferred :: sema_call_infer_direct_target_from_types(candidate, inferred_facts.parameter_types, inferred_facts.argument_types, expected, environment, &scopes, call.name_span, &diagnostics) ?? return None
        candidate = inferred
        params = sema_call_params_from_type(candidate.signature) ?? {
            &diagnostics.push(sema_call_not_callable(call.name, candidate.signature, call.name_span))
            return None
        }
        args = call.args
        binding = sema_call_bind_direct(call.name, candidate.signature, &args, call.name_span, &diagnostics) ?? return None
    }
    if !sema_call_direct_target_generic_ready(candidate, &diagnostics, call.name_span) -> return None
    resolved_binding := binding
    resolved_defaults := defaults
    if binding.default_refs.len() > 0 {
        if resolved_defaults.len() == 0 {
            if environment.registration_graph == {
                .Val(graph) -> {
                    registered_defaults :: sema_call_registration_defaults(graph, binding) ?? {
                        &diagnostics.push(sema_error("E0906", call.name_span, "a default argument for this call could not be resolved", "registered callable defaults retain their graph identity and source location", "make the bound default available to Registration before checking this call"))
                        return None
                    }
                    resolved_defaults = registered_defaults
                }
                else -> {
                    local_defaults :: sema_call_local_default_values(candidate, binding, environment, &scopes) ?? {
                        &diagnostics.push(sema_error("E0906", call.name_span, "a default argument for this call could not be resolved", "callable defaults retain their owning declaration and source identity", "make the owning declaration available to Registration before checking this call"))
                        return None
                    }
                    resolved_defaults = local_defaults
                }
            }
        }
        resolved :: sema_call_materialize_defaults(params, binding, &args, resolved_defaults, call.name_span, &diagnostics) ?? return None
        resolved_binding = resolved
    }
    abi :: sema_call_direct_target_abi(candidate, environment)
    lowered := sema_call_check_bound_arguments_owned(&state, call.name, params, abi, true, resolved_binding, &args, environment, &scopes, &tail_store, &context, call.name_span, &diagnostics) ?? return None
    result_type_raw :: sema_call_signature_return(candidate.signature) ?? return None
    result_type :: sema_call_resolved_type(result_type_raw, environment)
    contract_bindings := [TStmt]{}
    contract_nodes := [TContract]{}
    if sema_contract_function_for_symbol(environment, candidate.symbol.id) == .Val(contract) {
        slots :: loop source_index in 0..<resolved_binding.sources.len() -> sema_call_bound_slot(resolved_binding, resolved_binding.sources[source_index], lowered[source_index])
        checked_contract :: sema_contract_check_call(contract, &lowered, slots, call.name_span, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        contract_bindings = checked_contract.bindings
        contract_nodes = checked_contract.contracts
    }
    call_value :: sema_tir_expr(result_type, TExprKind.Call{callee: candidate.symbol.id, type_args: candidate.type_args, args: lowered}, call.name_span)
    value :: if {
        contract_nodes.len() > 0 -> {
            wrapped := contract_bindings
            loop contract in contract_nodes -> &wrapped.push(TStmt.Contract{contract: contract})
            &wrapped.push(TStmt.ExprStmt{value: call_value, span: call.name_span})
            sema_tir_expr(result_type, TExprKind.InlineBlock{body: wrapped}, call.name_span)
        }
        else -> call_value
    }
    checked :: sema_expression_call_expected(value, expected, environment, context, &diagnostics) ?? return None
    facts :: sema_call_facts(candidate.signature, candidate.type_args, resolved_binding) ?? return None
    return_view_facts :: sema_call_return_view_facts(candidate.signature, None, args, resolved_binding, scopes, state, call.name_span)
    Val(SemaCallChecked{value: checked, binding: resolved_binding, facts: facts, return_view_facts: return_view_facts})
}

pub fn sema_call_check_direct_target_owned(state: &SemaOwnershipState, target: SemaCallDirectTarget, call: Call, defaults: [SemaCallDefaultValue], expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaCallChecked? {
    sema_call_direct_checked_from_target(&state, target, call, defaults, expected, environment, &scopes, &tail_store, &context, &diagnostics)
}

pub fn sema_call_check_direct_target(state: &SemaOwnershipState, target: SemaCallDirectTarget, call: Call, defaults: [SemaCallDefaultValue], expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked :: sema_call_direct_checked_from_target(&state, target, call, defaults, expected, environment, &scopes, &tail_store, &context, &diagnostics) ?? return None
    Val(checked.value)
}

pub fn sema_call_check_direct(state: &SemaOwnershipState, call: Call, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    special :: sema_call_try_knowledge_builtin(call, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if special.handled -> return special.value
    if sema_call_default_err_candidate(call, expected, scopes) {
        return sema_call_check_default_err(call, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    target :: sema_call_resolve_direct(call.name, call.type_args, environment, &scopes, call.name_span, &diagnostics) ?? return None
    checked :: sema_call_direct_checked_from_target(&state, target, call, [SemaCallDefaultValue]{}, expected, environment, &scopes, &tail_store, &context, &diagnostics) ?? return None
    if call.name == "assert_eq" && sema_call_gate_is_unshadowed(call.name, scopes) {
        if checked.value.kind == .Call(_, _, arguments) {
            if !sema_comparability_check_assert_eq(arguments, call.name_span, environment, &diagnostics) -> return None
        }
    }
    Val(checked.value)
}

