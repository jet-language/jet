// Direct-call resolution and checked-tree construction.
// Ordinary local names resolve through SemaScopeTable. Registration may pass a
// specialized SemaCallDirectTarget for imported, overloaded, or Core routes.
use {
    jet_foundation.[
        BodyHandleOp,
        symbol_is_local,
        symbol_is_none,
        AST_NODE_GENERATED,
        AccessConvention,
        BinOp,
        Call,
        CallArg,
        CoreCallRecord,
        Diagnostic,
        EffectRowEntry,
        Expr,
        ExprField,
        FunctionDefaultRef,
        Item,
        Program,
        Stmt,
        CopyFact,
        Span,
        StrPart,
        SymbolKind,
        TFailureCarrier,
        TLetTy,
        TextEdit,
        Type,
        diagnostic_with_edit,
        expr_span,
        AST_EMPTY_CALL_ARG_FLAGS,
        checked_generated_local,
        core_input_method_module,
        core_input_method_role,
        type_identity_equal,
        type_name,
        Func,
        module_is_core,
    ]
    jet_parser.[parser_service_import]
}

SemaDirectSpecialCheck: struct {
    handled: Bool,
    value: TExpr?,
}

sema_call_special_diagnostic: fn(name: String, span: Span) -> Diagnostic {
    sema_error("E1005", span, "`{name}` must wrap a single integer `+`, `-`, `*`, or `/`, or one narrowing conversion", "the overflow opt-ins apply to one arithmetic operation on whole numbers, or to one conversion to a fixed width that can't hold every value of its source", "write it around one operation or conversion, e.g. `{name}(a + b)` or `{name}(U8{{count}})`")
}

sema_call_check_special_overflow: fn(call: Call, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if call.args.len() != 1 {
        loop argument_index in 0..<call.args.len() {
            ^_: sema_check_expression(call.args[argument_index].expr, None, check)
        }
        check.diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    argument: call.args[0]
    ^operation: BinOp?{None}
    if argument.expr == .Binary(op, _, _, _, _) {
        if sema_call_is_overflow_operation(op) -> operation = Val(op)
    }
    // `wrapping(U8{x})`: the word chooses what one narrowing typed-literal
    // conversion gives a value that doesn't fit.
    if operation == None && argument.expr == .TypedLit(_, _, _, _) {
        return sema_call_check_special_overflow_conversion(call, argument.expr, expected, check)
    }
    operation_value: operation ?? {
        ^_: sema_check_expression(argument.expr, None, check)
        check.diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    gate: sema_call_direct_gate(call.name, check.scopes) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    gate_scope: sema_call_enter_gate(check.scopes, gate)
    checked_argument: sema_check_expression(argument.expr, None, check)
    sema_call_leave_gate(check.scopes, gate_scope)
    argument_value: checked_argument ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_expr_is_integer(argument_value.ty) {
        check.diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^lhs: TExpr?{None}
    ^rhs: TExpr?{None}
    if argument_value.kind == .Binary(_, _, _, left, right) {
        lhs = Val(left)
        rhs = Val(right)
    }
    lhs_value: lhs ?? {
        check.diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    rhs_value: rhs ?? {
        check.diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    line: sema_source_line_at(check.environment.source_segments, call.name_span) ?? 0
    result_ty: if call.name == "checked" -> Type.Option{inner: lhs_value.ty} else -> lhs_value.ty
    value: sema_tree_node(result_ty, TExprKind.OverflowOpt{prefix: call.name, operation: sema_call_overflow_operation_name(operation_value), line: line, lhs: lhs_value, rhs: rhs_value}, call.name_span)
    checked: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
    SemaDirectSpecialCheck{handled: true, value: checked}
}

sema_call_check_special_overflow_conversion: fn(call: Call, argument: Expr, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    gate: sema_call_direct_gate(call.name, check.scopes) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    gate_scope: sema_call_enter_gate(check.scopes, gate)
    // The typed literal takes the word on entry (sema_expression_typed_literal).
    check.context.overflow_word = Val(call.name)
    checked_argument: sema_check_expression(argument, None, check)
    check.context.overflow_word = None
    sema_call_leave_gate(check.scopes, gate_scope)
    value: checked_argument ?? return SemaDirectSpecialCheck{handled: true, value: None}
    // Only a narrowing conversion took the word; around any other the word
    // changes nothing, so it is refused.
    if !sema_expr_is_narrowing(value) {
        check.diagnostics.push(sema_call_special_diagnostic(call.name, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    checked: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
    SemaDirectSpecialCheck{handled: true, value: checked}
}

sema_call_check_special_approx: fn(call: Call, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if call.args.len() != 1 {
        loop argument_index in 0..<call.args.len() {
            ^_: sema_check_expression(call.args[argument_index].expr, None, check)
        }
        check.diagnostics.push(sema_error("E0104", call.name_span, "`approx` takes one whole number", "`approx(value)` accepts possible precision loss at one integer-to-float crossing", "write `approx(value)`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    gate: sema_call_direct_gate(call.name, check.scopes) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    scope: sema_call_enter_gate(check.scopes, gate)
    checked_argument: sema_check_expression(call.args[0].expr, None, check)
    sema_call_leave_gate(check.scopes, scope)
    argument: checked_argument ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_expr_is_integer(argument.ty) {
        check.diagnostics.push(sema_error("E0109", call.args[0].span, "`approx` needs a whole number, but this is {sema_type_show(argument.ty)}", "`approx(value)` only opts one integer-to-float crossing out of its exactness check", "remove `approx`, or pass a whole number that is crossing into a decimal"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    target: if expected == {
        .Val(expected_type) -> if expected_type == {
            .Float32 -> Type.Float32
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> Type.Float
        }
        .None -> Type.Float
    }
    // `approx` is the one explicit lossy crossing (core-library "approx(value)
    // explicitly accepts possible precision loss"): the whole number rounds to
    // the nearest float through a plain cast, never the exactness-checked
    // crossing that stops on a value it cannot hold exactly.
    rust_type: sema_expr_numeric_rust_type(target) ?? "f64"
    converted: TExpr{ty: target, kind: TExprKind.NumericMethod{receiver: argument, operation: TNumericOp.CastAs{dst_rust: rust_type}}, span: call.name_span}
    checked: sema_expr_expected(converted, expected, check.environment.*, check.program.*, check.diagnostics)
    SemaDirectSpecialCheck{handled: true, value: checked}
}

// The values `debug(value)` can show in their Debug form. A nominal needs a
// registered or auto-derived `Debug`.
sema_call_debug_traceable: fn(ty: Type, check: SemaBodyCheck) -> Bool Never! {
    if sema_call_reflection_secret_bearing(ty) -> return false
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 | .Quantity(_, _) -> true
        .Option(inner) | .List(inner) | .FixedList(inner, _) | .Tagged(_, inner) | .Case(_, inner) | .InlineRange(inner, _, _) -> sema_call_debug_traceable(inner, check)
        .Result(ok, err) | .Map(ok, _, err) -> sema_call_debug_traceable(ok, check) && sema_call_debug_traceable(err, check)
        .Named(name) -> {
            if sema_call_reflection_leaf_name(name) == "Unit" || sema_call_reflection_core_shown(name) || sema_call_reflection_leaf_name(name) == "Err" {
                return true
            }
            // The game asset handles carry a Debug form (`JetDebug for
            // GameImage`/`GameSound`: `GameImage(<path>)`).
            if name == "GameImage" || name == "GameSound" -> return true
            // A Clock's Debug form is its Show form, `Clock { now: N }`.
            if sema_call_is_clock_type(ty) -> return true
            graph: check.program.registration_graph
            if sema_registration_unit_fact_for_type(graph, ty) != None -> return true
            sema_comparability_implements(check.environment.*, check.program.*, ty, "Debug")
        }
        .Apply(name, args) -> {
            if sema_call_reflection_leaf_name(name) == "KeyRef" || sema_call_reflection_pool_id(ty) {
                return true
            }
            if !sema_call_reflection_cache(ty) && !sema_comparability_implements(check.environment.*, check.program.*, ty, "Debug") {
                return false
            }
            loop argument in args {
                if !sema_call_debug_traceable(argument, check) -> return false
            }
            true
        }
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_call_debug_traceable(field.ty, check) -> return false
            }
            true
        }
        .Union(members) -> {
            loop member in members {
                if !sema_call_debug_traceable(member, check) -> return false
            }
            true
        }
        .TraitObject(bounds) -> {
            graph: check.program.registration_graph
            holders: sema_call_reflection_trait_holders(graph, bounds) ?? return false
            loop reference in holders.impls {
                if !sema_call_debug_traceable(graph.modules[reference.module_index].impls[reference.row].target_type, check) {
                    return false
                }
            }
            loop reference in holders.nominals {
                if !sema_call_debug_traceable(graph.modules[reference.module_index].nominals[reference.row].ty, check) {
                    return false
                }
            }
            true
        }
        .Shared(_) | .Fn(_, _, _, _, _, _) | .Measure(_) -> false
    }
}

// `.debug()` with no arguments is the Debug protocol method on every
// debuggable receiver, auto-derived or handwritten alike; it is the same Debug
// text `{value:Debug}` renders.
sema_call_try_debug_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if method != "debug" || args.len() != 0 || type_args.len() != 0 || !sema_call_debug_traceable(receiver_value.ty, check) {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if !sema_ownership_check_call_receiver(check, receiver, AccessConvention.Read, span) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    text: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Interpolation{value: receiver_value, debug: true}}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(text, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// The `file.jet:LINE` site of a trace.
sema_call_debug_site: fn(call: Call, check: SemaBodyCheck) -> String Never! {
    path: sema_source_file_at(check.environment.source_segments, check.environment.source_file, check.environment.source_origin, call.name_span)
    parts: path.split("/").to_list()
    file: if parts.len() > 0 && parts[parts.len() - 1] != "" -> parts[parts.len() - 1] else -> path
    line: sema_source_line_at(check.environment.source_segments, call.name_span) ?? 0
    "{file}:{line}"
}

// The traced expression on one line: each authored line trimmed, blank
// lines dropped, joined by one space.
sema_call_debug_expression_text: fn(text: String) -> String Never! {
    lines: loop line in text.split("\n").to_list() -> {
        trimmed: line.trim()
        if trimmed == "" -> next
        trimmed
    }
    lines.join(" ")
}

// `debug(value)` evaluates the value once, writes
// `[debug] file.jet:LINE expr = <Debug form>` to stderr through the shared
// `core.term.eprint` row, and yields the value unchanged; compile-time code
// prints the line while compiling (THostCall.DebugTrace). The trace adds no
// effect. A shipped artifact or a release-profile build rejects it (E3405)
// with an edit that keeps the traced expression exactly as written, in
// parentheses where the call's place needs them (DebugTraceSite.grouped).
sema_call_check_special_debug: fn(call: Call, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if sema_module_no_prelude(check.environment.*, check.program.*) {
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    if call.args.len() != 1 || call.args[0].label != None || call.args[0].spread {
        loop argument_index in 0..<call.args.len() {
            ^_: sema_check_expression(call.args[argument_index].expr, None, check)
        }
        check.diagnostics.push(sema_error("E0104", call.name_span, "`debug` takes exactly one value", "`debug(value)` shows one value and returns it unchanged", "write `debug(value)`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    checked: sema_check_expression(call.args[0].expr, expected, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    value_span: expr_span(call.args[0].expr)
    if !sema_call_debug_traceable(checked.ty, check) {
        check.diagnostics.push(sema_error("E0112", value_span, "`debug` can't show {sema_type_show(checked.ty)}", "`debug` writes the value's Debug form", "implement `Debug`, or trace a debuggable part of the value"))
    }
    ^authored: String?{None}
    ^unwrap: TextEdit?{None}
    loop recorded in check.environment.debug_sites {
        if recorded.name_start == call.name_span.start {
            authored = Val(recorded.text)
            kept: if recorded.grouped -> "({recorded.text})" else -> recorded.text
            unwrap = Val(TextEdit{span: Span{start: call.name_span.start, end: recorded.close_end}, new_text: kept})
            break
        }
    }
    site: sema_call_debug_site(call, check)
    // The Core library's check (core_seal) refuses one too: the function
    // checks it captures (CoreBodies.jet) load in a `jet build` as well as in
    // a run, so no Core body may hold a trace either would refuse.
    graph: check.program.registration_graph
    // Snapshot: a lone program's check has no build to refuse a trace.
    if graph.mode == .Program && (graph.core_seal || sema_build_facts_reject_debug_traces(graph.build_facts)) {
        diagnostic: sema_error("E3405", call.name_span, "A `debug` trace is left at `{site}`.", "`debug(value)` is a development trace: it prints while you run, test, or evaluate a program and adds no effect, so a shipped artifact (`jet build`) or a release-profile build must not contain it.", "Remove the `debug(…)` wrapper and keep the expression; `jet fix` applies this edit.")
        if unwrap == .Val(edit) -> check.diagnostics.push(diagnostic_with_edit(diagnostic, edit)) else {
            check.diagnostics.push(diagnostic)
        }
    }
    expression_text: sema_call_debug_expression_text(authored ?? "")
    ^traced: checked
    if !sema_call_is_scalar(checked.ty) {
        if checked.kind == {
            .Local(_) | .Field(_, _) | .Index(_, _, _, _, _, _) -> {
                fact: sema_copy_hidden_fact_of(checked.ty, CopyFact.Materialize, check, check.context.generic_params)
                traced = sema_tree_node(checked.ty, TExprKind.Clone{value: checked, fact: fact}, checked.span)
            }
            .IntLit(_, _) | .StrLit(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {}
        }
    }
    local: checked_generated_local("__jet_debug_trace_{call.name_span.start}", call.name_span, checked.ty)
    read: sema_tree_node(checked.ty, TExprKind.Local{local: local}, call.name_span)
    line: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "[debug] {site} {expression_text} = "}, TStrPart.Interpolation{value: read, debug: true}}}, call.name_span)
    unavailable: sema_error("E0906", call.name_span, "the canonical `core.term.eprint` route for `debug` is unavailable", "the development trace writes through the registered Core stderr row", "restore the registered `core.term.eprint` route")
    unit: Type.Named{name: "Unit"}
    // The trace adds no effect: its stderr write is a known-pure call site, so
    // pure (`-[]>`) and memoized functions keep their rows.
    if !sema_effect_record_intrinsic_effects(check, "debug", call.name_span, [EffectRowEntry]{}) {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    // The stderr write is the source-owned `core.term.eprint` declaration.
    ^write_kind: TExprKind?{None}
    if sema_call_core_module_identity(check.environment.*, check.program.*, "core.term") == .Val(identity) {
        if sema_call_core_source_target(check.environment.*, check.program.*, identity, "eprint", [Type]{}, call.name_span, false, check.diagnostics) == .Val(target) {
            callee: sema_call_callee_decl(check.program.*, target.symbol.id, call.name_span, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
            argument: TCallArg{value: line, template_items: [SymbolID]{}, borrow: false, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
            write_kind = Val(TExprKind.Call{callee: callee, type_args: [Type]{}, args: [TCallArg]{argument}})
        }
    }
    kind: write_kind ?? {
        check.diagnostics.push(unavailable)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    write: sema_tree_node(unit, kind, call.name_span)
    trace: sema_tree_node(unit, TExprKind.HostCall{call: THostCall.DebugTrace{write: write}}, call.name_span)
    body: [TStmt]{
        TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: traced, gc_promotion: None, gc_transferred: false, span: call.name_span},
        TStmt.ExprStmt{value: trace, span: call.name_span},
        TStmt.ExprStmt{value: read, span: call.name_span},
    }
    SemaDirectSpecialCheck{handled: true, value: Val(sema_tree_node(checked.ty, TExprKind.InlineBlock{body: body}, call.name_span))}
}

sema_call_try_knowledge_builtin: fn(call: Call, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if !sema_call_gate_is_unshadowed(call.name, check.scopes) {
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    if call.name == {
        "wrapping" | "saturating" | "checked" -> sema_call_check_special_overflow(call, expected, check)
        "approx" -> sema_call_check_special_approx(call, expected, check)
        "debug" -> sema_call_check_special_debug(call, expected, check)
        "embed_file" | "embed_bytes" | "find" -> sema_call_check_comptime_input(call, expected, check)
        else -> SemaDirectSpecialCheck{handled: false, value: None}
    }
}

// The readable prelude's builtin rows (`print`, `panic`, `assert`,
// `assert_eq`), checked by one dispatcher with per-builtin arity and
// argument rules. A user function or local of the same name shadows every
// row. `#NoPrelude` print/input refusal (E0429) runs before this
// dispatcher. The ambient `input` is a value (sema_call_check_ambient_input),
// not a function.
sema_call_try_ambient_prelude: fn(call: Call, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if !sema_call_gate_is_unshadowed(call.name, check.scopes) {
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    if call.name == {
        "channel" -> sema_call_check_channel(call, expected, check)
        "freeze" -> sema_call_check_freeze(call, expected, check)
        "print" -> sema_call_check_ambient_print(call, check)
        "__jet_eval_show" -> sema_call_check_eval_show(call, check)
        "input" -> sema_call_check_ambient_input_call(call, check)
        "panic" -> sema_call_check_ambient_panic(call, check)
        "assert" -> sema_call_check_ambient_assert(call, check)
        "assert_eq" -> sema_call_check_ambient_assert_eq(call, check)
        // The readable prelude's `eprint: core.term.eprint`.
        "eprint" -> {
            if sema_module_no_prelude(check.environment.*, check.program.*) {
                return SemaDirectSpecialCheck{handled: false, value: None}
            }
            sema_call_ambient_source_alias(call, "core.term", "eprint", expected, check)
        }
        // The readable prelude's file aliases (`read_file`, `write_file`,
        // `file_exists`) call their `core.files` declarations.
        "read_file" | "write_file" | "file_exists" -> {
            if sema_module_no_prelude(check.environment.*, check.program.*) {
                return SemaDirectSpecialCheck{handled: false, value: None}
            }
            member: if call.name == {
                "read_file" -> "read"
                "write_file" -> "write"
                else -> "exists"
            }
            sema_call_ambient_source_alias(call, "core.files", member, expected, check)
        }
        // The benchmark identity sink `keep(value)` calls `core.prelude.keep`.
        "keep" -> sema_call_ambient_source_alias(call, "core.prelude", "keep", expected, check)
        // `type_of(p)`: the static type of a name or field path, as a `Type`.
        "type_of" -> sema_call_check_type_of(call, expected, check)
        // The readable prelude's ordered extrema call their `core.prelude`
        // generics (`min(a, b, ...rest)`, `max(...)`, `clamp(x, lo, hi)`).
        "min" | "max" | "clamp" -> {
            if sema_module_no_prelude(check.environment.*, check.program.*) {
                return SemaDirectSpecialCheck{handled: false, value: None}
            }
            sema_call_ambient_source_alias(call, "core.prelude", call.name, expected, check)
        }
        "Decimal" | "Complex" -> {
            if sema_call_value_type_args_refused(call, check.diagnostics) {
                return SemaDirectSpecialCheck{handled: true, value: None}
            }
            if call.name == "Decimal" {
                return sema_call_check_value_constructor(call, "Decimal", [Type]{Type.String}, false, expected, check)
            }
            sema_call_check_value_constructor(call, "Complex", [Type]{Type.Float, Type.Float}, false, expected, check)
        }
        else -> {
            if !sema_expr_is_math_type_name(call.name) {
                return SemaDirectSpecialCheck{handled: false, value: None}
            }
            if sema_call_value_type_args_refused(call, check.diagnostics) {
                return SemaDirectSpecialCheck{handled: true, value: None}
            }
            // A math type Core's source declares builds through its own `new`.
            graph: check.program.registration_graph
            if sema_type_source_owns_nominal(graph, call.name, sema_scope_caller_row(check.environment.*, graph)) {
                invocation: Expr.MethodCall{receiver: Expr.Ident{name: call.name, span: call.name_span, id: AST_NODE_GENERATED}, method: "new", method_span: call.name_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: call.args, id: AST_NODE_GENERATED}
                return SemaDirectSpecialCheck{handled: true, value: sema_check_expression(invocation, expected, check)}
            }
            components: loop _ in 0..<sema_call_math_arity(call.name) -> sema_call_math_scalar_type(call.name)
            sema_call_check_value_constructor(call, call.name, components, true, expected, check)
        }
    }
}

// `Mat3<Int>(…)`: a built-in value type built by a call has fixed component
// types and no type parameters, so written type arguments are refused, never
// ignored.
sema_call_value_type_args_refused: fn(call: Call, diagnostics: ^[Diagnostic]) -> Bool {
    if call.type_args.len() == 0 -> return false
    diagnostics.push(sema_error("E0119", call.name_span, "`{call.name}` is not generic", "`{call.name}` is a built-in value type with fixed component types, so it takes no type arguments", "remove the type arguments: write `{call.name}(…)`"))
    true
}

// A readable prelude alias whose Core declaration is source-owned is called as
// the item import the prelude opens: its checked source declaration is the
// target.
sema_call_ambient_source_alias: fn(call: Call, module_name: String, member: String, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    module_identity: sema_call_core_module_identity(check.environment.*, check.program.*, module_name) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    target: sema_call_core_source_target(check.environment.*, check.program.*, module_identity, member, call.type_args, call.name_span, false, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    check.scopes.ownership_call_depth += 1
    ^value: sema_call_core_check_source_owned(target, call.name, call.type_args, call.args, call.name_span, expected, check)
    check.scopes.ownership_call_depth -= 1
    SemaDirectSpecialCheck{handled: true, value: value}
}

// `close(value)` is ambient sugar for the sole nominal `Close.close(^^self)`
// protocol, ahead of every declared function. It takes exactly one resource,
// whose type must implement `Close`, and produces nothing.
sema_call_check_ambient_close: fn(call: Call, check: ^SemaBodyCheck) -> TExpr? {
    if call.args.len() != 1 {
        check.diagnostics.push(sema_error("E0104", call.name_span, "`close` takes exactly one resource, got {call.args.len()}", "`close` takes one value through its nominal `Close` implementation", "write `close(resource)`"))
        loop argument_index in 0..<call.args.len() {
            ^_: sema_check_expression(call.args[argument_index].expr, None, check)
        }
        return None
    }
    argument: call.args[0]
    value: sema_check_expression(argument.expr, None, check) ?? return None
    if argument.convention == AccessConvention.Write {
        check.diagnostics.push(sema_error("E0201", argument.span, "`close` takes ownership of its resource", "`Close.close(^^self)` takes its receiver, so cleanup runs on exactly one owner; `^` would only lend it", "write `close(resource)`"))
        return None
    }
    graph: check.program.registration_graph
    // An undecided bound (a Core native carrier has no nominal row to
    // carry a `Close` impl) is no `Close` implementation, and the user
    // can't add one (#6120); nor can they for a type Core declares, whose
    // impls of Core's `Close` live in Core.
    // Snapshot: a lone program registers no `Close` impl, so its check takes the bound as met.
    decided: if graph.mode == .Snapshot -> Val(true) else -> sema_type_bound_satisfied_at(graph, value.ty, "Close", sema_scope_caller_row(check.environment.*, graph), check.context.generic_params)
    if decided != .Val(true) {
        shown: type_name(value.ty)
        addable: decided != None && !sema_call_close_declared_in_core(graph, check.environment.*, value.ty)
        fix: if addable -> "write `impl {shown}.Close {{ … }}` with every required method" else -> "remove the `close` call; `{shown}` has no `Close` implementation to run"
        check.diagnostics.push(sema_error("E0905", expr_span(argument.expr), "`{shown}` isn't `Close`", "`{shown}` would need to implement `Close` before it can be used here", fix))
        return None
    }
    // `close(name)` consumes the owner exactly, like a `^^` argument: a later
    // use of `name` is E0121 and never turns the move into a hidden copy.
    exact: sema_ownership_unmarked_moves_name(argument.expr)
    moved: if exact -> sema_ownership_mark_move(check.state, argument.expr, check.scopes, "`close`", check.diagnostics) else -> sema_stmt_move_direct(argument.expr, check, "`close`")
    if !moved -> return None
    Val(sema_tree_node(Type.Named{name: "Unit"}, TExprKind.Close{value: value}, call.name_span))
}

// Whether `ty` is a type Core declares, seen from a module outside Core: only
// Core may implement Core's traits for it.
sema_call_close_declared_in_core: fn(graph: SemaRegistrationGraph, environment: SemaScopeEnvironment, ty: Type) -> Bool Never! {
    if module_is_core(environment.module_identity) -> return false
    row: sema_type_resolve_nominal_row(graph, ty, environment.module_identity) ?? return false
    module_is_core(graph.modules[row.module_index].module_identity)
}

// The scalar slots of a built-in math value type's positional constructor: a
// lane type's lane count, a vector's dimension, a square matrix's N*N
// column-major components.
sema_call_math_arity: fn(name: String) -> Int Never! {
    if name == {
        "Vec2" -> return 2
        "Vec3" -> return 3
        "Vec4" -> return 4
        "Mat3" -> return 9
        "Mat4" -> return 16
        else -> {}
    }
    lanes: name.split("x").to_list()
    if lanes.len() != 2 -> return 0
    Int.parse(lanes[1]) ?? 0
}

// A lane type's component width; linear-algebra types are Float.
sema_call_math_scalar_type: fn(name: String) -> Type Never! {
    if name.starts_with("F32x") -> return Type.Float32
    if name.starts_with("I8x") -> return Type.IntN{signed: true, bits: 8}
    if name.starts_with("I16x") -> return Type.IntN{signed: true, bits: 16}
    if name.starts_with("I32x") -> return Type.IntN{signed: true, bits: 32}
    if name.starts_with("I64x") -> return Type.IntN{signed: true, bits: 64}
    if name.starts_with("U8x") -> return Type.IntN{signed: false, bits: 8}
    if name.starts_with("U16x") -> return Type.IntN{signed: false, bits: 16}
    if name.starts_with("U32x") -> return Type.IntN{signed: false, bits: 32}
    if name.starts_with("U64x") -> return Type.IntN{signed: false, bits: 64}
    Type.Float
}

// `Decimal("12.34")`, `Complex(re, im)` and `Vec3(x, y, z)`-style math
// constructors: each argument is checked against its component type in order
// and the call becomes the type's precise or math builtin.
sema_call_check_value_constructor: fn(call: Call, type_name_value: String, components: [Type], math: Bool, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if call.args.len() != components.len() {
        ^what: if {
            type_name_value == "Decimal" -> "`Decimal` takes exactly one argument, got {call.args.len()}"
            type_name_value == "Complex" -> "`Complex` takes exactly two arguments, got {call.args.len()}"
            else -> "`{type_name_value}` takes exactly {components.len()} component{if components.len() == 1 -> "" else -> "s"}, got {call.args.len()}"
        }
        ^why: if {
            type_name_value == "Decimal" -> "`Decimal` parses an exact base-10 decimal from a `String`"
            type_name_value == "Complex" -> "`Complex` takes the real part first and the imaginary part second"
            else -> "`{type_name_value}` is a built-in {if type_name_value.starts_with("Vec") || type_name_value.starts_with("Mat") -> "linear-algebra" else -> "SIMD lane"} type — construct it from its {components.len()} components"
        }
        ^fix: if {
            type_name_value == "Decimal" -> "write `Decimal(\"12.34\")`"
            type_name_value == "Complex" -> "write `Complex(real, imaginary)`"
            else -> {
                slots: loop _ in components -> "…"
                "write `{type_name_value}({slots.join(", ")})`"
            }
        }
        check.diagnostics.push(sema_error("E0103", call.name_span, what, why, fix))
        loop argument_index in 0..<call.args.len() {
            ^_: sema_check_expression(call.args[argument_index].expr, None, check)
        }
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^values: [TExpr]{}
    ^complete: true
    loop index in 0..<components.len() {
        component: components[index]
        checked: sema_check_expression(call.args[index].expr, Val(component), check) ?? {
            complete = false
            next
        }
        coerced: sema_expr_expected(checked, Val(component), check.environment.*, check.program.*, check.diagnostics) ?? {
            complete = false
            next
        }
        values.push(coerced)
    }
    if !complete -> return SemaDirectSpecialCheck{handled: true, value: None}
    result_ty: Type.Named{name: type_name_value}
    kind: if {
        math -> TExprKind.MathBuiltin{type_name: type_name_value, function: "new", args: values}
        type_name_value == "Decimal" -> TExprKind.PreciseBuiltin{type_name: type_name_value, function: "from_str", args: values}
        else -> TExprKind.PreciseBuiltin{type_name: type_name_value, function: "from_parts", args: values}
    }
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected_owned(sema_tree_node(result_ty, kind.move(), call.name_span), expected, check.environment.*, check.program.*, check.diagnostics)}
}

// An ambient row's IO effect, recorded as its call-site fact so the effect
// solve sees a known call instead of an unresolved one.
sema_call_ambient_record_io: fn(api: String, result_type: Type, span: Span, check: ^SemaBodyCheck) -> Bool Never! {
    sema_effect_record_intrinsic_fact(
        check.environment.*,
        check.program.*,
        check.scopes,
        check.context,
        api,
        span,
        SemaCallFacts{
            return_type: result_type,
            failure_carrier: sema_call_failure_carrier(Val(result_type)),
            effect_bound: Val([EffectRowEntry]{EffectRowEntry{name: "IO", span: span}}),
            type_args: [Type]{},
            default_refs: [FunctionDefaultRef]{},
        },
        check.diagnostics,
    )
}

// Printable or displayable, plus `Never`. A unit type here is a
// measurement-unit family (sema_expression_displayable), so the `Unit` value
// of a function without `->` has no display.
sema_call_ambient_printable: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if ty == (Type.Named{name: "Never"}) -> return true
    sema_expression_typed_literal_printable(ty, environment, program) || sema_expression_displayable(ty, environment, program)
}

sema_call_ambient_print_refusal: fn(ty: Type, span: Span) -> Diagnostic Never! {
    if sema_call_reflection_secret_bearing(ty) {
        return sema_error("E0112", span, "secret-bearing `{type_name(ty)}` cannot be printed", "printing could copy cryptographic secret material into terminal output or logs", "print a public operation label or key identifier instead")
    }
    if sema_call_reflection_one_pass(ty) {
        ^fix: "consume it with a `loop` and print each item instead"
        if ty == {
            .Apply(name, _) -> {
                leaf: sema_call_reflection_leaf_name(name)
                if leaf == "Iter" || leaf == "ViewIter" {
                    fix = "materialize it first: add `.to_list()` before printing; `.lazy()` or another Iter source enters the one-pass plane"
                }
            }
            .Named(name) -> {
                if sema_call_reflection_leaf_name(name) == "Body" {
                    fix = "materialize it first: add `.text(limit)` before printing"
                }
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
        }
        return sema_error("E0112", span, "`print` cannot show the one-pass source {sema_type_show(ty)}", "reading this value consumes it, so showing it would spend the only pass", fix)
    }
    sema_error("E0112", span, "`print` doesn't know how to show {sema_type_show(ty)}", "print shows values that have a display", "print one of its parts instead")
}

// Variadic `print`: every argument is checked on its own and prints its own
// line, one `Print` per argument in order. It takes values only, so a label
// (`sep:`) names no parameter: E0764.
sema_call_check_ambient_print: fn(call: Call, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if call.args.len() == 0 {
        check.diagnostics.push(sema_error("E0103", call.name_span, "`print` needs at least one thing to print", "printing nothing isn't meaningful", "e.g. print(\"hello\")"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^values: [TExpr]{}
    ^complete: true
    loop argument in call.args {
        if argument.label == .Val(label) {
            check.diagnostics.push(sema_call_diag_unknown_label(call.name, label.name, [SemaCallParam]{}, label.span))
            complete = false
        }
    }
    loop argument_index in 0..<call.args.len() {
        checked: sema_check_expression(call.args[argument_index].expr, None, check) ?? {
            complete = false
            next
        }
        if !sema_call_ambient_printable(checked.ty, check.environment.*, check.program.*) {
            check.diagnostics.push(sema_call_ambient_print_refusal(checked.ty, expr_span(call.args[argument_index].expr)))
            complete = false
            next
        }
        formatted: if checked.ty == (Type.Apply{name: "Measurement", args: [Type]{Type.Float}}) -> {
            checked_span: checked.span
            sema_expression_measurement_source_call("MeasurementShow", [TExpr]{checked}, Type.String, checked_span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        } else -> checked
        values.push(formatted)
    }
    if !complete -> return SemaDirectSpecialCheck{handled: true, value: None}
    unit: Type.Named{name: "Unit"}
    if !sema_call_ambient_record_io("print", unit, call.name_span, check) {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if values.len() == 1 {
        return SemaDirectSpecialCheck{handled: true, value: Val(sema_tree_node(unit, TExprKind.Print{value: values[0]}, call.name_span))}
    }
    ^body: [TStmt]{}
    prints: loop index in 0..<values.len() -> {
        local: checked_generated_local("__jet_print_arg_{call.name_span.start}_{index}", call.name_span, values[index].ty)
        body.push(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: values[index], gc_promotion: None, gc_transferred: false, span: call.name_span})
        read: sema_tree_node(values[index].ty, TExprKind.Local{local: local}, call.name_span)
        TStmt.ExprStmt{value: sema_tree_node(unit, TExprKind.Print{value: read}, call.name_span), span: call.name_span}
    }
    loop statement in prints -> body.push(statement)
    SemaDirectSpecialCheck{handled: true, value: Val(sema_tree_node(unit, TExprKind.InlineBlock{body: body}, call.name_span))}
}

// `jet -e CODE` runs CODE as the body of `run: fn` (JetCLI ScriptCache.jet
// jet_cli_eval_file), and its compile request's `eval_entry` asks for the
// value its last statement leaves: when that statement is an expression with
// a value (any expression but an `if` without `else`), the parsed entry's
// `run` ends in it wrapped in `__jet_eval_show` (Loader.jet). The call exists
// only in the tree, so the code itself keeps every source rule, E0067's
// reserved `__` names included.
sema_eval_entry_show: fn(program: ^Program) {
    loop index in 0..<program.items.len() {
        if program.items[index] == .Func(function) {
            if function.name != "run" -> next
            ^changed: function.copy()
            count: changed.body.len()
            if count == 0 {
                return
            }
            value: if changed.body[count - 1] == {
                .Expr(expr) -> expr.copy()
                .Val(_) | .Assign(_, _, _, _) | .Return(_, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Defer(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> {
                    return
                }
            }
            if sema_eval_entry_valueless(value) {
                return
            }
            span: expr_span(value)
            argument: CallArg{convention: AccessConvention.Read, expr: value, span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
            changed.body[count - 1] = Stmt.Expr{expr: Expr.Call{call: Call{name: "__jet_eval_show", name_span: span, type_args: [Type]{}, args: [CallArg]{argument}}, id: AST_NODE_GENERATED}}
            program.items[index] = Item.Func{value: changed}
            return
        }
    }
}

// An `if` without `else`: a statement, which leaves no value to show.
sema_eval_entry_valueless: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .If(_, _, _, _, else_value, _, _) -> if else_value == {
            .NoElse(_, _) -> true
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// The value sema_eval_entry_show wraps: a unit value shows nothing, each
// item of a List or an Iter prints on a line
// of its own, as a `loop` over it pulls them, and any other value prints as
// `print` shows it, under `print`'s display rule (E0112).
sema_call_check_eval_show: fn(call: Call, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if call.args.len() != 1 {
        check.diagnostics.push(sema_error("E0104", call.name_span, "`__jet_eval_show` expects 1 argument, got {call.args.len()}", "it shows the one value the code of `jet -e` ends in", "pass the one value to show"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    checked: sema_check_expression(call.args[0].expr, None, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    unit: Type.Named{name: "Unit"}
    if checked.ty == unit -> return SemaDirectSpecialCheck{handled: true, value: Val(checked)}
    span: expr_span(call.args[0].expr)
    item_type: sema_call_eval_show_item(checked.ty)
    shown_type: item_type ?? checked.ty
    if !sema_call_ambient_printable(shown_type, check.environment.*, check.program.*) {
        check.diagnostics.push(sema_call_ambient_print_refusal(shown_type, span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_call_ambient_record_io("print", unit, call.name_span, check) {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    item: item_type ?? {
        shown: sema_call_eval_show_text(checked, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        return SemaDirectSpecialCheck{handled: true, value: Val(sema_tree_node(unit, TExprKind.Print{value: shown}, span))}
    }
    local: checked_generated_local("__jet_eval_item_{call.name_span.start}", span, item)
    read: sema_tree_node(item, TExprKind.Local{local: local}, span)
    shown: sema_call_eval_show_text(read, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    line: TStmt.ExprStmt{value: sema_tree_node(unit, TExprKind.Print{value: shown}, span), span: span}
    by_value: sema_stmt_for_in_consumes_collection(checked.ty, item) && (sema_stmt_for_in_by_value(checked.ty, item) || sema_stmt_for_in_is_list(checked.ty))
    walk: TStmt.ForIn{label: None, variable: local, variable_two: None, source: checked.copy(), collection: checked, step: None, method_kind: None, columnar: false, by_value: by_value, source_stable: false, body: [TStmt]{line}, span: span}
    SemaDirectSpecialCheck{handled: true, value: Val(sema_tree_node(unit, TExprKind.InlineBlock{body: [TStmt]{walk}}, span))}
}

// The item type of a value `jet -e` shows one item per line: a List's element
// or an Iter's item; None for any other value.
sema_call_eval_show_item: fn(ty: Type) -> Type? Never! {
    if ty == {
        .List(element) -> Val(element)
        .Apply(name, args) -> if name == "Iter" && args.len() == 1 -> Val(args[0]) else -> None
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// A shown value as `print` passes it on: a Measurement through the text of
// its MeasurementShow helper, any other value as it is.
sema_call_eval_show_text: fn(value: TExpr, check: ^SemaBodyCheck) -> TExpr? Never! {
    if value.ty == (Type.Apply{name: "Measurement", args: [Type]{Type.Float}}) {
        return sema_expression_measurement_source_call("MeasurementShow", [TExpr]{value}, Type.String, value.span, check)
    }
    Val(value)
}

// The ambient `input`: every line of the program's input, a lazy
// `Iter<String>` over the files its arguments name, in order, else standard
// input. It checks as the line source (BodyHandleOp.LinesIter) of the
// core.term function filling InputLines, whose reader's `read_line` each
// pull calls: one meaning on every tier. The names are the arguments (Exec.Args).
// Reading the files they name needs no FS.Read grant: the person who ran the
// program designated them on its command line (typed paths are granted), as
// awk's and perl's `<>` operands are. A user
// binding named `input` shadows it; the bare name loads core.term
// (CORE_BARE_SOURCE_MODULES).
sema_call_check_ambient_input: fn(span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if sema_marker_rules_no_prelude_input(span, check) -> return None
    lines: Type.Apply{name: "Iter", args: [Type]{Type.String}}
    effects: [EffectRowEntry]{EffectRowEntry{name: "IO", span: span}, EffectRowEntry{name: "Exec.Args", span: span}, EffectRowEntry{name: "Time.Wait", span: span}}
    facts: SemaCallFacts{return_type: lines, failure_carrier: TFailureCarrier.Infallible, effect_bound: Val(effects), type_args: [Type]{}, default_refs: [FunctionDefaultRef]{}}
    if !sema_effect_record_intrinsic_fact(check.environment.*, check.program.*, check.scopes, check.context, "input", span, facts, check.diagnostics) {
        return None
    }
    if sema_call_core_module_identity(check.environment.*, check.program.*, "core.term") == None {
        check.diagnostics.push(sema_error("E0906", span, "the Core terminal source for `input` is unavailable", "the ambient `input` reads through the Core terminal source", "restore the `core.term` source module"))
        return None
    }
    target: sema_call_core_role_target("InputLines", [Type]{}, span, check.environment.*, check.program.*, check.diagnostics) ?? return None
    callee: sema_call_callee_decl(check.program.*, target.symbol.id, span, check.diagnostics) ?? return None
    // The InputLines function cannot fail (`Never!`): the call is the reader.
    returned: sema_call_signature_return(target.signature) ?? return None
    receiver: if returned == .Result(ok, _) -> sema_tree_node(ok, TExprKind.Call{callee: callee, type_args: [Type]{}, args: [TCallArg]{}}, span) else -> sema_tree_node(returned, TExprKind.Call{callee: callee, type_args: [Type]{}, args: [TCallArg]{}}, span)
    value: sema_tree_node(facts.return_type, TExprKind.HandleMethod{receiver: receiver, operation: BodyHandleOp.LinesIter, args: [TExpr]{}}, span)
    sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// `input(…)`: the ambient `input` is the program's lines, not a function
// (E0803); one line with a prompt is core.term `readline`. The arguments are
// still checked.
sema_call_check_ambient_input_call: fn(call: Call, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    check.diagnostics.push(sema_error("E0803", call.name_span, "`input` is Iter<String>, not a function", "`input` is every line of the program's input (the files its arguments name, else standard input), read lazily by a `loop` or an Iter method", "read one line with a prompt through `readline(prompt)` from core.term (`use core.term.[readline]`), or loop over `input`"))
    loop argument in call.args -> ^_: sema_check_expression(argument.expr, None, check)
    SemaDirectSpecialCheck{handled: true, value: None}
}

// `input.csv<Row>()`, `input.json<Row>()`, `input.edit(change)`: a method of
// the ambient `input` that is not an Iter<String> method is the Core function
// filling the method's role in the module that declares it
// (core_input_method_role, core_input_method_module), and is checked as a
// call of it whose first argument is the ambient `input` itself. The call so
// charges what `input` charges and what the function declares. Unhandled
// when a binding shadows `input` or the module is not loaded: `input` is
// then the Iter<String> receiver as usual.
sema_call_try_ambient_input_method: fn(receiver: Expr, method: String, method_span: Span, type_args: [Type], args: [CallArg], expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    unhandled: SemaDirectSpecialCheck{handled: false, value: None}
    ^receiver_span: Span{start: 0, end: 0}
    if receiver == {
        .Ident(name, span, _) -> {
            if name != "input" -> return unhandled
            receiver_span = span
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return unhandled
    }
    if sema_scope_resolve_index(check.scopes, "input") != None || sema_module_no_prelude(check.environment.*, check.program.*) {
        return unhandled
    }
    module_name: core_input_method_module(method) ?? return unhandled
    role: core_input_method_role(method) ?? return unhandled
    if sema_call_core_module_identity(check.environment.*, check.program.*, module_name) == None {
        return unhandled
    }
    target: sema_call_core_role_target(role, type_args, method_span, check.environment.*, check.program.*, check.diagnostics) ?? return unhandled
    ^call_args: [CallArg]{CallArg{convention: AccessConvention.Read, expr: receiver.copy(), span: receiver_span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}}  // copy: the method call keeps its receiver.
    loop argument in args -> call_args.push(argument.copy())  // copy: the method call keeps its arguments.
    check.scopes.ownership_call_depth += 1
    ^value: sema_call_core_check_source_owned(target, "input.{method}", type_args, call_args, method_span, expected, check)
    check.scopes.ownership_call_depth -= 1
    SemaDirectSpecialCheck{handled: true, value: value}
}

// `("core.term", "progress")` over a sequence: an imported `core.term`
// progress with a description (sema_call_core_variadic_term) is a call of
// the core.term function filling InlineIterProgress, which hands the items on
// as the loop pulls them. A List is read through its `lazy()` iterator; a
// missing template is empty. The function's declaration types the arguments
// (the items move in) and its effect row is the call's.
sema_call_check_term_progress_iter: fn(args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    rejected: SemaDirectSpecialCheck{handled: true, value: None}
    if args.len() > 3 {
        check.diagnostics.push(sema_error("E0104", span, "`progress` expects at most 3 arguments, got {args.len()}", "a progress source takes its items, a description and a template", "check the call to `progress`"))
        return rejected
    }
    filler: sema_core_role_function(check.program.registration_graph, "InlineIterProgress") ?? {
        check.diagnostics.push(sema_missing_core_role("InlineIterProgress", span))
        return rejected
    }
    source: sema_check_expression(args[0].expr, None, check) ?? return rejected
    items: sema_call_collections_list_as_iter(source, span)
    is_iter: if items.ty == .Apply(name, _) -> name == "Iter" else -> false
    if !is_iter {
        check.diagnostics.push(sema_error("E0108", expr_span(args[0].expr), "`progress` with a description reads a List or an Iter, not `{type_name(items.ty)}`", "the described progress form reports each item the loop pulls", "pass the items to report, or call `progress(label)` alone"))
        return rejected
    }
    element: sema_call_eval_show_item(items.ty) ?? return rejected
    if !sema_stmt_move_direct(args[0].expr, check, "`progress`") -> return rejected
    result: items.ty
    ^values: [TExpr]{items}
    loop index in 1..<args.len() {
        text: sema_check_expression(args[index].expr, Val(Type.String), check) ?? return rejected
        values.push(text)
    }
    loop values.len() < 3 {
        values.push(sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{}}, span))
    }
    ^declared_effects: [String]{}
    if !sema_call_core_function_effects(filler, check, declared_effects) -> return rejected
    effects: loop name in declared_effects -> EffectRowEntry{name: name, span: span}
    target: sema_call_core_source_target(check.environment.*, check.program.*, filler.module_identity, filler.name, [Type]{element}, span, true, check.diagnostics) ?? return rejected
    returned: sema_call_signature_return(target.signature) ?? return rejected
    facts: SemaCallFacts{return_type: returned, failure_carrier: TFailureCarrier.Infallible, effect_bound: Val(effects), type_args: [Type]{}, default_refs: [FunctionDefaultRef]{}}
    if !sema_effect_record_intrinsic_fact(check.environment.*, check.program.*, check.scopes, check.context, "core.term.progress", span, facts, check.diagnostics) {
        return rejected
    }
    declared: sema_call_params_from_type(target.signature) ?? return rejected
    callee: sema_call_callee_decl(check.program.*, target.symbol.id, span, check.diagnostics) ?? return rejected
    made: sema_tree_node(result, TExprKind.Call{callee: callee, type_args: target.type_args, args: sema_call_core_source_arguments(values, declared, check)}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_expression_call_expected(made, expected, check)}
}

// The role of the Core function that reflects a value (`reflect.of`).
SEMA_CORE_ROLE_REFLECT_OF: "InlineReflectOf"

// The API a checked reflection's call site fact names, by which `jet inspect
// expand reflect` finds the call.
SEMA_CALL_REFLECT_OF_API: "core.reflect.of"

// A call of `target`, the Core function that fills SEMA_CORE_ROLE_REFLECT_OF.
// Its one argument is legal wherever `"{x}"` interpolation is
// (sema_call_reflection_validate_value).
// The call carries the value's checked names and field tree after the value
// (sema_call_reflection_name_args), which the builder reads, and yields the
// declaration's `Value`. Its effects are the declaration's.
sema_call_check_reflect_of: fn(target: SemaCallDirectTarget, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if args.len() != 1 {
        check.diagnostics.push(sema_error("E0104", span, "`{target.symbol.name}` expects 1 argument, got {args.len()}", "every argument must match a standard library function parameter", "check the call to `{target.symbol.name}`"))
        return None
    }
    checked: sema_check_expression(args[0].expr, None, check) ?? return None
    if !sema_call_reflection_validate_value(checked, expr_span(args[0].expr), check) -> return None
    ^declared_effects: [String]{}
    function: SemaCoreRoleFunction{module_identity: target.symbol.module_identity, name: target.symbol.name}
    if !sema_call_core_function_effects(function, check, declared_effects) -> return None
    instance: sema_call_core_source_target(check.environment.*, check.program.*, target.symbol.module_identity, target.symbol.name, [Type]{checked.ty}, span, true, check.diagnostics) ?? return None
    result: sema_call_signature_return(instance.signature) ?? return None
    effects: loop name in declared_effects -> EffectRowEntry{name: name, span: span}
    facts: SemaCallFacts{return_type: result, failure_carrier: TFailureCarrier.Infallible, effect_bound: Val(effects), type_args: instance.type_args, default_refs: [FunctionDefaultRef]{}}
    if !sema_effect_record_intrinsic_fact(check.environment.*, check.program.*, check.scopes, check.context, SEMA_CALL_REFLECT_OF_API, span, facts, check.diagnostics) {
        return None
    }
    names: sema_call_reflection_name_args(checked.ty, span, expr_span(args[0].expr), check) ?? return None
    declared: sema_call_params_from_type(instance.signature) ?? return None
    callee: sema_call_callee_decl(check.program.*, instance.symbol.id, span, check.diagnostics) ?? return None
    ^call_args: sema_call_core_source_arguments([TExpr]{checked}, declared, check)
    // The names are literals the builder reads in place, never a parameter's
    // argument.
    loop name in names {
        call_args.push(TCallArg{value: name, template_items: [SymbolID]{}, borrow: false, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false})
    }
    made: sema_tree_node(result, TExprKind.Call{callee: callee, type_args: instance.type_args, args: call_args}, span)
    sema_expression_call_expected(made, expected, check)
}

// `panic(message)` stops with one String message; the stop is a `Never`
// value and its `__jet_panic__` reachability edge comes from the checked-tree walk.
sema_call_check_ambient_panic: fn(call: Call, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    // A direct panic is never a Tensor operation's failure route: autodiff
    // rejects a differentiated function that reaches it.
    sema_compute_note_panic(check.context, false)
    ^complete: call.args.len() == 1
    if !complete {
        check.diagnostics.push(sema_error("E0103", call.name_span, "`panic` needs exactly one message", "a panic report needs something to show the user", "e.g. panic(\"something went wrong\")"))
    }
    ^message: TExpr?{None}
    loop argument_index in 0..<call.args.len() {
        checked: sema_check_expression(call.args[argument_index].expr, None, check) ?? {
            complete = false
            next
        }
        if checked.ty != Type.String {
            check.diagnostics.push(sema_error("E0112", expr_span(call.args[argument_index].expr), "`panic` needs text, but this is {sema_type_show(checked.ty)}", "the panic message is shown to the user as text", "put the message in quotes"))
            complete = false
            next
        }
        message = Val(checked)
    }
    if !complete -> return SemaDirectSpecialCheck{handled: true, value: None}
    text: message ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ^location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, call.name_span)
    location.locals = sema_expression_panic_locals(check.scopes, call.name_span)
    ^stop: sema_tree_node(Type.Named{name: "Never"}, TExprKind.RequireStop{kind: TRequireKind.Panic{msg: text}, location: location, always_stops: true}, call.name_span)
    SemaDirectSpecialCheck{handled: true, value: Val(stop)}
}

// `assert(condition)` / `assert(condition, message)`.
sema_call_check_ambient_assert: fn(call: Call, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    ^complete: call.args.len() == 1 || call.args.len() == 2
    if !complete {
        check.diagnostics.push(sema_error("E0103", call.name_span, "`assert` needs one condition, or a condition and a message", "assert checks a yes/no condition and stops when it's false", "e.g. assert(x > 0) or assert(x > 0, \"x must be positive\")"))
    }
    ^condition: TExpr?{None}
    if call.args.len() > 0 {
        ^checked: sema_check_expression(call.args[0].expr, None, check)
        if checked == .Val(value) {
            if value.ty != Type.Bool {
                check.diagnostics.push(sema_error("E0110", expr_span(call.args[0].expr), "`assert` needs {sema_type_show(Type.Bool)}, but this is {sema_type_show(value.ty)}", "the condition must be true or false", "compare values first, e.g. `x > 0`"))
                complete = false
            }
            condition = Val(value)
        } else { complete = false }
    }
    ^message: TExpr?{None}
    if call.args.len() > 1 {
        ^checked: sema_check_expression(call.args[1].expr, None, check)
        if checked == .Val(value) {
            if value.ty != Type.String {
                check.diagnostics.push(sema_error("E0112", expr_span(call.args[1].expr), "`assert` message must be text, but this is {sema_type_show(value.ty)}", "the optional message is shown when the condition is false", "put the message in quotes"))
                complete = false
            }
            message = Val(value)
        } else { complete = false }
    }
    if !complete -> return SemaDirectSpecialCheck{handled: true, value: None}
    checked_condition: condition ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ^location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, call.name_span)
    location.locals = sema_expression_panic_locals(check.scopes, call.name_span)
    ^stop: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.RequireStop{kind: TRequireKind.Require{cond: checked_condition, msg: message}, location: location, always_stops: false}, call.name_span)
    SemaDirectSpecialCheck{handled: true, value: Val(stop)}
}

// `assert_eq(got, expected)`: both sides one Equatable type; the right side
// takes the left's type as its expected type, as `==` does, and the sides
// compare through the implementation `==` dispatches to.
sema_call_check_ambient_assert_eq: fn(call: Call, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if call.args.len() != 2 {
        check.diagnostics.push(sema_error("E0104", call.name_span, "`assert_eq` needs exactly two values to compare", "assert_eq checks that two values are equal", "e.g. assert_eq(got, expected)"))
        loop argument_index in 0..<call.args.len() {
            ^_: sema_check_expression(call.args[argument_index].expr, None, check)
        }
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^left: sema_check_expression(call.args[0].expr, None, check)
    ^right_expected: Type?{None}
    if left == .Val(value) -> right_expected = Val(value.ty)
    ^right: sema_check_expression(call.args[1].expr, right_expected, check)
    left_value: left ?? return SemaDirectSpecialCheck{handled: true, value: None}
    right_value: right ?? return SemaDirectSpecialCheck{handled: true, value: None}
    // Declaration identity, not structure: a map type carries the span its
    // key was written at, so two `[String: Int]` maps differ structurally.
    if !type_identity_equal(left_value.ty, right_value.ty) {
        check.diagnostics.push(sema_error("E0108", call.name_span, "`assert_eq` compared {sema_type_show(left_value.ty)} and {sema_type_show(right_value.ty)}, which don't match", "both sides must be the same type to compare them", "convert one side, or compare fields that have the same type"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_type_equatable(check.environment.*, check.program.*, left_value.ty) {
        check.diagnostics.push(sema_error("E0312", call.name_span, "`assert_eq` can't compare values of type `{sema_type_show(left_value.ty)}`", "this type doesn't support `==`", "compare fields individually, or use a different check"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, call.name_span)
    location.locals = sema_expression_panic_locals(check.scopes, call.name_span)
    hook: sema_call_assert_eq_hook(left_value, right_value, call.name_span, check)
    ^stop: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.RequireStop{kind: TRequireKind.RequireEq{left: left_value, right: right_value, hook: hook}, location: location, always_stops: false}, call.name_span)
    SemaDirectSpecialCheck{handled: true, value: Val(stop)}
}

// `expect(value).snapshot()` asserts that `value`'s
// Display text equals the snapshot `__snapshots__/<file>_<line>.snap` beside
// the test. It is `assert(core.testing.snap(name, "{value}"))` with the name
// taken from the call site, so the first run writes the snapshot, a mismatch
// fails with `snap`'s unified diff, and `jet test -u` rewrites it.
sema_call_check_expect_snapshot: fn(call: Call, args: [CallArg], type_args: [Type], method_span: Span, check: ^SemaBodyCheck) -> TExpr? {
    if call.args.len() != 1 || call.args[0].label != None || call.args[0].spread || call.type_args.len() != 0 {
        loop argument in call.args -> ^_: sema_check_expression(argument.expr, None, check)
        check.diagnostics.push(sema_error("E0104", call.name_span, "`expect` takes exactly one value", "`expect(value).snapshot()` compares one value with its stored snapshot", "write `expect(value).snapshot()`"))
        return None
    }
    if args.len() != 0 || type_args.len() != 0 {
        loop argument in args -> ^_: sema_check_expression(argument.expr, None, check)
        check.diagnostics.push(sema_error("E0104", method_span, "`snapshot` takes no arguments", "the snapshot is named after the file and line of the call", "write `expect(value).snapshot()`"))
        return None
    }
    value_span: expr_span(call.args[0].expr)
    text: Expr.Str{parts: [StrPart]{StrPart.Interp{expr: call.args[0].expr, format: None}}, span: value_span, id: AST_NODE_GENERATED}
    checked_text: sema_check_expression(text, Val(Type.String), check) ?? return None
    route: sema_call_core_resolve_route(check, "core.testing", "snap", [Type]{}, 2, false, call.name_span) ?? return None
    target: if route == {
        .Source(source) -> source
        .Core(_) | .SharedSite(_) -> {
            check.context.incomplete_reasons.push("expect(value).snapshot() must resolve core.testing.snap's Jet source body")
            return None
        }
    }
    if !sema_effect_record_intrinsic_effects(check, "expect(value).snapshot()", call.name_span, [EffectRowEntry]{EffectRowEntry{name: "FS", span: call.name_span}, EffectRowEntry{name: "Env", span: call.name_span}}) {
        return None
    }
    callee: sema_call_callee_decl(check.program.*, target.symbol.id, call.name_span, check.diagnostics) ?? return None
    file: sema_source_file_at(check.environment.source_segments, check.environment.source_file, check.environment.source_origin, call.name_span)
    parts: file.split("/").to_list()
    base: if parts.len() > 0 && parts[parts.len() - 1] != "" -> parts[parts.len() - 1] else -> file
    line: sema_source_line_at(check.environment.source_segments, call.name_span) ?? 0
    stem: base.replace(".", "_")
    name: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "{stem}_{line}"}}}, call.name_span)
    matched: sema_tree_node(Type.Bool, TExprKind.Call{callee: callee, type_args: [Type]{}, args: [TCallArg]{sema_value_method_source_arg(name), sema_value_method_source_arg(checked_text)}}, call.name_span)
    ^location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, call.name_span)
    location.locals = sema_expression_panic_locals(check.scopes, call.name_span)
    Val(sema_tree_node(Type.Named{name: "Unit"}, TExprKind.RequireStop{kind: TRequireKind.Require{cond: matched, msg: None}, location: location, always_stops: false}, call.name_span))
}

// The authored `equal` (or `compare`) `left == right` dispatches to on a
// nominal operand (sema_expr_equality_resolution); None when the values
// compare structurally, as a derived hook compares them.
sema_call_assert_eq_hook: fn(left: TExpr, right: TExpr, span: Span, check: ^SemaBodyCheck) -> TMethodRef? {
    graph: check.program.registration_graph
    if !sema_expr_has_numeric_overload(left.ty) -> return None
    resolved: sema_expr_equality_resolution(graph, BinOp.Eq, left.ty, right.ty, span, check.environment.*, check.program.*, check.scopes, check.diagnostics) ?? return None
    if !resolved.receiver_is_left || resolved.derived -> return None
    Val(resolved.candidate.method)
}

// `("core.mem.scope", "guard")` (option B): the compiler-owned guard has no
// registry row. Its one zero-parameter cleanup lambda becomes the `ScopeGuard`
// whose scope-end drop runs it.
sema_call_try_scope_guard: fn(module_name: String, member: String, alias: String, alias_span: Span, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if module_name != "core.mem.scope" || member != "guard" {
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    imported: sema_call_core_import_target(check.environment.*, check.program.*, alias) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    if !sema_call_core_record_import_reference(check, imported, alias_span) {
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    if args.len() != 1 {
        check.diagnostics.push(sema_error("E0104", span, "`guard` expects 1 argument, got {args.len()}", "every argument must match a standard library function parameter", "check the call to `guard`"))
        loop argument in args -> ^_: sema_check_expression(argument.expr, None, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    callback_type: Type.Fn{params: [Type]{}, ret: Val(Type.Named{name: "Unit"}), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    callback: sema_check_expression(args[0].expr, Val(callback_type), check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    cleanup: if callback.kind == {
        .Lambda(value) -> Val(value)
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> None
    } ?? {
        check.diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`scope.guard` needs a lambda, not {sema_type_show(callback.ty)}", "a scope guard runs a cleanup lambda when the binding goes out of scope", "write `scope.guard(fn() {{ cleanup_code }})`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    arity: cleanup.param_types.len()
    if arity != 0 {
        check.diagnostics.push(sema_error("E0104", expr_span(args[0].expr), "`scope.guard` needs a zero-parameter lambda, got {arity} parameter{if arity == 1 -> "" else -> "s"}", "the guard body takes no arguments — it captures what it needs via closure", "write `scope.guard(fn() {{ cleanup_code }})` with no parameters"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    value: sema_tree_node(Type.Named{name: "ScopeGuard"}, TExprKind.CoreClosureCall{kind: TCoreClosureKind.Guard{executable: cleanup}}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// Core registry rows are selected by the caller's canonical route.  These
// source-owned projections run before the generic fixed-row producer; an
// unhandled projection deliberately leaves the row for that producer.
sema_call_try_core_direct_record: fn(record: CoreCallRecord, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck Never! {
    ^reactive: sema_call_try_reactive_core_call(record.module_name, record.member, args, type_args, span, expected, check)
    if reactive.handled -> return reactive

    SemaDirectSpecialCheck{handled: false, value: None}
}

sema_call_try_core_direct_call: fn(call: Call, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck Never! {
    before: check.diagnostics.len()
    ^unbuilt: SemaCoreUnbuiltCall?{None}
    checked: sema_call_core_direct_checked(call, expected, check, unbuilt)
    if checked.handled -> sema_call_core_unbuilt_settle(unbuilt, before, check.diagnostics)
    checked
}

sema_call_core_direct_checked: fn(call: Call, expected: Type?, check: ^SemaBodyCheck, unbuilt: ^SemaCoreUnbuiltCall?) -> SemaDirectSpecialCheck Never! {
    ^alias: call.name
    ^member: ""
    if call.name.contains(".") {
        ^parts: call.name.split(".").to_list()
        if parts.len() != 2 -> return SemaDirectSpecialCheck{handled: false, value: None}
        alias = parts[0]
        member = parts[1]
    } else {
        // A Core host-leaf item import (`use core.watcher.[__event]`,
        // registered as a Foreign symbol: no Jet declaration) is called by
        // its local name; its member is the imported item.
        visible: sema_scope_resolve_index(check.scopes, call.name) ?? return SemaDirectSpecialCheck{handled: false, value: None}
        if check.scopes.bindings[visible].symbol.kind != SymbolKind.Foreign {
            return SemaDirectSpecialCheck{handled: false, value: None}
        }
        imported: sema_call_core_import_target(check.environment.*, check.program.*, call.name) ?? return SemaDirectSpecialCheck{handled: false, value: None}
        member = imported.item ?? return SemaDirectSpecialCheck{handled: false, value: None}
    }
    module_name: sema_call_core_import_module(check.environment.*, check.program.*, alias) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    if sema_call_core_math_exact_crossing(module_name, member, call.args, check) == .Val(crossed) {
        return sema_call_try_core_direct_call(Call{name: call.name, name_span: call.name_span, type_args: call.type_args, args: crossed}, expected, check)
    }
    sema_call_core_unbuilt_note(module_name, member, call.name_span, check, unbuilt)
    ^guard: sema_call_try_scope_guard(module_name, member, alias, call.name_span, call.args, call.name_span, expected, check)
    if guard.handled -> return guard
    ^ui: sema_call_try_ui_core_call(module_name, member, alias, call.name_span, call.args, call.type_args, call.name_span, expected, check)
    if ui.handled -> return ui
    ^decode: sema_call_try_args_decode(module_name, member, alias, call.name_span, call.args, call.type_args, call.name_span, expected, check)
    if decode.handled -> return decode
    ^form: sema_call_try_web_form(module_name, member, alias, call.name_span, call.args, call.type_args, call.name_span, expected, check)
    if form.handled -> return form
    ^transform: sema_call_try_compute_transform(module_name, member, alias, call.name_span, call.args, call.type_args, call.name_span, expected, check)
    if transform.handled -> return transform
    ^fetched: sema_call_try_comptime_fetch(module_name, member, call.args, call.name_span, expected, check)
    if fetched.handled -> return fetched
    if sema_app_field_error_refused(module_name, member, call.args, check) {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    sema_call_app_device(module_name, member, alias, call.name_span, call.args, check.environment.*, check.program.*, check.context.function_name, check.diagnostics)
    sema_call_perf_name(module_name, member, call.args, check.diagnostics)
    ^live: sema_call_try_live(module_name, member, alias, call.name_span, call.args, call.type_args, call.name_span, expected, check)
    if live.handled -> return live
    data_query: sema_call_try_data_query(module_name, member, alias, call.name_span, call.args, call.type_args, call.name_span, expected, check)
    if data_query.handled -> return data_query
    // `reactive.signal/derived/computed/autorun` have no Core call record:
    // they check here, not by route.
    if module_name == "core.reactive" && (member == "signal" || member == "derived" || member == "computed" || member == "autorun") {
        return sema_call_try_reactive_core_call(module_name, member, call.args, call.type_args, call.name_span, expected, check)
    }
    if sema_call_core_crypto_expert_gate(module_name, member, call.name_span, check) {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if sema_call_core_vault_build_time_gate(module_name, member, call.name_span, check) {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if sema_call_core_variadic_term(check, alias, member, call.args.len(), call.name_span) == .Val(variadic) {
        if variadic == "progress" {
            return sema_call_check_term_progress_iter(call.args, call.name_span, expected, check)
        }
        return sema_call_check_ambient_print(call, check)
    }
    ^diagnostics_before: check.diagnostics.len()
    ^route: sema_call_core_resolve_import_route(check, alias, member, call.type_args, call.args.len(), sema_call_core_configured_client(call.args), call.name_span, call.name_span)
    route_value: route ?? {
        if check.diagnostics.len() != diagnostics_before {
            return SemaDirectSpecialCheck{handled: true, value: None}
        }
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    if route_value == {
        .SharedSite(lifetime) -> {
            return SemaDirectSpecialCheck{handled: true, value: sema_call_core_global_shared(lifetime, member, call.type_args, call.args, call.name_span, expected, check)}
        }
        .Source(target) -> {
            place: sema_call_try_memory_place(target, call.args, call.name_span, expected, check)
            if place.handled -> return SemaDirectSpecialCheck{handled: true, value: place.value}
            math_abs: sema_call_try_core_math_abs(module_name, member, call.type_args, call.args, call.name_span, expected, check)
            if math_abs.handled -> return math_abs
            float_class: sema_call_try_core_math_float_class(module_name, member, call.type_args, call.args, check)
            if float_class.handled -> return float_class
            root: sema_call_try_core_math_sqrt(module_name, member, call.type_args, call.args, call.name_span, expected, check)
            if root.handled -> return root
            f32_math: sema_call_try_core_math_f32(module_name, member, call.type_args, call.args, call.name_span, expected, check)
            if f32_math.handled -> return f32_math
            compute_alias: sema_call_try_compute_alias(module_name, member, target, call.type_args, call.args, call.name_span, expected, check)
            if compute_alias.handled {
                return SemaDirectSpecialCheck{handled: true, value: compute_alias.value}
            }
            if module_name == "core.ui" && member == "node_role" {
                sema_call_core_ui_node_role_lint(call.args, call.name_span, check)
            }
            check.scopes.ownership_call_depth += 1
            ^value: sema_call_core_check_source_owned(target, call.name, call.type_args, call.args, call.name_span, expected, check)
            check.scopes.ownership_call_depth -= 1
            return SemaDirectSpecialCheck{handled: true, value: value}
        }
        .Core(record) -> {
            ^special: sema_call_try_core_direct_record(record, call.args, call.type_args, call.name_span, expected, check)
            if special.handled -> return special
            check.scopes.ownership_call_depth += 1
            ^value: sema_call_core_check_fixed(module_name, member, call.type_args, call.args, call.name_span, expected, check)
            check.scopes.ownership_call_depth -= 1
            return SemaDirectSpecialCheck{handled: true, value: value}
        }
    }
}

sema_call_default_err_span: fn(call: Call) -> Span {
    if {
        call.args.len() > 0 -> {
            last: call.args[call.args.len() - 1]
            Span{start: call.name_span.start, end: expr_span(last.expr).end}
        }
        else -> call.name_span
    }
}

sema_call_default_err_result: fn(expected: Type?) -> Type? {
    expected_value: expected ?? return None
    normalized: sema_expr_unwrap_tag(expected_value)
    if normalized == {
        .Result(ok, err) -> Val(Type.Result{ok: ok, err: err})
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// This predicate is intentionally keyed to the dedicated compiler binding.
// A source/imported function or type named Err remains the ordinary resolver
// winner, matching native shadowing behavior.
sema_call_default_err_candidate: fn(call: Call, expected: Type?, scopes: SemaScopeTable) -> Bool Never! {
    if call.name != "Err" -> return false
    index: sema_scope_resolve_index(scopes, call.name) ?? return false
    sema_scope_binding_is_compiler_builtin(scopes.bindings[index], "Err")
}

sema_call_default_err_invalid_argument: fn(argument: CallArg, check: ^SemaBodyCheck) Never! {
    ^_: sema_check_expression(argument.expr, None, check)
}

sema_call_default_err_optional: fn(value: Expr?, value_span: Span?, span: Span) -> Expr {
    if value == {
        .Val(expression) -> {
            present_span: value_span ?? expr_span(expression)
            Expr.Present{value: expression, span: present_span, id: AST_NODE_GENERATED}
        }
        .None -> Expr.Absent{span: span, id: AST_NODE_GENERATED}
    }
}

sema_call_default_err_contextual_result: fn(call: Call, result: Type, ok: Type, err: Type, check: ^SemaBodyCheck) -> TExpr? {
    if call.args.len() != 1 || call.args[0].label != None -> return None
    payload: sema_check_expression(call.args[0].expr, Val(err), check) ?? return None
    compatible: sema_call_type_assignable(err, payload.ty, check) ?? return None
    if !compatible {
        check.diagnostics.push(sema_type_mismatch(err, payload.ty, expr_span(call.args[0].expr), check.program.*))
        return None
    }
    value: sema_tree_node(result, TExprKind.Err{value: payload}, sema_call_default_err_span(call))
    sema_expr_expected(value, Val(result), check.environment.*, check.program.*, check.diagnostics)
}

sema_call_default_err_constructor: fn(call: Call, expected: Type?, wrap_result: Bool, check: ^SemaBodyCheck) -> TExpr? {
    span: sema_call_default_err_span(call)
    if call.args.len() < 1 || call.args.len() > 3 {
        check.diagnostics.push(sema_error("E0104", call.name_span, "`Err` takes a message and optional `code:` and `cause:`, got {call.args.len()} arguments", "the default error stores one message, one optional code, and one optional cause", "write `Err(\"message\")`, then add `code:` or `cause:` labels if needed"))
    }
    ^message: Expr?{None}
    ^code: Expr?{None}
    ^cause: Expr?{None}
    ^code_span: Span?{None}
    ^cause_span: Span?{None}
    loop index in 0..<call.args.len() {
        argument: call.args[index]
        ^label_span: argument.span
        ^label_name: String?{None}
        if argument.label == .Val(label) {
            label_span = label.span
            label_name = Val(label.name)
        }
        if {
            index == 0 -> {
                if label_name != None {
                    check.diagnostics.push(sema_error("E0767", label_span, "`message` is the positional argument of `Err`", "the short constructor starts with the error message", "remove the label and write `Err(\"message\", ...)`"))
                }
                message = Val(argument.expr)
            }
            label_name == (Val("code")) -> {
                if {
                    code != None -> {
                        check.diagnostics.push(sema_error("E0765", label_span, "`code:` is written twice in this call to `Err`", "each constructor label sets one field", "remove the second `code:` argument"))
                        sema_call_default_err_invalid_argument(argument, check)
                    }
                    else -> {
                        code = Val(argument.expr)
                        code_span = Val(label_span)
                    }
                }
            }
            label_name == (Val("cause")) -> {
                if {
                    cause != None -> {
                        check.diagnostics.push(sema_error("E0765", label_span, "`cause:` is written twice in this call to `Err`", "each constructor label sets one field", "remove the second `cause:` argument"))
                        sema_call_default_err_invalid_argument(argument, check)
                    }
                    else -> {
                        cause = Val(argument.expr)
                        cause_span = Val(label_span)
                    }
                }
            }
            label_name != None -> {
                label: label_name ?? ""
                check.diagnostics.push(sema_error("E0764", label_span, "`Err` has no parameter labeled `{label}`", "the optional labels are `code:` and `cause:`", "use `code:` or `cause:`, or remove the argument"))
                sema_call_default_err_invalid_argument(argument, check)
            }
            else -> {
                check.diagnostics.push(sema_error("E0769", argument.span, "optional `Err` arguments need labels", "`code:` and `cause:` can appear in either order only because their labels identify them", "add `code:` or `cause:` before this argument"))
                sema_call_default_err_invalid_argument(argument, check)
            }
        }
    }
    message_expr: message ?? Expr.Str{parts: [StrPart]{StrPart.Lit{text: ""}}, span: span, id: AST_NODE_GENERATED}
    fields: [ExprField]{
        {name: "message", name_span: expr_span(message_expr), value: message_expr},
        {name: "code", name_span: span, value: sema_call_default_err_optional(code, code_span, span)},
        {name: "cause", name_span: span, value: sema_call_default_err_optional(cause, cause_span, span)},
    }
    struct_expr: Expr.StructLit{type_name: "Err", type_args: [Type]{}, import_ns: None, as_trait: None, fields: fields, inferred: false, span: span, id: AST_NODE_GENERATED}
    payload: sema_check_expression(struct_expr, Val(Type.Named{name: "Err"}), check) ?? return None
    if !wrap_result -> return Val(payload)
    result_value: sema_call_default_err_result(expected) ?? Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "Err"}}
    return if result_value == {
        .Result(ok, err) -> {
            compatible: sema_call_type_assignable(err, payload.ty, check) ?? return None
            if !compatible {
                check.diagnostics.push(sema_type_mismatch(err, payload.ty, span, check.program.*))
                return None
            }
            value: sema_tree_node(Type.Result{ok: ok, err: err}, TExprKind.Err{value: payload}, span)
            sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> Val(payload)
    }
}

// A union that holds the general `Err` is open: `Err("message")` builds that
// member, the same default error an unannotated function's message sends.
sema_call_default_err_message_into_open_union: fn(value: Expr, err: Type, check: ^SemaBodyCheck) -> Bool {
    ^open: false
    if sema_expr_unwrap_tag(err) == .Union(members) {
        loop member in members {
            if sema_expr_unwrap_tag(member) == (Type.Named{name: "Err"}) -> open = true
        }
    }
    if !open -> return false
    message: sema_failure_union_unparen(value)
    if message == .Str(_, _, _) -> return true
    probed: sema_failure_union_probe_type(message, check) ?? return false
    sema_expr_unwrap_tag(probed) == .String
}

sema_call_check_default_err: fn(call: Call, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    result: sema_call_default_err_result(expected)
    if result == .Val(result_value) {
        // An `Err(...)` that builds a carrier is a failure source of its own;
        // the empty key never resolves.
        check.context.failure_edges.push("")
        if result_value == .Result(ok, err) {
            if err != (Type.Named{name: "Err"}) && call.args.len() == 1 && call.args[0].label == None && !sema_call_default_err_message_into_open_union(call.args[0].expr, err, check) {
                return sema_call_default_err_contextual_result(call, result_value, ok, err, check)
            }
            // Record what this `Err` sends down the
            // default route before the ordinary check below.
            if err == (Type.Named{name: "Err"}) -> sema_failure_union_record_err(call, check)
        }
    }
    wrap: result != None
    value: sema_call_default_err_constructor(call, expected, wrap, check) ?? return None
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// The defaults a call to `target` takes for the parameters it leaves
// unwritten: a lone Snapshot program's come from its own declarations, the
// rest from Registration.
sema_call_target_default_values: fn(target: SemaCallDirectTarget, binding: SemaCallBinding, span: Span, check: ^SemaBodyCheck) -> [SemaCallDefaultValue]? {
    if check.program.registration_graph.mode == .Snapshot {
        local_defaults: sema_call_local_default_values(target, binding, check) ?? {
            check.diagnostics.push(sema_error("E0906", span, "a default argument for this call could not be resolved", "callable defaults retain their owning declaration and source identity", "make the owning declaration available to Registration before checking this call"))
            return None
        }
        return Val(local_defaults)
    }
    registered_defaults: sema_call_registration_defaults(check.program.registration_graph, binding) ?? {
        check.diagnostics.push(sema_error("E0906", span, "a default argument for this call could not be resolved", "registered callable defaults retain their graph identity and source location", "make the bound default available to Registration before checking this call"))
        return None
    }
    Val(registered_defaults)
}

sema_call_local_default_values: fn(target: SemaCallDirectTarget, binding: SemaCallBinding, check: ^SemaBodyCheck) -> [SemaCallDefaultValue]? {
    if binding.default_refs.len() == 0 -> return Val([SemaCallDefaultValue]{})
    declaration: sema_scope_resolve_declaration(check.environment.*, check.program.*, target.symbol.id) ?? return None
    func: if declaration == {
        .Func(value) -> value
        .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {
            return None
        }
    }
    ^defaults: [SemaCallDefaultValue]{}
    // A body's own id is no registered owner a default names.
    owner_key: if symbol_is_local(target.symbol.id) -> "" else -> sema_program_symbol_key(check.program.*, target.symbol.id)
    loop reference in binding.default_refs {
        if reference.owner_key != owner_key -> return None
        parameter_index: reference.parameter_index
        if parameter_index < 0 || parameter_index >= func.params.len() -> return None
        expression: func.params[parameter_index].default ?? return None
        expression_span: expr_span(expression)
        if expression_span.start != reference.span.start || expression_span.end != reference.span.end {
            return None
        }
        source_file: sema_source_file_at(check.environment.source_segments, reference.source_file, check.environment.source_origin, expression_span)
        if source_file != reference.source_file -> return None
        defaults.push(SemaCallDefaultValue{reference: reference, expression: expression, run: func.params[parameter_index].default_run})
    }
    Val(defaults)
}

// `waiting` is the first argument whose probe checked to no value without an
// error: a read still waiting on a compile-time value (another module's
// constant not staged yet) that gives inference no type. `failed` is the
// first argument whose probe failed with its own error (a lambda reading a
// value a capture already consumed): inference lacking that argument's type
// reports that error, not E0904; `failed_expected` is the type that argument
// is checked against there, when its error needs one (a field selector for
// a `FieldRef`). A written-parameter lambda's parameter types, then its
// return facts (`lambda_returns`), are the last of the type lists.
SemaCallInferenceFacts: struct {
    parameter_types: [Type],
    argument_types: [Type],
    waiting: Int?,
    failed: Int?,
    failed_expected: Type?,
    lambda_returns: [SemaCallLambdaReturn],
}

// Argument `argument`, a lambda whose parameters are all written, returns
// `value` where its parameter's `fn` type returns `required`.
SemaCallLambdaReturn: struct {
    argument: Int,
    required: Type,
    value: Type,
}

// Whether `expr` takes its type from the parameter it meets, so inference
// can't learn from it: a lambda, an empty list or map, and a bare `None`.
// Such an argument is checked against its parameter once inference settles
// the type parameters; on its own it only fails for want of that type.
sema_call_inference_needs_context: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .Lambda(_, _) | .Absent(_, _) -> true
        .ListLit(elements, _, _) -> elements.len() == 0
        .MapLit(entries, _, _) -> entries.len() == 0
        .EnumLit(type_name, variant, _, args, _, _, _) -> type_name == "" && variant == "None" && args.len() == 0
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// The value type of a function named as an argument (`apply(add_item, …)`),
// for inference to learn from. Its probe alone fails on a function with a
// `^` or `^^` parameter, since only a function type that marks the same
// parameters takes it (E0227); the argument is checked against its settled
// parameter type once inference is done, which reports a mark that differs.
sema_call_function_name_value: fn(expr: Expr, check: SemaBodyCheck) -> Type? Never! {
    if expr == .Ident(name, _, _) {
        index: sema_scope_resolve_index(check.scopes, name) ?? return None
        if check.scopes.bindings[index].symbol.kind != SymbolKind.Function -> return None
        ty: sema_scope_binding_type(check.environment.*, check.scopes, index) ?? return None
        return Val(sema_function_value_type(check.program.*, ty, check.scopes.bindings[index].symbol.module_identity, None))
    }
    None
}

sema_call_collect_inference_facts: fn(params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], check: ^SemaBodyCheck) -> SemaCallInferenceFacts Never! {
    ^parameter_types: [Type]{}
    ^argument_types: [Type]{}
    ^waiting: Int?{None}
    ^failed: Int?{None}
    ^failed_expected: Type?{None}
    ^lambda_returns: [SemaCallLambdaReturn]{}
    ^lambda_parameters: [Type]{}
    ^lambda_arguments: [Type]{}
    loop index in 0..<args.len() {
        slot: if index < binding.slots.len() -> binding.slots[index] else -> -1
        if slot >= 0 && slot < params.len() {
            if sema_call_argument_parameter_type(params[slot], args[index]) == .Val(required) {
                // A field selector for a `FieldRef<M, T>` settles `T` as the
                // field's type; one naming no field of `M` is the failed
                // argument, reported against its parameter. `required` is the
                // `FieldRef` itself unless written unresolved.
                if sema_field_ref_selector(args[index].expr) {
                    resolved: sema_field_ref_resolve(required, check)
                    if resolved != None || sema_field_ref_resolved(required) {
                        ^probe_diagnostics: [Diagnostic]{}
                        found: if resolved == .Val(ref_type) -> sema_field_ref_probe(args[index].expr, ref_type, check.environment.*, check.program.*, check.scopes, check.context, probe_diagnostics) else -> sema_field_ref_probe(args[index].expr, required, check.environment.*, check.program.*, check.scopes, check.context, probe_diagnostics)
                        if found == .Val(field_ref) {
                            parameter_types.push(required)
                            argument_types.push(field_ref)
                        } else if failed == None {
                            failed = Val(index)
                            failed_expected = Val(resolved ?? required)
                        }
                        next
                    }
                }
                if !sema_call_inference_needs_context(args[index].expr) {
                    ^probe_diagnostics: [Diagnostic]{}
                    value: sema_probe_expression(args[index].expr, None, check, probe_diagnostics)
                    if value == .Val(checked) {
                        parameter_types.push(required)
                        argument_types.push(checked.ty)
                    } else if sema_call_function_name_value(args[index].expr, check) == .Val(named) {
                        parameter_types.push(required)
                        argument_types.push(named)
                    } else if !sema_has_error_since(probe_diagnostics, 0) {
                        if waiting == None -> waiting = Val(index)
                    } else if failed == None { failed = Val(index) }
                } else if sema_call_lambda_params_written(args[index].expr) {
                    ^probe_diagnostics: [Diagnostic]{}
                    checked: sema_probe_expression(args[index].expr, None, check, probe_diagnostics) ?? {
                        if failed == None && sema_has_error_since(probe_diagnostics, 0) {
                            failed = Val(index)
                        }
                        next
                    }
                    // `on_drop: fn(task: Task) { … }` for `fn(T)` settles T
                    // from the written parameter type.
                    if required == .Fn(required_params, _, _, _, _, _) {
                        if checked.ty == .Fn(written_params, _, _, _, _, _) {
                            if required_params.len() == written_params.len() {
                                loop position in 0..<required_params.len() {
                                    lambda_parameters.push(required_params[position].copy())
                                    lambda_arguments.push(written_params[position].copy())
                                }
                            }
                        }
                    }
                    fact: sema_call_lambda_return_fact(index, required, checked.ty) ?? next
                    lambda_returns.push(fact)
                }
            }
        }
    }
    // The lambda facts unify after the plain arguments, so a type parameter
    // a plain argument settles stays settled and a lambda returning another
    // type is the conflict (sema_call_lambda_return_conflicts).
    loop parameter in lambda_parameters -> parameter_types.push(parameter)
    loop argument in lambda_arguments -> argument_types.push(argument)
    loop row in lambda_returns {
        parameter_types.push(row.required)
        argument_types.push(row.value)
    }
    SemaCallInferenceFacts{parameter_types: parameter_types, argument_types: argument_types, waiting: waiting, failed: failed, failed_expected: failed_expected, lambda_returns: lambda_returns}
}

// An argument that fails on its own (`facts.failed`) gave inference no type.
// Checking it reports that error where the argument is, in place of E0904;
// false when it checks without one.
sema_call_inference_failed_argument: fn(facts: SemaCallInferenceFacts, args: [CallArg], check: ^SemaBodyCheck) -> Bool {
    index: facts.failed ?? return false
    mark: check.diagnostics.len()
    ^_: sema_check_expression(args[index].expr, facts.failed_expected, check)
    sema_has_error_since(check.diagnostics, mark)
}

// A trait-bounded variadic's arity function gives each trailing argument its
// own slot type parameter (`parts__Va0`). An argument whose type misses a
// slot's bound is E1313 at that argument, before inference names the slot.
sema_call_variadic_slot_bounds_met: fn(target: SemaCallDirectTarget, callee: String, params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], check: ^SemaBodyCheck) -> Bool {
    // Snapshot: a slot's bound names a registered trait, and a lone program
    // registers none.
    if check.program.registration_graph.mode == .Snapshot -> return true
    loop index in 0..<args.len() {
        slot: if index < binding.slots.len() -> binding.slots[index] else -> -1
        if slot < 0 || slot >= params.len() -> next
        required: sema_call_argument_parameter_type(params[slot], args[index]) ?? next
        if required == .Named(slot_type) {
            parameter_name: sema_variadic_bound_slot_parameter(slot_type) ?? next
            ^param_index: -1
            loop (gp_index, parameter) in target.generic_params {
                if parameter.name == slot_type {
                    param_index = gp_index
                    break
                }
            }
            if param_index < 0 -> next
            ^probe_diagnostics: [Diagnostic]{}
            checked: sema_probe_expression(args[index].expr, None, check, probe_diagnostics) ?? next
            loop bound in target.generic_params[param_index].bounds {
                if sema_call_variadic_bound_met(bound, checked.ty, check) != (Val(false)) -> next
                check.diagnostics.push(sema_call_variadic_bound_unmet(type_name(checked.ty), parameter_name, bound, callee, expr_span(args[index].expr)))
                return false
            }
        }
    }
    true
}

// A value that is never a number (text, a Bool, a list, ...) passed for a
// `Numeric`-bound type parameter is E0112 at that argument, naming the callee
// and the argument as a fixed number parameter does, not E0905 at the callee
// asking for an `impl` the type can't have.
sema_call_numeric_slot_arguments_met: fn(target: SemaCallDirectTarget, callee: String, params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], check: ^SemaBodyCheck) -> Bool {
    loop index in 0..<args.len() {
        slot: if index < binding.slots.len() -> binding.slots[index] else -> -1
        if slot < 0 || slot >= params.len() -> next
        required: sema_call_argument_parameter_type(params[slot], args[index]) ?? next
        if required == .Named(slot_type) {
            ^numeric: false
            loop parameter in target.generic_params {
                if parameter.name != slot_type -> next
                loop bound in parameter.bounds {
                    if bound == "Numeric" -> numeric = true
                }
            }
            if !numeric -> next
            ^probe_diagnostics: [Diagnostic]{}
            checked: sema_probe_expression(args[index].expr, None, check, probe_diagnostics) ?? next
            if !sema_type_never_numeric(checked.ty) -> next
            check.diagnostics.push(sema_error("E0112", expr_span(args[index].expr), "`{sema_call_reflection_leaf_name(callee)}` wants a number (a `Numeric` type such as Int) for argument {index + 1}, but this is {sema_type_show(checked.ty)}", "every argument must match its parameter's type", "use a number here, such as Int (a whole number)"))
            return false
        }
    }
    true
}

// Built-in types no `#Numeric` marker or `impl Numeric` can make a number.
sema_type_never_numeric: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Tuple(_) | .FixedList(_, _) -> true
        .Tagged(_, inner) -> sema_type_never_numeric(inner)
        .Int | .Float | .Named(_) | .Measure(_) | .Apply(_, _) | .Quantity(_, _) | .TraitObject(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Shared(_) | .Union(_) | .Case(_, _) -> false
    }
}

sema_call_lambda_params_written: fn(expr: Expr) -> Bool Never! {
    if expr == .Lambda(lambda, _) {
        loop param in lambda.params {
            if param.ty == None -> return false
        }
        return true
    }
    false
}

// A lambda whose parameters are all written is typed on its own, so its
// return fills the type parameters of the required `fn` return. Of a
// `U E!` return only `U` is this fact: the failure part is
// sema_call_lambda_failure_facts' own.
sema_call_lambda_return_fact: fn(argument: Int, required: Type, lambda_ty: Type) -> SemaCallLambdaReturn? Never! {
    ^required_value: Type?{None}
    if required == .Fn(_, required_ret, _, _, _, _) -> required_value = required_ret
    ret: required_value ?? return None
    ^lambda_value: Type?{None}
    // A lambda's `Fn` writes a Unit return as no return, so one ending in a
    // call that returns nothing fills `U` with Unit.
    if lambda_ty == .Fn(_, lambda_ret, _, _, _, _) {
        lambda_value = Val(lambda_ret ?? Type.Named{name: "Unit"})
    }
    value: lambda_value ?? return None
    if value == .Named(name) {
        if name == "Never" -> return None
    }
    if ret == .Result(ok, _) {
        if value == .Result(value_ok, _) {
            return Val(SemaCallLambdaReturn{argument: argument, required: ok, value: value_ok})
        }
        return Val(SemaCallLambdaReturn{argument: argument, required: ok, value: value})
    }
    Val(SemaCallLambdaReturn{argument: argument, required: ret, value: value})
}

// A type parameter the plain arguments settled that a written-parameter
// lambda returns another type for is E0904 at the callee, naming both
// sources; checking the arguments then reports the lambda's own E0112.
sema_call_lambda_return_conflicts: fn(target: SemaCallDirectTarget, rows: [SemaCallLambdaReturn], params: [SemaCallParam], binding: SemaCallBinding, span: Span, diagnostics: ^[Diagnostic]) {
    loop row in rows {
        if row.required == .Named(name) {
            loop substitution in target.generic_substitutions {
                if substitution.name != name || type_identity_equal(substitution.ty, row.value) {
                    next
                }
                ^source: "the other arguments"
                loop index in 0..<binding.slots.len() {
                    slot: binding.slots[index]
                    if index == row.argument || slot < 0 || slot >= params.len() -> next
                    if sema_call_parameter_type(params[slot]) == (Val(Type.Named{name: name})) {
                        source = "argument {index + 1}"
                        break
                    }
                }
                diagnostics.push(sema_error("E0904", span, "can't figure out what `{name}` should be here", "one generic type parameter received incompatible concrete types", "{name} is {type_name(substitution.ty)} from {source} but {type_name(row.value)} from the lambda return; make those types agree"))
            }
        }
    }
}

// A lambda argument fills a failure-type parameter `E`
// written as `fn(..) -> U E!` with the failure its body really has. The lambda
// is probed on its own; a body that cannot fail, or one that cannot be typed
// before the other type parameters are known, binds `E` to `Never`.
sema_call_lambda_failure_facts: fn(facts: ^SemaCallInferenceFacts, generic_params: [SemaInferenceTypeParam], params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], check: ^SemaBodyCheck) Never! {
    loop index in 0..<args.len() {
        slot: if index < binding.slots.len() -> binding.slots[index] else -> -1
        if sema_call_inference_needs_context(args[index].expr) && slot >= 0 && slot < params.len() {
            if sema_call_parameter_type(params[slot]) == .Val(required) {
                if required == .Fn(_, required_ret, _, _, _, _) {
                    if required_ret == .Val(ret) {
                        if ret == .Result(_, error) {
                            if error == .Named(name) {
                                ^generic: false
                                loop param in generic_params {
                                    if param.name == name -> generic = true
                                }
                                if generic {
                                    ^failure: Type.Named{name: "Never"}
                                    ^probe_diagnostics: [Diagnostic]{}
                                    value: sema_probe_expression(args[index].expr, None, check, probe_diagnostics)
                                    if value == .Val(checked) {
                                        if checked.ty == .Fn(_, lambda_ret, _, _, _, _) {
                                            if lambda_ret == .Val(lambda_value) {
                                                if lambda_value == .Result(_, lambda_error) {
                                                    failure = lambda_error
                                                }
                                            }
                                        }
                                    }
                                    facts.parameter_types.push(error)
                                    facts.argument_types.push(failure)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

sema_call_direct_target_abi: fn(target: SemaCallDirectTarget, check: SemaBodyCheck) -> SemaRegistrationCallableABI? {
    graph: check.program.registration_graph
    ^abi: sema_registration_callable_abi(graph, target.symbol.id)
    if abi != None -> return abi
    declaration: sema_scope_resolve_declaration(check.environment.*, check.program.*, target.symbol.id) ?? return None
    if declaration == {
        .Func(func) -> Val(sema_registration_callable_abi_for_func(func))
        .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> None
    }
}

// L0202: a bare `Shared` name passed to a direct call inside a loop retains the
// handle once per pass.
sema_call_lint_shared_loop_arguments: fn(args: [CallArg], check: ^SemaBodyCheck) {
    if check.scopes.loop_depth <= 0 {
        return
    }
    loop argument in args {
        if argument.expr == .Ident(name, span, _) {
            index: sema_scope_resolve_index_at(check.scopes, name, span) ?? next
            ty: sema_scope_binding_type(check.environment.*, check.scopes, index) ?? next
            if ty == .Shared(_) {
                check.diagnostics.push(sema_lint("L0202", span, "Auto-cloned `{name}` inside a loop; consider hoisting or caching", "Shared handles are cloned when used across a loop boundary", "Hoist `{name}` before the loop, or clone once outside"))
            }
        }
    }
}

// A declared point's constructor (`event.point<T>()`, sema_core_point_constructor)
// called in a body: a point is a module binding's identity, so its call is
// valid only as such a binding's whole value.
sema_call_point_in_body: fn(target: SemaCallDirectTarget, check: SemaBodyCheck) -[]> Bool {
    if check.environment.function_name == "" || !module_is_core(target.symbol.module_identity) {
        return false
    }
    graph: check.program.registration_graph
    row: sema_registration_callable_row_of(graph, target.symbol.id) ?? return false
    sema_core_point_constructor(graph, row)
}

// E0956 when `target` is a compiler or build service import (`#Import(jet.
// compiler, symbol: …)`, Guest.jet) called where no host answers it: outside
// Core, in a body that runs when the program does. Only Core declares one
// (E1806); Core's own calls are its wrappers, whose handles only build code
// holds. The call is still checked past it.
sema_call_service_out_of_phase: fn(target: SemaCallDirectTarget, span: Span, check: SemaBodyCheck) -> Diagnostic? {
    if module_is_core(check.environment.module_identity) || !module_is_core(target.symbol.module_identity) || sema_scope_build_time(check.scopes, check.environment.*, check.program.*) {
        return None
    }
    graph: check.program.registration_graph
    row: sema_registration_callable_row_of(graph, target.symbol.id) ?? return None
    if row == .Function(declaring, index) {
        service: parser_service_import(graph.modules[declaring].functions[index].declaration) ?? return None
        why: if service.provider == "jet.compiler" -> "the compiler API exposes read-only front-end facts to build and comptime code; it is not a runtime service" else -> "the build API declares build steps and reads checked build facts for build and comptime code; it is not a runtime service"
        return Val(sema_error("E0956", span, "`{graph.modules[declaring].module_name}.{target.symbol.name}` is compile-time only", why, "move this call into `build: fn` or a `#run` binding"))
    }
    None
}

sema_call_direct_checked_from_target: fn(check: ^SemaBodyCheck, target: SemaCallDirectTarget, call: Call, defaults: [SemaCallDefaultValue], expected: Type?) -> SemaCallChecked? {
    if sema_call_point_in_body(target, check) {
        check.diagnostics.push(sema_error("E0644", call.name_span, "`{target.symbol.name}` makes a point, which is declared only as a module binding's value", "a point is the module binding it initializes: the program makes its carrier at the first read and every reader shares it, and a call in a body would make a new, anonymous carrier each time it runs", "declare it at module level (`clicked: event.point<Int>()`) and use that binding; for a value that is local by design, use `event.new`, `event.hook` or `event.decision_hook`"))
        return None
    }
    if sema_call_memory_place_target(target, check) {
        check.diagnostics.push(sema_error("E1004", call.name_span, "`{target.symbol.name}` is called through its module", "the compiler builds `{target.symbol.name}` where the call stands, on the caller's own storage, and only a call through `core.mem` reaches it", "write `mem.{target.symbol.name}(…)` after `use core.mem`"))
        loop argument in call.args -> _: sema_check_expression(argument.expr, None, check)
        return None
    }
    if sema_call_service_out_of_phase(target, call.name_span, check) == .Val(refused) {
        check.diagnostics.push(refused)
    }
    ^params: sema_call_params_from_type(target.signature) ?? {
        check.diagnostics.push(sema_call_not_callable(call.name, target.signature, call.name_span))
        return None
    }
    ^args: call.args
    root_mark: check.diagnostics.len()
    ^binding: sema_call_bind_direct(call.name, target.signature, args, call.name_span, check.diagnostics) ?? {
        sema_call_note_possible_arg_writes(call.args, check)
        sema_call_direct_rejected_propagation(target, call, root_mark, expected, check)
        return None
    }
    if target.generic_params.len() > 0 && target.generic_substitutions.len() != target.generic_params.len() {
        ^source_args: call.args
        ^inferred_facts: sema_call_collect_inference_facts(params, binding, source_args, check)
        sema_call_lambda_failure_facts(inferred_facts, target.generic_params, params, binding, source_args, check)
        if sema_call_http_source_json_target(target, check) {
            loop parameter in target.generic_params {
                loop bound in parameter.bounds {
                    if bound != "Encode" -> next
                    loop index in 0..<inferred_facts.parameter_types.len() {
                        if inferred_facts.parameter_types[index] == (Type.Named{name: parameter.name}) {
                            body_type: inferred_facts.argument_types[index]
                            if !sema_serde_type_is_admissible(check.environment.*, check.program.*, body_type, SemaSerdeDirection.Encode) {
                                sema_call_http_check_serde(SemaSerdeDirection.Encode, body_type, expr_span(source_args[index].expr), check)
                                return None
                            }
                        }
                    }
                }
            }
        }
        if !sema_call_variadic_slot_bounds_met(target, call.name, params, binding, source_args, check) {
            sema_call_note_possible_bound_writes(params, binding, source_args, check)
            return None
        }
        if !sema_call_numeric_slot_arguments_met(target, call.name, params, binding, source_args, check) {
            sema_call_note_possible_bound_writes(params, binding, source_args, check)
            return None
        }
        ^inference_diagnostics: [Diagnostic]{}
        inferred: sema_call_infer_direct_target_from_types(target, inferred_facts.parameter_types, inferred_facts.argument_types, expected, check.environment.*, check.program.*, check.scopes, call.name_span, inference_diagnostics) ?? {
            sema_call_note_possible_bound_writes(params, binding, source_args, check)
            // An argument still waiting on a compile-time value has no type
            // yet. Checking it records the wait, so the call is checked again
            // once the value lands, not reported as uninferrable.
            if inferred_facts.waiting == .Val(index) {
                ^_: sema_check_expression(source_args[index].expr, None, check)
                return None
            }
            if sema_call_inference_failed_argument(inferred_facts, source_args, check) {
                return None
            }
            loop diagnostic in inference_diagnostics -> check.diagnostics.push(diagnostic)
            return None
        }
        loop diagnostic in inference_diagnostics -> check.diagnostics.push(diagnostic)
        sema_call_lambda_return_conflicts(inferred, inferred_facts.lambda_returns, params, binding, call.name_span, check.diagnostics)
        ^inferred_params: sema_call_params_from_type(inferred.signature) ?? {
            check.diagnostics.push(sema_call_not_callable(call.name, inferred.signature, call.name_span))
            return None
        }
        ^inferred_args: call.args
        ^inferred_binding: sema_call_bind_direct(call.name, inferred.signature, inferred_args, call.name_span, check.diagnostics) ?? return None
        return sema_call_direct_checked_resolved(check, inferred, inferred_params, inferred_args, inferred_binding.move(), call, defaults, expected, root_mark)
    }
    sema_call_direct_checked_resolved(check, target, params, args, binding.move(), call, defaults, expected, root_mark)
}

sema_call_direct_checked_resolved: fn(check: ^SemaBodyCheck, candidate: SemaCallDirectTarget, params: [SemaCallParam], args: ^[CallArg], binding_in: ^^SemaCallBinding, call: Call, defaults: [SemaCallDefaultValue], expected: Type?, root_mark: Int) -> SemaCallChecked? {
    ^binding: binding_in.move()
    if !sema_call_direct_target_generic_ready(candidate, check.diagnostics, call.name_span) {
        return None
    }
    // The settled type arguments decide what the callee's crossings carry
    // across threads (Ownership/GenericCrossings.jet).
    if candidate.generic_substitutions.len() > 0 {
        sema_generic_call_note(sema_symbol_key(check.program.*, check.context, candidate.symbol.id), call.name, candidate.generic_substitutions, call.name_span, check.environment.*, check.program.*, check.context)
    }
    if binding.default_refs.len() > 0 {
        ^resolved_defaults: defaults
        if resolved_defaults.len() == 0 {
            resolved_defaults = sema_call_target_default_values(candidate, binding, call.name_span, check) ?? return None
        }
        resolved: sema_call_materialize_defaults(params, binding, args, resolved_defaults, call.name_span, check.diagnostics) ?? return None
        binding = resolved
    }
    ^abi: SemaRegistrationCallableABI?{None}
    ^callee_facts: SemaContractCalleeFacts?{None}
    ^callee_facts_resolved: false
    ^has_markers: true
    graph: check.program.registration_graph
    if sema_registration_callable_row_of(graph, candidate.symbol.id) == .Val(row) {
        callee_facts_resolved = true
        if row == {
            .Function(module_index, index) -> {
                abi = Val(graph.modules[module_index].functions[index].abi)
                callee_facts = sema_contract_call_site_facts_of_func(graph.modules[module_index].functions[index].declaration)
                has_markers = graph.modules[module_index].functions[index].declaration.markers.len() > 0
            }
            .NominalMethod(module_index, owner, index) -> {
                abi = Val(graph.modules[module_index].nominals[owner].methods[index].abi)
                callee_facts = sema_contract_call_site_facts_of_func(graph.modules[module_index].nominals[owner].methods[index].declaration)
                has_markers = graph.modules[module_index].nominals[owner].methods[index].declaration.markers.len() > 0
            }
            .ImplMethod(module_index, owner, index) -> {
                abi = Val(graph.modules[module_index].impls[owner].methods[index].abi)
                callee_facts = sema_contract_call_site_facts_of_func(graph.modules[module_index].impls[owner].methods[index].declaration)
                has_markers = graph.modules[module_index].impls[owner].methods[index].declaration.markers.len() > 0
            }
            .Foreign(module_index, index) -> {
                abi = Val(graph.modules[module_index].foreign_functions[index].abi)
                has_markers = false
            }
        }
    } else { abi = sema_call_direct_target_abi(candidate, check) }
    {^lowered, ^pins}: sema_call_check_bound_arguments_owned(check, call.name, params, abi, true, binding, args, call.name_span) ?? {
        sema_call_direct_rejected_propagation(candidate, call, root_mark, expected, check)
        return None
    }
    sema_call_lint_shared_loop_arguments(call.args, check)
    if !callee_facts_resolved {
        callee_facts = sema_contract_call_site_facts(check, candidate.symbol.id)
    }
    if callee_facts == .Val(facts) {
        if facts.param_view_from.len() > 0 && !sema_call_check_param_view_from(facts, binding.slots, call.args, check) {
            return None
        }
    }
    result_type_raw: sema_call_signature_return(candidate.signature) ?? return None
    result_type: sema_call_resolved_type(result_type_raw, check.environment.*, check.program.*)
    // E2104: a C import whose convention or values the native backend has no
    // C ABI marshaling for yet is refused by a compile that lowers the call,
    // instead of stopping inside the IR.
    if abi == .Val(callable_abi) && callable_abi.is_c_abi && !module_is_core(check.environment.module_identity) && sema_refuses_unbuilt(check.program.*) {
        if sema_checked_foreign_c_marshal_gap(graph, candidate.symbol.id) == .Val(gap) {
            check.diagnostics.push(sema_error("E2104", call.name_span, "calling `{call.name}` is not built yet", "This `jet` cannot yet {gap}, and no other `jet` can build it.", "Remove the `{call.name}` call for now; native C ABI marshaling for it needs its Jet implementation first."))
            return None
        }
    }
    ^contract_bindings: [TStmt]{}
    ^contract_nodes: [TContract]{}
    // The callee's declaration is copied only when a call checks its clauses.
    ^contract_callee: Func?{None}
    if callee_facts == .Val(facts) && facts.call_checks > 0 {
        contract_callee = sema_contract_function_for_symbol(check, candidate.symbol.id)
    }
    if contract_callee == .Val(contract) {
        slots: loop slot in 0..<params.len() -> slot
        // copy: the contract check may stage this call again by name; the call keeps its written type arguments and its checked type.
        recall: SemaContractRecall{call: Call{name: call.name, name_span: call.name_span, type_args: call.type_args.copy(), args: [CallArg]{}}, result_type: result_type.copy()}
        checked_contract: sema_contract_check_call(contract, candidate.symbol.id, Val(recall), lowered, slots, call.name_span, check) ?? return None
        contract_bindings = checked_contract.bindings
        contract_nodes = checked_contract.contracts
    }
    ^policy_value: TExpr?{None}
    if has_markers {
        policy_diagnostic_count: check.diagnostics.len()
        policy_value = sema_policy_direct_value(candidate, call.name_span, check)
        if sema_has_error_since(check.diagnostics, policy_diagnostic_count) -> return None
    }
    call_value: if policy_value == .Val(callee) -> {
        sema_tree_node(result_type, TExprKind.IndirectCall{callee: callee, type_args: candidate.type_args, args: lowered, signature: candidate.signature}, call.name_span)
    } else -> {
        callee: sema_call_callee_decl(check.program.*, candidate.symbol.id, call.name_span, check.diagnostics) ?? return None
        sema_tree_node(result_type, TExprKind.Call{callee: callee, type_args: candidate.type_args, args: lowered}, call.name_span)
    }
    contracted: if {
        contract_nodes.len() > 0 || contract_bindings.len() > 0 -> {
            ^wrapped: contract_bindings
            loop contract in contract_nodes -> wrapped.push(TStmt.Contract{contract: contract})
            wrapped.push(TStmt.ExprStmt{value: call_value, span: call.name_span})
            sema_tree_node(result_type, TExprKind.InlineBlock{body: wrapped}, call.name_span)
        }
        else -> call_value
    }
    value: sema_call_with_binder_pins(pins, contracted, call.name_span)
    checked: sema_expression_call_expected(value, expected, check) ?? return None
    facts: sema_call_facts(candidate.signature, candidate.type_args, binding) ?? return None
    return_view_facts: sema_call_return_view_facts(candidate.signature, None, args, binding, check, call.name_span)
    Val(SemaCallChecked{value: checked, binding: binding.move(), facts: facts, return_view_facts: return_view_facts})
}

// A direct call rejected at its arguments after its callee resolved: the
// callee's declared result still auto-propagates, linked to the call's own
// error (sema_expression_rejected_call_propagation). Only a rejection that
// reported an error has one: an argument still waiting on a compile-time
// value rejects without one and is checked again. The check adds reports
// only; the facts it would record belong to a call that never lowers, and a
// discarded probe must not keep them, so the context is rolled back. A
// generic callee whose type arguments are still open has no settled result
// type to check.
sema_call_direct_rejected_propagation: fn(candidate: SemaCallDirectTarget, call: Call, root_mark: Int, expected: Type?, check: ^SemaBodyCheck) Never! {
    if !sema_has_error_since(check.diagnostics, root_mark) {
        return
    }
    if candidate.generic_params.len() > 0 && candidate.generic_substitutions.len() != candidate.generic_params.len() {
        return
    }
    result_type_raw: sema_call_signature_return(candidate.signature) ?? return
    result_type: sema_call_resolved_type(result_type_raw, check.environment.*, check.program.*)
    source: Expr.Call{call: call.copy(), id: AST_NODE_GENERATED}
    mark: sema_check_context_save(check.context)
    sema_expression_rejected_call_propagation(result_type, Val(source), root_mark, call.name_span, expected, check)
    sema_check_context_rollback(check.context, mark.move())
}

// A
// parameter `word: View<str> from corpus` takes only an argument whose view
// owners stay inside the places of the arguments passed for the named sibling
// parameters (E2305). `slots` maps each written argument to its parameter.
sema_call_check_param_view_from: fn(callee: SemaContractCalleeFacts, slots: [Int], args: [CallArg], check: ^SemaBodyCheck) -> Bool {
    ^valid: true
    loop (index, required) in callee.param_view_from {
        names: required ?? next
        written: sema_call_written_arg_for_slot(slots, index) ?? next
        argument_span: expr_span(args[written].expr)
        actual: sema_ownership_places_from_expr_in_state(args[written].expr, check.scopes, check.state)
        if actual.len() == 0 -> next
        ^allowed: [SemaOwnershipPlace]{}
        loop name in names {
            source_index: loop (position, param_name) in callee.param_names {
                if param_name == name {
                    break Val(position)
                }
            } ?? None
            source: source_index ?? {
                check.diagnostics.push(sema_error("E2305", argument_span, "`from {name}` does not name a parameter", "a parameter `from` clause names sibling parameters (or `self`) that own the view", "use a parameter name from this function's signature"))
                valid = false
                next
            }
            source_written: sema_call_written_arg_for_slot(slots, source) ?? next
            loop place in sema_ownership_places_from_expr_in_state(args[source_written].expr, check.scopes, check.state) {
                allowed.push(place)
            }
        }
        if allowed.len() == 0 -> next
        inside: loop place in actual {
            covered: loop owner in allowed {
                if !symbol_is_none(place.root_id) && place.root_id == owner.root_id && sema_ownership_path_starts(place.projections, owner.projections) {
                    break true
                }
            } ?? false
            if !covered {
                break false
            }
        } ?? true
        if !inside {
            check.diagnostics.push(sema_error("E2305", argument_span, "`{callee.param_names[index]}` must borrow from its declared `from` sources", "this argument's view owners are outside the sources named after `from`", "pass a view derived from those sources, or widen the `from` clause"))
            valid = false
        }
    }
    valid
}

// The written argument bound to parameter `slot`, or None for a default.
sema_call_written_arg_for_slot: fn(slots: [Int], slot: Int) -> Int? Never! {
    loop (written, bound) in slots {
        if bound == slot -> return Val(written)
    }
    None
}

// A direct call is recorded when its callee carries `#Recorded`
// (Calls/Recorded.jet), and hears the `check` rules of its callee's markers
// before its arguments bind (Calls/CheckRules.jet).
sema_call_check_direct_target_owned: fn(check: ^SemaBodyCheck, target: SemaCallDirectTarget, call: Call, defaults: [SemaCallDefaultValue], expected: Type?) -> SemaCallChecked? {
    if sema_recorded_here(check, target.symbol.id) {
        sema_recorded_note(check, target.symbol.id, call.name, call.name_span, call.args, target.type_args, None)
    }
    ^rules: [SemaCallRule]{}
    graph: check.program.registration_graph
    if sema_call_rules_heard_here(check.scopes) {
        rules = sema_call_rules_of_callee(graph, target.symbol.id)
    }
    if rules.len() == 0 {
        return sema_call_direct_checked_from_target(check, target, call, defaults, expected)
    }
    hearing: sema_call_rules_hear(rules, Val(target.symbol.id), call.name, call.name_span, call.args, target.type_args, None, None, None, call.name_span, None, "", check.scopes.current, check)
    if hearing.rejected -> return None
    if !hearing.staged {
        return sema_call_direct_checked_from_target(check, target, call, defaults, expected)
    }
    ^held: [Diagnostic]{}
    sema_body_check_swap_diagnostics(check, held)
    checked: sema_call_direct_checked_from_target(check, target, call, defaults, expected)
    sema_body_check_swap_diagnostics(check, held)
    if sema_call_rules_hold(hearing, held, check) -> return None
    checked
}

// The direct-call forms ahead of ordinary name resolution, taken first by
// sema_expr_check_direct_call. `measurement(value, uncertainty:)` and
// `apply(policy..., f)` apply only unshadowed.
sema_call_try_direct_forms: fn(call: Call, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if call.name == "measurement" && sema_scope_resolve_index(check.scopes, call.name) == None {
        labeled: call.args.len() == 2 && call.args[0].label == None && (if call.args[1].label == {
            .Val(label) -> label.name == "uncertainty"
            .None -> false
        })
        if !labeled {
            loop argument_index in 0..<call.args.len() {
                ^_: sema_check_expression(call.args[argument_index].expr, None, check)
            }
            check.diagnostics.push(sema_error("E0104", call.name_span, "`measurement` needs a value and labeled uncertainty", "a measured value enters the exactness plane at one explicit constructor", "write `measurement(value, uncertainty: standard_uncertainty)`"))
            return SemaDirectSpecialCheck{handled: true, value: None}
        }
        values: loop argument_index in 0..<call.args.len() -> {
            value: sema_check_expression(call.args[argument_index].expr, Val(Type.Float), check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
            if !sema_ownership_check_call_receiver(check, call.args[argument_index].expr, AccessConvention.Read, call.args[argument_index].span) {
                return SemaDirectSpecialCheck{handled: true, value: None}
            }
            value
        }
        result: Type.Apply{name: "Measurement", args: [Type]{Type.Float}}
        value: sema_expression_measurement_source_call("MeasurementNew", values, result, call.name_span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        return SemaDirectSpecialCheck{handled: true, value: sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)}
    }
    sema_policy_try_apply(call, expected, check)
}

sema_call_check_freeze: fn(call: Call, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if call.args.len() != 1 {
        sema_stream_handle_infer_args(call.args, check)
        check.diagnostics.push(sema_error("E0104", call.name_span, "`freeze` takes exactly one value, got {call.args.len()}", "`freeze(x)` creates one deeply immutable owned snapshot for a crossing", "write `freeze(value)` with exactly one value"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^source: call.args[0].expr
    ^previous_borrow: check.context.borrow_ctx
    ^previous_string_view_read: check.context.allow_string_view_read
    check.context.borrow_ctx = true
    check.context.allow_string_view_read = true
    ^checked_source: sema_check_expression(source, None, check)
    check.context.borrow_ctx = previous_borrow
    check.context.allow_string_view_read = previous_string_view_read
    checked: checked_source ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ^string_view: sema_expr_copy_string_view(source, check.scopes)
    ^facts: sema_copy_classify(checked.ty, SemaCopyIntent.Clone, check.environment.*, check.program.*, check.context.generic_params, string_view)
    ^problem: sema_ownership_crossing_problem(facts.target, SemaSendCrossing.FrozenSnapshot, true, check.environment.*, check.program.*, check.scopes, check.context)
    ^reason: String?{None}
    if problem == .Val(found) && found.kind == SemaSendProblemKind.SharedMutation {
        reason = Val(sema_ownership_crossing_describe(found))
    }
    if reason == None && facts.resource {
        reason = Val("a resource has one cleanup owner and cannot be duplicated into a snapshot")
    }
    if reason == None && (!facts.complete || !facts.cloneable) {
        reason = Val("the value contains a resource, function, trait value, or mutable view that Jet cannot duplicate")
    }
    if reason == .Val(explanation) {
        row: sema_diagnostic_row("E1114")
        ^what: row.what.replace("{{ty}}", type_name(checked.ty)).replace("{{reason}}", explanation)
        check.diagnostics.push(sema_error("E1114", expr_span(source), what, row.why, row.fix))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if problem == .Val(found) {
        check.diagnostics.push(sema_ownership_crossing_diagnostic("this frozen value", facts.target, found, SemaSendCrossing.TaskCapture, expr_span(source)))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^already_frozen: sema_ownership_frozen_expr_site(check.state, source, check.scopes) != None
    ^result: checked
    if !already_frozen {
        if sema_copy_memory_operation(facts) != None || sema_copy_effect_name(facts) != None {
            check.context.copy_events.push(SemaCopyEvent{span: call.name_span, facts: facts})
        }
        ^kind: if facts.materializes_view -> TExprKind.MaterializeView{value: checked} else -> TExprKind.Clone{value: checked, fact: CopyFact.Explicit}
        result = sema_tree_node(facts.target, kind.move(), call.name_span)
    }
    check.state.freeze_sites.push(SemaOwnershipFreezeSite{span: call.name_span, line: sema_source_line_at(check.environment.source_segments, call.name_span) ?? 1, column: sema_source_column_at(check.environment.source_segments, call.name_span) ?? 1})
    ^checked_result: sema_expression_call_expected(result, expected, check)
    SemaDirectSpecialCheck{handled: true, value: checked_result}
}

// E2475 (`#ColumnOf`, on `table.column`'s name): the literal at the marked
// parameter `param` is checked against the one row schema the table sorts,
// filters and renders.
sema_call_web_table_column_schema: fn(args: [CallArg], param: Int, checked: TExpr, check: ^SemaBodyCheck) {
    if param >= args.len() {
        return
    }
    ^column: String?{None}
    if sema_registration_cli_without_parens(args[param].expr) == .Str(parts, _, _) {
        if parts.len() == 1 && parts[0] == .Lit(text) -> column = Val(text.copy())
    }
    column_name: column ?? return
    ^schema: Type?{None}
    // The checked call keeps its `Never!` carrier (`WebTableColumn<Order> Never!`).
    ^column_ty: sema_expr_unwrap_tag(checked.ty)
    if column_ty == .Result(ok, _) -> column_ty = sema_expr_unwrap_tag(ok)
    if column_ty == .Apply(_, type_args) {
        if type_args.len() == 1 -> schema = Val(type_args[0])
    }
    ^row: schema ?? return
    loop {
        if row == .Tagged(_, inner) -> row = inner else { break }
    }
    span: args[param].span
    ^row_name: ""
    if row == .Named(name) -> row_name = name
    if row == .Apply(name, _) -> row_name = name
    if row_name == "" {
        check.diagnostics.push(sema_error("E2475", span, "table column `{column_name}` needs a declared row schema, got `{sema_type_show(row)}`", "table columns are checked against row fields before a renderer can consume them", "declare a row struct, then use one of its fields as the column name"))
        return
    }
    definition: sema_http_route_find_struct(check, row, check.environment.module_identity) ?? {
        check.diagnostics.push(sema_error("E2475", span, "table column `{column_name}` needs fields from row type `{row_name}`", "a typed table column must resolve against a declared row schema", "declare the row fields before constructing the table column"))
        return
    }
    known: definition.fields.map(fn(field) { field.name })
    loop field in known {
        if field == column_name {
            return
        }
    }
    suggestion: sema_suggest_field(column_name, known)
    ^what: "table column `{column_name}` is not a field on `{row_name}`"
    ^fix: "rename the column to one of the existing fields: {known.join(", ")}"
    if suggestion == .Val(field) {
        what = "table column `{column_name}` is not a field on `{row_name}`; did you mean `{field}`?"
        fix = "rename the column to the existing field `{field}`"
    }
    check.diagnostics.push(sema_error("E2475", span, what, "the table keeps one row schema for sorting, filtering, and every renderer", fix))
}
