// Generic coordinate-space Transform receiver contracts. Point/delta binary
// operations already live in Expressions.jet and are intentionally not repeated.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    ParamZone,
    Span,
    TExpr,
    TExprKind,
    TFailureCarrier,
    THandleOp,
    Type,
    type_identity_equal,
    core_source_owns_type,
    type_name,
]

struct SemaCallGeometryTransformParts {
    scalar: Type
    from: Type
    to: Type
    name: String
}

// Same declaration-identity predicate as Rust's geometry_nominal_leaf.
fn sema_geometry_nominal_leaf(name: String) -> String Never! {
    if !core_source_owns_type(name) -> return name.copy()
    parts :: name.split("::").to_list()
    if parts.len() >= 2 && core_identity_module(name) == (Val("core.math")) -> return parts[parts.len() - 1].copy()
    name.copy()
}

fn sema_geometry_restore_owner(ty: Type, source: Type) -> Type Never! {
    // copy: the restored type is a new owned Type. For a non-named source it equals `ty`, the
    // caller's checked type (a read parameter), which stays on its node.
    name :: if source == { .Named(owner) | .Apply(owner, _) -> owner else -> { return ty.copy() } }
    leaf :: sema_geometry_nominal_leaf(name)
    // copy: the restored type is a new owned Type. When the leaf already matches it equals `ty`,
    // the caller's checked type (a read parameter), which stays on its node.
    if leaf == name -> return ty.copy()
    parts := name.split("::").to_list()
    if ty == {
        .Result(ok, error) -> return Type.Result{ok: sema_geometry_restore_owner(ok, source), err: sema_geometry_restore_owner(error, source)}
        .Named(result) -> {
            // copy: the restored type is a new owned Type. When already qualified it equals `ty`,
            // the caller's checked type (a read parameter), which stays on its node.
            if result.contains("::") -> return ty.copy()
            parts[parts.len() - 1] = result.copy()
            return Type.Named{name: parts.join("::")}
        }
        .Apply(result, args) -> {
            // copy: the restored type is a new owned Type. When already qualified it equals `ty`,
            // the caller's checked type (a read parameter), which stays on its node.
            if result.contains("::") -> return ty.copy()
            parts[parts.len() - 1] = result.copy()
            return Type.Apply{name: parts.join("::"), args: args.copy()}
        }
        // copy: the restored type is a new owned Type. For other kinds it equals `ty`, the caller's
        // checked type (a read parameter), which stays on its node.
        else -> return ty.copy()
    }
}

fn sema_call_geometry_intrinsic_type(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
        name :: if ty == { .Named(owner) | .Apply(owner, _) -> owner else -> "" }
        if sema_geometry_nominal_leaf(name) != name -> return true
        return sema_type_resolve_nominal_row(graph, ty, environment.module_identity) == None
    } else {
        return false
    }
}

fn sema_call_geometry_transform_parts(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaCallGeometryTransformParts? {
    resolved :: sema_call_resolved_type(ty, environment, program)
    matches := if resolved == {
        .Apply(name, args) -> (sema_geometry_nominal_leaf(name) == "Transform" && args.len() == 2) || (sema_geometry_nominal_leaf(name) == "Transform2" && args.len() == 3)
        else -> false
    }
    if !matches {
        return None
    }
    if !sema_call_geometry_intrinsic_type(resolved, environment, program) -> return None
    if resolved == {
        .Apply(name, args) -> {
            if sema_geometry_nominal_leaf(name) == "Transform" {
                return Val(SemaCallGeometryTransformParts{scalar: Type.Float, from: args[0], to: args[1], name: "Transform"})
            }
            if sema_geometry_nominal_leaf(name) == "Transform2" {
                return Val(SemaCallGeometryTransformParts{scalar: args[0], from: args[1], to: args[2], name: "Transform2"})
            }
            return None
        }
        else -> { return None }
    }
}

fn sema_call_geometry_is_point(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> sema_geometry_nominal_leaf(name) == "ScreenPoint" || sema_geometry_nominal_leaf(name) == "WorldPoint" || sema_geometry_nominal_leaf(name) == "ViewPoint" || sema_geometry_nominal_leaf(name) == "CameraPoint" || sema_geometry_nominal_leaf(name) == "DevicePoint"
        .Apply(name, args) -> sema_geometry_nominal_leaf(name) == "Point2" && args.len() == 2
        else -> false
    }
}

fn sema_call_geometry_space(ty: Type) -> Type? {
    if ty == {
        .Named(source_name) -> {
            name :: sema_geometry_nominal_leaf(source_name)
            if name == "ScreenPoint" || name == "ScreenDelta" {
                return Val(Type.Named{name: "Screen"})
            }
            if name == "WorldPoint" || name == "WorldDelta" {
                return Val(Type.Named{name: "World"})
            }
            if name == "ViewPoint" || name == "ViewDelta" {
                return Val(Type.Named{name: "View"})
            }
            if name == "CameraPoint" || name == "CameraDelta" {
                return Val(Type.Named{name: "Camera"})
            }
            if name == "DevicePoint" || name == "DeviceDelta" {
                return Val(Type.Named{name: "Device"})
            }
            None
        }
        .Apply(name, args) -> {
            if (sema_geometry_nominal_leaf(name) == "Point2" || sema_geometry_nominal_leaf(name) == "Delta2") && args.len() == 2 {
                return Val(args[1])
            }
            None
        }
        else -> None
    }
}

fn sema_call_geometry_generic(name: String, scalar: Type, space: Type) -> Type Never! {
    Type.Apply{name: name, args: [Type]{scalar, space}}
}

fn sema_call_geometry_transform_type(parts: SemaCallGeometryTransformParts, from: Type, to: Type) -> Type Never! {
    if {
        type_identity_equal(parts.scalar, Type.Float) -> Type.Apply{name: "Transform", args: [Type]{from, to}}
        else -> Type.Apply{name: "Transform2", args: [Type]{parts.scalar, from, to}}
    }
}

fn sema_call_geometry_transform_method_return(receiver_type: Type, method: String, args: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type? {
    result :: sema_call_geometry_transform_method_return_inner(receiver_type, method, args, environment, program) ?? return None
    Val(sema_geometry_restore_owner(result, sema_call_resolved_type(receiver_type, environment, program)))
}

fn sema_call_geometry_transform_method_return_inner(receiver_type: Type, method: String, args: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type? {
    parts :: sema_call_geometry_transform_parts(receiver_type, environment, program) ?? return None
    if method == "then" && args.len() == 1 {
        next :: sema_call_geometry_transform_parts(args[0], environment, program) ?? return None
        if !type_identity_equal(parts.scalar, next.scalar) || !type_identity_equal(parts.to, next.from) -> return None
        return Val(Type.Result{ok: sema_call_geometry_transform_type(parts, parts.from, next.to), err: Type.Named{name: "TransformError"}})
    }
    if method == "inverse" && args.len() == 0 {
        return Val(Type.Result{ok: sema_call_geometry_transform_type(parts, parts.to, parts.from), err: Type.Named{name: "TransformError"}})
    }
    if method == "point" && args.len() == 1 {
        point_type :: sema_call_resolved_type(args[0], environment, program)
        point_space :: sema_call_geometry_space(point_type) ?? return None
        if !sema_call_geometry_is_point(point_type) || !type_identity_equal(point_space, parts.from) -> return None
        return Val(Type.Result{ok: sema_call_geometry_generic("Point2", parts.scalar, parts.to), err: Type.Named{name: "TransformError"}})
    }
    if method == "point_at_depth" && args.len() == 2 {
        point_type :: sema_call_resolved_type(args[0], environment, program)
        point_space :: sema_call_geometry_space(point_type) ?? return None
        if !sema_call_geometry_is_point(point_type) || !type_identity_equal(point_space, parts.from) -> return None
        return Val(Type.Result{ok: sema_call_geometry_generic("Point2", parts.scalar, parts.to), err: Type.Named{name: "TransformError"}})
    }
    if method == "ray" && args.len() == 1 {
        point_type :: sema_call_resolved_type(args[0], environment, program)
        point_space :: sema_call_geometry_space(point_type) ?? return None
        if !sema_call_geometry_is_point(point_type) || !type_identity_equal(point_space, parts.from) -> return None
        return Val(Type.Result{ok: Type.Apply{name: "Ray2", args: [Type]{parts.scalar, parts.from, parts.to}}, err: Type.Named{name: "TransformError"}})
    }
    None
}

fn sema_geometry_diagnostic_type(ty: Type) -> Type Never! {
    if ty == {
        .Named(name) -> Type.Named{name: sema_geometry_nominal_leaf(name)}
        .Apply(name, args) -> Type.Apply{name: sema_geometry_nominal_leaf(name), args: args.copy()}
        // copy: the diagnostic type is a new owned Type. For other kinds it equals `ty`, the
        // caller's checked type (a read parameter), which stays on its node.
        else -> ty.copy()
    }
}

fn sema_call_geometry_report_transform_chain_mismatch(receiver: Type, method: String, args: [Type], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Bool {
    if method != "then" || args.len() != 1 -> return false
    first_type := sema_call_resolved_type(receiver, environment, program)
    second_type := sema_call_resolved_type(args[0], environment, program)
    first :: sema_call_geometry_transform_parts(first_type, environment, program) ?? return false
    second :: sema_call_geometry_transform_parts(second_type, environment, program) ?? return false
    if type_identity_equal(first.to, second.from) -> return false
    &diagnostics.push(sema_error(
        "E2521",
        span,
        "Cannot compose `{type_name(sema_geometry_diagnostic_type(first_type))}` with `{type_name(sema_geometry_diagnostic_type(second_type))}`: `{type_name(first.to)}` does not match `{type_name(second.from)}`.",
        "A transform chain is valid only when the destination of the first transform is the source of the next one.",
        "Reverse or replace one transform so both middle spaces are the same.",
    ))
    true
}

fn sema_call_geometry_report_method_error(receiver: Type, owner: String, method: String, args: [Type], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) {
    expected_type := sema_call_resolved_type(receiver, environment, program)
    actual_type :: if args.len() > 0 -> sema_call_resolved_type(args[0], environment, program) else -> Type.Named{name: "Unknown"}
    expected := type_name(expected_type)
    actual := if args.len() > 0 -> type_name(sema_call_geometry_space(actual_type) ?? actual_type) else -> "<missing>"
    &diagnostics.push(sema_error(
        "E2520",
        span,
        "`{owner}.{method}` needs `{expected}` space, got `{actual}`.",
        "Coordinate-space tags are ordinary type facts; combining different spaces would make a numerically valid result mean the wrong thing.",
        "Use a `{expected}` point or displacement, or convert it with a checked transform.",
    ))
}

fn sema_call_geometry_argument_types(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [Type] Never! {
    types := [Type]{}
    loop argument in args {
        checked :: sema_check_expression(argument.expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        &types.push(if checked == .Val(value) -> value.ty else -> Type.Named{name: "Unknown"})
    }
    types
}

fn sema_call_geometry_method_arg_count(method: String) -> Int? {
    if method == "then" || method == "point" || method == "ray" -> return Val(1)
    if method == "inverse" -> return Val(0)
    if method == "point_at_depth" -> return Val(2)
    None
}

fn sema_call_geometry_call_facts(result_type: Type) -> SemaCallFacts Never! {
    failure_carrier :: if result_type == {.Result(ok, err) -> TFailureCarrier.Result{success: ok, error: err} else -> TFailureCarrier.Infallible}
    SemaCallFacts{return_type: result_type, failure_carrier: failure_carrier, effect_bound: Val([EffectRowEntry]{}), type_args: [Type]{}, default_refs: [FunctionDefaultRef]{}}
}

fn sema_call_geometry_method_params(types: [Type]) -> [SemaCallParam] Never! {
    params :: loop (index, ty) in types -> SemaCallParam{label: "arg{index + 1}", name: "arg{index + 1}", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(ty), variadic: false}
    params
}

fn sema_call_try_geometry(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    parts :: sema_call_geometry_transform_parts(receiver_value.ty, environment, program) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    expected_count :: sema_call_geometry_method_arg_count(method)
    if expected_count == None {
        if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        arg_types :: sema_call_geometry_argument_types(updated_args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        sema_call_geometry_report_method_error(receiver_value.ty, parts.name, method, arg_types, span, environment, program, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if updated_args.len() != (expected_count) {
        if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        arg_types :: sema_call_geometry_argument_types(updated_args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        sema_call_geometry_report_method_error(receiver_value.ty, parts.name, method, arg_types, span, environment, program, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    values := [TExpr]{}
    types := [Type]{}
    valid := true
    loop (index, argument) in updated_args {
        depth_argument := method == "point_at_depth" && index == 1 && updated_args.len() == 2
        checked :: if depth_argument -> sema_check_expression(argument.expr, Val(Type.Float), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression(argument.expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        if checked == {
            .Val(value) -> {
                &values.push(value)
                &types.push(value.ty)
            }
            else -> {
                valid = false
                &types.push(Type.Named{name: "Unknown"})
            }
        }
    }
    if !valid {
        _ := sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    ownership := sema_ownership_check_method_call(&state, "{parts.name}.{method}", receiver, AccessConvention.Read, sema_call_geometry_method_params(types), &updated_args, scopes, span, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    result_type :: sema_call_geometry_transform_method_return(receiver_value.ty, method, types, environment, program) ?? {
        chain_mismatch := sema_call_geometry_report_transform_chain_mismatch(receiver_value.ty, method, types, span, environment, program, &diagnostics)
        if !chain_mismatch -> sema_call_geometry_report_method_error(receiver_value.ty, parts.name, method, types, span, environment, program, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    value :: sema_tir_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: THandleOp.MathMethod{type_name: parts.name, method: method, reduce_op: None}, args: values}, span)
    if !sema_effect_record_intrinsic_fact(environment, program, &scopes, &context, "{parts.name}.{method}", span, sema_call_geometry_call_facts(result_type), &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
}

#Test("Geometry declaration identity matches only source-owned Core nominals") {
    owner :: "<corelib>/core.math::ScreenPoint"
    assert_eq(sema_geometry_nominal_leaf(owner), "ScreenPoint")
    assert_eq(sema_geometry_nominal_leaf("user::ScreenPoint"), "user::ScreenPoint")
    restored :: sema_geometry_restore_owner(Type.Result{ok: Type.Apply{name: "Transform", args: [Type]{Type.Named{name: "World"}, Type.Named{name: "Screen"}}}, err: Type.Named{name: "TransformError"}}, Type.Named{name: owner})
    assert_eq(restored, Type.Result{ok: Type.Apply{name: "<corelib>/core.math::Transform", args: [Type]{Type.Named{name: "World"}, Type.Named{name: "Screen"}}}, err: Type.Named{name: "<corelib>/core.math::TransformError"}})
}
