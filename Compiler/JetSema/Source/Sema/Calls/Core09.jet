    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5079
    fn infer_inner_field(self: &Self, e: &Expr) -> Type? Never! {
        span :: e.span()
        if &self.desugar_shared_field_read(&e) -> return &self.infer(&e)
        if e == .Field(inner, member, _) && inner == .Ident(name, _) && name == Syntax.TERMINAL_FACT_NAMESPACE {
            if Syntax.terminal_fact(member) == .Val(fact) {
                e = Expr.Str([StrPart.Lit(fact)], span)
                return Val(Type.String)
            }
            candidates :: Syntax.TERMINAL_FACTS.to_array()
            suggestion :: suggest_field(member, candidates)
            fix :: suggestion.map(fn(fact) { "did you mean `TerminalFact.{fact}`?" }) ?? "use a documented TerminalFact key or a preview string"
            diagnostic := Diagnostic.error("E0302", "`TerminalFact` has no key `{member}`", "stable terminal fact keys use the checked TerminalFact namespace", fix, Val(span))
            if suggestion == .Val(fact) -> diagnostic = diagnostic.with_edit(TextEdit{span: span, new_text: fact})
            &self.diags.push(^diagnostic)
            return None
        }
        if self.fold_enum_variant_path(e) == .Val((type_name, variant)) && (variant.contains('.') || (type_name.contains("::") && !variant.is_empty())) {
            args := [EnumLitArg]{}
            ty :: &self.check_enum_lit(type_name, variant, &args, span, None)
            e = Expr.EnumLit(type_name, variant, None, [], false, span)
            return Val(ty)
        }
        if &self.fold_fact_read(&e) == .Val(result) -> return result
        if e == .Field(inner, member, _) {
            if member == "indexes" {
                self.borrow_ctx = true
                base_ty :: &self.infer(&inner) ?? return None
                is_seq :: if base_ty == { .List | .FixedList -> true; .Apply(name, _) -> name == "Iter"; else -> false }
                if is_seq {
                    receiver :: ^inner
                    e = Expr.MethodCall(^receiver, "indexes", span, [], [], [], None, None, None, false)
                    return &self.infer(&e)
                }
            }
            return &self.infer_field(&inner, member, span)
        }
        panic("matched Field above")
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5181
    fn infer_inner_opt_field(self: &Self, e: &Expr) -> Type? Never! {
        if e == .OptField(base, member, member_span, flatten, _) {
            bt :: &self.infer(&base) ?? return None
            inner_t :: if bt == {
                .Option(inner) -> inner
                other -> {
                    &self.diags.push(Diagnostic.error("E0047", "`?.` needs an optional on the left, but this is `{other.show()}`", "optional chaining short-circuits a `T?` to absent on a missing link", "use plain `.` here, or make the value optional first", Val(member_span)))
                    return None
                }
            }
            fty :: &self.field_type(inner_t, member, member_span) ?? return None
            if fty == { .Option(x) -> { flatten = true; Val(Type.Option(x)) }; t -> Val(Type.Option(t)) }
        } else { panic("matched OptField") }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5215
    fn infer_inner_method_call(self: &Self, e: &Expr) -> Type? Never! {
        if e == .MethodCall(receiver, method, method_span, owner_type_args, type_args, args, recv_type, resolved_ret, _, _) {
            if receiver == .Ident(name, _) && name.is_empty() {
                resolved :: if self.expected_type == {
                    .Val(.Named(name)) -> Val((name, []))
                    .Val(.Apply(name, args)) -> Val((name, args))
                    .Val(.Shared(inner)) -> Val(("Shared", [inner]))
                    .Val(.List(inner)) -> Val(("List", [inner]))
                    .Val(.Map(key, value, _)) -> Val(("Map", [key, value]))
                    .Val(.Int) -> Val(("Int", []))
                    .Val(.Float) -> Val(("Float", []))
                    .Val(.Bool) -> Val(("Bool", []))
                    .Val(.String) -> Val(("String", []))
                    .Val(.Char) -> Val(("Char", []))
                    .Val(.IntN(signed, bits)) -> Val((int_spelling(signed, bits), []))
                    .Val(.Float32) -> Val(("F32", []))
                    .Val(.Tagged(inner, _)) -> if inner == { .Named(name) -> Val((name, [])); .Apply(name, args) -> Val((name, args)); else -> None }
                    else -> None
                }
                (type_name, expected_args) :: resolved ?? {
                    loop arg in &args -> _ :: &self.infer(&arg.expr)
                    &self.diags.push(Diagnostic.error("E0356", "`.new(...)` needs one known receiver type here", "the inferred constructor uses the surrounding expected type; Jet does not search a global constructor registry", "add a type annotation or write the full `Type.new(...)` form", Val(method_span)))
                    return None
                }
                receiver = Expr.Ident(type_name, receiver.span())
                if owner_type_args.is_empty() -> owner_type_args = expected_args
            }
            if method == "push" || method == "insert" || method == "add" || method == "add_new" -> &self.record_memory_event(MemoryEvent.new(MemoryEventKind.Allocation, method_span, "`.{method}` may allocate to grow backing storage"))
            if recv_type == None && type_args.is_empty() && args.all(fn(a) { a.label == None }) {
                if self.fold_enum_variant_path(receiver) == .Val((type_name, prefix)) {
                    variant :: if prefix.is_empty() { method } else { "{prefix}.{method}" }
                    span :: Span.new(receiver.span().start, (args.last().map(fn(a) { a.span.end }) ?? method_span.end).max(method_span.end))
                    enum_args := (^args).map(fn(a) { EnumLitArg.Positional(^a.expr) }).to_array()
                    args = []
                    ty :: &self.check_enum_lit(type_name, variant, &enum_args, span, None)
                    e = Expr.EnumLit(type_name, variant, None, ^enum_args, false, span)
                    return Val(ty)
                }
            }
            fixed_uninit := []
            if method == "over" && receiver == .Field(_, name, _) && name == "Fixed" {
                loop arg in args {
                    if arg.expr == .Ident(name, _) && self.flow.uninit.get(name) == .Val(state) -> &fixed_uninit.push((name, state.clone()))
                }
            }
            if fixed_uninit.is_empty() { &self.clear_uninit_mut_args(&args) } else {
                loop (name, _) in fixed_uninit -> _ :: &self.flow.uninit.remove(name)
            }
            &self.begin_receiver_mark(&receiver)
            inferred :: &self.infer_method_call(&receiver, method, method_span, &owner_type_args, &type_args, &args, &recv_type, &resolved_ret)
            &self.finish_receiver_mark(&receiver)
            loop (name, state) in fixed_uninit -> &self.flow.uninit.set(name, ^state)
            if self.process_args_view_edit(receiver, method, method_span, args, inferred) == .Val(edit) -> &self.diags.push(Diagnostic.from_row("L0515", [], Val(method_span)).with_edit(edit))
            if self.message_text_edit(receiver, method, method_span, args, recv_type) == .Val(edit) -> &self.diags.push(Diagnostic.from_row("L0516", [], Val(method_span)).with_edit(edit))
            if self.unit_scalar_rewrap_edit(receiver, method, method_span, args, inferred) == .Val(edit) -> &self.diags.push(Diagnostic.from_row("L0519", [], Val(method_span)).with_edit(edit))
            if method == "replace" && inferred == Val(Type.String) {
                if redundant_fixed_cleanup_edit(self.source, receiver, method_span, args, recv_type) == .Val(edit) -> &self.diags.push(Diagnostic.from_row("L0518", [], Val(method_span)).with_edit(edit))
            }
            if method == "slice" && args.len() == 1 && recv_type == Val(Syntax.TYPE_STRING) && inferred == Val(Type.String) {
                slice_span :: method_span
                base :: ^receiver
                range :: ^args[0].expr
                e = Expr.Slice(^base, Expr.Int(0, slice_span, None, None), Expr.Int(0, slice_span, None, None), Val(^range), slice_span)
            }
            inferred
        } else { panic("matched MethodCall") }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5454
    fn infer_inner_struct_lit(self: &Self, e: &Expr) -> Type? Never! {
        if e == .StructLit(type_name, type_args, import_ns, fields, inferred, span, ..) {
            if !inferred && type_args.is_empty() && import_ns == None {
                if type_name.split_once('.') == .Val((enum_name, variant)) {
                    is_variant :: self.resolve_enum_variants_cloned(enum_name).is_some_and(fn(variants) { variants.contains_key(variant) })
                    if is_variant {
                        args :: (^fields).map(fn((label, _, expr)) { EnumLitArg.Named(label, ^expr) }).to_array()
                        fields = []
                        e = Expr.EnumLit(enum_name, variant, None, ^args, false, span)
                        return &self.infer(&e)
                    }
                }
            }
            if inferred {
                expected := self.expected_type
                loop expected == .Val(.Tagged(inner, _)) -> expected = Val(inner)
                if expected == {
                    .Val(.Named(ctx_name)) -> type_name = ctx_name
                    .Val(.Apply(name, args)) -> { type_name = name; type_args = args }
                    else -> {
                        &self.diags.push(Diagnostic.error("E0119", "`{ … }` needs a known struct type here", "the inferred construction form requires an expected type from the surrounding context (binding annotation, return type, etc.)", "name the type at the value, e.g. `x :: Point{x: 1, y: 2}`, or inside a list `[Point{ … }, { … }]`", Val(span)))
                        loop (_, _, expr) in &fields -> _ :: &self.infer(&expr)
                        return None
                    }
                }
            }
            code_module_type :: import_ns.and_then(fn(namespace) { self.code_modules.get(namespace).map(fn(module) { module_type_name(module, type_name) }) })
            resolved := &self.check_struct_lit(type_name, type_args, import_ns, &fields, span)
            if code_module_type == .Val(canonical) {
                resolved = if resolved == { .Named(_) -> Type.Named(canonical); .Apply(_, args) -> Type.Apply(canonical, args); other -> other }
                type_name = canonical
                import_ns = None
            }
            Val(resolved)
        } else { panic("matched StructLit") }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5560
    fn infer_inner_enum_lit(self: &Self, e: &Expr) -> Type? Never! {
        if e == .EnumLit(type_name, variant, variant_span, args, _, span) {
            if type_name.is_empty() {
                expected := self.expected_type
                loop expected == .Val(.Tagged(inner, _)) -> expected = Val(inner)
                resolved :: expected.and_then(fn(et) {
                    name :: if et == {
                        .Named(n) | .Apply(n, _) -> Val(n)
                        .Option(inner) -> if inner == { .Named(n) -> Val(n); else -> None }
                        .Union(_) -> if self.flat_union_case_owner(et, variant) == { .Val(.Named(n)) | .Val(.Apply(n, _)) -> Val(n); else -> None }
                        else -> None
                    }
                    name.filter(fn(n) { self.resolve_enum_variants_cloned(n) != None })
                })
                if resolved == .Val(tn) { type_name = self.import_qualified_nominal(tn) ?? tn } else {
                    &self.diags.push(Diagnostic.error("E0330", "can't infer the enum type for `.{variant}`", "a leading-dot variant needs a known enum type from context", "add a type annotation, or write the full form `EnumName.{variant}`", Val(span)))
                    return None
                }
            }
            Val(&self.check_enum_lit(type_name, variant, &args, span, variant_span))
        } else { panic("matched EnumLit") }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5621
    fn infer_inner_tainted(self: &Self, e: &Expr) -> Type? Never! {
        if e == .Tainted(inner, tag, span) {
            tag :: tag ?? "Input"
            if !self.tag_is_declared(tag) -> &self.diags.push(undeclared_value_tag(tag, self.closest_declared_tag(tag), span))
            &self.infer(&inner)
        } else { panic("matched Tainted") }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5633
    fn infer_inner_present(self: &Self, e: &Expr) -> Type? Never! {
        if e == .Present(inner, _) {
            expected :: self.expected_type.and_then(fn(ty) { ty.unwrap_option() })
            t :: &self.infer_aggregate_value(&inner, expected) ?? return None
            payload :: if expected == .Val(slot) && self.trait_slot_accepts(slot, t) {
                if slot == { .Named(name) -> Type.TraitObject([name]); trait_value -> trait_value }
            } else { t }
            Val(Type.Option(payload))
        } else { panic("matched Present") }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5651
    fn infer_inner_absent(self: &Self, span: Span) -> Type? Never! {
        if self.expected_type == .Val(expected) && expected.unwrap_option() != None -> return Val(expected)
        &self.diags.push(Diagnostic.error("E0308", "bare `{Syntax.LIT_NULL}` needs a known optional type here", "`{Syntax.LIT_NULL}` only fits where a `T?` is expected (S32)", "add a type annotation, or use `{Syntax.LIT_NULL}` where the type is already known", Val(span)))
        None
    }
