    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5702
    fn infer_inner_reduce_marker(self: &Self, name: String, span: Span) -> Type? Never! {
        &self.diags.push(Diagnostic.error("E2510", "`#{name}` is only valid inside a lane `.reduce(…)`", "a reduce-op marker names the fold operation; it isn't a value on its own", "write `v.reduce(.Add)`, `.Mul`, `.Min`, `.Max`, or `.Avg`", Val(span)))
        None
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5716
    fn infer_inner_no_else(self, e: Expr) -> Type? Never! { None }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5717
    fn infer_inner_todo(self: &Self, e: &Expr) -> Type? Never! {
        ty :: self.expected_type
        if e == .Todo(expected_type, ..) -> expected_type = Val(ty.map(fn(t) { t.name() }) ?? "(unknown)")
        Val(ty ?? Type.Int)
