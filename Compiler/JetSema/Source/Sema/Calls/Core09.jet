    fn infer_inner_ok(self: &Self, e: &Expr) -> Type? Never! { if e == .Ok(inner, span) { &self.infer_ok(&inner, span) } else { panic("matched Ok") } }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5736
    fn infer_inner_err(self: &Self, e: &Expr) -> Type? Never! { if e == .Err(inner, span) { &self.infer_err(&inner, span) } else { panic("matched Err") } }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5737
    fn infer_inner_try(self: &Self, e: &Expr) -> Type? Never! { if e == .Try(inner, span, convert, note) { &self.infer_try(&inner, span, &convert, &note) } else { panic("matched Try") } }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5738
    fn infer_inner_or_fallback(self: &Self, e: &Expr) -> Type? Never! { if e == .OrFallback(value, fallback, span, is_option) { &self.infer_or_fallback(&value, &fallback, span, &is_option) } else { panic("matched OrFallback") } }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5744
    fn infer_inner_lambda(self: &Self, e: &Expr) -> Type? Never! {
        if e == .Lambda(lam) {
            http_handler :: self.expected_type.is_some_and(is_http_handler_type)
            expected :: if self.expected_type == {
                .Val(.Named(name)) -> if name.rsplit('.').next() == Val("HTTPHandler") {
                    Val(Type.Fn([Type.Named("HTTPRequest")], Val(Type.Result(Type.Named("HTTPResponse"), Type.Named("HTTPError"))), None, None, None, None))
                } else { self.expected_type }
                else -> self.expected_type
            }
            saved_http_depth :: self.http_handler_depth
            saved_escapes :: self.lambda_escapes
            if http_handler { self.http_handler_depth += 1; self.lambda_escapes = true }
            result :: &self.with_deferred_call_access(fn(checker) { &checker.check_lambda(&lam, expected) })
            self.http_handler_depth = saved_http_depth
            self.lambda_escapes = saved_escapes
            result
        } else { panic("matched Lambda") }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5778
    fn infer_inner_call_value(self: &Self, e: &Expr) -> Type? Never! { if e == .CallValue(callee, args, span) { &self.infer_call_value(&callee, &args, span) } else { panic("matched CallValue") } }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5784
    fn infer_inner_comptime_name(self: &Self, e: &Expr) -> Type? Never! {
        if e == .ComptimeName(name, span, value) {
            if value == .Val(v) -> return Val(v.jet_type())
            if !self.in_comptime {
                if self.current_ct_globals().get(name) == .Val(v) {
                    ty :: self.lookup(name).map(fn(info) { info.ty }).or_else(fn() { self.consts.get(name) }) ?? v.jet_type()
                    value = Val(v)
                    return Val(ty)
                }
                &self.unknown_name(name, span)
            }
            None
        } else { panic("matched ComptimeName") }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/expr.rs:5817
    fn infer_inner_paren(self: &Self, e: &Expr) -> Type? Never! {
        if e == .Paren(first, _) {
            inner := &first
            entered := 0
            loop inner == .Paren(next, _) {
                if !&self.enter_source_nesting(inner.span()) {
                    loop _ in 0..<entered -> &self.leave_source_nesting()
                    return None
                }
                entered += 1
                inner = &next
            }
            result :: &self.infer(inner)
            loop _ in 0..<entered -> &self.leave_source_nesting()
            result
        } else { panic("matched Paren") }
    }
