// Canonical call binding over the shared AST/Type contract.
//
// Name and overload resolution stay with the enclosing Sema checker. This
// file receives the already selected callable signature and owns only the
// argument shape: labels, zones, defaults, rest arguments, source order, and
// the declaration access convention. A Type-derived default is represented by
// its FunctionDefaultRef; this layer never invents an expression for it.

pub struct SemaCallParam {
    pub label: String
    pub name: String
    pub zone: ParamZone
    pub default: Expr?
    pub default_ref: FunctionDefaultRef?
    pub convention: AccessConvention
    pub ty: Type?
    pub variadic: Bool
}

pub enum SemaCallArgSource {
    Written(index: Int)
    Default(parameter: Int)
}

pub enum SemaCallConventionDecision {
    Accepted
    NeedsImplicitClone
    RequiresWrite
    RejectsMove
}

pub struct SemaCallBinding {
    // One entry per written source argument. The value is the explicit
    // parameter slot, or -1 only for an argument that has no slot after an
    // arity failure is recovered by the caller.
    pub slots: [Int]
    // Declaration/output order. Written indices always refer to the original
    // source argument list, never to the rewritten list.
    pub sources: [SemaCallArgSource]
    // Defaults carried by Type.Fn but not materializable in this layer. The
    // owner_key/source_file/span identity is kept intact for a later resolver.
    pub default_refs: [FunctionDefaultRef]
    // True when the result's written values can be evaluated left-to-right
    // without compiler temporaries: written source indices are increasing and
    // every supplied value precedes every default.
    pub source_ordered: Bool
    // True when args was changed to declaration order or a concrete default
    // was inserted. Unresolved metadata defaults intentionally keep args in
    // source order and set this false.
    pub rewrote: Bool
}

fn sema_call_param_optional(param: SemaCallParam) -> Bool {
    param.variadic || param.default != None || param.default_ref != None
}

fn sema_call_param_label(param: Param) -> String {
    param.public_label.map((label) -> label.name) ?? param.name
}

pub fn sema_call_params_from_func(func: Func) -> [SemaCallParam] {
    params :: loop parameter in func.params -> {
        effective_ty :: type_with_effective_fn_returns(parameter.ty)
        parameter_ty :: if parameter.variadic -> Type.List{element: effective_ty} else -> effective_ty
        SemaCallParam{
            label: sema_call_param_label(parameter),
            name: parameter.name,
            zone: parameter.zone,
            default: parameter.default,
            default_ref: None,
            convention: parameter.convention,
            ty: Val(parameter_ty),
            variadic: parameter.variadic,
        }
    }
    params
}

fn sema_call_fn_param_label(contract: [CallContractRow]?, metadata: FunctionCallMetadata?, index: Int, fallback_name: Bool) -> String {
    if contract == .Val(rows) {
        if index >= 0 && index < rows.len() && rows[index].label != "" -> return rows[index].label
        // An explicitly present contract with an empty label is the
        // unlabelled function-value ABI. Do not fall through to metadata's
        // local declaration name and accidentally make it public.
        return ""
    }
    if fallback_name && metadata == .Val(row) {
        if index >= 0 && index < row.names.len() -> return row.names[index]
    }
    ""
}

fn sema_call_fn_param_name(contract: [CallContractRow]?, metadata: FunctionCallMetadata?, index: Int) -> String {
    if metadata == .Val(row) {
        if index >= 0 && index < row.names.len() -> return row.names[index]
    }
    if contract == .Val(rows) {
        if index >= 0 && index < rows.len() -> return rows[index].label
    }
    ""
}

fn sema_call_fn_param_zone(contract: [CallContractRow]?, index: Int) -> ParamZone {
    if contract == .Val(rows) {
        if index >= 0 && index < rows.len() -> return rows[index].zone
    }
    ParamZone.Either
}

fn sema_call_fn_param_default(metadata: FunctionCallMetadata?, index: Int) -> FunctionDefaultRef? {
    row :: metadata ?? return None
    if index < 0 || index >= row.defaults.len() -> None else -> row.defaults[index]
}

fn sema_call_fn_param_variadic(metadata: FunctionCallMetadata?, index: Int) -> Bool {
    row :: metadata ?? return false
    if index < 0 || index >= row.variadic.len() -> false else -> row.variadic[index]
}

fn sema_call_fn_param_convention(metadata: FunctionCallMetadata?, index: Int) -> AccessConvention {
    row :: metadata ?? return AccessConvention.Read
    if index < 0 || index >= row.conventions.len() -> AccessConvention.Read else -> row.conventions[index]
}

fn sema_call_params_from_type_range(ty: Type, offset: Int, fallback_name: Bool) -> [SemaCallParam]? {
    if offset < 0 -> return None
    if ty == {
        .Fn(params, _, _, contract, metadata, _) -> {
            if offset > params.len() -> return None
            result := [SemaCallParam]{}
            loop index in offset..<params.len() {
                parameter_ty :: params[index]
                &result.push(SemaCallParam{
                    label: sema_call_fn_param_label(contract, metadata, index, fallback_name),
                    name: sema_call_fn_param_name(contract, metadata, index),
                    zone: sema_call_fn_param_zone(contract, index),
                    default: None,
                    default_ref: sema_call_fn_param_default(metadata, index),
                    convention: sema_call_fn_param_convention(metadata, index),
                    ty: Val(parameter_ty),
                    variadic: sema_call_fn_param_variadic(metadata, index),
                })
            }
            Val(result)
        }
        else -> None
    }
}

pub fn sema_call_params_from_type(ty: Type) -> [SemaCallParam]? {
    sema_call_params_from_type_range(ty, 0, true)
}

pub fn sema_call_params_from_value_type(ty: Type) -> [SemaCallParam]? {
    sema_call_params_from_type_range(ty, 0, false)
}

pub fn sema_call_params_from_type_after(ty: Type, offset: Int) -> [SemaCallParam]? {
    sema_call_params_from_type_range(ty, offset, true)
}

pub fn sema_call_params_from_value_type_after(ty: Type, offset: Int) -> [SemaCallParam]? {
    sema_call_params_from_type_range(ty, offset, false)
}

fn sema_call_diag_unknown_label(callee: String, label: String, params: [SemaCallParam], span: Span) -> Diagnostic {
    accepted := [String]{}
    loop parameter in params {
        if parameter.zone != ParamZone.PositionalOnly && parameter.label != "" {
            already :: loop existing in accepted {
                if existing == parameter.label -> break true
            } ?? false
            if !already -> &accepted.push(parameter.label)
        }
    }
    fix :: if accepted.len() > 0 -> "`{callee}` accepts `{accepted.join("`, `")}`" else -> "`{callee}` takes no labelled arguments"
    sema_error(
        "E0764",
        span,
        "`{callee}` has no parameter labelled `{label}`",
        "a label binds an argument to the parameter of that name",
        fix,
    )
}

fn sema_call_diag_repeated_label(callee: String, label: String, span: Span) -> Diagnostic {
    sema_error("E0765", span, "`{label}:` is written twice in this call to `{callee}`", "each parameter takes exactly one argument", "remove one of the `{label}:` arguments")
}

fn sema_call_diag_missing(callee: String, label: String, span: Span) -> Diagnostic {
    sema_error("E0766", span, "this call to `{callee}` is missing `{label}`", "`{label}` has no default, so every call has to supply it", "add `{label}: …` to the call")
}

fn sema_call_diag_forbidden_label(callee: String, label: String, span: Span) -> Diagnostic {
    sema_error("E0767", span, "`{label}` is a positional-only parameter of `{callee}`", "the `/` in the declaration keeps these parameters positional, so their names stay free to change", "drop the `{label}:` label and pass the value by position")
}

fn sema_call_diag_ambiguous_positional(callee: String, span: Span) -> Diagnostic {
    sema_error("E0768", span, "this argument to `{callee}` follows a labelled one without a label", "labels bind by name, so a bare argument after one has no parameter to fill", "label this argument, or move it before the labelled ones")
}

fn sema_call_diag_required_label(callee: String, label: String, span: Span) -> Diagnostic {
    sema_error("E0769", span, "`{label}` is a label-only parameter of `{callee}`", "the `*` in the declaration requires the label, so the call says what the value means", "write `{label}: …` for this argument")
}

pub fn sema_call_arity_diagnostic(callee: String, expected: Int, actual: Int, variadic: Bool, span: Span) -> Diagnostic {
    if {
        variadic -> sema_error("E0104", span, "`{callee}` expects at least {expected} argument{if expected == 1 -> "" else -> "s"}, got {actual}", "every fixed parameter must receive a value before the variadic tail", "check how many values this function expects")
        else -> sema_error("E0104", span, "`{callee}` expects {expected} argument{if expected == 1 -> "" else -> "s"}, got {actual}", "every argument must match a parameter", "check how many values this function expects")
    }
}

fn sema_call_diag_spread(callee: String, span: Span) -> Diagnostic {
    sema_error("E1312", span, "`{callee}` doesn't accept a spread argument", "call spread `f(...xs)` only works when the callee has a final variadic parameter", "pass arguments individually, or call a function whose last parameter is variadic")
}

fn sema_call_param_index(params: [SemaCallParam], label: String) -> Int {
    loop (index, param) in params {
        if param.label == label -> return index
    }
    -1
}

fn sema_call_source_ordered(sources: [SemaCallArgSource]) -> Bool {
    last := -1
    saw_default := false
    loop source in sources {
        if source == {
            .Written(source_index) -> {
                if saw_default || source_index < last -> return false
                last = source_index
            }
            .Default(_) -> saw_default = true
        }
    }
    true
}

fn sema_call_default_refs(params: [SemaCallParam], sources: [SemaCallArgSource]) -> [FunctionDefaultRef] {
    refs := [FunctionDefaultRef]{}
    loop source in sources {
        if source == {
            .Default(parameter) -> {
                if parameter >= 0 && parameter < params.len() && params[parameter].default_ref == .Val(default_ref) -> &refs.push(default_ref)
            }
            else -> {}
        }
    }
    refs
}

fn sema_call_append_rewritten_written(taken: &[CallArg?], rewritten: &[CallArg], sources: &[SemaCallArgSource], original_index: Int, parameter: Int, params: [SemaCallParam], call_span: Span) {
    written :: taken[original_index] ?? return
    taken[original_index] = None
    &rewritten.push(sema_call_mark_written(written, original_index, parameter, params[parameter], call_span))
    &sources.push(SemaCallArgSource.Written{index: original_index})
}

fn sema_call_append_rewritten_default(rewritten: &[CallArg], sources: &[SemaCallArgSource], default_arg: CallArg?, parameter: Int) {
    default_value :: default_arg ?? return
    &rewritten.push(default_value)
    &sources.push(SemaCallArgSource.Default{parameter: parameter})
}

fn sema_call_append_rewritten_default_ref(default_refs: &[FunctionDefaultRef], sources: &[SemaCallArgSource], default_ref: FunctionDefaultRef?, parameter: Int) {
    value :: default_ref ?? return
    &default_refs.push(value)
    &sources.push(SemaCallArgSource.Default{parameter: parameter})
}

fn sema_call_append_remaining_written(taken: &[CallArg?], rewritten: &[CallArg], sources: &[SemaCallArgSource], source_index: Int) {
    written :: taken[source_index] ?? return
    &rewritten.push(written)
    &sources.push(SemaCallArgSource.Written{index: source_index})
}

fn sema_call_mark_written(arg: CallArg, source_index: Int, parameter: Int, param: SemaCallParam, call_span: Span) -> CallArg {
    value := arg
    value.flags.source_index = Val(source_index)
    value.flags.binder_slot = Val(parameter)
    value.flags.binder_site = Val(call_span.start)
    value.flags.binder_label = Val(param.label)
    value
}

fn sema_call_make_default_arg(param: SemaCallParam, parameter: Int, params: [SemaCallParam], call_span: Span) -> CallArg? {
    default_expr :: param.default ?? return None
    flags := ast_empty_call_arg_flags()
    flags.binder_slot = Val(parameter)
    flags.binder_site = Val(call_span.start)
    refs := [BinderRef]{}
    loop earlier in 0..<parameter {
        if params[earlier].ty == .Val(ty) -> &refs.push(BinderRef{name: params[earlier].name, slot: earlier, ty: ty})
    }
    flags.binder_refs = refs
    Val(CallArg{convention: param.convention, expr: default_expr, span: call_span, flags: flags, label: None, spread: false})
}

fn sema_call_rewrite_args(params: [SemaCallParam], args: &[CallArg], slots: [[Int]], call_span: Span) -> SemaCallBinding {
    // Copy the source list into optional cells so each written expression is
    // moved at most once. This preserves its original source index even when
    // labels reorder the declaration slots.
    taken := [CallArg?]{}
    loop arg in args -> &taken.push(Val(arg))
    rewritten := [CallArg]{}
    sources := [SemaCallArgSource]{}
    default_refs := [FunctionDefaultRef]{}
    loop position in 0..<params.len() {
        bound_indices :: slots[position]
        if {
            bound_indices.len() > 0 -> {
                loop original_index in bound_indices -> sema_call_append_rewritten_written(&taken, &rewritten, &sources, original_index, position, params, call_span)
            }
            else -> {
                default_arg := sema_call_make_default_arg(params[position], position, params, call_span)
                if {
                    default_arg != None -> sema_call_append_rewritten_default(&rewritten, &sources, default_arg, position)
                    params[position].default_ref != None -> sema_call_append_rewritten_default_ref(&default_refs, &sources, params[position].default_ref, position)
                    else -> {}
                }
            }
        }
    }
    // Preserve arguments outside the selected declaration shape for caller
    // recovery; they remain written expressions, never fabricated defaults.
    loop source_index in 0..<taken.len() {
        if taken[source_index] != None -> sema_call_append_remaining_written(&taken, &rewritten, &sources, source_index)
    }
    loop args.len() > 0 -> _ := &args.pop()
    loop arg in rewritten -> &args.push(arg)
    SemaCallBinding{slots: [Int]{}, sources: sources, default_refs: default_refs, source_ordered: sema_call_source_ordered(sources), rewrote: false}
}

pub fn sema_call_bind_args(callee: String, params: [SemaCallParam], args: &[CallArg], call_span: Span, diagnostics: &[Diagnostic]) -> SemaCallBinding? {
    slots := [[Int]]{}
    loop _ in params -> &slots.push([Int]{})
    source_slots := [Int]{}
    loop _ in args -> &source_slots.push(-1)

    next_positional := 0
    saw_label := false
    failed := false
    ambiguous_reported := false
    loop source_index in 0..<args.len() {
        arg :: args[source_index]
        parameter_index := -1
        skip_arg := false
        if {
            arg.label == None -> {
                if saw_label {
                    if !ambiguous_reported {
                        &diagnostics.push(sema_call_diag_ambiguous_positional(callee, arg.span))
                        ambiguous_reported = true
                    }
                    failed = true
                    skip_arg = true
                }
                if !skip_arg {
                    loop next_positional < params.len() && !params[next_positional].variadic && slots[next_positional].len() > 0 {
                        next_positional += 1
                    }
                    if next_positional >= params.len() -> skip_arg = true
                }
                if !skip_arg {
                    parameter_index = next_positional
                    if params[parameter_index].zone == ParamZone.LabelOnly {
                        &diagnostics.push(sema_call_diag_required_label(callee, params[parameter_index].label, arg.span))
                        failed = true
                        if !params[parameter_index].variadic -> next_positional += 1
                        skip_arg = true
                    }
                    if !skip_arg && !params[parameter_index].variadic -> next_positional += 1
                }
            }
            else -> {
                saw_label = true
                label :: (arg.label ?? CallLabel{name: "", span: arg.span}).name
                parameter_index = sema_call_param_index(params, label)
                if parameter_index < 0 {
                    label_span :: (arg.label ?? CallLabel{name: label, span: arg.span}).span
                    &diagnostics.push(sema_call_diag_unknown_label(callee, label, params, label_span))
                    failed = true
                    skip_arg = true
                }
                if !skip_arg && params[parameter_index].zone == ParamZone.PositionalOnly {
                    label_span :: (arg.label ?? CallLabel{name: label, span: arg.span}).span
                    &diagnostics.push(sema_call_diag_forbidden_label(callee, label, label_span))
                    failed = true
                    skip_arg = true
                }
                if !skip_arg && slots[parameter_index].len() > 0 {
                    label_span :: (arg.label ?? CallLabel{name: label, span: arg.span}).span
                    &diagnostics.push(sema_call_diag_repeated_label(callee, label, label_span))
                    failed = true
                    skip_arg = true
                }
            }
        }
        if !skip_arg && parameter_index >= 0 {
            if arg.spread && !params[parameter_index].variadic {
                &diagnostics.push(sema_call_diag_spread(callee, arg.span))
                failed = true
            }
            &slots[parameter_index].push(source_index)
            source_slots[source_index] = parameter_index
        }
    }
    if failed -> return None

    missing := [Int]{}
    loop (parameter_index, param) in params {
        if slots[parameter_index].len() == 0 && !sema_call_param_optional(param) {
            &missing.push(parameter_index)
        }
    }
    if missing.len() > 0 {
        if !saw_label {
            positional_recovery := true
            index := 0
            loop index < missing.len() {
                if params[missing[index]].zone == ParamZone.LabelOnly -> positional_recovery = false
                index += 1
            }
            if positional_recovery {
                sources := [SemaCallArgSource]{}
                loop index in 0..<args.len() -> &sources.push(SemaCallArgSource.Written{index: index})
                return Val(SemaCallBinding{slots: source_slots, sources: sources, default_refs: [FunctionDefaultRef]{}, source_ordered: true, rewrote: false})
            }
        }
        loop parameter in missing -> &diagnostics.push(sema_call_diag_missing(callee, params[parameter].label, call_span))
        return None
    }

    unresolved :: loop (parameter_index, param) in params {
        if slots[parameter_index].len() == 0 && param.default_ref != None && param.default == None -> break true
    } ?? false
    if unresolved {
        sources := [SemaCallArgSource]{}
        loop (parameter_index, param) in params {
            loop written_index in slots[parameter_index] -> &sources.push(SemaCallArgSource.Written{index: written_index})
            if slots[parameter_index].len() == 0 && param.default_ref != None -> &sources.push(SemaCallArgSource.Default{parameter: parameter_index})
        }
        refs :: sema_call_default_refs(params, sources)
        return Val(SemaCallBinding{slots: source_slots, sources: sources, default_refs: refs, source_ordered: sema_call_source_ordered(sources), rewrote: false})
    }

    // Rewrite only after all shape diagnostics have passed. This guarantees
    // that a failed bind leaves the caller's source AST untouched.
    binding := sema_call_rewrite_args(params, args, slots, call_span)
    binding.slots = source_slots
    binding.rewrote = false
    if binding.sources.len() != args.len() -> binding.rewrote = true
    if args.len() != source_slots.len() -> binding.rewrote = true
    loop index in 0..<args.len() {
        if index >= source_slots.len() || source_slots[index] != index -> binding.rewrote = true
    }
    if binding.sources.len() > source_slots.len() -> binding.rewrote = true
    binding
}

pub fn sema_call_bind_signature(callee: String, signature: Type, parameter_offset: Int, args: &[CallArg], call_span: Span, diagnostics: &[Diagnostic]) -> SemaCallBinding? {
    params :: sema_call_params_from_type_after(signature, parameter_offset) ?? return None
    sema_call_bind_args(callee, params, args, call_span, &diagnostics)
}

pub fn sema_call_bind_direct(callee: String, signature: Type, args: &[CallArg], call_span: Span, diagnostics: &[Diagnostic]) -> SemaCallBinding? {
    sema_call_bind_signature(callee, signature, 0, args, call_span, &diagnostics)
}

pub fn sema_call_bind_value(signature: Type, args: &[CallArg], call_span: Span, diagnostics: &[Diagnostic]) -> SemaCallBinding? {
    params :: sema_call_params_from_value_type(signature) ?? return None
    sema_call_bind_args("this function value", params, args, call_span, &diagnostics)
}

pub fn sema_call_bind_method(method: String, signature: Type, receiver_offset: Int, args: &[CallArg], call_span: Span, diagnostics: &[Diagnostic]) -> SemaCallBinding? {
    sema_call_bind_signature(method, signature, receiver_offset, args, call_span, &diagnostics)
}

pub fn sema_call_binding_has_default_refs(binding: SemaCallBinding) -> Bool {
    binding.default_refs.len() > 0
}

pub fn sema_call_binding_slot(binding: SemaCallBinding, source_index: Int, arg: CallArg) -> Int {
    if arg.flags.binder_slot == .Val(slot) -> return slot
    if source_index >= 0 && source_index < binding.slots.len() -> binding.slots[source_index] else -> -1
}

pub fn sema_call_argument_convention(param: SemaCallParam, arg: CallArg) -> SemaCallConventionDecision {
    if {
        param.convention == AccessConvention.Write && arg.convention != AccessConvention.Write -> SemaCallConventionDecision.RequiresWrite
        param.convention == AccessConvention.Read && arg.convention == AccessConvention.Move -> SemaCallConventionDecision.RejectsMove
        param.convention == AccessConvention.Move && arg.convention == AccessConvention.Read -> SemaCallConventionDecision.NeedsImplicitClone
        else -> SemaCallConventionDecision.Accepted
    }
}

pub fn sema_call_parameter_type(param: SemaCallParam) -> Type? {
    ty :: param.ty ?? return None
    if !param.variadic -> return Val(ty)
    if ty == {
        .List(element) -> Val(element)
        else -> None
    }
}

pub fn sema_call_method_receiver_type(signature: Type, receiver_offset: Int) -> Type? {
    if receiver_offset <= 0 -> return None
    if signature == {
        .Fn(params, _, _, _, _, _) -> {
            receiver_index :: receiver_offset - 1
            if receiver_index < 0 || receiver_index >= params.len() -> return None
            Val(params[receiver_index])
        }
        else -> None
    }
}

pub fn sema_call_method_receiver_convention(signature: Type, receiver_offset: Int) -> AccessConvention? {
    if receiver_offset <= 0 -> return None
    if signature == {
        .Fn(_, _, _, _, metadata, _) -> {
            metadata_value :: metadata ?? return None
            if receiver_offset - 1 < 0 || receiver_offset - 1 >= metadata_value.conventions.len() -> return None
            Val(metadata_value.conventions[receiver_offset - 1])
        }
        else -> None
    }
}
