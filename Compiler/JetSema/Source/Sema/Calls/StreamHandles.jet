// Source semantic producers for filesystem, terminal, encoding, binary-reader,
// cursor, and Path handle operations. The backend owns the fixed ABI routes;
// this module checks their public types, ownership, and effects.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    NodeKind,
    ParamZone,
    Span,
    Symbol,
    SymbolKind,
    TDeclarationOwnership,
    TFieldRef,
    TForInMethod,
    TMethodRef,
    Type,
    core_source_owns_type,
    symbol_id,
    ast_empty_call_arg_flags,
    expr_span,
]

SemaStreamHandleSpec: struct {
    operation: THandleOp
    result_type: Type
    params: [SemaCallParam]
    receiver_convention: AccessConvention
    effect_name: String
}

sema_stream_handle_param: fn(name: String, ty: Type, convention: AccessConvention) -> SemaCallParam Never! {
    SemaCallParam{
        label: name,
        name: name,
        zone: ParamZone.PositionalOnly,
        default: None,
        default_ref: None,
        convention: convention,
        ty: Val(ty),
        variadic: false,
    }
}

sema_stream_handle_owner: fn(ty: Type) -> String? {
    if ty == {
        .Named(name) | .Apply(name, _) -> {
            if core_source_owns_type(name) -> return None
            loop owner in ([String]{"Sender", "Receiver", "MappedFile", "FileScope", "FileReader", "FileWriter", "TempDir", "TempFile", "FileLock", "StdinHandle", "Stdout", "Stderr", "JSONReader", "JSONWriter", "JSONLReader", "JSONLWriter", "CSVReader", "CSVWriter", "XMLReader", "XMLWriter", "CBORReader", "CBORWriter", "Reader", "Cursor", "Path"}) {
                // The built-in `Path` has no declaring module: a canonical
                // `<module>::Path` is a different record (`core.files.path`).
                if name == owner || (owner != "Path" && name.ends_with("::{owner}")) -> return Val(owner)
            }
        }
        else -> {}
    }
    None
}

sema_stream_handle_owner_module: fn(owner: String) -> String Never! {
    if owner == "MappedFile" || owner == "FileScope" || owner == "FileReader" || owner == "FileWriter" || owner == "TempDir" || owner == "TempFile" || owner == "FileLock" -> return "core.files"
    if owner == "StdinHandle" || owner == "Stdout" || owner == "Stderr" || owner == "Reader" -> return "core.term"
    if owner == "JSONReader" || owner == "JSONWriter" -> return "core.encoding.json"
    if owner == "JSONLReader" || owner == "JSONLWriter" -> return "core.encoding.jsonl"
    if owner == "CSVReader" || owner == "CSVWriter" -> return "core.encoding.csv"
    if owner == "XMLReader" || owner == "XMLWriter" -> return "core.encoding.xml"
    if owner == "CBORReader" || owner == "CBORWriter" -> return "core.encoding.cbor"
    if owner == "Cursor" -> return "core.text"
    ""
}

sema_stream_handle_is_canonical: fn(ty: Type, owner: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    actual: sema_stream_handle_owner(ty) ?? return false
    if actual != owner -> return false
    // The channel endpoints are compiler-owned builtins with no declaring
    // module (Concurrency.jet `sema_call_concurrency_is_canonical_sender`):
    // a user nominal of the same name shadows them.
    if owner == "Sender" || owner == "Receiver" {
        if program.registration_graph == .Val(graph) {
            if sema_type_resolve_nominal_row(graph, ty, environment.module_identity) != None -> return false
            fact: sema_registration_core_builtin_owner(graph, owner) ?? return false
            return fact.ownership == TDeclarationOwnership.Owned
        }
        return false
    }
    if program.registration_graph == .Val(graph) {
        resolved: sema_type_graph_lookup_symbol(graph, environment.module_identity, actual)
        if resolved == .Val(row) {
            owner_module := sema_stream_handle_owner_module(owner)
            // A declared or imported type named like a module-less built-in
            // (`Path`) shadows it; the two never share an identity.
            return sema_resolved_kind(graph, row) == SymbolKind.Type && owner_module != "" && (sema_registration_module_name(graph, sema_resolved_module_name(graph, row)) ?? "") == owner_module
        }
        return true
    } else {
        return true
    }
}

// Core's `StdinHandle` is a source-declared record whose only source method is
// `read_line`; its `.lines()` stream stays the handle table's, as for the
// canonical identity of every Core stream handle.
sema_stream_handle_source_lines_owner: fn(ty: Type, method: String) -> String? {
    if method != "lines" -> return None
    if ty == .Named(name) {
        if name.ends_with("::StdinHandle") && core_source_owns_type(name) -> return Val("StdinHandle")
    }
    None
}

sema_stream_handle_result: fn(ok: Type, error: Type) -> Type Never! {
    Type.Result{ok: ok, err: error}
}

sema_stream_handle_io_error: fn() -> Type Never! {
    Type.Named{name: "IOError"}
}

sema_stream_handle_encoding_error: fn() -> Type Never! {
    Type.Named{name: "EncodingError"}
}

// `effect_name` is Rust's exact handle-method row: records only
// `receiver_effect_leaf` (`Time.Wait` on the blocking file, stdout and channel
// methods) for these receivers. Authority is checked where the handle is
// acquired (`files.open`, `term.stdout`), not on each method.
sema_stream_handle_spec: fn(owner: String, method: String, receiver_type: Type) -> SemaStreamHandleSpec? {
    unit := Type.Named{name: "Unit"}
    string := Type.String
    io := sema_stream_handle_io_error()
    encoding := sema_stream_handle_encoding_error()
    u8 := Type.IntN{signed: false, bits: 8}
    bytes := Type.List{element: u8}
    if owner == "Sender" || owner == "Receiver" {
        element: if receiver_type == {
            .Apply(_, type_args) -> if type_args.len() == 1 -> type_args[0] else -> Type.Int
            else -> Type.Int
        }
        if method == "close" -> return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelClose, result_type: unit, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        // `Sender.send` is Concurrency.jet's route (payload crossing checks).
        if owner == "Sender" -> return None
        if method == "receive" -> return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelReceive, result_type: Type.Result{ok: element, err: Type.Named{name: "Closed"}}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: "Time.Wait"})
        if method == "try_receive" -> return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelTryReceive, result_type: Type.Option{inner: element}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "is_timer" -> return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelIsTimer, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "is_interval" -> return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelIsInterval, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "is_cancelled" -> return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelIsCancelled, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "is_ready" -> return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelIsReady, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "delay_ms" -> return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelDelayMs, result_type: Type.Int, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        return None
    }
    if owner == "MappedFile" {
        if method == "window" -> return Val(SemaStreamHandleSpec{operation: THandleOp.MappedFileWindow, result_type: sema_stream_handle_result(Type.Apply{name: "View", args: [Type]{u8}}, io), params: [SemaCallParam]{sema_stream_handle_param("start", Type.Int, AccessConvention.Read), sema_stream_handle_param("end", Type.Int, AccessConvention.Read)}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "window_len" -> return Val(SemaStreamHandleSpec{operation: THandleOp.MappedFileWindowLen, result_type: sema_stream_handle_result(Type.Apply{name: "View", args: [Type]{u8}}, io), params: [SemaCallParam]{sema_stream_handle_param("offset", Type.Int, AccessConvention.Read), sema_stream_handle_param("length", Type.Int, AccessConvention.Read)}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "lines" -> return Val(SemaStreamHandleSpec{operation: THandleOp.MappedFileLines, result_type: Type.Apply{name: "ViewIter", args: [Type]{Type.Apply{name: "View", args: [Type]{u8}}}}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "len" -> return Val(SemaStreamHandleSpec{operation: THandleOp.MappedFileLen, result_type: Type.Int, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "is_empty" -> return Val(SemaStreamHandleSpec{operation: THandleOp.MappedFileIsEmpty, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
    }
    if owner == "FileReader" {
        if method == "read_line" -> return Val(SemaStreamHandleSpec{operation: THandleOp.FileReaderReadLine, result_type: sema_stream_handle_result(Type.Option{inner: string}, io), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: "Time.Wait"})
        if method == "read" -> return Val(SemaStreamHandleSpec{operation: THandleOp.FileReaderRead{into: false}, result_type: sema_stream_handle_result(bytes, io), params: [SemaCallParam]{sema_stream_handle_param("max", Type.Int, AccessConvention.Read)}, receiver_convention: AccessConvention.Write, effect_name: "Time.Wait"})
        if method == "read_into" -> return Val(SemaStreamHandleSpec{operation: THandleOp.FileReaderRead{into: true}, result_type: sema_stream_handle_result(Type.Int, io), params: [SemaCallParam]{sema_stream_handle_param("buffer", bytes, AccessConvention.Write), sema_stream_handle_param("limit", Type.Int, AccessConvention.Read)}, receiver_convention: AccessConvention.Write, effect_name: "Time.Wait"})
        if method == "seek" -> return Val(SemaStreamHandleSpec{operation: THandleOp.FileReaderSeek, result_type: sema_stream_handle_result(unit, io), params: [SemaCallParam]{sema_stream_handle_param("position", Type.Int, AccessConvention.Read)}, receiver_convention: AccessConvention.Write, effect_name: "Time.Wait"})
    }
    if owner == "FileWriter" {
        if method == "write_line" -> return Val(SemaStreamHandleSpec{operation: THandleOp.FileWriterWriteLine, result_type: sema_stream_handle_result(unit, io), params: [SemaCallParam]{sema_stream_handle_param("text", string, AccessConvention.Read)}, receiver_convention: AccessConvention.Write, effect_name: "Time.Wait"})
        if method == "flush" -> return Val(SemaStreamHandleSpec{operation: THandleOp.FileWriterFlush, result_type: sema_stream_handle_result(unit, io), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: "Time.Wait"})
        if method == "write_all" -> return Val(SemaStreamHandleSpec{operation: THandleOp.FileWriterWriteAll, result_type: sema_stream_handle_result(unit, io), params: [SemaCallParam]{sema_stream_handle_param("bytes", bytes, AccessConvention.Read)}, receiver_convention: AccessConvention.Write, effect_name: "Time.Wait"})
        if method == "fsync" -> return Val(SemaStreamHandleSpec{operation: THandleOp.FileWriterFsync, result_type: sema_stream_handle_result(unit, io), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: "Time.Wait"})
    }
    if owner == "StdinHandle" {
        if method == "read_line" -> return Val(SemaStreamHandleSpec{operation: THandleOp.StdinReadLine, result_type: sema_stream_handle_result(Type.Option{inner: string}, io), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: ""})
    }
    if owner == "Stdout" || owner == "Stderr" {
        stdout := owner == "Stdout"
        if method == "write" -> return Val(SemaStreamHandleSpec{operation: if stdout -> THandleOp.StdoutWrite else -> THandleOp.StderrWrite, result_type: sema_stream_handle_result(unit, io), params: [SemaCallParam]{sema_stream_handle_param("text", string, AccessConvention.Read)}, receiver_convention: AccessConvention.Write, effect_name: "Time.Wait"})
        if method == "write_line" -> return Val(SemaStreamHandleSpec{operation: if stdout -> THandleOp.StdoutWriteLine else -> THandleOp.StderrWriteLine, result_type: sema_stream_handle_result(unit, io), params: [SemaCallParam]{sema_stream_handle_param("text", string, AccessConvention.Read)}, receiver_convention: AccessConvention.Write, effect_name: "Time.Wait"})
        if method == "write_bytes" -> return Val(SemaStreamHandleSpec{operation: if stdout -> THandleOp.StdoutWriteBytes else -> THandleOp.StderrWriteBytes, result_type: sema_stream_handle_result(unit, io), params: [SemaCallParam]{sema_stream_handle_param("bytes", bytes, AccessConvention.Read)}, receiver_convention: AccessConvention.Write, effect_name: "Time.Wait"})
        if method == "flush" -> return Val(SemaStreamHandleSpec{operation: if stdout -> THandleOp.StdoutFlush else -> THandleOp.StderrFlush, result_type: sema_stream_handle_result(unit, io), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: "Time.Wait"})
        if method == "is_tty" -> return Val(SemaStreamHandleSpec{operation: if stdout -> THandleOp.StdoutIsTTY else -> THandleOp.StderrIsTTY, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
    }
    if owner == "JSONReader" && method == "next" -> return Val(SemaStreamHandleSpec{operation: THandleOp.JSONReaderNext, result_type: sema_stream_handle_result(Type.Option{inner: Type.Named{name: "DataEvent"}}, encoding), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: ""})
    if owner == "JSONWriter" {
        if method == "write" -> return Val(SemaStreamHandleSpec{operation: THandleOp.JSONWriterWrite, result_type: sema_stream_handle_result(unit, encoding), params: [SemaCallParam]{sema_stream_handle_param("event", Type.Named{name: "DataEvent"}, AccessConvention.Move)}, receiver_convention: AccessConvention.Write, effect_name: ""})
        if method == "flush" -> return Val(SemaStreamHandleSpec{operation: THandleOp.JSONWriterFlush, result_type: sema_stream_handle_result(unit, encoding), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: ""})
        if method == "finish" -> return Val(SemaStreamHandleSpec{operation: THandleOp.JSONWriterFinish, result_type: sema_stream_handle_result(unit, encoding), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: ""})
    }
    if owner == "JSONLReader" && method == "next" -> return Val(SemaStreamHandleSpec{operation: THandleOp.JSONLReaderNext, result_type: sema_stream_handle_result(Type.Option{inner: Type.Named{name: "Dyn"}}, encoding), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: ""})
    if owner == "JSONLWriter" {
        if method == "write" -> return Val(SemaStreamHandleSpec{operation: THandleOp.JSONLWriterWrite, result_type: sema_stream_handle_result(unit, encoding), params: [SemaCallParam]{sema_stream_handle_param("tree", Type.Named{name: "Dyn"}, AccessConvention.Move)}, receiver_convention: AccessConvention.Write, effect_name: ""})
        if method == "flush" -> return Val(SemaStreamHandleSpec{operation: THandleOp.JSONLWriterFlush, result_type: sema_stream_handle_result(unit, encoding), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: ""})
        if method == "finish" -> return Val(SemaStreamHandleSpec{operation: THandleOp.JSONLWriterFinish, result_type: sema_stream_handle_result(unit, encoding), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: ""})
    }
    if owner == "XMLReader" && method == "next" -> return Val(SemaStreamHandleSpec{operation: THandleOp.XMLReaderNext, result_type: sema_stream_handle_result(Type.Option{inner: Type.Named{name: "Dyn"}}, encoding), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: ""})
    if owner == "XMLWriter" {
        if method == "write" -> return Val(SemaStreamHandleSpec{operation: THandleOp.XMLWriterWrite, result_type: sema_stream_handle_result(unit, encoding), params: [SemaCallParam]{sema_stream_handle_param("tree", Type.Named{name: "Dyn"}, AccessConvention.Move)}, receiver_convention: AccessConvention.Write, effect_name: ""})
        if method == "flush" -> return Val(SemaStreamHandleSpec{operation: THandleOp.XMLWriterFlush, result_type: sema_stream_handle_result(unit, encoding), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: ""})
        if method == "finish" -> return Val(SemaStreamHandleSpec{operation: THandleOp.XMLWriterFinish, result_type: sema_stream_handle_result(unit, encoding), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: ""})
    }
    if owner == "CBORReader" && method == "next" -> return Val(SemaStreamHandleSpec{operation: THandleOp.CBORReaderNext, result_type: sema_stream_handle_result(Type.Option{inner: Type.Named{name: "DataEvent"}}, encoding), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: ""})
    if owner == "CBORWriter" {
        if method == "write" -> return Val(SemaStreamHandleSpec{operation: THandleOp.CBORWriterWrite, result_type: sema_stream_handle_result(unit, encoding), params: [SemaCallParam]{sema_stream_handle_param("event", Type.Named{name: "DataEvent"}, AccessConvention.Move)}, receiver_convention: AccessConvention.Write, effect_name: ""})
        if method == "flush" -> return Val(SemaStreamHandleSpec{operation: THandleOp.CBORWriterFlush, result_type: sema_stream_handle_result(unit, encoding), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: ""})
        if method == "finish" -> return Val(SemaStreamHandleSpec{operation: THandleOp.CBORWriterFinish, result_type: sema_stream_handle_result(unit, encoding), params: [SemaCallParam]{}, receiver_convention: AccessConvention.Write, effect_name: ""})
    }
    if owner == "Path" {
        if method == "join" -> return Val(SemaStreamHandleSpec{operation: THandleOp.PathJoin, result_type: Type.Named{name: "Path"}, params: [SemaCallParam]{sema_stream_handle_param("other", string, AccessConvention.Read)}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "parent" -> return Val(SemaStreamHandleSpec{operation: THandleOp.PathParent, result_type: Type.Option{inner: Type.Named{name: "Path"}}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "extension" -> return Val(SemaStreamHandleSpec{operation: THandleOp.PathExtension, result_type: Type.Option{inner: string}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "stem" -> return Val(SemaStreamHandleSpec{operation: THandleOp.PathStem, result_type: Type.Option{inner: string}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "normalize" -> return Val(SemaStreamHandleSpec{operation: THandleOp.PathNormalize, result_type: Type.Named{name: "Path"}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "is_within" -> return Val(SemaStreamHandleSpec{operation: THandleOp.PathIsWithin, result_type: Type.Bool, params: [SemaCallParam]{sema_stream_handle_param("other", Type.Named{name: "Path"}, AccessConvention.Read)}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "to_string" -> return Val(SemaStreamHandleSpec{operation: THandleOp.PathToString, result_type: string, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        if method == "walk" -> return Val(SemaStreamHandleSpec{operation: THandleOp.PathWalk, result_type: Type.List{element: Type.Named{name: "Path"}}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
    }
    // Rust `text_cursor_method_return` / `binary_reader_method_return`: the
    // cursor and reader methods record no receiver write, so a read binding
    // or parameter calls them without a `&` mark.
    if owner == "Cursor" {
        if method == "take_until" -> return Val(sema_stream_handle_read_spec(THandleOp.CursorTakeUntil, sema_stream_handle_result(string, Type.String), [SemaCallParam]{sema_stream_handle_param("delimiter", string, AccessConvention.Read)}))
        if method == "skip_ws" -> return Val(sema_stream_handle_read_spec(THandleOp.CursorSkipWs, unit, [SemaCallParam]{}))
    }
    if owner == "Reader" {
        none: [SemaCallParam]{}
        if method == "read_u8" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU8, sema_stream_handle_result(u8, string), none))
        if method == "read_i8" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI8, sema_stream_handle_result(Type.IntN{signed: true, bits: 8}, string), none))
        if method == "read_u16_le" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU16Le, sema_stream_handle_result(Type.IntN{signed: false, bits: 16}, string), none))
        if method == "read_u16_be" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU16Be, sema_stream_handle_result(Type.IntN{signed: false, bits: 16}, string), none))
        if method == "read_i16_le" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI16Le, sema_stream_handle_result(Type.IntN{signed: true, bits: 16}, string), none))
        if method == "read_i16_be" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI16Be, sema_stream_handle_result(Type.IntN{signed: true, bits: 16}, string), none))
        if method == "read_u32_le" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU32Le, sema_stream_handle_result(Type.IntN{signed: false, bits: 32}, string), none))
        if method == "read_u32_be" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU32Be, sema_stream_handle_result(Type.IntN{signed: false, bits: 32}, string), none))
        if method == "read_i32_le" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI32Le, sema_stream_handle_result(Type.IntN{signed: true, bits: 32}, string), none))
        if method == "read_i32_be" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI32Be, sema_stream_handle_result(Type.IntN{signed: true, bits: 32}, string), none))
        if method == "read_u64_le" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU64Le, sema_stream_handle_result(Type.IntN{signed: false, bits: 64}, string), none))
        if method == "read_u64_be" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU64Be, sema_stream_handle_result(Type.IntN{signed: false, bits: 64}, string), none))
        if method == "read_i64_le" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI64Le, sema_stream_handle_result(Type.IntN{signed: true, bits: 64}, string), none))
        if method == "read_i64_be" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI64Be, sema_stream_handle_result(Type.IntN{signed: true, bits: 64}, string), none))
        if method == "read_f32_le" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadF32Le, sema_stream_handle_result(Type.Float32, string), none))
        if method == "read_f32_be" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadF32Be, sema_stream_handle_result(Type.Float32, string), none))
        if method == "read_f64_le" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadF64Le, sema_stream_handle_result(Type.Float, string), none))
        if method == "read_f64_be" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadF64Be, sema_stream_handle_result(Type.Float, string), none))
        if method == "peek" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderPeek, sema_stream_handle_result(u8, string), none))
        if method == "seek" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderSeek, sema_stream_handle_result(Type.Named{name: "Unit"}, string), [SemaCallParam]{sema_stream_handle_param("offset", Type.Int, AccessConvention.Read)}))
        if method == "skip" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderSkip, sema_stream_handle_result(Type.Named{name: "Unit"}, string), [SemaCallParam]{sema_stream_handle_param("count", Type.Int, AccessConvention.Read)}))
        if method == "take" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderTake, sema_stream_handle_result(bytes, string), [SemaCallParam]{sema_stream_handle_param("count", Type.Int, AccessConvention.Read)}))
        if method == "remaining" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderRemaining, Type.Int, none))
        if method == "is_at_end" -> return Val(sema_stream_handle_read_spec(THandleOp.ReaderAtEnd, Type.Bool, none))
    }
    None
}

sema_stream_handle_read_spec: fn(operation: THandleOp, result_type: Type, params: [SemaCallParam]) -> SemaStreamHandleSpec Never! {
    SemaStreamHandleSpec{operation: operation, result_type: result_type, params: params, receiver_convention: AccessConvention.Read, effect_name: ""}
}

sema_stream_handle_known_wrong_direction: fn(owner: String, method: String) -> Bool Never! {
    (owner == "FileReader" && (method == "write_line" || method == "flush" || method == "write_all" || method == "fsync" || method == "set_mode")) || (owner == "FileWriter" && (method == "lines" || method == "read_line" || method == "read" || method == "read_into"))
}

// Rust `file_handle_method_return` (E2-M7) types the methods of these handles
// without recording a receiver convention, so an unmarked `reader.read(n)` or
// `writer.write_all(bytes)` needs no `&`, and a written mark has no convention
// to be checked against. `text_cursor_method_return` and
// `binary_reader_method_return` record none either, so `c.skip_ws()` and
// `r.take(n)` keep their mark. `Stdout`/`Stderr` dispatch to their `&self`
// source methods instead.
sema_stream_handle_reports_no_receiver_convention: fn(owner: String) -> Bool Never! {
    owner == "MappedFile" || owner == "FileScope" || owner == "FileReader" || owner == "FileWriter" || owner == "StdinHandle" || owner == "Cursor" || owner == "Reader"
}

sema_stream_handle_infer_args: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_stream_handle_effect_fact: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, api: String, span: Span, result_type: Type, effect_name: String, diagnostics: &[Diagnostic]) -> Bool Never! {
    entries := [EffectRowEntry]{}
    if effect_name != "" -> entries.push(EffectRowEntry{name: effect_name, span: span})
    facts := SemaCallFacts{
        return_type: result_type,
        failure_carrier: sema_call_failure_carrier(Val(result_type)),
        effect_bound: Val(entries),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(environment, program, scopes, context, api, span, facts, diagnostics)
}

sema_stream_handle_fixed_list_assignable: fn(required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if required == {
        .List(element) -> if offered == {
            .FixedList(fixed_element, _) -> sema_call_type_assignable(element, fixed_element, environment, program) ?? false
            else -> false
        }
        else -> false
    }
}

sema_stream_handle_integer_width: fn(ty: Type) -> Bool Never! {
    if ty == {
        .IntN(signed, bits) -> return !signed && (bits == 8 || bits == 16 || bits == 32)
        else -> return false
    }
}

// (Rust `check_shift_arg`): a `Reader`/`Cursor` byte-shift argument that does
// not fit its fixed parameter is E0112 about the call; every other handle
// argument is the plain E0108 mismatch.
sema_stream_handle_argument_mismatch: fn(callee: String, required: Type, offered: Type, span: Span) -> Diagnostic {
    shift: callee == "Reader.over" || callee == "Reader.take" || callee == "Reader.seek" || callee == "Reader.skip" || callee == "Cursor.over" || callee == "Cursor.take_until"
    if !shift -> return sema_type_mismatch(required, offered, span)
    sema_error("E0112", span, "`{callee}` wants {sema_type_show(required)}, but this is {sema_type_show(offered)}", "every argument must match its parameter's type", sema_type_fix_hint(required, offered))
}

sema_stream_handle_checked_args: fn(callee: String, params: [SemaCallParam], args: [CallArg], receiver_expr: Expr?, receiver_value: TExpr?, receiver_convention: AccessConvention, shift_argument: Int, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [TExpr]? {
    checked_args := args
    binding: sema_call_bind_args(callee, params, checked_args, span, diagnostics) ?? {
        sema_stream_handle_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    if !sema_call_validate_binding(callee, params, binding, checked_args, span, diagnostics) -> return None
    values := [TExpr]{}
    loop index in 0..<checked_args.len() {
        slot: sema_call_bound_slot(binding, binding.sources[index], checked_args[index])
        if slot < 0 || slot >= params.len() -> return None
        required_declared: sema_call_parameter_type(params[slot]) ?? return None
        required := sema_call_resolved_type(required_declared, environment, program)
        value_start: diagnostics.len()
        value: if shift_argument == index -> sema_check_expression(checked_args[index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_check_expression(checked_args[index].expr, Val(required), environment, program, scopes, state, tail_store, context, diagnostics)
        checked: value ?? {
            // The parameter type is the value's hint: its own E0108 against
            // it becomes the handle call's argument mismatch.
            value_span: expr_span(checked_args[index].expr)
            if sema_value_mismatch_index(diagnostics, value_start, value_span) == .Val(mismatch_index) {
                probe_diagnostics := [Diagnostic]{}
                if sema_probe_expression(checked_args[index].expr, None, environment, program, scopes, state, tail_store, context, probe_diagnostics) == .Val(offered) -> diagnostics[mismatch_index] = sema_stream_handle_argument_mismatch(callee, required, sema_call_resolved_type(offered.ty, environment, program), value_span)
            }
            return None
        }
        if shift_argument == index {
            if checked.ty == .IntN(_, _) {
                // U64 and the signed widths stay explicit (E0112 at the call).
                if !sema_stream_handle_integer_width(checked.ty) {
                    diagnostics.push(sema_stream_handle_argument_mismatch(callee, required, checked.ty, checked_args[index].span))
                    return None
                }
                converted: sema_expr_numeric_conversion(checked, Type.Int, checked.span, sema_source_line_at(environment.source_segments, checked.span) ?? 0) ?? return None
                values.push(converted)
                next
            }
        }
        compatible := sema_call_type_assignable(required_declared, checked.ty, environment, program) ?? false
        if !compatible && sema_stream_handle_fixed_list_assignable(required_declared, checked.ty, environment, program) -> compatible = true
        if !compatible {
            diagnostics.push(sema_stream_handle_argument_mismatch(callee, required, checked.ty, checked_args[index].span))
            return None
        }
        // A `&` argument keeps its Write borrow of the caller's place, so the
        // route writes the original, never a copy (#5976).
        if params[slot].convention == AccessConvention.Write {
            borrow_type: checked.ty.copy()
            borrow_span: checked.span
            values.push(sema_tree_node(borrow_type, TExprKind.Borrow{place: checked, access: AccessConvention.Write}, borrow_span))
            next
        }
        values.push(checked)
    }
    ownership: if receiver_expr == {
        .Val(expr) -> {
            convention := receiver_convention
            if convention == AccessConvention.Write && sema_ownership_places_from_expr_in_state(expr, scopes, state).len() == 0 -> convention = AccessConvention.Read
            sema_ownership_check_handle_method_call(state, callee, expr, convention, params, checked_args, scopes, span, diagnostics)
        }
        .None -> sema_ownership_check_call_arguments(state, callee, params, checked_args, scopes, diagnostics)
    }
    if !ownership.accepted || !ownership.complete -> return None
    Val(values)
}

sema_stream_handle_finish: fn(receiver: TExpr, operation: THandleOp, args: [TExpr], result_type: Type, effect_name: String, api: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    value := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver, operation: operation, args: args}, span)
    checked: sema_expression_call_expected(value, expected, environment, program, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_stream_handle_effect_fact(environment, program, scopes, context, api, span, result_type, effect_name, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}

sema_stream_handle_method_ref: fn(owner: String, method: String) -> TMethodRef Never! {
    owner_module := sema_stream_handle_owner_module(owner)
    TMethodRef{symbol: symbol_id(SymbolKind.Function, owner_module, owner, method), name: method, mangled: false, trait_owner: None, operator_identity: None}
}

sema_stream_handle_lines_value: fn(receiver: TExpr, owner: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    result_type := if owner == "FileReader" -> Type.Named{name: "FileLines"} else -> Type.Named{name: "StdinLines"}
    value := sema_tree_node(result_type, TExprKind.MethodCall{receiver: receiver, method: sema_stream_handle_method_ref(owner, "lines"), type_args: [Type]{}, args: [TCallArg]{}}, span)
    checked: sema_expr_expected(value, expected, environment, program, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    // Rust `receiver_effect_leaf`: `FileReader.lines` waits; `StdinHandle`
    // records no handle effect.
    effect_name := if owner == "FileReader" -> "Time.Wait" else -> ""
    if !sema_stream_handle_effect_fact(environment, program, scopes, context, "{owner}.lines", span, result_type, effect_name, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}

// Called before ordinary method lookup for canonical Core handle types.
sema_call_try_stream_handle_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    source_lines: sema_stream_handle_source_lines_owner(receiver_value.ty, method)
    owner := source_lines ?? ""
    if source_lines == None {
        owner = sema_stream_handle_owner(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
        if !sema_stream_handle_is_canonical(receiver_value.ty, owner, environment, program) -> return SemaMethodSpecialCheck{handled: false, value: None}
    }
    source_member := if owner == "FileScope" && method == "read" -> "scoped_read" else if owner == "FileReader" && method == "read_line" -> "__reader_read_line" else if owner == "Path" && method == "write_atomic" -> "write_atomic" else -> ""
    if source_member != "" {
        identity: sema_call_core_module_identity(environment, program, "core.files") ?? {
            diagnostics.push(sema_error("E0003", span, "filesystem source module is not loaded", "receiver policy requires Core/Files/Files.jet", "load the registered Core source module"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        target: sema_call_core_source_target(environment, program, identity, source_member, [Type]{}, span, true, diagnostics) ?? {
            diagnostics.push(sema_error("E0003", span, "filesystem source receiver target is missing", "receiver policy requires its canonical source function", "load the registered Core source function"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        access: if owner == "FileReader" -> AccessConvention.Write else -> AccessConvention.Read
        source_args := [CallArg]{CallArg{convention: access, expr: receiver, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}}
        loop argument in args -> source_args.push(argument.copy())
        scopes.ownership_call_depth += 1
        value := sema_call_core_check_source_owned(target, "{owner}.{method}", [Type]{}, source_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        scopes.ownership_call_depth -= 1
        return SemaMethodSpecialCheck{handled: true, value: value}
    }
    if (owner == "FileReader" && method == "lines") || (owner == "StdinHandle" && method == "lines") {
        if args.len() != 0 {
            sema_stream_handle_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
            diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", 0, args.len(), false, span))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        _ := sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics)
        if sema_stream_handle_reports_no_receiver_convention(owner) -> sema_receiver_mark_forget(state, receiver)
        return sema_stream_handle_lines_value(receiver_value, owner, span, expected, environment, program, scopes, context, diagnostics)
    }
    if sema_stream_handle_known_wrong_direction(owner, method) {
        sema_stream_handle_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        if {
            owner == "FileReader" -> {
                diagnostics.push(sema_error("E2501", span, "`{method}` is not available on a read-only file handle", "`files.open` returns a read-only handle; it can only read lines or bytes", "use `files.create` or `files.append` to get a writable handle"))
            }
            else -> {
                diagnostics.push(sema_error("E2501", span, "`{method}` is not available on a write-only file handle", "`files.create` returns a write-only handle; it can only write lines", "use `files.open` to get a readable handle"))
            }
        }
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    spec: sema_stream_handle_spec(owner, method, receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != spec.params.len() {
        sema_stream_handle_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", spec.params.len(), args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    shift_argument := if owner == "Reader" && (method == "seek" || method == "skip" || method == "take") -> 0 else -> -1
    checked_args: sema_stream_handle_checked_args("{owner}.{method}", spec.params, args, Val(receiver), receiver_value, spec.receiver_convention, shift_argument, span, environment, program, scopes, state, tail_store, context, diagnostics)
    if sema_stream_handle_reports_no_receiver_convention(owner) -> sema_receiver_mark_forget(state, receiver)
    typed_args: checked_args ?? return SemaMethodSpecialCheck{handled: true, value: None}
    result: sema_stream_handle_finish(receiver_value, spec.operation, typed_args, spec.result_type, spec.effect_name, "{owner}.{method}", span, expected, environment, program, scopes, context, diagnostics)
    if result.value != None && sema_stream_handle_yields_view(spec.result_type) -> sema_stream_handle_publish_receiver_view(receiver, span, scopes, state, context)
    result
}

// `MappedFile.window`/`window_len` return a `View<U8>` into the mapping the
// receiver owns: the call publishes the receiver as the view's owner, the
// same fact a view-returning function call publishes, so a binding of it is
// a local window on that receiver. A receiver that names no place is a
// temporary owner the statement drops.
sema_stream_handle_yields_view: fn(result_type: Type) -> Bool Never! {
    if result_type == {
        .Result(value, _) -> sema_stmt_view_access(value) != None
        else -> sema_stmt_view_access(result_type) != None
    }
}

sema_stream_handle_publish_receiver_view: fn(receiver: Expr, span: Span, scopes: SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext) Never! {
    places: sema_ownership_places_from_expr_in_state(receiver, scopes, state)
    temporaries := [Span]{}
    if places.len() == 0 -> temporaries.push(expr_span(receiver))
    facts: [SemaCallReturnViewFact]{SemaCallReturnViewFact{slot: [String]{}, access: AccessConvention.Read, places: places, sources: [ViewSourcePath]{}, temporaries: temporaries}}
    sema_ownership_note_call_views(state, span, facts)
    context.call_return_views.push(SemaCallReturnView{span: span, facts: facts})
}

sema_stream_handle_static_owner_is_canonical: fn(owner: String, scopes: &SemaScopeTable, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    index: sema_scope_resolve_index(scopes, owner) ?? return true
    symbol: scopes.bindings[index].symbol
    if symbol.kind != SymbolKind.Type -> return false
    owner_module := sema_stream_handle_owner_module(owner)
    if owner_module == "" -> return false
    if program.registration_graph == .Val(graph) {
        return (sema_registration_module_name(graph, symbol.module_name) ?? "") == owner_module
    } else {
        return false
    }
}

// Static reserved constructors. Callers must still prefer a shadowing user type.
sema_call_try_stream_handle_static: fn(owner: String, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    known := (owner == "Path" && (method == "from" || method == "home")) || (owner == "Reader" && method == "over") || (owner == "Cursor" && method == "over")
    if !known || !sema_stream_handle_static_owner_is_canonical(owner, scopes, environment, program) -> return SemaMethodSpecialCheck{handled: false, value: None}
    expected_count := if method == "home" -> 0 else -> 1
    if args.len() != expected_count {
        sema_stream_handle_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", expected_count, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    operation := THandleOp.PathFrom
    result_type := Type.Named{name: "Path"}
    effect_name := ""
    params := [SemaCallParam]{}
    ownership_args := args
    shift_argument := -1
    if owner == "Path" && method == "from" -> params.push(sema_stream_handle_param("path", Type.String, AccessConvention.Read))
    if owner == "Path" && method == "home" {
        operation = THandleOp.PathHome
        effect_name = "FS"
    }
    if owner == "Cursor" {
        operation = THandleOp.CursorOver
        result_type = Type.Named{name: "Cursor"}
        params.push(sema_stream_handle_param("text", Type.String, AccessConvention.Read))
    }
    owned_reader := false
    if owner == "Reader" {
        operation = THandleOp.ReaderOver{owned: false}
        result_type = Type.Named{name: "Reader"}
        params.push(sema_stream_handle_param("bytes", Type.List{element: Type.IntN{signed: false, bits: 8}}, AccessConvention.Read))
        shift_argument = -1
        if args.len() == 1 {
            if args[0].convention == AccessConvention.Move -> owned_reader = true
            if args[0].convention == AccessConvention.Read {
                // A last use moves the bytes into the reader; a later use or
                // a live view of them keeps the borrowing clone.
                if args[0].expr == {
                    .Ident(name, _, _) -> { owned_reader = !sema_ownership_name_live_after(name, tail_store, context) && !sema_ownership_view_reads_binding(state, args[0].expr, scopes) }
                    else -> {}
                }
            }
            if owned_reader {
                params[0].convention = AccessConvention.Move
                if ownership_args[0].convention == AccessConvention.Read -> ownership_args[0].convention = AccessConvention.Move
            }
            operation = THandleOp.ReaderOver{owned: owned_reader}
        }
    }
    typed_args: sema_stream_handle_checked_args("{owner}.{method}", params, ownership_args, None, None, AccessConvention.Read, shift_argument, span, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    values := typed_args
    if owner == "Reader" && owned_reader && values.len() == 1 {
        if values[0].kind == {
            .Move(_) -> {}
            else -> values[0] = sema_tree_node(values[0].ty, TExprKind.Move{value: values[0]}, values[0].span)
        }
    }
    unit_receiver := sema_node(context, Type.Named{name: "Unit"}, NodeKind.Unit, span)
    value := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: unit_receiver, operation: operation, args: values}, span)
    checked: sema_expression_call_expected(value, expected, environment, program, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_stream_handle_effect_fact(environment, program, scopes, context, "{owner}.{method}", span, result_type, effect_name, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}
