// Source semantic producers for channel, line-stream, binary-reader and
// cursor handle operations. The backend owns the fixed ABI routes;
// this module checks their public types, ownership, and effects.
use jet_foundation.[
    BodyHandleOp,
    AccessConvention,
    Call,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    NodeKind,
    ParamZone,
    Span,
    SymbolKind,
    TFailureCarrier,
    TMethodRef,
    Type,
    TypeTupleField,
    UnOp,
    core_source_owns_type,
    expr_span,
]

SemaStreamHandleSpec: struct {
    operation: BodyHandleOp,
    result_type: Type,
    params: [SemaCallParam],
    receiver_convention: AccessConvention,
    effect_name: String,
}

sema_stream_handle_param: fn(name: String, ty: Type, convention: AccessConvention) -> SemaCallParam Never! {
    SemaCallParam{
        label: name,
        name: name,
        zone: ParamZone.PositionalOnly,
        default: None,
        default_ref: None,
        convention: convention,
        ty: Val(ty),
        variadic: false,
    }
}

sema_stream_handle_owner: fn(ty: Type) -> String? {
    if ty == {
        .Named(name) | .Apply(name, _) -> {
            if core_source_owns_type(name) -> return None
            loop owner in
                ([String]{"Sender", "Receiver", "MappedFile", "FileScope", "FileReader", "FileWriter", "TempDir", "TempFile", "FileLock", "StdinHandle", "Stdout", "Stderr", "JSONLReader", "JSONLWriter", "CSVReader", "CSVWriter", "XMLReader", "XMLWriter", "Reader", "Cursor", "Path"}) {
                // The built-in `Path` has no declaring module: a canonical
                // `<module>.Path` is a different record (`core.files.path`).
                if name == owner || (owner != "Path" && name.ends_with(".{owner}")) {
                    return Val(owner)
                }
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    None
}

sema_stream_handle_owner_module: fn(owner: String) -> String Never! {
    if owner == "MappedFile" || owner == "FileScope" || owner == "FileReader" || owner == "FileWriter" || owner == "TempDir" || owner == "TempFile" || owner == "FileLock" {
        return "core.files"
    }
    if owner == "StdinHandle" || owner == "Stdout" || owner == "Stderr" || owner == "Reader" {
        return "core.term"
    }
    if owner == "JSONLReader" || owner == "JSONLWriter" -> return "core.encoding.jsonl"
    if owner == "CSVReader" || owner == "CSVWriter" -> return "core.encoding.csv"
    if owner == "XMLReader" || owner == "XMLWriter" -> return "core.encoding.xml"
    if owner == "Cursor" -> return "core.text"
    ""
}

sema_stream_handle_is_canonical: fn(ty: Type, owner: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    actual: sema_stream_handle_owner(ty) ?? return false
    if actual != owner -> return false
    // The channel endpoints are compiler-owned builtins with no declaring
    // module: a program's own `Sender` or `Receiver` is spelled by its
    // owner, never bare (sema_type_is_builtin_handle).
    if owner == "Sender" || owner == "Receiver" -> return sema_type_is_builtin_handle(ty, owner)
    graph: program.registration_graph
    resolved: sema_type_graph_lookup_symbol(graph, environment.module_identity, actual)
    if resolved == .Val(row) {
        owner_module := sema_stream_handle_owner_module(owner)
        // A declared or imported type named like a module-less built-in
        // (`Path`) shadows it; the two never share an identity.
        return sema_resolved_kind(graph, row) == SymbolKind.Type && owner_module != "" && (sema_registration_module_name(graph, sema_resolved_module_identity(graph, row)) ?? "") == owner_module
    }
    return true
}

// Core's `StdinHandle` is a source-declared record whose only source method is
// `read_line`; its `.lines()` stream stays the handle table's, as for the
// canonical identity of every Core stream handle.
sema_stream_handle_source_lines_owner: fn(ty: Type, method: String) -> String? {
    if method != "lines" -> return None
    if ty == .Named(name) {
        if name.ends_with(".StdinHandle") && core_source_owns_type(name) {
            return Val("StdinHandle")
        }
    }
    None
}

sema_stream_handle_result: fn(ok: Type, error: Type) -> Type Never! {
    Type.Result{ok: ok, err: error}
}

// `effect_name` is the exact handle-method row: these receivers record only
// `receiver_effect_leaf` (`Time.Wait` on the blocking channel methods).
sema_stream_handle_spec: fn(owner: String, method: String, receiver_type: Type) -> SemaStreamHandleSpec? {
    unit := Type.Named{name: "Unit"}
    string := Type.String
    u8 := Type.IntN{signed: false, bits: 8}
    bytes := Type.List{element: u8}
    if owner == "Sender" || owner == "Receiver" {
        element: if receiver_type == {
            .Apply(_, type_args) -> if type_args.len() == 1 -> type_args[0] else -> Type.Int
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> Type.Int
        }
        if method == "close" {
            return Val(SemaStreamHandleSpec{operation: BodyHandleOp.ChannelClose, result_type: unit, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        // `Sender.send` is Concurrency.jet's route (payload crossing checks).
        if owner == "Sender" -> return None
        if method == "receive" {
            return Val(SemaStreamHandleSpec{operation: BodyHandleOp.ChannelReceive, result_type: Type.Result{ok: element, err: Type.Named{name: "Closed"}}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: "Time.Wait"})
        }
        if method == "try_receive" {
            return Val(SemaStreamHandleSpec{operation: BodyHandleOp.ChannelTryReceive, result_type: Type.Option{inner: element}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        if method == "is_timer" {
            return Val(SemaStreamHandleSpec{operation: BodyHandleOp.ChannelIsTimer, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        if method == "is_interval" {
            return Val(SemaStreamHandleSpec{operation: BodyHandleOp.ChannelIsInterval, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        if method == "is_canceled" {
            return Val(SemaStreamHandleSpec{operation: BodyHandleOp.ChannelIsCanceled, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        if method == "is_ready" {
            return Val(SemaStreamHandleSpec{operation: BodyHandleOp.ChannelIsReady, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        if method == "delay_ms" {
            return Val(SemaStreamHandleSpec{operation: BodyHandleOp.ChannelDelayMs, result_type: Type.Int, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        return None
    }
    // The cursor and reader methods record no receiver write, so a read binding
    // or parameter calls them without a `^` mark.
    if owner == "Cursor" {
        if method == "take_until" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.CursorTakeUntil, sema_stream_handle_result(string, Type.String), [SemaCallParam]{sema_stream_handle_param("delimiter", string, AccessConvention.Read)}))
        }
        if method == "skip_ws" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.CursorSkipWs, unit, [SemaCallParam]{}))
        }
    }
    if owner == "Reader" {
        none: [SemaCallParam]{}
        if method == "read_u8" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadU8, sema_stream_handle_result(u8, string), none))
        }
        if method == "read_i8" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadI8, sema_stream_handle_result(Type.IntN{signed: true, bits: 8}, string), none))
        }
        if method == "read_u16_le" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadU16Le, sema_stream_handle_result(Type.IntN{signed: false, bits: 16}, string), none))
        }
        if method == "read_u16_be" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadU16Be, sema_stream_handle_result(Type.IntN{signed: false, bits: 16}, string), none))
        }
        if method == "read_i16_le" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadI16Le, sema_stream_handle_result(Type.IntN{signed: true, bits: 16}, string), none))
        }
        if method == "read_i16_be" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadI16Be, sema_stream_handle_result(Type.IntN{signed: true, bits: 16}, string), none))
        }
        if method == "read_u32_le" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadU32Le, sema_stream_handle_result(Type.IntN{signed: false, bits: 32}, string), none))
        }
        if method == "read_u32_be" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadU32Be, sema_stream_handle_result(Type.IntN{signed: false, bits: 32}, string), none))
        }
        if method == "read_i32_le" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadI32Le, sema_stream_handle_result(Type.IntN{signed: true, bits: 32}, string), none))
        }
        if method == "read_i32_be" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadI32Be, sema_stream_handle_result(Type.IntN{signed: true, bits: 32}, string), none))
        }
        if method == "read_u64_le" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadU64Le, sema_stream_handle_result(Type.IntN{signed: false, bits: 64}, string), none))
        }
        if method == "read_u64_be" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadU64Be, sema_stream_handle_result(Type.IntN{signed: false, bits: 64}, string), none))
        }
        if method == "read_i64_le" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadI64Le, sema_stream_handle_result(Type.IntN{signed: true, bits: 64}, string), none))
        }
        if method == "read_i64_be" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadI64Be, sema_stream_handle_result(Type.IntN{signed: true, bits: 64}, string), none))
        }
        if method == "read_f32_le" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadF32Le, sema_stream_handle_result(Type.Float32, string), none))
        }
        if method == "read_f32_be" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadF32Be, sema_stream_handle_result(Type.Float32, string), none))
        }
        if method == "read_f64_le" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadF64Le, sema_stream_handle_result(Type.Float, string), none))
        }
        if method == "read_f64_be" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderReadF64Be, sema_stream_handle_result(Type.Float, string), none))
        }
        if method == "peek" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderPeek, sema_stream_handle_result(u8, string), none))
        }
        if method == "seek" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderSeek, sema_stream_handle_result(Type.Named{name: "Unit"}, string), [SemaCallParam]{sema_stream_handle_param("offset", Type.Int, AccessConvention.Read)}))
        }
        if method == "skip" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderSkip, sema_stream_handle_result(Type.Named{name: "Unit"}, string), [SemaCallParam]{sema_stream_handle_param("count", Type.Int, AccessConvention.Read)}))
        }
        if method == "take" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderTake, sema_stream_handle_result(bytes, string), [SemaCallParam]{sema_stream_handle_param("count", Type.Int, AccessConvention.Read)}))
        }
        if method == "remaining" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderRemaining, Type.Int, none))
        }
        if method == "is_at_end" {
            return Val(sema_stream_handle_read_spec(BodyHandleOp.ReaderAtEnd, Type.Bool, none))
        }
    }
    None
}

sema_stream_handle_read_spec: fn(operation: BodyHandleOp, result_type: Type, params: [SemaCallParam]) -> SemaStreamHandleSpec Never! {
    SemaStreamHandleSpec{operation: operation, result_type: result_type, params: params, receiver_convention: AccessConvention.Read, effect_name: ""}
}

// The methods of the text-cursor and binary-reader handles are typed without
// recording a receiver convention, so a written mark has no convention to be
// checked against; `lines` on the file and stdin readers records none either.
sema_stream_handle_reports_no_receiver_convention: fn(owner: String) -> Bool Never! {
    owner == "FileReader" || owner == "StdinHandle" || owner == "Cursor" || owner == "Reader"
}

sema_stream_handle_infer_args: fn(args: [CallArg], check: ^SemaBodyCheck) Never! {
    loop argument in args -> _ := sema_check_expression(argument.expr, None, check)
}

sema_stream_handle_effect_fact: fn(check: ^SemaBodyCheck, api: String, span: Span, result_type: Type, effect_name: String) -> Bool Never! {
    entries := [EffectRowEntry]{}
    if effect_name != "" -> entries.push(EffectRowEntry{name: effect_name, span: span})
    facts := SemaCallFacts{
        return_type: result_type,
        failure_carrier: sema_call_failure_carrier(Val(result_type)),
        effect_bound: Val(entries),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(check.environment.*, check.program.*, check.scopes, check.context, api, span, facts, check.diagnostics)
}

sema_stream_handle_fixed_list_assignable: fn(required: Type, offered: Type, check: SemaBodyCheck) -> Bool Never! {
    if required == {
        .List(element) -> if offered == {
            .FixedList(fixed_element, _) -> sema_call_type_assignable(element, fixed_element, check) ?? false
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_stream_handle_integer_width: fn(ty: Type) -> Bool Never! {
    if ty == {
        .IntN(signed, bits) -> return !signed && (bits == 8 || bits == 16 || bits == 32)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return false
    }
}

// A `Reader`/`Cursor` byte-shift argument that does not fit its fixed parameter
// is E0112 about the call; every other handle argument is the plain E0108
// mismatch.
sema_stream_handle_argument_mismatch: fn(callee: String, required: Type, offered: Type, span: Span, program: SemaProgramTables) -> Diagnostic {
    shift: callee == "Reader.over" || callee == "Reader.take" || callee == "Reader.seek" || callee == "Reader.skip" || callee == "Cursor.over" || callee == "Cursor.take_until"
    if !shift -> return sema_type_mismatch(required, offered, span, program)
    sema_error("E0112", span, "`{callee}` wants {sema_type_show(required)}, but this is {sema_type_show(offered)}", "every argument must match its parameter's type", sema_type_fix_hint(required, offered))
}

sema_stream_handle_checked_args: fn(callee: String, params: [SemaCallParam], args: [CallArg], receiver_expr: Expr?, receiver_value: TExpr?, receiver_convention: AccessConvention, shift_argument: Int, span: Span, check: ^SemaBodyCheck) -> [TExpr]? {
    checked_args := args
    binding: sema_call_bind_args(callee, params, checked_args, span, check.diagnostics) ?? {
        sema_stream_handle_infer_args(args, check)
        return None
    }
    if !sema_call_validate_binding(callee, params, binding, checked_args, span, check.diagnostics) {
        return None
    }
    values := [TExpr]{}
    loop index in 0..<checked_args.len() {
        slot: sema_call_bound_slot(binding, binding.sources[index], checked_args[index])
        if slot < 0 || slot >= params.len() -> return None
        required_declared: sema_call_parameter_type(params[slot]) ?? return None
        required := sema_call_resolved_type(required_declared, check.environment.*, check.program.*)
        value_start: check.diagnostics.len()
        value: if shift_argument == index -> sema_check_expression(checked_args[index].expr, None, check) else -> sema_check_expression(checked_args[index].expr, Val(required), check)
        checked: value ?? {
            // The parameter type is the value's hint: its own E0108 against
            // it becomes the handle call's argument mismatch.
            value_span: expr_span(checked_args[index].expr)
            if sema_value_mismatch_index(check.diagnostics, value_start, value_span) == .Val(mismatch_index) {
                probe_diagnostics := [Diagnostic]{}
                if sema_probe_expression(checked_args[index].expr, None, check, probe_diagnostics) == .Val(offered) {
                    check.diagnostics[mismatch_index] = sema_stream_handle_argument_mismatch(callee, required, sema_call_resolved_type(offered.ty, check.environment.*, check.program.*), value_span, check.program.*)
                }
            }
            return None
        }
        if shift_argument == index {
            if checked.ty == .IntN(_, _) {
                // U64 and the signed widths stay explicit (E0112 at the call).
                if !sema_stream_handle_integer_width(checked.ty) {
                    check.diagnostics.push(sema_stream_handle_argument_mismatch(callee, required, checked.ty, checked_args[index].span, check.program.*))
                    return None
                }
                converted: sema_expr_numeric_conversion(checked, Type.Int, checked.span, sema_source_line_at(check.environment.source_segments, checked.span) ?? 0) ?? return None
                values.push(converted)
                next
            }
        }
        compatible := sema_call_type_assignable(required_declared, checked.ty, check) ?? false
        if !compatible && sema_stream_handle_fixed_list_assignable(required_declared, checked.ty, check) {
            compatible = true
        }
        if !compatible {
            check.diagnostics.push(sema_stream_handle_argument_mismatch(callee, required, checked.ty, checked_args[index].span, check.program.*))
            return None
        }
        // A `^` argument keeps its Write borrow of the caller's place, so the
        // route writes the original, never a copy (#5976).
        if params[slot].convention == AccessConvention.Write {
            borrow_type: checked.ty
            borrow_span: checked.span
            values.push(sema_tree_node(borrow_type, TExprKind.Borrow{place: checked, access: AccessConvention.Write}, borrow_span))
            next
        }
        values.push(checked)
    }
    ownership: if receiver_expr == {
        .Val(expr) -> {
            convention := receiver_convention
            if convention == AccessConvention.Write && sema_ownership_places_from_expr_in_state(expr, check.scopes, check.state).len() == 0 {
                convention = AccessConvention.Read
            }
            sema_ownership_check_handle_method_call(check, callee, expr, convention, params, checked_args, span)
        }
        .None -> sema_ownership_check_call_arguments(check.state, callee, params, checked_args, check.scopes, check.diagnostics)
    }
    if !ownership.accepted || !ownership.complete -> return None
    Val(values)
}

sema_stream_handle_finish: fn(receiver: TExpr, operation: BodyHandleOp, args: [TExpr], result_type: Type, effect_name: String, api: String, span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck Never! {
    value := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver, operation: operation, args: args}, span)
    checked: sema_expression_call_expected(value, expected, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_stream_handle_effect_fact(check, api, span, result_type, effect_name) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}

sema_stream_handle_method_ref: fn(owner: String, method: String, check: ^SemaBodyCheck) -> TMethodRef Never! {
    owner_module := sema_stream_handle_owner_module(owner)
    TMethodRef{symbol: sema_symbol_id(check.program.*, check.context, SymbolKind.Function, owner_module, owner, method), name: method, mangled: false, trait_owner: None, operator_identity: None}
}

sema_stream_handle_lines_value: fn(receiver: TExpr, owner: String, span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck Never! {
    result_type := if owner == "FileReader" -> Type.Named{name: "FileLines"} else -> Type.Named{name: "StdinLines"}
    method: sema_stream_handle_method_ref(owner, "lines", check)
    value := sema_tree_node(result_type, TExprKind.MethodCall{receiver: receiver, method: method, type_args: [Type]{}, args: [TCallArg]{}}, span)
    checked: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    // `FileReader.lines` waits; `StdinHandle` records no handle effect.
    effect_name := if owner == "FileReader" -> "Time.Wait" else -> ""
    if !sema_stream_handle_effect_fact(check, "{owner}.lines", span, result_type, effect_name) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}

// Called before ordinary method lookup for canonical Core handle types.
sema_call_try_stream_handle_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    source_lines: sema_stream_handle_source_lines_owner(receiver_value.ty, method)
    owner := source_lines ?? ""
    if source_lines == None {
        owner = sema_stream_handle_owner(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
        if !sema_stream_handle_is_canonical(receiver_value.ty, owner, check.environment.*, check.program.*) {
            return SemaMethodSpecialCheck{handled: false, value: None}
        }
    }
    if (owner == "FileReader" && method == "lines") || (owner == "StdinHandle" && method == "lines") {
        if args.len() != 0 {
            sema_stream_handle_infer_args(args, check)
            check.diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", 0, args.len(), false, span))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        _ := sema_ownership_check_call_receiver(check, receiver, AccessConvention.Read, span)
        if sema_stream_handle_reports_no_receiver_convention(owner) {
            sema_receiver_mark_forget(check.state, receiver)
        }
        return sema_stream_handle_lines_value(receiver_value, owner, span, expected, check)
    }
    spec: sema_stream_handle_spec(owner, method, receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != spec.params.len() {
        sema_stream_handle_infer_args(args, check)
        check.diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", spec.params.len(), args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    shift_argument := if owner == "Reader" && (method == "seek" || method == "skip" || method == "take") -> 0 else -> -1
    checked_args: sema_stream_handle_checked_args("{owner}.{method}", spec.params, args, Val(receiver), receiver_value, spec.receiver_convention, shift_argument, span, check)
    if sema_stream_handle_reports_no_receiver_convention(owner) {
        sema_receiver_mark_forget(check.state, receiver)
    }
    typed_args: checked_args ?? return SemaMethodSpecialCheck{handled: true, value: None}
    sema_stream_handle_finish(receiver_value, spec.operation, typed_args, spec.result_type, spec.effect_name, "{owner}.{method}", span, expected, check)
}

sema_stream_handle_static_owner_is_canonical: fn(owner: String, check: ^SemaBodyCheck) -> Bool Never! {
    index: sema_scope_resolve_index(check.scopes, owner) ?? return true
    symbol: check.scopes.bindings[index].symbol
    if symbol.kind != SymbolKind.Type -> return false
    owner_module := sema_stream_handle_owner_module(owner)
    if owner_module == "" -> return false
    graph: check.program.registration_graph
    return (sema_registration_module_name(graph, symbol.module_identity) ?? "") == owner_module
}

// Static reserved constructors. Callers must still prefer a shadowing user type.
sema_call_try_stream_handle_static: fn(owner: String, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    known := (owner == "Reader" && method == "over") || (owner == "Cursor" && method == "over")
    if !known || !sema_stream_handle_static_owner_is_canonical(owner, check) {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if args.len() != 1 {
        sema_stream_handle_infer_args(args, check)
        check.diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", 1, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    operation := BodyHandleOp.CursorOver
    result_type := Type.Named{name: "Cursor"}
    params := [SemaCallParam]{}
    ownership_args := args
    shift_argument := -1
    if owner == "Cursor" {
        params.push(sema_stream_handle_param("text", Type.String, AccessConvention.Read))
    }
    owned_reader := false
    if owner == "Reader" {
        operation = BodyHandleOp.ReaderOver{owned: false}
        result_type = Type.Named{name: "Reader"}
        params.push(sema_stream_handle_param("bytes", Type.List{element: Type.IntN{signed: false, bits: 8}}, AccessConvention.Read))
        shift_argument = -1
        if args.len() == 1 {
            if args[0].convention == AccessConvention.Move -> owned_reader = true
            if args[0].convention == AccessConvention.Read {
                // A last use moves the bytes into the reader; a later use or
                // a live view of them keeps the borrowing clone.
                if args[0].expr == {
                    .Ident(name, _, _) -> {
                        owned_reader = !sema_ownership_name_live_after(name, check) && !sema_ownership_view_reads_binding(check, args[0].expr)
                    }
                    .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
                }
            }
            if owned_reader {
                params[0].convention = AccessConvention.Move
                if ownership_args[0].convention == AccessConvention.Read {
                    ownership_args[0].convention = AccessConvention.Move
                }
            }
            operation = BodyHandleOp.ReaderOver{owned: owned_reader}
        }
    }
    typed_args: sema_stream_handle_checked_args("{owner}.{method}", params, ownership_args, None, None, AccessConvention.Read, shift_argument, span, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    values := typed_args
    if owner == "Reader" && owned_reader && values.len() == 1 {
        if values[0].kind == {
            .Move(_) -> {}
            .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {
                values[0] = sema_tree_node(values[0].ty, TExprKind.Move{value: values[0]}, values[0].span)
            }
        }
    }
    unit_receiver := sema_node(check.context, Type.Named{name: "Unit"}, NodeKind.Unit, span)
    value := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: unit_receiver, operation: operation, args: values}, span)
    checked: sema_expression_call_expected(value, expected, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_stream_handle_effect_fact(check, "{owner}.{method}", span, result_type, "") {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}

sema_channel_capacity_literal: fn(expr: Expr) -> Int? Never! {
    if expr == {
        .Int(value, _, _, raw, _) -> Val(sema_expr_exact_integer_literal(value, raw))
        .Paren(inner, _, _) -> sema_channel_capacity_literal(inner)
        .Unary(op, inner, _, _) -> {
            if op == UnOp.Neg {
                value: sema_channel_capacity_literal(inner) ?? return None
                return Val(-value)
            }
            None
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// `channel<T>()` and `channel<T>(capacity)`: a sender and receiver pair over
// core.tasks' unbounded or bounded channel. A literal capacity below 1 is
// E0395.
sema_call_check_channel: fn(call: Call, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if call.args.len() > 1 {
        sema_stream_handle_infer_args(call.args, check)
        check.diagnostics.push(sema_call_arity_diagnostic("channel", 1, call.args.len(), false, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if call.type_args.len() != 1 {
        sema_stream_handle_infer_args(call.args, check)
        check.diagnostics.push(sema_error("E0904", call.name_span, "`channel` needs a type argument to infer the element type", "the element type `T` cannot be guessed from an empty channel", "call it with an explicit type argument: `channel<T>()`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    params := [SemaCallParam]{}
    if call.args.len() == 1 {
        params.push(SemaCallParam{label: "capacity", name: "capacity", zone: ParamZone.Either, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.Int), variadic: false})
    }
    values: sema_stream_handle_checked_args("channel", params, call.args, None, None, AccessConvention.Read, 0, call.name_span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if call.args.len() == 1 {
        if sema_channel_capacity_literal(call.args[0].expr) == .Val(capacity) {
            if capacity < 1 {
                check.diagnostics.push(sema_error("E0395", expr_span(call.args[0].expr), "A channel capacity must be at least 1, not `{capacity}`.", "A bounded channel holds at least one value; Jet has no zero-capacity rendezvous channel, and a capacity below 1 is never clamped. A runtime capacity below 1 stops the program (Jet.Panic).", "Write `channel<T>(capacity: 1)` or larger, or `channel<T>()` for an unbounded channel."))
                return SemaDirectSpecialCheck{handled: true, value: None}
            }
        }
    }
    element := sema_call_resolved_type(call.type_args[0], check.environment.*, check.program.*)
    result_type := Type.Tuple{
        fields: [TypeTupleField]{
            {name: "sender", ty: Type.Apply{name: "Sender", args: [Type]{element}}},
            {name: "receiver", ty: Type.Apply{name: "Receiver", args: [Type]{element}}},
        },
    }
    // The Core function that fills the constructor's role makes the pair
    // (Core/Tasks/Tasks.jet); a Core without one keeps the row.
    role: if call.args.len() == 0 -> "InlineChannelNew" else -> "InlineChannelBounded"
    if sema_core_role_function(check.program.registration_graph, role) != None {
        target: sema_call_core_role_target(role, [Type]{element}, call.name_span, check.environment.*, check.program.*, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        declared: sema_call_params_from_type(target.signature) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        callee: sema_call_callee_decl(check.program.*, target.symbol.id, call.name_span, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        made: sema_tree_node(result_type, TExprKind.Call{callee: callee, type_args: [Type]{element}, args: sema_call_core_source_arguments(values, declared, check)}, call.name_span)
        return SemaDirectSpecialCheck{handled: true, value: sema_expr_expected_owned(made, expected, check.environment.*, check.program.*, check.diagnostics)}
    }
    member: if call.args.len() == 0 -> "__channel_new" else -> "__channel_bounded"
    record: sema_call_core_record("core.tasks", member, values.len(), call.name_span, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    value: sema_call_core_tree(record, values, call.name_span, [Type]{element}, [Bool]{}, result_type, TFailureCarrier.Infallible, expected, check)
    SemaDirectSpecialCheck{handled: true, value: value}
}
