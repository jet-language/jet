// Source semantic producers for channel, line-stream, binary-reader and
// cursor handle operations. The backend owns the fixed ABI routes;
// this module checks their public types, ownership, and effects.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    NodeKind,
    ParamZone,
    Span,
    SymbolKind,
    TMethodRef,
    Type,
    core_source_owns_type,
    expr_span,
]

SemaStreamHandleSpec: struct {
    operation: THandleOp,
    result_type: Type,
    params: [SemaCallParam],
    receiver_convention: AccessConvention,
    effect_name: String,
}

sema_stream_handle_param: fn(name: String, ty: Type, convention: AccessConvention) -> SemaCallParam Never! {
    SemaCallParam{
        label: name,
        name: name,
        zone: ParamZone.PositionalOnly,
        default: None,
        default_ref: None,
        convention: convention,
        ty: Val(ty),
        variadic: false,
    }
}

sema_stream_handle_owner: fn(ty: Type) -> String? {
    if ty == {
        .Named(name) | .Apply(name, _) -> {
            if core_source_owns_type(name) -> return None
            loop owner in
                ([String]{"Sender", "Receiver", "MappedFile", "FileScope", "FileReader", "FileWriter", "TempDir", "TempFile", "FileLock", "StdinHandle", "Stdout", "Stderr", "JSONLReader", "JSONLWriter", "CSVReader", "CSVWriter", "XMLReader", "XMLWriter", "Reader", "Cursor", "Path"}) {
                // The built-in `Path` has no declaring module: a canonical
                // `<module>.Path` is a different record (`core.files.path`).
                if name == owner || (owner != "Path" && name.ends_with(".{owner}")) {
                    return Val(owner)
                }
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    None
}

sema_stream_handle_owner_module: fn(owner: String) -> String Never! {
    if owner == "MappedFile" || owner == "FileScope" || owner == "FileReader" || owner == "FileWriter" || owner == "TempDir" || owner == "TempFile" || owner == "FileLock" {
        return "core.files"
    }
    if owner == "StdinHandle" || owner == "Stdout" || owner == "Stderr" || owner == "Reader" {
        return "core.term"
    }
    if owner == "JSONLReader" || owner == "JSONLWriter" -> return "core.encoding.jsonl"
    if owner == "CSVReader" || owner == "CSVWriter" -> return "core.encoding.csv"
    if owner == "XMLReader" || owner == "XMLWriter" -> return "core.encoding.xml"
    if owner == "Cursor" -> return "core.text"
    ""
}

sema_stream_handle_is_canonical: fn(ty: Type, owner: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    actual: sema_stream_handle_owner(ty) ?? return false
    if actual != owner -> return false
    // The channel endpoints are compiler-owned builtins with no declaring
    // module: a program's own `Sender` or `Receiver` is spelled by its
    // owner, never bare (sema_type_is_builtin_handle).
    if owner == "Sender" || owner == "Receiver" -> return sema_type_is_builtin_handle(ty, owner)
    if program.registration_graph == .Val(graph) {
        resolved: sema_type_graph_lookup_symbol(graph, environment.module_identity, actual)
        if resolved == .Val(row) {
            owner_module := sema_stream_handle_owner_module(owner)
            // A declared or imported type named like a module-less built-in
            // (`Path`) shadows it; the two never share an identity.
            return sema_resolved_kind(graph, row) == SymbolKind.Type && owner_module != "" && (sema_registration_module_name(graph, sema_resolved_module_identity(graph, row)) ?? "") == owner_module
        }
        return true
    } else { return true }
}

// Core's `StdinHandle` is a source-declared record whose only source method is
// `read_line`; its `.lines()` stream stays the handle table's, as for the
// canonical identity of every Core stream handle.
sema_stream_handle_source_lines_owner: fn(ty: Type, method: String) -> String? {
    if method != "lines" -> return None
    if ty == .Named(name) {
        if name.ends_with(".StdinHandle") && core_source_owns_type(name) {
            return Val("StdinHandle")
        }
    }
    None
}

sema_stream_handle_result: fn(ok: Type, error: Type) -> Type Never! {
    Type.Result{ok: ok, err: error}
}

// `effect_name` is Rust's exact handle-method row: records only
// `receiver_effect_leaf` (`Time.Wait` on the blocking channel methods) for
// these receivers.
sema_stream_handle_spec: fn(owner: String, method: String, receiver_type: Type) -> SemaStreamHandleSpec? {
    unit := Type.Named{name: "Unit"}
    string := Type.String
    u8 := Type.IntN{signed: false, bits: 8}
    bytes := Type.List{element: u8}
    if owner == "Sender" || owner == "Receiver" {
        element: if receiver_type == {
            .Apply(_, type_args) -> if type_args.len() == 1 -> type_args[0] else -> Type.Int
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> Type.Int
        }
        if method == "close" {
            return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelClose, result_type: unit, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        // `Sender.send` is Concurrency.jet's route (payload crossing checks).
        if owner == "Sender" -> return None
        if method == "receive" {
            return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelReceive, result_type: Type.Result{ok: element, err: Type.Named{name: "Closed"}}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: "Time.Wait"})
        }
        if method == "try_receive" {
            return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelTryReceive, result_type: Type.Option{inner: element}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        if method == "is_timer" {
            return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelIsTimer, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        if method == "is_interval" {
            return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelIsInterval, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        if method == "is_canceled" {
            return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelIsCanceled, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        if method == "is_ready" {
            return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelIsReady, result_type: Type.Bool, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        if method == "delay_ms" {
            return Val(SemaStreamHandleSpec{operation: THandleOp.ChannelDelayMs, result_type: Type.Int, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, effect_name: ""})
        }
        return None
    }
    // Rust `text_cursor_method_return` / `binary_reader_method_return`: the
    // cursor and reader methods record no receiver write, so a read binding
    // or parameter calls them without a `^` mark.
    if owner == "Cursor" {
        if method == "take_until" {
            return Val(sema_stream_handle_read_spec(THandleOp.CursorTakeUntil, sema_stream_handle_result(string, Type.String), [SemaCallParam]{sema_stream_handle_param("delimiter", string, AccessConvention.Read)}))
        }
        if method == "skip_ws" {
            return Val(sema_stream_handle_read_spec(THandleOp.CursorSkipWs, unit, [SemaCallParam]{}))
        }
    }
    if owner == "Reader" {
        none: [SemaCallParam]{}
        if method == "read_u8" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU8, sema_stream_handle_result(u8, string), none))
        }
        if method == "read_i8" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI8, sema_stream_handle_result(Type.IntN{signed: true, bits: 8}, string), none))
        }
        if method == "read_u16_le" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU16Le, sema_stream_handle_result(Type.IntN{signed: false, bits: 16}, string), none))
        }
        if method == "read_u16_be" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU16Be, sema_stream_handle_result(Type.IntN{signed: false, bits: 16}, string), none))
        }
        if method == "read_i16_le" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI16Le, sema_stream_handle_result(Type.IntN{signed: true, bits: 16}, string), none))
        }
        if method == "read_i16_be" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI16Be, sema_stream_handle_result(Type.IntN{signed: true, bits: 16}, string), none))
        }
        if method == "read_u32_le" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU32Le, sema_stream_handle_result(Type.IntN{signed: false, bits: 32}, string), none))
        }
        if method == "read_u32_be" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU32Be, sema_stream_handle_result(Type.IntN{signed: false, bits: 32}, string), none))
        }
        if method == "read_i32_le" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI32Le, sema_stream_handle_result(Type.IntN{signed: true, bits: 32}, string), none))
        }
        if method == "read_i32_be" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI32Be, sema_stream_handle_result(Type.IntN{signed: true, bits: 32}, string), none))
        }
        if method == "read_u64_le" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU64Le, sema_stream_handle_result(Type.IntN{signed: false, bits: 64}, string), none))
        }
        if method == "read_u64_be" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadU64Be, sema_stream_handle_result(Type.IntN{signed: false, bits: 64}, string), none))
        }
        if method == "read_i64_le" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI64Le, sema_stream_handle_result(Type.IntN{signed: true, bits: 64}, string), none))
        }
        if method == "read_i64_be" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadI64Be, sema_stream_handle_result(Type.IntN{signed: true, bits: 64}, string), none))
        }
        if method == "read_f32_le" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadF32Le, sema_stream_handle_result(Type.Float32, string), none))
        }
        if method == "read_f32_be" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadF32Be, sema_stream_handle_result(Type.Float32, string), none))
        }
        if method == "read_f64_le" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadF64Le, sema_stream_handle_result(Type.Float, string), none))
        }
        if method == "read_f64_be" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderReadF64Be, sema_stream_handle_result(Type.Float, string), none))
        }
        if method == "peek" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderPeek, sema_stream_handle_result(u8, string), none))
        }
        if method == "seek" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderSeek, sema_stream_handle_result(Type.Named{name: "Unit"}, string), [SemaCallParam]{sema_stream_handle_param("offset", Type.Int, AccessConvention.Read)}))
        }
        if method == "skip" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderSkip, sema_stream_handle_result(Type.Named{name: "Unit"}, string), [SemaCallParam]{sema_stream_handle_param("count", Type.Int, AccessConvention.Read)}))
        }
        if method == "take" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderTake, sema_stream_handle_result(bytes, string), [SemaCallParam]{sema_stream_handle_param("count", Type.Int, AccessConvention.Read)}))
        }
        if method == "remaining" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderRemaining, Type.Int, none))
        }
        if method == "is_at_end" {
            return Val(sema_stream_handle_read_spec(THandleOp.ReaderAtEnd, Type.Bool, none))
        }
    }
    None
}

sema_stream_handle_read_spec: fn(operation: THandleOp, result_type: Type, params: [SemaCallParam]) -> SemaStreamHandleSpec Never! {
    SemaStreamHandleSpec{operation: operation, result_type: result_type, params: params, receiver_convention: AccessConvention.Read, effect_name: ""}
}

// Rust `text_cursor_method_return` / `binary_reader_method_return` type the
// methods of these handles without recording a receiver convention, so a
// written mark has no convention to be checked against; `lines` on the file
// and stdin readers records none either.
sema_stream_handle_reports_no_receiver_convention: fn(owner: String) -> Bool Never! {
    owner == "FileReader" || owner == "StdinHandle" || owner == "Cursor" || owner == "Reader"
}

sema_stream_handle_infer_args: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, state: ^SemaOwnershipState, tail_store: ^SemaStatementTailStore, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) Never! {
    loop argument in args {
        _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
    }
}

sema_stream_handle_effect_fact: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, context: ^SemaCheckContext, api: String, span: Span, result_type: Type, effect_name: String, diagnostics: ^[Diagnostic]) -> Bool Never! {
    entries := [EffectRowEntry]{}
    if effect_name != "" -> entries.push(EffectRowEntry{name: effect_name, span: span})
    facts := SemaCallFacts{
        return_type: result_type,
        failure_carrier: sema_call_failure_carrier(Val(result_type)),
        effect_bound: Val(entries),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(environment, program, scopes, context, api, span, facts, diagnostics)
}

sema_stream_handle_fixed_list_assignable: fn(required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if required == {
        .List(element) -> if offered == {
            .FixedList(fixed_element, _) -> sema_call_type_assignable(element, fixed_element, environment, program) ?? false
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_stream_handle_integer_width: fn(ty: Type) -> Bool Never! {
    if ty == {
        .IntN(signed, bits) -> return !signed && (bits == 8 || bits == 16 || bits == 32)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return false
    }
}

// (Rust `check_shift_arg`): a `Reader`/`Cursor` byte-shift argument that does
// not fit its fixed parameter is E0112 about the call; every other handle
// argument is the plain E0108 mismatch.
sema_stream_handle_argument_mismatch: fn(callee: String, required: Type, offered: Type, span: Span, program: SemaProgramTables) -> Diagnostic {
    shift: callee == "Reader.over" || callee == "Reader.take" || callee == "Reader.seek" || callee == "Reader.skip" || callee == "Cursor.over" || callee == "Cursor.take_until"
    if !shift -> return sema_type_mismatch(required, offered, span, program)
    sema_error("E0112", span, "`{callee}` wants {sema_type_show(required)}, but this is {sema_type_show(offered)}", "every argument must match its parameter's type", sema_type_fix_hint(required, offered))
}

sema_stream_handle_checked_args: fn(callee: String, params: [SemaCallParam], args: [CallArg], receiver_expr: Expr?, receiver_value: TExpr?, receiver_convention: AccessConvention, shift_argument: Int, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, state: ^SemaOwnershipState, tail_store: ^SemaStatementTailStore, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> [TExpr]? {
    checked_args := args
    binding: sema_call_bind_args(callee, params, checked_args, span, diagnostics) ?? {
        sema_stream_handle_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    if !sema_call_validate_binding(callee, params, binding, checked_args, span, diagnostics) {
        return None
    }
    values := [TExpr]{}
    loop index in 0..<checked_args.len() {
        slot: sema_call_bound_slot(binding, binding.sources[index], checked_args[index])
        if slot < 0 || slot >= params.len() -> return None
        required_declared: sema_call_parameter_type(params[slot]) ?? return None
        required := sema_call_resolved_type(required_declared, environment, program)
        value_start: diagnostics.len()
        value: if shift_argument == index -> sema_check_expression(checked_args[index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_check_expression(checked_args[index].expr, Val(required), environment, program, scopes, state, tail_store, context, diagnostics)
        checked: value ?? {
            // The parameter type is the value's hint: its own E0108 against
            // it becomes the handle call's argument mismatch.
            value_span: expr_span(checked_args[index].expr)
            if sema_value_mismatch_index(diagnostics, value_start, value_span) == .Val(mismatch_index) {
                probe_diagnostics := [Diagnostic]{}
                if sema_probe_expression(checked_args[index].expr, None, environment, program, scopes, state, tail_store, context, probe_diagnostics) == .Val(offered) {
                    diagnostics[mismatch_index] = sema_stream_handle_argument_mismatch(callee, required, sema_call_resolved_type(offered.ty, environment, program), value_span, program)
                }
            }
            return None
        }
        if shift_argument == index {
            if checked.ty == .IntN(_, _) {
                // U64 and the signed widths stay explicit (E0112 at the call).
                if !sema_stream_handle_integer_width(checked.ty) {
                    diagnostics.push(sema_stream_handle_argument_mismatch(callee, required, checked.ty, checked_args[index].span, program))
                    return None
                }
                converted: sema_expr_numeric_conversion(checked, Type.Int, checked.span, sema_source_line_at(environment.source_segments, checked.span) ?? 0) ?? return None
                values.push(converted)
                next
            }
        }
        compatible := sema_call_type_assignable(required_declared, checked.ty, environment, program) ?? false
        if !compatible && sema_stream_handle_fixed_list_assignable(required_declared, checked.ty, environment, program) {
            compatible = true
        }
        if !compatible {
            diagnostics.push(sema_stream_handle_argument_mismatch(callee, required, checked.ty, checked_args[index].span, program))
            return None
        }
        // A `^` argument keeps its Write borrow of the caller's place, so the
        // route writes the original, never a copy (#5976).
        if params[slot].convention == AccessConvention.Write {
            borrow_type: checked.ty.copy()
            borrow_span: checked.span
            values.push(sema_tree_node(borrow_type, TExprKind.Borrow{place: checked, access: AccessConvention.Write}, borrow_span))
            next
        }
        values.push(checked)
    }
    ownership: if receiver_expr == {
        .Val(expr) -> {
            convention := receiver_convention
            if convention == AccessConvention.Write && sema_ownership_places_from_expr_in_state(expr, scopes, state).len() == 0 {
                convention = AccessConvention.Read
            }
            sema_ownership_check_handle_method_call(state, callee, expr, convention, params, checked_args, scopes, span, diagnostics)
        }
        .None -> sema_ownership_check_call_arguments(state, callee, params, checked_args, scopes, diagnostics)
    }
    if !ownership.accepted || !ownership.complete -> return None
    Val(values)
}

sema_stream_handle_finish: fn(receiver: TExpr, operation: THandleOp, args: [TExpr], result_type: Type, effect_name: String, api: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    value := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver, operation: operation, args: args}, span)
    checked: sema_expression_call_expected(value, expected, environment, program, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_stream_handle_effect_fact(environment, program, scopes, context, api, span, result_type, effect_name, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}

sema_stream_handle_method_ref: fn(owner: String, method: String, program: SemaProgramTables, context: ^SemaCheckContext) -> TMethodRef Never! {
    owner_module := sema_stream_handle_owner_module(owner)
    TMethodRef{symbol: sema_symbol_id(program, context, SymbolKind.Function, owner_module, owner, method), name: method, mangled: false, trait_owner: None, operator_identity: None}
}

sema_stream_handle_lines_value: fn(receiver: TExpr, owner: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    result_type := if owner == "FileReader" -> Type.Named{name: "FileLines"} else -> Type.Named{name: "StdinLines"}
    method: sema_stream_handle_method_ref(owner, "lines", program, context)
    value := sema_tree_node(result_type, TExprKind.MethodCall{receiver: receiver, method: method, type_args: [Type]{}, args: [TCallArg]{}}, span)
    checked: sema_expr_expected(value, expected, environment, program, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    // Rust `receiver_effect_leaf`: `FileReader.lines` waits; `StdinHandle`
    // records no handle effect.
    effect_name := if owner == "FileReader" -> "Time.Wait" else -> ""
    if !sema_stream_handle_effect_fact(environment, program, scopes, context, "{owner}.lines", span, result_type, effect_name, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}

// Called before ordinary method lookup for canonical Core handle types.
sema_call_try_stream_handle_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, state: ^SemaOwnershipState, tail_store: ^SemaStatementTailStore, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> SemaMethodSpecialCheck {
    source_lines: sema_stream_handle_source_lines_owner(receiver_value.ty, method)
    owner := source_lines ?? ""
    if source_lines == None {
        owner = sema_stream_handle_owner(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
        if !sema_stream_handle_is_canonical(receiver_value.ty, owner, environment, program) {
            return SemaMethodSpecialCheck{handled: false, value: None}
        }
    }
    if (owner == "FileReader" && method == "lines") || (owner == "StdinHandle" && method == "lines") {
        if args.len() != 0 {
            sema_stream_handle_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
            diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", 0, args.len(), false, span))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        _ := sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics)
        if sema_stream_handle_reports_no_receiver_convention(owner) {
            sema_receiver_mark_forget(state, receiver)
        }
        return sema_stream_handle_lines_value(receiver_value, owner, span, expected, environment, program, scopes, context, diagnostics)
    }
    spec: sema_stream_handle_spec(owner, method, receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != spec.params.len() {
        sema_stream_handle_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", spec.params.len(), args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    shift_argument := if owner == "Reader" && (method == "seek" || method == "skip" || method == "take") -> 0 else -> -1
    checked_args: sema_stream_handle_checked_args("{owner}.{method}", spec.params, args, Val(receiver), receiver_value, spec.receiver_convention, shift_argument, span, environment, program, scopes, state, tail_store, context, diagnostics)
    if sema_stream_handle_reports_no_receiver_convention(owner) {
        sema_receiver_mark_forget(state, receiver)
    }
    typed_args: checked_args ?? return SemaMethodSpecialCheck{handled: true, value: None}
    sema_stream_handle_finish(receiver_value, spec.operation, typed_args, spec.result_type, spec.effect_name, "{owner}.{method}", span, expected, environment, program, scopes, context, diagnostics)
}

sema_stream_handle_static_owner_is_canonical: fn(owner: String, scopes: ^SemaScopeTable, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    index: sema_scope_resolve_index(scopes, owner) ?? return true
    symbol: scopes.bindings[index].symbol
    if symbol.kind != SymbolKind.Type -> return false
    owner_module := sema_stream_handle_owner_module(owner)
    if owner_module == "" -> return false
    if program.registration_graph == .Val(graph) {
        return (sema_registration_module_name(graph, symbol.module_identity) ?? "") == owner_module
    } else { return false }
}

// Static reserved constructors. Callers must still prefer a shadowing user type.
sema_call_try_stream_handle_static: fn(owner: String, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, state: ^SemaOwnershipState, tail_store: ^SemaStatementTailStore, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> SemaMethodSpecialCheck {
    known := (owner == "Reader" && method == "over") || (owner == "Cursor" && method == "over")
    if !known || !sema_stream_handle_static_owner_is_canonical(owner, scopes, environment, program) {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if args.len() != 1 {
        sema_stream_handle_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", 1, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    operation := THandleOp.CursorOver
    result_type := Type.Named{name: "Cursor"}
    params := [SemaCallParam]{}
    ownership_args := args
    shift_argument := -1
    if owner == "Cursor" {
        params.push(sema_stream_handle_param("text", Type.String, AccessConvention.Read))
    }
    owned_reader := false
    if owner == "Reader" {
        operation = THandleOp.ReaderOver{owned: false}
        result_type = Type.Named{name: "Reader"}
        params.push(sema_stream_handle_param("bytes", Type.List{element: Type.IntN{signed: false, bits: 8}}, AccessConvention.Read))
        shift_argument = -1
        if args.len() == 1 {
            if args[0].convention == AccessConvention.Move -> owned_reader = true
            if args[0].convention == AccessConvention.Read {
                // A last use moves the bytes into the reader; a later use or
                // a live view of them keeps the borrowing clone.
                if args[0].expr == {
                    .Ident(name, _, _) -> {
                        owned_reader = !sema_ownership_name_live_after(name, tail_store, context) && !sema_ownership_view_reads_binding(state, args[0].expr, scopes)
                    }
                    .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
                }
            }
            if owned_reader {
                params[0].convention = AccessConvention.Move
                if ownership_args[0].convention == AccessConvention.Read {
                    ownership_args[0].convention = AccessConvention.Move
                }
            }
            operation = THandleOp.ReaderOver{owned: owned_reader}
        }
    }
    typed_args: sema_stream_handle_checked_args("{owner}.{method}", params, ownership_args, None, None, AccessConvention.Read, shift_argument, span, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    values := typed_args
    if owner == "Reader" && owned_reader && values.len() == 1 {
        if values[0].kind == {
            .Move(_) -> {}
            .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {
                values[0] = sema_tree_node(values[0].ty, TExprKind.Move{value: values[0]}, values[0].span)
            }
        }
    }
    unit_receiver := sema_node(context, Type.Named{name: "Unit"}, NodeKind.Unit, span)
    value := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: unit_receiver, operation: operation, args: values}, span)
    checked: sema_expression_call_expected(value, expected, environment, program, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_stream_handle_effect_fact(environment, program, scopes, context, "{owner}.{method}", span, result_type, "", diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}
