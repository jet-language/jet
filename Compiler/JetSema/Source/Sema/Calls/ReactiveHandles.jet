// Source producers for the retained reactive callbacks and their handle methods.
// Reactive subscriptions are recorded by lambda checking; these helpers only
// construct the native operation and preserve its ordinary call/effect facts.
use jet_foundation.[
    AccessConvention,
    CallArg,
    CoreCallRecord,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    ParamZone,
    Span,
    SymbolID,
    Type,
    expr_span,
    type_name,
]

sema_reactive_unit_type: fn() -> Type Never! {
    Type.Named{name: "Unit"}
}

sema_reactive_loadable_type: fn(value: Type, error: Type) -> Type Never! {
    Type.Apply{name: "Loadable", args: [Type]{value, error}}
}

sema_reactive_element_type: fn(ty: Type, name: String, fallback: Type) -> Type Never! {
    if ty == {
        .Apply(_, args) -> if sema_reactive_type_name(ty) == name && args.len() == 1 -> args[0] else -> fallback
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> fallback
    }
}

sema_reactive_context_element: fn(expected: Type?, name: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type? {
    if expected == {
        .Val(value) -> {
            resolved := sema_call_resolved_type(value, environment, program)
            if resolved == {
                .Apply(owner, args) -> if owner == name && args.len() == 1 -> Val(args[0]) else -> None
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> None
            }
        }
        .None -> None
    }
}

sema_reactive_function_value: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Fn(_, _, _, _, _, _) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_reactive_value_ok: fn(ty: Type, kind: String, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if sema_reactive_function_value(ty) {
        diagnostics.push(sema_error("E2913", span, "a reactive {kind} can't hold a function", "signals and derived values hold ordinary data so they can be copied to dependents", "use a data value (number, text, list, struct, …); wrap behaviour in `reactive.autorun` instead"))
        return false
    }
    true
}

sema_reactive_source_lambda_arity: fn(expr: Expr) -> Int? {
    if expr == {
        .Lambda(lambda, _) -> Val(lambda.params.len())
        .Paren(value, _, _) -> sema_reactive_source_lambda_arity(value)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_reactive_infer_args: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [TExpr] Never! {
    values := [TExpr]{}
    loop arg in args {
        if sema_check_expression(arg.expr, None, environment, program, scopes, state, tail_store, context, diagnostics) == .Val(value) -> values.push(value)
    }
    values
}

sema_reactive_call_fact: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, api: String, span: Span, result_type: Type, type_args: [Type], effect_name: String, diagnostics: &[Diagnostic]) -> Bool Never! {
    effect_entries := [EffectRowEntry]{}
    if effect_name != "" -> effect_entries.push(EffectRowEntry{name: effect_name, span: span})
    facts := SemaCallFacts{
        return_type: result_type,
        failure_carrier: sema_call_failure_carrier(Val(result_type)),
        effect_bound: Val(effect_entries),
        type_args: type_args,
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(environment, program, scopes, context, api, span, facts, diagnostics)
}

sema_reactive_core_call_value: fn(record: CoreCallRecord, args: [TExpr], span: Span, type_args: [Type], result_type: Type, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    value: sema_call_core_tree(record, args, span, type_args, [Bool]{}, result_type, sema_call_failure_carrier(Val(result_type)), expected, environment, program, diagnostics) ?? return None
    if !sema_call_core_record_effects(record, span, type_args, result_type, sema_call_failure_carrier(Val(result_type)), [FunctionDefaultRef]{}, scopes, context, environment, program, diagnostics) -> return None
    Val(value)
}

sema_reactive_core_record: fn(module_name: String, member: String, args: [CallArg], span: Span, diagnostics: &[Diagnostic]) -> CoreCallRecord? {
    sema_call_core_record(module_name, member, args.len(), span, diagnostics)
}

sema_reactive_typed_single_argument: fn(member: String, argument: CallArg, required: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    sema_check_expression(argument.expr, required, environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_reactive_callback_type: fn(return_type: Type?) -> Type Never! {
    Type.Fn{params: [Type]{}, ret: return_type, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
}

sema_reactive_check_retained_lambda: fn(kind: String, argument: CallArg, expected_return: Type?, expected_element: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TLambda? {
    source_arity: sema_reactive_source_lambda_arity(argument.expr) ?? {
        checked: sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        actual: if checked == .Val(value) -> sema_type_show(value.ty) else -> "an invalid value"
        diagnostics.push(sema_error("E2910", expr_span(argument.expr), "`reactive.{kind}` needs a lambda, not {actual}", "a reactive {kind} is built from a `() -> …` body so it can re-run when a signal changes", "write `reactive.{kind}(() -> {{ … }})`"))
        return None
    }
    if source_arity != 0 {
        _ := sema_expression_lambda_host_callback_stored(argument.expr, None, false, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_error("E2911", expr_span(argument.expr), "`reactive.{kind}` needs a zero-parameter lambda, got {source_arity} parameter{if source_arity == 1 -> "" else -> "s"}", "the body takes no arguments — it reads the signals it depends on via `.get()`", "write `reactive.{kind}(() -> {{ … }})` with no parameters"))
        return None
    }
    expected_callback_return := expected_return
    if expected_element != None -> expected_callback_return = expected_element
    callback_type := sema_reactive_callback_type(expected_callback_return)
    checked: sema_expression_lambda_host_callback_stored(argument.expr, Val(callback_type), false, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if checked.kind == {
        .Lambda(lambda) -> Val(lambda)
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {
            diagnostics.push(sema_error("E2910", expr_span(argument.expr), "`reactive.{kind}` needs a lambda, not {sema_type_show(checked.ty)}", "a reactive {kind} is built from a `() -> …` body so it can re-run when a signal changes", "write `reactive.{kind}(() -> {{ … }})`"))
            return None
        }
    }
}

sema_reactive_direct_closure: fn(kind: String, lambda: TLambda, result_type: Type, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, type_args: [Type], diagnostics: &[Diagnostic]) -> TExpr? {
    closure_kind: if kind == "autorun" -> TCoreClosureKind.ReactiveEffect{executable: lambda} else -> TCoreClosureKind.ReactiveDerived{executable: lambda}
    value := sema_tree_node(result_type, TExprKind.CoreClosureCall{kind: closure_kind}, span)
    checked: sema_expr_expected(value, expected, environment, program, diagnostics) ?? return None
    if !sema_reactive_call_fact(environment, program, scopes, context, "core.reactive.{kind}", span, result_type, type_args, "", diagnostics) -> return None
    Val(checked)
}

sema_reactive_autorun_value: fn(type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, args: [CallArg], diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if args.len() != 1 {
        _ := sema_reactive_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_arity_diagnostic("core.reactive.autorun", 1, args.len(), false, span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_call_core_check_type_args("core.reactive", "autorun", 0, false, type_args, span, diagnostics) {
        _ := sema_reactive_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    lambda: sema_reactive_check_retained_lambda("autorun", args[0], Val(sema_reactive_unit_type()), None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    result_type := Type.Named{name: "Effect"}
    value: sema_reactive_direct_closure("autorun", lambda, result_type, span, expected, environment, program, scopes, context, type_args, diagnostics)
    SemaDirectSpecialCheck{handled: true, value: value}
}

sema_reactive_derived_value: fn(member: String, type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, args: [CallArg], diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if args.len() != 1 {
        _ := sema_reactive_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_arity_diagnostic("core.reactive.{member}", 1, args.len(), false, span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_call_core_check_type_args("core.reactive", member, 1, true, type_args, span, diagnostics) {
        _ := sema_reactive_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    expected_element := if type_args.len() == 1 -> Val(sema_call_resolved_type(type_args[0], environment, program)) else -> None
    if expected_element == None -> expected_element = sema_reactive_context_element(expected, if member == "computed" -> "Computed" else -> "Derived", environment, program)
    lambda: sema_reactive_check_retained_lambda(member, args[0], None, expected_element, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    result_type: lambda.ret ?? Type.Named{name: "Unit"}
    if result_type == sema_reactive_unit_type() {
        diagnostics.push(sema_error("E2912", expr_span(args[0].expr), "`reactive.{member}` must compute and return a value", "a derived value is recomputed from its signals; its lambda has to return the value", "return a value from the body, or use `reactive.autorun(() -> {{ … }})` for a side effect"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_reactive_value_ok(result_type, member, args[0].span, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    owner := if member == "computed" -> "Computed" else -> "Derived"
    reactive_type := Type.Apply{name: owner, args: [Type]{result_type}}
    value: sema_reactive_direct_closure(member, lambda, reactive_type, span, expected, environment, program, scopes, context, [Type]{result_type}, diagnostics)
    SemaDirectSpecialCheck{handled: true, value: value}
}

// `reactive.signal(value)` has no Core registry row: sema types the element
// and rewrites the call into the Core source function `signal<T>`.
sema_reactive_signal_value: fn(type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, args: [CallArg], diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if args.len() != 1 {
        _ := sema_reactive_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_arity_diagnostic("core.reactive.signal", 1, args.len(), false, span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_call_core_check_type_args("core.reactive", "signal", 1, true, type_args, span, diagnostics) {
        _ := sema_reactive_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    expected_element := if type_args.len() == 1 -> Val(sema_call_resolved_type(type_args[0], environment, program)) else -> sema_reactive_context_element(expected, "Signal", environment, program)
    value: sema_reactive_typed_single_argument("signal", args[0], expected_element, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_reactive_value_ok(value.ty, "signal", args[0].span, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    element := if expected_element == .Val(required) -> required else -> sema_call_resolved_type(value.ty, environment, program)
    result_type := Type.Apply{name: "Signal", args: [Type]{element}}
    identity: sema_call_core_module_identity(environment, program, "core.reactive") ?? return SemaDirectSpecialCheck{handled: true, value: None}
    target: sema_call_core_source_target(environment, program, identity, "signal", [Type]{element}, span, false, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    callee: sema_call_callee_decl(program, target.symbol.id, span, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    argument := TCallArg{value: value, template_items: [SymbolID]{}, borrow: false, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
    call := sema_tree_node(result_type, TExprKind.Call{callee: callee, type_args: target.type_args, args: [TCallArg]{argument}}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(call, expected, environment, program, diagnostics)}
}

sema_reactive_loadable_value: fn(member: String, type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, args: [CallArg], diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck Never! {
    record: sema_reactive_core_record("core.reactive.loadable", member, args, span, diagnostics) ?? {
        _ := sema_reactive_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if member == "idle" || member == "loading" {
        result_type := sema_reactive_loadable_type(sema_reactive_unit_type(), sema_reactive_unit_type())
        value: sema_reactive_core_call_value(record, [TExpr]{}, span, type_args, result_type, expected, environment, program, scopes, context, diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: value}
    }
    value: sema_reactive_typed_single_argument(member, args[0], None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    result_type := if member == "loaded" -> sema_reactive_loadable_type(sema_call_resolved_type(value.ty, environment, program), sema_reactive_unit_type()) else -> sema_reactive_loadable_type(sema_reactive_unit_type(), sema_call_resolved_type(value.ty, environment, program))
    value_out: sema_reactive_core_call_value(record, [TExpr]{value}, span, type_args, result_type, expected, environment, program, scopes, context, diagnostics)
    SemaDirectSpecialCheck{handled: true, value: value_out}
}

sema_call_try_reactive_core_call: fn(module_name: String, member: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if module_name == "core.reactive" {
        if member == "signal" -> return sema_reactive_signal_value(type_args, span, expected, environment, program, scopes, state, tail_store, context, args, diagnostics)
        if member == "derived" || member == "computed" -> return sema_reactive_derived_value(member, type_args, span, expected, environment, program, scopes, state, tail_store, context, args, diagnostics)
        if member == "autorun" -> return sema_reactive_autorun_value(type_args, span, expected, environment, program, scopes, state, tail_store, context, args, diagnostics)
    }
    if module_name == "core.reactive.loadable" && (member == "idle" || member == "loading" || member == "loaded" || member == "failed") -> return sema_reactive_loadable_value(member, type_args, span, expected, environment, program, scopes, state, tail_store, context, args, diagnostics)
    SemaDirectSpecialCheck{handled: false, value: None}
}

// The handle owner a receiver names: the bare runtime handle, or the leaf of
// its `core.reactive` declaration (`<corelib>/core.reactive::Signal`, the
// type a written `Signal<Int>` resolves to).
sema_reactive_type_name: fn(ty: Type) -> String Never! {
    owner: sema_expr_type_base_name(ty) ?? type_name(ty)
    prefix: "<corelib>/core.reactive::"
    if owner.starts_with(prefix) -> return owner.slice(prefix.len(), owner.len())
    owner
}

sema_reactive_handle_member: fn(owner: String, method: String) -> Bool Never! {
    if owner == "Signal" -> return method == "get" || method == "set"
    if owner == "Derived" || owner == "Computed" -> return method == "get"
    if owner == "Effect" -> return method == "unsubscribe" || method == "is_active"
    false
}

sema_reactive_handle_result: fn(owner: String, method: String, receiver_type: Type) -> Type Never! {
    if method == "get" -> return sema_reactive_element_type(receiver_type, owner, Type.Int)
    if method == "is_active" -> return Type.Bool
    sema_reactive_unit_type()
}

sema_reactive_method_parameter: fn(name: String, ty: Type, convention: AccessConvention) -> SemaCallParam Never! {
    SemaCallParam{label: "", name: name, zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: convention, ty: Val(ty), variadic: false}
}

sema_reactive_checked_handle_args: fn(owner: String, method: String, args: [CallArg], receiver: Expr, receiver_type: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [TExpr]? {
    params := [SemaCallParam]{}
    if method == "set" -> params.push(sema_reactive_method_parameter("value", sema_reactive_element_type(receiver_type, owner, Type.Int), AccessConvention.Move))
    checked_args := args
    binding: sema_call_bind_args("{owner}.{method}", params, checked_args, span, diagnostics) ?? {
        _ := sema_reactive_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    // A bare name passed to `set` is an ordinary
    // owning argument. A copy value passes; any other moves at its last use,
    // and the ownership check below rejects it (E0209) when it is used again.
    typed: sema_call_typecheck_bound_arguments("{owner}.{method}", params, None, false, binding, checked_args, environment, program, scopes, state, tail_store, context, span, diagnostics, false) ?? return None
    ownership := sema_ownership_check_method_call(state, "{owner}.{method}", receiver, AccessConvention.Read, params, checked_args, scopes, span, diagnostics)
    if !ownership.accepted || !ownership.complete -> return None
    Val(typed.values)
}

sema_call_try_reactive_handle_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    owner: sema_reactive_type_name(receiver_value.ty)
    if !sema_reactive_handle_member(owner, method) -> return SemaMethodSpecialCheck{handled: false, value: None}
    expected_arity := if method == "set" -> 1 else -> 0
    if args.len() != expected_arity {
        _ := sema_reactive_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", expected_arity, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    result_type := sema_reactive_handle_result(owner, method, receiver_value.ty)
    checked_args: sema_reactive_checked_handle_args(owner, method, args, receiver, receiver_value.ty, span, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    operation: if {
        owner == "Effect" -> THandleOp.ReactiveEffectMethod
        method == "set" -> THandleOp.ReactiveSet
        else -> THandleOp.ReactiveGet
    }
    value := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: checked_args}, span)
    checked: sema_expression_call_expected(value, expected, environment, program, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}
