// Source producers for the retained reactive callbacks and their handle methods.
// Reactive subscriptions are recorded by lambda checking; these helpers only
// construct the native operation and preserve its ordinary call/effect facts.
use jet_foundation.[
    AST_NODE_GENERATED,
    BodyHandleOp,
    AccessConvention,
    CallArg,
    CallLabel,
    CoreCallRecord,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    NodeKind,
    ParamZone,
    Span,
    SymbolID,
    SymbolKind,
    Type,
    expr_span,
    type_name,
    core_identity_is,
    core_identity_module,
    core_record_leaf,
]

sema_reactive_unit_type: fn() -> Type Never! { Type.Named{name: "Unit"} }

sema_reactive_loadable_type: fn(value: Type, error: Type) -> Type Never! {
    Type.Apply{name: "Loadable", args: [Type]{value, error}}
}

sema_reactive_element_type: fn(ty: Type, name: String, fallback: Type) -> Type Never! {
    if ty == {
        .Apply(_, args) -> if sema_reactive_type_name(ty) == name && args.len() == 1 -> args[0] else -> fallback
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> fallback
    }
}

sema_reactive_context_element: fn(expected: Type?, name: String, check: SemaBodyCheck) -> Type? {
    if expected == {
        .Val(value) -> {
            ^resolved: sema_call_resolved_type(value, check.environment.*, check.program.*)
            if resolved == {
                .Apply(owner, args) -> if owner == name && args.len() == 1 -> Val(args[0]) else -> None
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
            }
        }
        .None -> None
    }
}

sema_reactive_function_value: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Fn(_, _, _, _, _, _) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_reactive_value_ok: fn(ty: Type, kind: String, span: Span, diagnostics: ^[Diagnostic]) -> Bool {
    if sema_reactive_function_value(ty) {
        diagnostics.push(sema_error("E2913", span, "a reactive {kind} can't hold a function", "signals and derived values hold ordinary data so they can be copied to dependents", "use a data value (number, text, list, struct, …); wrap behavior in `reactive.autorun` instead"))
        return false
    }
    true
}

sema_reactive_source_lambda_arity: fn(expr: Expr) -> Int? {
    if expr == {
        .Lambda(lambda, _) -> Val(lambda.params.len())
        .Paren(value, _, _) -> sema_reactive_source_lambda_arity(value)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_reactive_infer_args: fn(args: [CallArg], check: ^SemaBodyCheck) -> [TExpr] Never! {
    ^values: [TExpr]{}
    loop arg in args {
        if sema_check_expression(arg.expr, None, check) == .Val(value) -> values.push(value)
    }
    values
}

sema_reactive_call_fact: fn(check: ^SemaBodyCheck, api: String, span: Span, result_type: Type, type_args: [Type], effect_name: String) -> Bool Never! {
    ^effect_entries: [EffectRowEntry]{}
    if effect_name != "" -> effect_entries.push(EffectRowEntry{name: effect_name, span: span})
    ^facts: SemaCallFacts{
        return_type: result_type,
        failure_carrier: sema_call_failure_carrier(Val(result_type)),
        effect_bound: Val(effect_entries),
        type_args: type_args,
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(check.environment.*, check.program.*, check.scopes, check.context, api, span, facts, check.diagnostics)
}

sema_reactive_core_call_value: fn(record: CoreCallRecord, args: [TExpr], span: Span, type_args: [Type], result_type: Type, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    value: sema_call_core_tree(record, args, span, type_args, result_type, expected, check) ?? return None
    if !sema_call_core_record_effects(record, span, type_args, result_type, sema_call_failure_carrier(Val(result_type)), [FunctionDefaultRef]{}, check) {
        return None
    }
    Val(value)
}

sema_reactive_core_record: fn(module_name: String, member: String, args: [CallArg], span: Span, diagnostics: ^[Diagnostic]) -> CoreCallRecord? {
    sema_call_core_record(module_name, member, args.len(), span, diagnostics)
}

sema_reactive_typed_single_argument: fn(member: String, argument: CallArg, required: Type?, check: ^SemaBodyCheck) -> TExpr? {
    sema_check_expression(argument.expr, required, check)
}

sema_reactive_callback_type: fn(return_type: Type?) -> Type Never! {
    Type.Fn{params: [Type]{}, ret: return_type, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
}

sema_reactive_check_retained_lambda: fn(kind: String, argument: CallArg, expected_return: Type?, expected_element: Type?, check: ^SemaBodyCheck) -> TLambda? {
    source_arity: sema_reactive_source_lambda_arity(argument.expr) ?? {
        checked: sema_check_expression(argument.expr, None, check)
        actual: if checked == .Val(value) -> sema_type_show(value.ty) else -> "an invalid value"
        check.diagnostics.push(sema_error("E2910", expr_span(argument.expr), "`reactive.{kind}` needs a lambda, not {actual}", "a reactive {kind} is built from a `fn() {{ … }}` body so it can re-run when a signal changes", "write `reactive.{kind}(fn() {{ … }})`"))
        return None
    }
    if source_arity != 0 {
        ^_: sema_expression_lambda_host_callback_stored(argument.expr, None, false, check)
        check.diagnostics.push(sema_error("E2911", expr_span(argument.expr), "`reactive.{kind}` needs a zero-parameter lambda, got {source_arity} parameter{if source_arity == 1 -> "" else -> "s"}", "the body takes no arguments — it reads the signals it depends on via `.get()`", "write `reactive.{kind}(fn() {{ … }})` with no parameters"))
        return None
    }
    ^expected_callback_return: expected_return
    if expected_element != None -> expected_callback_return = expected_element
    ^callback_type: sema_reactive_callback_type(expected_callback_return)
    checked: sema_expression_lambda_host_callback_stored(argument.expr, Val(callback_type), false, check) ?? return None
    if checked.kind == {
        .Lambda(lambda) -> Val(lambda)
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {
            check.diagnostics.push(sema_error("E2910", expr_span(argument.expr), "`reactive.{kind}` needs a lambda, not {sema_type_show(checked.ty)}", "a reactive {kind} is built from a `fn() {{ … }}` body so it can re-run when a signal changes", "write `reactive.{kind}(fn() {{ … }})`"))
            return None
        }
    }
}

sema_reactive_direct_closure: fn(kind: String, lambda: TLambda, result_type: Type, span: Span, expected: Type?, check: ^SemaBodyCheck, type_args: [Type]) -> TExpr? {
    closure_kind: if kind == "autorun" -> TCoreClosureKind.ReactiveEffect{executable: lambda} else -> TCoreClosureKind.ReactiveDerived{executable: lambda}
    ^value: sema_tree_node(result_type, TExprKind.CoreClosureCall{kind: closure_kind}, span)
    checked: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics) ?? return None
    if !sema_reactive_call_fact(check, "core.reactive.{kind}", span, result_type, type_args, "") {
        return None
    }
    Val(checked)
}

sema_reactive_autorun_value: fn(type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck, args: [CallArg]) -> SemaDirectSpecialCheck {
    if args.len() != 1 {
        ^_: sema_reactive_infer_args(args, check)
        check.diagnostics.push(sema_call_arity_diagnostic("core.reactive.autorun", 1, args.len(), false, span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_call_core_check_type_args("core.reactive", "autorun", 0, false, type_args, span, check.diagnostics) {
        ^_: sema_reactive_infer_args(args, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    lambda: sema_reactive_check_retained_lambda("autorun", args[0], Val(sema_reactive_unit_type()), None, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ^result_type: Type.Named{name: "Effect"}
    value: sema_reactive_direct_closure("autorun", lambda, result_type, span, expected, check, type_args)
    SemaDirectSpecialCheck{handled: true, value: value}
}

sema_reactive_derived_value: fn(member: String, type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck, args: [CallArg]) -> SemaDirectSpecialCheck {
    if args.len() != 1 {
        ^_: sema_reactive_infer_args(args, check)
        check.diagnostics.push(sema_call_arity_diagnostic("core.reactive.{member}", 1, args.len(), false, span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_call_core_check_type_args("core.reactive", member, 1, true, type_args, span, check.diagnostics) {
        ^_: sema_reactive_infer_args(args, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^expected_element: if type_args.len() == 1 -> Val(sema_call_resolved_type(type_args[0], check.environment.*, check.program.*)) else -> None
    if expected_element == None {
        expected_element = sema_reactive_context_element(expected, if member == "computed" -> "Computed" else -> "Derived", check)
    }
    lambda: sema_reactive_check_retained_lambda(member, args[0], None, expected_element, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    result_type: lambda.ret ?? Type.Named{name: "Unit"}
    if result_type == sema_reactive_unit_type() {
        check.diagnostics.push(sema_error("E2912", expr_span(args[0].expr), "`reactive.{member}` must compute and return a value", "a derived value is recomputed from its signals; its lambda has to return the value", "return a value from the body, or use `reactive.autorun(fn() {{ … }})` for a side effect"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_reactive_value_ok(result_type, member, args[0].span, check.diagnostics) {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^owner: if member == "computed" -> "Computed" else -> "Derived"
    ^reactive_type: Type.Apply{name: owner, args: [Type]{result_type}}
    value: sema_reactive_direct_closure(member, lambda, reactive_type, span, expected, check, [Type]{result_type})
    SemaDirectSpecialCheck{handled: true, value: value}
}

// `reactive.signal(value)` has no Core registry row: sema types the element
// and rewrites the call into the Core source function `signal<T>`.
sema_reactive_signal_value: fn(type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck, args: [CallArg]) -> SemaDirectSpecialCheck {
    if args.len() != 1 {
        ^_: sema_reactive_infer_args(args, check)
        check.diagnostics.push(sema_call_arity_diagnostic("core.reactive.signal", 1, args.len(), false, span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_call_core_check_type_args("core.reactive", "signal", 1, true, type_args, span, check.diagnostics) {
        ^_: sema_reactive_infer_args(args, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^expected_element: if type_args.len() == 1 -> Val(sema_call_resolved_type(type_args[0], check.environment.*, check.program.*)) else -> sema_reactive_context_element(expected, "Signal", check)
    value: sema_reactive_typed_single_argument("signal", args[0], expected_element, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_reactive_value_ok(value.ty, "signal", args[0].span, check.diagnostics) {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^element: if expected_element == .Val(required) -> required else -> sema_call_resolved_type(value.ty, check.environment.*, check.program.*)
    ^result_type: Type.Apply{name: "Signal", args: [Type]{element}}
    identity: sema_call_core_module_identity(check.environment.*, check.program.*, "core.reactive") ?? return SemaDirectSpecialCheck{handled: true, value: None}
    target: sema_call_core_source_target(check.environment.*, check.program.*, identity, "signal", [Type]{element}, span, false, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    callee: sema_call_callee_decl(check.program.*, target.symbol.id, span, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ^argument: TCallArg{value: value, template_items: [SymbolID]{}, borrow: false, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
    ^call: sema_tree_node(result_type, TExprKind.Call{callee: callee, type_args: target.type_args, args: [TCallArg]{argument}}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(call, expected, check.environment.*, check.program.*, check.diagnostics)}
}

sema_reactive_loadable_value: fn(member: String, type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck, args: [CallArg]) -> SemaDirectSpecialCheck Never! {
    record: sema_reactive_core_record("core.reactive.loadable", member, args, span, check.diagnostics) ?? {
        ^_: sema_reactive_infer_args(args, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if member == "idle" || member == "loading" {
        ^result_type: sema_reactive_loadable_type(sema_reactive_unit_type(), sema_reactive_unit_type())
        value: sema_reactive_core_call_value(record, [TExpr]{}, span, type_args, result_type, expected, check)
        return SemaDirectSpecialCheck{handled: true, value: value}
    }
    value: sema_reactive_typed_single_argument(member, args[0], None, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ^result_type: if member == "loaded" -> sema_reactive_loadable_type(sema_call_resolved_type(value.ty, check.environment.*, check.program.*), sema_reactive_unit_type()) else -> sema_reactive_loadable_type(sema_reactive_unit_type(), sema_call_resolved_type(value.ty, check.environment.*, check.program.*))
    value_out: sema_reactive_core_call_value(record, [TExpr]{value}, span, type_args, result_type, expected, check)
    SemaDirectSpecialCheck{handled: true, value: value_out}
}

sema_call_try_reactive_core_call: fn(module_name: String, member: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if module_name == "core.reactive" {
        if member == "signal" {
            return sema_reactive_signal_value(type_args, span, expected, check, args)
        }
        if member == "derived" || member == "computed" {
            return sema_reactive_derived_value(member, type_args, span, expected, check, args)
        }
        if member == "autorun" {
            return sema_reactive_autorun_value(type_args, span, expected, check, args)
        }
    }
    if module_name == "core.reactive.loadable" && (member == "idle" || member == "loading" || member == "loaded" || member == "failed") {
        return sema_reactive_loadable_value(member, type_args, span, expected, check, args)
    }
    SemaDirectSpecialCheck{handled: false, value: None}
}

// The handle owner a receiver names: the bare runtime handle, or the leaf of
// its `core.reactive` declaration (the identity of `core.reactive.Signal`,
// the type a written `Signal<Int>` resolves to).
sema_reactive_type_name: fn(ty: Type) -> String Never! {
    owner: sema_expr_type_base_name(ty) ?? type_name(ty)
    if core_identity_module(owner) == Val("core.reactive") -> return core_record_leaf(owner)
    owner
}

sema_reactive_handle_member: fn(owner: String, method: String) -> Bool Never! {
    if owner == "Signal" -> return method == "get" || method == "set"
    if owner == "Derived" || owner == "Computed" -> return method == "get"
    if owner == "Effect" -> return method == "unsubscribe" || method == "is_active"
    false
}

sema_reactive_handle_result: fn(owner: String, method: String, receiver_type: Type) -> Type Never! {
    if method == "get" -> return sema_reactive_element_type(receiver_type, owner, Type.Int)
    if method == "is_active" -> return Type.Bool
    sema_reactive_unit_type()
}

sema_reactive_method_parameter: fn(name: String, ty: Type, convention: AccessConvention) -> SemaCallParam Never! {
    SemaCallParam{label: "", name: name, zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: convention, ty: Val(ty), variadic: false}
}

sema_reactive_checked_handle_args: fn(owner: String, method: String, args: [CallArg], receiver: Expr, receiver_type: Type, span: Span, check: ^SemaBodyCheck) -> [TExpr]? {
    ^params: [SemaCallParam]{}
    if method == "set" {
        params.push(sema_reactive_method_parameter("value", sema_reactive_element_type(receiver_type, owner, Type.Int), AccessConvention.Move))
    }
    ^checked_args: args
    binding: sema_call_bind_args("{owner}.{method}", params, checked_args, span, check.diagnostics) ?? {
        ^_: sema_reactive_infer_args(args, check)
        return None
    }
    // A bare name passed to `set` is an ordinary
    // owning argument. A copy value passes; any other moves at its last use,
    // and the ownership check below rejects it (E0209) when it is used again.
    typed: sema_call_typecheck_bound_arguments("{owner}.{method}", params, None, false, binding, checked_args, check, span, false) ?? return None
    ^ownership: sema_ownership_check_method_call(check, "{owner}.{method}", receiver, AccessConvention.Read, params, checked_args, span)
    if !ownership.accepted || !ownership.complete -> return None
    Val(typed.values)
}

sema_call_try_reactive_handle_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    owner: sema_reactive_type_name(receiver_value.ty)
    if !sema_reactive_handle_member(owner, method) {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    ^expected_arity: if method == "set" -> 1 else -> 0
    if args.len() != expected_arity {
        ^_: sema_reactive_infer_args(args, check)
        check.diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", expected_arity, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    ^result_type: sema_reactive_handle_result(owner, method, receiver_value.ty)
    checked_args: sema_reactive_checked_handle_args(owner, method, args, receiver, receiver_value.ty, span, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    operation: if {
        owner == "Effect" -> BodyHandleOp.ReactiveEffectMethod
        method == "set" -> BodyHandleOp.ReactiveSet
        else -> BodyHandleOp.ReactiveGet
    }
    ^value: sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: checked_args}, span)
    checked: sema_expression_call_expected(value, expected, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}

// ---- retained UI callbacks and focus-group lint -------------------------
//
// `ui.button`, `ui.text_input` and `ui.reactive_render` lower retained
// closures into CoreClosureCall nodes (`UIClickSlot`, `UIDropSlot`,
// `UIReactiveRender`). `ui.mount` and `ui.node_role` live in Core/UI/UI.jet.

sema_ui_handle_imported_ui_alias: fn(alias: String, check: SemaBodyCheck) -> Bool Never! {
    if sema_call_core_import_module(check.environment.*, check.program.*, alias) != .Val("core.ui") {
        return false
    }
    visible: sema_scope_resolve(check.scopes, alias) ?? return false
    visible.kind == SymbolKind.Import
}

sema_ui_handle_interactive_role: fn(expr: Expr, check: SemaBodyCheck) -> String? {
    if expr == {
        .MethodCall(receiver, method, _, _, _, _, _) -> {
            if receiver == {
                .Ident(alias, _, _) -> {
                    if !sema_ui_handle_imported_ui_alias(alias, check) -> return None
                    if method == "aria_role_button" -> return Val("button")
                    if method == "aria_role_text_input" -> return Val("text input")
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    None
}

sema_call_core_ui_focus_group_lint: fn(args: [CallArg], span: Span, check: ^SemaBodyCheck) {
    if args.len() == 0 {
        return
    }
    if args[0].expr == {
        .ListLit(items, _, _) -> {
            ^labels: [String]{}
            loop item in items {
                if item == {
                    .MethodCall(receiver, method, _, _, _, call_args, _) -> {
                        if method != "node_role" || call_args.len() != 4 -> next
                        alias: if receiver == {
                            .Ident(name, _, _) -> Val(name)
                            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
                        } ?? next
                        if !sema_ui_handle_imported_ui_alias(alias, check) -> next
                        if sema_ui_handle_interactive_role(call_args[3].expr, check) == None -> next
                        label: sema_comptime_input_literal(call_args[0].expr) ?? next
                        if label == "" -> next
                        ^duplicate: false
                        loop existing in labels {
                            if existing == label {
                                duplicate = true
                                break
                            }
                        }
                        if duplicate {
                            check.diagnostics.push(sema_lint("E2931", span, "Two interactive nodes both have the label \"{label}\"", "Assistive tech announces controls by their label — identical labels make them indistinguishable (WCAG 2.5.3).", "Give each interactive node a distinct, descriptive label."))
                            return
                        }
                        labels.push(label)
                    }
                    .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
                }
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

sema_ui_handle_callback_type: fn(params: [Type]) -> Type Never! {
    Type.Fn{params: params, ret: Val(sema_reactive_unit_type()), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
}

sema_ui_handle_stored_callback: fn(kind: String, argument: CallArg, params: [Type], span: Span, check: ^SemaBodyCheck) -> TLambda? {
    actual_arity: sema_reactive_source_lambda_arity(argument.expr) ?? {
        checked: sema_expression_lambda_host_callback_stored(argument.expr, Val(sema_ui_handle_callback_type(params)), false, check)
        actual: if checked == .Val(value) -> type_name(value.ty) else -> "an invalid value"
        check.diagnostics.push(sema_error("E2910", argument.span, "`{kind}` needs a lambda, not {actual}", "the callback is retained and invoked later by the UI runtime", "pass a lambda expression as the callback"))
        return None
    }
    if actual_arity != params.len() {
        ^_: sema_expression_lambda_host_callback_stored(argument.expr, None, false, check)
        check.diagnostics.push(sema_error("E2911", argument.span, "`{kind}` needs a {params.len()}-parameter lambda, got {actual_arity}", "the callback parameters must match the UI event", "use a callback with {params.len()} parameter(s)"))
        return None
    }
    checked: sema_expression_lambda_host_callback_stored(argument.expr, Val(sema_ui_handle_callback_type(params)), false, check) ?? return None
    if checked.kind == {
        .Lambda(lambda) -> Val(lambda)
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> None
    }
}

sema_ui_handle_callback_param: fn(name: String, label: String, ty: Type, span: Span, convention: AccessConvention, zone: ParamZone, default: Expr?) -> SemaCallParam Never! {
    SemaCallParam{label: label, name: name, zone: zone, default: default, default_ref: None, convention: convention, ty: Val(ty), variadic: false}
}

// The callback is an ordinary `() -> { … }` argument; an
// unlabeled lambda after the positional params fills the callback slot.
sema_ui_handle_bind_callback_args: fn(member: String, args: [CallArg], span: Span, callback_label: String, params: [SemaCallParam], diagnostics: ^[Diagnostic]) -> [CallArg]? {
    ^normalized: args
    ^positional: 0
    loop param in params {
        if param.zone == .PositionalOnly -> positional += 1
    }
    last: normalized.len() - 1
    if last >= positional && normalized[last].label == None && normalized[last].expr == .Lambda(_, _) {
        normalized[last].label = Val(CallLabel{name: callback_label, span: normalized[last].span})
    }
    ^_: sema_call_bind_args("core.ui.{member}", params, normalized, span, diagnostics) ?? return None
    Val(normalized)
}

sema_ui_handle_typed_arg: fn(arg: CallArg, ty: Type, check: ^SemaBodyCheck) -> TExpr? {
    sema_check_expression(arg.expr, Val(ty), check)
}

sema_ui_handle_optional_arg: fn(arg: CallArg, ty: Type, check: ^SemaBodyCheck) -> TExpr? {
    if sema_expression_absent_none(arg.expr) {
        return Val(sema_node(check.context, Type.Option{inner: ty}, NodeKind.Absent, arg.span))
    }
    value: sema_ui_handle_typed_arg(arg, ty, check) ?? return None
    return Val(sema_tree_node(Type.Option{inner: ty}, TExprKind.Present{value: value}, value.span))
}

sema_ui_handle_button: fn(args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if args.len() == 1 && args[0].label == None {
        label: sema_ui_handle_typed_arg(args[0], Type.String, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        value: sema_call_core_source("core.ui", "button", [TExpr]{label}, Type.Named{name: "UINode"}, false, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        return SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
    }
    ^params: [SemaCallParam]{
        sema_ui_handle_callback_param("display", "display", Type.String, span, AccessConvention.Read, ParamZone.PositionalOnly, None),
        sema_ui_handle_callback_param("shortcut", "shortcut", Type.Option{inner: Type.Named{name: "UIShortcut"}}, span, AccessConvention.Move, ParamZone.LabelOnly, Val(Expr.Absent{span: span, id: AST_NODE_GENERATED})),
        sema_ui_handle_callback_param("label", "label", Type.Option{inner: Type.String}, span, AccessConvention.Move, ParamZone.LabelOnly, Val(Expr.Absent{span: span, id: AST_NODE_GENERATED})),
        sema_ui_handle_callback_param("on_click", "on_click", sema_ui_handle_callback_type([Type]{}), span, AccessConvention.Move, ParamZone.LabelOnly, Val(Expr.Absent{span: span, id: AST_NODE_GENERATED})),
    }
    bound: sema_ui_handle_bind_callback_args("button", args, span, "on_click", params, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if bound.len() != 4 {
        ^_: sema_reactive_infer_args(bound, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if sema_expression_absent_none(bound[3].expr) {
        check.diagnostics.push(sema_error("E2910", span, "`button` with a shortcut or label needs its click lambda", "the shortcut and accessible label belong to the click form, whose handler is the `fn() {{ … }}` argument after them", "write `ui.button(\"Save\", shortcut: …, fn() {{ save() }})`"))
        ^_: sema_reactive_infer_args(args, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    label: sema_ui_handle_typed_arg(bound[0], Type.String, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    shortcut: sema_ui_handle_optional_arg(bound[1], Type.Named{name: "UIShortcut"}, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    accessible_label: sema_ui_handle_optional_arg(bound[2], Type.String, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    callback: sema_ui_handle_stored_callback("button on_click", bound[3], [Type]{}, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ^result_type: Type.Named{name: "UINode"}
    ^click: sema_tree_node(Type.Int, TExprKind.CoreClosureCall{kind: TCoreClosureKind.UIClickSlot{executable: callback}}, span)
    if sema_call_core_module_identity(check.environment.*, check.program.*, "core.ui") == None {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    value: sema_call_core_role_source("ButtonClick", [TExpr]{label, shortcut, accessible_label, click}, result_type, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    checked: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_reactive_call_fact(check, "core.ui.button", span, result_type, [Type]{}, "Browser") {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    SemaDirectSpecialCheck{handled: true, value: Val(checked)}
}

sema_ui_handle_text_input: fn(args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck Never! {
    params: [SemaCallParam]{
        sema_ui_handle_callback_param("state", "state", Type.String, span, AccessConvention.Read, ParamZone.PositionalOnly, None),
        sema_ui_handle_callback_param("ime", "ime", Type.Named{name: "UIIMEMode"}, span, AccessConvention.Read, ParamZone.PositionalOnly, None),
        sema_ui_handle_callback_param("on_drop", "on_drop", Type.Option{inner: sema_ui_handle_callback_type([Type]{Type.Named{name: "UIDropItem"}})}, span, AccessConvention.Move, ParamZone.LabelOnly, Val(Expr.Absent{span: span, id: AST_NODE_GENERATED})),
        sema_ui_handle_callback_param("on_change", "on_change", Type.Option{inner: sema_ui_handle_callback_type([Type]{Type.String})}, span, AccessConvention.Move, ParamZone.LabelOnly, Val(Expr.Absent{span: span, id: AST_NODE_GENERATED})),
    }
    bound: sema_ui_handle_bind_callback_args("text_input", args, span, "on_drop", params, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if bound.len() != 4 {
        ^_: sema_reactive_infer_args(bound, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    state_value: sema_ui_handle_typed_arg(bound[0], Type.String, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ime_value: sema_ui_handle_typed_arg(bound[1], Type.Named{name: "UIIMEMode"}, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    result_type: Type.Named{name: "UINode"}
    on_drop_absent: sema_expression_absent_none(bound[2].expr)
    on_change_absent: sema_expression_absent_none(bound[3].expr)
    if on_drop_absent && on_change_absent {
        value: sema_call_core_source("core.ui", "text_input", [TExpr]{state_value, ime_value}, result_type, false, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        return SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
    }
    ^drop_slot: sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
    if !on_drop_absent {
        callback: sema_ui_handle_stored_callback("text_input on_drop", bound[2], [Type]{Type.Named{name: "UIDropItem"}}, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        drop_slot = sema_tree_node(Type.Int, TExprKind.CoreClosureCall{kind: TCoreClosureKind.UIDropSlot{executable: callback}}, span)
    }
    ^role: SEMA_CORE_ROLE_TEXT_INPUT_DROP
    ^slots: [TExpr]{state_value, ime_value}
    if on_change_absent -> slots.push(drop_slot) else {
        callback: sema_ui_handle_stored_callback("text_input on_change", bound[3], [Type]{Type.String}, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        slots.push(sema_tree_node(Type.Int, TExprKind.CoreClosureCall{kind: TCoreClosureKind.UIClickSlot{executable: callback}}, span))
        slots.push(drop_slot)
        role = SEMA_CORE_ROLE_TEXT_INPUT_CHANGE
    }
    graph: check.program.registration_graph
    builder: sema_core_role_function(graph, role) ?? {
        check.diagnostics.push(sema_missing_core_role(role, span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    value: sema_call_core_source("core.ui", builder.name, slots, result_type, true, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    checked: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_reactive_call_fact(check, "core.ui.text_input", span, result_type, [Type]{}, "Browser") {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    SemaDirectSpecialCheck{handled: true, value: Val(checked)}
}

sema_ui_handle_reactive_render: fn(args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if args.len() != 1 {
        check.diagnostics.push(sema_wrong_core_arity("reactive_render", 1, args.len(), span))
        ^_: sema_reactive_infer_args(args, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_call_core_check_type_args("core.ui", "reactive_render", 0, false, type_args, span, check.diagnostics) {
        ^_: sema_reactive_infer_args(args, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    result_type: sema_reactive_unit_type()
    callback: sema_reactive_check_retained_lambda("reactive_render", args[0], Val(result_type), None, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ^value: sema_tree_node(result_type, TExprKind.CoreClosureCall{kind: TCoreClosureKind.UIReactiveRender{executable: callback}}, span)
    checked: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_reactive_call_fact(check, "core.ui.reactive_render", span, result_type, [Type]{}, "Browser") {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    SemaDirectSpecialCheck{handled: true, value: Val(checked)}
}

sema_call_try_ui_core_call: fn(module_name: String, member: String, alias: String, alias_span: Span, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if module_name == "core.ui" && member == "asset" {
        if !sema_ui_asset_refused(args, check) {
            return SemaDirectSpecialCheck{handled: false, value: None}
        }
        if sema_call_core_import_target(check.environment.*, check.program.*, alias) == .Val(imported) {
            _: sema_call_core_record_import_reference(check, imported, alias_span)
        }
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if module_name != "core.ui" || (member != "button" && member != "text_input" && member != "reactive_render") {
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    imported: sema_call_core_import_target(check.environment.*, check.program.*, alias) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    if !sema_call_core_record_import_reference(check, imported, alias_span) {
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    if member == {
        "button" -> sema_ui_handle_button(args, span, expected, check)
        "text_input" -> sema_ui_handle_text_input(args, span, expected, check)
        else -> sema_ui_handle_reactive_render(args, type_args, span, expected, check)
    }
}

// A UI backend's `set_focus_group` (a Core source method) lints the focus
// ring it is given.
sema_call_ui_backend_lint: fn(receiver_value: TExpr, method: String, args: [CallArg], span: Span, check: ^SemaBodyCheck) {
    if method != "set_focus_group" {
        return
    }
    owner: sema_expr_type_base_name(receiver_value.ty) ?? type_name(receiver_value.ty)
    if owner == "NullBackend" || owner == "TUIBackend" || core_identity_is(owner, "core.ui", "NullBackend") || core_identity_is(owner, "core.ui", "TUIBackend") {
        sema_call_core_ui_focus_group_lint(args, span, check)
    }
}
