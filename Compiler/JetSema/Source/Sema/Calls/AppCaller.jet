// `app.caller()` is the signed-in account, so a path that reaches it must
// start where one is certain: at an `#App.SignedIn` method or the check its
// `#App.UploadCheck` names, or inside `app.as_caller`'s run. Every other
// path is E2815, named from where it starts: an `#App.Public` method, a
// webhook or its signing-key method, any function nothing in the program
// calls (the entry, a test, a handler passed as a value), and a `task`
// spawned where a caller is certain, since a spawned task acts for no
// account.
use jet_foundation.[
    CompilerThreads,
    Diagnostic,
    FnBody,
    Func,
    Marker,
    ModuleID,
    NodeKind,
    Span,
    SymbolID,
    body_each_expr_child,
    body_each_stmt_child,
    body_node,
    compiler_threads_admit,
    compiler_threads_failure_text,
    compiler_threads_partition,
    diagnostic_registry_row,
    module_is_core,
    symbol_find,
    symbol_is_local,
    symbol_key,
    Type,
    type_name,
]

// A checked function outside Core: its symbol and where its body is.
SemaAppCallerFunction: struct {
    symbol: U32,
    module_index: Int,
    function_index: Int,
}

// What the walk reads beside the graph and the checked modules: the
// functions outside Core, each one's row by symbol, the `#App.SignedIn`
// methods, and the symbols of `app.caller` and `app.as_caller`.
SemaAppCallerProgram: struct {
    functions: [SemaAppCallerFunction],
    rows: [U32:Int],
    signed_in: [U32:Bool],
    caller: U32,
    as_caller: U32,
}

// Whether the walk is where a caller is certain: inside an `#App.SignedIn`
// method or `app.as_caller`'s run.
SemaAppCallerAccount: enum {
    Uncertain,
    Certain,
}

// What a walk has seen: the functions it walked (each once over all roots
// where a caller is uncertain, and once where it is certain, so a reached
// `app.caller()` is reported once, from the first root that reaches it),
// where the path it is on starts, the path from there to the function it is
// in, and the reports.
SemaAppCallerWalk: struct {
    visited: [U32:Bool],
    certain_visited: [U32:Bool],
    root: String,
    path: [String],
    reports: [SemaAppCallerReport],
}

SemaAppCallerReport: struct {
    module_index: Int,
    diagnostic: Diagnostic,
}

// The E2815 reports of the program. A program outside Core that never
// calls `app.caller` walks nothing: one read of its checked nodes finds
// that (SemaAppCallerRead.Nodes), with no walk of its bodies. The reads take
// each function on its own, so they run on as many of `threads` as the
// bodies admit (sema_app_caller_scans), their parts joined in function
// order: the program, the gate and the reports are the same for any thread
// count.
sema_app_caller_diagnostics: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], threads: CompilerThreads) -> [Diagnostic] {
    // `app.caller` and `app.as_caller` as a call resolves them: the app
    // module's own declarations.
    app_index: loop index in 0..<graph.modules.len() {
        if module_is_core(graph.modules[index].module_identity) && graph.modules[index].module_name == SEMA_APP_MARKER_MODULE {
            break index
        }
    } ?? return [Diagnostic]{}
    caller: sema_registration_direct_symbol(graph.modules[app_index], "caller") ?? return [Diagnostic]{}
    as_caller: sema_registration_direct_symbol(graph.modules[app_index], "as_caller") ?? return [Diagnostic]{}
    places := [SemaAppCallerPlace]{}
    weights := [Int]{}
    work := 0
    loop module_index in 0..<modules.len() {
        if module_is_core(modules[module_index].module_identity) -> next
        loop function_index in 0..<modules[module_index].functions.len() {
            places.push(SemaAppCallerPlace{module_index: module_index, function_index: function_index})
            weight: 1 + modules[module_index].functions[function_index].tree.nodes.len()
            weights.push(weight)
            work += weight
        }
    }
    workers: compiler_threads_admit(threads, places.len(), work, SEMA_APP_CALLER_NODES_PER_THREAD, 0, 0)
    bounds: if workers <= 1 -> [Int]{0, places.len()} else -> compiler_threads_partition(weights, workers)
    caller_id: caller.symbol.id.id
    gates: sema_app_caller_scans(graph, modules, places, bounds, 0, caller_id, SemaAppCallerRead.Nodes)
    named := false
    loop scan in gates {
        if scan.reached -> named = true
    }
    if !named -> return [Diagnostic]{}
    scans: sema_app_caller_scans(graph, modules, places, bounds, 0, caller_id, SemaAppCallerRead.Walk)
    reached := false
    loop scan in scans {
        if scan.reached -> reached = true
    }
    if !reached -> return [Diagnostic]{}
    program := SemaAppCallerProgram{functions: [SemaAppCallerFunction]{}, rows: [U32:Int]{}, signed_in: [U32:Bool]{}, caller: caller_id, as_caller: as_caller.symbol.id.id}
    loop scan in scans {
        loop function in scan.functions {
            program.rows[function.symbol] = program.functions.len()
            program.functions.push(function)
        }
    }
    // What the functions call: the functions outside Core they reach, and
    // `app.caller`, read from the bodies as the walk reads them.
    called := [U32:Bool]{}
    loop scan in scans {
        loop (symbol, _) in scan.callees {
            if symbol == program.caller || program.rows.get(symbol) != None -> called[symbol] = true
        }
    }
    // The marked methods: a public one, a webhook and a signing key each
    // start a path, before the others, so a report names the marked method
    // its path starts at; a signed-in one, and the check of a signed-in
    // upload, has its caller, so only a task it spawns starts one.
    signed_in := [Int]{}
    marked := [Int]{}
    loop module_row in graph.modules {
        if module_is_core(module_row.module_identity) -> next
        loop nominal in module_row.nominals {
            loop method in nominal.methods {
                loop marker in method.declaration.markers {
                    row: program.rows.get(method.symbol.id.id) ?? next
                    access: sema_app_endpoint_access(marker, graph, module_row.module_identity)
                    if {
                        (access ?? "") == "SignedIn" -> {
                            program.signed_in[method.symbol.id.id] = true
                            signed_in.push(row)
                        }
                        access != None || sema_app_marker_is(marker, SEMA_APP_WEBHOOK_MARKER, graph, module_row.module_identity) || sema_app_marker_is(marker, SEMA_APP_SIGNING_KEY_MARKER, graph, module_row.module_identity) -> {
                            marked.push(row)
                        }
                        sema_app_marker_is(marker, SEMA_APP_UPLOAD_CHECK_MARKER, graph, module_row.module_identity) -> {
                            check: sema_app_caller_upload_check(nominal, method.declaration, marker, graph, module_row.module_identity) ?? next
                            check_row: program.rows.get(check) ?? next
                            program.signed_in[check] = true
                            signed_in.push(check_row)
                        }
                        else -> {}
                    }
                }
            }
        }
    }
    walk := SemaAppCallerWalk{visited: [U32:Bool]{}, certain_visited: [U32:Bool]{}, root: "", path: [String]{}, reports: [SemaAppCallerReport]{}}
    loop row in marked {
        sema_app_caller_root(graph, modules, program, row, SemaAppCallerAccount.Uncertain, walk)
    }
    loop row in signed_in {
        sema_app_caller_root(graph, modules, program, row, SemaAppCallerAccount.Certain, walk)
    }
    loop row in 0..<program.functions.len() {
        symbol: program.functions[row].symbol
        if called.get(symbol) != None || program.signed_in.get(symbol) != None -> next
        sema_app_caller_root(graph, modules, program, row, SemaAppCallerAccount.Uncertain, walk)
    }
    diagnostics := [Diagnostic]{}
    loop report in walk.reports.move() {
        start: diagnostics.len()
        diagnostics.push(report.diagnostic)
        registration: sema_registration_module_index(graph, modules[report.module_index].module_identity) ?? next
        sema_attach_diagnostic_source_locations(diagnostics, start, graph.modules[registration].source_segments)
    }
    diagnostics
}

// The run-wide symbol of the method of `nominal` that the `#App.UploadCheck`
// `marker` of its signed-in method `endpoint` names by a literal: the server
// runs the check as the upload's caller. None when `endpoint` isn't
// signed-in or the marker names no method so.
sema_app_caller_upload_check: fn(nominal: SemaRegistrationNominal, endpoint: Func, marker: Marker, graph: SemaRegistrationGraph, module_identity: ModuleID) -> U32? {
    signed_in: loop other in endpoint.markers {
        if (sema_app_endpoint_access(other, graph, module_identity) ?? "") == "SignedIn" {
            break true
        }
    } ?? false
    if !signed_in -> return None
    at: sema_app_marker_arg_at(marker, "method", 0) ?? return None
    name: if marker.args[at] == .Expr(value) -> sema_ui_handle_literal_string(value) ?? return None else -> {
        return None
    }
    loop checked in nominal.methods {
        if checked.declaration.name == name -> return Val(checked.symbol.id.id)
    }
    None
}

// The run-wide symbol of the function a node calls directly, or names as a
// value; None for any other node.
sema_app_caller_callee: fn(graph: SemaRegistrationGraph, function: FnBody, kind: NodeKind) -> U32? Never! {
    if kind == .Call(callee, _, _) -> return Val(graph.decls.rows[callee.row].symbol.id)
    if kind == .MethodCall(_, method, _, _) {
        return sema_app_caller_symbol(graph, function, method.symbol)
    }
    if kind == .StaticCall(_, _, method, _, _) {
        return sema_app_caller_symbol(graph, function, method.symbol)
    }
    if kind == .FnValue(value) {
        if value == .NamedFn(named, _) {
            if named == .Val(callee) -> return Val(graph.decls.rows[callee.row].symbol.id)
        }
    }
    None
}

// A method's run-wide symbol: a body-local one is found by its key.
sema_app_caller_symbol: fn(graph: SemaRegistrationGraph, function: FnBody, symbol: SymbolID) -> U32? Never! {
    if !symbol_is_local(symbol) -> return Val(symbol.id)
    found: symbol_find(graph.symbols, symbol_key(graph.symbols, function.tree.symbols, symbol)) ?? return None
    Val(found.id)
}

// The name a path shows for `function`: `Owner.name` for a method and
// `test "name"` for a `#Test` block's function.
sema_app_caller_name: fn(function: FnBody) -> String Never! {
    if function.kind == {
        .Method(_, owner) | .TraitMethod(_, _, owner, _, _) -> {
            return "{type_name(owner)}.{function.name}"
        }
        .TopLevel -> {}
    }
    if function.synthetic && function.name.cut_last("test.") == .Val(test) {
        if test.after.cut_last("@") == .Val(named) -> return "test \"{named.before}\""
    }
    "{function.name}"
}

// The functions outside Core the app.caller scan reads: where each one's
// body is.
SemaAppCallerPlace: struct {
    module_index: Int,
    function_index: Int,
}

// One part of the scan: whether it reaches `app.caller`, and as
// SemaAppCallerRead.Walk reads it, its functions that have a run-wide
// symbol, in order, and every symbol their bodies call or name.
SemaAppCallerScan: struct {
    reached: Bool,
    functions: [SemaAppCallerFunction],
    callees: [U32:Bool],
}

// How a scan reads a function. `Nodes`, the gate: every node of its checked
// tree, in place, for a call of `app.caller`. The walk reads only nodes of
// the tree, so a function the gate finds no call in has none the walk
// finds. `Walk`: its body as the walk reads it, statement by statement.
SemaAppCallerRead: enum {
    Nodes,
    Walk,
}

// The app.caller scan's threads (compiler_threads_admit): a thread is
// admitted for at least this many body nodes, a few milliseconds of
// lookups.
SEMA_APP_CALLER_NODES_PER_THREAD: 20000

// The scans of the parts from bounds `at` on, each but the last on a task of
// its own, in part order.
sema_app_caller_scans: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], places: [SemaAppCallerPlace], bounds: [Int], at: Int, caller: U32, read: SemaAppCallerRead) -> [SemaAppCallerScan] Never! {
    done := [SemaAppCallerScan]{}
    if at + 1 >= bounds.len() -> return done
    from: bounds[at]
    to: bounds[at + 1]
    if at + 2 == bounds.len() {
        done.push(sema_app_caller_scan(graph, modules, places, from, to, caller, read))
        return done
    }
    task.group sema_app_caller_scan_threads {
        head: task sema_app_caller_scan(graph, modules, places, from, to, caller, read)
        rest: sema_app_caller_scans(graph, modules, places, bounds, at + 1, caller, read)
        done.push(head.join() ?? panic(compiler_threads_failure_text(err)))
        loop part in rest.move() -> done.push(part)
    }
    done
}

// The scan of functions `from..<to` of `places` for `app.caller`
// (`caller`), read as `read` says.
sema_app_caller_scan: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], places: [SemaAppCallerPlace], from: Int, to: Int, caller: U32, read: SemaAppCallerRead) -> SemaAppCallerScan Never! {
    scan := SemaAppCallerScan{reached: false, functions: [SemaAppCallerFunction]{}, callees: [U32:Bool]{}}
    loop index in from..<to {
        place: places[index]
        function: modules[place.module_index].functions[place.function_index]
        if read == .Nodes {
            if sema_app_caller_names(graph, function, caller) {
                scan.reached = true
                return scan
            }
            next
        }
        symbol: symbol_find(graph.symbols, function.key) ?? next
        scan.functions.push(SemaAppCallerFunction{symbol: symbol.id, module_index: place.module_index, function_index: place.function_index})
        sema_app_caller_scan_calls(graph, function, scan.callees)
    }
    if read == .Walk -> scan.reached = scan.callees.get(caller) != None
    scan
}

// Whether a node of `function`'s checked tree calls or names `caller`.
sema_app_caller_names: fn(graph: SemaRegistrationGraph, function: FnBody, caller: U32) -> Bool Never! {
    loop node in function.tree.nodes {
        if sema_app_caller_callee(graph, function, node.kind) == .Val(named) && named == caller {
            return true
        }
    }
    false
}

// Adds each symbol `function` calls or names to `callees`.
sema_app_caller_scan_calls: fn(graph: SemaRegistrationGraph, function: FnBody, callees: ^[U32:Bool]) Never! {
    loop i in 0..<function.tree.nodes.len() {
        if sema_app_caller_callee(graph, function, function.tree.nodes[i].kind) == .Val(symbol) {
            callees[symbol] = true
        }
    }
}

// Walks a root: one where a caller is certain (a signed-in method) only for
// the tasks it spawns, any other as where a path starts.
sema_app_caller_root: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], program: SemaAppCallerProgram, row: Int, account: SemaAppCallerAccount, walk: ^SemaAppCallerWalk) Never! {
    entry: program.functions[row]
    walk.root = "`{sema_app_caller_name(modules[entry.module_index].functions[entry.function_index])}`"
    sema_app_caller_function(graph, modules, program, row, account, walk)
}

// Walks function `row`'s body once for each `account`, as the next step of
// the walk's path.
sema_app_caller_function: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], program: SemaAppCallerProgram, row: Int, account: SemaAppCallerAccount, walk: ^SemaAppCallerWalk) Never! {
    entry: program.functions[row]
    if account == {
        .Certain -> {
            if walk.certain_visited.get(entry.symbol) != None {
                return
            }
            walk.certain_visited[entry.symbol] = true
        }
        .Uncertain -> {
            if walk.visited.get(entry.symbol) != None {
                return
            }
            walk.visited[entry.symbol] = true
        }
    }
    function: modules[entry.module_index].functions[entry.function_index]
    walk.path.push(sema_app_caller_name(function))
    loop statement in function.body {
        sema_app_caller_statement(graph, modules, program, entry.module_index, function, statement, account, walk)
    }
    _: walk.path.pop()
}

// One statement of a walked body. Its own function so the visitor closure
// is the last use of the `walk` write parameter (as in PureRoot.jet).
sema_app_caller_statement: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], program: SemaAppCallerProgram, module_index: Int, function: FnBody, statement: Int, account: SemaAppCallerAccount, walk: ^SemaAppCallerWalk) Never! {
    body_each_stmt_child(function.tree, function.tree.stmts[statement], fn(expression: Int) { sema_app_caller_expr(graph, modules, program, module_index, function, expression, account, walk) })
}

// Where a caller is uncertain, a call to `app.caller` reports the path and
// `app.as_caller`'s run is walked as certain. Where it is certain, a spawned
// `task` starts a path, since it acts for no account. A call into another
// function outside Core walks it, and a signed-in method as certain however
// it is reached; a lambda's body is walked where it is written.
sema_app_caller_expr: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], program: SemaAppCallerProgram, module_index: Int, function: FnBody, expression: Int, account: SemaAppCallerAccount, walk: ^SemaAppCallerWalk) Never! {
    node: body_node(function.tree, expression)
    callee: sema_app_caller_callee(graph, function, node.kind) ?? U32{0}
    certain: account == .Certain
    if callee == program.caller {
        if certain {
            return
        }
        walk.reports.push(SemaAppCallerReport{module_index: module_index, diagnostic: sema_app_caller_report(walk.root, walk.path, node.span)})
        return
    }
    if certain && sema_app_caller_spawns(node.kind) {
        sema_app_caller_spawn(graph, modules, program, module_index, function, expression, walk)
        return
    }
    inner: if certain || callee == program.as_caller -> SemaAppCallerAccount.Certain else -> SemaAppCallerAccount.Uncertain
    if program.rows.get(callee) == .Val(row) {
        reached: if program.signed_in.get(callee) != None -> SemaAppCallerAccount.Certain else -> inner
        sema_app_caller_function(graph, modules, program, row, reached, walk)
    }
    body_each_expr_child(function.tree, node, fn(child: Int) { sema_app_caller_expr(graph, modules, program, module_index, function, child, inner, walk) })
}

// Whether a node spawns a `task`.
sema_app_caller_spawns: fn(kind: NodeKind) -> Bool Never! {
    if kind == .CoreClosureCall(closure) -> return closure == .Spawn(_, _, _, _)
    false
}

// A `task` spawned where a caller is certain: its body starts a path.
sema_app_caller_spawn: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], program: SemaAppCallerProgram, module_index: Int, function: FnBody, expression: Int, walk: ^SemaAppCallerWalk) Never! {
    outer: "{walk.root}"
    walk.root = "a `task` spawned in `{sema_app_caller_name(function)}`"
    walk.path.push("task")
    body_each_expr_child(function.tree, body_node(function.tree, expression), fn(child: Int) { sema_app_caller_expr(graph, modules, program, module_index, function, child, SemaAppCallerAccount.Uncertain, walk) })
    _: walk.path.pop()
    walk.root = outer
}

sema_app_caller_report: fn(root: String, path: [String], span: Span) -> Diagnostic {
    entry: diagnostic_registry_row("E2815") ?? panic("E2815 must have a registry row")
    steps: "{path.join(" → ")} → app.caller()"
    sema_error("E2815", span, entry.what.replace("{{root}}", root), entry.why.replace("{{path}}", steps), entry.fix)
}
