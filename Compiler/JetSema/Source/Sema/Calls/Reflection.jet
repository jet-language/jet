// Reflection call contracts and the shared displayability gate used by
// `core.reflect.of`. Runtime reflection may expose only values accepted by the
// same semantic predicate as display interpolation.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    InternalTag,
    MarkerDecl,
    ParamZone,
    Span,
    TagMarker,
    Type,
    core_identity_in_module,
    type_name,
]

sema_call_reflection_leaf_name: fn(name: String) -> String Never! {
    parts := name.split("::").to_list()
    canonical := if parts.len() > 0 -> parts[parts.len() - 1] else -> name
    dotted := canonical.split(".").to_list()
    if dotted.len() > 0 -> dotted[dotted.len() - 1] else -> canonical
}

// `reflect.of(x)` carries its checked names to the IR as text after the
// value: the type name and canonical path (`module.Type`, the ledger
// `T.reflect()` reads), then the value's stored struct fields as a preorder
// tree (sema_call_reflection_field_args).
sema_call_reflection_name_args: fn(ty: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable) -> [TExpr] {
    names: sema_call_reflection_type_names(ty, environment, program)
    args := [TExpr]{sema_call_reflection_text(names.type_name, span), sema_call_reflection_text(names.path, span)}
    sema_call_reflection_field_args(ty, span, environment, program, scopes, [String]{}, args)
    args
}

// One level of the field tree: the count of `ty`'s stored struct fields, then
// each field's name, type name and path followed by its own level, so a
// nested struct field reflects its fields too. A type already open on the
// way down lists no fields again.
sema_call_reflection_field_args: fn(ty: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, open: [String], args: &[TExpr]) {
    count_at: args.len()
    args.push(sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span))
    definition: sema_http_route_find_struct(environment, program, ty, environment.module_identity) ?? return
    path: sema_call_reflection_type_names(ty, environment, program).path
    if sema_call_reflection_has_name(open, path) -> return
    inner := [String]{path}
    loop name in open -> inner.push(name.copy())
    count := 0
    loop field in definition.fields {
        if field.computed != None -> next
        field_ty: sema_shared_access_field_type(ty, field.name, environment, program, scopes) ?? next
        field_names: sema_call_reflection_type_names(field_ty, environment, program)
        args.push(sema_call_reflection_text(field.name, span))
        args.push(sema_call_reflection_text(field_names.type_name, span))
        args.push(sema_call_reflection_text(field_names.path, span))
        sema_call_reflection_field_args(field_ty, span, environment, program, scopes, inner, args)
        count += 1
    }
    args[count_at] = sema_tree_node(Type.Int, TExprKind.IntLit{value: count, width: None}, span)
}

// A nominal type reflects as its declared name and `module.Name` path (the
// module path as an identifier: `reflect-value.jet` is `reflect_value`); any
// other type as its written spelling for both.
sema_call_reflection_type_names: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> (type_name: String, path: String) {
    if program.registration_graph == .Val(graph) {
        if sema_type_resolve_nominal_row(graph, ty, environment.module_identity) == .Val(row) {
            name: graph.modules[row.module_index].nominals[row.row].symbol.name
            if graph.modules[row.module_index].module_path == "" -> return (type_name: name, path: name)
            return (type_name: name, path: "{graph.modules[row.module_index].module_path.replace("-", "_")}.{name}")
        }
    }
    shown: type_name(ty)
    (type_name: shown, path: shown)
}

sema_call_reflection_text: fn(text: String, span: Span) -> TExpr Never! {
    sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: text}}}, span)
}

sema_call_reflection_secret_leaf: fn(name: String) -> Bool Never! {
    leaf: sema_call_reflection_leaf_name(name)
    leaf == "Secret" || leaf == "SigningKey" || leaf == "X25519SecretKey" || leaf == "SharedSecret"
}

// A Core crypto secret: tagged by a registry signature, or named by its
// canonical source identity (`<corelib>/core.crypto::Secret`).
sema_call_reflection_secret_bearing: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(marker, inner) -> {
            if marker == (TagMarker.Internal{internal_tag: InternalTag.CoreCryptoNominal}) {
                if inner == .Named(name) -> return sema_call_reflection_secret_leaf(name)
                return false
            }
            return sema_call_reflection_secret_bearing(inner)
        }
        .Named(name) -> core_identity_in_module(name, "core.crypto") && sema_call_reflection_secret_leaf(name)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// A source that can be read once: an iterator or stream, or core.http's
// request `Body` and its chunk reader (by their Core identity, so a user type
// with the same name is an ordinary value).
sema_call_reflection_one_pass: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, _) -> {
            leaf: sema_call_reflection_leaf_name(name)
            leaf == "Iter" || leaf == "ViewIter" || leaf == "Stream"
        }
        .Named(name) -> {
            leaf: sema_call_reflection_leaf_name(name)
            core_identity_in_module(name, "core.http") && (leaf == "Body" || leaf == "HTTPBodyChunks")
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_call_reflection_core_shown: fn(name: String) -> Bool Never! {
    leaf: sema_call_reflection_leaf_name(name)
    leaf == "Decimal" || leaf == "Fraction" || leaf == "MIME" || leaf == "ServiceUpgradeReceipt" || leaf == "ServiceWorkflow" || leaf == "TaskOutcome" || leaf == "TaskStatus" || leaf == "Complex" || leaf == "URL" || leaf == "Path" || leaf == "Date" || leaf == "Duration" || leaf == "LocalDate" || leaf == "LocalTime" || leaf == "DateTime" || leaf == "Instant" || leaf == "Period" || leaf == "Zone" || leaf == "ZonedDateTime" || leaf == "DataTracked" || leaf == "DataWatch" || leaf == "DataWatchStatus" || leaf == "DBValue" || leaf == "DBLease" || leaf == "DBPoolReceipt" || sema_core_error_family_member(name)
}

sema_call_reflection_bound: fn(ty: Type, bound: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
        if sema_type_bound_satisfied_at(graph, ty, bound, sema_scope_caller_row(environment, graph), environment.generic_params) == (Val(true)) -> return true
        // Imported nominal capabilities belong to their declaring registry. A
        // caller need not import the trait name as well as the displayed type.
        owner: sema_type_resolve_nominal_row_at(graph, ty, sema_scope_caller_row(environment, graph)) ?? return false
        nominal: graph.modules[owner.module_index].nominals[owner.row]
        sema_type_bound_satisfied_with_generics(graph, nominal.ty, bound, nominal.symbol.module_name, environment.generic_params) ?? false
    } else {
        return false
    }
}

sema_call_reflection_named_displayable: fn(name: String, ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    // S80 the Prelude-owned default error shows its message.
    if sema_call_reflection_core_shown(name) || sema_call_reflection_leaf_name(name) == "Err" -> return true
    if sema_call_reflection_synthetic_printable(name) -> return true
    if sema_call_reflection_bound(ty, "Display", environment, program) || sema_call_reflection_bound(ty, "Printable", environment, program) -> return true
    // A generic parameter bound by `Renderable` is anything interpolatable.
    loop param in environment.generic_params {
        if param.name == name -> return sema_call_reflection_bound(ty, "Renderable", environment, program)
    }
    false
}

// Rust `TraitRegistry::register_synthetic_display_debug`: the Core values the
// trait registry admits as `Printable` with no source impl (their Prelude
// `JetShow` hooks, every SIMD lane and the linear-algebra values), and the
// Core types it registers a `Display` impl for.
sema_call_reflection_synthetic_printable: fn(name: String) -> Bool Never! {
    leaf: sema_call_reflection_leaf_name(name)
    if sema_core_is_math_type(leaf) -> return true
    if leaf == {
        "ArgsSpec" | "AriaRole" | "Bits" | "BuildError" | "BrowserError" | "Bytes" | "Clock" | "DataError" |
        "DataTracked" | "DataWatch" | "DataWatchStatus" | "Dyn" | "DBValue" | "DBConnection" | "DBLease" | "DBPoolReceipt" | "Date" |
        "DateTime" | "Decimal" | "FieldError" | "DirEntry" | "DNSSRV" | "Duration" | "EncodingError" |
        "EnvError" | "EventResult" | "Field" | "FileLock" | "GameAssets" | "GameBackend" | "GameFrame" | "GameImage" |
        "GameInputMap" | "GameInputSnapshot" | "GameReplay" | "GameScene" | "GameSound" | "HTTPError" | "HTTPHeaderName" |
        "HTTPHeaderValue" | "HTTPMethod" | "HTTPRequest" | "HTTPResponse" | "HTTPStatus" | "HTTPVersion" |
        "ID" | "Instant" | "IOError" | "IPAddr" | "JSON" | "Key" | "LocalDate" | "LocalTime" | "Cache" | "Measurement" |
        "MIME" | "NetError" | "ParsedArgs" | "Path" | "Period" | "Point" | "Pool" | "ProcessChild" | "ProcessReceipt" |
        "ProcessResult" | "ProcessSpec" | "Quat" | "Range" | "RangeError" | "Rect" | "ReflectField" | "ReflectValue" |
        "Regex" | "RegexFlags" | "RegexMatch" | "RNG" | "Size" | "SocketAddr" | "Solver" | "Stat" | "Stopwatch" | "Test" |
        "TcpListener" | "TcpStream" | "TempDir" | "TempFile" | "TextError" | "PluginError" | "TLSStream" | "TLSVersion" |
        "UDPPacket" | "UdpSocket" | "UnixListener" | "UnixStream" | "URL" | "UTF8Error" | "Value" | "Zone" | "ZonedDateTime" |
        "ComputeDevice" | "SyncText" | "SyncCounter" | "SyncMap" | "SyncList" | "ServiceRestart" | "ServiceDelivery" |
        "ServiceRuntime" | "ServiceStateStore" -> true
        else -> false
    }
}

sema_call_reflection_is_displayable: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if sema_call_reflection_secret_bearing(ty) || sema_call_reflection_one_pass(ty) -> return false
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 -> return true
        .Option(inner) -> return sema_call_reflection_is_displayable(inner, environment, program)
        .Result(ok, err) -> return sema_call_reflection_is_displayable(ok, environment, program) && sema_call_reflection_is_displayable(err, environment, program)
        .List(inner) -> return sema_call_reflection_is_displayable(inner, environment, program)
        .Map(key, _, value) -> return sema_call_reflection_is_displayable(key, environment, program) && sema_call_reflection_is_displayable(value, environment, program)
        .Named(name) -> return sema_call_reflection_leaf_name(name) == "Unit" || sema_call_reflection_named_displayable(name, ty, environment, program)
        .Quantity(_, _) -> return true
        .Apply(name, args) -> {
            // A string view shows its text, as the String it borrows from.
            if sema_stmt_string_view_type(ty) -> return true
            leaf: sema_call_reflection_leaf_name(name)
            if sema_call_reflection_bound(ty, "Display", environment, program) -> return true
            native_composite: leaf == "List" || leaf == "Set" || leaf == "Rank" || leaf == "PriorityQueue" || leaf == "Queue" || leaf == "LRU" || leaf == "ExpiringValue" || leaf == "Loadable" || leaf == "View"
            if !native_composite && !sema_call_reflection_named_displayable(name, ty, environment, program) -> return false
            loop argument in args {
                if !sema_call_reflection_is_displayable(argument, environment, program) -> return false
            }
            return true
        }
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_call_reflection_is_displayable(field.ty, environment, program) -> return false
            }
            return true
        }
        .TraitObject(bounds) -> return sema_call_reflection_has_name(bounds, "Renderable")
        .Shared(_) | .Fn(_, _, _, _, _, _) | .Measure(_) -> return false
        .FixedList(element, _) | .Tagged(_, element) | .InlineRange(element, _, _) -> return sema_call_reflection_is_displayable(element, environment, program)
        .Union(members) -> {
            loop member in members {
                if !sema_call_reflection_is_displayable(member, environment, program) -> return false
            }
            return true
        }
    }
}

sema_call_reflection_has_name: fn(names: [String], wanted: String) -> Bool Never! {
    loop name in names {
        if name == wanted || sema_call_reflection_leaf_name(name) == wanted -> return true
    }
    false
}

// Apply the runtime reflection gate after the normal Core argument checker has
// inferred the value. This keeps argument evaluation and ownership in the
// ordinary call path while centralizing secret/display diagnostics. A value
// reflects exactly where bare `"{x}"` interpolation shows it.
sema_call_reflection_validate_value: fn(value: TExpr, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Bool {
    if sema_expression_displayable(value.ty, environment, program) -> return true
    if value.ty == .Named(name) && sema_call_reflection_leaf_name(name) == "Unit" -> return true
    if {
        sema_call_reflection_secret_bearing(value.ty) -> {
            diagnostics.push(sema_error("E0112", span, "secret-bearing `{type_name(value.ty)}` cannot be reflected", "reflection would expose a cryptographic secret through generic inspection or display", "keep the value opaque; inspect only public keys, signatures, digests, or envelope metadata"))
        }
        else -> {
            diagnostics.push(sema_error("E0112", span, "{type_name(value.ty)} can't be reflected yet", "`reflect.of` inspects the same values `\"{{x}}\"` interpolation can show", "implement `Display` for its type, or pass one of its fields instead"))
        }
    }
    false
}

// Runtime handle method contracts shared by direct method dispatch.
sema_call_reflection_method_return: fn(type_name: String, method: String, args: [Type]) -> Type? {
    if type_name == "Value" {
        if args.len() != 0 -> return None
        if method == "type_name" || method == "path" || method == "display" -> return Val(Type.String)
        if method == "fields" -> return Val(Type.List{element: Type.Named{name: "Field"}})
    }
    if type_name == "Field" && args.len() == 0 {
        if method == "name" -> return Val(Type.String)
        if method == "value" -> return Val(Type.Named{name: "Value"})
    }
    if type_name == "TypeInfo" && (method == "has_marker" || method == "implements" || method == "has_method") {
        if args.len() != 1 || args[0] != Type.String -> return None
        return Val(Type.Bool)
    }
    if (type_name == "FieldInfo" || type_name == "MethodInfo") && method == "has_marker" {
        if args.len() != 1 || args[0] != Type.String -> return None
        return Val(Type.Bool)
    }
    None
}

sema_call_reflection_metadata_owner: fn(ty: Type) -> String? {
    if ty == {
        .Tagged(_, inner) -> return sema_call_reflection_metadata_owner(inner)
        .Named(name) | .Apply(name, _) -> return Val(sema_call_reflection_leaf_name(name))
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Quantity(_, _) | .Measure(_) -> None
    }
}

sema_call_reflection_metadata_method: fn(owner: String, method: String) -> Bool Never! {
    if owner == "TypeInfo" -> return method == "has_marker" || method == "implements" || method == "has_method" || method == "marker"
    if owner == "FieldInfo" || owner == "MethodInfo" -> return method == "has_marker" || method == "marker"
    false
}

// The marker struct a `marker(T)` argument names: `T` or a dotted path to it.
sema_call_reflection_marker_name: fn(expression: Expr) -> String? Never! {
    if expression == .Ident(name, _, _) -> return Val(name.copy())
    if expression == .Field(base, member, _, _) {
        owner: sema_call_reflection_marker_name(base) ?? return None
        return Val("{owner}.{member}")
    }
    None
}

// `info.marker(T)` on a TypeInfo, FieldInfo or MethodInfo: the marker `T`
// written on the reflected item, read as a `T` whose fields are its
// arguments, or None when the item does not carry it. `T` names a marker
// struct (one with an `impl Marker` block) visible here, else E1134. The host
// call carries the marker's name, then each parameter with a declared default
// as its name and default value, which fill the arguments the use site left
// out (jet_eval_reflection_marker_value).
sema_call_reflection_marker_lookup: fn(
    owner: String,
    receiver: Expr,
    receiver_value: TExpr,
    args: [CallArg],
    span: Span,
    expected: Type?,
    environment: SemaScopeEnvironment, program: SemaProgramTables,
    scopes: &SemaScopeTable,
    state: &SemaOwnershipState,
    tail_store: &SemaStatementTailStore,
    context: &SemaCheckContext,
    diagnostics: &[Diagnostic],
) -> SemaMethodSpecialCheck {
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() != 1 || args[0].label != None {
        diagnostics.push(sema_error("E0104", span, "`{owner}.marker` expects one marker type, got {args.len()} arguments", "`marker(T)` reads the one marker `T` written on the reflected item", "call `.marker(T)` with the marker struct's name"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    written: sema_call_reflection_marker_name(args[0].expr) ?? ""
    declaration := MarkerDecl?{None}
    if written != "" && program.registration_graph == .Val(graph) -> declaration = sema_marker_module_resolve(graph, environment.module_identity, written).declaration
    marker: declaration ?? {
        shown: if written == "" -> "this argument" else -> "`{written}`"
        diagnostics.push(sema_error("E1134", args[0].span, "{shown} is not a marker", "`marker(T)` reads the marker `T` written on a reflected item, so `T` names a struct with an `impl Marker` block", "name a marker struct visible here, or test a marker by name with `has_marker`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_effect_record_intrinsic_effects(environment, program, scopes, context, "{owner}.marker", span, [EffectRowEntry]{}, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    host_args := [TExpr]{sema_call_reflection_text(marker.name, span)}
    loop param in marker.params {
        if param.name.starts_with("$") -> next
        default: param.value ?? next
        checked: sema_check_expression(default, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? next
        host_args.push(sema_call_reflection_text(param.name, span))
        host_args.push(checked)
    }
    marker_type: sema_call_resolved_type(Type.Named{name: written}, environment, program)
    value := sema_tree_node(Type.Option{inner: marker_type}, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: "marker", args: host_args}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

sema_call_try_reflection_metadata_method: fn(
    receiver: Expr,
    receiver_value: TExpr,
    method: String,
    args: [CallArg],
    span: Span,
    expected: Type?,
    environment: SemaScopeEnvironment, program: SemaProgramTables,
    scopes: &SemaScopeTable,
    state: &SemaOwnershipState,
    tail_store: &SemaStatementTailStore,
    context: &SemaCheckContext,
    diagnostics: &[Diagnostic],
) -> SemaMethodSpecialCheck {
    owner: sema_call_reflection_metadata_owner(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_call_reflection_metadata_method(owner, method) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if method == "marker" -> return sema_call_reflection_marker_lookup(owner, receiver, receiver_value, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if args.len() != 1 {
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        diagnostics.push(sema_error("E0104", span, "`{owner}.{method}` expects one String argument, got {args.len()}", "metadata predicates inspect one marker, trait, or method name", "call `.{method}(name)` with one String"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    params := [SemaCallParam]{SemaCallParam{label: "name", name: "name", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.String), variadic: false}}
    checked_args := args
    binding: sema_call_bind_args("{owner}.{method}", params, checked_args, span, diagnostics) ?? {
        loop argument in checked_args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    typed: sema_call_typecheck_bound_arguments("{owner}.{method}", params, None, false, binding, checked_args, environment, program, scopes, state, tail_store, context, span, diagnostics, true) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    ownership := sema_ownership_check_method_call(state, "{owner}.{method}", receiver, AccessConvention.Read, params, checked_args, scopes, span, diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_effect_record_intrinsic_effects(environment, program, scopes, context, "{owner}.{method}", span, [EffectRowEntry]{}, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    result_type: sema_call_reflection_method_return(owner, method, [Type]{Type.String}) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tree_node(result_type, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: method, args: typed.values}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

sema_call_reflection_handle_operation: fn(owner: String, method: String) -> THandleOp? {
    if owner == "Value" {
        if method == "type_name" -> return Val(THandleOp.ReflectValueTypeName)
        if method == "path" -> return Val(THandleOp.ReflectValuePath)
        if method == "display" -> return Val(THandleOp.ReflectValueDisplay)
        if method == "fields" -> return Val(THandleOp.ReflectValueFields)
    }
    if owner == "Field" {
        if method == "name" -> return Val(THandleOp.ReflectFieldName)
        if method == "value" -> return Val(THandleOp.ReflectFieldValue)
    }
    None
}

sema_call_try_reflection_handle_method: fn(
    receiver: Expr,
    receiver_value: TExpr,
    method: String,
    args: [CallArg],
    span: Span,
    expected: Type?,
    environment: SemaScopeEnvironment, program: SemaProgramTables,
    scopes: &SemaScopeTable,
    state: &SemaOwnershipState,
    tail_store: &SemaStatementTailStore,
    context: &SemaCheckContext,
    diagnostics: &[Diagnostic],
) -> SemaMethodSpecialCheck {
    metadata := sema_call_try_reflection_metadata_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if metadata.handled -> return metadata
    owner: if receiver_value.ty == {
        .Named(name) -> name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> ""
    }
    operation: sema_call_reflection_handle_operation(owner, method)
    if operation == None -> return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if args.len() != 0 {
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_error("E0104", span, "`{owner}.{method}` takes no arguments, got {args.len()}", "reflection handle accessors only inspect their existing value", "call `.{method}()` with no arguments"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    result_type: sema_call_reflection_method_return(owner, method, [Type]{}) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}
