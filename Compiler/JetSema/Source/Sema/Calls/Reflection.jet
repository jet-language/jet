// Reflection call contracts and the shared displayability gate used by
// `core.reflect.of`. Runtime reflection may expose only values accepted by the
// same semantic predicate as display interpolation.
use jet_foundation.[
    BodyHandleOp,
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    InternalTag,
    IR_PRELUDE_MARKER_RECORD,
    MarkerDecl,
    ParamZone,
    Span,
    Symbol,
    TagMarker,
    Type,
    TypeParam,
    core_identity_in_module,
    symbol_key_leaf,
    type_carrier_identity,
    type_name,
]

sema_call_reflection_leaf_name: fn(name: String) -> String Never! { symbol_key_leaf(name) }

// `reflect.of(x)` carries its checked names to the IR as text after the
// value (sema_call_reflection_names), then the value's level
// (sema_call_reflection_level_args): its stored struct fields and enum cases
// as a preorder tree. None, with its E0112 reported at `value_span`, when a
// stored field or case payload can't be captured, or the value holds what a
// capture can't copy: a capture holds the whole value or refuses it. A field
// the capture can't hold is named first, since it says more than the whole
// value's copy gate (a secret-bearing field also makes its value one owner's).
sema_call_reflection_name_args: fn(ty: Type, span: Span, value_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, diagnostics: ^[Diagnostic]) -> [TExpr]? {
    args := [TExpr]{}
    sema_call_reflection_names(ty, span, environment, program, args)
    if !sema_call_reflection_level_args(ty, span, value_span, environment, program, scopes, [String]{}, args, diagnostics) {
        return None
    }
    held := ""
    facts: sema_copy_classify(ty, SemaCopyIntent.Clone, environment, program, environment.generic_params, false)
    if facts.holds_resource -> held = "resource state, which has one owner"
    if facts.dynamic_loan -> held = "a borrowed loan, which lives only as long as its lender"
    if sema_copy_holds_single_use_in(ty, environment, program) {
        held = "a `#SingleUse` value, whose one duty a copy would double"
    }
    if held != "" {
        diagnostics.push(sema_error("E0112", value_span, "`reflect.of` can't capture {sema_type_show(ty)}", "a capture keeps its own copy of the whole value, and {sema_type_show(ty)} holds {held}", "reflect the parts of the value that hold plain data instead"))
        return None
    }
    Val(args)
}

// The names a reflected value of `ty` carries: its type name and canonical
// path (sema_call_reflection_row_names, the text `T.reflect().path` reads), then
// the count of the types an erased trait value of `ty` may hold and each
// one's payload identity, type name and path, so the IR names a trait value
// by the type whose payload key its box holds (ir_trait_reflect_text). Any
// other type holds none.
sema_call_reflection_names: fn(ty: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, args: ^[TExpr]) {
    names: sema_call_reflection_type_names(ty, environment, program)
    args.push(sema_call_reflection_text(names.type_name, span))
    args.push(sema_call_reflection_text(names.path, span))
    count_at: args.len()
    args.push(sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span))
    if ty == .TraitObject(bounds) {
        count: sema_call_reflection_declared_impls(bounds, span, program, args)
        args[count_at] = sema_tree_node(Type.Int, TExprKind.IntLit{value: count, width: None}, span)
    }
}

// Each type with an impl of the single trait `bounds` (an `impl
// Owner.Trait` or an `impl` block in the type's own body), as the identity
// its payload key hashes, type name and path pushed onto `args`; how many.
// A declared type's identity is its checked key. A builtin scalar's
// (`impl Int.Shown`) is its carrier identity, and it reflects under its own
// spelling (`Int`) for both names, as any value of it does.
sema_call_reflection_declared_impls: fn(bounds: [String], span: Span, program: SemaProgramTables, args: ^[TExpr]) -> Int {
    graph: program.registration_graph
    holders: sema_call_reflection_trait_holders(graph, bounds) ?? return 0
    rows := [SemaRegistrationRowRef]{}
    builtins := 0
    loop reference in holders.impls {
        target: graph.modules[reference.module_index].impls[reference.row].target_type
        if sema_type_resolve_nominal_row_at(graph, target, reference.module_index) == .Val(row) {
            rows.push(row)
            next
        }
        if sema_type_graph_base_name(target) != None -> next
        shown: type_name(target)
        args.push(sema_call_reflection_text(type_carrier_identity(target), span))
        args.push(sema_call_reflection_text(shown, span))
        args.push(sema_call_reflection_text(shown, span))
        builtins += 1
    }
    rows.extend(holders.nominals)
    loop row in rows {
        concrete: sema_call_reflection_row_names(graph, row)
        args.push(sema_call_reflection_text(sema_checked_nominal_key(graph, graph.modules[row.module_index], graph.modules[row.module_index].nominals[row.row]), span))
        args.push(sema_call_reflection_text(concrete.type_name, span))
        args.push(sema_call_reflection_text(concrete.path, span))
    }
    builtins + rows.len()
}

// One level of the tree: the fields of `ty` (sema_call_reflection_field_args),
// then its cases (sema_call_reflection_case_args). A type already open on the
// way down lists no fields or cases again: its level is two zero counts.
// False after reporting the first part that can't be captured.
sema_call_reflection_level_args: fn(ty: Type, span: Span, value_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, open: [String], args: ^[TExpr], diagnostics: ^[Diagnostic]) -> Bool {
    path: sema_call_reflection_type_names(ty, environment, program).path
    if sema_call_reflection_has_name(open, path) {
        args.push(sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span))
        args.push(sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span))
        return true
    }
    inner := [String]{path}
    loop name in open -> inner.push(name.copy())
    if !sema_call_reflection_field_args(ty, span, value_span, environment, program, scopes, inner, args, diagnostics) {
        return false
    }
    sema_call_reflection_case_args(ty, path, span, value_span, environment, program, scopes, inner, args, diagnostics)
}

// The fields half of one level: the count of `ty`'s stored struct fields,
// then each field's name, its names (sema_call_reflection_names) and its own level, so a
// nested struct field reflects its fields too; `inner` holds `ty` and the
// types open above it. False after reporting the first stored field whose
// type is unknown or can't be reflected the way the value itself is
// (sema_call_reflection_validate_value).
sema_call_reflection_field_args: fn(ty: Type, span: Span, value_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, inner: [String], args: ^[TExpr], diagnostics: ^[Diagnostic]) -> Bool {
    count_at: args.len()
    args.push(sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span))
    definition: sema_http_route_find_struct(environment, program, ty, environment.module_identity) ?? return true
    count := 0
    loop field in definition.fields {
        if field.computed != None -> next
        field_ty: sema_shared_access_field_type(ty, field.name, environment, program, scopes) ?? {
            diagnostics.push(sema_error("E0112", value_span, "field `{field.name}` of {sema_type_show(ty)} can't be captured", "`reflect.of` captures every stored field of the value or refuses the value, and this field's type is unknown here", "pass one of the value's other fields instead"))
            return false
        }
        if sema_call_reflection_secret_bearing(field_ty) {
            diagnostics.push(sema_error("E0112", value_span, "field `{field.name}` of {sema_type_show(ty)} holds secret-bearing {sema_type_show(field_ty)}, which can't be reflected", "`reflect.of` captures every stored field of the value or refuses the value, and this field would expose a cryptographic secret", "reflect the value's public fields instead"))
            return false
        }
        if !sema_call_reflection_field_capturable(field_ty, environment, program) {
            diagnostics.push(sema_error("E0112", value_span, "field `{field.name}` of {sema_type_show(ty)} holds {sema_type_show(field_ty)}, which can't be reflected", "`reflect.of` captures every stored field of the value or refuses the value, and each field must show the way `\"{{x}}\"` interpolation does", "implement `Display` for the field's type, or reflect the fields that show instead"))
            return false
        }
        args.push(sema_call_reflection_text(field.name, span))
        sema_call_reflection_names(field_ty, span, environment, program, args)
        if !sema_call_reflection_level_args(field_ty, span, value_span, environment, program, scopes, inner, args, diagnostics) {
            return false
        }
        count += 1
    }
    args[count_at] = sema_tree_node(Type.Int, TExprKind.IntLit{value: count, width: None}, span)
    true
}

// The cases half of one level: the count of `ty`'s cases when it is a
// declared enum at `path` or an outcome type (sema_call_reflection_outcome_cases;
// 0 for any other type), then each case's name (a grouped case's last
// segment) and `module.Enum.Case` path, then its payload as a field list: the
// member count, then each member's name (a lone unnamed payload is `value`),
// its names (sema_call_reflection_names) and its own level. Every case is
// listed, not just the one a value holds, so a payload no case could capture
// refuses the value whichever case it holds. False after reporting the first
// payload member that can't be reflected.
sema_call_reflection_case_args: fn(ty: Type, path: String, span: Span, value_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, inner: [String], args: ^[TExpr], diagnostics: ^[Diagnostic]) -> Bool {
    count_at: args.len()
    args.push(sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span))
    if sema_call_reflection_outcome_cases(ty) == .Val(cases) {
        loop case in cases {
            args.push(sema_call_reflection_text(case.name, span))
            args.push(sema_call_reflection_text("{path}.{case.name}", span))
            members := 0
            if case.payload != None -> members = 1
            args.push(sema_tree_node(Type.Int, TExprKind.IntLit{value: members, width: None}, span))
            if case.payload == .Val(member_ty) {
                if !sema_call_reflection_case_member(ty, case.name, "value", member_ty, span, value_span, environment, program, scopes, inner, args, diagnostics) {
                    return false
                }
            }
        }
        args[count_at] = sema_tree_node(Type.Int, TExprKind.IntLit{value: cases.len(), width: None}, span)
        return true
    }
    graph: program.registration_graph
    row: sema_pattern_nominal_row(graph, environment.module_identity, ty) ?? return true
    nominal: graph.modules[row.module_index].nominals[row.row]
    if nominal.kind != SemaRegistrationNominalKind.Enum || nominal.compiler_owned -> return true
    loop variant in nominal.variants {
        declared: variant.symbol.name
        leaf: if declared.cut_last(".") == .Val(parts) -> parts.after else -> declared
        labels: if variant.payload == {
            .Unit -> [String]{}
            .Single(_, _) -> [String]{"value"}
            .Named(fields) -> loop field in fields -> field.name
        }
        members: sema_pattern_variant_types(program.registration_graph, variant.payload, nominal, ty)
        args.push(sema_call_reflection_text(leaf, span))
        args.push(sema_call_reflection_text("{path}.{declared}", span))
        args.push(sema_tree_node(Type.Int, TExprKind.IntLit{value: members.len(), width: None}, span))
        loop (index, member_ty) in members {
            if !sema_call_reflection_case_member(ty, leaf, labels[index], member_ty, span, value_span, environment, program, scopes, inner, args, diagnostics) {
                return false
            }
        }
    }
    args[count_at] = sema_tree_node(Type.Int, TExprKind.IntLit{value: nominal.variants.len(), width: None}, span)
    true
}

// One payload member `label` of case `leaf` of `ty`: its name, its names and
// its own level pushed onto `args`. False after reporting a member that holds
// a secret or doesn't show the way `"{x}"` interpolation does.
sema_call_reflection_case_member: fn(ty: Type, leaf: String, label: String, member_ty: Type, span: Span, value_span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, inner: [String], args: ^[TExpr], diagnostics: ^[Diagnostic]) -> Bool {
    if sema_call_reflection_secret_bearing(member_ty) {
        diagnostics.push(sema_error("E0112", value_span, "case `{leaf}` of {sema_type_show(ty)} holds secret-bearing {sema_type_show(member_ty)} in `{label}`, which can't be reflected", "`reflect.of` captures every case payload the value could hold or refuses the value, and this payload would expose a cryptographic secret", "reflect a value whose cases hold no secret instead"))
        return false
    }
    if !sema_call_reflection_field_capturable(member_ty, environment, program) {
        diagnostics.push(sema_error("E0112", value_span, "case `{leaf}` of {sema_type_show(ty)} holds {sema_type_show(member_ty)} in `{label}`, which can't be reflected", "`reflect.of` captures every case payload the value could hold or refuses the value, and each payload must show the way `\"{{x}}\"` interpolation does", "implement `Display` for the payload's type, or reflect a value whose cases show"))
        return false
    }
    args.push(sema_call_reflection_text(label, span))
    sema_call_reflection_names(member_ty, span, environment, program, args)
    sema_call_reflection_level_args(member_ty, span, value_span, environment, program, scopes, inner, args, diagnostics)
}

// The built-in cases of an outcome type, in the order its patterns name them,
// each with its lone payload (a field named `value`): an optional's `Val` and
// `None`, a result's `Ok` and `Err`, and an optional success's three flat
// states `Val`, `None` and `Err`. They are the outcome's own cases, never a
// named enum's unit case or the unit value: absence is the `None` of its
// optional type. A unit success or a `Never` error holds no payload. The IR
// reads the held case in the same order (ir_reflect_outcome_cases). None for
// any other type.
sema_call_reflection_outcome_cases: fn(ty: Type) -> [{name: String, payload: Type?}]? Never! {
    if sema_expr_unwrap_tag(ty) == {
        .Option(inner) -> Val([{name: String, payload: Type?}]{{name: "Val", payload: sema_call_reflection_outcome_payload(inner)}, {name: "None", payload: None}})
        .Result(ok, error) -> {
            failed: {name: "Err", payload: sema_call_reflection_outcome_payload(error)}
            if sema_expr_unwrap_tag(ok) == .Option(inner) {
                return Val([{name: String, payload: Type?}]{{name: "Val", payload: sema_call_reflection_outcome_payload(inner)}, {name: "None", payload: None}, failed})
            }
            Val([{name: String, payload: Type?}]{{name: "Ok", payload: sema_call_reflection_outcome_payload(ok)}, failed})
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// An outcome case's payload of type `ty`: none for a unit or `Never`.
sema_call_reflection_outcome_payload: fn(ty: Type) -> Type? Never! {
    if sema_expr_unwrap_tag(ty) == {
        .Named(name) -> {
            if name == "Unit" || name == "()" || name == "Never" -> return None
        }
        .Tuple(fields) -> {
            if fields.len() == 0 -> return None
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    Val(ty)
}

// A stored field reflects under the gate the value itself passes: it shows
// like `"{x}"` interpolation, or is a Unit.
sema_call_reflection_field_capturable: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    if sema_expression_displayable(ty, environment, program) -> return true
    if ty == .Named(name) -> return sema_call_reflection_leaf_name(name) == "Unit"
    false
}

// A nominal type reflects as its leaf name and canonical path
// (sema_call_reflection_row_names); any other type as its written spelling
// (type_name), each nominal it holds as an optional's, result's or list's
// part named the same way: an `Int? Lookup!` field is `Int? Lookup!` at
// `Int? app.Lookup!`, never its module identity.
sema_call_reflection_type_names: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> {type_name: String, path: String} {
    graph: program.registration_graph
    if sema_type_resolve_nominal_row(graph, ty, environment.module_identity) == .Val(row) {
        return sema_call_reflection_row_names(graph, row)
    }
    if ty == .Option(inner) {
        names: sema_call_reflection_marked_names(inner, environment, program)
        return {type_name: "{names.type_name}?", path: "{names.path}?"}
    }
    if ty == .Result(ok, err) {
        if ok == (Type.Named{name: "Unit"}) {
            names: sema_call_reflection_marked_names(err, environment, program)
            return {type_name: "{names.type_name}!", path: "{names.path}!"}
        }
        if err == (Type.Named{name: "Err"}) {
            return sema_call_reflection_type_names(ok, environment, program)
        }
        success: sema_call_reflection_marked_names(ok, environment, program)
        failure: sema_call_reflection_marked_names(err, environment, program)
        return {type_name: "{success.type_name} {failure.type_name}!", path: "{success.path} {failure.path}!"}
    }
    if ty == .List(element) {
        names: sema_call_reflection_type_names(element, environment, program)
        return {type_name: "[{names.type_name}]", path: "[{names.path}]"}
    }
    shown: type_name(ty)
    {type_name: shown, path: shown}
}

// The names of a type written before a suffix mark, grouped as
// type_marked_name groups it.
sema_call_reflection_marked_names: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> {type_name: String, path: String} {
    names: sema_call_reflection_type_names(ty, environment, program)
    if ty == .Union(_) || ty == .Result(_, _) || ty == .Tagged(_, _) || ty == .Fn(_, _, _, _, _, _) {
        return {type_name: "({names.type_name})", path: "({names.path})"}
    }
    names
}

// The nominal at `row` reflects as its leaf name and its canonical path
// (sema_name_type_path, the module path as an identifier: `reflect-value.jet`
// is `reflect_value`): a type lifted from an inline module is `Point` at
// `app.geo.Point`, never its generated name.
sema_call_reflection_row_names: fn(graph: SemaRegistrationGraph, row: SemaRegistrationRowRef) -> {type_name: String, path: String} Never! {
    registered: graph.modules[row.module_index]
    name: registered.nominals[row.row].symbol.name
    leaf: sema_name_type_leaf(registered.program.items, name)
    {type_name: leaf, path: sema_name_type_path(registered.module_path.replace("-", "_"), registered.program.items, name)}
}

sema_call_reflection_text: fn(text: String, span: Span) -> TExpr Never! {
    sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: text}}}, span)
}

sema_call_reflection_secret_leaf: fn(name: String) -> Bool Never! {
    leaf: sema_call_reflection_leaf_name(name)
    leaf == "Secret" || leaf == "SigningKey" || leaf == "X25519SecretKey" || leaf == "SharedSecret"
}

// A Core crypto secret: tagged by a registry signature, or named by its
// canonical source identity (`core.crypto.Secret`).
sema_call_reflection_secret_bearing: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(marker, inner) -> {
            if marker == (TagMarker.Internal{internal_tag: InternalTag.CoreCryptoNominal}) {
                if inner == .Named(name) -> return sema_call_reflection_secret_leaf(name)
                return false
            }
            return sema_call_reflection_secret_bearing(inner)
        }
        .Named(name) -> core_identity_in_module(name, "core.crypto") && sema_call_reflection_secret_leaf(name)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// A source that can be read once: an iterator or stream, or core.http's
// request `Body` and its chunk reader (by their Core identity, so a user type
// with the same name is an ordinary value).
sema_call_reflection_one_pass: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, _) -> {
            leaf: sema_call_reflection_leaf_name(name)
            leaf == "Iter" || leaf == "ViewIter" || leaf == "Stream"
        }
        .Named(name) -> {
            leaf: sema_call_reflection_leaf_name(name)
            core_identity_in_module(name, "core.http") && (leaf == "Body" || leaf == "HTTPBodyChunks")
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_call_reflection_core_shown: fn(name: String) -> Bool Never! {
    leaf: sema_call_reflection_leaf_name(name)
    leaf == "Decimal" || leaf == "Fraction" || leaf == "MIME" || leaf == "ServiceUpgradeReceipt" || leaf == "ServiceWorkflow" || leaf == "TaskOutcome" || leaf == "TaskStatus" || leaf == "Complex" || leaf == "URL" || leaf == "Path" || leaf == "Date" || leaf == "Duration" || leaf == "LocalDate" || leaf == "LocalTime" || leaf == "DateTime" || leaf == "Instant" || leaf == "Period" || leaf == "Zone" || leaf == "ZonedDateTime" || leaf == "DataTracked" || leaf == "DataWatch" || leaf == "DataWatchStatus" || leaf == "DBValue" || leaf == "DBLease" || leaf == "DBPoolReceipt" || sema_core_error_family_member(name)
}

sema_call_reflection_bound: fn(ty: Type, bound: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    graph: program.registration_graph
    if sema_type_bound_satisfied_at(graph, ty, bound, sema_scope_caller_row(environment, graph), environment.generic_params) == (Val(true)) {
        return true
    }
    // Imported nominal capabilities belong to their declaring registry. A
    // caller need not import the trait name as well as the displayed type.
    owner: sema_type_resolve_nominal_row_at(graph, ty, sema_scope_caller_row(environment, graph)) ?? return false
    nominal: graph.modules[owner.module_index].nominals[owner.row]
    sema_type_bound_satisfied_with_generics(graph, nominal.ty, bound, graph.modules[owner.module_index].module_identity, environment.generic_params) ?? false
}

sema_call_reflection_named_displayable: fn(name: String, ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    // S80 the Prelude-owned default error shows its message.
    if sema_call_reflection_core_shown(name) || sema_call_reflection_leaf_name(name) == "Err" {
        return true
    }
    if sema_call_reflection_synthetic_printable(name) -> return true
    if sema_call_reflection_bound(ty, "Display", environment, program) || sema_call_reflection_bound(ty, "Printable", environment, program) {
        return true
    }
    // A generic parameter bound by `Renderable` is anything interpolatable.
    loop param in environment.generic_params {
        if param.name == name {
            return sema_call_reflection_bound(ty, "Renderable", environment, program)
        }
    }
    false
}

// The Core values the trait registry admits as `Printable` with no source impl
// (their Prelude `JetShow` hooks, every SIMD lane and the linear-algebra
// values), and the Core types it registers a `Display` impl for.
sema_call_reflection_synthetic_printable: fn(name: String) -> Bool Never! {
    leaf: sema_call_reflection_leaf_name(name)
    if sema_core_is_math_type(leaf) -> return true
    if leaf == {
        "ArgsSpec" | "AriaRole" | "Bits" | "BuildError" | "BrowserError" | "Bytes" | "Clock" | "DataError" | "DataTracked" | "DataWatch" | "DataWatchStatus" | "Dyn" | "DBValue" | "DBLease" | "DBPoolReceipt" | "Date" | "DateTime" | "Decimal" | "FieldError" | "DirEntry" | "DNSSRV" | "Duration" | "EncodingError" | "EnvError" | "EventResult" | "Field" | "FileLock" | "GameAssets" | "GameBackend" | "GameFrame" | "GameImage" | "GameInputMap" | "GameInputSnapshot" | "GameReplay" | "GameScene" | "GameSound" | "HTTPError" | "HTTPHeaderName" | "HTTPHeaderValue" | "HTTPMethod" | "HTTPRequest" | "HTTPResponse" | "HTTPStatus" | "HTTPVersion" | "ID" | "Instant" | "IOError" | "IPAddr" | "JSON" | "Key" | "LocalDate" | "LocalTime" | "Cache" | "Measurement" | "MIME" | "NetError" | "ParsedArgs" | "Path" | "Period" | "Point" | "Pool" | "ProcessChild" | "ProcessReceipt" | "ProcessResult" | "ProcessSpec" | "Quat" | "Range" | "RangeError" | "Rect" | "ReflectField" | "ReflectValue" | "Regex" | "RegexFlags" | "RegexMatch" | "RNG" | "Size" | "SocketAddr" | "Solver" | "Stat" | "Stopwatch" | "Test" | "TcpListener" | "TcpStream" | "TempDir" | "TempFile" | "TextError" | "PluginError" | "TLSStream" | "TLSVersion" | "UDPPacket" | "UdpSocket" | "UnixListener" | "UnixStream" | "URL" | "UTF8Error" | "Value" | "Zone" | "ZonedDateTime" | "ComputeDevice" | "SyncText" | "SyncCounter" | "SyncMap" | "SyncList" | "ServiceRestart" | "ServiceDelivery" | "ServiceRuntime" | "ServiceStateStore" -> true
        else -> false
    }
}

sema_call_reflection_is_displayable: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if sema_call_reflection_secret_bearing(ty) || sema_call_reflection_one_pass(ty) -> return false
    if ty == {
        .Int | .Float | .Bool | .String | .Char | .IntN(_, _) | .Float32 -> return true
        .Option(inner) -> return sema_call_reflection_is_displayable(inner, environment, program)
        .Result(ok, err) -> return sema_call_reflection_is_displayable(ok, environment, program) && sema_call_reflection_is_displayable(err, environment, program)
        .List(inner) -> return sema_call_reflection_is_displayable(inner, environment, program)
        .Map(key, _, value) -> return sema_call_reflection_is_displayable(key, environment, program) && sema_call_reflection_is_displayable(value, environment, program)
        .Named(name) -> return sema_call_reflection_leaf_name(name) == "Unit" || sema_call_reflection_named_displayable(name, ty, environment, program)
        .Quantity(_, _) -> return true
        .Apply(name, args) -> {
            // A string view shows its text, as the String it borrows from.
            if sema_stmt_string_view_type(ty) -> return true
            leaf: sema_call_reflection_leaf_name(name)
            if sema_call_reflection_bound(ty, "Display", environment, program) -> return true
            native_composite: leaf == "List" || leaf == "Set" || leaf == "Rank" || leaf == "PriorityQueue" || leaf == "Queue" || leaf == "LRU" || leaf == "ExpiringValue" || leaf == "Loadable" || leaf == "View"
            if !native_composite && !sema_call_reflection_named_displayable(name, ty, environment, program) {
                return false
            }
            loop argument in args {
                if !sema_call_reflection_is_displayable(argument, environment, program) {
                    return false
                }
            }
            return true
        }
        .Tuple(fields) -> {
            loop field in fields {
                if !sema_call_reflection_is_displayable(field.ty, environment, program) {
                    return false
                }
            }
            return true
        }
        .TraitObject(bounds) -> {
            if sema_call_reflection_has_name(bounds, "Renderable") -> return true
            graph: program.registration_graph
            holders: sema_call_reflection_trait_holders(graph, bounds) ?? return false
            loop reference in holders.impls {
                if !sema_call_reflection_is_displayable(graph.modules[reference.module_index].impls[reference.row].target_type, environment, program) {
                    return false
                }
            }
            loop reference in holders.nominals {
                if !sema_call_reflection_is_displayable(graph.modules[reference.module_index].nominals[reference.row].ty, environment, program) {
                    return false
                }
            }
            return true
        }
        .Shared(_) | .Fn(_, _, _, _, _, _) | .Measure(_) -> return false
        .FixedList(element, _) | .Tagged(_, element) | .Case(_, element) | .InlineRange(element, _, _) -> return sema_call_reflection_is_displayable(element, environment, program)
        .Union(members) -> {
            loop member in members {
                if !sema_call_reflection_is_displayable(member, environment, program) {
                    return false
                }
            }
            return true
        }
    }
}

sema_call_reflection_has_name: fn(names: [String], wanted: String) -> Bool Never! {
    loop name in names {
        if name == wanted || sema_call_reflection_leaf_name(name) == wanted -> return true
    }
    false
}

// The rows of the types a value of the single trait `bounds` may hold, or
// None when `bounds` is not one trait. A trait value renders as the concrete
// value its box holds, so it shows one way (print, `{value}` or Debug)
// exactly when the type of every one of these rows does.
SemaCallTraitHolders: struct {
    // Each `impl Owner.Trait`, from the graph's by-name impl index
    // (`impl_trait_name_buckets`).
    impls: [SemaRegistrationRowRef],
    // Each struct or enum nominal whose own body implements the trait,
    // which that index does not hold.
    nominals: [SemaRegistrationRowRef],
}

sema_call_reflection_trait_holders: fn(graph: SemaRegistrationGraph, bounds: [String]) -> SemaCallTraitHolders? Never! {
    if bounds.len() != 1 -> return None
    // Snapshot: a lone program registers no impl or nominal to hold the trait.
    if graph.mode == .Snapshot -> return None
    leaf: sema_call_reflection_leaf_name(bounds[0])
    holders := SemaCallTraitHolders{impls: [SemaRegistrationRowRef]{}, nominals: [SemaRegistrationRowRef]{}}
    if sema_registration_impl_trait_name_slot(graph, leaf) == .Val(slot) {
        loop reference in graph.impl_trait_name_buckets[slot] {
            holders.impls.push(SemaRegistrationRowRef{module_index: reference.module_index, row: reference.row})
        }
    }
    loop module_index in 0..<graph.modules.len() {
        loop row in 0..<graph.modules[module_index].nominals.len() {
            // Matched in place: a pattern on the indexed path copies the whole item.
            nominal: graph.modules[module_index].nominals[row]
            if nominal.source == .SourceAST(item) {
                if sema_call_reflection_body_implements(item, leaf) {
                    holders.nominals.push(SemaRegistrationRowRef{module_index: module_index, row: row})
                }
            }
        }
    }
    Val(holders)
}

// Whether the struct or enum `item` implements the trait named `leaf` in an
// `impl` block of its own body or by a derive.
sema_call_reflection_body_implements: fn(item: Item, leaf: String) -> Bool Never! {
    if item == .Struct(definition) {
        return sema_type_blocks_or_derives_name(definition.trait_impls, definition.derives, leaf)
    }
    if item == .Enum(definition) {
        return sema_type_blocks_or_derives_name(definition.trait_impls, definition.derives, leaf)
    }
    false
}

// `T.reflect()` on an enum returns its case catalog, so the query reads every
// declaration detail the cases reach: each payload type, the fields of every
// struct and the cases of every enum it names, through type arguments and
// containers, each declaration once. A detail the checking module can't read
// refuses the whole query (E0605), as a generic enum named without one type
// per parameter does (E0904): no catalog is filtered, and none is made up.
// None for any other type, whose catalog is empty.
sema_call_reflection_cases_refusal: fn(owner: Symbol, written: String, args: [Type], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Diagnostic? {
    graph: program.registration_graph
    row: sema_type_graph_nominal_row(graph, owner.id) ?? return None
    item: sema_registration_nominal_source_item(graph.modules[row.module_index].nominals[row.row].source) ?? return None
    if item == .Enum(definition) {
        if definition.type_params.len() > 0 && args.len() != definition.type_params.len() {
            return Val(sema_error("E0904", span, "`{written}` is generic, so `{written}.reflect()` has no payload types to list its cases with", "a case catalog describes each payload at one type, and a generic enum named without its type arguments is a family of types", "name one type per parameter, as `{written}<…>.reflect()`"))
        }
        visited := [SemaRegistrationRowRef]{}
        caller: sema_type_module_row(graph, environment.module_identity)
        loop arg in args {
            refusal: sema_call_reflection_cases_reach(graph, arg, caller, [TypeParam]{}, written, span, environment, program, visited)
            if refusal != None -> return refusal
        }
        return sema_call_reflection_cases_row(graph, row, written, span, environment, program, visited)
    }
    None
}

// One type within a case catalog's reach, named from module row `caller`;
// `params` are the type parameters of the declaration it is written in,
// which name no declaration of their own.
sema_call_reflection_cases_reach: fn(graph: SemaRegistrationGraph, ty: Type, caller: Int, params: [TypeParam], written: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, visited: ^[SemaRegistrationRowRef]) -> Diagnostic? {
    if ty == {
        .Named(name) -> {
            loop param in params {
                if param.name == name -> return None
            }
        }
        .Apply(_, args) -> {
            loop arg in args {
                refusal: sema_call_reflection_cases_reach(graph, arg, caller, params, written, span, environment, program, visited)
                if refusal != None -> return refusal
            }
        }
        .List(element) -> return sema_call_reflection_cases_reach(graph, element, caller, params, written, span, environment, program, visited)
        .Shared(inner) -> return sema_call_reflection_cases_reach(graph, inner, caller, params, written, span, environment, program, visited)
        .Option(inner) -> return sema_call_reflection_cases_reach(graph, inner, caller, params, written, span, environment, program, visited)
        .FixedList(element, _) -> return sema_call_reflection_cases_reach(graph, element, caller, params, written, span, environment, program, visited)
        .Tagged(_, inner) -> return sema_call_reflection_cases_reach(graph, inner, caller, params, written, span, environment, program, visited)
        .InlineRange(base, _, _) -> return sema_call_reflection_cases_reach(graph, base, caller, params, written, span, environment, program, visited)
        .Quantity(base, _) -> return sema_call_reflection_cases_reach(graph, base, caller, params, written, span, environment, program, visited)
        .Case(_, payload) -> return sema_call_reflection_cases_reach(graph, payload, caller, params, written, span, environment, program, visited)
        .Map(key, _, value) -> {
            refusal: sema_call_reflection_cases_reach(graph, key, caller, params, written, span, environment, program, visited)
            if refusal != None -> return refusal
            return sema_call_reflection_cases_reach(graph, value, caller, params, written, span, environment, program, visited)
        }
        .Result(ok, err) -> {
            refusal: sema_call_reflection_cases_reach(graph, ok, caller, params, written, span, environment, program, visited)
            if refusal != None -> return refusal
            return sema_call_reflection_cases_reach(graph, err, caller, params, written, span, environment, program, visited)
        }
        .Tuple(fields) -> {
            loop field in fields {
                refusal: sema_call_reflection_cases_reach(graph, field.ty, caller, params, written, span, environment, program, visited)
                if refusal != None -> return refusal
            }
            return None
        }
        .Union(members) -> {
            loop member in members {
                refusal: sema_call_reflection_cases_reach(graph, member, caller, params, written, span, environment, program, visited)
                if refusal != None -> return refusal
            }
            return None
        }
        .Int | .Float | .Bool | .String | .Char | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .IntN(_, _) | .Float32 | .Measure(_) -> return None
    }
    row: sema_type_resolve_nominal_row_at(graph, ty, caller) ?? return None
    sema_call_reflection_cases_row(graph, row, written, span, environment, program, visited)
}

// The declaration at `row` within a case catalog's reach: readable from the
// checking module, with each stored field of a struct readable and its type
// reached, or each case payload of an enum reached. A row already reached
// closes its edge.
sema_call_reflection_cases_row: fn(graph: SemaRegistrationGraph, row: SemaRegistrationRowRef, written: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, visited: ^[SemaRegistrationRowRef]) -> Diagnostic? {
    loop seen in visited {
        if seen.module_index == row.module_index && seen.row == row.row -> return None
    }
    visited.push(SemaRegistrationRowRef{module_index: row.module_index, row: row.row})
    registered: graph.modules[row.module_index]
    nominal: registered.nominals[row.row]
    if !sema_registration_visible(nominal.symbol.visibility, environment.module_identity, environment.package_identity, registered.module_identity, registered.package_identity) {
        return Val(sema_call_reflection_cases_private(written, nominal.symbol.name, span))
    }
    item: sema_registration_nominal_source_item(nominal.source) ?? return None
    if item == .Struct(definition) {
        loop field in definition.fields {
            if field.computed != None -> next
            if !sema_expression_field_visible(field.is_pub, field.is_package_pub, registered.module_identity, definition.inline_module, span, false, environment, program) {
                return Val(sema_call_reflection_cases_private(written, "{nominal.symbol.name}.{field.name}", span))
            }
            refusal: sema_call_reflection_cases_reach(graph, field.ty, row.module_index, definition.type_params, written, span, environment, program, visited)
            if refusal != None -> return refusal
        }
    }
    if item == .Enum(definition) {
        loop variant in definition.variants {
            if variant.payload == .Single(ty, _) {
                refusal: sema_call_reflection_cases_reach(graph, ty, row.module_index, definition.type_params, written, span, environment, program, visited)
                if refusal != None -> return refusal
            }
            if variant.payload == .Named(fields) {
                loop field in fields {
                    refusal: sema_call_reflection_cases_reach(graph, field.ty, row.module_index, definition.type_params, written, span, environment, program, visited)
                    if refusal != None -> return refusal
                }
            }
        }
    }
    None
}

sema_call_reflection_cases_private: fn(written: String, detail: String, span: Span) -> Diagnostic Never! {
    sema_error("E0605", span, "`{written}.reflect()` can't list its cases here: `{detail}` is private to its module", "a case catalog describes every declaration its cases reach, so the module asking for it must be able to read each one", "reflect `{written}` inside the module that declares `{detail}`, or remove its `priv`")
}

// Apply the runtime reflection gate after the normal Core argument checker has
// inferred the value. This keeps argument evaluation and ownership in the
// ordinary call path while centralizing secret/display diagnostics. A value
// reflects exactly where bare `"{x}"` interpolation shows it.
sema_call_reflection_validate_value: fn(value: TExpr, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: ^[Diagnostic]) -> Bool {
    if sema_expression_displayable(value.ty, environment, program) -> return true
    if value.ty == .Named(name) && sema_call_reflection_leaf_name(name) == "Unit" -> return true
    if {
        sema_call_reflection_secret_bearing(value.ty) -> {
            diagnostics.push(sema_error("E0112", span, "secret-bearing `{type_name(value.ty)}` cannot be reflected", "reflection would expose a cryptographic secret through generic inspection or display", "keep the value opaque; inspect only public keys, signatures, digests, or envelope metadata"))
        }
        else -> {
            diagnostics.push(sema_error("E0112", span, "{type_name(value.ty)} can't be reflected yet", "`reflect.of` inspects the same values `\"{{x}}\"` interpolation can show", "implement `Display` for its type, or pass one of its fields instead"))
        }
    }
    false
}

// Runtime handle method contracts shared by direct method dispatch.
sema_call_reflection_method_return: fn(type_name: String, method: String, args: [Type]) -> Type? {
    if type_name == "Value" {
        if args.len() != 0 -> return None
        if method == "type_name" || method == "path" || method == "display" {
            return Val(Type.String)
        }
        if method == "fields" -> return Val(Type.List{element: Type.Named{name: "Field"}})
        // The case an enum value held when it was captured; None for a
        // value of any other type.
        if method == "case" -> return Val(Type.Option{inner: Type.Named{name: "Case"}})
        // A typed read of the captured value: Some when it is that exact
        // scalar, None for any other type.
        if method == "int" -> return Val(Type.Option{inner: Type.Int})
        if method == "float" -> return Val(Type.Option{inner: Type.Float})
        if method == "bool" -> return Val(Type.Option{inner: Type.Bool})
        if method == "char" -> return Val(Type.Option{inner: Type.Char})
        if method == "string" -> return Val(Type.Option{inner: Type.String})
    }
    if type_name == "Field" && args.len() == 0 {
        if method == "name" -> return Val(Type.String)
        if method == "value" -> return Val(Type.Named{name: "Value"})
    }
    if type_name == "Case" && args.len() == 0 {
        if method == "name" || method == "path" -> return Val(Type.String)
        if method == "fields" -> return Val(Type.List{element: Type.Named{name: "Field"}})
    }
    // `field.key(format)`: the field's `#Rename` key under that codec format.
    if (type_name == "FieldInfo" || type_name == "CaseInfo") && method == "key" {
        if args.len() != 1 || args[0] != Type.String -> return None
        return Val(Type.Option{inner: Type.String})
    }
    if type_name == "TypeInfo" && method == "has_method" {
        if args.len() != 1 || args[0] != Type.String -> return None
        return Val(Type.Bool)
    }
    None
}

sema_call_reflection_metadata_owner: fn(ty: Type) -> String? {
    if ty == {
        .Tagged(_, inner) -> return sema_call_reflection_metadata_owner(inner)
        .Named(name) | .Apply(name, _) -> return Val(sema_call_reflection_leaf_name(name))
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

sema_call_reflection_metadata_method: fn(owner: String, method: String) -> Bool Never! {
    if owner == "TypeInfo" -> return method == "has_method" || method == "marker"
    if owner == "FieldInfo" || owner == "CaseInfo" -> return method == "marker" || method == "key"
    if owner == "MethodInfo" || owner == "FunctionInfo" -> return method == "marker"
    false
}

// The marker struct a `marker(T)` argument names: `T` or a dotted path to it.
sema_call_reflection_marker_name: fn(expression: Expr) -> String? Never! {
    if expression == .Ident(name, _, _) -> return Val(name.copy())
    if expression == .Field(base, member, _, _) {
        owner: sema_call_reflection_marker_name(base) ?? return None
        return Val("{owner}.{member}")
    }
    None
}

// `info.marker(T)` on a TypeInfo, FieldInfo, CaseInfo, MethodInfo or FunctionInfo: the marker `T`
// written on the reflected item, read as a `T` whose fields are its
// arguments, or None when the item does not carry it. `T` names a marker
// struct (one with an `impl Marker` block) visible here or a Prelude marker
// (`marker(Codable) != None` asks whether `#Codable` is written), else E1134.
// The host call carries the marker's name, then each parameter with a
// declared default as its name and default value, which fill the arguments
// the use site left out (jet_eval_reflection_marker_value).
sema_call_reflection_marker_lookup: fn(
    owner: String,
    receiver: Expr,
    receiver_value: TExpr,
    args: [CallArg],
    span: Span,
    expected: Type?,
    environment: SemaScopeEnvironment,
    program: SemaProgramTables,
    scopes: ^SemaScopeTable,
    check: ^SemaBodyCheck,
    diagnostics: ^[Diagnostic],
) -> SemaMethodSpecialCheck {
    if !sema_ownership_check_call_receiver(check.state, receiver, AccessConvention.Read, scopes, span, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if args.len() != 1 || args[0].label != None {
        diagnostics.push(sema_error("E0104", span, "`{owner}.marker` expects one marker type, got {args.len()} arguments", "`marker(T)` reads the one marker `T` written on the reflected item", "call `.marker(T)` with the marker struct's name"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    written: sema_call_reflection_marker_name(args[0].expr) ?? ""
    declaration := MarkerDecl?{None}
    graph: program.registration_graph
    if written != "" {
        declaration = sema_marker_module_resolve(graph, environment.module_identity, written).declaration
    }
    // A Prelude marker is no type in the program: its record is a compiler
    // value the evaluator holds, and keeps only the defaults that check where
    // the lookup is written.
    prelude := false
    if declaration == None && written != "" && !written.contains(".") {
        declaration = sema_marker_module_prelude_declaration(written)
        prelude = declaration != None
    }
    marker: declaration ?? {
        shown: if written == "" -> "this argument" else -> "`{written}`"
        diagnostics.push(sema_error("E1134", args[0].span, "{shown} is not a marker", "`marker(T)` reads the marker `T` written on a reflected item, so `T` names a struct with an `impl Marker` block or a Prelude marker", "name a marker struct visible here or a Prelude marker such as `Codable`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_effect_record_intrinsic_effects(environment, program, scopes, check.context, "{owner}.marker", span, [EffectRowEntry]{}, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    host_args := [TExpr]{sema_call_reflection_text(marker.name, span)}
    loop param in marker.params {
        if param.name.starts_with("$") -> next
        default: param.value ?? next
        if prelude {
            refusals := [Diagnostic]{}
            checked: sema_check_expression(default, None, environment, program, scopes, check, refusals) ?? next
            if refusals.len() > 0 -> next
            host_args.push(sema_call_reflection_text(param.name, span))
            host_args.push(checked)
            next
        }
        checked: sema_check_expression(default, None, environment, program, scopes, check, diagnostics) ?? next
        host_args.push(sema_call_reflection_text(param.name, span))
        host_args.push(checked)
    }
    marker_type: if prelude -> Type.Named{name: IR_PRELUDE_MARKER_RECORD} else -> sema_call_resolved_type(Type.Named{name: written}, environment, program)
    value := sema_tree_node(Type.Option{inner: marker_type}, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: "marker", args: host_args}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

sema_call_try_reflection_metadata_method: fn(
    receiver: Expr,
    receiver_value: TExpr,
    method: String,
    args: [CallArg],
    span: Span,
    expected: Type?,
    environment: SemaScopeEnvironment,
    program: SemaProgramTables,
    scopes: ^SemaScopeTable,
    check: ^SemaBodyCheck,
    diagnostics: ^[Diagnostic],
) -> SemaMethodSpecialCheck {
    owner: sema_call_reflection_metadata_owner(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_call_reflection_metadata_method(owner, method) {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if method == "marker" {
        return sema_call_reflection_marker_lookup(owner, receiver, receiver_value, args, span, expected, environment, program, scopes, check, diagnostics)
    }
    if args.len() != 1 {
        loop argument in args {
            _ := sema_check_expression(argument.expr, None, environment, program, scopes, check, diagnostics)
        }
        if !sema_ownership_check_call_receiver(check.state, receiver, AccessConvention.Read, scopes, span, diagnostics) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        diagnostics.push(sema_error("E0104", span, "`{owner}.{method}` expects one String argument, got {args.len()}", "metadata predicates inspect one trait or method name", "call `.{method}(name)` with one String"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    params := [SemaCallParam]{SemaCallParam{label: "name", name: "name", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.String), variadic: false}}
    checked_args := args
    binding: sema_call_bind_args("{owner}.{method}", params, checked_args, span, diagnostics) ?? {
        loop argument in checked_args {
            _ := sema_check_expression(argument.expr, None, environment, program, scopes, check, diagnostics)
        }
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    typed: sema_call_typecheck_bound_arguments("{owner}.{method}", params, None, false, binding, checked_args, environment, program, scopes, check, span, diagnostics, true) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    ownership := sema_ownership_check_method_call(check.state, "{owner}.{method}", receiver, AccessConvention.Read, params, checked_args, scopes, span, diagnostics)
    if !ownership.accepted || !ownership.complete {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_effect_record_intrinsic_effects(environment, program, scopes, check.context, "{owner}.{method}", span, [EffectRowEntry]{}, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    result_type: sema_call_reflection_method_return(owner, method, [Type]{Type.String}) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tree_node(result_type, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: method, args: typed.values}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

sema_call_reflection_handle_operation: fn(owner: String, method: String) -> BodyHandleOp? {
    if owner == "Value" {
        // A Value read names its runtime export by the method itself
        // (`jet_jit_reflect_{method}`); `fields` builds a list instead.
        if method == "fields" -> return Val(BodyHandleOp.ReflectValueFields)
        if method == "type_name" || method == "path" || method == "display" || method == "int" || method == "float" || method == "bool" || method == "char" || method == "string" || method == "case" {
            return Val(BodyHandleOp.ReflectValueRead{symbol: "jet_jit_reflect_{method}"})
        }
    }
    // A Case read is named the same way, as `jet_jit_reflect_case_{method}`.
    if owner == "Case" && (method == "name" || method == "path" || method == "fields") {
        return Val(BodyHandleOp.ReflectValueRead{symbol: "jet_jit_reflect_case_{method}"})
    }
    if owner == "Field" {
        if method == "name" -> return Val(BodyHandleOp.ReflectFieldName)
        if method == "value" -> return Val(BodyHandleOp.ReflectFieldValue)
    }
    None
}

sema_call_try_reflection_handle_method: fn(
    receiver: Expr,
    receiver_value: TExpr,
    method: String,
    args: [CallArg],
    span: Span,
    expected: Type?,
    environment: SemaScopeEnvironment,
    program: SemaProgramTables,
    scopes: ^SemaScopeTable,
    check: ^SemaBodyCheck,
    diagnostics: ^[Diagnostic],
) -> SemaMethodSpecialCheck {
    metadata := sema_call_try_reflection_metadata_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, check, diagnostics)
    if metadata.handled -> return metadata
    owner: if receiver_value.ty == {
        .Named(name) -> name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ""
    }
    operation: sema_call_reflection_handle_operation(owner, method)
    if operation == None -> return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_ownership_check_call_receiver(check.state, receiver, AccessConvention.Read, scopes, span, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if args.len() != 0 {
        loop argument in args {
            _ := sema_check_expression(argument.expr, None, environment, program, scopes, check, diagnostics)
        }
        diagnostics.push(sema_error("E0104", span, "`{owner}.{method}` takes no arguments, got {args.len()}", "reflection handle accessors only inspect their existing value", "call `.{method}()` with no arguments"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    result_type: sema_call_reflection_method_return(owner, method, [Type]{}) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}
