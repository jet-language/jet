// Static associated-method lookup and checked StaticCall construction.
// The owner is a type name, never a runtime receiver; owner and method generic
// arguments stay separate through inference and TIR construction.
use jet_foundation.[
    AccessConvention,
    BuiltinStaticOwnerRule,
    BuiltinStaticRow,
    Call,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    Func,
    FunctionDefaultRef,
    NodeKind,
    ParamZone,
    Span,
    Symbol,
    DeclID,
    SymbolID,
    SymbolKind,
    TBuiltinOp,
    TFailureCarrier,
    TMethodRef,
    TGenericParam,
    TNumericOp,
    TPreludeArg,
    TStaticOwner,
    Type,
    SemaNameCase,
    sema_casing_canonical,
    builtin_static_is_type_param,
    builtin_static_rows,
    core_call,
    core_module_has_member,
    core_module_has_type,
    expr_span,
    jet_target_layout_atomic_scalar_type,
    symbol_id,
    type_identity_equal,
    type_name,
]

struct SemaStaticMethodTarget {
    owner_name: String
    owner_type: Type
    method: TMethodRef
    target: SemaCallDirectTarget
    function: Func?
}

fn sema_call_static_registered_method_exists(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, method: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    owner_module := nominal.symbol.module_name
    owner_package := ""
    if sema_type_graph_nominal_row(graph, nominal.symbol.id.key) == .Val(owner_row) {
        owner_module = graph.modules[owner_row.module_index].module_identity
        owner_package = graph.modules[owner_row.module_index].package_identity
    }
    loop function in nominal.methods {
        if function.symbol.name == method && (function.parameters.len() == 0 || function.parameters[0].symbol.name != "self") {
            if sema_registration_visible(function.symbol.visibility, environment.module_identity, environment.package_identity, owner_module, owner_package) -> return true
        }
    }
    // Only impls registered under the owner's name can target it (Rust
    // `registry.method` on the resolved owner), in module/row order.
    loop impl_row in sema_registration_impl_rows_named(graph, nominal.symbol.name) {
        implementation :: graph.modules[impl_row.module_index].impls[impl_row.row]
        if implementation.trait_name != None -> next
        if implementation.target_identity_key != nominal.identity_key && (implementation.target_module_identity != (Val(nominal.symbol.module_name)) || implementation.target_type_name != nominal.symbol.name) -> next
        loop function in implementation.methods {
            if function.symbol.name == method && (function.parameters.len() == 0 || function.parameters[0].symbol.name != "self") {
                if sema_registration_visible(function.symbol.visibility, environment.module_identity, environment.package_identity, graph.modules[impl_row.module_index].module_identity, graph.modules[impl_row.module_index].package_identity) -> return true
            }
        }
    }
    false
}

fn sema_call_static_local_generic_method_exists(symbol: Symbol, method: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    loop declaration_index in 0..<environment.declarations.len() {
        if environment.declarations[declaration_index].item == {
            .Struct(value) -> {
                if value.name == symbol.name && value.type_params.len() > 0 {
                    loop function in value.methods {
                        if function.name == method && (function.params.len() == 0 || function.params[0].name != "self") -> return true
                    }
                }
            }
            .Enum(value) -> {
                if value.name == symbol.name && value.type_params.len() > 0 {
                    loop function in value.methods {
                        if function.name == method && (function.params.len() == 0 || function.params[0].name != "self") -> return true
                    }
                }
            }
            else -> {}
        }
    }
    false
}

fn sema_call_static_has_method(targets: [SemaStaticMethodTarget], symbol: SymbolID) -> Bool Never! {
    loop target in targets {
        if target.method.symbol.key == symbol.key -> return true
    }
    false
}

fn sema_call_static_function_target(symbol: Symbol, signature: Type, generic_params: [SemaInferenceTypeParam], type_args: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables, span: Span, diagnostics: &[Diagnostic]) -> SemaCallDirectTarget? {
    if generic_params.len() == 0 {
        if type_args.len() > 0 {
            &diagnostics.push(sema_error("E0119", span, "`{symbol.name}` is not generic", "only a generic static method accepts function-level type arguments", "remove the explicit method type arguments"))
            return None
        }
        return Val(SemaCallDirectTarget{symbol: symbol, signature: signature, type_args: [Type]{}, generic_params: [SemaInferenceTypeParam]{}, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}})
    }
    if type_args.len() == 0 {
        return Val(SemaCallDirectTarget{symbol: symbol, signature: signature, type_args: [Type]{}, generic_params: generic_params, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}})
    }
    context := sema_inference_context(environment.module_identity, environment.package_identity, generic_params, environment.generic_params, None)
    result :: sema_infer_validate_explicit(program.registration_graph, &context, type_args, span, &diagnostics) ?? return None
    specialized :: sema_inference_substitute_type_bindings(signature, result.substitutions)
    Val(SemaCallDirectTarget{symbol: symbol, signature: specialized, type_args: result.type_args, generic_params: generic_params, generic_substitutions: result.substitutions, generic_evidence: result.evidence})
}

// The owner type parameters a static call resolves from its signature: with
// no written owner arguments, a method's own same-named parameter shadows the
// owner's.
fn sema_call_static_unshadowed_params(owner_params: [SemaInferenceTypeParam], method_params: [SemaInferenceTypeParam], owner_type_args: [Type]) -> [SemaInferenceTypeParam] Never! {
    // copy: written owner arguments bind every owner parameter; the caller keeps its list.
    if owner_type_args.len() > 0 -> return owner_params.copy()
    kept := [SemaInferenceTypeParam]{}
    loop param in owner_params {
        shadowed := false
        loop method_param in method_params {
            if method_param.name == param.name -> shadowed = true
        }
        if !shadowed -> &kept.push(param)
    }
    kept
}

fn sema_call_static_owner_resolution(owner_params: [SemaInferenceTypeParam], owner_type_args: [Type], signature: Type, args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> SemaInferenceResult? {
    explicit_args :: loop ty in owner_type_args -> sema_call_resolved_type(ty, environment, program)
    inference_context := sema_inference_context(environment.module_identity, environment.package_identity, owner_params, environment.generic_params, expected)
    if owner_type_args.len() > 0 -> return sema_infer_validate_explicit(program.registration_graph, &inference_context, explicit_args, span, &diagnostics)
    if owner_params.len() == 0 -> return Val(SemaInferenceResult{substitutions: [SemaInferenceBinding]{}, type_args: [Type]{}, parameters: [Type]{}, return_type: None, evidence: [SemaInferenceBoundEvidence]{}, complete: true, compatible: true})

    params :: sema_call_params_from_type(signature) ?? return None
    probe_args := args
    probe_diagnostics := [Diagnostic]{}
    binding :: sema_call_bind_direct("static method", signature, &probe_args, span, &probe_diagnostics) ?? return None
    facts :: sema_call_collect_inference_facts(params, binding, args, environment, program, &scopes, &state, &tail_store, &context)
    return_type :: sema_call_signature_return(signature)
    result :: sema_infer_callable(program.registration_graph, &inference_context, facts.parameter_types, return_type, facts.argument_types, [Type]{}, span, &probe_diagnostics) ?? {
        // An argument that settles an owner parameter but misses its bound
        // is that missing implementation, not an uninferrable owner.
        loop diagnostic in probe_diagnostics {
            if diagnostic.code == "E0905" -> &diagnostics.push(diagnostic)
        }
        return None
    }
    if !result.complete -> return None
    Val(result)
}

fn sema_call_static_append_registered(output: &[SemaStaticMethodTarget], graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, function: SemaRegistrationFunction, owner_name: String, owner_module: String, owner_package: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) Never! {
    if function.symbol.name == "" || sema_call_static_has_method(output, function.symbol.id) -> return
    if function.parameters.len() > 0 && function.parameters[0].symbol.name == "self" -> return
    if !sema_registration_visible(function.symbol.visibility, environment.module_identity, environment.package_identity, owner_module, owner_package) -> return

    // Rust `owner_type_for_reader`, as for an exported function: the method
    // names types as its owning module sees them (`X25519SecretKey` is
    // `core.crypto`'s own), so it resolves there with every type parameter
    // kept, before the caller's type arguments are substituted.
    generics := [TGenericParam]{}
    loop param in nominal.generic_params -> &generics.push(TGenericParam{name: param.name, bounds: [SymbolID]{}})
    loop param in function.generic_params -> &generics.push(TGenericParam{name: param.name, bounds: [SymbolID]{}})
    owner_signature :: sema_type_resolve_declared_with_generics(graph, function.signature, owner_module, generics)
    target := sema_call_static_function_target(function.symbol, owner_signature, sema_inference_registration_params(function.generic_params), type_args, environment, program, span, &diagnostics) ?? return
    // A method that declares its own type parameter under an owner
    // parameter's name (`impl Box { fn new<T>(value: T) -> Box<T> }`) shadows
    // it: the signature names only the method's parameter, which the call
    // infers. The shadowed owner parameter takes that binding when the call
    // is rewritten (sema_call_static_rewrite_value).
    owner_params :: sema_call_static_unshadowed_params(sema_inference_registration_params(nominal.generic_params), target.generic_params, owner_type_args)
    owner_result :: sema_call_static_owner_resolution(owner_params, owner_type_args, target.signature, args, expected, environment, program, &scopes, &state, &tail_store, &context, span, &diagnostics) ?? return
    if !owner_result.complete -> return
    owner_type :: sema_inference_substitute_type_bindings(nominal.ty, owner_result.substitutions)
    target.signature = sema_inference_substitute_type_bindings(target.signature, owner_result.substitutions)
    reference := TMethodRef{symbol: function.symbol.id, name: function.symbol.name, mangled: true, trait_owner: None, operator_identity: None}
    &output.push(SemaStaticMethodTarget{owner_name: owner_name, owner_type: owner_type, method: reference, target: target, function: Val(function.declaration)})
}

fn sema_call_static_registered_targets(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, method: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> [SemaStaticMethodTarget] Never! {
    targets := [SemaStaticMethodTarget]{}
    owner_name := nominal.symbol.name
    owner_module := nominal.symbol.module_name
    owner_package := ""
    if sema_type_graph_nominal_row(graph, nominal.symbol.id.key) == .Val(owner_row) {
        owner_module = graph.modules[owner_row.module_index].module_identity
        owner_package = graph.modules[owner_row.module_index].package_identity
    }
    loop function in nominal.methods {
        if function.symbol.name == method {
            sema_call_static_append_registered(&targets, graph, nominal, function, owner_name, owner_module, owner_package, owner_type_args, type_args, args, expected, environment, program, &scopes, &state, &tail_store, &context, span, &diagnostics)
        }
    }
    loop impl_row in sema_registration_impl_rows_named(graph, nominal.symbol.name) {
        implementation :: graph.modules[impl_row.module_index].impls[impl_row.row]
        if implementation.trait_name != None -> next
        if implementation.target_identity_key != nominal.identity_key && (implementation.target_module_identity != (Val(nominal.symbol.module_name)) || implementation.target_type_name != nominal.symbol.name) -> next
        loop function in implementation.methods {
            if function.symbol.name == method {
                sema_call_static_append_registered(&targets, graph, nominal, function, owner_name, graph.modules[impl_row.module_index].module_identity, graph.modules[impl_row.module_index].package_identity, owner_type_args, type_args, args, expected, environment, program, &scopes, &state, &tail_store, &context, span, &diagnostics)
            }
        }
    }
    targets
}

fn sema_call_static_local_target(owner_symbol: Symbol, owner_name: String, declared_owner: Type, owner_params: [SemaInferenceTypeParam], owner_type_args: [Type], function: Func, type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> SemaStaticMethodTarget? {
    if function.params.len() > 0 && function.params[0].name == "self" -> return None
    method_id :: symbol_id(SymbolKind.Function, environment.module_identity, owner_name, function.name)
    signature :: sema_function_symbol_type(function, false, method_id, environment.source_file, environment.source_origin, environment.source_segments)
    visibility :: if function.is_pub -> 2 else -> if function.is_package_pub -> 1 else -> 0
    method_symbol := Symbol{id: method_id, kind: SymbolKind.Function, name: function.name, module_name: environment.module_identity, owner: Val(owner_symbol.id.key), span: function.name_span, ty: Val(signature), visibility: visibility}
    target := sema_call_static_function_target(method_symbol, signature, sema_inference_type_params(function.type_params), type_args, environment, program, span, &diagnostics) ?? return None
    owner_result :: sema_call_static_owner_resolution(sema_call_static_unshadowed_params(owner_params, target.generic_params, owner_type_args), owner_type_args, target.signature, args, expected, environment, program, &scopes, &state, &tail_store, &context, span, &diagnostics) ?? return None
    owner_type :: sema_inference_substitute_type_bindings(declared_owner, owner_result.substitutions)
    target.signature = sema_inference_substitute_type_bindings(target.signature, owner_result.substitutions)
    reference := TMethodRef{symbol: method_symbol.id, name: function.name, mangled: true, trait_owner: None, operator_identity: None}
    Val(SemaStaticMethodTarget{owner_name: owner_name, owner_type: owner_type, method: reference, target: target, function: Val(function)})
}

fn sema_call_static_local_targets(symbol: Symbol, method: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> [SemaStaticMethodTarget] Never! {
    targets := [SemaStaticMethodTarget]{}
    loop declaration_index in 0..<environment.declarations.len() {
        if environment.declarations[declaration_index].item == {
            .Struct(value) -> {
                if value.name != symbol.name -> next
                owner_params :: sema_inference_type_params(value.type_params)
                declared_owner :: if owner_params.len() == 0 -> Type.Named{name: value.name} else -> Type.Apply{name: value.name, args: loop parameter in owner_params -> Type.Named{name: parameter.name}}
                loop function in value.methods {
                    if function.name == method {
                        candidate :: sema_call_static_local_target(symbol, value.name, declared_owner, owner_params, owner_type_args, function, type_args, args, expected, environment, program, &scopes, &state, &tail_store, &context, span, &diagnostics) ?? next
                        &targets.push(candidate)
                    }
                }
            }
            .Enum(value) -> {
                if value.name != symbol.name -> next
                owner_params :: sema_inference_type_params(value.type_params)
                declared_owner :: if owner_params.len() == 0 -> Type.Named{name: value.name} else -> Type.Apply{name: value.name, args: loop parameter in owner_params -> Type.Named{name: parameter.name}}
                loop function in value.methods {
                    if function.name == method {
                        candidate :: sema_call_static_local_target(symbol, value.name, declared_owner, owner_params, owner_type_args, function, type_args, args, expected, environment, program, &scopes, &state, &tail_store, &context, span, &diagnostics) ?? next
                        &targets.push(candidate)
                    }
                }
            }
            else -> {}
        }
    }
    targets
}

fn sema_call_static_local_defaults(target: SemaStaticMethodTarget, binding: SemaCallBinding, environment: SemaScopeEnvironment, program: SemaProgramTables) -> [SemaCallDefaultValue]? {
    if binding.default_refs.len() == 0 -> return Val([SemaCallDefaultValue]{})
    function :: target.function ?? return None
    defaults := [SemaCallDefaultValue]{}
    loop reference in binding.default_refs {
        if reference.owner_key != target.method.symbol.key -> return None
        parameter_index :: reference.parameter_index
        if parameter_index < 0 || parameter_index >= function.params.len() -> return None
        expression :: function.params[parameter_index].default ?? return None
        expression_span :: expr_span(expression)
        if expression_span.start != reference.span.start || expression_span.end != reference.span.end -> return None
        source_file :: sema_source_file_at(environment.source_segments, reference.source_file, environment.source_origin, expression_span)
        if source_file != reference.source_file -> return None
        &defaults.push(SemaCallDefaultValue{reference: reference, expression: expression})
    }
    Val(defaults)
}

fn sema_call_static_rewrite_value(value: &TExpr, target: SemaStaticMethodTarget, method_id: DeclID) -> Bool Never! {
    if value.kind == {
        .Call(symbol, type_args, args) -> {
            if symbol.row.index() != method_id.row.index() -> return false
            // The method's inferred type arguments bind any owner parameter
            // its own same-named parameter shadows.
            owner_type := target.owner_type
            if type_args.len() > 0 && type_args.len() == target.target.generic_params.len() {
                bindings :: loop index in 0..<type_args.len() -> SemaInferenceBinding{name: target.target.generic_params[index].name, ty: type_args[index], source: "static method"}
                owner_type = sema_inference_substitute_type_bindings(owner_type, bindings)
            }
            value.kind = TExprKind.StaticCall{owner: TStaticOwner.User{name: target.owner_name}, owner_type: Val(owner_type), method: target.method, type_args: type_args, args: args}
            return true
        }
        .TraitBox(inner, target_type) -> {
            updated_inner := inner
            if !sema_call_static_rewrite_value(&updated_inner, target, method_id) -> return false
            value.kind = TExprKind.TraitBox{value: updated_inner, target: target_type}
            return true
        }
        .InlineBlock(statements) -> {
            if statements.len() == 0 -> return false
            last :: statements.len() - 1
            if statements[last] == {
                .ExprStmt(call, statement_span) -> {
                    updated_call := call
                    if !sema_call_static_rewrite_value(&updated_call, target, method_id) -> return false
                    updated_statements := statements.copy()
                    updated_statements[last] = TStmt.ExprStmt{value: updated_call, span: statement_span}
                    value.kind = TExprKind.InlineBlock{body: updated_statements}
                    return true
                }
                else -> return false
            }
        }
        else -> return false
    }
    false
}
fn sema_call_static_call_value(value: TExpr, method_id: DeclID) -> TExpr? {
    if value.kind == {
        .Call(callee, _, _) -> if callee.row.index() == method_id.row.index() -> return Val(value) else -> return None
        .TraitBox(inner, _) -> return sema_call_static_call_value(inner, method_id)
        .InlineBlock(statements) -> {
            if statements.len() == 0 -> return None
            last :: statements.len() - 1
            if statements[last] == {
                .ExprStmt(call, _) -> return sema_call_static_call_value(call, method_id)
                else -> return None
            }
        }
        else -> return None
    }
}

// Built-in owners (`Int.parse`, `U8.from_int`, `Atomic<Int>.new`,
// `crypto.Hasher.new`) have no declaration to resolve. Their checked contract
// is the Foundation BuiltinStaticRow table: this layer admits the row for how
// the owner was named, binds its type parameters, checks arity and argument
// types, and builds the row's TIR node.
fn sema_call_builtin_static_admitted(row: BuiltinStaticRow, module_name: String) -> Bool Never! {
    if row.module_name == module_name -> return true
    row.module_name == "" && (module_name == "" || core_module_has_type(module_name, row.owner))
}

fn sema_call_builtin_static_row(owner: String, method: String, module_name: String) -> BuiltinStaticRow? {
    loop row in builtin_static_rows(owner, method) {
        if sema_call_builtin_static_admitted(row, module_name) -> return Val(row)
    }
    None
}

fn sema_call_builtin_static_bound(bindings: [SemaInferenceBinding], name: String) -> Bool Never! {
    loop binding in bindings {
        if binding.name == name -> return true
    }
    false
}

// A row parameter is open while the declared row type names it and no
// evidence has bound it. A bound value is the caller's type, read once as
// written (Rust single-pass `substitute_type`): inside `fn f<T>`,
// `shared (T?{…})` binds the row's `T` to the caller's `T?`, whose `T` is not
// the row parameter again.
fn sema_call_builtin_static_open(ty: Type, row: BuiltinStaticRow, bindings: [SemaInferenceBinding]) -> Bool Never! {
    loop name in row.type_params {
        if !sema_call_builtin_static_bound(bindings, name) && sema_inference_type_mentions_param(ty, name) -> return true
    }
    false
}

fn sema_call_builtin_static_closed(ty: Type, row: BuiltinStaticRow, bindings: [SemaInferenceBinding]) -> Type Never! {
    complete := bindings
    loop name in row.type_params {
        if !sema_call_builtin_static_bound(bindings, name) -> &complete.push(SemaInferenceBinding{name: name, ty: Type.Int, source: "builtin static default"})
    }
    sema_inference_substitute_type_bindings(ty, complete)
}

// Bind unbound row type parameters structurally; an already bound parameter
// keeps its first evidence and later mismatches surface as type errors.
fn sema_call_builtin_static_bind(pattern: Type, actual: Type, row: BuiltinStaticRow, bindings: &[SemaInferenceBinding]) -> Bool Never! {
    if pattern == .Named(name) {
        if builtin_static_is_type_param(row, name) && !sema_call_builtin_static_bound(bindings, name) -> &bindings.push(SemaInferenceBinding{name: name, ty: actual, source: "builtin static"})
        return true
    }
    if actual == .Tagged(_, inner) -> return sema_call_builtin_static_bind(pattern, inner, row, &bindings)
    if pattern == {
        .List(element) -> if actual == {
            .List(offered) | .FixedList(offered, _) -> sema_call_builtin_static_bind(element, offered, row, &bindings)
            else -> false
        }
        .Option(inner) -> if actual == {
            .Option(offered) -> sema_call_builtin_static_bind(inner, offered, row, &bindings)
            else -> false
        }
        .Result(ok, err) -> if actual == {
            .Result(offered_ok, offered_err) -> sema_call_builtin_static_bind(ok, offered_ok, row, &bindings) && sema_call_builtin_static_bind(err, offered_err, row, &bindings)
            else -> false
        }
        .Map(key, _, value) -> if actual == {
            .Map(offered_key, _, offered_value) -> sema_call_builtin_static_bind(key, offered_key, row, &bindings) && sema_call_builtin_static_bind(value, offered_value, row, &bindings)
            else -> false
        }
        .Apply(name, pattern_args) -> if actual == {
            .Apply(offered_name, offered_args) -> {
                if offered_name != name || offered_args.len() != pattern_args.len() -> return false
                loop index in 0..<pattern_args.len() {
                    if !sema_call_builtin_static_bind(pattern_args[index], offered_args[index], row, &bindings) -> return false
                }
                true
            }
            else -> false
        }
        else -> true
    }
}

// Internal tags (crypto nominals, clock kinds) do not change which built-in
// argument a value satisfies.
fn sema_call_builtin_static_untagged(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(marker, inner) -> if marker == {
            .Internal(_) -> sema_call_builtin_static_untagged(inner)
            else -> ty
        }
        else -> ty
    }
}

fn sema_call_builtin_static_accepts(required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if type_identity_equal(required, offered) -> return true
    if sema_call_type_assignable(required, offered, environment, program) == (.Val(true)) -> return true
    sema_call_type_assignable(sema_call_builtin_static_untagged(required), sema_call_builtin_static_untagged(offered), environment, program) == (.Val(true))
}

// A Union parameter (`Duration.seconds(Int | Float)`) accepts any member
// exactly; a single parameter also admits a checked numeric widening.
fn sema_call_builtin_static_coerce(value: TExpr, required: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    if required == .Union(members) {
        loop member in members {
            if sema_call_builtin_static_accepts(member, value.ty, environment, program) -> return Val(value)
        }
        &diagnostics.push(sema_type_mismatch(required, value.ty, span))
        return None
    }
    if sema_call_builtin_static_accepts(required, value.ty, environment, program) -> return Val(value)
    if sema_expr_numeric_widening_to(value.ty, required) == (.Val(true)) {
        line :: sema_source_line_at(environment.source_segments, value.span) ?? 0
        return sema_expr_numeric_literal_conversion(value, required, value.span, line, &diagnostics)
    }
    &diagnostics.push(sema_type_mismatch(required, value.ty, span))
    None
}

fn sema_call_builtin_static_argument(argument: CallArg, declared: Type, row: BuiltinStaticRow, bindings: &[SemaInferenceBinding], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if !sema_call_builtin_static_open(declared, row, bindings) {
        required := sema_call_resolved_type(sema_inference_substitute_type_bindings(declared, bindings), environment, program)
        // A Union slot hints only a decimal literal, which takes its machine
        // float member instead of exact Decimal.
        hint := if required == {.Union(_) -> None else -> Val(required)}
        // copy: `required` stays the coercion target below
        if required == .Union(_) && sema_expr_decimal_literal_operand(argument.expr, false) -> hint = Val(required.copy())
        checked :: sema_check_expression(argument.expr, hint, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        return sema_call_builtin_static_coerce(checked, required, argument.span, environment, program, &diagnostics)
    }
    checked :: sema_check_expression(argument.expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    _ := sema_call_builtin_static_bind(declared, checked.ty, row, &bindings)
    if sema_call_builtin_static_open(declared, row, bindings) {
        &diagnostics.push(sema_type_mismatch(sema_call_builtin_static_closed(declared, row, bindings), checked.ty, argument.span))
        return None
    }
    required := sema_call_resolved_type(sema_inference_substitute_type_bindings(declared, bindings), environment, program)
    sema_call_builtin_static_coerce(checked, required, argument.span, environment, program, &diagnostics)
}

fn sema_call_builtin_static_discard(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
}

fn sema_call_builtin_static_shape(row: BuiltinStaticRow, callee: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if type_args.len() > 0 {
        &diagnostics.push(sema_call_generic_count_diagnostic(callee, 0, type_args.len(), span))
        return false
    }
    if owner_type_args.len() > 0 && owner_type_args.len() != row.owner_type_params {
        &diagnostics.push(sema_call_generic_count_diagnostic(callee, row.owner_type_params, owner_type_args.len(), span))
        return false
    }
    if row.owner_rule == BuiltinStaticOwnerRule.AtomicScalar && owner_type_args.len() == 0 {
        &diagnostics.push(sema_error("E0904", span, "cannot infer the owner type arguments for `{callee}`", "`Atomic<T>` construction names its scalar type on the owner", "write `Atomic<Int>.{row.method}(value)`"))
        return false
    }
    count := row.parameters.len()
    if args.len() != count {
        &diagnostics.push(sema_error(row.arity_code, span, "`{callee}` expects {count} argument{if count == 1 -> "" else -> "s"}, got {args.len()}", "a built-in static method has a fixed argument shape", "pass exactly {count} argument{if count == 1 -> "" else -> "s"}"))
        return false
    }
    loop argument in args {
        if argument.label != None {
            &diagnostics.push(sema_error("E0104", argument.span, "`{callee}` takes positional arguments", "built-in static methods have no argument labels", "remove the argument label"))
            return false
        }
    }
    true
}

fn sema_call_builtin_static_carrier(result: Type) -> TFailureCarrier Never! {
    if result == {
        // copy: `ok` and `err` are payloads of read parameter `result`, which keeps the originals; the new TFailureCarrier.Result's fields own `ok` and `err`
        .Result(ok, err) -> TFailureCarrier.Result{success: ok.copy(), error: err.copy()}
        // copy: `inner` is a payload of read parameter `result`, which keeps the original; field `value` of the new TFailureCarrier.Optional owns this one
        .Option(inner) -> TFailureCarrier.Optional{value: inner.copy()}
        else -> TFailureCarrier.Infallible
    }
}

fn sema_call_builtin_static_call_arg(value: TExpr, argument: CallArg) -> TCallArg Never! {
    TCallArg{
        value: value,
        template_items: [SymbolID]{},
        borrow: argument.convention == AccessConvention.Read && !sema_call_is_scalar(value.ty),
        mut_borrow: argument.convention == AccessConvention.Write,
        fn_coerce: None,
        widen_to_vec: false,
        widen_to_union: None,
        box_as_trait: None,
        label: None,
        spread: false,
    }
}

// CoreCall rows lower through the registered Core route in the caller.
fn sema_call_builtin_static_lowered(row: BuiltinStaticRow, values: [TExpr], args: [CallArg], bindings: [SemaInferenceBinding], span: Span, context: &SemaCheckContext) -> TExprKind? {
    rest := [TExpr]{}
    loop index in 0..<values.len() {
        if index > 0 -> &rest.push(values[index])
    }
    if row.lowering == {
        // copy: `operation` is a payload of read parameter `row`, which keeps the original; field `operation` of the new TExprKind.BuiltinMethod owns this one
        .ArgumentBuiltin(operation) -> Val(TExprKind.BuiltinMethod{receiver: values[0], operation: operation.copy(), args: rest})
        .IntFromRadix -> Val(TExprKind.BuiltinMethod{receiver: values[0], operation: TBuiltinOp.IntFromRadix, args: rest})
        // copy: `operation` is a payload of read parameter `row`, which keeps the original; field `operation` of the new TExprKind.BuiltinMethod owns this one
        .UnitBuiltin(operation) -> Val(TExprKind.BuiltinMethod{receiver: sema_node(&context, Type.Named{name: "Unit"}, NodeKind.Unit, span), operation: operation.copy(), args: values})
        .PreludeStatic(rooted, path, generics) -> {
            owner_args :: loop generic in generics -> if generic == {
                .Jet(ty) -> TPreludeArg.Jet{ty: sema_inference_substitute_type_bindings(ty, bindings)}
                .HostUsize -> TPreludeArg.HostUsize
            }
            call_args := [TCallArg]{}
            loop index in 0..<values.len() -> &call_args.push(sema_call_builtin_static_call_arg(values[index], args[index]))
            reference := TMethodRef{symbol: symbol_id(SymbolKind.Function, row.module_name, path, row.method), name: row.method, mangled: false, trait_owner: None, operator_identity: None}
            Val(TExprKind.StaticCall{owner: TStaticOwner.Prelude{rooted: rooted, path: path, generics: owner_args}, owner_type: None, method: reference, type_args: [Type]{}, args: call_args})
        }
        .DurationNew(unit_name) -> Val(TExprKind.HandleMethod{receiver: values[0], operation: THandleOp.DurationNew{unit: unit_name, float: values[0].ty == Type.Float || values[0].ty == Type.Float32}, args: [TExpr]{}})
        .EmptyMap -> Val(TExprKind.MapLit{entries: [TMapEntry]{}})
        // copy: `operation` is a payload of read parameter `row`, which keeps the original; field `operation` of the new TExprKind.NumericMethod owns this one
        .Numeric(operation) -> Val(TExprKind.NumericMethod{receiver: values[0], operation: operation.copy()})
        .Precise(precise_type, function) -> Val(TExprKind.PreciseBuiltin{type_name: precise_type, function: function, args: values})
        .CoreCall(_, _) -> None
    }
}

fn sema_call_try_builtin_static(owner: String, module_name: String, method: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    row :: sema_call_builtin_static_row(owner, method, module_name) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    callee := "{owner}.{method}"
    if !sema_call_builtin_static_shape(row, callee, owner_type_args, type_args, args, span, &diagnostics) {
        sema_call_builtin_static_discard(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    bindings := [SemaInferenceBinding]{}
    loop index in 0..<owner_type_args.len() {
        &bindings.push(SemaInferenceBinding{name: row.type_params[index], ty: sema_call_resolved_type(owner_type_args[index], environment, program), source: "builtin static owner"})
    }
    if row.owner_rule == BuiltinStaticOwnerRule.AtomicScalar && !jet_target_layout_atomic_scalar_type(bindings[0].ty) {
        &diagnostics.push(sema_error("E0311", span, "`Atomic<{type_name(bindings[0].ty)}>` has no static method `{method}`", "`Atomic<T>` holds one lock-free scalar: Bool, Int, or a 32- or 64-bit integer", "use a supported scalar, or `Shared<T>` for other values"))
        sema_call_builtin_static_discard(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }

    values := [TExpr]{}
    explicit_moves := [Bool]{}
    loop index in 0..<args.len() {
        value :: sema_call_builtin_static_argument(args[index], row.parameters[index], row, &bindings, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        // A written `^name` is a checked move, as for any consuming argument
        // (Calls/Checking.jet): never a silent copy, E0201 on a read
        // parameter. `shared name`'s operand carries no written `^`.
        explicit :: args[index].convention == AccessConvention.Move && !args[index].flags.shared_operand && args[index].expr == .Ident(_, _, _) && !sema_ownership_type_is_copy(value.ty)
        if explicit && sema_ownership_reject_read_param_move(&state, args[index].expr, scopes, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        &explicit_moves.push(explicit)
        &values.push(sema_call_marked_move_value(&state, explicit, args[index].expr, ^value, scopes, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None})
    }
    // Rust `finish_builtin_method` (and `shared x`'s `Shared.new` arm)
    // declares no parameter conventions for a builtin static: a written `^`
    // is the consuming argument's exact move. The bare name `shared x` moves
    // here like an unmarked owning position: a borrowed parameter keeps its
    // value, and a later use turns the move into a share.
    params := [SemaCallParam]{}
    ownership_args := args
    named_moves := [Int]{}
    loop index in 0..<values.len() {
        convention := row.parameter_convention
        if args[index].convention == AccessConvention.Move {
            if args[index].expr == {
                .Ident(_, _, _) -> {
                    if explicit_moves[index] {
                        convention = AccessConvention.Move
                    } else {
                        convention = AccessConvention.Read
                        ownership_args[index].convention = AccessConvention.Read
                        &named_moves.push(index)
                    }
                }
                else -> convention = AccessConvention.Move
            }
        }
        &params.push(SemaCallParam{label: "arg{index}", name: "arg{index}", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: convention, ty: Val(values[index].ty), variadic: false})
    }
    ownership := sema_ownership_check_call_arguments(&state, callee, params, &ownership_args, scopes, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    loop index in named_moves {
        if !sema_ownership_mark_unmarked_move(&state, args[index].expr, scopes, "`{callee}`", &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    }

    if expected == .Val(expected_type) {
        hint :: sema_call_resolved_type(expected_type, environment, program)
        pattern := row.return_type
        if pattern == .Result(success, _) {
            if hint == {
                .Result(_, _) -> {}
                else -> pattern = success
            }
        }
        _ := sema_call_builtin_static_bind(pattern, hint, row, &bindings)
    }
    loop name in row.type_params {
        if !sema_call_builtin_static_bound(bindings, name) -> &bindings.push(SemaInferenceBinding{name: name, ty: Type.Int, source: "builtin static default"})
    }
    result := sema_inference_substitute_type_bindings(row.return_type, bindings)
    // E0506: `Set.new()` / `Set.from(list)` / `Tally.new()` need a hashable element.
    if (row.owner == "Set" || row.owner == "Tally") && result == .Apply(_, result_args) && result_args.len() == 1 && !sema_type_hashable(environment, program, result_args[0]) {
        element_name :: type_name(result_args[0])
        &diagnostics.push(sema_error("E0506", span, "`{row.owner}<{element_name}>` is not valid — `{element_name}` is not hashable", "{row.owner} elements must implement Hash and Eq; use Int, Bool, String, Char, or a named type", "change the element type to a hashable type, or use a `[{element_name}]` list instead"))
    }

    if row.lowering == .CoreCall(core_module, member) {
        record :: core_call(core_module, member) ?? {
            &diagnostics.push(sema_error("E0906", span, "the canonical `{core_module}.{member}` route for `{callee}` is unavailable", "compiler-owned static constructors lower through the registered CoreCall row", "restore the registered `{core_module}.{member}` route"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        fallibility := sema_call_failure_carrier(Val(result))
        if !sema_call_core_record_effects(record, span, [Type]{}, result, fallibility, [FunctionDefaultRef]{}, &scopes, &context, environment, program, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        widen_to_vec :: loop _ in values -> false
        return SemaMethodSpecialCheck{handled: true, value: sema_call_core_tir(record, values, span, [Type]{}, widen_to_vec, result, fallibility, expected, environment, program, &diagnostics)}
    }

    kind :: sema_call_builtin_static_lowered(row, values, ownership_args, bindings, span, &context) ?? {
        &diagnostics.push(sema_error("E0104", span, "static method call `{callee}` could not be lowered", "the built-in static row has no TIR construction", "use a registered built-in static method"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    facts := SemaCallFacts{return_type: result, failure_carrier: sema_call_builtin_static_carrier(result), effect_bound: Val([EffectRowEntry]{}), type_args: [Type]{}, default_refs: [FunctionDefaultRef]{}}
    if !sema_effect_record_intrinsic_fact(environment, program, &scopes, &context, callee, span, facts, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected_owned(sema_tir_expr(result, kind, span), expected, environment, program, &diagnostics)}
}

// `alias.Owner.method(...)`: a Core module alias names the owner's module.
fn sema_call_try_builtin_static_field(base: Expr, owner: String, method: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    alias :: if base == {
        .Ident(name, _, _) -> name
        else -> { return SemaMethodSpecialCheck{handled: false, value: None} }
    }
    if !sema_expr_core_module_alias_visible(alias, scopes) -> return SemaMethodSpecialCheck{handled: false, value: None}
    module_name :: sema_call_core_import_module(environment, program, alias) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if module_name == "core.crypto" && sema_call_retired_entropy_constructor(owner, method, span) == .Val(retired) {
        &diagnostics.push(retired)
        sema_call_builtin_static_discard(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    builtin := sema_call_try_builtin_static(owner, module_name, method, owner_type_args, type_args, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    if builtin.handled -> return builtin
    // A capitalized `alias.Owner` that no route resolved names no static the
    // Core module provides: report it rather than leaving the call unchecked.
    if !sema_checked_module_uppercase(owner) -> return builtin
    if core_module_has_type(module_name, owner) || core_module_has_member(module_name, owner) {
        &diagnostics.push(sema_error("E0311", span, "`{owner}` has no matching static method `{method}`", "static lookup requires a visible associated method with no `self` receiver and a valid owner type", "call a static method `{owner}` declares, or call `{method}` on a `{owner}` value"))
    } else {
        &diagnostics.push(sema_call_core_unknown_item(module_name, owner, span))
    }
    sema_call_builtin_static_discard(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: None}
}

// Rust `infer_method_call` entropy constructors use
// `new_random`; the retired `generate` spelling is E1004.
fn sema_call_retired_entropy_constructor(owner: String, method: String, span: Span) -> Diagnostic? Never! {
    if method != "generate" || (owner != "SigningKey" && owner != "X25519SecretKey") -> return None
    Val(sema_error("E1004", span, "`{owner}` has no `generate`", "constructors that draw entropy use `new_random`", "use `{owner}.new_random()`"))
}

// The ambient Perf type is an alternate spelling of the checked core.perf
// export, not a second native dispatch surface.
fn sema_call_perf_static(method: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    failed :: SemaMethodSpecialCheck{handled: true, value: None}
    if program.registration_graph == .Val(graph) {
    identity :: sema_call_core_module_identity(environment, program, "core.perf") ?? return failed
    target :: sema_call_core_source_target(environment, program, identity, method, type_args, span, false, &diagnostics) ?? return failed
    probe_args := args
    binding :: sema_call_bind_direct("Perf.{method}", target.signature, &probe_args, span, &diagnostics) ?? return failed
    defaults :: sema_call_registration_defaults(graph, binding) ?? return failed
    call :: Call{name: "Perf.{method}", name_span: span, type_args: type_args, args: args}
    checked :: sema_call_check_direct_target_owned(&state, target, call, defaults, expected, environment, program, &scopes, &tail_store, &context, &diagnostics) ?? return failed
    if !sema_expr_record_call_fact(environment, program, &scopes, &context, span, checked, &diagnostics) -> return failed
    return SemaMethodSpecialCheck{handled: true, value: Val(checked.value)}
    } else {
        return failed
    }
}

// Resolve associated methods through the declaration graph before trying an
// intrinsic row. Core source carriers use the same SymbolId as imported user
// carriers; a qualified owner is not a runtime field access.
fn sema_call_static_source_owner(receiver: Expr, method: String, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> Symbol? Never! {
    owner_name :: if receiver == {
        .Ident(name, _, _) -> {
            if sema_scope_resolve_index(scopes, name) == .Val(index) -> return Val(sema_scope_binding_symbol(environment, scopes, index))
            name
        }
        .Field(base, leaf, _, _) -> {
            alias :: if base == {.Ident(name, _, _) -> name else -> { return None }}
            if !sema_expr_core_module_alias_visible(alias, scopes) -> return None
            "{alias}.{leaf}"
        }
        else -> { return None }
    }
    if program.registration_graph == .Val(graph) {
        found :: sema_type_graph_lookup_symbol(graph, environment.module_identity, owner_name) ?? return None
        if sema_resolved_kind(graph, found) != SymbolKind.Type -> return None
        resolved := found
        row := sema_type_graph_resolved_nominal_row(graph, found) ?? return None
        // A plain alias (`alias Date :: LocalDate`) names its target's statics.
        alias_row :: graph.modules[row.module_index].nominals[row.row]
        if alias_row.kind == SemaRegistrationNominalKind.TypeAlias && alias_row.generic_params.len() == 0 && alias_row.source == .SourceAST(item) && item == .TypeAlias(definition) && definition.target == .Named(target_name) {
            target :: sema_type_graph_lookup_symbol(graph, graph.modules[row.module_index].module_identity, target_name) ?? return None
            if sema_resolved_kind(graph, target) != SymbolKind.Type -> return None
            row = sema_type_graph_resolved_nominal_row(graph, target) ?? return None
            resolved = target
        }
        nominal :: graph.modules[row.module_index].nominals[row.row]
        if !sema_call_static_registered_method_exists(graph, nominal, method, environment, program) -> return None
        return Val(sema_resolved_symbol(graph, resolved))
    } else {
        return None
    }
}

// Rust options_rng.rs:19-135 check_option_lift2 (method_calls.rs:3559):
// `Option.lift2(f, a, b)` is `f(a, b)` when both optionals are present and
// absent otherwise. `a` and `b` are checked first, since `f`'s parameter types
// are their payload types.
fn sema_call_option_lift2(args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    failed :: SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() != 3 {
        &diagnostics.push(sema_error("E0104", span, "`Option.lift2` takes 3 arguments (f, a, b), got {args.len()}", "`Option.lift2(f, a, b)` applies a two-argument function only when both optionals are present", "call `Option.lift2((x, y) -> ..., a, b)`"))
        sema_call_builtin_static_discard(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return failed
    }
    left :: sema_check_expression(args[1].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    right :: sema_check_expression(args[2].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    left_inner := Type?{None}
    right_inner := Type?{None}
    if left == .Val(value) {
        // copy: `inner` is a payload of the checked operand's type, which the operand keeps
        if value.ty == .Option(inner) -> left_inner = Val(inner.copy())
    }
    if right == .Val(value) {
        // copy: `inner` is a payload of the checked operand's type, which the operand keeps
        if value.ty == .Option(inner) -> right_inner = Val(inner.copy())
    }
    if left_inner == None || right_inner == None {
        if left_inner == None {
            shown :: if left == .Val(value) -> sema_type_show(value.ty) else -> "an unknown type"
            &diagnostics.push(sema_error("E0108", expr_span(args[1].expr), "`Option.lift2`'s second argument must be optional, got {shown}", "`Option.lift2(f, a, b)` needs `a: T?`", "pass a `T?` value"))
        }
        if right_inner == None {
            shown :: if right == .Val(value) -> sema_type_show(value.ty) else -> "an unknown type"
            &diagnostics.push(sema_error("E0108", expr_span(args[2].expr), "`Option.lift2`'s third argument must be optional, got {shown}", "`Option.lift2(f, a, b)` needs `b: U?`", "pass a `T?` value"))
        }
        _ := sema_check_expression(args[0].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return failed
    }
    left_value :: left ?? return failed
    right_value :: right ?? return failed
    left_payload :: left_inner ?? return failed
    right_payload :: right_inner ?? return failed
    // copy: the payload types are also the callback's required parameters below
    required :: Type.Fn{params: [Type]{left_payload.copy(), right_payload.copy()}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    // The open result adopts the callback's own return type.
    function :: sema_expression_lambda_collection_callback(args[0].expr, Val(required), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return failed
    result := Type?{None}
    if function.ty == .Fn(params, ret, _, _, _, _) && params.len() == 2 {
        accepts :: sema_call_type_assignable(params[0], left_payload, environment, program) == (Val(true)) && sema_call_type_assignable(params[1], right_payload, environment, program) == (Val(true))
        // copy: `value` is a payload of the checked callable's type, which the callable keeps
        if accepts && ret == .Val(value) -> result = Val(Type.Option{inner: value.copy()})
    }
    result_ty :: result ?? {
        &diagnostics.push(sema_error("E0108", expr_span(args[0].expr), "`Option.lift2`'s first argument must be a function, got {sema_type_show(function.ty)}", "`Option.lift2(f, a, b)` needs `f: fn(T, U) R`", "pass a two-argument function or lambda"))
        return failed
    }
    function_row :: sema_arena_adopt(&context, function)
    left_row :: sema_arena_adopt(&context, left_value)
    right_row :: sema_arena_adopt(&context, right_value)
    value :: sema_node(&context, result_ty, NodeKind.OptionLift2{function: function_row, left: left_row, right: right_row}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected_owned(^value, expected, environment, program, &diagnostics)}
}

fn sema_call_try_static_method(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if receiver == .Call(descriptor, _) -> return sema_call_try_inline_range_conversion(descriptor, method, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    owner_symbol :: sema_call_static_source_owner(receiver, method, environment, program, scopes) ?? {
        if receiver == .Field(base, owner_leaf, _, _) -> return sema_call_try_builtin_static_field(base, owner_leaf, method, owner_type_args, type_args, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        if receiver == .Ident(name, _, _) {
            if name == "Perf" && sema_scope_resolve_index(scopes, name) == None -> return sema_call_perf_static(method, type_args, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            if name == "Option" && method == "lift2" && sema_scope_resolve_index(scopes, name) == None -> return sema_call_option_lift2(args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            if sema_scope_resolve_index(scopes, name) == None && sema_call_retired_entropy_constructor(name, method, span) == .Val(retired) {
                &diagnostics.push(retired)
                sema_call_builtin_static_discard(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            if sema_scope_resolve_index(scopes, name) == None && owner_type_args.len() == 0 && type_args.len() == 0 {
                math := sema_call_try_math_static(name, method, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if math.handled -> return math
            }
            return sema_call_try_builtin_static(name, "", method, owner_type_args, type_args, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        }
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    type_name :: owner_symbol.name
    if owner_symbol.kind != SymbolKind.Type -> return SemaMethodSpecialCheck{handled: false, value: None}
    if method == "new" && args.len() == 3 && type_name == "ExpiringSecret" && sema_module_is_core_source(owner_symbol.module_name) {
        if !sema_call_expiring_secret_new_accepts(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    }

    diagnostics_before := diagnostics.len()
    targets := [SemaStaticMethodTarget]{}
    generic_owner_method := false
    if program.registration_graph == .Val(graph) {
        owner_row :: sema_type_graph_nominal_row(graph, owner_symbol.id.key)
        if owner_row == .Val(row) {
            owner :: graph.modules[row.module_index].nominals[row.row]
            targets = sema_call_static_registered_targets(graph, owner, method, owner_type_args, type_args, args, expected, environment, program, &scopes, &state, &tail_store, &context, span, &diagnostics)
            generic_owner_method = owner.generic_params.len() > 0 && owner_type_args.len() == 0 && sema_call_static_registered_method_exists(graph, owner, method, environment, program)
        }
    }
    if targets.len() == 0 && program.registration_graph == None {
        targets = sema_call_static_local_targets(owner_symbol, method, owner_type_args, type_args, args, expected, environment, program, &scopes, &state, &tail_store, &context, span, &diagnostics)
        generic_owner_method = owner_type_args.len() == 0 && sema_call_static_local_generic_method_exists(owner_symbol, method, environment, program)
    }
    if targets.len() == 0 {
        if diagnostics.len() > diagnostics_before -> return SemaMethodSpecialCheck{handled: true, value: None}
        distinct := sema_call_try_distinct_conversion(owner_symbol, type_name, method, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        if distinct.handled -> return distinct
        // Declared statics win; a canonical Core or compiler owner then falls back to its built-in rows.
        if !generic_owner_method && sema_expr_canonical_type_binding(type_name, scopes) {
            builtin := sema_call_try_builtin_static(type_name, owner_symbol.module_name, method, owner_type_args, type_args, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            if builtin.handled -> return builtin
        }
        if {
            generic_owner_method -> {
                &diagnostics.push(sema_error("E0904", method_span, "cannot infer the owner type arguments for `{type_name}.{method}`", "static method lookup needs one concrete owner type before building `StaticCall`", "provide the owner's type arguments or add argument/expected-type evidence"))
            }
            else -> {
                // Rust `check_static_method_call`: a declared method with a
                // `self` receiver named through its type needs a value. A
                // static of that name failed on its arguments instead.
                instance := false
                loop name in sema_call_declared_method_names(owner_symbol.ty ?? Type.Named{name: type_name}, environment, program) {
                    if name == method {
                        instance = true
                        break
                    }
                }
                if instance && program.registration_graph == .Val(graph) {
                    if sema_type_graph_nominal_row(graph, owner_symbol.id.key) == .Val(row) && sema_call_static_registered_method_exists(graph, graph.modules[row.module_index].nominals[row.row], method, environment, program) -> instance = false
                }
                if instance {
                    &diagnostics.push(sema_error("E0311", method_span, "`{method}` is an instance method on `{type_name}`", "instance methods need a value before the dot", "call it on a `{type_name}` value: `x.{method}(...)`"))
                } else {
                    &diagnostics.push(sema_error("E0311", method_span, "`{type_name}` has no matching static method `{method}`", "static lookup requires a visible associated method with no `self` receiver and a valid owner type", "use a declared static method on this type"))
                }
            }
        }
        return SemaMethodSpecialCheck{handled: true, value: None}
    }

    direct_targets :: loop target in targets -> target.target
    selected :: sema_call_resolve_direct_candidates("{type_name}.{method}", args, direct_targets, span, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    target := targets[0]
    loop candidate in targets {
        if candidate.target.symbol.id.key == selected.symbol.id.key {
            target = candidate
            break
        }
    }
    probe_args := args
    binding :: sema_call_bind_direct("{type_name}.{method}", selected.signature, &probe_args, span, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    defaults :: if program.registration_graph == .Val(graph) -> sema_call_registration_defaults(graph, binding) ?? return SemaMethodSpecialCheck{handled: true, value: None} else -> sema_call_static_local_defaults(target, binding, environment, program) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    call := Call{name: "{type_name}.{method}", name_span: span, type_args: type_args, args: args}
    checked :: sema_call_check_direct_target_owned(&state, selected, call, defaults, expected, environment, program, &scopes, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    method_id :: sema_call_callee_decl(program, target.method.symbol, span, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    call_value :: sema_call_static_call_value(checked.value, method_id) ?? {
        &diagnostics.push(sema_error("E0104", span, "static method call `{type_name}.{method}` could not be lowered", "the checked callable did not preserve its registered SymbolId", "use the registered static method declaration"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    call_checked := checked
    call_checked.value = call_value
    &context.call_return_views.push(SemaCallReturnView{span: span, facts: checked.return_view_facts})
    if !sema_expr_record_call_fact(environment, program, &scopes, &context, span, call_checked, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := checked.value
    if !sema_call_static_rewrite_value(&value, target, method_id) {
        &diagnostics.push(sema_error("E0104", span, "static method call `{type_name}.{method}` could not be lowered", "the checked callable did not preserve its registered SymbolId", "use the registered static method declaration"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    SemaMethodSpecialCheck{handled: true, value: Val(value)}
}

// `ExpiringSecret.new` owns only the closed secret family (E0112 at the value)
// and observes only an injected Clock (E0112 at the clock). The arguments are
// probed: the ordinary source call that follows checks and moves them once.
fn sema_call_expiring_secret_new_accepts(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    accepted := true
    probe_diagnostics := [Diagnostic]{}
    value :: sema_probe_expression(args[0].expr, None, environment, program, &scopes, &state, &tail_store, &context, &probe_diagnostics)
    if value == .Val(checked_value) && !sema_is_expiring_secret_member_type(sema_call_resolved_type(checked_value.ty, environment, program)) {
        &diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`ExpiringSecret.new` cannot own {sema_type_show(checked_value.ty)}", "expiring secrets accept only the closed, move-only secret family with audited zeroizing Drop behavior", "convert text or bytes to `crypto.Secret`, or use `crypto.SigningKey` / `crypto.X25519SecretKey`"))
        accepted = false
    }
    clock :: sema_probe_expression(args[2].expr, None, environment, program, &scopes, &state, &tail_store, &context, &probe_diagnostics)
    if clock == .Val(checked_clock) && !sema_call_is_clock_type(checked_clock.ty) {
        &diagnostics.push(sema_error("E0112", expr_span(args[2].expr), "`ExpiringSecret.new` wants `Clock` for argument 3, but this is {sema_type_show(checked_clock.ty)}", "secret expiry must observe the explicitly injected clock", "use `Clock.new(...)` for deterministic code or `Clock.system()` for production"))
        accepted = false
    }
    accepted
}

fn sema_call_is_clock_type(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "Clock" || sema_core_canonical_leaf(name, "core.time", "Core/time/time.jet") == (Val("Clock"))
        .Tagged(_, inner) -> sema_call_is_clock_type(inner)
        else -> false
    }
}

// The numeric destination conversion a distinct type
// inherits from its numeric base (`UserID.from_int`, `Meters.from_float`):
// the base's own built-in conversion row.
fn sema_call_distinct_numeric_row(base: Type, method: String) -> BuiltinStaticRow? {
    if !sema_expr_is_numeric(base) -> return None
    loop row in builtin_static_rows(type_name(base), method) {
        if row.lowering == .Numeric(_) -> return Val(row)
    }
    None
}

fn sema_call_distinct_numeric_operation(row: BuiltinStaticRow) -> TNumericOp? {
    // copy: `operation` is a payload of read parameter `row`, which keeps the original; the Val carrier owns this one
    if row.lowering == .Numeric(operation) -> return Val(operation.copy())
    None
}

// A distinct over a non-numeric base is built by its base-named conversion
// (`Name.from_string(text)` over `String`).
fn sema_call_distinct_base_method(base: Type) -> String {
    "from_{sema_casing_canonical(type_name(base), SemaNameCase.Snake)}"
}

fn sema_call_distinct_conversion_unhandled() -> SemaMethodSpecialCheck Never! {
    SemaMethodSpecialCheck{handled: false, value: None}
}

fn sema_call_distinct_conversion_failed() -> SemaMethodSpecialCheck Never! {
    SemaMethodSpecialCheck{handled: true, value: None}
}

// A distinct type owns the conversion
// from its base (`UserID.from_int(42)`). A literal is proved against a range
// type's bounds here (E0135); a runtime value makes the range type's
// conversion fallible, which a binding then reports (E0136).
fn sema_call_try_distinct_conversion(owner: Symbol, display_name: String, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    facts :: sema_expr_distinct_facts(Type.Named{name: display_name}, environment, program, &scopes) ?? return sema_call_distinct_conversion_unhandled()
    numeric_row :: sema_call_distinct_numeric_row(facts.base, method)
    if numeric_row == None && (sema_expr_is_numeric(facts.base) || method != sema_call_distinct_base_method(facts.base)) -> return sema_call_distinct_conversion_unhandled()
    callee :: "{display_name}.{method}"
    if args.len() != 1 {
        &diagnostics.push(sema_error("E0104", span, "`{callee}` takes one value, got {args.len()}", "a distinct conversion wraps exactly one value of its base type", "write `{callee}(value)`"))
        sema_call_builtin_static_discard(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return sema_call_distinct_conversion_failed()
    }
    source :: if numeric_row == .Val(row) -> row.parameters[0] else -> facts.base
    diagnostics_before :: diagnostics.len()
    argument :: sema_check_expression(args[0].expr, Val(source), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return sema_call_distinct_conversion_failed()
    if diagnostics.len() > diagnostics_before -> return sema_call_distinct_conversion_failed()
    if !type_identity_equal(argument.ty, source) {
        &diagnostics.push(sema_error("E0108", expr_span(args[0].expr), "argument to `{callee}` should be {type_name(source)}, not {type_name(argument.ty)}", "the source name fixes the conversion input type", "pass a {type_name(source)} value"))
        return sema_call_distinct_conversion_failed()
    }
    params :: [SemaCallParam]{SemaCallParam{label: "arg0", name: "arg0", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(argument.ty), variadic: false}}
    ownership_args := args
    ownership := sema_ownership_check_call_arguments(&state, callee, params, &ownership_args, scopes, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return sema_call_distinct_conversion_failed()
    success :: Type.Named{name: display_name}
    row :: numeric_row ?? {
        constructed :: sema_tir_node(success, TExprKind.DistinctCtor{argument: argument}, span)
        return SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(constructed, expected, environment, program, context, &diagnostics)}
    }
    operation :: sema_call_distinct_numeric_operation(row) ?? return sema_call_distinct_conversion_failed()
    // Rust `converted_literal`: an integer literal that fits the base is
    // known at compile time, so a range type checks it here.
    literal_in_range := false
    if facts.range == .Val(bounds) {
        if argument.kind == .IntLit(literal, _) {
            base_bounds :: sema_expr_integer_range_for_type(facts.base)
            fits_base :: if base_bounds == .Val(base_range) -> literal >= base_range.lo && literal <= base_range.hi else -> true
            if sema_expr_is_integer(source) && sema_expr_is_integer(facts.base) && fits_base {
                literal_in_range = true
                if literal < bounds.lo || literal > bounds.hi {
                    &diagnostics.push(sema_error("E0135", argument.span, "`{literal}` is outside `{display_name}`'s range {bounds.lo}..{bounds.hi}", "a range type only holds values inside its bounds; `{literal}` can never be a `{display_name}`", "use a value in `{bounds.lo}..{bounds.hi}`, or widen the type's range"))
                }
            }
        }
    }
    base_fallible :: if row.return_type == {
        .Result(_, _) -> true
        else -> false
    }
    fallible :: base_fallible || (facts.range != None && !literal_in_range)
    result :: if fallible -> Type.Result{ok: success, err: Type.String} else -> success
    argument_row :: sema_arena_adopt(&context, argument)
    converted :: sema_node(&context, result, NodeKind.DistinctConvert{owner: owner.id, argument: argument_row, operation: operation, range: facts.range, fallible: fallible}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(converted, expected, environment, program, context, &diagnostics)}
}

// (#1549): `Int(lo..hi)` written as a call is the type head of
// an inline range conversion, not a runtime constructor.
fn sema_call_inline_range_descriptor(descriptor: Call) -> SemaIntegerRange? {
    if descriptor.name != "Int" || descriptor.args.len() != 1 -> return None
    if descriptor.args[0].expr == .Range(start, end, exclusive, _, _) {
        if exclusive -> return None
        if start == .Int(lo, _, _, _, _) {
            if end == .Int(hi, _, _, _, _) -> return Val(SemaIntegerRange{lo: lo, hi: hi})
        }
    }
    None
}

// E0135: an integer literal outside an inline range.
fn sema_inline_range_out_of_bounds(value: Int, lo: Int, hi: Int, span: Span) -> Diagnostic {
    sema_error("E0135", span, "`{value}` is outside `Int({lo}..{hi})`'s range {lo}..{hi}", "a range type only holds values inside its bounds; `{value}` can never be an `Int({lo}..{hi})`", "use a value in `{lo}..{hi}`, or widen the type's range")
}

// `Int(lo..hi).from_int(value)`. A literal is proved against
// the interval here (E0135); a runtime value converts fallibly.
fn sema_call_try_inline_range_conversion(descriptor: Call, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "from_int" -> return sema_call_distinct_conversion_unhandled()
    if sema_scope_resolve_index(scopes, "Int") == .Val(int_binding) {
        if scopes.bindings[int_binding].symbol.kind != SymbolKind.Type -> return sema_call_distinct_conversion_unhandled()
    }
    bounds :: sema_call_inline_range_descriptor(descriptor) ?? return sema_call_distinct_conversion_unhandled()
    head :: "Int({bounds.lo}..{bounds.hi})"
    if bounds.lo > bounds.hi {
        &diagnostics.push(sema_error("E0137", span, "this range is empty — {bounds.lo} is after {bounds.hi}", "a range's low bound must not be greater than its high bound", "write `{bounds.hi}..{bounds.lo}` (swap the bounds), or fix the values"))
        sema_call_builtin_static_discard(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return sema_call_distinct_conversion_failed()
    }
    if args.len() != 1 {
        &diagnostics.push(sema_error("E0104", span, "`{head}.{method}` takes one value, got {args.len()}", "a range conversion wraps exactly one integer value", "write `{head}.{method}(value)`"))
        sema_call_builtin_static_discard(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return sema_call_distinct_conversion_failed()
    }
    // A propagating runtime conversion inside a binding is reported at its
    // value (E0136); a carrier consumer (`??`, `?`) handles the failure.
    reports_runtime :: context.failure_success_view && context.binding_initializer
    checked :: sema_check_expression(args[0].expr, Val(Type.Int), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return sema_call_distinct_conversion_failed()
    argument :: sema_expr_expected(checked, Val(Type.Int), environment, program, &diagnostics) ?? return sema_call_distinct_conversion_failed()
    target :: Type.InlineRange{base: Type.Int, lo: bounds.lo, hi: bounds.hi}
    literal := false
    if args[0].expr == .Int(value, literal_span, _, _, _) {
        literal = true
        if value < bounds.lo || value > bounds.hi -> &diagnostics.push(sema_inline_range_out_of_bounds(value, bounds.lo, bounds.hi, literal_span))
    }
    if !literal && reports_runtime -> &diagnostics.push(sema_range_runtime_conversion(head, method, expr_span(args[0].expr)))
    result :: if literal -> target else -> Type.Result{ok: target, err: Type.String}
    converted :: sema_tir_node(result, TExprKind.NumericMethod{receiver: argument, operation: TNumericOp.InlineRange{lo: bounds.lo, hi: bounds.hi, fallible: !literal}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(converted, expected, environment, program, context, &diagnostics)}
}

// E0136: a runtime value entering a range type needs the
// fallible conversion's failure handled.
fn sema_range_runtime_conversion(head: String, method: String, span: Span) -> Diagnostic {
    sema_error("E0136", span, "making a `{head}` from a runtime value can fail", "only a literal is checked at compile time; a runtime number needs the fallible form so a bad value is handled", "write `{head}.{method}(raw)?` and handle the failure")
}
