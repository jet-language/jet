// Static associated-method lookup and checked StaticCall construction.
// The owner is a type name, never a runtime receiver; owner and method generic
// arguments stay separate through inference and checked-tree construction.
use jet_foundation.[
    AccessConvention,
    BuiltinStaticOwnerRule,
    BuiltinStaticRow,
    Call,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    Func,
    FunctionDefaultRef,
    NodeKind,
    ParamZone,
    Span,
    Symbol,
    DeclID,
    SymbolID,
    SymbolKind,
    TBuiltinOp,
    TFailureCarrier,
    TMethodRef,
    TGenericParam,
    TNumericOp,
    TPreludeArg,
    TStaticOwner,
    Type,
    SemaNameCase,
    sema_casing_canonical,
    builtin_static_is_type_param,
    builtin_static_numeric_row,
    builtin_static_rows,
    core_call,
    core_module_has_member,
    core_module_has_type,
    diagnostic_registry_row,
    expr_span,
    foundation_named_type,
    jet_target_layout_atomic_scalar_type,
    symbol_is_local,
    symbol_key_text,
    type_identity_equal,
    type_name,
    ModuleID,
    module_is_core,
    module_is_none,
    owned_trait_conversion,
]

SemaStaticMethodTarget: struct {
    owner_name: String
    owner_type: Type
    method: TMethodRef
    target: SemaCallDirectTarget
    function: Func?
}

sema_call_static_registered_method_exists: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, method: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    sema_call_registered_method_names(graph, nominal, true, environment, program).contains(method)
}

// The visible associated methods of `nominal`, in declaration order: its
// statics (no `self` receiver) when `statics`, else its instance methods.
sema_call_registered_method_names: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, statics: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables) -> [String] Never! {
    names := [String]{}
    nominal_module: nominal.symbol.module_identity
    owner_module := nominal_module
    owner_package := ""
    if sema_type_graph_nominal_row(graph, nominal.symbol.id) == .Val(owner_row) {
        owner_module = graph.modules[owner_row.module_index].module_identity
        owner_package = graph.modules[owner_row.module_index].package_identity
    }
    loop function in nominal.methods {
        is_static: function.parameters.len() == 0 || function.parameters[0].symbol.name != "self"
        if is_static == statics && !names.contains(function.symbol.name) && sema_registration_visible(function.symbol.visibility, environment.module_identity, environment.package_identity, owner_module, owner_package) {
            names.push(function.symbol.name.copy())
        }
    }
    // Only impls registered under the owner's name can target it (Rust
    // `registry.method` on the resolved owner), in module/row order.
    loop impl_row in sema_registration_impl_rows_named(graph, nominal.symbol.name) {
        implementation: graph.modules[impl_row.module_index].impls[impl_row.row]
        if !sema_call_impl_targets(implementation, nominal) -> next
        loop function in implementation.methods {
            is_static: function.parameters.len() == 0 || function.parameters[0].symbol.name != "self"
            if is_static == statics && !names.contains(function.symbol.name) && sema_registration_visible(function.symbol.visibility, environment.module_identity, environment.package_identity, graph.modules[impl_row.module_index].module_identity, graph.modules[impl_row.module_index].package_identity) {
                names.push(function.symbol.name.copy())
            }
        }
    }
    names
}

// Whether `implementation` is an inherent impl of `nominal`: registered under
// its identity, or under its module and name.
sema_call_impl_targets: fn(implementation: SemaRegistrationImpl, nominal: SemaRegistrationNominal) -> Bool Never! {
    if implementation.trait_name != None -> return false
    if implementation.target_identity_key == nominal.identity_key -> return true
    !module_is_none(implementation.target_module_identity) && implementation.target_module_identity == nominal.symbol.module_identity && implementation.target_type_name == nominal.symbol.name
}

// Whether registration generated `nominal`'s associated method `name`, such
// as a codec's `decode` and `__read`. The type's source never declares it, so
// a Fix listing what the type declares leaves it out.
sema_call_method_is_generated: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, name: String) -> Bool Never! {
    loop function in nominal.methods {
        if function.symbol.name == name && function.declaration.compiler_generated -> return true
    }
    loop impl_row in sema_registration_impl_rows_named(graph, nominal.symbol.name) {
        implementation: graph.modules[impl_row.module_index].impls[impl_row.row]
        if !sema_call_impl_targets(implementation, nominal) -> next
        loop function in implementation.methods {
            if function.symbol.name == name && (implementation.compiler_generated || function.declaration.compiler_generated) {
                return true
            }
        }
    }
    false
}

SEMA_CALL_SCALAR_OWNERS: [String]{"Int", "Float", "Bool", "String", "Char", "F32", "F64", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64"}

// `Owner.method(...)` where `Owner` is a registered type no scope binding
// shadows and no static route resolved: the type exists, so the missing
// member is reported, never the owner (E0311).
sema_call_static_missing_member: fn(receiver: Expr, method: String, method_span: Span, args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    unhandled: SemaMethodSpecialCheck{handled: false, value: None}
    owner: if receiver == {
        .Ident(name, _, _) -> name
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
            return unhandled
        }
    }
    if sema_scope_resolve_index(scopes, owner) != None -> return unhandled
    // A built-in scalar owner that no declaration takes over has no
    // registered type; every documented static method on it resolved
    // before this point.
    scalar_owner := SEMA_CALL_SCALAR_OWNERS.contains(owner)
    if scalar_owner && program.registration_graph == .Val(graph) {
        scalar_owner = sema_type_graph_lookup_symbol(graph, environment.module_identity, owner) == None
    }
    if scalar_owner {
        diagnostics.push(sema_error("E0102", method_span, "`{owner}` has no static method `{method}`", "built-in types expose only their documented static methods", "call a documented static method on `{owner}`, or call `.{method}()` on a value that provides it"))
        sema_call_builtin_static_discard(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if program.registration_graph == .Val(graph) {
        found: sema_type_graph_lookup_symbol(graph, environment.module_identity, owner) ?? return unhandled
        if sema_resolved_kind(graph, found) != SymbolKind.Type -> return unhandled
        row: sema_type_graph_resolved_nominal_row(graph, found) ?? return unhandled
        nominal: graph.modules[row.module_index].nominals[row.row]
        if sema_call_registered_method_names(graph, nominal, false, environment, program).contains(method) {
            diagnostics.push(sema_error("E0311", method_span, "`{method}` is an instance method on `{owner}`", "instance methods need a value before the dot", "call it on a `{owner}` value: `x.{method}(...)`"))
        } else {
            statics := [String]{}
            loop name in sema_call_registered_method_names(graph, nominal, true, environment, program) {
                if !sema_call_method_is_generated(graph, nominal, name) -> statics.push(name)
            }
            shown: loop name in statics -> "`{name}`"
            fix: if sema_suggest_field(method, statics) == .Val(near) -> "did you mean `{owner}.{near}`?" else if statics.len() > 0 -> "call a static method `{owner}` declares: {shown.join(", ")}" else -> "call `{method}` on a `{owner}` value, or declare a static `{method}` for `{owner}`"
            diagnostics.push(sema_error("E0311", method_span, "`{owner}` has no static method `{method}`", "static lookup finds an associated method of `{owner}` with no `self` receiver, and `{owner}` declares none named `{method}`", fix))
        }
        sema_call_builtin_static_discard(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    unhandled
}

sema_call_static_local_generic_method_exists: fn(symbol: Symbol, method: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    loop declaration_index in 0..<environment.declarations.len() {
        if environment.declarations[declaration_index].item == {
            .Struct(value) -> {
                if value.name == symbol.name && value.type_params.len() > 0 {
                    loop function in value.methods {
                        if function.name == method && (function.params.len() == 0 || function.params[0].name != "self") {
                            return true
                        }
                    }
                }
            }
            .Enum(value) -> {
                if value.name == symbol.name && value.type_params.len() > 0 {
                    loop function in value.methods {
                        if function.name == method && (function.params.len() == 0 || function.params[0].name != "self") {
                            return true
                        }
                    }
                }
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    false
}

sema_call_static_has_method: fn(targets: [SemaStaticMethodTarget], symbol: SymbolID) -> Bool Never! {
    loop target in targets {
        if target.method.symbol == symbol -> return true
    }
    false
}

sema_call_static_function_target: fn(symbol: Symbol, signature: Type, generic_params: [SemaInferenceTypeParam], type_args: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables, span: Span, diagnostics: &[Diagnostic]) -> SemaCallDirectTarget? {
    if generic_params.len() == 0 {
        if type_args.len() > 0 {
            diagnostics.push(sema_error("E0119", span, "`{symbol.name}` is not generic", "only a generic static method accepts function-level type arguments", "remove the explicit method type arguments"))
            return None
        }
        return Val(SemaCallDirectTarget{symbol: symbol, signature: signature, type_args: [Type]{}, generic_params: [SemaInferenceTypeParam]{}, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}})
    }
    if type_args.len() == 0 {
        return Val(SemaCallDirectTarget{symbol: symbol, signature: signature, type_args: [Type]{}, generic_params: generic_params, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}})
    }
    context := sema_inference_context(environment.module_identity, environment.package_identity, generic_params, environment.generic_params, None)
    result: sema_infer_validate_explicit(program.registration_graph, context, type_args, span, diagnostics) ?? return None
    specialized: sema_inference_substitute_type_bindings(signature, result.substitutions)
    Val(SemaCallDirectTarget{symbol: symbol, signature: specialized, type_args: result.type_args, generic_params: generic_params, generic_substitutions: result.substitutions, generic_evidence: result.evidence})
}

// The owner type parameters a static call resolves from its signature: with
// no written owner arguments, a method's own same-named parameter shadows the
// owner's.
sema_call_static_unshadowed_params: fn(owner_params: [SemaInferenceTypeParam], method_params: [SemaInferenceTypeParam], owner_type_args: [Type]) -> [SemaInferenceTypeParam] Never! {
    // copy: written owner arguments bind every owner parameter; the caller keeps its list.
    if owner_type_args.len() > 0 -> return owner_params.copy()
    kept := [SemaInferenceTypeParam]{}
    loop param in owner_params {
        shadowed := false
        loop method_param in method_params {
            if method_param.name == param.name -> shadowed = true
        }
        if !shadowed -> kept.push(param.copy())
    }
    kept
}

sema_call_static_owner_resolution: fn(owner_params: [SemaInferenceTypeParam], owner_type_args: [Type], signature: Type, args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> SemaInferenceResult? {
    explicit_args: loop ty in owner_type_args -> sema_call_resolved_type(ty, environment, program)
    if owner_type_args.len() > 0 {
        explicit_context := sema_inference_context(environment.module_identity, environment.package_identity, owner_params, environment.generic_params, expected)
        return sema_infer_validate_explicit(program.registration_graph, explicit_context, explicit_args, span, diagnostics)
    }
    // An owner parameter the method's signature never names (`Box.make<U>`
    // under `Box<T>`) takes no part in the call: nothing can settle it and
    // nothing reads it, so it instantiates at Unit.
    named := [SemaInferenceTypeParam]{}
    unnamed := [SemaInferenceBinding]{}
    loop param in owner_params {
        if sema_inference_type_mentions_param(signature, param.name) -> named.push(param.copy()) else {
            unnamed.push(SemaInferenceBinding{name: param.name, ty: Type.Named{name: "Unit"}, source: "static method owner the signature never names"})
        }
    }
    inference_context := sema_inference_context(environment.module_identity, environment.package_identity, named, environment.generic_params, expected)
    if named.len() == 0 {
        return Val(SemaInferenceResult{substitutions: unnamed, type_args: [Type]{}, parameters: [Type]{}, return_type: None, evidence: [SemaInferenceBoundEvidence]{}, complete: true, compatible: true})
    }

    params: sema_call_params_from_type(signature) ?? return None
    probe_args := args
    probe_diagnostics := [Diagnostic]{}
    binding: sema_call_bind_direct("static method", signature, probe_args, span, probe_diagnostics) ?? return None
    facts: sema_call_collect_inference_facts(params, binding, args, environment, program, scopes, state, tail_store, context)
    return_type: sema_call_signature_return(signature)
    result := sema_infer_callable(program.registration_graph, inference_context, facts.parameter_types, return_type, facts.argument_types, [Type]{}, span, probe_diagnostics) ?? {
        // An argument that settles an owner parameter but misses its bound
        // is that missing implementation, not an uninferrable owner.
        loop diagnostic in probe_diagnostics {
            if diagnostic.code == "E0905" -> diagnostics.push(diagnostic)
        }
        return None
    }
    if !result.complete -> return None
    // Arguments that settle one owner parameter to two types (`Same.new(1,
    // "two")`) leave no single receiver type: that is the uninferable
    // receiver, not a mismatch at the later argument. A mismatch at a
    // parameter that names no owner parameter stays the argument's error.
    if !result.compatible {
        loop index in 0..<facts.parameter_types.len() {
            if index >= facts.argument_types.len() || index >= result.parameters.len() -> break
            owned: loop parameter in owner_params {
                if sema_inference_type_mentions_param(facts.parameter_types[index], parameter.name) {
                    break true
                }
            } ?? false
            if owned && !sema_inference_assignable(program.registration_graph, inference_context, result.parameters[index], facts.argument_types[index]) {
                return None
            }
        }
    }
    loop unnamed_binding in unnamed -> result.substitutions.push(unnamed_binding)
    Val(result)
}

sema_call_static_append_registered: fn(output: &[SemaStaticMethodTarget], graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, function: SemaRegistrationFunction, owner_name: String, owner_module: ModuleID, owner_package: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) Never! {
    if function.symbol.name == "" || sema_call_static_has_method(output, function.symbol.id) {
        return
    }
    if function.parameters.len() > 0 && function.parameters[0].symbol.name == "self" {
        return
    }
    if !sema_registration_visible(function.symbol.visibility, environment.module_identity, environment.package_identity, owner_module, owner_package) {
        return
    }

    // Rust `owner_type_for_reader`, as for an exported function: the method
    // names types as its owning module sees them (`X25519SecretKey` is
    // `core.crypto`'s own), so it resolves there with every type parameter
    // kept, before the caller's type arguments are substituted.
    generics := [TGenericParam]{}
    loop param in nominal.generic_params {
        generics.push(TGenericParam{name: param.name, bounds: [SymbolID]{}})
    }
    loop param in function.generic_params {
        generics.push(TGenericParam{name: param.name, bounds: [SymbolID]{}})
    }
    owner_signature: sema_type_resolve_declared_with_generics(graph, function.signature, owner_module, generics)
    target := sema_call_static_function_target(function.symbol, owner_signature, sema_inference_registration_params(function.generic_params), type_args, environment, program, span, diagnostics) ?? return
    // A method that declares its own type parameter under an owner
    // parameter's name (`impl Box { new: fn<T>(value: T) -> Box<T> }`) shadows
    // it: the signature names only the method's parameter, which the call
    // infers. The shadowed owner parameter takes that binding when the call
    // is rewritten (sema_call_static_rewrite_value).
    owner_params: sema_call_static_unshadowed_params(sema_inference_registration_params(nominal.generic_params), target.generic_params, owner_type_args)
    owner_result: sema_call_static_owner_resolution(owner_params, owner_type_args, target.signature, args, expected, environment, program, scopes, state, tail_store, context, span, diagnostics) ?? return
    if !owner_result.complete {
        return
    }
    owner_type: sema_inference_substitute_type_bindings(nominal.ty, owner_result.substitutions)
    target.signature = sema_inference_substitute_type_bindings(target.signature, owner_result.substitutions)
    reference := TMethodRef{symbol: function.symbol.id, name: function.symbol.name, mangled: true, trait_owner: None, operator_identity: None}
    output.push(SemaStaticMethodTarget{owner_name: owner_name, owner_type: owner_type, method: reference, target: target, function: Val(function.declaration)})
}

sema_call_static_registered_targets: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, method: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> [SemaStaticMethodTarget] Never! {
    targets := [SemaStaticMethodTarget]{}
    owner_name := nominal.symbol.name
    nominal_module: nominal.symbol.module_identity
    owner_module := nominal_module
    owner_package := ""
    if sema_type_graph_nominal_row(graph, nominal.symbol.id) == .Val(owner_row) {
        owner_module = graph.modules[owner_row.module_index].module_identity
        owner_package = graph.modules[owner_row.module_index].package_identity
    }
    loop function in nominal.methods {
        if function.symbol.name == method {
            sema_call_static_append_registered(targets, graph, nominal, function, owner_name, owner_module, owner_package, owner_type_args, type_args, args, expected, environment, program, scopes, state, tail_store, context, span, diagnostics)
        }
    }
    // An inherent impl adds statics, and so does a conversion: each
    // `impl Celsius.From(Float)` declares one `Celsius.from`. One the owner's
    // own module writes is already among `nominal.methods`.
    loop impl_row in sema_registration_impl_rows_named(graph, nominal.symbol.name) {
        implementation: graph.modules[impl_row.module_index].impls[impl_row.row]
        if implementation.trait_name == .Val(trait_name) && !owned_trait_conversion(trait_name) {
            next
        }
        if implementation.target_identity_key != nominal.identity_key && (module_is_none(implementation.target_module_identity) || implementation.target_module_identity != nominal_module || implementation.target_type_name != nominal.symbol.name) {
            next
        }
        loop function in implementation.methods {
            if function.symbol.name != method -> next
            if implementation.trait_name != None && sema_call_static_nominal_declares(nominal, function.symbol.id) {
                next
            }
            sema_call_static_append_registered(targets, graph, nominal, function, owner_name, graph.modules[impl_row.module_index].module_identity, graph.modules[impl_row.module_index].package_identity, owner_type_args, type_args, args, expected, environment, program, scopes, state, tail_store, context, span, diagnostics)
        }
    }
    targets
}

sema_call_static_nominal_declares: fn(nominal: SemaRegistrationNominal, symbol: SymbolID) -> Bool Never! {
    loop function in nominal.methods {
        if function.symbol.id == symbol -> return true
    }
    false
}

// A built-in type's conversions (`impl Float.From(Celsius)`) are its
// `from` statics, one per source: each impl's registered function, which
// names types as its own module sees them.
sema_call_static_builtin_conversion_targets: fn(graph: SemaRegistrationGraph, owner_name: String, method: String, environment: SemaScopeEnvironment, program: SemaProgramTables, span: Span, diagnostics: &[Diagnostic]) -> [SemaStaticMethodTarget] {
    targets := [SemaStaticMethodTarget]{}
    owner_type: sema_registration_builtin_scalar(owner_name) ?? return targets
    loop impl_row in sema_registration_impl_rows_named(graph, owner_name) {
        module_row: graph.modules[impl_row.module_index]
        implementation: module_row.impls[impl_row.row]
        trait_name: implementation.trait_name ?? next
        if !owned_trait_conversion(trait_name) || !module_is_none(implementation.target_module_identity) {
            next
        }
        loop function in implementation.methods {
            if function.symbol.name != method || sema_call_static_has_method(targets, function.symbol.id) {
                next
            }
            if !sema_registration_visible(function.symbol.visibility, environment.module_identity, environment.package_identity, module_row.module_identity, module_row.package_identity) {
                next
            }
            generics: loop param in function.generic_params -> TGenericParam{name: param.name, bounds: [SymbolID]{}}
            signature: sema_type_resolve_declared_with_generics(graph, function.signature, module_row.module_identity, generics)
            target: sema_call_static_function_target(function.symbol, signature, sema_inference_registration_params(function.generic_params), [Type]{}, environment, program, span, diagnostics) ?? next
            reference := TMethodRef{symbol: function.symbol.id, name: function.symbol.name, mangled: true, trait_owner: None, operator_identity: None}
            targets.push(SemaStaticMethodTarget{owner_name: owner_name, owner_type: owner_type, method: reference, target: target, function: Val(function.declaration)})
        }
    }
    targets
}

sema_call_static_local_target: fn(owner_symbol: Symbol, owner_name: String, declared_owner: Type, owner_params: [SemaInferenceTypeParam], owner_type_args: [Type], function: Func, type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> SemaStaticMethodTarget? {
    if function.params.len() > 0 && function.params[0].name == "self" -> return None
    module_name: sema_scope_environment_module_text(environment, program)
    method_key: symbol_key_text(SymbolKind.Function, module_name, owner_name, function.name)
    method_id: sema_symbol_id_of(program, context, method_key)
    signature: sema_function_symbol_type(function, false, method_key, environment.source_file, environment.source_origin, environment.source_segments)
    visibility: if function.is_pub -> 2 else if function.is_package_pub -> 1 else -> 0
    method_symbol := Symbol{id: method_id, kind: SymbolKind.Function, name: function.name, module_identity: environment.module_identity, owner: Val(sema_symbol_key(program, context, owner_symbol.id)), span: function.name_span, ty: Val(signature), visibility: visibility}
    target := sema_call_static_function_target(method_symbol, signature, sema_inference_type_params(function.type_params), type_args, environment, program, span, diagnostics) ?? return None
    owner_result: sema_call_static_owner_resolution(sema_call_static_unshadowed_params(owner_params, target.generic_params, owner_type_args), owner_type_args, target.signature, args, expected, environment, program, scopes, state, tail_store, context, span, diagnostics) ?? return None
    owner_type: sema_inference_substitute_type_bindings(declared_owner, owner_result.substitutions)
    target.signature = sema_inference_substitute_type_bindings(target.signature, owner_result.substitutions)
    reference := TMethodRef{symbol: method_symbol.id, name: function.name, mangled: true, trait_owner: None, operator_identity: None}
    Val(SemaStaticMethodTarget{owner_name: owner_name, owner_type: owner_type, method: reference, target: target, function: Val(function)})
}

sema_call_static_local_targets: fn(symbol: Symbol, method: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> [SemaStaticMethodTarget] Never! {
    targets := [SemaStaticMethodTarget]{}
    loop declaration_index in 0..<environment.declarations.len() {
        if environment.declarations[declaration_index].item == {
            .Struct(value) -> {
                if value.name != symbol.name -> next
                owner_params: sema_inference_type_params(value.type_params)
                declared_owner: if owner_params.len() == 0 -> Type.Named{name: value.name} else -> Type.Apply{name: value.name, args: loop parameter in owner_params -> Type.Named{name: parameter.name}}
                loop function in value.methods {
                    if function.name == method {
                        candidate: sema_call_static_local_target(symbol, value.name, declared_owner, owner_params, owner_type_args, function, type_args, args, expected, environment, program, scopes, state, tail_store, context, span, diagnostics) ?? next
                        targets.push(candidate)
                    }
                }
            }
            .Enum(value) -> {
                if value.name != symbol.name -> next
                owner_params: sema_inference_type_params(value.type_params)
                declared_owner: if owner_params.len() == 0 -> Type.Named{name: value.name} else -> Type.Apply{name: value.name, args: loop parameter in owner_params -> Type.Named{name: parameter.name}}
                loop function in value.methods {
                    if function.name == method {
                        candidate: sema_call_static_local_target(symbol, value.name, declared_owner, owner_params, owner_type_args, function, type_args, args, expected, environment, program, scopes, state, tail_store, context, span, diagnostics) ?? next
                        targets.push(candidate)
                    }
                }
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    targets
}

sema_call_static_local_defaults: fn(target: SemaStaticMethodTarget, binding: SemaCallBinding, environment: SemaScopeEnvironment, program: SemaProgramTables) -> [SemaCallDefaultValue]? {
    if binding.default_refs.len() == 0 -> return Val([SemaCallDefaultValue]{})
    function: target.function ?? return None
    defaults := [SemaCallDefaultValue]{}
    // A body's own id is no registered owner a default names.
    owner_key: if symbol_is_local(target.method.symbol) -> "" else -> sema_program_symbol_key(program, target.method.symbol)
    loop reference in binding.default_refs {
        if reference.owner_key != owner_key -> return None
        parameter_index: reference.parameter_index
        if parameter_index < 0 || parameter_index >= function.params.len() -> return None
        expression: function.params[parameter_index].default ?? return None
        expression_span: expr_span(expression)
        if expression_span.start != reference.span.start || expression_span.end != reference.span.end {
            return None
        }
        source_file: sema_source_file_at(environment.source_segments, reference.source_file, environment.source_origin, expression_span)
        if source_file != reference.source_file -> return None
        defaults.push(SemaCallDefaultValue{reference: reference, expression: expression})
    }
    Val(defaults)
}

sema_call_static_rewrite_value: fn(value: &TExpr, target: SemaStaticMethodTarget, method_id: DeclID) -> Bool Never! {
    if value.kind == {
        .Call(symbol, type_args, args) -> {
            if symbol.row.index() != method_id.row.index() -> return false
            // The method's inferred type arguments bind any owner parameter
            // its own same-named parameter shadows.
            owner_type := target.owner_type
            if type_args.len() > 0 && type_args.len() == target.target.generic_params.len() {
                bindings: loop index in 0..<type_args.len() -> SemaInferenceBinding{name: target.target.generic_params[index].name, ty: type_args[index], source: "static method"}
                owner_type = sema_inference_substitute_type_bindings(owner_type, bindings)
            }
            value.kind = TExprKind.StaticCall{owner: TStaticOwner.User{name: target.owner_name}, owner_type: Val(owner_type), method: target.method, type_args: type_args, args: args}
            return true
        }
        .TraitBox(inner, target_type) -> {
            updated_inner := inner
            if !sema_call_static_rewrite_value(updated_inner, target, method_id) -> return false
            value.kind = TExprKind.TraitBox{value: updated_inner, target: target_type}
            return true
        }
        .InlineBlock(statements) -> {
            if statements.len() == 0 -> return false
            last: statements.len() - 1
            if statements[last] == {
                .ExprStmt(call, statement_span) -> {
                    updated_call := call
                    if !sema_call_static_rewrite_value(updated_call, target, method_id) {
                        return false
                    }
                    updated_statements := statements.copy()
                    updated_statements[last] = TStmt.ExprStmt{value: updated_call, span: statement_span}
                    value.kind = TExprKind.InlineBlock{body: updated_statements}
                    return true
                }
                .Contract(_) | .ContractScope(_, _, _, _, _) | .Let(_, _, _, _, _, _) | .RefutableBind(_, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .ForRange(_, _, _, _, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .Return(_, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .If(_, _, _, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .Match(_, _, _, _) | .EnumMatch(_, _, _, _, _) | .RangeSwitch(_, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _, _) | .Inline(_, _) | .DebugOnly(_, _) | .DeepCheck(_, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .UnsafeBlock(_, _, _) | .SentryPolicy(_, _, _) | .Impure(_, _) | .Reactive(_, _) | .Region(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .Shield(_, _) | .Defer(_, _) | .ScopeMember(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> return false
            }
        }
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .CtLit(_) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> return false
    }
    false
}

sema_call_static_call_value: fn(value: TExpr, method_id: DeclID) -> TExpr? {
    if value.kind == {
        .Call(callee, _, _) -> {
            if callee.row.index() == method_id.row.index() -> return Val(value) else -> return None
        }
        .TraitBox(inner, _) -> return sema_call_static_call_value(inner, method_id)
        .InlineBlock(statements) -> {
            if statements.len() == 0 -> return None
            last: statements.len() - 1
            if statements[last] == {
                .ExprStmt(call, _) -> return sema_call_static_call_value(call, method_id)
                .Contract(_) | .ContractScope(_, _, _, _, _) | .Let(_, _, _, _, _, _) | .RefutableBind(_, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .ForRange(_, _, _, _, _, _, _, _, _) | .Range(_, _, _, _, _, _, _, _, _, _) | .Return(_, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .If(_, _, _, _, _) | .Loop(_, _, _) | .While(_, _, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .Match(_, _, _, _) | .EnumMatch(_, _, _, _, _) | .RangeSwitch(_, _, _, _) | .ForIn(_, _, _, _, _, _, _, _, _, _, _, _) | .Inline(_, _) | .DebugOnly(_, _) | .DeepCheck(_, _) | .MixedSwitch(_, _, _, _, _) | .Unsafe(_, _) | .UnsafeBlock(_, _, _) | .SentryPolicy(_, _, _) | .Impure(_, _) | .Reactive(_, _) | .Region(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .Shield(_, _) | .Defer(_, _) | .ScopeMember(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> return None
            }
        }
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .CtLit(_) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> return None
    }
}

// Built-in owners (`Int.parse`, `F32.from_float`, `Atomic<Int>.new`,
// `crypto.Hasher.new`) have no declaration to resolve. Their checked contract
// is the Foundation BuiltinStaticRow table: this layer admits the row for how
// the owner was named, binds its type parameters, checks arity and argument
// types, and builds the row's checked-tree node.
sema_call_builtin_static_admitted: fn(row: BuiltinStaticRow, module_name: String) -> Bool Never! {
    if row.module_name == module_name -> return true
    row.module_name == "" && (module_name == "" || core_module_has_type(module_name, row.owner))
}

sema_call_builtin_static_row: fn(owner: String, method: String, module_name: String) -> BuiltinStaticRow? {
    loop row in builtin_static_rows(owner, method) {
        if sema_call_builtin_static_admitted(row, module_name) -> return Val(row)
    }
    None
}

sema_call_builtin_static_bound: fn(bindings: [SemaInferenceBinding], name: String) -> Bool Never! {
    loop binding in bindings {
        if binding.name == name -> return true
    }
    false
}

// A row parameter is open while the declared row type names it and no
// evidence has bound it. A bound value is the caller's type, read once as
// written (Rust single-pass `substitute_type`): inside `f: fn<T>`,
// `Shared{T?{…}}` binds the row's `T` to the caller's `T?`, whose `T` is not
// the row parameter again.
sema_call_builtin_static_open: fn(ty: Type, row: BuiltinStaticRow, bindings: [SemaInferenceBinding]) -> Bool Never! {
    loop name in row.type_params {
        if !sema_call_builtin_static_bound(bindings, name) && sema_inference_type_mentions_param(ty, name) {
            return true
        }
    }
    false
}

sema_call_builtin_static_closed: fn(ty: Type, row: BuiltinStaticRow, bindings: [SemaInferenceBinding]) -> Type Never! {
    complete := bindings
    loop name in row.type_params {
        if !sema_call_builtin_static_bound(bindings, name) {
            complete.push(SemaInferenceBinding{name: name, ty: Type.Int, source: "builtin static default"})
        }
    }
    sema_inference_substitute_type_bindings(ty, complete)
}

// Bind unbound row type parameters structurally; an already bound parameter
// keeps its first evidence and later mismatches surface as type errors.
sema_call_builtin_static_bind: fn(pattern: Type, actual: Type, row: BuiltinStaticRow, bindings: &[SemaInferenceBinding]) -> Bool Never! {
    if pattern == .Named(name) {
        if builtin_static_is_type_param(row, name) && !sema_call_builtin_static_bound(bindings, name) {
            bindings.push(SemaInferenceBinding{name: name, ty: actual, source: "builtin static"})
        }
        return true
    }
    if actual == .Tagged(_, inner) {
        return sema_call_builtin_static_bind(pattern, inner, row, bindings)
    }
    if pattern == {
        .List(element) -> if actual == {
            .List(offered) | .FixedList(offered, _) -> sema_call_builtin_static_bind(element, offered, row, bindings)
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Option(inner) -> if actual == {
            .Option(offered) -> sema_call_builtin_static_bind(inner, offered, row, bindings)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Shared(inner) -> if actual == {
            .Shared(offered) -> sema_call_builtin_static_bind(inner, offered, row, bindings)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Result(ok, err) -> if actual == {
            .Result(offered_ok, offered_err) -> sema_call_builtin_static_bind(ok, offered_ok, row, bindings) && sema_call_builtin_static_bind(err, offered_err, row, bindings)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Map(key, _, value) -> if actual == {
            .Map(offered_key, _, offered_value) -> sema_call_builtin_static_bind(key, offered_key, row, bindings) && sema_call_builtin_static_bind(value, offered_value, row, bindings)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Apply(name, pattern_args) -> if actual == {
            .Apply(offered_name, offered_args) -> {
                if offered_name != name || offered_args.len() != pattern_args.len() -> return false
                loop index in 0..<pattern_args.len() {
                    if !sema_call_builtin_static_bind(pattern_args[index], offered_args[index], row, bindings) {
                        return false
                    }
                }
                true
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Fn(params, ret, _, _, _, _) -> if actual == {
            .Fn(offered_params, offered_ret, _, _, _, _) -> {
                if offered_params.len() != params.len() -> return false
                loop index in 0..<params.len() {
                    if !sema_call_builtin_static_bind(params[index], offered_params[index], row, bindings) {
                        return false
                    }
                }
                if ret == .Val(returned) {
                    if offered_ret == .Val(offered) {
                        return sema_call_builtin_static_bind(returned, offered, row, bindings)
                    }
                }
                true
            }
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .Int | .Float | .Bool | .String | .Char | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> true
    }
}

// Internal tags (crypto nominals, clock kinds) do not change which built-in
// argument a value satisfies.
sema_call_builtin_static_untagged: fn(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(marker, inner) -> if marker == {
            .Internal(_) -> sema_call_builtin_static_untagged(inner)
            .User(_) -> ty
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ty
    }
}

sema_call_builtin_static_accepts: fn(required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if type_identity_equal(required, offered) -> return true
    if sema_call_type_assignable(required, offered, environment, program) == (.Val(true)) {
        return true
    }
    sema_call_type_assignable(sema_call_builtin_static_untagged(required), sema_call_builtin_static_untagged(offered), environment, program) == (.Val(true))
}

// A Union parameter (`Duration.seconds(Int | Float)`) accepts any member
// exactly; a single parameter also admits a checked numeric widening.
sema_call_builtin_static_coerce: fn(value: TExpr, required: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    if required == .Union(members) {
        loop member in members {
            if sema_call_builtin_static_accepts(member, value.ty, environment, program) {
                return Val(value)
            }
        }
        diagnostics.push(sema_type_mismatch(required, value.ty, span))
        return None
    }
    if sema_call_builtin_static_accepts(required, value.ty, environment, program) {
        return Val(value)
    }
    if sema_expr_numeric_value_widening(value, required) == (.Val(true)) {
        line: sema_source_line_at(environment.source_segments, value.span) ?? 0
        return sema_expr_numeric_literal_conversion(value, required, value.span, line, diagnostics)
    }
    diagnostics.push(sema_type_mismatch(required, value.ty, span))
    None
}

sema_call_builtin_static_argument: fn(argument: CallArg, declared: Type, row: BuiltinStaticRow, bindings: &[SemaInferenceBinding], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    // A function parameter (a key function) binds the row's open types from a
    // probe of the argument, so the real check below carries the closed
    // function type and its effect bound.
    if declared == .Fn(params, _, _, _, _, _) {
        if sema_call_builtin_static_open(declared, row, bindings) {
            // The parameters hint an unannotated lambda once they are known.
            closed := true
            hinted := [Type]{}
            loop param in params {
                if sema_call_builtin_static_open(param, row, bindings) -> closed = false
                hinted.push(sema_inference_substitute_type_bindings(param, bindings))
            }
            probe_hint := Type?{None}
            if closed {
                probe_hint = Val(Type.Fn{params: hinted, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None})
            }
            probe_diagnostics := [Diagnostic]{}
            probed := sema_probe_expression(argument.expr, probe_hint, environment, program, scopes, state, tail_store, context, probe_diagnostics)
            if probed == .Val(value) {
                _ := sema_call_builtin_static_bind(declared, value.ty, row, bindings)
            }
        }
    }
    if !sema_call_builtin_static_open(declared, row, bindings) {
        required := sema_call_resolved_type(sema_inference_substitute_type_bindings(declared, bindings), environment, program)
        // A Union slot hints only a decimal literal, which takes its machine
        // float member instead of exact Decimal.
        hint := if required == {
            .Union(_) | .Case(_, _) -> None
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Quantity(_, _) | .Measure(_) -> Val(required)
        }
        // copy: `required` stays the coercion target below
        if required == .Union(_) && sema_expr_decimal_literal_operand(argument.expr, false) {
            hint = Val(required.copy())
        }
        checked: sema_check_expression(argument.expr, hint, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        return sema_call_builtin_static_coerce(checked, required, argument.span, environment, program, diagnostics)
    }
    checked: sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    _ := sema_call_builtin_static_bind(declared, checked.ty, row, bindings)
    if sema_call_builtin_static_open(declared, row, bindings) {
        diagnostics.push(sema_type_mismatch(sema_call_builtin_static_closed(declared, row, bindings), checked.ty, argument.span))
        return None
    }
    required := sema_call_resolved_type(sema_inference_substitute_type_bindings(declared, bindings), environment, program)
    sema_call_builtin_static_coerce(checked, required, argument.span, environment, program, diagnostics)
}

sema_call_builtin_static_discard: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    loop argument in args {
        _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
    }
}

sema_call_builtin_static_shape: fn(row: BuiltinStaticRow, callee: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if type_args.len() > 0 {
        diagnostics.push(sema_call_generic_count_diagnostic(callee, 0, type_args.len(), span))
        return false
    }
    if owner_type_args.len() > 0 && owner_type_args.len() != row.owner_type_params {
        diagnostics.push(sema_call_generic_count_diagnostic(callee, row.owner_type_params, owner_type_args.len(), span))
        return false
    }
    if row.owner_rule == BuiltinStaticOwnerRule.AtomicScalar && owner_type_args.len() == 0 {
        diagnostics.push(sema_error("E0904", span, "cannot infer the owner type arguments for `{callee}`", "`Atomic<T>` construction names its scalar type on the owner", "write `Atomic<Int>.{row.method}(value)`"))
        return false
    }
    count := row.parameters.len()
    if args.len() != count {
        diagnostics.push(sema_error(row.arity_code, span, "`{callee}` expects {count} argument{if count == 1 -> "" else -> "s"}, got {args.len()}", "a built-in static method has a fixed argument shape", "pass exactly {count} argument{if count == 1 -> "" else -> "s"}"))
        return false
    }
    loop argument in args {
        if argument.label != None {
            diagnostics.push(sema_error("E0104", argument.span, "`{callee}` takes positional arguments", "built-in static methods have no argument labels", "remove the argument label"))
            return false
        }
    }
    true
}

sema_call_builtin_static_carrier: fn(result: Type) -> TFailureCarrier Never! {
    if result == {
        // copy: `ok` and `err` are payloads of read parameter `result`, which keeps the originals; the new TFailureCarrier.Result's fields own `ok` and `err`
        .Result(ok, err) -> TFailureCarrier.Result{success: ok.copy(), error: err.copy()}
        // copy: `inner` is a payload of read parameter `result`, which keeps the original; field `value` of the new TFailureCarrier.Optional owns this one
        .Option(inner) -> TFailureCarrier.Optional{value: inner.copy()}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> TFailureCarrier.Infallible
    }
}

sema_call_builtin_static_call_arg: fn(value: TExpr, argument: CallArg) -> TCallArg Never! {
    TCallArg{
        value: value,
        template_items: [SymbolID]{},
        borrow: argument.convention == AccessConvention.Read && !sema_call_is_scalar(value.ty),
        mut_borrow: argument.convention == AccessConvention.Write,
        fn_coerce: None,
        widen_to_vec: false,
        widen_to_union: None,
        box_as_trait: None,
        label: None,
        spread: false,
    }
}

// CoreCall rows lower through the registered Core route in the caller.
// `line` is the call's source line, which a checked crossing stops at.
sema_call_builtin_static_lowered: fn(row: BuiltinStaticRow, values: [TExpr], args: [CallArg], bindings: [SemaInferenceBinding], span: Span, line: Int, program: SemaProgramTables, context: &SemaCheckContext) -> TExprKind? {
    rest := [TExpr]{}
    loop index in 0..<values.len() {
        if index > 0 -> rest.push(values[index])
    }
    if row.lowering == {
        // copy: `operation` is a payload of read parameter `row`, which keeps the original; field `operation` of the new TExprKind.BuiltinMethod owns this one
        .ArgumentBuiltin(operation) -> Val(TExprKind.BuiltinMethod{receiver: values[0], operation: operation.copy(), args: rest})
        .IntFromRadix -> Val(TExprKind.BuiltinMethod{receiver: values[0], operation: TBuiltinOp.IntFromRadix, args: rest})
        // copy: `operation` is a payload of read parameter `row`, which keeps the original; field `operation` of the new TExprKind.BuiltinMethod owns this one
        .UnitBuiltin(operation) -> Val(TExprKind.BuiltinMethod{receiver: sema_node(context, Type.Named{name: "Unit"}, NodeKind.Unit, span), operation: operation.copy(), args: values})
        .PreludeStatic(rooted, path, generics) -> {
            owner_args: loop generic in generics -> if generic == {
                .Jet(ty) -> TPreludeArg.Jet{ty: sema_inference_substitute_type_bindings(ty, bindings)}
                .HostUsize -> TPreludeArg.HostUsize
            }
            call_args := [TCallArg]{}
            loop index in 0..<values.len() {
                call_args.push(sema_call_builtin_static_call_arg(values[index], args[index]))
            }
            reference := TMethodRef{symbol: sema_symbol_id(program, context, SymbolKind.Function, row.module_name, path, row.method), name: row.method, mangled: false, trait_owner: None, operator_identity: None}
            Val(TExprKind.StaticCall{owner: TStaticOwner.Prelude{rooted: rooted, path: path, generics: owner_args}, owner_type: None, method: reference, type_args: [Type]{}, args: call_args})
        }
        .DurationNew(unit_name) -> Val(TExprKind.HandleMethod{receiver: values[0], operation: THandleOp.DurationNew{unit: unit_name, float: values[0].ty == Type.Float || values[0].ty == Type.Float32}, args: [TExpr]{}})
        .EmptyMap -> Val(TExprKind.MapLit{entries: [TMapEntry]{}})
        .Numeric(operation) -> Val(TExprKind.NumericMethod{receiver: values[0], operation: sema_call_numeric_at_line(operation, line)})
        .Precise(precise_type, function) -> Val(TExprKind.PreciseBuiltin{type_name: precise_type, function: function, args: values})
        .CoreCall(_, _) -> None
    }
}

sema_call_try_builtin_static: fn(owner: String, module_name: String, method: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    row: sema_call_builtin_static_row(owner, method, module_name) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    callee := "{owner}.{method}"
    if !sema_call_builtin_static_shape(row, callee, owner_type_args, type_args, args, span, diagnostics) {
        sema_call_builtin_static_discard(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    bindings := [SemaInferenceBinding]{}
    loop index in 0..<owner_type_args.len() {
        bindings.push(SemaInferenceBinding{name: row.type_params[index], ty: sema_call_resolved_type(owner_type_args[index], environment, program), source: "builtin static owner"})
    }
    // With no owner type arguments written, an expected result
    // (`line_starts: Cell.new(None)` for a `Cell<[Int]?>` field) names them,
    // so an argument that needs its type (`None`) checks against it.
    if owner_type_args.len() == 0 && expected == .Val(wanted) {
        seeded := [SemaInferenceBinding]{}
        if sema_call_builtin_static_bind(row.return_type, sema_call_resolved_type(wanted, environment, program), row, seeded) {
            bindings = seeded
        }
    }
    if row.owner_rule == BuiltinStaticOwnerRule.AtomicScalar && !jet_target_layout_atomic_scalar_type(bindings[0].ty) {
        diagnostics.push(sema_error("E0311", span, "`Atomic<{type_name(bindings[0].ty)}>` has no static method `{method}`", "`Atomic<T>` holds one lock-free scalar: Bool, Int, or a 32- or 64-bit integer", "use a supported scalar, or `Shared<T>` for other values"))
        sema_call_builtin_static_discard(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }

    values := [TExpr]{}
    explicit_moves := [Bool]{}
    loop index in 0..<args.len() {
        value: sema_call_builtin_static_argument(args[index], row.parameters[index], row, bindings, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        // A written `name.move()` is a checked move, as for any consuming argument
        // (Calls/Checking.jet): never a silent copy, E0201 on a read
        // parameter. The operand of `Shared{name}` carries no written `.move()`.
        explicit: args[index].convention == AccessConvention.Move && !args[index].flags.shared_operand && args[index].expr == .Ident(_, _, _) && !sema_ownership_type_is_copy(value.ty)
        if explicit && sema_ownership_reject_read_param_move(state, args[index].expr, scopes, diagnostics) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        explicit_moves.push(explicit)
        values.push(sema_call_marked_move_value(state, explicit, args[index].expr, value, scopes, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None})
    }
    // `Shared.new` (and `Shared{x}`): a Cell or one of its guards owns
    // one-thread borrow state that the lock does not synchronize.
    if owner == "Shared" && method == "new" && values.len() == 1 {
        problem: sema_ownership_crossing_problem(values[0].ty, SemaSendCrossing.SharedStorage, true, environment, program, scopes, context)
        if problem == .Val(found) && found.kind == .ThreadConfined(_) {
            diagnostics.push(sema_error("E1102", expr_span(args[0].expr), "{sema_type_show(values[0].ty)} cannot be stored in `Shared<T>`", "a Cell and its guards own one-thread borrow state; wrapping that state does not make it synchronized", "store the value itself in `Shared<T>`, then read and write its fields directly"))
        }
    }
    // Rust `finish_builtin_method` (and the `Shared.new` arm of `Shared{x}`)
    // declares no parameter conventions for a builtin static: a written `.move()`
    // is the consuming argument's exact move. The bare name in `Shared{x}` moves
    // here like an unmarked owning position: a borrowed parameter keeps its
    // value, and a later use turns the move into a share.
    params := [SemaCallParam]{}
    ownership_args := args
    named_moves := [Int]{}
    loop index in 0..<values.len() {
        convention := row.parameter_convention
        if args[index].convention == AccessConvention.Move {
            if args[index].expr == {
                .Ident(_, _, _) -> {
                    if explicit_moves[index] -> convention = AccessConvention.Move else {
                        convention = AccessConvention.Read
                        ownership_args[index].convention = AccessConvention.Read
                        named_moves.push(index)
                    }
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
                    convention = AccessConvention.Move
                }
            }
        }
        params.push(SemaCallParam{label: "arg{index}", name: "arg{index}", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: convention, ty: Val(values[index].ty), variadic: false})
    }
    ownership := sema_ownership_check_call_arguments(state, callee, params, ownership_args, scopes, diagnostics)
    if !ownership.accepted || !ownership.complete {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    loop index in named_moves {
        if !sema_ownership_mark_unmarked_move(state, args[index].expr, scopes, "`{callee}`", diagnostics) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }

    if expected == .Val(expected_type) {
        hint: sema_call_resolved_type(expected_type, environment, program)
        pattern := row.return_type
        if pattern == .Result(success, _) {
            if hint == {
                .Result(_, _) -> {}
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
                    pattern = success
                }
            }
        }
        _ := sema_call_builtin_static_bind(pattern, hint, row, bindings)
    }
    loop name in row.type_params {
        if !sema_call_builtin_static_bound(bindings, name) {
            bindings.push(SemaInferenceBinding{name: name, ty: Type.Int, source: "builtin static default"})
        }
    }
    result := sema_inference_substitute_type_bindings(row.return_type, bindings)
    // E0506: `Set.new()` / `Set.from(list)` / `Tally.new()` need a hashable element.
    if (row.owner == "Set" || row.owner == "Tally") && result == .Apply(_, result_args) && result_args.len() == 1 && !sema_type_hashable(environment, program, result_args[0]) {
        element_name: type_name(result_args[0])
        if sema_comparability_written_order_of(environment, program, result_args[0]) == .Val(written) {
            diagnostics.push(sema_key_by_migrated(sema_error("E0506", span, "`{row.owner}<{element_name}>` is not valid — `{element_name}` is not hashable", "`{element_name}` writes its own `{written.trait_name}`, so values its `==` calls the same could still be separate elements", "implement `KeyBy` with the value `{element_name}` compares, and remove the written `{written.trait_name}`"), program, written))
        } else {
            diagnostics.push(sema_error("E0506", span, "`{row.owner}<{element_name}>` is not valid — `{element_name}` is not hashable", "{row.owner} elements must implement Hash and Eq; use Int, Bool, String, Char, or a named type", "change the element type to a hashable type, or use a `[{element_name}]` list instead"))
        }
    }
    // `Set<E>.from_bits(n)` builds a Set stored as bits (E1132, E1133).
    if row.owner == "Set" && row.method == "from_bits" && result == .Option(set_type) {
        if set_type == .Apply(_, set_args) && set_args.len() == 1 {
            if !sema_call_set_bits_ready(set_args[0], "Set.from_bits", span, environment, program, diagnostics) {
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
        }
    }

    if row.lowering == .CoreCall(core_module, member) {
        record: core_call(core_module, member) ?? {
            diagnostics.push(sema_error("E0906", span, "the canonical `{core_module}.{member}` route for `{callee}` is unavailable", "compiler-owned static constructors lower through the registered CoreCall row", "restore the registered `{core_module}.{member}` route"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        fallibility := sema_call_failure_carrier(Val(result))
        if !sema_call_core_record_effects(record, span, [Type]{}, result, fallibility, [FunctionDefaultRef]{}, scopes, context, environment, program, diagnostics) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        widen_to_vec: loop _ in values -> false
        return SemaMethodSpecialCheck{handled: true, value: sema_call_core_tree(record, values, span, [Type]{}, widen_to_vec, result, fallibility, expected, environment, program, diagnostics)}
    }

    if row.lowering == .Numeric(operation) && operation == .CheckedIntToFloat(_, _, _) && values.len() == 1 {
        if !sema_expr_float_literal_fits(values[0], result, values[0].span, diagnostics) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    kind: sema_call_builtin_static_lowered(row, values, ownership_args, bindings, span, sema_source_line_at(environment.source_segments, span) ?? 0, program, context) ?? {
        diagnostics.push(sema_error("E0104", span, "static method call `{callee}` could not be lowered", "the built-in static row has no checked-tree construction", "use a registered built-in static method"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    facts := SemaCallFacts{return_type: result, failure_carrier: sema_call_builtin_static_carrier(result), effect_bound: Val([EffectRowEntry]{}), type_args: [Type]{}, default_refs: [FunctionDefaultRef]{}}
    if !sema_effect_record_intrinsic_fact(environment, program, scopes, context, callee, span, facts, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    // A fallible builtin static in a plain slot propagates its failure as a
    // call does (`return F32.from_float(x)` under `-> F32 Err!`).
    SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(sema_tree_node(result, kind.move(), span), expected, environment, program, context, diagnostics)}
}

// `alias.Owner.method(...)`: a Core module alias names the owner's module.
sema_call_try_builtin_static_field: fn(base: Expr, owner: String, method: String, owner_type_args: [Type], type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    alias: if base == {
        .Ident(name, _, _) -> name
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
            return SemaMethodSpecialCheck{handled: false, value: None}
        }
    }
    if !sema_expr_core_module_alias_visible(alias, scopes) {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    module_name: sema_call_core_import_module(environment, program, alias) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    builtin := sema_call_try_builtin_static(owner, module_name, method, owner_type_args, type_args, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if builtin.handled -> return builtin
    // A capitalized `alias.Owner` that no route resolved names no static the
    // Core module provides: report it rather than leaving the call unchecked.
    if !sema_checked_module_uppercase(owner) -> return builtin
    if core_module_has_type(module_name, owner) || core_module_has_member(module_name, owner) {
        diagnostics.push(sema_error("E0311", span, "`{owner}` has no matching static method `{method}`", "static lookup requires a visible associated method with no `self` receiver and a valid owner type", "call a static method `{owner}` declares, or call `{method}` on a `{owner}` value"))
    } else { diagnostics.push(sema_call_core_unknown_item(module_name, owner, span)) }
    sema_call_builtin_static_discard(args, environment, program, scopes, state, tail_store, context, diagnostics)
    SemaMethodSpecialCheck{handled: true, value: None}
}

// The ambient Perf type is an alternate spelling of the checked core.perf
// export, not a second native dispatch surface.
sema_call_perf_static: fn(method: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    if program.registration_graph == .Val(graph) {
        identity: sema_call_core_module_identity(environment, program, "core.perf") ?? return failed
        target: sema_call_core_source_target(environment, program, identity, method, type_args, span, false, diagnostics) ?? return failed
        probe_args := args
        binding: sema_call_bind_direct("Perf.{method}", target.signature, probe_args, span, diagnostics) ?? return failed
        defaults: sema_call_registration_defaults(graph, binding) ?? return failed
        call: Call{name: "Perf.{method}", name_span: span, type_args: type_args, args: args}
        checked: sema_call_check_direct_target_owned(state, target, call, defaults, expected, environment, program, scopes, tail_store, context, diagnostics) ?? return failed
        if !sema_expr_record_call_fact(environment, program, scopes, context, span, checked, diagnostics) {
            return failed
        }
        return SemaMethodSpecialCheck{handled: true, value: Val(checked.value)}
    } else { return failed }
}

// The owner whose statics a static call runs, after aliases, with the type
// arguments it receives.
SemaStaticOwner: struct {
    symbol: Symbol
    owner_type_args: [Type]
}

// Resolve associated methods through the declaration graph before trying an
// intrinsic row. Core source carriers use the same SymbolId as imported user
// carriers; a qualified owner is not a runtime field access.
sema_call_static_source_owner: fn(receiver: Expr, method: String, owner_type_args: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> SemaStaticOwner? Never! {
    owner_name: if receiver == {
        .Ident(name, _, _) -> {
            if sema_scope_resolve_index(scopes, name) == .Val(index) {
                symbol: sema_scope_binding_symbol(environment, scopes, index)
                // An imported alias (`use core.encoding.hex.[HexError]`) is a
                // module-scope binding of the alias symbol; its statics are the
                // target's, as for the qualified spelling below.
                if symbol.kind == SymbolKind.Type && program.registration_graph == .Val(graph) {
                    if sema_type_graph_nominal_row(graph, symbol.id) == .Val(row) {
                        if sema_call_static_alias_target(graph, row, owner_type_args) == .Val(target) {
                            return Val(SemaStaticOwner{symbol: sema_resolved_symbol(graph, target.symbol), owner_type_args: target.owner_type_args})
                        }
                    }
                }
                return Val(SemaStaticOwner{symbol: symbol, owner_type_args: owner_type_args})
            }
            name
        }
        .Field(base, leaf, _, _) -> {
            alias: if base == {
                .Ident(name, _, _) -> name
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
                    return None
                }
            }
            // `core_alias.Type`, or a type declared under a qualified name
            // (a protocol's `Payment.Client`) that no local binding shadows.
            if !sema_expr_core_module_alias_visible(alias, scopes) && sema_scope_resolve_index(scopes, alias) != None {
                return None
            }
            "{alias}.{leaf}"
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
            return None
        }
    }
    if program.registration_graph == .Val(graph) {
        found: sema_type_graph_lookup_symbol(graph, environment.module_identity, owner_name) ?? return None
        if sema_resolved_kind(graph, found) != SymbolKind.Type -> return None
        resolved := found
        args := owner_type_args
        row := sema_type_graph_resolved_nominal_row(graph, found) ?? return None
        if sema_call_static_alias_target(graph, row, owner_type_args) == .Val(target) {
            row = sema_type_graph_resolved_nominal_row(graph, target.symbol) ?? return None
            resolved = target.symbol
            args = target.owner_type_args
        }
        nominal: graph.modules[row.module_index].nominals[row.row]
        // A user distinct type's base conversion (`pkg.ID.from_int(n)`) is no
        // registered method; sema_call_try_distinct_conversion builds it. A
        // Core owner keeps its built-in rows (sema_call_try_builtin_static_field).
        user_distinct: nominal.kind == SemaRegistrationNominalKind.Distinct && !module_is_core(nominal.symbol.module_identity)
        if !user_distinct && !sema_call_static_registered_method_exists(graph, nominal, method, environment, program) {
            return None
        }
        return Val(SemaStaticOwner{symbol: sema_resolved_symbol(graph, resolved), owner_type_args: args})
    } else { return None }
}

SemaStaticAliasTarget: struct {
    symbol: SemaRegistrationResolvedSymbol
    owner_type_args: [Type]
}

// An alias names its target's statics: the target type of the nominal at
// `row` when that nominal is an alias of a named or applied type, with the
// target's owner type arguments. A plain alias (`Spot: Point`) passes the
// call's owner arguments on. A generic alias (`Pair<A, B>: Pair2<Float, A,
// B>`) substitutes them into its target's arguments; without them the
// target's arguments are left to inference. A computed alias names the
// statics of the type it chooses for the call's owner arguments.
sema_call_static_alias_target: fn(graph: SemaRegistrationGraph, row: SemaRegistrationRowRef, owner_type_args: [Type]) -> SemaStaticAliasTarget? {
    alias_row: graph.modules[row.module_index].nominals[row.row]
    if alias_row.kind != SemaRegistrationNominalKind.TypeAlias -> return None
    definition: if alias_row.source == .SourceAST(item) && item == .TypeAlias(found) -> found else -> {
        return None
    }
    written: sema_type_alias_expanded(graph, row.module_index, definition, owner_type_args, [String]{}) ?? return None
    target_name := ""
    target_args := [Type]{}
    if written == {
        .Named(name) -> target_name = name
        .Apply(name, args) -> {
            target_name = name
            target_args = args
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
    target: sema_type_graph_lookup_symbol(graph, graph.modules[row.module_index].module_identity, target_name) ?? return None
    if sema_resolved_kind(graph, target) != SymbolKind.Type -> return None
    if definition.type_params.len() == 0 {
        if written == .Named(_) {
            return Val(SemaStaticAliasTarget{symbol: target, owner_type_args: owner_type_args})
        }
        if owner_type_args.len() > 0 -> return None
        return Val(SemaStaticAliasTarget{symbol: target, owner_type_args: target_args})
    }
    if owner_type_args.len() == 0 {
        return Val(SemaStaticAliasTarget{symbol: target, owner_type_args: [Type]{}})
    }
    if owner_type_args.len() != definition.type_params.len() -> return None
    names := [String]{}
    loop parameter in definition.type_params -> names.push(parameter.name)
    args := [Type]{}
    loop arg in target_args {
        args.push(sema_inference_substitute_type(arg, names, owner_type_args))
    }
    Val(SemaStaticAliasTarget{symbol: target, owner_type_args: args})
}

// check_option_lift2: `Option.lift2(f, a, b)` is `f(a, b)` when both optionals
// are present and absent otherwise. `a` and `b` are checked first, since `f`'s
// parameter types are their payload types.
sema_call_option_lift2: fn(args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() != 3 {
        diagnostics.push(sema_error("E0104", span, "`Option.lift2` takes 3 arguments (f, a, b), got {args.len()}", "`Option.lift2(f, a, b)` applies a two-argument function only when both optionals are present", "call `Option.lift2(fn(x, y) {{ ... }}, a, b)`"))
        sema_call_builtin_static_discard(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return failed
    }
    left: sema_check_expression(args[1].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
    right: sema_check_expression(args[2].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
    left_inner := Type?{None}
    right_inner := Type?{None}
    if left == .Val(value) {
        // copy: `inner` is a payload of the checked operand's type, which the operand keeps
        if value.ty == .Option(inner) -> left_inner = Val(inner.copy())
    }
    if right == .Val(value) {
        // copy: `inner` is a payload of the checked operand's type, which the operand keeps
        if value.ty == .Option(inner) -> right_inner = Val(inner.copy())
    }
    if left_inner == None || right_inner == None {
        if left_inner == None {
            shown: if left == .Val(value) -> sema_type_show(value.ty) else -> "an unknown type"
            diagnostics.push(sema_error("E0108", expr_span(args[1].expr), "`Option.lift2`'s second argument must be optional, got {shown}", "`Option.lift2(f, a, b)` needs `a: T?`", "pass a `T?` value"))
        }
        if right_inner == None {
            shown: if right == .Val(value) -> sema_type_show(value.ty) else -> "an unknown type"
            diagnostics.push(sema_error("E0108", expr_span(args[2].expr), "`Option.lift2`'s third argument must be optional, got {shown}", "`Option.lift2(f, a, b)` needs `b: U?`", "pass a `T?` value"))
        }
        _ := sema_check_expression(args[0].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return failed
    }
    left_value: left ?? return failed
    right_value: right ?? return failed
    left_payload: left_inner ?? return failed
    right_payload: right_inner ?? return failed
    // copy: the payload types are also the callback's required parameters below
    required: Type.Fn{params: [Type]{left_payload.copy(), right_payload.copy()}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    // The open result adopts the callback's own return type.
    function: sema_expression_lambda_collection_callback(args[0].expr, Val(required), environment, program, scopes, state, tail_store, context, diagnostics) ?? return failed
    result := Type?{None}
    if function.ty == .Fn(params, ret, _, _, _, _) && params.len() == 2 {
        accepts: sema_call_type_assignable(params[0], left_payload, environment, program) == (Val(true)) && sema_call_type_assignable(params[1], right_payload, environment, program) == (Val(true))
        // A total callable (`T Never!`) answers its success, as a direct call
        // does; a fallible one (`T Err!`, a declared fn's default route) makes
        // the call the Result of the lifted option, so its failure propagates
        // as a direct `f(a, b)` would.
        if accepts && ret == .Val(value) {
            // copy: the lifted payload is a type of its own; the callable keeps its signature
            payload := value.copy()
            failure := Type?{None}
            if sema_expr_unwrap_tag(value) == .Result(ok, err) {
                payload = ok.copy()
                if sema_expr_unwrap_tag(err) != (Type.Named{name: "Never"}) {
                    failure = Val(err.copy())
                }
            }
            lifted: Type.Option{inner: payload.move()}
            result = Val(if failure == .Val(error) -> Type.Result{ok: lifted.move(), err: error.copy()} else -> lifted.move())
        }
    }
    result_ty: result ?? {
        diagnostics.push(sema_error("E0108", expr_span(args[0].expr), "`Option.lift2`'s first argument must be a function, got {sema_type_show(function.ty)}", "`Option.lift2(f, a, b)` needs `f: fn(T, U) R`", "pass a two-argument function or lambda"))
        return failed
    }
    function_row: sema_arena_adopt(context, function)
    left_row: sema_arena_adopt(context, left_value)
    right_row: sema_arena_adopt(context, right_value)
    value: sema_node(context, result_ty, NodeKind.OptionLift2{function: function_row, left: left_row, right: right_row}, span)
    if sema_expr_unwrap_tag(value.ty) == .Result(_, _) {
        return SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(value, expected, environment, program, context, diagnostics)}
    }
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected_owned(value, expected, environment, program, diagnostics)}
}

// `Int.reflect()`, `U8.reflect()`, `F32.reflect()` and the other builtin
// numbers: the number's TypeInfo, with its numeric form. None for a name
// that is not a builtin number.
sema_call_static_reflect_builtin: fn(name: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck? {
    graph: program.registration_graph ?? return None
    info: sema_comptime_reflection_builtin_type_info(graph, name) ?? return None
    folded: sema_tree_node(sema_fact_named("TypeInfo"), TExprKind.CtLit{value: sema_fact_declared_value(info)}, span)
    Val(SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(folded, expected, environment, program, diagnostics)})
}

// `f.reflect()` on a declared function: its FunctionInfo record, computed
// while compiling, as `T.reflect()` is for a type; on a local bound once to a
// lambda, the lambda's ClosureInfo. `f.reflect(types: [Int])` reflects the
// specialization of a generic function by those type arguments, in
// declaration order. None when `name` binds neither (another local of that
// name shadows the function) or `args` is not that one `types:` list.
sema_call_static_reflect_function: fn(name: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck? {
    if args.len() > 1 || (args.len() == 1 && !sema_call_static_reflect_is_types_arg(args[0])) {
        return None
    }
    local: sema_scope_resolve_index(scopes, name)
    // A local bound to a lambda reflects as its ClosureInfo.
    if args.len() == 0 && local == .Val(closure_index) {
        if scopes.bindings[closure_index].closure == .Val(closure) {
            // copy: the binding keeps its record for every later read.
            closure_info: sema_tree_node(sema_fact_named("ClosureInfo"), TExprKind.CtLit{value: closure.copy()}, span)
            return Val(SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(closure_info, expected, environment, program, diagnostics)})
        }
    }
    graph: program.registration_graph ?? return None
    resolved: if local == .Val(index) -> sema_scope_binding_symbol(environment, scopes, index) else -> sema_resolved_symbol(graph, sema_type_graph_lookup_symbol(graph, environment.module_identity, name) ?? return None)
    if resolved.kind != SymbolKind.Function -> return None
    types := [Type]?{None}
    if args.len() == 1 && args[0].expr == .ListLit(elements, _, _) {
        listed := [Type]{}
        loop element in elements {
            written: sema_call_type_written_as_value(element, environment, graph) ?? {
                diagnostics.push(sema_error("E0119", expr_span(element), "`types:` lists the type arguments of `{name}`, and this is not a type", "`{name}.reflect(types: [...])` reflects one specialization of a generic function, so each element is a type written where a value goes", "write a type name such as `Int`, a generic type such as `Set<Int>`, or `[Int]` for a list"))
                return Val(SemaMethodSpecialCheck{handled: true, value: None})
            }
            listed.push(written)
        }
        types = Val(listed)
    }
    diagnostics_before: diagnostics.len()
    info: sema_fact_function_info(resolved, graph, types, span, diagnostics) ?? {
        if diagnostics.len() > diagnostics_before {
            return Val(SemaMethodSpecialCheck{handled: true, value: None})
        }
        return None
    }
    folded: sema_tree_node(sema_fact_named("FunctionInfo"), TExprKind.CtLit{value: sema_fact_declared_value(info)}, span)
    Val(SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(folded, expected, environment, program, diagnostics)})
}

// Whether `arg` is the `types: [...]` list of `f.reflect(types: [...])`.
sema_call_static_reflect_is_types_arg: fn(arg: CallArg) -> Bool Never! {
    if arg.spread -> return false
    if arg.label == .Val(label) && label.name == "types" -> return arg.expr == .ListLit(_, _, _)
    false
}

// The type written where a value goes (a `types:` element, or a value
// where a `TypeId` is expected): a builtin or declared type name (`Int`,
// `Shelf`), a declared type through its module's import (`geo.Point`), a
// generic type (`Shelf<Int>`), or a one-element list (`[Int]`, a list of
// that type). None for any other value.
sema_call_type_written_as_value: fn(element: Expr, environment: SemaScopeEnvironment, graph: SemaRegistrationGraph) -> Type? {
    // copy: the specialization owns its argument type; the call keeps its tree.
    if element == .TypeValue(ty, _, _) -> return Val(ty.copy())
    if element == .ListLit(inner, _, _) {
        if inner.len() != 1 -> return None
        item: sema_call_type_written_as_value(inner[0], environment, graph) ?? return None
        return Val(Type.List{element: item})
    }
    if element == .Ident(name, _, _) {
        named: foundation_named_type(name)
        if named == .Named(_) {
            symbol: sema_type_graph_lookup_symbol(graph, environment.module_identity, name) ?? return None
            if sema_resolved_symbol(graph, symbol).kind != SymbolKind.Type -> return None
        }
        return Val(named)
    }
    if element == .Field(.Ident(alias, _, _), member, _, _) {
        qualified: "{alias}.{member}"
        symbol: sema_type_graph_lookup_symbol(graph, environment.module_identity, qualified) ?? return None
        if sema_resolved_symbol(graph, symbol).kind != SymbolKind.Type -> return None
        return Val(Type.Named{name: qualified})
    }
    None
}

sema_call_try_static_method: fn(receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if receiver == .Call(descriptor, _) {
        return sema_call_try_inline_range_conversion(descriptor, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    if receiver == .Ident(name, _, _) {
        if method == "reflect" && owner_type_args.len() == 0 && type_args.len() == 0 {
            if sema_call_static_reflect_function(name, args, span, expected, environment, program, scopes, diagnostics) == .Val(reflected) {
                return reflected
            }
        }
    }
    static_owner: sema_call_static_source_owner(receiver, method, owner_type_args, environment, program, scopes) ?? {
        if receiver == .Field(base, owner_leaf, _, _) {
            return sema_call_try_builtin_static_field(base, owner_leaf, method, owner_type_args, type_args, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        if receiver == .Ident(name, _, _) {
            if name == "Perf" && sema_scope_resolve_index(scopes, name) == None {
                return sema_call_perf_static(method, type_args, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            }
            if name == "Option" && method == "lift2" && sema_scope_resolve_index(scopes, name) == None {
                return sema_call_option_lift2(args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            }
            if sema_scope_resolve_index(scopes, name) == None && owner_type_args.len() == 0 && type_args.len() == 0 {
                if method == "reflect" && args.len() == 0 {
                    if sema_call_static_reflect_builtin(name, span, expected, environment, program, diagnostics) == .Val(reflected) {
                        return reflected
                    }
                }
                math := sema_call_try_math_static(name, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
                if math.handled -> return math
                if program.registration_graph == .Val(graph) {
                    conversions: sema_call_static_builtin_conversion_targets(graph, name, method, environment, program, span, diagnostics)
                    if conversions.len() > 0 {
                        return sema_call_static_selected(name, method, conversions, type_args, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
                    }
                }
            }
            return sema_call_try_builtin_static(name, "", method, owner_type_args, type_args, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    owner_symbol: static_owner.symbol
    static_args: static_owner.owner_type_args
    type_name: owner_symbol.name
    // The distinct conversion names its owner as written: `pkg.ID` resolves
    // from this module where the bare declared name does not.
    written_name := type_name.copy()
    if receiver == .Field(.Ident(alias, _, _), leaf, _, _) -> written_name = "{alias}.{leaf}"
    if owner_symbol.kind != SymbolKind.Type {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if method == "new" && args.len() == 3 && type_name == "ExpiringSecret" && module_is_core(owner_symbol.module_identity) {
        if !sema_call_expiring_secret_new_accepts(args, environment, program, scopes, state, tail_store, context, diagnostics) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    // E2938 (`UIShortcut.cmd`): the command-key
    // constructor fixes its key before code generation.
    if method == "cmd" && args.len() == 1 && type_name == "UIShortcut" && module_is_core(owner_symbol.module_identity) {
        sema_call_ui_shortcut_cmd_key(args[0], diagnostics)
    }

    diagnostics_before := diagnostics.len()
    targets := [SemaStaticMethodTarget]{}
    generic_owner_method := false
    owner_param_names := [String]{}
    if program.registration_graph == .Val(graph) {
        owner_row: sema_type_graph_nominal_row(graph, owner_symbol.id)
        if owner_row == .Val(row) {
            owner: graph.modules[row.module_index].nominals[row.row]
            targets = sema_call_static_registered_targets(graph, owner, method, static_args, type_args, args, expected, environment, program, scopes, state, tail_store, context, span, diagnostics)
            generic_owner_method = owner.generic_params.len() > 0 && static_args.len() == 0 && sema_call_static_registered_method_exists(graph, owner, method, environment, program)
            loop param in owner.generic_params -> owner_param_names.push(param.name)
        }
    }
    if targets.len() == 0 && program.registration_graph == None {
        targets = sema_call_static_local_targets(owner_symbol, method, static_args, type_args, args, expected, environment, program, scopes, state, tail_store, context, span, diagnostics)
        generic_owner_method = static_args.len() == 0 && sema_call_static_local_generic_method_exists(owner_symbol, method, environment, program)
    }
    if targets.len() == 0 {
        if diagnostics.len() > diagnostics_before {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        distinct := sema_call_try_distinct_conversion(owner_symbol, written_name, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        if distinct.handled -> return distinct
        // `T.reflect()` on a declared type is that type's TypeInfo record,
        // computed while compiling: in compile-time code, in `build: fn` and in
        // the running program, which holds it as data. A generic type named
        // with its type arguments reflects that specialization.
        if method == "reflect" && args.len() == 0 && type_args.len() == 0 {
            if sema_fact_type_info(Val(owner_symbol), type_name, static_args, environment, program) == .Val(info) {
                folded: sema_tree_node(sema_fact_named("TypeInfo"), TExprKind.CtLit{value: sema_fact_declared_value(info)}, span)
                return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(folded, expected, environment, program, diagnostics)}
            }
            if static_args.len() == 0 && sema_call_static_reflect_builtin(type_name, span, expected, environment, program, diagnostics) == .Val(reflected) {
                return reflected
            }
        }
        // Declared statics win; a canonical Core or compiler owner then falls back to its built-in rows.
        if !generic_owner_method && sema_expr_canonical_type_binding(type_name, environment, program, scopes) {
            builtin := sema_call_try_builtin_static(type_name, sema_scope_module_text(environment, program, owner_symbol.module_identity), method, static_args, type_args, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            if builtin.handled -> return builtin
        }
        if {
            generic_owner_method -> {
                written: if owner_param_names.len() > 0 -> "{type_name}<{owner_param_names.join(", ")}>" else -> "{type_name}<…>"
                diagnostics.push(sema_error("E0904", method_span, "`{type_name}.{method}` needs its generic receiver type here", "constructor inputs and the surrounding expected type must determine one concrete receiver type", "write the full receiver, such as `{written}.{method}(...)`"))
            }
            else -> {
                // Rust `check_static_method_call`: a declared method with a
                // `self` receiver named through its type needs a value. A
                // static of that name failed on its arguments instead.
                instance := false
                loop name in sema_call_declared_method_names(owner_symbol.ty ?? Type.Named{name: type_name}, environment, program) {
                    if name == method {
                        instance = true
                        break
                    }
                }
                if instance && program.registration_graph == .Val(graph) {
                    if sema_type_graph_nominal_row(graph, owner_symbol.id) == .Val(row) && sema_call_static_registered_method_exists(graph, graph.modules[row.module_index].nominals[row.row], method, environment, program) {
                        instance = false
                    }
                }
                if instance {
                    diagnostics.push(sema_error("E0311", method_span, "`{method}` is an instance method on `{type_name}`", "instance methods need a value before the dot", "call it on a `{type_name}` value: `x.{method}(...)`"))
                } else {
                    diagnostics.push(sema_error("E0311", method_span, "`{type_name}` has no matching static method `{method}`", "static lookup requires a visible associated method with no `self` receiver and a valid owner type", "use a declared static method on this type"))
                }
            }
        }
        return SemaMethodSpecialCheck{handled: true, value: None}
    }

    sema_call_static_selected(type_name, method, targets, type_args, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

// The checked call of the one target among `targets` the arguments select,
// rewritten to its registered method.
sema_call_static_selected: fn(type_name: String, method: String, targets: [SemaStaticMethodTarget], type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    direct_targets := loop target in targets -> target.target
    // One owner's statics of one name that share a shape (each
    // `impl AppErr.From(Source)` declares one `AppErr.from`, one per source)
    // are told apart by the types of the arguments.
    if targets.len() > 1 {
        picked: sema_call_static_by_argument_types(targets, args, environment, program, scopes, state, tail_store, context)
        if picked.len() > 0 {
            // Popped from the end into `all`, then back, so the kept targets
            // stay in order.
            all := [SemaCallDirectTarget]{}
            loop direct_targets.len() > 0 {
                candidate := direct_targets.pop() ?? break
                all.push(candidate)
            }
            index := 0
            loop all.len() > 0 {
                candidate := all.pop() ?? break
                if picked.contains(index) -> direct_targets.push(candidate)
                index += 1
            }
        }
    }
    selected: sema_call_resolve_direct_candidates("{type_name}.{method}", args, direct_targets, span, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    target := targets[0]
    loop candidate in targets {
        if candidate.target.symbol.id == selected.symbol.id {
            target = candidate
            break
        }
    }
    probe_args := args
    binding: sema_call_bind_direct("{type_name}.{method}", selected.signature, probe_args, span, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    defaults: if program.registration_graph == .Val(graph) -> sema_call_registration_defaults(graph, binding) ?? return SemaMethodSpecialCheck{handled: true, value: None} else -> sema_call_static_local_defaults(target, binding, environment, program) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    call := Call{name: "{type_name}.{method}", name_span: span, type_args: type_args, args: args}
    checked: sema_call_check_direct_target_owned(state, selected, call, defaults, expected, environment, program, scopes, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    method_id: sema_call_callee_decl(program, target.method.symbol, span, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    call_value: sema_call_static_call_value(checked.value, method_id) ?? {
        diagnostics.push(sema_error("E0104", span, "static method call `{type_name}.{method}` could not be lowered", "the checked callable did not preserve its registered SymbolId", "use the registered static method declaration"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    call_checked := checked
    call_checked.value = call_value
    context.call_return_views.push(SemaCallReturnView{span: span, facts: checked.return_view_facts})
    if !sema_expr_record_call_fact(environment, program, scopes, context, span, call_checked, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    value := checked.value
    if !sema_call_static_rewrite_value(value, target, method_id) {
        diagnostics.push(sema_error("E0104", span, "static method call `{type_name}.{method}` could not be lowered", "the checked callable did not preserve its registered SymbolId", "use the registered static method declaration"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    SemaMethodSpecialCheck{handled: true, value: Val(value)}
}

// The indices of the targets among `targets` whose parameters take the
// probed types of `args`: those that take each type exactly, else those
// whose every other parameter the argument checks under. An argument checked
// against its parameter is what the call itself does, so a decimal literal
// (or a binding of one) that meets `Float` adopts it, and meets no `Int`.
// Labeled arguments, an argument that does not probe, or no target taking
// them picks none, leaving every target to the shape check.
sema_call_static_by_argument_types: fn(targets: [SemaStaticMethodTarget], args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> [Int] {
    argument_types := [Type]{}
    probe_diagnostics := [Diagnostic]{}
    loop arg in args {
        if arg.label != None || arg.spread -> return [Int]{}
        probed: sema_probe_expression(arg.expr, None, environment, program, scopes, state, tail_store, context, probe_diagnostics) ?? return [Int]{}
        argument_types.push(sema_call_resolved_type(probed.ty, environment, program))
    }
    exact := [Int]{}
    assignable := [Int]{}
    loop target_index in 0..<targets.len() {
        params: sema_call_params_from_type(targets[target_index].target.signature) ?? next
        if params.len() != argument_types.len() -> next
        same := true
        accepts := true
        loop index in 0..<params.len() {
            declared: params[index].ty ?? {
                accepts = false
                break
            }
            required: Val(sema_call_resolved_type(declared, environment, program))
            if required == .Val(resolved) && resolved == argument_types[index] -> next
            same = false
            if !sema_call_static_argument_checks_under(args[index].expr, required, environment, program, scopes, state, tail_store, context) {
                accepts = false
                break
            }
        }
        if accepts && same -> exact.push(target_index)
        if accepts && !same -> assignable.push(target_index)
    }
    if exact.len() > 0 -> exact else -> assignable
}

// Whether `value` checks under `expected`, its parameter's type, with no
// report and a type that parameter takes.
sema_call_static_argument_checks_under: fn(value: Expr, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Bool {
    probe_diagnostics := [Diagnostic]{}
    probed: sema_probe_expression(value, expected, environment, program, scopes, state, tail_store, context, probe_diagnostics) ?? return false
    if probe_diagnostics.len() > 0 -> return false
    if expected == .Val(required) {
        return sema_call_type_assignable(required, sema_call_resolved_type(probed.ty, environment, program), environment, program) ?? false
    }
    false
}

// `ExpiringSecret.new` owns only the closed secret family (E0112 at the value)
// and observes only an injected Clock (E0112 at the clock). The arguments are
// probed: the ordinary source call that follows checks and moves them once.
sema_call_expiring_secret_new_accepts: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    accepted := true
    probe_diagnostics := [Diagnostic]{}
    value: sema_probe_expression(args[0].expr, None, environment, program, scopes, state, tail_store, context, probe_diagnostics)
    if value == .Val(checked_value) && !sema_is_expiring_secret_member_type(sema_call_resolved_type(checked_value.ty, environment, program)) {
        diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`ExpiringSecret.new` cannot own {sema_type_show(checked_value.ty)}", "expiring secrets accept only the closed, move-only secret family with audited zeroizing Drop behavior", "convert text or bytes to `crypto.Secret`, or use `crypto.SigningKey` / `crypto.X25519SecretKey`"))
        accepted = false
    }
    clock: sema_probe_expression(args[2].expr, None, environment, program, scopes, state, tail_store, context, probe_diagnostics)
    if clock == .Val(checked_clock) && !sema_call_is_clock_type(checked_clock.ty) {
        diagnostics.push(sema_error("E0112", expr_span(args[2].expr), "`ExpiringSecret.new` wants `Clock` for argument 3, but this is {sema_type_show(checked_clock.ty)}", "secret expiry must observe the explicitly injected clock", "use `Clock.new(...)` for deterministic code or `Clock.system()` for production"))
        accepted = false
    }
    accepted
}

sema_call_is_clock_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> name == "Clock" || sema_core_canonical_leaf(name, "core.time", "Core/Time/Time.jet") == (Val("Clock"))
        .Tagged(_, inner) -> sema_call_is_clock_type(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// The numeric destination conversion a distinct type
// inherits from its numeric base (`UserID.from_int`, `Meters.from_float`):
// the base's own conversion row. Between two whole-number types the built-in
// owner has no row of its own (`T{x}` converts), but the distinct type keeps it.
sema_call_distinct_numeric_row: fn(base: Type, method: String) -> BuiltinStaticRow? {
    if !sema_expr_is_numeric(base) -> return None
    loop row in builtin_static_rows(type_name(base), method) {
        if row.lowering == .Numeric(_) -> return Val(row)
    }
    builtin_static_numeric_row(type_name(base), method)
}

sema_call_distinct_numeric_operation: fn(row: BuiltinStaticRow, line: Int) -> TNumericOp? {
    if row.lowering == .Numeric(operation) -> return Val(sema_call_numeric_at_line(operation, line))
    None
}

// A registry numeric operation placed at its call: a checked Int-to-Float
// crossing reports the call's line when it stops.
sema_call_numeric_at_line: fn(operation: TNumericOp, line: Int) -> TNumericOp Never! {
    if operation == .CheckedIntToFloat(source_signed, target_f32, _) {
        return TNumericOp.CheckedIntToFloat{source_signed: source_signed, target_f32: target_f32, line: line}
    }
    // copy: `operation` is a payload of a read registry row, which keeps the original; the returned operation owns this one
    operation.copy()
}

// A distinct over a non-numeric base is built by its base-named conversion
// (`Name.from_string(text)` over `String`).
sema_call_distinct_base_method: fn(base: Type) -> String {
    "from_{sema_casing_canonical(type_name(base), SemaNameCase.Snake)}"
}

sema_call_distinct_conversion_unhandled: fn() -> SemaMethodSpecialCheck Never! {
    SemaMethodSpecialCheck{handled: false, value: None}
}

sema_call_distinct_conversion_failed: fn() -> SemaMethodSpecialCheck Never! {
    SemaMethodSpecialCheck{handled: true, value: None}
}

// A distinct type owns the conversion
// from its base (`UserID.from_int(42)`). A literal is proved against a range
// type's bounds here (E0135); a runtime value makes the range type's
// conversion fallible, which a binding then reports (E0136).
sema_call_try_distinct_conversion: fn(owner: Symbol, display_name: String, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    facts: sema_expr_declared_distinct_facts(Type.Named{name: display_name}, true, environment, program, scopes) ?? return sema_call_distinct_conversion_unhandled()
    numeric_row: sema_call_distinct_numeric_row(facts.base, method)
    if numeric_row == None && (sema_expr_is_numeric(facts.base) || method != sema_call_distinct_base_method(facts.base)) {
        return sema_call_distinct_conversion_unhandled()
    }
    callee: "{display_name}.{method}"
    if args.len() != 1 {
        diagnostics.push(sema_error("E0104", span, "`{callee}` takes one value, got {args.len()}", "a distinct conversion wraps exactly one value of its base type", "write `{callee}(value)`"))
        sema_call_builtin_static_discard(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return sema_call_distinct_conversion_failed()
    }
    source: if numeric_row == .Val(row) -> row.parameters[0] else -> facts.base
    diagnostics_before: diagnostics.len()
    argument: sema_check_expression(args[0].expr, Val(source), environment, program, scopes, state, tail_store, context, diagnostics) ?? return sema_call_distinct_conversion_failed()
    if diagnostics.len() > diagnostics_before -> return sema_call_distinct_conversion_failed()
    if !type_identity_equal(argument.ty, source) {
        diagnostics.push(sema_error("E0108", expr_span(args[0].expr), "argument to `{callee}` should be {type_name(source)}, not {type_name(argument.ty)}", "the source name fixes the conversion input type", "pass a {type_name(source)} value"))
        return sema_call_distinct_conversion_failed()
    }
    params: [SemaCallParam]{SemaCallParam{label: "arg0", name: "arg0", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(argument.ty), variadic: false}}
    ownership_args := args
    ownership := sema_ownership_check_call_arguments(state, callee, params, ownership_args, scopes, diagnostics)
    if !ownership.accepted || !ownership.complete -> return sema_call_distinct_conversion_failed()
    success: Type.Named{name: display_name}
    row: numeric_row ?? {
        constructed: sema_tree_node(success, TExprKind.DistinctCtor{argument: argument}, span)
        return SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(constructed, expected, environment, program, context, diagnostics)}
    }
    operation: sema_call_distinct_numeric_operation(row, sema_source_line_at(environment.source_segments, span) ?? 0) ?? return sema_call_distinct_conversion_failed()
    // Rust `converted_literal`: an integer literal that fits the base is
    // known at compile time, so a range type checks it here.
    literal_in_range := false
    if facts.range == .Val(bounds) {
        if argument.kind == .IntLit(literal, _) {
            base_bounds: sema_expr_integer_range_for_type(facts.base)
            fits_base: if base_bounds == .Val(base_range) -> literal >= base_range.lo && literal <= base_range.hi else -> true
            if sema_expr_is_integer(source) && sema_expr_is_integer(facts.base) && fits_base {
                literal_in_range = true
                if literal < bounds.lo || literal > bounds.hi {
                    diagnostics.push(sema_error("E0135", argument.span, "`{literal}` is outside `{display_name}`'s range {bounds.lo}..{bounds.hi}", "a range type only holds values inside its bounds; `{literal}` can never be a `{display_name}`", "use a value in `{bounds.lo}..{bounds.hi}`, or widen the type's range"))
                }
            }
        }
        // A literal beyond i64 keeps its exact decimal (a BigInt constant);
        // it is still known at compile time, so the interval check sees it.
        if argument.kind == .CtLit(constant) {
            if constant == .BigInt(decimal) {
                if sema_expr_is_integer(source) && sema_expr_is_integer(facts.base) {
                    literal_in_range = true
                    // Core Int is exact, so the decimal parses to the literal itself.
                    outside: if Int.parse(decimal) == {
                        .Ok(literal) -> literal < bounds.lo || literal > bounds.hi
                        .Err(_) -> true
                    }
                    if outside {
                        diagnostics.push(sema_error("E0135", argument.span, "`{decimal}` is outside `{display_name}`'s range {bounds.lo}..{bounds.hi}", "a range type only holds values inside its bounds; `{decimal}` can never be a `{display_name}`", "use a value in `{bounds.lo}..{bounds.hi}`, or widen the type's range"))
                    }
                }
            }
        }
    }
    base_fallible: if row.return_type == {
        .Result(_, _) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
    fallible: base_fallible || (facts.range != None && !literal_in_range)
    result: if fallible -> Type.Result{ok: success, err: Type.String} else -> success
    argument_row: sema_arena_adopt(context, argument)
    converted: sema_node(context, result, NodeKind.DistinctConvert{owner: owner.id, argument: argument_row, operation: operation, range: facts.range, fallible: fallible}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(converted, expected, environment, program, context, diagnostics)}
}

// (#1549): `Int(lo..hi)` written as a call is the type head of
// an inline range conversion, not a runtime constructor.
sema_call_inline_range_descriptor: fn(descriptor: Call) -> SemaIntegerRange? {
    if descriptor.name != "Int" || descriptor.args.len() != 1 -> return None
    if descriptor.args[0].expr == .Range(start, end, exclusive, _, _) {
        if exclusive -> return None
        if start == .Int(lo, _, _, _, _) {
            if end == .Int(hi, _, _, _, _) -> return Val(SemaIntegerRange{lo: lo, hi: hi})
        }
    }
    None
}

// E0135: an integer literal outside an inline range.
sema_inline_range_out_of_bounds: fn(value: Int, lo: Int, hi: Int, span: Span) -> Diagnostic {
    sema_error("E0135", span, "`{value}` is outside `Int({lo}..{hi})`'s range {lo}..{hi}", "a range type only holds values inside its bounds; `{value}` can never be an `Int({lo}..{hi})`", "use a value in `{lo}..{hi}`, or widen the type's range")
}

// `Int(lo..hi).from_int(value)`. A literal is proved against
// the interval here (E0135); a runtime value converts fallibly.
sema_call_try_inline_range_conversion: fn(descriptor: Call, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "from_int" -> return sema_call_distinct_conversion_unhandled()
    if sema_scope_resolve_index(scopes, "Int") == .Val(int_binding) {
        if scopes.bindings[int_binding].symbol.kind != SymbolKind.Type {
            return sema_call_distinct_conversion_unhandled()
        }
    }
    bounds: sema_call_inline_range_descriptor(descriptor) ?? return sema_call_distinct_conversion_unhandled()
    head: "Int({bounds.lo}..{bounds.hi})"
    if bounds.lo > bounds.hi {
        diagnostics.push(sema_error("E0137", span, "this range is empty — {bounds.lo} is after {bounds.hi}", "a range's low bound must not be greater than its high bound", "write `{bounds.hi}..{bounds.lo}` (swap the bounds), or fix the values"))
        sema_call_builtin_static_discard(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return sema_call_distinct_conversion_failed()
    }
    if args.len() != 1 {
        diagnostics.push(sema_error("E0104", span, "`{head}.{method}` takes one value, got {args.len()}", "a range conversion wraps exactly one integer value", "write `{head}.{method}(value)`"))
        sema_call_builtin_static_discard(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return sema_call_distinct_conversion_failed()
    }
    // A propagating runtime conversion inside a binding is reported at its
    // value (E0136); a carrier consumer (`??`, `?`) handles the failure.
    reports_runtime: context.failure_success_view && context.binding_initializer
    checked: sema_check_expression(args[0].expr, Val(Type.Int), environment, program, scopes, state, tail_store, context, diagnostics) ?? return sema_call_distinct_conversion_failed()
    argument: sema_expr_expected(checked, Val(Type.Int), environment, program, diagnostics) ?? return sema_call_distinct_conversion_failed()
    target: Type.InlineRange{base: Type.Int, lo: bounds.lo, hi: bounds.hi}
    literal := false
    if args[0].expr == .Int(value, literal_span, _, _, _) {
        literal = true
        if value < bounds.lo || value > bounds.hi {
            diagnostics.push(sema_inline_range_out_of_bounds(value, bounds.lo, bounds.hi, literal_span))
        }
    }
    if !literal && reports_runtime {
        diagnostics.push(sema_range_runtime_conversion(head, method, expr_span(args[0].expr)))
    }
    result: if literal -> target else -> Type.Result{ok: target, err: Type.String}
    converted: sema_tree_node(result, TExprKind.NumericMethod{receiver: argument, operation: TNumericOp.InlineRange{lo: bounds.lo, hi: bounds.hi, fallible: !literal}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(converted, expected, environment, program, context, diagnostics)}
}

// E0136: a runtime value entering a range type needs the
// fallible conversion's failure handled.
sema_range_runtime_conversion: fn(head: String, method: String, span: Span) -> Diagnostic {
    sema_error("E0136", span, "making a `{head}` from a runtime value can fail", "only a literal is checked at compile time; a runtime number needs the fallible form so a bad value is handled", "write `{head}.{method}(raw)?` and handle the failure")
}

// E2938: `UIShortcut.cmd` takes one positional, non-empty plain string
// literal; a dynamic key goes through `core.ui.host.shortcut`.
sema_call_ui_shortcut_cmd_key: fn(argument: CallArg, diagnostics: &[Diagnostic]) {
    literal := String?{None}
    if sema_registration_cli_without_parens(argument.expr) == .Str(parts, _, _) {
        if parts.len() == 1 && parts[0] == .Lit(text) -> literal = Val(text.copy())
    }
    labelled: argument.label != None
    if !labelled && literal == .Val(key) {
        if key.trim() != "" {
            return
        }
    }
    reason := "the key must not be empty"
    if literal == None -> reason = "the key must be one plain string literal"
    if labelled -> reason = "the key must be positional"
    shortcut: literal ?? "<expression>"
    row: diagnostic_registry_row("E2938") ?? panic("E2938 must have a registry row")
    diagnostics.push(sema_error("E2938", argument.span, "Invalid UI shortcut literal `{shortcut}`: {reason}", row.why, row.fix))
}
