            if conv == AccessConvention.Write && arg.convention != AccessConvention.Write {
                self.diags.push(Diagnostic.error("E0202", "argument " + (index + 1).to_string() + " to `" + name + "` requires the write-access marker `&`", "this standard library call edits that value in place", "write the write-access marker `&`: `" + Syntax.SIGIL_WRITE + "value` for this argument", Val(arg.span)))
            } else if conv == AccessConvention.Write {
                if arg.expr == .Ident(ident, ident_span) && self.lookup(ident) == .Val(info) && !info.mutable {
                    diagnostic := Diagnostic.error("E0111", "`" + ident + "` was made with `" + Syntax.SIGIL_BIND_IMMUT + "`, so it can't be changed", "`" + name + "` will change this value, so it must be mutable (`" + Syntax.SIGIL_BIND_MUT + "`)", "declare it with `" + ident + " " + Syntax.SIGIL_BIND_MUT + " ...`", Val(ident_span))
                    if info.binding_sigil_span == .Val(sigil_span) { diagnostic = diagnostic.with_edit(TextEdit{span: sigil_span, new_text: Syntax.SIGIL_BIND_MUT}) }
                    self.diags.push(^diagnostic)
                }
            }
            self.expect_core_arg(name, index, param_ty, &arg)
            if retained_ui_callback {
                self.lambda_escapes = saved_callback_escapes
                if arg.expr != .Absent { self.check_stream_callback_expr(arg.expr, param_ty) }
            }
        }
        loop index in params.len()..<args.len() { _ :: self.infer(&args[index].expr) }
        imported_expert := false
        loop imported in self.core_imports.values() { if imported == "core.crypto.expert" { imported_expert = true; break } }
        expert_gate_ok :: module != "core.crypto.expert" || (self.in_unsafe && imported_expert)
        if expert_gate_ok && (args.len() == params.len() || raw_envelope_diagnostic.is_some()) && self.diags.len() == validation_diag_start {
            diagnostic := raw_envelope_diagnostic
            if diagnostic.is_none() { diagnostic = crypto_misuse_diagnostic(&self, module, name, args) }
            if diagnostic == .Val(value) { self.fx_pending_diagnostics.push(^value) }
        }
        // Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_call.rs:7602
        if module == "core.time" && name == "clock" {
            if ret == .Val(ty) -> return Val(deterministic_clock_type(^ty))
            return None
        }
        if compute_alias_ret.is_some() -> return compute_alias_ret
        ret
    }
}
