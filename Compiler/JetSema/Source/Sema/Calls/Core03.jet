    // Direct continuation of dispatch: the preceding owner already checked arity and inferred args[0].
    fn infer_http_dispatch_tail(&self, router_ty: Type?, args: &[CallArg]) -> Type? Never! {
        if router_ty == .Val(other) && other != Type.Named("HTTPRouter") {
            self.diags.push(Diagnostic.error("E0112", "`http.dispatch` needs an HTTPRouter, not " + other.show(), "build a router with `http.router()` and register routes with `.get/.post/…`", "write `http.dispatch(router, req)`", Val(args[0].expr.span())))
        }
        if args.get_mut(1) == .Val(arg) {
            req_ty :: self.infer(&arg.expr)
            if req_ty == .Val(other) && other != Type.Named("HTTPRequest") {
                self.diags.push(Diagnostic.error("E0112", "`http.dispatch` needs an HTTPRequest, not " + other.show(), "parse the raw request with `http.parse(raw)`", "write `http.dispatch(router, req)` where `req` is an HTTPRequest", Val(arg.expr.span())))
            }
        }
        Val(Type.Result(Type.Named("HTTPResponse"), Type.Named("HTTPError")))
    }

