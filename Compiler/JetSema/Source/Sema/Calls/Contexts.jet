// Shared call-context helpers. These helpers keep temporary knowledge gates and
// callback ABI facts explicit at the call boundary; callers must close every
// entered scope before returning, including error paths.

pub struct SemaCallKnowledgeScope {
    pub previous: SemaKnowledgeGate?
}

pub fn sema_call_gate_for_name(name: String) -> SemaKnowledgeGate? {
    if name == {
        "wrapping" | "saturating" | "checked" -> Val(SemaKnowledgeGate.BoundedArithmetic)
        "approx" -> Val(SemaKnowledgeGate.Approximation)
        else -> None
    }
}

pub fn sema_call_method_gate(method: String) -> SemaKnowledgeGate? {
    if method.starts_with("from_") && method.ends_with("_rounded") -> Val(SemaKnowledgeGate.RoundedConversion) else -> None
}

pub fn sema_call_gate_is_unshadowed(name: String, scopes: SemaScopeTable) -> Bool Never! {
    sema_scope_resolve_index(scopes, name) == None
}

pub fn sema_call_enter_gate(scopes: &SemaScopeTable, gate: SemaKnowledgeGate) -> SemaCallKnowledgeScope Never! {
    SemaCallKnowledgeScope{previous: sema_scope_push_knowledge_gate(&scopes, gate)}
}

pub fn sema_call_leave_gate(scopes: &SemaScopeTable, scope: SemaCallKnowledgeScope) Never! {
    sema_scope_pop_knowledge_gate(&scopes, scope.previous)
}

pub fn sema_call_direct_gate(name: String, scopes: SemaScopeTable) -> SemaKnowledgeGate? {
    if sema_call_gate_is_unshadowed(name, scopes) -> sema_call_gate_for_name(name) else -> None
}

pub fn sema_call_is_overflow_operation(op: BinOp) -> Bool Never! {
    if op == {
        .Add | .Sub | .Mul | .Div -> true
        else -> false
    }
}

pub fn sema_call_overflow_operation_name(op: BinOp) -> String Never! {
    if op == {
        .Add -> "add"
        .Sub -> "sub"
        .Mul -> "mul"
        .Div -> "div"
        else -> "add"
    }
}

pub fn sema_call_host_callback_type(inner: Type, result: Type?, shared: Bool) -> Type Never! {
    sema_shared_access_host_callback_type(inner, result, shared)
}
