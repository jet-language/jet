// Shared call-context helpers. These helpers keep temporary knowledge gates and
// callback ABI facts explicit at the call boundary; callers must close every
// entered scope before returning, including error paths.
use jet_foundation.[
    BinOp,
    Type,
]

SemaCallKnowledgeScope: struct {
    previous: SemaKnowledgeGate?
}

sema_call_gate_for_name: fn(name: String) -> SemaKnowledgeGate? {
    if name == {
        "wrapping" | "saturating" | "checked" -> Val(SemaKnowledgeGate.BoundedArithmetic)
        "approx" -> Val(SemaKnowledgeGate.Approximation)
        else -> None
    }
}

sema_call_method_gate: fn(method: String) -> SemaKnowledgeGate? {
    if method.starts_with("from_") && method.ends_with("_rounded") -> Val(SemaKnowledgeGate.RoundedConversion) else -> None
}

sema_call_gate_is_unshadowed: fn(name: String, scopes: SemaScopeTable) -> Bool Never! {
    sema_scope_resolve_index(scopes, name) == None
}

sema_call_enter_gate: fn(scopes: &SemaScopeTable, gate: SemaKnowledgeGate) -> SemaCallKnowledgeScope Never! {
    SemaCallKnowledgeScope{previous: sema_scope_push_knowledge_gate(scopes, gate)}
}

sema_call_leave_gate: fn(scopes: &SemaScopeTable, scope: SemaCallKnowledgeScope) Never! {
    sema_scope_pop_knowledge_gate(scopes, scope.previous)
}

sema_call_direct_gate: fn(name: String, scopes: SemaScopeTable) -> SemaKnowledgeGate? {
    if sema_call_gate_is_unshadowed(name, scopes) -> sema_call_gate_for_name(name) else -> None
}

sema_call_is_overflow_operation: fn(op: BinOp) -> Bool Never! {
    if op == {
        .Add | .Sub | .Mul | .Div -> true
        .FloorDiv | .Mod | .Rem | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Gt | .Le | .Ge | .Compare | .And | .Or -> false
    }
}

sema_call_overflow_operation_name: fn(op: BinOp) -> String Never! {
    if op == {
        .Add -> "add"
        .Sub -> "sub"
        .Mul -> "mul"
        .Div -> "div"
        .FloorDiv | .Mod | .Rem | .Pow | .BitAnd | .BitOr | .BitXor | .Shl | .Shr | .Eq | .Ne | .Lt | .Gt | .Le | .Ge | .Compare | .And | .Or -> "add"
    }
}

sema_call_host_callback_type: fn(inner: Type, result: Type?, shared: Bool) -> Type Never! {
    sema_shared_access_host_callback_type(inner, result, shared)
}
