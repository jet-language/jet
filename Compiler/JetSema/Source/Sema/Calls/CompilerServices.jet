// Compiler values in checked code: the `core.compiler` result records and the
// reflection records whose fields and methods the compiler answers while it
// serves comptime and build code. The `core.compiler` queries themselves are
// Core declarations bound to the compiler's symbols (`#Import(jet.compiler,
// symbol: …)`, Guest.jet); their phase is the provider's (Calls/Direct.jet
// sema_call_service_out_of_phase).
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    ParamZone,
    Span,
    Type,
    symbol_key_leaf,
]

// A `core.compiler` query result or one of its records. The compiler answers
// its fields and methods while it serves comptime and build code (JetIR
// ir_host_method); no runtime layout holds one, so a running program can't
// read it. A declared type resolves to its canonical `module.Name`, so a
// bare name here is the compiler's own.
sema_compiler_host_value_name: fn(name: String) -> Bool Never! {
    if name == {
        "CompilerError" | "CompilerDiagnostic" | "CompilerDiagnosticOrigin" | "CompilerFixEdit" | "CompilerLexed" | "CompilerToken" | "CompilerSyntaxTree" | "CompilerNode" | "CompilerChecked" | "CompilerSemanticIndex" | "CompilerSourceMap" | "CompilerGeneratedLine" -> true
        "CompilerManifest" | "CompilerPackage" | "CompilerPackageError" | "CompilerDependency" | "CompilerPackageTarget" | "CompilerPackageOutput" | "CompilerBuildProfile" -> true
        "CompilerLock" | "CompilerLockedPackage" | "CompilerProfileSet" | "CompilerProfile" | "CompilerKeyValue" -> true
        else -> false
    }
}

// The compiler value (sema_compiler_host_value_name) `ty` holds anywhere:
// itself, or an element, payload or member of it.
sema_compiler_host_value_held: fn(ty: Type) -> String? Never! {
    if ty == {
        .Tagged(_, inner) -> return sema_compiler_host_value_held(inner)
        .Named(name) -> {
            if sema_compiler_host_value_name(name) -> return Val(name.copy())
        }
        .List(element) -> return sema_compiler_host_value_held(element)
        .Option(inner) -> return sema_compiler_host_value_held(inner)
        .Result(ok, err) -> {
            if sema_compiler_host_value_held(ok) == .Val(name) -> return Val(name)
            return sema_compiler_host_value_held(err)
        }
        .Tuple(fields) -> {
            loop field in fields {
                if sema_compiler_host_value_held(field.ty) == .Val(name) -> return Val(name)
            }
        }
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    None
}

// Runtime code reading `name`, a compile-time value that holds compiler value
// `held`: no compiler answers its fields and methods once the program runs,
// so only comptime code and the build entry `build: fn(b: Build)` read it.
sema_compiler_host_value_runtime_read: fn(name: String, held: String, span: Span, scopes: SemaScopeTable, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: ^[Diagnostic]) {
    if sema_scope_build_time(scopes, environment, program) -> return
    diagnostics.push(sema_error("E0956", span, "`{name}` holds a compiler value (`{held}`), which exists only while compiling", "comptime code and `build: fn` read compiler values; the running program has no compiler to answer them", "compute the plain value you need (a Bool, number or String) inside a `#run` block and read that at runtime"))
}

sema_call_compiler_value_owner: fn(ty: Type) -> String? {
    if ty == {
        .Tagged(_, inner) -> return sema_call_compiler_value_owner(inner)
        .Named(name) | .Apply(name, _) -> { return Val(symbol_key_leaf(name)) }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    None
}

sema_call_compiler_value_expected_args: fn(owner: String, method: String) -> Int? {
    if owner == "ProgramInfo" {
        if method == "types" || method == "functions" || method == "traits" || method == "constants" || method == "packages" || method == "foreign" || method == "definitions" || method == "references" || method == "call_edges" || method == "structural_nodes" || method == "revision" || method == "complete" {
            return Val(0)
        }
    }
    if owner == "FunctionInfo" && method == "reaches_panic" -> return Val(0)
    if owner == "EffectInfo" && method == "has" -> return Val(1)
    if owner == "CompilerLexed" {
        if method == "source" || method == "tokens" || method == "diagnostics" -> return Val(0)
    }
    if owner == "CompilerSyntaxTree" {
        if method == "source" || method == "items" || method == "diagnostics" -> return Val(0)
    }
    if owner == "CompilerChecked" {
        if method == "source" || method == "syntax" || method == "diagnostics" || method == "functions" || method == "effects" || method == "semantic_index" {
            return Val(0)
        }
    }
    if owner == "CompilerSourceMap" {
        if method == "sources" || method == "generated_lines" -> return Val(0)
    }
    if owner == "CompilerPackageError" {
        if method == "code" || method == "message" || method == "file" || method == "cause" {
            return Val(0)
        }
    }
    if owner == "CompilerDependency" {
        if method == "name" || method == "source" -> return Val(0)
    }
    if owner == "CompilerPackageTarget" {
        if method == "name" || method == "targets" -> return Val(0)
    }
    if owner == "CompilerPackageOutput" {
        if method == "name" || method == "kind" || method == "entry" -> return Val(0)
    }
    if owner == "CompilerBuildProfile" {
        if method == "name" || method == "optimize" || method == "debug_info" || method == "small" || method == "panic" {
            return Val(0)
        }
    }
    if owner == "CompilerManifest" || owner == "CompilerPackage" {
        if method == "schema_version" || method == "file" || method == "jet" || method == "edition" || method == "description" || method == "license" || method == "repository" || method == "layer" || method == "target" || method == "dependencies" || method == "packages" || method == "outputs" || method == "build_profiles" {
            return Val(0)
        }
    }
    if owner == "CompilerLockedPackage" {
        if method == "name" || method == "version" || method == "source_kind" || method == "fingerprint" || method == "source" || method == "revision" || method == "content_hash" || method == "layer" || method == "inferred_layer" || method == "dependencies" {
            return Val(0)
        }
    }
    if owner == "CompilerLock" {
        if method == "schema_version" || method == "version" || method == "file" || method == "root_dependencies" || method == "packages" {
            return Val(0)
        }
    }
    if owner == "CompilerKeyValue" {
        if method == "key" || method == "value" -> return Val(0)
    }
    if owner == "CompilerProfile" {
        if method == "name" || method == "extends" || method == "packages" || method == "sources" || method == "collisions" {
            return Val(0)
        }
    }
    if owner == "CompilerProfileSet" {
        if method == "schema_version" || method == "file" || method == "profiles" -> return Val(0)
    }
    None
}

sema_call_compiler_value_string_list: fn() -> Type Never! { Type.List{element: Type.String} }

sema_call_compiler_value_method_type: fn(owner: String, method: String) -> Type? {
    if owner == "ProgramInfo" {
        if method == "types" -> return Val(Type.List{element: Type.Named{name: "TypeInfo"}})
        if method == "functions" -> return Val(Type.List{element: Type.Named{name: "FunctionInfo"}})
        if method == "traits" -> return Val(Type.List{element: Type.Named{name: "TraitInfo"}})
        if method == "constants" -> return Val(Type.List{element: Type.Named{name: "ConstantInfo"}})
        if method == "packages" -> return Val(Type.List{element: Type.Named{name: "PackageInfo"}})
        if method == "foreign" -> return Val(Type.List{element: Type.Named{name: "ForeignInfo"}})
        if method == "definitions" {
            return Val(Type.List{element: Type.Named{name: "CompilerDefinition"}})
        }
        if method == "references" {
            return Val(Type.List{element: Type.Named{name: "CompilerReference"}})
        }
        if method == "call_edges" {
            return Val(Type.List{element: Type.Named{name: "CompilerCall"}})
        }
        if method == "structural_nodes" {
            return Val(Type.List{element: Type.Named{name: "CompilerStructuralNode"}})
        }
        if method == "revision" -> return Val(Type.String)
        if method == "complete" -> return Val(Type.Bool)
    }
    if owner == "FunctionInfo" && method == "reaches_panic" -> return Val(Type.Bool)
    if owner == "EffectInfo" && method == "has" -> return Val(Type.Bool)
    if owner == "CompilerLexed" {
        if method == "source" -> return Val(Type.String)
        if method == "tokens" -> return Val(Type.List{element: Type.Named{name: "CompilerToken"}})
        if method == "diagnostics" {
            return Val(Type.List{element: Type.Named{name: "CompilerDiagnostic"}})
        }
    }
    if owner == "CompilerSyntaxTree" {
        if method == "source" -> return Val(Type.String)
        if method == "items" -> return Val(Type.List{element: Type.Named{name: "CompilerNode"}})
        if method == "diagnostics" {
            return Val(Type.List{element: Type.Named{name: "CompilerDiagnostic"}})
        }
    }
    if owner == "CompilerChecked" {
        if method == "source" -> return Val(Type.String)
        if method == "syntax" -> return Val(Type.Named{name: "CompilerSyntaxTree"})
        if method == "diagnostics" {
            return Val(Type.List{element: Type.Named{name: "CompilerDiagnostic"}})
        }
        if method == "functions" -> return Val(Type.List{element: Type.Named{name: "FunctionInfo"}})
        if method == "effects" -> return Val(Type.List{element: Type.Named{name: "EffectInfo"}})
        if method == "semantic_index" {
            return Val(Type.Option{inner: Type.Named{name: "CompilerSemanticIndex"}})
        }
    }
    if owner == "CompilerSourceMap" {
        if method == "sources" -> return Val(sema_call_compiler_value_string_list())
        if method == "generated_lines" {
            return Val(Type.List{element: Type.Named{name: "CompilerGeneratedLine"}})
        }
    }
    if owner == "CompilerPackageError" {
        if method == "code" || method == "message" || method == "file" || method == "cause" {
            return Val(Type.String)
        }
    }
    if owner == "CompilerDependency" {
        if method == "name" || method == "source" -> return Val(Type.String)
    }
    if owner == "CompilerPackageTarget" {
        if method == "name" -> return Val(Type.String)
        if method == "targets" -> return Val(sema_call_compiler_value_string_list())
    }
    if owner == "CompilerPackageOutput" {
        if method == "name" || method == "kind" -> return Val(Type.String)
        if method == "entry" -> return Val(Type.Option{inner: Type.String})
    }
    if owner == "CompilerBuildProfile" {
        if method == "name" || method == "optimize" -> return Val(Type.String)
        if method == "debug_info" || method == "small" -> return Val(Type.Bool)
        if method == "panic" -> return Val(Type.Option{inner: Type.String})
    }
    if owner == "CompilerManifest" || owner == "CompilerPackage" {
        if method == "schema_version" -> return Val(Type.Int)
        if method == "file" || method == "jet" || method == "edition" || method == "description" || method == "license" || method == "repository" || method == "layer" || method == "target" {
            return Val(if method == "file" -> Type.String else -> Type.Option{inner: Type.String})
        }
        if method == "dependencies" {
            return Val(Type.List{element: Type.Named{name: "CompilerDependency"}})
        }
        if method == "packages" {
            return Val(Type.List{element: Type.Named{name: "CompilerPackageTarget"}})
        }
        if method == "outputs" {
            return Val(Type.List{element: Type.Named{name: "CompilerPackageOutput"}})
        }
        if method == "build_profiles" {
            return Val(Type.List{element: Type.Named{name: "CompilerBuildProfile"}})
        }
    }
    if owner == "CompilerLockedPackage" {
        if method == "name" || method == "version" || method == "source_kind" || method == "fingerprint" {
            return Val(Type.String)
        }
        if method == "source" || method == "revision" || method == "content_hash" || method == "layer" || method == "inferred_layer" {
            return Val(Type.Option{inner: Type.String})
        }
        if method == "dependencies" -> return Val(sema_call_compiler_value_string_list())
    }
    if owner == "CompilerLock" {
        if method == "schema_version" || method == "version" -> return Val(Type.Int)
        if method == "file" -> return Val(Type.String)
        if method == "root_dependencies" -> return Val(sema_call_compiler_value_string_list())
        if method == "packages" {
            return Val(Type.List{element: Type.Named{name: "CompilerLockedPackage"}})
        }
    }
    if owner == "CompilerKeyValue" {
        if method == "key" || method == "value" -> return Val(Type.String)
    }
    if owner == "CompilerProfile" {
        if method == "name" -> return Val(Type.String)
        if method == "extends" || method == "packages" || method == "sources" {
            return Val(sema_call_compiler_value_string_list())
        }
        if method == "collisions" {
            return Val(Type.List{element: Type.Named{name: "CompilerKeyValue"}})
        }
    }
    if owner == "CompilerProfileSet" {
        if method == "schema_version" -> return Val(Type.Int)
        if method == "file" -> return Val(Type.String)
        if method == "profiles" {
            return Val(Type.List{element: Type.Named{name: "CompilerProfile"}})
        }
    }
    None
}

sema_call_try_compiler_value_method: fn(
    receiver: Expr,
    receiver_value: TExpr,
    method: String,
    args: [CallArg],
    span: Span,
    expected: Type?,
    environment: SemaScopeEnvironment,
    program: SemaProgramTables,
    scopes: ^SemaScopeTable,
    check: ^SemaBodyCheck,
) -> SemaMethodSpecialCheck {
    owner: sema_call_compiler_value_owner(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    expected_args: sema_call_compiler_value_expected_args(owner, method) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != expected_args {
        loop argument in args {
            _ := sema_check_expression(argument.expr, None, environment, program, scopes, check)
        }
        if !sema_ownership_check_call_receiver(check.state, receiver, AccessConvention.Read, scopes, span, check.diagnostics) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        check.diagnostics.push(sema_error("E0104", span, "`{owner}.{method}` expects {expected_args} argument{if expected_args == 1 -> "" else -> "s"}, got {args.len()}", "compiler query values expose fixed read-only projections", "call the compiler value method with its declared arguments"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    params := [SemaCallParam]{}
    if expected_args == 1 {
        params.push(SemaCallParam{label: "name", name: "name", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.String), variadic: false})
    }
    checked_args := args
    typed_values := [TExpr]{}
    if expected_args > 0 {
        binding: sema_call_bind_args("{owner}.{method}", params, checked_args, span, check.diagnostics) ?? {
            loop argument in checked_args {
                _ := sema_check_expression(argument.expr, None, environment, program, scopes, check)
            }
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        typed: sema_call_typecheck_bound_arguments("{owner}.{method}", params, None, false, binding, checked_args, environment, program, scopes, check, span, true) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        typed_values = typed.values
    }
    ownership := sema_ownership_check_method_call(check.state, "{owner}.{method}", receiver, AccessConvention.Read, params, checked_args, scopes, span, check.diagnostics)
    if !ownership.accepted || !ownership.complete {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_effect_record_intrinsic_effects(environment, program, scopes, check.context, "{owner}.{method}", span, [EffectRowEntry]{}, check.diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    result_type: sema_call_compiler_value_method_type(owner, method) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tree_node(result_type, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: method, args: typed_values}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, check.diagnostics)}
}
