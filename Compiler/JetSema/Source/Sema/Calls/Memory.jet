// Compiler-owned allocator and SharedGuard operations. Ordinary Shared/Cell
// access remains in Methods.jet; this file owns only allocation and projected
// guard capabilities.
use jet_foundation.[
    IR_RUNTIME_HANDLES,
    BodyHandleOp,
    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    InternalTag,
    NodeKind,
    ParamZone,
    Span,
    Symbol,
    SymbolID,
    SymbolKind,
    TAllocCtor,
    TFieldRef,
    TagMarker,
    Type,
    TypeTupleField,
    AST_EMPTY_CALL_ARG_FLAGS,
    expr_span,
    measure_literal_value,
    module_is_core,
    ir_runtime_handle_row,
]

// S58: an inert numeric address is a place operation, not a by-value
// forwarding function. Keep the caller's storage identity through the checked tree.
sema_call_memory_address_of: fn(args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if args.len() != 1 {
        check.diagnostics.push(sema_error("E0104", span, "`address_of` expects 1 argument, got {args.len()}", "an address names one value's storage", "pass the value whose address is needed"))
        sema_call_memory_discard_args(args, check)
        return None
    }
    if check.scopes.comptime_execution_depth > 0 {
        check.diagnostics.push(sema_error("E0956", span, "`core.mem.address_of` isn't supported by the current evaluator yet", "a `#run` block runs while compiling, where no value has a runtime address to bake into the program", "take the address in runtime code, outside the `#run` block"))
        sema_call_memory_discard_args(args, check)
        return None
    }
    value: sema_check_expression(args[0].expr, None, check) ?? return None
    sema_expr_expected_owned(sema_tree_node(Type.Int, TExprKind.RawAddressOf{place: TPlace.Expr{value: value}}, span), expected, check.environment.*, check.program.*, check.diagnostics)
}

// `mem.pin(place) -> Pin<T>` borrows the place in a write window
// typed `Pin<T>`; it never copies it. Pinning a place that already is a
// `Pin<T>` keeps that pin (no `Pin<Pin<T>>`). The binding's no-move view
// fact is recorded with the binding (sema_pin_record_binding).
sema_call_memory_pin: fn(args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if args.len() != 1 {
        check.diagnostics.push(sema_error("E0104", span, "`pin` expects 1 argument, got {args.len()}", "a pin names one storage location", "write `mem.pin(place)`"))
        sema_call_memory_discard_args(args, check)
        return None
    }
    argument: args[0]
    target: if argument.expr == {
        .Place(value, _, _, _) -> value
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> argument.expr
    }
    previous_root_read: check.context.suppress_partial_move_root_read
    check.context.suppress_partial_move_root_read = true
    checked_value: sema_check_expression(target, None, check)
    check.context.suppress_partial_move_root_read = previous_root_read
    checked: checked_value ?? return None
    if !sema_pin_check_call(args, check.diagnostics) -> return None
    if sema_pin_type(checked.ty) {
        return sema_expr_expected_owned(checked, expected, check.environment.*, check.program.*, check.diagnostics)
    }
    parameter: SemaCallParam{label: "place", name: "place", zone: ParamZone.Either, default: None, default_ref: None, convention: AccessConvention.Write, ty: Val(checked.ty), variadic: false}
    ^call_args: [CallArg]{argument}
    ownership: sema_ownership_check_call_arguments(check.state, "pin", [SemaCallParam]{parameter}, call_args, check.scopes, check.diagnostics)
    if !ownership.accepted -> return None
    pinned_ty: Type.Apply{name: "Pin", args: [Type]{checked.ty}}
    pinned: sema_tree_node(pinned_ty, TExprKind.Borrow{place: checked, access: AccessConvention.Write}, span)
    sema_expr_expected_owned(pinned, expected, check.environment.*, check.program.*, check.diagnostics)
}

// The Core identity of core.mem's Arena: `context.scratch`, the task's own
// arena, is a view of one.
SEMA_MEMORY_ARENA: "<corelib>/core.mem.Arena"

// The allocator family of `ty`, an allocator or an allocator view of one
// (`context.scratch`, a view of the task's arena, answers the same methods):
// the runtime type its handle row declares (`JetArena`, IR_RUNTIME_HANDLES)
// without the runtime's prefix, bare or by Core identity, as the IR names it
// (BuildRoutes.jet ir_allocator_family).
sema_call_memory_allocator_name: fn(ty: Type) -> String? {
    if ty == .Named(name) {
        row: ir_runtime_handle_row(name) ?? return None
        family: IR_RUNTIME_HANDLES[row].runtime.removeprefix("Jet")
        if family == "Arena" || family == "Bump" || family == "Pool" || family == "Fixed" {
            return Val(family)
        }
        return None
    }
    if ty == .Tagged(marker, inner) && marker == (TagMarker.Internal{internal_tag: InternalTag.AllocatorView}) {
        return sema_call_memory_allocator_name(inner)
    }
    return None
}

sema_call_memory_discard_args: fn(args: [CallArg], check: ^SemaBodyCheck) Never! {
    loop argument in args -> ^_: sema_check_expression(argument.expr, None, check)
}

sema_call_memory_call_arg: fn(argument: CallArg, value: TExpr, borrow: Bool, mut_borrow: Bool) -> TCallArg Never! {
    ^label: if argument.label == {
        .Val(found) -> Val(found.name)
        .None -> None
    }
    return TCallArg{
        value: value,
        template_items: [SymbolID]{},
        borrow: borrow,
        mut_borrow: mut_borrow,
        fn_coerce: None,
        widen_to_vec: false,
        widen_to_union: None,
        box_as_trait: None,
        label: label,
        spread: argument.spread,
    }
}

sema_call_memory_static_arity: fn(method: String, over: Bool, args: [CallArg], span: Span, check: ^SemaBodyCheck) -> Bool {
    if args.len() == 1 -> return true
    ^fix: if over -> "write `mem.Fixed.over(bytes)`" else -> "write `mem.Fixed.new(size: N)`"
    check.diagnostics.push(sema_error("E0103", span, "`Fixed.{method}` has the wrong number of arguments", "a fixed allocator needs one size or backing buffer", fix))
    sema_call_memory_discard_args(args, check)
    return false
}

sema_call_memory_compiletime_int: fn(expression: Expr, checked: TExpr, check: SemaBodyCheck) -> Int? {
    comptime_value: sema_expr_comptime_value(checked, check.context)
    if comptime_value == .Val(value) {
        number: if value == {
            .Int(number) -> Val(number)
            .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Function(_) -> None
        }
        if number != None -> return number
    }
    return if expression == {
        .ComptimeName(_, _, value, _) -> if value == .Val(inner) && inner == .Int(number) -> Val(number) else -> None
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(check.scopes, name) ?? return None
            ^symbol: check.scopes.bindings[index].symbol
            if symbol.kind != SymbolKind.Constant -> return None
            declaration: sema_scope_resolve_declaration(check.environment.*, check.program.*, symbol.id) ?? return None
            if declaration == .Const(definition) && definition.ct == .Val(inner) && inner == .Int(number) -> Val(number) else -> None
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// True when a `Fixed.new` size reads a parameter or local binding, whose value
// exists only at run time.
sema_call_memory_reads_runtime_local: fn(expression: Expr, scopes: SemaScopeTable) -> Bool Never! {
    ^names: [String]{}
    sema_function_memory_collect_expr_idents(expression, names)
    loop name in names {
        index: sema_scope_resolve_index(scopes, name) ?? next
        kind: scopes.bindings[index].symbol.kind
        if kind == SymbolKind.Parameter || kind == SymbolKind.Local -> return true
    }
    return false
}

sema_call_memory_check_fixed_buffer: fn(argument: CallArg, value: TExpr, check: ^SemaBodyCheck) -> Bool {
    ^fixed_bytes: if value.ty == {
        .FixedList(element, length) -> element == Type.IntN{signed: false, bits: 8} && (measure_literal_value(length) ?? 0) > 0
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
    ^direct_expr: if argument.expr == {
        .Ident(_, _, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
    // `over`'s parameter is a write window, so the
    // buffer's name passed plain is that window.
    ^direct_write: argument.convention != AccessConvention.Move && direct_expr
    if !fixed_bytes || !direct_write {
        check.diagnostics.push(sema_error("E0103", argument.span, "`Fixed.over` needs one mutable fixed-size byte buffer", "the allocator exclusively borrows that exact inline buffer until the Fixed handle is closed", "bind `[Byte#N]` storage to a `^` name, then write `fixed: mem.Fixed.over(storage)`"))
        return false
    }
    ^parameter: SemaCallParam{label: "buffer", name: "buffer", zone: ParamZone.Either, default: None, default_ref: None, convention: AccessConvention.Write, ty: Val(value.ty), variadic: false}
    ^call_args: [CallArg]{argument}
    ^ownership: sema_ownership_check_call_arguments(check.state, "Fixed.over", [SemaCallParam]{parameter}, call_args, check.scopes, check.diagnostics)
    return ownership.accepted && ownership.complete
}

// The roles of the core.mem declarations (Core/Mem/Mem.jet) the compiler
// builds where their call stands, each on the caller's own storage: the
// `address_of` and `pin` functions, and Fixed's two constructors.
SEMA_CORE_ROLE_MEM_ADDRESS_OF: "MemAddressOf"

SEMA_CORE_ROLE_MEM_PIN: "MemPin"

SEMA_CORE_ROLE_FIXED_FRAME: "FixedFrame"

SEMA_CORE_ROLE_FIXED_OVER: "FixedOver"

// A call through its Core module of `target`, when `target` fills the
// MemAddressOf or MemPin role: a place operation on the caller's own
// storage, checked before any argument is. Every route that calls a Core
// module's function (`mem.address_of(place)`, `mem.pin(place)`) asks here
// once it resolves the declaration, before it checks the call's arguments.
sema_call_try_memory_place: fn(target: SemaCallDirectTarget, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    role: sema_core_symbol_role(check.program.registration_graph, target.symbol)
    if role == SEMA_CORE_ROLE_MEM_PIN {
        return SemaMethodSpecialCheck{handled: true, value: sema_call_memory_pin(args, span, expected, check)}
    }
    if role == SEMA_CORE_ROLE_MEM_ADDRESS_OF {
        return SemaMethodSpecialCheck{handled: true, value: sema_call_memory_address_of(args, span, expected, check)}
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}

// Whether `target` fills the MemAddressOf or MemPin role. Its call is a place
// operation only through its module (sema_call_try_memory_place).
sema_call_memory_place_target: fn(target: SemaCallDirectTarget, check: SemaBodyCheck) -> Bool {
    role: sema_core_symbol_role(check.program.registration_graph, target.symbol)
    role == SEMA_CORE_ROLE_MEM_ADDRESS_OF || role == SEMA_CORE_ROLE_MEM_PIN
}

// The role of the Core static that `receiver.method` calls (`mem.Fixed.new`
// fills FixedFrame), or "" when it calls none that fills a role.
sema_call_memory_static_role: fn(receiver: Expr, method: String, check: SemaBodyCheck) -> String {
    owner: sema_call_static_source_owner(receiver, method, [Type]{}, check) ?? return ""
    if owner.symbol.kind != SymbolKind.Type || !module_is_core(owner.symbol.module_identity) -> return ""
    graph: check.program.registration_graph
    row: sema_type_graph_nominal_row(graph, owner.symbol.id) ?? return ""
    sema_core_method_role(graph, row, method)
}

// Whether `receiver.method` calls one of Fixed's constructors.
sema_call_memory_fixed_constructor: fn(receiver: Expr, method: String, check: SemaBodyCheck) -> Bool {
    role: sema_call_memory_static_role(receiver, method, check)
    role == SEMA_CORE_ROLE_FIXED_FRAME || role == SEMA_CORE_ROLE_FIXED_OVER
}

// A static call of `method` on the type `owner` names. When the method is one
// of Fixed's constructors, the call works in the caller's frame: FixedFrame
// takes `size` bytes of it, a positive compile-time count, and FixedOver
// borrows a mutable `[Byte#N]` buffer of it. Either must directly initialize
// a lexical binding. Every static call passes here first, so a binding's
// permission covers its own initializer only, never a constructor nested in
// its arguments.
sema_call_try_memory_fixed: fn(owner: Symbol, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    fixed_allowed: check.context.allow_fixed_constructor
    check.context.allow_fixed_constructor = false
    unhandled: SemaMethodSpecialCheck{handled: false, value: None}
    if !module_is_core(owner.module_identity) -> return unhandled
    graph: check.program.registration_graph
    row: sema_type_graph_nominal_row(graph, owner.id) ?? return unhandled
    role: sema_core_method_role(graph, row, method)
    over: role == SEMA_CORE_ROLE_FIXED_OVER
    if !over && role != SEMA_CORE_ROLE_FIXED_FRAME -> return unhandled
    if !fixed_allowed {
        check.diagnostics.push(sema_error("E0103", span, "`Fixed.{method}` must directly initialize a lexical binding", "the Fixed handle borrows inline storage whose lifetime and drop order are fixed at its declaration", "write `fixed: mem.Fixed.{method}(…)`"))
    }
    if !sema_call_memory_static_arity(method, over, args, span, check) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    argument: args[0]
    required: if over -> None else -> Val(Type.Int)
    checked: sema_check_expression(argument.expr, required, check) ?? return rejected
    if over && !sema_call_memory_check_fixed_buffer(argument, checked, check) -> return rejected
    ^constructor: TAllocCtor.FixedOver
    ^tree_value: checked
    if !over {
        size: sema_call_memory_fixed_size(argument, checked, span, check) ?? return rejected
        constructor = TAllocCtor.Fixed{size: size}
        tree_value = sema_expr_unbounded_integer_literal(size, argument.span)
    }
    tree_args: [TCallArg]{sema_call_memory_call_arg(argument, tree_value, over, over)}
    // The handle has the Core declaration's own type (`<corelib>/core.mem.Fixed`),
    // which its runtime handle row is keyed by.
    module_row: graph.modules[row.module_index]
    fixed_ty: Type.Named{name: sema_checked_nominal_key(graph, module_row, module_row.nominals[row.row])}
    value: sema_tree_node(fixed_ty, TExprKind.AllocNew{ctor: constructor, args: tree_args}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// The byte size of `Fixed.new(size)`, whose argument `argument` is checked as
// `checked`: a positive compile-time Int, else E0103. None too while body-level
// comptime staging has yet to resolve it.
sema_call_memory_fixed_size: fn(argument: CallArg, checked: TExpr, span: Span, check: ^SemaBodyCheck) -> Int? {
    refused: sema_error("E0103", argument.span, "`Fixed.new` needs a positive compile-time byte size", "runtime-sized storage cannot become an inline fixed array in the current stack frame", "use a positive literal or comptime integer, e.g. `mem.Fixed.new(size: 4096)`")
    ^size_value: sema_call_memory_compiletime_int(argument.expr, checked, check)
    if size_value == None && sema_call_memory_reads_runtime_local(argument.expr, check.scopes) {
        check.diagnostics.push(refused)
        return None
    }
    if size_value == None {
        staged: sema_comptime_body_value_find(check.context, check.environment.module_identity, sema_scope_function_owner_key(check.scopes), argument.span, span) ?? {
            ^_: sema_comptime_body_capture(check.context, check.environment.*, check.program.*, check.scopes, "Fixed.new size", argument.expr, Type.Int, argument.span, span)
            return None
        }
        size_value = if staged.value == {
            .Int(number) -> if staged.ty == Type.Int -> Val(number) else -> None
            .Float(_, _) | .Bool(_) | .Char(_) | .String(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Function(_) -> None
        }
    }
    // Body-level comptime staging owns unresolved values; only a resolved value can be validated here.
    size: size_value ?? 0
    if size <= 0 {
        check.diagnostics.push(refused)
        return None
    }
    Val(size)
}

sema_call_memory_record_allocator_effect: fn(name: String, method: String, result_type: Type, span: Span, check: ^SemaBodyCheck) -> Bool Never! {
    ^row: [EffectRowEntry]{EffectRowEntry{name: "Mem", span: span}}
    sema_effect_record_intrinsic_fact(
        check.environment.*,
        check.program.*,
        check.scopes,
        check.context,
        "{name}.{method}",
        span,
        SemaCallFacts{
            return_type: result_type,
            failure_carrier: sema_expression_failure_carrier(result_type),
            effect_bound: Val(row),
            type_args: [Type]{},
            default_refs: [FunctionDefaultRef]{},
        },
        check.diagnostics,
    )
}

sema_call_memory_allocator_method: fn(receiver: Expr, receiver_value: TExpr, name: String, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    ^updated_args: args
    if method != "alloc" && method != "try_alloc" && method != "reset" {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    ^expected_arity: if method == "reset" -> 0 else -> 1
    if updated_args.len() != expected_arity {
        check.diagnostics.push(sema_error("E0103", span, "`{name}.{method}` takes {expected_arity} argument{if expected_arity == 1 -> "" else -> "s"}", if method == "reset" -> "reset clears all allocations, keeping the backing buffer" else -> "pass the value you want to store in the allocator", if method == "reset" -> "write `{name}.reset()`" else -> "write `{name}.{method}(my_value)`"))
        sema_call_memory_discard_args(updated_args, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if method == "reset" {
        // An allocator's storage is the runtime's audited interior-mutable
        // storage, so `arena.reset()` runs no write-capability gate (a `:` arena
        // resets) and invalidates the arena's views below instead of refusing
        // them. Only `Fixed` refuses while a view of its owner is live.
        sema_ownership_note_call_receiver(check.state, receiver, AccessConvention.Write)
        if sema_ownership_block_allocator_refuses(check.state, sema_ownership_places_from_expr_in_state(receiver, check.scopes, check.state), "be reset", span, check.diagnostics) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        if name == "Fixed" && !sema_ownership_check_write_change(check.state, receiver, "be reset", check.scopes, check.diagnostics) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        ^result_type: Type.Named{name: "Unit"}
        if !sema_call_memory_record_allocator_effect(name, method, result_type, span, check) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        ^receiver_is_ident: if receiver == {
            .Ident(_, _, _) -> true
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
        }
        // A reset of the task's scratch arena, through `context.scratch` or a
        // variable bound to it, ends the views of the values its `alloc`
        // made; the arena, and so the variable, stays usable.
        if sema_ownership_scratch_arena(check.state, receiver, check.scopes) {
            sema_ownership_invalidate_view_owner(check.state, sema_ownership_scratch_place(span), "reset", span)
        } else if receiver_is_ident {
            ^places: sema_ownership_places_from_expr_in_state(receiver, check.scopes, check.state)
            loop place in places {
                sema_ownership_invalidate_view_owner(check.state, place, "reset", span)
            }
        }
        ^value: sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: BodyHandleOp.AllocReset, args: [TExpr]{}}, span)
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
    }
    payload: sema_check_expression(updated_args[0].expr, None, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    ^parameter: SemaCallParam{label: "value", name: "value", zone: ParamZone.Either, default: None, default_ref: None, convention: AccessConvention.Move, ty: Val(payload.ty), variadic: false}
    // `arena.alloc(v)` records no receiver write: it reads the allocator
    // handle (only `reset` writes it). On an allocator name that read is no
    // place read, so the arena's own views never meet it; the name's moves were
    // checked when it was read (sema_ownership_check_root_base_use).
    ^ownership: if receiver == .Ident(_, _, _) -> sema_ownership_check_allocator_handle_call(check, "{name}.{method}", receiver, [SemaCallParam]{parameter}, updated_args, span) else -> sema_ownership_check_method_call(check, "{name}.{method}", receiver, AccessConvention.Read, [SemaCallParam]{parameter}, updated_args, span)
    if !ownership.accepted || !ownership.complete {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    ^view: Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.AllocatorView}, inner: payload.ty}
    ^result: if method == "try_alloc" -> Type.Result{ok: view, err: Type.Named{name: "AllocError"}} else -> view
    ^operation: if method == "try_alloc" -> BodyHandleOp.AllocTryAlloc else -> BodyHandleOp.AllocAlloc
    if !sema_call_memory_record_allocator_effect(name, method, result, span, check) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    ^value: sema_tree_node(result, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{payload}}, span)
    return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

SemaCallMemoryGuard: struct {
    value_type: Type,
    marker: TagMarker,
    editable: Bool,
}

sema_call_memory_guard_shape: fn(receiver: Expr, ty: Type, scopes: SemaScopeTable) -> SemaCallMemoryGuard? {
    ^marker: TagMarker?{None}
    ^inner: Type?{None}
    ^editable: false
    if ty == {
        .Tagged(found_marker, value) -> {
            if found_marker == (TagMarker.Internal{internal_tag: InternalTag.SharedGuardRead}) || found_marker == (TagMarker.Internal{internal_tag: InternalTag.SharedGuardEdit}) {
                marker = Val(found_marker)
                inner = Val(value)
                editable = found_marker == TagMarker.Internal{internal_tag: InternalTag.SharedGuardEdit}
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            inner = Val(ty)
            if receiver == .Ident(name, _, _) {
                index: sema_scope_resolve_index(scopes, name)
                if index != None {
                    ^binding: scopes.bindings[index]
                    editable = binding.symbol.kind == SymbolKind.Parameter && binding.access == AccessConvention.Write
                }
            }
            marker = Val(TagMarker.Internal{internal_tag: if editable -> InternalTag.SharedGuardEdit else -> InternalTag.SharedGuardRead})
        }
    }
    guard_type: inner ?? return None
    if guard_type == .Apply(name, args) && name == "SharedGuard" && args.len() == 1 {
        return Val(SemaCallMemoryGuard{value_type: args[0], marker: marker ?? TagMarker.Internal{internal_tag: InternalTag.SharedGuardRead}, editable: editable})
    }
    return None
}

sema_call_memory_guard_ast_projection: fn(expression: Expr) -> [String]? {
    if expression == .Lambda(lambda, _) {
        if lambda.params.len() != 1 -> return None
        // A braced body counts when its only line is the expression.
        body_value: if lambda.body == {
            .Expr(value) -> Val(value)
            .Block(statements) -> if statements.len() == 1 && statements[0] == .Expr(value) -> Val(value) else -> None
        }
        ^body: body_value ?? return None
        ^fields: [String]{}
        loop {
            if body == {
                .Field(base, member, _, _) -> {
                    fields.push(member)
                    body = base
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> break
            }
        }
        ^parameter_match: if body == {
            .Ident(name, _, _) -> name == lambda.params[0].name
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
        }
        if fields.len() == 0 || !parameter_match -> return None
        fields.reverse()
        return Val(fields)
    }
    None
}

sema_call_memory_guard_tree_projection: fn(value: TExpr, parameter: String) -> [TFieldRef]? {
    // A braced body's only line is checked into its return.
    ^body_value: TExpr?{None}
    if value.kind == .Lambda(lambda) {
        body_value = if lambda.executable == {
            .Expr(found) -> Val(found)
            .Block(statements) -> if statements.len() == 1 && statements[0] == .Return(returned, _) -> returned else -> None
        }
    }
    ^body: body_value ?? return None
    ^fields: [TFieldRef]{}
    loop {
        if body.kind == {
            .Field(base, reference) -> {
                fields.push(reference)
                body = base
            }
            .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> break
        }
    }
    ^parameter_match: if body.kind == {
        .Local(local) -> local.name == parameter
        .IntLit(_, _) | .StrLit(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> false
    }
    if fields.len() == 0 || !parameter_match -> return None
    fields.reverse()
    return Val(fields)
}

sema_call_memory_guard_projection_stored: fn(path: [TFieldRef], check: SemaBodyCheck) -> Bool Never! {
    loop reference in path {
        if reference.owner == .Val(owner) {
            declaration: sema_scope_resolve_declaration(check.environment.*, check.program.*, owner)
            if declaration == .Val(item) && item == .Struct(definition) {
                loop field in definition.fields {
                    if field.name == reference.name && field.computed != None -> return false
                }
            }
        }
    }
    return true
}

sema_call_memory_guard_paths_overlap: fn(first: [TFieldRef], second: [TFieldRef]) -> Bool Never! {
    ^shortest: if first.len() < second.len() -> first.len() else -> second.len()
    if shortest == 0 -> return true
    ^index: 0
    loop index < shortest {
        if first[index].name != second[index].name -> return false
        index += 1
    }
    return true
}

sema_call_memory_guard_check_lambda: fn(argument: CallArg, value_type: Type, return_type: Type?, editable: Bool, check: ^SemaBodyCheck) -> TExpr? {
    ^expected: Type.Fn{params: [Type]{value_type}, ret: return_type, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    if argument.expr == .Lambda(_, _) {
        return sema_expression_lambda_host_callback(argument.expr, Val(expected), editable, check)
    }
    _: sema_check_expression(argument.expr, None, check)
    check.diagnostics.push(sema_error("E0112", argument.span, "a SharedGuard operation needs a lambda", "the callback runs while the guard protects its value", "write a one-parameter lambda, such as `value -> value.field`"))
    return None
}

sema_call_memory_shared_guard_method: fn(receiver: Expr, receiver_value: TExpr, guard: SemaCallMemoryGuard, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if method != "map" && method != "split" && method != "wait" {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    ^wanted: if method == "split" || method == "wait" -> 2 else -> 1
    if args.len() != wanted {
        ^guidance: if {
            method == "map" -> "write `guard.map(fn(value) {{ value.field }})`"
            method == "split" -> "write `guard.split(fn(value) {{ value.left }}, fn(value) {{ value.right }})`"
            else -> "write `guard.wait(condition, fn(value) {{ predicate }})`"
        }
        check.diagnostics.push(sema_error("E0104", span, "`{method}` expects {wanted} argument{if wanted == 1 -> "" else -> "s"}, got {args.len()}", if method == "wait" -> "waiting needs one Condition and one predicate" else -> "projecting a guard needs the expected number of field closures", guidance))
        sema_call_memory_discard_args(args, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if method == "wait" {
        if !guard.editable {
            check.diagnostics.push(sema_error("E0205", span, "`SharedGuard.wait` needs an edit guard", "waiting releases and reacquires exclusive access before the predicate is checked again", "create this guard with `guard_edit()`"))
        }
        condition: sema_check_expression(args[0].expr, Val(Type.Named{name: "Condition"}), check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        predicate: sema_call_memory_guard_check_lambda(args[1], guard.value_type, Val(Type.Bool), false, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        if predicate.kind == .Lambda(lambda) {
            // `wait` records no receiver convention: the edit guard is required
            // (E0205 above), but the guard binding takes no `^` mark.
            if !sema_ownership_check_call_receiver(check, receiver, AccessConvention.Read, span) {
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            // Waiting blocks until a notify; it reads no clock.
            if !sema_effect_record_intrinsic_effects(check, "SharedGuard.wait", span, [EffectRowEntry]{EffectRowEntry{name: "Time.Wait", span: span}}) {
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            ^value: sema_tree_node(Type.Result{ok: Type.Named{name: "Unit"}, err: Type.String}, TExprKind.SharedGuardWait{guard: receiver_value, condition: condition, predicate: lambda}, span)
            return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
        }
        check.diagnostics.push(sema_error("E0112", args[1].span, "`SharedGuard.wait` predicate must be a lambda", "wait rechecks the predicate after each wake", "write `value -> predicate`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    ^paths: [[TFieldRef]?]{}
    ^values: [TExpr?]{}
    ^index: 0
    loop index < args.len() {
        ^projection: sema_call_memory_guard_ast_projection(args[index].expr)
        if projection != None {
            if args[index].expr == .Lambda(lambda, _) {
                ^updated_args: args
                ^updated_lambda: lambda
                updated_lambda.meta.guard_projection = projection
                updated_args[index].expr = Expr.Lambda{lambda: updated_lambda, id: AST_NODE_GENERATED}
            }
        }
        callback: sema_call_memory_guard_check_lambda(args[index], guard.value_type, None, guard.editable, check) ?? {
            paths.push(None)
            values.push(None)
            index += 1
            next
        }
        ^parameter_name: if args[index].expr == {
            .Lambda(lambda, _) -> lambda.params[0].name
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> ""
        }
        path: sema_call_memory_guard_tree_projection(callback, parameter_name)
        ^path_valid: path != None
        if path_valid {
            path_valid = sema_call_memory_guard_projection_stored(path ?? [TFieldRef]{}, check)
        }
        if !path_valid {
            check.diagnostics.push(sema_error("E0215", expr_span(args[index].expr), "`SharedGuard.{method}` needs a stored field projection", "a projected guard must keep a stable stored place inside the value protected by the original lock; computed fields are values, not places", "write a direct projection such as `guard.map(fn(value) {{ value.field }})`"))
        }
        paths.push(if path_valid -> path else -> None)
        values.push(Val(callback))
        index += 1
    }
    if method == "split" && paths.len() == 2 {
        first: paths[0] ?? [TFieldRef]{}
        second: paths[1] ?? [TFieldRef]{}
        if paths[0] == None || paths[1] == None || sema_call_memory_guard_paths_overlap(first, second) {
            check.diagnostics.push(sema_error("E0216", span, "`SharedGuard.split` needs two disjoint field projections", "two editable guards may never point at the same field or at an enclosing and nested field", "project sibling fields, such as `value.left` and `value.right`"))
            paths[0] = None
            paths[1] = None
        }
    }
    first_callback: values[0] ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if method == "map" {
        projection: paths[0] ?? return SemaMethodSpecialCheck{handled: true, value: None}
        if !sema_ownership_check_method_receiver(check, receiver, AccessConvention.Move, method, span) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        mapped_type: sema_call_signature_return(first_callback.ty) ?? Type.Named{name: "Unit"}
        ^mapped_guard: Type.Tagged{marker: guard.marker, inner: Type.Apply{name: "SharedGuard", args: [Type]{mapped_type}}}
        guard_row: sema_arena_adopt(check.context, receiver_value)
        ^value: sema_node(check.context, mapped_guard, NodeKind.SharedGuardMap{guard: guard_row, path: projection, editable: guard.editable}, span)
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
    }
    second_callback: values[1] ?? return SemaMethodSpecialCheck{handled: true, value: None}
    first_path: paths[0] ?? return SemaMethodSpecialCheck{handled: true, value: None}
    second_path: paths[1] ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_ownership_check_method_receiver(check, receiver, AccessConvention.Move, method, span) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    first_type: sema_call_signature_return(first_callback.ty) ?? Type.Named{name: "Unit"}
    second_type: sema_call_signature_return(second_callback.ty) ?? Type.Named{name: "Unit"}
    ^first_guard: Type.Tagged{marker: guard.marker, inner: Type.Apply{name: "SharedGuard", args: [Type]{first_type}}}
    ^second_guard: Type.Tagged{marker: guard.marker, inner: Type.Apply{name: "SharedGuard", args: [Type]{second_type}}}
    ^result_type: Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "first", ty: first_guard}, TypeTupleField{name: "second", ty: second_guard}}}
    guard_row: sema_arena_adopt(check.context, receiver_value)
    ^value: sema_node(check.context, result_type, NodeKind.SharedGuardSplit{guard: guard_row, first: first_path, second: second_path, editable: guard.editable}, span)
    return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

sema_call_try_memory_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    allocator: sema_call_memory_allocator_name(receiver_value.ty)
    if allocator != None {
        return sema_call_memory_allocator_method(receiver, receiver_value, allocator, method, args, span, expected, check)
    }
    step: sema_call_try_raw_pointer_step(receiver, receiver_value, method, args, span, expected, check)
    if step.handled -> return step
    guard: sema_call_memory_guard_shape(receiver, receiver_value.ty, check.scopes)
    if guard != None {
        return sema_call_memory_shared_guard_method(receiver, receiver_value, guard, method, args, span, expected, check)
    }
    // `Condition.notify_one()` and `.notify_all()` wake one or every waiter; the value is Unit.
    if receiver_value.ty == .Named(name) {
        if name == "Condition" && args.is_empty() && (method == "notify_one" || method == "notify_all") {
            condition_row: sema_arena_adopt(check.context, receiver_value)
            ^value: sema_node(check.context, Type.Named{name: "Unit"}, NodeKind.ConditionNotify{condition: condition_row, all: method == "notify_all"}, span)
            return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
        }
    }
    sema_call_try_shared_owner_method(receiver, receiver_value, method, args, span, expected, check)
}

// `p.offset(n)` / `p.byte_offset(n)` on a raw pointer `*T`: the pointer `n`
// elements (at T's List stride) or `n` bytes on, of the same type. A step
// can leave the storage `p` names, so it is E3101 outside `#Unsafe`; the
// sentry checks the new pointer where it is read or written. The method is
// checked as a call of the core.mem function that fills the InlinePtrOffset
// / InlinePtrByteOffset role, which the compiler builds inline.
sema_call_try_raw_pointer_step: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    unhandled: SemaMethodSpecialCheck{handled: false, value: None}
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    role: if method == {
        "offset" -> "InlinePtrOffset"
        "byte_offset" -> "InlinePtrByteOffset"
        else -> {
            return unhandled
        }
    }
    receiver_type: sema_expr_unwrap_tag(receiver_value.ty)
    ^element_args: [Type]{}
    if receiver_type.move() == .Apply(name, type_args) {
        if name != "Ptr" || type_args.len() != 1 -> return unhandled
        element_args = type_args
    } else { return unhandled }
    if !sema_expr_require_unsafe(method, span, check) -> return rejected
    if args.len() != 1 {
        check.diagnostics.push(sema_call_arity_diagnostic(method, 1, args.len(), false, span))
        return rejected
    }
    if sema_call_core_module_identity(check.environment.*, check.program.*, "core.mem") == None {
        check.diagnostics.push(sema_error("E3102", span, "`{method}` on a raw pointer is part of the low-level tier", "stepping a `Ptr` needs the discovery gate", "add `use core.mem;`"))
        return rejected
    }
    graph: check.program.registration_graph
    filler: sema_core_role_function(graph, role) ?? {
        check.diagnostics.push(sema_missing_core_role(role, span))
        return rejected
    }
    target: sema_call_core_source_target(check.environment.*, check.program.*, filler.module_identity, filler.name, element_args, span, true, check.diagnostics) ?? return rejected
    ^call_args: [CallArg]{CallArg{convention: AccessConvention.Read, expr: receiver, span: expr_span(receiver), flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}}
    loop argument in args -> call_args.push(argument.copy())
    check.scopes.ownership_call_depth += 1
    ^value: sema_call_core_check_source_owned(target, method, element_args, call_args, span, expected, check)
    check.scopes.ownership_call_depth -= 1
    SemaMethodSpecialCheck{handled: true, value: value}
}
