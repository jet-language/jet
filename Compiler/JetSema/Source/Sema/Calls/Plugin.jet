// A Plugin handle is statically identified by its Component's interface,
// which the driver read from the artifact itself. These bodies consume those
// immutable interface facts.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    ComponentSignatureDescriptor,
    CoreCallRecord,
    ComponentTypeDescriptor,
    ComponentTypeField,
    ParamZone,
    Span,
    TFailureCarrier,
    TTypeDef,
    Type,
    owned_trait_codec_names,
    type_name,
]

sema_plugin_loaded_type: fn(interface: SemaPluginInterface) -> Type Never! {
    Type.Apply{name: "Plugin", args: [Type]{Type.Named{name: interface.identity}}}
}

sema_plugin_load_type: fn(facts: SemaPluginInterfaceFacts, artifact: String) -> Type? {
    interface: sema_plugin_interface_by_artifact(facts, artifact) ?? return None
    Val(sema_plugin_loaded_type(interface))
}

// `core.plugin.load("artifact", authority)` with a literal artifact whose
// Component the compiler read is `Plugin<identity>`; any other load keeps
// the declared opaque `Plugin`, whose exports never resolve.
sema_call_core_plugin_load_type: fn(record: CoreCallRecord, values: [TExpr], declared: Type, program: SemaProgramTables) -> Type Never! {
    if record.module_name != "core.plugin" || record.member != "load" || values.len() == 0 -> return declared.copy()
    artifact: sema_plugin_literal_text(values[0]) ?? return declared.copy()
    if program.registration_graph == .Val(graph) {
        return sema_plugin_load_type(graph.plugin_facts, artifact) ?? declared.copy()
    }
    declared.copy()
}

sema_plugin_literal_text: fn(value: TExpr) -> String? {
    if value.kind == {
        .StrLit(parts) -> {
            text := ""
            loop part in parts {
                if part == {
                    .Literal(piece) -> text = "{text}{piece}"
                    .Interpolation(_, _) -> return None
                }
            }
            return Val(text)
        }
        .IntLit(_, _) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> return None
    }
}

// The compiler-owned plugin handle `ty` resolves to: `Plugin<identity>` gives
// its identity, and the opaque `Plugin` of a load whose artifact the compiler
// could not read gives "", which no interface carries.
sema_plugin_handle_identity: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> String? {
    resolved := sema_call_resolved_type(ty, environment, program)
    identity := if resolved == {
        .Apply(name, args) -> if {
            name == "Plugin" && args.len() == 1 -> {
                if args[0] == {
                    .Named(value) -> Val(value)
                    .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
                }
            }
            else -> None
        }
        .Named(name) -> if name == "Plugin" -> Val("") else -> None
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
    value: identity ?? return None
    if program.registration_graph == .Val(graph) {
        // A source declaration named Plugin is never the compiler-owned loader
        // handle, even if it happens to use the same type application spelling.
        if sema_type_resolve_nominal_row(graph, resolved, environment.module_identity) != None -> return None
        return Val(value)
    } else {
        return None
    }
}

sema_plugin_forbidden_component_name: fn(name: String) -> Bool Never! {
    name == "Dyn" || name == "JSON" || name == "Authority" || name == "Secret" || name == "Date" || name == "LocalDate" || name == "LocalTime" || name == "DateTime" || name == "Duration"
}

sema_plugin_checked_type_definition: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, nominal: SemaRegistrationNominal) -> TTypeDef? {
    row: sema_scope_checked_type_row(environment, program, nominal.symbol.module_name, nominal.symbol.name) ?? return None
    Val(program.checked_types[row])
}

sema_plugin_component_descriptor: fn(graph: SemaRegistrationGraph, environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type, seen: [String]) -> ComponentTypeDescriptor? {
    if ty == {
        .Int -> return Val(ComponentTypeDescriptor.Int)
        .Float -> return Val(ComponentTypeDescriptor.Float)
        .Bool -> return Val(ComponentTypeDescriptor.Bool)
        .String -> return Val(ComponentTypeDescriptor.String)
        .List(inner) -> return sema_plugin_component_descriptor(graph, environment, program, inner, seen).map(fn(value) { ComponentTypeDescriptor.List{inner: value} })
        .Option(inner) -> return sema_plugin_component_descriptor(graph, environment, program, inner, seen).map(fn(value) { ComponentTypeDescriptor.Option{inner: value} })
        .FixedList(inner, _) -> return sema_plugin_component_descriptor(graph, environment, program, inner, seen).map(fn(value) { ComponentTypeDescriptor.List{inner: value} })
        .InlineRange(inner, _, _) | .Tagged(_, inner) -> return sema_plugin_component_descriptor(graph, environment, program, inner, seen)
        .Result(ok, err) -> {
            ok_descriptor: sema_plugin_component_descriptor(graph, environment, program, ok, seen) ?? return None
            err_descriptor: sema_plugin_component_descriptor(graph, environment, program, err, seen) ?? return None
            return Val(ComponentTypeDescriptor.Result{ok: ok_descriptor, err: err_descriptor})
        }
        .Named(name) | .Apply(name, _) -> {
            if sema_plugin_forbidden_component_name(name) -> return None
            loop codec in owned_trait_codec_names() {
                if sema_type_bound_satisfied(graph, ty, codec, environment.module_identity) != (Val(true)) -> return None
            }
            nominal_row: sema_type_resolve_nominal_row(graph, ty, environment.module_identity) ?? return None
            nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
            definition: sema_plugin_checked_type_definition(environment, program, nominal) ?? return None
            type_args := if ty == {
                .Apply(_, args) -> args
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> [Type]{}
            }
            if type_args.len() != definition.generic_params.len() -> return None
            key := "{nominal.symbol.id.key}|{type_name(ty)}"
            loop prior in seen {
                if prior == key -> return None
            }
            next_seen := seen
            next_seen.push(key)
            generic_names := (loop parameter in definition.generic_params -> parameter.name)
            if definition.kind == {
                .Alias(target) -> {
                    specialized := sema_inference_substitute_type(target, generic_names, type_args)
                    return sema_plugin_component_descriptor(graph, environment, program, specialized, next_seen)
                }
                .Struct(fields, _) -> {
                    component_fields := [ComponentTypeField]{}
                    loop index in 0..<fields.len() {
                        field := fields[index]
                        if field.skip || field.computed -> next
                        field_type := sema_inference_substitute_type(field.ty, generic_names, type_args)
                        descriptor: sema_plugin_component_descriptor(graph, environment, program, field_type, next_seen) ?? return None
                        component_fields.push(ComponentTypeField{index: index, name: field.shape_names.json ?? field.name, ty: descriptor})
                    }
                    return Val(ComponentTypeDescriptor.Record{name: definition.name, fields: component_fields})
                }
                .Enum(_, _) | .Distinct(_, _) | .UnitFamily(_, _) -> return None
            }
        }
        .Char | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
}

sema_plugin_infer_args: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_plugin_method_diagnostic: fn(method: String, interface: SemaPluginInterface?, span: Span, diagnostics: &[Diagnostic]) {
    if interface == {
        .Val(value) -> {
            diagnostics.push(sema_error("E1257", span, "plugin interface `{value.artifact}` has no export `{method}`", "a loaded plugin exposes only its Component's function exports, with `-` in a name written `_`", "call one of the Component's exports, or rebuild the plugin with this export"))
        }
        .None -> {
            diagnostics.push(sema_error("E1257", span, "plugin export `{method}` has no Component interface", "plugin members resolve only through a literal artifact path whose Component the compiler reads while it builds the host", "pass `core.plugin.load` a literal path, from the package root, of a readable WebAssembly Component"))
        }
    }
}

sema_plugin_retired_method_diagnostic: fn(method: String, span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_error("E1257", span, "`Plugin.{method}` is not a plugin method", "plugin handles expose their Component's named function exports", "write the plugin's exported method directly, for example `plugin.index(rows)`"))
}

sema_plugin_record_exec: fn(method: String, success: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool Never! {
    result := Type.Result{ok: success, err: Type.Named{name: "PluginError"}}
    sema_effect_record_intrinsic_fact(environment, program, scopes, context, "Plugin.{method}", span, SemaCallFacts{
        return_type: result,
        failure_carrier: TFailureCarrier.Result{success: success, error: Type.Named{name: "PluginError"}},
        effect_bound: Val([EffectRowEntry]{EffectRowEntry{name: "Exec", span: span}}),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }, diagnostics)
}

sema_plugin_unsupported_component_diagnostic: fn(export_name: String, ty: Type, span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_error("E1260", span, "plugin export `{export_name}` uses unsupported Component value `{type_name(ty)}`", "plugin parameters and results must use recursively closed Component Model shapes", "use Int, Float, Bool, String, or a #Codable record/list/Option/Result shape"))
}

sema_plugin_unsupported_export_diagnostic: fn(export: SemaPluginInterfaceExport, span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_error("E1260", span, "plugin export `{export.name}` uses unsupported Component value `{export.unsupported}`", "plugin parameters and results must use Component Model shapes with a Jet spelling", "export it with Int, Float, Bool, String, or a list/option/result of them"))
}

sema_call_try_plugin_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, facts: SemaPluginInterfaceFacts, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    identity: sema_plugin_handle_identity(receiver_value.ty, environment, program) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    if method == "call" || method == "call_int" || method == "call_bool" || method == "call_text" {
        if !sema_plugin_record_exec(method, Type.Named{name: "Unit"}, span, environment, program, scopes, context, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        sema_plugin_retired_method_diagnostic(method, span, diagnostics)
        sema_plugin_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    interface := sema_plugin_interface_by_identity(facts, identity)
    interface_value: interface ?? {
        if !sema_plugin_record_exec(method, Type.Named{name: "Unit"}, span, environment, program, scopes, context, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        sema_plugin_method_diagnostic(method, None, span, diagnostics)
        sema_plugin_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    found_export := SemaPluginInterfaceExport?{None}
    loop row in interface_value.exports {
        if row.name == method {
            found_export = Val(row)
            break
        }
    }
    export_value: found_export ?? {
        if !sema_plugin_record_exec(method, Type.Named{name: "Unit"}, span, environment, program, scopes, context, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        sema_plugin_method_diagnostic(method, Val(interface_value), span, diagnostics)
        sema_plugin_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if export_value.unsupported != "" {
        if !sema_plugin_record_exec(method, Type.Named{name: "Unit"}, span, environment, program, scopes, context, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        sema_plugin_unsupported_export_diagnostic(export_value, span, diagnostics)
        sema_plugin_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    result_type := Type.Named{name: "Unit"}
    if export_value.return_type == .Val(value) -> result_type = sema_call_resolved_type(value, environment, program)
    if !sema_plugin_record_exec(method, result_type, span, environment, program, scopes, context, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() != export_value.params.len() {
        diagnostics.push(sema_call_arity_diagnostic(export_value.name, export_value.params.len(), args.len(), false, span))
        sema_plugin_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    params := [SemaCallParam]{}
    loop index in 0..<export_value.params.len() {
        parameter := export_value.params[index]
        params.push(SemaCallParam{label: "", name: "arg{index + 1}", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: parameter.convention, ty: Val(parameter.ty), variadic: false})
    }
    checked_args := args
    binding: sema_call_bind_args("Plugin.{method}", params, checked_args, span, diagnostics) ?? {
        sema_plugin_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if program.registration_graph == .Val(graph) {
    supported := true
    component_params := [ComponentTypeDescriptor]{}
    loop index in 0..<export_value.params.len() {
        parameter := export_value.params[index]
        required := sema_type_resolve_declared(graph, parameter.ty, environment.module_identity)
        descriptor := sema_plugin_component_descriptor(graph, environment, program, required, [String]{})
        if {
            descriptor == None -> {
                sema_plugin_unsupported_component_diagnostic(export_value.name, required, checked_args[index].span, diagnostics)
                supported = false
            }
            else -> {
                component_params.push(descriptor ?? return SemaMethodSpecialCheck{handled: true, value: None})
            }
        }
    }
    typed: sema_call_typecheck_bound_arguments("Plugin.{method}", params, None, false, binding, checked_args, environment, program, scopes, state, tail_store, context, span, diagnostics, true) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    ownership := sema_ownership_check_call_arguments(state, "Plugin.{method}", params, checked_args, scopes, diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    values := [TExpr]{}
    loop slot in 0..<params.len() {
        found := false
        loop index in 0..<typed.values.len() {
            if typed.slots[index] == slot {
                values.push(typed.values[index])
                found = true
                break
            }
        }
        if !found -> return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if export_value.return_type != None -> result_type = sema_type_resolve_declared(graph, export_value.return_type ?? Type.Named{name: "Unit"}, environment.module_identity)
    result_descriptor := sema_plugin_component_descriptor(graph, environment, program, result_type, [String]{})
    if result_descriptor == None {
        sema_plugin_unsupported_component_diagnostic(export_value.name, result_type, span, diagnostics)
        supported = false
    }
    if !supported -> return SemaMethodSpecialCheck{handled: true, value: None}
    signature := ComponentSignatureDescriptor{params: component_params, result: result_descriptor ?? return SemaMethodSpecialCheck{handled: true, value: None}}
    result := Type.Result{ok: result_type, err: Type.Named{name: "PluginError"}}
    value := sema_tree_node(result, TExprKind.HandleMethod{receiver: receiver_value, operation: THandleOp.PluginInvoke{export_name: export_value.name, signature: signature}, args: values}, span)
    return SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(value, expected, environment, program, context, diagnostics)}
    } else {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
}
