fn generic_bound_failure(checker: Checker, ty: Type, bound: String, span: Span) -> Diagnostic {
    if ty == .Named(name) {
        if checker.type_param_scope.any(fn(param: TypeParam) { param.name == name }) {
            return Diagnostic.error("E0905", "`{name}` isn't `{bound}`", "type parameter `{name}` doesn't declare the `{bound}` bound, so a caller may choose a type without it", "declare the bound where `{name}` is introduced: `<{name}: {bound}>`", Val(span))
        }
    }
    e0905(ty.name(), bound, span, false)
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:60
fn bind_inferred_type(param: String, found: Type, source: String, type_params: [String:Bool], subst: &[String:Type], origins: &[String:(Type, String)], conflict: &GenericInferenceConflict?) -> Bool {
    if !type_params.contains_key(param) -> return false
    normalized :: substitute_type(found, subst)
    if subst.get(param) == .Val(previous) {
        if previous == normalized -> return true
        if conflict == None {
            (first, first_source) :: origins.get(param) ?? (previous, "an earlier argument")
            conflict = Val(GenericInferenceConflict{param: param, first: first, first_source: first_source, second: normalized, second_source: source})
        }
        return false
    }
    &subst.insert(param, normalized)
    &origins.insert(param, (normalized, source))
    true
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:101
fn seed_generic_type(expected: Type, found: Type, source: String, type_params: [String:Bool], subst: &[String:Type], origins: &[String:(Type, String)], conflict: &GenericInferenceConflict?) -> Bool {
    // Bind the callee parameter before identity, even for same-spelled caller P.
    if expected == .Named(param) {
        if type_params.contains_key(param) -> return bind_inferred_type(param, found, source, type_params, &subst, &origins, &conflict)
    }
    if expected == found -> return true
    if found == .Named(param) {
        if type_params.contains_key(param) -> return bind_inferred_type(param, expected, source, type_params, &subst, &origins, &conflict)
    }
    if (expected, found) == {
        (.List(left), .List(right)) | (.Option(left), .Option(right)) -> seed_generic_type(left, right, source, type_params, &subst, &origins, &conflict)
        (.Result(expected_ok, expected_err), .Result(found_ok, found_err)) -> {
            ok :: seed_generic_type(expected_ok, found_ok, source, type_params, &subst, &origins, &conflict)
            err :: seed_generic_type(expected_err, found_err, source, type_params, &subst, &origins, &conflict)
            ok && err
        }
        (.Apply(expected_name, expected_args), .Apply(found_name, found_args)) if expected_name == found_name && expected_args.len() == found_args.len() -> {
            compatible := true
            loop i in 0..expected_args.len() {
                seeded :: seed_generic_type(expected_args[i], found_args[i], source, type_params, &subst, &origins, &conflict)
                compatible = compatible && seeded
            }
            compatible
        }
        (.Fn(expected_params, expected_ret, _, _, _, _), .Fn(found_params, found_ret, _, _, _, _)) -> {
            params_ok := expected_params.len() == found_params.len()
            loop i in 0..min(expected_params.len(), found_params.len()) {
                seeded :: seed_generic_type(expected_params[i], found_params[i], "the lambda parameter", type_params, &subst, &origins, &conflict)
                params_ok = params_ok && seeded
            }
            ret_ok :: if (expected_ret, found_ret) == {
                (.Val(expected_return), .Val(found_return)) -> {
                    if expected_return == {
                        .Result(expected_ok, expected_err) if !(if found_return == { .Result(_, _) -> true; else -> false }) -> {
                            ok :: seed_generic_type(expected_ok, found_return, "the lambda return", type_params, &subst, &origins, &conflict)
                            if expected_err == .Named(param) {
                                if type_params.contains_key(param) && !subst.contains_key(param) {
                                    _ :: bind_inferred_type(param, Type.Named{name: Syntax.TYPE_ERR}, "the lambda return", type_params, &subst, &origins, &conflict)
                                }
                            }
                            ok
                        }
                        else -> seed_generic_type(expected_return, found_return, "the lambda return", type_params, &subst, &origins, &conflict)
                    }
                }
                (.None, .None) -> true
                else -> false
            }
            params_ok && ret_ok
        }
        else -> {
            already_bound := [String:Bool]{}
            loop (param, _) in subst -> &already_bound.insert(param, true)
            compatible :: unify_types(expected, found, &subst, type_params)
            loop (param, _) in type_params {
                if !already_bound.contains_key(param) && !origins.contains_key(param) {
                    if subst.get(param) == .Val(ty) -> &origins.insert(param, (ty, source))
                }
            }
            compatible
        }
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:298
fn generic_conflict_diagnostic(span: Span, conflict: GenericInferenceConflict) -> Diagnostic {
    Diagnostic.error("E0904", "can't figure out what `{conflict.param}` should be here", "one generic type parameter received incompatible concrete types", "{conflict.param} is {conflict.first.name()} from {conflict.first_source} but {conflict.second.name()} from {conflict.second_source}; make those types agree", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:319
fn bind_user_policy_arguments(self: &Checker, arguments: &[CallArg], span: Span) {
    loop argument in &arguments {
        if argument.expr == .Call(policy) {
            if CallablePolicyChain.is_builtin(policy.name) -> next
            // GATE #4499: declaration identity is the original composite key.
            (_, declaration) :: self.callable_policy_declarations.get((self.package_scope, policy.name)) ?? next
            params := [BindParam]{}
            loop param in declaration.params {
                &params.push(BindParam{label: param.call_label(), name: param.name, zone: param.zone, default: param.default, convention: param.convention, ty: Val(param.ty), variadic: param.variadic, core_default: None})
            }
            _ :: bind_call_args(policy.name, params, &policy.args, span, &self.diags)
            self.register_binder_refs(policy.args)
        }
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:362
fn normalize_user_policy_arguments(self: &Checker, arguments: &[CallArg]) {
    loop argument in &arguments {
        if argument.expr == .Call(policy) {
            if CallablePolicyChain.is_builtin(policy.name) -> next
            // GATE #4499: same package/name declaration key as binding.
            (_, declaration) :: self.callable_policy_declarations.get((self.package_scope, policy.name)) ?? next
            if declaration.params.len() == 0 || !declaration.params[declaration.params.len() - 1].variadic -> next
            synthetic := Func.implicit_run([], declaration.span)
            synthetic.name = policy.name
            synthetic.params = declaration.params
            signature :: func_to_sig(synthetic)
            self.normalize_variadic_call(&policy, signature)
        }
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:395
fn check_freeze(self: &Checker, call: &Call) -> Type? {
    if call.args.len() != 1 {
        &self.diags.push(Diagnostic.error("E0104", "`freeze` takes exactly one value, got {call.args.len()}", "`freeze(x)` creates one deeply immutable owned snapshot for a crossing", "write `freeze(value)` with exactly one value", Val(call.name_span)))
        loop arg in &call.args -> _ :: self.infer(&arg.expr)
        return None
    }
    saved_borrow :: self.borrow_ctx
    self.borrow_ctx = true
    source_option :: self.infer(&call.args[0].expr)
    self.borrow_ctx = saved_borrow
    source_ty :: source_option ?? return None
    result :: owned_type_for_read_view(source_ty) ?? source_ty
    reason :: if self.type_contains_shared(source_ty) -> Val("the value contains `Shared`, whose lock-backed handle would keep shared mutation") else if self.is_resource_type(source_ty) -> Val("a resource has one cleanup owner and cannot be duplicated into a snapshot") else if !self.is_cloneable_type(result) -> Val("the value contains a resource, function, trait value, or mutable view that Jet cannot duplicate") else -> None
    if reason == .Val(problem_reason) {
        &self.diags.push(Diagnostic.from_row("E1114", [("ty", source_ty.show()), ("reason", problem_reason)], Val(call.args[0].expr.span())))
        return None
    }
    if self.crossing_problem(result, SendCrossing.TaskCapture, true) == .Val(problem) {
        self.report_unsendable("this frozen value", result, problem, SendCrossing.TaskCapture, call.args[0].expr.span())
        return None
    }
    call.resolved_ret = Val(result)
    Val(result)
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:460
fn check_callable_policy_apply(self: &Checker, call: &Call) -> Type? {
    if call.args.len() == 0 {
        &self.diags.push(Diagnostic.error("E0104", "`apply` needs a callable value", "a callable policy is applied to one function value; an empty chain is written `apply(fn)`", "write `apply(load_user)` or `apply(retry(3), load_user)`", Val(call.name_span)))
        return None
    }
    final_index :: call.args.len() - 1
    parsed_policy_exprs := [Expr]{}
    loop i in 0..final_index -> &parsed_policy_exprs.push(call.args[i].expr)
    chain :: CallablePolicyChain.parse(parsed_policy_exprs) ?? |reason| {
        &self.diags.push(Diagnostic.error("E0355", "`apply` received an invalid callable policy: {reason}", "policy values are checked before application and cannot change a callable's signature", "use `cache(…)`, `retry(…)`, `trace(…)`, `registration(…)`, or `route(…)`", Val(call.name_span)))
        return None
    }
    self.bind_user_policy_arguments(&call.args[..final_index], call.name_span)
    policy_exprs := [Expr]{}
    loop i in 0..final_index -> &policy_exprs.push(call.args[i].expr)
    if !self.validate_callable_policy_values(policy_exprs, call.name_span) -> return None
    loop i in 0..final_index {
        if call.args[i].expr == .Call(policy_call) {
            loop value in &policy_call.args -> _ :: self.infer(&value.expr)
        }
    }
    self.normalize_user_policy_arguments(&call.args[..final_index])
    if call.args[final_index].label != None || call.args[final_index].spread {
        &self.diags.push(Diagnostic.error("E0764", "the callable value in `apply` cannot have a label or spread", "the final argument is the value being wrapped; policy values come before it", "write `apply(policy(…), function)`", Val(call.args[final_index].span)))
        return None
    }
    callee_ty :: (if call.args[final_index].expr == {
        .Ident(name, ident_span) -> {
            if self.funcs.get(name) == {
                .Val(sig) -> {
                    self.record_current_function_reference(name, ident_span)
                    loop idx in 0..sig.params.len() {
                        convention :: sig.params[idx].0
                        if convention != AccessConvention.Read {
                            capability :: if convention == { .Write -> "the write-access marker `&`"; .Move -> "the move marker `^`"; .Read -> panic("unreachable read parameter") }
                            &self.diags.push(Diagnostic.error("E0112", "`{name}` cannot be used as a function value", "parameter {idx + 1} requires {capability}, but `fn(T)` function values take every parameter with plain read access", "call this function directly; function values cannot erase write or ownership requirements", Val(ident_span)))
                            break
                        }
                    }
                    Val(self.checked_func_sig_to_fn_type(sig))
                }
                .None -> None
            }
        }
        else -> self.infer(&call.args[final_index].expr)
    }) ?? return None
    replaced :: callee_ty.replace_callable_policies(chain) ?? {
        &self.diags.push(Diagnostic.error("E0803", "`apply` can wrap only a function value, not {callee_ty.show()}", "a callable policy is a function-to-function value with the same checked signature", "pass a function or function-typed binding as the final argument", Val(call.args[final_index].span)))
        return None
    }
    if !fn_types_compatible(callee_ty, replaced) || !type_obligations_satisfy(callee_ty, replaced) {
        &self.diags.push(Diagnostic.error("E0803", "callable policy replacement changed the checked function signature", "a policy is a function-to-function value with the same labels, access, effects, errors, variadics, and view provenance", "apply only a typed callable policy chain", Val(call.args[final_index].span)))
        return None
    }
    call.args[final_index].flags.callable_policy = Val(chain)
    Val(replaced)
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:585
fn check_overflow_opt_in(self: &Checker, call: &Call) -> Type? {
    kind :: call.name
    if call.args.len() != 1 {
        ty := None
        loop arg in &call.args {
            inferred :: self.infer(&arg.expr)
            if ty == None -> ty = inferred
        }
        &self.diags.push(overflow_opt_in_error(kind, call.name_span))
        if ty == .Val(t) { if t.is_integer() -> return Val(t) }
        return Val(Type.Int)
    }
    is_arith :: if call.args[0].expr == { .Binary(.Add | .Sub | .Mul | .Div, _, _, _) -> true; else -> false }
    arg_ty :: if is_arith -> self.with_knowledge_gate(KnowledgeGate.BoundedArithmetic, fn(checker: &Checker) { checker.infer(&call.args[0].expr) }) else -> self.infer(&call.args[0].expr)
    int_ok :: if arg_ty == { .Val(t) -> t.is_integer(); .None -> false }
    if !is_arith || !int_ok {
        &self.diags.push(overflow_opt_in_error(kind, call.name_span))
        if arg_ty == .Val(t) { if t.is_integer() -> return Val(t) }
        return Val(Type.Int)
    }
    t :: arg_ty.expect("integer argument inferred")
    if kind == Syntax.BUILTIN_CHECKED -> Val(Type.Option{inner: t}) else -> Val(t)
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:625
fn check_numeric_approx(self: &Checker, call: &Call) -> Type? {
    if call.args.len() != 1 {
        loop arg in &call.args -> _ :: self.infer(&arg.expr)
        &self.diags.push(Diagnostic.error("E0104", "`{Syntax.BUILTIN_APPROX}` takes one whole number", "`approx(value)` accepts possible precision loss at one integer-to-float crossing", "write `{Syntax.BUILTIN_APPROX}(value)`", Val(call.name_span)))
        return None
    }
    ty :: self.infer(&call.args[0].expr) ?? return None
    if !ty.is_integer() {
        &self.diags.push(Diagnostic.error("E0109", "`{Syntax.BUILTIN_APPROX}` needs a whole number, but this is {ty.show()}", "`approx(value)` only opts one integer-to-float crossing out of its exactness check", "remove `approx`, or pass a whole number that is crossing into a decimal", Val(call.args[0].expr.span())))
        return None
    }
    call.widen_approx = true
    Val(ty)
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:695
fn trace_start(expr: Expr) -> Int {
    if expr == {
        .Binary(_, left, _, _) -> trace_start(left)
        .Index(base, _, _, _) | .Slice(base, _, _, _, _) -> trace_start(base)
        .Field(base, _, _) -> trace_start(base)
        .OptField(base, _, _, _, _) -> trace_start(base)
        .MethodCall(receiver, _, _, _, _, _, _, _, _, _) -> trace_start(receiver)
        else -> source_expr_start(expr)
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:661
fn check_debug_trace(self: &Checker, call: &Call) -> Type? {
    if call.name == Syntax.INTERNAL_DEBUG_TRACE {
        if call.args.len() == 0 -> return None
        return self.infer(&call.args[0].expr)
    }
    if call.args.len() != 1 || call.args[0].label != None || call.args[0].spread {
        loop arg in &call.args -> _ :: self.infer(&arg.expr)
        &self.diags.push(Diagnostic.error("E0104", "`{Syntax.BUILTIN_DEBUG}` takes exactly one value", "`debug(value)` shows one value and returns it unchanged", "write `{Syntax.BUILTIN_DEBUG}(value)`", Val(call.name_span)))
        return None
    }
    ty :: self.infer(&call.args[0].expr)
    value_span :: call.args[0].expr.span()
    if ty == .Val(value_ty) {
        if !is_debuggable(value_ty, self.registry, self.trait_reg) -> &self.diags.push(Diagnostic.error("E0112", "`{Syntax.BUILTIN_DEBUG}` can't show {value_ty.show()}", "`debug` writes the value's Debug form", "implement `Debug`, or trace a debuggable part of the value", Val(value_span)))
    }
    source :: self.source
    text_start :: min(trace_start(call.args[0].expr), value_span.start)
    value_text := source.get(text_start..value_span.end) ?? "" // #4303 byte-offset slice view
    lines := [String]{}
    loop line in value_text.lines() {
        trimmed := line.trim() // #4303
        if trimmed.len() > 0 -> &lines.push(trimmed)
    }
    expr_text :: lines.join(" ")
    (line, _) :: span_line_col(source, call.name_span.start)
    file :: OSPath(self.module_path).file_name().and_then(fn(name: OSPath) { name.to_str() }) ?? self.module_path
    site :: "{file}:{line}"
    rejects := false
    if self.modules == .Val(modules) {
        if self.module_idx < modules.len() -> rejects = modules[self.module_idx].build_facts.rejects_debug_traces()
    }
    if rejects {
        close := None
        if source.get(value_span.end..) == .Val(rest) {
            if rest.find(fn(ch: Char) { !ch.is_whitespace() && ch != ',' }) == .Val(offset) {
                if rest[offset..].starts_with(')') -> close = Val(value_span.end + offset + 1)
            }
        }
        diagnostic := Diagnostic.from_row("E3405", [("site", site)], Val(call.name_span))
        if close == .Val(end) -> diagnostic = diagnostic.with_edit(TextEdit{span: Span.new(call.name_span.start, end), new_text: value_text})
        &self.diags.push(diagnostic)
    }
    call.name = Syntax.INTERNAL_DEBUG_TRACE
    &call.args.push(CallArg{convention: AccessConvention.Read, expr: Expr.Str{parts: [StrPart.Lit{text: "{site} {expr_text}"}], span: value_span}, span: value_span, flags: CallArgFlags.default(), label: None, spread: false})
    ty
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:757
fn check_measurement(self: &Checker, call: &Call) -> Type? {
    uncertainty_label :: if call.args.len() > 1 -> (if call.args[1].label == { .Val(label) -> label.name == "uncertainty"; .None -> false }) else -> false
    if call.args.len() != 2 || call.args[0].label != None || !uncertainty_label {
        loop argument in &call.args -> _ :: self.infer(&argument.expr)
        &self.diags.push(Diagnostic.error("E0104", "`measurement` needs a value and labeled uncertainty", "a measured value enters the exactness plane at one explicit constructor", "write `measurement(value, uncertainty: standard_uncertainty)`", Val(call.name_span)))
        return None
    }
    self.expect_core_arg("measurement", 0, Type.Float, &call.args[0])
    self.expect_core_arg("measurement", 1, Type.Float, &call.args[1])
    ty :: Type.Apply{name: Syntax.TYPE_MEASUREMENT, args: [Type.Float]}
    call.resolved_ret = Val(ty)
    Val(ty)
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:790
fn check_channel(self: &Checker, call: &Call) -> Type? {
    if call.args.len() > 1 {
        &self.diags.push(Diagnostic.error("E0104", "`channel` takes an optional capacity, got {call.args.len()} arguments", "a channel may be unbounded or have one whole-number backpressure bound", "write `channel<T>()` or `channel<T>(capacity: 1)", Val(call.name_span)))
        loop argument in &call.args -> _ :: self.infer(&argument.expr)
        return None
    }
    if call.args.len() > 0 {
        if call.args[0].label == .Val(label) {
            if label.name != "capacity" -> &self.diags.push(Diagnostic.error("E0104", "`channel` has one labeled argument: `capacity`", "the capacity label makes the backpressure bound explicit", "write `channel<T>(capacity: 8)", Val(call.args[0].span)))
        }
        cap_ty :: self.infer(&call.args[0].expr) ?? return None
        integer_cap :: if cap_ty == { .Int | .InlineRange(_, _, _) -> true; .Named(name) -> name == "Int" || name == "I64" || name == "I32"; else -> false }
        if !integer_cap -> &self.diags.push(Diagnostic.error("E0112", "`channel<T>(capacity: …)` needs an integer capacity, not {cap_ty.show()}", "bounded channels use a whole-number memory/backpressure limit", "write `channel<T>(capacity: 1)", Val(call.args[0].expr.span())))
    }
    if call.type_args.len() == 0 {
        &self.diags.push(Diagnostic.error("E0904", "`channel` needs a type argument to infer the element type", "the element type `T` cannot be guessed from an empty channel", "call it with an explicit type argument: `channel<T>()`", Val(call.name_span)))
        return None
    }
    element :: call.type_args[0]
    result :: Type.Tuple{fields: [TypeTupleField{name: "sender", ty: Type.Apply{name: Syntax.TYPE_SENDER, args: [element]}}, TypeTupleField{name: "receiver", ty: Type.Apply{name: Syntax.TYPE_RECEIVER, args: [element]}}]}
    call.resolved_ret = Val(result)
    Val(result)
}
// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/direct_calls.rs:876
fn infer_generic_call_args(self: &Checker, sig: FuncSig, fn_type_params: [TypeParam], args: &[CallArg], call_access: &CallAccessFrame, name_span: Span, owned_access: Bool) -> GenericArgInference {
    pre_inferred := [Type?]{}
    prepass_type_params := [String:Bool]{}
    loop param in fn_type_params -> &prepass_type_params.insert(param.name, true)
    loop index in 0..args.len() {
        param_conv :: if index < sig.params.len() -> Val(sig.params[index].0) else -> None
        lambda_expected := None
        if index < sig.params.len() && (if args[index].expr == { .Lambda(_) -> true; else -> false }) {
            param_ty :: sig.params[index].1
            if param_ty == .Fn(_, expected_ret, _, _, _, _) {
                subst := [String:Type]{}
                origins := [String:(Type, String)]{}
                conflict := None
                loop earlier in 0..pre_inferred.len() {
                    if earlier >= sig.params.len() -> next
                    found :: pre_inferred[earlier] ?? next
                    earlier_ty :: sig.params[earlier].1
                    if !(if earlier_ty == { .Fn(_, _, _, _, _, _) -> true; else -> false }) {
                        _ :: seed_generic_type(earlier_ty, found, "argument {earlier + 1}", prepass_type_params, &subst, &origins, &conflict)
                    }
                }
                if expected_ret == .Val(.Result(_, .Named(param))) {
                    if prepass_type_params.contains_key(param) && !subst.contains_key(param) -> &subst.insert(param, Type.Named{name: Syntax.TYPE_NEVER})
                }
                if conflict == None && subst.len() == prepass_type_params.len() -> lambda_expected = Val(substitute_type(param_ty, subst))
            }
        }
        inferred :: self.with_call_access(&call_access, fn(checker: &Checker) {
