// Shared structural collection checker and checked-tree producer. Zip and para_* stay
// in their dedicated paths so their input-shape and crossing proofs are not duplicated.
use jet_foundation.[
    AccessConvention,
    CallArg,
    CollectionLaw,
    CollectionResult,
    Diagnostic,
    Expr,
    ParamZone,
    SemaCollectionMethodContract,
    Span,
    SymbolID,
    SymbolKind,
    TBuiltinOp,
    TClosureOp,
    TListRemoveMode,
    TMethodRef,
    TPreludeArg,
    TStaticOwner,
    Type,
    ViewSourcePath,
    collection_row_takes_argument,
    expr_span,
    jet_layout_one_bit_shift,
    sema_collection_is_map,
    sema_collection_method_argument_type,
    sema_collection_method_contract,
    sema_collection_method_effect_row,
    sema_collection_method_operation,
    sema_collection_method_result_type,
    sema_collection_receiver_element,
    symbol_id,
    type_name,
]

sema_call_collections_arity_error: fn(method: String, expected: SemaCollectionMethodContract, actual: Int, span: Span) -> Diagnostic {
    sema_error("E0104", span, "`{method}` expects {if expected.minimum_arity == expected.maximum_arity -> "{expected.minimum_arity}" else -> "{expected.minimum_arity} to {expected.maximum_arity}"} arguments, got {actual}", "the collection contract fixes the callback and structural argument shape", "pass the arguments accepted by `.{method}`")
}


// Rust builtin-method argument inference: every argument is inferred under its contract parameter
// type, so leading-dot variants and anonymous records (`rows.push(.Ready)`, `map.add(key, {x:
// 1})`) take their type from it. A self-typed numeric read (`map.get(id)` with `id: Int` on a
// `[U64:V]`) checks on its own and then widens into the slot, as Rust `widen_numeric_argument` does
// after inference.
sema_call_collections_check_argument: fn(argument: CallArg, method: String, index: Int, required: Type, callback: Bool, lending: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    reported: diagnostics.len()
    previous_lending: context.lambda_lending_views
    context.lambda_lending_views = lending
    // Rust `open_ret`: a callback slot whose result type is still open
    // (`fn(T)` with no return) accepts any function value; the method's own
    // shape rules decide its use (a named `fn(T, T) -> Ordering` is the
    // `sort_by` comparator). Only a lambda, or the `.member` subject
    // shorthand that is one is checked against the slot. A failure-open slot
    // (Scopes.jet callback_failure_open, set by the caller for this one
    // argument) is open to a function value the same way.
    failure_open: context.callback_failure_open
    open_slot := false
    if callback && required == .Fn(_, required_ret, _, _, _, _) {
        is_lambda := if argument.expr == {
            .Lambda(_, _) -> true
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> sema_expr_is_bare_member_chain(argument.expr)
        }
        open_slot = (required_ret == None || failure_open) && !is_lambda
    }
    self_typed: !callback && sema_stmt_numeric_slot_self_typed(argument.expr, required, scopes)
    checked := if {
        open_slot || self_typed -> sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        callback -> {
            // An open callback result is adopted here and checked below.
            sema_expression_lambda_collection_callback(argument.expr, Val(required), environment, program, scopes, state, tail_store, context, diagnostics)
        }
        else -> {
            sema_check_expression(argument.expr, Val(required), environment, program, scopes, state, tail_store, context, diagnostics)
        }
    }
    context.lambda_lending_views = previous_lending
    context.callback_failure_open = false
    if !callback && !open_slot && !self_typed -> sema_value_method_replace_mismatch(argument.expr, method, index, required, reported, environment, program, scopes, state, tail_store, context, diagnostics)
    value: checked ?? return None
    if self_typed -> return sema_stmt_numeric_slot_value(value, required, environment, program, diagnostics)
    if open_slot {
        if value.ty == .Fn(_, _, _, _, _, _) -> return Val(value)
    }
    // A failure-open slot takes a callback whose success is the slot's row.
    if failure_open && required == .Fn(_, required_ret, _, _, _, _) && sema_call_signature_return(value.ty) == .Val(.Result(success, _)) {
        if required_ret == .Val(row) && sema_call_type_assignable(row, success, environment, program) == (Val(true)) -> return Val(value)
    }
    compatible := if required == {
        .Fn(_, fn_result, _, _, _, _) -> {
            if fn_result == None -> sema_call_host_callback_assignable(required, value.ty, environment, program) else -> sema_call_type_assignable(required, value.ty, environment, program)
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> sema_call_type_assignable(required, value.ty, environment, program)
    }
    if compatible == (Val(true)) -> return Val(value)
    if !callback && sema_expr_numeric_value_widening(value, required) == (Val(true)) {
        line: sema_source_line_at(environment.source_segments, value.span) ?? 0
        return sema_expr_numeric_literal_conversion(value, required, value.span, line, diagnostics)
    }
    diagnostics.push(if callback -> sema_type_mismatch(required, value.ty, argument.span) else -> sema_value_method_argument_mismatch(method, index, required, value.ty, argument.span))
    return None
}

// A total callback value (`T Never!`, a lambda bound without an expected
// type) cannot fail: the adapter takes its success, as a direct call does.
sema_call_collections_callback_return: fn(value: TExpr) -> Type Never! {
    returned: sema_call_signature_return(value.ty) ?? Type.Named{name: "Unit"}
    if returned == .Result(ok, err) {
        if err == (Type.Named{name: "Never"}) -> return ok.copy()
    }
    returned
}

// A callable value handed to an eager sequence adapter keeps its checked
// failure route. `fn(T) -> U` carries the default `Err` route, so the call site
// propagates each element's failure exactly as a direct `f(item)` would. A
// literal lambda records its own propagation, and a written `Result` return is
// projected onto the collection result.
sema_call_collections_callback_takes_default_route: fn(receiver: Type, method: String, callback: TExpr) -> Bool Never! {
    if callback.kind == .Lambda(_) -> return false
    receiver_ty: sema_expr_unwrap_tag(receiver)
    sequence: if receiver_ty == {
        .Option(_) | .Map(_, _, _) -> false
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> true
    }
    list: if receiver_ty == {
        .List(_) | .FixedList(_, _) -> true
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
    return if callback.ty == {
        .Fn(params, ret, _, _, _, _) -> {
            eager: if {
                method == "map" || method == "filter" -> sequence
                method == "sort_by" || method == "sort_by_desc" -> list && params.len() == 1
                else -> false
            }
            eager && sema_call_collections_return_takes_default_route(ret)
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// `FailureContract::from_return_type(ret).is_default()`: no written failure
// domain, optional success, or `Never` return.
sema_call_collections_return_takes_default_route: fn(ret: Type?) -> Bool Never! {
    declared: ret ?? return true
    return if declared == {
        .Named(name) -> name != "Never"
        .Option(_) | .Result(_, _) -> false
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> true
    }
}

sema_call_collections_reject_callback_shape: fn(method: String, callback_return: Type, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if method == "filter" {
        accepted := if callback_return == {
            .Result(ok, _) -> ok == Type.Bool
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> callback_return == Type.Bool
        }
        if accepted -> return false
        diagnostics.push(sema_error("E0108", span, "argument 1 to `.filter()` should return Bool or Result<Bool, E>, not {type_name(callback_return)}", "a filter callback decides whether each item stays in the collection", "return a Bool, or a fallible Bool such as `check(item)`"))
        return true
    }
    if method == "flat_map" {
        accepted := if callback_return == {
            .List(_) | .FixedList(_, _) -> true
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        if accepted -> return false
        diagnostics.push(sema_error("E0108", span, "argument 1 to `.flat_map()` should return a list, not {type_name(callback_return)}", "flat_map concatenates each callback-produced list into the output", "return a list from the callback"))
        return true
    }
    if method == "filter_map" {
        accepted := if callback_return == {
            .Option(_) | .Result(_, _) -> true
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        if accepted -> return false
        diagnostics.push(sema_error("E0108", span, "argument 1 to `.filter_map()` should return an Option or a Result, not {type_name(callback_return)}", "filter_map keeps each present or Ok payload and drops the rest", "return `Val(value)` or `None` (or a Result) from the callback, or use `.map()`"))
        return true
    }
    return false
}

// The ownership walk's parameter rows: a slot the row stores is a take
// (`&&`) parameter, every other slot reads (collection_row_takes_argument).
sema_call_collections_ownership_params: fn(contract: SemaCollectionMethodContract, required_types: [Type]) -> [SemaCallParam] Never! {
    params := [SemaCallParam]{}
    loop (index, ty) in required_types {
        convention: if collection_row_takes_argument(contract.row, index) -> AccessConvention.Move else -> AccessConvention.Read
        params.push(SemaCallParam{label: "arg{index}", name: "arg{index}", zone: ParamZone.Either, default: None, default_ref: None, convention: convention, ty: Val(ty), variadic: false})
    }
    return params
}

// F: a literal `RemoveBy` selector of a two-argument `remove` fixes the removal
// mode before argument inference, so `.Slot` takes an Int position and `.Val`
// an element; any other selector stays a run-time choice.
sema_call_collections_literal_remove_mode: fn(method: String, args: [CallArg]) -> TListRemoveMode? {
    if method != "remove" || args.len() != 2 -> return None
    return if args[1].expr == {
        .EnumLit(_, variant, _, _, _, _, _) -> if {
            variant == "Slot" -> Val(TListRemoveMode.Slot)
            variant == "Val" -> Val(TListRemoveMode.Value)
            else -> None
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_call_try_builtin_collections: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    if method == "zip" || method == "zip_short" || method == "zip_pad" || method == "para_map" || method == "para_filter" || method == "para_partition" || method == "para_fold" -> return SemaMethodSpecialCheck{handled: false, value: None}
    // E0964: length-changing methods are forbidden on a fixed-size `[T#N]`.
    if sema_expr_unwrap_tag(receiver_value.ty) == .FixedList(_, _) && (method == "push" || method == "pop" || method == "insert" || method == "remove" || method == "clear") {
        diagnostics.push(sema_error("E0964", span, "`{method}` changes a list's length, but this is a fixed-size {sema_type_show(receiver_value.ty)}", "the length of `[T#N]` is fixed at compile time and cannot change", "bind a growable list with `:=` (e.g. `r := [...]`) if you need to change its length"))
        loop argument in updated_args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    contract: sema_collection_method_contract(receiver_value.ty, method) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if method != "len" && method != "is_empty" && method != "push" && sema_columnar_list_element(environment, program, receiver_value.ty) == .Val(element) {
        diagnostics.push(sema_error("E1108", span, "`.{method}()` isn't supported on a columnar list `{sema_type_show(sema_expr_unwrap_tag(receiver_value.ty))}` yet", "`#Layout(columnar)` lists support the core surface in v1: indexing, field access, `len`, `is_empty`, `push`, and iteration", "drop `#Layout(columnar)` from `{element}` to use `.{method}()`, or rewrite the loop with indexing"))
        loop argument in updated_args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if contract.receiver_access == AccessConvention.Write && sema_expr_place_root_ident(receiver) == .Val(root) && context.iter_borrowed.contains(root) {
        diagnostics.push(sema_collection_changed_in_loop(root, "`{root}.{method}()`", expr_span(receiver)))
    }
    labels_valid := sema_value_method_check_labels(method, updated_args, diagnostics)
    if updated_args.len() < contract.minimum_arity || updated_args.len() > contract.maximum_arity {
        loop argument in updated_args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_builtin_method_arity(receiver_value.ty, method, updated_args.len(), span) ?? sema_call_collections_arity_error(method, contract, updated_args.len(), span))
        _ := sema_ownership_check_method_receiver(state, receiver, contract.receiver_access, method, scopes, span, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    copies_receiver := if contract.row.op == {
        .Copy -> true
        .Builtin(_) | .Closure(_) | .SetClosure(_) | .SetMinimum | .IterToSet | .SetBits | .ListShuffle | .SeqMap | .SeqFilter | .SeqEach | .SeqFold | .SetMap | .SetFilter | .SetEach | .SortBy | .SortByDesc | .Sum | .Product | .Min | .Max | .Average | .Indexed | .Unzip | .Split | .SplitWrite | .Partition | .ListRemove | .PriorityQueueRemove | .MapMerge | .MapTopN | .MapToList | .ListMinMax | .ListMinMaxBy -> false
    }
    if copies_receiver {
        if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        copied := sema_expr_check_copy_typed(receiver_value, span, expected, environment, program, context, diagnostics, false, false)
        return SemaMethodSpecialCheck{handled: true, value: copied}
    }

    is_map := sema_collection_is_map(receiver_value.ty)
    comparator := false
    if contract.accepts_comparator && updated_args.len() == 1 {
        comparator = if updated_args[0].expr == {
            .Lambda(lambda, _) -> lambda.params.len() == 2
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
        }
    }
    typed := [TExpr]{}
    literal_remove_mode := sema_call_collections_literal_remove_mode(method, updated_args)
    required_types := [Type]{}
    seed := Type?{None}
    callback_return := Type?{None}
    callback_mutable := false
    loop index in 0..<updated_args.len() {
        callback := contract.callback_indices.contains(index)
        seed_argument := contract.seed_indices.contains(index)
        required := if {
            seed_argument -> Type.Named{name: "Unit"}
            else -> sema_collection_method_argument_type(contract, index, seed, comparator) ?? {
                diagnostics.push(sema_error("E0112", updated_args[index].span, "the Source collection contract for `{method}` is incomplete", "a checked collection method needs one argument type for each written argument", "complete the canonical collection method contract"))
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
        }
        if index == 0 && literal_remove_mode == (Val(TListRemoveMode.Slot)) -> required = Type.Int
        // `place.move()` that a storing method receives is the call's take of
        // that place, as a take parameter's is (Calls/Checking.jet).
        if (contract.row.law == CollectionLaw.Mutate || contract.row.law == CollectionLaw.TryMutate) && contract.row.name != "remove" && sema_expr_argument_move_place(updated_args[index], scopes) == .Val(taken) {
            updated_args[index].expr = taken
            updated_args[index].convention = AccessConvention.Move
        }
        value: if {
            seed_argument -> {
                sema_check_expression(updated_args[index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
            }
            else -> {
                // `filter` projects a fallible predicate's failure onto its
                // `[T] E!` result (sema_collection_filtered).
                context.callback_failure_open = callback && (contract.row.result == CollectionResult.Filtered || contract.row.result == CollectionResult.ListFiltered)
                sema_call_collections_check_argument(updated_args[index], method, index, required, callback, method == "edit_disjoint" && index == 1, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
            }
        }
        if seed_argument {
            required = value.ty
            seed = Val(value.ty)
        }
        if callback {
            callback_return = Val(sema_call_collections_callback_return(value))
            // Like a direct `f(item)`: the unresolved edge also reaches the
            // owner from inside a callback (Rust sets `task_body_propagates`).
            if index == 0 && sema_call_collections_callback_takes_default_route(receiver_value.ty, method, value) {
                context.failure_direct_source = true
                context.task_body_propagates = true
                context.failure_edges.push("")
            }
            callback_mutable = if value.kind == {
                .Lambda(lambda) -> lambda.capture_facts.needs_fn_mut
                .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> callback_mutable
            }
        }
        // A named binary function given to `sort_by` is its
        // comparator, like a two-parameter lambda.
        if callback && index == 0 && contract.accepts_comparator && !comparator && value.ty == .Fn(callback_params, _, _, _, _, _) && callback_params.len() == 2 {
            comparator = true
            required = sema_collection_method_argument_type(contract, index, seed, true) ?? required
        }
        required_types.push(required.copy())
        // A slot the row stores owns what it receives (#6611,
        // collection_row_takes_argument), so an unmarked name there is the
        // call's take exactly as at a `&&` parameter (Calls/Checking.jet): a
        // plain owned local moves at its last use, any other name moves out
        // of its owner here. A call never copies on its own:
        // a read parameter has no storage to give up (E0201). A slot that only
        // compares (`contains`, `remove`, `discard`, ...) never takes, so a
        // later read of the owner still finds its value.
        takes_argument: collection_row_takes_argument(contract.row, index)
        unmarked_take: takes_argument && updated_args[index].convention == AccessConvention.Read
        noted_take := false
        if takes_argument && updated_args[index].convention == AccessConvention.Read && updated_args[index].expr == .Ident(_, _, _) && !sema_ownership_type_is_copy(value.ty) && !sema_ownership_type_is_copy(required) && !sema_ownership_argument_is_function_item(updated_args[index], scopes) {
            if sema_ownership_note_implicit_take(state, updated_args[index].expr, value.ty, required, environment, program, context.generic_params, scopes) != None {
                noted_take = true
            } else {
                updated_args[index].convention = AccessConvention.Move
            }
        }
        // A taken argument keeps the exact-place move an ordinary consuming
        // argument gets, so the stored value moves out of its owner instead
        // of materializing a copy. A bare name of a read parameter is reported
        // at the name by the ownership walk below, which names the consumer;
        // a field place reports at the mark.
        stores_argument: (contract.row.law == CollectionLaw.Mutate || contract.row.law == CollectionLaw.TryMutate) && contract.row.name != "remove"
        consuming_mark: stores_argument && (updated_args[index].convention == AccessConvention.Move || noted_take) && !sema_ownership_type_is_copy(value.ty)
        taken_place := consuming_mark && sema_call_marked_move_place(updated_args[index].expr, value)
        walk_reports: takes_argument && updated_args[index].expr == .Ident(_, _, _)
        // A resource has one cleanup owner, so a take that would copy it out
        // of a place read in place (E0211) or out of a borrowed parameter
        // (E0201 naming `&&`) is refused for that, never with a `.copy()` fix.
        if unmarked_take && (!sema_copy_site_refuse_resource_copy(value, environment, program, scopes, context, diagnostics) || !sema_copy_site_refuse_borrowed_copy(updated_args[index].expr, "`.{method}()`", environment, program, scopes, context, diagnostics)) -> return SemaMethodSpecialCheck{handled: true, value: None}
        if taken_place && ((!walk_reports && sema_ownership_reject_read_param_move(state, updated_args[index].expr, scopes, diagnostics)) || sema_ownership_reject_place_alias_move(state, updated_args[index].expr, scopes, "`.{method}()`", diagnostics)) -> return SemaMethodSpecialCheck{handled: true, value: None}
        if taken_place && sema_ownership_binding_for_expr(state, updated_args[index].expr, scopes) == .Val(root) -> taken_place = !sema_ownership_binding_is_borrowed_param(root)
        stored: sema_call_marked_move_value(state, taken_place, updated_args[index].expr, value, scopes, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        typed.push(stored)
    }

    if !labels_valid -> return SemaMethodSpecialCheck{handled: true, value: None}
    if contract.seed_indices.len() > 0 && seed == .Val(seed_ty) && callback_return == .Val(return_type) {
        result_value := return_type
        compatible := sema_call_type_assignable(seed_ty, result_value, environment, program) ?? false
        if !compatible {
            diagnostics.push(sema_type_mismatch(seed_ty, result_value, span))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    if callback_return == .Val(return_type) && !(is_map && method == "flat_map") && sema_call_collections_reject_callback_shape(method, return_type, span, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    result_type: sema_collection_method_result_type(contract, callback_return, seed) ?? {
        diagnostics.push(sema_error("E0108", span, "the callback result is not valid for `.{method}`", "the collection result type must follow the callback's checked return type", "return the item shape required by this collection adapter"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    line: sema_source_line_at(environment.source_segments, span) ?? 0
    operation := sema_collection_method_operation(contract, updated_args.len(), literal_remove_mode, line, callback_return, callback_mutable, comparator)
    ownership := if sema_call_collections_receiver_two_phase(receiver_value.ty, method) -> sema_ownership_check_two_phase_method_call(state, "collection.{method}", "`.{method}()`", receiver, contract.receiver_access, false, sema_call_collections_ownership_params(contract, required_types), updated_args, scopes, span, expr_span(receiver), diagnostics) else -> sema_ownership_check_method_call_as(state, "collection.{method}", "`.{method}()`", receiver, contract.receiver_access, true, false, true, sema_call_collections_ownership_params(contract, required_types), updated_args, scopes, span, expr_span(receiver), diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    // A bare name in a slot the row stores was taken by the ownership walk
    // above (a read parameter is E0201, a later use names this call). The
    // copy-site audit settles every other stored value: one holding a resource
    // read in place is refused (CopySites.jet), and an unmarked name inside a
    // carrier (`Val(name)`) or in a slot that does not take moves in when a
    // clone refuses it.
    if (contract.row.law == CollectionLaw.Mutate || contract.row.law == CollectionLaw.TryMutate) && contract.row.name != "remove" {
        loop index in 0..<updated_args.len() {
            if index < typed.len() && !sema_copy_site_check_guard_owned(typed[index], environment, program, scopes, state, context, diagnostics, false) -> return SemaMethodSpecialCheck{handled: true, value: None}
            taken_name: collection_row_takes_argument(contract.row, index) && updated_args[index].expr == .Ident(_, _, _)
            if !taken_name && !sema_copy_site_record_stored(updated_args[index].expr, "`.{method}()`", environment, program, scopes, state, context, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    effect_row := sema_collection_method_effect_row(contract, span)
    if !sema_effect_record_intrinsic_effects(environment, program, scopes, context, "collection.{method}", span, effect_row, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    if method == "split_write" || method == "get_disjoint_write" -> sema_call_collections_record_disjoint_views(receiver, method, updated_args, span, scopes, state, context)

    // A literal selector is fixed in the removal mode, so the route takes the item alone.
    if literal_remove_mode != None -> _ := typed.pop()
    value := if operation == {
        .Builtin(builtin) -> {
            builtin_receiver := receiver_value
            builtin_args := typed
            if sema_call_collections_runs_on_iter(builtin) {
                builtin_receiver = sema_call_collections_list_as_iter(receiver_value, span)
                if builtin == {
                    .IterCompare -> {
                        builtin_args = [TExpr]{}
                        loop argument in typed -> builtin_args.push(sema_call_collections_list_as_iter(argument, span))
                    }
                    .AtomicMethod(_) | .LenString | .LenList | .IsEmpty | .Push | .ListTryNew | .ListTryWithCapacity | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .Pop | .PriorityQueuePop | .InsertMap | .AddNewMap | .MapSetDefault | .MapUpdate | .MapMerge | .MapMergeWith | .InsertList | .RemoveMap | .RemoveList(_, _) | .CountList | .Counts | .ExtendList | .ConcatList | .GetMap | .GetList | .First | .Last | .Contains | .IndexOf | .Reverse | .SwapList | .ListFill | .Sort | .SortDesc | .OrderingThen | .OrderingReverse | .JoinSep | .Sum(_, _) | .Product(_) | .Min(_) | .Max(_) | .Flatten | .Intersperse | .Unzip | .Clear | .Chars | .Bytes(_) | .StringFromBytes | .StringFromBytesLossy | .Trim | .TrimStart | .TrimEnd | .PadStart | .PadEnd | .StringIndexOf | .StringCount | .StringIsAlphabetic | .StringIsNumeric | .StringIsWhitespace | .StringIsASCII | .StringToTitle | .StringMethod(_) | .StringSplitOnce | .StringCutLast | .Split | .Lines | .ParseInt | .ParseFloat | .IntToRadix | .IntFromRadix | .StartsWith | .EndsWith | .Replace | .ToUpper | .ToLower | .ToASCIILower | .ToASCIIUpper | .Repeat | .Slice(_) | .After | .Before | .TrimView | .AfterView | .BeforeView | .Keys | .Values | .ContainsKey | .ToString | .Take | .Skip | .IterToList | .IterCollect | .ListLazy | .StepBy | .Dedup | .Chunks | .Windows | .IterRepeat | .IterCycle | .IterDropLast | .IterNext | .IterShuffle | .IterIsSorted | .IterLastIndexOf | .IterAverage(_) | .IterSplit | .ListSlice | .ListEqual | .ListBinarySearch | .ListUnion | .ListIntersection | .ListDifference | .ListRandom | .ListMinMax | .MapEqual | .MapFirst | .MapToList | .MapTopN | .MapMin | .MapMax | .MapIntersection | .MapSliceKeys | .MapFromKeys | .MapContainsValue | .MapPopFirst | .ListReplace | .Indexed | .Indexes | .Zip(_, _, _, _, _, _) | .OptionZip(_) | .SetFrom | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetRemove | .SetToList | .SetUnion | .SetIntersection | .SetDifference | .SetSymmetricDifference | .SetIsSubset | .SetIsSuperset | .SetIsDisjoint | .SetEqual | .SetCapacity | .SetFirst | .SetValues | .SetPop | .SetReplace | .SetSort | .SetShuffle | .SortedSetFrom | .SortedSetInsert | .SortedSetRemove | .SortedSetToList | .SortedSetUnion | .SortedSetIntersection | .SortedSetDifference | .SortedSetSymmetricDifference | .SortedSetIsSubset | .SortedSetIsSuperset | .SortedSetIsDisjoint | .PriorityQueueFrom | .PriorityQueuePeek | .PriorityQueueToSortedList | .PriorityQueueRemove(_, _) | .KeyOrdered(_, _) | .LRUPut | .LRUAddNew | .LRUGet | .LRURemove | .LRUCapacity | .LRUKeys | .BitSetAdd | .BitSetRemove | .BitSetCount | .BitSetToList | .ByteBufferFrom | .ByteBufferWrite(_) | .ByteBufferToBytes | .ByteBufferMethod(_) | .ByteBufferWithCapacity | .BagAdd | .BagRemove | .BagHas | .BagCount | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequePeekFront | .DequePeekBack | .DequeCapacity | .DequeContains | .DequeGet | .DequeDelete | .DequeToList | .DequeJoin | .DequeReverse | .DequeSplit | .DequeFrom | .TryCollect | .ViewNew(_) | .SplitWrite | .GetDisjointWrite | .ListFillRepeat -> {}
                }
            }
            sema_tree_node(result_type, TExprKind.BuiltinMethod{receiver: builtin_receiver, operation: builtin, args: builtin_args}, span)
        }
        .Closure(closure) -> sema_tree_node(result_type, TExprKind.ClosureMethod{receiver: receiver_value, operation: closure, args: typed}, span)
        .ListShuffle -> {
            lazy := sema_tree_node(result_type, TExprKind.BuiltinMethod{receiver: receiver_value, operation: TBuiltinOp.ListLazy, args: [TExpr]{}}, span)
            sema_tree_node(result_type, TExprKind.BuiltinMethod{receiver: lazy, operation: TBuiltinOp.IterShuffle, args: [TExpr]{}}, span)
        }
        .SetClosure(closure) -> {
            element: sema_collection_receiver_element(receiver_value.ty) ?? Type.Int
            list_type := Type.List{element: element}
            set_list := sema_tree_node(list_type, TExprKind.BuiltinMethod{receiver: receiver_value, operation: TBuiltinOp.SetToList, args: [TExpr]{}}, span)
            if {
                closure == TClosureOp.FlatMap -> {
                    inner: if result_type == {
                        .Apply(name, apply_args) -> {
                            if name == "Iter" && apply_args.len() == 1 -> apply_args[0] else -> Type.Int
                        }
                        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> Type.Int
                    }
                    mapped_type := Type.List{element: inner}
                    mapped := sema_tree_node(mapped_type, TExprKind.ClosureMethod{receiver: set_list, operation: closure, args: typed}, span)
                    sema_tree_node(result_type, TExprKind.BuiltinMethod{receiver: mapped, operation: TBuiltinOp.ListLazy, args: [TExpr]{}}, span)
                }
                else -> {
                    sema_tree_node(result_type, TExprKind.ClosureMethod{receiver: set_list, operation: closure, args: typed}, span)
                }
            }
        }
        .SetMinimum -> {
            element: sema_collection_receiver_element(receiver_value.ty) ?? Type.Int
            set_list := sema_tree_node(Type.List{element: element}, TExprKind.BuiltinMethod{receiver: receiver_value, operation: TBuiltinOp.SetToList, args: [TExpr]{}}, span)
            sema_tree_node(result_type, TExprKind.BuiltinMethod{receiver: set_list, operation: TBuiltinOp.Min{float: false}, args: [TExpr]{}}, span)
        }
        .IterToSet -> {
            // #4009: `Set.from` collects a list; drain the iterator through the
            // same `.to_list()` a user would write before building the set.
            element: sema_collection_receiver_element(receiver_value.ty) ?? Type.Int
            drained := sema_tree_node(Type.List{element: element}, TExprKind.BuiltinMethod{receiver: receiver_value, operation: TBuiltinOp.IterToList, args: [TExpr]{}}, span)
            sema_tree_node(result_type, TExprKind.BuiltinMethod{receiver: drained, operation: TBuiltinOp.SetFrom, args: [TExpr]{}}, span)
        }
        // `set.bits()` crosses the Set's word through the Prelude Set route.
        .SetBits -> {
            element: sema_collection_receiver_element(receiver_value.ty) ?? Type.Int
            if !sema_call_set_bits_ready(element, "bits()", span, environment, program, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
            path: "std::collections::HashSet"
            reference := TMethodRef{symbol: symbol_id(SymbolKind.Function, "", path, "bits"), name: "bits", mangled: false, trait_owner: None, operator_identity: None}
            argument := TCallArg{value: receiver_value, template_items: [SymbolID]{}, borrow: true, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
            sema_tree_node(result_type, TExprKind.StaticCall{owner: TStaticOwner.Prelude{rooted: false, path: path, generics: [TPreludeArg]{TPreludeArg.Jet{ty: element}}}, owner_type: None, method: reference, type_args: [Type]{}, args: [TCallArg]{argument}}, span)
        }
    }
    checked := sema_expression_call_expected(value, expected, environment, program, context, diagnostics)
    return SemaMethodSpecialCheck{handled: true, value: checked}
}

// A Set of a fieldless enum of 1 to 64 cases with no type parameters is
// stored as bits (the IR's ir_bit_set_def): `bits()` and
// `Set<E>.from_bits(n)` cross it as a U64. A `#Specified` enum's cases
// cross as their own values, so each must be one bit (E1132); any other
// element is E1133.
sema_call_set_bits_ready: fn(element: Type, callee: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Bool {
    element_name: type_name(element)
    refused: sema_error("E1133", span, "`{callee}` needs a Set stored as bits, and `Set<{element_name}>` is not one", "only a Set of an enum with 1 to 64 cases, no payloads and no type parameters is stored as one bit per case", "use such an enum as the element, or read the Set with `to_list()`")
    named: if element == .Named(name) -> name.copy() else -> ""
    definition: sema_serde_type_definition(environment, program, named) ?? {
        diagnostics.push(refused)
        return false
    }
    ready := named != "" && definition.generic_params.len() == 0
    if definition.kind == .Enum(variants, _) {
        if variants.len() == 0 || variants.len() > 64 -> ready = false
        loop variant in variants {
            if variant.payload == {
                .Unit -> {}
                .Single(_) | .Named(_) -> ready = false
            }
        }
        if ready && definition.specified {
            reported: diagnostics.len()
            loop variant in variants {
                value: variant.discriminant ?? 0
                if jet_layout_one_bit_shift(value) == None -> diagnostics.push(sema_error("E1132", span, "case `{element_name}.{variant.name}` has value {value}, which is not one bit", "`bits()` and `from_bits` map each case of a `#Specified` enum to its own value, so each value must be a single bit", "give the case a power-of-two value, or remove `#Specified` so the cases take bits in declaration order"))
            }
            return diagnostics.len() == reported
        }
        if ready -> return true
    }
    diagnostics.push(refused)
    false
}

// Rust lower_method_call: the lazy and iterator-kernel builtins run on
// `Iter<T>`, so a List or FixedList receiver (and `compare`'s other side) is
// wrapped as its `lazy()` iterator (wrap_list_as_iter).
sema_call_collections_runs_on_iter: fn(operation: TBuiltinOp) -> Bool Never! {
    if operation == {
        .StepBy | .Take | .Skip | .Dedup | .Chunks | .Windows | .Intersperse | .IterRepeat | .IterCycle | .IterDropLast | .IterShuffle | .IterIsSorted | .IterLastIndexOf | .IterAverage(_) | .IterCompare -> true
        .AtomicMethod(_) | .LenString | .LenList | .IsEmpty | .Push | .ListTryNew | .ListTryWithCapacity | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .Pop | .PriorityQueuePop | .InsertMap | .AddNewMap | .MapSetDefault | .MapUpdate | .MapMerge | .MapMergeWith | .InsertList | .RemoveMap | .RemoveList(_, _) | .CountList | .Counts | .ExtendList | .ConcatList | .GetMap | .GetList | .First | .Last | .Contains | .IndexOf | .Reverse | .SwapList | .ListFill | .Sort | .SortDesc | .OrderingThen | .OrderingReverse | .JoinSep | .Sum(_, _) | .Product(_) | .Min(_) | .Max(_) | .Flatten | .Unzip | .Clear | .Chars | .Bytes(_) | .StringFromBytes | .StringFromBytesLossy | .Trim | .TrimStart | .TrimEnd | .PadStart | .PadEnd | .StringIndexOf | .StringCount | .StringIsAlphabetic | .StringIsNumeric | .StringIsWhitespace | .StringIsASCII | .StringToTitle | .StringMethod(_) | .StringSplitOnce | .StringCutLast | .Split | .Lines | .ParseInt | .ParseFloat | .IntToRadix | .IntFromRadix | .StartsWith | .EndsWith | .Replace | .ToUpper | .ToLower | .ToASCIILower | .ToASCIIUpper | .Repeat | .Slice(_) | .After | .Before | .TrimView | .AfterView | .BeforeView | .Keys | .Values | .ContainsKey | .ToString | .IterToList | .IterCollect | .ListLazy | .IterNext | .IterSplit | .ListSlice | .ListEqual | .ListBinarySearch | .ListUnion | .ListIntersection | .ListDifference | .ListRandom | .ListMinMax | .MapEqual | .MapFirst | .MapToList | .MapTopN | .MapMin | .MapMax | .MapIntersection | .MapSliceKeys | .MapFromKeys | .MapContainsValue | .MapPopFirst | .ListReplace | .Indexed | .Indexes | .Zip(_, _, _, _, _, _) | .OptionZip(_) | .SetFrom | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetRemove | .SetToList | .SetUnion | .SetIntersection | .SetDifference | .SetSymmetricDifference | .SetIsSubset | .SetIsSuperset | .SetIsDisjoint | .SetEqual | .SetCapacity | .SetFirst | .SetValues | .SetPop | .SetReplace | .SetSort | .SetShuffle | .SortedSetFrom | .SortedSetInsert | .SortedSetRemove | .SortedSetToList | .SortedSetUnion | .SortedSetIntersection | .SortedSetDifference | .SortedSetSymmetricDifference | .SortedSetIsSubset | .SortedSetIsSuperset | .SortedSetIsDisjoint | .PriorityQueueFrom | .PriorityQueuePeek | .PriorityQueueToSortedList | .PriorityQueueRemove(_, _) | .KeyOrdered(_, _) | .LRUPut | .LRUAddNew | .LRUGet | .LRURemove | .LRUCapacity | .LRUKeys | .BitSetAdd | .BitSetRemove | .BitSetCount | .BitSetToList | .ByteBufferFrom | .ByteBufferWrite(_) | .ByteBufferToBytes | .ByteBufferMethod(_) | .ByteBufferWithCapacity | .BagAdd | .BagRemove | .BagHas | .BagCount | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequePeekFront | .DequePeekBack | .DequeCapacity | .DequeContains | .DequeGet | .DequeDelete | .DequeToList | .DequeJoin | .DequeReverse | .DequeSplit | .DequeFrom | .TryCollect | .ViewNew(_) | .SplitWrite | .GetDisjointWrite | .ListFillRepeat -> false
    }
}

sema_call_collections_list_as_iter: fn(value: TExpr, span: Span) -> TExpr Never! {
    element: sema_call_collections_list_element(value.ty) ?? return value
    sema_tree_node(Type.Apply{name: "Iter", args: [Type]{element}}, TExprKind.BuiltinMethod{receiver: value, operation: TBuiltinOp.ListLazy, args: [TExpr]{}}, span)
}

// Rust Type::without_user_tags, then a List or FixedList element.
sema_call_collections_list_element: fn(ty: Type) -> Type? Never! {
    return if ty == {
        .Tagged(marker, inner) -> if marker == {
            .User(_) -> sema_call_collections_list_element(inner)
            .Internal(_) -> None
        }
        // copy: `element` is a payload of read parameter `ty`, which keeps the original; the Val carrier owns this one
        .List(element) -> Val(element.copy())
        // copy: `element` is a payload of read parameter `ty`, which keeps the original; the Val carrier owns this one
        .FixedList(element, _) -> Val(element.copy())
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// A successful runtime proof gives each output slot a distinct Fresh projection
// on the original owner.
sema_call_collections_record_disjoint_views: fn(receiver: Expr, method: String, args: [CallArg], span: Span, scopes: SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext) {
    proof_spans := [Span]{}
    slots := [[String]]{}
    if method == "split_write" {
        proof_spans.push(span.copy())
        proof_spans.push(expr_span(args[0].expr))
        slots.push([String]{"left"})
        slots.push([String]{"right"})
    } else {
        if args[0].expr == .ListLit(items, _, _) {
            loop item in items {
                proof_spans.push(expr_span(item))
                slots.push([String]{"[]"})
            }
        } else {
            proof_spans.push(span.copy())
            slots.push([String]{"[]"})
        }
    }
    bases: sema_ownership_places_from_expr_in_state(receiver, scopes, state)
    facts := [SemaCallReturnViewFact]{}
    loop index in 0..<proof_spans.len() {
        places := [SemaOwnershipPlace]{}
        loop base in bases {
            place := sema_ownership_place_snapshot(base)
            place.projections.push("[fresh]")
            place.typed_projections.push(SemaOwnershipProjection.Fresh{span: proof_spans[index]})
            places.push(place)
        }
        facts.push(SemaCallReturnViewFact{slot: slots[index], access: AccessConvention.Write, places: places, sources: [ViewSourcePath]{}, temporaries: [Span]{}})
    }
    sema_ownership_note_call_views(state, span, facts)
    context.call_return_views.push(SemaCallReturnView{span: span, facts: facts})
}

// Rust `builtin_receiver_borrow`: a mutating collection method reserves its
// receiver two-phase, except iterator `next` and the list helpers lowered
// with an explicit eager `&mut receiver` first argument.
sema_call_collections_receiver_two_phase: fn(receiver_ty: Type, method: String) -> Bool Never! {
    if method == "next" -> return false
    if method == "remove" || method == "sort_by" || method == "sort_desc" || method == "sort_by_desc" || method == "update_first" || method == "edit_disjoint" -> return !sema_call_collections_list_receiver(receiver_ty)
    true
}

sema_call_collections_list_receiver: fn(ty: Type) -> Bool Never! {
    if ty == {
        .List(_) | .FixedList(_, _) -> true
        .Tagged(_, inner) -> sema_call_collections_list_receiver(inner)
        .Result(ok, _) -> sema_call_collections_list_receiver(ok)
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}
