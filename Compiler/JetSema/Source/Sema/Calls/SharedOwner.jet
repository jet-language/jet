// Shared owner methods: `Shared<T>` capture/try_replace/same/guard_read/
// guard_edit/downgrade/strong_count, `SharedSnapshot<T, U>.value()` and
// `Shared.Weak<T>.upgrade()`, plus the local `Cell<T>` and its
// `CellReadGuard<T>`/`CellEditGuard<T>` handles. The plain-access read/edit
// seam stays in Methods.jet and projected SharedGuard operations stay in
// Memory.jet.
//
// Every accepted call is one checked `THostCall` whose receiver type selects
// the canonical core.host route in codegen, and records its Rust effect row as
// an intrinsic call fact.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    Expr,
    InternalTag,
    ParamZone,
    Span,
    TagMarker,
    Type,
    TypeTupleField,
    expr_span,
    type_identity_equal,
    type_name,
]

SEMA_SHARED_SNAPSHOT_TYPE :: comptime { "SharedSnapshot" }
SEMA_SHARED_WEAK_TYPE :: comptime { "Shared.Weak" }
SEMA_SHARED_REVISION_ERROR_TYPE :: comptime { "SharedRevisionError" }
// A guard whose lexical tail spans this many later statements holds its lock
// long enough to warn (L0206).
SEMA_SHARED_GUARD_LONG_SCOPE :: comptime { 8 }

fn sema_call_shared_owner_snapshot_type(inner: Type, projection: Type) -> Type Never! {
    Type.Apply{name: SEMA_SHARED_SNAPSHOT_TYPE, args: [Type]{inner, projection}}
}

fn sema_call_shared_owner_host_value(receiver_value: TExpr, method: String, args: [TExpr], result: Type, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    owner :: if receiver_value.ty == {
        .Shared(_) -> "Shared"
        .Apply(name, _) -> name
        else -> type_name(receiver_value.ty)
    }
    if !sema_effect_record_intrinsic_effects(environment, program, &scopes, &context, "{owner}.{method}", span, sema_shared_access_effect_row(receiver_value.ty, method, span), &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tir_node(result, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: method, args: args}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
}

fn sema_call_shared_owner_cloneable(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, context: SemaCheckContext) -> Bool Never! {
    facts :: sema_copy_classify(ty, SemaCopyIntent.Clone, environment, program, context.generic_params, false)
    !facts.complete || facts.copyable || facts.cloneable
}

// Statements still to run in this and every enclosing block: the span a guard
// taken here keeps its lock.
fn sema_call_shared_owner_lexical_tail_len(tail_store: SemaStatementTailStore, context: SemaCheckContext) -> Int Never! {
    total := 0
    loop frame in context.lambda_statement_tails {
        remaining := tail_store.bodies[frame.body_id].statements.len() - frame.start_index
        if remaining > 0 -> total += remaining
    }
    total
}

fn sema_call_shared_owner_param(name: String, convention: AccessConvention, ty: Type) -> SemaCallParam Never! {
    SemaCallParam{label: name, name: name, zone: ParamZone.Either, default: None, default_ref: None, convention: convention, ty: Val(ty), variadic: false}
}

// Capture either the whole cloneable payload or one
// pure, cloneable projection. The callback runs under the Shared read lock,
// so its returned value is paired with one committed revision.
fn sema_call_shared_owner_capture(receiver: Expr, receiver_value: TExpr, inner: Type, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if args.len() > 1 {
        &diagnostics.push(sema_error("E0104", span, "`capture` expects 0 or 1 argument, got {args.len()}", "`capture` takes no argument or one pure projection closure", "call `.capture(value -> …)`"))
        sema_call_memory_discard_args(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() == 0 {
        if !sema_call_shared_owner_cloneable(inner, environment, program, context) {
            &diagnostics.push(sema_error("E0112", span, "`Shared<{type_name(inner)}>.capture()` cannot copy its value", "`capture` owns an independent snapshot, so the stored type must support copying", "capture a cloneable projection instead, or add the required copy implementation"))
        }
        return sema_call_shared_owner_host_value(receiver_value, "capture", [TExpr]{}, sema_call_shared_owner_snapshot_type(inner, inner), span, expected, environment, program, &scopes, &context, &diagnostics)
    }
    callback_is_lambda :: if args[0].expr == {
        .Lambda(_, _) -> true
        else -> false
    }
    if !callback_is_lambda {
        &diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`capture` needs a lambda, not a value", "`.capture` runs a short function against the locked value", "write `.capture(value -> …)`"))
        sema_call_memory_discard_args(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    callback_expected :: Type.Fn{params: [Type]{inner}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    callback := sema_expression_lambda_host_callback(args[0].expr, Val(callback_expected), false, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    projected :: sema_call_resolved_type(sema_call_signature_return(callback.ty) ?? Type.Named{name: "Unit"}, environment, program)
    if !sema_call_shared_owner_cloneable(projected, environment, program, context) {
        &diagnostics.push(sema_error("E0112", span, "`Shared<{type_name(inner)}>.capture(projection)` returns non-copyable `{type_name(projected)}`", "a captured projection is an owned value retained by the snapshot", "return a cloneable value from the projection"))
    }
    if callback.kind == .Lambda(lambda) && (lambda.effects.maximal || lambda.effects.solved.len() > 0) {
        &diagnostics.push(sema_error("E3401", expr_span(args[0].expr), "`Shared.capture` calls the impure function `capture projection`", "`capture projection` is impure, but `Shared.capture` declares `-[]>`", "remove the call from `Shared.capture`, or drop the `-[]>` bound from `Shared.capture` so its effects are inferred"))
    }
    tir_expr_retype(&callback, Type.Fn{params: [Type]{inner}, ret: Val(projected), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None})
    sema_call_shared_owner_host_value(receiver_value, "capture", [TExpr]{callback}, sema_call_shared_owner_snapshot_type(inner, projected), span, expected, environment, program, &scopes, &context, &diagnostics)
}

// Consume one owner-bound snapshot ticket plus a
// replacement payload. The runtime performs the atomic owner/revision
// comparison; sema only fixes the generic source type.
fn sema_call_shared_owner_try_replace(receiver: Expr, receiver_value: TExpr, inner: Type, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if args.len() != 2 {
        &diagnostics.push(sema_error("E0104", span, "`try_replace` expects 2 arguments, got {args.len()}", "`try_replace` takes one snapshot ticket and one replacement value", "call `.try_replace(snapshot, value)`"))
        sema_call_memory_discard_args(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    updated_args := args
    snapshot :: sema_check_expression(updated_args[0].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    valid_source := if snapshot.ty == {
        .Apply(name, type_args) -> name == SEMA_SHARED_SNAPSHOT_TYPE && type_args.len() == 2 && type_identity_equal(type_args[0], inner)
        else -> false
    }
    if !valid_source {
        &diagnostics.push(sema_error("E0112", expr_span(updated_args[0].expr), "`try_replace` needs a `SharedSnapshot<{type_name(inner)}, U>`, got `{type_name(snapshot.ty)}`", "a snapshot ticket is bound to the exact Shared payload type", "capture the snapshot from this Shared value before publishing"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    replacement_checked :: sema_check_expression(updated_args[1].expr, Val(inner), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    replacement :: sema_expr_expected(replacement_checked, Val(inner), environment, program, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    params :: [SemaCallParam]{sema_call_shared_owner_param("snapshot", AccessConvention.Move, snapshot.ty), sema_call_shared_owner_param("value", AccessConvention.Move, inner)}
    ownership := sema_ownership_check_method_call(&state, "Shared.try_replace", receiver, AccessConvention.Read, params, &updated_args, scopes, span, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    values :: [TExpr]{snapshot, replacement}
    result :: Type.Result{ok: Type.Bool, err: Type.Named{name: SEMA_SHARED_REVISION_ERROR_TYPE}}
    sema_call_shared_owner_host_value(receiver_value, "try_replace", values, result, span, expected, environment, program, &scopes, &context, &diagnostics)
}

// `a.same(b)` asks whether two `Shared<T>` handles name one cell. Identity
// only, like `Rc::ptr_eq`; `==` on `Shared<T>` stays an error. The argument
// is only read, so neither handle is moved.
fn sema_call_shared_owner_same(receiver: Expr, receiver_value: TExpr, inner: Type, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if args.len() != 1 {
        &diagnostics.push(sema_error("E0104", span, "`same` expects 1 argument, got {args.len()}", "`same` compares this Shared handle with one other handle", "call `.same(other)`"))
        sema_call_memory_discard_args(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    shared_type :: Type.Shared{inner: inner}
    updated_args := args
    other_checked :: sema_check_expression(updated_args[0].expr, Val(shared_type), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    other :: sema_expr_expected(other_checked, Val(shared_type), environment, program, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    params :: [SemaCallParam]{sema_call_shared_owner_param("other", AccessConvention.Read, shared_type)}
    ownership := sema_ownership_check_method_call(&state, "Shared.same", receiver, AccessConvention.Read, params, &updated_args, scopes, span, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    sema_call_shared_owner_host_value(receiver_value, "same", [TExpr]{other}, Type.Bool, span, expected, environment, program, &scopes, &context, &diagnostics)
}

fn sema_call_shared_owner_nullary(receiver: Expr, receiver_value: TExpr, method: String, result: Type, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    sema_call_shared_owner_host_value(receiver_value, method, [TExpr]{}, result, span, expected, environment, program, &scopes, &context, &diagnostics)
}

fn sema_call_shared_owner_guard(receiver: Expr, receiver_value: TExpr, inner: Type, method: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if sema_call_shared_owner_lexical_tail_len(tail_store, context) >= SEMA_SHARED_GUARD_LONG_SCOPE {
        &diagnostics.push(sema_lint("L0206", span, "`Shared.{method}()` keeps its lock through a long lexical scope", "the guard releases at scope exit, so later statements and nested guard acquisitions run while this lock is held", "move the guarded work into a smaller block; when nesting guards is necessary, acquire them in one stable order"))
    }
    marker :: TagMarker.Internal{internal_tag: if method == "guard_edit" -> InternalTag.SharedGuardEdit else -> InternalTag.SharedGuardRead}
    result :: Type.Tagged{marker: marker, inner: Type.Apply{name: "SharedGuard", args: [Type]{inner}}}
    sema_call_shared_owner_nullary(receiver, receiver_value, method, result, span, expected, environment, program, &scopes, &state, &context, &diagnostics)
}

// Rust builtin_methods.rs (`Cell` receivers), CheckerOwnership.rs
// `finish_cell_*` and Collections.rs `cell_method_return` /
// `cell_guard_method_return`: a local `Cell<T>` mutates through a read
// receiver. `get` hands out an independent owned value, so the stored type
// must copy. Guard `map`/`split` consume the source guard so only the
// projected guards keep the original dynamic loan.
fn sema_call_cell_guard_type(editable: Bool, inner: Type) -> Type Never! {
    Type.Apply{name: if editable -> "CellEditGuard" else -> "CellReadGuard", args: [Type]{inner}}
}

fn sema_call_cell_get(receiver: Expr, receiver_value: TExpr, inner: Type, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if args.len() != 0 {
        &diagnostics.push(sema_wrong_core_arity("get", 0, args.len(), span))
        sema_call_memory_discard_args(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_call_shared_owner_cloneable(inner, environment, program, context) {
        &diagnostics.push(sema_error("E0112", span, "`Cell<{sema_type_show(inner)}>.get()` cannot copy its value", "`get` returns an independent owned value, so the stored type must support copying", "use `.read(value -> ...)` to inspect it without making a copy"))
    }
    sema_call_shared_owner_nullary(receiver, receiver_value, "get", inner, span, expected, environment, program, &scopes, &state, &context, &diagnostics)
}

// `set` and `replace` consume the new value; `replace` returns the old one.
fn sema_call_cell_write(receiver: Expr, receiver_value: TExpr, owner: String, inner: Type, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if args.len() != 1 {
        &diagnostics.push(sema_wrong_core_arity(method, 1, args.len(), span))
        sema_call_memory_discard_args(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    updated_args := args
    checked :: sema_check_expression(updated_args[0].expr, Val(inner), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    value :: sema_expr_expected(checked, Val(inner), environment, program, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    params :: [SemaCallParam]{sema_call_shared_owner_param("value", AccessConvention.Move, inner)}
    ownership := sema_ownership_check_method_call(&state, "{owner}.{method}", receiver, AccessConvention.Read, params, &updated_args, scopes, span, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    result :: if method == "replace" -> inner else -> Type.Named{name: "Unit"}
    sema_call_shared_owner_host_value(receiver_value, method, [TExpr]{value}, result, span, expected, environment, program, &scopes, &context, &diagnostics)
}

// `get_or_set` initializes an empty `Cell<T?>` from a zero-parameter lambda
// and returns an owned copy of its `T`.
fn sema_call_cell_get_or_set(receiver: Expr, receiver_value: TExpr, inner: Type, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    stored_type := Type?{None}
    if inner == .Option(value) -> stored_type = Val(value)
    stored :: stored_type ?? {
        &diagnostics.push(sema_error("E0112", span, "`Cell<{sema_type_show(inner)}>` is not an optional cell", "`get_or_set` initializes an empty `Cell<T?>` and returns its `T` value", "use `Cell<T?>`, or use `.get()` for a cell that always has a value"))
        sema_call_memory_discard_args(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if args.len() != 1 {
        &diagnostics.push(sema_wrong_core_arity("get_or_set", 1, args.len(), span))
        sema_call_memory_discard_args(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    is_lambda :: if args[0].expr == {
        .Lambda(_, _) -> true
        else -> false
    }
    if !is_lambda {
        &diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`get_or_set` needs a zero-parameter lambda", "the initializer runs only when the cell is empty", "write `.get_or_set(() -> value)`"))
    }
    initializer_type :: Type.Fn{params: [Type]{}, ret: Val(stored), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    initializer := sema_check_expression_with_lambda_escapes(args[0].expr, Val(initializer_type), environment, program, &scopes, &state, &tail_store, &context, Val(false), &diagnostics)
    if !sema_call_shared_owner_cloneable(stored, environment, program, context) {
        &diagnostics.push(sema_error("E0112", span, "`Cell<{sema_type_show(stored)}?>.get_or_set()` cannot copy its value", "`get_or_set` returns an independent owned value, so `T` must support copying", "use `.edit(value -> ...)` when the cached value cannot be copied"))
    }
    if !is_lambda -> return SemaMethodSpecialCheck{handled: true, value: None}
    callback :: initializer ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    sema_call_shared_owner_host_value(receiver_value, "get_or_set", [TExpr]{callback}, stored, span, expected, environment, program, &scopes, &context, &diagnostics)
}

// Rust `cell_guard_projection_path`: the lambda parameter itself or a chain of
// field reads from it.
fn sema_call_cell_guard_projection_path(expression: Expr, parameter: String) -> [String]? {
    if expression == {
        .Ident(name, _, _) -> {
            if name == parameter -> return Val([String]{})
            return None
        }
        .Field(base, member, _, _) -> {
            path := sema_call_cell_guard_projection_path(base, parameter) ?? return None
            &path.push(member)
            return Val(path)
        }
        .Paren(inner, _, _) -> return sema_call_cell_guard_projection_path(inner, parameter)
        else -> return None
    }
}

fn sema_call_cell_guard_projection(expression: Expr) -> [String]? {
    if expression == {
        .Lambda(lambda, _) -> {
            if lambda.params.len() != 1 -> return None
            if lambda.body == {
                .Expr(body) -> return sema_call_cell_guard_projection_path(body, lambda.params[0].name)
                else -> return None
            }
        }
        else -> return None
    }
}

fn sema_call_cell_guard_paths_overlap(first: [String], second: [String]) -> Bool Never! {
    shortest :: if first.len() < second.len() -> first.len() else -> second.len()
    loop index in 0..<shortest {
        if first[index] != second[index] -> return false
    }
    true
}

// Rust `finish_shared_closure`: one lambda over the guarded value; an edit
// guard lends the value mutably.
fn sema_call_cell_closure(method: String, inner: Type, argument: CallArg, editable: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    is_lambda :: if argument.expr == {
        .Lambda(_, _) -> true
        else -> false
    }
    if !is_lambda {
        &diagnostics.push(sema_error("E0112", expr_span(argument.expr), "`{method}` needs a lambda, not a value", "`.{method}` runs a short function against the locked value", "write `.{method}(value -> …)`"))
        _ := sema_check_expression(argument.expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return None
    }
    expected :: Type.Fn{params: [Type]{inner}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    sema_expression_lambda_host_callback(argument.expr, Val(expected), editable, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
}

fn sema_call_cell_guard_map(receiver: Expr, receiver_value: TExpr, editable: Bool, inner: Type, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    projection := [String]?{None}
    if args.len() > 0 {
        projection = sema_call_cell_guard_projection(args[0].expr)
        if projection == None -> &diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`guard.map` needs a field projection", "a mapped guard must point into the value covered by its original dynamic loan", "write `.map(value -> value.field)`"))
    }
    if args.len() != 1 {
        &diagnostics.push(sema_call_builtin_host_arity_diagnostic("map", args.len(), span))
        sema_call_memory_discard_args(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    callback :: sema_call_cell_closure("map", inner, args[0], editable, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    path :: projection ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Move, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    projected :: sema_call_signature_return(callback.ty) ?? Type.Named{name: "Unit"}
    result :: sema_call_cell_guard_type(editable, projected)
    value := sema_tir_node(result, TExprKind.HostCall{call: THostCall.CellGuardProject{receiver: receiver_value, paths: [[String]]{path}, result_type: result, editable: editable, edit_paths_disjoint: false}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
}

// An edit guard splits only into disjoint fields; read guards may overlap.
fn sema_call_cell_guard_split(receiver: Expr, receiver_value: TExpr, editable: Bool, inner: Type, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if args.len() != 2 {
        &diagnostics.push(sema_wrong_core_arity("split", 2, args.len(), span))
        sema_call_memory_discard_args(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    complete := true
    paths := [[String]]{}
    loop argument in args {
        path :: sema_call_cell_guard_projection(argument.expr) ?? {
            &diagnostics.push(sema_error("E0112", expr_span(argument.expr), "`guard.split` needs two field projections", "each split guard must point into the value covered by the original dynamic loan", "write `.split(value -> value.left, value -> value.right)`"))
            complete = false
            next
        }
        &paths.push(path)
    }
    if editable && paths.len() == 2 && sema_call_cell_guard_paths_overlap(paths[0], paths[1]) {
        &diagnostics.push(sema_error("E0112", expr_span(args[1].expr), "`guard.split` projections overlap", "each edit guard must cover a disjoint field of the original value", "project two different fields, or keep one guard and edit through it"))
        complete = false
    }
    first :: sema_call_cell_closure("split", inner, args[0], editable, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    second :: sema_call_cell_closure("split", inner, args[1], editable, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    first_callback :: first ?? return SemaMethodSpecialCheck{handled: true, value: None}
    second_callback :: second ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Move, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    first_guard :: sema_call_cell_guard_type(editable, sema_call_signature_return(first_callback.ty) ?? Type.Named{name: "Unit"})
    second_guard :: sema_call_cell_guard_type(editable, sema_call_signature_return(second_callback.ty) ?? Type.Named{name: "Unit"})
    result :: Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "first", ty: first_guard}, TypeTupleField{name: "second", ty: second_guard}}}
    value := sema_tir_node(result, TExprKind.HostCall{call: THostCall.CellGuardProject{receiver: receiver_value, paths: paths, result_type: result, editable: editable, edit_paths_disjoint: editable}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
}

fn sema_call_try_cell_method(receiver: Expr, receiver_value: TExpr, name: String, type_args: [Type], method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if type_args.len() != 1 -> return SemaMethodSpecialCheck{handled: false, value: None}
    inner :: type_args[0]
    if name == "Cell" {
        if method == "get" -> return sema_call_cell_get(receiver, receiver_value, inner, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        if method == "set" || method == "replace" -> return sema_call_cell_write(receiver, receiver_value, name, inner, method, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        if method == "get_or_set" -> return sema_call_cell_get_or_set(receiver, receiver_value, inner, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        if method == "guard_read" || method == "guard_edit" {
            if args.len() != 0 {
                &diagnostics.push(sema_wrong_core_arity(method, 0, args.len(), span))
                sema_call_memory_discard_args(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            return sema_call_shared_owner_nullary(receiver, receiver_value, method, sema_call_cell_guard_type(method == "guard_edit", inner), span, expected, environment, program, &scopes, &state, &context, &diagnostics)
        }
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if name != "CellReadGuard" && name != "CellEditGuard" -> return SemaMethodSpecialCheck{handled: false, value: None}
    editable :: name == "CellEditGuard"
    if method == "get" -> return sema_call_cell_get(receiver, receiver_value, inner, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    if method == "set" && editable -> return sema_call_cell_write(receiver, receiver_value, name, inner, method, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    if method == "map" -> return sema_call_cell_guard_map(receiver, receiver_value, editable, inner, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    if method == "split" -> return sema_call_cell_guard_split(receiver, receiver_value, editable, inner, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    SemaMethodSpecialCheck{handled: false, value: None}
}

// Rust `finish_pool_add` / `finish_pool_remove` and the `("Pool", "ids")` arm:
// `pool.add(value)` consumes a `T` and returns its `ID<T>`, `pool.remove(id)`
// returns the removed `T?`, `pool.ids()` lists every live `ID<T>`. None of
// them records a receiver write; each lowers to the plain `JetPool<T>` method.
fn sema_call_pool_method(receiver: Expr, receiver_value: TExpr, element: Type, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    failed :: SemaMethodSpecialCheck{handled: true, value: None}
    id_type :: Type.Apply{name: "ID", args: [Type]{element}}
    wanted :: if method == "ids" -> 0 else -> 1
    if args.len() != wanted {
        if method == "ids" {
            &diagnostics.push(sema_wrong_core_arity(method, 0, args.len(), span))
        } else {
            why :: if method == "add" -> "adding to a pool needs exactly one value" else -> "removing from a pool needs exactly one `ID<T>`"
            fix :: if method == "add" -> "call `.add(value)` with the value to store" else -> "call `.remove(id)` with the `ID<T>` to remove"
            &diagnostics.push(sema_error("E0104", span, "`{method}` expects 1 argument, got {args.len()}", why, fix))
        }
        sema_call_memory_discard_args(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return failed
    }
    if method == "ids" {
        if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return failed
        return sema_call_shared_owner_host_value(receiver_value, method, [TExpr]{}, Type.List{element: id_type}, span, expected, environment, program, &scopes, &context, &diagnostics)
    }
    updated_args := args
    slot :: if method == "add" -> element else -> id_type
    checked :: sema_check_expression(updated_args[0].expr, Val(slot), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return failed
    value :: sema_expr_expected(checked, Val(slot), environment, program, &diagnostics) ?? return failed
    convention :: if method == "add" -> AccessConvention.Move else -> AccessConvention.Read
    params :: [SemaCallParam]{sema_call_shared_owner_param(if method == "add" -> "value" else -> "id", convention, slot)}
    ownership := sema_ownership_check_method_call(&state, "Pool.{method}", receiver, AccessConvention.Read, params, &updated_args, scopes, span, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return failed
    result :: if method == "add" -> id_type else -> Type.Option{inner: element}
    sema_call_shared_owner_host_value(receiver_value, method, [TExpr]{value}, result, span, expected, environment, program, &scopes, &context, &diagnostics)
}

fn sema_call_try_shared_owner_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if receiver_value.ty == {
        .Shared(inner) -> {
            if method == "capture" -> return sema_call_shared_owner_capture(receiver, receiver_value, inner, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            if method == "try_replace" -> return sema_call_shared_owner_try_replace(receiver, receiver_value, inner, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            if method == "same" -> return sema_call_shared_owner_same(receiver, receiver_value, inner, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            if args.len() != 0 -> return SemaMethodSpecialCheck{handled: false, value: None}
            if method == "guard_read" || method == "guard_edit" -> return sema_call_shared_owner_guard(receiver, receiver_value, inner, method, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            // Expert weak edge for intentional cycles.
            if method == "downgrade" -> return sema_call_shared_owner_nullary(receiver, receiver_value, method, Type.Apply{name: SEMA_SHARED_WEAK_TYPE, args: [Type]{inner}}, span, expected, environment, program, &scopes, &state, &context, &diagnostics)
            if method == "strong_count" -> return sema_call_shared_owner_nullary(receiver, receiver_value, method, Type.Int, span, expected, environment, program, &scopes, &state, &context, &diagnostics)
        }
        .Apply(name, type_args) -> {
            if name == "Pool" && type_args.len() == 1 && (method == "add" || method == "remove" || method == "ids") -> return sema_call_pool_method(receiver, receiver_value, type_args[0], method, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            cell :: sema_call_try_cell_method(receiver, receiver_value, name, type_args, method, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            if cell.handled -> return cell
            if args.len() != 0 -> return SemaMethodSpecialCheck{handled: false, value: None}
            if name == SEMA_SHARED_SNAPSHOT_TYPE && type_args.len() == 2 && method == "value" -> return sema_call_shared_owner_nullary(receiver, receiver_value, method, type_args[1], span, expected, environment, program, &scopes, &state, &context, &diagnostics)
            if name == SEMA_SHARED_WEAK_TYPE && type_args.len() == 1 && method == "upgrade" -> return sema_call_shared_owner_nullary(receiver, receiver_value, method, Type.Option{inner: Type.Shared{inner: type_args[0]}}, span, expected, environment, program, &scopes, &state, &context, &diagnostics)
        }
        else -> {}
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}
