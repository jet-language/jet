// Method candidate collection and checked MethodCall construction.
// Registry/Core/module candidates are supplied by Registration through
// sema_call_check_method_candidate_owned; the local collector only exposes
// declarations already present in SemaScopeTable.
use jet_foundation.[
    AST_NODE_GENERATED,
    BUILTIN_METHOD_ROWS,
    BinOp,
    COLLECTION_OPERATIONS,
    AccessConvention,
    Call,
    CallArg,
    Diagnostic,
    Expr,
    Func,
    Lambda,
    LambdaBody,
    LambdaParam,
    NamedSpan,
    OrFallback,
    Stmt,
    StrFormat,
    StrPart,
    Span,
    SymbolID,
    SymbolKind,
    TLetTy,
    TMethodRef,
    TGenericParam,
    Type,
    TypeTupleField,
    TextEdit,
    ast_binding,
    ast_empty_call_arg_flags,
    ast_empty_lambda_meta,
    builtin_method_receiver_accepts,
    core_source_receiver_method,
    core_source_receiver_method_routes,
    app_route_file_address,
    AppRouteRoot,
    diagnostic_registry_row,
    diagnostic_with_edit,
    expr_span,
    OWNED_TRAITS,
    owned_trait,
    owned_trait_declares,
    owned_trait_operator_hook,
    sema_collection_is_list,
    sema_collection_method_contract,
    sema_collection_receiver_element,
    sema_reserved_type_name,
    symbol_id,
    type_name,
    checked_symbol_local,
]

SemaMethodSpecialCheck: struct {
    handled: Bool
    value: TExpr?
}

sema_call_shared_access_forbidden_diagnostic: fn(method: String, span: Span) -> Diagnostic {
    sema_error("E1116", span, "a shared value has no `.{method}(…)` method", "a shared value reads and writes like a value: a field read is one locked read, a field write is one locked write, and each statement is one atomic step", "read the field directly (`config.name`) and write it directly (`config.hits += 1`); group several steps under `#Transact {{ … }}`, or take an expert guard with `.guard_edit()`")
}

sema_call_distinct_raw_finish: fn(receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    base: sema_expr_distinct_facts(receiver_value.ty, environment, program, scopes)?.base ?? sema_expr_quantity_raw_base(receiver_value.ty, environment, program, scopes) ?? {
        diagnostics.push(sema_error("E0311", span, "`.raw()` is only valid on a distinct type value", "`.raw()` unwraps a distinct type to its base representation", "only call `.raw()` on a value whose type was declared as `Name: distinct BaseType`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if args.len() > 0 {
        diagnostics.push(sema_error("E0103", span, "`.raw()` takes no arguments", "`.raw()` simply unwraps the base value — no arguments needed", "write `.raw()` with no arguments"))
    }
    value: sema_tree_node(base, TExprKind.DistinctRaw{value: receiver_value}, span)
    checked: sema_expr_expected(value, expected, environment, program, diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

sema_call_try_distinct_raw_value: fn(receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    gate_scope: sema_call_enter_gate(scopes, SemaKnowledgeGate.RawProjection)
    allowed: sema_scope_require_knowledge_gate(scopes, SemaKnowledgePlane.Range, SemaKnowledgeGate.RawProjection, span, diagnostics)
    finished: if allowed -> sema_call_distinct_raw_finish(receiver_value, args, span, expected, environment, program, scopes, diagnostics) else -> SemaMethodSpecialCheck{handled: true, value: None}
    sema_call_leave_gate(scopes, gate_scope)
    finished
}

sema_call_try_transaction_hook: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if receiver_value.ty != (Type.Named{name: "Transaction"}) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if method != "on_commit" && method != "on_rollback" -> return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() != 1 {
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_error("E0104", span, "`{method}` takes one lambda, got {args.len()}", if method == "on_commit" -> "a post-commit hook registers a single cleanup lambda" else -> "a rollback hook registers a single undo lambda", "write `<handle>.{method}(fn() {{ … }})`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if args[0].expr == .Lambda(lambda, _) {
        if lambda.params.len() != 0 {
            diagnostics.push(sema_error("E0104", expr_span(args[0].expr), "`{method}` needs a zero-parameter lambda, got {lambda.params.len()} parameter{if lambda.params.len() == 1 -> "" else -> "s"}", "the hook body takes no arguments — it captures what it needs via closure", "write `<handle>.{method}(fn() {{ … }})` with no parameters"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    saved_transaction_depth: scopes.transaction_depth
    saved_transaction_wall_depth: scopes.transaction_wall_depth
    scopes.transaction_depth = 0
    scopes.transaction_wall_depth = 0
    checked: sema_check_expression_with_lambda_escapes(args[0].expr, if args[0].expr == {
        .Lambda(_, _) -> Val(Type.Fn{params: [Type]{}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None})
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }, environment, program, scopes, state, tail_store, context, Val(true), diagnostics)
    scopes.transaction_depth = saved_transaction_depth
    scopes.transaction_wall_depth = saved_transaction_wall_depth
    callback: checked ?? return SemaMethodSpecialCheck{handled: true, value: None}
    executable: if callback.kind == {
        .Lambda(value) -> Val(value)
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> None
    } ?? {
        diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{method}` needs a lambda, not {sema_type_show(callback.ty)}", if method == "on_commit" -> "a post-commit hook runs a lambda only after the transaction commits" else -> "a rollback hook runs a lambda only when the transaction rolls back", "write `<handle>.{method}(fn() {{ … }})`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    handle_name: if receiver == {
        .Ident(name, _, _) -> name
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> ""
    }
    if handle_name == "" -> return SemaMethodSpecialCheck{handled: true, value: None}
    kind: if method == "on_commit" -> TCoreClosureKind.OnCommit{handle_name: handle_name, executable: executable} else -> TCoreClosureKind.OnRollback{handle_name: handle_name, executable: executable}
    value: sema_tree_node(Type.Named{name: "TransactionGuard"}, TExprKind.CoreClosureCall{kind: kind}, span)
    checked_value: sema_expr_expected(value, expected, environment, program, diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked_value}
}

sema_call_shared_access_result_type: fn(receiver_ty: Type, method: String, result_type: Type, transaction_depth: Int) -> Type Never! {
    if sema_shared_access_is_shared_type(receiver_ty) && method == "edit" && transaction_depth > 0 -> Type.Named{name: "Unit"} else -> result_type
}

sema_call_builtin_host_arity_diagnostic: fn(method: String, actual: Int, span: Span) -> Diagnostic {
    sema_error("E0104", span, "`{method}` expects 1 argument, got {actual}", "`.{method}` takes exactly one closure", "call `.{method}(fn(value) {{ ... }})` with a closure")
}

sema_call_builtin_host_lambda_diagnostic: fn(method: String, ty: Type, span: Span) -> Diagnostic {
    sema_error("E0112", span, "`{method}` needs a lambda, not {type_name(ty)}", "`.{method}` runs a short function against the locked value", "write `.{method}(fn(value) {{ … }})`")
}

sema_call_try_builtin_host_route: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if !sema_shared_access_host_method(receiver_value.ty, method) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    if sema_shared_access_is_shared_type(receiver_value.ty) && (method == "read" || method == "edit") && !sema_shared_access_is_desugar(args) {
        diagnostics.push(sema_call_shared_access_forbidden_diagnostic(method, span))
    }
    if args.len() != 1 {
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_builtin_host_arity_diagnostic(method, args.len(), span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    inner: sema_shared_access_guarded_inner(receiver_value.ty) ?? {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    callback_expected: Val(Type.Fn{params: [Type]{inner}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None})
    host_stored: sema_shared_access_is_shared_type(receiver_value.ty) && method == "edit" && scopes.transaction_depth > 0
    callback: if args[0].expr == {
        .Lambda(_, _) -> if host_stored -> sema_expression_lambda_host_callback_stored(args[0].expr, callback_expected, method == "edit", environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_expression_lambda_host_callback(args[0].expr, callback_expected, method == "edit", environment, program, scopes, state, tail_store, context, diagnostics)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
            checked: sema_check_expression(args[0].expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
            diagnostics.push(sema_call_builtin_host_lambda_diagnostic(method, checked.ty, args[0].span))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    callback_value := callback ?? return SemaMethodSpecialCheck{handled: true, value: None}
    callback_result_raw: sema_call_signature_return(callback_value.ty) ?? Type.Named{name: "Unit"}
    callback_result: sema_call_resolved_type(callback_result_raw, environment, program)
    result_type: sema_call_shared_access_result_type(receiver_value.ty, method, callback_result, scopes.transaction_depth)
    if sema_shared_access_is_shared_type(receiver_value.ty) && method == "edit" && scopes.transaction_depth > 0 {
        if callback_value.kind == .Lambda(lambda) {
            moved_lambda := lambda
            moved_lambda.is_move = true
            callback_value.kind = TExprKind.Lambda{value: moved_lambda}
        }
    }
    tree_expr_retype(callback_value, sema_call_host_callback_type(sema_shared_access_guarded_inner(receiver_value.ty) ?? Type.Named{name: "Unit"}, if sema_shared_access_is_shared_type(receiver_value.ty) -> None else -> Val(callback_result), sema_shared_access_is_shared_type(receiver_value.ty)))
    callback_name: sema_shared_access_host_method_name(receiver_value.ty, method)
    if !sema_effect_record_intrinsic_effects(environment, program, scopes, context, callback_name, span, sema_shared_access_effect_row(receiver_value.ty, method, span), diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    // Every write to a cell's value, assignments into it included, is an edit.
    if sema_shared_access_host_method_writes(receiver_value.ty, method) -> sema_scope_record_module_write(receiver, span, environment, scopes, context)
    value: sema_tree_node(result_type, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: callback_name, args: [TExpr]{callback_value}}}, span)
    checked: sema_expr_expected(value, expected, environment, program, diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

// `authority.with(right)` / `authority.without(right)` on the Core Authority
// handle: the narrowing family, each a new handle from the runtime route.
sema_call_try_authority_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "with" && method != "without" -> return SemaMethodSpecialCheck{handled: false, value: None}
    receiver_type: sema_expr_unwrap_tag(receiver_value.ty)
    if receiver_type == .Named(name) {
        if name != "Authority" -> return SemaMethodSpecialCheck{handled: false, value: None}
    } else {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() != 1 {
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_arity_diagnostic("Authority.{method}", 1, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    right: sema_check_expression(args[0].expr, Val(Type.String), environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_effect_record_intrinsic_effects(environment, program, scopes, context, "Authority.{method}", span, [EffectRowEntry]{}, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    handle: TCallArg{value: receiver_value, template_items: [SymbolID]{}, borrow: true, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
    text: TCallArg{value: right, template_items: [SymbolID]{}, borrow: true, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
    reference: TMethodRef{symbol: symbol_id(SymbolKind.Function, "", "JetAuthority", method), name: method, mangled: false, trait_owner: None, operator_identity: None}
    value: sema_tree_node(Type.Named{name: "Authority"}, TExprKind.StaticCall{owner: TStaticOwner.Prelude{rooted: true, path: "JetAuthority", generics: [TPreludeArg]{}}, owner_type: None, method: reference, type_args: [Type]{}, args: [TCallArg]{handle, text}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

// Only the canonical primitive selects this route. Nominal types named Int
// and the Complex magnitude method retain their own method namespaces.
sema_call_try_int_abs_source: fn(receiver: Expr, receiver_value: TExpr, method: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if receiver_value.ty != Type.Int || method != "abs" -> return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 0 {
        diagnostics.push(sema_error("E0104", span, "`Int.abs` expects 0 arguments, got {args.len()}", "the receiver is the exact Int input to core.math.abs", "call `value.abs()`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    identity: sema_call_core_module_identity(environment, program, "core.math") ?? {
        diagnostics.push(sema_error("E0003", span, "Int.abs source module is not loaded", "this receiver operation executes core.math.abs on exact Int values", "load the registered Core math source module"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    target: sema_call_core_source_target(environment, program, identity, "abs", type_args, span, false, diagnostics) ?? {
        diagnostics.push(sema_error("E0003", span, "Int.abs source function is not available", "this receiver operation requires the canonical core.math.abs declaration", "load the registered Core math source function"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    source_args: [CallArg]{CallArg{convention: AccessConvention.Read, expr: receiver, span: expr_span(receiver), flags: ast_empty_call_arg_flags(), label: None, spread: false}}
    scopes.ownership_call_depth += 1
    value := sema_call_core_check_source_owned(target, "Int.abs", type_args, source_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    scopes.ownership_call_depth -= 1
    SemaMethodSpecialCheck{handled: true, value: value}
}

// One pre-candidate seam for compiler-owned method routes. Callers must pass
// the already checked receiver so builtin identity comes from its Type rather
// than from a user spelling or a basename.
sema_call_try_builtin_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    hook: sema_call_try_type_param_hook_method(receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if hook.handled -> return hook
    build: sema_call_try_build_context_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if build.handled -> return build
    compiler: sema_call_try_compiler_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if compiler.handled -> return compiler
    step: sema_call_try_build_step_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if step.handled -> return step
    dev: sema_call_try_dev_context_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if dev.handled -> return dev
    task_control: sema_taskgroup_check_task_control(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if task_control.handled -> return task_control
    if method == "raw" {
        if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        return sema_call_try_distinct_raw_value(receiver_value, args, span, expected, environment, program, scopes, diagnostics)
    }
    measurement: sema_call_try_measurement_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if measurement.handled -> return measurement
    authority: sema_call_try_authority_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if authority.handled -> return authority
    if program.registration_graph == .Val(graph) {
        plugin: sema_call_try_plugin_method(receiver, receiver_value, method, args, span, expected, graph.plugin_facts, environment, program, scopes, state, tail_store, context, diagnostics)
        if plugin.handled -> return plugin
    }
    transaction: sema_call_try_transaction_hook(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if transaction.handled -> return transaction
    sema_call_try_builtin_host_route(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

// Rust `infer_method_call`'s type-parameter dispatch over the compiler's
// synthetic hook traits (register_synthetic_operators,
// register_synthetic_binary_trait): inside a generic body the bounded parameter
// is the trait's `Self`, so `left.compare(right)` with `T: Comparable` takes a
// `T` and yields an `Ordering`, and `left.equal(right)` with `T: Equatable` a
// `Bool`. The checked call is the operator's own comparison, which is how
// codegen lowers a builtin hook method (lower_builtin_binary_method). The first
// bound that declares the method decides, so a registered trait bound keeps its
// candidate path. When no bound declares it, the trait with the least name that
// does is the missing bound (E0901).
sema_call_try_type_param_hook_method: fn(receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    unhandled: SemaMethodSpecialCheck{handled: false, value: None}
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    receiver_name: if receiver_value.ty == {
        .Named(name) -> Val(name)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
    name: receiver_name ?? return unhandled
    parameter := TGenericParam?{None}
    index := environment.generic_params.len()
    loop index > 0 {
        index -= 1
        candidate: environment.generic_params[index]
        if candidate.name == name {
            parameter = Val(candidate)
            break
        }
    }
    current: parameter ?? return unhandled
    hook_trait := String?{None}
    loop bound in current.bounds {
        segments: bound.key.split(":").to_list()
        trait_name: segments[segments.len() - 1]
        if sema_type_builtin_trait_symbol(trait_name) == .Val(builtin) && builtin.id.key == bound.key {
            if owned_trait_operator_hook(trait_name) == (Val(method)) {
                hook_trait = Val(trait_name)
                break
            }
            // A method the bare-bound trait declares takes the candidate path
            // (sema_call_owned_trait_method_candidate), as a registered bound's does.
            if owned_trait(trait_name) == .Val(owned) && owned_trait_declares(owned, method) -> return unhandled
            next
        }
        if program.registration_graph == .Val(graph) {
            row: sema_call_trait_row_for_symbol(graph, bound) ?? next
            if sema_call_trait_row_declares(graph, row, method) -> return unhandled
        }
    }
    if hook_trait == None {
        missing: sema_call_type_param_method_trait(program, method) ?? return unhandled
        diagnostics.push(sema_error("E0901", span, "calling `{method}` needs `{missing}`", "methods on a type parameter require that bound", "add `<T: {missing}>` to the generic parameter list"))
        if owned_trait_operator_hook(missing) != (Val(method)) || (method != "compare" && method != "equal") -> return rejected
        hook_trait = Val(missing)
    }
    if method != "compare" && method != "equal" -> return unhandled
    if args.len() != 1 {
        diagnostics.push(sema_error("E0104", span, "`{method}` expects 1 argument, got {args.len()}", "every argument must match a parameter (not counting `self`)", "check the definition of `{method}` on the trait"))
        return rejected
    }
    argument: sema_check_expression(args[0].expr, Val(receiver_value.ty), environment, program, scopes, state, tail_store, context, diagnostics) ?? return rejected
    assignable: sema_call_type_assignable(receiver_value.ty, argument.ty, environment, program) ?? return rejected
    if !assignable {
        diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{method}` wants {sema_type_show(receiver_value.ty)}, but this is {sema_type_show(argument.ty)}", "every argument must match its parameter's type", sema_type_fix_hint(receiver_value.ty, argument.ty)))
        return rejected
    }
    line: sema_source_line_at(environment.source_segments, span) ?? 0
    ordering: method == "compare"
    op: if ordering -> BinOp.Compare else -> BinOp.Eq
    result_ty: if ordering -> Type.Named{name: "Ordering"} else -> Type.Bool
    value: sema_tree_node(result_ty, TExprKind.Binary{op: sema_expr_tree_binary_op(op), overflow: false, line: line, lhs: receiver_value, rhs: argument}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

// Rust's fallback over every registered trait: the least-named trait that
// declares `method`, the compiler-owned traits (OWNED_TRAITS) included.
sema_call_type_param_method_trait: fn(program: SemaProgramTables, method: String) -> String? {
    best := String?{None}
    loop owned in OWNED_TRAITS {
        if !owned_trait_declares(owned, method) -> next
        if best == .Val(current) && current <= owned.name -> next
        best = Val(owned.name)
    }
    if program.registration_graph == .Val(graph) {
        loop graph_module in graph.modules {
            loop nominal in graph_module.nominals {
                if nominal.kind != SemaRegistrationNominalKind.Trait -> next
                declares: loop trait_method in nominal.trait_methods {
                    if trait_method.declaration.name == method -> break true
                } ?? false
                if !declares -> next
                if best == .Val(current) && current <= nominal.symbol.name -> next
                best = Val(nominal.symbol.name)
            }
        }
    }
    best
}

sema_call_trait_row_declares: fn(graph: SemaRegistrationGraph, row: SemaRegistrationRowRef, method: String) -> Bool Never! {
    loop trait_method in graph.modules[row.module_index].nominals[row.row].trait_methods {
        if trait_method.declaration.name == method -> return true
    }
    false
}

sema_call_method_owner_type: fn(name: String, type_args: [Type]) -> Type Never! {
    if type_args.len() > 0 -> Type.Apply{name: name, args: type_args} else -> Type.Named{name: name}
}

sema_call_method_candidate_from_func: fn(func: Func, module_name: String, owner_name: String, owner_type: Type, trait_name: String?, type_args: [Type], fallback_source_file: String, fallback_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) -> SemaCallMethodCandidate? {
    if func.params.len() == 0 || func.params[0].name != "self" -> return None
    symbol: symbol_id(SymbolKind.Function, module_name, owner_name, func.name)
    raw_signature: sema_function_symbol_type(func, sema_raw_protocol_function_return(trait_name, false, func), symbol, fallback_source_file, fallback_origin, source_segments)
    signature := raw_signature
    if raw_signature == {
        .Fn(params, ret, effects, contract, metadata, provenance) -> {
            if params.len() == 0 -> return None
            updated_params := params.copy()
            updated_params[0] = owner_type
            signature = Type.Fn{params: updated_params, ret: ret, effect_bound: effects, param_contract: contract, call_metadata: metadata, return_view_provenance: provenance}
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
    generic_params: sema_inference_type_params(func.type_params)
    generic_substitutions: sema_inference_bindings_for_type_args(generic_params, type_args)
    if func.type_params.len() > 0 && type_args.len() > 0 {
        if type_args.len() != func.type_params.len() -> return None
        signature = sema_inference_substitute_type_bindings(signature, generic_substitutions)
    }

    mangled: trait_name == None
    trait_owner := SymbolID?{None}
    if trait_name == .Val(trait_name_value) -> trait_owner = Val(symbol_id(SymbolKind.Trait, module_name, "", trait_name_value))

    reference: TMethodRef{symbol: symbol, name: func.name, mangled: mangled, trait_owner: trait_owner, operator_identity: None}
    SemaCallMethodCandidate{
        method: reference,
        signature: signature,
        receiver_type: Val(owner_type),
        receiver_convention: func.params[0].convention,
        receiver_offset: 1,
        type_args: type_args,
        generic_params: generic_params,
        generic_substitutions: generic_substitutions,
        generic_evidence: [SemaInferenceBoundEvidence]{},
    }
}

sema_call_append_local_methods: fn(output: &[SemaCallMethodCandidate], methods: [Func], module_name: String, owner_name: String, owner_type: Type, trait_name: String?, type_args: [Type], fallback_source_file: String, fallback_origin: SemaSourceOrigin, source_segments: [SemaSourceSegment]) Never! {
    loop method in methods {
        if sema_call_method_candidate_from_func(method, module_name, owner_name, owner_type, trait_name, type_args, fallback_source_file, fallback_origin, source_segments) == .Val(candidate_value) {
            output.push(candidate_value)
        }
    }
}

sema_call_local_method_candidates: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, method: String, owner_type_args: [Type], type_args: [Type]) -> [SemaCallMethodCandidate] Never! {
    module_name: environment.module_identity
    candidates := [SemaCallMethodCandidate]{}
    loop declaration_index in 0..<environment.declarations.len() {
        if environment.declarations[declaration_index].item == {
            .Struct(value) -> {
                owner_type: sema_call_method_owner_type(value.name, owner_type_args)
                sema_call_append_local_methods(candidates, value.methods, module_name, value.name, owner_type, None, type_args, environment.source_file, environment.source_origin, environment.source_segments)
            }
            .Enum(value) -> {
                owner_type: sema_call_method_owner_type(value.name, owner_type_args)
                sema_call_append_local_methods(candidates, value.methods, module_name, value.name, owner_type, None, type_args, environment.source_file, environment.source_origin, environment.source_segments)
            }
            .Impl(value) -> {
                owner_type: sema_call_method_owner_type(value.type_name, owner_type_args)
                sema_call_append_local_methods(candidates, value.methods, module_name, value.type_name, owner_type, value.trait_name, type_args, environment.source_file, environment.source_origin, environment.source_segments)
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    filtered: loop candidate in candidates if candidate.method.name == method -> candidate
    filtered
}

sema_call_method_function_for_symbol: fn(target: SymbolID, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Func? {
    loop declaration_index in 0..<environment.declarations.len() {
        if environment.declarations[declaration_index].item == {
            .Struct(value) -> {
                loop method in value.methods {
                    candidate: symbol_id(SymbolKind.Function, environment.module_identity, value.name, method.name)
                    if candidate.key == target.key -> return Val(method)
                }
            }
            .Enum(value) -> {
                loop method in value.methods {
                    candidate: symbol_id(SymbolKind.Function, environment.module_identity, value.name, method.name)
                    if candidate.key == target.key -> return Val(method)
                }
            }
            .Impl(value) -> {
                loop method in value.methods {
                    candidate: symbol_id(SymbolKind.Function, environment.module_identity, value.type_name, method.name)
                    if candidate.key == target.key -> return Val(method)
                }
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    None
}

sema_call_method_callable_abi: fn(candidate: SemaCallMethodCandidate, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaRegistrationCallableABI? {
    if program.registration_graph == .Val(graph) {
        abi: sema_registration_callable_abi(graph, candidate.method.symbol)
        if abi != None -> return abi
    }
    func: sema_call_method_function_for_symbol(candidate.method.symbol, environment, program) ?? return None
    Val(sema_registration_callable_abi_for_func(func))
}

sema_call_local_method_defaults: fn(candidate: SemaCallMethodCandidate, binding: SemaCallBinding, environment: SemaScopeEnvironment, program: SemaProgramTables) -> [SemaCallDefaultValue]? {
    if binding.default_refs.len() == 0 -> return Val([SemaCallDefaultValue]{})
    func: sema_call_method_function_for_symbol(candidate.method.symbol, environment, program) ?? return None
    defaults := [SemaCallDefaultValue]{}
    loop reference in binding.default_refs {
        if reference.owner_key != candidate.method.symbol.key -> return None
        parameter_index: reference.parameter_index
        if parameter_index < 0 || parameter_index >= func.params.len() -> return None
        expression: func.params[parameter_index].default ?? return None
        expression_span: expr_span(expression)
        if expression_span.start != reference.span.start || expression_span.end != reference.span.end -> return None
        source_file: sema_source_file_at(environment.source_segments, reference.source_file, environment.source_origin, expression_span)
        if source_file != reference.source_file -> return None
        defaults.push(SemaCallDefaultValue{reference: reference, expression: expression})
    }
    Val(defaults)
}

sema_call_method_candidate_ready: fn(candidate: SemaCallMethodCandidate, diagnostics: &[Diagnostic], span: Span) -> Bool {
    if candidate.generic_params.len() > 0 && candidate.generic_substitutions.len() != candidate.generic_params.len() {
        diagnostics.push(sema_error("E0904", span, "cannot infer type arguments for `{candidate.method.name}`", "method inference requires argument and receiver types", "provide the method's type arguments explicitly"))
        return false
    }
    if !sema_inference_bounds_checked(candidate.generic_params, candidate.generic_evidence, candidate.generic_substitutions) {
        if candidate.generic_params.len() > 0 {
            diagnostics.push(sema_error("E0905", span, "generic bounds for `{candidate.method.name}` were not resolved", "the shared inference solver must prove every declared bound", "use a registered specialized method candidate"))
            return false
        }
    }
    true
}

sema_call_method_candidate_with_inference: fn(candidate: SemaCallMethodCandidate, result: SemaInferenceResult) -> SemaCallMethodCandidate? {
    if !result.complete -> return None
    specialized := candidate
    specialized.signature = sema_inference_substitute_type_bindings(candidate.signature, result.substitutions)
    specialized.type_args = result.type_args
    specialized.generic_substitutions = result.substitutions
    specialized.generic_evidence = result.evidence
    Val(specialized)
}

sema_call_infer_method_candidate_from_types: fn(candidate: SemaCallMethodCandidate, parameter_types: [Type], arg_types: [Type], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> SemaCallMethodCandidate? {
    if candidate.generic_params.len() == 0 -> return Val(candidate)
    return_type: sema_call_signature_return(candidate.signature) ?? return None
    caller_module: if scopes.frames.len() > 0 -> scopes.frames[0].owner else -> ""
    caller_package: if program.registration_graph == {
        .Val(graph) -> graph.package_identity
        .None -> ""
    }
    context := sema_inference_context(caller_module, caller_package, candidate.generic_params, environment.generic_params, expected)
    result: sema_infer_callable(program.registration_graph, context, parameter_types, return_type, arg_types, candidate.type_args, span, diagnostics) ?? return None
    sema_call_method_candidate_with_inference(candidate, result)
}

sema_call_collect_method_inference_facts: fn(candidate: SemaCallMethodCandidate, receiver_value: TExpr, params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> SemaCallInferenceFacts Never! {
    facts: sema_call_collect_inference_facts(params, binding, args, environment, program, scopes, state, tail_store, context)
    parameter_types := [Type]{}
    argument_types := [Type]{}
    receiver_type := sema_call_method_receiver_type(candidate.signature, candidate.receiver_offset)
    if receiver_type == None -> receiver_type = candidate.receiver_type
    if receiver_type == .Val(receiver_ty) {
        parameter_types.push(receiver_ty)
        argument_types.push(receiver_value.ty)
    }
    loop parameter_type in facts.parameter_types -> parameter_types.push(parameter_type)
    loop argument_type in facts.argument_types -> argument_types.push(argument_type)
    SemaCallInferenceFacts{parameter_types: parameter_types, argument_types: argument_types, waiting: facts.waiting, lambda_returns: facts.lambda_returns}
}

sema_call_method_candidate_types_compatible: fn(candidate: SemaCallMethodCandidate, receiver_type: Type, argument_types: [Type?], binding: SemaCallBinding, params: [SemaCallParam], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    receiver_signature := sema_call_method_receiver_type(candidate.signature, candidate.receiver_offset)
    if receiver_signature == None -> receiver_signature = candidate.receiver_type
    receiver_expected: receiver_signature ?? return false
    receiver_compatible: sema_call_type_assignable(receiver_expected, receiver_type, environment, program) ?? return false
    if !receiver_compatible -> return false
    loop index in 0..<argument_types.len() {
        if argument_types[index] == .Val(offered) {
            if index >= binding.slots.len() -> return false
            slot: binding.slots[index]
            if slot < 0 || slot >= params.len() -> return false
            required: sema_call_parameter_type(params[slot]) ?? return false
            compatible: sema_call_type_assignable(required, offered, environment, program) ?? return false
            if !compatible -> return false
        }
    }
    if expected == .Val(expected_ty) {
        result_type: sema_call_signature_return(candidate.signature) ?? return false
        compatible: sema_call_type_assignable(expected_ty, sema_inference_expected_return_view(result_type, expected_ty), environment, program) ?? return false
        if !compatible -> return false
    }
    true
}

sema_call_resolve_method_with_inference: fn(receiver_type: Type, method: String, args: [CallArg], argument_types: [Type?], expected: Type?, candidates: [SemaCallMethodCandidate], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> SemaCallMethodCandidate? {
    shape_matches := [SemaCallMethodCandidate]{}
    receiver_matches := [SemaCallMethodCandidate]{}
    loop candidate in candidates {
        if candidate.method.name == method {
            if sema_call_method_receiver_candidate_type(candidate) == .Val(expected_value) {
                receiver_compatible: sema_call_type_assignable(expected_value, receiver_type, environment, program) ?? false
                // copy: `candidate` is a row of read parameter `candidates`; the receiver-match list owns this one and the shape-match list may own another
                if receiver_compatible -> receiver_matches.push(candidate.copy())
                if receiver_compatible && sema_call_method_shape_matches(candidate, method, args, span) -> shape_matches.push(candidate.copy())
            }
        }
    }
    if shape_matches.len() == 0 {
        if receiver_matches.len() == 1 {
            reported: diagnostics.len()
            probe := args
            _: sema_call_bind_method(method, receiver_matches[0].signature, receiver_matches[0].receiver_offset, probe, span, diagnostics)
            if diagnostics.len() > reported -> return None
        }
        diagnostics.push(sema_call_missing_method_diagnostic(receiver_type, method, args.len(), span, environment, program))
        return None
    }
    viable := [SemaCallMethodCandidate]{}
    loop candidate in shape_matches {
        probe_args := args
        probe_diagnostics := [Diagnostic]{}
        if sema_call_bind_method(method, candidate.signature, candidate.receiver_offset, probe_args, span, probe_diagnostics) == .Val(binding) {
            if sema_call_params_from_type_after(candidate.signature, candidate.receiver_offset) == .Val(params) {
                parameter_types := [Type]{}
                actual_types := [Type]{}
                if sema_call_method_receiver_type(candidate.signature, candidate.receiver_offset) == .Val(receiver_expected) {
                    parameter_types.push(receiver_expected)
                    actual_types.push(receiver_type.copy())
                }
                loop source_index in 0..<argument_types.len() {
                    if argument_types[source_index] != None && source_index < binding.slots.len() {
                        slot: binding.slots[source_index]
                        if slot >= 0 && slot < params.len() {
                            required: sema_call_parameter_type(params[slot]) ?? return None
                            parameter_types.push(required)
                            actual_types.push(argument_types[source_index] ?? return None)
                        }
                    }
                }
                if sema_call_infer_method_candidate_from_types(candidate, parameter_types, actual_types, expected, environment, program, scopes, span, probe_diagnostics) == .Val(specialized) {
                    specialized_params: sema_call_params_from_type_after(specialized.signature, specialized.receiver_offset) ?? [SemaCallParam]{}
                    if sema_call_method_candidate_types_compatible(specialized, receiver_type, argument_types, binding, specialized_params, expected, environment, program) -> viable.push(specialized)
                }
            }
        }
    }
    if {
        viable.len() == 1 -> Val(viable[0])
        viable.len() > 1 -> {
            diagnostics.push(sema_error("E0772", span, "this call to `{method}` matches more than one callable body", "generic inference left more than one method candidate viable", "add labels or explicit type arguments that select one method"))
            None
        }
        shape_matches.len() == 1 -> Val(shape_matches[0])
        else -> {
            diagnostics.push(sema_error("E0772", span, "this call to `{method}` matches more than one callable body", "the overload set has no unique inferred method", "add labels or type arguments that select one method"))
            None
        }
    }
}

sema_call_host_callback_assignable: fn(required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool? {
    if required == {
        .Fn(required_params, required_return, _, _, _, _) -> {
            if required_return == None {
                if offered == {
                    .Fn(offered_params, _, _, _, _, _) -> {
                        if required_params.len() != offered_params.len() -> return Val(false)
                        loop index in 0..<required_params.len() {
                            compatible: sema_call_type_assignable(required_params[index], offered_params[index], environment, program) ?? return None
                            if !compatible -> return Val(false)
                        }
                        return Val(true)
                    }
                    .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
                }
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    sema_call_type_assignable(required, offered, environment, program)
}

sema_call_typecheck_host_bound_arguments: fn(callee: String, params: [SemaCallParam], abi: SemaRegistrationCallableABI?, apply_lambda_escape_override: Bool, binding: SemaCallBinding, args: &[CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic], host_write: Bool, host_stored: Bool) -> SemaCallTypedArguments? {
    if !sema_call_validate_binding(callee, params, binding, args, span, diagnostics) -> return None
    values := [TExpr]{}
    slots := [Int]{}
    required_types := [Type]{}
    loop index in 0..<args.len() {
        slot: sema_call_bound_slot(binding, binding.sources[index], args[index])
        if slot < 0 || slot >= params.len() -> return None
        parameter: params[slot]
        required_declared: sema_call_argument_parameter_type(parameter, args[index]) ?? {
            diagnostics.push(sema_error("E0112", args[index].span, "this callable parameter has no checked type", "call checking cannot prove an argument safe without the declaration type", "register the complete callable signature"))
            return None
        }
        required: sema_call_resolved_type(required_declared, environment, program)
        decision: sema_call_argument_convention(parameter, args[index])
        if decision != SemaCallConventionDecision.Accepted -> return None
        checked_argument: if args[index].expr == {
            .Lambda(_, _) -> if host_stored -> sema_expression_lambda_host_callback_stored(args[index].expr, Val(required), host_write, environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_expression_lambda_host_callback(args[index].expr, Val(required), host_write, environment, program, scopes, state, tail_store, context, diagnostics)
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> if apply_lambda_escape_override -> sema_check_expression_with_lambda_escapes(args[index].expr, Val(required), environment, program, scopes, state, tail_store, context, sema_call_lambda_escape_policy(parameter, abi), diagnostics) else -> sema_check_expression(args[index].expr, Val(required), environment, program, scopes, state, tail_store, context, diagnostics)
        }
        value: checked_argument ?? return None
        compatible: sema_call_host_callback_assignable(required_declared, value.ty, environment, program) ?? return None
        if !compatible {
            diagnostics.push(sema_type_mismatch(required, value.ty, args[index].span))
            return None
        }
        values.push(value)
        slots.push(slot)
        required_types.push(required)
    }
    Val(SemaCallTypedArguments{values: values, slots: slots, required_types: required_types, source_indices: loop _ in values -> -1})
}

// Whether `key` is a builtin trait identity (sema_type_builtin_trait_symbol).
sema_call_builtin_trait_key: fn(key: String) -> Bool Never! {
    parts: key.split(":").to_list()
    builtin: sema_type_builtin_trait_symbol(parts[parts.len() - 1]) ?? return false
    builtin.id.key == key
}

sema_call_method_checked_from_value: fn(state: &SemaOwnershipState, receiver: Expr, receiver_value: TExpr, candidate: SemaCallMethodCandidate, args: [CallArg], defaults: [SemaCallDefaultValue], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> SemaCallChecked? {
    // Declaration existence selects the method namespace. Check the chosen
    // registered identity's visibility here, never while filtering candidates.
    if program.registration_graph == .Val(graph) {
        visible := Bool?{None}
        if sema_registration_callable_row(graph, candidate.method.symbol.key) == .Val(row) {
            visible = Val(if row == {
                .Function(owner, index) -> sema_registration_visible(graph.modules[owner].functions[index].symbol.visibility, environment.module_identity, environment.package_identity, graph.modules[owner].module_identity, graph.modules[owner].package_identity)
                .Foreign(owner, index) -> sema_registration_visible(graph.modules[owner].foreign_functions[index].symbol.visibility, environment.module_identity, environment.package_identity, graph.modules[owner].module_identity, graph.modules[owner].package_identity)
                .NominalMethod(owner, nominal, index) -> sema_registration_visible(graph.modules[owner].nominals[nominal].methods[index].symbol.visibility, environment.module_identity, environment.package_identity, graph.modules[owner].module_identity, graph.modules[owner].package_identity)
                .ImplMethod(owner, implementation, index) -> sema_registration_visible(graph.modules[owner].impls[implementation].methods[index].symbol.visibility, environment.module_identity, environment.package_identity, graph.modules[owner].module_identity, graph.modules[owner].package_identity)
            })
        } else if candidate.method.trait_owner == .Val(owner) {
            // A builtin trait owner (sema_type_builtin_trait_symbol: `Mul`
            // on an operator hook) has no row and is visible everywhere.
            if sema_type_graph_nominal_row(graph, owner.key) == .Val(row) {
                visible = Val(sema_call_trait_visible(graph, graph.modules[row.module_index].nominals[row.row], environment.module_identity, environment.package_identity))
            } else if !sema_call_builtin_trait_key(owner.key) {
                panic("selected trait method has no canonical owner row")
            }
        } else if candidate.method.mangled {
            panic("selected registered method has no canonical callable row")
        }
        // Only existing non-mangled host references lack a registered row.
        // Graph-free local checks retain their existing declaration rules.
        if !(visible ?? true) {
            name: candidate.method.name
            diagnostics.push(sema_error("E0605", span, "`{name}` is private to its module", "a `priv` method is usable only inside the module that declares it", "call `{name}` from inside its module, or remove `priv` from it"))
            return None
        }
    }
    resolved_candidate := candidate
    params := sema_call_params_from_type_after(resolved_candidate.signature, resolved_candidate.receiver_offset) ?? return None
    source_args := args
    checked_args := args
    binding := sema_call_bind_method(resolved_candidate.method.name, resolved_candidate.signature, resolved_candidate.receiver_offset, checked_args, span, diagnostics) ?? return None
    if resolved_candidate.generic_params.len() > 0 && resolved_candidate.generic_substitutions.len() != resolved_candidate.generic_params.len() {
        inferred_facts := sema_call_collect_method_inference_facts(resolved_candidate, receiver_value, params, binding, source_args, environment, program, scopes, state, tail_store, context)
        inferred: sema_call_infer_method_candidate_from_types(resolved_candidate, inferred_facts.parameter_types, inferred_facts.argument_types, expected, environment, program, scopes, span, diagnostics) ?? return None
        resolved_candidate = inferred
        params = sema_call_params_from_type_after(resolved_candidate.signature, resolved_candidate.receiver_offset) ?? return None
        checked_args = args
        binding = sema_call_bind_method(resolved_candidate.method.name, resolved_candidate.signature, resolved_candidate.receiver_offset, checked_args, span, diagnostics) ?? return None
    }
    if !sema_call_method_candidate_ready(resolved_candidate, diagnostics, span) -> return None
    receiver_type: sema_call_method_receiver_candidate_type(resolved_candidate) ?? return None
    receiver_compatible: sema_call_type_assignable(receiver_type, receiver_value.ty, environment, program) ?? return None
    if !receiver_compatible {
        diagnostics.push(sema_type_mismatch(receiver_type, receiver_value.ty, receiver_value.span))
        return None
    }
    host_method: sema_shared_access_host_method(receiver_value.ty, resolved_candidate.method.name)
    if sema_shared_access_user_method_forbidden(receiver_value.ty, resolved_candidate.method.name, checked_args) {
        diagnostics.push(sema_call_shared_access_forbidden_diagnostic(resolved_candidate.method.name, span))
        return None
    }
    resolved_binding := binding
    resolved_defaults := defaults
    if binding.default_refs.len() > 0 {
        if resolved_defaults.len() == 0 {
            if program.registration_graph == {
                .Val(graph) -> {
                    registered_defaults: sema_call_registration_defaults(graph, binding) ?? {
                        diagnostics.push(sema_error("E0906", span, "a default argument for this method could not be resolved", "registered callable defaults retain their graph identity and source location", "make every bound default available to Registration before checking this method"))
                        return None
                    }
                    resolved_defaults = registered_defaults
                }
                .None -> {
                    local_defaults: sema_call_local_method_defaults(resolved_candidate, binding, environment, program) ?? {
                        diagnostics.push(sema_error("E0906", span, "a default argument for this method could not be resolved", "callable defaults retain their owning declaration and source identity", "resolve the declaration before checking this method"))
                        return None
                    }
                    resolved_defaults = local_defaults
                }
            }
        }
        resolved: sema_call_materialize_defaults(params, binding, checked_args, resolved_defaults, span, diagnostics) ?? return None
        resolved_binding = resolved
    }
    abi: sema_call_method_callable_abi(resolved_candidate, environment, program)
    host_stored: sema_shared_access_is_shared_type(receiver_value.ty) && resolved_candidate.method.name == "edit" && scopes.transaction_depth > 0
    typed_option: if host_method -> sema_call_typecheck_host_bound_arguments(resolved_candidate.method.name, params, abi, true, resolved_binding, checked_args, environment, program, scopes, state, tail_store, context, span, diagnostics, sema_shared_access_host_method_writes(receiver_value.ty, resolved_candidate.method.name), host_stored) else -> sema_call_typecheck_bound_arguments(resolved_candidate.method.name, params, abi, true, resolved_binding, checked_args, environment, program, scopes, state, tail_store, context, span, diagnostics, false)
    typed: typed_option ?? return None
    consumer: "`{sema_call_method_leaf(sema_call_receiver_method_label(receiver_type))}.{resolved_candidate.method.name}`"
    // A taking receiver read in place (`items[i].lease.release()`, a field of a
    // read receiver) leaves its place still owning the value: a resource taken
    // from there would be closed by the taker and again by its place (E0211, as
    // for a taking argument).
    if resolved_candidate.receiver_convention == AccessConvention.Move && !sema_copy_site_refuse_resource_copy(receiver_value, environment, program, scopes, context, diagnostics) -> return None
    ownership: sema_ownership_check_two_phase_method_call(state, resolved_candidate.method.name, consumer, receiver, resolved_candidate.receiver_convention, true, params, checked_args, scopes, span, span, diagnostics)
    if !ownership.accepted || !ownership.complete -> return None
    lowered := sema_call_lower_bound_arguments(typed, params, checked_args, environment, program)
    if !sema_call_prepare_variadic_elements(typed, params, checked_args, lowered, environment, program, scopes, state, context, diagnostics) -> return None
    pins := [TStmt]{}
    pinned_receiver := receiver_value
    if typed.pin_arguments {
        access: resolved_candidate.receiver_convention
        borrowed: access != AccessConvention.Move && sema_ownership_places_from_expr_in_state(receiver, scopes, state).len() > 0
        pin_slot: -typed.values.len() - 1
        owner: sema_scope_function_owner_key(scopes)
        symbol: sema_call_binder_ref_symbol(environment, program, owner, typed.binder_site, pin_slot, "receiver", receiver_value.ty, span)
        local := checked_symbol_local("binder_ref_{typed.binder_site}_{pin_slot}", span, symbol.id, receiver_value.ty)
        local.generated = true
        local.mutable = access == AccessConvention.Write
        local.deref = borrowed
        init := receiver_value
        if borrowed -> init = sema_tree_node(init.ty, TExprKind.Borrow{place: init, access: access}, init.span)
        pins.push(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: init, gc_promotion: None, gc_transferred: false, span: span})
        value: sema_tree_node(receiver_value.ty, TExprKind.Local{local: local}, receiver_value.span)
        pinned_receiver = if access == AccessConvention.Move -> sema_tree_node(value.ty, TExprKind.Move{value: value}, value.span) else -> value
    }
    loop pin in sema_call_pin_binder_arguments(typed, params, lowered, environment, program, scopes, span) -> pins.push(pin)
    lowered = sema_call_pack_variadic_arguments(typed, params, lowered, environment, program, context, span, diagnostics) ?? return None
    result_type_raw: sema_call_signature_return(resolved_candidate.signature) ?? return None
    result_type_declared: sema_call_resolved_type(result_type_raw, environment, program)
    transaction_depth: scopes.transaction_depth
    result_type: sema_call_shared_access_result_type(receiver_value.ty, resolved_candidate.method.name, result_type_declared, transaction_depth)
    call_receiver := pinned_receiver
    contract_bindings := [TStmt]{}
    contract_nodes := [TContract]{}
    // The callee's declaration is copied only when a call checks its clauses.
    contract_callee := Func?{None}
    if sema_contract_function_checks_calls(environment, program, resolved_candidate.method.symbol) -> contract_callee = sema_contract_function_for_symbol(environment, program, resolved_candidate.method.symbol)
    if contract_callee == .Val(contract) {
        receiver_arg: TCallArg{value: call_receiver, template_items: [SymbolID]{}, borrow: resolved_candidate.receiver_convention == AccessConvention.Read && !sema_call_is_scalar(call_receiver.ty), mut_borrow: resolved_candidate.receiver_convention == AccessConvention.Write, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: sema_call_box_as_trait(receiver_type, call_receiver.ty, environment, program), label: None, spread: false}
        all_args := [TCallArg]{receiver_arg}
        loop argument in lowered -> all_args.push(argument)
        receiver_slot: resolved_candidate.receiver_offset - 1
        slots := [Int]{receiver_slot}
        loop slot in 0..<params.len() -> slots.push(slot + resolved_candidate.receiver_offset)
        checked_contract: sema_contract_check_call(contract, resolved_candidate.method.symbol, None, all_args, slots, span, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        call_receiver = all_args[0].value
        lowered = [TCallArg]{}
        loop index in 1..<all_args.len() -> lowered.push(all_args[index])
        contract_bindings = checked_contract.bindings
        contract_nodes = checked_contract.contracts
    }
    call_value := sema_tree_node(result_type, TExprKind.MethodCall{receiver: call_receiver, method: resolved_candidate.method, type_args: resolved_candidate.type_args, args: lowered}, span)
    if host_method && lowered.len() > 0 {
        callback := lowered[0].value
        if host_stored {
            if callback.kind == .Lambda(lambda) {
                moved_lambda := lambda
                moved_lambda.is_move = true
                callback.kind = TExprKind.Lambda{value: moved_lambda}
            }
        }
        tree_expr_retype(callback, sema_call_host_callback_type(sema_shared_access_guarded_inner(receiver_value.ty) ?? Type.Named{name: "Unit"}, if sema_shared_access_is_shared_type(receiver_value.ty) -> None else -> Val(result_type), sema_shared_access_is_shared_type(receiver_value.ty)))
        callback_name: sema_shared_access_host_method_name(receiver_value.ty, resolved_candidate.method.name)
        call_value = sema_tree_node(result_type, TExprKind.HostCall{call: THostCall.Method{receiver: call_receiver, method: callback_name, args: [TExpr]{callback}}}, span)
    }
    contracted: if {
        contract_nodes.len() > 0 -> {
            wrapped := contract_bindings
            loop contract in contract_nodes -> wrapped.push(TStmt.Contract{contract: contract})
            wrapped.push(TStmt.ExprStmt{value: call_value, span: span})
            sema_tree_node(result_type, TExprKind.InlineBlock{body: wrapped}, span)
        }
        else -> call_value
    }
    value: sema_call_with_binder_pins(pins, contracted, span)
    checked: sema_expression_call_expected(value, expected, environment, program, context, diagnostics) ?? return None
    facts := sema_call_facts(resolved_candidate.signature, resolved_candidate.type_args, resolved_binding) ?? return None
    // The host access replaces the declared call, so its row is the host
    // operation's own, never the absent callee's.
    if host_method -> facts.effect_bound = Val(sema_shared_access_effect_row(receiver_value.ty, resolved_candidate.method.name, span))
    return_view_facts: if sema_call_method_summary_signature(resolved_candidate, scopes) == {
        .Val(summary_signature) -> sema_call_return_view_facts(summary_signature, Val(receiver), checked_args, resolved_binding, scopes, state, span, diagnostics)
        .None -> sema_call_return_view_facts(resolved_candidate.signature, Val(receiver), checked_args, resolved_binding, scopes, state, span, diagnostics)
    }
    Val(SemaCallChecked{value: checked, binding: resolved_binding, facts: facts, return_view_facts: return_view_facts})
}

// A method's inferred return-view summary is published in the module scope
// (sema_check_view_summary_method), not on its candidate's signature, which
// holds only a declared `from` contract. The signature with the summary in
// place, or None when the candidate has a contract or no summary.
sema_call_method_summary_signature: fn(candidate: SemaCallMethodCandidate, scopes: SemaScopeTable) -> Type? {
    if candidate.signature == .Fn(params, ret, effects, contract, metadata, provenance) {
        if provenance == None {
            if scopes.method_return_views.get(candidate.method.symbol.key) == .Val(summary) {
                // copy: the payloads belong to read parameter `candidate`, which keeps its signature;
                // the summary stays published in `scopes`.
                return Val(Type.Fn{params: params.copy(), ret: ret.copy(), effect_bound: effects.copy(), param_contract: contract.copy(), call_metadata: metadata.copy(), return_view_provenance: Val(summary.copy())})
            }
        }
    }
    None
}

sema_call_check_method_candidate_from_value_owned: fn(state: &SemaOwnershipState, receiver: Expr, receiver_value: TExpr, candidate: SemaCallMethodCandidate, args: [CallArg], defaults: [SemaCallDefaultValue], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaCallChecked? {
    sema_call_method_checked_from_value(state, receiver, receiver_value, candidate, args, defaults, expected, environment, program, scopes, tail_store, context, span, diagnostics)
}

sema_call_check_method_candidate_owned: fn(state: &SemaOwnershipState, receiver: Expr, candidate: SemaCallMethodCandidate, args: [CallArg], defaults: [SemaCallDefaultValue], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaCallChecked? {
    receiver_value: sema_check_expression(receiver, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    sema_call_method_checked_from_value(state, receiver, receiver_value, candidate, args, defaults, expected, environment, program, scopes, tail_store, context, span, diagnostics)
}

sema_call_check_method: fn(state: &SemaOwnershipState, receiver: Expr, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    receiver_value: sema_check_expression(receiver, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    routed_method: core_source_receiver_method(if core_source_receiver_method_routes(method, args.len()) -> sema_expr_receiver_nominal_identity(environment, program, receiver_value.ty) else -> type_name(receiver_value.ty), method, args.len())
    candidates := sema_call_local_method_candidates(environment, program, routed_method, owner_type_args, type_args)
    if program.registration_graph == .Val(graph) {
        trait_candidates: sema_call_trait_method_candidates(graph, receiver_value.ty, routed_method, type_args, environment.module_identity, environment.package_identity, environment.generic_params, method_span, diagnostics)
        if trait_candidates.len() > 0 -> candidates = trait_candidates
    }
    candidate: sema_call_resolve_method(receiver_value.ty, routed_method, args, method_span, candidates, environment, program, diagnostics) ?? return None
    checked: sema_call_method_checked_from_value(state, receiver, receiver_value, candidate, args, [SemaCallDefaultValue]{}, expected, environment, program, scopes, tail_store, context, span, diagnostics) ?? return None
    Val(checked.value)
}

// App handler registrations. Each handler reaches the App graph as one
// `fn(__AppCall) -> __AppReply` adapter written over the named handler: the
// adapter decodes the handler's typed inputs from the call (route path and
// search inputs, the loader's data, a server function's body, a mount's
// path), answers an input that is missing or does not decode as a
// rejection, and wraps the result as a page or JSON reply. The registration
// then checks as the App source method that stores the adapter.
sema_app_handler_arity: fn(method: String, actual: Int) -> Int Never! {
    if method == {
        "route" | "page" | "layout" | "action" | "form" | "data" -> 2
        "loader" -> if actual == 3 -> 3 else -> 2
        "mount" -> if actual == 3 || actual == 4 -> actual else -> 2
        "pending" | "not_found" | "error" -> 1
        else -> -1
    }
}

sema_app_ident: fn(name: String, span: Span) -> Expr Never! {
    Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
}

sema_app_text: fn(text: String, span: Span) -> Expr Never! {
    Expr.Str{parts: [StrPart]{StrPart.Lit{text: text}}, span: span, id: AST_NODE_GENERATED}
}

sema_app_arg: fn(expr: Expr, convention: AccessConvention, span: Span) -> CallArg Never! {
    CallArg{convention: convention, expr: expr, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
}

sema_app_call_method: fn(call: String, method: String, type_args: [Type], args: [CallArg], span: Span) -> Expr Never! {
    Expr.MethodCall{receiver: sema_app_ident(call, span), method: method, method_span: span, owner_type_args: [Type]{}, type_args: type_args, args: args, id: AST_NODE_GENERATED}
}

sema_app_returns_unit: fn(ty: Type?) -> Bool Never! {
    if ty == {
        .Val(declared) -> if declared == {
            .Named(name) -> name == "Unit"
            .Result(ok, _) -> ok == (Type.Named{name: "Unit"})
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        .None -> true
    }
}

// Whether a handler's declared result fails with a domain of its own rather
// than the open `Err`.
sema_app_typed_failure: fn(ty: Type) -> Bool Never! {
    if ty == .Result(_, failure) -> return failure != (Type.Named{name: "Err"})
    false
}

// The success type a handler declares (`T` of `T E!`).
sema_app_success_type: fn(ty: Type) -> Type Never! {
    if ty == .Result(ok, _) -> return ok
    ty.copy()
}

// `input ?? return Ok(call.__rejected("name"))`: an input that is missing or
// does not decode answers the request without entering the handler.
sema_app_or_rejected: fn(input: Expr, call: String, name: String, span: Span) -> Expr Never! {
    rejected: sema_app_call_method(call, "__rejected", [Type]{}, [CallArg]{sema_app_arg(sema_app_text(name, span), AccessConvention.Read, span)}, span)
    Expr.OrFallback{value: input, fallback: OrFallback.Return{value: Val(Expr.Ok{value: rejected, span: span, id: AST_NODE_GENERATED}), span: span}, is_option: true, span: span, id: AST_NODE_GENERATED}
}

// The parameter of the adapter lambda over an App handler.
SEMA_APP_ADAPTER_PARAM: "__jet_app_call"

// The adapter over the named handler `name`. `None` after an E2810 when the
// handler's inputs cannot come from an App call.
sema_app_handler_adapter: fn(method: String, name: String, function: SemaRegistrationFunction, graph: SemaRegistrationGraph, span: Span, diagnostics: &[Diagnostic]) -> Expr? {
    call: SEMA_APP_ADAPTER_PARAM
    params: function.declaration.params
    boundary: method == "pending" || method == "not_found" || method == "error"
    server: method == "action" || method == "form" || method == "data"
    if (boundary && params.len() != 0) || ((server || method == "mount") && params.len() > 1) || (method == "mount" && params.len() == 0) {
        inputs: if {
            boundary -> "no inputs"
            method == "mount" -> "one input, the request path"
            else -> "at most one input, the decoded request body"
        }
        diagnostics.push(sema_error("E2810", span, "App `{method}` handler `{name}` takes {params.len()} input(s)", "an App `{method}` handler takes {inputs}", "change `{name}` to take {inputs}"))
        return None
    }
    body := [Stmt]{}
    handler_args := [CallArg]{}
    loop (index, parameter) in params {
        if method == "mount" {
            handler_args.push(sema_app_arg(sema_app_call_method(call, "__path", [Type]{}, [CallArg]{}, span), AccessConvention.Read, span))
            next
        }
        ty: sema_type_resolve_declared(graph, parameter.ty, function.symbol.module_name)
        optional: if ty == {
            .Option(inner) -> Val(inner)
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
        }
        decoder: if {
            server -> "__body"
            parameter.name == "data" && method != "loader" -> "__data"
            else -> "__input"
        }
        decoder_args: if decoder == "__input" -> [CallArg]{sema_app_arg(sema_app_text(parameter.name, span), AccessConvention.Read, span)} else -> [CallArg]{}
        input: sema_app_call_method(call, decoder, [Type]{optional ?? ty}, decoder_args, span)
        local: "__jet_app_input_{index}"
        // An optional input stays optional: an absent one is `None`, not a
        // rejection.
        value: if optional == None -> sema_app_or_rejected(input, call, parameter.name, span) else -> input
        body.push(Stmt.Val{binding: ast_binding(local, span, false, value, None)})
        handler_args.push(sema_app_arg(sema_app_ident(local, span), AccessConvention.Read, span))
    }
    direct_call: Expr.Call{call: Call{name: name, name_span: span, type_args: [Type]{}, args: handler_args}, id: AST_NODE_GENERATED}
    // A handler's own failure domain (`-> T OrderError!`) has no conversion
    // into the adapter's `Err`; it answers the request as a failed reply,
    // which the route's error boundary renders.
    typed_failure: if function.declaration.return_type == {
        .Val(declared) -> sema_app_typed_failure(sema_type_resolve_declared(graph, declared, function.symbol.module_name))
        .None -> false
    }
    failure_text: Expr.Str{parts: [StrPart]{StrPart.Lit{text: "the `{name}` handler failed: "}, StrPart.Interp{expr: sema_app_ident("err", span), format: StrFormat.Display}}, span: span, id: AST_NODE_GENERATED}
    failed: sema_app_call_method(call, "__failed", [Type]{}, [CallArg]{sema_app_arg(failure_text, AccessConvention.Read, span)}, span)
    handler_call: if typed_failure -> Expr.OrFallback{value: direct_call, fallback: OrFallback.Return{value: Val(Expr.Ok{value: failed, span: span, id: AST_NODE_GENERATED}), span: span}, is_option: false, span: span, id: AST_NODE_GENERATED} else -> direct_call
    reply := sema_app_call_method(call, "__done", [Type]{}, [CallArg]{}, span)
    if method == "mount" || sema_app_returns_unit(function.declaration.return_type) {
        body.push(Stmt.Expr{expr: handler_call})
    } else {
        wrap: if method == "loader" || server -> "__json" else -> "__page"
        // `__json` encodes the handler's success value; naming it keeps a
        // failing handler (`-> T E!`) from leaving `Value` uninferred.
        wrap_types: if wrap == "__json" && function.declaration.return_type == .Val(declared) -> [Type]{sema_app_success_type(sema_type_resolve_declared(graph, declared, function.symbol.module_name))} else -> [Type]{}
        reply = sema_app_call_method(call, wrap, wrap_types, [CallArg]{sema_app_arg(handler_call, AccessConvention.Read, span)}, span)
    }
    body.push(Stmt.Expr{expr: reply})
    call_param: LambdaParam{name: call, name_span: span, ty: None, ty_span: None, convention: AccessConvention.Read}
    Val(Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: [LambdaParam]{call_param}, effects: None, body: LambdaBody.Block{body: body}, span: span, meta: ast_empty_lambda_meta()}, id: AST_NODE_GENERATED})
}

// The named function an App registration argument passes, after an E2810
// when it is not one.
sema_app_named_handler: fn(method: String, argument: CallArg, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> (name: String, function: SemaRegistrationFunction)? {
    name: sema_http_mux_callee(argument.expr) ?? {
        diagnostics.push(sema_error("E2810", argument.span, "App `{method}` requires a named handler", "the statically checked App graph retains the handler's typed input and effect contract", "declare the handler as a function and pass its name"))
        return None
    }
    function: sema_http_route_find_function(environment, program, scopes, name) ?? {
        diagnostics.push(sema_error("E2810", argument.span, "App `{method}` requires a function handler, and `{name}` is not a declared function", "the registered handler must be callable through its checked input contract", "pass the name of a declared function"))
        return None
    }
    Val((name: name, function: function))
}

sema_app_route_wire_type: fn(ty: Type) -> String Never! {
    if ty == {
        .Int -> "Int"
        .Float -> "Float"
        .Bool -> "Bool"
        .String -> "String"
        .Named(name) -> name
        .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> type_name(ty)
    }
}

sema_app_route_binding: fn(method: String, handler: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, host_hooks: SemaHostHookAccess?) -> String {
    shape: sema_http_route_shape(handler, environment, program, scopes, host_hooks, None) ?? return ""
    parts := [String]{}
    loop parameter in shape.params {
        if parameter.name == "data" && method != "loader" {
            parts.push("d")
            next
        }
        ty := parameter.ty
        optional := false
        if ty == .Option(inner) {
            ty = inner
            optional = true
        }
        if sema_http_route_find_struct(environment, program, ty, shape.module_identity) == .Val(definition) {
            fields := [String]{}
            loop field in definition.fields {
                field_type := field.ty
                suffix := ""
                if field_type == .Option(inner) {
                    field_type = inner
                    suffix = "?"
                }
                fields.push("{field.name}={sema_app_route_wire_type(field_type)}{suffix}")
            }
            parts.push("s=json:{fields.join(",")}")
            next
        }
        suffix: if optional -> "?" else -> ""
        wire: "{sema_app_route_wire_type(ty)}{suffix}"
        parts.push(if parameter.name == "search" || parameter.name == "query" -> "s=query:{parameter.name}={wire}" else -> "p:{parameter.name}={wire}")
    }
    parts.join(";")
}

// The text of a plain string literal with no interpolation.
sema_app_literal_text: fn(expression: Expr) -> String? Never! {
    if expression == .Str(parts, _, _) {
        text := ""
        loop part in parts {
            if part == .Lit(value) { text = "{text}{value}" } else { return None }
        }
        return Val(text)
    }
    None
}

// One route the App chain registers: its canonical path, where it came from
// (`builder` or the convention file), the span it reports at, and whether a
// `.routes(from:)` convention file made it.
SemaAppRouteRegistration: struct {
    path: String
    provenance: String
    span: Span
    convention: Bool
}

SemaAppRoutePart: struct {
    kind: Int
    name: String
}

// The App graph's route check at one registering call. Every registration
// the call makes is checked against the registrations earlier in its builder
// chain and its own earlier files, so each pair is checked once, at the later
// call. A pair reports as the graph orders it: builder entries before
// convention files, and otherwise in chain order.
sema_app_check_route_registrations: fn(receiver: Expr, method: String, args: [CallArg], span: Span, environment: SemaScopeEnvironment, graph: SemaRegistrationGraph, diagnostics: &[Diagnostic]) {
    if args.len() == 0 -> return
    text: sema_app_literal_text(args[0].expr) ?? return
    roots: sema_app_route_roots(environment, graph)
    current := [SemaAppRouteRegistration]{}
    if method == "routes" {
        if args.len() != 1 -> return
        current = sema_app_expand_route_root(roots, text, span, diagnostics)
    } else {
        current.push(SemaAppRouteRegistration{path: sema_app_canonical_route_path(text), provenance: "builder", span: span, convention: false})
    }
    pool := [SemaAppRouteRegistration]{}
    sema_app_chain_registrations(receiver, roots, pool)
    loop registration in current {
        if sema_app_route_conflict(pool, registration, diagnostics) -> next
        pool.push(registration)
    }
}

sema_app_route_conflict: fn(pool: [SemaAppRouteRegistration], registration: SemaAppRouteRegistration, diagnostics: &[Diagnostic]) -> Bool {
    loop previous in pool {
        if previous.path != registration.path -> next
        swap: previous.convention && !registration.convention
        first: if swap -> registration else -> previous
        second: if swap -> previous else -> registration
        row: diagnostic_registry_row("E2807") ?? panic("E2807 must have a registry row")
        diagnostics.push(sema_error("E2807", second.span, "Route `{second.path}` is registered both by `{first.provenance}` and `{second.provenance}`", row.why, row.fix))
        if first.span != second.span {
            diagnostics.push(sema_error("E2807", first.span, "Earlier registration of route `{first.path}`", "both spans are kept so the provenance of each registration stays visible", "delete or rename this registration"))
        }
        return true
    }
    loop previous in pool {
        if !sema_app_routes_overlap(previous.path, registration.path) -> next
        if sema_app_route_static_parts(previous.path) != sema_app_route_static_parts(registration.path) || sema_app_route_parts(previous.path).len() != sema_app_route_parts(registration.path).len() -> next
        swap: previous.convention && !registration.convention
        first: if swap -> registration else -> previous
        second: if swap -> previous else -> registration
        diagnostics.push(sema_error("E2807", second.span, "Routes `{first.path}` and `{second.path}` are ambiguous", "the route graph matches static parts before dynamic ones, so two equally specific overlapping patterns have no deterministic owner", "make one pattern more specific, or remove the duplicate dynamic shape"))
        return true
    }
    false
}

// The routes the builder chain ending at `expression` registers, in chain
// order. Convention files a root cannot route are left out; their own call
// reports them.
sema_app_chain_registrations: fn(expression: Expr, roots: [AppRouteRoot], registrations: &[SemaAppRouteRegistration]) {
    if expression == .MethodCall(receiver, method, method_span, _, _, args, _) {
        sema_app_chain_registrations(receiver, roots, registrations)
        if args.len() == 0 -> return
        text: sema_app_literal_text(args[0].expr) ?? return
        if method == "routes" && args.len() == 1 {
            unreported := [Diagnostic]{}
            loop registration in sema_app_expand_route_root(roots, text, method_span, unreported) {
                if !sema_app_route_conflict(registrations, registration, unreported) -> registrations.push(registration)
            }
        } else if method == "route" || method == "page" || method == "layout" {
            registration: SemaAppRouteRegistration{path: sema_app_canonical_route_path(text), provenance: "builder", span: method_span, convention: false}
            unreported := [Diagnostic]{}
            if !sema_app_route_conflict(registrations, registration, unreported) -> registrations.push(registration)
        }
    }
}

// The routes the convention files under one `.routes(from:)` root register,
// reporting each file the root cannot route (E2806).
sema_app_expand_route_root: fn(roots: [AppRouteRoot], name: String, span: Span, diagnostics: &[Diagnostic]) -> [SemaAppRouteRegistration] {
    registrations := [SemaAppRouteRegistration]{}
    found := AppRouteRoot?{None}
    loop root in roots {
        if root.root == name && root.found -> found = Val(root)
    }
    root: found ?? {
        diagnostics.push(sema_error("E2806", span, "`.routes(from: \"{name}\")` directory does not exist", "file routing expands only an explicit builder root; a missing directory cannot invent endpoints", "create `{name}/`, or remove the `.routes(from:)` line"))
        return registrations
    }
    loop file in root.files {
        provenance: "{name}/{file.path}"
        if !file.has_page {
            row: diagnostic_registry_row("E2806") ?? panic("E2806 must have a registry row")
            diagnostics.push(sema_error("E2806", span, "Convention file `{provenance}` has no `page: fn`", row.why, row.fix))
            next
        }
        address: app_route_file_address(file.path)
        if address.bad_part == .Val(part) {
            diagnostics.push(sema_error("E2806", span, "Convention file `{provenance}` has an unsupported bracket part `{part}`", "a bracket part must be one whole `[name]` that captures one address part", "rename the part to `[name]`, such as `[id]`"))
            next
        }
        registrations.push(SemaAppRouteRegistration{path: address.path, provenance: provenance, span: span, convention: true})
    }
    registrations
}

// The convention roots the current module's driver pass read.
sema_app_route_roots: fn(environment: SemaScopeEnvironment, graph: SemaRegistrationGraph) -> [AppRouteRoot] {
    row: sema_app_module_row(environment, graph)
    if row < 0 -> return [AppRouteRoot]{}
    graph.modules[row].program.app_route_roots
}

// `{name}` parts are spelled `:name` in the graph.
sema_app_canonical_route_path: fn(path: String) -> String {
    parts := [String]{}
    loop segment in path.split("/") {
        if segment.len() > 2 && segment.starts_with("{{") && segment.ends_with("}}") {
            parts.push(":{segment.slice(1, segment.len() - 1)}")
        } else {
            parts.push(segment)
        }
    }
    parts.join("/")
}

// Each address part: 0 static, 1 `:name`, 2 `*name` catch-all.
sema_app_route_parts: fn(path: String) -> [SemaAppRoutePart] {
    parts := [SemaAppRoutePart]{}
    loop segment in sema_app_canonical_route_path(path).split("/") {
        if segment == "" -> next
        if segment.starts_with("*") {
            parts.push(SemaAppRoutePart{kind: 2, name: segment.slice(1, segment.len())})
        } else if segment.starts_with(":") {
            parts.push(SemaAppRoutePart{kind: 1, name: segment.slice(1, segment.len())})
        } else {
            parts.push(SemaAppRoutePart{kind: 0, name: segment})
        }
    }
    parts
}

sema_app_route_static_parts: fn(path: String) -> Int {
    count := 0
    loop part in sema_app_route_parts(path) {
        if part.kind == 0 -> count += 1
    }
    count
}

sema_app_routes_overlap: fn(left_path: String, right_path: String) -> Bool {
    left: sema_app_route_parts(left_path)
    right: sema_app_route_parts(right_path)
    left_catch: left.len() > 0 && left[left.len() - 1].kind == 2
    right_catch: right.len() > 0 && right[right.len() - 1].kind == 2
    if !left_catch && !right_catch && left.len() != right.len() -> return false
    loop index in 0..<left.len() {
        if index >= right.len() -> break
        if left[index].kind == 2 || right[index].kind == 2 -> return true
        if left[index].kind == 0 && right[index].kind == 0 && left[index].name != right[index].name -> return false
    }
    left.len() == right.len() || left_catch || right_catch
}

// The App graph route check for a registering call on an App builder. It runs
// beside the method's own check: `.routes(from:)` is Core's declared method,
// so the check site calls it before declared-method resolution.
sema_call_app_route_registrations: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) {
    receiver_type: sema_call_resolved_type(receiver_value.ty, environment, program)
    if receiver_type != (Type.Named{name: "App"}) && receiver_type != (Type.Named{name: "<corelib>/core.web::App"}) -> return
    graph: program.registration_graph ?? return
    sema_app_check_route_registrations(receiver, method, args, span, environment, graph, diagnostics)
}

// The App capability check for a browser feature: `.csr`, `.island` and the
// hydration modes need target JS (a `Web` or `JS` build). The target is the
// enclosing function's `#Target(JS|Wasm)` pin, else its file's `#Target`;
// an unpinned function has no resolved web target yet and is not checked.
sema_call_app_browser_feature: fn(receiver_value: TExpr, method: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, function_name: String, diagnostics: &[Diagnostic]) {
    receiver_type: sema_call_resolved_type(receiver_value.ty, environment, program)
    if receiver_type != (Type.Named{name: "App"}) && receiver_type != (Type.Named{name: "<corelib>/core.web::App"}) -> return
    graph: program.registration_graph ?? return
    row: sema_app_module_row(environment, graph)
    if row < 0 -> return
    source: graph.modules[row].program
    target := ""
    loop item in source.items {
        if item == .Func(function) && function.name == function_name && function.web_marker == .Val(marker) {
            target = if marker == .JS -> "JS" else -> "Wasm"
        }
    }
    if target == "" && source.web_target_ceiling == .Val(bucket) -> target = sema_web_bucket_name(bucket)
    if target == "" && (source.default_target ?? "") == "web" -> target = "Web"
    if target == "" || target == "JS" || target == "Web" -> return
    entry: diagnostic_registry_row("E-APP-TARGET-FEATURE") ?? panic("E-APP-TARGET-FEATURE must have a registry row")
    what: entry.what.replace("{{feature}}", method).replace("{{required}}", "JS").replace("{{target}}", target)
    diagnostics.push(sema_error("E-APP-TARGET-FEATURE", span, what, entry.why, entry.fix.replace("{{feature}}", method)))
}

// The registration row of the module being checked, -1 when it has none.
sema_app_module_row: fn(environment: SemaScopeEnvironment, graph: SemaRegistrationGraph) -> Int {
    if environment.module_row >= 0 && environment.module_row < graph.modules.len() && graph.modules[environment.module_row].module_identity == environment.module_identity -> return environment.module_row
    loop (index, entry) in graph.modules {
        if entry.module_identity == environment.module_identity -> return index
    }
    -1
}

sema_call_try_app_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    receiver_type: sema_call_resolved_type(receiver_value.ty, environment, program)
    if receiver_type != (Type.Named{name: "App"}) && receiver_type != (Type.Named{name: "<corelib>/core.web::App"}) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if method == "route" || method == "page" || method == "layout" -> sema_call_app_route_registrations(receiver, receiver_value, method, args, span, environment, program, diagnostics)
    arity: sema_app_handler_arity(method, args.len())
    if arity < 0 -> return SemaMethodSpecialCheck{handled: false, value: None}
    graph: program.registration_graph ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if (method == "route" || method == "page" || method == "layout") && args.len() > 0 -> _ := sema_http_route_check_literal(args[0], environment, program, scopes, diagnostics)
    if args.len() != arity {
        diagnostics.push(sema_call_arity_diagnostic(method, arity, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    boundary: method == "pending" || method == "not_found" || method == "error"
    handler_index: if boundary -> 0 else -> 1
    if (method == "route" || method == "page" || method == "layout") && sema_http_mux_callee(args[handler_index].expr) == None {
        row: diagnostic_registry_row("E2810") ?? panic("E2810 must have a registry row")
        path: sema_app_literal_text(args[0].expr) ?? "/"
        diagnostics.push(sema_error("E2810", span, "`{method}` `{path}` is not a statically known handler", row.why, row.fix))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    handler: sema_app_named_handler(method, args[handler_index], environment, program, scopes, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    adapter_expr: sema_app_handler_adapter(method, handler.name, handler.function, graph, args[handler_index].span, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    adapter: sema_app_arg(adapter_expr, AccessConvention.Move, args[handler_index].span)
    identity: sema_app_arg(sema_app_text(handler.name, span), AccessConvention.Read, span)
    kind: sema_app_arg(sema_app_text(method, span), AccessConvention.Read, span)
    registration := [CallArg]{}
    target := ""
    if method == {
        "route" | "page" | "layout" -> {
            target = "__route"
            binding: sema_app_route_binding(method, args[1].expr, environment, program, scopes, context.host_hooks)
            registration = [CallArg]{args[0].copy(), adapter, identity, sema_app_arg(sema_app_text(binding, span), AccessConvention.Read, span)}
        }
        "pending" | "not_found" | "error" -> {
            target = "__boundary"
            registration = [CallArg]{kind, adapter, identity}
        }
        "action" | "form" | "data" -> {
            target = "__action"
            registration = [CallArg]{kind, args[0].copy(), adapter}
        }
        "loader" -> {
            // The first argument names the route handler the loader feeds;
            // the loader attaches to the route registered just before it.
            _: sema_app_named_handler(method, args[0], environment, program, scopes, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
            target = "__loader"
            data_type: if handler.function.declaration.return_type == {
                .Val(declared) -> type_name(sema_app_success_type(sema_type_resolve_declared(graph, declared, handler.function.symbol.module_name)))
                .None -> "Unit"
            }
            preload: if args.len() == 3 -> args[2].copy() else -> sema_app_arg(Expr.Bool{value: false, span: span, id: AST_NODE_GENERATED}, AccessConvention.Read, span)
            registration = [CallArg]{adapter, identity, sema_app_arg(sema_app_text(data_type, span), AccessConvention.Read, span), preload}
        }
        else -> {
            target = "__mount"
            effect_text: if args.len() >= 3 -> args[2].copy() else -> sema_app_arg(sema_app_text("", span), AccessConvention.Read, span)
            policy: if args.len() == 4 -> args[3].copy() else -> sema_app_arg(sema_app_text("", span), AccessConvention.Read, span)
            registration = [CallArg]{args[0].copy(), adapter, effect_text, policy}
        }
    }
    value: sema_expr_check_declared_method(receiver, receiver_value, target, target, span, [Type]{}, [Type]{}, registration, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    SemaMethodSpecialCheck{handled: true, value: value}
}

sema_call_receiver_method_label: fn(receiver: Type) -> String Never! {
    if receiver == {
        .Tagged(_, inner) -> sema_call_receiver_method_label(inner)
        .List(_) | .FixedList(_, _) -> "List"
        .Map(_, _, _) -> "Map"
        .String -> "String"
        .Named(name) -> name
        .Apply(name, _) -> name
        .Int | .Float | .Bool | .Char | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> type_name(receiver)
    }
}

sema_call_method_leaf: fn(name: String) -> String Never! {
    parts: name.split("::").to_list()
    parts[parts.len() - 1]
}

sema_call_push_arity: fn(arities: &[Int], arity: Int) Never! {
    if !arities.contains(arity) -> arities.push(arity)
}

// The argument counts the receiver's built-in method table accepts for one
// method name: the collection contracts, the value-method rows, the
// dedicated parallel adapters and the built-in handle families (Rust
// `Collections::builtin_method_return`, probed per arity as
// `builtin_method_names` and `builtin_method_arity_diagnostic` do).
sema_call_builtin_method_arities: fn(receiver: Type, method: String) -> [Int] Never! {
    arities := [Int]{}
    ty: sema_expr_unwrap_tag(receiver)
    if sema_collection_method_contract(ty, method) == .Val(contract) {
        loop arity in contract.minimum_arity..<(contract.maximum_arity + 1) -> sema_call_push_arity(arities, arity)
    }
    if sema_collection_is_list(ty) {
        if method == "para_map" {
            sema_call_push_arity(arities, 1)
            sema_call_push_arity(arities, 2)
        }
        if method == "para_filter" || method == "para_partition" -> sema_call_push_arity(arities, 1)
        if method == "para_fold" -> sema_call_push_arity(arities, 3)
    }
    loop row in BUILTIN_METHOD_ROWS {
        if row.name == method && builtin_method_receiver_accepts(row.receiver, ty) -> sema_call_push_arity(arities, row.parameters.len())
    }
    owner: sema_call_method_leaf(sema_call_receiver_method_label(ty))
    loop arity in 0..<4 {
        known: if owner == {
            "Duration" -> sema_time_duration_result(method, arity) != None || (method == "round" && arity >= 1)
            "Decimal" | "Fraction" -> sema_value_method_precise_result(owner, method, arity) != None
            "DeterministicWorld" -> sema_time_world_contract(method, arity) != None
            "RNG" -> sema_time_rng_fixed_signature(method, arity) != None || ((method == "pick" || method == "shuffle") && arity == 1) || ((method == "weighted_pick" || method == "sample") && arity == 2)
            "Clock" -> (method == "now" && arity == 0) || ((method == "tick" || method == "advance" || method == "wait") && arity == 1)
            "Task" -> ((method == "join" || method == "detach" || method == "resume" || method == "cancel" || method == "trace") && arity == 0) || (method == "pause" && arity < 2)
            else -> false
        }
        if known -> sema_call_push_arity(arities, arity)
    }
    arities
}

sema_call_builtin_method_pool: fn(receiver: Type) -> [String] Never! {
    pool := [String]{}
    owner: sema_call_method_leaf(sema_call_receiver_method_label(sema_expr_unwrap_tag(receiver)))
    if owner == {
        "Duration" -> pool = [String]{"in", "is_zero", "total_seconds", "difference", "abs", "negated", "sign", "total_in", "round"}
        "Decimal" -> pool = [String]{"add", "sub", "mul", "div", "round", "floor", "ceil", "equal", "compare", "to_string", "to_float"}
        "Fraction" -> pool = [String]{"add", "sub", "mul", "div", "numerator", "denominator", "to_string", "to_float", "is_zero", "equal"}
        "DeterministicWorld" -> pool = [String]{"now", "advance", "wait_idle", "history"}
        "RNG" -> pool = [String]{"int", "float", "float_range", "bool", "normal", "exponential", "bytes", "split", "pick", "weighted_pick", "sample", "shuffle"}
        "Clock" -> pool = [String]{"now", "tick", "advance", "wait"}
        "Task" -> pool = [String]{"join", "detach", "pause", "resume", "cancel", "trace"}
        else -> {
            loop row in COLLECTION_OPERATIONS {
                if !pool.contains(row.name) -> pool.push(row.name.copy())
            }
            loop name in ([String]{"para_map", "para_filter", "para_partition", "para_fold"}) -> pool.push(name)
            loop row in BUILTIN_METHOD_ROWS {
                if !pool.contains(row.name) -> pool.push(row.name.copy())
            }
        }
    }
    pool
}

// Rust `Collections::builtin_method_names` (jet-foundation): every name the
// receiver's built-in table accepts at some arity.
sema_call_builtin_method_names: fn(receiver: Type) -> [String] Never! {
    names := [String]{}
    loop name in sema_call_builtin_method_pool(receiver) {
        if sema_call_builtin_method_arities(receiver, name).len() > 0 && !names.contains(name) -> names.push(name)
    }
    names
}

// Rust `method_names_for_type_name` filtered to instance methods: the
// methods a nominal receiver declares in its own or impl blocks.
sema_call_declared_method_names: fn(receiver: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> [String] Never! {
    names := [String]{}
    base_name: sema_expr_type_base_name(sema_expr_unwrap_tag(receiver)) ?? return names
    if program.registration_graph == .Val(graph) {
        if graph.source_impl_owner_modules.get(base_name) == .Val(owner_modules) {
            loop owner_index in owner_modules {
                loop implementation in graph.modules[owner_index].impls {
                    if implementation.target_type_name != base_name -> next
                    loop function in implementation.methods {
                        if function.parameters.len() > 0 && !names.contains(function.symbol.name) -> names.push(function.symbol.name.copy())
                    }
                }
            }
        }
        loop nominal_row in sema_registration_nominal_rows_named(graph, sema_expr_operator_row_name(base_name)) {
            loop function in graph.modules[nominal_row.module_index].nominals[nominal_row.row].methods {
                if function.parameters.len() > 0 && !names.contains(function.symbol.name) -> names.push(function.symbol.name.copy())
            }
        }
    }
    loop candidate in sema_call_local_method_names(environment, sema_call_method_leaf(base_name)) {
        if !names.contains(candidate) -> names.push(candidate)
    }
    names
}

// Whether a nominal receiver declares `method` as a static method (no `self`
// receiver) in its own or impl blocks.
sema_call_declares_static_method: fn(receiver: Type, method: String, program: SemaProgramTables) -> Bool Never! {
    base_name: sema_expr_type_base_name(sema_expr_unwrap_tag(receiver)) ?? return false
    if program.registration_graph == .Val(graph) {
        if graph.source_impl_owner_modules.get(base_name) == .Val(owner_modules) {
            loop owner_index in owner_modules {
                loop implementation in graph.modules[owner_index].impls {
                    if implementation.target_type_name != base_name -> next
                    loop function in implementation.methods {
                        if function.symbol.name == method && (function.parameters.len() == 0 || function.parameters[0].symbol.name != "self") -> return true
                    }
                }
            }
        }
        loop nominal_row in sema_registration_nominal_rows_named(graph, sema_expr_operator_row_name(base_name)) {
            loop function in graph.modules[nominal_row.module_index].nominals[nominal_row.row].methods {
                if function.symbol.name == method && (function.parameters.len() == 0 || function.parameters[0].symbol.name != "self") -> return true
            }
        }
    }
    false
}

sema_call_local_method_names: fn(environment: SemaScopeEnvironment, owner: String) -> [String] Never! {
    names := [String]{}
    loop declaration_index in 0..<environment.declarations.len() {
        if environment.declarations[declaration_index].item == {
            .Struct(value) -> {
                if value.name == owner -> sema_call_push_instance_method_names(names, value.methods)
            }
            .Enum(value) -> {
                if value.name == owner -> sema_call_push_instance_method_names(names, value.methods)
            }
            .Impl(value) -> {
                if value.type_name == owner -> sema_call_push_instance_method_names(names, value.methods)
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    names
}

sema_call_push_instance_method_names: fn(names: &[String], methods: [Func]) Never! {
    loop method in methods {
        if method.params.len() > 0 && method.params[0].name == "self" && !names.contains(method.name) -> names.push(method.name.copy())
    }
}

// The current method name nearest `method` in spelling — within two edits,
// else the one name that is a prefix of the other — among the receiver's
// built-in methods that take `actual` arguments and its declared instance
// methods; none when two candidates tie.
sema_call_method_suggestion: fn(method: String, receiver: Type, actual: Int, environment: SemaScopeEnvironment, program: SemaProgramTables) -> String? {
    candidates := [String]{}
    loop name in sema_call_builtin_method_names(receiver) {
        if sema_call_builtin_method_arities(receiver, name).contains(actual) -> candidates.push(name)
    }
    loop name in sema_call_declared_method_names(receiver, environment, program) {
        if !candidates.contains(name) -> candidates.push(name)
    }
    if sema_suggest_field(method, candidates) == .Val(near) -> return Val(near)
    prefixed := String?{None}
    loop candidate in candidates {
        if candidate == method || candidate.len() < 3 || method.len() < 3 -> next
        if !candidate.starts_with(method) && !method.starts_with(candidate) -> next
        if prefixed != None -> return None
        prefixed = Val(candidate.copy())
    }
    prefixed
}

sema_call_method_fix: fn(suggestion: String?, otherwise: String) -> String Never! {
    if suggestion == .Val(name) -> "did you mean `{name}`?" else -> otherwise
}

// The suggested spelling is also the rename edit.
sema_call_method_error: fn(code: String, span: Span, what: String, why: String, fix: String, suggestion: String?) -> Diagnostic {
    diagnostic: sema_error(code, span, what, why, fix)
    if suggestion == .Val(name) -> return diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: name})
    diagnostic
}

sema_call_missing_instance_method: fn(method: String, receiver: Type, actual: Int, why: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Diagnostic {
    suggestion: sema_call_method_suggestion(method, receiver, actual, environment, program)
    sema_call_method_error("E0311", span, "`{method}` isn't a method on this value", why, sema_call_method_fix(suggestion, "check the spelling of `{method}`"), suggestion)
}

// Rust `builtin_method_arity_diagnostic`: the method exists for this receiver,
// but at another argument count.
sema_call_builtin_method_arity: fn(receiver: Type, method: String, actual: Int, span: Span) -> Diagnostic? {
    arities := sema_call_builtin_method_arities(receiver, method)
    if arities.len() == 0 || arities.contains(actual) -> return None
    first := arities[0]
    last := arities[0]
    loop arity in arities {
        if arity < first -> first = arity
        if arity > last -> last = arity
    }
    expected: if first == last -> "{first} argument{if first == 1 -> "" else -> "s"}" else -> "{first} to {last} arguments"
    label: sema_call_receiver_method_label(receiver)
    Val(sema_error("E0104", span, "`{label}.{method}` expects {expected}, got {actual}", "`{label}` has a `{method}` method, but no form of it takes {actual} arguments", "Call `.{method}(…)` with {expected}."))
}

sema_call_option_nominal: fn(ty: Type) -> Type Never! {
    if ty == {
        .Option(inner) -> inner
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ty
    }
}

sema_call_is_iter_receiver: fn(receiver: Type) -> Bool Never! {
    if sema_expr_unwrap_tag(receiver) == {
        .Apply(name, _) -> name == "Iter" || name == "ViewIter"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// Rust `infer_method_call`'s missing-method tail: a built-in receiver reports
// its arity or E0311 against its own table, a structural value reports E0311,
// and a nominal receiver reports E0102 — a protected Core type has a closed
// surface, a type parameter names its bounds, and any other type can declare
// the method.
sema_call_missing_method_diagnostic: fn(receiver: Type, method: String, actual: Int, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Diagnostic {
    ty: sema_expr_unwrap_tag(receiver)
    source_owned: if ty == {
        .Named(_) | .Apply(_, _) -> sema_call_declared_method_names(ty, environment, program).len() > 0
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
    if sema_call_builtin_method_names(ty).len() > 0 && !source_owned && !sema_call_is_iter_receiver(ty) {
        if sema_call_builtin_method_arity(ty, method, actual, span) == .Val(diagnostic) -> return diagnostic
        return sema_call_missing_instance_method(method, ty, actual, "this `{sema_call_receiver_method_label(ty)}` value has no instance method named `{method}`", span, environment, program)
    }
    nominal: sema_call_option_nominal(ty)
    type_name_value: if nominal == {
        .Named(name) | .Apply(name, _) -> name
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ""
    }
    if type_name_value == "" -> return sema_call_missing_instance_method(method, ty, actual, "this value does not expose an instance method named `{method}`", span, environment, program)
    display: sema_call_method_leaf(type_name_value)
    // Rust `infer_method_call`: a static method named through a value.
    if sema_call_declares_static_method(nominal, method, program) -> return sema_error("E0311", span, "`{method}` is a static method on `{display}`", "static methods belong to the type name, not a value", "write `{display}.{method}(...)` instead")
    if sema_call_is_iter_receiver(ty) && method == "nth" -> return sema_error("E0102", span, "`{display}` has no method `{method}`", "positional picks on `Iter` use one consuming path", "use `.skip(n).first()`; `nth` is not part of the API")
    if sema_call_is_iter_receiver(ty) {
        element: sema_collection_receiver_element(ty) ?? Type.Int
        if sema_call_builtin_method_arities(Type.List{element: element}, method).len() > 0 -> return sema_error("E0102", span, "`{display}` has no method `{method}`", "`{display}` is a one-pass source; `{method}` needs a materialized list, so collection consumes the source and allocates the list", "materialize it first with `.to_list()`; this consumes the source and allocates a list")
    }
    suggestion: sema_call_method_suggestion(method, nominal, actual, environment, program)
    protected: !source_owned && (sema_reserved_type_name(display) || type_name_value.starts_with("<corelib>/"))
    if protected {
        fix: sema_call_method_fix(suggestion, "use a documented method on `{display}`")
        return sema_call_method_error("E0102", span, "`{display}` has no method `{method}`", "`{display}` is a protected Core type with a closed method surface", fix, suggestion)
    }
    loop param in environment.generic_params {
        if param.name != type_name_value -> next
        bound_names := [String]{}
        loop bound in param.bounds {
            segments: bound.key.split(":").to_list()
            bound_names.push("`{segments[segments.len() - 1]}`")
        }
        if sema_variadic_bound_slot_parameter(type_name_value) == .Val(pack) {
            traits: if bound_names.len() == 0 -> "no trait" else -> bound_names.join(" + ")
            return sema_error("E0102", span, "an element of `{pack}` has no method `{method}`", "each element of `{pack}` is known only through its bounds ({traits}), and none of them provides `{method}`", "call a method from {traits}, or add a trait that defines `{method}` to `{pack}`'s bound list")
        }
        why: if bound_names.len() == 0 -> "type parameter `{type_name_value}` has no bound that provides `{method}`" else -> "none of type parameter `{type_name_value}`'s bounds ({bound_names.join(" + ")}) provides `{method}`"
        fix: if bound_names.len() == 0 -> "add a trait bound that defines `{method}`, or use a method available on `{type_name_value}`" else -> "add a bound that defines `{method}`, or use a method from {bound_names.join(" + ")}"
        return sema_error("E0102", span, "`{display}` has no method `{method}`", why, fix)
    }
    fix: sema_call_method_fix(suggestion, "define it inside `{display}: struct` or `impl {display}`")
    sema_call_method_error("E0102", span, "`{display}` has no method `{method}`", "check the method name on this type", fix, suggestion)
}
