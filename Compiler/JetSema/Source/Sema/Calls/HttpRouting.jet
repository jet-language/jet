// Static route contracts are checked before a mux or router registration reaches the checked tree.
use jet_foundation.[
    symbol_find,
    symbol_none,
    AST_NODE_GENERATED,
    AccessConvention,
    Call,
    CallArg,
    Diagnostic,
    Expr,
    Lambda,
    LambdaBody,
    LambdaParam,
    NamedSpan,
    ModuleID,
    OrFallback,
    ParamZone,
    Span,
    Stmt,
    StrPart,
    StructDef,
    SymbolKind,
    TComptimeValue,
    Type,
    ast_binding,
    ast_empty_call_arg_flags,
    ast_empty_lambda_meta,
    core_enum_variants,
    core_source_receiver_method,
    diagnostic_registry_row,
    diagnostic_with_label,
    expr_span,
    type_identity_equal,
    type_name,
    module_text,
]

SemaHTTPRouteParameter: struct {
    name: String
    ty: Type
}

SemaHTTPRouteShape: struct {
    params: [SemaHTTPRouteParameter]
    body: LambdaBody
    module_identity: ModuleID
}

SemaHTTPRoutePathField: struct {
    name: String
    catch_all: Bool
}

// A route argument as registration sees it: its compile-time pattern, and
// whether it was refused as an interpolated literal or an invalid pattern.
SemaHTTPRouteLiteral: struct {
    pattern: String?
    interpolated: Bool
    invalid: Bool
}

SemaHTTPRouteResponse: struct {
    status: Int
    schema: String?
    content_type: String?
}
SemaHTTPRouteResponseAlias: struct {
    name: String
    responses: [SemaHTTPRouteResponse]
}

sema_http_route_find_function: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, name: String) -> SemaRegistrationFunction? {
    index: sema_scope_resolve_index(scopes, name) ?? return None
    symbol := scopes.bindings[index].symbol
    if symbol.kind != SymbolKind.Function -> return None
    if program.registration_graph == .Val(graph) {
    loop module_row_index in 0..<graph.modules.len() {
        loop function_index in 0..<graph.modules[module_row_index].functions.len() {
            if graph.modules[module_row_index].functions[function_index].symbol.id == symbol.id -> return Val(graph.modules[module_row_index].functions[function_index])
        }
    }
    return None
    } else {
        return None
    }
}

sema_http_route_find_struct: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, ty: Type, module_identity: ModuleID) -> StructDef? {
    if program.registration_graph == .Val(graph) {
    nominal_row: sema_type_resolve_nominal_row(graph, ty, module_identity) ?? return None
    nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
    if nominal.kind != SemaRegistrationNominalKind.Struct -> return None
    item: sema_registration_nominal_source_item(nominal.source) ?? return None
    if item == {
        .Struct(definition) -> { return Val(definition) }
        .Func(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> { return None }
    }
    } else {
        return None
    }
}

// `request_ty` (a mux route: its handler is `fn(HTTPRequest)`) types a
// lambda's one unannotated parameter as the request.
sema_http_route_shape: fn(expression: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, host_hooks: SemaHostHookAccess?, request_ty: Type?) -> SemaHTTPRouteShape? {
    if expression == {
        .Paren(inner, _, _) -> return sema_http_route_shape(inner, environment, program, scopes, host_hooks, request_ty)
        .Lambda(lambda, _) -> {
            if lambda.meta.http_route_source == .Val(source) {
                if program.registration_graph == .Val(graph) {
                source_id: symbol_find(graph.symbols, source) ?? symbol_none()
                loop module_row_index in 0..<graph.modules.len() {
                    loop nominal_index in 0..<graph.modules[module_row_index].nominals.len() {
                        loop method_index in 0..<graph.modules[module_row_index].nominals[nominal_index].methods.len() {
                            if graph.modules[module_row_index].nominals[nominal_index].methods[method_index].symbol.id != source_id -> next
                            params := [SemaHTTPRouteParameter]{}
                            loop index in 1..<graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.params.len() {
                                parameter: graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.params[index]
                                params.push(SemaHTTPRouteParameter{name: parameter.name, ty: sema_type_resolve_declared(graph, parameter.ty, graph.modules[module_row_index].module_identity)})
                            }
                            return Val(SemaHTTPRouteShape{params: params, body: LambdaBody.Block{body: graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.body}, module_identity: graph.modules[module_row_index].module_identity})
                        }
                    }
                }
                return None
                } else {
                    return None
                }
            }
            params := [SemaHTTPRouteParameter]{}
            loop parameter in lambda.params {
                if parameter.ty == None && lambda.params.len() == 1 {
                    if request_ty == .Val(request) {
                        params.push(SemaHTTPRouteParameter{name: parameter.name, ty: request})
                        next
                    }
                }
                declared: parameter.ty ?? return None
                params.push(SemaHTTPRouteParameter{name: parameter.name, ty: sema_call_resolved_type(declared, environment, program)})
            }
            body: lambda.body
            return Val(SemaHTTPRouteShape{params: params, body: body, module_identity: environment.module_identity})
        }
        .Ident(name, _, _) -> {
            function: sema_http_route_find_function(environment, program, scopes, name) ?? return None
            if program.registration_graph == .Val(graph) {
            params := [SemaHTTPRouteParameter]{}
            loop parameter in function.declaration.params {
                resolved := sema_type_resolve_declared(graph, parameter.ty, function.symbol.module_identity)
                params.push(SemaHTTPRouteParameter{name: parameter.name, ty: resolved})
            }
            // Named-handler metadata reads another raw body, not merely
            // its callable header. The accepted logical query must recompute.
            sema_body_check_mark_foreign_raw_body(host_hooks)
            return Val(SemaHTTPRouteShape{params: params, body: LambdaBody.Block{body: function.declaration.body}, module_identity: function.symbol.module_identity})
            } else {
                return None
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

sema_http_route_method_owner_module: fn(graph: SemaRegistrationGraph, symbol: SymbolID) -> ModuleID? {
    loop module_row_index in 0..<graph.modules.len() {
        loop nominal_index in 0..<graph.modules[module_row_index].nominals.len() {
            loop method in graph.modules[module_row_index].nominals[nominal_index].methods { if method.symbol.id == symbol -> return Val(graph.modules[module_row_index].module_identity) }
            loop method in graph.modules[module_row_index].nominals[nominal_index].trait_methods { if method.symbol.id == symbol -> return Val(graph.modules[module_row_index].module_identity) }
        }
        loop implementation_index in 0..<graph.modules[module_row_index].impls.len() {
            loop method in graph.modules[module_row_index].impls[implementation_index].methods { if method.symbol.id == symbol -> return Val(graph.modules[module_row_index].module_identity) }
        }
    }
    None
}

sema_http_route_constant_string: fn(expression: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> String? {
    if expression == {
        .Paren(inner, _, _) -> return sema_http_route_constant_string(inner, environment, program, scopes)
        .Str(parts, _, _) -> {
            value := ""
            loop part in parts {
                if part == {
                    .Lit(text) -> { value = "{value}{text}" }
                    .Interp(_, _) | .Byte(_) -> { return None }
                }
            }
            return Val(value)
        }
        .ComptimeName(_, _, value, _) -> {
            present: value ?? return None
            if present == {
                .Str(text) -> { return Val(text) }
                .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> { return None }
            }
        }
        .Ident(name, _, _) -> {
            index: sema_scope_resolve_index(scopes, name) ?? return None
            binding := scopes.bindings[index]
            if binding.prepared == .Val(known) {
                if known == {
                    .String(text) -> { return Val(text) }
                    .Int(_) | .Float(_, _) | .Bool(_) | .Char(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit -> { return None }
                }
            }
            if binding.symbol.kind != SymbolKind.Constant -> return None
            if program.registration_graph == .Val(graph) {
                loop module_row_index in 0..<graph.modules.len() {
                    loop constant_index in 0..<graph.modules[module_row_index].constants.len() {
                        if graph.modules[module_row_index].constants[constant_index].symbol.id != binding.symbol.id -> next
                        return sema_http_route_module_constant(graph, module_row_index, constant_index, 0)
                    }
                }
                return None
            } else {
                return None
            }
        }
        // A `Path{…}` literal without holes is static text: Path keeps it,
        // only turning `\` into `/` (Path.from).
        .TypedLit(head, body, _, _) -> {
            if head != (Val(Type.Named{name: "Path"})) -> return None
            if body == {
                .Value(value) -> {
                    text: sema_http_route_constant_string(value, environment, program, scopes) ?? return None
                    return Val(text.replace("\\", "/"))
                }
                .Fields(_) | .Elements(_) | .Entries(_) | .ByteText(_) | .Empty -> { return None }
            }
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

// The String a module constant holds: its staged value, or its declared
// expression folded (a String literal without holes, `#run { … }`
// holding one, or another such constant of the same module). Chains stop
// at 32 links.
sema_http_route_module_constant: fn(graph: SemaRegistrationGraph, module_index: Int, constant_index: Int, depth: Int) -> String? Never! {
    if depth > 32 -> return None
    if graph.modules[module_index].constants[constant_index].declaration.mutable -> return None
    if graph.modules[module_index].constants[constant_index].declaration.ct == .Val(ct_value) {
        if ct_value == .Str(text) -> return Val(text)
        return None
    }
    sema_http_route_constant_fold(graph, module_index, graph.modules[module_index].constants[constant_index].declaration.value, depth + 1)
}

sema_http_route_constant_fold: fn(graph: SemaRegistrationGraph, module_index: Int, expression: Expr, depth: Int) -> String? Never! {
    if expression == {
        .Paren(inner, _, _) -> return sema_http_route_constant_fold(graph, module_index, inner, depth)
        .Str(parts, _, _) -> {
            value := ""
            loop part in parts {
                if part == {
                    .Lit(text) -> { value = "{value}{text}" }
                    .Interp(_, _) | .Byte(_) -> { return None }
                }
            }
            return Val(value)
        }
        .ComptimeName(_, _, value, _) -> {
            present: value ?? return None
            if present == .Str(text) -> return Val(text)
            return None
        }
        .Ident(name, _, _) -> {
            loop constant_index in 0..<graph.modules[module_index].constants.len() {
                if graph.modules[module_index].constants[constant_index].symbol.name == name -> return sema_http_route_module_constant(graph, module_index, constant_index, depth)
            }
            return None
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .TypeValue(_, _, _) | .Pipe(_, _, _, _) -> return None
    }
}

sema_http_route_hex_digit: fn(value: Int) -> Int Never! {
    if value < 10 -> 48 + value else -> 87 + value
}

sema_http_route_hex_value: fn(code: Int) -> Int Never! {
    if {
        code >= 48 && code <= 57 -> code - 48
        code >= 65 && code <= 70 -> code - 55
        code >= 97 && code <= 102 -> code - 87
        else -> -1
    }
}

// The first defect of one static route segment (Rust `decode_static`), or
// None when it percent-decodes to one safe UTF-8 segment.
sema_http_route_static_segment_error: fn(segment: String) -> String? {
    input := segment.bytes()
    decoded := [U8]{}
    index := 0
    loop index < input.len() {
        code := Int{input[index]}
        if code != 37 {
            decoded.push(input[index])
            index = index + 1
            next
        }
        high := if index + 1 < input.len() -> sema_http_route_hex_value(Int{input[index + 1]}) else -> -1
        low := if index + 2 < input.len() -> sema_http_route_hex_value(Int{input[index + 2]}) else -> -1
        if high < 0 || low < 0 -> return Val("invalid percent escape")
        decoded_byte := high * 16 + low
        if decoded_byte == 47 -> return Val("encoded slash is ambiguous")
        decoded.push(U8{decoded_byte})
        index = index + 3
    }
    value: String.from_bytes(decoded) ?? return Val("route segment is not valid UTF-8")
    if value == "." || value == ".." -> return Val("dot traversal segment is not allowed")
    None
}

sema_http_route_name_is_valid: fn(name: String) -> Bool Never! {
    bytes := name.bytes()
    if bytes.len() == 0 -> return false
    first := Int{bytes[0]}
    if !(first == 95 || (first >= 65 && first <= 90) || (first >= 97 && first <= 122)) -> return false
    loop index in 1..<bytes.len() {
        code := Int{bytes[index]}
        if !(code == 95 || (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122)) -> return false
    }
    true
}

sema_http_route_path_fields: fn(pattern: String) -> [SemaHTTPRoutePathField]? {
    if !pattern.starts_with("/") -> return None
    segments := pattern.split("/").to_list()
    if segments.len() < 2 -> return None
    names := [String]{}
    fields := [SemaHTTPRoutePathField]{}
    loop index in 1..<segments.len() {
        segment := segments[index]
        if segment == "" {
            if pattern == "/" && segments.len() == 2 -> next
            return None
        }
        if segment.contains("{{") || segment.contains("}}") -> return None
        if segment == "*" -> return None
            if {
                segment.starts_with(":") || segment.starts_with("*") -> {
                    catch_all := segment.starts_with("*")
                    if catch_all && index != segments.len() - 1 -> return None
                    field_name := String.from_bytes(segment.bytes().slice(1, segment.bytes().len())) ?? return None
                    if !sema_http_route_name_is_valid(field_name) -> return None
                    loop existing in names { if existing == field_name -> return None }
                    names.push(field_name.copy())
                    fields.push(SemaHTTPRoutePathField{name: field_name, catch_all: catch_all})
                }
                else -> {
                    if sema_http_route_static_segment_error(segment) != None -> return None
                }
            }
    }
    Val(fields)
}

sema_http_route_pattern_error: fn(pattern: String) -> String? {
    if !pattern.starts_with("/") -> return Val("routes must start with `/`")
    segments := pattern.split("/").to_list()
    loop index in 1..<segments.len() {
        segment := segments[index]
        if segment == "" {
            if pattern == "/" && segments.len() == 2 -> next
            return Val("empty path segments are not allowed")
        }
        if segment.contains("{{") || segment.contains("}}") -> return Val("use `:name` or final `*name`; braces are not route markers")
        if segment == "*" -> return Val("write a named catch-all such as `*wildcard`")
        if {
            segment.starts_with(":") || segment.starts_with("*") -> {
                catch_all := segment.starts_with("*")
                if catch_all && index != segments.len() - 1 -> return Val("`*name` catch-all must be final")
                field_name := String.from_bytes(segment.bytes().slice(1, segment.bytes().len())) ?? ""
                if !sema_http_route_name_is_valid(field_name) {
                    marker: if catch_all -> "catch-all" else -> "parameter"
                    return Val("{marker} names must match `[A-Za-z_][A-Za-z0-9_]*`")
                }
                loop prior in 1..<index {
                    prior_segment := segments[prior]
                    if prior_segment.starts_with(":") || prior_segment.starts_with("*") {
                        prior_name := String.from_bytes(prior_segment.bytes().slice(1, prior_segment.bytes().len())) ?? ""
                        if prior_name == field_name -> return Val("duplicate parameter `{field_name}`")
                    }
                }
            }
            else -> {
                if sema_http_route_static_segment_error(segment) == .Val(reason) -> return Val(reason)
            }
        }
    }
    None
}

// An interpolated route literal (Rust `check_http_route_constant`) is refused
// before constant evaluation; its holes render as `{name}` or `{…}`.
sema_http_route_interpolated_source: fn(expression: Expr) -> String? {
    if expression == .Str(parts, _, _) {
        interpolated := false
        source := ""
        loop part in parts {
            if part == {
                .Lit(text) -> { source = "{source}{text}" }
                .Byte(value) -> { source = "{source}{sema_expr_byte_text(value)}" }
                .Interp(inner, _) -> {
                    interpolated = true
                    hole: if inner == .Ident(name, _, _) -> name else -> "…"
                    source = "{source}{{{hole}}}"
                }
            }
        }
        if interpolated -> return Val(source)
    }
    None
}

sema_http_route_invalid_diagnostic: fn(pattern: String, reason: String, span: Span) -> Diagnostic {
    sema_error("E2805", span, "invalid HTTP route `{pattern}`: {reason}", "route patterns use one canonical grammar; ambiguous escapes, traversal, duplicate names, and retired markers would make routing and audit metadata disagree", "use `:name` for one segment or final `*name` for a catch-all; percent-encode a literal leading `:` or `*`, and never encode `/`")
}

// Two rows of one route table with one method and address: the later
// registration is the error and the earlier one is its label. `source` names
// the file a convention route at `span` comes from ("" when the span is the
// registering call itself).
sema_http_route_duplicate: fn(method: String, pattern: String, span: Span, source: String, first: Span, first_label: String) -> Diagnostic {
    row: diagnostic_registry_row("E2804") ?? panic("E2804 must have a registry row")
    what: if source == "" -> "Two routes both match `{method} {pattern}`." else -> "Two routes both match `{method} {pattern}`; this one comes from `{source}`."
    diagnostic_with_label(sema_error("E2804", span, what, row.why, row.fix), first, first_label)
}

// Router, mux and App route registrations refuse an interpolated or invalid
// route literal before any other argument check.
sema_http_route_check_literal: fn(argument: CallArg, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> SemaHTTPRouteLiteral {
    if sema_http_route_interpolated_source(argument.expr) == .Val(source) {
        diagnostics.push(sema_http_route_invalid_diagnostic(source, "brace interpolation is not allowed in route patterns", argument.span))
        return SemaHTTPRouteLiteral{pattern: None, interpolated: true, invalid: false}
    }
    pattern: sema_http_route_constant_string(argument.expr, environment, program, scopes) ?? return SemaHTTPRouteLiteral{pattern: None, interpolated: false, invalid: false}
    reason: sema_http_route_pattern_error(pattern) ?? return SemaHTTPRouteLiteral{pattern: Val(pattern), interpolated: false, invalid: false}
    diagnostics.push(sema_http_route_invalid_diagnostic(pattern, reason, argument.span))
    SemaHTTPRouteLiteral{pattern: Val(pattern), interpolated: false, invalid: true}
}

// A route path is a String or a `Path` (what a checked `Path{…}` literal
// builds), registered as its text. Every verb, `router` and `#Server` mark
// takes its path through this one conversion.
sema_http_route_path_value: fn(argument: CallArg, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked: sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if (sema_stream_handle_owner(checked.ty) ?? "") == "Path" {
        text: sema_call_try_stream_handle_method(argument.expr, checked, "to_string", [CallArg]{}, argument.span, Val(Type.String), environment, program, scopes, state, tail_store, context, diagnostics)
        return text.value
    }
    if type_identity_equal(checked.ty, Type.String) -> return Val(checked)
    compatible: sema_call_type_assignable(Type.String, checked.ty, environment, program) ?? return None
    if compatible -> return Val(checked)
    diagnostics.push(sema_type_mismatch(Type.String, checked.ty, argument.span))
    None
}

sema_http_route_json_quote: fn(value: String) -> String Never! {
    output := [U8]{U8{34}}
    loop byte in value.bytes() {
        code := Int{byte}
        if {
            code == 34 -> {
                output.push(U8{92})
                output.push(U8{34})
            }
            code == 92 -> {
                output.push(U8{92})
                output.push(U8{92})
            }
            code == 10 -> {
                output.push(U8{92})
                output.push(U8{110})
            }
            code == 13 -> {
                output.push(U8{92})
                output.push(U8{114})
            }
            code == 9 -> {
                output.push(U8{92})
                output.push(U8{116})
            }
            code < 32 -> {
                output.push(U8{92})
                output.push(U8{117})
                output.push(U8{48})
                output.push(U8{48})
                output.push(U8{sema_http_route_hex_digit(code.div_euclid(16))})
                output.push(U8{sema_http_route_hex_digit(code % 16)})
            }
            else -> {
                output.push(byte)
            }
        }
    }
    output.push(U8{34})
    String.from_bytes(output) ?? "\"\""
}

// The JSON schema of `ty` as module `module_identity` names it; generic
// parameters are `environment`'s.
sema_http_route_schema_type: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, active: [SymbolID]) -> String? {
    if ty == {
        .Int | .IntN(_, _) -> return Val("{{\"type\":\"integer\",\"format\":\"int64\"}}")
        .Float | .Float32 -> return Val("{{\"type\":\"number\",\"format\":\"double\"}}")
        .Bool -> return Val("{{\"type\":\"boolean\"}}")
        .String | .Char -> return Val("{{\"type\":\"string\"}}")
        .List(inner) | .FixedList(inner, _) -> {
            item: sema_http_route_schema_type(inner, environment, program, module_identity, active) ?? return None
            return Val("{{\"type\":\"array\",\"items\":{item}}}")
        }
        .Option(inner) -> {
            item: sema_http_route_schema_type(inner, environment, program, module_identity, active) ?? return None
            return Val("{{\"anyOf\":[{item},{{\"type\":\"null\"}}]}}")
        }
        .Result(ok, _) | .Shared(ok) | .Tagged(_, ok) | .Case(_, ok) | .Quantity(ok, _) | .InlineRange(ok, _, _) -> return sema_http_route_schema_type(ok, environment, program, module_identity, active)
        .Map(_, _, _) -> return Val("{{\"type\":\"object\",\"properties\":{{}},\"additionalProperties\":true}}")
        .Tuple(fields) -> {
            properties := [String]{}
            required := [String]{}
            loop field in fields {
                field_schema: sema_http_route_schema_type(field.ty, environment, program, module_identity, active) ?? return None
                properties.push("{sema_http_route_json_quote(field.name)}:{field_schema}")
                required.push(sema_http_route_json_quote(field.name))
            }
            return Val("{{\"type\":\"object\",\"properties\":{{{properties.join(",")}}},\"additionalProperties\":false,\"required\":[{required.join(",")}]}}")
        }
        .Union(members) -> {
            schemas := [String]{}
            loop member in members { schemas.push(sema_http_route_schema_type(member, environment, program, module_identity, active) ?? return None) }
            return Val("{{\"oneOf\":[{schemas.join(",")}]}}")
        }
        .Named(name) | .Apply(name, _) -> {
            leaf := sema_call_http_nominal_leaf(Type.Named{name: name})
            if leaf == "Any" || leaf == "JSON" -> return Val("{{}}")
            if leaf == "Null" || leaf == "Unit" -> return Val("{{\"type\":\"null\"}}")
            if leaf == "String" -> return Val("{{\"type\":\"string\"}}")
            if leaf == "Bool" -> return Val("{{\"type\":\"boolean\"}}")
            if leaf == "Int" || leaf == "I8" || leaf == "I16" || leaf == "I32" || leaf == "I64" || leaf == "U8" || leaf == "U16" || leaf == "U32" || leaf == "U64" -> return Val("{{\"type\":\"integer\",\"format\":\"int64\"}}")
            if leaf == "Float" || leaf == "F32" || leaf == "F64" -> return Val("{{\"type\":\"number\",\"format\":\"double\"}}")
            if sema_serde_type_is_admissible_in(environment, program, module_identity, ty, SemaSerdeDirection.Decode) == false -> return None
            if program.registration_graph == .Val(graph) {
            nominal_row: sema_type_resolve_nominal_row(graph, ty, module_identity) ?? return None
            nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
            if nominal.kind != SemaRegistrationNominalKind.Struct -> return None
            loop previous in active { if previous == nominal.symbol.id -> return None }
            next_active := [SymbolID]{}
            loop previous in active -> next_active.push(previous.copy())
            next_active.push(nominal.symbol.id.copy())
            // The fields are named as the struct's own module names them.
            properties := [String]{}
            required := [String]{}
            loop field in nominal.fields {
                if field.symbol.visibility != 2 -> next
                field_schema: sema_http_route_schema_type(field.ty, environment, program, graph.modules[nominal_row.module_index].module_identity, next_active) ?? return None
                properties.push("{sema_http_route_json_quote(field.symbol.name)}:{field_schema}")
                if field.ty == {
                    .Option(_) -> {}
                    .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> { required.push(sema_http_route_json_quote(field.symbol.name)) }
                }
            }
            required_json := if required.len() > 0 -> ",\"required\":[{required.join(",")}]" else -> ""
            return Val("{{\"type\":\"object\",\"properties\":{{{properties.join(",")}}},\"additionalProperties\":false{required_json}}}")
            } else {
                return None
            }
        }
        .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Measure(_) -> return None
    }
}

sema_http_route_schema_expr: fn(expression: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, locals: [SemaHTTPRouteParameter]) -> String? {
    if expression == {
        .Paren(inner, _, _) -> return sema_http_route_schema_expr(inner, environment, program, module_identity, locals)
        .Str(_, _, _) | .Char(_, _, _) -> return Val("{{\"type\":\"string\"}}")
        .Int(_, _, _, _, _) -> return Val("{{\"type\":\"integer\",\"format\":\"int64\"}}")
        .Float(_, _, _, _, _) -> return Val("{{\"type\":\"number\",\"format\":\"double\"}}")
        .Bool(_, _, _) -> return Val("{{\"type\":\"boolean\"}}")
        .Unit(_, _) -> return Val("{{\"type\":\"null\"}}")
        .Ident(name, _, _) -> {
            loop parameter in locals { if parameter.name == name -> return sema_http_route_schema_type(parameter.ty, environment, program, module_identity, [SymbolID]{}) }
            return None
        }
        .StructLit(type_name, _, _, _, _, _, _, _) -> return sema_http_route_schema_type(Type.Named{name: type_name}, environment, program, module_identity, [SymbolID]{})
        // `Name{…}` and `[T]{…}` parse as a typed literal: its written head
        // is the value's type.
        .TypedLit(head, _, _, _) -> {
            written: head ?? return None
            return sema_http_route_schema_type(written, environment, program, module_identity, [SymbolID]{})
        }
        .TupleLit(_, _, tuple_ty, _) -> {
            if tuple_ty == {
                .Val(ty) -> { return sema_http_route_schema_type(ty, environment, program, module_identity, [SymbolID]{}) }
                .None -> { return None }
            }
        }
        .Ok(inner, _, _) | .Try(inner, _, _, _, _) -> return sema_http_route_schema_expr(inner, environment, program, module_identity, locals)
        .ListLit(items, _, _) -> {
            if items.len() == 0 -> return None
            item: sema_http_route_schema_expr(items[0], environment, program, module_identity, locals) ?? return None
            return Val("{{\"type\":\"array\",\"items\":{item}}}")
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Err(_, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

sema_http_route_response_status: fn(expression: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, module_identity: ModuleID) -> Int? {
    if expression == {
        .Paren(inner, _, _) -> return sema_http_route_response_status(inner, environment, program, scopes, module_identity)
        .Int(value, _, _, _, _) -> return Val(value)
        .ComptimeName(_, _, value, _) -> {
            present: value ?? return None
            if present == {
                .Int(number) -> { return Val(number) }
                .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> { return None }
            }
        }
        .Ident(name, _, _) -> {
            if program.registration_graph == .Val(graph) {
            if sema_registration_module_index(graph, module_identity) == .Val(module_index) {
                loop constant_index in 0..<graph.modules[module_index].constants.len() {
                    if graph.modules[module_index].constants[constant_index].symbol.name == name {
                        if graph.modules[module_index].constants[constant_index].declaration.ct == {
                            .Val(ct_value) -> {
                                if ct_value == {
                                    .Int(number) -> { return Val(number) }
                                    .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> {}
                                }
                            }
                            .None -> {}
                        }
                    }
                }
            }
            if module_identity != environment.module_identity -> return None
            index := sema_scope_resolve_index(scopes, name)
            if index == .Val(found) {
                binding := scopes.bindings[found]
                loop module_row_index in 0..<graph.modules.len() {
                    loop constant_index in 0..<graph.modules[module_row_index].constants.len() {
                        if graph.modules[module_row_index].constants[constant_index].symbol.id == binding.symbol.id {
                            if graph.modules[module_row_index].constants[constant_index].declaration.ct == {
                                .Val(ct_value) -> {
                                    if ct_value == {
                                        .Int(number) -> { return Val(number) }
                                        .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .BigInt(_) | .Bytes(_) | .List(_) | .Map(_) | .Struct(_, _) | .Enum(_, _, _) | .Present(_) | .Failed(_) | .Unit | .Closure(_) -> {}
                                    }
                                }
                                .None -> {}
                            }
                        }
                    }
                }
            }
            return None
            } else {
                return None
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

sema_http_route_response_constructor: fn(name: String, args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, locals: [SemaHTTPRouteParameter], module_identity: ModuleID) -> SemaHTTPRouteResponse? {
    if name != "response" && name != "json" && name != "empty_response" -> return None
    if args.len() == 0 -> return None
    status: sema_http_route_response_status(args[0].expr, environment, program, scopes, module_identity) ?? return None
    if status < 100 || status > 599 -> return None
    if name == "empty_response" && args.len() == 1 -> return Val(SemaHTTPRouteResponse{status: status, schema: None, content_type: None})
    // `response(status, body)` takes its body as String, so its schema is
    // String whatever expression computes the text.
    if name == "response" && args.len() == 2 -> return Val(SemaHTTPRouteResponse{status: status, schema: Val("{{\"type\":\"string\"}}"), content_type: None})
    if name == "json" && args.len() == 2 {
        schema: sema_http_route_schema_expr(args[1].expr, environment, program, module_identity, locals) ?? return None
        return Val(SemaHTTPRouteResponse{status: status, schema: Val(schema), content_type: Val("application/json")})
    }
    None
}

sema_http_route_response_alias: fn(aliases: [SemaHTTPRouteResponseAlias], name: String) -> [SemaHTTPRouteResponse]? {
    loop alias in aliases { if alias.name == name -> return Val(alias.responses) }
    None
}

sema_http_route_response_local_type: fn(expression: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, locals: [SemaHTTPRouteParameter], module_identity: ModuleID) -> Type? {
    if expression == {
        .Paren(inner, _, _) -> return sema_http_route_response_local_type(inner, environment, program, locals, module_identity)
        .Str(_, _, _) | .Char(_, _, _) -> return Val(Type.String)
        .Int(_, _, _, _, _) -> return Val(Type.Int)
        .Float(_, _, _, _, _) -> return Val(Type.Float)
        .Bool(_, _, _) -> return Val(Type.Bool)
        .Unit(_, _) -> return Val(Type.Named{name: "Unit"})
        .Ident(name, _, _) -> {
            loop local in locals { if local.name == name -> return Val(local.ty) }
            return None
        }
        .StructLit(type_name, _, _, _, _, _, _, _) -> {
            if program.registration_graph == .Val(graph) {
                return Val(sema_type_resolve_declared(graph, Type.Named{name: type_name}, module_identity))
            } else {
                return None
            }
        }
        .TypedLit(head, _, _, _) -> {
            written: head ?? return None
            if program.registration_graph == .Val(graph) {
                return Val(sema_type_resolve_declared(graph, written, module_identity))
            } else {
                return None
            }
        }
        .TupleLit(_, _, tuple_ty, _) -> {
            return tuple_ty
        }
        .ListLit(items, _, _) -> {
            if items.len() == 0 -> return None
            item: sema_http_route_response_local_type(items[0], environment, program, locals, module_identity) ?? return None
            return Val(Type.List{element: item})
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

sema_http_route_response_adapter_returns_response: fn(method: String, args: [CallArg], type_args: [Type], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID) -> Bool Never! {
    updated_args := args
    if program.registration_graph == .Val(graph) {
    response_row: sema_type_resolve_nominal_row(graph, Type.Named{name: "HTTPResponse"}, module_identity) ?? return false
    response_nominal: graph.modules[response_row.module_index].nominals[response_row.row]
    routed: core_source_receiver_method("{module_text(graph.module_table, response_nominal.symbol.module_identity)}::{response_nominal.symbol.name}", method, updated_args.len())
    probe_diagnostics := [Diagnostic]{}
    candidates := sema_expr_registration_method_candidates(graph, module_identity, response_nominal.ty, routed, [Type]{}, type_args, span, environment, program, probe_diagnostics)
    if candidates.len() == 0 -> return false
    matched := false
    all_return_response := true
    loop candidate in candidates {
        if sema_call_bind_method(routed, candidate.signature, candidate.receiver_offset, updated_args, span, probe_diagnostics) == None -> next
        matched = true
        result_type: sema_call_signature_return(candidate.signature) ?? {
            all_return_response = false
            next
        }
        owner_module: sema_http_route_method_owner_module(graph, candidate.method.symbol) ?? {
            all_return_response = false
            next
        }
        resolved_result := sema_type_resolve_declared(graph, result_type, owner_module)
        result_row := sema_type_resolve_nominal_row(graph, resolved_result, owner_module)
        if result_row == {
            .Val(row) -> {
                if graph.modules[row.module_index].nominals[row.row].symbol.id != response_nominal.symbol.id -> all_return_response = false
            }
            .None -> {
                all_return_response = false
            }
        }
    }
    return matched && all_return_response
    } else {
        return false
    }
}

sema_http_route_response_expr: fn(expression: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, locals: [SemaHTTPRouteParameter], aliases: [SemaHTTPRouteResponseAlias], module_identity: ModuleID) -> [SemaHTTPRouteResponse] {
    if expression == {
        .Paren(inner, _, _) | .Ok(inner, _, _) | .Try(inner, _, _, _, _) -> return sema_http_route_response_expr(inner, environment, program, scopes, locals, aliases, module_identity)
        .If(_, then_body, then_value, else_body, else_value, _, _) -> {
            left := sema_http_route_response_statements(then_body, environment, program, scopes, locals, aliases, module_identity)
            loop response in sema_http_route_response_expr(then_value, environment, program, scopes, locals, aliases, module_identity) {
                left.push(response)
            }
            loop response in sema_http_route_response_statements(else_body, environment, program, scopes, locals, aliases, module_identity) {
                left.push(response)
            }
            loop response in sema_http_route_response_expr(else_value, environment, program, scopes, locals, aliases, module_identity) {
                left.push(response)
            }
            return left
        }
        .Ident(name, _, _) -> return sema_http_route_response_alias(aliases, name) ?? [SemaHTTPRouteResponse]{}
        .Call(call, _) -> {
            // `Ok(response)` parses as a call named `Ok`: its payload is the
            // handler path's response.
            if call.name == "Ok" && call.args.len() == 1 -> return sema_http_route_response_expr(call.args[0].expr, environment, program, scopes, locals, aliases, module_identity)
            leaf_parts := call.name.split(".").to_list()
            leaf := leaf_parts[leaf_parts.len() - 1]
            if sema_http_route_response_constructor(leaf, call.args, environment, program, scopes, locals, module_identity) == .Val(response) -> return [SemaHTTPRouteResponse]{response}
        }
        .MethodCall(receiver, method, method_span, _, type_args, args, _) -> {
            if sema_http_route_response_constructor(method, args, environment, program, scopes, locals, module_identity) == .Val(response) -> return [SemaHTTPRouteResponse]{response}
            receiver_responses := sema_http_route_response_expr(receiver, environment, program, scopes, locals, aliases, module_identity)
            if receiver_responses.len() > 0 {
                if sema_http_route_response_adapter_returns_response(method, args, type_args, method_span, environment, program, module_identity) -> return receiver_responses
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Err(_, _, _) | .OrFallback(_, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    [SemaHTTPRouteResponse]{}
}

sema_http_route_response_statements: fn(statements: [Stmt], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, locals: [SemaHTTPRouteParameter], initial_aliases: [SemaHTTPRouteResponseAlias], module_identity: ModuleID) -> [SemaHTTPRouteResponse] {
    output := [SemaHTTPRouteResponse]{}
    aliases := initial_aliases
    local_types := locals
    loop (position, statement) in statements {
        if statement == {
            // A block's tail expression is the value the handler returns.
            .Expr(expression) -> {
                if position == statements.len() - 1 {
                    loop response in sema_http_route_response_expr(expression, environment, program, scopes, local_types, aliases, module_identity) {
                        output.push(response)
                    }
                }
            }
            .Return(value, _) -> {
                if value == {
                    .Val(expression) -> {
                        loop response in sema_http_route_response_expr(expression, environment, program, scopes, local_types, aliases, module_identity) {
                            output.push(response)
                        }
                    }
                    .None -> {}
                }
            }
            .Val(binding) -> {
                next_aliases := [SemaHTTPRouteResponseAlias]{}
                loop alias in aliases { if alias.name != binding.name -> next_aliases.push(alias) }
                aliases = next_aliases
                responses := sema_http_route_response_expr(binding.init, environment, program, scopes, local_types, aliases, module_identity)
                if responses.len() > 0 -> aliases.push(SemaHTTPRouteResponseAlias{name: binding.name, responses: responses})

                next_local_types := [SemaHTTPRouteParameter]{}
                loop local in local_types { if local.name != binding.name -> next_local_types.push(local) }
                binding_type := if binding.ty == {
                    .Val(declared) -> if program.registration_graph == .Val(graph) -> Val(sema_type_resolve_declared(graph, declared, module_identity)) else -> Val(declared)
                    .None -> sema_http_route_response_local_type(binding.init, environment, program, local_types, module_identity)
                }
                if binding_type == .Val(ty) -> next_local_types.push(SemaHTTPRouteParameter{name: binding.name, ty: ty})
                local_types = next_local_types
            }
            .Switch(_, arms, else_body, _) -> {
                loop arm in arms {
                    loop response in sema_http_route_response_statements(arm.body, environment, program, scopes, local_types, aliases, module_identity) {
                        output.push(response)
                    }
                }
                loop response in sema_http_route_response_statements(else_body ?? [Stmt]{}, environment, program, scopes, local_types, aliases, module_identity) {
                    output.push(response)
                }
            }
            .While(_, body, _, _, _) | .For(_, _, _, _, body, _, _, _, _) | .Loop(body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Defer(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .ContextBlock(_, body, _) | .Live(body, _) | .AssumeDet(_, _, body, _) | .Transact(_, _, body, _, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> {
                loop response in sema_http_route_response_statements(body, environment, program, scopes, local_types, aliases, module_identity) {
                    output.push(response)
                }
            }
            .Assign(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .CountedLoop(_, _, _, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .Yield(_, _) | .DeferClose(_, _) -> {}
        }
    }
    output
}

sema_http_route_find_json_expr: fn(expression: Expr, request_names: [String]) -> Type? {
    if expression == {
        .Paren(inner, _, _) -> return sema_http_route_find_json_expr(inner, request_names)
        .MethodCall(receiver, method, _, _, type_args, args, _) -> {
            if method == "json" && type_args.len() == 1 {
                request := false
                if receiver == {
                    .Ident(name, _, _) -> {
                        loop request_name in request_names {
                            if request_name == name -> request = true
                        }
                    }
                    .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
                }
                if request -> return Val(type_args[0])
            }
            found := sema_http_route_find_json_expr(receiver, request_names)
            if found != None -> return found
            loop argument in args {
                argument_found := sema_http_route_find_json_expr(argument.expr, request_names)
                if argument_found != None -> return argument_found
            }
        }
        .Call(call, _) -> {
            loop argument in call.args {
                found := sema_http_route_find_json_expr(argument.expr, request_names)
                if found != None -> return found
            }
        }
        .Field(base, _, _, _) | .Unary(_, base, _, _) | .Ok(base, _, _) | .Try(base, _, _, _, _) -> return sema_http_route_find_json_expr(base, request_names)
        .Binary(_, left, right, _, _) -> {
            found := sema_http_route_find_json_expr(left, request_names)
            if found != None -> return found
            return sema_http_route_find_json_expr(right, request_names)
        }
        .ListLit(items, _, _) -> {
            loop item in items {
                found := sema_http_route_find_json_expr(item, request_names)
                if found != None -> return found
            }
        }
        .If(cond, then_body, then_value, else_body, else_value, _, _) -> {
            found := sema_http_route_find_json_expr(cond, request_names)
            if found == None -> found = sema_http_route_find_json_statements(then_body, request_names)
            if found == None -> found = sema_http_route_find_json_expr(then_value, request_names)
            if found == None -> found = sema_http_route_find_json_statements(else_body, request_names)
            if found == None -> found = sema_http_route_find_json_expr(else_value, request_names)
            return found
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> {
            loop field in fields {
                found := sema_http_route_find_json_expr(field.value, request_names)
                if found != None -> return found
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Err(_, _, _) | .OrFallback(_, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    None
}

sema_http_route_find_json_statements: fn(statements: [Stmt], request_names: [String]) -> Type? {
    loop statement in statements {
        found := if statement == {
            .Expr(expression) -> sema_http_route_find_json_expr(expression, request_names)
            .Val(binding) -> sema_http_route_find_json_expr(binding.init, request_names)
            .Return(value, _) -> {
                if value == {
                    .Val(expression) -> sema_http_route_find_json_expr(expression, request_names)
                    .None -> None
                }
            }
            .While(condition, body, _, _, _) -> {
                condition_found := sema_http_route_find_json_expr(condition, request_names)
                if condition_found != None -> condition_found else -> sema_http_route_find_json_statements(body, request_names)
            }
            .For(_, _, _, _, body, _, _, _, _) | .Loop(body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Defer(body, _) | .Switched(_, body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .ComptimeBlock(body, _, _) | .ContextBlock(_, body, _) | .Live(body, _) | .AssumeDet(_, _, body, _) | .Transact(_, _, body, _, _) | .ScopeMember(_, _, _, _, body, _, _, _) -> sema_http_route_find_json_statements(body, request_names)
            .Switch(_, arms, else_body, _) -> {
                loop arm in arms {
                    found_in_arm := sema_http_route_find_json_statements(arm.body, request_names)
                    if found_in_arm != None -> return found_in_arm
                }
                sema_http_route_find_json_statements(else_body ?? [Stmt]{}, request_names)
            }
            .Assign(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .CountedLoop(_, _, _, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .Yield(_, _) | .DeferClose(_, _) -> None
        }
        if found != None -> return found
    }
    None
}

sema_http_route_find_json_body: fn(body: LambdaBody, request_names: [String]) -> Type? {
    if body == {
        .Expr(expression) -> sema_http_route_find_json_expr(expression, request_names)
        .Block(statements) -> sema_http_route_find_json_statements(statements, request_names)
    }
}

// The route verbs are the cases of `core.http`'s `Method` enum (`Get` is
// `app.get`), except `Custom`, whose token is the custom verb's first
// argument (sema_http_route_custom_verb).
sema_http_route_verbs: fn() -> [String] Never! {
    variants: core_enum_variants("Method") ?? [String]{}
    verbs := [String]{}
    loop variant in variants {
        if variant != SEMA_HTTP_ROUTE_CUSTOM_CASE {
            verbs.push(variant.lower())
        }
    }
    verbs
}

SEMA_HTTP_ROUTE_CUSTOM_CASE: "Custom"

// `Method.Custom` as a verb: `app.custom(token, path, handler)`,
// `router.custom` and `#Server.Custom(token, path)`.
sema_http_route_custom_verb: fn() -> String Never! {
    SEMA_HTTP_ROUTE_CUSTOM_CASE.lower()
}

sema_http_route_method_name: fn(method: String) -> String Never! {
    method.upper()
}

// A static custom method token is checked while building by core.http's one
// method token check, `__method_token_check`, staged as a checked text
// literal's `check` is; a run-time App token meets the same check when it
// registers (`App.__http_route_custom`).
sema_http_route_stage_token_check: fn(token: String, argument: CallArg, environment: SemaScopeEnvironment, program: SemaProgramTables, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    span: argument.span
    identity: sema_call_core_module_identity(environment, program, "core.http") ?? return
    target: sema_call_core_source_target(environment, program, identity, "__method_token_check", [Type]{}, span, true, diagnostics) ?? return
    callee: sema_call_callee_decl(program, target.symbol.id, span, diagnostics) ?? return
    result: sema_call_signature_return(target.signature) ?? return
    text: sema_call_http_core_string(token, span)
    check: sema_tree_node(sema_call_resolved_type(result, environment, program), TExprKind.Call{callee: callee, type_args: target.type_args, args: [TCallArg]{sema_call_http_static_tree_arg(text, argument)}}, span)
    key: sema_symbol_key(program, context, target.symbol.id)
    evaluation := SemaCheckedTextEvaluation{
        module_identity: environment.module_identity,
        key: "{sema_scope_environment_module_text(environment, program)}::http-method::{span.start}:{span.end}",
        type_name: "HTTP route method",
        source_file: sema_source_file_at(environment.source_segments, environment.source_file, environment.source_origin, span),
        source_expression: argument.expr,
        expression: sema_publish_expression(check, context.arena.tree),
        ty: check.ty,
        hardware_use: sema_hardware_empty_use(),
        reachable_function_keys: [String]{key},
        dependencies: [String]{},
        span: span,
        code: "E2808",
        what: "HTTP route method `{token}` is refused",
        fix: (diagnostic_registry_row("E2808") ?? panic("E2808 has no registry row")).fix,
    }
    context.comptime_requests.push(SemaComptimeRequest{callee_key: key, module_identity: identity, args: [TComptimeValue]{}, span: span, checked_text: Val(evaluation)})
}

// The method part of a route's operation id: the lower-case verb of a
// standard method, or `custom_` and the exact token (web.openapi's
// __openapi_operation_method).
sema_http_route_operation_method: fn(method: String, wire: String) -> String Never! {
    if method == sema_http_route_custom_verb() -> return "custom_{wire}"
    method.copy()
}

sema_http_route_operation_id: fn(method: String, path: String) -> String Never! {
    output := "jet_{method}_"
    loop byte in path.bytes() {
        code := Int{byte}
        if {
            code >= 65 && code <= 90 -> {
                output = "{output}{String.from_bytes([U8]{U8{code + 32}}) ?? "_"}"
            }
            (code >= 97 && code <= 122) || (code >= 48 && code <= 57) || code == 95 -> {
                output = "{output}{String.from_bytes([U8]{U8{code}}) ?? "_"}"
            }
            else -> {
                output = "{output}_"
            }
        }
    }
    output
}

// `method` is the verb (`get`, `custom`), which decides how inputs bind;
// `wire` is the method as sent (`GET`, `PURGE`), or "" for a run-time custom
// token, which its mux completes when it registers.
sema_http_route_contract: fn(method: String, wire: String, pattern: String, path_fields: [SemaHTTPRoutePathField], shape: SemaHTTPRouteShape, body_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, is_mux: Bool, line: Int, locals: [SemaHTTPRouteParameter], responses: [SemaHTTPRouteResponse]) -> String? {
    canonical := ""
    if pattern == "/" -> canonical = "/" else {
        segments := pattern.split("/").to_list()
        loop index in 1..<segments.len() {
            segment := segments[index]
            canonical = "{canonical}/"
            if {
                segment.starts_with(":") || segment.starts_with("*") -> {
                    name := String.from_bytes(segment.bytes().slice(1, segment.bytes().len())) ?? return None
                    canonical = "{canonical}{{{name}}}"
                }
                else -> {
                    canonical = "{canonical}{segment}"
                }
            }
        }
    }
    path_params := [String]{}
    path_names := [String]{}
    loop field in path_fields {
        parameter: loop candidate in shape.params { if candidate.name == field.name && sema_call_http_nominal_leaf(candidate.ty) != "HTTPRequest" -> break candidate } ?? return None
        schema: sema_http_route_schema_type(parameter.ty, environment, program, shape.module_identity, [SymbolID]{}) ?? return None
        path_params.push("{{\"name\":{sema_http_route_json_quote(field.name)},\"in\":\"path\",\"required\":true,\"catch_all\":{field.catch_all},\"schema\":{schema}}}")
        path_names.push(field.name)
    }
    query_params := [String]{}
    if method == "get" || method == "head" || pattern == "" {
        loop parameter in shape.params {
            if sema_call_http_nominal_leaf(parameter.ty) == "HTTPRequest" -> next
            found_path := false
            loop path_name in path_names { if path_name == parameter.name -> found_path = true }
            if found_path -> next
            schema: sema_http_route_schema_type(parameter.ty, environment, program, shape.module_identity, [SymbolID]{}) ?? return None
            required := if parameter.ty == {
                .Option(_) -> false
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> true
            }
            query_params.push("{{\"name\":{sema_http_route_json_quote(parameter.name)},\"in\":\"query\",\"required\":{required},\"catch_all\":false,\"schema\":{schema}}}")
        }
    }
    params := path_params
    loop query in query_params -> params.push(query)
    request_body := "null"
    if body_type == .Val(ty) {
        schema: sema_http_route_schema_type(ty, environment, program, shape.module_identity, [SymbolID]{}) ?? return None
        request_body = "{{\"required\":true,\"content_type\":\"application/json\",\"schema\":{schema}}}"
    }
    response_json := [String]{}
    loop response in responses {
        schema := response.schema ?? "null"
        content_type := if response.content_type == .Val(text) -> sema_http_route_json_quote(text) else -> "null"
        response_json.push("{{\"status\":{response.status},\"description\":\"HTTP response\",\"schema\":{schema},\"content_type\":{content_type}}}")
    }
    if response_json.len() == 0 && !is_mux -> return None
    source := if environment.source_file == "" -> "<source>" else -> environment.source_file
    Val("{{\"method\":{sema_http_route_json_quote(wire)},\"pattern\":{sema_http_route_json_quote(pattern)},\"path\":{sema_http_route_json_quote(canonical)},\"operation_id\":{sema_http_route_json_quote(sema_http_route_operation_id(sema_http_route_operation_method(method, wire), canonical))},\"summary\":null,\"parameters\":[{params.join(",")}],\"request_body\":{request_body},\"responses\":[{response_json.join(",")}],\"security\":[],\"provenance\":{sema_http_route_json_quote("{source}:{line}")}}}")
}

sema_call_try_http_router: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    app: sema_app_is_route_table(receiver_value.ty, environment, program)
    receiver_name := if app -> "App" else -> sema_call_http_nominal_leaf(receiver_value.ty)
    if receiver_name != "HTTPRouter" && !app -> return SemaMethodSpecialCheck{handled: false, value: None}
    if app && method == "mount" -> return sema_call_http_mount(receiver, receiver_value, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    custom: method == sema_http_route_custom_verb()
    if !custom && !sema_http_route_verbs().contains(method) -> return SemaMethodSpecialCheck{handled: false, value: None}
    // A custom route's first argument is its method token; the path and
    // handler follow as at every verb.
    arity: if custom -> 3 else -> 2
    if updated_args.len() != arity {
        if updated_args.len() > arity - 2 {
            _ := sema_http_route_check_literal(updated_args[arity - 2], environment, program, scopes, diagnostics)
        }
        diagnostics.push(sema_call_arity_diagnostic(method, arity, updated_args.len(), false, span))
        loop argument in updated_args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    token_argument := CallArg?{None}
    if custom {
        token_argument = Val(updated_args[0].copy())
        updated_args = [CallArg]{updated_args[1].copy(), updated_args[2].copy()}
    }
    literal: sema_http_route_check_literal(updated_args[0], environment, program, scopes, diagnostics)
    path_value: sema_http_route_path_value(updated_args[0], environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    dynamic: literal.pattern == None
    pattern: literal.pattern ?? ""
    if dynamic && !app {
        if !literal.interpolated -> diagnostics.push(sema_error("E2805", updated_args[0].span, "HTTPRouter route path must be a static String or Path", "router endpoint contracts are fully checked while building; App routes may be computed at runtime", "use a literal, a compile-time String constant or a Path without holes, or register the dynamic route on a `web.app()`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    // The method as sent: a standard verb's upper-case name, or the custom
    // token in its exact case; "" for a run-time token, which only an App
    // takes and checks when it registers.
    wire := sema_http_route_method_name(method)
    token_value := TExpr?{None}
    if token_argument == .Val(token_arg) {
        if sema_http_route_constant_string(token_arg.expr, environment, program, scopes) == .Val(token) {
            sema_http_route_stage_token_check(token, token_arg, environment, program, context, diagnostics)
            wire = token
        } else {
            if !app {
                diagnostics.push(sema_error("E2808", token_arg.span, "HTTPRouter custom route method must be a static String", "router and `#Server.Custom` routes are fully checked while building; only an App takes a run-time method, checked when it registers", "use a literal or compile-time String constant, or register the route on a `web.app()`"))
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            token_value = Val(sema_call_http_check_value(token_arg, Type.String, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None})
            wire = ""
        }
    }
    // A refused pattern (E2805) registers nothing, so it can't collide with a
    // valid route as a duplicate (E2804).
    if !dynamic && !literal.invalid && wire != "" {
        chained := false
        if app && program.registration_graph == .Val(graph) -> chained = sema_app_check_route_registrations(receiver, method, args, span, environment, graph, diagnostics)
        if !chained -> sema_http_route_table_record(receiver, wire, pattern, span, scopes, context, diagnostics)
    }
    if !literal.invalid {
        path_fields: sema_http_route_path_fields(pattern) ?? [SemaHTTPRoutePathField]{}
        mux_request := Type?{None}
        if app -> mux_request = Val(sema_call_resolved_type(Type.Named{name: "HTTPRequest"}, environment, program))
        handler_shape: sema_http_route_shape(updated_args[1].expr, environment, program, scopes, context.host_hooks, mux_request) ?? {
            diagnostics.push(sema_error("E2805", updated_args[1].span, "HTTP route handler must be a lambda or named function with explicit typed parameters", "route binding needs source parameter names and types before it can define transport inputs", "write `fn(id: Int, req: HTTPRequest) {{ ... }}` or pass a named function"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        request_names := [String]{}
        typed := [SemaHTTPRouteParameter]{}
        loop parameter in handler_shape.params {
            if {
                sema_call_http_nominal_leaf(parameter.ty) == "HTTPRequest" -> {
                    request_names.push(parameter.name)
                }
                else -> {
                    typed.push(parameter)
                }
            }
        }
        // A route handler takes at most one HTTPRequest: a second one is not a
        // binding question but a handler that does not have the route
        // handler's type, reported as the lambda/argument mismatch it is.
        if request_names.len() > 1 {
            request_ty: sema_call_resolved_type(Type.Named{name: "HTTPRequest"}, environment, program)
            required: Type.Fn{params: [Type]{request_ty}, ret: Val(Type.Result{ok: Type.Named{name: "HTTPResponse"}, err: Type.Named{name: "HTTPError"}}), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
            // Rust expect_core_arg: the handler is checked against the route
            // handler type, and a type it still does not have is E0112.
            handler_value: sema_expression_lambda_host_callback(updated_args[1].expr, Val(required), false, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
            if sema_call_host_callback_assignable(required, handler_value.ty, environment, program) == (.Val(false)) {
                diagnostics.push(sema_error("E0112", expr_span(updated_args[1].expr), "`{method}` wants {sema_type_show(required)} for argument 2, but this is {sema_type_show(handler_value.ty)}", "every argument must match its parameter's type", sema_type_fix_hint(required, handler_value.ty)))
            }
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        handler_issue := ""
        issue_why := "path placeholders bind by name; GET/HEAD remainder is query data and non-GET inputs need an explicit body model"
        issue_fix := "rename the handler input, add the matching path placeholder, or decode a body with `req.json<T>()`"
        issue_span := updated_args[1].span
        if dynamic {
            loop parameter in typed {
                if !sema_serde_type_is_admissible(environment, program, parameter.ty, SemaSerdeDirection.Decode) -> handler_issue = "dynamic HTTP route input `{parameter.name}` cannot decode text into handler type `{type_name(parameter.ty)}`"
            }
        }
        seen := [String]{}
        loop parameter in handler_shape.params {
            loop existing in seen {
                if existing == parameter.name {
                    handler_issue = "HTTP route `{pattern}` has ambiguous handler input `{parameter.name}`"
                    break
                }
            }
            seen.push(parameter.name)
        }
        // A path field's binding is a property of the route path, so its
        // diagnostics point at the path string.
        loop field in path_fields {
            matches := 0
            loop parameter in typed { if parameter.name == field.name -> matches = matches + 1 }
            if matches != 1 {
                handler_issue = "HTTP route `{pattern}` path field `{field.name}` does not have exactly one typed handler input"
                issue_why = "path placeholders are bound by name before request decoding"
                issue_fix = "declare one `{field.name}: T` handler input"
                issue_span = updated_args[0].span
            }
            loop parameter in typed {
                if parameter.name == field.name && !sema_serde_type_is_admissible(environment, program, parameter.ty, SemaSerdeDirection.Decode) {
                    handler_issue = "HTTP route `{pattern}` path field `{field.name}` cannot decode text into handler type `{type_name(parameter.ty)}`"
                    issue_why = "path parameters use the same checked Decode capability as request decoding"
                    issue_fix = "give `{type_name(parameter.ty)}` a `Decode` implementation, or use a decodable parameter type"
                    issue_span = updated_args[0].span
                }
            }
        }
        path_names := [String]{}
        loop field in path_fields -> path_names.push(field.name)
        query_names := [String]{}
        loop parameter in typed {
            found_path := false
            loop path_name in path_names { if path_name == parameter.name -> found_path = true }
            if !found_path {
                if method == "get" || method == "head" || dynamic {
                    query_names.push(parameter.name)
                } else {
                    handler_issue = "HTTP route `{pattern}` has unbound non-GET handler input `{parameter.name}`"
                    issue_why = "path placeholders bind by name; GET/HEAD remainder is query data and non-GET inputs need an explicit body model"
                    issue_fix = "rename the handler input, add the matching path placeholder, or decode a body with `req.json<T>()`"
                    issue_span = updated_args[1].span
                }
            }
        }
        if handler_issue != "" {
            diagnostics.push(sema_error("E2805", issue_span, handler_issue, issue_why, issue_fix))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        result := Type.Result{ok: Type.Named{name: "HTTPResponse"}, err: Type.Named{name: "HTTPError"}}
        // An App or router route runs as `fn(HTTPRequest)`: the handler's
        // typed inputs decode from the request (sema_http_mux_route_handler).
        request_ty: sema_call_resolved_type(Type.Named{name: "HTTPRequest"}, environment, program)
        updated_args[1].expr = sema_http_mux_route_handler(updated_args[1].expr, handler_shape.params, request_names, typed, request_ty, updated_args[1].span)
        handler_type: Type.Fn{params: [Type]{request_ty}, ret: Val(result), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
        callback: sema_check_expression_with_lambda_escapes(updated_args[1].expr, Val(handler_type), environment, program, scopes, state, tail_store, context, Val(true), diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        if !sema_call_http_check_middleware_callback(callback, environment, program, scopes, state, context, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        updated_args[1].convention = AccessConvention.Move
        params := [SemaCallParam]{SemaCallParam{label: "path", name: "path", zone: ParamZone.Either, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.String), variadic: false}, SemaCallParam{label: "handler", name: "handler", zone: ParamZone.Either, default: None, default_ref: None, convention: AccessConvention.Move, ty: Val(handler_type), variadic: false}}
        ownership := sema_ownership_check_method_call(state, "{receiver_name}.{method}", receiver, AccessConvention.Read, params, updated_args, scopes, span, diagnostics)
        if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
        line: sema_source_line_at(environment.source_segments, span) ?? 1
        body_type := sema_http_route_find_json_body(handler_shape.body, request_names)
        if body_type == .Val(body_ty) {
            body_model_type := if body_ty == {
                .Option(inner) -> inner
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> body_ty
            }
            body_fields := sema_http_route_find_struct(environment, program, body_model_type, handler_shape.module_identity)
            if body_fields == .Val(definition) {
                loop field in definition.fields {
                    if !field.is_pub || field.computed != None -> next
                    duplicate := false
                    loop path_name in path_names { if path_name == field.name -> duplicate = true }
                    loop query_name in query_names { if query_name == field.name -> duplicate = true }
                    if duplicate {
                        diagnostics.push(sema_error("E2805", updated_args[1].span, "HTTP route `{pattern}` binds body field `{field.name}` twice", "path, query, and body fields are distinct transport sources", "rename `{field.name}` in the body or remove the duplicate binding"))
                        return SemaMethodSpecialCheck{handled: true, value: None}
                    }
                }
            }
        }
        response_aliases := [SemaHTTPRouteResponseAlias]{}
        responses := if handler_shape.body == {
            .Expr(expression) -> sema_http_route_response_expr(expression, environment, program, scopes, handler_shape.params, response_aliases, handler_shape.module_identity)
            .Block(statements) -> sema_http_route_response_statements(statements, environment, program, scopes, handler_shape.params, response_aliases, handler_shape.module_identity)
        }
        contract: sema_http_route_contract(method, wire, pattern, path_fields, handler_shape, body_type, environment, program, app, line, handler_shape.params, responses) ?? {
            diagnostics.push(sema_error("E2805", updated_args[1].span, "HTTP route handler has no complete checked endpoint contract", "router registration needs response metadata and serializable path/query/body schemas", "return a typed `HTTPResponse` constructor from every handler path"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        // A run-time custom token is its own checked value; any other method
        // is its text as sent.
        verb: if token_value == .Val(found) -> found else -> sema_check_expression(Expr.Str{parts: [StrPart]{StrPart.Lit{text: wire}}, span: span, id: AST_NODE_GENERATED}, Val(Type.String), environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        // The route keeps its checked contract: `web.openapi(app)` and
        // `web.openapi(router)` render the document from these registrations.
        // A run-time App pattern's contract is completed from that pattern
        // when it registers, and a run-time custom method's from that method.
        contract_value: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: contract}}}, span)
        route_args := [TCallArg]{
            sema_call_http_static_tree_arg(verb, sema_call_http_core_synthetic_arg(updated_args[0].expr, span)),
            sema_call_http_static_tree_arg(path_value, updated_args[0]),
            sema_call_http_static_tree_arg(callback, updated_args[1]),
            sema_call_http_static_tree_arg(contract_value, sema_call_http_core_synthetic_arg(updated_args[0].expr, span)),
        }
        target: if {
            !app -> "__route"
            wire == "" -> "__http_route_custom"
            dynamic -> "__http_route_dynamic"
            else -> "__http_route"
        }
        return sema_call_http_mux_source_call(receiver_value, target, route_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    SemaMethodSpecialCheck{handled: true, value: None}
}

// Two registrations through one binding with one method and address report
// at the second; the rows of one builder chain are checked along the chain
// (sema_app_check_route_registrations), and every other pair when it
// registers.
sema_http_route_table_record: fn(receiver: Expr, wire: String, pattern: String, span: Span, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) {
    root: sema_expr_place_root_ident(receiver) ?? return
    binding_index: sema_scope_resolve_index(scopes, root) ?? return
    key: "{scopes.bindings[binding_index].key}|{wire}|{sema_app_route_shape(pattern)}"
    if context.http_routes.get(key) == .Val(first) {
        diagnostics.push(sema_http_route_duplicate(wire, pattern, span, "", first, "first registered here"))
    } else {
        context.http_routes[key] = span
    }
}

sema_http_mux_ident: fn(name: String, span: Span) -> Expr Never! {
    Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
}

sema_http_mux_lambda: fn(expression: Expr) -> Lambda? {
    if expression == {
        .Paren(inner, _, _) -> return sema_http_mux_lambda(inner)
        .Lambda(lambda, _) -> return Val(lambda)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

sema_http_mux_callee: fn(expression: Expr) -> String? {
    if expression == {
        .Paren(inner, _, _) -> return sema_http_mux_callee(inner)
        .Ident(name, _, _) -> return Val(name)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

// A mux route stores one request-taking handler. Each typed input decodes
// from the request's path parameters or query before the handler body runs;
// an input that does not decode answers 400 without entering the body.
sema_http_mux_route_handler: fn(handler: Expr, params: [SemaHTTPRouteParameter], request_names: [String], typed: [SemaHTTPRouteParameter], request_ty: Type, span: Span) -> Expr Never! {
    request := "__jet_http_request"
    if request_names.len() == 1 && request_names[0] != "_" -> request = request_names[0]
    body := [Stmt]{}
    loop parameter in typed {
        name_arg: CallArg{convention: AccessConvention.Read, expr: Expr.Str{parts: [StrPart]{StrPart.Lit{text: parameter.name}}, span: span, id: AST_NODE_GENERATED}, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
        input: Expr.MethodCall{receiver: sema_http_mux_ident(request, span), method: "__route_input", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{parameter.ty}, args: [CallArg]{name_arg}, id: AST_NODE_GENERATED}
        rejected: Expr.MethodCall{receiver: sema_http_mux_ident(request, span), method: "__route_rejected", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, id: AST_NODE_GENERATED}
        decoded: Expr.OrFallback{value: input, fallback: OrFallback.Return{value: Val(Expr.Ok{value: rejected, span: span, id: AST_NODE_GENERATED}), span: span}, is_option: true, span: span, id: AST_NODE_GENERATED}
        body.push(Stmt.Val{binding: ast_binding(parameter.name, span, false, decoded, None)})
    }
    request_param: LambdaParam{name: request, name_span: span, ty: Val(request_ty), ty_span: None, convention: AccessConvention.Read}
    if sema_http_mux_lambda(handler) == .Val(lambda) {
        if lambda.body == {
            .Expr(value) -> { body.push(Stmt.Expr{expr: value}) }
            .Block(statements) -> { loop statement in statements -> body.push(statement) }
        }
        return Expr.Lambda{lambda: Lambda{take_names: lambda.take_names, params: [LambdaParam]{request_param}, effects: lambda.effects, body: LambdaBody.Block{body: body}, span: lambda.span, meta: lambda.meta}, id: AST_NODE_GENERATED}
    }
    callee: sema_http_mux_callee(handler) ?? panic("HTTP mux route handler is neither a lambda nor a named function")
    args := [CallArg]{}
    loop parameter in params {
        name := parameter.name
        if request_names.contains(parameter.name) -> name = request
        args.push(CallArg{convention: AccessConvention.Read, expr: sema_http_mux_ident(name, span), span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false})
    }
    body.push(Stmt.Expr{expr: Expr.Call{call: Call{name: callee, name_span: span, type_args: [Type]{}, args: args}, id: AST_NODE_GENERATED}})
    Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: [LambdaParam]{request_param}, effects: None, body: LambdaBody.Block{body: body}, span: span, meta: ast_empty_lambda_meta()}, id: AST_NODE_GENERATED}
}
