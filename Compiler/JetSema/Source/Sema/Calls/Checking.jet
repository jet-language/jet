// Type-check and lower one already-resolved call binding.
//
// Binding owns declaration order; this file owns expression checking and the
// one-way conversion to TCallArg. It never materializes a Type-only default:
// Registration must provide the original expression through
// SemaCallDefaultValue first.
use {
    jet_foundation.[
        AccessConvention,
        BinderRef,
        CallArg,
        DIAGNOSTIC_ERROR,
        Diagnostic,
        DiagnosticCryptoMisuseReason,
        DiagnosticStructured,
        Expr,
        Func,
        InternalTag,
        Lambda,
        Stmt,
        FunctionDefaultRef,
        CopyFact,
        Span,
        Symbol,
        SymbolID,
        SymbolKind,
        TagMarker,
        TLetTy,
        Type,
        ast_empty_call_arg_flags,
        ast_visit_expr,
        diagnostic_registry_row,
        expr_source_span,
        expr_span,
        symbol_id,
        checked_symbol_local,
        type_identity_equal,
        type_name,
    ]
    jet_parser.[jfmt_expr_start]
}

SemaCallTypedArguments: struct {
    values: [TExpr]
    slots: [Int]
    required_types: [Type]
    // Each argument's written position (`-1` for a default). When a default
    // reads an earlier parameter, every argument is pinned in
    // `binder_ref_<site>_<slot>` in the Rust reference's source order.
    source_indices: [Int]
    pin_arguments: Bool{false}
    binder_site: Int{0}
}

sema_call_resolved_type: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type Never! {
    if program.registration_graph == .Val(graph) {
        sema_type_resolve_declared_recursive(graph, ty, sema_scope_caller_row(environment, graph), environment.generic_params)
    } else {
        // copy: the resolved type is a new owned Type. When nothing resolves it equals `ty`, the
        // caller's signature type (a read parameter), which stays in the signature.
        return ty.copy()
    }
}

sema_call_type_assignable: fn(required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool? {
    if program.registration_graph == {
        .Val(graph) -> sema_type_assignable_in_graph_at(graph, required, offered, sema_scope_caller_row(environment, graph), environment.generic_params)
        .None -> Val(sema_type_assignable(required, offered))
    }
}

sema_call_box_as_trait: fn(required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type? {
    required_resolved: sema_call_resolved_type(required, environment, program)
    if required_resolved == {
        .TraitObject(_) -> {}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> return None
    }
    offered_resolved: sema_call_resolved_type(offered, environment, program)
    if offered_resolved == {
        .TraitObject(_) -> return None
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {}
    }
    compatible: sema_call_type_assignable(required_resolved, offered_resolved, environment, program) ?? return None
    if compatible -> Val(required_resolved) else -> None
}

sema_call_registration_defaults: fn(graph: SemaRegistrationGraph, binding: SemaCallBinding) -> [SemaCallDefaultValue]? {
    defaults := [SemaCallDefaultValue]{}
    loop reference in binding.default_refs {
        expression: sema_registration_resolve_default(graph, reference) ?? return None
        defaults.push(SemaCallDefaultValue{reference: reference, expression: expression})
    }
    Val(defaults)
}

sema_call_param_optional_for_check: fn(param: SemaCallParam) -> Bool Never! {
    param.variadic || param.default != None || param.default_ref != None
}

sema_call_default_ref_equal: fn(left: FunctionDefaultRef, right: FunctionDefaultRef) -> Bool Never! {
    left.source_file == right.source_file && left.owner_key == right.owner_key && left.parameter_index == right.parameter_index && left.span.start == right.span.start && left.span.end == right.span.end
}

sema_call_default_expression: fn(reference: FunctionDefaultRef, defaults: [SemaCallDefaultValue]) -> Expr? {
    loop candidate in defaults {
        if sema_call_default_ref_equal(reference, candidate.reference) -> return Val(candidate.expression)
    }
    None
}

sema_call_make_binder_refs: fn(params: [SemaCallParam], parameter: Int) -> [BinderRef] Never! {
    refs := [BinderRef]{}
    loop index in 0..<parameter {
        if sema_call_parameter_type(params[index]) == .Val(value) {
            refs.push(BinderRef{name: params[index].name, slot: index, ty: value})
        }
    }
    refs
}

sema_call_mark_materialized_written: fn(arg: CallArg, source_index: Int, parameter: Int, param: SemaCallParam, span: Span) -> CallArg Never! {
    result := arg
    result.flags.source_index = Val(source_index)
    result.flags.binder_slot = Val(parameter)
    result.flags.binder_site = Val(span.start)
    result.flags.binder_label = Val(param.label)
    result
}

sema_call_make_materialized_default: fn(value: Expr, parameter: Int, param: SemaCallParam, params: [SemaCallParam], span: Span) -> CallArg Never! {
    flags := ast_empty_call_arg_flags()
    flags.binder_slot = Val(parameter)
    flags.binder_site = Val(span.start)
    flags.binder_label = Val(param.label)
    flags.binder_refs = sema_call_make_binder_refs(params, parameter)
    CallArg{convention: param.convention, expr: value, span: span, flags: flags, label: None, spread: false}
}

// Fill only metadata defaults whose original expressions Registration resolved.
// The returned binding keeps source indices stable for evaluation-order lowering.
sema_call_materialize_defaults: fn(params: [SemaCallParam], binding: SemaCallBinding, args: &[CallArg], defaults: [SemaCallDefaultValue], call_span: Span, diagnostics: &[Diagnostic]) -> SemaCallBinding? {
    if binding.default_refs.len() == 0 -> return Val(binding)
    loop reference in binding.default_refs {
        if sema_call_default_expression(reference, defaults) == None {
            diagnostics.push(sema_error("E0906", call_span, "a default argument for this call could not be resolved", "callable defaults retain their owning declaration and source identity", "make the owning declaration available to Registration before checking this call"))
            return None
        }
    }
    rewritten := [CallArg]{}
    loop source in binding.sources {
        if source == {
            .Written(original_index) -> {
                if original_index < 0 || original_index >= args.len() {
                    diagnostics.push(sema_call_arity_diagnostic("this call", params.len(), args.len(), false, call_span))
                    return None
                }
                parameter: if original_index < binding.slots.len() -> binding.slots[original_index] else -> -1
                if parameter < 0 || parameter >= params.len() {
                    diagnostics.push(sema_call_arity_diagnostic("this call", params.len(), args.len(), false, call_span))
                    return None
                }
                rewritten.push(sema_call_mark_materialized_written(args[original_index], original_index, parameter, params[parameter], call_span))
            }
            .Default(parameter) -> {
                if parameter < 0 || parameter >= params.len() {
                    diagnostics.push(sema_error("E0906", call_span, "a default argument refers to an invalid parameter", "default metadata must point into the owning declaration", "repair the registered FunctionDefaultRef"))
                    return None
                }
                reference: params[parameter].default_ref ?? {
                    diagnostics.push(sema_error("E0906", call_span, "a default argument lost its source reference", "metadata defaults are identified by FunctionDefaultRef", "register the declaration's original default expression"))
                    return None
                }
                expression: sema_call_default_expression(reference, defaults) ?? {
                    diagnostics.push(sema_error("E0906", call_span, "a default argument for this call could not be resolved", "callable defaults retain their owning declaration and source identity", "make the owning declaration available to Registration before checking this call"))
                    return None
                }
                rewritten.push(sema_call_make_materialized_default(expression, parameter, params[parameter], params, call_span))
            }
        }
    }
    if rewritten.len() != binding.sources.len() {
        diagnostics.push(sema_error("E0104", call_span, "the call binding did not produce one value per declaration slot", "a successful call has to account for every written value and resolved default", "check the callable declaration and its default metadata"))
        return None
    }
    loop args.len() > 0 -> _ := args.pop()
    loop value in rewritten -> args.push(value)
    result := binding
    result.rewrote = true
    result
}

sema_call_bound_slot: fn(binding: SemaCallBinding, source: SemaCallArgSource, arg: CallArg) -> Int Never! {
    if arg.flags.binder_slot == .Val(slot) -> return slot
    if source == {
        .Written(index) -> if index >= 0 && index < binding.slots.len() -> binding.slots[index] else -> -1
        .Default(parameter) -> parameter
    }
}

sema_call_view_place_equal: fn(left: SemaOwnershipPlace, right: SemaOwnershipPlace) -> Bool Never! {
    if left.root_key != right.root_key || left.projections.len() != right.projections.len() -> return false
    loop index in 0..<left.projections.len() {
        if left.projections[index] != right.projections[index] -> return false
    }
    true
}

sema_call_return_view_parameter_expr: fn(parameter: Int, binding: SemaCallBinding, args: [CallArg]) -> Expr? {
    loop index in 0..<args.len() {
        source: binding.sources[index]
        if sema_call_bound_slot(binding, source, args[index]) == parameter -> return Val(args[index].expr)
    }
    None
}

// The returned-view facts of one checked call. A source argument or receiver
// with no caller place is a temporary. A binding or `return` that keeps the
// view refuses every temporary (sema_stmt_report_temporary_view_sources). Here,
// at the call, a temporary the call frees is refused whatever consumes the
// result: a surrounding expression would read freed storage. A string literal
// is static text that is never freed, so only a kept view refuses it.
sema_call_return_view_facts: fn(signature: Type, receiver: Expr?, args: [CallArg], binding: SemaCallBinding, scopes: SemaScopeTable, state: &SemaOwnershipState, span: Span, diagnostics: &[Diagnostic]) -> [SemaCallReturnViewFact] {
    map: if signature == {
        .Fn(_, _, _, _, _, return_view_provenance) -> return_view_provenance ?? return [SemaCallReturnViewFact]{}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {
            return [SemaCallReturnViewFact]{}
        }
    }
    string_result: if signature == {
        .Fn(_, ret, _, _, _, _) -> if ret == .Val(result) -> sema_stmt_string_view_type(sema_call_view_result_success(result)) else -> false
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
    facts := [SemaCallReturnViewFact]{}
    loop entry in map.entries {
        places := [SemaOwnershipPlace]{}
        temporaries := [Span]{}
        loop source_path in entry.value.sources {
            source_expr := Expr?{None}
            if source_path.source == {
                // copy: each return-view source path builds its own source Expr, and `receiver` is
                // the caller's call receiver (a read parameter), used once per path in this loop.
                .Receiver -> source_expr = receiver.copy()
                .Parameter(parameter) -> source_expr = sema_call_return_view_parameter_expr(parameter, binding, args)
                .Static(_, _) -> {}
            }
            if source_expr == .Val(expression) {
                source_places: sema_ownership_places_from_expr_in_state(expression, scopes, state)
                if source_places.len() == 0 {
                    temporary: expr_source_span(expression)
                    temporaries.push(temporary.copy())
                    if !sema_call_static_text_literal(expression) -> sema_call_report_temporary_view_source(temporary, string_result && entry.slot.len() == 0, diagnostics)
                }
                loop source_place in source_places {
                    place: sema_ownership_append_view_source_projections(source_place, source_path.projections, span)
                    duplicate: loop existing in places {
                        if sema_call_view_place_equal(existing, place) -> break true
                    } ?? false
                    if !duplicate -> places.push(place)
                }
            }
        }
        access: if entry.value.mutable -> AccessConvention.Write else -> AccessConvention.Read
        facts.push(SemaCallReturnViewFact{
            slot: entry.slot,
            access: access,
            places: places,
            sources: entry.value.sources,
            temporaries: temporaries,
        })
    }
    sema_ownership_note_call_views(state, span, facts)
    facts
}

// The value an infallible or fallible call returns on success (`T` of
// `T Never!` / `T E!`), with user tags removed.
sema_call_view_result_success: fn(ty: Type) -> Type Never! {
    if sema_expr_unwrap_tag(ty) == .Result(ok, _) -> return sema_expr_unwrap_tag(ok)
    sema_expr_unwrap_tag(ty)
}

// A string literal with no interpolation is static text: no call frees it.
sema_call_static_text_literal: fn(expression: Expr) -> Bool Never! {
    if expression == {
        .Paren(inner, _, _) -> return sema_call_static_text_literal(inner)
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(_, _) -> return false
            }
            return true
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}

// A view-returning call whose source owner is a temporary (Rust
// `report_temporary_view_source`). A source span is reported once, whichever
// of the two codes reached it first.
sema_call_report_temporary_view_source: fn(span: Span, string_view: Bool, diagnostics: &[Diagnostic]) Never! {
    loop previous in diagnostics {
        if (previous.code == "E2305" || previous.code == "E2307") && previous.span == span -> return
    }
    diagnostic: if string_view -> sema_error("E2307", span, "A returned view cannot borrow from a temporary argument", "The temporary owner is dropped at the end of this statement, while the returned view remains live", "Store the owner in a named binding first, then pass that binding to the view-returning call") else -> sema_error("E2305", span, "a returned view cannot borrow from a temporary argument", "the temporary owner is dropped at the end of this statement, while the returned view remains live", "store the owner in a named binding first, then pass that binding to the view-returning call")
    diagnostics.push(diagnostic)
}

sema_call_validate_binding: fn(callee: String, params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if binding.sources.len() != args.len() {
        diagnostics.push(sema_error("E0104", span, "the call binding and written arguments disagree", "a checked call must have one source row for every argument value", "resolve callable defaults before checking the call"))
        return false
    }
    seen := [Bool]{}
    loop index in 0..<params.len() -> seen.push(false)
    valid := true
    loop index in 0..<binding.sources.len() {
        slot: sema_call_bound_slot(binding, binding.sources[index], args[index])
        if {
            slot < 0 || slot >= params.len() -> valid = false
            else -> seen[slot] = true
        }
    }
    if !valid {
        diagnostics.push(sema_call_arity_diagnostic(callee, params.len(), args.len(), false, span))
    }
    missing := 0
    loop index in 0..<params.len() {
        if !seen[index] && !sema_call_param_optional_for_check(params[index]) {
            diagnostics.push(sema_call_diag_missing(callee, params[index].label, span))
            missing += 1
        }
    }
    valid && missing == 0
}

sema_call_is_scalar: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .IntN(_, _) -> true
        .Float -> true
        .Float32 -> true
        .Bool -> true
        .Char -> true
        .String | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// Whether a callback argument at a C boundary is outside the C callback
// subset, which accepts only function values. A name that is not a
// registered function, and a module-qualified name, are left to the
// ordinary argument check.
sema_call_c_callback_unsafe: fn(argument: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> Bool {
    if argument == {
        .Ident(name, _, _) -> {
            function: sema_http_route_find_function(environment, program, scopes, name) ?? return false
            return !sema_call_foreign_thread_safe_func(function.declaration)
        }
        .Lambda(lambda, _) -> return !sema_call_foreign_thread_safe_lambda(lambda) || sema_call_lambda_captures_local(lambda, scopes)
        .Field(base, _, _, _) -> {
            if base == .Ident(name, _, _) {
                index: sema_scope_resolve_index(scopes, name) ?? return false
                kind: scopes.bindings[index].symbol.kind
                return kind != SymbolKind.Module && kind != SymbolKind.Import
            }
            return true
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}

// A C callback lambda is capture-free: no name it reads, other than its own
// parameters and bindings, may be a local of the enclosing function.
sema_call_lambda_captures_local: fn(lambda: Lambda, scopes: SemaScopeTable) -> Bool {
    inner := (loop parameter in lambda.params -> parameter.name)
    names := [String]{}
    if lambda.body == {
        .Expr(value) -> ast_visit_expr(value, fn(expression: Expr) { sema_call_note_ident(names, expression) })
        .Block(body) -> {
            loop statement in body {
                if statement == {
                    .Val(binding) -> {
                        inner.push(binding.name)
                        ast_visit_expr(binding.init, fn(expression: Expr) { sema_call_note_ident(names, expression) })
                    }
                    .Expr(value) -> ast_visit_expr(value, fn(expression: Expr) { sema_call_note_ident(names, expression) })
                    .Return(value, _) -> {
                        if value == .Val(returned) -> ast_visit_expr(returned, fn(expression: Expr) { sema_call_note_ident(names, expression) })
                    }
                    .Assign(_, _, _, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> {}
                }
            }
        }
    }
    loop name in names {
        if inner.contains(name) -> next
        index: sema_scope_resolve_index(scopes, name) ?? next
        kind: scopes.bindings[index].symbol.kind
        if kind == SymbolKind.Local || kind == SymbolKind.Parameter -> return true
    }
    false
}

sema_call_note_ident: fn(names: &[String], expression: Expr) {
    if expression == .Ident(name, _, _) -> names.push(name.copy())
}

sema_call_foreign_thread_safe_func: fn(func: Func) -> Bool Never! {
    if !func.is_pure || func.type_params.len() > 0 || func.pre.len() > 0 || func.post.len() > 0 -> return false
    loop statement in func.body {
        if !sema_call_foreign_thread_safe_stmt(statement) -> return false
    }
    true
}

sema_call_foreign_thread_safe_lambda: fn(lambda: Lambda) -> Bool Never! {
    if lambda.take_names.len() > 0 || lambda.meta.mut_captures.len() > 0 || lambda.meta.cloned_captures.len() > 0 -> return false
    if lambda.body == {
        .Expr(value) -> return sema_call_foreign_thread_safe_expr(value)
        .Block(body) -> {
            loop statement in body {
                if !sema_call_foreign_thread_safe_stmt(statement) -> return false
            }
            return true
        }
    }
}

sema_call_foreign_thread_safe_stmt: fn(statement: Stmt) -> Bool Never! {
    if statement == {
        .Return(value, _) -> return if value == .Val(returned) -> sema_call_foreign_thread_safe_expr(returned) else -> true
        .Expr(value) -> return sema_call_foreign_thread_safe_expr(value)
        .Val(binding) -> return sema_call_foreign_thread_safe_expr(binding.init)
        .Assign(_, _, _, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> return false
    }
}

sema_call_foreign_thread_safe_expr: fn(expression: Expr) -> Bool Never! {
    if expression == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Char(_, _, _) | .Ident(_, _, _) -> return true
        .Unary(_, operand, _, _) -> return sema_call_foreign_thread_safe_expr(operand)
        .Copy(value, _, _) -> return sema_call_foreign_thread_safe_expr(value)
        .Binary(_, left, right, _, _) -> return sema_call_foreign_thread_safe_expr(left) && sema_call_foreign_thread_safe_expr(right)
        .CompareChain(operands, _, _, _, _) -> {
            loop operand in operands {
                if !sema_call_foreign_thread_safe_expr(operand) -> return false
            }
            return true
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}

sema_call_lambda_escape_policy: fn(parameter: SemaCallParam, abi: SemaRegistrationCallableABI?) -> Bool? {
    if parameter.convention == AccessConvention.Move -> return Val(true)
    callable_abi: abi ?? return None
    parameter_type: sema_call_parameter_type(parameter) ?? return None
    Val(sema_registration_callback_boundary_param(callable_abi, parameter_type))
}

sema_call_typecheck_bound_arguments: fn(callee: String, params: [SemaCallParam], abi: SemaRegistrationCallableABI?, apply_lambda_escape_override: Bool, binding: SemaCallBinding, args: &[CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic], report_conventions: Bool) -> SemaCallTypedArguments? {
    if !sema_call_validate_binding(callee, params, binding, args, span, diagnostics) -> return None
    values := [TExpr]{}
    slots := [Int]{}
    required_types := [Type]{}
    source_indices := [Int]{}
    pin_arguments := !binding.source_ordered
    binder_site := span.start
    reference_starts := [Int]{}
    take_indices := [Int]{}
    take_keys := [String]{}
    // Every argument is checked, so each mismatched one is reported.
    complete := true
    call_diagnostics_start: diagnostics.len()
    // The first argument a C function receives as a callback pointer.
    c_callback := Span?{None}
    loop index in 0..<args.len() {
        reference_starts.push(context.name_references.len())
        slot: sema_call_bound_slot(binding, binding.sources[index], args[index])
        if slot < 0 || slot >= params.len() -> return None
        parameter: params[slot]
        // A `#caller` default is the place of this call.
        if binding.sources[index] == .Default(_) && sema_site_is_caller(args[index].expr) -> args[index].expr = sema_site_location_expr("", environment, program, scopes, span)
        required_declared: sema_call_argument_parameter_type(parameter, args[index]) ?? {
            diagnostics.push(sema_error("E0112", args[index].span, "this callable parameter has no checked type", "call checking cannot prove an argument safe without the declaration type", "register the complete callable signature"))
            return None
        }
        required: sema_call_resolved_type(required_declared, environment, program)
        // An unmarked place a write parameter receives is its write access.
        if sema_call_unmarked_write_place(parameter, args[index]) {
            args[index].convention = AccessConvention.Write
        }
        // `place.move()` handed to a take parameter is the call's take of that place.
        if parameter.convention == AccessConvention.Move && sema_expr_argument_move_place(args[index], scopes) == .Val(taken) {
            args[index].expr = taken
            args[index].convention = AccessConvention.Move
        }
        if args[index].convention == AccessConvention.Write -> sema_stmt_uninit_write_arg(args[index], state, scopes, diagnostics)
        decision: sema_call_argument_convention(parameter, args[index])
        // Rust CallBinder `rewrite` + `register_binder_refs`: a default names
        // earlier parameters through their declaration-slot temporaries, so
        // they shadow any caller binding of the same name.
        binder_refs: args[index].flags.binder_refs
        binder_start: context.name_references.len()
        // A default written in another module checks in its declaring module's
        // names (sema_default_owner_scope), as a fresh value of its own.
        owner_scope := sema_call_default_owner_scope(binding.sources[index], parameter, args[index].expr, environment, program, scopes)
        default_in_owner: if owner_scope == {
            .Val(_) -> true
            .None -> false
        }
        // A taken argument out of pinned storage is the move E0219, reported
        // before checking the argument reads it beside the pin (E0220). A
        // take parameter takes its plain name.
        if !default_in_owner && (args[index].convention == AccessConvention.Move || decision == SemaCallConventionDecision.NeedsImplicitClone) && !sema_pin_check_move(state, args[index].expr, scopes, diagnostics) {
            complete = false
            next
        }
        binder_keys := if binder_refs.len() > 0 && !default_in_owner -> sema_call_enter_binder_refs(binder_refs, args[index].flags.binder_site ?? span.start, environment, program, scopes, state, args[index].expr) else -> [String]{}
        // Rust `arg_expect`: a self-typed numeric read widens into the
        // parameter after it is checked on its own.
        self_typed: sema_stmt_numeric_slot_self_typed(args[index].expr, required, scopes)
        trait_parameter: if required == {
            .TraitObject(_) -> true
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        // A borrowed trait parameter lends the original concrete storage.
        // Expected-type coercion would instead construct an owned TraitBox.
        borrowed_trait: trait_parameter && parameter.convention != AccessConvention.Move
        // A unit parameter checks its argument on its own, so another unit of
        // its family can convert into it below.
        unit_parameter: sema_expr_unit_fact(required, environment, program) != None
        // A variadic bounded by a compiler-owned trait has the trait's name as
        // its type; like a trait parameter's, its argument is checked on its
        // own and then against the bound (E1313 below).
        owned_bound_variadic: parameter.variadic && sema_call_owned_trait_bound(required_declared) != None
        argument_expected := Type?{None}
        if !self_typed && !borrowed_trait && !unit_parameter && !owned_bound_variadic -> argument_expected = Val(required)
        // A C callback is a pure, monomorphic function or a capture-free
        // lambda whose body is safe on a foreign thread; anything else is
        // E3203, reported before the argument's own type check.
        if !default_in_owner && abi == .Val(callable_abi) {
            if sema_registration_callback_boundary_param(callable_abi, required_declared) {
                if sema_call_c_callback_unsafe(args[index].expr, environment, program, scopes) -> diagnostics.push(sema_checked_foreign_type_error(required_declared, expr_span(args[index].expr), true))
                if callable_abi.is_c_abi && c_callback == None -> c_callback = Val(expr_span(args[index].expr))
            }
        }
        diagnostic_start: diagnostics.len()
        lambda_escapes: if apply_lambda_escape_override -> sema_call_lambda_escape_policy(parameter, abi) else -> context.lambda_escapes
        checked_argument: if {
            default_in_owner -> sema_call_check_owner_default(owner_scope, args[index], argument_expected, parameter, abi, apply_lambda_escape_override, environment, program, tail_store, context, span, binder_keys, diagnostics)
            apply_lambda_escape_override -> sema_check_expression_with_lambda_escapes(args[index].expr, argument_expected, environment, program, scopes, state, tail_store, context, lambda_escapes, diagnostics)
            else -> sema_check_expression(args[index].expr, argument_expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        if binder_refs.len() > 0 {
            if !default_in_owner -> sema_scope_leave(scopes, state)
            if sema_call_binder_refs_read(binder_keys, binder_start, context) {
                pin_arguments = true
                binder_site = args[index].flags.binder_site ?? span.start
            }
        }
        checked_value: checked_argument ?? {
            if !default_in_owner && binder_refs.len() == 0 {
                if sema_call_parameter_type_undeclared(required, environment, program) -> sema_call_argument_drop_mismatch(args[index].expr, diagnostic_start, diagnostics) else -> sema_call_argument_replace_mismatch(callee, index, required, args[index].expr, lambda_escapes, diagnostic_start, environment, program, scopes, state, tail_store, context, diagnostics)
            }
            complete = false
            next
        }
        // A write parameter edits its argument's storage and a marked take
        // gives it away; a computed field has none, so it is never lent.
        if parameter.convention == AccessConvention.Write && sema_expression_refuse_computed_place(checked_value, "lent for writing", environment, program, scopes, diagnostics) {
            complete = false
            next
        }
        if args[index].convention == AccessConvention.Move && sema_expression_refuse_computed_place(checked_value, "taken", environment, program, scopes, diagnostics) {
            complete = false
            next
        }
        // E0205 (Rust `check_direct_call`): a write `SharedGuard` parameter
        // edits through the guard, so only a `guard_edit()` lease or the
        // caller's own write binding may enter it.
        if parameter.convention == AccessConvention.Write && sema_call_read_shared_guard_argument(state, required, checked_value.ty, args[index].expr, scopes) {
            diagnostics.push(sema_error("E0205", expr_span(args[index].expr), "a read `SharedGuard` cannot enter a write helper", "the helper can edit through this parameter, so its caller must hold an exclusive Shared guard", "create the guard with `guard_edit()` before passing it to the helper"))
            complete = false
            next
        }
        // A module place lent for writing is written by the callee (E3401 in
        // a pure caller); a `&` parameter does not record its own writes.
        if parameter.convention == AccessConvention.Write -> sema_scope_record_lent_write(args[index].expr, expr_span(args[index].expr), environment, scopes, context)
        // A bare name a take parameter receives is that parameter's take, as
        // `name.move()` was. A resource has one cleanup owner, so a take that
        // would copy it out of a place read in place (E0211) or out of a
        // borrowed parameter (E0201 naming `&&`) is refused for that, never
        // with a `.copy()` fix.
        taken_name: args[index].convention == AccessConvention.Move || decision == SemaCallConventionDecision.NeedsImplicitClone
        if parameter.convention == AccessConvention.Move && decision == SemaCallConventionDecision.NeedsImplicitClone && args[index].convention != AccessConvention.Move && (!sema_copy_site_refuse_resource_copy(checked_value, environment, program, scopes, context, diagnostics) || !sema_copy_site_refuse_borrowed_copy(args[index].expr, sema_ownership_callee_text(callee), environment, program, scopes, context, diagnostics)) -> return None
        if parameter.convention == AccessConvention.Move && !sema_copy_site_check_guard_owned(checked_value, environment, program, scopes, state, context, diagnostics, taken_name) -> return None
        // A self-typed read that does not fit reports the generic E0108 at
        // the value; like any other argument, that becomes the call's E0112.
        // Integer narrowing keeps its own E0108 (Rust check_type_assignable
        // reports it in place of the argument's E0112).
        slot_start: diagnostics.len()
        widened: if self_typed -> sema_stmt_numeric_slot_value(checked_value, required, environment, program, diagnostics) else -> Val(checked_value)
        value := widened ?? {
            if sema_integer_narrowing_fix(required, sema_call_resolved_type(checked_value.ty, environment, program)) == None -> sema_call_argument_replace_mismatch(callee, index, required, args[index].expr, lambda_escapes, slot_start, environment, program, scopes, state, tail_store, context, diagnostics)
            return None
        }
        compatible := if trait_parameter && parameter.convention == AccessConvention.Write -> type_identity_equal(required, sema_call_resolved_type(value.ty, environment, program)) else -> sema_call_type_assignable(required_declared, value.ty, environment, program) ?? return None
        // A parameter whose written type names nothing reported E0119 at its
        // declaration; it takes any argument, so the call's own checks (the
        // moves, E0201) still run without a cascade E0112 (#6294).
        if !compatible && sema_call_parameter_type_undeclared(required, environment, program) -> compatible = true
        if !compatible && sema_expr_unit_implicit_applies(required, value.ty, environment, program) {
            converted: sema_expr_unit_implicit_conversion(value, required, environment, program, scopes, context, diagnostics) ?? {
                complete = false
                next
            }
            value = converted
            compatible = true
        }
        if !compatible {
            if sema_expr_unit_coherent_value(value, required, environment, program) == .Val(coherent) {
                value = coherent
                compatible = true
            }
        }
        if !compatible {
            // (Rust `check_variadic_bound_tail`,
            // E1313): a trait-bounded variadic argument is checked against
            // each bound trait it fails to implement; one that implements
            // every bound is accepted. A builtin trait stays a named bound
            // after resolution.
            bounds := [String]{}
            if required == .TraitObject(list) {
                bounds = list
            } else if sema_call_owned_trait_bound(required_declared) == .Val(trait_name) {
                bounds = [String]{trait_name}
            }
            if parameter.variadic && !args[index].spread && bounds.len() > 0 {
                arg_name: type_name(value.ty)
                unmet := false
                loop bound in bounds {
                    if sema_call_variadic_bound_met(bound, value.ty, environment, program) == (Val(true)) -> next
                    diagnostics.push(sema_call_variadic_bound_unmet(arg_name, parameter.name, bound, callee, expr_span(args[index].expr)))
                    unmet = true
                }
                if unmet -> return None
            } else {
                diagnostics.push(sema_call_argument_mismatch(callee, index, required, sema_call_resolved_type(value.ty, environment, program), args[index].expr, expr_span(args[index].expr)))
                complete = false
                next
            }
        }
        // E3211: a written String literal with a NUL byte can never reach a
        // C-boundary `String` parameter intact, since C strings end at the
        // first NUL. The slot is the declaration slot the binder chose, so a
        // labelled call is checked against the parameter it actually reaches.
        if abi == .Val(callable_abi) {
            if callable_abi.is_c_abi && required == Type.String && sema_call_literal_has_nul(args[index].expr) {
                row: diagnostic_registry_row("E3211") ?? panic("E3211 must have a registry row")
                diagnostics.push(sema_error("E3211", expr_span(args[index].expr), row.what, row.why, row.fix))
            }
        }
        // The ownership check that follows moves an
        // eligible unmarked take argument at its last use.
        noted_take := false
        if !report_conventions && decision == SemaCallConventionDecision.NeedsImplicitClone && binder_refs.len() == 0 && !default_in_owner {
            if sema_ownership_note_implicit_take(state, args[index].expr, value.ty, required, environment, program, context.generic_params, scopes) == .Val(key) {
                take_indices.push(index)
                take_keys.push(key)
                noted_take = true
            }
        }
        // Any other unmarked name a take parameter
        // receives is that parameter's take, as `name.move()` was. It moves out of
        // its owner here, so a later use reports the move into this call.
        if !noted_take && decision == SemaCallConventionDecision.NeedsImplicitClone && binder_refs.len() == 0 && !default_in_owner && !parameter.variadic && !sema_ownership_type_is_copy(value.ty) && !sema_ownership_type_is_copy(required) && !sema_ownership_argument_is_function_item(args[index], scopes) {
            args[index].convention = AccessConvention.Move
            if !sema_pin_check_move(state, args[index].expr, scopes, diagnostics) {
                complete = false
                next
            }
        }
        // Rust `check_call_argument_access`: a name or field the call takes
        // (convention `Move`, an implicit take or a generated take) passed to
        // a consuming parameter is the exact-place move, so the argument
        // moves out of its owner (MovePlace, clearing its drop flag) instead
        // of reaching lowering as a bare read that only a last-use proof turns
        // into a move. A plain name noted as the call's implicit take moves the
        // same way: a call never copies on its own. A read
        // parameter or its field has no storage to give up: E0201, never a
        // silent copy. A write parameter's field keeps the refill move the
        // last-use pass proves.
        taken_convention: args[index].convention == AccessConvention.Move || noted_take
        consuming_mark: !default_in_owner && parameter.convention == AccessConvention.Move && !parameter.variadic && taken_convention && !sema_ownership_type_is_copy(value.ty)
        marked_place: consuming_mark && sema_call_marked_move_place(args[index].expr, value)
        // A bare `name.move()` of a read parameter is reported at the name by the
        // ownership check below, which names the consumer (Rust
        // `check_call_argument_access`); a field place reports at the mark.
        bare_name: args[index].expr == .Ident(_, _, _)
        if marked_place && !bare_name && sema_ownership_reject_read_param_move(state, args[index].expr, scopes, diagnostics) -> return None
        taken_place := marked_place
        if taken_place && sema_ownership_binding_for_expr(state, args[index].expr, scopes) == .Val(root) -> taken_place = !sema_ownership_binding_is_borrowed_param(root)
        if taken_place && args[index].expr == .Field(_, _, _, _) -> state.exact_field_takes.push(expr_span(args[index].expr))
        stored: sema_call_marked_move_value(state, taken_place, args[index].expr, value, scopes, diagnostics) ?? return None
        values.push(stored)
        slots.push(slot)
        required_types.push(required)
        source_indices.push(args[index].flags.source_index ?? -1)
    }
    if !complete -> return None
    sema_call_crypto_misuse(callee, params, args, values, slots, context, diagnostics)
    // E2104: no `jet` marshals a Jet function into a C callback pointer yet
    // (#6366), so a compile that lowers the call refuses it here instead of
    // stopping inside the IR. A checker error on the call stands alone, and
    // `jet check` (which lowers nothing) still reports only those.
    if c_callback == .Val(callback_span) && !environment.module_identity.starts_with("<corelib>/") && sema_refuses_unbuilt(program) && !sema_has_error_since(diagnostics, call_diagnostics_start) {
        diagnostics.push(sema_error("E2104", callback_span, "passing a Jet function to `{callee}` is not built yet", "This `jet` cannot yet hand a Jet function to C code as a callback pointer, and no other `jet` can build it.", "Remove the callback argument for now; C callbacks need their native trampoline first (card #6366)."))
    }
    reference_starts.push(context.name_references.len())
    // A name two take slots of one call receive has no last use in either.
    loop position in 0..<take_indices.len() {
        twice := sema_call_key_named_elsewhere(take_keys[position], take_indices[position], reference_starts, context)
        loop earlier in 0..<position {
            if take_keys[earlier] == take_keys[position] -> twice = true
        }
        if twice -> sema_ownership_note_implicit_take_twice(state, expr_span(args[take_indices[position]].expr))
    }
    Val(SemaCallTypedArguments{values: values, slots: slots, required_types: required_types, source_indices: source_indices, pin_arguments: pin_arguments, binder_site: binder_site})
}

// Whether an argument of type `ty` implements variadic bound `bound`: as a
// trait value of that bound, or by the bound check generic calls use; None
// while that check cannot decide.
sema_call_variadic_bound_met: fn(bound: String, ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool? {
    if sema_call_type_assignable(Type.TraitObject{bounds: [String]{bound}}, ty, environment, program) == (Val(true)) -> return Val(true)
    if program.registration_graph == .Val(graph) -> return sema_type_bound_satisfied_with_generics(graph, ty, bound, environment.module_identity, environment.generic_params)
    None
}

// E1313: an argument of a trait-bounded variadic `parameter` misses `bound`.
// `callee` may be an arity function, which reports as the function called.
sema_call_variadic_bound_unmet: fn(arg_name: String, parameter: String, bound: String, callee: String, span: Span) -> Diagnostic {
    shown: sema_error_conversion_leaf(bound)
    called: sema_variadic_bound_callee(callee)
    sema_error("E1313", span, "`{arg_name}` doesn't implement `{shown}`", "`{parameter}: ...{shown}` checks every argument against `{shown}` — that's how `{called}` accepts a mix of types safely", "implement `{shown}` for `{arg_name}`'s type, or drop the value from this call")
}

// The compiler-owned trait a parameter type names. Such a bound stays a
// named type after resolution, where a declared trait becomes a trait object.
sema_call_owned_trait_bound: fn(ty: Type) -> String? {
    if ty == .Named(name) && sema_type_builtin_trait_symbol(name) != None -> return Val(name.copy())
    None
}

// A fixed-shape Core route checks its own arguments. An unmarked bare name
// passed to one of its taking parameters still moves at its last use, as at
// an ordinary call; a name a later argument of the same call also references
// has no last use there. `values` are the checked arguments, in `args` order.
sema_call_note_route_implicit_takes: fn(params: [SemaCallParam], args: [CallArg], values: [TExpr], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, state: &SemaOwnershipState, context: SemaCheckContext) {
    loop index in 0..<args.len() {
        if index >= params.len() || index >= values.len() -> break
        if sema_call_argument_convention(params[index], args[index]) != SemaCallConventionDecision.NeedsImplicitClone -> next
        declared: params[index].ty ?? next
        required: sema_call_resolved_type(declared, environment, program)
        key: sema_ownership_note_implicit_take(state, args[index].expr, values[index].ty, required, environment, program, context.generic_params, scopes) ?? next
        twice := false
        loop reference in context.name_references {
            if reference.symbol.id.key != key -> next
            loop other in index + 1..<args.len() {
                other_span: expr_span(args[other].expr)
                if reference.span.start >= other_span.start && reference.span.end <= other_span.end -> twice = true
            }
        }
        if twice -> sema_ownership_note_implicit_take_twice(state, expr_span(args[index].expr))
    }
}

// A string literal with no interpolation whose written text holds a NUL byte.
sema_call_literal_has_nul: fn(value: Expr) -> Bool Never! {
    if value == .Str(parts, _, _) {
        nul: String.from_bytes([U8{0}]) ?? panic("NUL is UTF-8")
        found := false
        loop part in parts {
            if part == {
                .Lit(text) -> {
                    if text.contains(nul) -> found = true
                }
                .Interp(_, _) | .Byte(_) -> return false
            }
        }
        return found
    }
    false
}

// One registered E2702 bound: a parameter of a Core
// crypto operation and the values the operation accepts there
// (Core/Crypto/Crypto.jet, Expert.jet return CryptoError outside it).
// `bytes`: the bound is on a byte list's length, not on an Int.
SemaCryptoBound: struct {
    parameter: String
    reason: DiagnosticCryptoMisuseReason
    noun: String
    bytes: Bool
    low: Int
    high: Int?
}

sema_crypto_int: fn(parameter: String, reason: DiagnosticCryptoMisuseReason, noun: String, low: Int, high: Int?) -> SemaCryptoBound Never! {
    SemaCryptoBound{parameter: parameter, reason: reason, noun: noun, bytes: false, low: low, high: high}
}

sema_crypto_bytes: fn(parameter: String, reason: DiagnosticCryptoMisuseReason, noun: String, low: Int, high: Int) -> SemaCryptoBound Never! {
    SemaCryptoBound{parameter: parameter, reason: reason, noun: noun, bytes: true, low: low, high: Val(high)}
}

sema_crypto_bounds: fn(callee: String) -> [SemaCryptoBound] Never! {
    output: DiagnosticCryptoMisuseReason.OutputLength
    material: DiagnosticCryptoMisuseReason.InvalidLength
    nonce: DiagnosticCryptoMisuseReason.NonceLength
    if callee == {
        "core.crypto.hkdf_sha256" | "core.crypto.expert.hkdf_sha256_raw" -> [SemaCryptoBound]{sema_crypto_int("len", output, "output length", 0, Val(8160))}
        "core.crypto.pbkdf2_hmac" -> [SemaCryptoBound]{
            sema_crypto_int("iterations", DiagnosticCryptoMisuseReason.IterationCount, "iteration count", 1, None),
            sema_crypto_int("key_len", output, "key length", 1, Val(67108864)),
        }
        "core.crypto.expert.argon2id" -> [SemaCryptoBound]{
            sema_crypto_bytes("salt", DiagnosticCryptoMisuseReason.SaltLength, "salt", 8, 64),
            sema_crypto_int("memory_kib", DiagnosticCryptoMisuseReason.MemoryCost, "memory cost in KiB", 8192, Val(262144)),
            sema_crypto_int("iterations", DiagnosticCryptoMisuseReason.IterationCount, "iteration count", 1, Val(10)),
            sema_crypto_int("lanes", DiagnosticCryptoMisuseReason.LaneCount, "lane count", 1, Val(8)),
            sema_crypto_int("output_len", output, "output length", 16, Val(64)),
        }
        "core.crypto.expert.xchacha20poly1305_seal" | "core.crypto.expert.xchacha20poly1305_open" -> [SemaCryptoBound]{
            sema_crypto_bytes("key", material, "key", 32, 32),
            sema_crypto_bytes("nonce", nonce, "nonce", 24, 24),
        }
        "core.crypto.expert.aes256gcm_seal" | "core.crypto.expert.aes256gcm_open" -> [SemaCryptoBound]{
            sema_crypto_bytes("key", material, "key", 32, 32),
            sema_crypto_bytes("nonce", nonce, "nonce", 12, 12),
        }
        "core.crypto.expert.ed25519_sign" -> [SemaCryptoBound]{sema_crypto_bytes("secret", material, "secret key", 32, 32)}
        "core.crypto.expert.ed25519_verify_strict" -> [SemaCryptoBound]{
            sema_crypto_bytes("public", material, "public key", 32, 32),
            sema_crypto_bytes("signature", material, "signature", 64, 64),
        }
        "core.crypto.expert.x25519_raw" -> [SemaCryptoBound]{
            sema_crypto_bytes("secret_bytes", material, "secret key", 32, 32),
            sema_crypto_bytes("public_bytes", material, "public key", 32, 32),
        }
        else -> [SemaCryptoBound]{}
    }
}

// The compiler-known length of a byte-list argument: a written list literal
// without spreads, or a value of a fixed-length list type.
sema_crypto_known_length: fn(value: Expr, ty: Type) -> Int? Never! {
    if value == .ListLit(elements, _, _) {
        loop element in elements {
            if element == .Spread(_, _, _) -> return None
        }
        return Val(elements.len())
    }
    if ty == .FixedList(_, length) {
        if length == .Literal(_, count) -> return Val(count)
    }
    None
}

sema_crypto_misuse: fn(operation: String, bound: SemaCryptoBound, expected: String, actual: Int, span: Span) -> Diagnostic Never! {
    unit: if !bound.bytes -> "" else if actual == 1 -> " byte" else -> " bytes"
    over: if bound.bytes -> " bytes" else -> ""
    article: if bound.noun.starts_with("i") || bound.noun.starts_with("o") -> "an" else -> "a"
    diagnostic := sema_error("E2702", span, "Crypto API misuse", "the {bound.noun} is {actual}{unit}, and `{operation}` takes {expected}{over}, so the call can only fail", "Replace the offending cryptographic argument with the concrete value or bound named in the diagnostic: pass {article} {bound.noun} of {expected}{over}")
    diagnostic.structured = Val(DiagnosticStructured.CryptoMisuse{reason: bound.reason, operation: operation, expected: Val(expected), actual: Val(actual)})
    diagnostic
}

// E2702: a call whose compiler-known argument is outside the bound its Core
// crypto operation documents (sema_crypto_bounds) can only fail. It reads the
// checked call, so an argument's own type error comes first, and a raw
// `core.crypto.expert` call outside `#Unsafe` is its E0510 alone. A value only
// known at run time is the operation's to check. The call stays checked, so
// the effect solve still reads its arguments; its implicit propagation is not
// reported again (sema_crypto_misused_call), and an error of any earlier
// check drops every E2702 (sema_crypto_misuse_precedence).
sema_call_crypto_misuse: fn(callee: String, params: [SemaCallParam], args: [CallArg], values: [TExpr], slots: [Int], context: SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    if !callee.starts_with("core.crypto.") -> return
    bounds: sema_crypto_bounds(callee)
    if bounds.len() == 0 -> return
    if callee.starts_with("core.crypto.expert.") && context.unsafe_depth == 0 -> return
    parts: callee.split(".").to_list()
    operation: parts[parts.len() - 1].copy()
    memory := Int?{None}
    iterations := Int?{None}
    memory_span := Span?{None}
    refused := false
    loop bound in bounds {
        index: sema_crypto_argument_index(params, slots, bound.parameter) ?? next
        known: if bound.bytes -> sema_crypto_known_length(args[index].expr, values[index].ty) else -> sema_call_compute_literal_int(args[index].expr)
        actual: known ?? next
        if bound.parameter == "memory_kib" {
            memory = Val(actual)
            memory_span = Val(expr_span(args[index].expr))
        }
        if bound.parameter == "iterations" -> iterations = Val(actual)
        expected := "at least {bound.low}"
        if bound.high == .Val(high) {
            if actual >= bound.low && actual <= high -> next
            expected = if bound.low == high -> "exactly {high}" else -> "{bound.low}..{high}"
        } else if actual >= bound.low {
            next
        }
        diagnostics.push(sema_crypto_misuse(operation, bound, expected, actual, expr_span(args[index].expr)))
        refused = true
    }
    if refused || callee != "core.crypto.expert.argon2id" -> return
    // Argon2id's joint work bound (spec.md, the expert surface): memory cost
    // × iterations of at most 1048576, each within its own bound above.
    if memory == .Val(kib) && iterations == .Val(passes) && memory_span == .Val(at) && kib * passes > 1048576 {
        work: sema_crypto_int("memory_kib", DiagnosticCryptoMisuseReason.MemoryTimeCost, "memory cost × iterations", 0, Val(1048576))
        diagnostics.push(sema_crypto_misuse(operation, work, "at most 1048576", kib * passes, at))
    }
}

// Whether the call `source` already has its E2702 among `diagnostics`.
sema_crypto_misused_call: fn(source: Expr?, diagnostics: [Diagnostic]) -> Bool Never! {
    call: source ?? return false
    span: expr_span(call)
    loop diagnostic in diagnostics {
        if diagnostic.code != "E2702" -> next
        if diagnostic.span == .Val(at) {
            if at.start >= span.start && at.end <= span.end -> return true
        }
    }
    false
}

// Precedence: E2702 is considered only once syntax, types,
// effects and every other check pass, so any other error drops each E2702.
sema_crypto_misuse_precedence: fn(diagnostics: &[Diagnostic]) Never! {
    misused := false
    other := false
    loop diagnostic in diagnostics {
        if diagnostic.code == "E2702" -> misused = true
        else if diagnostic.severity == DIAGNOSTIC_ERROR -> other = true
    }
    if !misused || !other -> return
    kept := [Diagnostic]{}
    loop diagnostic in diagnostics {
        if diagnostic.code != "E2702" -> kept.push(diagnostic.copy())
    }
    diagnostics = kept
}

sema_crypto_argument_index: fn(params: [SemaCallParam], slots: [Int], parameter: String) -> Int? Never! {
    loop index in 0..<slots.len() {
        if params[slots[index]].name == parameter -> return Val(index)
    }
    None
}

// (Rust `check_call_args`): an argument that does not fit its parameter is
// E0112 about the call, after a checked typed-text rejection.
sema_call_argument_mismatch: fn(callee: String, index: Int, required: Type, offered: Type, value: Expr, span: Span) -> Diagnostic {
    // ("core.mem", "volatile_read" | "volatile_write"): the pointer argument is
    // not a typed pointer, or the written value is not the pointer's element
    // type.
    if callee == "core.mem.volatile_read" || callee == "core.mem.volatile_write" {
        operation: sema_call_reflection_leaf_name(callee)
        if index == 0 {
            why: if operation == "volatile_read" -> "a volatile read reads through a typed pointer" else -> "a volatile write writes through a typed pointer"
            return sema_error("E0112", span, "`{operation}` needs a `Ptr<T>`, not {sema_type_show(offered)}", why, "build a pointer first with `mem.Ptr<T>.from_addr(addr)`")
        }
        return sema_error("E0112", span, "`{operation}` writes a {sema_type_show(required)} through this pointer, but the value is {sema_type_show(offered)}", "a volatile write stores a value of the pointer's element type", "write a `{type_name(required)}` value")
    }
    if sema_nested_fn_failure_mismatch(required, offered, span) == .Val(nested_fn) -> return nested_fn
    if sema_typed_text_mismatch(required, offered, span) == .Val(typed_text) -> return typed_text
    if sema_plain_carrier_mismatch(required, offered, span) == .Val(carrier) -> return carrier
    // A value of a type that does not implement the one trait a trait-value
    // parameter names is the missing implementation, not a type mismatch.
    if required == .TraitObject(bounds) {
        if bounds.len() == 1 && !(offered == .TraitObject(_)) {
            bound := bounds[0]
            if bound.cut_last("::") == .Val(parts) -> bound = parts.after
            name: type_name(offered)
            row: diagnostic_registry_row("E0905") ?? panic("E0905 must have a registry row")
            return sema_error("E0905", span, row.what.replace("{{type}}", name).replace("{{bound}}", bound), row.why.replace("{{why_text}}", "`{name}` would need to implement `{bound}` before it can be used here"), row.fix.replace("{{fix_text}}", "write `impl {name}.{bound} {{ … }}` with every required method"))
        }
    }
    sema_error("E0112", span, "`{sema_call_reflection_leaf_name(callee)}` wants {sema_type_show(required)} for argument {index + 1}, but this is {sema_type_show(offered)}", "every argument must match its parameter's type", sema_call_argument_fix_hint(required, offered, value))
}

// A Decimal argument to a Float parameter is taught on the argument as
// written: its literal as a Float, or its binding converted.
sema_call_argument_fix_hint: fn(required: Type, offered: Type, value: Expr) -> String Never! {
    if required == Type.Float && sema_type_nominal_leaf(offered) == "Decimal" {
        if value == {
            .Float(_, _, _, raw, _) -> if raw == .Val(text) -> return "write the literal as Float{{{text}}}, or keep Decimal on both sides"
            .Ident(name, _, _) -> return "convert it with `{name}.to_float()`, or keep Decimal on both sides"
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
        }
    }
    sema_type_fix_hint(required, offered)
}

// A parameter type that names nothing already has its E0119 where the
// declaration wrote it; an argument's mismatch against it is that same error
// again (#6294).
sema_call_parameter_type_undeclared: fn(required: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    generic_names: loop param in environment.generic_params -> param.name
    if program.registration_graph == .Val(graph) -> return sema_type_names_undeclared(graph, sema_scope_caller_row(environment, graph), required, generic_names)
    if environment.registration_graph == .Val(graph) -> return sema_type_names_undeclared(graph, sema_scope_caller_row(environment, graph), required, generic_names)
    false
}

// Drops the generic E0108 the argument's own check reported against an
// undeclared parameter type, keeping every other report of the argument.
sema_call_argument_drop_mismatch: fn(value: Expr, diagnostic_start: Int, diagnostics: &[Diagnostic]) {
    mismatch_index: sema_value_mismatch_index(diagnostics, diagnostic_start, expr_span(value)) ?? return
    loop index in mismatch_index..<diagnostics.len() - 1 -> diagnostics[index] = diagnostics[index + 1]
    _: diagnostics.pop()
}

// The argument's own check rejected it against its parameter with the generic
// E0108 at the value (for an expression-bodied lambda, at its body); that
// report becomes the call's E0112, with the value's own type inferred without
// the parameter as a target. A lambda value is probed under the parameter's
// escape policy, so its capture facts match.
sema_call_argument_replace_mismatch: fn(callee: String, index: Int, required: Type, value: Expr, lambda_escapes: Bool?, diagnostic_start: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) {
    value_span: expr_span(value)
    found := sema_value_mismatch_index(diagnostics, diagnostic_start, value_span)
    if found == None && value == .Lambda(body_lambda, _) && body_lambda.body == .Expr(body) -> found = sema_value_mismatch_index(diagnostics, diagnostic_start, expr_span(body))
    mismatch_index: found ?? return
    probe_diagnostics := [Diagnostic]{}
    previous_lambda_escapes := context.lambda_escapes
    context.lambda_escapes = lambda_escapes
    probed: sema_probe_expression(value, None, environment, program, scopes, state, tail_store, context, probe_diagnostics)
    context.lambda_escapes = previous_lambda_escapes
    offered: probed ?? return
    offered_ty := sema_call_resolved_type(offered.ty, environment, program)
    // A lambda checked against a callable keeps its plain return (Rust
    // `infer_lambda`); the probe above had no target and gave it the total
    // `Never!` carrier, which the argument never had.
    if value == .Lambda(_, _) && offered_ty == .Fn(lambda_params, lambda_ret, lambda_effects, lambda_contract, lambda_metadata, lambda_views) && lambda_ret == .Val(.Result(plain_ret, .Named(never_name))) && never_name == "Never" {
        offered_ty = Type.Fn{params: lambda_params, ret: Val(plain_ret), effect_bound: lambda_effects, param_contract: lambda_contract, call_metadata: lambda_metadata, return_view_provenance: lambda_views}
    }
    // The call still checks a lambda argument's captures against its other
    // arguments (Rust `check_call`); the probe's checked lambda supplies them.
    if value == .Lambda(probed_ast, _) && offered.kind == .Lambda(probed_lambda) -> sema_ownership_note_lambda_facts(state, probed_ast.span, probed_lambda.capture_facts)
    // Rust's lambda span ends where its expression body's span ends (a
    // call's span is its name).
    shown_span := value_span
    if value == .Lambda(shown_lambda, _) && shown_lambda.body == .Expr(shown_body) -> shown_span = Span{start: value_span.start, end: expr_span(shown_body).end}
    diagnostics[mismatch_index] = sema_call_argument_mismatch(callee, index, required, offered_ty, value, shown_span)
}

// Whether an argument after `own` references the binding `key`: arguments
// run in order, so an earlier one has read the name before the take.
// `starts` holds each argument's first name reference and the end.
sema_call_key_named_elsewhere: fn(key: String, own: Int, starts: [Int], context: SemaCheckContext) -> Bool Never! {
    loop other in own + 1..<starts.len() - 1 {
        loop index in starts[other]..<starts[other + 1] {
            if index < context.name_references.len() && context.name_references[index].symbol.id.key == key -> return true
        }
    }
    false
}

sema_call_binder_ref_symbol: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, owner: String, site: Int, slot: Int, name: String, ty: Type, span: Span) -> Symbol Never! {
    id: symbol_id(SymbolKind.Local, environment.module_identity, owner, "binder_ref_{site}_{slot}")
    Symbol{id: id, kind: SymbolKind.Local, name: name, module_name: environment.module_identity, owner: Val(owner), span: span, ty: Val(ty), visibility: 0}
}

// Opens the default's own frame with each earlier parameter bound to its slot
// temporary; the caller leaves it after checking the default. A placeholder
// enters ownership only when the default reads it, so an unread one is no
// unused binding. Each placeholder is declared at the default's first source
// byte, so every read in it follows the declaration: a method chain or index
// (`values.len()`, `values[0]`) is spanned after its base (jfmt_expr_start).
sema_call_enter_binder_refs: fn(refs: [BinderRef], site: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, default_expr: Expr) -> [String] Never! {
    span: Span{start: jfmt_expr_start(default_expr), end: expr_span(default_expr).end}
    owner: sema_scope_function_owner_key(scopes)
    _ := sema_scope_enter(scopes, state, owner)
    keys := [String]{}
    loop reference in refs {
        symbol: sema_call_binder_ref_symbol(environment, program, owner, site, reference.slot, reference.name, reference.ty, span)
        _ := sema_scope_declare_local(scopes, symbol, false, AccessConvention.Read, None, false)
        keys.push(symbol.id.key)
    }
    keys
}

sema_call_binder_refs_read: fn(keys: [String], start: Int, context: SemaCheckContext) -> Bool Never! {
    loop index in start..<context.name_references.len() {
        if keys.contains(context.name_references[index].symbol.id.key) -> return true
    }
    false
}

// The declaring module's scope for a default argument this call takes, when
// the default is written in another module (sema_default_owner_scope).
sema_call_default_owner_scope: fn(source: SemaCallArgSource, parameter: SemaCallParam, expression: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> SemaDefaultOwnerScope? {
    if source == {
        .Default(_) -> {}
        .Written(_) -> return None
    }
    reference: parameter.default_ref ?? return None
    owner_module: sema_call_default_ref_module(program, reference) ?? return None
    sema_default_owner_scope(environment, program, scopes, owner_module, expression)
}

// The module that declares the callable a default belongs to.
sema_call_default_ref_module: fn(program: SemaProgramTables, reference: FunctionDefaultRef) -> String? {
    if program.registration_graph == .Val(graph) {
        row: sema_registration_callable_row(graph, reference.owner_key) ?? return None
        module_index: if row == {
            .Function(index, _) | .Foreign(index, _) -> index
            .NominalMethod(index, _, _) | .ImplMethod(index, _, _) -> index
        }
        return Val(graph.modules[module_index].module_identity)
    }
    None
}

// A default argument written in another module, checked in that module's
// names. Its binder slots key under the calling function and module, as
// sema_call_pin_binder_arguments reads them; a problem it reports is anchored
// at the call.
sema_call_check_owner_default: fn(owner_scope: &&SemaDefaultOwnerScope?, argument: CallArg, expected: Type?, parameter: SemaCallParam, abi: SemaRegistrationCallableABI?, apply_lambda_escape_override: Bool, environment: SemaScopeEnvironment, program: SemaProgramTables, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, call_span: Span, binder_keys: &[String], diagnostics: &[Diagnostic]) -> TExpr? {
    scope := owner_scope.move() ?? return None
    if argument.flags.binder_refs.len() > 0 -> binder_keys = sema_call_enter_binder_refs(argument.flags.binder_refs, argument.flags.binder_site ?? call_span.start, environment, program, scope.scopes, scope.state, argument.expr)
    default_diagnostics := [Diagnostic]{}
    checked: if apply_lambda_escape_override -> sema_check_expression_with_lambda_escapes(argument.expr, expected, scope.environment, program, scope.scopes, scope.state, tail_store, context, sema_call_lambda_escape_policy(parameter, abi), default_diagnostics) else -> sema_check_expression(argument.expr, expected, scope.environment, program, scope.scopes, scope.state, tail_store, context, default_diagnostics)
    loop diagnostic in default_diagnostics -> diagnostics.push(sema_default_use_site_diagnostic(diagnostic, call_span))
    checked
}

// Declaration-order grouping must not reorder written expressions. Pin raw
// supplied arguments in written order, then defaults in declaration order,
// so binder references read the already-passed values. Methods and Fn calls
// pin their receiver/callee first; this helper owns only argument pins.
// Borrowed places are pinned as borrows, fresh values retain an owned pin.
sema_call_pin_binder_arguments: fn(typed: SemaCallTypedArguments, params: [SemaCallParam], lowered: &[TCallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, span: Span) -> [TStmt] Never! {
    bindings := [TStmt]{}
    if !typed.pin_arguments -> return bindings
    owner: sema_scope_function_owner_key(scopes)
    order := [Int]{}
    loop written in 0..<typed.source_indices.len() {
        loop index in 0..<typed.source_indices.len() {
            if typed.source_indices[index] == written -> order.push(index)
        }
    }
    loop index in 0..<typed.source_indices.len() {
        if typed.source_indices[index] < 0 -> order.push(index)
    }
    loop index in order {
        slot: typed.slots[index]
        // Each written rest argument must be evaluated before grouping the
        // tail. Its private pin cannot shadow a declaration-slot default.
        pin_slot := slot
        if params[slot].variadic -> pin_slot = -index - 1
        // copy: the argument's checked value becomes the binder pin's init, and
        // lowered[index].value is overwritten with the pin local below. Jet has no exchange on an
        // element of the write-borrowed `lowered`.
        original: lowered[index].value.copy()
        init := original
        place_value: if init.kind == {
            .Local(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Deref(_) | .Borrow(_, _) -> true
            .IntLit(_, _) | .StrLit(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .RawAddressOf(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> false
        }
        borrowed: (lowered[index].borrow || lowered[index].mut_borrow) && place_value
        if borrowed {
            access: if lowered[index].mut_borrow -> AccessConvention.Write else -> AccessConvention.Read
            init = sema_tree_node(original.ty, TExprKind.Borrow{place: init, access: access}, original.span)
        }
        symbol: sema_call_binder_ref_symbol(environment, program, owner, typed.binder_site, pin_slot, params[slot].name, original.ty, span)
        local := checked_symbol_local("binder_ref_{typed.binder_site}_{pin_slot}", span, symbol.id, original.ty)
        local.generated = true
        local.mutable = lowered[index].mut_borrow
        local.deref = borrowed
        local_value: sema_tree_node(original.ty, TExprKind.Local{local: local}, original.span)
        moves_pin: params[slot].convention == AccessConvention.Move || (params[slot].variadic && !lowered[index].spread)
        lowered[index].value = if moves_pin -> sema_tree_node(original.ty, TExprKind.Move{value: local_value}, original.span) else -> local_value
        bindings.push(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: init, gc_promotion: None, gc_transferred: false, span: span})
    }
    bindings
}

// Places the binder pins before the call they feed.
sema_call_with_binder_pins: fn(pins: &&[TStmt], call_value: &&TExpr, span: Span) -> TExpr Never! {
    if pins.len() == 0 -> return call_value
    // copy: `call_value` moves into the block body on the next line, while the block node needs the
    // call's type as its own.
    ty: call_value.ty.copy()
    body := pins
    body.push(TStmt.ExprStmt{value: call_value, span: span})
    sema_tree_node(ty, TExprKind.InlineBlock{body: body}, span)
}

// The place a taken call argument moves exactly: a field read, or a
// whole non-Copy local named by itself (a Copy value simply copies).
sema_call_marked_move_place: fn(expr: Expr, value: TExpr) -> Bool Never! {
    if expr == {
        .Field(_, _, _, _) -> true
        .Ident(_, _, _) -> value.kind == .Local(_) && !sema_ownership_type_is_copy(value.ty)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// The stored value of a consuming argument: a taken exact place
// (`taken`) is a checked move, and the move of a match payload binding takes
// the payload out of its subject (sema_ownership_move_pattern_payload).
// None when the move is rejected.
sema_call_marked_move_value: fn(state: &SemaOwnershipState, taken: Bool, expr: Expr, value: &&TExpr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> TExpr? {
    if !taken -> return Val(value.move())
    start: sema_ownership_place_root_start(expr) ?? expr_span(expr).start
    payload: sema_ownership_move_pattern_payload(state, expr, Span{start: start, end: expr_span(expr).end}, scopes, diagnostics)
    if payload < 0 -> return None
    moved: if payload > 0 -> sema_expression_payload_take(value) else -> value.move()
    Val(sema_tree_node(moved.ty, TExprKind.Move{value: moved}, moved.span))
}

sema_call_widen_union: fn(required: Type, offered: Type) -> Type? {
    if required == .Union(members) {
        loop member in members {
            if type_identity_equal(member, offered) -> return Val(required)
        }
    }
    None
}

sema_call_lower_bound_arguments: fn(typed: SemaCallTypedArguments, params: [SemaCallParam], args: &[CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables) -> [TCallArg] Never! {
    lowered := [TCallArg]{}
    loop index in 0..<typed.values.len() {
        value: typed.values[index]
        arg: args[index]
        param: params[typed.slots[index]]
        required: if index < typed.required_types.len() -> typed.required_types[index] else -> sema_call_resolved_type(sema_call_argument_parameter_type(param, arg) ?? value.ty, environment, program)
        widen_to_vec: if required == {
            .List(_) -> if value.ty == {
                .FixedList(_, _) -> true
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
            }
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        widen_to_union: sema_call_widen_union(required, value.ty)
        lowered.push(TCallArg{
            value: value,
            template_items: [SymbolID]{},
            borrow: param.convention == AccessConvention.Read && !sema_call_is_scalar(value.ty),
            mut_borrow: param.convention == AccessConvention.Write,
            fn_coerce: None,
            widen_to_vec: widen_to_vec,
            widen_to_union: widen_to_union,
            box_as_trait: sema_call_box_as_trait(required, value.ty, environment, program),
            label: arg.label.map(fn(label) { label.name }),
            spread: arg.spread,
        })
    }
    lowered
}

// Normalize the checked rest slot once, before publishing the checked tree. BuildList
// owns scalar elements; ListSpread clones spread elements through the same
// checked Clone/effect mechanism as a written list literal.
sema_call_prepare_variadic_elements: fn(typed: SemaCallTypedArguments, params: [SemaCallParam], args: [CallArg], lowered: &[TCallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    loop index in 0..<lowered.len() {
        slot: typed.slots[index]
        if !params[slot].variadic -> next
        // copy: the variadic element value is rewrapped and written back into lowered[index] below.
        // Jet has no exchange on an element of the write-borrowed `lowered`.
        value := lowered[index].value.copy()
        if lowered[index].widen_to_vec {
            // The boundary copy itself clones the fixed list's elements.
            // Do not first clone the array and then clone that copy again.
            if !sema_expression_list_check_clone(value.ty, value.span, environment, program, context, diagnostics) -> return false
            if args[index].convention == AccessConvention.Move -> value = sema_tree_node(value.ty, TExprKind.Move{value: value}, value.span)
            value = sema_tree_node(typed.required_types[index], TExprKind.MaterializeView{value: value}, value.span)
        } else if args[index].convention == AccessConvention.Move {
            value = sema_tree_node(value.ty, TExprKind.Move{value: value}, value.span)
        } else if lowered[index].spread {
            // A lone spread is a direct List borrow; mixed spread cloning is
            // judged below on the canonical ListSpread, not on its List root.
            next
        } else if sema_ownership_binding_is_expiring_secret_loan(state, args[index].expr, scopes) {
            // A rest slot owns its elements, so collecting an ExpiringSecret
            // loan moves it, which its callback refuses; nothing moves and
            // the call still checks.
            if args[index].expr == .Ident(name, name_span, _) -> diagnostics.push(sema_ownership_diag_expiring_secret_loan_change(name, "be moved", name_span))
        } else if !sema_ownership_type_is_copy(value.ty) {
            places: sema_ownership_places_from_expr_in_state(args[index].expr, scopes, state)
            borrowed := false
            loop place in places {
                loop binding in scopes.bindings {
                    if binding.symbol.id.key == place.root_key && sema_ownership_binding_is_borrowed_param(binding) -> borrowed = true
                }
            }
            copies_place: places.len() > 0 && (borrowed || !sema_ownership_unmarked_moves_name(args[index].expr) || sema_ownership_is_share_site(state, args[index].span))
            if copies_place {
                if !sema_expression_list_check_clone(value.ty, value.span, environment, program, context, diagnostics) -> return false
                value = sema_tree_node(value.ty, TExprKind.Clone{value: value, fact: CopyFact.Materialize}, value.span)
            } else {
                if !sema_ownership_mark_unmarked_move(state, args[index].expr, scopes, "the variadic list", diagnostics) -> return false
                value = sema_tree_node(value.ty, TExprKind.Move{value: value}, value.span)
            }
        }
        lowered[index].value = value.move()
        lowered[index].borrow = false
        lowered[index].mut_borrow = false
        lowered[index].widen_to_vec = false
    }
    true
}

sema_call_pack_variadic_arguments: fn(typed: SemaCallTypedArguments, params: [SemaCallParam], lowered: [TCallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> [TCallArg]? {
    packed := [TCallArg]{}
    loop slot in 0..<params.len() {
        if !params[slot].variadic {
            loop index in 0..<lowered.len() {
                if typed.slots[index] == slot -> packed.push(lowered[index])
            }
            next
        }
        list_ty: sema_call_resolved_type(params[slot].ty ?? panic("checked variadic parameter has no type"), environment, program)
        element: if list_ty == {
            .List(inner) -> inner
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> panic("checked variadic parameter is not a List")
        }
        tail := [TCallArg]{}
        loop index in 0..<lowered.len() {
            if typed.slots[index] == slot -> tail.push(lowered[index])
        }
        if tail.len() == 1 && tail[0].spread {
            argument := tail[0]
            argument.spread = false
            packed.push(argument)
            next
        }
        has_spread: loop argument in tail { if argument.spread -> break true } ?? false
        kind := TExprKind.List{values: [TExpr]{}, trait_coercion: None}
        if has_spread {
            if !sema_expression_list_check_clone(element, span, environment, program, context, diagnostics) -> return None
            parts := [TListSpreadPart]{}
            loop argument in tail {
                if argument.spread -> parts.push(TListSpreadPart.Spread{value: argument.value})
                else -> parts.push(TListSpreadPart.Element{value: argument.value})
            }
            kind = TExprKind.ListSpread{parts: parts.move()}
        } else {
            values := [TExpr]{}
            loop argument in tail -> values.push(argument.value)
            kind = TExprKind.List{values: values.move(), trait_coercion: None}
        }
        value: sema_tree_node(list_ty, kind.move(), span)
        packed.push(TCallArg{
            value: value.move(), template_items: [SymbolID]{},
            borrow: params[slot].convention == AccessConvention.Read,
            mut_borrow: params[slot].convention == AccessConvention.Write,
            fn_coerce: None,
            widen_to_vec: false, widen_to_union: None, box_as_trait: None,
            label: Val(params[slot].label), spread: false,
        })
    }
    Val(packed.move())
}

// This path runs Ownership after expression typing and before lowering, so
// lowering happens only after the ownership check accepts and completes.
// Return the lowered arguments together with the declaration-slot
// temporaries placed before the call.
sema_call_check_bound_arguments_owned: fn(state: &SemaOwnershipState, callee: String, params: [SemaCallParam], abi: SemaRegistrationCallableABI?, apply_lambda_escape_override: Bool, binding: SemaCallBinding, args: &[CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> (lowered: [TCallArg], pins: [TStmt])? {
    typing_start: diagnostics.len()
    typed: sema_call_typecheck_bound_arguments(callee, params, abi, apply_lambda_escape_override, binding, args, environment, program, scopes, state, tail_store, context, span, diagnostics, false) ?? {
        // Rust `check_call` reports a mismatched argument type and still
        // checks the call's argument accesses (a lambda argument's captures
        // against the other arguments). It inferred the arguments in order,
        // each one's access conflicts before its own mismatch.
        if sema_call_only_argument_mismatches(diagnostics, typing_start) {
            mismatches: loop index in typing_start..<diagnostics.len() -> diagnostics[index]
            loop diagnostics.len() > typing_start -> _ := diagnostics.pop()
            accesses := [Diagnostic]{}
            _ := sema_ownership_check_call_arguments(state, callee, params, args, scopes, accesses)
            loop position in 0..args.len() {
                loop access in accesses {
                    if sema_call_diagnostic_argument(access, args) == position -> diagnostics.push(access)
                }
                loop mismatch in mismatches {
                    if sema_call_diagnostic_argument(mismatch, args) == position -> diagnostics.push(mismatch)
                }
            }
        }
        return None
    }
    ownership: sema_ownership_check_call_arguments(state, callee, params, args, scopes, diagnostics)
    if !ownership.accepted || !ownership.complete -> return None
    lowered := sema_call_lower_bound_arguments(typed, params, args, environment, program)
    if !sema_call_prepare_variadic_elements(typed, params, args, lowered, environment, program, scopes, state, context, diagnostics) -> return None
    pins := sema_call_pin_binder_arguments(typed, params, lowered, environment, program, scopes, span)
    packed := sema_call_pack_variadic_arguments(typed, params, lowered, environment, program, context, span, diagnostics) ?? return None
    sema_call_compiler_handoffs(callee, packed, environment, program, scopes, span)
    Val((lowered: packed.move(), pins: pins.move()))
}

// A `Compiler` value passed to a function delegates the root's control, and
// the build's provenance records every handoff. The
// argument becomes the value's handoff from this call's place to `callee`,
// a new value of the same build whose chain ends with this pass, so what the
// callee makes names each function the value went through.
sema_call_compiler_handoffs: fn(callee: String, args: &[TCallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, span: Span) Never! {
    loop index in 0..<args.len() {
        if args[index].value.ty != (Type.Named{name: "Compiler"}) -> next
        location: sema_expression_panic_location(environment, program, scopes, span)
        step: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "`{location.function}` handed it to `{callee}` at {location.file}:{location.line}"}}}, span)
        // copy: the handoff's receiver is the argument's checked value, which is written back as the
        // handoff's result; Jet has no exchange on an element of the write-borrowed `args`.
        handed: sema_tree_node(Type.Named{name: "Compiler"}, TExprKind.HostCall{call: THostCall.Method{receiver: args[index].value.copy(), method: "handoff", args: [TExpr]{step}}}, args[index].value.span)
        args[index].value = handed
    }
}

// The index of the argument whose source holds `diagnostic`, or `args.len()`
// when none does.
sema_call_diagnostic_argument: fn(diagnostic: Diagnostic, args: [CallArg]) -> Int Never! {
    at: diagnostic.span ?? return args.len()
    loop index in 0..<args.len() {
        source: expr_source_span(args[index].expr)
        if at.start >= args[index].span.start && at.start < source.end -> return index
    }
    args.len()
}

// True when the errors since `start` are all argument type mismatches (E0112)
// and there is at least one.
sema_call_only_argument_mismatches: fn(diagnostics: [Diagnostic], start: Int) -> Bool Never! {
    found := false
    loop index in start..<diagnostics.len() {
        if diagnostics[index].severity != DIAGNOSTIC_ERROR -> next
        if diagnostics[index].code != "E0112" -> return false
        found = true
    }
    found
}

// A `SharedGuard` argument for a write parameter that is neither a
// `guard_edit()` lease nor a binding the caller holds with write access (Rust
// `param_conv` `Write`).
sema_call_read_shared_guard_argument: fn(state: &SemaOwnershipState, required: Type, offered: Type, expr: Expr, scopes: SemaScopeTable) -> Bool {
    if required == .Apply(guard_name, _) {
        if guard_name != "SharedGuard" -> return false
    } else {
        return false
    }
    if offered == .Tagged(marker, _) && marker == (TagMarker.Internal{internal_tag: InternalTag.SharedGuardEdit}) -> return false
    if expr == .Ident(_, _, _) && sema_ownership_binding_for_expr(state, expr, scopes) == .Val(binding) && binding.access == AccessConvention.Write -> return false
    true
}
