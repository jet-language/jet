// Type-check and lower one already-resolved call binding.
//
// Binding owns declaration order; this file owns expression checking and the
// one-way conversion to TCallArg. It never materializes a Type-only default:
// Registration must provide the original expression through
// SemaCallDefaultValue first.
use jet_foundation.[
    AccessConvention,
    BinderRef,
    CallArg,
    Diagnostic,
    Expr,
    FunctionDefaultRef,
    Span,
    Symbol,
    SymbolID,
    SymbolKind,
    TCallArg,
    TExpr,
    TExprKind,
    TLetTy,
    TStmt,
    Type,
    ast_empty_call_arg_flags,
    expr_span,
    symbol_id,
    tir_call_arg_copy_fact,
    tir_symbol_local,
    type_identity_equal,
]

struct SemaCallTypedArguments {
    pub values: [TExpr]
    pub slots: [Int]
    pub required_types: [Type]
    // Each argument's written position (`-1` for a default). When a default
    // reads an earlier parameter, every argument is pinned in
    // `binder_ref_<site>_<slot>` in the Rust reference's source order.
    pub source_indices: [Int]
    pub pin_arguments: Bool{false}
    pub binder_site: Int{0}
}

fn sema_call_resolved_type(ty: Type, environment: SemaScopeEnvironment) -> Type Never! {
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return ty
    sema_type_resolve_declared_with_generics(graph, ty, environment.module_identity, environment.generic_params)
}

fn sema_call_type_assignable(required: Type, offered: Type, environment: SemaScopeEnvironment) -> Bool? {
    if environment.registration_graph == {
        .Val(graph) -> sema_type_assignable_in_graph_with_generics(graph, required, offered, environment.module_identity, environment.generic_params)
        else -> Val(sema_type_assignable(required, offered))
    }
}

fn sema_call_box_as_trait(required: Type, offered: Type, environment: SemaScopeEnvironment) -> Type? {
    required_resolved :: sema_call_resolved_type(required, environment)
    if required_resolved == {
        .TraitObject(_) -> {}
        else -> return None
    }
    offered_resolved :: sema_call_resolved_type(offered, environment)
    if offered_resolved == {
        .TraitObject(_) -> return None
        else -> {}
    }
    compatible :: sema_call_type_assignable(required_resolved, offered_resolved, environment) ?? return None
    if compatible -> Val(required_resolved) else -> None
}

pub fn sema_call_registration_defaults(graph: SemaRegistrationGraph, binding: SemaCallBinding) -> [SemaCallDefaultValue]? {
    defaults := [SemaCallDefaultValue]{}
    loop reference in binding.default_refs {
        expression :: sema_registration_resolve_default(graph, reference) ?? return None
        &defaults.push(SemaCallDefaultValue{reference: reference, expression: expression})
    }
    Val(defaults)
}

fn sema_call_param_optional_for_check(param: SemaCallParam) -> Bool Never! {
    param.variadic || param.default != None || param.default_ref != None
}

fn sema_call_default_ref_equal(left: FunctionDefaultRef, right: FunctionDefaultRef) -> Bool Never! {
    left.source_file == right.source_file && left.owner_key == right.owner_key && left.parameter_index == right.parameter_index && left.span.start == right.span.start && left.span.end == right.span.end
}

fn sema_call_default_expression(reference: FunctionDefaultRef, defaults: [SemaCallDefaultValue]) -> Expr? {
    loop candidate in defaults {
        if sema_call_default_ref_equal(reference, candidate.reference) -> return Val(candidate.expression)
    }
    None
}

fn sema_call_make_binder_refs(params: [SemaCallParam], parameter: Int) -> [BinderRef] Never! {
    refs := [BinderRef]{}
    loop index in 0..<parameter {
        if sema_call_parameter_type(params[index]) == .Val(value) {
            &refs.push(BinderRef{name: params[index].name, slot: index, ty: value})
        }
    }
    refs
}

fn sema_call_mark_materialized_written(arg: CallArg, source_index: Int, parameter: Int, param: SemaCallParam, span: Span) -> CallArg Never! {
    result := arg
    result.flags.source_index = Val(source_index)
    result.flags.binder_slot = Val(parameter)
    result.flags.binder_site = Val(span.start)
    result.flags.binder_label = Val(param.label)
    result
}

fn sema_call_make_materialized_default(value: Expr, parameter: Int, param: SemaCallParam, params: [SemaCallParam], span: Span) -> CallArg Never! {
    flags := ast_empty_call_arg_flags()
    flags.binder_slot = Val(parameter)
    flags.binder_site = Val(span.start)
    flags.binder_label = Val(param.label)
    flags.binder_refs = sema_call_make_binder_refs(params, parameter)
    CallArg{convention: param.convention, expr: value, span: span, flags: flags, label: None, spread: false}
}

// Fill only metadata defaults whose original expressions Registration resolved.
// The returned binding keeps source indices stable for evaluation-order lowering.
pub fn sema_call_materialize_defaults(params: [SemaCallParam], binding: SemaCallBinding, args: &[CallArg], defaults: [SemaCallDefaultValue], call_span: Span, diagnostics: &[Diagnostic]) -> SemaCallBinding? {
    if binding.default_refs.len() == 0 -> return Val(binding)
    loop reference in binding.default_refs {
        if sema_call_default_expression(reference, defaults) == None {
            &diagnostics.push(sema_error("E0906", call_span, "a default argument for this call could not be resolved", "callable defaults retain their owning declaration and source identity", "make the owning declaration available to Registration before checking this call"))
            return None
        }
    }
    rewritten := [CallArg]{}
    loop source in binding.sources {
        if source == {
            .Written(original_index) -> {
                if original_index < 0 || original_index >= args.len() {
                    &diagnostics.push(sema_call_arity_diagnostic("this call", params.len(), args.len(), false, call_span))
                    return None
                }
                parameter :: if original_index < binding.slots.len() -> binding.slots[original_index] else -> -1
                if parameter < 0 || parameter >= params.len() {
                    &diagnostics.push(sema_call_arity_diagnostic("this call", params.len(), args.len(), false, call_span))
                    return None
                }
                &rewritten.push(sema_call_mark_materialized_written(args[original_index], original_index, parameter, params[parameter], call_span))
            }
            .Default(parameter) -> {
                if parameter < 0 || parameter >= params.len() {
                    &diagnostics.push(sema_error("E0906", call_span, "a default argument refers to an invalid parameter", "default metadata must point into the owning declaration", "repair the registered FunctionDefaultRef"))
                    return None
                }
                reference :: params[parameter].default_ref ?? {
                    &diagnostics.push(sema_error("E0906", call_span, "a default argument lost its source reference", "metadata defaults are identified by FunctionDefaultRef", "register the declaration's original default expression"))
                    return None
                }
                expression :: sema_call_default_expression(reference, defaults) ?? {
                    &diagnostics.push(sema_error("E0906", call_span, "a default argument for this call could not be resolved", "callable defaults retain their owning declaration and source identity", "make the owning declaration available to Registration before checking this call"))
                    return None
                }
                &rewritten.push(sema_call_make_materialized_default(expression, parameter, params[parameter], params, call_span))
            }
        }
    }
    if rewritten.len() != binding.sources.len() {
        &diagnostics.push(sema_error("E0104", call_span, "the call binding did not produce one value per declaration slot", "a successful call has to account for every written value and resolved default", "check the callable declaration and its default metadata"))
        return None
    }
    loop args.len() > 0 -> _ := &args.pop()
    loop value in rewritten -> &args.push(value)
    result := binding
    result.rewrote = true
    result
}

fn sema_call_bound_slot(binding: SemaCallBinding, source: SemaCallArgSource, arg: CallArg) -> Int Never! {
    if arg.flags.binder_slot == .Val(slot) -> return slot
    if source == {
        .Written(index) -> if index >= 0 && index < binding.slots.len() -> binding.slots[index] else -> -1
        .Default(parameter) -> parameter
    }
}

fn sema_call_view_place_equal(left: SemaOwnershipPlace, right: SemaOwnershipPlace) -> Bool Never! {
    if left.root_key != right.root_key || left.projections.len() != right.projections.len() -> return false
    loop index in 0..<left.projections.len() {
        if left.projections[index] != right.projections[index] -> return false
    }
    true
}

fn sema_call_return_view_parameter_expr(parameter: Int, binding: SemaCallBinding, args: [CallArg]) -> Expr? {
    loop index in 0..<args.len() {
        source :: binding.sources[index]
        if sema_call_bound_slot(binding, source, args[index]) == parameter -> return Val(args[index].expr)
    }
    None
}

pub fn sema_call_return_view_facts(signature: Type, receiver: Expr?, args: [CallArg], binding: SemaCallBinding, scopes: SemaScopeTable, state: &SemaOwnershipState, span: Span) -> [SemaCallReturnViewFact] {
    map :: if signature == {
        .Fn(_, _, _, _, _, return_view_provenance) -> return_view_provenance ?? return [SemaCallReturnViewFact]{}
        else -> {
            return [SemaCallReturnViewFact]{}
        }
    }
    facts := [SemaCallReturnViewFact]{}
    loop entry in map.entries {
        places := [SemaOwnershipPlace]{}
        temporaries := [Span]{}
        loop source_path in entry.value.sources {
            source_expr := Expr?{None}
            if source_path.source == {
                .Receiver -> source_expr = ~receiver
                .Parameter(parameter) -> source_expr = sema_call_return_view_parameter_expr(parameter, binding, args)
                .Static(_, _) -> {}
            }
            if source_expr == .Val(expression) {
                source_places :: sema_ownership_places_from_expr_in_state(expression, scopes, &state)
                if source_places.len() == 0 && source_path.source == .Parameter(_) -> &temporaries.push(expr_span(expression))
                loop source_place in source_places {
                    place :: sema_ownership_append_view_source_projections(source_place, source_path.projections, span)
                    duplicate :: loop existing in places {
                        if sema_call_view_place_equal(existing, place) -> break true
                    } ?? false
                    if !duplicate -> &places.push(place)
                }
            }
        }
        access :: if entry.value.mutable -> AccessConvention.Write else -> AccessConvention.Read
        &facts.push(SemaCallReturnViewFact{
            slot: entry.slot,
            access: access,
            places: places,
            sources: entry.value.sources,
            temporaries: temporaries,
        })
    }
    facts
}

fn sema_call_validate_binding(callee: String, params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if binding.sources.len() != args.len() {
        &diagnostics.push(sema_error("E0104", span, "the call binding and written arguments disagree", "a checked call must have one source row for every argument value", "resolve callable defaults before checking the call"))
        return false
    }
    seen := [Bool]{}
    loop index in 0..<params.len() -> &seen.push(false)
    valid := true
    loop index in 0..<binding.sources.len() {
        slot :: sema_call_bound_slot(binding, binding.sources[index], args[index])
        if {
            slot < 0 || slot >= params.len() -> valid = false
            else -> seen[slot] = true
        }
    }
    if !valid {
        &diagnostics.push(sema_call_arity_diagnostic(callee, params.len(), args.len(), false, span))
    }
    missing := 0
    loop index in 0..<params.len() {
        if !seen[index] && !sema_call_param_optional_for_check(params[index]) {
            &diagnostics.push(sema_error("E0766", span, "this call to `{callee}` is missing `{params[index].label}`", "the parameter has no default, so every call has to supply it", "add the missing argument"))
            missing += 1
        }
    }
    valid && missing == 0
}

fn sema_call_is_scalar(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .IntN(_, _) -> true
        .Float -> true
        .Float32 -> true
        .Bool -> true
        .Char -> true
        else -> false
    }
}

fn sema_call_convention_diagnostic(callee: String, param: SemaCallParam, arg: CallArg, decision: SemaCallConventionDecision) -> Diagnostic {
    if decision == {
        .RequiresWrite -> sema_error("E0202", arg.span, "parameter `{param.name}` requires the write-access marker `&` at the call site", "`{callee}` needs to edit this value with the write-access marker `&`", "write `&` before the argument")
        .RejectsMove -> sema_error("E0203", arg.span, "a value was passed with the move marker `^` to a parameter that does not consume", "only a move parameter accepts a moved value", "remove the move marker `^`")
        else -> sema_error("E0209", arg.span, "implicit clone of `{param.name}`", "`{callee}` takes ownership and this argument is not marked as a move", "write the move marker `^`, or copy the value explicitly")
    }
}

fn sema_call_lambda_escape_policy(parameter: SemaCallParam, abi: SemaRegistrationCallableABI?) -> Bool? {
    if parameter.convention == AccessConvention.Move -> return Val(true)
    callable_abi :: abi ?? return None
    parameter_type :: sema_call_parameter_type(parameter) ?? return None
    Val(sema_registration_callback_boundary_param(callable_abi, parameter_type))
}

fn sema_call_typecheck_bound_arguments(callee: String, params: [SemaCallParam], abi: SemaRegistrationCallableABI?, apply_lambda_escape_override: Bool, binding: SemaCallBinding, args: &[CallArg], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic], report_conventions: Bool) -> SemaCallTypedArguments? {
    if !sema_call_validate_binding(callee, params, binding, args, span, &diagnostics) -> return None
    values := [TExpr]{}
    slots := [Int]{}
    required_types := [Type]{}
    source_indices := [Int]{}
    pin_arguments := false
    binder_site := 0
    loop index in 0..<args.len() {
        slot :: sema_call_bound_slot(binding, binding.sources[index], args[index])
        if slot < 0 || slot >= params.len() -> return None
        parameter :: params[slot]
        required_declared :: sema_call_argument_parameter_type(parameter, args[index]) ?? {
            &diagnostics.push(sema_error("E0112", args[index].span, "this callable parameter has no checked type", "call checking cannot prove an argument safe without the declaration type", "register the complete callable signature"))
            return None
        }
        required :: sema_call_resolved_type(required_declared, environment)
        decision :: sema_call_argument_convention(parameter, args[index])
        if report_conventions && decision != SemaCallConventionDecision.Accepted {
            &diagnostics.push(sema_call_convention_diagnostic(callee, parameter, args[index], decision))
            return None
        }
        // Rust CallBinder `rewrite` + `register_binder_refs`: a default names
        // earlier parameters through their declaration-slot temporaries, so
        // they shadow any caller binding of the same name.
        binder_refs :: args[index].flags.binder_refs
        binder_start :: context.name_references.len()
        binder_keys :: if binder_refs.len() > 0 -> sema_call_enter_binder_refs(binder_refs, args[index].flags.binder_site ?? span.start, environment, &scopes, &state, expr_span(args[index].expr)) else -> [String]{}
        checked_argument :: if apply_lambda_escape_override -> sema_check_expression_with_lambda_escapes(args[index].expr, Val(required), environment, &scopes, &state, &tail_store, &context, sema_call_lambda_escape_policy(parameter, abi), &diagnostics) else -> sema_check_expression(args[index].expr, Val(required), environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if binder_refs.len() > 0 {
            sema_scope_leave(&scopes, &state)
            if sema_call_binder_refs_read(binder_keys, binder_start, context) {
                pin_arguments = true
                binder_site = args[index].flags.binder_site ?? span.start
            }
        }
        value :: checked_argument ?? return None
        compatible :: sema_call_type_assignable(required_declared, value.ty, environment) ?? return None
        if !compatible {
            &diagnostics.push(sema_type_mismatch(required, value.ty, args[index].span))
            return None
        }
        &values.push(value)
        &slots.push(slot)
        &required_types.push(required)
        &source_indices.push(args[index].flags.source_index ?? -1)
    }
    Val(SemaCallTypedArguments{values: values, slots: slots, required_types: required_types, source_indices: source_indices, pin_arguments: pin_arguments, binder_site: binder_site})
}

fn sema_call_binder_ref_symbol(environment: SemaScopeEnvironment, owner: String, site: Int, slot: Int, name: String, ty: Type, span: Span) -> Symbol Never! {
    id :: symbol_id(SymbolKind.Local, environment.module_identity, owner, "binder_ref_{site}_{slot}")
    Symbol{id: id, kind: SymbolKind.Local, name: name, module_name: environment.module_identity, owner: Val(owner), span: span, ty: Val(ty), visibility: 0}
}

// Opens the default's own frame with each earlier parameter bound to its slot
// temporary; the caller leaves it after checking the default. A placeholder
// enters ownership only when the default reads it, so an unread one is no
// unused binding. `span` is the default expression, so every read follows it.
fn sema_call_enter_binder_refs(refs: [BinderRef], site: Int, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, span: Span) -> [String] Never! {
    owner :: sema_scope_function_owner_key(scopes)
    _ := sema_scope_enter(&scopes, &state, owner)
    keys := [String]{}
    loop reference in refs {
        symbol :: sema_call_binder_ref_symbol(environment, owner, site, reference.slot, reference.name, reference.ty, span)
        _ := sema_scope_declare_local(&scopes, symbol, false, AccessConvention.Read, None, false)
        &keys.push(symbol.id.key)
    }
    keys
}

fn sema_call_binder_refs_read(keys: [String], start: Int, context: SemaCheckContext) -> Bool Never! {
    loop index in start..<context.name_references.len() {
        if keys.contains(context.name_references[index].symbol.id.key) -> return true
    }
    false
}

// Rust `source_arg_order` + `bind_arg_temporaries`: once a default reads an
// earlier parameter, every supplied argument is evaluated into
// `binder_ref_<site>_<slot>` in written order, then every default in
// declaration order, so a default reads the value already passed and runs
// after every supplied argument. The receiver stays in the call, as in the
// reference. Borrowed arguments are pinned as borrows so a default can read
// them too.
fn sema_call_pin_binder_arguments(typed: SemaCallTypedArguments, params: [SemaCallParam], lowered: &[TCallArg], environment: SemaScopeEnvironment, scopes: SemaScopeTable, span: Span) -> [TStmt] Never! {
    bindings := [TStmt]{}
    if !typed.pin_arguments -> return bindings
    owner :: sema_scope_function_owner_key(scopes)
    order := [Int]{}
    loop written in 0..<typed.source_indices.len() {
        loop index in 0..<typed.source_indices.len() {
            if typed.source_indices[index] == written -> &order.push(index)
        }
    }
    loop index in 0..<typed.source_indices.len() {
        if typed.source_indices[index] < 0 -> &order.push(index)
    }
    loop index in order {
        slot :: typed.slots[index]
        // A variadic slot spread over several arguments has no single slot
        // temporary; those arguments stay in the call.
        shared_slot := false
        loop other in 0..<typed.slots.len() {
            if other != index && typed.slots[other] == slot -> shared_slot = true
        }
        if shared_slot -> next
        original :: ~lowered[index].value
        ty :: original.ty
        init := original
        if lowered[index].clone || lowered[index].arc_clone {
            init = sema_tir_expr(ty, TExprKind.Clone{value: init, fact: tir_call_arg_copy_fact(lowered[index].arc_clone)}, original.span)
            lowered[index].clone = false
            lowered[index].arc_clone = false
        }
        borrowed :: lowered[index].borrow || lowered[index].mut_borrow
        if borrowed {
            access :: if lowered[index].mut_borrow -> AccessConvention.Write else -> AccessConvention.Read
            init = sema_tir_expr(ty, TExprKind.Borrow{place: init, access: access}, original.span)
        }
        symbol :: sema_call_binder_ref_symbol(environment, owner, typed.binder_site, slot, params[slot].name, ty, span)
        local := tir_symbol_local("binder_ref_{typed.binder_site}_{slot}", span, symbol.id)
        local.generated = true
        local.mutable = lowered[index].mut_borrow
        local.deref = borrowed
        local_value :: sema_tir_expr(ty, TExprKind.Local{local: local}, original.span)
        lowered[index].value = if params[slot].convention == AccessConvention.Move -> sema_tir_expr(ty, TExprKind.Move{value: local_value}, original.span) else -> local_value
        &bindings.push(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: init, gc_promotion: None, gc_transferred: false, span: span})
    }
    bindings
}

// Places the binder pins before the call they feed.
fn sema_call_with_binder_pins(pins: ^[TStmt], call_value: ^TExpr, span: Span) -> TExpr Never! {
    if pins.len() == 0 -> return call_value
    ty :: ~call_value.ty
    body := pins
    &body.push(TStmt.ExprStmt{value: call_value, span: span})
    sema_tir_expr(ty, TExprKind.InlineBlock{body: body}, span)
}

fn sema_call_widen_union(required: Type, offered: Type) -> Type? {
    if required == .Union(members) {
        loop member in members {
            if type_identity_equal(member, offered) -> return Val(required)
        }
    }
    None
}

fn sema_call_lower_bound_arguments(typed: SemaCallTypedArguments, params: [SemaCallParam], args: &[CallArg], environment: SemaScopeEnvironment) -> [TCallArg] Never! {
    lowered := [TCallArg]{}
    loop index in 0..<typed.values.len() {
        value :: typed.values[index]
        arg :: args[index]
        param :: params[typed.slots[index]]
        required :: if index < typed.required_types.len() -> typed.required_types[index] else -> sema_call_resolved_type(sema_call_argument_parameter_type(param, arg) ?? value.ty, environment)
        widen_to_vec :: if required == {
            .List(_) -> if value.ty == {
                .FixedList(_, _) -> true
                else -> false
            }
            else -> false
        }
        widen_to_union :: sema_call_widen_union(required, value.ty)
        &lowered.push(TCallArg{
            value: value,
            template_items: [SymbolID]{},
            borrow: param.convention == AccessConvention.Read && !sema_call_is_scalar(value.ty),
            mut_borrow: param.convention == AccessConvention.Write,
            clone: arg.flags.implicit_clone || arg.flags.shared_auto_clone,
            arc_clone: false,
            fn_coerce: None,
            widen_to_vec: widen_to_vec,
            widen_to_union: widen_to_union,
            box_as_trait: sema_call_box_as_trait(required, value.ty, environment),
            label: arg.label.map((label) -> label.name),
            spread: arg.spread,
        })
    }
    lowered
}

pub fn sema_call_check_bound_arguments(state: &SemaOwnershipState, callee: String, params: [SemaCallParam], binding: SemaCallBinding, args: &[CallArg], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> [TCallArg]? {
    typed :: sema_call_typecheck_bound_arguments(callee, params, None, false, binding, &args, environment, &scopes, &state, &tail_store, &context, span, &diagnostics, true) ?? return None
    if typed.pin_arguments {
        &diagnostics.push(sema_error("E0906", span, "a default argument of `{callee}` reads an earlier parameter on a call route that cannot pin it", "a default that names an earlier parameter reads that slot's already-passed value", "pass this argument explicitly"))
        return None
    }
    Val(sema_call_lower_bound_arguments(typed, params, &args, environment))
}

// This path runs Ownership after expression typing and before lowering. The
// ownership hook may mark implicit_clone on the source arg, so lowering must
// happen only after it accepts and completes. `pins` receives the
// declaration-slot temporaries the caller places before its call.
pub fn sema_call_check_bound_arguments_owned(state: &SemaOwnershipState, callee: String, params: [SemaCallParam], abi: SemaRegistrationCallableABI?, apply_lambda_escape_override: Bool, binding: SemaCallBinding, args: &[CallArg], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, pins: &[TStmt], diagnostics: &[Diagnostic]) -> [TCallArg]? {
    typed :: sema_call_typecheck_bound_arguments(callee, params, abi, apply_lambda_escape_override, binding, &args, environment, &scopes, &state, &tail_store, &context, span, &diagnostics, false) ?? return None
    ownership :: sema_ownership_check_call_arguments(&state, callee, params, &args, scopes, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return None
    lowered := sema_call_lower_bound_arguments(typed, params, &args, environment)
    loop pin in sema_call_pin_binder_arguments(typed, params, &lowered, environment, scopes, span) -> &pins.push(pin)
    Val(lowered)
}
