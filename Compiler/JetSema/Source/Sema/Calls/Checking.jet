// Type-check and lower one already-resolved call binding.
//
// Binding owns declaration order; this file owns expression checking and the
// one-way conversion to TCallArg. It never materializes a Type-only default:
// Registration must provide the original expression through
// SemaCallDefaultValue first.
use {
    jet_foundation.[
        ASTTables,
        AccessConvention,
        BinderRef,
        CallArg,
        DIAGNOSTIC_ERROR,
        Diagnostic,
        DiagnosticCryptoMisuseReason,
        DiagnosticStructured,
        Expr,
        ExprNode,
        Func,
        InternalTag,
        Lambda,
        Stmt,
        FunctionDefaultRef,
        CopyFact,
        Span,
        Symbol,
        SymbolID,
        SymbolKind,
        TagMarker,
        TLetTy,
        Type,
        AST_EMPTY_CALL_ARG_FLAGS,
        ast_expr,
        ast_lambda_single_expr_span,
        ast_stmt,
        ast_visit_expr,
        ast_visit_statement,
        expr_source_span,
        expr_span,
        checked_symbol_local,
        type_identity_equal,
        type_name,
        ModuleID,
        module_is_core,
    ]
    jet_parser.[jfmt_expr_start]
}

SemaCallTypedArguments: struct {
    values: [TExpr],
    slots: [Int],
    required_types: [Type],
    // Each argument's written position (`-1` for a default). When a default
    // reads an earlier parameter, every argument is pinned in
    // `binder_ref_<site>_<slot>` in source order.
    source_indices: [Int],
    pin_arguments: Bool{false},
    binder_site: Int{0},
}

sema_call_resolved_type: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type Never! {
    if ty == {
        .Int -> return Type.Int
        .Float -> return Type.Float
        .Bool -> return Type.Bool
        .String -> return Type.String
        .Char -> return Type.Char
        .Float32 -> return Type.Float32
        .IntN(signed, bits) -> return Type.IntN{signed: signed, bits: bits}
        .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    graph: program.registration_graph
    sema_type_resolve_declared_recursive(graph, ty, sema_scope_caller_row(environment, graph), environment.generic_params)
}

// sema_type_alias_shown from the checked scope: how a diagnostic names a
// written generic alias, or None for any other type.
sema_call_alias_shown: fn(written: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -[]> String? {
    graph: program.registration_graph
    sema_type_alias_shown(graph, written, sema_scope_caller_row(environment, graph), environment.generic_params)
}

sema_call_type_assignable: fn(required: Type, offered: Type, check: SemaBodyCheck) -> Bool? {
    graph: check.program.registration_graph
    sema_type_assignable_in_graph_at(graph, required, offered, sema_scope_caller_row(check.environment.*, graph), check.environment.generic_params)
}

sema_call_box_as_trait: fn(required: Type, offered: Type, check: SemaBodyCheck) -> Type? {
    required_resolved: sema_call_resolved_type(required, check.environment.*, check.program.*)
    if required_resolved == {
        .TraitObject(_) -> {}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
    offered_resolved: sema_call_resolved_type(offered, check.environment.*, check.program.*)
    if offered_resolved == {
        .TraitObject(_) -> return None
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    compatible: sema_call_type_assignable(required_resolved, offered_resolved, check) ?? return None
    if compatible -> Val(required_resolved) else -> None
}

sema_call_registration_defaults: fn(graph: SemaRegistrationGraph, binding: SemaCallBinding) -> [SemaCallDefaultValue]? {
    ^defaults: [SemaCallDefaultValue]{}
    loop reference in binding.default_refs {
        defaults.push(sema_registration_resolve_default(graph, reference) ?? return None)
    }
    Val(defaults)
}

sema_call_param_optional_for_check: fn(param: SemaCallParam) -> Bool Never! {
    param.variadic || param.default != None || param.default_ref != None
}

sema_call_default_ref_equal: fn(left: FunctionDefaultRef, right: FunctionDefaultRef) -> Bool Never! {
    left.source_file == right.source_file && left.owner_key == right.owner_key && left.parameter_index == right.parameter_index && left.span.start == right.span.start && left.span.end == right.span.end
}

sema_call_default_value: fn(reference: FunctionDefaultRef, defaults: [SemaCallDefaultValue]) -> SemaCallDefaultValue? {
    loop candidate in defaults {
        if sema_call_default_ref_equal(reference, candidate.reference) {
            return Val(candidate)
        }
    }
    None
}

sema_call_make_binder_refs: fn(params: [SemaCallParam], parameter: Int) -> [BinderRef] Never! {
    ^refs: [BinderRef]{}
    loop index in 0..<parameter {
        if sema_call_parameter_type(params[index]) == .Val(value) {
            refs.push(BinderRef{name: params[index].name, slot: index, ty: value})
        }
    }
    refs
}

sema_call_mark_materialized_written: fn(arg: CallArg, source_index: Int, parameter: Int, param: SemaCallParam, span: Span) -> CallArg Never! {
    ^result: arg
    result.flags.source_index = Val(source_index)
    result.flags.binder_slot = Val(parameter)
    result.flags.binder_site = Val(span.start)
    result.flags.binder_label = Val(param.label)
    result
}

sema_call_make_materialized_default: fn(value: SemaCallDefaultValue, parameter: Int, param: SemaCallParam, params: [SemaCallParam], span: Span) -> CallArg Never! {
    ^flags: AST_EMPTY_CALL_ARG_FLAGS
    flags.binder_slot = Val(parameter)
    flags.binder_site = Val(span.start)
    flags.binder_label = Val(param.label)
    flags.binder_refs = sema_call_make_binder_refs(params, parameter)
    flags.run_default = value.run
    CallArg{convention: param.convention, expr: value.expression, span: span, flags: flags, label: None, spread: false}
}

// Fill only metadata defaults whose original expressions Registration resolved.
// The returned binding keeps source indices stable for evaluation-order lowering.
sema_call_materialize_defaults: fn(params: [SemaCallParam], binding: SemaCallBinding, args: ^[CallArg], defaults: [SemaCallDefaultValue], call_span: Span, diagnostics: ^[Diagnostic]) -> SemaCallBinding? {
    if binding.default_refs.len() == 0 -> return Val(binding)
    loop reference in binding.default_refs {
        if sema_call_default_value(reference, defaults) == None {
            diagnostics.push(sema_error("E0906", call_span, "a default argument for this call could not be resolved", "callable defaults retain their owning declaration and source identity", "make the owning declaration available to Registration before checking this call"))
            return None
        }
    }
    ^rewritten: [CallArg]{}
    loop source in binding.sources {
        if source == {
            .Written(original_index) -> {
                if original_index < 0 || original_index >= args.len() {
                    diagnostics.push(sema_call_arity_diagnostic("this call", params.len(), args.len(), false, call_span))
                    return None
                }
                parameter: if original_index < binding.slots.len() -> binding.slots[original_index] else -> -1
                if parameter < 0 || parameter >= params.len() {
                    diagnostics.push(sema_call_arity_diagnostic("this call", params.len(), args.len(), false, call_span))
                    return None
                }
                rewritten.push(sema_call_mark_materialized_written(args[original_index], original_index, parameter, params[parameter], call_span))
            }
            .Default(parameter) -> {
                if parameter < 0 || parameter >= params.len() {
                    diagnostics.push(sema_error("E0906", call_span, "a default argument refers to an invalid parameter", "default metadata must point into the owning declaration", "repair the registered FunctionDefaultRef"))
                    return None
                }
                reference: params[parameter].default_ref ?? {
                    diagnostics.push(sema_error("E0906", call_span, "a default argument lost its source reference", "metadata defaults are identified by FunctionDefaultRef", "register the declaration's original default expression"))
                    return None
                }
                value: sema_call_default_value(reference, defaults) ?? {
                    diagnostics.push(sema_error("E0906", call_span, "a default argument for this call could not be resolved", "callable defaults retain their owning declaration and source identity", "make the owning declaration available to Registration before checking this call"))
                    return None
                }
                rewritten.push(sema_call_make_materialized_default(value, parameter, params[parameter], params, call_span))
            }
        }
    }
    if rewritten.len() != binding.sources.len() {
        diagnostics.push(sema_error("E0104", call_span, "the call binding did not produce one value per declaration slot", "a successful call has to account for every written value and resolved default", "check the callable declaration and its default metadata"))
        return None
    }
    loop args.len() > 0 -> ^_: args.pop()
    loop value in rewritten -> args.push(value)
    ^result: binding
    result.rewrote = true
    result
}

sema_call_bound_slot: fn(binding: SemaCallBinding, source: SemaCallArgSource, arg: CallArg) -> Int Never! {
    if arg.flags.binder_slot == .Val(slot) -> return slot
    if source == {
        .Written(index) -> if index >= 0 && index < binding.slots.len() -> binding.slots[index] else -> -1
        .Default(parameter) -> parameter
    }
}

sema_call_view_place_equal: fn(left: SemaOwnershipPlace, right: SemaOwnershipPlace) -> Bool Never! {
    if left.root_id != right.root_id || left.projections.len() != right.projections.len() {
        return false
    }
    loop index in 0..<left.projections.len() {
        if left.projections[index] != right.projections[index] -> return false
    }
    true
}

sema_call_return_view_parameter_expr: fn(parameter: Int, binding: SemaCallBinding, args: [CallArg]) -> Expr? {
    loop index in 0..<args.len() {
        source: binding.sources[index]
        if sema_call_bound_slot(binding, source, args[index]) == parameter {
            return Val(args[index].expr)
        }
    }
    None
}

// The returned-view facts of one checked call. A source argument or receiver
// with no caller place is a temporary. A binding or `return` that keeps the
// view refuses every temporary (sema_stmt_report_temporary_view_sources). Here,
// at the call, a temporary the call frees is refused whatever consumes the
// result: a surrounding expression would read freed storage. A string literal
// is static text that is never freed, so only a kept view refuses it.
sema_call_return_view_facts: fn(signature: Type, receiver: Expr?, args: [CallArg], binding: SemaCallBinding, check: ^SemaBodyCheck, span: Span) -> [SemaCallReturnViewFact] {
    map: if signature == {
        .Fn(_, _, _, _, _, return_view_provenance) -> return_view_provenance ?? return [SemaCallReturnViewFact]{}
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            return [SemaCallReturnViewFact]{}
        }
    }
    string_result: if signature == {
        .Fn(_, ret, _, _, _, _) -> if ret == .Val(result) -> sema_stmt_string_view_type(sema_call_view_result_success(result)) else -> false
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
    ^facts: [SemaCallReturnViewFact]{}
    loop entry in map.entries {
        ^places: [SemaOwnershipPlace]{}
        ^temporaries: [Span]{}
        loop source_path in entry.value.sources {
            ^source_expr: Expr?{None}
            if source_path.source == {
                // copy: each return-view source path builds its own source Expr, and `receiver` is
                // the caller's call receiver (a read parameter), used once per path in this loop.
                .Receiver -> { source_expr = receiver.copy() }
                .Parameter(parameter) -> {
                    source_expr = sema_call_return_view_parameter_expr(parameter, binding, args)
                }
                .Static(_, _) -> {}
            }
            if source_expr == .Val(expression) {
                source_places: sema_ownership_places_from_expr_in_state(expression, check.scopes, check.state)
                if source_places.len() == 0 {
                    temporary: expr_source_span(expression)
                    temporaries.push(temporary.copy())
                    if !sema_call_static_text_literal(expression) {
                        sema_call_report_temporary_view_source(temporary, string_result && entry.slot.len() == 0, check.diagnostics)
                    }
                }
                loop source_place in source_places {
                    place: sema_ownership_append_view_source_projections(source_place, source_path.projections, span)
                    duplicate: loop existing in places {
                        if sema_call_view_place_equal(existing, place) {
                            break true
                        }
                    } ?? false
                    if !duplicate -> places.push(place)
                }
            }
        }
        access: if entry.value.mutable -> AccessConvention.Write else -> AccessConvention.Read
        facts.push(
            SemaCallReturnViewFact{
                slot: entry.slot,
                access: access,
                places: places,
                sources: entry.value.sources,
                temporaries: temporaries,
            },
        )
    }
    sema_ownership_note_call_views(check.state, span, facts)
    facts
}

// The value an infallible or fallible call returns on success (`T` of
// `T Never!` / `T E!`), with user tags removed.
sema_call_view_result_success: fn(ty: Type) -> Type Never! {
    if sema_expr_unwrap_tag(ty) == .Result(ok, _) -> return sema_expr_unwrap_tag(ok)
    sema_expr_unwrap_tag(ty)
}

// A string literal with no interpolation is static text: no call frees it.
sema_call_static_text_literal: fn(expression: Expr) -> Bool Never! {
    if expression == {
        .Paren(inner, _, _) -> return sema_call_static_text_literal(inner)
        .Str(parts, _, _) -> {
            loop part in parts {
                if part == .Interp(_, _) -> return false
            }
            return true
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}

// A view-returning call whose source owner is a temporary. A source span is
// reported once, whichever of the two codes reached it first.
sema_call_report_temporary_view_source: fn(span: Span, string_view: Bool, diagnostics: ^[Diagnostic]) Never! {
    loop previous in diagnostics {
        if (previous.code == "E2305" || previous.code == "E2307") && previous.span == span {
            return
        }
    }
    diagnostic: if string_view -> sema_error("E2307", span, "A returned view cannot borrow from a temporary argument", "The temporary owner is dropped at the end of this statement, while the returned view remains live", "Store the owner in a named binding first, then pass that binding to the view-returning call") else -> sema_error("E2305", span, "a returned view cannot borrow from a temporary argument", "the temporary owner is dropped at the end of this statement, while the returned view remains live", "store the owner in a named binding first, then pass that binding to the view-returning call")
    diagnostics.push(diagnostic)
}

sema_call_validate_binding: fn(callee: String, params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], span: Span, diagnostics: ^[Diagnostic]) -> Bool {
    if binding.sources.len() != args.len() {
        diagnostics.push(sema_error("E0104", span, "the call binding and written arguments disagree", "a checked call must have one source row for every argument value", "resolve callable defaults before checking the call"))
        return false
    }
    ^seen: [Bool]{}
    loop _ in 0..<params.len() -> seen.push(false)
    ^valid: true
    loop index in 0..<binding.sources.len() {
        slot: sema_call_bound_slot(binding, binding.sources[index], args[index])
        if {
            slot < 0 || slot >= params.len() -> valid = false
            else -> seen[slot] = true
        }
    }
    if !valid {
        diagnostics.push(sema_call_arity_diagnostic(callee, params.len(), args.len(), false, span))
    }
    ^missing: 0
    loop index in 0..<params.len() {
        if !seen[index] && !sema_call_param_optional_for_check(params[index]) {
            diagnostics.push(sema_call_diag_missing(callee, params[index].label, span))
            missing += 1
        }
    }
    valid && missing == 0
}

sema_call_is_scalar: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .IntN(_, _) -> true
        .Float -> true
        .Float32 -> true
        .Bool -> true
        .Char -> true
        .String | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// A registered function's body. A registration row's declaration may hold
// none; sema_registration_function_body reads it from the row's item.
sema_call_registered_function_body: fn(program: SemaProgramTables, function: SemaRegistrationFunction) -> [Stmt] {
    graph: program.registration_graph
    if sema_registration_module_index(graph, function.symbol.module_identity) == .Val(owner_row) {
        return sema_registration_function_body(graph.modules[owner_row], function)
    }
    function.declaration.body
}

// Whether a callback argument at a C boundary is outside the C callback
// subset, which accepts only function values. A name that is not a
// registered function, and a module-qualified name, are left to the
// ordinary argument check.
sema_call_c_callback_unsafe: fn(argument: Expr, check: SemaBodyCheck) -> Bool {
    if argument == {
        .Ident(name, _, _) -> {
            function: sema_http_route_find_function(check, name) ?? return false
            return !sema_call_foreign_thread_safe_func(function.declaration, sema_call_registered_function_body(check.program.*, function))
        }
        .Lambda(lambda, _) -> return !sema_call_foreign_thread_safe_lambda(lambda) || sema_call_lambda_captures_local(check.environment.*, check.program.*, lambda, check.scopes)
        .Field(base, _, _, _) -> {
            if base == .Ident(name, _, _) {
                index: sema_scope_resolve_index(check.scopes, name) ?? return false
                kind: check.scopes.bindings[index].symbol.kind
                return kind != SymbolKind.Module && kind != SymbolKind.Import
            }
            return true
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}

// Whether the compiler hands a C callback argument to C itself
// (ir_c_callback): a named function or a lambda written at the call, for a
// plain function parameter.
sema_call_c_callback_built: fn(argument: Expr, declared: Type, check: SemaBodyCheck) -> Bool {
    if declared == .Tagged(_, _) -> return false
    if argument == .Lambda(_, _) -> return true
    if argument == .Ident(name, _, _) -> return sema_http_route_find_function(check, name) != None
    false
}

// The first task-context read in a C callback argument's body, as written
// after `context.` (`thread`, or `get(key)` for a key read). C calls the
// callback on a thread it chooses, where no task runs, so there is no context
// to read. A call in the body is already outside the callback subset (E3203),
// so a read through a callee never gets this far.
sema_call_c_callback_context_read: fn(argument: Expr, check: ^SemaBodyCheck) -> String? {
    ^inner: [String]{}
    ^reads: [SemaCallContextReadSite]{}
    if argument == .Ident(name, _, _) {
        function: sema_http_route_find_function(check, name) ?? return None
        tables: sema_scope_module_tables(check, function.symbol.module_identity) ?? return None
        loop parameter in function.declaration.params -> inner.push(parameter.name)
        body: sema_call_registered_function_body(check.program.*, function)
        loop statement in body {
            ast_visit_statement(tables, statement, fn(expression: ExprNode) { sema_call_note_context_read(tables, reads, expression) }, false)
        }
    } else if argument == .Lambda(lambda, _) {
        loop parameter in lambda.params -> inner.push(parameter.name)
        if lambda.body == {
            .Expr(value) -> {
                ast_visit_expr(check.environment.tables, value, fn(expression: ExprNode) { sema_call_note_context_read(check.environment.tables, reads, expression) })
            }
            .Block(body) -> {
                loop statement in body {
                    ast_visit_statement(check.environment.tables, statement, fn(expression: ExprNode) { sema_call_note_context_read(check.environment.tables, reads, expression) }, false)
                }
            }
        }
    }
    loop read in reads {
        if inner.contains(read.root) -> next
        if sema_scope_resolve_index(check.scopes, read.root) == .Val(found) {
            if check.scopes.bindings[found].symbol.kind != SymbolKind.Import -> next
            imported: sema_call_core_import_target(check.environment.*, check.program.*, read.root) ?? next
            if imported.module_name == "core.context" -> return Val(read.member)
        } else if read.root == "context" && sema_expression_type_symbol(check.scopes, check.environment.*, check.program.*, read.root) == None {
            return Val(read.member)
        }
    }
    None
}

// A `root.member` or `root.get(key)` the callback body writes, before it is
// known whether `root` names the task context.
SemaCallContextReadSite: struct {
    root: String,
    member: String,
}

sema_call_note_context_read: fn(tables: ASTTables, reads: ^[SemaCallContextReadSite], expression: ExprNode) {
    view: ast_expr(tables, expression)
    if view == .Field(base, member, _, _) {
        if base == .Ident(root, _, _) {
            reads.push(SemaCallContextReadSite{root: root, member: member})
        }
    } else if view == .MethodCall(receiver, method, _, _, _, args, _) {
        if method == "get" && args.len() == 1 && receiver == .Ident(root, _, _) && args[0].expr == .Ident(key, _, _) {
            reads.push(SemaCallContextReadSite{root: root, member: "get({key})"})
        }
    }
}

// E3218 at a C callback argument whose body reads the task context.
sema_call_c_callback_context_error: fn(member: String, argument: Expr) -> Diagnostic {
    callback: if argument == .Ident(name, _, _) -> "`{name}`" else -> "lambda"
    sema_error("E3218", expr_span(argument), "The C callback {callback} reads `context.{member}`.", "C calls a callback on a thread it chooses, where no Jet task runs, so there is no task context to read.", "Read the value before the foreign call and pass it to the callback through C, or drop the read.")
}

// A C callback lambda is capture-free: no name it reads, other than its own
// parameters and bindings, may be a local of the enclosing function or a
// changeable module storage binding.
sema_call_lambda_captures_local: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, lambda: Lambda, scopes: SemaScopeTable) -> Bool {
    tables: environment.tables
    ^inner: (loop parameter in lambda.params -> parameter.name)
    ^names: [String]{}
    if lambda.body == {
        .Expr(value) -> {
            ast_visit_expr(tables, value, fn(expression: ExprNode) { sema_call_note_ident(tables, names, expression) })
        }
        .Block(body) -> {
            loop statement in body {
                if ast_stmt(tables, statement) == {
                    .Val(binding) -> {
                        inner.push(binding.name)
                        ast_visit_expr(tables, binding.init, fn(expression: ExprNode) { sema_call_note_ident(tables, names, expression) })
                    }
                    .Expr(value) -> {
                        ast_visit_expr(tables, value, fn(expression: ExprNode) { sema_call_note_ident(tables, names, expression) })
                    }
                    .Return(value, _) -> {
                        if value == .Val(returned) {
                            ast_visit_expr(tables, returned, fn(expression: ExprNode) { sema_call_note_ident(tables, names, expression) })
                        }
                    }
                    .Assign(_, _, _, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Defer(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> {}
                }
            }
        }
    }
    loop name in names {
        if inner.contains(name) -> next
        index: sema_scope_resolve_index(scopes, name) ?? next
        kind: scopes.bindings[index].symbol.kind
        if kind == SymbolKind.Local || kind == SymbolKind.Parameter -> return true
        if kind == SymbolKind.Constant && sema_scope_module_storage_binding(environment, program, scopes.bindings[index].symbol) != None {
            return true
        }
    }
    false
}

sema_call_note_ident: fn(tables: ASTTables, names: ^[String], expression: ExprNode) {
    if ast_expr(tables, expression) == .Ident(name, _, _) -> names.push(name.copy())
}

sema_call_foreign_thread_safe_func: fn(func: Func, body: [Stmt]) -> Bool Never! {
    if !func.is_pure || func.type_params.len() > 0 || func.pre.len() > 0 || func.post.len() > 0 {
        return false
    }
    loop statement in body {
        if !sema_call_foreign_thread_safe_stmt(statement) -> return false
    }
    true
}

sema_call_foreign_thread_safe_lambda: fn(lambda: Lambda) -> Bool Never! {
    if lambda.take_names.len() > 0 || lambda.meta.mut_captures.len() > 0 || lambda.meta.cloned_captures.len() > 0 {
        return false
    }
    if lambda.body == {
        .Expr(value) -> return sema_call_foreign_thread_safe_expr(value)
        .Block(body) -> {
            loop statement in body {
                if !sema_call_foreign_thread_safe_stmt(statement) -> return false
            }
            return true
        }
    }
}

sema_call_foreign_thread_safe_stmt: fn(statement: Stmt) -> Bool Never! {
    if statement == {
        .Return(value, _) -> return if value == .Val(returned) -> sema_call_foreign_thread_safe_expr(returned) else -> true
        .Expr(value) -> return sema_call_foreign_thread_safe_expr(value)
        .Val(binding) -> return sema_call_foreign_thread_safe_expr(binding.init)
        .Assign(_, _, _, _) | .While(_, _, _, _, _) | .For(_, _, _, _, _, _, _, _, _) | .Switch(_, _, _, _) | .Break(_) | .BreakValue(_, _) | .Continue(_) | .BreakLabel(_, _) | .BreakLabelValue(_, _, _, _) | .ContinueLabel(_, _) | .Loop(_, _, _, _) | .CountedLoop(_, _, _, _, _, _, _) | .Unsafe(_, _, _, _) | .Impure(_, _, _, _) | .Reactive(_, _) | .Shield(_, _) | .Defer(_, _) | .Switched(_, _, _) | .Region(_, _, _, _) | .Policy(_, _, _) | .TaskGroup(_, _, _, _, _) | .Layout(_, _, _, _) | .AuthorityScope(_, _, _, _, _) | .ComptimeIf(_, _, _, _, _, _) | .ComptimeSwitch(_, _, _, _) | .ComptimeBlock(_, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .AssumeDet(_, _, _, _) | .Transact(_, _, _, _, _) | .Yield(_, _) | .ScopeMember(_, _, _, _, _, _, _, _) | .DeferClose(_, _) -> return false
    }
}

sema_call_foreign_thread_safe_expr: fn(expression: Expr) -> Bool Never! {
    if expression == {
        .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Char(_, _, _) | .Ident(_, _, _) -> return true
        .Unary(_, operand, _, _) -> return sema_call_foreign_thread_safe_expr(operand)
        .Copy(value, _, _) -> return sema_call_foreign_thread_safe_expr(value)
        .Binary(_, left, right, _, _) -> return sema_call_foreign_thread_safe_expr(left) && sema_call_foreign_thread_safe_expr(right)
        .CompareChain(operands, _, _, _, _) -> {
            loop operand in operands {
                if !sema_call_foreign_thread_safe_expr(operand) -> return false
            }
            return true
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Unit(_, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}

sema_call_lambda_escape_policy: fn(parameter: SemaCallParam, abi: SemaRegistrationCallableABI?) -> Bool? {
    if parameter.convention == AccessConvention.Move -> return Val(true)
    callable_abi: abi ?? return None
    if !callable_abi.is_extern && !callable_abi.is_c_abi && callable_abi.callback_transport == None {
        return if parameter.ty != None -> Val(false) else -> None
    }
    parameter_type: sema_call_parameter_type(parameter) ?? return None
    Val(sema_registration_callback_boundary_param(callable_abi, parameter_type))
}

sema_call_typecheck_bound_arguments: fn(callee: String, params: [SemaCallParam], abi: SemaRegistrationCallableABI?, apply_lambda_escape_override: Bool, binding: SemaCallBinding, args: ^[CallArg], check: ^SemaBodyCheck, span: Span, report_conventions: Bool) -> SemaCallTypedArguments? {
    if !sema_call_validate_binding(callee, params, binding, args, span, check.diagnostics) {
        return None
    }
    arg_count: args.len()
    if arg_count == 0 {
        return Val(SemaCallTypedArguments{values: [TExpr]{}, slots: [Int]{}, required_types: [Type]{}, source_indices: [Int]{}, pin_arguments: !binding.source_ordered, binder_site: span.start})
    }
    ^values: [TExpr]{}
    ^slots: [Int]{}
    ^required_types: [Type]{}
    ^source_indices: [Int]{}
    ^reference_starts: [Int]{}
    values.try_reserve(arg_count) ?? ()
    slots.try_reserve(arg_count) ?? ()
    required_types.try_reserve(arg_count) ?? ()
    source_indices.try_reserve(arg_count) ?? ()
    reference_starts.try_reserve(arg_count + 1) ?? ()
    ^pin_arguments: !binding.source_ordered
    ^binder_site: span.start
    ^take_indices: [Int]{}
    ^take_keys: [String]{}
    // Every argument is checked, so each mismatched one is reported.
    ^complete: true
    call_diagnostics_start: check.diagnostics.len()
    // The first argument a C function receives as a callback pointer.
    ^c_callback: Span?{None}
    abi_has_boundary: if abi == .Val(callable_abi) -> callable_abi.is_extern || callable_abi.is_c_abi || callable_abi.callback_transport != None else -> false
    loop index in 0..<arg_count {
        reference_starts.push(check.context.name_references.len())
        slot: sema_call_bound_slot(binding, binding.sources[index], args[index])
        if slot < 0 || slot >= params.len() -> return None
        parameter: params[slot]
        is_default: binding.sources[index] == .Default(_)
        // A `Type{#run value}` default in run-time code is computed for this
        // call while building (sema_call_run_default); code that already runs
        // while building computes it as it runs.
        run_default: is_default && args[index].flags.run_default && sema_expr_runtime_body_owner(check) != None
        // A written argument for a `#run` default would stand in for the value
        // the build computes from this call's arguments (E0642); forwarding
        // the caller's own parameter with the same default keeps it.
        if !is_default && parameter.default_ref == .Val(reference) && sema_call_run_default_refused(args[index].expr, reference, check) {
            check.diagnostics.push(sema_run_default_written(parameter.name, expr_span(args[index].expr)))
            complete = false
            next
        }
        if is_default {
            // A `#caller` default is the place of this call.
            if sema_site_is_caller(args[index].expr) {
                args[index].expr = sema_site_location_expr("", check.environment.*, check.program.*, check.scopes, span)
            }
            // A script variable's default reads the caller's binding at the
            // call; a caller that hasn't bound it is refused, and so is a task
            // that would change it beside the script.
            if sema_script_variable_default(args[index].expr, parameter) == .Val(declared) {
                if sema_scope_resolve_index_at(check.scopes, parameter.name, span) == None {
                    check.diagnostics.push(sema_script_unbound_variable(declared, parameter.name, span, check))
                    complete = false
                    next
                }
                if check.context.taskgroups.in_spawn && parameter.convention == AccessConvention.Write {
                    check.diagnostics.push(sema_script_task_diagnostic(sema_call_reflection_leaf_name(callee), parameter.name, span))
                    complete = false
                    next
                }
                args[index].expr = sema_script_variable_read(parameter.name, span)
            }
        }
        required_declared: sema_call_argument_parameter_type(parameter, args[index]) ?? {
            check.diagnostics.push(sema_error("E0112", args[index].span, "this callable parameter has no checked type", "call checking cannot prove an argument safe without the declaration type", "register the complete callable signature"))
            return None
        }
        required: sema_call_resolved_type(required_declared, check.environment.*, check.program.*)
        // An unmarked place a write parameter receives is its write access.
        if sema_call_unmarked_write_place(parameter, args[index]) {
            args[index].convention = AccessConvention.Write
        }
        // `place.move()` handed to a take parameter is the call's take of that place.
        if parameter.convention == AccessConvention.Move && sema_expr_argument_move_place(args[index], check.scopes) == .Val(taken) {
            args[index].expr = taken
            args[index].convention = AccessConvention.Move
        }
        if args[index].convention == AccessConvention.Write {
            sema_stmt_uninit_write_arg(args[index], check)
        }
        decision: sema_call_argument_convention(parameter, args[index])
        // A default names earlier parameters through their declaration-slot
        // temporaries, so they shadow any caller binding of the same name.
        has_binder_refs: args[index].flags.binder_refs.len() > 0
        binder_start: check.context.name_references.len()
        // A default written in another module checks in its declaring module's
        // names (sema_default_owner_scope), as a fresh value of its own. A
        // `#run` default's staged value is computed in the calling body, so
        // it checks there, as a `#run` `#Pre` clause does.
        ^owner_scope: if is_default && !run_default -> sema_call_default_owner_scope(binding.sources[index], parameter, args[index].expr, check) else -> None
        default_in_owner: owner_scope != None
        // A taken argument out of pinned storage is the move E0219, reported
        // before checking the argument reads it beside the pin (E0220). A
        // take parameter takes its plain name.
        if !default_in_owner && (args[index].convention == AccessConvention.Move || decision == SemaCallConventionDecision.NeedsImplicitClone) && !sema_pin_check_move(check, args[index].expr) {
            complete = false
            next
        }
        ^binder_keys: if has_binder_refs && !default_in_owner -> sema_call_enter_binder_refs(args[index].flags.binder_refs, args[index].flags.binder_site ?? span.start, check.environment.*, check.program.*, check.scopes, check.state, check.context, args[index].expr) else -> [SymbolID]{}
        // A self-typed numeric read widens into the parameter after it is
        // checked on its own.
        may_be_numeric: if required == {
            .Int | .Float | .Float32 | .IntN(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) -> true
            .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        self_typed: may_be_numeric && sema_stmt_numeric_slot_self_typed(args[index].expr, required, check)
        trait_parameter: if required == {
            .TraitObject(_) -> true
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        // A borrowed trait parameter lends the original concrete storage.
        // Expected-type coercion would instead construct an owned TraitBox.
        borrowed_trait: trait_parameter && parameter.convention != AccessConvention.Move
        // A unit parameter checks its argument on its own, so another unit of
        // its family can convert into it below.
        may_be_unit: if required == {
            .Named(_) | .Apply(_, _) | .Tagged(_, _) | .Quantity(_, _) | .Measure(_) -> true
            .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) -> false
        }
        unit_parameter: may_be_unit && sema_expr_unit_fact(required, check.environment.*, check.program.*) != None
        // A variadic bounded by a compiler-owned trait has the trait's name as
        // its type; like a trait parameter's, its argument is checked on its
        // own and then against the bound (E1313 below).
        owned_bound_variadic: parameter.variadic && sema_call_owned_trait_bound(required_declared) != None
        ^argument_expected: Type?{None}
        if !self_typed && !borrowed_trait && !unit_parameter && !owned_bound_variadic {
            argument_expected = Val(required)
        }
        // A C callback is a pure, monomorphic function or a capture-free
        // lambda whose body is safe on a foreign thread; anything else is
        // E3203, reported before the argument's own type check. One that
        // reads the task context is E3218, which names the read.
        if abi_has_boundary && !default_in_owner && abi == .Val(callable_abi) {
            if sema_registration_callback_boundary_param(callable_abi, required_declared) {
                context_read: if callable_abi.is_c_abi -> sema_call_c_callback_context_read(args[index].expr, check) else -> String?{None}
                if context_read == .Val(member) {
                    check.diagnostics.push(sema_call_c_callback_context_error(member, args[index].expr))
                } else if sema_call_c_callback_unsafe(args[index].expr, check) {
                    check.diagnostics.push(sema_checked_foreign_type_error(required_declared, expr_span(args[index].expr), true))
                }
                if callable_abi.is_c_abi && c_callback == None && !sema_call_c_callback_built(args[index].expr, required_declared, check) {
                    c_callback = Val(expr_span(args[index].expr))
                }
            }
        }
        diagnostic_start: check.diagnostics.len()
        lambda_escapes: if apply_lambda_escape_override -> sema_call_lambda_escape_policy(parameter, abi) else -> check.context.lambda_escapes
        checked_argument: if {
            run_default -> sema_call_run_default(args[index], values, slots, binder_keys, args, binding, argument_expected, check, span)
            default_in_owner -> sema_call_check_owner_default(owner_scope, args[index], argument_expected, parameter, abi, apply_lambda_escape_override, check, span, binder_keys)
            apply_lambda_escape_override -> sema_check_expression_with_lambda_escapes(args[index].expr, argument_expected, check, lambda_escapes)
            else -> sema_check_expression(args[index].expr, argument_expected, check)
        }
        if has_binder_refs {
            if !default_in_owner -> sema_scope_leave(check.scopes, check.state)
            if sema_call_binder_refs_read(binder_keys, binder_start, check.context) {
                pin_arguments = true
                binder_site = args[index].flags.binder_site ?? span.start
            }
        }
        checked_value: checked_argument ?? {
            if !default_in_owner && !has_binder_refs && !run_default {
                if sema_call_parameter_type_undeclared(required, check) {
                    sema_call_argument_drop_mismatch(args[index].expr, diagnostic_start, check.diagnostics)
                } else {
                    sema_call_argument_replace_mismatch(callee, index, required, sema_call_alias_shown(required_declared, check.environment.*, check.program.*), args[index].expr, lambda_escapes, diagnostic_start, check)
                }
            }
            complete = false
            next
        }
        // A write parameter edits its argument's storage and a marked take
        // gives it away; a computed field has none, so it is never lent.
        if parameter.convention == AccessConvention.Write && sema_expression_refuse_computed_place(checked_value, "lent for writing", check) {
            complete = false
            next
        }
        if args[index].convention == AccessConvention.Move && sema_expression_refuse_computed_place(checked_value, "taken", check) {
            complete = false
            next
        }
        // E0205: a write `SharedGuard` parameter edits through the guard, so
        // only a `guard_edit()` lease or the caller's own write binding may
        // enter it.
        if parameter.convention == AccessConvention.Write && sema_call_read_shared_guard_argument(check, required, checked_value.ty, args[index].expr) {
            check.diagnostics.push(sema_error("E0205", expr_span(args[index].expr), "a read `SharedGuard` cannot enter a write helper", "the helper can edit through this parameter, so its caller must hold an exclusive Shared guard", "create the guard with `guard_edit()` before passing it to the helper"))
            complete = false
            next
        }
        // A module place lent for writing is written by the callee (E3401 in
        // a pure caller); a `^` parameter does not record its own writes.
        if parameter.convention == AccessConvention.Write {
            sema_scope_record_lent_write(args[index].expr, expr_span(args[index].expr), check)
        }
        // A collection a loop is reading, lent for writing, can be changed by
        // the callee (cleared, refilled) while the loop still reads it.
        if parameter.convention == AccessConvention.Write && sema_expr_place_root_ident(args[index].expr) == .Val(root) && check.context.iter_borrowed.contains(root) {
            check.diagnostics.push(sema_collection_changed_in_loop(root, "lending `{root}` for writing to {sema_ownership_callee_text(callee)}", expr_span(args[index].expr)))
        }
        // A bare name a take parameter receives is that parameter's take, as
        // `name.move()` was. A resource has one cleanup owner, so a take that
        // would copy it out of a place read in place (E0211) or out of a
        // borrowed parameter (E0201 naming `^^`) is refused for that, never
        // with a `.copy()` fix.
        taken_name: args[index].convention == AccessConvention.Move || decision == SemaCallConventionDecision.NeedsImplicitClone
        if parameter.convention == AccessConvention.Move && decision == SemaCallConventionDecision.NeedsImplicitClone && args[index].convention != AccessConvention.Move && (!sema_copy_site_refuse_resource_copy(checked_value, check) || !sema_copy_site_refuse_borrowed_copy(args[index].expr, sema_ownership_callee_text(callee), check)) {
            return None
        }
        if parameter.convention == AccessConvention.Move && !sema_copy_site_check_guard_owned(checked_value, check, taken_name) {
            return None
        }
        // A self-typed read that does not fit reports the generic E0108 at the
        // value; like any other argument, that becomes the call's E0112.
        // Integer narrowing keeps its own E0108.
        slot_start: check.diagnostics.len()
        widened: if self_typed -> sema_stmt_numeric_slot_value(checked_value, required, check) else -> Val(checked_value)
        ^value: widened ?? {
            if sema_integer_narrowing_fix(required, sema_call_resolved_type(checked_value.ty, check.environment.*, check.program.*)) == None {
                sema_call_argument_replace_mismatch(callee, index, required, sema_call_alias_shown(required_declared, check.environment.*, check.program.*), args[index].expr, lambda_escapes, slot_start, check)
            }
            return None
        }
        // A write parameter edits its argument's own storage, so a trait or
        // union parameter takes exactly its type: a member or a smaller
        // union would be widened into a temporary the callee's writes miss.
        exact_write: parameter.convention == AccessConvention.Write && (trait_parameter || required == .Union(_))
        ^compatible: if {
            exact_write -> type_identity_equal(required, sema_call_resolved_type(value.ty, check.environment.*, check.program.*))
            sema_type_same_named(required, value.ty) -> true
            else -> sema_call_type_assignable(required, value.ty, check) ?? return None
        }
        // A parameter whose written type names nothing reported E0119 at its
        // declaration; it takes any argument, so the call's own checks (the
        // moves, E0201) still run without a cascade E0112 (#6294).
        if !compatible && sema_call_parameter_type_undeclared(required, check) -> compatible = true
        if !compatible && sema_expr_unit_implicit_applies(required, value.ty, check) {
            converted: sema_expr_unit_implicit_conversion(value, required, check) ?? {
                complete = false
                next
            }
            value = converted
            compatible = true
        }
        if !compatible {
            if sema_expr_unit_coherent_value(value, required, check.environment.*, check.program.*) == .Val(coherent) {
                value = coherent
                compatible = true
            }
        }
        if !compatible {
            // E1313: a trait-bounded variadic argument is checked against each
            // bound trait it fails to implement; one that implements every
            // bound is accepted. A builtin trait stays a named bound after
            // resolution.
            ^bounds: [String]{}
            if required == .TraitObject(list) -> bounds = list else if sema_call_owned_trait_bound(required_declared) == .Val(trait_name) {
                bounds = [String]{trait_name}
            }
            if parameter.variadic && !args[index].spread && bounds.len() > 0 {
                arg_name: type_name(value.ty)
                ^unmet: false
                loop bound in bounds {
                    if sema_call_variadic_bound_met(bound, value.ty, check) == (Val(true)) -> next
                    check.diagnostics.push(sema_call_variadic_bound_unmet(arg_name, parameter.name, bound, callee, expr_span(args[index].expr)))
                    unmet = true
                }
                if unmet -> return None
            } else {
                check.diagnostics.push(sema_call_argument_mismatch(callee, index, required, sema_call_alias_shown(required_declared, check.environment.*, check.program.*), sema_call_resolved_type(value.ty, check.environment.*, check.program.*), args[index].expr, expr_span(args[index].expr), check.program.*))
                complete = false
                next
            }
        }
        // E3211: a written String literal with a NUL byte can never reach a
        // C-boundary `String` parameter intact, since C strings end at the
        // first NUL. The slot is the declaration slot the binder chose, so a
        // labeled call is checked against the parameter it actually reaches.
        if abi == .Val(callable_abi) {
            if callable_abi.is_c_abi && required == Type.String && sema_call_literal_has_nul(args[index].expr) {
                row: sema_diagnostic_row("E3211")
                check.diagnostics.push(sema_error("E3211", expr_span(args[index].expr), row.what, row.why, row.fix))
            }
        }
        // The ownership check that follows moves an
        // eligible unmarked take argument at its last use.
        ^noted_take: false
        if !report_conventions && decision == SemaCallConventionDecision.NeedsImplicitClone && !has_binder_refs && !default_in_owner {
            if sema_ownership_note_implicit_take(check.state, args[index].expr, value.ty, required, check.environment.*, check.program.*, check.context.generic_params, check.scopes) == .Val(key) {
                take_indices.push(index)
                take_keys.push(key)
                noted_take = true
            }
        }
        // Any other unmarked name a take parameter
        // receives is that parameter's take, as `name.move()` was. It moves out of
        // its owner here, so a later use reports the move into this call.
        if !noted_take && decision == SemaCallConventionDecision.NeedsImplicitClone && !has_binder_refs && !default_in_owner && !parameter.variadic && !sema_ownership_type_is_copy(value.ty) && !sema_ownership_type_is_copy(required) && !sema_ownership_argument_is_function_item(args[index], check.scopes) {
            args[index].convention = AccessConvention.Move
            if !sema_pin_check_move(check, args[index].expr) {
                complete = false
                next
            }
        }
        // A name or field the call takes (convention `Move`, an implicit take
        // or a generated take) passed to a consuming parameter is the
        // exact-place move, so the argument moves out of its owner (MovePlace,
        // clearing its drop flag) instead of reaching lowering as a bare read
        // that only a last-use proof turns into a move. A plain name noted as
        // the call's implicit take moves the same way: a call never copies on
        // its own. A read parameter or its field has no storage to give up:
        // E0201, never a silent copy. A write parameter's field keeps the
        // refill move the last-use pass proves.
        taken_convention: args[index].convention == AccessConvention.Move || noted_take
        consuming_mark: !default_in_owner && parameter.convention == AccessConvention.Move && !parameter.variadic && taken_convention && !sema_ownership_type_is_copy(value.ty)
        marked_place: consuming_mark && sema_call_marked_move_place(args[index].expr, value)
        // A bare `name.move()` of a read parameter is reported at the name by the
        // ownership check below, which names the consumer; a field place reports
        // at the mark.
        bare_name: args[index].expr == .Ident(_, _, _)
        if marked_place && !bare_name && sema_ownership_reject_read_param_move(check, args[index].expr) {
            return None
        }
        if marked_place && sema_copy_site_refuse_lent_resource_move(check, args[index].expr, value) {
            return None
        }
        ^taken_place: marked_place
        if taken_place && sema_ownership_binding_for_expr(check.state, args[index].expr, check.scopes) == .Val(root) {
            taken_place = !sema_ownership_binding_is_borrowed_param(root)
        }
        if taken_place && args[index].expr == .Field(_, _, _, _) {
            check.state.exact_field_takes.push(expr_span(args[index].expr))
        }
        stored: sema_call_marked_move_value(check, taken_place, args[index].expr, value) ?? return None
        values.push(stored)
        slots.push(slot)
        required_types.push(required)
        source_indices.push(args[index].flags.source_index ?? -1)
    }
    if !complete -> return None
    sema_call_crypto_misuse(callee, params, args, values, slots, check)
    sema_call_check_crossed_arguments(callee, params, binding, args, slots, required_types, check)
    // E2104: a C callback argument the compiler cannot hand to C itself (a
    // function value other than a named function or a lambda, or a tagged
    // callback parameter) is refused here, by a compile that lowers the call,
    // instead of stopping inside the IR. A checker error on the call stands
    // alone, and `jet check` (which lowers nothing) still reports only those.
    if c_callback == .Val(callback_span) && !module_is_core(check.environment.module_identity) && sema_refuses_unbuilt(check.program.*) && !sema_has_error_since(check.diagnostics, call_diagnostics_start) {
        check.diagnostics.push(sema_error("E2104", callback_span, "passing this function value to `{callee}` is not built yet", "This `jet` hands C a callback pointer only for a named function or a lambda written at the call, and no other `jet` can build this one.", "Pass the named function or a lambda directly as the callback argument."))
    }
    reference_starts.push(check.context.name_references.len())
    // A name two take slots of one call receive has no last use in either.
    loop position in 0..<take_indices.len() {
        ^twice: sema_call_key_named_elsewhere(take_keys[position], take_indices[position], reference_starts, check)
        loop earlier in 0..<position {
            if take_keys[earlier] == take_keys[position] -> twice = true
        }
        if twice {
            sema_ownership_note_implicit_take_twice(check.state, expr_span(args[take_indices[position]].expr))
        }
    }
    Val(SemaCallTypedArguments{values: values, slots: slots, required_types: required_types, source_indices: source_indices, pin_arguments: pin_arguments, binder_site: binder_site})
}

// Whether an argument of type `ty` implements variadic bound `bound`: as a
// trait value of that bound, or by the bound check generic calls use; None
// while that check cannot decide.
sema_call_variadic_bound_met: fn(bound: String, ty: Type, check: SemaBodyCheck) -> Bool? {
    if sema_call_type_assignable(Type.TraitObject{bounds: [String]{bound}}, ty, check) == (Val(true)) {
        return Val(true)
    }
    graph: check.program.registration_graph
    sema_type_bound_satisfied_with_generics(graph, ty, bound, check.environment.module_identity, check.environment.generic_params)
}

// E1313: an argument of a trait-bounded variadic `parameter` misses `bound`.
// `callee` may be an arity function, which reports as the function called.
sema_call_variadic_bound_unmet: fn(arg_name: String, parameter: String, bound: String, callee: String, span: Span) -> Diagnostic {
    shown: sema_error_conversion_leaf(bound)
    called: sema_variadic_bound_callee(callee)
    sema_error("E1313", span, "`{arg_name}` doesn't implement `{shown}`", "`{parameter}: ...{shown}` checks every argument against `{shown}` — that's how `{called}` accepts a mix of types safely", "implement `{shown}` for `{arg_name}`'s type, or drop the value from this call")
}

// The compiler-owned trait a parameter type names. Such a bound stays a
// named type after resolution, where a declared trait becomes a trait object.
sema_call_owned_trait_bound: fn(ty: Type) -> String? {
    if ty == .Named(name) && sema_type_builtin_trait_symbol(name) != None -> return Val(name.copy())
    None
}

// A fixed-shape Core route checks its own arguments. An unmarked bare name
// passed to one of its taking parameters still moves at its last use, as at
// an ordinary call; a name a later argument of the same call also references
// has no last use there. `values` are the checked arguments, in `args` order.
sema_call_note_route_implicit_takes: fn(params: [SemaCallParam], args: [CallArg], values: [TExpr], check: ^SemaBodyCheck) {
    loop index in 0..<args.len() {
        if index >= params.len() || index >= values.len() -> break
        if sema_call_argument_convention(params[index], args[index]) != SemaCallConventionDecision.NeedsImplicitClone {
            next
        }
        declared: params[index].ty ?? next
        required: sema_call_resolved_type(declared, check.environment.*, check.program.*)
        key: sema_ownership_note_implicit_take(check.state, args[index].expr, values[index].ty, required, check.environment.*, check.program.*, check.context.generic_params, check.scopes) ?? next
        ^twice: false
        target: sema_symbol_lookup(check, key)
        loop reference in check.context.name_references {
            if target != .Val(reference.symbol.id) -> next
            loop other in index + 1..<args.len() {
                other_span: expr_span(args[other].expr)
                if reference.span.start >= other_span.start && reference.span.end <= other_span.end {
                    twice = true
                }
            }
        }
        if twice {
            sema_ownership_note_implicit_take_twice(check.state, expr_span(args[index].expr))
        }
    }
}

// A string literal with no interpolation whose written text holds a NUL byte.
sema_call_literal_has_nul: fn(value: Expr) -> Bool Never! {
    if value == .Str(parts, _, _) {
        // Valid UTF-8: NUL is one ASCII byte, so the lossy decode keeps every byte.
        nul: String.from_bytes_lossy([U8{0}])
        ^found: false
        loop part in parts {
            if part == {
                .Lit(text) -> {
                    if text.contains(nul) -> found = true
                }
                .Interp(_, _) | .Byte(_) -> return false
            }
        }
        return found
    }
    false
}

// One registered E2702 bound: a parameter of a Core
// crypto operation and the values the operation accepts there
// (Core/Crypto/Crypto.jet, Expert.jet return CryptoError outside it).
// `bytes`: the bound is on a byte list's length, not on an Int.
SemaCryptoBound: struct {
    parameter: String,
    reason: DiagnosticCryptoMisuseReason,
    noun: String,
    bytes: Bool,
    low: Int,
    high: Int?,
}

sema_crypto_int: fn(parameter: String, reason: DiagnosticCryptoMisuseReason, noun: String, low: Int, high: Int?) -> SemaCryptoBound Never! {
    SemaCryptoBound{parameter: parameter, reason: reason, noun: noun, bytes: false, low: low, high: high}
}

sema_crypto_bytes: fn(parameter: String, reason: DiagnosticCryptoMisuseReason, noun: String, low: Int, high: Int) -> SemaCryptoBound Never! {
    SemaCryptoBound{parameter: parameter, reason: reason, noun: noun, bytes: true, low: low, high: Val(high)}
}

sema_crypto_bounds: fn(callee: String) -> [SemaCryptoBound] Never! {
    output: DiagnosticCryptoMisuseReason.OutputLength
    material: DiagnosticCryptoMisuseReason.InvalidLength
    nonce: DiagnosticCryptoMisuseReason.NonceLength
    if callee == {
        "core.crypto.hkdf_sha256" | "core.crypto.expert.hkdf_sha256_raw" -> [SemaCryptoBound]{sema_crypto_int("len", output, "output length", 0, Val(8160))}
        "core.crypto.pbkdf2_hmac" -> [SemaCryptoBound]{
            sema_crypto_int("iterations", DiagnosticCryptoMisuseReason.IterationCount, "iteration count", 1, None),
            sema_crypto_int("key_len", output, "key length", 1, Val(67108864)),
        }
        "core.crypto.expert.argon2id" -> [SemaCryptoBound]{
            sema_crypto_bytes("salt", DiagnosticCryptoMisuseReason.SaltLength, "salt", 8, 64),
            sema_crypto_int("memory_kib", DiagnosticCryptoMisuseReason.MemoryCost, "memory cost in KiB", 8192, Val(262144)),
            sema_crypto_int("iterations", DiagnosticCryptoMisuseReason.IterationCount, "iteration count", 1, Val(10)),
            sema_crypto_int("lanes", DiagnosticCryptoMisuseReason.LaneCount, "lane count", 1, Val(8)),
            sema_crypto_int("output_len", output, "output length", 16, Val(64)),
        }
        "core.crypto.expert.xchacha20poly1305_seal" | "core.crypto.expert.xchacha20poly1305_open" -> [SemaCryptoBound]{
            sema_crypto_bytes("key", material, "key", 32, 32),
            sema_crypto_bytes("nonce", nonce, "nonce", 24, 24),
        }
        "core.crypto.expert.aes256gcm_seal" | "core.crypto.expert.aes256gcm_open" -> [SemaCryptoBound]{
            sema_crypto_bytes("key", material, "key", 32, 32),
            sema_crypto_bytes("nonce", nonce, "nonce", 12, 12),
        }
        "core.crypto.expert.ed25519_sign" -> [SemaCryptoBound]{sema_crypto_bytes("secret", material, "secret key", 32, 32)}
        "core.crypto.expert.ed25519_verify_strict" -> [SemaCryptoBound]{
            sema_crypto_bytes("public", material, "public key", 32, 32),
            sema_crypto_bytes("signature", material, "signature", 64, 64),
        }
        "core.crypto.expert.x25519_raw" -> [SemaCryptoBound]{
            sema_crypto_bytes("secret_bytes", material, "secret key", 32, 32),
            sema_crypto_bytes("public_bytes", material, "public key", 32, 32),
        }
        else -> [SemaCryptoBound]{}
    }
}

// The compiler-known length of a byte-list argument: a written list literal
// without spreads, or a value of a fixed-length list type.
sema_crypto_known_length: fn(value: Expr, ty: Type) -> Int? Never! {
    if value == .ListLit(elements, _, _) {
        loop element in elements {
            if element == .Spread(_, _, _) -> return None
        }
        return Val(elements.len())
    }
    if ty == .FixedList(_, length) {
        if length == .Literal(_, count) -> return Val(count)
    }
    None
}

sema_crypto_misuse: fn(operation: String, bound: SemaCryptoBound, expected: String, actual: Int, span: Span) -> Diagnostic Never! {
    unit: if !bound.bytes -> "" else if actual == 1 -> " byte" else -> " bytes"
    over: if bound.bytes -> " bytes" else -> ""
    article: if bound.noun.starts_with("i") || bound.noun.starts_with("o") -> "an" else -> "a"
    ^diagnostic: sema_error("E2702", span, "Crypto API misuse", "the {bound.noun} is {actual}{unit}, and `{operation}` takes {expected}{over}, so the call can only fail", "Replace the offending cryptographic argument with the concrete value or bound named in the diagnostic: pass {article} {bound.noun} of {expected}{over}")
    diagnostic.structured = Val(DiagnosticStructured.CryptoMisuse{reason: bound.reason, operation: operation, expected: Val(expected), actual: Val(actual)})
    diagnostic
}

// E2702: a call whose compiler-known argument is outside the bound its Core
// crypto operation documents (sema_crypto_bounds) can only fail. It reads the
// checked call, so an argument's own type error comes first, and a raw
// `core.crypto.expert` call outside `#Unsafe` is its E0510 alone. A value only
// known at run time is the operation's to check. The call stays checked, so
// the effect solve still reads its arguments; its implicit propagation is not
// reported again (sema_crypto_misused_call), and an error of any earlier
// check drops every E2702 (sema_crypto_misuse_precedence).
sema_call_crypto_misuse: fn(callee: String, params: [SemaCallParam], args: [CallArg], values: [TExpr], slots: [Int], check: ^SemaBodyCheck) Never! {
    if !callee.starts_with("core.crypto.") {
        return
    }
    bounds: sema_crypto_bounds(callee)
    if bounds.len() == 0 {
        return
    }
    if callee.starts_with("core.crypto.expert.") && check.context.unsafe_depth == 0 {
        return
    }
    parts: callee.split(".").to_list()
    operation: parts[parts.len() - 1]
    ^memory: Int?{None}
    ^iterations: Int?{None}
    ^memory_span: Span?{None}
    ^refused: false
    loop bound in bounds {
        index: sema_crypto_argument_index(params, slots, bound.parameter) ?? next
        known: if bound.bytes -> sema_crypto_known_length(args[index].expr, values[index].ty) else -> sema_call_compute_literal_int(args[index].expr)
        actual: known ?? next
        if bound.parameter == "memory_kib" {
            memory = Val(actual)
            memory_span = Val(expr_span(args[index].expr))
        }
        if bound.parameter == "iterations" -> iterations = Val(actual)
        ^expected: "at least {bound.low}"
        if bound.high == .Val(high) {
            if actual >= bound.low && actual <= high -> next
            expected = if bound.low == high -> "exactly {high}" else -> "{bound.low}..{high}"
        } else if actual >= bound.low { next }
        check.diagnostics.push(sema_crypto_misuse(operation, bound, expected, actual, expr_span(args[index].expr)))
        refused = true
    }
    if refused || callee != "core.crypto.expert.argon2id" {
        return
    }
    // Argon2id's joint work bound (spec.md, the expert surface): memory cost
    // × iterations of at most 1048576, each within its own bound above.
    if memory == .Val(kib) && iterations == .Val(passes) && memory_span == .Val(at) && kib * passes > 1048576 {
        work: sema_crypto_int("memory_kib", DiagnosticCryptoMisuseReason.MemoryTimeCost, "memory cost × iterations", 0, Val(1048576))
        check.diagnostics.push(sema_crypto_misuse(operation, work, "at most 1048576", kib * passes, at))
    }
}

// Whether the call `source` already has its E2702 among `diagnostics`.
sema_crypto_misused_call: fn(source: Expr?, diagnostics: [Diagnostic]) -> Bool Never! {
    call: source ?? return false
    span: expr_span(call)
    loop diagnostic in diagnostics {
        if diagnostic.code != "E2702" -> next
        if diagnostic.span == .Val(at) {
            if at.start >= span.start && at.end <= span.end -> return true
        }
    }
    false
}

// Precedence: E2702 is considered only once syntax, types,
// effects and every other check pass, so any other error drops each E2702.
sema_crypto_misuse_precedence: fn(diagnostics: ^[Diagnostic]) Never! {
    ^misused: false
    ^other: false
    loop diagnostic in diagnostics {
        if diagnostic.code == "E2702" -> misused = true else if diagnostic.severity == DIAGNOSTIC_ERROR {
            other = true
        }
    }
    if !misused || !other {
        return
    }
    // Each E2702 leaves in place, from the back, so the rest are never copied.
    ^index: diagnostics.len()
    loop index > 0 {
        index -= 1
        if diagnostics[index].code == "E2702" -> ^_: diagnostics.remove(index, .Slot)
    }
}

sema_crypto_argument_index: fn(params: [SemaCallParam], slots: [Int], parameter: String) -> Int? Never! {
    loop index in 0..<slots.len() {
        if params[slots[index]].name == parameter -> return Val(index)
    }
    None
}

// An argument that does not fit its parameter is E0112 about the call, after a
// checked typed-text rejection. A parameter written as a generic alias is named
// as written (`required_alias`, from sema_call_alias_shown), with its
// expansion.
sema_call_argument_mismatch: fn(callee: String, index: Int, required: Type, required_alias: String?, offered: Type, value: Expr, span: Span, program: SemaProgramTables) -> Diagnostic {
    // ("core.mem", "volatile_read" | "volatile_write"): the pointer argument is
    // not a typed pointer, or the written value is not the pointer's element
    // type.
    if callee == "core.mem.volatile_read" || callee == "core.mem.volatile_write" {
        operation: sema_call_reflection_leaf_name(callee)
        if index == 0 {
            why: if operation == "volatile_read" -> "a volatile read reads through a typed pointer" else -> "a volatile write writes through a typed pointer"
            return sema_error("E0112", span, "`{operation}` needs a `Ptr<T>`, not {sema_type_show(offered)}", why, "build a pointer first with `mem.Ptr<T>.from_addr(addr)`")
        }
        return sema_error("E0112", span, "`{operation}` writes a {sema_type_show(required)} through this pointer, but the value is {sema_type_show(offered)}", "a volatile write stores a value of the pointer's element type", "write a `{type_name(required)}` value")
    }
    if sema_nested_fn_failure_mismatch(required, offered, span) == .Val(nested_fn) {
        return nested_fn
    }
    if sema_typed_text_mismatch(required, offered, span, program) == .Val(typed_text) {
        return typed_text
    }
    if sema_plain_carrier_mismatch(required, offered, span) == .Val(carrier) -> return carrier
    if sema_trait_value_unimplemented(required, offered, span) == .Val(unimplemented) {
        return unimplemented
    }
    leaf: sema_call_reflection_leaf_name(callee)
    fix: if (leaf == "write" || leaf == "write_line") && required == Type.String && offered == (Type.List{element: Type.IntN{signed: false, bits: 8}}) -> "`{leaf}` takes text; write bytes with `write_bytes(bytes)`" else -> sema_call_argument_fix_hint(required, offered, value)
    sema_error("E0112", span, "`{leaf}` wants {required_alias ?? sema_type_show(required)} for argument {index + 1}, but this is {sema_type_show(offered)}", "every argument must match its parameter's type", fix)
}

// A Decimal argument to a Float parameter is taught on the argument as
// written: its literal as a Float, or its binding converted.
sema_call_argument_fix_hint: fn(required: Type, offered: Type, value: Expr) -> String Never! {
    if required == Type.Float && sema_type_nominal_leaf(offered) == "Decimal" {
        if value == {
            .Float(_, _, _, raw, _) -> {
                if raw == .Val(text) {
                    return "write the literal as Float{{{text}}}, or keep Decimal on both sides"
                }
            }
            .Ident(name, _, _) -> return "convert it with `{name}.to_float()`, or keep Decimal on both sides"
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
        }
    }
    sema_type_fix_hint(required, offered)
}

// A parameter type that names nothing already has its E0119 where the
// declaration wrote it, and one that writes a generic type bare its E0104
// (sema_type_bare_generic_names); an argument's mismatch against it is that
// same error again (#6294).
sema_call_parameter_type_undeclared: fn(required: Type, check: SemaBodyCheck) -> Bool {
    generic_names: loop param in check.environment.generic_params -> param.name
    graph: check.program.registration_graph
    caller: sema_scope_caller_row(check.environment.*, graph)
    sema_type_names_undeclared(graph, caller, required, generic_names) || sema_type_names_bare_generic(graph, caller, required, generic_names)
}

// Drops the generic E0108 the argument's own check reported against an
// undeclared parameter type, keeping every other report of the argument.
sema_call_argument_drop_mismatch: fn(value: Expr, diagnostic_start: Int, diagnostics: ^[Diagnostic]) {
    mismatch_index: sema_value_mismatch_index(diagnostics, diagnostic_start, expr_span(value)) ?? return
    loop index in mismatch_index..<diagnostics.len() - 1 {
        diagnostics[index] = diagnostics[index + 1]
    }
    _: diagnostics.pop()
}

// The argument's own check rejected it against its parameter with the generic
// E0108 at the value (for an expression-bodied lambda, at its body); that
// report becomes the call's E0112, with the value's own type inferred without
// the parameter as a target. A lambda value is probed under the parameter's
// escape policy, so its capture facts match.
sema_call_argument_replace_mismatch: fn(callee: String, index: Int, required: Type, required_alias: String?, value: Expr, lambda_escapes: Bool?, diagnostic_start: Int, check: ^SemaBodyCheck) {
    value_span: expr_span(value)
    ^found: sema_value_mismatch_index(check.diagnostics, diagnostic_start, value_span)
    if found == None && value == .Lambda(body_lambda, _) && ast_lambda_single_expr_span(body_lambda.body) == .Val(body_span) {
        found = sema_value_mismatch_index(check.diagnostics, diagnostic_start, body_span)
    }
    mismatch_index: found ?? return
    ^probe_diagnostics: [Diagnostic]{}
    ^previous_lambda_escapes: check.context.lambda_escapes
    check.context.lambda_escapes = lambda_escapes
    probed: sema_probe_expression(value, None, check, probe_diagnostics)
    check.context.lambda_escapes = previous_lambda_escapes
    offered: probed ?? return
    ^offered_ty: sema_call_resolved_type(offered.ty, check.environment.*, check.program.*)
    // A lambda checked against a callable keeps its plain return; the probe
    // above had no target and gave it the total `Never!` carrier, which the
    // argument never had.
    if value == .Lambda(_, _) && offered_ty == .Fn(lambda_params, lambda_ret, lambda_effects, lambda_contract, lambda_metadata, lambda_views) && lambda_ret == .Val(.Result(plain_ret, .Named(never_name))) && never_name == "Never" {
        offered_ty = Type.Fn{params: lambda_params, ret: Val(plain_ret), effect_bound: lambda_effects, param_contract: lambda_contract, call_metadata: lambda_metadata, return_view_provenance: lambda_views}
    }
    // The call still checks a lambda argument's captures against its other
    // arguments; the probe's checked lambda supplies them.
    if value == .Lambda(probed_ast, _) && offered.kind == .Lambda(probed_lambda) {
        sema_ownership_note_lambda_facts(check.state, probed_ast.span, probed_lambda.capture_facts)
    }
    // A lambda's span ends where its expression body's span ends (a call's
    // span is its name).
    ^shown_span: value_span
    if value == .Lambda(shown_lambda, _) && ast_lambda_single_expr_span(shown_lambda.body) == .Val(shown_body_span) {
        shown_span = Span{start: value_span.start, end: shown_body_span.end}
    }
    check.diagnostics[mismatch_index] = sema_call_argument_mismatch(callee, index, required, required_alias, offered_ty, value, shown_span, check.program.*)
}

// Whether an argument after `own` references the binding `key`: arguments
// run in order, so an earlier one has read the name before the take.
// `starts` holds each argument's first name reference and the end.
sema_call_key_named_elsewhere: fn(key: String, own: Int, starts: [Int], check: SemaBodyCheck) -> Bool Never! {
    target: sema_symbol_lookup(check, key) ?? return false
    loop other in own + 1..<starts.len() - 1 {
        loop index in starts[other]..<starts[other + 1] {
            if index < check.context.name_references.len() && check.context.name_references[index].symbol.id == target {
                return true
            }
        }
    }
    false
}

sema_call_binder_ref_symbol: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, context: ^SemaCheckContext, owner: String, site: Int, slot: Int, name: String, ty: Type, span: Span) -> Symbol Never! {
    local_module: sema_scope_environment_module_text(environment, program)
    id: sema_symbol_id(program, context, SymbolKind.Local, local_module, owner, "binder_ref_{site}_{slot}")
    Symbol{id: id, kind: SymbolKind.Local, name: name, module_identity: environment.module_identity, owner: Val(owner), span: span, ty: Val(ty), visibility: 0}
}

// Opens the default's own frame with each earlier parameter bound to its slot
// temporary; the caller leaves it after checking the default. A placeholder
// enters ownership only when the default reads it, so an unread one is no
// unused binding. Each placeholder is declared at the default's first source
// byte, so every read in it follows the declaration: a method chain or index
// (`values.len()`, `values[0]`) is spanned after its base (jfmt_expr_start).
sema_call_enter_binder_refs: fn(refs: [BinderRef], site: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, state: ^SemaOwnershipState, context: ^SemaCheckContext, default_expr: Expr) -> [SymbolID] Never! {
    span: Span{start: jfmt_expr_start(default_expr), end: expr_span(default_expr).end}
    owner: sema_scope_function_owner_key(scopes)
    ^_: sema_scope_enter(scopes, state, owner)
    ids: loop reference in refs -> {
        symbol: sema_call_binder_ref_symbol(environment, program, context, owner, site, reference.slot, reference.name, reference.ty, span)
        ^_: sema_scope_declare_local(scopes, symbol, sema_symbol_key(program, context, symbol.id), false, AccessConvention.Read, None, false)
        symbol.id
    }
    ids
}

sema_call_binder_refs_read: fn(ids: [SymbolID], start: Int, context: SemaCheckContext) -> Bool Never! {
    loop index in start..<context.name_references.len() {
        if ids.contains(context.name_references[index].symbol.id) -> return true
    }
    false
}

// A `Type{#run value}` default this call computes while building. The
// earlier parameters' binder slots, open in the scope, hold the values the
// build knows of their checked arguments, and a function-typed one holds the
// FunctionInfo of the function its argument names or writes, which the
// default reads as `name.reflect()`. A slot whose argument is known only when
// the program runs stays a run-time local, which the staged check refuses
// (E0640). The one staged-value evaluator computes the default once per
// call: the first check stages it, the checked default stands in until the
// value lands, and the check after reads the value.
sema_call_run_default: fn(argument: CallArg, values: [TExpr], slots: [Int], binder_keys: [SymbolID], args: [CallArg], binding: SemaCallBinding, expected: Type?, check: ^SemaBodyCheck, call_span: Span) -> TExpr? {
    owner_key: sema_expr_runtime_body_owner(check) ?? return sema_check_expression(argument.expr, expected, check)
    loop (ref_index, reference) in argument.flags.binder_refs {
        if ref_index >= binder_keys.len() -> break
        loop value_index in 0..<values.len() {
            if slots[value_index] != reference.slot -> next
            known: sema_expr_comptime_value(values[value_index], check.context) ?? sema_fact_constant_path_value(values[value_index], check.context) ?? sema_call_run_default_function(values[value_index].ty, reference.slot, args, binding, check) ?? break
            loop binding_index in 0..<check.scopes.bindings.len() {
                if check.scopes.bindings[binding_index].symbol.id == binder_keys[ref_index] {
                    sema_scope_note_binding_edit(check.scopes, binding_index)
                    check.scopes.bindings[binding_index].prepared = Val(known)
                }
            }
            break
        }
    }
    fact_start: check.context.call_facts.len()
    check.scopes.comptime_execution_depth += 1
    checked: sema_check_expression(argument.expr, expected, check)
    check.scopes.comptime_execution_depth -= 1
    typed: checked ?? return None
    if sema_stmt_comptime_site_refused(check, fact_start) -> return None
    source_span: expr_span(argument.expr)
    landed: sema_comptime_body_value_find(check.context, check.environment.module_identity, owner_key, source_span, call_span) ?? {
        ^_: sema_comptime_body_capture(check.context, check.environment.*, check.program.*, check.scopes, "default", argument.expr, typed.ty, source_span, call_span)
        // The checked default stands in until the value lands; nothing lowers it.
        return Val(typed)
    }
    value: sema_fact_prepared_expr(landed.value, landed.ty, call_span, check.environment.*, check.program.*, check.context) ?? return None
    sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// The FunctionInfo of the function the argument bound to `slot`, of the
// function type `ty`, names or writes (sema_rule_function_of). None for an
// argument of another type, or one that is neither a declared function nor a
// lambda.
sema_call_run_default_function: fn(ty: Type, slot: Int, args: [CallArg], binding: SemaCallBinding, check: ^SemaBodyCheck) -> TComptimeValue? {
    if ty == .Fn(_, _, _, _, _, _) {
        loop index in 0..<args.len() {
            if sema_call_bound_slot(binding, binding.sources[index], args[index]) != slot -> next
            function: sema_rule_function_of(args[index].expr, ty, args[index].span, check) ?? return None
            return Val(function.info)
        }
    }
    None
}

// Whether the written argument `argument`, for a parameter whose default is
// `reference`, is refused: that default is a `#run` one, and the argument is
// not the name of a parameter of the function being checked whose own
// default is a `#run` default of the same source text.
sema_call_run_default_refused: fn(argument: Expr, reference: FunctionDefaultRef, check: SemaBodyCheck) -> Bool Never! {
    graph: check.program.registration_graph
    callee: sema_registration_resolve_default(graph, reference) ?? return false
    if !callee.run -> return false
    if argument == .Ident(name, _, _) {
        index: sema_scope_resolve_index(check.scopes, name) ?? return true
        if check.scopes.bindings[index].symbol.kind != SymbolKind.Parameter -> return true
        own: sema_call_own_run_default(graph, sema_scope_function_owner_key(check.scopes), name) ?? return true
        written: sema_call_default_ref_text(check.program.*, reference) ?? return true
        return sema_call_default_ref_text(check.program.*, own) != Val(written)
    }
    true
}

// The default of the `#run`-defaulted parameter `name` of the callable keyed
// `owner_key`. None when it has no such parameter.
sema_call_own_run_default: fn(graph: SemaRegistrationGraph, owner_key: String, name: String) -> FunctionDefaultRef? {
    row: sema_registration_callable_row(graph, owner_key) ?? return None
    if row == {
        .Function(module_index, index) -> sema_call_run_default_named(graph.modules[module_index].functions[index].parameters, name)
        .NominalMethod(module_index, owner, index) -> sema_call_run_default_named(graph.modules[module_index].nominals[owner].methods[index].parameters, name)
        .ImplMethod(module_index, owner, index) -> sema_call_run_default_named(graph.modules[module_index].impls[owner].methods[index].parameters, name)
        .Foreign(_, _) -> None
    }
}

sema_call_run_default_named: fn(parameters: [SemaRegistrationParameter], name: String) -> FunctionDefaultRef? {
    loop parameter in parameters {
        if parameter.name == name && parameter.default_run -> return parameter.default_ref
    }
    None
}

// The source text of the default `reference` names, in its declaring module.
sema_call_default_ref_text: fn(program: SemaProgramTables, reference: FunctionDefaultRef) -> String? {
    graph: program.registration_graph
    module_index: sema_registration_module_index(graph, sema_call_default_ref_module(program, reference) ?? return None) ?? return None
    sema_stmt_source_text(graph.modules[module_index].source.bytes(), reference.span)
}

// The declaring module's scope for a default argument this call takes, when
// the default is written in another module (sema_default_owner_scope).
sema_call_default_owner_scope: fn(source: SemaCallArgSource, parameter: SemaCallParam, expression: Expr, check: SemaBodyCheck) -> SemaDefaultOwnerScope? {
    if source == {
        .Default(_) -> {}
        .Written(_) -> return None
    }
    reference: parameter.default_ref ?? return None
    owner_module: sema_call_default_ref_module(check.program.*, reference) ?? return None
    sema_default_owner_scope(check, owner_module, expression)
}

// The module that declares the callable a default belongs to.
sema_call_default_ref_module: fn(program: SemaProgramTables, reference: FunctionDefaultRef) -> ModuleID? {
    graph: program.registration_graph
    row: sema_registration_callable_row(graph, reference.owner_key) ?? return None
    module_index: if row == {
        .Function(index, _) | .Foreign(index, _) -> index
        .NominalMethod(index, _, _) | .ImplMethod(index, _, _) -> index
    }
    Val(graph.modules[module_index].module_identity)
}

// A default argument written in another module, checked in that module's
// names and on the owner scope's ownership state, which takes the record's
// place for the check. Its binder slots key under the calling function and
// module, as sema_call_pin_binder_arguments reads them; a problem it reports
// is anchored at the call.
sema_call_check_owner_default: fn(owner_scope: ^^SemaDefaultOwnerScope?, argument: CallArg, expected: Type?, parameter: SemaCallParam, abi: SemaRegistrationCallableABI?, apply_lambda_escape_override: Bool, check: ^SemaBodyCheck, call_span: Span, binder_keys: ^[SymbolID]) -> TExpr? {
    ^scope: owner_scope.move() ?? return None
    if argument.flags.binder_refs.len() > 0 {
        binder_keys = sema_call_enter_binder_refs(argument.flags.binder_refs, argument.flags.binder_site ?? call_span.start, check.environment.*, check.program.*, scope.scopes, scope.state, check.context, argument.expr)
    }
    // The default checks on a record of its own, linked to the owner
    // module's environment and holding the owner scope's state and table,
    // lent this record's context and tail store for the check.
    ^owner_check: sema_body_check_init(check.program, @scope.environment)
    sema_body_check_swap_state(owner_check, scope.state)
    sema_body_check_swap_scopes(owner_check, scope.scopes)
    sema_body_check_swap_context(owner_check, check.context)
    sema_body_check_swap_tail_store(owner_check, check.tail_store)
    checked: if apply_lambda_escape_override -> sema_check_expression_with_lambda_escapes(argument.expr, expected, owner_check, sema_call_lambda_escape_policy(parameter, abi)) else -> sema_check_expression(argument.expr, expected, owner_check)
    sema_body_check_swap_tail_store(owner_check, check.tail_store)
    sema_body_check_swap_context(owner_check, check.context)
    loop diagnostic in owner_check.diagnostics {
        check.diagnostics.push(sema_default_use_site_diagnostic(diagnostic, call_span))
    }
    checked
}

// Declaration-order grouping must not reorder written expressions. Pin raw
// supplied arguments in written order, then defaults in declaration order,
// so binder references read the already-passed values. Methods and Fn calls
// pin their receiver/callee first; this helper owns only argument pins.
// Borrowed places are pinned as borrows, fresh values retain an owned pin.
sema_call_pin_binder_arguments: fn(typed: SemaCallTypedArguments, params: [SemaCallParam], lowered: ^[TCallArg], check: ^SemaBodyCheck, span: Span) -> [TStmt] Never! {
    ^bindings: [TStmt]{}
    if !typed.pin_arguments -> return bindings
    owner: sema_scope_function_owner_key(check.scopes)
    ^order: [Int]{}
    loop written in 0..<typed.source_indices.len() {
        loop index in 0..<typed.source_indices.len() {
            if typed.source_indices[index] == written -> order.push(index)
        }
    }
    loop index in 0..<typed.source_indices.len() {
        if typed.source_indices[index] < 0 -> order.push(index)
    }
    loop index in order {
        slot: typed.slots[index]
        // Each written rest argument must be evaluated before grouping the
        // tail. Its private pin cannot shadow a declaration-slot default.
        ^pin_slot: slot
        if params[slot].variadic -> pin_slot = -index - 1
        original: lowered[index].value
        ^init: original.copy()
        place_value: if init.kind == {
            .Local(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Deref(_) | .Borrow(_, _) -> true
            .IntLit(_, _) | .StrLit(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .RawAddressOf(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> false
        }
        borrowed: (lowered[index].borrow || lowered[index].mut_borrow) && place_value
        if borrowed {
            access: if lowered[index].mut_borrow -> AccessConvention.Write else -> AccessConvention.Read
            init = sema_tree_node(original.ty, TExprKind.Borrow{place: init, access: access}, original.span)
        }
        symbol: sema_call_binder_ref_symbol(check.environment.*, check.program.*, check.context, owner, typed.binder_site, pin_slot, params[slot].name, original.ty, span)
        ^local: checked_symbol_local("binder_ref_{typed.binder_site}_{pin_slot}", span, symbol.id, original.ty)
        local.generated = true
        local.mutable = lowered[index].mut_borrow
        local.deref = borrowed
        local_value: sema_tree_node(original.ty, TExprKind.Local{local: local}, original.span)
        moves_pin: params[slot].convention == AccessConvention.Move || (params[slot].variadic && !lowered[index].spread)
        lowered[index].value = if moves_pin -> sema_tree_node(original.ty, TExprKind.Move{value: local_value}, original.span) else -> local_value
        bindings.push(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: init, gc_promotion: None, gc_transferred: false, span: span})
    }
    bindings
}

// Places the binder pins before the call they feed.
sema_call_with_binder_pins: fn(pins: ^^[TStmt], call_value: ^^TExpr, span: Span) -> TExpr Never! {
    if pins.len() == 0 -> return call_value
    ty: call_value.ty
    ^body: pins
    body.push(TStmt.ExprStmt{value: call_value, span: span})
    sema_tree_node(ty, TExprKind.InlineBlock{body: body}, span)
}

// The place a taken call argument moves exactly: a field read, or a
// whole non-Copy local named by itself (a Copy value simply copies).
sema_call_marked_move_place: fn(expr: Expr, value: TExpr) -> Bool Never! {
    if expr == {
        .Field(_, _, _, _) -> true
        .Ident(_, _, _) -> value.kind == .Local(_) && !sema_ownership_type_is_copy(value.ty)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// The stored value of a consuming argument: a taken exact place
// (`taken`) is a checked move, and the move of a match payload binding takes
// the payload out of its subject (sema_ownership_move_pattern_payload).
// None when the move is rejected.
sema_call_marked_move_value: fn(check: ^SemaBodyCheck, taken: Bool, expr: Expr, value: ^^TExpr) -> TExpr? {
    if !taken -> return Val(value.move())
    start: sema_ownership_place_root_start(expr) ?? expr_span(expr).start
    payload: sema_ownership_move_pattern_payload(check, expr, Span{start: start, end: expr_span(expr).end})
    if payload < 0 -> return None
    moved: if payload > 0 -> sema_expression_payload_take(value) else -> value.move()
    Val(sema_tree_node(moved.ty, TExprKind.Move{value: moved}, moved.span))
}

sema_call_widen_union: fn(required: Type, offered: Type) -> Type? {
    if required == .Union(members) {
        loop member in members {
            if type_identity_equal(member, offered) -> return Val(required)
        }
    }
    None
}

sema_call_lower_bound_arguments: fn(typed: SemaCallTypedArguments, params: [SemaCallParam], args: [CallArg], check: SemaBodyCheck) -> [TCallArg] Never! {
    ^lowered: [TCallArg]{}
    loop index in 0..<typed.values.len() {
        value: typed.values[index]
        arg: args[index]
        param: params[typed.slots[index]]
        required: if index < typed.required_types.len() -> typed.required_types[index] else -> sema_call_resolved_type(sema_call_argument_parameter_type(param, arg) ?? value.ty, check.environment.*, check.program.*)
        widen_to_vec: if required == {
            .List(_) -> if value.ty == {
                .FixedList(_, _) -> true
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
            }
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
        }
        widen_to_union: sema_call_widen_union(required, value.ty)
        lowered.push(
            TCallArg{
                value: value.copy(),
                template_items: [SymbolID]{},
                borrow: param.convention == AccessConvention.Read && !sema_call_is_scalar(value.ty),
                mut_borrow: param.convention == AccessConvention.Write,
                fn_coerce: None,
                widen_to_vec: widen_to_vec,
                widen_to_union: widen_to_union,
                box_as_trait: sema_call_box_as_trait(required, value.ty, check),
                label: arg.label.map(fn(label) { label.name }),
                spread: arg.spread,
            },
        )
    }
    lowered
}

// Normalize the checked rest slot once, before publishing the checked tree. BuildList
// owns scalar elements; ListSpread clones spread elements through the same
// checked Clone/effect mechanism as a written list literal.
sema_call_prepare_variadic_elements: fn(typed: SemaCallTypedArguments, params: [SemaCallParam], args: [CallArg], lowered: ^[TCallArg], check: ^SemaBodyCheck) -> Bool {
    loop index in 0..<lowered.len() {
        slot: typed.slots[index]
        if !params[slot].variadic -> next
        // copy: the variadic element value is rewrapped and written back into lowered[index] below.
        // Jet has no exchange on an element of the write-borrowed `lowered`.
        ^value: lowered[index].value.copy()
        if lowered[index].widen_to_vec {
            // The boundary copy itself clones the fixed list's elements.
            // Do not first clone the array and then clone that copy again.
            if !sema_expression_list_check_clone(value.ty, value.span, check) -> return false
            if args[index].convention == AccessConvention.Move {
                value = sema_tree_node(value.ty, TExprKind.Move{value: value}, value.span)
            }
            value = sema_tree_node(typed.required_types[index], TExprKind.MaterializeView{value: value}, value.span)
        } else if args[index].convention == AccessConvention.Move {
            value = sema_tree_node(value.ty, TExprKind.Move{value: value}, value.span)
        } else if lowered[index].spread {
            // A lone spread is a direct List borrow; mixed spread cloning is
            // judged below on the canonical ListSpread, not on its List root.
            next
        } else if sema_ownership_binding_is_expiring_secret_loan(check, args[index].expr) {
            // A rest slot owns its elements, so collecting an ExpiringSecret
            // loan moves it, which its callback refuses; nothing moves and
            // the call still checks.
            if args[index].expr == .Ident(name, name_span, _) {
                check.diagnostics.push(sema_ownership_diag_expiring_secret_loan_change(name, "be moved", name_span))
            }
        } else if !sema_ownership_type_is_copy(value.ty) {
            places: sema_ownership_places_from_expr_in_state(args[index].expr, check.scopes, check.state)
            ^borrowed: false
            loop place in places {
                loop binding in check.scopes.bindings {
                    if binding.symbol.id == place.root_id && sema_ownership_binding_is_borrowed_param(binding) {
                        borrowed = true
                    }
                }
            }
            copies_place: places.len() > 0 && (borrowed || !sema_ownership_unmarked_moves_name(args[index].expr) || sema_ownership_is_share_site(check.state, args[index].span))
            if copies_place {
                if !sema_expression_list_check_clone(value.ty, value.span, check) -> return false
                fact: sema_copy_hidden_fact_of(value.ty, CopyFact.Materialize, check, check.context.generic_params)
                value = sema_tree_node(value.ty, TExprKind.Clone{value: value, fact: fact}, value.span)
            } else {
                if !sema_ownership_mark_unmarked_move(check.state, args[index].expr, check.scopes, "the variadic list", check.diagnostics) {
                    return false
                }
                value = sema_tree_node(value.ty, TExprKind.Move{value: value}, value.span)
            }
        }
        lowered[index].value = value.move()
        lowered[index].borrow = false
        lowered[index].mut_borrow = false
        lowered[index].widen_to_vec = false
    }
    true
}

sema_call_pack_variadic_arguments: fn(typed: SemaCallTypedArguments, params: [SemaCallParam], lowered: [TCallArg], check: ^SemaBodyCheck, span: Span) -> [TCallArg]? {
    ^packed: [TCallArg]{}
    loop slot in 0..<params.len() {
        if !params[slot].variadic {
            loop index in 0..<lowered.len() {
                if typed.slots[index] == slot -> packed.push(lowered[index])
            }
            next
        }
        declared: params[slot].ty ?? {
            check.context.incomplete_reasons.push("checked variadic parameter has no type")
            return None
        }
        list_ty: sema_call_resolved_type(declared, check.environment.*, check.program.*)
        element: if list_ty == {
            .List(inner) -> inner
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
                check.context.incomplete_reasons.push("checked variadic parameter is not a List")
                return None
            }
        }
        tail: loop index in 0..<lowered.len() if typed.slots[index] == slot -> lowered[index]
        if tail.len() == 1 && tail[0].spread {
            ^argument: tail[0]
            argument.spread = false
            packed.push(argument)
            next
        }
        has_spread: loop argument in tail {
            if argument.spread {
                break true
            }
        } ?? false
        ^kind: TExprKind.List{values: [TExpr]{}, trait_coercion: None}
        if has_spread {
            if !sema_expression_list_check_clone(element, span, check) -> return None
            ^parts: [TListSpreadPart]{}
            loop argument in tail {
                if argument.spread -> parts.push(TListSpreadPart.Spread{value: argument.value}) else {
                    parts.push(TListSpreadPart.Element{value: argument.value})
                }
            }
            kind = TExprKind.ListSpread{parts: parts.move()}
        } else {
            ^values: [TExpr]{}
            loop argument in tail -> values.push(argument.value)
            kind = TExprKind.List{values: values.move(), trait_coercion: None}
        }
        value: sema_tree_node(list_ty, kind.move(), span)
        packed.push(
            TCallArg{
                value: value.move(),
                template_items: [SymbolID]{},
                borrow: params[slot].convention == AccessConvention.Read,
                mut_borrow: params[slot].convention == AccessConvention.Write,
                fn_coerce: None,
                widen_to_vec: false,
                widen_to_union: None,
                box_as_trait: None,
                label: Val(params[slot].label),
                spread: false,
            },
        )
    }
    Val(packed.move())
}

// This path runs Ownership after expression typing and before lowering, so
// lowering happens only after the ownership check accepts and completes.
// Return the lowered arguments together with the declaration-slot
// temporaries placed before the call.
sema_call_check_bound_arguments_owned: fn(check: ^SemaBodyCheck, callee: String, params: [SemaCallParam], abi: SemaRegistrationCallableABI?, apply_lambda_escape_override: Bool, binding: SemaCallBinding, args: ^[CallArg], span: Span) -> {lowered: [TCallArg], pins: [TStmt]}? {
    typing_start: check.diagnostics.len()
    typed: sema_call_typecheck_bound_arguments(callee, params, abi, apply_lambda_escape_override, binding, args, check, span, false) ?? {
        // A mismatched argument type is reported and the call's argument
        // accesses are still checked (a lambda argument's captures against the
        // other arguments). The arguments are inferred in order, each one's
        // access conflicts before its own mismatch.
        if sema_call_only_argument_mismatches(check.diagnostics, typing_start) {
            mismatches: loop index in typing_start..<check.diagnostics.len() -> check.diagnostics[index]
            loop check.diagnostics.len() > typing_start -> ^_: check.diagnostics.pop()
            ^accesses: [Diagnostic]{}
            ^_: sema_ownership_check_call_arguments(check.state, callee, params, args, check.scopes, accesses)
            loop position in 0..args.len() {
                loop access in accesses {
                    if sema_call_diagnostic_argument(access, args) == position {
                        check.diagnostics.push(access)
                    }
                }
                loop mismatch in mismatches {
                    if sema_call_diagnostic_argument(mismatch, args) == position {
                        check.diagnostics.push(mismatch)
                    }
                }
            }
        } else {
            sema_call_note_possible_bound_writes(params, binding, args, check)
        }
        return None
    }
    ownership: sema_ownership_check_call_arguments(check.state, callee, params, args, check.scopes, check.diagnostics)
    if !ownership.accepted || !ownership.complete -> return None
    ^lowered: sema_call_lower_bound_arguments(typed, params, args, check)
    if !sema_call_prepare_variadic_elements(typed, params, args, lowered, check) -> return None
    ^pins: sema_call_pin_binder_arguments(typed, params, lowered, check, span)
    ^packed: sema_call_pack_variadic_arguments(typed, params, lowered, check, span) ?? return None
    sema_call_compiler_handoffs(callee, packed, check, span)
    Val({lowered: packed.move(), pins: pins.move()})
}

// Record possible writes on bound `^` parameter arguments when argument typing
// stops before ownership checks run (for example, a callee with an undeclared
// parameter type), so E0514 never strips `^` from a binding that call may edit.
sema_call_note_possible_bound_writes: fn(params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], check: ^SemaBodyCheck) {
    loop index in 0..<args.len() {
        if index >= binding.sources.len() -> break
        slot: sema_call_bound_slot(binding, binding.sources[index], args[index])
        if slot >= 0 && slot < params.len() && params[slot].convention == AccessConvention.Write {
            sema_ownership_note_possible_write(check.state, args[index].expr, check.scopes)
        }
    }
}

// Record possible writes on every argument of a call whose callee signature
// could not be resolved or bound, so E0514 never strips `^` while the call
// remains unresolved.
sema_call_note_possible_arg_writes: fn(args: [CallArg], check: ^SemaBodyCheck) {
    loop arg in args {
        sema_ownership_note_possible_write(check.state, arg.expr, check.scopes)
    }
}

// A `Compiler` value passed to a function delegates the root's control, and
// the build's provenance records every handoff. The
// argument becomes the value's handoff from this call's place to `callee`,
// a new value of the same build whose chain ends with this pass, so what the
// callee makes names each function the value went through.
sema_call_compiler_handoffs: fn(callee: String, args: ^[TCallArg], check: SemaBodyCheck, span: Span) Never! {
    loop index in 0..<args.len() {
        if args[index].value.ty != (Type.Named{name: "Compiler"}) -> next
        location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)
        step: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "`{location.function}` handed it to `{callee}` at {location.file}:{location.line}"}}}, span)
        // copy: the handoff's receiver is the argument's checked value, which is written back as the
        // handoff's result; Jet has no exchange on an element of the write-borrowed `args`.
        handed: sema_tree_node(Type.Named{name: "Compiler"}, TExprKind.HostCall{call: THostCall.Method{receiver: args[index].value.copy(), method: "handoff", args: [TExpr]{step}}}, args[index].value.span)
        args[index].value = handed
    }
}

// The index of the argument whose source holds `diagnostic`, or `args.len()`
// when none does.
sema_call_diagnostic_argument: fn(diagnostic: Diagnostic, args: [CallArg]) -> Int Never! {
    at: diagnostic.span ?? return args.len()
    loop index in 0..<args.len() {
        source: expr_source_span(args[index].expr)
        if at.start >= args[index].span.start && at.start < source.end -> return index
    }
    args.len()
}

// True when the errors since `start` are all argument type mismatches (E0112)
// and there is at least one.
sema_call_only_argument_mismatches: fn(diagnostics: [Diagnostic], start: Int) -> Bool Never! {
    ^found: false
    loop index in start..<diagnostics.len() {
        if diagnostics[index].severity != DIAGNOSTIC_ERROR -> next
        if diagnostics[index].code != "E0112" -> return false
        found = true
    }
    found
}

// A `SharedGuard` argument for a write parameter that is neither a
// `guard_edit()` lease nor a binding the caller holds with write access.
sema_call_read_shared_guard_argument: fn(check: ^SemaBodyCheck, required: Type, offered: Type, expr: Expr) -> Bool {
    if required == .Apply(guard_name, _) {
        if guard_name != "SharedGuard" -> return false
    } else { return false }
    if offered == .Tagged(marker, _) && marker == (TagMarker.Internal{internal_tag: InternalTag.SharedGuardEdit}) {
        return false
    }
    if expr == .Ident(_, _, _) && sema_ownership_binding_for_expr(check.state, expr, check.scopes) == .Val(binding) && binding.access == AccessConvention.Write {
        return false
    }
    true
}

// The public name of a parameter eligible for E0773 crossed-argument checking.
// Positional-only parameters (declared before `/`) keep their names private so
// callers cannot label them to opt out, and unnamed function-type parameters
// carry no public label.
sema_call_crossed_param_name: fn(param: SemaCallParam) -> String Never! {
    if param.zone == ParamZone.PositionalOnly -> return ""
    param.label
}

// Simple variable name carried by an unlabeled, non-spread positional argument
// (including `^x`, `^^x`, `x.move()`, and `x.copy()`). Labeled arguments opt
// out explicitly, and field/index projections such as `a.x, b.x` are not bare
// variable names.
sema_call_crossed_arg_name: fn(arg: CallArg) -> String? {
    if arg.label != None || arg.spread -> return None
    if arg.expr == .Ident(name, _, _) -> return Val(name)
    if arg.expr == .Copy(inner, _, _) {
        if inner == .Ident(name, _, _) -> return Val(name)
    }
    if arg.expr == .MethodCall(receiver, method, _, _, _, method_args, _) {
        if method_args.len() == 0 && (method == "copy" || method == "move") {
            if receiver == .Ident(name, _, _) -> return Val(name)
        }
    }
    None
}

sema_call_source_is_written: fn(source: SemaCallArgSource) -> Bool Never! {
    if source == {
        .Written(_) -> true
        .Default(_) -> false
    }
}

// Whether parameter `other_slot` has the same resolved type as `bound_ty`.
sema_call_crossed_same_type: fn(params: [SemaCallParam], other_slot: Int, slot_type_index: [Int], required_types: [Type], bound_ty: Type, check: SemaBodyCheck) -> Bool Never! {
    other_idx: slot_type_index[other_slot]
    if other_idx >= 0 -> return required_types[other_idx] == bound_ty
    declared: sema_call_parameter_type(params[other_slot]) ?? return false
    resolved: sema_call_resolved_type(declared, check.environment.*, check.program.*)
    resolved == bound_ty
}

// E0773: refuse calls where two or more unlabeled positional arguments form a
// crossed name cycle across same-typed parameters (`copy(dst, src)` into
// `fn(src, dst)`, or `rotate(b, c, a)` into `fn(a, b, c)`). Requiring a cycle
// of at least two crossed arguments catches swapped and rotated calls with
// zero false positives on ordinary one-way name collisions such as
// `set_header(client, "User-Agent", name)` or `sign_extend(bits, 64)`. Labeled
// arguments opt out explicitly, positional-only parameters (`/`) are excluded,
// and duplicating one variable (`rect(width, width)`) forms no cycle.
sema_call_check_crossed_arguments: fn(callee: String, params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], slots: [Int], required_types: [Type], check: ^SemaBodyCheck) {
    param_count: params.len()
    arg_count: args.len()
    if param_count < 2 || arg_count < 2 -> return
    // Fast skip unless at least two written positional arguments are bare names.
    ^bare_count: 0
    loop index in 0..<arg_count {
        if index < binding.sources.len() && sema_call_source_is_written(binding.sources[index]) && sema_call_crossed_arg_name(args[index]) != None {
            bare_count += 1
            if bare_count >= 2 -> break
        }
    }
    if bare_count < 2 -> return

    ^slot_type_index: (loop _ in 0..<param_count -> -1)
    ^slot_written_index: (loop _ in 0..<param_count -> -1)
    loop index in 0..<arg_count {
        slot: slots[index]
        if slot >= 0 && slot < param_count {
            if slot_type_index[slot] < 0 -> slot_type_index[slot] = index
            if index < binding.sources.len() && sema_call_source_is_written(binding.sources[index]) && slot_written_index[slot] < 0 {
                slot_written_index[slot] = index
            }
        }
    }

    // Directed edge `next_slot[slot] = target_slot` when `slot` received an
    // unlabeled bare variable naming a different same-typed parameter
    // `target_slot`. Each slot has at most one outgoing edge.
    ^next_slot: (loop _ in 0..<param_count -> -1)
    loop slot in 0..<param_count {
        arg_index: slot_written_index[slot]
        if arg_index < 0 -> next
        arg_name: sema_call_crossed_arg_name(args[arg_index]) ?? next
        bound_name: sema_call_crossed_param_name(params[slot])
        if bound_name == "" || bound_name == arg_name -> next
        loop other_slot in 0..<param_count {
            if other_slot == slot -> next
            if sema_call_crossed_param_name(params[other_slot]) != arg_name -> next
            if sema_call_crossed_same_type(params, other_slot, slot_type_index, required_types, required_types[arg_index], check) {
                next_slot[slot] = other_slot
                break
            }
        }
    }

    // Walk functional graph to report each directed cycle (length >= 2) once.
    // visit_state: 0 = unvisited, 1 = on current walk, 2 = finished.
    ^visit_state: (loop _ in 0..<param_count -> 0)
    shown_callee: if callee == "this function value" -> "this call" else -> "`{callee}`"
    loop start_slot in 0..<param_count {
        if visit_state[start_slot] != 0 || next_slot[start_slot] < 0 -> next
        ^walk: [Int]{}
        ^cursor: start_slot
        loop cursor >= 0 && visit_state[cursor] == 0 {
            visit_state[cursor] = 1
            walk.push(cursor)
            cursor = next_slot[cursor]
        }
        if cursor >= 0 && visit_state[cursor] == 1 {
            ^cycle_start: 0
            loop pos in 0..<walk.len() {
                if walk[pos] == cursor {
                    cycle_start = pos
                    break
                }
            }
            ^cycle_slots: [Int]{}
            loop pos in cycle_start..<walk.len() -> cycle_slots.push(walk[pos])
            if cycle_slots.len() >= 2 {
                // Sort cycle members by source span order for deterministic,
                // left-to-right diagnostics and suggested fixes.
                ^order: [Int]{}
                loop s in cycle_slots -> order.push(s)
                loop i in 0..<order.len() {
                    loop j in i + 1..<order.len() {
                        si: args[slot_written_index[order[i]]].span.start
                        sj: args[slot_written_index[order[j]]].span.start
                        if sj < si {
                            tmp: order[i]
                            order[i] = order[j]
                            order[j] = tmp
                        }
                    }
                }
                first_span: args[slot_written_index[order[0]]].span
                last_span: args[slot_written_index[order[order.len() - 1]]].span
                joined_span: Span{start: first_span.start, end: last_span.end}
                shown_ty: type_name(required_types[slot_written_index[order[0]]])
                ^written_names: [String]{}
                ^param_names: [String]{}
                ^labeled_pairs: [String]{}
                loop s in order {
                    p_name: sema_call_crossed_param_name(params[s])
                    a_name: sema_call_crossed_arg_name(args[slot_written_index[s]]) ?? ""
                    labeled_pairs.push("{p_name}: {a_name}")
                    param_names.push(p_name)
                    written_names.push(a_name)
                }
                ^has_trailing_positional: false
                loop idx in 0..<arg_count {
                    if idx < binding.sources.len() && sema_call_source_is_written(binding.sources[idx]) && args[idx].label == None && args[idx].span.start > last_span.end {
                        has_trailing_positional = true
                        break
                    }
                }
                what: if order.len() == 2 -> "Arguments `{written_names[0]}` and `{written_names[1]}` are crossed in this call to {shown_callee}" else -> "Arguments `({written_names.join(", ")})` are crossed in this call to {shown_callee}"
                why: if order.len() == 2 -> "{shown_callee} declares `{param_names[0]}` before `{param_names[1]}` with the same type `{shown_ty}`, so passing `({written_names[0]}, {written_names[1]})` by position looks swapped" else -> "{shown_callee} declares `({param_names.join(", ")})` with the same type `{shown_ty}`, so passing `({written_names.join(", ")})` by position looks rotated"
                fix: if has_trailing_positional -> "Reorder them to `({param_names.join(", ")})`, or label them (and any following arguments) explicitly starting with `{labeled_pairs.join(", ")}`" else -> "Reorder them to `({param_names.join(", ")})`, or label them explicitly as `{labeled_pairs.join(", ")}`"
                check.diagnostics.push(sema_error("E0773", joined_span, what, why, fix))
            }
        }
        loop visited_slot in walk -> visit_state[visited_slot] = 2
    }
}
