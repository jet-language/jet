// Type-check and lower one already-resolved call binding.
//
// Binding owns declaration order; this file owns expression checking and the
// one-way conversion to TCallArg. It never materializes a Type-only default:
// Registration must provide the original expression through
// SemaCallDefaultValue first.
use jet_foundation.[
    AccessConvention,
    BinderRef,
    CallArg,
    Diagnostic,
    Expr,
    FunctionDefaultRef,
    MIRCopyFact,
    Span,
    Symbol,
    SymbolID,
    SymbolKind,
    TCallArg,
    TListSpreadPart,
    TExpr,
    TExprKind,
    TLetTy,
    TStmt,
    Type,
    ast_empty_call_arg_flags,
    expr_span,
    symbol_id,
    tir_symbol_local,
    type_identity_equal,
    type_name,
]

struct SemaCallTypedArguments {
    values: [TExpr]
    slots: [Int]
    required_types: [Type]
    // Each argument's written position (`-1` for a default). When a default
    // reads an earlier parameter, every argument is pinned in
    // `binder_ref_<site>_<slot>` in the Rust reference's source order.
    source_indices: [Int]
    pin_arguments: Bool{false}
    binder_site: Int{0}
}

fn sema_call_resolved_type(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type Never! {
    if program.registration_graph == .Val(graph) {
        sema_type_resolve_declared_with_generics(graph, ty, environment.module_identity, environment.generic_params)
    } else {
        // copy: the resolved type is a new owned Type. When nothing resolves it equals `ty`, the
        // caller's signature type (a read parameter), which stays in the signature.
        return ty.copy()
    }
}

fn sema_call_type_assignable(required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool? {
    if program.registration_graph == {
        .Val(graph) -> sema_type_assignable_in_graph_with_generics(graph, required, offered, environment.module_identity, environment.generic_params)
        else -> Val(sema_type_assignable(required, offered))
    }
}

fn sema_call_box_as_trait(required: Type, offered: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Type? {
    required_resolved :: sema_call_resolved_type(required, environment, program)
    if required_resolved == {
        .TraitObject(_) -> {}
        else -> return None
    }
    offered_resolved :: sema_call_resolved_type(offered, environment, program)
    if offered_resolved == {
        .TraitObject(_) -> return None
        else -> {}
    }
    compatible :: sema_call_type_assignable(required_resolved, offered_resolved, environment, program) ?? return None
    if compatible -> Val(required_resolved) else -> None
}

fn sema_call_registration_defaults(graph: SemaRegistrationGraph, binding: SemaCallBinding) -> [SemaCallDefaultValue]? {
    defaults := [SemaCallDefaultValue]{}
    loop reference in binding.default_refs {
        expression :: sema_registration_resolve_default(graph, reference) ?? return None
        &defaults.push(SemaCallDefaultValue{reference: reference, expression: expression})
    }
    Val(defaults)
}

fn sema_call_param_optional_for_check(param: SemaCallParam) -> Bool Never! {
    param.variadic || param.default != None || param.default_ref != None
}

fn sema_call_default_ref_equal(left: FunctionDefaultRef, right: FunctionDefaultRef) -> Bool Never! {
    left.source_file == right.source_file && left.owner_key == right.owner_key && left.parameter_index == right.parameter_index && left.span.start == right.span.start && left.span.end == right.span.end
}

fn sema_call_default_expression(reference: FunctionDefaultRef, defaults: [SemaCallDefaultValue]) -> Expr? {
    loop candidate in defaults {
        if sema_call_default_ref_equal(reference, candidate.reference) -> return Val(candidate.expression)
    }
    None
}

fn sema_call_make_binder_refs(params: [SemaCallParam], parameter: Int) -> [BinderRef] Never! {
    refs := [BinderRef]{}
    loop index in 0..<parameter {
        if sema_call_parameter_type(params[index]) == .Val(value) {
            &refs.push(BinderRef{name: params[index].name, slot: index, ty: value})
        }
    }
    refs
}

fn sema_call_mark_materialized_written(arg: CallArg, source_index: Int, parameter: Int, param: SemaCallParam, span: Span) -> CallArg Never! {
    result := arg
    result.flags.source_index = Val(source_index)
    result.flags.binder_slot = Val(parameter)
    result.flags.binder_site = Val(span.start)
    result.flags.binder_label = Val(param.label)
    result
}

fn sema_call_make_materialized_default(value: Expr, parameter: Int, param: SemaCallParam, params: [SemaCallParam], span: Span) -> CallArg Never! {
    flags := ast_empty_call_arg_flags()
    flags.binder_slot = Val(parameter)
    flags.binder_site = Val(span.start)
    flags.binder_label = Val(param.label)
    flags.binder_refs = sema_call_make_binder_refs(params, parameter)
    CallArg{convention: param.convention, expr: value, span: span, flags: flags, label: None, spread: false}
}

// Fill only metadata defaults whose original expressions Registration resolved.
// The returned binding keeps source indices stable for evaluation-order lowering.
fn sema_call_materialize_defaults(params: [SemaCallParam], binding: SemaCallBinding, args: &[CallArg], defaults: [SemaCallDefaultValue], call_span: Span, diagnostics: &[Diagnostic]) -> SemaCallBinding? {
    if binding.default_refs.len() == 0 -> return Val(binding)
    loop reference in binding.default_refs {
        if sema_call_default_expression(reference, defaults) == None {
            &diagnostics.push(sema_error("E0906", call_span, "a default argument for this call could not be resolved", "callable defaults retain their owning declaration and source identity", "make the owning declaration available to Registration before checking this call"))
            return None
        }
    }
    rewritten := [CallArg]{}
    loop source in binding.sources {
        if source == {
            .Written(original_index) -> {
                if original_index < 0 || original_index >= args.len() {
                    &diagnostics.push(sema_call_arity_diagnostic("this call", params.len(), args.len(), false, call_span))
                    return None
                }
                parameter :: if original_index < binding.slots.len() -> binding.slots[original_index] else -> -1
                if parameter < 0 || parameter >= params.len() {
                    &diagnostics.push(sema_call_arity_diagnostic("this call", params.len(), args.len(), false, call_span))
                    return None
                }
                &rewritten.push(sema_call_mark_materialized_written(args[original_index], original_index, parameter, params[parameter], call_span))
            }
            .Default(parameter) -> {
                if parameter < 0 || parameter >= params.len() {
                    &diagnostics.push(sema_error("E0906", call_span, "a default argument refers to an invalid parameter", "default metadata must point into the owning declaration", "repair the registered FunctionDefaultRef"))
                    return None
                }
                reference :: params[parameter].default_ref ?? {
                    &diagnostics.push(sema_error("E0906", call_span, "a default argument lost its source reference", "metadata defaults are identified by FunctionDefaultRef", "register the declaration's original default expression"))
                    return None
                }
                expression :: sema_call_default_expression(reference, defaults) ?? {
                    &diagnostics.push(sema_error("E0906", call_span, "a default argument for this call could not be resolved", "callable defaults retain their owning declaration and source identity", "make the owning declaration available to Registration before checking this call"))
                    return None
                }
                &rewritten.push(sema_call_make_materialized_default(expression, parameter, params[parameter], params, call_span))
            }
        }
    }
    if rewritten.len() != binding.sources.len() {
        &diagnostics.push(sema_error("E0104", call_span, "the call binding did not produce one value per declaration slot", "a successful call has to account for every written value and resolved default", "check the callable declaration and its default metadata"))
        return None
    }
    loop args.len() > 0 -> _ := &args.pop()
    loop value in rewritten -> &args.push(value)
    result := binding
    result.rewrote = true
    result
}

fn sema_call_bound_slot(binding: SemaCallBinding, source: SemaCallArgSource, arg: CallArg) -> Int Never! {
    if arg.flags.binder_slot == .Val(slot) -> return slot
    if source == {
        .Written(index) -> if index >= 0 && index < binding.slots.len() -> binding.slots[index] else -> -1
        .Default(parameter) -> parameter
    }
}

fn sema_call_view_place_equal(left: SemaOwnershipPlace, right: SemaOwnershipPlace) -> Bool Never! {
    if left.root_key != right.root_key || left.projections.len() != right.projections.len() -> return false
    loop index in 0..<left.projections.len() {
        if left.projections[index] != right.projections[index] -> return false
    }
    true
}

fn sema_call_return_view_parameter_expr(parameter: Int, binding: SemaCallBinding, args: [CallArg]) -> Expr? {
    loop index in 0..<args.len() {
        source :: binding.sources[index]
        if sema_call_bound_slot(binding, source, args[index]) == parameter -> return Val(args[index].expr)
    }
    None
}

fn sema_call_return_view_facts(signature: Type, receiver: Expr?, args: [CallArg], binding: SemaCallBinding, scopes: SemaScopeTable, state: &SemaOwnershipState, span: Span) -> [SemaCallReturnViewFact] {
    map :: if signature == {
        .Fn(_, _, _, _, _, return_view_provenance) -> return_view_provenance ?? return [SemaCallReturnViewFact]{}
        else -> {
            return [SemaCallReturnViewFact]{}
        }
    }
    facts := [SemaCallReturnViewFact]{}
    loop entry in map.entries {
        places := [SemaOwnershipPlace]{}
        temporaries := [Span]{}
        loop source_path in entry.value.sources {
            source_expr := Expr?{None}
            if source_path.source == {
                // copy: each return-view source path builds its own source Expr, and `receiver` is
                // the caller's call receiver (a read parameter), used once per path in this loop.
                .Receiver -> source_expr = receiver.copy()
                .Parameter(parameter) -> source_expr = sema_call_return_view_parameter_expr(parameter, binding, args)
                .Static(_, _) -> {}
            }
            if source_expr == .Val(expression) {
                source_places :: sema_ownership_places_from_expr_in_state(expression, scopes, &state)
                if source_places.len() == 0 && source_path.source == .Parameter(_) -> &temporaries.push(expr_span(expression))
                loop source_place in source_places {
                    place :: sema_ownership_append_view_source_projections(source_place, source_path.projections, span)
                    duplicate :: loop existing in places {
                        if sema_call_view_place_equal(existing, place) -> break true
                    } ?? false
                    if !duplicate -> &places.push(place)
                }
            }
        }
        access :: if entry.value.mutable -> AccessConvention.Write else -> AccessConvention.Read
        &facts.push(SemaCallReturnViewFact{
            slot: entry.slot,
            access: access,
            places: places,
            sources: entry.value.sources,
            temporaries: temporaries,
        })
    }
    facts
}

fn sema_call_validate_binding(callee: String, params: [SemaCallParam], binding: SemaCallBinding, args: [CallArg], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if binding.sources.len() != args.len() {
        &diagnostics.push(sema_error("E0104", span, "the call binding and written arguments disagree", "a checked call must have one source row for every argument value", "resolve callable defaults before checking the call"))
        return false
    }
    seen := [Bool]{}
    loop index in 0..<params.len() -> &seen.push(false)
    valid := true
    loop index in 0..<binding.sources.len() {
        slot :: sema_call_bound_slot(binding, binding.sources[index], args[index])
        if {
            slot < 0 || slot >= params.len() -> valid = false
            else -> seen[slot] = true
        }
    }
    if !valid {
        &diagnostics.push(sema_call_arity_diagnostic(callee, params.len(), args.len(), false, span))
    }
    missing := 0
    loop index in 0..<params.len() {
        if !seen[index] && !sema_call_param_optional_for_check(params[index]) {
            &diagnostics.push(sema_error("E0766", span, "this call to `{callee}` is missing `{params[index].label}`", "the parameter has no default, so every call has to supply it", "add the missing argument"))
            missing += 1
        }
    }
    valid && missing == 0
}

fn sema_call_is_scalar(ty: Type) -> Bool Never! {
    if ty == {
        .Int -> true
        .IntN(_, _) -> true
        .Float -> true
        .Float32 -> true
        .Bool -> true
        .Char -> true
        else -> false
    }
}

fn sema_call_convention_diagnostic(callee: String, param: SemaCallParam, arg: CallArg, decision: SemaCallConventionDecision) -> Diagnostic {
    if decision == {
        .RequiresWrite -> sema_error("E0202", arg.span, "parameter `{param.name}` requires the write-access marker `&` at the call site", "`{callee}` needs to edit this value with the write-access marker `&`", "write `&` before the argument")
        .RejectsMove -> sema_error("E0203", arg.span, "a value was passed with the move marker `^` to a parameter that does not consume", "only a move parameter accepts a moved value", "remove the move marker `^`")
        else -> sema_error("E0209", arg.span, "implicit clone of `{param.name}`", "`{callee}` takes ownership and this argument is not marked as a move", "write the move marker `^`, or copy the value explicitly")
    }
}

fn sema_call_lambda_escape_policy(parameter: SemaCallParam, abi: SemaRegistrationCallableABI?) -> Bool? {
    if parameter.convention == AccessConvention.Move -> return Val(true)
    callable_abi :: abi ?? return None
    parameter_type :: sema_call_parameter_type(parameter) ?? return None
    Val(sema_registration_callback_boundary_param(callable_abi, parameter_type))
}

fn sema_call_typecheck_bound_arguments(callee: String, params: [SemaCallParam], abi: SemaRegistrationCallableABI?, apply_lambda_escape_override: Bool, binding: SemaCallBinding, args: &[CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic], report_conventions: Bool) -> SemaCallTypedArguments? {
    if !sema_call_validate_binding(callee, params, binding, args, span, &diagnostics) -> return None
    values := [TExpr]{}
    slots := [Int]{}
    required_types := [Type]{}
    source_indices := [Int]{}
    pin_arguments := !binding.source_ordered
    binder_site := span.start
    reference_starts := [Int]{}
    take_indices := [Int]{}
    take_keys := [String]{}
    loop index in 0..<args.len() {
        &reference_starts.push(context.name_references.len())
        slot :: sema_call_bound_slot(binding, binding.sources[index], args[index])
        if slot < 0 || slot >= params.len() -> return None
        parameter :: params[slot]
        required_declared :: sema_call_argument_parameter_type(parameter, args[index]) ?? {
            &diagnostics.push(sema_error("E0112", args[index].span, "this callable parameter has no checked type", "call checking cannot prove an argument safe without the declaration type", "register the complete callable signature"))
            return None
        }
        required :: sema_call_resolved_type(required_declared, environment, program)
        decision :: sema_call_argument_convention(parameter, args[index])
        if report_conventions && decision != SemaCallConventionDecision.Accepted {
            &diagnostics.push(sema_call_convention_diagnostic(callee, parameter, args[index], decision))
            return None
        }
        // Rust CallBinder `rewrite` + `register_binder_refs`: a default names
        // earlier parameters through their declaration-slot temporaries, so
        // they shadow any caller binding of the same name.
        binder_refs :: args[index].flags.binder_refs
        binder_start :: context.name_references.len()
        binder_keys :: if binder_refs.len() > 0 -> sema_call_enter_binder_refs(binder_refs, args[index].flags.binder_site ?? span.start, environment, program, &scopes, &state, expr_span(args[index].expr)) else -> [String]{}
        // Rust `arg_expect`: a self-typed numeric read widens into the
        // parameter after it is checked on its own.
        self_typed :: sema_stmt_numeric_slot_self_typed(args[index].expr, required)
        trait_parameter :: if required == {
            .TraitObject(_) -> true
            else -> false
        }
        // A borrowed trait parameter lends the original concrete storage.
        // Expected-type coercion would instead construct an owned TraitBox.
        borrowed_trait :: trait_parameter && parameter.convention != AccessConvention.Move
        argument_expected := Type?{None}
        if !self_typed && !borrowed_trait -> argument_expected = Val(required)
        checked_argument :: if apply_lambda_escape_override -> sema_check_expression_with_lambda_escapes(args[index].expr, argument_expected, environment, program, &scopes, &state, &tail_store, &context, sema_call_lambda_escape_policy(parameter, abi), &diagnostics) else -> sema_check_expression(args[index].expr, argument_expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        if binder_refs.len() > 0 {
            sema_scope_leave(&scopes, &state)
            if sema_call_binder_refs_read(binder_keys, binder_start, context) {
                pin_arguments = true
                binder_site = args[index].flags.binder_site ?? span.start
            }
        }
        checked_value :: checked_argument ?? return None
        if parameter.convention == AccessConvention.Move && !sema_copy_site_check_guard_owned(checked_value, environment, program, scopes, context, &diagnostics, args[index].convention == AccessConvention.Move) -> return None
        value :: if self_typed -> sema_stmt_numeric_slot_value(checked_value, required, environment, program, &diagnostics) ?? return None else -> checked_value
        compatible :: if trait_parameter && parameter.convention == AccessConvention.Write -> type_identity_equal(required, sema_call_resolved_type(value.ty, environment, program)) else -> sema_call_type_assignable(required_declared, value.ty, environment, program) ?? return None
        if !compatible {
            // (Rust `check_variadic_bound_tail`,
            // E1313): a trait-bounded variadic argument is checked against
            // each bound trait it fails to implement. A builtin trait stays a
            // named bound after resolution.
            bounds := [String]{}
            if required == .TraitObject(list) {
                bounds = list
            } else if required_declared == .Named(trait_name) && sema_type_builtin_trait_symbol(trait_name) != None {
                bounds = [String]{trait_name}
            }
            if parameter.variadic && !args[index].spread && bounds.len() > 0 {
                arg_name :: type_name(value.ty)
                loop bound in bounds {
                    if bounds.len() > 1 && sema_call_type_assignable(Type.TraitObject{bounds: [String]{bound}}, value.ty, environment, program) == (Val(true)) -> next
                    shown :: sema_error_conversion_leaf(bound)
                    &diagnostics.push(sema_error("E1313", expr_span(args[index].expr), "`{arg_name}` doesn't implement `{shown}`", "`{parameter.name}: ...{shown}` checks every argument against `{shown}` — that's how `{callee}` accepts a mix of types safely", "implement `{shown}` for `{arg_name}`'s type, or drop the value from this call"))
                }
                return None
            }
            &diagnostics.push(sema_type_mismatch(required, value.ty, args[index].span))
            return None
        }
        // The ownership check that follows moves an
        // eligible unmarked take argument at its last use.
        if !report_conventions && decision == SemaCallConventionDecision.NeedsImplicitClone && binder_refs.len() == 0 {
            if sema_ownership_note_implicit_take(&state, args[index].expr, value.ty, required, environment, program, context.generic_params, scopes) == .Val(key) {
                &take_indices.push(index)
                &take_keys.push(key)
            }
        }
        // Rust `check_call_argument_access`: the parser stores `f(^x)`'s and
        // `f(^x.f)`'s move mark on the CallArg, and a marked name or field
        // passed to a consuming parameter is the exact-place move, so the
        // argument moves out of its owner (MovePlace, clearing its drop
        // flag) instead of reaching lowering as a bare read that only a
        // last-use proof turns into a move. A read parameter or its field has
        // no storage to give up: the mark is E0201, never a silent copy, and
        // an element (or a place inside one) stays owned by its collection
        // (E0225). A write parameter's field keeps the refill move the
        // last-use pass proves.
        consuming_mark :: parameter.convention == AccessConvention.Move && !parameter.variadic && args[index].convention == AccessConvention.Move && !sema_ownership_type_is_copy(value.ty)
        if consuming_mark && sema_call_reject_element_move(args[index].expr, &diagnostics) -> return None
        marked_place :: consuming_mark && sema_call_marked_move_place(args[index].expr, value)
        if marked_place && sema_ownership_reject_read_param_move(&state, args[index].expr, scopes, &diagnostics) -> return None
        taken_place := marked_place
        if taken_place && sema_ownership_binding_for_expr(&state, args[index].expr, scopes) == .Val(root) -> taken_place = !sema_ownership_binding_is_borrowed_param(root)
        stored :: sema_call_marked_move_value(&state, taken_place, args[index].expr, ^value, scopes, &diagnostics) ?? return None
        &values.push(stored)
        &slots.push(slot)
        &required_types.push(required)
        &source_indices.push(args[index].flags.source_index ?? -1)
    }
    &reference_starts.push(context.name_references.len())
    loop position in 0..<take_indices.len() {
        if sema_call_key_named_elsewhere(take_keys[position], take_indices[position], reference_starts, context) -> sema_ownership_note_implicit_take_twice(&state, expr_span(args[take_indices[position]].expr))
    }
    Val(SemaCallTypedArguments{values: values, slots: slots, required_types: required_types, source_indices: source_indices, pin_arguments: pin_arguments, binder_site: binder_site})
}

// Whether an argument other than `own` references the binding `key`;
// `starts` holds each argument's first name reference and the end.
fn sema_call_key_named_elsewhere(key: String, own: Int, starts: [Int], context: SemaCheckContext) -> Bool Never! {
    loop other in 0..<starts.len() - 1 {
        if other == own -> next
        loop index in starts[other]..<starts[other + 1] {
            if index < context.name_references.len() && context.name_references[index].symbol.id.key == key -> return true
        }
    }
    false
}

fn sema_call_binder_ref_symbol(environment: SemaScopeEnvironment, program: SemaProgramTables, owner: String, site: Int, slot: Int, name: String, ty: Type, span: Span) -> Symbol Never! {
    id :: symbol_id(SymbolKind.Local, environment.module_identity, owner, "binder_ref_{site}_{slot}")
    Symbol{id: id, kind: SymbolKind.Local, name: name, module_name: environment.module_identity, owner: Val(owner), span: span, ty: Val(ty), visibility: 0}
}

// Opens the default's own frame with each earlier parameter bound to its slot
// temporary; the caller leaves it after checking the default. A placeholder
// enters ownership only when the default reads it, so an unread one is no
// unused binding. `span` is the default expression, so every read follows it.
fn sema_call_enter_binder_refs(refs: [BinderRef], site: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, span: Span) -> [String] Never! {
    owner :: sema_scope_function_owner_key(scopes)
    _ := sema_scope_enter(&scopes, &state, owner)
    keys := [String]{}
    loop reference in refs {
        symbol :: sema_call_binder_ref_symbol(environment, program, owner, site, reference.slot, reference.name, reference.ty, span)
        _ := sema_scope_declare_local(&scopes, symbol, false, AccessConvention.Read, None, false)
        &keys.push(symbol.id.key)
    }
    keys
}

fn sema_call_binder_refs_read(keys: [String], start: Int, context: SemaCheckContext) -> Bool Never! {
    loop index in start..<context.name_references.len() {
        if keys.contains(context.name_references[index].symbol.id.key) -> return true
    }
    false
}

// Declaration-order grouping must not reorder written expressions. Pin raw
// supplied arguments in written order, then defaults in declaration order,
// so binder references read the already-passed values. Methods and Fn calls
// pin their receiver/callee first; this helper owns only argument pins.
// Borrowed places are pinned as borrows, fresh values retain an owned pin.
fn sema_call_pin_binder_arguments(typed: SemaCallTypedArguments, params: [SemaCallParam], lowered: &[TCallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, span: Span) -> [TStmt] Never! {
    bindings := [TStmt]{}
    if !typed.pin_arguments -> return bindings
    owner :: sema_scope_function_owner_key(scopes)
    order := [Int]{}
    loop written in 0..<typed.source_indices.len() {
        loop index in 0..<typed.source_indices.len() {
            if typed.source_indices[index] == written -> &order.push(index)
        }
    }
    loop index in 0..<typed.source_indices.len() {
        if typed.source_indices[index] < 0 -> &order.push(index)
    }
    loop index in order {
        slot :: typed.slots[index]
        // Each written rest argument must be evaluated before grouping the
        // tail. Its private pin cannot shadow a declaration-slot default.
        pin_slot := slot
        if params[slot].variadic -> pin_slot = -index - 1
        // copy: the argument's checked value becomes the binder pin's init, and
        // lowered[index].value is overwritten with the pin local below. Jet has no exchange on an
        // element of the write-borrowed `lowered`.
        original :: lowered[index].value.copy()
        init := original
        place_value :: if init.kind == {
            .Local(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Deref(_) | .Borrow(_, _) -> true
            else -> false
        }
        borrowed :: (lowered[index].borrow || lowered[index].mut_borrow) && place_value
        if borrowed {
            access :: if lowered[index].mut_borrow -> AccessConvention.Write else -> AccessConvention.Read
            init = sema_tir_node(original.ty, TExprKind.Borrow{place: init, access: access}, original.span)
        }
        symbol :: sema_call_binder_ref_symbol(environment, program, owner, typed.binder_site, pin_slot, params[slot].name, original.ty, span)
        local := tir_symbol_local("binder_ref_{typed.binder_site}_{pin_slot}", span, symbol.id)
        local.generated = true
        local.mutable = lowered[index].mut_borrow
        local.deref = borrowed
        local_value :: sema_tir_node(original.ty, TExprKind.Local{local: local}, original.span)
        moves_pin :: params[slot].convention == AccessConvention.Move || (params[slot].variadic && !lowered[index].spread)
        lowered[index].value = if moves_pin -> sema_tir_node(original.ty, TExprKind.Move{value: local_value}, original.span) else -> local_value
        &bindings.push(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: init, gc_promotion: None, gc_transferred: false, span: span})
    }
    bindings
}

// Places the binder pins before the call they feed.
fn sema_call_with_binder_pins(pins: ^[TStmt], call_value: ^TExpr, span: Span) -> TExpr Never! {
    if pins.len() == 0 -> return call_value
    // copy: `call_value` moves into the block body on the next line, while the block node needs the
    // call's type as its own.
    ty :: call_value.ty.copy()
    body := pins
    &body.push(TStmt.ExprStmt{value: call_value, span: span})
    sema_tir_node(ty, TExprKind.InlineBlock{body: body}, span)
}

// The place a `^`-marked call argument moves exactly: a field read, or a
// whole non-Copy local named by itself (a Copy value simply copies).
fn sema_call_marked_move_place(expr: Expr, value: TExpr) -> Bool Never! {
    if expr == {
        .Field(_, _, _) -> true
        .Ident(_, _) -> value.kind == .Local(_) && !sema_ownership_type_is_copy(value.ty)
        else -> false
    }
}

// A consuming argument `^xs[i]` or `^xs[i].f`: an element stays owned by its
// collection, so the mark is E0225 (as at a value-position mark,
// Expressions/Places.jet), never a silent copy. True when rejected.
fn sema_call_reject_element_move(expr: Expr, diagnostics: &[Diagnostic]) -> Bool Never! {
    element :: if expr == {
        .Index(_, _, _, _) -> true
        else -> false
    }
    if !element && !sema_expression_place_below_element(expr) -> return false
    start :: expr_span(expr).start
    mark_span :: Span{start: start - 1, end: start}
    if element {
        &diagnostics.push(sema_error("E0225", mark_span, "the move marker `^` cannot take an element out of its collection", "`^` moves a name or one of its fields; an element stays owned by its collection, which has no hole to leave behind", "pass `.copy()` of the element instead of `^`, or take it out with a removing call such as `pop`"))
    } else {
        &diagnostics.push(sema_error("E0225", mark_span, "the move marker `^` cannot take a field out of a collection element", "an element stays owned by its collection together with every field inside it, so this value can only be a copy", "remove `^` and call `.copy()` on the field instead"))
    }
    true
}

// The stored value of a consuming argument: a `^`-marked exact place
// (`taken`) is a checked move, and the move of a match payload binding takes
// the payload out of its subject (sema_ownership_move_pattern_payload).
// None when the move is rejected.
fn sema_call_marked_move_value(state: &SemaOwnershipState, taken: Bool, expr: Expr, value: ^TExpr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> TExpr? {
    if !taken -> return Val(^value)
    start :: expr_span(expr).start
    payload :: sema_ownership_move_pattern_payload(&state, expr, Span{start: start - 1, end: start}, scopes, &diagnostics)
    if payload < 0 -> return None
    moved :: if payload > 0 -> sema_expression_payload_take(^value) else -> ^value
    Val(sema_tir_node(moved.ty, TExprKind.Move{value: moved}, moved.span))
}

fn sema_call_widen_union(required: Type, offered: Type) -> Type? {
    if required == .Union(members) {
        loop member in members {
            if type_identity_equal(member, offered) -> return Val(required)
        }
    }
    None
}

fn sema_call_lower_bound_arguments(typed: SemaCallTypedArguments, params: [SemaCallParam], args: &[CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables) -> [TCallArg] Never! {
    lowered := [TCallArg]{}
    loop index in 0..<typed.values.len() {
        value :: typed.values[index]
        arg :: args[index]
        param :: params[typed.slots[index]]
        required :: if index < typed.required_types.len() -> typed.required_types[index] else -> sema_call_resolved_type(sema_call_argument_parameter_type(param, arg) ?? value.ty, environment, program)
        widen_to_vec :: if required == {
            .List(_) -> if value.ty == {
                .FixedList(_, _) -> true
                else -> false
            }
            else -> false
        }
        widen_to_union :: sema_call_widen_union(required, value.ty)
        &lowered.push(TCallArg{
            value: value,
            template_items: [SymbolID]{},
            borrow: param.convention == AccessConvention.Read && !sema_call_is_scalar(value.ty),
            mut_borrow: param.convention == AccessConvention.Write,
            fn_coerce: None,
            widen_to_vec: widen_to_vec,
            widen_to_union: widen_to_union,
            box_as_trait: sema_call_box_as_trait(required, value.ty, environment, program),
            label: arg.label.map((label) -> label.name),
            spread: arg.spread,
        })
    }
    lowered
}

// Normalize the checked rest slot once, before publishing TIR. BuildList
// owns scalar elements; ListSpread clones spread elements through the same
// checked Clone/effect mechanism as a written list literal.
fn sema_call_prepare_variadic_elements(typed: SemaCallTypedArguments, params: [SemaCallParam], args: [CallArg], lowered: &[TCallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    loop index in 0..<lowered.len() {
        slot :: typed.slots[index]
        if !params[slot].variadic -> next
        // copy: the variadic element value is rewrapped and written back into lowered[index] below.
        // Jet has no exchange on an element of the write-borrowed `lowered`.
        value := lowered[index].value.copy()
        if lowered[index].widen_to_vec {
            // The boundary copy itself clones the fixed list's elements.
            // Do not first clone the array and then clone that copy again.
            if !sema_expression_list_check_clone(value.ty, value.span, environment, program, &context, &diagnostics) -> return false
            if args[index].convention == AccessConvention.Move -> value = sema_tir_node(value.ty, TExprKind.Move{value: value}, value.span)
            value = sema_tir_node(typed.required_types[index], TExprKind.MaterializeView{value: value}, value.span)
        } else if args[index].convention == AccessConvention.Move {
            value = sema_tir_node(value.ty, TExprKind.Move{value: value}, value.span)
        } else if lowered[index].spread {
            // A lone spread is a direct List borrow; mixed spread cloning is
            // judged below on the canonical ListSpread, not on its List root.
            next
        } else if !sema_ownership_type_is_copy(value.ty) {
            places :: sema_ownership_places_from_expr_in_state(args[index].expr, scopes, &state)
            borrowed := false
            loop place in places {
                loop binding in scopes.bindings {
                    if binding.symbol.id.key == place.root_key && sema_ownership_binding_is_borrowed_param(binding) -> borrowed = true
                }
            }
            copies_place :: places.len() > 0 && (borrowed || !sema_ownership_unmarked_moves_name(args[index].expr) || sema_ownership_is_share_site(state, args[index].span))
            if copies_place {
                if !sema_expression_list_check_clone(value.ty, value.span, environment, program, &context, &diagnostics) -> return false
                value = sema_tir_node(value.ty, TExprKind.Clone{value: value, fact: MIRCopyFact.Materialize}, value.span)
            } else {
                if !sema_ownership_mark_unmarked_move(&state, args[index].expr, scopes, "the variadic list", &diagnostics) -> return false
                value = sema_tir_node(value.ty, TExprKind.Move{value: value}, value.span)
            }
        }
        lowered[index].value = ^value
        lowered[index].borrow = false
        lowered[index].mut_borrow = false
        lowered[index].widen_to_vec = false
    }
    true
}

fn sema_call_pack_variadic_arguments(typed: SemaCallTypedArguments, params: [SemaCallParam], lowered: [TCallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> [TCallArg]? {
    packed := [TCallArg]{}
    loop slot in 0..<params.len() {
        if !params[slot].variadic {
            loop index in 0..<lowered.len() {
                if typed.slots[index] == slot -> &packed.push(lowered[index])
            }
            next
        }
        list_ty :: sema_call_resolved_type(params[slot].ty ?? panic("checked variadic parameter has no type"), environment, program)
        element :: if list_ty == {
            .List(inner) -> inner
            else -> panic("checked variadic parameter is not a List")
        }
        tail := [TCallArg]{}
        loop index in 0..<lowered.len() {
            if typed.slots[index] == slot -> &tail.push(lowered[index])
        }
        if tail.len() == 1 && tail[0].spread {
            argument := tail[0]
            argument.spread = false
            &packed.push(^argument)
            next
        }
        has_spread :: loop argument in tail { if argument.spread -> break true } ?? false
        kind := TExprKind.List{values: [TExpr]{}, trait_coercion: None}
        if has_spread {
            if !sema_expression_list_check_clone(element, span, environment, program, &context, &diagnostics) -> return None
            parts := [TListSpreadPart]{}
            loop argument in tail {
                if argument.spread -> &parts.push(TListSpreadPart.Spread{value: argument.value})
                else -> &parts.push(TListSpreadPart.Element{value: argument.value})
            }
            kind = TExprKind.ListSpread{parts: ^parts}
        } else {
            values := [TExpr]{}
            loop argument in tail -> &values.push(argument.value)
            kind = TExprKind.List{values: ^values, trait_coercion: None}
        }
        value :: sema_tir_expr(list_ty, kind, span)
        &packed.push(TCallArg{
            value: ^value, template_items: [SymbolID]{},
            borrow: params[slot].convention == AccessConvention.Read,
            mut_borrow: params[slot].convention == AccessConvention.Write,
            fn_coerce: None,
            widen_to_vec: false, widen_to_union: None, box_as_trait: None,
            label: Val(params[slot].label), spread: false,
        })
    }
    Val(^packed)
}

// This path runs Ownership after expression typing and before lowering, so
// lowering happens only after the ownership check accepts and completes.
// Return the lowered arguments together with the declaration-slot
// temporaries placed before the call.
fn sema_call_check_bound_arguments_owned(state: &SemaOwnershipState, callee: String, params: [SemaCallParam], abi: SemaRegistrationCallableABI?, apply_lambda_escape_override: Bool, binding: SemaCallBinding, args: &[CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> (args: [TCallArg], pins: [TStmt])? {
    typed :: sema_call_typecheck_bound_arguments(callee, params, abi, apply_lambda_escape_override, binding, &args, environment, program, &scopes, &state, &tail_store, &context, span, &diagnostics, false) ?? return None
    ownership :: sema_ownership_check_call_arguments(&state, callee, params, &args, scopes, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return None
    lowered := sema_call_lower_bound_arguments(typed, params, &args, environment, program)
    if !sema_call_prepare_variadic_elements(typed, params, args, &lowered, environment, program, &scopes, &state, &context, &diagnostics) -> return None
    pins := sema_call_pin_binder_arguments(typed, params, &lowered, environment, program, scopes, span)
    packed :: sema_call_pack_variadic_arguments(typed, params, lowered, environment, program, &context, span, &diagnostics) ?? return None
    Val((args: ^packed, pins: ^pins))
}
