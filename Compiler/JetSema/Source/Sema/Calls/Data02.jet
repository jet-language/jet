//RS         "ObligationMode" => "write it only inside `#Unsafe(\"reason\", obligations: .Track)`",
//RS         "PolicySetting" => "write it only inside `#Policy(gc)`, `#Policy(copies: .Explicit)`, or another registered non-memory policy",
//RS         "Site" => "write it only as `$sites: [...]` on a `marker` declaration",
//RS         "State" => "write it only inside `#State(state: .Draft)` or `#Transition(from:, to:)`",
//RS         "TaintKind" => "it has no live marker: its only user was the retired `#Tainted`, now `#Input`",
//RS         "Target" => "write it only inside `#Target(target: Web)`",
