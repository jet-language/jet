// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:35
pub fn is_u8_ty(ty: &Type) -> Bool {
    if ty == .IntN{signed: false, bits: 8} -> true else -> false
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:46
pub fn email_method_return(ty: &Type, method: String, argc: USize) -> Type?? {
    if (ty, method, argc) == {
        (.Named(name), "envelope", 0) && name == "Message" -> Val(Val(Type.Named("Envelope")))
        (.Named(name), "with_envelope", 1) && name == "Message" -> Val(Val(result_ty(Type.Named("Message"), Type.Named("EmailError"))))
        (.Named(name), "send", 1) && name == "Mailer" -> Val(Val(result_ty(Type.Named("SendReport"), Type.Named("EmailError"))))
        _ -> None
    }
}
