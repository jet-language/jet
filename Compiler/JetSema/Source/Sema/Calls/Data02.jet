// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:110
pub fn data_renamed_to_datatree(span: Span) -> Diagnostic {
    Diagnostic.error("E0351", "the value tree is named `DataTree`, not `Data`", "`DataTree` is the one name a hand codec constructs and returns and every format's `parse` yields — its variants are `.Null`/`.Bool`/`.Int`/`.Float`/`.Text`/`.Array`/`.Object`", "write `DataTree` instead of `Data`", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:122
pub fn layout_handle_renamed_to_layout(span: Span) -> Diagnostic {
    Diagnostic.error("E2936", "the constraint-layout type is named `{Syntax.LAYOUT_TYPE}`, not `{Syntax.LAYOUT_HANDLE_TYPE_RETIRED}`", "`{Syntax.LAYOUT_TYPE}` is the solver/container value constructed by `name {Syntax.SIGIL_BIND_IMMUT} {Syntax.LAYOUT_TYPE}.{{ … }}`", "write `{Syntax.LAYOUT_TYPE}` instead of `{Syntax.LAYOUT_HANDLE_TYPE_RETIRED}`", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:148
pub fn retired_acronym_spelling_diag(old: String, canonical: String, span: Span) -> Diagnostic {
    diagnostic :: Diagnostic.error("E0358", "`{old}` is spelled `{canonical}`", "Jet keeps acronyms fully capitalized inside PascalCase names (D-ACRO-CASE1=A, D-ACRO-LEX1=A)", "write `{canonical}` instead of `{old}`", Val(span))
    if span.end.saturating_sub(span.start) != old.len() -> return diagnostic
    diagnostic.with_edit(TextEdit{span: span, new_text: canonical})
}
