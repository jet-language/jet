// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:542
pub fn core_task_failure_variants(enum_name: String) -> [String: (Span, VariantPayload)]? {
    if enum_name != Syntax.TYPE_TASK_FAILURE -> return None
    zero :: Span.new(0, 0)
    Val(["Cancelled": (zero, VariantPayload.Unit), "DeadlineBlown": (zero, VariantPayload.Unit), "Panicked": (zero, VariantPayload.Single(Type.String, zero))])
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:564
pub fn core_lang_variants(enum_name: String) -> [String: (Span, VariantPayload)]? {
    declaration :: jet_sema.Policy.rule_arg_declaration(enum_name) ?? return None
    zero :: Span.new(0, 0)
    Val(declaration.variants.iter().map(fn(variant) { (variant.clone(), (zero, VariantPayload.Unit)) }).collect())
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:579
pub fn core_history_variants(enum_name: String) -> [String: (Span, VariantPayload)]? {
    zero :: Span.new(0, 0)
    field :: fn(name: String, ty: Type) { VariantField{name: name, name_span: zero, ty: ty, ty_span: zero} }
    variants :: if enum_name == {
        "HistoryValue" -> [
            ("Integer", VariantPayload.Single(Type.Int, zero)),
            ("Boolean", VariantPayload.Single(Type.Bool, zero)),
            ("Text", VariantPayload.Single(Type.String, zero)),
            ("Handle", VariantPayload.Single(Type.Named("HandleID"), zero)),
            ("Redacted", VariantPayload.Single(Type.String, zero)),
        ]
        "HistoryPrecondition" -> [
            ("HandleLive", VariantPayload.Single(Type.Named("HandleID"), zero)),
            ("HandleState", VariantPayload.Named([field("handle", Type.Named("HandleID")), field("state", Type.String)])),
            ("TaskCompleted", VariantPayload.Single(Type.Named("TaskID"), zero)),
            ("EventAvailable", VariantPayload.Single(Type.Named("EventID"), zero)),
        ]
        _ -> return None
    }
    Val(variants.into_iter().map(fn((name, payload)) { (name, (zero, ^payload)) }).collect())
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:629
pub fn core_declared_enum_variants(enum_name: String) -> [String: (Span, VariantPayload)]? {
    if core_history_variants(enum_name) == .Val(variants) -> return Val(^variants)
    names :: jet_foundation.CoreModuleExports.core_enum_variants(enum_name) ?? return None
    zero :: Span.new(0, 0)
    Val(names.iter().map(fn(name) { (name.clone(), (zero, VariantPayload.Unit)) }).collect())
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/core_types.rs:647
pub fn core_fact_kind_variants(enum_name: String) -> [String: (Span, VariantPayload)]? {
    variants :: if enum_name == {
        "FactKind" -> {
            names := ["Effect", "State", "Tag"]
            for row in jet_foundation.Registry.fact_rows().filter(fn(row) { row.kind() == jet_foundation.Registry.RowKind.Plane }) {
                if jet_foundation.Registry.reflection_kind(row.name) == .Val(kind) {
                    if !names.contains(kind) -> names.push(kind)
                }
            }
            names
        }
        "Maturity" -> ["Experimental", "Tested", "Hardened"]
        "ExactnessKind" -> ["Exact", "Approximate", "Measured"]
        "ParamZone" -> ["PositionalOnly", "Either", "LabelOnly"]
        "UnitScaleProvenanceKind" -> ["Rational", "SymbolicPi", "Conventional", "Measured"]
        _ -> return None
    }
    zero :: Span.new(0, 0)
    Val(variants.into_iter().map(fn(variant) { (variant, (zero, VariantPayload.Unit)) }).collect())
}

