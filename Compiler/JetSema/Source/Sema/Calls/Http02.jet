// Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/method_calls.rs:6549-6581
fn infer_method_shared_guard_type_6549(self: &Checker, receiver: &Expr, recv_ty: Type) -> Type? {
    return if recv_ty == {
        .Tagged(marker, inner) -> {
            guarded :: if inner == {.Apply(name, _) -> name == Syntax.TYPE_SHARED_GUARD else -> false}
            if guarded && (marker == .Internal(.SharedGuardRead) || marker == .Internal(.SharedGuardEdit)) -> Val(recv_ty) else -> None
        }
        .Apply(name, _) -> {
            if name != Syntax.TYPE_SHARED_GUARD -> return None
            editable :: if receiver == {
                .Ident(variable, _) -> if self.lookup(variable) == .Val(info) -> info.param_conv == Val(AccessConvention.Write) else -> false
                else -> false
            }
            Val(Type.Tagged{marker: TagMarker.Internal(if editable -> InternalTag.SharedGuardEdit else -> InternalTag.SharedGuardRead), inner: recv_ty})
        }
        else -> None
    }
}
