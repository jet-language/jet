fn check_civil_method_arguments(self: &Checker, recv_name: String, method: String, args: &[CallArg]) {
    argc :: args.len()
    if (recv_name, method, argc) == {
        ("Date" | "LocalDate", "add_days" | "add_months", 1) -> self.expect_core_arg(method, 0, Type.Int, &args[0])
        ("Date" | "LocalDate", "diff_days" | "equal" | "compare", 1) -> self.expect_core_arg(method, 0, Type.Named{name: "LocalDate"}, &args[0])
        ("Date" | "LocalDate", "add_period" | "subtract_period", 1) -> self.expect_core_arg(method, 0, Type.Named{name: "Period"}, &args[0])
        ("Date" | "LocalDate", "truncate" | "format" | "format_checked", 1) -> self.expect_core_arg(method, 0, Type.String, &args[0])
        ("Date" | "LocalDate", "replace", 3) -> { loop i in 0..3 -> self.expect_core_arg(method, i, Type.Int, &args[i]) }
        ("Date" | "LocalDate", "with", n) -> {
            if n == 3 || n == 4 {
                loop i in 0..3 -> self.expect_core_arg(method, i, Type.Int, &args[i])
                if n == 4 -> self.expect_core_arg(method, 3, Type.String, &args[3])
            } else { loop arg in &args -> _ :: self.infer(&arg.expr) }
        }
        ("Date" | "LocalDate", "until" | "since", _) -> {
            self.expect_core_arg(method, 0, Type.Named{name: "LocalDate"}, &args[0])
            loop i in 1..argc.min(4) -> self.expect_core_arg(method, i, Type.String, &args[i])
            if argc > 4 -> self.expect_core_arg(method, 4, Type.Int, &args[4])
        }
        ("DateTime", "plus_duration" | "subtract_duration", 1) -> self.expect_core_arg(method, 0, Type.Named{name: "Duration"}, &args[0])
        ("DateTime", "add_nanoseconds", 1) -> self.expect_core_arg(method, 0, Type.Int, &args[0])
        ("DateTime", "equal" | "compare" | "difference", 1) -> self.expect_core_arg(method, 0, Type.Named{name: "DateTime"}, &args[0])
        ("DateTime", "add_period" | "subtract_period", 1) -> self.expect_core_arg(method, 0, Type.Named{name: "Period"}, &args[0])
