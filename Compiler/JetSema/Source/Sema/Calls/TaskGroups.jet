// Canonical task-group/task-surface checking and checked-tree producers.
//
// The state lives on SemaCheckContext so statement and expression walks share
// lexical groups, pending joins, and task-lambda boundaries.
use {
    jet_foundation.[
        AST_NODE_GENERATED,
        AccessConvention,
        Binding,
        Call,
        CallArg,
        Diagnostic,
        EffectRowEntry,
        Expr,
        Marker,
        NodeKind,
        ParamZone,
        Span,
        Stmt,
        SwitchArm,
        Symbol,
        SymbolID,
        SymbolKind,
        TBinaryOp,
        TBranchClass,
        TCapture,
        TCaptureFacts,
        TDeclarationOwnership,
        TEffectFacts,
        TEffectSpan,
        TFailureCarrier,
        TLetTy,
        TLetWrapper,
        TLocal,
        TOptionProbe,
        TaskGroupArgs,
        Type,
        TypeTupleField,
        UnOp,
        expr_source_span,
        expr_span,
        symbol_id,
        checked_symbol_local,
        checked_user_local,
        core_call,
        type_identity_equal,
        type_name,
    ]
    jet_parser.[parser_select_after_field]
}

SemaTaskGroupOrigin: enum {
    Lexical
    Parameter
}

SemaTaskGroupPendingSpawn: struct {
    binding: String?
    span: Span
}

SemaTaskGroupBorrow: struct {
    name: String
    place: SemaOwnershipPlace
    access: AccessConvention
    // Lent through a captured window (`left: &xs[0]`), which the parent
    // may no longer change or (for a write) read until the group joins.
    window: Bool{false}
}

SemaTaskGroupFrame: struct {
    name: String
    origin: SemaTaskGroupOrigin
    pending: [SemaTaskGroupPendingSpawn]
    borrows: [SemaTaskGroupBorrow]
    handle_span: Span
    synth_counter: Int
}

SemaTaskGroupState: struct {
    stack: [SemaTaskGroupFrame]
    in_spawn: Bool
    spawn_group_floor: Int
    scoped_loan_read_reported: Bool
    time_effects: [TEffectSpan]
    // (Rust `current_binding_name` / `task_spawn_binding_name`):
    // the binding whose initializer is being checked, and the binding a task
    // spawn initializes while its body is checked.
    binding_name: String?{None}
    spawn_binding: String?{None}
    // (Rust `view_borrow_escape_tasks` / `view_capture_tasks`): the
    // task bindings whose spawn captured a view borrow (E1106 at `.detach()`)
    // or failed sendability another way (E1103 at `.detach()`).
    detach_view_tasks: [String]{[String]{}}
    detach_unsound_tasks: [String]{[String]{}}
    // The lambda about to be checked is a `task` body. Its
    // lambda check consumes the fact, so nested lambdas never see it.
    spawn_body: Bool{false}
}

sema_taskgroup_state_init: fn() -> SemaTaskGroupState Never! {
    SemaTaskGroupState{
        stack: [SemaTaskGroupFrame]{},
        in_spawn: false,
        spawn_group_floor: 0,
        scoped_loan_read_reported: false,
        time_effects: [TEffectSpan]{},
    }
}

sema_taskgroup_state_snapshot: fn(source: SemaTaskGroupState) -> SemaTaskGroupState Never! {
    stack := [SemaTaskGroupFrame]{}
    loop frame in source.stack {
        pending := [SemaTaskGroupPendingSpawn]{}
        loop spawn in frame.pending -> pending.push(SemaTaskGroupPendingSpawn{binding: spawn.binding, span: spawn.span})
        borrows := [SemaTaskGroupBorrow]{}
        loop borrow in frame.borrows {
            borrows.push(SemaTaskGroupBorrow{
                name: borrow.name,
                place: sema_ownership_place_snapshot(borrow.place),
                access: borrow.access,
                window: borrow.window,
            })
        }
        stack.push(SemaTaskGroupFrame{
            name: frame.name,
            origin: frame.origin,
            pending: pending,
            borrows: borrows,
            handle_span: frame.handle_span,
            synth_counter: frame.synth_counter,
        })
    }
    effects := [TEffectSpan]{}
    loop time_effect in source.time_effects -> effects.push(time_effect.copy())
    SemaTaskGroupState{
        stack: stack,
        in_spawn: source.in_spawn,
        spawn_group_floor: source.spawn_group_floor,
        scoped_loan_read_reported: source.scoped_loan_read_reported,
        time_effects: effects,
        binding_name: source.binding_name,
        spawn_binding: source.spawn_binding,
        detach_view_tasks: source.detach_view_tasks.copy(),
        detach_unsound_tasks: source.detach_unsound_tasks.copy(),
        spawn_body: source.spawn_body,
    }
}

sema_taskgroup_frame: fn(name: String, origin: SemaTaskGroupOrigin, handle_span: Span) -> SemaTaskGroupFrame Never! {
    SemaTaskGroupFrame{
        name: name,
        origin: origin,
        pending: [SemaTaskGroupPendingSpawn]{},
        borrows: [SemaTaskGroupBorrow]{},
        handle_span: handle_span,
        synth_counter: 0,
    }
}

sema_taskgroup_core_key: fn(suffix: String) -> String Never! {
    bytes := [U8]{U8{0}, U8{106}, U8{101}, U8{116}, U8{46}, U8{116}, U8{97}, U8{115}, U8{107}}
    loop byte in suffix.bytes() -> bytes.push(byte)
    String.from_bytes(bytes) ?? ""
}

sema_taskgroup_internal_receiver: fn() -> String Never! { sema_taskgroup_core_key("") }
sema_taskgroup_internal_spawn_method: fn() -> String Never! { sema_taskgroup_core_key(".spawn") }
sema_taskgroup_internal_timeout_method: fn() -> String Never! { sema_taskgroup_core_key(".timeout") }
sema_taskgroup_internal_all_method: fn() -> String Never! { sema_taskgroup_core_key(".all") }
sema_taskgroup_internal_race_method: fn() -> String Never! { sema_taskgroup_core_key(".race") }
sema_taskgroup_internal_any_method: fn() -> String Never! { sema_taskgroup_core_key(".any") }

sema_taskgroup_is_internal_receiver: fn(receiver: Expr) -> Bool Never! {
    if receiver == {
        .Ident(name, _, _) -> name == sema_taskgroup_internal_receiver()
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

sema_taskgroup_stack_index: fn(state: SemaTaskGroupState, name: String) -> Int? {
    index := state.stack.len() - 1
    loop index >= 0 {
        if state.stack[index].name == name -> return Val(index)
        index -= 1
    }
    None
}

sema_taskgroup_active_index: fn(state: SemaTaskGroupState) -> Int? {
    if state.stack.len() == 0 -> return None
    Val(state.stack.len() - 1)
}
sema_taskgroup_spawn_group_index: fn(context: SemaCheckContext) -> Int? {
    sema_taskgroup_active_index(context.taskgroups)
}
 
sema_taskgroup_active_lexical_name: fn(state: SemaTaskGroupState) -> String? {
    index := state.stack.len() - 1
    loop index >= 0 {
        frame := state.stack[index]
        if frame.origin == SemaTaskGroupOrigin.Lexical -> return Val(frame.name)
        index -= 1
    }
    None
}

// (Rust `report_unsendable` in a task spawn context): an E1102 at a
// task capture or result records the task binding, so `.detach()` reports the
// right refusal: a view borrow is E1106, any other sendability failure E1103.
sema_taskgroup_note_detach_problem: fn(context: &SemaCheckContext, view_borrow: Bool) Never! {
    binding := context.taskgroups.binding_name
    if binding == None -> binding = context.taskgroups.spawn_binding
    name: binding ?? return
    if view_borrow {
        if !context.taskgroups.detach_view_tasks.contains(name) -> context.taskgroups.detach_view_tasks.push(name)
    } else {
        if !context.taskgroups.detach_unsound_tasks.contains(name) -> context.taskgroups.detach_unsound_tasks.push(name)
    }
}

sema_taskgroup_push_parameter: fn(context: &SemaCheckContext, name: String) Never! {
    context.taskgroups.stack.push(sema_taskgroup_frame(name, SemaTaskGroupOrigin.Parameter, Span{start: 0, end: 0}))
}

// Hands the parent's ownership checks the places running children hold. A
// child's own body sees none: there the loan is what makes the access legal.
sema_taskgroup_publish_loans: fn(context: SemaCheckContext, state: &SemaOwnershipState) Never! {
    loans := [SemaOwnershipGroupLoan]{}
    if !context.taskgroups.in_spawn {
        loop frame in context.taskgroups.stack {
            loop held in frame.borrows {
                if held.window -> loans.push(SemaOwnershipGroupLoan{name: held.name, group: frame.name, place: sema_ownership_place_snapshot(held.place), access: held.access})
            }
        }
    }
    state.group_loans = loans
}

sema_taskgroup_note_time_effect: fn(context: &SemaCheckContext, span: Span) Never! {
    loop fact in context.taskgroups.time_effects {
        if fact.name == "Time" && fact.span.start == span.start && fact.span.end == span.end -> return
    }
    context.taskgroups.time_effects.push(TEffectSpan{name: "Time", span: span})
}

sema_taskgroup_register_spawn: fn(context: &SemaCheckContext, group_name: String, binding: String?, span: Span) Never! {
    index: sema_taskgroup_stack_index(context.taskgroups, group_name) ?? return
    if context.taskgroups.in_spawn && index < context.taskgroups.spawn_group_floor -> return
    context.taskgroups.stack[index].pending.push(SemaTaskGroupPendingSpawn{
        binding: binding,
        span: span,
    })
}

sema_taskgroup_expression_moved: fn(state: &SemaOwnershipState, expression: Expr, scopes: SemaScopeTable) -> Bool {
    places := sema_ownership_places_from_expr_in_state(expression, scopes, state)
    loop place in places {
        if sema_ownership_place_moved(state, place) != None -> return true
    }
    false
}

sema_taskgroup_move_spawn_binding: fn(name: String, span: Span, scopes: SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    expression := Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
    if sema_taskgroup_expression_moved(state, expression, scopes) -> return
    places := sema_ownership_places_from_expr_in_state(expression, scopes, state)
    if places.len() == 0 -> return
    _ := sema_ownership_mark_move(state, expression, scopes, "the task group", diagnostics)
}

sema_taskgroup_mark_spawns_owned: fn(context: &SemaCheckContext, origin: SemaTaskGroupOrigin, scopes: SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    frames := [SemaTaskGroupFrame]{}
    if {
        origin == SemaTaskGroupOrigin.Lexical -> {
            if context.taskgroups.stack.len() > 0 -> frames.push(context.taskgroups.stack[context.taskgroups.stack.len() - 1])
        }
        else -> {
            loop frame in context.taskgroups.stack {
                if frame.origin == SemaTaskGroupOrigin.Parameter -> frames.push(frame.copy())
            }
        }
    }
    loop frame in frames {
        loop spawn in frame.pending {
            if spawn.binding == .Val(name) -> sema_taskgroup_move_spawn_binding(name, spawn.span, scopes, state, diagnostics)
        }
    }
}

sema_taskgroup_receiver_ok: fn(receiver: Expr, span: Span, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    name: if receiver == {
        .Ident(value, _, _) -> value
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> ""
    }
    if name == "" {
        diagnostics.push(sema_error("E1110", span, "a task-group receiver must name an active `Group`", "a group is a scoped spawn authority, not a value that can be computed or copied", "use the active group name directly, or pass `group: Group` to this function"))
        return false
    }
    index: sema_scope_resolve_index(scopes, name) ?? {
        diagnostics.push(sema_error("E1110", span, "`{name}` is not an active task group", "a group handle is valid only in the scope that owns its join", "use the lexical group name inside `task.group`, or pass a live `Group` parameter"))
        return false
    }
    binding: scopes.bindings[index]
    frame_index := sema_taskgroup_stack_index(context.taskgroups, name)
    if binding.symbol.ty != Val(Type.Named{name: "Group"}) || frame_index == None {
        diagnostics.push(sema_error("E1110", span, "`{name}` is not an active task group", "a group handle is valid only in the scope that owns its join", "use the lexical group name inside `task.group`, or pass a live `Group` parameter"))
        return false
    }
    frame: context.taskgroups.stack[frame_index ?? 0]
    if frame.origin == SemaTaskGroupOrigin.Parameter || sema_taskgroup_active_lexical_name(context.taskgroups) == (Val(name)) -> return true
    active: sema_taskgroup_active_lexical_name(context.taskgroups) ?? ""
    diagnostics.push(sema_error("E1110", span, "`task` must use the active task group `{active}`, not `{name}`", "each lexical `task.group` block owns its spawns; a helper can instead receive a `Group` parameter", "write the spawn in the active group, or pass its handle to `helper: fn(group: Group)`"))
    false
}

// The largest stack a task group may ask for: the runtime caps every worker
// and fiber stack at 8 GiB (Thread.jet THREAD_STACK_MAXIMUM).
SEMA_TASKGROUP_STACK_MAXIMUM: 8589934592

sema_taskgroup_check_statement: fn(name: String, name_span: Span, args: TaskGroupArgs, body: [Stmt], span: Span, return_type: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> TStmt? {
    checked_limit := TExpr?{None}
    checked_stack := TExpr?{None}
    valid := true
    if args.limit == .Val(expression) {
        checked: sema_check_expression(expression, None, environment, program, scopes, state, tail_store, context, diagnostics)
        if checked == {
            .Val(value) -> {
                if !sema_expr_is_integer(value.ty) {
                    diagnostics.push(sema_error("E0112", expr_span(expression), "a task-group limit must be an integer", "the limit bounds the number of concurrently running children", "use an Int or inline-range value"))
                    valid = false
                }
                checked_limit = Val(value)
            }
            .None -> {
                valid = false
            }
        }
    }
    if args.stack == .Val(expression) {
        if !sema_taskgroup_check_stack_literal(expression, environment, program, scopes, diagnostics) -> valid = false
        checked: sema_check_expression(expression, None, environment, program, scopes, state, tail_store, context, diagnostics)
        if checked == {
            .Val(value) -> {
                if !sema_expr_is_integer(value.ty) {
                    diagnostics.push(sema_error("E0112", expr_span(expression), "a task-group stack must be an integer", "the stack is the least number of bytes each task of the group runs on", "use an Int byte count, e.g. `stack: 256 * 1024 * 1024`"))
                    valid = false
                }
                checked_stack = Val(value)
            }
            .None -> {
                valid = false
            }
        }
    }
    owner := "task.group@{name_span.start}"
    sema_scope_enter(scopes, state, owner)
    symbol_owner := sema_scope_local_owner_key(scopes)
    id := symbol_id(SymbolKind.Local, environment.module_identity, symbol_owner, name)
    symbol := Symbol{id: id, kind: SymbolKind.Local, name: name, module_name: environment.module_identity, owner: Val(symbol_owner), span: name_span, ty: Val(Type.Named{name: "Group"}), visibility: 0}
    if {
        !sema_scope_declare_local(scopes, symbol, false, AccessConvention.Read, None, false) -> {
            diagnostics.push(sema_already_defined(name, name_span))
            valid = false
        }
        else -> {
            sema_ownership_declare_binding(state, symbol, false)
            group_ref: sema_check_expression(Expr.Ident{name: name, span: name_span, id: AST_NODE_GENERATED}, Val(Type.Named{name: "Group"}), environment, program, scopes, state, tail_store, context, diagnostics)
            if group_ref == None -> valid = false
        }
    }
    context.taskgroups.stack.push(sema_taskgroup_frame(name, SemaTaskGroupOrigin.Lexical, name_span))
    nested := sema_check_statements(body, return_type, environment, program, scopes, state, tail_store, context, diagnostics, loop_depth)
    sema_taskgroup_mark_spawns_owned(context, SemaTaskGroupOrigin.Lexical, scopes, state, diagnostics)
    if context.taskgroups.stack.len() > 0 -> _ := context.taskgroups.stack.pop()
    sema_taskgroup_publish_loans(context, state)
    sema_single_use_leave_scope(scopes, state, diagnostics)
    if !nested.complete || !valid -> return None
    group_local := checked_symbol_local(name, name_span, id, Type.Named{name: "Group"})
    TStmt.TaskGroup{group: group_local, args: TTaskGroupArgs{limit: checked_limit, stack: checked_stack}, body: nested.value, span: span}
}

// A `stack:` the target cannot supply is a build error: a web target has no
// per-task stack to size, and a native target supplies 1 byte to 8 GiB. A
// count only known when the group opens is capped by the runtime instead.
sema_taskgroup_check_stack_literal: fn(expression: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    machine: sema_hardware_target_machine(environment, program)
    if machine == .Val(target) {
        if target.name == "wasm.browser" {
            diagnostics.push(sema_error("E-WEB-UNSUPPORTED", expr_span(expression), "the web target `{target.name}` cannot give a task group its own stack size", "browser tasks run on the host's one JavaScript stack, which a program cannot size", "drop `stack:` from this task group, or build it for a native target"))
            return false
        }
    }
    bytes: sema_expr_lint_int_constant(expression, scopes) ?? return true
    if bytes >= 1 && bytes <= SEMA_TASKGROUP_STACK_MAXIMUM -> return true
    diagnostics.push(sema_error("E0112", expr_span(expression), "a task-group stack of {bytes} bytes is outside what this target supplies", "a native task stack is 1 byte to 8 GiB (8589934592 bytes)", "ask for 1 to 8589934592 bytes, e.g. `stack: 256 * 1024 * 1024`"))
    false
}

// The check is inside a `task.group` body the current body owns, not in a
// spawned child's body outside its own groups.
sema_taskgroup_in_group_body: fn(context: SemaCheckContext) -> Bool Never! {
    context.taskgroups.stack.len() > context.taskgroups.spawn_group_floor
}

sema_taskgroup_contains_name: fn(names: [String], name: String) -> Bool Never! {
    loop existing in names { if existing == name -> return true }
    false
}

sema_taskgroup_failure_result: fn(ok: Type) -> Type Never! {
    Type.Result{ok: ok, err: Type.Named{name: "TaskFailure"}}
}

sema_taskgroup_task_element: fn(ty: Type) -> Type? {
    if ty == {
        .Apply(name, args) -> {
            if name == "Task" && args.len() == 1 -> return Val(args[0])
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {}
    }
    None
}

sema_taskgroup_check_discarded_arguments: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    saved_binding := context.taskgroups.binding_name
    context.taskgroups.binding_name = None
    loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
    context.taskgroups.binding_name = saved_binding
}

sema_taskgroup_check_arity: fn(args: [CallArg], expected: Int, label: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if args.len() == expected -> return true
    diagnostics.push(sema_error("E0104", span, "`{label}` takes {expected} argument{if expected == 1 -> "" else -> "s"}, got {args.len()}", "the task surface has a fixed callable/result contract", "pass exactly {expected} argument{if expected == 1 -> "" else -> "s"}"))
    sema_taskgroup_check_discarded_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
    false
}

sema_taskgroup_callable_effects: fn(signature: Type) -> TEffectFacts Never! {
    direct := [String]{}
    spans := [TEffectSpan]{}
    effect_row := [EffectRowEntry]?{None}
    if signature == {
        .Fn(_, _, effects, _, _, _) -> { effect_row = effects }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {}
    }
    if effect_row == .Val(entries) {
        loop entry in entries {
            if !sema_taskgroup_contains_name(direct, entry.name) -> direct.push(entry.name)
            spans.push(TEffectSpan{name: entry.name, span: entry.span})
        }
    }
    return TEffectFacts{direct: direct, solved: direct, call_edges: [String]{}, maximal: effect_row == None, direct_spans: spans}
}

sema_taskgroup_callable_wrapper: fn(value: TExpr, signature: Type, span: Span, context: SemaCheckContext) -> TLambda? {
    params := [Type]{}
    ret := Type?{None}
    if signature == {
        .Fn(source_params, source_ret, _, _, _, _) -> {
            params = source_params
            ret = source_ret
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> return None
    }
    result_ty := ret ?? Type.Named{name: "Unit"}
    captures := [TCapture]{}
    capture_facts := TCaptureFacts{escapes: true, needs_fn_mut: false, mutable: [String]{}, cloned: [String]{}, frozen: [String]{}, materialized: [String]{}, moved: [String]{}}
    if value.kind == {
        // A function or constant reference is a flat row (sema_node).
        .Flat(index) -> if context.arena.tree.nodes[index - context.arena.tree.node_base].kind == {
            .ConstRef(_) -> {}
            .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) -> return None
        }
        .Local(local) -> {
            captures.push(TCapture{source: local.name, local: local, ty: signature})
            capture_facts.moved.push(local.name)
        }
        .IntLit(_, _) | .StrLit(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) -> return None
    }
    body := sema_tree_node(result_ty, TExprKind.IndirectCall{callee: value, type_args: [Type]{}, args: [TCallArg]{}, signature: signature}, span)
    Val(TLambda{
        executable: TLambdaBody.Expr{value: body},
        source_span: span,
        frame_schedule: None,
        frame_schedule_derivation: None,
        capture_facts: capture_facts,
        failure_carrier: sema_expression_failure_carrier(result_ty),
        effects: sema_taskgroup_callable_effects(signature),
        host_param_conventions: None,
        source_params: [String]{},
        source_param_symbols: [SymbolID]{},
        param_types: params,
        ret: ret,
        is_move: captures.len() > 0,
        boxed: false,
        rc: false,
        captures: captures,
        materialized_captures: [String]{},
        frozen_captures: [String]{},
        uses_stack_sentry: false,
    })
}

sema_taskgroup_call_body_result: fn(signature: Type) -> Type? {
    if signature == {
        .Fn(_, ret, _, _, _, _) -> { return Val(ret ?? Type.Named{name: "Unit"}) }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> { return None }
    }
}

sema_taskgroup_task_group_expr: fn(context: &SemaCheckContext, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, diagnostics: &[Diagnostic], span: Span) -> TExpr? {
    index: sema_taskgroup_spawn_group_index(context) ?? return None
    name := context.taskgroups.stack[index].name
    // The group reference is checked on a copy of the context; only its
    // expression-type rows come back.
    updated_context := context.copy()
    group: sema_check_expression(Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}, Val(Type.Named{name: "Group"}), environment, program, scopes, state, tail_store, updated_context, diagnostics)
    sema_check_context_return_expr_ids(updated_context, context)
    group
}

sema_taskgroup_check_lambda_captures: fn(lambda: TLambda, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) {
    loop capture in lambda.captures {
        if capture.ty == (Type.Named{name: "Group"}) {
            diagnostics.push(sema_error("E1110", span, "`{capture.source}` is a `Group` and cannot escape in a task", "a group is a scoped spawn authority and only lives until its owning block joins", "pass `group: Group` to a direct helper instead of capturing the handle"))
            next
        }
        taken := sema_ownership_crossing_capture_taken(lambda, capture, environment, program, context.generic_params)
        frozen := sema_taskgroup_contains_name(lambda.capture_facts.frozen, capture.source)
        materialized := sema_taskgroup_contains_name(lambda.capture_facts.materialized, capture.source)
        borrowed := Bool?{None}
        // A read window the body materializes still names the place it lends
        // from, so a `task.group` child borrows that place like Rust's
        // `admit_scoped_borrow`, which runs before any view materialization.
        if !taken && !frozen {
            borrowed = sema_taskgroup_admit_capture_borrow(capture, lambda.capture_facts, span, scopes, state, context, diagnostics)
        }
        // A scoped `task.group` borrow is admitted, but a detached task could
        // outlive it (Rust `view_borrow_escape_tasks`).
        if borrowed == (Val(true)) -> sema_taskgroup_note_detach_problem(context, true)
        if borrowed == (Val(true)) || borrowed == (Val(false)) -> next
        problem := sema_ownership_crossing_problem_for_name(capture.source, capture.ty, SemaSendCrossing.TaskCapture, taken, environment, program, scopes, state, context)
        if problem == .Val(value) {
            sema_taskgroup_note_detach_problem(context, value.kind == SemaSendProblemKind.ViewBorrow)
            diagnostics.push(sema_ownership_crossing_diagnostic(capture.source, capture.ty, value, SemaSendCrossing.TaskCapture, span))
            next
        }
        // A capture the body writes is refused: the task runs beside its
        // owner. A `.move()` or a frozen snapshot removes the outer alias, a shared
        // handle orders its own crossing, and the owner of a window the task
        // also captures is judged through that window.
        if taken || frozen || materialized || sema_taskgroup_shared_capture(capture.ty) || sema_taskgroup_window_owner(lambda, capture.source, state) -> next
        if sema_taskgroup_contains_name(lambda.capture_facts.mutable, capture.source) {
            diagnostics.push(sema_ownership_crossing_concurrent_write_diagnostic(capture.source, "task capture", span))
        }
    }
}

sema_taskgroup_window_owner: fn(lambda: TLambda, owner: String, state: SemaOwnershipState) -> Bool Never! {
    loop view in state.views {
        if !view.active || view.invalidated || view.source.root != owner || view.carrier == owner -> next
        loop capture in lambda.captures {
            if capture.source == view.carrier -> return true
        }
    }
    false
}

// A capture that aliases one lock-ordered cell: `Shared<T>`, a `Condition`
// wait set, a reactive handle, or a Cell guard.
sema_taskgroup_shared_capture: fn(ty: Type) -> Bool Never! {
    shared: if ty == {
        .Shared(_) -> true
        .Named(name) -> name == "Condition"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
    shared || sema_function_reactive_handle_type(ty) || sema_cell_guard_contained(ty)
}

sema_taskgroup_admit_capture_borrow: fn(capture: TCapture, facts: TCaptureFacts, span: Span, scopes: SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool? {
    if context.taskgroups.stack.len() == 0 -> return None
    active_index := context.taskgroups.stack.len() - 1
    if context.taskgroups.stack[active_index].origin != SemaTaskGroupOrigin.Lexical -> return None
    name := capture.source
    expression := Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
    place := SemaOwnershipPlace?{None}
    window := false
    access := if sema_taskgroup_contains_name(facts.mutable, name) -> AccessConvention.Write else -> AccessConvention.Read
    symbol: capture.local.symbol_id ?? return None
    loop binding_index in 0..<scopes.bindings.len() {
        if scopes.bindings[binding_index].symbol.id.key == symbol.key && scopes.bindings[binding_index].symbol.name == name {
            if scopes.bindings[binding_index].access == AccessConvention.Write -> access = AccessConvention.Write
        }
    }
    loop view in state.views {
        if view.active && !view.invalidated && sema_ownership_view_fact_matches_expr(view, expression, scopes) {
            place = Val(sema_ownership_place_snapshot(view.source))
            access = view.access
            window = true
            break
        }
    }
    if place == None {
        binding_index: sema_scope_resolve_index(scopes, name) ?? return None
        binding := scopes.bindings[binding_index]
        if binding.symbol.kind == SymbolKind.Parameter && (binding.access == AccessConvention.Read || binding.access == AccessConvention.Write) {
            places := sema_ownership_places_from_expr_in_state(expression, scopes, state)
            if places.len() > 0 -> place = Val(places[0])
            if binding.access == AccessConvention.Write -> access = AccessConvention.Write
        }
    }
    if place == None -> return None
    admitted: sema_taskgroup_admit_scoped_borrow(context, name, place ?? SemaOwnershipPlace{root: name, root_key: "", root_span: span, projections: [String]{}, typed_projections: [SemaOwnershipProjection]{}}, access, window, span, scopes, diagnostics)
    sema_taskgroup_publish_loans(context, state)
    admitted
}

sema_taskgroup_admit_scoped_borrow: fn(context: &SemaCheckContext, name: String, place: SemaOwnershipPlace, access: AccessConvention, window: Bool, span: Span, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool? {
    if context.taskgroups.stack.len() == 0 -> return None
    active_index := context.taskgroups.stack.len() - 1
    active := context.taskgroups.stack[active_index]
    if active.origin != SemaTaskGroupOrigin.Lexical -> return None
    if place.root_span.start > active.handle_span.start -> return None
    conflict_name := String?{None}
    loop frame in context.taskgroups.stack {
        loop held in frame.borrows {
            if sema_ownership_places_overlap(held.place, place) && (access == AccessConvention.Write || held.access == AccessConvention.Write) {
                conflict_name = Val(held.name)
                break
            }
        }
        if conflict_name != None -> break
    }
    if conflict_name == .Val(other) {
        what := if other == name -> "`{name}` is already lent to another task" else -> "`{name}` and `{other}` can reach the same place at the same time"
        diagnostics.push(sema_error("E1101", span, what, "children of a task group run concurrently, so overlapping places cannot include a write borrow", "give the task owned data, freeze it, use `Shared{{…}}`, or borrow provably separate fields"))
        return Val(false)
    }
    context.taskgroups.stack[active_index].borrows.push(SemaTaskGroupBorrow{name: name, place: sema_ownership_place_snapshot(place), access: access, window: window})
    Val(true)
}

// A child holding a write loan runs beside the parent, so a parent read of
// that place races the child's writes. Sequentially a read beside a live
// write view is fine, which is why this rule belongs to task groups and not
// to the general view model.
sema_taskgroup_check_scoped_loan_read: fn(context: &SemaCheckContext, expression: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    if context.taskgroups.scoped_loan_read_reported -> return
    // Almost no expression runs while a child holds a loan.
    if state.group_loans.len() == 0 -> return
    is_place_read := if expression == {
        .Index(_, _, _, _, _) | .Field(_, _, _, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
    if !is_place_read -> return
    places: sema_ownership_places_from_expr_in_state(expression, scopes, state)
    if places.len() == 0 -> return
    loop held in state.group_loans {
        if held.access == AccessConvention.Write && sema_ownership_places_overlap(held.place, places[0]) {
            context.taskgroups.scoped_loan_read_reported = true
            read_name: sema_ownership_place_name(places[0])
            diagnostics.push(sema_error("E1101", expr_span(expression), "`{read_name}` cannot be read while `{held.name}` is lent to a task in `{held.group}`", "`{held.name}` is an exclusive write borrow held by a running child, so reading `{read_name}` here would race that task's writes", "read `{read_name}` after the `{held.group}` block ends, give it away with `task &&{held.name}`, freeze it with `freeze`, or share it with `Shared{{…}}`"))
            return
        }
    }
}

sema_taskgroup_collect_branch_moves: fn(expression: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    if expression == {
        .Ident(_, _, _) -> sema_taskgroup_mark_branch_move(expression, scopes, state, diagnostics)
        .Paren(inner, _, _) -> sema_taskgroup_collect_branch_moves(inner, scopes, state, diagnostics)
        .ListLit(values, _, _) -> loop value in values -> sema_taskgroup_collect_branch_moves(value, scopes, state, diagnostics)
        .TupleLit(fields, _, _, _) -> loop field in fields -> sema_taskgroup_collect_branch_moves(field.value, scopes, state, diagnostics)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

sema_taskgroup_mark_branch_move: fn(expression: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    if sema_taskgroup_expression_moved(state, expression, scopes) -> return
    places := sema_ownership_places_from_expr_in_state(expression, scopes, state)
    if places.len() > 0 -> _ := sema_ownership_mark_move(state, expression, scopes, "the task group combinator", diagnostics)
}

sema_taskgroup_check_branches: fn(args: [CallArg], span: Span, method: String, all: Bool, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if !sema_taskgroup_check_arity(args, 1, method, span, environment, program, scopes, state, tail_store, context, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    empty := if args[0].expr == {
        .ListLit(values, _, _) -> values.len() == 0
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
    if empty {
        diagnostics.push(sema_error("E1112", expr_span(args[0].expr), "`{method}` needs at least one task branch", "a task combinator must have a child to join or select", "write `{method}` {{ work() }} with one or more branches"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    saved_binding := context.taskgroups.binding_name
    context.taskgroups.binding_name = None
    branches := sema_check_expression(args[0].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
    context.taskgroups.binding_name = saved_binding
    values: branches ?? return SemaMethodSpecialCheck{handled: true, value: None}
    result_ty := Type?{None}
    if values.ty == {
        .List(inner) -> {
            elem: sema_taskgroup_task_element(inner) ?? {
                diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{method}` needs task branches, not `{type_name(values.ty)}`", "each branch must produce one Task result", "write `{method}([task_a, task_b])` with Task values"))
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            result_ty = Val(if all -> Type.List{element: elem} else -> elem)
        }
        .Tuple(fields) -> {
            if !all {
                diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{method}` needs a list of task branches, not a named tuple", "race and any choose one completed task from a list", "write a list of Task values"))
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            result_fields := [TypeTupleField]{}
            loop field in fields {
                result_elem: sema_taskgroup_task_element(field.ty) ?? {
                    diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{method}` field `{field.name}` is not a Task", "each named branch must produce one Task result", "give every named branch a Task value"))
                    return SemaMethodSpecialCheck{handled: true, value: None}
                }
                result_fields.push(TypeTupleField{name: field.name, ty: result_elem})
            }
            result_ty = Val(Type.Tuple{fields: result_fields})
        }
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> {
            diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{method}` needs task branches, not `{type_name(values.ty)}`", "the combinator consumes a List<Task<T>> or, for all, a named tuple of Tasks", "pass a list of Task values"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    sema_taskgroup_collect_branch_moves(args[0].expr, scopes, state, diagnostics)
    sema_taskgroup_note_time_effect(context, span)
    ok: result_ty ?? Type.Named{name: "Unit"}
    result_type := sema_taskgroup_failure_result(ok)
    operation := if {
        all -> TExprKind.TaskGroupAll{tasks: values}
        else -> {
            if {
                method == sema_taskgroup_internal_race_method() -> TExprKind.TaskGroupRace{tasks: values}
                else -> TExprKind.TaskGroupAny{tasks: values}
            }
        }
    }
    checked := sema_expr_expected_owned(sema_tree_expr(result_type, operation, span), expected, environment, program, diagnostics)
    return SemaMethodSpecialCheck{handled: true, value: checked}
}

sema_taskgroup_check_spawn: fn(args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if !sema_taskgroup_check_arity(args, 1, "task", span, environment, program, scopes, state, tail_store, context, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    saved_in_spawn := context.taskgroups.in_spawn
    saved_floor := context.taskgroups.spawn_group_floor
    saved_binding_name := context.taskgroups.binding_name
    saved_spawn_binding := context.taskgroups.spawn_binding
    saved_spawn_body := context.taskgroups.spawn_body
    context.taskgroups.in_spawn = true
    sema_taskgroup_publish_loans(context, state)
    context.taskgroups.spawn_group_floor = context.taskgroups.stack.len()
    context.taskgroups.spawn_binding = saved_binding_name
    context.taskgroups.binding_name = None
    context.taskgroups.spawn_body = if args[0].expr == {
        .Lambda(_, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
    checked_body := sema_check_expression_with_lambda_escapes(args[0].expr, None, environment, program, scopes, state, tail_store, context, Val(true), diagnostics)
    context.taskgroups.spawn_body = saved_spawn_body
    context.taskgroups.in_spawn = saved_in_spawn
    sema_taskgroup_publish_loans(context, state)
    context.taskgroups.spawn_group_floor = saved_floor
    context.taskgroups.binding_name = saved_binding_name
    context.taskgroups.spawn_binding = saved_spawn_binding
    body: checked_body ?? return SemaMethodSpecialCheck{handled: true, value: None}
    body_ty: sema_taskgroup_call_body_result(body.ty) ?? {
        diagnostics.push(sema_error("E0112", args[0].span, "`task` needs a callable body, not `{type_name(body.ty)}`", "a spawned task executes one zero-parameter callable on a worker thread", "pass a zero-parameter lambda or function"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    lambda := if body.kind == {
        .Lambda(value) -> value
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> sema_taskgroup_callable_wrapper(body, body.ty, args[0].span, context) ?? {
        diagnostics.push(sema_error("E0112", args[0].span, "`task` needs a callable body that can be captured for execution", "the worker closure must retain the callable until the task runs", "use a lambda or a direct function value"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    }
    if lambda.param_types.len() != 0 {
        diagnostics.push(sema_error("E0104", args[0].span, "`task` needs a zero-parameter body, got {lambda.param_types.len()} parameters", "a task body captures values from the enclosing scope instead of taking arguments", "move or capture data rather than declaring lambda parameters"))
    }
    if body.kind == {
        .Lambda(_) -> { sema_function_reactive_note_task_lambda(context, lambda) }
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {}
    }
    // Rust infer_task_spawn reports the capture and result crossings at
    // `expr` of `task expr`, which the parser wraps in a zero-parameter
    // expression lambda (parser_task_spawn); a call's span is its name.
    capture_span := args[0].span
    spawned_span := expr_span(args[0].expr)
    if args[0].expr == .Lambda(spawn_lambda, _) {
        if spawn_lambda.params.len() == 0 && spawn_lambda.body == .Expr(spawned) {
            spawned_span = expr_span(spawned)
            // Only a bare call body is spelled at its name; a braced body
            // `task { … }` and other expressions keep the whole span.
            call: if spawned == {
                .Call(_, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) -> true
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
            }
            if call && expr_source_span(spawned).start == spawn_lambda.span.start -> capture_span = spawned_span
        }
    }
    sema_taskgroup_check_lambda_captures(lambda, capture_span, environment, program, scopes, state, context, diagnostics)
    task_result_ty := body_ty
    problem := sema_ownership_crossing_problem(task_result_ty, SemaSendCrossing.TaskResult, false, environment, program, scopes, context)
    if problem == .Val(value) {
        sema_taskgroup_note_detach_problem(context, value.kind == SemaSendProblemKind.ViewBorrow)
        diagnostics.push(sema_ownership_crossing_diagnostic("this task", task_result_ty, value, SemaSendCrossing.TaskResult, spawned_span))
    }
    group := TExpr?{None}
    if sema_taskgroup_spawn_group_index(context) != None {
        group = sema_taskgroup_task_group_expr(context, environment, program, scopes, state, tail_store, diagnostics, span)
        if group == None -> return SemaMethodSpecialCheck{handled: true, value: None}
    }
    task_type := Type.Apply{name: "Task", args: [Type]{task_result_ty}}
    kind := TCoreClosureKind.Spawn{group: group, site: span.start, label: None, executable: lambda}
    value := sema_tree_node(task_type, TExprKind.CoreClosureCall{kind: kind}, span)
    if group != None {
        index: sema_taskgroup_active_index(context.taskgroups) ?? 0
        group_name := context.taskgroups.stack[index].name
        sema_taskgroup_register_spawn(context, group_name, saved_binding_name, span)
    }
    checked := sema_expr_expected(value, expected, environment, program, diagnostics)
    return SemaMethodSpecialCheck{handled: true, value: checked}
}

sema_taskgroup_check_surface_method: fn(receiver: Expr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if !sema_taskgroup_is_internal_receiver(receiver) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if method == sema_taskgroup_internal_spawn_method() -> return sema_taskgroup_check_spawn(args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if method == sema_taskgroup_internal_timeout_method() {
        if !sema_taskgroup_check_arity(args, 1, "task.timeout", span, environment, program, scopes, state, tail_store, context, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        duration: sema_check_expression(args[0].expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        if duration.ty != (Type.Named{name: "Duration"}) {
            diagnostics.push(sema_error("E0112", args[0].span, "`task.timeout` needs a Duration, not `{type_name(duration.ty)}`", "task timeouts use a canonical Time delta", "pass a Duration value"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        sema_taskgroup_note_time_effect(context, span)
        // The Duration installs the task deadline through
        // the registered `core.time.__task_timeout` row (Rust
        // jet_task_timeout_duration_ns); the next wait point past it stops.
        record: core_call("core.time", "__task_timeout") ?? {
            diagnostics.push(sema_error("E0906", span, "the canonical `core.time.__task_timeout` route for `task.timeout` is unavailable", "a task timeout installs its deadline through the registered Core row", "restore the registered `core.time.__task_timeout` route"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        value := sema_tree_node(Type.Named{name: "Unit"}, TExprKind.CoreCall{record: record, args: [TExpr]{duration}, source_span: span, type_args: [Type]{}, widen_to_vec: [Bool]{false}, fallibility: TFailureCarrier.Infallible}, span)
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
    }
    if method == sema_taskgroup_internal_all_method() || method == sema_taskgroup_internal_race_method() || method == sema_taskgroup_internal_any_method() {
        all := method == sema_taskgroup_internal_all_method()
        label := if {
            all -> "task.all"
            else -> {
                if {
                    method == sema_taskgroup_internal_race_method() -> "task.race"
                    else -> "task.any"
                }
            }
        }
        return sema_taskgroup_check_branches(args, span, label, all, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}

sema_taskgroup_check_group_method: fn(receiver: Expr, receiver_ty: Type, method: String, args: [CallArg], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if receiver_ty != (Type.Named{name: "Group"}) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_taskgroup_receiver_ok(receiver, span, scopes, context, diagnostics) {
        sema_taskgroup_check_discarded_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    message := if method == "select" -> "`Group` has no method `select`" else -> "`Group` has no method `{method}`"
    why := if method == "select" -> "readiness waits are subjectless `if` tables on plain endpoints" else -> "task groups use the `task` surface; Group values do not own readiness waits"
    fix := if method == "select" -> "write a subjectless readiness table" else -> "write `task work()`, `task.all(…)`, or a subjectless readiness table"
    diagnostics.push(sema_error("E0102", span, message, why, fix))
    sema_taskgroup_check_discarded_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
    SemaMethodSpecialCheck{handled: true, value: None}
}

sema_taskgroup_task_payload: fn(ty: Type) -> Type? {
    if ty == {
        .Apply(name, args) -> if name == "Task" && args.len() == 1 -> Val(args[0]) else -> None
        .Tagged(_, inner) -> sema_taskgroup_task_payload(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// The core `Task<T>` handle, not a user type that shadows the name.
sema_taskgroup_is_canonical_task: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
        if sema_type_resolve_nominal_row(graph, ty, environment.module_identity) != None -> return false
        owner: sema_registration_core_builtin_owner(graph, "Task") ?? return false
        return owner.ownership == TDeclarationOwnership.Owned
    } else {
        return false
    }
}

// `Task<T>.join()` and `.detach()` consume the handle.
// join returns `T !TaskFailure` and blocks (`Time.Wait`). The element T is
// retained even when it is itself an outcome; only the task's wait failure
// occupies the outer rail. A detach returns nothing.
sema_taskgroup_check_task_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if (method != "join" && method != "detach") || args.len() != 0 -> return SemaMethodSpecialCheck{handled: false, value: None}
    payload: sema_taskgroup_task_payload(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_taskgroup_is_canonical_task(receiver_value.ty, environment, program) -> return SemaMethodSpecialCheck{handled: false, value: None}
    // (Rust builtin `Task.detach`): a task whose spawn captured a
    // view borrow may outlive it (E1106); one with any other sendability
    // failure is unsound to run unsupervised (E1103).
    if method == "detach" && receiver == .Ident(name, _, _) {
        if context.taskgroups.detach_view_tasks.contains(name) {
            diagnostics.push(sema_error("E1106", span, "can't detach task `{name}` — it captured a `view` borrow that may not live long enough", "a detached task runs unsupervised and may outlive the caller; a captured `view` would dangle", "pass an owned `copy`, or a `Shared<T>` handle, to the task instead of a `view`"))
        } else if context.taskgroups.detach_unsound_tasks.contains(name) {
            diagnostics.push(sema_error("E1103", span, "can't detach task `{name}` — it captured a value that can't cross a thread boundary", "a detached task runs unsupervised; it must only hold values it owns cleanly", "fix the E1102 error at the spawn site first, then `.detach()` is safe"))
        }
    }
    if !sema_ownership_check_method_receiver(state, receiver, AccessConvention.Move, method, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    join := method == "join"
    result_type := if join -> sema_taskgroup_failure_result(payload) else -> Type.Named{name: "Unit"}
    operation := if join -> THandleOp.TaskJoin else -> THandleOp.TaskDetach
    value := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{}}, span)
    checked: sema_expression_call_expected(value, expected, environment, program, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    effect_name := if join -> "Time.Wait" else -> ""
    if !sema_stream_handle_effect_fact(environment, program, scopes, context, "Task.{method}", span, result_type, effect_name, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}

// Rust `task_method_return` (jet-foundation): the task handle's control-plane
// hooks over the coroutine substrate. `pause` takes an optional mode, and every
// hook reads the handle (it is not consumed) and returns nothing. The arguments
// carry no declared type (Rust `builtin_method_arg_types` gives Task none), so
// they are inferred as written.
sema_taskgroup_check_task_control: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    selected: if {
        method == "pause" && (args.len() == 0 || args.len() == 1) -> Val(THandleOp.TaskPause)
        method == "resume" && args.len() == 0 -> Val(THandleOp.TaskResume)
        method == "cancel" && args.len() == 0 -> Val(THandleOp.TaskCancel)
        else -> THandleOp?{None}
    }
    operation: selected ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if sema_taskgroup_task_payload(receiver_value.ty) == None || !sema_taskgroup_is_canonical_task(receiver_value.ty, environment, program) -> return SemaMethodSpecialCheck{handled: false, value: None}
    typed := [TExpr]{}
    loop argument in args {
        value: sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        typed.push(value)
    }
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    result_type: Type.Named{name: "Unit"}
    value := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: typed}, span)
    checked: sema_expression_call_expected(value, expected, environment, program, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_stream_handle_effect_fact(environment, program, scopes, context, "Task.{method}", span, result_type, "", diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}

sema_channel_capacity_literal: fn(expr: Expr) -> Int? Never! {
    if expr == {
        .Int(value, _, _, raw, _) -> Val(sema_expr_exact_integer_literal(value, raw))
        .Paren(inner, _, _) -> sema_channel_capacity_literal(inner)
        .Unary(op, inner, _, _) -> {
            if op == UnOp.Neg {
                value: sema_channel_capacity_literal(inner) ?? return None
                return Val(-value)
            }
            None
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_call_check_channel: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if call.args.len() > 1 {
        sema_stream_handle_infer_args(call.args, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_arity_diagnostic("channel", 1, call.args.len(), false, call.name_span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if call.type_args.len() != 1 {
        sema_stream_handle_infer_args(call.args, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_error("E0904", call.name_span, "`channel` needs a type argument to infer the element type", "the element type `T` cannot be guessed from an empty channel", "call it with an explicit type argument: `channel<T>()`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    params := [SemaCallParam]{}
    if call.args.len() == 1 {
        params.push(SemaCallParam{label: "capacity", name: "capacity", zone: ParamZone.Either, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.Int), variadic: false})
    }
    values: sema_stream_handle_checked_args("channel", params, call.args, None, None, AccessConvention.Read, 0, call.name_span, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if call.args.len() == 1 {
        if sema_channel_capacity_literal(call.args[0].expr) == .Val(capacity) {
            if capacity < 1 {
                diagnostics.push(sema_error("E0395", expr_span(call.args[0].expr), "A channel capacity must be at least 1, not `{capacity}`.", "A bounded channel holds at least one value; Jet has no zero-capacity rendezvous channel, and a capacity below 1 is never clamped. A runtime capacity below 1 stops the program (E3001).", "Write `channel<T>(capacity: 1)` or larger, or `channel<T>()` for an unbounded channel."))
                return SemaDirectSpecialCheck{handled: true, value: None}
            }
        }
    }
    element := sema_call_resolved_type(call.type_args[0], environment, program)
    result_type := Type.Tuple{fields: [TypeTupleField]{
        {name: "sender", ty: Type.Apply{name: "Sender", args: [Type]{element}}},
        {name: "receiver", ty: Type.Apply{name: "Receiver", args: [Type]{element}}},
    }}
    member: if call.args.len() == 0 -> "__channel_new" else -> "__channel_bounded"
    record: sema_call_core_record("core.tasks", member, values.len(), call.name_span, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    value: sema_call_core_tree(record, values, call.name_span, [Type]{element}, [Bool]{}, result_type, TFailureCarrier.Infallible, expected, environment, program, diagnostics)
    SemaDirectSpecialCheck{handled: true, value: value}
}

// A readiness arm head (Rust `AST::readiness_head`): the parser carries
// `value, receiver` and `after duration` in a one-field tuple whose `after`
// field name no source can spell.
SemaReadinessHead: enum {
    Receive(binding: String, source: Expr)
    After(duration: Expr)
}

// One checked readiness arm. `ordinal` counts the arms of its own kind in
// source order: the scheduler numbers receive arms first, then timer arms.
SemaReadinessArm: enum {
    Receive(local: TLocal, receiver: TExpr, ordinal: Int)
    After(duration: TExpr, ordinal: Int)
}

// The arms of one readiness table as they are checked; an arm whose head did
// not check is None.
SemaReadinessTable: struct {
    arms: [SemaReadinessArm?]
    element: Type?
    receivers: Int
    timers: Int
}

sema_readiness_head: fn(cond: Expr) -> SemaReadinessHead? Never! {
    if cond == {
        .TupleLit(fields, _, _, _) -> {
            if fields.len() != 1 -> return None
            if fields[0].name == parser_select_after_field() -> return Val(SemaReadinessHead.After{duration: fields[0].value})
            Val(SemaReadinessHead.Receive{binding: fields[0].name, source: fields[0].value})
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

// Rust `check_switch`: a subjectless table with any readiness arm is a
// readiness table, not a table of Boolean guards.
sema_readiness_is_table: fn(arms: [SwitchArm]) -> Bool Never! {
    index := 0
    loop index < arms.len() {
        if sema_readiness_head(arms[index].cond) != None -> return true
        index += 1
    }
    false
}

sema_readiness_table_new: fn() -> SemaReadinessTable Never! {
    SemaReadinessTable{arms: [SemaReadinessArm?]{}, element: None, receivers: 0, timers: 0}
}

sema_readiness_receiver_payload: fn(ty: Type) -> Type? Never! {
    if ty == {
        .Apply(name, args) -> if name == "Receiver" && args.len() == 1 -> Val(args[0]) else -> None
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// Rust `check_readiness_switch`, one arm head: a receive arm validates one
// plain `Receiver<T>` and returns the payload binding its body declares; an
// `after` arm validates one `Duration` and records the Time effect.
sema_readiness_check_head: fn(cond: Expr, table: &SemaReadinessTable, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaConditionBinding? {
    cond_span: expr_span(cond)
    head: sema_readiness_head(cond) ?? {
        diagnostics.push(sema_error("E0112", cond_span, "a readiness table cannot mix channel arms with Boolean guards", "every arm in one readiness table waits on a Receiver<T> or a Duration", "write `value, receiver -> ...` or move the Boolean guard to a separate `if`"))
        table.arms.push(None)
        return None
    }
    if head == {
        .Receive(binding, source) -> {
            source_span: expr_span(source)
            checked: sema_check_expression(source, None, environment, program, scopes, state, tail_store, context, diagnostics)
            payload := Type.Named{name: "Unit"}
            if checked == .Val(receiver) {
                if sema_readiness_receiver_payload(receiver.ty) == .Val(element) {
                    payload = element
                } else {
                    diagnostics.push(sema_error("E0112", source_span, "a readiness receive arm needs Receiver<T>, not {sema_type_show(receiver.ty)}", "a receive arm waits on one plain channel endpoint", "use the receiver returned by `channel<T>()`"))
                }
            }
            if table.element == .Val(previous) {
                if !type_identity_equal(previous, payload) -> diagnostics.push(sema_error("E0112", source_span, "readiness receive arms must share one element type, got {sema_type_show(previous)} and {sema_type_show(payload)}", "one readiness table returns one receive payload type", "use receivers with the same T, or split the table"))
            } else {
                table.element = Val(payload)
            }
            owner: sema_scope_local_owner_key(scopes)
            id: symbol_id(SymbolKind.Local, environment.module_identity, owner, binding)
            symbol: Symbol{id: id, kind: SymbolKind.Local, name: binding, module_name: environment.module_identity, owner: Val(owner), span: cond_span, ty: Val(payload), visibility: 0}
            if checked == .Val(receiver) {
                table.arms.push(Val(SemaReadinessArm.Receive{local: checked_symbol_local(binding, cond_span, id, payload), receiver: receiver, ordinal: table.receivers}))
            } else {
                table.arms.push(None)
            }
            table.receivers += 1
            return Val(SemaConditionBinding{symbol: symbol, window: false, sources: [Expr]{}})
        }
        .After(duration) -> {
            checked: sema_check_expression(duration, None, environment, program, scopes, state, tail_store, context, diagnostics)
            shown := "this value"
            is_duration := false
            if checked == .Val(value) {
                is_duration = value.ty == (Type.Named{name: "Duration"})
                shown = sema_type_show(value.ty)
            }
            if !is_duration -> diagnostics.push(sema_error("E0112", expr_span(duration), "`after` needs a Duration, not {shown}", "a readiness timeout is one canonical Duration delta", "write `after 100ms` or pass a Duration binding"))
            sema_taskgroup_note_time_effect(context, cond_span)
            if checked == .Val(value) {
                table.arms.push(Val(SemaReadinessArm.After{duration: value, ordinal: table.timers}))
            } else {
                table.arms.push(None)
            }
            table.timers += 1
            return None
        }
    }
}

sema_readiness_result_field: fn(result: TLocal, result_ty: Type, index: Int, ty: Type, span: Span) -> TExpr Never! {
    base: sema_tree_node(result_ty, TExprKind.Local{local: result}, span)
    sema_tree_node(ty, TExprKind.HostCall{call: THostCall.TupleIndex{base: base, index: index}}, span)
}

// Rust `lower_readiness_switch`: one scheduler wait over every arm in source
// order, which yields `(arm, value: T?)`, then one dense integer dispatch on
// the selected arm. A receive arm unwraps its payload only once it is
// selected; a timer arm never reads it. An `else` makes the wait nonblocking.
sema_readiness_tree: fn(table: &&SemaReadinessTable, branches: &&[SemaStatementResult], else_result: &&[TStmt]?, span: Span, context: &SemaCheckContext) -> TStmt? {
    owned_table := table.move()
    owned_branches := branches.move()
    if owned_branches.len() != owned_table.arms.len() -> return None
    element: owned_table.element ?? Type.Named{name: "Unit"}
    builder_ty: Type.Named{name: "__JetReadinessTable"}
    payload_ty: Type.Option{inner: element}
    result_ty: Type.Tuple{fields: [TypeTupleField]{
        {name: "arm", ty: Type.Int},
        {name: "value", ty: payload_ty},
    }}
    result_local: checked_user_local("__select_result", span, result_ty)
    // The wait reads the builder chain from the outer node inward, so the
    // chain is built from the last arm back to keep source order.
    builder := sema_node(context, builder_ty, NodeKind.SelectStart, span)
    reversed := [TMixedArm]{}
    loop owned_table.arms.len() > 0 {
        row := owned_table.arms.pop() ?? return None
        arm := row.move() ?? return None
        branch := owned_branches.pop() ?? return None
        body := [TStmt]{}
        selected := 0
        if arm == {
            .Receive(local, receiver, ordinal) -> {
                selected = ordinal
                payload: sema_tree_node(element, TExprKind.HostCall{call: THostCall.OptionProbe{inner: sema_readiness_result_field(result_local, result_ty, 1, payload_ty, span), kind: TOptionProbe.Unwrap}}, span)
                body.push(TStmt.Let{local: local, let_ty: TLetTy.Annotated{ty: element, wrapper: TLetWrapper.Plain}, init: payload, gc_promotion: None, gc_transferred: false, span: local.span})
                builder = sema_tree_node(builder_ty, TExprKind.SelectRecv{builder: builder.move(), channel: receiver}, span)
            }
            .After(duration, ordinal) -> {
                selected = owned_table.receivers + ordinal
                builder = sema_tree_node(builder_ty, TExprKind.SelectAfter{builder: builder.move(), duration: duration, value: None}, span)
            }
        }
        loop statement in branch.value.move() -> body.push(statement)
        condition: sema_tree_node(Type.Bool, TExprKind.Binary{op: TBinaryOp.Eq, overflow: false, line: 0, lhs: sema_readiness_result_field(result_local, result_ty, 0, Type.Int, span), rhs: sema_tree_node(Type.Int, TExprKind.IntLit{value: selected, width: None}, span)}, span)
        reversed.push(TMixedArm{condition: condition, body: body})
    }
    dispatch := [TMixedArm]{}
    loop reversed.len() > 0 {
        dispatch_arm := reversed.pop() ?? return None
        dispatch.push(dispatch_arm)
    }
    nonblocking: else_result != None
    builder_row: sema_arena_adopt(context, builder)
    wait: sema_node(context, result_ty, NodeKind.SelectWait{builder: builder_row, nonblocking: nonblocking}, span)
    subject: sema_readiness_result_field(result_local, result_ty, 0, Type.Int, span)
    Val(TStmt.Inline{body: [TStmt]{
        TStmt.Let{local: result_local, let_ty: TLetTy.Inferred, init: wait, gc_promotion: None, gc_transferred: false, span: span},
        TStmt.MixedSwitch{subject: subject, class: TBranchClass.DenseInt, arms: dispatch, else_body: else_result.move(), span: span},
    }, span: span})
}
