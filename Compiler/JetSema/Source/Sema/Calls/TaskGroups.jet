// Canonical task-group/task-surface checking and TIR producers.
//
// The state lives on SemaCheckContext so statement and expression walks share
// lexical groups, pending joins, and task-lambda boundaries.
use jet_foundation.[
    AccessConvention,
    Binding,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    Marker,
    Span,
    Stmt,
    Symbol,
    SymbolID,
    SymbolKind,
    TCallArg,
    TCapture,
    TCaptureFacts,
    TCoreClosureKind,
    TEffectFacts,
    TEffectSpan,
    TExpr,
    TExprKind,
    TLambda,
    TLambdaBody,
    TStmt,
    Type,
    TypeTupleField,
    expr_span,
    symbol_id,
    tir_symbol_local,
    type_name,
]

pub enum SemaTaskGroupOrigin {
    Lexical
    Parameter
}

pub struct SemaTaskGroupPendingSpawn {
    pub binding: String?
    pub span: Span
}

pub struct SemaTaskGroupBorrow {
    pub name: String
    pub place: SemaOwnershipPlace
    pub access: AccessConvention
}

pub struct SemaTaskGroupFrame {
    pub name: String
    pub origin: SemaTaskGroupOrigin
    pub pending: [SemaTaskGroupPendingSpawn]
    pub borrows: [SemaTaskGroupBorrow]
    pub handle_span: Span
    pub synth_counter: Int
}

pub struct SemaTaskGroupState {
    pub stack: [SemaTaskGroupFrame]
    pub in_spawn: Bool
    pub spawn_group_floor: Int
    pub scoped_loan_read_reported: Bool
    pub current_binding: String?
    pub time_effects: [TEffectSpan]
}

pub fn sema_taskgroup_state_init() -> SemaTaskGroupState Never! {
    SemaTaskGroupState{
        stack: [SemaTaskGroupFrame]{},
        in_spawn: false,
        spawn_group_floor: 0,
        scoped_loan_read_reported: false,
        current_binding: None,
        time_effects: [TEffectSpan]{},
    }
}

pub fn sema_taskgroup_state_snapshot(source: SemaTaskGroupState) -> SemaTaskGroupState Never! {
    stack := [SemaTaskGroupFrame]{}
    loop frame in source.stack {
        pending := [SemaTaskGroupPendingSpawn]{}
        loop spawn in frame.pending -> &pending.push(SemaTaskGroupPendingSpawn{binding: spawn.binding, span: spawn.span})
        borrows := [SemaTaskGroupBorrow]{}
        loop borrow in frame.borrows {
            &borrows.push(SemaTaskGroupBorrow{
                name: borrow.name,
                place: sema_ownership_place_snapshot(borrow.place),
                access: borrow.access,
            })
        }
        &stack.push(SemaTaskGroupFrame{
            name: frame.name,
            origin: frame.origin,
            pending: pending,
            borrows: borrows,
            handle_span: frame.handle_span,
            synth_counter: frame.synth_counter,
        })
    }
    effects := [TEffectSpan]{}
    loop time_effect in source.time_effects -> &effects.push(time_effect)
    SemaTaskGroupState{
        stack: stack,
        in_spawn: source.in_spawn,
        spawn_group_floor: source.spawn_group_floor,
        scoped_loan_read_reported: source.scoped_loan_read_reported,
        current_binding: source.current_binding,
        time_effects: effects,
    }
}

fn sema_taskgroup_frame(name: String, origin: SemaTaskGroupOrigin, handle_span: Span) -> SemaTaskGroupFrame Never! {
    SemaTaskGroupFrame{
        name: name,
        origin: origin,
        pending: [SemaTaskGroupPendingSpawn]{},
        borrows: [SemaTaskGroupBorrow]{},
        handle_span: handle_span,
        synth_counter: 0,
    }
}

fn sema_taskgroup_core_key(suffix: String) -> String Never! {
    bytes := [U8]{U8{0}, U8{106}, U8{101}, U8{116}, U8{46}, U8{116}, U8{97}, U8{115}, U8{107}}
    loop byte in suffix.bytes() -> &bytes.push(byte)
    String.from_bytes(bytes) ?? ""
}

pub fn sema_taskgroup_internal_receiver() -> String Never! { sema_taskgroup_core_key("") }
pub fn sema_taskgroup_internal_surface_type() -> String Never! { sema_taskgroup_core_key(".surface") }
pub fn sema_taskgroup_internal_group_surface_type() -> String Never! { sema_taskgroup_core_key(".group.surface") }
pub fn sema_taskgroup_internal_spawn_method() -> String Never! { sema_taskgroup_core_key(".spawn") }
pub fn sema_taskgroup_internal_timeout_method() -> String Never! { sema_taskgroup_core_key(".timeout") }
pub fn sema_taskgroup_internal_all_method() -> String Never! { sema_taskgroup_core_key(".all") }
pub fn sema_taskgroup_internal_race_method() -> String Never! { sema_taskgroup_core_key(".race") }
pub fn sema_taskgroup_internal_any_method() -> String Never! { sema_taskgroup_core_key(".any") }

pub fn sema_taskgroup_is_internal_receiver(receiver: Expr) -> Bool Never! {
    if receiver == {
        .Ident(name, _) -> name == sema_taskgroup_internal_receiver()
        else -> false
    }
}

fn sema_taskgroup_stack_index(state: SemaTaskGroupState, name: String) -> Int? {
    index := state.stack.len() - 1
    loop index >= 0 {
        if state.stack[index].name == name -> return Val(index)
        index -= 1
    }
    None
}

fn sema_taskgroup_active_index(state: SemaTaskGroupState) -> Int? {
    if state.stack.len() == 0 -> return None
    Val(state.stack.len() - 1)
}
fn sema_taskgroup_spawn_group_index(context: SemaCheckContext) -> Int? {
    sema_taskgroup_active_index(context.taskgroups)
}
 
fn sema_taskgroup_active_lexical_name(state: SemaTaskGroupState) -> String? {
    index := state.stack.len() - 1
    loop index >= 0 {
        frame := state.stack[index]
        if frame.origin == SemaTaskGroupOrigin.Lexical -> return Val(frame.name)
        index -= 1
    }
    None
}

pub fn sema_taskgroup_set_current_binding(context: &SemaCheckContext, name: String?) -> String? {
    previous := context.taskgroups.current_binding
    context.taskgroups.current_binding = name
    previous
}

pub fn sema_taskgroup_push_parameter(context: &SemaCheckContext, name: String) Never! {
    &context.taskgroups.stack.push(sema_taskgroup_frame(name, SemaTaskGroupOrigin.Parameter, Span{start: 0, end: 0}))
}

pub fn sema_taskgroup_note_time_effect(context: &SemaCheckContext, span: Span) Never! {
    loop fact in context.taskgroups.time_effects {
        if fact.name == "Time" && fact.span.start == span.start && fact.span.end == span.end -> return
    }
    &context.taskgroups.time_effects.push(TEffectSpan{name: "Time", span: span})
}

pub fn sema_taskgroup_merge_time_effects(context: &SemaCheckContext, effects: [TEffectSpan]) Never! {
    loop time_effect in effects {
        if time_effect.name == "Time" -> sema_taskgroup_note_time_effect(&context, time_effect.span)
    }
}

pub fn sema_taskgroup_register_spawn(context: &SemaCheckContext, group_name: String, span: Span) Never! {
    index :: sema_taskgroup_stack_index(context.taskgroups, group_name) ?? return
    if context.taskgroups.in_spawn && index < context.taskgroups.spawn_group_floor -> return
    &context.taskgroups.stack[index].pending.push(SemaTaskGroupPendingSpawn{
        binding: context.taskgroups.current_binding,
        span: span,
    })
}

fn sema_taskgroup_expression_moved(state: &SemaOwnershipState, expression: Expr, scopes: SemaScopeTable) -> Bool {
    places := sema_ownership_places_from_expr_in_state(expression, scopes, &state)
    loop place in places {
        if sema_ownership_place_moved(&state, place) != None -> return true
    }
    false
}

fn sema_taskgroup_move_spawn_binding(name: String, span: Span, scopes: SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    expression := Expr.Ident{name: name, span: span}
    if sema_taskgroup_expression_moved(&state, expression, scopes) -> return
    places := sema_ownership_places_from_expr_in_state(expression, scopes, &state)
    if places.len() == 0 -> return
    _ := sema_ownership_mark_move(&state, expression, scopes, "the task group", &diagnostics)
}

pub fn sema_taskgroup_mark_spawns_owned(context: &SemaCheckContext, origin: SemaTaskGroupOrigin, scopes: SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    frames := [SemaTaskGroupFrame]{}
    if {
        origin == SemaTaskGroupOrigin.Lexical -> {
            if context.taskgroups.stack.len() > 0 -> &frames.push(context.taskgroups.stack[context.taskgroups.stack.len() - 1])
        }
        else -> {
            loop frame in context.taskgroups.stack {
                if frame.origin == SemaTaskGroupOrigin.Parameter -> &frames.push(frame)
            }
        }
    }
    loop frame in frames {
        loop spawn in frame.pending {
            if spawn.binding == .Val(name) -> sema_taskgroup_move_spawn_binding(name, spawn.span, scopes, &state, &diagnostics)
        }
    }
}

pub fn sema_taskgroup_mark_spawn_owned(context: &SemaCheckContext, name: String, span: Span, scopes: SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    loop frame in context.taskgroups.stack {
        loop spawn in frame.pending {
            if spawn.binding == .Val(pending) && pending == name {
                sema_taskgroup_move_spawn_binding(name, spawn.span, scopes, &state, &diagnostics)
                return
            }
        }
    }
}

pub fn sema_taskgroup_receiver_ok(receiver: Expr, span: Span, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    name :: if receiver == {.Ident(value, _) -> value else -> ""}
    if name == "" {
        &diagnostics.push(sema_error("E1110", span, "a task-group receiver must name an active `Group`", "a group is a scoped spawn authority, not a value that can be computed or copied", "use the active group name directly, or pass `group: Group` to this function"))
        return false
    }
    index :: sema_scope_resolve_index(scopes, name) ?? {
        &diagnostics.push(sema_error("E1110", span, "`{name}` is not an active task group", "a group handle is valid only in the scope that owns its join", "use the lexical group name inside `task.group`, or pass a live `Group` parameter"))
        return false
    }
    binding :: scopes.bindings[index]
    frame_index := sema_taskgroup_stack_index(context.taskgroups, name)
    if binding.symbol.ty != Val(Type.Named{name: "Group"}) || frame_index == None {
        &diagnostics.push(sema_error("E1110", span, "`{name}` is not an active task group", "a group handle is valid only in the scope that owns its join", "use the lexical group name inside `task.group`, or pass a live `Group` parameter"))
        return false
    }
    frame :: context.taskgroups.stack[frame_index ?? 0]
    if frame.origin == SemaTaskGroupOrigin.Parameter || sema_taskgroup_active_lexical_name(context.taskgroups) == .Val(name) -> return true
    active :: sema_taskgroup_active_lexical_name(context.taskgroups) ?? ""
    &diagnostics.push(sema_error("E1110", span, "`task` must use the active task group `{active}`, not `{name}`", "each lexical `task.group` block owns its spawns; a helper can instead receive a `Group` parameter", "write the spawn in the active group, or pass its handle to `fn helper(group: Group)`"))
    false
}

pub fn sema_taskgroup_rewrite_anonymous_spawn(statement: Stmt, context: &SemaCheckContext) -> Stmt? {
    expression :: if statement == {.Expr(value) -> value else -> { return None }}
    if context.taskgroups.stack.len() == 0 -> return None
    if expression == {
        .MethodCall(receiver, method, _, _, _, _, _, _, _, _) -> {
            if method != sema_taskgroup_internal_spawn_method() -> return None
            canonical := sema_taskgroup_is_internal_receiver(receiver)
            if !canonical {
                receiver_name :: if receiver == {.Ident(name, _) -> name else -> { return None }}
                if sema_taskgroup_stack_index(context.taskgroups, receiver_name) == None -> return None
            }
        }
        else -> { return None }
    }
    frame_index := context.taskgroups.stack.len() - 1
    frame := context.taskgroups.stack[frame_index]
    serial := frame.synth_counter
    context.taskgroups.stack[frame_index].synth_counter = serial + 1
    span := expr_span(expression)
    name := sema_taskgroup_core_key(".group.task.{span.start}.{serial}")
    span_name := span
    init := Binding{
        mutable: false,
        markers: [Marker]{},
        reactive_upgrade: false,
        meta: None,
        name: name,
        name_span: span_name,
        sigil_span: None,
        pattern: None,
        ty: None,
        ty_span: None,
        init: expression,
        is_comptime: false,
        ct: None,
        uninit: false,
        arena_view: false,
        string_view: false,
        gc_promotion: None,
        gc_transferred: false,
    }
    return Val(Stmt.Val{binding: init})
}

pub fn sema_taskgroup_check_statement(name: String, name_span: Span, limit: Expr?, body: [Stmt], span: Span, return_type: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic], loop_depth: Int) -> TStmt? {
    checked_limit := TExpr?{None}
    valid := true
    if limit == .Val(expression) {
        checked :: sema_check_expression(expression, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        if checked == {
            .Val(value) -> {
                if !sema_expr_is_integer(value.ty) {
                    &diagnostics.push(sema_error("E0112", expr_span(expression), "a task-group limit must be an integer", "the limit bounds the number of concurrently running children", "use an Int or inline-range value"))
                    valid = false
                }
                checked_limit = Val(value)
            }
            else -> {
                valid = false
            }
        }
    }
    owner := "task.group@{name_span.start}"
    sema_scope_enter(&scopes, &state, owner)
    symbol_owner := sema_scope_local_owner_key(scopes)
    id := symbol_id(SymbolKind.Local, environment.module_identity, symbol_owner, name)
    symbol := Symbol{id: id, kind: SymbolKind.Local, name: name, module_name: environment.module_identity, owner: Val(symbol_owner), span: name_span, ty: Val(Type.Named{name: "Group"}), visibility: 0}
    if {
        !sema_scope_declare_local(&scopes, symbol, false, AccessConvention.Read, None, false) -> {
            &diagnostics.push(sema_already_defined(name, name_span))
            valid = false
        }
        else -> {
            sema_ownership_declare_binding(&state, symbol, false)
            group_ref :: sema_check_expression(Expr.Ident{name: name, span: name_span}, Val(Type.Named{name: "Group"}), environment, &scopes, &state, &tail_store, &context, &diagnostics)
            if group_ref == None -> valid = false
        }
    }
    &context.taskgroups.stack.push(sema_taskgroup_frame(name, SemaTaskGroupOrigin.Lexical, name_span))
    nested := sema_check_statements(body, return_type, environment, &scopes, &state, &tail_store, &context, &diagnostics, loop_depth)
    sema_taskgroup_mark_spawns_owned(&context, SemaTaskGroupOrigin.Lexical, scopes, &state, &diagnostics)
    if context.taskgroups.stack.len() > 0 -> _ := &context.taskgroups.stack.pop()
    sema_scope_leave(&scopes, &state)
    if !nested.complete || !valid -> return None
    group_local := tir_symbol_local(name, name_span, id)
    TStmt.TaskGroup{group: group_local, limit: checked_limit, body: nested.value, span: span}
}

fn sema_taskgroup_contains_name(names: [String], name: String) -> Bool Never! {
    loop existing in names { if existing == name -> return true }
    false
}

fn sema_taskgroup_failure_result(ok: Type) -> Type Never! {
    Type.Result{ok: ok, err: Type.Named{name: "TaskFailure"}}
}

fn sema_taskgroup_success_type(ty: Type) -> Type Never! {
    return if ty == {
        .Result(ok, _) -> ok
        else -> ty
    }
}

fn sema_taskgroup_task_success(ty: Type) -> Type? {
    if ty == {
        .Apply(name, args) -> {
            if name == "Task" && args.len() == 1 -> return Val(sema_taskgroup_success_type(args[0]))
        }
        else -> {}
    }
    None
}

fn sema_taskgroup_check_discarded_arguments(args: [CallArg], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    saved_binding := context.taskgroups.current_binding
    context.taskgroups.current_binding = None
    loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    context.taskgroups.current_binding = saved_binding
}

fn sema_taskgroup_check_arity(args: [CallArg], expected: Int, label: String, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if args.len() == expected -> return true
    &diagnostics.push(sema_error("E0104", span, "`{label}` takes {expected} argument{if expected == 1 -> "" else -> "s"}, got {args.len()}", "the task surface has a fixed callable/result contract", "pass exactly {expected} argument{if expected == 1 -> "" else -> "s"}"))
    sema_taskgroup_check_discarded_arguments(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    false
}

fn sema_taskgroup_callable_effects(signature: Type) -> TEffectFacts Never! {
    direct := [String]{}
    spans := [TEffectSpan]{}
    effect_row := [EffectRowEntry]?{None}
    if signature == {
        .Fn(_, _, effects, _, _, _) -> { effect_row = effects }
        else -> {}
    }
    if effect_row == .Val(entries) {
        loop entry in entries {
            if !sema_taskgroup_contains_name(direct, entry.name) -> &direct.push(entry.name)
            &spans.push(TEffectSpan{name: entry.name, span: entry.span})
        }
    }
    return TEffectFacts{direct: direct, solved: direct, call_edges: [String]{}, maximal: effect_row == None, direct_spans: spans}
}

fn sema_taskgroup_callable_wrapper(value: TExpr, signature: Type, span: Span) -> TLambda? {
    params := [Type]{}
    ret := Type?{None}
    if signature == {.Fn(source_params, source_ret, _, _, _, _) -> {params = source_params; ret = source_ret} else -> return None}
    result_ty := ret ?? Type.Named{name: "Unit"}
    captures := [TCapture]{}
    capture_facts := TCaptureFacts{escapes: true, needs_fn_mut: false, mutable: [String]{}, cloned: [String]{}, frozen: [String]{}, materialized: [String]{}, moved: [String]{}}
    if value.kind == {
        .ConstRef(_) -> {}
        .Local(local) -> {
            &captures.push(TCapture{source: local.name, local: local, ty: signature})
            &capture_facts.moved.push(local.name)
        }
        else -> return None
    }
    body := sema_tir_expr(result_ty, TExprKind.IndirectCall{callee: value, type_args: [Type]{}, args: [TCallArg]{}, signature: signature}, span)
    Val(TLambda{
        executable: TLambdaBody.Expr{value: body},
        source_span: span,
        frame_schedule: None,
        frame_schedule_derivation: None,
        capture_facts: capture_facts,
        failure_carrier: sema_expression_failure_carrier(result_ty),
        effects: sema_taskgroup_callable_effects(signature),
        host_param_conventions: None,
        source_params: [String]{},
        source_param_symbols: [SymbolID]{},
        jit_name: "task.callable@{span.start}",
        param_types: params,
        ret: ret,
        is_move: captures.len() > 0,
        boxed: false,
        rc: false,
        arc: false,
        captures: captures,
        materialized_captures: [String]{},
        frozen_captures: [String]{},
        uses_stack_sentry: false,
    })
}

fn sema_taskgroup_call_body_result(signature: Type) -> Type? {
    if signature == {
        .Fn(_, ret, _, _, _, _) -> { return Val(ret ?? Type.Named{name: "Unit"}) }
        else -> { return None }
    }
}


fn sema_taskgroup_task_group_expr(context: SemaCheckContext, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, diagnostics: &[Diagnostic], span: Span) -> TExpr? {
    updated_context := context
    index :: sema_taskgroup_spawn_group_index(updated_context) ?? return None
    name := updated_context.taskgroups.stack[index].name
    sema_check_expression(Expr.Ident{name: name, span: span}, Val(Type.Named{name: "Group"}), environment, &scopes, &state, &tail_store, &updated_context, &diagnostics)
}

fn sema_taskgroup_check_lambda_captures(lambda: TLambda, span: Span, environment: SemaScopeEnvironment, scopes: SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) {
    loop capture in lambda.captures {
        if capture.ty == (Type.Named{name: "Group"}) {
            &diagnostics.push(sema_error("E1110", span, "`{capture.source}` is a `Group` and cannot escape in a task", "a group is a scoped spawn authority and only lives until its owning block joins", "pass `group: Group` to a direct helper instead of capturing the handle"))
            next
        }
        taken := sema_ownership_crossing_capture_taken(lambda, capture, environment, context.generic_params)
        frozen := sema_taskgroup_contains_name(lambda.capture_facts.frozen, capture.source)
        materialized := sema_taskgroup_contains_name(lambda.capture_facts.materialized, capture.source)
        borrowed := Bool?{None}
        if !taken && !frozen && !materialized {
            borrowed = sema_taskgroup_admit_capture_borrow(capture, lambda.capture_facts, span, scopes, &state, &context, &diagnostics)
        }
        if borrowed == (Val(true)) || borrowed == (Val(false)) -> next
        problem := sema_ownership_crossing_problem_for_name(capture.source, capture.ty, SemaSendCrossing.TaskCapture, taken, environment, scopes, state, context)
        if problem == .Val(value) -> &diagnostics.push(sema_ownership_crossing_diagnostic(capture.source, capture.ty, value, SemaSendCrossing.TaskCapture, span))
    }
}

fn sema_taskgroup_admit_capture_borrow(capture: TCapture, facts: TCaptureFacts, span: Span, scopes: SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool? {
    if context.taskgroups.stack.len() == 0 -> return None
    active_index := context.taskgroups.stack.len() - 1
    if context.taskgroups.stack[active_index].origin != SemaTaskGroupOrigin.Lexical -> return None
    name := capture.source
    expression := Expr.Ident{name: name, span: span}
    place := SemaOwnershipPlace?{None}
    access := if sema_taskgroup_contains_name(facts.mutable, name) -> AccessConvention.Write else -> AccessConvention.Read
    symbol :: capture.local.symbol_id ?? return None
    loop binding in scopes.bindings {
        if binding.symbol.id.key == symbol.key && binding.symbol.name == name {
            if binding.access == AccessConvention.Write -> access = AccessConvention.Write
        }
    }
    loop view in state.views {
        if view.active && !view.invalidated && sema_ownership_view_fact_matches_expr(view, expression, scopes) {
            place = Val(sema_ownership_place_snapshot(view.source))
            access = view.access
            break
        }
    }
    if place == None {
        binding_index :: sema_scope_resolve_index(scopes, name) ?? return None
        binding := scopes.bindings[binding_index]
        if binding.symbol.kind == SymbolKind.Parameter && (binding.access == AccessConvention.Read || binding.access == AccessConvention.Write) {
            places := sema_ownership_places_from_expr_in_state(expression, scopes, &state)
            if places.len() > 0 -> place = Val(places[0])
            if binding.access == AccessConvention.Write -> access = AccessConvention.Write
        }
    }
    if place == None -> return None
    sema_taskgroup_admit_scoped_borrow(&context, name, place ?? SemaOwnershipPlace{root: name, root_key: "", root_span: span, projections: [String]{}, typed_projections: [SemaOwnershipProjection]{}}, access, span, scopes, &diagnostics)
}

pub fn sema_taskgroup_admit_scoped_borrow(context: &SemaCheckContext, name: String, place: SemaOwnershipPlace, access: AccessConvention, span: Span, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool? {
    if context.taskgroups.stack.len() == 0 -> return None
    active_index := context.taskgroups.stack.len() - 1
    active := context.taskgroups.stack[active_index]
    if active.origin != SemaTaskGroupOrigin.Lexical -> return None
    if place.root_span.start > active.handle_span.start -> return None
    conflict_name := String?{None}
    loop frame in context.taskgroups.stack {
        loop held in frame.borrows {
            if sema_ownership_places_overlap(held.place, place) && (access == AccessConvention.Write || held.access == AccessConvention.Write) {
                conflict_name = Val(held.name)
                break
            }
        }
        if conflict_name != None -> break
    }
    if conflict_name == .Val(other) {
        what := if other == name -> "`{name}` is already lent to another task" else -> "`{name}` and `{other}` can reach the same place at the same time"
        &diagnostics.push(sema_error("E1101", span, what, "children of a task group run concurrently, so overlapping places cannot include a write borrow", "give the task owned data, freeze it, use `shared`, or borrow provably separate fields"))
        return Val(false)
    }
    &context.taskgroups.stack[active_index].borrows.push(SemaTaskGroupBorrow{name: name, place: sema_ownership_place_snapshot(place), access: access})
    Val(true)
}

pub fn sema_taskgroup_report_scoped_loan_conflict(context: SemaCheckContext, changed: SemaOwnershipPlace, action: String, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if context.taskgroups.in_spawn -> return false
    lent := String?{None}
    group_name := ""
    loop frame in context.taskgroups.stack {
        loop held in frame.borrows {
            if sema_ownership_places_overlap(held.place, changed) {
                lent = Val(held.name)
                group_name = frame.name
                break
            }
        }
        if lent != None -> break
    }
    if lent == .Val(name) {
        target := sema_ownership_place_name(changed)
        &diagnostics.push(sema_error("E1101", span, "`{target}` cannot {action} while `{name}` is lent to a task in `{group_name}`", "the task group joins children only at the end of its block, so the place remains borrowed while the child runs", "do this after `{group_name}` joins, or use owned, frozen, or shared data"))
        return true
    }
    false
}

pub fn sema_taskgroup_check_scoped_loan_read(context: &SemaCheckContext, expression: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    if context.taskgroups.in_spawn || context.taskgroups.scoped_loan_read_reported -> return
    is_place_read := if expression == {.Index(_, _, _, _) | .Field(_, _, _) -> true else -> false}
    if !is_place_read -> return
    place :: sema_ownership_places_from_expr_in_state(expression, scopes, &state)
    if place.len() == 0 -> return
    loop frame in context.taskgroups.stack {
        loop held in frame.borrows {
            if held.access == AccessConvention.Write && sema_ownership_places_overlap(held.place, place[0]) {
                context.taskgroups.scoped_loan_read_reported = true
                _ := sema_taskgroup_report_scoped_loan_conflict(context, place[0], "be read", expr_span(expression), &diagnostics)
                return
            }
        }
    }
}

fn sema_taskgroup_collect_branch_moves(expression: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    if expression == {
        .Ident(_, _) -> sema_taskgroup_mark_branch_move(expression, scopes, &state, &diagnostics)
        .Paren(inner, _) -> sema_taskgroup_collect_branch_moves(inner, scopes, &state, &diagnostics)
        .ListLit(values, _) -> loop value in values -> sema_taskgroup_collect_branch_moves(value, scopes, &state, &diagnostics)
        .TupleLit(fields, _, _) -> loop field in fields -> sema_taskgroup_collect_branch_moves(field.value, scopes, &state, &diagnostics)
        else -> {}
    }
}

fn sema_taskgroup_mark_branch_move(expression: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) {
    if sema_taskgroup_expression_moved(&state, expression, scopes) -> return
    places := sema_ownership_places_from_expr_in_state(expression, scopes, &state)
    if places.len() > 0 -> _ := sema_ownership_mark_move(&state, expression, scopes, "the task group combinator", &diagnostics)
}

fn sema_taskgroup_check_branches(args: [CallArg], span: Span, method: String, all: Bool, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if !sema_taskgroup_check_arity(args, 1, method, span, environment, &scopes, &state, &tail_store, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    empty := if args[0].expr == {.ListLit(values, _) -> values.len() == 0 else -> false}
    if empty {
        &diagnostics.push(sema_error("E1112", expr_span(args[0].expr), "`{method}` needs at least one task branch", "a task-group combinator cannot wait for an empty set", "give it one or more task branches"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    saved_binding := context.taskgroups.current_binding
    context.taskgroups.current_binding = None
    branches := sema_check_expression(args[0].expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    context.taskgroups.current_binding = saved_binding
    values :: branches ?? return SemaMethodSpecialCheck{handled: true, value: None}
    result_ty := Type?{None}
    if values.ty == {
        .List(inner) -> {
            elem :: sema_taskgroup_task_success(inner) ?? {
                &diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{method}` needs task branches, not `{type_name(values.ty)}`", "each branch must produce one Task result", "write `{method}([task_a, task_b])` with Task values"))
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            result_ty = Val(if all -> Type.List{element: elem} else -> elem)
        }
        .Tuple(fields) -> {
            if !all {
                &diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{method}` needs a list of task branches, not a named tuple", "race and any choose one completed task from a list", "write a list of Task values"))
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            result_fields := [TypeTupleField]{}
            loop field in fields {
                result_elem :: sema_taskgroup_task_success(field.ty) ?? {
                    &diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{method}` field `{field.name}` is not a Task", "each named branch must produce one Task result", "give every named branch a Task value"))
                    return SemaMethodSpecialCheck{handled: true, value: None}
                }
                &result_fields.push(TypeTupleField{name: field.name, ty: result_elem})
            }
            result_ty = Val(Type.Tuple{fields: result_fields})
        }
        else -> {
            &diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{method}` needs task branches, not `{type_name(values.ty)}`", "the combinator consumes a List<Task<T>> or, for all, a named tuple of Tasks", "pass a list of Task values"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    sema_taskgroup_collect_branch_moves(args[0].expr, scopes, &state, &diagnostics)
    sema_taskgroup_note_time_effect(&context, span)
    ok :: result_ty ?? Type.Named{name: "Unit"}
    result_type := sema_taskgroup_failure_result(ok)
    operation := if {
        all -> TExprKind.TaskGroupAll{tasks: values}
        else -> {
            if {
                method == sema_taskgroup_internal_race_method() -> TExprKind.TaskGroupRace{tasks: values}
                else -> TExprKind.TaskGroupAny{tasks: values}
            }
        }
    }
    checked := sema_expr_expected(sema_tir_expr(result_type, operation, span), expected, environment, &diagnostics)
    return SemaMethodSpecialCheck{handled: true, value: checked}
}

fn sema_taskgroup_check_spawn(args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if !sema_taskgroup_check_arity(args, 1, "task", span, environment, &scopes, &state, &tail_store, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    saved_in_spawn := context.taskgroups.in_spawn
    saved_floor := context.taskgroups.spawn_group_floor
    saved_binding := context.taskgroups.current_binding
    context.taskgroups.in_spawn = true
    context.taskgroups.spawn_group_floor = context.taskgroups.stack.len()
    context.taskgroups.current_binding = None
    checked_body := sema_check_expression_with_lambda_escapes(args[0].expr, None, environment, &scopes, &state, &tail_store, &context, Val(true), &diagnostics)
    context.taskgroups.in_spawn = saved_in_spawn
    context.taskgroups.spawn_group_floor = saved_floor
    context.taskgroups.current_binding = saved_binding
    body :: checked_body ?? return SemaMethodSpecialCheck{handled: true, value: None}
    body_ty :: sema_taskgroup_call_body_result(body.ty) ?? {
        &diagnostics.push(sema_error("E0112", args[0].span, "`task` needs a callable body, not `{type_name(body.ty)}`", "a spawned task executes one zero-parameter callable on a worker thread", "pass a zero-parameter lambda or function"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    lambda := if body.kind == {.LambdaValue(value) -> value else -> sema_taskgroup_callable_wrapper(body, body.ty, args[0].span) ?? {
        &diagnostics.push(sema_error("E0112", args[0].span, "`task` needs a callable body that can be captured for execution", "the worker closure must retain the callable until the task runs", "use a lambda or a direct function value"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }}
    if lambda.param_types.len() != 0 {
        &diagnostics.push(sema_error("E0104", args[0].span, "`task` needs a zero-parameter body, got {lambda.param_types.len()} parameters", "a task body captures values from the enclosing scope instead of taking arguments", "move or capture data rather than declaring lambda parameters"))
    }
    if body.kind == {
        .LambdaValue(_) -> { sema_function_reactive_note_task_lambda(&context, lambda) }
        else -> {}
    }
    sema_taskgroup_check_lambda_captures(lambda, args[0].span, environment, scopes, &state, &context, &diagnostics)
    task_result_ty := body_ty
    problem := sema_ownership_crossing_problem(task_result_ty, SemaSendCrossing.TaskResult, false, environment, scopes, context)
    if problem == .Val(value) -> &diagnostics.push(sema_ownership_crossing_diagnostic("this task", task_result_ty, value, SemaSendCrossing.TaskResult, args[0].span))
    group := TExpr?{None}
    if sema_taskgroup_spawn_group_index(context) != None {
        group = sema_taskgroup_task_group_expr(context, environment, &scopes, &state, &tail_store, &diagnostics, span)
        if group == None -> return SemaMethodSpecialCheck{handled: true, value: None}
    }
    task_type := Type.Apply{name: "Task", args: [Type]{task_result_ty}}
    kind := TCoreClosureKind.Spawn{group: group, site: span.start, label: None, executable: lambda}
    value := sema_tir_expr(task_type, TExprKind.CoreClosureCall{kind: kind}, span)
    if group != None {
        index :: sema_taskgroup_active_index(context.taskgroups) ?? 0
        group_name := context.taskgroups.stack[index].name
        sema_taskgroup_register_spawn(&context, group_name, span)
    }
    checked := sema_expr_expected(value, expected, environment, &diagnostics)
    return SemaMethodSpecialCheck{handled: true, value: checked}
}

pub fn sema_taskgroup_check_surface_method(receiver: Expr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if !sema_taskgroup_is_internal_receiver(receiver) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if method == sema_taskgroup_internal_spawn_method() -> return sema_taskgroup_check_spawn(args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if method == sema_taskgroup_internal_timeout_method() {
        if !sema_taskgroup_check_arity(args, 1, "task.timeout", span, environment, &scopes, &state, &tail_store, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        duration :: sema_check_expression(args[0].expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        if duration.ty != (Type.Named{name: "Duration"}) {
            &diagnostics.push(sema_error("E0112", args[0].span, "`task.timeout` needs a Duration, not `{type_name(duration.ty)}`", "task timeouts use a canonical Time delta", "pass a Duration value"))
        }
        sema_taskgroup_note_time_effect(&context, span)
        value := sema_tir_expr(Type.Named{name: "Unit"}, TExprKind.Unit, span)
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, &diagnostics)}
    }
    if method == sema_taskgroup_internal_all_method() || method == sema_taskgroup_internal_race_method() || method == sema_taskgroup_internal_any_method() {
        all := method == sema_taskgroup_internal_all_method()
        label := if {
            all -> "task.all"
            else -> {
                if {
                    method == sema_taskgroup_internal_race_method() -> "task.race"
                    else -> "task.any"
                }
            }
        }
        return sema_taskgroup_check_branches(args, span, label, all, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}

pub fn sema_taskgroup_check_group_method(receiver: Expr, receiver_ty: Type, method: String, args: [CallArg], span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if receiver_ty != (Type.Named{name: "Group"}) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_taskgroup_receiver_ok(receiver, span, scopes, context, &diagnostics) {
        sema_taskgroup_check_discarded_arguments(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    message := if method == "select" -> "`Group.select()` is retired" else -> "`Group` has no method `{method}`"
    why := if method == "select" -> "readiness waits are subjectless `if` tables on plain endpoints" else -> "task groups use the `task` surface; Group values do not own readiness waits"
    fix := if method == "select" -> "write a subjectless readiness table" else -> "write `task work()`, `task.all(…)`, or a subjectless readiness table"
    &diagnostics.push(sema_error("E0102", span, message, why, fix))
    sema_taskgroup_check_discarded_arguments(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: None}
}
