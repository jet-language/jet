// Structural checking for the core sender and parallel List adapters.
//
// The root method dispatcher owns evaluation of the receiver; this helper is
// called with its checked value and only claims methods backed by exact core
// registration facts or intrinsic List receiver types.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    Expr,
    ParamZone,
    Span,
    TClosureOp,
    TDeclarationOwnership,
    TExpr,
    TExprKind,
    THandleOp,
    Type,
    TypeTupleField,
    type_identity_equal,
    type_tuple_struct_name,
]

fn sema_call_concurrency_label(argument: CallArg) -> String? {
    if argument.label == {.Val(label) -> Val(label.name) else -> None}
}

fn sema_call_concurrency_check_labels(method: String, args: [CallArg], span: Span, diagnostics: &[Diagnostic]) {
    loop (index, argument) in args {
        label :: sema_call_concurrency_label(argument) ?? next
        if method == "para_map" && index == 1 && label == "limit" -> next
        label_span := if argument.label == {.Val(value) -> value.span else -> argument.span}
        &diagnostics.push(sema_error("E0764", label_span, "`{method}` has no parameter labelled `{label}`", "a label binds an argument to the parameter of that name", if method == "para_map" -> "`para_map` accepts `limit` on its optional second argument" else -> "`{method}` takes no labelled arguments"))
    }
}

fn sema_call_concurrency_list_element(ty: Type) -> Type? {
    if ty == {
        .List(element) | .FixedList(element, _) -> Val(element)
        .Tagged(_, inner) -> sema_call_concurrency_list_element(inner)
        else -> None
    }
}

fn sema_call_concurrency_sender_element(ty: Type) -> Type? {
    if ty == {
        .Apply(name, args) -> {
            if name != sema_registration_core_builtin_sender_name() -> return None
            return if args.len() > 0 -> Val(args[0]) else -> Val(Type.Int)
        }
        .Named(name) -> if name == sema_registration_core_builtin_sender_name() -> Val(Type.Int) else -> None
        .Tagged(_, inner) -> sema_call_concurrency_sender_element(inner)
        else -> None
    }
}

fn sema_call_concurrency_is_canonical_sender(ty: Type, environment: SemaScopeEnvironment) -> Bool Never! {
    if sema_call_concurrency_sender_element(ty) == None -> return false
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return false
    if sema_type_resolve_nominal(graph, ty, environment.module_identity) != None -> return false
    owner :: sema_registration_core_builtin_owner(graph, sema_registration_core_builtin_sender_name()) ?? return false
    owner.ownership == TDeclarationOwnership.Owned
}

fn sema_call_concurrency_check_value(argument: CallArg, required: Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    expected :: if argument.expr == {.Lambda(_) -> Val(required) else -> None}
    checked :: sema_check_expression(argument.expr, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if type_identity_equal(checked.ty, required) -> return Val(checked)
    compatible :: sema_call_type_assignable(required, checked.ty, environment) ?? return None
    if compatible -> return Val(checked)
    if sema_expr_numeric_widening_to(checked.ty, required) == (Val(true)) {
        line :: sema_source_line_at(environment.source_segments, checked.span) ?? 0
        return sema_expr_numeric_literal_conversion(checked, required, checked.span, line, &diagnostics)
    }
    &diagnostics.push(sema_type_mismatch(required, checked.ty, argument.span))
    None
}

fn sema_call_concurrency_success_type(ty: Type) -> Type Never! {
    if ty == {
        .Result(ok, _) | .Option(ok) -> ok
        else -> ty
    }
}

fn sema_call_concurrency_reject_parallel_type(role: String, ty: Type, span: Span, environment: SemaScopeEnvironment, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: &[Diagnostic]) {
    problem :: sema_ownership_crossing_problem(ty, SemaSendCrossing.ParallelWorker, true, environment, scopes, context) ?? return
    &diagnostics.push(sema_ownership_crossing_diagnostic("parallel {role}", ty, problem, SemaSendCrossing.ParallelWorker, span))
}

fn sema_call_concurrency_check_parallel_callback(value: TExpr, source: Expr, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if value.kind == {
        .Lambda(lambda) -> {
            updated_lambda := lambda
            valid := true
            loop name in updated_lambda.capture_facts.mutable {
                &diagnostics.push(sema_ownership_crossing_concurrent_write_diagnostic(name, "parallel worker", updated_lambda.source_span))
                valid = false
            }
            loop capture in updated_lambda.captures {
                mutable := false
                loop name in updated_lambda.capture_facts.mutable { if name == capture.source -> mutable = true }
                if mutable -> next
                closure_taken := sema_ownership_crossing_capture_taken(updated_lambda, capture, environment, context.generic_params)
                problem :: sema_ownership_crossing_problem_for_name(capture.source, capture.ty, SemaSendCrossing.ParallelWorker, closure_taken, environment, scopes, state, context) ?? next
                &diagnostics.push(sema_ownership_crossing_diagnostic(capture.source, capture.ty, problem, SemaSendCrossing.ParallelWorker, updated_lambda.source_span))
                valid = false
            }
            sema_function_reactive_note_parallel_lambda(&context, updated_lambda)
            updated_lambda.is_move = true
            return valid
        }
        else -> {}
    }
    named_function := if source == {.Ident(name, _) -> sema_scope_resolve_index(&scopes, name) == None else -> false}
    if !named_function {
        problem := SemaSendabilityProblem{root: None, path: [String]{}, kind: SemaSendProblemKind.ClosureCaptures}
        &diagnostics.push(sema_ownership_crossing_diagnostic("parallel callback", Type.Named{name: "callback"}, problem, SemaSendCrossing.ParallelWorker, value.span))
        return false
    }
    true
}

fn sema_call_concurrency_infer_callback(argument: CallArg, required: Type, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked :: sema_check_expression_with_lambda_escapes(argument.expr, Val(required), environment, &scopes, &state, &tail_store, &context, Val(false), &diagnostics) ?? return None
    compatible :: sema_call_host_callback_assignable(required, checked.ty, environment) ?? return None
    if !compatible {
        &diagnostics.push(sema_type_mismatch(required, checked.ty, argument.span))
        return None
    }
    Val(checked)
}

fn sema_call_concurrency_check_sender(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    sema_call_concurrency_check_labels("send", updated_args, span, &diagnostics)
    if updated_args.len() != 1 {
        loop argument in updated_args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        &diagnostics.push(sema_error("E0104", span, "`send` expects 1 argument, got {updated_args.len()}", "a sender sends exactly one payload value", "write `.send(value)` with one payload"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    payload_ty :: sema_call_concurrency_sender_element(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    payload :: sema_call_concurrency_check_value(updated_args[0], payload_ty, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    crossing_problem := sema_ownership_crossing_problem_for_expr(updated_args[0].expr, payload_ty, SemaSendCrossing.ChannelSend, updated_args[0].convention == AccessConvention.Move, environment, scopes, state, context)
    if crossing_problem == .Val(problem) {
        value_name := if updated_args[0].expr == {.Ident(name, _) -> name else -> "this value"}
        &diagnostics.push(sema_ownership_crossing_diagnostic(value_name, payload_ty, problem, SemaSendCrossing.ChannelSend, updated_args[0].span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    params := [SemaCallParam]{SemaCallParam{label: "value", name: "value", zone: ParamZone.Either, default: None, default_ref: None, convention: AccessConvention.Move, ty: Val(payload_ty), variadic: false}}
    ownership := sema_ownership_check_method_call(&state, "send", receiver, AccessConvention.Read, params, &updated_args, scopes, span, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := payload
    if updated_args[0].flags.implicit_clone || updated_args[0].flags.shared_auto_clone -> value = sema_tir_expr(value.ty, TExprKind.Clone{value: value}, value.span)
    sema_function_reactive_note_channel(&context, updated_args[0].expr, payload_ty)
    lowered := [TExpr]{value}
    tir := sema_tir_expr(Type.Named{name: "Unit"}, TExprKind.HandleMethod{receiver: receiver_value, operation: THandleOp.SenderSend, args: lowered}, span)
    checked := sema_expr_expected(tir, expected, environment, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

fn sema_call_concurrency_parallel(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    element :: sema_call_concurrency_list_element(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    sema_call_concurrency_check_labels(method, args, span, &diagnostics)
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    expected_count := if {
        method == "para_map" -> if {
            args.len() == 2 -> 2
            else -> 1
        }
        method == "para_fold" -> 3
        else -> 1
    }
    if args.len() != expected_count || (method == "para_map" && args.len() > 2) {
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        expected_description := if {
            method == "para_map" -> "1 or 2"
            method == "para_fold" -> "3"
            else -> "1"
        }
        &diagnostics.push(sema_error("E0104", span, "`{method}` received {args.len()} arguments; expected {expected_description}", "parallel collection adapters have a fixed callback contract", "check the number of callbacks accepted by `.{method}`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }

    typed := [TExpr]{}
    result_type := Type.Named{name: "Unit"}
    if method == "para_map" {
        map_type := Type.Fn{params: [Type]{element}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
        callback :: sema_call_concurrency_infer_callback(args[0], map_type, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        _ := sema_call_concurrency_check_parallel_callback(callback, args[0].expr, environment, &scopes, &state, &context, &diagnostics)
        callback_result := Type.Named{name: "Unit"}
        if sema_call_signature_return(callback.ty) == .Val(ret) -> callback_result = sema_call_concurrency_success_type(ret)
        &typed.push(callback)
        result_type = Type.List{element: callback_result}
        sema_call_concurrency_reject_parallel_type("item", element, span, environment, scopes, context, &diagnostics)
        sema_call_concurrency_reject_parallel_type("result", result_type, span, environment, scopes, context, &diagnostics)
        if args.len() == 2 {
            limit :: sema_call_concurrency_check_value(args[1], Type.Int, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
            &typed.push(limit)
        }
        operation := TClosureOp.ParaMap
        tir := sema_tir_expr(result_type, TExprKind.ClosureMethod{receiver: receiver_value, operation: operation, args: typed}, span)
        checked := sema_expr_expected(tir, expected, environment, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: checked}
    }

    if method == "para_filter" || method == "para_partition" {
        predicate_type := Type.Fn{params: [Type]{element}, ret: Val(Type.Bool), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
        callback :: sema_call_concurrency_infer_callback(args[0], predicate_type, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        _ := sema_call_concurrency_check_parallel_callback(callback, args[0].expr, environment, &scopes, &state, &context, &diagnostics)
        &typed.push(callback)
        if method == "para_filter" {
            result_type = Type.List{element: element}
            sema_call_concurrency_reject_parallel_type("item", element, span, environment, scopes, context, &diagnostics)
            sema_call_concurrency_reject_parallel_type("result", result_type, span, environment, scopes, context, &diagnostics)
            operation := TClosureOp.ParaFilter
            tir := sema_tir_expr(result_type, TExprKind.ClosureMethod{receiver: receiver_value, operation: operation, args: typed}, span)
            checked := sema_expr_expected(tir, expected, environment, &diagnostics)
            return SemaMethodSpecialCheck{handled: true, value: checked}
        }
        fields := [TypeTupleField]{TypeTupleField{name: "false_", ty: Type.List{element: element}}, TypeTupleField{name: "true_", ty: Type.List{element: element}}}
        result_type = Type.Tuple{fields: fields}
        sema_call_concurrency_reject_parallel_type("item", element, span, environment, scopes, context, &diagnostics)
        sema_call_concurrency_reject_parallel_type("result", result_type, span, environment, scopes, context, &diagnostics)
        operation := TClosureOp.ParaPartition{tuple_struct: type_tuple_struct_name(fields)}
        tir := sema_tir_expr(result_type, TExprKind.ClosureMethod{receiver: receiver_value, operation: operation, args: typed}, span)
        checked := sema_expr_expected(tir, expected, environment, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: checked}
    }

    seed_type := Type.Fn{params: [Type]{}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    seed :: sema_call_concurrency_infer_callback(args[0], seed_type, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    _ := sema_call_concurrency_check_parallel_callback(seed, args[0].expr, environment, &scopes, &state, &context, &diagnostics)
    accumulator := Type.Named{name: "Unit"}
    if sema_call_signature_return(seed.ty) == .Val(ret) -> accumulator = sema_call_concurrency_success_type(ret)
    step_type := Type.Fn{params: [Type]{accumulator, element}, ret: Val(accumulator), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    step :: sema_call_concurrency_infer_callback(args[1], step_type, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    _ := sema_call_concurrency_check_parallel_callback(step, args[1].expr, environment, &scopes, &state, &context, &diagnostics)
    merge_type := Type.Fn{params: [Type]{accumulator, accumulator}, ret: Val(accumulator), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    merge :: sema_call_concurrency_infer_callback(args[2], merge_type, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    _ := sema_call_concurrency_check_parallel_callback(merge, args[2].expr, environment, &scopes, &state, &context, &diagnostics)
    &typed.push(seed)
    &typed.push(step)
    &typed.push(merge)
    result_type = accumulator
    sema_call_concurrency_reject_parallel_type("item", element, span, environment, scopes, context, &diagnostics)
    sema_call_concurrency_reject_parallel_type("result", result_type, span, environment, scopes, context, &diagnostics)
    tir := sema_tir_expr(result_type, TExprKind.ClosureMethod{receiver: receiver_value, operation: TClosureOp.ParaFold, args: typed}, span)
    checked := sema_expr_expected(tir, expected, environment, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

pub fn sema_call_try_builtin_concurrency(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method == "send" && sema_call_concurrency_is_canonical_sender(receiver_value.ty, environment) {
        return sema_call_concurrency_check_sender(receiver, receiver_value, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    if method == "para_map" || method == "para_filter" || method == "para_partition" || method == "para_fold" {
        if sema_call_concurrency_list_element(receiver_value.ty) != None {
            return sema_call_concurrency_parallel(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        }
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}
