// Structural checking for the core sender and parallel List adapters.
//
// The root method dispatcher owns evaluation of the receiver; this helper is
// called with its checked value and only claims methods backed by exact core
// registration facts or intrinsic List receiver types.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    Expr,
    ParamZone,
    PlaceAccess,
    Span,
    TClosureOp,
    TDeclarationOwnership,
    Type,
    TypeTupleField,
    type_identity_equal,
    ast_visit_expr,
]

fn sema_call_concurrency_label(argument: CallArg) -> String? {
    if argument.label == {.Val(label) -> Val(label.name) else -> None}
}

fn sema_call_concurrency_check_labels(method: String, args: [CallArg], span: Span, diagnostics: &[Diagnostic]) {
    loop (index, argument) in args {
        label :: sema_call_concurrency_label(argument) ?? next
        if method == "para_map" && index == 1 && label == "limit" -> next
        label_span := if argument.label == {.Val(value) -> value.span else -> argument.span}
        &diagnostics.push(sema_error("E0764", label_span, "`{method}` has no parameter labelled `{label}`", "a label binds an argument to the parameter of that name", if method == "para_map" -> "`para_map` accepts `limit` on its optional second argument" else -> "`{method}` takes no labelled arguments"))
    }
}

fn sema_call_concurrency_list_element(ty: Type) -> Type? {
    if ty == {
        .List(element) | .FixedList(element, _) -> Val(element)
        .Tagged(_, inner) -> sema_call_concurrency_list_element(inner)
        else -> None
    }
}

fn sema_call_concurrency_sender_element(ty: Type) -> Type? {
    if ty == {
        .Apply(name, args) -> {
            if name != sema_registration_core_builtin_sender_name() -> return None
            return if args.len() > 0 -> Val(args[0]) else -> Val(Type.Int)
        }
        .Named(name) -> if name == sema_registration_core_builtin_sender_name() -> Val(Type.Int) else -> None
        .Tagged(_, inner) -> sema_call_concurrency_sender_element(inner)
        else -> None
    }
}

fn sema_call_concurrency_is_canonical_sender(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if sema_call_concurrency_sender_element(ty) == None -> return false
    if program.registration_graph == .Val(graph) {
        if sema_type_resolve_nominal_row(graph, ty, environment.module_identity) != None -> return false
        owner :: sema_registration_core_builtin_owner(graph, sema_registration_core_builtin_sender_name()) ?? return false
        return owner.ownership == TDeclarationOwnership.Owned
    } else {
        return false
    }
}

fn sema_call_concurrency_check_value(argument: CallArg, required: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    expected :: if argument.expr == {.Lambda(_, _) -> Val(required) else -> None}
    checked :: sema_check_expression(argument.expr, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if type_identity_equal(checked.ty, required) -> return Val(checked)
    compatible :: sema_call_type_assignable(required, checked.ty, environment, program) ?? return None
    if compatible -> return Val(checked)
    if sema_expr_numeric_value_widening(checked, required) == (Val(true)) {
        line :: sema_source_line_at(environment.source_segments, checked.span) ?? 0
        return sema_expr_numeric_literal_conversion(checked, required, checked.span, line, &diagnostics)
    }
    &diagnostics.push(sema_type_mismatch(required, checked.ty, argument.span))
    None
}

fn sema_call_concurrency_success_type(ty: Type) -> Type Never! {
    if ty == {
        .Result(ok, _) | .Option(ok) -> ok
        else -> ty
    }
}

fn sema_call_concurrency_reject_parallel_type(role: String, ty: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, context: SemaCheckContext, diagnostics: &[Diagnostic]) {
    problem :: sema_ownership_crossing_problem(ty, SemaSendCrossing.ParallelWorker, true, environment, program, scopes, context) ?? return
    &diagnostics.push(sema_ownership_crossing_diagnostic("parallel {role}", ty, problem, SemaSendCrossing.ParallelWorker, span))
}

fn sema_call_concurrency_check_parallel_callback(value: TExpr, source: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if value.kind == {
        .Lambda(lambda) -> {
            updated_lambda := lambda
            valid := true
            loop name in updated_lambda.capture_facts.mutable {
                &diagnostics.push(sema_ownership_crossing_concurrent_write_diagnostic(name, "parallel worker", updated_lambda.source_span))
                valid = false
            }
            loop capture in updated_lambda.captures {
                mutable := false
                loop name in updated_lambda.capture_facts.mutable { if name == capture.source -> mutable = true }
                if mutable -> next
                closure_taken := sema_ownership_crossing_capture_taken(updated_lambda, capture, environment, program, context.generic_params)
                problem :: sema_ownership_crossing_problem_for_name(capture.source, capture.ty, SemaSendCrossing.ParallelWorker, closure_taken, environment, program, scopes, state, context) ?? next
                &diagnostics.push(sema_ownership_crossing_diagnostic(capture.source, capture.ty, problem, SemaSendCrossing.ParallelWorker, updated_lambda.source_span))
                valid = false
            }
            sema_function_reactive_note_parallel_lambda(&context, updated_lambda)
            updated_lambda.is_move = true
            return valid
        }
        else -> {}
    }
    named_function := if source == {.Ident(name, _, _) -> sema_call_concurrency_names_module_function(scopes, name) else -> false}
    if !named_function {
        problem := SemaSendabilityProblem{root: None, path: [String]{}, kind: SemaSendProblemKind.ClosureCaptures}
        &diagnostics.push(sema_ownership_crossing_diagnostic("parallel callback", Type.Named{name: "callback"}, problem, SemaSendCrossing.ParallelWorker, value.span))
        return false
    }
    true
}

// A bare name that resolves to a module function: it has no captures, so it
// crosses a worker boundary like any capture-free callback. Module symbols
// live in the root frame beside locals, so the binding's kind decides.
fn sema_call_concurrency_names_module_function(scopes: SemaScopeTable, name: String) -> Bool Never! {
    index :: sema_scope_resolve_index(scopes, name) ?? return true
    scopes.bindings[index].frame == 0 && scopes.bindings[index].symbol.kind == SymbolKind.Function
}

// A callback slot whose result is open (`ret: None`: `para_map`'s mapper,
// `para_fold`'s seed) adopts the callback's own result, as a collection
// callback does; its parameters still have to fit. A lambda whose written
// parameter types differ from the slot's checks on its own types and is one
// argument mismatch (E0108, as Rust's builtin-method argument check), shown
// with the slot's `result` when the caller knows it.
fn sema_call_concurrency_infer_callback(argument: CallArg, required: Type, method: String, index: Int, result: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    open_result := false
    if required == .Fn(_, ret, _, _, _, _) && ret == None -> open_result = true
    if sema_call_concurrency_written_params_differ(argument.expr, required, environment, program) {
        written :: sema_check_expression_with_lambda_escapes(argument.expr, None, environment, program, &scopes, &state, &tail_store, &context, Val(false), &diagnostics) ?? return None
        shown := required
        if result == .Val(slot_result) && required == .Fn(params, _, effect_bound, param_contract, call_metadata, return_view_provenance) {
            // copy: the shown slot is a new owned Type built from the required one and the caller's result
            shown = Type.Fn{params: params.copy(), ret: Val(slot_result.copy()), effect_bound: effect_bound.copy(), param_contract: param_contract.copy(), call_metadata: call_metadata.copy(), return_view_provenance: return_view_provenance.copy()}
        }
        &diagnostics.push(sema_value_method_argument_mismatch(method, index, shown, written.ty, argument.span))
        return None
    }
    checked_result :: if open_result -> sema_expression_lambda_collection_callback(argument.expr, Val(required), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) else -> sema_check_expression_with_lambda_escapes(argument.expr, Val(required), environment, program, &scopes, &state, &tail_store, &context, Val(false), &diagnostics)
    checked :: checked_result ?? {
        sema_call_concurrency_failed_callback_writes(argument.expr, scopes, &diagnostics)
        return None
    }
    contract := required
    if open_result && required == .Fn(params, _, effect_bound, param_contract, call_metadata, return_view_provenance) && checked.ty == .Fn(_, adopted, _, _, _, _) {
        // copy: the contract is a new owned Type built from the required slot and the callback's adopted result
        contract = Type.Fn{params: params.copy(), ret: adopted.copy(), effect_bound: effect_bound.copy(), param_contract: param_contract.copy(), call_metadata: call_metadata.copy(), return_view_provenance: return_view_provenance.copy()}
    }
    compatible :: sema_call_host_callback_assignable(contract, checked.ty, environment, program) ?? return None
    if !compatible {
        &diagnostics.push(sema_type_mismatch(contract, checked.ty, argument.span))
        return None
    }
    Val(checked)
}

// Whether `source` is a lambda that writes every parameter's type and one
// of them is not the slot's.
fn sema_call_concurrency_written_params_differ(source: Expr, required: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    lambda :: if source == {
        .Lambda(found, _) -> found
        else -> {
            return false
        }
    }
    params :: if required == {
        .Fn(found, _, _, _, _, _) -> found
        else -> {
            return false
        }
    }
    if lambda.params.len() != params.len() -> return false
    differs := false
    loop (index, parameter) in lambda.params {
        written :: parameter.ty ?? return false
        if !type_identity_equal(sema_expr_expected_type(written, environment, program), sema_expr_expected_type(params[index], environment, program)) -> differs = true
    }
    differs
}

// A callback whose body did not check has no capture facts, yet each outer
// place its body marks with `&` is still a write a worker would race, so it
// is refused at the worker boundary as a checked callback's would be.
fn sema_call_concurrency_failed_callback_writes(source: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) {
    if source == .Lambda(lambda, _) {
        written := [String]{}
        ast_visit_expr(source, (expression: Expr) -> sema_call_concurrency_note_marked_write(&written, expression))
        loop name in written {
            parameter := false
            loop param in lambda.params { if param.name == name -> parameter = true }
            if parameter || sema_scope_resolve_index(scopes, name) == None -> next
            &diagnostics.push(sema_ownership_crossing_concurrent_write_diagnostic(name, "parallel worker", lambda.span))
        }
    }
}

fn sema_call_concurrency_note_marked_write(written: &[String], expression: Expr) Never! {
    if expression == .Place(value, access, _, _) && access == PlaceAccess.Write {
        root :: sema_receiver_mark_place_root(value) ?? return
        if !written.contains(root) -> &written.push(root)
    }
}

fn sema_call_concurrency_check_sender(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    sema_call_concurrency_check_labels("send", updated_args, span, &diagnostics)
    if updated_args.len() != 1 {
        loop argument in updated_args -> _ := sema_check_expression(argument.expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        &diagnostics.push(sema_error("E0104", span, "`send` expects 1 argument, got {updated_args.len()}", "a sender sends exactly one payload value", "write `.send(value)` with one payload"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    payload_ty :: sema_call_concurrency_sender_element(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    payload :: sema_call_concurrency_check_value(updated_args[0], payload_ty, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    crossing_problem := sema_ownership_crossing_problem_for_expr(updated_args[0].expr, payload_ty, SemaSendCrossing.ChannelSend, updated_args[0].convention == AccessConvention.Move, environment, program, scopes, state, context)
    if crossing_problem == .Val(problem) {
        value_name := if updated_args[0].expr == {.Ident(name, _, _) -> name else -> "this value"}
        &diagnostics.push(sema_ownership_crossing_diagnostic(value_name, payload_ty, problem, SemaSendCrossing.ChannelSend, updated_args[0].span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    params := [SemaCallParam]{SemaCallParam{label: "value", name: "value", zone: ParamZone.Either, default: None, default_ref: None, convention: AccessConvention.Move, ty: Val(payload_ty), variadic: false}}
    ownership := sema_ownership_check_method_call(&state, "send", receiver, AccessConvention.Read, params, &updated_args, scopes, span, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    sema_function_reactive_note_channel(&context, updated_args[0].expr, payload_ty)
    lowered := [TExpr]{payload}
    // Rust `receiver_effect_leaf("Sender", "send")`: a send may block on a
    // bounded channel, so it records `Time.Wait`.
    if !sema_stream_handle_effect_fact(environment, program, &scopes, &context, "Sender.send", span, Type.Named{name: "Unit"}, "Time.Wait", &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    built := sema_tree_node(Type.Named{name: "Unit"}, TExprKind.HandleMethod{receiver: receiver_value, operation: THandleOp.SenderSend, args: lowered}, span)
    checked := sema_expr_expected(built, expected, environment, program, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

fn sema_call_concurrency_parallel(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    element :: sema_call_concurrency_list_element(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    sema_call_concurrency_check_labels(method, args, span, &diagnostics)
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    expected_count := if {
        method == "para_map" -> if {
            args.len() == 2 -> 2
            else -> 1
        }
        method == "para_fold" -> 3
        else -> 1
    }
    if args.len() != expected_count || (method == "para_map" && args.len() > 2) {
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        expected_description := if {
            method == "para_map" -> "1 or 2"
            method == "para_fold" -> "3"
            else -> "1"
        }
        &diagnostics.push(sema_error("E0104", span, "`{method}` received {args.len()} arguments; expected {expected_description}", "parallel collection adapters have a fixed callback contract", "check the number of callbacks accepted by `.{method}`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }

    typed := [TExpr]{}
    result_type := Type.Named{name: "Unit"}
    if method == "para_map" {
        map_type := Type.Fn{params: [Type]{element}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
        callback :: sema_call_concurrency_infer_callback(args[0], map_type, method, 0, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        _ := sema_call_concurrency_check_parallel_callback(callback, args[0].expr, environment, program, &scopes, &state, &context, &diagnostics)
        callback_result := Type.Named{name: "Unit"}
        callback_error := Type?{None}
        if sema_call_signature_return(callback.ty) == .Val(ret) {
            callback_result = sema_call_concurrency_success_type(ret)
            if sema_expr_unwrap_tag(ret) == .Result(_, error) && error != (Type.Named{name: "Never"}) -> callback_error = Val(error)
        }
        &typed.push(callback)
        result_type = Type.List{element: callback_result}
        sema_call_concurrency_reject_parallel_type("item", element, span, environment, program, scopes, context, &diagnostics)
        sema_call_concurrency_reject_parallel_type("result", result_type, span, environment, program, scopes, context, &diagnostics)
        if args.len() == 2 {
            limit :: sema_call_concurrency_check_value(args[1], Type.Int, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
            &typed.push(limit)
        }
        operation := TClosureOp.ParaMap
        // D-PARCAPTURE1: a fallible callback's failure leaves the call. The
        // call is the Result of the mapped List (the lowest-index Err when
        // any item fails), and the dispatcher's auto-propagation inserts its
        // Try, as for a fallible `map` (TryMap).
        call_type := if callback_error == .Val(error) -> Type.Result{ok: result_type, err: error} else -> result_type
        built := sema_tree_node(call_type, TExprKind.ClosureMethod{receiver: receiver_value, operation: operation, args: typed}, span)
        checked := sema_expression_call_expected(built, expected, environment, program, context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: checked}
    }

    if method == "para_filter" || method == "para_partition" {
        // The result slot stays open so a fallible predicate checks; its
        // success must be Bool.
        predicate_type := Type.Fn{params: [Type]{element}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
        callback :: sema_call_concurrency_infer_callback(args[0], predicate_type, method, 0, Val(Type.Bool), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        makes_callback :: sema_call_concurrency_callback_makes(callback.ty, [Type]{element}, Type.Bool, args[0].span, &diagnostics)
        _ := sema_call_concurrency_check_parallel_callback(callback, args[0].expr, environment, program, &scopes, &state, &context, &diagnostics)
        if !makes_callback -> return SemaMethodSpecialCheck{handled: true, value: None}
        &typed.push(callback)
        // As for para_map, a fallible predicate's failure
        // leaves the call, which is the Result of the selection.
        callback_error :: sema_call_concurrency_callback_error(callback.ty)
        if method == "para_filter" {
            result_type = Type.List{element: element}
            sema_call_concurrency_reject_parallel_type("item", element, span, environment, program, scopes, context, &diagnostics)
            sema_call_concurrency_reject_parallel_type("result", result_type, span, environment, program, scopes, context, &diagnostics)
            operation := TClosureOp.ParaFilter
            return sema_call_concurrency_parallel_result(receiver_value, operation, typed, result_type, callback_error, span, expected, environment, program, context, &diagnostics)
        }
        fields := [TypeTupleField]{TypeTupleField{name: "false_", ty: Type.List{element: element}}, TypeTupleField{name: "true_", ty: Type.List{element: element}}}
        result_type = Type.Tuple{fields: fields}
        sema_call_concurrency_reject_parallel_type("item", element, span, environment, program, scopes, context, &diagnostics)
        sema_call_concurrency_reject_parallel_type("result", result_type, span, environment, program, scopes, context, &diagnostics)
        operation := TClosureOp.ParaPartition
        return sema_call_concurrency_parallel_result(receiver_value, operation, typed, result_type, callback_error, span, expected, environment, program, context, &diagnostics)
    }

    seed_type := Type.Fn{params: [Type]{}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    seed :: sema_call_concurrency_infer_callback(args[0], seed_type, method, 0, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    _ := sema_call_concurrency_check_parallel_callback(seed, args[0].expr, environment, program, &scopes, &state, &context, &diagnostics)
    accumulator := Type.Named{name: "Unit"}
    if sema_call_signature_return(seed.ty) == .Val(ret) -> accumulator = sema_call_concurrency_success_type(ret)
    step_type := Type.Fn{params: [Type]{accumulator, element}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    // Each slot is checked even after an earlier one fails, and the fold's
    // result still crosses the worker boundary, as in Rust's argument loop.
    step_checked := sema_call_concurrency_infer_callback(args[1], step_type, method, 1, Val(accumulator), environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    makes_step := false
    if step_checked == .Val(checked_step) {
        makes_step = sema_call_concurrency_callback_makes(checked_step.ty, [Type]{accumulator, element}, accumulator, args[1].span, &diagnostics)
        _ := sema_call_concurrency_check_parallel_callback(checked_step, args[1].expr, environment, program, &scopes, &state, &context, &diagnostics)
    }
    merge_type := Type.Fn{params: [Type]{accumulator, accumulator}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    merge_checked := sema_call_concurrency_infer_callback(args[2], merge_type, method, 2, Val(accumulator), environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    makes_merge := false
    if merge_checked == .Val(checked_merge) {
        makes_merge = sema_call_concurrency_callback_makes(checked_merge.ty, [Type]{accumulator, accumulator}, accumulator, args[2].span, &diagnostics)
        _ := sema_call_concurrency_check_parallel_callback(checked_merge, args[2].expr, environment, program, &scopes, &state, &context, &diagnostics)
    }
    if !makes_step || !makes_merge {
        sema_call_concurrency_reject_parallel_type("item", element, span, environment, program, scopes, context, &diagnostics)
        sema_call_concurrency_reject_parallel_type("result", accumulator, span, environment, program, scopes, context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    step :: step_checked ?? return SemaMethodSpecialCheck{handled: true, value: None}
    merge :: merge_checked ?? return SemaMethodSpecialCheck{handled: true, value: None}
    // One failure domain for the fold: every fallible callback's Err is the
    // call's.
    fold_error := Type?{None}
    loop (index, callback_ty) in ([Type]{seed.ty.copy(), step.ty.copy(), merge.ty.copy()}) {
        if sema_call_concurrency_callback_error(callback_ty) == .Val(error) {
            if fold_error == .Val(known) {
                if known != error {
                    &diagnostics.push(sema_type_mismatch(known, error, args[index].span))
                    return SemaMethodSpecialCheck{handled: true, value: None}
                }
            }
            fold_error = Val(error)
        }
    }
    &typed.push(seed)
    &typed.push(step)
    &typed.push(merge)
    result_type = accumulator
    sema_call_concurrency_reject_parallel_type("item", element, span, environment, program, scopes, context, &diagnostics)
    sema_call_concurrency_reject_parallel_type("result", result_type, span, environment, program, scopes, context, &diagnostics)
    sema_call_concurrency_parallel_result(receiver_value, TClosureOp.ParaFold, typed, result_type, fold_error, span, expected, environment, program, context, &diagnostics)
}

// Whether a callback of type `ty`, checked against an open result slot,
// makes `want` (its success, for a fallible callback); a mismatch against
// `fn(params) -> want` is reported at `span`.
fn sema_call_concurrency_callback_makes(ty: Type, params: [Type], want: Type, span: Span, diagnostics: &[Diagnostic]) -> Bool Never! {
    ret :: sema_call_signature_return(ty) ?? return true
    if sema_call_concurrency_success_type(ret) == want -> return true
    required := Type.Fn{params: params, ret: Val(want), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    &diagnostics.push(sema_type_mismatch(required, ty, span))
    false
}

// The Err a callback's call can leave with; None for a total callback (no
// Result, or a `T Never!` carrier).
fn sema_call_concurrency_callback_error(ty: Type) -> Type? Never! {
    ret :: sema_call_signature_return(ty) ?? return None
    if sema_expr_unwrap_tag(ret) == .Result(_, error) {
        if error != (Type.Named{name: "Never"}) -> return Val(error.copy())
    }
    None
}

// The parallel call over `typed`: `result_type`, or the Result of it when a
// callback can fail, whose Try the dispatcher's auto-propagation inserts.
fn sema_call_concurrency_parallel_result(receiver_value: TExpr, operation: TClosureOp, typed: [TExpr], result_type: Type, error: Type?, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, context: SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    failure :: error ?? {
        built := sema_tree_node(result_type, TExprKind.ClosureMethod{receiver: receiver_value, operation: operation, args: typed}, span)
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(built, expected, environment, program, &diagnostics)}
    }
    built := sema_tree_node(Type.Result{ok: result_type, err: failure}, TExprKind.ClosureMethod{receiver: receiver_value, operation: operation, args: typed}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(built, expected, environment, program, context, &diagnostics)}
}

fn sema_call_try_builtin_concurrency(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method == "send" && sema_call_concurrency_is_canonical_sender(receiver_value.ty, environment, program) {
        return sema_call_concurrency_check_sender(receiver, receiver_value, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    if method == "para_map" || method == "para_filter" || method == "para_partition" || method == "para_fold" {
        if sema_call_concurrency_list_element(receiver_value.ty) != None {
            return sema_call_concurrency_parallel(receiver, receiver_value, method, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        }
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}
