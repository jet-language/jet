// Mounting reflects one explicit struct value and
// expands to ordinary checked registrations. No backend discovers routes.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    BodyTree,
    CallArg,
    Diagnostic,
    Expr,
    FnBody,
    Func,
    Lambda,
    LambdaBody,
    LambdaParam,
    Marker,
    NamedSpan,
    OrFallback,
    Span,
    StrPart,
    Stmt,
    Symbol,
    SymbolKind,
    TLetTy,
    Type,
    TypedLitBody,
    ast_binding,
    AST_EMPTY_CALL_ARG_FLAGS,
    ast_empty_lambda_meta,
    body_each_expr_child,
    body_each_stmt_child,
    body_node,
    body_type,
    expr_span,
    symbol_key_text,
    symbol_table_key,
    diagnostic_registry_row,
    checked_symbol_local,
    type_name,
    module_text,
    owned_trait_codec_names,
    ModuleID,
]

sema_http_route_marker_verb: fn(marker: Marker, graph: SemaRegistrationGraph, module_identity: ModuleID) -> String? {
    if marker.negated -> return None
    resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
    if resolved.status != "found" -> return None
    declaration: resolved.declaration ?? return None
    module_index: sema_registration_module_index(graph, resolved.declaring_module_identity) ?? return None
    if graph.modules[module_index].module_name != "core.http.server" -> return None
    // A route marker is named for its `Method` case: `#Get` registers `get`,
    // and `#Custom(token, path)` the custom method `token`.
    verb: declaration.name.lower()
    if verb != sema_http_route_custom_verb() && !sema_http_route_verbs().contains(verb) {
        return None
    }
    Val(verb)
}

// The Core module that declares the app endpoint markers (`use app`), and
// their names: a method marked `#App.SignedIn` or `#App.Public` is an
// endpoint.
SEMA_APP_MARKER_MODULE: "app"

SEMA_APP_ENDPOINT_MARKERS: [String]{"SignedIn", "Public"}

// The app endpoint marker `marker` is, written in module `module_identity`:
// "SignedIn" or "Public"; None for any other marker.
sema_app_endpoint_access: fn(marker: Marker, graph: SemaRegistrationGraph, module_identity: ModuleID) -> String? {
    if marker.negated -> return None
    resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
    if resolved.status != "found" -> return None
    declaration: resolved.declaration ?? return None
    module_index: sema_registration_module_index(graph, resolved.declaring_module_identity) ?? return None
    if graph.modules[module_index].module_name != SEMA_APP_MARKER_MODULE || !SEMA_APP_ENDPOINT_MARKERS.contains(declaration.name) {
        return None
    }
    Val("{declaration.name}")
}

// Whether `marker`, written in module `module_identity`, is one of the app
// module's endpoint markers.
sema_app_endpoint_marker: fn(marker: Marker, graph: SemaRegistrationGraph, module_identity: ModuleID) -> Bool {
    sema_app_endpoint_access(marker, graph, module_identity) != None
}

// The app markers of a webhook and of the method that gives its key. Neither
// marks an endpoint: no Remote calls either method.
SEMA_APP_WEBHOOK_MARKER: "Webhook"

SEMA_APP_SIGNING_KEY_MARKER: "SigningKey"

// The app marker of a schedule's method.
SEMA_APP_EVERY_MARKER: "Every"

// The app marker naming the check of an upload endpoint, and the app
// module's type of the file such an endpoint takes.
SEMA_APP_UPLOAD_CHECK_MARKER: "UploadCheck"

SEMA_APP_UPLOAD: "Upload"

// Whether `marker`, written in module `module_identity`, is the app module's
// marker `name`.
sema_app_marker_is: fn(marker: Marker, name: String, graph: SemaRegistrationGraph, module_identity: ModuleID) -> Bool {
    if marker.negated -> return false
    resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
    if resolved.status != "found" -> return false
    declaration: resolved.declaration ?? return false
    module_index: sema_registration_module_index(graph, resolved.declaring_module_identity) ?? return false
    graph.modules[module_index].module_name == SEMA_APP_MARKER_MODULE && declaration.name == name
}

// The app markers that keep a method on the server: a job, a schedule, a
// webhook and a webhook's signing key. None is an endpoint, so no endpoint
// marker may mark a method one of them marks.
SEMA_APP_SERVER_ONLY_MARKERS: [String]{SEMA_APP_JOB_MARKER, SEMA_APP_EVERY_MARKER, SEMA_APP_WEBHOOK_MARKER, SEMA_APP_SIGNING_KEY_MARKER}

// E2819 when an endpoint marker marks `func`, a method a server-only app
// marker also marks, both written in module `module_identity`.
sema_app_server_only_endpoint_check: fn(func: Func, graph: SemaRegistrationGraph, module_identity: ModuleID, diagnostics: ^[Diagnostic]) {
    loop marker in func.markers {
        if !sema_app_endpoint_marker(marker, graph, module_identity) -> next
        loop other in func.markers {
            loop name in SEMA_APP_SERVER_ONLY_MARKERS {
                if !sema_app_marker_is(other, name, graph, module_identity) -> next
                entry: diagnostic_registry_row("E2819") ?? panic("E2819 must have a registry row")
                diagnostics.push(sema_error("E2819", marker.span, entry.what.replace("{{method}}", func.name).replace("{{marker}}", other.name).replace("{{endpoint}}", marker.name), entry.why, entry.fix.replace("{{method}}", func.name).replace("{{endpoint}}", marker.name)))
                return
            }
        }
    }
}

// The index in `marker.args` of the written argument labeled `label`, else
// of the unlabeled one at `position`.
sema_app_marker_arg_at: fn(marker: Marker, label: String, position: Int) -> Int? {
    loop (index, argument) in marker.args {
        if !(argument == .Expr(_)) -> next
        chosen := index == position
        if index < marker.arg_labels.len() {
            if marker.arg_labels[index] == .Val(named) -> chosen = named.name == label
        }
        if chosen -> return Val(index)
    }
    None
}

// The static String that argument `at` of `marker` gives; None when it
// gives none.
sema_app_marker_string: fn(marker: Marker, at: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> String? {
    if marker.args[at] == .Expr(value) {
        return sema_http_route_constant_string(value, environment, program, scopes)
    }
    None
}

// Where argument `at` of `marker` is written.
sema_app_marker_span: fn(marker: Marker, at: Int) -> Span {
    if marker.args[at] == .Expr(value) -> return expr_span(value)
    marker.span
}

// Argument `at` of `marker`, checked as `expected`, as an argument of an App
// registration.
sema_app_marker_checked: fn(marker: Marker, at: Int, expected: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> TCallArg? {
    if marker.args[at] == .Expr(value) {
        checked: sema_check_expression(value, Val(expected), environment, program, scopes, check, diagnostics) ?? return None
        return Val(sema_call_http_static_tree_arg(checked, sema_http_mount_arg(value, expr_span(value))))
    }
    None
}

// The marker that makes method `func` an endpoint, written in module
// `module_identity`, as written (`#App.SignedIn`,
// `#Server.Get("/orders/:id")`), for `jet inspect choices`
// (FnBody.endpoint); "" when no app endpoint marker or route marker marks
// it.
sema_function_endpoint: fn(func: Func, graph: SemaRegistrationGraph, module_identity: ModuleID) -> String {
    loop marker in func.markers {
        if !sema_app_endpoint_marker(marker, graph, module_identity) && sema_http_route_marker_verb(marker, graph, module_identity) == None {
            next
        }
        return sema_marker_written(marker)
    }
    ""
}

// The server-only app marker that runs method `func` as the system, written
// in module `module_identity`, as written (`#App.Job`,
// `#App.Every(cron: "0 8 * * *")`), for `jet inspect choices`
// (FnBody.system_run); "" when none marks it. A job, a schedule, a webhook
// and a webhook's signing key run as the system, which no row policy limits.
sema_function_system_run: fn(func: Func, graph: SemaRegistrationGraph, module_identity: ModuleID) -> String {
    loop marker in func.markers {
        loop name in SEMA_APP_SERVER_ONLY_MARKERS {
            if sema_app_marker_is(marker, name, graph, module_identity) {
                return sema_marker_written(marker)
            }
        }
    }
    ""
}

// `marker` as written, its arguments included: an argument that is no plain
// String literal shows as `…`, and a labeled one keeps its label.
sema_marker_written: fn(marker: Marker) -> String {
    if marker.args.len() == 0 -> return "#{marker.name}"
    args := [String]{}
    loop (index, argument) in marker.args {
        text := "…"
        if argument == .Expr(value) {
            if value == .Str(parts, _, _) {
                if parts.len() == 1 {
                    if parts[0] == .Lit(literal) -> text = "\"{literal}\""
                }
            }
        }
        if index < marker.arg_labels.len() {
            if marker.arg_labels[index] == .Val(label) -> text = "{label.name}: {text}"
        }
        args.push(text)
    }
    "#{marker.name}({args.join(", ")})"
}

// `app.Remote<S>`, the app module's client of a service, and the methods
// the client calls of it lower to.
SEMA_APP_REMOTE: "Remote"

SEMA_APP_REMOTE_CALL: "__call"

SEMA_APP_REMOTE_CALL_VALUE: "__call_value"

SEMA_APP_REMOTE_WRITE: "__write"

SEMA_APP_REMOTE_WRITE_VALUE: "__write_value"

SEMA_APP_REMOTE_ARG: "__arg"

SEMA_APP_REMOTE_RAISE: "__raise"

// Whether `ty`, a resolved type of one type argument, is `app.Remote<S>`.
sema_app_is_remote: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    graph: program.registration_graph ?? return false
    row: sema_type_resolve_nominal_row(graph, ty, environment.module_identity) ?? return false
    graph.modules[row.module_index].module_name == SEMA_APP_MARKER_MODULE && graph.modules[row.module_index].nominals[row.row].symbol.name == SEMA_APP_REMOTE
}

// The indices of the parameters of `method`, declared in module
// `module_identity`, that take an `app.Upload`.
sema_app_upload_params: fn(method: Func, graph: SemaRegistrationGraph, module_identity: ModuleID) -> [Int] {
    found := [Int]{}
    loop index in 1..<method.params.len() {
        param: sema_type_resolve_declared(graph, method.params[index].ty, module_identity)
        row: sema_type_resolve_nominal_row(graph, param, module_identity) ?? next
        if graph.modules[row.module_index].module_name == SEMA_APP_MARKER_MODULE && graph.modules[row.module_index].nominals[row.row].symbol.name == SEMA_APP_UPLOAD {
            found.push(index)
        }
    }
    found
}

// `remote.method(args…)` on an `app.Remote<S>`. A method of `S` that
// `#App.SignedIn` or `#App.Public` marks is a remote call
// (`sema_app_remote_call`). Any other method of `S` is server-only (E2812),
// and a name `S` does not declare is no method of the Remote (E0102).
sema_call_app_remote_method: fn(receiver: Expr, service: Type, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> TExpr? {
    graph: program.registration_graph ?? return None
    shown := "app.Remote<{type_name(service)}>"
    declared := false
    if sema_type_resolve_nominal_row(graph, service, environment.module_identity) == .Val(row) {
        shown = "app.Remote<{graph.modules[row.module_index].nominals[row.row].symbol.name}>"
        service_module: graph.modules[row.module_index].module_identity
        if sema_http_route_find_struct(environment, program, service, environment.module_identity) == .Val(definition) {
            loop declaration in definition.methods {
                if declaration.name != method -> next
                declared = true
                endpoint: loop marker in declaration.markers {
                    if sema_app_endpoint_marker(marker, graph, service_module) {
                        break true
                    }
                } ?? false
                if !endpoint -> next
                if owner_type_args.len() != 0 || type_args.len() != 0 {
                    diagnostics.push(sema_call_not_generic_diagnostic(method, method_span))
                    sema_data_check_discarded_arguments(args, environment, program, scopes, check, diagnostics)
                    return None
                }
                return sema_app_remote_call(receiver, service, shown, declaration, service_module, method_span, args, expected, environment, program, scopes, check, diagnostics)
            }
        }
    }
    if {
        declared -> {
            entry: diagnostic_registry_row("E2812") ?? panic("E2812 must have a registry row")
            diagnostics.push(sema_error("E2812", method_span, entry.what.replace("{{remote}}", shown).replace("{{method}}", method), entry.why, entry.fix.replace("{{method}}", method)))
        }
        else -> {
            diagnostics.push(sema_error("E0102", method_span, "`{shown}` has no method `{method}`", "`{shown}` offers only the methods of its service that `#App.SignedIn` or `#App.Public` marks", "call a marked method of the service"))
        }
    }
    sema_data_check_discarded_arguments(args, environment, program, scopes, check, diagnostics)
    None
}

// `alias.endpoints<S>()`: the names of the methods of the service `S` that
// an endpoint marker (`#App.SignedIn`, `#App.Public`) marks, in the order
// `S` declares them, as a `[String]`. A job, a webhook, a signing key and an
// unmarked method are server-only, so the list never names one.
sema_call_app_endpoints: fn(alias: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> SemaDirectSpecialCheck {
    callee: "{alias}.endpoints"
    if args.len() != 0 {
        sema_data_arity_diagnostic(callee, 0, args.len(), span, diagnostics)
        sema_data_check_discarded_arguments(args, environment, program, scopes, check, diagnostics)
        return sema_live_rejected()
    }
    if type_args.len() != 1 {
        diagnostics.push(sema_error("E0119", span, "`{callee}` expects exactly one type argument, got {type_args.len()}", "`{callee}<S>()` lists the endpoints of one service, `S`", "write `{callee}<S>()` with the service as its type argument"))
        return sema_live_rejected()
    }
    graph: program.registration_graph ?? return sema_live_rejected()
    service: sema_type_resolve_declared_with_generics(graph, type_args[0], environment.module_identity, environment.generic_params)
    row: sema_type_resolve_nominal_row(graph, service, environment.module_identity) ?? return sema_app_endpoints_no_service(callee, service, span, diagnostics)
    definition: sema_http_route_find_struct(environment, program, service, environment.module_identity) ?? return sema_app_endpoints_no_service(callee, service, span, diagnostics)
    service_module: graph.modules[row.module_index].module_identity
    names := [Expr]{}
    loop declaration in definition.methods {
        endpoint: loop marker in declaration.markers {
            if sema_app_endpoint_marker(marker, graph, service_module) {
                break true
            }
        } ?? false
        if endpoint -> names.push(sema_live_string(declaration.name, span))
    }
    listed: Expr.TypedLit{head: Val(Type.List{element: Type.String}), body: TypedLitBody.Elements{elements: names}, span: span, id: AST_NODE_GENERATED}
    SemaDirectSpecialCheck{handled: true, value: sema_check_expression(listed, expected, environment, program, scopes, check, diagnostics)}
}

sema_app_endpoints_no_service: fn(callee: String, service: Type, span: Span, diagnostics: ^[Diagnostic]) -> SemaDirectSpecialCheck {
    diagnostics.push(sema_error("E0119", span, "{sema_type_show_quoted(service)} names no service struct, so `{callee}` has no endpoints to list", "`{callee}<S>()` lists the marked methods of the struct `S`", "name the service struct as the type argument"))
    sema_live_rejected()
}

sema_app_remote_ident: fn(name: String, span: Span) -> Expr Never! {
    Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
}

// `remote.method<type_args>(args)`, where `remote` names the hidden local
// or the caller's local that holds the Remote.
sema_app_remote_method_call: fn(remote: String, method: String, type_args: [Type], args: [CallArg], span: Span) -> Expr Never! {
    Expr.MethodCall{receiver: sema_app_remote_ident(remote, span), method: method, method_span: span, owner_type_args: [Type]{}, type_args: type_args, args: args, id: AST_NODE_GENERATED}
}

// The endpoint method `declaration` of `S`, called through a Remote. The
// Remote, unless it is a local, and each argument are evaluated once into
// hidden locals, the arguments with their parameters' types, and the call
// lowers to the Remote's `__call` (a method that can fail with `E`) or
// `__call_value` (one that can't): `direct` runs the method on the service
// the Remote holds, and otherwise the encoded arguments go to the server.
// A method that answers nothing is a write, which a device that queues may
// queue, so it lowers to `__write` or `__write_value`. The call's type is
// `R E!`, or `R app.CallError!` for a method that can't fail.
sema_app_remote_call: fn(receiver: Expr, service: Type, shown: String, declaration: Func, service_module: ModuleID, method_span: Span, args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> TExpr? {
    graph: program.registration_graph ?? return None
    method: declaration.name
    concrete: declaration.params.len() > 0 && declaration.params[0].name == "self" && declaration.params[0].convention == AccessConvention.Read && declaration.type_params.len() == 0
    read_only: loop index in 1..<declaration.params.len() {
        if declaration.params[index].convention != AccessConvention.Read {
            break false
        }
    } ?? true
    if !concrete || !read_only {
        diagnostics.push(sema_error("E2805", method_span, "`{shown}.{method}` needs read-only self, read parameters and a concrete signature", "a remote call sends its arguments to the server as data and runs the method on the server's service", "write `{method}: fn(self, ...)` with read parameters and without method type parameters"))
        sema_data_check_discarded_arguments(args, environment, program, scopes, check, diagnostics)
        return None
    }
    wanted: declaration.params.len() - 1
    if args.len() != wanted {
        diagnostics.push(sema_call_arity_diagnostic(method, wanted, args.len(), false, method_span))
        sema_data_check_discarded_arguments(args, environment, program, scopes, check, diagnostics)
        return None
    }
    loop index in 0..<args.len() {
        name: declaration.params[index + 1].name
        named_other: if {
            args[index].label == .Val(label) -> label.name != name
            else -> false
        }
        if args[index].spread || named_other {
            diagnostics.push(sema_error("E0104", args[index].span, "`{shown}.{method}` takes its arguments in order", "a remote call checks each argument against the parameter in its place", "pass `{name}` as argument {index + 1}, without a spread or another label"))
            sema_data_check_discarded_arguments(args, environment, program, scopes, check, diagnostics)
            return None
        }
    }
    start: method_span.start
    hidden: "__jet_app_remote_{start}"
    sema_scope_enter(scopes, check.state, "app.remote:{start}")
    body := [TStmt]{}
    remote: if {
        receiver == .Ident(written, _, _) -> "{written}"
        else -> "{hidden}"
    }
    if !(receiver == .Ident(_, _, _)) {
        held: sema_stmt_check_binding(ast_binding(remote, expr_span(receiver), false, receiver, None), None, environment, program, scopes, check, diagnostics) ?? {
            sema_single_use_leave_scope(scopes, check.state, diagnostics)
            return None
        }
        body.push(held)
    }
    encoded := [Expr]{}
    reads := [CallArg]{}
    loop index in 0..<args.len() {
        // A bare name is read where it stands (a read parameter cannot be
        // moved into a local); any other argument is bound once, as its
        // parameter's type, so it runs once.
        local_name: if {
            args[index].expr == .Ident(written, _, _) -> "{written}"
            else -> "{hidden}_{index}"
        }
        if !(args[index].expr == .Ident(_, _, _)) {
            binding := ast_binding(local_name, args[index].span, false, args[index].expr, None)
            binding.ty = Val(sema_type_resolve_declared(graph, declaration.params[index + 1].ty, service_module))
            statement: sema_stmt_check_binding(binding, None, environment, program, scopes, check, diagnostics) ?? {
                sema_single_use_leave_scope(scopes, check.state, diagnostics)
                return None
            }
            body.push(statement)
        }
        encoded.push(sema_app_remote_method_call(remote, SEMA_APP_REMOTE_ARG, [Type]{}, [CallArg]{sema_http_mount_arg(sema_app_remote_ident(local_name, args[index].span), args[index].span)}, args[index].span))
        reads.push(sema_http_mount_arg(sema_app_remote_ident(local_name, args[index].span), args[index].span))
    }
    service_name: "{hidden}_service"
    invocation: Expr.MethodCall{receiver: sema_app_remote_ident(service_name, method_span), method: method, method_span: method_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: reads, id: AST_NODE_GENERATED}
    direct: Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: [LambdaParam]{LambdaParam{name: service_name, name_span: method_span, ty: Val(service), ty_span: None, convention: AccessConvention.Read}}, effects: None, body: LambdaBody.Expr{value: invocation}, span: method_span, meta: ast_empty_lambda_meta()}, id: AST_NODE_GENERATED}
    wire: [CallArg]{
        sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: method}}, span: method_span, id: AST_NODE_GENERATED}, method_span),
        sema_http_mount_arg(Expr.ListLit{elements: encoded, span: method_span, id: AST_NODE_GENERATED}, method_span),
        sema_http_mount_arg(direct, method_span),
    }
    returned: declaration.return_type ?? Type.Named{name: "Unit"}
    declared_return: sema_type_resolve_declared(graph, returned, service_module)
    raised_return: sema_type_resolve_declared(graph, returned, service_module)
    // A method that can't fail (`T Never!`) is called as one that answers
    // `T`: it has no error to encode.
    answer: if declared_return == .Result(ok, .Named(never)) && never == "Never" -> ok else -> declared_return
    lowered: if {
        answer == .Result(ok, failure) -> sema_app_remote_fallible(remote, hidden, wire, ok, failure, raised_return, method_span)
        answer == (Type.Named{name: "Unit"}) -> sema_app_remote_method_call(remote, SEMA_APP_REMOTE_WRITE_VALUE, [Type]{}, wire, method_span)
        else -> sema_app_remote_method_call(remote, SEMA_APP_REMOTE_CALL_VALUE, [Type]{answer}, wire, method_span)
    }
    // The lowered call keeps its Result carrier: the remote call is the call
    // root, which its consumer (`??`, `?`) reads or auto-propagates.
    checked: sema_check_expression_carrier(lowered, None, environment, program, scopes, check, diagnostics) ?? {
        sema_single_use_leave_scope(scopes, check.state, diagnostics)
        return None
    }
    result_type: checked.ty
    body.push(TStmt.ExprStmt{value: checked, span: method_span})
    sema_single_use_leave_scope(scopes, check.state, diagnostics)
    sema_expression_call_expected(sema_tree_node(result_type, TExprKind.InlineBlock{body: body}, method_span), expected, environment, program, check.context, diagnostics)
}

// `remote.__call<R, E>(method, args, direct, fail)` for an endpoint method
// that fails with `E`, or `remote.__write<E>(…)` when `R` is `Unit`: `fail`
// raises the transport's `CallError` as an `R CallError!` through its own
// `__raise<R>`, so the closure captures nothing (the Remote stays usable
// after the call), and the error converts to `E` as any propagated error
// does. `raised_return` is the method's `R E!` once more, for `__raise<R>`;
// `hidden` prefixes the closure's names.
sema_app_remote_fallible: fn(remote: String, hidden: String, wire: ^^[CallArg], ok: Type, failure: Type, raised_return: Type, span: Span) -> Expr Never! {
    failure_name: "{hidden}_failure"
    raised_name: "{hidden}_raised"
    raised_ok: if {
        raised_return == .Result(success, _) -> success
        else -> Type.Named{name: "Unit"}
    }
    raise: sema_app_remote_method_call(failure_name, SEMA_APP_REMOTE_RAISE, [Type]{raised_ok}, [CallArg]{}, span)
    fail_body: [Stmt]{Stmt.Val{binding: ast_binding(raised_name, span, false, raise, None)}, Stmt.Expr{expr: Expr.Ok{value: sema_app_remote_ident(raised_name, span), span: span, id: AST_NODE_GENERATED}}}
    fail: Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: [LambdaParam]{LambdaParam{name: failure_name, name_span: span, ty: None, ty_span: None, convention: AccessConvention.Read}}, effects: None, body: LambdaBody.Block{body: fail_body}, span: span, meta: ast_empty_lambda_meta()}, id: AST_NODE_GENERATED}
    filled := wire.move()
    filled.push(sema_http_mount_arg(fail, span))
    if ok == (Type.Named{name: "Unit"}) {
        return sema_app_remote_method_call(remote, SEMA_APP_REMOTE_WRITE, [Type]{failure}, filled, span)
    }
    sema_app_remote_method_call(remote, SEMA_APP_REMOTE_CALL, [Type]{ok, failure}, filled, span)
}

// The module that declares the web markers. The web rules key on its
// markers (`#RouteTable` on App, `#Form` on a form model, `#ColumnOf` on
// table.column's name), never on another module's same-named ones; its
// submodules declare theirs.
SEMA_WEB_MARKER_MODULE: "core.web"

SEMA_WEB_MARKER_ROUTE_TABLE: "RouteTable"

SEMA_WEB_MARKER_FORM: "Form"

SEMA_WEB_MARKER_COLUMN_OF: "ColumnOf"

// Whether `marker`, written in the module `module_identity`, is the web
// module's marker `name`.
sema_web_marker_is: fn(marker: Marker, graph: SemaRegistrationGraph, module_identity: ModuleID, name: String) -> Bool {
    if marker.negated || (marker.name != name && !marker.name.ends_with(".{name}")) -> return false
    resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
    if resolved.status != "found" -> return false
    declaration: resolved.declaration ?? return false
    module_index: sema_registration_module_index(graph, resolved.declaring_module_identity) ?? return false
    declaring: graph.modules[module_index].module_name
    (declaring == SEMA_WEB_MARKER_MODULE || declaring.starts_with("{SEMA_WEB_MARKER_MODULE}.")) && declaration.name == name
}

// The index of the parameter of the function `key` that carries the web
// marker `name`. A parameter's marker is an applied rule of its module at
// the Parameter site, written ahead of the parameter's name; it belongs to
// the parameter whose name it precedes, after the previous parameter's type.
sema_web_param_marker: fn(graph: SemaRegistrationGraph, key: String, name: String) -> Int? {
    row: sema_registration_callable_row(graph, key) ?? return None
    if row == {
        .Function(module_index, index) -> {
            loop application in graph.modules[module_index].program.applied_rules {
                if application.site != (Val(RuleSite.Parameter)) -> next
                target: application.target ?? next
                if !sema_web_marker_is(application.marker, graph, graph.modules[module_index].module_identity, name) {
                    next
                }
                if sema_web_param_at(graph.modules[module_index].functions[index].declaration, target) == .Val(param) {
                    return Val(param)
                }
            }
            None
        }
        .Foreign(_, _) | .NominalMethod(_, _, _) | .ImplMethod(_, _, _) -> None
    }
}

sema_web_param_at: fn(function: Func, target: Span) -> Int? Never! {
    start := function.name_span.end
    loop param_index in 0..<function.params.len() {
        if target.start >= start && target.end <= function.params[param_index].name_span.start {
            return Val(param_index)
        }
        start = function.params[param_index].ty_span.end
    }
    None
}

sema_http_mount_arg: fn(expression: Expr, span: Span) -> CallArg Never! {
    CallArg{
        convention: AccessConvention.Read,
        expr: expression,
        span: span,
        flags: AST_EMPTY_CALL_ARG_FLAGS,
        label: None,
        spread: false,
    }
}

// `app.mount(value)` and `app.mount(prefix, value)`: each route-marked method
// of the struct value registers as the single route its marker names, and
// each endpoint-marked one as POST `{prefix}/{name}`
// (`sema_app_mount_endpoint`), under the static `prefix` when there is one;
// the call is the App, so it chains.
sema_call_http_mount: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> SemaMethodSpecialCheck {
    // The app graph mounts a service at its key: `.api<S>` names where its
    // clients reach it, so its `.mount` takes the service alone.
    on_graph: sema_app_is_graph(receiver_value.ty, environment, program)
    if on_graph && args.len() != 1 {
        diagnostics.push(sema_error("E2805", args[0].span, "the app graph's `.mount` takes no prefix", "the graph answers a mounted service's calls at the path its `.api<S>` declares", "remove the prefix: `.mount(service)`"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if args.len() != 1 && args.len() != 2 {
        diagnostics.push(sema_call_arity_diagnostic("mount", 2, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    prefix := ""
    if args.len() == 2 {
        text: sema_http_route_constant_string(args[0].expr, environment, program, scopes) ?? {
            diagnostics.push(sema_error("E2805", args[0].span, "app.mount prefix must be a static String", "a mounted struct's routes are fully checked while building, prefix included", "use a literal or compile-time String constant"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        prefix = sema_http_mount_prefix(text)
    }
    value_arg: args[args.len() - 1]
    call_frame: scopes.current
    sema_scope_enter(scopes, check.state, "http.mount:{span.start}")
    body := [TStmt]{}
    mux_name: "__jet_http_mount_mux_{span.start}"
    owner: sema_scope_local_owner_key(scopes)
    local_module: sema_scope_environment_module_text(environment, program)
    mux_key: symbol_key_text(SymbolKind.Local, local_module, owner, mux_name)
    mux_id: sema_symbol_id_of(program, check.context, mux_key)
    mux_symbol: Symbol{
        id: mux_id,
        kind: SymbolKind.Local,
        name: mux_name,
        module_identity: environment.module_identity,
        owner: Val(owner),
        span: span,
        ty: Val(receiver_value.ty),
        visibility: 0,
    }
    _ := sema_scope_declare_local(scopes, mux_symbol, mux_key, false, AccessConvention.Read, None, false)
    sema_ownership_declare_binding(check.state, mux_symbol, false)
    mux_local: checked_symbol_local(mux_name, span, mux_id, receiver_value.ty)
    body.push(
        TStmt.Let{
            local: mux_local,
            let_ty: TLetTy.Inferred,
            init: receiver_value,
            gc_promotion: None,
            gc_transferred: false,
            span: span,
        },
    )
    value_name: "__jet_http_mount_value_{span.start}"
    binding: ast_binding(value_name, span, false, value_arg.expr, None)
    checked_binding := sema_stmt_check_binding(binding, None, environment, program, scopes, check, diagnostics)
    if checked_binding == .Val(statement) {
        body.push(statement)
        binding_index: sema_scope_resolve_index(scopes, value_name) ?? panic("mounted value binding is absent")
        value_ty: scopes.bindings[binding_index].symbol.ty ?? panic("mounted value has no type")
        if sema_http_route_find_struct(environment, program, value_ty, environment.module_identity) == .Val(definition) {
            if program.registration_graph == .Val(graph) {
                nominal_row: sema_type_resolve_nominal_row(graph, value_ty, environment.module_identity) ?? panic("mount has no nominal row")
                method_module: graph.modules[nominal_row.module_index].module_identity
                // The graph's endpoints are keyed by the service's identity,
                // the key its Remotes find them by.
                if on_graph {
                    prefix = graph.modules[nominal_row.module_index].nominals[nominal_row.row].identity_key.copy()
                }
                loop method in definition.methods {
                    uploads: sema_app_upload_params(method, graph, method_module)
                    // An endpoint method answers POST `{prefix}/{name}`, once
                    // whatever markers it carries; one that takes an `Upload`
                    // through an upload endpoint.
                    loop marker in method.markers {
                        access: sema_app_endpoint_access(marker, graph, method_module) ?? next
                        if uploads.len() > 0 && on_graph {
                            diagnostics.push(sema_app_graph_mount_refused(method.name, "an upload endpoint", marker.span))
                            break
                        }
                        mux_node: sema_tree_node(receiver_value.ty, TExprKind.Local{local: mux_local}, span)
                        endpoint: if uploads.len() == 0 -> sema_app_mount_endpoint(mux_node, value_name, method, method_module, access, marker, prefix, span, environment, program, scopes, check, diagnostics) else -> sema_app_mount_upload(mux_node, value_name, graph.modules[nominal_row.module_index].nominals[nominal_row.row].identity_key, definition.methods, method, method_module, uploads, access, marker, prefix, span, environment, program, scopes, check, diagnostics)
                        if endpoint == .Val(value) {
                            body.push(TStmt.ExprStmt{value: value, span: span})
                        }
                        break
                    }
                    // `#App.UploadCheck` checks an upload before it is read,
                    // so marks only a method that takes one.
                    if uploads.len() == 0 {
                        loop marker in method.markers {
                            if sema_app_marker_is(marker, SEMA_APP_UPLOAD_CHECK_MARKER, graph, method_module) {
                                diagnostics.push(sema_error("E2805", marker.span, "`{method.name}` takes no `app.Upload`, so it has no upload to check", "`#App.UploadCheck` names the check an upload endpoint runs before it reads the request's file", "remove the marker, or take the file as an `app.Upload` parameter of `{method.name}`"))
                            }
                        }
                    }
                    // A webhook answers POST `{prefix}{path}` for its sender.
                    loop marker in method.markers {
                        if !sema_app_marker_is(marker, SEMA_APP_WEBHOOK_MARKER, graph, method_module) {
                            next
                        }
                        if on_graph {
                            diagnostics.push(sema_app_graph_mount_refused(method.name, "a webhook", marker.span))
                            break
                        }
                        hook: sema_app_mount_webhook(sema_tree_node(receiver_value.ty, TExprKind.Local{local: mux_local}, span), value_name, graph.modules[nominal_row.module_index].nominals[nominal_row.row].symbol.name, definition.methods, method, method_module, marker, prefix, span, environment, program, scopes, check, diagnostics)
                        if hook == .Val(value) {
                            body.push(TStmt.ExprStmt{value: value, span: span})
                        }
                        break
                    }
                    // A schedule runs on its cron line once the App serves.
                    loop marker in method.markers {
                        if !sema_app_marker_is(marker, SEMA_APP_EVERY_MARKER, graph, method_module) {
                            next
                        }
                        if on_graph {
                            diagnostics.push(sema_app_graph_mount_refused(method.name, "a schedule", marker.span))
                            break
                        }
                        schedule: sema_app_mount_schedule(sema_tree_node(receiver_value.ty, TExprKind.Local{local: mux_local}, span), value_name, graph.modules[nominal_row.module_index].nominals[nominal_row.row].symbol.name, method, method_module, marker, span, environment, program, scopes, check, diagnostics)
                        if schedule == .Val(value) {
                            body.push(TStmt.ExprStmt{value: value, span: span})
                        }
                        break
                    }
                    // A job's rows a store keeps run on a serving server.
                    loop marker in method.markers {
                        if !sema_app_marker_is(marker, SEMA_APP_JOB_MARKER, graph, method_module) {
                            next
                        }
                        job: sema_app_mount_job(sema_tree_node(receiver_value.ty, TExprKind.Local{local: mux_local}, span), value_name, graph.modules[nominal_row.module_index].nominals[nominal_row.row].symbol.name, method, method_module, marker, span, environment, program, scopes, check, diagnostics)
                        if job == .Val(value) -> body.push(TStmt.ExprStmt{value: value, span: span})
                        break
                    }
                    loop marker in method.markers {
                        verb: sema_http_route_marker_verb(marker, graph, method_module) ?? next
                        if on_graph {
                            diagnostics.push(sema_app_graph_mount_refused(method.name, "an HTTP route", marker.span))
                            next
                        }
                        if method.params.len() == 0 || method.params[0].name != "self" || method.params[0].convention != AccessConvention.Read || method.type_params.len() != 0 {
                            diagnostics.push(sema_error("E2805", marker.span, "HTTP route method `{method.name}` needs read-only self and a concrete signature", "mounted handlers retain shared state and are called on request workers", "write `{method.name}: fn(self, ...)` without method type parameters; use Shared<T> for mutable shared state"))
                            next
                        }
                        // `#Custom` takes its method token before the path.
                        marked := [CallArg]{}
                        loop mark_arg in marker.args {
                            if mark_arg == .Expr(mark_value) {
                                marked.push(sema_http_mount_arg(mark_value, expr_span(mark_value)))
                            }
                        }
                        custom: verb == sema_http_route_custom_verb()
                        marked_count: if custom -> 2 else -> 1
                        if marker.args.len() != marked_count || marked.len() != marked_count -> next
                        if custom && sema_http_route_constant_string(marked[0].expr, environment, program, scopes) == None {
                            diagnostics.push(sema_error("E2808", marked[0].span, "`#Server.Custom` route method must be a static String", "a marked route is fully checked while building; only `app.custom` takes a run-time method, checked when it registers", "use a literal or compile-time String constant, or register the route with `app.custom`"))
                            next
                        }
                        if prefix != "" {
                            path_at: marked_count - 1
                            path: sema_http_route_constant_string(marked[path_at].expr, environment, program, scopes) ?? {
                                diagnostics.push(sema_error("E2805", marked[path_at].span, "a route marker under a mount prefix needs a static path", "the mounted route's address is the prefix and the marker's path, checked while building", "use a literal or compile-time String constant"))
                                next
                            }
                            marked[path_at] = sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: "{prefix}{path}"}}, span: marked[path_at].span, id: AST_NODE_GENERATED}, marked[path_at].span)
                        }
                        params := [LambdaParam]{}
                        call_args := [CallArg]{}
                        loop index in 1..<method.params.len() {
                            parameter_ty: sema_type_resolve_declared(graph, method.params[index].ty, method_module)
                            params.push(LambdaParam{name: method.params[index].name, name_span: method.params[index].name_span, ty: Val(parameter_ty), ty_span: None, convention: AccessConvention.Read})
                            argument := sema_http_mount_arg(Expr.Ident{name: method.params[index].name, span: method.params[index].name_span, id: AST_NODE_GENERATED}, method.params[index].name_span)
                            argument.convention = method.params[index].convention
                            call_args.push(argument)
                        }
                        invocation: Expr.MethodCall{receiver: Expr.Ident{name: value_name.copy(), span: span, id: AST_NODE_GENERATED}, method: method.name, method_span: method.name_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: call_args, id: AST_NODE_GENERATED}
                        meta := ast_empty_lambda_meta()
                        nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
                        loop registered in nominal.methods {
                            if registered.declaration.name == method.name {
                                meta.http_route_source = Val(symbol_table_key(graph.symbols, registered.symbol.id))
                            }
                        }
                        // The marked method stands for the call `verb(path)`
                        // at its marker, which the receiver's rules hear.
                        _ := sema_call_rules_hear_stand_in(receiver, receiver_value, verb, marker.span, marked, None, "mount{span.start}", call_frame, environment, program, scopes, check, diagnostics)
                        handler: Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: params, effects: None, body: LambdaBody.Expr{value: invocation}, span: marker.span, meta: meta}, id: AST_NODE_GENERATED}
                        marked.push(sema_http_mount_arg(handler, marker.span))
                        registration: sema_call_try_http_router(receiver, sema_tree_node(receiver_value.ty, TExprKind.Local{local: mux_local}, span), verb, marked, marker.span, None, environment, program, scopes, check, diagnostics)
                        if registration.value == .Val(value) {
                            body.push(TStmt.ExprStmt{value: value, span: marker.span})
                        }
                    }
                }
            } else { panic("mount has no registration graph") }
        } else {
            diagnostics.push(sema_error("E2805", value_arg.span, "app.mount needs an ordinary struct, not `{type_name(value_ty)}`", "only the explicitly mounted struct's tagged methods contribute routes", "pass a struct value with #Server.Get or another core.http.server verb marker"))
        }
    }
    // The block's value is the App, so `app.mount(value)` chains.
    body.push(TStmt.ExprStmt{value: sema_tree_node(receiver_value.ty, TExprKind.Local{local: mux_local}, span), span: span})
    sema_single_use_leave_scope(scopes, check.state, diagnostics)
    value: sema_tree_node(receiver_value.ty, TExprKind.InlineBlock{body: body}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

// E2805 for the method `method` of a service the app graph mounts that is
// `what`, a server-side registration the graph runs on no target.
sema_app_graph_mount_refused: fn(method: String, what: String, span: Span) -> Diagnostic Never! {
    sema_error("E2805", span, "the app graph can't mount `{method}`, which is {what}", "the app graph runs on every target and answers only the calls of its clients' Remotes; {what} answers the server alone", "mount the service on the server's `web.App` as well, which serves its webhooks, schedules and routes")
}

// The endpoint method `method` of the mounted value `value_name` answers
// POST `{prefix}/{name}` on the App `mux`, where a Remote that `remote_at`
// made posts its calls. An `#App.Public` method registers through the App's
// `__remote_public`, an `#App.SignedIn` one through `__remote_signed_in`,
// each with a handler that decodes each argument from the posted JSON array
// and encodes the method's reply. Both take the endpoint `marker`'s rate
// limit (`sema_app_endpoint_limit`); a server's `__remote_public` also takes
// the name of the method's reply type (`sema_app_reply_key`), whose
// `.cache<V>` policy it answers under. The app graph runs a call in this
// process, where no HTTP cache sits, so its `__remote_public` takes no reply
// name, and its `__remote_signed_in` no handler, as it answers `SignedOut`.
// The generated code is the mount call's, at `span`: the marker may sit in
// another file, or outside the function that mounts, and a generated
// handler is a lambda of that function.
sema_app_mount_endpoint: fn(mux: TExpr, value_name: String, method: Func, method_module: ModuleID, access: String, marker: Marker, prefix: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> TExpr? {
    graph: program.registration_graph ?? return None
    if !sema_app_mount_concrete(method) {
        diagnostics.push(sema_error("E2805", marker.span, "endpoint method `{method.name}` needs read-only self, read parameters and a concrete signature", "a mounted endpoint decodes its arguments from the request and runs on request workers", "write `{method.name}: fn(self, ...)` with read parameters and without method type parameters"))
        return None
    }
    address: "{prefix}/{method.name}"
    path: sema_call_http_static_tree_arg(sema_call_http_core_string(address, span), sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: address}}, span: span, id: AST_NODE_GENERATED}, span))
    limit := sema_app_endpoint_limit(marker, environment, program, scopes, check, diagnostics) ?? return None
    window: limit.pop() ?? panic("an endpoint limit has no window")
    calls: limit.pop() ?? panic("an endpoint limit has no count")
    member: if access == "SignedIn" -> "__remote_signed_in" else -> "__remote_public"
    on_graph: sema_app_is_graph(mux.ty, environment, program)
    if on_graph && access == "SignedIn" {
        return sema_call_http_mux_source_call(mux, member, [TCallArg]{path, calls, window}, span, None, environment, program, scopes, check, diagnostics).value
    }
    answer: sema_app_mount_answer(value_name, method, method_module, sema_app_mux_param_type(mux, member, 1, span, environment, program, diagnostics), span, environment, program, scopes, check, diagnostics) ?? return None
    if on_graph || access == "SignedIn" {
        return sema_call_http_mux_source_call(mux, member, [TCallArg]{path, answer, calls, window}, span, None, environment, program, scopes, check, diagnostics).value
    }
    declared_return: sema_type_resolve_declared(graph, method.return_type ?? Type.Named{name: "Unit"}, method_module)
    replied: if declared_return == .Result(ok, _) -> ok else -> declared_return
    key: sema_app_reply_key(graph, replied, method_module)
    reply: sema_call_http_static_tree_arg(sema_call_http_core_string(key, span), sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: key}}, span: span, id: AST_NODE_GENERATED}, span))
    sema_call_http_mux_source_call(mux, member, [TCallArg]{path, answer, calls, window, reply}, span, None, environment, program, scopes, check, diagnostics).value
}

// The endpoint method `method` of the mounted value `value_name`, of the
// service keyed `service`, whose parameter `uploads[0]` takes an
// `app.Upload`, answers POST `{prefix}/{name}` on the App `mux` through its
// `__remote_upload`: the request's body is the file, and the query's `args`
// the JSON array of the method's other arguments. The method's
// `#App.UploadCheck(method:)` names the method of `methods` that the server
// runs on those arguments, by name, before it reads the body
// (`sema_app_upload_check`). A method takes one `Upload` and names its
// check (E2805 otherwise). The answer, limit and window are an endpoint's
// (`sema_app_mount_endpoint`). The generated code is the mount call's, at
// `span`.
sema_app_mount_upload: fn(mux: TExpr, value_name: String, service: String, methods: [Func], method: Func, method_module: ModuleID, uploads: [Int], access: String, marker: Marker, prefix: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> TExpr? {
    graph: program.registration_graph ?? return None
    if !sema_app_mount_concrete(method) {
        diagnostics.push(sema_error("E2805", marker.span, "upload endpoint `{method.name}` needs read-only self, read parameters and a concrete signature", "a mounted endpoint decodes its arguments from the request and runs on request workers", "write `{method.name}: fn(self, ...)` with read parameters and without method type parameters"))
        return None
    }
    if uploads.len() > 1 {
        diagnostics.push(sema_error("E2805", method.params[uploads[1]].name_span, "upload endpoint `{method.name}` takes {uploads.len()} `app.Upload`s", "an upload endpoint's request body is its one file", "take one `app.Upload`, and upload each other file in a call of its own"))
        return None
    }
    check_at := -1
    loop (index, candidate) in method.markers {
        if sema_app_marker_is(candidate, SEMA_APP_UPLOAD_CHECK_MARKER, graph, method_module) {
            check_at = index
        }
    }
    if check_at < 0 {
        diagnostics.push(sema_error("E2805", marker.span, "upload endpoint `{method.name}` names no check", "the server checks an upload's caller before it reads the file, with the method `#App.UploadCheck(method:)` names", "mark `{method.name}` `#App.UploadCheck(method: \"may_{method.name}\")`, a method of the service that takes its other arguments by name and fails for a caller who may not upload"))
        return None
    }
    check_marker: method.markers[check_at]
    // The marker's own check reports a missing argument.
    name_at: sema_app_marker_arg_at(check_marker, "method", 0) ?? return None
    check_name: sema_app_marker_string(check_marker, name_at, environment, program, scopes) ?? {
        diagnostics.push(sema_error("E2805", sema_app_marker_span(check_marker, name_at), "an upload check's method must be a static String", "an upload endpoint's check is found while building", "use a literal or compile-time String constant"))
        return None
    }
    check_method_at := -1
    loop (index, candidate) in methods {
        if candidate.name == check_name -> check_method_at = index
    }
    if check_method_at < 0 {
        diagnostics.push(sema_error("E2805", sema_app_marker_span(check_marker, name_at), "`{check_name}` names no method of the service of `{method.name}`", "an upload endpoint's check is a method of its service, which the server runs before it reads the file", "name a method of the service, or declare `{check_name}: fn(self, ...)` taking the arguments of `{method.name}` it checks"))
        return None
    }
    upload_at: uploads[0]
    upload_check: sema_app_upload_check(mux, value_name, methods[check_method_at], method, method_module, upload_at, span, environment, program, scopes, check, diagnostics) ?? return None
    address: "{prefix}/{method.name}"
    path: sema_call_http_static_tree_arg(sema_call_http_core_string(address, span), sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: address}}, span: span, id: AST_NODE_GENERATED}, span))
    service_arg: sema_call_http_static_tree_arg(sema_call_http_core_string(service, span), sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: service}}, span: span, id: AST_NODE_GENERATED}, span))
    // The call's arguments hold the file at the Upload's position.
    at_value: Expr.Int{value: upload_at - 1, span: span, width: None, raw: None, id: AST_NODE_GENERATED}
    at_checked: sema_check_expression(at_value, Val(sema_app_mux_param_type(mux, "__remote_upload", 2, span, environment, program, diagnostics)), environment, program, scopes, check, diagnostics) ?? return None
    at_arg: sema_call_http_static_tree_arg(at_checked, sema_http_mount_arg(at_value, span))
    signed_value: Expr.Bool{value: access == "SignedIn", span: span, id: AST_NODE_GENERATED}
    signed_checked: sema_check_expression(signed_value, Val(sema_app_mux_param_type(mux, "__remote_upload", 3, span, environment, program, diagnostics)), environment, program, scopes, check, diagnostics) ?? return None
    signed_arg: sema_call_http_static_tree_arg(signed_checked, sema_http_mount_arg(signed_value, span))
    // The app module's own steps of the file: staging, ending the request,
    // serving a kept blob (core.app's `FileJob.run`).
    files_name: "__jet_http_upload_files_{span.start}"
    run: Expr.MethodCall{receiver: sema_app_remote_ident(files_name, span), method: "run", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, id: AST_NODE_GENERATED}
    files: sema_app_mount_callback(files_name, [Stmt]{Stmt.Expr{expr: Expr.Ok{value: run, span: span, id: AST_NODE_GENERATED}}}, sema_app_mux_param_type(mux, "__remote_upload", 5, span, environment, program, diagnostics), span, environment, program, scopes, check, diagnostics) ?? return None
    answer: sema_app_mount_answer(value_name, method, method_module, sema_app_mux_param_type(mux, "__remote_upload", 6, span, environment, program, diagnostics), span, environment, program, scopes, check, diagnostics) ?? return None
    limit := sema_app_endpoint_limit(marker, environment, program, scopes, check, diagnostics) ?? return None
    window: limit.pop() ?? panic("an endpoint limit has no window")
    calls: limit.pop() ?? panic("an endpoint limit has no count")
    sema_call_http_mux_source_call(mux, "__remote_upload", [TCallArg]{path, service_arg, at_arg, signed_arg, upload_check, files, answer, calls, window}, span, None, environment, program, scopes, check, diagnostics).value
}

// Whether a mounted method `method` has read-only self, read parameters and
// no method type parameters, so a request's decoded data can call it.
sema_app_mount_concrete: fn(method: Func) -> Bool {
    if method.params.len() == 0 || method.params[0].name != "self" || method.params[0].convention != AccessConvention.Read || method.type_params.len() != 0 {
        return false
    }
    loop index in 1..<method.params.len() {
        if method.params[index].convention != AccessConvention.Read -> return false
    }
    true
}

// The index in `methods`, declared in module `module_identity`, of the
// method named `name` that `#App.SigningKey` marks; None when no method is
// both.
sema_app_signing_key_at: fn(methods: [Func], name: String, graph: SemaRegistrationGraph, module_identity: ModuleID) -> Int? {
    loop (index, candidate) in methods {
        if candidate.name != name -> next
        loop marker in candidate.markers {
            if sema_app_marker_is(marker, SEMA_APP_SIGNING_KEY_MARKER, graph, module_identity) {
                return Val(index)
            }
        }
    }
    None
}

// The webhook method `method` of the mounted value `value_name`, of the
// service `service`, answers POST `{prefix}{path}` on the App `mux` through
// its `__webhook`, by its `#App.Webhook` `marker`. Its parameters named for
// the path's parameters take them; one more, last, takes the delivery's
// decoded body. `key:` names the method of `methods` that `#App.SigningKey`
// marks (E2814 otherwise), whose key each delivery is checked under
// (`sema_app_webhook_key`). The generated code is the mount call's, at
// `span`.
sema_app_mount_webhook: fn(mux: TExpr, value_name: String, service: String, methods: [Func], method: Func, method_module: ModuleID, marker: Marker, prefix: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> TExpr? {
    graph: program.registration_graph ?? return None
    if !sema_app_mount_concrete(method) {
        diagnostics.push(sema_error("E2805", marker.span, "webhook method `{method.name}` needs read-only self, read parameters and a concrete signature", "a mounted webhook decodes its arguments from the delivery and runs on request workers", "write `{method.name}: fn(self, ...)` with read parameters and without method type parameters"))
        return None
    }
    // The marker's own check reports a missing argument.
    path_at: sema_app_marker_arg_at(marker, "path", 0) ?? return None
    signature_at: sema_app_marker_arg_at(marker, "signature", 1) ?? return None
    key_at: sema_app_marker_arg_at(marker, "key", 2) ?? return None
    route: sema_app_marker_string(marker, path_at, environment, program, scopes) ?? {
        diagnostics.push(sema_error("E2805", sema_app_marker_span(marker, path_at), "a webhook's path must be a static String", "a webhook's route is fully checked while building, mount prefix included", "use a literal or compile-time String constant"))
        return None
    }
    address: "{prefix}{route}"
    if sema_http_route_pattern_error(address) == .Val(reason) {
        diagnostics.push(sema_http_route_invalid_diagnostic(address, reason, sema_app_marker_span(marker, path_at)))
        return None
    }
    fields: sema_http_route_path_fields(address) ?? return None
    // The indices of the method's path parameters, in its order, and their
    // names joined by commas.
    path_params := [Int]{}
    joined := ""
    loop index in 1..<method.params.len() {
        name: method.params[index].name
        in_path: loop field in fields {
            if field.name == name {
                break true
            }
        } ?? false
        if in_path {
            path_params.push(index)
            if joined != "" -> joined = "{joined},"
            joined = "{joined}{name}"
            next
        }
        if index != method.params.len() - 1 {
            diagnostics.push(sema_error("E2805", method.params[index].name_span, "webhook parameter `{name}` names no parameter of `{address}`", "a webhook's parameters take its path's parameters by name, and only its last takes the delivery's body", "rename `{name}` for a parameter of the path, or make it the last parameter"))
            return None
        }
    }
    key_name: sema_app_marker_string(marker, key_at, environment, program, scopes) ?? "…"
    key_method_at: sema_app_signing_key_at(methods, key_name, graph, method_module) ?? {
        entry: diagnostic_registry_row("E2814") ?? panic("E2814 must have a registry row")
        diagnostics.push(sema_error("E2814", sema_app_marker_span(marker, key_at), entry.what.replace("{{key}}", key_name).replace("{{service}}", service), entry.why, entry.fix.replace("{{key}}", key_name)))
        return None
    }
    key: sema_app_webhook_key(mux, value_name, methods[key_method_at], method, method_module, path_params, address, span, environment, program, scopes, check, diagnostics) ?? return None
    signature: sema_app_marker_checked(marker, signature_at, sema_app_mux_param_type(mux, "__webhook", 1, span, environment, program, diagnostics), environment, program, scopes, check, diagnostics) ?? return None
    path: sema_call_http_static_tree_arg(sema_call_http_core_string(address, span), sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: address}}, span: span, id: AST_NODE_GENERATED}, span))
    params: sema_call_http_static_tree_arg(sema_call_http_core_string(joined, span), sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: joined}}, span: span, id: AST_NODE_GENERATED}, span))
    answer: sema_app_mount_answer(value_name, method, method_module, sema_app_mux_param_type(mux, "__webhook", 4, span, environment, program, diagnostics), span, environment, program, scopes, check, diagnostics) ?? return None
    sema_call_http_mux_source_call(mux, "__webhook", [TCallArg]{path, signature, params, key, answer}, span, None, environment, program, scopes, check, diagnostics).value
}

// The schedule method `method` of the mounted value `value_name`, of the
// service `service`, runs at each minute the cron line of its `#App.Every`
// `marker` allows, from when the App `mux` serves, through its `__every`.
// As a job's call does, the run calls the method and replies `{"err":...}`
// when it failed (`sema_app_job_statements`). The method takes only
// read-only `self`, and the line is a static String in the grammar the app
// module's scheduler reads (E2805 otherwise). The generated code is the
// mount call's, at `span`.
sema_app_mount_schedule: fn(mux: TExpr, value_name: String, service: String, method: Func, method_module: ModuleID, marker: Marker, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> TExpr? {
    graph: program.registration_graph ?? return None
    if !sema_app_mount_concrete(method) || method.params.len() != 1 {
        diagnostics.push(sema_error("E2805", marker.span, "schedule method `{method.name}` needs read-only self, no other parameters and a concrete signature", "the scheduler calls a schedule's method at each due minute, with nothing to pass it", "write `{method.name}: fn(self)` without method type parameters"))
        return None
    }
    // The marker's own check reports a missing argument.
    cron_at: sema_app_marker_arg_at(marker, "cron", 0) ?? return None
    cron: sema_app_marker_string(marker, cron_at, environment, program, scopes) ?? {
        diagnostics.push(sema_error("E2805", sema_app_marker_span(marker, cron_at), "a schedule's cron line must be a static String", "a schedule's cron line is checked while building", "use a literal or compile-time String constant"))
        return None
    }
    if sema_app_cron_error(cron) == .Val(reason) {
        diagnostics.push(sema_error("E2805", sema_app_marker_span(marker, cron_at), "`{cron}` is not a cron line: {reason}", "a schedule runs at each minute its cron line allows, in UTC, and the line is checked while building", "write five fields, the minute (0-59), hour (0-23), day of the month (1-31), month (1-12) and day of the week (0-7), each `*`, a number, a range `a-b` or a list of those, each optionally stepped, as in `0 8 * * 1-5`"))
        return None
    }
    name: "{module_text(graph.module_table, method_module)}.{service}.{method.name}"
    name_arg: sema_call_http_static_tree_arg(sema_call_http_core_string(name, span), sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: name}}, span: span, id: AST_NODE_GENERATED}, span))
    cron_arg: sema_call_http_static_tree_arg(sema_call_http_core_string(cron, span), sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: cron}}, span: span, id: AST_NODE_GENERATED}, span))
    args_name: "__jet_http_schedule_args_{span.start}"
    statements: sema_app_job_statements(args_name, value_name, method, method_module, span, graph, environment)
    run: sema_app_mount_callback(args_name, statements, sema_app_mux_param_type(mux, "__every", 2, span, environment, program, diagnostics), span, environment, program, scopes, check, diagnostics) ?? return None
    sema_call_http_mux_source_call(mux, "__every", [TCallArg]{name_arg, cron_arg, run}, span, None, environment, program, scopes, check, diagnostics).value
}

// The job method `method` of the mounted value `value_name`, of the service
// `service`, declared to the App `mux` through its `__job`, so a serving
// server runs the job's rows a store keeps, by the job's name, the one an
// `enqueue` of it keeps (`sema_app_job_endpoint`), with the retries of its
// `#App.Job` `marker`. As a queued job's function does, the run decodes the
// arguments, calls the method and replies `{"err":...}` when it failed
// (`sema_app_job_statements`). The method takes read-only `self` and
// parameters that are Encode and Decode, and has a concrete signature
// (E2805 otherwise). The generated code is the mount call's, at `span`.
sema_app_mount_job: fn(mux: TExpr, value_name: String, service: String, method: Func, method_module: ModuleID, marker: Marker, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> TExpr? {
    graph: program.registration_graph ?? return None
    if !sema_app_mount_concrete(method) {
        diagnostics.push(sema_error("E2805", marker.span, "job method `{method.name}` needs read-only self and a concrete signature", "a serving server runs a job's kept rows on a copy of the mounted service", "write `{method.name}: fn(self, ...)` without method type parameters"))
        return None
    }
    loop index in 1..<method.params.len() {
        param: sema_type_resolve_declared(graph, method.params[index].ty, method_module)
        missing: loop codec in owned_trait_codec_names() {
            if sema_type_bound_satisfied(graph, param, codec, environment.module_identity) != (Val(true)) {
                break "{codec}"
            }
        } ?? ""
        if missing != "" {
            diagnostics.push(sema_error("E2805", marker.span, "parameter `{method.params[index].name}` of job method `{method.name}` has the type {sema_type_show_quoted(param)}, which isn't `{missing}`", "a job's arguments are kept encoded in a store's outbox and decoded when it runs", "derive `Encode` and `Decode` on the parameter's type, or pass a value of a type that has them"))
            return None
        }
    }
    name: "{module_text(graph.module_table, method_module)}.{service}.{method.name}"
    name_arg: sema_call_http_static_tree_arg(sema_call_http_core_string(name, span), sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: name}}, span: span, id: AST_NODE_GENERATED}, span))
    retries: sema_app_job_retries(marker)
    retries_checked: sema_check_expression(retries, Val(sema_app_mux_param_type(mux, "__job", 1, span, environment, program, diagnostics)), environment, program, scopes, check, diagnostics) ?? return None
    retries_arg: sema_call_http_static_tree_arg(retries_checked, sema_http_mount_arg(retries, expr_span(retries)))
    args_name: "__jet_http_job_args_{span.start}"
    statements: sema_app_job_statements(args_name, value_name, method, method_module, span, graph, environment)
    run: sema_app_mount_callback(args_name, statements, sema_app_mux_param_type(mux, "__job", 2, span, environment, program, diagnostics), span, environment, program, scopes, check, diagnostics) ?? return None
    sema_call_http_mux_source_call(mux, "__job", [TCallArg]{name_arg, retries_arg, run}, span, None, environment, program, scopes, check, diagnostics).value
}

// Why `text` is not a cron line, in the grammar the app module's scheduler
// reads (`Every`); None when it is one.
sema_app_cron_error: fn(text: String) -> String? {
    fields := [String]{}
    loop part in text.split(" ") {
        if part != "" -> fields.push(part)
    }
    if fields.len() != 5 -> return Val("it has {fields.len()} fields, not 5")
    loop (index, field) in fields {
        // The field's name, and the values it allows.
        allowed: if index == {
            0 -> {name: "minute", low: 0, high: 59}
            1 -> {name: "hour", low: 0, high: 23}
            2 -> {name: "day of the month", low: 1, high: 31}
            3 -> {name: "month", low: 1, high: 12}
            else -> {name: "day of the week", low: 0, high: 7}
        }
        if !sema_app_cron_field_valid(field, allowed.low, allowed.high) {
            return Val("its {allowed.name} field `{field}` is not `*`, a number from {allowed.low} to {allowed.high}, a range of those or a list of these, each optionally stepped")
        }
    }
    None
}

// Whether the cron field `text` allows values from `low` to `high` only:
// a list of `*`, numbers and ranges `a-b`, each optionally stepped (`/n`).
sema_app_cron_field_valid: fn(text: String, low: Int, high: Int) -> Bool {
    loop item in text.split(",") {
        stepped: item.split("/").to_list()
        if stepped.len() > 2 -> return false
        if stepped.len() == 2 {
            step: sema_app_cron_number(stepped[1]) ?? return false
            if step < 1 -> return false
        }
        if stepped[0] == "*" -> next
        bounds: stepped[0].split("-").to_list()
        if bounds.len() > 2 -> return false
        first: sema_app_cron_number(bounds[0]) ?? return false
        last := first
        if bounds.len() == 2 -> last = sema_app_cron_number(bounds[1]) ?? return false
        if first < low || last > high || first > last -> return false
    }
    true
}

// The number `text` writes, of one or two digits; None otherwise.
sema_app_cron_number: fn(text: String) -> Int? {
    if text.len() == 0 || text.len() > 2 -> return None
    loop byte in text.bytes() {
        n: Int{byte}
        if n < 48 || n > 57 -> return None
    }
    Val(Int.parse(text) ?? return None)
}

// The checked key callback of the webhook `method`, whose path parameters
// are `method`'s parameters at `path_params`: it decodes each parameter of
// the signing-key method `key_method` from those, by name, and gives
// `Ok(value.key_method(...))`.
sema_app_webhook_key: fn(mux: TExpr, value_name: String, key_method: Func, method: Func, method_module: ModuleID, path_params: [Int], address: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> TCallArg? {
    graph: program.registration_graph ?? return None
    if !sema_app_mount_concrete(key_method) {
        diagnostics.push(sema_error("E2805", key_method.name_span, "signing-key method `{key_method.name}` needs read-only self, read parameters and a concrete signature", "a webhook runs its signing-key method on each delivery's path parameters, on request workers", "write `{key_method.name}: fn(self, ...)` with read parameters and without method type parameters"))
        return None
    }
    args_name: "__jet_http_webhook_key_{span.start}"
    statements := [Stmt]{}
    reads := [CallArg]{}
    loop index in 1..<key_method.params.len() {
        name: key_method.params[index].name
        position := -1
        loop (at, param_index) in path_params {
            if method.params[param_index].name == name -> position = at
        }
        if position < 0 {
            diagnostics.push(sema_error("E2805", key_method.params[index].name_span, "signing-key parameter `{name}` names no path parameter of webhook `{method.name}`", "a signing-key method takes the webhook's path parameters by name, before the delivery's body is read", "take only parameters that `{method.name}` takes from `{address}`"))
            return None
        }
        local_name: "{args_name}_{index}"
        decoded: Expr.MethodCall{receiver: sema_app_remote_ident(args_name, span), method: "__take", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{sema_type_resolve_declared(graph, key_method.params[index].ty, method_module)}, args: [CallArg]{sema_http_mount_arg(Expr.Int{value: position, span: span, width: None, raw: None, id: AST_NODE_GENERATED}, span)}, id: AST_NODE_GENERATED}
        statements.push(Stmt.Val{binding: ast_binding(local_name, span, false, decoded, None)})
        reads.push(sema_http_mount_arg(sema_app_remote_ident(local_name, span), span))
    }
    call: Expr.MethodCall{receiver: sema_app_remote_ident(value_name, span), method: key_method.name, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: reads, id: AST_NODE_GENERATED}
    statements.push(Stmt.Expr{expr: Expr.Ok{value: call, span: span, id: AST_NODE_GENERATED}})
    sema_app_mount_callback(args_name, statements, sema_app_mux_param_type(mux, "__webhook", 3, span, environment, program, diagnostics), span, environment, program, scopes, check, diagnostics)
}

// The type of parameter `index` of the App's registration method `name`.
sema_app_mux_param_type: fn(mux: TExpr, name: String, index: Int, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: ^[Diagnostic]) -> Type {
    graph: program.registration_graph ?? panic("an App registration has no registration graph")
    candidates := sema_expr_registration_method_candidates(graph, environment.module_identity, mux.ty, name, [Type]{}, [Type]{}, span, environment, program, diagnostics)
    candidate: candidates.pop() ?? panic("App.{name} is not registered")
    params: sema_call_params_from_type_after(candidate.signature, candidate.receiver_offset) ?? panic("App.{name} has no parameter list")
    declared: params[index].ty ?? panic("App.{name}'s parameter {index} has no type")
    sema_call_resolved_type(declared, environment, program)
}

// The checked callback, of type `answer_type`, that runs the mounted value
// `value_name`'s method `method` on a call's arguments: it decodes each
// argument from the call's JSON array in turn, runs the method, and gives its
// encoded reply.
sema_app_mount_answer: fn(value_name: String, method: Func, method_module: ModuleID, answer_type: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> TCallArg? {
    graph: program.registration_graph ?? return None
    args_name: "__jet_http_mount_args_{span.start}"
    statements := [Stmt]{}
    reads := [CallArg]{}
    loop index in 1..<method.params.len() {
        local_name: "{args_name}_{index}"
        decoded: Expr.MethodCall{receiver: sema_app_remote_ident(args_name, span), method: "__take", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{sema_type_resolve_declared(graph, method.params[index].ty, method_module)}, args: [CallArg]{sema_http_mount_arg(Expr.Int{value: index - 1, span: span, width: None, raw: None, id: AST_NODE_GENERATED}, span)}, id: AST_NODE_GENERATED}
        statements.push(Stmt.Val{binding: ast_binding(local_name, span, false, decoded, None)})
        reads.push(sema_http_mount_arg(sema_app_remote_ident(local_name, span), span))
    }
    invocation: Expr.MethodCall{receiver: sema_app_remote_ident(value_name, span), method: method.name, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: reads, id: AST_NODE_GENERATED}
    sema_app_mount_reply(args_name, statements, invocation, sema_type_resolve_declared(graph, method.return_type ?? Type.Named{name: "Unit"}, method_module), span)
    sema_app_mount_callback(args_name, statements, answer_type, span, environment, program, scopes, check, diagnostics)
}

// Pushes onto `statements` the reply of `invocation`, a call, on the mounted
// call's arguments `args_name`, of a method whose return is
// `declared_return`. A method that can fail replies with its error: `value:
// method(...) ?? return Ok(args.__reply_err<E>(err))`; then
// `Ok(args.__reply_value<R>(value))`, or `Ok(args.__reply_unit<Unit>(value))`
// when it answers nothing, since `Unit` has no codec to meet
// `__reply_value`'s `Encode` bound. A method that can't fail (`T Never!`)
// has no error to encode, so its fallback, which never runs, is `__failed`.
sema_app_mount_reply: fn(args_name: String, statements: ^[Stmt], invocation: ^^Expr, declared_return: ^^Type, span: Span) {
    replied: "{args_name}_value"
    reply_type: if {
        declared_return == .Result(ok, err) -> {
            reply: if err == (Type.Named{name: "Never"}) -> "__failed" else -> "__reply_err"
            failed: Expr.MethodCall{receiver: sema_app_remote_ident(args_name, span), method: reply, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{err}, args: [CallArg]{sema_http_mount_arg(sema_app_remote_ident("err", span), span)}, id: AST_NODE_GENERATED}
            settled: Expr.OrFallback{value: invocation, fallback: OrFallback.Return{value: Val(Expr.Ok{value: failed, span: span, id: AST_NODE_GENERATED}), span: span}, is_option: false, span: span, id: AST_NODE_GENERATED}
            statements.push(Stmt.Val{binding: ast_binding(replied, span, false, settled, None)})
            ok
        }
        else -> {
            statements.push(Stmt.Val{binding: ast_binding(replied, span, false, invocation, None)})
            declared_return
        }
    }
    answer: if reply_type == (Type.Named{name: "Unit"}) -> "__reply_unit" else -> "__reply_value"
    statements.push(Stmt.Expr{expr: Expr.Ok{value: Expr.MethodCall{receiver: sema_app_remote_ident(args_name, span), method: answer, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{reply_type}, args: [CallArg]{sema_http_mount_arg(sema_app_remote_ident(replied, span), span)}, id: AST_NODE_GENERATED}, span: span, id: AST_NODE_GENERATED}})
}

// The checked check callback of the upload endpoint `method`, whose
// parameter `upload_at` takes its `Upload`: it decodes each parameter of the
// check method `check_method` from the call's arguments, which hold each of
// `method`'s but the `Upload`, by name, runs the check and replies as a
// mounted call does (`sema_app_mount_reply`), so a check that fails refuses
// the upload.
sema_app_upload_check: fn(mux: TExpr, value_name: String, check_method: Func, method: Func, method_module: ModuleID, upload_at: Int, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> TCallArg? {
    graph: program.registration_graph ?? return None
    if !sema_app_mount_concrete(check_method) {
        diagnostics.push(sema_error("E2805", check_method.name_span, "upload check `{check_method.name}` needs read-only self, read parameters and a concrete signature", "the server runs an upload endpoint's check on the call's other arguments, on request workers, before it reads the file", "write `{check_method.name}: fn(self, ...)` with read parameters and without method type parameters"))
        return None
    }
    args_name: "__jet_http_upload_check_{span.start}"
    statements := [Stmt]{}
    reads := [CallArg]{}
    loop index in 1..<check_method.params.len() {
        name: check_method.params[index].name
        // The call's arguments skip the Upload.
        position := -1
        loop param_index in 1..<method.params.len() {
            if param_index == upload_at || method.params[param_index].name != name -> next
            position = param_index - 1
            if param_index > upload_at -> position = param_index - 2
        }
        if position < 0 {
            diagnostics.push(sema_error("E2805", check_method.params[index].name_span, "upload check parameter `{name}` names no parameter of `{method.name}` but its `app.Upload`", "an upload endpoint's check takes the call's other arguments by name, before the file is read", "take only parameters that `{method.name}` takes, other than its `app.Upload`"))
            return None
        }
        local_name: "{args_name}_{index}"
        decoded: Expr.MethodCall{receiver: sema_app_remote_ident(args_name, span), method: "__take", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{sema_type_resolve_declared(graph, check_method.params[index].ty, method_module)}, args: [CallArg]{sema_http_mount_arg(Expr.Int{value: position, span: span, width: None, raw: None, id: AST_NODE_GENERATED}, span)}, id: AST_NODE_GENERATED}
        statements.push(Stmt.Val{binding: ast_binding(local_name, span, false, decoded, None)})
        reads.push(sema_http_mount_arg(sema_app_remote_ident(local_name, span), span))
    }
    invocation: Expr.MethodCall{receiver: sema_app_remote_ident(value_name, span), method: check_method.name, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: reads, id: AST_NODE_GENERATED}
    sema_app_mount_reply(args_name, statements, invocation, sema_type_resolve_declared(graph, check_method.return_type ?? Type.Named{name: "Unit"}, method_module), span)
    sema_app_mount_callback(args_name, statements, sema_app_mux_param_type(mux, "__remote_upload", 4, span, environment, program, diagnostics), span, environment, program, scopes, check, diagnostics)
}

// The lambda of one parameter `args_name` running `statements`, checked as
// the escaping callback type `callback_type` an App registration takes. As
// a route handler is, it is checked with no effect bound: a mounted method
// may use whatever its package's authority allows, a store above all, and
// the framework runs it on a request worker as one transaction.
sema_app_mount_callback: fn(args_name: String, statements: [Stmt], callback_type: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> TCallArg? {
    handler: Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: [LambdaParam]{LambdaParam{name: args_name, name_span: span, ty: None, ty_span: None, convention: AccessConvention.Read}}, effects: None, body: LambdaBody.Block{body: statements}, span: span, meta: ast_empty_lambda_meta()}, id: AST_NODE_GENERATED}
    callback_arg := sema_http_mount_arg(handler, span)
    unbounded: if {
        callback_type == .Fn(params, ret, _, contract, metadata, provenance) -> Type.Fn{params: params, ret: ret, effect_bound: None, param_contract: contract, call_metadata: metadata, return_view_provenance: provenance}
        else -> callback_type
    }
    callback: sema_check_expression_with_lambda_escapes(callback_arg.expr, Val(unbounded), environment, program, scopes, check, Val(true), diagnostics) ?? return None
    if !sema_call_http_check_middleware_callback(callback, environment, program, scopes, check.state, check.context, diagnostics) {
        return None
    }
    callback_arg.convention = AccessConvention.Move
    Val(sema_call_http_static_tree_arg(callback, callback_arg))
}

// The window an endpoint marker's `per:` defaults to: one minute.
SEMA_APP_LIMIT_WINDOW_NS: 60000000000

// An endpoint marker's rate limit as the two arguments `__remote_public`
// and `__remote_signed_in` take: its `limit:` (0, no limit, when unwritten)
// and its `per:` window in nanoseconds (`per.ns`), each checked as an Int.
sema_app_endpoint_limit: fn(marker: Marker, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, check: ^SemaBodyCheck, diagnostics: ^[Diagnostic]) -> [TCallArg]? {
    span: marker.span
    calls := Expr.Int{value: 0, span: span, width: None, raw: None, id: AST_NODE_GENERATED}
    window := Expr.Int{value: SEMA_APP_LIMIT_WINDOW_NS, span: span, width: None, raw: None, id: AST_NODE_GENERATED}
    loop (index, argument) in marker.args {
        written: if argument == .Expr(value) -> value.copy() else -> next
        // The first argument is `limit:` and the rest `per:` unless labeled.
        per := index != 0
        if index < marker.arg_labels.len() {
            if marker.arg_labels[index] == .Val(named) {
                if named.name != "limit" && named.name != "per" -> next
                per = named.name == "per"
            }
        }
        if per {
            window = Expr.Field{base: written, member: "ns", span: expr_span(written), id: AST_NODE_GENERATED}
        } else { calls = written }
    }
    args := [TCallArg]{}
    written: [Expr]{calls, window}
    loop expression in written {
        value: sema_check_expression(expression, Val(Type.Int), environment, program, scopes, check, diagnostics) ?? return None
        args.push(sema_call_http_static_tree_arg(value, sema_http_mount_arg(expression, expr_span(expression))))
    }
    Val(args)
}

// A mount prefix as it leads each mounted path: no trailing slash, so `/api`
// and `/api/` both mount `#Get("/orders")` at `/api/orders`.
sema_http_mount_prefix: fn(text: String) -> String Never! {
    end := text.len()
    loop end > 0 && text.slice(end - 1, end) == "/" -> end -= 1
    text.slice(0, end)
}

sema_http_collect_mounted: fn(tree: BodyTree, expression: Int, graph: SemaRegistrationGraph, module_identity: ModuleID, mounted: ^[SymbolID]) Never! {
    node: body_node(tree, expression)
    if node.kind == .InlineBlock(body) {
        loop statement in body {
            if tree.stmts[statement] == .Let(local, _, init, _, _, _) {
                if !local.name.starts_with("__jet_http_mount_value_") -> next
                row: sema_type_resolve_nominal_row(graph, body_type(graph.interner, tree, init), module_identity) ?? next
                id: graph.modules[row.module_index].nominals[row.row].symbol.id
                if !mounted.contains(id) -> mounted.push(id.copy())
            }
        }
    }
    body_each_expr_child(tree, node, fn(child: Int) { sema_http_collect_mounted(tree, child, graph, module_identity, mounted) })
}

// One function body's mounts. Its own function so the visitor closure lends
// the `mounted` write parameter and `graph` is lent to the closure instead of
// copying the whole registration graph per function.
sema_http_collect_mounted_body: fn(function: FnBody, graph: SemaRegistrationGraph, identity: ModuleID, mounted: ^[SymbolID]) Never! {
    loop statement in function.body {
        body_each_stmt_child(function.tree, function.tree.stmts[statement], fn(expression: Int) { sema_http_collect_mounted(function.tree, expression, graph, identity, mounted) })
    }
}

// Whether any nominal declares a method with a core.http.server route marker.
sema_http_has_route_method: fn(graph: SemaRegistrationGraph) -> Bool {
    loop module_row_index in 0..<graph.modules.len() {
        loop nominal_index in 0..<graph.modules[module_row_index].nominals.len() {
            loop method_index in 0..<graph.modules[module_row_index].nominals[nominal_index].methods.len() {
                loop marker_index in 0..<graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers.len() {
                    if sema_http_route_marker_verb(graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers[marker_index], graph, graph.modules[module_row_index].module_identity) != None {
                        return true
                    }
                }
            }
        }
    }
    false
}

sema_http_unmounted_warnings: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult]) -> [Diagnostic] {
    // Only a route method can be unmounted: a program without one skips the
    // walk of every checked function body for mounts.
    if !sema_http_has_route_method(graph) -> return [Diagnostic]{}
    mounted := [SymbolID]{}
    loop module_row in modules {
        identity: module_row.module_identity
        loop function in module_row.functions {
            sema_http_collect_mounted_body(function, graph, identity, mounted)
        }
    }
    diagnostics := [Diagnostic]{}
    loop module_row_index in 0..<graph.modules.len() {
        diagnostic_start: diagnostics.len()
        loop nominal_index in 0..<graph.modules[module_row_index].nominals.len() {
            if mounted.contains(graph.modules[module_row_index].nominals[nominal_index].symbol.id) {
                next
            }
            loop method_index in 0..<graph.modules[module_row_index].nominals[nominal_index].methods.len() {
                loop marker_index in 0..<graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers.len() {
                    if sema_http_route_marker_verb(graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers[marker_index], graph, graph.modules[module_row_index].module_identity) == None {
                        next
                    }
                    diagnostics.push(
                        sema_lint(
                            "E2818",
                            graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers[marker_index].span,
                            "HTTP route method `{graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.name}` belongs to a struct that is never mounted.",
                            "Route markers record facts; only an explicit app.mount(value) exposes that struct's routes.",
                            "Pass a value of `{graph.modules[module_row_index].nominals[nominal_index].symbol.name}` to app.mount, or remove the route marker.",
                        ),
                    )
                }
            }
        }
        sema_attach_diagnostic_source_locations(diagnostics, diagnostic_start, graph.modules[module_row_index].source_segments)
    }
    diagnostics
}
