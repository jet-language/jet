// HTTP-specific method and nominal constructor checking. Canonical module-level
// core.http calls stay in Calls/Core.jet; this file owns only checked HTTP
// receiver/static routes that lower to dedicated checked-tree operations.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    CallContractRow,
    CoreCallRecord,
    CoreTypedCallSignature,
    Diagnostic,
    EffectRowEntry,
    EnumLitArg,
    Expr,
    ExprField,
    Field,
    FunctionDefaultRef,
    NodeKind,
    ParamZone,
    Span,
    StrPart,
    SymbolID,
    SymbolKind,
    TFailureCarrier,
    TMethodRef,
    TPreludeArg,
    TStaticOwner,
    Type,
    ast_empty_call_arg_flags,
    core_call_typed_signature,
    core_unbuilt_call,
    symbol_id,
    type_identity_equal,
    type_name,
]

SemaHTTPStaticTarget: struct {
    namespace: String
    type_name: String
}

// The bare leaf of an HTTP nominal: a runtime handle is named bare, a
// source-owned Core type by its canonical `module::Leaf` spelling.
sema_call_http_nominal_leaf: fn(ty: Type) -> String Never! {
    if ty == {
        .Named(_) -> { return sema_type_nominal_leaf(ty) }
        .Tagged(_, inner) -> { return sema_call_http_nominal_leaf(inner) }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Quantity(_, _) | .Measure(_) -> { return "" }
    }
}

sema_call_http_static_target: fn(receiver: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaHTTPStaticTarget? {
    if receiver == {
        .Paren(inner, _, _) -> { return sema_call_http_static_target(inner, environment, program) }
        .Field(base, leaf, _, _) -> {
            if base == {
                .Ident(alias, _, _) -> {
                    namespace: sema_call_core_import_module(environment, program, alias) ?? return None
                    if namespace != "core.http" && namespace != "core.http.client" && namespace != "core.http.server" {
                        return None
                    }
                    type_name := if {
                        namespace == "core.http.client" && leaf == "Client" -> "HTTPClientType"
                        namespace == "core.http.client" && leaf == "Proxy" -> "HTTPProxy"
                        namespace == "core.http.client" && leaf == "RedirectPolicy" -> "HTTPRedirectPolicy"
                        namespace == "core.http" && (leaf == "Body" || leaf == "Headers") -> leaf
                        namespace == "core.http" && leaf == "Request" -> "HTTPRequest"
                        namespace == "core.http" && leaf == "Response" -> "HTTPResponse"
                        namespace == "core.http" && (leaf == "Error" || leaf == "HTTPError") -> "HTTPError"
                        namespace == "core.http" && leaf == "Proxy" -> "HTTPProxy"
                        namespace == "core.http" && leaf == "RedirectPolicy" -> "HTTPRedirectPolicy"
                        namespace == "core.http" && leaf == "RetryPolicy" -> "HTTPRetryPolicy"
                        namespace == "core.http" && leaf == "CookieJar" -> "HTTPCookieJar"
                        namespace == "core.http" && leaf == "Router" -> "HTTPRouter"
                        else -> ""
                    }
                    if type_name == "" {
                        return None
                    }
                    return Val(SemaHTTPStaticTarget{namespace: namespace, type_name: type_name})
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> { return None }
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> { return None }
    }
}

sema_call_http_unit_receiver: fn(span: Span, context: &SemaCheckContext) -> TExpr Never! {
    sema_node(context, Type.Named{name: "Unit"}, NodeKind.Unit, span)
}

sema_call_http_static_tree_arg: fn(value: TExpr, argument: CallArg) -> TCallArg Never! {
    TCallArg{
        value: value,
        template_items: [SymbolID]{},
        borrow: argument.convention == AccessConvention.Read && !sema_call_is_scalar(value.ty),
        mut_borrow: argument.convention == AccessConvention.Write,
        fn_coerce: None,
        widen_to_vec: false,
        widen_to_union: None,
        box_as_trait: None,
        label: argument.label.map((label) -> label.name),
        spread: argument.spread,
    }
}

// A checked HTTP static constructor runs the `core.http` source function
// `member`, typed by that function's own signature as core.http sees it.
sema_call_http_core_static: fn(member: String, args: [CallArg], values: [TExpr], type_args: [Type], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    identity: sema_call_core_module_identity(environment, program, "core.http") ?? return None
    target: sema_call_core_source_target(environment, program, identity, member, type_args, span, true, diagnostics) ?? return None
    callee: sema_call_callee_decl(program, target.symbol.id, span, diagnostics) ?? return None
    result: sema_call_signature_return(target.signature) ?? return None
    lowered := [TCallArg]{}
    loop index in 0..<values.len() -> lowered.push(sema_call_http_static_tree_arg(values[index], args[index]))
    Val(sema_tree_node(sema_call_resolved_type(result, environment, program), TExprKind.Call{callee: callee, type_args: target.type_args, args: lowered}, span))
}

// Source-owned HTTP text carriers cross into native leaves through their
// registered `to_string()` method; the leaf itself takes String.
sema_call_http_source_text: fn(value: &&TExpr, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    if program.registration_graph == .Val(graph) {
        candidates := sema_expr_registration_method_candidates(graph, environment.module_identity, value.ty, "to_string", [Type]{}, [Type]{}, span, environment, program, diagnostics)
        if candidates.len() != 1 -> return None
        candidate := candidates.pop() ?? return None
        return Val(sema_tree_node(Type.String, TExprKind.MethodCall{receiver: value.move(), method: candidate.method.move(), type_args: [Type]{}, args: [TCallArg]{}}, span))
    } else {
        return None
    }
}

// The `http.Headers` and `http.Body` constructors. `Method`, `Status`,
// `Version`, `HeaderName` and `HeaderValue` construct through their own Core
// static methods; the Body ones share names with Body's reading methods.
sema_call_http_static_known: fn(type_name: String, method: String) -> Bool Never! {
    if type_name == "HTTPClientType" && method == "new" -> return true
    if type_name == "Headers" && method == "new" -> return true
    if type_name == "Body" && (method == "empty" || method == "bytes" || method == "text" || method == "json" || method == "form" || method == "multipart" || method == "reader") -> return true
    false
}

sema_call_http_static_arity: fn(type_name: String, method: String, actual: Int) -> Bool Never! {
    if type_name == "HTTPClientType" && method == "new" -> return actual == 0
    if type_name == "Headers" && method == "new" -> return actual == 0
    if type_name == "Body" && (method == "empty") -> return actual == 0
    if type_name == "Body" && (method == "bytes" || method == "json" || method == "form" || method == "multipart") -> return actual == 1
    if type_name == "Body" && method == "text" -> return actual == 1 || actual == 2
    if type_name == "Body" && method == "reader" -> return actual == 1 || actual == 2
    false
}

sema_call_http_static_arg_types: fn(type_name: String, method: String, count: Int) -> [Type] Never! {
    if type_name == "Body" && method == "bytes" -> return [Type]{Type.List{element: Type.IntN{signed: false, bits: 8}}}
    if type_name == "Body" && method == "text" -> return if count == 2 -> [Type]{Type.String, Type.Named{name: "MIME"}} else -> [Type]{Type.String}
    if type_name == "Body" && (method == "form" || method == "multipart") -> return [Type]{Type.Map{key: Type.String, key_span: None, value: Type.String}}
    if type_name == "Body" && method == "reader" -> return if count == 2 -> [Type]{Type.Named{name: "FileReader"}, Type.Int} else -> [Type]{Type.Named{name: "FileReader"}}
    [Type]{}
}

sema_call_http_check_value: fn(argument: CallArg, required: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    checked: sema_check_expression(argument.expr, Val(required), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if type_identity_equal(checked.ty, required) -> return Val(checked)
    compatible: sema_call_type_assignable(required, checked.ty, environment, program) ?? return None
    if compatible -> return Val(checked)
    if sema_expr_numeric_value_widening(checked, required) == (.Val(true)) {
        line: sema_source_line_at(environment.source_segments, checked.span) ?? 0
        return sema_expr_numeric_literal_conversion(checked, required, checked.span, line, diagnostics)
    }
    diagnostics.push(sema_type_mismatch(required, checked.ty, argument.span))
    None
}

sema_call_http_ownership_params: fn(args: [CallArg], types: [Type], moving: [Int]) -> [SemaCallParam] Never! {
    params := [SemaCallParam]{}
    loop index in 0..<types.len() {
        convention := AccessConvention.Read
        loop move_index in moving { if move_index == index -> convention = AccessConvention.Move }
        params.push(SemaCallParam{label: "arg{index}", name: "arg{index}", zone: ParamZone.Either, default: None, default_ref: None, convention: convention, ty: Val(types[index]), variadic: false})
    }
    params
}

sema_call_http_check_values: fn(args: [CallArg], types: [Type], moving: [Int], callee: String, receiver: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, span: Span, diagnostics: &[Diagnostic]) -> [TExpr]? {
    updated_args := args
    values := [TExpr]{}
    loop index in 0..<updated_args.len() {
        if index >= types.len() {
            _ := sema_check_expression(updated_args[index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
            next
        }
        loop move_index in moving { if move_index == index -> updated_args[index].convention = AccessConvention.Move }
        value: sema_call_http_check_value(updated_args[index], types[index], environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        values.push(value)
    }
    if values.len() != updated_args.len() -> return None
    params: sema_call_http_ownership_params(updated_args, types, moving)
    ownership := sema_ownership_check_method_call(state, callee, receiver, AccessConvention.Read, params, updated_args, scopes, span, diagnostics)
    if !ownership.accepted || !ownership.complete -> return None
    Val(values)
}

sema_call_http_static_ownership: fn(args: [CallArg], types: [Type], moving: [Int], callee: String, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> Bool {
    updated_args := args
    params: sema_call_http_ownership_params(updated_args, types, moving)
    ownership := sema_ownership_check_call_arguments(state, callee, params, updated_args, scopes, diagnostics)
    ownership.accepted && ownership.complete
}

sema_call_try_http_static: fn(
    receiver: Expr,
    method: String,
    owner_type_args: [Type],
    type_args: [Type],
    args: [CallArg],
    span: Span,
    expected: Type?,
    environment: SemaScopeEnvironment, program: SemaProgramTables,
    scopes: &SemaScopeTable,
    state: &SemaOwnershipState,
    tail_store: &SemaStatementTailStore,
    context: &SemaCheckContext,
    diagnostics: &[Diagnostic],
) -> SemaMethodSpecialCheck {
    target: sema_call_http_static_target(receiver, environment, program) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_call_http_static_known(target.type_name, method) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_call_http_static_arity(target.type_name, method, args.len()) {
        expected_arity := if {
            target.type_name == "Body" && method == "empty" -> 0
            target.type_name == "Body" -> 1
            else -> 0
        }
        diagnostics.push(sema_call_arity_diagnostic("{target.type_name}.{method}", expected_arity, args.len(), false, span))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if target.type_name == "HTTPClientType" {
        if sema_call_core_handle_unbuilt("HTTPClient", method, span, environment, program, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        value := sema_tree_node(Type.Named{name: "HTTPClient"}, TExprKind.HandleMethod{receiver: sema_call_http_unit_receiver(span, context), operation: THandleOp.HTTPClientNew, args: [TExpr]{}}, span)
        sema_call_http_record_effect("Net", "HTTPClient.new", value.ty, span, environment, program, scopes, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
    }

    arg_types: sema_call_http_static_arg_types(target.type_name, method, args.len())
    moving := if target.type_name == "Body" && method == "reader" -> [Int]{0} else -> [Int]{}
    call_args := args.copy()
    loop index in 0..<call_args.len() {
        loop move_index in moving { if move_index == index -> call_args[index].convention = AccessConvention.Move }
    }
    values := [TExpr]{}
    if {
        target.type_name == "Body" && method == "json" -> {
            value: sema_check_expression(args[0].expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
            if !sema_serde_type_is_admissible(environment, program, value.ty, SemaSerdeDirection.Encode) {
                sema_call_http_check_serde(SemaSerdeDirection.Encode, value.ty, args[0].span, environment, program, diagnostics)
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            params := sema_call_http_ownership_params(call_args, [Type]{value.ty}, moving)
            ownership := sema_ownership_check_call_arguments(state, "Body.json", params, call_args, scopes, diagnostics)
            if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
            values.push(value)
        }
        else -> {
            loop index in 0..<args.len() {
                if index >= arg_types.len() {
                    _ := sema_check_expression(args[index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
                    return SemaMethodSpecialCheck{handled: true, value: None}
                }
                value: sema_call_http_check_value(args[index], arg_types[index], environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
                values.push(value)
            }
            if !sema_call_http_static_ownership(call_args, arg_types, moving, "{target.type_name}.{method}", scopes, state, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    member := if {
        target.type_name == "Headers" -> "headers"
        method == "empty" -> "body_empty"
        method == "bytes" -> "body_bytes"
        method == "text" && values.len() == 1 -> "body_text"
        method == "text" -> "__body_typed_text"
        method == "form" -> "__body_form"
        method == "multipart" -> "__body_multipart"
        method == "reader" && values.len() == 1 -> "__body_reader"
        method == "reader" -> "__body_reader_sized"
        else -> "__body_json"
    }
    if method == "text" && values.len() == 2 {
        // The media type is the last value: take it out and push its text
        // back, instead of copying it out of its slot.
        source: values.pop() ?? return SemaMethodSpecialCheck{handled: true, value: None}
        values.push(sema_call_http_source_text(source, span, environment, program, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None})
    }
    member_type_args := if member == "__body_json" -> [Type]{values[0].ty} else -> [Type]{}
    built: sema_call_http_core_static(member, call_args, values, member_type_args, span, environment, program, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(built, expected, environment, program, diagnostics)}
}

sema_call_http_known_receiver_type: fn(name: String) -> Bool Never! {
    name == "HTTPClient" || name == "HTTPMux" || name == "HTTPRouter" || name == "Headers"
}

sema_call_http_method_result: fn(name: String, method: String, count: Int) -> Type? {
    error := Type.Named{name: "HTTPError"}
    if name == "HTTPClient" {
        if method == "send" && count == 1 -> return Val(Type.Result{ok: Type.Named{name: "HTTPResponse"}, err: error})
        if method == "cookies" || method == "redirects" || method == "protocols" || method == "timeouts" || method == "raw_encoding" || method == "proxy" || method == "tls" || method == "allow_http_downgrade" || method == "retries" -> return Val(Type.Named{name: "HTTPClient"})
    }
    if name == "HTTPRouter" && (method == "get" || method == "post" || method == "put" || method == "delete") -> return Val(Type.Named{name: "Unit"})
    if name == "Headers" {
        if method == "first" && count == 0 -> return Val(Type.Option{inner: Type.String})
        if method == "all" && count == 0 -> return Val(Type.List{element: Type.String})
        if (method == "append" || method == "set") && count == 2 -> return Val(Type.Result{ok: Type.Named{name: "Headers"}, err: error})
        if method == "remove" && count == 1 -> return Val(Type.Named{name: "Headers"})
    }
    None
}

sema_call_http_client_arg_types: fn(method: String) -> [Type] Never! {
    if method == "cookies" -> return [Type]{Type.Named{name: "HTTPCookieJar"}}
    if method == "redirects" -> return [Type]{Type.Named{name: "HTTPRedirectPolicy"}}
    if method == "protocols" -> return [Type]{Type.Bool, Type.Bool, Type.Bool}
    if method == "timeouts" -> return [Type]{Type.Int, Type.Int, Type.Int, Type.Int, Type.Int, Type.Int, Type.Int}
    if method == "proxy" -> return [Type]{Type.Named{name: "HTTPProxy"}}
    if method == "tls" -> return [Type]{Type.Named{name: "ClientConfig"}}
    if method == "allow_http_downgrade" -> return [Type]{Type.Bool}
    if method == "retries" -> return [Type]{Type.Named{name: "HTTPRetryPolicy"}}
    if method == "send" -> return [Type]{Type.Named{name: "HTTPRequest"}}
    [Type]{}
}

sema_call_http_method_arg_types: fn(name: String, method: String, count: Int) -> [Type] Never! {
    if name == "HTTPClient" -> return sema_call_http_client_arg_types(method)
    if name == "Headers" {
        if method == "append" || method == "set" -> return [Type]{Type.String, Type.String}
        if method == "remove" -> return [Type]{Type.String}
    }
    [Type]{}
}

sema_call_http_check_serde: fn(direction: SemaSerdeDirection, ty: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) {
    if sema_serde_type_is_admissible(environment, program, ty, direction) -> return
    encode := direction == SemaSerdeDirection.Encode
    shown := sema_type_show_quoted(ty)
    diagnostics.push(sema_error("E2411", span, "{shown} can't be {if encode -> "serialized" else -> "decoded"}", "only types that opt in (and their fields) have a wire form; {shown} does not", if encode -> "add `#[Codable]` or `#[Encode]` to {shown}, or remove it from the encoded value" else -> "add `#[Codable]` or `#[Decode]` to {shown}, or remove it from the encoded value"))
}

// Preserve the existing server JSON admission diagnostic while its ordinary
// source function owns arity, parameter types and execution. Use the already
// inferred body type rather than checking the argument expression twice.
sema_call_http_source_json_target: fn(target: SemaCallDirectTarget, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    if target.symbol.name != "json" -> return false
    identity: sema_call_core_module_identity(environment, program, "core.http.server") ?? return false
    if program.registration_graph == .Val(graph) {
        index: sema_registration_module_index(graph, identity) ?? return false
        loop row in 0..<graph.modules[index].functions.len() {
            if graph.modules[index].functions[row].symbol.id.key == target.symbol.id.key -> return true
        }
        return false
    } else {
        return false
    }
}

sema_call_http_emit_method: fn(receiver: TExpr, name: String, method: String, args: [TExpr], result_type: Type, span: Span) -> TExpr Never! {
    sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver, operation: THandleOp.HTTPClientMethod{kind: name, method: method}, args: args}, span)
}


sema_call_http_record_effect: fn(effect_name: String, api: String, result_type: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    row := [EffectRowEntry]{EffectRowEntry{name: effect_name, span: span}}
    _ := sema_effect_record_intrinsic_fact(environment, program, scopes, context, api, span, SemaCallFacts{
        return_type: result_type,
        failure_carrier: sema_call_failure_carrier(Val(result_type)),
        effect_bound: Val(row),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }, diagnostics)
}

sema_call_http_method_effect: fn(name: String, method: String, count: Int) -> String? {
    if name == "HTTPClient" -> return Val("Net")
    None
}

// Only a lambda's captures cross the handler boundary; a named function or
// callable value carries no captured state to prove.
sema_call_http_check_middleware_callback: fn(value: TExpr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    if value.kind == {
        .Lambda(lambda) -> {
            updated_lambda := lambda
            valid := true
            loop name in updated_lambda.capture_facts.mutable {
                diagnostics.push(sema_ownership_crossing_concurrent_write_diagnostic(name, "HTTP handler", updated_lambda.source_span))
                valid = false
            }
            loop capture in updated_lambda.captures {
                mutable := false
                loop name in updated_lambda.capture_facts.mutable { if name == capture.source -> mutable = true }
                if mutable -> next
                closure_taken: sema_ownership_crossing_capture_taken(updated_lambda, capture, environment, program, context.generic_params)
                problem: sema_ownership_crossing_problem_for_name(capture.source, capture.ty, SemaSendCrossing.HTTPHandler, closure_taken, environment, program, scopes, state, context) ?? next
                diagnostics.push(sema_ownership_crossing_diagnostic(capture.source, capture.ty, problem, SemaSendCrossing.HTTPHandler, updated_lambda.source_span))
                valid = false
            }
            updated_lambda.is_move = true
            return valid
        }
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {}
    }
    true
}

sema_call_http_middleware: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    if updated_args.len() != 1 {
        diagnostics.push(sema_call_arity_diagnostic("middleware", 1, updated_args.len(), false, span))
        loop argument in updated_args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    handler_ty: sema_call_resolved_type(Type.Named{name: "HTTPHandler"}, environment, program)
    callback_type := Type.Fn{params: [Type]{handler_ty}, ret: Val(handler_ty), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    callback: sema_check_expression_with_lambda_escapes(updated_args[0].expr, Val(callback_type), environment, program, scopes, state, tail_store, context, Val(true), diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    compatible: sema_call_type_assignable(callback_type, callback.ty, environment, program) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !compatible {
        diagnostics.push(sema_type_mismatch(callback_type, callback.ty, updated_args[0].span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_call_http_check_middleware_callback(callback, environment, program, scopes, state, context, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    updated_args[0].convention = AccessConvention.Move
    parameter := SemaCallParam{label: "middleware", name: "middleware", zone: ParamZone.Either, default: None, default_ref: None, convention: AccessConvention.Move, ty: Val(callback_type), variadic: false}
    ownership := sema_ownership_check_method_call(state, "middleware", receiver, AccessConvention.Read, [SemaCallParam]{parameter}, updated_args, scopes, span, diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    sema_call_http_mux_source_call(receiver_value, "__middleware", [TCallArg]{sema_call_http_static_tree_arg(callback, updated_args[0])}, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

// Mux registration lowers to the mux's own source methods; the checked
// arguments carry their conventions. A parameter the registration leaves out
// takes its declared default, which is `#caller` (the `at: SourceLocation` of
// `HTTPMux.__route`): the place of this call, as at any call.
sema_call_http_mux_source_call: fn(receiver_value: TExpr, method: String, args: &&[TCallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if program.registration_graph == .Val(graph) {
        candidates := sema_expr_registration_method_candidates(graph, environment.module_identity, receiver_value.ty, method, [Type]{}, [Type]{}, span, environment, program, diagnostics)
        candidate := candidates.pop() ?? panic("HTTPMux.{method} is not registered")
        params: sema_call_params_from_type_after(candidate.signature, candidate.receiver_offset) ?? panic("HTTPMux.{method} has no parameter list")
        filled := args.move()
        loop index in filled.len()..<params.len() {
            reference: params[index].default_ref ?? panic("HTTPMux.{method} parameter `{params[index].name}` has no default")
            declared: sema_registration_resolve_default(graph, reference) ?? panic("HTTPMux.{method} parameter `{params[index].name}` lost its default")
            if !sema_site_is_caller(declared) -> panic("HTTPMux.{method} parameter `{params[index].name}` has a default other than `#caller`")
            declared_ty: params[index].ty ?? panic("HTTPMux.{method} parameter `{params[index].name}` has no type")
            location: sema_check_expression(sema_site_location_expr("", environment, program, scopes, span), Val(sema_call_resolved_type(declared_ty, environment, program)), environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
            filled.push(sema_call_http_static_tree_arg(location, sema_call_http_core_synthetic_arg(declared, span)))
        }
        built := sema_tree_node(Type.Named{name: "Unit"}, TExprKind.MethodCall{receiver: receiver_value, method: candidate.method.move(), type_args: [Type]{}, args: filled.move()}, span)
        sema_call_http_record_effect("Net", "HTTPMux.{method}", built.ty, span, environment, program, scopes, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(built, expected, environment, program, diagnostics)}
    } else {
        panic("HTTPMux.{method} needs a registration graph")
    }
}
 
sema_call_try_http_method: fn(
    receiver: Expr,
    receiver_value: TExpr,
    method: String,
    owner_type_args: [Type],
    type_args: [Type],
    args: [CallArg],
    span: Span,
    expected: Type?,
    environment: SemaScopeEnvironment, program: SemaProgramTables,
    scopes: &SemaScopeTable,
    state: &SemaOwnershipState,
    tail_store: &SemaStatementTailStore,
    context: &SemaCheckContext,
    diagnostics: &[Diagnostic],
) -> SemaMethodSpecialCheck {
    name: sema_call_http_nominal_leaf(receiver_value.ty)
    if !sema_call_http_known_receiver_type(name) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if name == "HTTPRouter" || name == "HTTPMux" {
        route := sema_call_try_http_router(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        if route.handled -> return route
    }
    if name == "HTTPMux" && method == "middleware" -> return sema_call_http_middleware(receiver, receiver_value, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)

    result_type := sema_call_http_method_result(name, method, args.len())
    if result_type == None -> return SemaMethodSpecialCheck{handled: false, value: None}
    result: result_type ?? Type.Named{name: "Unit"}

    if name == "HTTPClient" {
        want := if {
            method == "cookies" || method == "redirects" || method == "send" || method == "proxy" || method == "tls" || method == "allow_http_downgrade" || method == "retries" -> 1
            method == "protocols" -> 3
            method == "timeouts" -> 7
            method == "raw_encoding" -> 0
            else -> args.len()
        }
        if args.len() != want {
            diagnostics.push(sema_call_arity_diagnostic("{method}", want, args.len(), false, span))
            loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    arg_types := sema_call_http_method_arg_types(name, method, args.len())
    if name == "HTTPClient" -> arg_types = sema_call_http_client_arg_types(method)
    moving := [Int]{}
    values := [TExpr]{}
    checked := true
    if {
        args.len() > 0 -> {
            checked_values := sema_call_http_check_values(args, arg_types, moving, "{name}.{method}", receiver, environment, program, scopes, state, tail_store, context, span, diagnostics)
            if checked_values == .Val(found) -> values = found else -> checked = false
        }
        else -> {
            call_args := args.copy()
            ownership := sema_ownership_check_method_call(state, "{name}.{method}", receiver, AccessConvention.Read, [SemaCallParam]{}, call_args, scopes, span, diagnostics)
            if !ownership.accepted || !ownership.complete -> checked = false
        }
    }
    // The header handle methods record no receiver convention, so a written
    // mark has nothing to be compared with.
    if name == "Headers" -> sema_receiver_mark_forget(state, receiver)
    if !checked -> return SemaMethodSpecialCheck{handled: true, value: None}
    if sema_call_core_handle_unbuilt(name, method, span, environment, program, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    built := sema_call_http_emit_method(receiver_value, name, method, values, result, span)
    if sema_call_http_method_effect(name, method, args.len()) == .Val(effect_name) -> sema_call_http_record_effect(effect_name, "{name}.{method}", built.ty, span, environment, program, scopes, context, diagnostics)
    // A call checker finishes through the call's success view, so a
    // `T E!` result in a `T` slot (`req.send()` as a `HTTPResponse
    // HTTPError!` tail) propagates instead of mismatching (E0401).
    SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(built, expected, environment, program, context, diagnostics)}
}
sema_call_http_core_signature_type: fn(signature: CoreTypedCallSignature) -> Type Never! {
    parameter_types := [Type]{}
    parameter_contract := [CallContractRow]{}
    loop parameter in signature.parameters {
        parameter_types.push(parameter.ty)
        parameter_contract.push(CallContractRow{label: parameter.label, zone: parameter.zone})
    }
    Type.Fn{params: parameter_types, ret: signature.return_type, effect_bound: None, param_contract: Val(parameter_contract), call_metadata: None, return_view_provenance: None}
}

sema_call_http_core_synthetic_arg: fn(expression: Expr, span: Span) -> CallArg Never! {
    CallArg{convention: AccessConvention.Read, expr: expression, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
}

sema_call_http_core_string: fn(value: String, span: Span) -> TExpr Never! {
    sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: value}}}, span)
}

sema_call_http_core_unwrap_result: fn(value: TExpr, payload: Type, message: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> TExpr Never! {
    text := sema_call_http_core_string(message, span)
    sema_tree_node(payload, TExprKind.OrFallback{value: value, fallback: TOrFallback.Panic{message: text, location: sema_expression_panic_location(environment, program, scopes, span)}, ambient_err: None}, span)
}

sema_call_http_form_text: fn(value: String, span: Span) -> Expr Never! {
    Expr.Str{parts: [StrPart]{StrPart.Lit{text: value}}, span: span, id: AST_NODE_GENERATED}
}

sema_call_http_form_enum: fn(type_name: String, variant: String, span: Span) -> Expr Never! {
    Expr.EnumLit{type_name: type_name, variant: variant, variant_span: Val(span), args: [EnumLitArg]{}, leading_dot: false, span: span, id: AST_NODE_GENERATED}
}

sema_call_http_core_form_descriptor: fn(field: Field, value_variant: String, control_variant: String) -> Expr Never! {
    field_span: field.name_span
    Expr.StructLit{
        type_name: "WebFormFieldSpec",
        type_args: [Type]{},
        import_ns: None,
        as_trait: None,
        fields: [ExprField]{
            {name: "name", name_span: field_span, value: sema_call_http_form_text(field.name, field_span)},
            {name: "value_type", name_span: field_span, value: sema_call_http_form_enum("WebFormValueType", value_variant, field_span)},
            {name: "required", name_span: field_span, value: Expr.Bool{value: true, span: field_span, id: AST_NODE_GENERATED}},
            {name: "default", name_span: field_span, value: Expr.Absent{span: field_span, id: AST_NODE_GENERATED}},
            {name: "label", name_span: field_span, value: sema_call_http_form_text(field.name, field_span)},
            {name: "control", name_span: field_span, value: sema_call_http_form_enum("WebFormControl", control_variant, field_span)},
            {name: "group", name_span: field_span, value: Expr.Absent{span: field_span, id: AST_NODE_GENERATED}},
            {name: "wire_name", name_span: field_span, value: sema_call_http_form_text(field.name, field_span)},
        },
        inferred: false,
        span: field_span,
        id: AST_NODE_GENERATED,
    }
}

// `web.form(Model, action: submit)` has no Core registry row: sema derives
// the field descriptors from the model struct and rewrites the call into the
// Core source functions `core.web.forms.input` and `core.web.forms.typed`.
// Like `args.decode` it resolves through the import before the registry route.
sema_call_try_web_form: fn(module_name: String, member: String, alias: String, alias_span: Span, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if module_name != "core.web" || member != "form" -> return SemaDirectSpecialCheck{handled: false, value: None}
    imported: sema_call_core_import_target(environment, program, alias) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    if !sema_call_core_record_import_reference(environment, program, scopes, imported, alias_span, context) -> return SemaDirectSpecialCheck{handled: false, value: None}
    sema_call_http_web_form(args, type_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_call_http_web_form: fn(args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck Never! {
    if !sema_call_core_check_type_args("core.web", "form", 0, false, type_args, span, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    if args.len() != 2 {
        diagnostics.push(sema_call_arity_diagnostic("form", 2, args.len(), false, span))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    action_index := 1
    if args[0].label == .Val(label) && label.name == "action" -> action_index = 0
    if args[1].label == .Val(label) && label.name == "action" -> action_index = 1
    model_index := if action_index == 0 -> 1 else -> 0
    model_name: if args[model_index].expr == {
        .Ident(name, _, _) -> name
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
        diagnostics.push(sema_error("E2474", args[model_index].span, "web.form needs a named model type", "the form field set is derived from one declared struct, so a runtime value cannot provide its schema", "pass the struct name as the first argument: `web.form(Checkout, action: submit)`"))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    }
    definition: sema_http_route_find_struct(environment, program, Type.Named{name: model_name}, environment.module_identity) ?? {
        diagnostics.push(sema_error("E2474", args[model_index].span, "web.form model `{model_name}` is not a declared struct", "the form field set must come from the model's declared fields", "declare `{model_name}: struct {{ ... }}` before constructing the form"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if program.registration_graph == .Val(graph) {
    model_row: sema_type_resolve_nominal_row(graph, Type.Named{name: model_name}, environment.module_identity) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    model_nominal: graph.modules[model_row.module_index].nominals[model_row.row]
    model_module_identity := model_nominal.symbol.module_name
    action_name: if args[action_index].expr == {
        .Ident(name, _, _) -> name
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
        diagnostics.push(sema_error("E2474", args[action_index].span, "web.form action must be a named function", "the action is registered through the existing typed server-function boundary", "pass a named action function: `web.form({model_name}, action: submit)`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    }
    action_binding: sema_scope_resolve_index(scopes, action_name) ?? {
        diagnostics.push(sema_error("E2474", args[action_index].span, "form action `{action_name}` does not accept `{model_name}`", "the form derives its fields from the model and the one server-function action must receive that exact input type", "change `{action_name}` to accept `{model_name}` as its only parameter"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    action_symbol := scopes.bindings[action_binding].symbol
    if action_symbol.kind != SymbolKind.Function {
        diagnostics.push(sema_error("E2474", args[action_index].span, "web.form action must be a named function", "the action is registered through the existing typed server-function boundary", "pass a named action function: `web.form({model_name}, action: submit)`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    action_function: sema_http_route_find_function(environment, program, scopes, action_name) ?? {
        diagnostics.push(sema_error("E2474", args[action_index].span, "form action `{action_name}` does not accept `{model_name}`", "the form derives its fields from the model and the one server-function action must receive that exact input type", "change `{action_name}` to accept `{model_name}` as its only parameter"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    action_accepts_model := false
    if action_function.declaration.params.len() == 1 {
        action_parameter_type := sema_type_resolve_declared(graph, action_function.declaration.params[0].ty, action_function.symbol.module_name)
        action_row: sema_type_resolve_nominal_row(graph, action_parameter_type, action_function.symbol.module_name)
        if action_row == .Val(action_type) -> action_accepts_model = model_nominal.symbol.id.key == graph.modules[action_type.module_index].nominals[action_type.row].symbol.id.key
    }
    if !action_accepts_model {
        diagnostics.push(sema_error("E2474", args[action_index].span, "form action `{action_name}` does not accept `{model_name}`", "the form derives its fields from the model and the one server-function action must receive that exact input type", "change `{action_name}` to accept `{model_name}` as its only parameter"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }

    descriptor_exprs := [Expr]{}
    descriptor_values := [TExpr]{}
    valid := true
    loop field in definition.fields {
        if field.computed != None -> next
        value_variant := ""
        control_variant := ""
        field_type := sema_type_resolve_declared(graph, field.ty, model_module_identity)
        if {
            field_type == Type.String -> {
                value_variant = "String"
                control_variant = "Text"
            }
            field_type == Type.Int -> {
                value_variant = "Int"
                control_variant = "Number"
            }
            field_type == Type.Bool -> {
                value_variant = "Bool"
                control_variant = "Checkbox"
            }
            field_type == Type.Float -> {
                value_variant = "Float"
                control_variant = "Number"
            }
            else -> {
                diagnostics.push(sema_error("E2474", field.name_span, "form field `{field.name}` on `{model_name}` has unsupported type `{type_name(field_type)}`", "web forms decode scalar controls into the declared model fields without a second coercion policy", "change `{field.name}` to `String`, `Int`, `Bool`, or `Float`"))
                valid = false
                next
            }
        }
        descriptor := sema_call_http_core_form_descriptor(field, value_variant, control_variant)
        descriptor_value: sema_check_expression(descriptor, Val(Type.Named{name: "WebFormFieldSpec"}), environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            valid = false
            next
        }
        descriptor_exprs.push(descriptor)
        descriptor_values.push(descriptor_value)
    }
    if !valid -> return SemaDirectSpecialCheck{handled: true, value: None}

    input_record: sema_call_core_record("core.web.forms", "input", 2, span, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    input_signature: core_call_typed_signature("core.web.forms", "input", 2) ?? {
        diagnostics.push(sema_error("E0904", span, "`core.web.forms.input` has no source typed call contract", "web.form lowering uses the registered input constructor signature", "use a Core call row with a typed source signature"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    input_signature_type := sema_call_http_core_signature_type(input_signature)
    input_args := [CallArg]{
        sema_call_http_core_synthetic_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: model_name}}, span: span, id: AST_NODE_GENERATED}, span),
        sema_call_http_core_synthetic_arg(Expr.ListLit{elements: descriptor_exprs, span: span, id: AST_NODE_GENERATED}, span),
    }
    _ := sema_call_core_bind_arguments(input_record, input_signature_type, input_args, span, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    input_result: input_signature.return_type ?? return SemaDirectSpecialCheck{handled: true, value: None}
    input_values := [TExpr]{sema_call_http_core_string(model_name, span), sema_tree_node(Type.List{element: Type.Named{name: "WebFormFieldSpec"}}, TExprKind.ListLit{values: descriptor_values}, span)}
    input_fallibility := sema_call_failure_carrier(Val(input_result))
    if !sema_call_core_record_effects(input_record, span, [Type]{}, input_result, input_fallibility, [FunctionDefaultRef]{}, scopes, context, environment, program, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    input_call: sema_call_core_tree(input_record, input_values, span, [Type]{}, [Bool]{false, false}, input_result, input_fallibility, None, environment, program, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    input := sema_call_http_core_unwrap_result(input_call, Type.Named{name: "WebFormInput"}, "web.form could not construct its derived input", span, environment, program, scopes)

    typed_record: sema_call_core_record("core.web.forms", "typed", 2, span, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    typed_signature: core_call_typed_signature("core.web.forms", "typed", 2) ?? {
        diagnostics.push(sema_error("E0904", span, "`core.web.forms.typed` has no source typed call contract", "web.form lowering uses the registered typed action constructor signature", "use a Core call row with a typed source signature"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    typed_signature_type := sema_call_http_core_signature_type(typed_signature)
    typed_args := [CallArg]{
        sema_call_http_core_synthetic_arg(Expr.Ident{name: "input", span: span, id: AST_NODE_GENERATED}, span),
        sema_call_http_core_synthetic_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: action_name}}, span: span, id: AST_NODE_GENERATED}, span),
    }
    _ := sema_call_core_bind_arguments(typed_record, typed_signature_type, typed_args, span, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    typed_result: typed_signature.return_type ?? return SemaDirectSpecialCheck{handled: true, value: None}
    typed_fallibility := sema_call_failure_carrier(Val(typed_result))
    if !sema_call_core_record_effects(typed_record, span, [Type]{}, typed_result, typed_fallibility, [FunctionDefaultRef]{}, scopes, context, environment, program, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    typed_call: sema_call_core_tree(typed_record, [TExpr]{input, sema_call_http_core_string(action_name, span)}, span, [Type]{}, [Bool]{false, false}, typed_result, typed_fallibility, None, environment, program, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    result := sema_call_http_core_unwrap_result(typed_call, Type.Named{name: "WebFormTyped"}, "web.form could not register its typed action", span, environment, program, scopes)
    return SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(result, expected, environment, program, diagnostics)}
    } else {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
}

sema_call_http_sync: fn(record: CoreCallRecord, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    updated_args := args
    if updated_args.len() != 2 -> return SemaDirectSpecialCheck{handled: false, value: None}
    if !sema_call_core_check_type_args(record.module_name, record.member, 0, false, type_args, span, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    contract := [CallContractRow]{CallContractRow{label: "", zone: ParamZone.PositionalOnly}, CallContractRow{label: "over", zone: ParamZone.LabelOnly}}
    signature := Type.Fn{params: [Type]{Type.String, Type.String}, ret: Val(Type.String), effect_bound: None, param_contract: Val(contract), call_metadata: None, return_view_provenance: None}
    _ := sema_call_core_bind_arguments(record, signature, updated_args, span, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    values := [TExpr]{}
    loop argument in updated_args {
        value: sema_call_http_check_value(argument, Type.String, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        values.push(value)
    }
    params := [SemaCallParam]{
        {label: "", name: "value", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.String), variadic: false},
        {label: "over", name: "over", zone: ParamZone.LabelOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.String), variadic: false},
    }
    ownership := sema_ownership_check_call_arguments(state, "{record.module_name}.sync", params, updated_args, scopes, diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_call_core_record_effects(record, span, [Type]{}, Type.String, TFailureCarrier.Infallible, [FunctionDefaultRef]{}, scopes, context, environment, program, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    value: sema_call_core_tree(record, values, span, [Type]{}, [Bool]{false, false}, Type.String, TFailureCarrier.Infallible, expected, environment, program, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    SemaDirectSpecialCheck{handled: true, value: Val(value)}
}

sema_call_http_transport: fn(record: CoreCallRecord, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if args.len() != record.signature.arity -> return SemaDirectSpecialCheck{handled: false, value: None}
    if !sema_call_core_check_type_args(record.module_name, record.member, 0, false, type_args, span, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    signature: core_call_typed_signature(record.module_name, record.member, args.len()) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    _ := sema_call_core_bind_arguments(record, sema_call_http_core_signature_type(signature), args, span, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    url_index: if record.member == "request" -> 1 else -> 0
    values := [TExpr]{}
    params := sema_call_core_parameter_records(signature, [Type]{}, span, false)
    updated_args := args
    loop (index, argument) in args {
        value := sema_check_expression(argument.expr, if index == url_index -> None else -> Val(Type.String), environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        if index == url_index && value.ty != Type.String {
            if !(sema_call_type_assignable(Type.Named{name: "URL"}, value.ty, environment, program) ?? false) {
                diagnostics.push(sema_type_mismatch(Type.String, value.ty, argument.span))
                return SemaDirectSpecialCheck{handled: true, value: None}
            }
            params[index].ty = Val(value.ty)
            value = sema_call_http_source_text(value, argument.span, environment, program, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        }
        values.push(value)
    }
    ownership: sema_ownership_check_call_arguments(state, "{record.module_name}.{record.member}", params, updated_args, scopes, diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaDirectSpecialCheck{handled: true, value: None}
    result_type: signature.return_type ?? return SemaDirectSpecialCheck{handled: true, value: None}
    fallibility: sema_expression_failure_carrier(result_type)
    if !sema_call_core_record_effects(record, span, [Type]{}, result_type, fallibility, [FunctionDefaultRef]{}, scopes, context, environment, program, diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    value: sema_call_core_tree(record, values, span, [Type]{}, loop _ in values -> false, result_type, fallibility, None, environment, program, diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    SemaDirectSpecialCheck{handled: true, value: sema_expression_call_expected(value, expected, environment, program, context, diagnostics)}
}

// `web.openapi(mux)`: an HTTPMux argument checks as the source
// `core.web.__openapi_mux(routes: HTTPMux)`, which renders the checked
// contracts the mux's routes were registered with. Every other argument
// stays on the source-owned `openapi(router: HTTPRouter)`. The argument's
// type is probed (nothing is kept), then the chosen target checks it once.
sema_call_http_web_openapi_mux: fn(target: SemaCallDirectTarget, qualified_name: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if target.symbol.name != "openapi" || args.len() != 1 -> return SemaMethodSpecialCheck{handled: false, value: None}
    identity: sema_call_core_module_identity(environment, program, "core.web") ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if identity != target.symbol.module_name -> return SemaMethodSpecialCheck{handled: false, value: None}
    probe_diagnostics := [Diagnostic]{}
    probed: sema_probe_expression(args[0].expr, None, environment, program, scopes, state, tail_store, context, probe_diagnostics) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if sema_call_http_nominal_leaf(probed.ty) != "HTTPMux" -> return SemaMethodSpecialCheck{handled: false, value: None}
    mux_target: sema_call_core_source_target(environment, program, identity, "__openapi_mux", [Type]{}, span, true, diagnostics) ?? panic("core.web.__openapi_mux is not registered")
    SemaMethodSpecialCheck{handled: true, value: sema_call_core_check_source_owned(mux_target, qualified_name, type_args, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)}
}

sema_call_try_http_core_call: fn(record: CoreCallRecord, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck Never! {
    if record.module_name == "core.http.client" && (record.member == "get" || record.member == "post" || record.member == "request") -> return sema_call_http_transport(record, args, type_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if (record.module_name == "app" || record.module_name == "core.web") && record.member == "sync" -> return sema_call_http_sync(record, args, type_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    SemaDirectSpecialCheck{handled: false, value: None}
}

sema_web_form_method_member: fn(method: String, arity: Int) -> String? Never! {
    if (method == "set" && arity == 2) -> return Val("typed_set")
    if (method == "set_async_validator" && arity == 4) -> return Val("typed_set_async_validator")
    if (method == "validate" && arity == 3) -> return Val("typed_validate_field")
    if arity == 1 {
        if method == {
            "set_action" -> return Val("typed_set_action")
            "blur" -> return Val("typed_blur")
            "focus" -> return Val("typed_focus")
            "post" -> return Val("typed_post")
            else -> {}
        }
    }
    if arity != 0 -> return None
    if method == {
        "validate" -> Val("typed_validate")
        "cancel" -> Val("typed_cancel")
        "submit" -> Val("typed_submit")
        "no_script" -> Val("typed_no_script")
        "state" -> Val("typed_state")
        "lifecycle" -> Val("typed_lifecycle")
        "errors" -> Val("typed_errors")
        "render" -> Val("typed_html")
        else -> None
    }
}

// Only the native typed-model identity is routed here. Canonical source
// forms records continue through ordinary source method/function checking.
// The chain `form.validate(.field, on:, with:)` returns renders its result.
sema_call_try_web_form_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    chain: receiver_value.ty == (Type.Named{name: "WebFormValidationChain"})
    if !chain && receiver_value.ty != (Type.Named{name: "WebFormTyped"}) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if chain && (method != "render" || args.len() != 0) -> return SemaMethodSpecialCheck{handled: false, value: None}
    member: if chain -> "typed_validation_render" else -> sema_web_form_method_member(method, args.len()) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    updated_args := args
    // `form.validate(.field, on: timing, with: check)` binds its
    // two labels; the leading-dot field selector lowers to the ABI field name.
    if member == "typed_validate_field" {
        if !sema_services_bind_labels("WebFormTyped.validate", updated_args, [String]{"", "on", "with"}, span, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        loop index in 0..<updated_args.len() {
            updated_args[index].label = None
        }
        if sema_web_form_field_selector(updated_args[0], diagnostics) == .Val(selector) -> updated_args[0] = selector
    }
    record: sema_call_core_record("core.web.forms", member, updated_args.len() + 1, span, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    signature: core_call_typed_signature("core.web.forms", member, updated_args.len() + 1) ?? {
        diagnostics.push(sema_error("E0904", span, "`core.web.forms.{member}` has no typed call contract", "the opaque form method uses its canonical native route", "provide the registered Core typed signature"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    all_params: sema_call_core_parameter_records(signature, [Type]{}, span, false)
    params := [SemaCallParam]{}
    loop (index, parameter) in all_params { if index > 0 -> params.push(parameter) }
    checked: sema_network_handle_checked_args(method, params, updated_args, Val(receiver), AccessConvention.Read, false, span, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    values := [TExpr]{receiver_value}
    implicit_clones := [Bool]{false}
    loop argument in checked {
        values.push(argument)
        implicit_clones.push(false)
    }
    result: signature.return_type ?? Type.Named{name: "Unit"}
    fallibility: sema_call_failure_carrier(Val(result))
    if !sema_call_core_record_effects(record, span, [Type]{}, result, fallibility, [FunctionDefaultRef]{}, scopes, context, environment, program, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    value: sema_call_core_tree(record, values, span, [Type]{}, implicit_clones, result, fallibility, expected, environment, program, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(value)}
}

// A leading-dot form field selector (`.carrier`) names one model field; the
// typed-form runtime checks the name against its derived schema, so the
// selector lowers to the ABI field-name String. A lower-case selector parses
// as a bare member chain, an upper-case one as a leading-dot enum literal.
// None for any other argument.
sema_web_form_field_selector: fn(argument: CallArg, diagnostics: &[Diagnostic]) -> CallArg? {
    if argument.expr == .Field(base, member, member_span, _) {
        if !sema_expr_is_bare_subject(base) -> return None
        return Val(sema_web_form_selector_name(member, member_span, argument))
    }
    if argument.expr == .EnumLit(type_name, variant, _, payload, leading_dot, literal_span, _) {
        if !leading_dot || type_name != "" -> return None
        if payload.len() > 0 {
            diagnostics.push(sema_error("E0112", literal_span, "form field selector `.{variant}` cannot carry payload arguments", "a leading-dot form selector names one field and does not construct an enum variant", "write `.{variant}` without parentheses"))
        }
        return Val(sema_web_form_selector_name(variant, literal_span, argument))
    }
    None
}

sema_web_form_selector_name: fn(field: String, selector_span: Span, argument: CallArg) -> CallArg {
    CallArg{convention: AccessConvention.Read, expr: Expr.Str{parts: [StrPart]{StrPart.Lit{text: field}}, span: selector_span, id: AST_NODE_GENERATED},
        span: argument.span, flags: ast_empty_call_arg_flags(), label: None, spread: false}
}
