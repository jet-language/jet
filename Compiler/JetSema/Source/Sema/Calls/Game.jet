// Reserved game static calls and scene-owned handle operations.
//
// These calls use their exact registered Core namespace / handle identities;
// ordinary Core module calls remain in Core.jet.
use jet_foundation.[
    AccessConvention,
    CallArg,
    DerivationRef,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FrameSchedule,
    FunctionDefaultRef,
    NodeKind,
    Span,
    SymbolKind,
    Type,
    diagnostic_registry_row,
    expr_span,
    type_name,
]

SemaGameCoreStaticTarget: struct {
    type_name: String
}

sema_game_static_target: fn(receiver: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> SemaGameCoreStaticTarget? {
    if receiver == {
        .Field(base, type_name, _, _) -> {
            alias: if base == {.Ident(name, _, _) -> name else -> { return None }}
            if sema_call_core_import_module(environment, program, alias) != (Val("core.game")) {
                return None
            }
            binding_index: sema_scope_resolve_index(scopes, alias) ?? return None
            binding := scopes.bindings[binding_index]
            if binding.symbol.kind != SymbolKind.Import {
                return None
            }
            return Val(SemaGameCoreStaticTarget{type_name: type_name})
        }
        else -> None
    }
}

sema_game_discard_arguments: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
}
sema_game_check_first_string_discard_rest: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    if args.len() > 0 -> _ := sema_check_expression(args[0].expr, Val(Type.String), environment, program, scopes, state, tail_store, context, diagnostics)
    if args.len() > 1 -> loop index in 1..<args.len() -> _ := sema_check_expression(args[index].expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_game_literal_string: fn(expression: Expr) -> String? {
    if expression == {
        .Str(parts, _, _) -> {
            if parts.len() != 1 -> return None
            if parts[0] == {
                .Lit(text) -> { return Val(text) }
                else -> { return None }
            }
        }
        else -> None
    }
}

sema_game_replay_path_problem: fn(path: String) -> String? {
    if path.ends_with(".jetreplay") -> return None
    if path.ends_with(".jetproof-replay") -> return Val("that suffix identifies a proof replay, not a game input replay")
    if path.ends_with(".jetmap") || path.ends_with(".jetnb") || path.ends_with(".jetproof") || path.ends_with(".jettrace") -> return Val("that suffix identifies a different compiler artifact, not a game input replay")
    Val("game input replay paths end in `.jetreplay`")
}

sema_game_static_call: fn(target: SemaGameCoreStaticTarget, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if target.type_name != "Scene" && target.type_name != "Replay" && target.type_name != "Backend" -> return SemaMethodSpecialCheck{handled: false, value: None}
    valid_method := (target.type_name == "Scene" && method == "new") || (target.type_name == "Replay" && method == "record") || (target.type_name == "Backend" && method == "headless")
    if !valid_method -> return SemaMethodSpecialCheck{handled: false, value: None}
    expected_arity := if target.type_name == "Backend" -> 0 else -> 1
    if args.len() != expected_arity {
        diagnostics.push(sema_call_arity_diagnostic("core.game.{target.type_name}.{method}", expected_arity, args.len(), false, span))
        if expected_arity == 1 -> sema_game_check_first_string_discard_rest(args, environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_game_discard_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }

    operation := if {
        target.type_name == "Scene" -> THandleOp.GameSceneNew
        target.type_name == "Replay" -> THandleOp.GameReplayRecord
        else -> THandleOp.GameBackendHeadless
    }
    result_type := if {
        target.type_name == "Scene" -> Type.Named{name: "GameScene"}
        target.type_name == "Replay" -> Type.Named{name: "GameReplay"}
        else -> Type.Named{name: "GameBackend"}
    }
    receiver_value := sema_node(context, Type.Named{name: "Unit"}, NodeKind.Unit, span)
    if expected_arity == 1 {
        value: sema_check_expression(args[0].expr, Val(Type.String), environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        if target.type_name == "Replay" {
            literal_path := sema_game_literal_string(args[0].expr)
            if literal_path == {
                .Val(path) -> {
                    problem: sema_game_replay_path_problem(path)
                    if problem != None {
                        detail: problem
                        diagnostics.push(sema_error("E0103", expr_span(args[0].expr), "`Replay.record` needs a `.jetreplay` game replay path", detail, "rename the path to end in `.jetreplay`"))
                    }
                }
                else -> {}
            }
        }
        receiver_value = value
    }
    built := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{}}, span)
    if !sema_game_record_effect("core.game.{target.type_name}.{method}", result_type, [EffectRowEntry]{}, span, environment, program, scopes, context, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(built, expected, environment, program, diagnostics)}
}

// Handles only the three reserved static Core paths before ordinary CoreCall
// and registered static method resolution.
sema_call_try_game_static: fn(receiver: Expr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    target: sema_game_static_target(receiver, environment, program, scopes) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    sema_game_static_call(target, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_game_check_typed_argument: fn(argument: CallArg, required: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    sema_check_expression(argument.expr, Val(required), environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_game_check_untyped_args: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    sema_game_discard_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
}

sema_game_report_arity: fn(method: String, expected: Int, actual: Int, span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_call_arity_diagnostic(method, expected, actual, false, span))
}

sema_game_record_effect: fn(api: String, result_type: Type, effect_row: [EffectRowEntry], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool Never! {
    facts := SemaCallFacts{
        return_type: result_type,
        failure_carrier: sema_expression_failure_carrier(result_type),
        effect_bound: Val(effect_row),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(environment, program, scopes, context, api, span, facts, diagnostics)
}

sema_game_string_value: fn(text: String, span: Span) -> TExpr Never! {
    sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: text}}}, span)
}

sema_game_check_scene_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck? {
    if method == "on_frame" {
        if args.len() != 1 {
            sema_game_report_arity("GameScene.on_frame", 1, args.len(), span, diagnostics)
            sema_game_check_untyped_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
            return Val(SemaMethodSpecialCheck{handled: true, value: None})
        }
        callback_type := Type.Fn{params: [Type]{Type.Named{name: "GameFrame"}}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
        // The callback's checked calls give its serial frame schedule; the
        // checked callback carries it into the scene's frame operation.
        callback_source := args[0].expr
        frame_refusal := String?{None}
        frame_span := span
        if args[0].expr == .Lambda(lambda, node) {
            facts: sema_frame_lambda_schedule(lambda, environment, program, scopes)
            if facts.schedule != None {
                scheduled := lambda
                scheduled.meta.frame_schedule = facts.schedule
                scheduled.meta.frame_schedule_explanation = facts.explanation
                scheduled.meta.frame_schedule_derivation = facts.derivation
                callback_source = Expr.Lambda{lambda: scheduled, id: node}
            }
            frame_refusal = facts.error
            frame_span = lambda.span
        }
        diagnostics_before: diagnostics.len()
        callback: sema_expression_lambda_host_callback_stored(callback_source, Val(callback_type), true, environment, program, scopes, state, tail_store, context, diagnostics) ?? return Val(SemaMethodSpecialCheck{handled: true, value: None})
        // A refusal is reported only for a callback that otherwise checks: an
        // unresolved or ill-typed call has its own error already.
        if frame_refusal == .Val(detail) && !sema_has_error_since(diagnostics, diagnostics_before) {
            row: diagnostic_registry_row("E2967") ?? panic("E2967 has no registry row")
            diagnostics.push(sema_error("E2967", frame_span, row.what.replace("{{detail}}", detail), row.why, row.fix))
            return Val(SemaMethodSpecialCheck{handled: true, value: None})
        }
        if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return Val(SemaMethodSpecialCheck{handled: true, value: None})
        schedule := FrameSchedule?{None}
        derivation := DerivationRef?{None}
        if callback.kind == {
            .Lambda(lambda) -> {
                schedule = lambda.frame_schedule
                derivation = lambda.frame_schedule_derivation
            }
            else -> {}
        }
        operation := THandleOp.GameSceneOnFrame{schedule: schedule, derivation: derivation}
        built := sema_tree_node(Type.Named{name: "Unit"}, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{callback}}, span)
        if !sema_game_record_effect("GameScene.on_frame", Type.Named{name: "Unit"}, [EffectRowEntry]{}, span, environment, program, scopes, context, diagnostics) -> return Val(SemaMethodSpecialCheck{handled: true, value: None})
        return Val(SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(built, expected, environment, program, diagnostics)})
    }
    if method != "component" && method != "query" -> return None
    argument: if {
        args.len() == 1 -> {
            value: sema_game_check_typed_argument(args[0], Type.String, environment, program, scopes, state, tail_store, context, diagnostics) ?? return Val(SemaMethodSpecialCheck{handled: true, value: None})
            value
        }
        args.len() == 0 && method == "component" && type_args.len() == 1 -> sema_game_string_value(type_name(type_args[0]), span)
        args.len() == 0 && method == "query" && type_args.len() > 0 -> {
            names := [String]{}
            loop ty in type_args -> names.push(type_name(ty))
            sema_game_string_value(names.join(","), span)
        }
        else -> {
            sema_game_report_arity("GameScene.{method}", 1, args.len(), span, diagnostics)
            sema_game_check_first_string_discard_rest(args, environment, program, scopes, state, tail_store, context, diagnostics)
            return Val(SemaMethodSpecialCheck{handled: true, value: None})
        }
    }
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return Val(SemaMethodSpecialCheck{handled: true, value: None})
    result_type := if method == "query" -> Type.List{element: Type.String} else -> Type.Named{name: "Unit"}
    operation := if method == "query" -> THandleOp.GameSceneQuery else -> THandleOp.GameSceneComponent
    built := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{argument}}, span)
    if !sema_game_record_effect("GameScene.{method}", result_type, [EffectRowEntry]{}, span, environment, program, scopes, context, diagnostics) -> return Val(SemaMethodSpecialCheck{handled: true, value: None})
    Val(SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(built, expected, environment, program, diagnostics)})
}

sema_game_check_assets_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck? {
    if method != "image" && method != "sound" -> return None
    if args.len() != 1 {
        sema_game_report_arity("GameAssets.{method}", 1, args.len(), span, diagnostics)
        sema_game_check_first_string_discard_rest(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return Val(SemaMethodSpecialCheck{handled: true, value: None})
    }
    asset_path: sema_game_check_typed_argument(args[0], Type.String, environment, program, scopes, state, tail_store, context, diagnostics) ?? return Val(SemaMethodSpecialCheck{handled: true, value: None})
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return Val(SemaMethodSpecialCheck{handled: true, value: None})
    asset_type := if method == "image" -> Type.Named{name: "GameImage"} else -> Type.Named{name: "GameSound"}
    result_type := Type.Result{ok: asset_type, err: Type.String}
    operation := if method == "image" -> THandleOp.GameAssetsImage else -> THandleOp.GameAssetsSound
    built := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{asset_path}}, span)
    if !sema_game_record_effect("GameAssets.{method}", result_type, [EffectRowEntry]{EffectRowEntry{name: "FS", span: span}}, span, environment, program, scopes, context, diagnostics) -> return Val(SemaMethodSpecialCheck{handled: true, value: None})
    Val(SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(built, expected, environment, program, diagnostics)})
}

sema_game_check_input_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck? {
    if receiver_value.ty == (Type.Named{name: "GameInputMap"}) && method != "bind" -> return None
    if receiver_value.ty == (Type.Named{name: "GameInputSnapshot"}) && method != "pressed" -> return None
    if receiver_value.ty != (Type.Named{name: "GameInputMap"}) && receiver_value.ty != (Type.Named{name: "GameInputSnapshot"}) -> return None
    wanted := if method == "bind" -> 2 else -> 1
    if args.len() != wanted {
        sema_game_report_arity("GameInput.{method}", wanted, args.len(), span, diagnostics)
        loop (index, argument) in args {
            checked: if index < wanted -> sema_check_expression(argument.expr, Val(Type.String), environment, program, scopes, state, tail_store, context, diagnostics) else -> sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
            _ := checked
        }
        return Val(SemaMethodSpecialCheck{handled: true, value: None})
    }
    values := [TExpr]{}
    valid := true
    loop argument in args {
        if sema_game_check_typed_argument(argument, Type.String, environment, program, scopes, state, tail_store, context, diagnostics) == {
            .Val(value) -> values.push(value)
            .None -> valid = false
        }
    }
    if !valid -> return Val(SemaMethodSpecialCheck{handled: true, value: None})
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return Val(SemaMethodSpecialCheck{handled: true, value: None})
    operation := if method == "bind" -> THandleOp.GameInputBind else -> THandleOp.GameInputPressed
    result_type := if method == "bind" -> Type.Named{name: "Unit"} else -> Type.Bool
    built := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: values}, span)
    if !sema_game_record_effect("GameInput.{method}", result_type, [EffectRowEntry]{}, span, environment, program, scopes, context, diagnostics) -> return Val(SemaMethodSpecialCheck{handled: true, value: None})
    Val(SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(built, expected, environment, program, diagnostics)})
}

sema_game_check_backend_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck? {
    if method != "should_continue" && method != "present" -> return None
    if args.len() != 0 {
        sema_game_report_arity("GameBackend.{method}", 0, args.len(), span, diagnostics)
        sema_game_check_untyped_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return Val(SemaMethodSpecialCheck{handled: true, value: None})
    }
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) -> return Val(SemaMethodSpecialCheck{handled: true, value: None})
    operation := if method == "present" -> THandleOp.GameBackendPresent else -> THandleOp.GameBackendShouldContinue
    result_type := if method == "present" -> Type.Named{name: "Unit"} else -> Type.Bool
    built := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{}}, span)
    if !sema_game_record_effect("GameBackend.{method}", result_type, [EffectRowEntry]{}, span, environment, program, scopes, context, diagnostics) -> return Val(SemaMethodSpecialCheck{handled: true, value: None})
    Val(SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(built, expected, environment, program, diagnostics)})
}

// Scene setup needs an editable scene binding (Rust `needs_edit`: the root
// local is mutable); the handle receiver itself is only read, so these calls
// take no `&` mark. on_frame carries only the callback's checked schedule and
// derivation, never a fabricated one.
sema_call_try_game_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck? {
    edit_api: if receiver_value.ty == {
        .Named(name) -> if {
            name == "GameScene" && (method == "on_frame" || method == "component") -> method
            name == "GameAssets" && (method == "image" || method == "sound") -> method
            name == "GameInputMap" && method == "bind" -> "input.bind"
            name == "GameBackend" && method == "present" -> method
            else -> ""
        }
        else -> ""
    }
    if edit_api != "" -> sema_game_needs_edit(receiver, edit_api, scopes, diagnostics)
    if receiver_value.ty == (Type.Named{name: "GameScene"}) -> return sema_game_check_scene_method(receiver, receiver_value, method, args, type_args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if receiver_value.ty == (Type.Named{name: "GameAssets"}) -> return sema_game_check_assets_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if receiver_value.ty == (Type.Named{name: "GameInputMap"}) || receiver_value.ty == (Type.Named{name: "GameInputSnapshot"}) -> return sema_game_check_input_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    if receiver_value.ty == (Type.Named{name: "GameBackend"}) -> return sema_game_check_backend_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    None
}

sema_game_needs_edit: fn(receiver: Expr, api: String, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) {
    root: sema_receiver_mark_place_root(receiver) ?? return
    index: sema_scope_resolve_index(scopes, root) ?? return
    if !scopes.bindings[index].mutable {
        diagnostics.push(sema_ownership_diag_unchangeable(scopes.bindings[index], root, expr_span(receiver), "`{api}` changes durable scene state, so `{root}` must be mutable (`:=`)"))
    }
}
