// A marker's `check` rule (MarkerDecl.check) heard at
// each call of what the marker marks: a function or method carrying it, or
// a method called on a type carrying it. The rule runs before the call's
// arguments bind. Its answer, a `CompilerRejection?`, is a body comptime
// value like any `#run` site's: the first check of a body stages the call
// (SemaComptimeBodySource.rule) as its row, and the driver runs every
// staged call of one rule in one batch (sema_call_rule_batches), so the
// calls travel as one batch's prepared columns. A check that finds the
// answer landed reads it: an `.Error` rejection is the call's one
// diagnostic and replaces its ordinary checks; no rejection leaves the
// call to them.
use {
    jet_foundation.[
        AST_NODE_GENERATED,
        BodyEnumPayload,
        Binding,
        CallArg,
        DIAGNOSTIC_ERROR,
        DIAGNOSTIC_LINT,
        Diagnostic,
        EnumDef,
        Expr,
        InternerDelta,
        Marker,
        ModuleID,
        NameTable,
        Span,
        StructDef,
        SymbolID,
        SymbolKind,
        TComptimeEnumArg,
        TComptimeField,
        TComptimeReport,
        TComptimeValue,
        TUnaryOp,
        Type,
        codable_tag_field,
        codable_untagged,
        core_decl_utf8,
        diagnostic_from_registry,
        diagnostic_registry_row,
        diagnostic_sentence_case_line,
        diagnostic_with_label,
        expr_source_span,
        expr_span,
        name_column_table,
        name_index,
        name_intern,
        symbol_key_leaf,
    ]
    jet_parser.[parse_generated_source]
}

// The columns a batch declares (SemaCallRuleColumns).
SEMA_CALL_RULE_RULES_LOCAL: "__jet_rules"

SEMA_CALL_RULE_WORDS_LOCAL: "__jet_call_words"

SEMA_CALL_RULE_TEXTS_LOCAL: "__jet_call_texts"

SEMA_CALL_RULE_TYPES_LOCAL: "__jet_call_types"

SEMA_CALL_RULE_VALUES_LOCAL: "__jet_call_values"

SEMA_CALL_RULE_FUNCTIONS_LOCAL: "__jet_call_functions"

SEMA_CALL_RULE_WRITTEN_LOCAL: "__jet_call_written"

// The compiler records a batch's check builds from its columns; only a
// batch's own check writes their literals (SemaCheckContext.compiler_records).
SEMA_CALL_RULE_RECORDS: [String]{"CompilerCall", "CompilerName", "CompilerArg", "SourceSpan"}

// One rule a call hears: the `check` of the marker `marker`, declared in
// `module_identity` at `span` (its `check` name), with the marker's value
// where it is written. `paired`: the marker declares a `row`, so the rule
// hears each call with the first earlier call of its table that has the
// same row (sema_call_rule_batch_expression).
SemaCallRule: struct {
    module_identity: ModuleID,
    marker: String,
    span: Span,
    value: TComptimeValue,
    paired: Bool{false},
}

// What hearing a call's rules decided. `rejected`: a landed `.Error`
// rejection, whose diagnostic is pushed, replaces the call's checks.
// `staged`: a rule has no answer yet; its site was staged from row `from` of
// the context's body sources, and the call's errors wait for the answer
// (sema_call_rules_hold).
SemaCallRuleHearing: struct {
    rejected: Bool{false},
    staged: Bool{false},
    from: Int{0},
}

// The rules the markers written in module `written_in` bring: each marker a
// declared marker with a `check` resolves to. A builtin rule is bound to no
// declaring module (sema_marker_module_bind_marker) and brings none.
sema_call_rules: fn(graph: SemaRegistrationGraph, markers: [Marker], written_in: ModuleID) -> [SemaCallRule] {
    ^rules: [SemaCallRule]{}
    loop marker in markers {
        if marker.negated || marker.declaration_module == None -> next
        resolved: sema_marker_module_resolve_application(graph, written_in, marker)
        declaration: resolved.declaration ?? next
        span: declaration.check ?? next
        value: sema_checked_comptime(sema_user_rule_receiver(declaration, marker)) ?? next
        rules.push(SemaCallRule{module_identity: resolved.declaring_module_identity, marker: declaration.name, span: span, value: value, paired: declaration.pairs != None})
    }
    rules
}

// The rules of the markers the callable registered as `callee` carries.
sema_call_rules_of_callee: fn(graph: SemaRegistrationGraph, callee: SymbolID) -> [SemaCallRule] {
    row: sema_registration_callable_row_of(graph, callee) ?? return [SemaCallRule]{}
    if row == {
        .Function(module_index, index) -> sema_call_rules(graph, graph.modules[module_index].functions[index].declaration.markers, graph.modules[module_index].module_identity)
        .Foreign(_, _) -> [SemaCallRule]{}
        .NominalMethod(module_index, owner, index) -> sema_call_rules(graph, graph.modules[module_index].nominals[owner].methods[index].declaration.markers, graph.modules[module_index].module_identity)
        .ImplMethod(module_index, owner, index) -> sema_call_rules(graph, graph.modules[module_index].impls[owner].methods[index].declaration.markers, graph.modules[module_index].module_identity)
    }
}

// The rules of the markers written on the struct or enum `ty` names from the
// module row `caller`.
sema_call_rules_of_type: fn(graph: SemaRegistrationGraph, ty: Type, caller: Int) -> [SemaCallRule] {
    row: sema_type_resolve_nominal_row_at(graph, ty, caller) ?? return [SemaCallRule]{}
    written_in: graph.modules[row.module_index].module_identity
    if graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
        if item == .Struct(definition) {
            return sema_call_rules(graph, definition.type_markers, written_in)
        }
        if item == .Enum(definition) {
            return sema_call_rules(graph, definition.type_markers, written_in)
        }
    }
    [SemaCallRule]{}
}

// Whether calls checked here hear rules: a body a compile-time run checks
// stages no sites of its own, so its calls are left to their checks.
sema_call_rules_heard_here: fn(scopes: SemaScopeTable) -> Bool Never! {
    scopes.comptime_execution_depth == 0
}

// Hears `rules` at the call of `callee` written `name` at `name_span` with
// `args` in the block `frame`, and, for a method call, the receiver
// `receiver` of type `receiver_type` written at `receiver_span`, whose
// value the build knows as `receiver_known` (None when only the run knows
// it). A stand-in call, which a registering call makes in place of a call
// the program does not write (sema_call_rules_hear_stand_in), is told from
// the others at one name by its `site`, and names the file it stands for as
// its `source`.
sema_call_rules_hear: fn(
    rules: [SemaCallRule],
    callee: SymbolID?,
    name: String,
    name_span: Span,
    args: [CallArg],
    receiver: Expr?,
    receiver_type: Type?,
    receiver_known: TComptimeValue?,
    receiver_span: Span,
    source: String?,
    site: String,
    frame: Int,
    check: ^SemaBodyCheck,
) -> SemaCallRuleHearing {
    ^hearing: SemaCallRuleHearing{from: check.context.comptime_body_sources.len()}
    owner: sema_scope_function_owner_key(check.scopes)
    site_owner: if site == "" -> "{owner}" else -> "{owner}.{site}"
    table: if receiver == .Val(written) -> sema_rule_table(written, owner, check) else -> "{owner}"
    if receiver != None && site == "" {
        check.context.rule_tables.calls_at.push(name_span.start)
        check.context.rule_tables.call_tables.push("{table}")
    }
    ^end: name_span.end
    loop argument in args -> end = argument.span.end
    span: Span{start: name_span.start, end: end}
    ^waiting: [Int]{}
    loop index in 0..<rules.len() {
        if sema_comptime_body_value_find(check.context, check.environment.module_identity, site_owner, rules[index].span, name_span) == .Val(landed) {
            if sema_call_rule_rejects(landed.value, span, check.diagnostics) {
                hearing.rejected = true
                return hearing
            }
            next
        }
        waiting.push(index)
    }
    if waiting.len() == 0 -> return hearing
    // A check without the registration graph (a compile-time run's own
    // program) hears no rule; the compile's own check of the same call does.
    graph: check.program.registration_graph
    keys: sema_rule_table_keys(table, frame, check.scopes)
    // Each waiting rule takes its own row, made for it, so none is copied:
    // a call most often has one rule.
    loop index in waiting {
        if sema_comptime_body_source_row(check.context, check.environment.module_identity, site_owner, rules[index].span, name_span) != None {
            next
        }
        ^call: sema_rule_call_value(graph, callee, name, name_span, span, args, receiver_type, receiver_known, receiver_span, source, keys, owner, check)
        call.words[SEMA_CALL_RULE_PAIRED_WORD] = if rules[index].paired -> 1 else -> 0
        sema_call_rule_stage(check, owner, site_owner, rules[index], call, name_span)
    }
    hearing.staged = true
    hearing
}

// Hears the rules of the type of `receiver_value` (written `receiver`) at
// a stand-in call: one a registering call makes in place of each call it
// stands for, which the program does not write, such as one marked method
// of `app.mount(value)` or one convention page of `.routes(from:)`. It is
// the call `name` at `name_span` with `args` in the registering call's
// block `frame`, told from its other stand-ins by `site`, and `source`
// names the file it stands for. True when a rule rejects it.
sema_call_rules_hear_stand_in: fn(
    receiver: Expr,
    receiver_value: TExpr,
    name: String,
    name_span: Span,
    args: [CallArg],
    source: String?,
    site: String,
    frame: Int,
    check: ^SemaBodyCheck,
) -> Bool {
    if !sema_call_rules_heard_here(check.scopes) -> return false
    graph: check.program.registration_graph
    rules: sema_call_rules_of_type(graph, receiver_value.ty, check.environment.module_row)
    if rules.len() == 0 -> return false
    sema_call_rules_hear(rules, None, name, name_span, args, Val(receiver), Val(receiver_value.ty), None, receiver_value.span, source, site, frame, check).rejected
}

// The tables heard calls add rows to (SemaCheckContext.rule_tables). A
// table is a place: a binding, as each assignment to it leaves it, with a
// field path, or one builder chain. `heard`: the bindings a heard call's
// receiver names; `assigned` and `assigned_at`: each assignment to one of
// them and where it is written; `joined` and `joined_tables`: each binding
// made from a chain and that chain's table; `calls_at` and `call_tables`:
// each heard method call's name and its receiver's table, which a call
// chained on it adds to.
SemaRuleTables: struct {
    heard: [SemaRuleBinding]{[SemaRuleBinding]{}},
    assigned: [SemaRuleBinding]{[SemaRuleBinding]{}},
    assigned_at: [Int]{[Int]{}},
    joined: [SemaRuleBinding]{[SemaRuleBinding]{}},
    joined_tables: [String]{[String]{}},
    calls_at: [Int]{[Int]{}},
    call_tables: [String]{[String]{}},
}

// A binding of SemaRuleTables: the body keyed `owner` and the binding's
// key (SemaScopeBinding.key) in it.
SemaRuleBinding: struct {
    owner: String,
    binding: String,
}

sema_rule_binding_is: fn(written: SemaRuleBinding, owner: String, binding: String) -> Bool Never! {
    written.binding == binding && written.owner == owner
}

// The table a heard call's `receiver` names, in the body keyed `owner`. A
// binding is its own table (or the chain it was made from) until it is
// assigned again; a field adds its name to its base's; a call on a heard
// call adds to that call's receiver's table; any other value is a table of
// its own.
sema_rule_table: fn(receiver: Expr, owner: String, check: ^SemaBodyCheck) -> String {
    if receiver == .Paren(inner, _, _) -> return sema_rule_table(inner, owner, check)
    if receiver == .Field(base, member, _, _) {
        return "{sema_rule_table(base, owner, check)}.{member}"
    }
    if receiver == .MethodCall(_, _, method_span, _, _, _, _) {
        loop (index, at) in check.context.rule_tables.calls_at {
            if at == method_span.start -> return "{check.context.rule_tables.call_tables[index]}"
        }
    }
    if receiver == .Ident(name, span, _) && sema_scope_resolve_index(check.scopes, name) == .Val(binding) {
        key: check.scopes.bindings[binding].key
        ^heard: false
        loop written in check.context.rule_tables.heard {
            if sema_rule_binding_is(written, owner, key) -> heard = true
        }
        if !heard {
            check.context.rule_tables.heard.push(SemaRuleBinding{owner: owner, binding: key})
        }
        ^joined: -1
        loop (index, written) in check.context.rule_tables.joined {
            if sema_rule_binding_is(written, owner, key) -> joined = index
        }
        base: if joined >= 0 -> "{check.context.rule_tables.joined_tables[joined]}" else -> "{owner}:{key}"
        ^generation: 0
        loop (index, assigned) in check.context.rule_tables.assigned {
            if sema_rule_binding_is(assigned, owner, key) && check.context.rule_tables.assigned_at[index] < span.start {
                generation += 1
            }
        }
        return "{base}#{generation}"
    }
    "{owner}@{expr_span(receiver).start}"
}

// After the binding `binding` checks: a binding made from a heard call
// (`app: web.app().get(…)`) joins that call's table.
sema_rule_table_join: fn(binding: Binding, check: ^SemaBodyCheck) Never! {
    if check.context.rule_tables.calls_at.len() == 0 || binding.pattern != None {
        return
    }
    if binding.init == .MethodCall(_, _, method_span, _, _, _, _) && sema_scope_resolve_index(check.scopes, binding.name) == .Val(index) {
        loop (call, at) in check.context.rule_tables.calls_at {
            if at == method_span.start {
                check.context.rule_tables.joined.push(SemaRuleBinding{owner: sema_scope_function_owner_key(check.scopes), binding: check.scopes.bindings[index].key})
                check.context.rule_tables.joined_tables.push("{check.context.rule_tables.call_tables[call]}")
                return
            }
        }
    }
}

// After an assignment to the place rooted at `root`, written at `at`: when
// a heard call named that binding, the assignment starts a new table.
sema_rule_table_assigned: fn(root: String, at: Span, check: ^SemaBodyCheck) Never! {
    if check.context.rule_tables.heard.len() == 0 {
        return
    }
    index: sema_scope_resolve_index(check.scopes, root) ?? return
    owner: sema_scope_function_owner_key(check.scopes)
    key: check.scopes.bindings[index].key
    loop written in check.context.rule_tables.heard {
        if sema_rule_binding_is(written, owner, key) {
            loop (row, assigned) in check.context.rule_tables.assigned {
                if sema_rule_binding_is(assigned, owner, key) && check.context.rule_tables.assigned_at[row] == at.start {
                    return
                }
            }
            check.context.rule_tables.assigned.push(SemaRuleBinding{owner: owner, binding: key})
            check.context.rule_tables.assigned_at.push(at.start)
            return
        }
    }
}

// The keys a call of `table` written in the block `written_in` is found
// under: the table in each block from the body's outermost to that one, so
// a call finds an earlier call of its table written in its own block or one
// around it, which always ran before it. The last is the call's own.
sema_rule_table_keys: fn(table: String, written_in: Int, scopes: SemaScopeTable) -> [String] {
    ^frames: [Int]{}
    ^at: written_in
    loop at >= 0 {
        frames.push(at)
        at = scopes.frames[at].parent
    }
    frames.reverse()
    ^keys: [String]{}
    ^path: "{table}@"
    loop frame in frames {
        path = "{path}.{frame}"
        keys.push("{path}")
    }
    if keys.len() == 0 -> keys.push(path)
    keys
}

// After a staged call's ordinary checks wrote `held`: true when they failed,
// so the call waits on its rules with the errors held back (a rejection
// replaces them, and the recheck after the run reports them otherwise);
// false after the held diagnostics are pushed.
sema_call_rules_hold: fn(hearing: SemaCallRuleHearing, held: ^^[Diagnostic], check: ^SemaBodyCheck) -> Bool Never! {
    if sema_has_error_since(held, 0) {
        loop row in hearing.from..<check.context.comptime_body_sources.len() {
            if check.context.comptime_body_sources[row].rule != None {
                check.context.comptime_body_sources[row].rule_held = true
            }
        }
        return true
    }
    check.diagnostics.extend(held.move())
    false
}

// Stages one rule's site at a call, which no row holds yet: the rule's
// marker value and the call's row, which the driver's batch of the rule
// hears (sema_call_rule_batches). The site is keyed by `site_owner`, the
// body's key or a stand-in's.
sema_call_rule_stage: fn(check: ^SemaBodyCheck, owner: String, site_owner: String, rule: SemaCallRule, call: ^^SemaCallRuleHeard, site_span: Span) Never! {
    destination_key: sema_comptime_body_destination_key(site_owner, rule.span, site_span)
    sema_comptime_body_source_push(
        check.context,
        SemaComptimeBodySource{
            module_identity: check.environment.module_identity,
            function_key: owner,
            site_owner: if site_owner == owner -> None else -> Val(site_owner),
            source_file: sema_source_file_at(check.environment.source_segments, check.environment.source_file, check.environment.source_origin, site_span),
            key: "{check.environment.module_identity.id}.{destination_key}",
            destination_key: destination_key,
            name: "{rule.marker}.check",
            expression: Expr.Unit{span: site_span, id: AST_NODE_GENERATED},
            expected_type: Type.Option{inner: Type.Named{name: "CompilerRejection"}},
            span: rule.span,
            site_span: site_span,
            prepared: [SemaComptimePreparedLocal]{},
            rule: Val(SemaComptimeRuleSite{module_identity: rule.module_identity, marker: rule.marker, value: rule.value, call: call.move()}),
        },
    )
}

// The row of the CompilerCall a rule hears (SemaCallRuleHeard): its caller
// and callee identities, module and span (from the name to the last
// argument), the `name` it was written with, the file a stand-in call
// stands for (`source`), its `receiver` and its `args` in written order,
// then the keys of its table (sema_rule_table_keys). An argument's `type`
// is the type its own check gives it (`_` when that check fails), and its
// `value` the Dyn its value encodes to when the build knows that value
// (sema_rule_value_dyn). A literal is heard as that check would hear it,
// without the check (sema_rule_literal). A type name, which checks only
// where a `Type` is expected, is heard as that `Type` value
// (sema_rule_probe). The `function` an argument names is its FunctionInfo
// (sema_rule_function_named), and the parts an interpolated String literal
// spells are its `written` (sema_rule_written).
sema_rule_call_value: fn(
    graph: SemaRegistrationGraph,
    callee: SymbolID?,
    name: String,
    name_span: Span,
    span: Span,
    args: [CallArg],
    receiver_type: Type?,
    receiver_known: TComptimeValue?,
    receiver_span: Span,
    source: String?,
    tables: [String],
    owner: String,
    check: ^SemaBodyCheck,
) -> SemaCallRuleHeard {
    file: sema_source_file_at(check.environment.source_segments, check.environment.source_file, check.environment.source_origin, span)
    caller: sema_rule_identity(graph, owner, check.context.rule_identities)
    ^callee_identity: "{name}"
    if callee == .Val(id) {
        callee_key: sema_symbol_key(check.program.*, check.context, id)
        callee_identity = sema_rule_identity(graph, callee_key, check.context.rule_identities)
    }
    ^heard: SemaCallRuleHeard{
        words: [Int]{0, 0, 1, 2, 3, span.start, span.end, 4, name_span.start, name_span.end, args.len(), 0, 0, 0},
        texts: [String]{caller, callee_identity, "{check.environment.module_name}", file, "{name}"},
        types: [TComptimeValue]{},
        values: [TComptimeValue]{},
        functions: [TComptimeValue]{},
        written: [TComptimeValue]{},
    }
    if source == .Val(text) {
        heard.texts.push("{text}")
        heard.words[SEMA_CALL_RULE_SOURCE_WORD] = heard.texts.len()
    }
    if {
        receiver_type == .Val(ty) -> {
            heard.words[SEMA_CALL_RULE_HAS_RECEIVER_WORD] = 1
            sema_rule_call_arg(heard, None, ty, receiver_known, None, None, receiver_span, graph, check.context.type_delta, check.environment.*)
        }
        else -> heard.words.extend([Int]{0, 0, 0, 0, 0, 0, 0})
    }
    loop argument in args {
        heard_arg: sema_rule_literal(argument.expr) ?? sema_rule_heard_arg(argument.expr, check)
        ^label: String?{None}
        if argument.label == .Val(written) -> label = Val("{written.name}")
        function: sema_rule_function_named(argument.expr, argument.span, check)
        sema_rule_call_arg(heard, label, heard_arg.ty, heard_arg.known, function, sema_rule_written(argument.expr, file), argument.span, graph, check.context.type_delta, check.environment.*)
    }
    heard.words.push(tables.len())
    loop table in tables {
        heard.words.push(heard.texts.len())
        heard.texts.push("{table}")
    }
    heard
}

// The identities a body's heard calls name, by declaration key
// (SemaCheckContext.rule_identities).
SemaRuleIdentities: struct {
    keys: [String],
    identities: [String],
}

// sema_compiler_identity of the declaration keyed `key`, found once per body
// and kept in `known`: every heard call of a body names the body as its
// caller, and its calls of one callee name that callee. A body names few,
// so a key is found by a scan.
sema_rule_identity: fn(graph: SemaRegistrationGraph, key: String, known: ^SemaRuleIdentities) -> String {
    loop (index, written) in known.keys {
        if written == key -> return "{known.identities[index]}"
    }
    identity: sema_compiler_identity(graph, key)
    known.keys.push("{key}")
    known.identities.push("{identity}")
    identity
}

// The checked argument `expression` as a rule hears it: its own check with
// no type expected, or, when that fails on a type name (`Checkout`,
// `Box<Int>`), its check where the prelude `Type` is expected, which makes
// it that type's `Type` value.
sema_rule_probe: fn(expression: Expr, check: ^SemaBodyCheck) -> TExpr? {
    ^probe_diagnostics: [Diagnostic]{}
    probed: sema_probe_expression(expression, None, check, probe_diagnostics)
    if probed != None || sema_module_no_prelude(check.environment.*, check.program.*) {
        return probed
    }
    if expression == .Ident(_, _, _) || expression == .TypeValue(_, _, _) {
        value_type: sema_expr_expected_type(Type.Named{name: sema_core_source_type_name(check.program.*, "core.prelude", "Type")}, check.environment.*, check.program.*)
        ^type_diagnostics: [Diagnostic]{}
        return sema_probe_expression(expression, Val(value_type), check, type_diagnostics)
    }
    None
}

// The type a rule hears for an argument and what the build knows of its
// value (sema_rule_call_value).
SemaRuleHeardArg: struct {
    ty: Type,
    known: TComptimeValue?,
}

// An argument a literal spells, as its own check with no type expected
// gives it, found without that check: a numeral with no width suffix is an
// Int of its exact value, `true` and `false` a Bool, and a String literal
// with no hole a String of its text. None for any other argument, which
// sema_rule_heard_arg probes.
sema_rule_literal: fn(expression: Expr) -> SemaRuleHeardArg? Never! {
    if expression == .Int(value, _, width, raw, _) && width == None {
        return Val(SemaRuleHeardArg{ty: Type.Int, known: Val(TComptimeValue.Int{value: sema_expr_exact_integer_literal(value, raw)})})
    }
    if expression == .Bool(flag, _, _) {
        return Val(SemaRuleHeardArg{ty: Type.Bool, known: Val(TComptimeValue.Bool{value: flag})})
    }
    if expression == .Str(parts, _, _) {
        ^text: ""
        loop part in parts {
            if part == {
                .Lit(piece) -> { text = "{text}{piece}" }
                .Byte(value) -> { text = "{text}{sema_expr_byte_text(value)}" }
                .Interp(_, _) -> return None
            }
        }
        return Val(SemaRuleHeardArg{ty: Type.String, known: Val(TComptimeValue.String{value: text})})
    }
    None
}

// An argument as its probe (sema_rule_probe) hears it: the probed type, `_`
// when the probe fails, and what the build knows of its value, a Path's
// text included.
sema_rule_heard_arg: fn(expression: Expr, check: ^SemaBodyCheck) -> SemaRuleHeardArg {
    probed: sema_rule_probe(expression, check)
    ty: if probed == .Val(checked) -> checked.ty else -> Type.Named{name: "_"}
    ^known: if probed == .Val(checked) -> sema_rule_known(checked, check) else -> TComptimeValue?{None}
    if known == None && probed == .Val(checked) && (sema_stream_handle_owner(checked.ty) ?? "") == "Path" {
        known = sema_rule_known_path(expression, check)
    }
    SemaRuleHeardArg{ty: ty, known: known}
}

// The FunctionInfo of the declared function the argument `expression` names
// by its bare name, resolved as `f.reflect()` resolves it
// (sema_call_static_reflect_function); None for any other argument, a local
// that shadows the function included.
sema_rule_function_named: fn(expression: Expr, span: Span, check: ^SemaBodyCheck) -> TComptimeValue? {
    if expression == .Ident(name, _, _) {
        graph: check.program.registration_graph
        local: sema_scope_resolve_index(check.scopes, name)
        resolved: if local == .Val(index) -> sema_scope_binding_symbol(check.environment.*, check.scopes, index) else -> sema_resolved_symbol(graph, sema_type_graph_lookup_symbol(graph, check.environment.module_identity, name) ?? return None)
        if resolved.kind != SymbolKind.Function -> return None
        ^probe_diagnostics: [Diagnostic]{}
        info: sema_fact_function_info(resolved, graph, check.context.type_delta, None, span, probe_diagnostics) ?? return None
        return Val(sema_fact_declared_value(info))
    }
    None
}

// Appends the words of one CompilerArg of a heard call, whose value the
// build knows as `known`, which names the function `function` (a
// FunctionInfo) and which spells the parts `parts` (sema_rule_written), to
// `heard`; its type is the TypeId the one maker makes in `graph`.
sema_rule_call_arg: fn(heard: ^SemaCallRuleHeard, label: ^^String?, ty: Type, known: TComptimeValue?, function: ^^TComptimeValue?, parts: ^^TComptimeValue?, span: Span, graph: SemaRegistrationGraph, types: ^[InternerDelta], environment: SemaScopeEnvironment) Never! {
    ^labeled: 0
    if label.move() == .Val(text) {
        heard.texts.push(text.move())
        labeled = heard.texts.len()
    }
    ^named: 0
    if function.move() == .Val(info) {
        heard.functions.push(info.move())
        named = heard.functions.len()
    }
    ^value: 0
    if known == .Val(computed) {
        dyn: sema_rule_value_dyn(graph, environment.module_row, ty, computed, 0)
        if dyn.move() == .Val(tree) {
            heard.values.push(tree.move())
            value = heard.values.len()
        }
    }
    ^spelled: 0
    if parts.move() == .Val(list) {
        heard.written.push(list.move())
        spelled = heard.written.len()
    }
    heard.types.push(sema_comptime_reflection_type_id(graph, types, environment.module_row, ty))
    heard.words.extend([Int]{labeled, heard.types.len() - 1, value, named, span.start, span.end, spelled})
}

// The parts the argument `expression` spells when it is a String literal
// with at least one hole (`CompilerArg.written`): each
// run of its text as a CompilerWrittenPart.Text, and each hole as a
// CompilerWrittenPart.Hole with its name when the hole is a bare name and
// the span of its whole expression in `file` (`record.id`, not `id`). None
// for any other argument: a plain literal, a constant, a parenthesized
// literal and a run-time value spell none.
sema_rule_written: fn(expression: Expr, file: String) -> TComptimeValue? {
    if expression == .Str(parts, _, _) {
        ^written: [TComptimeValue]{}
        ^text: ""
        loop part in parts {
            if part == {
                .Lit(piece) -> { text = "{text}{piece}" }
                .Byte(value) -> { text = "{text}{sema_expr_byte_text(value)}" }
                .Interp(inner, _) -> {
                    if text != "" {
                        written.push(sema_rule_written_text(text))
                        text = ""
                    }
                    name: if inner == .Ident(hole, _, _) -> sema_comptime_reflection_some(TComptimeValue.String{value: "{hole}"}) else -> sema_comptime_reflection_none(Type.String)
                    written.push(
                        TComptimeValue.Enum{
                            type_name: "CompilerWrittenPart",
                            variant: "Hole",
                            args: [TComptimeEnumArg]{
                                TComptimeEnumArg{name: Val("name"), value: name},
                                TComptimeEnumArg{name: Val("span"), value: sema_compiler_index_span(expr_source_span(inner), file)},
                            },
                        },
                    )
                }
            }
        }
        if written.len() == 0 -> return None
        if text != "" -> written.push(sema_rule_written_text(text))
        return Val(TComptimeValue.List{values: written})
    }
    None
}

// The CompilerWrittenPart.Text of a run of a literal's text.
sema_rule_written_text: fn(text: String) -> TComptimeValue Never! {
    TComptimeValue.Enum{type_name: "CompilerWrittenPart", variant: "Text", args: [TComptimeEnumArg]{TComptimeEnumArg{name: Val("text"), value: TComptimeValue.String{value: "{text}"}}}}
}

// What the build knows of a heard call's argument or receiver `value`
// (None when only the run knows it): a literal, or a constant's value
// (sema_expr_comptime_value; a module constant through
// sema_rule_known_constant), with a struct, enum case or list literal built
// from the known values of its parts and a negated number literal its
// negation. A known struct or case leaves its type's name empty:
// sema_rule_value_dyn reads its type from the argument's. A `Path{…}`
// argument is known as its text (sema_rule_known_path).
sema_rule_known: fn(value: TExpr, check: SemaBodyCheck) -> TComptimeValue? {
    if value.kind == .Flat(index) -> return sema_rule_known_row(index, check)
    if value.kind == .StructLit(fields) {
        ^known: [TComptimeField]{}
        loop field in fields {
            known.push(TComptimeField{name: "{field.field.name}", value: sema_rule_known(field.value, check) ?? return None})
        }
        return Val(TComptimeValue.Struct{type_name: "", fields: known})
    }
    if value.kind == .EnumLit(_, variant, payload) {
        ^args: [TComptimeEnumArg]{}
        if payload == .Named(_) -> return None
        if payload == .Positional(positional) {
            loop argument in positional {
                args.push(TComptimeEnumArg{name: None, value: sema_rule_known(argument.value, check) ?? return None})
            }
        }
        return Val(TComptimeValue.Enum{type_name: "", variant: "{variant}", args: args})
    }
    if value.kind == .ListLit(items) -> return sema_rule_known_list(items, check)
    if value.kind == .List(items, coercion) {
        if coercion == None -> return sema_rule_known_list(items, check)
        return None
    }
    if value.kind == .Unary(op, operand) {
        if op != TUnaryOp.Neg -> return None
        return sema_rule_known_negation(sema_rule_known(operand, check) ?? return None)
    }
    // `I32{5}` and `F32{1.5}`: the narrowing of a known number is that number,
    // which sema_rule_value_dyn fits to the argument's type.
    if value.kind == .NumericMethod(receiver, operation) {
        if operation == .CheckedIntToFixed(_, _) || operation == .FloatNarrow {
            return sema_rule_known(receiver, check)
        }
        return None
    }
    if value.kind == .Clone(inner, _) -> return sema_rule_known(inner, check)
    if value.kind == .ExplicitCopy(inner) -> return sema_rule_known(inner, check)
    sema_expr_comptime_value(value, check.context)
}

// sema_rule_known over the items of a list literal.
sema_rule_known_list: fn(items: [TExpr], check: SemaBodyCheck) -> TComptimeValue? {
    ^known: [TComptimeValue]{}
    loop item in items { known.push(sema_rule_known(item, check) ?? return None) }
    Val(TComptimeValue.List{values: known})
}

// The negation of known number `value`; None for anything else.
sema_rule_known_negation: fn(value: TComptimeValue) -> TComptimeValue? Never! {
    if value == .Int(number) -> return Val(TComptimeValue.Int{value: 0 - number})
    if value == .Float(number, bits) {
        return Val(TComptimeValue.Float{value: number * -1.0, bits: bits})
    }
    None
}

// sema_rule_known over arena row `index` (a Flat node, sema_node), whose
// children are arena rows too.
sema_rule_known_row: fn(index: Int, check: SemaBodyCheck) -> TComptimeValue? {
    row: index - check.context.arena.tree.node_base
    if row < 0 || row >= check.context.arena.tree.nodes.len() -> return None
    if check.context.arena.tree.nodes[row].kind == .IntLit(number, _) {
        return Val(TComptimeValue.Int{value: number})
    }
    if check.context.arena.tree.nodes[row].kind == .FloatLit(number) {
        return Val(TComptimeValue.Float{value: number, bits: 64})
    }
    if check.context.arena.tree.nodes[row].kind == .BoolLit(flag) {
        return Val(TComptimeValue.Bool{value: flag})
    }
    if check.context.arena.tree.nodes[row].kind == .CharLit(code) {
        return Val(TComptimeValue.Char{value: code})
    }
    if check.context.arena.tree.nodes[row].kind == .StrLit(parts) {
        ^text: ""
        loop part in parts {
            if part == .Literal(literal) -> text = "{text}{literal}" else -> return None
        }
        return Val(TComptimeValue.String{value: text})
    }
    if check.context.arena.tree.nodes[row].kind == .StructLit(fields) {
        ^known: [TComptimeField]{}
        loop field in fields {
            known.push(TComptimeField{name: "{field.field.name}", value: sema_rule_known_row(field.value, check) ?? return None})
        }
        return Val(TComptimeValue.Struct{type_name: "", fields: known})
    }
    if check.context.arena.tree.nodes[row].kind == .EnumCtor(_, variant, payload) {
        return sema_rule_known_case(symbol_key_leaf(sema_symbol_key(check.program.*, check.context, variant)), payload, check)
    }
    if check.context.arena.tree.nodes[row].kind == .EnumLit(_, variant, payload) {
        return sema_rule_known_case("{variant}", payload, check)
    }
    if check.context.arena.tree.nodes[row].kind == .ListLit(items) {
        return sema_rule_known_rows(items, check)
    }
    if check.context.arena.tree.nodes[row].kind == .List(items, coercion) {
        if coercion == None -> return sema_rule_known_rows(items, check)
        return None
    }
    if check.context.arena.tree.nodes[row].kind == .Unary(op, operand) {
        if op != TUnaryOp.Neg -> return None
        return sema_rule_known_negation(sema_rule_known_row(operand, check) ?? return None)
    }
    if check.context.arena.tree.nodes[row].kind == .NumericMethod(receiver, operation) {
        if operation == .CheckedIntToFixed(_, _) || operation == .FloatNarrow {
            return sema_rule_known_row(receiver, check)
        }
        return None
    }
    if check.context.arena.tree.nodes[row].kind == .Clone(inner, _) {
        return sema_rule_known_row(inner, check)
    }
    if check.context.arena.tree.nodes[row].kind == .ExplicitCopy(inner) {
        return sema_rule_known_row(inner, check)
    }
    if check.context.arena.tree.nodes[row].kind == .ConstRef(symbol) {
        return sema_rule_known_constant(symbol, check.program.*)
    }
    None
}

// The value of the module constant `symbol` reads, which the build knows
// when it is staged or written as a literal, a `Path{…}` literal or another
// such constant of its module (sema_rule_known_written); None for a mutable
// binding and for a function read as a value.
sema_rule_known_constant: fn(symbol: SymbolID, program: SemaProgramTables) -> TComptimeValue? {
    graph: program.registration_graph
    loop module_index in 0..<graph.modules.len() {
        loop constant_index in 0..<graph.modules[module_index].constants.len() {
            if graph.modules[module_index].constants[constant_index].symbol.id == symbol {
                return sema_rule_known_constant_at(graph, module_index, constant_index, 0)
            }
        }
    }
    None
}

// sema_rule_known_constant for the constant at `constant_index` of module
// row `module_index`, reached through `depth` links.
sema_rule_known_constant_at: fn(graph: SemaRegistrationGraph, module_index: Int, constant_index: Int, depth: Int) -> TComptimeValue? {
    if depth > SEMA_CALL_RULE_VALUE_DEPTH || graph.modules[module_index].constants[constant_index].declaration.mutable {
        return None
    }
    if graph.modules[module_index].constants[constant_index].declaration.ct == .Val(staged) {
        return sema_checked_comptime(staged)
    }
    sema_rule_known_written(graph, module_index, graph.modules[module_index].constants[constant_index].declaration.value, depth + 1)
}

// A constant's written value in module row `module_index`: a scalar or
// String literal without holes, a `Path{…}` literal as its path text, or the
// name of another constant of the module, followed through at most
// SEMA_CALL_RULE_VALUE_DEPTH links.
sema_rule_known_written: fn(graph: SemaRegistrationGraph, module_index: Int, expression: Expr, depth: Int) -> TComptimeValue? {
    if depth > SEMA_CALL_RULE_VALUE_DEPTH -> return None
    if expression == .Paren(inner, _, _) {
        return sema_rule_known_written(graph, module_index, inner, depth + 1)
    }
    if expression == .Str(parts, _, _) {
        ^text: ""
        loop part in parts {
            if part == .Lit(literal) -> text = "{text}{literal}" else -> return None
        }
        return Val(TComptimeValue.String{value: text})
    }
    if expression == .Int(number, _, _, _, _) -> return Val(TComptimeValue.Int{value: number})
    if expression == .Float(number, _, narrow, _, _) {
        return Val(TComptimeValue.Float{value: number, bits: if narrow -> 32 else -> 64})
    }
    if expression == .Bool(flag, _, _) -> return Val(TComptimeValue.Bool{value: flag})
    if expression == .Char(text, _, _) {
        return Val(TComptimeValue.Char{value: sema_checked_const_char(text) ?? return None})
    }
    if expression == .ComptimeName(_, _, staged, _) {
        return sema_checked_comptime(staged ?? return None)
    }
    if expression == .TypedLit(head, body, _, _) {
        if head != (Val(Type.Named{name: "Path"})) -> return None
        if body == .Value(value) {
            known: sema_rule_known_written(graph, module_index, value, depth + 1) ?? return None
            return sema_rule_known_path_text(known)
        }
        return None
    }
    if expression == .Ident(name, _, _) {
        loop constant_index in 0..<graph.modules[module_index].constants.len() {
            if graph.modules[module_index].constants[constant_index].symbol.name == name {
                return sema_rule_known_constant_at(graph, module_index, constant_index, depth)
            }
        }
    }
    None
}

// A heard `Path{…}` argument, known when its text is: the built-in Path
// keeps that text, only turning `\` into `/` (Path.from).
sema_rule_known_path: fn(expression: Expr, check: ^SemaBodyCheck) -> TComptimeValue? {
    if expression == .TypedLit(_, body, _, _) {
        if body == .Value(value) {
            ^probe_diagnostics: [Diagnostic]{}
            text: sema_probe_expression(value, Val(Type.String), check, probe_diagnostics) ?? return None
            return sema_rule_known_path_text(sema_rule_known(text, check) ?? return None)
        }
    }
    None
}

// The path a known String `text` names, as Path.from keeps it.
sema_rule_known_path_text: fn(text: TComptimeValue) -> TComptimeValue? Never! {
    if text == .String(written) {
        return Val(TComptimeValue.String{value: written.replace("\\", "/")})
    }
    None
}

// sema_rule_known_row over the items of a list literal's rows.
sema_rule_known_rows: fn(items: [Int], check: SemaBodyCheck) -> TComptimeValue? {
    ^known: [TComptimeValue]{}
    loop item in items { known.push(sema_rule_known_row(item, check) ?? return None) }
    Val(TComptimeValue.List{values: known})
}

// The enum case `variant` whose arena-row payload is `payload`, known when
// its values are; None for a case with named fields.
sema_rule_known_case: fn(variant: String, payload: BodyEnumPayload, check: SemaBodyCheck) -> TComptimeValue? {
    ^args: [TComptimeEnumArg]{}
    if payload == .Named(_) -> return None
    if payload == .Positional(positional) {
        loop argument in positional {
            args.push(TComptimeEnumArg{name: None, value: sema_rule_known_row(argument.value, check) ?? return None})
        }
    }
    Val(TComptimeValue.Enum{type_name: "", variant: variant, args: args})
}

// How deep an argument value nests before its Dyn is left None.
SEMA_CALL_RULE_VALUE_DEPTH: 32

// The largest finite F32.
SEMA_CALL_RULE_F32_MAX: Float{340282346638528859811704183484516925440.0}

// An argument's compile-time value `value`, of type `ty` as module row
// `caller` names it, as the Dyn its `encode()` returns, so a rule reads what
// the run would encode (`CompilerArg.value`). A Bool, an Int or
// fixed-width integer, a Float or F32, a Char, a String, a built-in Path and
// a prelude `Type` are that case, a Char, a Path and a Type (its path) as
// their Text; a list is the Array of its
// items, but a byte list is None (Encode writes Bytes). A struct or enum
// counts only when its Encode is the derived one with no codec option
// (sema_rule_value_derives_encode): a struct is the Object of its encoded
// fields in declaration order under sema_serde_items_field_key, leaving out
// the fields Encode leaves out (sema_serde_items_drops); a case without a
// payload is the Text of sema_serde_items_variant_key, and a case with one
// value the one-entry Object under that key. Anything else is None: an
// optional field, a case with named fields, a generic type, a written codec,
// a Map.
sema_rule_value_dyn: fn(graph: SemaRegistrationGraph, caller: Int, ty: Type, value: TComptimeValue, depth: Int) -> TComptimeValue? {
    if depth > SEMA_CALL_RULE_VALUE_DEPTH -> return None
    // An Int the build holds in a word is its own Dyn payload: no fold.
    if ty == Type.Int && value == .Int(small) && sema_comptime_fold_small_int(small) {
        return Val(sema_rule_dyn("Int", TComptimeValue.Int{value: small}))
    }
    if ty == Type.Int || ty == .IntN(_, _) {
        ^number: Int?{None}
        if value == .Int(small) -> number = Val(small)
        if value == .BigInt(decimal) -> number = Val(Int.parse(decimal) ?? return None)
        exact: number ?? return None
        // A fixed width holds only its range; past it the run stops.
        _: sema_comptime_fold_int(exact, ty) ?? return None
        return Val(sema_rule_dyn("Int", sema_comptime_fold_int(exact, Type.Int) ?? return None))
    }
    if ty == Type.Float || ty == Type.Float32 {
        if value == .Float(number, _) {
            if ty == Type.Float {
                return Val(sema_rule_dyn("Float", TComptimeValue.Float{value: number, bits: 64}))
            }
            // An F32 holds the nearest binary32 value, which Encode widens;
            // a NaN or one past its range stops where it narrows.
            if number.is_nan() || number > SEMA_CALL_RULE_F32_MAX || number < -SEMA_CALL_RULE_F32_MAX {
                return None
            }
            narrow: F32{number}
            return Val(sema_rule_dyn("Float", TComptimeValue.Float{value: Float{narrow}, bits: 64}))
        }
        return None
    }
    if ty == Type.Bool {
        if value == .Bool(flag) {
            return Val(sema_rule_dyn("Bool", TComptimeValue.Bool{value: flag}))
        }
        return None
    }
    // The built-in Path handle has no Encode; it is heard as its text.
    if ty == Type.String || (sema_stream_handle_owner(ty) ?? "") == "Path" {
        if value == .String(text) {
            return Val(sema_rule_dyn("Text", TComptimeValue.String{value: text}))
        }
        return None
    }
    if ty == Type.Char {
        if value == .Char(code) {
            text: String.from_bytes(core_decl_utf8(code)) ?? return None
            return Val(sema_rule_dyn("Text", TComptimeValue.String{value: text}))
        }
        return None
    }
    ^element: Type?{None}
    if ty == .List(inner) -> element = Val(inner)
    if ty == .FixedList(inner, _) -> element = Val(inner)
    if element == .Val(item_type) {
        if item_type == (Type.IntN{signed: false, bits: 8}) -> return None
        if value == .List(items) {
            ^trees: [TComptimeValue]{}
            loop item in items {
                trees.push(sema_rule_value_dyn(graph, caller, item_type, item, depth + 1) ?? return None)
            }
            return Val(sema_rule_dyn("Array", TComptimeValue.List{values: trees}))
        }
        return None
    }
    if ty == .Named(_) {
        row: sema_type_resolve_nominal_row_at(graph, ty, caller) ?? return None
        if graph.modules[row.module_index].nominals[row.row].generic_params.len() > 0 -> return None
        // The prelude's `Type` has no Encode; it is heard as its path's text.
        if graph.modules[row.module_index].module_name == "core.prelude" && graph.modules[row.module_index].nominals[row.row].symbol.name == "Type" {
            if value == .Struct(_, fields) && fields.len() == 1 {
                if fields[0].value == .String(path) {
                    return Val(sema_rule_dyn("Text", TComptimeValue.String{value: path}))
                }
            }
            return None
        }
        if !sema_rule_value_derives_encode(graph, row.module_index, graph.modules[row.module_index].nominals[row.row].symbol.name) {
            return None
        }
        if graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
            if item == .Struct(definition) {
                return sema_rule_value_struct_dyn(graph, row.module_index, definition, value, depth)
            }
            if item == .Enum(definition) {
                return sema_rule_value_enum_dyn(graph, row.module_index, definition, value, depth)
            }
        }
    }
    None
}

// Whether module row `module_index`'s Encode of its type `name` is the one
// the compiler derives (SerdeItems), not a written impl.
sema_rule_value_derives_encode: fn(graph: SemaRegistrationGraph, module_index: Int, name: String) -> Bool {
    loop index in 0..<graph.modules[module_index].impls.len() {
        if graph.modules[module_index].impls[index].target_type_name != name -> next
        if graph.modules[module_index].impls[index].trait_name == .Val(trait_name) && trait_name == "Encode" {
            return graph.modules[module_index].impls[index].declaration.is_generated_serde
        }
    }
    false
}

// A struct value as its derived `encode()` writes it (sema_rule_value_dyn);
// None for a struct or field with a codec option or an optional field.
sema_rule_value_struct_dyn: fn(graph: SemaRegistrationGraph, module_index: Int, definition: StructDef, value: TComptimeValue, depth: Int) -> TComptimeValue? {
    if definition.serde_markers.len() > 0 -> return None
    if value == .Struct(_, written) {
        ^entries: [TComptimeValue]{}
        loop field in definition.fields {
            if field.computed != None || sema_serde_items_drops(field, false) -> next
            if field.serde_markers.len() > 0 -> return None
            ^found: -1
            loop (index, candidate) in written {
                if candidate.name == field.name -> found = index
            }
            if found < 0 -> return None
            tree: sema_rule_value_dyn(graph, module_index, field.ty, written[found].value, depth + 1) ?? return None
            entries.push(sema_rule_dyn_entry(sema_serde_items_field_key(definition, field), tree))
        }
        return Val(sema_rule_dyn("Object", TComptimeValue.List{values: entries}))
    }
    None
}

// An enum value as its derived `encode()` writes it (sema_rule_value_dyn);
// None for an enum or case with a codec option or a case with named fields.
sema_rule_value_enum_dyn: fn(graph: SemaRegistrationGraph, module_index: Int, definition: EnumDef, value: TComptimeValue, depth: Int) -> TComptimeValue? {
    if definition.serde_markers.len() > 0 || codable_tag_field(definition.type_markers) != None || codable_untagged(definition.type_markers) {
        return None
    }
    if value == .Enum(_, written, args) {
        loop variant in definition.variants {
            if variant.name != written -> next
            if variant.serde_markers.len() > 0 -> return None
            key: sema_serde_items_variant_key(variant, sema_checked_rename_case(definition.serde_markers))
            if variant.payload == .Unit {
                return Val(sema_rule_dyn("Text", TComptimeValue.String{value: key}))
            }
            if variant.payload == .Single(payload, _) {
                if args.len() != 1 -> return None
                tree: sema_rule_value_dyn(graph, module_index, payload, args[0].value, depth + 1) ?? return None
                return Val(sema_rule_dyn("Object", TComptimeValue.List{values: [TComptimeValue]{sema_rule_dyn_entry(key, tree)}}))
            }
            return None
        }
    }
    None
}

// The Dyn case `variant` holding `payload`.
sema_rule_dyn: fn(variant: String, payload: TComptimeValue) -> TComptimeValue Never! {
    TComptimeValue.Enum{type_name: "Dyn", variant: variant, args: [TComptimeEnumArg]{TComptimeEnumArg{name: None, value: payload}}}
}

// One `{key, value}` entry of a Dyn Object.
sema_rule_dyn_entry: fn(key: String, tree: TComptimeValue) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "", fields: [TComptimeField]{TComptimeField{name: "key", value: TComptimeValue.String{value: key}}, TComptimeField{name: "value", value: tree}}}
}

// A rule's landed answer, a `CompilerRejection?`. A rejection's finding is
// pushed at its span (`fallback`, the call's, when it holds none): an
// `.Error` one rejects the call and the result is true; a `.Tidy` one is a
// lint and a `.Report` one no diagnostic, and neither replaces the call's
// checks. A clash, a finding that also names another call's span
// (`reject(…, also: other, label: text)`), carries that span with its label
// and is reported beside the call's own checks: each of the two calls is
// fine alone. A finding whose code is the compiler's own takes its registry
// row, a package's code is reported as written (jet_driver_build_findings).
sema_call_rule_rejects: fn(answer: TComptimeValue, fallback: Span, diagnostics: ^[Diagnostic]) -> Bool Never! {
    if answer == .Present(inner) -> return sema_call_rule_rejects(inner, fallback, diagnostics)
    if answer == .Struct(type_name, fields) {
        if type_name != "CompilerRejection" -> return false
        ^code: ""
        ^tier: ""
        ^what: ""
        ^why: ""
        ^fix: ""
        ^label: ""
        ^span: fallback
        ^also: Span?{None}
        loop field in fields {
            if field.name == "span" {
                if sema_comptime_reflection_span_of(field.value) == .Val(at) -> span = at
                next
            }
            if field.name == "also" {
                if field.value == .Present(other) -> also = sema_comptime_reflection_span_of(other)
                next
            }
            if field.value == .String(text) {
                if {
                    field.name == "code" -> code = "{text}"
                    field.name == "tier" -> tier = "{text}"
                    field.name == "what" -> what = "{text}"
                    field.name == "why" -> why = "{text}"
                    field.name == "fix" -> fix = "{text}"
                    field.name == "label" -> label = "{text}"
                    else -> {}
                }
            }
        }
        if tier == "Report" -> return false
        ^report: if diagnostic_registry_row(code) != None -> diagnostic_from_registry(code, Val(span), what, why, fix) else -> Diagnostic{severity: DIAGNOSTIC_ERROR, code: code, span: Val(span), what: diagnostic_sentence_case_line(what), why: diagnostic_sentence_case_line(why), fix: diagnostic_sentence_case_line(fix)}
        rejected: tier == "Error" && also == None
        report.severity = if tier == "Error" -> DIAGNOSTIC_ERROR else -> DIAGNOSTIC_LINT
        if also == .Val(other) -> report = diagnostic_with_label(report.move(), other, label)
        diagnostics.push(report.move())
        return rejected
    }
    false
}

// One run's calls of one rule, the `check` of `marker` declared in
// `module_identity`, heard at once by the batch item keyed `key`
// (sema_call_rule_batch_source), whose value answers each call in order;
// `sites` are those calls' own sources, in that order, at their `rows` of
// the pending sources. `paired`: the rule hears each call with the first
// earlier call of its table that has its row (SemaCallRule.paired).
SemaCallRuleBatch: struct {
    module_identity: ModuleID,
    marker: String,
    span: Span,
    key: String,
    paired: Bool,
    sites: [SemaCallRuleBatchSite],
    rows: [Int],
}

SemaCallRuleBatchSite: struct {
    module_identity: ModuleID,
    key: String,
    destination_key: String,
    place: SemaComptimeBodyPlace,
}

// The batches the rule sites among `pending` make: one per rule (its
// declaring module and marker), in the order the sites were met, each
// appended to `sources` as one item. Each site's marker value and call row
// move into its batch's columns; the other sources stay as they are.
sema_call_rule_batches: fn(graph: SemaRegistrationGraph, pending: ^[SemaComptimeBodySource], pass: Int, sources: ^[SemaComptimeItemSource]) -> [SemaCallRuleBatch] {
    ^batches: [SemaCallRuleBatch]{}
    loop index in 0..<pending.len() {
        site: pending[index].rule ?? next
        // A run holds few rules, so a batch is found by a scan.
        ^row: 0
        loop row < batches.len() && (batches[row].module_identity != site.module_identity || batches[row].marker != site.marker) {
            row += 1
        }
        if row == batches.len() {
            batches.push(SemaCallRuleBatch{module_identity: site.module_identity, marker: "{site.marker}", span: pending[index].span, key: "{site.module_identity.id}.rules.{site.marker}.{pass}", paired: site.call.words[SEMA_CALL_RULE_PAIRED_WORD] == 1, sites: [SemaCallRuleBatchSite]{}, rows: [Int]{}})
        }
        batches[row].rows.push(index)
        batches[row].sites.push(SemaCallRuleBatchSite{module_identity: pending[index].module_identity, key: pending[index].key, destination_key: pending[index].destination_key, place: sema_comptime_body_source_place(pending[index])})
    }
    loop batch in batches {
        ^columns: SemaCallRuleColumns{rules: [TComptimeValue]{}, words: [U8]{}, names: name_column_table(batch.rows.len()), types: [TComptimeValue]{}, values: [TComptimeValue]{}, functions: [TComptimeValue]{}, written: [TComptimeValue]{}}
        loop row in batch.rows { sema_call_rule_columns_add(columns, pending[row].rule.move()) }
        sources.push(sema_call_rule_batch_source(graph, batch, pass, columns))
    }
    batches
}

// One batch's heard calls as columns, so a batch carries no CompilerCall
// value per call: each call is one row of `words`, and names its rule,
// texts, argument types, known argument values, named functions and
// written parts by index into `rules`, `names`' texts, `types`, `values`,
// `functions` and `written`. The words are packed seven bits to a byte, low
// bits first, the high bit set on every byte but a word's last
// (sema_call_rule_word_put), so the column is one byte list, not a value
// per word. The batch's check unpacks them, finds each row from its counts
// and builds each CompilerCall from its row
// (sema_call_rule_batch_expression).
SemaCallRuleColumns: struct {
    rules: [TComptimeValue],
    words: [U8],
    names: NameTable,
    types: [TComptimeValue],
    values: [TComptimeValue],
    functions: [TComptimeValue],
    written: [TComptimeValue],
}

// Packs word `word`, which is never negative (an index, a count, a flag or
// a source offset), as its seven-bit groups, low first.
sema_call_rule_word_put: fn(out: ^[U8], word: Int) Never! {
    ^rest: word
    loop rest >= 128 {
        out.push(U8{(rest & 127) | 128})
        rest = rest >> 7
    }
    out.push(U8{rest})
}

// A row's words: its rule, caller, callee, module, file, span start and
// end, name text, name start and end, argument count, whether it has a
// receiver, its source (0 when it has none, else its text's index plus
// one) and whether its rule is paired, then its receiver's argument words
// (zeros when it has none) and each argument's, then the count of its
// table's keys and each key's text, which end the row: the next row starts
// after its last key. An argument's words are its label (0
// when it has none, else its text's index plus one), type, known value (0
// when the build does not know it, else its index plus one), named
// function (0 when it names none, else its FunctionInfo's index plus one),
// span start and end, and written parts (0 when it spells none, else their
// index plus one); its span's file is the call's.
SEMA_CALL_RULE_COUNT_WORD: 10

SEMA_CALL_RULE_HAS_RECEIVER_WORD: 11

SEMA_CALL_RULE_SOURCE_WORD: 12

SEMA_CALL_RULE_PAIRED_WORD: 13

SEMA_CALL_RULE_RECEIVER_WORD: 14

SEMA_CALL_RULE_ARGS_WORD: 21

SEMA_CALL_RULE_ARG_WORDS: 7

// The words that name a text: caller, callee, module, file and name.
SEMA_CALL_RULE_TEXT_WORDS: [Int]{1, 2, 3, 4, 7}

// Moves one staged site's marker value and call row into `columns`,
// renumbering the row's own text, type, value, function and written-part
// indices into the batch's.
sema_call_rule_columns_add: fn(columns: ^SemaCallRuleColumns, staged: ^^SemaComptimeRuleSite?) Never! {
    site: staged.move() ?? return
    ^rule: 0
    loop rule < columns.rules.len() && columns.rules[rule] != site.value -> rule += 1
    if rule == columns.rules.len() -> columns.rules.push(site.value.move())
    ^call: site.call.move()
    texts: loop text in call.texts -> name_index(name_intern(columns.names, text))
    // The call's types, popped (an owned move) from its last.
    ^types: [Int]{}
    loop call.types.len() > 0 {
        ty: call.types.pop() ?? break
        types.push(sema_call_rule_columns_type(columns, ty.move()))
    }
    types.reverse()
    offsets: SemaCallRuleArgOffsets{values: columns.values.len(), functions: columns.functions.len(), written: columns.written.len()}
    columns.values.extend(call.values.move())
    columns.functions.extend(call.functions.move())
    columns.written.extend(call.written.move())
    ^words: call.words.move()
    words[0] = rule
    loop at in SEMA_CALL_RULE_TEXT_WORDS -> words[at] = texts[words[at]]
    if words[SEMA_CALL_RULE_SOURCE_WORD] > 0 {
        words[SEMA_CALL_RULE_SOURCE_WORD] = texts[words[SEMA_CALL_RULE_SOURCE_WORD] - 1] + 1
    }
    if words[SEMA_CALL_RULE_HAS_RECEIVER_WORD] == 1 {
        sema_call_rule_columns_arg(words, SEMA_CALL_RULE_RECEIVER_WORD, texts, types, offsets)
    }
    loop arg in 0..<words[SEMA_CALL_RULE_COUNT_WORD] {
        sema_call_rule_columns_arg(words, SEMA_CALL_RULE_ARGS_WORD + SEMA_CALL_RULE_ARG_WORDS * arg, texts, types, offsets)
    }
    keys: SEMA_CALL_RULE_ARGS_WORD + SEMA_CALL_RULE_ARG_WORDS * words[SEMA_CALL_RULE_COUNT_WORD]
    loop key in keys + 1..<keys + 1 + words[keys] -> words[key] = texts[words[key]]
    loop word in words -> sema_call_rule_word_put(columns.words, word)
}

// Where one call's known values, named functions and written parts start
// among the batch's.
SemaCallRuleArgOffsets: struct {
    values: Int,
    functions: Int,
    written: Int,
}

// Renumbers the argument words at `at` of a call row by its texts' and
// types' batch indices and its values, functions and written parts by the
// batch's `offsets`.
sema_call_rule_columns_arg: fn(words: ^[Int], at: Int, texts: [Int], types: [Int], offsets: SemaCallRuleArgOffsets) Never! {
    if words[at] > 0 -> words[at] = texts[words[at] - 1] + 1
    words[at + 1] = types[words[at + 1]]
    if words[at + 2] > 0 -> words[at + 2] = words[at + 2] + offsets.values
    if words[at + 3] > 0 -> words[at + 3] = words[at + 3] + offsets.functions
    if words[at + 6] > 0 -> words[at + 6] = words[at + 6] + offsets.written
}

// The index of a TypeId among the batch's types: a batch's arguments have
// few types, so one is found by a scan.
sema_call_rule_columns_type: fn(columns: ^SemaCallRuleColumns, ty: ^^TComptimeValue) -> Int Never! {
    loop (index, known) in columns.types {
        if known == ty -> return index
    }
    columns.types.push(ty.move())
    columns.types.len() - 1
}

// A rule's batch item, in the rule's own module, holding the batch's
// columns as prepared locals.
sema_call_rule_batch_source: fn(graph: SemaRegistrationGraph, batch: SemaCallRuleBatch, pass: Int, columns: ^^SemaCallRuleColumns) -> SemaComptimeItemSource {
    ^file: ""
    if sema_registration_module_index(graph, batch.module_identity) == .Val(row) {
        file = "{graph.modules[row].source_file}"
    }
    marker: Type.Named{name: batch.marker}
    texts: TComptimeValue.List{values: loop text in columns.names.texts -> TComptimeValue.String{value: "{text}"}}
    SemaComptimeItemSource{
        module_identity: batch.module_identity,
        key: batch.key,
        destination_key: "rules.{batch.marker}.{pass}",
        name: "{batch.marker}.check",
        source_file: file,
        kind: SemaComptimeItemKind.BodyExpression,
        expression: sema_call_rule_batch_expression(batch),
        expected_type: Val(Type.List{element: sema_call_rule_answer_type()}),
        span: batch.span,
        dependencies: [String]{},
        checked_text: None,
        prepared: [SemaComptimePreparedLocal]{
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_RULES_LOCAL, ty: Type.List{element: marker}, value: TComptimeValue.List{values: columns.rules.move()}, span: batch.span},
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_WORDS_LOCAL, ty: Type.List{element: Type.IntN{signed: false, bits: 8}}, value: TComptimeValue.Bytes{value: columns.words.move()}, span: batch.span},
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_TEXTS_LOCAL, ty: Type.List{element: Type.String}, value: texts, span: batch.span},
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_TYPES_LOCAL, ty: Type.List{element: Type.Named{name: "TypeId"}}, value: TComptimeValue.List{values: columns.types.move()}, span: batch.span},
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_VALUES_LOCAL, ty: Type.List{element: Type.Named{name: "Dyn"}}, value: TComptimeValue.List{values: columns.values.move()}, span: batch.span},
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_FUNCTIONS_LOCAL, ty: Type.List{element: Type.Named{name: "FunctionInfo"}}, value: TComptimeValue.List{values: columns.functions.move()}, span: batch.span},
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_WRITTEN_LOCAL, ty: Type.List{element: Type.List{element: Type.Named{name: "CompilerWrittenPart"}}}, value: TComptimeValue.List{values: columns.written.move()}, span: batch.span},
        },
    }
}

// Whether `source` is a rule batch's item, whose check alone writes the
// literals of SEMA_CALL_RULE_RECORDS.
sema_call_rule_batch_item: fn(source: SemaComptimeItemSource) -> Bool Never! {
    source.prepared.len() > 0 && source.prepared[0].name == SEMA_CALL_RULE_RULES_LOCAL
}

// The collecting loop a batch runs, parsed from sema_call_rule_batch_text.
// SEMA_CALL_RULE_BATCH_LOOP and SEMA_CALL_RULE_BATCH_PAIRED_LOOP
// (PreludeRows.jet) are what sema_call_rule_batch_read returns for each,
// written by Compiler/Toolchain/PreludeRows, so a compile never parses the
// text.
sema_call_rule_batch_expression: fn(batch: SemaCallRuleBatch) -> Expr Never! {
    if batch.paired -> SEMA_CALL_RULE_BATCH_PAIRED_LOOP else -> SEMA_CALL_RULE_BATCH_LOOP
}

// The text of the collecting loop, as the language writes it, as one
// ordered arm table so the text raises no lint. It reads each prepared
// column once, into a local: a read of a prepared local carries its whole
// value into the checked body and the IR. It unpacks the words
// (sema_call_rule_word_put) and finds where each call's row starts from its
// argument and key counts. Each call's CompilerCall is built from its row
// of words. The batch of a `paired` rule first finds each call's row (its
// marker's `row`) and the first earlier call with that row under one of its
// table's keys, then checks each call with that call, or None.
sema_call_rule_batch_text: fn(paired: Bool{false}) -> String Never! {
    w: "__jet_w"
    t: "__jet_t"
    call: sema_call_rule_call_text("row")
    unpack: "        {w} := [Int]{{}}\n        __jet_word := 0\n        __jet_shift := 0\n        loop __jet_byte in __jet_b {{\n            __jet_part: Int{{__jet_byte}}\n            __jet_word += (__jet_part & 127) << __jet_shift\n            __jet_shift += 7\n            if __jet_part < 128 {{\n                {w}.push(__jet_word)\n                __jet_word = 0\n                __jet_shift = 0\n            }}\n        }}\n        __jet_rows := [Int]{{}}\n        __jet_at := 0\n        loop __jet_at < {w}.len() {{\n            __jet_rows.push(__jet_at)\n            __jet_keys: __jet_at + {SEMA_CALL_RULE_ARGS_WORD} + {SEMA_CALL_RULE_ARG_WORDS} * {w}[__jet_at + {SEMA_CALL_RULE_COUNT_WORD}]\n            __jet_at = __jet_keys + 1 + {w}[__jet_keys]\n        }}\n"
    checks: if paired -> "        __jet_first := [Int]{{}}\n        __jet_seen := [String: Int]{{}}\n        loop row in __jet_rows {{\n            first := -1\n            if __jet_r[{w}[row]].row({call}) == .Val(key) {{\n                at: row + {SEMA_CALL_RULE_ARGS_WORD} + {SEMA_CALL_RULE_ARG_WORDS} * {w}[row + {SEMA_CALL_RULE_COUNT_WORD}]\n                loop k in 1..<{w}[at] + 1 {{\n                    if __jet_seen.get(\"{{{t}[{w}[at + k]]}}|{{key}}\") == .Val(earlier) && (first < 0 || earlier < first) -> first = earlier\n                }}\n                own: \"{{{t}[{w}[at + {w}[at]]]}}|{{key}}\"\n                if __jet_seen.get(own) == None -> __jet_seen[own] = row\n            }}\n            __jet_first.push(first)\n        }}\n        loop (at, row) in __jet_rows -> __jet_r[{w}[row]].check({call}, if __jet_first[at] < 0 -> None else -> Val({sema_call_rule_call_text("__jet_first[at]")}))\n" else -> "        loop row in __jet_rows -> __jet_r[{w}[row]].check({call})\n"
    "RULE_BATCH: if {{\n    true -> {{\n        __jet_r: {SEMA_CALL_RULE_RULES_LOCAL}\n        __jet_b: {SEMA_CALL_RULE_WORDS_LOCAL}\n        {t}: {SEMA_CALL_RULE_TEXTS_LOCAL}\n        __jet_y: {SEMA_CALL_RULE_TYPES_LOCAL}\n        __jet_v: {SEMA_CALL_RULE_VALUES_LOCAL}\n        __jet_f: {SEMA_CALL_RULE_FUNCTIONS_LOCAL}\n        __jet_p: {SEMA_CALL_RULE_WRITTEN_LOCAL}\n{unpack}{checks}    }}\n    else -> [CompilerRejection?]{{}}\n}}\n"
}

// The collecting loop of a `paired` or unpaired rule batch, parsed from its
// text. Only an error makes it the tool's error; a lint never does.
sema_call_rule_batch_read: fn(paired: Bool{false}) -> Expr SemaPreludeTextError! {
    file: "the rule batch loop"
    text: sema_call_rule_batch_text(paired: paired)
    parsed: parse_generated_source(text.bytes())
    errors: loop diagnostic in parsed.diagnostics if diagnostic.severity == DIAGNOSTIC_ERROR -> diagnostic
    if errors.len() > 0 -> return Err(sema_prelude_text_error(file, text, errors))
    if parsed.program.items.len() == 1 {
        if parsed.program.items[0] == .Const(definition) -> return Ok(definition.value)
    }
    Err(SemaPreludeTextError{file: file, line: None, message: "is not one constant"})
}

// The CompilerCall whose row starts at the word `row`.
sema_call_rule_call_text: fn(row: String) -> String Never! {
    w: "__jet_w"
    t: "__jet_t"
    span: sema_call_rule_span_text(row, "{row} + 5")
    name_span: sema_call_rule_span_text(row, "{row} + 8")
    receiver: sema_call_rule_arg_text(row, "{row} + {SEMA_CALL_RULE_RECEIVER_WORD}")
    argument: sema_call_rule_arg_text(row, "{row} + {SEMA_CALL_RULE_ARGS_WORD} + {SEMA_CALL_RULE_ARG_WORDS} * arg")
    source: "{w}[{row} + {SEMA_CALL_RULE_SOURCE_WORD}]"
    "CompilerCall{{caller: {t}[{w}[{row} + 1]], callee: {t}[{w}[{row} + 2]], module: {t}[{w}[{row} + 3]], span: {span}, name: CompilerName{{text: {t}[{w}[{row} + 7]], span: {name_span}}}, args: loop arg in 0..<{w}[{row} + {SEMA_CALL_RULE_COUNT_WORD}] -> {argument}, receiver: if {w}[{row} + {SEMA_CALL_RULE_HAS_RECEIVER_WORD}] == 0 -> None else -> Val({receiver}), source: if {source} == 0 -> None else -> Val({t}[{source} - 1])}}"
}

// The SourceSpan in the file of the call whose row starts at the word
// `row`, whose start and end are the words at `at` and after it.
sema_call_rule_span_text: fn(row: String, at: String) -> String Never! {
    "SourceSpan{{file: __jet_t[__jet_w[{row} + 4]], start: __jet_w[{at}], end: __jet_w[{at} + 1]}}"
}

// The CompilerArg of the call whose row starts at the word `row`, whose
// words start at `at`.
sema_call_rule_arg_text: fn(row: String, at: String) -> String Never! {
    "CompilerArg{{label: if __jet_w[{at}] == 0 -> None else -> Val(__jet_t[__jet_w[{at}] - 1]), type: __jet_y[__jet_w[{at} + 1]], value: if __jet_w[{at} + 2] == 0 -> None else -> Val(__jet_v[__jet_w[{at} + 2] - 1]), function: if __jet_w[{at} + 3] == 0 -> None else -> Val(__jet_f[__jet_w[{at} + 3] - 1]), span: {sema_call_rule_span_text(row, "{at} + 4")}, written: if __jet_w[{at} + 6] == 0 -> None else -> Val(__jet_p[__jet_w[{at} + 6] - 1])}}"
}

// Lands each batched call's answer under its own site's key, in place of the
// batches' own values: the batch's answer at the call's place, or, when the
// batch has no answer for every call, a failure, which rejects nothing.
// True when an answer is a rejection, which the recheck reports.
sema_call_rule_batches_land: fn(batches: [SemaCallRuleBatch], values: ^[SemaComptimeItemValue]) -> Bool Never! {
    if batches.len() == 0 -> return false
    ^rejected: false
    ^landed: [Bool]{}
    loop _ in batches -> landed.push(false)
    // Each row is popped (an owned move), so a batch's answers move into
    // its sites' rows; the kept rows are reversed back into their order.
    ^kept: [SemaComptimeItemValue]{}
    loop {
        row: values.pop() ?? break
        ^batch: 0
        loop batch < batches.len() && batches[batch].key != row.key -> batch += 1
        if batch == batches.len() {
            kept.push(row)
            next
        }
        ^answers: [TComptimeValue]{}
        if row.value.move() == .List(list) -> answers = list.move()
        landed[batch] = true
        if sema_call_rule_batch_land(batches[batch], answers, kept) -> rejected = true
    }
    loop batch in 0..<batches.len() {
        if landed[batch] -> next
        ^unanswered: [TComptimeValue]{}
        ^_: sema_call_rule_batch_land(batches[batch], unanswered, kept)
    }
    kept.reverse()
    values = kept.move()
    rejected
}

// One batch's answers landed as its sites' values (in reverse, as the rows
// around them are); true when one is a rejection of any tier (a `None`
// answer or a failure is none).
sema_call_rule_batch_land: fn(batch: SemaCallRuleBatch, answers: ^[TComptimeValue], values: ^[SemaComptimeItemValue]) -> Bool Never! {
    whole: answers.len() == batch.sites.len()
    ^rejected: false
    ^index: batch.sites.len()
    loop index > 0 {
        index -= 1
        answer: if whole -> answers.pop() ?? TComptimeValue.Unit else -> TComptimeValue.Failed{report: TComptimeReport.Clean{ty: sema_call_rule_answer_type()}}
        if answer == .Present(_) || answer == .Struct(_, _) -> rejected = true
        values.push(SemaComptimeItemValue{module_identity: batch.sites[index].module_identity, key: batch.sites[index].key, destination_key: batch.sites[index].destination_key, kind: SemaComptimeItemKind.BodyExpression, value: answer, ty: sema_call_rule_answer_type(), place: Val(batch.sites[index].place)})
    }
    rejected
}

sema_call_rule_answer_type: fn() -> Type {
    Type.Option{inner: Type.Named{name: "CompilerRejection"}}
}

// Whether a staged call among `pending` held its errors back.
sema_call_rules_held: fn(pending: [SemaComptimeBodySource]) -> Bool Never! {
    loop source in pending {
        if source.rule_held -> return true
    }
    false
}
