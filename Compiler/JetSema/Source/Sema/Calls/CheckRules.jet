// A marker's `check` rule (MarkerDecl.check) heard at
// each call of what the marker marks: a function or method carrying it, or
// a method called on a type carrying it. The rule runs before the call's
// arguments bind. Its answer, a `CompilerRejection?`, is a body comptime
// value like any `#run` site's: the first check of a body stages the call
// (SemaComptimeBodySource.rule) as its row, and the driver runs every
// staged call of one rule in one batch (sema_call_rule_batches), so the
// calls travel as one batch's prepared columns. A check that finds the
// answer landed reads it: an `.Error` rejection is the call's one
// diagnostic and replaces its ordinary checks; no rejection leaves the
// call to them.
use {
    jet_foundation.[
        AST_NODE_GENERATED,
        BodyEnumPayload,
        CallArg,
        DIAGNOSTIC_ERROR,
        DIAGNOSTIC_LINT,
        Diagnostic,
        EnumDef,
        Expr,
        Marker,
        ModuleID,
        NameTable,
        Span,
        StructDef,
        SymbolID,
        SymbolKind,
        TComptimeEnumArg,
        TComptimeField,
        TComptimeReport,
        TComptimeValue,
        TUnaryOp,
        Type,
        codable_tag_field,
        codable_untagged,
        core_decl_utf8,
        diagnostic_from_registry,
        diagnostic_registry_row,
        diagnostic_sentence_case_line,
        name_column_table,
        name_index,
        name_intern,
        symbol_key_leaf,
    ]
    jet_parser.[parse_generated_source]
}

// The columns a batch declares (SemaCallRuleColumns).
SEMA_CALL_RULE_RULES_LOCAL: "__jet_rules"
SEMA_CALL_RULE_ROWS_LOCAL: "__jet_call_rows"
SEMA_CALL_RULE_WORDS_LOCAL: "__jet_call_words"
SEMA_CALL_RULE_TEXTS_LOCAL: "__jet_call_texts"
SEMA_CALL_RULE_TYPES_LOCAL: "__jet_call_types"
SEMA_CALL_RULE_VALUES_LOCAL: "__jet_call_values"
SEMA_CALL_RULE_FUNCTIONS_LOCAL: "__jet_call_functions"

// The compiler records a batch's check builds from its columns; only a
// batch's own check writes their literals (SemaCheckContext.compiler_records).
SEMA_CALL_RULE_RECORDS: [String]{"CompilerCall", "CompilerName", "CompilerArg", "SourceSpan"}

// One rule a call hears: the `check` of the marker `marker`, declared in
// `module_identity` at `span` (its `check` name), with the marker's value
// where it is written.
SemaCallRule: struct {
    module_identity: ModuleID,
    marker: String,
    span: Span,
    value: TComptimeValue,
}

// What hearing a call's rules decided. `rejected`: a landed `.Error`
// rejection, whose diagnostic is pushed, replaces the call's checks.
// `staged`: a rule has no answer yet; its site was staged from row `from` of
// the context's body sources, and the call's errors wait for the answer
// (sema_call_rules_hold).
SemaCallRuleHearing: struct {
    rejected: Bool{false},
    staged: Bool{false},
    from: Int{0},
}

// The rules the markers written in module `written_in` bring: each marker a
// declared marker with a `check` resolves to. A builtin rule is bound to no
// declaring module (sema_marker_module_bind_marker) and brings none.
sema_call_rules: fn(graph: SemaRegistrationGraph, markers: [Marker], written_in: ModuleID) -> [SemaCallRule] {
    rules := [SemaCallRule]{}
    loop marker in markers {
        if marker.negated || marker.declaration_module == None -> next
        resolved: sema_marker_module_resolve_application(graph, written_in, marker)
        declaration: resolved.declaration ?? next
        span: declaration.check ?? next
        value: sema_checked_comptime(sema_user_rule_receiver(declaration, marker)) ?? next
        rules.push(SemaCallRule{module_identity: resolved.declaring_module_identity, marker: declaration.name, span: span, value: value})
    }
    rules
}

// The rules of the markers the callable registered as `callee` carries.
sema_call_rules_of_callee: fn(graph: SemaRegistrationGraph, callee: SymbolID) -> [SemaCallRule] {
    row: sema_registration_callable_row_of(graph, callee) ?? return [SemaCallRule]{}
    if row == {
        .Function(module_index, index) -> sema_call_rules(graph, graph.modules[module_index].functions[index].declaration.markers, graph.modules[module_index].module_identity)
        .Foreign(_, _) -> [SemaCallRule]{}
        .NominalMethod(module_index, owner, index) -> sema_call_rules(graph, graph.modules[module_index].nominals[owner].methods[index].declaration.markers, graph.modules[module_index].module_identity)
        .ImplMethod(module_index, owner, index) -> sema_call_rules(graph, graph.modules[module_index].impls[owner].methods[index].declaration.markers, graph.modules[module_index].module_identity)
    }
}

// The rules of the markers written on the struct or enum `ty` names from the
// module row `caller`.
sema_call_rules_of_type: fn(graph: SemaRegistrationGraph, ty: Type, caller: Int) -> [SemaCallRule] {
    row: sema_type_resolve_nominal_row_at(graph, ty, caller) ?? return [SemaCallRule]{}
    written_in: graph.modules[row.module_index].module_identity
    if graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
        if item == .Struct(definition) -> return sema_call_rules(graph, definition.type_markers, written_in)
        if item == .Enum(definition) -> return sema_call_rules(graph, definition.type_markers, written_in)
    }
    [SemaCallRule]{}
}

// Whether calls checked here hear rules: a body a compile-time run checks
// stages no sites of its own, so its calls are left to their checks.
sema_call_rules_heard_here: fn(scopes: SemaScopeTable) -> Bool Never! {
    scopes.comptime_execution_depth == 0
}

// Hears `rules` at the call of `callee` written `name` at `name_span` with
// `args`, and, for a method call, the receiver of type `receiver_type`
// written at `receiver_span`, whose value the build knows as
// `receiver_known` (None when only the run knows it).
sema_call_rules_hear: fn(
    rules: [SemaCallRule],
    callee: SymbolID?,
    name: String,
    name_span: Span,
    args: [CallArg],
    receiver_type: Type?,
    receiver_known: TComptimeValue?,
    receiver_span: Span,
    environment: SemaScopeEnvironment,
    program: SemaProgramTables,
    scopes: &SemaScopeTable,
    state: &SemaOwnershipState,
    tail_store: &SemaStatementTailStore,
    context: &SemaCheckContext,
    diagnostics: &[Diagnostic],
) -> SemaCallRuleHearing {
    hearing := SemaCallRuleHearing{from: context.comptime_body_sources.len()}
    owner: sema_scope_function_owner_key(scopes)
    end := name_span.end
    loop argument in args -> end = argument.span.end
    span: Span{start: name_span.start, end: end}
    waiting := [Int]{}
    loop index in 0..<rules.len() {
        if sema_comptime_body_value_find(context, environment.module_identity, owner, rules[index].span, name_span) == .Val(landed) {
            if sema_call_rule_rejects(landed.value, span, diagnostics) {
                hearing.rejected = true
                return hearing
            }
            next
        }
        waiting.push(index)
    }
    if waiting.len() == 0 -> return hearing
    call: sema_rule_call_value(callee, name, name_span, span, args, receiver_type, receiver_known, receiver_span, owner, environment, program, scopes, state, tail_store, context)
    loop index in waiting {
        sema_call_rule_stage(context, environment, owner, rules[index], call, name_span)
    }
    hearing.staged = true
    hearing
}

// After a staged call's ordinary checks wrote `held`: true when they failed,
// so the call waits on its rules with the errors held back (a rejection
// replaces them, and the recheck after the run reports them otherwise);
// false after the held diagnostics are pushed.
sema_call_rules_hold: fn(hearing: SemaCallRuleHearing, held: &&[Diagnostic], context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool Never! {
    if sema_has_error_since(held, 0) {
        loop row in hearing.from..<context.comptime_body_sources.len() {
            if context.comptime_body_sources[row].rule != None -> context.comptime_body_sources[row].rule_held = true
        }
        return true
    }
    diagnostics.extend(held.move())
    false
}

// Stages one rule's site at a call: the rule's marker value and the call's
// row, which the driver's batch of the rule hears (sema_call_rule_batches).
sema_call_rule_stage: fn(context: &SemaCheckContext, environment: SemaScopeEnvironment, owner: String, rule: SemaCallRule, call: SemaCallRuleHeard, site_span: Span) Never! {
    destination_key: sema_comptime_body_destination_key(owner, rule.span, site_span)
    key: "{environment.module_identity.id}.{destination_key}"
    if sema_comptime_module_slot(context.comptime_body_source_modules, environment.module_identity) == .Val(slot) {
        if sema_comptime_key_row(context.comptime_body_source_rows[slot], key) != None -> return
    }
    sema_comptime_body_source_append(context, SemaComptimeBodySource{
        module_identity: environment.module_identity,
        function_key: owner,
        source_file: sema_source_file_at(environment.source_segments, environment.source_file, environment.source_origin, site_span),
        key: key,
        destination_key: destination_key,
        name: "{rule.marker}.check",
        expression: Expr.Unit{span: site_span, id: AST_NODE_GENERATED},
        expected_type: Type.Option{inner: Type.Named{name: "CompilerRejection"}},
        span: rule.span,
        site_span: site_span,
        prepared: [SemaComptimePreparedLocal]{},
        rule: Val(SemaComptimeRuleSite{module_identity: rule.module_identity, marker: rule.marker, value: rule.value, call: call}),
    })
}

// The row of the CompilerCall a rule hears (SemaCallRuleHeard): its caller
// and callee identities, module and span (from the name to the last
// argument), the `name` it was written with, its `receiver` and its `args`
// in written order. An argument's `type` is the type its own check gives it
// (`_` when that check fails), and its `value` the Dyn its value encodes to
// when the build knows that value (sema_rule_value_dyn). A type name, which
// checks only where a `Type` is expected, is heard as that `Type` value
// (sema_rule_probe). The `function` an argument names is its FunctionInfo
// (sema_rule_function_named).
sema_rule_call_value: fn(
    callee: SymbolID?,
    name: String,
    name_span: Span,
    span: Span,
    args: [CallArg],
    receiver_type: Type?,
    receiver_known: TComptimeValue?,
    receiver_span: Span,
    owner: String,
    environment: SemaScopeEnvironment,
    program: SemaProgramTables,
    scopes: &SemaScopeTable,
    state: &SemaOwnershipState,
    tail_store: &SemaStatementTailStore,
    context: &SemaCheckContext,
) -> SemaCallRuleHeard {
    file: sema_source_file_at(environment.source_segments, environment.source_file, environment.source_origin, span)
    caller := "{owner}"
    callee_identity := "{name}"
    if program.registration_graph == .Val(graph) {
        caller = sema_rule_identity(graph, owner, context.rule_identities)
        if callee == .Val(id) {
            callee_key: sema_symbol_key(program, context, id)
            callee_identity = sema_rule_identity(graph, callee_key, context.rule_identities)
        }
    }
    heard := SemaCallRuleHeard{
        words: [Int]{0, 0, 1, 2, 3, span.start, span.end, 4, name_span.start, name_span.end, args.len(), 0},
        texts: [String]{caller, callee_identity, "{environment.module_name}", file, "{name}"},
        types: [TComptimeValue]{},
        values: [TComptimeValue]{},
        functions: [TComptimeValue]{},
    }
    if {
        receiver_type == .Val(ty) -> {
            heard.words[SEMA_CALL_RULE_HAS_RECEIVER_WORD] = 1
            sema_rule_call_arg(heard, None, ty, receiver_known, None, receiver_span, environment, program)
        }
        else -> heard.words.extend([Int]{0, 0, 0, 0, 0, 0})
    }
    loop argument in args {
        probed: sema_rule_probe(argument.expr, environment, program, scopes, state, tail_store, context)
        ty: if probed == .Val(checked) -> checked.ty else -> Type.Named{name: "_"}
        known := if probed == .Val(checked) -> sema_rule_known(checked, program, context) else -> TComptimeValue?{None}
        if known == None && probed == .Val(checked) && (sema_stream_handle_owner(checked.ty) ?? "") == "Path" {
            known = sema_rule_known_path(argument.expr, environment, program, scopes, state, tail_store, context)
        }
        label := String?{None}
        if argument.label == .Val(written) -> label = Val("{written.name}")
        sema_rule_call_arg(heard, label, ty, known, sema_rule_function_named(argument.expr, argument.span, environment, program, scopes), argument.span, environment, program)
    }
    heard
}

// The identities a body's heard calls name, by declaration key
// (SemaCheckContext.rule_identities).
SemaRuleIdentities: struct {
    keys: [String],
    identities: [String],
}

// sema_compiler_identity of the declaration keyed `key`, found once per body
// and kept in `known`: every heard call of a body names the body as its
// caller, and its calls of one callee name that callee. A body names few,
// so a key is found by a scan.
sema_rule_identity: fn(graph: SemaRegistrationGraph, key: String, known: &SemaRuleIdentities) -> String {
    loop (index, written) in known.keys {
        if written == key -> return "{known.identities[index]}"
    }
    identity: sema_compiler_identity(graph, key)
    known.keys.push("{key}")
    known.identities.push("{identity}")
    identity
}

// The checked argument `expression` as a rule hears it: its own check with
// no type expected, or, when that fails on a type name (`Checkout`,
// `Box<Int>`), its check where the prelude `Type` is expected, which makes
// it that type's `Type` value.
sema_rule_probe: fn(expression: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> TExpr? {
    probe_diagnostics := [Diagnostic]{}
    probed: sema_probe_expression(expression, None, environment, program, scopes, state, tail_store, context, probe_diagnostics)
    if probed != None || sema_module_no_prelude(environment, program) -> return probed
    if expression == .Ident(_, _, _) || expression == .TypeValue(_, _, _) {
        value_type: sema_expr_expected_type(Type.Named{name: sema_core_source_type_name(program, "core.prelude", "Type")}, environment, program)
        type_diagnostics := [Diagnostic]{}
        return sema_probe_expression(expression, Val(value_type), environment, program, scopes, state, tail_store, context, type_diagnostics)
    }
    None
}

// The FunctionInfo of the declared function the argument `expression` names
// by its bare name, resolved as `f.reflect()` resolves it
// (sema_call_static_reflect_function); None for any other argument, a local
// that shadows the function included.
sema_rule_function_named: fn(expression: Expr, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> TComptimeValue? {
    if expression == .Ident(name, _, _) {
        graph: program.registration_graph ?? return None
        local: sema_scope_resolve_index(scopes, name)
        resolved: if local == .Val(index) -> sema_scope_binding_symbol(environment, scopes, index) else -> sema_resolved_symbol(graph, sema_type_graph_lookup_symbol(graph, environment.module_identity, name) ?? return None)
        if resolved.kind != SymbolKind.Function -> return None
        probe_diagnostics := [Diagnostic]{}
        info: sema_fact_function_info(resolved, graph, None, span, probe_diagnostics) ?? return None
        return Val(sema_fact_declared_value(info))
    }
    None
}

// Appends the words of one CompilerArg of a heard call, whose value the
// build knows as `known` and which names the function `function` (a
// FunctionInfo), to `heard`.
sema_rule_call_arg: fn(heard: &SemaCallRuleHeard, label: &&String?, ty: Type, known: TComptimeValue?, function: &&TComptimeValue?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables) Never! {
    written := 0
    if label.move() == .Val(text) {
        heard.texts.push(text.move())
        written = heard.texts.len()
    }
    named := 0
    if function.move() == .Val(info) {
        heard.functions.push(info.move())
        named = heard.functions.len()
    }
    value := 0
    if known == .Val(computed) && program.registration_graph == .Val(graph) {
        dyn: sema_rule_value_dyn(graph, environment.module_row, ty, computed, 0)
        if dyn.move() == .Val(tree) {
            heard.values.push(tree.move())
            value = heard.values.len()
        }
    }
    heard.types.push(sema_comptime_reflection_type_id_in(program.registration_graph, environment.module_row, ty))
    heard.words.extend([Int]{written, heard.types.len() - 1, value, named, span.start, span.end})
}

// What the build knows of a heard call's argument or receiver `value`
// (None when only the run knows it): a literal, or a constant's value
// (sema_expr_comptime_value; a module constant through
// sema_rule_known_constant), with a struct, enum case or list literal built
// from the known values of its parts and a negated number literal its
// negation. A known struct or case leaves its type's name empty:
// sema_rule_value_dyn reads its type from the argument's. A `Path{…}`
// argument is known as its text (sema_rule_known_path).
sema_rule_known: fn(value: TExpr, program: SemaProgramTables, context: SemaCheckContext) -> TComptimeValue? {
    if value.kind == .Flat(index) -> return sema_rule_known_row(index, program, context)
    if value.kind == .StructLit(fields) {
        known := [TComptimeField]{}
        loop field in fields {
            known.push(TComptimeField{name: "{field.field.name}", value: sema_rule_known(field.value, program, context) ?? return None})
        }
        return Val(TComptimeValue.Struct{type_name: "", fields: known})
    }
    if value.kind == .EnumLit(_, variant, payload) {
        args := [TComptimeEnumArg]{}
        if payload == .Named(_) -> return None
        if payload == .Positional(positional) {
            loop argument in positional {
                args.push(TComptimeEnumArg{name: None, value: sema_rule_known(argument.value, program, context) ?? return None})
            }
        }
        return Val(TComptimeValue.Enum{type_name: "", variant: "{variant}", args: args})
    }
    if value.kind == .ListLit(items) -> return sema_rule_known_list(items, program, context)
    if value.kind == .List(items, coercion) {
        if coercion == None -> return sema_rule_known_list(items, program, context)
        return None
    }
    if value.kind == .Unary(op, operand) {
        if op != TUnaryOp.Neg -> return None
        return sema_rule_known_negation(sema_rule_known(operand, program, context) ?? return None)
    }
    // `I32{5}` and `F32{1.5}`: the narrowing of a known number is that number,
    // which sema_rule_value_dyn fits to the argument's type.
    if value.kind == .NumericMethod(receiver, operation) {
        if operation == .CheckedIntToFixed(_, _) || operation == .FloatNarrow -> return sema_rule_known(receiver, program, context)
        return None
    }
    if value.kind == .Clone(inner, _) -> return sema_rule_known(inner, program, context)
    if value.kind == .ExplicitCopy(inner) -> return sema_rule_known(inner, program, context)
    sema_expr_comptime_value(value, context)
}

// sema_rule_known over the items of a list literal.
sema_rule_known_list: fn(items: [TExpr], program: SemaProgramTables, context: SemaCheckContext) -> TComptimeValue? {
    known := [TComptimeValue]{}
    loop item in items {
        known.push(sema_rule_known(item, program, context) ?? return None)
    }
    Val(TComptimeValue.List{values: known})
}

// The negation of known number `value`; None for anything else.
sema_rule_known_negation: fn(value: TComptimeValue) -> TComptimeValue? Never! {
    if value == .Int(number) -> return Val(TComptimeValue.Int{value: 0 - number})
    if value == .Float(number, bits) -> return Val(TComptimeValue.Float{value: number * -1.0, bits: bits})
    None
}

// sema_rule_known over arena row `index` (a Flat node, sema_node), whose
// children are arena rows too.
sema_rule_known_row: fn(index: Int, program: SemaProgramTables, context: SemaCheckContext) -> TComptimeValue? {
    row: index - context.arena.tree.node_base
    if row < 0 || row >= context.arena.tree.nodes.len() -> return None
    if context.arena.tree.nodes[row].kind == .IntLit(number, _) -> return Val(TComptimeValue.Int{value: number})
    if context.arena.tree.nodes[row].kind == .FloatLit(number) -> return Val(TComptimeValue.Float{value: number, bits: 64})
    if context.arena.tree.nodes[row].kind == .BoolLit(flag) -> return Val(TComptimeValue.Bool{value: flag})
    if context.arena.tree.nodes[row].kind == .CharLit(code) -> return Val(TComptimeValue.Char{value: code})
    if context.arena.tree.nodes[row].kind == .StrLit(parts) {
        text := ""
        loop part in parts {
            if part == .Literal(literal) -> text = "{text}{literal}" else -> return None
        }
        return Val(TComptimeValue.String{value: text})
    }
    if context.arena.tree.nodes[row].kind == .StructLit(fields) {
        known := [TComptimeField]{}
        loop field in fields {
            known.push(TComptimeField{name: "{field.field.name}", value: sema_rule_known_row(field.value, program, context) ?? return None})
        }
        return Val(TComptimeValue.Struct{type_name: "", fields: known})
    }
    if context.arena.tree.nodes[row].kind == .EnumCtor(_, variant, payload) {
        return sema_rule_known_case(symbol_key_leaf(sema_symbol_key(program, context, variant)), payload, program, context)
    }
    if context.arena.tree.nodes[row].kind == .EnumLit(_, variant, payload) {
        return sema_rule_known_case("{variant}", payload, program, context)
    }
    if context.arena.tree.nodes[row].kind == .ListLit(items) -> return sema_rule_known_rows(items, program, context)
    if context.arena.tree.nodes[row].kind == .List(items, coercion) {
        if coercion == None -> return sema_rule_known_rows(items, program, context)
        return None
    }
    if context.arena.tree.nodes[row].kind == .Unary(op, operand) {
        if op != TUnaryOp.Neg -> return None
        return sema_rule_known_negation(sema_rule_known_row(operand, program, context) ?? return None)
    }
    if context.arena.tree.nodes[row].kind == .NumericMethod(receiver, operation) {
        if operation == .CheckedIntToFixed(_, _) || operation == .FloatNarrow -> return sema_rule_known_row(receiver, program, context)
        return None
    }
    if context.arena.tree.nodes[row].kind == .Clone(inner, _) -> return sema_rule_known_row(inner, program, context)
    if context.arena.tree.nodes[row].kind == .ExplicitCopy(inner) -> return sema_rule_known_row(inner, program, context)
    if context.arena.tree.nodes[row].kind == .ConstRef(symbol) {
        return sema_rule_known_constant(symbol, program)
    }
    None
}

// The value of the module constant `symbol` reads, which the build knows
// when it is staged or written as a literal, a `Path{…}` literal or another
// such constant of its module (sema_rule_known_written); None for a mutable
// binding and for a function read as a value.
sema_rule_known_constant: fn(symbol: SymbolID, program: SemaProgramTables) -> TComptimeValue? {
    if program.registration_graph == .Val(graph) {
        loop module_index in 0..<graph.modules.len() {
            loop constant_index in 0..<graph.modules[module_index].constants.len() {
                if graph.modules[module_index].constants[constant_index].symbol.id == symbol {
                    return sema_rule_known_constant_at(graph, module_index, constant_index, 0)
                }
            }
        }
    }
    None
}

// sema_rule_known_constant for the constant at `constant_index` of module
// row `module_index`, reached through `depth` links.
sema_rule_known_constant_at: fn(graph: SemaRegistrationGraph, module_index: Int, constant_index: Int, depth: Int) -> TComptimeValue? {
    if depth > SEMA_CALL_RULE_VALUE_DEPTH || graph.modules[module_index].constants[constant_index].declaration.mutable {
        return None
    }
    if graph.modules[module_index].constants[constant_index].declaration.ct == .Val(staged) {
        return sema_checked_comptime(staged)
    }
    sema_rule_known_written(graph, module_index, graph.modules[module_index].constants[constant_index].declaration.value, depth + 1)
}

// A constant's written value in module row `module_index`: a scalar or
// String literal without holes, a `Path{…}` literal as its path text, or the
// name of another constant of the module, followed through at most
// SEMA_CALL_RULE_VALUE_DEPTH links.
sema_rule_known_written: fn(graph: SemaRegistrationGraph, module_index: Int, expression: Expr, depth: Int) -> TComptimeValue? {
    if depth > SEMA_CALL_RULE_VALUE_DEPTH -> return None
    if expression == .Paren(inner, _, _) {
        return sema_rule_known_written(graph, module_index, inner, depth + 1)
    }
    if expression == .Str(parts, _, _) {
        text := ""
        loop part in parts {
            if part == .Lit(literal) -> text = "{text}{literal}" else -> return None
        }
        return Val(TComptimeValue.String{value: text})
    }
    if expression == .Int(number, _, _, _, _) -> return Val(TComptimeValue.Int{value: number})
    if expression == .Float(number, _, narrow, _, _) {
        return Val(TComptimeValue.Float{value: number, bits: if narrow -> 32 else -> 64})
    }
    if expression == .Bool(flag, _, _) -> return Val(TComptimeValue.Bool{value: flag})
    if expression == .Char(text, _, _) {
        return Val(TComptimeValue.Char{value: sema_checked_const_char(text) ?? return None})
    }
    if expression == .ComptimeName(_, _, staged, _) {
        return sema_checked_comptime(staged ?? return None)
    }
    if expression == .TypedLit(head, body, _, _) {
        if head != (Val(Type.Named{name: "Path"})) -> return None
        if body == .Value(value) {
            known: sema_rule_known_written(graph, module_index, value, depth + 1) ?? return None
            return sema_rule_known_path_text(known)
        }
        return None
    }
    if expression == .Ident(name, _, _) {
        loop constant_index in 0..<graph.modules[module_index].constants.len() {
            if graph.modules[module_index].constants[constant_index].symbol.name == name {
                return sema_rule_known_constant_at(graph, module_index, constant_index, depth)
            }
        }
    }
    None
}

// A heard `Path{…}` argument, known when its text is: the built-in Path
// keeps that text, only turning `\` into `/` (Path.from).
sema_rule_known_path: fn(expression: Expr, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> TComptimeValue? {
    if expression == .TypedLit(_, body, _, _) {
        if body == .Value(value) {
            probe_diagnostics := [Diagnostic]{}
            text: sema_probe_expression(value, Val(Type.String), environment, program, scopes, state, tail_store, context, probe_diagnostics) ?? return None
            return sema_rule_known_path_text(sema_rule_known(text, program, context) ?? return None)
        }
    }
    None
}

// The path a known String `text` names, as Path.from keeps it.
sema_rule_known_path_text: fn(text: TComptimeValue) -> TComptimeValue? Never! {
    if text == .String(written) {
        return Val(TComptimeValue.String{value: written.replace("\\", "/")})
    }
    None
}

// sema_rule_known_row over the items of a list literal's rows.
sema_rule_known_rows: fn(items: [Int], program: SemaProgramTables, context: SemaCheckContext) -> TComptimeValue? {
    known := [TComptimeValue]{}
    loop item in items {
        known.push(sema_rule_known_row(item, program, context) ?? return None)
    }
    Val(TComptimeValue.List{values: known})
}

// The enum case `variant` whose arena-row payload is `payload`, known when
// its values are; None for a case with named fields.
sema_rule_known_case: fn(variant: String, payload: BodyEnumPayload, program: SemaProgramTables, context: SemaCheckContext) -> TComptimeValue? {
    args := [TComptimeEnumArg]{}
    if payload == .Named(_) -> return None
    if payload == .Positional(positional) {
        loop argument in positional {
            args.push(TComptimeEnumArg{name: None, value: sema_rule_known_row(argument.value, program, context) ?? return None})
        }
    }
    Val(TComptimeValue.Enum{type_name: "", variant: variant, args: args})
}

// How deep an argument value nests before its Dyn is left None.
SEMA_CALL_RULE_VALUE_DEPTH: 32

// The largest finite F32.
SEMA_CALL_RULE_F32_MAX: Float{340282346638528859811704183484516925440.0}

// An argument's compile-time value `value`, of type `ty` as module row
// `caller` names it, as the Dyn its `encode()` returns, so a rule reads what
// the run would encode (`CompilerArg.value`). A Bool, an Int or
// fixed-width integer, a Float or F32, a Char, a String, a built-in Path and
// a prelude `Type` are that case, a Char, a Path and a Type (its path) as
// their Text; a list is the Array of its
// items, but a byte list is None (Encode writes Bytes). A struct or enum
// counts only when its Encode is the derived one with no codec option
// (sema_rule_value_derives_encode): a struct is the Object of its encoded
// fields in declaration order under sema_serde_items_field_key, leaving out
// the fields Encode leaves out (sema_serde_items_drops); a case without a
// payload is the Text of sema_serde_items_variant_key, and a case with one
// value the one-entry Object under that key. Anything else is None: an
// optional field, a case with named fields, a generic type, a written codec,
// a Map.
sema_rule_value_dyn: fn(graph: SemaRegistrationGraph, caller: Int, ty: Type, value: TComptimeValue, depth: Int) -> TComptimeValue? {
    if depth > SEMA_CALL_RULE_VALUE_DEPTH -> return None
    if ty == Type.Int || ty == .IntN(_, _) {
        number := Int?{None}
        if value == .Int(small) -> number = Val(small)
        if value == .BigInt(decimal) -> number = Val(Int.parse(decimal) ?? return None)
        exact: number ?? return None
        // A fixed width holds only its range; past it the run stops.
        _: sema_comptime_fold_int(exact, ty) ?? return None
        return Val(sema_rule_dyn("Int", sema_comptime_fold_int(exact, Type.Int) ?? return None))
    }
    if ty == Type.Float || ty == Type.Float32 {
        if value == .Float(number, _) {
            if ty == Type.Float -> return Val(sema_rule_dyn("Float", TComptimeValue.Float{value: number, bits: 64}))
            // An F32 holds the nearest binary32 value, which Encode widens;
            // a NaN or one past its range stops where it narrows.
            if number.is_nan() || number > SEMA_CALL_RULE_F32_MAX || number < -SEMA_CALL_RULE_F32_MAX -> return None
            narrow: F32{number}
            return Val(sema_rule_dyn("Float", TComptimeValue.Float{value: Float{narrow}, bits: 64}))
        }
        return None
    }
    if ty == Type.Bool {
        if value == .Bool(flag) -> return Val(sema_rule_dyn("Bool", TComptimeValue.Bool{value: flag}))
        return None
    }
    // The built-in Path handle has no Encode; it is heard as its text.
    if ty == Type.String || (sema_stream_handle_owner(ty) ?? "") == "Path" {
        if value == .String(text) -> return Val(sema_rule_dyn("Text", TComptimeValue.String{value: text}))
        return None
    }
    if ty == Type.Char {
        if value == .Char(code) {
            text: String.from_bytes(core_decl_utf8(code)) ?? return None
            return Val(sema_rule_dyn("Text", TComptimeValue.String{value: text}))
        }
        return None
    }
    element := Type?{None}
    if ty == .List(inner) -> element = Val(inner)
    if ty == .FixedList(inner, _) -> element = Val(inner)
    if element == .Val(item_type) {
        if item_type == (Type.IntN{signed: false, bits: 8}) -> return None
        if value == .List(items) {
            trees := [TComptimeValue]{}
            loop item in items {
                trees.push(sema_rule_value_dyn(graph, caller, item_type, item, depth + 1) ?? return None)
            }
            return Val(sema_rule_dyn("Array", TComptimeValue.List{values: trees}))
        }
        return None
    }
    if ty == .Named(_) {
        row: sema_type_resolve_nominal_row_at(graph, ty, caller) ?? return None
        if graph.modules[row.module_index].nominals[row.row].generic_params.len() > 0 -> return None
        // The prelude's `Type` has no Encode; it is heard as its path's text.
        if graph.modules[row.module_index].module_name == "core.prelude" && graph.modules[row.module_index].nominals[row.row].symbol.name == "Type" {
            if value == .Struct(_, fields) && fields.len() == 1 {
                if fields[0].value == .String(path) -> return Val(sema_rule_dyn("Text", TComptimeValue.String{value: path}))
            }
            return None
        }
        if !sema_rule_value_derives_encode(graph, row.module_index, graph.modules[row.module_index].nominals[row.row].symbol.name) -> return None
        if graph.modules[row.module_index].nominals[row.row].source == .SourceAST(item) {
            if item == .Struct(definition) -> return sema_rule_value_struct_dyn(graph, row.module_index, definition, value, depth)
            if item == .Enum(definition) -> return sema_rule_value_enum_dyn(graph, row.module_index, definition, value, depth)
        }
    }
    None
}

// Whether module row `module_index`'s Encode of its type `name` is the one
// the compiler derives (SerdeItems), not a written impl.
sema_rule_value_derives_encode: fn(graph: SemaRegistrationGraph, module_index: Int, name: String) -> Bool {
    loop index in 0..<graph.modules[module_index].impls.len() {
        if graph.modules[module_index].impls[index].target_type_name != name -> next
        if graph.modules[module_index].impls[index].trait_name == .Val(trait_name) && trait_name == "Encode" {
            return graph.modules[module_index].impls[index].declaration.is_generated_serde
        }
    }
    false
}

// A struct value as its derived `encode()` writes it (sema_rule_value_dyn);
// None for a struct or field with a codec option or an optional field.
sema_rule_value_struct_dyn: fn(graph: SemaRegistrationGraph, module_index: Int, definition: StructDef, value: TComptimeValue, depth: Int) -> TComptimeValue? {
    if definition.serde_markers.len() > 0 -> return None
    if value == .Struct(_, written) {
        entries := [TComptimeValue]{}
        loop field in definition.fields {
            if field.computed != None || sema_serde_items_drops(field, false) -> next
            if field.serde_markers.len() > 0 -> return None
            found := -1
            loop (index, candidate) in written {
                if candidate.name == field.name -> found = index
            }
            if found < 0 -> return None
            tree: sema_rule_value_dyn(graph, module_index, field.ty, written[found].value, depth + 1) ?? return None
            entries.push(sema_rule_dyn_entry(sema_serde_items_field_key(definition, field), tree))
        }
        return Val(sema_rule_dyn("Object", TComptimeValue.List{values: entries}))
    }
    None
}

// An enum value as its derived `encode()` writes it (sema_rule_value_dyn);
// None for an enum or case with a codec option or a case with named fields.
sema_rule_value_enum_dyn: fn(graph: SemaRegistrationGraph, module_index: Int, definition: EnumDef, value: TComptimeValue, depth: Int) -> TComptimeValue? {
    if definition.serde_markers.len() > 0 || codable_tag_field(definition.type_markers) != None || codable_untagged(definition.type_markers) -> return None
    if value == .Enum(_, written, args) {
        loop variant in definition.variants {
            if variant.name != written -> next
            if variant.serde_markers.len() > 0 -> return None
            key: sema_serde_items_variant_key(variant, sema_checked_rename_case(definition.serde_markers))
            if variant.payload == .Unit -> return Val(sema_rule_dyn("Text", TComptimeValue.String{value: key}))
            if variant.payload == .Single(payload, _) {
                if args.len() != 1 -> return None
                tree: sema_rule_value_dyn(graph, module_index, payload, args[0].value, depth + 1) ?? return None
                return Val(sema_rule_dyn("Object", TComptimeValue.List{values: [TComptimeValue]{sema_rule_dyn_entry(key, tree)}}))
            }
            return None
        }
    }
    None
}

// The Dyn case `variant` holding `payload`.
sema_rule_dyn: fn(variant: String, payload: TComptimeValue) -> TComptimeValue Never! {
    TComptimeValue.Enum{type_name: "Dyn", variant: variant, args: [TComptimeEnumArg]{TComptimeEnumArg{name: None, value: payload}}}
}

// One `{key, value}` entry of a Dyn Object.
sema_rule_dyn_entry: fn(key: String, tree: TComptimeValue) -> TComptimeValue Never! {
    TComptimeValue.Struct{type_name: "", fields: [TComptimeField]{TComptimeField{name: "key", value: TComptimeValue.String{value: key}}, TComptimeField{name: "value", value: tree}}}
}

// A rule's landed answer, a `CompilerRejection?`. A rejection's finding is
// pushed at its span (`fallback`, the call's, when it holds none): an
// `.Error` one rejects the call and the result is true; a `.Tidy` one is a
// lint and a `.Report` one no diagnostic, and neither replaces the call's
// checks. A finding whose code is the compiler's own takes its registry row,
// a package's code is reported as written (jet_driver_build_findings).
sema_call_rule_rejects: fn(answer: TComptimeValue, fallback: Span, diagnostics: &[Diagnostic]) -> Bool Never! {
    if answer == .Present(inner) -> return sema_call_rule_rejects(inner, fallback, diagnostics)
    if answer == .Struct(type_name, fields) {
        if type_name != "CompilerRejection" -> return false
        code := ""
        tier := ""
        what := ""
        why := ""
        fix := ""
        span := fallback
        loop field in fields {
            if field.name == "span" {
                if sema_comptime_reflection_span_of(field.value) == .Val(at) -> span = at
                next
            }
            if field.value == .String(text) {
                if {
                    field.name == "code" -> code = "{text}"
                    field.name == "tier" -> tier = "{text}"
                    field.name == "what" -> what = "{text}"
                    field.name == "why" -> why = "{text}"
                    field.name == "fix" -> fix = "{text}"
                    else -> {}
                }
            }
        }
        if tier == "Report" -> return false
        report := if diagnostic_registry_row(code) != None -> diagnostic_from_registry(code, Val(span), what, why, fix) else -> Diagnostic{severity: DIAGNOSTIC_ERROR, code: code, span: Val(span), what: diagnostic_sentence_case_line(what), why: diagnostic_sentence_case_line(why), fix: diagnostic_sentence_case_line(fix)}
        rejected: tier == "Error"
        report.severity = if rejected -> DIAGNOSTIC_ERROR else -> DIAGNOSTIC_LINT
        diagnostics.push(report)
        return rejected
    }
    false
}

// One run's calls of one rule, the `check` of `marker` declared in
// `module_identity`, heard at once by the batch item keyed `key`
// (sema_call_rule_batch_source), whose value answers each call in order;
// `sites` are those calls' own sources, in that order, at their `rows` of
// the pending sources.
SemaCallRuleBatch: struct {
    module_identity: ModuleID,
    marker: String,
    span: Span,
    key: String,
    sites: [SemaCallRuleBatchSite],
    rows: [Int],
}

SemaCallRuleBatchSite: struct {
    module_identity: ModuleID,
    key: String,
    destination_key: String,
}

// The batches the rule sites among `pending` make: one per rule (its
// declaring module and marker), in the order the sites were met, each
// appended to `sources` as one item. Each site's marker value and call row
// move into its batch's columns; the other sources stay as they are.
sema_call_rule_batches: fn(graph: SemaRegistrationGraph, pending: &[SemaComptimeBodySource], pass: Int, sources: &[SemaComptimeItemSource]) -> [SemaCallRuleBatch] {
    batches := [SemaCallRuleBatch]{}
    loop index in 0..<pending.len() {
        site: pending[index].rule ?? next
        // A run holds few rules, so a batch is found by a scan.
        row := 0
        loop row < batches.len() && (batches[row].module_identity != site.module_identity || batches[row].marker != site.marker) -> row += 1
        if row == batches.len() {
            batches.push(SemaCallRuleBatch{module_identity: site.module_identity, marker: "{site.marker}", span: pending[index].span, key: "{site.module_identity.id}.rules.{site.marker}.{pass}", sites: [SemaCallRuleBatchSite]{}, rows: [Int]{}})
        }
        batches[row].rows.push(index)
        batches[row].sites.push(SemaCallRuleBatchSite{module_identity: pending[index].module_identity, key: pending[index].key, destination_key: pending[index].destination_key})
    }
    loop batch in batches {
        columns := SemaCallRuleColumns{rules: [TComptimeValue]{}, rows: [Int]{}, words: [Int]{}, names: name_column_table(batch.rows.len()), types: [TComptimeValue]{}, values: [TComptimeValue]{}, functions: [TComptimeValue]{}}
        loop row in batch.rows {
            sema_call_rule_columns_add(columns, pending[row].rule.move())
        }
        sources.push(sema_call_rule_batch_source(graph, batch, pass, columns))
    }
    batches
}

// One batch's heard calls as columns, so a batch carries no CompilerCall
// value per call: each call is one row of `words` starting at its offset
// in `rows`, and names its rule, texts, argument types, known argument
// values and named functions by index into `rules`, `names`' texts,
// `types`, `values` and `functions`. The batch's check builds each
// CompilerCall from its row (sema_call_rule_batch_expression).
SemaCallRuleColumns: struct {
    rules: [TComptimeValue],
    rows: [Int],
    words: [Int],
    names: NameTable,
    types: [TComptimeValue],
    values: [TComptimeValue],
    functions: [TComptimeValue],
}

// A row's words: its rule, caller, callee, module, file, span start and
// end, name text, name start and end, argument count and whether it has a
// receiver, then its receiver's argument words (zeros when it has none) and
// each argument's. An argument's words are its label (0 when it has none,
// else its text's index plus one), type, known value (0 when the build does
// not know it, else its index plus one), named function (0 when it names
// none, else its FunctionInfo's index plus one), and span start and end;
// its span's file is the call's.
SEMA_CALL_RULE_COUNT_WORD: 10
SEMA_CALL_RULE_HAS_RECEIVER_WORD: 11
SEMA_CALL_RULE_RECEIVER_WORD: 12
SEMA_CALL_RULE_ARGS_WORD: 18
SEMA_CALL_RULE_ARG_WORDS: 6

// The words that name a text: caller, callee, module, file and name.
SEMA_CALL_RULE_TEXT_WORDS: [Int]{1, 2, 3, 4, 7}

// Moves one staged site's marker value and call row into `columns`,
// renumbering the row's own text, type, value and function indices into
// the batch's.
sema_call_rule_columns_add: fn(columns: &SemaCallRuleColumns, staged: &&SemaComptimeRuleSite?) Never! {
    site: staged.move() ?? return
    rule := 0
    loop rule < columns.rules.len() && columns.rules[rule] != site.value -> rule += 1
    if rule == columns.rules.len() -> columns.rules.push(site.value.move())
    call := site.call.move()
    texts: loop text in call.texts -> name_index(name_intern(columns.names, text))
    // The call's types, popped (an owned move) from its last.
    types := [Int]{}
    loop call.types.len() > 0 {
        ty: call.types.pop() ?? break
        types.push(sema_call_rule_columns_type(columns, ty.move()))
    }
    types.reverse()
    values: columns.values.len()
    columns.values.extend(call.values.move())
    functions: columns.functions.len()
    columns.functions.extend(call.functions.move())
    words := call.words.move()
    words[0] = rule
    loop at in SEMA_CALL_RULE_TEXT_WORDS -> words[at] = texts[words[at]]
    if words[SEMA_CALL_RULE_HAS_RECEIVER_WORD] == 1 -> sema_call_rule_columns_arg(words, SEMA_CALL_RULE_RECEIVER_WORD, texts, types, values, functions)
    loop arg in 0..<words[SEMA_CALL_RULE_COUNT_WORD] -> sema_call_rule_columns_arg(words, SEMA_CALL_RULE_ARGS_WORD + SEMA_CALL_RULE_ARG_WORDS * arg, texts, types, values, functions)
    columns.rows.push(columns.words.len())
    columns.words.extend(words.move())
}

// Renumbers the argument words at `at` of a call row by its texts' and
// types' batch indices, its values starting at `values` and its functions
// at `functions` in the batch's.
sema_call_rule_columns_arg: fn(words: &[Int], at: Int, texts: [Int], types: [Int], values: Int, functions: Int) Never! {
    if words[at] > 0 -> words[at] = texts[words[at] - 1] + 1
    words[at + 1] = types[words[at + 1]]
    if words[at + 2] > 0 -> words[at + 2] = words[at + 2] + values
    if words[at + 3] > 0 -> words[at + 3] = words[at + 3] + functions
}

// The index of a TypeId among the batch's types: a batch's arguments have
// few types, so one is found by a scan.
sema_call_rule_columns_type: fn(columns: &SemaCallRuleColumns, ty: &&TComptimeValue) -> Int Never! {
    loop (index, known) in columns.types {
        if known == ty -> return index
    }
    columns.types.push(ty.move())
    columns.types.len() - 1
}

// A rule's batch item, in the rule's own module, holding the batch's
// columns as prepared locals.
sema_call_rule_batch_source: fn(graph: SemaRegistrationGraph, batch: SemaCallRuleBatch, pass: Int, columns: &&SemaCallRuleColumns) -> SemaComptimeItemSource {
    file := ""
    if sema_registration_module_index(graph, batch.module_identity) == .Val(row) -> file = "{graph.modules[row].source_file}"
    marker: Type.Named{name: batch.marker}
    rows: TComptimeValue.List{values: loop offset in columns.rows -> TComptimeValue.Int{value: offset}}
    words: TComptimeValue.List{values: loop word in columns.words -> TComptimeValue.Int{value: word}}
    texts: TComptimeValue.List{values: loop text in columns.names.texts -> TComptimeValue.String{value: "{text}"}}
    SemaComptimeItemSource{
        module_identity: batch.module_identity,
        key: batch.key,
        destination_key: "rules.{batch.marker}.{pass}",
        name: "{batch.marker}.check",
        source_file: file,
        kind: SemaComptimeItemKind.BodyExpression,
        expression: sema_call_rule_batch_expression(),
        expected_type: Val(Type.List{element: sema_call_rule_answer_type()}),
        span: batch.span,
        dependencies: [String]{},
        checked_text: None,
        prepared: [SemaComptimePreparedLocal]{
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_RULES_LOCAL, ty: Type.List{element: marker}, value: TComptimeValue.List{values: columns.rules.move()}, span: batch.span},
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_ROWS_LOCAL, ty: Type.List{element: Type.Int}, value: rows, span: batch.span},
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_WORDS_LOCAL, ty: Type.List{element: Type.Int}, value: words, span: batch.span},
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_TEXTS_LOCAL, ty: Type.List{element: Type.String}, value: texts, span: batch.span},
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_TYPES_LOCAL, ty: Type.List{element: Type.Named{name: "TypeId"}}, value: TComptimeValue.List{values: columns.types.move()}, span: batch.span},
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_VALUES_LOCAL, ty: Type.List{element: Type.Named{name: "Dyn"}}, value: TComptimeValue.List{values: columns.values.move()}, span: batch.span},
            SemaComptimePreparedLocal{name: SEMA_CALL_RULE_FUNCTIONS_LOCAL, ty: Type.List{element: Type.Named{name: "FunctionInfo"}}, value: TComptimeValue.List{values: columns.functions.move()}, span: batch.span},
        },
    }
}

// Whether `source` is a rule batch's item, whose check alone writes the
// literals of SEMA_CALL_RULE_RECORDS.
sema_call_rule_batch_item: fn(source: SemaComptimeItemSource) -> Bool Never! {
    source.prepared.len() > 0 && source.prepared[0].name == SEMA_CALL_RULE_RULES_LOCAL
}

// The collecting loop a batch runs, parsed as the language writes it, as
// one ordered arm table so the text raises no lint. It reads each prepared
// column once, into a local: a read of a prepared local carries its whole
// value into the checked body and the IR. Each call's CompilerCall is built
// from its row of words. Only an error stops it; a lint never does.
sema_call_rule_batch_expression: fn() -> Expr {
    w: "__jet_w"
    t: "__jet_t"
    span: sema_call_rule_span_text("row + 5")
    name_span: sema_call_rule_span_text("row + 8")
    receiver: sema_call_rule_arg_text("row + {SEMA_CALL_RULE_RECEIVER_WORD}")
    argument: sema_call_rule_arg_text("row + {SEMA_CALL_RULE_ARGS_WORD} + {SEMA_CALL_RULE_ARG_WORDS} * arg")
    call: "CompilerCall{{caller: {t}[{w}[row + 1]], callee: {t}[{w}[row + 2]], module: {t}[{w}[row + 3]], span: {span}, name: CompilerName{{text: {t}[{w}[row + 7]], span: {name_span}}}, args: loop arg in 0..<{w}[row + 10] -> {argument}, receiver: if {w}[row + 11] == 0 -> None else -> Val({receiver})}}"
    text: "RULE_BATCH: if {{\n    true -> {{\n        __jet_r: {SEMA_CALL_RULE_RULES_LOCAL}\n        __jet_rows: {SEMA_CALL_RULE_ROWS_LOCAL}\n        {w}: {SEMA_CALL_RULE_WORDS_LOCAL}\n        {t}: {SEMA_CALL_RULE_TEXTS_LOCAL}\n        __jet_y: {SEMA_CALL_RULE_TYPES_LOCAL}\n        __jet_v: {SEMA_CALL_RULE_VALUES_LOCAL}\n        __jet_f: {SEMA_CALL_RULE_FUNCTIONS_LOCAL}\n        loop row in __jet_rows -> __jet_r[{w}[row]].check({call})\n    }}\n    else -> [CompilerRejection?]{{}}\n}}\n"
    parsed: parse_generated_source(text.bytes())
    loop diagnostic in parsed.diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR -> panic("the rule batch loop does not parse: {diagnostic.code} {diagnostic.what}")
    }
    if parsed.program.items.len() == 1 {
        if parsed.program.items[0] == .Const(definition) -> return definition.value
    }
    panic("the rule batch loop does not parse")
}

// The SourceSpan in the call's file whose start and end are the words at
// `at` and after it.
sema_call_rule_span_text: fn(at: String) -> String Never! {
    "SourceSpan{{file: __jet_t[__jet_w[row + 4]], start: __jet_w[{at}], end: __jet_w[{at} + 1]}}"
}

// The CompilerArg whose words start at `at`.
sema_call_rule_arg_text: fn(at: String) -> String Never! {
    "CompilerArg{{label: if __jet_w[{at}] == 0 -> None else -> Val(__jet_t[__jet_w[{at}] - 1]), type: __jet_y[__jet_w[{at} + 1]], value: if __jet_w[{at} + 2] == 0 -> None else -> Val(__jet_v[__jet_w[{at} + 2] - 1]), function: if __jet_w[{at} + 3] == 0 -> None else -> Val(__jet_f[__jet_w[{at} + 3] - 1]), span: {sema_call_rule_span_text("{at} + 4")}}}"
}

// Lands each batched call's answer under its own site's key, in place of the
// batches' own values: the batch's answer at the call's place, or, when the
// batch has no answer for every call, a failure, which rejects nothing.
// True when an answer is a rejection, which the recheck reports.
sema_call_rule_batches_land: fn(batches: [SemaCallRuleBatch], values: &[SemaComptimeItemValue]) -> Bool Never! {
    if batches.len() == 0 -> return false
    rejected := false
    landed := [Bool]{}
    loop _ in batches -> landed.push(false)
    // Each row is popped (an owned move), so a batch's answers move into
    // its sites' rows; the kept rows are reversed back into their order.
    kept := [SemaComptimeItemValue]{}
    loop values.len() > 0 {
        row: values.pop() ?? panic("a nonempty value list failed to pop")
        batch := 0
        loop batch < batches.len() && batches[batch].key != row.key -> batch += 1
        if batch == batches.len() {
            kept.push(row)
            next
        }
        answers := [TComptimeValue]{}
        if row.value.move() == .List(list) -> answers = list.move()
        landed[batch] = true
        if sema_call_rule_batch_land(batches[batch], answers, kept) -> rejected = true
    }
    loop batch in 0..<batches.len() {
        if landed[batch] -> next
        unanswered := [TComptimeValue]{}
        _ := sema_call_rule_batch_land(batches[batch], unanswered, kept)
    }
    kept.reverse()
    values = kept.move()
    rejected
}

// One batch's answers landed as its sites' values (in reverse, as the rows
// around them are); true when one is a rejection of any tier (a `None`
// answer or a failure is none).
sema_call_rule_batch_land: fn(batch: SemaCallRuleBatch, answers: &[TComptimeValue], values: &[SemaComptimeItemValue]) -> Bool Never! {
    whole: answers.len() == batch.sites.len()
    rejected := false
    index := batch.sites.len()
    loop index > 0 {
        index -= 1
        answer: if whole -> answers.pop() ?? TComptimeValue.Unit else -> TComptimeValue.Failed{report: TComptimeReport.Clean{ty: sema_call_rule_answer_type()}}
        if answer == .Present(_) || answer == .Struct(_, _) -> rejected = true
        values.push(SemaComptimeItemValue{module_identity: batch.sites[index].module_identity, key: batch.sites[index].key, destination_key: batch.sites[index].destination_key, kind: SemaComptimeItemKind.BodyExpression, value: answer, ty: sema_call_rule_answer_type()})
    }
    rejected
}

sema_call_rule_answer_type: fn() -> Type {
    Type.Option{inner: Type.Named{name: "CompilerRejection"}}
}

// Whether a staged call among `pending` held its errors back.
sema_call_rules_held: fn(pending: [SemaComptimeBodySource]) -> Bool Never! {
    loop source in pending {
        if source.rule_held -> return true
    }
    false
}
