use jet_foundation.[Diagnostic, Span, Call, CallArg, CallArgFlags, FuncSig, Expr, Type]
use jet_sema.[Checker, type_fix_hint, contains_expiring_secret_loan, e1313]

impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/variadic.rs:12
    fn check_variadic_bound_tail(&self, call: Call, sig: FuncSig, &tail: [CallArg], bounds: [String]) Never! {
        param_name :: if sig.param_info.last() == .Val((name, _)) -> name else -> ""
        loop &arg in tail {
            if arg.spread {
                self.diags.push(Diagnostic.error("E1312", "`{call.name}` doesn't accept a spread argument", "a trait-bounded variadic (`...Trait` / `...[A, B]`) takes each argument as its own type — spread would need one shared list type", "pass arguments individually", Val(call.name_span)))
                _ :: self.infer(&arg.expr)
                next
            }
            ty :: self.infer(&arg.expr) ?? next
            if !ty.is_scalar() && arg.expr == .Ident(name, span) { self.mark_moved_by(name, span, call.name) }
            arg_name :: ty.name()
            loop bound in bounds {
                if !self.trait_reg.implements_trait(arg_name, bound) { self.diags.push(e1313(arg_name, bound, param_name, call.name, arg.expr.span())) }
            }
        }
    }
    // Rust: crates/jet-sema/src/Sema/CheckerInfer/calls/variadic.rs:68
    pub fn normalize_variadic_call(&self, &call: Call, sig: FuncSig) Never! {
        fixed :: max(sig.params.len() - 1, 0)
        (variadic_conv, variadic_ty) :: sig.params.last() ?? return
        if variadic_ty != .List(elem_ty) -> return
        if call.args.len() < fixed {
            plural :: if fixed == 1 -> "" else -> "s"
            self.diags.push(Diagnostic.error("E0104", "`{call.name}` expects at least {fixed} argument{plural}, got {call.args.len()}", "every fixed parameter must receive a value before the variadic tail", "check the definition of `{call.name}`", Val(call.name_span)))
            loop &arg in call.args { _ :: self.infer(&arg.expr) }
            return
        }
        tail :: call.args.split_off(fixed)
        packed_source_index := Int?{None}
        loop arg in tail {
            if arg.flags.source_index == .Val(index) { packed_source_index = Val(if packed_source_index == .Val(current) -> min(current, index) else -> index) }
        }
        packed_elems := [Expr]{}
        pack_span := call.name_span
        loop &arg in tail {
            if arg.spread {
                spread_span :: arg.expr.span()
                got :: self.infer(&arg.expr)
                pack_span = Span.new(pack_span.start, spread_span.end)
                if got == {
                    .Val(Type.List(inner)) -> {
                        if inner != elem_ty { self.diags.push(Diagnostic.error("E1311", "spread list is `[{inner.name()}]`, but `{call.name}` expects `[{elem_ty.name()}]`", "call spread expands a list into the callee's variadic tail", "pass a `[{elem_ty.name()}]` list, or change the element types", Val(arg.expr.span()))) }
                    }
                    .Val(other) -> self.diags.push(Diagnostic.error("E1311", "spread needs a list, not `{other.name()}`", "call spread `f(...xs)` expands a list into the remaining parameter slots", "pass a `[{elem_ty.name()}]` value here", Val(arg.expr.span())))
                    .None -> {}
                }
                packed_elems.push(Expr.Spread(^arg.expr, spread_span))
            } else {
                saved :: ^self.expected_type
                self.expected_type = Val(elem_ty)
                got :: self.infer(&arg.expr)
                self.expected_type = ^saved
                if got == .Val(inferred) {
                    widened :: self.widen_numeric_argument(&arg.expr, inferred, elem_ty, variadic_conv)
                    lifted :: self.lift_optional_argument(&arg.expr, widened, elem_ty, variadic_conv)
                    if contains_expiring_secret_loan(lifted) {
                        if arg.expr == .Ident(name, span) { self.mark_moved_by(name, span, call.name) }
                    } else {
                        boxes_as_trait :: self.trait_slot_accepts(elem_ty, lifted)
                        if boxes_as_trait { self.note_move_if_direct_ident(arg.expr, "`{call.name}`") }
                        if lifted == elem_ty || boxes_as_trait {
                            pack_span = Span.new(pack_span.start, arg.expr.span().end)
                            packed_elems.push(^arg.expr)
                            next
                        }
                        self.diags.push(Diagnostic.error("E0112", "variadic argument should be {elem_ty.show()}, not {lifted.show()}", "each trailing argument is collected into the rest parameter's list", type_fix_hint(elem_ty, lifted), Val(arg.expr.span())))
                    }
                }
                pack_span = Span.new(pack_span.start, arg.expr.span().end)
                packed_elems.push(^arg.expr)
            }
        }
        packed_expr :: if packed_elems.is_empty() -> Expr.ListLit([Expr]{}, pack_span) else if packed_elems.len() == 1 -> {
            only :: packed_elems.pop().unwrap()
            if only == .Spread(inner, _) -> ^inner else -> Expr.ListLit([Expr]{^only}, pack_span)
        } else -> Expr.ListLit(^packed_elems, pack_span)
        flags := CallArgFlags.default()
        flags.source_index = packed_source_index
        call.args.push(CallArg{convention: variadic_conv, expr: ^packed_expr, span: pack_span, flags: flags, label: None, spread: false})
    }
}
