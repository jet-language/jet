// The typed devtools publication gate. Source spells only
// `devtools.publish(field: .state_field, value: v)`. The selector must name a
// state field of the package's `#DevPanel` panel; the compiler then supplies
// the package/module/panel identity as the hidden leading ABI strings of Core's
// source `publish(package, module_name, panel, field, value)`.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    CallLabel,
    Diagnostic,
    Expr,
    Func,
    MARKER_DEV_PANEL,
    Span,
    StrPart,
    StructDef,
    Type,
    ast_empty_call_arg_flags,
    type_name,
]

SemaDevtoolsPanelIdentity: struct {
    package: String
    module_name: String
    panel: String
}

sema_call_devtools_is_publish: fn(target: SemaCallDirectTarget, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    target.symbol.name == "publish" && sema_call_core_module_is(environment, program, "core.devtools", target.symbol.module_identity)
}

// The checked publication arguments in Core's source parameter order, or None
// after reporting why the call is not a gated publication.
sema_call_devtools_publish_args: fn(args: [CallArg], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> [CallArg]? {
    if args.len() != 2 || sema_call_devtools_label(args[0]) != "field" || sema_call_devtools_label(args[1]) != "value" {
        diagnostics.push(sema_error("E1404", span, "this published value has no gate", "a published value must name itself with `field:` and `value:`", "write `devtools.publish(field: .state_field, value: <expr>)`"))
        return None
    }
    field: sema_call_devtools_field_name(args[0].expr) ?? {
        diagnostics.push(sema_error("E1412", args[0].span, "devtools panel `publish` is invalid", "the `field:` argument must be a leading-dot state field selector", "write `field: .state_field` for a field in the marked panel state"))
        return None
    }
    identity: sema_call_devtools_panel_for_field(environment, program, field) ?? {
        diagnostics.push(sema_error("E1412", args[0].span, "devtools panel `publish` is invalid", "the package has no uniquely identified panel field `{field}`", "publish a field declared by the package's marked `panel` state"))
        return None
    }
    // copy: the rebuilt call owns its value argument; the source call keeps its own.
    value: args[1].copy()
    [CallArg]{
        sema_call_devtools_text_arg("package", identity.package, span),
        sema_call_devtools_text_arg("module_name", identity.module_name, span),
        sema_call_devtools_text_arg("panel", identity.panel, span),
        sema_call_devtools_text_arg("field", field, args[0].span),
        value,
    }
}

sema_call_devtools_label: fn(argument: CallArg) -> String Never! {
    if argument.label == .Val(label) -> return label.name
    ""
}

// A lower-case `.field` parses as a bare member chain, an upper-case one as a
// leading-dot enum literal without payload.
sema_call_devtools_field_name: fn(expr: Expr) -> String? Never! {
    if expr == .Field(base, member, _, _) {
        if sema_expr_is_bare_subject(base) -> return Val(member)
        return None
    }
    if expr == .EnumLit(type_name, variant, _, payload, leading_dot, _, _) {
        if leading_dot && type_name == "" && payload.len() == 0 -> return Val(variant)
    }
    None
}

sema_call_devtools_text_arg: fn(label: String, text: String, span: Span) -> CallArg Never! {
    CallArg{convention: AccessConvention.Read, expr: Expr.Str{parts: [StrPart]{StrPart.Lit{text: text}}, span: span, id: AST_NODE_GENERATED},
        span: span, flags: ast_empty_call_arg_flags(), label: Val(CallLabel{name: label, span: span}), spread: false}
}

// Rust `panel_for_field(package, module, field)` then
// `unique_panel_for_field(package, field)`: a panel of the calling module wins,
// otherwise exactly one panel of the package must declare the field.
sema_call_devtools_panel_for_field: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, field: String) -> SemaDevtoolsPanelIdentity? {
    if program.registration_graph == .Val(graph) {
        caller: sema_scope_caller_index(environment, graph) ?? return None
        package: graph.modules[caller].package_identity
        found := SemaDevtoolsPanelIdentity?{None}
        count := 0
        loop module_index in 0..<graph.modules.len() {
            if graph.modules[module_index].package_identity != package -> next
            loop item_index in 0..<graph.modules[module_index].program.items.len() {
                if graph.modules[module_index].program.items[item_index] == .Func(function) {
                    if !sema_call_devtools_marks_panel(function) -> next
                    if !sema_call_devtools_state_declares(graph, package, function, field) -> next
                    identity: SemaDevtoolsPanelIdentity{package: package, module_name: graph.modules[module_index].module_path, panel: function.name}
                    if module_index == caller -> return Val(identity)
                    count += 1
                    found = Val(identity)
                }
            }
        }
        if count == 1 -> return found
    }
    None
}

sema_call_devtools_marks_panel: fn(function: Func) -> Bool Never! {
    loop marker in function.markers {
        if marker.name == MARKER_DEV_PANEL -> return true
    }
    false
}

// The panel's one `state` parameter names a struct of the same package that
// declares `field`.
sema_call_devtools_state_declares: fn(graph: SemaRegistrationGraph, package: String, function: Func, field: String) -> Bool Never! {
    if function.params.len() != 1 -> return false
    state_name := ""
    if function.params[0].ty == .Named(name) -> state_name = name.copy() else -> return false
    loop module_index in 0..<graph.modules.len() {
        if graph.modules[module_index].package_identity != package -> next
        loop item_index in 0..<graph.modules[module_index].program.items.len() {
            if graph.modules[module_index].program.items[item_index] == .Struct(definition) {
                if definition.name != state_name -> next
                loop declared in definition.fields {
                    if declared.name == field -> return true
                }
            }
        }
    }
    false
}

// `check_devtools_panels`: a `#DevPanel` function is the package's public
// `panel(state: State) -> UINode`, marked once with a bare marker, whose state
// struct gives every field a value before its first publication (a default, or
// an optional type).
sema_check_devtools_panel: fn(func: Func, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) {
    marker_span := Span?{None}
    marker_valid := true
    marker_count := 0
    loop marker in func.markers {
        if marker.name != MARKER_DEV_PANEL -> next
        if marker_count == 0 {
            marker_span = Val(marker.span)
            marker_valid = !marker.negated && marker.args.len() == 0
        }
        marker_count += 1
    }
    span: marker_span ?? return
    if marker_count != 1 {
        diagnostics.push(sema_devtools_panel_error("E1410", func.name, "a devtools panel is registered once per function", "keep one `#DevPanel` marker on the public `panel` function", span))
        return
    }
    if !marker_valid {
        diagnostics.push(sema_devtools_panel_error("E1411", func.name, "`#DevPanel` has no arguments and cannot be negated", "write `#DevPanel` without `!` or marker arguments", span))
        return
    }
    if !func.is_pub || func.is_package_pub {
        diagnostics.push(sema_devtools_panel_error("E1411", func.name, "a devtools panel is a public package entry point", "write `panel: fn(state: State) -> UINode {{ ... }}` outside any `priv module`", func.name_span))
        return
    }
    if func.name != "panel" || func.type_params.len() > 0 || func.params.len() != 1 || func.params[0].name != "state" || func.params[0].default != None || func.params[0].variadic {
        diagnostics.push(sema_devtools_panel_error("E1411", func.name, "a devtools panel must be the public `panel(state: State)` function", "write one non-generic `state` parameter without a default or variadic marker", func.name_span))
        return
    }
    return_type: func.return_type ?? {
        diagnostics.push(sema_devtools_panel_error("E1411", func.name, "a devtools panel must return a `UINode` tree", "declare `UINode` before the function body arrow", func.name_span))
        return
    }
    if return_type != (Type.Named{name: "UINode"}) {
        diagnostics.push(sema_devtools_panel_error("E1411", func.name, "a devtools panel returns `{sema_type_show(return_type)}` instead of `UINode`", "return the portable `UINode` tree from the panel function", func.return_type_span ?? func.name_span))
        return
    }
    state_name := ""
    if func.params[0].ty == .Named(name) -> state_name = name.copy() else -> return
    state: sema_devtools_package_struct(environment, program, state_name) ?? {
        diagnostics.push(sema_devtools_panel_error("E1411", func.name, "panel state type `{state_name}` is not a declared struct", "declare `{state_name}: struct` in the same package", func.params[0].ty_span))
        return
    }
    loop field in state.fields {
        if field.default != None -> next
        if field.ty == .Option(_) -> next
        diagnostics.push(sema_devtools_panel_error("E1411", func.name, "state field `{field.name}` has neither an absence default nor an optional type", "give `{field.name}` a default value or declare it as `{type_name(field.ty)}?`", field.name_span))
    }
}

sema_devtools_panel_error: fn(code: String, panel: String, why: String, fix: String, span: Span) -> Diagnostic {
    sema_error(code, span, "devtools panel `{panel}` is invalid", why, fix)
}

// The struct `name` declared by a module of the caller's package.
sema_devtools_package_struct: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, name: String) -> StructDef? {
    if program.registration_graph == .Val(graph) {
        caller: sema_scope_caller_index(environment, graph) ?? return None
        package: graph.modules[caller].package_identity
        loop module_index in 0..<graph.modules.len() {
            if graph.modules[module_index].package_identity != package -> next
            loop item_index in 0..<graph.modules[module_index].program.items.len() {
                if graph.modules[module_index].program.items[item_index] == .Struct(definition) {
                    if definition.name == name -> return Val(definition.copy())
                }
            }
        }
    }
    None
}
