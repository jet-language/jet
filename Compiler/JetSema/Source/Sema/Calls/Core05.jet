        ("core.web.store", "signal" | "state_signal") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t))}, Val(signal)))
        ("core.web.store", "new") -> Val(([(AccessConvention, Type)]{(read, string), (read, t)}, Val(web_apply("WebStore", t))))
        ("core.web.store", "with_history") -> Val(([(AccessConvention, Type)]{(read, string), (read, t), (read, int)}, Val(web_apply("WebStore", t))))
        ("core.web.store", "transaction" | "update" | "batch") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t)), (read, string), (read, web_list(string)), (read, web_fn(t, unit_ty()))}, Val(web_apply("WebStoreTransaction", t))))
        ("core.web.store", "set" | "set_state") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t)), (read, t)}, Val(web_apply("WebStoreTransaction", t))))
        ("core.web.store", "optimistic" | "patch") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t)), (read, string), (read, web_list(string)), (read, web_fn(t, unit_ty()))}, Val(web_apply("WebStorePatch", t))))
        ("core.web.store", "patch_generation") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStorePatch", t))}, Val(int)))
        ("core.web.store", "patch_transaction") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStorePatch", t))}, Val(web_apply("WebStoreTransaction", t))))
        ("core.web.store", "patch_active") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStorePatch", t))}, Val(bool_)))
        ("core.web.store", "patch_commit") -> Val(([(AccessConvention, Type)]{(AccessConvention.Move, web_apply("WebStorePatch", t))}, Val(web_apply("WebStoreTransaction", t))))
        ("core.web.store", "patch_rollback") -> Val(([(AccessConvention, Type)]{(AccessConvention.Move, web_apply("WebStorePatch", t))}, Val(Type.Option{inner: t})))
        ("core.web.store", "back" | "forward" | "restore") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t))}, Val(Type.Option{inner: t})))
        ("core.web.store", "jump" | "scrub") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t)), (read, int)}, Val(Type.Option{inner: t})))
        ("core.web.store", "history") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t))}, Val(web_list(web_apply("WebStoreTransaction", t)))))
        ("core.web.store", "history_at") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t)), (read, int)}, Val(Type.Option{inner: web_apply("WebStoreTransaction", t)})))
        ("core.web.store", "events") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t))}, Val(web_list(web_named("WebStoreEvent")))))
        ("core.web.store", "events_since") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t)), (read, int)}, Val(web_list(web_named("WebStoreEvent")))))
        ("core.web.store", "clear_history" | "set_history_limit") -> {
            params :: if name == "clear_history" -> [(AccessConvention, Type)]{(read, web_apply("WebStore", t))} else -> [(AccessConvention, Type)]{(read, web_apply("WebStore", t)), (read, int)}
            Val((params, Val(unit_ty())))
        }
        ("core.web.store", "history_enabled") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t))}, Val(bool_)))
        ("core.web.store", "history_limit" | "cursor" | "current_generation") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t))}, Val(int)))
        ("core.web.store", "subscribe") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t)), (read, web_fn(t, unit_ty()))}, Val(web_named("WebStoreSubscription"))))
        ("core.web.store", "subscription_unsubscribe") -> Val(([(AccessConvention, Type)]{(read, web_named("WebStoreSubscription"))}, Val(unit_ty())))
        ("core.web.store", "subscription_active") -> Val(([(AccessConvention, Type)]{(read, web_named("WebStoreSubscription"))}, Val(bool_)))
        ("core.web.store", "subscribe_selector") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t)), (read, web_fn(t, web_named("U"))), (read, web_fn(web_named("U"), unit_ty()))}, Val(web_named("WebStoreSubscription"))))
        ("core.web.store", "derived" | "selector") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t)), (read, web_fn(t, web_named("U")))}, Val(web_apply("Derived", web_named("U")))))
        ("core.web.store", "inspect") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t))}, Val(web_named("WebStoreInspection"))))
        ("core.web.store", "facts_json" | "event_json") -> Val(([(AccessConvention, Type)]{(read, web_apply("WebStore", t))}, Val(string)))
        else -> None
    }
}
