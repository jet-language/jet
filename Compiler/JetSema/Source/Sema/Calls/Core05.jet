use jet_foundation.[AccessConvention, Type, TypeTupleField, core_call]

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:12
// Polymorphic specials receive resolved_ret from inference, not a fixed row.
pub fn is_polymorphic_core_special(module: String, name: String) -> Bool Never! {
    if (module, name) == {
        ("core.prelude", "keep") | ("core.testing", "histories") -> true
        ("core.math", "abs" | "min" | "max" | "clamp" | "sqrt" | "floor" | "ceil" | "pow"
            | "sin" | "cos" | "tan" | "asin" | "acos" | "atan" | "atan2" | "sinh" | "cosh" | "tanh"
            | "exp" | "ln" | "log2" | "log10" | "hypot" | "trunc" | "truncate" | "fract" | "real" | "imag"
            | "conj" | "float32" | "float64" | "sign" | "is_nan" | "is_inf" | "is_finite" | "to_bits"
            | "from_bits" | "degrees" | "radians" | "lerp" | "checked_add" | "checked_sub" | "checked_mul"
            | "checked_pow" | "saturating_add" | "saturating_sub" | "saturating_mul" | "int_pow" | "gcd" | "lcm"
            | "acosh" | "asinh" | "atanh" | "cbrt" | "copysign" | "exp2" | "exp_m1" | "ln_1p" | "log"
            | "signum" | "fma" | "muladd" | "is_even" | "is_odd" | "isqrt" | "factorial" | "checked_abs"
            | "checked_neg" | "checked_div" | "checked_rem" | "is_normal" | "is_subnormal" | "is_canonical"
            | "is_signed" | "is_zero" | "is_integer" | "sign_bit" | "leading_ones" | "trailing_ones" | "next_up"
            | "next_down" | "next_after" | "nextafter" | "sin_cos" | "binomial" | "cmp" | "copy" | "cot"
            | "div_mod" | "div_rem" | "erf" | "erfc" | "frexp" | "gamma" | "lgamma" | "ilogb" | "inv"
            | "ldexp" | "logb" | "modf" | "radix" | "significand" | "ulp" | "zero" | "scaleb" | "digits") -> true
        ("core.text.fmt", "pretty" | "decimal" | "grouped") -> true
        ("core.math.random", "pick" | "weighted_pick" | "sample" | "shuffle") -> true
        ("core.term", "eprint" | "print" | "progress") -> true
        // Arity selects Int versus Int !TextError; fixed rows cannot express both.
        ("core.text", "display_width") -> true
        ("core.encoding.json" | "core.encoding.csv" | "core.encoding.toml" | "core.encoding.yaml", "to_string" | "to_string_pretty" | "decode") -> true
        ("core.sys" | "core.db", "decode") | ("core.encoding.csv", "query") -> true
        ("core.encoding.cbor", "parse" | "decode" | "to_bytes" | "to_bytes_canonical") -> true
        ("core.encoding.xml", "decode" | "decode_bytes" | "expanded_name") -> true
        ("core.reactive", "signal" | "derived") | ("core.tasks", "after") -> true
        ("core.data", "csv" | "json" | "csv_reader" | "json_reader" | "count" | "schema" | "plot" | "load" | "load_default"
            | "file" | "file_member" | "url" | "database" | "value" | "snapshot" | "inner_join" | "left_join" | "pivot_sum" | "query" | "track") -> true
        ("core.data.plot", "plot" | "inspect" | "inspect_json" | "text" | "svg" | "show" | "render") -> true
        ("core.crypto.vault", "current" | "versions" | "load" | "status" | "prepare_generate" | "prepare_store" | "prepare_rotate"
            | "prepare_retire" | "prepare_revoke" | "authorize_write" | "commit_generate" | "commit_store" | "commit_rotate"
            | "commit_retire" | "commit_revoke" | "export_to_recipients" | "export_to_passphrase" | "prepare_import_wrapped"
            | "authorize_wrapped_import" | "commit_import_wrapped") -> true
        ("core.compute", "gradient" | "value_and_gradient" | "vjp" | "jvp") -> true
        ("core.web.table", "new" | "new_keyed" | "column" | "with_column" | "with_server_page" | "state" | "facts" | "keys"
            | "page_state" | "sort" | "filter" | "page" | "sort_by" | "filter_by" | "paginate" | "set_rows" | "set_selected"
            | "toggle_selection" | "clear_selection" | "focus" | "clear_focus" | "focused_key" | "selected_keys" | "selected_rows"
            | "insert_row" | "replace_row" | "update_row" | "remove_row" | "first_page" | "next_page" | "last_page" | "visible_rows") -> true
        ("core.web.virtual", "window" | "window_measured" | "slice" | "indices" | "plan" | "plan_measured" | "plan_from_sizes"
            | "plan_indices" | "plan_slice" | "plan_viewport" | "plan_measure" | "plan_viewport_state" | "plan_scroll_to"
            | "plan_resize" | "plan_viewport_measure" | "plan_facts") -> true
        ("core.web.store", "new" | "with_history" | "value" | "transaction" | "update" | "batch" | "set" | "set_state" | "optimistic"
            | "patch" | "patch_active" | "patch_commit" | "patch_generation" | "patch_rollback" | "patch_transaction" | "back" | "forward"
            | "jump" | "scrub" | "restore" | "history" | "history_at" | "events" | "events_since" | "clear_history" | "history_enabled"
            | "history_limit" | "set_history_limit" | "cursor" | "current_generation" | "subscribe" | "subscribe_selector"
            | "subscription_active" | "subscription_unsubscribe" | "derived" | "selector" | "inspect" | "facts_json" | "event_json") -> true
        else -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:207
pub fn core_fixed_sig(module: String, name: String) -> ([(AccessConvention, Type)], Type?)? Never! {
    if is_polymorphic_core_special(module, name) -> return None
    core_fixed_sig_impl(module, name)
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:224
// Registered projection is authoritative; the fixed default is secondary.
pub fn core_call_signature(module: String, name: String) -> ([(AccessConvention, Type)], Type?)? Never! {
    if core_call(module, name) == .Val(row) {
        if core_fixed_sig_for_row(row) == .Val(signature) -> return Val(signature)
    }
    core_fixed_sig_impl(module, name)
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:240
// Preserve unknown (outer None) separately from known no-return (inner None).
pub fn core_call_semantic_signature(module: String, name: String) -> ([(AccessConvention, Type)], Type)? Never! {
    signature :: core_call_signature(module, name) ?? return None
    Val((signature.0, signature.1 ?? unit_ty()))
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:252
pub fn core_call_surface_signature(module: String, name: String) -> ([(AccessConvention, Type)], Type?)? Never! {
    if core_call_signature(module, name) == .Val(signature) -> return Val(signature)
    read :: AccessConvention.Read
    int :: Type.Int
    float :: Type.Float
    result :: value -> Val(([(AccessConvention, Type)]{(read, Type.String)}, Val(result_ty(value, Type.String))))
    if (module, name) == {
        ("core.math", "abs") -> Val(([(AccessConvention, Type)]{(read, int)}, Val(int)))
        ("core.math", "sqrt" | "floor" | "ceil" | "sin" | "cos" | "tan" | "asin" | "acos" | "atan" | "sinh" | "cosh"
            | "tanh" | "exp" | "ln" | "log2" | "log10" | "trunc" | "truncate" | "fract" | "sign" | "real" | "imag" | "conj"
            | "float32" | "float64" | "degrees" | "radians" | "fabs" | "expm1") -> Val(([(AccessConvention, Type)]{(read, float)}, Val(float)))
        ("core.math", "round") -> Val(([(AccessConvention, Type)]{(read, float)}, Val(int)))
        ("core.math", "int_pow" | "gcd" | "lcm" | "min" | "max") -> Val(([(AccessConvention, Type)]{(read, int), (read, int)}, Val(int)))
        ("core.math", "pow" | "atan2" | "hypot" | "fmod" | "remainder") -> Val(([(AccessConvention, Type)]{(read, float), (read, float)}, Val(float)))
        ("core.math", "isclose") -> Val(([(AccessConvention, Type)]{(read, float), (read, float), (read, float), (read, float)}, Val(Type.Bool)))
        ("core.math", "dist") -> Val(([(AccessConvention, Type)]{(read, Type.List{element: float}), (read, Type.List{element: float})}, Val(float)))
        ("core.math", "comb" | "perm") -> Val(([(AccessConvention, Type)]{(read, int), (read, int)}, Val(Type.Option{inner: int})))
        ("core.math", "clamp") -> Val(([(AccessConvention, Type)]{(read, int), (read, int), (read, int)}, Val(int)))
        ("core.math", "lerp" | "muladd") -> Val(([(AccessConvention, Type)]{(read, float), (read, float), (read, float)}, Val(float)))
        ("core.math", "pi" | "e") -> Val(([(AccessConvention, Type)]{}, Val(float)))
        ("core.math", "is_nan" | "is_inf" | "is_finite" | "isnan" | "isinf" | "isfinite") -> Val(([(AccessConvention, Type)]{(read, float)}, Val(Type.Bool)))
        ("core.math", "is_even" | "is_odd") -> Val(([(AccessConvention, Type)]{(read, int)}, Val(Type.Bool)))
        ("core.math", "fsum") -> Val(([(AccessConvention, Type)]{(read, Type.List{element: float})}, Val(float)))
        ("core.math", "prod") -> Val(([(AccessConvention, Type)]{(read, Type.List{element: int})}, Val(int)))
        ("core.encoding.json" | "core.encoding.csv" | "core.encoding.toml" | "core.encoding.yaml", "parse" | "decode" | "loads") -> result(Type.String)
        ("core.encoding.hex" | "core.encoding.base64" | "core.encoding.base32", "decode" | "decode_url" | "b64decode" | "standard_b64decode"
            | "urlsafe_b64decode" | "b32decode" | "b16decode" | "a85decode" | "b85decode" | "z85decode") -> result(Type.String)
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:351
pub fn core_call_is_fallible(module: String, name: String) -> Bool Never! {
    signature :: core_call_surface_signature(module, name) ?? return false
    ret :: signature.1 ?? return false
    ret.is_fallible()
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:358
pub fn core_call_has_safe_defaults(module: String, name: String) -> Bool Never! {
    if module == "core.math" -> return true
    if (module, name) == {
        ("core.encoding.json", "parse" | "decode" | "loads") -> true
        ("core.encoding.hex" | "core.encoding.base64" | "core.encoding.base32", "decode" | "decode_url" | "b64decode" | "standard_b64decode"
            | "urlsafe_b64decode" | "b16decode" | "a85decode" | "b85decode" | "z85decode") -> true
        else -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:372
fn web_named(name: String) -> Type Never! { Type.Named{name: name} }
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:376
fn web_list(inner: Type) -> Type Never! { Type.List{element: inner} }
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:380
fn web_map_string() -> Type Never! { Type.Map{key: Type.String, key_span: None, value: Type.String} }
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:388
fn web_fn(param: Type, ret: Type) -> Type Never! {
    Type.Fn{params: [Type]{param}, ret: Val(ret), effect_bound: None, return_view_provenance: None, param_contract: None, call_metadata: None}
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:399
fn web_apply(name: String, arg: Type) -> Type Never! { Type.Apply{name: name, args: [Type]{arg}} }
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:407
fn web_result_error(ok: Type, error: String) -> Type Never! { result_ty(ok, web_named(error)) }

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:411
fn web_fixed_sig(module: String, name: String) -> ([(AccessConvention, Type)], Type?)? Never! {
    read :: AccessConvention.Read
    string :: Type.String
    int :: Type.Int
    bool_ :: Type.Bool
    t :: web_named("T")
    table :: web_apply("WebTable", t)
    table_column :: web_apply("WebTableColumn", t)
    table_page :: web_apply("WebTablePage", t)
    table_row :: web_apply("WebTableRow", t)
    table_state :: web_named("WebTableState")
    table_direction :: web_named("WebTableSortDirection")
    virtual_window :: web_named("WebVirtualWindow")
    virtual_plan :: web_named("WebVirtualPlan")
    virtual_viewport :: web_named("WebVirtualPlanViewport")
    router :: web_named("WebRouter")
    router_field :: web_named("WebRouterField")
    router_codec :: web_named("WebRouterSearchCodec")
    navigation :: web_named("WebNavigation")
    http_router :: web_named("HTTPRouter")
    query :: web_named("WebQuery")
    query_mode :: web_named("WebQueryNetworkMode")
    mutation_state :: web_named("WebMutationState")
    query_mutation :: web_fn(string, string)
    query_replay :: web_fn(string, unit_ty())
    form_action_error :: web_named("WebFormActionError")
    signal :: string
    form :: web_named("WebForm")
    form_input :: web_named("WebFormInput")
    form_field :: web_named("WebFormFieldSpec")
    form_typed :: web_named("WebFormTyped")
    form_chain :: web_named("WebFormValidationChain")
    form_decoded :: web_named("WebFormDecodedInput")
    form_errors :: web_named("WebFormErrorState")
    form_lifecycle :: web_named("WebFormLifecycle")
    form_validation :: web_named("WebFormValidation")
    form_timing :: web_named("WebFormValidationTiming")
    form_validator :: web_fn(string, unit_ty())
    form_submission :: web_named("WebFormTypedSubmission")
    form_field_state :: web_named("WebFormFieldState")
    if (module, name) == {
        ("core.data.sketch", "empty") -> Val(([(AccessConvention, Type)]{}, Val(string)))
        ("core.data.sketch", "merge") -> Val(([(AccessConvention, Type)]{(read, string), (read, string)}, Val(string)))
        ("core.web.storage", "local" | "session") -> Val(([(AccessConvention, Type)]{}, Val(web_named("WebStorage"))))
        ("core.web.storage", "kind_local" | "kind_session") -> Val(([(AccessConvention, Type)]{}, Val(string)))
        // Derived form input and stable action replace the source model/handler.
        ("core.web", "openapi") -> Val(([(AccessConvention, Type)]{(read, http_router)}, Val(string)))
        ("core.web", "form") -> Val(([(AccessConvention, Type)]{(read, form_input), (read, string)}, Val(form_typed)))
        ("core.web.router", "route") -> Val(([(AccessConvention, Type)]{(read, router), (read, string), (read, web_list(router_field)), (read, web_list(router_field)), (read, web_fn(navigation, string))}, Val(web_result_error(router, "WebRouterError"))))
        ("core.web.router", "route_with_search_codec") -> Val(([(AccessConvention, Type)]{(read, router), (read, string), (read, web_list(router_field)), (read, web_list(router_field)), (read, router_codec), (read, web_fn(navigation, string))}, Val(web_result_error(router, "WebRouterError"))))
        ("core.web.router", "not_found") -> Val(([(AccessConvention, Type)]{(read, router), (read, web_fn(string, string))}, Val(web_result_error(router, "WebRouterError"))))
        ("core.web.router", "navigate" | "preload") -> Val(([(AccessConvention, Type)]{(read, router), (read, string)}, Val(web_result_error(navigation, "WebRouterError"))))
        ("core.web.router", "abort") -> Val(([(AccessConvention, Type)]{(read, router)}, Val(bool_)))
        ("core.web.router", "stale" | "invalidate" | "collect") -> Val(([(AccessConvention, Type)]{(read, router), (read, string)}, Val(int)))
        ("core.web.router", "cache_state") -> Val(([(AccessConvention, Type)]{(read, router), (read, string)}, Val(web_named("WebRouterCacheStatus"))))
        ("core.web.router", "cache_show" | "show") -> Val(([(AccessConvention, Type)]{(read, router)}, Val(string)))
        ("core.web.router", "current") -> Val(([(AccessConvention, Type)]{(read, router)}, Val(web_named("WebNavigationState"))))
        ("core.web.router", "link") -> Val(([(AccessConvention, Type)]{(read, router), (read, string), (read, web_map_string()), (read, web_map_string())}, Val(web_result_error(string, "WebRouterError"))))
        ("core.web.query", "new") -> Val(([(AccessConvention, Type)]{(read, string), (read, web_named("LiveQuery"))}, Val(query)))
        ("core.web.query", "live") -> Val(([(AccessConvention, Type)]{(read, string), (read, string), (read, string), (read, Type.Fn{params: [Type]{}, ret: Val(string), effect_bound: None, return_view_provenance: None, param_contract: None, call_metadata: None})}, Val(query)))
        ("core.web.query", "mutate") -> Val(([(AccessConvention, Type)]{(read, query), (read, string), (read, Type.Option{inner: string}), (read, query_mutation)}, Val(mutation_state)))
        ("core.web.query", "mutate_with_invalidations") -> Val(([(AccessConvention, Type)]{(read, query), (read, string), (read, Type.Option{inner: string}), (read, web_list(string)), (read, query_mutation)}, Val(mutation_state)))
        ("core.web.query", "retry") -> Val(([(AccessConvention, Type)]{(read, query), (read, query_replay)}, Val(web_result_error(int, "WebQueryError"))))
        ("core.web.query", "subscribe") -> Val(([(AccessConvention, Type)]{(read, string)}, Val(query)))
        ("core.web.query", "invalidate") -> Val(([(AccessConvention, Type)]{(read, query)}, Val(int)))
        ("core.web.query", "get" | "show" | "facts") -> Val(([(AccessConvention, Type)]{(read, query)}, Val(string)))
        ("core.web.query", "state") -> Val(([(AccessConvention, Type)]{(read, query)}, Val(web_named("WebQueryState"))))
        ("core.web.query", "state_signal") -> Val(([(AccessConvention, Type)]{(read, query)}, Val(web_apply("Signal", web_named("WebQueryState")))))
        ("core.web.query", "mutation_state") -> Val(([(AccessConvention, Type)]{(read, query)}, Val(mutation_state)))
        ("core.web.query", "mutation_signal") -> Val(([(AccessConvention, Type)]{(read, query)}, Val(web_apply("Signal", mutation_state))))
        ("core.web.query", "queue") -> Val(([(AccessConvention, Type)]{(read, query), (read, string)}, Val(web_result_error(int, "WebQueryError"))))
        ("core.web.query", "refresh") -> Val(([(AccessConvention, Type)]{(read, query)}, Val(web_result_error(unit_ty(), "WebQueryError"))))
        ("core.web.query", "cancel") -> Val(([(AccessConvention, Type)]{(read, query)}, Val(bool_)))
        ("core.web.query", "set_online") -> Val(([(AccessConvention, Type)]{(read, query), (read, bool_)}, Val(unit_ty())))
        ("core.web.query", "set_mode") -> Val(([(AccessConvention, Type)]{(read, query), (read, query_mode)}, Val(unit_ty())))
        ("core.web.forms", "new") -> Val(([(AccessConvention, Type)]{(read, string)}, Val(form)))
        ("core.web.forms", "field") -> Val(([(AccessConvention, Type)]{(read, form), (read, string), (read, string), (read, bool_)}, Val(web_result_error(form, "WebFormError"))))
        ("core.web.forms", "set") -> Val(([(AccessConvention, Type)]{(read, form), (read, string), (read, string)}, Val(web_result_error(unit_ty(), "WebFormError"))))
        ("core.web.forms", "blur") -> Val(([(AccessConvention, Type)]{(read, form), (read, string)}, Val(web_result_error(unit_ty(), "WebFormError"))))
        ("core.web.forms", "validate") -> Val(([(AccessConvention, Type)]{(read, form)}, Val(web_result_error(unit_ty(), "WebFormError"))))
        ("core.web.forms", "validate_async") -> Val(([(AccessConvention, Type)]{(read, form)}, Val(form)))
        ("core.web.forms", "submit" | "no_script") -> Val(([(AccessConvention, Type)]{(read, form)}, Val(web_result_error(string, "WebFormError"))))
        ("core.web.forms", "html" | "show") -> Val(([(AccessConvention, Type)]{(read, form)}, Val(string)))
        ("core.web.forms", "input") -> Val(([(AccessConvention, Type)]{(read, string), (read, web_list(form_field))}, Val(web_result_error(form_input, "WebFormError"))))
        ("core.web.forms", "input_rename" | "input_group") -> Val(([(AccessConvention, Type)]{(read, form_input), (read, string), (read, string)}, Val(web_result_error(form_input, "WebFormError"))))
        ("core.web.forms", "input_exclude") -> Val(([(AccessConvention, Type)]{(read, form_input), (read, string)}, Val(web_result_error(form_input, "WebFormError"))))
        ("core.web.forms", "input_replace") -> Val(([(AccessConvention, Type)]{(read, form_input), (read, string), (read, form_field)}, Val(web_result_error(form_input, "WebFormError"))))
        ("core.web.forms", "typed") -> Val(([(AccessConvention, Type)]{(read, form_input), (read, string)}, Val(web_result_error(form_typed, "WebFormError"))))
        ("core.web.forms", "typed_set") -> Val(([(AccessConvention, Type)]{(read, form_typed), (read, string), (read, string)}, Val(web_result_error(unit_ty(), "WebFormError"))))
        ("core.web.forms", "typed_set_async_validator") -> Val(([(AccessConvention, Type)]{(read, form_typed), (read, string), (read, form_timing), (read, int), (read, form_validator)}, Val(web_result_error(unit_ty(), "WebFormError"))))
        ("core.web.forms", "typed_set_action") -> Val(([(AccessConvention, Type)]{(read, form_typed), (read, web_fn(form_decoded, string))}, Val(unit_ty())))
        ("core.web.forms", "action_error") -> Val(([(AccessConvention, Type)]{}, Val(form_action_error)))
        ("core.web.forms", "action_field_error") -> Val(([(AccessConvention, Type)]{(read, form_action_error), (read, string), (read, string)}, Val(form_action_error)))
        ("core.web.forms", "action_form_error") -> Val(([(AccessConvention, Type)]{(read, form_action_error), (read, string)}, Val(form_action_error)))
        ("core.web.forms", "typed_blur") -> Val(([(AccessConvention, Type)]{(read, form_typed), (read, string)}, Val(web_result_error(unit_ty(), "WebFormError"))))
        ("core.web.forms", "typed_validate") -> Val(([(AccessConvention, Type)]{(read, form_typed)}, Val(web_result_error(unit_ty(), "WebFormError"))))
        ("core.web.forms", "typed_validate_async") -> Val(([(AccessConvention, Type)]{(read, form_typed)}, Val(form_validation)))
        ("core.web.forms", "typed_validate_field") -> Val(([(AccessConvention, Type)]{(read, form_typed), (read, string), (read, form_timing), (read, form_validator)}, Val(form_chain)))
        ("core.web.forms", "typed_validation_render") -> Val(([(AccessConvention, Type)]{(read, form_chain)}, Val(string)))
        ("core.web.forms", "typed_submit" | "typed_no_script") -> Val(([(AccessConvention, Type)]{(read, form_typed)}, Val(web_result_error(string, "WebFormError"))))
        ("core.web.forms", "typed_submit_async") -> Val(([(AccessConvention, Type)]{(read, form_typed)}, Val(form_submission)))
        ("core.web.forms", "typed_post") -> Val(([(AccessConvention, Type)]{(read, form_typed), (read, string)}, Val(web_result_error(string, "WebFormError"))))
        ("core.web.forms", "typed_decode_post") -> Val(([(AccessConvention, Type)]{(read, form_typed), (read, string)}, Val(web_result_error(form_decoded, "WebFormError"))))
        ("core.web.forms", "typed_html" | "typed_show" | "typed_state") -> Val(([(AccessConvention, Type)]{(read, form_typed)}, Val(string)))
        ("core.web.forms", "typed_lifecycle") -> Val(([(AccessConvention, Type)]{(read, form_typed)}, Val(form_lifecycle)))
        ("core.web.forms", "typed_errors") -> Val(([(AccessConvention, Type)]{(read, form_typed)}, Val(form_errors)))
        ("core.web.forms", "typed_focus") -> Val(([(AccessConvention, Type)]{(read, form_typed), (read, string)}, Val(web_result_error(unit_ty(), "WebFormError"))))
        ("core.web.forms", "typed_cancel") -> Val(([(AccessConvention, Type)]{(read, form_typed)}, Val(unit_ty())))
