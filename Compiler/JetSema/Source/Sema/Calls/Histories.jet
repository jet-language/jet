// #6410: the compiler's half of `core.testing.histories`. Source spells only
// the six public arguments; the compiler appends the hidden trailing
// arguments of Core's source `histories`: the command type name, the
// artifact provenance (`__source`, `__tool`, `__target`) and, when the call
// names no strategy (or `strategy: None`), the strategy derived from the
// command enum (`__variants`, `__make`) or the reason none can be derived
// (`__unsupported`).
//
// Provenance: `__source` is the SHA-256 of length-framed rows — a version
// tag, the digest of the calling package's module sources, then each
// callback role with the source text of its argument (`strategy` of a
// derived campaign is `derived:<Type>`). `__tool` names the history engine
// and the host's compiler identity; `__target` is the SHA-256 of the target
// triple. A missing piece stays "" and the campaign reports itself
// unavailable.
use jet_foundation.[
    AccessConvention,
    CallArg,
    CallLabel,
    Expr,
    Span,
    TTypeDef,
    TVariant,
    Type,
    type_name,
    ast_empty_call_arg_flags,
    sha256_hex,
]
use jet_parser.[
    parse_generated_source,
]

struct SemaHistoriesDerived {
    variants: [String]
    make: String
    unsupported: String
}

fn sema_call_histories_is_call(target: SemaCallDirectTarget, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    target.symbol.name == "histories" && sema_call_core_module_identity(environment, program, "core.testing") == (Val(target.symbol.module_name))
}

// The call's arguments followed by the hidden ones.
fn sema_call_histories_args(args: [CallArg], type_args: [Type], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables) -> [CallArg] Never! {
    written := ""
    if type_args.len() == 1 && type_args[0] == .Named(name) -> written = name.copy()
    command_type :: sema_serde_named_leaf(written)
    module_source := ""
    package_digest := ""
    tool := ""
    target := ""
    if program.registration_graph == .Val(graph) {
        if sema_scope_caller_index(environment, graph) == .Val(caller) {
            module_source = graph.modules[caller].source.copy()
            package_digest = sema_call_histories_package_digest(graph, graph.modules[caller].package_identity)
        }
        if graph.build_facts.compiler_identity != "" -> tool = "typed-history-v1:{graph.build_facts.compiler_identity}"
        if graph.target_machine.triple != "" -> target = sha256_hex(graph.target_machine.triple)
    }
    roles :: [String]{"actual", "model", "observe", "strategy"}
    identities := [String]{"", "", "", ""}
    has_strategy := false
    loop index in 0..<args.len() {
        label := sema_call_devtools_label(args[index])
        if label == "" -> label = sema_call_histories_position_label(index)
        loop role in 0..<roles.len() {
            if roles[role] == label -> identities[role] = sema_call_histories_span_text(module_source, args[index].span)
        }
        if label == "strategy" && !sema_call_histories_is_none(args[index].expr) -> has_strategy = true
    }
    if !has_strategy -> identities[3] = "derived:{command_type}"
    source := ""
    if package_digest != "" {
        frames := [String]{sema_call_histories_frame("jet.history.provenance.v1"), sema_call_histories_frame(package_digest)}
        loop role in 0..<roles.len() {
            if identities[role] == "" -> next
            &frames.push(sema_call_histories_frame(roles[role]))
            &frames.push(sema_call_histories_frame(identities[role]))
        }
        source = sha256_hex(frames.join(""))
    }
    // copy: the rebuilt call owns its arguments; the source call keeps its own.
    call_args := args.copy()
    &call_args.push(sema_call_devtools_text_arg("__command_type", command_type, span))
    &call_args.push(sema_call_devtools_text_arg("__source", source, span))
    &call_args.push(sema_call_devtools_text_arg("__tool", tool, span))
    &call_args.push(sema_call_devtools_text_arg("__target", target, span))
    if type_args.len() != 1 -> return call_args
    // Core's `__variants` and `__make` have no default: a default of the
    // generic `__make` type would not specialize. An explicit strategy, or a
    // command type with no derived strategy, passes both empty.
    variants_text := "[String]{{}}"
    make_text := "[fn(Int, [Int], [Bool], [String]) -> {type_name(type_args[0])} Never!]{{}}"
    if !has_strategy {
        derived :: sema_call_histories_derive(written, command_type, environment, program)
        if derived.unsupported != "" {
            &call_args.push(sema_call_devtools_text_arg("__unsupported", derived.unsupported, span))
        } else {
            rows := [String]{}
            loop row in derived.variants -> &rows.push("\"{row}\"")
            variants_text = "[String]{{{rows.join(", ")}}}"
            make_text = derived.make.copy()
        }
    }
    variants :: sema_call_histories_parse_expr(variants_text, span.start) ?? return call_args
    make :: sema_call_histories_parse_expr(make_text, span.start + 1) ?? return call_args
    &call_args.push(sema_call_histories_expr_arg("__variants", variants, span))
    &call_args.push(sema_call_histories_expr_arg("__make", make, span))
    call_args
}

// `strategy: None` asks for the derived strategy, as an omitted strategy does.
fn sema_call_histories_is_none(expr: Expr) -> Bool Never! {
    if expr == .EnumLit(type_name, variant, _, args, _, _, _) -> return type_name == "" && variant == "None" && args.len() == 0
    false
}

fn sema_call_histories_position_label(index: Int) -> String Never! {
    labels :: [String]{"seed", "cases", "strategy", "model", "actual", "observe"}
    if index < labels.len() -> return labels[index]
    ""
}

fn sema_call_histories_frame(value: String) -> String Never! { "{value.len()}:{value}" }

fn sema_call_histories_span_text(source: String, span: Span) -> String Never! {
    if span.start < 0 || span.end > source.len() || span.start >= span.end -> return ""
    source.slice(span.start, span.end)
}

// The digest of every module source of the package, in load order.
fn sema_call_histories_package_digest(graph: SemaRegistrationGraph, package_identity: String) -> String Never! {
    frames := [String]{}
    loop index in 0..<graph.modules.len() {
        if graph.modules[index].package_identity != package_identity || graph.modules[index].source == "" -> next
        &frames.push(sema_call_histories_frame(graph.modules[index].module_identity))
        &frames.push(sema_call_histories_frame(graph.modules[index].source))
    }
    if frames.len() == 0 -> return ""
    sha256_hex(frames.join(""))
}

fn sema_call_histories_expr_arg(label: String, expr: Expr, span: Span) -> CallArg Never! {
    CallArg{convention: AccessConvention.Read, expr: expr, span: span, flags: ast_empty_call_arg_flags(), label: Val(CallLabel{name: label, span: span}), spread: false}
}

// The expression a one-statement function body holds. The text is compiler-
// generated and spells reserved `__` names, so it parses as generated source.
// The parser numbers a unit's nodes from its first byte, so the text is
// padded to begin at `start`, a byte inside the call's name: no top-level
// unit of the caller's file begins there, and the two generated arguments
// take distinct starts, so every generated node id is unique in the file.
fn sema_call_histories_parse_expr(text: String, start: Int) -> Expr? Never! {
    bytes := [U8]{}
    loop _ in 0..<start -> &bytes.push(32)
    loop byte in "fn __jet_history_value() {{\n    {text}\n}}\n".bytes() -> &bytes.push(byte)
    parsed :: parse_generated_source(bytes)
    if parsed.diagnostics.len() > 0 || parsed.program.items.len() != 1 -> return None
    if parsed.program.items[0] == .Func(function) {
        if function.body.len() != 1 -> return None
        if function.body[0] == .Expr(expr) -> return Val(expr.copy())
    }
    None
}

fn sema_call_histories_unsupported(reason: String) -> SemaHistoriesDerived Never! {
    SemaHistoriesDerived{variants: [String]{}, make: "", unsupported: reason}
}

// The derived strategy of an ordinary enum whose variant payloads are `Int`,
// `Bool` or `String` values: one `name:kinds` row per variant (its wire name,
// then `i`, `b` or `s` per payload field) and the source of the lambda that
// builds a command from a row position and its payload values.
fn sema_call_histories_derive(written: String, command_type: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> SemaHistoriesDerived Never! {
    no_schema :: "core.testing.histories command type `{command_type}` has no checked enum schema"
    if written == "" -> return sema_call_histories_unsupported(no_schema)
    definition :: sema_serde_type_definition(environment, program, written) ?? return sema_call_histories_unsupported(no_schema)
    if definition.generic_params.len() > 0 -> return sema_call_histories_unsupported(no_schema)
    variants :: sema_call_histories_enum_variants(definition) ?? return sema_call_histories_unsupported(no_schema)
    if variants.len() == 0 -> return sema_call_histories_unsupported(no_schema)
    rows := [String]{}
    arms := [String]{}
    loop position in 0..<variants.len() {
        variant :: variants[position]
        unsupported :: sema_call_histories_unsupported("core.testing.histories command type `{command_type}` has unsupported variant `{variant.name}`: no type-valid scalar generator/codec")
        if variant.wire_name == "" || variant.wire_name.contains(":") || variant.wire_name.contains("\"") || variant.wire_name.contains("\\") || variant.wire_name.contains("{") || variant.wire_name.contains("}") -> return unsupported
        kinds := [String]{}
        values := [String]{}
        counts := [Int]{0, 0, 0}
        fields := [Type]{}
        names := [String]{}
        if variant.payload == {
            .Unit -> {}
            .Single(ty) -> &fields.push(ty.copy())
            .Named(declared) -> {
                loop field in declared {
                    &fields.push(field.ty.copy())
                    &names.push(field.name.copy())
                }
            }
        }
        loop field in fields {
            kind :: sema_call_histories_kind(field)
            if kind < 0 -> return unsupported
            &kinds.push([String]{"i", "b", "s"}[kind])
            &values.push("{[String]{"__ints", "__bools", "__texts"}[kind]}[{counts[kind]}]")
            counts[kind] = counts[kind] + 1
        }
        &rows.push(if kinds.len() == 0 -> variant.wire_name.copy() else -> "{variant.wire_name}:{kinds.join(":")}")
        constructor := "{written}.{variant.name}"
        if variant.payload == {
            .Unit -> {}
            .Single(_) -> constructor = "{constructor}({values[0]})"
            .Named(_) -> {
                labelled := [String]{}
                loop index in 0..<names.len() -> &labelled.push("{names[index]}: {values[index]}")
                constructor = "{constructor}{{{labelled.join(", ")}}}"
            }
        }
        &arms.push(constructor)
    }
    body := arms[arms.len() - 1]
    if arms.len() > 1 {
        cases := [String]{}
        loop index in 0..<(arms.len() - 1) -> &cases.push("        {index} -> {arms[index]}\n")
        body = "if __variant == {{\n{cases.join("")}        else -> {arms[arms.len() - 1]}\n    }}"
    }
    make :: "[(__variant: Int, __ints: [Int], __bools: [Bool], __texts: [String]) -> {{\n    {body}\n}}]"
    SemaHistoriesDerived{variants: rows, make: make, unsupported: ""}
}

fn sema_call_histories_enum_variants(definition: TTypeDef) -> [TVariant]? Never! {
    if definition.kind == .Enum(rows, _) -> return Val(rows.copy())
    None
}

// 0 for `Int`, 1 for `Bool`, 2 for `String`, -1 for a payload the derived
// strategy cannot generate.
fn sema_call_histories_kind(ty: Type) -> Int Never! {
    if ty == {
        .Int -> 0
        .Bool -> 1
        .String -> 2
        .Named(name) -> if name == "Int" -> 0 else -> if name == "Bool" -> 1 else -> if name == "String" -> 2 else -> -1
        else -> -1
    }
}
