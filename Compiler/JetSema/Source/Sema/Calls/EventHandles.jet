// Source producer for the Event family's handle methods: Event, Hook,
// DecisionHook, AsyncEvent and their Subscription, EventScope, EventTrace and
// DispatchReport handles. A handler is a retained `Fn(T)` callback; every
// method borrows its receiver.
use jet_foundation.[
    BodyHandleOp,
    AccessConvention,
    CallArg,
    Diagnostic,
    Expr,
    ParamZone,
    Span,
    Type,
]

sema_event_unit: fn() -> Type Never! { Type.Named{name: "Unit"} }

// The handle family a receiver type is named for: `Event<T>`, `Hook<T, R>`,
// `DecisionHook<T, E>`, `AsyncEvent<T, E>`, `DispatchReport<E>`,
// `EventScope`, `Subscription`, `EventTrace`; None for any other type (a
// non-generic `Event` included).
sema_event_handle_family: fn(ty: Type) -> String? {
    if ty == {
        .Apply(name, args) -> if name == {
            "Event" | "DispatchReport" | "FfiCallbackEvent" -> if args.len() == 1 -> Val(name) else -> None
            "Hook" | "DecisionHook" | "AsyncEvent" -> if args.len() == 2 -> Val(name) else -> None
            else -> None
        }
        .Named(name) -> if name == "EventScope" || name == "Subscription" || name == "EventTrace" -> Val(name) else -> None
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// The built-in handle family of a receiver: a nominal of the same name that
// the caller's module declares or imports shadows it, as a user
// `Sender`/`Receiver` shadows the channel endpoints (Calls/Core.jet
// `sema_builtin_handle_is_canonical`). A same-named nominal of another module
// (a user module's or `core.compiler.Event`) is another type, keyed by its
// owner path: a bare handle name, one of SYMBOL_BUILTIN_TYPES, never resolves
// to it only because its module is loaded (TypeRelations.jet
// `sema_type_graph_unique_type_owner`).
sema_event_handle_owner: fn(ty: Type, check: SemaBodyCheck) -> String? {
    owner: sema_event_handle_family(ty) ?? return None
    graph: check.program.registration_graph
    if sema_type_resolve_nominal_row(graph, ty, check.environment.module_identity) != None {
        return None
    }
    Val(owner)
}

// Arity of a known method on `owner`, or None when `owner` has no such method.
sema_event_method_arity: fn(owner: String, method: String) -> Int? Never! {
    if owner == "Event" || owner == "Hook" || owner == "DecisionHook" || owner == "AsyncEvent" {
        if method == "on" || method == "once" -> return Val(2)
        if method == "on_priority" -> return Val(3)
        if method == "listener_count" -> return Val(0)
    }
    if owner == "Event" {
        if method == "emit" -> return Val(1)
        if method == "trace" -> return Val(0)
        return None
    }
    if owner == "Hook" {
        if method == "run" -> return Val(2)
        if method == "trace" -> return Val(0)
        return None
    }
    if owner == "DecisionHook" {
        if method == "run" -> return Val(1)
        return None
    }
    if owner == "AsyncEvent" {
        if method == "emit_async" -> return Val(1)
        if method == "close" || method == "queued_count" || method == "running_count" || method == "blocked_count" -> return Val(0)
        return None
    }
    if owner == "DispatchReport" {
        if method == "state" || method == "accepted" || method == "delivered_handlers" || method == "failures" || method == "trace" -> return Val(0)
        return None
    }
    if owner == "EventScope" {
        if method == "cancel" || method == "active_count" -> return Val(0)
        return None
    }
    if owner == "Subscription" {
        if method == "unsubscribe" || method == "is_active" -> return Val(0)
        return None
    }
    if owner == "EventTrace" {
        if method == "summary" || method == "delivered" || method == "queued" || method == "dropped" -> return Val(0)
        return None
    }
    if owner == "FfiCallbackEvent" {
        if method == "stop" -> return Val(0)
        return None
    }
    None
}

// Result type of a known method over the receiver's owned type arguments
// `args` (checked by sema_event_handle_family).
sema_event_method_result: fn(owner: String, method: String, args: ^^[Type]) -> Type Never! {
    ^owned_args: args.move()
    if owner == "Event" || owner == "Hook" || owner == "DecisionHook" || owner == "AsyncEvent" {
        if method == "on" || method == "once" || method == "on_priority" -> return Type.Named{name: "Subscription"}
        if method == "listener_count" -> return Type.Int
    }
    if owner == "Event" {
        if method == "emit" -> return Type.Named{name: "EventTrace"}
        return Type.String
    }
    if owner == "Hook" {
        if method == "run" -> return owned_args.pop() ?? sema_event_unit()
        return Type.String
    }
    if owner == "DecisionHook" {
        return Type.Apply{name: "HookOutcome", args: owned_args.move()}
    }
    if owner == "AsyncEvent" {
        if method == "emit_async" {
            err_ty: owned_args.pop() ?? sema_event_unit()
            report: Type.Apply{name: "DispatchReport", args: [Type]{err_ty}}
            return Type.Apply{name: "Task", args: [Type]{report}}
        }
        if method == "close" -> return sema_event_unit()
        return Type.Int
    }
    if owner == "DispatchReport" {
        if method == "state" -> return Type.Named{name: "DispatchState"}
        if method == "accepted" -> return Type.Bool
        if method == "delivered_handlers" -> return Type.Int
        if method == "failures" {
            return Type.List{element: Type.Apply{name: "DispatchFailure", args: owned_args.move()}}
        }
        return Type.Named{name: "EventTrace"}
    }
    if owner == "EventScope" {
        if method == "cancel" -> return sema_event_unit()
        return Type.Int
    }
    if owner == "Subscription" {
        if method == "unsubscribe" -> return sema_event_unit()
        return Type.Bool
    }
    if owner == "EventTrace" {
        if method == "summary" -> return Type.String
        return Type.Int
    }
    sema_event_unit()
}

sema_event_parameter: fn(name: String, ty: Type, convention: AccessConvention) -> SemaCallParam Never! {
    SemaCallParam{label: "", name: name, zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: convention, ty: Val(ty), variadic: false}
}

// The non-handler parameters: scope (and priority) of a registration, the
// moved payload of an emit or a run, and a Hook run's moved fallback.
sema_event_value_parameters: fn(owner: String, method: String, args: [Type]) -> [SemaCallParam] Never! {
    ^params: [SemaCallParam]{}
    if method == "on" || method == "once" || method == "on_priority" {
        params.push(sema_event_parameter("scope", Type.Named{name: "EventScope"}, AccessConvention.Read))
    }
    if method == "on_priority" {
        params.push(sema_event_parameter("priority", Type.Int, AccessConvention.Read))
    }
    if method == "emit" || method == "emit_async" || method == "run" {
        params.push(sema_event_parameter("payload", args[0], AccessConvention.Move))
    }
    if owner == "Hook" && method == "run" {
        params.push(sema_event_parameter("fallback", args[1], AccessConvention.Move))
    }
    params
}

// The handler type of each event owner, with one payload parameter:
// `fn(T)` (Event), `fn(T) -> R` (Hook), `fn(T) -> HookDecision<T, E>`
// (DecisionHook), and `fn(T) -> R` for AsyncEvent, where a handler returns
// through a `Result<Unit, E>` carrier, so a unit body is its Ok.
sema_event_handler_type: fn(owner: String, args: ^^[Type]) -> Type Never! {
    ^owned_args: args.move()
    if owner == "DecisionHook" {
        payload: owned_args[0]
        ret: Type.Apply{name: "HookDecision", args: owned_args.move()}
        return Type.Fn{params: [Type]{payload}, ret: Val(ret), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    }
    owned_args.reverse()
    payload: owned_args.pop() ?? sema_event_unit()
    ret: if owner == {
        "Hook" -> owned_args.pop() ?? sema_event_unit()
        "AsyncEvent" -> Type.Result{ok: sema_event_unit(), err: owned_args.pop() ?? sema_event_unit()}
        else -> sema_event_unit()
    }
    Type.Fn{params: [Type]{payload}, ret: Val(ret), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
}

// The provider route a checked method lowers through (JetIR BuildEvents.jet
// ir_event_method): the family's runtime type and the method, whose
// `is_active` the Subscription provider spells `active`.
sema_event_route_symbol: fn(owner: String, method: String) -> String Never! {
    member: if owner == "Subscription" && method == "is_active" -> "active" else -> method
    "jet_std.Jet{owner}.{member}"
}

sema_call_try_event_handle_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    receiver_type: sema_call_resolved_type(receiver_value.ty, check.environment.*, check.program.*)
    owner: sema_event_handle_owner(receiver_type, check) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    ^type_args: [Type]{}
    if receiver_type == .Apply(_, receiver_args) {
        loop arg in receiver_args {
            type_args.push(sema_call_resolved_type(arg, check.environment.*, check.program.*))
        }
    }
    arity: sema_event_method_arity(owner, method) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    callee: "{owner}.{method}"
    if args.len() != arity {
        ^_: sema_reactive_infer_args(args, check)
        check.diagnostics.push(sema_call_arity_diagnostic(callee, arity, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    registers: method == "on" || method == "once" || method == "on_priority"
    params: sema_event_value_parameters(owner, method, type_args)
    ^checked_args: [CallArg]{}
    loop index in 0..<params.len() -> checked_args.push(args[index])
    binding: sema_call_bind_args(callee, params, checked_args, span, check.diagnostics) ?? {
        ^_: sema_reactive_infer_args(args, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    typed: sema_call_typecheck_bound_arguments(callee, params, None, false, binding, checked_args, check, span, true) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    ^ownership: sema_ownership_check_method_call(check, callee, receiver, AccessConvention.Read, params, checked_args, span)
    if !ownership.accepted || !ownership.complete {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    ^values: typed.values
    result_type: if registers -> {
        handler: sema_expression_lambda_host_callback_stored(args[args.len() - 1].expr, Val(sema_event_handler_type(owner, type_args.move())), false, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        values.push(handler)
        Type.Named{name: "Subscription"}
    } else -> sema_event_method_result(owner, method, type_args.move())
    ^value: sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: BodyHandleOp.EventMethod{symbol: sema_event_route_symbol(owner, method)}, args: values}, span)
    checked: sema_expression_call_expected(value, expected, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}
