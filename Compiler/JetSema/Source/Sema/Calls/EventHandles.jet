// Source producer for the Event family's handle methods: Event, Hook,
// DecisionHook, AsyncEvent and their Subscription, EventScope, EventTrace and
// DispatchReport handles. One meaning with the Rust checker's method table
// (event_method_return, subscription_method_return, event_scope_method_return,
// event_trace_method_return) and the Rust reference provider (JetHook,
// JetDecisionHook, JetAsyncEvent). A handler is a retained `Fn(T)` callback;
// every method borrows its receiver.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    Expr,
    ParamZone,
    Span,
    Type,
]

sema_event_unit: fn() -> Type Never! {
    Type.Named{name: "Unit"}
}

// The handle family a receiver type is named for: `Event<T>`, `Hook<T, R>`,
// `DecisionHook<T, E>`, `AsyncEvent<T, E>`, `DispatchReport<E>`,
// `EventScope`, `Subscription`, `EventTrace`; None for any other type (a
// non-generic `Event` included).
sema_event_handle_family: fn(ty: Type) -> String? {
    if ty == {
        .Apply(name, args) -> {
            if name == {
                "Event" | "DispatchReport" -> if args.len() == 1 -> Val(name) else -> None
                "Hook" | "DecisionHook" | "AsyncEvent" -> if args.len() == 2 -> Val(name) else -> None
                else -> None
            }
        }
        .Named(name) -> if name == "EventScope" || name == "Subscription" || name == "EventTrace" -> Val(name) else -> None
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// The built-in handle family of a receiver. These are compiler-known types
// with no source declaration (the lowering's `lower_event_repr` guard): a
// visible user nominal of the same name shadows them, as a user
// `Sender`/`Receiver` shadows the channel endpoints (StreamHandles.jet
// `sema_stream_handle_is_canonical`).
sema_event_handle_owner: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> String? {
    owner: sema_event_handle_family(ty) ?? return None
    if program.registration_graph == .Val(graph) {
        if sema_type_resolve_nominal_row(graph, ty, environment.module_identity) != None -> return None
    }
    Val(owner)
}

// (arity, result) of a known method over the receiver's type arguments
// `args` (checked by sema_event_handle_family), or None.
sema_event_method_shape: fn(owner: String, method: String, args: [Type]) -> (arity: Int, result: Type)? {
    subscription: Type.Named{name: "Subscription"}
    if owner == "Event" || owner == "Hook" || owner == "DecisionHook" || owner == "AsyncEvent" {
        if method == "on" || method == "once" -> return Val((arity: 2, result: subscription))
        if method == "on_priority" -> return Val((arity: 3, result: subscription))
        if method == "listener_count" -> return Val((arity: 0, result: Type.Int))
    }
    if owner == "Event" {
        if method == "emit" -> return Val((arity: 1, result: Type.Named{name: "EventTrace"}))
        if method == "trace" -> return Val((arity: 0, result: Type.String))
        return None
    }
    if owner == "Hook" {
        if method == "run" -> return Val((arity: 2, result: args[1].copy()))
        if method == "trace" -> return Val((arity: 0, result: Type.String))
        return None
    }
    if owner == "DecisionHook" {
        if method == "run" -> return Val((arity: 1, result: Type.Apply{name: "HookOutcome", args: args.copy()}))
        return None
    }
    if owner == "AsyncEvent" {
        report: Type.Apply{name: "DispatchReport", args: [Type]{args[1].copy()}}
        if method == "emit_async" -> return Val((arity: 1, result: Type.Apply{name: "Task", args: [Type]{report}}))
        if method == "close" -> return Val((arity: 0, result: sema_event_unit()))
        if method == "queued_count" || method == "running_count" || method == "blocked_count" -> return Val((arity: 0, result: Type.Int))
        return None
    }
    if owner == "DispatchReport" {
        if method == "state" -> return Val((arity: 0, result: Type.Named{name: "DispatchState"}))
        if method == "accepted" -> return Val((arity: 0, result: Type.Bool))
        if method == "delivered_handlers" -> return Val((arity: 0, result: Type.Int))
        if method == "failures" -> return Val((arity: 0, result: Type.List{element: Type.Apply{name: "DispatchFailure", args: args.copy()}}))
        if method == "trace" -> return Val((arity: 0, result: Type.Named{name: "EventTrace"}))
        return None
    }
    if owner == "EventScope" {
        if method == "cancel" -> return Val((arity: 0, result: sema_event_unit()))
        if method == "active_count" -> return Val((arity: 0, result: Type.Int))
        return None
    }
    if owner == "Subscription" {
        if method == "unsubscribe" -> return Val((arity: 0, result: sema_event_unit()))
        if method == "is_active" -> return Val((arity: 0, result: Type.Bool))
        return None
    }
    if owner == "EventTrace" {
        if method == "summary" -> return Val((arity: 0, result: Type.String))
        if method == "delivered" || method == "queued" || method == "dropped" -> return Val((arity: 0, result: Type.Int))
        return None
    }
    None
}

sema_event_parameter: fn(name: String, ty: Type, convention: AccessConvention) -> SemaCallParam Never! {
    SemaCallParam{label: "", name: name, zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: convention, ty: Val(ty), variadic: false}
}

// The non-handler parameters: scope (and priority) of a registration, the
// moved payload of an emit or a run, and a Hook run's moved fallback.
sema_event_value_parameters: fn(owner: String, method: String, args: [Type]) -> [SemaCallParam] Never! {
    params := [SemaCallParam]{}
    if method == "on" || method == "once" || method == "on_priority" -> params.push(sema_event_parameter("scope", Type.Named{name: "EventScope"}, AccessConvention.Read))
    if method == "on_priority" -> params.push(sema_event_parameter("priority", Type.Int, AccessConvention.Read))
    if method == "emit" || method == "emit_async" || method == "run" -> params.push(sema_event_parameter("payload", args[0].copy(), AccessConvention.Move))
    if owner == "Hook" && method == "run" -> params.push(sema_event_parameter("fallback", args[1].copy(), AccessConvention.Move))
    params
}

// Rust `F: Fn(T) + 'static` (Event), `Fn(T) -> R` (Hook),
// `Fn(T) -> HookDecision<T, E>` (DecisionHook), `Fn(T) -> R` with
// `R: JetIntoDispatchResult<E>` (AsyncEvent: a handler returns through a
// `Result<Unit, E>` carrier, so a unit body is its Ok): one payload
// parameter.
sema_event_handler_type: fn(owner: String, args: [Type]) -> Type Never! {
    ret: if owner == {
        "Hook" -> args[1].copy()
        "DecisionHook" -> Type.Apply{name: "HookDecision", args: args.copy()}
        "AsyncEvent" -> Type.Result{ok: sema_event_unit(), err: args[1].copy()}
        else -> sema_event_unit()
    }
    Type.Fn{params: [Type]{args[0].copy()}, ret: Val(ret), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
}

sema_call_try_event_handle_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    receiver_type: sema_call_resolved_type(receiver_value.ty, environment, program)
    owner: sema_event_handle_owner(receiver_type, environment, program) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    type_args := [Type]{}
    if receiver_type == .Apply(_, receiver_args) {
        loop arg in receiver_args -> type_args.push(sema_call_resolved_type(arg, environment, program))
    }
    shape: sema_event_method_shape(owner, method, type_args) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    callee: "{owner}.{method}"
    if args.len() != shape.arity {
        _ := sema_reactive_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        diagnostics.push(sema_call_arity_diagnostic(callee, shape.arity, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    registers: method == "on" || method == "once" || method == "on_priority"
    params: sema_event_value_parameters(owner, method, type_args)
    checked_args := [CallArg]{}
    loop index in 0..<params.len() -> checked_args.push(args[index])
    binding: sema_call_bind_args(callee, params, checked_args, span, diagnostics) ?? {
        _ := sema_reactive_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    typed: sema_call_typecheck_bound_arguments(callee, params, None, false, binding, checked_args, environment, program, scopes, state, tail_store, context, span, diagnostics, true) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    ownership := sema_ownership_check_method_call(state, callee, receiver, AccessConvention.Read, params, checked_args, scopes, span, diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    values := typed.values
    if registers {
        handler: sema_expression_lambda_host_callback_stored(args[args.len() - 1].expr, Val(sema_event_handler_type(owner, type_args)), false, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        values.push(handler)
    }
    value := sema_tree_node(shape.result, TExprKind.HandleMethod{receiver: receiver_value, operation: THandleOp.EventMethod{method: method}, args: values}, span)
    checked: sema_expression_call_expected(value, expected, environment, program, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}
