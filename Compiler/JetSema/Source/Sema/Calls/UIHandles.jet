// Source producers for retained UI callbacks, UI backend methods, and sketches.
// Operation choices mirror the native checked-tree producers.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    CallLabel,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    NodeKind,
    ParamZone,
    Span,
    SymbolKind,
    Type,
    core_identity_is,
    expr_span,
    foundation_byte_text,
    type_name,
]

sema_ui_handle_unit: fn() -> Type Never! { Type.Named{name: "Unit"} }

sema_ui_handle_infer_args: fn(args: [CallArg], check: ^SemaBodyCheck) -> [TExpr] Never! {
    ^values: [TExpr]{}
    loop arg in args {
        if sema_check_expression(arg.expr, None, check) == .Val(value) -> values.push(value)
    }
    values
}

sema_ui_handle_call_fact: fn(check: ^SemaBodyCheck, api: String, span: Span, result_type: Type, effect_name: String) -> Bool Never! {
    ^effects: [EffectRowEntry]{}
    if effect_name != "" -> effects.push(EffectRowEntry{name: effect_name, span: span})
    ^facts: SemaCallFacts{
        return_type: result_type,
        failure_carrier: sema_call_failure_carrier(Val(result_type)),
        effect_bound: Val(effects),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(check.environment.*, check.program.*, check.scopes, check.context, api, span, facts, check.diagnostics)
}

sema_ui_handle_literal_string: fn(expr: Expr) -> String? {
    return if expr == {
        .Str(parts, _, _) -> {
            ^value: ""
            loop part in parts {
                if part == {
                    .Lit(text) -> { value += text }
                    .Interp(_, _) | .Byte(_) -> { return None }
                }
            }
            Val(value)
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_ui_handle_imported_ui_alias: fn(alias: String, check: SemaBodyCheck) -> Bool Never! {
    if sema_call_core_import_module(check.environment.*, check.program.*, alias) != .Val("core.ui") {
        return false
    }
    visible: sema_scope_resolve(check.scopes, alias) ?? return false
    visible.kind == SymbolKind.Import
}

sema_ui_handle_interactive_role: fn(expr: Expr, check: SemaBodyCheck) -> String? {
    if expr == {
        .MethodCall(receiver, method, _, _, _, _, _) -> {
            if receiver == {
                .Ident(alias, _, _) -> {
                    if !sema_ui_handle_imported_ui_alias(alias, check) -> return None
                    if method == "aria_role_button" -> return Val("button")
                    if method == "aria_role_text_input" -> return Val("text input")
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
    None
}

sema_call_core_ui_node_role_lint: fn(args: [CallArg], span: Span, check: ^SemaBodyCheck) {
    if args.len() != 4 {
        return
    }
    if sema_ui_handle_literal_string(args[0].expr) != .Val("") {
        return
    }
    role: sema_ui_handle_interactive_role(args[3].expr, check) ?? return
    check.diagnostics.push(sema_lint("E2930", span, "This {role} has no accessible label", "Screen readers announce a control by its accessible label; an empty label is invisible to assistive tech.", "Pass a real label, e.g. `ui.node_role(\"Submit\", w, h, ui.aria_role_button())`."))
}

sema_call_core_ui_focus_group_lint: fn(args: [CallArg], span: Span, check: ^SemaBodyCheck) {
    if args.len() == 0 {
        return
    }
    if args[0].expr == {
        .ListLit(items, _, _) -> {
            ^labels: [String]{}
            loop item in items {
                if item == {
                    .MethodCall(receiver, method, _, _, _, call_args, _) -> {
                        if method != "node_role" || call_args.len() != 4 -> next
                        alias: if receiver == {
                            .Ident(name, _, _) -> Val(name)
                            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
                        } ?? next
                        if !sema_ui_handle_imported_ui_alias(alias, check) -> next
                        if sema_ui_handle_interactive_role(call_args[3].expr, check) == None -> next
                        label: sema_ui_handle_literal_string(call_args[0].expr) ?? next
                        if label == "" -> next
                        ^duplicate: false
                        loop existing in labels {
                            if existing == label {
                                duplicate = true
                                break
                            }
                        }
                        if duplicate {
                            check.diagnostics.push(sema_lint("E2931", span, "Two interactive nodes both have the label \"{label}\"", "Assistive tech announces controls by their label — identical labels make them indistinguishable (WCAG 2.5.3).", "Give each interactive node a distinct, descriptive label."))
                            return
                        }
                        labels.push(label)
                    }
                    .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
                }
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}

sema_ui_handle_callback_source_arity: fn(expr: Expr) -> Int? {
    if expr == {
        .Lambda(lambda, _) -> Val(lambda.params.len())
        .Paren(value, _, _) -> sema_ui_handle_callback_source_arity(value)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    }
}

sema_ui_handle_callback_type: fn(params: [Type]) -> Type Never! {
    Type.Fn{params: params, ret: Val(sema_ui_handle_unit()), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
}

sema_ui_handle_stored_callback: fn(kind: String, argument: CallArg, params: [Type], span: Span, check: ^SemaBodyCheck) -> TLambda? {
    actual_arity: sema_ui_handle_callback_source_arity(argument.expr) ?? {
        checked: sema_expression_lambda_host_callback_stored(argument.expr, Val(sema_ui_handle_callback_type(params)), false, check)
        actual: if checked == .Val(value) -> type_name(value.ty) else -> "an invalid value"
        check.diagnostics.push(sema_error("E2910", argument.span, "`{kind}` needs a lambda, not {actual}", "the callback is retained and invoked later by the UI runtime", "pass a lambda expression as the callback"))
        return None
    }
    if actual_arity != params.len() {
        ^_: sema_expression_lambda_host_callback_stored(argument.expr, None, false, check)
        check.diagnostics.push(sema_error("E2911", argument.span, "`{kind}` needs a {params.len()}-parameter lambda, got {actual_arity}", "the callback parameters must match the UI event", "use a callback with {params.len()} parameter(s)"))
        return None
    }
    checked: sema_expression_lambda_host_callback_stored(argument.expr, Val(sema_ui_handle_callback_type(params)), false, check) ?? return None
    if checked.kind == {
        .Lambda(lambda) -> Val(lambda)
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> None
    }
}

sema_ui_handle_callback_param: fn(name: String, label: String, ty: Type, span: Span, convention: AccessConvention, zone: ParamZone, default: Expr?) -> SemaCallParam Never! {
    SemaCallParam{label: label, name: name, zone: zone, default: default, default_ref: None, convention: convention, ty: Val(ty), variadic: false}
}

// The callback is an ordinary `() -> { … }` argument; an
// unlabeled lambda after the positional params fills the callback slot.
sema_ui_handle_bind_callback_args: fn(member: String, args: [CallArg], span: Span, callback_label: String, params: [SemaCallParam], diagnostics: ^[Diagnostic]) -> [CallArg]? {
    ^normalized: args
    ^positional: 0
    loop param in params {
        if param.zone == .PositionalOnly -> positional += 1
    }
    last: normalized.len() - 1
    if last >= positional && normalized[last].label == None && normalized[last].expr == .Lambda(_, _) {
        normalized[last].label = Val(CallLabel{name: callback_label, span: normalized[last].span})
    }
    ^_: sema_call_bind_args("core.ui.{member}", params, normalized, span, diagnostics) ?? return None
    Val(normalized)
}

sema_ui_handle_typed_arg: fn(arg: CallArg, ty: Type, check: ^SemaBodyCheck) -> TExpr? {
    sema_check_expression(arg.expr, Val(ty), check)
}

sema_ui_handle_optional_arg: fn(arg: CallArg, ty: Type, check: ^SemaBodyCheck) -> TExpr? {
    if sema_expression_absent_none(arg.expr) {
        return Val(sema_node(check.context, Type.Option{inner: ty}, NodeKind.Absent, arg.span))
    }
    value: sema_ui_handle_typed_arg(arg, ty, check) ?? return None
    return Val(sema_tree_node(Type.Option{inner: ty}, TExprKind.Present{value: value}, value.span))
}

// `ui.button(display)` is the Core source function `button`; the callback
// form `ui.button(display, () -> { … })` registers its click handler as a
// retained closure (a click slot Int) and builds the node with the core.ui
// source function that fills the ButtonClick role. Neither has a Core
// registry row.
sema_ui_handle_button: fn(args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if args.len() == 1 && args[0].label == None {
        label: sema_ui_handle_typed_arg(args[0], Type.String, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        value: sema_call_core_source("core.ui", "button", [TExpr]{label}, Type.Named{name: "UINode"}, false, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        return SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
    }
    ^params: [SemaCallParam]{
        sema_ui_handle_callback_param("display", "display", Type.String, span, AccessConvention.Read, ParamZone.PositionalOnly, None),
        sema_ui_handle_callback_param("shortcut", "shortcut", Type.Option{inner: Type.Named{name: "UIShortcut"}}, span, AccessConvention.Move, ParamZone.LabelOnly, Val(Expr.Absent{span: span, id: AST_NODE_GENERATED})),
        sema_ui_handle_callback_param("label", "label", Type.Option{inner: Type.String}, span, AccessConvention.Move, ParamZone.LabelOnly, Val(Expr.Absent{span: span, id: AST_NODE_GENERATED})),
        sema_ui_handle_callback_param("on_click", "on_click", sema_ui_handle_callback_type([Type]{}), span, AccessConvention.Move, ParamZone.LabelOnly, Val(Expr.Absent{span: span, id: AST_NODE_GENERATED})),
    }
    bound: sema_ui_handle_bind_callback_args("button", args, span, "on_click", params, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if bound.len() != 4 {
        ^_: sema_ui_handle_infer_args(bound, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if sema_expression_absent_none(bound[3].expr) {
        check.diagnostics.push(sema_error("E2910", span, "`button` with a shortcut or label needs its click lambda", "the shortcut and accessible label belong to the click form, whose handler is the `fn() {{ … }}` argument after them", "write `ui.button(\"Save\", shortcut: …, fn() {{ save() }})`"))
        // Check only the written arguments: the bound row's absent defaults
        // would report a follow-on untyped `None`.
        ^_: sema_ui_handle_infer_args(args, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    label: sema_ui_handle_typed_arg(bound[0], Type.String, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    shortcut: sema_ui_handle_optional_arg(bound[1], Type.Named{name: "UIShortcut"}, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    accessible_label: sema_ui_handle_optional_arg(bound[2], Type.String, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    callback: sema_ui_handle_stored_callback("button on_click", bound[3], [Type]{}, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ^result_type: Type.Named{name: "UINode"}
    ^click: sema_tree_node(Type.Int, TExprKind.CoreClosureCall{kind: TCoreClosureKind.UIClickSlot{executable: callback}}, span)
    if sema_call_core_module_identity(check.environment.*, check.program.*, "core.ui") == None {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    value: sema_call_core_role_source("ButtonClick", [TExpr]{label, shortcut, accessible_label, click}, result_type, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    checked: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_ui_handle_call_fact(check, "core.ui.button", span, result_type, "Browser") {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    SemaDirectSpecialCheck{handled: true, value: Val(checked)}
}

// `ui.text_input(state, ime)` is the Core source function `text_input`; the
// `on_drop:` form registers its drop handler as a retained closure (a drop
// slot Int) and builds the node with the Core function that fills the
// jet_builtins role TextInputDrop. The `on_change:` form registers its
// change handler as a button's click handler is kept (a click slot Int:
// the click registry keeps any callback closure), and a drop handler
// beside it when `on_drop:` is given too (else drop slot 0), and builds the
// node with the Core function that fills TextInputChange.
sema_ui_handle_text_input: fn(args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck Never! {
    params: [SemaCallParam]{
        sema_ui_handle_callback_param("state", "state", Type.String, span, AccessConvention.Read, ParamZone.PositionalOnly, None),
        sema_ui_handle_callback_param("ime", "ime", Type.Named{name: "UIIMEMode"}, span, AccessConvention.Read, ParamZone.PositionalOnly, None),
        sema_ui_handle_callback_param("on_drop", "on_drop", Type.Option{inner: sema_ui_handle_callback_type([Type]{Type.Named{name: "UIDropItem"}})}, span, AccessConvention.Move, ParamZone.LabelOnly, Val(Expr.Absent{span: span, id: AST_NODE_GENERATED})),
        sema_ui_handle_callback_param("on_change", "on_change", Type.Option{inner: sema_ui_handle_callback_type([Type]{Type.String})}, span, AccessConvention.Move, ParamZone.LabelOnly, Val(Expr.Absent{span: span, id: AST_NODE_GENERATED})),
    }
    bound: sema_ui_handle_bind_callback_args("text_input", args, span, "on_drop", params, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if bound.len() != 4 {
        ^_: sema_ui_handle_infer_args(bound, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    state_value: sema_ui_handle_typed_arg(bound[0], Type.String, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ime_value: sema_ui_handle_typed_arg(bound[1], Type.Named{name: "UIIMEMode"}, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    result_type: Type.Named{name: "UINode"}
    on_drop_absent: sema_expression_absent_none(bound[2].expr)
    on_change_absent: sema_expression_absent_none(bound[3].expr)
    if on_drop_absent && on_change_absent {
        value: sema_call_core_source("core.ui", "text_input", [TExpr]{state_value, ime_value}, result_type, false, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        return SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
    }
    ^drop_slot: sema_tree_node(Type.Int, TExprKind.IntLit{value: 0, width: None}, span)
    if !on_drop_absent {
        callback: sema_ui_handle_stored_callback("text_input on_drop", bound[2], [Type]{Type.Named{name: "UIDropItem"}}, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        drop_slot = sema_tree_node(Type.Int, TExprKind.CoreClosureCall{kind: TCoreClosureKind.UIDropSlot{executable: callback}}, span)
    }
    ^role: SEMA_CORE_ROLE_TEXT_INPUT_DROP
    ^slots: [TExpr]{state_value, ime_value}
    if on_change_absent -> slots.push(drop_slot) else {
        callback: sema_ui_handle_stored_callback("text_input on_change", bound[3], [Type]{Type.String}, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        slots.push(sema_tree_node(Type.Int, TExprKind.CoreClosureCall{kind: TCoreClosureKind.UIClickSlot{executable: callback}}, span))
        slots.push(drop_slot)
        role = SEMA_CORE_ROLE_TEXT_INPUT_CHANGE
    }
    graph: check.program.registration_graph
    builder: sema_core_role_function(graph, role) ?? {
        check.diagnostics.push(sema_missing_core_role(role, span))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    value: sema_call_core_source("core.ui", builder.name, slots, result_type, true, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    checked: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_ui_handle_call_fact(check, "core.ui.text_input", span, result_type, "Browser") {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    SemaDirectSpecialCheck{handled: true, value: Val(checked)}
}

// `ui.reactive_render(() -> { … })`: the measure/layout/paint loop keeps its
// zero-parameter body and re-runs it when a signal read inside changes. Like
// `reactive.autorun` it is retained-closure emission with no registry row.
sema_ui_handle_reactive_render: fn(args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if args.len() != 1 {
        check.diagnostics.push(sema_wrong_core_arity("reactive_render", 1, args.len(), span))
        ^_: sema_ui_handle_infer_args(args, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_call_core_check_type_args("core.ui", "reactive_render", 0, false, type_args, span, check.diagnostics) {
        ^_: sema_ui_handle_infer_args(args, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    result_type: sema_ui_handle_unit()
    callback: sema_reactive_check_retained_lambda("reactive_render", args[0], Val(result_type), None, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ^value: sema_tree_node(result_type, TExprKind.CoreClosureCall{kind: TCoreClosureKind.UIReactiveRender{executable: callback}}, span)
    checked: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    if !sema_ui_handle_call_fact(check, "core.ui.reactive_render", span, result_type, "Browser") {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    SemaDirectSpecialCheck{handled: true, value: Val(checked)}
}

// `ui.mount(backend, tree)` or `ui.mount(backend, tree, constraint)`: the
// backend's own `mount` method, whose constraint defaults to its viewport.
sema_ui_handle_mount: fn(args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if args.len() != 2 && args.len() != 3 {
        check.diagnostics.push(sema_wrong_core_arity("mount", 2, args.len(), span))
        ^_: sema_ui_handle_infer_args(args, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^rest: [CallArg]{}
    loop index in 1..<args.len() -> rest.push(args[index].copy())
    call: Expr.MethodCall{receiver: args[0].expr.copy(), method: "mount", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: rest, id: AST_NODE_GENERATED}
    SemaDirectSpecialCheck{handled: true, value: sema_check_expression(call, expected, check)}
}

// `ui.asset(path)` names a file as `embed_bytes` does, from the calling file's
// own directory: a literal path that breaks that path law is E0957, and one
// the driver found no file for (Program.app_missing_assets) is E2822 naming
// the path it resolved to, both at the path, and the call is checked no
// further.
sema_ui_asset_refused: fn(args: [CallArg], check: ^SemaBodyCheck) -> Bool {
    if args.len() != 1 -> return false
    path: sema_ui_asset_literal(args[0].expr) ?? return false
    named: sema_comptime_input_named(path)
    if sema_comptime_input_path_law(named) == .Val(problem) {
        check.diagnostics.push(sema_comptime_input_path_error("ui.asset", problem, expr_span(args[0].expr)))
        return true
    }
    graph: check.program.registration_graph
    row: sema_app_module_row(check.environment.*, graph)
    if row < 0 || !graph.modules[row].program.app_missing_assets.contains(path) -> return false
    file: graph.modules[row].source_file
    cut: file.rfind("/")
    resolved: if cut < 0 -> named else -> "{foundation_byte_text(file.bytes(), 0, cut)}/{named}"
    entry: sema_diagnostic_row("E2822")
    check.diagnostics.push(sema_error("E2822", expr_span(args[0].expr), sema_ui_asset_text(entry.what, path, resolved), sema_ui_asset_text(entry.why, path, resolved), sema_ui_asset_text(entry.fix, path, resolved)))
    true
}

sema_ui_asset_text: fn(text: String, path: String, resolved: String) -> String Never! {
    text.replace("{{path}}", path).replace("{{resolved}}", resolved)
}

// The path written as string literal parts, as the driver reads it.
sema_ui_asset_literal: fn(expression: Expr) -> String? Never! {
    if expression == .Str(parts, _, _) {
        ^text: ""
        loop part in parts {
            if part == .Lit(value) -> text = "{text}{value}" else -> return None
        }
        return Val(text)
    }
    None
}

// `ui.mount`, `ui.button`, `ui.text_input` and `ui.reactive_render` have no
// Core registry row, so (like `scope.guard`) they resolve through the import
// before the registry route. `ui.asset` has its path checked first
// (sema_ui_asset_refused) and otherwise goes on to its registry row.
sema_call_try_ui_core_call: fn(module_name: String, member: String, alias: String, alias_span: Span, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if module_name == "core.ui" && member == "asset" {
        if !sema_ui_asset_refused(args, check) {
            return SemaDirectSpecialCheck{handled: false, value: None}
        }
        if sema_call_core_import_target(check.environment.*, check.program.*, alias) == .Val(imported) {
            _: sema_call_core_record_import_reference(check, imported, alias_span)
        }
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if module_name != "core.ui" || (member != "mount" && member != "button" && member != "text_input" && member != "reactive_render") {
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    imported: sema_call_core_import_target(check.environment.*, check.program.*, alias) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    if !sema_call_core_record_import_reference(check, imported, alias_span) {
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    if member == {
        "button" -> sema_ui_handle_button(args, span, expected, check)
        "text_input" -> sema_ui_handle_text_input(args, span, expected, check)
        "reactive_render" -> sema_ui_handle_reactive_render(args, type_args, span, expected, check)
        else -> sema_ui_handle_mount(args, span, expected, check)
    }
}

// A UI backend's `set_focus_group` (a Core source method) lints the focus
// ring it is given.
sema_call_ui_backend_lint: fn(receiver_value: TExpr, method: String, args: [CallArg], span: Span, check: ^SemaBodyCheck) {
    if method != "set_focus_group" {
        return
    }
    owner: sema_expr_type_base_name(receiver_value.ty) ?? type_name(receiver_value.ty)
    if owner == "NullBackend" || owner == "TUIBackend" || core_identity_is(owner, "core.ui", "NullBackend") || core_identity_is(owner, "core.ui", "TUIBackend") {
        sema_call_core_ui_focus_group_lint(args, span, check)
    }
}
