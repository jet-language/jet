// Tier-1 comptime inputs: `embed_file(path) -> String`, `embed_bytes(path)
// -> [U8]` and `find(glob) -> [String]`. Each names its input with a String
// relative to the file doing the embedding: a literal, or a value the comptime
// code computes (a path `find` returned, a name read from a table). A
// `toolchain:` name (`embed_file("toolchain:Compiler/Prelude/Effects.jet")`)
// is relative to the toolchain tree the compile takes Core from instead,
// which the driver admits only for the toolchain's own packages. One path
// law holds for both kinds: no absolute path and no `..` segment (E0957).
// Sema checks a literal here and keeps it normalized in the typed call; the
// driver checks a computed value with sema_comptime_input_value_problem when
// the evaluation reaches it, before any read. The compiler reads the input
// when it evaluates the comptime code (the driver's rooted, no-follow read)
// and records its hash; nothing runs at runtime.
use jet_foundation.[
    Call,
    CallArg,
    Diagnostic,
    Expr,
    JET_COMPTIME_TOOLCHAIN_PREFIX,
    Span,
    StrPart,
    Type,
]

sema_comptime_input_type: fn(name: String) -> Type Never! {
    if name == "embed_bytes" -> return Type.List{element: Type.IntN{signed: false, bits: 8}}
    if name == "find" -> return Type.List{element: Type.String}
    Type.String
}

// The argument's source string literal, or None when it is computed.
sema_comptime_input_literal: fn(expression: Expr) -> String? Never! {
    if expression == .Str(parts, _, _) {
        if parts.len() == 0 -> return Val("")
        if parts.len() == 1 && parts[0] == .Lit(text) -> return Val(text)
    }
    None
}

// The name a comptime input's path or glob stands for: `\` read as `/`.
sema_comptime_input_named: fn(path: String) -> String Never! {
    path.replace("\\", "/")
}

// The path law of a comptime input's normalized name (`named`), judged after
// any `toolchain:` prefix: "absolute" for an absolute name, "parent" for a
// `..` segment, else None.
sema_comptime_input_path_law: fn(named: String) -> String? Never! {
    relative: named.removeprefix(JET_COMPTIME_TOOLCHAIN_PREFIX)
    if relative.starts_with("/") -> return Val("absolute")
    loop part in relative.split("/") {
        if part == ".." -> return Val("parent")
    }
    None
}

sema_comptime_input_noun: fn(builtin: String) -> String Never! {
    if builtin == "find" -> "glob" else -> "path"
}

// `embed_path_err` (E0957) for a literal, word for word.
sema_comptime_input_path_error: fn(builtin: String, problem: String, call: Call) -> Diagnostic {
    span: call.name_span
    noun: sema_comptime_input_noun(builtin)
    if problem == "absolute" -> return sema_error("E0957", span, "`{builtin}` {noun} must be relative", "an absolute {noun} reaches outside the project", "use a {noun} relative to this file's own directory")
    sema_error("E0957", span, "`{builtin}` {noun} can't use `..`", "comptime inputs are named from this file's own directory down, so a build can audit them; `..` is refused even when it names a file inside the package", "drop the `..` and use a {noun} under this file's directory")
}

// E0957 for a computed path or glob (`named`, normalized) that breaks the
// path law, quoting the value; None when it keeps it. The driver calls this
// on every computed value before it reads anything.
sema_comptime_input_value_problem: fn(builtin: String, named: String, span: Span) -> Diagnostic? {
    problem: sema_comptime_input_path_law(named) ?? return None
    noun: sema_comptime_input_noun(builtin)
    if problem == "absolute" -> return Val(sema_error("E0957", span, "`{builtin}` {noun} `{named}` must be relative", "an absolute {noun} reaches outside the project, and this one was computed at build time", "compute a {noun} relative to this file's own directory"))
    Val(sema_error("E0957", span, "`{builtin}` {noun} `{named}` can't use `..`", "comptime inputs are named from this file's own directory down, so a build can audit them; `..` is refused in a computed {noun} too", "compute a {noun} under this file's directory, without `..`"))
}

sema_call_check_comptime_input: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    builtin: call.name
    failed: SemaDirectSpecialCheck{handled: true, value: None}
    noun: sema_comptime_input_noun(builtin)
    if call.args.len() != 1 {
        diagnostics.push(sema_error("E0104", call.name_span, "`{builtin}` expects 1 argument, got {call.args.len()}", "a comptime input names exactly one {noun}", "pass one String {noun}"))
        return failed
    }
    if scopes.comptime_execution_depth == 0 {
        diagnostics.push(sema_error("E0956", call.name_span, "`{builtin}` is compile-time only", "the compiler reads the file while building, so it is a value in the program, not a runtime read", "use it in a `comptime` binding, e.g. `TEXT: comptime {{ {builtin}(\"file\") }}`"))
        return failed
    }
    path: sema_comptime_input_path_value(call, environment, program, scopes, state, tail_store, context, diagnostics) ?? return failed
    node: sema_tree_node(sema_comptime_input_type(builtin), TExprKind.HostCall{call: THostCall.ComptimeInput{builtin: builtin, path: path, pin: None}}, call.name_span)
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(node, expected, environment, program, diagnostics)}
}

// The checked path or glob of a comptime input call: its literal,
// normalized and held to the path law here, or the computed String
// expression, whose value the driver holds to it when the evaluation reaches
// the call. None after a reported problem.
sema_comptime_input_path_value: fn(call: Call, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    builtin: call.name
    if sema_comptime_input_literal(call.args[0].expr) == .Val(literal) {
        named: sema_comptime_input_named(literal)
        if sema_comptime_input_path_law(named) == .Val(problem) {
            diagnostics.push(sema_comptime_input_path_error(builtin, problem, call))
            return None
        }
        return Val(sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: named}}}, call.args[0].span))
    }
    checked: sema_check_expression(call.args[0].expr, Val(Type.String), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    if sema_expr_unwrap_tag(checked.ty) != Type.String {
        noun: sema_comptime_input_noun(builtin)
        example: if builtin == "find" -> "content/**/*.jet" else -> "data/file"
        diagnostics.push(sema_error("E0957", call.args[0].span, "`{builtin}` {noun} must be a String, not {sema_type_show(checked.ty)}", "the compiler reads the file the String names while it builds", "pass a String {noun}, e.g. `{builtin}(\"{example}\")`"))
        return None
    }
    Val(checked)
}

// `net.fetch(url, sha256: "…")`, the one compile-time network operation: a
// Tier-1 input whose content must hash to the written pin. The URL is a
// String, a literal or a value the comptime code computes; the pin is a
// String literal, so the source itself fixes the value. The compiler fetches
// the URL while it builds (the driver's jet_driver_build_fetch, the fetch
// `b.fetch` runs), and content that misses the pin is E3413. Another
// `core.net` member is not handled here.
sema_call_try_comptime_fetch: fn(module_name: String, member: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if module_name != "core.net" || member != "fetch" -> return SemaDirectSpecialCheck{handled: false, value: None}
    failed: SemaDirectSpecialCheck{handled: true, value: None}
    if scopes.comptime_execution_depth == 0 {
        diagnostics.push(sema_error("E0956", span, "`net.fetch` is compile-time only", "the compiler downloads the pinned content while building, so it is a value in the program, not a runtime request", "use it in a `comptime` binding, e.g. `DATA: comptime {{ net.fetch(\"https://example.com/data.txt\", sha256: \"…\") }}`"))
        return failed
    }
    pinned := false
    if args.len() == 2 && args[0].label == None {
        if args[1].label == .Val(label) -> pinned = label.name == "sha256"
    }
    pin := String?{None}
    if pinned -> pin = sema_comptime_input_literal(args[1].expr)
    sha256: pin ?? {
        diagnostics.push(sema_error("E3414", span, "`net.fetch` takes a URL and a literal `sha256:` pin", "a compile-time download is pinned by the content hash written in the source", "write `net.fetch(\"https://example.com/data.txt\", sha256: \"<64 hex digits>\")`"))
        return failed
    }
    url: sema_check_expression(args[0].expr, Val(Type.String), environment, program, scopes, state, tail_store, context, diagnostics) ?? return failed
    if sema_expr_unwrap_tag(url.ty) != Type.String {
        diagnostics.push(sema_error("E3414", args[0].span, "`net.fetch` URL must be a String, not {sema_type_show(url.ty)}", "the compiler downloads the URL the String names while it builds", "pass a String URL, e.g. `net.fetch(\"https://example.com/data.txt\", sha256: \"…\")`"))
        return failed
    }
    node: sema_tree_node(Type.String, TExprKind.HostCall{call: THostCall.ComptimeInput{builtin: "fetch", path: url, pin: Val(sha256)}}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(node, expected, environment, program, diagnostics)}
}
