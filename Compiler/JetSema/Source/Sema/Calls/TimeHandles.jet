// Checked deterministic time handles and the built-in Duration methods. Core's
// `RNG` is a source record, so its draws are ordinary checked method calls.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    InternalTag,
    ParamZone,
    Span,
    StrPart,
    TLetTy,
    TFailureCarrier,
    TagMarker,
    Type,
    core_identity_is,
    checked_symbol_local,
]

sema_time_named: fn(name: String) -> Type Never! { Type.Named{name: name} }

sema_time_handle_receiver_name: fn(ty: Type) -> String Never! {
    if ty == {
        .Named(name) -> if sema_call_is_clock_type(ty) -> "Clock" else -> name
        .Tagged(_, inner) -> sema_time_handle_receiver_name(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ""
    }
}

sema_time_failure_carrier: fn(result: Type) -> TFailureCarrier Never! {
    if result == {
        // copy: `ok` and `err` are payloads of read parameter `result`, which keeps the originals; the new TFailureCarrier.Result's fields own `ok` and `err`
        .Result(ok, err) -> TFailureCarrier.Result{success: ok.copy(), error: err.copy()}
        // copy: `inner` is a payload of read parameter `result`, which keeps the original; field `value` of the new TFailureCarrier.Optional owns this one
        .Option(inner) -> TFailureCarrier.Optional{value: inner.copy()}
        .Named(name) -> if name == "Never" -> TFailureCarrier.Diverges{value: result} else -> TFailureCarrier.Infallible
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> TFailureCarrier.Infallible
    }
}

sema_time_record_intrinsic: fn(result: Type, effect_name: String, api: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool Never! {
    effects := [EffectRowEntry]{}
    if effect_name != "" -> effects.push(EffectRowEntry{name: effect_name, span: span})
    facts := SemaCallFacts{
        return_type: result,
        failure_carrier: sema_time_failure_carrier(result),
        effect_bound: Val(effects),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(environment, program, scopes, context, api, span, facts, diagnostics)
}

sema_time_check_values: fn(args: [CallArg], required: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [TExpr]? {
    if args.len() != required.len() -> return None
    values := [TExpr]{}
    loop index in 0..<args.len() {
        value: sema_check_expression(args[index].expr, Val(required[index]), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        values.push(value)
    }
    Val(values)
}

sema_time_untyped_values: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [TExpr]? {
    values := [TExpr]{}
    loop argument in args {
        value: sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        values.push(value)
    }
    Val(values)
}

sema_time_method_params: fn(required: [Type]) -> [SemaCallParam] Never! {
    params := [SemaCallParam]{}
    loop (index, ty) in required {
        params.push(
            SemaCallParam{
                label: "arg{index}",
                name: "arg{index}",
                zone: ParamZone.PositionalOnly,
                default: None,
                default_ref: None,
                convention: AccessConvention.Read,
                ty: Val(ty),
                variadic: false,
            },
        )
    }
    params
}

sema_time_check_method_ownership: fn(receiver: Expr, method: String, args: [CallArg], required: [Type], receiver_access: AccessConvention, span: Span, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> Bool {
    updated_args := args
    checked := sema_ownership_check_method_call(state, method, receiver, receiver_access, sema_time_method_params(required), updated_args, scopes, span, diagnostics)
    checked.accepted && checked.complete
}

sema_time_finish_handle: fn(receiver: TExpr, operation: THandleOp, args: [TExpr], result: Type, effect_name: String, api: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    if !sema_time_record_intrinsic(result, effect_name, api, span, environment, program, scopes, context, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    value := sema_tree_node(result, TExprKind.HandleMethod{receiver: receiver, operation: operation, args: args}, span)
    checked := sema_expression_call_expected(value, expected, environment, program, context, diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

sema_time_clock_is_deterministic: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(marker, inner) -> marker == TagMarker.Internal{internal_tag: InternalTag.DeterministicClock} && sema_time_handle_receiver_name(inner) == "Clock"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// A pure function's Clock parameter is injected by its caller, so the body
// reads it as a deterministic clock (Rust Registration `deterministic_clock_type`).
// None when `ty` is not an untagged Clock.
sema_time_injected_clock: fn(ty: Type) -> Type? Never! {
    if !sema_call_is_clock_type(ty) || sema_time_clock_is_deterministic(ty) -> return None
    // copy: `ty` is a read parameter; the tag's `inner` owns this one
    Val(Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.DeterministicClock}, inner: ty.copy()})
}

sema_time_clock_is_system: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(marker, inner) -> marker == TagMarker.Internal{internal_tag: InternalTag.SystemClock} && sema_time_handle_receiver_name(inner) == "Clock"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_time_clock_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    recorded: sema_time_clock_record(receiver_value, method, args, span, environment, program, scopes, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if !recorded -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_call_check_method(state, receiver, method, span, [Type]{}, [Type]{}, args, span, expected, environment, program, scopes, tail_store, context, diagnostics)
    SemaMethodSpecialCheck{handled: true, value: value}
}

// Records a Clock read's `Clock.{method}` site: `Time` unless the receiver is
// the deterministic or system clock. None when `method` reads no time; false
// when the transaction wall refused the site (its diagnostic is the report).
sema_time_clock_record: fn(receiver_value: TExpr, method: String, args: [CallArg], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool? Never! {
    result: if {
        method == "now" && args.len() == 0 -> Val(Type.Int)
        (method == "tick" || method == "advance") && args.len() == 1 -> Val(Type.Int)
        method == "wait" && args.len() == 1 -> Val(Type.Int)
        else -> None
    }
    if result == None -> return None
    effect_name: if sema_time_clock_is_deterministic(receiver_value.ty) || sema_time_clock_is_system(receiver_value.ty) -> "" else -> "Time"
    Val(sema_time_record_intrinsic(result, effect_name, "Clock.{method}", span, environment, program, scopes, context, diagnostics))
}

sema_time_default_string: fn(value: String, span: Span) -> Expr Never! {
    Expr.Str{parts: [StrPart]{StrPart.Lit{text: value}}, span: span, id: AST_NODE_GENERATED}
}

sema_time_default_int: fn(value: Int, span: Span) -> Expr Never! {
    Expr.Int{value: value, span: span, width: None, raw: Val("{value}"), id: AST_NODE_GENERATED}
}

sema_time_contract_param: fn(label: String, ty: Type, default: Expr?) -> SemaCallParam Never! {
    SemaCallParam{
        label: label,
        name: label,
        zone: ParamZone.Either,
        default: default,
        default_ref: None,
        convention: AccessConvention.Read,
        ty: Val(ty),
        variadic: false,
    }
}

// `duration.round(unit, increment: 1, rounding_mode: "half_expand")`: the
// labeled contract its arguments bind against.
sema_time_duration_round_params: fn(span: Span) -> [SemaCallParam] {
    [SemaCallParam]{
        sema_time_contract_param("unit", Type.String, None),
        sema_time_contract_param("increment", Type.Int, Val(sema_time_default_int(1, span))),
        sema_time_contract_param("rounding_mode", Type.String, Val(sema_time_default_string("half_expand", span))),
    }
}

sema_time_duration_round: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    api: "Duration.round"
    params: sema_time_duration_round_params(span)
    source_args := args
    binding: sema_call_bind_args(api, params, source_args, span, diagnostics) ?? {
        _ := sema_time_untyped_values(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    typed: sema_call_typecheck_bound_arguments(api, params, None, false, binding, source_args, environment, program, scopes, state, tail_store, context, span, diagnostics, false) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    ownership: sema_ownership_check_method_call(state, api, receiver, AccessConvention.Read, params, source_args, scopes, span, diagnostics)
    if !ownership.accepted || !ownership.complete {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    lowered := sema_call_lower_bound_arguments(typed, params, source_args, environment, program)
    if !sema_call_prepare_variadic_elements(typed, params, source_args, lowered, environment, program, scopes, state, context, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    pins := [TStmt]{}
    pinned_receiver := receiver_value
    if typed.pin_arguments {
        borrowed: sema_ownership_places_from_expr_in_state(receiver, scopes, state).len() > 0
        pin_slot: -typed.values.len() - 1
        symbol: sema_call_binder_ref_symbol(environment, program, context, sema_scope_function_owner_key(scopes), typed.binder_site, pin_slot, "receiver", receiver_value.ty, span)
        local := checked_symbol_local("binder_ref_{typed.binder_site}_{pin_slot}", span, symbol.id, receiver_value.ty)
        local.generated = true
        local.deref = borrowed
        init := receiver_value
        if borrowed {
            init = sema_tree_node(init.ty, TExprKind.Borrow{place: init, access: AccessConvention.Read}, init.span)
        }
        pins.push(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: init, gc_promotion: None, gc_transferred: false, span: span})
        pinned_receiver = sema_tree_node(receiver_value.ty, TExprKind.Local{local: local}, receiver_value.span)
    }
    loop pin in sema_call_pin_binder_arguments(typed, params, lowered, environment, program, scopes, context, span) {
        pins.push(pin)
    }
    packed: sema_call_pack_variadic_arguments(typed, params, lowered, environment, program, context, span, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if packed.len() != params.len() -> return SemaMethodSpecialCheck{handled: false, value: None}
    values := [TExpr]{}
    loop argument in packed -> values.push(argument.value)
    finished: sema_time_finish_handle(pinned_receiver, THandleOp.DurationRound, values, sema_time_named("Duration"), "", api, span, expected, environment, program, scopes, context, diagnostics)
    // The checked value moves out of `finished`: a `:` read of the field would copy it at `value.move()`.
    value: finished.value.move() ?? return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(sema_call_with_binder_pins(pins, value, span))}
}

sema_call_try_time_static_method: fn(owner: String, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    if owner == "Clock" {
        if method == "new" && updated_args.len() == 1 {
            result := Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.DeterministicClock}, inner: sema_time_named("Clock")}
            if !sema_time_record_intrinsic(result, "", "Clock.new", span, environment, program, scopes, context, diagnostics) {
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            source := sema_call_try_static_method(Expr.Ident{name: "Clock", span: span, id: AST_NODE_GENERATED}, method, span, [Type]{}, [Type]{}, updated_args, span, None, environment, program, scopes, state, tail_store, context, diagnostics)
            value := source.value ?? return SemaMethodSpecialCheck{handled: true, value: None}
            return SemaMethodSpecialCheck{handled: true, value: sema_time_clock_retagged(value, result, expected, environment, program, diagnostics)}
        }
        if method == "system" && updated_args.len() == 0 {
            result := Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.SystemClock}, inner: sema_time_named("Clock")}
            if !sema_time_record_intrinsic(result, "Time", "Clock.system", span, environment, program, scopes, context, diagnostics) {
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            source := sema_call_try_static_method(Expr.Ident{name: "Clock", span: span, id: AST_NODE_GENERATED}, method, span, [Type]{}, [Type]{}, updated_args, span, None, environment, program, scopes, state, tail_store, context, diagnostics)
            value := source.value ?? return SemaMethodSpecialCheck{handled: true, value: None}
            return SemaMethodSpecialCheck{handled: true, value: sema_time_clock_retagged(value, result, expected, environment, program, diagnostics)}
        }
        if method == "now" && updated_args.len() == 0 {
            constructor: Expr.MethodCall{receiver: Expr.Ident{name: "Instant", span: span, id: AST_NODE_GENERATED}, method: "__now", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, id: AST_NODE_GENERATED}
            return SemaMethodSpecialCheck{handled: true, value: sema_check_expression(constructor, expected, environment, program, scopes, state, tail_store, context, diagnostics)}
        }
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}

// The source constructor's `Clock Never!` keeps its carrier: only the success
// slot takes the clock tag, so the call root still propagates (unwraps) the
// Result the callee returns instead of reading it as a bare Clock.
sema_time_clock_retagged: fn(value: &&TExpr, tagged: Type, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    retagged := value.move()
    if retagged.ty == .Result(_, err) {
        // copy: `err` is a payload of `retagged.ty`, which the new Type.Result replaces
        tree_expr_retype(retagged, Type.Result{ok: tagged, err: err.copy()})
        return Val(retagged)
    }
    tree_expr_retype(retagged, tagged)
    sema_expr_expected(retagged, expected, environment, program, diagnostics)
}

sema_call_try_time_handle_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    receiver_name: sema_time_handle_receiver_name(receiver_value.ty)
    if receiver_name == "Clock" {
        return sema_time_clock_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    if receiver_name == "Duration" {
        if method != "round" {
            return sema_time_duration_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        return sema_time_duration_round(receiver, receiver_value, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    if sema_time_testing_handle_is(receiver_name, "DeterministicWorld") {
        return sema_time_world_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}

// The runtime-owned `core.testing` handles keep their bare leaf; a
// canonical Core identity names the same handle.
sema_time_testing_handle_is: fn(name: String, leaf: String) -> Bool Never! {
    name == leaf || core_identity_is(name, "core.testing", leaf)
}

// One fixed built-in handle method: its checked-tree operation, checked result and
// declared argument types.
SemaTimeHandleContract: struct {
    operation: THandleOp,
    result: Type,
    required: [Type],
}

// Rust `deterministic_world_method_return` (jet-foundation) with the
// checked-tree ops of `handle_method_op`. The world is read through its
// receiver, and Rust gives its arguments no declared type, so `advance(2s)`
// checks its argument as written.
sema_time_world_contract: fn(method: String, argc: Int) -> SemaTimeHandleContract? {
    return if {
        method == "now" && argc == 0 -> Val(SemaTimeHandleContract{operation: THandleOp.WorldNow, result: Type.Int, required: [Type]{}})
        method == "advance" && argc == 1 -> Val(SemaTimeHandleContract{operation: THandleOp.WorldAdvance, result: Type.Int, required: [Type]{}})
        method == "wait_idle" && argc == 0 -> Val(SemaTimeHandleContract{operation: THandleOp.WorldWaitIdle, result: sema_time_named("Unit"), required: [Type]{}})
        method == "history" && argc == 0 -> Val(SemaTimeHandleContract{operation: THandleOp.WorldHistory, result: Type.String, required: [Type]{}})
        else -> None
    }
}

sema_time_world_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    contract: sema_time_world_contract(method, args.len()) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    values: sema_time_untyped_values(args, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_ownership_check_call_receiver(state, receiver, AccessConvention.Read, scopes, span, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    sema_time_finish_handle(receiver_value, contract.operation, values, contract.result, "", "DeterministicWorld.{method}", span, expected, environment, program, scopes, context, diagnostics)
}

// Rust `duration_method_return` / `builtin_method_arg_types` (
// ): the built-in Duration readers. Another name or arity is no
// Duration method.
sema_time_duration_result: fn(method: String, argc: Int) -> Type? {
    return if {
        method == "in" && argc == 1 -> Val(Type.Int)
        method == "is_zero" && argc == 0 -> Val(Type.Bool)
        method == "total_seconds" && argc == 0 -> Val(Type.Int)
        method == "difference" && argc == 1 -> Val(sema_time_named("Duration"))
        (method == "abs" || method == "negated") && argc == 0 -> Val(sema_time_named("Duration"))
        method == "sign" && argc == 0 -> Val(Type.Int)
        method == "total_in" && argc == 1 -> Val(Type.Float)
        else -> None
    }
}

sema_time_duration_args: fn(method: String) -> [Type] Never! {
    return if {
        method == "in" -> [Type]{sema_time_named("DurationUnit")}
        method == "difference" -> [Type]{sema_time_named("Duration")}
        method == "total_in" -> [Type]{Type.String}
        else -> [Type]{}
    }
}

sema_time_duration_op: fn(method: String) -> THandleOp Never! {
    return if {
        method == "in" -> THandleOp.DurationIn
        method == "is_zero" -> THandleOp.DurationIsZero
        method == "total_seconds" -> THandleOp.DurationTotalSeconds
        method == "difference" -> THandleOp.DurationDifference
        method == "abs" -> THandleOp.DurationAbs
        method == "negated" -> THandleOp.DurationNegated
        method == "sign" -> THandleOp.DurationSign
        else -> THandleOp.DurationTotalIn
    }
}

sema_time_duration_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    result: sema_time_duration_result(method, args.len()) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    required: sema_time_duration_args(method)
    values: sema_time_check_values(args, required, environment, program, scopes, state, tail_store, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_time_check_method_ownership(receiver, method, args, required, AccessConvention.Read, span, scopes, state, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    sema_time_finish_handle(receiver_value, sema_time_duration_op(method), values, result, "", "Duration.{method}", span, expected, environment, program, scopes, context, diagnostics)
}
