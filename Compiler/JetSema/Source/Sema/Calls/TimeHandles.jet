// Checked deterministic time/random handles and civil-time methods.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    InternalTag,
    ParamZone,
    Span,
    StrPart,
    TExpr,
    TExprKind,
    TFailureCarrier,
    THandleOp,
    THelperKind,
    THostArg,
    THostCall,
    TagMarker,
    Type,
    core_call,
    type_name,
]

fn sema_time_named(name: String) -> Type Never! {
    Type.Named{name: name}
}

fn sema_time_handle_receiver_name(ty: Type) -> String Never! {
    if ty == {
        .Named(name) -> name
        .Tagged(_, inner) -> sema_time_handle_receiver_name(inner)
        else -> ""
    }
}

fn sema_time_failure_carrier(result: Type) -> TFailureCarrier Never! {
    if result == {
        .Result(ok, err) -> TFailureCarrier.Result{success: ok, error: err}
        .Option(inner) -> TFailureCarrier.Optional{value: inner}
        .Named(name) -> if name == "Never" -> TFailureCarrier.Diverges{value: result} else -> TFailureCarrier.Infallible
        else -> TFailureCarrier.Infallible
    }
}

fn sema_time_record_intrinsic(result: Type, effect_name: String, api: String, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool Never! {
    effects := [EffectRowEntry]{}
    if effect_name != "" -> &effects.push(EffectRowEntry{name: effect_name, span: span})
    facts := SemaCallFacts{
        return_type: result,
        failure_carrier: sema_time_failure_carrier(result),
        effect_bound: Val(effects),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(environment, &scopes, &context, api, span, facts, &diagnostics)
}

fn sema_time_check_values(args: [CallArg], required: [Type], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [TExpr]? {
    if args.len() != required.len() -> return None
    values := [TExpr]{}
    loop index in 0..<args.len() {
        value :: sema_check_expression(args[index].expr, Val(required[index]), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        &values.push(value)
    }
    Val(values)
}

fn sema_time_untyped_values(args: [CallArg], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [TExpr]? {
    values := [TExpr]{}
    loop argument in args {
        value :: sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        &values.push(value)
    }
    Val(values)
}

fn sema_time_method_params(required: [Type]) -> [SemaCallParam] Never! {
    params := [SemaCallParam]{}
    loop (index, ty) in required {
        &params.push(SemaCallParam{
            label: "arg{index}",
            name: "arg{index}",
            zone: ParamZone.PositionalOnly,
            default: None,
            default_ref: None,
            convention: AccessConvention.Read,
            ty: Val(ty),
            variadic: false,
        })
    }
    params
}

fn sema_time_check_method_ownership(receiver: Expr, method: String, args: [CallArg], required: [Type], receiver_access: AccessConvention, span: Span, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> Bool {
    updated_args := args
    checked := sema_ownership_check_method_call(&state, method, receiver, receiver_access, sema_time_method_params(required), &updated_args, scopes, span, &diagnostics)
    checked.accepted && checked.complete
}

fn sema_time_finish_handle(receiver: TExpr, operation: THandleOp, args: [TExpr], result: Type, effect_name: String, api: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    if !sema_time_record_intrinsic(result, effect_name, api, span, environment, &scopes, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tir_expr(result, TExprKind.HandleMethod{receiver: receiver, operation: operation, args: args}, span)
    checked := sema_expr_expected(value, expected, environment, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

fn sema_time_clock_is_deterministic(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(marker, inner) -> marker == TagMarker.Internal{internal_tag: InternalTag.DeterministicClock} && sema_time_handle_receiver_name(inner) == "Clock"
        else -> false
    }
}

fn sema_time_clock_is_system(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(marker, inner) -> marker == TagMarker.Internal{internal_tag: InternalTag.SystemClock} && sema_time_handle_receiver_name(inner) == "Clock"
        else -> false
    }
}

fn sema_time_clock_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    result :: if {
        method == "now" && args.len() == 0 -> Val(Type.Int)
        (method == "tick" || method == "advance") && args.len() == 1 -> Val(Type.Int)
        method == "wait" && args.len() == 1 -> Val(Type.Int)
        else -> None
    }
    if result == None -> return SemaMethodSpecialCheck{handled: false, value: None}
    required :: if method == {
        "tick" | "advance" -> [Type]{Type.Int}
        "wait" -> [Type]{sema_time_named("Duration")}
        else -> [Type]{}
    }
    receiver_access :: if method == "now" -> AccessConvention.Read else -> AccessConvention.Write
    values :: sema_time_check_values(args, required, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_time_check_method_ownership(receiver, method, args, required, receiver_access, span, &scopes, &state, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    operation :: if method == {
        "now" -> THandleOp.ClockNow
        "tick" -> THandleOp.ClockTick
        "advance" -> THandleOp.ClockAdvance
        else -> THandleOp.ClockWait
    }
    effect_name :: if sema_time_clock_is_deterministic(receiver_value.ty) || sema_time_clock_is_system(receiver_value.ty) -> "" else -> "Time"
    sema_time_finish_handle(receiver_value, operation, values, result, effect_name, "Clock.{method}", span, expected, environment, &scopes, &context, &diagnostics)
}

fn sema_time_rng_fixed_signature(method: String, argc: Int) -> Type? {
    return if {
        method == "int" && argc == 2 -> Val(Type.Int)
        method == "float" && argc == 0 -> Val(Type.Float)
        method == "float_range" && argc == 2 -> Val(Type.Float)
        method == "bool" && (argc == 0 || argc == 1) -> Val(Type.Bool)
        method == "normal" && argc == 2 -> Val(Type.Float)
        method == "exponential" && argc == 1 -> Val(Type.Float)
        method == "bytes" && argc == 1 -> Val(Type.List{element: Type.IntN{signed: false, bits: 8}})
        method == "split" && argc == 0 -> Val(sema_time_named("RNG"))
        else -> None
    }
}

fn sema_time_rng_fixed_args(method: String, argc: Int) -> [Type] Never! {
    return if {
        method == "int" -> [Type]{Type.Int, Type.Int}
        (method == "float_range" || method == "normal") -> [Type]{Type.Float, Type.Float}
        method == "bool" && argc == 1 -> [Type]{Type.Float}
        method == "exponential" -> [Type]{Type.Float}
        method == "bytes" -> [Type]{Type.Int}
        else -> [Type]{}
    }
}

fn sema_time_rng_op(method: String, argc: Int) -> THandleOp? {
    return if {
        method == "int" -> Val(THandleOp.RNGInt)
        method == "float" -> Val(THandleOp.RNGFloat)
        method == "float_range" -> Val(THandleOp.RNGFloatRange)
        method == "bool" && argc == 1 -> Val(THandleOp.RNGBoolP)
        method == "bool" -> Val(THandleOp.RNGBool)
        method == "normal" -> Val(THandleOp.RNGNormal)
        method == "exponential" -> Val(THandleOp.RNGExponential)
        method == "bytes" -> Val(THandleOp.RNGBytes)
        method == "split" -> Val(THandleOp.RNGSplit)
        else -> None
    }
}

fn sema_time_rng_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method == "pick" || method == "weighted_pick" || method == "sample" || method == "shuffle" -> return sema_time_rng_generic_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    result :: sema_time_rng_fixed_signature(method, args.len()) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    required :: sema_time_rng_fixed_args(method, args.len())
    values :: sema_time_check_values(args, required, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_time_check_method_ownership(receiver, method, args, required, AccessConvention.Write, span, &scopes, &state, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    operation :: sema_time_rng_op(method, args.len()) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    sema_time_finish_handle(receiver_value, operation, values, result, "Rand", "RNG.{method}", span, expected, environment, &scopes, &context, &diagnostics)
}

fn sema_time_rng_generic_arity(method: String) -> Int Never! {
    if method == "weighted_pick" || method == "sample" -> 2 else -> 1
}

fn sema_time_rng_generic_result(method: String, element: Type) -> Type Never! {
    return if {
        method == "pick" || method == "weighted_pick" -> Type.Option{inner: element}
        method == "sample" -> Type.List{element: element}
        else -> Type.Named{name: "Unit"}
    }
}

fn sema_time_rng_generic_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Write, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    required_arity :: sema_time_rng_generic_arity(method)
    if updated_args.len() != required_arity {
        &diagnostics.push(sema_error("E0104", span, "`.{method}()` takes {required_arity} argument(s), got {updated_args.len()}", "this `RNG` draw operates on a list and optional draw parameter", if {
            method == "weighted_pick" -> "call `rng.weighted_pick(items, weights)`"
            method == "sample" -> "call `rng.sample(items, k)`"
            else -> "call `rng.{method}(items)"
        }))
        _ := sema_time_untyped_values(updated_args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if method == "shuffle" {
        if updated_args[0].convention != AccessConvention.Write {
            &diagnostics.push(sema_error("E0202", updated_args[0].span, "`shuffle` edits its list in place", "the write-access marker `&` is required; pass the list with that marker", "write `rng.shuffle(&items)` with the write-access marker `&`"))
            _ := sema_time_untyped_values(updated_args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    first :: sema_check_expression(updated_args[0].expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    element :: if first.ty == {.List(inner) -> inner else -> {
        &diagnostics.push(sema_error("E0112", updated_args[0].span, "`{method}` needs a list, not {type_name(first.ty)}", "`rng.{method}` operates on a `[T]`", "pass a `[T]` value"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }}
    values := [TExpr]{first}
    if method == "weighted_pick" {
        weights :: sema_check_expression(updated_args[1].expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        if weights.ty != (Type.List{element: Type.Float}) {
            &diagnostics.push(sema_error("E0112", updated_args[1].span, "`weighted_pick` weights must be [Float], not {type_name(weights.ty)}", "`rng.weighted_pick` pairs each item with a non-negative Float weight", "pass a `[Float]` weights list"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        &values.push(weights)
    }
    if method == "sample" {
        count :: sema_check_expression(updated_args[1].expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        count_is_valid := count.ty == Type.Int
        if count.ty == {
            .InlineRange(_, _, _) -> { count_is_valid = true }
            else -> {}
        }
        if !count_is_valid {
            &diagnostics.push(sema_error("E0112", updated_args[1].span, "`sample` count must be Int, not {type_name(count.ty)}", "`rng.sample` chooses up to k items without replacement", "pass an Int count"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        &values.push(count)
    }
    ownership_params := [SemaCallParam]{
        SemaCallParam{label: "items", name: "items", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: if method == "shuffle" -> AccessConvention.Write else -> AccessConvention.Read, ty: Val(Type.List{element: element}), variadic: false},
    }
    if method == "weighted_pick" -> &ownership_params.push(SemaCallParam{label: "weights", name: "weights", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.List{element: Type.Float}), variadic: false})
    if method == "sample" -> &ownership_params.push(SemaCallParam{label: "count", name: "count", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.Int), variadic: false})
    ownership := sema_ownership_check_call_arguments(&state, "RNG.{method}", ownership_params, &updated_args, scopes, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    result :: sema_time_rng_generic_result(method, element)
    operation :: if method == {
        "pick" -> THandleOp.RNGPick
        "weighted_pick" -> THandleOp.RNGWeightedPick
        "sample" -> THandleOp.RNGSample
        else -> THandleOp.RNGShuffle
    }
    if !sema_time_record_intrinsic(result, "Rand", "RNG.{method}", span, environment, &scopes, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tir_expr(result, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: values}, span)
    checked := sema_expr_expected(value, expected, environment, &diagnostics)
    return SemaMethodSpecialCheck{handled: true, value: checked}
}

fn sema_time_default_string(value: String, span: Span) -> Expr Never! {
    Expr.Str{parts: [StrPart]{StrPart.Lit{text: value}}, span: span}
}

fn sema_time_default_int(value: Int, span: Span) -> Expr Never! {
    Expr.Int{value: value, span: span, width: None, raw: Val("{value}")}
}

fn sema_time_contract_param(label: String, ty: Type, default: Expr?) -> SemaCallParam Never! {
    SemaCallParam{
        label: label,
        name: label,
        zone: ParamZone.Either,
        default: default,
        default_ref: None,
        convention: AccessConvention.Read,
        ty: Val(ty),
        variadic: false,
    }
}

fn sema_time_difference_defaults(owner: String) -> [String] Never! {
    return if {
        owner == "Date" || owner == "LocalDate" -> [String]{"day", "day"}
        else -> [String]{"second", "nanosecond"}
    }
}

fn sema_time_civil_contract(owner: String, method: String, span: Span) -> [SemaCallParam]? {
    if method == "until" || method == "since" {
        if owner != "Date" && owner != "LocalDate" && owner != "LocalTime" && owner != "DateTime" && owner != "ZonedDateTime" -> return None
        type :: if owner == "Date" || owner == "LocalDate" -> "LocalDate" else -> owner
        units := sema_time_difference_defaults(owner)
        return Val([SemaCallParam]{
            sema_time_contract_param("other", sema_time_named(type), None),
            sema_time_contract_param("largest_unit", Type.String, Val(sema_time_default_string(units[0], span))),
            sema_time_contract_param("smallest_unit", Type.String, Val(sema_time_default_string(units[1], span))),
            sema_time_contract_param("rounding_mode", Type.String, Val(sema_time_default_string("trunc", span))),
            sema_time_contract_param("increment", Type.Int, Val(sema_time_default_int(1, span))),
        })
    }
    if (method == "truncate" || method == "floor" || method == "ceil") && (owner == "LocalTime" || owner == "DateTime") {
        return Val([SemaCallParam]{
            sema_time_contract_param("unit", Type.String, None),
            sema_time_contract_param("increment", Type.Int, Val(sema_time_default_int(1, span))),
        })
    }
    if method == "round" && (owner == "LocalTime" || owner == "DateTime" || owner == "Duration") {
        return Val([SemaCallParam]{
            sema_time_contract_param("unit", Type.String, None),
            sema_time_contract_param("increment", Type.Int, Val(sema_time_default_int(1, span))),
            sema_time_contract_param("rounding_mode", Type.String, Val(sema_time_default_string("half_expand", span))),
        })
    }
    if method == "with" && (owner == "Date" || owner == "LocalDate") {
        return Val([SemaCallParam]{
            sema_time_contract_param("year", Type.Int, None),
            sema_time_contract_param("month", Type.Int, None),
            sema_time_contract_param("day", Type.Int, None),
            sema_time_contract_param("overflow", Type.String, Val(sema_time_default_string("constrain", span))),
        })
    }
    if method == "with" && owner == "DateTime" {
        return Val([SemaCallParam]{
            sema_time_contract_param("year", Type.Int, None),
            sema_time_contract_param("month", Type.Int, None),
            sema_time_contract_param("day", Type.Int, None),
            sema_time_contract_param("hour", Type.Int, None),
            sema_time_contract_param("minute", Type.Int, None),
            sema_time_contract_param("second", Type.Int, None),
            sema_time_contract_param("overflow", Type.String, Val(sema_time_default_string("constrain", span))),
        })
    }
    if method == "with_time" && owner == "ZonedDateTime" {
        return Val([SemaCallParam]{
            sema_time_contract_param("time", sema_time_named("LocalTime"), None),
            sema_time_contract_param("disambiguation", Type.String, Val(sema_time_default_string("compatible", span))),
        })
    }
    if method == "total_in" && owner == "Period" {
        anchor := Type.Union{members: [Type]{sema_time_named("Date"), sema_time_named("LocalDate"), sema_time_named("DateTime")}}
        return Val([SemaCallParam]{
            sema_time_contract_param("unit", Type.String, None),
            sema_time_contract_param("anchor", anchor, None),
        })
    }
    None
}

fn sema_time_civil_result(owner: String, method: String, argc: Int) -> Type? {
    if {
        owner == "Date" || owner == "LocalDate" -> {
        local_date := sema_time_named("LocalDate")
        if {
            (method == "year" || method == "month" || method == "day" || method == "weekday" || method == "iso_weekday" || method == "day_of_year" || method == "iso_week" || method == "quarter_of_year" || method == "days_in_month" || method == "iso_week_year") && argc == 0 -> return Val(Type.Int)
            method == "is_leap_year" && argc == 0 -> return Val(Type.Bool)
            method == "diff_days" && argc == 1 -> return Val(Type.Int)
            (method == "add_days" || method == "add_months" || method == "truncate") && argc == 1 -> return Val(local_date)
            method == "replace" && argc == 3 -> return Val(local_date)
            (method == "add_period" || method == "subtract_period") && argc == 1 -> return Val(local_date)
            (method == "until" || method == "since") && argc == 5 -> return Val(sema_time_named("Duration"))
            method == "with" && argc == 4 -> return Val(Type.Result{ok: local_date, err: Type.String})
            method == "format_checked" && argc == 1 -> return Val(Type.Result{ok: Type.String, err: sema_time_named("TextError")})
            method == "to_string" && argc == 0 -> return Val(Type.String)
            method == "format" && argc == 1 -> return Val(Type.String)
            method == "equal" && argc == 1 -> return Val(Type.Bool)
            method == "compare" && argc == 1 -> return Val(sema_time_named("Ordering"))
            else -> {}
        }
        }
        owner == "LocalTime" -> {
        if {
            (method == "hour" || method == "minute" || method == "second" || method == "millisecond" || method == "microsecond" || method == "nanosecond") && argc == 0 -> return Val(Type.Int)
            (method == "add_duration" || method == "subtract_duration") && argc == 1 -> return Val(sema_time_named("LocalTime"))
            method == "round" && argc == 3 -> return Val(sema_time_named("LocalTime"))
            (method == "truncate" || method == "floor" || method == "ceil") && argc == 2 -> return Val(sema_time_named("LocalTime"))
            (method == "until" || method == "since") && argc == 5 -> return Val(sema_time_named("Duration"))
            method == "to_string" && argc == 0 -> return Val(Type.String)
            method == "format" && argc == 1 -> return Val(Type.String)
            method == "format_checked" && argc == 1 -> return Val(Type.Result{ok: Type.String, err: sema_time_named("TextError")})
            method == "equal" && argc == 1 -> return Val(Type.Bool)
            method == "compare" && argc == 1 -> return Val(sema_time_named("Ordering"))
            else -> {}
        }
        }
        owner == "DateTime" -> {
        if {
            (method == "hour" || method == "minute" || method == "second" || method == "millisecond" || method == "microsecond" || method == "nanosecond" || method == "to_timestamp" || method == "to_unix_ms" || method == "to_unix_s") && argc == 0 -> return Val(Type.Int)
            (method == "to_unix_us" || method == "to_unix_ns") && argc == 0 -> return Val(Type.Result{ok: Type.Int, err: sema_time_named("RangeError")})
            method == "date" && argc == 0 -> return Val(sema_time_named("LocalDate"))
            method == "time" && argc == 0 -> return Val(sema_time_named("LocalTime"))
            (method == "plus_duration" || method == "subtract_duration" || method == "add_nanoseconds" || method == "add_period" || method == "subtract_period") && argc == 1 -> return Val(sema_time_named("DateTime"))
            (method == "truncate" || method == "floor" || method == "ceil") && argc == 2 -> return Val(sema_time_named("DateTime"))
            method == "round" && argc == 3 -> return Val(sema_time_named("DateTime"))
            method == "difference" && argc == 1 -> return Val(sema_time_named("Duration"))
            (method == "until" || method == "since") && argc == 5 -> return Val(sema_time_named("Duration"))
            method == "replace" && argc == 6 -> return Val(sema_time_named("DateTime"))
            method == "with" && argc == 7 -> return Val(Type.Result{ok: sema_time_named("DateTime"), err: Type.String})
            method == "in_zone" && argc == 1 -> return Val(sema_time_named("ZonedDateTime"))
            (method == "to_string" || method == "format_rfc3339") && argc == 0 -> return Val(Type.String)
            method == "format" && argc == 1 -> return Val(Type.String)
            method == "format_checked" && argc == 1 -> return Val(Type.Result{ok: Type.String, err: sema_time_named("TextError")})
            method == "equal" && argc == 1 -> return Val(Type.Bool)
            method == "compare" && argc == 1 -> return Val(sema_time_named("Ordering"))
            else -> {}
        }
        }
        owner == "Instant" -> {
        if {
            method == "elapsed_millis" && argc == 0 -> return Val(Type.Int)
            method == "elapsed" && argc == 0 -> return Val(sema_time_named("Duration"))
            method == "equal" && argc == 1 -> return Val(Type.Bool)
            method == "compare" && argc == 1 -> return Val(sema_time_named("Ordering"))
            else -> {}
        }
        }
        owner == "Period" -> {
        if {
            (method == "years" || method == "months" || method == "days" || method == "sign") && argc == 0 -> return Val(Type.Int)
            method == "is_zero" && argc == 0 -> return Val(Type.Bool)
            (method == "abs" || method == "negated") && argc == 0 -> return Val(sema_time_named("Period"))
            (method == "add" || method == "sub") && argc == 1 -> return Val(sema_time_named("Period"))
            method == "total_in" && argc == 2 -> return Val(Type.Float)
            method == "to_string" && argc == 0 -> return Val(Type.String)
            else -> {}
        }
        }
        owner == "Duration" -> {
        if method == "round" && argc == 3 -> return Val(sema_time_named("Duration"))
        }
        owner == "Zone" -> {
        if {
            method == "name" && argc == 0 -> return Val(Type.String)
            (method == "next_transition" || method == "previous_transition") && argc == 1 -> return Val(Type.Option{inner: Type.Int})
            method == "start_of_day" && argc == 1 -> return Val(sema_time_named("ZonedDateTime"))
            method == "hours_in_day" && argc == 1 -> return Val(Type.Int)
            else -> {}
        }
        }
        owner == "ZonedDateTime" -> {
        if {
            method == "date" && argc == 0 -> return Val(sema_time_named("LocalDate"))
            method == "time" && argc == 0 -> return Val(sema_time_named("LocalTime"))
            method == "offset_seconds" && argc == 0 -> return Val(Type.Int)
            method == "is_dst" && argc == 0 -> return Val(Type.Bool)
            method == "to_datetime" && argc == 0 -> return Val(sema_time_named("DateTime"))
            method == "zone" && argc == 0 -> return Val(sema_time_named("Zone"))
            (method == "add_duration" || method == "subtract_duration" || method == "add_period" || method == "subtract_period") && argc == 1 -> return Val(sema_time_named("ZonedDateTime"))
            method == "with_time" && argc == 2 -> return Val(Type.Result{ok: sema_time_named("ZonedDateTime"), err: Type.String})
            method == "with_zone" && argc == 1 -> return Val(sema_time_named("ZonedDateTime"))
            method == "equal" && argc == 1 -> return Val(Type.Bool)
            method == "compare" && argc == 1 -> return Val(sema_time_named("Ordering"))
            (method == "until" || method == "since") && argc == 5 -> return Val(sema_time_named("Duration"))
            (method == "next_transition" || method == "previous_transition") && argc == 0 -> return Val(Type.Option{inner: Type.Int})
            method == "start_of_day" && argc == 0 -> return Val(sema_time_named("ZonedDateTime"))
            method == "hours_in_day" && argc == 0 -> return Val(Type.Int)
            (method == "format_rfc9557" || method == "to_string") && argc == 0 -> return Val(Type.String)
            method == "format" && argc == 1 -> return Val(Type.String)
            method == "format_checked" && argc == 1 -> return Val(Type.Result{ok: Type.String, err: sema_time_named("TextError")})
            else -> {}
        }
        }
    }
    return None
}

fn sema_time_civil_args(owner: String, method: String) -> [Type] Never! {
    if owner == "Date" || owner == "LocalDate" {
        if method == "add_days" || method == "add_months" -> return [Type]{Type.Int}
        if method == "diff_days" || method == "equal" || method == "compare" -> return [Type]{sema_time_named("LocalDate")}
        if method == "add_period" || method == "subtract_period" -> return [Type]{sema_time_named("Period")}
        if method == "truncate" || method == "format" || method == "format_checked" -> return [Type]{Type.String}
        if method == "replace" -> return [Type]{Type.Int, Type.Int, Type.Int}
    }
    if owner == "LocalTime" {
        if method == "add_duration" || method == "subtract_duration" -> return [Type]{sema_time_named("Duration")}
        if method == "format" || method == "format_checked" -> return [Type]{Type.String}
        if method == "equal" || method == "compare" -> return [Type]{sema_time_named("LocalTime")}
    }
    if owner == "DateTime" {
        if method == "plus_duration" || method == "subtract_duration" -> return [Type]{sema_time_named("Duration")}
        if method == "add_nanoseconds" -> return [Type]{Type.Int}
        if method == "add_period" || method == "subtract_period" -> return [Type]{sema_time_named("Period")}
        if method == "difference" || method == "equal" || method == "compare" -> return [Type]{sema_time_named("DateTime")}
        if method == "in_zone" -> return [Type]{sema_time_named("Zone")}
        if method == "format" || method == "format_checked" -> return [Type]{Type.String}
        if method == "replace" -> return [Type]{Type.Int, Type.Int, Type.Int, Type.Int, Type.Int, Type.Int}
    }
    if owner == "Instant" {
        if method == "equal" || method == "compare" -> return [Type]{sema_time_named("Instant")}
    }
    if owner == "Period" {
        if method == "add" || method == "sub" -> return [Type]{sema_time_named("Period")}
    }
    if owner == "Zone" {
        if method == "next_transition" || method == "previous_transition" -> return [Type]{Type.Int}
        if method == "start_of_day" || method == "hours_in_day" -> return [Type]{sema_time_named("LocalDate")}
    }
    if owner == "ZonedDateTime" {
        if method == "add_duration" || method == "subtract_duration" -> return [Type]{sema_time_named("Duration")}
        if method == "add_period" || method == "subtract_period" -> return [Type]{sema_time_named("Period")}
        if method == "with_zone" -> return [Type]{sema_time_named("Zone")}
        if method == "equal" || method == "compare" -> return [Type]{sema_time_named("ZonedDateTime")}
        if method == "format" || method == "format_checked" -> return [Type]{Type.String}
    }
    [Type]{}
}

fn sema_time_civil_finish(receiver: Expr, receiver_value: TExpr, owner: String, method: String, values: [TExpr], result: Type, args: [CallArg], params: [SemaCallParam], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, context: &SemaCheckContext, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    ownership :: sema_ownership_check_method_call(&state, "{owner}.{method}", receiver, AccessConvention.Read, params, &updated_args, scopes, span, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    operation :: if owner == "Duration" && method == "round" -> THandleOp.DurationRound else -> THandleOp.CivilTimeMethod{kind: owner, method: method}
    sema_time_finish_handle(receiver_value, operation, values, result, "", "{owner}.{method}", span, expected, environment, &scopes, &context, &diagnostics)
}

fn sema_time_civil_method(receiver: Expr, receiver_value: TExpr, owner: String, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    contract :: sema_time_civil_contract(owner, method, span)
    if contract == .Val(params) {
        source_args := args
        binding :: sema_call_bind_args("{owner}.{method}", params, &source_args, span, &diagnostics) ?? {
            _ := sema_time_untyped_values(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        lowered :: sema_call_check_bound_arguments(&state, "{owner}.{method}", params, binding, &source_args, environment, &scopes, &tail_store, &context, span, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        result :: sema_time_civil_result(owner, method, lowered.len()) ?? return SemaMethodSpecialCheck{handled: false, value: None}
        values := [TExpr]{}
        loop argument in lowered -> &values.push(argument.value)
        return sema_time_civil_finish(receiver, receiver_value, owner, method, values, result, source_args, params, span, expected, environment, &scopes, &context, &state, &diagnostics)
    }
    result :: sema_time_civil_result(owner, method, args.len()) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    required := sema_time_civil_args(owner, method)
    if required.len() != args.len() -> return SemaMethodSpecialCheck{handled: false, value: None}
    values :: sema_time_check_values(args, required, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    sema_time_civil_finish(receiver, receiver_value, owner, method, values, result, args, sema_time_method_params(required), span, expected, environment, &scopes, &context, &state, &diagnostics)
}

fn sema_time_core_call(method: String, result: Type, api: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    record :: core_call("core.time", method) ?? {
        &diagnostics.push(sema_error("E0906", span, "the canonical `core.time.{method}` route is unavailable", "compiler-owned time constructors use the registered CoreCall row", "restore the registered `core.time.{method}` route"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_time_record_intrinsic(result, "Time", api, span, environment, &scopes, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tir_expr(result, TExprKind.CoreCall{record: record, args: [TExpr]{}, source_span: span, type_args: [Type]{}, widen_to_vec: [Bool]{}, data_plan: None, fallibility: TFailureCarrier.Infallible}, span)
    checked := sema_expr_expected(value, expected, environment, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

pub fn sema_call_try_time_static_method(owner: String, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    if owner == "Clock" {
        if method == "new" && updated_args.len() == 1 {
            values :: sema_time_check_values(updated_args, [Type]{Type.Int}, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
            ownership := sema_ownership_check_call_arguments(&state, "Clock.new", sema_time_method_params([Type]{Type.Int}), &updated_args, scopes, &diagnostics)
            if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
            result := Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.DeterministicClock}, inner: sema_time_named("Clock")}
            if !sema_time_record_intrinsic(result, "", "Clock.new", span, environment, &scopes, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
            seed :: values[0]
            value := sema_tir_expr(result, TExprKind.HostCall{call: THostCall.Helper{helper: "jet_std_clock_new", kind: THelperKind.ClockNew, args: [THostArg]{THostArg.Expr{value: seed}}}}, span)
            return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, &diagnostics)}
        }
        if method == "system" && updated_args.len() == 0 {
            result := Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.SystemClock}, inner: sema_time_named("Clock")}
            if !sema_time_record_intrinsic(result, "Time", "Clock.system", span, environment, &scopes, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
            value := sema_tir_expr(result, TExprKind.HostCall{call: THostCall.Helper{helper: "jet_std_clock_system", kind: THelperKind.ClockSystem, args: [THostArg]{}}}, span)
            return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, &diagnostics)}
        }
        if method == "now" && updated_args.len() == 0 -> return sema_time_core_call("instant", sema_time_named("Instant"), "Clock.now", span, expected, environment, &scopes, &context, &diagnostics)
    }
    if owner == "Date" && method == "today" && updated_args.len() == 0 -> return sema_time_core_call("today", sema_time_named("Date"), "Date.today", span, expected, environment, &scopes, &context, &diagnostics)
    SemaMethodSpecialCheck{handled: false, value: None}
}

pub fn sema_call_try_time_handle_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    receiver_name :: sema_time_handle_receiver_name(receiver_value.ty)
    if receiver_name == "Clock" -> return sema_time_clock_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if receiver_name == "RNG" -> return sema_time_rng_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if receiver_name == "Date" || receiver_name == "LocalDate" || receiver_name == "LocalTime" || receiver_name == "DateTime" || receiver_name == "Instant" || receiver_name == "Period" || receiver_name == "Duration" || receiver_name == "Zone" || receiver_name == "ZonedDateTime" {
        return sema_time_civil_method(receiver, receiver_value, receiver_name, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}
