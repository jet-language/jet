// Checked Clock reads. Duration's methods are core.time source functions
// (sema_call_try_duration_source); Core's `RNG` and `DeterministicWorld` are
// source records, so their methods are ordinary checked method calls.
use jet_foundation.[
    AST_NODE_GENERATED,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    InternalTag,
    Span,
    TFailureCarrier,
    TagMarker,
    Type,
]

sema_time_named: fn(name: String) -> Type Never! { Type.Named{name: name} }

sema_time_handle_receiver_name: fn(ty: Type) -> String Never! {
    if ty == {
        .Named(name) -> if sema_call_is_clock_type(ty) -> "Clock" else -> name
        .Tagged(_, inner) -> sema_time_handle_receiver_name(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ""
    }
}

sema_time_failure_carrier: fn(result: Type) -> TFailureCarrier Never! {
    if result == {
        // copy: `ok` and `err` are payloads of read parameter `result`, which keeps the originals; the new TFailureCarrier.Result's fields own `ok` and `err`
        .Result(ok, err) -> TFailureCarrier.Result{success: ok.copy(), error: err.copy()}
        // copy: `inner` is a payload of read parameter `result`, which keeps the original; field `value` of the new TFailureCarrier.Optional owns this one
        .Option(inner) -> TFailureCarrier.Optional{value: inner.copy()}
        .Named(name) -> if name == "Never" -> TFailureCarrier.Diverges{value: result} else -> TFailureCarrier.Infallible
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> TFailureCarrier.Infallible
    }
}

sema_time_record_intrinsic: fn(result: Type, effect_name: String, api: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> Bool Never! {
    effects := [EffectRowEntry]{}
    if effect_name != "" -> effects.push(EffectRowEntry{name: effect_name, span: span})
    facts := SemaCallFacts{
        return_type: result,
        failure_carrier: sema_time_failure_carrier(result),
        effect_bound: Val(effects),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(environment, program, scopes, context, api, span, facts, diagnostics)
}

sema_time_clock_is_deterministic: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(marker, inner) -> marker == TagMarker.Internal{internal_tag: InternalTag.DeterministicClock} && sema_time_handle_receiver_name(inner) == "Clock"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// A pure function's Clock parameter is injected by its caller, so the body
// reads it as a deterministic clock (Rust Registration `deterministic_clock_type`).
// None when `ty` is not an untagged Clock.
sema_time_injected_clock: fn(ty: Type) -> Type? Never! {
    if !sema_call_is_clock_type(ty) || sema_time_clock_is_deterministic(ty) -> return None
    // copy: `ty` is a read parameter; the tag's `inner` owns this one
    Val(Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.DeterministicClock}, inner: ty.copy()})
}

sema_time_clock_is_system: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(marker, inner) -> marker == TagMarker.Internal{internal_tag: InternalTag.SystemClock} && sema_time_handle_receiver_name(inner) == "Clock"
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

sema_time_clock_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, state: ^SemaOwnershipState, tail_store: ^SemaStatementTailStore, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> SemaMethodSpecialCheck {
    recorded: sema_time_clock_record(receiver_value, method, args, span, environment, program, scopes, context, diagnostics) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if !recorded -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_call_check_method(state, receiver, method, span, [Type]{}, [Type]{}, args, span, expected, environment, program, scopes, tail_store, context, diagnostics)
    SemaMethodSpecialCheck{handled: true, value: value}
}

// Records a Clock read's `Clock.{method}` site: `Time` unless the receiver is
// the deterministic or system clock. None when `method` reads no time; false
// when the transaction wall refused the site (its diagnostic is the report).
sema_time_clock_record: fn(receiver_value: TExpr, method: String, args: [CallArg], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> Bool? Never! {
    result: if {
        method == "now" && args.len() == 0 -> Val(Type.Int)
        (method == "tick" || method == "advance") && args.len() == 1 -> Val(Type.Int)
        method == "wait" && args.len() == 1 -> Val(Type.Int)
        else -> None
    }
    if result == None -> return None
    effect_name: if sema_time_clock_is_deterministic(receiver_value.ty) || sema_time_clock_is_system(receiver_value.ty) -> "" else -> "Time"
    Val(sema_time_record_intrinsic(result, effect_name, "Clock.{method}", span, environment, program, scopes, context, diagnostics))
}

sema_call_try_time_static_method: fn(owner: String, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, state: ^SemaOwnershipState, tail_store: ^SemaStatementTailStore, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    if owner == "Clock" {
        if method == "new" && updated_args.len() == 1 {
            result := Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.DeterministicClock}, inner: sema_time_named("Clock")}
            if !sema_time_record_intrinsic(result, "", "Clock.new", span, environment, program, scopes, context, diagnostics) {
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            source := sema_call_try_static_method(Expr.Ident{name: "Clock", span: span, id: AST_NODE_GENERATED}, method, span, [Type]{}, [Type]{}, updated_args, span, None, environment, program, scopes, state, tail_store, context, diagnostics)
            value := source.value ?? return SemaMethodSpecialCheck{handled: true, value: None}
            return SemaMethodSpecialCheck{handled: true, value: sema_time_clock_retagged(value, result, expected, environment, program, diagnostics)}
        }
        if method == "system" && updated_args.len() == 0 {
            result := Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.SystemClock}, inner: sema_time_named("Clock")}
            if !sema_time_record_intrinsic(result, "Time", "Clock.system", span, environment, program, scopes, context, diagnostics) {
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            source := sema_call_try_static_method(Expr.Ident{name: "Clock", span: span, id: AST_NODE_GENERATED}, method, span, [Type]{}, [Type]{}, updated_args, span, None, environment, program, scopes, state, tail_store, context, diagnostics)
            value := source.value ?? return SemaMethodSpecialCheck{handled: true, value: None}
            return SemaMethodSpecialCheck{handled: true, value: sema_time_clock_retagged(value, result, expected, environment, program, diagnostics)}
        }
        if method == "now" && updated_args.len() == 0 {
            constructor: Expr.MethodCall{receiver: Expr.Ident{name: "Instant", span: span, id: AST_NODE_GENERATED}, method: "__now", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, id: AST_NODE_GENERATED}
            return SemaMethodSpecialCheck{handled: true, value: sema_check_expression(constructor, expected, environment, program, scopes, state, tail_store, context, diagnostics)}
        }
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}

// The source constructor's `Clock Never!` keeps its carrier: only the success
// slot takes the clock tag, so the call root still propagates (unwraps) the
// Result the callee returns instead of reading it as a bare Clock.
sema_time_clock_retagged: fn(value: ^^TExpr, tagged: Type, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: ^[Diagnostic]) -> TExpr? {
    retagged := value.move()
    if retagged.ty == .Result(_, err) {
        // copy: `err` is a payload of `retagged.ty`, which the new Type.Result replaces
        tree_expr_retype(retagged, Type.Result{ok: tagged, err: err.copy()})
        return Val(retagged)
    }
    tree_expr_retype(retagged, tagged)
    sema_expr_expected(retagged, expected, environment, program, diagnostics)
}

sema_call_try_time_handle_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, state: ^SemaOwnershipState, tail_store: ^SemaStatementTailStore, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> SemaMethodSpecialCheck {
    receiver_name: sema_time_handle_receiver_name(receiver_value.ty)
    if receiver_name == "Clock" {
        return sema_time_clock_method(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}
