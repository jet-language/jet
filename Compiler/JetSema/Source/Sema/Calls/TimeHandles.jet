// Checked deterministic time/random handles and the built-in Duration methods.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    InternalTag,
    ParamZone,
    Span,
    StrPart,
    TExpr,
    TExprKind,
    TLetTy,
    TStmt,
    TFailureCarrier,
    THandleOp,
    TagMarker,
    Type,
    type_name,
]

fn sema_time_named(name: String) -> Type Never! {
    Type.Named{name: name}
}

fn sema_time_handle_receiver_name(ty: Type) -> String Never! {
    if ty == {
        .Named(name) -> name
        .Tagged(_, inner) -> sema_time_handle_receiver_name(inner)
        else -> ""
    }
}

fn sema_time_failure_carrier(result: Type) -> TFailureCarrier Never! {
    if result == {
        // copy: `ok` and `err` are payloads of read parameter `result`, which keeps the originals; the new TFailureCarrier.Result's fields own `ok` and `err`
        .Result(ok, err) -> TFailureCarrier.Result{success: ok.copy(), error: err.copy()}
        // copy: `inner` is a payload of read parameter `result`, which keeps the original; field `value` of the new TFailureCarrier.Optional owns this one
        .Option(inner) -> TFailureCarrier.Optional{value: inner.copy()}
        .Named(name) -> if name == "Never" -> TFailureCarrier.Diverges{value: result} else -> TFailureCarrier.Infallible
        else -> TFailureCarrier.Infallible
    }
}

fn sema_time_record_intrinsic(result: Type, effect_name: String, api: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool Never! {
    effects := [EffectRowEntry]{}
    if effect_name != "" -> &effects.push(EffectRowEntry{name: effect_name, span: span})
    facts := SemaCallFacts{
        return_type: result,
        failure_carrier: sema_time_failure_carrier(result),
        effect_bound: Val(effects),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(environment, program, &scopes, &context, api, span, facts, &diagnostics)
}

fn sema_time_check_values(args: [CallArg], required: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [TExpr]? {
    if args.len() != required.len() -> return None
    values := [TExpr]{}
    loop index in 0..<args.len() {
        value :: sema_check_expression(args[index].expr, Val(required[index]), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        &values.push(value)
    }
    Val(values)
}

fn sema_time_untyped_values(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [TExpr]? {
    values := [TExpr]{}
    loop argument in args {
        value :: sema_check_expression(argument.expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        &values.push(value)
    }
    Val(values)
}

fn sema_time_method_params(required: [Type]) -> [SemaCallParam] Never! {
    params := [SemaCallParam]{}
    loop (index, ty) in required {
        &params.push(SemaCallParam{
            label: "arg{index}",
            name: "arg{index}",
            zone: ParamZone.PositionalOnly,
            default: None,
            default_ref: None,
            convention: AccessConvention.Read,
            ty: Val(ty),
            variadic: false,
        })
    }
    params
}

fn sema_time_check_method_ownership(receiver: Expr, method: String, args: [CallArg], required: [Type], receiver_access: AccessConvention, span: Span, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> Bool {
    updated_args := args
    checked := sema_ownership_check_method_call(&state, method, receiver, receiver_access, sema_time_method_params(required), &updated_args, scopes, span, &diagnostics)
    checked.accepted && checked.complete
}

fn sema_time_finish_handle(receiver: TExpr, operation: THandleOp, args: [TExpr], result: Type, effect_name: String, api: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    if !sema_time_record_intrinsic(result, effect_name, api, span, environment, program, &scopes, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tir_node(result, TExprKind.HandleMethod{receiver: receiver, operation: operation, args: args}, span)
    checked := sema_expr_expected(value, expected, environment, program, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

fn sema_time_clock_is_deterministic(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(marker, inner) -> marker == TagMarker.Internal{internal_tag: InternalTag.DeterministicClock} && sema_time_handle_receiver_name(inner) == "Clock"
        else -> false
    }
}

fn sema_time_clock_is_system(ty: Type) -> Bool Never! {
    if ty == {
        .Tagged(marker, inner) -> marker == TagMarker.Internal{internal_tag: InternalTag.SystemClock} && sema_time_handle_receiver_name(inner) == "Clock"
        else -> false
    }
}

fn sema_time_clock_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    result :: if {
        method == "now" && args.len() == 0 -> Val(Type.Int)
        (method == "tick" || method == "advance") && args.len() == 1 -> Val(Type.Int)
        method == "wait" && args.len() == 1 -> Val(Type.Int)
        else -> None
    }
    if result == None -> return SemaMethodSpecialCheck{handled: false, value: None}
    effect_name :: if sema_time_clock_is_deterministic(receiver_value.ty) || sema_time_clock_is_system(receiver_value.ty) -> "" else -> "Time"
    if !sema_time_record_intrinsic(result, effect_name, "Clock.{method}", span, environment, program, &scopes, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_call_check_method(&state, receiver, method, span, [Type]{}, [Type]{}, args, span, expected, environment, program, &scopes, &tail_store, &context, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: value}
}

fn sema_time_rng_fixed_signature(method: String, argc: Int) -> Type? {
    return if {
        method == "int" && argc == 2 -> Val(Type.Int)
        method == "float" && argc == 0 -> Val(Type.Float)
        method == "float_range" && argc == 2 -> Val(Type.Float)
        method == "bool" && (argc == 0 || argc == 1) -> Val(Type.Bool)
        method == "normal" && argc == 2 -> Val(Type.Float)
        method == "exponential" && argc == 1 -> Val(Type.Float)
        method == "bytes" && argc == 1 -> Val(Type.List{element: Type.IntN{signed: false, bits: 8}})
        method == "split" && argc == 0 -> Val(sema_time_named("RNG"))
        else -> None
    }
}

fn sema_time_rng_fixed_args(method: String, argc: Int) -> [Type] Never! {
    return if {
        method == "int" -> [Type]{Type.Int, Type.Int}
        (method == "float_range" || method == "normal") -> [Type]{Type.Float, Type.Float}
        method == "bool" && argc == 1 -> [Type]{Type.Float}
        method == "exponential" -> [Type]{Type.Float}
        method == "bytes" -> [Type]{Type.Int}
        else -> [Type]{}
    }
}

fn sema_time_rng_op(method: String, argc: Int) -> THandleOp? {
    return if {
        method == "int" -> Val(THandleOp.RNGInt)
        method == "float" -> Val(THandleOp.RNGFloat)
        method == "float_range" -> Val(THandleOp.RNGFloatRange)
        method == "bool" && argc == 1 -> Val(THandleOp.RNGBoolP)
        method == "bool" -> Val(THandleOp.RNGBool)
        method == "normal" -> Val(THandleOp.RNGNormal)
        method == "exponential" -> Val(THandleOp.RNGExponential)
        method == "bytes" -> Val(THandleOp.RNGBytes)
        method == "split" -> Val(THandleOp.RNGSplit)
        else -> None
    }
}

fn sema_time_rng_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method == "pick" || method == "weighted_pick" || method == "sample" || method == "shuffle" -> return sema_time_rng_generic_method(receiver, receiver_value, method, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    result :: sema_time_rng_fixed_signature(method, args.len()) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    required :: sema_time_rng_fixed_args(method, args.len())
    values :: sema_time_check_values(args, required, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_time_check_method_ownership(receiver, method, args, required, AccessConvention.Write, span, &scopes, &state, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    operation :: sema_time_rng_op(method, args.len()) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    sema_time_finish_handle(receiver_value, operation, values, result, "Rand", "RNG.{method}", span, expected, environment, program, &scopes, &context, &diagnostics)
}

fn sema_time_rng_generic_arity(method: String) -> Int Never! {
    if method == "weighted_pick" || method == "sample" -> 2 else -> 1
}

fn sema_time_rng_generic_result(method: String, element: Type) -> Type Never! {
    return if {
        method == "pick" || method == "weighted_pick" -> Type.Option{inner: element}
        method == "sample" -> Type.List{element: element}
        else -> Type.Named{name: "Unit"}
    }
}

fn sema_time_rng_generic_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Write, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    required_arity :: sema_time_rng_generic_arity(method)
    if updated_args.len() != required_arity {
        &diagnostics.push(sema_error("E0104", span, "`.{method}()` takes {required_arity} argument(s), got {updated_args.len()}", "this `RNG` draw operates on a list and optional draw parameter", if {
            method == "weighted_pick" -> "call `rng.weighted_pick(items, weights)`"
            method == "sample" -> "call `rng.sample(items, k)`"
            else -> "call `rng.{method}(items)"
        }))
        _ := sema_time_untyped_values(updated_args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if method == "shuffle" {
        if updated_args[0].convention != AccessConvention.Write {
            &diagnostics.push(sema_error("E0202", updated_args[0].span, "`shuffle` edits its list in place", "the write-access marker `&` is required; pass the list with that marker", "write `rng.shuffle(&items)` with the write-access marker `&`"))
            _ := sema_time_untyped_values(updated_args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    first :: sema_check_expression(updated_args[0].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    element :: if first.ty == {.List(inner) -> inner else -> {
        &diagnostics.push(sema_error("E0112", updated_args[0].span, "`{method}` needs a list, not {type_name(first.ty)}", "`rng.{method}` operates on a `[T]`", "pass a `[T]` value"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }}
    values := [TExpr]{first}
    if method == "weighted_pick" {
        weights :: sema_check_expression(updated_args[1].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        if weights.ty != (Type.List{element: Type.Float}) {
            &diagnostics.push(sema_error("E0112", updated_args[1].span, "`weighted_pick` weights must be [Float], not {type_name(weights.ty)}", "`rng.weighted_pick` pairs each item with a non-negative Float weight", "pass a `[Float]` weights list"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        &values.push(weights)
    }
    if method == "sample" {
        count :: sema_check_expression(updated_args[1].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        count_is_valid := count.ty == Type.Int
        if count.ty == {
            .InlineRange(_, _, _) -> { count_is_valid = true }
            else -> {}
        }
        if !count_is_valid {
            &diagnostics.push(sema_error("E0112", updated_args[1].span, "`sample` count must be Int, not {type_name(count.ty)}", "`rng.sample` chooses up to k items without replacement", "pass an Int count"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        &values.push(count)
    }
    ownership_params := [SemaCallParam]{
        SemaCallParam{label: "items", name: "items", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: if method == "shuffle" -> AccessConvention.Write else -> AccessConvention.Read, ty: Val(Type.List{element: element}), variadic: false},
    }
    if method == "weighted_pick" -> &ownership_params.push(SemaCallParam{label: "weights", name: "weights", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.List{element: Type.Float}), variadic: false})
    if method == "sample" -> &ownership_params.push(SemaCallParam{label: "count", name: "count", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.Int), variadic: false})
    ownership := sema_ownership_check_call_arguments(&state, "RNG.{method}", ownership_params, &updated_args, scopes, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    result :: sema_time_rng_generic_result(method, element)
    operation :: if method == {
        "pick" -> THandleOp.RNGPick
        "weighted_pick" -> THandleOp.RNGWeightedPick
        "sample" -> THandleOp.RNGSample
        else -> THandleOp.RNGShuffle
    }
    if !sema_time_record_intrinsic(result, "Rand", "RNG.{method}", span, environment, program, &scopes, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tir_node(result, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: values}, span)
    checked := sema_expr_expected(value, expected, environment, program, &diagnostics)
    return SemaMethodSpecialCheck{handled: true, value: checked}
}

fn sema_time_default_string(value: String, span: Span) -> Expr Never! {
    Expr.Str{parts: [StrPart]{StrPart.Lit{text: value}}, span: span}
}

fn sema_time_default_int(value: Int, span: Span) -> Expr Never! {
    Expr.Int{value: value, span: span, width: None, raw: Val("{value}")}
}

fn sema_time_contract_param(label: String, ty: Type, default: Expr?) -> SemaCallParam Never! {
    SemaCallParam{
        label: label,
        name: label,
        zone: ParamZone.Either,
        default: default,
        default_ref: None,
        convention: AccessConvention.Read,
        ty: Val(ty),
        variadic: false,
    }
}

fn sema_time_civil_contract(owner: String, method: String, span: Span) -> [SemaCallParam]? {
    if method == "round" && owner == "Duration" {
        return Val([SemaCallParam]{
            sema_time_contract_param("unit", Type.String, None),
            sema_time_contract_param("increment", Type.Int, Val(sema_time_default_int(1, span))),
            sema_time_contract_param("rounding_mode", Type.String, Val(sema_time_default_string("half_expand", span))),
        })
    }
    None
}

fn sema_time_civil_result(owner: String, method: String, argc: Int) -> Type? {
    if owner == "Duration" && method == "round" && argc == 3 -> return Val(sema_time_named("Duration"))
    None
}

fn sema_time_civil_value(receiver_value: TExpr, owner: String, method: String, values: [TExpr], result: Type, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    operation :: if owner == "Duration" && method == "round" -> THandleOp.DurationRound else -> THandleOp.CivilTimeMethod{kind: owner, method: method}
    sema_time_finish_handle(receiver_value, operation, values, result, "", "{owner}.{method}", span, expected, environment, program, &scopes, &context, &diagnostics)
}

fn sema_time_civil_finish(receiver: Expr, receiver_value: TExpr, owner: String, method: String, values: [TExpr], result: Type, args: [CallArg], params: [SemaCallParam], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    ownership :: sema_ownership_check_method_call(&state, "{owner}.{method}", receiver, AccessConvention.Read, params, &updated_args, scopes, span, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    operation :: THandleOp.DurationRound
    sema_time_finish_handle(receiver_value, operation, values, result, "", "{owner}.{method}", span, expected, environment, program, &scopes, &context, &diagnostics)
}

fn sema_time_civil_method(receiver: Expr, receiver_value: TExpr, owner: String, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    contract :: sema_time_civil_contract(owner, method, span)
    if contract == .Val(params) {
        source_args := args
        binding :: sema_call_bind_args("{owner}.{method}", params, &source_args, span, &diagnostics) ?? {
            _ := sema_time_untyped_values(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        typed :: sema_call_typecheck_bound_arguments("{owner}.{method}", params, None, false, binding, &source_args, environment, program, &scopes, &state, &tail_store, &context, span, &diagnostics, false) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        ownership :: sema_ownership_check_method_call(&state, "{owner}.{method}", receiver, AccessConvention.Read, params, &source_args, scopes, span, &diagnostics)
        if !ownership.accepted || !ownership.complete -> return SemaMethodSpecialCheck{handled: true, value: None}
        lowered := sema_call_lower_bound_arguments(typed, params, &source_args, environment, program)
        if !sema_call_prepare_variadic_elements(typed, params, source_args, &lowered, environment, program, &scopes, &state, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        pins := [TStmt]{}
        pinned_receiver := receiver_value
        if typed.pin_arguments {
            borrowed :: sema_ownership_places_from_expr_in_state(receiver, scopes, &state).len() > 0
            pin_slot :: -typed.values.len() - 1
            symbol :: sema_call_binder_ref_symbol(environment, program, sema_scope_function_owner_key(scopes), typed.binder_site, pin_slot, "receiver", receiver_value.ty, span)
            local := tir_symbol_local("binder_ref_{typed.binder_site}_{pin_slot}", span, symbol.id)
            local.generated = true
            local.deref = borrowed
            init := receiver_value
            if borrowed -> init = sema_tir_node(init.ty, TExprKind.Borrow{place: init, access: AccessConvention.Read}, init.span)
            &pins.push(TStmt.Let{local: local, let_ty: TLetTy.Inferred, init: init, gc_promotion: None, gc_transferred: false, span: span})
            pinned_receiver = sema_tir_node(receiver_value.ty, TExprKind.Local{local: local}, receiver_value.span)
        }
        loop pin in sema_call_pin_binder_arguments(typed, params, &lowered, environment, program, scopes, span) -> &pins.push(pin)
        packed :: sema_call_pack_variadic_arguments(typed, params, lowered, environment, program, &context, span, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        result :: sema_time_civil_result(owner, method, packed.len()) ?? return SemaMethodSpecialCheck{handled: false, value: None}
        values := [TExpr]{}
        loop argument in packed -> &values.push(argument.value)
        finished :: sema_time_civil_value(pinned_receiver, owner, method, values, result, span, expected, environment, program, &scopes, &context, &diagnostics)
        value :: finished.value ?? return SemaMethodSpecialCheck{handled: true, value: None}
        return SemaMethodSpecialCheck{handled: true, value: Val(sema_call_with_binder_pins(^pins, ^value, span))}
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}

fn sema_call_try_time_static_method(owner: String, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    updated_args := args
    if owner == "Clock" {
        if method == "new" && updated_args.len() == 1 {
            result := Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.DeterministicClock}, inner: sema_time_named("Clock")}
            if !sema_time_record_intrinsic(result, "", "Clock.new", span, environment, program, &scopes, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
            source := sema_call_try_static_method(Expr.Ident{name: "Clock", span: span}, method, span, [Type]{}, [Type]{}, updated_args, span, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            value := source.value ?? return SemaMethodSpecialCheck{handled: true, value: None}
            value.ty = result
            return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
        }
        if method == "system" && updated_args.len() == 0 {
            result := Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.SystemClock}, inner: sema_time_named("Clock")}
            if !sema_time_record_intrinsic(result, "Time", "Clock.system", span, environment, program, &scopes, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
            source := sema_call_try_static_method(Expr.Ident{name: "Clock", span: span}, method, span, [Type]{}, [Type]{}, updated_args, span, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            value := source.value ?? return SemaMethodSpecialCheck{handled: true, value: None}
            value.ty = result
            return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
        }
        if method == "now" && updated_args.len() == 0 {
            constructor :: Expr.MethodCall{receiver: Expr.Ident{name: "Instant", span: span}, method: "__now", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, recv_type: None, resolved_ret: None, operator_rhs: None, checked_widen: false, checked_callee: None}
            return SemaMethodSpecialCheck{handled: true, value: sema_check_expression(constructor, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)}
        }
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}

fn sema_call_try_time_handle_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    receiver_name :: sema_time_handle_receiver_name(receiver_value.ty)
    if receiver_name == "Clock" -> return sema_time_clock_method(receiver, receiver_value, method, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    if receiver_name == "RNG" -> return sema_time_rng_method(receiver, receiver_value, method, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    if receiver_name == "Duration" {
        if method != "round" -> return sema_time_duration_method(receiver, receiver_value, method, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return sema_time_civil_method(receiver, receiver_value, receiver_name, method, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}

// Rust `duration_method_return` / `builtin_method_arg_types` (D-SHAPE-DURATIONCONVERT1=A,
// D-TIMERES1=A): the built-in Duration readers. Another name or arity is no
// Duration method.
fn sema_time_duration_result(method: String, argc: Int) -> Type? {
    return if {
        method == "in" && argc == 1 -> Val(Type.Result{ok: Type.Int, err: sema_time_named("RangeError")})
        method == "is_zero" && argc == 0 -> Val(Type.Bool)
        method == "total_seconds" && argc == 0 -> Val(Type.Int)
        method == "difference" && argc == 1 -> Val(sema_time_named("Duration"))
        (method == "abs" || method == "negated") && argc == 0 -> Val(sema_time_named("Duration"))
        method == "sign" && argc == 0 -> Val(Type.Int)
        method == "total_in" && argc == 1 -> Val(Type.Float)
        else -> None
    }
}

fn sema_time_duration_args(method: String) -> [Type] Never! {
    return if {
        method == "in" -> [Type]{sema_time_named("DurationUnit")}
        method == "difference" -> [Type]{sema_time_named("Duration")}
        method == "total_in" -> [Type]{Type.String}
        else -> [Type]{}
    }
}

// Rust `handle_method_op`: a written `.Unit` argument of `.in(…)` names its
// unit on the operation.
fn sema_time_duration_op(method: String, args: [CallArg]) -> THandleOp Never! {
    return if {
        method == "in" -> {
            unit := String?{None}
            // The argument has already checked as a `DurationUnit`, so a
            // written `.Unit` is one of its variants.
            if args[0].expr == .EnumLit(_, variant, _, _, _, _) -> unit = Val(variant)
            THandleOp.DurationIn{unit: unit}
        }
        method == "is_zero" -> THandleOp.DurationIsZero
        method == "total_seconds" -> THandleOp.DurationTotalSeconds
        method == "difference" -> THandleOp.DurationDifference
        method == "abs" -> THandleOp.DurationAbs
        method == "negated" -> THandleOp.DurationNegated
        method == "sign" -> THandleOp.DurationSign
        else -> THandleOp.DurationTotalIn
    }
}

fn sema_time_duration_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    result :: sema_time_duration_result(method, args.len()) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    required :: sema_time_duration_args(method)
    values :: sema_time_check_values(args, required, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_time_check_method_ownership(receiver, method, args, required, AccessConvention.Read, span, &scopes, &state, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    sema_time_finish_handle(receiver_value, sema_time_duration_op(method, args), values, result, "", "Duration.{method}", span, expected, environment, program, &scopes, &context, &diagnostics)
}
