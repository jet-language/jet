// Canonical source-side resolution and construction for registry-backed Core calls.
//
// Foundation owns Core identity, typed source signatures, and backend facts.
// Call resolution prefers source exports, then uses the signature contract to
// validate supported arities; call construction consumes the resolved contract.
use jet_foundation.[
    AccessConvention,
    CORE_CALL_COVERAGE_SEMA,
    CORE_MODULE_EXPORTS,
    CORE_SOURCE_OWNED_ROWS,
    Call,
    CallArg,
    CoreCallDefault,
    CoreCallProjectionError,
    CoreCallRecord,
    CoreCallSignatureRequest,
    CoreCallTypeConstraint,
    CoreCallTypeParameter,
    CoreTypedCallSignature,
    Diagnostic,
    Effect,
    InternalTag,
    EffectRowEntry,
    EnumLitArg,
    Expr,
    FunctionDefaultRef,
    MIRDataPlan,
    MIRSharedLifetime,
    Span,
    StrPart,
    SymbolID,
    SymbolKind,
    TCallArg,
    TExpr,
    TExprKind,
    TFailureCarrier,
    TGenericParam,
    TagMarker,
    TextEdit,
    Type,
    ViewProvenance,
    ViewProvenanceEntry,
    ViewProvenanceMap,
    ViewSource,
    ViewSourcePath,
    ViewSourceProjection,
    CoreCallSymbol,
    core_call,
    core_call_authority_boundary_at,
    core_call_accepts_arity,
    core_call_coverage_contains,
    core_call_source_member,
    core_call_projection,
    core_call_typed_signature,
    core_call_typed_signature_for,
    core_receiver_method,
    core_module_export,
    diagnostic_with_edit,
    expr_span,
    sema_effect_covers,
    type_name,
    mir_shared_lifetime_core_member,
    CORE_CALLS,
]

// A visible module alias (`use slots`, `use core.mem`) and the registered
// module it names.
struct SemaCallImportTarget {
    alias: String
    module_identity: String
    module_name: String
    item: String?
    span: Span
}

enum SemaCoreCallRoute {
    Source(target: SemaCallDirectTarget)
    Core(record: CoreCallRecord)
    SharedSite(lifetime: MIRSharedLifetime)
}

fn sema_call_core_import_target(environment: SemaScopeEnvironment, program: SemaProgramTables, alias: String) -> SemaCallImportTarget? {
    if program.registration_graph == .Val(graph) {
    module_index :: sema_registration_module_index(graph, environment.module_identity) ?? return None
    imports :: sema_core_registration_imports(graph.modules[module_index])
    imported :: sema_core_import_find(imports, alias) ?? return None
    module_name := imported.module_name
    target_index :: sema_registration_module_index(graph, imported.module_name)
    if target_index != None {
        index :: target_index
        module_name = graph.modules[index].module_name
    }
    if !sema_core_import_is_core(module_name) -> return None
    return Val(SemaCallImportTarget{alias: alias, module_identity: imported.module_name, module_name: module_name, item: imported.item, span: imported.span})
    } else {
        return None
    }
}

// The source module a whole-module import alias binds: `use slots`, or the
// file import a body-less `module math` declares. None for a Core
// module or a member import.
fn sema_call_source_import_target(environment: SemaScopeEnvironment, program: SemaProgramTables, alias: String) -> SemaCallImportTarget? {
    if program.registration_graph == .Val(graph) {
    module_index :: sema_registration_module_index(graph, environment.module_identity) ?? return None
    loop import_index in 0..<graph.modules[module_index].imports.len() {
        loop binding_index in 0..<graph.modules[module_index].imports[import_index].bindings.len() {
            if graph.modules[module_index].imports[import_index].bindings[binding_index].local != alias || graph.modules[module_index].imports[import_index].bindings[binding_index].symbol.kind != SymbolKind.Import || graph.modules[module_index].imports[import_index].bindings[binding_index].declaration != None -> next
            target_index :: sema_registration_module_index(graph, graph.modules[module_index].imports[import_index].bindings[binding_index].target_module_identity) ?? return None
            module_name :: graph.modules[target_index].module_name
            if sema_core_import_is_core(module_name) -> return None
            return Val(SemaCallImportTarget{alias: alias, module_identity: graph.modules[module_index].imports[import_index].bindings[binding_index].target_module_identity, module_name: module_name, item: None, span: graph.modules[module_index].imports[import_index].bindings[binding_index].symbol.span})
        }
    }
    return None
    } else {
        return None
    }
}

// Resolve through Registration identity, not source spelling alone.
fn sema_call_core_import_module(environment: SemaScopeEnvironment, program: SemaProgramTables, alias: String) -> String? {
    target :: sema_call_core_import_target(environment, program, alias) ?? return None
    Val(target.module_name)
}

fn sema_call_core_import_member(target: SemaCallImportTarget, requested_member: String) -> String? {
    if target.item == .Val(item) {
        if requested_member != "" && requested_member != item -> return None
        return Val(item)
    }
    if requested_member == "" -> return None
    Val(requested_member)
}

// An import is usable only while its exact registered binding remains the
// visible lexical binding for the local alias.
fn sema_call_core_import_is_unshadowed(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, target: SemaCallImportTarget) -> Bool Never! {
    if program.registration_graph == .Val(graph) {
    module_index :: sema_registration_module_index(graph, environment.module_identity) ?? return false
    visible_index :: sema_scope_resolve_index(scopes, target.alias) ?? return false
    visible_symbol := scopes.bindings[visible_index].symbol
    module_row :: graph.modules[module_index]
    loop import in module_row.imports {
        loop binding in import.bindings {
            // A Core submodule member (`use core.mem`) names its own target.
            if import.target_module_identity != target.module_identity && binding.target_module_identity != target.module_identity -> next
            if binding.local != target.alias -> next
            skip_binding := if target.item == {
                .Val(item) -> binding.original != item
                .None -> binding.symbol.kind != SymbolKind.Import
            }
            if skip_binding -> next
            if visible_symbol.id.key == binding.symbol.id.key -> return true
        }
    }
    return false
    } else {
        return false
    }
}

fn sema_call_core_record_import_reference(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, target: SemaCallImportTarget, span: Span, context: &SemaCheckContext) -> Bool Never! {
    if !sema_call_core_import_is_unshadowed(environment, program, scopes, target) -> return false
    index :: sema_scope_resolve_index(scopes, target.alias) ?? return false
    &context.name_references.push(SemaNameReferenceFact{span: span, symbol: sema_scope_binding_symbol(environment, scopes, index), kind: "import_alias"})
    true
}

// Rust core_call expert policy: a raw `core.crypto.expert` primitive, or a
// `core.crypto.vault` key-material operation other than the safe `get`,
// runs only inside an audited `#Unsafe` region. The call already resolved
// through the module's import, so the region is the remaining gate.
fn sema_call_core_crypto_expert_gate(module_name: String, member: String, span: Span, context: SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    if context.unsafe_depth > 0 -> return
    if module_name == "core.crypto.expert" {
        &diagnostics.push(sema_error("E0510", span, "`core.crypto.expert.{member}` requires an audited `#Unsafe` region", "raw crypto primitives may only run inside an explicit expert-tier gate (I1)", "wrap the call in `#Unsafe(\"crypto expert: …\") {{ … }}` or use `crypto.seal`/`open` instead"))
        return
    }
    if module_name == "core.crypto.vault" && member != "get" {
        &diagnostics.push(sema_error("E0510", span, "`{module_name}.{member}` requires an audited `#Unsafe` region", "raw key import may only run inside an explicit expert-tier gate (I1)", "wrap the call in `#Unsafe(\"vault key import: …\") {{ … }}`"))
    }
}

fn sema_call_core_source_target(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: String, member: String, type_args: [Type], span: Span, registered_source_target: Bool, diagnostics: &[Diagnostic]) -> SemaCallDirectTarget? {
    if program.registration_graph == .Val(graph) {
    module_index :: sema_registration_module_index(graph, module_identity) ?? return None
    // Module rows are read in place; binding one would copy its whole program.
    source_name :: graph.modules[module_index].module_name
    if sema_call_core_module_identity(environment, program, source_name) != Val(module_identity) -> return None
    // `core.http.client.request` is checked by its Core row (Rust
    // core_call.rs: a `URL` or String target, sema_call_http_transport), and
    // that checked row then executes the source `request` declaration.
    if !registered_source_target && source_name == "core.http.client" && member == "request" -> return None
    if source_name == "core.encoding.json" && member == "decode" && type_args.len() != 0 -> return None
    caller_index :: sema_registration_module_index(graph, environment.module_identity) ?? return None
    // Same-owner native providers keep their host row. A source-only function
    // has no such row and still resolves to its declaration from this module.
    if !registered_source_target && graph.modules[module_index].module_identity == graph.modules[caller_index].module_identity {
        if core_call(source_name, member) == .Val(record) {
            if record.symbol != CoreCallSymbol.SourceOwned -> return None
        }
    }
    core_private_seam :: graph.modules[module_index].module_identity.starts_with("<corelib>/") && graph.modules[caller_index].module_identity.starts_with("<corelib>/")
    export :: (if registered_source_target || core_private_seam -> sema_registration_resolve_export(graph, module_index, member, module_identity, graph.modules[module_index].package_identity, [String]{}) else -> sema_registration_resolve_export(graph, module_index, member, environment.module_identity, environment.package_identity, [String]{})) ?? return None
    row :: sema_call_export_function_row(environment, program, export) ?? {
        &diagnostics.push(sema_call_not_callable(member, export.symbol.ty ?? Type.Named{name: "Unknown"}, span))
        return None
    }
    sema_call_export_function_target(environment, program, export, row, type_args, span, &diagnostics)
    } else {
        return None
    }
}

// The registered function row an export names; None when it names no function.
fn sema_call_export_function_row(environment: SemaScopeEnvironment, program: SemaProgramTables, export: SemaRegistrationExport) -> SemaRegistrationRowRef? {
    if program.registration_graph == .Val(graph) {
    owner_index :: sema_registration_module_index(graph, export.source_module_identity) ?? return None
    // Search by index so the function collection stays borrowed.
    loop index in 0..<graph.modules[owner_index].functions.len() {
        if graph.modules[owner_index].functions[index].symbol.id.key == export.symbol.id.key -> return Val(SemaRegistrationRowRef{module_index: owner_index, row: index})
    }
    return None
    } else {
        return None
    }
}

// The direct-call target for an exported function called from another module.
fn sema_call_export_function_target(environment: SemaScopeEnvironment, program: SemaProgramTables, export: SemaRegistrationExport, row: SemaRegistrationRowRef, type_args: [Type], span: Span, diagnostics: &[Diagnostic]) -> SemaCallDirectTarget? {
    if program.registration_graph == .Val(graph) {
    registered :: graph.modules[row.module_index].functions[row.row]
    target := sema_call_direct_target_from_registration(registered, program.registration_graph, environment.module_identity, environment.package_identity, environment.generic_params, type_args, span, &diagnostics) ?? return None
    // Rust `owner_type_for_reader`, as for a field: the signature names types
    // as the owning module sees them (`Stat` is `core.files`' own, `Slot` is
    // `slots`' own), so it resolves there with its type parameters kept,
    // before the caller's explicit type arguments are substituted.
    generics :: loop param in registered.generic_params -> TGenericParam{name: param.name, bounds: [SymbolID]{}}
    owner_signature :: sema_type_resolve_declared_with_generics(graph, registered.signature, export.source_module_identity, generics)
    target.signature = if target.generic_substitutions.len() == 0 -> owner_signature else -> sema_inference_substitute_type_bindings(owner_signature, target.generic_substitutions)
    return Val(target)
    } else {
        return None
    }
}

// Rust `infer_import_call`: `slots.wrap(..)` through a whole-module alias of a
// source module calls the function that module (or its
// package) exports, checked like a direct call. A private function is E0605
// and any other name E0102. Core aliases keep their own route.
fn sema_call_try_source_module_call(alias: String, alias_span: Span, member: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    unhandled :: SemaMethodSpecialCheck{handled: false, value: None}
    imported :: sema_call_source_import_target(environment, program, alias) ?? return unhandled
    if !sema_call_core_record_import_reference(environment, program, scopes, imported, alias_span, &context) -> return unhandled
    if program.registration_graph == .Val(graph) {
    module_index :: sema_registration_module_index(graph, imported.module_identity) ?? return unhandled
    failed :: SemaMethodSpecialCheck{handled: true, value: None}
    export :: sema_registration_resolve_export(graph, module_index, member, environment.module_identity, environment.package_identity, [String]{}) ?? {
        if sema_registration_direct_symbol(graph.modules[module_index], member) != None {
            &diagnostics.push(sema_error("E0605", span, "`{member}` is private to its module", "a `priv module` is usable only by its enclosing module (`priv(package)`: by its package), and a `priv` field only by its type's module", "use `{member}` from inside its module, or remove `priv` from its module or field"))
        } else {
            &diagnostics.push(sema_call_import_member_unknown(member, alias_span))
        }
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return failed
    }
    row :: sema_call_export_function_row(environment, program, export) ?? {
        &diagnostics.push(sema_call_import_member_unknown(member, span))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return failed
    }
    target :: sema_call_export_function_target(environment, program, export, row, type_args, span, &diagnostics) ?? return failed
    scopes.ownership_call_depth += 1
    value := sema_call_core_check_source_owned(target, "{alias}.{member}", type_args, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    scopes.ownership_call_depth -= 1
    return SemaMethodSpecialCheck{handled: true, value: value}
    } else {
        return unhandled
    }
}

fn sema_call_import_member_unknown(member: String, span: Span) -> Diagnostic {
    sema_error("E0102", span, "nothing named `{member}` exists in this import", "only functions and types outside a `priv module` of the other file are reachable here", "check the spelling, or move the item out of its `priv module`")
}

fn sema_call_core_module_identity(environment: SemaScopeEnvironment, program: SemaProgramTables, module_name: String) -> String? {
    if program.registration_graph == .Val(graph) {
    loop module_row_index in 0..<graph.modules.len() {
        if graph.modules[module_row_index].module_name != module_name || !sema_module_is_core_source(graph.modules[module_row_index].module_identity) -> next
        loop owner in CORE_SOURCE_OWNED_ROWS {
            if owner.module_name == module_name && owner.alias == graph.modules[module_row_index].core_source_alias && graph.modules[module_row_index].source_file == "<corelib>/{owner.path}" -> return Val(graph.modules[module_row_index].module_identity)
        }
    }
    return None
    } else {
        return None
    }
}

// Rust `serde_diags::unknown_core_item` (E1004): the one report for a Core
// module member that does not resolve at this position.
fn sema_call_core_unknown_item(module_name: String, member: String, span: Span) -> Diagnostic {
    if module_name == "core.time" && member == "clock" -> return sema_error("E1004", span, "`time.clock` is not a Core member", "deterministic fresh values use a type-owned `new` constructor", "use `Clock.new(seed)`")
    if module_name == "core.time.expiring" && member == "new" -> return sema_error("E1004", span, "`expiring.new` is not a Core member", "fresh values use a type-owned `new` constructor", "use `ExpiringValue.new(value, ttl, clock)`")
    if module_name == "core.event" && member == "policy_async" -> return sema_error("E1004", span, "`event.policy_async` is not a Core member", "a synchronous `Event<T>` cannot provide real queued dispatch; `AsyncEvent<T, E>` is the sole asynchronous event model", "use `event.async_result<T, E>(AsyncPolicy.{{ capacity: n, overflow: .Block }}, FailurePolicy.Collect)`")
    if module_name == "core.crypto" && member == "constant_time_eq" -> return sema_error("E1004", span, "`crypto.constant_time_eq` is not a Core member", "`eq` is not one of Jet's blessed API abbreviations", "use `crypto.constant_time_equal_bytes(a, b)`")
    if module_name == "core.crypto" && member.ends_with("_bytes") {
        algorithm :: member.removesuffix("_bytes")
        digest :: if algorithm == {
            "sha256" | "blake3" -> "Digest256"
            "sha512" -> "Digest512"
            else -> ""
        }
        if digest != "" -> return sema_error("E1004", span, "`crypto.{member}` is not a Core member", "`crypto.{algorithm}` returns `{digest}`, so the representation is explicit", "use `crypto.{algorithm}(bytes).hex()` for text or `.bytes()` for raw bytes")
    }
    items :: if core_module_export(module_name) == {
        .Val(row) -> row.members
        .None -> [String]{}
    }
    // #2002: the module exposes the name, but this position has no arm for it.
    if items.contains(member) -> return sema_error("E1004", span, "`{module_name}` exposes `{member}`, but not in this position", "standard library modules expose a fixed set of public items, each reachable only where its surface declares", "import it directly with `use {module_name}.[{member}]`")
    // #1965: an exact submodule hit outranks this module's own menu.
    if sema_call_core_submodule_path_hint(module_name, member, span) == .Val(hint) -> return hint
    suggestion :: sema_suggest_field(member, items)
    fix :: if suggestion == {
        .Val(candidate) -> "did you mean `{candidate}`?"
        .None -> if items.len() == 0 -> "import a specific core module, like `import core.files as fs;`" else -> "use one of: {items.join(", ")}"
    }
    diagnostic :: sema_error("E1004", span, "`{module_name}` has no item `{member}`", "standard library modules expose a fixed set of public items", fix)
    if suggestion == .Val(candidate) -> return diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: candidate})
    diagnostic
}

// Rust `submodule_path_hint`: `{module}.{member}` is itself a submodule, or
// `member` is an item of one. No typed edit: the import path shape changes.
fn sema_call_core_submodule_path_hint(module_name: String, member: String, span: Span) -> Diagnostic? {
    why :: "Core is one nested tree, so a name under this module can belong to a submodule instead of the module itself"
    nested :: "{module_name}.{member}"
    if core_module_export(nested) == .Val(row) {
        fix :: if row.members.len() > 0 -> "`{nested}` is a submodule, so name an item on it: `{nested}.{row.members[0]}`" else -> "`{nested}` is a submodule; import it with `import {nested};`"
        return Val(sema_error("E1004", span, "`{module_name}` has no item `{member}`", why, fix))
    }
    prefix :: "{module_name}."
    loop candidate in CORE_MODULE_EXPORTS {
        if !candidate.module_name.starts_with(prefix) || !candidate.members.contains(member) -> next
        return Val(sema_error("E1004", span, "`{module_name}` has no item `{member}`", why, "`{member}` lives in the submodule `{candidate.module_name}`, so write `{candidate.module_name}.{member}`"))
    }
    None
}

fn sema_call_core_projection_error(module_name: String, member: String, error: CoreCallProjectionError, span: Span, diagnostics: &[Diagnostic]) {
    if error == {
        .Unknown -> &diagnostics.push(sema_call_core_unknown_item(module_name, member, span))
        .Uncovered(_) -> &diagnostics.push(sema_error("E0904", span, "`{module_name}.{member}` has no source semantic call contract", "the registered Core row is not covered by this semantic projection", "use a source-owned callable or a Core row with SEMA coverage"))
        .Arity(expected, actual) -> {
            row :: core_call(module_name, member)
            maximum :: row.map((record) -> record.signature.max_arity) ?? expected
            range :: if maximum > expected -> "between {expected} and {maximum}" else -> "{expected}"
            &diagnostics.push(sema_error("E0104", span, "`{module_name}.{member}` expects {range} argument(s), got {actual}", "the registered Core call arity is fixed", "provide the registered number of arguments"))
        }
    }
}

fn sema_call_core_record(module_name: String, member: String, actual_arity: Int, span: Span, diagnostics: &[Diagnostic]) -> CoreCallRecord? {
    typed_signature :: core_call_typed_signature(module_name, member, actual_arity)
    if typed_signature != None -> return core_call(module_name, member)
    // A compiler query checks its own argument count against its contract,
    // as the reference checks a function of the imported Core module, and
    // keeps checking the call past a wrong count.
    if sema_compiler_services_is_compiler_query(module_name, member) {
        if core_call(module_name, member) == .Val(row) -> return Val(row)
    }
    // Variadic `core.term.eprint` joins its arguments into
    // one write through the arity-1 row (Rust `checked_core_record(…, 1, …)`);
    // its special checker owns the argument count.
    projection_arity :: if module_name == "core.term" && member == "eprint" -> 1 else -> actual_arity
    projection :: core_call_projection(module_name, member, CORE_CALL_COVERAGE_SEMA, projection_arity)
    if projection == {
        .Row(record) -> return Val(record)
        .Error(error) -> {
            sema_call_core_projection_error(module_name, member, error, span, &diagnostics)
            return None
        }
    }
}

fn sema_call_core_typed_signature(record: CoreCallRecord, actual_arity: Int, actual_accesses: [AccessConvention], type_args: [Type]) -> CoreTypedCallSignature? {
    core_call_typed_signature_for(CoreCallSignatureRequest{
        module_name: record.module_name,
        member: record.member,
        actual_arity: actual_arity,
        actual_accesses: actual_accesses,
        type_args: type_args,
    })
}

fn sema_call_core_receiver_record(receiver_type: Type, member: String, actual_arity: Int, span: Span, diagnostics: &[Diagnostic]) -> CoreCallRecord? {
    receiver_name := sema_expr_type_base_name(receiver_type) ?? type_name(receiver_type)
    record :: core_receiver_method(receiver_name, member) ?? return None
    if !core_call_coverage_contains(record.coverage, CORE_CALL_COVERAGE_SEMA) {
        &diagnostics.push(sema_error("E0904", span, "`{receiver_name}.{member}` has no source semantic call contract", "the registered Core receiver row is not covered by this semantic projection", "use a receiver operation with SEMA coverage"))
        return None
    }
    if !core_call_accepts_arity(record, actual_arity) {
        maximum := record.signature.max_arity
        range :: if maximum > record.signature.arity -> "between {record.signature.arity} and {maximum}" else -> "{record.signature.arity}"
        &diagnostics.push(sema_error("E0104", span, "`{receiver_name}.{member}` expects {range} argument(s), got {actual_arity}", "the registered Core receiver call arity is fixed", "provide the registered number of arguments"))
        return None
    }
    Val(record)
}

fn sema_call_core_first_is_move(args: [CallArg]) -> Bool Never! {
    args.len() > 0 && args[0].convention == AccessConvention.Move
}

fn sema_call_core_native_resource_consumer(module_name: String, member: String, first_is_move: Bool) -> Bool Never! {
    // #4747: the fixed floating constraint preserves Float/F32 inference.
    // The checked TIR call below selects the reserved source wrapper.
    (module_name == "core.math" && (member == "cmp" || member == "is_finite" || member == "sqrt")) ||
    ((module_name == "core.encoding.json" || module_name == "core.encoding.jsonl") && member == "reader" && first_is_move) ||
        (module_name == "core.net.tls" && member == "client" && first_is_move) ||
        // Worker alone keeps checked fn() inference; its source slot is opaque.
        (module_name == "core.service" && member == "worker")
}

fn sema_call_core_has_explicit_source_target(module_name: String, member: String) -> Bool Never! {
    row :: core_call(module_name, member) ?? return false
    row.symbol == CoreCallSymbol.SourceOwned && row.source_target != None
}

// Rust CheckerCoreLib/serde_diags.rs: the no-OS call boundary is checked
// before choosing either a source-owned implementation or a native Core row.
fn sema_call_core_no_os_hint(module_name: String) -> String? Never! {
    if module_name == {
        "core.files" -> Val("Embed the data at compile time with `@embed(\"file\")`, or select a hosted target.")
        "core.net" | "core.net.tls" | "core.http" -> Val("No-OS targets have no network stack. Select a hosted target, or use a declared network provider.")
        "core.tasks" -> Val("OS threads are not available without an OS. Use cooperative or interrupt-driven concurrency.")
        "core.term" -> Val("Standard I/O requires an OS. Use a declared IO provider or select a hosted target.")
        "core.process" | "core.time" -> Val("System calls are not available on a no-OS target. Select a hosted target or declare the required provider.")
        "core.log" -> Val("The log module writes to stderr (an OS resource). Use a declared IO provider or select a hosted target.")
        "core.watcher" | "core.crypto.vault" -> Val("Select a hosted target, or replace this call with a core-level alternative.")
        else -> None
    }
}

// Compiler-owned query contracts resolve before source facades. Other source
// exports remain ordinary functions ahead of static Core records. A Core record
// route checks no type-argument count: as in Rust `infer_core_call`, the
// bespoke Core arms take their own `<T>` and only the fixed-signature fallback
// (`sema_call_core_check_fixed_record`, Rust `resolved_core_fixed_sig`) checks
// the count against the typed row.
fn sema_call_core_resolve_route(environment: SemaScopeEnvironment, program: SemaProgramTables, module_name: String, member: String, type_args: [Type], actual_arity: Int, first_is_move: Bool, span: Span, diagnostics: &[Diagnostic]) -> SemaCoreCallRoute? {
    diagnostic_count := diagnostics.len()
    if sema_scope_environment_no_os(environment) && sema_call_core_no_os_hint(module_name) == .Val(hint) {
        short_name :: module_name.slice(module_name.rfind(".") + 1, module_name.len())
        api :: "{short_name}.{member}"
        &diagnostics.push(sema_error("E3301", span, "`{api}` is not available on a no-OS target.", "No-OS targets have no OS; only `core`-level APIs are available.", hint))
        return None
    }
    source_identity :: if sema_compiler_services_is_compiler_query(module_name, member) || sema_call_core_has_explicit_source_target(module_name, member) || sema_call_core_native_resource_consumer(module_name, member, first_is_move) -> None else -> sema_call_core_module_identity(environment, program, module_name)
    source :: if source_identity == {
        .Val(identity) -> sema_call_core_source_target(environment, program, identity, member, type_args, span, false, &diagnostics)
        .None -> None
    }
    if source == {
        .Val(target) -> return Val(SemaCoreCallRoute.Source{target: target})
        .None -> {}
    }
    if diagnostics.len() != diagnostic_count -> return None
    record :: sema_call_core_record(module_name, member, actual_arity, span, &diagnostics) ?? return None
    Val(SemaCoreCallRoute.Core{record: record})
}

fn sema_call_core_resolve_import_route(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, alias: String, requested_member: String, type_args: [Type], actual_arity: Int, first_is_move: Bool, span: Span, alias_span: Span, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaCoreCallRoute? {
    imported :: sema_call_core_import_target(environment, program, alias) ?? return None
    if !sema_call_core_import_is_unshadowed(environment, program, scopes, imported) -> return None
    member :: sema_call_core_import_member(imported, requested_member) ?? return None
    if !sema_call_core_record_import_reference(environment, program, scopes, imported, alias_span, &context) -> return None
    if imported.module_name == "core.mem" {
        if mir_shared_lifetime_core_member(member) == .Val(lifetime) -> return Val(SemaCoreCallRoute.SharedSite{lifetime: lifetime})
    }
    diagnostic_count := diagnostics.len()
    // `core.term` owns only the one-argument print, eprint
    // and progress wrappers; other arities keep the fixed Core route.
    variadic_term :: imported.module_name == "core.term" && (member == "print" || member == "eprint" || member == "progress") && actual_arity != 1
    source :: if sema_compiler_services_is_compiler_query(imported.module_name, member) || variadic_term || sema_call_core_has_explicit_source_target(imported.module_name, member) || sema_call_core_native_resource_consumer(imported.module_name, member, first_is_move) -> None else -> sema_call_core_source_target(environment, program, imported.module_identity, member, type_args, span, false, &diagnostics)
    if source == {
        .Val(target) -> return Val(SemaCoreCallRoute.Source{target: target})
        .None -> {}
    }
    if diagnostics.len() != diagnostic_count -> return None
    record :: sema_call_core_record(imported.module_name, member, actual_arity, span, &diagnostics) ?? return None
    Val(SemaCoreCallRoute.Core{record: record})
}

// Rust `core_module_path_from_receiver` + `infer_core_call`: a call through a
// module alias's known Core submodule (`core.math.fabs(n)` under `use core as
// core`) routes against that submodule by name, exactly as an alias of the
// submodule itself would.
fn sema_call_core_resolve_import_path_route(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, alias: String, module_name: String, member: String, type_args: [Type], actual_arity: Int, first_is_move: Bool, span: Span, alias_span: Span, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaCoreCallRoute? {
    imported :: sema_call_core_import_target(environment, program, alias) ?? return None
    if imported.item != None -> return None
    if !sema_call_core_record_import_reference(environment, program, scopes, imported, alias_span, &context) -> return None
    sema_call_core_resolve_route(environment, program, module_name, member, type_args, actual_arity, first_is_move, span, &diagnostics)
}

// (Rust core_call.rs `("core.term", "print")`): an imported
// `core.term` print with other than one argument is the qualified twin of the
// ambient variadic `print`, checked and lowered exactly like it (Rust
// `print_values`). True when this alias call is that print; the alias
// reference is then recorded.
fn sema_call_core_variadic_print(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, alias: String, requested_member: String, actual_arity: Int, alias_span: Span, context: &SemaCheckContext) -> Bool Never! {
    if actual_arity == 1 -> return false
    imported :: sema_call_core_import_target(environment, program, alias) ?? return false
    if imported.module_name != "core.term" -> return false
    if !sema_call_core_import_is_unshadowed(environment, program, scopes, imported) -> return false
    member :: sema_call_core_import_member(imported, requested_member) ?? return false
    if member != "print" -> return false
    sema_call_core_record_import_reference(environment, program, scopes, imported, alias_span, &context)
}

// Registry access metadata is incomplete for optional slots; return None rather
// than assign an ownership convention the registry does not specify.
fn sema_call_core_access(record: CoreCallRecord, index: Int) -> AccessConvention? {
    if index < 0 || index >= record.signature.borrow_mask.len() -> return None
    if record.signature.borrow_mask[index] -> Val(AccessConvention.Read) else -> Val(AccessConvention.Move)
}

fn sema_call_core_check_type_args(module_name: String, member: String, expected_count: Int, infer_when_omitted: Bool, type_args: [Type], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if infer_when_omitted && type_args.len() == 0 && expected_count > 0 -> return true
    if type_args.len() == expected_count -> return true
    &diagnostics.push(sema_call_generic_count_diagnostic("{module_name}.{member}", expected_count, type_args.len(), span))
    false
}

// The caller supplies the exact typed signature. Shared Binder checks its labels,
// zones, defaults and arity; no Core metadata is inferred from a member name.
fn sema_call_core_bind_arguments(record: CoreCallRecord, signature: Type, args: [CallArg], span: Span, diagnostics: &[Diagnostic]) -> SemaCallBinding? {
    process_run_boundary :: record.module_name == "core.process" && record.member == "run" && args.len() == record.signature.arity + 1
    if !core_call_accepts_arity(record, args.len()) && !process_run_boundary {
        maximum := record.signature.max_arity
        range :: if maximum > record.signature.arity -> "between {record.signature.arity} and {maximum}" else -> "{record.signature.arity}"
        &diagnostics.push(sema_error("E0104", span, "`{record.module_name}.{record.member}` expects {range} argument(s), got {args.len()}", "the registered Core call arity is fixed", "provide the registered number of arguments"))
        return None
    }
    if !sema_call_type_is_function(signature) {
        &diagnostics.push(sema_call_not_callable("{record.module_name}.{record.member}", signature, span))
        return None
    }
    local_args := [CallArg]{}
    loop arg in args -> &local_args.push(arg)
    sema_call_bind_direct("{record.module_name}.{record.member}", signature, &local_args, span, &diagnostics)
}

fn sema_call_core_check_typed_argument(value: TExpr, expected: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, span: Span, diagnostics: &[Diagnostic]) -> TExpr? {
    typed := value
    typed.span = span
    sema_expr_expected(typed, Val(expected), environment, program, &diagnostics)
}

// Rust core_call.rs `("core.math", "abs")`: `abs` takes Int, Float or F32
// and Complex, returning the argument type (Float for Complex).
// The Int form stays the routed source `abs`; a float or Complex argument is
// the MathBuiltin `abs` that Rust `lower_core_math_abs` lowers it to, which is
// the route `Complex.abs` already takes. Anything else is not handled here.
fn sema_call_try_core_math_abs(module_name: String, member: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    unhandled :: SemaDirectSpecialCheck{handled: false, value: None}
    if module_name != "core.math" || member != "abs" || args.len() != 1 || type_args.len() != 0 || args[0].label != None -> return unhandled
    probe_diagnostics := [Diagnostic]{}
    probed :: sema_probe_expression(args[0].expr, None, environment, program, &scopes, &state, &tail_store, &context, &probe_diagnostics) ?? return unhandled
    type_name := ""
    result_ty := Type.Float
    if probed.ty == Type.Float -> type_name = "Float"
    if probed.ty == Type.Float32 {
        type_name = "F32"
        result_ty = Type.Float32
    }
    if probed.ty == (Type.Named{name: "Complex"}) -> type_name = "Complex"
    if type_name == "" -> return unhandled
    value :: sema_check_expression(args[0].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    magnitude :: sema_tir_node(result_ty, TExprKind.MathBuiltin{type_name: type_name, function: "abs", args: [TExpr]{value}}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(magnitude, expected, environment, program, &diagnostics)}
}

// Rust core_call.rs `("core.math", "is_nan" | "is_inf" | "is_finite")`:
// floating-point classification takes Float or F32. A float argument stays the
// ordinary source call; any other checked argument type is refused here.
fn sema_call_try_core_math_float_class(module_name: String, member: String, type_args: [Type], args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    unhandled :: SemaDirectSpecialCheck{handled: false, value: None}
    if module_name != "core.math" || (member != "is_nan" && member != "is_inf" && member != "is_finite") || args.len() != 1 || type_args.len() != 0 -> return unhandled
    probe_diagnostics := [Diagnostic]{}
    probed :: sema_probe_expression(args[0].expr, None, environment, program, &scopes, &state, &tail_store, &context, &probe_diagnostics) ?? return unhandled
    if probed.ty == Type.Float || probed.ty == Type.Float32 -> return unhandled
    value :: sema_check_expression(args[0].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    &diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{member}` needs Float or F32, not {sema_type_show(value.ty)}", "floating-point classification only applies to floats", "pass a Float or F32 value"))
    SemaDirectSpecialCheck{handled: true, value: None}
}

// Width selection is the existing checked mathematical normalization; it is
// separate from source forwarding and never widens F32 values.
fn sema_call_core_normalized_source_record(record: CoreCallRecord, args: [TExpr]) -> CoreCallRecord Never! {
    normalized := record
    if record.symbol == CoreCallSymbol.SourceOwned && record.module_name == "core.math" && (record.member == "cmp" || record.member == "is_finite") && args.len() > 0 && args[0].ty == Type.Float32 {
        normalized.source_target = Val("__{record.member}_f32")
    }
    if record.symbol == CoreCallSymbol.SourceOwned && record.module_name == "core.net" && record.member == "unix_connect" {
        normalized.source_target = Val(if args.len() == 1 -> "__unix_connect_entry" else -> "__unix_connect_deadline_entry")
    }
    if record.symbol == CoreCallSymbol.SourceOwned && record.module_name == "core.net.tls" && record.member == "client" {
        if args.len() == 4 -> normalized.source_target = Val("__client_config_deadline_entry")
        else if args.len() == 3 -> normalized.source_target = Val("__client_deadline_entry")
        else if args.len() == 2 && args[0].ty != Type.String -> normalized.source_target = Val("__client_stream_entry")
        else -> normalized.source_target = Val("client")
    }
    normalized
}

fn sema_call_core_source_arguments(record: CoreCallRecord, args: [TExpr], params: [SemaCallParam], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables) -> [TCallArg] Never! {
    result := [TCallArg]{}
    loop index in 0..<args.len() {
        value :: sema_call_core_materialize_authority_boundary(record, index, args[index], span)
        param :: params[index]
        &result.push(TCallArg{value: value, template_items: [SymbolID]{},
            borrow: param.convention == AccessConvention.Read && !sema_call_is_scalar(value.ty),
            mut_borrow: param.convention == AccessConvention.Write,
            fn_coerce: None, widen_to_vec: false,
            widen_to_union: sema_call_widen_union(param.ty ?? value.ty, value.ty),
            box_as_trait: sema_call_box_as_trait(param.ty ?? value.ty, value.ty, environment, program),
            label: None, spread: false})
    }
    result
}

fn sema_call_core_tir(record: CoreCallRecord, args: [TExpr], span: Span, type_args: [Type], widen_to_vec: [Bool], data_plan: MIRDataPlan?, result_type: Type, fallibility: TFailureCarrier, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    process_run_boundary :: record.module_name == "core.process" && record.member == "run" && args.len() == record.signature.arity + 1
    if !core_call_accepts_arity(record, args.len()) && !process_run_boundary {
        maximum := record.signature.max_arity
        range :: if maximum > record.signature.arity -> "between {record.signature.arity} and {maximum}" else -> "{record.signature.arity}"
        &diagnostics.push(sema_error("E0104", span, "`{record.module_name}.{record.member}` expects {range} argument(s), got {args.len()}", "the registered Core call arity is fixed", "provide the registered number of arguments"))
        return None
    }
    if record.module_name == "core.math" && record.member == "sqrt" && args.len() == 1 && args[0].ty == (Type.Apply{name: "Measurement", args: [Type]{Type.Float}}) {
        value :: sema_expression_measurement_source_call("__measurement_sqrt", args, result_type, span, environment, program) ?? return None
        return sema_expr_expected_owned(^value, expected, environment, program, &diagnostics)
    }
    if record.module_name == "core.math" && record.member == "sqrt" && args.len() == 1 && args[0].ty == Type.Float {
        identity :: sema_call_core_module_identity(environment, program, "core.math") ?? return None
        if sema_call_core_source_target(environment, program, identity, "sqrt", type_args, span, false, &diagnostics) == .Val(target) {
            argument :: TCallArg{value: args[0], template_items: [SymbolID]{}, borrow: false, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
            value :: sema_tir_node(result_type, TExprKind.Call{callee: target.symbol.id, type_args: [Type]{}, args: [TCallArg]{argument}}, span)
            return sema_expr_expected_owned(^value, expected, environment, program, &diagnostics)
        }
    }
    normalized :: sema_call_core_normalized_source_record(record, args)
    // A typed `json.decode<T>` is the registered codec row (Rust core_call.rs
    // keeps it off the source forward); only the untyped form runs the source.
    typed_json_decode :: record.module_name == "core.encoding.json" && record.member == "decode" && type_args.len() != 0
    if !typed_json_decode && core_call_source_member(normalized) == .Val(member) {
        source_module := record.module_name
        source_member := member
        if member.starts_with("core.") {
            parts := member.split(".").to_list()
            source_member = &parts.pop() ?? return None
            source_module = parts.join(".")
        }
        identity :: sema_call_core_module_identity(environment, program, source_module) ?? {
            &diagnostics.push(sema_error("E0902", span, "source-owned Core module `{source_module}` is not loaded", "this declaration has no host implementation route", "load the owning Core source package"))
            return None
        }
        target :: sema_call_core_source_target(environment, program, identity, source_member, type_args, span, true, &diagnostics) ?? {
            &diagnostics.push(sema_error("E0902", span, "source-owned Core call `{record.module_name}.{member}` has no checked source target", "this declaration must execute its owning Jet function", "load the matching Core source export"))
            return None
        }
        params :: sema_call_params_from_type(target.signature) ?? return None
        if params.len() != args.len() {
            &diagnostics.push(sema_error("E0902", span, "source-owned Core target `{member}` has the wrong normalized arity", "the checked source signature must accept every normalized argument", "use the matching Core source export"))
            return None
        }
        source_args :: sema_call_core_source_arguments(record, args, params, span, environment, program)
        value :: sema_tir_node(result_type, TExprKind.Call{callee: target.symbol.id, type_args: type_args, args: source_args}, span)
        return sema_expr_expected_owned(^value, expected, environment, program, &diagnostics)
    }
    value := sema_tir_node(result_type, TExprKind.CoreCall{record: record, args: args, source_span: span, type_args: type_args, widen_to_vec: widen_to_vec, data_plan: data_plan, fallibility: fallibility}, span)
    // Rust (fallible.rs `infer_or_fallback`) passes the slot type to a call
    // only as an inference hint: a Core call that returns `Never` produces no
    // value, and the enclosing `??` or branch accepts its divergence.
    if result_type == (Type.Named{name: "Never"}) -> return Val(value)
    sema_expr_expected(value, expected, environment, program, &diagnostics)
}

fn sema_call_core_effect_name(effect_kind: Effect) -> String Never! {
    sema_taint_effect_name(effect_kind)
}

// Record known root/leaf effects (including known purity) and enforce authored
// transaction walls before the CoreCall reaches effect-graph collection.
fn sema_call_core_record_effects(record: CoreCallRecord, span: Span, type_args: [Type], result_type: Type, fallibility: TFailureCarrier, default_refs: [FunctionDefaultRef], scopes: &SemaScopeTable, context: &SemaCheckContext, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Bool Never! {
    effect_bound := [EffectRowEntry]{}
    leaf_name :: record.effect_leaf ?? ""
    if record.effect_kind == {
        .Val(effect_kind) -> {
            // A precise leaf under the call's own root replaces
            // that root, so a leaf grant (`FS.Read`, `Exec.Args`) covers the
            // call and the root still covers the leaf. A leaf under another
            // root (`Time.Wait` on a network call) adds to the root instead.
            root_name :: sema_call_core_effect_name(effect_kind)
            if leaf_name == "" || !sema_effect_covers(root_name, leaf_name) -> &effect_bound.push(EffectRowEntry{name: root_name, span: span})
        }
        .None -> {}
    }
    if leaf_name != "" {
        seen :: loop entry in effect_bound {
            if entry.name == leaf_name -> break true
        } ?? false
        if !seen -> &effect_bound.push(EffectRowEntry{name: leaf_name, span: span})
    }
    api :: if record.module_name != "" -> "{record.module_name}.{record.member}" else -> record.member
    facts := SemaCallFacts{
        return_type: result_type,
        failure_carrier: fallibility,
        effect_bound: Val(effect_bound),
        type_args: type_args,
        default_refs: default_refs,
    }
    start :: context.call_facts.len()
    accepted :: sema_effect_record_intrinsic_fact(environment, program, &scopes, &context, api, span, facts, &diagnostics)
    if accepted && record.marker != None && context.call_facts.len() > start {
        context.call_facts[context.call_facts.len() - 1].lifecycle = record.marker
    }
    accepted
}

fn sema_call_core_default_expr(default: CoreCallDefault, span: Span) -> Expr Never! {
    if default == {
        .Bool(value) -> Expr.Bool{value: value, span: span}
        .Int(value) -> Expr.Int{value: value, span: span, width: None, raw: Val("{value}")}
        .Float(value) -> Expr.Float{value: value, span: span, is_f32: false, raw: Val("{value}")}
        .String(value) -> Expr.Str{parts: [StrPart]{StrPart.Lit{text: value}}, span: span}
        .EmptyList -> Expr.ListLit{elements: [Expr]{}, span: span}
        .Absent -> Expr.Absent{span: span}
        .StaticCall(type_name, method) -> Expr.Call{call: Call{
            name: "{type_name}.{method}",
            name_span: span,
            type_args: [Type]{},
            args: [CallArg]{},
        }}
        .StaticEnum(type_name, variant) -> Expr.EnumLit{type_name: type_name, variant: variant, variant_span: None, args: [EnumLitArg]{}, leading_dot: false, span: span}
    }
}

fn sema_call_core_type_parameter(signature: CoreTypedCallSignature, name: String) -> CoreCallTypeParameter? {
    loop parameter in signature.type_parameters {
        if parameter.name == name -> return Val(parameter)
    }
    None
}

fn sema_call_core_math_exact_type(ty: Type) -> Bool Never! {
    if ty == {.Named(name) -> name == "Fraction" || name == "Decimal" else -> false}
}

fn sema_call_core_math_float_type(ty: Type) -> Bool Never! {
    ty == Type.Float || ty == Type.Float32
}

fn sema_call_core_type_constraint_satisfied(constraint: CoreCallTypeConstraint, ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    return if constraint == {
        .Any -> true
        .Integer -> sema_expr_is_integer(ty)
        .Numeric -> {
            if sema_expr_is_numeric(ty) || ty == (Type.Named{name: "Complex"}) -> return true
            if program.registration_graph == .Val(graph) {
                return sema_type_bound_satisfied_with_generics(graph, ty, "Numeric", environment.module_identity, environment.generic_params) ?? false
            } else {
                return false
            }
        }
        .Floating -> sema_call_core_math_float_type(ty)
        .FloatingOrExact -> sema_call_core_math_float_type(ty) || sema_call_core_math_exact_type(ty)
        .SquareRootInput -> {
            if sema_call_core_math_float_type(ty) || sema_call_core_math_exact_type(ty) -> return true
            return if ty == {.Apply(name, args) -> name == "Measurement" && args == [Type]{Type.Float} else -> false}
        }
        .Comparable -> sema_type_comparable(environment, program, ty)
        .Debuggable -> {
            if ty == {
                .Int | .Float | .Float32 | .Bool | .String | .Char | .IntN(_, _) -> { return true }
                else -> {}
            }
            if program.registration_graph == .Val(graph) {
                return sema_type_bound_satisfied_with_generics(graph, ty, "Debuggable", environment.module_identity, environment.generic_params) ?? false
            } else {
                return false
            }
        }
        // Rust `infer_core_call` vault arm: VaultKey is sealed to SigningKey
        // and X25519SecretKey; a generic body defers the bound to
        // monomorphization, so a type parameter in scope satisfies it.
        .VaultKey -> {
            key := ty
            if ty == .Tagged(marker, inner) {
                if marker == (TagMarker.Internal{internal_tag: InternalTag.CoreCryptoNominal}) -> key = inner
            }
            if key == .Named(name) {
                loop parameter in environment.generic_params {
                    if parameter.name == name -> return true
                }
                colon_leaf :: name.slice(name.rfind(":") + 1, name.len())
                leaf :: colon_leaf.slice(colon_leaf.rfind(".") + 1, colon_leaf.len())
                return leaf == "SigningKey" || leaf == "X25519SecretKey"
            }
            false
        }
    }
}

fn sema_call_core_inference_type(signature: CoreTypedCallSignature, ty: Type) -> Type Never! {
    special_float := (loop parameter in signature.type_parameters {
        if parameter.constraint == CoreCallTypeConstraint.FloatingOrExact || parameter.constraint == CoreCallTypeConstraint.SquareRootInput -> break true
    } ?? false)
    if special_float && sema_call_core_math_exact_type(ty) -> Type.Float else -> ty
}

fn sema_call_core_inference_parameters(signature: CoreTypedCallSignature, span: Span) -> [SemaInferenceTypeParam] Never! {
    parameters :: loop parameter in signature.type_parameters -> SemaInferenceTypeParam{
        name: parameter.name,
        bounds: [String]{},
        span: span,
        identity_key: "",
    }
    parameters
}

fn sema_call_core_parameter_records(signature: CoreTypedCallSignature, type_args: [Type], span: Span, allow_exact_math_inputs: Bool) -> [SemaCallParam] Never! {
    names :: loop parameter in signature.type_parameters -> parameter.name
    result := [SemaCallParam]{}
    loop (index, parameter) in signature.parameters {
        ty := sema_inference_substitute_type(parameter.ty, names, type_args)
        if allow_exact_math_inputs && parameter.ty == .Named(name) {
                if sema_call_core_type_parameter(signature, name) == {
                    .Val(type_parameter) -> {
                        if {
                            type_parameter.constraint == CoreCallTypeConstraint.FloatingOrExact -> {
                                ty = Type.Union{members: [Type]{Type.Float, Type.Float32, Type.Named{name: "Fraction"}, Type.Named{name: "Decimal"}}}
                            }
                            type_parameter.constraint == CoreCallTypeConstraint.SquareRootInput -> {
                                ty = Type.Union{members: [Type]{Type.Float, Type.Float32, Type.Named{name: "Fraction"}, Type.Named{name: "Decimal"}, Type.Apply{name: "Measurement", args: [Type]{Type.Float}}}}
                            }
                        }
                    }
                    .None -> {}
                }
            }
        default_expr := if parameter.default == {
            .Val(value) -> Val(sema_call_core_default_expr(value, span))
            .None -> None
        }
        name :: if {
            parameter.name != "" -> parameter.name
            parameter.label != "" -> parameter.label
            else -> "argument {index + 1}"
        }
        &result.push(SemaCallParam{
            label: parameter.label,
            name: name,
            zone: parameter.zone,
            default: default_expr,
            default_ref: None,
            convention: parameter.access,
            ty: Val(ty),
            variadic: false,
        })
    }
    result
}
fn sema_call_core_infer_type_args(signature: CoreTypedCallSignature, params: [SemaCallParam], binding: SemaCallBinding, source_args: [CallArg], explicit_type_args: [Type], expected: Type?, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [Type]? {
    if signature.type_parameters.len() == 0 -> return Val([Type]{})
    inference_parameters :: sema_call_core_inference_parameters(signature, span)
    inference_context := sema_inference_context(environment.module_identity, environment.package_identity, inference_parameters, environment.generic_params, expected)
    if explicit_type_args.len() > 0 {
        result :: sema_infer_validate_explicit(program.registration_graph, &inference_context, explicit_type_args, span, &diagnostics) ?? return None
        return Val(result.type_args)
    }
    facts := sema_call_collect_inference_facts(params, binding, source_args, environment, program, &scopes, &state, &tail_store, &context)
    sema_call_lambda_failure_facts(&facts, inference_parameters, params, binding, source_args, environment, program, &scopes, &state, &tail_store, &context)
    inferred_arguments :: loop ty in facts.argument_types -> sema_call_core_inference_type(signature, ty)
    inference :: sema_infer_callable(program.registration_graph, &inference_context, facts.parameter_types, signature.return_type, inferred_arguments, [Type]{}, span, &diagnostics) ?? return None
    if !inference.complete || !inference.compatible {
        &diagnostics.push(sema_error("E0904", span, "cannot infer the type arguments for `{signature.module_name}.{signature.member}`", "the fixed Core signature must resolve each declared type parameter from its checked arguments or expected result", "provide enough arguments to determine the Core call's type"))
        return None
    }
    Val(inference.type_args)
}

fn sema_call_core_check_type_constraints(signature: CoreTypedCallSignature, type_args: [Type], args: [CallArg], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Bool {
    if signature.type_parameters.len() != type_args.len() -> return false
    loop index in 0..<signature.type_parameters.len() {
        parameter :: signature.type_parameters[index]
        if !sema_call_core_type_constraint_satisfied(parameter.constraint, type_args[index], environment, program) {
            comparability := if parameter.constraint == CoreCallTypeConstraint.Comparable && args.len() > 0 -> sema_comparability_core_error(signature.member, expr_span(args[0].expr)) else -> None
            if parameter.constraint == CoreCallTypeConstraint.VaultKey -> comparability = Val(sema_error("E0905", span, "`{type_name(type_args[index])}` is not a persistent vault key type", "VaultKey is sealed and implemented only by SigningKey and X25519SecretKey", "use `crypto.SigningKey` or `crypto.X25519SecretKey`"))
            &diagnostics.push(comparability ?? sema_error("E0905", span, "`{type_name(type_args[index])}` does not satisfy the canonical Core constraint for type parameter `{parameter.name}`", "Core polymorphic signatures preserve the native type constraint", "pass a value with the required Core numeric or comparison type"))
            return false
        }
    }
    true
}

fn sema_call_core_result_type(signature: CoreTypedCallSignature, type_args: [Type], arguments: [TExpr]) -> Type? {
    names :: loop parameter in signature.type_parameters -> parameter.name
    if signature.result_rule == {
        .Declared -> {
            // A fixed row with no declared return (`-` in the host tables)
            // is a Unit call, as in Rust `infer_core_call`.
            declared :: signature.return_type ?? return Val(Type.Named{name: "Unit"})
            return Val(sema_inference_substitute_type(declared, names, type_args))
        }
        .AbsoluteValue(parameter_index) -> {
            if parameter_index < 0 || parameter_index >= arguments.len() -> return None
            argument := arguments[parameter_index]
            return Val(if argument.ty == (Type.Named{name: "Complex"}) -> Type.Float else -> argument.ty)
        }
        .FloatIfExactElseParameter(parameter_index) -> {
            if parameter_index < 0 || parameter_index >= arguments.len() -> return None
            argument := arguments[parameter_index]
            return Val(if sema_call_core_math_exact_type(argument.ty) -> Type.Float else -> argument.ty)
        }
    }
}

// The fixed path starts from the canonical Source contract. Specialized native
// polymorphic bodies remain ahead of this entry point when no fixed row exists.
fn sema_call_core_posix_control(member: String) -> Bool Never! {
    member == "fork" || member == "setuid" || member == "setgid" || member == "setpgid" || member == "setpgrp" || member == "setsid" || member == "initgroups" || member == "kill" || member == "wait" || member == "waitpid" || member == "pipe" || member == "close_fd" || member == "mkfifo" || member == "umask" || member == "getpriority" || member == "setpriority" || member == "utime" || member == "atexit" || member == "stop"
}

fn sema_call_core_materialize_authority_boundary(record: CoreCallRecord, index: Int, value: TExpr, span: Span) -> TExpr Never! {
    // copy: the materialized argument is a new owned TExpr. Off the authority boundary it equals
    // `value`, the caller's checked argument (a read parameter), which the caller keeps.
    if !core_call_authority_boundary_at(record, index) -> return value.copy()
    wire :: core_call("core.plugin", "__authority_to_wire") ?? panic("checked Authority wire row is missing")
    sema_tir_node(Type.String, TExprKind.CoreCall{record: wire, args: [TExpr]{value},
        source_span: span, type_args: [Type]{}, widen_to_vec: [Bool]{false},
        data_plan: None, fallibility: TFailureCarrier.Infallible}, span)
}

fn sema_call_core_check_fixed_record(record: CoreCallRecord, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if !sema_pin_check_call(record.module_name, record.member, args, &diagnostics) -> return None
    if record.module_name == "core.term" && (record.member == "__stdio_write" || record.member == "__stdio_bytes" || record.member == "__stdio_flush" || record.member == "__stdio_fault" || record.member == "__stdout_terminal" || record.member == "__stderr_terminal" || record.member == "__stdin_line") {
        if !environment.source_file.starts_with("<corelib>/") || !environment.module_name.starts_with("core.") {
            &diagnostics.push(sema_error("E0510", span, "stdio raw leaves are compiler-private", "raw stdio operations are restricted to checked Core source", "use the public core.term API"))
            return None
        }
    }
    if record.module_name == "core.mem" && record.member == "__loader_new" {
        if !environment.source_file.starts_with("<corelib>/") || environment.module_name != "core.data" {
            &diagnostics.push(sema_error("E0510", span, "data loader construction is compiler-private", "the native loader constructor is restricted to checked Core data source", "use core.data.value"))
            return None
        }
    }
    if record.module_name == "core.encoding" && (record.member == "__coerce_now" || record.member == "__coerce_emit") {
        if !environment.source_file.starts_with("<corelib>/") || environment.module_name != "core.encoding.json" || context.unsafe_depth == 0 {
            &diagnostics.push(sema_error("E0510", span, "JSON coercion host leaves are compiler-private", "the existing hidden Time/IO boundary is restricted to audited Core JSON source", "use the public JSON decoder"))
            return None
        }
    }
    if record.module_name == "core.encoding" && (record.member == "__query_read_bounded" || record.member == "__query_validate_fields") {
        if !environment.source_file.starts_with("<corelib>/") || environment.module_name != "core.encoding.csv" {
            &diagnostics.push(sema_error("E0510", span, "CSV query leaves are compiler-private", "raw CSV query mechanics are restricted to Core CSV source", "use csv.query<T>"))
            return None
        }
    }
    backing :: (record.module_name == "core.mem" && (record.member == "__list_capacity" || record.member == "__list_reserve_exact" || record.member == "__type_size")) || (record.module_name == "core.encoding" && (record.member == "__read_byte" || record.member == "__read_into" || record.member == "__write_bytes" || record.member == "__write_text" || record.member == "__flush" || record.member == "__utf8_validate" || record.member == "__bytes_into_text" || record.member == "__text_into_bytes" || record.member == "__string_byte" || record.member == "__object_from_entries" || record.member == "__object_entries_view" || record.member == "__bytes_view" || record.member == "__typed_text"))
    // Testing shares the two audited String leaves, not stream or Dyn backing access.
    checked_testing_text :: environment.module_name == "core.testing" && record.module_name == "core.encoding" && (record.member == "__string_byte" || record.member == "__bytes_into_text")
    checked_backing_source :: environment.source_file.starts_with("<corelib>/") && (environment.module_name == "__core_encoding_stream" || environment.module_name == "__core_encoding_cbor_stream" || environment.module_name == "core.encoding.csv" || environment.module_name == "core.encoding.xml" || environment.module_name == "__core_encoding_xml_engine" || checked_testing_text || (record.module_name == "core.mem" && record.member == "__list_reserve_exact" && environment.module_name == "__core_crypto_ct") || ((record.module_name == "core.mem" || (record.module_name == "core.encoding" && record.member == "__utf8_validate")) && environment.module_name == "__core_encoding_cbor_parse"))
    if backing && !checked_backing_source {
        &diagnostics.push(sema_error("E0510", span, "encoding backing leaves are compiler-private", "raw carrier operations are restricted to vetted Core encoding internals", "use the public JSON or JSONL API"))
        return None
    }
    audited :: record.module_name == "core.encoding" && (record.member == "__bytes_into_text" || record.member == "__string_byte" || record.member == "__object_from_entries" || record.member == "__object_entries_view" || record.member == "__bytes_view" || record.member == "__typed_text")
    if audited && context.unsafe_depth == 0 {
        &diagnostics.push(sema_error("E0510", span, "raw encoding carrier access requires an audited #Unsafe region", "the caller must establish the carrier variant or byte bounds", "check the precondition immediately before the audited call"))
        return None
    }
    canonical_record :: sema_call_core_record(record.module_name, record.member, args.len(), span, &diagnostics) ?? return None
    if !core_call_coverage_contains(canonical_record.coverage, CORE_CALL_COVERAGE_SEMA) {
        &diagnostics.push(sema_error("E0904", span, "`{canonical_record.module_name}.{canonical_record.member}` has no source semantic call contract", "only SEMA-authorized Core records enter fixed-call checking", "use a SEMA-covered Core call"))
        return None
    }
    // #1465: POSIX process/session control requires `#Unsafe` (I1); checking continues.
    if canonical_record.module_name == "core.sys" && context.unsafe_depth == 0 && sema_call_core_posix_control(canonical_record.member) {
        &diagnostics.push(sema_error("E3101", span, "`core.sys.{canonical_record.member}` requires an audited `#Unsafe` region", "POSIX process and session control can change credentials, signals, and process topology (I1)", "wrap the call in `#Unsafe(\"posix {canonical_record.member}: …\") {{ … }}` and gate the host OS with `prep if $build.os` / `#Target(OS.*)`"))
    }
    if context.unsafe_depth == 0 && ((canonical_record.module_name == "core.ui" && (canonical_record.member == "__node_transfer" || canonical_record.member == "__viewport_transfer" || canonical_record.member == "__accessibility_transfer" || canonical_record.member == "__shortcut_transfer")) || (canonical_record.module_name == "core.ui.host" && canonical_record.member == "__request_transfer")) {
        &diagnostics.push(sema_error("E3101", span, "`{canonical_record.module_name}.{canonical_record.member}` requires an audited `#Unsafe` region", "raw host carrier transfer trusts the Core packer's validated tags, words, and retained slots", "use the safe `core.ui` constructors, or wrap a vetted Core transfer in `#Unsafe(\"UI carrier transfer: …\") {{ … }}`"))
    }
    if canonical_record.module_name == "core.http.server" && canonical_record.member == "__response_parts" && context.unsafe_depth == 0 {
        &diagnostics.push(sema_error("E3101", span, "`core.http.server.__response_parts` requires an audited `#Unsafe` region", "the transport transfer trusts the source response policy and consumes body ownership", "wrap the transfer in `#Unsafe(\"normalized response ownership transfer\") {{ … }}`"))
    }
    actual_accesses :: loop argument in args -> argument.convention
    signature :: sema_call_core_typed_signature(canonical_record, args.len(), actual_accesses, [Type]{}) ?? {
        &diagnostics.push(sema_error("E0904", span, "`{canonical_record.module_name}.{canonical_record.member}` has no fixed source typed call contract", "fixed Core checking consumes only a complete Source signature", "use the source-owned special checker for a polymorphic Core operation without a fixed row"))
        return None
    }
    if !sema_call_core_check_type_args(canonical_record.module_name, canonical_record.member, signature.type_parameters.len(), true, type_args, span, &diagnostics) -> return None
    source_args := [CallArg]{}
    local_args := [CallArg]{}
    loop argument in args {
        &source_args.push(argument)
        &local_args.push(argument)
    }
    shape_params := sema_call_core_parameter_records(signature, [Type]{}, span, false)
    binding :: sema_call_bind_args("{canonical_record.module_name}.{canonical_record.member}", shape_params, &local_args, span, &diagnostics) ?? return None
    resolved_type_args :: sema_call_core_infer_type_args(signature, shape_params, binding, source_args, type_args, expected, span, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if !sema_call_core_check_type_constraints(signature, resolved_type_args, args, span, environment, program, &diagnostics) -> return None
    params := sema_call_core_parameter_records(signature, resolved_type_args, span, type_args.len() == 0)
    (checked_args, pins) := sema_call_check_bound_arguments_owned(&state, "{canonical_record.module_name}.{canonical_record.member}", params, None, false, binding, &local_args, environment, program, &scopes, &tail_store, &context, span, &diagnostics) ?? return None
    // A `&` argument keeps its Write borrow of the caller's place: a Core leaf
    // that lends a buffer or handle (zeroize, reserve, stream writers) works
    // on the original, never on a copy.
    values := [TExpr]{}
    loop argument in checked_args {
        if argument.mut_borrow {
            ty :: argument.value.ty.copy()
            at :: argument.value.span
            &values.push(sema_tir_node(ty, TExprKind.Borrow{place: argument.value, access: AccessConvention.Write}, at))
        } else {
            &values.push(argument.value)
        }
    }
    result_type :: sema_call_core_result_type(signature, resolved_type_args, values) ?? {
        &diagnostics.push(sema_error("E0904", span, "`{canonical_record.module_name}.{canonical_record.member}` did not resolve a result type", "the typed Core result rule must produce the value shape written into TIR", "complete the source typed return contract"))
        return None
    }
    // Rust `core_call_expr` / `checked_core_type_args`: the CoreCall carrier is
    // derived from the checked result type (`TFailureCarrier::from_checked_type`:
    // only a Result or Option result can fail), and its type arguments are the
    // call's written ones. The inferred signature arguments check constraints
    // and record the call fact; the native kernel takes no inferred generic.
    fallibility := sema_expression_failure_carrier(result_type)
    if !sema_call_core_record_effects(canonical_record, span, resolved_type_args, result_type, fallibility, [FunctionDefaultRef]{}, &scopes, &context, environment, program, &diagnostics) -> return None
    if canonical_record.module_name == "core.encoding" && (canonical_record.member == "__object_entries_view" || canonical_record.member == "__bytes_view") {
        sources :: [ViewSourcePath]{ViewSourcePath{source: ViewSource.Parameter{index: 0}, projections: [ViewSourceProjection]{}}}
        provenance :: ViewProvenanceMap{entries: [ViewProvenanceEntry]{ViewProvenanceEntry{slot: [String]{}, value: ViewProvenance{sources: sources, mutable: false}}}}
        callable :: Type.Fn{params: [Type]{}, ret: Val(result_type), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: Val(provenance)}
        facts :: sema_call_return_view_facts(callable, None, args, binding, scopes, &state, span)
        &context.call_return_views.push(SemaCallReturnView{span: span, facts: facts})
    }
    value :: sema_call_core_tir(canonical_record, values, span, type_args, loop _ in values -> false, None, result_type, fallibility, None, environment, program, &diagnostics) ?? return None
    sema_expression_call_expected(sema_call_with_binder_pins(^pins, ^value, span), expected, environment, program, context, &diagnostics)
}

// Resolve source exports before building a fixed Core call. The callee's
// canonical typed contract is discovered here; callers never supply its Type.
fn sema_call_core_check_fixed(environment: SemaScopeEnvironment, program: SemaProgramTables, module_name: String, member: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    route :: sema_call_core_resolve_route(environment, program, module_name, member, type_args, args.len(), sema_call_core_first_is_move(args), span, &diagnostics) ?? return None
    if route == {
        .SharedSite(lifetime) -> { return sema_call_core_global_shared(lifetime, member, type_args, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) }
        .Source(target) -> { return sema_call_core_check_source_owned(target, "{module_name}.{member}", type_args, args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) }
        .Core(record) -> { return sema_call_core_check_fixed_record(record, args, type_args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) }
    }
}

fn sema_call_core_shared_diagnostic(member: String, span: Span) -> Diagnostic Never! {
    sema_error("E0109", span, "`core.mem.{member}` needs a direct Core initializer", "a publication site requires a non-generic, zero-argument, infallible module function declared in the same Core module, returning Shared<T>; its inferred effects may contain only Mem and its publication lifetime must be consistent", "pass the name of a same-module Shared initializer with no effects except allocation")
}

fn sema_call_core_shared_reject(member: String, span: Span, diagnostics: &[Diagnostic]) -> TExpr? Never! {
    &diagnostics.push(sema_call_core_shared_diagnostic(member, span))
    None
}

// The trusted Core body supplies a side-effect-free constructor. Ordinary
// zero-argument call checking owns its failure/effect facts; this node only
// changes the storage lifetime and preserves its declared Shared payload type.
fn sema_call_core_global_shared(lifetime: MIRSharedLifetime, member: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if !environment.module_identity.starts_with("<corelib>/") {
        &diagnostics.push(sema_error("E0067", span, "`{member}` is reserved for Jet", "Double-underscore names belong to the compiler, generated binders, debugger, serializer, and tools", "Rename it without the second leading underscore"))
        return None
    }
    if args.len() != 1 || type_args.len() != 0 -> return sema_call_core_shared_reject(member, span, &diagnostics)
    if args[0].label != None || args[0].spread -> return sema_call_core_shared_reject(member, span, &diagnostics)
    name :: if args[0].expr == {.Ident(value, _) -> Val(value) else -> None} ?? return sema_call_core_shared_reject(member, span, &diagnostics)
    nearest :: sema_scope_resolve_index(scopes, name) ?? return sema_call_core_shared_reject(member, span, &diagnostics)
    if scopes.bindings[nearest].symbol.kind != SymbolKind.Function -> return sema_call_core_shared_reject(member, span, &diagnostics)
    target :: sema_call_resolve_direct(name, [Type]{}, environment, program, &scopes, args[0].span, &diagnostics) ?? return sema_call_core_shared_reject(member, span, &diagnostics)
    if target.generic_params.len() != 0 -> return sema_call_core_shared_reject(member, span, &diagnostics)
    same_module := false
    loop declaration_index in 0..<environment.declarations.len() {
        if environment.declarations[declaration_index].symbol_id != target.symbol.id -> next
        if environment.declarations[declaration_index].item == .Func(function) {
            same_module = function.external_type == None && function.type_params.len() == 0 && function.params.len() == 0
            break
        }
    }
    if !same_module -> return sema_call_core_shared_reject(member, span, &diagnostics)
    params :: sema_call_params_from_type(target.signature) ?? return sema_call_core_shared_reject(member, span, &diagnostics)
    if params.len() != 0 -> return sema_call_core_shared_reject(member, span, &diagnostics)
    call :: Call{name: name, name_span: span, type_args: [Type]{}, args: [CallArg]{}}
    checked :: sema_call_check_direct_target_owned(&state, target, call, [SemaCallDefaultValue]{}, None, environment, program, &scopes, &tail_store, &context, &diagnostics) ?? return sema_call_core_shared_reject(member, span, &diagnostics)
    if checked.facts.failure_carrier != TFailureCarrier.Infallible -> return sema_call_core_shared_reject(member, span, &diagnostics)
    shared :: if checked.value.ty == {
        .Shared(_) -> true
        else -> false
    }
    if !shared -> return sema_call_core_shared_reject(member, span, &diagnostics)
    before :: context.call_facts.len()
    if !sema_expr_record_call_fact(environment, program, &scopes, &context, span, checked, &diagnostics) -> return None
    if context.call_facts.len() != before + 1 -> panic("checked Core publication call has no effect obligation")
    context.call_facts[before].shared_lifetime = Val(lifetime)
    context.call_facts[before].shared_member = member
    context.call_facts[before].shared_source = environment.module_identity
    value :: sema_tir_node(checked.value.ty, TExprKind.GlobalShared{initializer: target.symbol.id, lifetime: lifetime}, span)
    sema_expr_expected(value, expected, environment, program, &diagnostics)
}

fn sema_call_core_check_source_owned(target: SemaCallDirectTarget, qualified_name: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if target.symbol.name == "graph" && sema_call_core_module_identity(environment, program, "core.build") == (Val(target.symbol.module_name)) {
        if !sema_call_core_check_type_args("core.build", "graph", 0, false, type_args, span, &diagnostics) -> return None
        check :: sema_compiler_services_check_call("core.build", "graph", args, span, environment.function_name == "build", environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return sema_compiler_services_lower_core_call(check, span, expected, environment, program, &scopes, &context, &diagnostics)
    }
    call := Call{name: qualified_name, name_span: span, type_args: type_args, args: args}
    checked :: sema_call_check_direct_target_owned(&state, target, call, [SemaCallDefaultValue]{}, expected, environment, program, &scopes, &tail_store, &context, &diagnostics) ?? return None
    // Rust `record_call_result_views` composes every call's returned views
    // with its arguments; a source-module call (`stream.object_entries(v)`)
    // publishes them like a direct call, so a binding keeps the view's owner.
    &context.call_return_views.push(SemaCallReturnView{span: span, facts: checked.return_view_facts})
    if !sema_expr_record_call_fact(environment, program, &scopes, &context, span, checked, &diagnostics) -> return None
    Val(checked.value)
}

// `core.prelude.keep` is an erased identity: its checked argument is the call
// result, with an optional explicit type argument constraining that value.
fn sema_call_core_identity_value(value: TExpr, type_args: [Type], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    if !sema_call_core_check_type_args("core.prelude", "keep", 1, true, type_args, value.span, &diagnostics) -> return None
    result := value
    if type_args.len() == 1 {
        required := sema_expr_expected_type(type_args[0], environment, program)
        result = sema_expr_expected(value, Val(required), environment, program, &diagnostics) ?? return None
    }
    sema_expr_expected(result, expected, environment, program, &diagnostics)
}

#Test("private loader constructor substitutes a user record return type") {
    record :: core_call("core.mem", "__loader_new") ?? panic("loader constructor row")
    user_record :: Type.Named{name: "UserRec"}
    signature :: sema_call_core_typed_signature(record, 7, [AccessConvention]{}, [Type]{user_record}) ?? panic("loader constructor signature")
    result :: sema_call_core_result_type(signature, [Type]{user_record}, [TExpr]{}) ?? panic("loader constructor result")
    assert_eq(result, Type.Result{ok: Type.Apply{name: "DataLoader", args: [Type]{user_record}}, err: Type.Named{name: "DataError"}})
}

#Test("worker checked-function inference changes no other Core route") {
    moves :: [Bool]{false, true}
    loop row in CORE_CALLS {
        loop moved in moves {
            previous :: (row.module_name == "core.math" && (row.member == "cmp" || row.member == "is_finite")) ||
                ((row.module_name == "core.encoding.json" || row.module_name == "core.encoding.jsonl") && row.member == "reader" && moved) ||
                (row.module_name == "core.net.tls" && row.member == "client" && moved)
            worker :: row.module_name == "core.service" && row.member == "worker"
            assert(sema_call_core_native_resource_consumer(row.module_name, row.member, moved) == (previous || worker))
        }
    }
}
