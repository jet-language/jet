// Canonical source-side resolution and construction for registry-backed Core calls.
//
// Foundation owns Core identity and backend facts. Call resolution prefers
// source exports; a native row's call is checked against its Core
// declaration, the typed contract call construction consumes.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    CORE_CALL_COVERAGE_SEMA,
    CORE_MODULE_EXPORTS,
    CORE_SOURCE_OWNED_ROWS,
    Call,
    CallArg,
    CoreCallProjectionError,
    CoreCallRecord,
    CoreUnbuiltRow,
    core_unbuilt_call,
    core_unbuilt_method,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    NodeKind,
    SharedLifetime,
    Span,
    SymbolID,
    SymbolKind,
    TFailureCarrier,
    TGenericParam,
    TNumericOp,
    TextEdit,
    Type,
    TypeTupleField,
    CoreCallSymbol,
    core_call,
    core_call_authority_boundary_at,
    core_call_accepts_arity,
    core_call_coverage_contains,
    core_call_source_member,
    core_call_source_role,
    core_call_projection,
    core_module_export,
    diagnostic_with_edit,
    expr_span,
    type_name,
    shared_lifetime_core_member,
    CORE_CALLS,
    ModuleID,
    module_find,
    module_is_core,
    module_none,
    module_text,
    sema_casing_pascal_words,
    foundation_byte_text,
]

// A visible module alias (`use slots`, `use core.mem`) and the registered
// module it names.
SemaCallImportTarget: struct {
    alias: String,
    module_identity: String,
    module_name: String,
    item: String?,
    span: Span,
}

SemaCoreCallRoute: enum {
    Source(target: SemaCallDirectTarget),
    Core(record: CoreCallRecord),
    SharedSite(lifetime: SharedLifetime),
}

sema_call_core_import_target: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, alias: String) -> SemaCallImportTarget? {
    graph: program.registration_graph
    module_index: sema_scope_caller_index(environment, graph) ?? return None
    imported: sema_core_registration_import(graph.modules[module_index], graph.module_table, alias) ?? return None
    module_name := imported.module_name
    target_index: sema_registration_module_index_text(graph, imported.module_name)
    if target_index != None {
        index: target_index
        module_name = graph.modules[index].module_name
    }
    if !sema_core_import_is_core(module_name) -> return None
    return Val(SemaCallImportTarget{alias: alias, module_identity: imported.module_name, module_name: module_name, item: imported.item, span: imported.span})
}

// The source module a whole-module import alias binds: `use slots`, or the
// file import a body-less `math: module` declares. None for a Core
// module or a member import.
sema_call_source_import_target: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, alias: String) -> SemaCallImportTarget? {
    graph: program.registration_graph
    module_index: sema_scope_caller_index(environment, graph) ?? return None
    loop import_index in 0..<graph.modules[module_index].imports.len() {
        loop binding_index in 0..<graph.modules[module_index].imports[import_index].bindings.len() {
            if graph.modules[module_index].imports[import_index].bindings[binding_index].local != alias || graph.modules[module_index].imports[import_index].bindings[binding_index].symbol.kind != SymbolKind.Import || graph.modules[module_index].imports[import_index].bindings[binding_index].declaration_position != None {
                next
            }
            target_index: sema_registration_module_index(graph, graph.modules[module_index].imports[import_index].bindings[binding_index].target_module_identity) ?? return None
            module_name: graph.modules[target_index].module_name
            if sema_core_import_is_core(module_name) -> return None
            return Val(SemaCallImportTarget{alias: alias, module_identity: module_text(graph.module_table, graph.modules[module_index].imports[import_index].bindings[binding_index].target_module_identity), module_name: module_name, item: None, span: graph.modules[module_index].imports[import_index].bindings[binding_index].symbol.span})
        }
    }
    return None
}

// E0628 for `alias.member` in a module that lists the file module `alias`
// and takes the file's item `alias` with a `use`: while that item is the
// visible binding of `alias`, the dot reaches no file member.
sema_call_taken_over_file_member: fn(alias: String, member: String, member_span: Span, check: SemaBodyCheck) -> Diagnostic? Never! {
    graph: check.program.registration_graph
    module_index: sema_scope_caller_index(check.environment.*, graph) ?? return None
    if !sema_registration_file_name_taken_over(graph.modules[module_index], alias) {
        return None
    }
    visible_index: sema_scope_resolve_index(check.scopes, alias) ?? return None
    visible_id: check.scopes.bindings[visible_index].symbol.id
    loop import in graph.modules[module_index].imports {
        loop binding in import.bindings {
            if binding.local == alias && binding.symbol.id == visible_id {
                return Val(sema_taken_over_file_member(alias, member, member_span))
            }
        }
    }
    None
}

// Resolve through Registration identity, not source spelling alone.
sema_call_core_import_module: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, alias: String) -> String? {
    target: sema_call_core_import_target(environment, program, alias) ?? return None
    Val(target.module_name)
}

sema_call_core_import_member: fn(target: SemaCallImportTarget, requested_member: String) -> String? {
    if target.item == .Val(item) {
        if requested_member != "" && requested_member != item -> return None
        return Val(item)
    }
    if requested_member == "" -> return None
    Val(requested_member)
}

// The loaded module whose source functions a Core import calls. A member
// that names a Core submodule (`use core.files`) binds the module by name,
// not by a loaded identity, so its source rows are found by that name.
sema_call_core_import_source_identity: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, target: SemaCallImportTarget) -> ModuleID? {
    graph: program.registration_graph
    if sema_registration_module_index_text(graph, target.module_identity) == .Val(index) {
        return Val(graph.modules[index].module_identity)
    }
    sema_call_core_module_identity(environment, program, target.module_name)
}

// An import is usable only while its exact registered binding remains the
// visible lexical binding for the local alias.
sema_call_core_import_is_unshadowed: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, target: SemaCallImportTarget) -> Bool Never! {
    graph: program.registration_graph
    module_index: sema_scope_caller_index(environment, graph) ?? return false
    visible_index: sema_scope_resolve_index(scopes, target.alias) ?? return false
    visible_symbol := scopes.bindings[visible_index].symbol
    module_row: graph.modules[module_index]
    // Only an import whose target spells the alias's module is its binding.
    target_identity: module_find(graph.module_table, target.module_identity) ?? return false
    loop import in module_row.imports {
        loop binding in import.bindings {
            // A Core submodule member (`use core.mem`) names its own target.
            if import.target_module_identity != target_identity && binding.target_module_identity != target_identity {
                next
            }
            if binding.local != target.alias -> next
            skip_binding := if target.item == {
                .Val(item) -> binding.original != item
                .None -> binding.symbol.kind != SymbolKind.Import
            }
            if skip_binding -> next
            if visible_symbol.id == binding.symbol.id -> return true
        }
    }
    return false
}

sema_call_core_record_import_reference: fn(check: ^SemaBodyCheck, target: SemaCallImportTarget, span: Span) -> Bool Never! {
    if !sema_call_core_import_is_unshadowed(check.environment.*, check.program.*, check.scopes, target) {
        return false
    }
    index: sema_scope_resolve_index(check.scopes, target.alias) ?? return false
    check.context.name_references.push(sema_name_reference(span, sema_scope_binding_symbol(check.environment.*, check.scopes, index), Val(SymbolKind.Import)))
    true
}

// A raw `core.crypto.expert` primitive, the raw-key legacy migration
// `core.files.sealed.migrate_v1`, or a `core.crypto.vault` key-material
// operation outside the typed lifecycle, runs only inside an audited `#Unsafe`
// region. The call already resolved through the module's import, so the region
// is the remaining gate. True when the call was refused: it has no result for
// later checks to judge.
sema_call_core_crypto_expert_gate: fn(module_name: String, member: String, span: Span, check: ^SemaBodyCheck) -> Bool Never! {
    if check.context.unsafe_depth > 0 -> return false
    if module_name == "core.crypto.expert" || (module_name == "core.files.sealed" && member == "migrate_v1") {
        check.diagnostics.push(sema_error("E0510", span, "`{module_name}.{member}` requires an audited `#Unsafe` region", "raw crypto primitives may only run inside an explicit expert-tier gate", "wrap the call in `#Unsafe(\"crypto expert: …\") {{ … }}` or use `crypto.seal`/`open` instead"))
        return true
    }
    if module_name == "core.crypto.vault" && !sema_call_core_vault_safe_member(member) {
        check.diagnostics.push(sema_error("E0510", span, "`{module_name}.{member}` requires an audited `#Unsafe` region", "raw key import may only run inside an explicit expert-tier gate", "wrap the call in `#Unsafe(\"vault key import: …\") {{ … }}`"))
        return true
    }
    false
}

// A `core.crypto.vault` call in build-time code (a `#run` block, a module
// field, a comptime function, the body of `build: fn`) is E1265. No gate
// unlocks it, `#Impure` included: a build artifact must never hold a decrypted
// secret. True when reported; the call then has no value, so no comptime
// evaluation is staged for it.
sema_call_core_vault_build_time_gate: fn(module_name: String, member: String, span: Span, check: ^SemaBodyCheck) -> Bool Never! {
    if module_name != "core.crypto.vault" -> return false
    if !sema_scope_build_time(check.scopes, check.environment.*, check.program.*) -> return false
    row: sema_diagnostic_row("E1265")
    check.diagnostics.push(sema_error("E1265", span, "`{module_name}.{member}()` can't be reached from a build-time context", row.why, row.fix))
    true
}

// E2104 for a user call of a Core surface no `jet` has built yet (R2(b)).
// The surface's runtime is missing, so building the call would stop inside the
// compiler; sema reports E2104 at the call instead. The surface, its feature
// and its card come from the one table of unbuilt surfaces (CORE_UNBUILT_ROWS).
sema_call_core_unbuilt_error: fn(callee: String, row: CoreUnbuiltRow, span: Span) -> Diagnostic Never! {
    sema_error("E2104", span, "`{callee}` is not built yet", "This `jet` has no implementation of {row.feature} yet, and no other `jet` can run it.", "Remove the `{callee}` call for now; {row.feature} needs its Jet implementation first (card #{row.card}).")
}

// E2104 at a checked call of a method an unbuilt Core type declares: the
// core_unbuilt_call member `Type.method` of the module declaring the
// receiver's type. Like sema_call_core_unbuilt_settle it stays silent when
// checking the call added an error since `before`, and it refuses the call
// wherever it is written, Core's own source included, only in a compile that
// lowers it (sema_refuses_unbuilt); true when reported.
sema_call_core_method_unbuilt: fn(receiver: Type, method: String, span: Span, before: Int, check: ^SemaBodyCheck) -> Bool Never! {
    if !core_unbuilt_method(method) || !sema_refuses_unbuilt(check.program.*) -> return false
    graph: check.program.registration_graph
    owner: sema_type_resolve_nominal_row(graph, sema_call_resolved_type(receiver, check.environment.*, check.program.*), check.environment.module_identity) ?? return false
    module_row: graph.modules[owner.module_index]
    if !module_is_core(module_row.module_identity) -> return false
    member: "{module_row.nominals[owner.row].symbol.name}.{method}"
    row: core_unbuilt_call(module_row.module_name, member) ?? return false
    if sema_has_error_since(check.diagnostics, before) -> return false
    check.diagnostics.push(sema_call_core_unbuilt_error(member, row, span))
    true
}

// A call of an unbuilt Core call (core_unbuilt_call): noted where the call
// resolves its Core member, settled once the call is checked.
SemaCoreUnbuiltCall: struct {
    module_name: String,
    member: String,
    span: Span,
}

// Notes a call that names an unbuilt Core feature, wherever it is written
// (Core's own source included), in a compile that lowers it
// (sema_refuses_unbuilt).
sema_call_core_unbuilt_note: fn(module_name: String, member: String, span: Span, check: SemaBodyCheck, unbuilt: ^SemaCoreUnbuiltCall?) Never! {
    if !sema_refuses_unbuilt(check.program.*) {
        return
    }
    if core_unbuilt_call(module_name, member) == None {
        return
    }
    unbuilt = Val(SemaCoreUnbuiltCall{module_name: module_name, member: member, span: span})
}

// E2104 at a checked user call of an unbuilt Core feature, reported only when
// checking the call added no error since `before`. A real checker error on
// the call (an argument type, E2913 for a signal of a function, an unbuilt
// call among its arguments) stands alone: E2104 never hides or precedes it,
// and a call reports E2104 at most once. A warning alone still gets E2104,
// so the call never reaches the IR.
sema_call_core_unbuilt_settle: fn(unbuilt: SemaCoreUnbuiltCall?, before: Int, diagnostics: ^[Diagnostic]) Never! {
    call: unbuilt ?? return
    if sema_has_error_since(diagnostics, before) {
        return
    }
    row: core_unbuilt_call(call.module_name, call.member) ?? return
    short: foundation_byte_text(call.module_name.bytes(), call.module_name.rfind(".") + 1, call.module_name.count_bytes())
    diagnostics.push(sema_call_core_unbuilt_error("{short}.{call.member}", row, call.span))
}

// The typed vault surface: the safe `get` read and the KeyRef lifecycle, whose
// source bodies hold their own audited regions.
sema_call_core_vault_safe_member: fn(member: String) -> Bool Never! {
    if member == {
        "get" | "current" | "versions" | "load" | "status" -> true
        "prepare_generate" | "prepare_store" | "prepare_rotate" | "prepare_retire" | "prepare_revoke" -> true
        "authorize_write" | "commit_generate" | "commit_store" | "commit_rotate" | "commit_retire" | "commit_revoke" -> true
        "export_to_recipients" | "export_to_passphrase" | "prepare_import_wrapped" | "authorize_wrapped_import" | "commit_import_wrapped" -> true
        else -> false
    }
}

sema_call_core_source_target: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_identity: ModuleID, member: String, type_args: [Type], span: Span, registered_source_target: Bool, diagnostics: ^[Diagnostic]) -> SemaCallDirectTarget? {
    graph: program.registration_graph
    module_index: sema_registration_module_index(graph, module_identity) ?? return None
    // Module rows are read in place; binding one would copy its whole program.
    source_name: graph.modules[module_index].module_name
    if sema_call_core_module_identity(environment, program, source_name) != Val(module_identity) {
        return None
    }
    caller_index: sema_scope_caller_index(environment, graph) ?? return None
    // Same-owner native providers keep their host row. A source-only function
    // has no such row and still resolves to its declaration from this module.
    if !registered_source_target && graph.modules[module_index].module_identity == graph.modules[caller_index].module_identity {
        if core_call(source_name, member) == .Val(record) {
            if record.symbol != CoreCallSymbol.SourceOwned -> return None
        }
    }
    core_private_seam: module_is_core(graph.modules[module_index].module_identity) && module_is_core(graph.modules[caller_index].module_identity)
    export: (if registered_source_target || core_private_seam -> sema_registration_resolve_export(graph, module_index, member, module_identity, graph.modules[module_index].package_identity) else -> sema_registration_resolve_export(graph, module_index, member, environment.module_identity, environment.package_identity)) ?? {
        // A member its own declaration keeps private (`priv`) gets the
        // ordinary visibility error a package's would, not "has no item";
        // so does a jet.runtime member, which is Core's alone.
        declared: sema_registration_direct_symbol(graph.modules[module_index], member) ?? return None
        hidden: !sema_registration_visible(declared.visibility, environment.module_identity, environment.package_identity, graph.modules[module_index].module_identity, graph.modules[module_index].package_identity)
        if hidden || source_name.starts_with("jet.runtime.") {
            diagnostics.push(sema_call_private_member(member, span))
        }
        return None
    }
    row: sema_call_export_function_row(environment, program, export) ?? {
        diagnostics.push(sema_call_not_callable(member, sema_registration_export_ty(graph, export) ?? Type.Named{name: "Unknown"}, span))
        return None
    }
    sema_call_export_function_target(environment, program, export, row, type_args, span, diagnostics)
}

// The registered function row an export names; None when it names no function.
sema_call_export_function_row: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, export: SemaRegistrationExport) -> SemaRegistrationRowRef? {
    graph: program.registration_graph
    owner_index: sema_registration_module_index(graph, export.source_module_identity) ?? return None
    // Search by index so the function collection stays borrowed.
    loop index in 0..<graph.modules[owner_index].functions.len() {
        if graph.modules[owner_index].functions[index].symbol.id == export.symbol.id {
            return Val(SemaRegistrationRowRef{module_index: owner_index, row: index})
        }
    }
    return None
}

// The direct-call target for an exported function called from another module.
sema_call_export_function_target: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, export: SemaRegistrationExport, row: SemaRegistrationRowRef, type_args: [Type], span: Span, diagnostics: ^[Diagnostic]) -> SemaCallDirectTarget? {
    graph: program.registration_graph
    registered: graph.modules[row.module_index].functions[row.row]
    target := sema_call_direct_target_from_registration(registered, program.registration_graph, environment.module_identity, environment.package_identity, environment.generic_params, type_args, span, diagnostics) ?? return None
    // As for a field, the signature names types as the owning module sees
    // them (`Stat` is `core.files`' own, `Slot` is `slots`' own), so it
    // resolves there with its type parameters kept, before the caller's
    // explicit type arguments are substituted.
    generics: loop param in registered.generic_params -> TGenericParam{name: param.name, bounds: [SymbolID]{}}
    owner_signature: sema_type_resolve_declared_with_generics(graph, registered.signature, export.source_module_identity, generics)
    target.signature = if target.generic_substitutions.len() == 0 -> owner_signature else -> sema_inference_substitute_type_bindings(owner_signature, target.generic_substitutions)
    return Val(target)
}

// `slots.wrap(..)` through a whole-module alias of a source module calls the
// function that module (or its package) exports, checked like a direct call. A
// private function is E0605 and any other name E0102. Core aliases keep their
// own route. `shown` is the member as written (`internal.secret` for a lifted
// inline-module member).
sema_call_try_source_module_call: fn(alias: String, alias_span: Span, member: String, shown: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck Never! {
    unhandled: SemaMethodSpecialCheck{handled: false, value: None}
    imported: sema_call_source_import_target(check.environment.*, check.program.*, alias) ?? return unhandled
    if !sema_call_core_record_import_reference(check, imported, alias_span) -> return unhandled
    graph: check.program.registration_graph
    module_index: sema_registration_module_index_text(graph, imported.module_identity) ?? return unhandled
    // A Core source module imported by its bare name (`use app`) is called
    // here, not through the Core module-method route.
    unbuilt := SemaCoreUnbuiltCall?{None}
    if module_is_core(graph.modules[module_index].module_identity) {
        sema_call_core_unbuilt_note(graph.modules[module_index].module_name, member, span, check, unbuilt)
    }
    if module_is_core(graph.modules[module_index].module_identity) {
        if sema_app_field_error_refused(graph.modules[module_index].module_name, member, args, check) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        // Before the live route, which `notify` takes: a device call is
        // checked for its target and purpose whichever route checks it.
        sema_call_app_device(graph.modules[module_index].module_name, member, alias, span, args, check.environment.*, check.program.*, check.context.function_name, check.diagnostics)
        sema_call_perf_name(graph.modules[module_index].module_name, member, args, check.diagnostics)
        if sema_live_member(graph.modules[module_index].module_name, member) {
            live: sema_call_live(member, alias, args, type_args, span, expected, check)
            return SemaMethodSpecialCheck{handled: true, value: live.value}
        }
    }
    before: check.diagnostics.len()
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    export: sema_registration_resolve_export(graph, module_index, member, check.environment.module_identity, check.environment.package_identity) ?? {
        if sema_registration_direct_symbol(graph.modules[module_index], member) != None {
            check.diagnostics.push(sema_call_private_member(shown, span))
        } else {
            check.diagnostics.push(sema_call_import_member_unknown(graph.modules[module_index].module_name, shown, alias_span))
        }
        loop argument in args -> _ := sema_check_expression(argument.expr, None, check)
        return failed
    }
    // A `#Import c.lib: module` member is a registered foreign row of the
    // synthetic library module, called directly like a source function.
    direct := SemaCallDirectTarget?{None}
    if sema_call_export_function_row(check.environment.*, check.program.*, export) == .Val(row) {
        direct = Val(sema_call_export_function_target(check.environment.*, check.program.*, export, row, type_args, span, check.diagnostics) ?? return failed)
    } else if sema_call_export_foreign_target(graph, export) == .Val(foreign) {
        if type_args.len() > 0 {
            check.diagnostics.push(sema_call_not_generic_diagnostic(member, span))
            loop argument in args -> _ := sema_check_expression(argument.expr, None, check)
            return failed
        }
        direct = Val(foreign)
    }
    target: direct ?? {
        check.diagnostics.push(sema_call_import_member_unknown(graph.modules[module_index].module_name, shown, span))
        loop argument in args -> _ := sema_check_expression(argument.expr, None, check)
        return failed
    }
    check.scopes.ownership_call_depth += 1
    value := sema_call_core_check_source_owned(target, "{alias}.{shown}", type_args, args, span, expected, check)
    check.scopes.ownership_call_depth -= 1
    sema_call_core_unbuilt_settle(unbuilt, before, check.diagnostics)
    return SemaMethodSpecialCheck{handled: true, value: value}
}

// E0605: `shown`, a member as written, is a `priv` declaration of a module
// the caller is outside of.
sema_call_private_member: fn(shown: String, span: Span) -> Diagnostic {
    sema_error("E0605", span, "`{shown}` is private to its module", "a `priv module` is usable only by its enclosing module (`priv(package)`: by its package), and a `priv` field only by its type's module", "use `{shown}` from inside its module, or remove `priv` from its module or field")
}

// Whether the file module `alias` imports declares the inline module
// `name` (`internal: module {…}`), whose members are lifted beside it.
sema_call_source_import_inline_module: fn(check: SemaBodyCheck, alias: String, name: String) -> Bool Never! {
    imported: sema_call_source_import_target(check.environment.*, check.program.*, alias) ?? return false
    graph: check.program.registration_graph
    module_index: sema_registration_module_index_text(graph, imported.module_identity) ?? return false
    loop surface in graph.modules[module_index].inline_bindings.modules {
        if surface.name == name -> return true
    }
    loop item in graph.modules[module_index].program.items {
        if item == .CodeModule(definition) && definition.name == name && definition.body != None {
            return true
        }
    }
    false
}

// Whether `alias.name` names a function that the module `alias` publishes
// (`text.wrap` for `wrap: wrap.wrap` in `text`).
sema_call_module_member_is_function: fn(check: SemaBodyCheck, alias: String, name: String) -> Bool Never! {
    graph: check.program.registration_graph
    resolved: sema_registration_lookup_qualified(graph, check.environment.module_identity, alias, name) ?? return false
    sema_resolved_kind(graph, resolved) == SymbolKind.Function
}

// Whether `alias.name` names a module: an inline module the file module
// `alias` declares (`inner: module {…}`), or a module that `alias` publishes.
sema_call_module_member_is_module: fn(check: SemaBodyCheck, alias: String, name: String) -> Bool Never! {
    if sema_call_source_import_inline_module(check, alias, name) -> return true
    graph: check.program.registration_graph
    resolved: sema_registration_lookup_qualified(graph, check.environment.module_identity, alias, name) ?? return false
    kind: sema_resolved_kind(graph, resolved)
    kind == SymbolKind.Module || kind == SymbolKind.Import
}

// The direct-call target for an exported foreign (`#Import c.lib: module`)
// function; None when the export names no foreign row.
sema_call_export_foreign_target: fn(graph: SemaRegistrationGraph, export: SemaRegistrationExport) -> SemaCallDirectTarget? {
    owner_index: sema_registration_module_index(graph, export.source_module_identity) ?? return None
    loop index in 0..<graph.modules[owner_index].foreign_functions.len() {
        if graph.modules[owner_index].foreign_functions[index].symbol.id != export.symbol.id -> next
        symbol: graph.modules[owner_index].foreign_functions[index].symbol
        signature: symbol.ty ?? return None
        return Val(SemaCallDirectTarget{symbol: symbol, signature: signature, type_args: [Type]{}, generic_params: [SemaInferenceTypeParam]{}, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}})
    }
    None
}

// The report for a member the imported module does not export: E0102, or
// E3217 for a C library module (`__c_<lib>`), whose members come only from
// its binding cache and its `#Import c.<lib>: module` overlay.
sema_call_import_member_unknown: fn(module_name: String, member: String, span: Span) -> Diagnostic {
    if module_name.starts_with("__c_") {
        lib: module_name.slice(4, module_name.len())
        return sema_error("E3217", span, "C library `{lib}` has no binding named `{member}`.", "Neither the binding cache `.jet/bindings/c/{lib}.jet` nor an `#Import c.{lib}: module` overlay declares `{member}`; without a cache the library binds nothing.", "Import the header by path (`use name: \"<dir>/{lib}.h\"`) so the compiler binds it, refresh the cache with `jet inspect bind <header.h> --pkg {lib}`, or declare `{member}` in `#Import c.{lib}: module`.")
    }
    sema_error("E0102", span, "nothing named `{member}` exists in this import", "only functions and types outside a `priv module` of the other file are reachable here", "check the spelling, or move the item out of its `priv module`")
}

sema_call_core_module_identity: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, module_name: String) -> ModuleID? {
    graph: program.registration_graph
    loop module_row_index in 0..<graph.modules.len() {
        if graph.modules[module_row_index].module_name != module_name || !module_is_core(graph.modules[module_row_index].module_identity) {
            next
        }
        loop owner in CORE_SOURCE_OWNED_ROWS {
            if owner.module_name == module_name && owner.alias == graph.modules[module_row_index].core_source_alias {
                return Val(graph.modules[module_row_index].module_identity)
            }
        }
    }
    return None
}

// Whether the symbol of module `symbol_module` belongs to the loaded Core
// source module `module_name` (sema_call_core_module_identity).
sema_call_core_module_is: fn(check: SemaBodyCheck, module_name: String, symbol_module: ModuleID) -> Bool Never! {
    identity: sema_call_core_module_identity(check.environment.*, check.program.*, module_name) ?? return false
    identity == symbol_module
}

// E1004: the one report for a Core module member that does not resolve at this
// position.
sema_call_core_unknown_item: fn(module_name: String, member: String, span: Span) -> Diagnostic {
    if module_name == "core.time" && member == "clock" {
        return sema_error("E1004", span, "`time.clock` is not a Core member", "deterministic fresh values use a type-owned `new` constructor", "use `Clock.new(seed)`")
    }
    if module_name == "core.time.expiring" && member == "new" {
        return sema_error("E1004", span, "`expiring.new` is not a Core member", "fresh values use a type-owned `new` constructor", "use `ExpiringValue.new(value, ttl, clock)`")
    }
    if module_name == "core.event" && member == "policy_async" {
        return sema_error("E1004", span, "`event.policy_async` is not a Core member", "a synchronous `Event<T>` cannot provide real queued dispatch; `AsyncEvent<T, E>` is the sole asynchronous event model", "use `event.async_result<T, E>(AsyncPolicy.{{ capacity: n, overflow: .Block }}, FailurePolicy.Collect)`")
    }
    if module_name == "core.crypto" && member == "constant_time_eq" {
        return sema_error("E1004", span, "`crypto.constant_time_eq` is not a Core member", "`eq` is not one of Jet's blessed API abbreviations", "use `crypto.constant_time_equal_bytes(a, b)`")
    }
    if module_name == "core.process" && member == "argv" {
        return sema_error("E1004", span, "`process.argv` is not a Core member", "`process.args()` is the one list of the program's words, without the program name", "use `process.args()` for the words and `sys.executable()` for the program path")
    }
    if module_name == "core.crypto" && member.ends_with("_bytes") {
        algorithm: member.removesuffix("_bytes")
        digest: if algorithm == {
            "sha256" | "blake3" -> "Digest256"
            "sha512" -> "Digest512"
            else -> ""
        }
        if digest != "" {
            return sema_error("E1004", span, "`crypto.{member}` is not a Core member", "`crypto.{algorithm}` returns `{digest}`, so the representation is explicit", "use `crypto.{algorithm}(bytes).hex()` for text or `.bytes()` for raw bytes")
        }
    }
    items: if core_module_export(module_name) == {
        .Val(row) -> row.members
        .None -> [String]{}
    }
    // #2002: the module exposes the name, but this position has no arm for it.
    if items.contains(member) {
        return sema_error("E1004", span, "`{module_name}` exposes `{member}`, but not in this position", "standard library modules expose a fixed set of public items, each reachable only where its surface declares", "import it directly with `use {module_name}.[{member}]`")
    }
    // #6174: `math.min` moved to the prelude; a prelude name needs no module.
    if module_name != "core.prelude" && core_module_export("core.prelude") == .Val(prelude) {
        if prelude.members.contains(member) {
            return sema_error("E1004", span, "`{module_name}` has no item `{member}`", "`{member}` is a prelude name, so every file has it without an import", "call it with no module: `{member}(…)`")
        }
    }
    // #1965: an exact submodule hit outranks this module's own menu.
    if sema_call_core_submodule_path_hint(module_name, member, span) == .Val(hint) -> return hint
    // A reserved `__` seam is Core-internal and user code
    // cannot spell it, so it is never offered as a suggestion.
    menu := [String]{}
    loop item in items {
        if !item.starts_with("__") -> menu.push(item.copy())
    }
    suggestion: sema_suggest_field(member, menu)
    fix: if suggestion == {
        .Val(candidate) -> "did you mean `{candidate}`?"
        .None -> if menu.len() == 0 -> "import a specific core module, like `import core.files as fs;`" else -> "use one of: {menu.join(", ")}"
    }
    diagnostic: sema_error("E1004", span, "`{module_name}` has no item `{member}`", "standard library modules expose a fixed set of public items", fix)
    if suggestion == .Val(candidate) {
        return diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: candidate})
    }
    diagnostic
}

// `{module}.{member}` is itself a submodule, or `member` is an item of one. No
// typed edit: the import path shape changes.
sema_call_core_submodule_path_hint: fn(module_name: String, member: String, span: Span) -> Diagnostic? {
    why: "Core is one nested tree, so a name under this module can belong to a submodule instead of the module itself"
    nested: "{module_name}.{member}"
    if core_module_export(nested) == .Val(row) {
        fix: if row.members.len() > 0 -> "`{nested}` is a submodule, so name an item on it: `{nested}.{row.members[0]}`" else -> "`{nested}` is a submodule; import it with `import {nested};`"
        return Val(sema_error("E1004", span, "`{module_name}` has no item `{member}`", why, fix))
    }
    prefix: "{module_name}."
    loop candidate in CORE_MODULE_EXPORTS {
        if !candidate.module_name.starts_with(prefix) || !candidate.members.contains(member) -> next
        return Val(sema_error("E1004", span, "`{module_name}` has no item `{member}`", why, "`{member}` lives in the submodule `{candidate.module_name}`, so write `{candidate.module_name}.{member}`"))
    }
    None
}

sema_call_core_projection_error: fn(module_name: String, member: String, error: CoreCallProjectionError, span: Span, diagnostics: ^[Diagnostic]) {
    if error == {
        .Unknown -> { diagnostics.push(sema_call_core_unknown_item(module_name, member, span)) }
        .Uncovered(_) -> {
            diagnostics.push(sema_error("E0904", span, "`{module_name}.{member}` has no source semantic call contract", "the registered Core row is not covered by this semantic projection", "use a source-owned callable or a Core row with SEMA coverage"))
        }
        .Arity(expected, actual) -> {
            row: core_call(module_name, member)
            maximum: row.map(fn(record) { record.signature.max_arity }) ?? expected
            range: if maximum > expected -> "between {expected} and {maximum}" else -> "{expected}"
            diagnostics.push(sema_error("E0104", span, "`{module_name}.{member}` expects {range} argument(s), got {actual}", "the registered Core call arity is fixed", "provide the registered number of arguments"))
        }
    }
}

sema_call_core_record: fn(module_name: String, member: String, actual_arity: Int, span: Span, diagnostics: ^[Diagnostic]) -> CoreCallRecord? {
    // Variadic `core.term.eprint` joins its arguments into one write through
    // the arity-1 row; its special checker owns the argument count.
    projection_arity: if module_name == "core.term" && member == "eprint" -> 1 else -> actual_arity
    projection: core_call_projection(module_name, member, CORE_CALL_COVERAGE_SEMA, projection_arity)
    if projection == {
        .Row(record) -> return Val(record)
        .Error(error) -> {
            sema_call_core_projection_error(module_name, member, error, span, diagnostics)
            return None
        }
    }
}

// `tls.client(tcp, server_name: …, config: …, deadline: …)` takes a connected
// stream: the native resource consumer row, where the `(host, port)` form is
// source-owned. The two forms differ by arity.
sema_call_core_configured_client: fn(args: [CallArg]) -> Bool Never! { args.len() >= 3 }

sema_call_core_native_resource_consumer: fn(module_name: String, member: String, configured_client: Bool) -> Bool Never! {
    (module_name == "core.net.tls" && member == "client" && configured_client) || (module_name == "core.service" && member == "worker")
    // Worker alone keeps checked fn() inference; its source slot is opaque.
}

sema_call_core_has_explicit_source_target: fn(module_name: String, member: String) -> Bool Never! {
    row: core_call(module_name, member) ?? return false
    row.symbol == CoreCallSymbol.SourceOwned && (row.source_target != None || row.source_role != None)
}

// The no-OS call boundary is checked before choosing either a source-owned
// implementation or a native Core row. These modules need an OS on every
// machine; a module a machine's declared services can back (`core.time`'s
// clocks, `core.term`'s byte sink) is checked against the selected machine
// instead (TargetDenials.jet sema_target_capability_check, E3311).
sema_call_core_no_os_hint: fn(module_name: String) -> String? Never! {
    if module_name == {
        "core.files" -> Val("Embed the data at compile time with `@embed(\"file\")`, or select a hosted target.")
        "core.net" | "core.net.tls" | "core.http" -> Val("No-OS targets have no network stack. Select a hosted target, or use a declared network provider.")
        "core.tasks" -> Val("OS threads are not available without an OS. Use cooperative or interrupt-driven concurrency.")
        "core.process" -> Val("System calls are not available on a no-OS target. Select a hosted target or declare the required provider.")
        "core.log" -> Val("The log module writes to stderr (an OS resource). Use a declared IO provider or select a hosted target.")
        "core.watcher" | "core.crypto.vault" -> Val("Select a hosted target, or replace this call with a core-level alternative.")
        else -> None
    }
}

// E3301: on a no-OS machine a call into a module that needs an OS is refused
// at the call, whether it names the module by path or through a `use` alias.
// True when the call was refused.
sema_call_core_no_os_refused: fn(check: ^SemaBodyCheck, module_name: String, member: String, span: Span) -> Bool Never! {
    if !sema_scope_environment_no_os(check) -> return false
    hint: sema_call_core_no_os_hint(module_name) ?? return false
    short_name: foundation_byte_text(module_name.bytes(), module_name.rfind(".") + 1, module_name.count_bytes())
    check.diagnostics.push(sema_error("E3301", span, "`{short_name}.{member}` is not available on a no-OS target.", "No-OS targets have no OS; only `core`-level APIs are available.", hint))
    true
}

// Source exports are ordinary functions ahead of static Core records. A Core record
// route checks no type-argument count: the bespoke Core arms take their own `<T>`
// and only the fixed-signature fallback checks the count against the typed row.
sema_call_core_resolve_route: fn(check: ^SemaBodyCheck, module_name: String, member: String, type_args: [Type], actual_arity: Int, configured_client: Bool, span: Span) -> SemaCoreCallRoute? {
    diagnostic_count := check.diagnostics.len()
    if sema_call_core_no_os_refused(check, module_name, member, span) -> return None
    if sema_call_core_typed_decode_call(module_name, member, type_args) == .Val(role) {
        return sema_call_core_typed_decode_route(check, module_name, role, type_args, span)
    }
    source_identity: if sema_call_core_has_explicit_source_target(module_name, member) || sema_call_core_native_resource_consumer(module_name, member, configured_client) -> None else -> sema_call_core_module_identity(check.environment.*, check.program.*, module_name)
    source: if source_identity == {
        .Val(identity) -> sema_call_core_source_target(check.environment.*, check.program.*, identity, member, type_args, span, false, check.diagnostics)
        .None -> None
    }
    if source == {
        .Val(target) -> {
            sema_call_core_tolerant_form_lint(check, module_name, member, member, span)
            return Val(SemaCoreCallRoute.Source{target: target})
        }
        .None -> {}
    }
    if check.diagnostics.len() != diagnostic_count -> return None
    record: sema_call_core_record(module_name, member, actual_arity, span, check.diagnostics) ?? return None
    Val(SemaCoreCallRoute.Core{record: record})
}

// L0208: a tolerant `core.http` query or form decode
// outside Core is listed for review. Code that picks a file or an account
// from the value moves to the strict sibling; the NeedsReview edit writes it,
// so `jet fix` lists the call and only `jet fix --all` applies the edit (and
// rolls it back when the caller doesn't handle the FormDecodeError). `written`
// is the name at `span`; an import alias gets the advisory without the edit.
sema_call_core_tolerant_form_lint: fn(check: ^SemaBodyCheck, module_name: String, member: String, written: String, span: Span) {
    if module_name != "core.http" || (member != "query_decode" && member != "form_decode") {
        return
    }
    if module_is_core(check.environment.module_identity) {
        return
    }
    row: sema_diagnostic_row("L0208")
    lint: sema_lint("L0208", span, row.what.replace("{{member}}", member), row.why, row.fix.replace("{{member}}", member))
    if written != member {
        check.diagnostics.push(lint)
        return
    }
    check.diagnostics.push(diagnostic_with_edit(lint, TextEdit{span: Span{start: span.end, end: span.end}, new_text: "_strict"}))
}

sema_call_core_resolve_import_route: fn(check: ^SemaBodyCheck, alias: String, requested_member: String, type_args: [Type], actual_arity: Int, configured_client: Bool, span: Span, alias_span: Span) -> SemaCoreCallRoute? {
    imported: sema_call_core_import_target(check.environment.*, check.program.*, alias) ?? return None
    if !sema_call_core_import_is_unshadowed(check.environment.*, check.program.*, check.scopes, imported) {
        return None
    }
    member: sema_call_core_import_member(imported, requested_member) ?? return None
    if !sema_call_core_record_import_reference(check, imported, alias_span) -> return None
    if imported.module_name == "core.mem" {
        if shared_lifetime_core_member(member) == .Val(lifetime) {
            return Val(SemaCoreCallRoute.SharedSite{lifetime: lifetime})
        }
    }
    if sema_call_core_no_os_refused(check, imported.module_name, member, span) -> return None
    if sema_call_core_typed_decode_call(imported.module_name, member, type_args) == .Val(role) {
        return sema_call_core_typed_decode_route(check, imported.module_name, role, type_args, span)
    }
    diagnostic_count := check.diagnostics.len()
    // `core.term` owns only the one-argument print, eprint
    // and progress wrappers; other arities keep the fixed Core route.
    variadic_term: imported.module_name == "core.term" && (member == "print" || member == "eprint" || member == "progress") && actual_arity != 1
    source_identity: if variadic_term || sema_call_core_has_explicit_source_target(imported.module_name, member) || sema_call_core_native_resource_consumer(imported.module_name, member, configured_client) -> None else -> sema_call_core_import_source_identity(check.environment.*, check.program.*, imported)
    source: if source_identity == {
        .Val(identity) -> sema_call_core_source_target(check.environment.*, check.program.*, identity, member, type_args, span, false, check.diagnostics)
        .None -> None
    }
    if source == {
        .Val(target) -> {
            sema_call_core_tolerant_form_lint(check, imported.module_name, member, requested_member, span)
            return Val(SemaCoreCallRoute.Source{target: target})
        }
        .None -> {}
    }
    if check.diagnostics.len() != diagnostic_count -> return None
    record: sema_call_core_record(imported.module_name, member, actual_arity, span, check.diagnostics) ?? return None
    Val(SemaCoreCallRoute.Core{record: record})
}

// A call through a module alias's known Core submodule (`core.math.fabs(n)`
// under `use core as core`) routes against that submodule by name, exactly as
// an alias of the submodule itself would, including the `core.mem` Shared
// sites.
sema_call_core_resolve_import_path_route: fn(check: ^SemaBodyCheck, alias: String, module_name: String, member: String, type_args: [Type], actual_arity: Int, configured_client: Bool, span: Span, alias_span: Span) -> SemaCoreCallRoute? {
    imported: sema_call_core_import_target(check.environment.*, check.program.*, alias) ?? return None
    if imported.item != None -> return None
    if !sema_call_core_record_import_reference(check, imported, alias_span) -> return None
    if module_name == "core.mem" {
        if shared_lifetime_core_member(member) == .Val(lifetime) {
            return Val(SemaCoreCallRoute.SharedSite{lifetime: lifetime})
        }
    }
    sema_call_core_resolve_route(check, module_name, member, type_args, actual_arity, configured_client, span)
}

// `("core.term", "print")`: an imported `core.term` print with other than one
// argument is the qualified twin of the ambient variadic `print`, checked and
// lowered exactly like it. True when this alias call is that print; the alias
// reference is then recorded.
sema_call_core_variadic_print: fn(check: ^SemaBodyCheck, alias: String, requested_member: String, actual_arity: Int, alias_span: Span) -> Bool Never! {
    if actual_arity == 1 -> return false
    imported: sema_call_core_import_target(check.environment.*, check.program.*, alias) ?? return false
    if imported.module_name != "core.term" -> return false
    if !sema_call_core_import_is_unshadowed(check.environment.*, check.program.*, check.scopes, imported) {
        return false
    }
    member: sema_call_core_import_member(imported, requested_member) ?? return false
    if member != "print" -> return false
    sema_call_core_record_import_reference(check, imported, alias_span)
}

// Registry access metadata is incomplete for optional slots; return None rather
// than assign an ownership convention the registry does not specify.
sema_call_core_access: fn(record: CoreCallRecord, index: Int) -> AccessConvention? {
    if index < 0 || index >= record.signature.borrow_mask.len() -> return None
    if record.signature.borrow_mask[index] -> Val(AccessConvention.Read) else -> Val(AccessConvention.Move)
}

sema_call_core_check_type_args: fn(module_name: String, member: String, expected_count: Int, infer_when_omitted: Bool, type_args: [Type], span: Span, diagnostics: ^[Diagnostic]) -> Bool {
    if infer_when_omitted && type_args.len() == 0 && expected_count > 0 -> return true
    if type_args.len() == expected_count -> return true
    diagnostics.push(sema_call_generic_count_diagnostic("{module_name}.{member}", expected_count, type_args.len(), span))
    false
}

// `("core.math", "abs")`: `abs` takes Int, Float, F32, I64 and Complex,
// returning the argument type (Float for Complex). The Int form stays the
// routed source `abs`; any other argument is the MathBuiltin `abs`. A Float,
// F32 or I64 one lowers to the Core function filling role `AbsFloat`,
// `AbsF32` or `AbsI64`, and a Complex one runs core.math's `__complex_abs`
// (sema_precise_bind). Anything else is not handled here.
sema_call_try_core_math_abs: fn(module_name: String, member: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    unhandled: SemaDirectSpecialCheck{handled: false, value: None}
    if module_name != "core.math" || member != "abs" || args.len() != 1 || type_args.len() != 0 || args[0].label != None {
        return unhandled
    }
    probe_diagnostics := [Diagnostic]{}
    probed: sema_probe_expression(args[0].expr, None, check, probe_diagnostics) ?? return unhandled
    type_name := ""
    result_ty := Type.Float
    if probed.ty == Type.Float -> type_name = "Float"
    if probed.ty == Type.Float32 {
        type_name = "F32"
        result_ty = Type.Float32
    }
    if probed.ty == (Type.IntN{signed: true, bits: 64}) {
        type_name = "I64"
        result_ty = Type.IntN{signed: true, bits: 64}
    }
    if probed.ty == (Type.Named{name: "Complex"}) -> type_name = "Complex"
    if type_name == "" -> return unhandled
    value: sema_check_expression(args[0].expr, None, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    magnitude: sema_tree_node(result_ty, TExprKind.MathBuiltin{type_name: type_name, function: "abs", args: [TExpr]{value}}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(magnitude, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// `("core.math", "is_nan" | "is_inf" | "is_finite")`:
// floating-point classification takes Float or F32. A float argument, and a
// written decimal numeral (`2.0`, `-2.0`), which adopts Float from the
// parameter as any source call's argument does, stay the ordinary source
// call; any other checked argument type is refused here.
sema_call_try_core_math_float_class: fn(module_name: String, member: String, type_args: [Type], args: [CallArg], check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    unhandled: SemaDirectSpecialCheck{handled: false, value: None}
    if module_name != "core.math" || (member != "is_nan" && member != "is_inf" && member != "is_finite") || args.len() != 1 || type_args.len() != 0 {
        return unhandled
    }
    if sema_expr_decimal_literal_operand(args[0].expr, false) -> return unhandled
    probe_diagnostics := [Diagnostic]{}
    probed: sema_probe_expression(args[0].expr, None, check, probe_diagnostics) ?? return unhandled
    if probed.ty == Type.Float || probed.ty == Type.Float32 -> return unhandled
    value: sema_check_expression(args[0].expr, None, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    check.diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{member}` needs Float or F32, not {sema_type_show(value.ty)}", "floating-point classification only applies to floats", "pass a Float or F32 value"))
    SemaDirectSpecialCheck{handled: true, value: None}
}

// `("core.math", "sqrt")`: the square root takes Float, F32, an exact
// Fraction or Decimal (crossed to Float first,
// sema_call_core_math_exact_crossing) or a Measurement<Float>. A Float or F32
// argument, and a written decimal numeral (`2.0`, `-2.0`), which adopts Float
// from the parameter itself, stay the ordinary source call (an F32 one at F32
// width, sema_call_try_core_math_f32); a measurement runs the Core function
// filling role `MeasurementSqrt`; any other checked argument type, an Int
// numeral too, is refused here.
sema_call_try_core_math_sqrt: fn(module_name: String, member: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    unhandled: SemaDirectSpecialCheck{handled: false, value: None}
    if module_name != "core.math" || member != "sqrt" || args.len() != 1 || type_args.len() != 0 || args[0].label != None {
        return unhandled
    }
    if sema_expr_decimal_literal_operand(args[0].expr, false) -> return unhandled
    probe_diagnostics := [Diagnostic]{}
    probed: sema_probe_expression(args[0].expr, None, check, probe_diagnostics) ?? return unhandled
    if probed.ty == Type.Float || probed.ty == Type.Float32 -> return unhandled
    failed: SemaDirectSpecialCheck{handled: true, value: None}
    value: sema_check_expression(args[0].expr, None, check) ?? return failed
    if sema_expression_is_float_measurement(value.ty, check) {
        measured: value.ty.copy()
        root: sema_expression_measurement_source_call("MeasurementSqrt", [TExpr]{value}, measured, span, check) ?? return failed
        return SemaDirectSpecialCheck{handled: true, value: sema_expr_expected_owned(root, expected, check.environment.*, check.program.*, check.diagnostics)}
    }
    check.diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`sqrt` needs Float, F32, or Measurement<Float>, not {sema_type_show(value.ty)}", "math functions preserve their numeric knowledge grade", "pass a Float or F32 value, or use `sqrt` with a measurement"))
    failed
}

// `core.math` is width-generic. A math function whose every floating
// argument is F32 computes at F32 width: its Float source runs on the exactly
// widened arguments and the Float result rounds once back to F32. A correctly
// rounded function whose Float result can tie two binary32 values, and a
// function whose step is the binary32 one (next_up), runs its
// `__<member>_f32` source instead, whose Float result is already the binary32
// one; its whole-number exponent stays an Int. A member whose answer is the
// binary32 bits themselves (to_bits, is_signaling, the payloads), and
// rem_quo, whose (rem: F32, quo: Int) record rounds only the remainder, runs
// its F32 source on the F32 arguments as they are. Any other
// argument list keeps the ordinary source call.
sema_call_try_core_math_f32: fn(module_name: String, member: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    unhandled: SemaDirectSpecialCheck{handled: false, value: None}
    if module_name != "core.math" || type_args.len() != 0 || args.len() == 0 -> return unhandled
    kept: sema_call_core_math_f32_kept(member)
    if kept == None && !sema_call_core_math_f32_member(member) -> return unhandled
    loop (index, argument) in args {
        if argument.label != None || argument.spread -> return unhandled
        probe_diagnostics := [Diagnostic]{}
        probed: sema_probe_expression(argument.expr, None, check, probe_diagnostics) ?? return unhandled
        width: if sema_call_core_math_f32_whole(member, index) -> Type.Int else -> Type.Float32
        if probed.ty != width -> return unhandled
    }
    failed: SemaDirectSpecialCheck{handled: true, value: None}
    values := [TExpr]{}
    loop (index, argument) in args {
        value: sema_check_expression(argument.expr, None, check) ?? return failed
        keep: kept != None || sema_call_core_math_f32_whole(member, index)
        values.push(if keep -> value else -> sema_expr_numeric_conversion(value, Type.Float, span, 0) ?? return failed)
    }
    if kept == {
        .Val(result) -> {
            answer: sema_call_core_role_source(sema_call_core_f32_role(module_name, member) ?? return failed, values, result, span, check) ?? return failed
            return SemaDirectSpecialCheck{handled: true, value: sema_expr_expected_owned(answer, expected, check.environment.*, check.program.*, check.diagnostics)}
        }
        .None -> {}
    }
    wide: sema_call_core_math_f32_wide(module_name, member, values, span, check) ?? return failed
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected_owned(sema_call_core_math_round_f32(wide, span), expected, check.environment.*, check.program.*, check.diagnostics)}
}

// The Float-typed call an F32-width `member` rounds to F32: the F32 source of
// a member with its own (sema_call_core_math_f32_own), else the Float
// `member` itself, both on the widened arguments.
sema_call_core_math_f32_wide: fn(module_name: String, member: String, values: [TExpr], span: Span, check: ^SemaBodyCheck) -> TExpr? {
    if sema_call_core_math_f32_own(member) {
        role: sema_call_core_f32_role(module_name, member) ?? return None
        return sema_call_core_role_source(role, values, Type.Float, span, check)
    }
    sema_call_core_source("core.math", member, values, Type.Float, false, span, check)
}

// The result type of an F32-width member whose F32 source takes the F32
// arguments themselves: widening one would quiet a signaling NaN,
// move a payload, or make a subnormal normal, and rem_quo's source rounds
// only the remainder of its record, whose quotient stays an Int. frexp and
// modf split the binary32 word into F32 parts, the registry's
// (exp: Int, frac: T) and (fract: T, whole: T).
sema_call_core_math_f32_kept: fn(member: String) -> Type? Never! {
    if member == {
        "to_bits" | "cmp" -> Val(Type.Int)
        "is_signaling" | "is_normal" | "is_subnormal" | "total_order" | "total_order_mag" | "is_finite" -> Val(Type.Bool)
        "canonicalize" | "fabs" | "abs_float" | "copysign" -> Val(Type.Float32)
        "get_payload" | "set_payload" | "set_payload_signaling" -> Val(Type.Option{inner: Type.Float32})
        "rem_quo" -> Val(Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "rem", ty: Type.Float32}, TypeTupleField{name: "quo", ty: Type.Int}}})
        "frexp" -> Val(Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "exp", ty: Type.Int}, TypeTupleField{name: "frac", ty: Type.Float32}}})
        "modf" -> Val(Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "fract", ty: Type.Float32}, TypeTupleField{name: "whole", ty: Type.Float32}}})
        else -> None
    }
}

// A core.math Float result rounded once to F32 (IR Convert): an overflow is
// the infinity and a NaN stays NaN, as the binary32 function returns. The
// checked `F32{x}` narrowing (TNumericOp.FloatNarrow) would stop with E3010
// on both.
sema_call_core_math_round_f32: fn(wide: TExpr, span: Span) -> TExpr Never! {
    TExpr{ty: Type.Float32, kind: TExprKind.NumericMethod{receiver: wide, operation: TNumericOp.CastAs{dst_rust: "f32"}}, span: span}
}

// The core.math functions of Float arguments with a Float result that an
// all-F32 call computes at F32 width. The binary64 square root rounded to
// binary32 is the correctly rounded binary32 one. The exact ones (fmod
// through scaleb) are exact on the widened arguments too. The other spellings
// (expm1, truncate, log1p, nextafter, abs_float) are their members' F32
// forms. The roundings are Roundable, whose F32 impl rounds at F32 width
// itself.
sema_call_core_math_f32_member: fn(member: String) -> Bool Never! {
    if member == {
        "tan" | "asin" | "cosh" | "tanh" | "exp" | "log2" | "atanh" | "cbrt" | "exp10" | "exp_m1" | "expm1" | "degrees" | "radians" | "log" | "truncate" | "fract" | "lerp" | "rsqrt" | "exp2_m1" | "sin_pi" | "cos_pi" | "tan_pi" | "asin_pi" | "acos_pi" | "sqrt" -> true
        "fmod" | "remainder" | "fdim" | "max_float" | "min_float" | "maximum" | "minimum" | "maximum_mag" | "minimum_mag" | "maximum_num" | "minimum_num" | "maximum_mag_num" | "minimum_mag_num" | "logb" | "ldexp" | "scaleb" -> true
        else -> sema_call_core_math_f32_own(member)
    }
}

// The F32-width members with their own F32 source (sema_call_core_f32_role)
// that runs on the widened arguments. The Float fma (and muladd) of the
// widened arguments would round twice when it lands on a binary32 midpoint,
// and the Float next_up would step by a binary64 unit.
sema_call_core_math_f32_own: fn(member: String) -> Bool Never! {
    SEMA_CORE_MATH_F32_SOURCES.contains(member) && sema_call_core_math_f32_kept(member) == None
}

// The core.math members with an F32-width source of their own: each member
// that source runs on the widened arguments (sema_call_core_math_f32_own) and
// each one that keeps its F32 arguments (sema_call_core_math_f32_kept).
SEMA_CORE_MATH_F32_SOURCES: [String]{
    "cmp", "is_finite",
    "pow_n", "pow_r", "root_n", "compound_n", "atan2_pi", "atan_pi", "exp10_m1", "log2_1p", "log10_1p", "exp2", "ln", "log10", "ln_1p", "log1p", "sin", "cos", "acos", "atan", "atan2", "sinh", "asinh", "acosh", "hypot", "erf", "erfc", "gamma", "lgamma", "fma", "muladd",
    "next_up", "next_down", "next_after", "nextafter",
    "to_bits", "is_signaling", "is_normal", "is_subnormal", "total_order", "total_order_mag", "canonicalize", "fabs", "abs_float", "copysign", "get_payload", "set_payload", "set_payload_signaling", "rem_quo", "frexp", "modf",
}

// The role of the F32-width source of core.math `member`: the member's words,
// then F32 (`sin` is SinF32, `log2_1p` is Log21pF32), or None when it has none
// (SEMA_CORE_MATH_F32_SOURCES). No program spells the source, so CoreReach
// loads it with the member it computes (sema_call_core_f32_role_member).
sema_call_core_f32_role: fn(module_name: String, member: String) -> String? Never! {
    if module_name != "core.math" || !SEMA_CORE_MATH_F32_SOURCES.contains(member) -> return None
    Val("{sema_casing_pascal_words(member)}F32")
}

// The core.math member whose F32-width source fills `role`, or None.
sema_call_core_f32_role_member: fn(role: String) -> String? Never! {
    if !role.ends_with("F32") -> return None
    loop member in SEMA_CORE_MATH_F32_SOURCES {
        if sema_call_core_f32_role("core.math", member) == Val((role)) -> return Val(member.copy())
    }
    None
}

// Whether argument `index` of an F32-width `member` call is its whole-number
// exponent, an Int at every width.
sema_call_core_math_f32_whole: fn(member: String, index: Int) -> Bool Never! {
    index == 1 && (member == "pow_n" || member == "root_n" || member == "compound_n" || member == "ldexp" || member == "scaleb")
}

// `exact_rational_math_approx`: a core.math function whose result leaves the
// rationals takes an exact Fraction or Decimal argument across its one boundary
// into Float, as `value.to_float()`. The other math calls keep their exact
// contracts. None when no argument crosses.
sema_call_core_math_exact_crossing: fn(module_name: String, member: String, args: [CallArg], check: ^SemaBodyCheck) -> [CallArg]? {
    if module_name != "core.math" -> return None
    if member == {
        "sqrt" | "sin" | "cos" | "tan" | "asin" | "acos" | "atan" | "sinh" | "cosh" | "tanh" | "exp" | "ln" | "log2" | "log10" | "acosh" | "asinh" | "atanh" | "cbrt" | "exp2" | "exp_m1" | "ln_1p" | "degrees" | "radians" | "atan2" | "hypot" | "lerp" | "copysign" | "log" | "fma" | "muladd" -> {}
        else -> return None
    }
    exact := [Bool]{}
    any := false
    loop argument in args {
        // A written numeral adopts Float from the parameter itself.
        literal: if argument.expr == {
            .Float(_, _, _, _, _) | .Int(_, _, _, _, _) -> true
            .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
        }
        crosses := false
        if !literal {
            probe_diagnostics := [Diagnostic]{}
            probed: sema_probe_expression(argument.expr, None, check, probe_diagnostics)
            if probed == .Val(value) {
                crosses = value.ty == (Type.Named{name: "Fraction"}) || value.ty == (Type.Named{name: "Decimal"})
            }
        }
        exact.push(crosses)
        if crosses -> any = true
    }
    if !any -> return None
    crossed := [CallArg]{}
    loop (index, argument) in args {
        updated := argument.copy()
        if exact[index] {
            updated.expr = Expr.MethodCall{receiver: argument.expr.copy(), method: "to_float", method_span: argument.span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, id: AST_NODE_GENERATED}
        }
        crossed.push(updated)
    }
    Val(crossed)
}

// A `net.unix_connect` and a `tls.client` run the Core function that fills the
// role of their arity and arguments; a stream moved into a two-argument
// `tls.client` is the stream form, else it is the `(host, port)` one.
sema_call_core_arity_source_record: fn(record: CoreCallRecord, args: [CallArg]) -> CoreCallRecord Never! {
    normalized := record
    if record.symbol == CoreCallSymbol.SourceOwned && record.module_name == "core.net" && record.member == "unix_connect" {
        normalized.source_role = Val(if args.len() == 1 -> "UnixConnect" else -> "UnixConnectDeadline")
    }
    if record.symbol == CoreCallSymbol.SourceOwned && record.module_name == "core.net.tls" && record.member == "client" {
        if args.len() == 4 -> normalized.source_role = Val("TLSClientConfigDeadline") else if args.len() == 3 {
            normalized.source_role = Val("TLSClientDeadline")
        } else if args.len() == 2 && args[0].convention == AccessConvention.Move {
            normalized.source_role = Val("TLSClientStream")
        } else { normalized.source_target = Val("client") }
    }
    normalized
}

// The role whose Core function a text codec's typed `decode<T>(text)` runs,
// decoding the parsed tree in place, or None when the call is no text codec's
// typed decode; an untyped `decode(text)` is the module's own `decode`, the
// tree.
sema_call_core_typed_decode_call: fn(module_name: String, member: String, type_args: [Type]) -> String? Never! {
    if member != "decode" || type_args.len() == 0 -> return None
    if module_name == {
        "core.encoding.json" -> Val("JSONTypedDecode")
        "core.encoding.toml" -> Val("TOMLTypedDecode")
        "core.encoding.yaml" -> Val("YAMLTypedDecode")
        else -> None
    }
}

// A typed `json.decode<T>(text)` (and toml's, yaml's) is a call of the Core
// function filling `role` with `T`; a `T` without the Decode contract is E0905
// at the call, the one report.
sema_call_core_typed_decode_route: fn(check: ^SemaBodyCheck, module_name: String, role: String, type_args: [Type], span: Span) -> SemaCoreCallRoute? {
    target_type: sema_data_core_target_type(type_args, "decode", span, check) ?? return None
    if !sema_serde_type_is_admissible(check.environment.*, check.program.*, target_type, SemaSerdeDirection.Decode) {
        fix: sema_serde_shape_fix(target_type, "Decode") ?? "derive `Decode` on this type, or write its Decode implementation"
        check.diagnostics.push(sema_error("E0905", span, "`{type_name(target_type)}` does not implement `Decode`", "`{module_name}.decode<T>` can only decode into a type with the registered Decode contract", fix))
        return None
    }
    target: sema_call_core_role_target(role, type_args, span, check.environment.*, check.program.*, check.diagnostics) ?? return None
    Val(SemaCoreCallRoute.Source{target: target})
}

sema_call_core_source_arguments: fn(args: [TExpr], params: [SemaCallParam], check: SemaBodyCheck) -> [TCallArg] Never! {
    result := [TCallArg]{}
    loop index in 0..<args.len() {
        value: args[index]
        param: params[index]
        result.push(
            TCallArg{
                value: value.copy(),
                template_items: [SymbolID]{},
                borrow: param.convention == AccessConvention.Read && !sema_call_is_scalar(value.ty),
                mut_borrow: param.convention == AccessConvention.Write,
                fn_coerce: None,
                widen_to_vec: false,
                widen_to_union: sema_call_widen_union(param.ty ?? value.ty, value.ty),
                box_as_trait: sema_call_box_as_trait(param.ty ?? value.ty, value.ty, check),
                label: None,
                spread: false,
            },
        )
    }
    result
}

// A checked Core call. `plugin.load` takes its Authority across the checked
// boundary as the wire text: the conversion materializes once, here, for the
// source call and the Core call alike.
sema_call_core_tree: fn(record: CoreCallRecord, args: [TExpr], span: Span, type_args: [Type], widen_to_vec: [Bool], result_type: Type, fallibility: TFailureCarrier, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if args.len() > 1 && core_call_authority_boundary_at(record, 1) {
        wired: loop index in 0..<args.len() -> sema_call_core_materialize_authority_boundary(record, index, args[index], span)
        return sema_call_core_tree_checked(record, wired, span, type_args, widen_to_vec, result_type, fallibility, expected, check)
    }
    sema_call_core_tree_checked(record, args, span, type_args, widen_to_vec, result_type, fallibility, expected, check)
}

sema_call_core_tree_checked: fn(record: CoreCallRecord, args: [TExpr], span: Span, type_args: [Type], widen_to_vec: [Bool], result_type: Type, fallibility: TFailureCarrier, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    process_run_boundary: record.module_name == "core.process" && record.member == "run" && args.len() == record.signature.arity + 1
    if !core_call_accepts_arity(record, args.len()) && !process_run_boundary {
        maximum := record.signature.max_arity
        range: if maximum > record.signature.arity -> "between {record.signature.arity} and {maximum}" else -> "{record.signature.arity}"
        check.diagnostics.push(sema_error("E0104", span, "`{record.module_name}.{record.member}` expects {range} argument(s), got {args.len()}", "the registered Core call arity is fixed", "provide the registered number of arguments"))
        return None
    }
    if core_call_source_role(record) == .Val(role) {
        graph: check.program.registration_graph
        filler: sema_core_role_function(graph, role) ?? {
            check.diagnostics.push(sema_missing_core_role(role, span))
            return None
        }
        return sema_call_core_run_source(record, filler.module_identity, filler.name, args, span, type_args, result_type, expected, check)
    }
    if core_call_source_member(record) == .Val(member) {
        path: sema_call_core_source_path(record.module_name, member) ?? return None
        identity: sema_call_core_module_identity(check.environment.*, check.program.*, path.module_name) ?? {
            check.diagnostics.push(sema_error("E0902", span, "source-owned Core module `{path.module_name}` is not loaded", "this declaration has no host implementation route", "load the owning Core source package"))
            return None
        }
        return sema_call_core_run_source(record, identity, path.member, args, span, type_args, result_type, expected, check)
    }
    value := sema_tree_node(result_type, TExprKind.CoreCall{record: record, args: args, source_span: span, type_args: type_args, widen_to_vec: widen_to_vec, fallibility: fallibility}, span)
    // The slot type reaches a call only as an inference hint: a Core call that
    // returns `Never` produces no value, and the enclosing `??` or branch
    // accepts its divergence.
    if result_type == (Type.Named{name: "Never"}) -> return Val(value)
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// A source-owned Core call as a call of the Core function `name` of module
// `identity` that runs it, on the normalized arguments.
sema_call_core_run_source: fn(record: CoreCallRecord, identity: ModuleID, name: String, args: [TExpr], span: Span, type_args: [Type], result_type: Type, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    target: sema_call_core_source_target(check.environment.*, check.program.*, identity, name, type_args, span, true, check.diagnostics) ?? {
        check.diagnostics.push(sema_error("E0902", span, "source-owned Core call `{record.module_name}.{record.member}` has no checked source target", "this declaration must execute its owning Jet function", "load the matching Core source export"))
        return None
    }
    params: sema_call_params_from_type(target.signature) ?? return None
    if params.len() != args.len() {
        check.diagnostics.push(sema_error("E0902", span, "source-owned Core target `{name}` has the wrong normalized arity", "the checked source signature must accept every normalized argument", "use the matching Core source export"))
        return None
    }
    source_args: sema_call_core_source_arguments(args, params, check)
    callee: sema_call_callee_decl(check.program.*, target.symbol.id, span, check.diagnostics) ?? return None
    value: sema_tree_node(result_type, TExprKind.Call{callee: callee, type_args: type_args, args: source_args}, span)
    sema_expr_expected_owned(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// A call of the `module_name` source function `member` on checked arguments,
// typed `result` (sqrt's Float root, the F32-width math calls a Float member
// computes, and the Tensor bracket windows). `registered` resolves a
// module-private member too.
sema_call_core_source: fn(module_name: String, member: String, values: [TExpr], result: Type, registered: Bool, span: Span, check: ^SemaBodyCheck) -> TExpr? {
    identity: sema_call_core_module_identity(check.environment.*, check.program.*, module_name) ?? return None
    sema_call_core_source_in(identity, member, values, result, registered, span, check)
}

// A call of the Core function that fills `role` on checked arguments, typed
// `result` (the F32-width math sources); E1015 when no Core function fills it.
sema_call_core_role_source: fn(role: String, values: [TExpr], result: Type, span: Span, check: ^SemaBodyCheck) -> TExpr? {
    graph: check.program.registration_graph
    filler: sema_core_role_function(graph, role) ?? {
        check.diagnostics.push(sema_missing_core_role(role, span))
        return None
    }
    sema_call_core_source_in(filler.module_identity, filler.name, values, result, true, span, check)
}

// The checked source target of the Core function that fills `role`, with
// `type_args`; E1015 when no Core function fills it.
sema_call_core_role_target: fn(role: String, type_args: [Type], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: ^[Diagnostic]) -> SemaCallDirectTarget? {
    filler: sema_core_role_function(program.registration_graph, role) ?? {
        diagnostics.push(sema_missing_core_role(role, span))
        return None
    }
    sema_call_core_source_target(environment, program, filler.module_identity, filler.name, type_args, span, true, diagnostics)
}

// The call sema_call_core_source makes, of `member` of the Core module `identity`.
sema_call_core_source_in: fn(identity: ModuleID, member: String, values: [TExpr], result: Type, registered: Bool, span: Span, check: ^SemaBodyCheck) -> TExpr? {
    target: sema_call_core_source_target(check.environment.*, check.program.*, identity, member, [Type]{}, span, registered, check.diagnostics) ?? return None
    callee: sema_call_callee_decl(check.program.*, target.symbol.id, span, check.diagnostics) ?? return None
    arguments: loop value in values -> TCallArg{value: value.copy(), template_items: [SymbolID]{}, borrow: false, mut_borrow: false, fn_coerce: None, widen_to_vec: false, widen_to_union: None, box_as_trait: None, label: None, spread: false}
    Val(sema_tree_node(result, TExprKind.Call{callee: callee, type_args: [Type]{}, args: arguments}, span))
}

// A call of the `module_name` source function `member` on checked arguments,
// typed by its Core declaration: its declared return with `type_args` for its
// type parameters (web.form's `input` and `typed<Model>`).
sema_call_core_source_declared: fn(module_name: String, member: String, type_args: [Type], values: [TExpr], span: Span, check: ^SemaBodyCheck) -> TExpr? {
    identity: sema_call_core_module_identity(check.environment.*, check.program.*, module_name) ?? return None
    target: sema_call_core_source_target(check.environment.*, check.program.*, identity, member, type_args, span, false, check.diagnostics) ?? return None
    result: sema_call_signature_return(target.signature) ?? return None
    params: sema_call_params_from_type(target.signature) ?? return None
    if params.len() != values.len() -> return None
    callee: sema_call_callee_decl(check.program.*, target.symbol.id, span, check.diagnostics) ?? return None
    Val(sema_tree_node(result, TExprKind.Call{callee: callee, type_args: type_args, args: sema_call_core_source_arguments(values, params, check)}, span))
}

// The Core module and function a source-owned row's `member` names: the row's
// own module, or the module a dotted `core.` source target names.
sema_call_core_source_path: fn(module_name: String, member: String) -> {module_name: String, member: String}? Never! {
    if !member.starts_with("core.") -> return Val({module_name: module_name, member: member})
    parts := member.split(".").to_list()
    function: parts.pop() ?? return None
    Val({module_name: parts.join("."), member: function})
}

// The Core module and function a source-owned record's call runs: the one
// that fills its role, else the one its source target or member names. None
// for an adapter row, or when that function's module is not loaded.
sema_call_core_source_function: fn(record: CoreCallRecord, check: SemaBodyCheck) -> SemaCoreRoleFunction? {
    if core_call_source_role(record) == .Val(role) {
        graph: check.program.registration_graph
        return sema_core_role_function(graph, role)
    }
    member: core_call_source_member(record) ?? return None
    path: sema_call_core_source_path(record.module_name, member) ?? return None
    identity: sema_call_core_module_identity(check.environment.*, check.program.*, path.module_name) ?? return None
    Val(SemaCoreRoleFunction{module_identity: identity, name: path.member})
}

// Push the effects the Core declaration of a source-owned record writes;
// false for an adapter row, or one whose function this program has not loaded.
sema_call_core_declared_effects: fn(record: CoreCallRecord, check: SemaBodyCheck, effects: ^[String]) -> Bool Never! {
    source: sema_call_core_source_function(record, check) ?? return false
    sema_call_core_function_effects(source, check, effects)
}

// Push the effects Core function `source` declares; false when this program
// has not loaded it.
sema_call_core_function_effects: fn(source: SemaCoreRoleFunction, check: SemaBodyCheck, effects: ^[String]) -> Bool Never! {
    graph: check.program.registration_graph
    module_index: sema_registration_module_index(graph, source.module_identity) ?? return false
    position: sema_registration_declaration_row(graph.modules[module_index], source.name) ?? return false
    if graph.modules[module_index].declarations[position] == .Func(function) {
        if function.declared_effects == .Val(row) {
            loop entry in row -> effects.push(entry.name)
        }
        return true
    }
    false
}

// Record the call's effects (including known purity) and enforce authored
// transaction walls before the CoreCall reaches effect-graph collection. A
// source-owned row's effects are its Core declaration's row; an adapter row
// carries its own.
sema_call_core_record_effects: fn(record: CoreCallRecord, span: Span, type_args: [Type], result_type: Type, fallibility: TFailureCarrier, default_refs: [FunctionDefaultRef], check: ^SemaBodyCheck) -> Bool Never! {
    api: if record.module_name != "" -> "{record.module_name}.{record.member}" else -> record.member
    effect_bound := [EffectRowEntry]{}
    declared := [String]{}
    if sema_call_core_declared_effects(record, check, declared) {
        loop name in declared -> effect_bound.push(EffectRowEntry{name: name, span: span})
    } else {
        loop name in record.effects -> effect_bound.push(EffectRowEntry{name: name, span: span})
    }
    facts := SemaCallFacts{
        return_type: result_type,
        failure_carrier: fallibility,
        effect_bound: Val(effect_bound),
        type_args: type_args,
        default_refs: default_refs,
    }
    start: check.context.call_facts.len()
    accepted: sema_effect_record_intrinsic_fact(check.environment.*, check.program.*, check.scopes, check.context, api, span, facts, check.diagnostics)
    if accepted && check.context.call_facts.len() > start {
        last: check.context.call_facts.len() - 1
        detail := sema_call_site_detail(check.context.call_facts[last])
        if record.symbol == .Prelude(symbol) -> detail.runtime_export = Val(symbol.copy())
        check.context.call_facts[last].detail = sema_call_site_detail_of(detail)
    }
    accepted
}

sema_call_core_inference_parameters: fn(names: [String], span: Span) -> [SemaInferenceTypeParam] Never! {
    parameters: loop name in names -> SemaInferenceTypeParam{
        name: name,
        bounds: [String]{},
        span: span,
        identity_key: "",
        bound_module: module_none(),
    }
    parameters
}

sema_call_core_infer_type_args: fn(api: String, names: [String], return_type: Type?, params: [SemaCallParam], binding: SemaCallBinding, source_args: [CallArg], explicit_type_args: [Type], expected: Type?, span: Span, check: ^SemaBodyCheck) -> [Type]? {
    if names.len() == 0 -> return Val([Type]{})
    inference_parameters: sema_call_core_inference_parameters(names, span)
    inference_context := sema_inference_context(check.environment.module_identity, check.environment.package_identity, inference_parameters, check.environment.generic_params, expected)
    if explicit_type_args.len() > 0 {
        result: sema_infer_validate_explicit(check.program.registration_graph, inference_context, explicit_type_args, span, check.diagnostics) ?? return None
        return Val(result.type_args)
    }
    facts := sema_call_collect_inference_facts(params, binding, source_args, check)
    sema_call_lambda_failure_facts(facts, inference_parameters, params, binding, source_args, check)
    inference: sema_infer_callable(check.program.registration_graph, inference_context, facts.parameter_types, return_type, facts.argument_types, [Type]{}, span, check.diagnostics) ?? return None
    if !inference.complete || !inference.compatible {
        check.diagnostics.push(sema_error("E0904", span, "cannot infer the type arguments for `{api}`", "the fixed Core signature must resolve each declared type parameter from its checked arguments or expected result", "provide enough arguments to determine the Core call's type"))
        return None
    }
    Val(inference.type_args)
}

// A declaration with no written return is a Unit call.
sema_call_core_result_type: fn(names: [String], return_type: Type?, type_args: [Type]) -> Type {
    declared: return_type ?? return Type.Named{name: "Unit"}
    sema_inference_substitute_type(declared, names, type_args)
}

// The fixed path starts from the canonical Source contract. Specialized native
// polymorphic bodies remain ahead of this entry point when no fixed row exists.
sema_call_core_posix_control: fn(member: String) -> Bool Never! {
    member == "fork" || member == "setuid" || member == "setgid" || member == "set_user_ids" || member == "set_group_ids" || member == "setpgid" || member == "setpgrp" || member == "setsid" || member == "initgroups" || member == "kill" || member == "reset_signal" || member == "wait" || member == "waitpid" || member == "pipe" || member == "close_fd" || member == "mkfifo" || member == "mknod" || member == "umask" || member == "getpriority" || member == "setpriority" || member == "set_scheduling" || member == "set_wall_clock" || member == "utime" || member == "atexit" || member == "stop"
}

sema_call_core_materialize_authority_boundary: fn(record: CoreCallRecord, index: Int, value: TExpr, span: Span) -> TExpr Never! {
    // copy: the materialized argument is a new owned TExpr. Off the authority boundary it equals
    // `value`, the caller's checked argument (a read parameter), which the caller keeps.
    if !core_call_authority_boundary_at(record, index) -> return value.copy()
    wire: core_call("core.plugin", "__authority_to_wire") ?? panic("checked Authority wire row is missing")
    sema_tree_node(
        Type.String,
        TExprKind.CoreCall{
            record: wire,
            args: [TExpr]{value},
            source_span: span,
            type_args: [Type]{},
            widen_to_vec: [Bool]{false},
            fallibility: TFailureCarrier.Infallible,
        },
        span,
    )
}

// The Core declaration a native Core row's call is checked against: the
// function of the same name in the row's module, the wrapper whose body makes
// that native call (`vault.get`, `net.sendfile`). None when the module is not
// loaded or declares no such function.
sema_call_core_declared_target: fn(record: CoreCallRecord, span: Span, check: ^SemaBodyCheck) -> SemaCallDirectTarget? {
    identity: sema_call_core_module_identity(check.environment.*, check.program.*, record.module_name) ?? return None
    sema_call_core_source_target(check.environment.*, check.program.*, identity, record.member, [Type]{}, span, true, check.diagnostics)
}

// The parameters `target` declares for a native Core row, their types
// resolved as the row's module sees them; a defaulted parameter keeps the
// declaration's default. None when a parameter is untyped or variadic, or a
// type parameter bounded, which a native call cannot carry.
sema_call_core_declared_params: fn(target: SemaCallDirectTarget) -> [SemaCallParam]? {
    params: sema_call_params_from_type(target.signature) ?? return None
    loop param in params {
        if param.variadic || param.ty == None -> return None
    }
    loop parameter in target.generic_params {
        if parameter.bounds.len() > 0 -> return None
    }
    Val(params)
}

sema_call_core_no_fixed_contract: fn(api: String, span: Span, diagnostics: ^[Diagnostic]) -> TExpr? {
    diagnostics.push(sema_error("E0904", span, "`{api}` has no fixed source typed call contract", "fixed Core checking consumes only a complete Source signature", "use the source-owned special checker for a polymorphic Core operation without a fixed row"))
    None
}

// A native Core call's result: its declaration's return, where `T Never!` is
// the infallible spelling of a plain `T`, the value the runtime route
// marshals (`vault.get`'s `String? Never!` returns a `String?`). A diverging
// `Never Never!` keeps its carrier.
sema_call_core_native_return: fn(signature: Type) -> Type? {
    returned: sema_call_signature_return(signature) ?? return None
    if returned == .Result(ok, err) && err == (Type.Named{name: "Never"}) {
        if ok == (Type.Named{name: "Never"}) -> return Val(returned)
        return Val(ok)
    }
    Val(returned)
}

sema_call_core_check_fixed_record: fn(record: CoreCallRecord, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    // Only the plugin boundary inserts the wire; Core reads it through
    // jet.runtime.files.
    if record.module_name == "core.plugin" && record.member == "__authority_to_wire" {
        check.diagnostics.push(sema_error("E0510", span, "Authority wire conversion is compiler-private", "only the checked plugin boundary inserts this conversion", "use core.plugin.load with a tightened Authority"))
        return None
    }
    canonical_record: sema_call_core_record(record.module_name, record.member, args.len(), span, check.diagnostics) ?? return None
    if !core_call_coverage_contains(canonical_record.coverage, CORE_CALL_COVERAGE_SEMA) {
        check.diagnostics.push(sema_error("E0904", span, "`{canonical_record.module_name}.{canonical_record.member}` has no source semantic call contract", "only SEMA-authorized Core records enter fixed-call checking", "use a SEMA-covered Core call"))
        return None
    }
    // #1465: POSIX process/session control requires `#Unsafe` (I1); checking continues.
    if canonical_record.module_name == "core.sys" && check.context.unsafe_depth == 0 && sema_call_core_posix_control(canonical_record.member) {
        check.diagnostics.push(sema_error("E3101", span, "`core.sys.{canonical_record.member}` requires an audited `#Unsafe` region", "POSIX process and session control can change credentials, signals, and process topology", "wrap the call in `#Unsafe(\"posix {canonical_record.member}: …\") {{ … }}` and gate the host OS with `#if #build.target.os` / `#Target(OS.*)`"))
    }
    if canonical_record.symbol == CoreCallSymbol.SourceOwned {
        // A source-owned row is checked against the Core declaration it runs:
        // the function that fills its role, else the one its source target or
        // member names.
        routed: sema_call_core_arity_source_record(canonical_record, args)
        role: core_call_source_role(routed)
        if role == .Val(filled) && sema_call_core_role_target(filled, type_args, span, check.environment.*, check.program.*, check.diagnostics) == .Val(target) {
            return sema_call_core_check_source_owned(target, "{canonical_record.module_name}.{canonical_record.member}", type_args, args, span, expected, check)
        }
        if role == None && sema_call_core_module_identity(check.environment.*, check.program.*, canonical_record.module_name) == .Val(identity) {
            declared_member: routed.source_target ?? canonical_record.member
            if sema_call_core_source_target(check.environment.*, check.program.*, identity, declared_member, type_args, span, true, check.diagnostics) == .Val(target) {
                return sema_call_core_check_source_owned(target, "{canonical_record.module_name}.{declared_member}", type_args, args, span, expected, check)
            }
        }
    }
    // A native row is checked against the Core declaration of the same name,
    // the wrapper whose body makes the native call.
    api: "{canonical_record.module_name}.{canonical_record.member}"
    target: sema_call_core_declared_target(canonical_record, span, check) ?? return sema_call_core_no_fixed_contract(api, span, check.diagnostics)
    shape_params: sema_call_core_declared_params(target) ?? return sema_call_core_no_fixed_contract(api, span, check.diagnostics)
    names: loop parameter in target.generic_params -> parameter.name
    if !sema_call_core_check_type_args(canonical_record.module_name, canonical_record.member, names.len(), true, type_args, span, check.diagnostics) {
        return None
    }
    source_args := [CallArg]{}
    local_args := [CallArg]{}
    loop argument in args {
        source_args.push(argument.copy())
        local_args.push(argument.copy())
    }
    binding := sema_call_bind_args(api, shape_params, local_args, span, check.diagnostics) ?? return None
    return_type: sema_call_core_native_return(target.signature)
    resolved_type_args: sema_call_core_infer_type_args(api, names, return_type, shape_params, binding, source_args, type_args, expected, span, check) ?? return None
    // A parameter the call leaves unwritten takes the Core declaration's
    // default, checked in the declaring module like a direct call's.
    if binding.default_refs.len() > 0 {
        defaults: sema_call_target_default_values(target, binding, span, check) ?? return None
        binding = sema_call_materialize_defaults(shape_params, binding, local_args, defaults, span, check.diagnostics) ?? return None
    }
    // The declaration's type parameters, bound to the call's type arguments.
    params := shape_params
    if names.len() > 0 {
        loop index in 0..<params.len() {
            declared: params[index].ty ?? next
            params[index].ty = Val(sema_inference_substitute_type(declared, names, resolved_type_args))
        }
    }
    {lowered, pins} := sema_call_check_bound_arguments_owned(check, api, params, None, false, binding, local_args, span) ?? return None
    // A `^` argument keeps its Write borrow of the caller's place: a Core leaf
    // that lends a buffer or handle (wipe, reserve, stream writers) works
    // on the original, never on a copy.
    values := [TExpr]{}
    loop argument in lowered {
        if argument.mut_borrow {
            ty: argument.value.ty
            at: argument.value.span
            values.push(sema_tree_node(ty, TExprKind.Borrow{place: argument.value, access: AccessConvention.Write}, at))
        } else { values.push(argument.value) }
    }
    declared_result: sema_call_core_result_type(names, return_type, resolved_type_args)
    result_type: sema_call_core_plugin_load_type(canonical_record, values, declared_result, check.program.*)
    // The CoreCall carrier is derived from the checked result type
    // (`TFailureCarrier.from_checked_type`: only a Result or Option result can
    // fail), and its type arguments are the call's written ones. The inferred
    // signature arguments type the result and record the call fact; the
    // native kernel takes no inferred generic.
    fallibility := sema_expression_failure_carrier(result_type)
    if !sema_call_core_record_effects(canonical_record, span, resolved_type_args, result_type, fallibility, binding.default_refs, check) {
        return None
    }
    value: sema_call_core_tree(canonical_record, values, span, type_args, loop _ in values -> false, result_type, fallibility, None, check) ?? return None
    sema_expression_call_expected(sema_call_with_binder_pins(pins, value, span), expected, check)
}

// Resolve source exports before building a fixed Core call. The callee's
// canonical typed contract is discovered here; callers never supply its Type.
sema_call_core_check_fixed: fn(module_name: String, member: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    route: sema_call_core_resolve_route(check, module_name, member, type_args, args.len(), sema_call_core_configured_client(args), span) ?? return None
    if route == {
        .SharedSite(lifetime) -> {
            return sema_call_core_global_shared(lifetime, member, type_args, args, span, expected, check)
        }
        .Source(target) -> {
            return sema_call_core_check_source_owned(target, "{module_name}.{member}", type_args, args, span, expected, check)
        }
        .Core(record) -> {
            return sema_call_core_check_fixed_record(record, args, type_args, span, expected, check)
        }
    }
}

sema_call_core_shared_diagnostic: fn(member: String, span: Span) -> Diagnostic Never! {
    sema_error("E0109", span, "`core.mem.{member}` needs a direct Core initializer", "a publication site requires a non-generic, zero-argument, infallible module function declared in the same Core module, returning Shared<T>; its inferred effects may contain only Mem and its publication lifetime must be consistent", "pass the name of a same-module Shared initializer with no effects except allocation")
}

sema_call_core_shared_reject: fn(member: String, span: Span, diagnostics: ^[Diagnostic]) -> TExpr? Never! {
    diagnostics.push(sema_call_core_shared_diagnostic(member, span))
    None
}

// The trusted Core body supplies a side-effect-free constructor. Ordinary
// zero-argument call checking owns its failure/effect facts; this node only
// changes the storage lifetime and preserves its declared Shared payload type.
// A package's source cannot spell these members: the lexer refuses every
// double-underscore name there (E0067), so no caller-module test is kept here.
sema_call_core_global_shared: fn(lifetime: SharedLifetime, member: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    if args.len() != 1 || type_args.len() != 0 {
        return sema_call_core_shared_reject(member, span, check.diagnostics)
    }
    if args[0].label != None || args[0].spread {
        return sema_call_core_shared_reject(member, span, check.diagnostics)
    }
    name: if args[0].expr == {
        .Ident(value, _, _) -> Val(value)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> None
    } ?? return sema_call_core_shared_reject(member, span, check.diagnostics)
    nearest: sema_scope_resolve_index(check.scopes, name) ?? return sema_call_core_shared_reject(member, span, check.diagnostics)
    if check.scopes.bindings[nearest].symbol.kind != SymbolKind.Function {
        return sema_call_core_shared_reject(member, span, check.diagnostics)
    }
    target: sema_call_resolve_direct(name, [Type]{}, check, args[0].span) ?? return sema_call_core_shared_reject(member, span, check.diagnostics)
    if target.generic_params.len() != 0 {
        return sema_call_core_shared_reject(member, span, check.diagnostics)
    }
    if !sema_call_core_shared_initializer_declared(check, target) {
        return sema_call_core_shared_reject(member, span, check.diagnostics)
    }
    params: sema_call_params_from_type(target.signature) ?? return sema_call_core_shared_reject(member, span, check.diagnostics)
    if params.len() != 0 -> return sema_call_core_shared_reject(member, span, check.diagnostics)
    call: Call{name: name, name_span: span, type_args: [Type]{}, args: [CallArg]{}}
    checked: sema_call_check_direct_target_owned(check, target, call, [SemaCallDefaultValue]{}, None) ?? return sema_call_core_shared_reject(member, span, check.diagnostics)
    if checked.facts.failure_carrier != TFailureCarrier.Infallible {
        return sema_call_core_shared_reject(member, span, check.diagnostics)
    }
    published: sema_call_core_shared_success(checked.value.ty) ?? return sema_call_core_shared_reject(member, span, check.diagnostics)
    before: check.context.call_facts.len()
    if !sema_expr_record_call_fact(check, span, checked) -> return None
    if check.context.call_facts.len() != before + 1 {
        check.context.incomplete_reasons.push("checked Core publication call has no effect obligation")
        return None
    }
    detail := sema_call_site_detail(check.context.call_facts[before])
    detail.shared_lifetime = Val(lifetime)
    detail.shared_member = member
    detail.shared_source = sema_scope_environment_module_text(check.environment.*, check.program.*)
    check.context.call_facts[before].detail = sema_call_site_detail_of(detail)
    initializer: sema_call_callee_decl(check.program.*, target.symbol.id, span, check.diagnostics) ?? return None
    value: sema_node(check.context, published, NodeKind.GlobalShared{initializer: initializer, lifetime: lifetime}, span)
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// The shared global's initializer is read from this module's own items: a
// zero-parameter, non-generic, non-extern function. A checked Core module keeps
// its functions as registration-graph rows, not in `check.environment.declarations`;
// both are read in place.
sema_call_core_shared_initializer_declared: fn(check: SemaBodyCheck, target: SemaCallDirectTarget) -> Bool Never! {
    if target.symbol.module_identity != check.environment.module_identity -> return false
    graph: check.program.registration_graph
    if sema_registration_callable_row_of(graph, target.symbol.id) == .Val(row) {
        if row == {
            .Function(module_index, index) -> return sema_call_core_shared_initializer_shape(graph.modules[module_index].functions[index].declaration)
            .Foreign(_, _) | .NominalMethod(_, _, _) | .ImplMethod(_, _, _) -> return false
        }
    }
    loop declaration_index in 0..<check.environment.declarations.len() {
        if check.environment.declarations[declaration_index].symbol_id != target.symbol.id -> next
        if check.environment.declarations[declaration_index].item == .Func(function) {
            return sema_call_core_shared_initializer_shape(function)
        }
        return false
    }
    false
}

sema_call_core_shared_initializer_shape: fn(function: Func) -> Bool Never! {
    function.external_type == None && function.type_params.len() == 0 && function.params.len() == 0
}

// The call of a `Shared<T> Never!` initializer keeps its `Never` carrier; the
// published value is its success type.
sema_call_core_shared_success: fn(ty: Type) -> Type? Never! {
    if ty == {
        .Shared(_) -> Val(ty.copy())
        .Result(ok, err) -> {
            if err != (Type.Named{name: "Never"}) -> return None
            if ok == {
                .Shared(_) -> Val(ok.copy())
                .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Option(_) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

sema_call_core_check_source_owned: fn(target: SemaCallDirectTarget, qualified_name: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    call_args := args
    if sema_call_devtools_is_publish(target, check) {
        call_args = sema_call_devtools_publish_args(args, span, check) ?? return None
    }
    if sema_data_is_sys_decode(target, check) {
        call_args = sema_data_sys_decode_args(args, type_args, span, check) ?? return None
    }
    if sema_data_is_db_decode(target, check) {
        call_args = sema_data_db_decode_args(args, type_args, span, check) ?? return None
    }
    if sema_call_histories_is_call(target, check) {
        call_args = sema_call_histories_args(args, type_args, span, check)
    }
    call := Call{name: qualified_name, name_span: span, type_args: type_args, args: call_args}
    checked: sema_call_check_direct_target_owned(check, target, call, [SemaCallDefaultValue]{}, expected) ?? return None
    if target.symbol.name == "to_string" && sema_call_core_module_is(check, "core.encoding.csv", target.symbol.module_identity) {
        if !sema_data_csv_check_rows(args, checked.value, check) -> return None
    }
    if !sema_data_encode_check_value(target, args, checked.value, check) -> return None
    // Every call's returned views compose with its arguments; a source-module
    // call (`stream.object_entries(v)`) publishes them like a direct call, so a
    // binding keeps the view's owner.
    check.context.call_return_views.push(SemaCallReturnView{span: span, facts: checked.return_view_facts})
    if !sema_expr_record_call_fact(check, span, checked) -> return None
    // The parameter marked `#ColumnOf` (`table.column("name", …)`) names a
    // field of the result's row type, checked against it (E2475).
    graph: check.program.registration_graph
    if sema_web_param_marker(graph, sema_registration_symbol_key(graph, target.symbol.id), SEMA_WEB_MARKER_COLUMN_OF) == .Val(param) {
        sema_call_web_table_column_schema(args, param, checked.value, check)
    }
    Val(checked.value)
}

#Test("worker checked-function inference changes no other Core route") {
    configured: [Bool]{false, true}
    loop row in CORE_CALLS {
        loop moved in configured {
            previous: row.module_name == "core.net.tls" && row.member == "client" && moved
            worker: row.module_name == "core.service" && row.member == "worker"
            assert(sema_call_core_native_resource_consumer(row.module_name, row.member, moved) == (previous || worker))
        }
    }
}
