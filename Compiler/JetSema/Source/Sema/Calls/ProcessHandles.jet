// Checked process handle methods. The caller supplies a checked receiver;
// this module owns only these compiler-provided handle contracts.
use jet_foundation.[
    BodyHandleOp,
    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    InternalTag,
    ParamZone,
    Span,
    TERMINAL_FACTS,
    TFailureCarrier,
    TagMarker,
    Type,
]

sema_process_named: fn(name: String) -> Type Never! { Type.Named{name: name} }

// The Core types this module types itself that Core declares nowhere and
// exports from no module: the spawned child, its plan, streams and line
// reader, and the terminal policy and session. Copy and sendability
// judgments know them as Core types.
sema_process_handle_type: fn(name: String) -> Bool Never! {
    if name == {
        "ProcessChild" | "ProcessPlan" | "ProcessStdin" | "ProcessStdoutStream" | "ProcessStderrStream" | "ProcessLines" | "TerminalPolicy" | "TerminalSize" | "TerminalSession" -> true
        else -> false
    }
}

sema_process_infer_args: fn(args: [CallArg], check: ^SemaBodyCheck) Never! {
    loop argument in args -> ^_: sema_check_expression(argument.expr, None, check)
}

sema_process_wrong_arity: fn(method: String, expected: Int, actual: Int, span: Span, diagnostics: ^[Diagnostic]) {
    diagnostics.push(sema_call_core_arity_diagnostic(method, expected, actual, span))
}

sema_process_check_args: fn(args: [CallArg], required: [Type], check: ^SemaBodyCheck) -> [TExpr]? {
    if args.len() != required.len() -> return None
    values: loop index in 0..<args.len() -> {
        value: sema_check_expression(args[index].expr, Val(required[index]), check) ?? return None
        value
    }
    Val(values)
}

sema_process_handle_receiver_name: fn(ty: Type) -> String Never! {
    if ty == {
        .Named(name) -> name
        .Tagged(_, inner) -> sema_process_handle_receiver_name(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ""
    }
}

sema_process_method_params: fn(args: [CallArg], required: [Type], moving: [Bool]) -> [SemaCallParam] Never! {
    ^params: [SemaCallParam]{}
    loop index in 0..<args.len() {
        param_type: if index < required.len() -> Val(required[index]) else -> None
        convention: if index < moving.len() && moving[index] -> AccessConvention.Move else -> AccessConvention.Read
        params.push(
            SemaCallParam{
                label: "arg{index}",
                name: "arg{index}",
                zone: ParamZone.PositionalOnly,
                default: None,
                default_ref: None,
                convention: convention,
                ty: param_type,
                variadic: false,
            },
        )
    }
    params
}

sema_process_check_method_ownership: fn(receiver: Expr, method: String, args: [CallArg], required: [Type], moving: [Bool], receiver_access: AccessConvention, span: Span, check: ^SemaBodyCheck) -> Bool {
    ^updated_args: args
    ^params: sema_process_method_params(updated_args, required, moving)
    ^ownership: sema_ownership_check_method_call(check, method, receiver, receiver_access, params, updated_args, span)
    ownership.accepted && ownership.complete
}

sema_process_failure_carrier: fn(result: Type) -> TFailureCarrier Never! {
    if result == {
        // copy: `ok` and `err` are payloads of read parameter `result`, which keeps the originals; the new TFailureCarrier.Result's fields own `ok` and `err`
        .Result(ok, err) -> TFailureCarrier.Result{success: ok.copy(), error: err.copy()}
        // copy: `inner` is a payload of read parameter `result`, which keeps the original; field `value` of the new TFailureCarrier.Optional owns this one
        .Option(inner) -> TFailureCarrier.Optional{value: inner.copy()}
        .Named(name) -> if name == "Never" -> TFailureCarrier.Diverges{value: result} else -> TFailureCarrier.Infallible
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> TFailureCarrier.Infallible
    }
}

sema_process_record_intrinsic: fn(result: Type, effect_name: String, api: String, span: Span, check: ^SemaBodyCheck) -> Bool Never! {
    ^effects: [EffectRowEntry]{}
    if effect_name != "" -> effects.push(EffectRowEntry{name: effect_name, span: span})
    ^facts: SemaCallFacts{
        return_type: result,
        failure_carrier: sema_process_failure_carrier(result),
        effect_bound: Val(effects),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(check.environment.*, check.program.*, check.scopes, check.context, api, span, facts, check.diagnostics)
}

sema_process_finish: fn(receiver: TExpr, operation: BodyHandleOp, args: [TExpr], result: Type, effect_name: String, api: String, span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck Never! {
    if !sema_process_record_intrinsic(result, effect_name, api, span, check) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    ^value: sema_tree_node(result, TExprKind.HandleMethod{receiver: receiver, operation: operation, args: args}, span)
    // A call checker's finish: under the dispatcher's success view a
    // `ProcessReceipt IOError!` result meets a `ProcessReceipt` expectation by
    // its success side, and the call root then propagates the failure.
    ^checked: sema_expression_call_expected(value, expected, check)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

// The ProcessSpec builders and checks the compiler still types; the launch
// steps (`plan`, `run`, `run_checked`, `spawn`) are core.process's
// `impl ProcessSpec` methods.
sema_process_spec_known_method: fn(method: String) -> Bool Never! {
    method == "cwd" || method == "env_remove" || method == "stdin" || method == "stdout" || method == "stderr" || method == "env" || method == "arg" || method == "args_extend" || method == "terminal" || method == "env_clear" || method == "detached" || method == "abilities" || method == "keep_open" || method == "timeout" || method == "cpu_time_limit" || method == "output_limit" || method == "memory_limit" || method == "memory_scope" || method == "open_file_limit" || method == "cpu_affinity" || method == "io_priority" || method == "io_idle" || method == "under"
}

sema_process_spec_result: fn(method: String, argc: Int, span: Span, diagnostics: ^[Diagnostic]) -> Type? {
    ^spec: sema_process_named("ProcessSpec")
    if method == {
        "cwd" | "env_remove" | "stdin" | "stdout" | "stderr" -> {
            if argc == 1 -> return Val(spec)
        }
        "env" -> {
            if argc == 2 -> return Val(spec)
        }
        "arg" | "args_extend" -> {
            if argc == 1 -> return Val(spec)
        }
        "terminal" -> {
            if argc == 0 || argc == 1 -> return Val(spec)
        }
        "env_clear" | "detached" | "io_idle" -> {
            if argc == 0 -> return Val(spec)
        }
        "abilities" -> {
            if argc == 0 {
                return Val(Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.TerminalFactSet}, inner: Type.Apply{name: "Set", args: [Type]{Type.String}}})
            }
        }
        "keep_open" -> {
            if argc == 1 || argc == 2 -> return Val(spec)
        }
        "timeout" | "cpu_time_limit" | "output_limit" | "memory_limit" | "memory_scope" | "open_file_limit" | "cpu_affinity" | "io_priority" -> {
            if argc == 1 -> return Val(spec)
        }
        "under" -> {
            if argc == 1 -> return Val(spec)
        }
        else -> {}
    }
    if !sema_process_spec_known_method(method) -> return None
    if {
        method == "terminal" -> {
            diagnostics.push(sema_error("E0104", span, "`terminal` expects 0 or 1 arguments, got {argc}", "`terminal()` uses portable defaults; `terminal(policy)` uses one TerminalPolicy", "pass no argument or one TerminalPolicy"))
        }
        method == "keep_open" -> {
            diagnostics.push(sema_error("E0104", span, "`keep_open` expects 1 or 2 arguments, got {argc}", "`keep_open(handle)` keeps the handle at its own descriptor number; `keep_open(handle, at: slot)` keeps it at `slot`", "pass the handle, then optionally `at:` and a descriptor slot"))
        }
        method == "env" -> { sema_process_wrong_arity(method, 2, argc, span, diagnostics) }
        method == "arg" || method == "args_extend" || method == "under" -> {
            sema_process_wrong_arity(method, 1, argc, span, diagnostics)
        }
        method == "cwd" || method == "env_remove" || method == "stdin" || method == "stdout" || method == "stderr" || method == "timeout" || method == "cpu_time_limit" || method == "output_limit" || method == "memory_limit" || method == "memory_scope" || method == "open_file_limit" || method == "cpu_affinity" || method == "io_priority" -> {
            sema_process_wrong_arity(method, 1, argc, span, diagnostics)
        }
        else -> { sema_process_wrong_arity(method, 0, argc, span, diagnostics) }
    }
    None
}

sema_process_spec_arg_types: fn(method: String, argc: Int) -> [Type] Never! {
    return if method == {
        "cwd" | "env_remove" | "arg" -> [Type]{Type.String}
        "args_extend" -> [Type]{Type.List{element: Type.String}}
        "stdin" | "stdout" | "stderr" -> [Type]{sema_process_named("ProcessStreamMode")}
        "env" -> [Type]{Type.String, Type.String}
        "timeout" | "cpu_time_limit" -> [Type]{sema_process_named("Duration")}
        "output_limit" | "memory_limit" | "memory_scope" | "open_file_limit" | "io_priority" -> [Type]{Type.Int}
        "cpu_affinity" -> [Type]{Type.List{element: Type.Int}}
        "under" -> [Type]{sema_process_named("Authority")}
        "terminal" -> if argc == 1 -> [Type]{sema_process_named("TerminalPolicy")} else -> [Type]{}
        else -> [Type]{}
    }
}

sema_process_spec_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    result: sema_process_spec_result(method, args.len(), span, check.diagnostics) ?? {
        if !sema_process_spec_known_method(method) {
            return SemaMethodSpecialCheck{handled: false, value: None}
        }
        sema_process_infer_args(args, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    // `spec.keep_open(handle, at:)` is the ordinary core.files source body
    // that fills the ProcessSpecKeepOpen role; its declaration types the
    // handle union and the slot, and the spec takes the handle.
    if method == "keep_open" {
        return sema_process_spec_keep_open(receiver, receiver_value, args, result, span, expected, check)
    }
    required: sema_process_spec_arg_types(method, args.len())
    values: sema_process_check_args(args, required, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    // ProcessSpec builders are typed with no receiver convention and no
    // recorded move: a builder on a named spec read again later
    // (`clean.env(…).run()` in a loop) is no E0121.
    // The spec still moves like an unmarked owning position, so a later use
    // turns the move into a share and a borrowed parameter keeps its value.
    known_mutating: method != "abilities"
    if !sema_process_check_method_ownership(receiver, "ProcessSpec.{method}", args, required, [Bool]{}, AccessConvention.Read, span, check) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    sema_receiver_mark_forget(check.state, receiver)
    if known_mutating && receiver == .Ident(_, _, _) {
        if !sema_ownership_mark_unmarked_move(check.state, receiver, check.scopes, "`ProcessSpec.{method}`", check.diagnostics) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    // Each method is the ordinary Core source body that fills its
    // jet_builtins role (sema_process_spec_role; `abilities` reports the
    // checked TerminalFact set), so every tier runs the same Jet code.
    ^call_args: [TExpr]{receiver_value}
    loop argument in values -> call_args.push(argument)
    sema_process_source_call(sema_process_spec_role(method, args.len()), "ProcessSpec.{method}", "", call_args, result, span, expected, check)
}

// The jet_builtins role of the Core body a ProcessSpec method other than
// `keep_open` calls, given its argument count (`terminal(policy)` fills
// ProcessSpecTerminalWithPolicy); "" for no such method.
sema_process_spec_role: fn(method: String, argc: Int) -> String Never! {
    if method == {
        "abilities" -> "ProcessSpecAbilities"
        "cwd" -> "ProcessSpecCwd"
        "arg" -> "ProcessSpecArg"
        "args_extend" -> "ProcessSpecArgsExtend"
        "env" -> "ProcessSpecEnv"
        "env_remove" -> "ProcessSpecEnvRemove"
        "env_clear" -> "ProcessSpecEnvClear"
        "output_limit" -> "ProcessSpecOutputLimit"
        "memory_limit" -> "ProcessSpecMemoryLimit"
        "memory_scope" -> "ProcessSpecMemoryScope"
        "open_file_limit" -> "ProcessSpecOpenFileLimit"
        "cpu_affinity" -> "ProcessSpecCPUAffinity"
        "io_priority" -> "ProcessSpecIOPriority"
        "io_idle" -> "ProcessSpecIOIdle"
        "detached" -> "ProcessSpecDetached"
        "terminal" -> if argc == 1 -> "ProcessSpecTerminalWithPolicy" else -> "ProcessSpecTerminal"
        "under" -> "ProcessSpecUnder"
        "stdin" -> "ProcessSpecStdin"
        "stdout" -> "ProcessSpecStdout"
        "stderr" -> "ProcessSpecStderr"
        "timeout" -> "ProcessSpecTimeout"
        "cpu_time_limit" -> "ProcessSpecCPUTimeLimit"
        else -> ""
    }
}

// `api` as a call of the Core source body that fills `role` on `args` (the
// receiver first), typed `result`, with the effect `effect_name` (none when
// empty). The compiler finds the body by its role, never by its name.
sema_process_source_call: fn(role: String, api: String, effect_name: String, args: [TExpr], result: Type, span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_process_record_intrinsic(result, effect_name, api, span, check) -> return rejected
    filler: sema_core_role_function(check.program.registration_graph, role) ?? {
        check.diagnostics.push(sema_missing_core_role(role, span))
        return rejected
    }
    target: sema_call_core_source_target(check.environment.*, check.program.*, filler.module_identity, filler.name, [Type]{}, span, true, check.diagnostics) ?? {
        check.context.incomplete_reasons.push("{api} must resolve its canonical Jet source body")
        return rejected
    }
    callee: sema_call_callee_decl(check.program.*, target.symbol.id, span, check.diagnostics) ?? return rejected
    call_args: loop argument in args -> sema_value_method_source_arg(argument)
    value: sema_tree_node(result, TExprKind.Call{callee: callee, type_args: [Type]{}, args: call_args}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(value, expected, check)}
}

sema_process_spec_keep_open: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], result: Type, span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    loop (index, argument) in args {
        if argument.label == .Val(label) {
            if index == 1 && label.name == "at" -> next
            check.diagnostics.push(sema_error("E0764", label.span, "`ProcessSpec.keep_open` has no parameter labeled `{label.name}`", "a label binds an argument to the parameter of that name", "pass the handle without a label, then the slot as `at:`"))
            sema_process_infer_args(args, check)
            return rejected
        }
    }
    if sema_call_core_no_os_refused(check, "core.files", "keep_open", span) -> return rejected
    target: sema_call_core_role_target("ProcessSpecKeepOpen", [Type]{}, span, check.environment.*, check.program.*, check.diagnostics) ?? {
        check.context.incomplete_reasons.push("ProcessSpec.keep_open must resolve its canonical Jet source body")
        return rejected
    }
    params: if target.signature == {
        .Fn(params, _, _, _, _, _) -> params
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            check.context.incomplete_reasons.push("ProcessSpec.keep_open's source body has a function type")
            return rejected
        }
    }
    handle_type: sema_call_resolved_type(params[1], check.environment.*, check.program.*)
    slot_type: sema_call_resolved_type(params[2], check.environment.*, check.program.*)
    handle_checked: sema_check_expression(args[0].expr, Val(handle_type), check) ?? return rejected
    handle_value: sema_expr_expected_owned(handle_checked, Val(handle_type), check.environment.*, check.program.*, check.diagnostics) ?? return rejected
    // An omitted slot is the declaration's `None`: the handle's own number.
    slot_expr: if args.len() == 2 -> args[1].expr else -> Expr.Absent{span: span, id: AST_NODE_GENERATED}
    slot_checked: sema_check_expression(slot_expr, Val(slot_type), check) ?? return rejected
    slot_value: sema_expr_expected_owned(slot_checked, Val(slot_type), check.environment.*, check.program.*, check.diagnostics) ?? return rejected
    // The handle moves into the spec exactly as at any `^^` parameter: a
    // named handle is taken out of its place, so its scope no longer closes it.
    ^taken: sema_call_marked_move_place(args[0].expr, handle_value)
    if taken && sema_ownership_binding_for_expr(check.state, args[0].expr, check.scopes) == .Val(root) {
        taken = !sema_ownership_binding_is_borrowed_param(root)
    }
    stored: sema_call_marked_move_value(check, taken, args[0].expr, handle_value) ?? return rejected
    if !sema_process_check_method_ownership(receiver, "ProcessSpec.keep_open", args, [Type]{handle_type, slot_type}, [Bool]{true, false}, AccessConvention.Read, span, check) {
        return rejected
    }
    sema_receiver_mark_forget(check.state, receiver)
    if receiver == .Ident(_, _, _) {
        if !sema_ownership_mark_unmarked_move(check.state, receiver, check.scopes, "`ProcessSpec.keep_open`", check.diagnostics) {
            return rejected
        }
    }
    if !sema_process_record_intrinsic(result, "FS", "ProcessSpec.keep_open", span, check) {
        return rejected
    }
    callee: sema_call_callee_decl(check.program.*, target.symbol.id, span, check.diagnostics) ?? return rejected
    ^handle_arg: sema_value_method_source_arg(stored)
    handle_arg.widen_to_union = sema_call_widen_union(handle_type, stored.ty)
    ^value: sema_tree_node(result, TExprKind.Call{callee: callee, type_args: [Type]{}, args: [TCallArg]{sema_value_method_source_arg(receiver_value), handle_arg, sema_value_method_source_arg(slot_value)}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(value, expected, check)}
}

// `lines()` on a child's output or error output: the lazy line walk the loop
// lowering reads. Their other methods are core.process's.
sema_process_stream_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if method != "lines" -> return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 0 {
        sema_process_wrong_arity(method, 0, args.len(), span, check.diagnostics)
        sema_process_infer_args(args, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    api: "{sema_process_handle_receiver_name(receiver_value.ty)}.{method}"
    if !sema_process_check_method_ownership(receiver, api, args, [Type]{}, [Bool]{}, AccessConvention.Read, span, check) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    sema_process_finish(receiver_value, BodyHandleOp.ProcessLines, [TExpr]{}, sema_process_named("ProcessLines"), "Exec", api, span, expected, check)
}

sema_call_try_process_handle_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    // A child's `terminal` is optional: its session methods need the handle
    // unwrapped first.
    if method == "resize" && receiver_value.ty == .Option(inner) && sema_process_handle_receiver_name(inner) == "TerminalSession" {
        check.diagnostics.push(sema_error("E0311", span, "`.resize()` needs `TerminalSession`, not `TerminalSession?`", "a child has a terminal session only when a terminal-backed launch succeeds", "unwrap the optional handle first, then call `session.resize(size)`"))
        sema_process_infer_args(args, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    // A string key one or two edits from a stable terminal fact is a typo of
    // that fact; any other string key stays an open preview fact.
    if method == "has" && args.len() == 1 && receiver_value.ty == .Tagged(marker, _) && marker == (TagMarker.Internal{internal_tag: InternalTag.TerminalFactSet}) {
        if args[0].expr == .Str(parts, key_span, _) && parts.len() == 1 && parts[0] == .Lit(key) {
            if sema_suggest_field(key, TERMINAL_FACTS) == .Val(fact) {
                check.diagnostics.push(sema_error("E0302", key_span, "terminal fact key `{key}` looks like `{fact}`", "preview string keys stay open, but close spellings of stable facts are probably typos", "write `TerminalFact.{fact}`"))
                sema_process_infer_args(args, check)
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
        }
    }
    receiver_name: sema_process_handle_receiver_name(receiver_value.ty)
    if receiver_name == "ProcessSpec" {
        return sema_process_spec_method(receiver, receiver_value, method, args, span, expected, check)
    }
    if receiver_name == "ProcessStdoutStream" || receiver_name == "ProcessStderrStream" {
        return sema_process_stream_method(receiver, receiver_value, method, args, span, expected, check)
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}
