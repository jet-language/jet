// Checked process and command-line handle methods. The caller supplies a checked
// receiver; this module owns only these compiler-provided handle contracts.

fn sema_process_named(name: String) -> Type Never! {
    Type.Named{name: name}
}

fn sema_process_result(ok: Type, err: Type) -> Type Never! {
    Type.Result{ok: ok, err: err}
}

fn sema_process_io_result(ok: Type) -> Type Never! {
    sema_process_result(ok, Type.Named{name: "IOError"})
}

fn sema_process_infer_args(args: [CallArg], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    loop argument in args {
        _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    }
}

fn sema_process_wrong_arity(method: String, expected: Int, actual: Int, span: Span, diagnostics: &[Diagnostic]) {
    &diagnostics.push(sema_call_arity_diagnostic(method, expected, actual, false, span))
}

fn sema_process_check_args(args: [CallArg], required: [Type], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [TExpr]? {
    if args.len() != required.len() -> return None
    values := [TExpr]{}
    loop index in 0..<args.len() {
        value :: sema_check_expression(args[index].expr, Val(required[index]), environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
        &values.push(value)
    }
    Val(values)
}

fn sema_process_handle_receiver_name(ty: Type) -> String Never! {
    if ty == {
        .Named(name) -> name
        .Tagged(_, inner) -> sema_process_handle_receiver_name(inner)
        else -> ""
    }
}

fn sema_process_args_spec_op(method: String) -> THandleOp? {
    if method == {
        "flag" -> Val(THandleOp.ArgsSpecFlag)
        "flag_short" -> Val(THandleOp.ArgsSpecFlagShort)
        "option" -> Val(THandleOp.ArgsSpecOption)
        "option_short" -> Val(THandleOp.ArgsSpecOptionShort)
        "option_default" -> Val(THandleOp.ArgsSpecOptionDefault)
        "option_env" -> Val(THandleOp.ArgsSpecOptionEnv)
        "option_int" -> Val(THandleOp.ArgsSpecOptionInt)
        "option_float" -> Val(THandleOp.ArgsSpecOptionFloat)
        "option_choice" -> Val(THandleOp.ArgsSpecOptionChoice)
        "repeat" -> Val(THandleOp.ArgsSpecRepeat)
        "required_option" -> Val(THandleOp.ArgsSpecRequiredOption)
        "positional" -> Val(THandleOp.ArgsSpecPositional)
        "description" -> Val(THandleOp.ArgsSpecDescription)
        "subcommand" -> Val(THandleOp.ArgsSpecSubcommand)
        "version" -> Val(THandleOp.ArgsSpecVersion)
        "completion" -> Val(THandleOp.ArgsSpecCompletion)
        "help" -> Val(THandleOp.ArgsSpecHelp)
        "parse" -> Val(THandleOp.ArgsSpecParse)
        "parse_or_exit" -> Val(THandleOp.ArgsSpecParseOrExit)
        else -> None
    }
}

fn sema_process_args_spec_arity(method: String) -> Int? {
    if method == {
        "flag" | "positional" -> Val(2)
        "flag_short" | "option_int" | "option_float" | "repeat" | "required_option" | "subcommand" -> Val(3)
        "option" -> Val(3)
        "option_short" | "option_default" | "option_env" | "option_choice" -> Val(4)
        "description" | "version" | "completion" | "parse" | "parse_or_exit" -> Val(1)
        "help" -> Val(0)
        else -> None
    }
}

fn sema_process_args_spec_wrong_arity(method: String, actual: Int, span: Span) -> Diagnostic? {
    if method == {
        "flag" -> Val(sema_error("E1301", span, "`flag` expects 2 arguments (name, help), got {actual}", "`ArgsSpec.flag(name, help)` registers a boolean flag like `--verbose`", "pass exactly two strings: the flag name and a help description"))
        "flag_short" -> Val(sema_error("E1301", span, "`flag_short` expects 3 arguments (name, short, help), got {actual}", "`ArgsSpec.flag_short(name, short, help)` registers a boolean flag with a `-v` alias", "pass exactly three strings: long name, one-letter short name, and help text"))
        "option" -> Val(sema_error("E1302", span, "`option` expects 3 arguments (name, help, metavar), got {actual}", "`ArgsSpec.option(name, help, metavar)` registers a value option like `--output FILE`", "pass three strings: the option name, a help description, and a metavar like `FILE`"))
        "option_short" | "option_default" | "option_env" | "option_int" | "option_float" | "option_choice" | "repeat" | "required_option" -> Val(sema_error("E1302", span, "`{method}` was called with the wrong number of arguments", "`core.args` option builders declare long names, help text, and a value name; variants add one extra string where needed", "check the `core.args` builder signature and pass the required strings"))
        "positional" -> Val(sema_error("E1303", span, "`positional` expects 2 arguments (name, help), got {actual}", "`ArgsSpec.positional(name, help)` registers a required positional argument", "pass exactly two strings: the positional name and a help description"))
        "subcommand" -> Val(sema_error("E1303", span, "`subcommand` expects 3 arguments (name, help, spec), got {actual}", "`ArgsSpec.subcommand(name, help, spec)` gives a subcommand its own nested ArgsSpec", "pass the subcommand name, help text, and an ArgsSpec built with `args.spec()`"))
        "version" | "completion" -> Val(sema_error("E1303", span, "`{method}` expects 1 argument, got {actual}", "`version(text)` configures `--version`; `completion(shell)` renders shell completion text", "pass exactly one string"))
        "parse" -> Val(sema_error("E1304", span, "`parse` expects 1 argument (argv), got {actual}", "`ArgsSpec.parse(argv)` parses a `[String]` against the spec", "pass exactly one argument: an argv list, e.g. `process.argv()`"))
        "description" -> Val(sema_call_arity_diagnostic(method, 1, actual, false, span))
        else -> None
    }
}

fn sema_process_args_spec_result(method: String) -> Type? {
    if method == {
        "flag" | "flag_short" | "option" | "option_short" | "option_default" | "option_env" | "option_int" | "option_float" | "option_choice" | "repeat" | "required_option" | "positional" | "description" | "subcommand" | "version" -> Val(sema_process_named("ArgsSpec"))
        "completion" | "help" -> Val(Type.String)
        "parse" -> Val(sema_process_result(sema_process_named("ParsedArgs"), Type.String))
        "parse_or_exit" -> Val(sema_process_named("ParsedArgs"))
        else -> None
    }
}

fn sema_process_parsed_args_result(method: String) -> Type? {
    if method == {
        "flag" -> Val(Type.Bool)
        "option" | "positional" | "subcommand" -> Val(Type.Option{inner: Type.String})
        "option_int" -> Val(Type.Option{inner: Type.Int})
        "option_float" -> Val(Type.Option{inner: Type.Float})
        "options" -> Val(Type.List{element: Type.String})
        else -> None
    }
}

fn sema_process_parsed_args_arity(method: String) -> Int? {
    if method == {
        "flag" | "option" | "option_int" | "option_float" | "options" | "positional" -> Val(1)
        "subcommand" -> Val(0)
        else -> None
    }
}

fn sema_process_parsed_args_wrong_arity(method: String, actual: Int, span: Span) -> Diagnostic? {
    if method == {
        "flag" -> Val(sema_error("E1301", span, "`ParsedArgs.flag` expects 1 argument (flag name), got {actual}", "`parsed.flag(\"verbose\")` returns `true` when `--verbose` was passed", "pass exactly one string: the flag name without leading `--`"))
        "option" -> Val(sema_error("E1302", span, "`ParsedArgs.option` expects 1 argument (option name), got {actual}", "`parsed.option(\"output\")` returns the value of `--output VALUE`, or `null`", "pass exactly one string: the option name without leading `--`"))
        "option_int" | "option_float" | "options" -> Val(sema_error("E1302", span, "`ParsedArgs.{method}` expects 1 argument (option name), got {actual}", "typed option queries read values already validated by `ArgsSpec.parse`", "pass exactly one string: the option name without leading `--`"))
        "positional" -> Val(sema_error("E1303", span, "`ParsedArgs.positional` expects 1 argument (index), got {actual}", "`parsed.positional(0)` returns the first positional argument, or `null`", "pass exactly one Int: the zero-based positional argument index"))
        "subcommand" -> Val(sema_error("E1303", span, "`ParsedArgs.subcommand` expects 0 arguments, got {actual}", "`parsed.subcommand()` returns the matched subcommand name, if any", "call it with no arguments"))
        else -> None
    }
}

fn sema_process_args_spec_arg_types(method: String) -> [Type] Never! {
    if method == {
        "flag" | "positional" -> [Type]{Type.String, Type.String}
        "flag_short" -> [Type]{Type.String, Type.String, Type.String}
        "option" | "option_int" | "option_float" | "repeat" | "required_option" -> [Type]{Type.String, Type.String, Type.String}
        "option_short" | "option_default" | "option_env" | "option_choice" -> [Type]{Type.String, Type.String, Type.String, Type.String}
        "description" | "version" | "completion" -> [Type]{Type.String}
        "subcommand" -> [Type]{Type.String, Type.String, sema_process_named("ArgsSpec")}
        "parse" | "parse_or_exit" -> [Type]{Type.List{element: Type.String}}
        else -> [Type]{}
    }
}

fn sema_process_parsed_args_arg_types(method: String) -> [Type] Never! {
    if method == "positional" -> return [Type]{Type.Int}
    if method == "flag" || method == "option" || method == "option_int" || method == "option_float" || method == "options" -> return [Type]{Type.String}
    [Type]{}
}

fn sema_process_method_params(args: [CallArg], required: [Type], moving: [Bool]) -> [SemaCallParam] Never! {
    params := [SemaCallParam]{}
    loop index in 0..<args.len() {
        param_type :: if index < required.len() -> Val(required[index]) else -> None
        convention :: if index < moving.len() && moving[index] -> AccessConvention.Move else -> AccessConvention.Read
        &params.push(SemaCallParam{
            label: "arg{index}",
            name: "arg{index}",
            zone: ParamZone.PositionalOnly,
            default: None,
            default_ref: None,
            convention: convention,
            ty: param_type,
            variadic: false,
        })
    }
    params
}

fn sema_process_check_method_ownership(receiver: Expr, method: String, args: [CallArg], required: [Type], moving: [Bool], receiver_access: AccessConvention, span: Span, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> Bool {
    params := sema_process_method_params(args, required, moving)
    ownership := sema_ownership_check_method_call(&state, method, receiver, receiver_access, params, &args, scopes, span, &diagnostics)
    ownership.accepted && ownership.complete
}

fn sema_process_failure_carrier(result: Type) -> TFailureCarrier Never! {
    if result == {
        .Result(ok, err) -> TFailureCarrier.Result{success: ok, error: err}
        .Option(inner) -> TFailureCarrier.Optional{value: inner}
        .Named(name) -> {
            if name == "Never" -> TFailureCarrier.Diverges{value: result} else -> TFailureCarrier.Infallible
        }
        else -> TFailureCarrier.Infallible
    }
}

fn sema_process_record_intrinsic(result: Type, effect_name: String, api: String, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool Never! {
    effects := [EffectRowEntry]{}
    if effect_name != "" -> &effects.push(EffectRowEntry{name: effect_name, span: span})
    facts := SemaCallFacts{
        return_type: result,
        failure_carrier: sema_process_failure_carrier(result),
        effect_bound: Val(effects),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(environment, &scopes, &context, api, span, facts, &diagnostics)
}

fn sema_process_finish(receiver: TExpr, operation: THandleOp, args: [TExpr], result: Type, effect_name: String, api: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    if !sema_process_record_intrinsic(result, effect_name, api, span, environment, &scopes, &context, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tir_expr(result, TExprKind.HandleMethod{receiver: receiver, operation: operation, args: args}, span)
    checked := sema_expr_expected(value, expected, environment, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

fn sema_process_args_spec_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    operation :: sema_process_args_spec_op(method) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    result :: sema_process_args_spec_result(method) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    required_arity :: sema_process_args_spec_arity(method) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != required_arity {
        sema_process_wrong_arity(method, required_arity, args.len(), span, &diagnostics)
        if sema_process_args_spec_wrong_arity(method, args.len(), span) == .Val(diagnostic) {
            _ := &diagnostics.pop()
            &diagnostics.push(diagnostic)
        }
        sema_process_infer_args(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    required := sema_process_args_spec_arg_types(method)
    values :: sema_process_check_args(args, required, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    receiver_access :: if method == "help" || method == "completion" || method == "parse" || method == "parse_or_exit" -> AccessConvention.Read else -> AccessConvention.Move
    moving_args :: if method == "subcommand" -> [Bool]{false, false, true} else -> [Bool]{}
    if !sema_process_check_method_ownership(receiver, "ArgsSpec.{method}", args, required, moving_args, receiver_access, span, scopes, state, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    sema_process_finish(receiver_value, operation, values, result, "Env", "ArgsSpec.{method}", span, expected, environment, &scopes, &context, &diagnostics)
}

fn sema_process_parsed_args_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    result :: sema_process_parsed_args_result(method) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    required_arity :: sema_process_parsed_args_arity(method) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != required_arity {
        if sema_process_parsed_args_wrong_arity(method, args.len(), span) == .Val(diagnostic) -> &diagnostics.push(diagnostic)
        sema_process_infer_args(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    required := sema_process_parsed_args_arg_types(method)
    values :: sema_process_check_args(args, required, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_process_check_method_ownership(receiver, "ParsedArgs.{method}", args, required, [Bool]{}, AccessConvention.Read, span, scopes, state, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    operation :: if method == {
        "flag" -> THandleOp.ParsedArgsFlag
        "option" -> THandleOp.ParsedArgsOption
        "option_int" -> THandleOp.ParsedArgsOptionInt
        "option_float" -> THandleOp.ParsedArgsOptionFloat
        "options" -> THandleOp.ParsedArgsOptions
        "positional" -> THandleOp.ParsedArgsPositional
        else -> THandleOp.ParsedArgsSubcommand
    }
    sema_process_finish(receiver_value, operation, values, result, "Env", "ParsedArgs.{method}", span, expected, environment, &scopes, &context, &diagnostics)
}

fn sema_process_spec_known_method(method: String) -> Bool Never! {
    method == "cwd" || method == "env_remove" || method == "stdin" || method == "stdout" || method == "stderr" || method == "env" || method == "arg" || method == "args_extend" || method == "terminal" || method == "env_clear" || method == "detached" || method == "abilities" || method == "timeout" || method == "cpu_time_limit" || method == "output_limit" || method == "memory_limit" || method == "open_file_limit" || method == "under" || method == "plan" || method == "run" || method == "run_checked" || method == "spawn"
}

fn sema_process_spec_result(method: String, argc: Int, span: Span, diagnostics: &[Diagnostic]) -> Type? {
    spec := sema_process_named("ProcessSpec")
    if method == {
        "cwd" | "env_remove" | "stdin" | "stdout" | "stderr" -> {
            if argc == 1 -> return Val(spec)
        }
        "env" -> {
            if argc == 2 -> return Val(spec)
        }
        "arg" | "args_extend" -> {
            if argc == 1 -> return Val(spec)
        }
        "terminal" -> {
            if argc == 0 || argc == 1 -> return Val(spec)
        }
        "env_clear" | "detached" -> {
            if argc == 0 -> return Val(spec)
        }
        "abilities" -> {
            if argc == 0 -> return Val(Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.TerminalFactSet}, inner: Type.Apply{name: "Set", args: [Type]{Type.String}}})
        }
        "timeout" | "cpu_time_limit" | "output_limit" | "memory_limit" | "open_file_limit" -> {
            if argc == 1 -> return Val(spec)
        }
        "under" -> {
            if argc == 1 -> return Val(spec)
        }
        "plan" -> {
            if argc == 0 -> return Val(sema_process_io_result(sema_process_named("ProcessPlan")))
        }
        "run" | "run_checked" -> {
            if argc == 0 -> return Val(sema_process_io_result(sema_process_named("ProcessReceipt")))
        }
        "spawn" -> {
            if argc == 0 -> return Val(sema_process_io_result(sema_process_named("ProcessChild")))
        }
        else -> {}
    }
    if !sema_process_spec_known_method(method) -> return None
    if {
        method == "terminal" -> {
            &diagnostics.push(sema_error("E0104", span, "`terminal` expects 0 or 1 arguments, got {argc}", "`terminal()` uses portable defaults; `terminal(policy)` uses one TerminalPolicy", "pass no argument or one TerminalPolicy"))
        }
        method == "env" -> {
            sema_process_wrong_arity(method, 2, argc, span, &diagnostics)
        }
        method == "arg" || method == "args_extend" || method == "under" -> {
            sema_process_wrong_arity(method, 1, argc, span, &diagnostics)
        }
        method == "cwd" || method == "env_remove" || method == "stdin" || method == "stdout" || method == "stderr" || method == "timeout" || method == "cpu_time_limit" || method == "output_limit" || method == "memory_limit" || method == "open_file_limit" -> {
            sema_process_wrong_arity(method, 1, argc, span, &diagnostics)
        }
        else -> {
            sema_process_wrong_arity(method, 0, argc, span, &diagnostics)
        }
    }
    None
}

fn sema_process_spec_arg_types(method: String, argc: Int) -> [Type] Never! {
    return if method == {
        "cwd" | "env_remove" | "arg" -> [Type]{Type.String}
        "args_extend" -> [Type]{Type.List{element: Type.String}}
        "stdin" | "stdout" | "stderr" -> [Type]{sema_process_named("ProcessStreamMode")}
        "env" -> [Type]{Type.String, Type.String}
        "timeout" | "cpu_time_limit" -> [Type]{sema_process_named("Duration")}
        "output_limit" | "memory_limit" | "open_file_limit" -> [Type]{Type.Int}
        "under" -> [Type]{sema_process_named("Authority")}
        "terminal" -> {
            if argc == 1 -> [Type]{sema_process_named("TerminalPolicy")} else -> [Type]{}
        }
        else -> [Type]{}
    }
}

fn sema_process_spec_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    result :: sema_process_spec_result(method, args.len(), span, &diagnostics) ?? {
        if !sema_process_spec_known_method(method) -> return SemaMethodSpecialCheck{handled: false, value: None}
        sema_process_infer_args(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    required :: sema_process_spec_arg_types(method, args.len())
    values :: sema_process_check_args(args, required, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    known_mutating :: method != "abilities" && method != "plan" && method != "run" && method != "run_checked" && method != "spawn"
    receiver_access :: if known_mutating -> AccessConvention.Move else -> AccessConvention.Read
    if !sema_process_check_method_ownership(receiver, "ProcessSpec.{method}", args, required, [Bool]{}, receiver_access, span, scopes, state, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    effect_name :: if method == "run" || method == "run_checked" || method == "spawn" -> "Exec" else -> ""
    sema_process_finish(receiver_value, THandleOp.ProcessSpecMethod{method: method, args_len: args.len()}, values, result, effect_name, "ProcessSpec.{method}", span, expected, environment, &scopes, &context, &diagnostics)
}

fn sema_process_child_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    result :: if method == {
        "id" -> {
            if args.len() == 0 -> Val(Type.Int) else -> None
        }
        "wait" -> {
            if args.len() == 0 -> Val(sema_process_io_result(sema_process_named("ProcessReceipt"))) else -> None
        }
        "exited" -> {
            if args.len() == 0 -> Val(sema_process_io_result(Type.Bool)) else -> None
        }
        "kill" | "terminate" | "interrupt" -> {
            if args.len() == 0 -> Val(sema_process_io_result(Type.Named{name: "Unit"})) else -> None
        }
        else -> None
    }
    known :: method == "id" || method == "wait" || method == "exited" || method == "kill" || method == "terminate" || method == "interrupt"
    if !known -> return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 0 {
        sema_process_wrong_arity(method, 0, args.len(), span, &diagnostics)
        sema_process_infer_args(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    result_ty :: result ?? Type.Named{name: "Unit"}
    effect_name :: if method == "id" -> "" else -> "Exec"
    sema_process_finish(receiver_value, THandleOp.ProcessChildMethod{method: method}, [TExpr]{}, result_ty, effect_name, "ProcessChild.{method}", span, expected, environment, &scopes, &context, &diagnostics)
}

fn sema_process_terminal_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "resize" -> return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 1 {
        sema_process_wrong_arity(method, 1, args.len(), span, &diagnostics)
        sema_process_infer_args(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    required := [Type]{sema_process_named("TerminalSize")}
    values :: sema_process_check_args(args, required, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_process_check_method_ownership(receiver, "TerminalSession.resize", args, required, [Bool]{}, AccessConvention.Read, span, scopes, state, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    sema_process_finish(receiver_value, THandleOp.TerminalSessionResize, values, sema_process_io_result(Type.Named{name: "Unit"}), "IO", "TerminalSession.resize", span, expected, environment, &scopes, &context, &diagnostics)
}

fn sema_process_stdin_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    result :: if method == {
        "write" -> {
            if args.len() == 1 -> Val(sema_process_io_result(Type.Named{name: "Unit"})) else -> None
        }
        "close" -> {
            if args.len() == 0 -> Val(Type.Named{name: "Unit"}) else -> None
        }
        else -> None
    }
    if method != "write" && method != "close" -> return SemaMethodSpecialCheck{handled: false, value: None}
    required_arity :: if method == "write" -> 1 else -> 0
    if args.len() != required_arity {
        sema_process_wrong_arity(method, required_arity, args.len(), span, &diagnostics)
        sema_process_infer_args(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    required :: if method == "write" -> [Type]{Type.String} else -> [Type]{}
    values :: sema_process_check_args(args, required, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_process_check_method_ownership(receiver, "ProcessStdin.{method}", args, required, [Bool]{}, AccessConvention.Read, span, scopes, state, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    operation :: if method == "write" -> THandleOp.ProcessStdinWrite else -> THandleOp.ProcessStdinClose
    sema_process_finish(receiver_value, operation, values, result ?? Type.Named{name: "Unit"}, "Exec", "ProcessStdin.{method}", span, expected, environment, &scopes, &context, &diagnostics)
}

fn sema_process_stream_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "lines" -> return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 0 {
        sema_process_wrong_arity(method, 0, args.len(), span, &diagnostics)
        sema_process_infer_args(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    stream_name := sema_process_handle_receiver_name(receiver_value.ty)
    api := "{stream_name}.lines"
    if !sema_process_check_method_ownership(receiver, api, args, [Type]{}, [Bool]{}, AccessConvention.Read, span, scopes, state, diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    sema_process_finish(receiver_value, THandleOp.Method{name: "lines"}, [TExpr]{}, sema_process_named("ProcessLines"), "Exec", api, span, expected, environment, &scopes, &context, &diagnostics)
}

// Projects the public ProcessChild handle fields using the compiler's builtin
// nominal/field identity, so Places can share the ordinary TField path.
pub fn sema_process_child_field(base: TExpr, member: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if sema_process_handle_receiver_name(base.ty) != "ProcessChild" -> return None
    field_ty :: if member == {
        "stdin" -> Val(sema_process_named("ProcessStdin"))
        "stdout" -> Val(sema_process_named("ProcessStdoutStream"))
        "stderr" -> Val(sema_process_named("ProcessStderrStream"))
        "terminal" -> Val(Type.Option{inner: sema_process_named("TerminalSession")})
        else -> None
    } ?? return None
    owner := symbol_id(SymbolKind.Type, "", "", "ProcessChild")
    field_id := symbol_id(SymbolKind.Field, "", owner.key, member)
    field_symbol := Symbol{id: field_id, kind: SymbolKind.Field, name: member, module_name: "", owner: Val(owner.key), span: span, ty: Val(field_ty), visibility: 2}
    &context.name_references.push(SemaNameReferenceFact{span: span, symbol: field_symbol, kind: "field"})
    reference := TFieldRef{owner: Val(owner), field: field_id, name: member, ty: field_ty, boxed: false}
    value := sema_tir_expr(field_ty, TExprKind.Field{receiver: base, field: reference}, span)
    sema_expr_expected(value, expected, environment, &diagnostics)
}

pub fn sema_call_try_process_handle_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    receiver_name :: sema_process_handle_receiver_name(receiver_value.ty)
    if receiver_name == "ArgsSpec" -> return sema_process_args_spec_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if receiver_name == "ParsedArgs" -> return sema_process_parsed_args_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if receiver_name == "ProcessSpec" -> return sema_process_spec_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if receiver_name == "ProcessChild" -> return sema_process_child_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if receiver_name == "TerminalSession" -> return sema_process_terminal_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if receiver_name == "ProcessStdin" -> return sema_process_stdin_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    if receiver_name == "ProcessStdoutStream" || receiver_name == "ProcessStderrStream" -> return sema_process_stream_method(receiver, receiver_value, method, args, span, expected, environment, &scopes, &state, &tail_store, &context, &diagnostics)
    SemaMethodSpecialCheck{handled: false, value: None}
}
