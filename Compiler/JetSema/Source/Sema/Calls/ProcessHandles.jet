// Checked process handle methods. The caller supplies a checked receiver;
// this module owns only these compiler-provided handle contracts.
use jet_foundation.[
    BodyHandleOp,
    AST_NODE_GENERATED,
    AccessConvention,
    CORE_BUILTINS_MODULE,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    InternalTag,
    ParamZone,
    Span,
    TFailureCarrier,
    TagMarker,
    Type,
    core_call,
    expr_span,
]

sema_process_named: fn(name: String) -> Type Never! { Type.Named{name: name} }

// The Core types this module types itself that Core declares nowhere and
// exports from no module: the spawned child, its plan, streams and line
// reader, and the terminal policy and session. Copy and sendability
// judgments know them as Core types.
sema_process_handle_type: fn(name: String) -> Bool Never! {
    if name == {
        "ProcessChild" | "ProcessPlan" | "ProcessStdin" | "ProcessStdoutStream" | "ProcessStderrStream" | "ProcessLines" | "TerminalPolicy" | "TerminalSize" | "TerminalSession" -> true
        else -> false
    }
}

sema_process_result: fn(ok: Type, err: Type) -> Type Never! { Type.Result{ok: ok, err: err} }

sema_process_io_result: fn(ok: Type) -> Type Never! {
    sema_process_result(ok, Type.Named{name: "IOError"})
}

sema_process_infer_args: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) Never! {
    loop argument in args {
        _ := sema_check_expression(argument.expr, None, environment, program, check)
    }
}

sema_process_wrong_arity: fn(method: String, expected: Int, actual: Int, span: Span, diagnostics: ^[Diagnostic]) {
    diagnostics.push(sema_call_core_arity_diagnostic(method, expected, actual, span))
}

sema_process_check_args: fn(args: [CallArg], required: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> [TExpr]? {
    if args.len() != required.len() -> return None
    values := [TExpr]{}
    loop index in 0..<args.len() {
        value: sema_check_expression(args[index].expr, Val(required[index]), environment, program, check) ?? return None
        values.push(value)
    }
    Val(values)
}

sema_process_handle_receiver_name: fn(ty: Type) -> String Never! {
    if ty == {
        .Named(name) -> name
        .Tagged(_, inner) -> sema_process_handle_receiver_name(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> ""
    }
}

sema_process_method_params: fn(args: [CallArg], required: [Type], moving: [Bool]) -> [SemaCallParam] Never! {
    params := [SemaCallParam]{}
    loop index in 0..<args.len() {
        param_type: if index < required.len() -> Val(required[index]) else -> None
        convention: if index < moving.len() && moving[index] -> AccessConvention.Move else -> AccessConvention.Read
        params.push(
            SemaCallParam{
                label: "arg{index}",
                name: "arg{index}",
                zone: ParamZone.PositionalOnly,
                default: None,
                default_ref: None,
                convention: convention,
                ty: param_type,
                variadic: false,
            },
        )
    }
    params
}

sema_process_check_method_ownership: fn(receiver: Expr, method: String, args: [CallArg], required: [Type], moving: [Bool], receiver_access: AccessConvention, span: Span, scopes: ^SemaScopeTable, state: ^SemaOwnershipState, diagnostics: ^[Diagnostic]) -> Bool {
    updated_args := args
    params := sema_process_method_params(updated_args, required, moving)
    ownership := sema_ownership_check_method_call(state, method, receiver, receiver_access, params, updated_args, scopes, span, diagnostics)
    ownership.accepted && ownership.complete
}

sema_process_failure_carrier: fn(result: Type) -> TFailureCarrier Never! {
    if result == {
        // copy: `ok` and `err` are payloads of read parameter `result`, which keeps the originals; the new TFailureCarrier.Result's fields own `ok` and `err`
        .Result(ok, err) -> TFailureCarrier.Result{success: ok.copy(), error: err.copy()}
        // copy: `inner` is a payload of read parameter `result`, which keeps the original; field `value` of the new TFailureCarrier.Optional owns this one
        .Option(inner) -> TFailureCarrier.Optional{value: inner.copy()}
        .Named(name) -> if name == "Never" -> TFailureCarrier.Diverges{value: result} else -> TFailureCarrier.Infallible
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> TFailureCarrier.Infallible
    }
}

sema_process_record_intrinsic: fn(result: Type, effect_name: String, api: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> Bool Never! {
    effects := [EffectRowEntry]{}
    if effect_name != "" -> effects.push(EffectRowEntry{name: effect_name, span: span})
    facts := SemaCallFacts{
        return_type: result,
        failure_carrier: sema_process_failure_carrier(result),
        effect_bound: Val(effects),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(environment, program, scopes, context, api, span, facts, diagnostics)
}

sema_process_finish: fn(receiver: TExpr, operation: BodyHandleOp, args: [TExpr], result: Type, effect_name: String, api: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: ^SemaScopeTable, context: ^SemaCheckContext, diagnostics: ^[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    if !sema_process_record_intrinsic(result, effect_name, api, span, environment, program, scopes, context, diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    value := sema_tree_node(result, TExprKind.HandleMethod{receiver: receiver, operation: operation, args: args}, span)
    // A call checker's finish: under the dispatcher's success view a
    // `ProcessReceipt IOError!` result meets a `ProcessReceipt` expectation by
    // its success side, and the call root then propagates the failure.
    checked := sema_expression_call_expected(value, expected, environment, program, context, diagnostics)
    SemaMethodSpecialCheck{handled: true, value: checked}
}

sema_process_spec_known_method: fn(method: String) -> Bool Never! {
    method == "cwd" || method == "env_remove" || method == "stdin" || method == "stdout" || method == "stderr" || method == "env" || method == "arg" || method == "args_extend" || method == "terminal" || method == "env_clear" || method == "detached" || method == "abilities" || method == "keep_open" || method == "timeout" || method == "cpu_time_limit" || method == "output_limit" || method == "memory_limit" || method == "memory_scope" || method == "open_file_limit" || method == "cpu_affinity" || method == "io_priority" || method == "io_idle" || method == "under" || method == "plan" || method == "run" || method == "run_checked" || method == "spawn"
}

sema_process_spec_result: fn(method: String, argc: Int, span: Span, diagnostics: ^[Diagnostic]) -> Type? {
    spec := sema_process_named("ProcessSpec")
    if method == {
        "cwd" | "env_remove" | "stdin" | "stdout" | "stderr" -> {
            if argc == 1 -> return Val(spec)
        }
        "env" -> {
            if argc == 2 -> return Val(spec)
        }
        "arg" | "args_extend" -> {
            if argc == 1 -> return Val(spec)
        }
        "terminal" -> {
            if argc == 0 || argc == 1 -> return Val(spec)
        }
        "env_clear" | "detached" | "io_idle" -> {
            if argc == 0 -> return Val(spec)
        }
        "abilities" -> {
            if argc == 0 {
                return Val(Type.Tagged{marker: TagMarker.Internal{internal_tag: InternalTag.TerminalFactSet}, inner: Type.Apply{name: "Set", args: [Type]{Type.String}}})
            }
        }
        "keep_open" -> {
            if argc == 1 || argc == 2 -> return Val(spec)
        }
        "timeout" | "cpu_time_limit" | "output_limit" | "memory_limit" | "memory_scope" | "open_file_limit" | "cpu_affinity" | "io_priority" -> {
            if argc == 1 -> return Val(spec)
        }
        "under" -> {
            if argc == 1 -> return Val(spec)
        }
        "plan" -> {
            if argc == 0 -> return Val(sema_process_io_result(sema_process_named("ProcessPlan")))
        }
        "run" | "run_checked" -> {
            if argc == 0 -> return Val(sema_process_io_result(sema_process_named("ProcessReceipt")))
        }
        "spawn" -> {
            if argc == 0 -> return Val(sema_process_io_result(sema_process_named("ProcessChild")))
        }
        else -> {}
    }
    if !sema_process_spec_known_method(method) -> return None
    if {
        method == "terminal" -> {
            diagnostics.push(sema_error("E0104", span, "`terminal` expects 0 or 1 arguments, got {argc}", "`terminal()` uses portable defaults; `terminal(policy)` uses one TerminalPolicy", "pass no argument or one TerminalPolicy"))
        }
        method == "keep_open" -> {
            diagnostics.push(sema_error("E0104", span, "`keep_open` expects 1 or 2 arguments, got {argc}", "`keep_open(handle)` keeps the handle at its own descriptor number; `keep_open(handle, at: slot)` keeps it at `slot`", "pass the handle, then optionally `at:` and a descriptor slot"))
        }
        method == "env" -> { sema_process_wrong_arity(method, 2, argc, span, diagnostics) }
        method == "arg" || method == "args_extend" || method == "under" -> {
            sema_process_wrong_arity(method, 1, argc, span, diagnostics)
        }
        method == "cwd" || method == "env_remove" || method == "stdin" || method == "stdout" || method == "stderr" || method == "timeout" || method == "cpu_time_limit" || method == "output_limit" || method == "memory_limit" || method == "memory_scope" || method == "open_file_limit" || method == "cpu_affinity" || method == "io_priority" -> {
            sema_process_wrong_arity(method, 1, argc, span, diagnostics)
        }
        else -> { sema_process_wrong_arity(method, 0, argc, span, diagnostics) }
    }
    None
}

sema_process_spec_arg_types: fn(method: String, argc: Int) -> [Type] Never! {
    return if method == {
        "cwd" | "env_remove" | "arg" -> [Type]{Type.String}
        "args_extend" -> [Type]{Type.List{element: Type.String}}
        "stdin" | "stdout" | "stderr" -> [Type]{sema_process_named("ProcessStreamMode")}
        "env" -> [Type]{Type.String, Type.String}
        "timeout" | "cpu_time_limit" -> [Type]{sema_process_named("Duration")}
        "output_limit" | "memory_limit" | "memory_scope" | "open_file_limit" | "io_priority" -> [Type]{Type.Int}
        "cpu_affinity" -> [Type]{Type.List{element: Type.Int}}
        "under" -> [Type]{sema_process_named("Authority")}
        "terminal" -> if argc == 1 -> [Type]{sema_process_named("TerminalPolicy")} else -> [Type]{}
        else -> [Type]{}
    }
}

sema_process_spec_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    result: sema_process_spec_result(method, args.len(), span, check.diagnostics) ?? {
        if !sema_process_spec_known_method(method) {
            return SemaMethodSpecialCheck{handled: false, value: None}
        }
        sema_process_infer_args(args, environment, program, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    // `spec.keep_open(handle, at:)` is the ordinary Core source body
    // `core.files.__spec_keep_open`; its declaration types the handle union
    // and the slot, and the spec takes the handle.
    if method == "keep_open" {
        return sema_process_spec_keep_open(receiver, receiver_value, args, result, span, expected, environment, program, check)
    }
    required: sema_process_spec_arg_types(method, args.len())
    values: sema_process_check_args(args, required, environment, program, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    // ProcessSpec builders are typed with no receiver convention and no
    // recorded move: a builder on a named spec read again later
    // (`clean.env(…).run()` in a loop) is no E0121.
    // The spec still moves like an unmarked owning position, so a later use
    // turns the move into a share and a borrowed parameter keeps its value.
    known_mutating: method != "abilities" && method != "plan" && method != "run" && method != "run_checked" && method != "spawn"
    if !sema_process_check_method_ownership(receiver, "ProcessSpec.{method}", args, required, [Bool]{}, AccessConvention.Read, span, check.scopes, check.state, check.diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    sema_receiver_mark_forget(check.state, receiver)
    if known_mutating && receiver == .Ident(_, _, _) {
        if !sema_ownership_mark_unmarked_move(check.state, receiver, check.scopes, "`ProcessSpec.{method}`", check.diagnostics) {
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
    }
    // The stream routes and the Duration limits are still the host leaves
    // `jet_builtins.process_spec_<method>`: their Core call facts name the
    // effects and their row names the runtime export every tier runs.
    if method == "stdin" || method == "stdout" || method == "stderr" || method == "timeout" || method == "cpu_time_limit" {
        rejected: SemaMethodSpecialCheck{handled: true, value: None}
        record: core_call(CORE_BUILTINS_MODULE, "process_spec_{method}") ?? {
            check.diagnostics.push(sema_error("E0003", span, "`ProcessSpec.{method}` has no host leaf `jet_builtins.process_spec_{method}`", "this ProcessSpec builder lowers onto its jet_builtins host leaf row", "restore the `process_spec_{method}` row in Compiler/Prelude/Core.rows"))
            return rejected
        }
        fallibility: sema_expression_failure_carrier(result)
        if !sema_call_core_record_effects_as(record, "ProcessSpec.{method}", span, [Type]{}, result, fallibility, [FunctionDefaultRef]{}, check.scopes, check.context, environment, program, check.diagnostics) {
            return rejected
        }
        call_args := [TExpr]{receiver_value}
        widen := [Bool]{false}
        loop argument in values {
            call_args.push(argument)
            widen.push(false)
        }
        value: sema_call_core_tree(record, call_args, span, [Type]{}, widen, result, fallibility, None, environment, program, check.diagnostics) ?? return rejected
        return SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(value, expected, environment, program, check.context, check.diagnostics)}
    }
    // Every other method is the ordinary Core source body that fills its
    // jet_builtins role (sema_process_spec_role; `abilities` reports the
    // checked TerminalFact set), so every tier runs the same Jet code.
    effect: if method == "run" || method == "run_checked" || method == "spawn" -> "Exec" else -> ""
    call_args := [TExpr]{receiver_value}
    loop argument in values -> call_args.push(argument)
    sema_process_source_call(sema_process_spec_role(method, args.len()), "ProcessSpec.{method}", effect, call_args, result, span, expected, environment, program, check)
}

// The jet_builtins role of the Core body a ProcessSpec method other than
// the stream routes and Duration limits calls, given its argument count
// (`terminal(policy)` fills ProcessSpecTerminalWithPolicy); "" for no such
// method.
sema_process_spec_role: fn(method: String, argc: Int) -> String Never! {
    if method == {
        "abilities" -> "ProcessSpecAbilities"
        "cwd" -> "ProcessSpecCwd"
        "arg" -> "ProcessSpecArg"
        "args_extend" -> "ProcessSpecArgsExtend"
        "env" -> "ProcessSpecEnv"
        "env_remove" -> "ProcessSpecEnvRemove"
        "env_clear" -> "ProcessSpecEnvClear"
        "output_limit" -> "ProcessSpecOutputLimit"
        "memory_limit" -> "ProcessSpecMemoryLimit"
        "memory_scope" -> "ProcessSpecMemoryScope"
        "open_file_limit" -> "ProcessSpecOpenFileLimit"
        "cpu_affinity" -> "ProcessSpecCPUAffinity"
        "io_priority" -> "ProcessSpecIOPriority"
        "io_idle" -> "ProcessSpecIOIdle"
        "detached" -> "ProcessSpecDetached"
        "terminal" -> if argc == 1 -> "ProcessSpecTerminalWithPolicy" else -> "ProcessSpecTerminal"
        "under" -> "ProcessSpecUnder"
        "plan" -> "ProcessSpecPlan"
        "run" -> "ProcessSpecRun"
        "run_checked" -> "ProcessSpecRunChecked"
        "spawn" -> "ProcessSpecSpawn"
        else -> ""
    }
}

// `api` as a call of the Core source body that fills `role` on `args` (the
// receiver first), typed `result`, with the effect `effect_name` (none when
// empty). The compiler finds the body by its role, never by its name.
sema_process_source_call: fn(role: String, api: String, effect_name: String, args: [TExpr], result: Type, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_process_record_intrinsic(result, effect_name, api, span, environment, program, check.scopes, check.context, check.diagnostics) {
        return rejected
    }
    filler: sema_core_role_function(program.registration_graph, role) ?? {
        check.diagnostics.push(sema_missing_core_role(role, span))
        return rejected
    }
    target: sema_call_core_source_target(environment, program, filler.module_identity, filler.name, [Type]{}, span, true, check.diagnostics) ?? {
        check.context.incomplete_reasons.push("{api} must resolve its canonical Jet source body")
        return rejected
    }
    callee: sema_call_callee_decl(program, target.symbol.id, span, check.diagnostics) ?? return rejected
    call_args := [TCallArg]{}
    loop argument in args -> call_args.push(sema_value_method_source_arg(argument))
    value: sema_tree_node(result, TExprKind.Call{callee: callee, type_args: [Type]{}, args: call_args}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(value, expected, environment, program, check.context, check.diagnostics)}
}

sema_process_spec_keep_open: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], result: Type, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    loop (index, argument) in args {
        if argument.label == .Val(label) {
            if index == 1 && label.name == "at" -> next
            check.diagnostics.push(sema_error("E0764", label.span, "`ProcessSpec.keep_open` has no parameter labeled `{label.name}`", "a label binds an argument to the parameter of that name", "pass the handle without a label, then the slot as `at:`"))
            sema_process_infer_args(args, environment, program, check)
            return rejected
        }
    }
    route: sema_call_core_resolve_route(environment, program, "core.files", "__spec_keep_open", [Type]{}, 3, false, span, check.diagnostics) ?? return rejected
    target: if route == {
        .Source(source) -> source
        .Core(_) | .SharedSite(_) -> {
            check.context.incomplete_reasons.push("ProcessSpec.keep_open must resolve its canonical Jet source body")
            return rejected
        }
    }
    params: if target.signature == {
        .Fn(params, _, _, _, _, _) -> params
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            check.context.incomplete_reasons.push("ProcessSpec.keep_open's source body has a function type")
            return rejected
        }
    }
    handle_type: sema_call_resolved_type(params[1], environment, program)
    slot_type: sema_call_resolved_type(params[2], environment, program)
    handle_checked: sema_check_expression(args[0].expr, Val(handle_type), environment, program, check) ?? return rejected
    handle_value: sema_expr_expected_owned(handle_checked, Val(handle_type), environment, program, check.diagnostics) ?? return rejected
    // An omitted slot is the declaration's `None`: the handle's own number.
    slot_expr: if args.len() == 2 -> args[1].expr else -> Expr.Absent{span: span, id: AST_NODE_GENERATED}
    slot_checked: sema_check_expression(slot_expr, Val(slot_type), environment, program, check) ?? return rejected
    slot_value: sema_expr_expected_owned(slot_checked, Val(slot_type), environment, program, check.diagnostics) ?? return rejected
    // The handle moves into the spec exactly as at any `^^` parameter: a
    // named handle is taken out of its place, so its scope no longer closes it.
    taken := sema_call_marked_move_place(args[0].expr, handle_value)
    if taken && sema_ownership_binding_for_expr(check.state, args[0].expr, check.scopes) == .Val(root) {
        taken = !sema_ownership_binding_is_borrowed_param(root)
    }
    stored: sema_call_marked_move_value(check.state, taken, args[0].expr, handle_value, check.scopes, check.diagnostics) ?? return rejected
    if !sema_process_check_method_ownership(receiver, "ProcessSpec.keep_open", args, [Type]{handle_type, slot_type}, [Bool]{true, false}, AccessConvention.Read, span, check.scopes, check.state, check.diagnostics) {
        return rejected
    }
    sema_receiver_mark_forget(check.state, receiver)
    if receiver == .Ident(_, _, _) {
        if !sema_ownership_mark_unmarked_move(check.state, receiver, check.scopes, "`ProcessSpec.keep_open`", check.diagnostics) {
            return rejected
        }
    }
    if !sema_process_record_intrinsic(result, "FS", "ProcessSpec.keep_open", span, environment, program, check.scopes, check.context, check.diagnostics) {
        return rejected
    }
    callee: sema_call_callee_decl(program, target.symbol.id, span, check.diagnostics) ?? return rejected
    handle_arg := sema_value_method_source_arg(stored)
    handle_arg.widen_to_union = sema_call_widen_union(handle_type, stored.ty)
    value := sema_tree_node(result, TExprKind.Call{callee: callee, type_args: [Type]{}, args: [TCallArg]{sema_value_method_source_arg(receiver_value), handle_arg, sema_value_method_source_arg(slot_value)}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(value, expected, environment, program, check.context, check.diagnostics)}
}

// The result of a child's method (`child.wait()` and the rest); None for a
// name that is not one of them.
sema_process_child_result: fn(method: String) -> Type? Never! {
    if method == {
        "id" -> Val(Type.Int)
        "wait" -> Val(sema_process_io_result(sema_process_named("ProcessReceipt")))
        "exited" -> Val(sema_process_io_result(Type.Bool))
        "kill" | "terminate" | "interrupt" -> Val(sema_process_io_result(sema_process_named("Unit")))
        else -> None
    }
}

// A child's methods are the ordinary Core source bodies that fill their
// jet_builtins roles (sema_process_child_role), which read the child; every
// one but `id` is an Exec step.
sema_process_child_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    result: sema_process_child_result(method) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 0 {
        sema_process_wrong_arity(method, 0, args.len(), span, check.diagnostics)
        sema_process_infer_args(args, environment, program, check)
        return rejected
    }
    if !sema_ownership_check_call_receiver(check.state, receiver, AccessConvention.Read, check.scopes, span, check.diagnostics) {
        return rejected
    }
    effect: if method == "id" -> "" else -> "Exec"
    sema_process_source_call(sema_process_child_role(method), "ProcessChild.{method}", effect, [TExpr]{receiver_value}, result, span, expected, environment, program, check)
}

// The jet_builtins role of the Core body a ProcessChild method calls; "" for
// no such method.
sema_process_child_role: fn(method: String) -> String Never! {
    if method == {
        "id" -> "ProcessChildID"
        "wait" -> "ProcessChildWait"
        "exited" -> "ProcessChildExited"
        "kill" -> "ProcessChildKill"
        "terminate" -> "ProcessChildTerminate"
        "interrupt" -> "ProcessChildInterrupt"
        else -> ""
    }
}

sema_process_terminal_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if method != "resize" -> return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 1 {
        sema_process_wrong_arity(method, 1, args.len(), span, check.diagnostics)
        sema_process_infer_args(args, environment, program, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    required := [Type]{sema_process_named("TerminalSize")}
    values: sema_process_check_args(args, required, environment, program, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_process_check_method_ownership(receiver, "TerminalSession.resize", args, required, [Bool]{}, AccessConvention.Read, span, check.scopes, check.state, check.diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    sema_process_finish(receiver_value, BodyHandleOp.TerminalSessionResize, values, sema_process_io_result(Type.Named{name: "Unit"}), "IO", "TerminalSession.resize", span, expected, environment, program, check.scopes, check.context, check.diagnostics)
}

sema_process_stdin_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    // `write(text)` and `write_bytes(bytes)` write every byte; `write_some(bytes)`
    // is one partial write that reports the count taken.
    if method != "write" && method != "write_some" && method != "write_bytes" && method != "close" {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    required_arity: if method == "close" -> 0 else -> 1
    if args.len() != required_arity {
        sema_process_wrong_arity(method, required_arity, args.len(), span, check.diagnostics)
        sema_process_infer_args(args, environment, program, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if method == "write" && sema_process_byte_write(args, environment, program, check) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    required: if method == {
        "write" -> [Type]{Type.String}
        "write_some" | "write_bytes" -> [Type]{Type.List{element: Type.IntN{signed: false, bits: 8}}}
        else -> [Type]{}
    }
    values: sema_process_check_args(args, required, environment, program, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_process_check_method_ownership(receiver, "ProcessStdin.{method}", args, required, [Bool]{}, AccessConvention.Read, span, check.scopes, check.state, check.diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    result: if method == {
        "write_some" -> sema_process_io_result(Type.Int)
        "close" -> Type.Named{name: "Unit"}
        else -> sema_process_io_result(Type.Named{name: "Unit"})
    }
    operation: if method == {
        "write" -> BodyHandleOp.ProcessStdinWriteText
        "write_some" -> BodyHandleOp.ProcessStdinWrite
        "write_bytes" -> BodyHandleOp.ProcessStdinWriteAll
        else -> BodyHandleOp.ProcessStdinClose
    }
    sema_process_finish(receiver_value, operation, values, result, "Exec", "ProcessStdin.{method}", span, expected, environment, program, check.scopes, check.context, check.diagnostics)
}

// A `[U8]` given to the text `write` is the argument mismatch whose fix names
// `write_bytes`.
sema_process_byte_write: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> Bool {
    if args[0].label != None -> return false
    probe_diagnostics := [Diagnostic]{}
    probed: sema_probe_expression(args[0].expr, None, environment, program, check, probe_diagnostics) ?? return false
    offered: sema_expr_unwrap_tag(probed.ty)
    if offered != (Type.List{element: Type.IntN{signed: false, bits: 8}}) -> return false
    check.diagnostics.push(sema_call_argument_mismatch("write", 0, Type.String, None, offered, args[0].expr, expr_span(args[0].expr), program))
    true
}

sema_process_stream_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if method != "lines" && method != "read_bytes" && method != "chunks" {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    required_arity: if method == "lines" -> 0 else if method == "chunks" && args.len() == 0 -> 0 else -> 1
    if args.len() != required_arity {
        sema_process_wrong_arity(method, required_arity, args.len(), span, check.diagnostics)
        sema_process_infer_args(args, environment, program, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    stream_name := sema_process_handle_receiver_name(receiver_value.ty)
    api := "{stream_name}.{method}"
    required: if required_arity == 1 -> [Type]{Type.Int} else -> [Type]{}
    values: sema_process_check_args(args, required, environment, program, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_process_check_method_ownership(receiver, api, args, required, [Bool]{}, AccessConvention.Read, span, check.scopes, check.state, check.diagnostics) {
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    // `read_bytes(max)`: Read::read on the pipe, up to `max` bytes, empty at
    // EOF.
    if method == "read_bytes" {
        operation: if stream_name == "ProcessStderrStream" -> BodyHandleOp.ProcessStderrRead else -> BodyHandleOp.ProcessStdoutRead
        return sema_process_finish(receiver_value, operation, values, sema_process_io_result(Type.List{element: Type.IntN{signed: false, bits: 8}}), "Exec", api, span, expected, environment, program, check.scopes, check.context, check.diagnostics)
    }
    // `chunks(size)`: the Core source body `core.process.__stdout_chunks` /
    // `__stderr_chunks` builds the loop source, whose Iterable reads the pipe
    // `size` bytes at a time, so every tier runs the same Jet code.
    if method == "chunks" {
        result: Type.Named{name: sema_core_module_nominal(program, "core.process", "ProcessChunks")}
        member: if stream_name == "ProcessStderrStream" -> "__stderr_chunks" else -> "__stdout_chunks"
        size: if values.len() == 1 -> values[0].copy() else -> sema_tree_node(Type.Int, TExprKind.IntLit{value: 65536, width: None}, span)
        return sema_process_source_call(member, api, "Exec", [TExpr]{receiver_value, size}, result, span, expected, environment, program, check)
    }
    sema_process_finish(receiver_value, BodyHandleOp.ProcessLines, [TExpr]{}, sema_process_named("ProcessLines"), "Exec", api, span, expected, environment, program, check.scopes, check.context, check.diagnostics)
}

sema_call_try_process_handle_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    // A child's `terminal` is optional: its session methods need the handle
    // unwrapped first.
    if method == "resize" && receiver_value.ty == .Option(inner) && sema_process_handle_receiver_name(inner) == "TerminalSession" {
        check.diagnostics.push(sema_error("E0311", span, "`.resize()` needs `TerminalSession`, not `TerminalSession?`", "a child has a terminal session only when a terminal-backed launch succeeds", "unwrap the optional handle first, then call `session.resize(size)`"))
        sema_process_infer_args(args, environment, program, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    // A string key one or two edits from a stable terminal fact is a typo of
    // that fact; any other string key stays an open preview fact.
    if method == "has" && args.len() == 1 && receiver_value.ty == .Tagged(marker, _) && marker == (TagMarker.Internal{internal_tag: InternalTag.TerminalFactSet}) {
        if args[0].expr == .Str(parts, key_span, _) && parts.len() == 1 && parts[0] == .Lit(key) {
            if sema_suggest_field(key, SEMA_TERMINAL_FACTS) == .Val(fact) {
                check.diagnostics.push(sema_error("E0302", key_span, "terminal fact key `{key}` looks like `{fact}`", "preview string keys stay open, but close spellings of stable facts are probably typos", "write `TerminalFact.{fact}`"))
                sema_process_infer_args(args, environment, program, check)
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
        }
    }
    receiver_name: sema_process_handle_receiver_name(receiver_value.ty)
    if receiver_name == "ProcessSpec" {
        return sema_process_spec_method(receiver, receiver_value, method, args, span, expected, environment, program, check)
    }
    if receiver_name == "ProcessChild" {
        return sema_process_child_method(receiver, receiver_value, method, args, span, expected, environment, program, check)
    }
    if receiver_name == "TerminalSession" {
        return sema_process_terminal_method(receiver, receiver_value, method, args, span, expected, environment, program, check)
    }
    if receiver_name == "ProcessStdin" {
        return sema_process_stdin_method(receiver, receiver_value, method, args, span, expected, environment, program, check)
    }
    if receiver_name == "ProcessStdoutStream" || receiver_name == "ProcessStderrStream" {
        return sema_process_stream_method(receiver, receiver_value, method, args, span, expected, environment, program, check)
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}
