// Source producers for typed network handles.
// These operations are intrinsic checked-tree handles; their canonical backend routes
// carry the Net effect and fixed ABI. Plain module calls stay in CoreCall.
use jet_foundation.[
    AccessConvention,
    CORE_BUILTINS_MODULE,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    ParamZone,
    Span,
    SymbolKind,
    Type,
    core_call,
    core_identity_is,
    core_module_export,
    ir_runtime_handle_row,
]

// The Core handles whose method calls sema types from
// SEMA_NETWORK_HANDLE_METHODS. Each is a runtime handle (IR_RUNTIME_HANDLES)
// whose methods no Core source declares, so no declaration answers the call.
SEMA_NETWORK_HANDLE_OWNERS: [String]{"TCPListener", "TCPStream", "UDPSocket", "UnixListener", "UnixStream", "WsConn", "WsMessage"}

// One parameter of a handle method: `deadline:` is passed by label only, and
// `&buffer` is a written place the read appends to in place.
SemaNetworkHandleParam: struct {
    name: String,
    ty: Type,
    label_only: Bool,
    write: Bool,
}

// One form of a handle method: its owner and the owner's Core module, how
// the call lowers, its result, the parameters, whose count is the form's
// arity, and the effect the call records ("" for none). A form lowers to
// the checked handle operation `operation`, or with none to a Core call of
// its declared `jet_builtins` host leaf `leaf`, whose row names the runtime
// export every tier runs.
SemaNetworkHandleMethod: struct {
    owner: String,
    module: String,
    method: String,
    operation: THandleOp?{None},
    leaf: String{""},
    result: Type,
    params: [SemaNetworkHandleParam],
    effect: String,
}

SEMA_NETWORK_HANDLE_DEADLINE: SemaNetworkHandleParam{name: "deadline", ty: Type.Named{name: "Duration"}, label_only: true, write: false}

SEMA_NETWORK_HANDLE_MAX_BYTES: SemaNetworkHandleParam{name: "max_bytes", ty: Type.Int, label_only: false, write: false}

SEMA_NETWORK_HANDLE_LIMIT: SemaNetworkHandleParam{name: "limit", ty: Type.Int, label_only: false, write: false}

SEMA_NETWORK_HANDLE_TEXT: SemaNetworkHandleParam{name: "text", ty: Type.String, label_only: false, write: false}

SEMA_NETWORK_HANDLE_BYTES: SemaNetworkHandleParam{name: "bytes", ty: Type.List{element: Type.IntN{signed: false, bits: 8}}, label_only: false, write: false}

// `read_into`'s `&buffer: [U8]`: the read appends to the caller's List in
// place.
SEMA_NETWORK_HANDLE_BUFFER: SemaNetworkHandleParam{name: "buffer", ty: Type.List{element: Type.IntN{signed: false, bits: 8}}, label_only: false, write: true}

SEMA_NETWORK_HANDLE_INTEREST: SemaNetworkHandleParam{name: "interest", ty: Type.Named{name: "NetReadyInterest"}, label_only: false, write: false}

// Every method form of SEMA_NETWORK_HANDLE_OWNERS, an owner's forms of one
// method in rising arity.
SEMA_NETWORK_HANDLE_METHODS: [SemaNetworkHandleMethod]{
    {owner: "TCPListener", module: "core.net", method: "accept", operation: Val(THandleOp.TCPListenerAccept), result: Type.Result{ok: Type.Named{name: "TCPStream"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{}, effect: "Net"},
    {owner: "TCPListener", module: "core.net", method: "accept", operation: Val(THandleOp.TCPListenerAcceptDeadline), result: Type.Result{ok: Type.Named{name: "TCPStream"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "TCPListener", module: "core.net", method: "local_addr", operation: Val(THandleOp.TCPListenerLocalAddr), result: Type.Result{ok: Type.String, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "read", operation: Val(THandleOp.TCPStreamRead), result: Type.Result{ok: Type.String, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "read", operation: Val(THandleOp.TCPStreamReadText), result: Type.Result{ok: Type.String, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_MAX_BYTES}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "read", operation: Val(THandleOp.TCPStreamReadTextDeadline), result: Type.Result{ok: Type.String, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_MAX_BYTES, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "read_bytes", operation: Val(THandleOp.TCPStreamReadBytes{into: false}), result: Type.Result{ok: Type.List{element: Type.IntN{signed: false, bits: 8}}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_MAX_BYTES}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "read_bytes", operation: Val(THandleOp.TCPStreamReadBytesDeadline{into: false}), result: Type.Result{ok: Type.List{element: Type.IntN{signed: false, bits: 8}}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_MAX_BYTES, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "read_into", operation: Val(THandleOp.TCPStreamReadBytes{into: true}), result: Type.Result{ok: Type.Int, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_BUFFER, SEMA_NETWORK_HANDLE_LIMIT}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "read_into", operation: Val(THandleOp.TCPStreamReadBytesDeadline{into: true}), result: Type.Result{ok: Type.Int, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_BUFFER, SEMA_NETWORK_HANDLE_LIMIT, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "write", operation: Val(THandleOp.TCPStreamWriteText), result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_TEXT}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "write", operation: Val(THandleOp.TCPStreamWriteTextDeadline), result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_TEXT, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "write_some", operation: Val(THandleOp.TCPStreamWriteBytes), result: Type.Result{ok: Type.Int, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_BYTES}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "write_some", operation: Val(THandleOp.TCPStreamWriteBytesDeadline), result: Type.Result{ok: Type.Int, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_BYTES, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "write_bytes", operation: Val(THandleOp.TCPStreamWriteAllBytes), result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_BYTES}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "write_bytes", operation: Val(THandleOp.TCPStreamWriteAllBytesDeadline), result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_BYTES, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "shutdown", operation: Val(THandleOp.TCPStreamShutdown), result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{{name: "how", ty: Type.Named{name: "NetShutdown"}, label_only: false, write: false}}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "ready", operation: Val(THandleOp.TCPStreamReady), result: Type.Result{ok: Type.Named{name: "NetReady"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_INTEREST, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "peer_addr", operation: Val(THandleOp.TCPStreamPeerAddr), result: Type.Result{ok: Type.String, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "local_addr", operation: Val(THandleOp.TCPStreamLocalAddr), result: Type.Result{ok: Type.String, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{}, effect: "Net"},
    {owner: "TCPStream", module: "core.net", method: "close", operation: Val(THandleOp.TCPStreamClose), result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{}, effect: "Net"},
    {owner: "UDPSocket", module: "core.net", method: "ready", operation: Val(THandleOp.UDPSocketReady), result: Type.Result{ok: Type.Named{name: "NetReady"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_INTEREST, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "UDPSocket", module: "core.net", method: "close", operation: Val(THandleOp.UDPSocketClose), result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{}, effect: "Net"},
    {owner: "UDPSocket", module: "core.net", method: "receive", operation: Val(THandleOp.UDPSocketReceiveDeadline), result: Type.Result{ok: Type.Named{name: "UDPPacket"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_MAX_BYTES, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "UDPSocket", module: "core.net", method: "send_to", operation: Val(THandleOp.UDPSocketSendToDeadline), result: Type.Result{ok: Type.Int, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_BYTES, {name: "address", ty: Type.Named{name: "SocketAddr"}, label_only: false, write: false}, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "UnixListener", module: "core.net", method: "accept", operation: Val(THandleOp.UnixListenerAcceptDeadline), result: Type.Result{ok: Type.Named{name: "UnixStream"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "UnixStream", module: "core.net", method: "read_bytes", operation: Val(THandleOp.UnixStreamReadDeadline{into: false}), result: Type.Result{ok: Type.List{element: Type.IntN{signed: false, bits: 8}}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_MAX_BYTES, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "UnixStream", module: "core.net", method: "read_into", operation: Val(THandleOp.UnixStreamReadDeadline{into: true}), result: Type.Result{ok: Type.Int, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_BUFFER, SEMA_NETWORK_HANDLE_LIMIT, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "UnixStream", module: "core.net", method: "write_bytes", operation: Val(THandleOp.UnixStreamWriteAllDeadline), result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_BYTES, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "UnixStream", module: "core.net", method: "ready", operation: Val(THandleOp.UnixStreamReady), result: Type.Result{ok: Type.Named{name: "NetReady"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_INTEREST, SEMA_NETWORK_HANDLE_DEADLINE}, effect: "Net"},
    {owner: "UnixStream", module: "core.net", method: "close", operation: Val(THandleOp.UnixStreamClose), result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{}, effect: "Net"},
    {owner: "UnixStream", module: "core.net", method: "set_timeout", operation: Val(THandleOp.UnixStreamSetTimeout), result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "NetError"}}, params: [SemaNetworkHandleParam]{{name: "timeout", ty: Type.Named{name: "Duration"}, label_only: false, write: false}}, effect: "Net"},
    {owner: "WsConn", module: "core.net.ws", method: "send_text", leaf: "ws_conn_send_text", result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "WsError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_TEXT}, effect: "Net"},
    {owner: "WsConn", module: "core.net.ws", method: "send_bytes", leaf: "ws_conn_send_bytes", result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "WsError"}}, params: [SemaNetworkHandleParam]{SEMA_NETWORK_HANDLE_BYTES}, effect: "Net"},
    {owner: "WsConn", module: "core.net.ws", method: "recv", leaf: "ws_conn_recv", result: Type.Result{ok: Type.Named{name: "WsMessage"}, err: Type.Named{name: "WsError"}}, params: [SemaNetworkHandleParam]{}, effect: "Net"},
    {owner: "WsConn", module: "core.net.ws", method: "close", leaf: "ws_conn_close", result: Type.Result{ok: Type.Named{name: "Unit"}, err: Type.Named{name: "WsError"}}, params: [SemaNetworkHandleParam]{{name: "code", ty: Type.Int, label_only: false, write: false}, {name: "reason", ty: Type.String, label_only: false, write: false}}, effect: "Net"},
    {owner: "WsMessage", module: "core.net.ws", method: "is_text", leaf: "ws_message_is_text", result: Type.Bool, params: [SemaNetworkHandleParam]{}, effect: ""},
    {owner: "WsMessage", module: "core.net.ws", method: "is_binary", leaf: "ws_message_is_binary", result: Type.Bool, params: [SemaNetworkHandleParam]{}, effect: ""},
    {owner: "WsMessage", module: "core.net.ws", method: "is_close", leaf: "ws_message_is_close", result: Type.Bool, params: [SemaNetworkHandleParam]{}, effect: ""},
    {owner: "WsMessage", module: "core.net.ws", method: "text", leaf: "ws_message_text", result: Type.Result{ok: Type.String, err: Type.Named{name: "WsError"}}, params: [SemaNetworkHandleParam]{}, effect: ""},
    {owner: "WsMessage", module: "core.net.ws", method: "bytes", leaf: "ws_message_bytes", result: Type.Result{ok: Type.List{element: Type.IntN{signed: false, bits: 8}}, err: Type.Named{name: "WsError"}}, params: [SemaNetworkHandleParam]{}, effect: ""},
}

SEMA_NETWORK_HANDLE_METHODS_CHECKED: #run sema_network_handle_methods_checked(SEMA_NETWORK_HANDLE_OWNERS, SEMA_NETWORK_HANDLE_METHODS)

// The number of forms in `methods` (SEMA_NETWORK_HANDLE_METHODS), once every
// owner is a runtime handle with one Core module and at least one form, every
// form's owner is one of `owners`, every host leaf form names a declared
// `jet_builtins` leaf and no two forms share an owner, a method and an arity;
// else the build stops naming the first stray.
sema_network_handle_methods_checked: fn(owners: [String], methods: [SemaNetworkHandleMethod]) -> Int {
    loop owner in owners {
        if ir_runtime_handle_row(owner) == None {
            panic("SEMA_NETWORK_HANDLE_OWNERS names {owner}, which is no runtime handle (IR_RUNTIME_HANDLES)")
        }
        home: sema_network_handle_owner_module(owner)
        if home == "" {
            panic("SEMA_NETWORK_HANDLE_OWNERS names {owner}, which no SEMA_NETWORK_HANDLE_METHODS row has")
        }
        if core_module_export(home) == None {
            panic("SEMA_NETWORK_HANDLE_METHODS puts {owner} in {home}, which is no Core module")
        }
    }
    loop index in 0..<methods.len() {
        owner: methods[index].owner
        method: methods[index].method
        if !owners.contains(owner) {
            panic("SEMA_NETWORK_HANDLE_METHODS has {owner}.{method}, whose owner SEMA_NETWORK_HANDLE_OWNERS does not name")
        }
        if methods[index].module != sema_network_handle_owner_module(owner) {
            panic("SEMA_NETWORK_HANDLE_METHODS puts {owner} in two modules")
        }
        if methods[index].operation == None && core_call(CORE_BUILTINS_MODULE, methods[index].leaf) == None {
            leaf: methods[index].leaf
            panic("SEMA_NETWORK_HANDLE_METHODS lowers {owner}.{method} to jet_builtins.{leaf}, which Core does not declare")
        }
        loop earlier in 0..<index {
            if methods[earlier].owner == owner && methods[earlier].method == method && methods[earlier].params.len() == methods[index].params.len() {
                panic("SEMA_NETWORK_HANDLE_METHODS has {owner}.{method} with {methods[index].params.len()} arguments twice")
            }
        }
    }
    methods.len()
}

// The SEMA_NETWORK_HANDLE_METHODS row of `owner.method` called with `argc`
// arguments.
sema_network_handle_method_row: fn(owner: String, method: String, argc: Int) -> Int? Never! {
    loop index in 0..<SEMA_NETWORK_HANDLE_METHODS.len() {
        if SEMA_NETWORK_HANDLE_METHODS[index].owner == owner && SEMA_NETWORK_HANDLE_METHODS[index].method == method && SEMA_NETWORK_HANDLE_METHODS[index].params.len() == argc {
            return Val(index)
        }
    }
    None
}

// The checked parameters of a handle method form.
sema_network_handle_params: fn(params: [SemaNetworkHandleParam]) -> [SemaCallParam] Never! {
    checked := [SemaCallParam]{}
    loop param in params {
        checked.push(
            SemaCallParam{
                label: param.name,
                name: param.name,
                zone: if param.label_only -> ParamZone.LabelOnly else -> ParamZone.Either,
                default: None,
                default_ref: None,
                convention: if param.write -> AccessConvention.Write else -> AccessConvention.Read,
                ty: Val(param.ty),
                variadic: false,
            },
        )
    }
    checked
}

sema_network_handle_known_method: fn(owner: String, method: String) -> Bool Never! {
    loop row in SEMA_NETWORK_HANDLE_METHODS {
        if row.owner == owner && row.method == method -> return true
    }
    false
}

sema_network_handle_owner_module: fn(owner: String) -> String Never! {
    loop row in SEMA_NETWORK_HANDLE_METHODS {
        if row.owner == owner -> return row.module
    }
    ""
}

sema_network_handle_nominal_owner: fn(ty: Type) -> String? {
    if ty == {
        .Named(name) -> Val(name)
        .Apply(name, _) -> Val(name)
        .Tagged(_, inner) -> sema_network_handle_nominal_owner(inner)
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> None
    }
}

// Rust `core_net_handle_dispatch_name`: an owner's canonical Core identity
// and its bare spelling project onto the method table.
sema_network_handle_dispatch_name: fn(name: String) -> String? Never! {
    loop owner in SEMA_NETWORK_HANDLE_OWNERS {
        if name == owner || core_identity_is(name, sema_network_handle_owner_module(owner), owner) {
            return Val(owner)
        }
    }
    None
}

// Rust `net_method_return` claims a receiver by its type name alone: the
// handle owners are Core leaf types with no source declaration, so the bare
// spelling (or the owner's canonical Core identity) is the Core handle. A
// bare name the module itself resolves names the Core owner only when that
// declaration belongs to the owner's Core module.
sema_network_handle_is_canonical: fn(receiver_type: Type, owner: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    actual: sema_network_handle_nominal_owner(receiver_type) ?? return false
    if actual != owner {
        mapped: sema_network_handle_dispatch_name(actual) ?? return false
        return mapped == owner
    }
    expected_module := sema_network_handle_owner_module(owner)
    if expected_module == "" -> return false
    if program.registration_graph == .Val(graph) {
        resolved: sema_type_graph_lookup_symbol(graph, environment.module_identity, actual)
        if resolved == .Val(symbol) {
            return sema_resolved_kind(graph, symbol) == SymbolKind.Type && (sema_registration_module_name(graph, sema_resolved_module_identity(graph, symbol)) ?? "") == expected_module
        }
    }
    true
}

sema_network_handle_infer_args: fn(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    loop argument in args {
        _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
    }
}

// The arities of `owner.method`'s forms: "1", "1 or 2", "0, 1, or 2".
sema_network_handle_expected_arity: fn(owner: String, method: String) -> String Never! {
    arities := [String]{}
    loop row in SEMA_NETWORK_HANDLE_METHODS {
        if row.owner == owner && row.method == method -> arities.push("{row.params.len()}")
    }
    if arities.len() < 2 -> return arities.join("")
    last: arities.pop() ?? ""
    if arities.len() == 1 -> return "{arities[0]} or {last}"
    "{arities.join(", ")}, or {last}"
}

sema_network_handle_arity_diagnostic: fn(owner: String, method: String, argc: Int, span: Span, diagnostics: &[Diagnostic]) {
    expected := sema_network_handle_expected_arity(owner, method)
    diagnostics.push(sema_error("E0104", span, "`{owner}.{method}` expects {expected} arguments, got {argc}", "the core networking handle has a fixed checked signature", "pass the arguments and deadline labels for this method's documented form"))
}

// The call's effect row names `effect_name`, or nothing when it is "".
sema_network_handle_effect_fact: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, api: String, span: Span, result_type: Type, effect_name: String, diagnostics: &[Diagnostic]) -> Bool Never! {
    entries := [EffectRowEntry]{}
    if effect_name != "" -> entries.push(EffectRowEntry{name: effect_name, span: span})
    facts := SemaCallFacts{
        return_type: result_type,
        failure_carrier: sema_call_failure_carrier(Val(result_type)),
        effect_bound: Val(entries),
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(environment, program, scopes, context, api, span, facts, diagnostics)
}

sema_network_handle_checked_args: fn(method: String, params: [SemaCallParam], args: [CallArg], receiver: Expr?, receiver_convention: AccessConvention, callback_non_escaping: Bool, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [TExpr]? {
    checked_args := args
    binding: sema_call_bind_args(method, params, checked_args, span, diagnostics) ?? {
        sema_network_handle_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    saved_lambda_escapes := context.lambda_escapes
    if callback_non_escaping -> context.lambda_escapes = Val(false)
    typed_optional := sema_call_typecheck_bound_arguments(method, params, None, false, binding, checked_args, environment, program, scopes, state, tail_store, context, span, diagnostics, true)
    context.lambda_escapes = saved_lambda_escapes
    typed: typed_optional ?? return None
    ownership: if receiver == {
        .Val(value) -> sema_ownership_check_method_call(state, method, value, receiver_convention, params, checked_args, scopes, span, diagnostics)
        .None -> sema_ownership_check_call_arguments(state, method, params, checked_args, scopes, diagnostics)
    }
    if !ownership.accepted || !ownership.complete -> return None
    values := [TExpr]{}
    loop slot in 0..<params.len() {
        found := false
        loop index in 0..<typed.values.len() {
            if typed.slots[index] == slot {
                // A `&` argument keeps its Write borrow of the caller's
                // place, so the route writes the original, never a copy.
                if params[slot].convention == AccessConvention.Write {
                    values.push(sema_tree_node(typed.values[index].ty.copy(), TExprKind.Borrow{place: typed.values[index].copy(), access: AccessConvention.Write}, typed.values[index].span))
                } else { values.push(typed.values[index]) }
                found = true
                break
            }
        }
        if !found -> return None
    }
    Val(values)
}

sema_network_handle_finish: fn(receiver: TExpr, operation: THandleOp?, leaf: String, args: &&[TExpr], result_type: Type, effect_name: String, api: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    if operation == .Val(handle) {
        value := sema_tree_node(result_type, TExprKind.HandleMethod{receiver: receiver, operation: handle, args: args}, span)
        checked: sema_expression_call_expected(value, expected, environment, program, context, diagnostics) ?? return rejected
        if !sema_network_handle_effect_fact(environment, program, scopes, context, api, span, result_type, effect_name, diagnostics) {
            return rejected
        }
        return SemaMethodSpecialCheck{handled: true, value: Val(checked)}
    }
    // A host leaf form: the leaf's Core call facts name the effects and its
    // row names the runtime export every tier runs.
    record: core_call(CORE_BUILTINS_MODULE, leaf) ?? panic("{api} has no jet_builtins.{leaf} host leaf")
    fallibility: sema_expression_failure_carrier(result_type)
    if !sema_call_core_record_effects_as(record, api, span, [Type]{}, result_type, fallibility, [FunctionDefaultRef]{}, scopes, context, environment, program, diagnostics) {
        return rejected
    }
    call_args := [TExpr]{receiver}
    widen := [Bool]{false}
    loop argument in args.move() {
        call_args.push(argument)
        widen.push(false)
    }
    call: sema_call_core_tree(record, call_args, span, [Type]{}, widen, result_type, fallibility, None, environment, program, diagnostics) ?? return rejected
    SemaMethodSpecialCheck{handled: true, value: sema_expression_call_expected(call, expected, environment, program, context, diagnostics)}
}

// Called before ordinary method candidate lookup with the already checked
// receiver. A route is claimed only for a Core handle owner
// (sema_network_handle_is_canonical).
sema_call_try_network_handle_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    actual: sema_network_handle_nominal_owner(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    owner: sema_network_handle_dispatch_name(actual) ?? actual
    if !sema_network_handle_is_canonical(receiver_value.ty, owner, environment, program) || !sema_network_handle_known_method(owner, method) {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    row: sema_network_handle_method_row(owner, method, args.len()) ?? {
        sema_network_handle_infer_args(args, environment, program, scopes, state, tail_store, context, diagnostics)
        sema_network_handle_arity_diagnostic(owner, method, args.len(), span, diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    params: sema_network_handle_params(SEMA_NETWORK_HANDLE_METHODS[row].params)
    checked_args: sema_network_handle_checked_args(method, params, args, Val(receiver), AccessConvention.Read, false, span, environment, program, scopes, state, tail_store, context, diagnostics)
    // Rust `net_method_return` types the network handle methods without
    // recording a receiver convention, so a written mark (`stream.write(…)`)
    // has nothing to be compared with.
    sema_receiver_mark_forget(state, receiver)
    typed_args := checked_args ?? return SemaMethodSpecialCheck{handled: true, value: None}
    sema_network_handle_finish(receiver_value, SEMA_NETWORK_HANDLE_METHODS[row].operation, SEMA_NETWORK_HANDLE_METHODS[row].leaf, typed_args, SEMA_NETWORK_HANDLE_METHODS[row].result, SEMA_NETWORK_HANDLE_METHODS[row].effect, "{owner}.{method}", span, expected, environment, program, scopes, context, diagnostics)
}
