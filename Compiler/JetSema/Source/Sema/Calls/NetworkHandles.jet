// Source producers for typed network handles and the TLS static sentinels.
// These operations are intrinsic TIR handles; their canonical backend routes
// carry the Net effect and fixed ABI. Plain module calls stay in CoreCall.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    ParamZone,
    Span,
    SymbolKind,
    TExpr,
    TExprKind,
    THandleOp,
    Type,
    tir_call_arg_copy_fact,
]

struct SemaNetworkHandleSpec {
    pub operation: THandleOp
    pub result_type: Type
    pub params: [SemaCallParam]
    pub receiver_convention: AccessConvention
    pub callback_non_escaping: Bool
    pub effect_name: String?
}

fn sema_network_handle_parameter(name: String, label: String, ty: Type, zone: ParamZone) -> SemaCallParam Never! {
    SemaCallParam{
        label: label,
        name: name,
        zone: zone,
        default: None,
        default_ref: None,
        convention: AccessConvention.Read,
        ty: Val(ty),
        variadic: false,
    }
}

fn sema_network_handle_argument(name: String, ty: Type) -> SemaCallParam Never! {
    sema_network_handle_parameter(name, name, ty, ParamZone.Either)
}
fn sema_network_handle_argument_move(name: String, ty: Type) -> SemaCallParam Never! {
    parameter := sema_network_handle_argument(name, ty)
    parameter.convention = AccessConvention.Move
    parameter
}

fn sema_network_handle_parameter_move(name: String, label: String, ty: Type, zone: ParamZone) -> SemaCallParam Never! {
    parameter := sema_network_handle_parameter(name, label, ty, zone)
    parameter.convention = AccessConvention.Move
    parameter
}


fn sema_network_handle_deadline() -> SemaCallParam Never! {
    sema_network_handle_parameter("deadline", "deadline", Type.Named{name: "Duration"}, ParamZone.LabelOnly)
}

fn sema_network_handle_spec(operation: THandleOp, result_type: Type, params: [SemaCallParam], receiver_convention: AccessConvention) -> SemaNetworkHandleSpec Never! {
    SemaNetworkHandleSpec{
        operation: operation,
        result_type: result_type,
        params: params,
        receiver_convention: receiver_convention,
        callback_non_escaping: false,
        effect_name: Val("Net"),
    }
}

fn sema_network_handle_io_error() -> Type Never! {
    Type.Named{name: "IOError"}
}

fn sema_network_handle_result(ok: Type, err: Type) -> Type Never! {
    Type.Result{ok: ok, err: err}
}

fn sema_network_handle_net_result(ok: Type) -> Type Never! {
    sema_network_handle_result(ok, Type.Named{name: "NetError"})
}

fn sema_network_handle_u8_list() -> Type Never! {
    Type.List{element: Type.IntN{signed: false, bits: 8}}
}

fn sema_network_handle_ready_params() -> [SemaCallParam] Never! {
    [SemaCallParam]{
        sema_network_handle_argument_move("interest", Type.Named{name: "NetReadyInterest"}),
        sema_network_handle_deadline(),
    }
}

fn sema_network_handle_spec_for(owner: String, method: String, argc: Int) -> SemaNetworkHandleSpec? {
    io_error := sema_network_handle_io_error()
    unit := Type.Named{name: "Unit"}
    string := Type.String
    bytes := sema_network_handle_u8_list()
    duration := Type.Named{name: "Duration"}
    int := Type.Int
    if owner == "TCPListener" {
        if method == "accept" && argc == 0 -> return Val(sema_network_handle_spec(THandleOp.TCPListenerAccept, sema_network_handle_net_result(Type.Named{name: "TCPStream"}), [SemaCallParam]{}, AccessConvention.Read))
        if method == "accept" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.TCPListenerAcceptDeadline, sema_network_handle_net_result(Type.Named{name: "TCPStream"}), [SemaCallParam]{sema_network_handle_deadline()}, AccessConvention.Read))
        if method == "local_addr" && argc == 0 -> return Val(sema_network_handle_spec(THandleOp.TCPListenerLocalAddr, sema_network_handle_net_result(string), [SemaCallParam]{}, AccessConvention.Read))
    }
    if owner == "TCPStream" {
        if method == "read" && argc == 0 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamRead, sema_network_handle_net_result(string), [SemaCallParam]{}, AccessConvention.Read))
        if method == "read" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamReadBytes, sema_network_handle_net_result(bytes), [SemaCallParam]{sema_network_handle_argument("max_bytes", int)}, AccessConvention.Read))
        if method == "read" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamReadBytesDeadline, sema_network_handle_net_result(bytes), [SemaCallParam]{sema_network_handle_argument("max_bytes", int), sema_network_handle_deadline()}, AccessConvention.Read))
        if method == "read_text" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamReadText, sema_network_handle_net_result(string), [SemaCallParam]{sema_network_handle_argument("max_bytes", int)}, AccessConvention.Read))
        if method == "read_text" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamReadTextDeadline, sema_network_handle_net_result(string), [SemaCallParam]{sema_network_handle_argument("max_bytes", int), sema_network_handle_deadline()}, AccessConvention.Read))
        if method == "write" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamWriteBytes, sema_network_handle_net_result(int), [SemaCallParam]{sema_network_handle_argument("bytes", bytes)}, AccessConvention.Read))
        if method == "write" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamWriteBytesDeadline, sema_network_handle_net_result(int), [SemaCallParam]{sema_network_handle_argument("bytes", bytes), sema_network_handle_deadline()}, AccessConvention.Read))
        if method == "write_all" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamWriteAllBytes, sema_network_handle_net_result(unit), [SemaCallParam]{sema_network_handle_argument("bytes", bytes)}, AccessConvention.Read))
        if method == "write_all" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamWriteAllBytesDeadline, sema_network_handle_net_result(unit), [SemaCallParam]{sema_network_handle_argument("bytes", bytes), sema_network_handle_deadline()}, AccessConvention.Read))
        if method == "write_text" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamWriteText, sema_network_handle_net_result(unit), [SemaCallParam]{sema_network_handle_argument("text", string)}, AccessConvention.Read))
        if method == "write_text" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamWriteTextDeadline, sema_network_handle_net_result(unit), [SemaCallParam]{sema_network_handle_argument("text", string), sema_network_handle_deadline()}, AccessConvention.Read))
        if method == "shutdown" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamShutdown, sema_network_handle_net_result(unit), [SemaCallParam]{sema_network_handle_argument_move("how", Type.Named{name: "NetShutdown"})}, AccessConvention.Read))
        if method == "ready" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamReady, sema_network_handle_net_result(Type.Named{name: "NetReady"}), sema_network_handle_ready_params(), AccessConvention.Read))
        if method == "peer_addr" && argc == 0 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamPeerAddr, sema_network_handle_net_result(string), [SemaCallParam]{}, AccessConvention.Read))
        if method == "local_addr" && argc == 0 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamLocalAddr, sema_network_handle_net_result(string), [SemaCallParam]{}, AccessConvention.Read))
        if method == "close" && argc == 0 -> return Val(sema_network_handle_spec(THandleOp.TCPStreamClose, sema_network_handle_net_result(unit), [SemaCallParam]{}, AccessConvention.Read))
    }
    if owner == "UDPSocket" {
        if method == "ready" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.UDPSocketReady, sema_network_handle_net_result(Type.Named{name: "NetReady"}), sema_network_handle_ready_params(), AccessConvention.Read))
        if method == "close" && argc == 0 -> return Val(sema_network_handle_spec(THandleOp.UDPSocketClose, sema_network_handle_net_result(unit), [SemaCallParam]{}, AccessConvention.Read))
        if method == "receive" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.UDPSocketReceiveDeadline, sema_network_handle_net_result(Type.Named{name: "UDPPacket"}), [SemaCallParam]{sema_network_handle_argument("max_bytes", int), sema_network_handle_deadline()}, AccessConvention.Read))
        if method == "send_to" && argc == 3 -> return Val(sema_network_handle_spec(THandleOp.UDPSocketSendToDeadline, sema_network_handle_net_result(int), [SemaCallParam]{sema_network_handle_argument("bytes", bytes), sema_network_handle_argument("address", string), sema_network_handle_deadline()}, AccessConvention.Read))
    }
    if owner == "UnixListener" {
        if method == "accept" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.UnixListenerAcceptDeadline, sema_network_handle_net_result(Type.Named{name: "UnixStream"}), [SemaCallParam]{sema_network_handle_deadline()}, AccessConvention.Read))
    }
    if owner == "UnixStream" {
        if method == "read" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.UnixStreamReadDeadline, sema_network_handle_net_result(bytes), [SemaCallParam]{sema_network_handle_argument("max_bytes", int), sema_network_handle_deadline()}, AccessConvention.Read))
        if method == "write_all" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.UnixStreamWriteAllDeadline, sema_network_handle_net_result(unit), [SemaCallParam]{sema_network_handle_argument("bytes", bytes), sema_network_handle_deadline()}, AccessConvention.Read))
        if method == "ready" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.UnixStreamReady, sema_network_handle_net_result(Type.Named{name: "NetReady"}), sema_network_handle_ready_params(), AccessConvention.Read))
        if method == "close" && argc == 0 -> return Val(sema_network_handle_spec(THandleOp.UnixStreamClose, sema_network_handle_net_result(unit), [SemaCallParam]{}, AccessConvention.Read))
        if method == "set_timeout" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.UnixStreamSetTimeout, sema_network_handle_net_result(unit), [SemaCallParam]{sema_network_handle_argument("timeout", duration)}, AccessConvention.Read))
    }
    if owner == "TLSStream" {
        if method == "read" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.TLSStreamReadDeadline, sema_network_handle_result(bytes, io_error), [SemaCallParam]{sema_network_handle_argument("max_bytes", int), sema_network_handle_deadline()}, AccessConvention.Read))
        if method == "write_all" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.TLSStreamWriteAllDeadline, sema_network_handle_result(unit, io_error), [SemaCallParam]{sema_network_handle_argument("bytes", bytes), sema_network_handle_deadline()}, AccessConvention.Read))
        if method == "ready" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.TLSStreamReady, sema_network_handle_result(Type.Named{name: "NetReady"}, io_error), sema_network_handle_ready_params(), AccessConvention.Read))
        if method == "close" && argc == 0 -> return Val(sema_network_handle_spec(THandleOp.TLSStreamClose, sema_network_handle_result(unit, io_error), [SemaCallParam]{}, AccessConvention.Read))
        if method == "close_write" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.TLSStreamCloseWrite, sema_network_handle_result(unit, io_error), [SemaCallParam]{sema_network_handle_deadline()}, AccessConvention.Read))
        if method == "peer_identity" && argc == 0 -> return Val(sema_network_handle_spec(THandleOp.TLSStreamPeerIdentity, Type.Named{name: "TLSPeerIdentity"}, [SemaCallParam]{}, AccessConvention.Read))
    }
    if owner == "TLSClientConfig" {
        receiver_convention := AccessConvention.Move
        if method == "with_alpn" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.TLSClientConfigWithALPN, sema_network_handle_result(Type.Named{name: "TLSClientConfig"}, io_error), [SemaCallParam]{sema_network_handle_argument("protocols", Type.List{element: string})}, receiver_convention))
        if method == "with_trust" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.TLSClientConfigWithTrust, sema_network_handle_result(Type.Named{name: "TLSClientConfig"}, io_error), [SemaCallParam]{sema_network_handle_argument_move("trust", Type.Named{name: "TLSClientTrust"})}, receiver_convention))
        if method == "with_client_identity" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.TLSClientConfigWithIdentity, sema_network_handle_result(Type.Named{name: "TLSClientConfig"}, io_error), [SemaCallParam]{sema_network_handle_argument("identity", Type.Named{name: "TLSClientIdentity"})}, receiver_convention))
        if method == "with_version_bounds" && argc == 2 {
            minimum := sema_network_handle_parameter_move("min", "min", Type.Named{name: "TLSVersion"}, ParamZone.LabelOnly)
            maximum := sema_network_handle_parameter_move("max", "max", Type.Named{name: "TLSVersion"}, ParamZone.LabelOnly)
            return Val(sema_network_handle_spec(THandleOp.TLSClientConfigWithVersionBounds, sema_network_handle_result(Type.Named{name: "TLSClientConfig"}, io_error), [SemaCallParam]{minimum, maximum}, receiver_convention))
        }
    }
    if owner == "WsConn" {
        ws_error := Type.Named{name: "WsError"}
        if method == "send_text" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.HTTPServerMethod{kind: "WsConn", method: method}, sema_network_handle_result(unit, ws_error), [SemaCallParam]{sema_network_handle_argument("text", string)}, AccessConvention.Read))
        if method == "send_bytes" && argc == 1 -> return Val(sema_network_handle_spec(THandleOp.HTTPServerMethod{kind: "WsConn", method: method}, sema_network_handle_result(unit, ws_error), [SemaCallParam]{sema_network_handle_argument("bytes", bytes)}, AccessConvention.Read))
        if method == "recv" && argc == 0 -> return Val(sema_network_handle_spec(THandleOp.HTTPServerMethod{kind: "WsConn", method: method}, sema_network_handle_result(Type.Named{name: "WsMessage"}, ws_error), [SemaCallParam]{}, AccessConvention.Read))
        if method == "close" && argc == 2 -> return Val(sema_network_handle_spec(THandleOp.HTTPServerMethod{kind: "WsConn", method: method}, sema_network_handle_result(unit, ws_error), [SemaCallParam]{sema_network_handle_argument("code", int), sema_network_handle_argument("reason", string)}, AccessConvention.Read))
    }
    if owner == "WsMessage" {
        if (method == "is_text" || method == "is_binary" || method == "is_close") && argc == 0 {
            spec := sema_network_handle_spec(THandleOp.HTTPServerMethod{kind: "WsMessage", method: method}, Type.Bool, [SemaCallParam]{}, AccessConvention.Read)
            spec.effect_name = Val("")
            return Val(spec)
        }
        if method == "text" && argc == 0 {
            spec := sema_network_handle_spec(THandleOp.HTTPServerMethod{kind: "WsMessage", method: method}, sema_network_handle_result(string, Type.Named{name: "WsError"}), [SemaCallParam]{}, AccessConvention.Read)
            spec.effect_name = Val("")
            return Val(spec)
        }
        if method == "bytes" && argc == 0 {
            spec := sema_network_handle_spec(THandleOp.HTTPServerMethod{kind: "WsMessage", method: method}, sema_network_handle_result(bytes, Type.Named{name: "WsError"}), [SemaCallParam]{}, AccessConvention.Read)
            spec.effect_name = Val("")
            return Val(spec)
        }
    }
    None
}

pub fn sema_network_handle_known_method(owner: String, method: String) -> Bool Never! {
    if owner == "TCPListener" -> return method == "accept" || method == "local_addr"
    if owner == "TCPStream" -> return method == "read" || method == "read_text" || method == "write" || method == "write_all" || method == "write_text" || method == "shutdown" || method == "ready" || method == "peer_addr" || method == "local_addr" || method == "close"
    if owner == "UDPSocket" -> return method == "ready" || method == "close" || method == "receive" || method == "send_to"
    if owner == "UnixListener" -> return method == "accept"
    if owner == "UnixStream" -> return method == "read" || method == "write_all" || method == "ready" || method == "close" || method == "set_timeout"
    if owner == "TLSStream" -> return method == "read" || method == "write_all" || method == "ready" || method == "close" || method == "close_write" || method == "peer_identity"
    if owner == "TLSClientConfig" -> return method == "with_alpn" || method == "with_trust" || method == "with_client_identity" || method == "with_version_bounds"
    if owner == "WsConn" -> return method == "send_text" || method == "send_bytes" || method == "recv" || method == "close"
    if owner == "WsMessage" -> return method == "is_text" || method == "is_binary" || method == "is_close" || method == "text" || method == "bytes"
    false
}

fn sema_network_handle_owner_module(owner: String) -> String Never! {
    if owner == "TCPListener" || owner == "TCPStream" || owner == "UDPSocket" || owner == "UnixListener" || owner == "UnixStream" -> return "core.net"
    if owner == "TLSStream" || owner == "TLSClientConfig" -> return "core.net.tls"
    if owner == "WsConn" || owner == "WsMessage" -> return "core.net.ws"
    ""
}

fn sema_network_handle_nominal_owner(ty: Type) -> String? {
    if ty == {
        .Named(name) -> Val(name)
        .Apply(name, _) -> Val(name)
        .Tagged(_, inner) -> sema_network_handle_nominal_owner(inner)
        else -> None
    }
}

fn sema_network_handle_is_canonical(receiver_type: Type, owner: String, environment: SemaScopeEnvironment) -> Bool Never! {
    actual :: sema_network_handle_nominal_owner(receiver_type) ?? return false
    if actual != owner -> return false
    expected_module := sema_network_handle_owner_module(owner)
    if expected_module == "" -> return false
    graph_option :: environment.registration_graph
    graph :: graph_option ?? return true
    resolved :: sema_type_graph_lookup_symbol(graph, environment.module_identity, actual)
    if resolved == .Val(symbol) -> return symbol.symbol.kind == SymbolKind.Type && symbol.symbol.module_name == expected_module
    false
}

fn sema_network_handle_infer_args(args: [CallArg], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, &scopes, &state, &tail_store, &context, &diagnostics)
}

fn sema_network_handle_expected_arity(owner: String, method: String) -> String Never! {
    if owner == "TCPListener" {
        if method == "accept" -> return "0 or 1"
        return "0"
    }
    if owner == "TCPStream" {
        if method == "read" || method == "read_text" -> return "0, 1, or 2"
        if method == "write" || method == "write_all" || method == "write_text" -> return "1 or 2"
        if method == "shutdown" -> return "1"
        if method == "ready" -> return "2"
        return "0"
    }
    if owner == "UDPSocket" {
        if method == "ready" || method == "receive" -> return "2"
        if method == "send_to" -> return "3"
        return "0"
    }
    if owner == "UnixListener" -> return "1"
    if owner == "UnixStream" {
        if method == "read" || method == "write_all" || method == "ready" -> return "2"
        if method == "set_timeout" -> return "1"
        return "0"
    }
    if owner == "TLSStream" {
        if method == "read" || method == "write_all" || method == "ready" -> return "2"
        if method == "close_write" -> return "1"
        return "0"
    }
    if owner == "TLSClientConfig" {
        if method == "with_version_bounds" -> return "2"
        return "1"
    }
    if owner == "WsConn" {
        if method == "send_text" || method == "send_bytes" -> return "1"
        if method == "close" -> return "2"
        return "0"
    }
    "0"
}

fn sema_network_handle_arity_diagnostic(owner: String, method: String, argc: Int, span: Span, diagnostics: &[Diagnostic]) {
    expected := sema_network_handle_expected_arity(owner, method)
    &diagnostics.push(sema_error("E0104", span, "`{owner}.{method}` expects {expected} arguments, got {argc}", "the core networking handle has a fixed checked signature", "pass the arguments and deadline labels for this method's documented form"))
}

fn sema_network_handle_effect_fact(environment: SemaScopeEnvironment, scopes: &SemaScopeTable, context: &SemaCheckContext, api: String, span: Span, result_type: Type, effect_name: String?, diagnostics: &[Diagnostic]) -> Bool Never! {
    effect_row := [EffectRowEntry]?{None}
    if effect_name == .Val(name) {
        entries := [EffectRowEntry]{}
        if name != "" -> &entries.push(EffectRowEntry{name: name, span: span})
        effect_row = Val(entries)
    }
    facts := SemaCallFacts{
        return_type: result_type,
        failure_carrier: sema_call_failure_carrier(Val(result_type)),
        effect_bound: effect_row,
        type_args: [Type]{},
        default_refs: [FunctionDefaultRef]{},
    }
    sema_effect_record_intrinsic_fact(environment, &scopes, &context, api, span, facts, &diagnostics)
}

fn sema_network_handle_checked_args(method: String, params: [SemaCallParam], args: [CallArg], receiver: Expr?, receiver_convention: AccessConvention, callback_non_escaping: Bool, span: Span, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [TExpr]? {
    checked_args := args
    binding :: sema_call_bind_args(method, params, &checked_args, span, &diagnostics) ?? {
        sema_network_handle_infer_args(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        return None
    }
    saved_lambda_escapes := context.lambda_escapes
    if callback_non_escaping -> context.lambda_escapes = Val(false)
    typed_optional := sema_call_typecheck_bound_arguments(method, params, None, false, binding, &checked_args, environment, &scopes, &state, &tail_store, &context, span, &diagnostics, true)
    context.lambda_escapes = saved_lambda_escapes
    typed :: typed_optional ?? return None
    ownership :: if receiver == {
        .Val(value) -> sema_ownership_check_method_call(&state, method, value, receiver_convention, params, &checked_args, scopes, span, &diagnostics)
        .None -> sema_ownership_check_call_arguments(&state, method, params, &checked_args, scopes, &diagnostics)
    }
    if !ownership.accepted || !ownership.complete -> return None
    values := [TExpr]{}
    loop slot in 0..<params.len() {
        found := false
        loop index in 0..<typed.values.len() {
            if typed.slots[index] == slot {
                value := typed.values[index]
                if index < checked_args.len() && (checked_args[index].flags.implicit_clone || checked_args[index].flags.shared_auto_clone) -> value = sema_tir_expr(value.ty, TExprKind.Clone{value: value, fact: tir_call_arg_copy_fact(checked_args[index].flags.shared_auto_clone)}, value.span)
                &values.push(value)
                found = true
                break
            }
        }
        if !found -> return None
    }
    Val(values)
}

fn sema_network_handle_finish(receiver: TExpr, operation: THandleOp, args: [TExpr], result_type: Type, effect_name: String?, api: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck Never! {
    value := sema_tir_expr(result_type, TExprKind.HandleMethod{receiver: receiver, operation: operation, args: args}, span)
    checked :: sema_expression_call_expected(value, expected, environment, context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    if !sema_network_handle_effect_fact(environment, &scopes, &context, api, span, result_type, effect_name, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    SemaMethodSpecialCheck{handled: true, value: Val(checked)}
}

// Called before ordinary method candidate lookup with the already checked
// receiver. A route is claimed only for the exact registered Core owner.
pub fn sema_call_try_network_handle_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    owner :: sema_network_handle_nominal_owner(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if !sema_network_handle_is_canonical(receiver_value.ty, owner, environment) || !sema_network_handle_known_method(owner, method) -> return SemaMethodSpecialCheck{handled: false, value: None}
    spec := sema_network_handle_spec_for(owner, method, args.len())
    if spec == None {
        sema_network_handle_infer_args(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        sema_network_handle_arity_diagnostic(owner, method, args.len(), span, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    signature :: spec ?? SemaNetworkHandleSpec{operation: THandleOp.TCPStreamRead, result_type: Type.Named{name: "Unit"}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, callback_non_escaping: false, effect_name: None}
    typed_args :: sema_network_handle_checked_args(method, signature.params, args, Val(receiver), signature.receiver_convention, signature.callback_non_escaping, span, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    sema_network_handle_finish(receiver_value, signature.operation, typed_args, signature.result_type, signature.effect_name, "{owner}.{method}", span, expected, environment, &scopes, &context, &diagnostics)
}

fn sema_network_tls_static_target(receiver: Expr, method: String, environment: SemaScopeEnvironment) -> String? {
    if receiver == {
        .Field(base, leaf, _) -> {
            is_tls_module := if base == {
                .Ident(alias, _) -> sema_expr_core_import_module(environment, alias) == (Val("core.net.tls"))
                else -> false
            }
            if is_tls_module {
                if leaf == "ClientConfig" && method == "default" -> return Val("ClientConfig")
                if leaf == "RootCertificates" && method == "from_pem" -> return Val("RootCertificates")
                if leaf == "ClientIdentity" && method == "from_pem" -> return Val("ClientIdentity")
            }
        }
        else -> {}
    }
    None
}

pub fn sema_call_try_network_tls_static(receiver: Expr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    target :: sema_network_tls_static_target(receiver, method, environment) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    result_type := Type.Named{name: "TLSClientConfig"}
    operation := THandleOp.TLSClientConfigDefault
    params := [SemaCallParam]{}
    effect_name := Val("Net")
    if target == "RootCertificates" {
        result_type = sema_network_handle_result(Type.Named{name: "TLSRootCertificates"}, sema_network_handle_io_error())
        operation = THandleOp.TLSRootCertificatesFromPEM
        &params.push(sema_network_handle_argument("pem", sema_network_handle_u8_list()))
    }
    if target == "ClientIdentity" {
        result_type = sema_network_handle_result(Type.Named{name: "TLSClientIdentity"}, sema_network_handle_io_error())
        operation = THandleOp.TLSClientIdentityFromPEM
        &params.push(sema_network_handle_parameter("cert_chain", "cert_chain", sema_network_handle_u8_list(), ParamZone.LabelOnly))
        &params.push(sema_network_handle_parameter("private_key", "private_key", sema_network_handle_u8_list(), ParamZone.LabelOnly))
    }
    if (target == "ClientConfig" && args.len() != 0) || (target == "RootCertificates" && args.len() != 1) || (target == "ClientIdentity" && args.len() != 2) {
        sema_network_handle_infer_args(args, environment, &scopes, &state, &tail_store, &context, &diagnostics)
        expected_count := if {
            target == "ClientConfig" -> 0
            target == "RootCertificates" -> 1
            else -> 2
        }
        &diagnostics.push(sema_call_arity_diagnostic("{target}.{method}", expected_count, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    typed_args :: sema_network_handle_checked_args("{target}.{method}", params, args, None, AccessConvention.Read, false, span, environment, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    unit_receiver := sema_tir_expr(Type.Named{name: "Unit"}, TExprKind.Unit, span)
    sema_network_handle_finish(unit_receiver, operation, typed_args, result_type, effect_name, "core.net.tls.{target}.{method}", span, expected, environment, &scopes, &context, &diagnostics)
}
