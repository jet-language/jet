use jet_foundation.[
    AccessConvention,
    CallArg,
    CoreCallRecord,
    Diagnostic,
    Expr,
    EffectRowEntry,
    FunctionDefaultRef,
    MIRCopyFact,
    ParamZone,
    PlaceAccess,
    Span,
    StrPart,
    TExpr,
    TExprKind,
    TFailureCarrier,
    THandleOp,
    TMapEntry,
    THostCall,
    TTypedTextForm,
    Type,
    TypeTupleField,
    ast_empty_call_arg_flags,
    core_receiver_method,
    core_source_owns_type,
    expr_span,
    type_name,
    UnOp,
    core_identity_in_module,
    core_identity_is,
]

fn sema_dyn_type() -> Type Never! { Type.Named{name: "Dyn"} }
fn sema_data_value_type() -> Type Never! { Type.Named{name: "DBValue"} }
fn sema_data_decode_error() -> Type Never! { Type.List{element: Type.Named{name: "FieldError"}} }
fn sema_data_result(ok: Type, err: Type) -> Type Never! { Type.Result{ok: ok, err: err} }

fn sema_data_nominal_is(name: String, leaf: String) -> Bool Never! {
    name == leaf || (core_identity_in_module(name, "core.data") && name.ends_with("::{leaf}"))
}

fn sema_data_source_type_name(environment: SemaScopeEnvironment, program: SemaProgramTables, leaf: String) -> String Never! {
    if program.registration_graph == .Val(graph) {
        loop module_row_index in 0..<graph.modules.len() {
            if graph.modules[module_row_index].module_name != "core.data" -> next
            loop nominal_index in 0..<graph.modules[module_row_index].nominals.len() {
                if graph.modules[module_row_index].nominals[nominal_index].symbol.name == leaf {
                    if graph.modules[module_row_index].nominals[nominal_index].compiler_owned -> return "{leaf}"
                    return "{graph.modules[module_row_index].nominals[nominal_index].symbol.module_name}::{leaf}"
                }
            }
        }
        return "{leaf}"
    } else {
        return leaf.copy()
    }
}

fn sema_dyn_is_type(ty: Type) -> Bool Never! {
    ty == (Type.Named{name: "Dyn"})
}

fn sema_dyn_is_member(name: String) -> Bool Never! {
    name == "get" || name == "has" || name == "keys" || name == "remove" || name == "len" || name == "decode" || name == "to_text" || name == "field" || name == "at" || name == "int" || name == "float" || name == "text" || name == "bool" || name == "equal_unordered" || name == "encode"
}

fn sema_dyn_member_error(name: String, span: Span) -> Diagnostic {
    sema_error("E0171", span, "`{name}` is a `Dyn` method, not a field", "Dyn member names are reserved for methods", "use indexing, for example `d[\"{name}\"]`")
}

fn sema_dyn_condition_error(span: Span) -> Diagnostic {
    sema_error("E0170", span, "a `Dyn` value is not a condition", "Dyn has no implicit truthiness", "write `if d.decode<Bool>() ?? false -> …`")
}

fn sema_dyn_wrappable(ty: Type) -> Bool Never! {
    if ty == {
        .Int | .Float | .String | .Bool -> true
        .Named(name) -> name == "Dyn" || name == "DateTime" || name == "ZonedDateTime"
        .List(element) | .FixedList(element, _) -> element == (Type.IntN{signed: false, bits: 8}) || sema_dyn_wrappable(element)
        .Map(key, _, value) -> key == Type.String && sema_dyn_wrappable(value)
        else -> false
    }
}

fn sema_dyn_site(expr: Expr) -> String Never! {
    return if expr == {
        .Ident(name, _) -> name
        .Field(base, member, _) -> "{sema_dyn_site(base)}.{member}"
        .Index(base, index, _, _) -> "{sema_dyn_site(base)}[{sema_dyn_site(index)}]"
        .Paren(inner, _) | .Place(inner, _, _) -> sema_dyn_site(inner)
        .Int(value, _, _, _) -> "{value}"
        .Float(value, _, _, raw) -> raw ?? "{value}"
        .Bool(value, _) -> if value -> "true" else -> "false"
        .Unary(op, inner, _) -> {
            literal :: if inner == {
                .Int(_, _, _, _) | .Float(_, _, _, _) -> true
                else -> false
            }
            if op == UnOp.Neg && literal -> return "-{sema_dyn_site(inner)}"
            "…"
        }
        .Str(parts, _) -> {
            text := ""
            loop part in parts {
                if part == .Lit(piece) -> text = "{text}{piece}" else -> return "…"
            }
            "\"{text}\""
        }
        else -> "…"
    }
}

fn sema_dyn_index_operation(ty: Type, site: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> THandleOp? {
    location :: sema_expression_panic_location(environment, program, scopes, span)
    resolved :: sema_expr_expected_type(ty, environment, program)
    if resolved == Type.String -> return Val(THandleOp.DynIndexKey{site: site, location: location})
    if resolved == Type.Int -> return Val(THandleOp.DynIndexAt{site: site, location: location})
    &diagnostics.push(sema_error("E0505", span, "a Dyn index must be String or Int, not {type_name(ty)}", "Dyn objects use String keys and Dyn arrays use Int positions", "use a String key or Int index"))
    None
}

fn sema_dyn_try_member(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if method != "get" && method != "has" && method != "keys" && method != "remove" && method != "len" -> return SemaMethodSpecialCheck{handled: false, value: None}
    count :: if method == "keys" || method == "len" -> 0 else -> 1
    if !sema_data_check_explicit_type_args(method, type_args, 0, span, &diagnostics) || args.len() != count {
        if args.len() != count -> sema_data_arity_diagnostic(method, count, args.len(), span, &diagnostics)
        sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    typed := [TExpr]{}
    operation := THandleOp.DynKeys
    result_ty := Type.List{element: Type.String}
    if method == "len" {
        operation = THandleOp.DynLen{site: "{sema_dyn_site(receiver)}.len()", location: sema_expression_panic_location(environment, program, scopes, span)}
        result_ty = Type.Int
    }
    if count == 1 {
        sema_data_check_labels(method, args, [String]{}, span, &diagnostics)
        if args[0].convention == AccessConvention.Move -> &diagnostics.push(sema_error("E0203", args[0].span, "a value was passed with the move marker `^` to a parameter that does not consume", "these Core arguments are read-only", "remove the move marker `^` here"))
        argument :: sema_check_expression(args[0].expr, if method == "get" -> None else -> Val(Type.String), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        &typed.push(argument)
        result_ty = Type.Option{inner: sema_dyn_type()}
        if method == "get" {
            index_ty :: sema_expr_expected_type(argument.ty, environment, program)
            if index_ty != Type.String && index_ty != Type.Int {
                &diagnostics.push(sema_error("E0505", args[0].span, "a Dyn index must be String or Int, not {type_name(argument.ty)}", "Dyn objects use String keys and Dyn arrays use Int positions", "use a String key or Int index"))
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
            operation = if index_ty == Type.String -> THandleOp.DynGetKey else -> THandleOp.DynGetAt
        }
        if method == "has" {
            operation = THandleOp.DynHas
            result_ty = Type.Bool
        }
        if method == "remove" -> operation = THandleOp.DynRemove
    }
    convention :: if method == "remove" -> AccessConvention.Write else -> AccessConvention.Read
    if !sema_ownership_check_call_receiver(&state, receiver, convention, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    // Dyn reads report no receiver convention (Rust `dyn_method_return`), so a
    // written mark on the receiver is not compared with one.
    if method != "remove" -> sema_receiver_mark_forget(&state, receiver)
    value :: sema_tir_node(result_ty, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: typed}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
}
fn sema_data_is_json_name(name: String) -> Bool Never! {
    name == "Dyn" || name == "JSON" || name == "TOML" || name == "YAML" || name == "CSV"
}

fn sema_data_type_name(ty: Type) -> String? {
    if ty == {
        .Named(name) -> Val(name)
        .Apply(name, _) -> Val(name)
        else -> None
    }
}

fn sema_data_label(argument: CallArg) -> String? {
    if argument.label == {
        .Val(label) -> { return Val(label.name) }
        else -> { return None }
    }
}

fn sema_data_check_labels(name: String, args: [CallArg], allowed: [String], span: Span, diagnostics: &[Diagnostic]) {
    loop argument in args {
        label :: sema_data_label(argument) ?? next
        if sema_serde_has_name(allowed, label) -> next
        &diagnostics.push(sema_error("E0104", argument.span, "`{name}` does not accept the argument label `{label}`", "this builtin has a fixed argument-label contract", "remove the label or use one of the documented labels"))
    }
}

fn sema_data_check_argument(name: String, index: Int, argument: CallArg, expected: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if argument.convention == AccessConvention.Move {
        &diagnostics.push(sema_error("E0203", argument.span, "a value was passed with the move marker `^` to a parameter that does not consume", "these Core arguments are read-only", "remove the move marker `^` here"))
    }
    sema_check_expression(argument.expr, Val(expected), environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
}

fn sema_data_check_discarded_arguments(args: [CallArg], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) Never! {
    loop argument in args -> _ := sema_check_expression(argument.expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
}

fn sema_data_arity_diagnostic(name: String, expected: Int, actual: Int, span: Span, diagnostics: &[Diagnostic]) {
    &diagnostics.push(sema_error("E0104", span, "`{name}` expects {expected} argument{if expected == 1 -> "" else -> "s"}, got {actual}", "this Core operation has a fixed arity", "pass exactly {expected} argument{if expected == 1 -> "" else -> "s"}"))
}

fn sema_data_check_explicit_type_args(name: String, type_args: [Type], expected: Int, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    if type_args.len() == expected -> return true
    &diagnostics.push(sema_error("E0119", span, "`{name}` expects {expected} type argument{if expected == 1 -> "" else -> "s"}, got {type_args.len()}", "explicit type arguments must match the operation's declared generic shape", "provide exactly {expected} type argument{if expected == 1 -> "" else -> "s"}"))
    false
}

fn sema_data_check_encode(receiver: Expr, receiver_value: TExpr, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if args.len() != 0 || type_args.len() != 0 {
        sema_data_arity_diagnostic("encode", 0, args.len(), span, &diagnostics)
        sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        if type_args.len() != 0 -> sema_data_check_explicit_type_args("encode", type_args, 0, span, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_serde_type_is_admissible(environment, program, receiver_value.ty, SemaSerdeDirection.Encode) {
        &diagnostics.push(sema_error("E0905", span, "`{type_name(receiver_value.ty)}` does not implement `Encode`", "`.encode()` can only call the value's Encode contract", "derive `Encode` on this type, or write its Encode implementation"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tir_node(sema_dyn_type(), TExprKind.HandleMethod{receiver: receiver_value, operation: THandleOp.SerdeEncode, args: [TExpr]{}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
}

// (Rust method_calls.rs `FieldError.under`): one shared
// transform frames every error of a child Result under a path segment while
// keeping its success type. Generated codecs use it at each field boundary;
// it is an error-list helper, not another decode API.
fn sema_data_check_field_error_under(args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if args.len() != 2 {
        sema_data_arity_diagnostic("FieldError.under", 2, args.len(), span, &diagnostics)
        sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    segment := sema_data_check_argument("FieldError.under", 0, args[0], Type.String, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    inner :: sema_check_expression(args[1].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    segment_value :: segment ?? return SemaMethodSpecialCheck{handled: true, value: None}
    framed := false
    if inner.ty == .Result(_, failure) -> framed = failure == sema_data_decode_error()
    if !framed {
        &diagnostics.push(sema_error("E0905", expr_span(args[1].expr), "`FieldError.under` expects a result with `[FieldError]` errors", "the framing helper preserves the child result and prefixes every accumulated decode failure", "pass a typed decode/accessor result, such as `tree.field(\"name\")?.decode<T>()`"))
    }
    value := sema_tir_node(inner.ty, TExprKind.DecodeUnder{segment: segment_value, inner: inner}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
}

struct SemaDataAccessorContract {
    result_type: Type
    operation: THandleOp
    argument_types: [Type]
}

struct SemaDataValueAccessorContract {
    result_type: Type
    operation: THandleOp
}

fn sema_data_accessor_contract(method: String, receiver_ty: Type, alias: Bool) -> SemaDataAccessorContract? {
    data := if alias -> sema_dyn_type() else -> receiver_ty
    error := sema_data_decode_error()
    if method == {
        "field" -> Val(SemaDataAccessorContract{result_type: sema_data_result(data, error), operation: if alias -> THandleOp.JSONField else -> THandleOp.DynField, argument_types: [Type]{Type.String}})
        "at" -> Val(SemaDataAccessorContract{result_type: sema_data_result(data, error), operation: if alias -> THandleOp.JSONAt else -> THandleOp.DynAt, argument_types: [Type]{Type.Int}})
        "int" -> Val(SemaDataAccessorContract{result_type: sema_data_result(Type.Int, error), operation: if alias -> THandleOp.JSONInt else -> THandleOp.DynInt, argument_types: [Type]{}})
        "text" -> Val(SemaDataAccessorContract{result_type: sema_data_result(Type.String, error), operation: if alias -> THandleOp.JSONText else -> THandleOp.DynText, argument_types: [Type]{}})
        "bool" -> Val(SemaDataAccessorContract{result_type: sema_data_result(Type.Bool, error), operation: if alias -> THandleOp.JSONBool else -> THandleOp.DynBool, argument_types: [Type]{}})
        "float" -> Val(SemaDataAccessorContract{result_type: sema_data_result(Type.Float, error), operation: if alias -> THandleOp.JSONFloat else -> THandleOp.DynFloat, argument_types: [Type]{}})
        "to_text" -> Val(SemaDataAccessorContract{result_type: Type.Option{inner: Type.String}, operation: if alias -> THandleOp.JSONToText else -> THandleOp.DynToText, argument_types: [Type]{}})
        "equal_unordered" -> Val(SemaDataAccessorContract{result_type: Type.Bool, operation: if alias -> THandleOp.JSONEqualUnordered else -> THandleOp.DynEqualUnordered, argument_types: [Type]{Type.Named{name: "Dyn"}}})
        else -> None
    }
}

fn sema_data_try_accessor(receiver: Expr, receiver_value: TExpr, name: String, method: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    alias := name != "Dyn"
    contract :: sema_data_accessor_contract(method, receiver_value.ty, alias) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if type_args.len() != 0 {
        sema_data_check_explicit_type_args(method, type_args, 0, span, &diagnostics)
        sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if args.len() != contract.argument_types.len() {
        sema_data_arity_diagnostic(method, contract.argument_types.len(), args.len(), span, &diagnostics)
        sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    typed := [TExpr]{}
    loop (index, argument) in args {
        sema_data_check_labels(method, [CallArg]{argument}, [String]{}, span, &diagnostics)
        value :: sema_data_check_argument(method, index, argument, contract.argument_types[index], environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        &typed.push(value)
    }
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    sema_receiver_mark_forget(&state, receiver)
    value := sema_tir_node(contract.result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: contract.operation, args: typed}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
}

fn sema_data_dbvalue_accessor(method: String) -> SemaDataValueAccessorContract? {
    if method == {
        "int" -> Val(SemaDataValueAccessorContract{result_type: sema_data_result(Type.Int, Type.String), operation: THandleOp.DBValueInt})
        "float" -> Val(SemaDataValueAccessorContract{result_type: sema_data_result(Type.Float, Type.String), operation: THandleOp.DBValueFloat})
        "text" -> Val(SemaDataValueAccessorContract{result_type: sema_data_result(Type.String, Type.String), operation: THandleOp.DBValueText})
        "bool" -> Val(SemaDataValueAccessorContract{result_type: sema_data_result(Type.Bool, Type.String), operation: THandleOp.DBValueBool})
        "blob" -> Val(SemaDataValueAccessorContract{result_type: sema_data_result(Type.List{element: Type.IntN{signed: false, bits: 8}}, Type.String), operation: THandleOp.DBValueBlob})
        "is_null" -> Val(SemaDataValueAccessorContract{result_type: Type.Bool, operation: THandleOp.DBValueIsNull})
        else -> None
    }
}

fn sema_data_try_dbvalue_accessor(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    contract :: sema_data_dbvalue_accessor(method) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if type_args.len() != 0 {
        sema_data_check_explicit_type_args(method, type_args, 0, span, &diagnostics)
        sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if args.len() != 0 {
        sema_data_arity_diagnostic(method, 0, args.len(), span, &diagnostics)
        sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tir_node(contract.result_type, TExprKind.HandleMethod{receiver: receiver_value, operation: contract.operation, args: [TExpr]{}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
}

fn sema_data_without_user_tags(ty: Type) -> Type Never! {
    if ty == {
        .Tagged(marker, inner) -> {
            if marker == {
                .User(_) -> return sema_data_without_user_tags(inner)
                // copy: the untagged type is a new owned Type; `ty` stays the caller's.
                else -> return ty.copy()
            }
        }
        else -> return ty.copy()
    }
}

// Rust arg_expect.rs `expect_core_arg`: the argument is checked against the
// parameter type and a mismatch the checker did not already report is E0112.
fn sema_data_expect_core_arg(name: String, index: Int, required: Type, argument: CallArg, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    value :: sema_data_check_argument(name, index, argument, required, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return None
    if sema_call_host_callback_assignable(required, value.ty, environment, program) == (.Val(false)) {
        &diagnostics.push(sema_error("E0112", expr_span(argument.expr), "`{name}` wants {sema_type_show(required)} for argument {index + 1}, but this is {sema_type_show(value.ty)}", "every argument must match its parameter's type", sema_type_fix_hint(required, value.ty)))
        return None
    }
    Val(value)
}

struct SemaDataQueryCallback {
    value: TExpr?
    result: Type?
}

fn sema_data_fn_has_empty_effect_bound(ty: Type) -> Bool Never! {
    if ty == {
        .Fn(_, _, bound, _, _, _) -> {
            if bound == .Val(row) -> return row.len() == 0
            return false
        }
        else -> return false
    }
}

// Rust core_call.rs `infer_query_callback`: a one-row query callback (`map`,
// `min`, `max`, the join keys, `group_by`, a grouped reducer) whose result is
// open. The row seeds the lambda parameter and the callback keeps its own
// result type, so keys and values keep their nominal or exact types. The
// expected callback carries an explicit empty effect bound: a maintained query
// replays its callbacks after each source delta (`check_query_callback_effect`).
fn sema_data_infer_query_callback(call_name: String, row: Type, argument: CallArg, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDataQueryCallback {
    required :: Type.Fn{params: [Type]{row}, ret: None, effect_bound: Val([EffectRowEntry]{}), param_contract: None, call_metadata: None, return_view_provenance: None}
    checked :: sema_expression_lambda_collection_callback(argument.expr, Val(required), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaDataQueryCallback{value: None, result: None}
    callback_span :: expr_span(argument.expr)
    if checked.ty == {
        .Fn(params, ret, _, _, _, _) -> {
            if !sema_data_fn_has_empty_effect_bound(checked.ty) {
                &diagnostics.push(sema_error("E2476", callback_span, "live query callback `{call_name}` is not replay-safe", "a maintained query replays callbacks after each source delta, so the callback must have an explicit empty effect bound", "remove the effectful operation, or declare/use a pure callback over the tracked row"))
            }
            if params.len() != 1 || params[0] != row {
                &diagnostics.push(sema_error("E0112", callback_span, "`{call_name}` wants a callback over {sema_type_show(row)} for argument 1", "a query callback receives exactly one row", "write `row -> …`"))
            }
            return SemaDataQueryCallback{value: Val(checked), result: ret}
        }
        else -> {
            &diagnostics.push(sema_error("E0112", callback_span, "`{call_name}` wants a callback for argument 1, but this is {sema_type_show(checked.ty)}", "query reducers take one callback over the row", "pass a lambda such as `row -> row.field`"))
            return SemaDataQueryCallback{value: None, result: None}
        }
    }
}

fn sema_data_query_push_argument(argument: CallArg, value: TExpr?, source_args: &[CallArg], argument_types: &[Type], typed: &[TExpr]) -> Bool {
    checked :: value ?? return false
    &source_args.push(argument)
    &argument_types.push(checked.ty)
    &typed.push(checked)
    true
}

fn sema_data_query_receiver(name: String, parameters: [Type], method: String) -> String Never! {
    if sema_data_nominal_is(name, "DataTracked") && parameters.len() == 2 && (method == "query" || method == "insert" || method == "replace" || method == "remove") -> return "DataTracked"
    if sema_data_nominal_is(name, "DataWatch") && parameters.len() == 1 && (method == "get" || method == "status" || method == "cancel") -> return "DataWatch"
    if sema_data_nominal_is(name, "Query") && parameters.len() == 1 && (method == "filter" || method == "sort_by" || method == "map" || method == "min" || method == "max" || method == "inner_join" || method == "left_join" || method == "collect" || method == "plan" || method == "group_by" || method == "watch") -> return "Query"
    if sema_data_nominal_is(name, "DataGroupedQuery") && parameters.len() == 2 && (method == "count" || method == "sum" || method == "mean") -> return "DataGroupedQuery"
    ""
}

fn sema_data_query_arity(method: String) -> Int Never! {
    if method == {
        "insert" | "remove" | "filter" | "sort_by" | "map" | "min" | "max" | "group_by" | "sum" | "mean" -> 1
        "replace" -> 2
        "inner_join" | "left_join" -> 3
        else -> 0
    }
}

fn sema_data_group_sum_numeric(value: Type?) -> Bool Never! {
    found :: value ?? return false
    if found == {
        .Int | .IntN(_, _) | .Float | .Float32 -> return true
        else -> return false
    }
}

// Rust method_calls.rs (the Query family of `infer_method_call`): `Query<T>`
// methods keep the deferred carrier and only `collect` turns it back into a
// list. `group_by` yields the internal `DataGroupedQuery<T, K>` carrier whose
// reducers return `Query<Group<K, V>>`; keys and values keep the callback
// result types, never a String/Float projection. `DataTracked` and `DataWatch`
// are the maintained sources and live views of the same rows. Every call lowers
// onto its receiver Core row with the receiver as the first argument.
fn sema_data_try_query_method(receiver: Expr, receiver_value: TExpr, name: String, parameters: [Type], method: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    receiver_type :: sema_data_query_receiver(name, parameters, method)
    if receiver_type == "" -> return SemaMethodSpecialCheck{handled: false, value: None}
    complete := true
    if type_args.len() != 0 {
        sema_data_check_explicit_type_args("{receiver_type}.{method}", type_args, 0, span, &diagnostics)
        complete = false
    }
    want :: sema_data_query_arity(method)
    if args.len() != want {
        &diagnostics.push(sema_wrong_core_arity(method, want, args.len(), span))
        complete = false
    }
    if args.len() > want -> sema_data_check_discarded_arguments(args.slice(want, args.len()), environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    row :: parameters[0]
    data_error :: Type.Named{name: sema_data_source_type_name(environment, program, "DataError")}
    source_args := [CallArg]{CallArg{convention: AccessConvention.Read, expr: receiver, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false}}
    argument_types := [Type]{receiver_value.ty}
    typed := [TExpr]{receiver_value}
    call_type_args := [Type]{}
    result_type := Type.Named{name: "Unit"}
    if receiver_type == "DataTracked" {
        key :: parameters[1]
        if method == "query" {
            result_type = Type.Apply{name: "Query", args: [Type]{row}}
        } else {
            slots := if method == {
                "insert" -> [Type]{row}
                "replace" -> [Type]{key, row}
                else -> [Type]{key}
            }
            loop index in 0..<slots.len() {
                if index >= args.len() -> break
                value :: sema_data_expect_core_arg(method, index, slots[index], args[index], environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if !sema_data_query_push_argument(args[index], value, &source_args, &argument_types, &typed) -> complete = false
            }
            result_type = Type.Result{ok: Type.Named{name: "Unit"}, err: data_error}
        }
    }
    if receiver_type == "DataWatch" {
        result_type = if method == {
            "get" -> Type.Result{ok: Type.List{element: row}, err: data_error}
            "status" -> Type.Named{name: sema_data_source_type_name(environment, program, "DataWatchStatus")}
            else -> Type.Named{name: "Unit"}
        }
    }
    if receiver_type == "Query" {
        if method == "filter" || method == "sort_by" {
            // Ordinary Query combinators collect later; the empty effect bound
            // belongs to the live `.watch()` callbacks.
            callback_result :: if method == "filter" -> Type.Bool else -> Type.String
            callback_type :: Type.Fn{params: [Type]{row}, ret: Val(callback_result), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
            if args.len() > 0 {
                value :: sema_data_expect_core_arg(method, 0, callback_type, args[0], environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if !sema_data_query_push_argument(args[0], value, &source_args, &argument_types, &typed) -> complete = false
            }
            result_type = Type.Apply{name: name, args: [Type]{row}}
        }
        if method == "map" || method == "min" || method == "max" {
            value_type := row
            if args.len() > 0 {
                callback :: sema_data_infer_query_callback(method, row, args[0], environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if callback.result == .Val(found) -> value_type = found
                if !sema_data_query_push_argument(args[0], callback.value, &source_args, &argument_types, &typed) -> complete = false
            }
            result_type = Type.Apply{name: name, args: [Type]{value_type}}
        }
        if method == "inner_join" || method == "left_join" {
            right_row := row
            if args.len() > 0 {
                other := sema_check_expression(args[0].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if other == .Val(value) {
                    query_row := Type?{None}
                    if sema_data_without_user_tags(value.ty) == {
                        .Apply(other_name, other_parameters) -> {
                            if sema_data_nominal_is(other_name, "Query") && other_parameters.len() == 1 -> query_row = Val(other_parameters[0])
                        }
                        else -> {}
                    }
                    if query_row == .Val(found) {
                        right_row = found
                    } else {
                        &diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{method}` wants a Query as argument 1, but this is {sema_type_show(value.ty)}", "keyed joins combine two typed deferred queries", "pass another `Query<Row>` value"))
                        other = None
                    }
                }
                if !sema_data_query_push_argument(args[0], other, &source_args, &argument_types, &typed) -> complete = false
            }
            if args.len() > 1 {
                left_key :: sema_data_infer_query_callback(method, row, args[1], environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if !sema_data_query_push_argument(args[1], left_key.value, &source_args, &argument_types, &typed) -> complete = false
            }
            if args.len() > 2 {
                right_key :: sema_data_infer_query_callback(method, right_row, args[2], environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if !sema_data_query_push_argument(args[2], right_key.value, &source_args, &argument_types, &typed) -> complete = false
            }
            joined_right :: if method == "left_join" -> Type.Option{inner: right_row} else -> right_row
            result_type = Type.Apply{name: name, args: [Type]{Type.Apply{name: "DataJoin", args: [Type]{row, joined_right}}}}
        }
        if method == "collect" {
            call_type_args = [Type]{row}
            result_type = sema_data_result(Type.List{element: row}, data_error)
        }
        if method == "plan" -> result_type = Type.List{element: Type.String}
        if method == "group_by" {
            key := Type.String
            if args.len() > 0 {
                callback :: sema_data_infer_query_callback(method, row, args[0], environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if callback.result == .Val(found) -> key = found
                if !sema_data_query_push_argument(args[0], callback.value, &source_args, &argument_types, &typed) -> complete = false
            }
            result_type = Type.Apply{name: "DataGroupedQuery", args: [Type]{row, key}}
        }
        if method == "watch" -> result_type = Type.Result{ok: Type.Apply{name: "DataWatch", args: [Type]{row}}, err: data_error}
    }
    if receiver_type == "DataGroupedQuery" {
        key :: parameters[1]
        value_type := Type.Int
        if method == "sum" || method == "mean" {
            value := Type?{None}
            if args.len() > 0 {
                callback :: sema_data_infer_query_callback(method, row, args[0], environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                value = callback.result
                if !sema_data_query_push_argument(args[0], callback.value, &source_args, &argument_types, &typed) -> complete = false
            }
            if method == "sum" {
                if !sema_data_group_sum_numeric(value) {
                    shown :: if value == .Val(found) -> sema_type_show(found) else -> "missing"
                    &diagnostics.push(sema_error("E0112", span, "`sum` wants an Int, fixed-width Int, Float, or F32 result, but this is {shown}", "grouped sum follows the runtime numeric domain and does not add arbitrary values", "return a numeric row value, or use `count` for cardinality"))
                    complete = false
                }
                if value == .Val(found) -> value_type = found
            } else {
                if value == .Val(found) {
                    if found != Type.Float {
                        &diagnostics.push(sema_error("E0112", span, "`mean` wants Float for argument 1's result, but this is {sema_type_show(found)}", "a grouped mean follows the Float numeric rules; it does not widen integers or units silently", "return a Float from the value callback, or use `sum`"))
                        complete = false
                    }
                }
                value_type = Type.Float
            }
        }
        result_type = Type.Apply{name: "Query", args: [Type]{Type.Apply{name: "Group", args: [Type]{key, value_type}}}}
    }
    if !complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    record :: core_receiver_method(receiver_type, method) ?? {
        &diagnostics.push(sema_error("E0003", span, "checked query method `{method}` has no canonical receiver Core row", "every checked query method lowers onto its receiver Core row", "repair the Core registry receiver rows"))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    value :: sema_data_core_emit(record, "{receiver_type}.{method}", source_args, argument_types, typed, call_type_args, result_type, span, expected, environment, program, &scopes, &state, &context, &diagnostics)
    SemaMethodSpecialCheck{handled: true, value: value}
}

fn sema_call_try_data_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    resolved_ty := sema_call_resolved_type(receiver_value.ty, environment, program)
    if resolved_ty == .Apply(name, parameters) {
        query :: sema_data_try_query_method(receiver, receiver_value, name, parameters, method, args, type_args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        if query.handled -> return query
    }
    if method == "encode" -> return sema_data_check_encode(receiver, receiver_value, args, type_args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    if resolved_ty == {
        .Named(name) -> {
            if sema_data_is_json_name(name) {
                if name == "Dyn" {
                    special :: sema_dyn_try_member(receiver, receiver_value, method, args, type_args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                    if special.handled -> return special
                }
                if method == "decode" {
                    if args.len() != 0 {
                        sema_data_arity_diagnostic("Dyn.decode<T>", 0, args.len(), span, &diagnostics)
                        sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                        return SemaMethodSpecialCheck{handled: true, value: None}
                    }
                    if !sema_data_check_explicit_type_args("Dyn.decode<T>", type_args, 1, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
                    target := type_args[0]
                    if program.registration_graph == .Val(graph) -> target = sema_type_resolve_declared_with_generics(graph, target, environment.module_identity, environment.generic_params)
                    if !sema_serde_type_is_admissible(environment, program, target, SemaSerdeDirection.Decode) {
                        &diagnostics.push(sema_error("E0905", span, "`{type_name(target)}` does not implement `Decode`", "`Dyn.decode<T>()` can only call the target type's Decode contract", "derive `Decode` on this type, or write its Decode implementation"))
                    }
                    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
                    value := sema_tir_node(sema_data_result(target, sema_data_decode_error()), TExprKind.HandleMethod{receiver: receiver_value, operation: THandleOp.DynDecode{ty: target}, args: [TExpr]{}}, span)
                    return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
                }
                return sema_data_try_accessor(receiver, receiver_value, name, method, args, type_args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            }
            if name == "DBValue" -> return sema_data_try_dbvalue_accessor(receiver, receiver_value, method, args, type_args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            // `.template()`/`.params()` project the checked
            // `SQL` value (the Rust reference's TypedText SQLTemplate/SQLParams).
            if name == "SQL" && (method == "template" || method == "params") {
                if args.len() != 0 -> sema_data_arity_diagnostic(method, 0, args.len(), span, &diagnostics)
                if type_args.len() != 0 -> sema_data_check_explicit_type_args(method, type_args, 0, span, &diagnostics)
                sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
                ret := if method == "template" -> Type.String else -> Type.List{element: sema_data_value_type()}
                form :: if method == "template" -> TTypedTextForm.SQLTemplate else -> TTypedTextForm.SQLParams
                return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected_owned(sema_tir_node(ret, TExprKind.HostCall{call: THostCall.TypedText{kind: form, argument: receiver_value}}, span), expected, environment, program, &diagnostics)}
            }
            // `.text()` reads the escaped HTML as a String copy
            // (the Rust reference's `HTML.text` route).
            if name == "HTML" && method == "text" {
                if args.len() != 0 -> sema_data_arity_diagnostic(method, 0, args.len(), span, &diagnostics)
                if type_args.len() != 0 -> sema_data_check_explicit_type_args(method, type_args, 0, span, &diagnostics)
                sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
                return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected_owned(sema_tir_node(Type.String, TExprKind.Clone{value: receiver_value, fact: MIRCopyFact.Materialize}, span), expected, environment, program, &diagnostics)}
            }
            if name == "RealtimeStream" {
                ret := if {
                    method == "next_deadline" && args.len() == 0 -> Val(Type.Named{name: "Instant"})
                    method == "receipt" && args.len() == 0 -> Val(Type.Named{name: "RealtimeReceipt"})
                    method == "cancel" && args.len() == 0 -> Val(Type.Named{name: "Unit"})
                    method == "is_cancelled" && args.len() == 0 -> Val(Type.Bool)
                    else -> None
                }
                if ret != None {
                    if type_args.len() != 0 -> sema_data_check_explicit_type_args("RealtimeStream.{method}", type_args, 0, span, &diagnostics)
                    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
                    operation := if {
                        method == "next_deadline" -> THandleOp.RealtimeNextDeadline
                        method == "receipt" -> THandleOp.RealtimeReceipt
                        method == "cancel" -> THandleOp.RealtimeCancel
                        else -> THandleOp.RealtimeIsCancelled
                    }
                    value := sema_tir_node(ret ?? Type.Named{name: "Unit"}, TExprKind.HandleMethod{receiver: receiver_value, operation: operation, args: [TExpr]{}}, span)
                    return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
                }
            }
            // `suite.run()` runs the package's `#Test` blocks on the harness the
            // `Test` value carries and returns the failure count.
            if name == "Test" && method == "run" {
                if args.len() != 0 -> sema_data_arity_diagnostic("Test.run", 0, args.len(), span, &diagnostics)
                if type_args.len() != 0 -> sema_data_check_explicit_type_args("Test.run", type_args, 0, span, &diagnostics)
                sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
                value := sema_tir_node(Type.Int, TExprKind.HandleMethod{receiver: receiver_value, operation: THandleOp.TestSuiteRun, args: [TExpr]{}}, span)
                return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
            }
        }
        .Apply(name, parameters) -> {
            if name == "DataStream" && parameters.len() == 1 && method == "next" {
                if args.len() != 0 -> sema_data_arity_diagnostic("DataStream.next", 0, args.len(), span, &diagnostics)
                if type_args.len() != 0 -> sema_data_check_explicit_type_args("DataStream.next", type_args, 0, span, &diagnostics)
                sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
                ret := sema_data_result(Type.Option{inner: parameters[0]}, Type.Named{name: "DataError"})
                value := sema_tir_node(ret, TExprKind.HandleMethod{receiver: receiver_value, operation: THandleOp.DataStreamNext, args: [TExpr]{}}, span)
                return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
            }
            if name == "Loadable" && parameters.len() == 2 {
                contract := if {
                    method == "is_loading" || method == "is_loaded" || method == "is_failed" || method == "is_idle" -> Val(Type.Bool)
                    method == "loaded" -> Val(Type.Option{inner: parameters[0]})
                    method == "or_else" -> Val(parameters[0])
                    else -> None
                }
                if contract != None {
                    if args.len() != (if method == "or_else" -> 1 else -> 0) -> sema_data_arity_diagnostic("Loadable.{method}", if method == "or_else" -> 1 else -> 0, args.len(), span, &diagnostics)
                    if type_args.len() != 0 -> sema_data_check_explicit_type_args("Loadable.{method}", type_args, 0, span, &diagnostics)
                    typed := [TExpr]{}
                    if args.len() > 0 {
                        value :: sema_data_check_argument("Loadable.or_else", 0, args[0], parameters[0], environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                        if value == .Val(checked) -> &typed.push(checked)
                    }
                    loop index in 1..<args.len() -> _ := sema_check_expression(args[index].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
                    if !sema_ownership_check_call_receiver(&state, receiver, AccessConvention.Read, scopes, span, &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
                    operation := THandleOp.LoadableMethod{method: method}
                    value := sema_tir_node(contract ?? Type.Named{name: "Unit"}, TExprKind.HandleMethod{receiver: receiver_value, operation: ^operation, args: ^typed}, span)
                    return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
                }
            }
            if parameters.len() == 1 && method == "force" && (name == "ExpiringValue" || (core_source_owns_type(name) && core_identity_is(name, "core.time", "ExpiringValue"))) {
                &diagnostics.push(sema_error("E0511", span, "`ExpiringValue.force` bypasses expiry checking", "TTL-wrapped values must use fallible `get(clock)` so expired access is handled explicitly", "use `.get(clock)` and handle `Expired`"))
                return SemaMethodSpecialCheck{handled: true, value: None}
            }
        }
        else -> {}
    }
    SemaMethodSpecialCheck{handled: false, value: None}
}

fn sema_data_literal_expected(ty: Type, variant: String) -> Type? {
    if ty == (Type.Named{name: "DBValue"}) {
        if variant == {
            "Null" -> { return None }
            "Int" -> { return Val(Type.Int) }
            "Float" -> { return Val(Type.Float) }
            "Text" -> { return Val(Type.String) }
            "Bool" -> { return Val(Type.Bool) }
            "Blob" -> { return Val(Type.List{element: Type.IntN{signed: false, bits: 8}}) }
            else -> { return None }
        }
    }
    if !sema_data_is_json_name(sema_data_type_name(ty) ?? "") -> return None
    if variant == {
        "Null" -> { return None }
        "Bool" -> { return Val(Type.Bool) }
        "Int" -> { return Val(Type.Int) }
        "Float" -> { return Val(Type.Float) }
        "Text" -> { return Val(Type.String) }
        "Bytes" -> { return Val(Type.List{element: Type.IntN{signed: false, bits: 8}}) }
        "DateTime" -> { return Val(Type.Named{name: "ZonedDateTime"}) }
        "Array" -> { return Val(Type.List{element: sema_dyn_type()}) }
        "Object" -> { return Val(Type.Map{key: Type.String, key_span: None, value: sema_dyn_type()}) }
        else -> { return None }
    }
}

// An object is its fields in arrival order, the pair list
// `[(key: String, value: Dyn)]`. A list literal or a local of that type is
// handed over in list order; anything else is a `[String: Dyn]` Map, which
// hands over its sorted order.
fn sema_data_object_pairs_type() -> Type Never! {
    Type.List{element: Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "key", ty: Type.String}, TypeTupleField{name: "value", ty: sema_dyn_type()}}}}
}

fn sema_data_object_pairs_argument(argument: Expr, scopes: SemaScopeTable) -> Bool {
    if argument == {
        .ListLit(_, _) -> return true
        .Ident(name, _) -> {
            index :: sema_scope_resolve_index(scopes, name) ?? return false
            ty :: scopes.bindings[index].symbol.ty ?? return false
            return sema_data_is_object_pairs_type(ty)
        }
        else -> return false
    }
}

// Pattern bindings spell the value type `Data`; declared locals spell `Dyn`.
fn sema_data_is_object_pairs_type(ty: Type) -> Bool Never! {
    if ty == {
        .List(element) -> {
            if element == {
                .Tuple(fields) -> return fields.len() == 2 && fields[0].name == "key" && fields[0].ty == Type.String && fields[1].name == "value" && sema_data_is_json_name(sema_data_type_name(fields[1].ty) ?? "")
                else -> return false
            }
        }
        else -> return false
    }
}

fn sema_data_literal_variant_valid(ty: Type, variant: String) -> Bool Never! {
    if ty == (Type.Named{name: "DBValue"}) -> return variant == "Null" || variant == "Int" || variant == "Float" || variant == "Text" || variant == "Bool" || variant == "Blob"
    sema_data_is_json_name(sema_data_type_name(ty) ?? "") && (variant == "Null" || variant == "Bool" || variant == "Int" || variant == "Float" || variant == "Text" || variant == "Bytes" || variant == "DateTime" || variant == "Array" || variant == "Object")
}

fn sema_data_argument_is_borrowed(argument: Expr, scopes: SemaScopeTable) -> Bool Never! {
    if argument == {
        .Ident(name, _) -> {
            index :: sema_scope_resolve_index(scopes, name) ?? return false
            return sema_ownership_binding_is_borrowed_param(scopes.bindings[index])
        }
        .Field(base, _, _) | .Index(base, _, _, _) | .Paren(base, _) -> return sema_data_argument_is_borrowed(base, scopes)
        else -> false
    }
}

fn sema_data_dbvalue_payload_live_after(ty: Type, argument: Expr, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Bool {
    if ty != (Type.Named{name: "DBValue"}) -> return false
    if argument == {
        .Ident(name, _) -> { return sema_ownership_name_live_after(name, &tail_store, &context) }
        else -> { return false }
    }
}

// `HTML.raw("…")` is the audited escape from a runtime
// String into checked HTML. `HTML` names the type here; the caller routes
// only an owner no local value shadows (the Rust reference's typed-text raw).
fn sema_call_try_html_raw(owner: String, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if owner != "HTML" || method != "raw" -> return SemaMethodSpecialCheck{handled: false, value: None}
    if args.len() != 1 {
        &diagnostics.push(sema_error("E0103", span, "`HTML.raw()` takes exactly one argument", "`.raw()` wraps one already-audited `String` as the escape hatch", "write `HTML.raw(text)`"))
        sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    text :: sema_check_expression(args[0].expr, Val(Type.String), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    value := sema_tir_node(Type.Named{name: "HTML"}, TExprKind.HostCall{call: THostCall.TypedText{kind: TTypedTextForm.HTMLRaw, argument: text}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
}

fn sema_call_try_data_literal(ty: Type, variant: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    known_type :: sema_data_type_name(ty) ?? ""
    if ty != (Type.Named{name: "DBValue"}) && !sema_data_is_json_name(known_type) -> return SemaMethodSpecialCheck{handled: false, value: None}
    // Rust `check_core_json_lit`: `Dyn.object()` is an empty object and
    // `Dyn.from(value)` calls the value's Encode contract.
    if sema_data_is_json_name(known_type) && (variant == "object" || variant == "from") {
        count :: if variant == "object" -> 0 else -> 1
        if args.len() != count {
            sema_data_arity_diagnostic("Dyn.{variant}", count, args.len(), span, &diagnostics)
            sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        if variant == "object" {
            map :: sema_tir_node(Type.Map{key: Type.String, key_span: None, value: sema_dyn_type()}, TExprKind.MapLit{entries: [TMapEntry]{}}, span)
            value :: sema_tir_node(sema_dyn_type(), TExprKind.JSONLit{variant: "Object", arg: Val(map), clone_arg: false}, span)
            return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected_owned(^value, expected, environment, program, &diagnostics)}
        }
        sema_data_check_labels("Dyn.from", args, [String]{}, span, &diagnostics)
        if args[0].convention == AccessConvention.Move -> &diagnostics.push(sema_error("E0203", args[0].span, "a value was passed with the move marker `^` to a parameter that does not consume", "Dyn.from reads the value's Encode contract", "remove the move marker `^` here"))
        value :: sema_check_expression(args[0].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        return sema_data_check_encode(args[0].expr, value, [CallArg]{}, [Type]{}, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    }
    private_number :: sema_data_is_json_name(known_type) && variant == "Number" && context.unsafe_depth > 0 && environment.module_name == "__core_encoding_stream"
    if !private_number && !sema_data_literal_variant_valid(ty, variant) {
        &diagnostics.push(sema_error("E0304", span, "`{type_name(ty)}` has no variant `{variant}`", "Dyn and DBValue expose closed compiler-owned literal variants", "check the variant name"))
        sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    expected_payload := sema_data_literal_expected(ty, variant)
    if private_number -> expected_payload = Val(Type.String)
    // (Rust `is_object_pairs_arg`): a pair-list literal or
    // local keeps its arrival order; anything else is read as a Map.
    if variant == "Object" && ty != (Type.Named{name: "DBValue"}) && args.len() == 1 && sema_data_object_pairs_argument(args[0].expr, scopes) -> expected_payload = Val(sema_data_object_pairs_type())
    expected_count := if expected_payload == None -> 0 else -> 1
    if args.len() != expected_count {
        sema_data_arity_diagnostic("{type_name(ty)}.{variant}", expected_count, args.len(), span, &diagnostics)
        sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    payload := TExpr?{None}
    clone_arg := false
    if expected_payload == .Val(want) {
        argument :: args[0]
        value :: sema_check_expression(argument.expr, Val(want), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
        payload = Val(value)
        borrowed := sema_data_argument_is_borrowed(argument.expr, scopes)
        if argument.convention != AccessConvention.Move && borrowed && !sema_ownership_type_is_copy(want) {
            if sema_ownership_type_cloneable(want) == (Val(true)) -> clone_arg = true
            &diagnostics.push(sema_error("E0209", argument.span, "implicit clone of this borrowed payload", "the Dyn/DBValue constructor stores its own value, so borrowed storage cannot be moved", "copy the payload explicitly before constructing the value"))
        }
        if argument.convention != AccessConvention.Move && !borrowed && !sema_ownership_type_is_copy(want) && sema_data_dbvalue_payload_live_after(ty, argument.expr, &tail_store, &context) && sema_ownership_type_cloneable(want) == (Val(true)) -> clone_arg = true
        if argument.convention == AccessConvention.Move -> clone_arg = false
        taken :: if argument.convention == AccessConvention.Move -> Expr.Place{value: argument.expr, access: PlaceAccess.Take, span: argument.span} else -> argument.expr
        if !clone_arg && !sema_ownership_consume_expression(&state, taken, scopes, "`{type_name(ty)}.{variant}`", &diagnostics) -> return SemaMethodSpecialCheck{handled: true, value: None}
        }
    result_ty := if ty == (Type.Named{name: "DBValue"}) -> sema_data_value_type() else -> sema_dyn_type()
    value := sema_tir_expr(result_ty, if ty == (Type.Named{name: "DBValue"}) -> TExprKind.DBValueLit{variant: variant, arg: payload, clone_arg: clone_arg} else -> TExprKind.JSONLit{variant: variant, arg: payload, clone_arg: clone_arg}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, &diagnostics)}
}

fn sema_call_try_data_stream_core_call(module_name: String, member: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    updated_args := args
    if module_name != "core.data.stream" || (member != "from_items" && member != "next" && member != "collect" && member != "cancel" && member != "skip" && member != "take_n" && member != "len" && member != "is_empty") -> return SemaDirectSpecialCheck{handled: false, value: None}
    expected_count := if member == "skip" || member == "take_n" -> 2 else -> 1
    if updated_args.len() != expected_count -> sema_data_arity_diagnostic("{module_name}.{member}", expected_count, updated_args.len(), span, &diagnostics)
    type_args_ok := true
    if {
        member == "from_items" -> {
            if type_args.len() > 1 {
                type_args_ok = false
                sema_data_check_explicit_type_args(member, type_args, 1, span, &diagnostics)
            }
        }
        type_args.len() != 0 -> {
            type_args_ok = false
            sema_data_check_explicit_type_args(member, type_args, 0, span, &diagnostics)
        }
    }
    if updated_args.len() == 0 -> return SemaDirectSpecialCheck{handled: true, value: None}
    typed := [TExpr]{}
    row := Type?{None}
    if {
        member == "from_items" -> {
            if type_args.len() == 1 -> row = Val(if program.registration_graph == .Val(graph) -> sema_type_resolve_declared_with_generics(graph, type_args[0], environment.module_identity, environment.generic_params) else -> type_args[0])
            list_expected := row.map((value) -> Type.List{element: value})
            first :: sema_check_expression(updated_args[0].expr, list_expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
            if row == None {
                if first.ty == {
                    .List(element) -> { row = Val(element) }
                    else -> {
                        &diagnostics.push(sema_error("E0112", updated_args[0].span, "`from_items` expects a typed row list, got `{type_name(first.ty)}`", "DataStream preserves one element type", "pass a `[T]` value or write `from_items<T>(items)`"))
                        return SemaDirectSpecialCheck{handled: true, value: None}
                    }
                }
            }
            list_ty := Type.List{element: row ?? Type.Named{name: "Unit"}}
            checked :: sema_expr_expected(first, Val(list_ty), environment, program, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
            &typed.push(checked)
        }
        else -> {
            first :: sema_check_expression(updated_args[0].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
            if first.ty == {
                .Apply(name, parameters) -> {
                    if name == "DataStream" && parameters.len() == 1 {
                        row = Val(parameters[0])
                    }
                }
                else -> {}
            }
            if row == None {
                &diagnostics.push(sema_error("E0112", updated_args[0].span, "`{member}` expects a `DataStream<T>` handle, got `{type_name(first.ty)}`", "stream operations preserve the row type carried by the stream", "pass a `DataStream<T>` value"))
                return SemaDirectSpecialCheck{handled: true, value: None}
            }
            &typed.push(first)
        }
    }
    loop index in 1..<updated_args.len() {
        value :: sema_data_check_argument(member, index, updated_args[index], Type.Int, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        &typed.push(value)
    }
    if !type_args_ok -> return SemaDirectSpecialCheck{handled: true, value: None}
    row_type :: row ?? Type.Named{name: "Unit"}
    result_type := if {
        member == "from_items" -> Type.Apply{name: "DataStream", args: [Type]{row_type}}
        member == "next" -> sema_data_result(Type.Option{inner: row_type}, Type.Named{name: "DataError"})
        member == "collect" || member == "take_n" -> sema_data_result(Type.List{element: row_type}, Type.Named{name: "DataError"})
        member == "cancel" || member == "skip" -> Type.Named{name: "Unit"}
        member == "len" -> Type.Int
        else -> Type.Bool
    }
    record :: sema_call_core_record(module_name, member, updated_args.len(), span, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    fallibility := if result_type == {.Result(ok, err) -> TFailureCarrier.Result{success: ok, error: err} else -> TFailureCarrier.Infallible}
    effective_type_args := if member == "from_items" -> [Type]{row_type} else -> [Type]{}
    params := [SemaCallParam]{}
    call_args := [TExpr]{}
    loop (index, value) in typed {
        access := sema_call_core_access(record, index) ?? AccessConvention.Read
        &params.push(SemaCallParam{label: "", name: "arg{index}", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: access, ty: Val(value.ty), variadic: false})
        &call_args.push(sema_services_apply_access(value, access))
    }
    ownership := sema_ownership_check_call_arguments(&state, "{module_name}.{member}", params, &updated_args, scopes, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return SemaDirectSpecialCheck{handled: true, value: None}
    widen_to_vec := (loop _ in call_args -> false)
    if !sema_call_core_record_effects(record, span, effective_type_args, result_type, fallibility, [FunctionDefaultRef]{}, &scopes, &context, environment, program, &diagnostics) -> return SemaDirectSpecialCheck{handled: true, value: None}
    value :: sema_call_core_tir(record, call_args, span, effective_type_args, widen_to_vec, None, result_type, fallibility, expected, environment, program, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    SemaDirectSpecialCheck{handled: true, value: Val(value)}
}

fn sema_data_core_default_call(type_name: String, method: String, span: Span) -> Expr Never! {
    Expr.MethodCall{receiver: Expr.Ident{name: type_name, span: span}, method: method, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, recv_type: None, resolved_ret: None}
}

fn sema_data_core_param(label: String, ty: Type, convention: AccessConvention, zone: ParamZone, default: Expr?) -> SemaCallParam Never! {
    SemaCallParam{label: label, name: label, zone: zone, default: default, default_ref: None, convention: convention, ty: Val(ty), variadic: false}
}

fn sema_data_core_param_access(record: CoreCallRecord, index: Int, span: Span, diagnostics: &[Diagnostic]) -> AccessConvention? {
    if sema_call_core_access(record, index) == .Val(access) -> return Val(access)
    if index >= record.signature.arity && index < record.signature.max_arity -> return Val(AccessConvention.Read)
    &diagnostics.push(sema_error("E0003", span, "`{record.module_name}.{record.member}` has no ownership convention for parameter {index}", "checked Core arguments must use the registry's canonical access metadata", "repair the Core registry signature"))
    None
}

fn sema_data_core_emit(record: CoreCallRecord, call_name: String, source_args: [CallArg], argument_types: [Type], typed_args: [TExpr], type_args: [Type], result_type: Type, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    updated_source_args := source_args
    if argument_types.len() != typed_args.len() || updated_source_args.len() != typed_args.len() {
        &diagnostics.push(sema_error("E0003", span, "`{call_name}` has an incomplete checked argument list", "CoreCall TIR stores every checked argument in the registry ABI order", "repair the Core call body"))
        return None
    }
    params := [SemaCallParam]{}
    arguments := [TExpr]{}
    loop (index, value) in typed_args {
        access :: sema_data_core_param_access(record, index, span, &diagnostics) ?? return None
        &params.push(sema_data_core_param("arg{index}", argument_types[index], access, ParamZone.PositionalOnly, None))
        &arguments.push(sema_services_apply_access(value, access))
    }
    ownership := sema_ownership_check_call_arguments(&state, call_name, params, &updated_source_args, scopes, &diagnostics)
    if !ownership.accepted || !ownership.complete -> return None
    fallibility := sema_call_failure_carrier(Val(result_type))
    if !sema_call_core_record_effects(record, span, type_args, result_type, fallibility, [FunctionDefaultRef]{}, &scopes, &context, environment, program, &diagnostics) -> return None
    widen_to_vec := (loop _ in arguments -> false)
    sema_call_core_tir(record, arguments, span, type_args, widen_to_vec, None, result_type, fallibility, expected, environment, program, &diagnostics)
}

// Rust core_call.rs `exactly_one_type_arg`: a typed decode/query call names one
// target type.
fn sema_data_core_target_type(type_args: [Type], name: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Type? {
    if type_args.len() != 1 {
        &diagnostics.push(sema_error("E0119", span, "`{name}` expects exactly one type argument, got {type_args.len()}", "a typed decode call needs one target type", "write `{name}<Target>(...)` with one target type"))
        return None
    }
    target := type_args[0]
    if program.registration_graph == .Val(graph) -> target = sema_type_resolve_declared_with_generics(graph, target, environment.module_identity, environment.generic_params)
    Val(target)
}

struct SemaDataCoreDecodeContract {
    call_member: String
    argument_types: [Type]
    result_type: Type
    type_args: [Type]
    optional_options: Bool
}

fn sema_data_core_decode_contract(module_name: String, member: String, target: Type) -> SemaDataCoreDecodeContract? {
    if module_name == "core.db" && member == "decode" {
        return Val(SemaDataCoreDecodeContract{call_member: "decode", argument_types: [Type]{Type.Map{key: Type.String, key_span: None, value: Type.Named{name: "DBValue"}}}, result_type: Type.Result{ok: target, err: Type.List{element: Type.Named{name: "FieldError"}}}, type_args: [Type]{target}, optional_options: false})
    }
    if module_name == "core.sys" && member == "decode" {
        return Val(SemaDataCoreDecodeContract{call_member: "decode", argument_types: [Type]{Type.String, Type.String, Type.List{element: Type.String}}, result_type: Type.Result{ok: target, err: Type.List{element: Type.Named{name: "FieldError"}}}, type_args: [Type]{target}, optional_options: false})
    }
    if module_name == "core.encoding.json" && member == "decode" {
        return Val(SemaDataCoreDecodeContract{call_member: "decode", argument_types: [Type]{Type.String}, result_type: Type.Result{ok: target, err: Type.List{element: Type.Named{name: "FieldError"}}}, type_args: [Type]{target}, optional_options: false})
    }
    if module_name == "core.encoding.csv" && member == "decode" {
        return Val(SemaDataCoreDecodeContract{call_member: "decode", argument_types: [Type]{Type.String}, result_type: Type.Result{ok: Type.List{element: target}, err: Type.List{element: Type.Named{name: "FieldError"}}}, type_args: [Type]{target}, optional_options: false})
    }
    if (module_name == "core.encoding.toml" || module_name == "core.encoding.yaml") && member == "decode" {
        return Val(SemaDataCoreDecodeContract{call_member: "decode", argument_types: [Type]{Type.String}, result_type: Type.Result{ok: target, err: Type.List{element: Type.Named{name: "FieldError"}}}, type_args: [Type]{target}, optional_options: false})
    }
    if module_name == "core.encoding.cbor" && member == "decode" {
        return Val(SemaDataCoreDecodeContract{call_member: "parse", argument_types: [Type]{Type.List{element: Type.IntN{signed: false, bits: 8}}, Type.Named{name: "CBOROptions"}}, result_type: Type.Result{ok: target, err: Type.List{element: Type.Named{name: "FieldError"}}}, type_args: [Type]{target}, optional_options: true})
    }
    if module_name == "core.encoding.xml" && member == "decode" {
        return Val(SemaDataCoreDecodeContract{call_member: "decode", argument_types: [Type]{Type.String, Type.Named{name: "XMLParseOptions"}}, result_type: Type.Result{ok: target, err: Type.List{element: Type.Named{name: "FieldError"}}}, type_args: [Type]{target}, optional_options: true})
    }
    if module_name == "core.encoding.xml" && member == "decode_bytes" {
        return Val(SemaDataCoreDecodeContract{call_member: "decode", argument_types: [Type]{Type.List{element: Type.IntN{signed: false, bits: 8}}, Type.Named{name: "XMLParseOptions"}}, result_type: Type.Result{ok: target, err: Type.List{element: Type.Named{name: "FieldError"}}}, type_args: [Type]{target}, optional_options: true})
    }
    None
}

// The Core calls whose typed decode contract lives here.
fn sema_data_core_decode_member(module_name: String, member: String) -> Bool Never! {
    if module_name != "core.db" && module_name != "core.sys" && !module_name.starts_with("core.encoding.") -> return false
    member == "decode" || (module_name == "core.encoding.xml" && member == "decode_bytes")
}

fn sema_data_core_try_decode(module_name: String, member: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck? {
    updated_args := args
    if !sema_data_core_decode_member(module_name, member) -> return None
    if module_name == "core.encoding.json" && type_args.len() == 0 {
        if updated_args.len() != 1 {
            sema_data_arity_diagnostic("core.encoding.json.decode", 1, updated_args.len(), span, &diagnostics)
            sema_data_check_discarded_arguments(updated_args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            return Val(SemaDirectSpecialCheck{handled: true, value: None})
        }
        argument_types := [Type]{Type.String}
        value :: sema_check_expression(updated_args[0].expr, Val(Type.String), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return Val(SemaDirectSpecialCheck{handled: true, value: None})
        record :: sema_call_core_record(module_name, member, updated_args.len(), span, &diagnostics) ?? return Val(SemaDirectSpecialCheck{handled: true, value: None})
        result_type := Type.Result{ok: sema_dyn_type(), err: Type.Named{name: "EncodingError"}}
        result :: sema_data_core_emit(record, "{module_name}.{member}", updated_args, argument_types, [TExpr]{value}, [Type]{}, result_type, span, expected, environment, program, &scopes, &state, &context, &diagnostics) ?? return Val(SemaDirectSpecialCheck{handled: true, value: None})
        return Val(SemaDirectSpecialCheck{handled: true, value: Val(result)})
    }
    target :: sema_data_core_target_type(type_args, member, span, environment, program, &diagnostics) ?? return Val(SemaDirectSpecialCheck{handled: true, value: None})
    if !sema_serde_type_is_admissible(environment, program, target, SemaSerdeDirection.Decode) {
        &diagnostics.push(sema_error("E0905", span, "`{type_name(target)}` does not implement `Decode`", "`{module_name}.{member}<T>` can only decode into a type with the registered Decode contract", "derive `Decode` on this type, or write its Decode implementation"))
    }
    contract :: sema_data_core_decode_contract(module_name, member, target) ?? return None
    call_member := contract.call_member
    argument_types := contract.argument_types
    result_type := contract.result_type
    effective_type_args := contract.type_args
    // `env.decode<T>()` binds its labeled config fields to their
    // registered defaults before the shared arity and argument checks.
    if module_name == "core.sys" {
        params := [SemaCallParam]{
            sema_data_core_param("prefix", Type.String, AccessConvention.Read, ParamZone.Either, Val(Expr.Str{parts: [StrPart]{StrPart.Lit{text: ""}}, span: span})),
            sema_data_core_param("file", Type.String, AccessConvention.Read, ParamZone.Either, Val(Expr.Str{parts: [StrPart]{StrPart.Lit{text: ".env"}}, span: span})),
            sema_data_core_param("allow", Type.List{element: Type.String}, AccessConvention.Read, ParamZone.Either, Val(Expr.ListLit{elements: [Expr]{}, span: span})),
        }
        binding :: sema_call_bind_args("{module_name}.{member}", params, &updated_args, span, &diagnostics)
        if binding == None {
            sema_data_check_discarded_arguments(updated_args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            return Val(SemaDirectSpecialCheck{handled: true, value: None})
        }
    }
    min_arity := 1
    if updated_args.len() < min_arity || updated_args.len() > argument_types.len() || (!contract.optional_options && updated_args.len() != argument_types.len()) {
        &diagnostics.push(sema_error("E0104", span, "`{module_name}.{member}` expects {if contract.optional_options -> "between 1 and {argument_types.len()}" else -> "{argument_types.len()}"} argument(s), got {updated_args.len()}", "typed decoding uses the format's registered input and optional settings shape", "pass the documented typed decoder arguments"))
        sema_data_check_discarded_arguments(updated_args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return Val(SemaDirectSpecialCheck{handled: true, value: None})
    }
    if module_name == "core.encoding.xml" {
        params := [SemaCallParam]{
            sema_data_core_param(if member == "decode_bytes" -> "bytes" else -> "text", argument_types[0], AccessConvention.Read, ParamZone.PositionalOnly, None),
            sema_data_core_param("options", argument_types[1], AccessConvention.Read, ParamZone.PositionalOnly, Val(sema_data_core_default_call("XMLParseOptions", "safe", span))),
        }
        binding :: sema_call_bind_args("{module_name}.{member}", params, &updated_args, span, &diagnostics)
        if binding == None {
            sema_data_check_discarded_arguments(updated_args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            return Val(SemaDirectSpecialCheck{handled: true, value: None})
        }
    }
    typed := [TExpr]{}
    checked_types := [Type]{}
    loop (index, argument) in updated_args {
        expected_arg := argument_types[index]
        value :: sema_check_expression(argument.expr, Val(expected_arg), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return Val(SemaDirectSpecialCheck{handled: true, value: None})
        &typed.push(value)
        &checked_types.push(expected_arg)
    }
    record :: sema_call_core_record(module_name, call_member, updated_args.len(), span, &diagnostics) ?? return Val(SemaDirectSpecialCheck{handled: true, value: None})
    result :: sema_data_core_emit(record, "{module_name}.{member}", updated_args, checked_types, typed, effective_type_args, result_type, span, expected, environment, program, &scopes, &state, &context, &diagnostics) ?? return Val(SemaDirectSpecialCheck{handled: true, value: None})
    Val(SemaDirectSpecialCheck{handled: true, value: Val(result)})
}

fn sema_data_core_reader_writer_params(module_name: String, member: String, record: CoreCallRecord, span: Span, diagnostics: &[Diagnostic]) -> [SemaCallParam]? {
    reader := member == "reader"
    if !reader && member != "writer" -> return None
    file_type := if reader -> Type.Named{name: "FileReader"} else -> Type.Named{name: "FileWriter"}
    handle_type := if {
        module_name == "core.encoding.json" && reader -> "JSONReader"
        module_name == "core.encoding.json" -> "JSONWriter"
        module_name == "core.encoding.jsonl" && reader -> "JSONLReader"
        module_name == "core.encoding.jsonl" -> "JSONLWriter"
        module_name == "core.encoding.csv" && reader -> "CSVReader"
        module_name == "core.encoding.csv" -> "CSVWriter"
        module_name == "core.encoding.cbor" && reader -> "CBORReader"
        module_name == "core.encoding.cbor" -> "CBORWriter"
        module_name == "core.encoding.xml" && reader -> "XMLReader"
        module_name == "core.encoding.xml" -> "XMLWriter"
        else -> ""
    }
    if handle_type == "" -> return None
    argument_types := [Type]{file_type}
    labels := [String]{}
    &labels.push(if reader -> "source" else -> "target")
    defaults := [Expr?]{None}
    if {
        module_name == "core.encoding.csv" && reader -> {
            &argument_types.push(Type.Named{name: "EncodingLimits"})
            &argument_types.push(Type.String)
            &argument_types.push(Type.Bool)
            &argument_types.push(Type.Bool)
            &labels.push("limits")
            &labels.push("delimiter")
            &labels.push("header")
            &labels.push("skip_blank")
            &defaults.push(Val(sema_data_core_default_call("EncodingLimits", "safe", span)))
            &defaults.push(Val(Expr.Str{parts: [StrPart]{StrPart.Lit{text: ","}}, span: span}))
            &defaults.push(Val(Expr.Bool{value: false, span: span}))
            &defaults.push(Val(Expr.Bool{value: false, span: span}))
        }
        else -> {
            &argument_types.push(Type.Named{name: "EncodingLimits"})
            &labels.push("limits")
            &defaults.push(Val(sema_data_core_default_call("EncodingLimits", "safe", span)))
            if {
                module_name == "core.encoding.xml" -> {
                    option_type := if reader -> "XMLParseOptions" else -> "XMLRenderOptions"
                    &argument_types.push(Type.Named{name: option_type})
                    &labels.push("options")
                    &defaults.push(Val(sema_data_core_default_call(option_type, "safe", span)))
                }
                module_name == "core.encoding.json" && !reader -> {
                    &argument_types.push(Type.Bool)
                    &labels.push("canonical")
                    &defaults.push(Val(Expr.Bool{value: false, span: span}))
                }
            }
        }
    }
    params := [SemaCallParam]{}
    loop (index, ty) in argument_types {
        access :: sema_data_core_param_access(record, index, span, &diagnostics) ?? return None
        zone := if index == 0 -> ParamZone.PositionalOnly else -> ParamZone.Either
        &params.push(sema_data_core_param(labels[index], ty, access, zone, defaults[index]))
    }
    Val(params)
}

fn sema_data_core_try_reader_writer(module_name: String, member: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck? {
    updated_args := args
    if module_name != "core.encoding.json" && module_name != "core.encoding.jsonl" && module_name != "core.encoding.csv" && module_name != "core.encoding.cbor" && module_name != "core.encoding.xml" -> return None
    if member != "reader" && member != "writer" -> return None
    if !sema_data_check_explicit_type_args("{module_name}.{member}", type_args, 0, span, &diagnostics) {
        sema_data_check_discarded_arguments(updated_args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return Val(SemaDirectSpecialCheck{handled: true, value: None})
    }
    max_arity := if {
        module_name == "core.encoding.csv" && member == "reader" -> 5
        (module_name == "core.encoding.json" && member == "writer") || module_name == "core.encoding.xml" -> 3
        else -> 2
    }
    if updated_args.len() < 1 || updated_args.len() > max_arity {
        &diagnostics.push(sema_error("E0104", span, "`{module_name}.{member}` expects between 1 and {max_arity} arguments, got {updated_args.len()}", "the file handle is required and the policy slots have safe defaults", "pass the file handle and any desired encoding policies"))
        sema_data_check_discarded_arguments(updated_args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return Val(SemaDirectSpecialCheck{handled: true, value: None})
    }
    record :: sema_call_core_record(module_name, member, max_arity, span, &diagnostics) ?? return Val(SemaDirectSpecialCheck{handled: true, value: None})
    params :: sema_data_core_reader_writer_params(module_name, member, record, span, &diagnostics) ?? return Val(SemaDirectSpecialCheck{handled: true, value: None})
    binding :: sema_call_bind_args("{module_name}.{member}", params, &updated_args, span, &diagnostics)
    if binding == None {
        sema_data_check_discarded_arguments(updated_args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        return Val(SemaDirectSpecialCheck{handled: true, value: None})
    }
    typed := [TExpr]{}
    types := [Type]{}
    loop (index, argument) in updated_args {
        ty :: params[index].ty ?? Type.Named{name: "Unit"}
        value :: sema_check_expression(argument.expr, Val(ty), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return Val(SemaDirectSpecialCheck{handled: true, value: None})
        &typed.push(value)
        &types.push(ty)
    }
    handle_type := if {
        module_name == "core.encoding.json" && member == "reader" -> "JSONReader"
        module_name == "core.encoding.json" -> "JSONWriter"
        module_name == "core.encoding.jsonl" && member == "reader" -> "JSONLReader"
        module_name == "core.encoding.jsonl" -> "JSONLWriter"
        module_name == "core.encoding.csv" && member == "reader" -> "CSVReader"
        module_name == "core.encoding.csv" -> "CSVWriter"
        module_name == "core.encoding.cbor" && member == "reader" -> "CBORReader"
        module_name == "core.encoding.cbor" -> "CBORWriter"
        member == "reader" -> "XMLReader"
        else -> "XMLWriter"
    }
    result_type := Type.Result{ok: Type.Named{name: handle_type}, err: Type.Named{name: "EncodingError"}}
    result :: sema_data_core_emit(record, "{module_name}.{member}", updated_args, types, typed, [Type]{}, result_type, span, expected, environment, program, &scopes, &state, &context, &diagnostics) ?? return Val(SemaDirectSpecialCheck{handled: true, value: None})
    Val(SemaDirectSpecialCheck{handled: true, value: Val(result)})
}

fn sema_data_sql_ascii_equal(left: String, right: String) -> Bool Never! {
    a := left.bytes()
    b := right.bytes()
    if a.len() != b.len() -> return false
    loop index in 0..<a.len() {
        l := a[index]
        r := b[index]
        if l >= (U8{65}) && l <= (U8{90}) -> l = l + U8{32}
        if r >= (U8{65}) && r <= (U8{90}) -> r = r + U8{32}
        if l != r -> return false
    }
    true
}

fn sema_data_sql_word_character(byte: U8) -> Bool Never! {
    (byte >= U8{48} && byte <= U8{57}) || (byte >= U8{65} && byte <= U8{90}) || (byte >= U8{97} && byte <= U8{122}) || byte == U8{95}
}

fn sema_data_sql_column_token(raw: String) -> String Never! {
    value := raw.trim().replace(",", "").replace(";", "")
    pieces := value.split("(").to_list()
    if pieces.len() > 1 -> value = pieces[pieces.len() - 1]
    pieces = value.split(".").to_list()
    if pieces.len() > 1 -> value = pieces[pieces.len() - 1]
    bytes := value.bytes()
    start := 0
    end := bytes.len()
    loop start < end && !sema_data_sql_word_character(bytes[start]) -> start += 1
    loop end > start && !sema_data_sql_word_character(bytes[end - 1]) -> end -= 1
    if start == end -> return ""
    String.from_bytes(bytes.slice(start, end)) ?? ""
}

fn sema_data_analytics_sql_literal(expression: Expr) -> String? {
    if expression == {
        .TypedLit(head, body, _) -> {
            if head != .Val(Type.Named{name: "SQL"}) -> return None
            if body == {
                .Value(value) -> {
                    if value == {
                        .Str(parts, _) -> {
                            result := ""
                            loop part in parts {
                                if part == {
                                    .Lit(text) -> { result += text }
                                    else -> {}
                                }
                            }
                            return Val(result)
                        }
                        else -> return None
                    }
                }
                else -> return None
            }
        }
        else -> return None
    }
}

fn sema_data_analytics_sql_columns(sql: String) -> [String] Never! {
    normalized := sql.replace("\n", " ").replace(String.from_bytes([U8]{13}) ?? "", " ").replace("\t", " ")
    tokens := [String]{}
    loop token in normalized.split(" ") {
        value := token.trim()
        if value != "" -> &tokens.push(value)
    }
    columns := [String]{}
    select := -1
    from := -1
    loop (index, token) in tokens {
        if select < 0 && sema_data_sql_ascii_equal(token, "select") -> select = index
        if from < 0 && sema_data_sql_ascii_equal(token, "from") -> from = index
    }
    if select >= 0 && from > select + 1 {
        loop index in (select + 1)..<from {
            token := sema_data_sql_column_token(tokens[index])
            if token != "" && token != "*" && !sema_data_sql_ascii_equal(token, "as") -> &columns.push(token)
        }
    }
    loop (index, token) in tokens {
        offset := if {
            sema_data_sql_ascii_equal(token, "where") -> 1
            sema_data_sql_ascii_equal(token, "order") || sema_data_sql_ascii_equal(token, "group") -> 2
            else -> 0
        }
        if offset > 0 && index + offset < tokens.len() {
            name := sema_data_sql_column_token(tokens[index + offset])
            if name != "" -> &columns.push(name)
        }
    }
    columns
}

fn sema_data_check_analytics_sql_schema(row: Type, query: Expr, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) {
    sql :: sema_data_analytics_sql_literal(query) ?? return
    name :: sema_data_type_name(row) ?? return
    definition :: sema_serde_type_definition(environment, program, name) ?? return
    if definition.kind == {
        .Struct(fields, _) -> {
            known := [String]{}
            loop field in fields -> &known.push(field.name)
            loop column in sema_data_analytics_sql_columns(sql) {
                found := false
                loop field in known {
                    if field == column -> found = true
                }
                if !found {
                    &diagnostics.push(sema_error("E2420", span, "unknown analytics column `{column}`", "`{column}` is not a field on `{name}`; the analytics engine would fail at runtime, but Jet checks this schema at compile time", "write one of: {known.join(", ")}"))
                }
            }
        }
        else -> {}
    }
}

fn sema_call_try_data_core_call(module_name: String, member: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaDirectSpecialCheck {
    if module_name == "core.data.stream" -> return sema_call_try_data_stream_core_call(module_name, member, args, type_args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    reader_writer :: sema_data_core_try_reader_writer(module_name, member, args, type_args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    if reader_writer == .Val(result) -> return result
    decoder :: sema_data_core_try_decode(module_name, member, args, type_args, span, expected, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
    if decoder == .Val(result) -> return result
    if module_name == "core.encoding.csv" && member == "query" {
        row :: sema_data_core_target_type(type_args, member, span, environment, program, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        if args.len() != 2 {
            sema_data_arity_diagnostic("core.encoding.csv.query", 2, args.len(), span, &diagnostics)
            sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            return SemaDirectSpecialCheck{handled: true, value: None}
        }
        if !sema_serde_type_is_admissible(environment, program, row, SemaSerdeDirection.Decode) -> &diagnostics.push(sema_error("E0905", span, "`{type_name(row)}` does not implement `Decode`", "`csv.query<T>` needs the row Decode contract", "derive `Decode` on this type, or write its Decode implementation"))
        if !sema_serde_type_is_admissible(environment, program, row, SemaSerdeDirection.Encode) -> &diagnostics.push(sema_error("E0905", span, "`{type_name(row)}` does not implement `Encode`", "`csv.query<T>` needs the row Encode contract", "derive `Encode` on this type, or write its Encode implementation"))
        sema_data_check_analytics_sql_schema(row, args[1].expr, span, environment, program, &diagnostics)
        argument_types := [Type]{Type.String, Type.Named{name: "SQL"}}
        typed := [TExpr]{}
        loop (index, argument) in args {
            value :: sema_check_expression(argument.expr, Val(argument_types[index]), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
            &typed.push(value)
        }
        record :: sema_call_core_record(module_name, member, args.len(), span, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        result_type := Type.Result{ok: Type.Apply{name: "Query", args: [Type]{row}}, err: Type.List{element: Type.Named{name: "FieldError"}}}
        result :: sema_data_core_emit(record, "{module_name}.{member}", args, argument_types, typed, [Type]{row}, result_type, span, expected, environment, program, &scopes, &state, &context, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        return SemaDirectSpecialCheck{handled: true, value: Val(result)}
    }
    if (module_name == "core.data" && (member == "query" || member == "track")) || (module_name == "core.data.arrow" && (member == "import" || member == "query")) {
        if type_args.len() != 0 {
            sema_data_check_explicit_type_args("{module_name}.{member}", type_args, 0, span, &diagnostics)
            sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            return SemaDirectSpecialCheck{handled: true, value: None}
        }
        expected_count := if module_name == "core.data" && member == "track" -> 2 else -> 1
        if args.len() != expected_count {
            sema_data_arity_diagnostic("{module_name}.{member}", expected_count, args.len(), span, &diagnostics)
            sema_data_check_discarded_arguments(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
            return SemaDirectSpecialCheck{handled: true, value: None}
        }
        first :: sema_check_expression(args[0].expr, None, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        row := Type?{None}
        first_expected := first.ty
        if {
            module_name == "core.data" && member == "track" -> {
                if first.ty == {
                    .List(element) -> { row = Val(element) }
                    else -> {
                        &diagnostics.push(sema_error("E0112", args[0].span, "`data.track` needs a typed row list, not `{type_name(first.ty)}`", "tracking builds a key index over a typed row list", "pass a `[Row]` value and a key callback"))
                        return SemaDirectSpecialCheck{handled: true, value: None}
                    }
                }
                first_expected = Type.List{element: row ?? Type.Named{name: "Unit"}}
            }
            module_name == "core.data" -> {
                if first.ty == {
                    .List(element) -> row = Val(element)
                    .Apply(name, parameters) -> {
                        if {
                            name == "DataTracked" && parameters.len() == 2 -> {
                                row = Val(parameters[0])
                            }
                            name == "DataStream" && parameters.len() == 1 -> {
                                row = Val(parameters[0])
                            }
                        }
                    }
                    else -> {}
                }
                if row == None {
                    &diagnostics.push(sema_error("E0112", args[0].span, "`data.query` needs `[Row]`, `DataTracked<Row, Key>`, or `DataStream<Row>`, not `{type_name(first.ty)}`", "a query keeps one typed row shape", "pass a typed row list, tracked source, or stream"))
                    return SemaDirectSpecialCheck{handled: true, value: None}
                }
            }
            else -> {
                if first.ty == {
                    .Apply(name, parameters) -> {
                        if sema_data_nominal_is(name, "DataArrowBatch") && parameters.len() == 1 {
                            row = Val(parameters[0])
                        }
                    }
                    else -> {}
                }
                if row == None {
                    &diagnostics.push(sema_error("E0112", args[0].span, "`{member}` expects a `DataArrowBatch<T>` value, got `{type_name(first.ty)}`", "Arrow operations preserve the row type carried by the checked owner", "pass a `DataArrowBatch<T>` value"))
                    return SemaDirectSpecialCheck{handled: true, value: None}
                }
            }
        }
        typed := [TExpr]{first}
        argument_types := [Type]{first_expected}
        if module_name == "core.data" && member == "track" {
            callback_expected := Type.Fn{params: [Type]{row ?? Type.Named{name: "Unit"}}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
            callback :: sema_check_expression(args[1].expr, Val(callback_expected), environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
            key :: sema_call_signature_return(callback.ty) ?? Type.Named{name: "Unit"}
            &typed.push(callback)
            &argument_types.push(callback_expected)
            row_type :: row ?? Type.Named{name: "Unit"}
            result_type := Type.Result{ok: Type.Apply{name: "DataTracked", args: [Type]{row_type, key}}, err: Type.Named{name: "DataError"}}
            record :: sema_call_core_record(module_name, member, args.len(), span, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
            result :: sema_data_core_emit(record, "{module_name}.{member}", args, argument_types, typed, [Type]{row_type, key}, result_type, span, expected, environment, program, &scopes, &state, &context, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
            return SemaDirectSpecialCheck{handled: true, value: Val(result)}
        }
        row_type :: row ?? Type.Named{name: "Unit"}
        result_type := if {
            module_name == "core.data" -> Type.Apply{name: "Query", args: [Type]{row_type}}
            member == "import" -> first.ty
            else -> Type.Result{ok: Type.Apply{name: sema_data_source_type_name(environment, program, "Query"), args: [Type]{row_type}}, err: Type.Named{name: sema_data_source_type_name(environment, program, "DataError")}}
        }
        record :: sema_call_core_record(module_name, member, args.len(), span, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        result :: sema_data_core_emit(record, "{module_name}.{member}", args, argument_types, typed, [Type]{row_type}, result_type, span, expected, environment, program, &scopes, &state, &context, &diagnostics) ?? return SemaDirectSpecialCheck{handled: true, value: None}
        return SemaDirectSpecialCheck{handled: true, value: Val(result)}
    }
    SemaDirectSpecialCheck{handled: false, value: None}
}
