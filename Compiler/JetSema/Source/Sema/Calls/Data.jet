    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    CallLabel,
    CoreCallRecord,
    Diagnostic,
    Expr,
    EffectRowEntry,
    EnumLitArg,
    FunctionDefaultRef,
    NodeKind,
    ParamZone,
    PlaceAccess,
    Span,
    StrPart,
    TFailureCarrier,
    Type,
    TypeTupleField,
    ast_empty_call_arg_flags,
    core_receiver_method,
    core_source_owns_type,
    expr_source_span,
    expr_span,
    type_name,
    type_unqualified_nominals,
    UnOp,
    core_identity_in_module,
    core_identity_is,
    TEST_SETTINGS_PLAN_ENV,
