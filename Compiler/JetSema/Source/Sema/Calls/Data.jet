use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    CallArg,
    CallLabel,
    CoreCallRecord,
    Diagnostic,
    Expr,
    EffectRowEntry,
    FunctionDefaultRef,
    NodeKind,
    ParamZone,
    Span,
    StrPart,
    Type,
    TypeTupleField,
    AST_EMPTY_CALL_ARG_FLAGS,
    core_call_role_receiver,
    expr_source_span,
    expr_span,
    type_name,
    core_identity_in_module,
    sema_casing_pascal_words,
]

sema_data_nominal_is: fn(name: String, leaf: String) -> Bool Never! {
    name == leaf || (core_identity_in_module(name, "core.data") && name.ends_with(".{leaf}"))
}

sema_data_source_type_name: fn(check: SemaBodyCheck, leaf: String) -> String Never! {
    sema_core_source_type_name(check.program.*, "core.data", leaf)
}

// (`FieldError.under`): one shared transform frames every error of a child
// Result under a path segment while keeping its success type. Generated codecs
// use it at each field boundary, and a hand-written codec at each child it
// decodes; it is an error-list helper, not another decode API. It consumes
// the child's carrier, so a decode call written as the child keeps its Result
// rather than propagating it.
sema_data_check_field_error_under: fn(args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if args.len() != 2 {
        sema_data_arity_diagnostic("FieldError.under", 2, args.len(), span, check.diagnostics)
        sema_data_check_discarded_arguments(args, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    ^segment: sema_data_check_argument("FieldError.under", 0, args[0], Type.String, check)
    inner: sema_check_expression_carrier(args[1].expr, None, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    segment_value: segment ?? return SemaMethodSpecialCheck{handled: true, value: None}
    ^framed: false
    if inner.ty == .Result(_, failure) -> framed = failure == sema_data_decode_error()
    if !framed {
        check.diagnostics.push(sema_error("E0905", expr_span(args[1].expr), "`FieldError.under` expects a result with `[FieldError]` errors", "the framing helper preserves the child result and prefixes every accumulated decode failure", "pass a typed decode/accessor result, such as `tree.field(\"name\")?.decode<T>()`"))
    }
    segment_row: sema_arena_adopt(check.context, segment_value)
    inner_row: sema_arena_adopt(check.context, inner)
    ^value: sema_node(check.context, inner.ty, NodeKind.DecodeUnder{segment: segment_row, inner: inner_row}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

sema_data_query_row_type: fn(ty: Type) -> Type? Never! {
    if ty == {
        .Tagged(marker, inner) -> {
            if marker == {
                .User(_) -> return sema_data_query_row_type(inner)
                .Internal(_) -> return None
            }
        }
        .Apply(other_name, other_parameters) -> {
            if sema_data_nominal_is(other_name, "Query") && other_parameters.len() == 1 {
                return Val(other_parameters[0].copy())
            }
            return None
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return None
    }
}

// `expect_core_arg`: the argument is checked against the parameter type and a
// mismatch the checker did not already report is E0112.
sema_data_expect_core_arg: fn(name: String, index: Int, required: Type, argument: CallArg, check: ^SemaBodyCheck) -> TExpr? {
    value: sema_data_check_argument(name, index, argument, required, check) ?? return None
    if sema_call_host_callback_assignable(required, value.ty, check) == (.Val(false)) {
        check.diagnostics.push(sema_error("E0112", expr_span(argument.expr), "`{name}` wants {sema_type_show(required)} for argument {index + 1}, but this is {sema_type_show(value.ty)}", "every argument must match its parameter's type", sema_type_fix_hint(required, value.ty)))
        return None
    }
    Val(value)
}

SemaDataQueryCallback: struct {
    value: TExpr?,
    result: Type?,
}

sema_data_fn_has_empty_effect_bound: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Fn(_, _, bound, _, _, _) -> {
            if bound == .Val(row) -> return row.len() == 0
            return false
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return false
    }
}

// `infer_query_callback`: a one-row query callback (`map`, `min`, `max`, the
// join keys, `group_by`, a grouped reducer) whose result is open. The row seeds
// the lambda parameter and the callback keeps its own result type, so keys and
// values keep their nominal or exact types. The expected callback carries an
// explicit empty effect bound: a maintained query replays its callbacks after
// each source delta (`check_query_callback_effect`).
sema_data_infer_query_callback: fn(call_name: String, row: Type, argument: CallArg, check: ^SemaBodyCheck) -> SemaDataQueryCallback {
    required: Type.Fn{params: [Type]{row}, ret: None, effect_bound: Val([EffectRowEntry]{}), param_contract: None, call_metadata: None, return_view_provenance: None}
    checked: sema_expression_lambda_collection_callback(argument.expr, Val(required), check) ?? return SemaDataQueryCallback{value: None, result: None}
    callback_span: expr_span(argument.expr)
    if checked.ty == {
        .Fn(params, ret, _, _, _, _) -> {
            if !sema_data_fn_has_empty_effect_bound(checked.ty) {
                check.diagnostics.push(sema_error("E2476", callback_span, "live query callback `{call_name}` is not replay-safe", "a maintained query replays callbacks after each source delta, so the callback must have an explicit empty effect bound", "remove the effectful operation, or declare/use a pure callback over the tracked row"))
            }
            if params.len() != 1 || params[0] != row {
                check.diagnostics.push(sema_error("E0112", callback_span, "`{call_name}` wants a callback over {sema_type_show(row)} for argument 1", "a query callback receives exactly one row", "write `row -> …`"))
            }
            return SemaDataQueryCallback{value: Val(checked), result: ret}
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {
            check.diagnostics.push(sema_error("E0112", callback_span, "`{call_name}` wants a callback for argument 1, but this is {sema_type_show(checked.ty)}", "query reducers take one callback over the row", "pass a lambda such as `row -> row.field`"))
            return SemaDataQueryCallback{value: None, result: None}
        }
    }
}

sema_data_query_push_argument: fn(argument: CallArg, value: TExpr?, source_args: ^[CallArg], argument_types: ^[Type], typed: ^[TExpr]) -> Bool {
    checked: value ?? return false
    source_args.push(argument.copy())
    argument_types.push(checked.ty)
    typed.push(checked)
    true
}

sema_data_query_receiver: fn(name: String, parameters: [Type], method: String) -> String Never! {
    if sema_data_nominal_is(name, "Query") && parameters.len() == 1 && (method == "filter" || method == "sort_by" || method == "map" || method == "min" || method == "max" || method == "inner_join" || method == "left_join" || method == "collect" || method == "group_by") {
        return "Query"
    }
    if sema_data_nominal_is(name, "DataGroupedQuery") && parameters.len() == 2 && (method == "count" || method == "sum" || method == "mean") {
        return "DataGroupedQuery"
    }
    ""
}

sema_data_query_arity: fn(method: String) -> Int Never! {
    if method == {
        "filter" | "sort_by" | "map" | "min" | "max" | "group_by" | "sum" | "mean" -> 1
        "inner_join" | "left_join" -> 3
        else -> 0
    }
}

sema_data_group_sum_numeric: fn(value: Type?) -> Bool Never! {
    found: value ?? return false
    if found == {
        .Int | .IntN(_, _) | .Float | .Float32 -> return true
        .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return false
    }
}

// (the Query family of `infer_method_call`): `Query<T>` methods keep the
// deferred carrier and only `collect` turns it back into a list. `group_by`
// yields the internal `DataGroupedQuery<T, K>` carrier whose reducers return
// `Query<Group<K, V>>`; keys and values keep the callback result types, never a
// String/Float projection. Every call runs the Core function that fills its
// role (sema_data_query_role), with the receiver as the first argument.
// `Query.watch` and the `DataTracked` and `DataWatch` methods are ordinary
// Core methods.
sema_data_try_query_method: fn(receiver: Expr, receiver_value: TExpr, name: String, parameters: [Type], method: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    receiver_type: sema_data_query_receiver(name, parameters, method)
    if receiver_type == "" -> return SemaMethodSpecialCheck{handled: false, value: None}
    ^complete: true
    if type_args.len() != 0 {
        sema_data_check_explicit_type_args("{receiver_type}.{method}", type_args, 0, span, check.diagnostics)
        complete = false
    }
    want: sema_data_query_arity(method)
    if args.len() != want {
        check.diagnostics.push(sema_wrong_core_arity(method, want, args.len(), span))
        complete = false
    }
    if args.len() > want -> sema_data_check_discarded_arguments(args.slice(want, args.len()), check)
    row: parameters[0]
    data_error: Type.Named{name: sema_data_source_type_name(check, "DataError")}
    ^source_args: [CallArg]{CallArg{convention: AccessConvention.Read, expr: receiver, span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}}
    ^argument_types: [Type]{receiver_value.ty}
    ^typed: [TExpr]{receiver_value}
    ^call_type_args: [Type]{}
    ^result_type: Type.Named{name: "Unit"}
    query_name: sema_data_source_type_name(check, "Query")
    ^sum_value: Type.Int
    if receiver_type == "Query" {
        if method == "filter" || method == "sort_by" {
            // Ordinary Query combinators collect later; the empty effect bound
            // belongs to the live `.watch()` callbacks.
            callback_result: if method == "filter" -> Type.Bool else -> Type.String
            callback_type: Type.Fn{params: [Type]{row}, ret: Val(callback_result), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
            if method == "filter" && args.len() > 0 {
                sema_data_filter_push(args[0].expr, row, span, check, source_args, argument_types, typed)
            }
            if args.len() > 0 {
                value: sema_data_expect_core_arg(method, 0, callback_type, args[0], check)
                if !sema_data_query_push_argument(args[0], value, source_args, argument_types, typed) {
                    complete = false
                }
            }
            call_type_args = [Type]{row}
            result_type = Type.Apply{name: name, args: [Type]{row}}
        }
        if method == "map" || method == "min" || method == "max" {
            ^value_type: row
            if args.len() > 0 {
                callback: sema_data_infer_query_callback(method, row, args[0], check)
                if callback.result == .Val(found) -> value_type = found
                if !sema_data_query_push_argument(args[0], callback.value, source_args, argument_types, typed) {
                    complete = false
                }
            }
            call_type_args = [Type]{row, value_type}
            result_type = Type.Apply{name: name, args: [Type]{value_type}}
        }
        if method == "inner_join" || method == "left_join" {
            ^right_row: row
            if args.len() > 0 {
                ^other: sema_check_expression(args[0].expr, None, check)
                if other == .Val(value) {
                    query_row: sema_data_query_row_type(value.ty)
                    if query_row == .Val(found) -> right_row = found else {
                        check.diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`{method}` wants a Query as argument 1, but this is {sema_type_show(value.ty)}", "keyed joins combine two typed deferred queries", "pass another `Query<Row>` value"))
                        other = None
                    }
                }
                if !sema_data_query_push_argument(args[0], other, source_args, argument_types, typed) {
                    complete = false
                }
            }
            if args.len() > 1 {
                left_key: sema_data_infer_query_callback(method, row, args[1], check)
                if !sema_data_query_push_argument(args[1], left_key.value, source_args, argument_types, typed) {
                    complete = false
                }
            }
            if args.len() > 2 {
                right_key: sema_data_infer_query_callback(method, right_row, args[2], check)
                if !sema_data_query_push_argument(args[2], right_key.value, source_args, argument_types, typed) {
                    complete = false
                }
            }
            joined_right: if method == "left_join" -> Type.Option{inner: right_row} else -> right_row
            call_type_args = [Type]{row, right_row}
            result_type = Type.Apply{name: name, args: [Type]{Type.Apply{name: sema_data_source_type_name(check, "DataJoin"), args: [Type]{row, joined_right}}}}
        }
        if method == "collect" {
            call_type_args = [Type]{row}
            result_type = sema_data_result(Type.List{element: row}, data_error)
        }
        if method == "group_by" {
            ^key: Type.String
            if args.len() > 0 {
                callback: sema_data_infer_query_callback(method, row, args[0], check)
                if callback.result == .Val(found) -> key = found
                if !sema_data_query_push_argument(args[0], callback.value, source_args, argument_types, typed) {
                    complete = false
                }
            }
            call_type_args = [Type]{row, key}
            result_type = Type.Apply{name: sema_data_source_type_name(check, "DataGroupedQuery"), args: [Type]{row, key}}
        }
    }
    if receiver_type == "DataGroupedQuery" {
        key: parameters[1]
        ^value_type: Type.Int
        if method == "sum" || method == "mean" {
            ^value: Type?{None}
            if args.len() > 0 {
                callback: sema_data_infer_query_callback(method, row, args[0], check)
                value = callback.result
                if !sema_data_query_push_argument(args[0], callback.value, source_args, argument_types, typed) {
                    complete = false
                }
            }
            if method == "sum" {
                if !sema_data_group_sum_numeric(value) {
                    shown: if value == .Val(found) -> sema_type_show(found) else -> "missing"
                    check.diagnostics.push(sema_error("E0112", span, "`sum` wants an Int, fixed-width Int, Float, or F32 result, but this is {shown}", "grouped sum follows the runtime numeric domain and does not add arbitrary values", "return a numeric row value, or use `count` for cardinality"))
                    complete = false
                }
                if value == .Val(found) -> value_type = found
                sum_value = value_type
            } else {
                if value == .Val(found) {
                    if found != Type.Float {
                        check.diagnostics.push(sema_error("E0112", span, "`mean` wants Float for argument 1's result, but this is {sema_type_show(found)}", "a grouped mean follows the Float numeric rules; it does not widen integers or units silently", "return a Float from the value callback, or use `sum`"))
                        complete = false
                    }
                }
                value_type = Type.Float
            }
        }
        call_type_args = [Type]{row, key}
        result_type = Type.Apply{name: query_name, args: [Type]{Type.Apply{name: sema_data_source_type_name(check, "Group"), args: [Type]{key, value_type}}}}
    }
    if !complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    role: sema_data_query_role(receiver_type, method, sum_value)
    record: sema_data_role_record(receiver_type, method, role, call_type_args, span, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    value: sema_data_core_emit(record, "{receiver_type}.{method}", source_args, argument_types, typed, call_type_args, result_type, span, expected, check)
    SemaMethodSpecialCheck{handled: true, value: value}
}

// The jet_builtins role of the Core function a Query stage or grouped reducer
// runs: the receiver's role prefix and then the method's words (`sort_by` is
// QuerySortBy, a grouped `count` is GroupCount). A grouped sum runs the
// reducer for its value's numeric type.
sema_data_query_role: fn(receiver_type: String, method: String, sum_value: Type) -> String Never! {
    if receiver_type == "Query" -> return "Query{sema_casing_pascal_words(method)}"
    if method == "sum" -> return sema_data_group_sum_role(sum_value)
    "Group{sema_casing_pascal_words(method)}"
}

// The checked record of `receiver_type`'s method `method` whose call runs the
// Core function that fills `role`, instantiated with `type_args`. Each
// argument is read or taken as that function's parameter declares.
sema_data_role_record: fn(receiver_type: String, method: String, role: String, type_args: [Type], span: Span, check: ^SemaBodyCheck) -> CoreCallRecord? {
    target: sema_call_core_role_target(role, type_args, span, check.environment.*, check.program.*, check.diagnostics) ?? return None
    params: sema_call_params_from_type(target.signature) ?? return None
    borrowed: loop param in params -> param.convention != AccessConvention.Move
    Val(core_call_role_receiver(receiver_type, method, role, borrowed))
}

sema_data_event_time_callback: fn(method: String, element: Type, argument: CallArg, check: ^SemaBodyCheck) -> SemaDataQueryCallback {
    required: Type.Fn{params: [Type]{element}, ret: None, effect_bound: Val([EffectRowEntry]{}), param_contract: None, call_metadata: None, return_view_provenance: None}
    checked: sema_expression_lambda_collection_callback(argument.expr, Val(required), check) ?? return SemaDataQueryCallback{value: None, result: None}
    if checked.ty == {
        .Fn(params, ret, _, _, _, _) -> {
            if params.len() == 1 && params[0] == element && sema_data_fn_has_empty_effect_bound(checked.ty) {
                return SemaDataQueryCallback{value: Val(checked), result: ret}
            }
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    check.diagnostics.push(sema_error("E0112", expr_span(argument.expr), "`{method}` wants a callback `fn({sema_type_show(element)}) -> …` without effects, but this is {sema_type_show(checked.ty)}", "the stream calls it once for each element as the stream is pulled", "pass a lambda over one element, such as `fn(event: {sema_type_show(element)}) {{ event.timestamp }}`"))
    SemaDataQueryCallback{value: None, result: None}
}

sema_data_event_time_is_datetime: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Named(name) -> return name == "DateTime" || (core_identity_in_module(name, "core.time") && name.ends_with(".DateTime"))
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> return false
    }
}

// `stream.with_event_time(f)` on the builtin pull stream is
// `StreamEventTime<T>`, whose Core declaration carries the later stages
// (`key_by`, `window`). The stage moves its receiver into its core.data source
// stage. The stream calls `f` once per element as it is pulled, so `f` takes
// the element, carries no effects and returns the element's event time.
sema_data_try_event_time_method: fn(receiver: Expr, receiver_value: TExpr, name: String, parameters: [Type], method: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if name != "Stream" || parameters.len() != 1 || method != "with_event_time" {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if type_args.len() != 0 || args.len() != 1 {
        if type_args.len() != 0 {
            sema_data_check_explicit_type_args("Stream.{method}", type_args, 0, span, check.diagnostics)
        }
        if args.len() != 1 {
            check.diagnostics.push(sema_wrong_core_arity(method, 1, args.len(), span))
        }
        sema_data_check_discarded_arguments(args, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    ^complete: true
    if args[0].label == .Val(label) {
        check.diagnostics.push(sema_error("E0767", label.span, "argument 1 of `.{method}()` is positional, so it takes no label `{label.name}:`", "the first argument of an event-time stage is its subject and has no name", "drop `{label.name}:`"))
        complete = false
    }
    element: parameters[0]
    ^source_args: [CallArg]{CallArg{convention: AccessConvention.Move, expr: receiver, span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}}
    ^argument_types: [Type]{receiver_value.ty}
    ^typed: [TExpr]{receiver_value}
    ^role: "StreamWithEventTime"
    callback: sema_data_event_time_callback(method, element, args[0], check)
    if !sema_data_query_push_argument(args[0], callback.value, source_args, argument_types, typed) {
        complete = false
    }
    if callback.result == .Val(stamp) {
        if sema_data_event_time_is_datetime(stamp) -> role = "StreamWithEventDatetime" else if stamp != Type.Int {
            check.diagnostics.push(sema_error("E0112", expr_span(args[0].expr), "`with_event_time` wants the callback to return `Int` Unix seconds or a `DateTime`, but it returns {sema_type_show(stamp)}", "the result is the element's event time", "return the element's timestamp as Unix seconds or a `DateTime`"))
            complete = false
        }
    }
    if !complete -> return SemaMethodSpecialCheck{handled: true, value: None}
    record: sema_data_role_record("Stream", method, role, [Type]{element}, span, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    result_type: Type.Apply{name: sema_data_source_type_name(check, "StreamEventTime"), args: [Type]{element}}
    value: sema_data_core_emit(record, "Stream.{method}", source_args, argument_types, typed, [Type]{element}, result_type, span, expected, check)
    SemaMethodSpecialCheck{handled: true, value: value}
}

// The jet_builtins role of the grouped-sum reducer for a `value` column.
sema_data_group_sum_role: fn(value: Type) -> String Never! {
    if value == {
        .Float -> "GroupSumFloat"
        .Float32 -> "GroupSumF32"
        .IntN(signed, bits) -> if signed -> "GroupSumI{bits}" else -> "GroupSumU{bits}"
        .Int | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .InlineRange(_, _, _) | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> "GroupSumInt"
    }
}

// (`[T].query(sql)`): an in-memory row list runs one checked SQL query into the
// deferred `Query<T>` carrier, through the Core function that fills ListQuery
// with the list as its first argument.
sema_data_check_list_query: fn(receiver: Expr, receiver_value: TExpr, row: Type, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if args.len() != 1 {
        check.diagnostics.push(sema_wrong_core_arity("query", 1, args.len(), span))
        sema_data_check_discarded_arguments(args, check)
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    sema_data_check_analytics_sql_schema(row, args[0].expr, expr_span(args[0].expr), check)
    sql: Type.Named{name: "SQL"}
    query: sema_data_expect_core_arg("query", 0, sql, args[0], check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    record: sema_data_role_record("List", "query", "ListQuery", [Type]{row}, span, check) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    ^source_args: [CallArg]{CallArg{convention: AccessConvention.Read, expr: receiver, span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}}
    loop argument in args -> source_args.push(argument.copy())
    result_type: Type.Result{ok: Type.Apply{name: sema_data_source_type_name(check, "Query"), args: [Type]{row}}, err: sema_data_decode_error()}
    value: sema_data_core_emit(record, "query", source_args, [Type]{receiver_value.ty, sql}, [TExpr]{receiver_value, query}, [Type]{row}, result_type, span, expected, check)
    SemaMethodSpecialCheck{handled: true, value: value}
}

sema_call_try_data_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    ^resolved_ty: sema_call_resolved_type(receiver_value.ty, check.environment.*, check.program.*)
    if resolved_ty == .Apply(name, parameters) {
        query: sema_data_try_query_method(receiver, receiver_value, name, parameters, method, args, type_args, span, expected, check)
        if query.handled -> return query
        stage: sema_data_try_event_time_method(receiver, receiver_value, name, parameters, method, args, type_args, span, expected, check)
        if stage.handled -> return stage
    }
    if method == "query" && resolved_ty == .List(row) {
        return sema_data_check_list_query(receiver, receiver_value, row, args, span, expected, check)
    }
    sema_dyn_try_method(receiver, receiver_value, resolved_ty, method, args, type_args, span, expected, check)
}

sema_data_core_param: fn(label: String, ty: Type, convention: AccessConvention, zone: ParamZone, default: Expr?) -> SemaCallParam Never! {
    SemaCallParam{label: label, name: label, zone: zone, default: default, default_ref: None, convention: convention, ty: Val(ty), variadic: false}
}

sema_data_core_param_access: fn(record: CoreCallRecord, index: Int, span: Span, diagnostics: ^[Diagnostic]) -> AccessConvention? {
    if sema_call_core_access(record, index) == .Val(access) -> return Val(access)
    if index >= record.signature.arity && index < record.signature.max_arity {
        return Val(AccessConvention.Read)
    }
    diagnostics.push(sema_error("E0003", span, "`{record.module_name}.{record.member}` has no ownership convention for parameter {index}", "checked Core arguments must use the registry's canonical access metadata", "repair the Core registry signature"))
    None
}

sema_data_core_emit: fn(record: CoreCallRecord, call_name: String, source_args: [CallArg], argument_types: [Type], typed_args: ^^[TExpr], type_args: [Type], result_type: Type, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    accesses: loop index in 0..<typed_args.len() -> {
        access: sema_data_core_param_access(record, index, span, check.diagnostics) ?? return None
        access
    }
    sema_data_core_emit_with_accesses(record, call_name, source_args, argument_types, typed_args.move(), accesses, type_args, result_type, span, expected, check)
}

// One checked Core call over explicit parameter accesses: a `^` slot lends the
// caller's place for the call (the registry row only says it is borrowed).
sema_data_core_emit_with_accesses: fn(record: CoreCallRecord, call_name: String, source_args: [CallArg], argument_types: [Type], typed_args: ^^[TExpr], accesses: [AccessConvention], type_args: [Type], result_type: Type, span: Span, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    ^updated_source_args: source_args
    if argument_types.len() != typed_args.len() || updated_source_args.len() != typed_args.len() || accesses.len() != typed_args.len() {
        check.diagnostics.push(sema_error("E0003", span, "`{call_name}` has an incomplete checked argument list", "the checked Core call stores every checked argument in the registry ABI order", "repair the Core call body"))
        return None
    }
    ^params: [SemaCallParam]{}
    ^arguments: [TExpr]{}
    ^index: 0
    loop value in typed_args.move() {
        access: accesses[index]
        params.push(sema_data_core_param("arg{index}", argument_types[index], access, ParamZone.PositionalOnly, None))
        if access == AccessConvention.Write {
            arguments.push(sema_tree_node(value.ty, TExprKind.Borrow{place: value, access: AccessConvention.Write}, value.span))
        } else { arguments.push(sema_services_apply_access(value, access)) }
        index += 1
    }
    ^ownership: sema_ownership_check_call_arguments(check.state, call_name, params, updated_source_args, check.scopes, check.diagnostics)
    if !ownership.accepted || !ownership.complete -> return None
    ^fallibility: sema_call_failure_carrier(Val(result_type))
    if !sema_call_core_record_effects(record, span, type_args, result_type, fallibility, [FunctionDefaultRef]{}, check) {
        return None
    }

    // A checked call finishes like the fixed Core route: inside a fallible
    // body's success view a Result call is compared by its success side.
    value: sema_call_core_tree(record, arguments, span, type_args, result_type, None, check) ?? return None
    sema_expression_call_expected(value, expected, check)
}

// `exactly_one_type_arg`: a typed decode/query call names one target type.
sema_data_core_target_type: fn(type_args: [Type], name: String, span: Span, check: ^SemaBodyCheck) -> Type? {
    if type_args.len() != 1 {
        check.diagnostics.push(sema_error("E0119", span, "`{name}` expects exactly one type argument, got {type_args.len()}", "a typed decode call needs one target type", "write `{name}<Target>(...)` with one target type"))
        return None
    }
    ^target: type_args[0]
    graph: check.program.registration_graph
    target = sema_type_resolve_declared_with_generics(graph, target, check.environment.module_identity, check.environment.generic_params)
    Val(target)
}

sema_data_db_names_row_type: fn() -> Type Never! {
    Type.Tuple{fields: [TypeTupleField]{TypeTupleField{name: "db_name", ty: Type.String}, TypeTupleField{name: "key", ty: Type.String}}}
}

// `db.decode<T>(row)`'s column renames: the checked column name (its `db`
// shape name, else its shared name) and decode key (its JSON shape name, else
// its shared name) of every non-skipped stored field of the record `target`
// whose column differs from its key, as a list literal.
sema_data_db_names: fn(target: Type, check: SemaBodyCheck, span: Span) -> Expr Never! {
    ^rows: [Expr]{}
    definition: sema_http_route_find_struct(check, target, check.environment.module_identity) ?? return Expr.ListLit{elements: rows, span: span, id: AST_NODE_GENERATED}
    loop field in definition.fields {
        if field.computed != None || sema_serde_items_skips(field) || sema_checked_marker(field.serde_markers, "skip") != None {
            next
        }
        names: sema_checked_field_shape_names(definition, field)
        column: names.db ?? names.text
        key: names.format_key("json") ?? names.text
        if column == key -> next
        db_name: Expr.Str{parts: [StrPart]{StrPart.Lit{text: column}}, span: span, id: AST_NODE_GENERATED}
        key_text: Expr.Str{parts: [StrPart]{StrPart.Lit{text: key}}, span: span, id: AST_NODE_GENERATED}
        rows.push(Expr.TupleLit{fields: [TupleField]{TupleField{name: "db_name", value: db_name}, TupleField{name: "key", value: key_text}}, span: span, ty: Val(sema_data_db_names_row_type()), id: AST_NODE_GENERATED})
    }
    Expr.ListLit{elements: rows, span: span, id: AST_NODE_GENERATED}
}

sema_data_is_db_decode: fn(target: SemaCallDirectTarget, check: SemaBodyCheck) -> Bool Never! {
    target.symbol.name == "decode" && sema_call_core_module_is(check, "core.db", target.symbol.module_identity)
}

// `json`/`toml`/`yaml` `to_string<T: Encode>(value)`: the `Encode` bound
// answers for a generic codec's head, so `Wrap<Plain>` passes it even when
// `Plain` has no wire form. The applied value is E2411 at the argument
// (a non-codable type argument fails at the use site).
sema_data_encode_check_value: fn(target: SemaCallDirectTarget, args: [CallArg], checked: TExpr, check: ^SemaBodyCheck) -> Bool Never! {
    if target.symbol.name != "to_string" || args.len() != 1 -> return true
    ^encoder: false
    loop module_name in ["core.encoding.json", "core.encoding.toml", "core.encoding.yaml"] {
        if sema_call_core_module_is(check, module_name, target.symbol.module_identity) {
            encoder = true
        }
    }
    if !encoder -> return true
    value: if checked.kind == {
        .Call(_, inferred, _) -> {
            if inferred.len() != 1 -> return true
            inferred[0]
        }
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> {
            return true
        }
    }
    applied: if value == {
        .Apply(_, _) -> true
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
    if !applied || sema_serde_type_is_admissible(check.environment.*, check.program.*, value, SemaSerdeDirection.Encode) {
        return true
    }
    sema_call_http_check_serde(SemaSerdeDirection.Encode, value, expr_source_span(args[0].expr), check)
    false
}

// `db.decode<T>(row)` passes the column renames of T's fields after the row
// (sema_data_db_names).
sema_data_db_decode_args: fn(args: [CallArg], type_args: [Type], span: Span, check: ^SemaBodyCheck) -> [CallArg]? {
    target: sema_data_core_target_type(type_args, "decode", span, check) ?? return None
    ^bound: args
    bound.push(CallArg{convention: AccessConvention.Read, expr: sema_data_db_names(target, check, span), span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: Val(CallLabel{name: "names", span: span}), spread: false})
    Val(bound)
}

// `args.decode<T>()` calls the decoder the `#CLI` expansion gives `T`
// (sema_cli_entry_projections): it parses the process arguments through the
// same spec as `run: fn(args: T)`.
sema_data_args_decode: fn(args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if args.len() != 0 {
        sema_data_arity_diagnostic("core.args.decode", 0, args.len(), span, check.diagnostics)
        sema_data_check_discarded_arguments(args, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    target: sema_data_core_target_type(type_args, "decode", span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    definition: sema_http_route_find_struct(check, target, check.environment.module_identity)
    ^cli: false
    if definition == .Val(found) {
        loop derive_item in found.derives {
            if derive_item.name == "CLI" -> cli = true
        }
    }
    if !cli {
        check.diagnostics.push(sema_error("E0905", span, "`{type_name(target)}` is not a `#CLI` struct", "`args.decode<T>` decodes the process arguments through the command-line shape of a `#CLI` struct", "mark the struct `#CLI`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^receiver: Expr?{None}
    if type_args[0] == .Named(name) {
        parts: name.split(".").to_list()
        loop part in parts.move() {
            receiver = if receiver == {
                .Val(base) -> Val(Expr.Field{base: base, member: part, span: span, id: AST_NODE_GENERATED})
                .None -> Val(Expr.Ident{name: part, span: span, id: AST_NODE_GENERATED})
            }
        }
    }
    owner: receiver ?? {
        check.diagnostics.push(sema_error("E0905", span, "`{type_name(target)}` is not a `#CLI` struct", "`args.decode<T>` decodes the process arguments through the command-line shape of a `#CLI` struct", "name the `#CLI` struct as the type argument"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    call: Expr.MethodCall{receiver: owner, method: SEMA_CLI_DECODE_METHOD, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, id: AST_NODE_GENERATED}
    SemaDirectSpecialCheck{handled: true, value: sema_check_expression(call, expected, check)}
}

// `args.decode<T>()` is compiler-owned with no Core registry row: its body is
// the `#CLI` expansion of `T`, so (like `ui.mount`) it resolves through the
// import before the registry route.
sema_call_try_args_decode: fn(module_name: String, member: String, alias: String, alias_span: Span, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if module_name != "core.args" || member != "decode" {
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    imported: sema_call_core_import_target(check.environment.*, check.program.*, alias) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    if !sema_call_core_record_import_reference(check, imported, alias_span) {
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    sema_data_args_decode(args, type_args, span, expected, check)
}

sema_data_sql_ascii_equal: fn(left: String, right: String) -> Bool Never! {
    ^a: left.bytes()
    ^b: right.bytes()
    if a.len() != b.len() -> return false
    loop index in 0..<a.len() {
        ^l: a[index]
        ^r: b[index]
        if l >= (U8{65}) && l <= (U8{90}) -> l += U8{32}
        if r >= (U8{65}) && r <= (U8{90}) -> r += U8{32}
        if l != r -> return false
    }
    true
}

sema_data_sql_word_character: fn(byte: U8) -> Bool Never! {
    (byte >= U8{48} && byte <= U8{57}) || (byte >= U8{65} && byte <= U8{90}) || (byte >= U8{97} && byte <= U8{122}) || byte == U8{95}
}

sema_data_sql_column_token: fn(raw: String) -> String Never! {
    ^value: raw.trim().replace(",", "").replace(";", "")
    ^pieces: value.split("(").to_list()
    if pieces.len() > 1 -> value = pieces[pieces.len() - 1]
    pieces = value.split(".").to_list()
    if pieces.len() > 1 -> value = pieces[pieces.len() - 1]
    ^bytes: value.bytes()
    ^start: 0
    ^end: bytes.len()
    loop start < end && !sema_data_sql_word_character(bytes[start]) -> start += 1
    loop end > start && !sema_data_sql_word_character(bytes[end - 1]) -> end -= 1
    if start == end -> return ""
    String.from_bytes(bytes.slice(start, end)) ?? ""
}

sema_data_analytics_sql_literal: fn(expression: Expr) -> String? {
    if expression == {
        .TypedLit(head, body, _, _) -> {
            if head != .Val(Type.Named{name: "SQL"}) -> return None
            if body == {
                .Value(value) -> {
                    if value == {
                        .Str(parts, _, _) -> {
                            ^result: ""
                            loop part in parts {
                                if part == {
                                    .Lit(text) -> { result += text }
                                    .Interp(_, _) | .Byte(_) -> {}
                                }
                            }
                            return Val(result)
                        }
                        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
                    }
                }
                .Fields(_) | .Elements(_) | .Entries(_) | .ByteText(_) | .Empty -> return None
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return None
    }
}

sema_data_analytics_sql_columns: fn(sql: String) -> [String] Never! {
    ^normalized: sql.replace("\n", " ").replace("\r", " ").replace("\t", " ")
    ^tokens: [String]{}
    loop token in normalized.split(" ") {
        ^value: token.trim()
        if value != "" -> tokens.push(value)
    }
    ^columns: [String]{}
    ^select: -1
    ^from: -1
    loop (index, token) in tokens {
        if select < 0 && sema_data_sql_ascii_equal(token, "select") -> select = index
        if from < 0 && sema_data_sql_ascii_equal(token, "from") -> from = index
    }
    if select >= 0 && from > select + 1 {
        loop index in (select + 1)..<from {
            ^token: sema_data_sql_column_token(tokens[index])
            if token != "" && token != "*" && !sema_data_sql_ascii_equal(token, "as") {
                columns.push(token)
            }
        }
    }
    loop (index, token) in tokens {
        ^offset: if {
            sema_data_sql_ascii_equal(token, "where") -> 1
            sema_data_sql_ascii_equal(token, "order") || sema_data_sql_ascii_equal(token, "group") -> 2
            else -> 0
        }
        if offset > 0 && index + offset < tokens.len() {
            ^name: sema_data_sql_column_token(tokens[index + offset])
            if name != "" -> columns.push(name)
        }
    }
    columns
}

sema_data_check_analytics_sql_schema: fn(row: Type, query: Expr, span: Span, check: ^SemaBodyCheck) {
    sql: sema_data_analytics_sql_literal(query) ?? return
    name: sema_data_type_name(row) ?? return
    definition: sema_serde_type_definition(check.environment.*, check.program.*, name) ?? return
    if definition.kind == {
        .Struct(fields, _) -> {
            known: loop field in fields -> field.name
            loop column in sema_data_analytics_sql_columns(sql) {
                ^found: false
                loop field in known {
                    if field == column -> found = true
                }
                if !found {
                    check.diagnostics.push(sema_error("E2420", span, "unknown analytics column `{column}`", "`{column}` is not a field on `{name}`; the analytics engine would fail at runtime, but Jet checks this schema at compile time", "write one of: {known.join(", ")}"))
                }
            }
        }
        .Enum(_, _) | .Distinct(_, _) | .Alias(_) | .UnitFamily(_, _) -> {}
    }
}

// `data.query(source)` through a Core module alias, `core.data.query` under
// `use core` included, checked before any route: a typed row list runs
// core.data's own `query`, a tracked source or a stream the Core function
// that fills QueryTracked or QueryStream.
sema_call_try_data_query: fn(module_name: String, member: String, alias: String, alias_span: Span, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    unhandled: SemaDirectSpecialCheck{handled: false, value: None}
    if module_name != "core.data" || member != "query" -> return unhandled
    imported: sema_call_core_import_target(check.environment.*, check.program.*, alias) ?? return unhandled
    if !sema_call_core_import_is_unshadowed(check.environment.*, check.program.*, check.scopes, imported) {
        return unhandled
    }
    if !sema_call_core_record_import_reference(check, imported, alias_span) -> return unhandled
    rejected: SemaDirectSpecialCheck{handled: true, value: None}
    if type_args.len() != 0 {
        sema_data_check_explicit_type_args("{module_name}.{member}", type_args, 0, span, check.diagnostics)
        sema_data_check_discarded_arguments(args, check)
        return rejected
    }
    if args.len() != 1 {
        sema_data_arity_diagnostic("{module_name}.{member}", 1, args.len(), span, check.diagnostics)
        sema_data_check_discarded_arguments(args, check)
        return rejected
    }
    first: sema_check_expression(args[0].expr, None, check) ?? return rejected
    ^row: Type?{None}
    ^query_source: String?{None}
    ^query_type_args: [Type]{}
    first_expected: first.ty
    if first.ty == {
        .List(element) -> { row = Val(element) }
        .Apply(name, parameters) -> {
            if {
                sema_data_nominal_is(name, "DataTracked") && parameters.len() == 2 -> {
                    row = Val(parameters[0])
                    query_source = Val("QueryTracked")
                    query_type_args = [Type]{parameters[0], parameters[1]}
                }
                sema_data_nominal_is(name, "DataStream") && parameters.len() == 1 -> {
                    row = Val(parameters[0])
                    query_source = Val("QueryStream")
                }
            }
        }
        .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    row_type: row ?? {
        check.diagnostics.push(sema_error("E0112", args[0].span, "`data.query` needs `[Row]`, `DataTracked<Row, Key>`, or `DataStream<Row>`, not `{type_name(first.ty)}`", "a query keeps one typed row shape", "pass a typed row list, tracked source, or stream"))
        return rejected
    }
    if query_type_args.len() == 0 -> query_type_args = [Type]{row_type}
    result_type: Type.Apply{name: sema_data_source_type_name(check, "Query"), args: [Type]{row_type}}
    record: sema_call_core_function_record(module_name, member, query_source, query_type_args, span, check) ?? return rejected
    typed: [TExpr]{first}
    argument_types: [Type]{first_expected}
    result: sema_data_core_emit(record, "{module_name}.{member}", args, argument_types, typed, query_type_args, result_type, span, expected, check) ?? return rejected
    SemaDirectSpecialCheck{handled: true, value: Val(result)}
}
