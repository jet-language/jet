// Checked producers for typed Email values. `Regex`/`Match` (`core.regex`),
// `URL` and `MIME` (`core.net.url`/`core.net.mime`) are source records: their
// documented fields and methods resolve through the declarations, with no
// handle twins.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    Expr,
    Span,
    SymbolKind,
    Type,
    core_identity_is,
]

fn sema_text_handle_parameter(name: String, ty: Type) -> SemaCallParam Never! {
    sema_network_handle_argument(name, ty)
}

fn sema_text_handle_result(ok: Type, err: Type) -> Type Never! {
    sema_network_handle_result(ok, err)
}

fn sema_text_handle_owner_module(owner: String) -> String Never! {
    if owner == "Message" || owner == "Mailer" -> return "core.email"
    ""
}

// A Core owner reaches sema either by its bare leaf (`Message`) or by the
// canonical identity Registration gives a source-declared Core nominal
// (`<corelib>/core.email::Message`); both name the same owner.
fn sema_text_handle_nominal_owner(ty: Type) -> String? {
    if ty == {
        .Named(name) -> Val(sema_text_handle_owner_leaf(name))
        .Apply(name, _) -> Val(sema_text_handle_owner_leaf(name))
        .Tagged(_, inner) -> sema_text_handle_nominal_owner(inner)
        else -> None
    }
}

fn sema_text_handle_owner_leaf(name: String) -> String Never! {
    loop leaf in ([String]{"Message", "Mailer"}) {
        if core_identity_is(name, sema_text_handle_owner_module(leaf), leaf) -> return leaf
    }
    name.copy()
}

fn sema_text_handle_written_name(ty: Type) -> String Never! {
    if ty == {
        .Named(name) | .Apply(name, _) -> name
        .Tagged(_, inner) -> sema_text_handle_written_name(inner)
        else -> ""
    }
}

// Rust `email_method_return` claims a receiver by its type name alone
// (net_text_time.rs:668). A canonical Core identity is the owner itself; a
// bare name the module resolves names the Core owner only when that
// declaration belongs to the owner's Core module, and a bare name the module
// does not bind is the Core handle.
fn sema_text_handle_is_canonical(receiver_type: Type, owner: String, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool Never! {
    actual :: sema_text_handle_nominal_owner(receiver_type) ?? return false
    if actual != owner -> return false
    expected_module := sema_text_handle_owner_module(owner)
    written :: sema_text_handle_written_name(receiver_type)
    if written != owner -> return core_identity_is(written, expected_module, owner)
    if program.registration_graph == .Val(graph) {
        resolved :: sema_type_graph_lookup_symbol(graph, environment.module_identity, actual)
        if resolved == .Val(symbol) -> return sema_resolved_kind(graph, symbol) == SymbolKind.Type && (sema_registration_module_name(graph, sema_resolved_module_name(graph, symbol)) ?? "") == expected_module
    }
    true
}

fn sema_email_handle_spec(owner: String, method: String, argc: Int) -> SemaNetworkHandleSpec? {
    if owner == "Message" && method == "envelope" && argc == 0 -> return Val(SemaNetworkHandleSpec{operation: THandleOp.EmailMethod{method: method}, result_type: Type.Named{name: "Envelope"}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, callback_non_escaping: false, effect_name: Val("")})
    if owner == "Message" && method == "with_envelope" && argc == 1 -> return Val(SemaNetworkHandleSpec{operation: THandleOp.EmailMethod{method: method}, result_type: sema_text_handle_result(Type.Named{name: "Message"}, Type.Named{name: "EmailError"}), params: [SemaCallParam]{sema_text_handle_parameter("envelope", Type.Named{name: "Envelope"})}, receiver_convention: AccessConvention.Read, callback_non_escaping: false, effect_name: Val("")})
    if owner == "Mailer" && method == "send" && argc == 1 -> return Val(SemaNetworkHandleSpec{operation: THandleOp.EmailMethod{method: method}, result_type: sema_text_handle_result(Type.Named{name: "SendReport"}, Type.Named{name: "EmailError"}), params: [SemaCallParam]{sema_network_handle_argument_move("message", Type.Named{name: "Message"})}, receiver_convention: AccessConvention.Write, callback_non_escaping: false, effect_name: None})
    None
}

// The native EmailMethod lowering remains a primitive structural operation;
// this producer preserves the exact checker contract without inventing a
// Prelude symbol or an Email effect row that the native method contract lacks.
fn sema_call_try_email_handle_method(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    owner :: sema_text_handle_nominal_owner(receiver_value.ty) ?? return SemaMethodSpecialCheck{handled: false, value: None}
    if (owner != "Message" && owner != "Mailer") || !sema_text_handle_is_canonical(receiver_value.ty, owner, environment, program) -> return SemaMethodSpecialCheck{handled: false, value: None}
    if (owner == "Message" && method != "envelope" && method != "with_envelope") || (owner == "Mailer" && method != "send") -> return SemaMethodSpecialCheck{handled: false, value: None}
    spec := sema_email_handle_spec(owner, method, args.len())
    if spec == None {
        sema_network_handle_infer_args(args, environment, program, &scopes, &state, &tail_store, &context, &diagnostics)
        expected_count := if method == "envelope" -> 0 else -> 1
        &diagnostics.push(sema_call_arity_diagnostic("{owner}.{method}", expected_count, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    signature :: spec ?? SemaNetworkHandleSpec{operation: THandleOp.EmailMethod{method: method}, result_type: Type.Named{name: "Unit"}, params: [SemaCallParam]{}, receiver_convention: AccessConvention.Read, callback_non_escaping: false, effect_name: Val("")}
    typed_args :: sema_network_handle_checked_args(method, signature.params, args, Val(receiver), signature.receiver_convention, false, span, environment, program, &scopes, &state, &tail_store, &context, &diagnostics) ?? return SemaMethodSpecialCheck{handled: true, value: None}
    sema_network_handle_finish(receiver_value, signature.operation, typed_args, signature.result_type, signature.effect_name, "{owner}.{method}", span, expected, environment, program, &scopes, &context, &diagnostics)
}
