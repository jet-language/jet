// The app graph. `app.new(title)` starts the graph, `.api<S>(path,
// max_upload:)` declares the service `S` its clients reach at `path`,
// `.mount(service)` answers that service's calls in this process, and
// `.screen(path, view, signed_in:)` registers a screen. `view` is a named
// function, and its one parameter that is no `app.Remote<S>` is the screen's
// state: a struct declared outside Core with no type parameters, whose
// fields each derive `Encode` and `Decode`. The state is the screen's
// address: each `:name` segment of `path` is the field `name`, each
// `#App.Query` field goes after `?`, and every other field must be a path
// segment (E2820 otherwise). The call lowers to `App.__screen<V>`, which adds
// the screen to the graph's route set with its opener: from the texts of an
// address's fields it makes the state, runs `view` with it and, for each
// `app.Remote<S>` parameter, the graph's Remote of `S` (`App.__remote<S>`),
// and gives the text of what the view shows. `app.url_of(view)`,
// `app.presence(view)` and a push's
// `app.notify(to:, title:, body:, open: view)` lower to `App.__url_of<V>`,
// the address of the screen whose state is the value's type, each field
// read through `App.__address_arg`; `presence` passes the address to
// `App.__presence`, the accounts that have that state open; `app.go(view)`
// lowers to `App.__go<V>`, which opens that screen at that address, and
// `app.current<V>()` to `App.__current<V>`, which makes the current screen's
// state back from its address. Every target runs the program's one graph,
// so its screens are every target's route set: in a program that registers
// screens, a state that none of them opens is E2821 where an address is
// taken of it, or it is opened or read (sema_app_route_diagnostics).
// `.sitemap(list)` lowers to `App.__sitemap<V>`, which takes each state
// `list` gives to its address the same way (sema_call_app_sitemap), and
// `.head(head)` to `App.__head<V>`, the page metadata of the screen whose
// state is `V` (sema_call_app_head).
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    Call,
    CallArg,
    CompilerThreads,
    Diagnostic,
    EnumLitArg,
    Expr,
    ExprField,
    Field,
    Lambda,
    LambdaBody,
    LambdaParam,
    ModuleID,
    NamedSpan,
    NodeKind,
    OrFallback,
    Span,
    Stmt,
    StrPart,
    SymbolKind,
    Type,
    TypedLitBody,
    ast_binding,
    ast_empty_lambda_meta,
    compiler_threads_admit,
    compiler_threads_joined,
    compiler_threads_partition,
    expr_span,
    module_is_core,
    name_count,
    name_find,
    name_intern,
    name_table,
    type_name,
]

// The app module's graph type, its query marker, and the graph's members
// that `.api`, `.screen`, `url_of`, `presence`, `notify`, `go` and `current`
// lower to.
SEMA_APP_GRAPH: "App"

SEMA_APP_QUERY_MARKER: "Query"

SEMA_APP_API: "__api"

SEMA_APP_SCREEN: "__screen"

SEMA_APP_URL_OF: "__url_of"

SEMA_APP_ADDRESS_ARG: "__address_arg"

SEMA_APP_NOTIFY: "__notify"

SEMA_APP_NOTIFY_HERE: "__notify_here"

SEMA_APP_PRESENCE: "__presence"

SEMA_APP_GO: "__go"

SEMA_APP_CURRENT: "__current"

// core.ui's node tree, which a view may give: its page is the tree's HTML.
SEMA_APP_NODE_MODULE: "core.ui"

SEMA_APP_NODE: "UINode"

// The most bytes one call's body holds when `.api` names no `max_upload:`.
SEMA_APP_MAX_UPLOAD: 1000000

// A screen's state: the key the route set knows it by (its nominal's
// identity), its name, its stored fields in order with their types, the
// fields `#App.Query` marks, and the module that declares it.
SemaAppState: struct {
    key: String,
    name: String,
    fields: [String],
    types: [Type],
    query: [String],
    module_identity: ModuleID,
}

// Whether `ty` is `app.App`, the app graph.
sema_app_is_graph: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    graph: program.registration_graph
    row: sema_type_resolve_nominal_row(graph, sema_call_resolved_type(ty, environment, program), environment.module_identity) ?? return false
    module_row: graph.modules[row.module_index]
    module_is_core(module_row.module_identity) && module_row.module_name == SEMA_APP_MARKER_MODULE && module_row.nominals[row.row].symbol.name == SEMA_APP_GRAPH
}

// Whether `ty`, seen from `module_identity`, is core.ui's node tree, which a
// screen's view may give for its page.
sema_app_is_node: fn(graph: SemaRegistrationGraph, ty: Type, module_identity: ModuleID) -> Bool {
    row: sema_type_resolve_nominal_row(graph, ty, module_identity) ?? return false
    module_row: graph.modules[row.module_index]
    module_is_core(module_row.module_identity) && module_row.module_name == SEMA_APP_NODE_MODULE && module_row.nominals[row.row].symbol.name == SEMA_APP_NODE
}

// The screen state `ty` is, seen from `module_identity`; None when `ty` is no
// struct declared outside Core, or one with type parameters.
sema_app_state: fn(graph: SemaRegistrationGraph, ty: Type, module_identity: ModuleID) -> SemaAppState? {
    row: sema_type_resolve_nominal_row(graph, ty, module_identity) ?? return None
    module_row: graph.modules[row.module_index]
    if module_is_core(module_row.module_identity) -> return None
    nominal: module_row.nominals[row.row]
    if nominal.kind != SemaRegistrationNominalKind.Struct || nominal.generic_params.len() != 0 {
        return None
    }
    ^found: SemaAppState{key: nominal.identity_key.copy(), name: nominal.symbol.name.copy(), fields: [String]{}, types: [Type]{}, query: [String]{}, module_identity: module_row.module_identity}
    loop field in nominal.fields {
        if field.computed -> next
        found.fields.push(field.symbol.name)
        found.types.push(field.ty)
    }
    item: sema_registration_nominal_source_item(nominal.source) ?? return Val(found)
    if item == .Struct(definition) {
        loop field in definition.fields {
            loop marker in field.serde_markers {
                if sema_app_marker_is(marker, SEMA_APP_QUERY_MARKER, graph, module_row.module_identity) {
                    found.query.push(field.name)
                }
            }
        }
    }
    Val(found)
}

sema_app_screen_error: fn(path: String, found: String, span: Span) -> Diagnostic {
    entry: sema_diagnostic_row("E2820")
    sema_error("E2820", span, entry.what.replace("{{path}}", path).replace("{{found}}", found), entry.why, entry.fix)
}

sema_app_no_screen: fn(state: String, span: Span) -> Diagnostic {
    entry: sema_diagnostic_row("E2821")
    sema_error("E2821", span, entry.what.replace("{{state}}", state), entry.why.replace("{{state}}", state), entry.fix.replace("{{state}}", state))
}

// `graph.screen(path, view, signed_in:)` on an `app.App`: checks `view`'s
// state against `path` and lowers the call to `graph.__screen<V>(path, key,
// query, signed_in, open)`, where `open` is the screen's opener
// (`sema_app_screen_opener`), checked with no effect bound
// (`sema_app_screen_callback`).
sema_call_app_screen: fn(receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    graph: check.program.registration_graph
    ^positional: [CallArg]{}
    ^signed_in: Expr?{None}
    loop argument in args {
        if argument.spread {
            check.diagnostics.push(sema_error("E0104", argument.span, "`.screen` can't spread its arguments", "`.screen(path, view, signed_in:)` takes a path, a view and whether only a signed-in caller opens it", "pass each argument"))
            return rejected
        }
        if argument.label == .Val(label) {
            if label.name == "signed_in" && signed_in == None {
                signed_in = Val(argument.expr.copy())  // copy: the caller's argument list keeps its expression
                next
            }
            check.diagnostics.push(sema_error("E0104", label.span, "`.screen` has no parameter `{label.name}`", "`.screen(path, view, signed_in:)` takes a path, a view and whether only a signed-in caller opens it", "remove the `{label.name}:` argument"))
            return rejected
        }
        positional.push(argument.copy())  // copy: the caller's argument list keeps its arguments
    }
    if positional.len() != 2 {
        check.diagnostics.push(sema_call_arity_diagnostic("screen", 2, positional.len(), false, span))
        return rejected
    }
    path: sema_app_literal_text(positional[0].expr) ?? {
        check.diagnostics.push(sema_app_screen_error("…", "its path is not a string literal", positional[0].span))
        return rejected
    }
    if !path.starts_with("/") {
        check.diagnostics.push(sema_app_screen_error(path, "the path does not start with `/`", positional[0].span))
        return rejected
    }
    handler: sema_app_named_handler("screen", positional[1], check) ?? return rejected
    view_module: handler.function.symbol.module_identity
    ^states: [Type]{}
    // The view's parameters in order: the service of each `app.Remote<S>`
    // one, with its key, and None for the state.
    ^services: [{ty: Type, key: String}?]{}
    loop parameter in handler.function.declaration.params {
        ty: sema_type_resolve_declared(graph, parameter.ty, view_module)
        if !sema_app_is_remote(ty, check) {
            states.push(ty)
            services.push(None)
            next
        }
        service: sema_app_remote_service(graph, ty, view_module) ?? {
            check.diagnostics.push(sema_app_screen_error(path, "the parameter `{parameter.name}` of `{handler.name}` is the Remote of no service struct", positional[1].span))
            return rejected
        }
        services.push(Val(service))
    }
    if states.len() != 1 {
        check.diagnostics.push(sema_app_screen_error(path, "`{handler.name}` takes {states.len()} parameters besides its `app.Remote<S>` ones, and a view takes one, its state", positional[1].span))
        return rejected
    }
    found: sema_app_state(graph, states[0], view_module) ?? {
        check.diagnostics.push(sema_app_screen_error(path, "the state `{type_name(states[0])}` of `{handler.name}` is no struct declared outside Core, or has type parameters", positional[1].span))
        return rejected
    }
    ^segments: [String]{}
    loop segment in path.split("/") {
        if !segment.starts_with(":") -> next
        name: segment.removeprefix(":")
        problem: if {
            !found.fields.contains(name) -> "the path's `:{name}` names no field of `{found.name}`"
            found.query.contains(name) -> "`{name}` is an `#App.Query` field of `{found.name}`, which goes after `?`, not in the path"
            segments.contains(name) -> "the path names `:{name}` twice"
            else -> ""
        }
        if problem != "" {
            check.diagnostics.push(sema_app_screen_error(path, problem, positional[0].span))
            return rejected
        }
        segments.push(name)
    }
    loop index in 0..<found.fields.len() {
        field: found.fields[index]
        if !found.query.contains(field) && !segments.contains(field) {
            check.diagnostics.push(sema_app_screen_error(path, "the field `{field}` of `{found.name}` is neither a `:{field}` segment of the path nor marked `#App.Query`", positional[0].span))
            return rejected
        }
        loop codec in ([String]{"Encode", "Decode"}) {
            if sema_type_bound_satisfied(graph, found.types[index], codec, found.module_identity) == (Val(false)) {
                check.diagnostics.push(sema_app_screen_error(path, "the type of the field `{field}` of `{found.name}` doesn't derive `{codec}`", positional[1].span))
                return rejected
            }
        }
    }
    // What the view shows: its result, which can't fail and is a node tree
    // or derives `Encode`.
    declared: sema_type_resolve_declared(graph, handler.function.declaration.return_type ?? Type.Named{name: "Unit"}, view_module)
    shown: if {
        declared == .Result(ok, err) -> {
            if err != (Type.Named{name: "Never"}) {
                check.diagnostics.push(sema_app_screen_error(path, "`{handler.name}` can fail, and a view gives what its screen shows", positional[1].span))
                return rejected
            }
            ok
        }
        else -> declared
    }
    node: sema_app_is_node(graph, shown, view_module)
    if !node && sema_type_bound_satisfied(graph, shown, "Encode", view_module) == (Val(false)) {
        check.diagnostics.push(sema_app_screen_error(path, "`{handler.name}` gives {sema_type_show_quoted(shown)}, which doesn't derive `Encode`, and a screen shows its view's result", positional[1].span))
        return rejected
    }
    text: if node -> [Type]{} else -> [Type]{shown}
    opener: sema_app_screen_callback(sema_app_screen_opener(positional[1].expr, services.move(), states[0], text, found, graph, span), sema_app_mux_param_type(receiver_value, SEMA_APP_SCREEN, 4, span, check) ?? return rejected, span, check) ?? return rejected
    query: loop field in found.query -> sema_app_text(field, span)
    listed: sema_app_strings(query, span)
    queried: sema_check_expression(listed, Val(sema_app_mux_param_type(receiver_value, SEMA_APP_SCREEN, 2, span, check) ?? return rejected), check) ?? return rejected
    open: signed_in ?? Expr.Bool{value: false, span: span, id: AST_NODE_GENERATED}
    gated: sema_check_expression(open, Val(sema_app_mux_param_type(receiver_value, SEMA_APP_SCREEN, 3, span, check) ?? return rejected), check) ?? return rejected
    _: positional.pop()
    written: positional.pop() ?? {
        check.context.incomplete_reasons.push("`.screen` was checked to have a path")
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    viewed: states.pop() ?? {
        check.context.incomplete_reasons.push("`.screen` was checked to have one state")
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    registration: [TCallArg]{
        sema_call_http_static_tree_arg(sema_call_http_core_string(path, span), written),
        sema_call_http_static_tree_arg(sema_call_http_core_string(found.key, span), sema_http_mount_arg(sema_app_text(found.key, span), span)),
        sema_call_http_static_tree_arg(queried, sema_http_mount_arg(listed, span)),
        sema_call_http_static_tree_arg(gated, sema_http_mount_arg(open, span)),
        opener,
    }
    ^candidates: sema_expr_registration_method_candidates(graph, check.environment.module_identity, receiver_value.ty, SEMA_APP_SCREEN, [Type]{}, [Type]{}, span, check.environment.*, check.program.*, check.diagnostics)
    registered: candidates.pop() ?? {
        check.context.incomplete_reasons.push("App.{SEMA_APP_SCREEN} is not registered")
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    // `__screen` can't fail (`App Never!`): the call is the graph, as a
    // declared method's call of it is.
    declared_result: sema_call_signature_return(registered.signature) ?? {
        check.context.incomplete_reasons.push("App.{SEMA_APP_SCREEN} has no result")
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    result_type: sema_call_resolved_type(sema_owned_infallible(declared_result), check.environment.*, check.program.*)
    built: sema_tree_node(result_type, TExprKind.MethodCall{receiver: receiver_value, method: registered.method, type_args: [Type]{viewed}, args: registration}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(built, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// A screen's opener `opener`, checked as the escaping callback type
// `callback_type` that `App.__screen` takes, with no effect bound, as a
// mounted method's answer is (`sema_app_mount_callback`): a view may use
// whatever its package's authority allows, its reads and its Remotes' calls
// among them, and the framework runs it on a request worker.
sema_app_screen_callback: fn(opener: Expr, callback_type: Type, span: Span, check: ^SemaBodyCheck) -> TCallArg? {
    ^argument: sema_http_mount_arg(opener, span)
    unbounded: if {
        callback_type == .Fn(params, ret, _, contract, metadata, provenance) -> Type.Fn{params: params, ret: ret, effect_bound: None, param_contract: contract, call_metadata: metadata, return_view_provenance: provenance}
        else -> callback_type
    }
    callback: sema_check_expression_with_lambda_escapes(argument.expr, Val(unbounded), check, Val(true)) ?? return None
    argument.convention = AccessConvention.Move
    Val(sema_call_http_static_tree_arg(callback, argument))
}

SEMA_APP_CACHE: "__cache"

// The name a reply type `ty` (resolved) goes by, seen from
// `module_identity`, for `.cache<V>` and for each mounted `#App.Public`
// endpoint (`sema_app_mount_endpoint`), so an endpoint that replies a `V`
// answers under `V`'s policy: a nominal's identity, else its written form.
sema_app_reply_key: fn(graph: SemaRegistrationGraph, ty: Type, module_identity: ModuleID) -> String {
    row: sema_type_resolve_nominal_row(graph, ty, module_identity) ?? return type_name(ty)
    graph.modules[row.module_index].nominals[row.row].identity_key.copy()
}

// `graph.cache<V>(policy)` on an `app.App`: lowers the call to
// `graph.__cache<V>(key, policy)`, `key` naming `V` (`sema_app_reply_key`).
sema_call_app_cache: fn(receiver: Expr, receiver_value: TExpr, type_args: [Type], args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    graph: check.program.registration_graph
    if type_args.len() != 1 {
        check.diagnostics.push(sema_error("E0119", span, "`.cache` expects exactly one type argument, got {type_args.len()}", "`.cache<V>(policy)` sets how the replies of the type `V` may be kept", "write the reply type: `.cache<V>(.Public(max_age: 10min))`"))
        return rejected
    }
    if args.len() != 1 {
        check.diagnostics.push(sema_call_arity_diagnostic("cache", 1, args.len(), false, span))
        return rejected
    }
    reply: sema_type_resolve_declared(graph, type_args[0], check.environment.module_identity)
    registration: [CallArg]{
        sema_app_arg(sema_app_text(sema_app_reply_key(graph, reply, check.environment.module_identity), span), AccessConvention.Read, span),
        args[0].copy(),  // copy: the caller's argument list keeps the written policy
    }
    value: sema_expr_check_declared_method(receiver, receiver_value, SEMA_APP_CACHE, SEMA_APP_CACHE, span, [Type]{}, [Type]{reply}, registration, expected, check)
    SemaMethodSpecialCheck{handled: true, value: value}
}

SEMA_APP_SITEMAP: "__sitemap"

SEMA_APP_ADDRESS_TEXT: "__address_text"

// `graph.sitemap(list)` on an `app.App`: `list` is a named function that
// takes nothing and gives a list of screen states `[V]`, the pages the
// sitemap lists. Lowers the call to `graph.__sitemap<V>(key, fields, list,
// fn(graph, state) { [graph.__address_text(state.field), …] })`, the
// state's fields' address text in field order, so the sitemap takes each
// listed state's address as `url_of` does. The sitemap lists only states
// whose screen opens for a caller who is not signed in (app.sitemap).
sema_call_app_sitemap: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    graph: check.program.registration_graph
    if args.len() != 1 {
        check.diagnostics.push(sema_call_arity_diagnostic("sitemap", 1, args.len(), false, span))
        return rejected
    }
    if args[0].spread || args[0].label != None {
        check.diagnostics.push(sema_error("E0104", args[0].span, "`.sitemap` takes one unlabeled argument", "`.sitemap(list)` takes the function that gives the states of the pages the sitemap lists", "pass the function's name alone"))
        return rejected
    }
    handler: sema_app_named_handler("sitemap", args[0], check) ?? return rejected
    shape: "`{handler.name}` must take nothing and give a list of the states of public screens, as `fn() -> [LandingView]`"
    if handler.function.declaration.params.len() != 0 {
        check.diagnostics.push(sema_error("E2810", args[0].span, "App `sitemap` requires a function that takes nothing, and `{handler.name}` takes {handler.function.declaration.params.len()} parameters", "the sitemap asks the function for its pages each time a crawler reads it", shape))
        return rejected
    }
    declared: handler.function.declaration.return_type ?? Type.Named{name: "Unit"}
    resolved: sema_type_resolve_declared(graph, declared, handler.function.symbol.module_identity)
    // A function that can't fail (`Never!`) gives its success type.
    returned: if {
        resolved == .Result(ok, err) -> {
            if err != (Type.Named{name: "Never"}) {
                check.diagnostics.push(sema_error("E2810", args[0].span, "App `sitemap` requires a function that can't fail, and `{handler.name}` can fail", "a crawler reads the sitemap whenever it likes, and no caller is there to handle a failure", shape))
                return rejected
            }
            ok
        }
        else -> resolved
    }
    listed: sema_app_list_element(returned) ?? {
        check.diagnostics.push(sema_error("E2810", args[0].span, "App `sitemap` requires a function that gives a list of screen states, and `{handler.name}` gives `{type_name(returned)}`", "the sitemap lists the address of each state the function gives", shape))
        return rejected
    }
    found: sema_app_state(graph, listed, handler.function.symbol.module_identity) ?? {
        check.diagnostics.push(sema_error("E2810", args[0].span, "App `sitemap` requires a list of screen states, and `{type_name(listed)}` is no struct declared outside Core, or has type parameters", "a screen's state is the address the sitemap lists", shape))
        return rejected
    }
    graph_name: "__jet_sitemap_graph_{span.start}"
    state_name: "__jet_sitemap_state_{span.start}"
    ^names: [Expr]{}
    texts: loop field in found.fields -> {
        names.push(sema_app_text(field, span))
        read: Expr.Field{base: Expr.Ident{name: state_name, span: span, id: AST_NODE_GENERATED}, member: field, span: span, id: AST_NODE_GENERATED}
        Expr.MethodCall{receiver: Expr.Ident{name: graph_name, span: span, id: AST_NODE_GENERATED}, method: SEMA_APP_ADDRESS_TEXT, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{sema_app_arg(read, AccessConvention.Read, span)}, id: AST_NODE_GENERATED}
    }
    params: [LambdaParam]{
        LambdaParam{name: graph_name, name_span: span, ty: None, ty_span: None, convention: AccessConvention.Read},
        LambdaParam{name: state_name, name_span: span, ty: Val(listed.copy()), ty_span: None, convention: AccessConvention.Read},
    }
    address: Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: params, effects: None, body: LambdaBody.Expr{value: Expr.ListLit{elements: texts, span: span, id: AST_NODE_GENERATED}}, span: span, meta: ast_empty_lambda_meta()}, id: AST_NODE_GENERATED}
    registration: [CallArg]{
        sema_app_arg(sema_app_text(found.key, span), AccessConvention.Read, span),
        sema_app_arg(Expr.ListLit{elements: names, span: span, id: AST_NODE_GENERATED}, AccessConvention.Read, span),
        args[0].copy(),  // copy: the caller's argument list keeps the written function
        sema_app_arg(address, AccessConvention.Read, span),
    }
    value: sema_expr_check_declared_method(receiver, receiver_value, SEMA_APP_SITEMAP, SEMA_APP_SITEMAP, span, [Type]{}, [Type]{listed}, registration, expected, check)
    SemaMethodSpecialCheck{handled: true, value: value}
}

SEMA_APP_HEAD: "__head"

// `graph.head(head)` on an `app.App`: `head` is a named function that takes
// one screen state `V` and gives the `app.Head` of its page. Lowers the call
// to `graph.__head<V>(key, fn(graph, fields) { made }, head)`, `key` naming
// `V` as `.screen`'s does and `made` the `V` at an address
// (`sema_app_state_made`), as `current<V>()` makes it; the registration's
// parameter checks that `head` gives an `app.Head`. A page asks the
// function for the state at its address, so `V` derives `Decode`.
sema_call_app_head: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    graph: check.program.registration_graph
    if args.len() != 1 {
        check.diagnostics.push(sema_call_arity_diagnostic("head", 1, args.len(), false, span))
        return rejected
    }
    if args[0].spread || args[0].label != None {
        check.diagnostics.push(sema_error("E0104", args[0].span, "`.head` takes one unlabeled argument", "`.head(head)` takes the function that gives a screen's page metadata", "pass the function's name alone"))
        return rejected
    }
    handler: sema_app_named_handler("head", args[0], check) ?? return rejected
    shape: "`{handler.name}` must take a screen's state and give its page's metadata, as `fn(view: LandingView) -> app.Head`"
    if handler.function.declaration.params.len() != 1 {
        check.diagnostics.push(sema_error("E2810", args[0].span, "App `head` requires a function that takes one screen state, and `{handler.name}` takes {handler.function.declaration.params.len()} parameters", "a page asks the function for the metadata of the state it shows", shape))
        return rejected
    }
    module_identity: handler.function.symbol.module_identity
    viewed: sema_type_resolve_declared(graph, handler.function.declaration.params[0].ty, module_identity)
    found: sema_app_state(graph, viewed, module_identity) ?? {
        check.diagnostics.push(sema_error("E2810", args[0].span, "App `head` requires a function that takes a screen state, and `{type_name(viewed)}` is no struct declared outside Core, or has type parameters", "a screen's state is what its page shows", shape))
        return rejected
    }
    if sema_type_bound_satisfied(graph, viewed, "Decode", module_identity) == (Val(false)) {
        check.diagnostics.push(sema_error("E2810", args[0].span, "App `head` requires a screen state that derives `Decode`, and `{found.name}` doesn't", "a page makes the state it shows back from its address to ask its head", "derive `Decode` on `{found.name}`"))
        return rejected
    }
    graph_name: "__jet_app_graph_{span.start}"
    fields_name: "__jet_app_fields_{span.start}"
    made: sema_app_state_made(sema_app_ident(graph_name, span), found, viewed, fields_name, graph, span)  // copy: the registration's type argument keeps the state
    decode: sema_app_lambda([LambdaParam]{sema_app_lambda_param(graph_name, None, span), sema_app_lambda_param(fields_name, None, span)}, made, span)
    registration: [CallArg]{
        sema_app_arg(sema_app_text(found.key, span), AccessConvention.Read, span),
        sema_app_arg(decode, AccessConvention.Read, span),
        args[0].copy(),  // copy: the caller's argument list keeps the written function
    }
    value: sema_expr_check_declared_method(receiver, receiver_value, SEMA_APP_HEAD, SEMA_APP_HEAD, span, [Type]{}, [Type]{viewed}, registration, expected, check)
    SemaMethodSpecialCheck{handled: true, value: value}
}

// The element type of the list type `ty`; None when `ty` is no list.
sema_app_list_element: fn(ty: Type) -> Type? Never! {
    if ty == .List(element) -> return Val(element)
    None
}

// The service `S` of the Remote type `ty` (`app.Remote<S>`), seen from
// `module_identity`, with its key, the identity of its nominal; None when
// `S` is no nominal type.
sema_app_remote_service: fn(graph: SemaRegistrationGraph, ty: Type, module_identity: ModuleID) -> {ty: Type, key: String}? {
    if ty == .Apply(_, args) && args.len() == 1 {
        row: sema_type_resolve_nominal_row(graph, args[0], module_identity) ?? return None
        return Val({ty: args[0].copy(), key: graph.modules[row.module_index].nominals[row.row].identity_key.copy()})
    }
    None
}

// A screen's opener, as `App.__screen` takes it:
// `fn(graph, fields) { state: made ?? return None; Val(shown) }`, where
// `made` is the state `V` made from the address's field texts `fields`
// (`sema_app_state_made`), and `shown` the node tree of what the view
// gives: `view(…)` itself when it gives a tree (`text` empty), else
// `graph.__view_node<N>(view(…))`, `N` what it gives (`text`'s one type).
// `view` is the written view, called with its parameters in order, each
// Remote one the graph's Remote of its service (`services`,
// `App.__remote<S>`) and the state one the state. The view runs in the
// opener's own body, so it has the opener's unbounded effects
// (`sema_app_screen_callback`): no inner callback bounds its Remotes' calls.
sema_app_screen_opener: fn(view: Expr, services: ^^[{ty: Type, key: String}?], state_ty: Type, text: [Type], found: SemaAppState, graph: SemaRegistrationGraph, span: Span) -> Expr Never! {
    graph_name: "__jet_app_graph_{span.start}"
    fields_name: "__jet_app_fields_{span.start}"
    state_name: "__jet_app_state_{span.start}"
    view_args: loop service in services.move() -> {
        argument: if service != None -> sema_app_member_call(sema_app_ident(graph_name, span), "__remote", [Type]{service.ty}, [CallArg]{sema_app_arg(sema_app_text(service.key, span), AccessConvention.Read, span)}, span) else -> sema_app_ident(state_name, span)
        sema_app_arg(argument, AccessConvention.Read, span)
    }
    called: if {
        view == .Ident(name, name_span, _) -> Expr.Call{call: Call{name: name, name_span: name_span, type_args: [Type]{}, args: view_args}, id: AST_NODE_GENERATED}
        view == .Field(base, member, _, _) -> sema_app_member_call(base, member, [Type]{}, view_args, span)
        else -> Expr.CallValue{callee: view.copy(), args: view_args, span: span, id: AST_NODE_GENERATED}  // copy: the written argument keeps its expression
    }
    shown: if text.len() == 0 -> called else -> sema_app_member_call(sema_app_ident(graph_name, span), "__view_node", text, [CallArg]{sema_app_arg(called, AccessConvention.Read, span)}, span)
    made: sema_app_state_made(sema_app_ident(graph_name, span), found, state_ty, fields_name, graph, span)
    none: Expr.Absent{span: span, id: AST_NODE_GENERATED}
    state: Expr.OrFallback{value: made, fallback: OrFallback.Return{value: Val(none), span: span}, is_option: true, span: span, id: AST_NODE_GENERATED}
    body: [Stmt]{
        Stmt.Val{binding: ast_binding(state_name, span, false, state, None)},
        Stmt.Expr{expr: Expr.Present{value: shown, span: span, id: AST_NODE_GENERATED}},
    }
    params: [LambdaParam]{sema_app_lambda_param(graph_name, None, span), sema_app_lambda_param(fields_name, None, span)}
    Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: params, effects: None, body: LambdaBody.Block{body: body}, span: span, meta: ast_empty_lambda_meta()}, id: AST_NODE_GENERATED}
}

// The state `state_ty` made from the address field texts `fields_name` by
// the graph `graph_expr`: `graph.__address_state<V>(names,
// [graph.__address_json<T>(fields, name), …])`, each field read as its own
// type `T`.
sema_app_state_made: fn(graph_expr: Expr, found: SemaAppState, state_ty: Type, fields_name: String, graph: SemaRegistrationGraph, span: Span) -> Expr Never! {
    ^names: [Expr]{}
    ^values: [Expr]{}
    loop index in 0..<found.fields.len() {
        names.push(sema_app_text(found.fields[index], span))
        field_ty: sema_type_resolve_declared(graph, found.types[index], found.module_identity)
        read: [CallArg]{sema_app_arg(sema_app_ident(fields_name, span), AccessConvention.Read, span), sema_app_arg(sema_app_text(found.fields[index], span), AccessConvention.Read, span)}
        values.push(sema_app_member_call(graph_expr, "__address_json", [Type]{field_ty}, read, span))  // copy: each field reads the one graph
    }
    listed: Expr.TypedLit{head: Val(Type.List{element: Type.Option{inner: Type.String}}), body: TypedLitBody.Elements{elements: values}, span: span, id: AST_NODE_GENERATED}
    sema_app_member_call(graph_expr, "__address_state", [Type]{state_ty}, [CallArg]{sema_app_arg(sema_app_strings(names, span), AccessConvention.Read, span), sema_app_arg(listed, AccessConvention.Read, span)}, span)
}

// `[String]{…}` of `elements`.
sema_app_strings: fn(elements: [Expr], span: Span) -> Expr Never! {
    Expr.TypedLit{head: Val(Type.List{element: Type.String}), body: TypedLitBody.Elements{elements: elements}, span: span, id: AST_NODE_GENERATED}
}

// `receiver.member<type_args>(args)`.
sema_app_member_call: fn(receiver: Expr, member: String, type_args: [Type], args: [CallArg], span: Span) -> Expr Never! {
    Expr.MethodCall{receiver: receiver, method: member, method_span: span, owner_type_args: [Type]{}, type_args: type_args, args: args, id: AST_NODE_GENERATED}
}

sema_app_lambda_param: fn(name: String, ty: Type?, span: Span) -> LambdaParam Never! {
    LambdaParam{name: name, name_span: span, ty: ty, ty_span: None, convention: AccessConvention.Read}
}

// `fn(params) { value }`.
sema_app_lambda: fn(params: [LambdaParam], value: Expr, span: Span) -> Expr Never! {
    Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: params, effects: None, body: LambdaBody.Expr{value: value}, span: span, meta: ast_empty_lambda_meta()}, id: AST_NODE_GENERATED}
}

// `graph.api<S>(path, max_upload:)` on an `app.App`: lowers to
// `graph.__api<S>(path, key, max_upload)`, where `key` names `S`, the key
// `App.__remote<S>` finds the service by.
sema_call_app_api: fn(receiver: Expr, receiver_value: TExpr, type_args: [Type], args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    rejected: SemaMethodSpecialCheck{handled: true, value: None}
    graph: check.program.registration_graph
    shape: "`.api<S>(path, max_upload:)` declares the service `S` its clients reach at `path`"
    ^positional: [CallArg]{}
    ^max_upload: Expr?{None}
    loop argument in args {
        if argument.spread {
            check.diagnostics.push(sema_error("E0104", argument.span, "`.api` can't spread its arguments", shape, "pass each argument"))
            return rejected
        }
        if argument.label == .Val(label) {
            if label.name == "max_upload" && max_upload == None {
                max_upload = Val(argument.expr.copy())  // copy: the caller's argument list keeps its expression
                next
            }
            check.diagnostics.push(sema_error("E0104", label.span, "`.api` has no parameter `{label.name}`", shape, "remove the `{label.name}:` argument"))
            return rejected
        }
        positional.push(argument.copy())  // copy: the caller's argument list keeps its arguments
    }
    if positional.len() != 1 {
        check.diagnostics.push(sema_call_arity_diagnostic("api", 1, positional.len(), false, span))
        return rejected
    }
    if type_args.len() != 1 {
        check.diagnostics.push(sema_error("E0104", span, "`.api` names no service", shape, "name the service: `.api<S>(path)`"))
        return rejected
    }
    service: sema_call_resolved_type(type_args[0], check.environment.*, check.program.*)
    row: sema_type_resolve_nominal_row(graph, service, check.environment.module_identity) ?? {
        check.diagnostics.push(sema_error("E0104", span, "`.api<{type_name(service)}>` names no service struct", shape, "name a struct whose methods `#App.Public` or `#App.SignedIn` marks"))
        return rejected
    }
    key: graph.modules[row.module_index].nominals[row.row].identity_key
    limit: max_upload ?? Expr.Int{value: SEMA_APP_MAX_UPLOAD, span: span, width: None, raw: None, id: AST_NODE_GENERATED}
    path: positional.pop() ?? {
        check.context.incomplete_reasons.push("`.api` was checked to have a path")
        return rejected
    }
    registration: [CallArg]{
        path,
        sema_app_arg(sema_app_text(key, span), AccessConvention.Read, span),
        sema_app_arg(limit, AccessConvention.Read, span),
    }
    value: sema_expr_check_declared_method(receiver, receiver_value, SEMA_APP_API, SEMA_APP_API, span, [Type]{}, [Type]{service}, registration, expected, check)
    SemaMethodSpecialCheck{handled: true, value: value}
}

// A method of the app graph the compiler lowers: `.screen`, `.api`,
// `.mount` of a service, `.cache<V>`, `.sitemap` and `.head`.
sema_call_app_graph_method: fn(receiver: Expr, receiver_value: TExpr, method: String, type_args: [Type], args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if method == {
        "screen" -> sema_call_app_screen(receiver_value, args, span, expected, check)
        "api" -> sema_call_app_api(receiver, receiver_value, type_args, args, span, expected, check)
        "mount" -> sema_call_http_mount(receiver, receiver_value, args, span, expected, check)
        "cache" -> sema_call_app_cache(receiver, receiver_value, type_args, args, span, expected, check)
        "sitemap" -> sema_call_app_sitemap(receiver, receiver_value, args, span, expected, check)
        "head" -> sema_call_app_head(receiver, receiver_value, args, span, expected, check)
        else -> SemaMethodSpecialCheck{handled: false, value: None}
    }
}

// `alias.url_of(view)`, `alias.presence(view)`, `alias.go(view)`,
// `alias.notify(to:, title:, body:, open: view)` and, without `to:`,
// `alias.notify(title:, body:, open: view)`, where `alias` names `app`.
// Each argument but a bare name is evaluated once, in the order written,
// into a hidden local; the state's address is `alias.App.__url_of<V>(key, fields, texts)`,
// which `url_of` gives, `presence` passes to `alias.App.__presence(address)`
// and `notify` to `alias.App.__notify(to, title, body, address)`, or to
// `alias.App.__notify_here(title, body, address)` without `to:`, and `go`
// opens it: `alias.App.__go<V>(key, fields, texts)`.
sema_call_app_address: fn(member: String, alias: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    rejected: SemaDirectSpecialCheck{handled: true, value: None}
    graph: check.program.registration_graph
    if type_args.len() != 0 {
        check.diagnostics.push(sema_call_not_generic_diagnostic(member, span))
        return rejected
    }
    // `notify` written without `to:` notifies this device.
    here: member == "notify" && sema_app_notify_here(args)
    // The parameters in order, the state last.
    params: if here -> [String]{"title", "body", "open"} else if member == "notify" -> [String]{"to", "title", "body", "open"} else -> [String]{"view"}
    shape: sema_app_address_shape(member, here)
    if args.len() != params.len() {
        check.diagnostics.push(sema_call_arity_diagnostic(member, params.len(), args.len(), false, span))
        return rejected
    }
    // The parameter each argument passes: its label's, else the first one
    // not passed yet.
    ^slots: [Int]{}
    loop argument in args {
        if argument.spread {
            check.diagnostics.push(sema_error("E0104", argument.span, "`{alias}.{member}` can't spread its arguments", shape, "pass each argument"))
            return rejected
        }
        slot: if argument.label == .Val(label) -> params.index_of(label.name) ?? -1 else -> sema_app_first_unpassed(params.len(), slots)
        if slot < 0 || slots.contains(slot) {
            check.diagnostics.push(sema_error("E0104", argument.span, "this argument of `{alias}.{member}` names no parameter left to pass", shape, "pass each parameter once"))
            return rejected
        }
        slots.push(slot)
    }
    state_slot: params.len() - 1
    sema_scope_enter(check.scopes, check.state, "address:{span.start}")
    ^body: [TStmt]{}
    ^locals: [Expr?]{}
    loop _ in params -> locals.push(None)
    ^view: Type?{None}
    ^view_span: span
    loop index in 0..<args.len() {
        slot: slots[index]
        value: args[index].expr.copy()  // copy: the caller's argument list keeps its expression
        // A bare name is read where the address is made, with no local of
        // its own: a local would take a read parameter this function doesn't
        // own (E0120), and a name reads the same value each time.
        if value == .Ident(name, name_span, _) {
            if slot == state_slot {
                read: sema_check_expression(Expr.Ident{name: "{name}", span: name_span, id: AST_NODE_GENERATED}, None, check) ?? {
                    sema_single_use_leave_scope(check)
                    return rejected
                }
                view = Val(read.ty.move())
                view_span = name_span
            }
            locals[slot] = Val(value)
            next
        }
        local: "__jet_app_{span.start}_{params[slot]}"
        binding: ast_binding(local, args[index].span, false, value, None)
        statement: sema_stmt_check_binding(binding, None, check) ?? {
            sema_single_use_leave_scope(check)
            return rejected
        }
        if slot == state_slot {
            if statement == .Let(_, _, init, _, _, _) -> view = Val(init.ty.copy())  // copy: the statement keeps its value's type
            view_span = expr_span(args[index].expr)
        }
        body.push(statement)
        locals[slot] = Val(Expr.Ident{name: local, span: args[index].span, id: AST_NODE_GENERATED})
    }
    ty: view ?? {
        sema_single_use_leave_scope(check)
        return rejected
    }
    found: sema_app_state(graph, ty, check.environment.module_identity) ?? {
        check.diagnostics.push(sema_app_no_screen(type_name(ty), view_span))
        sema_single_use_leave_scope(check)
        return rejected
    }
    opened: locals[state_slot] ?? panic("the state's argument was bound above")
    ^names: [Expr]{}
    texts: loop field in found.fields.move() -> {
        names.push(sema_app_text(field, view_span))
        read: Expr.Field{base: opened.copy(), member: field, span: view_span, id: AST_NODE_GENERATED}  // copy: each field reads the one bound state
        sema_app_graph_call(alias, SEMA_APP_ADDRESS_ARG, [Type]{}, [CallArg]{sema_live_arg(read, view_span)}, view_span)
    }
    taken: if member == "go" -> SEMA_APP_GO else -> SEMA_APP_URL_OF
    address: sema_app_graph_call(alias, taken, [Type]{ty}, [CallArg]{sema_live_arg(sema_app_text(found.key, view_span), view_span), sema_live_arg(sema_app_strings(names, view_span), view_span), sema_live_arg(sema_app_strings(texts, view_span), view_span)}, view_span)
    lowered: if member == {
        "notify" -> sema_app_notify_call(alias, locals, address, here, span)
        "presence" -> sema_app_graph_call(alias, SEMA_APP_PRESENCE, [Type]{}, [CallArg]{sema_live_arg(address, span)}, span)
        else -> address
    }
    checked: sema_check_expression(lowered, None, check) ?? {
        sema_single_use_leave_scope(check)
        return rejected
    }
    result_type: checked.ty.copy()  // copy: the block's value keeps its own type
    body.push(TStmt.ExprStmt{value: checked, span: span})
    sema_single_use_leave_scope(check)
    lowered_value: sema_tree_node(result_type, TExprKind.InlineBlock{body: body}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(lowered_value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// What the address call `member` does, for its argument diagnostics; `here`
// for a `notify` without `to:`.
sema_app_address_shape: fn(member: String, here: Bool) -> String Never! {
    if here {
        return "`notify(title:, body:, open:)` shows a notification on this device that opens the state `open`"
    }
    if member == {
        "notify" -> "`notify(to:, title:, body:, open:)` pushes to each device of `to` a notice that opens the state `open`"
        "presence" -> "`presence(view)` gives the accounts that have the state `view` open and whose last read of its data passed its policies"
        "go" -> "`go(view)` opens the screen whose state is `view`"
        else -> "`url_of(view)` gives the address of the screen whose state is `view`"
    }
}

// Whether `notify` with `args` notifies this device: three arguments, none
// of them labeled `to`.
sema_app_notify_here: fn(args: [CallArg]) -> Bool Never! {
    if args.len() != 3 -> return false
    loop argument in args {
        if argument.label == .Val(label) {
            if label.name == "to" -> return false
        }
    }
    true
}

// `alias.current<V>()`, where `alias` names `app`: the state of the screen
// open now when it is a `V`, `alias.App.__current<V>(key, fn(graph, fields)
// { made })`, where `made` is the state made from the address's field texts
// (`sema_app_state_made`).
sema_call_app_current: fn(alias: String, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    rejected: SemaDirectSpecialCheck{handled: true, value: None}
    graph: check.program.registration_graph
    if args.len() != 0 {
        check.diagnostics.push(sema_call_arity_diagnostic("current", 0, args.len(), false, span))
        return rejected
    }
    if type_args.len() != 1 {
        check.diagnostics.push(sema_error("E0104", span, "`{alias}.current` names no state", "`current<V>()` gives the state of the screen open now when it is a `V`", "name the state: `{alias}.current<V>()`"))
        return rejected
    }
    ty: sema_call_resolved_type(type_args[0], check.environment.*, check.program.*)
    found: sema_app_state(graph, ty, check.environment.module_identity) ?? {
        check.diagnostics.push(sema_app_no_screen(type_name(ty), span))
        return rejected
    }
    graph_name: "__jet_app_graph_{span.start}"
    fields_name: "__jet_app_fields_{span.start}"
    made: sema_app_state_made(sema_app_ident(graph_name, span), found, ty, fields_name, graph, span)
    decode: sema_app_lambda([LambdaParam]{sema_app_lambda_param(graph_name, None, span), sema_app_lambda_param(fields_name, None, span)}, made, span)
    lowered: sema_app_graph_call(alias, SEMA_APP_CURRENT, [Type]{ty}, [CallArg]{sema_live_arg(sema_app_text(found.key, span), span), sema_live_arg(decode, span)}, span)
    SemaDirectSpecialCheck{handled: true, value: sema_check_expression(lowered, expected, check)}
}

// The first of `count` parameters no slot of `slots` passes, or -1.
sema_app_first_unpassed: fn(count: Int, slots: [Int]) -> Int Never! {
    loop slot in 0..<count {
        if !slots.contains(slot) -> return slot
    }
    -1
}

// `alias.App.__notify(to, title, body, address)`, or with `here`
// `alias.App.__notify_here(title, body, address)`: `locals` are the locals
// `notify`'s arguments were bound to, in parameter order, the state last.
sema_app_notify_call: fn(alias: String, locals: [Expr?], address: Expr, here: Bool, span: Span) -> Expr Never! {
    ^sent: [CallArg]{}
    loop index in 0..<locals.len() - 1 {
        bound: locals[index] ?? panic("each argument was bound above")
        sent.push(sema_live_arg(bound, span))
    }
    sent.push(sema_live_arg(address, span))
    sema_app_graph_call(alias, if here -> SEMA_APP_NOTIFY_HERE else -> SEMA_APP_NOTIFY, [Type]{}, sent, span)
}

// `alias.App.member<type_args>(args)`: a member of the app graph's type,
// written as the parser writes `app.App.member(…)`.
sema_app_graph_call: fn(alias: String, member: String, type_args: [Type], args: [CallArg], span: Span) -> Expr Never! {
    owner: Expr.Field{base: Expr.Ident{name: alias, span: span, id: AST_NODE_GENERATED}, member: SEMA_APP_GRAPH, span: span, id: AST_NODE_GENERATED}
    Expr.MethodCall{receiver: owner, method: member, method_span: span, owner_type_args: [Type]{}, type_args: type_args, args: args, id: AST_NODE_GENERATED}
}

// One `__screen`, `__url_of`, `__go` or `__current` call of a checked body:
// the state's key and name, where the call is, and its module.
SemaAppRouteSite: struct {
    key: String,
    name: String,
    span: Span,
    module_index: Int,
}

// One part of the route scan: the screens its bodies register and the
// states they take addresses of, in body order.
SemaAppRouteScan: struct {
    screens: [SemaAppRouteSite],
    addresses: [SemaAppRouteSite],
}

// The route scan's threads (compiler_threads_admit): a thread is admitted
// for at least this many body nodes.
SEMA_APP_ROUTE_NODES_PER_THREAD: 20000

// E2821 for each address taken of a state that no screen of the program
// opens, and E2820 for a state two screens register, in body order. A
// program that registers no screen builds no graph here, so its addresses
// are checked where a graph is built. The scan reads each function on its
// own, so it runs on as many of `threads` as the bodies admit, its parts
// joined in function order: the reports are the same for any thread count.
sema_app_route_diagnostics: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], threads: CompilerThreads) -> [Diagnostic] {
    app_index: loop index in 0..<graph.modules.len() {
        if module_is_core(graph.modules[index].module_identity) && graph.modules[index].module_name == SEMA_APP_MARKER_MODULE {
            break index
        }
    } ?? return [Diagnostic]{}
    // The members that take a state's address: `__url_of`, `__go` and
    // `__current`.
    ^takes: [U32]{}
    loop member in ([String]{SEMA_APP_URL_OF, SEMA_APP_GO, SEMA_APP_CURRENT}) {
        takes.push(sema_app_graph_member(graph.modules[app_index], member) ?? return [Diagnostic]{})
    }
    screen: sema_app_graph_member(graph.modules[app_index], SEMA_APP_SCREEN) ?? return [Diagnostic]{}
    ^places: [SemaAppCallerPlace]{}
    ^weights: [Int]{}
    ^work: 0
    loop module_index in 0..<modules.len() {
        if module_is_core(modules[module_index].module_identity) -> next
        loop function_index in 0..<modules[module_index].functions.len() {
            places.push(SemaAppCallerPlace{module_index: module_index, function_index: function_index})
            weight: 1 + modules[module_index].functions[function_index].tree.nodes.len()
            weights.push(weight)
            work += weight
        }
    }
    workers: compiler_threads_admit(threads, places.len(), work, SEMA_APP_ROUTE_NODES_PER_THREAD, 0, 0)
    bounds: if workers <= 1 -> [Int]{0, places.len()} else -> compiler_threads_partition(weights, workers)
    scans: sema_app_route_scans(graph, modules, places, bounds, 0, takes, screen)
    // The states the screens open, by key; a key interned before is a state
    // a second screen opens. Id 0 is the empty name, so one name is none.
    ^opened: name_table()
    ^reports: [SemaAppCallerReport]{}
    loop scan in scans {
        loop site in scan.screens {
            known: name_count(opened)
            ^_: name_intern(opened, site.key)
            if name_count(opened) == known {
                reports.push(SemaAppCallerReport{module_index: site.module_index, diagnostic: sema_app_screen_error("…", "`{site.name}` is the state of another screen of the graph too, and a state has one address", site.span)})
            }
        }
    }
    if name_count(opened) == 1 -> return [Diagnostic]{}
    loop scan in scans {
        loop site in scan.addresses {
            if name_find(opened, site.key) == None {
                reports.push(SemaAppCallerReport{module_index: site.module_index, diagnostic: sema_app_no_screen(site.name, site.span)})
            }
        }
    }
    ^diagnostics: [Diagnostic]{}
    loop report in reports.move() {
        start: diagnostics.len()
        diagnostics.push(report.diagnostic)
        registration: sema_registration_module_index(graph, modules[report.module_index].module_identity) ?? next
        sema_attach_diagnostic_source_locations(diagnostics, start, graph.modules[registration].source_segments)
    }
    diagnostics
}

// The scans of the parts from bounds `at` on, each but the last on a task of
// its own, in part order.
sema_app_route_scans: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], places: [SemaAppCallerPlace], bounds: [Int], at: Int, takes: [U32], screen: U32) -> [SemaAppRouteScan] Never! {
    ^done: [SemaAppRouteScan]{}
    if at + 1 >= bounds.len() -> return done
    from: bounds[at]
    to: bounds[at + 1]
    if at + 2 == bounds.len() {
        done.push(sema_app_route_scan(graph, modules, places, from, to, takes, screen))
        return done
    }
    task.group sema_app_route_scan_threads {
        head: task sema_app_route_scan(graph, modules, places, from, to, takes, screen)
        rest: sema_app_route_scans(graph, modules, places, bounds, at + 1, takes, screen)
        done.push(compiler_threads_joined(head))
        loop part in rest.move() -> done.push(part)
    }
    done
}

// The `__screen` calls of functions `from..<to` of `places`, and their calls
// of `takes`, the members that take a state's address.
sema_app_route_scan: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult], places: [SemaAppCallerPlace], from: Int, to: Int, takes: [U32], screen: U32) -> SemaAppRouteScan Never! {
    ^scan: SemaAppRouteScan{screens: [SemaAppRouteSite]{}, addresses: [SemaAppRouteSite]{}}
    loop index in from..<to {
        place: places[index]
        function: modules[place.module_index].functions[place.function_index]
        loop node in function.tree.nodes {
            callee: sema_app_caller_callee(graph, function, node.kind) ?? next
            if callee != screen && !takes.contains(callee) -> next
            ty: sema_app_route_state_type(node.kind) ?? next
            found: sema_app_state(graph, ty, modules[place.module_index].module_identity) ?? next
            site: SemaAppRouteSite{key: found.key, name: found.name, span: node.span, module_index: place.module_index}
            if callee == screen -> scan.screens.push(site) else -> scan.addresses.push(site)
        }
    }
    scan
}

// The state type a `__screen<V>` call or a call that takes its address
// names: its one type argument.
sema_app_route_state_type: fn(kind: NodeKind) -> Type? Never! {
    if kind == .Call(_, type_args, _) -> return sema_app_route_one_type(type_args)
    if kind == .MethodCall(_, _, type_args, _) -> return sema_app_route_one_type(type_args)
    if kind == .StaticCall(_, _, _, type_args, _) -> return sema_app_route_one_type(type_args)
    None
}

sema_app_route_one_type: fn(type_args: [Type]) -> Type? Never! {
    if type_args.len() != 1 -> return None
    Val(type_args[0].copy())
}

// The run-wide symbol of the member `name` of `App` in the app module
// `module_row`.
sema_app_graph_member: fn(module_row: SemaRegistrationModule, name: String) -> U32? Never! {
    loop nominal in module_row.nominals {
        if nominal.symbol.name != SEMA_APP_GRAPH -> next
        loop method in nominal.methods {
            if method.declaration.name == name -> return Val(method.symbol.id.id)
        }
    }
    None
}

// ---- web.form elaboration -----------------------------------------------

sema_call_http_core_unwrap_result: fn(value: TExpr, payload: Type, message: String, span: Span, check: SemaBodyCheck) -> TExpr Never! {
    ^text: sema_call_http_core_string(message, span)
    sema_tree_node(payload, TExprKind.OrFallback{value: value, fallback: TOrFallback.Panic{message: text, location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)}, ambient_err: None}, span)
}

sema_call_http_form_text: fn(value: String, span: Span) -> Expr Never! {
    Expr.Str{parts: [StrPart]{StrPart.Lit{text: value}}, span: span, id: AST_NODE_GENERATED}
}

sema_call_http_form_enum: fn(type_name: String, variant: String, span: Span) -> Expr Never! {
    Expr.EnumLit{type_name: type_name, variant: variant, variant_span: Val(span), args: [EnumLitArg]{}, leading_dot: false, span: span, id: AST_NODE_GENERATED}
}

sema_call_http_core_form_descriptor: fn(field: Field, value_variant: String, control_variant: String) -> Expr Never! {
    field_span: field.name_span
    Expr.StructLit{
        type_name: "WebFormFieldSpec",
        type_args: [Type]{},
        import_ns: None,
        as_trait: None,
        fields: [ExprField]{
            {name: "name", name_span: field_span, value: sema_call_http_form_text(field.name, field_span)},
            {name: "value_type", name_span: field_span, value: sema_call_http_form_enum("WebFormValueType", value_variant, field_span)},
            {name: "required", name_span: field_span, value: Expr.Bool{value: true, span: field_span, id: AST_NODE_GENERATED}},
            {name: "default", name_span: field_span, value: Expr.Absent{span: field_span, id: AST_NODE_GENERATED}},
            {name: "label", name_span: field_span, value: sema_call_http_form_text(field.name, field_span)},
            {name: "control", name_span: field_span, value: sema_call_http_form_enum("WebFormControl", control_variant, field_span)},
            {name: "group", name_span: field_span, value: Expr.Absent{span: field_span, id: AST_NODE_GENERATED}},
            {name: "wire_name", name_span: field_span, value: sema_call_http_form_text(field.name, field_span)},
        },
        inferred: false,
        span: field_span,
        id: AST_NODE_GENERATED,
    }
}

// `web.form(Model, action: submit)` derives field descriptors from the
// `#Web.Form` model struct and lowers into `core.web.forms.input` and
// `core.web.forms.typed<Model>`. Core's `#Web.Form` marker hears the call
// first and rejects an action that does not take the model.
sema_call_try_web_form: fn(module_name: String, member: String, alias: String, alias_span: Span, args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck {
    if module_name != SEMA_WEB_MARKER_MODULE || member != "form" {
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    imported: sema_call_core_import_target(check.environment.*, check.program.*, alias) ?? return SemaDirectSpecialCheck{handled: false, value: None}
    if !sema_call_core_record_import_reference(check, imported, alias_span) {
        return SemaDirectSpecialCheck{handled: false, value: None}
    }
    ^rules: [SemaCallRule]{}
    ^action_index: 1
    if args.len() == 2 && args[0].label == .Val(label) && label.name == "action" -> action_index = 0
    model_index: 1 - action_index
    ^model: Type.Named{name: ""}
    graph: check.program.registration_graph
    if sema_call_rules_heard_here(check.scopes) && args.len() == 2 && args[model_index].expr == .Ident(name, _, _) {
        model = Type.Named{name: name}
        rules = sema_call_rules_of_type(graph, model, check.environment.module_row)
    }
    if rules.len() == 0 -> return sema_call_http_web_form(args, type_args, span, expected, check)
    hearing: sema_call_rules_hear(rules, None, member, span, [CallArg]{args[action_index]}, [Type]{}, None, Val(model), None, args[model_index].span, None, "", check.scopes.current, check)
    if hearing.rejected -> return SemaDirectSpecialCheck{handled: true, value: None}
    if !hearing.staged -> return sema_call_http_web_form(args, type_args, span, expected, check)
    ^held: [Diagnostic]{}
    sema_body_check_swap_diagnostics(check, held)
    checked: sema_call_http_web_form(args, type_args, span, expected, check)
    sema_body_check_swap_diagnostics(check, held)
    if sema_call_rules_hold(hearing, held, check) {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    checked
}

sema_call_http_web_form: fn(args: [CallArg], type_args: [Type], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaDirectSpecialCheck Never! {
    if !sema_call_core_check_type_args(SEMA_WEB_MARKER_MODULE, "form", 0, false, type_args, span, check.diagnostics) {
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if args.len() != 2 {
        check.diagnostics.push(sema_call_arity_diagnostic("form", 2, args.len(), false, span))
        loop argument in args -> ^_: sema_check_expression(argument.expr, None, check)
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^action_index: 1
    if args[0].label == .Val(label) && label.name == "action" -> action_index = 0
    if args[1].label == .Val(label) && label.name == "action" -> action_index = 1
    ^model_index: if action_index == 0 -> 1 else -> 0
    model_name: if args[model_index].expr == {
        .Ident(name, _, _) -> name
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
            check.diagnostics.push(sema_error("E2474", args[model_index].span, "web.form needs a named model type", "the form field set is derived from one declared struct, so a runtime value cannot provide its schema", "pass the struct name as the first argument: `web.form(Checkout, action: submit)`"))
            loop argument in args -> ^_: sema_check_expression(argument.expr, None, check)
            return SemaDirectSpecialCheck{handled: true, value: None}
        }
    }
    definition: sema_http_route_find_struct(check, Type.Named{name: model_name}, check.environment.module_identity) ?? {
        check.diagnostics.push(sema_error("E2474", args[model_index].span, "web.form model `{model_name}` is not a declared struct", "the form field set must come from the model's declared fields", "declare `{model_name}: struct {{ ... }}` before constructing the form"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if !sema_web_type_marked(Type.Named{name: model_name}, SEMA_WEB_MARKER_FORM, check.environment.*, check.program.*) {
        check.diagnostics.push(sema_error("E2474", args[model_index].span, "the web.form model `{model_name}` is not marked `#Web.Form`", "a form derives its fields only from a model struct the web module's `#Form` marks", "mark the model: `#Web.Form {model_name}: struct {{ ... }}`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    graph: check.program.registration_graph
    model_row: sema_type_resolve_nominal_row(graph, Type.Named{name: model_name}, check.environment.module_identity) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ^model_module_identity: graph.modules[model_row.module_index].module_identity
    action_name: if args[action_index].expr == {
        .Ident(name, _, _) -> name
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {
            check.diagnostics.push(sema_error("E2474", args[action_index].span, "web.form action must be a named function", "the action is registered through the existing typed server-function boundary", "pass a named action function: `web.form({model_name}, action: submit)`"))
            return SemaDirectSpecialCheck{handled: true, value: None}
        }
    }
    action_binding: sema_scope_resolve_index(check.scopes, action_name) ?? {
        check.diagnostics.push(sema_error("E2474", args[action_index].span, "form action `{action_name}` does not accept `{model_name}`", "the form derives its fields from the model and the one server-function action must receive that exact input type", "change `{action_name}` to accept `{model_name}` as its only parameter"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    ^action_symbol: check.scopes.bindings[action_binding].symbol
    if action_symbol.kind != SymbolKind.Function {
        check.diagnostics.push(sema_error("E2474", args[action_index].span, "web.form action must be a named function", "the action is registered through the existing typed server-function boundary", "pass a named action function: `web.form({model_name}, action: submit)`"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }
    if sema_http_route_find_function(check, action_name) == None {
        check.diagnostics.push(sema_error("E2474", args[action_index].span, "form action `{action_name}` does not accept `{model_name}`", "the form derives its fields from the model and the one server-function action must receive that exact input type", "change `{action_name}` to accept `{model_name}` as its only parameter"))
        return SemaDirectSpecialCheck{handled: true, value: None}
    }

    ^descriptor_values: [TExpr]{}
    ^valid: true
    loop field in definition.fields {
        if field.computed != None -> next
        ^value_variant: ""
        ^control_variant: ""
        ^field_type: sema_type_resolve_declared(graph, field.ty, model_module_identity)
        if {
            field_type == Type.String -> {
                value_variant = "String"
                control_variant = "Text"
            }
            field_type == Type.Int -> {
                value_variant = "Int"
                control_variant = "Number"
            }
            field_type == Type.Bool -> {
                value_variant = "Bool"
                control_variant = "Checkbox"
            }
            field_type == Type.Float -> {
                value_variant = "Float"
                control_variant = "Number"
            }
            else -> {
                check.diagnostics.push(sema_error("E2474", field.name_span, "form field `{field.name}` on `{model_name}` has unsupported type `{type_name(field_type)}`", "web forms decode scalar controls into the declared model fields without a second coercion policy", "change `{field.name}` to `String`, `Int`, `Bool`, or `Float`"))
                valid = false
                next
            }
        }
        ^descriptor: sema_call_http_core_form_descriptor(field, value_variant, control_variant)
        descriptor_value: sema_check_expression(descriptor, Val(Type.Named{name: "WebFormFieldSpec"}), check) ?? {
            valid = false
            next
        }
        descriptor_values.push(descriptor_value)
    }
    if !valid -> return SemaDirectSpecialCheck{handled: true, value: None}

    ^input_values: [TExpr]{sema_call_http_core_string(model_name, span), sema_tree_node(Type.List{element: Type.Named{name: "WebFormFieldSpec"}}, TExprKind.ListLit{values: descriptor_values}, span)}
    input_call: sema_call_core_source_declared("core.web.forms", "input", [Type]{}, input_values, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    ^input: sema_call_http_core_unwrap_result(input_call, Type.Named{name: "WebFormInput"}, "web.form could not construct its derived input", span, check)

    model_args: [Type]{sema_expr_expected_type(Type.Named{name: model_name}, check.environment.*, check.program.*)}
    typed_call: sema_call_core_source_declared("core.web.forms", "typed", model_args, [TExpr]{input, sema_call_http_core_string(action_name, span)}, span, check) ?? return SemaDirectSpecialCheck{handled: true, value: None}
    form_type: Type.Apply{name: sema_core_source_type_name(check.program.*, "core.web.forms", "WebFormTyped"), args: model_args}
    ^result: sema_call_http_core_unwrap_result(typed_call, form_type, "web.form could not register its typed action", span, check)
    return SemaDirectSpecialCheck{handled: true, value: sema_expr_expected(result, expected, check.environment.*, check.program.*, check.diagnostics)}
}
