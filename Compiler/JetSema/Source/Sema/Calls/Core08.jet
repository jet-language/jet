// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:4202-6457
// Direct module dispatch for this complete arm group. The canonical typed row
// is returned intact: no cloned checker, second search, or parameter reallocation.
fn core_fixed_sig_4202(module_name: String, member: String) -> CoreTypedCallSignature? {
    if module_name == "core.ui" && (member == "preview" || member == "playground") -> return Val(core_fixed_sig_preview(module_name, member))
    if module_name == {
        "core.text.html" | "core.time.calendar" | "core.time.expiring" | "core.log" -> core_value_fixed_signature(module_name, member)
        "core.crypto" | "core.crypto.expert" | "core.crypto.vault" | "core.net" | "core.net.tls" |
        "core.http" | "core.http.server" | "core.regex" | "core.archive" | "core.game.raylib" |
        "core.archive.gzip" | "core.archive.zstd" | "core.db" | "core.plugin" | "core.mod" |
        "core.encoding.binary" | "core.encoding.hex" | "core.encoding.base64" | "core.encoding.base32" |
        "core.crypto.uuid" | "core.args" | "core.term" | "core.perf" | "core.math" | "core.ui" |
        "core.font" | "core.tui" | "core.ui.host" | "core.ui.host.clipboard" | "core.ui.host.ime" |
        "core.ui.host.drag_drop" | "core.ui.host.shortcuts" | "core.ui.host.accessibility" |
        "core.web" | "app" | "core.web.storage.local" | "core.web.storage.session" | "core.web.devserver" -> core_platform_fixed_signature(module_name, member)
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/fixed_sigs.rs:6003-6010
// The existing Foundation row :432 used Result<Viewport,Absent>, but Rust's
// signature carries Type.Option. Keep the ordinary callback signature and the
// canonical CoreTypedCallSignature record; the parent routes these arms here.
fn core_fixed_sig_preview(module_name: String, member: String) -> CoreTypedCallSignature Never! {
    callback :: Type.Fn{params: [], ret: Val(Type.Named{name: "UINode"}), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    CoreTypedCallSignature{
        module_name: module_name, member: member, min_arity: 3, max_arity: 3,
        parameters: [CoreCallTypedParameter]{
            CoreCallTypedParameter{name: "", label: "", zone: ParamZone.PositionalOnly, access: AccessConvention.Read, ty: Type.String, default: None},
            CoreCallTypedParameter{name: "", label: "", zone: ParamZone.PositionalOnly, access: AccessConvention.Read, ty: Type.Option{inner: Type.Named{name: "UIPreviewViewport"}}, default: None},
            CoreCallTypedParameter{name: "", label: "", zone: ParamZone.PositionalOnly, access: AccessConvention.Read, ty: callback, default: None},
        },
        return_type: Val(Type.Named{name: "UIPreview"}), type_parameters: [], result_rule: CoreCallResultRule.Declared,
    }
}

