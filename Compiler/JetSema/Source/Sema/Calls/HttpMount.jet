// Mounting reflects one explicit struct value and
// expands to ordinary checked registrations. No backend discovers routes.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    BodyTree,
    CallArg,
    Diagnostic,
    Expr,
    FnBody,
    Func,
    Lambda,
    LambdaBody,
    LambdaParam,
    Marker,
    NamedSpan,
    OrFallback,
    Span,
    StrPart,
    Stmt,
    Symbol,
    SymbolKind,
    TLetTy,
    Type,
    ast_binding,
    AST_EMPTY_CALL_ARG_FLAGS,
    ast_empty_lambda_meta,
    body_each_expr_child,
    body_each_stmt_child,
    body_node,
    body_type,
    expr_span,
    symbol_key_text,
    symbol_table_key,
    diagnostic_registry_row,
    checked_symbol_local,
    type_name,
    ModuleID,
]

sema_http_route_marker_verb: fn(marker: Marker, graph: SemaRegistrationGraph, module_identity: ModuleID) -> String? {
    if marker.negated -> return None
    resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
    if resolved.status != "found" -> return None
    declaration: resolved.declaration ?? return None
    module_index: sema_registration_module_index(graph, resolved.declaring_module_identity) ?? return None
    if graph.modules[module_index].module_name != "core.http.server" -> return None
    // A route marker is named for its `Method` case: `#Get` registers `get`,
    // and `#Custom(token, path)` the custom method `token`.
    verb: declaration.name.lower()
    if verb != sema_http_route_custom_verb() && !sema_http_route_verbs().contains(verb) {
        return None
    }
    Val(verb)
}

// The Core module that declares the app endpoint markers (`use app`), and
// their names: a method marked `#App.SignedIn` or `#App.Public` is an
// endpoint.
SEMA_APP_MARKER_MODULE: "app"

SEMA_APP_ENDPOINT_MARKERS: [String]{"SignedIn", "Public"}

// The app endpoint marker `marker` is, written in module `module_identity`:
// "SignedIn" or "Public"; None for any other marker.
sema_app_endpoint_access: fn(marker: Marker, graph: SemaRegistrationGraph, module_identity: ModuleID) -> String? {
    if marker.negated -> return None
    resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
    if resolved.status != "found" -> return None
    declaration: resolved.declaration ?? return None
    module_index: sema_registration_module_index(graph, resolved.declaring_module_identity) ?? return None
    if graph.modules[module_index].module_name != SEMA_APP_MARKER_MODULE || !SEMA_APP_ENDPOINT_MARKERS.contains(declaration.name) {
        return None
    }
    Val("{declaration.name}")
}

// Whether `marker`, written in module `module_identity`, is one of the app
// module's endpoint markers.
sema_app_endpoint_marker: fn(marker: Marker, graph: SemaRegistrationGraph, module_identity: ModuleID) -> Bool {
    sema_app_endpoint_access(marker, graph, module_identity) != None
}

// The app markers of a webhook and of the method that gives its key. Neither
// marks an endpoint: no Remote calls either method.
SEMA_APP_WEBHOOK_MARKER: "Webhook"

SEMA_APP_SIGNING_KEY_MARKER: "SigningKey"

// Whether `marker`, written in module `module_identity`, is the app module's
// marker `name`.
sema_app_marker_is: fn(marker: Marker, name: String, graph: SemaRegistrationGraph, module_identity: ModuleID) -> Bool {
    if marker.negated -> return false
    resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
    if resolved.status != "found" -> return false
    declaration: resolved.declaration ?? return false
    module_index: sema_registration_module_index(graph, resolved.declaring_module_identity) ?? return false
    graph.modules[module_index].module_name == SEMA_APP_MARKER_MODULE && declaration.name == name
}

// The index in `marker.args` of the written argument labeled `label`, else
// of the unlabeled one at `position`.
sema_app_marker_arg_at: fn(marker: Marker, label: String, position: Int) -> Int? {
    loop (index, argument) in marker.args {
        if !(argument == .Expr(_)) -> next
        chosen := index == position
        if index < marker.arg_labels.len() {
            if marker.arg_labels[index] == .Val(named) -> chosen = named.name == label
        }
        if chosen -> return Val(index)
    }
    None
}

// The static String that argument `at` of `marker` gives; None when it
// gives none.
sema_app_marker_string: fn(marker: Marker, at: Int, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> String? {
    if marker.args[at] == .Expr(value) {
        return sema_http_route_constant_string(value, environment, program, scopes)
    }
    None
}

// Where argument `at` of `marker` is written.
sema_app_marker_span: fn(marker: Marker, at: Int) -> Span {
    if marker.args[at] == .Expr(value) -> return expr_span(value)
    marker.span
}

// Argument `at` of `marker`, checked as `expected`, as an argument of an App
// registration.
sema_app_marker_checked: fn(marker: Marker, at: Int, expected: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TCallArg? {
    if marker.args[at] == .Expr(value) {
        checked: sema_check_expression(value, Val(expected), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        return Val(sema_call_http_static_tree_arg(checked, sema_http_mount_arg(value, expr_span(value))))
    }
    None
}

// The marker that makes method `func` an endpoint, written in module
// `module_identity`, as written (`#App.SignedIn`,
// `#Server.Get("/orders/:id")`), for `jet inspect choices`
// (FnBody.endpoint); "" when no app endpoint marker or route marker marks
// it. An argument that is no plain String literal shows as `…`.
sema_function_endpoint: fn(func: Func, graph: SemaRegistrationGraph, module_identity: ModuleID) -> String {
    loop marker in func.markers {
        if !sema_app_endpoint_marker(marker, graph, module_identity) && sema_http_route_marker_verb(marker, graph, module_identity) == None {
            next
        }
        if marker.args.len() == 0 -> return "#{marker.name}"
        args := [String]{}
        loop argument in marker.args {
            text := "…"
            if argument == .Expr(value) {
                if value == .Str(parts, _, _) {
                    if parts.len() == 1 {
                        if parts[0] == .Lit(literal) -> text = "\"{literal}\""
                    }
                }
            }
            args.push(text)
        }
        return "#{marker.name}({args.join(", ")})"
    }
    ""
}

// `app.Remote<S>`, the app module's client of a service, and the methods
// the client calls of it lower to.
SEMA_APP_REMOTE: "Remote"

SEMA_APP_REMOTE_CALL: "__call"

SEMA_APP_REMOTE_CALL_VALUE: "__call_value"

SEMA_APP_REMOTE_ARG: "__arg"

SEMA_APP_REMOTE_RAISE: "__raise"

// Whether `ty`, a resolved type of one type argument, is `app.Remote<S>`.
sema_app_is_remote: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    graph: program.registration_graph ?? return false
    row: sema_type_resolve_nominal_row(graph, ty, environment.module_identity) ?? return false
    graph.modules[row.module_index].module_name == SEMA_APP_MARKER_MODULE && graph.modules[row.module_index].nominals[row.row].symbol.name == SEMA_APP_REMOTE
}

// `remote.method(args…)` on an `app.Remote<S>`. A method of `S` that
// `#App.SignedIn` or `#App.Public` marks is a remote call
// (`sema_app_remote_call`). Any other method of `S` is server-only (E2812),
// and a name `S` does not declare is no method of the Remote (E0102).
sema_call_app_remote_method: fn(receiver: Expr, service: Type, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    graph: program.registration_graph ?? return None
    shown := "app.Remote<{type_name(service)}>"
    declared := false
    if sema_type_resolve_nominal_row(graph, service, environment.module_identity) == .Val(row) {
        shown = "app.Remote<{graph.modules[row.module_index].nominals[row.row].symbol.name}>"
        service_module: graph.modules[row.module_index].module_identity
        if sema_http_route_find_struct(environment, program, service, environment.module_identity) == .Val(definition) {
            loop declaration in definition.methods {
                if declaration.name != method -> next
                declared = true
                endpoint: loop marker in declaration.markers {
                    if sema_app_endpoint_marker(marker, graph, service_module) {
                        break true
                    }
                } ?? false
                if !endpoint -> next
                if owner_type_args.len() != 0 || type_args.len() != 0 {
                    diagnostics.push(sema_call_not_generic_diagnostic(method, method_span))
                    sema_data_check_discarded_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
                    return None
                }
                return sema_app_remote_call(receiver, service, shown, declaration, service_module, method_span, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
            }
        }
    }
    if {
        declared -> {
            entry: diagnostic_registry_row("E2812") ?? panic("E2812 must have a registry row")
            diagnostics.push(sema_error("E2812", method_span, entry.what.replace("{{remote}}", shown).replace("{{method}}", method), entry.why, entry.fix.replace("{{method}}", method)))
        }
        else -> {
            diagnostics.push(sema_error("E0102", method_span, "`{shown}` has no method `{method}`", "`{shown}` offers only the methods of its service that `#App.SignedIn` or `#App.Public` marks", "call a marked method of the service"))
        }
    }
    sema_data_check_discarded_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
    None
}

sema_app_remote_ident: fn(name: String, span: Span) -> Expr Never! {
    Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
}

// `remote.method<type_args>(args)`, where `remote` names the hidden local
// or the caller's local that holds the Remote.
sema_app_remote_method_call: fn(remote: String, method: String, type_args: [Type], args: [CallArg], span: Span) -> Expr Never! {
    Expr.MethodCall{receiver: sema_app_remote_ident(remote, span), method: method, method_span: span, owner_type_args: [Type]{}, type_args: type_args, args: args, id: AST_NODE_GENERATED}
}

// The endpoint method `declaration` of `S`, called through a Remote. The
// Remote, unless it is a local, and each argument are evaluated once into
// hidden locals, the arguments with their parameters' types, and the call
// lowers to the Remote's `__call` (a method that can fail with `E`) or
// `__call_value` (one that can't): `direct` runs the method on the service
// the Remote holds, and otherwise the encoded arguments go to the server.
// The call's type is `R E!`, or `R app.CallError!` for a method that can't
// fail.
sema_app_remote_call: fn(receiver: Expr, service: Type, shown: String, declaration: Func, service_module: ModuleID, method_span: Span, args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    graph: program.registration_graph ?? return None
    method: declaration.name
    concrete: declaration.params.len() > 0 && declaration.params[0].name == "self" && declaration.params[0].convention == AccessConvention.Read && declaration.type_params.len() == 0
    read_only: loop index in 1..<declaration.params.len() {
        if declaration.params[index].convention != AccessConvention.Read {
            break false
        }
    } ?? true
    if !concrete || !read_only {
        diagnostics.push(sema_error("E2805", method_span, "`{shown}.{method}` needs read-only self, read parameters and a concrete signature", "a remote call sends its arguments to the server as data and runs the method on the server's service", "write `{method}: fn(self, ...)` with read parameters and without method type parameters"))
        sema_data_check_discarded_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    wanted: declaration.params.len() - 1
    if args.len() != wanted {
        diagnostics.push(sema_call_arity_diagnostic(method, wanted, args.len(), false, method_span))
        sema_data_check_discarded_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    loop index in 0..<args.len() {
        name: declaration.params[index + 1].name
        named_other: if {
            args[index].label == .Val(label) -> label.name != name
            else -> false
        }
        if args[index].spread || named_other {
            diagnostics.push(sema_error("E0104", args[index].span, "`{shown}.{method}` takes its arguments in order", "a remote call checks each argument against the parameter in its place", "pass `{name}` as argument {index + 1}, without a spread or another label"))
            sema_data_check_discarded_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
            return None
        }
    }
    start: method_span.start
    hidden: "__jet_app_remote_{start}"
    sema_scope_enter(scopes, state, "app.remote:{start}")
    body := [TStmt]{}
    remote: if {
        receiver == .Ident(written, _, _) -> "{written}"
        else -> "{hidden}"
    }
    if !(receiver == .Ident(_, _, _)) {
        held: sema_stmt_check_binding(ast_binding(remote, expr_span(receiver), false, receiver, None), None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
            sema_single_use_leave_scope(scopes, state, diagnostics)
            return None
        }
        body.push(held)
    }
    encoded := [Expr]{}
    reads := [CallArg]{}
    loop index in 0..<args.len() {
        // A bare name is read where it stands (a read parameter cannot be
        // moved into a local); any other argument is bound once, as its
        // parameter's type, so it runs once.
        local_name: if {
            args[index].expr == .Ident(written, _, _) -> "{written}"
            else -> "{hidden}_{index}"
        }
        if !(args[index].expr == .Ident(_, _, _)) {
            binding := ast_binding(local_name, args[index].span, false, args[index].expr, None)
            binding.ty = Val(sema_type_resolve_declared(graph, declaration.params[index + 1].ty, service_module))
            statement: sema_stmt_check_binding(binding, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
                sema_single_use_leave_scope(scopes, state, diagnostics)
                return None
            }
            body.push(statement)
        }
        encoded.push(sema_app_remote_method_call(remote, SEMA_APP_REMOTE_ARG, [Type]{}, [CallArg]{sema_http_mount_arg(sema_app_remote_ident(local_name, args[index].span), args[index].span)}, args[index].span))
        reads.push(sema_http_mount_arg(sema_app_remote_ident(local_name, args[index].span), args[index].span))
    }
    service_name: "{hidden}_service"
    invocation: Expr.MethodCall{receiver: sema_app_remote_ident(service_name, method_span), method: method, method_span: method_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: reads, id: AST_NODE_GENERATED}
    direct: Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: [LambdaParam]{LambdaParam{name: service_name, name_span: method_span, ty: Val(service), ty_span: None, convention: AccessConvention.Read}}, effects: None, body: LambdaBody.Expr{value: invocation}, span: method_span, meta: ast_empty_lambda_meta()}, id: AST_NODE_GENERATED}
    wire: [CallArg]{
        sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: method}}, span: method_span, id: AST_NODE_GENERATED}, method_span),
        sema_http_mount_arg(Expr.ListLit{elements: encoded, span: method_span, id: AST_NODE_GENERATED}, method_span),
        sema_http_mount_arg(direct, method_span),
    }
    returned: declaration.return_type ?? Type.Named{name: "Unit"}
    declared_return: sema_type_resolve_declared(graph, returned, service_module)
    raised_return: sema_type_resolve_declared(graph, returned, service_module)
    lowered: if {
        declared_return == .Result(ok, failure) -> sema_app_remote_fallible(remote, hidden, wire, ok, failure, raised_return, method_span)
        else -> sema_app_remote_method_call(remote, SEMA_APP_REMOTE_CALL_VALUE, [Type]{declared_return}, wire, method_span)
    }
    // The lowered call keeps its Result carrier: the remote call is the call
    // root, which its consumer (`??`, `?`) reads or auto-propagates.
    checked: sema_check_expression_carrier(lowered, None, environment, program, scopes, state, tail_store, context, diagnostics) ?? {
        sema_single_use_leave_scope(scopes, state, diagnostics)
        return None
    }
    result_type: checked.ty
    body.push(TStmt.ExprStmt{value: checked, span: method_span})
    sema_single_use_leave_scope(scopes, state, diagnostics)
    sema_expression_call_expected(sema_tree_node(result_type, TExprKind.InlineBlock{body: body}, method_span), expected, environment, program, context, diagnostics)
}

// `remote.__call<R, E>(method, args, direct, fail)` for an endpoint method
// that fails with `E`: `fail` binds the transport's `CallError` raised as an
// `R CallError!`, so it converts to `E` as any propagated error does.
// `raised_return` is the method's `R E!` once more, for `__raise<R>`;
// `hidden` prefixes the closure's names.
sema_app_remote_fallible: fn(remote: String, hidden: String, wire: &&[CallArg], ok: Type, failure: Type, raised_return: Type, span: Span) -> Expr Never! {
    failure_name: "{hidden}_failure"
    raised_name: "{hidden}_raised"
    raised_ok: if {
        raised_return == .Result(success, _) -> success
        else -> Type.Named{name: "Unit"}
    }
    raise: sema_app_remote_method_call(remote, SEMA_APP_REMOTE_RAISE, [Type]{raised_ok}, [CallArg]{sema_http_mount_arg(sema_app_remote_ident(failure_name, span), span)}, span)
    fail_body: [Stmt]{Stmt.Val{binding: ast_binding(raised_name, span, false, raise, None)}, Stmt.Expr{expr: Expr.Ok{value: sema_app_remote_ident(raised_name, span), span: span, id: AST_NODE_GENERATED}}}
    fail: Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: [LambdaParam]{LambdaParam{name: failure_name, name_span: span, ty: None, ty_span: None, convention: AccessConvention.Read}}, effects: None, body: LambdaBody.Block{body: fail_body}, span: span, meta: ast_empty_lambda_meta()}, id: AST_NODE_GENERATED}
    filled := wire.move()
    filled.push(sema_http_mount_arg(fail, span))
    sema_app_remote_method_call(remote, SEMA_APP_REMOTE_CALL, [Type]{ok, failure}, filled, span)
}

// The module that declares the web markers. The web rules key on its
// markers (`#RouteTable` on App, `#Form` on a form model, `#ColumnOf` on
// table.column's name), never on another module's same-named ones; its
// submodules declare theirs.
SEMA_WEB_MARKER_MODULE: "core.web"

SEMA_WEB_MARKER_ROUTE_TABLE: "RouteTable"

SEMA_WEB_MARKER_FORM: "Form"

SEMA_WEB_MARKER_COLUMN_OF: "ColumnOf"

// Whether `marker`, written in the module `module_identity`, is the web
// module's marker `name`.
sema_web_marker_is: fn(marker: Marker, graph: SemaRegistrationGraph, module_identity: ModuleID, name: String) -> Bool {
    if marker.negated || (marker.name != name && !marker.name.ends_with(".{name}")) -> return false
    resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
    if resolved.status != "found" -> return false
    declaration: resolved.declaration ?? return false
    module_index: sema_registration_module_index(graph, resolved.declaring_module_identity) ?? return false
    declaring: graph.modules[module_index].module_name
    (declaring == SEMA_WEB_MARKER_MODULE || declaring.starts_with("{SEMA_WEB_MARKER_MODULE}.")) && declaration.name == name
}

// The index of the parameter of the function `key` that carries the web
// marker `name`. A parameter's marker is an applied rule of its module at
// the Parameter site, written ahead of the parameter's name; it belongs to
// the parameter whose name it precedes, after the previous parameter's type.
sema_web_param_marker: fn(graph: SemaRegistrationGraph, key: String, name: String) -> Int? {
    row: sema_registration_callable_row(graph, key) ?? return None
    if row == {
        .Function(module_index, index) -> {
            loop application in graph.modules[module_index].program.applied_rules {
                if application.site != (Val(RuleSite.Parameter)) -> next
                target: application.target ?? next
                if !sema_web_marker_is(application.marker, graph, graph.modules[module_index].module_identity, name) {
                    next
                }
                if sema_web_param_at(graph.modules[module_index].functions[index].declaration, target) == .Val(param) {
                    return Val(param)
                }
            }
            None
        }
        .Foreign(_, _) | .NominalMethod(_, _, _) | .ImplMethod(_, _, _) -> None
    }
}

sema_web_param_at: fn(function: Func, target: Span) -> Int? Never! {
    start := function.name_span.end
    loop param_index in 0..<function.params.len() {
        if target.start >= start && target.end <= function.params[param_index].name_span.start {
            return Val(param_index)
        }
        start = function.params[param_index].ty_span.end
    }
    None
}

sema_http_mount_arg: fn(expression: Expr, span: Span) -> CallArg Never! {
    CallArg{
        convention: AccessConvention.Read,
        expr: expression,
        span: span,
        flags: AST_EMPTY_CALL_ARG_FLAGS,
        label: None,
        spread: false,
    }
}

// `app.mount(value)` and `app.mount(prefix, value)`: each route-marked method
// of the struct value registers as the single route its marker names, and
// each endpoint-marked one as POST `{prefix}/{name}`
// (`sema_app_mount_endpoint`), under the static `prefix` when there is one;
// the call is the App, so it chains.
sema_call_http_mount: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if args.len() != 1 && args.len() != 2 {
        diagnostics.push(sema_call_arity_diagnostic("mount", 2, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    prefix := ""
    if args.len() == 2 {
        text: sema_http_route_constant_string(args[0].expr, environment, program, scopes) ?? {
            diagnostics.push(sema_error("E2805", args[0].span, "app.mount prefix must be a static String", "a mounted struct's routes are fully checked while building, prefix included", "use a literal or compile-time String constant"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        prefix = sema_http_mount_prefix(text)
    }
    value_arg: args[args.len() - 1]
    sema_scope_enter(scopes, state, "http.mount:{span.start}")
    body := [TStmt]{}
    mux_name: "__jet_http_mount_mux_{span.start}"
    owner: sema_scope_local_owner_key(scopes)
    local_module: sema_scope_environment_module_text(environment, program)
    mux_key: symbol_key_text(SymbolKind.Local, local_module, owner, mux_name)
    mux_id: sema_symbol_id_of(program, context, mux_key)
    mux_symbol: Symbol{
        id: mux_id,
        kind: SymbolKind.Local,
        name: mux_name,
        module_identity: environment.module_identity,
        owner: Val(owner),
        span: span,
        ty: Val(receiver_value.ty),
        visibility: 0,
    }
    _ := sema_scope_declare_local(scopes, mux_symbol, mux_key, false, AccessConvention.Read, None, false)
    sema_ownership_declare_binding(state, mux_symbol, false)
    mux_local: checked_symbol_local(mux_name, span, mux_id, receiver_value.ty)
    body.push(
        TStmt.Let{
            local: mux_local,
            let_ty: TLetTy.Inferred,
            init: receiver_value,
            gc_promotion: None,
            gc_transferred: false,
            span: span,
        },
    )
    value_name: "__jet_http_mount_value_{span.start}"
    binding: ast_binding(value_name, span, false, value_arg.expr, None)
    checked_binding := sema_stmt_check_binding(binding, None, environment, program, scopes, state, tail_store, context, diagnostics)
    if checked_binding == .Val(statement) {
        body.push(statement)
        binding_index: sema_scope_resolve_index(scopes, value_name) ?? panic("mounted value binding is absent")
        value_ty: scopes.bindings[binding_index].symbol.ty ?? panic("mounted value has no type")
        if sema_http_route_find_struct(environment, program, value_ty, environment.module_identity) == .Val(definition) {
            if program.registration_graph == .Val(graph) {
                nominal_row: sema_type_resolve_nominal_row(graph, value_ty, environment.module_identity) ?? panic("mount has no nominal row")
                method_module: graph.modules[nominal_row.module_index].module_identity
                loop method in definition.methods {
                    // An endpoint method answers POST `{prefix}/{name}`, once
                    // whatever markers it carries.
                    loop marker in method.markers {
                        access: sema_app_endpoint_access(marker, graph, method_module) ?? next
                        endpoint: sema_app_mount_endpoint(sema_tree_node(receiver_value.ty, TExprKind.Local{local: mux_local}, span), value_name, method, method_module, access, marker, prefix, span, environment, program, scopes, state, tail_store, context, diagnostics)
                        if endpoint == .Val(value) {
                            body.push(TStmt.ExprStmt{value: value, span: span})
                        }
                        break
                    }
                    // A webhook answers POST `{prefix}{path}` for its sender.
                    loop marker in method.markers {
                        if !sema_app_marker_is(marker, SEMA_APP_WEBHOOK_MARKER, graph, method_module) {
                            next
                        }
                        hook: sema_app_mount_webhook(sema_tree_node(receiver_value.ty, TExprKind.Local{local: mux_local}, span), value_name, graph.modules[nominal_row.module_index].nominals[nominal_row.row].symbol.name, definition.methods, method, method_module, marker, prefix, span, environment, program, scopes, state, tail_store, context, diagnostics)
                        if hook == .Val(value) {
                            body.push(TStmt.ExprStmt{value: value, span: span})
                        }
                        break
                    }
                    loop marker in method.markers {
                        verb: sema_http_route_marker_verb(marker, graph, method_module) ?? next
                        if method.params.len() == 0 || method.params[0].name != "self" || method.params[0].convention != AccessConvention.Read || method.type_params.len() != 0 {
                            diagnostics.push(sema_error("E2805", marker.span, "HTTP route method `{method.name}` needs read-only self and a concrete signature", "mounted handlers retain shared state and are called on request workers", "write `{method.name}: fn(self, ...)` without method type parameters; use Shared<T> for mutable shared state"))
                            next
                        }
                        // `#Custom` takes its method token before the path.
                        marked := [CallArg]{}
                        loop mark_arg in marker.args {
                            if mark_arg == .Expr(mark_value) {
                                marked.push(sema_http_mount_arg(mark_value, expr_span(mark_value)))
                            }
                        }
                        custom: verb == sema_http_route_custom_verb()
                        marked_count: if custom -> 2 else -> 1
                        if marker.args.len() != marked_count || marked.len() != marked_count -> next
                        if custom && sema_http_route_constant_string(marked[0].expr, environment, program, scopes) == None {
                            diagnostics.push(sema_error("E2808", marked[0].span, "`#Server.Custom` route method must be a static String", "a marked route is fully checked while building; only `app.custom` takes a run-time method, checked when it registers", "use a literal or compile-time String constant, or register the route with `app.custom`"))
                            next
                        }
                        if prefix != "" {
                            path_at: marked_count - 1
                            path: sema_http_route_constant_string(marked[path_at].expr, environment, program, scopes) ?? {
                                diagnostics.push(sema_error("E2805", marked[path_at].span, "a route marker under a mount prefix needs a static path", "the mounted route's address is the prefix and the marker's path, checked while building", "use a literal or compile-time String constant"))
                                next
                            }
                            marked[path_at] = sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: "{prefix}{path}"}}, span: marked[path_at].span, id: AST_NODE_GENERATED}, marked[path_at].span)
                        }
                        params := [LambdaParam]{}
                        call_args := [CallArg]{}
                        loop index in 1..<method.params.len() {
                            parameter_ty: sema_type_resolve_declared(graph, method.params[index].ty, method_module)
                            params.push(LambdaParam{name: method.params[index].name, name_span: method.params[index].name_span, ty: Val(parameter_ty), ty_span: None, convention: AccessConvention.Read})
                            argument := sema_http_mount_arg(Expr.Ident{name: method.params[index].name, span: method.params[index].name_span, id: AST_NODE_GENERATED}, method.params[index].name_span)
                            argument.convention = method.params[index].convention
                            call_args.push(argument)
                        }
                        invocation: Expr.MethodCall{receiver: Expr.Ident{name: value_name, span: span, id: AST_NODE_GENERATED}, method: method.name, method_span: method.name_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: call_args, id: AST_NODE_GENERATED}
                        meta := ast_empty_lambda_meta()
                        nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
                        loop registered in nominal.methods {
                            if registered.declaration.name == method.name {
                                meta.http_route_source = Val(symbol_table_key(graph.symbols, registered.symbol.id))
                            }
                        }
                        handler: Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: params, effects: None, body: LambdaBody.Expr{value: invocation}, span: marker.span, meta: meta}, id: AST_NODE_GENERATED}
                        marked.push(sema_http_mount_arg(handler, marker.span))
                        registration: sema_call_try_http_router(receiver, sema_tree_node(receiver_value.ty, TExprKind.Local{local: mux_local}, span), verb, marked, marker.span, None, environment, program, scopes, state, tail_store, context, diagnostics)
                        if registration.value == .Val(value) {
                            body.push(TStmt.ExprStmt{value: value, span: marker.span})
                        }
                    }
                }
            } else { panic("mount has no registration graph") }
        } else {
            diagnostics.push(sema_error("E2805", value_arg.span, "app.mount needs an ordinary struct, not `{type_name(value_ty)}`", "only the explicitly mounted struct's tagged methods contribute routes", "pass a struct value with #Server.Get or another core.http.server verb marker"))
        }
    }
    // The block's value is the App, so `app.mount(value)` chains.
    body.push(TStmt.ExprStmt{value: sema_tree_node(receiver_value.ty, TExprKind.Local{local: mux_local}, span), span: span})
    sema_single_use_leave_scope(scopes, state, diagnostics)
    value: sema_tree_node(receiver_value.ty, TExprKind.InlineBlock{body: body}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

// The endpoint method `method` of the mounted value `value_name` answers
// POST `{prefix}/{name}` on the App `mux`, where a Remote that `remote_at`
// made posts its calls. An `#App.Public` method registers through the App's
// `__remote_public` with a handler that decodes each argument from the
// posted JSON array and encodes the method's reply; an `#App.SignedIn` one
// through `__remote_signed_in`. Both take the endpoint `marker`'s rate limit
// (`sema_app_endpoint_limit`). The generated code is the mount call's, at
// `span`: the marker may sit in another file, or outside the function that
// mounts, and a generated handler is a lambda of that function.
sema_app_mount_endpoint: fn(mux: TExpr, value_name: String, method: Func, method_module: ModuleID, access: String, marker: Marker, prefix: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    if !sema_app_mount_concrete(method) {
        diagnostics.push(sema_error("E2805", marker.span, "endpoint method `{method.name}` needs read-only self, read parameters and a concrete signature", "a mounted endpoint decodes its arguments from the request and runs on request workers", "write `{method.name}: fn(self, ...)` with read parameters and without method type parameters"))
        return None
    }
    address: "{prefix}/{method.name}"
    path: sema_call_http_static_tree_arg(sema_call_http_core_string(address, span), sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: address}}, span: span, id: AST_NODE_GENERATED}, span))
    limit := sema_app_endpoint_limit(marker, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    window: limit.pop() ?? panic("an endpoint limit has no window")
    calls: limit.pop() ?? panic("an endpoint limit has no count")
    if access == "SignedIn" {
        return sema_call_http_mux_source_call(mux, "__remote_signed_in", [TCallArg]{path, calls, window}, span, None, environment, program, scopes, state, tail_store, context, diagnostics).value
    }
    answer: sema_app_mount_answer(value_name, method, method_module, sema_app_mux_param_type(mux, "__remote_public", 1, span, environment, program, diagnostics), span, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    sema_call_http_mux_source_call(mux, "__remote_public", [TCallArg]{path, answer, calls, window}, span, None, environment, program, scopes, state, tail_store, context, diagnostics).value
}

// Whether a mounted method `method` has read-only self, read parameters and
// no method type parameters, so a request's decoded data can call it.
sema_app_mount_concrete: fn(method: Func) -> Bool {
    if method.params.len() == 0 || method.params[0].name != "self" || method.params[0].convention != AccessConvention.Read || method.type_params.len() != 0 {
        return false
    }
    loop index in 1..<method.params.len() {
        if method.params[index].convention != AccessConvention.Read -> return false
    }
    true
}

// The index in `methods`, declared in module `module_identity`, of the
// method named `name` that `#App.SigningKey` marks; None when no method is
// both.
sema_app_signing_key_at: fn(methods: [Func], name: String, graph: SemaRegistrationGraph, module_identity: ModuleID) -> Int? {
    loop (index, candidate) in methods {
        if candidate.name != name -> next
        loop marker in candidate.markers {
            if sema_app_marker_is(marker, SEMA_APP_SIGNING_KEY_MARKER, graph, module_identity) {
                return Val(index)
            }
        }
    }
    None
}

// The webhook method `method` of the mounted value `value_name`, of the
// service `service`, answers POST `{prefix}{path}` on the App `mux` through
// its `__webhook`, by its `#App.Webhook` `marker`. Its parameters named for
// the path's parameters take them; one more, last, takes the delivery's
// decoded body. `key:` names the method of `methods` that `#App.SigningKey`
// marks (E2814 otherwise), whose key each delivery is checked under
// (`sema_app_webhook_key`). The generated code is the mount call's, at
// `span`.
sema_app_mount_webhook: fn(mux: TExpr, value_name: String, service: String, methods: [Func], method: Func, method_module: ModuleID, marker: Marker, prefix: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    graph: program.registration_graph ?? return None
    if !sema_app_mount_concrete(method) {
        diagnostics.push(sema_error("E2805", marker.span, "webhook method `{method.name}` needs read-only self, read parameters and a concrete signature", "a mounted webhook decodes its arguments from the delivery and runs on request workers", "write `{method.name}: fn(self, ...)` with read parameters and without method type parameters"))
        return None
    }
    // The marker's own check reports a missing argument.
    path_at: sema_app_marker_arg_at(marker, "path", 0) ?? return None
    signature_at: sema_app_marker_arg_at(marker, "signature", 1) ?? return None
    key_at: sema_app_marker_arg_at(marker, "key", 2) ?? return None
    route: sema_app_marker_string(marker, path_at, environment, program, scopes) ?? {
        diagnostics.push(sema_error("E2805", sema_app_marker_span(marker, path_at), "a webhook's path must be a static String", "a webhook's route is fully checked while building, mount prefix included", "use a literal or compile-time String constant"))
        return None
    }
    address: "{prefix}{route}"
    if sema_http_route_pattern_error(address) == .Val(reason) {
        diagnostics.push(sema_http_route_invalid_diagnostic(address, reason, sema_app_marker_span(marker, path_at)))
        return None
    }
    fields: sema_http_route_path_fields(address) ?? return None
    // The indices of the method's path parameters, in its order, and their
    // names joined by commas.
    path_params := [Int]{}
    joined := ""
    loop index in 1..<method.params.len() {
        name: method.params[index].name
        in_path: loop field in fields {
            if field.name == name {
                break true
            }
        } ?? false
        if in_path {
            path_params.push(index)
            if joined != "" -> joined = "{joined},"
            joined = "{joined}{name}"
            next
        }
        if index != method.params.len() - 1 {
            diagnostics.push(sema_error("E2805", method.params[index].name_span, "webhook parameter `{name}` names no parameter of `{address}`", "a webhook's parameters take its path's parameters by name, and only its last takes the delivery's body", "rename `{name}` for a parameter of the path, or make it the last parameter"))
            return None
        }
    }
    key_name: sema_app_marker_string(marker, key_at, environment, program, scopes) ?? "…"
    key_method_at: sema_app_signing_key_at(methods, key_name, graph, method_module) ?? {
        entry: diagnostic_registry_row("E2814") ?? panic("E2814 must have a registry row")
        diagnostics.push(sema_error("E2814", sema_app_marker_span(marker, key_at), entry.what.replace("{{key}}", key_name).replace("{{service}}", service), entry.why, entry.fix.replace("{{key}}", key_name)))
        return None
    }
    key: sema_app_webhook_key(mux, value_name, methods[key_method_at], method, method_module, path_params, address, span, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    signature: sema_app_marker_checked(marker, signature_at, sema_app_mux_param_type(mux, "__webhook", 1, span, environment, program, diagnostics), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    path: sema_call_http_static_tree_arg(sema_call_http_core_string(address, span), sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: address}}, span: span, id: AST_NODE_GENERATED}, span))
    params: sema_call_http_static_tree_arg(sema_call_http_core_string(joined, span), sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: joined}}, span: span, id: AST_NODE_GENERATED}, span))
    answer: sema_app_mount_answer(value_name, method, method_module, sema_app_mux_param_type(mux, "__webhook", 4, span, environment, program, diagnostics), span, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
    sema_call_http_mux_source_call(mux, "__webhook", [TCallArg]{path, signature, params, key, answer}, span, None, environment, program, scopes, state, tail_store, context, diagnostics).value
}

// The checked key callback of the webhook `method`, whose path parameters
// are `method`'s parameters at `path_params`: it decodes each parameter of
// the signing-key method `key_method` from those, by name, and gives
// `Ok(value.key_method(...))`.
sema_app_webhook_key: fn(mux: TExpr, value_name: String, key_method: Func, method: Func, method_module: ModuleID, path_params: [Int], address: String, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TCallArg? {
    graph: program.registration_graph ?? return None
    if !sema_app_mount_concrete(key_method) {
        diagnostics.push(sema_error("E2805", key_method.name_span, "signing-key method `{key_method.name}` needs read-only self, read parameters and a concrete signature", "a webhook runs its signing-key method on each delivery's path parameters, on request workers", "write `{key_method.name}: fn(self, ...)` with read parameters and without method type parameters"))
        return None
    }
    args_name: "__jet_http_webhook_key_{span.start}"
    statements := [Stmt]{}
    reads := [CallArg]{}
    loop index in 1..<key_method.params.len() {
        name: key_method.params[index].name
        position := -1
        loop (at, param_index) in path_params {
            if method.params[param_index].name == name -> position = at
        }
        if position < 0 {
            diagnostics.push(sema_error("E2805", key_method.params[index].name_span, "signing-key parameter `{name}` names no path parameter of webhook `{method.name}`", "a signing-key method takes the webhook's path parameters by name, before the delivery's body is read", "take only parameters that `{method.name}` takes from `{address}`"))
            return None
        }
        local_name: "{args_name}_{index}"
        decoded: Expr.MethodCall{receiver: sema_app_remote_ident(args_name, span), method: "__take", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{sema_type_resolve_declared(graph, key_method.params[index].ty, method_module)}, args: [CallArg]{sema_http_mount_arg(Expr.Int{value: position, span: span, width: None, raw: None, id: AST_NODE_GENERATED}, span)}, id: AST_NODE_GENERATED}
        statements.push(Stmt.Val{binding: ast_binding(local_name, span, false, decoded, None)})
        reads.push(sema_http_mount_arg(sema_app_remote_ident(local_name, span), span))
    }
    call: Expr.MethodCall{receiver: sema_app_remote_ident(value_name, span), method: key_method.name, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: reads, id: AST_NODE_GENERATED}
    statements.push(Stmt.Expr{expr: Expr.Ok{value: call, span: span, id: AST_NODE_GENERATED}})
    sema_app_mount_callback(args_name, statements, sema_app_mux_param_type(mux, "__webhook", 3, span, environment, program, diagnostics), span, environment, program, scopes, state, tail_store, context, diagnostics)
}

// The type of parameter `index` of the App's registration method `name`.
sema_app_mux_param_type: fn(mux: TExpr, name: String, index: Int, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> Type {
    graph: program.registration_graph ?? panic("an App registration has no registration graph")
    candidates := sema_expr_registration_method_candidates(graph, environment.module_identity, mux.ty, name, [Type]{}, [Type]{}, span, environment, program, diagnostics)
    candidate: candidates.pop() ?? panic("App.{name} is not registered")
    params: sema_call_params_from_type_after(candidate.signature, candidate.receiver_offset) ?? panic("App.{name} has no parameter list")
    declared: params[index].ty ?? panic("App.{name}'s parameter {index} has no type")
    sema_call_resolved_type(declared, environment, program)
}

// The checked callback, of type `answer_type`, that runs the mounted value
// `value_name`'s method `method` on a call's arguments: it decodes each
// argument from the call's JSON array in turn, runs the method, and gives its
// encoded reply.
sema_app_mount_answer: fn(value_name: String, method: Func, method_module: ModuleID, answer_type: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TCallArg? {
    graph: program.registration_graph ?? return None
    args_name: "__jet_http_mount_args_{span.start}"
    statements := [Stmt]{}
    reads := [CallArg]{}
    loop index in 1..<method.params.len() {
        local_name: "{args_name}_{index}"
        decoded: Expr.MethodCall{receiver: sema_app_remote_ident(args_name, span), method: "__take", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{sema_type_resolve_declared(graph, method.params[index].ty, method_module)}, args: [CallArg]{sema_http_mount_arg(Expr.Int{value: index - 1, span: span, width: None, raw: None, id: AST_NODE_GENERATED}, span)}, id: AST_NODE_GENERATED}
        statements.push(Stmt.Val{binding: ast_binding(local_name, span, false, decoded, None)})
        reads.push(sema_http_mount_arg(sema_app_remote_ident(local_name, span), span))
    }
    invocation: Expr.MethodCall{receiver: sema_app_remote_ident(value_name, span), method: method.name, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: reads, id: AST_NODE_GENERATED}
    declared_return: sema_type_resolve_declared(graph, method.return_type ?? Type.Named{name: "Unit"}, method_module)
    // A method that can fail replies with its error: `value: method(...) ??
    // return Ok(args.__reply_err<E>(err))`; then `Ok(args.__reply_value<R>(value))`.
    replied: "{args_name}_value"
    reply_type: if {
        declared_return == .Result(ok, err) -> {
            failed: Expr.MethodCall{receiver: sema_app_remote_ident(args_name, span), method: "__reply_err", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{err}, args: [CallArg]{sema_http_mount_arg(sema_app_remote_ident("err", span), span)}, id: AST_NODE_GENERATED}
            settled: Expr.OrFallback{value: invocation, fallback: OrFallback.Return{value: Val(Expr.Ok{value: failed, span: span, id: AST_NODE_GENERATED}), span: span}, is_option: false, span: span, id: AST_NODE_GENERATED}
            statements.push(Stmt.Val{binding: ast_binding(replied, span, false, settled, None)})
            ok
        }
        else -> {
            statements.push(Stmt.Val{binding: ast_binding(replied, span, false, invocation, None)})
            declared_return
        }
    }
    statements.push(Stmt.Expr{expr: Expr.Ok{value: Expr.MethodCall{receiver: sema_app_remote_ident(args_name, span), method: "__reply_value", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{reply_type}, args: [CallArg]{sema_http_mount_arg(sema_app_remote_ident(replied, span), span)}, id: AST_NODE_GENERATED}, span: span, id: AST_NODE_GENERATED}})
    sema_app_mount_callback(args_name, statements, answer_type, span, environment, program, scopes, state, tail_store, context, diagnostics)
}

// The lambda of one parameter `args_name` running `statements`, checked as
// the escaping callback type `callback_type` an App registration takes.
sema_app_mount_callback: fn(args_name: String, statements: [Stmt], callback_type: Type, span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TCallArg? {
    handler: Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: [LambdaParam]{LambdaParam{name: args_name, name_span: span, ty: None, ty_span: None, convention: AccessConvention.Read}}, effects: None, body: LambdaBody.Block{body: statements}, span: span, meta: ast_empty_lambda_meta()}, id: AST_NODE_GENERATED}
    callback_arg := sema_http_mount_arg(handler, span)
    callback: sema_check_expression_with_lambda_escapes(callback_arg.expr, Val(callback_type), environment, program, scopes, state, tail_store, context, Val(true), diagnostics) ?? return None
    if !sema_call_http_check_middleware_callback(callback, environment, program, scopes, state, context, diagnostics) {
        return None
    }
    callback_arg.convention = AccessConvention.Move
    Val(sema_call_http_static_tree_arg(callback, callback_arg))
}

// The window an endpoint marker's `per:` defaults to: one minute.
SEMA_APP_LIMIT_WINDOW_NS: 60000000000

// An endpoint marker's rate limit as the two arguments `__remote_public`
// and `__remote_signed_in` take: its `limit:` (0, no limit, when unwritten)
// and its `per:` window in nanoseconds (`per.ns`), each checked as an Int.
sema_app_endpoint_limit: fn(marker: Marker, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> [TCallArg]? {
    span: marker.span
    calls := Expr.Int{value: 0, span: span, width: None, raw: None, id: AST_NODE_GENERATED}
    window := Expr.Int{value: SEMA_APP_LIMIT_WINDOW_NS, span: span, width: None, raw: None, id: AST_NODE_GENERATED}
    loop (index, argument) in marker.args {
        written: if argument == .Expr(value) -> value.copy() else -> next
        // The first argument is `limit:` and the rest `per:` unless labeled.
        per := index != 0
        if index < marker.arg_labels.len() {
            if marker.arg_labels[index] == .Val(named) {
                if named.name != "limit" && named.name != "per" -> next
                per = named.name == "per"
            }
        }
        if per {
            window = Expr.Field{base: written, member: "ns", span: expr_span(written), id: AST_NODE_GENERATED}
        } else { calls = written }
    }
    args := [TCallArg]{}
    written: [Expr]{calls, window}
    loop expression in written {
        value: sema_check_expression(expression, Val(Type.Int), environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        args.push(sema_call_http_static_tree_arg(value, sema_http_mount_arg(expression, expr_span(expression))))
    }
    Val(args)
}

// A mount prefix as it leads each mounted path: no trailing slash, so `/api`
// and `/api/` both mount `#Get("/orders")` at `/api/orders`.
sema_http_mount_prefix: fn(text: String) -> String Never! {
    end := text.len()
    loop end > 0 && text.slice(end - 1, end) == "/" -> end -= 1
    text.slice(0, end)
}

sema_http_collect_mounted: fn(tree: BodyTree, expression: Int, graph: SemaRegistrationGraph, module_identity: ModuleID, mounted: &[SymbolID]) Never! {
    node: body_node(tree, expression)
    if node.kind == .InlineBlock(body) {
        loop statement in body {
            if tree.stmts[statement] == .Let(local, _, init, _, _, _) {
                if !local.name.starts_with("__jet_http_mount_value_") -> next
                row: sema_type_resolve_nominal_row(graph, body_type(tree, init), module_identity) ?? next
                id: graph.modules[row.module_index].nominals[row.row].symbol.id
                if !mounted.contains(id) -> mounted.push(id.copy())
            }
        }
    }
    body_each_expr_child(tree, node, fn(child: Int) { sema_http_collect_mounted(tree, child, graph, module_identity, mounted) })
}

// One function body's mounts. Its own function so the visitor closure lends
// the `mounted` write parameter: the stage-0 Rust tier then lends `graph` to the
// closure instead of copying the whole registration graph per function.
sema_http_collect_mounted_body: fn(function: FnBody, graph: SemaRegistrationGraph, identity: ModuleID, mounted: &[SymbolID]) Never! {
    loop statement in function.body {
        body_each_stmt_child(function.tree, function.tree.stmts[statement], fn(expression: Int) { sema_http_collect_mounted(function.tree, expression, graph, identity, mounted) })
    }
}

// Whether any nominal declares a method with a core.http.server route marker.
sema_http_has_route_method: fn(graph: SemaRegistrationGraph) -> Bool {
    loop module_row_index in 0..<graph.modules.len() {
        loop nominal_index in 0..<graph.modules[module_row_index].nominals.len() {
            loop method_index in 0..<graph.modules[module_row_index].nominals[nominal_index].methods.len() {
                loop marker_index in 0..<graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers.len() {
                    if sema_http_route_marker_verb(graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers[marker_index], graph, graph.modules[module_row_index].module_identity) != None {
                        return true
                    }
                }
            }
        }
    }
    false
}

sema_http_unmounted_warnings: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult]) -> [Diagnostic] {
    // Only a route method can be unmounted: a program without one skips the
    // walk of every checked function body for mounts.
    if !sema_http_has_route_method(graph) -> return [Diagnostic]{}
    mounted := [SymbolID]{}
    loop module_row in modules {
        identity: module_row.module_identity
        loop function in module_row.functions {
            sema_http_collect_mounted_body(function, graph, identity, mounted)
        }
    }
    diagnostics := [Diagnostic]{}
    loop module_row_index in 0..<graph.modules.len() {
        diagnostic_start: diagnostics.len()
        loop nominal_index in 0..<graph.modules[module_row_index].nominals.len() {
            if mounted.contains(graph.modules[module_row_index].nominals[nominal_index].symbol.id) {
                next
            }
            loop method_index in 0..<graph.modules[module_row_index].nominals[nominal_index].methods.len() {
                loop marker_index in 0..<graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers.len() {
                    if sema_http_route_marker_verb(graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers[marker_index], graph, graph.modules[module_row_index].module_identity) == None {
                        next
                    }
                    diagnostics.push(
                        sema_lint(
                            "E2818",
                            graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers[marker_index].span,
                            "HTTP route method `{graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.name}` belongs to a struct that is never mounted.",
                            "Route markers record facts; only an explicit app.mount(value) exposes that struct's routes.",
                            "Pass a value of `{graph.modules[module_row_index].nominals[nominal_index].symbol.name}` to app.mount, or remove the route marker.",
                        ),
                    )
                }
            }
        }
        sema_attach_diagnostic_source_locations(diagnostics, diagnostic_start, graph.modules[module_row_index].source_segments)
    }
    diagnostics
}
