// Mounting reflects one explicit struct value and
// expands to ordinary checked registrations. No backend discovers routes.
use jet_foundation.[
    AST_NODE_GENERATED,
    AccessConvention,
    BodyTree,
    CallArg,
    Diagnostic,
    Expr,
    FnBody,
    Func,
    Lambda,
    LambdaBody,
    LambdaParam,
    Marker,
    NamedSpan,
    Span,
    StrPart,
    Symbol,
    SymbolKind,
    TLetTy,
    Type,
    ast_binding,
    ast_empty_call_arg_flags,
    ast_empty_lambda_meta,
    body_each_expr_child,
    body_each_stmt_child,
    body_node,
    body_type,
    expr_span,
    symbol_key_text,
    symbol_table_key,
    diagnostic_registry_row,
    checked_symbol_local,
    type_name,
    ModuleID,
]

sema_http_route_marker_verb: fn(marker: Marker, graph: SemaRegistrationGraph, module_identity: ModuleID) -> String? {
    if marker.negated -> return None
    resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
    if resolved.status != "found" -> return None
    declaration: resolved.declaration ?? return None
    module_index: sema_registration_module_index(graph, resolved.declaring_module_identity) ?? return None
    if graph.modules[module_index].module_name != "core.http.server" -> return None
    // A route marker is named for its `Method` case: `#Get` registers `get`,
    // and `#Custom(token, path)` the custom method `token`.
    verb: declaration.name.lower()
    if verb != sema_http_route_custom_verb() && !sema_http_route_verbs().contains(verb) -> return None
    Val(verb)
}

// The Core module that declares the app endpoint markers (`use app`), and
// their names: a method marked `#App.SignedIn` or `#App.Public` is an
// endpoint.
SEMA_APP_MARKER_MODULE: "app"
SEMA_APP_ENDPOINT_MARKERS: [String]{"SignedIn", "Public"}

// Whether `marker`, written in module `module_identity`, is one of the app
// module's endpoint markers.
sema_app_endpoint_marker: fn(marker: Marker, graph: SemaRegistrationGraph, module_identity: ModuleID) -> Bool {
    if marker.negated -> return false
    resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
    if resolved.status != "found" -> return false
    declaration: resolved.declaration ?? return false
    module_index: sema_registration_module_index(graph, resolved.declaring_module_identity) ?? return false
    graph.modules[module_index].module_name == SEMA_APP_MARKER_MODULE && SEMA_APP_ENDPOINT_MARKERS.contains(declaration.name)
}

// The marker that makes method `func` an endpoint, written in module
// `module_identity`, as written (`#App.SignedIn`,
// `#Server.Get("/orders/:id")`), for `jet inspect choices`
// (FnBody.endpoint); "" when no app endpoint marker or route marker marks
// it. An argument that is no plain String literal shows as `…`.
sema_function_endpoint: fn(func: Func, graph: SemaRegistrationGraph, module_identity: ModuleID) -> String {
    loop marker in func.markers {
        if !sema_app_endpoint_marker(marker, graph, module_identity) && sema_http_route_marker_verb(marker, graph, module_identity) == None -> next
        if marker.args.len() == 0 -> return "#{marker.name}"
        args := [String]{}
        loop argument in marker.args {
            text := "…"
            if argument == .Expr(value) {
                if value == .Str(parts, _, _) {
                    if parts.len() == 1 {
                        if parts[0] == .Lit(literal) -> text = "\"{literal}\""
                    }
                }
            }
            args.push(text)
        }
        return "#{marker.name}({args.join(", ")})"
    }
    ""
}

// `app.Remote<S>`, the app module's client of a service, and its private
// field that holds the service.
SEMA_APP_REMOTE: "Remote"
SEMA_APP_REMOTE_SERVICE: "service"

// Whether `ty`, a resolved type of one type argument, is `app.Remote<S>`.
sema_app_is_remote: fn(ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables) -> Bool {
    graph: program.registration_graph ?? return false
    row: sema_type_resolve_nominal_row(graph, ty, environment.module_identity) ?? return false
    graph.modules[row.module_index].module_name == SEMA_APP_MARKER_MODULE && graph.modules[row.module_index].nominals[row.row].symbol.name == SEMA_APP_REMOTE
}

// `remote.method(args…)` on an `app.Remote<S>`. A method of `S` that
// `#App.SignedIn` or `#App.Public` marks checks as that method called on the
// Remote's service. Any other method of `S` is server-only (E2812), and a
// name `S` does not declare is no method of the Remote (E0102).
sema_call_app_remote_method: fn(receiver: Expr, receiver_value: TExpr, service: Type, method: String, method_span: Span, owner_type_args: [Type], type_args: [Type], args: [CallArg], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    graph: program.registration_graph ?? return None
    shown := "app.Remote<{type_name(service)}>"
    declared := false
    endpoint := false
    if sema_type_resolve_nominal_row(graph, service, environment.module_identity) == .Val(row) {
        shown = "app.Remote<{graph.modules[row.module_index].nominals[row.row].symbol.name}>"
        if sema_http_route_find_struct(environment, program, service, environment.module_identity) == .Val(definition) {
            loop declaration in definition.methods {
                if declaration.name != method -> next
                declared = true
                loop marker in declaration.markers {
                    if sema_app_endpoint_marker(marker, graph, graph.modules[row.module_index].module_identity) -> endpoint = true
                }
            }
        }
    }
    if !endpoint {
        if {
            declared -> {
                entry: diagnostic_registry_row("E2812") ?? panic("E2812 must have a registry row")
                diagnostics.push(sema_error("E2812", method_span, entry.what.replace("{{remote}}", shown).replace("{{method}}", method), entry.why, entry.fix.replace("{{method}}", method)))
            }
            else -> diagnostics.push(sema_error("E0102", method_span, "`{shown}` has no method `{method}`", "`{shown}` offers only the methods of its service that `#App.SignedIn` or `#App.Public` marks", "call a marked method of the service"))
        }
        sema_data_check_discarded_arguments(args, environment, program, scopes, state, tail_store, context, diagnostics)
        return None
    }
    // The service is the Remote's private field, which only this call reads.
    generated: context.compiler_generated
    context.compiler_generated = true
    service_value: sema_expression_field_checked(receiver_value, SEMA_APP_REMOTE_SERVICE, expr_span(receiver), None, environment, program, scopes, context, diagnostics)
    context.compiler_generated = generated
    value: service_value ?? return None
    place: Expr.Field{base: receiver, member: SEMA_APP_REMOTE_SERVICE, span: expr_span(receiver), id: AST_NODE_GENERATED}
    sema_expr_check_declared_method(place, value, method, method, method_span, owner_type_args, type_args, args, expected, environment, program, scopes, state, tail_store, context, diagnostics)
}

// The module that declares the web markers. The web rules key on its
// markers (`#RouteTable` on App, `#Form` on a form model, `#ColumnOf` on
// table.column's name), never on another module's same-named ones; its
// submodules declare theirs.
SEMA_WEB_MARKER_MODULE: "core.web"
SEMA_WEB_MARKER_ROUTE_TABLE: "RouteTable"
SEMA_WEB_MARKER_FORM: "Form"
SEMA_WEB_MARKER_COLUMN_OF: "ColumnOf"

// Whether `marker`, written in the module `module_identity`, is the web
// module's marker `name`.
sema_web_marker_is: fn(marker: Marker, graph: SemaRegistrationGraph, module_identity: ModuleID, name: String) -> Bool {
    if marker.negated || (marker.name != name && !marker.name.ends_with(".{name}")) -> return false
    resolved: sema_marker_module_resolve_application(graph, module_identity, marker)
    if resolved.status != "found" -> return false
    declaration: resolved.declaration ?? return false
    module_index: sema_registration_module_index(graph, resolved.declaring_module_identity) ?? return false
    declaring: graph.modules[module_index].module_name
    (declaring == SEMA_WEB_MARKER_MODULE || declaring.starts_with("{SEMA_WEB_MARKER_MODULE}.")) && declaration.name == name
}

// The index of the parameter of the function `key` that carries the web
// marker `name`. A parameter's marker is an applied rule of its module at
// the Parameter site, written ahead of the parameter's name; it belongs to
// the parameter whose name it precedes, after the previous parameter's type.
sema_web_param_marker: fn(graph: SemaRegistrationGraph, key: String, name: String) -> Int? {
    row: sema_registration_callable_row(graph, key) ?? return None
    if row == {
        .Function(module_index, index) -> {
            loop application in graph.modules[module_index].program.applied_rules {
                if application.site != (Val(RuleSite.Parameter)) -> next
                target: application.target ?? next
                if !sema_web_marker_is(application.marker, graph, graph.modules[module_index].module_identity, name) -> next
                if sema_web_param_at(graph.modules[module_index].functions[index].declaration, target) == .Val(param) -> return Val(param)
            }
            None
        }
        .Foreign(_, _) | .NominalMethod(_, _, _) | .ImplMethod(_, _, _) -> None
    }
}

sema_web_param_at: fn(function: Func, target: Span) -> Int? Never! {
    start := function.name_span.end
    loop param_index in 0..<function.params.len() {
        if target.start >= start && target.end <= function.params[param_index].name_span.start -> return Val(param_index)
        start = function.params[param_index].ty_span.end
    }
    None
}

sema_http_mount_arg: fn(expression: Expr, span: Span) -> CallArg Never! {
    CallArg{convention: AccessConvention.Read, expr: expression, span: span,
        flags: ast_empty_call_arg_flags(), label: None, spread: false}
}

// `app.mount(value)` and `app.mount(prefix, value)`: each marked method of
// the struct value registers as the single route its marker names, under the
// static `prefix` when there is one; the call is the App, so it chains.
sema_call_http_mount: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if args.len() != 1 && args.len() != 2 {
        diagnostics.push(sema_call_arity_diagnostic("mount", 2, args.len(), false, span))
        return SemaMethodSpecialCheck{handled: true, value: None}
    }
    prefix := ""
    if args.len() == 2 {
        text: sema_http_route_constant_string(args[0].expr, environment, program, scopes) ?? {
            diagnostics.push(sema_error("E2805", args[0].span, "app.mount prefix must be a static String", "a mounted struct's routes are fully checked while building, prefix included", "use a literal or compile-time String constant"))
            return SemaMethodSpecialCheck{handled: true, value: None}
        }
        prefix = sema_http_mount_prefix(text)
    }
    value_arg: args[args.len() - 1]
    sema_scope_enter(scopes, state, "http.mount:{span.start}")
    body := [TStmt]{}
    mux_name: "__jet_http_mount_mux_{span.start}"
    owner: sema_scope_local_owner_key(scopes)
    local_module: sema_scope_environment_module_text(environment, program)
    mux_key: symbol_key_text(SymbolKind.Local, local_module, owner, mux_name)
    mux_id: sema_symbol_id_of(program, context, mux_key)
    mux_symbol: Symbol{id: mux_id, kind: SymbolKind.Local, name: mux_name,
        module_identity: environment.module_identity, owner: Val(owner), span: span,
        ty: Val(receiver_value.ty), visibility: 0}
    _ := sema_scope_declare_local(scopes, mux_symbol, mux_key, false, AccessConvention.Read, None, false)
    sema_ownership_declare_binding(state, mux_symbol, mux_key, false)
    mux_local: checked_symbol_local(mux_name, span, mux_id, receiver_value.ty)
    body.push(TStmt.Let{local: mux_local, let_ty: TLetTy.Inferred,
        init: receiver_value, gc_promotion: None, gc_transferred: false, span: span})
    value_name: "__jet_http_mount_value_{span.start}"
    binding: ast_binding(value_name, span, false, value_arg.expr, None)
    checked_binding := sema_stmt_check_binding(binding, None, environment, program, scopes, state, tail_store, context, diagnostics)
    if checked_binding == .Val(statement) {
        body.push(statement)
        binding_index: sema_scope_resolve_index(scopes, value_name) ?? panic("mounted value binding is absent")
        value_ty: scopes.bindings[binding_index].symbol.ty ?? panic("mounted value has no type")
        if sema_http_route_find_struct(environment, program, value_ty, environment.module_identity) == .Val(definition) {
            if program.registration_graph == .Val(graph) {
            nominal_row: sema_type_resolve_nominal_row(graph, value_ty, environment.module_identity) ?? panic("mount has no nominal row")
            method_module: graph.modules[nominal_row.module_index].module_identity
            loop method in definition.methods {
                loop marker in method.markers {
                    verb: sema_http_route_marker_verb(marker, graph, method_module) ?? next
                    if method.params.len() == 0 || method.params[0].name != "self" || method.params[0].convention != AccessConvention.Read || method.type_params.len() != 0 {
                        diagnostics.push(sema_error("E2805", marker.span, "HTTP route method `{method.name}` needs read-only self and a concrete signature", "mounted handlers retain shared state and are called on request workers", "write `{method.name}: fn(self, ...)` without method type parameters; use Shared<T> for mutable shared state"))
                        next
                    }
                    // `#Custom` takes its method token before the path.
                    marked := [CallArg]{}
                    loop mark_arg in marker.args {
                        if mark_arg == .Expr(mark_value) -> marked.push(sema_http_mount_arg(mark_value, expr_span(mark_value)))
                    }
                    custom: verb == sema_http_route_custom_verb()
                    marked_count: if custom -> 2 else -> 1
                    if marker.args.len() != marked_count || marked.len() != marked_count -> next
                    if custom && sema_http_route_constant_string(marked[0].expr, environment, program, scopes) == None {
                        diagnostics.push(sema_error("E2808", marked[0].span, "`#Server.Custom` route method must be a static String", "a marked route is fully checked while building; only `app.custom` takes a run-time method, checked when it registers", "use a literal or compile-time String constant, or register the route with `app.custom`"))
                        next
                    }
                    if prefix != "" {
                        path_at: marked_count - 1
                        path: sema_http_route_constant_string(marked[path_at].expr, environment, program, scopes) ?? {
                            diagnostics.push(sema_error("E2805", marked[path_at].span, "a route marker under a mount prefix needs a static path", "the mounted route's address is the prefix and the marker's path, checked while building", "use a literal or compile-time String constant"))
                            next
                        }
                        marked[path_at] = sema_http_mount_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: "{prefix}{path}"}}, span: marked[path_at].span, id: AST_NODE_GENERATED}, marked[path_at].span)
                    }
                    params := [LambdaParam]{}
                    call_args := [CallArg]{}
                    loop index in 1..<method.params.len() {
                        parameter_ty: sema_type_resolve_declared(graph, method.params[index].ty, method_module)
                        params.push(LambdaParam{name: method.params[index].name, name_span: method.params[index].name_span, ty: Val(parameter_ty), ty_span: None, convention: AccessConvention.Read})
                        argument := sema_http_mount_arg(Expr.Ident{name: method.params[index].name, span: method.params[index].name_span, id: AST_NODE_GENERATED}, method.params[index].name_span)
                        argument.convention = method.params[index].convention
                        call_args.push(argument)
                    }
                    invocation: Expr.MethodCall{receiver: Expr.Ident{name: value_name, span: span, id: AST_NODE_GENERATED}, method: method.name, method_span: method.name_span, owner_type_args: [Type]{}, type_args: [Type]{}, args: call_args, id: AST_NODE_GENERATED}
                    meta := ast_empty_lambda_meta()
                    nominal: graph.modules[nominal_row.module_index].nominals[nominal_row.row]
                    loop registered in nominal.methods {
                        if registered.declaration.name == method.name -> meta.http_route_source = Val(symbol_table_key(graph.symbols, registered.symbol.id))
                    }
                    handler: Expr.Lambda{lambda: Lambda{take_names: [NamedSpan]{}, params: params, effects: None, body: LambdaBody.Expr{value: invocation}, span: marker.span, meta: meta}, id: AST_NODE_GENERATED}
                    marked.push(sema_http_mount_arg(handler, marker.span))
                    registration: sema_call_try_http_router(receiver, sema_tree_node(receiver_value.ty, TExprKind.Local{local: mux_local}, span), verb, marked, marker.span, None, environment, program, scopes, state, tail_store, context, diagnostics)
                    if registration.value == .Val(value) -> body.push(TStmt.ExprStmt{value: value, span: marker.span})
                }
            }
            } else {
                panic("mount has no registration graph")
            }
        } else {
            diagnostics.push(sema_error("E2805", value_arg.span, "app.mount needs an ordinary struct, not `{type_name(value_ty)}`", "only the explicitly mounted struct's tagged methods contribute routes", "pass a struct value with #Server.Get or another core.http.server verb marker"))
        }
    }
    // The block's value is the App, so `app.mount(value)` chains.
    body.push(TStmt.ExprStmt{value: sema_tree_node(receiver_value.ty, TExprKind.Local{local: mux_local}, span), span: span})
    sema_single_use_leave_scope(scopes, state, diagnostics)
    value: sema_tree_node(receiver_value.ty, TExprKind.InlineBlock{body: body}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

// A mount prefix as it leads each mounted path: no trailing slash, so `/api`
// and `/api/` both mount `#Get("/orders")` at `/api/orders`.
sema_http_mount_prefix: fn(text: String) -> String Never! {
    end := text.len()
    loop end > 0 && text.slice(end - 1, end) == "/" -> end = end - 1
    text.slice(0, end)
}

sema_http_collect_mounted: fn(tree: BodyTree, expression: Int, graph: SemaRegistrationGraph, module_identity: ModuleID, mounted: &[SymbolID]) Never! {
    node: body_node(tree, expression)
    if node.kind == .InlineBlock(body) {
        loop statement in body {
            if tree.stmts[statement] == .Let(local, _, init, _, _, _) {
                if !local.name.starts_with("__jet_http_mount_value_") -> next
                row: sema_type_resolve_nominal_row(graph, body_type(tree, init), module_identity) ?? next
                id: graph.modules[row.module_index].nominals[row.row].symbol.id
                if !mounted.contains(id) -> mounted.push(id.copy())
            }
        }
    }
    body_each_expr_child(tree, node, fn(child: Int) { sema_http_collect_mounted(tree, child, graph, module_identity, mounted) })
}

// One function body's mounts. Its own function so the visitor closure lends
// the `mounted` write parameter: the stage-0 Rust tier then lends `graph` to the
// closure instead of copying the whole registration graph per function.
sema_http_collect_mounted_body: fn(function: FnBody, graph: SemaRegistrationGraph, identity: ModuleID, mounted: &[SymbolID]) Never! {
    loop statement in function.body {
        body_each_stmt_child(function.tree, function.tree.stmts[statement], fn(expression: Int) { sema_http_collect_mounted(function.tree, expression, graph, identity, mounted) })
    }
}

// Whether any nominal declares a method with a core.http.server route marker.
sema_http_has_route_method: fn(graph: SemaRegistrationGraph) -> Bool {
    loop module_row_index in 0..<graph.modules.len() {
        loop nominal_index in 0..<graph.modules[module_row_index].nominals.len() {
            loop method_index in 0..<graph.modules[module_row_index].nominals[nominal_index].methods.len() {
                loop marker_index in 0..<graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers.len() {
                    if sema_http_route_marker_verb(graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers[marker_index], graph, graph.modules[module_row_index].module_identity) != None -> return true
                }
            }
        }
    }
    false
}

sema_http_unmounted_warnings: fn(graph: SemaRegistrationGraph, modules: [SemaGraphModuleResult]) -> [Diagnostic] {
    // Only a route method can be unmounted: a program without one skips the
    // walk of every checked function body for mounts.
    if !sema_http_has_route_method(graph) -> return [Diagnostic]{}
    mounted := [SymbolID]{}
    loop module_row in modules {
        identity: module_row.module_identity
        loop function in module_row.functions -> sema_http_collect_mounted_body(function, graph, identity, mounted)
    }
    diagnostics := [Diagnostic]{}
    loop module_row_index in 0..<graph.modules.len() {
        diagnostic_start: diagnostics.len()
        loop nominal_index in 0..<graph.modules[module_row_index].nominals.len() {
            if mounted.contains(graph.modules[module_row_index].nominals[nominal_index].symbol.id) -> next
            loop method_index in 0..<graph.modules[module_row_index].nominals[nominal_index].methods.len() {
                loop marker_index in 0..<graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers.len() {
                    if sema_http_route_marker_verb(graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers[marker_index], graph, graph.modules[module_row_index].module_identity) == None -> next
                    diagnostics.push(sema_lint("E2818", graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.markers[marker_index].span,
                        "HTTP route method `{graph.modules[module_row_index].nominals[nominal_index].methods[method_index].declaration.name}` belongs to a struct that is never mounted.",
                        "Route markers record facts; only an explicit app.mount(value) exposes that struct's routes.",
                        "Pass a value of `{graph.modules[module_row_index].nominals[nominal_index].symbol.name}` to app.mount, or remove the route marker."))
                }
            }
        }
        sema_attach_diagnostic_source_locations(diagnostics, diagnostic_start, graph.modules[module_row_index].source_segments)
    }
    diagnostics
}
