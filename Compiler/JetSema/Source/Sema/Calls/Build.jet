// Exact compiler-value contract::build_context_method_*. This table is
// arity-polymorphic; Core owns the session semantics, not sema.
use {
    jet_foundation.[AST_NODE_GENERATED, AccessConvention, BuildOptionKind, BuildOptionRow, Call, CallArg, CtValue, DeriveBodyItem, Diagnostic, EffectRowEntry, Expr, Item, NamedCtValue, ParamZone, Span, Stmt, SymbolKind, TComptimeField, TComptimeValue, Type, ast_empty_call_arg_flags, ast_func, ast_program, build_option_accepts, build_option_argument, build_option_duration_ms, build_option_list_value, build_option_method_values, build_option_refusal, build_option_row, build_option_value_of_variant, build_option_variants_text, diagnostic_registry_row, type_name]
    jet_parser.[jfmt_format_program_with_tokens]
    jet_lexer.[Token]
}

SemaBuildContextMethodContract: struct {
    parameters: [Type]
    result: Type
}

sema_build_result: fn(name: String) -> Type Never! {
    Type.Result{ok: Type.Named{name: name}, err: Type.Named{name: "BuildError"}}
}

sema_build_context_method_contract: fn(method: String, arity: Int) -> SemaBuildContextMethodContract? {
    strings: Type.List{element: Type.String}
    action: Type.Named{name: "BuildAction"}
    target: Type.Named{name: "BuildTarget"}
    toolchain: Type.Named{name: "BuildToolchain"}
    signing: Type.Named{name: "BuildSigningIdentity"}
    probes: Type.List{element: Type.Named{name: "BuildProbe"}}
    parameters := [Type]{}
    result := Type.Named{name: "Unit"}
    if {
        method == "generate" && arity == 2 -> {
            parameters = [Type]{Type.String}
            result = sema_build_result("Unit")
        }
        method == "plugin" && arity == 2 -> {
            parameters = [Type]{Type.String, Type.String}
            result = sema_build_result("Unit")
        }
        method == "contribute" && arity == 2 -> parameters = [Type]{Type.String}
        method == "run" && arity == 3 -> {
            parameters = [Type]{Type.String, Type.Named{name: "BuildFile"}, strings}
            result = sema_build_result("BuildAction")
        }
        method == "found" && arity == 1 -> {
            parameters = [Type]{Type.Named{name: "BuildProbe"}}
            result = Type.Named{name: "BuildFile"}
        }
        (method == "host" || method == "image") && arity == 1 -> {
            parameters = [Type]{target}
            result = Type.Named{name: "BuildFile"}
        }
        method == "jet" && arity == 0 -> result = Type.Named{name: "BuildFile"}
        (method == "dependency" || method == "folder") && arity == 1 -> {
            parameters = [Type]{Type.String}
            result = Type.Named{name: "BuildFile"}
        }
        sema_build_context_target_method(method) && arity >= 3 && arity <= 7 -> {
            parameters = [Type]{Type.String, strings, Type.List{element: action}}
            trailing: [Type]{Type.List{element: target}, probes, toolchain, signing}
            loop index in 0..<arity - 3 -> parameters.push(trailing[index])
            result = sema_build_result("BuildTarget")
        }
        method == "toolchain" && arity >= 2 && arity <= 6 -> {
            loop _ in 0..<arity -> parameters.push(Type.String)
            result = sema_build_result("BuildToolchain")
        }
        method == "signing" && arity == 2 -> {
            parameters = [Type]{Type.String, Type.String}
            result = sema_build_result("BuildSigningIdentity")
        }
        method == "probe" && arity >= 3 && arity <= 6 -> {
            parameters = [Type]{Type.String, Type.String, Type.String}
            if arity == 6 {
                parameters.push(Type.String)
                parameters.push(Type.String)
                parameters.push(toolchain)
            } else {
                union: Type.Union{members: [Type]{Type.String, toolchain}}
                loop _ in 3..<arity -> parameters.push(union.copy())
            }
            result = sema_build_result("BuildProbe")
        }
        method == "error" && arity == 5 -> parameters = [Type]{Type.Named{name: "SourceSpan"}, Type.String, Type.String, Type.String, Type.String}
        method == "default" && arity == 1 -> parameters = [Type]{target}
        // The root-only `Compiler` value for one target (sema_build_compiler_site).
        method == "compiler" && arity == 1 -> {
            parameters = [Type]{target}
            result = Type.Named{name: "Compiler"}
        }
        method == "args" && arity == 0 -> result = strings
        method == "plan" && (arity == 0 || arity == 1) -> {
            if arity == 1 -> parameters.push(target)
            result = sema_build_result("BuildPlan")
        }
        else -> return None
    }
    Val(SemaBuildContextMethodContract{parameters: parameters, result: result})
}

sema_build_context_target_method: fn(method: String) -> Bool Never! {
    method == "add_executable" || method == "add_library" || method == "add_test" || method == "add_asset_bundle" || method == "add_doc" || method == "add_install" || method == "add_package" || method == "add_publish"
}

sema_build_context_arity_description: fn(method: String) -> String Never! {
    if sema_build_context_target_method(method) -> return "3 to 7"
    if method == "toolchain" -> return "2 to 6"
    if method == "probe" -> return "3 to 6"
    if method == "plan" -> return "0 or 1"
    if method == "default" || method == "compiler" || method == "found" || method == "host" || method == "image" || method == "dependency" || method == "folder" -> return "1"
    if method == "run" -> return "3"
    if method == "args" || method == "jet" -> return "0"
    if method == "error" -> return "5"
    "2"
}

// Whether `method` is a `Build` method at some arity (every one takes at
// most seven arguments).
sema_build_context_method_known: fn(method: String) -> Bool Never! {
    loop arity in 0..<8 {
        if sema_build_context_method_contract(method, arity) != None -> return true
    }
    false
}

sema_call_try_build_context_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if receiver_value.ty != (Type.Named{name: "Build"}) -> return SemaMethodSpecialCheck{handled: false, value: None}
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    if build_option_refusal(method) == .Val(refusal) {
        diagnostics.push(sema_error("E3502", span, "`b.{method}` isn't a build option", refusal.law, "remove the `b.{method}` call"))
        return failed
    }
    if method == "pin" || build_option_row(method) != None -> return sema_call_build_option(receiver, receiver_value, method, args, span, expected, environment, program, scopes, state, diagnostics)
    contract: sema_build_context_method_contract(method, args.len()) ?? {
        loop argument in args {
            if argument.flags.template_items == None -> _ := sema_check_expression(argument.expr, None, environment, program, scopes, state, tail_store, context, diagnostics)
        }
        if !sema_build_context_method_known(method) {
            diagnostics.push(sema_error("E0102", span, "`Build` has no method `{method}`", "`Build` is a protected Core type with a closed method surface", "use a documented method on `Build`"))
            return failed
        }
        diagnostics.push(sema_error("E0104", span, "`Build.{method}` expects {sema_build_context_arity_description(method)} arguments, got {args.len()}", "build methods have one canonical base shape and typed trailing controls", "pass the arguments accepted by `b.{method}`"))
        return failed
    }
    template_count := 0
    loop argument in args {
        if argument.flags.template_items != None -> template_count += 1
    }
    if method == "generate" && template_count != 1 {
        diagnostics.push(sema_error("E3502", span, "`b.generate` requires a name followed by a typed item block", "generated bodies are Jet items checked by the ordinary semantic path", "write `b.generate(\"name\") {{ ... }}?`"))
        return failed
    }
    if method != "generate" && template_count > 0 -> return failed
    if method == "compiler" && !sema_build_compiler_site(environment, span, diagnostics) -> return failed
    values := [TExpr]{}
    params := [SemaCallParam]{}
    ordinary := [CallArg]{}
    loop argument in args {
        if argument.flags.template_items != None -> next
        ordinary.push(argument.copy())
        required := Type?{None}
        if ordinary.len() <= contract.parameters.len() -> required = Val(contract.parameters[ordinary.len() - 1])
        value: sema_check_expression(argument.expr, required, environment, program, scopes, state, tail_store, context, diagnostics) ?? return failed
        if required == .Val(ty) {
            compatible: sema_call_type_assignable(ty, value.ty, environment, program) ?? return failed
            if !compatible {
                diagnostics.push(sema_type_mismatch(ty, value.ty, argument.span))
                return failed
            }
        }
        if argument.label != None || argument.spread {
            diagnostics.push(sema_error("E0764", argument.span, "`Build.{method}` takes positional arguments", "the build method contract does not declare labels or variadic slots", "remove the label or spread from this argument"))
            return failed
        }
        values.push(value.copy())
        params.push(SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(value.ty), variadic: false})
    }
    // `b.generate` sends its formatted items, then a (marker, value) pair per
    // build local the template splices; the locals are read like arguments.
    generated := [TExpr]{}
    if method == "generate" {
        loop argument in args {
            body: argument.flags.template_items ?? next
            splices: sema_build_generate_splices(body, argument.span, environment, program, scopes, state, tail_store, context, diagnostics) ?? return failed
            generated.push(sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: splices.source}}}, argument.span))
            loop index in 0..<splices.markers.len() {
                generated.push(sema_tree_node(Type.Int, TExprKind.IntLit{value: splices.markers[index], width: None}, argument.span))
                generated.push(splices.values[index].copy())
                ordinary.push(splices.args[index].copy())
                params.push(SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(splices.values[index].ty), variadic: false})
            }
        }
    }
    ownership: sema_ownership_check_method_call(state, "Build.{method}", receiver, AccessConvention.Read, params, ordinary, scopes, span, diagnostics)
    if !ownership.accepted || !ownership.complete -> return failed
    loop value in generated -> values.push(value.copy())
    value: sema_tree_node(contract.result, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: method, args: values}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

// Only the root package's own build source makes the `Compiler` value: a
// `b.compiler` call written in any other package is E0776, wherever its
// `Build` came from, so a root that hands its `Build` to a dependency's
// function hands it no compiler control. The root is the package of the
// load's entry module.
sema_build_compiler_site: fn(environment: SemaScopeEnvironment, span: Span, diagnostics: &[Diagnostic]) -> Bool {
    root := ""
    if environment.registration_graph == .Val(graph) {
        if sema_registration_module_index(graph, graph.entry_module_identity) == .Val(entry) -> root = graph.modules[entry].package_identity.copy()
    }
    if root != "" && environment.package_identity == root -> return true
    row: diagnostic_registry_row("E0776") ?? panic("E0776 must have a registry row")
    diagnostics.push(sema_error("E0776", span, row.what, row.why, row.fix))
    false
}

// `#code { items }`: a `Code` value holding its items formatted as source,
// expanded by the same path as a `b.generate` template. The items are
// checked where the value lands, with the program (`meta.add`). A block of
// statements alone is a body (`meta.rewrite_body`): its statements are
// formatted as written, never run as template statements.
sema_build_code_value: fn(call: Call, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> TExpr? {
    body := [DeriveBodyItem]?{None}
    if call.args.len() == 1 -> body = call.args[0].flags.template_items
    items_written: body ?? {
        diagnostics.push(sema_error("E3502", call.name_span, "`#code` needs one item block", "a `Code` value is the items written in its block", "write `#code {{ ... }}`"))
        return None
    }
    statements := [Stmt]{}
    loop written in items_written {
        if written == .Stmt(statement) -> statements.push(statement.copy()) else -> break
    }
    text := ""
    if items_written.len() > 0 && statements.len() == items_written.len() {
        text = sema_build_code_statements(statements)
    } else {
        items: sema_derive_expand_template_body(items_written, [NamedCtValue]{}, diagnostics) ?? return None
        text = sema_build_generate_format(items)
    }
    source: TComptimeField{name: "source", value: TComptimeValue.String{value: text}}
    value: TComptimeValue.Struct{type_name: "Code", fields: [TComptimeField]{source}}
    node: sema_tree_node(Type.Named{name: "Code"}, TExprKind.CtLit{value: value}, Span{start: call.name_span.start, end: call.args[0].span.end})
    sema_expr_expected(node, expected, environment, program, diagnostics)
}

// Statements formatted as a function body's lines, unindented: the formatter
// writes them inside a function, whose first and last lines are dropped.
sema_build_code_statements: fn(statements: [Stmt]) -> String {
    wrapper := ast_func("code", Span{start: 0, end: 0}, Span{start: 0, end: 0})
    wrapper.body = statements.copy()
    lines := sema_build_generate_format([Item]{Item.Func{value: wrapper}}).split("\n").to_list()
    loop lines.len() > 0 && lines[lines.len() - 1].trim() == "" -> _: lines.pop()
    if lines.len() < 2 -> return ""
    text := ""
    loop index in 1..<(lines.len() - 1) {
        line: lines[index]
        body_line: if line.starts_with("    ") -> line.removeprefix("    ") else -> line.copy()
        text = "{text}{body_line}\n"
    }
    text
}

// A call on the root's `Compiler` value. `meta.add(code, scope: name)` adds
// a `Code` value's items as the generated module `name` of the value's
// target, checked with the program like hand-written code (JetBuildSession
// `compiler.add`). `meta.rewrite_body(f, code)` replaces the body of the
// root package's top-level function `f` with a `Code` value's statements
// (JetBuildSession `compiler.rewrite_body`).
sema_call_try_compiler_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    if receiver_value.ty != (Type.Named{name: "Compiler"}) -> return SemaMethodSpecialCheck{handled: false, value: None}
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    if method == "rewrite_body" -> return sema_call_compiler_rewrite_body(receiver, receiver_value, args, span, expected, environment, program, scopes, state, tail_store, context, diagnostics)
    shape: "meta.add(#code {{ ... }}, scope: \"name\")"
    if method != "add" {
        diagnostics.push(sema_error("E0102", span, "`Compiler` has no method `{method}`", "`Compiler` is a protected Core type with a closed method surface", "write `{shape}` or `meta.rewrite_body(f, #code {{ ... }})`"))
        return failed
    }
    code := CallArg?{None}
    scope := CallArg?{None}
    loop argument in args {
        label: if argument.label == .Val(written) -> written.name.copy() else -> ""
        takes: if label == {
            "" -> code == None
            "scope" -> scope == None
            else -> false
        }
        if argument.spread || argument.flags.template_items != None || !takes {
            diagnostics.push(sema_error("E0764", argument.span, "`Compiler.add` doesn't take this argument", "`meta.add` takes one `Code` value and the `scope:` module it joins", "write `{shape}`"))
            return failed
        }
        unlabelled := argument.copy()
        unlabelled.label = None
        if label == "scope" -> scope = Val(unlabelled) else -> code = Val(unlabelled)
    }
    code_arg: code ?? {
        diagnostics.push(sema_error("E0104", span, "`Compiler.add` expects a `Code` value", "`meta.add` adds the items of one `Code` value", "write `{shape}`"))
        return failed
    }
    scope_arg: scope ?? {
        diagnostics.push(sema_error("E0104", span, "`Compiler.add` expects `scope:`", "the added items join the generated module `scope:` names", "write `{shape}`"))
        return failed
    }
    // The session reads the `Code` value, then the scope's String.
    ordinary := [CallArg]{code_arg, scope_arg}
    required_types: [Type]{Type.Named{name: "Code"}, Type.String}
    values := [TExpr]{}
    params := [SemaCallParam]{}
    loop (index, argument) in ordinary {
        required: required_types[index]
        value: sema_check_expression(argument.expr, Val(required), environment, program, scopes, state, tail_store, context, diagnostics) ?? return failed
        compatible: sema_call_type_assignable(required, value.ty, environment, program) ?? return failed
        if !compatible {
            diagnostics.push(sema_type_mismatch(required, value.ty, argument.span))
            return failed
        }
        values.push(value.copy())
        params.push(SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(value.ty), variadic: false})
    }
    ownership: sema_ownership_check_method_call(state, "Compiler.{method}", receiver, AccessConvention.Read, params, ordinary, scopes, span, diagnostics)
    if !ownership.accepted || !ownership.complete -> return failed
    // `meta.add` writes declarations, so it uses `Meta.Generate`: allowed
    // unless the calling function's row denies it.
    if !sema_effect_record_intrinsic_effects(environment, program, scopes, context, "Compiler.{method}", span, [EffectRowEntry]{EffectRowEntry{name: META_GENERATE, span: span}}, diagnostics) -> return failed
    // The session reads the `Code` value, the scope, then the caller.
    values.push(sema_call_compiler_producer(environment, program, scopes, span))
    value: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: method, args: values}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

// `meta.rewrite_body(f, #code { statements })`: `f` names a top-level
// function, sent as its name; the build replaces the body of the root
// package's function of that name (JetDriver BuildQueries.jet), so naming
// it lends nothing and moves nothing. Replacing a body uses `Meta.Rewrite`.
sema_call_compiler_rewrite_body: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    shape: "meta.rewrite_body(f, #code {{ ... }})"
    if args.len() != 2 {
        diagnostics.push(sema_error("E0104", span, "`Compiler.rewrite_body` expects a function and a `Code` value", "`meta.rewrite_body` replaces the body of one function with the statements of one `Code` value", "write `{shape}`"))
        return failed
    }
    loop argument in args {
        if argument.label != None || argument.spread || argument.flags.template_items != None {
            diagnostics.push(sema_error("E0764", argument.span, "`Compiler.rewrite_body` doesn't take this argument", "`meta.rewrite_body` takes a function's name and one `Code` value, both unlabeled", "write `{shape}`"))
            return failed
        }
    }
    function := ""
    if args[0].expr == .Ident(name, _, _) -> function = name.copy()
    // Only a body binding is a local; the root frame holds the module's
    // items and imports.
    local := false
    if function != "" && sema_scope_resolve_index(scopes, function) == .Val(index) -> local = scopes.frames[scopes.bindings[index].frame].parent >= 0
    top_level := false
    if function != "" && !local && program.registration_graph == .Val(graph) {
        if sema_registration_lookup_name(graph, environment.module_identity, function) == .Val(resolved) -> top_level = sema_resolved_kind(graph, resolved) == SymbolKind.Function
    }
    if !top_level {
        diagnostics.push(sema_error("E0764", args[0].span, "`meta.rewrite_body` needs a top-level function's name", "a body rewrite replaces the body of one function the root package declares, named directly", "pass a top-level function, as in `{shape}`"))
        return failed
    }
    ordinary := [CallArg]{args[1].copy()}
    code: sema_check_expression(args[1].expr, Val(Type.Named{name: "Code"}), environment, program, scopes, state, tail_store, context, diagnostics) ?? return failed
    compatible: sema_call_type_assignable(Type.Named{name: "Code"}, code.ty, environment, program) ?? return failed
    if !compatible {
        diagnostics.push(sema_type_mismatch(Type.Named{name: "Code"}, code.ty, args[1].span))
        return failed
    }
    params := [SemaCallParam]{SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(code.ty), variadic: false}}
    ownership: sema_ownership_check_method_call(state, "Compiler.rewrite_body", receiver, AccessConvention.Read, params, ordinary, scopes, span, diagnostics)
    if !ownership.accepted || !ownership.complete -> return failed
    if !sema_effect_record_intrinsic_effects(environment, program, scopes, context, "Compiler.rewrite_body", span, [EffectRowEntry]{EffectRowEntry{name: META_REWRITE, span: span}}, diagnostics) -> return failed
    // The session reads the function's name, the `Code` value, then the caller.
    name: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: function}}}, args[0].span)
    value: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: "rewrite_body", args: [TExpr]{name, code, sema_call_compiler_producer(environment, program, scopes, span)}}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

// The function calling a `Compiler` method and where, "`f` at file:line",
// which a report from what the call made names: it tells the root's own
// build from a dependency's function the root handed the value to.
sema_call_compiler_producer: fn(environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable, span: Span) -> TExpr Never! {
    location: sema_expression_panic_location(environment, program, scopes, span)
    sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "`{location.function}` at {location.file}:{location.line}"}}}, span)
}

// A `b.generate` template's formatted items and the build locals it splices.
// Each `#{name}` naming a build local is formatted as that splice's marker, a
// whole Int literal, which the build host replaces with the local's value
// written as a Jet literal (JetDriver jet_driver_build_host_call).
SemaBuildGenerateSplices: struct {
    source: String
    markers: [Int]
    args: [CallArg]
    values: [TExpr]
}

// The first splice marker, a 19-digit Int; every marker shares the prefix,
// and a template that spells the prefix itself is refused.
SEMA_BUILD_GENERATE_SPLICE_BASE: 4611686018427387000
SEMA_BUILD_GENERATE_SPLICE_PREFIX: "4611686018427387"
SEMA_BUILD_GENERATE_SPLICE_LIMIT: 1000

sema_build_generate_format: fn(items: [Item]) -> String {
    generated_program := ast_program()
    generated_program.items = items
    jfmt_format_program_with_tokens(generated_program, "", [Token]{}, false)
}

// Rust lower_build_generate expands and formats the typed body under an empty
// compile-time scope. A `#{name}` still unbound there that names a build local
// of a literal type is spliced: the body is expanded again with each such
// name bound to its marker, so the marker stands exactly where the value goes.
sema_build_generate_splices: fn(body: [DeriveBodyItem], span: Span, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaBuildGenerateSplices? {
    items: sema_derive_expand_template_body(body, [NamedCtValue]{}, diagnostics) ?? return None
    splices := SemaBuildGenerateSplices{source: sema_build_generate_format(items), markers: [Int]{}, args: [CallArg]{}, values: [TExpr]{}}
    scope := [NamedCtValue]{}
    loop name in sema_build_generate_splice_names(splices.source) {
        if sema_scope_resolve_index(scopes, name) == None -> next
        local: Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
        value: sema_check_expression(local.copy(), None, environment, program, scopes, state, tail_store, context, diagnostics) ?? return None
        if !sema_build_generate_splice_type(value.ty) {
            diagnostics.push(sema_error("E3502", span, "`b.generate` can't splice `#{{{name}}}`, a `{type_name(value.ty)}`", "a build local enters the generated items as a literal, and only String, Int and Bool values and lists of them have one", "splice a String, Int or Bool built from `{name}`"))
            return None
        }
        marker: SEMA_BUILD_GENERATE_SPLICE_BASE + splices.markers.len()
        scope.push(NamedCtValue{name: name, value: CtValue.Int{value: marker}})
        splices.markers.push(marker)
        splices.args.push(CallArg{convention: AccessConvention.Read, expr: local, span: span, flags: ast_empty_call_arg_flags(), label: None, spread: false})
        splices.values.push(value)
    }
    if splices.markers.len() == 0 -> return Val(splices)
    if splices.markers.len() > SEMA_BUILD_GENERATE_SPLICE_LIMIT || splices.source.contains(SEMA_BUILD_GENERATE_SPLICE_PREFIX) {
        diagnostics.push(sema_error("E3502", span, "`b.generate` can't splice build locals into these items", "the items splice more than {SEMA_BUILD_GENERATE_SPLICE_LIMIT} build locals, or already spell the splice marker prefix `{SEMA_BUILD_GENERATE_SPLICE_PREFIX}`", "splice fewer build locals, or write that number another way"))
        return None
    }
    spliced: sema_derive_expand_template_body(body, scope, diagnostics) ?? return None
    splices.source = sema_build_generate_format(spliced)
    Val(splices)
}

// The names of the `#{name}` splices in formatted items, in first-use order.
sema_build_generate_splice_names: fn(text: String) -> [String] Never! {
    names := [String]{}
    bytes: text.bytes()
    index := 0
    loop index + 1 < bytes.len() {
        if (bytes[index] != U8{35}) || (bytes[index + 1] != U8{123}) {
            index += 1
            next
        }
        start: index + 2
        end := start
        loop end < bytes.len() && sema_build_generate_name_byte(bytes[end], end > start) -> end += 1
        if end > start && end < bytes.len() && (bytes[end] == U8{125}) {
            name: String.from_bytes(bytes[start..<end]) ?? ""
            seen := false
            loop known in names {
                if known == name -> seen = true
            }
            if !seen && name.count_bytes() > 0 -> names.push(name)
        }
        index = end
    }
    names
}

sema_build_generate_name_byte: fn(byte: U8, digits: Bool) -> Bool Never! {
    (byte >= U8{97} && byte <= U8{122}) || (byte >= U8{65} && byte <= U8{90}) || byte == U8{95} || (digits && byte >= U8{48} && byte <= U8{57})
}

sema_build_generate_splice_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .String | .Int | .Bool -> true
        .List(element) -> sema_build_generate_splice_type(element)
        .Float | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// The calls on a `b.run` step (BuildAction) and on a BuildFile: each file
// call declares the file and passes its path to the tool at once, and
// `flag:` puts a prefix such as `"--in="` before that path in one argument.
// `kept: true` on an output keeps the file it makes in git.
SemaBuildStepContract: struct {
    parameters: [Type]
    result: Type
    flag: Bool
    kept: Bool
}

SEMA_BUILD_STEP_METHODS: "input, output, file, arg, reads, writes, timeout, toolchain or sign"

sema_build_step_contract: fn(owner: String, method: String) -> SemaBuildStepContract? Never! {
    unit: Type.Named{name: "Unit"}
    file: Type.Named{name: "BuildFile"}
    if owner == "BuildFile" {
        if method == "path" -> return Val(SemaBuildStepContract{parameters: [Type]{}, result: Type.String, flag: false, kept: false})
        if method == "file" || method == "folder" -> return Val(SemaBuildStepContract{parameters: [Type]{Type.String}, result: file, flag: false, kept: false})
        return None
    }
    if method == {
        "input" -> Val(SemaBuildStepContract{parameters: [Type]{Type.String}, result: unit, flag: true, kept: false})
        "output" -> Val(SemaBuildStepContract{parameters: [Type]{Type.String}, result: file, flag: true, kept: true})
        "file" -> Val(SemaBuildStepContract{parameters: [Type]{file}, result: unit, flag: true, kept: false})
        "writes" -> Val(SemaBuildStepContract{parameters: [Type]{Type.String}, result: unit, flag: false, kept: true})
        "arg" | "reads" -> Val(SemaBuildStepContract{parameters: [Type]{Type.String}, result: unit, flag: false, kept: false})
        "timeout" -> Val(SemaBuildStepContract{parameters: [Type]{Type.Named{name: "Duration"}}, result: unit, flag: false, kept: false})
        "toolchain" -> Val(SemaBuildStepContract{parameters: [Type]{Type.Named{name: "BuildToolchain"}}, result: unit, flag: false, kept: false})
        "sign" -> Val(SemaBuildStepContract{parameters: [Type]{Type.Named{name: "BuildSigningIdentity"}}, result: unit, flag: false, kept: false})
        else -> None
    }
}

sema_call_try_build_step_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    owner: if {
        receiver_value.ty == (Type.Named{name: "BuildAction"}) -> "BuildAction"
        receiver_value.ty == (Type.Named{name: "BuildFile"}) -> "BuildFile"
        else -> { return SemaMethodSpecialCheck{handled: false, value: None} }
    }
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    surface: if owner == "BuildFile" -> "path, file or folder" else -> SEMA_BUILD_STEP_METHODS
    contract: sema_build_step_contract(owner, method) ?? {
        diagnostics.push(sema_error("E0102", span, "`{owner}` has no method `{method}`", "`{owner}` is a protected Core type with a closed method surface", "use {surface}"))
        return failed
    }
    shape: if {
        contract.parameters.len() == 0 -> "file.{method}()"
        owner == "BuildFile" -> "b.dependency(name).{method}(path)"
        contract.flag && contract.kept -> "step.{method}(value)`, `step.{method}(value, flag: \"--in=\")` or `step.{method}(value, kept: true)"
        contract.flag -> "step.{method}(value)` or `step.{method}(value, flag: \"--in=\")"
        contract.kept -> "step.{method}(value)` or `step.{method}(value, kept: true)"
        else -> "step.{method}(value)"
    }
    positional := [CallArg]{}
    flag := CallArg?{None}
    kept := CallArg?{None}
    loop argument in args {
        label: if argument.label == .Val(written) -> written.name.copy() else -> ""
        takes: if label == {
            "" -> true
            "flag" -> contract.flag && flag == None
            "kept" -> contract.kept && kept == None
            else -> false
        }
        if argument.spread || argument.flags.template_items != None || !takes {
            diagnostics.push(sema_error("E0764", argument.span, "`{owner}.{method}` doesn't take this argument", "a step call takes its value; a file call also takes one `flag:`, and an output one `kept:`", "write `{shape}`"))
            return failed
        }
        if label == {
            "flag" -> flag = Val(argument.copy())
            "kept" -> kept = Val(argument.copy())
            else -> positional.push(argument.copy())
        }
    }
    if positional.len() != contract.parameters.len() {
        diagnostics.push(sema_error("E0104", span, "`{owner}.{method}` expects {contract.parameters.len()} arguments, got {positional.len()}", "a step call passes one value", "write `{shape}`"))
        return failed
    }
    values := [TExpr]{}
    params := [SemaCallParam]{}
    ordinary := [CallArg]{}
    if method == "timeout" {
        // The limit reaches the build session as its literal text (`10min`),
        // as the `action_timeout` option's value does.
        argument: positional[0]
        text: sema_build_duration_literal(argument.expr) ?? ""
        if build_option_duration_ms(text) == None {
            diagnostics.push(sema_error("E3502", argument.span, "a step's time limit is a positive Time literal", "the limit reaches the build as written, whole milliseconds or more", "write `step.timeout(10min)`"))
            return failed
        }
        values.push(sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: text}}}, argument.span))
    } else {
        // The session reads the values in this order: the positional ones,
        // then `flag:`'s String, then `kept:`'s Bool.
        checked := positional.copy()
        required_types := contract.parameters.copy()
        if flag == .Val(labelled) {
            checked.push(labelled.copy())
            required_types.push(Type.String)
        }
        if kept == .Val(labelled) {
            checked.push(labelled.copy())
            required_types.push(Type.Bool)
        }
        loop (index, argument) in checked {
            required: required_types[index]
            value: sema_check_expression(argument.expr, Val(required), environment, program, scopes, state, tail_store, context, diagnostics) ?? return failed
            compatible: sema_call_type_assignable(required, value.ty, environment, program) ?? return failed
            if !compatible {
                diagnostics.push(sema_type_mismatch(required, value.ty, argument.span))
                return failed
            }
            values.push(value.copy())
            params.push(SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(value.ty), variadic: false})
            unlabelled := argument.copy()
            unlabelled.label = None
            ordinary.push(unlabelled)
        }
    }
    ownership: sema_ownership_check_method_call(state, "{owner}.{method}", receiver, AccessConvention.Read, params, ordinary, scopes, span, diagnostics)
    if !ownership.accepted || !ownership.complete -> return failed
    value: sema_tree_node(contract.result, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: method, args: values}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, environment, program, diagnostics)}
}

// #5005 build options (BuildOptions.jet): `b.optimize(.Full)` or
// `b.debug_info(false)` sets a row's value in fn build; `b.pin(.optimize,
// .Full)` sets and pins it, so a flag can't change it. The session receives
// the row name and the value's table spelling (`optimize`, `full`).
sema_call_build_option: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, diagnostics: &[Diagnostic]) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    pinned: method == "pin"
    wanted: if pinned -> 2 else -> 1
    shape: if pinned -> "b.pin(.optimize, .Full)" else -> sema_build_option_call_shape(method, method, false)
    takes: if pinned -> "a build option and one of its values" else -> "one value"
    if args.len() != wanted {
        diagnostics.push(sema_error("E3502", span, "`b.{method}` takes {takes}, got {args.len()} arguments", "a build option call names one value of the option's row", "write `{shape}`"))
        return failed
    }
    loop argument in args {
        if argument.label != None || argument.spread || argument.flags.template_items != None {
            diagnostics.push(sema_error("E3502", argument.span, "`b.{method}` takes positional arguments", "a build option is written as `.name`, and its value as its row spells it", "write `{shape}`"))
            return failed
        }
    }
    name := method.copy()
    if pinned {
        // A lower-case `.optimize` parses as the implicit-receiver member
        // shorthand (a Field of the empty name), not as an enum value.
        name = ""
        if args[0].expr == .Field(base, member, _, _) {
            if base == .Ident(base_name, _, _) {
                if base_name.len() == 0 && build_option_refusal(member) == .Val(refusal) {
                    diagnostics.push(sema_error("E3502", args[0].span, "`.{member}` isn't a build option", refusal.law, "remove the `b.pin` call"))
                    return failed
                }
                if base_name.len() == 0 && build_option_row(member) != None -> name = member.copy()
            }
        }
        if name.len() == 0 {
            diagnostics.push(sema_error("E3502", args[0].span, "`b.pin` names a build option first", "the first argument is the option a pin holds, such as `.optimize`", "write `{shape}`"))
            return failed
        }
    }
    row: build_option_row(name) ?? return failed
    argument: args[wanted - 1]
    shape_fix: "write `{sema_build_option_call_shape(method, name, pinned)}`"
    value: sema_build_option_value(row, argument.expr) ?? {
        diagnostics.push(sema_error("E3502", argument.span, "this isn't a value of build option `{name}`", "`{name}` takes {build_option_variants_text(row)}", shape_fix))
        return failed
    }
    if !build_option_accepts(row, value) {
        diagnostics.push(sema_error("E3502", argument.span, "this isn't a value of build option `{name}`", "`{name}` takes {build_option_variants_text(row)}, each one line and none empty", shape_fix))
        return failed
    }
    // Only the value is an ordinary argument: a pin's option name is a row
    // name, not an expression of the body; a List row's literal and a
    // Duration row's Time literal read nothing.
    if row.kind != BuildOptionKind.List && row.kind != BuildOptionKind.Duration {
        params: [SemaCallParam]{SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.String), variadic: false}}
        ordinary := [CallArg]{argument.copy()}
        ownership: sema_ownership_check_method_call(state, "Build.{method}", receiver, AccessConvention.Read, params, ordinary, scopes, span, diagnostics)
        if !ownership.accepted || !ownership.complete -> return failed
    }
    values: [TExpr]{
        sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: name}}}, args[0].span),
        sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: value}}}, argument.span),
    }
    result: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: method, args: values}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(result, expected, environment, program, diagnostics)}
}

// The row value `expr` writes: `false` for a Bool row, `.Full` for a Choice
// row, and, since the value reaches the build session as text, a string
// literal for a Text row, a list literal of them for a List row and a Time
// literal (`10min`) for a Duration row.
sema_build_option_value: fn(row: BuildOptionRow, expr: Expr) -> String? {
    if row.kind == {
        .Bool -> {
            if expr == .Bool(written, _, _) -> return Val("{written}")
        }
        .Choice -> {
            if expr == .EnumLit(_, variant, _, enum_args, leading_dot, _, _) {
                if leading_dot && enum_args.len() == 0 -> return build_option_value_of_variant(row, variant)
            }
        }
        .Text -> return sema_build_option_literal(expr)
        .List -> {
            if expr == .ListLit(elements, _, _) {
                items := [String]{}
                loop element in elements {
                    item: sema_build_option_literal(element) ?? return None
                    items.push(item)
                }
                return Val(build_option_list_value(items))
            }
        }
        .Duration -> return sema_build_duration_literal(expr)
    }
    None
}

// The text of a string literal without interpolation.
sema_build_option_literal: fn(expr: Expr) -> String? {
    if expr == .Str(parts, _, _) {
        text := ""
        loop part in parts {
            if part == .Lit(piece) {
                text = "{text}{piece}"
            } else {
                return None
            }
        }
        return Val(text)
    }
    None
}

// The text of a Time literal written as a whole number and a unit (`10min`),
// as build_option_duration_ms reads it.
sema_build_duration_literal: fn(expr: Expr) -> String? {
    if expr == .UnitLit(raw, _, _, suffix, _, _, _) -> return Val("{raw}{suffix}")
    None
}

// `b.debug_info(false)`, `b.pin(.optimize, .Full)`, `b.output_dir("dist")`,
// `b.libs(["z"])`: a call of `method` that sets row `name` to an example
// value, as the fix of a malformed call.
sema_build_option_call_shape: fn(method: String, name: String, pinned: Bool) -> String Never! {
    row: build_option_row(name) ?? return "b.pin(.optimize, .Full)"
    values: build_option_method_values(row)
    example: if row.kind == {
        .Text -> "\"dist\""
        .List -> "[\"z\"]"
        .Duration -> "10min"
        .Choice | .Bool -> build_option_argument(row, values[values.len() - 1])
    }
    if pinned -> return "b.pin(.{name}, {example})"
    "b.{method}({example})"
}
