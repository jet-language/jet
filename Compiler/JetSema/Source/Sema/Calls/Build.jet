// The `Build` calls the checker shapes itself. Every other method of
// core.build's `Build` and its handles is the Core method its declaration
// checks, whose work is the build host's.
use {
    jet_foundation.[AST_EMPTY_CALL_ARG_FLAGS, AST_NODE_GENERATED, AccessConvention, BUILD_OPTION_HOOK_DEFAULT, Binding, BuildOptionKind, BuildOptionRow, COMPILER_EVENT_TYPE, Call, CallArg, CtValue, DeriveBodyItem, Diagnostic, EffectRowEntry, EnumLitArg, Expr, ExprField, ForKind, Item, Marker, MarkerDecl, NamedCtValue, ParamZone, Span, Stmt, StrPart, SymbolKind, TComptimeField, TComptimeValue, Type, ast_func, ast_program, build_option_accepts, build_option_argument, build_option_list_value, build_option_method_values, build_option_refusal, build_option_row, build_option_value_of_variant, build_option_variants_text, core_identity_is, expr_span, type_name]
    jet_parser.[jfmt_format_program_with_tokens]
    jet_lexer.[Token]
}

sema_build_result: fn(name: String) -> Type Never! {
    Type.Result{ok: Type.Named{name: name}, err: Type.Named{name: "BuildError"}}
}

// Whether `ty` is core.build's `leaf` type (`Build`).
sema_build_core_type: fn(ty: Type, leaf: String) -> Bool Never! {
    if ty == .Named(name) -> return name == leaf || core_identity_is(name, "core.build", leaf)
    false
}

// core.build's declared type `leaf` (`BuildTarget`).
sema_build_core_named: fn(leaf: String) -> Type Never! {
    Type.Named{name: "<corelib>/core.build.{leaf}"}
}

// Whether `method` declares one of a build's outputs (`b.add_executable`).
sema_build_context_target_method: fn(method: String) -> Bool Never! {
    method == "add_executable" || method == "add_library" || method == "add_test" || method == "add_asset_bundle" || method == "add_doc" || method == "add_install" || method == "add_package" || method == "add_publish"
}

// The type of an output method's positional argument `index`: its name,
// sources, steps, dependencies, probes, toolchain and signing identity.
sema_build_output_parameter: fn(index: Int) -> Type Never! {
    if index == {
        0 -> Type.String
        1 -> Type.List{element: Type.String}
        2 -> Type.List{element: sema_build_core_named("BuildStepHandle")}
        3 -> Type.List{element: sema_build_core_named("BuildTarget")}
        4 -> Type.List{element: sema_build_core_named("BuildProbe")}
        5 -> sema_build_core_named("BuildToolchain")
        else -> sema_build_core_named("BuildSigningIdentity")
    }
}

// A `Build` call the checker shapes: a build option (`b.optimize(.O2)`,
// `b.pin(.optimize, .O2)`), `b.generate` with its item block or `Code`
// value, and `b.contribute`, whose value is any contribution's type. A
// `b.compiler` call is held to the root package's own build source and is
// then the Core method.
sema_call_try_build_context_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if !sema_build_core_type(receiver_value.ty, "Build") {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    if build_option_refusal(method) == .Val(refusal) {
        check.diagnostics.push(sema_error("E3502", span, "`b.{method}` isn't a build option", refusal.law, "remove the `b.{method}` call"))
        return failed
    }
    if method == "pin" || build_option_row(method) != None {
        return sema_call_build_option(receiver, receiver_value, method, args, span, expected, check)
    }
    if sema_build_context_target_method(method) {
        loop argument in args {
            if argument.label == .Val(label) && label.name == "options" {
                return sema_call_build_output(receiver, receiver_value, method, args, span, expected, check)
            }
        }
    }
    if method == "compiler" && !sema_build_compiler_site(check, span) -> return failed
    if method != "generate" && method != "contribute" {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    if args.len() != 2 {
        loop argument in args {
            if argument.flags.template_items == None {
                ^_: sema_check_expression(argument.expr, None, check)
            }
        }
        check.diagnostics.push(sema_error("E0104", span, "`Build.{method}` expects 2 arguments, got {args.len()}", "`b.{method}` takes a name and its value", "pass the arguments accepted by `b.{method}`"))
        return failed
    }
    ^template_count: 0
    loop argument in args {
        if argument.flags.template_items != None -> template_count += 1
    }
    if method == "generate" && template_count == 0 {
        return sema_call_build_generate_code(receiver, receiver_value, args, span, expected, check)
    }
    if method == "generate" && template_count != 1 {
        check.diagnostics.push(sema_error("E3502", span, "`b.generate` requires a name followed by a typed item block or a `Code` value", "generated bodies are Jet items checked by the ordinary semantic path", "write `b.generate(\"name\") {{ ... }}` or `b.generate(\"name\", code)`"))
        return failed
    }
    if method != "generate" && template_count > 0 -> return failed
    result: if method == "generate" -> sema_build_result("Unit") else -> Type.Named{name: "Unit"}
    ^values: [TExpr]{}
    ^params: [SemaCallParam]{}
    ^ordinary: [CallArg]{}
    loop argument in args {
        if argument.flags.template_items != None -> next
        ordinary.push(argument.copy())
        ^required: Type?{None}
        if ordinary.len() == 1 -> required = Val(Type.String)
        value: sema_check_expression(argument.expr, required, check) ?? return failed
        if required == .Val(ty) {
            compatible: sema_call_type_assignable(ty, value.ty, check) ?? return failed
            if !compatible {
                check.diagnostics.push(sema_type_mismatch(ty, value.ty, argument.span, check.program.*))
                return failed
            }
        }
        if argument.label != None || argument.spread {
            check.diagnostics.push(sema_error("E0764", argument.span, "`Build.{method}` takes positional arguments", "the build method contract does not declare labels or variadic slots", "remove the label or spread from this argument"))
            return failed
        }
        params.push(SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(value.ty), variadic: false})
        values.push(value)
    }
    // `b.generate` sends its formatted items, then a (marker, value) pair per
    // build local the template splices; the locals are read like arguments.
    ^generated: [TExpr]{}
    if method == "generate" {
        loop argument in args {
            body: argument.flags.template_items ?? next
            splices: sema_build_generate_splices(body, argument.span, false, check) ?? return failed
            generated.push(sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: splices.source}}}, argument.span))
            loop index in 0..<splices.markers.len() {
                generated.push(sema_tree_node(Type.Int, TExprKind.IntLit{value: splices.markers[index], width: None}, argument.span))
                generated.push(splices.values[index].copy())
                ordinary.push(splices.args[index].copy())
                params.push(SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(splices.values[index].ty), variadic: false})
            }
        }
    }
    ownership: sema_ownership_check_method_call(check, "Build.{method}", receiver, AccessConvention.Read, params, ordinary, span)
    if !ownership.accepted || !ownership.complete -> return failed
    values.extend(generated.move())
    value: sema_tree_node(result, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: method, args: values}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// `b.add_executable(name, sources, steps, deps, probes, toolchain: t,
// options: {settings: {key: value}})`: an output's labeled controls, after
// its positional arguments. `toolchain:` is its sixth argument written by
// name; `options:` gives the output its own values of the settings its
// package declares, each checked as the setting's declared type (E3541,
// E3542). The host call takes the argument slots, an unwritten list as
// empty and an unwritten toolchain or signing identity as `None`, then a
// (key, value) pair per setting (the build session's build_session_add_target).
sema_call_build_output: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    ^positional: 0
    ^toolchain_at: -1
    ^options_at: -1
    loop (index, argument) in args {
        if argument.spread || argument.flags.template_items != None {
            check.diagnostics.push(sema_error("E0764", argument.span, "`Build.{method}` takes no spread or template argument", "an output's arguments are its name, sources, steps, dependencies, probes, toolchain and options", "write the argument itself"))
            return failed
        }
        label: argument.label ?? {
            if toolchain_at >= 0 || options_at >= 0 {
                check.diagnostics.push(sema_error("E0764", argument.span, "`Build.{method}` takes its positional arguments before `toolchain:` and `options:`", "an output's labeled controls follow the arguments it takes by position", "move this argument before the labeled ones"))
                return failed
            }
            positional += 1
            next
        }
        if label.name == "toolchain" && toolchain_at < 0 && positional <= 5 -> toolchain_at = index else if label.name == "options" && options_at < 0 {
            options_at = index
        } else if label.name == "toolchain" || label.name == "options" {
            check.diagnostics.push(sema_error("E0765", label.span, "`Build.{method}` is given its `{label.name}` twice", "an output has one toolchain and one set of options", "keep one `{label.name}`"))
            return failed
        } else {
            check.diagnostics.push(sema_error("E0764", label.span, "`Build.{method}` has no `{label.name}:` argument", "an output's labeled arguments are `toolchain:` and `options:`", "pass `{label.name}` by position, or drop its label"))
            return failed
        }
    }
    most: if toolchain_at >= 0 -> 5 else -> 7
    if positional < 3 || positional > most {
        check.diagnostics.push(sema_error("E0104", span, "`Build.{method}` expects 3 to {most} arguments before its labeled ones, got {positional}", "an output takes its name, sources and steps, then its dependencies, probes, toolchain and signing identity", "pass the arguments accepted by `b.{method}`"))
        return failed
    }
    ^values: [TExpr]{}
    ^params: [SemaCallParam]{}
    loop (index, argument) in args {
        if index == options_at {
            params.push(SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.Named{name: "Unit"}), variadic: false})
            next
        }
        required: if index == toolchain_at -> sema_build_output_parameter(5) else -> sema_build_output_parameter(index)
        value: sema_check_expression(argument.expr, Val(required), check) ?? return failed
        compatible: sema_call_type_assignable(required, value.ty, check) ?? return failed
        if !compatible {
            check.diagnostics.push(sema_type_mismatch(required, value.ty, argument.span, check.program.*))
            return failed
        }
        params.push(SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(value.ty), variadic: false})
        if index == toolchain_at {
            // Dependencies and probes the call leaves out are empty.
            loop slot in values.len()..<5 {
                listed: sema_build_output_parameter(slot)
                values.push(sema_tree_node(listed, TExprKind.CtLit{value: TComptimeValue.List{values: [TComptimeValue]{}}}, span))
            }
        }
        values.push(value)
    }
    if options_at >= 0 {
        loop slot in values.len()..<7 {
            if slot < 5 {
                listed: sema_build_output_parameter(slot)
                values.push(sema_tree_node(listed, TExprKind.CtLit{value: TComptimeValue.List{values: [TComptimeValue]{}}}, span))
            } else {
                // The session reads an absent toolchain or signing identity as `()`.
                absent: Expr.Absent{span: span, id: AST_NODE_GENERATED}
                values.push(sema_check_expression(absent, Val(Type.Option{inner: sema_build_output_parameter(slot)}), check) ?? return failed)
            }
        }
        settings: sema_build_output_settings(args[options_at].expr, args[options_at].span, check) ?? return failed
        values.extend(settings.move())
    }
    // The ownership check marks each argument's access in place.
    ^ordinary: args
    ownership: sema_ownership_check_method_call(check, "Build.{method}", receiver, AccessConvention.Read, params, ordinary, span)
    if !ownership.accepted || !ownership.complete -> return failed
    value: sema_tree_node(sema_build_result("<corelib>/core.build.BuildTarget"), TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: method, args: values}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// The (key, value) pairs an output's `options: {settings: {key: value}}`
// gives the settings its package declares: each key one the package
// declares (E3541), each value checked as that setting's type (E3542).
sema_build_output_settings: fn(options: Expr, options_span: Span, check: ^SemaBodyCheck) -> [TExpr]? {
    shape: "`options:` takes an inferred literal of the output's settings, `{{settings: {{key: value}}}}`"
    if options == .StructLit(_, _, _, _, option_fields, options_inferred, _, _) {
        if options_inferred {
            declared: sema_build_output_declared(check)
            ^pairs: [TExpr]{}
            loop option in option_fields {
                if option.name == "settings" && option.value == .StructLit(_, _, _, _, setting_fields, settings_inferred, _, _) {
                    if settings_inferred {
                        loop field in setting_fields {
                            pair: sema_build_output_setting(field, declared, check) ?? return None
                            pairs.extend(pair.move())
                        }
                        next
                    }
                }
                check.diagnostics.push(sema_error("E0104", option.name_span, shape, "an output's options name the declared settings it gives its own values", "write `options: {{settings: {{key: value}}}}`"))
                return None
            }
            return Val(pairs)
        }
    }
    check.diagnostics.push(sema_error("E0104", options_span, shape, "an output's options name the declared settings it gives its own values", "write `options: {{settings: {{key: value}}}}`"))
    None
}

// One `key: value` of an output's settings: its key and its value checked as
// the type the package declares for it.
sema_build_output_setting: fn(field: ExprField, declared: [SemaBuildSetting], check: ^SemaBodyCheck) -> [TExpr]? {
    found: loop setting in declared {
        if setting.name == field.name {
            break Val(setting.ty.trim())
        }
    } ?? None
    ty: found ?? {
        check.diagnostics.push(sema_error("E3541", field.name_span, "This output's options set `{field.name}`, which the package does not declare", "an output's `options: {{settings: ...}}` gives its own values to the settings `package.jet` declares, and code reads them as `#build.settings.<key>`", "declare `{field.name}: Type = default` in the `settings: {{ … }}` block of `package.jet`, or drop it from the output's options"))
        return None
    }
    // A scalar setting's value is checked on its own, so a value of another
    // type reaches E3542 rather than the expected-type mismatch; an enum
    // setting's `.Case` needs its type to resolve.
    ^scalar: Type?{None}
    if ty == {
        "Bool" -> scalar = Val(Type.Bool)
        "Int" -> scalar = Val(Type.Int)
        "Char" -> scalar = Val(Type.Char)
        "String" -> scalar = Val(Type.String)
        else -> {}
    }
    required: scalar ?? Type.Named{name: ty}
    hint: if scalar == None -> Val(required) else -> Type?{None}
    value: sema_check_expression(field.value, hint, check) ?? return None
    compatible: sema_call_type_assignable(required, value.ty, check) ?? return None
    if !compatible {
        check.diagnostics.push(sema_error("E3542", expr_span(field.value), "Setting `{field.name}` is declared `{ty}`, but this output gives it a `{type_name(value.ty)}`", "code reads `#build.settings.{field.name}` as its declared type, whichever output it is built into", "give `{field.name}` a value of type `{ty}`"))
        return None
    }
    key: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: field.name}}}, field.name_span)
    Val([TExpr]{key, value})
}

// The settings the checked module's package declares.
sema_build_output_declared: fn(check: SemaBodyCheck) -> [SemaBuildSetting] Never! {
    graph: check.program.registration_graph
    row: if sema_registration_module_index(graph, check.environment.module_identity) == .Val(index) -> graph.modules[index].settings_row else -> -1
    sema_build_facts_settings_at(graph.build_facts, row)
}

// `b.generate(name, code)`: the module `name` holds a `Code` value's items
// (`#code { items }`), which a helper can write and return. It is the
// module `b.generate(name) { items }` makes from the same items, byte for
// byte; the value's own place is kept for the reports on that module.
// Source text is refused: items written as text would be read only when the
// build runs, and its problems would point into a file nobody wrote.
sema_call_build_generate_code: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    loop argument in args {
        if argument.label != None || argument.spread {
            check.diagnostics.push(sema_error("E0764", argument.span, "`Build.generate` takes positional arguments", "the build method contract does not declare labels or variadic slots", "remove the label or spread from this argument"))
            return failed
        }
    }
    name: sema_check_expression(args[0].expr, Val(Type.String), check) ?? return failed
    named: sema_call_type_assignable(Type.String, name.ty, check) ?? return failed
    if !named {
        check.diagnostics.push(sema_type_mismatch(Type.String, name.ty, args[0].span, check.program.*))
        return failed
    }
    code: sema_check_expression(args[1].expr, None, check) ?? return failed
    text: sema_call_type_assignable(Type.String, code.ty, check) ?? return failed
    if text {
        check.diagnostics.push(sema_error("E3502", args[1].span, "`b.generate` doesn't take source text", "generated items are Jet code checked where they are written, so a slip reports at its line; text would be read only when the build runs, and its problems would point into a file nobody wrote", "write the items in a `#code {{ ... }}` value, or in `b.generate(\"name\") {{ ... }}`"))
        return failed
    }
    is_code: sema_call_type_assignable(Type.Named{name: "Code"}, code.ty, check) ?? return failed
    if !is_code {
        check.diagnostics.push(sema_type_mismatch(Type.Named{name: "Code"}, code.ty, args[1].span, check.program.*))
        return failed
    }
    params: [SemaCallParam]{
        SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(name.ty), variadic: false},
        SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(code.ty), variadic: false},
    }
    ^ordinary: args.copy()
    ownership: sema_ownership_check_method_call(check, "Build.generate", receiver, AccessConvention.Read, params, ordinary, span)
    if !ownership.accepted || !ownership.complete -> return failed
    value: sema_tree_node(sema_build_result("Unit"), TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: "generate", args: [TExpr]{name, code}}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// Only the root package's own build source makes the `Compiler` value: a
// `b.compiler` call written in any other package is E0776, wherever its
// `Build` came from, so a root that hands its `Build` to a dependency's
// function hands it no compiler control. Code the compiler generated (a
// `meta.add` or `b.generate` module, a `meta.rewrite_body` body) is not the
// root's own source either, even inside the root package, so code a value
// added can't make another one. The root is the package of the load's entry
// module, read from the graph in the program tables.
sema_build_compiler_site: fn(check: ^SemaBodyCheck, span: Span) -> Bool {
    ^root: ""
    graph: check.program.registration_graph
    root = sema_build_root_package(graph)
    written: check.environment.source_origin == SemaSourceOrigin.Snapshot
    if written && root != "" && check.environment.package_identity == root -> return true
    row: sema_diagnostic_row("E0776")
    check.diagnostics.push(sema_error("E0776", span, row.what, row.why, row.fix))
    false
}

// The identity of the root package, the package of the load's entry module;
// "" when the graph has no entry module.
sema_build_root_package: fn(graph: SemaRegistrationGraph) -> String Never! {
    entry: sema_registration_module_index(graph, graph.entry_module_identity) ?? return ""
    graph.modules[entry].package_identity.copy()
}

// `#code { items }`: a `Code` value holding its items formatted as source,
// expanded by the same path as a `b.generate` template. The items are
// checked where the value lands, with the program (`meta.add`). A `#{name}`
// naming a String build local pastes the name or type it spells: the value
// holds the splice's marker, which the build host replaces with the local's
// text when the build runs (`Code.pasted`). A block of statements alone is a
// body (`meta.rewrite_body`): its statements are formatted as written, never
// run as template statements, and only their pastes of build locals are
// substituted.
sema_build_code_value: fn(call: Call, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    ^body: [DeriveBodyItem]?{None}
    if call.args.len() == 1 -> body = call.args[0].flags.template_items
    items_written: body ?? {
        check.diagnostics.push(sema_error("E3502", call.name_span, "`#code` needs one item block", "a `Code` value is the items written in its block", "write `#code {{ ... }}`"))
        return None
    }
    span: Span{start: call.name_span.start, end: call.args[0].span.end}
    ^statements: [Stmt]{}
    loop written in items_written {
        if written == .Stmt(statement) -> statements.push(statement.copy()) else -> break
    }
    ^splices: SemaBuildGenerateSplices{source: "", markers: [Int]{}, args: [CallArg]{}, values: [TExpr]{}}
    if items_written.len() > 0 && statements.len() == items_written.len() {
        splices.source = sema_build_code_statements(statements)
        // A body's statements are substituted, never run: a `#{name}` naming
        // a String build local pastes as in any `#code` value, and a paste
        // naming no local, such as `#{f.body}`, stays as written.
        scope: sema_build_splice_scope(splices, span, true, check) ?? return None
        if splices.markers.len() > 0 {
            ^expansion: SemaDeriveExpansion{scope: scope, failure: None}
            expanded: sema_derive_expand_stmts(expansion, statements)
            if expansion.failure == .Val(failure) {
                check.diagnostics.push(failure)
                return None
            }
            splices.source = sema_build_code_statements(expanded)
        }
    } else {
        splices = sema_build_generate_splices(items_written, span, true, check) ?? return None
    }
    // The value keeps where its items are written, "file:line", which a
    // report on the module `b.generate` makes from it names.
    location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)
    source: TComptimeField{name: "source", value: TComptimeValue.String{value: splices.source}}
    site: TComptimeField{name: "site", value: TComptimeValue.String{value: "{location.file}:{location.line}"}}
    value: TComptimeValue.Struct{type_name: "Code", fields: [TComptimeField]{source, site}}
    node: sema_tree_node(Type.Named{name: "Code"}, TExprKind.CtLit{value: value}, span)
    if splices.markers.len() == 0 {
        return sema_expr_expected(node, expected, check.environment.*, check.program.*, check.diagnostics)
    }
    // The pasted locals are read like a call's arguments; the host takes each
    // splice's marker, the name it pastes, then the local's value.
    params: loop pasted in splices.values -> SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(pasted.ty), variadic: false}
    ownership: sema_ownership_check_call_arguments(check.state, "#code", params, splices.args, check.scopes, check.diagnostics)
    if !ownership.accepted || !ownership.complete -> return None
    ^args: [TExpr]{}
    loop index in 0..<splices.markers.len() {
        name: if splices.args[index].expr == .Ident(written, _, _) -> written.copy() else -> ""
        args.push(sema_tree_node(Type.Int, TExprKind.IntLit{value: splices.markers[index], width: None}, span))
        args.push(sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: name}}}, span))
        args.push(splices.values[index].copy())
    }
    pasted: sema_tree_node(Type.Named{name: "Code"}, TExprKind.HostCall{call: THostCall.Method{receiver: node, method: "pasted", args: args}}, span)
    sema_expr_expected(pasted, expected, check.environment.*, check.program.*, check.diagnostics)
}

// Statements formatted as a function body's lines, unindented: the formatter
// writes them inside a function, whose first and last lines are dropped. A
// short body stays on the function's line (`code: fn() { value }`), and its
// one statement is the text between the braces.
sema_build_code_statements: fn(statements: [Stmt]) -> String {
    ^wrapper: ast_func("code", Span{start: 0, end: 0}, Span{start: 0, end: 0})
    wrapper.body = statements.copy()
    ^lines: sema_build_generate_format([Item]{Item.Func{value: wrapper}}).split("\n").to_list()
    loop lines.len() > 0 && lines[lines.len() - 1].trim() == "" -> _: lines.pop()
    if lines.len() == 1 {
        line: lines[0].trim()
        inner: line.removeprefix("code: fn() {{ ")
        if inner == line || !inner.ends_with(" }}") -> return ""
        body: inner.removesuffix(" }}")
        return "{body}\n"
    }
    if lines.len() < 2 -> return ""
    ^text: ""
    loop index in 1..<(lines.len() - 1) {
        line: lines[index]
        body_line: if line.starts_with("    ") -> line.removeprefix("    ") else -> line.copy()
        text = "{text}{body_line}\n"
    }
    text
}

// A call on the root's `Compiler` value. `meta.add(code, scope: name)` adds
// a `Code` value's items as the generated module `name` of the value's
// target, checked with the program like hand-written code (the build
// session's `compiler.add`). `meta.rewrite_body(f, code)` replaces the body of
// the function `f` with a `Code` value's statements (the build session's
// `compiler.rewrite_body`). `meta.allow_rewrite(package: name)` lets the
// value rewrite that dependency's functions (the build session's
// `compiler.allow_rewrite`). `meta.events(watch: .Functions{marked: m},
// handler)` hands the handler each checked function carrying `m`'s marker,
// and `meta.events(watch: .Calls{to: f}, handler)` each checked call of `f`.
// `meta.add_struct(name, fields, scope: module)` declares a struct of
// `CompilerField{name:, type:}` values, and `meta.find_type(text)` gives
// the `TypeId` one type's spelling names.
// `meta.report(finding, at: c)` raises a Diagnostic finding at such a call.
sema_call_try_compiler_method: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    if receiver_value.ty != (Type.Named{name: "Compiler"}) {
        return SemaMethodSpecialCheck{handled: false, value: None}
    }
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    if method == "rewrite_body" {
        return sema_call_compiler_rewrite_body(receiver, receiver_value, args, span, expected, check)
    }
    if method == "allow_rewrite" {
        return sema_call_compiler_allow_rewrite(receiver, receiver_value, args, span, expected, check)
    }
    if method == "add_struct" {
        return sema_call_compiler_add_struct(receiver, receiver_value, args, span, expected, check)
    }
    if method == "find_type" {
        return sema_call_compiler_find_type(receiver, receiver_value, args, span, expected, check)
    }
    if method == "events" -> return sema_call_compiler_events(receiver, args, span, expected, check)
    if method == "events.functions" || method == "events.calls" {
        return sema_call_compiler_events_read(receiver, receiver_value, method, args, span, expected, check)
    }
    if method == "report" -> return sema_call_compiler_report(receiver, args, span, expected, check)
    if method == "report.finding" {
        return sema_call_compiler_report_finding(receiver, receiver_value, args, span, expected, check)
    }
    if method == "stages" {
        return sema_call_compiler_stages(receiver, receiver_value, args, span, expected, check)
    }
    shape: "meta.add(#code {{ ... }}, scope: \"name\")"
    if method != "add" {
        check.diagnostics.push(sema_error("E0102", span, "`Compiler` has no method `{method}`", "`Compiler` is a protected Core type with a closed method surface", "write `{shape}`, `meta.add_struct(\"Name\", fields, scope: \"name\")`, `meta.find_type(\"Name\")`, `meta.rewrite_body(f, #code {{ ... }})`, `meta.allow_rewrite(package: \"name\")`, `meta.events(watch: .Functions{{marked: Traced{{}}}}, handler)`, `meta.stages()` or `meta.report(finding, at: c)`"))
        return failed
    }
    ^code: CallArg?{None}
    ^scope: CallArg?{None}
    loop argument in args {
        label: if argument.label == .Val(written) -> written.name.copy() else -> ""
        takes: if label == {
            "" -> code == None
            "scope" -> scope == None
            else -> false
        }
        if argument.spread || argument.flags.template_items != None || !takes {
            check.diagnostics.push(sema_error("E0764", argument.span, "`Compiler.add` doesn't take this argument", "`meta.add` takes one `Code` value or source text and the `scope:` module it joins", "write `{shape}`"))
            return failed
        }
        ^unlabeled: argument.copy()
        unlabeled.label = None
        if label == "scope" -> scope = Val(unlabeled) else -> code = Val(unlabeled)
    }
    code_arg: code ?? {
        check.diagnostics.push(sema_error("E0104", span, "`Compiler.add` expects a `Code` value or source text", "`meta.add` adds the items of one `Code` value or of source text", "write `{shape}`"))
        return failed
    }
    scope_arg: scope ?? {
        check.diagnostics.push(sema_error("E0104", span, "`Compiler.add` expects `scope:`", "the added items join the generated module `scope:` names", "write `{shape}`"))
        return failed
    }
    // The code is a `Code` value or a String of source text, which the
    // build parses when it runs.
    code_value: sema_check_expression(code_arg.expr, None, check) ?? return failed
    text: sema_call_type_assignable(Type.String, code_value.ty, check) ?? return failed
    if !text {
        is_code: sema_call_type_assignable(Type.Named{name: "Code"}, code_value.ty, check) ?? return failed
        if !is_code {
            check.diagnostics.push(sema_type_mismatch(Type.Named{name: "Code"}, code_value.ty, code_arg.span, check.program.*))
            return failed
        }
    }
    scope_value: sema_check_expression(scope_arg.expr, Val(Type.String), check) ?? return failed
    scope_is_text: sema_call_type_assignable(Type.String, scope_value.ty, check) ?? return failed
    if !scope_is_text {
        check.diagnostics.push(sema_type_mismatch(Type.String, scope_value.ty, scope_arg.span, check.program.*))
        return failed
    }
    // The session reads the code, then the scope's String.
    ^ordinary: [CallArg]{code_arg, scope_arg}
    ^values: [TExpr]{code_value, scope_value}
    params: loop value in values -> SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(value.ty), variadic: false}
    ownership: sema_ownership_check_method_call(check, "Compiler.{method}", receiver, AccessConvention.Read, params, ordinary, span)
    if !ownership.accepted || !ownership.complete -> return failed
    // `meta.add` writes declarations, so it uses `Meta.Generate`: allowed
    // unless the calling function's row denies it. Source text is a type
    // factory: the build parses it after every row is fixed, and it may
    // declare a type made from any value, so a text add also uses
    // `Meta.Code.Types` and `Meta.Code.Raw`. A `Code` value's items are fixed where it
    // is written, like a marker's, so they need `Meta.Generate` alone.
    ^performed: [String]{META_GENERATE}
    if text {
        performed.push(META_TYPES)
        performed.push(META_RAW)
    }
    ^entries: [EffectRowEntry]{}
    loop name in performed -> entries.push(EffectRowEntry{name: name, span: span})
    if !sema_effect_record_intrinsic_effects(check, "Compiler.{method}", span, entries) {
        return failed
    }
    // The session reads the code, the scope, the caller, then the Meta
    // effects the add performs, which the build's provenance records.
    values.push(sema_call_compiler_producer(check, span))
    values.push(sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: performed.join(", ")}}}, span))
    value: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: method, args: values}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// `meta.add_struct(name, fields, scope: module)`: the build host writes the
// struct `name` of `fields` and adds it as the generated module `module`,
// as `meta.add` adds source text. Each field is a `CompilerField` of a name
// and a `TypeId`, read from a reflected field (`f.type`), so a build makes
// the type from values. A `TypeId` is only ever made by the compiler, and
// the build host checks every name (one identifier in its kind's casing),
// so no code a build computes is written: it uses `Meta.Generate` and
// `Meta.Code.Types`, never `Meta.Code.Raw`. The call's value is the new struct's
// `TypeId`, so a later struct can hold it.
sema_call_compiler_add_struct: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    shape: "meta.add_struct(\"Name\", fields, scope: \"name\")"
    ^positional: [CallArg]{}
    ^scope: CallArg?{None}
    loop argument in args {
        label: if argument.label == .Val(written) -> written.name.copy() else -> ""
        takes: if label == {
            "" -> positional.len() < 2
            "scope" -> scope == None
            else -> false
        }
        if argument.spread || argument.flags.template_items != None || !takes {
            check.diagnostics.push(sema_error("E0764", argument.span, "`Compiler.add_struct` doesn't take this argument", "`meta.add_struct` takes the struct's name, its fields and the `scope:` module it joins", "write `{shape}`"))
            return failed
        }
        ^unlabeled: argument.copy()
        unlabeled.label = None
        if label == "scope" -> scope = Val(unlabeled) else -> positional.push(unlabeled)
    }
    if positional.len() != 2 {
        check.diagnostics.push(sema_error("E0104", span, "`Compiler.add_struct` expects a name and a list of fields", "`meta.add_struct` declares one struct of `CompilerField` records, each a field's name and its `TypeId`", "write `{shape}`"))
        return failed
    }
    scope_arg: scope ?? {
        check.diagnostics.push(sema_error("E0104", span, "`Compiler.add_struct` expects `scope:`", "the struct joins the generated module `scope:` names", "write `{shape}`"))
        return failed
    }
    // The session reads the name, the fields, then the scope's String.
    ^ordinary: [CallArg]{positional[0], positional[1], scope_arg}
    ^wanted: [Type]{Type.String, Type.List{element: Type.Named{name: "CompilerField"}}, Type.String}
    ^values: [TExpr]{}
    ^params: [SemaCallParam]{}
    loop index in 0..<ordinary.len() {
        value: sema_check_expression(ordinary[index].expr, Val(wanted[index]), check) ?? return failed
        fits: sema_call_type_assignable(wanted[index], value.ty, check) ?? return failed
        if !fits {
            check.diagnostics.push(sema_type_mismatch(wanted[index], value.ty, ordinary[index].span, check.program.*))
            return failed
        }
        params.push(SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(value.ty), variadic: false})
        values.push(value)
    }
    ownership: sema_ownership_check_method_call(check, "Compiler.add_struct", receiver, AccessConvention.Read, params, ordinary, span)
    if !ownership.accepted || !ownership.complete -> return failed
    performed: [String]{META_GENERATE, META_TYPES}
    ^entries: [EffectRowEntry]{}
    loop name in performed -> entries.push(EffectRowEntry{name: name, span: span})
    if !sema_effect_record_intrinsic_effects(check, "Compiler.add_struct", span, entries) {
        return failed
    }
    // Then the caller and the Meta effects the add performs, which the
    // build's provenance records.
    values.push(sema_call_compiler_producer(check, span))
    values.push(sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: performed.join(", ")}}}, span))
    value: sema_tree_node(Type.Named{name: "TypeId"}, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: "add_struct", args: values}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// `meta.find_type(text)`: the `TypeId` of the one type `text` spells, its
// names read as the program's root module reads them, or as the structs
// this build already made with `meta.add_struct`; None when `text` is not
// one type's spelling or names a type neither knows. The build host reads
// the value's checked program, so the call only reads and uses no Meta
// effect.
sema_call_compiler_find_type: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() != 1 || args[0].label != None || args[0].spread || args[0].flags.template_items != None {
        check.diagnostics.push(sema_error("E0764", span, "`Compiler.find_type` takes one type's spelling", "`meta.find_type` reads one type's spelling as the program's root module reads it", "write `meta.find_type(\"Name\")`"))
        return failed
    }
    ^ordinary: [CallArg]{args[0].copy()}
    value: sema_check_expression(args[0].expr, Val(Type.String), check) ?? return failed
    fits: sema_call_type_assignable(Type.String, value.ty, check) ?? return failed
    if !fits {
        check.diagnostics.push(sema_type_mismatch(Type.String, value.ty, args[0].span, check.program.*))
        return failed
    }
    ^params: [SemaCallParam]{SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.String), variadic: false}}
    ownership: sema_ownership_check_method_call(check, "Compiler.find_type", receiver, AccessConvention.Read, params, ordinary, span)
    if !ownership.accepted || !ownership.complete -> return failed
    if !sema_effect_record_intrinsic_effects(check, "Compiler.find_type", span, [EffectRowEntry]{}) {
        return failed
    }
    call: sema_tree_node(Type.Option{inner: Type.Named{name: "TypeId"}}, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: "find_type", args: [TExpr]{value}}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(call, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// `meta.rewrite_body(f, #code { statements })`: `f` names a top-level
// function, directly or through its package's import (`tool.f`), and is sent
// as its name and its package's identity; the build replaces the body of
// that package's function of that name (JetDriver BuildQueries.jet), so
// naming it lends nothing and moves nothing. `f` may instead be a
// `FunctionInfo` value, such as the function a `meta.events` handler hears;
// that is the hidden `Compiler` method `rewrite_body.heard`, which sends the
// value itself, whose `name` and `package` the build host reads, then the
// name `f` is written as, so a line `#{f.body}` of the code is that
// function's original body. Replacing a body uses `Meta.Code.Rewrite`, and the
// build session refuses a function of a package other than the root unless
// the value allows it (`meta.allow_rewrite`).
sema_call_compiler_rewrite_body: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    shape: "meta.rewrite_body(f, #code {{ ... }})"
    if args.len() != 2 {
        check.diagnostics.push(sema_error("E0104", span, "`Compiler.rewrite_body` expects a function and a `Code` value", "`meta.rewrite_body` replaces the body of one function with the statements of one `Code` value", "write `{shape}`"))
        return failed
    }
    loop argument in args {
        if argument.label != None || argument.spread || argument.flags.template_items != None {
            check.diagnostics.push(sema_error("E0764", argument.span, "`Compiler.rewrite_body` doesn't take this argument", "`meta.rewrite_body` takes a function's name and one `Code` value, both unlabeled", "write `{shape}`"))
            return failed
        }
    }
    ^function: ""
    ^package: ""
    graph: check.program.registration_graph
    ^resolved: SemaRegistrationResolvedSymbol?{None}
    if args[0].expr == .Ident(name, _, _) {
        // Only a body binding is a local; the root frame holds the
        // module's items and imports.
        ^local: false
        if sema_scope_resolve_index(check.scopes, name) == .Val(index) {
            local = check.scopes.frames[check.scopes.bindings[index].frame].parent >= 0
        }
        if !local {
            resolved = sema_registration_lookup_name(graph, check.environment.module_identity, name)
        }
    } else if args[0].expr == .Field(base, member, _, _) && base == .Ident(alias, _, _) {
        resolved = sema_registration_lookup_qualified(graph, check.environment.module_identity, alias, member)
    }
    // The function's package goes by its identity, which a dependency
    // checked as its own package gives the same as the root's check.
    if resolved == .Val(symbol) && sema_resolved_kind(graph, symbol) == SymbolKind.Function {
        if sema_registration_module_index(graph, symbol.source_module_identity) == .Val(module_index) {
            function = sema_resolved_name(graph, symbol)
            package = graph.modules[module_index].package_identity.copy()
        }
    }
    ^heard: TExpr?{None}
    if function == "" {
        // Not a top-level function: a `FunctionInfo` value is the function
        // it describes. Anything else names no function.
        mark: check.diagnostics.len()
        if sema_check_expression(args[0].expr, None, check) == .Val(value) {
            if value.ty == (Type.Named{name: "FunctionInfo"}) -> heard = Val(value)
        }
        loop check.diagnostics.len() > mark -> _: check.diagnostics.pop()
    }
    if function == "" && heard == None {
        check.diagnostics.push(sema_error("E0764", args[0].span, "`meta.rewrite_body` needs a top-level function's name", "a body rewrite replaces the body of one top-level function, named directly, through its package, or by the `FunctionInfo` a `meta.events` handler hears", "pass a top-level function, as in `{shape}` or `meta.rewrite_body(tool.f, #code {{ ... }})`"))
        return failed
    }
    ^ordinary: [CallArg]{}
    ^params: [SemaCallParam]{}
    if heard == .Val(info) {
        ordinary.push(args[0].copy())
        params.push(SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(info.ty), variadic: false})
    }
    ordinary.push(args[1].copy())
    code: sema_check_expression(args[1].expr, Val(Type.Named{name: "Code"}), check) ?? return failed
    compatible: sema_call_type_assignable(Type.Named{name: "Code"}, code.ty, check) ?? return failed
    if !compatible {
        check.diagnostics.push(sema_type_mismatch(Type.Named{name: "Code"}, code.ty, args[1].span, check.program.*))
        return failed
    }
    params.push(SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(code.ty), variadic: false})
    ownership: sema_ownership_check_method_call(check, "Compiler.rewrite_body", receiver, AccessConvention.Read, params, ordinary, span)
    if !ownership.accepted || !ownership.complete -> return failed
    if !sema_effect_record_intrinsic_effects(check, "Compiler.rewrite_body", span, [EffectRowEntry]{EffectRowEntry{name: META_REWRITE, span: span}}) {
        return failed
    }
    producer: sema_call_compiler_producer(check, span)
    if heard == .Val(info) {
        // The session reads the `FunctionInfo` value, the `Code` value, the
        // caller, then the name its paste line is written with.
        written: if args[0].expr == .Ident(name, _, _) -> name.copy() else -> ""
        paste: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: written}}}, args[0].span)
        value: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: "rewrite_body.heard", args: [TExpr]{info, code, producer, paste}}}, span)
        return SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
    }
    // The session reads the function's name, the `Code` value, the caller,
    // then the identity of the function's package.
    name: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: function}}}, args[0].span)
    owner: sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: package}}}, args[0].span)
    value: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: "rewrite_body", args: [TExpr]{name, code, producer, owner}}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// `meta.allow_rewrite(package: "name")`: the root's consent that the value
// may rewrite the functions of the dependency `name`, which this build loads
// at its locked version. The name is a string literal, so the consent is one
// line a reviewer reads; the root's own functions need none.
sema_call_compiler_allow_rewrite: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    shape: "meta.allow_rewrite(package: \"name\")"
    labeled: if args.len() == 1 && args[0].label == .Val(written) -> written.name == "package" else -> false
    if !labeled || args[0].spread || args[0].flags.template_items != None {
        check.diagnostics.push(sema_error("E0764", span, "`Compiler.allow_rewrite` takes one `package:` name", "`meta.allow_rewrite` names the one dependency whose functions the value may rewrite", "write `{shape}`"))
        return failed
    }
    ^unlabeled: args[0].copy()
    unlabeled.label = None
    ^ordinary: [CallArg]{unlabeled}
    value: sema_check_expression(unlabeled.expr, Val(Type.String), check) ?? return failed
    named: sema_plugin_literal_text(value) ?? {
        check.diagnostics.push(sema_error("E0764", args[0].span, "`meta.allow_rewrite` needs the package's name written out", "the consent is one line a reviewer reads, so it names its package as a string literal", "write `{shape}`"))
        return failed
    }
    ^root: ""
    ^known: false
    graph: check.program.registration_graph
    root = sema_build_root_package(graph)
    loop module_row in graph.modules {
        if module_row.package_identity != root && sema_build_package_name(module_row.package_identity) == named {
            known = true
        }
    }
    if root != "" && sema_build_package_name(root) == named {
        check.diagnostics.push(sema_error("E0764", args[0].span, "`meta.allow_rewrite` names the root package `{named}`", "the root package's own functions need no consent to be rewritten", "remove this line"))
        return failed
    }
    if !known {
        check.diagnostics.push(sema_error("E0764", args[0].span, "`meta.allow_rewrite` names `{named}`, which is no package of this build", "the consent covers one dependency this build loads, at its locked version", "name a package listed in `deps:`, as in `{shape}`"))
        return failed
    }
    ^params: [SemaCallParam]{SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.String), variadic: false}}
    ownership: sema_ownership_check_method_call(check, "Compiler.allow_rewrite", receiver, AccessConvention.Read, params, ordinary, span)
    if !ownership.accepted || !ownership.complete -> return failed
    // The consent changes no code, so it uses no Meta effect.
    if !sema_effect_record_intrinsic_effects(check, "Compiler.allow_rewrite", span, [EffectRowEntry]{}) {
        return failed
    }
    call: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: "allow_rewrite", args: [TExpr]{value}}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(call, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// `meta.events(watch: .Functions{marked: m}, handler)`: the handler hears
// `.Checked(.Function(f))` once for each function of the build's checked
// program that carries the marker of the type of the marker value `m`, in
// the order the program lists them; `m`'s field values filter nothing.
// `meta.events(watch: .Calls{to: f}, handler)`: the handler hears
// `.Checked(.Call(c))` once for each checked call written in the root
// package's own source outside its `build: fn` whose resolved callee is `f`,
// in the order the checker met them. `f` names a function, or an ambient
// call such as `print` that no name hides; a function of the same name
// elsewhere is another callee. Watching only reads, so it uses no Meta
// effect. `m`'s type is resolved here (a marker struct, else E1134), as is
// `f` (else E0104), and the call is checked as the code
//     items: <meta's build's functions carrying that marker, or its calls of f>
//     handler: fn(event: CompilerEvent) = <handler>
//     loop item in items -> handler(.Checked(.Function(item)))   // or .Call(item)
// in a frame of its own, so the handler is checked as a function value of
// that type and the loop runs in the build's own code. The items are the
// hidden `Compiler` methods `events.functions` and `events.calls`, which no
// source can spell.
sema_call_compiler_events: fn(receiver: Expr, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    watch: sema_compiler_events_watch(args) ?? {
        check.diagnostics.push(sema_error("E0104", span, "`meta.events` takes `watch: .Functions{{marked: m}}` or `watch: .Calls{{to: f}}` and a handler", "the watch names what the handler hears: each checked function that carries a marker of the type of the marker value `m`, or each checked call of the function `f`", "write `meta.events(watch: .Functions{{marked: Traced{{}}}}, fn(event) {{ … }})` or `meta.events(watch: .Calls{{to: print}}, fn(event) {{ … }})`"))
        return failed
    }
    ^watched: ""
    if watch.calls {
        watched = sema_compiler_events_call_target(watch.value, check) ?? {
            check.diagnostics.push(sema_error("E0104", expr_span(watch.value), "`.Calls{{to: …}}` takes the name of a function", "a call watch hears the calls whose resolved callee is that function, so it needs a name that resolves to one, or an ambient call such as `print`", "write the function's name, such as `.Calls{{to: print}}`"))
            return failed
        }
    } else {
        marker: sema_compiler_events_marker(watch.value, check) ?? return failed
        watched = marker.name  // copy: the declaration stays with the program's markers
    }
    at: span.start
    items_name: "__jet_events_items_{at}"
    handler_name: "__jet_events_handler_{at}"
    item_name: "__jet_events_item_{at}"
    handler_type: Type.Fn{params: [Type]{Type.Named{name: "CompilerEvent"}}, ret: None, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None}
    watched_name: Expr.Str{parts: [StrPart]{StrPart.Lit{text: watched}}, span: expr_span(watch.value), id: AST_NODE_GENERATED}
    read_method: if watch.calls -> "events.calls" else -> "events.functions"
    read: Expr.MethodCall{receiver: receiver.copy(), method: read_method, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{sema_compiler_events_arg(watched_name, expr_span(watch.value))}, id: AST_NODE_GENERATED}
    heard: Expr.Ident{name: item_name.copy(), span: span, id: AST_NODE_GENERATED}
    variant: if watch.calls -> "Call" else -> "Function"
    item: Expr.EnumLit{type_name: "CheckedItem", variant: variant, variant_span: Val(span), args: [EnumLitArg]{EnumLitArg.Positional{value: heard}}, leading_dot: false, span: span, id: AST_NODE_GENERATED}
    event: Expr.EnumLit{type_name: "CompilerEvent", variant: "Checked", variant_span: Val(span), args: [EnumLitArg]{EnumLitArg.Positional{value: item}}, leading_dot: false, span: span, id: AST_NODE_GENERATED}
    hear: Expr.Call{call: Call{name: handler_name.copy(), name_span: span, type_args: [Type]{}, args: [CallArg]{sema_compiler_events_arg(event, span)}}, id: AST_NODE_GENERATED}
    items: Expr.Ident{name: items_name.copy(), span: span, id: AST_NODE_GENERATED}
    statements: [Stmt]{
        sema_compiler_events_binding(items_name, None, read, span),
        sema_compiler_events_binding(handler_name, Val(handler_type), args[1].expr, span),
        Stmt.For{var: item_name, var_span: span, var2: None, kind: ForKind.In{collection: items, step: None}, body: [Stmt]{Stmt.Expr{expr: hear}}, span: span, arrow_body: false, label: None, auto_vectorization: None},
    }
    return_type: check.scopes.return_type
    mark: sema_scope_mark(check.scopes)
    sema_scope_enter(check.scopes, check.state, "events@{at}")
    checked: sema_check_statements(statements, return_type, check, check.scopes.loop_depth)
    if !checked.complete {
        sema_scope_leave(check.scopes, check.state)
        return failed
    }
    sema_single_use_leave_scope(check)
    sema_scope_rollback(check.scopes, mark)
    ^value: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.InlineBlock{body: checked.value}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// `meta.report(finding, at: c)`: a `meta.events` handler raises the
// Diagnostic value `finding` at the checked call `c` (a CompilerCall). The
// finding's type's `impl Diagnostic` gives its `code` (the type path when it
// writes none) and `tier` (`.Error` when it writes none) as constants, and
// its texts from `what`, `why` and `fix`. A `structured_fix` written as
// `syntax.rewrite(callee: f, replacement: g)` resolves `f` to its function
// identity and `g` to a function here, and a `g` whose parameters or return
// type don't fit `f`'s is refused (E1135). The call is checked as the code
//     finding: <finding>
//     at: CompilerCall = <c>
//     <meta>.report.finding(<code>, <tier>, finding.what(), finding.why(), finding.fix(), <f identity>, <g>, at)
// in a frame of its own (the two rewrite texts are empty without one);
// `report.finding` is a hidden `Compiler` method no source can spell
// (sema_call_compiler_report_finding). The build host keeps the finding with
// the build: an `.Error` finding fails the build, a `.Tidy` one fails
// `jet build` but not a run, and a `.Report` one is for lint alone.
sema_call_compiler_report: fn(receiver: Expr, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    ^shaped: args.len() == 2
    if shaped {
        if args[0].spread || args[1].spread -> shaped = false
        if args[0].label == .Val(label) && label.name != "finding" -> shaped = false
        ^placed: false
        if args[1].label == .Val(label) && label.name == "at" -> placed = true
        if !placed -> shaped = false
    }
    if !shaped {
        check.diagnostics.push(sema_error("E0104", span, "`meta.report` takes a finding and `at:` the call it names", "a finding is a value whose type implements `Diagnostic`, raised at a checked call a `.Calls{{to: f}}` watch heard", "write `meta.report(NoPrintInLib{{}}, at: c)` in the handler that heard `.Checked(.Call(c))`"))
        return failed
    }
    at: span.start
    ^finding_name: "__jet_report_finding_{at}"
    place_name: "__jet_report_at_{at}"
    return_type: check.scopes.return_type
    mark: sema_scope_mark(check.scopes)
    sema_scope_enter(check.scopes, check.state, "report@{at}")
    ^bound: sema_check_statements([Stmt]{sema_compiler_events_binding(finding_name, None, args[0].expr, span)}, return_type, check, check.scopes.loop_depth)
    if !bound.complete {
        sema_scope_leave(check.scopes, check.state)
        return failed
    }
    ^finding_type: Type?{None}
    if sema_scope_resolve(check.scopes, finding_name) == .Val(symbol) -> finding_type = symbol.ty
    facts: sema_compiler_report_facts(finding_type, check) ?? {
        shown: if finding_type == .Val(ty) -> type_name(ty) else -> "this value"
        check.diagnostics.push(sema_error("E0905", expr_span(args[0].expr), "`{shown}` does not implement `Diagnostic`", "`meta.report` raises a diagnostic value; its type's `Diagnostic` impl gives the code, the tier and the texts", "report a value whose type has an `impl Diagnostic`"))
        sema_scope_leave(check.scopes, check.state)
        return failed
    }
    // A `syntax.rewrite` fix names its functions where the finding is
    // reported; the build host offers it only at a call of the callee.
    ^rewrite: SemaCompilerReportRewriteCheck{callee: "", replacement: "", refusal: ""}
    if facts.rewrite == .Val(written) {
        rewrite = sema_compiler_report_rewrite_check(written, check)
    }
    if rewrite.refusal != "" {
        check.diagnostics.push(sema_error("E1135", expr_span(args[0].expr), "`syntax.rewrite` can't call `{rewrite.replacement}` where `{rewrite.callee}` was called: {rewrite.refusal}", "a rewrite keeps each call's arguments and its use of the result, so the replacement takes what the callee takes and returns what it returns", "name a replacement whose parameters and return type match `{rewrite.callee}`, or drop the `structured_fix`"))
        sema_scope_leave(check.scopes, check.state)
        return failed
    }
    finding: Expr.Ident{name: finding_name.move(), span: span, id: AST_NODE_GENERATED}
    ^texts: [CallArg]{
        sema_compiler_events_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: facts.code}}, span: span, id: AST_NODE_GENERATED}, span),
        sema_compiler_events_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: facts.tier}}, span: span, id: AST_NODE_GENERATED}, span),
    }
    loop text in ([String]{"what", "why", "fix"}) {
        texts.push(sema_compiler_events_arg(Expr.MethodCall{receiver: finding.copy(), method: text, method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, id: AST_NODE_GENERATED}, span))
    }
    texts.push(sema_compiler_events_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: rewrite.callee}}, span: span, id: AST_NODE_GENERATED}, span))
    texts.push(sema_compiler_events_arg(Expr.Str{parts: [StrPart]{StrPart.Lit{text: rewrite.replacement}}, span: span, id: AST_NODE_GENERATED}, span))
    texts.push(sema_compiler_events_arg(Expr.Ident{name: place_name.copy(), span: span, id: AST_NODE_GENERATED}, span))
    raise: Expr.MethodCall{receiver: receiver.copy(), method: "report.finding", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: texts, id: AST_NODE_GENERATED}
    statements: [Stmt]{
        sema_compiler_events_binding(place_name, Val(Type.Named{name: "CompilerCall"}), args[1].expr, span),
        Stmt.Expr{expr: raise},
    }
    ^checked: sema_check_statements(statements, return_type, check, check.scopes.loop_depth)
    if !checked.complete {
        sema_scope_leave(check.scopes, check.state)
        return failed
    }
    sema_single_use_leave_scope(check)
    sema_scope_rollback(check.scopes, mark)
    ^body: bound.value.move()
    body.extend(checked.value.move())
    ^value: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.InlineBlock{body: body}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// The hidden `report.finding(code, tier, what, why, fix, rewrite_callee,
// rewrite_to, at)` that `meta.report` checks as: seven Strings and the
// CompilerCall, sent to the build host (JetDriver jet_driver_compiler_report),
// which keeps the finding once the build session accepts the value as one of
// its own while it runs. Reporting only records a finding, so it uses no
// Meta effect.
sema_call_compiler_report_finding: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() != 8 -> return failed
    if !sema_ownership_check_call_receiver(check, receiver, AccessConvention.Read, span) {
        return failed
    }
    ^values: [TExpr]{}
    loop (index, argument) in args {
        required: if index == 7 -> Type.Named{name: "CompilerCall"} else -> Type.String
        value: sema_check_expression(argument.expr, Val(required), check) ?? return failed
        values.push(value)
    }
    if !sema_effect_record_intrinsic_effects(check, "Compiler.report", span, [EffectRowEntry]{}) {
        return failed
    }
    call: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: "report.finding", args: values}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(call, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// `reject(finding, at: part)` in a marker's `check` rule (Func.marker_check,
// whose heard call parameter `context.marker_check_call` names): the rule
// ends with the finding, raised at `part`'s span, the heard call's when no
// `at:` is written. `part` is the CompilerCall, its CompilerName or one of its
// CompilerArgs. A clash between two calls also names the other one,
// `also: other`, with `label: text` under it; it is reported beside the
// call's own errors (sema_call_rule_rejects). The finding's
// `impl Diagnostic` gives its code and tier as for `meta.report`
// (sema_compiler_report_facts). The call is checked, under the rule's
// `CompilerRejection? Err!` result, as
//     finding: <finding>
//     at: <part>.span
//     also: <other>.span
//     label: <text>
//     return CompilerRejection{code: <code>, tier: <tier>, what: finding.what(), why: finding.why(), fix: finding.fix(), span: at, also: Val(also), label: label}
// in a frame of its own: the rule reads `part` without taking it.
sema_call_check_marker_reject: fn(call: Call, expected: Type?, check: ^SemaBodyCheck) -> TExpr? {
    heard: check.context.marker_check_call ?? return None
    ^end: call.name_span.end
    loop argument in call.args -> end = argument.span.end
    span: Span{start: call.name_span.start, end: end}
    ^shaped: call.args.len() >= 1 && call.args.len() <= 4
    if shaped {
        if call.args[0].spread || call.args[0].label != None -> shaped = false
    }
    // The labeled parts, `at:`, `also:` and `label:`, each at most once.
    ^at_part: Expr?{None}
    ^also_part: Expr?{None}
    ^label_part: Expr?{None}
    loop index in 1..<call.args.len() {
        if !shaped -> break
        written: if call.args[index].label == .Val(label) -> "{label.name}" else -> ""
        if call.args[index].spread -> shaped = false
        if {
            written == "at" && at_part == None -> at_part = Val(call.args[index].expr)
            written == "also" && also_part == None -> also_part = Val(call.args[index].expr)
            written == "label" && label_part == None -> label_part = Val(call.args[index].expr)
            else -> shaped = false
        }
    }
    if !shaped {
        check.diagnostics.push(sema_error("E0104", span, "`reject` takes a finding and, optionally, `at:` the part of the call it names, `also:` the part of another call it clashes with and `label:` the text under that part", "a finding is a value whose type implements `Diagnostic`, raised at the heard call or at its name or one of its arguments", "write `reject(BadRoute{{path: text}}, at: call.args[0])`"))
        return None
    }
    at: span.start
    finding_name: "__jet_reject_finding_{at}"
    span_name: "__jet_reject_at_{at}"
    also_name: "__jet_reject_also_{at}"
    label_name: "__jet_reject_label_{at}"
    return_type: Val(Type.Result{ok: Type.Option{inner: Type.Named{name: "CompilerRejection"}}, err: Type.Named{name: "Err"}})
    mark: sema_scope_mark(check.scopes)
    sema_scope_enter(check.scopes, check.state, "reject@{at}")
    part: at_part ?? Expr.Ident{name: "{heard}", span: span, id: AST_NODE_GENERATED}
    placed: Expr.Field{base: part, member: "span", span: span, id: AST_NODE_GENERATED}
    ^bindings: [Stmt]{
        sema_compiler_events_binding(finding_name, None, call.args[0].expr, span),
        sema_compiler_events_binding(span_name, None, placed, span),
    }
    if also_part == .Val(other) {
        bindings.push(sema_compiler_events_binding(also_name, None, Expr.Field{base: other, member: "span", span: span, id: AST_NODE_GENERATED}, span))
    }
    if label_part == .Val(text) {
        bindings.push(sema_compiler_events_binding(label_name, Val(Type.String), text, span))
    }
    ^bound: sema_check_statements(bindings, return_type, check, check.scopes.loop_depth)
    if !bound.complete {
        sema_scope_leave(check.scopes, check.state)
        return None
    }
    ^found: SemaCompilerReportFacts?{None}
    ^shown: "this value"
    if sema_scope_resolve(check.scopes, finding_name) == .Val(symbol) {
        found = sema_compiler_report_facts(symbol.ty, check)
        if symbol.ty == .Val(ty) -> shown = type_name(ty)
    }
    facts: found ?? {
        check.diagnostics.push(sema_error("E0905", expr_span(call.args[0].expr), "`{shown}` does not implement `Diagnostic`", "`reject` ends the rule with a diagnostic value; its type's `Diagnostic` impl gives the code, the tier and the texts", "reject with a value whose type has an `impl {shown}.Diagnostic`"))
        sema_scope_leave(check.scopes, check.state)
        return None
    }
    ^fields: [ExprField]{
        ExprField{name: "code", name_span: span, value: Expr.Str{parts: [StrPart]{StrPart.Lit{text: facts.code}}, span: span, id: AST_NODE_GENERATED}},
        ExprField{name: "tier", name_span: span, value: Expr.Str{parts: [StrPart]{StrPart.Lit{text: facts.tier}}, span: span, id: AST_NODE_GENERATED}},
        sema_call_marker_reject_text(finding_name, "what", span),
        sema_call_marker_reject_text(finding_name, "why", span),
        sema_call_marker_reject_text(finding_name, "fix", span),
    }
    fields.push(ExprField{name: "span", name_span: span, value: Expr.Ident{name: "{span_name}", span: span, id: AST_NODE_GENERATED}})
    ^also_value: Expr.EnumLit{type_name: "", variant: "None", variant_span: Val(span), args: [EnumLitArg]{}, leading_dot: false, span: span, id: AST_NODE_GENERATED}
    if also_part != None {
        also_value = Expr.EnumLit{type_name: "", variant: "Val", variant_span: Val(span), args: [EnumLitArg]{EnumLitArg.Positional{value: Expr.Ident{name: "{also_name}", span: span, id: AST_NODE_GENERATED}}}, leading_dot: false, span: span, id: AST_NODE_GENERATED}
    }
    fields.push(ExprField{name: "also", name_span: span, value: also_value})
    label_value: if label_part != None -> Expr.Ident{name: "{label_name}", span: span, id: AST_NODE_GENERATED} else -> Expr.Str{parts: [StrPart]{StrPart.Lit{text: ""}}, span: span, id: AST_NODE_GENERATED}
    fields.push(ExprField{name: "label", name_span: span, value: label_value})
    rejection: Expr.StructLit{type_name: "CompilerRejection", type_args: [Type]{}, import_ns: None, as_trait: None, fields: fields, inferred: false, span: span, id: AST_NODE_GENERATED}
    ^checked: sema_check_statements([Stmt]{Stmt.Return{value: Val(rejection), span: span}}, return_type, check, check.scopes.loop_depth)
    if !checked.complete {
        sema_scope_leave(check.scopes, check.state)
        return None
    }
    sema_single_use_leave_scope(check)
    sema_scope_rollback(check.scopes, mark)
    ^body: bound.value.move()
    body.extend(checked.value.move())
    ^value: sema_tree_node(Type.Named{name: "Never"}, TExprKind.InlineBlock{body: body}, span)
    sema_expr_expected(value, expected, check.environment.*, check.program.*, check.diagnostics)
}

// The rejection's `text: finding.text()` field.
sema_call_marker_reject_text: fn(finding_name: String, text: String, span: Span) -> ExprField Never! {
    finding: Expr.Ident{name: "{finding_name}", span: span, id: AST_NODE_GENERATED}
    ExprField{name: "{text}", name_span: span, value: Expr.MethodCall{receiver: finding, method: "{text}", method_span: span, owner_type_args: [Type]{}, type_args: [Type]{}, args: [CallArg]{}, id: AST_NODE_GENERATED}}
}

// The code and tier a reported finding's `impl Diagnostic` declares, and the
// `syntax.rewrite(callee: f, replacement: g)` its `structured_fix` writes.
SemaCompilerReportFacts: struct {
    code: String,
    tier: String,
    rewrite: SemaCompilerReportRewrite?,
}

// A finding's `syntax.rewrite`: the callee and replacement as written.
SemaCompilerReportRewrite: struct {
    callee: Expr,
    replacement: Expr,
}

// The `impl Diagnostic` of a finding's type `ty`, written inside the type's
// body or as an `impl T.Diagnostic` in any module, matched by the type's
// registered row (a checked type is spelled by its resolved identity, never
// as written): its `code` constant (else the type path `module.T`) and the
// variant its `tier` constant names (else `Error`). None when the type has
// none.
sema_compiler_report_facts: fn(ty: Type?, check: SemaBodyCheck) -> SemaCompilerReportFacts? Never! {
    finding: ty ?? return None
    graph: check.program.registration_graph
    owner: sema_type_resolve_nominal_row(graph, finding, check.environment.module_identity) ?? return None
    owner_module: graph.modules[owner.module_index].module_name
    owner_name: graph.modules[owner.module_index].nominals[owner.row].symbol.name
    ^reports: [SemaDeriveReport]{}
    if sema_registration_nominal_source_item(graph.modules[owner.module_index].nominals[owner.row].source) == .Val(source) {
        if source == {
            .Struct(definition) -> {
                sema_user_rule_nested_reports(owner_module, owner_name, definition.name_span, definition.trait_impls, reports)
            }
            .Enum(definition) -> {
                sema_user_rule_nested_reports(owner_module, owner_name, definition.name_span, definition.trait_impls, reports)
            }
            .Func(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .CodeModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
    loop module_index in 0..<graph.modules.len() {
        loop item in graph.modules[module_index].program.items {
            if item == .Impl(definition) {
                trait_name: definition.trait_name ?? next
                if trait_name != "Diagnostic" -> next
                // The impl's type resolves from the module that writes it.
                written: Type.Named{name: definition.type_name.copy()}
                row: sema_type_resolve_nominal_row(graph, written, graph.modules[module_index].module_identity) ?? next
                if row.module_index == owner.module_index && row.row == owner.row {
                    reports.push(SemaDeriveReport{module_name: owner_module.copy(), definition: definition})
                }
            }
        }
    }
    if reports.len() == 0 -> return None
    report: reports[0]
    ^code: "{report.module_name}.{report.definition.type_name}"
    ^tier: "Error"
    ^rewrite: SemaCompilerReportRewrite?{None}
    loop constant in report.definition.constants {
        if constant.name == "structured_fix" {
            rewrite = sema_compiler_report_rewrite(constant.value)
        }
        known: sema_derive_static_value(SemaDeriveExpansion{scope: [NamedCtValue]{}, failure: None}, constant.value)
        if constant.name == "code" {
            if known == .Val(.Str(text)) -> code = text
            if known == .Val(.Present(.Str(text))) -> code = text
        }
        if constant.name == "tier" {
            if known == .Val(.Enum(_, variant, _)) -> tier = variant
        }
    }
    Val(SemaCompilerReportFacts{code: code, tier: tier, rewrite: rewrite})
}

// The callee and replacement of a `structured_fix: syntax.rewrite(callee: f,
// replacement: g)` constant (TraitConstants.jet checked its shape).
sema_compiler_report_rewrite: fn(value: Expr) -> SemaCompilerReportRewrite? Never! {
    if value == .MethodCall(receiver, method, _, _, _, args, _) {
        if method != "rewrite" || !sema_trait_constant_is_syntax(receiver) -> return None
        ^callee: Expr?{None}
        ^replacement: Expr?{None}
        // copy: the names are views of the impl's constant, which stays registered.
        loop arg in args {
            label: arg.label ?? return None
            if label.name == "callee" -> callee = Val(arg.expr.copy())
            if label.name == "replacement" -> replacement = Val(arg.expr.copy())
        }
        from: callee ?? return None
        to: replacement ?? return None
        return Val(SemaCompilerReportRewrite{callee: from, replacement: to})
    }
    None
}

// What a finding's `syntax.rewrite` names where the finding is reported:
// the callee's resolved identity (the one a checked call of it records) and
// the replacement as written, with `refusal` empty; or, when the
// replacement can't take the callee's place, the callee as written and why.
SemaCompilerReportRewriteCheck: struct {
    callee: String,
    replacement: String,
    refusal: String,
}

sema_compiler_report_rewrite_check: fn(rewrite: SemaCompilerReportRewrite, check: ^SemaBodyCheck) -> SemaCompilerReportRewriteCheck {
    callee_text: sema_trait_constant_callable_path(rewrite.callee) ?? ""
    replacement_text: sema_trait_constant_callable_path(rewrite.replacement) ?? ""
    identity: sema_compiler_events_call_target(rewrite.callee, check) ?? ""
    from: sema_compiler_report_callable_type(rewrite.callee, check)
    to: sema_compiler_report_callable_type(rewrite.replacement, check)
    refusal: if {
        identity == "" || from == None -> "`{callee_text}` names no function here"
        to == None -> "`{replacement_text}` names no function here"
        else -> sema_compiler_report_rewrite_misfit(from, to) ?? ""
    }
    if refusal != "" {
        return SemaCompilerReportRewriteCheck{callee: callee_text, replacement: replacement_text, refusal: refusal}
    }
    SemaCompilerReportRewriteCheck{callee: identity, replacement: replacement_text, refusal: ""}
}

// The function type `written` names here: a function's declared type, read
// through the scope row's accessor (on a body thread a module function's
// row holds the empty function type); an ambient `print` takes the one text
// a rewritten call passes and returns what a function that declares no result
// does; a path such as `module.name` is checked as an expression whose type
// is a function. None when it names no function.
sema_compiler_report_callable_type: fn(written: Expr, check: ^SemaBodyCheck) -> Type? {
    if written == .Ident(name, _, _) {
        if sema_scope_resolve_index(check.scopes, name) == .Val(index) {
            if check.scopes.bindings[index].symbol.kind != SymbolKind.Function -> return None
            ty: sema_scope_binding_type(check.environment.*, check.scopes, index)
            if ty == .Val(.Fn(_, _, _, _, _, _)) -> return ty
            return None
        }
        if SEMA_COMPILER_EVENTS_AMBIENT_CALLS.contains(name) {
            return Val(Type.Fn{params: [Type]{Type.String}, ret: Val(sema_checked_return_type(None, false)), effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None})
        }
        return None
    }
    // The check only reads the name's type; what it reports is dropped.
    ^unreported: [Diagnostic]{}
    sema_body_check_swap_diagnostics(check, unreported)
    written_checked: sema_check_expression(written, None, check)
    sema_body_check_swap_diagnostics(check, unreported)
    ^checked: written_checked ?? return None
    if unreported.len() > 0 -> return None
    // The checked expression's type moves out; the expression itself is dropped.
    if checked.ty == .Fn(_, _, _, _, _, _) -> return Val(checked.ty.move())
    None
}

// Why a call of function type `from` can't call `to` instead with the same
// arguments and the same use of its result: `to` takes fewer arguments, an
// argument of another type, a further argument without a default, or
// returns another type. None when it fits.
sema_compiler_report_rewrite_misfit: fn(from: Type?, to: Type?) -> String? Never! {
    callee_type: from ?? return Val("it is not a function")
    replacement_type: to ?? return Val("it is not a function")
    if callee_type == .Fn(from_params, from_ret, _, _, _, _) {
        if replacement_type == .Fn(to_params, to_ret, _, _, to_metadata, _) {
            if to_params.len() < from_params.len() {
                return Val("it takes {to_params.len()} argument(s) and the call passes {from_params.len()}")
            }
            loop index in 0..<from_params.len() {
                if type_name(to_params[index]) != type_name(from_params[index]) {
                    return Val("its argument {index + 1} is `{type_name(to_params[index])}` and the call passes `{type_name(from_params[index])}`")
                }
            }
            loop index in from_params.len()..<to_params.len() {
                ^defaulted: false
                if to_metadata == .Val(metadata) {
                    if index < metadata.defaults.len() && metadata.defaults[index] != None {
                        defaulted = true
                    }
                }
                if !defaulted {
                    return Val("its argument {index + 1} has no default and the call doesn't pass it")
                }
            }
            returned: sema_compiler_report_returned(to_ret)
            expected: sema_compiler_report_returned(from_ret)
            if returned != expected {
                return Val("it returns `{returned}` and the call's result is `{expected}`")
            }
            return None
        }
    }
    Val("it is not a function")
}

sema_compiler_report_returned: fn(ret: Type?) -> String Never! {
    if ret == .Val(ty) -> return type_name(ty)
    "Unit"
}

// What a `meta.events` watch names: the marker value `m` of
// `.Functions{marked: m}`, or the callee `f` of `.Calls{to: f}` (`calls`).
SemaCompilerEventsWatch: struct {
    calls: Bool,
    value: Expr,
}

// The watch of `meta.events(watch: …, handler)`, or None when the call has
// another shape.
sema_compiler_events_watch: fn(args: [CallArg]) -> SemaCompilerEventsWatch? Never! {
    if args.len() != 2 || args[0].spread || args[1].spread -> return None
    watch: if args[0].label == .Val(label) -> label.name.copy() else -> ""
    if watch != "watch" -> return None
    if args[1].label == .Val(label) {
        if label.name != "handler" -> return None
    }
    if args[0].expr == .EnumLit(_, variant, _, watched, leading_dot, _, _) {
        if !leading_dot || watched.len() != 1 -> return None
        if watched[0] == .Named(label, value) {
            if variant == "Functions" && label == "marked" {
                return Val(SemaCompilerEventsWatch{calls: false, value: value.copy()})
            }
            if variant == "Calls" && label == "to" {
                return Val(SemaCompilerEventsWatch{calls: true, value: value.copy()})
            }
        }
    }
    None
}

// The ambient calls a call watch can name: each call site records the
// call's name as its callee (Direct.jet sema_call_ambient_record_io).
SEMA_COMPILER_EVENTS_AMBIENT_CALLS: [String]{"print"}

// The resolved identity of a call watch's callee `f`, the identity a checked
// call of it records: a function's definition identity, or the name of an
// ambient call no name in scope hides. None when `f` names neither.
sema_compiler_events_call_target: fn(target: Expr, check: SemaBodyCheck) -> String? {
    if target == .Ident(name, _, _) {
        if sema_scope_resolve(check.scopes, name) == .Val(symbol) {
            if symbol.kind != SymbolKind.Function -> return None
            key: sema_scope_resolve_key(check.scopes, name) ?? return None
            graph: check.program.registration_graph
            // Snapshot: no registered module places the key; it reads as written.
            if graph.mode == .Snapshot -> return Val(key)
            return Val(sema_compiler_identity(graph, key))
        }
        if SEMA_COMPILER_EVENTS_AMBIENT_CALLS.contains(name) -> return Val(name.copy())
    }
    None
}

sema_compiler_events_arg: fn(value: Expr, span: Span) -> CallArg Never! {
    CallArg{convention: AccessConvention.Read, expr: value.copy(), span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false}
}

sema_compiler_events_binding: fn(name: String, ty: Type?, init: Expr, span: Span) -> Stmt Never! {
    ^typed_span: Span?{None}
    if ty != None -> typed_span = Val(span)
    Stmt.Val{binding: Binding{mutable: false, markers: [Marker]{}, reactive_upgrade: false, meta: None, name: name.copy(), name_span: span, sigil_span: None, pattern: None, ty: ty.copy(), ty_span: typed_span, init: init.copy(), is_comptime: false, ct: None, uninit: false, arena_view: false, string_view: false, gc_promotion: None, gc_transferred: false}}
}

// The marker struct whose value `m` is: the declaration of the struct `m`
// checks as, found through its registered type, so a build program that
// names the root's types through their module (`main.Traced`) finds the same
// struct; else the struct `m` writes (`Traced{}`), by name. Anything else is
// E1134.
sema_compiler_events_marker: fn(marked: Expr, check: ^SemaBodyCheck) -> MarkerDecl? {
    watched: sema_check_expression(marked, None, check) ?? return None
    ^written: ""
    if marked == .StructLit(type_name, _, import_ns, _, _, _, _, _) {
        written = if import_ns == .Val(namespace) -> "{namespace}.{type_name}" else -> type_name.copy()
    } else if watched.ty == .Named(name) { written = name }
    ^declaration: MarkerDecl?{None}
    graph: check.program.registration_graph
    if sema_type_resolve_nominal_row(graph, watched.ty, check.environment.module_identity) == .Val(row) {
        declaration = sema_marker_module_declaration_by_span(graph.modules[row.module_index].program.items, graph.modules[row.module_index].nominals[row.row].symbol.span)
    }
    if declaration == None && written != "" {
        declaration = sema_marker_module_resolve(graph, check.environment.module_identity, written).declaration
    }
    if declaration == None {
        shown: if written == "" -> "this value" else -> "`{written}`"
        check.diagnostics.push(sema_error("E1134", expr_span(marked), "{shown} is not a marker", "`meta.events` watches the functions that carry the marker of the watched value's type, so the value is a marker struct's (one with an `impl Marker` block)", "watch a marker struct value visible here, as in `.Functions{{marked: Traced{{}}}}`"))
    }
    declaration
}

// The hidden `Compiler` methods `events.functions` and `events.calls` that
// `meta.events` reads (a written method name has no dot, so no source
// spells them). The argument of `events.functions` is the watched marker's
// declared name, which the build host matches against the markers of the
// value's checked program (JetEval jet_eval_reflection_marked_functions);
// that of `events.calls` is the watched callee's identity, which it matches
// against the callees of the root's checked calls (JetEval
// jet_eval_reflection_calls_to). The host answers once the build session
// accepts the value as one of its own while it runs.
sema_call_compiler_events_read: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() != 1 -> return failed
    if !sema_ownership_check_call_receiver(check, receiver, AccessConvention.Read, span) {
        return failed
    }
    name: sema_check_expression(args[0].expr, Val(Type.String), check) ?? return failed
    // Watching only reads the checked program, so it uses no Meta effect.
    if !sema_effect_record_intrinsic_effects(check, "Compiler.events", span, [EffectRowEntry]{}) {
        return failed
    }
    element: if method == "events.calls" -> "CompilerCall" else -> "FunctionInfo"
    items: Type.List{element: Type.Named{name: element}}
    call: sema_tree_node(items, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: method, args: [TExpr]{name}}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(call, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// `meta.stages()`: the moments the build's program reached, each its
// `core.compiler.Event`, in their fixed order, which the build host reads
// from the value's checked program (JetDriver jet_driver_stages). Reading
// them changes nothing, so it uses no Meta effect. The list's type is
// core.compiler's, which the program loads with `use core.compiler`.
sema_call_compiler_stages: fn(receiver: Expr, receiver_value: TExpr, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    if args.len() != 0 {
        check.diagnostics.push(sema_error("E0104", span, "`Compiler.stages` expects 0 arguments, got {args.len()}", "`meta.stages()` lists every moment the build's program reached", "write `meta.stages()`"))
        return failed
    }
    if !sema_ownership_check_call_receiver(check, receiver, AccessConvention.Read, span) {
        return failed
    }
    if sema_scope_checked_type_row_qualified(check.program.*, COMPILER_EVENT_TYPE) == None {
        check.diagnostics.push(sema_error("E0119", span, "`meta.stages()` lists `compiler.Event` values, a type this program doesn't load", "the moments are core.compiler's `Event` enum, which only a program that uses core.compiler can name", "add `compiler: core.compiler` to the file's `use` block"))
        return failed
    }
    if !sema_effect_record_intrinsic_effects(check, "Compiler.stages", span, [EffectRowEntry]{}) {
        return failed
    }
    items: Type.List{element: Type.Named{name: COMPILER_EVENT_TYPE}}
    call: sema_tree_node(items, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: "stages", args: [TExpr]{}}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(call, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// The name in a package identity (`package:<length>:<name>:…`), as the build
// session reads it (build_session_package_dir); the identity
// itself when it has none.
sema_build_package_name: fn(identity: String) -> String Never! {
    parts: identity.split(":").to_list()
    if parts.len() >= 3 && parts[0] == "package" && (Int.parse(parts[1]) ?? -1) == parts[2].len() {
        return parts[2].copy()
    }
    identity.copy()
}

// The function calling a `Compiler` method and where, "`f` at file:line",
// which a report from what the call made names: it tells the root's own
// build from a dependency's function the root handed the value to.
sema_call_compiler_producer: fn(check: SemaBodyCheck, span: Span) -> TExpr Never! {
    location: sema_expression_panic_location(check.environment.*, check.program.*, check.scopes, span)
    sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: "`{location.function}` at {location.file}:{location.line}"}}}, span)
}

// A `b.generate` template's or a `#code` value's formatted items and the
// build locals it splices. Each `#{name}` naming a build local is formatted as
// that splice's marker, which the build host replaces when the build runs
// (JetDriver jet_driver_build_generate, jet_driver_code_pasted). In a `b.generate` template the
// marker is a whole Int literal, replaced by the local's value written as a
// Jet literal. In a `#code` value the local is a String, bound as text: the
// marker stands as the name or type it pastes, replaced by the local's text.
SemaBuildGenerateSplices: struct {
    source: String,
    markers: [Int],
    args: [CallArg],
    values: [TExpr],
}

// The first splice marker, a 19-digit Int; every marker shares the prefix,
// and a template that spells the prefix itself is refused.
SEMA_BUILD_GENERATE_SPLICE_BASE: 4611686018427387000

SEMA_BUILD_GENERATE_SPLICE_PREFIX: "4611686018427387"

SEMA_BUILD_GENERATE_SPLICE_LIMIT: 1000

sema_build_generate_format: fn(items: [Item]) -> String {
    ^generated_program: ast_program()
    generated_program.items = items
    jfmt_format_program_with_tokens(generated_program, "", [Token]{}, false)
}

// The generated body is expanded and formatted under an empty compile-time
// scope. A `#{name}` still unbound there that names a build local is spliced:
// the body is expanded again with each such name bound to its marker, so the
// marker stands exactly where the value goes. `named` is a `#code` value's
// paste of a name or type, and is otherwise a value literal.
sema_build_generate_splices: fn(body: [DeriveBodyItem], span: Span, named: Bool, check: ^SemaBodyCheck) -> SemaBuildGenerateSplices? {
    items: sema_derive_expand_template_body(body, [NamedCtValue]{}, check.diagnostics) ?? return None
    ^splices: SemaBuildGenerateSplices{source: sema_build_generate_format(items), markers: [Int]{}, args: [CallArg]{}, values: [TExpr]{}}
    scope: sema_build_splice_scope(splices, span, named, check) ?? return None
    if splices.markers.len() == 0 -> return Val(splices)
    spliced: sema_derive_expand_template_body(body, scope, check.diagnostics) ?? return None
    splices.source = sema_build_generate_format(spliced)
    Val(splices)
}

// Each `#{name}` of `splices.source` that names a build local, checked and
// recorded as a splice of `splices`; the scope that binds each one to its
// marker, None when a local can't be spliced.
sema_build_splice_scope: fn(splices: ^SemaBuildGenerateSplices, span: Span, named: Bool, check: ^SemaBodyCheck) -> [NamedCtValue]? {
    owner: if named -> "`#code`" else -> "`b.generate`"
    ^scope: [NamedCtValue]{}
    loop name in sema_build_generate_splice_names(splices.source) {
        if sema_scope_resolve_index(check.scopes, name) == None -> next
        local: Expr.Ident{name: name, span: span, id: AST_NODE_GENERATED}
        value: sema_check_expression(local, None, check) ?? return None
        if named && value.ty != Type.String {
            check.diagnostics.push(sema_error("E3502", span, "`#code` can't paste `#{{{name}}}`, a `{type_name(value.ty)}`", "a paste in a `Code` value writes a name or a type, and a build spells one as a String", "paste a String that spells the name or type, built from `{name}`"))
            return None
        }
        if !named && !sema_build_generate_splice_type(value.ty) {
            check.diagnostics.push(sema_error("E3502", span, "`b.generate` can't splice `#{{{name}}}`, a `{type_name(value.ty)}`", "a build local enters the generated items as a literal, and only String, Int and Bool values and lists of them have one", "splice a String, Int or Bool built from `{name}`"))
            return None
        }
        marker: SEMA_BUILD_GENERATE_SPLICE_BASE + splices.markers.len()
        bound: if named -> CtValue.Str{value: "{marker}"} else -> CtValue.Int{value: marker}
        scope.push(NamedCtValue{name: name, value: bound})
        splices.markers.push(marker)
        splices.args.push(CallArg{convention: AccessConvention.Read, expr: local, span: span, flags: AST_EMPTY_CALL_ARG_FLAGS, label: None, spread: false})
        splices.values.push(value)
    }
    if splices.markers.len() == 0 -> return Val(scope)
    if splices.markers.len() > SEMA_BUILD_GENERATE_SPLICE_LIMIT || splices.source.contains(SEMA_BUILD_GENERATE_SPLICE_PREFIX) {
        check.diagnostics.push(sema_error("E3502", span, "{owner} can't splice build locals into these items", "the items splice more than {SEMA_BUILD_GENERATE_SPLICE_LIMIT} build locals, or already spell the splice marker prefix `{SEMA_BUILD_GENERATE_SPLICE_PREFIX}`", "splice fewer build locals, or write that number another way"))
        return None
    }
    Val(scope)
}

// The names of the `#{name}` splices in formatted items, in first-use order.
sema_build_generate_splice_names: fn(text: String) -> [String] Never! {
    ^names: [String]{}
    bytes: text.bytes()
    ^index: 0
    loop index + 1 < bytes.len() {
        if (bytes[index] != U8{35}) || (bytes[index + 1] != U8{123}) {
            index += 1
            next
        }
        start: index + 2
        ^end: start
        loop end < bytes.len() && sema_build_generate_name_byte(bytes[end], end > start) -> end += 1
        if end > start && end < bytes.len() && (bytes[end] == U8{125}) {
            name: String.from_bytes(bytes[start..<end]) ?? ""
            ^seen: false
            loop known in names {
                if known == name -> seen = true
            }
            if !seen && name.count_bytes() > 0 -> names.push(name)
        }
        index = end
    }
    names
}

sema_build_generate_name_byte: fn(byte: U8, digits: Bool) -> Bool Never! {
    (byte >= U8{97} && byte <= U8{122}) || (byte >= U8{65} && byte <= U8{90}) || byte == U8{95} || (digits && byte >= U8{48} && byte <= U8{57})
}

sema_build_generate_splice_type: fn(ty: Type) -> Bool Never! {
    if ty == {
        .String | .Int | .Bool -> true
        .List(element) -> sema_build_generate_splice_type(element)
        .Float | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> false
    }
}

// #5005 build options (BuildOptions.jet): `b.optimize(.O2)` or
// `b.debug_info(false)` sets a row's value in fn build; `b.pin(.optimize,
// .O2)` sets and pins it, so a flag can't change it. The session's `option`
// (`pin` for a pin) receives the row name and the value's table spelling
// (`optimize`, `O2`).
sema_call_build_option: fn(receiver: Expr, receiver_value: TExpr, method: String, args: [CallArg], span: Span, expected: Type?, check: ^SemaBodyCheck) -> SemaMethodSpecialCheck {
    failed: SemaMethodSpecialCheck{handled: true, value: None}
    pinned: method == "pin"
    wanted: if pinned -> 2 else -> 1
    shape: if pinned -> "b.pin(.optimize, .O2)" else -> sema_build_option_call_shape(method, method, false)
    takes: if pinned -> "a build option and one of its values" else -> "one value"
    if args.len() != wanted {
        check.diagnostics.push(sema_error("E3502", span, "`b.{method}` takes {takes}, got {args.len()} arguments", "a build option call names one value of the option's row", "write `{shape}`"))
        return failed
    }
    loop argument in args {
        if argument.label != None || argument.spread || argument.flags.template_items != None {
            check.diagnostics.push(sema_error("E3502", argument.span, "`b.{method}` takes positional arguments", "a build option is written as `.name`, and its value as its row spells it", "write `{shape}`"))
            return failed
        }
    }
    ^name: method.copy()
    if pinned {
        // A lower-case `.optimize` parses as the implicit-receiver member
        // shorthand (a Field of the empty name), not as an enum value.
        name = ""
        if args[0].expr == .Field(base, member, _, _) {
            if base == .Ident(base_name, _, _) {
                if base_name.len() == 0 && build_option_refusal(member) == .Val(refusal) {
                    check.diagnostics.push(sema_error("E3502", args[0].span, "`.{member}` isn't a build option", refusal.law, "remove the `b.pin` call"))
                    return failed
                }
                if base_name.len() == 0 && build_option_row(member) != None -> name = member.copy()
            }
        }
        if name.len() == 0 {
            check.diagnostics.push(sema_error("E3502", args[0].span, "`b.pin` names a build option first", "the first argument is the option a pin holds, such as `.optimize`", "write `{shape}`"))
            return failed
        }
    }
    row: build_option_row(name) ?? return failed
    argument: args[wanted - 1]
    shape_fix: "write `{sema_build_option_call_shape(method, name, pinned)}`"
    value: sema_build_option_value(row, argument.expr) ?? {
        check.diagnostics.push(sema_error("E3502", argument.span, "this isn't a value of build option `{name}`", "`{name}` takes {build_option_variants_text(row)}", shape_fix))
        return failed
    }
    if !build_option_accepts(row, value) {
        check.diagnostics.push(sema_error("E3502", argument.span, "this isn't a value of build option `{name}`", "`{name}` takes {build_option_variants_text(row)}, each one line and none empty", shape_fix))
        return failed
    }
    // Only the value is an ordinary argument: a pin's option name is a row
    // name, not an expression of the body; a List row's literal, a Duration
    // row's Time literal and a Hook or Hooks row's hook names read nothing.
    if row.kind != BuildOptionKind.List && row.kind != BuildOptionKind.Duration && row.kind != BuildOptionKind.Hook && row.kind != BuildOptionKind.Hooks {
        params: [SemaCallParam]{SemaCallParam{label: "", name: "", zone: ParamZone.PositionalOnly, default: None, default_ref: None, convention: AccessConvention.Read, ty: Val(Type.String), variadic: false}}
        ^ordinary: [CallArg]{argument.copy()}
        ownership: sema_ownership_check_method_call(check, "Build.{method}", receiver, AccessConvention.Read, params, ordinary, span)
        if !ownership.accepted || !ownership.complete -> return failed
    }
    values: [TExpr]{
        sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: name}}}, args[0].span),
        sema_tree_node(Type.String, TExprKind.StrLit{parts: [TStrPart]{TStrPart.Literal{text: value}}}, argument.span),
    }
    sent: if pinned -> "pin" else -> "option"
    result: sema_tree_node(Type.Named{name: "Unit"}, TExprKind.HostCall{call: THostCall.Method{receiver: receiver_value, method: sent, args: values}}, span)
    SemaMethodSpecialCheck{handled: true, value: sema_expr_expected(result, expected, check.environment.*, check.program.*, check.diagnostics)}
}

// The row value `expr` writes: `false` for a Bool row, `.O2` for a Level or
// Choice row, and, since the value reaches the build session as text, a string
// literal for a Text row, a list literal of them for a List row, a Time
// literal (`10min`) for a Duration row, a hook function's path
// (`tools.relink`) or `.Default` for a Hook row and a list literal of hook
// paths for a Hooks row.
sema_build_option_value: fn(row: BuildOptionRow, expr: Expr) -> String? {
    if row.kind == {
        .Bool -> {
            if expr == .Bool(written, _, _) -> return Val("{written}")
        }
        .Choice | .Level -> {
            if expr == .EnumLit(_, variant, _, enum_args, leading_dot, _, _) {
                if leading_dot && enum_args.len() == 0 {
                    return build_option_value_of_variant(row, variant)
                }
            }
        }
        .Text -> return sema_build_option_literal(expr)
        .List -> {
            if expr == .ListLit(elements, _, _) {
                ^items: [String]{}
                loop element in elements {
                    item: sema_build_option_literal(element) ?? return None
                    items.push(item)
                }
                return Val(build_option_list_value(items))
            }
        }
        .Duration -> return sema_build_duration_literal(expr)
        .Hook -> {
            if expr == .EnumLit(_, variant, _, enum_args, leading_dot, _, _) {
                if leading_dot && enum_args.len() == 0 && variant == "Default" {
                    return Val(BUILD_OPTION_HOOK_DEFAULT)
                }
                return None
            }
            return sema_build_hook_path(expr)
        }
        .Hooks -> {
            if expr == .ListLit(elements, _, _) {
                ^items: [String]{}
                loop element in elements {
                    item: sema_build_hook_path(element) ?? return None
                    items.push(item)
                }
                return Val(build_option_list_value(items))
            }
        }
    }
    None
}

// The path a hook function is named by (`tools.relink`): its module and its
// name, read from the field chain as written.
sema_build_hook_path: fn(expr: Expr) -> String? {
    if expr == .Field(base, member, _, _) {
        if base == .Ident(first, _, _) {
            if first.len() == 0 -> return None
            return Val("{first}.{member}")
        }
        head: sema_build_hook_path(base) ?? return None
        return Val("{head}.{member}")
    }
    None
}

// The text of a string literal without interpolation.
sema_build_option_literal: fn(expr: Expr) -> String? {
    if expr == .Str(parts, _, _) {
        ^text: ""
        loop part in parts {
            if part == .Lit(piece) -> text = "{text}{piece}" else -> return None
        }
        return Val(text)
    }
    None
}

// The text of a Time literal written as a whole number and a unit (`10min`),
// as build_option_duration_ms reads it.
sema_build_duration_literal: fn(expr: Expr) -> String? {
    if expr == .UnitLit(raw, _, _, suffix, _, _, _) -> return Val("{raw}{suffix}")
    None
}

// `b.debug_info(false)`, `b.pin(.optimize, .O2)`, `b.output_dir("dist")`,
// `b.libs(["z"])`: a call of `method` that sets row `name` to an example
// value, as the fix of a malformed call.
sema_build_option_call_shape: fn(method: String, name: String, pinned: Bool) -> String Never! {
    row: build_option_row(name) ?? return "b.pin(.optimize, .O2)"
    values: build_option_method_values(row)
    example: if row.kind == {
        .Text -> "\"dist\""
        .List -> "[\"z\"]"
        .Duration -> "10min"
        .Hook -> "tools.relink"
        .Hooks -> "[tools.sign]"
        .Choice | .Level | .Bool -> build_option_argument(row, values[values.len() - 1])
    }
    if pinned -> return "b.pin(.{name}, {example})"
    "b.{method}({example})"
}
