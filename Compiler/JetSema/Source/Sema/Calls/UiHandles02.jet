pub fn e2408(field: String, span: Span) -> Diagnostic {
    Diagnostic.error("E2408", "`#[Flatten]` on `{field}` needs a struct-typed field", "flatten splices another struct's keys into this object, so the field must be a `#[Codable]` struct — not a primitive, list, or map", "give `{field}` a `#[Codable]` struct type, or drop `#[Flatten]`", Val(span))
}
