// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:10
pub fn is_no_os_forbidden(module: String) -> Bool {
    return if module == {
        "core.files" | "core.watcher" | "core.term" | "core.net" | "core.net.tls" | "core.tasks" | "core.process" | "core.time" | "core.http" | "core.log" | "core.crypto.vault" -> true
        else -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:22
pub fn module_short_name(module: String) -> String {
    parts :: module.split(".").to_list()
    if parts.len() == 0 -> module else -> parts[parts.len() - 1]
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:27
pub fn no_os_hint(module: String) -> String {
    return if module == {
        "core.files" -> "Embed the data at compile time with `@embed(\"file\")`, or select a hosted target."
        "core.net" | "core.net.tls" | "core.http" -> "No-OS targets have no network stack. Select a hosted target, or use a declared network provider."
        "core.tasks" -> "OS threads are not available without an OS. Use cooperative or interrupt-driven concurrency."
        "core.term" -> "Standard I/O requires an OS. Use a declared IO provider or select a hosted target."
        "core.process" | "core.time" -> "System calls are not available on a no-OS target. Select a hosted target or declare the required provider."
        "core.log" -> "The log module writes to stderr (an OS resource). Use a declared IO provider or select a hosted target."
        else -> "Select a hosted target, or replace this call with a core-level alternative."
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:51
pub fn unknown_core_item(module: String, name: String, span: Span) -> Diagnostic {
    if module == "core.time" && name == "clock" -> return Diagnostic.error("E1004", "`time.clock` was retired", "deterministic fresh values use a type-owned `new` constructor (D-SHAPE-CTORVERB1)", "use `Clock.new(seed)`", Val(span))
    if module == "core.time.expiring" && name == "new" -> return Diagnostic.error("E1004", "`expiring.new` was retired", "fresh values use a type-owned `new` constructor (D-SHAPE-CTORVERB1)", "use `ExpiringValue.new(value, ttl, clock)`", Val(span))
    if module == "core.event" && name == "policy_async" -> return Diagnostic.error("E1004", "`event.policy_async` was retired", "a synchronous `Event<T>` cannot provide real queued dispatch; `AsyncEvent<T, E>` is the sole asynchronous event model", "use `event.async_result<T, E>(AsyncPolicy.{ capacity: n, overflow: .Block }, FailurePolicy.Collect)`", Val(span))
    if module == "core.crypto" && name == "constant_time_eq" -> return Diagnostic.error("E1004", "`crypto.constant_time_eq` was retired", "`eq` is not one of Jet's blessed API abbreviations", "use `crypto.constant_time_equal_bytes(a, b)`", Val(span))
    if module == "core.crypto" {
        if name.strip_suffix("_bytes") == .Val(algorithm) {
            digest :: if algorithm == {"sha256" | "blake3" -> "Digest256" "sha512" -> "Digest512" else -> ""}
            if digest != "" -> return Diagnostic.error("E1004", "`crypto.{name}` was retired", "`crypto.{algorithm}` returns `{digest}`, so the representation is explicit", "use `crypto.{algorithm}(bytes).hex()` for text or `.bytes()` for raw bytes", Val(span))
        }
    }
    items :: core_module_items(module)
    loop item in items {
        if item == name -> return Diagnostic.error("E1004", "`{module}` exposes `{name}`, but not in this position", "standard library modules expose a fixed set of public items, each reachable only where its surface declares", "import it directly with `use {module}.[{name}]`", Val(span))
    }
    if submodule_path_hint(module, name, span) == .Val(diagnostic) -> return diagnostic
    suggestion :: suggest_field(name, items)
    fix := if items.len() == 0 -> "import a specific core module, like `import core.files as fs;`" else -> "use one of: " + items.join(", ")
    if suggestion == .Val(candidate) -> fix = "did you mean `{candidate}`?"
    diagnostic := Diagnostic.error("E1004", "`{module}` has no item `{name}`", "standard library modules expose a fixed set of public items", fix, Val(span))
    if suggestion == .Val(candidate) -> diagnostic = diagnostic.with_edit(TextEdit{span: span, new_text: candidate})
    diagnostic
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:162
fn submodule_path_hint(module: String, name: String, span: Span) -> Diagnostic? {
    why :: "Core is one nested tree, so a name under this module can belong to a submodule instead of the module itself"
    nested :: "{module}.{name}"
    if Syntax.is_known_core_module(nested) {
        items :: core_module_items(nested)
        fix :: if items.len() > 0 -> "`{nested}` is a submodule, so name an item on it: `{nested}.{items[0]}`" else -> "`{nested}` is a submodule; import it with `import {nested};`"
        return Val(Diagnostic.error("E1004", "`{module}` has no item `{name}`", why, fix, Val(span)))
    }
    prefix :: "{module}."
    loop candidate in Syntax.KNOWN_CORE_MODULES {
        if !candidate.starts_with(prefix) -> next
        loop item in core_module_items(candidate) {
            if item == name -> return Val(Diagnostic.error("E1004", "`{module}` has no item `{name}`", why, "`{name}` lives in the submodule `{candidate}`, so write `{candidate}.{name}`", Val(span)))
        }
    }
    None
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:197
pub fn unknown_core_module(module: String, span: Span) -> Diagnostic {
    if Syntax.retired_core_module_diagnostic(module, span) == .Val(diagnostic) -> return diagnostic
    Diagnostic.error("E1001", "there is no core module `{module}`", "`core` is compiler-known in M10, and only the frozen core modules exist", "import one of: " + Syntax.core_modules_list(), Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:213
pub fn e2411(ty: Type, encode: Bool, span: Span) -> Diagnostic {
    shown :: ty.show()
    verb :: if encode -> "serialized" else -> "decoded"
    marker :: if encode -> "`#[Codable]` or `#[Encode]`" else -> "`#[Codable]` or `#[Decode]`"
    Diagnostic.error("E2411", "`{shown}` can't be {verb}", "only types that opt in (and their fields) have a wire form; `{shown}` does not", "add {marker} to `{shown}`, or remove it from the encoded value", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:230
fn e2411_unknown_union_shape(union_ty: String, member: String, span: Span) -> Diagnostic {
    Diagnostic.error("E2411", "union `{union_ty}` can't be decoded — `{member}` has no compiler-known wire shape", "`{member}` uses a custom or imported decoder; anonymous unions need each member's outer wire shape before codegen", "use a compiler-derived codec, a configured tagged enum, or a #CodableAsBase distinct type", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:247
pub fn e2415(union_ty: String, a: String, b: String, shape: String, span: Span) -> Diagnostic {
    Diagnostic.error("E2415", "Union `{union_ty}` can't be decoded — `{a}` and `{b}` share wire shape `{shape}`", "anonymous-union decode picks a member by wire shape; two members with the same shape would force an arbitrary order", "use a named enum with an explicit tag, or change the members so each has a distinct wire shape", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:257
fn validate_union_decode_shapes(items: [Item], ty: Type, span: Span, out: &[Diagnostic]) {
    // Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:263
    fn label(ty: Type) -> String {
        text := ty.show().trim_matches('`') // #4303
        text.to_string()
    }
    if ty == .Union(members) {
        seen := [SerdeWireShape:Type]{} // GATE #4499: exact enum map keys.
        reported_pairs := [(String, String):Bool]{} // GATE #4499: exact tuple map keys.
        loop member in members {
            shapes :: resolved_decode_wire_shapes(items, member) ?? {
                &out.push(e2411_unknown_union_shape(ty.show(), label(member), span))
                next
            }
            loop shape in shapes {
                if seen.get(shape) == .Val(previous) {
                    pair :: (label(previous), label(member))
                    if !reported_pairs.contains_key(pair) {
                        reported_pairs[pair] = true
                        &out.push(e2415(ty.show(), pair.0, pair.1, shape.name(), span))
                    }
                } else {
                    seen[shape] = member
                }
            }
        }
    }
    if ty == {
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .FixedList(inner, _) -> validate_union_decode_shapes(items, inner, span, &out)
        .Map(key, _, value) | .Result(key, value) -> {
            validate_union_decode_shapes(items, key, span, &out)
            validate_union_decode_shapes(items, value, span, &out)
        }
        .Apply(_, args) | .Union(args) -> {
            loop arg in args -> validate_union_decode_shapes(items, arg, span, &out)
        }
        .Tuple(fields) -> {
            loop field in fields -> validate_union_decode_shapes(items, field.ty, span, &out)
        }
        .Fn(params, ret, _, _) -> {
            loop param in params -> validate_union_decode_shapes(items, param, span, &out)
            if ret == .Val(value) -> validate_union_decode_shapes(items, value, span, &out)
        }
        else -> {}
    }
}
