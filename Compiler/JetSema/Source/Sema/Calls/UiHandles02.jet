// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:805
pub fn reactive_bad_value_type(kind: String, ty: Type, span: Span) -> Diagnostic {
    Diagnostic.error("E2913", "a reactive {kind} can't hold a " + ty.show(), "signals and derived values hold ordinary data so they can be copied to dependents", "use a data value (number, text, list, struct, …); wrap behaviour in `reactive.effect` instead", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:817
pub fn overflow_opt_in_error(kind: String, span: Span) -> Diagnostic {
    Diagnostic.error("E1005", "`{kind}` must wrap a single integer `+`, `-`, `*`, or `/`", "the overflow opt-ins apply to one arithmetic operation on whole numbers", "write it around one operation, e.g. `{kind}(a + b)`", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:829
pub fn numeric_const_type(nt: Type, member: String) -> Type? {
    return if member == {
        "MIN" | "MAX" -> Val(nt)
        "INFINITY" | "NEG_INFINITY" | "NAN" | "EPSILON" -> if nt.is_float() -> Val(nt) else -> None
        else -> None
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:839
pub fn int_range_error(signed: Bool, bits: U8, span: Span) -> Diagnostic {
    (lo, hi) :: int_range(signed, bits)
    spelling :: int_spelling(signed, bits)
    article :: if signed -> "an" else -> "a"
    why :: if !signed && bits == 8 -> "binary APIs use one byte per value" else -> "{article} `{spelling}` is a fixed-width number — values outside its range can't fit"
    Diagnostic.error("E1003", "{article} `{spelling}` holds {lo}..{hi}", why, "use a number from {lo} through {hi}", Val(span))
}
