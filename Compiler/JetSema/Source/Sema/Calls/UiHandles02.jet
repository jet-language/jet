pub fn e2409(style: String, span: Span) -> Diagnostic {
    Diagnostic.error("E2409", "`#[RenameAll({style})]` isn't a known casing style", "the wire-casing menu is `camel`, `snake`, `pascal`, `kebab`, `screaming`", "pick one of `camel` / `snake` / `pascal` / `kebab` / `screaming`", Val(span))
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:365
pub fn apply_serde_ok(name: String, args: [Type], reg: TraitRegistry, trait_name: String, elem_ok: (Type) -> Bool) -> Bool {
    if reg.local_types.contains(name) && !reg.implements_trait(name, trait_name) -> return false
    if reg.serde_wire_params.get(name) == .Val(idxs) {
        loop i in idxs {
            if args.get(i) == .Val(ty) && !elem_ok(ty) -> return false
        }
    } else {
        loop ty in args {
            if !elem_ok(ty) -> return false
        }
    }
    true
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:387
pub fn is_encodable_ty(ty: Type, reg: TraitRegistry) -> Bool {
    return if ty == {
        .Int | .Float | .Bool | .String | .Char | .Float32 | .IntN(_, _) -> true
        .List(inner) | .Option(inner) | .Shared(inner) | .FixedList(inner, _) -> is_encodable_ty(inner, reg)
        .Map(key, _, value) -> key == Type.String && is_encodable_ty(value, reg)
        .Named(name) -> name == "Decimal" || name == "Date" || name == "LocalDate" || name == "LocalTime" || name == "DateTime" || name == "Duration" || is_json_type_name(name) || !reg.local_types.contains(name) || reg.implements_trait(name, Generics.ENCODE)
        .Apply(name, args) -> apply_serde_ok(name, args, reg, Generics.ENCODE, (inner) -> is_encodable_ty(inner, reg))
        .Union(members) -> {
            loop member in members {
                if !is_encodable_ty(member, reg) -> return false
            }
            true
        }
        else -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:422
pub fn is_decodable_ty(ty: Type, reg: TraitRegistry) -> Bool {
    return if ty == {
        .Int | .Float | .Bool | .String | .Char | .Float32 | .IntN(_, _) -> true
        .List(inner) | .Option(inner) | .Shared(inner) | .FixedList(inner, _) -> is_decodable_ty(inner, reg)
        .Map(key, _, value) -> key == Type.String && is_decodable_ty(value, reg)
        .Tagged(marker, inner) -> marker == .Internal(.CoreCryptoNominal) && inner == Type.Named{name: "Secret"}
        .Named(name) -> name == "Decimal" || name == "Secret" || name.ends_with(".Secret") || name == "Date" || name == "LocalDate" || name == "LocalTime" || name == "DateTime" || name == "Duration" || !reg.local_types.contains(name) || reg.implements_trait(name, Generics.DECODE)
        .Apply(name, args) -> apply_serde_ok(name, args, reg, Generics.DECODE, (inner) -> is_decodable_ty(inner, reg))
        .Union(members) -> {
            loop member in members {
                if !is_decodable_ty(member, reg) -> return false
            }
            true
        }
        else -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:465
fn invalid_union_decode_shapes(items: [Item], ty: Type) -> Bool {
    if ty == .Union(members) {
        seen := [SerdeWireShape:Bool]{} // GATE #4499
        loop member in members {
            shapes :: resolved_decode_wire_shapes(items, member) ?? return true
            loop shape in shapes {
                if seen.contains_key(shape) -> return true
                seen[shape] = true
            }
        }
    }
    return if ty == {
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .FixedList(inner, _) -> invalid_union_decode_shapes(items, inner)
        .Map(key, _, value) | .Result(key, value) -> invalid_union_decode_shapes(items, key) || invalid_union_decode_shapes(items, value)
        .Apply(_, args) | .Union(args) -> {
            loop arg in args {
                if invalid_union_decode_shapes(items, arg) -> return true
            }
            false
        }
        .Tuple(fields) -> {
            loop field in fields {
                if invalid_union_decode_shapes(items, field.ty) -> return true
            }
            false
        }
        .Fn(params, ret, _, _) -> {
            loop param in params {
                if invalid_union_decode_shapes(items, param) -> return true
            }
            if ret == .Val(value) -> invalid_union_decode_shapes(items, value) else -> false
        }
        else -> false
    }
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:509
fn invalid_generated_union_decode_shapes(items: [Item], definition: EnumDef) -> Bool {
    if !definition.name.starts_with("__JetUnion_") -> return false
    seen := [SerdeWireShape:Bool]{} // GATE #4499
    loop variant in definition.variants {
        if variant.payload == .Single(member, _) {
            shapes :: resolved_decode_wire_shapes(items, member) ?? return true
            loop shape in shapes {
                if seen.contains_key(shape) -> return true
                seen[shape] = true
            }
        }
    }
    false
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:538
pub fn invalid_serde_derive_impls(items: [Item], reg: TraitRegistry) -> [(String, String):Bool] {
    invalid := [(String, String):Bool]{} // GATE #4499: exact type/trait pair keys.
    loop item in items {
        if item == {
            .Struct(s) -> {
                enc := false
                dec := false
                loop derive in s.derives {
                    if derive.0 == Generics.ENCODE -> enc = true
                    if derive.0 == Generics.DECODE -> dec = true
                }
                bad_enc := false
                bad_dec := false
                loop field in s.fields {
                    excluded := false
                    loop marker in field.serde_markers {
                        if marker.name == Syntax.MARKER_SKIP || marker.name == Syntax.MARKER_FLATTEN -> excluded = true
                    }
                    if !excluded {
                        if enc && !is_encodable_ty(field.ty, reg) -> bad_enc = true
                        if dec && (!is_decodable_ty(field.ty, reg) || invalid_union_decode_shapes(items, field.ty)) -> bad_dec = true
                    }
                    if dec && field.default != None && field.default_ct == None -> bad_dec = true
                }
                if enc && bad_enc -> invalid[(s.name, Generics.ENCODE)] = true
                if dec && bad_dec -> invalid[(s.name, Generics.DECODE)] = true
            }
            .Enum(e) -> {
                enc := false
                dec := false
                loop derive in e.derives {
                    if derive.0 == Generics.ENCODE -> enc = true
                    if derive.0 == Generics.DECODE -> dec = true
                }
                bad_enc := false
                bad_dec := false
                loop variant in e.variants {
                    tys := [Type]{}
                    if variant.payload == {
                        .Unit -> {}
                        .Single(ty, _) -> &tys.push(ty)
                        .Named(fields) -> { loop field in fields -> &tys.push(field.ty) }
                    }
                    loop ty in tys {
                        if enc && !is_encodable_ty(ty, reg) -> bad_enc = true
                        if dec && (!is_decodable_ty(ty, reg) || invalid_union_decode_shapes(items, ty)) -> bad_dec = true
                    }
                }
                if enc && bad_enc -> invalid[(e.name, Generics.ENCODE)] = true
                if dec && (bad_dec || invalid_generated_union_decode_shapes(items, e)) -> invalid[(e.name, Generics.DECODE)] = true
            }
            else -> {}
        }
    }
    invalid
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:608
fn is_struct_named(ty: Type) -> Bool {
    if ty == {.Named(name) -> !is_json_type_name(name) else -> false}
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:616
pub fn validate_serde_items(items: [Item], reg: TraitRegistry) -> [Diagnostic] {
    out := [Diagnostic]{}
    loop item in items {
        derives := [(String, Span)]{}
        container := [jet_foundation.Marker]{}
        if item == {
            .Struct(s) -> { derives = s.derives; container = s.serde_markers }
            .Enum(e) -> { derives = e.derives; container = e.serde_markers }
            else -> next
        }
        enc := false
        dec := false
        loop derive in derives {
            if derive.0 == Generics.ENCODE -> enc = true
            if derive.0 == Generics.DECODE -> dec = true
        }
        if !enc && !dec -> next
        loop marker in container {
            if marker.name != Syntax.MARKER_RENAME_ALL -> next
            if marker.expr_arg(0) == .Val(.Ident(style, sp)) {
                if style != Syntax.RENAME_ALL_CAMEL && style != Syntax.RENAME_ALL_SNAKE && style != Syntax.RENAME_ALL_PASCAL && style != Syntax.RENAME_ALL_KEBAB && style != Syntax.RENAME_ALL_SCREAMING -> &out.push(e2409(style, sp))
            } else {
                &out.push(e2409("?", marker.span))
            }
        }
        if item == {
            .Struct(s) -> {
                loop field in s.fields {
                    skip := false
                    flatten := false
                    loop marker in field.serde_markers {
                        if marker.name == Syntax.MARKER_SKIP -> skip = true
                        if marker.name == Syntax.MARKER_FLATTEN -> flatten = true
                    }
                    if flatten && !is_struct_named(field.ty) {
                        &out.push(e2408(field.name, field.name_span))
                        next
                    }
                    if skip || flatten -> next
                    if enc && !is_encodable_ty(field.ty, reg) -> &out.push(e2411(field.ty, true, field.name_span))
                    if dec && !is_decodable_ty(field.ty, reg) -> &out.push(e2411(field.ty, false, field.name_span))
                    if dec -> validate_union_decode_shapes(items, field.ty, field.name_span, &out)
                }
            }
            .Enum(e) -> {
                loop variant in e.variants {
                    tys := [Type]{}
                    if variant.payload == {
                        .Unit -> {}
                        .Single(ty, _) -> &tys.push(ty)
                        .Named(fields) -> { loop field in fields -> &tys.push(field.ty) }
                    }
                    loop ty in tys {
                        if enc && !is_encodable_ty(ty, reg) -> &out.push(e2411(ty, true, variant.name_span))
                        if dec && !is_decodable_ty(ty, reg) -> &out.push(e2411(ty, false, variant.name_span))
                        if dec -> validate_union_decode_shapes(items, ty, variant.name_span, &out)
                    }
                }
            }
            else -> {}
        }
    }
    out
}
