pub fn is_empty_string_literal(expr: Expr) -> Bool {
    if expr == .Str(parts, _) {
        loop part in parts {
            if part == {.Lit(text) -> { if text != "" -> return false } else -> return false}
        }
        return true
    }
    false
}
// Rust: crates/jet-sema/src/Sema/CheckerCoreLib/serde_diags.rs:737
pub fn literal_string_value(expr: Expr) -> String? {
    if expr == .Str(parts, _) {
        if parts.len() != 1 -> return None
        return if parts[0] == {.Lit(text) -> Val(text) else -> None}
    }
    None
}
