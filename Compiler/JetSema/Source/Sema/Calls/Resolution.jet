// Callable target resolution shared by direct, value, and method calls.
//
// This layer resolves only declarations/candidates supplied by Sema. It does
// not maintain a second registry: module lookup remains SemaScopeTable's job,
// while cross-module and Core candidates are supplied by Registration.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    Span,
    Symbol,
    SymbolID,
    SymbolKind,
    TExpr,
    TFailureCarrier,
    TGenericParam,
    TMethodRef,
    Type,
    diagnostic_registry_row,
    type_name,
]

pub struct SemaCallFacts {
    pub return_type: Type
    pub failure_carrier: TFailureCarrier
    pub effect_bound: [EffectRowEntry]?
    pub type_args: [Type]
    pub default_refs: [FunctionDefaultRef]
}

pub struct SemaCallChecked {
    pub value: TExpr
    pub binding: SemaCallBinding
    pub facts: SemaCallFacts
    pub return_view_facts: [SemaCallReturnViewFact]
}

// Registration resolves these references against the owning declaration and
// passes the original expression here. A missing row is never replaced with a
// fabricated unit/default expression.
pub struct SemaCallDefaultValue {
    pub reference: FunctionDefaultRef
    pub expression: Expr
}

pub struct SemaCallDirectTarget {
    pub symbol: Symbol
    pub signature: Type
    pub type_args: [Type]
    pub generic_params: [SemaInferenceTypeParam]
    pub generic_substitutions: [SemaInferenceBinding]
    pub generic_evidence: [SemaInferenceBoundEvidence]
}

// Registration supplies one row for every viable method/trait/Core candidate.
// `signature` includes the receiver at `receiver_offset`; `method` is the
// canonical TIR reference and is never reconstructed from source spelling.
pub struct SemaCallMethodCandidate {
    pub method: TMethodRef
    pub signature: Type
    pub receiver_type: Type?
    pub receiver_convention: AccessConvention
    pub receiver_offset: Int
    pub type_args: [Type]
    pub generic_params: [SemaInferenceTypeParam]
    pub generic_substitutions: [SemaInferenceBinding]
    pub generic_evidence: [SemaInferenceBoundEvidence]
}

pub fn sema_call_signature_return(signature: Type) -> Type? {
    if signature == {
        .Fn(_, ret, _, _, _, _) -> Val(ret ?? Type.Named{name: "Unit"})
        else -> None
    }
}

fn sema_call_type_is_function(ty: Type) -> Bool Never! {
    if ty == {
        .Fn(_, _, _, _, _, _) -> true
        else -> false
    }
}

pub fn sema_call_signature_effects(signature: Type) -> [EffectRowEntry]? {
    if signature == {
        .Fn(_, _, effects, _, _, _) -> effects
        else -> None
    }
}

fn sema_call_failure_carrier(return_type: Type?) -> TFailureCarrier Never! {
    ty :: return_type ?? return TFailureCarrier.Result{success: Type.Named{name: "Unit"}, error: Type.Named{name: "Err"}}
    if ty == {
        .Named(name) -> if name == "Never" -> TFailureCarrier.Diverges{value: ty} else -> TFailureCarrier.Result{success: ty, error: Type.Named{name: "Err"}}
        .Option(value) -> TFailureCarrier.Optional{value: value}
        .Result(ok, err) -> if err == {
            .Named(name) -> if name == "Never" -> TFailureCarrier.Infallible else -> TFailureCarrier.Result{success: ok, error: err}
            else -> TFailureCarrier.Result{success: ok, error: err}
        }
        else -> TFailureCarrier.Result{success: ty, error: Type.Named{name: "Err"}}
    }
}

pub fn sema_call_facts(signature: Type, type_args: [Type], binding: SemaCallBinding) -> SemaCallFacts? {
    if signature == {
        .Fn(_, ret, effects, _, _, _) -> {
            return_type :: sema_call_signature_return(signature) ?? Type.Named{name: "Unit"}
            Val(SemaCallFacts{
                return_type: return_type,
                failure_carrier: sema_call_failure_carrier(ret),
                effect_bound: effects,
                type_args: type_args,
                default_refs: binding.default_refs,
            })
        }
        else -> None
    }
}

fn sema_call_unknown_function(name: String, span: Span) -> Diagnostic {
    sema_error("E0102", span, "nothing named `{name}` exists here", "only a registered callable can be invoked", "define `{name}` first, or call a name that exists")
}

fn sema_call_not_callable(name: String, ty: Type, span: Span) -> Diagnostic {
    sema_error("E0803", span, "`{name}` is {type_name(ty)}, not a function", "a direct call target must have a function type", "call a function or use a function value with a callable type")
}

fn sema_call_generic_count_diagnostic(name: String, expected: Int, actual: Int, span: Span) -> Diagnostic {
    sema_error("E0119", span, "`{name}` expects {expected} type argument{if expected == 1 -> "" else -> "s"}, got {actual}", "generic parameters and call-site type arguments have to line up", "provide exactly the declared type arguments")
}

// Rust `infer_call` (`direct_calls.rs`): a declared function named `name`
// (`funcs.get(name)`) is the call target even when a nearer value binding
// shares the name; only without one does the nearer binding decide.
fn sema_call_declared_function_index(scopes: SemaScopeTable, name: String) -> Int? {
    slot :: scopes.name_slots.get(name) ?? return None
    found := Int?{None}
    loop index in scopes.name_positions[slot] {
        if scopes.bindings[index].symbol.kind == SymbolKind.Function -> found = Val(index)
    }
    found
}

pub fn sema_call_resolve_direct(name: String, type_args: [Type], environment: SemaScopeEnvironment, scopes: &SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> SemaCallDirectTarget? {
    nearest :: sema_scope_resolve_index(scopes, name) ?? {
        &diagnostics.push(sema_call_unknown_function(name, span))
        return None
    }
    index :: if scopes.bindings[nearest].symbol.kind == SymbolKind.Function -> nearest else -> sema_call_declared_function_index(scopes, name) ?? nearest
    symbol :: scopes.bindings[index].symbol
    if symbol.kind != SymbolKind.Function {
        ty :: symbol.ty ?? {
            &diagnostics.push(sema_call_not_callable(name, Type.Named{name: "Unknown"}, span))
            return None
        }
        &diagnostics.push(sema_call_not_callable(name, ty, span))
        return None
    }
    signature :: symbol.ty ?? {
        &diagnostics.push(sema_call_not_callable(name, Type.Named{name: "Unknown"}, span))
        return None
    }
    if !sema_call_type_is_function(signature) {
        &diagnostics.push(sema_call_not_callable(name, signature, span))
        return None
    }

    // Only the callee's type parameters: its declaration is never copied.
    generic_params_source :: sema_scope_declaration_function_type_params(environment, symbol.id)
    generic_params :: sema_inference_type_params(generic_params_source)
    if generic_params.len() == 0 {
        if type_args.len() > 0 {
            &diagnostics.push(sema_call_generic_count_diagnostic(name, 0, type_args.len(), span))
            return None
        }
        return SemaCallDirectTarget{symbol: symbol, signature: signature, type_args: [Type]{}, generic_params: [SemaInferenceTypeParam]{}, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}}
    }
    if type_args.len() == 0 {
        return SemaCallDirectTarget{symbol: symbol, signature: signature, type_args: [Type]{}, generic_params: generic_params, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}}
    }
    if type_args.len() != generic_params.len() {
        &diagnostics.push(sema_call_generic_count_diagnostic(name, generic_params.len(), type_args.len(), span))
        return None
    }
    caller_module :: if scopes.frames.len() > 0 -> scopes.frames[0].owner else -> ""
    caller_package :: if environment.registration_graph == {
        .Val(graph) -> graph.package_identity
        else -> ""
    }
    context := sema_inference_context(caller_module, caller_package, generic_params, environment.generic_params, None)
    result :: sema_infer_validate_explicit(environment.registration_graph, &context, type_args, span, &diagnostics) ?? return None
    specialized :: sema_inference_substitute_type_bindings(signature, result.substitutions)
    SemaCallDirectTarget{symbol: symbol, signature: specialized, type_args: result.type_args, generic_params: generic_params, generic_substitutions: result.substitutions, generic_evidence: result.evidence}
}

pub fn sema_call_direct_target_generic_ready(target: SemaCallDirectTarget, diagnostics: &[Diagnostic], span: Span) -> Bool {
    if target.generic_params.len() > 0 && target.generic_substitutions.len() != target.generic_params.len() {
        &diagnostics.push(sema_error("E0904", span, "cannot infer type arguments for `{target.symbol.name}`", "generic call checking requires a complete inference result", "provide the function's type arguments explicitly"))
        return false
    }
    if !sema_inference_bounds_checked(target.generic_params, target.generic_evidence, target.generic_substitutions) {
        if target.generic_params.len() > 0 {
            &diagnostics.push(sema_error("E0905", span, "generic bounds for `{target.symbol.name}` were not resolved", "the shared inference solver must prove every declared bound", "use a registered specialized callable target"))
            return false
        }
    }
    true
}

pub fn sema_call_direct_target_with_inference(target: SemaCallDirectTarget, result: SemaInferenceResult) -> SemaCallDirectTarget? {
    if !result.complete -> return None
    specialized := target
    specialized.signature = sema_inference_substitute_type_bindings(target.signature, result.substitutions)
    specialized.type_args = result.type_args
    specialized.generic_substitutions = result.substitutions
    specialized.generic_evidence = result.evidence
    Val(specialized)
}

pub fn sema_call_infer_direct_target_from_types(target: SemaCallDirectTarget, parameter_types: [Type], arg_types: [Type], expected: Type?, environment: SemaScopeEnvironment, scopes: &SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> SemaCallDirectTarget? {
    if target.generic_params.len() == 0 -> return Val(target)
    return_type :: sema_call_signature_return(target.signature) ?? return None
    caller_module :: if scopes.frames.len() > 0 -> scopes.frames[0].owner else -> ""
    caller_package :: if environment.registration_graph == {
        .Val(graph) -> graph.package_identity
        else -> ""
    }
    context := sema_inference_context(caller_module, caller_package, target.generic_params, environment.generic_params, expected)
    result :: sema_infer_callable(environment.registration_graph, &context, parameter_types, return_type, arg_types, target.type_args, span, &diagnostics) ?? return None
    sema_call_direct_target_with_inference(target, result)
}

pub fn sema_call_direct_target_from_registration(function: SemaRegistrationFunction, graph: SemaRegistrationGraph?, caller_module_identity: String, caller_package_identity: String, type_args: [Type], span: Span, diagnostics: &[Diagnostic]) -> SemaCallDirectTarget? {
    generic_params :: sema_inference_registration_params(function.generic_params)
    if generic_params.len() == 0 {
        if type_args.len() > 0 {
            &diagnostics.push(sema_error("E0119", span, "`{function.symbol.name}` is not generic", "only a registered generic callable accepts type arguments", "remove the explicit type arguments"))
            return None
        }
        return SemaCallDirectTarget{symbol: function.symbol, signature: function.signature, type_args: [Type]{}, generic_params: [SemaInferenceTypeParam]{}, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}}
    }
    if type_args.len() == 0 {
        return SemaCallDirectTarget{symbol: function.symbol, signature: function.signature, type_args: [Type]{}, generic_params: generic_params, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}}
    }
    context := sema_inference_context(caller_module_identity, caller_package_identity, generic_params, [TGenericParam]{}, None)
    result :: sema_infer_validate_explicit(graph, &context, type_args, span, &diagnostics) ?? return None
    signature :: sema_inference_substitute_type_bindings(function.signature, result.substitutions)
    SemaCallDirectTarget{symbol: function.symbol, signature: signature, type_args: result.type_args, generic_params: generic_params, generic_substitutions: result.substitutions, generic_evidence: result.evidence}
}

// `signature` is the registered function's signature as the caller
// specialized it; only it and `function_generic_params` are read, so a caller
// never copies the registered row (and its declaration body) to swap one field.
pub fn sema_call_method_candidate_from_registration(signature: Type, function_generic_params: [SemaRegistrationGenericParam], graph: SemaRegistrationGraph?, caller_module_identity: String, caller_package_identity: String, lexical_generic_params: [TGenericParam], receiver_type: Type?, receiver_convention: AccessConvention, receiver_offset: Int, method: TMethodRef, type_args: [Type], span: Span, diagnostics: &[Diagnostic]) -> SemaCallMethodCandidate? {
    generic_params :: sema_inference_registration_params(function_generic_params)
    if generic_params.len() == 0 {
        if type_args.len() > 0 {
            &diagnostics.push(sema_error("E0119", span, "`{method.name}` is not generic", "only a registered generic method accepts type arguments", "remove the explicit type arguments"))
            return None
        }
        return SemaCallMethodCandidate{method: method, signature: signature, receiver_type: receiver_type, receiver_convention: receiver_convention, receiver_offset: receiver_offset, type_args: [Type]{}, generic_params: [SemaInferenceTypeParam]{}, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}}
    }
    if type_args.len() == 0 {
        return SemaCallMethodCandidate{method: method, signature: signature, receiver_type: receiver_type, receiver_convention: receiver_convention, receiver_offset: receiver_offset, type_args: [Type]{}, generic_params: generic_params, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}}
    }
    context := sema_inference_context(caller_module_identity, caller_package_identity, generic_params, lexical_generic_params, None)
    result :: sema_infer_validate_explicit(graph, &context, type_args, span, &diagnostics) ?? return None
    substituted :: sema_inference_substitute_type_bindings(signature, result.substitutions)
    SemaCallMethodCandidate{method: method, signature: substituted, receiver_type: receiver_type, receiver_convention: receiver_convention, receiver_offset: receiver_offset, type_args: result.type_args, generic_params: generic_params, generic_substitutions: result.substitutions, generic_evidence: result.evidence}
}

fn sema_call_method_receiver_candidate_type(candidate: SemaCallMethodCandidate) -> Type? {
    if candidate.receiver_type != None -> return candidate.receiver_type
    sema_call_method_receiver_type(candidate.signature, candidate.receiver_offset)
}

fn sema_call_direct_shape_matches(target: SemaCallDirectTarget, name: String, args: [CallArg], span: Span) -> Bool Never! {
    probe := [CallArg]{}
    loop arg in args -> &probe.push(arg)
    probe_diagnostics := [Diagnostic]{}
    sema_call_bind_direct(name, target.signature, &probe, span, &probe_diagnostics) != None
}

pub fn sema_call_resolve_direct_candidates(name: String, args: [CallArg], candidates: [SemaCallDirectTarget], span: Span, diagnostics: &[Diagnostic]) -> SemaCallDirectTarget? {
    if candidates.len() == 0 {
        &diagnostics.push(sema_call_unknown_function(name, span))
        return None
    }
    shape_matches :: loop candidate in candidates if sema_call_direct_shape_matches(candidate, name, args, span) -> candidate
    if {
        shape_matches.len() == 1 -> Val(shape_matches[0])
        shape_matches.len() > 1 -> {
            &diagnostics.push(sema_error("E0772", span, "this call to `{name}` matches more than one callable body", "overload resolution requires one candidate after argument shape filtering", "add labels or explicit type arguments that select one callable"))
            None
        }
        candidates.len() == 1 -> Val(candidates[0])
        else -> {
            &diagnostics.push(sema_error("E0772", span, "this call to `{name}` matches more than one callable body", "the overload set has no unique argument shape", "add labels or explicit type arguments that select one callable"))
            None
        }
    }
}

fn sema_call_method_shape_matches(candidate: SemaCallMethodCandidate, method: String, args: [CallArg], span: Span) -> Bool Never! {
    probe := [CallArg]{}
    loop arg in args -> &probe.push(arg)
    probe_diagnostics := [Diagnostic]{}
    sema_call_bind_method(method, candidate.signature, candidate.receiver_offset, &probe, span, &probe_diagnostics) != None
}

fn sema_call_retired_raw_directory_error(receiver_type: Type, method: String, span: Span) -> Diagnostic? {
    if receiver_type != Type.String || method != "read_dir" -> return None
    row :: diagnostic_registry_row("E0340") ?? panic("E0340 must have a registry row")
    Val(sema_error("E0340", span, row.what, row.why, row.fix))
}

pub fn sema_call_resolve_method(receiver_type: Type, method: String, args: [CallArg], span: Span, candidates: [SemaCallMethodCandidate], environment: SemaScopeEnvironment, diagnostics: &[Diagnostic]) -> SemaCallMethodCandidate? {
    receiver_matches := [SemaCallMethodCandidate]{}
    loop candidate in candidates {
        if candidate.method.name == method {
            if sema_call_method_receiver_candidate_type(candidate) == .Val(expected) {
                compatible :: sema_call_type_assignable(expected, receiver_type, environment) ?? false
                if compatible -> &receiver_matches.push(candidate)
            }
        }
    }
    if receiver_matches.len() == 0 {
        if sema_call_retired_raw_directory_error(receiver_type, method, span) == .Val(diagnostic) {
            &diagnostics.push(diagnostic)
            return None
        }
        &diagnostics.push(sema_error("E0311", span, "`{method}` isn't a method on this value", "method resolution found no candidate with a compatible receiver", "use a registered method for this receiver type"))
        return None
    }
    shape_matches :: loop candidate in receiver_matches if sema_call_method_shape_matches(candidate, method, args, span) -> candidate
    if {
        shape_matches.len() == 1 -> Val(shape_matches[0])
        shape_matches.len() > 1 -> {
            &diagnostics.push(sema_error("E0772", span, "this call to `{method}` matches more than one callable body", "overload resolution requires one candidate after receiver and argument shape filtering", "add an explicit type argument or make the argument labels/types select one method"))
            None
        }
        receiver_matches.len() == 1 -> Val(receiver_matches[0])
        else -> {
            &diagnostics.push(sema_error("E0772", span, "this call to `{method}` matches more than one callable body", "the receiver candidates disagree about this call's argument shape", "add labels or type arguments that select one method"))
            None
        }
    }
}

fn sema_call_trait_row_for_bound(graph: SemaRegistrationGraph, bound: String) -> SemaRegistrationRowRef? {
    loop (module_index, graph_module) in graph.modules {
        loop (row, nominal) in graph_module.nominals {
            if nominal.kind != SemaRegistrationNominalKind.Trait -> next
            canonical :: "{nominal.symbol.module_name}::{nominal.symbol.name}"
            if bound == canonical -> return Val(SemaRegistrationRowRef{module_index: module_index, row: row})
        }
    }
    None
}

fn sema_call_trait_row_for_symbol(graph: SemaRegistrationGraph, symbol: SymbolID) -> SemaRegistrationRowRef? {
    row :: sema_type_graph_nominal_row(graph, symbol.key) ?? return None
    if graph.modules[row.module_index].nominals[row.row].kind != SemaRegistrationNominalKind.Trait -> return None
    Val(row)
}

fn sema_call_trait_rows_push(graph: SemaRegistrationGraph, rows: &[SemaRegistrationRowRef], row: SemaRegistrationRowRef) Never! {
    key :: graph.modules[row.module_index].nominals[row.row].symbol.id.key
    loop existing in rows {
        if graph.modules[existing.module_index].nominals[existing.row].symbol.id.key == key -> return
    }
    &rows.push(row)
}

fn sema_call_generic_receiver_name(ty: Type) -> String? {
    if ty == {
        .Named(name) -> Val(name)
        .Apply(name, _) -> Val(name)
        else -> None
    }
}

fn sema_call_trait_visible(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, caller_module: String, caller_package: String) -> Bool Never! {
    if nominal.symbol.module_name == caller_module -> return true
    owner_package := ""
    if sema_registration_module_index(graph, nominal.symbol.module_name) == .Val(owner_index) -> owner_package = graph.modules[owner_index].package_identity
    if nominal.symbol.visibility >= 2 -> return true
    nominal.symbol.visibility >= 1 && owner_package == caller_package
}

fn sema_call_trait_signature_with_receiver(signature: Type, receiver_type: Type) -> Type? {
    if signature == {
        .Fn(params, ret, effects, contract, metadata, provenance) -> {
            if params.len() == 0 -> return None
            rewritten := params
            rewritten[0] = receiver_type
            Val(Type.Fn{params: rewritten, ret: ret, effect_bound: effects, param_contract: contract, call_metadata: metadata, return_view_provenance: provenance})
        }
        else -> None
    }
}

// Rust `infer_method_call` (trait-object and bounded-generic dispatch, via
// `check_trait_method_args`): the call exposes the method's declared success
// value, as `checked_return_types(..).0`. The trait ABI keeps the effective
// failure carrier, which MIR lowering propagates at the call (Rust
// `tir_to_mir_expr` MethodCall), so a declared `-> Bool` never auto-propagates
// an implicit `Err` in the caller. With no written return the call keeps the
// registered `Unit Err!` (or a raw protocol's `Unit`).
fn sema_call_trait_dispatch_signature(signature: Type, declared_return: Type?) -> Type Never! {
    declared :: declared_return ?? return ~signature
    if signature == {
        .Fn(params, _, effects, contract, metadata, provenance) -> Type.Fn{params: params, ret: Val(declared), effect_bound: effects, param_contract: contract, call_metadata: metadata, return_view_provenance: provenance}
        else -> ~signature
    }
}

fn sema_call_trait_method_candidate_from_registration(graph: SemaRegistrationGraph, trait_nominal: SemaRegistrationNominal, method: SemaRegistrationTraitMethod, receiver_type: Type, type_args: [Type], caller_module: String, generic_params: [TGenericParam], span: Span, diagnostics: &[Diagnostic]) -> SemaCallMethodCandidate? {
    if type_args.len() > 0 {
        &diagnostics.push(sema_error("E0119", span, "`{method.declaration.name}` is not generic", "trait method declarations do not carry independent type parameters", "remove the explicit method type arguments"))
        return None
    }
    if method.parameters.len() == 0 || method.declaration.params.len() == 0 || method.declaration.params[0].name != "self" -> return None
    declared_signature :: sema_type_resolve_declared_with_generics(graph, sema_call_trait_dispatch_signature(method.signature, method.declaration.return_type), caller_module, generic_params)
    signature :: sema_call_trait_signature_with_receiver(declared_signature, receiver_type) ?? return None
    reference :: TMethodRef{symbol: method.symbol.id, name: method.declaration.name, mangled: false, trait_owner: Val(trait_nominal.symbol.id), operator_identity: None}
    SemaCallMethodCandidate{
        method: reference,
        signature: signature,
        receiver_type: Val(receiver_type),
        receiver_convention: method.parameters[0].convention,
        receiver_offset: 1,
        type_args: [Type]{},
        generic_params: [SemaInferenceTypeParam]{},
        generic_substitutions: [SemaInferenceBinding]{},
        generic_evidence: [SemaInferenceBoundEvidence]{},
    }
}

pub fn sema_call_trait_method_candidates(graph: SemaRegistrationGraph, receiver_type: Type, method: String, type_args: [Type], caller_module: String, caller_package: String, generic_params: [TGenericParam], span: Span, diagnostics: &[Diagnostic]) -> [SemaCallMethodCandidate] Never! {
    resolved_receiver :: sema_type_resolve_declared_with_generics(graph, receiver_type, caller_module, generic_params)
    trait_rows := [SemaRegistrationRowRef]{}
    if resolved_receiver == {
        .TraitObject(bounds) -> {
            loop bound in bounds {
                row :: sema_call_trait_row_for_bound(graph, bound) ?? next
                sema_call_trait_rows_push(graph, &trait_rows, row)
            }
        }
        else -> {
            receiver_name :: sema_call_generic_receiver_name(resolved_receiver) ?? return [SemaCallMethodCandidate]{}
            parameter := TGenericParam?{None}
            index := generic_params.len()
            loop index > 0 {
                index -= 1
                candidate :: generic_params[index]
                if candidate.name == receiver_name {
                    parameter = Val(candidate)
                    break
                }
            }
            current :: parameter ?? return [SemaCallMethodCandidate]{}
            loop bound in current.bounds {
                row :: sema_call_trait_row_for_symbol(graph, bound) ?? next
                sema_call_trait_rows_push(graph, &trait_rows, row)
            }
        }
    }
    candidates := [SemaCallMethodCandidate]{}
    loop trait_row in trait_rows {
        nominal :: graph.modules[trait_row.module_index].nominals[trait_row.row]
        if !sema_call_trait_visible(graph, nominal, caller_module, caller_package) -> next
        loop trait_method in nominal.trait_methods {
            if trait_method.declaration.name != method -> next
            candidate :: sema_call_trait_method_candidate_from_registration(graph, nominal, trait_method, resolved_receiver, type_args, caller_module, generic_params, span, &diagnostics) ?? next
            duplicate :: loop existing in candidates {
                if existing.method.symbol.key == candidate.method.symbol.key -> break true
            } ?? false
            if !duplicate -> &candidates.push(candidate)
        }
    }
    candidates
}
