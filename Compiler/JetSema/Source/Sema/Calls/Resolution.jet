// Callable target resolution shared by direct, value, and method calls.
//
// This layer resolves only declarations/candidates supplied by Sema. It does
// not maintain a second registry: module lookup remains SemaScopeTable's job,
// while cross-module and Core candidates are supplied by Registration.
use jet_foundation.[
    AccessConvention,
    CallArg,
    Diagnostic,
    EffectRowEntry,
    Expr,
    FunctionDefaultRef,
    Span,
    Symbol,
    SymbolID,
    SymbolKind,
    TFailureCarrier,
    TGenericParam,
    TMethodRef,
    TextEdit,
    Type,
    diagnostic_with_edit,
    owned_trait,
    OwnedMethod,
    symbol_id,
    type_name,
]

SemaCallFacts: struct {
    return_type: Type
    failure_carrier: TFailureCarrier
    effect_bound: [EffectRowEntry]?
    type_args: [Type]
    default_refs: [FunctionDefaultRef]
}

SemaCallChecked: struct {
    value: TExpr
    binding: SemaCallBinding
    facts: SemaCallFacts
    return_view_facts: [SemaCallReturnViewFact]
}

// Registration resolves these references against the owning declaration and
// passes the original expression here. A missing row is never replaced with a
// fabricated unit/default expression.
SemaCallDefaultValue: struct {
    reference: FunctionDefaultRef
    expression: Expr
}

SemaCallDirectTarget: struct {
    symbol: Symbol
    signature: Type
    type_args: [Type]
    generic_params: [SemaInferenceTypeParam]
    generic_substitutions: [SemaInferenceBinding]
    generic_evidence: [SemaInferenceBoundEvidence]
}

// Registration supplies one row for every viable method/trait/Core candidate.
// `signature` includes the receiver at `receiver_offset`; `method` is the
// canonical checked-tree reference and is never reconstructed from source spelling.
SemaCallMethodCandidate: struct {
    method: TMethodRef
    signature: Type
    receiver_type: Type?
    receiver_convention: AccessConvention
    receiver_offset: Int
    type_args: [Type]
    generic_params: [SemaInferenceTypeParam]
    generic_substitutions: [SemaInferenceBinding]
    generic_evidence: [SemaInferenceBoundEvidence]
}

sema_call_signature_return: fn(signature: Type) -> Type? {
    if signature == {
        .Fn(_, ret, _, _, _, _) -> Val(ret ?? Type.Named{name: "Unit"})
        else -> None
    }
}

sema_call_type_is_function: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Fn(_, _, _, _, _, _) -> true
        else -> false
    }
}

sema_call_signature_effects: fn(signature: Type) -> [EffectRowEntry]? {
    if signature == {
        .Fn(_, _, effects, _, _, _) -> effects
        else -> None
    }
}

sema_call_failure_carrier: fn(return_type: Type?) -> TFailureCarrier Never! {
    ty: return_type ?? return TFailureCarrier.Result{success: Type.Named{name: "Unit"}, error: Type.Named{name: "Err"}}
    if ty == {
        .Named(name) -> if name == "Never" -> TFailureCarrier.Diverges{value: ty} else -> TFailureCarrier.Result{success: ty, error: Type.Named{name: "Err"}}
        .Option(value) -> TFailureCarrier.Optional{value: value}
        .Result(ok, err) -> if err == {
            .Named(name) -> if name == "Never" -> TFailureCarrier.Infallible else -> TFailureCarrier.Result{success: ok, error: err}
            else -> TFailureCarrier.Result{success: ok, error: err}
        }
        else -> TFailureCarrier.Result{success: ty, error: Type.Named{name: "Err"}}
    }
}

sema_call_facts: fn(signature: Type, type_args: [Type], binding: SemaCallBinding) -> SemaCallFacts? {
    if signature == {
        .Fn(_, ret, effects, _, _, _) -> {
            return_type: sema_call_signature_return(signature) ?? Type.Named{name: "Unit"}
            Val(SemaCallFacts{
                return_type: return_type,
                failure_carrier: sema_call_failure_carrier(ret),
                effect_bound: effects,
                type_args: type_args,
                default_refs: binding.default_refs,
            })
        }
        else -> None
    }
}

sema_call_unknown_function: fn(name: String, span: Span) -> Diagnostic {
    if name == "reject" -> return sema_call_reject_outside_template(span)
    sema_error("E0102", span, "nothing named `{name}` exists here", "only functions that have been defined (or built in, like `print` / `panic`) can be called", "define it first (fn {name}() {{ ... }}), or call one that exists")
}

// `reject(value)` is a marker template's report call (Registration/Derives.jet
// `sema_derive_reject`); outside a template it names no function.
sema_call_reject_outside_template: fn(span: Span) -> Diagnostic {
    sema_error("E0962", span, "`reject` runs only inside a marker's `expand` template.", "`reject(value)` raises a diagnostic at a marker's use site while the compiler expands the marker; ordinary code has no use site to report at, so the call has nothing to run.", "Move the check into a marker's `expand: fn(self, target: Target)` body, or return an error value from this function instead.")
}

// The ambient functions the readable prelude (Compiler/Prelude/core/prelude.jet)
// opens; an unknown call may be a misspelling of one. The ambient `input` is
// a value, not a call.
SEMA_CALL_PRELUDE_NAMES: [String]{"print", "panic", "assert", "assert_eq", "debug", "keep", "min", "max", "clamp", "eprint", "Clock", "Instant", "Date", "Duration", "Path", "read_file", "write_file", "file_exists", "channel", "embed_file", "embed_bytes", "find", "fetch"}

// E0102 for an unknown direct call, suggesting the one nearest visible
// function or prelude name within two edits and offering the rename as an edit.
sema_call_unknown_function_in: fn(name: String, span: Span, scopes: SemaScopeTable, no_prelude: Bool) -> Diagnostic {
    if name == "reject" -> return sema_call_reject_outside_template(span)
    candidates := [String]{}
    frame := scopes.current
    loop frame >= 0 {
        loop binding in scopes.bindings {
            if binding.frame != frame || binding.symbol.kind != SymbolKind.Function -> next
            if binding.symbol.name.starts_with("__") || binding.symbol.name.starts_with("@") -> next
            candidates.push(binding.symbol.name.copy())
        }
        frame = scopes.frames[frame].parent
    }
    if !no_prelude {
        loop prelude in SEMA_CALL_PRELUDE_NAMES -> candidates.push(prelude.copy())
    }
    near: sema_suggest_field(name, candidates) ?? return sema_call_unknown_function(name, span)
    diagnostic: sema_error("E0102", span, "nothing named `{name}` exists here", "only functions that have been defined (or built in, like `print` / `panic`) can be called", "did you mean `{near}`?")
    diagnostic_with_edit(diagnostic, TextEdit{span: span, new_text: near})
}

sema_call_not_callable: fn(name: String, ty: Type, span: Span) -> Diagnostic {
    sema_error("E0803", span, "`{name}` is {sema_type_show(ty)}, not a function", "a direct call target must have a function type", "call a function or use a function value with a callable type")
}

// Parentheses call functions and lambdas only. A value binding
// of another type names its type and the instance methods its own
// declaration body writes; methods a derive generates are not written there.
sema_call_not_callable_value: fn(name: String, ty: Type, program: SemaProgramTables, span: Span) -> Diagnostic {
    shown: type_name(ty)
    nominal: if ty == {
        .Named(_) -> true
        .Apply(_, _) -> true
        else -> false
    }
    described: if nominal -> shown else -> sema_type_show(ty)
    methods := [String]{}
    if nominal && program.registration_graph == .Val(graph) {
        base_name: sema_expr_type_base_name(ty) ?? ""
        loop nominal_row in sema_registration_nominal_rows_named(graph, sema_expr_operator_row_name(base_name)) {
            loop function in graph.modules[nominal_row.module_index].nominals[nominal_row.row].methods {
                receiver: function.parameters.len() > 0 && function.parameters[0].symbol.name == "self"
                if receiver && !function.declaration.compiler_generated && !methods.contains(function.symbol.name) -> methods.push(function.symbol.name.copy())
            }
        }
    }
    methods.sort()
    if methods.len() == 0 -> return sema_error("E0803", span, "`{name}` is {described}, not a function", "parentheses call functions and lambdas only", "remove the parentheses after `{name}`, or bind a function or lambda to call")
    sema_error("E0803", span, "`{name}` is {described}, not a function", "parentheses call functions and lambdas only; `{shown}` has the methods {methods.join(", ")}", "call one of its methods, such as `{name}.{methods[0]}(…)`, or write a method that returns a lambda")
}

sema_call_generic_count_diagnostic: fn(name: String, expected: Int, actual: Int, span: Span) -> Diagnostic {
    sema_error("E0119", span, "`{name}` expects {expected} type argument{if expected == 1 -> "" else -> "s"}, got {actual}", "generic parameters and call-site type arguments have to line up", "provide exactly the declared type arguments")
}

// (explicit call-site type arguments of a direct call).
sema_call_direct_type_arg_count_diagnostic: fn(name: String, expected: Int, actual: Int, span: Span) -> Diagnostic {
    plural: if expected == 1 -> "" else -> "s"
    sema_error("E0119", span, "`{name}` expects {expected} type argument{plural}, got {actual}", "a generic call must provide one type for every declared type parameter", "write {name} with {expected} type argument{plural}")
}

sema_call_not_generic_diagnostic: fn(name: String, span: Span) -> Diagnostic {
    sema_error("E0119", span, "`{name}` is not generic", "only functions declared with type parameters accept call-site type arguments", "call {name} without type arguments")
}

// An explicit `Never` type argument may fill
// only a failure-domain type parameter, one the signature names as a `!`
// domain (`fn(T) -> U E!`); in any other parameter it puts `Never` in a value
// position (E2422 at the callee name).
sema_call_type_names_failure_domain: fn(ty: Type, name: String) -> Bool Never! {
    if ty == {
        .Result(ok, err) -> {
            if err == .Named(domain) {
                if domain == name -> return true
            }
            sema_call_type_names_failure_domain(ok, name) || sema_call_type_names_failure_domain(err, name)
        }
        .List(inner) | .Shared(inner) | .Option(inner) | .Tagged(_, inner) | .FixedList(inner, _) | .InlineRange(inner, _, _) | .Quantity(inner, _) -> sema_call_type_names_failure_domain(inner, name)
        .Map(key, _, value) -> sema_call_type_names_failure_domain(key, name) || sema_call_type_names_failure_domain(value, name)
        .Fn(params, ret, _, _, _, _) -> {
            loop param in params {
                if sema_call_type_names_failure_domain(param, name) -> return true
            }
            if ret == .Val(value) -> return sema_call_type_names_failure_domain(value, name)
            false
        }
        .Apply(_, args) | .Union(args) -> {
            loop arg in args {
                if sema_call_type_names_failure_domain(arg, name) -> return true
            }
            false
        }
        .Tuple(fields) -> {
            loop field in fields {
                if sema_call_type_names_failure_domain(field.ty, name) -> return true
            }
            false
        }
        else -> false
    }
}

sema_call_never_type_args_valid: fn(signature: Type, generic_params: [SemaInferenceTypeParam], type_args: [Type], span: Span, diagnostics: &[Diagnostic]) -> Bool {
    loop index in 0..<type_args.len() {
        if type_args[index] == .Named(arg_name) {
            if arg_name == "Never" && !sema_call_type_names_failure_domain(signature, generic_params[index].name) {
                diagnostics.push(sema_never_as_value(span))
                return false
            }
        }
    }
    true
}

// A call resolves a lexical value binding before a same-named file function,
// so the nearest binding of `name` decides. A value binding that is not a
// function is E0803 even when a declared function of the same name is visible
// further out.
sema_call_resolve_direct: fn(name: String, type_args: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> SemaCallDirectTarget? {
    nearest: sema_scope_resolve_index(scopes, name) ?? {
        diagnostics.push(sema_call_unknown_function_in(name, span, scopes, sema_module_no_prelude(environment, program)))
        return None
    }
    symbol: sema_scope_binding_symbol(environment, scopes, nearest)
    if symbol.kind != SymbolKind.Function {
        ty: symbol.ty ?? {
            // A binding whose type was already lost to a reported error is
            // poisoned: calling it adds no second report.
            if diagnostics.len() == 0 -> diagnostics.push(sema_call_not_callable(name, Type.Named{name: "Unknown"}, span))
            return None
        }
        // A distinct type is not a conversion function: its destination-owned
        // conversion names the base, `UserID.from_int(value)`.
        if symbol.kind == SymbolKind.Type && sema_scope_declaration_distinct(environment, program, symbol.id) == .Val(definition) {
            diagnostics.push(sema_error("E0753", span, "`{name}(value)` is not a distinct conversion", "explicit conversions are owned by the destination type and name their source", "write `{name}.{sema_call_distinct_base_method(definition.base)}(value)`"))
            return None
        }
        diagnostics.push(sema_call_not_callable_value(name, ty, program, span))
        return None
    }
    signature: symbol.ty ?? {
        diagnostics.push(sema_call_not_callable(name, Type.Named{name: "Unknown"}, span))
        return None
    }
    if !sema_call_type_is_function(signature) {
        diagnostics.push(sema_call_not_callable(name, signature, span))
        return None
    }

    // Only the callee's type parameters: its declaration is never copied.
    generic_params_source: sema_scope_declaration_function_type_params(environment, program, symbol.id)
    generic_params: sema_inference_type_params(generic_params_source)
    if generic_params.len() == 0 {
        if type_args.len() > 0 {
            diagnostics.push(sema_call_not_generic_diagnostic(name, span))
            return None
        }
        return SemaCallDirectTarget{symbol: symbol, signature: signature, type_args: [Type]{}, generic_params: [SemaInferenceTypeParam]{}, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}}
    }
    if type_args.len() == 0 {
        return SemaCallDirectTarget{symbol: symbol, signature: signature, type_args: [Type]{}, generic_params: generic_params, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}}
    }
    if type_args.len() != generic_params.len() {
        diagnostics.push(sema_call_direct_type_arg_count_diagnostic(name, generic_params.len(), type_args.len(), span))
        return None
    }
    if !sema_call_never_type_args_valid(signature, generic_params, type_args, span, diagnostics) {
        return None
    }
    caller_module: if scopes.frames.len() > 0 -> scopes.frames[0].owner else -> ""
    caller_package: if program.registration_graph == {
        .Val(graph) -> graph.package_identity
        else -> ""
    }
    context := sema_inference_context(caller_module, caller_package, generic_params, environment.generic_params, None)
    result: sema_infer_validate_explicit(program.registration_graph, context, type_args, span, diagnostics) ?? return None
    specialized: sema_inference_substitute_type_bindings(signature, result.substitutions)
    SemaCallDirectTarget{symbol: symbol, signature: specialized, type_args: result.type_args, generic_params: generic_params, generic_substitutions: result.substitutions, generic_evidence: result.evidence}
}

// A call whose type-argument count doesn't match leaves the callee's type
// parameters unbound, and its arguments are still checked against the declared
// parameter types. The declared signature when `type_args` is that mismatch,
// else None.
sema_call_direct_type_arg_mismatch_signature: fn(name: String, type_args: [Type], environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: SemaScopeTable) -> Type? {
    if type_args.len() == 0 -> return None
    nearest: sema_scope_resolve_index(scopes, name) ?? return None
    symbol: sema_scope_binding_symbol(environment, scopes, nearest)
    if symbol.kind != SymbolKind.Function -> return None
    generic_params: sema_inference_type_params(sema_scope_declaration_function_type_params(environment, program, symbol.id))
    if generic_params.len() == 0 || generic_params.len() == type_args.len() -> return None
    symbol.ty
}

sema_call_direct_target_generic_ready: fn(target: SemaCallDirectTarget, diagnostics: &[Diagnostic], span: Span) -> Bool {
    if target.generic_params.len() > 0 && target.generic_substitutions.len() != target.generic_params.len() {
        diagnostics.push(sema_error("E0904", span, "cannot infer type arguments for `{target.symbol.name}`", "generic call checking requires a complete inference result", "provide the function's type arguments explicitly"))
        return false
    }
    if !sema_inference_bounds_checked(target.generic_params, target.generic_evidence, target.generic_substitutions) {
        if target.generic_params.len() > 0 {
            diagnostics.push(sema_error("E0905", span, "generic bounds for `{target.symbol.name}` were not resolved", "the shared inference solver must prove every declared bound", "use a registered specialized callable target"))
            return false
        }
    }
    true
}

sema_call_direct_target_with_inference: fn(target: SemaCallDirectTarget, result: SemaInferenceResult) -> SemaCallDirectTarget? {
    if !result.complete -> return None
    specialized := target
    specialized.signature = sema_inference_substitute_type_bindings(target.signature, result.substitutions)
    specialized.type_args = result.type_args
    specialized.generic_substitutions = result.substitutions
    specialized.generic_evidence = result.evidence
    Val(specialized)
}

sema_call_infer_direct_target_from_types: fn(target: SemaCallDirectTarget, parameter_types: [Type], arg_types: [Type], expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, span: Span, diagnostics: &[Diagnostic]) -> SemaCallDirectTarget? {
    if target.generic_params.len() == 0 -> return Val(target)
    return_type: sema_call_signature_return(target.signature) ?? return None
    caller_module: if scopes.frames.len() > 0 -> scopes.frames[0].owner else -> ""
    caller_package: if program.registration_graph == {
        .Val(graph) -> graph.package_identity
        else -> ""
    }
    context := sema_inference_context(caller_module, caller_package, target.generic_params, environment.generic_params, expected)
    result: sema_infer_callable(program.registration_graph, context, parameter_types, return_type, arg_types, target.type_args, span, diagnostics) ?? return None
    sema_call_direct_target_with_inference(target, result)
}

sema_call_direct_target_from_registration: fn(function: SemaRegistrationFunction, graph: SemaRegistrationGraph?, caller_module_identity: String, caller_package_identity: String, lexical_generic_params: [TGenericParam], type_args: [Type], span: Span, diagnostics: &[Diagnostic]) -> SemaCallDirectTarget? {
    generic_params: sema_inference_registration_params(function.generic_params)
    if generic_params.len() == 0 {
        if type_args.len() > 0 {
            diagnostics.push(sema_call_not_generic_diagnostic(function.symbol.name, span))
            return None
        }
        return SemaCallDirectTarget{symbol: function.symbol, signature: function.signature, type_args: [Type]{}, generic_params: [SemaInferenceTypeParam]{}, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}}
    }
    if type_args.len() == 0 {
        return SemaCallDirectTarget{symbol: function.symbol, signature: function.signature, type_args: [Type]{}, generic_params: generic_params, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}}
    }
    if type_args.len() == generic_params.len() && !sema_call_never_type_args_valid(function.signature, generic_params, type_args, span, diagnostics) {
        return None
    }
    context := sema_inference_context(caller_module_identity, caller_package_identity, generic_params, lexical_generic_params, None)
    result: sema_infer_validate_explicit(graph, context, type_args, span, diagnostics) ?? return None
    signature: sema_inference_substitute_type_bindings(function.signature, result.substitutions)
    SemaCallDirectTarget{symbol: function.symbol, signature: signature, type_args: result.type_args, generic_params: generic_params, generic_substitutions: result.substitutions, generic_evidence: result.evidence}
}

// `signature` is the registered function's signature as the caller
// specialized it; only it and `function_generic_params` are read, so a caller
// never copies the registered row (and its declaration body) to swap one field.
sema_call_method_candidate_from_registration: fn(signature: Type, function_generic_params: [SemaRegistrationGenericParam], graph: SemaRegistrationGraph?, caller_module_identity: String, caller_package_identity: String, lexical_generic_params: [TGenericParam], receiver_type: Type?, receiver_convention: AccessConvention, receiver_offset: Int, method: TMethodRef, type_args: [Type], span: Span, diagnostics: &[Diagnostic]) -> SemaCallMethodCandidate? {
    generic_params: sema_inference_registration_params(function_generic_params)
    if generic_params.len() == 0 {
        if type_args.len() > 0 {
            diagnostics.push(sema_error("E0119", span, "`{method.name}` is not generic", "only a registered generic method accepts type arguments", "remove the explicit type arguments"))
            return None
        }
        return SemaCallMethodCandidate{method: method, signature: signature, receiver_type: receiver_type, receiver_convention: receiver_convention, receiver_offset: receiver_offset, type_args: [Type]{}, generic_params: [SemaInferenceTypeParam]{}, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}}
    }
    if type_args.len() == 0 {
        return SemaCallMethodCandidate{method: method, signature: signature, receiver_type: receiver_type, receiver_convention: receiver_convention, receiver_offset: receiver_offset, type_args: [Type]{}, generic_params: generic_params, generic_substitutions: [SemaInferenceBinding]{}, generic_evidence: [SemaInferenceBoundEvidence]{}}
    }
    context := sema_inference_context(caller_module_identity, caller_package_identity, generic_params, lexical_generic_params, None)
    result: sema_infer_validate_explicit(graph, context, type_args, span, diagnostics) ?? return None
    substituted: sema_inference_substitute_type_bindings(signature, result.substitutions)
    SemaCallMethodCandidate{method: method, signature: substituted, receiver_type: receiver_type, receiver_convention: receiver_convention, receiver_offset: receiver_offset, type_args: result.type_args, generic_params: generic_params, generic_substitutions: result.substitutions, generic_evidence: result.evidence}
}

sema_call_method_receiver_candidate_type: fn(candidate: SemaCallMethodCandidate) -> Type? {
    if candidate.receiver_type != None -> return candidate.receiver_type
    sema_call_method_receiver_type(candidate.signature, candidate.receiver_offset)
}

sema_call_direct_shape_matches: fn(target: SemaCallDirectTarget, name: String, args: [CallArg], span: Span) -> Bool Never! {
    probe := [CallArg]{}
    loop arg in args -> probe.push(arg.copy())
    probe_diagnostics := [Diagnostic]{}
    sema_call_bind_direct(name, target.signature, probe, span, probe_diagnostics) != None
}

sema_call_resolve_direct_candidates: fn(name: String, args: [CallArg], candidates: [SemaCallDirectTarget], span: Span, diagnostics: &[Diagnostic]) -> SemaCallDirectTarget? {
    if candidates.len() == 0 {
        diagnostics.push(sema_call_unknown_function(name, span))
        return None
    }
    shape_matches: loop candidate in candidates if sema_call_direct_shape_matches(candidate, name, args, span) -> candidate
    if {
        shape_matches.len() == 1 -> Val(shape_matches[0])
        shape_matches.len() > 1 -> {
            diagnostics.push(sema_error("E0772", span, "this call to `{name}` matches more than one callable body", "overload resolution requires one candidate after argument shape filtering", "add labels or explicit type arguments that select one callable"))
            None
        }
        candidates.len() == 1 -> Val(candidates[0])
        else -> {
            diagnostics.push(sema_error("E0772", span, "this call to `{name}` matches more than one callable body", "the overload set has no unique argument shape", "add labels or explicit type arguments that select one callable"))
            None
        }
    }
}

sema_call_method_shape_matches: fn(candidate: SemaCallMethodCandidate, method: String, args: [CallArg], span: Span) -> Bool Never! {
    probe := [CallArg]{}
    loop arg in args -> probe.push(arg.copy())
    probe_diagnostics := [Diagnostic]{}
    sema_call_bind_method(method, candidate.signature, candidate.receiver_offset, probe, span, probe_diagnostics) != None
}

sema_call_resolve_method: fn(receiver_type: Type, method: String, args: [CallArg], span: Span, candidates: [SemaCallMethodCandidate], environment: SemaScopeEnvironment, program: SemaProgramTables, diagnostics: &[Diagnostic]) -> SemaCallMethodCandidate? {
    receiver_matches := [SemaCallMethodCandidate]{}
    loop candidate in candidates {
        if candidate.method.name == method {
            if sema_call_method_receiver_candidate_type(candidate) == .Val(expected) {
                compatible: sema_call_type_assignable(expected, receiver_type, environment, program) ?? false
                if compatible -> receiver_matches.push(candidate.copy())
            }
        }
    }
    if receiver_matches.len() == 0 {
        diagnostics.push(sema_call_missing_method_diagnostic(receiver_type, method, args.len(), span, environment, program))
        return None
    }
    shape_matches: loop candidate in receiver_matches if sema_call_method_shape_matches(candidate, method, args, span) -> candidate
    if {
        shape_matches.len() == 1 -> Val(shape_matches[0])
        shape_matches.len() > 1 -> {
            diagnostics.push(sema_error("E0772", span, "this call to `{method}` matches more than one callable body", "overload resolution requires one candidate after receiver and argument shape filtering", "add an explicit type argument or make the argument labels/types select one method"))
            None
        }
        receiver_matches.len() == 1 -> Val(receiver_matches[0])
        else -> {
            diagnostics.push(sema_error("E0772", span, "this call to `{method}` matches more than one callable body", "the receiver candidates disagree about this call's argument shape", "add labels or type arguments that select one method"))
            None
        }
    }
}

sema_call_trait_row_for_bound: fn(graph: SemaRegistrationGraph, bound: String) -> SemaRegistrationRowRef? {
    loop (module_index, graph_module) in graph.modules {
        loop (row, nominal) in graph_module.nominals {
            if nominal.kind != SemaRegistrationNominalKind.Trait -> next
            canonical: "{nominal.symbol.module_name}::{nominal.symbol.name}"
            if bound == canonical {
                return Val(SemaRegistrationRowRef{module_index: module_index, row: row})
            }
        }
    }
    None
}

sema_call_trait_row_for_symbol: fn(graph: SemaRegistrationGraph, symbol: SymbolID) -> SemaRegistrationRowRef? {
    row: sema_type_graph_nominal_row(graph, symbol.key) ?? return None
    if graph.modules[row.module_index].nominals[row.row].kind != SemaRegistrationNominalKind.Trait {
        return None
    }
    Val(row)
}

sema_call_trait_rows_push: fn(graph: SemaRegistrationGraph, rows: &[SemaRegistrationRowRef], row: SemaRegistrationRowRef) Never! {
    key: graph.modules[row.module_index].nominals[row.row].symbol.id.key
    loop existing in rows {
        if graph.modules[existing.module_index].nominals[existing.row].symbol.id.key == key {
            return
        }
    }
    rows.push(row.copy())
}

sema_call_generic_receiver_name: fn(ty: Type) -> String? {
    if ty == {
        .Named(name) -> Val(name)
        .Apply(name, _) -> Val(name)
        else -> None
    }
}

sema_call_trait_visible: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, caller_module: String, caller_package: String) -> Bool Never! {
    if nominal.symbol.module_name == caller_module -> return true
    owner_package := ""
    if sema_registration_module_index(graph, nominal.symbol.module_name) == .Val(owner_index) {
        owner_package = graph.modules[owner_index].package_identity
    }
    if nominal.symbol.visibility >= 2 -> return true
    nominal.symbol.visibility >= 1 && owner_package == caller_package
}

sema_call_trait_signature_with_receiver: fn(signature: Type, receiver_type: Type) -> Type? {
    if signature == {
        .Fn(params, ret, effects, contract, metadata, provenance) -> {
            if params.len() == 0 -> return None
            rewritten := params
            rewritten[0] = receiver_type
            Val(Type.Fn{params: rewritten, ret: ret, effect_bound: effects, param_contract: contract, call_metadata: metadata, return_view_provenance: provenance})
        }
        else -> None
    }
}

// Rust `infer_method_call` (trait-object and bounded-generic dispatch, via
// `check_trait_method_args`): the call exposes the method's declared success
// value, as `checked_return_types(..).0`. The trait ABI keeps the effective
// failure carrier, which IR lowering propagates at the call (Rust
// reference lowering, MethodCall), so a declared `-> Bool` never auto-propagates
// an implicit `Err` in the caller. With no written return the call keeps the
// registered `Unit Err!` (or a raw protocol's `Unit`).
sema_call_trait_dispatch_signature: fn(signature: Type, declared_return: Type?) -> Type Never! {
    // copy: the dispatch signature is a new owned Type. Without a declared return it equals
    // `signature`, the trait method's signature (a read parameter), which stays in the trait.
    declared: declared_return ?? return signature.copy()
    if signature == {
        // copy: `metadata` and `provenance` are payloads of read parameter `signature`, which keeps the originals; the new Type.Fn's fields own `metadata` and `provenance`
        .Fn(params, _, effects, contract, metadata, provenance) -> Type.Fn{params: params, ret: Val(declared), effect_bound: effects, param_contract: contract, call_metadata: metadata.copy(), return_view_provenance: provenance.copy()}
        // copy: the dispatch signature is a new owned Type. For other kinds it equals `signature`,
        // the trait method's signature (a read parameter), which stays in the trait.
        else -> signature.copy()
    }
}

sema_call_trait_method_candidate_from_registration: fn(graph: SemaRegistrationGraph, trait_nominal: SemaRegistrationNominal, method: SemaRegistrationTraitMethod, receiver_type: Type, type_args: [Type], caller_module: String, generic_params: [TGenericParam], span: Span, diagnostics: &[Diagnostic]) -> SemaCallMethodCandidate? {
    if type_args.len() > 0 {
        diagnostics.push(sema_error("E0119", span, "`{method.declaration.name}` is not generic", "trait method declarations do not carry independent type parameters", "remove the explicit method type arguments"))
        return None
    }
    if method.parameters.len() == 0 || method.declaration.params.len() == 0 || method.declaration.params[0].name != "self" {
        return None
    }
    declared_signature: sema_type_resolve_declared_with_generics(graph, sema_call_trait_dispatch_signature(method.signature, method.declaration.return_type), caller_module, generic_params)
    signature: sema_call_trait_signature_with_receiver(declared_signature, receiver_type) ?? return None
    reference: TMethodRef{symbol: method.symbol.id, name: method.declaration.name, mangled: false, trait_owner: Val(trait_nominal.symbol.id), operator_identity: None}
    SemaCallMethodCandidate{
        method: reference,
        signature: signature,
        receiver_type: Val(receiver_type),
        receiver_convention: method.parameters[0].convention,
        receiver_offset: 1,
        type_args: [Type]{},
        generic_params: [SemaInferenceTypeParam]{},
        generic_substitutions: [SemaInferenceBinding]{},
        generic_evidence: [SemaInferenceBoundEvidence]{},
    }
}

sema_call_trait_method_candidates: fn(graph: SemaRegistrationGraph, receiver_type: Type, method: String, type_args: [Type], caller_module: String, caller_package: String, generic_params: [TGenericParam], span: Span, diagnostics: &[Diagnostic]) -> [SemaCallMethodCandidate] Never! {
    resolved_receiver: sema_type_resolve_declared_with_generics(graph, receiver_type, caller_module, generic_params)
    trait_rows := [SemaRegistrationRowRef]{}
    // Bounds naming a bare-bound compiler-owned trait, which has no row.
    owned_bounds := [SymbolID]{}
    // A type parameter's bounds dispatch in the order they are written: the
    // first bound that declares the method answers it, so `...[Inspect, Edit]`
    // calls `Inspect.touch`
    // (`multi_trait_receiver_access_follows_first_match_dispatch_order`).
    first_match := false
    if resolved_receiver == {
        .TraitObject(bounds) -> {
            loop bound in bounds {
                row: sema_call_trait_row_for_bound(graph, bound) ?? next
                sema_call_trait_rows_push(graph, trait_rows, row)
            }
        }
        else -> {
            receiver_name: sema_call_generic_receiver_name(resolved_receiver) ?? return [SemaCallMethodCandidate]{}
            parameter := TGenericParam?{None}
            index := generic_params.len()
            loop index > 0 {
                index -= 1
                candidate: generic_params[index]
                if candidate.name == receiver_name {
                    parameter = Val(candidate)
                    break
                }
            }
            current: parameter ?? return [SemaCallMethodCandidate]{}
            first_match = true
            loop bound in current.bounds {
                if sema_call_trait_row_for_symbol(graph, bound) == .Val(row) {
                    sema_call_trait_rows_push(graph, trait_rows, row)
                } else {
                    owned_bounds.push(bound.copy())
                }
            }
        }
    }
    candidates := [SemaCallMethodCandidate]{}
    loop trait_row in trait_rows {
        nominal: graph.modules[trait_row.module_index].nominals[trait_row.row]
        if !sema_call_trait_visible(graph, nominal, caller_module, caller_package) -> next
        loop trait_method in nominal.trait_methods {
            if trait_method.declaration.name != method -> next
            candidate: sema_call_trait_method_candidate_from_registration(graph, nominal, trait_method, resolved_receiver, type_args, caller_module, generic_params, span, diagnostics) ?? next
            duplicate: loop existing in candidates {
                if existing.method.symbol.key == candidate.method.symbol.key {
                    break true
                }
            } ?? false
            if !duplicate -> candidates.push(candidate)
        }
        if first_match && candidates.len() > 0 -> break
    }
    if candidates.len() > 0 -> return candidates
    loop bound in owned_bounds {
        candidate: sema_call_owned_trait_method_candidate(graph, bound, resolved_receiver, method, type_args, caller_module, generic_params, span, diagnostics) ?? next
        candidates.push(candidate)
        break
    }
    candidates
}

// A type parameter bounded by a bare-bound compiler-owned trait (OWNED_TRAITS,
// which no module declares, so it has no registered row) calls the method
// that trait's row declares, its parameter and return types resolved where the
// call is. The reference names the trait, so IR dispatches each instance's
// call to its receiver's implementation (ir_method_key), and the call exposes
// the declared success value as a registered trait method's does.
sema_call_owned_trait_method_candidate: fn(graph: SemaRegistrationGraph, bound: SymbolID, receiver_type: Type, method: String, type_args: [Type], caller_module: String, generic_params: [TGenericParam], span: Span, diagnostics: &[Diagnostic]) -> SemaCallMethodCandidate? {
    segments: bound.key.split(":").to_list()
    trait_name: segments[segments.len() - 1]
    builtin: sema_type_builtin_trait_symbol(trait_name) ?? return None
    if builtin.id.key != bound.key -> return None
    owned: owned_trait(trait_name) ?? return None
    wanted := OwnedMethod?{None}
    if owned.contract == .Methods(methods, _, _) {
        loop declared in methods {
            if declared.name == method {
                wanted = Val(declared.copy())
                break
            }
        }
    }
    found: wanted ?? return None
    if found.receiver == .Static -> return None
    convention: if found.receiver == {
        .Fixed(access) -> access
        else -> AccessConvention.Read
    }
    if type_args.len() > 0 {
        diagnostics.push(sema_error("E0119", span, "`{method}` is not generic", "trait method declarations do not carry independent type parameters", "remove the explicit method type arguments"))
        return None
    }
    params := [Type]{receiver_type.copy()}
    loop param in found.params -> params.push(sema_type_resolve_declared_with_generics(graph, param.ty, caller_module, generic_params))
    declared_return: if found.returns == {
        .Val(returned) -> if returned == {
            .Result(ok, _) -> Val(ok.copy())
            else -> Val(returned.copy())
        }
        .None -> None
    }
    ret: if declared_return == {
        .Val(returned) -> Val(sema_type_resolve_declared_with_generics(graph, returned, caller_module, generic_params))
        .None -> None
    }
    SemaCallMethodCandidate{
        method: TMethodRef{symbol: symbol_id(SymbolKind.Function, "", trait_name, method), name: method, mangled: false, trait_owner: Val(builtin.id.copy()), operator_identity: None},
        signature: Type.Fn{params: params.move(), ret: ret, effect_bound: None, param_contract: None, call_metadata: None, return_view_provenance: None},
        receiver_type: Val(receiver_type.copy()),
        receiver_convention: convention,
        receiver_offset: 1,
        type_args: [Type]{},
        generic_params: [SemaInferenceTypeParam]{},
        generic_substitutions: [SemaInferenceBinding]{},
        generic_evidence: [SemaInferenceBoundEvidence]{},
    }
}

// Rust `synthesize_impls` (default bodies, S62 `using` delegation): a
// nominal's trait impl answers a method it doesn't write with the trait's
// default body, and a delegating impl answers every trait method. The call
// dispatches through the trait, whose emitted form carries the default body
// and the delegation forwarding. A top-level `impl T.Trait` and an
// `impl Trait` block in the body of `T` answer the same way.
sema_call_implemented_trait_method_candidates: fn(graph: SemaRegistrationGraph, nominal: SemaRegistrationNominal, receiver_type: Type, method: String, type_args: [Type], caller_module: String, caller_package: String, generic_params: [TGenericParam], span: Span, diagnostics: &[Diagnostic]) -> [SemaCallMethodCandidate] Never! {
    candidates := [SemaCallMethodCandidate]{}
    loop graph_module_index in 0..<graph.modules.len() {
        loop implementation_index in 0..<graph.modules[graph_module_index].impls.len() {
            if graph.modules[graph_module_index].impls[implementation_index].target_identity_key != nominal.identity_key -> next
            trait_symbol: graph.modules[graph_module_index].impls[implementation_index].trait_symbol ?? next
            written: loop function_index in 0..<graph.modules[graph_module_index].impls[implementation_index].methods.len() {
                if graph.modules[graph_module_index].impls[implementation_index].methods[function_index].symbol.name == method {
                    break true
                }
            } ?? false
            if written -> next
            trait_row: sema_call_trait_row_for_symbol(graph, trait_symbol.id) ?? next
            delegated: graph.modules[graph_module_index].impls[implementation_index].delegation_field != .None
            sema_call_unwritten_trait_method_candidates(graph, trait_row, delegated, receiver_type, method, type_args, caller_module, caller_package, generic_params, span, diagnostics, candidates)
        }
    }
    if nominal.source == .SourceAST(item) {
        loop block in sema_registration_item_trait_blocks(item) {
            written := false
            loop function in block.methods {
                if function.name == method -> written = true
            }
            if written -> next
            trait_row: sema_checked_trait_nominal_row(graph, nominal.symbol.module_name, block.trait_name) ?? next
            sema_call_unwritten_trait_method_candidates(graph, trait_row, block.delegation_field != None, receiver_type, method, type_args, caller_module, caller_package, generic_params, span, diagnostics, candidates)
        }
    }
    candidates
}

// The trait's `method` for an impl that doesn't write it: its default body,
// or any method when the impl delegates.
sema_call_unwritten_trait_method_candidates: fn(graph: SemaRegistrationGraph, trait_row: SemaRegistrationRowRef, delegated: Bool, receiver_type: Type, method: String, type_args: [Type], caller_module: String, caller_package: String, generic_params: [TGenericParam], span: Span, diagnostics: &[Diagnostic], candidates: &[SemaCallMethodCandidate]) Never! {
    trait_nominal: graph.modules[trait_row.module_index].nominals[trait_row.row]
    if !sema_call_trait_visible(graph, trait_nominal, caller_module, caller_package) -> return
    loop trait_method in trait_nominal.trait_methods {
        if trait_method.declaration.name != method -> next
        if !delegated && trait_method.declaration.default_body == .None -> next
        candidate: sema_call_trait_method_candidate_from_registration(graph, trait_nominal, trait_method, receiver_type, type_args, caller_module, generic_params, span, diagnostics) ?? next
        duplicate: loop existing in candidates {
            if existing.method.symbol.key == candidate.method.symbol.key {
                break true
            }
        } ?? false
        if !duplicate -> candidates.push(candidate)
    }
}
