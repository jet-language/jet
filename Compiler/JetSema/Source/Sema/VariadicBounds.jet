// Trait-bounded variadics (`parts: ...Renderable`, `parts: ...[A, B]`). Each
// call-site arity has its own closed function, `f__va{n}`: the variadic
// parameter becomes one generic slot per argument, bounded by every listed
// trait, and the body's one top-level `loop x in parts` unrolls into one copy
// per slot with `x` naming that slot. Calls in the declaring module are
// renamed to their arity's function, and the arity functions replace the
// declaration. A body of any other shape keeps the declaration for E1314.
use jet_foundation.[AST_NODE_GENERATED, Expr, ForKind, Func, Item, Param, ParamZone, Program, Span, Stmt, Type, TypeParam]

// Expands `program`'s trait-bounded variadic functions in place; a program
// without one is left untouched (not copied).
sema_variadic_bounds_expand: fn(program: &Program) {
    declared := [String:Bool]{}
    loop item in program.items {
        if item == .Trait(definition) -> declared[definition.name] = true
    }
    fixed := [String:Int]{}
    loop item in program.items {
        if item == .Func(function) {
            if sema_variadic_bound_traits(function, declared) != None -> fixed[function.name] = function.params.len() - 1
        }
    }
    if fixed.len() == 0 -> return
    calls := sema_inline_rewrite_empty()
    calls.variadic = fixed
    rewritten := [Item]{}
    loop item in program.items -> &rewritten.push(sema_inline_rewrite_item(&calls, item))
    expanded := [Item]{}
    loop item in rewritten {
        if item == .Func(function) {
            if calls.variadic.get(function.name) != None {
                bounds: sema_variadic_bound_traits(function, declared) ?? [String]{}
                // A function nothing calls is still checked once against its
                // bounds: its one-argument arity is a generic function, so it
                // is type-checked but never instantiated (#6449).
                arities: calls.variadic_arities.get(function.name) ?? [Int]{1}
                loop arity in arities -> &expanded.push(Item.Func{value: sema_variadic_bound_specialize(function, bounds, arity)})
                next
            }
        }
        &expanded.push(item)
    }
    program.items = ^expanded
}

// The traits bounding `function`'s trailing variadic, when it is one whose
// body has the single direct `loop x in parts` shape.
sema_variadic_bound_traits: fn(function: Func, declared: [String:Bool]) -> [String]? {
    if function.params.len() == 0 -> return None
    last: function.params[function.params.len() - 1]
    if !last.variadic -> return None
    loops := 0
    uses := [Span]{}
    loop statement in function.body -> sema_function_header_variadic_statement(statement, last.name, true, &loops, &uses)
    if loops != 1 || uses.len() > 0 -> return None
    if last.variadic_bound_list == .Val(list) {
        if list.len() == 0 -> return None
        return Val(list.copy())
    }
    if last.ty == .Named(name) {
        if declared.get(name) != None || sema_type_builtin_trait_symbol(name) != None -> return Val([String]{name.copy()})
    }
    None
}

// The arity function a call of variadic `name` with `arity` trailing
// arguments names; the first call of each arity notes it.
sema_inline_note_variadic_arity: fn(rewrite: &SemaInlineRewrite, name: String, arity: Int) -> String Never! {
    arities := rewrite.variadic_arities.get(name) ?? [Int]{}
    loop known in arities {
        if known == arity -> return "{name}__va{arity}"
    }
    &arities.push(arity)
    rewrite.variadic_arities[name] = ^arities
    "{name}__va{arity}"
}

// The variadic parameter a slot's generated type parameter stands for
// (`items__Va0` -> `items`), so diagnostics name the parameter the user wrote.
sema_variadic_bound_slot_parameter: fn(type_name: String) -> String? Never! {
    sema_variadic_bound_stem(type_name, "__Va")
}

// The function an arity function specializes (`log_all__va2` -> `log_all`),
// so diagnostics name the function the user called.
sema_variadic_bound_callee: fn(name: String) -> String Never! {
    sema_variadic_bound_stem(name, "__va") ?? name.copy()
}

sema_variadic_bound_stem: fn(name: String, marker: String) -> String? Never! {
    parts: name.split(marker).to_list()
    if parts.len() != 2 || parts[0] == "" || parts[1] == "" -> return None
    loop byte in parts[1].bytes() {
        code: Int.from_u8(byte)
        if code < 48 || code > 57 -> return None
    }
    Val(parts[0].copy())
}

sema_variadic_bound_slot_name: fn(parameter: String, index: Int) -> String Never! {
    "{parameter}__va{index}"
}

// The `arity` function of `function`: its fixed parameters, then one slot
// per argument of its own generic type, and the loop unrolled over them.
sema_variadic_bound_specialize: fn(function: Func, bounds: [String], arity: Int) -> Func {
    last: function.params[function.params.len() - 1]
    updated := function
    updated.name = "{function.name}__va{arity}"
    params := [Param]{}
    loop index in 0..<(function.params.len() - 1) -> &params.push(function.params[index])
    loop index in 0..<arity {
        type_name: "{last.name}__Va{index}"
        &updated.type_params.push(TypeParam{name: type_name, name_span: last.ty_span, bounds: bounds, prep: None})
        &params.push(Param{convention: last.convention, root: false, name: sema_variadic_bound_slot_name(last.name, index), name_span: last.name_span, public_label: None, zone: ParamZone.PositionalOnly, ty: Type.Named{name: type_name}, ty_span: last.ty_span, default: None, variadic: false, variadic_bound_list: None, declared_view_from_names: None, declared_footprint: None})
    }
    updated.params = ^params
    body := [Stmt]{}
    loop statement in function.body {
        if sema_variadic_bound_direct_loop(statement, last.name) {
            if statement == .For(variable, variable_span, _, _, loop_body, _, _, _, _) {
                loop index in 0..<arity {
                    slot := sema_inline_rewrite_empty()
                    slot.values[variable] = Expr.Ident{name: sema_variadic_bound_slot_name(last.name, index), span: variable_span, id: AST_NODE_GENERATED}
                    loop unrolled in sema_inline_rewrite_stmts(&slot, loop_body) -> &body.push(unrolled)
                }
            }
            next
        }
        &body.push(statement)
    }
    updated.body = ^body
    updated
}

// The direct `loop x in parts` statement the shape check counts.
sema_variadic_bound_direct_loop: fn(statement: Stmt, name: String) -> Bool Never! {
    if statement == .For(_, _, second, kind, _, _, _, label, _) {
        if second != None || label != None -> return false
        if kind == .In(collection, step) {
            if step != None -> return false
            if collection == .Ident(collection_name, _, _) -> return collection_name == name
        }
    }
    false
}
