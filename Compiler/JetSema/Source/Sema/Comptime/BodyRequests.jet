// Body-level staged values share the canonical Sema item checker/evaluator.
// A site has no typed value until its expression is staged and its owner body
// is checked again with that value available.
use jet_foundation.[
    ModuleID,
    module_index,
    Expr,
    CompilerTraceSink,
    Name,
    Span,
    SymbolKind,
    TComptimeReport,
    TComptimeValue,
    Type,
    name_find,
    name_index,
    name_intern,
    name_table_sized,
    name_text,
]

sema_comptime_body_destination_key: fn(function_key: String, source_span: Span, site_span: Span) -> String Never! {
    "{function_key}.body-comptime.{site_span.start}:{site_span.end}.{source_span.start}:{source_span.end}"
}

// The place of body source `source` (SemaComptimeBodyValue.place).
sema_comptime_body_source_place: fn(source: SemaComptimeBodySource) -> SemaComptimeBodyPlace Never! {
    SemaComptimeBodyPlace{owner: source.site_owner ?? source.function_key, source: source.span, site: source.site_span}
}

// The slot of `module_identity` in a place index, as
// sema_comptime_index_module_slot gives one in a key index.
sema_comptime_place_module_slot: fn(modules: ^[Int], rows: ^[SemaComptimePlaceRows], module_identity: ModuleID) -> Int Never! {
    slot: sema_comptime_claim_module_slot(modules, module_identity, rows.len())
    if slot == rows.len() -> rows.push(SemaComptimePlaceRows{owners: name_table_sized(SEMA_COMPTIME_KEY_SLOTS), rows: [SemaComptimePlaceKey:Int]{}})
    slot
}

// The key of the place `owner`, `source`, `site` in `index`, its owner
// interned on first use.
sema_comptime_place_key: fn(index: ^SemaComptimePlaceRows, owner: String, source: Span, site: Span) -> SemaComptimePlaceKey Never! {
    SemaComptimePlaceKey{owner: name_index(name_intern(index.owners, owner)), source: source, site: site}
}

// The key of the place `owner`, `source`, `site` in `index`; None when no
// place of `owner` is in it.
sema_comptime_place_find: fn(index: SemaComptimePlaceRows, owner: String, source: Span, site: Span) -> SemaComptimePlaceKey? Never! {
    id: name_find(index.owners, owner) ?? return None
    Val(SemaComptimePlaceKey{owner: name_index(id), source: source, site: site})
}

// Module slots keep both identity components separate: `modules` holds each
// module's slot at its ModuleID row (module_index), -1 for a module without
// one. Reads return only Int rows; no lookup materializes an owning map,
// expression, or staged value.
sema_comptime_index_module_slot: fn(modules: ^[Int], rows: ^[SemaComptimeKeyRows], module_identity: ModuleID) -> Int Never! {
    slot: sema_comptime_claim_module_slot(modules, module_identity, rows.len())
    if slot == rows.len() -> rows.push(sema_comptime_key_rows())
    slot
}

// A module's staged keys start few: its key table starts small.
SEMA_COMPTIME_KEY_SLOTS: 16

sema_comptime_key_rows: fn() -> SemaComptimeKeyRows Never! {
    SemaComptimeKeyRows{keys: name_table_sized(SEMA_COMPTIME_KEY_SLOTS), rows: [Int]{-1}}
}

// The id of `key` in `index`, interned on first use with no row.
sema_comptime_key_id: fn(index: ^SemaComptimeKeyRows, key: String) -> Int Never! {
    id: name_index(name_intern(index.keys, key))
    if id == index.rows.len() -> index.rows.push(-1)
    id
}

// The row `key` names in `index`, if any.
sema_comptime_key_row: fn(index: SemaComptimeKeyRows, key: String) -> Int? Never! {
    id: name_find(index.keys, key) ?? return None
    row: index.rows[name_index(id)]
    if row < 0 -> return None
    Val(row)
}

// The slot of `module_identity` in `modules`; a module without one takes
// `fresh`, the caller's next free slot.
sema_comptime_claim_module_slot: fn(modules: ^[Int], module_identity: ModuleID, fresh: Int) -> Int Never! {
    position: module_index(module_identity)
    loop modules.len() <= position -> modules.push(-1)
    if modules[position] < 0 -> modules[position] = fresh
    modules[position]
}

// The slot of `module_identity` in `modules` (sema_comptime_index_module_slot).
sema_comptime_module_slot: fn(modules: [Int], module_identity: ModuleID) -> Int? Never! {
    position: module_index(module_identity)
    if position >= modules.len() || modules[position] < 0 -> return None
    Val(modules[position])
}

// A set of staged keys, each with the module it sits in. Each module's slot
// sits at its ModuleID row (`modules`, sema_comptime_index_module_slot) and
// holds that module's key table; `pair_slots`/`pair_keys` list each pair as
// added, by slot and key id, so the set reads back in order. The two parts
// of a pair stay apart: no lookup joins a module and a key into one text.
SemaComptimeKeySet: struct {
    modules: [Int]{[Int]{}},
    slots: [SemaComptimeKeyRows]{[SemaComptimeKeyRows]{}},
    // Each slot's ModuleID.
    slot_modules: [U32]{[U32]{}},
    pair_slots: [Int]{[Int]{}},
    pair_keys: [Int]{[Int]{}},
}

// The pair of `key` of `module_identity` in `set`, its place in the order
// added, adding it when new.
sema_comptime_key_set_index: fn(set: ^SemaComptimeKeySet, module_identity: ModuleID, key: String) -> Int Never! {
    slot: sema_comptime_index_module_slot(set.modules, set.slots, module_identity)
    if slot == set.slot_modules.len() -> set.slot_modules.push(module_identity.id)
    id: sema_comptime_key_id(set.slots[slot], key)
    if set.slots[slot].rows[id] < 0 {
        set.slots[slot].rows[id] = set.pair_slots.len()
        set.pair_slots.push(slot)
        set.pair_keys.push(id)
    }
    set.slots[slot].rows[id]
}

// Adds `key` of `module_identity` to `set`; false when the set held it.
sema_comptime_key_set_add: fn(set: ^SemaComptimeKeySet, module_identity: ModuleID, key: String) -> Bool Never! {
    count: set.pair_slots.len()
    sema_comptime_key_set_index(set, module_identity, key) == count
}

// The pair of `key` of `module_identity` in `set`, if it holds one.
sema_comptime_key_set_pair: fn(set: SemaComptimeKeySet, module_identity: ModuleID, key: String) -> Int? Never! {
    slot: sema_comptime_module_slot(set.modules, module_identity) ?? return None
    sema_comptime_key_row(set.slots[slot], key)
}

// Whether `set` holds `key` of `module_identity`.
sema_comptime_key_set_has: fn(set: SemaComptimeKeySet, module_identity: ModuleID, key: String) -> Bool Never! {
    sema_comptime_key_set_pair(set, module_identity, key) != None
}

// How many pairs `set` holds.
sema_comptime_key_set_len: fn(set: SemaComptimeKeySet) -> Int Never! {
    set.pair_slots.len()
}

// The module of pair `pair` of `set`, in the order added.
sema_comptime_key_set_module: fn(set: SemaComptimeKeySet, pair: Int) -> ModuleID Never! {
    ModuleID{id: set.slot_modules[set.pair_slots[pair]]}
}

// The key of pair `pair` of `set`, in the order added.
sema_comptime_key_set_key: fn(set: SemaComptimeKeySet, pair: Int) -> String Never! {
    name_text(set.slots[set.pair_slots[pair]].keys, Name{id: U32{set.pair_keys[pair]}})
}

// The key of body source `source` in `index` (sema_comptime_place_key).
sema_comptime_body_source_place_key: fn(index: ^SemaComptimePlaceRows, source: SemaComptimeBodySource) -> SemaComptimePlaceKey Never! {
    if source.site_owner == .Val(owner) -> return sema_comptime_place_key(index, owner, source.span, source.site_span)
    sema_comptime_place_key(index, source.function_key, source.span, source.site_span)
}

// The key of body source `source` in `index` (sema_comptime_place_find).
sema_comptime_body_source_place_find: fn(index: SemaComptimePlaceRows, source: SemaComptimeBodySource) -> SemaComptimePlaceKey? Never! {
    if source.site_owner == .Val(owner) -> return sema_comptime_place_find(index, owner, source.span, source.site_span)
    sema_comptime_place_find(index, source.function_key, source.span, source.site_span)
}

sema_comptime_body_source_index: fn(context: ^SemaCheckContext, row: Int) Never! {
    slot: sema_comptime_place_module_slot(context.comptime_body_source_modules, context.comptime_body_source_rows, context.comptime_body_sources[row].module_identity)
    key: sema_comptime_body_source_place_key(context.comptime_body_source_rows[slot], context.comptime_body_sources[row])
    if (context.comptime_body_source_rows[slot].rows.get(key) ?? -1) < 0 -> context.comptime_body_source_rows[slot].rows[key] = row
}

sema_comptime_body_sources_index: fn(context: ^SemaCheckContext) Never! {
    context.comptime_body_source_modules = [Int]{}
    context.comptime_body_source_rows = [SemaComptimePlaceRows]{}
    loop row in 0..<context.comptime_body_sources.len() {
        sema_comptime_body_source_index(context, row)
    }
}

// The first source row staged at the place `owner`, `source`, `site` of
// module `module_identity`, if any.
sema_comptime_body_source_row: fn(context: SemaCheckContext, module_identity: ModuleID, owner: String, source: Span, site: Span) -> Int? Never! {
    slot: sema_comptime_module_slot(context.comptime_body_source_modules, module_identity) ?? return None
    key: sema_comptime_place_find(context.comptime_body_source_rows[slot], owner, source, site) ?? return None
    row: context.comptime_body_source_rows[slot].rows.get(key) ?? return None
    if row < 0 -> return None
    Val(row)
}

// Lambda merges append every canonical row, including duplicates, in order.
// Only capture deduplicates, returning the first existing row; the index
// keeps a place's first row, so truncation can drop each appended row's entry.
sema_comptime_body_source_append: fn(context: ^SemaCheckContext, source: SemaComptimeBodySource) Never! {
    context.comptime_body_sources.push(source.copy())
    sema_comptime_body_source_index(context, context.comptime_body_sources.len() - 1)
}

// Drops the source rows from `length` on, and each index entry that points at
// one of them: a place keeps its first row, so the entry of a dropped row
// that is a later duplicate stays on the earlier row.
sema_comptime_body_sources_truncate: fn(context: ^SemaCheckContext, length: Int) Never! {
    loop context.comptime_body_sources.len() > length {
        row: context.comptime_body_sources.len() - 1
        if sema_comptime_module_slot(context.comptime_body_source_modules, context.comptime_body_sources[row].module_identity) == .Val(slot) {
            if sema_comptime_body_source_place_find(context.comptime_body_source_rows[slot], context.comptime_body_sources[row]) == .Val(key) {
                if (context.comptime_body_source_rows[slot].rows.get(key) ?? -1) == row {
                    context.comptime_body_source_rows[slot].rows[key] = -1
                }
            }
        }
        _ := context.comptime_body_sources.pop()
    }
}

sema_comptime_body_value_index_row: fn(modules: ^[Int], first_rows: ^[SemaComptimePlaceRows], second_rows: ^[[SemaComptimePlaceKey:Int]], module_identity: ModuleID, place: SemaComptimeBodyPlace, row: Int) Never! {
    slot: sema_comptime_place_module_slot(modules, first_rows, module_identity)
    if second_rows.len() < first_rows.len() -> second_rows.push([SemaComptimePlaceKey:Int]{})
    key: sema_comptime_place_key(first_rows[slot], place.owner, place.source, place.site)
    if first_rows[slot].rows.get(key) == None {
        first_rows[slot].rows[key] = row
        return
    }
    if second_rows[slot].get(key) == None -> second_rows[slot][key] = row
}

// First and second positions settle every ordered prefix. Appending future
// rows never rewrites either existing position or an earlier row payload.
// A row without a place is kept but indexed under none: no body check
// reads it.
sema_comptime_body_values_freeze: fn(values: ^^[SemaComptimeBodyValue], work: Shared<SemaComptimeBodyWork>?, count_key_bytes: Bool) -> SemaComptimeBodyValues Never! {
    length: values.len()
    modules := [Int]{}
    first_rows := [SemaComptimePlaceRows]{}
    second_rows := [[SemaComptimePlaceKey:Int]]{}
    indexed_rows := 0
    index_key_utf8_bytes := 0
    loop row in 0..<length {
        indexed_rows += 1
        if values[row].place == .Val(place) {
            sema_comptime_body_value_index_row(modules, first_rows, second_rows, values[row].module_identity, place, row)
            if count_key_bytes -> index_key_utf8_bytes += place.owner.count_bytes()
        }
    }
    if work == .Val(cell) {
        permit := cell.guard_edit()
        permit.value.publications += 1
        permit.value.publication_rows += length
        if length > 0 -> permit.value.index_builds += 1
        permit.value.indexed_rows += indexed_rows
        permit.value.index_key_utf8_bytes += index_key_utf8_bytes
    }
    // copy: a handle copy (a Shared work cell, refcount bump): the frozen publication and the
    // caller's context both count work in the same cell.
    if length == 0 -> return SemaComptimeBodyValues{work: work.copy()}
    SemaComptimeBodyValues{
        facts: Val(Shared{SemaComptimeBodyFacts{values: values.move(), modules: modules.move(), first_rows: first_rows.move(), second_rows: second_rows.move(), indexed_rows: indexed_rows}}),
        length: length,
        // copy: a handle copy (a Shared work cell, refcount bump): the frozen publication and the
        // caller's context both count work in the same cell.
        work: work.copy(),
    }
}

// The staging owner's one payload guard closes before diagnostic counters or
// any caller/evaluator/sink executes. Work is proportional to new item rows.
sema_comptime_body_facts_append_items: fn(facts: Shared<SemaComptimeBodyFacts>, values: [SemaComptimeItemValue], from: Int, expected_length: Int, count_key_bytes: Bool) -> {length: Int, rows: Int, key_utf8_bytes: Int} {
    permit := facts.guard_edit()
    if permit.value.values.len() != expected_length {
        panic("body publication attempted to append through an old prefix generation")
    }
    appended := 0
    key_utf8_bytes := 0
    loop index in from..<values.len() {
        if values[index].kind != SemaComptimeItemKind.BodyExpression -> next
        row: permit.value.values.len()
        if values[index].place == .Val(place) {
            sema_comptime_body_value_index_row(permit.value.modules, permit.value.first_rows, permit.value.second_rows, values[index].module_identity, place, row)
            if count_key_bytes -> key_utf8_bytes += place.owner.count_bytes()
        }
        permit.value.values.push(sema_comptime_body_value_from_item(values[index]))
        permit.value.indexed_rows += 1
        appended += 1
    }
    {key_utf8_bytes: key_utf8_bytes, length: permit.value.values.len(), rows: appended}
}

sema_comptime_body_values_append_items: fn(publication: ^SemaComptimeBodyValues, values: [SemaComptimeItemValue], from: Int) {
    new_generation: if publication.facts == .Val(_) -> false else -> true
    if new_generation {
        if publication.length != 0 -> panic("a body prefix lost its facts owner")
        publication.facts = Val(Shared{SemaComptimeBodyFacts{values: [SemaComptimeBodyValue]{}, modules: [Int]{}, first_rows: [SemaComptimePlaceRows]{}, second_rows: [[SemaComptimePlaceKey:Int]]{}, indexed_rows: 0}})
    }
    facts: publication.facts ?? panic("body publication has no facts owner")
    count_key_bytes: if publication.work == .Val(_) -> true else -> false
    added: sema_comptime_body_facts_append_items(facts, values, from, publication.length, count_key_bytes)
    if added.rows == 0 -> panic("the authenticated body frontier contained no new body row")
    publication.length = added.length
    if publication.work == .Val(cell) {
        permit := cell.guard_edit()
        permit.value.publications += 1
        permit.value.publication_rows += added.rows
        if new_generation -> permit.value.index_builds += 1
        permit.value.indexed_rows += added.rows
        permit.value.index_key_utf8_bytes += added.key_utf8_bytes
    }
}

sema_comptime_body_values_replace: fn(context: ^SemaCheckContext, values: ^^[SemaComptimeBodyValue]) Never! {
    context.comptime_body_values = sema_comptime_body_values_freeze(values, context.comptime_body_values.work, false)
}

sema_comptime_body_values_truncate: fn(context: ^SemaCheckContext, length: Int) Never! {
    if context.comptime_body_values.length > length -> context.comptime_body_values.length = length
}

sema_comptime_body_values_prefix: fn(values: SemaComptimeBodyValues, length: Int) -> SemaComptimeBodyValues Never! {
    // copy: a handle copy (Shared facts plus ints): the prefix narrows its own `length`, while
    // `values` (the caller's publication) keeps its full length.
    prefix := values.copy()
    if prefix.length > length -> prefix.length = length
    prefix.move()
}

// Only the existing function-detail mode owns a diagnostic slot. The slot is
// distinct from immutable facts and is not a global/cache/semantic mechanism.
sema_comptime_body_work_new: fn(trace_sink: CompilerTraceSink?) -> Shared<SemaComptimeBodyWork>? {
    if trace_sink == .Val(sink) {
        if sink.functions() -> return Val(Shared{SemaComptimeBodyWork{}})
    }
    None
}

sema_comptime_body_work_count: fn(values: SemaComptimeBodyValues, operation: SemaComptimeBodyWorkOperation) {
    cell: values.work ?? return
    permit := cell.guard_edit()
    if operation == {
        .FunctionsStarted -> { permit.value.functions_started += 1 }
        .CheckPassStarted -> { permit.value.check_passes_started += 1 }
        .ContextAttached -> { permit.value.context_value_carriers_attached += 1 }
        .ContextSnapshot -> { permit.value.context_value_snapshots += 1 }
        .Query -> { permit.value.queries += 1 }
        .ModuleProbe -> { permit.value.module_probes += 1 }
        .FirstRowProbe -> { permit.value.first_row_probes += 1 }
        .SecondRowProbe -> { permit.value.second_row_probes += 1 }
        .OwnedRowReturned -> permit.value.owned_rows_returned += 1
    }
}

// Copy only scalar diagnostic totals; close the read guard before any sink
// callback can perform host I/O or re-enter an observer.
sema_comptime_body_work_snapshot: fn(cell: Shared<SemaComptimeBodyWork>) -> SemaComptimeBodyWork {
    permit: cell.guard_read()
    permit.value.copy()
}

// Called after tasks join, by the existing phase owner holding the real sink.
// One aggregate event per numeric field, never one filesystem write per query.
sema_comptime_body_work_flush: fn(values: SemaComptimeBodyValues, trace_sink: CompilerTraceSink?, phase: String) {
    cell: values.work ?? return
    if trace_sink == .Val(sink) {
        totals: sema_comptime_body_work_snapshot(cell)
        sink.progress("counters.{phase}.ct_value_publications", totals.publications, -1)
        sink.progress("counters.{phase}.ct_value_publication_rows", totals.publication_rows, -1)
        sink.progress("counters.{phase}.ct_value_index_builds", totals.index_builds, -1)
        sink.progress("counters.{phase}.ct_value_index_rows_visited", totals.indexed_rows, -1)
        sink.progress("counters.{phase}.ct_value_index_key_utf8_bytes", totals.index_key_utf8_bytes, -1)
        sink.progress("counters.{phase}.ct_value_functions_started", totals.functions_started, -1)
        sink.progress("counters.{phase}.ct_value_check_passes_started", totals.check_passes_started, -1)
        sink.progress("counters.{phase}.ct_value_context_value_carriers_attached", totals.context_value_carriers_attached, -1)
        sink.progress("counters.{phase}.ct_value_context_value_snapshots", totals.context_value_snapshots, -1)
        sink.progress("counters.{phase}.ct_value_queries", totals.queries, -1)
        sink.progress("counters.{phase}.ct_value_module_probes", totals.module_probes, -1)
        sink.progress("counters.{phase}.ct_value_first_row_probes", totals.first_row_probes, -1)
        sink.progress("counters.{phase}.ct_value_second_row_probes", totals.second_row_probes, -1)
        sink.progress("counters.{phase}.ct_value_owned_rows_returned", totals.owned_rows_returned, -1)
    }
}

sema_comptime_body_capture: fn(
    context: ^SemaCheckContext,
    environment: SemaScopeEnvironment,
    program: SemaProgramTables,
    scopes: SemaScopeTable,
    name: String,
    expression: Expr,
    expected_type: Type,
    source_span: Span,
    site_span: Span,
) -> SemaComptimeBodySource Never! {
    sema_comptime_body_capture_site(context, environment, scopes, name, expression, expected_type, source_span, site_span, false, false)
}

// An explicit local `name: #run value` whose value is not known yet, staged
// to be computed while compiling; its failures are reported.
sema_comptime_body_capture_binding: fn(
    check: ^SemaBodyCheck,
    name: String,
    expression: Expr,
    expected_type: Type,
    source_span: Span,
    site_span: Span,
) Never! {
    _ := sema_comptime_body_capture_site(check.context, check.environment.*, check.scopes, name, expression, expected_type, source_span, site_span, false, true)
}

// An immutable local `name: value` that calls code, staged to be computed
// while compiling; it stays run-time code when that fails, without a report.
sema_comptime_body_capture_local: fn(
    check: ^SemaBodyCheck,
    name: String,
    expression: Expr,
    expected_type: Type,
    source_span: Span,
    site_span: Span,
) Never! {
    _ := sema_comptime_body_capture_site(check.context, check.environment.*, check.scopes, name, expression, expected_type, source_span, site_span, true, false)
}

sema_comptime_body_capture_site: fn(
    context: ^SemaCheckContext,
    environment: SemaScopeEnvironment,
    scopes: SemaScopeTable,
    name: String,
    expression: Expr,
    expected_type: Type,
    source_span: Span,
    site_span: Span,
    local_value: Bool,
    local_binding: Bool,
) -> SemaComptimeBodySource Never! {
    function_key := sema_scope_function_owner_key(scopes)
    if sema_comptime_body_source_row(context, environment.module_identity, function_key, source_span, site_span) == .Val(row) {
        return context.comptime_body_sources[row]
    }
    destination_key := sema_comptime_body_destination_key(function_key, source_span, site_span)
    key: "{environment.module_identity.id}.{destination_key}"
    source := SemaComptimeBodySource{
        module_identity: environment.module_identity,
        function_key: function_key,
        source_file: sema_source_file_at(environment.source_segments, environment.source_file, environment.source_origin, source_span),
        key: key,
        destination_key: destination_key,
        name: name,
        expression: expression,
        expected_type: expected_type,
        span: source_span,
        site_span: site_span,
        prepared: sema_comptime_body_prepared_locals(environment, scopes),
        impure: sema_scope_inside_impure(scopes),
        runtime_locals: sema_comptime_body_runtime_locals(scopes),
        local_value: local_value,
        local_binding: local_binding,
    }
    sema_comptime_body_source_append(context, source)
    source
}

// The prepared locals the site can read: each visible binding with a value.
sema_comptime_body_prepared_locals: fn(environment: SemaScopeEnvironment, scopes: SemaScopeTable) -> [SemaComptimePreparedLocal] Never! {
    prepared := [SemaComptimePreparedLocal]{}
    loop index in 0..<scopes.bindings.len() {
        if scopes.bindings[index].prepared == None -> next
        binding: sema_scope_binding_row(environment, scopes, index)
        if sema_scope_resolve_index(scopes, binding.symbol.name) != .Val(index) -> next
        value: binding.prepared ?? next
        ty: binding.symbol.ty ?? next
        prepared.push(SemaComptimePreparedLocal{name: binding.symbol.name, ty: ty, value: value, span: binding.symbol.span})
    }
    prepared
}

// The run-time locals the site can see but not read: each visible binding
// of the function around the site without a prepared value, by name. The
// module's root frame is skipped: its items and builtins resolve in the
// staged check's own module table, so none of them reads as a run-time
// local there, and walking them at every site cost each body a pass over
// the whole module.
sema_comptime_body_runtime_locals: fn(scopes: SemaScopeTable) -> [String] Never! {
    names := [String]{}
    loop index in 0..<scopes.bindings.len() {
        if scopes.bindings[index].frame == 0 || scopes.bindings[index].prepared != None -> next
        name: scopes.bindings[index].symbol.name
        if sema_scope_resolve_index(scopes, name) != .Val(index) -> next
        names.push(name.copy())
    }
    names
}

// Whether the compile-time code checked since `reference_start` reads a
// `name: #run value` local whose value has not landed yet. That code waits:
// it is not staged in this pass, its owner body stays incomplete, and the
// body is checked again once the local holds its value. Staged now, it
// would read the local as a run-time value (E0640).
sema_comptime_reads_pending_local: fn(check: SemaBodyCheck, reference_start: Int) -> Bool Never! {
    loop index in reference_start..<check.context.name_references.len() {
        reference: check.context.name_references[index]
        if reference.kind != Val(SymbolKind.Local) -> next
        position: sema_scope_resolve_index(check.scopes, reference.symbol.name) ?? next
        if check.scopes.bindings[position].pending_prepared -> return true
    }
    false
}

// The value landed at the place `owner`, `source_span`, `site_span` of
// module `module_identity`, where `owner` is the key the site is staged
// under (SemaComptimeBodySource.site_owner); None when no row or two rows
// of the visible prefix hold it.
sema_comptime_body_value_find: fn(
    context: SemaCheckContext,
    module_identity: ModuleID,
    owner: String,
    source_span: Span,
    site_span: Span,
) -> SemaComptimeBodyValue? {
    sema_comptime_body_work_count(context.comptime_body_values, SemaComptimeBodyWorkOperation.Query)
    if context.comptime_body_values.length == 0 -> return None
    facts: context.comptime_body_values.facts ?? return None
    permit: facts.guard_read()
    sema_comptime_body_work_count(context.comptime_body_values, SemaComptimeBodyWorkOperation.ModuleProbe)
    slot: sema_comptime_module_slot(permit.value.modules, module_identity) ?? return None
    sema_comptime_body_work_count(context.comptime_body_values, SemaComptimeBodyWorkOperation.FirstRowProbe)
    key: sema_comptime_place_find(permit.value.first_rows[slot], owner, source_span, site_span) ?? return None
    row: permit.value.first_rows[slot].rows.get(key) ?? return None
    if row >= context.comptime_body_values.length -> return None
    sema_comptime_body_work_count(context.comptime_body_values, SemaComptimeBodyWorkOperation.SecondRowProbe)
    second: permit.value.second_rows[slot].get(key) ?? -1
    if second >= 0 && second < context.comptime_body_values.length -> return None
    sema_comptime_body_work_count(context.comptime_body_values, SemaComptimeBodyWorkOperation.OwnedRowReturned)
    // copy: the caller gets an owned body value, while the published row stays in the shared facts
    // for every other reader. It is reachable only through this read guard.
    Val(permit.value.values[row].copy())
}

sema_comptime_body_item_source: fn(source: SemaComptimeBodySource) -> SemaComptimeItemSource Never! {
    SemaComptimeItemSource{
        module_identity: source.module_identity,
        key: source.key,
        destination_key: source.destination_key,
        name: source.name,
        source_file: source.source_file,
        kind: SemaComptimeItemKind.BodyExpression,
        expression: source.expression,
        expected_type: Val(source.expected_type),
        span: source.span,
        dependencies: [String]{},
        checked_text: None,
        prepared: source.prepared,
        impure: source.impure,
        runtime_locals: source.runtime_locals,
        place: Val(sema_comptime_body_source_place(source)),
        local_value: source.local_value,
        local_binding: source.local_binding,
    }
}

// The landed value of a local left to run time: a failure holding why.
sema_comptime_local_value_failure: fn(reason: String) -> TComptimeValue Never! {
    TComptimeValue.Failed{report: TComptimeReport.Told{value: TComptimeValue.String{value: reason}}}
}

// Why a local whose landed value is `value` stays run-time code, or None
// when it holds that value.
sema_comptime_local_value_reason: fn(value: TComptimeValue) -> String? Never! {
    if value == .Failed(report) {
        if report == .Told(told) {
            if told == .String(text) -> return Val(text.copy())
        }
        return Val("computing it returns an error")
    }
    None
}
