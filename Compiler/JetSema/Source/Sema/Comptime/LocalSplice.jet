// A body comptime pass whose landed sites are all local values
// (LocalValues.jet) changes only the bodies that hold them: a binding checks
// its initializer in full before its value replaces the call, so the facts
// that check records are the same with the value as without it. Instead of
// finalizing the whole program again (sema_finalize_graph), the pass checks
// only the owner functions again, the way a Core demand wave checks named
// bodies (graph.core_wave_rows), once with the values the finalized result
// was checked against and once with the pass's values, and splices the
// second check's bodies into the finalized result.
//
// The first check proves the splice. Its owner bodies, given the stamps the
// whole-program passes put on a body (sema_local_splice_settle), must equal
// the finalized ones, so the check is the one the finalization made. And
// every row a module merges across its function checks (SemaModuleBodyRows)
// must be the same in both checks, but for the landed sites that got values
// leaving `comptime_body_sources` (one whose outcome is a run-time reason
// stays): the call facts, hardware use, name references,
// comptime requests, compute facts, `exact_int_reachable`, copy events,
// diagnostics, `complete`, failure facts, incomplete reasons, injected
// functions and their keys, and tests. No landed site whose value is not a
// failure may hold a call fact strictly inside its span: the effect solve
// walks the bodies, and a value node, which takes its initializer's span,
// finds only the call fact of that span (sema_effect_find_exact_fact), so the
// edges of any call inside it (an argument's call, a `?? panic`) leave with
// the value, and the finalized stamps would keep them. The comptime function
// results must bring the same diagnostics too, but for lints on Core source,
// which the finalization drops, and they must name no Core body that waits
// for demand, which the recheck's Core demand seeds from them in a compile
// that lowers (and whose failure facts it solves again). Then every
// whole-program pass after the body pass (failure solve and recheck,
// effects, taint, Core usage, names) reads what it read in the finalization,
// so its rows stand, and the stamps it put on the owners carry over. When any
// of this fails, or a site is not a local value, the caller finalizes again.
use jet_foundation.[
    CompilerThreads,
    CompilerTraceSink,
    Diagnostic,
    FnBody,
    TargetHardwareUse,
    TTestFact,
    Type,
]

// The rows of one module result that its function checks fill, moved out so
// a check can fill them afresh (sema_module_body_rows_take).
SemaModuleBodyRows: struct {
    functions: [FnBody]
    call_facts: [SemaCallSiteFact]
    hardware_use: TargetHardwareUse
    name_references: [SemaNameReferenceFact]
    comptime_requests: [SemaComptimeRequest]
    comptime_body_sources: [SemaComptimeBodySource]
    compute_facts: [SemaComputeFunctionFacts]
    exact_int_reachable: Bool
    copy_events: [SemaCopyEvent]
    diagnostics: [Diagnostic]
    complete: Bool
    failure_facts: [SemaFunctionFailureFacts]
    incomplete_reasons: [String]
    injected_function_keys: [String]
    tests: [TTestFact]
}

// Moves the function-check rows of `modules[index]` out, leaving them empty.
// The result and the ones after it move out of the list and back in, so no
// row is copied.
sema_module_body_rows_take: fn(modules: &[SemaGraphModuleResult], index: Int) -> SemaModuleBodyRows Never! {
    later := [SemaGraphModuleResult]{}
    loop modules.len() > index + 1 {
        moved := modules.pop() ?? break
        later.push(moved)
    }
    result := modules.pop() ?? panic("a local value splice lost its owner module")
    rows := SemaModuleBodyRows{
        functions: result.functions.move(),
        call_facts: result.call_facts.move(),
        hardware_use: result.hardware_use.move(),
        name_references: result.name_references.move(),
        comptime_requests: result.comptime_requests.move(),
        comptime_body_sources: result.comptime_body_sources.move(),
        compute_facts: result.compute_facts.move(),
        exact_int_reachable: result.exact_int_reachable,
        copy_events: result.copy_events.move(),
        diagnostics: result.diagnostics.move(),
        complete: result.complete,
        failure_facts: result.failure_facts.move(),
        incomplete_reasons: result.incomplete_reasons.move(),
        injected_function_keys: result.injected_function_keys.move(),
        tests: result.tests.move(),
    }
    result.functions = [FnBody]{}
    result.call_facts = [SemaCallSiteFact]{}
    result.hardware_use = sema_hardware_empty_use()
    result.name_references = [SemaNameReferenceFact]{}
    result.comptime_requests = [SemaComptimeRequest]{}
    result.comptime_body_sources = [SemaComptimeBodySource]{}
    result.compute_facts = [SemaComputeFunctionFacts]{}
    result.exact_int_reachable = false
    result.copy_events = [SemaCopyEvent]{}
    result.diagnostics = [Diagnostic]{}
    result.complete = true
    result.failure_facts = [SemaFunctionFailureFacts]{}
    result.incomplete_reasons = [String]{}
    result.injected_function_keys = [String]{}
    result.tests = [TTestFact]{}
    modules.push(result)
    loop later.len() > 0 {
        moved := later.pop() ?? break
        modules.push(moved)
    }
    rows
}

// Moves `rows` back into `modules[index]`, as sema_module_body_rows_take
// moved them out.
sema_module_body_rows_put: fn(modules: &[SemaGraphModuleResult], index: Int, rows: &&SemaModuleBodyRows) Never! {
    owned := rows.move()
    later := [SemaGraphModuleResult]{}
    loop modules.len() > index + 1 {
        moved := modules.pop() ?? break
        later.push(moved)
    }
    result := modules.pop() ?? panic("a local value splice lost its owner module")
    result.functions = owned.functions.move()
    result.call_facts = owned.call_facts.move()
    result.hardware_use = owned.hardware_use.move()
    result.name_references = owned.name_references.move()
    result.comptime_requests = owned.comptime_requests.move()
    result.comptime_body_sources = owned.comptime_body_sources.move()
    result.compute_facts = owned.compute_facts.move()
    result.exact_int_reachable = owned.exact_int_reachable
    result.copy_events = owned.copy_events.move()
    result.diagnostics = owned.diagnostics.move()
    result.complete = owned.complete
    result.failure_facts = owned.failure_facts.move()
    result.incomplete_reasons = owned.incomplete_reasons.move()
    result.injected_function_keys = owned.injected_function_keys.move()
    result.tests = owned.tests.move()
    modules.push(result)
    loop later.len() > 0 {
        moved := later.pop() ?? break
        modules.push(moved)
    }
}

// The merged rows of `rows` the whole-program passes read, as one text:
// all but the bodies and the body comptime sites.
sema_module_body_rows_text: fn(rows: SemaModuleBodyRows) -> String Never! {
    "calls={rows.call_facts:Debug};hardware={rows.hardware_use:Debug};names={rows.name_references:Debug};requests={rows.comptime_requests:Debug};compute={rows.compute_facts:Debug};exact={rows.exact_int_reachable};copies={rows.copy_events:Debug};diagnostics={rows.diagnostics:Debug};complete={rows.complete};failures={rows.failure_facts:Debug};incomplete={rows.incomplete_reasons:Debug};injected={rows.injected_function_keys:Debug};tests={rows.tests:Debug}"
}

// The position of the one function `key` in `functions`; None when there is
// none or more than one.
sema_local_splice_slot: fn(functions: [FnBody], key: String) -> Int? Never! {
    found := Int?{None}
    loop index in 0..<functions.len() {
        if functions[index].key != key -> next
        if found != None -> return None
        found = Val(index)
    }
    found
}

// Puts on a freshly checked `body` what the whole-program passes after the
// body pass put on its finalized check `finalized`: the projected `T Never!`
// carrier (sema_failure_reconcile_infallible), the solved effects and their
// scope frames (sema_effects_check_modules), the masked branches and the
// fixed tags (sema_mark_masked_branches), and the web bucket
// (sema_web_partition_check). The fresh body's types are its finalized
// check's, less those of the replaced initializers, so it carries a fixed tag
// only when the finalized body did.
sema_local_splice_settle: fn(body: &FnBody, finalized: FnBody) Never! {
    if finalized.ret == .Val(.Result(_, err)) {
        never: Type.Named{name: "Never"}
        if err == never && body.ret != finalized.ret -> sema_failure_reconcile_function(body)
    }
    body.effects = finalized.effects.copy()
    body.effect_scope = finalized.effect_scope.copy()
    body.masked = finalized.masked.copy()
    body.web_bucket = finalized.web_bucket
    if finalized.fixed_tags.len() > 0 && sema_fixed_types(body.tree.types.types, finalized.fixed_tags) -> body.fixed_tags = finalized.fixed_tags.copy()
}

// The sources of `sources` that are not landed (`landed` holds their
// `module\nkey`).
sema_local_splice_unlanded: fn(sources: [SemaComptimeBodySource], landed: [String:Bool]) -> [SemaComptimeBodySource] Never! {
    kept := [SemaComptimeBodySource]{}
    loop source in sources {
        if landed.get("{source.module_identity}\n{source.key}") == None -> kept.push(source.copy())
    }
    kept
}

// The sites of `landed` (`module\nkey`) that leave the source rows of the
// pass's check of the owner modules (`after`): the ones that got values.
sema_local_splice_valued: fn(landed: [String:Bool], after: [SemaModuleBodyRows]) -> [String:Bool] Never! {
    remaining := [String:Bool]{}
    loop rows in after {
        loop source in rows.comptime_body_sources -> remaining["{source.module_identity}\n{source.key}"] = true
    }
    valued := [String:Bool]{}
    loop (site, _) in landed {
        if remaining.get(site) == None -> valued[site.copy()] = true
    }
    valued
}

// Whether the two checks of the owner modules (`earlier` against the
// finalized values, which it takes, and `after` against the pass's) let the
// splice stand, as the file comment says. `owners` holds the owner function
// keys, `landed` the `module\nkey` of each landed site that got a value, and
// `computed` those of them whose value is not a failure.
sema_local_splice_holds: fn(modules: [SemaGraphModuleResult], owner_modules: [Int], owners: [String:Bool], landed: [String:Bool], computed: [String:Bool], earlier: &&[SemaModuleBodyRows], after: [SemaModuleBodyRows]) -> Bool Never! {
    before := earlier.move()
    settled_owners := 0
    position := owner_modules.len()
    loop before.len() > 0 {
        position -= 1
        old := before.pop() ?? break
        new: after[position]
        module_index: owner_modules[position]
        if sema_module_body_rows_text(old) != sema_module_body_rows_text(new) -> return false
        // A value keeps only the effects of the call at its own span. A
        // failure keeps the initializer as run-time code, calls and all.
        if sema_local_splice_inner_call(old, computed) -> return false
        kept: sema_local_splice_unlanded(old.comptime_body_sources, landed)
        if "{kept:Debug}" != "{new.comptime_body_sources:Debug}" -> return false
        if old.functions.len() != new.functions.len() -> return false
        checked := old.functions.move()
        index := checked.len()
        loop checked.len() > 0 {
            index -= 1
            function := checked.pop() ?? break
            if new.functions[index].key != function.key -> return false
            if owners.get(function.key) == None {
                if "{function:Debug}" != "{new.functions[index]:Debug}" -> return false
                next
            }
            slot: sema_local_splice_slot(modules[module_index].functions, function.key) ?? return false
            sema_local_splice_settle(function, modules[module_index].functions[slot])
            if "{function:Debug}" != "{modules[module_index].functions[slot]:Debug}" -> return false
            settled_owners += 1
        }
    }
    settled_owners == owners.len()
}

// The sites of `landed` (`module\nkey`) whose value in `values` is not a
// failure (sema_comptime_local_value_reason): the ones whose value replaces
// the initializer.
sema_local_splice_computed: fn(landed: [String:Bool], values: [SemaComptimeItemValue]) -> [String:Bool] Never! {
    computed := [String:Bool]{}
    loop value in values {
        site: "{value.module_identity}\n{value.key}"
        if landed.get(site) != None && sema_comptime_local_value_reason(value.value) == None -> computed[site] = true
    }
    computed
}

// Whether a site of `rows` in `sites` (`module\nkey`) holds a call fact of
// its owner whose span is strictly inside the site's.
sema_local_splice_inner_call: fn(rows: SemaModuleBodyRows, sites: [String:Bool]) -> Bool Never! {
    loop source in rows.comptime_body_sources {
        if sites.get("{source.module_identity}\n{source.key}") == None -> next
        loop fact in rows.call_facts {
            if fact.caller_key != source.function_key -> next
            if fact.span.start < source.span.start || fact.span.end > source.span.end -> next
            if fact.span.start != source.span.start || fact.span.end != source.span.end -> return true
        }
    }
    false
}

// Whether the pass's comptime functions name a Core body that waits for
// demand (graph.core_demand_rows), checked or not. A compile that lowers
// seeds its Core demand with what they name (sema_core_demand_waves), so the
// full recheck checks it as their demand and solves its failure facts
// again, which may restamp it and the bodies that call it; any compile
// refuses the splice then.
sema_local_splice_demands_core: fn(graph: SemaRegistrationGraph, functions: [SemaComptimeFunctionResult]) -> Bool Never! {
    if graph.core_demand_rows.len() == 0 -> return false
    keys := [String]{}
    loop result in functions {
        if result.function == .Val(function) -> sema_core_demand_body_keys(function, graph.decls, keys)
        loop fact in result.call_facts {
            if fact.callee == .Val(callee) -> keys.push(callee.key)
        }
    }
    loop key in keys {
        if graph.core_demand_rows.get(key) != None || graph.core_demand_rows.get(sema_core_demand_template_key(key)) != None -> return true
    }
    false
}

// What sema_local_value_splice hands back: the graph, and whether the pass's
// values landed.
SemaLocalValueSplice: struct {
    graph: SemaRegistrationGraph
    spliced: Bool
}

// Lands the pass's local values in `finalized`, the result of
// `sema_finalize_graph` over `earlier_values` and `earlier_functions`, when
// the file comment's conditions hold. The graph moves in and comes back with
// its edits on `trail`, as sema_finalize_graph's do. `landed` are the pass's
// sites; `values` and `comptime_functions` the pass's results.
sema_local_value_splice: fn(
    resolved: &&SemaRegistrationGraph,
    trail: &SemaGraphTrail,
    finalized: &SemaGraphResult,
    landed: [SemaComptimeItemSource],
    earlier_values: [SemaComptimeItemValue],
    earlier_functions: [SemaComptimeFunctionResult],
    values: [SemaComptimeItemValue],
    comptime_functions: [SemaComptimeFunctionResult],
    host_hooks: Shared<SemaRegistrationHostHooks>,
    threads: CompilerThreads,
    trace_sink: CompilerTraceSink?,
) -> SemaLocalValueSplice {
    graph := resolved.move()
    if !finalized.complete || landed.len() == 0 -> return SemaLocalValueSplice{graph: graph.move(), spliced: false}
    landed_keys := [String:Bool]{}
    loop source in landed {
        if !source.local_value -> return SemaLocalValueSplice{graph: graph.move(), spliced: false}
        landed_keys["{source.module_identity}\n{source.key}"] = true
    }
    // The comptime function results bring the finalization's diagnostics. A
    // lint on Core source only rides the list until sema_finalize_graph
    // drops it, so the functions a pass adds may bring those.
    earlier_diagnostics := [Diagnostic]{}
    earlier_complete: sema_comptime_function_diagnostics(earlier_functions, earlier_diagnostics)
    pass_diagnostics := [Diagnostic]{}
    pass_complete: sema_comptime_function_diagnostics(comptime_functions, pass_diagnostics)
    if earlier_complete != pass_complete || sema_local_splice_kept_diagnostics(earlier_diagnostics) != sema_local_splice_kept_diagnostics(pass_diagnostics) -> return SemaLocalValueSplice{graph: graph.move(), spliced: false}
    owners := [String:Bool]{}
    owner_modules := [Int]{}
    found := [String:Bool]{}
    loop module_index in 0..<finalized.modules.len() {
        loop source in finalized.modules[module_index].comptime_body_sources {
            site: "{source.module_identity}\n{source.key}"
            if landed_keys.get(site) == None -> next
            if source.function_key == "" -> return SemaLocalValueSplice{graph: graph.move(), spliced: false}
            found[site] = true
            owners[source.function_key] = true
            if !owner_modules.contains(module_index) -> owner_modules.push(module_index)
        }
    }
    if found.len() != landed_keys.len() -> return SemaLocalValueSplice{graph: graph.move(), spliced: false}
    if sema_local_splice_demands_core(graph, comptime_functions) -> return SemaLocalValueSplice{graph: graph.move(), spliced: false}
    // As sema_finalize_graph: no lookup counting across the body threads.
    trail.entries.push(SemaGraphUndo.Counting{old: graph.counting})
    graph.counting = false
    graph.core_wave_rows = owners.copy()
    hook_access: sema_host_hook_access(host_hooks)
    checked_types: sema_stage_checked_types(finalized.modules)
    held := [SemaModuleBodyRows]{}
    loop module_index in owner_modules -> held.push(sema_module_body_rows_take(finalized.modules, module_index))
    earlier_facts := [SemaPassFacts]{}
    earlier_graph := sema_finalize_check_modules(graph, earlier_values, earlier_functions, checked_types, owner_modules, true, hook_access, threads, None, "sema.local_values", trace_sink, earlier_facts, finalized.modules)
    graph = earlier_graph.move()
    before := [SemaModuleBodyRows]{}
    loop module_index in owner_modules -> before.push(sema_module_body_rows_take(finalized.modules, module_index))
    pass_facts := [SemaPassFacts]{}
    pass_graph := sema_finalize_check_modules(graph, values, comptime_functions, checked_types, owner_modules, true, hook_access, threads, None, "sema.local_values", trace_sink, pass_facts, finalized.modules)
    graph = pass_graph.move()
    after := [SemaModuleBodyRows]{}
    loop module_index in owner_modules -> after.push(sema_module_body_rows_take(finalized.modules, module_index))
    graph.core_wave_rows = [String:Bool]{}
    row := owner_modules.len()
    loop held.len() > 0 {
        row -= 1
        rows := held.pop() ?? break
        sema_module_body_rows_put(finalized.modules, owner_modules[row], rows)
    }
    // A landed local whose outcome is a run-time reason stays run-time code,
    // so it is still a site of the pass's check, as of the full recheck's;
    // only the sites that got values leave the source rows.
    valued := sema_local_splice_valued(landed_keys, after)
    computed: sema_local_splice_computed(valued, values)
    holds: sema_local_splice_holds(finalized.modules, owner_modules, owners, valued, computed, before, after)
    counter: if holds -> "counters.sema.local_values_spliced" else -> "counters.sema.local_values_refused"
    if trace_sink == .Val(sink) -> sink.progress(counter, owners.len(), -1)
    if !holds -> return SemaLocalValueSplice{graph: graph.move(), spliced: false}
    row = owner_modules.len()
    loop after.len() > 0 {
        row -= 1
        rows := after.pop() ?? break
        module_index: owner_modules[row]
        checked := rows.functions.move()
        loop checked.len() > 0 {
            function := checked.pop() ?? break
            if owners.get(function.key) == None -> next
            slot: sema_local_splice_slot(finalized.modules[module_index].functions, function.key) ?? panic("a spliced local value lost its owner function")
            sema_local_splice_settle(function, finalized.modules[module_index].functions[slot])
            finalized.modules[module_index].functions[slot] = function.move()
        }
        finalized.modules[module_index].comptime_body_sources = sema_local_splice_unlanded(finalized.modules[module_index].comptime_body_sources, valued)
    }
    finalized.comptime_body_sources = sema_local_splice_unlanded(finalized.comptime_body_sources, valued)
    SemaLocalValueSplice{graph: graph.move(), spliced: true}
}

// `diagnostics` but for its lints on Core source, which sema_finalize_graph
// drops, as one string to compare.
sema_local_splice_kept_diagnostics: fn(diagnostics: [Diagnostic]) -> String Never! {
    kept := [Diagnostic]{}
    loop diagnostic in diagnostics {
        if !sema_core_source_lint(diagnostic) -> kept.push(diagnostic.copy())
    }
    "{kept:Debug}"
}
