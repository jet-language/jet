// A body comptime pass whose landed sites are all local values
// (LocalValues.jet) changes only the bodies that hold them: a binding checks
// its initializer in full before its value replaces the call, so the facts
// that check records are the same with the value as without it. Instead of
// finalizing the whole program again (sema_finalize_graph), the pass checks
// only the owner functions again, the way a Core demand wave checks named
// bodies (graph.core_wave_rows), once with the values the finalized result
// was checked against and once with the pass's values, and splices the
// second check's bodies into the finalized result. A function the pass first
// checked to run while compiling is an owner too, a generated codec or
// derived method included: the body pass takes that result in place of
// checking it as a body (sema_comptime_find_checked_function), and records
// the demand that check recorded (SemaDemandCapture), as the full recheck
// does.
//
// The first check proves the splice. Its owner bodies, given the stamps the
// whole-program passes put on a body (sema_local_splice_settle), must equal
// the finalized ones, so the check is the one the finalization made. And
// every row a module merges across its function checks (SemaModuleBodyRows)
// must be the same in both checks, but for the landed sites that got values
// leaving `comptime_body_sources` (one whose outcome is a run-time reason
// stays): the call facts, hardware use, name references,
// comptime requests, compute facts, `exact_int_reachable`, copy events,
// `complete`, failure facts, incomplete reasons, injected functions and
// their keys, and tests. The diagnostics are the same too, but for those
// of a function the pass first checked to run while compiling: its first
// check reports them as an owner body, where its second takes its comptime
// result, whose diagnostics the whole-program half reports
// (sema_comptime_function_diagnostics), so they leave the owner module's
// rows, as in the full recheck (sema_local_splice_holds). No landed site
// whose value is not a failure may hold a call fact strictly inside its
// span: the effect solve walks the bodies, and a value node, which takes
// its initializer's span,
// finds only the call fact of that span (sema_effect_find_exact_fact), so the
// edges of any call inside it (an argument's call, a `?? panic`) leave with
// the value, and the finalized stamps would keep them. The comptime function
// results must bring the same diagnostics too, but for lints on Core source,
// which the finalization drops, and they must name no Core body that waits
// for demand, which the recheck's Core demand seeds from them in a compile
// that lowers (and whose failure facts it solves again). The two checks must
// demand the same generated codecs and derived methods, whose bodies stand
// only on demand, and their owner bodies must name the same Core bodies that
// wait for demand (sema_local_splice_named_core), or the demand waves the
// finalization ran check other bodies than the full recheck's. Then every
// whole-program pass after the body pass (failure solve and recheck,
// effects, taint, Core usage, names) reads what it read in the finalization,
// so its rows stand, and the stamps it put on the owners carry over. When any
// of this fails, or a site is not a local value, the caller finalizes again.
//
// Run before the whole-program half of a finalization (sema_local_value_land),
// the splice lands a pass in the modules of its body half, and the
// whole-program half runs once, over every value. That half reads the pass's
// comptime functions itself and stamps every body, its effects solved from
// the spliced bodies included, so only the owner checks and their demand
// must hold there, against the unstamped bodies, which the pass's bodies
// replace as checked, and a landed initializer may be any call. A landing
// before the finalization's Core demand (SemaLocalSpliceInto.Undemanded)
// leaves that demand to run after it, seeded from every comptime function and
// reading the spliced bodies, as the full recheck's does, so the comptime
// functions and owner bodies may name any Core body that waits for demand.
// A landing after it (`Unstamped`, for the sites of the Core bodies the
// demand checked) must leave that demand as it is: the owner bodies must
// name the same Core bodies that wait for demand, and in a compile that
// lowers, a comptime function the pass adds must name none, since the full
// recheck's first demand wave checks what it names, where the landing's
// demand would check it after the waves the finalization ran, in another
// order.
use jet_foundation.[
    symbol_find,
    symbol_is_local,
    symbol_table_key,
    CompilerThreads,
    CompilerTraceSink,
    DIAGNOSTIC_ERROR,
    Diagnostic,
    FnBody,
    TargetHardwareUse,
    TTestFact,
    Type,
    compiler_take_rows,
]

// The rows of one module result that its function checks fill, moved out so
// a check can fill them afresh (sema_module_body_rows_take).
SemaModuleBodyRows: struct {
    functions: [FnBody]
    call_facts: [SemaCallSiteFact]
    hardware_use: TargetHardwareUse
    name_references: [SemaNameReferenceFact]
    comptime_requests: [SemaComptimeRequest]
    comptime_body_sources: [SemaComptimeBodySource]
    compute_facts: [SemaComputeFunctionFacts]
    exact_int_reachable: Bool
    copy_events: [SemaCopyEvent]
    diagnostics: [Diagnostic]
    complete: Bool
    failure_facts: [SemaFunctionFailureFacts]
    incomplete_reasons: [String]
    injected_function_keys: [String]
    tests: [TTestFact]
}

// Where sema_local_splice_owners lands the owner bodies: in a finalized
// result, whose bodies carry the whole-program passes' stamps; in the
// checked bodies of a finalization after its Core demand
// (sema_finalize_demand), whose whole-program half has not run and stamps
// them afresh; or in those of its body half (sema_finalize_bodies), before
// that demand too.
SemaLocalSpliceInto: enum {
    Finalized
    Unstamped
    Undemanded
}

// Whether the bodies a splice lands in (`into`) carry the whole-program
// stamps. Only then does an earlier owner body take them
// (sema_local_splice_settle) and a value refuse a call inside its
// initializer; unstamped bodies land as checked, with any initializer,
// since sema_finalize_program stamps them and solves the effects from them
// after the splice.
sema_local_splice_stamped: fn(into: SemaLocalSpliceInto) -> Bool Never! {
    if into == {
        .Finalized -> true
        .Unstamped | .Undemanded -> false
    }
}

// Whether the Core demand waves (sema_core_demand_waves) ran over the bodies
// a splice lands in (`into`). Only then must the splice leave the Core
// demand as the full recheck makes it; before them, the waves read the
// spliced bodies and seed from every comptime function, the full recheck's
// way.
sema_local_splice_demanded: fn(into: SemaLocalSpliceInto) -> Bool Never! {
    if into == {
        .Finalized | .Unstamped -> true
        .Undemanded -> false
    }
}

// The codec demand (graph.codec_demand) and the derive demand
// (graph.derive_demand) a run of checks records into.
SemaLocalSpliceDemand: struct {
    codecs: Shared<SemaCodecDemand>
    derived: Shared<SemaDeriveDemand>
}

sema_local_splice_demand_empty: fn() -> SemaLocalSpliceDemand Never! {
    SemaLocalSpliceDemand{codecs: Shared{SemaCodecDemand{keys: [String:Bool]{}, order: [String]{}}}, derived: Shared{SemaDeriveDemand{keys: [String:Bool]{}}}}
}

// A demand that starts as `graph`'s holds now and is recorded apart from
// it: what a finalization of `graph` starts from, for a later finalization
// to start from too (the driver's JET_RECHECK_VERIFY of landed values).
sema_local_splice_demand_snapshot: fn(graph: SemaRegistrationGraph) -> SemaLocalSpliceDemand {
    codecs: graph.codec_demand.guard_read()
    derived: graph.derive_demand.guard_read()
    SemaLocalSpliceDemand{codecs: Shared{SemaCodecDemand{keys: codecs.value.keys.copy(), order: codecs.value.order.copy()}}, derived: Shared{SemaDeriveDemand{keys: derived.value.keys.copy()}}}
}

// Makes `next` the demand the graph's checks record into and returns the
// one they recorded into before, so an owner check records all it demands,
// the demand the finalization already met included.
sema_local_splice_demand_swap: fn(graph: &SemaRegistrationGraph, next: &&SemaLocalSpliceDemand) -> SemaLocalSpliceDemand {
    incoming := next.move()
    held: SemaLocalSpliceDemand{codecs: graph.codec_demand, derived: graph.derive_demand}
    graph.codec_demand = incoming.codecs.move()
    graph.derive_demand = incoming.derived.move()
    held
}

// Whether two owner checks demanded the same codecs and derived methods.
sema_local_splice_same_demand: fn(before: SemaLocalSpliceDemand, after: SemaLocalSpliceDemand) -> Bool {
    before_codecs: before.codecs.guard_read()
    after_codecs: after.codecs.guard_read()
    if !sema_local_splice_same_keys(before_codecs.value.keys, after_codecs.value.keys) -> return false
    before_derived: before.derived.guard_read()
    after_derived: after.derived.guard_read()
    sema_local_splice_same_keys(before_derived.value.keys, after_derived.value.keys)
}

sema_local_splice_same_keys: fn(before: [String:Bool], after: [String:Bool]) -> Bool Never! {
    if before.len() != after.len() -> return false
    loop (key, _) in before {
        if after.get(key) == None -> return false
    }
    true
}

// Moves the function-check rows of `modules[index]` out, leaving them empty.
// The result and the ones after it move out of the list and back in, so no
// row is copied.
sema_module_body_rows_take: fn(modules: &[SemaGraphModuleResult], index: Int) -> SemaModuleBodyRows Never! {
    later := [SemaGraphModuleResult]{}
    loop modules.len() > index + 1 {
        moved := modules.pop() ?? break
        later.push(moved)
    }
    result := modules.pop() ?? panic("a local value splice lost its owner module")
    rows := SemaModuleBodyRows{
        functions: result.functions.move(),
        call_facts: result.call_facts.move(),
        hardware_use: result.hardware_use.move(),
        name_references: result.name_references.move(),
        comptime_requests: result.comptime_requests.move(),
        comptime_body_sources: result.comptime_body_sources.move(),
        compute_facts: result.compute_facts.move(),
        exact_int_reachable: result.exact_int_reachable,
        copy_events: result.copy_events.move(),
        diagnostics: result.diagnostics.move(),
        complete: result.complete,
        failure_facts: result.failure_facts.move(),
        incomplete_reasons: result.incomplete_reasons.move(),
        injected_function_keys: result.injected_function_keys.move(),
        tests: result.tests.move(),
    }
    result.functions = [FnBody]{}
    result.call_facts = [SemaCallSiteFact]{}
    result.hardware_use = sema_hardware_empty_use()
    result.name_references = [SemaNameReferenceFact]{}
    result.comptime_requests = [SemaComptimeRequest]{}
    result.comptime_body_sources = [SemaComptimeBodySource]{}
    result.compute_facts = [SemaComputeFunctionFacts]{}
    result.exact_int_reachable = false
    result.copy_events = [SemaCopyEvent]{}
    result.diagnostics = [Diagnostic]{}
    result.complete = true
    result.failure_facts = [SemaFunctionFailureFacts]{}
    result.incomplete_reasons = [String]{}
    result.injected_function_keys = [String]{}
    result.tests = [TTestFact]{}
    modules.push(result)
    loop later.len() > 0 {
        moved := later.pop() ?? break
        modules.push(moved)
    }
    rows
}

// Moves `rows` back into `modules[index]`, as sema_module_body_rows_take
// moved them out.
sema_module_body_rows_put: fn(modules: &[SemaGraphModuleResult], index: Int, rows: &&SemaModuleBodyRows) Never! {
    owned := rows.move()
    later := [SemaGraphModuleResult]{}
    loop modules.len() > index + 1 {
        moved := modules.pop() ?? break
        later.push(moved)
    }
    result := modules.pop() ?? panic("a local value splice lost its owner module")
    result.functions = owned.functions.move()
    result.call_facts = owned.call_facts.move()
    result.hardware_use = owned.hardware_use.move()
    result.name_references = owned.name_references.move()
    result.comptime_requests = owned.comptime_requests.move()
    result.comptime_body_sources = owned.comptime_body_sources.move()
    result.compute_facts = owned.compute_facts.move()
    result.exact_int_reachable = owned.exact_int_reachable
    result.copy_events = owned.copy_events.move()
    result.diagnostics = owned.diagnostics.move()
    result.complete = owned.complete
    result.failure_facts = owned.failure_facts.move()
    result.incomplete_reasons = owned.incomplete_reasons.move()
    result.injected_function_keys = owned.injected_function_keys.move()
    result.tests = owned.tests.move()
    modules.push(result)
    loop later.len() > 0 {
        moved := later.pop() ?? break
        modules.push(moved)
    }
}

// The first merged row the whole-program passes read that differs between
// `old` and `new`, named for the refusal's trace counter
// (sema_local_splice_refused), or None when they all agree: all but the
// bodies, the body comptime sites and the diagnostics, which
// sema_local_splice_holds compares itself. Rows compare by value, in
// place: formatting both sides of every owner module's rows to compare
// their texts cost seconds on the compiler's own pass.
sema_module_body_rows_difference: fn(old: SemaModuleBodyRows, new: SemaModuleBodyRows) -> String? Never! {
    if old.call_facts != new.call_facts -> return Val("rows_calls")
    if old.hardware_use != new.hardware_use -> return Val("rows_hardware")
    if old.name_references != new.name_references -> return Val("rows_names")
    if old.comptime_requests != new.comptime_requests -> return Val("rows_requests")
    if old.compute_facts != new.compute_facts -> return Val("rows_compute")
    if old.exact_int_reachable != new.exact_int_reachable -> return Val("rows_exact")
    if old.copy_events != new.copy_events -> return Val("rows_copies")
    if old.complete != new.complete -> return Val("rows_complete")
    if old.failure_facts != new.failure_facts -> return Val("rows_failures")
    if old.incomplete_reasons != new.incomplete_reasons -> return Val("rows_incomplete")
    if old.injected_function_keys != new.injected_function_keys -> return Val("rows_injected")
    if old.tests != new.tests -> return Val("rows_tests")
    None
}

// The texts of `diagnostics` (their Debug form), sorted.
sema_local_splice_diagnostic_texts: fn(diagnostics: [Diagnostic]) -> [String] Never! {
    texts := [String]{}
    loop diagnostic in diagnostics -> texts.push("{diagnostic:Debug}")
    texts.sort()
    texts
}

// Sorted `texts` less one of each text of sorted `taken`; None when `taken`
// holds a text more often than `texts` does.
sema_local_splice_texts_without: fn(texts: [String], taken: [String]) -> [String]? Never! {
    rest := [String]{}
    at := 0
    loop text in texts {
        if at < taken.len() && taken[at] < text -> return None
        if at < taken.len() && taken[at] == text {
            at += 1
            next
        }
        rest.push(text.copy())
    }
    if at < taken.len() -> return None
    Val(rest)
}

// Drops from `diagnostics` one diagnostic of each text of `dropped`
// (sema_local_splice_diagnostic_texts), keeping the order of the rest.
sema_local_splice_drop_diagnostics: fn(diagnostics: &[Diagnostic], dropped: [String]) Never! {
    if dropped.len() == 0 -> return
    taken := [Bool]{}
    loop _ in dropped -> taken.push(false)
    held := compiler_take_rows<Diagnostic>(diagnostics)
    loop diagnostic in held {
        text: "{diagnostic:Debug}"
        found := false
        loop at in 0..<dropped.len() {
            if !taken[at] && dropped[at] == text {
                taken[at] = true
                found = true
                break
            }
        }
        if !found -> diagnostics.push(diagnostic)
    }
}

// The position of the one function `key` in `functions`; None when there is
// none or more than one.
sema_local_splice_slot: fn(functions: [FnBody], key: String) -> Int? Never! {
    found := Int?{None}
    loop index in 0..<functions.len() {
        if functions[index].key != key -> next
        if found != None -> return None
        found = Val(index)
    }
    found
}

// sema_local_splice_slot for every key of `functions` at once: the position
// of the one function of each key, -1 for a key more than one function has.
sema_local_splice_slots: fn(functions: [FnBody]) -> [String:Int] Never! {
    slots := [String:Int]{}
    loop index in 0..<functions.len() {
        slots[functions[index].key] = if slots.get(functions[index].key) == None -> index else -> -1
    }
    slots
}

// Puts on a freshly checked `body` what the whole-program passes after the
// body pass put on its finalized check `finalized`: the projected `T Never!`
// carrier (sema_failure_reconcile_infallible), the solved effects and their
// scope frames (sema_effects_check_modules), the masked branches and the
// fixed tags (sema_mark_masked_branches), and the web bucket
// (sema_web_partition_check). The fresh body's types are its finalized
// check's, less those of the replaced initializers, so it carries a fixed tag
// only when the finalized body did.
sema_local_splice_settle: fn(body: &FnBody, finalized: FnBody) Never! {
    if finalized.ret == .Val(.Result(_, err)) {
        never: Type.Named{name: "Never"}
        if err == never && body.ret != finalized.ret -> sema_failure_reconcile_function(body)
    }
    body.effects = finalized.effects.copy()
    body.effect_scope = finalized.effect_scope.copy()
    body.masked = finalized.masked.copy()
    body.web_bucket = finalized.web_bucket
    body.web_reason = finalized.web_reason.copy()
    if finalized.fixed_tags.len() > 0 && sema_fixed_types(body.tree.types.types, finalized.fixed_tags) -> body.fixed_tags = finalized.fixed_tags.copy()
}

// Drops the landed sources from `sources` (`landed` holds their
// `module\nkey`).
sema_local_splice_unlanded: fn(sources: &[SemaComptimeBodySource], landed: [String:Bool]) Never! {
    held := compiler_take_rows<SemaComptimeBodySource>(sources)
    held.reverse()
    loop held.len() > 0 {
        source := held.pop() ?? break
        if landed.get("{source.module_identity.id}\n{source.key}") == None -> sources.push(source.move())
    }
}

// The sites of `landed` (`module\nkey`) that leave the source rows of the
// pass's check of the owner modules (`after`): the ones that got values.
sema_local_splice_valued: fn(landed: [String:Bool], after: [SemaModuleBodyRows]) -> [String:Bool] Never! {
    remaining := [String:Bool]{}
    loop rows in after {
        loop source in rows.comptime_body_sources -> remaining["{source.module_identity.id}\n{source.key}"] = true
    }
    valued := [String:Bool]{}
    loop (site, _) in landed {
        if remaining.get(site) == None -> valued[site.copy()] = true
    }
    valued
}

// Why the two checks of the owner modules (`earlier` against the finalized
// values, which it takes, and `after` against the pass's) keep the splice
// from standing, as the file comment says, or None when it stands.
// `owners` holds the owner function keys, `landed` the `module\nkey` of each
// landed site that got a value, and `computed` those of them whose value is
// not a failure; `into` says whether `modules` carries the whole-program
// stamps, which an earlier owner body must be given before it equals its
// body there. `replayed` holds the texts of the diagnostics the pass's
// comptime results bring (sema_local_splice_diagnostic_texts): a diagnostic
// only the first check reports must be one of them, and of its owner
// module's; `dropped` gets, per owner module, those its rows drop.
sema_local_splice_holds: fn(modules: [SemaGraphModuleResult], owner_modules: [Int], owners: [String:Bool], landed: [String:Bool], computed: [String:Bool], replayed: [String], earlier: &&[SemaModuleBodyRows], after: [SemaModuleBodyRows], into: SemaLocalSpliceInto, dropped: &[[String]]) -> String? Never! {
    stamped: sema_local_splice_stamped(into)
    before := earlier.move()
    unclaimed := replayed.copy()
    settled_owners := 0
    position := owner_modules.len()
    loop before.len() > 0 {
        position -= 1
        old := before.pop() ?? break
        new: after[position]
        module_index: owner_modules[position]
        if sema_module_body_rows_difference(old, new) == .Val(difference) -> return Val(difference)
        if old.diagnostics != new.diagnostics {
            // `diagnostics_added`: the second check reports one the first
            // does not; `diagnostics_unclaimed`: the first reports one no
            // comptime result brings; `diagnostics_module`: one the owner
            // module's rows do not hold.
            extra: sema_local_splice_texts_without(sema_local_splice_diagnostic_texts(old.diagnostics), sema_local_splice_diagnostic_texts(new.diagnostics)) ?? return Val("diagnostics_added")
            unclaimed = sema_local_splice_texts_without(unclaimed, extra) ?? return Val("diagnostics_unclaimed")
            if sema_local_splice_texts_without(sema_local_splice_diagnostic_texts(modules[module_index].diagnostics), extra) == None -> return Val("diagnostics_module")
            dropped[position] = extra
        }
        // A value keeps only the effects of the call at its own span. A
        // failure keeps the initializer as run-time code, calls and all.
        if stamped && sema_local_splice_inner_call(old, computed) -> return Val("inner_call")
        sema_local_splice_unlanded(old.comptime_body_sources, landed)
        if old.comptime_body_sources != new.comptime_body_sources -> return Val("sources")
        if old.functions.len() != new.functions.len() -> return Val("bodies")
        checked := old.functions.move()
        slots: sema_local_splice_slots(modules[module_index].functions)
        index := checked.len()
        loop checked.len() > 0 {
            index -= 1
            function := checked.pop() ?? break
            if new.functions[index].key != function.key -> return Val("bodies")
            if owners.get(function.key) == None {
                if function != new.functions[index] -> return Val("bodies")
                next
            }
            slot: slots.get(function.key) ?? -1
            if slot < 0 -> return Val("bodies")
            if stamped -> sema_local_splice_settle(function, modules[module_index].functions[slot])
            if function != modules[module_index].functions[slot] -> return Val("finalized_bodies")
            settled_owners += 1
        }
    }
    if settled_owners != owners.len() -> return Val("owners")
    None
}

// The sites of `landed` (`module\nkey`) whose value in `values` is not a
// failure (sema_comptime_local_value_reason): the ones whose value replaces
// the initializer.
sema_local_splice_computed: fn(landed: [String:Bool], values: [SemaComptimeItemValue]) -> [String:Bool] Never! {
    computed := [String:Bool]{}
    loop value in values {
        site: "{value.module_identity.id}\n{value.key}"
        if landed.get(site) != None && sema_comptime_local_value_reason(value.value) == None -> computed[site] = true
    }
    computed
}

// Whether a site of `rows` in `sites` (`module\nkey`) holds a call fact of
// its owner whose span is strictly inside the site's.
sema_local_splice_inner_call: fn(rows: SemaModuleBodyRows, sites: [String:Bool]) -> Bool Never! {
    loop source in rows.comptime_body_sources {
        if sites.get("{source.module_identity.id}\n{source.key}") == None -> next
        loop fact in rows.call_facts {
            if fact.caller_key != source.function_key -> next
            if fact.span.start < source.span.start || fact.span.end > source.span.end -> next
            if fact.span.start != source.span.start || fact.span.end != source.span.end -> return true
        }
    }
    false
}

// Whether the pass's comptime functions name a Core body that waits for
// demand (graph.core_demand_rows), checked or not, but for those whose
// `module\nkey` is in `known`. A compile that lowers seeds its Core demand
// with what they name (sema_core_demand_waves), so the full recheck checks
// it as their demand and solves its failure facts again, which may restamp
// it and the bodies that call it; any compile refuses the splice then.
sema_local_splice_demands_core: fn(graph: SemaRegistrationGraph, functions: [SemaComptimeFunctionResult], known: [String:Int]) -> Bool Never! {
    if graph.core_demand_rows.len() == 0 -> return false
    keys := [String]{}
    loop result in functions {
        if known.get("{result.module_identity.id}\n{result.function_key}") != None -> next
        if result.function == .Val(function) -> sema_core_demand_body_keys(function, graph.decls, graph.symbols, keys)
        loop fact in result.call_facts {
            if fact.callee == .Val(callee) -> sema_core_demand_symbol_key(graph.symbols, callee, keys)
        }
    }
    loop key in keys {
        if graph.core_demand_rows.get(key) != None || graph.core_demand_rows.get(sema_core_demand_template_key(key)) != None -> return true
    }
    false
}

// The Core bodies that wait for demand (graph.core_demand_rows) the owner
// bodies of `rows` name (sema_core_demand_body_keys), each key as
// sema_core_demand_key looks it up, itself and its template, but for those
// whose template a call fact of `rows` names: the two checks record the
// same call facts, and the demand waves read them alike. A value replaces
// its initializer, so its owner body no longer names what the initializer
// named outside its calls, such as the template items of a call at type
// arguments.
sema_local_splice_named_core: fn(graph: SemaRegistrationGraph, rows: [SemaModuleBodyRows], owners: [String:Bool]) -> [String:Bool] Never! {
    named := [String:Bool]{}
    if graph.core_demand_rows.len() == 0 -> return named
    keys := [String]{}
    called := [String:Bool]{}
    loop module_rows in rows {
        loop function in module_rows.functions {
            if owners.get(function.key) != None -> sema_core_demand_body_keys(function, graph.decls, graph.symbols, keys)
        }
        loop fact in module_rows.call_facts {
            if fact.callee == .Val(callee) && !symbol_is_local(callee) -> called[sema_core_demand_template_key(symbol_table_key(graph.symbols, callee))] = true
        }
    }
    loop keys.len() > 0 {
        key := keys.pop() ?? break
        template := sema_core_demand_template_key(key)
        if called.get(template) != None -> next
        if graph.core_demand_rows.get(key) != None -> named[key.move()] = true
        if graph.core_demand_rows.get(template) != None -> named[template.move()] = true
    }
    named
}

// What a local value splice hands back: the graph, whether the pass's values
// landed, and the `module\nkey` of each landed site that got a value.
SemaLocalValueSplice: struct {
    graph: SemaRegistrationGraph
    spliced: Bool
    valued: [String:Bool]
}

// The `module\nkey` of every site of `landed`; None when one is not a local
// value.
sema_local_splice_landed_keys: fn(landed: [SemaComptimeItemSource]) -> [String:Bool]? Never! {
    keys := [String:Bool]{}
    loop source in landed {
        if !source.local_value -> return None
        keys["{source.module_identity.id}\n{source.key}"] = true
    }
    Val(keys)
}

// Whether a value of `values` at a site of `landed` (by `module\nkey`) holds
// a compiler value (sema_compiler_host_value_held). The compiler that made
// it answers it, and a landed value would leave that compiler behind, so
// its pass finalizes again.
sema_local_splice_holds_host_value: fn(values: [SemaComptimeItemValue], landed: [String:Bool]) -> Bool Never! {
    loop value in values {
        if landed.get("{value.module_identity.id}\n{value.key}") != None && sema_compiler_host_value_held(value.ty) != None -> return true
    }
    false
}

// Lands the pass's local values in `finalized`, the result of
// `sema_finalize_graph` over `earlier_values` and `earlier_functions`, when
// the file comment's conditions hold. The graph moves in and comes back with
// its edits on `trail`, as sema_finalize_graph's do. `landed` are the pass's
// sites; `values` and `comptime_functions` the pass's results.
sema_local_value_splice: fn(
    resolved: &&SemaRegistrationGraph,
    trail: &SemaGraphTrail,
    finalized: &SemaGraphResult,
    landed: [SemaComptimeItemSource],
    earlier_values: [SemaComptimeItemValue],
    earlier_functions: [SemaComptimeFunctionResult],
    values: [SemaComptimeItemValue],
    comptime_functions: [SemaComptimeFunctionResult],
    host_hooks: Shared<SemaRegistrationHostHooks>,
    threads: CompilerThreads,
    trace_sink: CompilerTraceSink?,
) -> SemaLocalValueSplice {
    graph := resolved.move()
    if !finalized.complete || landed.len() == 0 -> return SemaLocalValueSplice{graph: graph.move(), spliced: false, valued: [String:Bool]{}}
    landed_keys := sema_local_splice_landed_keys(landed) ?? return SemaLocalValueSplice{graph: graph.move(), spliced: false, valued: [String:Bool]{}}
    // The comptime function results bring the finalization's diagnostics. A
    // lint on Core source only rides the list until sema_finalize_graph
    // drops it, so the functions a pass adds may bring those.
    earlier_diagnostics := [Diagnostic]{}
    earlier_complete: sema_comptime_function_diagnostics(earlier_functions, earlier_diagnostics)
    pass_diagnostics := [Diagnostic]{}
    pass_complete: sema_comptime_function_diagnostics(comptime_functions, pass_diagnostics)
    if earlier_complete != pass_complete || sema_local_splice_kept_diagnostics(earlier_diagnostics) != sema_local_splice_kept_diagnostics(pass_diagnostics) -> return SemaLocalValueSplice{graph: graph.move(), spliced: false, valued: [String:Bool]{}}
    if sema_local_splice_demands_core(graph, comptime_functions, [String:Int]{}) || sema_local_splice_holds_host_value(values, landed_keys) -> return SemaLocalValueSplice{graph: graph.move(), spliced: false, valued: [String:Bool]{}}
    splice := sema_local_splice_owners(graph, trail, finalized.modules, landed_keys, SemaLocalSpliceInto.Finalized, earlier_values, earlier_functions, values, comptime_functions, host_hooks, threads, trace_sink)
    if splice.spliced -> sema_local_splice_unlanded(finalized.comptime_body_sources, splice.valued)
    splice
}

// Whether `diagnostics` hold an error that keeps a body comptime pass from
// landing before the whole-program half of a finalization: any error but a
// failure-domain obligation (sema_failure_defer_obligation), which waits on
// that half's failure solve to be discharged or emitted either way.
sema_local_values_blocked: fn(diagnostics: [Diagnostic]) -> Bool Never! {
    mark: sema_failure_obligation_mark()
    loop diagnostic in diagnostics {
        if diagnostic.severity == DIAGNOSTIC_ERROR && !(diagnostic.detail ?? "").starts_with(mark) -> return true
    }
    false
}

// Lands the pass's local values in `modules`, the checked bodies of a
// finalization over `earlier_values` and `earlier_functions` after its body
// half (sema_finalize_bodies), and after its Core demand
// (sema_finalize_demand) as well unless `into` is `Undemanded`, before its
// whole-program half (sema_finalize_program) runs once over them with
// `values` and `comptime_functions`. That half reads the pass's comptime
// functions itself, their diagnostics included, and it puts its stamps on
// every body, so of the file comment's conditions only the owner checks'
// and their demand must hold, against the unstamped bodies; after the Core
// demand, in a compile that lowers, the comptime functions the pass adds
// must name no Core body that waits for demand. The graph moves in and comes
// back with its edits on `trail`; `landed` are the pass's sites.
sema_local_value_land: fn(
    resolved: &&SemaRegistrationGraph,
    trail: &SemaGraphTrail,
    modules: &[SemaGraphModuleResult],
    into: SemaLocalSpliceInto,
    landed: [SemaComptimeItemSource],
    earlier_values: [SemaComptimeItemValue],
    earlier_functions: [SemaComptimeFunctionResult],
    values: [SemaComptimeItemValue],
    comptime_functions: [SemaComptimeFunctionResult],
    host_hooks: Shared<SemaRegistrationHostHooks>,
    threads: CompilerThreads,
    trace_sink: CompilerTraceSink?,
) -> SemaLocalValueSplice {
    graph := resolved.move()
    if landed.len() == 0 -> return SemaLocalValueSplice{graph: graph.move(), spliced: false, valued: [String:Bool]{}}
    landed_keys := sema_local_splice_landed_keys(landed) ?? return SemaLocalValueSplice{graph: graph.move(), spliced: false, valued: [String:Bool]{}}
    if sema_local_splice_holds_host_value(values, landed_keys) {
        sema_local_splice_refused(trace_sink, "host_value", landed_keys.len())
        return SemaLocalValueSplice{graph: graph.move(), spliced: false, valued: [String:Bool]{}}
    }
    if sema_local_splice_demanded(into) && graph.core_lowering_roots != None && sema_local_splice_demands_core(graph, comptime_functions, sema_comptime_checked_function_rows(earlier_functions)) {
        sema_local_splice_refused(trace_sink, "core_demand", landed_keys.len())
        return SemaLocalValueSplice{graph: graph.move(), spliced: false, valued: [String:Bool]{}}
    }
    sema_local_splice_owners(graph, trail, modules, landed_keys, into, earlier_values, earlier_functions, values, comptime_functions, host_hooks, threads, trace_sink)
}

// Checks the owner functions of the landed sites (`landed`, by
// `module\nkey`) in `modules` twice, with the earlier values and with the
// pass's, and splices the second check's bodies into `modules` when
// sema_local_splice_holds lets them stand there (`into`). The graph moves in
// and comes back with its edits on `trail`.
sema_local_splice_owners: fn(
    resolved: &&SemaRegistrationGraph,
    trail: &SemaGraphTrail,
    modules: &[SemaGraphModuleResult],
    landed: [String:Bool],
    into: SemaLocalSpliceInto,
    earlier_values: [SemaComptimeItemValue],
    earlier_functions: [SemaComptimeFunctionResult],
    values: [SemaComptimeItemValue],
    comptime_functions: [SemaComptimeFunctionResult],
    host_hooks: Shared<SemaRegistrationHostHooks>,
    threads: CompilerThreads,
    trace_sink: CompilerTraceSink?,
) -> SemaLocalValueSplice {
    graph := resolved.move()
    owners := [String:Bool]{}
    owner_modules := [Int]{}
    found := [String:Bool]{}
    loop module_index in 0..<modules.len() {
        loop source in modules[module_index].comptime_body_sources {
            site: "{source.module_identity.id}\n{source.key}"
            if landed.get(site) == None -> next
            if source.function_key == "" -> return SemaLocalValueSplice{graph: graph.move(), spliced: false, valued: [String:Bool]{}}
            found[site] = true
            owners[source.function_key] = true
            if !owner_modules.contains(module_index) -> owner_modules.push(module_index)
        }
    }
    if found.len() != landed.len() -> return SemaLocalValueSplice{graph: graph.move(), spliced: false, valued: [String:Bool]{}}
    // A function the pass checked to run while compiling is not checked as a
    // body again: the body pass takes the pass's result for it
    // (sema_comptime_find_checked_function), with its facts, pending
    // obligations and demand (SemaDemandCapture), as the full recheck does.
    // Each such function the earlier checks took as a body is an owner too,
    // so both checks hold it, a generated codec or derived method as any
    // other: the owner checks name it as their wave, and the demand its
    // result replays is the one its body check records.
    earlier_rows: sema_comptime_checked_function_rows(earlier_functions)
    loop result in comptime_functions {
        if earlier_rows.get("{result.module_identity.id}\n{result.function_key}") != None || owners.get(result.function_key) != None -> next
        loop module_index in 0..<modules.len() {
            if modules[module_index].module_identity != result.module_identity -> next
            if sema_local_splice_slot(modules[module_index].functions, result.function_key) == None -> next

            owners[result.function_key] = true
            if !owner_modules.contains(module_index) -> owner_modules.push(module_index)
        }
    }
    owner_modules.sort()
    // As sema_finalize_graph: no lookup counting across the body threads.
    trail.entries.push(SemaGraphUndo.Counting{old: graph.counting})
    graph.counting = false
    // The owners are the wave both checks check; they come back after it.
    graph.core_wave_rows = owners.move()
    hook_access: sema_host_hook_access(host_hooks)
    checked_types: sema_stage_checked_types(modules)
    held := [SemaModuleBodyRows]{}
    loop module_index in owner_modules -> held.push(sema_module_body_rows_take(modules, module_index))
    // Each check records the codecs and derived methods it demands afresh:
    // a generated body stands only on demand, so the two checks must demand
    // the same ones, or the full recheck generates other bodies than the
    // finalization did (the earlier check's demand includes what an owner
    // the pass's result replaces demanded as a body).
    earlier_start := sema_local_splice_demand_empty()
    finalized_demand := sema_local_splice_demand_swap(graph, earlier_start)
    earlier_facts := [SemaPassFacts]{}
    earlier_graph := sema_finalize_check_modules(graph, earlier_values, earlier_functions, checked_types, owner_modules, true, hook_access, threads, None, "sema.local_values", trace_sink, earlier_facts, modules)
    graph = earlier_graph.move()
    before := [SemaModuleBodyRows]{}
    loop module_index in owner_modules -> before.push(sema_module_body_rows_take(modules, module_index))
    pass_start := sema_local_splice_demand_empty()
    earlier_demand: sema_local_splice_demand_swap(graph, pass_start)
    pass_facts := [SemaPassFacts]{}
    pass_graph := sema_finalize_check_modules(graph, values, comptime_functions, checked_types, owner_modules, true, hook_access, threads, None, "sema.local_values", trace_sink, pass_facts, modules)
    graph = pass_graph.move()
    pass_demand: sema_local_splice_demand_swap(graph, finalized_demand)
    after := [SemaModuleBodyRows]{}
    loop module_index in owner_modules -> after.push(sema_module_body_rows_take(modules, module_index))
    if trace_sink == .Val(sink) -> sink.begin("sema.local_values.compare", "", -1, -1)
    owners = graph.core_wave_rows.move()
    graph.core_wave_rows = [String:Bool]{}
    row := owner_modules.len()
    loop held.len() > 0 {
        row -= 1
        rows := held.pop() ?? break
        sema_module_body_rows_put(modules, owner_modules[row], rows)
    }
    // A landed local whose outcome is a run-time reason stays run-time code,
    // so it is still a site of the pass's check, as of the full recheck's;
    // only the sites that got values leave the source rows.
    valued := sema_local_splice_valued(landed, after)
    computed: sema_local_splice_computed(valued, values)
    // Before the Core demand, the demand waves read the spliced bodies.
    same_named: !sema_local_splice_demanded(into) || sema_local_splice_same_keys(sema_local_splice_named_core(graph, before, owners), sema_local_splice_named_core(graph, after, owners))
    same_demand: sema_local_splice_same_demand(earlier_demand, pass_demand)
    // The diagnostics the whole-program half reports from the pass's
    // comptime results.
    replayed_diagnostics := [Diagnostic]{}
    _: sema_comptime_function_diagnostics(comptime_functions, replayed_diagnostics)
    dropped := [[String]]{}
    loop _ in owner_modules -> dropped.push([String]{})
    refusal: if {
        !same_named -> Val("named_core")
        !same_demand -> Val("demand")
        else -> sema_local_splice_holds(modules, owner_modules, owners, valued, computed, sema_local_splice_diagnostic_texts(replayed_diagnostics), before, after, into, dropped)
    }
    if trace_sink == .Val(sink) -> sink.end("sema.local_values.compare", owners.len())
    if refusal == .Val(reason) {
        sema_local_splice_refused(trace_sink, reason, owners.len())
        return SemaLocalValueSplice{graph: graph.move(), spliced: false, valued: [String:Bool]{}}
    }
    if trace_sink == .Val(sink) -> sink.progress("counters.sema.local_values_spliced", owners.len(), -1)
    if trace_sink == .Val(sink) -> sink.begin("sema.local_values.splice", "", -1, -1)
    stamped: sema_local_splice_stamped(into)
    row = owner_modules.len()
    loop after.len() > 0 {
        row -= 1
        rows := after.pop() ?? break
        module_index: owner_modules[row]
        checked := rows.functions.move()
        slots: sema_local_splice_slots(modules[module_index].functions)
        loop checked.len() > 0 {
            function := checked.pop() ?? break
            if owners.get(function.key) == None -> next
            slot: slots.get(function.key) ?? -1
            if slot < 0 -> panic("a spliced local value lost its owner function")
            if stamped -> sema_local_splice_settle(function, modules[module_index].functions[slot])
            modules[module_index].functions[slot] = function.move()
        }
        sema_local_splice_drop_diagnostics(modules[module_index].diagnostics, dropped[row])
        sema_local_splice_unlanded(modules[module_index].comptime_body_sources, valued)
    }
    if trace_sink == .Val(sink) -> sink.end("sema.local_values.splice", owners.len())
    SemaLocalValueSplice{graph: graph.move(), spliced: true, valued: valued.move()}
}

// `diagnostics` but for its lints on Core source, which sema_finalize_graph
// drops, as one string to compare.
sema_local_splice_kept_diagnostics: fn(diagnostics: [Diagnostic]) -> String Never! {
    kept := [String]{}
    loop diagnostic in diagnostics {
        if !sema_core_source_lint(diagnostic) -> kept.push("{diagnostic:Debug}")
    }
    kept.join("\n")
}

// Traces a refused splice: `local_values_refused` and the reason's own
// counter (`local_values_refused_<reason>`), each by `count`, the owner
// functions or, before they are known, the landed sites.
sema_local_splice_refused: fn(trace_sink: CompilerTraceSink?, reason: String, count: Int) Never! {
    sink := trace_sink ?? return
    sink.progress("counters.sema.local_values_refused", count, -1)
    sink.progress("counters.sema.local_values_refused_{reason}", count, -1)
}
