//RS /// Check the compiler-host build entry with the read-only compiler API enabled.
//RS ///
//RS /// This is a separate authority from ordinary runtime/check sema. The caller
//RS /// must have selected the package/workspace `fn build`; the checker still
//RS /// limits the exception to that entry function in the entry module.
//RS pub fn check_bundle_with_effect_facts_for_build(
//RS     bundle: &mut ProgramBundle,
