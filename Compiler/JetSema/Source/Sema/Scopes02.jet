// Rust: crates/jet-sema/src/Sema/Bundle.rs:2063
const BUILD_ENTRY_FN: String = "build"
// Rust: crates/jet-sema/src/Sema/Bundle.rs:2077
pub fn is_build_entry(func: Func) -> Bool Never! {
    func.name == BUILD_ENTRY_FN && func.params.len() == 1 && func.params[0].ty == Type.Named(TYPE_BUILD_CONTEXT)
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:2090
pub fn build_entry_signature_is_valid(func: Func) -> Bool Never! {
    if !is_build_entry(func) -> return false
    if func.return_type == .Val(.Named(name)) -> return name == TYPE_BUILD_PLAN
    if func.return_type == .Val(.Result(ok, err)) {
        if ok != Type.Named(TYPE_BUILD_PLAN) -> return false
        if err == .Named(name) && name == TYPE_ERR -> return false
        return true
    }
    false
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:2121
pub fn strip_build_only_entries(bundle: &ProgramBundle) Never! {
    loop &module in &bundle.modules {
        &module.items.retain(fn(item: Item) -> Bool Never! {
            if item == .Func(func) -> return !is_build_entry(func)
            if item == .ErrorConv(conversion) -> return conversion.from_ty != "BuildError" && conversion.to_ty != "BuildError"
            true
        })
    }
}
