use jet_foundation.[ProgramBundle, Item, ImportKind, NameLedger, NameVisibility, package_scope_for, Diagnostic, Span, Func, Type, CompileMode, GateSet, TYPE_BUILD_CONTEXT, TYPE_BUILD_PLAN, TYPE_ERR, target_profile_path, core_list_prefix]
use jet_sema.[ModuleState, IncrementalSemaCache, SemIndexEffectFacts, declare_item_names, pipeline_check_bundle_opts_for_output, pipeline_check_bundle_opts_for_output_with_context]
use jet_sema.Bundle.GenericModules.[instance_display_paths, top_level_instance_display_paths, plain_inline_module_display_paths]

// Rust: crates/jet-sema/src/Sema/Bundle.rs:1768
fn populate_name_ledger(bundle: ProgramBundle, states: [ModuleState], ledger: &NameLedger) Never! {
    loop module_idx in 0..<bundle.modules.len() {
        module :: bundle.modules[module_idx]
        package :: package_scope_for(module.path, bundle.project_root)
        &ledger.set_module(module_idx, ~module.alias, ~module.display, package)
    }
    loop module_idx in 0..<bundle.modules.len() {
        module :: bundle.modules[module_idx]
        state :: states[module_idx]
        loop item in module.items {
            declare_item_names(&ledger, module_idx, module.alias, item)
            if item == .CodeModule(instance) {
                if instance.instance_identity != None {
                    loop (internal, display) in instance_display_paths(instance) -> &ledger.record_display_path(module_idx, "{module.alias}.{internal}", display)
                    loop (internal, display) in top_level_instance_display_paths(instance, module.items) -> &ledger.record_display_path(module_idx, "{module.alias}.{internal}", display)
                }
                // Lifted plain-inline member types retain their source display paths.
                if instance.instance_identity == None && instance.body != None {
                    loop (internal, display) in plain_inline_module_display_paths(instance, module.items) -> &ledger.record_display_path(module_idx, "{module.alias}.{internal}", display)
                }
            }
        }
        loop import in module.imports {
            import_alias :: import.import_alias()
            alias_visibility :: NameVisibility.from_flags(import.is_pub, import.is_package_pub)
            import_target := ""
            target_module := None as Int?
            if ledger.import_target(module_idx, import.span) == .Val(target) {
                import_target = ~bundle.modules[target].alias
                target_module = Val(target)
            } else if target_profile_path(import) == .Val(profile) {
                import_target = ^profile
            } else if import.core_module_path() == .Val(core_path) {
                import_target = ^core_path
            } else if import.kind == .File(path, _) {
                import_target = ~path
            } else if import.kind == .Module(path, _) {
                import_target = ~path
            } else if import.kind == .Unqualified(module_alias, _) {
                import_target = ~module_alias
            }
            namespace_bound_elsewhere := false
            if import.kind == .Unqualified(_, _) {
                loop other in module.imports {
                    namespace_import := false
                    if other.kind == .File(_, _) -> namespace_import = true
                    if other.kind == .Module(_, _) -> namespace_import = true
                    if namespace_import && other.import_alias() == import_alias {
                        namespace_bound_elsewhere = true
                        break
                    }
                }
            }
            if !namespace_bound_elsewhere -> &ledger.record_alias(module_idx, import_alias, import_target, target_module, import.alias_span, alias_visibility)
            loop binding in import.walk_bindings() {
                if binding.original == .Val(original) {
                    local :: binding.local
                    target := None as (String, Int?)?
                    if core_list_prefix(binding.module_alias) == .Val(core_prefix) {
                        target = Val(("{core_prefix}.{original}", None))
                    } else if state.imports.get(local) == .Val(owner) {
                        target = Val((~bundle.modules[owner].alias, Val(owner)))
                    } else if state.unqualified_file.get(local) == .Val((real, owner)) {
                        target = Val(("{bundle.modules[owner].alias}.{real}", Val(owner)))
                    } else if state.unqualified.get(local) == .Val(resolved) {
                        target = Val((~resolved, Val(module_idx)))
                    } else if state.imports.get(binding.module_alias) == .Val(owner_module) {
                        // The dependency namespace may bind through any member file.
                        owner := owner_module
                        if !module_declares(bundle.modules[owner].items, original) {
                            loop candidate in ledger.namespace_siblings(owner_module) {
                                if module_declares(bundle.modules[candidate].items, original) {
                                    owner = candidate
                                    break
                                }
                            }
                        }
                        target = Val(("{bundle.modules[owner].alias}.{original}", Val(owner)))
                    }
                    if target == .Val((path, owner)) -> &ledger.record_alias(module_idx, ~local, path, owner, binding.local_span, alias_visibility)
                }
            }
        }
    }
}

// Rust: crates/jet-sema/src/Sema/Bundle.rs:1914
fn module_declares(items: [Item], name: String) -> Bool Never! {
    loop item in items {
        if item == .Func(d) && d.name == name -> return true
        if item == .Struct(d) && d.name == name -> return true
        if item == .Enum(d) && d.name == name -> return true
        if item == .Distinct(d) && d.name == name -> return true
        if item == .TypeAlias(d) && d.name == name -> return true
        if item == .Trait(d) && d.name == name -> return true
        if item == .Tag(d) && d.name == name -> return true
        if item == .Const(d) && d.name == name -> return true
        if item == .ProtocolDecl(d) && d.name == name -> return true
        if item == .UnitFamily(family) {
            loop member in family.distinct_defs() -> if member.name == name -> return true
        }
    }
    false
}

// Rust: crates/jet-sema/src/Sema/Bundle.rs:1933
pub fn check_bundle(bundle: &ProgramBundle, mode: CompileMode) -> [Diagnostic] Never! {
    pipeline_check_bundle_opts_for_output(&bundle, mode, false, GateSet.default(), None, None).0
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1945
fn validate_script_entries(bundle: &ProgramBundle) -> [Diagnostic] Never! {
    diags := [Diagnostic]{}
    validate_script_entry_bodies(&bundle, &diags)
    diags
}
// Rust: crates/jet-sema/src/Sema/Bundle.rs:1954
fn validate_script_entry_bodies(bundle: &ProgramBundle, diags: &[Diagnostic]) Never! {
    loop module_idx in 0..<bundle.modules.len() {
        body :: ^bundle.modules[module_idx].script_body
        bundle.modules[module_idx].script_body = []
        if body.is_empty() -> continue
        script_span :: Span.new(body[0].span().start, body[body.len() - 1].span().end)
        if module_idx != bundle.entry {
            &diags.push(Diagnostic.error("E0620", "imported script `{bundle.modules[module_idx].display}` has executable top-level statements", "imported files provide declarations; executable code belongs in an explicit `fn run`", "move the statements into the entry file's `fn run`, or import a declaration-only file", Val(script_span)))
        } else {
            &diags.push(Diagnostic.error("E0621", "top-level executable statements require an explicit `fn run`", "Jet does not invent a runtime function for ordinary files; only `fn run` executes code", "move the statements into `fn run`", Val(script_span)))
        }
    }
}
