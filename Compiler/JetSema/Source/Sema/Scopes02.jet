//RS 
//RS /// D-BUILDENTRY1: the selected root build entry's function name. Compiler-known
//RS /// only while the build session runs; never part of the runtime program.
//RS const BUILD_ENTRY_FN: &str = "build";
//RS 
//RS /// D-BUILDENTRY1: is this function the programmable-build root entry?
//RS ///
//RS /// Identity is the name plus the one `BuildContext` parameter. `BuildContext`
//RS /// is a compiler value with no runtime representation, so a function that takes
//RS /// one is build-only whatever else its signature says — including a malformed
//RS /// one, which must still be kept out of runtime codegen while `E3501` explains
//RS /// it. The return clause is graded separately by
//RS /// [`build_entry_signature_is_valid`].
//RS ///
//RS /// The name alone is not enough: an ordinary `fn build(count: Int) -> Int ->` is a
//RS /// normal runtime function, and dropping it would emit calls to a name that has
//RS /// no definition.
//RS pub fn is_build_entry(func: &Func) -> bool {
//RS     func.name == BUILD_ENTRY_FN
//RS         && func.params.len() == 1
//RS         && func.params[0].ty == Type::Named(Syntax::TYPE_BUILD_CONTEXT.to_string())
//RS }
//RS 
//RS /// D-BUILDENTRY1: does the build entry carry its one typed success contract,
//RS /// `fn build(b: BuildContext) BuildPlan`? A bare return type uses the ordinary
//RS /// implicit `!Err` failure route; an explicit result remains available only when
//RS /// it names a non-default expert error domain. The retired `BuildPlan!` spelling
//RS /// therefore stays invalid and reaches `E3501`. Build authority and graph
//RS /// handoff are one contract, so a build entry with any other success type is
//RS /// selected, rejected, and never emitted.
//RS pub fn build_entry_signature_is_valid(func: &Func) -> bool {
//RS     is_build_entry(func)
//RS         && match func.return_type.as_ref() {
//RS             Some(Type::Named(name)) => name == Syntax::TYPE_BUILD_PLAN,
//RS             Some(Type::Result { ok, err }) => {
//RS                 **ok == Type::Named(Syntax::TYPE_BUILD_PLAN.to_string())
//RS                     && !matches!(
//RS                         err.as_ref(),
//RS                         Type::Named(name) if name == Syntax::TYPE_ERR
//RS                     )
//RS             }
//RS             _ => false,
//RS         }
//RS }
//RS 
//RS /// D-BUILDENTRY1 / I2 / I3 / I9: project a checked bundle down to the program
//RS /// the user actually runs by removing every build-only entry.
//RS ///
//RS /// `fn build` is compiler-host code. It is type-checked like any other
//RS /// function, and `jet build` evaluates it in the comptime build interpreter,
//RS /// but it is not runtime code: its `BuildContext` parameter and `BuildPlan`
//RS /// result are compiler values with no runtime representation. A build entry
//RS /// left in the program therefore reaches `Codegen::emit_func`, fails the typed
//RS /// IR coverage gate, and raises an internal compiler error — a compiler bug by
//RS /// I2, and by I3 a decision the front end owes codegen rather than one codegen
//RS /// discovers (Tower card 2008).
//RS ///
//RS /// The removal belongs to the front end, so it happens exactly once for every
//RS /// consumer: AOT emit, the Cranelift JIT, and the interpreter all receive the
//RS /// same runtime program instead of each engine having to know that one function
//RS /// or build-only error conversion is not theirs (I9).
//RS pub fn strip_build_only_entries(bundle: &mut ProgramBundle) {
//RS     for module in &mut bundle.modules {
//RS         module.items.retain(|item| match item {
//RS             Item::Func(func) => !is_build_entry(func),
//RS             // `BuildError` exists only in the compiler-host build interpreter.
//RS             // Its Prelude conversion is needed while `fn build` runs, but the
//RS             // conversion has no runtime source type after that entry is gone.
//RS             Item::ErrorConv(conversion) => {
//RS                 conversion.from_ty != "BuildError" && conversion.to_ty != "BuildError"
//RS             }
//RS             _ => true,
//RS         });
//RS     }
//RS }
