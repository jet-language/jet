// E0222/E0223: a `#Persist`, mutable, or `#Static` module binding owns one
// shared storage cell. A mutable borrow (a `&` parameter or a
// mutating receiver) would let access escape that cell (E0223), except for a
// `#Persist` cell, which is mutable module state lent like a local; a move
// may take the cell as a whole but never one part of it (E0222).
use jet_foundation.[
    ConstAttr,
    ConstDef,
    Diagnostic,
    Expr,
    Span,
    expr_span,
]

// Rust `is_static_move_root`: registration asks once per module constant and
// keeps the keys on the module row (`static_roots`).
sema_ownership_is_static_root: fn(declaration: ConstDef) -> Bool Never! {
    if declaration.is_persist || declaration.mutable -> return true
    loop attr in declaration.attrs {
        if attr == ConstAttr.ForceStatic -> return true
    }
    false
}

// The module's static roots, read from its registration row: walking the
// module's constants here copied every constant AST once per checked function.
sema_ownership_static_roots: fn(graph: SemaRegistrationGraph, module_identity: String) -> [String] {
    module_index: sema_registration_module_index(graph, module_identity) ?? return [String]{}
    graph.modules[module_index].static_roots
}

sema_ownership_persist_roots: fn(graph: SemaRegistrationGraph, module_identity: String) -> [String] {
    module_index: sema_registration_module_index(graph, module_identity) ?? return [String]{}
    graph.modules[module_index].persist_roots
}

// A static place that refuses write access: every static cell but `#Persist`.
sema_ownership_place_refuses_write: fn(state: SemaOwnershipState, place: SemaOwnershipPlace, scopes: SemaScopeTable) -> Bool Never! {
    sema_ownership_place_is_static(place, scopes) && !state.persist_roots.contains(place.root_key)
}

sema_ownership_push_once: fn(diagnostic: Diagnostic, diagnostics: &[Diagnostic]) {
    loop previous in diagnostics {
        if previous.code == diagnostic.code && previous.span == diagnostic.span && previous.what == diagnostic.what -> return
    }
    diagnostics.push(diagnostic)
}

// Rust `reject_static_mutable_borrow` for a static storage cell; any other
// constant can't be changed at all (E0111).
sema_ownership_report_static_write: fn(state: &SemaOwnershipState, place: SemaOwnershipPlace, span: Span, diagnostics: &[Diagnostic]) {
    if !state.static_roots.contains(place.root_key) {
        diagnostics.push(sema_error("E0111", span, "`{place.root}` is a constant, so it can't be changed", "static storage is not mutable", "copy the value into a mutable local (`:=`) and change that"))
        return
    }
    name: sema_ownership_place_name(place)
    sema_ownership_push_once(sema_error("E0223", span, "A mutable borrow of `{name}` cannot escape its persistent or static storage cell", "Persistent and static state must be changed by computing a replacement and assigning the whole binding. A mutable borrow or mutating receiver would let access escape the cell.", "Compute an owned replacement, then assign the persistent or static binding as a whole instead of passing `{name}` with `&` or using a mutating receiver."), diagnostics)
}

// Rust `reject_partial_static_move`: an exact move of one projection of a
// static storage cell. True when the move was rejected.
sema_ownership_reject_partial_static_move: fn(state: &SemaOwnershipState, place: SemaOwnershipPlace, expr: Expr, diagnostics: &[Diagnostic]) -> Bool {
    if place.projections.len() == 0 || !state.static_roots.contains(place.root_key) -> return false
    name: sema_ownership_place_name(place)
    sema_ownership_push_once(sema_error("E0222", expr_span(expr), "A part of `{name}` cannot be moved independently", "Persistent and static storage is shared state; safe lowering can only take or replace the complete root.", "Move or take `{name}` as a whole, or update it atomically."), diagnostics)
    true
}
