// (#5097) A read-only binding of a place (`x: rows[i]`, `x: s.field`)
// borrows the place instead of copying it (TLocal.place_borrow) when no
// copy could be observed. The binding and the variable the place reads
// (its root) are both immutable: sema rejects every write through either
// (E0111 or E0205). The root holds its value for the whole function: it is a read
// parameter (or `self`), or an immutable Let that is not itself a window
// (`r: &place`). Nowhere in the
// function is either variable moved, dropped, closed, taken apart, rolled
// back, edited through a window or named by a closure. So every read of the
// binding sees the bytes a copy would have held, and lowering reads the
// place itself (JetIR ir_stmt `.Let`) instead of copying it into a variable
// that owns it. Every use that hands the value on still copies it (ir_own),
// as for any read of a place another holder keeps.
//
// A text piece borrows the same way (#6414): a string view
// (`x: s.after(sep)`, TLetTy.StrView over trim/after/before/slice) or a
// split pair that diverges on a miss (`x: s.split_once(sep) ?? panic(…)`,
// and `cut_last`) whose text is a root or a place in one. Its bytes are a
// window into the root's, which nothing changes, moves or drops while the
// binding lives; lowering builds the pieces as frame views without a copy
// (JetIR ir_text_piece) and every use that hands one on copies it.
//
// A loop variable is a root for the Lets of its body: it holds one item
// for a whole pass, and every Let of the body ends with the pass.
//
// Only statement-level Lets of a function body are marked; a Let inside an
// expression block (whose value may leave the block) or a lambda is not.
// Both walks are linear in the body: one census of the variables something
// consumes, then one pass over the Lets.
use jet_foundation.[
    AccessConvention,
    BodyIfCond,
    BodyLambda,
    BodyPattern,
    BodyTree,
    SymbolID,
    TIndexKind,
    TLetTy,
    TLetWrapper,
    TLocal,
    body_each_lambda_child,
    body_each_node_kind_child,
    body_each_pattern_child,
    body_each_stmt_child,
    symbol_is_none,
    symbol_none,
]

// The variables the body consumes or a closure names: by symbol id, and by
// name for a local without an id, a window edit's root or a closure's name.
SemaPlaceBorrowCensus: struct {
    keys: [U32:Bool]
    names: [String:Bool]
    // A payload take (`p.move()`) moves out of a subject this walk does not name:
    // nothing in the body borrows.
    any: Bool
}

// The variables a place binding may borrow from (`roots`, by symbol id)
// and the Let ids seen so far; an id declared twice (`blocked`) names no
// single variable.
SemaPlaceBorrowRoots: struct {
    roots: [U32:Bool]
    seen: [U32:Bool]
    blocked: [U32:Bool]
}

// Marks the place-borrowing Lets of a checked function `body`. `receiver`
// is the symbol id of an explicit read `self` (none when absent); `arena`
// holds the rows of the body's flat nodes (sema_node).
sema_place_borrow_function: fn(body: &[TStmt], params: [TParameter], receiver: SymbolID, arena: BodyTree) Never! {
    census := SemaPlaceBorrowCensus{keys: [U32:Bool]{}, names: [String:Bool]{}, any: false}
    sema_place_borrow_census_list(body, arena, census)
    table := SemaPlaceBorrowRoots{roots: [U32:Bool]{}, seen: [U32:Bool]{}, blocked: [U32:Bool]{}}
    loop param in params {
        if param.local.mutable -> next
        if param.convention != AccessConvention.Read -> next
        if param.local.symbol_id == .Val(id) -> _ := table.roots.add(id.id, true)
    }
    if !symbol_is_none(receiver) -> _ := table.roots.add(receiver.id, true)
    sema_place_borrow_statements(body, census, arena, table)
}

sema_place_borrow_statements: fn(body: &[TStmt], census: SemaPlaceBorrowCensus, arena: BodyTree, table: &SemaPlaceBorrowRoots) Never! {
    loop index in 0..<body.len() {
        borrow := false
        if body[index] == .Let(local, let_ty, init, gc_promotion, gc_transferred, _) {
            key: local.symbol_id ?? symbol_none()
            if !symbol_is_none(key) {
                if table.seen.get(key.id) != None -> _ := table.blocked.add(key.id, true)
                _ := table.seen.add(key.id, true)
            }
            piece: sema_place_borrow_piece_root(init, let_ty, arena)
            if !symbol_is_none(key) && gc_promotion == None && !gc_transferred && sema_place_borrow_plain_local(local, let_ty, piece) {
                if !sema_place_borrow_consumed(census, key, local.name) {
                    root: if {
                        !symbol_is_none(piece.key) -> piece
                        sema_place_borrow_place(init, false, arena) -> sema_place_borrow_root(init, arena)
                        else -> SemaPlaceBorrowRoot{key: symbol_none(), name: ""}
                    }
                    if !symbol_is_none(root.key) && table.roots.get(root.key.id) != None && table.blocked.get(root.key.id) == None && !sema_place_borrow_consumed(census, root.key, root.name) -> borrow = true
                }
                // An owning immutable variable is a root for later places;
                // a window (`r: &place`) aliases storage another variable
                // may still change. A piece's bytes stay put while its root
                // does.
                if !sema_place_borrow_is_window(init, arena) -> _ := table.roots.add(key.id, true)
            }
        }
        if borrow {
            if &body[index] == .Let(local, _, _, _, _, _) {
                local.place_borrow = true
            }
        }
        sema_place_borrow_nested(body[index], census, arena, table)
    }
}

// Whether `init` is a window (`&place`).
sema_place_borrow_is_window: fn(init: TExpr, arena: BodyTree) -> Bool Never! {
    if init.kind == {
        .Borrow(_, _) -> true
        .Flat(index) -> arena.nodes[index - arena.node_base].kind == .Borrow(_, _)
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) -> false
    }
}

// An immutable user variable with no address, persistence or wrapper, and
// a string view only when it is a text piece (`piece` has a root).
sema_place_borrow_plain_local: fn(local: TLocal, let_ty: TLetTy, piece: SemaPlaceBorrowRoot) -> Bool Never! {
    if local.mutable || local.generated || local.deref || local.address_lifetime != None || local.persist_key != None -> return false
    if let_ty == {
        .Inferred -> true
        .Annotated(_, wrapper) -> wrapper == TLetWrapper.Plain
        .StrView -> !symbol_is_none(piece.key)
    }
}

// The root of a text piece Let's text (see the header), or a none id
// for any other initializer. A string view's initializer is the view's
// trim/after/before or slice of its text.
sema_place_borrow_piece_root: fn(init: TExpr, let_ty: TLetTy, arena: BodyTree) -> SemaPlaceBorrowRoot Never! {
    none: SemaPlaceBorrowRoot{key: symbol_none(), name: ""}
    if init.kind == .Flat(index) -> return sema_place_borrow_row_piece_root(arena, index, let_ty)
    if let_ty == .StrView {
        if init.kind == .BuiltinMethod(receiver, _, _) -> return sema_place_borrow_text_root(receiver, arena)
        if init.kind == .Slice(base, _, _, _, _) -> return sema_place_borrow_text_root(base, arena)
        return none
    }
    if init.kind == .OrFallback(value, fallback, _) {
        if fallback == .Value(_) -> return none
        if value.kind == .Flat(index) -> return sema_place_borrow_row_cut_root(arena, index)
        if value.kind == .BuiltinMethod(receiver, operation, _) {
            if operation == .StringSplitOnce || operation == .StringCutLast -> return sema_place_borrow_text_root(receiver, arena)
        }
    }
    none
}

// sema_place_borrow_piece_root of node row `index` of `tree`.
sema_place_borrow_row_piece_root: fn(tree: BodyTree, index: Int, let_ty: TLetTy) -> SemaPlaceBorrowRoot Never! {
    none: SemaPlaceBorrowRoot{key: symbol_none(), name: ""}
    kind: tree.nodes[index - tree.node_base].kind
    if let_ty == .StrView {
        if kind == .BuiltinMethod(receiver, _, _) -> return sema_place_borrow_row_text_root(tree, receiver)
        if kind == .Slice(base, _, _, _, _) -> return sema_place_borrow_row_text_root(tree, base)
        return none
    }
    if kind == .OrFallback(value, fallback, _) {
        if fallback == .Value(_) -> return none
        return sema_place_borrow_row_cut_root(tree, value)
    }
    none
}

// The root of the text a `split_once`/`cut_last` row cuts, or a none id.
sema_place_borrow_row_cut_root: fn(tree: BodyTree, index: Int) -> SemaPlaceBorrowRoot Never! {
    if tree.nodes[index - tree.node_base].kind == .BuiltinMethod(receiver, operation, _) {
        if operation == .StringSplitOnce || operation == .StringCutLast -> return sema_place_borrow_row_text_root(tree, receiver)
    }
    SemaPlaceBorrowRoot{key: symbol_none(), name: ""}
}

// The root of a piece's text: a keyed immutable variable itself, or a
// place that reads one.
sema_place_borrow_text_root: fn(text: TExpr, arena: BodyTree) -> SemaPlaceBorrowRoot Never! {
    if sema_place_borrow_place(text, true, arena) -> return sema_place_borrow_root(text, arena)
    SemaPlaceBorrowRoot{key: symbol_none(), name: ""}
}

sema_place_borrow_row_text_root: fn(tree: BodyTree, index: Int) -> SemaPlaceBorrowRoot Never! {
    if sema_place_borrow_row_place(tree, index, true) -> return sema_place_borrow_row_root(tree, index)
    SemaPlaceBorrowRoot{key: symbol_none(), name: ""}
}

// Whether `place` reads an immutable keyed variable through at least one
// field or List element step (`stepped`: a step was already seen).
sema_place_borrow_place: fn(place: TExpr, stepped: Bool, arena: BodyTree) -> Bool Never! {
    if place.kind == {
        .Flat(index) -> sema_place_borrow_row_place(arena, index, stepped)
        .Local(local) -> stepped && !local.mutable && !local.deref && local.symbol_id != None
        .Field(receiver, _) -> sema_place_borrow_place(receiver, true, arena)
        .Index(base, _, kind, access, _, _) -> {
            if kind != TIndexKind.List || access != AccessConvention.Read -> return false
            if !(base.ty == .List(_)) -> return false
            sema_place_borrow_place(base, true, arena)
        }
        .IntLit(_, _) | .StrLit(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) -> false
    }
}

// sema_place_borrow_place of node row `index` of `tree`.
sema_place_borrow_row_place: fn(tree: BodyTree, index: Int, stepped: Bool) -> Bool Never! {
    if tree.nodes[index - tree.node_base].kind == {
        .Local(local) -> stepped && !local.mutable && !local.deref && local.symbol_id != None
        .Field(receiver, _) -> sema_place_borrow_row_place(tree, receiver, true)
        .Index(base, _, kind, access, _, _) -> {
            if kind != TIndexKind.List || access != AccessConvention.Read -> return false
            if !(tree.types.types[tree.expr_types[base - tree.node_base].ty] == .List(_)) -> return false
            sema_place_borrow_row_place(tree, base, true)
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> false
    }
}

// The symbol id and name of the variable a checked place reads.
SemaPlaceBorrowRoot: struct {
    key: SymbolID
    name: String
}

sema_place_borrow_root: fn(place: TExpr, arena: BodyTree) -> SemaPlaceBorrowRoot Never! {
    if place.kind == {
        .Flat(index) -> sema_place_borrow_row_root(arena, index)
        .Local(local) -> SemaPlaceBorrowRoot{key: local.symbol_id ?? symbol_none(), name: local.name}
        .Field(receiver, _) -> sema_place_borrow_root(receiver, arena)
        .Index(base, _, _, _, _, _) | .Slice(base, _, _, _, _) | .OptField(base, _, _) -> sema_place_borrow_root(base, arena)
        .Borrow(inner, _) | .Deref(inner) | .Move(inner) | .SharedGuardValue(inner) -> sema_place_borrow_root(inner, arena)
        .IntLit(_, _) | .StrLit(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .RawAddressOf(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) -> SemaPlaceBorrowRoot{key: symbol_none(), name: ""}
    }
}

// sema_place_borrow_root of node row `index` of `tree`.
sema_place_borrow_row_root: fn(tree: BodyTree, index: Int) -> SemaPlaceBorrowRoot Never! {
    if tree.nodes[index - tree.node_base].kind == {
        .Local(local) -> SemaPlaceBorrowRoot{key: local.symbol_id ?? symbol_none(), name: local.name}
        .Field(receiver, _) -> sema_place_borrow_row_root(tree, receiver)
        .Index(base, _, _, _, _, _) | .Slice(base, _, _, _, _) | .OptField(base, _, _) -> sema_place_borrow_row_root(tree, base)
        .Borrow(inner, _) | .Deref(inner) | .Move(inner) | .SharedGuardValue(inner) -> sema_place_borrow_row_root(tree, inner)
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .RawAddressOf(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> SemaPlaceBorrowRoot{key: symbol_none(), name: ""}
    }
}

sema_place_borrow_consumed: fn(census: SemaPlaceBorrowCensus, key: SymbolID, name: String) -> Bool Never! {
    census.any || census.keys.get(key.id) != None || census.names.get(name) != None
}

sema_place_borrow_note_local: fn(census: &SemaPlaceBorrowCensus, local: TLocal) Never! {
    if local.symbol_id == .Val(id) {
        _ := census.keys.add(id.id, true)
        return
    }
    _ := census.names.add(local.name, true)
}

// The variable at the root of a consumed place.
sema_place_borrow_note_root: fn(census: &SemaPlaceBorrowCensus, root: SemaPlaceBorrowRoot) Never! {
    if !symbol_is_none(root.key) {
        _ := census.keys.add(root.key.id, true)
        return
    }
    if root.name != "" -> _ := census.names.add(root.name, true)
}

sema_place_borrow_census_list: fn(body: [TStmt], arena: BodyTree, census: &SemaPlaceBorrowCensus) Never! {
    loop statement in body -> sema_place_borrow_census_stmt(statement, arena, census)
}

sema_place_borrow_census_optional_list: fn(body: [TStmt]?, arena: BodyTree, census: &SemaPlaceBorrowCensus) Never! {
    if body == .Val(statements) -> sema_place_borrow_census_list(statements, arena, census)
}

// A statement's own consuming facts, then its expressions; a statement with
// nested bodies walks its head expressions here and each body as statements.
sema_place_borrow_census_stmt: fn(statement: TStmt, arena: BodyTree, census: &SemaPlaceBorrowCensus) Never! {
    if statement == {
        .TupleDestructure(_, init, _, _, _) | .StructDestructure(_, init, _, _, _) | .ListDestructure(_, init, _, _, _, _) -> sema_place_borrow_note_root(census, sema_place_borrow_root(init, arena))
        .RefutableBind(pattern, init, fallback, _) -> {
            sema_place_borrow_note_root(census, sema_place_borrow_root(init, arena))
            sema_place_borrow_census_expr(init, arena, census)
            sema_place_borrow_census_pattern(pattern, arena, census)
            return sema_place_borrow_census_list(fallback, arena, census)
        }
        .Assign(place, _, _, _, _) -> {
            if place == {
                .Local(local) -> sema_place_borrow_note_local(census, local)
                .Expr(value) -> sema_place_borrow_note_root(census, sema_place_borrow_root(value, arena))
            }
        }
        .Transact(_, snapshots, _, body, _) -> {
            loop snapshot in snapshots -> sema_place_borrow_note_local(census, snapshot.local)
            sema_place_borrow_census_list(body, arena, census)
        }
        .GCEdit(root, _, _, _, _, nested, _) -> {
            _ := census.names.add(root.copy(), true)
            sema_place_borrow_census_stmt(nested, arena, census)
        }
        .Reactive(executable, _) -> return sema_place_borrow_census_lambda(executable, arena, census)
        .If(condition, then_body, else_body, _, _) -> {
            sema_place_borrow_census_cond(condition, arena, census)
            sema_place_borrow_census_list(then_body, arena, census)
            return sema_place_borrow_census_optional_list(else_body, arena, census)
        }
        .Loop(_, body, _) | .Inline(body, _) | .DebugOnly(body, _) | .DeepCheck(body, _) | .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .Defer(body, _) -> return sema_place_borrow_census_list(body, arena, census)
        .While(_, condition, body, _) -> {
            sema_place_borrow_census_expr(condition, arena, census)
            return sema_place_borrow_census_list(body, arena, census)
        }
        .ForIn(_, _, _, source, collection, step, _, _, by_value, _, body, _) -> {
            if by_value -> sema_place_borrow_note_root(census, sema_place_borrow_root(collection, arena))
            sema_place_borrow_census_expr(source, arena, census)
            sema_place_borrow_census_expr(collection, arena, census)
            if step == .Val(step_value) -> sema_place_borrow_census_expr(step_value, arena, census)
            return sema_place_borrow_census_list(body, arena, census)
        }
        .ForRange(_, _, start, end, step, _, body, _, _) -> {
            sema_place_borrow_census_expr(start, arena, census)
            sema_place_borrow_census_expr(end, arena, census)
            if step == .Val(step_value) -> sema_place_borrow_census_expr(step_value, arena, census)
            return sema_place_borrow_census_list(body, arena, census)
        }
        .CountedLoop(_, init, condition, step, _, body, _) -> {
            sema_place_borrow_census_stmt(init, arena, census)
            sema_place_borrow_census_expr(condition, arena, census)
            if step == .Val(step_statement) -> sema_place_borrow_census_stmt(step_statement, arena, census)
            return sema_place_borrow_census_list(body, arena, census)
        }
        .Match(subject, arms, _, _) -> {
            sema_place_borrow_census_expr(subject, arena, census)
            loop arm in arms {
                sema_place_borrow_census_pattern(arm.pattern, arena, census)
                sema_place_borrow_census_list(arm.body, arena, census)
            }
            return
        }
        .EnumMatch(subject, arms, else_body, _, _) -> {
            sema_place_borrow_census_expr(subject, arena, census)
            loop arm in arms {
                sema_place_borrow_census_pattern(arm.pattern, arena, census)
                sema_place_borrow_census_list(arm.body, arena, census)
            }
            return sema_place_borrow_census_optional_list(else_body, arena, census)
        }
        .RangeSwitch(subject, arms, else_body, _) -> {
            sema_place_borrow_census_expr(subject, arena, census)
            loop arm in arms -> sema_place_borrow_census_list(arm.body, arena, census)
            return sema_place_borrow_census_list(else_body, arena, census)
        }
        .MixedSwitch(subject, _, arms, else_body, _) -> {
            sema_place_borrow_census_expr(subject, arena, census)
            loop arm in arms {
                sema_place_borrow_census_expr(arm.condition, arena, census)
                sema_place_borrow_census_list(arm.body, arena, census)
            }
            return sema_place_borrow_census_optional_list(else_body, arena, census)
        }
        // The rarer bodies: their statements, then every expression in them
        // (the expression walk sees each nested expression once more).
        .ContractScope(_, body, _, _, _) | .Range(_, _, _, _, _, _, _, _, body, _) | .TaskGroup(_, _, body, _) | .Layout(_, _, body, _) | .ContextBlock(_, body, _) | .ScopeMember(_, body, _) -> sema_place_borrow_census_list(body, arena, census)
        .Contract(_) | .Let(_, _, _, _, _, _) | .ExprStmt(_, _) | .Return(_, _) | .DeferClose(_, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) -> {}
    }
    tree_each_stmt_child(statement, fn(child: TExpr) { sema_place_borrow_census_expr(child, arena, census) })
}

sema_place_borrow_census_cond: fn(condition: TIfCond, arena: BodyTree, census: &SemaPlaceBorrowCensus) Never! {
    if condition == {
        .Plain(value) -> sema_place_borrow_census_expr(value, arena, census)
        .And(left, right) -> {
            sema_place_borrow_census_cond(left, arena, census)
            sema_place_borrow_census_cond(right, arena, census)
        }
        .IfLet(pattern, subject) -> {
            sema_place_borrow_census_pattern(pattern, arena, census)
            sema_place_borrow_census_expr(subject, arena, census)
        }
    }
}

sema_place_borrow_census_pattern: fn(pattern: TPattern, arena: BodyTree, census: &SemaPlaceBorrowCensus) Never! {
    tree_each_pattern_child(pattern, fn(child: TExpr) { sema_place_borrow_census_expr(child, arena, census) })
}

sema_place_borrow_census_expr: fn(value: TExpr, arena: BodyTree, census: &SemaPlaceBorrowCensus) Never! {
    if value.kind == {
        .Flat(index) -> return sema_place_borrow_census_row(arena, index, census)
        .Move(moved) -> {
            sema_place_borrow_note_root(census, sema_place_borrow_root(moved, arena))
            // `p.move()` of a match payload takes it out of its subject's storage.
            if moved.kind == .Local(local) {
                if local.payload_take -> census.any = true
            }
        }
        .Drop(dropped) | .Close(dropped) -> sema_place_borrow_note_root(census, sema_place_borrow_root(dropped, arena))
        .Borrow(place, access) -> {
            if access != AccessConvention.Read -> sema_place_borrow_note_root(census, sema_place_borrow_root(place, arena))
        }
        .Lambda(lambda) -> return sema_place_borrow_census_lambda(lambda, arena, census)
        // Any other closure carrier: a name it reads is captured.
        .SharedGuardWait(_, _, _) | .CoreClosureCall(_) | .FnValue(_) -> return sema_place_borrow_census_names(value, arena, census)
        .InlineBlock(body) -> return sema_place_borrow_census_list(body, arena, census)
        .IfExpr(condition, then_body, then_value, else_body, else_value) -> {
            sema_place_borrow_census_cond(condition, arena, census)
            sema_place_borrow_census_list(then_body, arena, census)
            sema_place_borrow_census_expr(then_value, arena, census)
            sema_place_borrow_census_list(else_body, arena, census)
            return sema_place_borrow_census_expr(else_value, arena, census)
        }
        .Binary(_, _, _, lhs, rhs) -> return sema_place_borrow_census_binary(lhs, rhs, arena, census)
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .RequireStop(_, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) -> {}
    }
    tree_each_expr_child(value, fn(child: TExpr) { sema_place_borrow_census_expr(child, arena, census) })
}

// A Binary node's operands, in tree_each_expr_child's order. A left-leaning
// chain (`a + b + c …`) walks its left spine in this frame, so its length
// costs no stack: a Binary node is no census site of its own.
sema_place_borrow_census_binary: fn(lhs: TExpr, rhs: TExpr, arena: BodyTree, census: &SemaPlaceBorrowCensus) Never! {
    rights := [TExpr]{rhs}
    operand := lhs
    loop {
        if operand.kind == .Binary(_, _, _, inner_lhs, inner_rhs) {
            rights.push(inner_rhs)
            operand = inner_lhs
        } else {
            break
        }
    }
    sema_place_borrow_census_expr(operand, arena, census)
    index := rights.len() - 1
    loop index >= 0 {
        sema_place_borrow_census_expr(rights[index], arena, census)
        index -= 1
    }
}

// A closure captures what it names.
sema_place_borrow_census_lambda: fn(lambda: TLambda, arena: BodyTree, census: &SemaPlaceBorrowCensus) Never! {
    loop capture in lambda.captures {
        _ := census.names.add(capture.source, true)
        _ := census.names.add(capture.local.name, true)
    }
    tree_each_lambda_child(lambda, fn(child: TExpr) { sema_place_borrow_census_names(child, arena, census) })
}

sema_place_borrow_census_names: fn(value: TExpr, arena: BodyTree, census: &SemaPlaceBorrowCensus) Never! {
    if value.kind == {
        .Flat(index) -> return sema_place_borrow_census_row_names(arena, index, census)
        .Local(local) -> {
            _ := census.names.add(local.name, true)
            return
        }
        .Lambda(lambda) -> {
            loop capture in lambda.captures -> _ := census.names.add(capture.source, true)
        }
        .IntLit(_, _) | .StrLit(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) -> {}
    }
    tree_each_expr_child(value, fn(child: TExpr) { sema_place_borrow_census_names(child, arena, census) })
}

// The census rows of a flat node: sema_place_borrow_census_list,
// sema_place_borrow_census_stmt, sema_place_borrow_census_cond,
// sema_place_borrow_census_pattern, sema_place_borrow_census_expr and
// sema_place_borrow_census_names over rows of `tree`.
sema_place_borrow_census_row_list: fn(tree: BodyTree, body: [Int], census: &SemaPlaceBorrowCensus) Never! {
    loop item in body -> sema_place_borrow_census_row_stmt(tree, item, census)
}

sema_place_borrow_census_row_optional_list: fn(tree: BodyTree, body: [Int]?, census: &SemaPlaceBorrowCensus) Never! {
    if body == .Val(statements) -> sema_place_borrow_census_row_list(tree, statements, census)
}

sema_place_borrow_census_row_stmt: fn(tree: BodyTree, item: Int, census: &SemaPlaceBorrowCensus) Never! {
    if tree.stmts[item - tree.stmt_base] == {
        .TupleDestructure(_, init, _, _, _) | .StructDestructure(_, init, _, _, _) | .ListDestructure(_, init, _, _, _, _) -> sema_place_borrow_note_root(census, sema_place_borrow_row_root(tree, init))
        .RefutableBind(pattern, init, fallback, _) -> {
            sema_place_borrow_note_root(census, sema_place_borrow_row_root(tree, init))
            sema_place_borrow_census_row(tree, init, census)
            sema_place_borrow_census_row_pattern(tree, pattern, census)
            return sema_place_borrow_census_row_list(tree, fallback, census)
        }
        .Assign(place, _, _, _, _) -> {
            if place == {
                .Local(local) -> sema_place_borrow_note_local(census, local)
                .Expr(value) -> sema_place_borrow_note_root(census, sema_place_borrow_row_root(tree, value))
            }
        }
        .Transact(_, snapshots, _, body, _) -> {
            loop snapshot in snapshots -> sema_place_borrow_note_local(census, snapshot.local)
            sema_place_borrow_census_row_list(tree, body, census)
        }
        .GCEdit(root, _, _, _, _, nested, _) -> {
            _ := census.names.add(root, true)
            sema_place_borrow_census_row_stmt(tree, nested, census)
        }
        .Reactive(executable, _) -> return sema_place_borrow_census_row_lambda(tree, executable, census)
        .If(condition, then_body, else_body, _, _) -> {
            sema_place_borrow_census_row_cond(tree, condition, census)
            sema_place_borrow_census_row_list(tree, then_body, census)
            return sema_place_borrow_census_row_optional_list(tree, else_body, census)
        }
        .Loop(_, body, _) | .Inline(body, _) | .DebugOnly(body, _) | .DeepCheck(body, _) | .Unsafe(_, body) | .UnsafeBlock(_, body, _) | .SentryPolicy(_, body, _) | .Impure(body, _) | .Region(body, _) | .Live(body, _) | .Shield(body, _) | .Defer(body, _) -> return sema_place_borrow_census_row_list(tree, body, census)
        .While(_, condition, body, _) -> {
            sema_place_borrow_census_row(tree, condition, census)
            return sema_place_borrow_census_row_list(tree, body, census)
        }
        .ForIn(_, _, _, source, collection, step, _, _, by_value, _, body, _) -> {
            if by_value -> sema_place_borrow_note_root(census, sema_place_borrow_row_root(tree, collection))
            sema_place_borrow_census_row(tree, source, census)
            sema_place_borrow_census_row(tree, collection, census)
            if step == .Val(step_value) -> sema_place_borrow_census_row(tree, step_value, census)
            return sema_place_borrow_census_row_list(tree, body, census)
        }
        .ForRange(_, _, start, end, step, _, body, _, _) -> {
            sema_place_borrow_census_row(tree, start, census)
            sema_place_borrow_census_row(tree, end, census)
            if step == .Val(step_value) -> sema_place_borrow_census_row(tree, step_value, census)
            return sema_place_borrow_census_row_list(tree, body, census)
        }
        .CountedLoop(_, init, condition, step, _, body, _) -> {
            sema_place_borrow_census_row_stmt(tree, init, census)
            sema_place_borrow_census_row(tree, condition, census)
            if step == .Val(step_statement) -> sema_place_borrow_census_row_stmt(tree, step_statement, census)
            return sema_place_borrow_census_row_list(tree, body, census)
        }
        .Match(subject, arms, _, _) -> {
            sema_place_borrow_census_row(tree, subject, census)
            loop arm in arms {
                sema_place_borrow_census_row_pattern(tree, arm.pattern, census)
                sema_place_borrow_census_row_list(tree, arm.body, census)
            }
            return
        }
        .EnumMatch(subject, arms, else_body, _, _) -> {
            sema_place_borrow_census_row(tree, subject, census)
            loop arm in arms {
                sema_place_borrow_census_row_pattern(tree, arm.pattern, census)
                sema_place_borrow_census_row_list(tree, arm.body, census)
            }
            return sema_place_borrow_census_row_optional_list(tree, else_body, census)
        }
        .RangeSwitch(subject, arms, else_body, _) -> {
            sema_place_borrow_census_row(tree, subject, census)
            loop arm in arms -> sema_place_borrow_census_row_list(tree, arm.body, census)
            return sema_place_borrow_census_row_list(tree, else_body, census)
        }
        .MixedSwitch(subject, _, arms, else_body, _) -> {
            sema_place_borrow_census_row(tree, subject, census)
            loop arm in arms {
                sema_place_borrow_census_row(tree, arm.condition, census)
                sema_place_borrow_census_row_list(tree, arm.body, census)
            }
            return sema_place_borrow_census_row_optional_list(tree, else_body, census)
        }
        .ContractScope(_, body, _, _, _) | .Range(_, _, _, _, _, _, _, _, body, _) | .TaskGroup(_, _, body, _) | .Layout(_, _, body, _) | .ContextBlock(_, body, _) | .ScopeMember(_, body, _) -> sema_place_borrow_census_row_list(tree, body, census)
        .Contract(_) | .Let(_, _, _, _, _, _) | .ExprStmt(_, _) | .Return(_, _) | .DeferClose(_, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) -> {}
    }
    body_each_stmt_child(tree, tree.stmts[item - tree.stmt_base], fn(child: Int) { sema_place_borrow_census_row(tree, child, census) })
}

sema_place_borrow_census_row_cond: fn(tree: BodyTree, condition: BodyIfCond, census: &SemaPlaceBorrowCensus) Never! {
    if condition == {
        .Plain(value) -> sema_place_borrow_census_row(tree, value, census)
        .And(left, right) -> {
            sema_place_borrow_census_row_cond(tree, left, census)
            sema_place_borrow_census_row_cond(tree, right, census)
        }
        .IfLet(pattern, subject) -> {
            sema_place_borrow_census_row_pattern(tree, pattern, census)
            sema_place_borrow_census_row(tree, subject, census)
        }
    }
}

sema_place_borrow_census_row_pattern: fn(tree: BodyTree, pattern: BodyPattern, census: &SemaPlaceBorrowCensus) Never! {
    body_each_pattern_child(tree, pattern, fn(child: Int) { sema_place_borrow_census_row(tree, child, census) })
}

sema_place_borrow_census_row: fn(tree: BodyTree, index: Int, census: &SemaPlaceBorrowCensus) Never! {
    if tree.nodes[index - tree.node_base].kind == {
        .Move(moved) -> {
            sema_place_borrow_note_root(census, sema_place_borrow_row_root(tree, moved))
            // `p.move()` of a match payload takes it out of its subject's storage.
            if tree.nodes[moved - tree.node_base].kind == .Local(local) {
                if local.payload_take -> census.any = true
            }
        }
        .Drop(dropped) | .Close(dropped) -> sema_place_borrow_note_root(census, sema_place_borrow_row_root(tree, dropped))
        .Borrow(place, access) -> {
            if access != AccessConvention.Read -> sema_place_borrow_note_root(census, sema_place_borrow_row_root(tree, place))
        }
        .Lambda(lambda) -> return sema_place_borrow_census_row_lambda(tree, lambda, census)
        // Any other closure carrier: a name it reads is captured.
        .SharedGuardWait(_, _, _) | .CoreClosureCall(_) | .FnValue(_) -> return sema_place_borrow_census_row_names(tree, index, census)
        .InlineBlock(body) -> return sema_place_borrow_census_row_list(tree, body, census)
        .IfExpr(condition, then_body, then_value, else_body, else_value) -> {
            sema_place_borrow_census_row_cond(tree, condition, census)
            sema_place_borrow_census_row_list(tree, then_body, census)
            sema_place_borrow_census_row(tree, then_value, census)
            sema_place_borrow_census_row_list(tree, else_body, census)
            return sema_place_borrow_census_row(tree, else_value, census)
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Local(_) | .Unit | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
    }
    body_each_node_kind_child(tree, tree.nodes[index - tree.node_base].kind, fn(child: Int) { sema_place_borrow_census_row(tree, child, census) })
}

// A closure captures what it names.
sema_place_borrow_census_row_lambda: fn(tree: BodyTree, lambda: BodyLambda, census: &SemaPlaceBorrowCensus) Never! {
    loop capture in lambda.captures {
        _ := census.names.add(capture.source, true)
        _ := census.names.add(capture.local.name, true)
    }
    body_each_lambda_child(tree, lambda, fn(child: Int) { sema_place_borrow_census_row_names(tree, child, census) })
}

sema_place_borrow_census_row_names: fn(tree: BodyTree, index: Int, census: &SemaPlaceBorrowCensus) Never! {
    if tree.nodes[index - tree.node_base].kind == {
        .Local(local) -> {
            _ := census.names.add(local.name, true)
            return
        }
        .Lambda(lambda) -> {
            loop capture in lambda.captures -> _ := census.names.add(capture.source, true)
        }
        .IntLit(_, _) | .FloatLit(_) | .BoolLit(_) | .CharLit(_) | .StrLit(_) | .Unit | .InlineBlock(_) | .Uninit | .CtLit(_) | .ConstRef(_) | .TraitConst(_, _, _) | .GlobalShared(_, _) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .DistinctConvert(_, _, _, _, _) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Slice(_, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .EnumCtor(_, _, _) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardMap(_, _, _) | .SharedGuardSplit(_, _, _, _) | .SharedGuardWait(_, _, _) | .ConditionNotify(_, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .DecodeUnder(_, _) | .BuiltinMethod(_, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .InvariantViolation(_, _) | .DistinctRaw(_) | .Present(_) | .Absent | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .OptionLift2(_, _, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectStart | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .SelectWait(_, _) | .FnValue(_) | .Never(_, _) | .TypeTest(_, _) | .NumberParam(_) | .CopyPhase(_, _, _, _) -> {}
    }
    body_each_node_kind_child(tree, tree.nodes[index - tree.node_base].kind, fn(child: Int) { sema_place_borrow_census_row_names(tree, child, census) })
}

// The statement bodies of `statement` that hold Lets of their own block.
sema_place_borrow_nested: fn(statement: &TStmt, census: SemaPlaceBorrowCensus, arena: BodyTree, table: &SemaPlaceBorrowRoots) Never! {
    if &statement == {
        // One arm per statement kind: an alternative pattern binds read-only.
        .ContractScope(_, body, _, _, _) -> sema_place_borrow_statements(body, census, arena, table)
        .ForRange(_, _, _, _, _, _, body, _, _) -> sema_place_borrow_statements(body, census, arena, table)
        .Range(_, _, _, _, _, _, _, _, body, _) -> sema_place_borrow_statements(body, census, arena, table)
        .CountedLoop(_, _, _, _, _, body, _) -> sema_place_borrow_statements(body, census, arena, table)
        .Loop(_, body, _) -> sema_place_borrow_statements(body, census, arena, table)
        .While(_, _, body, _) -> sema_place_borrow_statements(body, census, arena, table)
        .ForIn(_, variable, _, _, _, _, _, _, _, _, body, _) -> {
            sema_place_borrow_loop_root(variable, census, table)
            sema_place_borrow_statements(body, census, arena, table)
        }
        .Inline(body, _) -> sema_place_borrow_statements(body, census, arena, table)
        .DebugOnly(body, _) -> sema_place_borrow_statements(body, census, arena, table)
        .DeepCheck(body, _) -> sema_place_borrow_statements(body, census, arena, table)
        .Unsafe(_, body) -> sema_place_borrow_statements(body, census, arena, table)
        .UnsafeBlock(_, body, _) -> sema_place_borrow_statements(body, census, arena, table)
        .SentryPolicy(_, body, _) -> sema_place_borrow_statements(body, census, arena, table)
        .Impure(body, _) -> sema_place_borrow_statements(body, census, arena, table)
        .If(_, then_body, else_body, _, _) -> {
            sema_place_borrow_statements(then_body, census, arena, table)
            if &else_body == .Val(statements) {
                sema_place_borrow_statements(statements, census, arena, table)
            }
        }
        .Match(_, arms, _, _) -> loop arm_index in 0..<arms.len() -> sema_place_borrow_statements(arms[arm_index].body, census, arena, table)
        .EnumMatch(_, arms, else_body, _, _) -> {
            loop arm_index in 0..<arms.len() -> sema_place_borrow_statements(arms[arm_index].body, census, arena, table)
            if &else_body == .Val(statements) {
                sema_place_borrow_statements(statements, census, arena, table)
            }
        }
        .RangeSwitch(_, arms, else_body, _) -> {
            loop arm_index in 0..<arms.len() -> sema_place_borrow_statements(arms[arm_index].body, census, arena, table)
            sema_place_borrow_statements(else_body, census, arena, table)
        }
        .MixedSwitch(_, _, arms, else_body, _) -> {
            loop arm_index in 0..<arms.len() -> sema_place_borrow_statements(arms[arm_index].body, census, arena, table)
            if &else_body == .Val(statements) {
                sema_place_borrow_statements(statements, census, arena, table)
            }
        }
        .Contract(_) | .Let(_, _, _, _, _, _) | .RefutableBind(_, _, _, _) | .TupleDestructure(_, _, _, _, _) | .StructDestructure(_, _, _, _, _) | .ListDestructure(_, _, _, _, _, _) | .Assign(_, _, _, _, _) | .ExprStmt(_, _) | .Return(_, _) | .TaskGroup(_, _, _, _) | .DeferClose(_, _, _) | .Break(_, _) | .BreakValue(_, _, _) | .Continue(_, _) | .Reactive(_, _) | .Region(_, _) | .Layout(_, _, _, _) | .ContextBlock(_, _, _) | .Live(_, _) | .Shield(_, _) | .Defer(_, _) | .ScopeMember(_, _, _) | .Transact(_, _, _, _, _) | .GCEdit(_, _, _, _, _, _, _) -> {}
    }
}

// A loop variable is a root for its body's Lets (see the header) when it
// is immutable and nothing consumes it.
sema_place_borrow_loop_root: fn(variable: TLocal, census: SemaPlaceBorrowCensus, table: &SemaPlaceBorrowRoots) Never! {
    key: variable.symbol_id ?? return
    if table.seen.get(key.id) != None -> _ := table.blocked.add(key.id, true)
    _ := table.seen.add(key.id, true)
    if variable.mutable || variable.deref || sema_place_borrow_consumed(census, key, variable.name) -> return
    _ := table.roots.add(key.id, true)
}
