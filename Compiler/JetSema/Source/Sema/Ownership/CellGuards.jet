// E0217: a Cell guard (`CellReadGuard<T>` / `CellEditGuard<T>`) is a
// temporary loan handle. It may live in a local name or a tuple of locals,
// never inside another value, so the loan cannot outlive its local scope.
// Declarations are checked at registration (Registration/Checked.jet); this
// file covers values built in expressions and lambda captures.
use jet_foundation.[
    Diagnostic,
    Expr,
    Span,
    Type,
    expr_span,
    type_name,
]

sema_cell_guard_contained: fn(ty: Type) -> Bool Never! {
    sema_checked_type_contains_name(ty, [String]{"CellReadGuard", "CellEditGuard"})
}

// Rust `cell_guard_storage_is_unsupported`: the guard itself and a tuple of
// guards are local values; any other type holding one stores it.
sema_cell_guard_storage_unsupported: fn(ty: Type) -> Bool Never! {
    if ty == {
        .Apply(name, _) -> {
            if name == "CellReadGuard" || name == "CellEditGuard" -> return false
        }
        .Tuple(fields) -> {
            loop field in fields {
                if sema_cell_guard_storage_unsupported(field.ty) -> return true
            }
            return false
        }
        .Int | .Float | .Bool | .String | .Char | .List(_) | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .TraitObject(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Case(_, _) | .Quantity(_, _) | .Measure(_) -> {}
    }
    sema_cell_guard_contained(ty)
}

// Rust `report_cell_guard_storage`: one report per span and message.
sema_cell_guard_report: fn(what: String, span: Span, diagnostics: &[Diagnostic]) {
    loop diagnostic in diagnostics {
        if diagnostic.code == "E0217" && diagnostic.what == what {
            if diagnostic.span == .Val(existing) {
                if existing.start == span.start && existing.end == span.end -> return
            }
        }
    }
    diagnostics.push(sema_error("E0217", span, what, "a Cell guard is a temporary loan handle; storing it inside another value could keep the loan after its local scope ends", "keep the guard in a local name or a tuple, and use `.map(...)` or `.split(...)` for projections"))
}

sema_cell_guard_constructs_value: fn(expr: Expr) -> Bool Never! {
    if expr == {
        .ListLit(_, _, _) | .MapLit(_, _, _) | .TupleLit(_, _, _, _) | .Call(_, _) | .MethodCall(_, _, _, _, _, _, _) | .CallValue(_, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Present(_, _, _) | .Ok(_, _, _) | .Err(_, _, _) -> true
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .Lambda(_, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// Rust `infer`: an expression that builds a value whose type stores a guard.
sema_cell_guard_check_construct: fn(expr: Expr, ty: Type, diagnostics: &[Diagnostic]) {
    if !sema_cell_guard_constructs_value(expr) || !sema_cell_guard_storage_unsupported(ty) -> return
    sema_cell_guard_report("a Cell guard cannot be stored inside `{type_name(ty)}`", expr_span(expr), diagnostics)
}

// Rust `check_lambda` captures: a lambda would carry the loan with it.
sema_cell_guard_check_capture: fn(name: String, ty: Type, span: Span, diagnostics: &[Diagnostic]) {
    if sema_cell_guard_contained(ty) -> sema_cell_guard_report("Cell guard `{name}` cannot be captured by a lambda", span, diagnostics)
}
