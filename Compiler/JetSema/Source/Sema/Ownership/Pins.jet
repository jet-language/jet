// `mem.pin(place) -> Pin<T>` starts a tracked write window that
// promises the place keeps its address. The pin names that storage location,
// so its argument must be a named place (E0218).
use jet_foundation.[
    AccessConvention,
    Binding,
    CallArg,
    Diagnostic,
    Expr,
    PlaceAccess,
    Type,
    expr_span,
]

// D-CALLSITE-MARK2=A: `pin`'s parameter is a write window, so a named place
// passed plain is that window.
sema_pin_write_window: fn(argument: CallArg) -> Bool Never! {
    if argument.convention == AccessConvention.Write -> return true
    if argument.expr == .Place(_, access, _, _) {
        return access == PlaceAccess.Write
    }
    argument.convention == AccessConvention.Read && sema_receiver_mark_place_root(argument.expr) != None
}

// Rust `core_call` arm ("core.mem", "pin") for the one argument of
// `mem.pin` (sema_call_memory_pin). False when the call is rejected.
sema_pin_check_call: fn(args: [CallArg], diagnostics: &[Diagnostic]) -> Bool {
    if sema_pin_write_window(args[0]) -> return true
    diagnostics.push(sema_error("E0218", expr_span(args[0].expr), "`pin` needs a named place to pin", "a pin promises one storage location will not move, so it has to name that location instead of a temporary value", "bind the value to a `:=` name, then write `mem.pin(place)`"))
    false
}

sema_pin_type: fn(ty: Type) -> Bool Never! {
    sema_pin_target(ty) != None
}

// The pinned type `T` of a `Pin<T>`, spelled bare (`mem.pin`'s result) or as
// the Core nominal `<corelib>/core.mem::Pin` (a written annotation); None for
// any other type.
sema_pin_target: fn(ty: Type) -> Type? Never! {
    if sema_expr_unwrap_tag(ty) == .Apply(name, args) {
        if (name == "Pin" || name == "<corelib>/core.mem::Pin") && args.len() == 1 -> return Val(args[0].copy())
    }
    None
}

// Rust `ViewKind::Pin`: a view fact is a pin when its carrier holds a `Pin<T>`.
// The carrier key was resolved from the carrier's name, so only that name's
// binding positions can hold it; the scan stays off the module-wide table.
sema_pin_view_fact: fn(fact: SemaOwnershipViewFact, scopes: SemaScopeTable) -> Bool Never! {
    slot: sema_scope_name_slot(scopes, fact.carrier) ?? return false
    loop position in scopes.name_positions[slot] {
        if scopes.bindings[position].symbol.id.key == fact.carrier_key {
            ty: scopes.bindings[position].symbol.ty ?? return false
            return sema_pin_type(ty)
        }
    }
    false
}

// Rust matches only `alias.pin(arg)` with a `core.mem` alias; the caller also
// requires the `Pin<T>` result type.
sema_pin_call_argument: fn(expr: Expr) -> CallArg? {
    if expr == {
        .MethodCall(receiver, method, _, _, _, args, _) -> if method == "pin" && args.len() == 1 && receiver == .Ident(_, _, _) -> Val(args[0]) else -> None
        .Paren(value, _, _) -> sema_pin_call_argument(value)
        else -> None
    }
}

// Rust `core_call` ("core.mem", "pin") view fact: `pinned: mem.pin(place)`
// keeps an exclusive write window on `place` for as long as `pinned` lives.
// True when the binding is a pin and its fact was recorded.
sema_pin_record_binding: fn(state: &SemaOwnershipState, binding: Binding, init_ty: Type, scopes: SemaScopeTable) -> Bool {
    if !sema_pin_type(init_ty) -> return false
    argument: sema_pin_call_argument(binding.init) ?? return false
    if !sema_pin_write_window(argument) -> return false
    target: if argument.expr == {
        .Place(value, _, _, _) -> value
        else -> argument.expr
    }
    places: sema_ownership_places_from_expr_in_state(target, scopes, state)
    if places.len() != 1 -> return false
    loan_seq: sema_ownership_matching_loan_seq(state, places[0], expr_span(argument.expr))
    sema_ownership_record_view_fact(state, binding.name, binding.name_span, places[0], [String]{}, AccessConvention.Write, scopes, loan_seq)
}

// Rust `check_owner_change(name, "be moved")` for the exact move `place.move()`:
// moving a pinned place is E0219. Runs before the moved place is read.
sema_pin_check_move: fn(state: &SemaOwnershipState, expr: Expr, scopes: SemaScopeTable, diagnostics: &[Diagnostic]) -> Bool {
    loop place in sema_ownership_places_from_expr_in_state(expr, scopes, state) {
        if sema_ownership_conflicting_view_for_expr(state, place, AccessConvention.Move, expr, scopes) == .Val(fact) {
            if sema_pin_view_fact(fact, scopes) {
                diagnostics.push(sema_ownership_diag_view_change(fact, place, "be moved", expr_span(expr), scopes))
                return false
            }
        }
    }
    true
}
