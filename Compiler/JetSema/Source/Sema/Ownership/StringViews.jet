// This rule stage S5 string views. `x: s.trim()`,
// `x: s.after(sep)` and `x: s.before(sep)` on a local or parameter
// `String` bind a zero-copy `&str` window into `s`. `String` stays one type,
// so the view-ness lives on the binding (SemaScopeBinding.string_view) and on
// its read view fact over `s`; the let lowers through TLetTy.StrView and the
// borrowed TrimView/AfterView/BeforeView operations. An owning destination
// materializes the view by default; `copies: .Explicit` turns a bare read of
// the view into E2307 instead.
use jet_foundation.[
    AccessConvention,
    Diagnostic,
    DiagnosticFixApplicability,
    DiagnosticFixSafety,
    Expr,
    MARKER_POLICY,
    Marker,
    PolicyDeclaration,
    PolicyKey,
    Span,
    SymbolKind,
    TBuiltinOp,
    TextEdit,
    Type,
    ViewProvenanceEntry,
    ViewProvenanceMap,
    diagnostic_with_edit_grade,
    expr_span,
    type_identity_equal,
    type_name,
    ModuleID,
]

sema_string_view_copies_declaration: fn(declaration: PolicyDeclaration) -> Bool Never! {
    if declaration.key != PolicyKey.Copies -> return false
    if declaration.value == {
        .Explicit -> true
        .Enabled | .Limit(_) | .Forbid | .Default | .GateOnly | .Obligations | .Relaxed | .PerSite | .Track | .Skip | .Allow | .On | .Off | .Arithmetic(_) -> false
    }
}

sema_string_view_copies_marker: fn(marker: Marker) -> Bool Never! {
    if marker.name != MARKER_POLICY -> return false
    loop (index, label) in marker.arg_labels {
        written: label ?? next
        if written.name != "copies" || index >= marker.args.len() -> next
        if marker.args[index] == {
            .Expr(value) -> {
                if value == {
                    .EnumLit(type_name, variant, _, args, _, _, _) -> {
                        if type_name == "" && variant == "Explicit" && args.len() == 0 -> return true
                    }
                    .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> {}
                }
            }
            .EffectRow(_, _) -> {}
        }
    }
    false
}

// Rust `copies_explicit`: a package or module `copies: .Explicit` declaration,
// or the function's own `#Policy(copies: .Explicit)` marker.
sema_string_view_apply_copies_policy: fn(table: &SemaScopeTable, graph: SemaRegistrationGraph, module_identity: ModuleID, markers: [Marker]) Never! {
    position: sema_scope_module_policy(table, graph, module_identity)
    table.copies_explicit = table.policy_rows[position].copies_explicit
    loop marker in markers {
        if sema_string_view_copies_marker(marker) -> table.copies_explicit = true
    }
}

// A block `#Policy(copies: .Explicit) { … }` turns the explicit-copy ladder
// on for its body. Returns the enclosing setting for the matching pop.
sema_string_view_push_copies_policy: fn(table: &SemaScopeTable, declarations: [PolicyDeclaration]) -> Bool Never! {
    previous: table.copies_explicit
    loop declaration in declarations {
        if sema_string_view_copies_declaration(declaration) -> table.copies_explicit = true
    }
    previous
}

// Rust `string_view_call_source`: the owner places of a `trim`/`after`/
// `before`/`slice` call on a plain local or parameter `String` name; empty
// for any other initializer.
sema_string_view_call_sources: fn(init: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState) -> [SemaOwnershipPlace] {
    none := [SemaOwnershipPlace]{}
    if init == {
        .MethodCall(receiver, method, _, _, _, args, _) -> {
            arity_ok: (method == "trim" && args.len() == 0) || ((method == "after" || method == "before") && args.len() == 1) || (method == "slice" && (args.len() == 1 || args.len() == 2))
            if !arity_ok -> return none
            if receiver == {
                .Ident(name, _, _) -> {
                    symbol: sema_scope_resolve(scopes, name) ?? return none
                    if symbol.kind != SymbolKind.Local && symbol.kind != SymbolKind.Parameter -> return none
                    if symbol.ty != (Val(Type.String)) -> return none
                    return sema_ownership_places_from_expr_in_state(receiver, scopes, state)
                }
                .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return none
            }
        }
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return none
    }
}

sema_string_view_is_slice_call: fn(init: Expr) -> Bool Never! {
    if init == .MethodCall(_, method, _, _, _, _, _) -> return method == "slice"
    false
}

// Rust `lower_string_view_init`: the borrowed sibling of the owned String
// operation, carried as `View<str>` so the place keeps the `&str` shape. A
// `slice` keeps its operation: only its type becomes the view.
sema_string_view_lower_init: fn(init: TExpr) -> TExpr? {
    view_type: Type.Apply{name: "View", args: [Type]{Type.Named{name: "str"}}}
    if init.kind == {
        .BuiltinMethod(receiver, operation, args) -> {
            view_operation: if operation == {
                .Trim -> TBuiltinOp.TrimView
                .After -> TBuiltinOp.AfterView
                .Before -> TBuiltinOp.BeforeView
                .Slice(line) -> TBuiltinOp.Slice{line: line}
                .AtomicMethod(_) | .LenString | .LenList | .IsEmpty | .Push | .ListTryNew | .ListTryWithCapacity | .TryPush | .TryReserve | .TryInsertMap | .TryStringPush | .StringEdit(_) | .Pop | .PriorityQueuePop | .InsertMap | .AddNewMap | .MapSetDefault | .MapUpdate | .MapMerge | .MapMergeWith | .InsertList | .RemoveMap | .RemoveList(_, _) | .CountList | .Counts | .ExtendList | .ConcatList | .GetMap | .GetList | .First | .Last | .Contains | .IndexOf | .Reverse | .SwapList | .ListFill | .Sort | .SortDesc | .OrderingThen | .OrderingReverse | .JoinSep | .Sum(_, _) | .Product(_) | .Min(_) | .Max(_) | .Flatten | .Intersperse | .Unzip | .Clear | .Chars | .Bytes(_) | .StringFromBytes | .StringFromBytesLossy | .StringWithCapacity | .TrimStart | .TrimEnd | .PadStart | .PadEnd | .StringIndexOf | .StringCount | .StringIsAlphabetic | .StringIsNumeric | .StringIsWhitespace | .StringIsASCII | .StringToTitle | .StringMethod(_) | .StringSplitOnce | .StringCutLast | .Split | .Lines | .ParseInt | .ParseFloat | .IntToRadix | .IntFromRadix | .StartsWith | .EndsWith | .Replace | .ToUpper | .ToLower | .ToASCIILower | .ToASCIIUpper | .Repeat | .TrimView | .AfterView | .BeforeView | .Keys | .Values | .ContainsKey | .ToString | .Take | .Skip | .IterToList | .IterCollect | .ListLazy | .StepBy | .Dedup | .Chunks | .Windows | .IterRepeat | .IterCycle | .IterDropLast | .IterNext | .IterShuffle | .IterIsSorted | .IterLastIndexOf | .IterAverage(_) | .IterCompare | .IterSplit | .ListSlice | .ListEqual | .ListBinarySearch | .ListUnion | .ListIntersection | .ListDifference | .ListRandom | .ListMinMax | .MapEqual | .MapFirst | .MapToList | .MapTopN | .MapMin | .MapMax | .MapIntersection | .MapSliceKeys | .MapFromKeys | .MapContainsValue | .MapPopFirst | .ListReplace | .Indexed | .Indexes | .Zip(_, _, _, _, _, _) | .OptionZip(_) | .SetFrom | .SetInsert | .SetUpdate | .SetDifferenceUpdate | .SetIntersectionUpdate | .SetSymmetricDifferenceUpdate | .SetRemove | .SetToList | .SetUnion | .SetIntersection | .SetDifference | .SetSymmetricDifference | .SetIsSubset | .SetIsSuperset | .SetIsDisjoint | .SetEqual | .SetCapacity | .SetFirst | .SetValues | .SetPop | .SetReplace | .SetSort | .SetShuffle | .SortedSetFrom | .SortedSetInsert | .SortedSetRemove | .SortedSetToList | .SortedSetUnion | .SortedSetIntersection | .SortedSetDifference | .SortedSetSymmetricDifference | .SortedSetIsSubset | .SortedSetIsSuperset | .SortedSetIsDisjoint | .PriorityQueueFrom | .PriorityQueuePeek | .PriorityQueueToSortedList | .PriorityQueueRemove(_, _) | .KeyOrdered(_, _) | .LRUPut | .LRUAddNew | .LRUGet | .LRURemove | .LRUCapacity | .LRUKeys | .BitSetAdd | .BitSetRemove | .BitSetCount | .BitSetToList | .ByteBufferFrom | .ByteBufferWrite(_) | .ByteBufferToBytes | .ByteBufferMethod(_) | .ByteBufferWithCapacity | .BagAdd | .BagRemove | .BagHas | .BagCount | .DequePushFront | .DequePushBack | .DequePopFront | .DequePopBack | .DequePeekFront | .DequePeekBack | .DequeCapacity | .DequeContains | .DequeGet | .DequeDelete | .DequeToList | .DequeJoin | .DequeReverse | .DequeSplit | .DequeFrom | .TryCollect | .ViewNew(_) | .SplitWrite | .GetDisjointWrite | .ListFillRepeat -> {
                    return None
                }
            }
            return Val(TExpr{ty: view_type, kind: TExprKind.BuiltinMethod{receiver: receiver, operation: view_operation, args: args}, span: init.span})
        }
        .Slice(base, _, _, _, _) -> {
            if base.ty != Type.String -> return None
            viewed := init
            tree_expr_retype(viewed, view_type)
            return Val(viewed)
        }
        .IntLit(_, _) | .StrLit(_) | .Local(_) | .InlineBlock(_) | .CtLit(_) | .Call(_, _, _) | .IndirectCall(_, _, _, _) | .MethodCall(_, _, _, _) | .DistinctCtor(_) | .TraitBox(_, _) | .UnitConvert(_, _, _, _, _, _, _, _) | .MathBuiltin(_, _, _) | .PreciseBuiltin(_, _, _) | .Print(_) | .Drop(_) | .Close(_) | .Move(_) | .RequireStop(_, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _) | .Unary(_, _) | .StructLit(_) | .Field(_, _) | .Index(_, _, _, _, _, _) | .Range(_, _, _) | .Tuple(_) | .List(_, _) | .Map(_) | .Try(_, _, _) | .TryWithContext(_, _, _, _, _, _) | .Lambda(_) | .Borrow(_, _) | .RawAddressOf(_) | .Deref(_) | .PtrFromAddr(_, _) | .LayoutLiteral(_) | .LayoutCompare(_, _, _) | .SharedGuardValue(_) | .SharedGuardWait(_, _, _) | .CoreCall(_, _, _, _, _, _) | .HostCall(_) | .AllocNew(_, _) | .EnumLit(_, _, _) | .JSONLit(_, _, _) | .ListLit(_) | .ListSpread(_) | .MapLit(_) | .PoolSlot(_, _, _, _, _, _) | .Clone(_, _) | .ExplicitCopy(_) | .MaterializeView(_) | .StaticCall(_, _, _, _, _) | .IfExpr(_, _, _, _, _) | .RawOf(_) | .DistinctRaw(_) | .Present(_) | .Ok(_) | .Err(_) | .OrFallback(_, _, _) | .OptField(_, _, _) | .OptMethodCall(_, _, _, _) | .PatternMatches(_, _) | .ClosureMethod(_, _, _) | .NumericMethod(_, _) | .NumericBinaryMethod(_, _, _) | .OverflowOpt(_, _, _, _, _) | .HandleMethod(_, _, _) | .CoreClosureCall(_) | .TaskGroupAll(_) | .TaskGroupRace(_) | .TaskGroupAny(_) | .SelectRecv(_, _) | .SelectAfter(_, _, _) | .FnValue(_) | .Flat(_) -> return None
    }
}

// Rust `record_string_view`: a read view fact from the binding into its owner.
sema_string_view_record_binding: fn(state: &SemaOwnershipState, name: String, name_span: Span, places: [SemaOwnershipPlace], scopes: SemaScopeTable) -> Bool Never! {
    fact := SemaOwnershipCallViewFact{output_path: [String]{}, access: AccessConvention.Read, places: places}
    sema_ownership_record_call_view_batch(state, name, name_span, [SemaOwnershipCallViewFact]{fact}, scopes)
}

sema_string_view_binding: fn(scopes: SemaScopeTable, name: String) -> Bool Never! {
    index: sema_scope_resolve_index(scopes, name) ?? return false
    scopes.bindings[index].string_view
}

// `.trim()`/`.after()`/`.before()` take the view as the `&str` it is.
sema_string_view_exempt_receiver: fn(receiver: Expr, method: String, scopes: SemaScopeTable) -> Bool Never! {
    if method != "trim" && method != "after" && method != "before" -> return false
    if receiver == {
        .Ident(name, _, _) -> sema_string_view_binding(scopes, name)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

sema_string_view_owner: fn(scopes: SemaScopeTable, state: SemaOwnershipState, name: String) -> String Never! {
    index: sema_scope_resolve_index(scopes, name) ?? return "its owner"
    key: scopes.bindings[index].symbol.id.key
    owner := "its owner"
    loop fact_index in 0..<state.views.len() {
        if state.views[fact_index].active && state.views[fact_index].carrier_key == key -> owner = state.views[fact_index].source.root
    }
    owner
}

// Rust `report_string_view_unsupported_use`.
sema_string_view_unsupported_use: fn(name: String, what: String, span: Span, scopes: SemaScopeTable, state: SemaOwnershipState, diagnostics: &[Diagnostic]) {
    owner: sema_string_view_owner(scopes, state, name)
    diagnostic: sema_error("E2307", span, "`{name}` cannot {what} without an owning copy", "`{name}` is a zero-copy view into `{owner}` (`.trim()`/`.after()`/`.before()`); this destination needs an owned `String`, and `copies: .Explicit` keeps the implicit materialization disabled", "write `{name}.copy()` first, or remove `copies: .Explicit` to use the default owning copy")
    diagnostics.push(diagnostic_with_edit_grade(diagnostic, TextEdit{span: Span{start: span.end, end: span.end}, new_text: ".copy()"}, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving))
}

// Under `copies: .Explicit`, a bare string-view read outside the positions
// that take a view (`.copy()`, interpolation, a view method receiver, an implicit
// owning copy) is the one refusal for every owning destination.
sema_string_view_check_read: fn(name: String, span: Span, scopes: SemaScopeTable, state: SemaOwnershipState, context: SemaCheckContext, diagnostics: &[Diagnostic]) {
    if !scopes.copies_explicit || context.allow_string_view_read || !sema_string_view_binding(scopes, name) -> return
    sema_string_view_unsupported_use(name, "be used directly here", span, scopes, state, diagnostics)
}

// A string view, or a read view local, read at an owning
// destination is materialized into an owned copy (Rust `insert_implicit_copy`).
sema_string_view_materialize: fn(name: String, span: Span, expected: Type?, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    previous_borrow := context.borrow_ctx
    previous_read := context.allow_string_view_read
    context.borrow_ctx = true
    context.allow_string_view_read = true
    checked_value := sema_expr_check_identifier(name, span, None, environment, program, scopes, state, context, diagnostics)
    context.borrow_ctx = previous_borrow
    context.allow_string_view_read = previous_read
    checked: checked_value ?? return None
    facts := sema_copy_classify(checked.ty, SemaCopyIntent.Materialize, environment, program, context.generic_params, true)
    if !facts.accepted -> return sema_expr_expected(checked, expected, environment, program, diagnostics)
    if sema_copy_effect_name(facts) != None || sema_copy_memory_operation(facts) != None -> context.copy_events.push(SemaCopyEvent{span: span, facts: facts})
    sema_expr_expected_owned(sema_tree_node(facts.target, TExprKind.MaterializeView{value: checked}, span), expected, environment, program, diagnostics)
}

// The owning `String` destinations that materialize a string view.
sema_string_view_owning_read: fn(value: Expr, destination: Type, scopes: SemaScopeTable) -> Bool Never! {
    if scopes.copies_explicit || sema_expr_unwrap_tag(destination) != Type.String -> return false
    if value == {
        .Ident(name, _, _) -> sema_string_view_binding(scopes, name)
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> false
    }
}

// Rust `infer` with `implicit_copy_target`: outside a borrow position and
// under the default copy policy, a `View<T>` local read where exactly its
// owned type (`owned_type_for_read_view`: `[T]`, or `String` for
// `View<str>`) is expected is an owning read.
sema_read_view_owning_read: fn(name: String, destination: Type, scopes: SemaScopeTable, context: SemaCheckContext) -> Bool Never! {
    if scopes.copies_explicit || context.borrow_ctx -> return false
    symbol: sema_scope_resolve(scopes, name) ?? return false
    source: symbol.ty ?? return false
    owned: sema_copy_owned_view_type(source, false)
    owned.materialized && type_identity_equal(owned.ty, destination)
}

// Rust `named_view_has_stable_owner`: the view's owner is a parameter (the
// receiver included) or a module-level value, so it outlives the function.
sema_string_view_stable_owner: fn(scopes: SemaScopeTable, state: SemaOwnershipState, name: String) -> Bool Never! {
    index: sema_scope_resolve_index(scopes, name) ?? return false
    key: scopes.bindings[index].symbol.id.key
    loop fact_index in 0..<state.views.len() {
        if !state.views[fact_index].active || state.views[fact_index].carrier_key != key -> next
        owner: sema_scope_resolve(scopes, state.views[fact_index].source.root) ?? return false
        return owner.kind == SymbolKind.Parameter || owner.kind == SymbolKind.Constant
    }
    false
}

// #1163/#1164: a declared `View<str>` struct field takes a live string view
// with a stable owner, or a `trim`/`after`/`before` call on a `String` name.
// An owned `String` is not a view (Rust `report_owned_string_as_view_str`).
sema_string_view_check_field: fn(value: Expr, field_ty: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    previous_read := context.allow_string_view_read
    context.allow_string_view_read = true
    checked_value := sema_check_expression_with_lambda_escapes(value, None, environment, program, scopes, state, tail_store, context, Val(true), diagnostics)
    context.allow_string_view_read = previous_read
    checked: checked_value ?? return None
    if checked.ty != Type.String -> return Val(checked)
    span: expr_span(value)
    view_name := ""
    if value == .Ident(name, _, _) {
        if sema_string_view_binding(scopes, name) -> view_name = name
    }
    if view_name != "" {
        // The refusal does not end the check: the field still holds the
        // view, so the enclosing return or binding judges its owner too.
        if !sema_string_view_stable_owner(scopes, state, view_name) -> sema_string_view_unsupported_use(view_name, "be stored in a struct field", span, scopes, state, diagnostics)
        viewed := checked
        tree_expr_retype(viewed, field_ty)
        return Val(viewed)
    }
    if sema_string_view_call_sources(value, scopes, state).len() > 0 -> return sema_string_view_lower_init(checked)
    diagnostics.push(sema_error("E2307", span, "an owned `String` cannot fill a `View<str>` slot", "`View<str>` needs a zero-copy window from `.trim()` / `.after()` / `.before()` (or an already-tracked string-view binding); a plain `String` place owns its buffer instead", "bind a window with `.trim()`/`.after()`/`.before()`, return a `View` of the owning element and read the field through it, or store an owned `String` field and copy with `.copy()`"))
    None
}

sema_string_view_return_boundary: fn(span: Span, diagnostics: &[Diagnostic]) {
    diagnostics.push(sema_error("E2307", span, "returned string views need a stable owner relationship", "each public `View<str>` slot must name a bounded set of receiver, parameter, or static `String` sources that stay live; this return did not prove those sources", "return a view derived from parameters or the receiver on every path, or return an owned `String` copy with `.copy()`"))
}

// Rust `string_view_return`: a `View<str>` return reads a string-view
// binding, or a `trim`/`after`/`before` call on a `String` name, as the
// view itself.
sema_string_view_return_source: fn(value: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState) -> Bool {
    if value == .Ident(name, _, _) {
        if sema_string_view_binding(scopes, name) -> return true
    }
    sema_string_view_call_sources(value, scopes, state).len() > 0
}

sema_string_view_return_value: fn(value: Expr, success: Type, environment: SemaScopeEnvironment, program: SemaProgramTables, scopes: &SemaScopeTable, state: &SemaOwnershipState, tail_store: &SemaStatementTailStore, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> TExpr? {
    previous_read := context.allow_string_view_read
    context.allow_string_view_read = true
    checked_value := sema_check_expression(value, None, environment, program, scopes, state, tail_store, context, diagnostics)
    context.allow_string_view_read = previous_read
    checked: checked_value ?? return None
    if checked.ty != Type.String -> return Val(checked)
    lowered := sema_string_view_lower_init(checked)
    if lowered != None -> return lowered
    viewed := checked
    tree_expr_retype(viewed, success)
    Val(viewed)
}

// Rust `check_named_string_view_binding_return` and the `View<str>` arm of
// the return check: every source of the returned view must be a parameter
// (the receiver included); the sources join the return provenance.
sema_string_view_record_return: fn(value: Expr, scopes: SemaScopeTable, state: &SemaOwnershipState, context: &SemaCheckContext, diagnostics: &[Diagnostic]) -> Bool {
    span: expr_span(value)
    places := [SemaOwnershipPlace]{}
    if value == .Ident(name, name_span, _) {
        if !sema_string_view_binding(scopes, name) {
            sema_string_view_return_boundary(span, diagnostics)
            return false
        }
        index: sema_scope_resolve_index(scopes, name) ?? return false
        key: scopes.bindings[index].symbol.id.key
        loop fact in state.views {
            if fact.active && fact.carrier_key == key -> places.push(fact.source)
        }
        loop place in places {
            owner: sema_scope_resolve(scopes, place.root) ?? return false
            if owner.kind != SymbolKind.Parameter {
                sema_string_view_unsupported_use(name, "be returned", name_span, scopes, state, diagnostics)
                return false
            }
        }
    } else {
        places = sema_string_view_call_sources(value, scopes, state)
    }
    if places.len() == 0 {
        sema_string_view_return_boundary(span, diagnostics)
        return false
    }
    provenance := context.return_view_provenance ?? ViewProvenanceMap{entries: [ViewProvenanceEntry]{}}
    valid := sema_ownership_record_view_returns(state, places, AccessConvention.Read, [String]{}, context.return_view_receiver_key, context.return_view_parameter_keys, scopes, provenance, span, diagnostics)
    context.return_view_provenance = Val(provenance)
    valid
}
