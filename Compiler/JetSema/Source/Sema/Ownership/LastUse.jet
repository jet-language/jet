// Canonical statement-tail query for consuming ownership decisions.
// The tail store and context frames are populated by sema_check_statements;
// this module only reads those existing frames and the source AST.
use jet_foundation.[
    EnumLitArg,
    Expr,
    LValue,
    Pattern,
    PatSlot,
    Stmt,
]

fn sema_ownership_last_use_expr(expr: Expr, name: String) -> Bool {
    if expr == {
        .Ident(candidate, _) -> return candidate == name
        .Call(call) -> {
            if call.name == name -> return true
            loop index in 0..<call.args.len() {
                if sema_ownership_last_use_expr(call.args[index].expr, name) -> return true
            }
        }
        .CallValue(callee, args, _) -> {
            if sema_ownership_last_use_expr(callee, name) -> return true
            loop index in 0..<args.len() {
                if sema_ownership_last_use_expr(args[index].expr, name) -> return true
            }
        }
        .MethodCall(receiver, _, _, _, _, args, _, _, _, _, _) | .OptMethodCall(receiver, _, _, _, args, _) -> {
            if sema_ownership_last_use_expr(receiver, name) -> return true
            loop index in 0..<args.len() {
                if sema_ownership_last_use_expr(args[index].expr, name) -> return true
            }
        }
        .Unary(_, operand, _) | .Deref(operand, _) | .RawOf(operand, _) | .Copy(operand, _) | .Place(operand, _, _) | .Field(operand, _, _) | .OptField(operand, _, _, _, _) | .Tainted(operand, _, _) | .Present(operand, _) | .Paren(operand, _) | .Spread(operand, _) -> return sema_ownership_last_use_expr(operand, name)
        .PtrFromAddr(_, _, _, addr, _) -> return sema_ownership_last_use_expr(addr, name)
        .Binary(_, left, right, _) -> return sema_ownership_last_use_expr(left, name) || sema_ownership_last_use_expr(right, name)
        .CompareChain(operands, _, _, _) -> {
            loop index in 0..<operands.len() {
                if sema_ownership_last_use_expr(operands[index], name) -> return true
            }
        }
        .Try(value, _, _, context) -> {
            if sema_ownership_last_use_expr(value, name) -> return true
            if context != None -> return sema_ownership_last_use_expr(context, name)
        }
        .MemberSpread(base, _, _) -> return sema_ownership_last_use_expr(base, name)
        .Index(base, index, _, _) -> return sema_ownership_last_use_expr(base, name) || sema_ownership_last_use_expr(index, name)
        .Slice(base, start, end, range, _) -> {
            if sema_ownership_last_use_expr(base, name) || sema_ownership_last_use_expr(start, name) || sema_ownership_last_use_expr(end, name) -> return true
            if range != None -> return sema_ownership_last_use_expr(range, name)
        }
        .Range(start, end, _, _) -> return sema_ownership_last_use_expr(start, name) || sema_ownership_last_use_expr(end, name)
        .ListLit(elements, _) -> {
            loop index in 0..<elements.len() {
                if sema_ownership_last_use_expr(elements[index], name) -> return true
            }
        }
        .MapLit(entries, _) -> {
            loop index in 0..<entries.len() {
                if sema_ownership_last_use_expr(entries[index].key, name) || sema_ownership_last_use_expr(entries[index].value, name) -> return true
            }
        }
        .TupleLit(fields, _, _) -> {
            loop index in 0..<fields.len() {
                if sema_ownership_last_use_expr(fields[index].value, name) -> return true
            }
        }
        .StructLit(_, _, _, _, fields, _, _) -> {
            loop index in 0..<fields.len() {
                if sema_ownership_last_use_expr(fields[index].value, name) -> return true
            }
        }
        .TypedLit(_, body, _) -> {
            if body == {
                .Fields(fields) -> loop index in 0..<fields.len() { if sema_ownership_last_use_expr(fields[index].value, name) -> return true }
                .Elements(elements) -> loop index in 0..<elements.len() { if sema_ownership_last_use_expr(elements[index], name) -> return true }
                .Entries(entries) -> loop index in 0..<entries.len() { if sema_ownership_last_use_expr(entries[index].key, name) || sema_ownership_last_use_expr(entries[index].value, name) -> return true }
                .Value(value) -> return sema_ownership_last_use_expr(value, name)
                else -> {}
            }
        }
        .EnumLit(_, _, _, args, _, _) -> {
            loop index in 0..<args.len() {
                if sema_ownership_last_use_enum_arg(args[index], name) -> return true
            }
        }
        .PatternTest(subject, pattern, _) -> {
            if sema_ownership_last_use_expr(subject, name) -> return true
            if sema_ownership_last_use_pattern(pattern, name) -> return true
        }
        .Ok(value, _) | .Err(value, _) -> return sema_ownership_last_use_expr(value, name)
        .OrFallback(value, fallback, _, _) -> {
            if sema_ownership_last_use_expr(value, name) -> return true
            if fallback == {
                .Value(fallback_value) -> return sema_ownership_last_use_expr(fallback_value, name)
                .Block(body, fallback_value, _) -> {
                    if sema_ownership_last_use_statements(body, name) -> return true
                    if fallback_value != None -> return sema_ownership_last_use_expr(fallback_value, name)
                }
                .Return(fallback_value, _) -> if fallback_value != None -> return sema_ownership_last_use_expr(fallback_value, name)
                .Panic(_, _) -> {}
                else -> {}
            }
        }
        .If(condition, then_body, then_value, else_body, else_value, _) -> {
            if sema_ownership_last_use_expr(condition, name) || sema_ownership_last_use_statements(then_body, name) || sema_ownership_last_use_expr(then_value, name) -> return true
            return sema_ownership_last_use_statements(else_body, name) || sema_ownership_last_use_expr(else_value, name)
        }
        .Lambda(lambda) -> {
            loop parameter in lambda.params { if parameter.name == name -> return false }
            loop capture in lambda.take_names { if capture.name == name -> return true }
            if lambda.body == {
                .Expr(value) -> return sema_ownership_last_use_expr(value, name)
                .Block(body) -> return sema_ownership_last_use_statements(body, name)
            }
        }
        .Str(parts, _) -> {
            loop index in 0..<parts.len() {
                if parts[index] == .Interp(value, _) {
                    if sema_ownership_last_use_expr(value, name) -> return true
                }
            }
        }
        else -> {}
    }
    false
}

fn sema_ownership_last_use_enum_arg(argument: EnumLitArg, name: String) -> Bool {
    if argument == {
        .Positional(value) -> return sema_ownership_last_use_expr(value, name)
        .Named(_, value) -> return sema_ownership_last_use_expr(value, name)
    }
}

fn sema_ownership_last_use_lvalue(target: LValue, name: String) -> Bool {
    if target == {
        .Local(candidate, _) -> return candidate == name
        .Index(base, index, _, _) -> return sema_ownership_last_use_expr(base, name) || sema_ownership_last_use_expr(index, name)
        .Field(base, _, _) -> return sema_ownership_last_use_expr(base, name)
    }
}

fn sema_ownership_last_use_statement(statement: Stmt, name: String) -> Bool {
    if statement == {
        .Expr(value) | .Yield(value, _) | .DeferClose(value, _) -> return sema_ownership_last_use_expr(value, name)
        .Val(binding) -> return sema_ownership_last_use_expr(binding.init, name)
        .Assign(target, _, _, value) -> return sema_ownership_last_use_lvalue(target, name) || sema_ownership_last_use_expr(value, name)
        .Return(value, _) -> if value != None -> return sema_ownership_last_use_expr(value, name)
        .BreakValue(value, _) | .BreakLabelValue(_, _, value, _) -> return sema_ownership_last_use_expr(value, name)
        .While(condition, body, _, _, _) -> return sema_ownership_last_use_expr(condition, name) || sema_ownership_last_use_statements(body, name)
        .For(_, _, _, kind, body, _, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    if sema_ownership_last_use_expr(start, name) || sema_ownership_last_use_expr(end, name) -> return true
                    if step != None {
                        if sema_ownership_last_use_expr(step, name) -> return true
                    }
                }
                .In(collection, step) -> {
                    if sema_ownership_last_use_expr(collection, name) -> return true
                    if step != None {
                        if sema_ownership_last_use_expr(step, name) -> return true
                    }
                }
            }
            return sema_ownership_last_use_statements(body, name)
        }
        .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
            if sema_ownership_last_use_expr(subject, name) -> return true
            // Arms, fields and statements are read in place by index: a loop
            // element binding copied each one, its nested bodies included.
            loop arm_index in 0..<arms.len() {
                if sema_ownership_last_use_expr(arms[arm_index].cond, name) || sema_ownership_last_use_statements(arms[arm_index].body, name) -> return true
            }
            if else_body != None -> return sema_ownership_last_use_statements(else_body, name)
        }
        .CountedLoop(init, condition, step, body, _, _, _) -> {
            if sema_ownership_last_use_expr(init.init, name) || sema_ownership_last_use_expr(condition, name) -> return true
            if step != None {
                if sema_ownership_last_use_statement(step, name) -> return true
            }
            return sema_ownership_last_use_statements(body, name)
        }
        .Switched(marker, body, _) -> {
            if marker.name == "Off" || marker.name == "DebugOnly" -> return false
            return sema_ownership_last_use_statements(body, name)
        }
        .Loop(body, _, _, _) | .Unsafe(_, _, body, _) | .Impure(_, _, body, _) | .Reactive(body, _) | .Shield(body, _) | .Region(_, _, body, _) | .Policy(_, body, _) | .TaskGroup(_, _, _, body, _) | .Layout(_, _, body, _) | .AuthorityScope(_, _, _, body, _) | .Transact(_, _, body, _, _) | .AssumeDet(_, _, body, _) | .ComptimeBlock(body, _, _) | .Live(body, _) -> return sema_ownership_last_use_statements(body, name)
        .ComptimeIf(condition, _, then_body, else_body, _, _) -> {
            if sema_ownership_last_use_expr(condition, name) || sema_ownership_last_use_statements(then_body, name) -> return true
            if else_body != None -> return sema_ownership_last_use_statements(else_body, name)
        }
        .ContextBlock(fields, body, _) -> {
            loop field_index in 0..<fields.len() { if sema_ownership_last_use_expr(fields[field_index].value, name) -> return true }
            return sema_ownership_last_use_statements(body, name)
        }
        .ScopeMember(_, _, _, _, body, _, _, _) -> return sema_ownership_last_use_statements(body, name)
        else -> {}
    }
    false
}

fn sema_ownership_last_use_statements(statements: [Stmt], name: String) -> Bool {
    loop index in 0..<statements.len() {
        if sema_ownership_last_use_statement(statements[index], name) -> return true
    }
    false
}

// Rust: jet-sema CheckerCore/blocks.rs Checker::is_name_live_after (same
// answer: some enclosing tail frame reads `name` at or after its start). The
// last reading statement of each body is computed once per name and reused,
// instead of rewalking every remaining statement on each query.
fn sema_ownership_name_live_after(name: String, tail_store: &SemaStatementTailStore, context: &SemaCheckContext) -> Bool {
    frame_index := context.lambda_statement_tails.len() - 1
    loop frame_index >= 0 {
        body_id :: context.lambda_statement_tails[frame_index].body_id
        if sema_ownership_tail_last_read(&tail_store, body_id, name) >= context.lambda_statement_tails[frame_index].start_index -> return true
        frame_index -= 1
    }
    false
}

fn sema_ownership_tail_last_read(tail_store: &SemaStatementTailStore, body_id: Int, name: String) -> Int Never! {
    if tail_store.bodies[body_id].last_reads.get(name) == .Val(known) -> return known
    // The body is read in place: binding it would copy the whole body.
    index := tail_store.bodies[body_id].statements.len() - 1
    loop index >= 0 {
        if sema_ownership_last_use_statement(tail_store.bodies[body_id].statements[index], name) -> break
        index -= 1
    }
    tail_store.bodies[body_id].last_reads[name] = index
    index
}

fn sema_ownership_last_use_pattern(pattern: Pattern, name: String) -> Bool Never! {
    if pattern == {
        .Struct(fields, _, _, _) -> loop field in fields {
            if field == {
                // Braces keep the table's fallback outside the nested `if`.
                .Value(_, _, value) -> {
                    if sema_ownership_last_use_expr(value, name) -> return true
                }
                .Nested(_, _, nested) -> {
                    if sema_ownership_last_use_pattern(nested, name) -> return true
                }
                else -> {}
            }
        }
        .Variant(_, slots, _, _) | .List(slots, _, _) -> loop slot in slots {
            if sema_ownership_last_use_slot(slot, name) -> return true
        }
        .Map(entries, _, _) -> loop entry in entries {
            if sema_ownership_last_use_expr(entry.key, name) || sema_ownership_last_use_slot(entry.slot, name) -> return true
        }
        .Or(alternatives, _) -> loop alternative in alternatives {
            if sema_ownership_last_use_pattern(alternative, name) -> return true
        }
        .Present(_, _, inner, _) | .Ok(_, _, inner, _) | .Err(_, _, inner, _) -> {
            if inner == .Val(nested) -> return sema_ownership_last_use_pattern(nested, name)
        }
        else -> {}
    }
    false
}

fn sema_ownership_last_use_slot(slot: PatSlot, name: String) -> Bool Never! {
    if slot == {
        .Value(value) -> sema_ownership_last_use_expr(value, name)
        .Nested(pattern) -> sema_ownership_last_use_pattern(pattern, name)
        .Named(_, _, inner) -> sema_ownership_last_use_slot(inner, name)
        else -> false
    }
}
