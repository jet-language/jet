    pub fn interrupt_callback_expr_sendable(self, expr: Expr, ty: Type) -> Bool Never! { self.thread_callback_expr_sendable(expr, ty) }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:5286
    pub fn check_interrupt_callback_expr(self: &Self, expr: Expr, ty: Type) Never! {
        if self.interrupt_callback_depth > 0 { self.check_thread_callback_expr_at(expr, ty, SendCrossing.InterruptCallback) }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:5293
    pub fn check_stream_callback_expr(self: &Self, expr: Expr, ty: Type) Never! { self.check_thread_callback_expr_at(expr, ty, SendCrossing.Kernel) }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:5297
    pub fn sendability_problem(self, ty: Type, closure_taken: Bool) -> SendabilityProblem? Never! { self.send_query(ty, closure_taken, false, false) }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:5308
    pub fn crossing_problem(self, ty: Type, crossing: SendCrossing, closure_taken: Bool) -> SendabilityProblem? Never! {
        strict_callable :: if crossing == { .ParallelWorker | .Kernel | .HttpHandler -> true; else -> false }
        self.send_query(ty, closure_taken, strict_callable, false)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:5323
    fn send_query(self, ty: Type, closure_taken: Bool, strict_callable: Bool, cell_only: Bool) -> SendabilityProblem? Never! {
        seen := NominalWalk.new(NominalQuery.Sendable{strict_callable: strict_callable, cell_only: cell_only}, self.registry)
        problem :: self.sendability_problem_inner(ty, closure_taken, strict_callable, cell_only, &seen)
        seen.finish(problem.is_none())
        problem
    }
}

