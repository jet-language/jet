//RS             "`View<str>` needs a zero-copy window from `.trim()` / `.after()` / `.before()` (or an already-tracked string-view binding); a plain `String` place owns its buffer instead"
//RS                 .to_string(),
//RS             "bind a window with `.trim()`/`.after()`/`.before()`, return a `View` of the owning element and read the field through it, or store an owned `String` field and copy with `~`"
//RS                 .to_string(),
//RS             Some(span),
//RS         ));
//RS     }
//RS 
//RS     // ──────────────────────────────────────────────────────────────────────
//RS     // D-MEM1 stage S5 (2026-07-04): string `view`s — `s.trim()` / `s.after(sep)`
//RS     // / `s.before(sep)` bound to a local name return a zero-copy `&str` window
//RS     // into `s` instead of an owned `String`. Unlike `View<T>` (a distinct Jet
//RS     // type), `String` stays ONE type end to end (D-MEM1 gallery: "one String
//RS     // type") — so the view-ness lives on the *binding* (`Binding::string_view`,
//RS     // set below), not on the value's static type. A read-only view crossing an
//RS     // owning destination is materialized by D-MEM-COPYSEM1; the shared fact
//RS     // graph still reports E2307 for a declared view boundary or when
//RS     // `copies: .Explicit` restores the refusal. Crossing a task boundary is
//RS     // caught separately at the capture-check site (`CheckerInfer/calls.rs`)
//RS     // since a plain `Type::String` carries no view marker for the general
//RS     // sendability check to key off.
//RS     // ──────────────────────────────────────────────────────────────────────
//RS 
//RS     /// If `init` is `s.trim()` / `s.after(sep)` / `s.before(sep)` on a plain
//RS     /// local `String` name, return `s`'s name — but only when `s` is a genuine
//RS     /// local or parameter. Parameters must remain tracked so a `View<str>`
//RS     /// return can publish their stable source provenance.
//RS     pub(crate) fn string_view_call_source(&self, init: &Expr) -> Option<ViewPlace> {
//RS         let Expr::MethodCall {
//RS             receiver,
//RS             method,
//RS             args,
//RS             ..
//RS         } = init
//RS         else {
//RS             return None;
//RS         };
//RS         let arity_ok = match method.as_str() {
//RS             "trim" => args.is_empty(),
//RS             "after" | "before" => args.len() == 1,
//RS             _ => return None,
//RS         };
//RS         if !arity_ok {
//RS             return None;
//RS         }
//RS         let Expr::Ident(name, _) = receiver.as_ref() else {
//RS             return None;
//RS         };
//RS         if self.consts.contains_key(name) {
//RS             return None;
//RS         }
//RS         let Some(info) = self.lookup(name) else {
//RS             return None;
//RS         };
//RS         if !matches!(info.ty, Type::String) {
//RS             return None;
//RS         }
//RS         self.place_from_expr(receiver)
//RS     }
//RS 
//RS     /// Record `name` as a string view into `owner`, declared at the current
//RS     /// scope depth.
//RS     pub(crate) fn record_string_view(&mut self, name: &str, place: ViewPlace, span: Span) {
//RS         self.record_view(
//RS             name,
//RS             Vec::new(),
//RS             place,
//RS             ViewKind::String,
//RS             ViewAccess::Read,
//RS             span,
//RS         );
//RS     }
//RS 
//RS     /// True if `name` is currently a live string-view binding.
//RS     pub(crate) fn is_string_view(&self, name: &str) -> bool {
//RS         self.view_kind(name) == Some(ViewKind::String)
//RS     }
//RS 
//RS     /// E2307: a string view named `name` was used at an owning destination while
//RS     /// `copies: .Explicit` is active. This is the ONE call site for the whole
//RS     /// class of explicit-policy refusals (return, rebind, struct field, call
//RS     /// argument, list/tuple literal element, arbitrary builtin/user method,
//RS     /// …): the general `Expr::Ident` inference arm calls this whenever it reads
//RS     /// a live string-view name outside the direct `&str` positions. `what`
//RS     /// describes the use site.
//RS     pub(crate) fn report_string_view_unsupported_use(
//RS         &mut self,
//RS         name: &str,
//RS         what: &str,
//RS         span: Span,
//RS     ) {
//RS         let owner = crate::Sema::current_view_fact(&self.flow.views, name)
//RS             .map(|fact| fact.place.owner.name.clone())
//RS             .unwrap_or_else(|| "its owner".to_string());
//RS         let source_ty = Type::String;
//RS         let diagnostic = Diagnostic::error(
//RS             "E2307",
//RS             format!("`{}` cannot {} without an owning copy", name, what),
//RS             format!(
//RS                 "`{}` is a zero-copy view into `{}` (`.trim()`/`.after()`/`.before()`); this destination needs an owned `String`, and `copies: .Explicit` keeps the implicit materialization disabled",
//RS                 name, owner
//RS             ),
//RS             format!("write `{}{}` first, or remove `copies: .Explicit` to use the default owning copy", Syntax::SIGIL_COPY, name),
//RS             Some(span),
//RS         );
//RS         self.diags
//RS             .push(self.with_ownership_copy_edit(diagnostic, span, Some(&source_ty)));
//RS     }
//RS 
//RS     // No "fresh call made right in the return" shape exists for string views
//RS     // (unlike `View<T>`, which is type-driven everywhere `.view()` appears):
//RS     // view-ness here lives on the *binding*, set only for `Stmt::Val`, so
//RS     // `return s.after(sep)` written directly (no intermediate binding) always
//RS     // lowers as an ordinary owned `String` — safe, nothing to catch.
//RS 
