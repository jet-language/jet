// Rust ownership checker continuation: view provenance, moves, must-use and retained callbacks.
use jet_foundation.[Type, Expr, Stmt, Span, Diagnostic, TextEdit, FixApplicability, FixSafety, AccessConvention, CallArg, Lambda, VariantPayload, TagMarker, InternalTag, ViewSource, ViewSourcePath, ViewSourceProjection, ViewProvenance, ViewProvenanceMap, TypeRegistry]
use jet_sema.[Checker, ViewAccess, ViewKind, ViewPlace, ViewProjection, ViewOwnerOrigin, NominalWalk, NominalQuery, MoveOrigin, SendCrossing, SendabilityProblem, SendProblemKind, expr_root_ident, type_requires_owned_iteration, type_is_copy, is_task_type, is_one_pass_source, one_pass_materializer, tracks_named_move, lambda_collect_captures, current_view_fact, contains_expiring_secret_loan, l1101_unjoined_task, e0140_unconsumed, core_single_use_type, core_must_use_type]
use jet_syntax as Syntax

impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3537
    pub fn view_leaf_paths(self, ty: Type) -> [([String], ViewAccess)] Never! {
        // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3538
        struct ViewWalk { active: [String:Bool], reaches: [String:Bool] }
        // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3543
        fn is_window(ty: Type) -> ViewAccess? Never! {
            if ty == {
                .Apply(name, _) -> {
                    if name == "View" || name == Syntax.TYPE_VIEW_ITER -> return Val(ViewAccess.Read)
                    if name == "ViewMut" || name == Syntax.TYPE_PIN -> return Val(ViewAccess.Write)
                    None
                }
                .Tagged(.Internal(.AllocatorView), _) -> Val(ViewAccess.Write)
                else -> None
            }
        }
        // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3568
        fn type_reaches_window(checker: Checker, ty: Type, visited: &[String:Bool]) -> Bool Never! {
            if is_window(ty).is_some() -> return true
            if ty == {
                .List(inner) | .FixedList(inner, _) | .Option(inner) | .Tagged(_, inner) -> type_reaches_window(checker, inner, &visited)
                .Tuple(fields) -> fields.any(|(_, field_ty)| type_reaches_window(checker, field_ty, &visited))
                .Result(ok, err) -> type_reaches_window(checker, ok, &visited) || type_reaches_window(checker, err, &visited)
                .Named(name) | .Apply(name, _) -> {
                    if visited.has_key(name) -> return false
                    visited[~name] = true
                    if checker.registry.struct_fields(name) == .Val(fields) -> return fields.any(|(_, _, field_ty)| type_reaches_window(checker, field_ty, &visited))
                    if checker.resolve_enum_variants_cloned(name) == .Val(variants) {
                        loop (_, (_, payload)) in variants {
                            if payload == {
                                .Unit -> {}
                                .Single(inner, _) -> { if type_reaches_window(checker, inner, &visited) -> return true }
                                .Named(fields) -> { if fields.any(|field| type_reaches_window(checker, field.ty, &visited)) -> return true }
                            }
                        }
                    }
                    false
                }
                else -> false
            }
        }
        // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3610
        fn nominal_reaches_window(checker: Checker, ty: Type, name: String, state: &ViewWalk) -> Bool Never! {
            if state.reaches.get(name) == .Val(reaches) -> return reaches
            visited := [String:Bool]{}
            reaches :: type_reaches_window(checker, ty, &visited)
            state.reaches[~name] = reaches
            reaches
        }
        // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3619
        fn walk(checker: Checker, ty: Type, path: &[String], seen: &ViewWalk, out: &[([String], ViewAccess)]) Never! {
            if is_window(ty) == .Val(access) { out.push((~path, access)); return }
            if ty == {
                .List(inner) | .FixedList(inner, _) -> { path.push("[]"); walk(checker, inner, &path, &seen, &out); _ :: path.pop() }
                .Tuple(fields) -> {
                    loop (field, field_ty) in fields { path.push(~field); walk(checker, field_ty, &path, &seen, &out); _ :: path.pop() }
                }
                .Option(inner) | .Tagged(_, inner) -> walk(checker, inner, &path, &seen, &out)
                .Result(ok, err) -> { walk(checker, ok, &path, &seen, &out); walk(checker, err, &path, &seen, &out) }
                .Named(name) | .Apply(name, _) -> {
                    if !nominal_reaches_window(checker, ty, name, &seen) || seen.active.has_key(name) -> return
                    seen.active[~name] = true
                    if checker.registry.struct_fields(name) == .Val(fields) {
                        loop (field, _, field_ty) in fields { path.push(~field); walk(checker, field_ty, &path, &seen, &out); _ :: path.pop() }
                    } else if checker.resolve_enum_variants_cloned(name) == .Val(variants) {
                        order := variants.keys().collect()
                        order.sort()
                        loop variant in order {
                            (_, payload) :: variants[variant]
                            if payload == {
                                .Unit -> {}
                                .Single(inner, _) -> {
                                    path.push(~variant); path.push("0")
                                    walk(checker, inner, &path, &seen, &out)
                                    _ :: path.pop(); _ :: path.pop()
                                }
                                .Named(fields) -> {
                                    loop field in fields {
                                        path.push(~variant); path.push(~field.name)
                                        walk(checker, field.ty, &path, &seen, &out)
                                        _ :: path.pop(); _ :: path.pop()
                                    }
                                }
                            }
                        }
                    }
                    seen.active.remove(name)
                }
                else -> {}
            }
        }
        out := [([String], ViewAccess)]{}
        seen := ViewWalk{active: [:], reaches: [:]}
        path := [String]{}
        walk(self, ty, &path, &seen, &out)
        ^out
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3698
    fn conservative_callback_view_provenance(self, params: [Type], ret: Type) -> ViewProvenanceMap Never! {
        sources := [ViewSourcePath:Bool]{} // GATE #4499: structural source/path key equality.
        loop index in 0..<params.len() {
            if !params[index].is_scalar() { sources[ViewSourcePath{source: ViewSource.Parameter(index), projections: []}] = true }
        }
        result := [[String]:ViewProvenance]{} // GATE #4499: ordered structural path keys.
        loop (output_path, access) in self.view_leaf_paths(ret) {
            result[^output_path] = ViewProvenance{sources: ~sources, mutable: access == ViewAccess.Write}
        }
        ^result
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3726
    fn pattern_variant_slot_names(self, subject: Expr, variant: String, slot_count: Int) -> [String] Never! {
        // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3732
        fn subject_type(checker: Checker, subject: Expr) -> Type? Never! {
            if subject == {
                .Ident(name, _) -> { if checker.lookup(name) == .Val(info) -> Val(~info.ty) else -> None }
                .Copy(inner, _) | .Paren(inner, _) -> subject_type(checker, inner)
                else -> None
            }
        }
        if subject_type(self, subject) == .Val(ty) {
            if ty == .Named(name) || ty == .Apply(name, _) {
                if self.resolve_enum_variants_cloned(name) == .Val(variants) && variants.get(variant) == .Val((_, .Named(fields))) {
                    names := [String]{}
                    loop field in fields { names.push(~field.name) }
                    return ^names
                }
            }
        }
        names := [String]{}
        loop index in 0..<slot_count { names.push(index.to_string()) }
        ^names
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3757
    pub fn transfer_named_view(self: &Self, target: String, source: String, span: Span) -> Bool Never! {
        facts :: self.view_facts(source).cloned().collect()
        if facts.is_empty() -> return false
        loop fact in facts { self.record_view(target, ^fact.output_path, ^fact.place, fact.kind, fact.access, span) }
        true
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3778
    pub fn mutable_view_aggregate_root(self, expr: Expr) -> String? Never! {
        operand :: if expr == { .Place(inner, _, _) | .Paren(inner, _) -> inner; else -> expr }
        if operand != .Field && operand != .Index -> return None
        root :: expr_root_ident(operand) ?? return None
        if self.view_facts(root).any(|fact| fact.access == ViewAccess.Write) -> Val(~root) else -> None
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3793
    pub fn finish_mutable_view_aggregate_transfer(self: &Self, root: String?, span: Span, consumer: String) Never! {
        if root == .Val(name) { self.flow.moved.set(name, MoveOrigin.new(span, ^consumer)); self.clear_origin(name) }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3807
    pub fn transfer_mutable_pattern_subject(self: &Self, subject: Expr) -> Bool Never! {
        if subject != .Ident(name, span) -> return false
        if self.view_facts(name).all(|fact| fact.access == ViewAccess.Read) -> return false
        self.flow.moved.set(name, MoveOrigin.new(span, "the pattern match"))
        self.clear_origin(name)
        true
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3827
    pub fn is_list_view(self, name: String) -> Bool Never! {
        if self.view_kind(name) == .Val(kind) -> kind.is_named_window() else -> false
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3831
    pub fn type_contains_view_boundary(self, ty: Type) -> Bool Never! {
        // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3832
        fn payload_contains(registry: TypeRegistry, payload: VariantPayload, seen: &NominalWalk) -> Bool Never! {
            if payload == {
                .Unit -> false
                .Single(ty, _) -> contains(registry, ty, &seen)
                .Named(fields) -> fields.any(|field| contains(registry, field.ty, &seen))
            }
        }
        // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3846
        fn named_contains(registry: TypeRegistry, name: String, seen: &NominalWalk) -> Bool Never! {
            key :: seen.enter(name, []) ?? return false
            found := false
            if registry.struct_fields(name) == .Val(fields) { found = fields.any(|(_, _, field_ty)| contains(registry, field_ty, &seen)) }
            if !found && registry.enum_variants(name) == .Val(variants) {
                loop (_, (_, payload)) in variants { if payload_contains(registry, payload, &seen) { found = true; break } }
            }
            seen.leave(name, key)
            found
        }
        // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3863
        fn contains(registry: TypeRegistry, ty: Type, seen: &NominalWalk) -> Bool Never! {
            if ty == {
                .Apply(name, args) -> {
                    if (name == "View" || name == "ViewMut" || name == Syntax.TYPE_PIN || name == Syntax.TYPE_VIEW_ITER) && args.len() == 1 -> return true
                    args.any(|arg| contains(registry, arg, &seen)) || named_contains(registry, name, &seen)
                }
                .Tagged(.Internal(.AllocatorView), _) -> true
                .Named(name) -> named_contains(registry, name, &seen)
                .Option(inner) | .List(inner) | .Shared(inner) | .Tagged(_, inner) | .FixedList(inner, _) -> contains(registry, inner, &seen)
                .Result(ok, err) -> contains(registry, ok, &seen) || contains(registry, err, &seen)
                .Map(key, _, value) -> contains(registry, key, &seen) || contains(registry, value, &seen)
                .Tuple(fields) -> fields.any(|(_, field_ty)| contains(registry, field_ty, &seen))
                .Fn -> ty.params.any(|param| contains(registry, param, &seen)) || (if ty.ret == { .Val(ret) -> contains(registry, ret, &seen); else -> false })
                else -> false
            }
        }
        seen := NominalWalk.new(NominalQuery.ViewBoundary, self.registry)
        found :: contains(self.registry, ty, &seen)
        seen.finish(!found)
        found
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3915
    pub fn named_view_has_stable_owner(self, name: String) -> Bool Never! {
        if self.view_fact(name) != .Val(fact) -> return false
        if fact.place.owner.origin == { .Receiver | .Parameter | .Static -> true; else -> false }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3929
    pub fn report_view_owns_return(self: &Self, place: ViewPlace, span: Span) Never! {
        owner :: place.owner.name
        self.diags.push(Diagnostic.error("E2305", "this view points into `{owner}`, which this function owns", "`{owner}` is made here and freed when the function returns, so a read window into it would outlive what owns it — there'd be nothing left to look at", "return an owned copy with `~place` (for example `~value[a..b]`), or accept the source as a parameter so the caller keeps owning it", Val(span)))
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:3949
    pub fn check_named_view_return(self: &Self, place: ViewPlace, access: ViewAccess, output_path: [String], span: Span) Never! {
        source :: if place.owner.origin == {
            .Receiver -> ViewSource.Receiver
            .Parameter(index) -> ViewSource.Parameter(index)
            else -> { self.report_view_owns_return(place, span); return }
        }
        projections := [ViewSourceProjection]{}
        loop projection in place.projections {
            projections.push(if projection == {
                .Field(name) -> ViewSourceProjection.Field(~name)
                .Index -> ViewSourceProjection.Index
                .Range -> ViewSourceProjection.Range
                .Fresh -> { self.report_view_return_boundary(span); return }
            })
        }
        source_path :: ViewSourcePath{source: ^source, projections: ^projections}
        if self.return_view_provenance.is_none() { self.return_view_provenance = Val([[String]:ViewProvenance]{}) }
        if self.return_view_provenance != .Val(map) -> panic("provenance map was just initialized")
        if !map.has_key(output_path) { map[~output_path] = ViewProvenance{sources: [ViewSourcePath:Bool]{}, mutable: access == ViewAccess.Write} }
        provenance := &map[output_path]
        if provenance.mutable != (access == ViewAccess.Write) {
            self.diags.push(Diagnostic.error("E2305", "returned view paths disagree about read or write access", "one public output slot cannot sometimes be a read view and sometimes be an exclusive write view", "return the same view access on every path", Val(span)))
            return
        }
        provenance.sources[^source_path] = true // GATE #4499: structural source keys.
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4004
    pub fn check_named_view_binding_return(self: &Self, name: String, span: Span) Never! {
        facts :: self.view_facts(name).cloned().collect()
        if facts.is_empty() { self.report_view_return_boundary(span); return }
        loop fact in facts { self.check_named_view_return(fact.place, fact.access, ^fact.output_path, span) }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4015
    pub fn check_named_string_view_binding_return(self: &Self, name: String, span: Span) Never! {
        facts :: self.view_facts(name).cloned().collect()
        if facts.is_empty() { self.report_string_view_boundary(span); return }
        loop fact in facts {
            if fact.place.owner.origin != .Receiver && fact.place.owner.origin != .Parameter { self.report_string_view_unsupported_use(name, "be returned", span); return }
            self.check_named_view_return(fact.place, fact.access, ^fact.output_path, span)
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4033
    pub fn check_aggregate_view_return(self: &Self, expr: Expr) Never! {
        // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4034
        fn walk(checker: &Checker, expr: Expr, path: &[String]) Never! {
            if expr == {
                .StructLit -> { loop (field, _, value) in expr.fields { path.push(~field); walk(&checker, value, &path); _ :: path.pop() } }
                .TypedLit -> expr.body.for_each_expr(|value| walk(&checker, value, &path))
                .TupleLit(fields, _) -> { loop (field, value) in fields { path.push(~field); walk(&checker, value, &path); _ :: path.pop() } }
                .ListLit(elements, _) -> { path.push("[]"); loop value in elements { walk(&checker, value, &path) }; _ :: path.pop() }
                .EnumLit -> {
                    path.push(~expr.variant)
                    loop index in 0..<expr.args.len() {
                        arg :: expr.args[index]
                        if arg == {
                            .Positional(value) -> { path.push(index.to_string()); walk(&checker, value, &path); _ :: path.pop() }
                            .Named -> { path.push(~arg.label); walk(&checker, arg.expr, &path); _ :: path.pop() }
                        }
                    }
                    _ :: path.pop()
                }
                .Present(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Paren(inner, _) -> walk(&checker, inner, &path)
                .Ident(name, span) -> {
                    facts :: checker.view_facts(name).cloned().collect()
                    loop fact in facts {
                        output_path := ~path
                        output_path.extend(^fact.output_path)
                        checker.check_named_view_return(fact.place, fact.access, ^output_path, span)
                    }
                }
                else -> {
                    loop (suffix, place, _, access) in checker.view_call_sources(expr) {
                        output_path := ~path
                        output_path.extend(^suffix)
                        checker.check_named_view_return(place, access, ^output_path, expr.span())
                    }
                }
            }
        }
        path := [String]{}
        walk(&self, expr, &path)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4102
    pub fn report_view_return_boundary(self: &Self, span: Span) Never! {
        self.diags.push(Diagnostic.error("E2305", "returned views need a stable owner relationship", "each public `View`/`ViewMut` slot must name a bounded set of receiver, parameter, or static sources that stay live; this return did not prove those sources", "return a view derived from parameters or the receiver on every path, keep the view local, or return an owned copy with `~`", Val(span)))
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4114
    pub fn report_string_view_boundary(self: &Self, span: Span) Never! {
        self.diags.push(Diagnostic.error("E2307", "returned string views need a stable owner relationship", "each public `View<str>` slot must name a bounded set of receiver, parameter, or static `String` sources that stay live; this return did not prove those sources", "return a view derived from parameters or the receiver on every path, or return an owned `String` copy with `~`", Val(span)))
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4129
    pub fn report_owned_string_as_view_str(self: &Self, span: Span) Never! {
        self.diags.push(Diagnostic.error("E2307", "an owned `String` cannot fill a `View<str>` slot", "`View<str>` needs a zero-copy window from `.trim()` / `.after()` / `.before()` (or an already-tracked string-view binding); a plain `String` place owns its buffer instead", "bind a window with `.trim()`/`.after()`/`.before()`, return a `View` of the owning element and read the field through it, or store an owned `String` field and copy with `~`", Val(span)))
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4160
    pub fn string_view_call_source(self, init: Expr) -> ViewPlace? Never! {
        if init != .MethodCall -> return None
        arity_ok :: if init.method == { "trim" -> init.args.is_empty(); "after" | "before" -> init.args.len() == 1; else -> return None }
        if !arity_ok -> return None
        if init.receiver != .Ident(name, _) -> return None
        if self.consts.has_key(name) -> return None
        info :: self.lookup(name) ?? return None
        if info.ty != Type.String -> return None
        self.place_from_expr(init.receiver)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4195
    pub fn record_string_view(self: &Self, name: String, place: ViewPlace, span: Span) Never! {
        self.record_view(name, [], ^place, ViewKind.String, ViewAccess.Read, span)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4207
    pub fn is_string_view(self, name: String) -> Bool Never! { self.view_kind(name) == Val(ViewKind.String) }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4218
    pub fn report_string_view_unsupported_use(self: &Self, name: String, what: String, span: Span) Never! {
        owner :: if current_view_fact(self.flow.views, name) == .Val(fact) { ~fact.place.owner.name } else { "its owner" }
        diagnostic :: Diagnostic.error("E2307", "`{name}` cannot {what} without an owning copy", "`{name}` is a zero-copy view into `{owner}` (`.trim()`/`.after()`/`.before()`); this destination needs an owned `String`, and `copies: .Explicit` keeps the implicit materialization disabled", "write `{Syntax.SIGIL_COPY}{name}` first, or remove `copies: .Explicit` to use the default owning copy", Val(span))
        self.diags.push(self.with_ownership_copy_edit(^diagnostic, span, Val(Type.String)))
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4255
    pub fn type_is_single_use(self, ty: Type) -> Bool Never! {
        if type_requires_owned_iteration(ty) -> return true
        name :: ty.base_name() ?? return false
        if core_single_use_type(name) || self.registry.is_single_use(name) -> return true
        if self.modules == .Val(mods) {
            loop (_, idx) in self.imports { if self.type_is_pub_in(idx, name) && mods[idx].registry.is_single_use(name) -> return true }
        }
        false
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4280
    pub fn type_is_must_use(self, ty: Type) -> Bool Never! {
        name :: ty.base_name() ?? return false
        if core_must_use_type(name) || self.registry.is_must_use(name) -> return true
        if self.modules == .Val(mods) {
            loop (_, idx) in self.imports { if self.type_is_pub_in(idx, name) && mods[idx].registry.is_must_use(name) -> return true }
        }
        false
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4302
    pub fn ignored_must_use_call_target(self, expr: Expr) -> String? Never! {
        if expr == .Call(call) && self.funcs.get(call.name) == .Val(sig) && sig.is_must_use -> return Val(~call.name)
        if expr == .MethodCall && self.receiver_type_name(expr.receiver) == .Val(type_name) && self.method_is_must_use(type_name, expr.method) -> return Val("{type_name}.{expr.method}")
        None
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4321
    fn receiver_type_name(self, receiver: Expr) -> String? Never! {
        if receiver != .Ident(name, _) -> return None
        info :: self.lookup(name) ?? return None
        base :: info.ty.base_name() ?? return None
        Val(~base)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4330
    fn method_is_must_use(self, type_name: String, method: String) -> Bool Never! {
        if self.registry.method(type_name, method) == .Val(m) && m.must_use -> return true
        if self.modules == .Val(mods) {
            loop (_, idx) in self.imports {
                if self.type_is_pub_in(idx, type_name) && mods[idx].registry.method(type_name, method) == .Val(m) && m.must_use -> return true
            }
        }
        false
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:4354
    pub fn check_ignored_must_use(self: &Self, expr: Expr, ty: Type, span: Span, call_target: String?) Never! {
        if self.suppress_must_use || is_task_type(ty) -> return
        target := call_target ?? self.ignored_must_use_call_target(expr)
        if target.is_none() {
            if ty == .Named(n) && n == "Unit" -> return
            if !self.type_is_must_use(ty) -> return
            target = Val(ty.name())
        }
        name :: target.expect("must-use target was resolved")
        self.diags.push(Diagnostic.error("E0419", "`{name}` must be used — it was dropped as a bare statement", "a `#MustUse` result carries work or a resource that is lost when nothing checks it", "bind it (`x := …`), use `{Syntax.OP_TRY_SUFFIX}`, `{Syntax.BUILTIN_PANIC} …`, or `.drop(\"reason\")` to discard intentionally", Val(span)))
    }

