// A range write window has a fixed length, so it may fill a
// list write parameter only when the callee keeps that list's length.
//
// sema_fixed_length_write_params returns a key `function#parameter` for every
// list write parameter proven length-preserving: the body never resizes or
// reassigns it and passes it onward only to write parameters that are proven
// themselves. Calls are written plain, so the scan reads
// the callee's signature: a declared function's read parameter cannot resize
// the list, its write parameter is an onward edge. A list method the collection
// rows do not name as a read or a length-preserving write, and any method that
// receives the parameter as an argument, counts as resizing. This is a greatest
// fixed point, so recursion that never resizes stays proven.
use jet_foundation.[
    AccessConvention,
    COLLECTION_OPERATIONS,
    CallArg,
    CollectionAccess,
    CollectionReceivers,
    CollectionStatus,
    Expr,
    Func,
    Item,
    PlaceAccess,
    Stmt,
]

SemaWindowEdge: struct {
    callee: String
    index: Int
}

SemaWindowScan: struct {
    resizes: Bool
    onward: [SemaWindowEdge]
}

SemaWindowCandidate: struct {
    key: String
    onward: [String]
}

// One declared function's name, parameter names and which parameters write,
// in bundle order: all the census and onward-edge keys read, so no function
// (body included) is copied.
SemaWindowFunctionRow: struct {
    name: String
    params: [String]
    writes: [Bool]
}

// The proven-set key of the callee parameter an onward pass reaches. Calls
// name a function by its plain name, optionally module-qualified; a name
// declared more than once in the bundle is ambiguous and is never proven. A
// parameter every declaration of the name reads cannot resize the list: no
// key (`""`). A callee the bundle does not declare (a built-in such as
// `print`) takes no write parameter, so it reads the list too.
sema_window_edge_key: fn(rows: [SemaWindowFunctionRow], positions: [String:[Int]], edge: SemaWindowEdge) -> String Never! {
    name: sema_window_plain_name(edge.callee)
    found: positions.get(name) ?? return ""
    writer := -1
    loop index in found {
        if edge.index < rows[index].writes.len() && rows[index].writes[edge.index] && writer < 0 -> writer = index
    }
    if writer < 0 -> return ""
    if found.len() > 1 -> return "#unknown"
    sema_window_param_key(rows[writer].name, rows[writer].params[edge.index])
}

sema_window_param_key: fn(function: String, param: String) -> String Never! {
    "{function}#{param}"
}

// The plain function name a possibly module-qualified callee spelling names.
sema_window_plain_name: fn(callee: String) -> String Never! {
    parts: callee.split(".").to_list()
    if parts.len() > 0 -> parts[parts.len() - 1] else -> callee
}

// The proven-set key a call site checks for parameter `param` of `callee`.
sema_window_callee_key: fn(callee: String, param: String) -> String Never! {
    sema_window_param_key(sema_window_plain_name(callee), param)
}

sema_window_collect_rows: fn(items: [Item], rows: &[SemaWindowFunctionRow]) {
    loop item in items {
        if item == {
            .Func(func) -> rows.push(SemaWindowFunctionRow{name: func.name, params: loop param in func.params -> param.name, writes: loop param in func.params -> param.convention == AccessConvention.Write})
            .CodeModule(definition) -> {
                if definition.body == .Val(body) -> sema_window_collect_rows(body, rows)
            }
            .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

// The candidates of every function in `items`, in the order
// sema_window_collect_rows lists them; each body is scanned in place.
sema_window_collect_candidates: fn(items: [Item], rows: [SemaWindowFunctionRow], positions: [String:[Int]], candidates: &[SemaWindowCandidate]) {
    loop item in items {
        if item == {
            .Func(func) -> sema_window_function_candidates(func, rows, positions, candidates)
            .CodeModule(definition) -> {
                if definition.body == .Val(body) -> sema_window_collect_candidates(body, rows, positions, candidates)
            }
            .Struct(_) | .Enum(_) | .Distinct(_) | .TypeAlias(_) | .UnitFamily(_) | .Trait(_) | .Tag(_) | .EffectDecl(_) | .Impl(_) | .Const(_) | .Test(_) | .ExternRust(_) | .Module(_) | .CModule(_) | .ErrorConv(_) | .Migration(_) | .ProtocolDecl(_) | .TemplateLoop(_) | .GenericModule(_) | .ModuleAlias(_) | .MarkerDecl(_) | .FactDecl(_) -> {}
        }
    }
}

// Name -> declaration positions in bundle order: one census answers both the
// ambiguity count and every onward-edge lookup. The (name, position) pairs
// are sorted once and each name set once, in key order: a Map is a sorted
// list that every out-of-order insert shifts.
sema_window_positions: fn(rows: [SemaWindowFunctionRow]) -> [String:[Int]] Never! {
    order := loop (index, row) in rows -> (name: row.name, index: index)
    order.sort_by((left: (name: String, index: Int), right: (name: String, index: Int)) -> (left.name <=> right.name).then(left.index <=> right.index))
    positions := [String:[Int]]{}
    start := 0
    loop start < order.len() {
        stop := start + 1
        loop stop < order.len() && order[stop].name == order[start].name -> stop += 1
        positions[order[start].name] = loop position in start..<stop -> order[position].index
        start = stop
    }
    positions
}

// `items` holds every module of the bundle, so the fact covers calls into
// other modules, inline or file, exactly like the Rust bundle-wide fact.
sema_fixed_length_write_params: fn(items: [Item]) -> [String] Never! {
    rows := [SemaWindowFunctionRow]{}
    sema_window_collect_rows(items, rows)
    positions: sema_window_positions(rows)
    candidates := [SemaWindowCandidate]{}
    sema_window_collect_candidates(items, rows, positions, candidates)
    sema_window_fixed_length_params(candidates)
}

// The same bundle-wide fact over every module of `graph`, in module order:
// each module's items are read in place rather than first copied into one
// bundle list.
sema_fixed_length_write_params_in_graph: fn(graph: SemaRegistrationGraph) -> [String] Never! {
    rows := [SemaWindowFunctionRow]{}
    loop module_index in 0..<graph.modules.len() -> sema_window_collect_rows(graph.modules[module_index].program.items, rows)
    positions: sema_window_positions(rows)
    candidates := [SemaWindowCandidate]{}
    loop module_index in 0..<graph.modules.len() -> sema_window_collect_candidates(graph.modules[module_index].program.items, rows, positions, candidates)
    sema_window_fixed_length_params(candidates)
}

sema_window_function_candidates: fn(func: Func, rows: [SemaWindowFunctionRow], positions: [String:[Int]], candidates: &[SemaWindowCandidate]) {
    if (positions.get(func.name) ?? [Int]{}).len() > 1 -> return
    loop param_index in 0..<func.params.len() {
        if func.params[param_index].convention != AccessConvention.Write -> next
        is_list := if func.params[param_index].ty == {
            .List(_) -> true
            .Int | .Float | .Bool | .String | .Char | .Map(_, _, _) | .Shared(_) | .Option(_) | .Result(_, _) | .Fn(_, _, _, _, _, _) | .Named(_) | .Apply(_, _) | .TraitObject(_) | .Tuple(_) | .FixedList(_, _) | .IntN(_, _) | .InlineRange(_, _, _) | .Float32 | .Tagged(_, _) | .Union(_) | .Quantity(_, _) | .Measure(_) -> false
        }
        if !is_list -> next
        scan := SemaWindowScan{resizes: false, onward: [SemaWindowEdge]{}}
        sema_window_scan_body(func.body, func.params[param_index].name, scan)
        if scan.resizes -> next
        onward := [String]{}
        loop edge in scan.onward {
            key: sema_window_edge_key(rows, positions, edge)
            if key != "" -> onward.push(key)
        }
        candidates.push(SemaWindowCandidate{key: sema_window_param_key(func.name, func.params[param_index].name), onward: onward})
    }
}

sema_window_fixed_length_params: fn(candidates: [SemaWindowCandidate]) -> [String] Never! {
    // Greatest fixed point by worklist: a candidate falls once an onward
    // target is not proven, and each fall revisits only the candidates that
    // pass onward to it, instead of rechecking every candidate per round.
    slots := [String:Int]{}
    loop (index, candidate) in candidates {
        if slots.get(candidate.key) == None -> slots[candidate.key] = index
    }
    proven := (loop _ in candidates -> true)
    dependents := (loop _ in candidates -> [Int]{})
    pending := [Int]{}
    loop (index, candidate) in candidates {
        loop target in candidate.onward {
            if slots.get(target) == .Val(slot) {
                dependents[slot].push(index)
            } else if proven[index] {
                proven[index] = false
                pending.push(index)
            }
        }
    }
    loop pending.len() > 0 {
        fallen: pending.pop() ?? break
        loop dependent in dependents[fallen] {
            if proven[dependent] {
                proven[dependent] = false
                pending.push(dependent)
            }
        }
    }
    result := [String]{}
    loop (index, candidate) in candidates {
        if proven[index] -> result.push(candidate.key)
    }
    result
}

sema_window_contains: fn(keys: [String], key: String) -> Bool Never! {
    loop candidate in keys {
        if candidate == key -> return true
    }
    false
}

// Length-preserving list methods edit elements in place and keep the length.
sema_window_length_preserving_method: fn(method: String) -> Bool Never! {
    method == "sort" || method == "sort_desc" || method == "sort_by" || method == "sort_by_key" || method == "reverse" || method == "swap" || method == "fill" || method == "shuffle" || method == "rotate_left" || method == "rotate_right"
}

// A plain method call on the list parameter: the collection rows name the
// list methods that only read it; a length-preserving write keeps its length,
// and any other method (a resizing write, a move, or a method the rows do not
// name) may resize it.
sema_window_method_may_resize: fn(method: String) -> Bool Never! {
    if method == "copy" || sema_window_length_preserving_method(method) -> return false
    loop row in COLLECTION_OPERATIONS {
        if row.name == method && row.status != CollectionStatus.Proposed && (row.receivers == CollectionReceivers.List || row.receivers == CollectionReceivers.Sequence) {
            return row.access == CollectionAccess.Write || row.access == CollectionAccess.Move
        }
    }
    true
}

sema_window_is_param: fn(expr: Expr, param: String) -> Bool Never! {
    if expr == {
        .Paren(inner, _, _) -> return sema_window_is_param(inner, param)
        .Ident(name, _, _) -> return name == param
        .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .EnumLit(_, _, _, _, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .Pipe(_, _, _, _) | .TypeValue(_, _, _) -> return false
    }
}

sema_window_scan_args: fn(args: [CallArg], param: String, scan: &SemaWindowScan) {
    loop arg in args -> sema_window_scan_expr(arg.expr, param, scan)
}

// A method that receives the whole parameter: the fact cannot read a method's
// signature, so the method may write the list and resize it.
sema_window_args_pass_param: fn(args: [CallArg], param: String) -> Bool Never! {
    loop arg in args {
        if sema_window_is_param(arg.expr, param) -> return true
    }
    false
}

sema_window_scan_optional: fn(expr: Expr?, param: String, scan: &SemaWindowScan) {
    if expr == .Val(value) -> sema_window_scan_expr(value, param, scan)
}

sema_window_scan_body: fn(body: [Stmt], param: String, scan: &SemaWindowScan) {
    loop statement in body -> sema_window_scan_statement(statement, param, scan)
}

sema_window_scan_statement: fn(statement: Stmt, param: String, scan: &SemaWindowScan) {
    if statement == {
        .Expr(expr) | .BreakValue(expr, _) | .Yield(expr, _) | .DeferClose(expr, _) -> sema_window_scan_expr(expr, param, scan)
        .Val(binding) -> sema_window_scan_expr(binding.init, param, scan)
        .Assign(target, _, _, value) -> {
            if target == {
                .Local(name, _) -> {
                    if name == param -> scan.resizes = true
                }
                .Index(base, index, _, _) -> {
                    sema_window_scan_expr(base, param, scan)
                    sema_window_scan_expr(index, param, scan)
                }
                .Field(base, _, _) -> sema_window_scan_expr(base, param, scan)
            }
            sema_window_scan_expr(value, param, scan)
        }
        .Return(value, _) -> sema_window_scan_optional(value, param, scan)
        .BreakLabelValue(_, _, value, _) -> sema_window_scan_expr(value, param, scan)
        .While(cond, body, _, _, _) -> {
            sema_window_scan_expr(cond, param, scan)
            sema_window_scan_body(body, param, scan)
        }
        .For(_, _, _, kind, body, _, _, _, _) -> {
            if kind == {
                .Range(start, end, step, _) -> {
                    sema_window_scan_expr(start, param, scan)
                    sema_window_scan_expr(end, param, scan)
                    sema_window_scan_optional(step, param, scan)
                }
                .In(collection, step) -> {
                    sema_window_scan_expr(collection, param, scan)
                    sema_window_scan_optional(step, param, scan)
                }
            }
            sema_window_scan_body(body, param, scan)
        }
        .Switch(subject, arms, else_body, _) | .ComptimeSwitch(subject, arms, else_body, _) -> {
            sema_window_scan_expr(subject, param, scan)
            loop arm in arms {
                sema_window_scan_expr(arm.cond, param, scan)
                sema_window_scan_body(arm.body, param, scan)
            }
            if else_body == .Val(body) -> sema_window_scan_body(body, param, scan)
        }
        .Loop(body, _, _, _) | .Reactive(body, _) | .Shield(body, _) | .Live(body, _) -> sema_window_scan_body(body, param, scan)
        .Switched(_, body, _) | .Policy(_, body, _) | .ContextBlock(_, body, _) -> sema_window_scan_body(body, param, scan)
        .Region(_, _, body, _) | .Layout(_, _, body, _) -> sema_window_scan_body(body, param, scan)
        .ComptimeBlock(body, _, _) -> sema_window_scan_body(body, param, scan)
        .Transact(_, _, body, _, _) -> sema_window_scan_body(body, param, scan)
        .AuthorityScope(_, _, _, body, _) -> sema_window_scan_body(body, param, scan)
        .CountedLoop(init, cond, step, body, _, _, _) -> {
            sema_window_scan_expr(init.init, param, scan)
            sema_window_scan_expr(cond, param, scan)
            if step == .Val(inner) -> sema_window_scan_statement(inner, param, scan)
            sema_window_scan_body(body, param, scan)
        }
        .Unsafe(_, audit, body, _) | .Impure(_, audit, body, _) -> {
            sema_window_scan_optional(audit, param, scan)
            sema_window_scan_body(body, param, scan)
        }
        .TaskGroup(_, _, args, body, _) -> {
            sema_window_scan_optional(args.limit, param, scan)
            sema_window_scan_optional(args.stack, param, scan)
            sema_window_scan_body(body, param, scan)
        }
        .AssumeDet(_, reason, body, _) -> {
            sema_window_scan_expr(reason, param, scan)
            sema_window_scan_body(body, param, scan)
        }
        .ComptimeIf(cond, _, then_body, else_body, _, _) -> {
            sema_window_scan_expr(cond, param, scan)
            sema_window_scan_body(then_body, param, scan)
            if else_body == .Val(body) -> sema_window_scan_body(body, param, scan)
        }
        .ScopeMember(_, _, args, _, body, _, _, _) -> {
            loop arg in args -> sema_window_scan_expr(arg, param, scan)
            sema_window_scan_body(body, param, scan)
        }
        .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
    }
}

sema_window_scan_expr: fn(expr: Expr, param: String, scan: &SemaWindowScan) {
    if expr == {
        .Place(inner, access, _, _) -> {
            // A write window of the whole list (`edit: &xs`) can reach a resize.
            if access == PlaceAccess.Write && sema_window_is_param(inner, param) -> scan.resizes = true
            sema_window_scan_expr(inner, param, scan)
        }
        .MethodCall(receiver, method, _, _, _, args, _) -> {
            if sema_window_is_param(receiver, param) && sema_window_method_may_resize(method) -> scan.resizes = true
            if sema_window_args_pass_param(args, param) -> scan.resizes = true
            sema_window_scan_expr(receiver, param, scan)
            sema_window_scan_args(args, param, scan)
        }
        .OptMethodCall(receiver, _, _, _, args, _, _) -> {
            if sema_window_args_pass_param(args, param) -> scan.resizes = true
            sema_window_scan_expr(receiver, param, scan)
            sema_window_scan_args(args, param, scan)
        }
        .Call(call, _) -> {
            loop index in 0..<call.args.len() {
                if sema_window_is_param(call.args[index].expr, param) -> scan.onward.push(SemaWindowEdge{callee: call.name, index: index})
            }
            sema_window_scan_args(call.args, param, scan)
        }
        // A function value's parameters only read: a marked one can't be a value.
        .CallValue(callee, args, _, _) -> {
            sema_window_scan_expr(callee, param, scan)
            sema_window_scan_args(args, param, scan)
        }
        .Str(parts, _, _) -> loop part in parts {
            if part == .Interp(value, _) -> sema_window_scan_expr(value, param, scan)
        }
        .ListLit(elements, _, _) -> loop element in elements -> sema_window_scan_expr(element, param, scan)
        .CompareChain(operands, _, _, _, _) -> loop operand in operands -> sema_window_scan_expr(operand, param, scan)
        .MapLit(entries, _, _) -> loop entry in entries {
            sema_window_scan_expr(entry.key, param, scan)
            sema_window_scan_expr(entry.value, param, scan)
        }
        .MemberSpread(base, _, _, _) | .Spread(base, _, _) | .Deref(base, _, _) | .RawOf(base, _, _) | .Copy(base, _, _) -> sema_window_scan_expr(base, param, scan)
        .Field(base, _, _, _) | .OptField(base, _, _, _, _, _) | .Tainted(base, _, _, _) | .Present(base, _, _) -> sema_window_scan_expr(base, param, scan)
        .Ok(base, _, _) | .Err(base, _, _) | .Paren(base, _, _) | .Unary(_, base, _, _) -> sema_window_scan_expr(base, param, scan)
        .PatternTest(subject, _, _, _) -> sema_window_scan_expr(subject, param, scan)
        .PtrFromAddr(_, _, _, addr, _, _) -> sema_window_scan_expr(addr, param, scan)
        .Pipe(head, steps, _, _) -> {
            sema_window_scan_expr(head, param, scan)
            loop step in steps -> sema_window_scan_expr(step.value, param, scan)
        }
        .Index(base, index, _, _, _) -> {
            sema_window_scan_expr(base, param, scan)
            sema_window_scan_expr(index, param, scan)
        }
        .Slice(base, start, end, range, _, _) -> {
            sema_window_scan_expr(base, param, scan)
            sema_window_scan_expr(start, param, scan)
            sema_window_scan_expr(end, param, scan)
            sema_window_scan_optional(range, param, scan)
        }
        .Range(start, end, _, _, _) | .Binary(_, start, end, _, _) -> {
            sema_window_scan_expr(start, param, scan)
            sema_window_scan_expr(end, param, scan)
        }
        .Try(value, _, _, context, _) -> {
            sema_window_scan_expr(value, param, scan)
            sema_window_scan_optional(context, param, scan)
        }
        .OrFallback(value, fallback, _, _, _) -> {
            sema_window_scan_expr(value, param, scan)
            if fallback == {
                .Value(inner) -> sema_window_scan_expr(inner, param, scan)
                .Block(body, inner, _) -> {
                    sema_window_scan_body(body, param, scan)
                    sema_window_scan_optional(inner, param, scan)
                }
                .Return(inner, _) -> sema_window_scan_optional(inner, param, scan)
                .Panic(_, args) -> sema_window_scan_args(args, param, scan)
                .Break(_) | .Continue(_) | .BreakLabel(_, _) | .ContinueLabel(_, _) -> {}
            }
        }
        .If(cond, then_body, then_value, else_body, else_value, _, _) -> {
            sema_window_scan_expr(cond, param, scan)
            sema_window_scan_body(then_body, param, scan)
            sema_window_scan_expr(then_value, param, scan)
            sema_window_scan_body(else_body, param, scan)
            sema_window_scan_expr(else_value, param, scan)
        }
        .StructLit(_, _, _, _, fields, _, _, _) -> loop field in fields -> sema_window_scan_expr(field.value, param, scan)
        .TupleLit(fields, _, _, _) -> loop field in fields -> sema_window_scan_expr(field.value, param, scan)
        .EnumLit(_, _, _, args, _, _, _) -> loop arg in args {
            if arg == {
                .Positional(value) -> sema_window_scan_expr(value, param, scan)
                .Named(_, value) -> sema_window_scan_expr(value, param, scan)
            }
        }
        .Lambda(lambda, _) -> {
            if lambda.body == {
                .Expr(value) -> sema_window_scan_expr(value, param, scan)
                .Block(body) -> sema_window_scan_body(body, param, scan)
            }
        }
        .TypedLit(_, body, _, _) -> {
            if body == {
                .Fields(fields) -> loop field in fields -> sema_window_scan_expr(field.value, param, scan)
                .Elements(elements) -> loop element in elements -> sema_window_scan_expr(element, param, scan)
                .Entries(entries) -> loop entry in entries {
                    sema_window_scan_expr(entry.key, param, scan)
                    sema_window_scan_expr(entry.value, param, scan)
                }
                .Value(value) -> sema_window_scan_expr(value, param, scan)
                .ByteText(_) | .Empty -> {}
            }
        }
        .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .Ident(_, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) -> {}
    }
}
