// Call marks under `#Policy(writes: .Explicit)`. Calls are written plain and
// the signature decides what each does; the policy asks that the text show it
// too: `grow(&xs)` and `&xs.push(4)` for a call that changes a named value,
// `archive(&&title)` and `&&buf.seal()` for one that takes it. The parser
// keeps a written argument mark as CallArg.mark and a written receiver mark as
// an Expr.Place that starts at the mark. Under the policy a missing, wrong or
// extra mark is E0228, which quotes the callee's signature line and carries a
// Safe edit to the mark the signature implies. Outside the policy a written
// call mark is the ordinary "expected a value" parse error.
use jet_foundation.[
    AccessConvention,
    AST_NODE_GENERATED,
    CallArg,
    Diagnostic,
    DiagnosticFixApplicability,
    DiagnosticFixSafety,
    Expr,
    MARKER_POLICY,
    Marker,
    PlaceAccess,
    PolicyDeclaration,
    PolicyKey,
    Span,
    TextEdit,
    Type,
    diagnostic_with_edit_grade,
    expr_node_id,
    expr_source_span,
    expr_source_start,
]

sema_call_marks_writes_declaration: fn(declaration: PolicyDeclaration) -> Bool Never! {
    if declaration.key != PolicyKey.Writes -> return false
    if declaration.value == {
        .Explicit -> true
        .Enabled | .Limit(_) | .Forbid | .Default | .GateOnly | .Obligations | .Relaxed | .PerSite | .Track | .Skip | .Allow | .On | .Off | .Arithmetic(_) -> false
    }
}

sema_call_marks_writes_marker: fn(marker: Marker) -> Bool Never! {
    if marker.name != MARKER_POLICY -> return false
    loop (index, label) in marker.arg_labels {
        written: label ?? next
        if written.name != "writes" || index >= marker.args.len() -> next
        if marker.args[index] == {
            .Expr(value) -> {
                if value == {
                    .EnumLit(type_name, variant, _, args, _, _, _) -> {
                        if type_name == "" && variant == "Explicit" && args.len() == 0 -> return true
                    }
                    .Str(_, _, _) | .StrMatchLit(_, _, _) | .BinMatchLit(_, _, _) | .Int(_, _, _, _, _) | .Float(_, _, _, _, _) | .Bool(_, _, _) | .Unit(_, _) | .Char(_, _, _) | .ListLit(_, _, _) | .MemberSpread(_, _, _, _) | .Spread(_, _, _) | .MapLit(_, _, _) | .Index(_, _, _, _, _) | .Slice(_, _, _, _, _, _) | .Range(_, _, _, _, _) | .Ident(_, _, _) | .Call(_, _) | .Unary(_, _, _, _) | .Binary(_, _, _, _, _) | .CompareChain(_, _, _, _, _) | .UnitLit(_, _, _, _, _, _, _) | .Deref(_, _, _) | .RawOf(_, _, _) | .Copy(_, _, _) | .Place(_, _, _, _) | .Field(_, _, _, _) | .OptField(_, _, _, _, _, _) | .MethodCall(_, _, _, _, _, _, _) | .OptMethodCall(_, _, _, _, _, _, _) | .StructLit(_, _, _, _, _, _, _, _) | .TypedLit(_, _, _, _) | .Tainted(_, _, _, _) | .Present(_, _, _) | .Absent(_, _) | .Todo(_, _, _) | .NoElse(_, _) | .PatternTest(_, _, _, _) | .Ok(_, _, _) | .Err(_, _, _) | .Try(_, _, _, _, _) | .OrFallback(_, _, _, _, _) | .If(_, _, _, _, _, _, _) | .TupleLit(_, _, _, _) | .Lambda(_, _) | .CallValue(_, _, _, _) | .PtrFromAddr(_, _, _, _, _, _) | .ComptimeName(_, _, _, _) | .TypeValue(_, _, _) | .Paren(_, _, _) | .Pipe(_, _, _, _) -> {}
                }
            }
            .EffectRow(_, _) -> {}
        }
    }
    false
}

// A package or module `writes: .Explicit` declaration, or the function's own
// `#Policy(writes: .Explicit)` marker.
sema_call_marks_apply_policy: fn(table: &SemaScopeTable, graph: SemaRegistrationGraph, module_identity: String, markers: [Marker]) Never! {
    position: sema_scope_module_policy(table, graph, module_identity)
    table.writes_explicit = table.policy_rows[position].writes_explicit
    loop marker in markers {
        if sema_call_marks_writes_marker(marker) -> table.writes_explicit = true
    }
}

// A block `#Policy(writes: .Explicit) { … }` turns the policy on for its body.
// Returns the enclosing setting for the matching pop.
sema_call_marks_push_policy: fn(table: &SemaScopeTable, declarations: [PolicyDeclaration]) -> Bool Never! {
    previous: table.writes_explicit
    loop declaration in declarations {
        if sema_call_marks_writes_declaration(declaration) -> table.writes_explicit = true
    }
    previous
}

// The mark a receiver written `&xs.push(4)` / `&&buf.seal()` carries: the
// parser's Place starts at the mark, before its value. A Place sema builds
// spans its value and carries no written mark.
sema_call_marks_written_receiver: fn(receiver: Expr) -> PlaceAccess? Never! {
    if receiver == .Place(value, access, span, id) {
        if id != AST_NODE_GENERATED && access != PlaceAccess.Read && span.start < expr_source_start(value) -> return Val(access)
    }
    None
}

// One argument of a checked call. `param` is the slot it binds; `signature`
// is built only when a report needs it.
sema_call_marks_check_argument: fn(scopes: SemaScopeTable, callee: String, receiver: AccessConvention?, params: [SemaCallParam], param: SemaCallParam, arg: CallArg, diagnostics: &[Diagnostic]) {
    if !scopes.writes_explicit {
        if arg.mark == .Val(mark) -> diagnostics.push(sema_call_marks_outside_policy(mark.access, mark.span))
        return
    }
    if expr_node_id(arg.expr) == AST_NODE_GENERATED -> return
    root: sema_receiver_mark_place_root(arg.expr) ?? {
        if arg.mark == .Val(mark) -> diagnostics.push(sema_call_marks_extra(callee, "", mark.access, mark.span, sema_ownership_signature_line(callee, receiver, params)))
        return
    }
    want := PlaceAccess?{None}
    if param.convention == AccessConvention.Write -> want = Val(PlaceAccess.Write)
    if param.convention == AccessConvention.Move && arg.expr == .Ident(_, _, _) && !sema_ownership_type_is_copy(param.ty ?? Type.Named{name: "_"}) && !sema_ownership_argument_is_function_item(arg, scopes) -> want = Val(PlaceAccess.Take)
    have: if arg.mark == .Val(mark) -> Val(mark.access) else -> PlaceAccess?{None}
    if have == want -> return
    at: expr_source_start(arg.expr)
    mark_span: if arg.mark == .Val(mark) -> mark.span else -> Span{start: at, end: at}
    diagnostics.push(sema_call_marks_mismatch("`{sema_window_plain_name(callee)}`", root, want, have, expr_source_span(arg.expr), mark_span, sema_ownership_signature_line(callee, receiver, params)))
}

// The receiver of a checked method call. `receiver` is the call's receiver
// as written, `unmarked` the place sema checked, and `frame` the call's
// resolved receiver convention.
sema_call_marks_check_receiver: fn(scopes: SemaScopeTable, receiver: Expr, unmarked: Expr, frame: SemaReceiverMarkFrame, method: String, diagnostics: &[Diagnostic]) {
    have: sema_call_marks_written_receiver(receiver)
    if !scopes.writes_explicit {
        if have == .Val(access) -> diagnostics.push(sema_call_marks_outside_policy(access, sema_call_marks_receiver_mark_span(receiver, access)))
        return
    }
    root: sema_receiver_mark_place_root(unmarked) ?? return
    if have == None && expr_node_id(unmarked) == AST_NODE_GENERATED -> return
    want := PlaceAccess?{None}
    if frame.convention == .Val(convention) {
        if convention == AccessConvention.Write -> want = Val(PlaceAccess.Write)
        if convention == AccessConvention.Move && unmarked == .Ident(_, _, _) -> want = Val(PlaceAccess.Take)
    }
    if have == want -> return
    at: expr_source_start(unmarked)
    mark_span: if have == .Val(access) -> sema_call_marks_receiver_mark_span(receiver, access) else -> Span{start: at, end: at}
    signature: if frame.signature == "" -> "`.{method}()`" else -> frame.signature
    diagnostics.push(sema_call_marks_mismatch("`.{method}()`", root, want, have, expr_source_span(unmarked), mark_span, signature))
}

sema_call_marks_receiver_mark_span: fn(receiver: Expr, access: PlaceAccess) -> Span Never! {
    start: expr_source_start(receiver)
    Span{start: start, end: start + sema_call_marks_text(access).len()}
}

sema_call_marks_text: fn(access: PlaceAccess) -> String Never! {
    if access == PlaceAccess.Take -> "&&" else -> "&"
}

// E0228 for a missing, wrong or extra mark. `place` is the marked value's
// span and `mark_span` the written mark, or the empty span where the missing
// one goes; a missing mark is reported at the value, a written one at itself.
sema_call_marks_mismatch: fn(call: String, root: String, want: PlaceAccess?, have: PlaceAccess?, place: Span, mark_span: Span, signature: String) -> Diagnostic {
    if want == .Val(needed) {
        verb: if needed == PlaceAccess.Take -> "takes" else -> "changes"
        mark: sema_call_marks_text(needed)
        what: if have == .Val(written) -> "{call} {verb} `{root}`, so its mark is `{mark}`, not `{sema_call_marks_text(written)}`" else -> "{call} {verb} `{root}`, so the call writes `{mark}{root}`"
        at: if have == None -> place else -> mark_span
        diagnostic: sema_error("E0228", at, what, "{signature} {verb} this input, and `#Policy(writes: .Explicit)` writes every change and take at the call", "write `{mark}{root}`")
        return diagnostic_with_edit_grade(diagnostic, TextEdit{span: mark_span, new_text: mark}, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving)
    }
    sema_call_marks_extra(call, root, have ?? PlaceAccess.Write, mark_span, signature)
}

sema_call_marks_extra: fn(call: String, root: String, written: PlaceAccess, mark_span: Span, signature: String) -> Diagnostic {
    mark: sema_call_marks_text(written)
    what: if root == "" -> "`{mark}` marks a named value, and this argument isn't one" else -> "{call} neither changes nor takes `{root}`, so it takes no `{mark}`"
    diagnostic: sema_error("E0228", mark_span, what, "{signature} reads this input; a mark says the call changes or takes the value, so it would tell the reader something false", "remove the `{mark}`")
    diagnostic_with_edit_grade(diagnostic, TextEdit{span: mark_span, new_text: ""}, DiagnosticFixApplicability.Safe, DiagnosticFixSafety.BehaviorPreserving)
}

// Outside the policy a call mark is not Jet syntax: the ordinary report the
// parser gives a mark in value position.
sema_call_marks_outside_policy: fn(access: PlaceAccess, span: Span) -> Diagnostic {
    sema_error("E0003", span, "expected a value, found `{sema_call_marks_text(access)}`", "a value can be a name, literal, collection, call, or parenthesized expression", "write an expression such as `x`, `42`, or `\"hello\"`")
}
