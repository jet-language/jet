            .Bind(name, _) -> &bound.insert(name, true)
            .Nested(inner) -> Self.bind_pattern_names(&inner, &bound)
            .Named(_, _, slot) -> Self.bind_slot_names(&slot, &bound)
            .Wildcard | .Range(_, _) | .Rest(_) -> {}
        }
