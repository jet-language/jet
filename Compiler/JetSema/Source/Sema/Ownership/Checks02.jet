    pub fn record_call_result_views(self: &Self, expr: &Expr) {
        direct_place :: self.place_from_expr(expr)
        loans := [(ViewPlace, ViewAccess)]{}
        loop (_, place, _, access) in self.view_call_sources(expr) {
            seen := false
            loop loan in &loans {
                if loan.0.owner != place.owner || loan.0.projections != place.projections -> next
                if access == .Write -> loan.1 = .Write
                seen = true
                break
            }
            if !seen -> &loans.push((^place, access))
        }
        loop (place, access) in loans {
            same_direct_argument := false
            if direct_place == .Val(direct) {
                if direct.owner == place.owner && direct.projections == place.projections && self.call_access_frames.len() > 0 {
                    frame :: &self.call_access_frames[self.call_access_frames.len() - 1]
                    if frame.accesses.len() > 0 {
                        active :: &frame.accesses[frame.accesses.len() - 1]
                        same_direct_argument = !active.reserved && active.place.owner == place.owner && active.place.projections == place.projections
                    }
                }
            }
            if same_direct_argument -> next
            self.check_call_place_access(&place, access, expr_span(expr))
            self.record_call_place_access(^place, access)
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:1759
    fn collect_call_projection_accesses(self: &Self, expr: &Expr, accesses: &[EvaluatedAccess]) {
        if expr == {
            .Index(base, index, _, _) -> {
                self.collect_call_projection_accesses(&base, &accesses)
                self.collect_evaluated_expr_accesses(&index, .EvaluateNow, &[String:Bool]{}, &accesses)
            }
            .Slice(base, start, end, range, _) -> {
                self.collect_call_projection_accesses(&base, &accesses)
                if range == .Val(range) -> self.collect_evaluated_expr_accesses(&range, .EvaluateNow, &[String:Bool]{}, &accesses)
                else {
                    self.collect_evaluated_expr_accesses(&start, .EvaluateNow, &[String:Bool]{}, &accesses)
                    self.collect_evaluated_expr_accesses(&end, .EvaluateNow, &[String:Bool]{}, &accesses)
                }
            }
            .Field(base, _, _) | .Place(base, _, _) | .Paren(base, _) | .Deref(base, _) -> self.collect_call_projection_accesses(&base, &accesses)
            else -> {}
        }
    }
}
