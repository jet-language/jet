// Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:17
pub fn invalidate_view_owner(views: &ViewStore, owner: &ViewOwnerId, verb: String, span: Span) {
    loop facts in views.all_mut() {
        loop fact in &facts {
            if fact.place.owner == owner && fact.invalidated == None -> fact.invalidated = Val((verb, span))
        }
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:35
pub fn copy_edit_anchor(expr: &Expr) -> Span {
    root := expr
    loop {
        if root == {
            .Field(base, _, _) | .Index(base, _, _, _) | .OptField(base, _, _, _, _) | .Paren(base, _) -> root = &base
            else -> break
        }
    }
    Span.new(min(expr_span(root).start, expr_span(expr).start), expr_span(expr).end)
}

// Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:48
struct EvaluatedAccess {
    place: ViewPlace
    capture_place: ViewPlace
    capture_ty: Type?
    capture_is_view: Bool
    access: ViewAccess
    span: Span
    through_call: Bool
    moves_owner: Bool
}

// Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:59
fn carries_lending_view(expr: &Expr, name: String) -> Bool {
    if expr == {
        .Ident(found, _) -> found == name
        .Copy(inner, _) | .Place(inner, _, _) | .Paren(inner, _) | .Spread(inner, _) | .Ok(inner, _) | .Err(inner, _) | .Present(inner, _) -> carries_lending_view(&inner, name)
        .ListLit(items, _) -> items.any(item -> carries_lending_view(&item, name))
        .TupleLit(fields, _, _) -> fields.any(field -> carries_lending_view(&field.value, name))
        .MapLit(entries, _) -> entries.any(entry -> carries_lending_view(&entry.key, name) || carries_lending_view(&entry.value, name))
        .StructLit(_, _, _, _, fields, _, _) -> fields.any(field -> carries_lending_view(&field.value, name))
        .TypedLit(_, _, _) | .If(_, _, _, _, _, _) | .OrFallback(_, _, _, _) -> expr_refs_name(expr, name)
        .EnumLit(_, _, _, args, _, _) -> args.any(arg -> if arg == { .Positional(value) | .Named(_, value) -> carries_lending_view(&value, name) })
        else -> false
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:91
#Derive(Clone, Copy, PartialEq, Eq)
enum AccessWalkMode { EvaluateNow; ConstructCaptures; CaptureRequirements }

// Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:97
fn const_place_int(expr: &Expr) -> I64? {
    if expr == {
        .Int(value, _, _, _) -> Val(value)
        .Unary(.Neg, inner, _) -> (const_place_int(&inner) ?? return None).checked_neg()
        .Paren(inner, _) -> const_place_int(&inner)
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:106
fn cell_guard_projection_path(expr: &Expr, parameter: String) -> [String]? {
    if expr == {
        .Ident(name, _) -> if name == parameter -> Val([String]{}) else -> None
        .Field(base, field, _) -> {
            path := cell_guard_projection_path(&base, parameter) ?? return None
            &path.push(field)
            Val(^path)
        }
        .Paren(base, _) -> cell_guard_projection_path(&base, parameter)
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:119
fn cell_guard_projection_path_from_arg(arg: &CallArg) -> [String]? {
    if arg.expr == .Lambda(lambda) {
        if lambda.params.len() != 1 -> return None
        if lambda.body == .Expr(expr) -> return cell_guard_projection_path(&expr, lambda.params[0].name)
    }
    None
}

// Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:132
fn record_cell_guard_projection_path(arg: &CallArg, path: [String]?) {
    if arg.expr == .Lambda(lambda) -> lambda.meta.cell_projection_path = ^path
}

// Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:138
fn cell_guard_projection_paths_overlap(first: &[String], second: &[String]) -> Bool {
    first.starts_with(second) || second.starts_with(first)
}

// Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:142
fn named_view_field_path(expr: &Expr, fields: &[String]) -> String? {
    if expr == {
        .Ident(name, _) -> Val(name)
        .Field(base, field, _) -> {
            name :: named_view_field_path(&base, &fields) ?? return None
            &fields.push(field)
            Val(name)
        }
        else -> None
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:154
fn append_view_source_projections(place: &ViewPlace, projections: &[ViewSourceProjection], span: Span) {
    loop projection in projections {
        &place.projections.push(if projection == {
            .Field(name) -> ViewProjection.Field(name)
            .Index -> ViewProjection.Index(None, span)
            .Range -> ViewProjection.Range(None, None, span)
        })
    }
}

// Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:175
fn view_kind_from_return_type(ty: &Type) -> ViewKind? {
    if ty == {
        .Result(ok, _) | .Option(ok) | .Shared(ok) -> view_kind_from_return_type(&ok)
        .Apply(name, args) -> {
            if name == Syntax.TYPE_VIEW_ITER && args.len() == 1 -> return view_kind_from_return_type(&args[0])
            if (name == "View" || name == "ViewMut") && args.len() == 1 {
                return Val(if args[0] == {
                    .Named("str") -> ViewKind.String
                    .Named(name) -> if name == Syntax.TYPE_BYTES -> ViewKind.Buffer else if name == "Tensor" -> ViewKind.Matrix else -> ViewKind.List
                    .Apply("Vec" | "Matrix" | "Tensor", _) -> ViewKind.Matrix
                    else -> ViewKind.List
                })
            }
            None
        }
        else -> None
    }
}

impl Checker {
    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:205
    pub fn is_resource_type(self: &Self, ty: &Type) -> Bool {
        if ty == {
            .Named(name) | .Apply(name, _) -> self.type_implements_trait_for_name(name, Syntax.TRAIT_CLOSE)
            .String -> self.trait_reg.implements_trait(Syntax.TYPE_STRING, Syntax.TRAIT_CLOSE)
            else -> false
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:237
    pub fn arena_alloc_source(self: &Self, init: &Expr) -> String? {
        if init.without_parens() == .MethodCall(receiver, method, _, _, _, _, recv_type, _, _, _) {
            if method != Syntax.MEM_ALLOC_ALLOC -> return None
            if receiver.without_parens() == .Ident(arena, _) {
                resolved :: recv_type.is_some_and(name -> name == "Arena" || name == "Bump" || name == "Pool" || name == "Fixed")
                if resolved || self.lookup(arena).is_some_and(info -> is_allocator_type(&info.ty)) -> return Val(arena)
            }
        }
        None
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:261
    pub fn record_arena_view(self: &Self, name: String, arena: String, span: Span) {
        place :: ViewPlace{owner: self.owner_id(arena), projections: [ViewProjection]{.Fresh(span)}}
        self.record_view(name, [String]{}, ^place, .Arena, .Write, span)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:278
    pub fn fixed_backing_source(self: &Self, init: &Expr) -> String? {
        if init == .MethodCall(receiver, method, _, _, _, args, _, _, _, _) {
            if receiver != .Field(_, "Fixed", _) -> return None
            if method == "new" -> return Val("<inline Fixed backing>")
            if method == "over" && args.len() > 0 {
                if args[0].expr == .Ident(name, _) -> return Val(name)
            }
        }
        None
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:301
    pub fn record_fixed_backing(self: &Self, name: String, owner: String, span: Span) {
        place :: ViewPlace{owner: if owner == "<inline Fixed backing>" -> ViewOwnerId{name: owner, def_span: span, origin: .Local} else -> self.owner_id(owner), projections: [ViewProjection]{}}
        self.record_view(name, [String]{}, ^place, .FixedBacking, .Write, span)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:325
    pub fn kill_views_of_arena(self: &Self, arena: String, verb: String, span: Span) {
        owner :: self.owner_id(arena)
        invalidate_view_owner(&self.flow.views, &owner, verb, span)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:331
    pub fn check_view_use(self: &Self, name: String, span: Span) {
        &self.views_used_in_stmt.insert(name, true)
        if self.view_fact(name) == .Val(info) {
            if info.invalidated == .Val((verb, _)) {
                arena :: info.place.owner.name
                &self.diags.push(Diagnostic.error("E0632", "`{arena}` was {verb} here, so the value `{name}` points into is gone", "`{name}` is a view into `{arena}`; `{arena}.{verb}()` invalidated everything stored in `{arena}`, so reading `{name}` now would read freed memory", "use `{name}` before `{arena}.{verb}()`, or re-`alloc` after the {verb} to get a fresh value", Val(span)))
            }
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:356
    pub fn report_view_escape(self: &Self, name: String, what: String, span: Span) {
        fact :: self.view_fact(name) ?? return
        owner :: fact.place.owner.name
        if fact.kind == {
            .Arena -> &self.diags.push(Diagnostic.error("E0631", "`{name}` cannot be shared — it does not live long enough to {what}", "`{name}` is a view into `{owner}`; sharing it outside the region would let it outlive `{owner}` and point into freed memory", "keep `{name}` inside the `{owner}` region, or copy what you need out with `{Syntax.SIGIL_COPY}` before it leaves", Val(span)))
            .FixedBacking -> &self.diags.push(Diagnostic.error("E0631", "`{name}` cannot be shared — its fixed backing does not live long enough to {what}", "`{name}` exclusively borrows `{owner}`; moving or capturing the handle could outlive that inline storage", "keep the Fixed handle in its declaring lexical scope and close it after its last allocation view", Val(span)))
            .String -> self.report_string_view_unsupported_use(name, what, span)
            .Pin -> &self.diags.push(Diagnostic.error("E2305", "`{name}` cannot be shared — the pin does not live long enough to {what}", "`{name}` pins `{owner}`; sharing it outside `{owner}`'s scope would let the no-move promise outlive the storage it protects", "keep `{name}` inside `{owner}`'s scope, or pin the place again where it is needed", Val(span)))
            .List | .Buffer | .Matrix -> &self.diags.push(Diagnostic.error("E2305", "`{name}` cannot be shared — it does not live long enough to {what}", "`{name}` is a view into `{owner}`; sharing it outside `{owner}`'s scope would let it outlive its owner and point into freed storage", "keep `{name}` inside `{owner}`'s scope, or copy what you need before it leaves", Val(span)))
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:427
    pub fn is_arena_view(self: &Self, name: String) -> Bool { self.view_kind(name) == Val(ViewKind.Arena) }
    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:431
    pub fn is_fixed_backing_view(self: &Self, name: String) -> Bool { self.view_kind(name) == Val(ViewKind.FixedBacking) }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:435
    pub fn reject_fixed_storage(self: &Self, expr: &Expr, what: String) {
        if expr == .Ident(name, span) {
            if self.is_fixed_backing_view(name) -> self.report_view_escape(name, what, span)
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:443
    fn owner_id(self: &Self, owner: String) -> ViewOwnerId {
        def_span :: self.lookup(owner).map(info -> info.def_span) ?? Span.new(0, 0)
        origin := ViewOwnerOrigin.Local
        if owner == Syntax.KW_SELF -> origin = .Receiver
        else if self.consts.contains_key(owner) -> origin = .Static
        else if self.lookup(owner).is_some_and(info -> info.param_conv != None) {
            index := 0
            loop i in 0..self.current_param_names.len() {
                if self.current_param_names[i] == owner { index = i; break }
            }
            origin = .Parameter(index)
        }
        ViewOwnerId{name: owner, def_span: def_span, origin: ^origin}
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:483
    fn record_view(self: &Self, name: String, output_path: [String], place: ViewPlace, kind: ViewKind, access: ViewAccess, span: Span) {
        self.record_view_with_exemptions(name, ^output_path, ^place, kind, access, span, None, None)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:495
    fn record_view_with_exemptions(self: &Self, name: String, output_path: [String], place: ViewPlace, kind: ViewKind, access: ViewAccess, span: Span, transfer_from: String?, enum_variants: [String:Bool]?) {
        conflicts := false
        loop (existing_name, facts) in self.flow.views.all() {
            if !self.view_is_live_now(existing_name) || transfer_from == Val(existing_name) -> next
            loop fact in facts {
                if fact.invalidated != None -> next
                // Candidates for one output slot and distinct enum variants are alternatives.
                if existing_name == name && (fact.output_path == output_path || enum_variants.is_some_and(variants -> Self.view_paths_are_enum_alternatives(&variants, &fact.output_path, &output_path))) -> next
                // Structural parent/child pins share one contract.
                if kind == .Pin && fact.kind == .Pin && (place.extends(&fact.place) || fact.place.extends(&place)) -> next
                // Pinning an allocation extends its existing exclusive window.
                if kind == .Pin && fact.kind == .Arena && fact.place.overlaps(&place) -> next
                if (fact.access == .Write || access == .Write) && fact.place.overlaps(&place) { conflicts = true; break }
            }
            if conflicts -> break
        }
        if conflicts {
            place_name :: Self.place_name(&place)
            &self.diags.push(Diagnostic.error("E0212", "`{place_name}` already has a live view that conflicts with `{name}`", "many read views may overlap, but an exclusive mutable view cannot overlap any other live view", "finish using the earlier view before creating this one, or make an owned copy", Val(span)))
        }
        fact :: ViewFact{binding_span: span, output_path: ^output_path, place: ^place, kind: kind, access: access, scope_len: self.scope_depth(), seq: 0, invalidated: None}
        push_view_fact(&self.flow.views, name, ^fact)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:579
    fn view_paths_are_enum_alternatives(variants: &[String:Bool], left: &[String], right: &[String]) -> Bool {
        if left.len() == 0 || right.len() == 0 || left[0] == right[0] -> return false
        variants.contains_key(left[0]) && variants.contains_key(right[0])
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:593
    pub fn view_fact(self: &Self, name: String) -> ViewFact? {
        binding :: self.lookup(name) ?? return None
        current_view_fact_for_binding(&self.flow.views, name, binding.def_span)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:598
    pub fn view_facts(self: &Self, name: String) -> [ViewFact] {
        binding :: self.lookup(name) ?? return [ViewFact]{}
        view_facts_for_binding(&self.flow.views, name, binding.def_span)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:605
    fn view_fact_at_path(self: &Self, name: String, output_path: &[String]) -> ViewFact? {
        self.view_facts_at_path(name, output_path).first()
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:611
    fn view_facts_at_path(self: &Self, name: String, output_path: &[String]) -> [ViewFact] {
        candidates := [ViewFact]{}
        longest := 0
        loop fact in self.view_facts(name) {
            if output_path.starts_with(&fact.output_path) {
                longest = max(longest, fact.output_path.len())
                &candidates.push(^fact)
            }
        }
        &candidates.retain(fact -> fact.output_path.len() == longest)
        ^candidates
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:626
    fn compose_view_source_places(self: &Self, actual: &Expr, projections: &[ViewSourceProjection], span: Span) -> [ViewPlace] {
        actual :: actual.without_parens()
        leading_fields := [String]{}
        loop projection in projections {
            if projection == { .Field(name) -> &leading_fields.push(name); else -> break }
        }
        if actual == .Ident(name, _) {
            facts :: self.view_facts_at_path(name, &leading_fields)
            if facts.len() > 0 {
                places := [ViewPlace]{}
                loop fact in facts {
                    place := fact.place.clone()
                    append_view_source_projections(&place, &projections[fact.output_path.len()..], span)
                    &places.push(^place)
                }
                return ^places
            }
        }
        place := self.place_from_expr(actual) ?? return [ViewPlace]{}
        append_view_source_projections(&place, projections, span)
        [ViewPlace]{^place}
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:664
    fn view_is_live_now(self: &Self, name: String) -> Bool {
        // Fixed backing retains cleanup responsibility until consuming close or scope exit.
        if self.view_kind(name) == Val(ViewKind.FixedBacking) -> return !self.flow.moved.contains(name)
        self.views_used_in_stmt.contains_key(name) || self.is_name_live_after(name)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:674
    pub fn view_kind(self: &Self, name: String) -> ViewKind? { self.view_fact(name).map(fact -> fact.kind) }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:678
    fn view_kind_for_place(self: &Self, place: &ViewPlace) -> ViewKind {
        facts :: view_facts_newest_first(&self.flow.views)
        loop (_, fact) in facts {
            if fact.place.owner.def_span == place.owner.def_span && fact.place.projections == place.projections -> return fact.kind
        }
        loop (_, fact) in facts {
            if fact.kind == .Pin && place.extends(&fact.place) -> return .Pin
        }
        if self.lookup(place.owner.name) == .Val(info) {
            if info.ty == {
                .Named(name) -> {
                    if name == Syntax.TYPE_BYTES -> return .Buffer
                    if name == "Tensor" -> return .Matrix
                }
                .Apply("Vec" | "Matrix" | "Tensor", _) -> return .Matrix
                else -> {}
            }
        }
        .List
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:709
    pub fn place_name(place: &ViewPlace) -> String {
        out := place.owner.name.clone()
        loop projection in place.projections {
            if projection == {
                .Field(field) -> out += ".{field}"
                .Index(_, _) | .Range(_, _, _) -> out += "[…]"
                .Fresh(_) -> out += "[fresh]"
            }
        }
        ^out
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:734
    pub fn call_access_frame(self: &Self) -> CallAccessFrame { CallAccessFrame.default() }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:741
    pub fn with_call_access<T>(self: &Self, frame: &CallAccessFrame, check: fn(&Checker) -> T) -> T {
        &self.call_access_frames.push(replace(&frame, CallAccessFrame.default()))
        result :: check(&self)
        frame = &self.call_access_frames.pop() ?? CallAccessFrame.default()
        ^result
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:754
    pub fn with_deferred_call_access<T>(self: &Self, check: fn(&Checker) -> T) -> T {
        active :: replace(&self.call_access_frames, [CallAccessFrame]{})
        result :: check(&self)
        self.call_access_frames = ^active
        ^result
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:761
    fn check_call_place_access(self: &Self, place: &ViewPlace, access: ViewAccess, span: Span) {
        self.check_call_place_access_kind(place, access, false, span)
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:765
    fn check_call_place_access_kind(self: &Self, place: &ViewPlace, access: ViewAccess, reserved: Bool, span: Span) {
        frame_index := self.call_access_frames.len()
        loop frame_index > 0 {
            frame_index -= 1
            frame :: &self.call_access_frames[frame_index]
            index := frame.accesses.len()
            loop index > 0 {
                index -= 1
                active :: &frame.accesses[index]
                if !active.place.overlaps(place) -> next
                if active.access == .Write && active.reserved && access == .Read && !reserved -> next
                if active.access != .Write && access != .Write -> next
                name :: Self.place_name(place)
                &self.diags.push(if active.access == .Write -> aliasing_while_mut(name, span) else -> aliasing_mut_after_read(name, span))
                return
            }
        }
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:797
    fn record_call_place_access(self: &Self, place: ViewPlace, access: ViewAccess) {
        if self.call_access_frames.len() > 0 -> &self.call_access_frames[self.call_access_frames.len() - 1].accesses.push(CallPlaceAccess{place: ^place, access: access, reserved: false})
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:807
    fn record_call_place_reservation(self: &Self, place: ViewPlace) {
        if self.call_access_frames.len() > 0 -> &self.call_access_frames[self.call_access_frames.len() - 1].accesses.push(CallPlaceAccess{place: ^place, access: .Write, reserved: true})
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:817
    fn push_evaluated_access(self: &Self, expr: &Expr, access: ViewAccess, bound: &[String:Bool], out: &[EvaluatedAccess]) {
        place :: self.place_from_expr(expr) ?? return
        capture_place := place.clone()
        capture_ty := self.place_expr_type(expr)
        if self.capture_place_info(expr) == .Val((found_place, ty, _)) {
            capture_place = ^found_place
            capture_ty = ^ty
        }
        if bound.contains_key(capture_place.owner.name) -> return
        loop existing in &out {
            if existing.place.owner == place.owner && existing.place.projections == place.projections && existing.capture_place.owner == capture_place.owner && existing.capture_place.projections == capture_place.projections {
                if access == .Write { existing.access = .Write; existing.span = expr_span(expr) }
                return
            }
        }
        &out.push(EvaluatedAccess{place: ^place, capture_place: ^capture_place, capture_ty: ^capture_ty, capture_is_view: expr_root_ident(expr).is_some_and(name -> self.is_view(name)), access: access, span: expr_span(expr), through_call: false, moves_owner: false})
    }

    // Rust: crates/jet-sema/src/Sema/CheckerOwnership.rs:858
    pub fn place_expr_type(self: &Self, expr: &Expr) -> Type? {
        if expr == {
            .Ident(name, _) -> self.lookup(name).map(info -> info.ty.clone())
